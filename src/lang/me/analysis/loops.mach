use std.types.result.res;
use std.types.option.opt;
use std.types.error.err;
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use std.system.panic.panic;

use A: std.allocator;

use mach.lang.me.ir;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use mach.lang.me.ir.value;

pub val NONE_U32: u32 = 0xFFFFFFFF;

pub rec InductionVar {
    phi:    id.InstructionId;
    init:   value.Value;
    step:   value.Value;
    update: id.InstructionId;
}

pub rec CountedInfo {
    bound:            value.Value;
    bound_inclusive:  bool;
    pred:             instruction.InstrKind;
    cmp:              id.InstructionId;
    iv_on_left:       bool;
    continue_on_true: bool;
}

pub rec Loop {
    header:     id.BlockId;
    preheader:  id.BlockId;
    latch:      id.BlockId;
    exiting:    id.BlockId;
    exit:       id.BlockId;

    body:       *id.BlockId;
    body_len:   u32;
    body_cap:   u32;

    parent:     u32;
    depth:      u32;

    has_iv:     bool;
    iv:         InductionVar;
    is_counted: bool;
    counted:    CountedInfo;
}

pub rec LoopAnalysis {
    alloc:       *A.Allocator;
    block_count: u32;

    rpo:         *id.BlockId;
    rpo_len:     u32;
    rpo_index:   *u32;
    idom:        *id.BlockId;

    instr_block: *id.BlockId;
    instr_count: u32;

    loops:       *Loop;
    loop_len:    u32;
    loop_cap:    u32;
}

pub fun analyze(fn: *ir.Function, alloc: *A.Allocator) res[LoopAnalysis, fail.Fail] {
    var la: LoopAnalysis;
    la.alloc       = alloc;
    la.block_count = fn.block_count;
    la.rpo         = nil;
    la.rpo_len     = 0;
    la.rpo_index   = nil;
    la.idom        = nil;
    la.instr_block = nil;
    la.instr_count = 0;
    la.loops       = nil;
    la.loop_len    = 0;
    la.loop_cap    = 0;

    val n: u32 = fn.block_count;
    if (n == 0) { ret res[LoopAnalysis, fail.Fail].ok{la}; }

    var pred_start: *u32 = nil;
    var pred_len:   *u32 = nil;
    var pred_flat:  *id.BlockId = nil;
    var edge_count: u32 = 0;
    val rp: err[fail.Fail] = build_preds(fn, alloc, ?pred_start, ?pred_len, ?pred_flat, ?edge_count);
    if (sel rp.err) { dnit(?la); ret res[LoopAnalysis, fail.Fail].err{rp.err}; }

    val rr: err[fail.Fail] = build_dom(?la, fn, pred_start, pred_len, pred_flat);
    if (sel rr.err) {
        free_preds(alloc, n, edge_count, pred_start, pred_len, pred_flat);
        dnit(?la); ret res[LoopAnalysis, fail.Fail].err{rr.err};
    }

    val ri: err[fail.Fail] = build_instr_block(?la, fn);
    if (sel ri.err) {
        free_preds(alloc, n, edge_count, pred_start, pred_len, pred_flat);
        dnit(?la); ret res[LoopAnalysis, fail.Fail].err{ri.err};
    }

    val rl: err[fail.Fail] = build_loops(?la, fn, pred_start, pred_len, pred_flat);
    free_preds(alloc, n, edge_count, pred_start, pred_len, pred_flat);
    if (sel rl.err) { dnit(?la); ret res[LoopAnalysis, fail.Fail].err{rl.err}; }

    compute_nesting(?la);
    var i: u32 = 0;
    for (i < la.loop_len) {
        val lp: *Loop = ?la.loops[i];
        lp.has_iv     = false;
        lp.is_counted = false;
        if (!recognize_counted(?la, fn, i)) {
            recognize_iv(?la, fn, i);
        }
        i = i + 1;
    }

    ret res[LoopAnalysis, fail.Fail].ok{la};
}

pub fun dnit(la: *LoopAnalysis) {
    val n: u32 = la.block_count;
    if (la.rpo != nil)         { A.deallocate[id.BlockId](la.alloc, la.rpo, n::usize); la.rpo = nil; }
    if (la.rpo_index != nil)   { A.deallocate[u32](la.alloc, la.rpo_index, n::usize); la.rpo_index = nil; }
    if (la.idom != nil)        { A.deallocate[id.BlockId](la.alloc, la.idom, n::usize); la.idom = nil; }
    if (la.instr_block != nil) { A.deallocate[id.BlockId](la.alloc, la.instr_block, la.instr_count::usize); la.instr_block = nil; }
    if (la.loops != nil) {
        var i: u32 = 0;
        for (i < la.loop_len) {
            val lp: *Loop = ?la.loops[i];
            if (lp.body != nil && lp.body_cap > 0) {
                A.deallocate[id.BlockId](la.alloc, lp.body, lp.body_cap::usize);
                lp.body = nil;
            }
            i = i + 1;
        }
        A.deallocate[Loop](la.alloc, la.loops, la.loop_cap::usize);
        la.loops = nil;
    }
    la.loop_len = 0;
}

pub fun dominates(la: *LoopAnalysis, a: id.BlockId, b: id.BlockId) bool {
    val n: u32 = la.block_count;
    if (a::u32 >= n || b::u32 >= n) { ret false; }
    if (a == b)                     { ret true; }
    if (la.rpo_index[b::u32] == NONE_U32) { ret false; }
    var x: u32 = b::u32;
    var steps: u32 = 0;
    for (true) {
        if (x == a::u32) { ret true; }
        val nx: id.BlockId = la.idom[x];
        if (nx == id.BLOCK_NIL) { panic("mach.lang.me.analysis.loops: dominator chain reached an unset idom\n"); }
        if (nx::u32 == x) { ret false; }
        x = nx::u32;
        steps = steps + 1;
        if (steps > n) { panic("mach.lang.me.analysis.loops: cyclic dominator chain\n"); }
    }
    ret false;
}

pub fun loop_contains(la: *LoopAnalysis, loop_ix: u32, b: id.BlockId) bool {
    if (loop_ix >= la.loop_len) { ret false; }
    val lp: *Loop = ?la.loops[loop_ix];
    var i: u32 = 0;
    for (i < lp.body_len) {
        if (lp.body[i] == b) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun is_invariant(la: *LoopAnalysis, loop_ix: u32, v: value.Value) bool {
    if (v.kind == value.VAL_CONST_INT)   { ret true; }
    if (v.kind == value.VAL_CONST_FLOAT) { ret true; }
    if (v.kind == value.VAL_CONST_NULL)  { ret true; }
    if (v.kind == value.VAL_CONST_BYTES) { ret true; }
    if (v.kind == value.VAL_CONST_AGG)   { ret true; }
    if (v.kind == value.VAL_PARAM)       { ret true; }
    if (v.kind == value.VAL_GLOBAL)      { ret true; }
    if (v.kind == value.VAL_FN)          { ret true; }
    if (v.kind == value.VAL_INSTR) {
        val iid: id.InstructionId = v.data.instr;
        if (iid::u32 >= la.instr_count) { ret false; }
        val db: id.BlockId = la.instr_block[iid::u32];
        if (db == id.BLOCK_NIL) { ret false; }
        ret !loop_contains(la, loop_ix, db);
    }
    ret false;
}

pub fun set_instr_block(la: *LoopAnalysis, iid: id.InstructionId, b: id.BlockId) err[fail.Fail] {
    val ix: u32 = iid::u32;
    if (ix >= la.instr_count) {
        val grown: u32 = ix + 1;
        val rg: res[*id.BlockId, A.Error] =
            A.reallocate[id.BlockId](la.alloc, la.instr_block, la.instr_count::usize, grown::usize);
        if (sel rg.err) { ret err[fail.Fail].err{fail.refused(rg.err)}; }
        la.instr_block = rg.ok;
        var i: u32 = la.instr_count;
        for (i < grown) { la.instr_block[i] = id.BLOCK_NIL; i = i + 1; }
        la.instr_count = grown;
    }
    la.instr_block[ix] = b;
    ret err[fail.Fail].ok{};
}

fun build_preds(fn: *ir.Function, alloc: *A.Allocator, out_start: **u32, out_len: **u32, out_flat: **id.BlockId, out_edges: *u32) err[fail.Fail] {
    val n: u32 = fn.block_count;

    val rs: res[*u32, A.Error] = A.allocate[u32](alloc, n::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    val start: *u32 = rs.ok;

    val rc: res[*u32, A.Error] = A.allocate[u32](alloc, n::usize);
    if (sel rc.err) { A.deallocate[u32](alloc, start, n::usize); ret err[fail.Fail].err{fail.refused(rc.err)}; }
    val cnt: *u32 = rc.ok;

    var i: u32 = 0;
    for (i < n) { cnt[i] = 0; i = i + 1; }

    var b: u32 = 0;
    for (b < n) {
        var s0: id.BlockId = id.BLOCK_NIL;
        var s1: id.BlockId = id.BLOCK_NIL;
        val sn: u32 = ir.block_successors(fn, ?fn.blocks[b], ?s0, ?s1);
        if (sn >= 1 && s0::u32 < n) { cnt[s0::u32] = cnt[s0::u32] + 1; }
        if (sn >= 2 && s1::u32 < n) { cnt[s1::u32] = cnt[s1::u32] + 1; }
        b = b + 1;
    }

    var total: u32 = 0;
    i = 0;
    for (i < n) { start[i] = total; total = total + cnt[i]; i = i + 1; }

    val rf: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](alloc, total::usize);
    if (sel rf.err) {
        A.deallocate[u32](alloc, start, n::usize);
        A.deallocate[u32](alloc, cnt, n::usize);
        ret err[fail.Fail].err{fail.refused(rf.err)};
    }
    val flat: *id.BlockId = rf.ok;

    val rw: res[*u32, A.Error] = A.allocate[u32](alloc, n::usize);
    if (sel rw.err) {
        A.deallocate[u32](alloc, start, n::usize);
        A.deallocate[u32](alloc, cnt, n::usize);
        A.deallocate[id.BlockId](alloc, flat, total::usize);
        ret err[fail.Fail].err{fail.refused(rw.err)};
    }
    val cur: *u32 = rw.ok;
    i = 0;
    for (i < n) { cur[i] = start[i]; i = i + 1; }

    b = 0;
    for (b < n) {
        var c0: id.BlockId = id.BLOCK_NIL;
        var c1: id.BlockId = id.BLOCK_NIL;
        val cn: u32 = ir.block_successors(fn, ?fn.blocks[b], ?c0, ?c1);
        if (cn >= 1 && c0::u32 < n) { flat[cur[c0::u32]] = b::id.BlockId; cur[c0::u32] = cur[c0::u32] + 1; }
        if (cn >= 2 && c1::u32 < n) { flat[cur[c1::u32]] = b::id.BlockId; cur[c1::u32] = cur[c1::u32] + 1; }
        b = b + 1;
    }

    A.deallocate[u32](alloc, cur, n::usize);

    @out_start = start;
    @out_len   = cnt;
    @out_flat  = flat;
    @out_edges = total;
    ret err[fail.Fail].ok{};
}

fun free_preds(alloc: *A.Allocator, n: u32, edges: u32, start: *u32, len: *u32, flat: *id.BlockId) {
    if (start != nil) { A.deallocate[u32](alloc, start, n::usize); }
    if (len != nil)   { A.deallocate[u32](alloc, len, n::usize); }
    if (flat != nil)  { A.deallocate[id.BlockId](alloc, flat, edges::usize); }
}

fun build_dom(la: *LoopAnalysis, fn: *ir.Function, pred_start: *u32, pred_len: *u32, pred_flat: *id.BlockId) err[fail.Fail] {
    val n: u32 = la.block_count;

    val rr: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](la.alloc, n::usize);
    if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
    la.rpo = rr.ok;

    val ri: res[*u32, A.Error] = A.allocate[u32](la.alloc, n::usize);
    if (sel ri.err) { ret err[fail.Fail].err{fail.refused(ri.err)}; }
    la.rpo_index = ri.ok;

    val rd: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](la.alloc, n::usize);
    if (sel rd.err) { ret err[fail.Fail].err{fail.refused(rd.err)}; }
    la.idom = rd.ok;

    var i: u32 = 0;
    for (i < n) { la.rpo_index[i] = NONE_U32; la.idom[i] = id.BLOCK_NIL; i = i + 1; }

    val rb: err[fail.Fail] = build_rpo(la, fn);
    if (sel rb.err) { ret rb; }

    build_idom(la, pred_start, pred_len, pred_flat);
    ret err[fail.Fail].ok{};
}

fun build_rpo(la: *LoopAnalysis, fn: *ir.Function) err[fail.Fail] {
    val n: u32 = la.block_count;

    val rv: res[*bool, A.Error] = A.allocate[bool](la.alloc, n::usize);
    if (sel rv.err) { ret err[fail.Fail].err{fail.refused(rv.err)}; }
    val visited: *bool = rv.ok;

    val rb: res[*u32, A.Error] = A.allocate[u32](la.alloc, n::usize);
    if (sel rb.err) { A.deallocate[bool](la.alloc, visited, n::usize); ret err[fail.Fail].err{fail.refused(rb.err)}; }
    val stk_block: *u32 = rb.ok;

    val rc: res[*u32, A.Error] = A.allocate[u32](la.alloc, n::usize);
    if (sel rc.err) {
        A.deallocate[bool](la.alloc, visited, n::usize);
        A.deallocate[u32](la.alloc, stk_block, n::usize);
        ret err[fail.Fail].err{fail.refused(rc.err)};
    }
    val stk_succ: *u32 = rc.ok;

    val post: *id.BlockId = la.rpo;
    var post_len: u32 = 0;

    var i: u32 = 0;
    for (i < n) { visited[i] = false; i = i + 1; }

    stk_block[0] = 0;
    stk_succ[0]  = 0;
    visited[0]   = true;
    var sp: u32 = 1;

    for (sp > 0) {
        val top: u32 = sp - 1;
        val bid: u32 = stk_block[top];
        val si:  u32 = stk_succ[top];

        var s0: id.BlockId = id.BLOCK_NIL;
        var s1: id.BlockId = id.BLOCK_NIL;
        val sn: u32 = ir.block_successors(fn, ?fn.blocks[bid], ?s0, ?s1);

        if (si < sn) {
            stk_succ[top] = si + 1;
            var next: id.BlockId = s0;
            if (si == 1) { next = s1; }
            if (next != id.BLOCK_NIL && next::u32 < n) {
                if (visited[next::u32] == false) {
                    visited[next::u32] = true;
                    stk_block[sp] = next::u32;
                    stk_succ[sp]  = 0;
                    sp = sp + 1;
                }
            }
        } or {
            post[post_len] = bid::id.BlockId;
            post_len = post_len + 1;
            sp = sp - 1;
        }
    }

    la.rpo_len = post_len;
    var a: u32 = 0;
    val z: u32 = post_len;
    for (a < z / 2) {
        val tmp: id.BlockId = post[a];
        post[a]         = post[z - 1 - a];
        post[z - 1 - a] = tmp;
        a = a + 1;
    }
    var p: u32 = 0;
    for (p < post_len) {
        la.rpo_index[post[p]::u32] = p;
        p = p + 1;
    }

    A.deallocate[bool](la.alloc, visited, n::usize);
    A.deallocate[u32](la.alloc, stk_block, n::usize);
    A.deallocate[u32](la.alloc, stk_succ, n::usize);
    ret err[fail.Fail].ok{};
}

fun build_idom(la: *LoopAnalysis, pred_start: *u32, pred_len: *u32, pred_flat: *id.BlockId) {
    val entry: u32 = 0;
    la.idom[entry] = entry::id.BlockId;

    var changed: bool = true;
    for (changed) {
        changed = false;
        var r: u32 = 0;
        for (r < la.rpo_len) {
            val b: u32 = la.rpo[r]::u32;
            if (b == entry) { r = r + 1; cnt; }

            var new_idom: u32 = NONE_U32;
            val base: u32 = pred_start[b];
            val pc:   u32 = pred_len[b];
            var pi: u32 = 0;
            for (pi < pc) {
                val pp: u32 = pred_flat[base + pi]::u32;
                if (la.rpo_index[pp] != NONE_U32 && la.idom[pp] != id.BLOCK_NIL) {
                    if (new_idom == NONE_U32) {
                        new_idom = pp;
                    } or {
                        new_idom = intersect(la, pp, new_idom);
                    }
                }
                pi = pi + 1;
            }
            if (new_idom != NONE_U32 && la.idom[b]::u32 != new_idom) {
                la.idom[b] = new_idom::id.BlockId;
                changed = true;
            }
            r = r + 1;
        }
    }
}

fun intersect(la: *LoopAnalysis, b1: u32, b2: u32) u32 {
    var f1: u32 = b1;
    var f2: u32 = b2;
    for (f1 != f2) {
        for (la.rpo_index[f1] > la.rpo_index[f2]) { f1 = la.idom[f1]::u32; }
        for (la.rpo_index[f2] > la.rpo_index[f1]) { f2 = la.idom[f2]::u32; }
    }
    ret f1;
}

fun build_instr_block(la: *LoopAnalysis, fn: *ir.Function) err[fail.Fail] {
    val m: u32 = fn.instr_len;
    la.instr_count = m;
    if (m == 0) { ret err[fail.Fail].ok{}; }

    val rr: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](la.alloc, m::usize);
    if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
    la.instr_block = rr.ok;

    var i: u32 = 0;
    for (i < m) { la.instr_block[i] = id.BLOCK_NIL; i = i + 1; }

    var b: u32 = 0;
    for (b < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[b];
        var pj: u32 = 0;
        for (pj < blk.phi_count) {
            val pid: id.InstructionId = blk.phis[pj];
            if (pid::u32 < m) { la.instr_block[pid::u32] = b::id.BlockId; }
            pj = pj + 1;
        }
        var ij: u32 = 0;
        for (ij < blk.instr_count) {
            val iid: id.InstructionId = blk.instructions[ij];
            if (iid::u32 < m) { la.instr_block[iid::u32] = b::id.BlockId; }
            ij = ij + 1;
        }
        if (blk.terminator != id.INSTR_NIL && blk.terminator::u32 < m) {
            la.instr_block[blk.terminator::u32] = b::id.BlockId;
        }
        b = b + 1;
    }
    ret err[fail.Fail].ok{};
}

fun build_loops(la: *LoopAnalysis, fn: *ir.Function, pred_start: *u32, pred_len: *u32, pred_flat: *id.BlockId) err[fail.Fail] {
    val n: u32 = la.block_count;

    val rl: res[*Loop, A.Error] = A.allocate[Loop](la.alloc, n::usize);
    if (sel rl.err) { ret err[fail.Fail].err{fail.refused(rl.err)}; }
    la.loops    = rl.ok;
    la.loop_cap = n;
    la.loop_len = 0;

    val rm: res[*bool, A.Error] = A.allocate[bool](la.alloc, n::usize);
    if (sel rm.err) { ret err[fail.Fail].err{fail.refused(rm.err)}; }
    val member: *bool = rm.ok;

    val rk: res[*u32, A.Error] = A.allocate[u32](la.alloc, n::usize);
    if (sel rk.err) { A.deallocate[bool](la.alloc, member, n::usize); ret err[fail.Fail].err{fail.refused(rk.err)}; }
    val stack: *u32 = rk.ok;

    var h: u32 = 0;
    for (h < n) {
        val base: u32 = pred_start[h];
        val pc:   u32 = pred_len[h];
        var is_header: bool = false;
        var pi: u32 = 0;
        for (pi < pc) {
            if (dominates(la, h::id.BlockId, pred_flat[base + pi])) { is_header = true; brk; }
            pi = pi + 1;
        }
        if (!is_header) { h = h + 1; cnt; }

        collect_body(la, h, member, stack, pred_start, pred_len, pred_flat);

        val rc: err[fail.Fail] = emit_loop(la, fn, h, member, pred_start, pred_len, pred_flat);
        if (sel rc.err) {
            A.deallocate[bool](la.alloc, member, n::usize);
            A.deallocate[u32](la.alloc, stack, n::usize);
            ret rc;
        }
        h = h + 1;
    }

    A.deallocate[bool](la.alloc, member, n::usize);
    A.deallocate[u32](la.alloc, stack, n::usize);
    ret err[fail.Fail].ok{};
}

fun collect_body(la: *LoopAnalysis, h: u32, member: *bool, stack: *u32, pred_start: *u32, pred_len: *u32, pred_flat: *id.BlockId) {
    val n: u32 = la.block_count;
    var i: u32 = 0;
    for (i < n) { member[i] = false; i = i + 1; }
    member[h] = true;
    var sp: u32 = 0;

    val base: u32 = pred_start[h];
    val pc:   u32 = pred_len[h];
    var pi: u32 = 0;
    for (pi < pc) {
        val p: u32 = pred_flat[base + pi]::u32;
        if (dominates(la, h::id.BlockId, p::id.BlockId)) {
            if (member[p] == false) { member[p] = true; stack[sp] = p; sp = sp + 1; }
        }
        pi = pi + 1;
    }

    for (sp > 0) {
        sp = sp - 1;
        val d: u32 = stack[sp];
        val db: u32 = pred_start[d];
        val dc: u32 = pred_len[d];
        var qi: u32 = 0;
        for (qi < dc) {
            val q: u32 = pred_flat[db + qi]::u32;
            if (member[q] == false) { member[q] = true; stack[sp] = q; sp = sp + 1; }
            qi = qi + 1;
        }
    }
}

fun emit_loop(la: *LoopAnalysis, fn: *ir.Function, h: u32, member: *bool, pred_start: *u32, pred_len: *u32, pred_flat: *id.BlockId) err[fail.Fail] {
    val n: u32 = la.block_count;

    var count: u32 = 0;
    var i: u32 = 0;
    for (i < n) { if (member[i]) { count = count + 1; } i = i + 1; }

    val rb: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](la.alloc, count::usize);
    if (sel rb.err) { ret err[fail.Fail].err{fail.refused(rb.err)}; }
    val body: *id.BlockId = rb.ok;

    var w: u32 = 0;
    i = 0;
    for (i < n) { if (member[i]) { body[w] = i::id.BlockId; w = w + 1; } i = i + 1; }

    val lp: *Loop = ?la.loops[la.loop_len];
    lp.header    = h::id.BlockId;
    lp.preheader = id.BLOCK_NIL;
    lp.latch     = id.BLOCK_NIL;
    lp.exiting   = id.BLOCK_NIL;
    lp.exit      = id.BLOCK_NIL;
    lp.body      = body;
    lp.body_len  = count;
    lp.body_cap  = count;
    lp.parent    = NONE_U32;
    lp.depth     = 0;
    lp.has_iv    = false;
    lp.is_counted = false;

    val base: u32 = pred_start[h];
    val pc:   u32 = pred_len[h];
    var in_cnt: u32 = 0;
    var out_cnt: u32 = 0;
    var latch: id.BlockId = id.BLOCK_NIL;
    var pre:   id.BlockId = id.BLOCK_NIL;
    var pi: u32 = 0;
    for (pi < pc) {
        val p: id.BlockId = pred_flat[base + pi];
        if (member[p::u32]) { in_cnt = in_cnt + 1; latch = p; }
        or { out_cnt = out_cnt + 1; pre = p; }
        pi = pi + 1;
    }
    if (in_cnt == 1)  { lp.latch = latch; }
    if (out_cnt == 1) {
        var ps0: id.BlockId = id.BLOCK_NIL;
        var ps1: id.BlockId = id.BLOCK_NIL;
        val psn: u32 = ir.block_successors(fn, ?fn.blocks[pre::u32], ?ps0, ?ps1);
        if (psn == 1 && ps0 == lp.header) { lp.preheader = pre; }
    }

    fill_exit(la, fn, member, lp, pred_start, pred_len, pred_flat);

    la.loop_len = la.loop_len + 1;
    ret err[fail.Fail].ok{};
}

fun fill_exit(la: *LoopAnalysis, fn: *ir.Function, member: *bool, lp: *Loop, pred_start: *u32, pred_len: *u32, pred_flat: *id.BlockId) {
    val n: u32 = la.block_count;
    var exiting: id.BlockId = id.BLOCK_NIL;
    var exit:    id.BlockId = id.BLOCK_NIL;
    var exiting_cnt: u32 = 0;
    var exit_multi: bool = false;

    var bi: u32 = 0;
    for (bi < lp.body_len) {
        val b: u32 = lp.body[bi]::u32;
        var s0: id.BlockId = id.BLOCK_NIL;
        var s1: id.BlockId = id.BLOCK_NIL;
        val sn: u32 = ir.block_successors(fn, ?fn.blocks[b], ?s0, ?s1);
        var leaves: bool = false;
        if (sn >= 1 && s0::u32 < n && member[s0::u32] == false) {
            leaves = true;
            if (exit == id.BLOCK_NIL) { exit = s0; } or { if (exit != s0) { exit_multi = true; } }
        }
        if (sn >= 2 && s1::u32 < n && member[s1::u32] == false) {
            leaves = true;
            if (exit == id.BLOCK_NIL) { exit = s1; } or { if (exit != s1) { exit_multi = true; } }
        }
        if (leaves) { exiting_cnt = exiting_cnt + 1; exiting = b::id.BlockId; }
        bi = bi + 1;
    }

    if (exiting_cnt == 1) { lp.exiting = exiting; }

    if (!exit_multi && exit != id.BLOCK_NIL) {
        val ebase: u32 = pred_start[exit::u32];
        val ec:    u32 = pred_len[exit::u32];
        var dedicated: bool = true;
        var pi: u32 = 0;
        for (pi < ec) {
            if (member[pred_flat[ebase + pi]::u32] == false) { dedicated = false; brk; }
            pi = pi + 1;
        }
        if (dedicated) { lp.exit = exit; }
    }
}

fun compute_nesting(la: *LoopAnalysis) {
    var i: u32 = 0;
    for (i < la.loop_len) {
        val lp: *Loop = ?la.loops[i];
        var best: u32 = NONE_U32;
        var best_size: u32 = 0xFFFFFFFF;
        var j: u32 = 0;
        for (j < la.loop_len) {
            if (j != i) {
                if (loop_contains(la, j, lp.header)) {
                    if (la.loops[j].body_len < best_size) {
                        best = j;
                        best_size = la.loops[j].body_len;
                    }
                }
            }
            j = j + 1;
        }
        lp.parent = best;
        i = i + 1;
    }

    i = 0;
    for (i < la.loop_len) {
        var d: u32 = 0;
        var p: u32 = la.loops[i].parent;
        var guard: u32 = 0;
        for (p != NONE_U32) {
            d = d + 1;
            p = la.loops[p].parent;
            guard = guard + 1;
            if (guard > la.loop_len) { panic("mach.lang.me.analysis.loops: cyclic loop-nesting parent chain\n"); }
        }
        la.loops[i].depth = d;
        i = i + 1;
    }
}

fun recognize_counted(la: *LoopAnalysis, fn: *ir.Function, loop_ix: u32) bool {
    val lp: *Loop = ?la.loops[loop_ix];
    if (lp.preheader == id.BLOCK_NIL || lp.latch == id.BLOCK_NIL) { ret false; }

    val hblk: *ir.Block = ?fn.blocks[lp.header::u32];
    val topt: opt[*instruction.Instruction] = ir.instruction_get(fn, hblk.terminator);
    if (sel topt.none) { ret false; }
    val term: *instruction.Instruction = topt.some;
    if (term.kind != instruction.OP_CBR || term.operand_count < 3) { ret false; }

    val cond: value.Value = term.operands[0];
    if (cond.kind != value.VAL_INSTR) { ret false; }
    val copt: opt[*instruction.Instruction] = ir.instruction_get(fn, cond.data.instr);
    if (sel copt.none) { ret false; }
    val cmp: *instruction.Instruction = copt.some;
    if (!is_cmp_lt_le(cmp.kind) || cmp.operand_count != 2) { ret false; }

    val l: value.Value = cmp.operands[0];
    val r: value.Value = cmp.operands[1];
    var phi_id: id.InstructionId = id.INSTR_NIL;
    var bound: value.Value = l;
    var iv_on_left: bool = false;
    if (l.kind == value.VAL_INSTR && is_header_phi(fn, hblk, l.data.instr)) {
        phi_id = l.data.instr; bound = r; iv_on_left = true;
    } or {
        if (r.kind == value.VAL_INSTR && is_header_phi(fn, hblk, r.data.instr)) {
            phi_id = r.data.instr; bound = l; iv_on_left = false;
        } or { ret false; }
    }

    if (!is_invariant(la, loop_ix, bound)) { ret false; }

    val then_b: id.BlockId = ir.block_target(term.operands[1]);
    val else_b: id.BlockId = ir.block_target(term.operands[2]);
    val then_in: bool = loop_contains(la, loop_ix, then_b);
    val else_in: bool = loop_contains(la, loop_ix, else_b);
    if (then_in == else_in) { ret false; }

    if (lp.exiting != lp.header) { ret false; }

    var init: value.Value;
    var step: value.Value;
    var upd:  id.InstructionId = id.INSTR_NIL;
    if (!analyze_phi_iv(la, fn, loop_ix, phi_id, ?init, ?step, ?upd)) { ret false; }

    if (step.kind != value.VAL_CONST_INT) { ret false; }
    val s: i64 = step.data.int_lit:~i64;
    if (s == 0) { ret false; }
    val want_pos: bool = (iv_on_left == then_in);
    if (want_pos && s < 0)  { ret false; }
    if (!want_pos && s > 0) { ret false; }

    lp.has_iv     = true;
    lp.iv.phi     = phi_id;
    lp.iv.init    = init;
    lp.iv.step    = step;
    lp.iv.update  = upd;
    lp.is_counted = true;
    lp.counted.bound            = bound;
    lp.counted.bound_inclusive  = (cmp.kind == instruction.OP_CMP_LE_S || cmp.kind == instruction.OP_CMP_LE_U);
    lp.counted.pred             = cmp.kind;
    lp.counted.cmp              = cond.data.instr;
    lp.counted.iv_on_left       = iv_on_left;
    lp.counted.continue_on_true = then_in;
    ret true;
}

fun recognize_iv(la: *LoopAnalysis, fn: *ir.Function, loop_ix: u32) {
    val lp: *Loop = ?la.loops[loop_ix];
    if (lp.preheader == id.BLOCK_NIL || lp.latch == id.BLOCK_NIL) { ret; }
    val hblk: *ir.Block = ?fn.blocks[lp.header::u32];
    var pj: u32 = 0;
    for (pj < hblk.phi_count) {
        val phi_id: id.InstructionId = hblk.phis[pj];
        var init: value.Value;
        var step: value.Value;
        var upd:  id.InstructionId = id.INSTR_NIL;
        if (analyze_phi_iv(la, fn, loop_ix, phi_id, ?init, ?step, ?upd)) {
            lp.has_iv    = true;
            lp.iv.phi    = phi_id;
            lp.iv.init   = init;
            lp.iv.step   = step;
            lp.iv.update = upd;
            ret;
        }
        pj = pj + 1;
    }
}

fun analyze_phi_iv(la: *LoopAnalysis, fn: *ir.Function, loop_ix: u32, phi_id: id.InstructionId, out_init: *value.Value, out_step: *value.Value, out_update: *id.InstructionId) bool {
    val lp: *Loop = ?la.loops[loop_ix];
    if (lp.preheader == id.BLOCK_NIL || lp.latch == id.BLOCK_NIL) { ret false; }

    val popt: opt[*instruction.Instruction] = ir.instruction_get(fn, phi_id);
    if (sel popt.none) { ret false; }
    val phi: *instruction.Instruction = popt.some;
    if (phi.kind != instruction.OP_PHI || phi.operand_count != 4) { ret false; }

    var init: value.Value;
    var upd:  value.Value;
    var got_init: bool = false;
    var got_upd:  bool = false;
    var j: u32 = 0;
    for (j < 2) {
        val btgt: id.BlockId = ir.block_target(phi.operands[2 * j]);
        val vv:   value.Value = phi.operands[2 * j + 1];
        if (btgt == lp.preheader) { init = vv; got_init = true; }
        if (btgt == lp.latch)     { upd  = vv; got_upd  = true; }
        j = j + 1;
    }
    if (!got_init || !got_upd) { ret false; }
    if (upd.kind != value.VAL_INSTR) { ret false; }

    val uopt: opt[*instruction.Instruction] = ir.instruction_get(fn, upd.data.instr);
    if (sel uopt.none) { ret false; }
    val u: *instruction.Instruction = uopt.some;
    if (u.kind != instruction.OP_ADD || u.operand_count != 2) { ret false; }

    val a: value.Value = u.operands[0];
    val b: value.Value = u.operands[1];
    var step: value.Value = b;
    if (a.kind == value.VAL_INSTR && a.data.instr == phi_id) {
        step = b;
    } or {
        if (b.kind == value.VAL_INSTR && b.data.instr == phi_id) {
            step = a;
        } or { ret false; }
    }
    if (!is_invariant(la, loop_ix, step)) { ret false; }

    @out_init   = init;
    @out_step   = step;
    @out_update = upd.data.instr;
    ret true;
}

fun is_header_phi(fn: *ir.Function, blk: *ir.Block, iid: id.InstructionId) bool {
    var pj: u32 = 0;
    for (pj < blk.phi_count) {
        if (blk.phis[pj] == iid) { ret true; }
        pj = pj + 1;
    }
    ret false;
}

fun is_cmp_lt_le(k: instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_CMP_ORDERED);
}


use std.allocator.page;
use mach.lang.intern;
use mach.lang.me.ir.builder;
use ir_type: mach.lang.me.ir.type;

test "mach.lang.me.analysis.loops:counted_loop_structure" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val re: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel re.err) { ir.dnit(?m); ret 1; }
    val entry: id.BlockId = re.ok;
    val rh: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rh.err) { ir.dnit(?m); ret 1; }
    val header: id.BlockId = rh.ok;
    val rbo: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rbo.err) { ir.dnit(?m); ret 1; }
    val body: id.BlockId = rbo.ok;
    val rx: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rx.err) { ir.dnit(?m); ret 1; }
    val exit: id.BlockId = rx.ok;

    val n: value.Value = value.param(0, i64t);
    val zero: value.Value = value.const_int(0, i64t);
    val one: value.Value = value.const_int(1, i64t);

    builder.set_block(?bld, entry);
    val r_876: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_876.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel rphi.err) { ir.dnit(?m); ret 1; }
    val phi: value.Value = rphi.ok;
    val rcmp: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?bld, phi, n);
    if (sel rcmp.err) { ir.dnit(?m); ret 1; }
    val r_884: err[fail.Fail] = builder.emit_cbr(?bld, rcmp.ok, body, exit);
    if (sel r_884.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, body);
    val rupd: res[value.Value, fail.Fail] = builder.emit_add(?bld, phi, one);
    if (sel rupd.err) { ir.dnit(?m); ret 1; }
    val upd: value.Value = rupd.ok;
    val r_890: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_890.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, exit);
    val r_893: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_893.err) { ir.dnit(?m); ret 1; }

    val r_895: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, entry, zero);
    if (sel r_895.err) { ir.dnit(?m); ret 1; }
    val r_896: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, body, upd);
    if (sel r_896.err) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val ra: res[LoopAnalysis, fail.Fail] = analyze(fn, ?alloc);
    if (sel ra.err) { ir.dnit(?m); ret 1; }
    var la: LoopAnalysis = ra.ok;

    if (la.loop_len != 1) { code = 1; }
    or {
        val lp: *Loop = ?la.loops[0];
        if (lp.header != header)                        { code = 1; }
        if (lp.preheader != entry)                      { code = 1; }
        if (lp.latch != body)                           { code = 1; }
        if (lp.exit != exit)                            { code = 1; }
        if (lp.exiting != header)                       { code = 1; }
        if (lp.depth != 0)                              { code = 1; }
        if (!lp.is_counted)                             { code = 1; }
        if (!lp.has_iv)                                 { code = 1; }
        if (lp.iv.phi != phi.data.instr)                { code = 1; }
        if (lp.iv.step.kind != value.VAL_CONST_INT)     { code = 1; }
        if (lp.iv.step.data.int_lit != 1)               { code = 1; }
        if (lp.counted.pred != instruction.OP_CMP_LT_S) { code = 1; }
        if (!lp.counted.iv_on_left)                     { code = 1; }
        if (!lp.counted.continue_on_true)               { code = 1; }
        if (lp.counted.bound.kind != value.VAL_PARAM)   { code = 1; }
    }

    if (!dominates(?la, header, body))   { code = 1; }
    if (!dominates(?la, entry, exit))    { code = 1; }
    if (dominates(?la, body, header))    { code = 1; }
    if (!dominates(?la, header, header)) { code = 1; }

    dnit(?la);
    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.analysis.loops:reduction_selects_counter" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val re: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel re.err) { ir.dnit(?m); ret 1; }
    val entry: id.BlockId = re.ok;
    val rh: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rh.err) { ir.dnit(?m); ret 1; }
    val header: id.BlockId = rh.ok;
    val rbo: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rbo.err) { ir.dnit(?m); ret 1; }
    val body: id.BlockId = rbo.ok;
    val rx: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rx.err) { ir.dnit(?m); ret 1; }
    val exit: id.BlockId = rx.ok;

    val n: value.Value = value.param(0, i64t);
    val zero: value.Value = value.const_int(0, i64t);
    val one: value.Value = value.const_int(1, i64t);

    builder.set_block(?bld, entry);
    val r_969: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_969.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, header);
    val racc: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel racc.err) { ir.dnit(?m); ret 1; }
    val acc: value.Value = racc.ok;
    val riv: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel riv.err) { ir.dnit(?m); ret 1; }
    val iv: value.Value = riv.ok;
    val rcmp: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?bld, iv, n);
    if (sel rcmp.err) { ir.dnit(?m); ret 1; }
    val r_980: err[fail.Fail] = builder.emit_cbr(?bld, rcmp.ok, body, exit);
    if (sel r_980.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, body);
    val rprod: res[value.Value, fail.Fail] = builder.emit_mul(?bld, iv, iv);
    if (sel rprod.err) { ir.dnit(?m); ret 1; }
    val prod: value.Value = rprod.ok;
    val racu: res[value.Value, fail.Fail] = builder.emit_add(?bld, acc, prod);
    if (sel racu.err) { ir.dnit(?m); ret 1; }
    val acc_upd: value.Value = racu.ok;
    val rivu: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, one);
    if (sel rivu.err) { ir.dnit(?m); ret 1; }
    val iv_upd: value.Value = rivu.ok;
    val r_992: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_992.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, exit);
    val r_995: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_995.err) { ir.dnit(?m); ret 1; }

    val r_997: err[fail.Fail] = builder.phi_add_incoming(?bld, acc, entry, zero);
    if (sel r_997.err) { ir.dnit(?m); ret 1; }
    val r_998: err[fail.Fail] = builder.phi_add_incoming(?bld, acc, body, acc_upd);
    if (sel r_998.err) { ir.dnit(?m); ret 1; }
    val r_999: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, entry, zero);
    if (sel r_999.err) { ir.dnit(?m); ret 1; }
    val r_1000: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, iv_upd);
    if (sel r_1000.err) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val ra: res[LoopAnalysis, fail.Fail] = analyze(fn, ?alloc);
    if (sel ra.err) { ir.dnit(?m); ret 1; }
    var la: LoopAnalysis = ra.ok;

    if (la.loop_len != 1) { code = 1; }
    or {
        val lp: *Loop = ?la.loops[0];
        if (!lp.is_counted)              { code = 1; }
        if (!lp.has_iv)                  { code = 1; }
        if (lp.iv.phi != iv.data.instr)  { code = 1; }
        if (lp.iv.phi == acc.data.instr) { code = 1; }
        if (lp.iv.step.data.int_lit != 1) { code = 1; }
        if (lp.counted.bound.kind != value.VAL_PARAM) { code = 1; }
    }

    dnit(?la);
    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.analysis.loops:multi_latch_declines" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val re: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel re.err) { ir.dnit(?m); ret 1; }
    val entry: id.BlockId = re.ok;
    val rh: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rh.err) { ir.dnit(?m); ret 1; }
    val header: id.BlockId = rh.ok;
    val rb1: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb1.err) { ir.dnit(?m); ret 1; }
    val body1: id.BlockId = rb1.ok;
    val rb2: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb2.err) { ir.dnit(?m); ret 1; }
    val body2: id.BlockId = rb2.ok;
    val rx: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rx.err) { ir.dnit(?m); ret 1; }
    val exit: id.BlockId = rx.ok;

    val n: value.Value = value.param(0, i64t);

    builder.set_block(?bld, entry);
    val r_1060: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_1060.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel rphi.err) { ir.dnit(?m); ret 1; }
    val phi: value.Value = rphi.ok;
    val rc1: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?bld, phi, n);
    if (sel rc1.err) { ir.dnit(?m); ret 1; }
    val r_1068: err[fail.Fail] = builder.emit_cbr(?bld, rc1.ok, body1, exit);
    if (sel r_1068.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, body1);
    val rc2: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?bld, phi, n);
    if (sel rc2.err) { ir.dnit(?m); ret 1; }
    val r_1073: err[fail.Fail] = builder.emit_cbr(?bld, rc2.ok, header, body2);
    if (sel r_1073.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, body2);
    val r_1076: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_1076.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, exit);
    val r_1079: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_1079.err) { ir.dnit(?m); ret 1; }

    val r_1081: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, entry, value.const_int(0, i64t));
    if (sel r_1081.err) { ir.dnit(?m); ret 1; }
    val r_1082: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, body1, value.const_int(1, i64t));
    if (sel r_1082.err) { ir.dnit(?m); ret 1; }
    val r_1083: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, body2, value.const_int(2, i64t));
    if (sel r_1083.err) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val ra: res[LoopAnalysis, fail.Fail] = analyze(fn, ?alloc);
    if (sel ra.err) { ir.dnit(?m); ret 1; }
    var la: LoopAnalysis = ra.ok;

    if (la.loop_len != 1) { code = 1; }
    or {
        val lp: *Loop = ?la.loops[0];
        if (lp.header != header)         { code = 1; }
        if (lp.latch != id.BLOCK_NIL)    { code = 1; }
        if (lp.preheader != entry)       { code = 1; }
        if (lp.is_counted)               { code = 1; }
        if (lp.has_iv)                   { code = 1; }
        if (lp.body_len != 3)            { code = 1; }
        if (!loop_contains(?la, 0, header)) { code = 1; }
        if (!loop_contains(?la, 0, body1))  { code = 1; }
        if (!loop_contains(?la, 0, body2))  { code = 1; }
    }

    dnit(?la);
    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.analysis.loops:nested_depth_and_parent" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val re: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel re.err) { ir.dnit(?m); ret 1; }
    val entry: id.BlockId = re.ok;
    val roh: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel roh.err) { ir.dnit(?m); ret 1; }
    val outer_h: id.BlockId = roh.ok;
    val rip: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rip.err) { ir.dnit(?m); ret 1; }
    val inner_pre: id.BlockId = rip.ok;
    val rih: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rih.err) { ir.dnit(?m); ret 1; }
    val inner_h: id.BlockId = rih.ok;
    val rib: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rib.err) { ir.dnit(?m); ret 1; }
    val inner_body: id.BlockId = rib.ok;
    val rol: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rol.err) { ir.dnit(?m); ret 1; }
    val outer_latch: id.BlockId = rol.ok;
    val rx: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rx.err) { ir.dnit(?m); ret 1; }
    val exit: id.BlockId = rx.ok;

    val n: value.Value = value.param(0, i64t);
    val zero: value.Value = value.const_int(0, i64t);
    val one: value.Value = value.const_int(1, i64t);

    builder.set_block(?bld, entry);
    val r_1154: err[fail.Fail] = builder.emit_br(?bld, outer_h);
    if (sel r_1154.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, outer_h);
    val rpo: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel rpo.err) { ir.dnit(?m); ret 1; }
    val phi_o: value.Value = rpo.ok;
    val rco: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?bld, phi_o, n);
    if (sel rco.err) { ir.dnit(?m); ret 1; }
    val r_1162: err[fail.Fail] = builder.emit_cbr(?bld, rco.ok, inner_pre, exit);
    if (sel r_1162.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, inner_pre);
    val r_1165: err[fail.Fail] = builder.emit_br(?bld, inner_h);
    if (sel r_1165.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, inner_h);
    val rpi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel rpi.err) { ir.dnit(?m); ret 1; }
    val phi_i: value.Value = rpi.ok;
    val rci: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?bld, phi_i, n);
    if (sel rci.err) { ir.dnit(?m); ret 1; }
    val r_1173: err[fail.Fail] = builder.emit_cbr(?bld, rci.ok, inner_body, outer_latch);
    if (sel r_1173.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, inner_body);
    val riu: res[value.Value, fail.Fail] = builder.emit_add(?bld, phi_i, one);
    if (sel riu.err) { ir.dnit(?m); ret 1; }
    val iv_i_upd: value.Value = riu.ok;
    val r_1179: err[fail.Fail] = builder.emit_br(?bld, inner_h);
    if (sel r_1179.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, outer_latch);
    val rou: res[value.Value, fail.Fail] = builder.emit_add(?bld, phi_o, one);
    if (sel rou.err) { ir.dnit(?m); ret 1; }
    val iv_o_upd: value.Value = rou.ok;
    val r_1185: err[fail.Fail] = builder.emit_br(?bld, outer_h);
    if (sel r_1185.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, exit);
    val r_1188: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_1188.err) { ir.dnit(?m); ret 1; }

    val r_1190: err[fail.Fail] = builder.phi_add_incoming(?bld, phi_o, entry, zero);
    if (sel r_1190.err) { ir.dnit(?m); ret 1; }
    val r_1191: err[fail.Fail] = builder.phi_add_incoming(?bld, phi_o, outer_latch, iv_o_upd);
    if (sel r_1191.err) { ir.dnit(?m); ret 1; }
    val r_1192: err[fail.Fail] = builder.phi_add_incoming(?bld, phi_i, inner_pre, zero);
    if (sel r_1192.err) { ir.dnit(?m); ret 1; }
    val r_1193: err[fail.Fail] = builder.phi_add_incoming(?bld, phi_i, inner_body, iv_i_upd);
    if (sel r_1193.err) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val ra: res[LoopAnalysis, fail.Fail] = analyze(fn, ?alloc);
    if (sel ra.err) { ir.dnit(?m); ret 1; }
    var la: LoopAnalysis = ra.ok;

    if (la.loop_len != 2) { code = 1; }
    or {
        var inner_ix: u32 = NONE_U32;
        var outer_ix: u32 = NONE_U32;
        var i: u32 = 0;
        for (i < la.loop_len) {
            if (la.loops[i].body_len == 2) { inner_ix = i; }
            if (la.loops[i].body_len == 5) { outer_ix = i; }
            i = i + 1;
        }
        if (inner_ix == NONE_U32 || outer_ix == NONE_U32) { code = 1; }
        or {
            val inner: *Loop = ?la.loops[inner_ix];
            val outer: *Loop = ?la.loops[outer_ix];
            if (inner.header != inner_h)       { code = 1; }
            if (outer.header != outer_h)       { code = 1; }
            if (inner.parent != outer_ix)      { code = 1; }
            if (outer.parent != NONE_U32)      { code = 1; }
            if (inner.depth != 1)              { code = 1; }
            if (outer.depth != 0)              { code = 1; }
            if (!inner.is_counted)             { code = 1; }
            if (!outer.is_counted)             { code = 1; }
            if (inner.preheader != inner_pre)  { code = 1; }
            if (outer.preheader != entry)      { code = 1; }
            if (inner.latch != inner_body)     { code = 1; }
            if (outer.latch != outer_latch)    { code = 1; }
            if (!loop_contains(?la, outer_ix, inner_h)) { code = 1; }
        }
    }

    dnit(?la);
    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.analysis.loops:early_exit_not_counted" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val re: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel re.err) { ir.dnit(?m); ret 1; }
    val entry: id.BlockId = re.ok;
    val rh: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rh.err) { ir.dnit(?m); ret 1; }
    val header: id.BlockId = rh.ok;
    val rbo: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rbo.err) { ir.dnit(?m); ret 1; }
    val body: id.BlockId = rbo.ok;
    val rla: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rla.err) { ir.dnit(?m); ret 1; }
    val latch: id.BlockId = rla.ok;
    val rfo: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rfo.err) { ir.dnit(?m); ret 1; }
    val found: id.BlockId = rfo.ok;
    val rx: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rx.err) { ir.dnit(?m); ret 1; }
    val exit: id.BlockId = rx.ok;

    val n: value.Value = value.param(0, i64t);
    val zero: value.Value = value.const_int(0, i64t);
    val one: value.Value = value.const_int(1, i64t);
    val five: value.Value = value.const_int(5, i64t);

    builder.set_block(?bld, entry);
    val r_1275: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_1275.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel rphi.err) { ir.dnit(?m); ret 1; }
    val phi: value.Value = rphi.ok;
    val rc1: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?bld, phi, n);
    if (sel rc1.err) { ir.dnit(?m); ret 1; }
    val r_1282: err[fail.Fail] = builder.emit_cbr(?bld, rc1.ok, body, exit);
    if (sel r_1282.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, body);
    val rc2: res[value.Value, fail.Fail] = builder.emit_cmp_eq(?bld, phi, five);
    if (sel rc2.err) { ir.dnit(?m); ret 1; }
    val r_1286: err[fail.Fail] = builder.emit_cbr(?bld, rc2.ok, found, latch);
    if (sel r_1286.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, latch);
    val rupd: res[value.Value, fail.Fail] = builder.emit_add(?bld, phi, one);
    if (sel rupd.err) { ir.dnit(?m); ret 1; }
    val upd: value.Value = rupd.ok;
    val r_1291: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_1291.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, found);
    val r_1293: err[fail.Fail] = builder.emit_br(?bld, exit);
    if (sel r_1293.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, exit);
    val r_1295: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_1295.err) { ir.dnit(?m); ret 1; }
    val r_1296: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, entry, zero);
    if (sel r_1296.err) { ir.dnit(?m); ret 1; }
    val r_1297: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, latch, upd);
    if (sel r_1297.err) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val ra: res[LoopAnalysis, fail.Fail] = analyze(fn, ?alloc);
    if (sel ra.err) { ir.dnit(?m); ret 1; }
    var la: LoopAnalysis = ra.ok;
    if (la.loop_len != 1) { code = 1; }
    or {
        val lp: *Loop = ?la.loops[0];
        if (lp.is_counted)            { code = 1; }
        if (lp.exiting != id.BLOCK_NIL) { code = 1; }
    }
    dnit(?la);
    ir.dnit(?m);
    ret code;
}

