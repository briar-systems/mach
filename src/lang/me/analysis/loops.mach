    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(?f.bld, i64t);
    if (sel rphi.err) { ret 1; }
    val phi: value.Value                 = rphi.ok;
    val rc1: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?f.bld, phi, n);
    if (sel rc1.err) { ret 1; }
    val r_1490: err[fail.Fail] = builder.emit_cbr(?f.bld, rc1.ok, body, exit);
    if (sel r_1490.err) { ret 1; }
