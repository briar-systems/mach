    if (sel r_1431.err) { ir.dnit(?m); ret 1; }
    val r_1432: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, body, upd);
    if (sel r_1432.err) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val ra: res[LoopAnalysis, fail.Fail] = analyze(fn, ?alloc);
    if (sel ra.err) { ir.dnit(?m); ret 1; }
    var la: LoopAnalysis = ra.ok;
    if (la.loop_len != 1) { code = 1; }
    or {
        val lp: *Loop = ?la.loops[0];
        if (lp.is_counted)  { code = 1; }
        if (!lp.has_iv)     { code = 1; }
        if ((lp.iv.step.data.int_lit:~i64) != (0 - 1)) { code = 1; }
    }
    dnit(?la);
    ir.dnit(?m);
    ret code;
}

