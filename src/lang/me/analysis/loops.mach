use mach.lang.fail;
use mach.lang.growth;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.me.analysis.dominance;
use me_ir:          mach.lang.me.ir;
use ir_id:          mach.lang.me.ir.id;
use ir_instruction: mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.wide;

pub val NONE_U32: u32 = 0xFFFFFFFF;

pub rec InductionVar {
    phi:    ir_id.InstructionId;
    init:   value.Value;
    step:   value.Value;
    update: ir_id.InstructionId;
}

pub rec CountedInfo {
    bound:            value.Value;
    bound_inclusive:  bool;
    pred:             ir_instruction.InstrKind;
    cmp:              ir_id.InstructionId;
    iv_on_left:       bool;
    continue_on_true: bool;
}

pub rec Loop {
    header:    ir_id.BlockId;
    preheader: ir_id.BlockId;
    latch:     ir_id.BlockId;
    exiting:   ir_id.BlockId;
    exit:      ir_id.BlockId;

    body:     *ir_id.BlockId;
    body_len: u32;
    body_cap: u32;

    parent: u32;
    depth:  u32;

    has_iv:     bool;
    iv:         InductionVar;
    is_counted: bool;
    counted:    CountedInfo;
}

# the loops of a function over its dominator tree, which the analysis owns
# when `analyze` built it and borrows when `analyze_on` was handed it
pub rec LoopAnalysis {
    alloc:       *A.Allocator;
    types:       *ir_type.IrTypeTable;
    block_count: u32;

    dom:      *dominance.Dominance;
    owns_dom: bool;

    instr_block: *ir_id.BlockId;
    instr_count: u32;

    loops:    *Loop;
    loop_len: u32;
    loop_cap: u32;
}

# the loops of `fn` over a dominator tree built for them; the type table reads
# a counted loop's induction variable at its width
pub fun analyze(fn: *me_ir.Function, types: *ir_type.IrTypeTable, alloc: *A.Allocator) res[LoopAnalysis, fail.Fail] {
    val rd: res[*dominance.Dominance, A.Error] = A.allocate[dominance.Dominance](alloc, 1);
    if (sel rd.err) { ret res[LoopAnalysis, fail.Fail].err{fail.refused(rd.err)}; }
    val built: res[dominance.Dominance, fail.Fail] = dominance.init(fn, alloc);
    if (sel built.err) {
        A.deallocate[dominance.Dominance](alloc, rd.ok, 1);
        ret res[LoopAnalysis, fail.Fail].err{built.err};
    }
    rd.ok[0] = built.ok;
    val ral: res[LoopAnalysis, fail.Fail] = analyze_on(rd.ok, fn, types, alloc);
    if (sel ral.err) {
        dominance.dnit(rd.ok);
        A.deallocate[dominance.Dominance](alloc, rd.ok, 1);
        ret ral;
    }
    var la: LoopAnalysis = ral.ok;
    la.owns_dom = true;
    ret res[LoopAnalysis, fail.Fail].ok{la};
}

# the loops of `fn` over `dom`, its dominator tree as it stands, which must
# outlive the analysis
pub fun analyze_on(dom: *dominance.Dominance, fn: *me_ir.Function, types: *ir_type.IrTypeTable, alloc: *A.Allocator) res[LoopAnalysis, fail.Fail] {
    var la: LoopAnalysis;
    la.alloc       = alloc;
    la.types       = types;
    la.block_count = fn.block_count;
    la.dom         = dom;
    la.owns_dom    = false;
    la.instr_block = nil;
    la.instr_count = 0;
    la.loops       = nil;
    la.loop_len    = 0;
    la.loop_cap    = 0;
    if (fn.block_count == 0) { ret res[LoopAnalysis, fail.Fail].ok{la}; }

    val ri: err[fail.Fail] = build_instr_block(?la, fn);
    if (sel ri.err) {
        dnit(?la);
        ret res[LoopAnalysis, fail.Fail].err{ri.err};
    }

    val rl: err[fail.Fail] = build_loops(?la, fn, dom.pred_start, dom.pred_len, dom.pred_flat);
    if (sel rl.err) {
        dnit(?la);
        ret res[LoopAnalysis, fail.Fail].err{rl.err};
    }

    val nested: err[fail.Fail] = compute_nesting(?la);
    if (sel nested.err) {
        dnit(?la);
        ret res[LoopAnalysis, fail.Fail].err{nested.err};
    }
    var i: u32 = 0;
    for (i < la.loop_len) {
        val lp: *Loop = ?la.loops[i];
        lp.has_iv     = false;
        lp.is_counted = false;
        if (!recognize_counted(?la, fn, i)) {
            recognize_iv(?la, fn, i);
        }
        i = i + 1;
    }

    ret res[LoopAnalysis, fail.Fail].ok{la};
}

pub fun dnit(la: *LoopAnalysis) {
    if (la.owns_dom && la.dom != nil) {
        dominance.dnit(la.dom);
        A.deallocate[dominance.Dominance](la.alloc, la.dom, 1);
        la.dom      = nil;
        la.owns_dom = false;
    }
    if (la.instr_block != nil) {
        A.deallocate[ir_id.BlockId](la.alloc, la.instr_block, la.instr_count::usize);
        la.instr_block = nil;
    }
    if (la.loops != nil) {
        var i: u32 = 0;
        for (i < la.loop_len) {
            val lp: *Loop = ?la.loops[i];
            if (lp.body != nil && lp.body_cap > 0) {
                A.deallocate[ir_id.BlockId](la.alloc, lp.body, lp.body_cap::usize);
                lp.body = nil;
            }
            i = i + 1;
        }
        A.deallocate[Loop](la.alloc, la.loops, la.loop_cap::usize);
        la.loops = nil;
    }
    la.loop_len = 0;
}

pub fun loop_contains(la: *LoopAnalysis, loop_ix: u32, b: ir_id.BlockId) bool {
    if (loop_ix >= la.loop_len) { ret false; }
    val lp: *Loop = ?la.loops[loop_ix];
    var i:  u32   = 0;
    for (i < lp.body_len) {
        if (ir_id.block_same(lp.body[i], b)) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun is_invariant(la: *LoopAnalysis, loop_ix: u32, v: value.Value) bool {
    if (v.kind == value.VAL_CONST_INT)   { ret true; }
    if (v.kind == value.VAL_CONST_FLOAT) { ret true; }
    if (v.kind == value.VAL_CONST_NULL)  { ret true; }
    if (v.kind == value.VAL_CONST_BYTES) { ret true; }
    if (v.kind == value.VAL_CONST_AGG)   { ret true; }
    if (v.kind == value.VAL_PARAM)       { ret true; }
    if (v.kind == value.VAL_GLOBAL)      { ret true; }
    if (v.kind == value.VAL_FN)          { ret true; }
    if (v.kind == value.VAL_INSTR) {
        val iid: ir_id.InstructionId = v.data.instr;
        if (iid::u32 >= la.instr_count) { ret false; }
        val db: ir_id.BlockId = la.instr_block[iid::u32];
        if (ir_id.block_is_nil(db)) { ret false; }
        ret !loop_contains(la, loop_ix, db);
    }
    ret false;
}

pub fun set_instr_block(la: *LoopAnalysis, iid: ir_id.InstructionId, b: ir_id.BlockId) err[fail.Fail] {
    val ix: u32 = iid::u32;
    if (ix >= la.instr_count) {
        var i:  u32          = la.instr_count;
        val rg: err[A.Error] = growth.resize[ir_id.BlockId](la.alloc, ?la.instr_block, ?la.instr_count, ix::usize + 1);
        if (sel rg.err) { ret err[fail.Fail].err{fail.refused(rg.err)}; }
        for (i < la.instr_count) {
            la.instr_block[i] = ir_id.BLOCK_NIL;
            i                 = i + 1;
        }
    }
    la.instr_block[ix] = b;
    ret err[fail.Fail].ok{};
}

# whether a header phi is an induction, entered as `init` from the preheader
# and stepped by an invariant `step` on the latch, recognized as the loop's
# own iv is
pub fun induction(la: *LoopAnalysis, fn: *me_ir.Function, loop_ix: u32, phi_id: ir_id.InstructionId, out: *InductionVar) bool {
    if (loop_ix >= la.loop_len) { ret false; }
    var init: value.Value;
    var step: value.Value;
    var upd:  ir_id.InstructionId = ir_id.INSTR_NIL;
    if (!analyze_phi_iv(la, fn, loop_ix, phi_id, ?init, ?step, ?upd)) { ret false; }
    out.phi    = phi_id;
    out.init   = init;
    out.step   = step;
    out.update = upd;
    ret true;
}

# the loop indices deepest first, so a pass that moves code outward meets an
# inner loop before the loop around it
pub fun innermost_first(la: *LoopAnalysis, order: *u32) {
    var i: u32 = 0;
    for (i < la.loop_len) {
        order[i] = i;
        i        = i + 1;
    }

    var a: u32 = 0;
    for (a < la.loop_len) {
        var best: u32 = a;
        var b:    u32 = a + 1;
        for (b < la.loop_len) {
            if (la.loops[order[b]].depth > la.loops[order[best]].depth) { best = b; }
            b = b + 1;
        }
        val t: u32 = order[a];
        order[a]    = order[best];
        order[best] = t;
        a           = a + 1;
    }
}

fun build_instr_block(la: *LoopAnalysis, fn: *me_ir.Function) err[fail.Fail] {
    val m: u32 = fn.instr_len;
    la.instr_count = m;
    if (m == 0) { ret err[fail.Fail].ok{}; }

    val rr: res[*ir_id.BlockId, A.Error] = A.allocate[ir_id.BlockId](la.alloc, m::usize);
    if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
    la.instr_block = rr.ok;
    me_ir.placement_fill(fn, la.instr_block, nil, m);
    ret err[fail.Fail].ok{};
}

fun build_loops(la: *LoopAnalysis, fn: *me_ir.Function, pred_start: *u32, pred_len: *u32, pred_flat: *ir_id.BlockId) err[fail.Fail] {
    val n: u32 = la.block_count;

    val rl: res[*Loop, A.Error] = A.allocate[Loop](la.alloc, n::usize);
    if (sel rl.err) { ret err[fail.Fail].err{fail.refused(rl.err)}; }
    la.loops    = rl.ok;
    la.loop_cap = n;
    la.loop_len = 0;

    val rm: res[*bool, A.Error] = A.allocate[bool](la.alloc, n::usize);
    if (sel rm.err) { ret err[fail.Fail].err{fail.refused(rm.err)}; }
    val member: *bool = rm.ok;

    val rk: res[*u32, A.Error] = A.allocate[u32](la.alloc, n::usize);
    if (sel rk.err) {
        A.deallocate[bool](la.alloc, member, n::usize);
        ret err[fail.Fail].err{fail.refused(rk.err)};
    }
    val stack: *u32 = rk.ok;

    var h: u32 = 0;
    for (h < n) {
        val base:      u32  = pred_start[h];
        val pc:        u32  = pred_len[h];
        var is_header: bool = false;
        var pi:        u32  = 0;
        for (pi < pc) {
            if (dominance.dominates(la.dom, h::ir_id.BlockId, pred_flat[base + pi])) {
                is_header = true;
                brk;
            }
            pi = pi + 1;
        }
        if (!is_header) {
            h = h + 1;
            cnt;
        }

        collect_body(la, h, member, stack, pred_start, pred_len, pred_flat);

        val rc: err[fail.Fail] = emit_loop(la, fn, h, member, pred_start, pred_len, pred_flat);
        if (sel rc.err) {
            A.deallocate[bool](la.alloc, member, n::usize);
            A.deallocate[u32](la.alloc, stack, n::usize);
            ret rc;
        }
        h = h + 1;
    }

    A.deallocate[bool](la.alloc, member, n::usize);
    A.deallocate[u32](la.alloc, stack, n::usize);
    ret err[fail.Fail].ok{};
}

fun collect_body(la: *LoopAnalysis, h: u32, member: *bool, stack: *u32, pred_start: *u32, pred_len: *u32, pred_flat: *ir_id.BlockId) {
    val n: u32 = la.block_count;
    var i: u32 = 0;
    for (i < n) {
        member[i] = false;
        i         = i + 1;
    }
    member[h] = true;
    var sp: u32 = 0;

    val base: u32 = pred_start[h];
    val pc:   u32 = pred_len[h];
    var pi:   u32 = 0;
    for (pi < pc) {
        val p: u32 = pred_flat[base + pi]::u32;
        if (dominance.dominates(la.dom, h::ir_id.BlockId, p::ir_id.BlockId)) {
            if (member[p] == false) {
                member[p] = true;
                stack[sp] = p;
                sp        = sp + 1;
            }
        }
        pi = pi + 1;
    }

    for (sp > 0) {
        sp = sp - 1;
        val d:  u32 = stack[sp];
        val db: u32 = pred_start[d];
        val dc: u32 = pred_len[d];
        var qi: u32 = 0;
        for (qi < dc) {
            val q: u32 = pred_flat[db + qi]::u32;
            if (member[q] == false) {
                member[q] = true;
                stack[sp] = q;
                sp        = sp + 1;
            }
            qi = qi + 1;
        }
    }
}

fun emit_loop(la: *LoopAnalysis, fn: *me_ir.Function, h: u32, member: *bool, pred_start: *u32, pred_len: *u32, pred_flat: *ir_id.BlockId) err[fail.Fail] {
    val n: u32 = la.block_count;

    var count: u32 = 0;
    var i:     u32 = 0;
    for (i < n) {
        if (member[i]) { count = count + 1; }
        i = i + 1;
    }

    val rb: res[*ir_id.BlockId, A.Error] = A.allocate[ir_id.BlockId](la.alloc, count::usize);
    if (sel rb.err) { ret err[fail.Fail].err{fail.refused(rb.err)}; }
    val body: *ir_id.BlockId = rb.ok;

    var w: u32 = 0;
    i = 0;
    for (i < n) {
        if (member[i]) {
            body[w] = i::ir_id.BlockId;
            w       = w + 1;
        }
        i = i + 1;
    }

    val lp: *Loop = ?la.loops[la.loop_len];
    lp.header     = h::ir_id.BlockId;
    lp.preheader  = ir_id.BLOCK_NIL;
    lp.latch      = ir_id.BLOCK_NIL;
    lp.exiting    = ir_id.BLOCK_NIL;
    lp.exit       = ir_id.BLOCK_NIL;
    lp.body       = body;
    lp.body_len   = count;
    lp.body_cap   = count;
    lp.parent     = NONE_U32;
    lp.depth      = 0;
    lp.has_iv     = false;
    lp.is_counted = false;

    val base:    u32           = pred_start[h];
    val pc:      u32           = pred_len[h];
    var in_cnt:  u32           = 0;
    var out_cnt: u32           = 0;
    var latch:   ir_id.BlockId = ir_id.BLOCK_NIL;
    var pre:     ir_id.BlockId = ir_id.BLOCK_NIL;
    var pi:      u32           = 0;
    for (pi < pc) {
        val p: ir_id.BlockId = pred_flat[base + pi];
        if (member[p::u32]) {
            in_cnt = in_cnt + 1;
            latch  = p;
        }
        or {
            out_cnt = out_cnt + 1;
            pre     = p;
        }
        pi = pi + 1;
    }
    if (in_cnt == 1) { lp.latch = latch; }
    if (out_cnt == 1) {
        var ps0: ir_id.BlockId = ir_id.BLOCK_NIL;
        var ps1: ir_id.BlockId = ir_id.BLOCK_NIL;
        val psn: u32           = me_ir.block_successors(fn, ?fn.blocks[pre::u32], ?ps0, ?ps1);
        if (psn == 1 && ir_id.block_same(ps0, lp.header)) { lp.preheader = pre; }
    }

    fill_exit(la, fn, member, lp, pred_start, pred_len, pred_flat);

    la.loop_len = la.loop_len + 1;
    ret err[fail.Fail].ok{};
}

fun fill_exit(la: *LoopAnalysis, fn: *me_ir.Function, member: *bool, lp: *Loop, pred_start: *u32, pred_len: *u32, pred_flat: *ir_id.BlockId) {
    val n:           u32           = la.block_count;
    var exiting:     ir_id.BlockId = ir_id.BLOCK_NIL;
    var exit:        ir_id.BlockId = ir_id.BLOCK_NIL;
    var exiting_cnt: u32           = 0;
    var exit_multi:  bool          = false;

    var bi: u32 = 0;
    for (bi < lp.body_len) {
        val b:      u32           = lp.body[bi]::u32;
        var s0:     ir_id.BlockId = ir_id.BLOCK_NIL;
        var s1:     ir_id.BlockId = ir_id.BLOCK_NIL;
        val sn:     u32           = me_ir.block_successors(fn, ?fn.blocks[b], ?s0, ?s1);
        var leaves: bool          = false;
        if (sn >= 1 && s0::u32 < n && member[s0::u32] == false) {
            leaves = true;
            if (ir_id.block_is_nil(exit)) { exit = s0; }
            or {
                if (!ir_id.block_same(exit, s0)) { exit_multi = true; }
            }
        }
        if (sn >= 2 && s1::u32 < n && member[s1::u32] == false) {
            leaves = true;
            if (ir_id.block_is_nil(exit)) { exit = s1; }
            or {
                if (!ir_id.block_same(exit, s1)) { exit_multi = true; }
            }
        }
        if (leaves) {
            exiting_cnt = exiting_cnt + 1;
            exiting     = b::ir_id.BlockId;
        }
        bi = bi + 1;
    }

    if (exiting_cnt == 1) { lp.exiting = exiting; }

    if (!exit_multi && !ir_id.block_is_nil(exit)) {
        val ebase:     u32  = pred_start[exit::u32];
        val ec:        u32  = pred_len[exit::u32];
        var dedicated: bool = true;
        var pi:        u32  = 0;
        for (pi < ec) {
            if (member[pred_flat[ebase + pi]::u32] == false) {
                dedicated = false;
                brk;
            }
            pi = pi + 1;
        }
        if (dedicated) { lp.exit = exit; }
    }
}

fun compute_nesting(la: *LoopAnalysis) err[fail.Fail] {
    var i: u32 = 0;
    for (i < la.loop_len) {
        val lp:        *Loop = ?la.loops[i];
        var best:      u32   = NONE_U32;
        var best_size: u32   = 0xFFFFFFFF;
        var j:         u32   = 0;
        for (j < la.loop_len) {
            if (j != i) {
                if (loop_contains(la, j, lp.header)) {
                    if (la.loops[j].body_len < best_size) {
                        best      = j;
                        best_size = la.loops[j].body_len;
                    }
                }
            }
            j = j + 1;
        }
        lp.parent = best;
        i         = i + 1;
    }

    i = 0;
    for (i < la.loop_len) {
        var d:     u32 = 0;
        var p:     u32 = la.loops[i].parent;
        var guard: u32 = 0;
        for (p != NONE_U32) {
            d     = d + 1;
            p     = la.loops[p].parent;
            guard = guard + 1;
            if (guard > la.loop_len) { ret err[fail.Fail].err{fail.message("loops: a loop-nesting parent chain is cyclic")}; }
        }
        la.loops[i].depth = d;
        i                 = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun recognize_counted(la: *LoopAnalysis, fn: *me_ir.Function, loop_ix: u32) bool {
    val lp: *Loop = ?la.loops[loop_ix];
    if (ir_id.block_is_nil(lp.preheader) || ir_id.block_is_nil(lp.latch)) { ret false; }

    val hblk: *me_ir.Block                     = ?fn.blocks[lp.header::u32];
    val topt: opt[*ir_instruction.Instruction] = me_ir.instruction_get(fn, hblk.terminator);
    if (sel topt.none) { ret false; }
    val term: *ir_instruction.Instruction = topt.some;
    if (term.kind != ir_instruction.OP_CBR || term.operand_count < 3) { ret false; }

    val cond: value.Value = term.operands[0];
    if (cond.kind != value.VAL_INSTR) { ret false; }
    val copt: opt[*ir_instruction.Instruction] = me_ir.instruction_get(fn, cond.data.instr);
    if (sel copt.none) { ret false; }
    val cmp: *ir_instruction.Instruction = copt.some;
    if (!is_cmp_lt_le(cmp.kind) || cmp.operand_count != 2) { ret false; }

    val l:          value.Value         = cmp.operands[0];
    val r:          value.Value         = cmp.operands[1];
    var phi_id:     ir_id.InstructionId = ir_id.INSTR_NIL;
    var bound:      value.Value         = l;
    var iv_on_left: bool                = false;
    if (l.kind == value.VAL_INSTR && is_header_phi(fn, hblk, l.data.instr)) {
        phi_id     = l.data.instr;
        bound      = r;
        iv_on_left = true;
    }
    or {
        if (r.kind == value.VAL_INSTR && is_header_phi(fn, hblk, r.data.instr)) {
            phi_id     = r.data.instr;
            bound      = l;
            iv_on_left = false;
        }
        or { ret false; }
    }

    if (!is_invariant(la, loop_ix, bound)) { ret false; }

    val then_b:  ir_id.BlockId = me_ir.block_target(term.operands[1]);
    val else_b:  ir_id.BlockId = me_ir.block_target(term.operands[2]);
    val then_in: bool          = loop_contains(la, loop_ix, then_b);
    val else_in: bool          = loop_contains(la, loop_ix, else_b);
    if (then_in == else_in) { ret false; }

    if (!ir_id.block_same(lp.exiting, lp.header)) { ret false; }

    var init: value.Value;
    var step: value.Value;
    var upd:  ir_id.InstructionId = ir_id.INSTR_NIL;
    if (!analyze_phi_iv(la, fn, loop_ix, phi_id, ?init, ?step, ?upd)) { ret false; }

    if (step.kind != value.VAL_CONST_INT) { ret false; }
    # the step's sign is read at the iv's width; the trip-count arithmetic
    # downstream is 64-bit, so a wider iv is not counted
    val bits: u32 = iv_bits(la, step.ty);
    if (bits == 0 || bits > 64) { ret false; }
    val s: wide.Wide = wide.sext(value.int_of(?step), bits);
    if (wide.is_zero(s)) { ret false; }
    val want_pos: bool = (iv_on_left == then_in);
    if (want_pos && wide.is_negative(s))   { ret false; }
    if (!want_pos && !wide.is_negative(s)) { ret false; }

    lp.has_iv                   = true;
    lp.iv.phi                   = phi_id;
    lp.iv.init                  = init;
    lp.iv.step                  = step;
    lp.iv.update                = upd;
    lp.is_counted               = true;
    lp.counted.bound            = bound;
    lp.counted.bound_inclusive  = (cmp.kind == ir_instruction.OP_CMP_LE_S || cmp.kind == ir_instruction.OP_CMP_LE_U);
    lp.counted.pred             = cmp.kind;
    lp.counted.cmp              = cond.data.instr;
    lp.counted.iv_on_left       = iv_on_left;
    lp.counted.continue_on_true = then_in;
    ret true;
}

fun recognize_iv(la: *LoopAnalysis, fn: *me_ir.Function, loop_ix: u32) {
    val lp: *Loop = ?la.loops[loop_ix];
    if (ir_id.block_is_nil(lp.preheader) || ir_id.block_is_nil(lp.latch)) { ret; }
    val hblk: *me_ir.Block = ?fn.blocks[lp.header::u32];
    var pj:   u32          = 0;
    for (pj < hblk.phi_count) {
        val phi_id: ir_id.InstructionId = hblk.phis[pj];
        var init:   value.Value;
        var step:   value.Value;
        var upd:    ir_id.InstructionId = ir_id.INSTR_NIL;
        if (analyze_phi_iv(la, fn, loop_ix, phi_id, ?init, ?step, ?upd)) {
            lp.has_iv    = true;
            lp.iv.phi    = phi_id;
            lp.iv.init   = init;
            lp.iv.step   = step;
            lp.iv.update = upd;
            ret;
        }
        pj = pj + 1;
    }
}

fun analyze_phi_iv(la: *LoopAnalysis, fn: *me_ir.Function, loop_ix: u32, phi_id: ir_id.InstructionId, out_init: *value.Value, out_step: *value.Value, out_update: *ir_id.InstructionId) bool {
    val lp: *Loop = ?la.loops[loop_ix];
    if (ir_id.block_is_nil(lp.preheader) || ir_id.block_is_nil(lp.latch)) { ret false; }

    val popt: opt[*ir_instruction.Instruction] = me_ir.instruction_get(fn, phi_id);
    if (sel popt.none) { ret false; }
    val phi: *ir_instruction.Instruction = popt.some;
    if (phi.kind != ir_instruction.OP_PHI || phi.operand_count != 4) { ret false; }

    var init:     value.Value;
    var upd:      value.Value;
    var got_init: bool = false;
    var got_upd:  bool = false;
    var j:        u32  = 0;
    for (j < 2) {
        val btgt: ir_id.BlockId = me_ir.block_target(phi.operands[2 * j]);
        val vv:   value.Value   = phi.operands[2 * j + 1];
        if (ir_id.block_same(btgt, lp.preheader)) {
            init     = vv;
            got_init = true;
        }
        if (ir_id.block_same(btgt, lp.latch)) {
            upd     = vv;
            got_upd = true;
        }
        j = j + 1;
    }
    if (!got_init || !got_upd)       { ret false; }
    if (upd.kind != value.VAL_INSTR) { ret false; }

    val uopt: opt[*ir_instruction.Instruction] = me_ir.instruction_get(fn, upd.data.instr);
    if (sel uopt.none) { ret false; }
    val u: *ir_instruction.Instruction = uopt.some;
    if (u.kind != ir_instruction.OP_ADD || u.operand_count != 2) { ret false; }

    val a:    value.Value = u.operands[0];
    val b:    value.Value = u.operands[1];
    var step: value.Value = b;
    if (a.kind == value.VAL_INSTR && ir_id.instruction_same(a.data.instr, phi_id)) {
        step = b;
    }
    or {
        if (b.kind == value.VAL_INSTR && ir_id.instruction_same(b.data.instr, phi_id)) {
            step = a;
        }
        or { ret false; }
    }
    if (!is_invariant(la, loop_ix, step)) { ret false; }

    @out_init   = init;
    @out_step   = step;
    @out_update = upd.data.instr;
    ret true;
}

fun is_header_phi(fn: *me_ir.Function, blk: *me_ir.Block, iid: ir_id.InstructionId) bool {
    var pj: u32 = 0;
    for (pj < blk.phi_count) {
        if (ir_id.instruction_same(blk.phis[pj], iid)) { ret true; }
        pj = pj + 1;
    }
    ret false;
}

fun is_cmp_lt_le(k: ir_instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_CMP_ORDERED);
}

fun iv_bits(la: *LoopAnalysis, tid: ir_type.IrTypeId) u32 {
    val found: opt[*ir_type.IrType] = ir_type.get(la.types, tid);
    if (sel found.none)                     { ret 0; }
    if (found.some.kind != ir_type.IRT_INT) { ret 0; }
    ret found.some.data.bits;
}

#[testing]
use mach.lang.me.ir.builder;

test analyze__counted_loop_structure {
    var f:    builder.Function;
    val made: err[fail.Fail] = builder.function_init(?f);
    if (sel made.err) { ret 1; }
    fin { builder.function_dnit(?f); }
    val i64t: ir_type.IrTypeId = f.i64t;
    val fn:   *me_ir.Function  = f.fn;

    var shape:   builder.CountedLoop;
    val made_lp: res[builder.CountedLoop, fail.Fail] = builder.counted_loop_add(?f.bld, i64t);
    if (sel made_lp.err) { ret 1; }
    shape = made_lp.ok;
    val closed: err[fail.Fail] = builder.counted_loop_close(?f.bld, ?shape, i64t);
    if (sel closed.err) { ret 1; }
    val entry:  ir_id.BlockId = shape.entry;
    val header: ir_id.BlockId = shape.header;
    val body:   ir_id.BlockId = shape.body;
    val exit:   ir_id.BlockId = shape.exit;
    val phi:    value.Value   = shape.iv;

    var code: i32                          = 0;
    val ra:   res[LoopAnalysis, fail.Fail] = analyze(fn, ?f.m.types, ?f.alloc);
    if (sel ra.err) { ret 1; }
    var la: LoopAnalysis = ra.ok;

    if (la.loop_len != 1) { code = 1; }
    or {
        val lp: *Loop = ?la.loops[0];
        if (!ir_id.block_same(lp.header, header))               { code = 1; }
        if (!ir_id.block_same(lp.preheader, entry))             { code = 1; }
        if (!ir_id.block_same(lp.latch, body))                  { code = 1; }
        if (!ir_id.block_same(lp.exit, exit))                   { code = 1; }
        if (!ir_id.block_same(lp.exiting, header))              { code = 1; }
        if (lp.depth != 0)                                      { code = 1; }
        if (!lp.is_counted)                                     { code = 1; }
        if (!lp.has_iv)                                         { code = 1; }
        if (!ir_id.instruction_same(lp.iv.phi, phi.data.instr)) { code = 1; }
        if (lp.iv.step.kind != value.VAL_CONST_INT)             { code = 1; }
        if (lp.iv.step.data.int_lit != 1)                       { code = 1; }
        if (lp.counted.pred != ir_instruction.OP_CMP_LT_S)      { code = 1; }
        if (!lp.counted.iv_on_left)                             { code = 1; }
        if (!lp.counted.continue_on_true)                       { code = 1; }
        if (lp.counted.bound.kind != value.VAL_PARAM)           { code = 1; }
    }

    if (!dominance.dominates(la.dom, header, body))   { code = 1; }
    if (!dominance.dominates(la.dom, entry, exit))    { code = 1; }
    if (dominance.dominates(la.dom, body, header))    { code = 1; }
    if (!dominance.dominates(la.dom, header, header)) { code = 1; }

    dnit(?la);
    ret code;
}

test analyze__selects_the_counter_over_a_reduction {
    var f:    builder.Function;
    val made: err[fail.Fail] = builder.function_init(?f);
    if (sel made.err) { ret 1; }
    fin { builder.function_dnit(?f); }
    val i64t: ir_type.IrTypeId = f.i64t;
    val fn:   *me_ir.Function  = f.fn;

    val re: res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel re.err) { ret 1; }
    val entry: ir_id.BlockId                 = re.ok;
    val rh:    res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rh.err) { ret 1; }
    val header: ir_id.BlockId                 = rh.ok;
    val rbo:    res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rbo.err) { ret 1; }
    val body: ir_id.BlockId                 = rbo.ok;
    val rx:   res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rx.err) { ret 1; }
    val exit: ir_id.BlockId = rx.ok;

    val n:    value.Value = value.param(0, i64t);
    val zero: value.Value = value.const_int(0, i64t);
    val one:  value.Value = value.const_int(1, i64t);

    builder.set_block(?f.bld, entry);
    val r_969: err[fail.Fail] = builder.emit_br(?f.bld, header);
    if (sel r_969.err) { ret 1; }

    builder.set_block(?f.bld, header);
    val racc: res[value.Value, fail.Fail] = builder.emit_phi(?f.bld, i64t);
    if (sel racc.err) { ret 1; }
    val acc: value.Value                 = racc.ok;
    val riv: res[value.Value, fail.Fail] = builder.emit_phi(?f.bld, i64t);
    if (sel riv.err) { ret 1; }
    val iv:   value.Value                 = riv.ok;
    val rcmp: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?f.bld, iv, n);
    if (sel rcmp.err) { ret 1; }
    val r_980: err[fail.Fail] = builder.emit_cbr(?f.bld, rcmp.ok, body, exit);
    if (sel r_980.err) { ret 1; }

    builder.set_block(?f.bld, body);
    val rprod: res[value.Value, fail.Fail] = builder.emit_mul(?f.bld, iv, iv);
    if (sel rprod.err) { ret 1; }
    val prod: value.Value                 = rprod.ok;
    val racu: res[value.Value, fail.Fail] = builder.emit_add(?f.bld, acc, prod);
    if (sel racu.err) { ret 1; }
    val acc_upd: value.Value                 = racu.ok;
    val rivu:    res[value.Value, fail.Fail] = builder.emit_add(?f.bld, iv, one);
    if (sel rivu.err) { ret 1; }
    val iv_upd: value.Value    = rivu.ok;
    val r_992:  err[fail.Fail] = builder.emit_br(?f.bld, header);
    if (sel r_992.err) { ret 1; }

    builder.set_block(?f.bld, exit);
    val r_995: err[fail.Fail] = builder.emit_ret_void(?f.bld);
    if (sel r_995.err) { ret 1; }

    val r_997: err[fail.Fail] = builder.phi_add_incoming(?f.bld, acc, entry, zero);
    if (sel r_997.err) { ret 1; }
    val r_998: err[fail.Fail] = builder.phi_add_incoming(?f.bld, acc, body, acc_upd);
    if (sel r_998.err) { ret 1; }
    val r_999: err[fail.Fail] = builder.phi_add_incoming(?f.bld, iv, entry, zero);
    if (sel r_999.err) { ret 1; }
    val r_1000: err[fail.Fail] = builder.phi_add_incoming(?f.bld, iv, body, iv_upd);
    if (sel r_1000.err) { ret 1; }

    var code: i32                          = 0;
    val ra:   res[LoopAnalysis, fail.Fail] = analyze(fn, ?f.m.types, ?f.alloc);
    if (sel ra.err) { ret 1; }
    var la: LoopAnalysis = ra.ok;

    if (la.loop_len != 1) { code = 1; }
    or {
        val lp: *Loop = ?la.loops[0];
        if (!lp.is_counted)                                    { code = 1; }
        if (!lp.has_iv)                                        { code = 1; }
        if (!ir_id.instruction_same(lp.iv.phi, iv.data.instr)) { code = 1; }
        if (ir_id.instruction_same(lp.iv.phi, acc.data.instr)) { code = 1; }
        if (lp.iv.step.data.int_lit != 1)                      { code = 1; }
        if (lp.counted.bound.kind != value.VAL_PARAM)          { code = 1; }
    }

    dnit(?la);
    ret code;
}

test analyze__declines_a_multi_latch_loop {
    var f:    builder.Function;
    val made: err[fail.Fail] = builder.function_init(?f);
    if (sel made.err) { ret 1; }
    fin { builder.function_dnit(?f); }
    val i64t: ir_type.IrTypeId = f.i64t;
    val fn:   *me_ir.Function  = f.fn;

    val re: res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel re.err) { ret 1; }
    val entry: ir_id.BlockId                 = re.ok;
    val rh:    res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rh.err) { ret 1; }
    val header: ir_id.BlockId                 = rh.ok;
    val rb1:    res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rb1.err) { ret 1; }
    val body1: ir_id.BlockId                 = rb1.ok;
    val rb2:   res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rb2.err) { ret 1; }
    val body2: ir_id.BlockId                 = rb2.ok;
    val rx:    res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rx.err) { ret 1; }
    val exit: ir_id.BlockId = rx.ok;

    val n: value.Value = value.param(0, i64t);

    builder.set_block(?f.bld, entry);
    val r_1060: err[fail.Fail] = builder.emit_br(?f.bld, header);
    if (sel r_1060.err) { ret 1; }

    builder.set_block(?f.bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(?f.bld, i64t);
    if (sel rphi.err) { ret 1; }
    val phi: value.Value                 = rphi.ok;
    val rc1: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?f.bld, phi, n);
    if (sel rc1.err) { ret 1; }
    val r_1068: err[fail.Fail] = builder.emit_cbr(?f.bld, rc1.ok, body1, exit);
    if (sel r_1068.err) { ret 1; }

    builder.set_block(?f.bld, body1);
    val rc2: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?f.bld, phi, n);
    if (sel rc2.err) { ret 1; }
    val r_1073: err[fail.Fail] = builder.emit_cbr(?f.bld, rc2.ok, header, body2);
    if (sel r_1073.err) { ret 1; }

    builder.set_block(?f.bld, body2);
    val r_1076: err[fail.Fail] = builder.emit_br(?f.bld, header);
    if (sel r_1076.err) { ret 1; }

    builder.set_block(?f.bld, exit);
    val r_1079: err[fail.Fail] = builder.emit_ret_void(?f.bld);
    if (sel r_1079.err) { ret 1; }

    val r_1081: err[fail.Fail] = builder.phi_add_incoming(?f.bld, phi, entry, value.const_int(0, i64t));
    if (sel r_1081.err) { ret 1; }
    val r_1082: err[fail.Fail] = builder.phi_add_incoming(?f.bld, phi, body1, value.const_int(1, i64t));
    if (sel r_1082.err) { ret 1; }
    val r_1083: err[fail.Fail] = builder.phi_add_incoming(?f.bld, phi, body2, value.const_int(2, i64t));
    if (sel r_1083.err) { ret 1; }

    var code: i32                          = 0;
    val ra:   res[LoopAnalysis, fail.Fail] = analyze(fn, ?f.m.types, ?f.alloc);
    if (sel ra.err) { ret 1; }
    var la: LoopAnalysis = ra.ok;

    if (la.loop_len != 1) { code = 1; }
    or {
        val lp: *Loop = ?la.loops[0];
        if (!ir_id.block_same(lp.header, header))   { code = 1; }
        if (!ir_id.block_is_nil(lp.latch))          { code = 1; }
        if (!ir_id.block_same(lp.preheader, entry)) { code = 1; }
        if (lp.is_counted)                          { code = 1; }
        if (lp.has_iv)                              { code = 1; }
        if (lp.body_len != 3)                       { code = 1; }
        if (!loop_contains(?la, 0, header))         { code = 1; }
        if (!loop_contains(?la, 0, body1))          { code = 1; }
        if (!loop_contains(?la, 0, body2))          { code = 1; }
    }

    dnit(?la);
    ret code;
}

test analyze__nested_depth_and_parent {
    var f:    builder.Function;
    val made: err[fail.Fail] = builder.function_init(?f);
    if (sel made.err) { ret 1; }
    fin { builder.function_dnit(?f); }
    val i64t: ir_type.IrTypeId = f.i64t;
    val fn:   *me_ir.Function  = f.fn;

    val re: res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel re.err) { ret 1; }
    val entry: ir_id.BlockId                 = re.ok;
    val roh:   res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel roh.err) { ret 1; }
    val outer_h: ir_id.BlockId                 = roh.ok;
    val rip:     res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rip.err) { ret 1; }
    val inner_pre: ir_id.BlockId                 = rip.ok;
    val rih:       res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rih.err) { ret 1; }
    val inner_h: ir_id.BlockId                 = rih.ok;
    val rib:     res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rib.err) { ret 1; }
    val inner_body: ir_id.BlockId                 = rib.ok;
    val rol:        res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rol.err) { ret 1; }
    val outer_latch: ir_id.BlockId                 = rol.ok;
    val rx:          res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rx.err) { ret 1; }
    val exit: ir_id.BlockId = rx.ok;

    val n:    value.Value = value.param(0, i64t);
    val zero: value.Value = value.const_int(0, i64t);
    val one:  value.Value = value.const_int(1, i64t);

    builder.set_block(?f.bld, entry);
    val r_1154: err[fail.Fail] = builder.emit_br(?f.bld, outer_h);
    if (sel r_1154.err) { ret 1; }

    builder.set_block(?f.bld, outer_h);
    val rpo: res[value.Value, fail.Fail] = builder.emit_phi(?f.bld, i64t);
    if (sel rpo.err) { ret 1; }
    val phi_o: value.Value                 = rpo.ok;
    val rco:   res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?f.bld, phi_o, n);
    if (sel rco.err) { ret 1; }
    val r_1162: err[fail.Fail] = builder.emit_cbr(?f.bld, rco.ok, inner_pre, exit);
    if (sel r_1162.err) { ret 1; }

    builder.set_block(?f.bld, inner_pre);
    val r_1165: err[fail.Fail] = builder.emit_br(?f.bld, inner_h);
    if (sel r_1165.err) { ret 1; }

    builder.set_block(?f.bld, inner_h);
    val rpi: res[value.Value, fail.Fail] = builder.emit_phi(?f.bld, i64t);
    if (sel rpi.err) { ret 1; }
    val phi_i: value.Value                 = rpi.ok;
    val rci:   res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?f.bld, phi_i, n);
    if (sel rci.err) { ret 1; }
    val r_1173: err[fail.Fail] = builder.emit_cbr(?f.bld, rci.ok, inner_body, outer_latch);
    if (sel r_1173.err) { ret 1; }

    builder.set_block(?f.bld, inner_body);
    val riu: res[value.Value, fail.Fail] = builder.emit_add(?f.bld, phi_i, one);
    if (sel riu.err) { ret 1; }
    val iv_i_upd: value.Value    = riu.ok;
    val r_1179:   err[fail.Fail] = builder.emit_br(?f.bld, inner_h);
    if (sel r_1179.err) { ret 1; }

    builder.set_block(?f.bld, outer_latch);
    val rou: res[value.Value, fail.Fail] = builder.emit_add(?f.bld, phi_o, one);
    if (sel rou.err) { ret 1; }
    val iv_o_upd: value.Value    = rou.ok;
    val r_1185:   err[fail.Fail] = builder.emit_br(?f.bld, outer_h);
    if (sel r_1185.err) { ret 1; }

    builder.set_block(?f.bld, exit);
    val r_1188: err[fail.Fail] = builder.emit_ret_void(?f.bld);
    if (sel r_1188.err) { ret 1; }

    val r_1190: err[fail.Fail] = builder.phi_add_incoming(?f.bld, phi_o, entry, zero);
    if (sel r_1190.err) { ret 1; }
    val r_1191: err[fail.Fail] = builder.phi_add_incoming(?f.bld, phi_o, outer_latch, iv_o_upd);
    if (sel r_1191.err) { ret 1; }
    val r_1192: err[fail.Fail] = builder.phi_add_incoming(?f.bld, phi_i, inner_pre, zero);
    if (sel r_1192.err) { ret 1; }
    val r_1193: err[fail.Fail] = builder.phi_add_incoming(?f.bld, phi_i, inner_body, iv_i_upd);
    if (sel r_1193.err) { ret 1; }

    var code: i32                          = 0;
    val ra:   res[LoopAnalysis, fail.Fail] = analyze(fn, ?f.m.types, ?f.alloc);
    if (sel ra.err) { ret 1; }
    var la: LoopAnalysis = ra.ok;

    if (la.loop_len != 2) { code = 1; }
    or {
        var inner_ix: u32 = NONE_U32;
        var outer_ix: u32 = NONE_U32;
        var i:        u32 = 0;
        for (i < la.loop_len) {
            if (la.loops[i].body_len == 2) { inner_ix = i; }
            if (la.loops[i].body_len == 5) { outer_ix = i; }
            i = i + 1;
        }
        if (inner_ix == NONE_U32 || outer_ix == NONE_U32) { code = 1; }
        or {
            val inner: *Loop = ?la.loops[inner_ix];
            val outer: *Loop = ?la.loops[outer_ix];
            if (!ir_id.block_same(inner.header, inner_h))      { code = 1; }
            if (!ir_id.block_same(outer.header, outer_h))      { code = 1; }
            if (inner.parent != outer_ix)                      { code = 1; }
            if (outer.parent != NONE_U32)                      { code = 1; }
            if (inner.depth != 1)                              { code = 1; }
            if (outer.depth != 0)                              { code = 1; }
            if (!inner.is_counted)                             { code = 1; }
            if (!outer.is_counted)                             { code = 1; }
            if (!ir_id.block_same(inner.preheader, inner_pre)) { code = 1; }
            if (!ir_id.block_same(outer.preheader, entry))     { code = 1; }
            if (!ir_id.block_same(inner.latch, inner_body))    { code = 1; }
            if (!ir_id.block_same(outer.latch, outer_latch))   { code = 1; }
            if (!loop_contains(?la, outer_ix, inner_h))        { code = 1; }
        }
    }

    dnit(?la);
    ret code;
}

test analyze__an_early_exit_is_not_counted {
    var f:    builder.Function;
    val made: err[fail.Fail] = builder.function_init(?f);
    if (sel made.err) { ret 1; }
    fin { builder.function_dnit(?f); }
    val i64t: ir_type.IrTypeId = f.i64t;
    val fn:   *me_ir.Function  = f.fn;

    val re: res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel re.err) { ret 1; }
    val entry: ir_id.BlockId                 = re.ok;
    val rh:    res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rh.err) { ret 1; }
    val header: ir_id.BlockId                 = rh.ok;
    val rbo:    res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rbo.err) { ret 1; }
    val body: ir_id.BlockId                 = rbo.ok;
    val rla:  res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rla.err) { ret 1; }
    val latch: ir_id.BlockId                 = rla.ok;
    val rfo:   res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rfo.err) { ret 1; }
    val found: ir_id.BlockId                 = rfo.ok;
    val rx:    res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rx.err) { ret 1; }
    val exit: ir_id.BlockId = rx.ok;

    val n:    value.Value = value.param(0, i64t);
    val zero: value.Value = value.const_int(0, i64t);
    val one:  value.Value = value.const_int(1, i64t);
    val five: value.Value = value.const_int(5, i64t);

    builder.set_block(?f.bld, entry);
    val r_1275: err[fail.Fail] = builder.emit_br(?f.bld, header);
    if (sel r_1275.err) { ret 1; }
    builder.set_block(?f.bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(?f.bld, i64t);
    if (sel rphi.err) { ret 1; }
    val phi: value.Value                 = rphi.ok;
    val rc1: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?f.bld, phi, n);
    if (sel rc1.err) { ret 1; }
    val r_1282: err[fail.Fail] = builder.emit_cbr(?f.bld, rc1.ok, body, exit);
    if (sel r_1282.err) { ret 1; }
    builder.set_block(?f.bld, body);
    val rc2: res[value.Value, fail.Fail] = builder.emit_cmp_eq(?f.bld, phi, five);
    if (sel rc2.err) { ret 1; }
    val r_1286: err[fail.Fail] = builder.emit_cbr(?f.bld, rc2.ok, found, latch);
    if (sel r_1286.err) { ret 1; }
    builder.set_block(?f.bld, latch);
    val rupd: res[value.Value, fail.Fail] = builder.emit_add(?f.bld, phi, one);
    if (sel rupd.err) { ret 1; }
    val upd:    value.Value    = rupd.ok;
    val r_1291: err[fail.Fail] = builder.emit_br(?f.bld, header);
    if (sel r_1291.err) { ret 1; }
    builder.set_block(?f.bld, found);
    val r_1293: err[fail.Fail] = builder.emit_br(?f.bld, exit);
    if (sel r_1293.err) { ret 1; }
    builder.set_block(?f.bld, exit);
    val r_1295: err[fail.Fail] = builder.emit_ret_void(?f.bld);
    if (sel r_1295.err) { ret 1; }
    val r_1296: err[fail.Fail] = builder.phi_add_incoming(?f.bld, phi, entry, zero);
    if (sel r_1296.err) { ret 1; }
    val r_1297: err[fail.Fail] = builder.phi_add_incoming(?f.bld, phi, latch, upd);
    if (sel r_1297.err) { ret 1; }

    var code: i32                          = 0;
    val ra:   res[LoopAnalysis, fail.Fail] = analyze(fn, ?f.m.types, ?f.alloc);
    if (sel ra.err) { ret 1; }
    var la: LoopAnalysis = ra.ok;
    if (la.loop_len != 1) { code = 1; }
    or {
        val lp: *Loop = ?la.loops[0];
        if (lp.is_counted)                   { code = 1; }
        if (!ir_id.block_is_nil(lp.exiting)) { code = 1; }
    }
    dnit(?la);
    ret code;
}

test analyze__guard_leaves_the_preheader_nil {
    var f:    builder.Function;
    val made: err[fail.Fail] = builder.function_init(?f);
    if (sel made.err) { ret 1; }
    fin { builder.function_dnit(?f); }
    val i64t: ir_type.IrTypeId = f.i64t;
    val fn:   *me_ir.Function  = f.fn;

    val re: res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel re.err) { ret 1; }
    val entry: ir_id.BlockId                 = re.ok;
    val rh:    res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rh.err) { ret 1; }
    val header: ir_id.BlockId                 = rh.ok;
    val rla:    res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rla.err) { ret 1; }
    val latch: ir_id.BlockId                 = rla.ok;
    val raf:   res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel raf.err) { ret 1; }
    val after: ir_id.BlockId = raf.ok;

    val n:    value.Value = value.param(0, i64t);
    val zero: value.Value = value.const_int(0, i64t);
    val one:  value.Value = value.const_int(1, i64t);

    builder.set_block(?f.bld, entry);
    val rcg: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?f.bld, zero, n);
    if (sel rcg.err) { ret 1; }
    val r_1349: err[fail.Fail] = builder.emit_cbr(?f.bld, rcg.ok, header, after);
    if (sel r_1349.err) { ret 1; }
    builder.set_block(?f.bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(?f.bld, i64t);
    if (sel rphi.err) { ret 1; }
    val phi: value.Value                 = rphi.ok;
    val rc1: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?f.bld, phi, n);
    if (sel rc1.err) { ret 1; }
    val r_1356: err[fail.Fail] = builder.emit_cbr(?f.bld, rc1.ok, latch, after);
    if (sel r_1356.err) { ret 1; }
    builder.set_block(?f.bld, latch);
    val rupd: res[value.Value, fail.Fail] = builder.emit_add(?f.bld, phi, one);
    if (sel rupd.err) { ret 1; }
    val upd:    value.Value    = rupd.ok;
    val r_1361: err[fail.Fail] = builder.emit_br(?f.bld, header);
    if (sel r_1361.err) { ret 1; }
    builder.set_block(?f.bld, after);
    val r_1363: err[fail.Fail] = builder.emit_ret_void(?f.bld);
    if (sel r_1363.err) { ret 1; }
    val r_1364: err[fail.Fail] = builder.phi_add_incoming(?f.bld, phi, entry, zero);
    if (sel r_1364.err) { ret 1; }
    val r_1365: err[fail.Fail] = builder.phi_add_incoming(?f.bld, phi, latch, upd);
    if (sel r_1365.err) { ret 1; }

    var code: i32                          = 0;
    val ra:   res[LoopAnalysis, fail.Fail] = analyze(fn, ?f.m.types, ?f.alloc);
    if (sel ra.err) { ret 1; }
    var la: LoopAnalysis = ra.ok;
    if (la.loop_len != 1) { code = 1; }
    or {
        val lp: *Loop = ?la.loops[0];
        if (!ir_id.block_is_nil(lp.preheader))  { code = 1; }
        if (!ir_id.block_same(lp.latch, latch)) { code = 1; }
        if (lp.is_counted)                      { code = 1; }
    }
    dnit(?la);
    ret code;
}

test analyze__a_param_step_is_not_counted {
    var f:    builder.Function;
    val made: err[fail.Fail] = builder.function_init(?f);
    if (sel made.err) { ret 1; }
    fin { builder.function_dnit(?f); }
    val i64t: ir_type.IrTypeId = f.i64t;
    val fn:   *me_ir.Function  = f.fn;

    val re: res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel re.err) { ret 1; }
    val entry: ir_id.BlockId                 = re.ok;
    val rh:    res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rh.err) { ret 1; }
    val header: ir_id.BlockId                 = rh.ok;
    val rbo:    res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rbo.err) { ret 1; }
    val body: ir_id.BlockId                 = rbo.ok;
    val rx:   res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
