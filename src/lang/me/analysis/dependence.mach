    val rgd: res[value.Value, fail.Fail] = body_gep(?bld, a, iv, i64t);
    if (sel rgd.err) { ir.dnit(?m); ret 1; }
    val r_613: err[fail.Fail] = builder.emit_store(?bld, rl.ok, rgd.ok);
    if (sel r_613.err) { ir.dnit(?m); ret 1; }
    val ru: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) { ir.dnit(?m); ret 1; }
    val r_616: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, ru.ok);
    if (sel r_616.err) { ir.dnit(?m); ret 1; }
    val r_617: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_617.err) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?alloc);
    if (sel ral.err) { ir.dnit(?m); ret 1; }
    var la: loops.LoopAnalysis = ral.ok;
    val rd: res[DepInfo, fail.Fail] = analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) { loops.dnit(?la); ir.dnit(?m); ret 1; }
    var di: DepInfo = rd.ok;
    if (di.verdict != DEP_DEPENDENT) { code = 1; }
    dep_dnit(?di);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

fun float_reduction_verdict(op: instruction.InstrKind, float_reassoc: bool, want_ok: bool) i32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rft: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_float(?m.types, 64);
    if (sel rft.err) { ir.dnit(?m); ret 1; }
    val f64t: ir_type.IrTypeId = rft.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId; var iv: value.Value;
    if (mk_skeleton(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, header);
    val racc: res[value.Value, fail.Fail] = builder.emit_phi(?bld, f64t);
    if (sel racc.err) { ir.dnit(?m); ret 1; }
    val acc: value.Value = racc.ok;

    val a: value.Value = value.param(1, ptrt);
    builder.set_block(?bld, body);
    var ix: [1]value.Value;
    ix[0] = iv;
    val rg: res[value.Value, fail.Fail] = builder.emit_gep(?bld, a, f64t, ?ix[0], 1);
    if (sel rg.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?bld, rg.ok, f64t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    val ld: value.Value = rl.ok;
    var racu: res[value.Value, fail.Fail];
    if (op == instruction.OP_MUL)      { racu = builder.emit_mul(?bld, acc, ld); }
    or (op == instruction.OP_SUB)      { racu = builder.emit_sub(?bld, acc, ld); }
    or                                 { racu = builder.emit_add(?bld, acc, ld); }
    if (sel racu.err) { ir.dnit(?m); ret 1; }
    val acc_upd: value.Value = racu.ok;
    val ru: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) { ir.dnit(?m); ret 1; }
    val r_679: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, ru.ok);
    if (sel r_679.err) { ir.dnit(?m); ret 1; }
    val r_680: err[fail.Fail] = builder.phi_add_incoming(?bld, acc, entry, value.const_float(0.0, f64t));
    if (sel r_680.err) { ir.dnit(?m); ret 1; }
    val r_681: err[fail.Fail] = builder.phi_add_incoming(?bld, acc, body, acc_upd);
    if (sel r_681.err) { ir.dnit(?m); ret 1; }
    val r_682: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_682.err) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?alloc);
    if (sel ral.err) { ir.dnit(?m); ret 1; }
    var la: loops.LoopAnalysis = ral.ok;
    val rr: res[ReductionInfo, fail.Fail] = analyze_reduction(fn, ?la, 0, ?m.types, ?alloc, float_reassoc);
    if (sel rr.err) { loops.dnit(?la); ir.dnit(?m); ret 1; }
    var ri: ReductionInfo = rr.ok;
    if (ri.ok != want_ok) { code = 1; }
    if (ri.ok) {
        if (ri.op != op)      { code = 1; }
        if (!ri.is_float)     { code = 1; }
        if (ri.bytes != 8)    { code = 1; }
        if (ri.lanes != 2)    { code = 1; }
        if (ri.elem_ty != f64t) { code = 1; }
    }
    reduction_dnit(?ri);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.analysis.dependence:float_reduction_gated" {
    var code: i32 = 0;
    if (float_reduction_verdict(instruction.OP_ADD, false, false) != 0) { code = 1; }
    if (float_reduction_verdict(instruction.OP_MUL, false, false) != 0) { code = 1; }
    if (float_reduction_verdict(instruction.OP_ADD, true,  true)  != 0) { code = 1; }
    if (float_reduction_verdict(instruction.OP_MUL, true,  true)  != 0) { code = 1; }
    if (float_reduction_verdict(instruction.OP_SUB, true,  false) != 0) { code = 1; }
    if (float_reduction_verdict(instruction.OP_SUB, false, false) != 0) { code = 1; }
    ret code;
}

test "mach.lang.me.analysis.dependence:reduction_dependent" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId; var iv: value.Value;
    if (mk_skeleton(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, header);
    val racc: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel racc.err) { ir.dnit(?m); ret 1; }
    val acc: value.Value = racc.ok;

    val a: value.Value = value.param(1, ptrt);
    builder.set_block(?bld, body);
    val rg: res[value.Value, fail.Fail] = body_gep(?bld, a, iv, i64t);
    if (sel rg.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?bld, rg.ok, i64t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    val racu: res[value.Value, fail.Fail] = builder.emit_add(?bld, acc, rl.ok);
    if (sel racu.err) { ir.dnit(?m); ret 1; }
    val acc_upd: value.Value = racu.ok;
    val ru: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) { ir.dnit(?m); ret 1; }
    val r_753: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, ru.ok);
    if (sel r_753.err) { ir.dnit(?m); ret 1; }
    val r_754: err[fail.Fail] = builder.phi_add_incoming(?bld, acc, entry, value.const_int(0, i64t));
    if (sel r_754.err) { ir.dnit(?m); ret 1; }
    val r_755: err[fail.Fail] = builder.phi_add_incoming(?bld, acc, body, acc_upd);
    if (sel r_755.err) { ir.dnit(?m); ret 1; }
    val r_756: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_756.err) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?alloc);
    if (sel ral.err) { ir.dnit(?m); ret 1; }
    var la: loops.LoopAnalysis = ral.ok;
    val rd: res[DepInfo, fail.Fail] = analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) { loops.dnit(?la); ir.dnit(?m); ret 1; }
    var di: DepInfo = rd.ok;
    if (di.verdict != DEP_DEPENDENT) { code = 1; }
    dep_dnit(?di);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

