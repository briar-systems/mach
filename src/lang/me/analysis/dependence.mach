    val rg: res[value.Value, fail.Fail] = builder.emit_gep(?bld, a, i8t, ?ix[0], 1);
    if (sel rg.err) { ir.dnit(?m); ret 1; }
    val r_854: err[fail.Fail] = builder.emit_store(?bld, value.const_int(0, i64t), rg.ok);
    if (sel r_854.err) { ir.dnit(?m); ret 1; }
    val ru: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) { ir.dnit(?m); ret 1; }
    val r_857: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, ru.ok);
    if (sel r_857.err) { ir.dnit(?m); ret 1; }
    val r_858: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_858.err) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?alloc);
    if (sel ral.err) { ir.dnit(?m); ret 1; }
    var la: loops.LoopAnalysis = ral.ok;
    val rd: res[DepInfo, fail.Fail] = analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) { loops.dnit(?la); ir.dnit(?m); ret 1; }
    var di: DepInfo = rd.ok;
    if (di.verdict != DEP_DEPENDENT) { code = 1; }
    dep_dnit(?di);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

pub rec ReductionInfo {
    ok:           bool;
    op:           instruction.InstrKind;
    acc_phi:      id.InstructionId;
    acc_update:   id.InstructionId;
    acc_init:     value.Value;
    rv:           value.Value;
    elem_ty:      ir_type.IrTypeId;
    is_float:     bool;
    bytes:        u32;
    lanes:        u32;
    accesses:     *MemAccess;
    access_count: u32;
    access_cap:   u32;
    alloc:        *A.Allocator;
}

fun reduction_none(alloc: *A.Allocator) ReductionInfo {
    var ri: ReductionInfo;
    ri.ok           = false;
    ri.op           = instruction.OP_ADD;
    ri.acc_phi      = id.INSTR_NIL;
    ri.acc_update   = id.INSTR_NIL;
    ri.rv           = value.const_null(ir_type.IRT_NIL);
    ri.acc_init     = value.const_null(ir_type.IRT_NIL);
    ri.elem_ty      = ir_type.IRT_NIL;
    ri.is_float     = false;
    ri.bytes        = 0;
    ri.lanes        = 0;
    ri.accesses     = nil;
    ri.access_count = 0;
    ri.access_cap   = 0;
    ri.alloc        = alloc;
    ret ri;
}

pub fun reduction_dnit(ri: *ReductionInfo) {
    if (ri.accesses != nil && ri.access_cap > 0) {
        A.deallocate[MemAccess](ri.alloc, ri.accesses, ri.access_cap::usize);
        ri.accesses = nil;
    }
    ri.access_count = 0;
    ri.access_cap   = 0;
}

fun is_reduction_op(k: instruction.InstrKind, is_float: bool) bool {
    if (is_float) { ret opdesc.has(k, opdesc.EFF_REDUCE_FLOAT); }
    ret opdesc.has(k, opdesc.EFF_REDUCE_INT);
}


pub fun analyze_reduction(fn: *ir.Function, la: *loops.LoopAnalysis, loop_ix: u32, types: *ir_type.IrTypeTable, alloc: *A.Allocator, float_reassoc: bool) res[ReductionInfo, fail.Fail] {
    if (loop_ix >= la.loop_len) { ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }
    val lp: *loops.Loop = ?la.loops[loop_ix];
    if (!lp.is_counted) { ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }
    if (lp.iv.step.kind != value.VAL_CONST_INT || lp.iv.step.data.int_lit != 1) { ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }
    var acc_phi: id.InstructionId = id.INSTR_NIL;
    var bi: u32 = 0;
    for (bi < lp.body_len) {
        val bid: id.BlockId = lp.body[bi];
        val blk: *ir.Block = ?fn.blocks[bid::u32];
        if (bid == lp.header) {
            if (blk.phi_count != 2) { ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }
            var pj: u32 = 0;
            for (pj < 2) {
                if (blk.phis[pj] != lp.iv.phi) { acc_phi = blk.phis[pj]; }
                pj = pj + 1;
            }
        } or {
            if (blk.phi_count != 0) { ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }
        }
        bi = bi + 1;
    }
    if (acc_phi == id.INSTR_NIL) { ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }

    val popt: opt[*instruction.Instruction] = ir.instruction_get(fn, acc_phi);
    if (sel popt.none) { ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }
    val phi: *instruction.Instruction = popt.some;
    if (phi.operand_count != 4) { ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }
    var acc_init: value.Value;
    var upd_val:  value.Value;
    var got_init: bool = false;
    var got_upd:  bool = false;
    var j: u32 = 0;
    for (j < 2) {
        val btgt: id.BlockId = ir.block_target(phi.operands[2 * j]);
        val vv:   value.Value = phi.operands[2 * j + 1];
        if (btgt == lp.preheader) { acc_init = vv; got_init = true; }
        if (btgt == lp.latch)     { upd_val = vv; got_upd  = true; }
        j = j + 1;
    }
    if (!got_init || !got_upd || upd_val.kind != value.VAL_INSTR) { ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }

    val elem_ty:  ir_type.IrTypeId = phi.ty;
    val is_float: bool = ir_type.is_float_scalar(types, elem_ty);
    if (is_float && !float_reassoc) { ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }

    val uopt: opt[*instruction.Instruction] = ir.instruction_get(fn, upd_val.data.instr);
    if (sel uopt.none) { ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }
    val upd: *instruction.Instruction = uopt.some;
    if (!is_reduction_op(upd.kind, is_float) || upd.operand_count != 2) { ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }
    val a: value.Value = upd.operands[0];
    val b: value.Value = upd.operands[1];
    var rv: value.Value = b;
    if (a.kind == value.VAL_INSTR && a.data.instr == acc_phi) { rv = b; }
    or {
        if (b.kind == value.VAL_INSTR && b.data.instr == acc_phi) { rv = a; }
        or { ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }
    }
    if (rv.kind != value.VAL_INSTR) { ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }

    if (!acc_used_only_by(fn, la, loop_ix, acc_phi, upd_val.data.instr)) { ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }

    val w: u32 = scalar_bytes(types, elem_ty);
    if (w == 0 || w > 8 || (16 / w) < 2) { ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }

    var ri: ReductionInfo = reduction_none(alloc);
    var total: u32 = 0;
    bi = 0;
    for (bi < lp.body_len) { total = total + fn.blocks[lp.body[bi]::u32].instr_count; bi = bi + 1; }
    if (total > 0) {
        val ral: res[*MemAccess, A.Error] = A.allocate[MemAccess](alloc, total::usize);
        if (sel ral.err) { ret res[ReductionInfo, fail.Fail].err{fail.refused(ral.err)}; }
        ri.accesses  = ral.ok;
        ri.access_cap = total;
    }
    bi = 0;
    for (bi < lp.body_len) {
        val blk: *ir.Block = ?fn.blocks[lp.body[bi]::u32];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val iid: id.InstructionId = blk.instructions[ii];
            val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
            if (sel opt_.none) { reduction_dnit(?ri); ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }
            val inst: *instruction.Instruction = opt_.some;
            if (inst.kind == instruction.OP_STORE || inst.kind == instruction.OP_CALL || inst.kind == instruction.OP_ASM || inst.kind == instruction.OP_MEMZERO) {
                reduction_dnit(?ri); ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)};
            }
            if (inst.kind == instruction.OP_LOAD) {
                var acc: MemAccess;
                if (!classify_access(fn, la, loop_ix, iid, inst, types, ?acc)) { reduction_dnit(?ri); ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }
                if (acc.elem_ty != elem_ty) { reduction_dnit(?ri); ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }
                ri.accesses[ri.access_count] = acc;
                ri.access_count = ri.access_count + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    if (ri.access_count == 0) { reduction_dnit(?ri); ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)}; }

    ri.ok         = true;
    ri.op         = upd.kind;
    ri.acc_phi    = acc_phi;
    ri.acc_update = upd_val.data.instr;
    ri.acc_init   = acc_init;
    ri.rv         = rv;
    ri.elem_ty    = elem_ty;
    ri.is_float   = is_float;
    ri.bytes      = w;
    ri.lanes      = 16 / w;
    ret res[ReductionInfo, fail.Fail].ok{ri};
}

fun acc_used_only_by(fn: *ir.Function, la: *loops.LoopAnalysis, loop_ix: u32, acc: id.InstructionId, upd: id.InstructionId) bool {
    val lp: *loops.Loop = ?la.loops[loop_ix];
    var bi: u32 = 0;
    for (bi < lp.body_len) {
        val blk: *ir.Block = ?fn.blocks[lp.body[bi]::u32];
        var pj: u32 = 0;
        for (pj < blk.phi_count) {
            if (!instr_uses_only(fn, blk.phis[pj], acc, upd)) { ret false; }
            pj = pj + 1;
        }
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            if (!instr_uses_only(fn, blk.instructions[ii], acc, upd)) { ret false; }
            ii = ii + 1;
        }
        if (blk.terminator != id.INSTR_NIL && !instr_uses_only(fn, blk.terminator, acc, upd)) { ret false; }
        bi = bi + 1;
    }
    ret true;
}

fun instr_uses_only(fn: *ir.Function, iid: id.InstructionId, acc: id.InstructionId, upd: id.InstructionId) bool {
    if (iid == upd) { ret true; }
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
    if (sel opt_.none) { ret true; }
    val inst: *instruction.Instruction = opt_.some;
    if (inst.kind == instruction.OP_DBG_VALUE) { ret true; }
    var o: u32 = 0;
    for (o < inst.operand_count) {
        if (inst.operands[o].kind == value.VAL_INSTR && inst.operands[o].data.instr == acc) { ret false; }
        o = o + 1;
    }
    ret true;
}
