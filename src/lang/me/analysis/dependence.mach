use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.me.analysis.loops;
use mach.lang.me.ir;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.wide;

pub rec MemAccess {
    instr:     id.InstructionId;
    gep:       id.InstructionId;
    base:      value.Value;
    off:       value.Value;
    stride_ty: ir_type.IrTypeId;
    elem_ty:   ir_type.IrTypeId;
    bytes:     u32;
    is_store:  bool;
}

pub def DepVerdict: u8;
pub val DEP_INDEPENDENT: DepVerdict = 0;
pub val DEP_DEPENDENT:   DepVerdict = 1;

pub rec DepInfo {
    alloc:        *A.Allocator;
    verdict:      DepVerdict;
    accesses:     *MemAccess;
    access_count: u32;
    access_cap:   u32;
}

pub fun analyze_dependence(fn: *ir.Function, la: *loops.LoopAnalysis, loop_ix: u32, types: *ir_type.IrTypeTable, alloc: *A.Allocator) res[DepInfo, fail.Fail] {
    var d: DepInfo;
    d.alloc        = alloc;
    d.verdict      = DEP_DEPENDENT;
    d.accesses     = nil;
    d.access_count = 0;
    d.access_cap   = 0;

    if (loop_ix >= la.loop_len) { ret res[DepInfo, fail.Fail].ok{d}; }
    val lp: *loops.Loop = ?la.loops[loop_ix];

    if (!lp.is_counted)                         { ret res[DepInfo, fail.Fail].ok{d}; }
    if (lp.iv.step.kind != value.VAL_CONST_INT) { ret res[DepInfo, fail.Fail].ok{d}; }
    if (!is_one_const(lp.iv.step))              { ret res[DepInfo, fail.Fail].ok{d}; }

    if (!ivs_only_recurrence(fn, la, loop_ix)) { ret res[DepInfo, fail.Fail].ok{d}; }

    var total: u32 = 0;
    var bi:    u32 = 0;
    for (bi < lp.body_len) {
        total = total + fn.blocks[lp.body[bi]::u32].instr_count;
        bi    = bi + 1;
    }
    if (total > 0) {
        val ra: res[*MemAccess, A.Error] = A.allocate[MemAccess](alloc, total::usize);
        if (sel ra.err) { ret res[DepInfo, fail.Fail].err{fail.refused(ra.err)}; }
        d.accesses   = ra.ok;
        d.access_cap = total;
    }

    bi = 0;
    for (bi < lp.body_len) {
        val blk: *ir.Block = ?fn.blocks[lp.body[bi]::u32];
        var ii:  u32       = 0;
        for (ii < blk.instr_count) {
            val iid:  id.InstructionId              = blk.instructions[ii];
            val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
            if (sel opt_.none) {
                dep_dnit(?d);
                ret dependent(alloc);
            }
            val inst: *instruction.Instruction = opt_.some;

            if (inst.kind == instruction.OP_CALL || inst.kind == instruction.OP_ASM || inst.kind == instruction.OP_MEMZERO) {
                dep_dnit(?d);
                ret dependent(alloc);
            }
            if (inst.kind == instruction.OP_LOAD || inst.kind == instruction.OP_STORE) {
                var acc: MemAccess;
                if (!classify_access(fn, la, loop_ix, iid, inst, types, ?acc)) {
                    dep_dnit(?d);
                    ret dependent(alloc);
                }
                d.accesses[d.access_count] = acc;
                d.access_count             = d.access_count + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    var i: u32 = 0;
    for (i < d.access_count) {
        var j: u32 = i + 1;
        for (j < d.access_count) {
            if (equal(d.accesses[i].base, d.accesses[j].base)) {
                if (d.accesses[i].bytes != d.accesses[j].bytes) {
                    dep_dnit(?d);
                    ret dependent(alloc);
                }
                if ((d.accesses[i].is_store || d.accesses[j].is_store) && !equal(d.accesses[i].off, d.accesses[j].off)) {
                    dep_dnit(?d);
                    ret dependent(alloc);
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }

    d.verdict = DEP_INDEPENDENT;
    ret res[DepInfo, fail.Fail].ok{d};
}

pub fun equal(a: value.Value, b: value.Value) bool {
    if (a.kind != b.kind)                { ret false; }
    if (a.kind == value.VAL_INSTR)       { ret a.data.instr == b.data.instr; }
    if (a.kind == value.VAL_PARAM)       { ret a.data.param_ix == b.data.param_ix; }
    if (a.kind == value.VAL_CONST_INT)   { ret wide.eq(value.int_of(?a), value.int_of(?b)); }
    if (a.kind == value.VAL_CONST_NULL)  { ret true; }
    if (a.kind == value.VAL_CONST_FLOAT) { ret (a.data.float_lit:~u64) == (b.data.float_lit:~u64); }
    if (a.kind == value.VAL_GLOBAL)      { ret a.data.global_ix == b.data.global_ix; }
    if (a.kind == value.VAL_FN)          { ret a.data.fn_ix == b.data.fn_ix; }
    ret false;
}

fun scalar_bytes(types: *ir_type.IrTypeTable, id: ir_type.IrTypeId) u32 {
    val opt_: opt[*ir_type.IrType] = ir_type.get(types, id);
    if (sel opt_.none) { ret 0; }
    val t: *ir_type.IrType = opt_.some;
    if (t.kind == ir_type.IRT_INT || t.kind == ir_type.IRT_FLOAT) { ret t.data.bits / 8; }
    ret 0;
}

fun dependent(alloc: *A.Allocator) res[DepInfo, fail.Fail] {
    var d: DepInfo;
    d.alloc        = alloc;
    d.verdict      = DEP_DEPENDENT;
    d.accesses     = nil;
    d.access_count = 0;
    d.access_cap   = 0;
    ret res[DepInfo, fail.Fail].ok{d};
}

pub fun dep_dnit(d: *DepInfo) {
    if (d.accesses != nil && d.access_cap > 0) {
        A.deallocate[MemAccess](d.alloc, d.accesses, d.access_cap::usize);
        d.accesses = nil;
    }
    d.access_count = 0;
    d.access_cap   = 0;
}

pub fun ivs_only_recurrence(fn: *ir.Function, la: *loops.LoopAnalysis, loop_ix: u32) bool {
    val lp: *loops.Loop = ?la.loops[loop_ix];
    var bi: u32         = 0;
    for (bi < lp.body_len) {
        val bid: id.BlockId = lp.body[bi];
        val blk: *ir.Block  = ?fn.blocks[bid::u32];
        if (bid == lp.header) {
            var pi: u32 = 0;
            for (pi < blk.phi_count) {
                var ai: AffineIndex;
                if (blk.phis[pi] != lp.iv.phi && !secondary_iv(fn, la, loop_ix, blk.phis[pi], ?ai)) { ret false; }
                pi = pi + 1;
            }
            if (!header_has_phi(blk, lp.iv.phi)) { ret false; }
        }
        or {
            var pi: u32 = 0;
            for (pi < blk.phi_count) {
                if (!same_iteration_phi(fn, la, bid, blk.phis[pi])) { ret false; }
                pi = pi + 1;
            }
        }
        bi = bi + 1;
    }
    ret true;
}

fun same_iteration_phi(fn: *ir.Function, la: *loops.LoopAnalysis, bid: id.BlockId, pid: id.InstructionId) bool {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, pid);
    if (sel opt_.none) { ret false; }
    val phi: *instruction.Instruction = opt_.some;
    if (phi.kind != instruction.OP_PHI || phi.operand_count == 0 || (phi.operand_count % 2) != 0) { ret false; }
    var o: u32 = 0;
    for (o < phi.operand_count) {
        val pred: id.BlockId = ir.block_target(phi.operands[o]);
        if (pred::u32 >= fn.block_count || loops.dominates(la, bid, pred)) { ret false; }
        o = o + 2;
    }
    ret true;
}

fun header_has_phi(blk: *ir.Block, pid: id.InstructionId) bool {
    var i: u32 = 0;
    for (i < blk.phi_count) {
        if (blk.phis[i] == pid) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun gep_elem_shape(gep: *instruction.Instruction, types: *ir_type.IrTypeTable, out_base: *value.Value, out_idx: *value.Value, out_sty: *ir_type.IrTypeId) bool {
    if (gep.kind != instruction.OP_GEP) { ret false; }
    if (gep.operand_count == 2) {
        @out_base = gep.operands[0];
        @out_idx  = gep.operands[1];
        @out_sty  = gep.aux_ty;
        ret true;
    }
    if (gep.operand_count != 3)          { ret false; }
    if (!is_zero_const(gep.operands[1])) { ret false; }
    val aopt: opt[*ir_type.IrType] = ir_type.get(types, gep.aux_ty);
    if (sel aopt.none) { ret false; }
    val at: *ir_type.IrType = aopt.some;
    if (at.kind != ir_type.IRT_ARRAY) { ret false; }
    @out_base = gep.operands[0];
    @out_idx  = gep.operands[2];
    @out_sty  = at.data.array_.element;
    ret true;
}

rec AffineIndex {
    off:    value.Value;
    stride: u64;
}

val AFFINE_DEPTH: u32 = 8;

fun is_zero_const(v: value.Value) bool {
    ret v.kind == value.VAL_CONST_INT && wide.is_zero(value.int_of(?v));
}

fun is_one_const(v: value.Value) bool {
    ret v.kind == value.VAL_CONST_INT && wide.eq(value.int_of(?v), wide.from_u64(1));
}

fun affine_add(x: *AffineIndex, y: *AffineIndex, out: *AffineIndex) bool {
    out.stride = x.stride + y.stride;
    if (is_zero_const(x.off)) {
        out.off = y.off;
        ret true;
    }
    if (is_zero_const(y.off)) {
        out.off = x.off;
        ret true;
    }
    if (x.off.kind == value.VAL_CONST_INT && y.off.kind == value.VAL_CONST_INT) {
        out.off = value.const_int(x.off.data.int_lit + y.off.data.int_lit, x.off.ty);
        ret true;
    }
    ret false;
}

fun affine_negate(x: *AffineIndex, out: *AffineIndex) bool {
    out.stride = 0 - x.stride;
    if (is_zero_const(x.off)) {
        out.off = x.off;
        ret true;
    }
    if (x.off.kind == value.VAL_CONST_INT) {
        out.off = value.const_int(0 - x.off.data.int_lit, x.off.ty);
        ret true;
    }
    ret false;
}

fun affine_scale(x: *AffineIndex, k: u64, out: *AffineIndex) bool {
    out.stride = x.stride * k;
    if (is_zero_const(x.off)) {
        out.off = x.off;
        ret true;
    }
    if (x.off.kind == value.VAL_CONST_INT) {
        out.off = value.const_int(x.off.data.int_lit * k, x.off.ty);
        ret true;
    }
    ret false;
}

fun secondary_iv(fn: *ir.Function, la: *loops.LoopAnalysis, loop_ix: u32, pid: id.InstructionId, out: *AffineIndex) bool {
    val lp: *loops.Loop = ?la.loops[loop_ix];
    if (pid::u32 >= la.instr_count || la.instr_block[pid::u32] != lp.header) { ret false; }
    val popt: opt[*instruction.Instruction] = ir.instruction_get(fn, pid);
    if (sel popt.none) { ret false; }
    val phi: *instruction.Instruction = popt.some;
    if (phi.operand_count != 4) { ret false; }

    var init:     value.Value;
    var upd:      value.Value;
    var got_init: bool = false;
    var got_upd:  bool = false;
    var j:        u32  = 0;
    for (j < 2) {
        val btgt: id.BlockId = ir.block_target(phi.operands[2 * j]);
        if (btgt == lp.preheader) {
            init     = phi.operands[2 * j + 1];
            got_init = true;
        }
        if (btgt == lp.latch) {
            upd     = phi.operands[2 * j + 1];
            got_upd = true;
        }
        j = j + 1;
    }
    if (!got_init || !got_upd)                  { ret false; }
    if (!loops.is_invariant(la, loop_ix, init)) { ret false; }
    if (upd.kind != value.VAL_INSTR)            { ret false; }

    val uopt: opt[*instruction.Instruction] = ir.instruction_get(fn, upd.data.instr);
    if (sel uopt.none) { ret false; }
    val u: *instruction.Instruction = uopt.some;
    if (u.kind != instruction.OP_ADD || u.operand_count != 2) { ret false; }
    var step: value.Value;
    if (u.operands[0].kind == value.VAL_INSTR && u.operands[0].data.instr == pid) { step = u.operands[1]; }
    or {
        if (u.operands[1].kind == value.VAL_INSTR && u.operands[1].data.instr == pid) { step = u.operands[0]; }
        or                                                                            { ret false; }
    }
    if (step.kind != value.VAL_CONST_INT) { ret false; }

    out.stride = step.data.int_lit;
    val iv_init: value.Value = lp.iv.init;
    if (is_zero_const(iv_init)) {
        out.off = init;
        ret true;
    }
    if (init.kind == value.VAL_CONST_INT && iv_init.kind == value.VAL_CONST_INT) {
        out.off = value.const_int(init.data.int_lit - out.stride * iv_init.data.int_lit, init.ty);
        ret true;
    }
    ret false;
}

fun affine_index(fn: *ir.Function, la: *loops.LoopAnalysis, loop_ix: u32, v: value.Value, depth: u32, out: *AffineIndex) bool {
    val lp: *loops.Loop = ?la.loops[loop_ix];

    if (v.kind == value.VAL_INSTR && v.data.instr == lp.iv.phi) {
        out.off    = value.const_int(0, v.ty);
        out.stride = 1;
        ret true;
    }
    if (loops.is_invariant(la, loop_ix, v)) {
        out.off    = v;
        out.stride = 0;
        ret true;
    }
    if (depth == 0 || v.kind != value.VAL_INSTR) { ret false; }
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, v.data.instr);
    if (sel opt_.none) { ret false; }
    val inst: *instruction.Instruction = opt_.some;

    if (inst.kind == instruction.OP_PHI) { ret secondary_iv(fn, la, loop_ix, v.data.instr, out); }
    if (inst.operand_count != 2)         { ret false; }

    var x: AffineIndex;
    var y: AffineIndex;
    if (!affine_index(fn, la, loop_ix, inst.operands[0], depth - 1, ?x)) { ret false; }
    if (!affine_index(fn, la, loop_ix, inst.operands[1], depth - 1, ?y)) { ret false; }

    if (inst.kind == instruction.OP_ADD) { ret affine_add(?x, ?y, out); }
    if (inst.kind == instruction.OP_SUB) {
        var ny: AffineIndex;
        if (!affine_negate(?y, ?ny)) { ret false; }
        ret affine_add(?x, ?ny, out);
    }
    if (inst.kind == instruction.OP_MUL) {
        if (y.stride == 0 && y.off.kind == value.VAL_CONST_INT) { ret affine_scale(?x, y.off.data.int_lit, out); }
        if (x.stride == 0 && x.off.kind == value.VAL_CONST_INT) { ret affine_scale(?y, x.off.data.int_lit, out); }
        ret false;
    }
    ret false;
}

fun classify_access(fn: *ir.Function, la: *loops.LoopAnalysis, loop_ix: u32, iid: id.InstructionId, inst: *instruction.Instruction, types: *ir_type.IrTypeTable, out: *MemAccess) bool {
    if ((inst.flags & instruction.INSTR_FLAG_VOLATILE) != 0) { ret false; }
    val is_store: bool = inst.kind == instruction.OP_STORE;

    var ptr: value.Value;
    if (is_store) {
        if (inst.operand_count < 2) { ret false; }
        ptr = inst.operands[1];
    }
    or {
        if (inst.operand_count < 1) { ret false; }
        ptr = inst.operands[0];
    }
    if (ptr.kind != value.VAL_INSTR) { ret false; }

    val gopt: opt[*instruction.Instruction] = ir.instruction_get(fn, ptr.data.instr);
    if (sel gopt.none) { ret false; }
    val gep: *instruction.Instruction = gopt.some;

    var base:      value.Value;
    var idx:       value.Value;
    var stride_ty: ir_type.IrTypeId;
    if (!gep_elem_shape(gep, types, ?base, ?idx, ?stride_ty)) { ret false; }
    val lp: *loops.Loop = ?la.loops[loop_ix];
    var ax: AffineIndex;
    if (!affine_index(fn, la, loop_ix, idx, AFFINE_DEPTH, ?ax)) { ret false; }
    if (ax.stride != 1)                                         { ret false; }
    if (ax.off.ty != lp.iv.init.ty)                             { ret false; }
    if (!loops.is_invariant(la, loop_ix, base))                 { ret false; }

    var elem_ty: ir_type.IrTypeId = inst.ty;
    if (is_store) { elem_ty = inst.operands[0].ty; }

    val stride_bytes: u32 = scalar_bytes(types, stride_ty);
    val width_bytes:  u32 = scalar_bytes(types, elem_ty);
    if (stride_bytes == 0 || width_bytes == 0) { ret false; }
    if (stride_bytes != width_bytes)           { ret false; }

    out.instr     = iid;
    out.gep       = ptr.data.instr;
    out.base      = base;
    out.off       = ax.off;
    out.stride_ty = stride_ty;
    out.elem_ty   = elem_ty;
    out.bytes     = width_bytes;
    out.is_store  = is_store;
    ret true;
}

use mach.lang.intern;
use mach.lang.me.ir.builder;
use std.allocator.page;

#[testing]
fun mk_skeleton(m: *ir.Module, bld: *builder.Builder, i64t: ir_type.IrTypeId, o_entry: *id.BlockId, o_header: *id.BlockId, o_body: *id.BlockId, o_exit: *id.BlockId, o_iv: *value.Value) i32 {
    val re: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel re.err) { ret 1; }
    val entry: id.BlockId                 = re.ok;
    val rh:    res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rh.err) { ret 1; }
    val header: id.BlockId                 = rh.ok;
    val rb:     res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rb.err) { ret 1; }
    val body: id.BlockId                 = rb.ok;
    val rx:   res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rx.err) { ret 1; }
    val exit: id.BlockId = rx.ok;

    val n: value.Value = value.param(0, i64t);

    builder.set_block(bld, entry);
    val r_410: err[fail.Fail] = builder.emit_br(bld, header);
    if (sel r_410.err) { ret 1; }

    builder.set_block(bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(bld, i64t);
    if (sel rphi.err) { ret 1; }
    val iv: value.Value                 = rphi.ok;
    val rc: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(bld, iv, n);
    if (sel rc.err) { ret 1; }
    val r_418: err[fail.Fail] = builder.emit_cbr(bld, rc.ok, body, exit);
    if (sel r_418.err) { ret 1; }

    builder.set_block(bld, exit);
    val r_421: err[fail.Fail] = builder.emit_ret_void(bld);
    if (sel r_421.err) { ret 1; }

    val r_423: err[fail.Fail] = builder.phi_add_incoming(bld, iv, entry, value.const_int(0, i64t));
    if (sel r_423.err) { ret 1; }

    @o_entry  = entry;
    @o_header = header;
    @o_body   = body;
    @o_exit   = exit;
    @o_iv     = iv;
    ret 0;
}

#[testing]
fun body_gep(bld: *builder.Builder, base: value.Value, iv: value.Value, i64t: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var ix: [1]value.Value;
    ix[0] = iv;
    ret builder.emit_gep(bld, base, i64t, ?ix[0], 1);
}

# the constant probes read both limbs (#3511)
test const_probes__read_both_limbs {
    if (!is_zero_const(value.const_int(0, 0)))                                                      { ret 1; }
    if (is_zero_const(value.const_int_wide(wide.make(0, 1), 0)))                                    { ret 2; }
    if (!is_one_const(value.const_int(1, 0)))                                                       { ret 3; }
    if (is_one_const(value.const_int_wide(wide.make(1, 1), 0)))                                     { ret 4; }
    if (is_one_const(value.param(0, 0)))                                                            { ret 5; }
    if (!equal(value.const_int_wide(wide.make(1, 1), 0), value.const_int_wide(wide.make(1, 1), 0))) { ret 6; }
    if (equal(value.const_int(1, 0), value.const_int_wide(wide.make(1, 1), 0)))                     { ret 7; }
    ret 0;
}

test analyze_dependence__declines_a_nested_recurrence {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val rt64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt64.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i64t: ir_type.IrTypeId                 = rt64.ok;
    val rt8:  res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel rt8.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i8t: ir_type.IrTypeId = rt8.ok;

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn:  *ir.Function    = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val re: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel re.err) {
        ir.dnit(?m);
        ret 1;
    }
    val entry: id.BlockId                 = re.ok;
    val roh:   res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel roh.err) {
        ir.dnit(?m);
        ret 1;
    }
    val outer_h: id.BlockId                 = roh.ok;
    val rih:     res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rih.err) {
        ir.dnit(?m);
        ret 1;
    }
    val inner_h: id.BlockId                 = rih.ok;
    val rib:     res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rib.err) {
        ir.dnit(?m);
        ret 1;
    }
    val inner_body: id.BlockId                 = rib.ok;
    val rol:        res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rol.err) {
        ir.dnit(?m);
        ret 1;
    }
    val outer_latch: id.BlockId = rol.ok;

    val zero: value.Value = value.const_int(0, i64t);
    val one:  value.Value = value.const_int(1, i64t);

    builder.set_block(?bld, entry);
    val r_475: err[fail.Fail] = builder.emit_br(?bld, outer_h);
    if (sel r_475.err) {
        ir.dnit(?m);
        ret 1;
    }

    builder.set_block(?bld, outer_h);
    val rpo: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel rpo.err) {
        ir.dnit(?m);
        ret 1;
    }
    val phi_o: value.Value    = rpo.ok;
    val r_481: err[fail.Fail] = builder.emit_br(?bld, inner_h);
    if (sel r_481.err) {
        ir.dnit(?m);
        ret 1;
    }

    builder.set_block(?bld, inner_h);
    val rpi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel rpi.err) {
        ir.dnit(?m);
        ret 1;
    }
    val phi_i: value.Value    = rpi.ok;
    val r_487: err[fail.Fail] = builder.emit_cbr(?bld, value.param(0, i8t), inner_body, outer_latch);
    if (sel r_487.err) {
        ir.dnit(?m);
        ret 1;
    }

    builder.set_block(?bld, inner_body);
    val r_490: err[fail.Fail] = builder.emit_br(?bld, inner_h);
    if (sel r_490.err) {
        ir.dnit(?m);
        ret 1;
    }

    builder.set_block(?bld, outer_latch);
    val ruo: res[value.Value, fail.Fail] = builder.emit_add(?bld, phi_o, one);
    if (sel ruo.err) {
        ir.dnit(?m);
        ret 1;
    }
    val upd_o: value.Value    = ruo.ok;
    val r_496: err[fail.Fail] = builder.emit_br(?bld, outer_h);
    if (sel r_496.err) {
        ir.dnit(?m);
        ret 1;
    }

    val r_498: err[fail.Fail] = builder.phi_add_incoming(?bld, phi_o, entry, zero);
    if (sel r_498.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_499: err[fail.Fail] = builder.phi_add_incoming(?bld, phi_o, outer_latch, upd_o);
    if (sel r_499.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_500: err[fail.Fail] = builder.phi_add_incoming(?bld, phi_i, outer_h, zero);
    if (sel r_500.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_501: err[fail.Fail] = builder.phi_add_incoming(?bld, phi_i, inner_body, one);
    if (sel r_501.err) {
        ir.dnit(?m);
        ret 1;
    }

    var code: i32                                = 0;
    val ra:   res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?m.types, ?alloc);
    if (sel ra.err) {
        ir.dnit(?m);
        ret 1;
    }
    var la:       loops.LoopAnalysis = ra.ok;
    var outer_ix: u32                = loops.NONE_U32;
    var i:        u32                = 0;
    for (i < la.loop_len) {
        if (la.loops[i].header == outer_h) { outer_ix = i; }
        i = i + 1;
    }
    if (outer_ix == loops.NONE_U32 || !la.loops[outer_ix].has_iv) { code = 1; }
    or {
        if (ivs_only_recurrence(fn, ?la, outer_ix)) { code = 1; }
    }
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

test analyze_dependence__elementwise_access_is_independent {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m:  ir.Module                        = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i64t: ir_type.IrTypeId                 = rt.ok;
    val rp:   res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) {
        ir.dnit(?m);
        ret 1;
    }
    val ptrt: ir_type.IrTypeId    = rp.ok;
    val rf:   res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn:  *ir.Function    = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry:  id.BlockId;
    var header: id.BlockId;
    var body:   id.BlockId;
    var exit:   id.BlockId;
    var iv:     value.Value;
    if (mk_skeleton(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) {
        ir.dnit(?m);
        ret 1;
    }

    val a: value.Value = value.param(1, ptrt);
    val b: value.Value = value.param(2, ptrt);
    val c: value.Value = value.param(3, ptrt);

    builder.set_block(?bld, body);
    val rgb: res[value.Value, fail.Fail] = body_gep(?bld, b, iv, i64t);
    if (sel rgb.err) {
        ir.dnit(?m);
        ret 1;
    }
    val rlb: res[value.Value, fail.Fail] = builder.emit_load(?bld, rgb.ok, i64t);
    if (sel rlb.err) {
        ir.dnit(?m);
        ret 1;
    }
    val rgc: res[value.Value, fail.Fail] = body_gep(?bld, c, iv, i64t);
    if (sel rgc.err) {
        ir.dnit(?m);
        ret 1;
    }
    val rlc: res[value.Value, fail.Fail] = builder.emit_load(?bld, rgc.ok, i64t);
    if (sel rlc.err) {
        ir.dnit(?m);
        ret 1;
    }
    val rs: res[value.Value, fail.Fail] = builder.emit_add(?bld, rlb.ok, rlc.ok);
    if (sel rs.err) {
        ir.dnit(?m);
        ret 1;
    }
    val rga: res[value.Value, fail.Fail] = body_gep(?bld, a, iv, i64t);
    if (sel rga.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_560: err[fail.Fail] = builder.emit_store(?bld, rs.ok, rga.ok);
    if (sel r_560.err) {
        ir.dnit(?m);
        ret 1;
    }
    val ru: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) {
        ir.dnit(?m);
        ret 1;
    }
    val upd:   value.Value    = ru.ok;
    val r_564: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, upd);
    if (sel r_564.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_565: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_565.err) {
        ir.dnit(?m);
        ret 1;
    }

    var code: i32                                = 0;
    val ral:  res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?m.types, ?alloc);
    if (sel ral.err) {
        ir.dnit(?m);
        ret 1;
    }
    var la: loops.LoopAnalysis      = ral.ok;
    val rd: res[DepInfo, fail.Fail] = analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) {
        loops.dnit(?la);
        ir.dnit(?m);
        ret 1;
    }
    var di: DepInfo = rd.ok;
    if (di.verdict != DEP_INDEPENDENT) { code = 1; }
    if (di.access_count != 3)          { code = 1; }
    dep_dnit(?di);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

test analyze_dependence__loop_carried_access_is_dependent {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m:  ir.Module                        = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i64t: ir_type.IrTypeId                 = rt.ok;
    val rp:   res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) {
        ir.dnit(?m);
        ret 1;
    }
    val ptrt: ir_type.IrTypeId    = rp.ok;
    val rf:   res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn:  *ir.Function    = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry:  id.BlockId;
    var header: id.BlockId;
    var body:   id.BlockId;
    var exit:   id.BlockId;
    var iv:     value.Value;
    if (mk_skeleton(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) {
        ir.dnit(?m);
        ret 1;
    }

    val a: value.Value = value.param(1, ptrt);
    builder.set_block(?bld, body);
    val rim1: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(0xFFFFFFFFFFFFFFFF, i64t));
    if (sel rim1.err) {
        ir.dnit(?m);
        ret 1;
    }
    val rgs: res[value.Value, fail.Fail] = body_gep(?bld, a, rim1.ok, i64t);
    if (sel rgs.err) {
        ir.dnit(?m);
        ret 1;
    }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?bld, rgs.ok, i64t);
    if (sel rl.err) {
        ir.dnit(?m);
        ret 1;
    }
    val rgd: res[value.Value, fail.Fail] = body_gep(?bld, a, iv, i64t);
    if (sel rgd.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_613: err[fail.Fail] = builder.emit_store(?bld, rl.ok, rgd.ok);
    if (sel r_613.err) {
        ir.dnit(?m);
        ret 1;
    }
    val ru: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_616: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, ru.ok);
    if (sel r_616.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_617: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_617.err) {
        ir.dnit(?m);
        ret 1;
    }

    var code: i32                                = 0;
    val ral:  res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?m.types, ?alloc);
    if (sel ral.err) {
        ir.dnit(?m);
        ret 1;
    }
    var la: loops.LoopAnalysis      = ral.ok;
    val rd: res[DepInfo, fail.Fail] = analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) {
        loops.dnit(?la);
        ir.dnit(?m);
        ret 1;
    }
    var di: DepInfo = rd.ok;
    if (di.verdict != DEP_DEPENDENT) { code = 1; }
    dep_dnit(?di);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

#[testing]
fun reduction_verdict(op: instruction.InstrKind, is_float: bool, float_reassoc: bool, want_ok: bool) i32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m:  ir.Module                        = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i64t: ir_type.IrTypeId                 = rt.ok;
    val rft:  res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_float(?m.types, 64);
    if (sel rft.err) {
        ir.dnit(?m);
        ret 1;
    }
    val f64t: ir_type.IrTypeId = rft.ok;
    var acct: ir_type.IrTypeId = i64t;
    if (is_float) { acct = f64t; }
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) {
        ir.dnit(?m);
        ret 1;
    }
    val ptrt: ir_type.IrTypeId    = rp.ok;
    val rf:   res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn:  *ir.Function    = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry:  id.BlockId;
    var header: id.BlockId;
    var body:   id.BlockId;
    var exit:   id.BlockId;
    var iv:     value.Value;
    if (mk_skeleton(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) {
        ir.dnit(?m);
        ret 1;
    }

    builder.set_block(?bld, header);
    val racc: res[value.Value, fail.Fail] = builder.emit_phi(?bld, acct);
    if (sel racc.err) {
        ir.dnit(?m);
        ret 1;
    }
    val acc: value.Value = racc.ok;

    val a: value.Value = value.param(1, ptrt);
    builder.set_block(?bld, body);
    var ix: [1]value.Value;
    ix[0] = iv;
    val rg: res[value.Value, fail.Fail] = builder.emit_gep(?bld, a, acct, ?ix[0], 1);
    if (sel rg.err) {
        ir.dnit(?m);
        ret 1;
    }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?bld, rg.ok, acct);
    if (sel rl.err) {
        ir.dnit(?m);
        ret 1;
    }
    val ld:   value.Value = rl.ok;
    var racu: res[value.Value, fail.Fail];
    if (op == instruction.OP_MUL) { racu = builder.emit_mul(?bld, acc, ld); }
    or (op == instruction.OP_SUB) { racu = builder.emit_sub(?bld, acc, ld); }
    or                            { racu = builder.emit_add(?bld, acc, ld); }
    if (sel racu.err) {
        ir.dnit(?m);
        ret 1;
    }
    val acc_upd: value.Value                 = racu.ok;
    val ru:      res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_679: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, ru.ok);
    if (sel r_679.err) {
        ir.dnit(?m);
        ret 1;
    }
    var zero: value.Value = value.const_int(0, i64t);
    if (is_float) { zero = value.const_float(0.0, f64t); }
    val r_680: err[fail.Fail] = builder.phi_add_incoming(?bld, acc, entry, zero);
    if (sel r_680.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_681: err[fail.Fail] = builder.phi_add_incoming(?bld, acc, body, acc_upd);
    if (sel r_681.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_682: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_682.err) {
        ir.dnit(?m);
        ret 1;
    }

    var code: i32                                = 0;
    val ral:  res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?m.types, ?alloc);
    if (sel ral.err) {
        ir.dnit(?m);
        ret 1;
    }
    var la: loops.LoopAnalysis            = ral.ok;
    val rr: res[ReductionInfo, fail.Fail] = analyze_reduction(fn, ?la, 0, ?m.types, ?alloc, float_reassoc);
    if (sel rr.err) {
        loops.dnit(?la);
        ir.dnit(?m);
        ret 1;
    }
    var ri: ReductionInfo = rr.ok;
    if (ri.ok != want_ok) { code = 1; }
    if (ri.ok) {
        if (ri.op != op)                                { code = 1; }
        if (ri.is_float != is_float)                    { code = 1; }
        if (ri.bytes != 8)                              { code = 1; }
        if (ri.lanes != 2)                              { code = 1; }
        if (ri.elem_ty != acct)                         { code = 1; }
        if (ri.acc_ty != acct)                          { code = 1; }
        if (ri.ordered != (is_float && !float_reassoc)) { code = 1; }
    }
    reduction_dnit(?ri);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

# a float sum or product without reassociation is still a reduction, one that
# must combine in program order
test analyze_dependence__float_reduction_is_ordered_without_reassociation {
    var code: i32 = 0;
    if (reduction_verdict(instruction.OP_ADD, true, false, true) != 0)  { code = 1; }
    if (reduction_verdict(instruction.OP_MUL, true, false, true) != 0)  { code = 1; }
    if (reduction_verdict(instruction.OP_ADD, true, true, true) != 0)   { code = 1; }
    if (reduction_verdict(instruction.OP_MUL, true, true, true) != 0)   { code = 1; }
    if (reduction_verdict(instruction.OP_SUB, true, true, false) != 0)  { code = 1; }
    if (reduction_verdict(instruction.OP_SUB, true, false, false) != 0) { code = 1; }
    ret code;
}

# an integer sum or product is exact in any order, so it needs no permission
test analyze_dependence__integer_reduction_needs_no_reassociation {
    var code: i32 = 0;
    if (reduction_verdict(instruction.OP_ADD, false, false, true) != 0)  { code = 1; }
    if (reduction_verdict(instruction.OP_MUL, false, false, true) != 0)  { code = 1; }
    if (reduction_verdict(instruction.OP_SUB, false, false, false) != 0) { code = 1; }
    ret code;
}

test analyze_dependence__reduction_is_dependent {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m:  ir.Module                        = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i64t: ir_type.IrTypeId                 = rt.ok;
    val rp:   res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) {
        ir.dnit(?m);
        ret 1;
    }
    val ptrt: ir_type.IrTypeId    = rp.ok;
    val rf:   res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn:  *ir.Function    = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry:  id.BlockId;
    var header: id.BlockId;
    var body:   id.BlockId;
    var exit:   id.BlockId;
    var iv:     value.Value;
    if (mk_skeleton(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) {
        ir.dnit(?m);
        ret 1;
    }

    builder.set_block(?bld, header);
    val racc: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel racc.err) {
        ir.dnit(?m);
        ret 1;
    }
    val acc: value.Value = racc.ok;

    val a: value.Value = value.param(1, ptrt);
    builder.set_block(?bld, body);
    val rg: res[value.Value, fail.Fail] = body_gep(?bld, a, iv, i64t);
    if (sel rg.err) {
        ir.dnit(?m);
        ret 1;
    }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?bld, rg.ok, i64t);
    if (sel rl.err) {
        ir.dnit(?m);
        ret 1;
    }
    val racu: res[value.Value, fail.Fail] = builder.emit_add(?bld, acc, rl.ok);
    if (sel racu.err) {
        ir.dnit(?m);
        ret 1;
    }
    val acc_upd: value.Value                 = racu.ok;
    val ru:      res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_753: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, ru.ok);
    if (sel r_753.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_754: err[fail.Fail] = builder.phi_add_incoming(?bld, acc, entry, value.const_int(0, i64t));
    if (sel r_754.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_755: err[fail.Fail] = builder.phi_add_incoming(?bld, acc, body, acc_upd);
    if (sel r_755.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_756: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_756.err) {
        ir.dnit(?m);
        ret 1;
    }

    var code: i32                                = 0;
    val ral:  res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?m.types, ?alloc);
    if (sel ral.err) {
        ir.dnit(?m);
        ret 1;
    }
    var la: loops.LoopAnalysis      = ral.ok;
    val rd: res[DepInfo, fail.Fail] = analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) {
        loops.dnit(?la);
        ir.dnit(?m);
        ret 1;
    }
    var di: DepInfo = rd.ok;
    if (di.verdict != DEP_DEPENDENT) { code = 1; }
    dep_dnit(?di);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

test analyze_dependence__same_base_different_width_is_dependent {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m:  ir.Module                        = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i64t: ir_type.IrTypeId                 = rt.ok;
    val rt8:  res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel rt8.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i8t: ir_type.IrTypeId                 = rt8.ok;
    val rp:  res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) {
        ir.dnit(?m);
        ret 1;
    }
    val ptrt: ir_type.IrTypeId    = rp.ok;
    val rf:   res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn:  *ir.Function    = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry:  id.BlockId;
    var header: id.BlockId;
    var body:   id.BlockId;
    var exit:   id.BlockId;
    var iv:     value.Value;
    if (mk_skeleton(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) {
        ir.dnit(?m);
        ret 1;
    }

    val a: value.Value = value.param(1, ptrt);
    builder.set_block(?bld, body);
    var ix8: [1]value.Value;
    ix8[0] = iv;
    val rg8: res[value.Value, fail.Fail] = builder.emit_gep(?bld, a, i8t, ?ix8[0], 1);
    if (sel rg8.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_801: err[fail.Fail] = builder.emit_store(?bld, value.const_int(0, i8t), rg8.ok);
    if (sel r_801.err) {
        ir.dnit(?m);
        ret 1;
    }
    var ix64: [1]value.Value;
    ix64[0] = iv;
    val rg64: res[value.Value, fail.Fail] = builder.emit_gep(?bld, a, i64t, ?ix64[0], 1);
    if (sel rg64.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_805: err[fail.Fail] = builder.emit_store(?bld, value.const_int(0, i64t), rg64.ok);
    if (sel r_805.err) {
        ir.dnit(?m);
        ret 1;
    }
    val ru: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_808: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, ru.ok);
    if (sel r_808.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_809: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_809.err) {
        ir.dnit(?m);
        ret 1;
    }

    var code: i32                                = 0;
    val ral:  res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?m.types, ?alloc);
    if (sel ral.err) {
        ir.dnit(?m);
        ret 1;
    }
    var la: loops.LoopAnalysis      = ral.ok;
    val rd: res[DepInfo, fail.Fail] = analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) {
        loops.dnit(?la);
        ir.dnit(?m);
        ret 1;
    }
    var di: DepInfo = rd.ok;
    if (di.verdict != DEP_DEPENDENT) { code = 1; }
    dep_dnit(?di);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

test analyze_dependence__access_wider_than_stride_is_dependent {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m:  ir.Module                        = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i64t: ir_type.IrTypeId                 = rt.ok;
    val rt8:  res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel rt8.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i8t: ir_type.IrTypeId                 = rt8.ok;
    val rp:  res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) {
        ir.dnit(?m);
        ret 1;
    }
    val ptrt: ir_type.IrTypeId    = rp.ok;
    val rf:   res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn:  *ir.Function    = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry:  id.BlockId;
    var header: id.BlockId;
    var body:   id.BlockId;
    var exit:   id.BlockId;
    var iv:     value.Value;
    if (mk_skeleton(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) {
        ir.dnit(?m);
        ret 1;
    }

    val a: value.Value = value.param(1, ptrt);
    builder.set_block(?bld, body);
    var ix: [1]value.Value;
    ix[0] = iv;
    val rg: res[value.Value, fail.Fail] = builder.emit_gep(?bld, a, i8t, ?ix[0], 1);
    if (sel rg.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_854: err[fail.Fail] = builder.emit_store(?bld, value.const_int(0, i64t), rg.ok);
    if (sel r_854.err) {
        ir.dnit(?m);
        ret 1;
    }
    val ru: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_857: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, ru.ok);
    if (sel r_857.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_858: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_858.err) {
        ir.dnit(?m);
        ret 1;
    }

    var code: i32                                = 0;
    val ral:  res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?m.types, ?alloc);
    if (sel ral.err) {
        ir.dnit(?m);
        ret 1;
    }
    var la: loops.LoopAnalysis      = ral.ok;
    val rd: res[DepInfo, fail.Fail] = analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) {
        loops.dnit(?la);
        ir.dnit(?m);
        ret 1;
    }
    var di: DepInfo = rd.ok;
    if (di.verdict != DEP_DEPENDENT) { code = 1; }
    dep_dnit(?di);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

# a loop's accumulator, `acc = acc op rv` each iteration. a predicated update
# applies `op` only where the compare `pred_cmp` holds (fails, when
# `pred_on_true` is false) and keeps the accumulator otherwise: `pred_join` is
# the select if-conversion left, or the join phi of a diamond whose arm computes
# the update, whose branch block and arms are named (an arm is BLOCK_NIL for a
# direct edge into the join). `rv` is then the value the update combines in,
# and the update instruction and the join are read only by each other and the
# accumulator. `elem_ty` is the element the loop loads, which sets the lanes;
# `acc_ty` is the accumulator's, the same type or a wider integer. `ordered`
# marks a float update without reassociation, which must combine the values in
# program order, one at a time
pub rec ReductionInfo {
    ok:           bool;
    ordered:      bool;
    op:           instruction.InstrKind;
    acc_phi:      id.InstructionId;
    acc_update:   id.InstructionId;
    acc_init:     value.Value;
    rv:           value.Value;
    elem_ty:      ir_type.IrTypeId;
    acc_ty:       ir_type.IrTypeId;
    is_float:     bool;
    bytes:        u32;
    lanes:        u32;
    pred_cmp:     id.InstructionId;
    pred_join:    id.InstructionId;
    pred_on_true: bool;
    pred_entry:   id.BlockId;
    pred_arm_t:   id.BlockId;
    pred_arm_f:   id.BlockId;
    pred_block:   id.BlockId;
    accesses:     *MemAccess;
    access_count: u32;
    access_cap:   u32;
    alloc:        *A.Allocator;
}

fun reduction_none(alloc: *A.Allocator) ReductionInfo {
    var ri: ReductionInfo;
    ri.ok           = false;
    ri.ordered      = false;
    ri.op           = instruction.OP_ADD;
    ri.acc_phi      = id.INSTR_NIL;
    ri.acc_update   = id.INSTR_NIL;
    ri.rv           = value.const_null(ir_type.IRT_NIL);
    ri.acc_init     = value.const_null(ir_type.IRT_NIL);
    ri.elem_ty      = ir_type.IRT_NIL;
    ri.acc_ty       = ir_type.IRT_NIL;
    ri.is_float     = false;
    ri.bytes        = 0;
    ri.lanes        = 0;
    ri.pred_cmp     = id.INSTR_NIL;
    ri.pred_join    = id.INSTR_NIL;
    ri.pred_on_true = true;
    ri.pred_entry   = id.BLOCK_NIL;
    ri.pred_arm_t   = id.BLOCK_NIL;
    ri.pred_arm_f   = id.BLOCK_NIL;
    ri.pred_block   = id.BLOCK_NIL;
    ri.accesses     = nil;
    ri.access_count = 0;
    ri.access_cap   = 0;
    ri.alloc        = alloc;
    ret ri;
}

pub fun reduction_dnit(ri: *ReductionInfo) {
    if (ri.accesses != nil && ri.access_cap > 0) {
        A.deallocate[MemAccess](ri.alloc, ri.accesses, ri.access_cap::usize);
        ri.accesses = nil;
    }
    ri.access_count = 0;
    ri.access_cap   = 0;
}

fun is_reduction_op(k: instruction.InstrKind, is_float: bool) bool {
    if (is_float) { ret opdesc.has(k, opdesc.EFF_REDUCE_FLOAT); }
    ret opdesc.has(k, opdesc.EFF_REDUCE_INT);
}

# the blocks from the header round to the back edge: plain branches, and at
# most one conditional branch into a diamond or triangle whose join is the one
# block after the header with a phi. an arm is one block entered only from the
# branch and leaving straight to the join
rec BodyShape {
    entry: id.BlockId;
    arm_t: id.BlockId;
    arm_f: id.BlockId;
    join:  id.BlockId;
    cond:  value.Value;
}

fun in_body(lp: *loops.Loop, b: id.BlockId) bool {
    var i: u32 = 0;
    for (i < lp.body_len) {
        if (lp.body[i] == b) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun body_shape(fn: *ir.Function, lp: *loops.Loop, out: *BodyShape) bool {
    out.entry = id.BLOCK_NIL;
    out.arm_t = id.BLOCK_NIL;
    out.arm_f = id.BLOCK_NIL;
    out.join  = id.BLOCK_NIL;
    out.cond  = value.const_null(ir_type.IRT_NIL);
    var s0: id.BlockId;
    var s1: id.BlockId;
    if (ir.block_successors(fn, ?fn.blocks[lp.header::u32], ?s0, ?s1) != 2) { ret false; }
    var cur: id.BlockId = s0;
    if (!in_body(lp, s0)) { cur = s1; }
    var seen: u32 = 1;
    for (cur != lp.header) {
        if (!in_body(lp, cur) || seen >= lp.body_len) { ret false; }
        val blk: *ir.Block = ?fn.blocks[cur::u32];
        if (blk.phi_count != 0 && cur != out.join) { ret false; }
        seen = seen + 1;
        val topt: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.terminator);
        if (sel topt.none) { ret false; }
        val term: *instruction.Instruction = topt.some;
        if (term.kind == instruction.OP_BR && term.operand_count >= 1) {
            cur = ir.block_target(term.operands[0]);
            cnt;
        }
        if (term.kind != instruction.OP_CBR || term.operand_count < 3 || out.entry != id.BLOCK_NIL)           { ret false; }
        if (!diamond(fn, lp, cur, ir.block_target(term.operands[1]), ir.block_target(term.operands[2]), out)) { ret false; }
        out.entry = cur;
        out.cond  = term.operands[0];
        if (out.arm_t != id.BLOCK_NIL) { seen = seen + 1; }
        if (out.arm_f != id.BLOCK_NIL) { seen = seen + 1; }
        cur = out.join;
    }
    ret seen == lp.body_len;
}

# the join an arm block leaves to, BLOCK_NIL when `x` is no arm of `entry`
fun arm_exit(fn: *ir.Function, lp: *loops.Loop, x: id.BlockId, entry: id.BlockId) id.BlockId {
    if (x == lp.header || !in_body(lp, x)) { ret id.BLOCK_NIL; }
    val blk: *ir.Block = ?fn.blocks[x::u32];
    if (blk.phi_count != 0 || blk.pred_count != 1 || blk.preds[0] != entry) { ret id.BLOCK_NIL; }
    val topt: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.terminator);
    if (sel topt.none)                                                      { ret id.BLOCK_NIL; }
    if (topt.some.kind != instruction.OP_BR || topt.some.operand_count < 1) { ret id.BLOCK_NIL; }
    ret ir.block_target(topt.some.operands[0]);
}

fun diamond(fn: *ir.Function, lp: *loops.Loop, entry: id.BlockId, t: id.BlockId, f: id.BlockId, out: *BodyShape) bool {
    if (t == f) { ret false; }
    val jt: id.BlockId = arm_exit(fn, lp, t, entry);
    val jf: id.BlockId = arm_exit(fn, lp, f, entry);
    if (jt != id.BLOCK_NIL && jt == jf) {
        out.arm_t = t;
        out.arm_f = f;
        out.join  = jt;
    }
    or (jt != id.BLOCK_NIL && jt == f) {
        out.arm_t = t;
        out.join  = f;
    }
    or (jf != id.BLOCK_NIL && jf == t) {
        out.arm_f = f;
        out.join  = t;
    }
    or                                                   { ret false; }
    if (out.join == lp.header || !in_body(lp, out.join)) { ret false; }
    val jb: *ir.Block = ?fn.blocks[out.join::u32];
    ret jb.pred_count == 2 && jb.phi_count == 1;
}

fun edge_into_join(s: *BodyShape, arm: id.BlockId) id.BlockId {
    if (arm != id.BLOCK_NIL) { ret arm; }
    ret s.entry;
}

fun incoming_from(phi: *instruction.Instruction, from: id.BlockId, out: *value.Value) bool {
    var o: u32 = 0;
    for (o + 1 < phi.operand_count) {
        if (ir.block_target(phi.operands[o]) == from) {
            @out = phi.operands[o + 1];
            ret true;
        }
        o = o + 2;
    }
    ret false;
}

fun is_instr(v: value.Value, iid: id.InstructionId) bool {
    ret v.kind == value.VAL_INSTR && v.data.instr == iid;
}

fun none_r(alloc: *A.Allocator) res[ReductionInfo, fail.Fail] {
    ret res[ReductionInfo, fail.Fail].ok{reduction_none(alloc)};
}

pub fun analyze_reduction(fn: *ir.Function, la: *loops.LoopAnalysis, loop_ix: u32, types: *ir_type.IrTypeTable, alloc: *A.Allocator, float_reassoc: bool) res[ReductionInfo, fail.Fail] {
    if (loop_ix >= la.loop_len) { ret none_r(alloc); }
    val lp: *loops.Loop = ?la.loops[loop_ix];
    if (!lp.is_counted)            { ret none_r(alloc); }
    if (!is_one_const(lp.iv.step)) { ret none_r(alloc); }
    var shape: BodyShape;
    if (!body_shape(fn, lp, ?shape)) { ret none_r(alloc); }
    val hb: *ir.Block = ?fn.blocks[lp.header::u32];
    if (hb.phi_count != 2) { ret none_r(alloc); }
    var acc_phi: id.InstructionId = id.INSTR_NIL;
    var pj:      u32              = 0;
    for (pj < 2) {
        if (hb.phis[pj] != lp.iv.phi) { acc_phi = hb.phis[pj]; }
        pj = pj + 1;
    }
    if (acc_phi == id.INSTR_NIL) { ret none_r(alloc); }

    val popt: opt[*instruction.Instruction] = ir.instruction_get(fn, acc_phi);
    if (sel popt.none) { ret none_r(alloc); }
    val phi: *instruction.Instruction = popt.some;
    if (phi.operand_count != 4) { ret none_r(alloc); }
    var acc_init: value.Value;
    var upd_val:  value.Value;
    if (!incoming_from(phi, lp.preheader, ?acc_init)) { ret none_r(alloc); }
    if (!incoming_from(phi, lp.latch, ?upd_val))      { ret none_r(alloc); }
    if (upd_val.kind != value.VAL_INSTR)              { ret none_r(alloc); }

    val acc_ty:   ir_type.IrTypeId = phi.ty;
    val is_float: bool             = ir_type.is_float_scalar(types, acc_ty);

    var ri:   ReductionInfo                 = reduction_none(alloc);
    val lopt: opt[*instruction.Instruction] = ir.instruction_get(fn, upd_val.data.instr);
    if (sel lopt.none) { ret none_r(alloc); }
    val last:   *instruction.Instruction = lopt.some;
    var upd_id: id.InstructionId         = upd_val.data.instr;
    var cond:   value.Value              = value.const_null(ir_type.IRT_NIL);
    var tv:     value.Value;
    var fv:     value.Value;
    if (last.kind == instruction.OP_SELECT && last.operand_count == 3 && shape.entry == id.BLOCK_NIL) {
        cond         = last.operands[0];
        tv           = last.operands[1];
        fv           = last.operands[2];
        ri.pred_join = upd_id;
    }
    or (last.kind == instruction.OP_PHI && shape.entry != id.BLOCK_NIL && fn.blocks[shape.join::u32].phis[0] == upd_id) {
        if (!incoming_from(last, edge_into_join(?shape, shape.arm_t), ?tv)) { ret none_r(alloc); }
        if (!incoming_from(last, edge_into_join(?shape, shape.arm_f), ?fv)) { ret none_r(alloc); }
        cond          = shape.cond;
        ri.pred_join  = upd_id;
        ri.pred_entry = shape.entry;
        ri.pred_arm_t = shape.arm_t;
        ri.pred_arm_f = shape.arm_f;
        ri.pred_block = shape.join;
    }
    or (shape.entry != id.BLOCK_NIL) { ret none_r(alloc); }

    if (ri.pred_join != id.INSTR_NIL) {
        if (is_float) { ret none_r(alloc); }
        var upd: value.Value = tv;
        if (is_instr(tv, acc_phi)) {
            upd             = fv;
            ri.pred_on_true = false;
        }
        or (!is_instr(fv, acc_phi))                                      { ret none_r(alloc); }
        if (upd.kind != value.VAL_INSTR || cond.kind != value.VAL_INSTR) { ret none_r(alloc); }
        val copt: opt[*instruction.Instruction] = ir.instruction_get(fn, cond.data.instr);
        if (sel copt.none)                                   { ret none_r(alloc); }
        if (!opdesc.has(copt.some.kind, opdesc.EFF_COMPARE)) { ret none_r(alloc); }
        ri.pred_cmp = cond.data.instr;
        upd_id      = upd.data.instr;
    }

    val uopt: opt[*instruction.Instruction] = ir.instruction_get(fn, upd_id);
    if (sel uopt.none) { ret none_r(alloc); }
    val upd: *instruction.Instruction = uopt.some;
    if (!is_reduction_op(upd.kind, is_float) || upd.operand_count != 2 || upd.ty != acc_ty) { ret none_r(alloc); }
    var rv: value.Value = upd.operands[1];
    if (!is_instr(upd.operands[0], acc_phi)) {
        if (!is_instr(upd.operands[1], acc_phi)) { ret none_r(alloc); }
        rv = upd.operands[0];
    }
    if (is_instr(rv, acc_phi))                                      { ret none_r(alloc); }
    if (ri.pred_join == id.INSTR_NIL && rv.kind != value.VAL_INSTR) { ret none_r(alloc); }

    if (ri.pred_join == id.INSTR_NIL) {
        if (!uses_confined(fn, lp, acc_phi, upd_id, upd_id)) { ret none_r(alloc); }
    }
    or {
        var cond_user: id.InstructionId = ri.pred_join;
        if (ri.pred_entry != id.BLOCK_NIL)                              { cond_user = fn.blocks[ri.pred_entry::u32].terminator; }
        if (!uses_confined(fn, lp, acc_phi, upd_id, ri.pred_join))      { ret none_r(alloc); }
        if (!uses_confined(fn, lp, upd_id, ri.pred_join, ri.pred_join)) { ret none_r(alloc); }
        if (!uses_confined(fn, lp, ri.pred_join, acc_phi, acc_phi))     { ret none_r(alloc); }
        if (!uses_confined(fn, lp, ri.pred_cmp, cond_user, cond_user))  { ret none_r(alloc); }
    }

    var total: u32 = 0;
    var bi:    u32 = 0;
    for (bi < lp.body_len) {
        total = total + fn.blocks[lp.body[bi]::u32].instr_count;
        bi    = bi + 1;
    }
    if (total > 0) {
        val ral: res[*MemAccess, A.Error] = A.allocate[MemAccess](alloc, total::usize);
        if (sel ral.err) { ret res[ReductionInfo, fail.Fail].err{fail.refused(ral.err)}; }
        ri.accesses   = ral.ok;
        ri.access_cap = total;
    }
    var elem_ty: ir_type.IrTypeId = ir_type.IRT_NIL;
    bi = 0;
    for (bi < lp.body_len) {
        val blk: *ir.Block = ?fn.blocks[lp.body[bi]::u32];
        var ii:  u32       = 0;
        for (ii < blk.instr_count) {
            val iid:  id.InstructionId              = blk.instructions[ii];
            val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
            if (sel opt_.none) {
                reduction_dnit(?ri);
                ret none_r(alloc);
            }
            val inst: *instruction.Instruction = opt_.some;
            if (inst.kind == instruction.OP_STORE || inst.kind == instruction.OP_CALL || inst.kind == instruction.OP_ASM || inst.kind == instruction.OP_MEMZERO) {
                reduction_dnit(?ri);
                ret none_r(alloc);
            }
            if (inst.kind == instruction.OP_LOAD) {
                var acc: MemAccess;
                if (!classify_access(fn, la, loop_ix, iid, inst, types, ?acc)) {
                    reduction_dnit(?ri);
                    ret none_r(alloc);
                }
                if (elem_ty == ir_type.IRT_NIL) { elem_ty = acc.elem_ty; }
                if (acc.elem_ty != elem_ty) {
                    reduction_dnit(?ri);
                    ret none_r(alloc);
                }
                ri.accesses[ri.access_count] = acc;
                ri.access_count              = ri.access_count + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    if (ri.access_count == 0 || !lanes_fit(types, elem_ty, acc_ty, is_float)
        || !arm_speculates(fn, la, ri.pred_arm_t, ?ri) || !arm_speculates(fn, la, ri.pred_arm_f, ?ri)) {
        reduction_dnit(?ri);
        ret none_r(alloc);
    }

    val w: u32 = scalar_bytes(types, elem_ty);
    ri.ok         = true;
    ri.ordered    = is_float && !float_reassoc;
    ri.op         = upd.kind;
    ri.acc_phi    = acc_phi;
    ri.acc_update = upd_id;
    ri.acc_init   = acc_init;
    ri.rv         = rv;
    ri.elem_ty    = elem_ty;
    ri.acc_ty     = acc_ty;
    ri.is_float   = is_float;
    ri.bytes      = w;
    ri.lanes      = 16 / w;
    ret res[ReductionInfo, fail.Fail].ok{ri};
}

# the loaded element sets the lanes; a float accumulator is the element type, an
# integer one is the element type or wider
fun lanes_fit(types: *ir_type.IrTypeTable, elem_ty: ir_type.IrTypeId, acc_ty: ir_type.IrTypeId, is_float: bool) bool {
    val w: u32 = scalar_bytes(types, elem_ty);
    if (w == 0 || w > 8 || (16 / w) < 2)                     { ret false; }
    if (is_float || ir_type.is_float_scalar(types, elem_ty)) { ret elem_ty == acc_ty; }
    ret scalar_bytes(types, acc_ty) >= w;
}

# every lane runs an arm, so an arm holds only what may run on any lane: a
# speculatable computation, or a load of an element the loop loads outside the
# arms as well
fun arm_speculates(fn: *ir.Function, la: *loops.LoopAnalysis, arm: id.BlockId, ri: *ReductionInfo) bool {
    if (arm == id.BLOCK_NIL) { ret true; }
    val blk: *ir.Block = ?fn.blocks[arm::u32];
    var ii:  u32       = 0;
    for (ii < blk.instr_count) {
        val inst: *instruction.Instruction = ?fn.instrs[blk.instructions[ii]::u32];
        if (inst.kind == instruction.OP_LOAD) {
            if (!loaded_outside_arms(la, blk.instructions[ii], ri)) { ret false; }
        }
        or (inst.kind != instruction.OP_DBG_VALUE && !opdesc.has(inst.kind, opdesc.EFF_SPECULATABLE)) { ret false; }
        ii = ii + 1;
    }
    ret true;
}

fun loaded_outside_arms(la: *loops.LoopAnalysis, iid: id.InstructionId, ri: *ReductionInfo) bool {
    var own: u32 = ri.access_count;
    var i:   u32 = 0;
    for (i < ri.access_count) {
        if (ri.accesses[i].instr == iid) { own = i; }
        i = i + 1;
    }
    if (own == ri.access_count) { ret false; }
    val a: *MemAccess = ?ri.accesses[own];
    i = 0;
    for (i < ri.access_count) {
        val b:  *MemAccess = ?ri.accesses[i];
        val bb: id.BlockId = la.instr_block[b.instr::u32];
        if (i != own && bb != ri.pred_arm_t && bb != ri.pred_arm_f && equal(a.base, b.base) && equal(a.off, b.off)
            && a.elem_ty == b.elem_ty) { ret true; }
        i = i + 1;
    }
    ret false;
}

# every use of `x` in the loop is by `a` or `b`, a debug binding aside
fun uses_confined(fn: *ir.Function, lp: *loops.Loop, x: id.InstructionId, a: id.InstructionId, b: id.InstructionId) bool {
    var bi: u32 = 0;
    for (bi < lp.body_len) {
        val blk: *ir.Block = ?fn.blocks[lp.body[bi]::u32];
        var pj:  u32       = 0;
        for (pj < blk.phi_count) {
            if (!use_allowed(fn, blk.phis[pj], x, a, b)) { ret false; }
            pj = pj + 1;
        }
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            if (!use_allowed(fn, blk.instructions[ii], x, a, b)) { ret false; }
            ii = ii + 1;
        }
        if (blk.terminator != id.INSTR_NIL && !use_allowed(fn, blk.terminator, x, a, b)) { ret false; }
        bi = bi + 1;
    }
    ret true;
}

fun use_allowed(fn: *ir.Function, iid: id.InstructionId, x: id.InstructionId, a: id.InstructionId, b: id.InstructionId) bool {
    if (iid == a || iid == b) { ret true; }
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
    if (sel opt_.none) { ret true; }
    val inst: *instruction.Instruction = opt_.some;
    if (inst.kind == instruction.OP_DBG_VALUE) { ret true; }
    var o: u32 = 0;
    for (o < inst.operand_count) {
        if (is_instr(inst.operands[o], x)) { ret false; }
        o = o + 1;
    }
    ret true;
}
