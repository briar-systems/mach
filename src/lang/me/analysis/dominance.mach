# the dominator tree of a function, read from the edges its terminators name:
# each block's predecessors, the reverse postorder from the entry, immediate
# dominators, the tree's children and a numbering of the tree that makes a
# dominance query an interval test, and on request the dominance frontiers
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use me_ir: mach.lang.me.ir;
use ir_id: mach.lang.me.ir.id;

# the reverse postorder index of a block no path from the entry reaches

pub rec Dominance {
    alloc:       *A.Allocator;
    block_count: u32;

    # block b's predecessors are pred_flat[pred_start[b]] onward, pred_len[b]
    # of them, one per edge in block order
    pred_start: *u32;
    pred_len:   *u32;
    pred_flat:  *ir_id.BlockId;
    edge_count: u32;

    rpo:       *ir_id.BlockId;
    rpo_len:   u32;
    rpo_index: *u32;
    # the entry's is the entry, and an unreachable block's BLOCK_NIL
    idom: *ir_id.BlockId;

    # block b's children in the tree are children[child_start[b]] up to
    # children[child_start[b + 1]], in block order
    child_start: *u32;
    children:    *u32;

    # one depth-first walk of the tree numbers each block on entry and exit, so
    # a dominates b when b's interval lies inside a's
    dom_pre:  *u32;
    dom_post: *u32;

    # block b's frontier is frontier[frontier_start[b]] onward,
    # frontier_len[b] of them in block order; nil until `frontiers_build`
    frontier_start: *u32;
    frontier_len:   *u32;
    frontier:       *ir_id.BlockId;
    frontier_cap:   u32;
}

# the dominator tree of `fn` as it stands, its storage taken from `alloc`
pub fun init(fn: *me_ir.Function, alloc: *A.Allocator) res[Dominance, fail.Fail] {
    var d: Dominance;
    d.alloc          = alloc;
    d.block_count    = fn.block_count;
    d.pred_start     = nil;
    d.pred_len       = nil;
    d.pred_flat      = nil;
    d.edge_count     = 0;
    d.rpo            = nil;
    d.rpo_len        = 0;
    d.rpo_index      = nil;
    d.idom           = nil;
    d.child_start    = nil;
    d.children       = nil;
    d.dom_pre        = nil;
    d.dom_post       = nil;
    d.frontier_start = nil;
    d.frontier_len   = nil;
    d.frontier       = nil;
    d.frontier_cap   = 0;
    if (fn.block_count == 0) { ret res[Dominance, fail.Fail].ok{d}; }

    val built: err[fail.Fail] = build(?d, fn);
    if (sel built.err) {
        dnit(?d);
        ret res[Dominance, fail.Fail].err{built.err};
    }
    ret res[Dominance, fail.Fail].ok{d};
}

pub fun dnit(d: *Dominance) {
    val n: usize = d.block_count::usize;
    if (d.pred_start != nil)     { A.deallocate[u32](d.alloc, d.pred_start, n); }
    if (d.pred_len != nil)       { A.deallocate[u32](d.alloc, d.pred_len, n); }
    if (d.pred_flat != nil)      { A.deallocate[ir_id.BlockId](d.alloc, d.pred_flat, d.edge_count::usize); }
    if (d.rpo != nil)            { A.deallocate[ir_id.BlockId](d.alloc, d.rpo, n); }
    if (d.rpo_index != nil)      { A.deallocate[u32](d.alloc, d.rpo_index, n); }
    if (d.idom != nil)           { A.deallocate[ir_id.BlockId](d.alloc, d.idom, n); }
    if (d.child_start != nil)    { A.deallocate[u32](d.alloc, d.child_start, n + 1); }
    if (d.children != nil)       { A.deallocate[u32](d.alloc, d.children, n); }
    if (d.dom_pre != nil)        { A.deallocate[u32](d.alloc, d.dom_pre, n); }
    if (d.dom_post != nil)       { A.deallocate[u32](d.alloc, d.dom_post, n); }
    if (d.frontier_start != nil) { A.deallocate[u32](d.alloc, d.frontier_start, n); }
    if (d.frontier_len != nil)   { A.deallocate[u32](d.alloc, d.frontier_len, n); }
    if (d.frontier != nil)       { A.deallocate[ir_id.BlockId](d.alloc, d.frontier, d.frontier_cap::usize); }
    d.pred_start     = nil;
    d.pred_len       = nil;
    d.pred_flat      = nil;
    d.rpo            = nil;
    d.rpo_index      = nil;
    d.idom           = nil;
    d.child_start    = nil;
    d.children       = nil;
    d.dom_pre        = nil;
    d.dom_post       = nil;
    d.frontier_start = nil;
    d.frontier_len   = nil;
    d.frontier       = nil;
}

# whether a path from the entry reaches `b`
pub fun block_is_reachable(d: *Dominance, b: ir_id.BlockId) bool {
    ret b::u32 < d.block_count && d.rpo_index[b::u32] != ir_id.NONE;
}

# whether every path from the entry to `b` passes through `a`; a block
# dominates itself, and no block dominates or is dominated by an unreachable one
pub fun dominates(d: *Dominance, a: ir_id.BlockId, b: ir_id.BlockId) bool {
    val n: u32 = d.block_count;
    if (a::u32 >= n || b::u32 >= n)        { ret false; }
    if (ir_id.block_same(a, b))            { ret true; }
    if (d.rpo_index[b::u32] == ir_id.NONE) { ret false; }
    ret d.dom_pre[a::u32] <= d.dom_pre[b::u32] && d.dom_post[b::u32] <= d.dom_post[a::u32];
}

fun build(d: *Dominance, fn: *me_ir.Function) err[fail.Fail] {
    val preds: err[fail.Fail] = preds_build(d, fn);
    if (sel preds.err) { ret preds; }
    val n: usize = d.block_count::usize;

    val rr: res[*ir_id.BlockId, A.Error] = A.allocate[ir_id.BlockId](d.alloc, n);
    if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
    d.rpo = rr.ok;
    val ri: res[*u32, A.Error] = A.allocate[u32](d.alloc, n);
    if (sel ri.err) { ret err[fail.Fail].err{fail.refused(ri.err)}; }
    d.rpo_index = ri.ok;
    val rd: res[*ir_id.BlockId, A.Error] = A.allocate[ir_id.BlockId](d.alloc, n);
    if (sel rd.err) { ret err[fail.Fail].err{fail.refused(rd.err)}; }
    d.idom = rd.ok;

    var i: u32 = 0;
    for (i < d.block_count) {
        d.rpo_index[i] = ir_id.NONE;
        d.idom[i]      = ir_id.BLOCK_NIL;
        i              = i + 1;
    }

    val order: err[fail.Fail] = rpo_build(d, fn);
    if (sel order.err) { ret order; }
    idom_build(d);
    ret tree_build(d);
}

fun preds_build(d: *Dominance, fn: *me_ir.Function) err[fail.Fail] {
    val n: u32 = d.block_count;

    val rs: res[*u32, A.Error] = A.allocate[u32](d.alloc, n::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    d.pred_start = rs.ok;
    val rc: res[*u32, A.Error] = A.allocate[u32](d.alloc, n::usize);
    if (sel rc.err) { ret err[fail.Fail].err{fail.refused(rc.err)}; }
    d.pred_len = rc.ok;

    var i: u32 = 0;
    for (i < n) {
        d.pred_len[i] = 0;
        i             = i + 1;
    }
    var b: u32 = 0;
    for (b < n) {
        var s0: ir_id.BlockId = ir_id.BLOCK_NIL;
        var s1: ir_id.BlockId = ir_id.BLOCK_NIL;
        val sn: u32           = me_ir.block_successors(fn, ?fn.blocks[b], ?s0, ?s1);
        if (sn >= 1 && s0::u32 < n) { d.pred_len[s0::u32] = d.pred_len[s0::u32] + 1; }
        if (sn >= 2 && s1::u32 < n) { d.pred_len[s1::u32] = d.pred_len[s1::u32] + 1; }
        b = b + 1;
    }

    var total: u32 = 0;
    i = 0;
    for (i < n) {
        d.pred_start[i] = total;
        total           = total + d.pred_len[i];
        d.pred_len[i]   = 0;
        i               = i + 1;
    }

    val rf: res[*ir_id.BlockId, A.Error] = A.allocate[ir_id.BlockId](d.alloc, total::usize);
    if (sel rf.err) { ret err[fail.Fail].err{fail.refused(rf.err)}; }
    d.pred_flat  = rf.ok;
    d.edge_count = total;

    b = 0;
    for (b < n) {
        var c0: ir_id.BlockId = ir_id.BLOCK_NIL;
        var c1: ir_id.BlockId = ir_id.BLOCK_NIL;
        val cn: u32           = me_ir.block_successors(fn, ?fn.blocks[b], ?c0, ?c1);
        if (cn >= 1 && c0::u32 < n) { pred_add(d, c0::u32, b); }
        if (cn >= 2 && c1::u32 < n) { pred_add(d, c1::u32, b); }
        b = b + 1;
    }
    ret err[fail.Fail].ok{};
}

fun pred_add(d: *Dominance, to: u32, from: u32) {
    d.pred_flat[d.pred_start[to] + d.pred_len[to]] = from::ir_id.BlockId;
    d.pred_len[to]                                 = d.pred_len[to] + 1;
}

# an iterative depth-first walk from the entry taking each block's successors
# in terminator order, its postorder reversed
fun rpo_build(d: *Dominance, fn: *me_ir.Function) err[fail.Fail] {
    val n: u32 = d.block_count;

    val rv: res[*bool, A.Error] = A.allocate[bool](d.alloc, n::usize);
    if (sel rv.err) { ret err[fail.Fail].err{fail.refused(rv.err)}; }
    val visited: *bool = rv.ok;
    fin { A.deallocate[bool](d.alloc, visited, n::usize); }
    val rb: res[*u32, A.Error] = A.allocate[u32](d.alloc, n::usize);
    if (sel rb.err) { ret err[fail.Fail].err{fail.refused(rb.err)}; }
    val stk_block: *u32 = rb.ok;
    fin { A.deallocate[u32](d.alloc, stk_block, n::usize); }
    val rc: res[*u32, A.Error] = A.allocate[u32](d.alloc, n::usize);
    if (sel rc.err) { ret err[fail.Fail].err{fail.refused(rc.err)}; }
    val stk_succ: *u32 = rc.ok;
    fin { A.deallocate[u32](d.alloc, stk_succ, n::usize); }

    var i: u32 = 0;
    for (i < n) {
        visited[i] = false;
        i          = i + 1;
    }

    val post:     *ir_id.BlockId = d.rpo;
    var post_len: u32            = 0;
    stk_block[0] = 0;
    stk_succ[0]  = 0;
    visited[0]   = true;
    var sp: u32 = 1;
    for (sp > 0) {
        val top: u32           = sp - 1;
        val bid: u32           = stk_block[top];
        val si:  u32           = stk_succ[top];
        var s0:  ir_id.BlockId = ir_id.BLOCK_NIL;
        var s1:  ir_id.BlockId = ir_id.BLOCK_NIL;
        val sn:  u32           = me_ir.block_successors(fn, ?fn.blocks[bid], ?s0, ?s1);
        if (si < sn) {
            stk_succ[top] = si + 1;
            var next: ir_id.BlockId = s0;
            if (si == 1) { next = s1; }
            if (!ir_id.block_is_nil(next) && next::u32 < n && !visited[next::u32]) {
                visited[next::u32] = true;
                stk_block[sp]      = next::u32;
                stk_succ[sp]       = 0;
                sp                 = sp + 1;
            }
        }
        or {
            post[post_len] = bid::ir_id.BlockId;
            post_len       = post_len + 1;
            sp             = sp - 1;
        }
    }

    d.rpo_len = post_len;
    var a: u32 = 0;
    for (a < post_len / 2) {
        val tmp: ir_id.BlockId = post[a];
        post[a]                = post[post_len - 1 - a];
        post[post_len - 1 - a] = tmp;
        a                      = a + 1;
    }
    var p: u32 = 0;
    for (p < post_len) {
        d.rpo_index[post[p]::u32] = p;
        p                         = p + 1;
    }
    ret err[fail.Fail].ok{};
}

# the iterative algorithm of Cooper, Harvey and Kennedy over the reverse
# postorder until no immediate dominator changes
fun idom_build(d: *Dominance) {
    d.idom[0] = ir_id.block(0);
    var changed: bool = true;
    for (changed) {
        changed = false;
        var r: u32 = 1;
        for (r < d.rpo_len) {
            val b:        u32 = d.rpo[r]::u32;
            var new_idom: u32 = ir_id.NONE;
            val base:     u32 = d.pred_start[b];
            var pi:       u32 = 0;
            for (pi < d.pred_len[b]) {
                val p: u32 = d.pred_flat[base + pi]::u32;
                if (d.rpo_index[p] != ir_id.NONE && !ir_id.block_is_nil(d.idom[p])) {
                    if (new_idom == ir_id.NONE) { new_idom = p; }
                    or                          { new_idom = intersect(d, p, new_idom); }
                }
                pi = pi + 1;
            }
            if (new_idom != ir_id.NONE && d.idom[b]::u32 != new_idom) {
                d.idom[b] = new_idom::ir_id.BlockId;
                changed   = true;
            }
            r = r + 1;
        }
    }
}

fun intersect(d: *Dominance, b1: u32, b2: u32) u32 {
    var f1: u32 = b1;
    var f2: u32 = b2;
    for (f1 != f2) {
        for (d.rpo_index[f1] > d.rpo_index[f2]) { f1 = d.idom[f1]::u32; }
        for (d.rpo_index[f2] > d.rpo_index[f1]) { f2 = d.idom[f2]::u32; }
    }
    ret f1;
}

# children lists from idom, then one depth-first walk from the entry; a block
# outside the tree gets an empty interval no query can satisfy
fun tree_build(d: *Dominance) err[fail.Fail] {
    val n: u32 = d.block_count;

    val rs: res[*u32, A.Error] = A.allocate[u32](d.alloc, n::usize + 1);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    d.child_start = rs.ok;
    val rc: res[*u32, A.Error] = A.allocate[u32](d.alloc, n::usize);
    if (sel rc.err) { ret err[fail.Fail].err{fail.refused(rc.err)}; }
    d.children = rc.ok;
    val rp: res[*u32, A.Error] = A.allocate[u32](d.alloc, n::usize);
    if (sel rp.err) { ret err[fail.Fail].err{fail.refused(rp.err)}; }
    d.dom_pre = rp.ok;
    val rq: res[*u32, A.Error] = A.allocate[u32](d.alloc, n::usize);
    if (sel rq.err) { ret err[fail.Fail].err{fail.refused(rq.err)}; }
    d.dom_post = rq.ok;
    val frames_len: usize              = (n::usize) * 2;
    val rf:         res[*u32, A.Error] = A.allocate[u32](d.alloc, frames_len);
    if (sel rf.err) { ret err[fail.Fail].err{fail.refused(rf.err)}; }
    fin { A.deallocate[u32](d.alloc, rf.ok, frames_len); }
    val frame_block: *u32 = rf.ok;
    val frame_next:  *u32 = ?rf.ok[n::usize];

    val child_start: *u32 = d.child_start;
    var i:           u32  = 0;
    for (i <= n) {
        child_start[i] = 0;
        i              = i + 1;
    }
    i = 0;
    for (i < n) {
        d.dom_pre[i]  = ir_id.NONE;
        d.dom_post[i] = 0;
        if (in_tree(d, i)) {
            val parent: u32 = d.idom[i]::u32;
            child_start[parent + 1] = child_start[parent + 1] + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        child_start[i + 1] = child_start[i + 1] + child_start[i];
        i                  = i + 1;
    }
    i = 0;
    for (i < n) {
        if (in_tree(d, i)) {
            val parent: u32 = d.idom[i]::u32;
            d.children[child_start[parent]] = i;
            child_start[parent]             = child_start[parent] + 1;
        }
        i = i + 1;
    }
    i = n;
    for (i > 0) {
        child_start[i] = child_start[i - 1];
        i              = i - 1;
    }
    child_start[0] = 0;

    if (d.rpo_index[0] == ir_id.NONE) { ret err[fail.Fail].ok{}; }
    var counter: u32 = 0;
    var depth:   u32 = 1;
    frame_block[0] = 0;
    frame_next[0]  = child_start[0];
    d.dom_pre[0]   = counter;
    counter        = counter + 1;
    for (depth > 0) {
        val v: u32 = frame_block[depth - 1];
        val k: u32 = frame_next[depth - 1];
        if (k < child_start[v + 1]) {
            frame_next[depth - 1] = k + 1;
            val c: u32 = d.children[k];
            d.dom_pre[c]       = counter;
            counter            = counter + 1;
            frame_block[depth] = c;
            frame_next[depth]  = child_start[c];
            depth              = depth + 1;
            cnt;
        }
        d.dom_post[v] = counter;
        counter       = counter + 1;
        depth         = depth - 1;
    }
    ret err[fail.Fail].ok{};
}

fun in_tree(d: *Dominance, b: u32) bool {
    ret b != 0 && d.rpo_index[b] != ir_id.NONE && !ir_id.block_is_nil(d.idom[b]);
}

# the dominance frontiers, built once: a join's frontier walk climbs from each
# reachable predecessor to the join's immediate dominator
pub fun frontiers_build(d: *Dominance) err[fail.Fail] {
    if (d.frontier != nil || d.block_count == 0) { ret err[fail.Fail].ok{}; }
    val n: u32 = d.block_count;

    val rs: res[*u32, A.Error] = A.allocate[u32](d.alloc, n::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    d.frontier_start = rs.ok;
    val rl: res[*u32, A.Error] = A.allocate[u32](d.alloc, n::usize);
    if (sel rl.err) { ret err[fail.Fail].err{fail.refused(rl.err)}; }
    d.frontier_len = rl.ok;

    var b: u32 = 0;
    for (b < n) {
        d.frontier_len[b] = 0;
        b                 = b + 1;
    }
    frontiers_walk(d, false);

    var total: u32 = 0;
    b = 0;
    for (b < n) {
        d.frontier_start[b] = total;
        total               = total + d.frontier_len[b];
        d.frontier_len[b]   = 0;
        b                   = b + 1;
    }
    if (total == 0) { total = 1; }
    val rf: res[*ir_id.BlockId, A.Error] = A.allocate[ir_id.BlockId](d.alloc, total::usize);
    if (sel rf.err) { ret err[fail.Fail].err{fail.refused(rf.err)}; }
    d.frontier     = rf.ok;
    d.frontier_cap = total;
    frontiers_walk(d, true);
    ret err[fail.Fail].ok{};
}

# one pass counts each frontier's bound, the second fills it without repeats
fun frontiers_walk(d: *Dominance, fill: bool) {
    var b: u32 = 0;
    for (b < d.block_count) {
        if (d.rpo_index[b] != ir_id.NONE && d.pred_len[b] >= 2) {
            var pi: u32 = 0;
            for (pi < d.pred_len[b]) {
                var runner: u32 = d.pred_flat[d.pred_start[b] + pi]::u32;
                if (d.rpo_index[runner] != ir_id.NONE) {
                    for (runner != d.idom[b]::u32) {
                        if (fill) { frontier_add(d, runner, b); }
                        or        { d.frontier_len[runner] = d.frontier_len[runner] + 1; }
                        runner = d.idom[runner]::u32;
                        if (runner == ir_id.NONE) { brk; }
                    }
                }
                pi = pi + 1;
            }
        }
        b = b + 1;
    }
}

fun frontier_add(d: *Dominance, node: u32, b: u32) {
    val start: u32 = d.frontier_start[node];
    val len:   u32 = d.frontier_len[node];
    var k:     u32 = 0;
    for (k < len) {
        if (d.frontier[start + k]::u32 == b) { ret; }
        k = k + 1;
    }
    d.frontier[start + len] = b::ir_id.BlockId;
    d.frontier_len[node]    = len + 1;
}
