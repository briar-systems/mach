use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use std.format;

use mach.lang.diagnostic;
use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use mach.lang.source;
use mach.lang.fe.token;

pub fun check_module(m: *ir.Module, itn: *intern.Interner, diags: *diagnostic.DiagnosticStore, alloc: *A.Allocator) R.Result[bool, str] {
    var clean: bool = true;
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        fi = fi + 1;

        if ((fn.flags & ir.FN_FLAG_EXTERN) != 0)    { cnt; }
        if ((fn.flags & ir.FN_FLAG_OBLIVIOUS) != 0) { cnt; }

        val hit: O.Option[*instruction.Instruction] = first_secret_compute(fn);
        if (O.is_none[*instruction.Instruction](hit)) { cnt; }
        val inst: *instruction.Instruction = O.unwrap[*instruction.Instruction](hit);

        val rr: R.Result[R.Void, str] = report(fn, inst, itn, diags, alloc);
        if (R.is_err[R.Void, str](rr)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](rr)); }
        clean = false;
    }
    ret R.ok[bool, str](clean);
}

fun first_secret_compute(fn: *ir.Function) O.Option[*instruction.Instruction] {
    var ii: u32 = 0;
    for (ii < fn.instr_len) {
        val inst: *instruction.Instruction = ?fn.instrs[ii];
        ii = ii + 1;
        if (inst.secret && !opdesc.transfers_secrecy(inst.kind)) {
            ret O.some[*instruction.Instruction](inst);
        }
    }
    ret O.none[*instruction.Instruction]();
}

fun report(fn: *ir.Function, inst: *instruction.Instruction, itn: *intern.Interner, diags: *diagnostic.DiagnosticStore, alloc: *A.Allocator) R.Result[R.Void, str] {
    val name: str = name_of(fn, itn);
    val klass: str = op_class_name(inst.kind);

    var sp: token.Span;
    sp.offset = inst.loc.offset;
    sp.len    = 1;

    val mr: R.Result[str, str] = format.sprint(alloc,
        "`{}` performs a constant-time {} on a secret value but is not declared `#[oblivious]`",
        name, klass);
    if (R.is_err[str, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[str, str](mr)); }
    val msg: str = R.unwrap_ok[str, str](mr);

    val br: R.Result[diagnostic.DiagnosticBuilder, str] = diagnostic.builder_init(alloc, diagnostic.SEVERITY_ERROR, inst.loc.file, sp, msg);
    A.deallocate[u8](alloc, msg::*u8, str_len(msg) + 1);
    if (R.is_err[diagnostic.DiagnosticBuilder, str](br)) { ret R.err[R.Void, str](R.unwrap_err[diagnostic.DiagnosticBuilder, str](br)); }
    var b: diagnostic.DiagnosticBuilder = R.unwrap_ok[diagnostic.DiagnosticBuilder, str](br);

    if ((fn.flags & ir.FN_FLAG_WEAK) != 0) {
        val ir_o: O.Option[str] = intern.lookup(itn, fn.name);
        if (O.is_some[str](ir_o)) {
            val nr: R.Result[str, str] = format.sprint(alloc, "in the instantiation `{}`", O.unwrap[str](ir_o));
            if (R.is_err[str, str](nr)) { diagnostic.builder_dnit(?b); ret R.err[R.Void, str](R.unwrap_err[str, str](nr)); }
            val note: str = R.unwrap_ok[str, str](nr);
            val ar: R.Result[R.Void, str] = diagnostic.attach_note(?b, note);
            A.deallocate[u8](alloc, note::*u8, str_len(note) + 1);
            if (R.is_err[R.Void, str](ar)) { diagnostic.builder_dnit(?b); ret ar; }
        }
    }

    val hr: R.Result[R.Void, str] = diagnostic.attach_help(?b,
        "annotate the function with `#[oblivious]` to declare its constant-time contract; only a function that merely moves or stores secrets may omit it");
    if (R.is_err[R.Void, str](hr)) { diagnostic.builder_dnit(?b); ret hr; }

    val cr: R.Result[diagnostic.DiagnosticId, str] = diagnostic.commit(?b, diags);
    if (R.is_err[diagnostic.DiagnosticId, str](cr)) {
        diagnostic.builder_dnit(?b);
        ret R.err[R.Void, str](R.unwrap_err[diagnostic.DiagnosticId, str](cr));
    }
    ret R.ok_void[str]();
}


fun name_of(fn: *ir.Function, itn: *intern.Interner) str {
    if (fn.disp != intern.STR_NIL) {
        val d: O.Option[str] = intern.lookup(itn, fn.disp);
        if (O.is_some[str](d)) { ret O.unwrap[str](d); }
    }
    if (fn.name != intern.STR_NIL) {
        val n: O.Option[str] = intern.lookup(itn, fn.name);
        if (O.is_some[str](n)) { ret O.unwrap[str](n); }
    }
    ret "<anonymous>";
}

fun op_class_name(k: instruction.InstrKind) str {
    ret opdesc.class_name(k);
}
