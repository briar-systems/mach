use std.types.result.res;
use std.types.option.opt;
use std.types.error.err;
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use std.format;

use mach.lang.diagnostic;
use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use mach.lang.source;
use mach.lang.fe.token;

pub fun check_module(m: *ir.Module, itn: *intern.Interner, diags: *diagnostic.DiagnosticStore, alloc: *A.Allocator) res[bool, fail.Fail] {
    var clean: bool = true;
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        fi = fi + 1;

        if ((fn.flags & ir.FN_FLAG_EXTERN) != 0)    { cnt; }
        if ((fn.flags & ir.FN_FLAG_OBLIVIOUS) != 0) { cnt; }

        val hit: opt[*instruction.Instruction] = first_secret_compute(fn);
        if (sel hit.none) { cnt; }
        val inst: *instruction.Instruction = hit.some;

        val rr: err[fail.Fail] = report(fn, inst, itn, diags, alloc);
        if (sel rr.err) { ret res[bool, fail.Fail].err{rr.err}; }
        clean = false;
    }
    ret res[bool, fail.Fail].ok{clean};
}

fun first_secret_compute(fn: *ir.Function) opt[*instruction.Instruction] {
    var ii: u32 = 0;
    for (ii < fn.instr_len) {
        val inst: *instruction.Instruction = ?fn.instrs[ii];
        ii = ii + 1;
        if (inst.secret && !opdesc.transfers_secrecy(inst.kind)) {
            ret opt[*instruction.Instruction].some{inst};
        }
    }
    ret opt[*instruction.Instruction].none{};
}

fun report(fn: *ir.Function, inst: *instruction.Instruction, itn: *intern.Interner, diags: *diagnostic.DiagnosticStore, alloc: *A.Allocator) err[fail.Fail] {
    val name: str = name_of(fn, itn);
    val klass: str = op_class_name(inst.kind);

    var sp: token.Span;
    sp.offset = inst.loc.offset;
    sp.len    = 1;

    val mr: res[str, format.FormatError] = format.sprint(alloc,
        "`{}` performs a constant-time {} on a secret value but is not declared `#[oblivious]`",
        name, klass);
    if (sel mr.err) { ret err[fail.Fail].err{fail.format_refused(mr.err)}; }
    val msg: str = mr.ok;

    val br: res[diagnostic.DiagnosticBuilder, fail.Fail] = diagnostic.builder_init(alloc, diagnostic.SEVERITY_ERROR, inst.loc.file, sp, msg);
    A.deallocate[u8](alloc, msg::*u8, str_len(msg) + 1);
    if (sel br.err) { ret err[fail.Fail].err{br.err}; }
    var b: diagnostic.DiagnosticBuilder = br.ok;

    if ((fn.flags & ir.FN_FLAG_WEAK) != 0) {
        val ir_o: opt[str] = intern.lookup(itn, fn.name);
        if (sel ir_o.some) {
            val nr: res[str, format.FormatError] = format.sprint(alloc, "in the instantiation `{}`", ir_o.some);
            if (sel nr.err) { diagnostic.builder_dnit(?b); ret err[fail.Fail].err{fail.format_refused(nr.err)}; }
            val note: str = nr.ok;
            val ar: err[fail.Fail] = diagnostic.attach_note(?b, note);
            A.deallocate[u8](alloc, note::*u8, str_len(note) + 1);
            if (sel ar.err) { diagnostic.builder_dnit(?b); ret err[fail.Fail].err{ar.err}; }
        }
    }

    val hr: err[fail.Fail] = diagnostic.attach_help(?b,
        "annotate the function with `#[oblivious]` to declare its constant-time contract; only a function that merely moves or stores secrets may omit it");
    if (sel hr.err) { diagnostic.builder_dnit(?b); ret err[fail.Fail].err{hr.err}; }

    val cr: res[diagnostic.DiagnosticId, fail.Fail] = diagnostic.commit(?b, diags);
    if (sel cr.err) {
        diagnostic.builder_dnit(?b);
        ret err[fail.Fail].err{cr.err};
    }
    ret err[fail.Fail].ok{};
}

fun name_of(fn: *ir.Function, itn: *intern.Interner) str {
    if (fn.disp != intern.STR_NIL) {
        val d: opt[str] = intern.lookup(itn, fn.disp);
        if (sel d.some) { ret d.some; }
    }
    if (fn.name != intern.STR_NIL) {
        val n: opt[str] = intern.lookup(itn, fn.name);
        if (sel n.some) { ret n.some; }
    }
    ret "<anonymous>";
}

fun op_class_name(k: instruction.InstrKind) str {
    ret opdesc.class_name(k);
}
