# the contract every middle-end pass fills. most passes are a visit to one
# function, true when it changed it, beside the functions it skips; the driver
# here walks the module once for them. a pass whose unit is the whole module
# runs over the context instead. each pass declares itself once in its own
# module; the pipeline's schedule decides when it runs, which passes follow it
# and how the module is verified after it
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;

use mach.lang.diagnostic;
use mach.lang.intern;
use mach.lang.me.analysis;
use me_ir: mach.lang.me.ir;
use mach.lang.me.ir.body;
use ir_effect: mach.lang.me.ir.effect;
use mach.lang.me.scratch;
use mach.lang.target.resolved;

# what a pass reads besides its own code: every pass takes the same record and
# reads only what it needs
pub rec Context {
    module: *me_ir.Module;
    target: *resolved.Target;
    # names the globals and helpers a pass synthesizes; nil names none
    interner: *intern.Interner;
    # the bodies other modules offer for inlining; nil offers none
    available: *body.Available;
    # the bounded per-function scratch every pass of one run shares
    workspace: *scratch.Workspace;
    # the analyses a pass requests rather than computes, the workspace's
    analyses: *analysis.Cache;
    # where a check reports a refusal or a warning at its site
    diags: *diagnostic.DiagnosticStore;
    # the build's `simd = "require"` setting and the departures from exact
    # semantics it permits
    simd_require: bool;
    relax:        Relax;
}

# the one function a visit is given
pub rec Function {
    context: *Context;
    module:  *me_ir.Module;
    target:  *resolved.Target;
    body:    *me_ir.Function;
    # the body's place in the module's function table; a visit that appends a
    # function re-reads its body through it, since the table may move
    index: u32;
    # the run's analyses, which the body's are requested from
    analyses: *analysis.Cache;
}

# a pass over `ctx.module` as a whole, true when it changed it
pub def Run: fun(*Context) res[bool, fail.Fail];

# a pass over one function, true when it changed it; `alloc` is the workspace,
# reclaimed after every visit
pub def Visit: fun(*Function, *A.Allocator) res[bool, fail.Fail];

# whether a pass applies to a run
pub def Gate: fun(*Context) bool;

# whether a pass visits a function its skip flags leave in
pub def Filter: fun(*Function) bool;

# the functions a visiting pass skips, as flags
pub val SKIP_EXTERN:    u32 = 0x01;
pub val SKIP_EMPTY:     u32 = 0x02;
pub val SKIP_NO_INSTRS: u32 = 0x04;
pub val SKIP_VOLATILE:  u32 = 0x08;
pub val SKIP_SCALAR:    u32 = 0x10;
pub val SKIP_OBLIVIOUS: u32 = 0x20;

# whether a build may leave a pass out
pub def Class: u8;

# a rewrite every build needs, whatever it optimizes: never skipped
pub val CLASS_LEGALIZATION: Class = 0;
# a rewrite that only improves the code: `optimize` selects it, `pass` adds it
# and `skip` removes it
pub val CLASS_OPTIMIZATION: Class = 1;

# what a class is called where a build names it
pub fun class_name(c: Class) str {
    if (c == CLASS_OPTIMIZATION) { ret "optimization"; }
    ret "legalization";
}

# the departures from exact semantics a build permits, one bit each
pub def Relax: u32;

pub val RELAX_NONE: Relax = 0;
# floating-point additions and multiplications may be reassociated, as a
# vector reduction does
pub val RELAX_FLOAT_REASSOC: Relax = 1;

# one permission a `relax` set may name
# ---
# relax: its bit
# name:  as a manifest and the command line write it
rec RelaxRow {
    relax: Relax;
    name:  str;
}

val RELAX_COUNT: usize                 = 1;
val RELAXATIONS: [RELAX_COUNT]RelaxRow = [RELAX_COUNT]RelaxRow{
    RelaxRow{relax: RELAX_FLOAT_REASSOC, name: "float-reassoc"},
};

# the permission `name` names, none for a name no row declares
pub fun relax_named(name: str) opt[Relax] {
    var i: usize = 0;
    for (i < RELAX_COUNT) {
        if (str_equals(RELAXATIONS[i].name, name)) { ret opt[Relax].some{RELAXATIONS[i].relax}; }
        i = i + 1;
    }
    ret opt[Relax].none{};
}

# how many permissions a `relax` set may name
pub fun relax_count() usize {
    ret RELAX_COUNT;
}

# the name of permission `i`, in declaration order
pub fun relax_name_at(i: usize) str {
    ret RELAXATIONS[i].name;
}

# a member of the contract: `visit` with its eligibility, or `run`
pub rec Pass {
    # the public name a build and `mach info passes` call it by, unique in the
    # schedule
    name:  str;
    class: Class;
    # nil for a pass that visits functions
    run: Run;
    # nil applies to every run
    applies: Gate;
    # the analysis kinds every run of the pass leaves valid, whatever it
    # changed; the schedule drops the others once it has run
    preserves: analysis.KindSet;
    # nil for a pass over the whole module
    visit: Visit;
    skips: u32;
    # nil visits every function the skip flags leave in
    eligible: Filter;
    # the most visits one function gets while each changes it, at least one
    rounds: u32;
}

# a context over `m` for `tgt` sharing `workspace`, offering nothing else, with
# every setting off
pub fun context(m: *me_ir.Module, tgt: *resolved.Target, workspace: *scratch.Workspace) Context {
    var ctx: Context;
    ctx.module       = m;
    ctx.target       = tgt;
    ctx.interner     = nil;
    ctx.available    = nil;
    ctx.workspace    = workspace;
    ctx.analyses     = ?workspace.analyses;
    ctx.diags        = nil;
    ctx.simd_require = false;
    ctx.relax        = RELAX_NONE;
    ret ctx;
}

# whether `p` applies to the run `ctx` describes
pub fun applies(p: *Pass, ctx: *Context) bool {
    ret p.applies == nil || p.applies(ctx);
}

# `p` over `ctx` when it applies; false when it does not
pub fun run(p: *Pass, ctx: *Context) res[bool, fail.Fail] {
    if (!applies(p, ctx)) { ret res[bool, fail.Fail].ok{false}; }
    if (p.visit == nil)   { ret p.run(ctx); }
    ret each_function(p, ctx);
}

# whether `p` visits the function `f` names
fun visits(p: *Pass, f: *Function) bool {
    val fn: *me_ir.Function = f.body;
    if ((p.skips & SKIP_EXTERN) != 0 && (fn.flags & me_ir.FN_FLAG_EXTERN) != 0)       { ret false; }
    if ((p.skips & SKIP_EMPTY) != 0 && fn.block_count == 0)                           { ret false; }
    if ((p.skips & SKIP_NO_INSTRS) != 0 && fn.instr_len == 0)                         { ret false; }
    if ((p.skips & SKIP_SCALAR) != 0 && (fn.flags & me_ir.FN_FLAG_SCALAR) != 0)       { ret false; }
    if ((p.skips & SKIP_OBLIVIOUS) != 0 && (fn.flags & me_ir.FN_FLAG_OBLIVIOUS) != 0) { ret false; }
    if ((p.skips & SKIP_VOLATILE) != 0 && ir_effect.function_has_volatile(fn))        { ret false; }
    ret p.eligible == nil || p.eligible(f);
}

# every function `p` visits, each in its own window of the workspace; the
# functions a visit appends are never visited
fun each_function(p: *Pass, ctx: *Context) res[bool, fail.Fail] {
    val m:       *me_ir.Module = ctx.module;
    val count:   u32           = m.function_len;
    var changed: bool          = false;
    var fi:      u32           = 0;
    for (fi < count) {
        var f: Function = Function{context: ctx, module: m, target: ctx.target, body: ?m.functions[fi], index: fi, analyses: ctx.analyses};
        if (visits(p, ?f)) {
            var round: u32  = 0;
            var more:  bool = true;
            for (more && round < p.rounds) {
                val r: res[bool, fail.Fail] = scratch.run[Function, bool](ctx.workspace, m.alloc, ?f, p.visit);
                if (sel r.err) { ret r; }
                more = r.ok;
                if (more) { changed = true; }
                round = round + 1;
            }
        }
        fi = fi + 1;
    }
    ret res[bool, fail.Fail].ok{changed};
}

# `p` alone over `m` for `tgt`, in a workspace of its own
#[testing]
pub fun run_alone(p: *Pass, m: *me_ir.Module, tgt: *resolved.Target) res[bool, fail.Fail] {
    var ctx: Context = context(m, tgt, nil);
    ret run_owned(p, ?ctx);
}

# `p` over `ctx` in a workspace of its own
#[testing]
pub fun run_owned(p: *Pass, ctx: *Context) res[bool, fail.Fail] {
    var workspace:   scratch.Workspace;
    val initialized: err[fail.Fail] = scratch.init(?workspace, ctx.module.backing);
    if (sel initialized.err) { ret res[bool, fail.Fail].err{initialized.err}; }
    fin { scratch.dnit(?workspace); }
    val previous: *scratch.Workspace = ctx.workspace;
    ctx.workspace = ?workspace;
    ctx.analyses  = ?workspace.analyses;
    fin {
        ctx.workspace = previous;
        ctx.analyses  = ?previous.analyses;
    }
    ret run(p, ctx);
}
