# what a build declares about linkage, owned by the build's project and read
# by the lowering that names declarations and the linker that binds imports:
# each declaration's export name and library, the name each declaration links
# under once the lowering has named it, and the library each imported symbol is
# pinned to
use std.collections.map;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.intern;
use mach.lang.module;

# what the build knows an imported symbol to be
pub def Sort: u8;

# nothing, as of a name a manifest entry claims for an archive
pub val UNSTATED: Sort = 0;
# a function, as an `ext fun` declares
pub val CODE: Sort = 1;
# a variable, as an `ext val` or `ext var` declares
pub val DATA: Sort = 2;

# an imported symbol pinned to a library
# ---
# name: its link name
# lib:  the library's key
# sort: what the build knows it to be
pub rec Import {
    name: intern.StrId;
    lib:  intern.StrId;
    sort: Sort;
}

# keyed by declaration: a module's index in the high 32 bits, its declaration
# index in the low
# imports holds every pinned import in the order it was first pinned, and import_at its index
# there by link name
pub rec Linkage {
    export_names:     map.Map[u64, intern.StrId];
    names:            map.Map[u64, intern.StrId];
    export_libraries: map.Map[u64, intern.StrId];
    imports:          Vector[Import];
    import_at:        map.Map[intern.StrId, usize];
}

pub fun init(alloc: *A.Allocator) Linkage {
    ret Linkage{
        export_names:     map.init[u64, intern.StrId](alloc),
        names:            map.init[u64, intern.StrId](alloc),
        export_libraries: map.init[u64, intern.StrId](alloc),
        imports:          collections_vector.init[Import](alloc),
        import_at:        map.init[intern.StrId, usize](alloc)
    };
}

pub fun dnit(l: *Linkage) {
    map.dnit[u64, intern.StrId](?l.export_names);
    map.dnit[u64, intern.StrId](?l.names);
    map.dnit[u64, intern.StrId](?l.export_libraries);
    collections_vector.dnit[Import](?l.imports);
    map.dnit[intern.StrId, usize](?l.import_at);
}

# forget every declaration and import, as a project does when its
# module registry is reset
pub fun clear(l: *Linkage) {
    map.clear[u64, intern.StrId](?l.export_names);
    map.clear[u64, intern.StrId](?l.names);
    map.clear[u64, intern.StrId](?l.export_libraries);
    collections_vector.truncate[Import](?l.imports, 0);
    map.clear[intern.StrId, usize](?l.import_at);
}

fun declaration(mid: module.ModuleId, did: u32) u64 {
    ret (module.index(mid)::u64 << 32) | did::u64;
}

fun name_of(table: *map.Map[u64, intern.StrId], key: u64) intern.StrId {
    val got: opt[*intern.StrId] = map.get[u64, intern.StrId](table, ?key);
    if (sel got.some) { ret @got.some; }
    ret intern.STR_NIL;
}

pub fun register_export_name(l: *Linkage, mid: module.ModuleId, did: u32, name: intern.StrId) err[fail.Fail] {
    val inserted: res[bool, A.Error] = map.insert[u64, intern.StrId](?l.export_names, declaration(mid, did), name);
    if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
    ret err[fail.Fail].ok{};
}

# drop every export name and linkage name of one module's declarations, before
# its syntax tree is replaced and its declaration ids no longer name the same
# declarations
# ---
# mid:        the module whose names go
# decl_count: the declaration count of the syntax tree they were registered against
pub fun forget_names(l: *Linkage, mid: module.ModuleId, decl_count: u32) {
    var did: u32 = 0;
    for (did < decl_count) {
        var key: u64 = declaration(mid, did);
        map.remove[u64, intern.StrId](?l.export_names, ?key);
        map.remove[u64, intern.StrId](?l.names, ?key);
        did = did + 1;
    }
}

# the name declaration `did` of `mid` is exported under, nil when it names none
pub fun export_name(l: *Linkage, mid: module.ModuleId, did: u32) intern.StrId {
    ret name_of(?l.export_names, declaration(mid, did));
}

# record the name declaration `did` of `mid` links under, as the lowering
# first names it
pub fun register_name(l: *Linkage, mid: module.ModuleId, did: u32, name: intern.StrId) err[fail.Fail] {
    val inserted: res[bool, A.Error] = map.insert[u64, intern.StrId](?l.names, declaration(mid, did), name);
    if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
    ret err[fail.Fail].ok{};
}

# the name declaration `did` of `mid` links under, nil before the lowering has named it
pub fun name(l: *Linkage, mid: module.ModuleId, did: u32) intern.StrId {
    ret name_of(?l.names, declaration(mid, did));
}

pub fun register_export_library(l: *Linkage, mid: module.ModuleId, did: u32, lib: intern.StrId) err[fail.Fail] {
    val inserted: res[bool, A.Error] = map.insert[u64, intern.StrId](?l.export_libraries, declaration(mid, did), lib);
    if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
    ret err[fail.Fail].ok{};
}

# the library declaration `did` of `mid` is imported from, nil when it names none
pub fun export_library(l: *Linkage, mid: module.ModuleId, did: u32) intern.StrId {
    ret name_of(?l.export_libraries, declaration(mid, did));
}

# pin the imported symbol `name`, known as `sort`, to the library `lib`. a symbol pinned
# again takes the later pin, a sort the earlier one left unstated included
pub fun register_import_library(l: *Linkage, name: intern.StrId, lib: intern.StrId, sort: Sort) err[fail.Fail] {
    val known: opt[*usize] = map.get[intern.StrId, usize](?l.import_at, ?name);
    if (sel known.some) {
        val held: *Import = ?l.imports.data[@known.some];
        held.lib = lib;
        if (sort != UNSTATED) { held.sort = sort; }
        ret err[fail.Fail].ok{};
    }
    val at:     usize               = l.imports.len;
    val pushed: res[usize, A.Error] = collections_vector.push[Import](?l.imports, Import{name: name, lib: lib, sort: sort});
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    val indexed: res[bool, A.Error] = map.insert[intern.StrId, usize](?l.import_at, name, at);
    if (sel indexed.err) {
        collections_vector.truncate[Import](?l.imports, at);
        ret err[fail.Fail].err{fail.refused(indexed.err)};
    }
    ret err[fail.Fail].ok{};
}

# the library the imported symbol `name` is pinned to, nil when it is pinned to none
pub fun import_library(l: *Linkage, name: intern.StrId) intern.StrId {
    val got: opt[*usize] = map.get[intern.StrId, usize](?l.import_at, ?name);
    if (sel got.some) { ret l.imports.data[@got.some].lib; }
    ret intern.STR_NIL;
}
