# the compiler's allocation layer: the std allocator surface under one import,
# and the refusal rendered once. an allocation refusal is not something the
# compiler recovers from at the site that met it; it is reported through the
# failure domains (fail.refused, outcome.refused) and the build stops. the
# text is presentation only and no site branches on it.
use std.types.string.str;
use std.types.string.str_equals;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.canonical.err;

use A: std.allocator;
use T: std.allocator.testing;
use page: std.allocator.page;
use std.types.canonical.res;
use std.types.size.usize;

fwd A.Allocator;
fwd A.Error;
fwd A.allocate;
fwd A.zallocate;
fwd A.reallocate;
fwd A.deallocate;

# a unit outcome read where only the yes/no matters (a call operand cannot be
# a `sel` place)
pub fun refused(r: err[A.Error]) bool { ret sel r.err; }

# the refusal as text: `exhausted` is the message the compiler has always
# reported, the other cases name the contract fault they are
pub fun text(e: A.Error) str {
    if (sel e.exhausted) { ret "out of memory"; }
    if (sel e.overflow)  { ret "allocation size overflow"; }
    if (sel e.invalid)   { ret "invalid allocator or alignment"; }
    ret "deallocate failed";
}

test "mach.lang.alloc:each_refusal_has_its_own_text" {
    if (!str_equals(text(A.Error.exhausted{}), "out of memory")) { ret 1; }
    if (!str_equals(text(A.Error.overflow{}), "allocation size overflow")) { ret 2; }
    if (!str_equals(text(A.Error.invalid{}), "invalid allocator or alignment")) { ret 3; }
    if (!str_equals(text(A.Error.release{-1}), "deallocate failed")) { ret 4; }
    ret 0;
}

fun t_exhausted(r: res[*u64, A.Error]) bool {
    if (!sel r.err) { ret false; }
    ret sel r.err.exhausted;
}

fun t_layer_attempt(ordinal: usize, attempts: *usize) i32 {
    var t: T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?t); }
    val a: *A.Allocator = T.allocator_of(?t);
    T.fail_at_ordinal(?t, ordinal);
    val first: res[*u64, A.Error] = allocate[u64](a, 8);
    var second: res[*u64, A.Error] = res[*u64, A.Error].err{A.Error.invalid{}};
    if (sel first.ok) { second = reallocate[u64](a, first.ok, 8, 16); }
    @attempts = T.attempt_count(?t);
    var bad: i32 = 0;
    if (ordinal == 0) {
        if (sel first.err) { bad = 2; }
        if (sel second.ok) {
            val released: err[A.Error] = deallocate[u64](a, second.ok, 16);
            if (refused(released)) { bad = 4; }
        }
        or { bad = 3; }
    }
    or {
        if (sel first.ok) {
            if (!t_exhausted(second)) { bad = 6; }
            deallocate[u64](a, first.ok, 8);
        }
        or (!t_exhausted(first)) { bad = 5; }
    }
    if (T.leaked(?t) || T.double_free_count(?t) != 0 || T.tracking_exhausted(?t)) { bad = 7; }
    ret bad;
}

# the layer forwards std's contract unchanged: a refusal at any ordinal is
# `exhausted`, the allocation it refused does not exist, and the ones before
# it are still the caller's to release
test "mach.lang.alloc:refusal_leaves_prior_allocations_owned" {
    var attempts: usize = 0;
    val baseline: i32 = t_layer_attempt(0, ?attempts);
    if (baseline != 0 || attempts != 2) { ret 1; }
    var ordinal: usize = 1;
    for (ordinal <= attempts) {
        var refused_at: usize = 0;
        val code: i32 = t_layer_attempt(ordinal, ?refused_at);
        if (code != 0) { ret code + 1; }
        ordinal = ordinal + 1;
    }
    ret 0;
}

test "mach.lang.alloc:contract_faults_and_the_unit_predicate" {
    val none: res[*u8, A.Error] = allocate[u8](nil, 4);
    if (!sel none.err) { ret 1; }
    if (!sel none.err.invalid) { ret 2; }
    var a: A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret 3; }
    val empty: res[*u8, A.Error] = allocate[u8](?a, 0);
    if (!sel empty.ok) { ret 4; }
    if (empty.ok != nil) { ret 5; }
    val released: err[A.Error] = deallocate[u8](?a, nil, 0);
    if (refused(released)) { ret 6; }
    val refusal: err[A.Error] = err[A.Error].err{A.Error.exhausted{}};
    if (!refused(refusal)) { ret 7; }
    ret 0;
}
