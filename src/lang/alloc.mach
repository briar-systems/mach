# the compiler's allocation layer: the std allocator surface under one import,
# and the refusal rendered once. an allocation refusal is not something the
# compiler recovers from at the site that met it; it is reported through the
# failure domains (fail.refused, outcome.refused) and the build stops. the
# text is presentation only and no site branches on it.
use std.types.string.str;
use std.types.string.str_equals;
use std.types.bool.bool;
use std.types.canonical.err;

use A: std.allocator;

fwd A.Allocator;
fwd A.Error;
fwd A.allocate;
fwd A.zallocate;
fwd A.reallocate;
fwd A.deallocate;

# a unit outcome read where only the yes/no matters (a call operand cannot be
# a `sel` place)
pub fun refused(r: err[A.Error]) bool { ret sel r.err; }

# the refusal as text: `exhausted` is the message the compiler has always
# reported, the other cases name the contract fault they are
pub fun text(e: A.Error) str {
    if (sel e.exhausted) { ret "out of memory"; }
    if (sel e.overflow)  { ret "allocation size overflow"; }
    if (sel e.invalid)   { ret "invalid allocator or alignment"; }
    ret "deallocate failed";
}

test "mach.lang.alloc:each_refusal_has_its_own_text" {
    if (!str_equals(text(A.Error.exhausted{}), "out of memory")) { ret 1; }
    if (!str_equals(text(A.Error.overflow{}), "allocation size overflow")) { ret 2; }
    if (!str_equals(text(A.Error.invalid{}), "invalid allocator or alignment")) { ret 3; }
    if (!str_equals(text(A.Error.release{-1}), "deallocate failed")) { ret 4; }
    ret 0;
}
