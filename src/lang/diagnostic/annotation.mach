use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use lang_source: mach.lang.source;

# what a report names beyond its own location, shared by a failure and a diagnostic: the other
# places it concerns and the machine-applicable rewrites that clear it. each place is a span of a
# file of the source map the report was raised against

# another place a report concerns: the other edge of a cycle, the other claim of a collision
# ---
# loc:   where it is
# label: what it is, nil to show the place without one
pub rec Related {
    loc:   lang_source.Location;
    label: str;
}

# one rewrite of a fix: the bytes at `loc` become `replacement`
pub rec Edit {
    loc:         lang_source.Location;
    replacement: str;
}

# a machine-applicable rewrite of the input, applied whole
# ---
# label: what the rewrite does, as a fix line names it; nil is no fix
# edits: the rewrites, none overlapping another
pub rec Fix {
    label: str;
    edits: Vector[Edit];
}

# a fix carrying no rewrite
pub fun fix_none() Fix {
    ret Fix{label: nil, edits: collections_vector.init[Edit](nil)};
}

# whether the fix carries a rewrite
pub fun fix_present(fx: *Fix) bool {
    ret fx.label != nil;
}

# release a related place's label, allocated through `a`
pub fun related_dnit(a: *A.Allocator, r: *Related) {
    if (r.label != nil) { str_free(a, r.label); }
}

# release a fix's label, each edit's replacement and the edit storage, allocated through `a`
pub fun fix_dnit(a: *A.Allocator, fx: *Fix) {
    if (fx.label != nil) { str_free(a, fx.label); }
    var e: usize = 0;
    for (e < fx.edits.len) {
        if (fx.edits.data[e].replacement != nil) { str_free(a, fx.edits.data[e].replacement); }
        e = e + 1;
    }
    collections_vector.dnit[Edit](?fx.edits);
}

# a copy of `src` owning its label, its edits and their replacements through `a`, released with
# `fix_dnit`
pub fun fix_copy(src: *Fix, a: *A.Allocator) res[Fix, A.Error] {
    var out: Fix = fix_none();
    if (src.label == nil) { ret res[Fix, A.Error].ok{out}; }
    out.edits = collections_vector.init[Edit](a);
    var complete: bool = false;
    fin {
        if (!complete) { fix_dnit(a, ?out); }
    }
    val label: res[str, A.Error] = str_dup(a, src.label);
    if (sel label.err) { ret res[Fix, A.Error].err{label.err}; }
    out.label = label.ok;
    var e: usize = 0;
    for (e < src.edits.len) {
        var ed: Edit = src.edits.data[e];
        if (ed.replacement != nil) {
            val rep: res[str, A.Error] = str_dup(a, ed.replacement);
            if (sel rep.err) { ret res[Fix, A.Error].err{rep.err}; }
            ed.replacement = rep.ok;
        }
        val pushed: res[usize, A.Error] = collections_vector.push[Edit](?out.edits, ed);
        if (sel pushed.err) {
            if (ed.replacement != nil) { str_free(a, ed.replacement); }
            ret res[Fix, A.Error].err{pushed.err};
        }
        e = e + 1;
    }
    complete = true;
    ret res[Fix, A.Error].ok{out};
}
