    Spec{kind: EXT_VARIADIC_BODY, key: "ext.variadic_body", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: EXT_DATA_INITIALIZER, key: "ext.data_initializer", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: PACK_BODYLESS, key: "pack.bodyless", level: LEVEL_ERROR, source: false, retired: false},
