# the named diagnostic kinds
#
# one closed table, and the only place a kind is declared. every warning names
# its row when it is raised, and each row carries a dotted key named by the
# subject it concerns: the renderer prints it, a profile's `allow` and a
# declaration's `#[expect]` select by it. a key's leading components name a
# family, so `vector` selects every key under `vector.`. a key is never reused
# for a different kind, and a retired kind keeps its key reserved. only a
# warning row can be silenced or expected; an error row is keyed so that it
# prints its key, and a selection naming it is refused rather than read as
# unknown
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

pub def Kind: u8;

pub def Level: u8;

pub val LEVEL_WARNING: Level = 0;
pub val LEVEL_ERROR:   Level = 1;

# a diagnostic that names no row: an error or note not yet given a kind
pub val NONE: Kind = 0;

pub val UNUSED_IMPORT:         Kind = 1;
pub val DEPRECATED:            Kind = 2;
pub val DOCLINT:               Kind = 3;
pub val FWD_INSTANCES:         Kind = 4;
pub val DEBUG_DROPPED:         Kind = 5;
pub val TARGET_SKIPPED:        Kind = 6;
pub val NATIVE_FALLBACK:       Kind = 7;
pub val NOT_OBLIVIOUS:         Kind = 8;
pub val INEXACT_FLOAT_LITERAL: Kind = 9;
pub val SCALARIZE:             Kind = 10;
pub val EXPECT_UNFULFILLED:    Kind = 11;

# key:    the dotted key the kind is printed and selected by
# source: the kind is decided by the source alone, whatever the target, goal or
#         profile, so an `#[expect]` of it that nothing fulfils is reported
pub rec Spec {
    kind:   Kind;
    key:    str;
    level:  Level;
    source: bool;
}

pub val COUNT: usize       = 11;
val     KINDS: [COUNT]Spec = [COUNT]Spec{
    Spec{kind: UNUSED_IMPORT, key: "import.unused", level: LEVEL_WARNING, source: true},
    Spec{kind: DEPRECATED, key: "decl.deprecated", level: LEVEL_WARNING, source: true},
    Spec{kind: DOCLINT, key: "doc.lint", level: LEVEL_WARNING, source: true},
    Spec{kind: FWD_INSTANCES, key: "fwd.instances", level: LEVEL_WARNING, source: false},
    Spec{kind: DEBUG_DROPPED, key: "debug.dropped", level: LEVEL_WARNING, source: false},
    Spec{kind: TARGET_SKIPPED, key: "target.skipped", level: LEVEL_WARNING, source: false},
    Spec{kind: NATIVE_FALLBACK, key: "target.native_fallback", level: LEVEL_WARNING, source: false},
    Spec{kind: INEXACT_FLOAT_LITERAL, key: "float.inexact", level: LEVEL_WARNING, source: true},
    Spec{kind: NOT_OBLIVIOUS, key: "secret.not_oblivious", level: LEVEL_ERROR, source: false},
    Spec{kind: SCALARIZE, key: "vector.scalarize", level: LEVEL_WARNING, source: false},
    Spec{kind: EXPECT_UNFULFILLED, key: "expect.unfulfilled", level: LEVEL_WARNING, source: false},
};

# the row at `i` in declaration order, nil past the end
pub fun at(i: usize) *Spec {
    if (i >= COUNT) { ret nil; }
    ret ?KINDS[i];
}

# the row of `k`, nil for NONE or a kind no row declares
pub fun spec(k: Kind) *Spec {
    var i: usize = 0;
    for (i < COUNT) {
        if (KINDS[i].kind == k) { ret ?KINDS[i]; }
        i = i + 1;
    }
    ret nil;
}

# the key of `k`, nil for NONE or a kind no row declares
pub fun key_of(k: Kind) str {
    val row: *Spec = spec(k);
    if (row == nil) { ret nil; }
    ret row.key;
}

# the kind whose key is exactly `key`
pub fun named(key: str) opt[Kind] {
    var i: usize = 0;
    for (i < COUNT) {
        if (str_equals(KINDS[i].key, key)) { ret opt[Kind].some{KINDS[i].kind}; }
        i = i + 1;
    }
    ret opt[Kind].none{};
}

# a key or a family covers a row when it is the row's key or a whole leading
# run of its components: `vector` covers `vector.scalarize`, `vec` covers nothing
fun covers(selector: str, key: str) bool {
    val n: usize = str_len(selector);
    if (n == 0 || !str_starts_with(key, selector)) { ret false; }
    ret str_len(key) == n || key[n] == '.';
}

# a set of kinds, one bit for every value a Kind can hold
pub rec KindSet {
    words: [4]u64;
}

pub fun set_empty() KindSet {
    var s: KindSet;
    s.words[0] = 0;
    s.words[1] = 0;
    s.words[2] = 0;
    s.words[3] = 0;
    ret s;
}

pub fun set_add(s: *KindSet, k: Kind) {
    s.words[(k >> 6)::usize] = s.words[(k >> 6)::usize] | (1::u64 << (k & 63)::u64);
}

pub fun set_has(s: *KindSet, k: Kind) bool {
    ret (s.words[(k >> 6)::usize] & (1::u64 << (k & 63)::u64)) != 0;
}

pub fun set_union(s: *KindSet, other: *KindSet) {
    var i: usize = 0;
    for (i < 4) {
        s.words[i] = s.words[i] | other.words[i];
        i          = i + 1;
    }
}

# what one key or family selects from the table
#
# warnings: the warning rows it covers
# errors:   how many error rows it covers
# source:   a covered warning row is decided by the source alone
pub rec Selection {
    warnings: KindSet;
    errors:   usize;
    source:   bool;
}

# the rows `selector` covers; nothing at all when it is unknown
pub fun select(selector: str) Selection {
    var s: Selection;
    s.warnings = set_empty();
    s.errors   = 0;
    s.source   = false;
    var i: usize = 0;
    for (i < COUNT) {
        if (covers(selector, KINDS[i].key)) {
            if (KINDS[i].level == LEVEL_WARNING) {
                set_add(?s.warnings, KINDS[i].kind);
                if (KINDS[i].source) { s.source = true; }
            }
            or { s.errors = s.errors + 1; }
        }
        i = i + 1;
    }
    ret s;
}

# the selection covers no row
pub fun selection_unknown(s: *Selection) bool {
    ret s.errors == 0 && selection_empty(s);
}

# the selection covers no warning row
pub fun selection_empty(s: *Selection) bool {
    ret s.warnings.words[0] == 0 && s.warnings.words[1] == 0 && s.warnings.words[2] == 0 && s.warnings.words[3] == 0;
}

test table__rows_are_distinct_and_keyed {
    var i: usize = 0;
    for (i < COUNT) {
        if (KINDS[i].kind == NONE)            { ret 1; }
        if (spec(KINDS[i].kind) != ?KINDS[i]) { ret 2; }
        val back: opt[Kind] = named(KINDS[i].key);
        if (!(sel back.some && back.some == KINDS[i].kind)) { ret 3; }
        # a key is dotted, and no key is a family of another
        if (!covers(KINDS[i].key, KINDS[i].key) || KINDS[i].key[0] == '.') { ret 4; }
        var dotted: bool  = false;
        var c:      usize = 0;
        for (c < str_len(KINDS[i].key)) {
            if (KINDS[i].key[c] == '.') { dotted = true; }
            c = c + 1;
        }
        if (!dotted) { ret 5; }
        var j: usize = 0;
        for (j < COUNT) {
            if (j != i && covers(KINDS[i].key, KINDS[j].key)) { ret 6; }
            j = j + 1;
        }
        i = i + 1;
    }
    if (spec(NONE) != nil) { ret 7; }
    val unknown: opt[Kind] = named("no.such.kind");
    if (sel unknown.some) { ret 8; }
    ret 0;
}

# a family covers whole components only, and an error row is counted apart
test select__families_cover_whole_components {
    var vector: Selection = select("vector");
    if (!set_has(?vector.warnings, SCALARIZE) || vector.errors != 0 || vector.source) { ret 1; }
    var exact: Selection = select("vector.scalarize");
    if (!set_has(?exact.warnings, SCALARIZE)) { ret 2; }
    var partial: Selection = select("vec");
    if (!selection_unknown(?partial)) { ret 3; }
    var target: Selection = select("target");
    if (!set_has(?target.warnings, TARGET_SKIPPED) || !set_has(?target.warnings, NATIVE_FALLBACK)) { ret 4; }
    var secret: Selection = select("secret.not_oblivious");
    if (secret.errors != 1 || !selection_empty(?secret) || selection_unknown(?secret)) { ret 5; }
    var doc: Selection = select("doc");
    if (!doc.source) { ret 6; }
    var none: Selection = select("");
    if (!selection_unknown(?none)) { ret 7; }
    ret 0;
}

test set__holds_exactly_what_was_added {
    var s: KindSet = set_empty();
    set_add(?s, UNUSED_IMPORT);
    set_add(?s, 255::Kind);
    if (!set_has(?s, UNUSED_IMPORT)) { ret 1; }
    if (!set_has(?s, 255::Kind))     { ret 2; }
    if (set_has(?s, DEPRECATED))     { ret 3; }
    if (set_has(?s, NONE))           { ret 4; }
    ret 0;
}
