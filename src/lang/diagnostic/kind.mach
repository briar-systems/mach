# the named diagnostic kinds
#
# one closed table, and the only place a kind is declared. every warning names
# its row when it is raised, and a profile's `allow` list silences warnings by
# the row's name, so the name is a stable spelling a manifest carries: a row is
# never renamed, and a retired kind keeps its name reserved. only a warning
# row can be silenced; an error row is named so that a list naming it is
# refused rather than read as unknown
use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

pub def Kind: u8;

pub def Level: u8;

pub val LEVEL_WARNING: Level = 0;
pub val LEVEL_ERROR:   Level = 1;

# a diagnostic that names no row: an error or note not yet given a kind
pub val NONE: Kind = 0;

pub val UNUSED_IMPORT:   Kind = 1;
pub val DEPRECATED:      Kind = 2;
pub val DOCLINT:         Kind = 3;
pub val FWD_INSTANCES:   Kind = 4;
pub val DEBUG_DROPPED:   Kind = 5;
pub val TARGET_SKIPPED:  Kind = 6;
pub val NATIVE_FALLBACK: Kind = 7;
pub val NOT_OBLIVIOUS:   Kind = 8;
pub val SCALARIZE:       Kind = 9;

pub rec Spec {
    kind:  Kind;
    name:  str;
    level: Level;
}

pub val COUNT: usize       = 9;
val     KINDS: [COUNT]Spec = [COUNT]Spec{
    Spec{kind: UNUSED_IMPORT, name: "unused-import", level: LEVEL_WARNING},
    Spec{kind: DEPRECATED, name: "deprecated", level: LEVEL_WARNING},
    Spec{kind: DOCLINT, name: "doclint", level: LEVEL_WARNING},
    Spec{kind: FWD_INSTANCES, name: "fwd-instances", level: LEVEL_WARNING},
    Spec{kind: DEBUG_DROPPED, name: "debug-dropped", level: LEVEL_WARNING},
    Spec{kind: TARGET_SKIPPED, name: "target-skipped", level: LEVEL_WARNING},
    Spec{kind: NATIVE_FALLBACK, name: "native-fallback", level: LEVEL_WARNING},
    Spec{kind: NOT_OBLIVIOUS, name: "not-oblivious", level: LEVEL_ERROR},
    Spec{kind: SCALARIZE, name: "scalarize", level: LEVEL_WARNING},
};

# the row at `i` in declaration order, nil past the end
pub fun at(i: usize) *Spec {
    if (i >= COUNT) { ret nil; }
    ret ?KINDS[i];
}

# the row of `k`, nil for NONE or a kind no row declares
pub fun spec(k: Kind) *Spec {
    var i: usize = 0;
    for (i < COUNT) {
        if (KINDS[i].kind == k) { ret ?KINDS[i]; }
        i = i + 1;
    }
    ret nil;
}

# the kind a manifest spells as `name`
pub fun named(name: str) opt[Kind] {
    var i: usize = 0;
    for (i < COUNT) {
        if (str_equals(KINDS[i].name, name)) { ret opt[Kind].some{KINDS[i].kind}; }
        i = i + 1;
    }
    ret opt[Kind].none{};
}

# a set of kinds, one bit for every value a Kind can hold
pub rec KindSet {
    words: [4]u64;
}

pub fun set_empty() KindSet {
    var s: KindSet;
    s.words[0] = 0;
    s.words[1] = 0;
    s.words[2] = 0;
    s.words[3] = 0;
    ret s;
}

pub fun set_add(s: *KindSet, k: Kind) {
    s.words[(k >> 6)::usize] = s.words[(k >> 6)::usize] | (1::u64 << (k & 63)::u64);
}

pub fun set_has(s: *KindSet, k: Kind) bool {
    ret (s.words[(k >> 6)::usize] & (1::u64 << (k & 63)::u64)) != 0;
}

test table__rows_are_distinct_and_named {
    var i: usize = 0;
    for (i < COUNT) {
        if (KINDS[i].kind == NONE)            { ret 1; }
        if (spec(KINDS[i].kind) != ?KINDS[i]) { ret 2; }
        val back: opt[Kind] = named(KINDS[i].name);
        if (!(sel back.some && back.some == KINDS[i].kind)) { ret 3; }
        i = i + 1;
    }
    if (spec(NONE) != nil) { ret 4; }
    val unknown: opt[Kind] = named("no-such-kind");
    if (sel unknown.some) { ret 5; }
    ret 0;
}

test set__holds_exactly_what_was_added {
    var s: KindSet = set_empty();
    set_add(?s, UNUSED_IMPORT);
    set_add(?s, 255::Kind);
    if (!set_has(?s, UNUSED_IMPORT)) { ret 1; }
    if (!set_has(?s, 255::Kind))     { ret 2; }
    if (set_has(?s, DEPRECATED))     { ret 3; }
    if (set_has(?s, NONE))           { ret 4; }
    ret 0;
}
