    Spec{kind: DECORATOR_ARGUMENT, key: "decorator.argument", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: DECORATOR_DUPLICATE, key: "decorator.duplicate", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: DECORATOR_CONFLICT, key: "decorator.conflict", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: DECORATOR_REQUIRES, key: "decorator.requires", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: OP_UNKNOWN, key: "op.unknown", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: OP_OPERAND_COUNT, key: "op.operand_count", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: EXTENSION_UNKNOWN, key: "extension.unknown", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: EXTENSION_TARGET_ONLY, key: "extension.target_only", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: EXTENSION_DUPLICATE, key: "extension.duplicate", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: EXPECT_UNKNOWN_KEY, key: "expect.unknown_key", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: EXPECT_ERROR_KEY, key: "expect.error_key", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: EXPECT_DUPLICATE_KEY, key: "expect.duplicate_key", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: ABI_TYPE_HAS_BODY, key: "abi_type.has_body", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: ABI_TYPE_UNKNOWN, key: "abi_type.unknown", level: LEVEL_ERROR, source: false, retired: false},
