# the diagnostic code registry
#
# one closed table, and the only place a kind is declared. every diagnostic
# names its row when it is raised, and each row carries a dotted key named by
# the subject it concerns: the key is the diagnostic's stable code, which the
# renderer prints and a profile's `allow` and a declaration's `#[expect]`
# select by. a key's leading components name a family, so `vector` selects
# every key under `vector.`. the table is append-only: a row is never removed
# or reordered and its key never changes meaning, and a retired kind keeps its
# row so its key is never reused. only a warning row can be silenced or
# expected; a selection naming an error row is refused rather than read as
# unknown
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

pub def Kind: u16;

pub def Level: u8;

pub val LEVEL_WARNING: Level = 0;
pub val LEVEL_ERROR:   Level = 1;

# the zero kind names no row, and no diagnostic may be raised with it
pub val NONE: Kind = 0;

pub val IMPORT_UNUSED:             Kind = 1;
pub val DECL_DEPRECATED:           Kind = 2;
pub val DOC_LINT:                  Kind = 3;
pub val FWD_INSTANCES:             Kind = 4;
pub val DEBUG_DROPPED:             Kind = 5;
pub val TARGET_SKIPPED:            Kind = 6;
pub val TARGET_NATIVE_FALLBACK:    Kind = 7;
pub val SECRET_NOT_OBLIVIOUS:      Kind = 8;
pub val FLOAT_INEXACT:             Kind = 9;
pub val VECTOR_SCALARIZE:          Kind = 10;
pub val EXPECT_UNFULFILLED:        Kind = 11;
pub val DECORATOR_UNKNOWN:         Kind = 12;
pub val DECORATOR_MISPLACED:       Kind = 13;
pub val DECORATOR_ARITY:           Kind = 14;
pub val DECORATOR_ARGUMENT:        Kind = 15;
pub val DECORATOR_DUPLICATE:       Kind = 16;
pub val DECORATOR_CONFLICT:        Kind = 17;
pub val DECORATOR_REQUIRES:        Kind = 18;
pub val OP_UNKNOWN:                Kind = 19;
pub val OP_OPERAND_COUNT:          Kind = 20;
pub val EXTENSION_UNKNOWN:         Kind = 21;
pub val EXTENSION_TARGET_ONLY:     Kind = 22;
pub val EXTENSION_DUPLICATE:       Kind = 23;
pub val EXPECT_UNKNOWN_KEY:        Kind = 24;
pub val EXPECT_ERROR_KEY:          Kind = 25;
pub val EXPECT_DUPLICATE_KEY:      Kind = 26;
pub val ABI_TYPE_HAS_BODY:         Kind = 27;
pub val ABI_TYPE_UNKNOWN:          Kind = 28;
pub val ABI_TYPE_UNAVAILABLE:      Kind = 29;
pub val ABI_TYPE_STORAGE:          Kind = 30;
pub val HANDLE_STORAGE:            Kind = 31;
pub val HANDLE_ROLE:               Kind = 32;
pub val HANDLE_UNBOUND:            Kind = 33;
pub val EXT_VARIADIC_BODY:         Kind = 34;
pub val EXT_DATA_INITIALIZER:      Kind = 35;
pub val PACK_BODYLESS:             Kind = 36;
pub val TESTING_USE:               Kind = 37;
pub val FIN_RET:                   Kind = 38;
pub val FIN_JUMP:                  Kind = 39;
pub val SELECTOR_NOT_VALUE:        Kind = 40;
pub val EACH_SEQUENCE:             Kind = 41;
pub val EACH_MUTABLE:              Kind = 42;
pub val EACH_ELEMENT_TYPE:         Kind = 43;
pub val EACH_INITIALIZER:          Kind = 44;
pub val TEST_STATUS_RANGE:         Kind = 45;
pub val NAKED_BODY:                Kind = 46;
pub val GATE_NOT_CONSTANT:         Kind = 47;
pub val GATE_RUNTIME_VALUE:        Kind = 48;
pub val COMPTIME_ERROR:            Kind = 49;
pub val COMPTIME_TYPE_UNRESOLVED:  Kind = 50;
pub val GENERIC_NOT_GENERIC:       Kind = 51;
pub val GENERIC_ARGUMENT:          Kind = 52;
pub val GENERIC_ARITY:             Kind = 53;
pub val SECRET_VARIANT_MISMATCH:   Kind = 54;
pub val SECRET_VARIANT_UNPROVABLE: Kind = 55;
pub val GUARD_ASSIGN:              Kind = 56;
pub val GUARD_UNSTABLE_PLACE:      Kind = 57;
pub val LITERAL_OUT_OF_RANGE:      Kind = 58;

# kind:    the row's own kind, which is its position in the table plus one
# key:     the dotted key the kind is printed and selected by
# level:   the severity every diagnostic of the kind is raised at
# source:  the kind is decided by the source alone, whatever the target, goal
#          or profile, so an `#[expect]` of it that nothing fulfils is reported
# retired: nothing raises the kind any more; the row stays so its key is
#          never given to another kind
pub rec Spec {
    kind:    Kind;
    key:     str;
    level:   Level;
    source:  bool;
    retired: bool;
}

pub val COUNT: usize       = 58;
val     KINDS: [COUNT]Spec = [COUNT]Spec{
    Spec{kind: IMPORT_UNUSED, key: "import.unused", level: LEVEL_WARNING, source: true, retired: false},
    Spec{kind: DECL_DEPRECATED, key: "decl.deprecated", level: LEVEL_WARNING, source: true, retired: false},
    Spec{kind: DOC_LINT, key: "doc.lint", level: LEVEL_WARNING, source: true, retired: false},
    Spec{kind: FWD_INSTANCES, key: "fwd.instances", level: LEVEL_WARNING, source: false, retired: false},
    Spec{kind: DEBUG_DROPPED, key: "debug.dropped", level: LEVEL_WARNING, source: false, retired: false},
