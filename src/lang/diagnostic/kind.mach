pub val NAME_UNRESOLVED:                Kind = 50;
pub val RANGE_COUNT_INVALID:            Kind = 51;
pub val RANGE_COUNT_NOT_CONSTANT:       Kind = 52;
pub val RANGE_OUT_OF_BOUNDS:            Kind = 53;
