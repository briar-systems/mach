# the diagnostic code registry
#
# one closed table, and the only place a kind is declared. every diagnostic
# names its row when it is raised, and each row carries a dotted key named by
# the subject it concerns: the key is the diagnostic's stable code, which the
# renderer prints and a profile's `allow` and a declaration's `#[expect]`
# select by. a key's leading components name a family, so `vector` selects
# every key under `vector.`. the table is append-only: a row is never removed
# or reordered and its key never changes meaning, and a retired kind keeps its
# row so its key is never reused. only a warning row can be silenced or
# expected; a selection naming an error row is refused rather than read as
# unknown
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

pub def Kind: u16;

pub def Level: u8;

pub val LEVEL_WARNING: Level = 0;
pub val LEVEL_ERROR:   Level = 1;

# the zero kind names no row, and no diagnostic may be raised with it
pub val NONE: Kind = 0;

pub val IMPORT_UNUSED:                Kind = 1;
pub val DECL_DEPRECATED:              Kind = 2;
pub val DOC_LINT:                     Kind = 3;
pub val FWD_INSTANCES:                Kind = 4;
pub val DEBUG_DROPPED:                Kind = 5;
pub val TARGET_SKIPPED:               Kind = 6;
pub val TARGET_NATIVE_FALLBACK:       Kind = 7;
pub val SECRET_NOT_OBLIVIOUS:         Kind = 8;
pub val FLOAT_INEXACT:                Kind = 9;
pub val VECTOR_SCALARIZE:             Kind = 10;
pub val EXPECT_UNFULFILLED:           Kind = 11;
pub val TEST_DUPLICATE:               Kind = 12;
pub val GLOBAL_INIT_NOT_CONSTANT:     Kind = 13;
pub val ALIGN_NOT_INTEGER:            Kind = 14;
pub val ALIGN_NOT_POWER_OF_TWO:       Kind = 15;
pub val ALIGN_TOO_LARGE:              Kind = 16;
pub val COMPTIME_CASES_NOT_TAG:       Kind = 17;
pub val COMPTIME_FIELDS_NOT_RECORD:   Kind = 18;
pub val COMPTIME_ARG_NOT_CONSTANT:    Kind = 19;
pub val COMPTIME_CASE_NO_PAYLOAD:     Kind = 20;
pub val COMPTIME_TYPE_NEEDS_INSTANCE: Kind = 21;
pub val ASM_UNAVAILABLE:              Kind = 22;
pub val ASM_REFERENCE_UNTERMINATED:   Kind = 23;
pub val ASM_REFERENCE_EMPTY:          Kind = 24;
pub val ASM_REFERENCE_UNKNOWN_LOCAL:  Kind = 25;
pub val ASM_REFERENCE_NOT_STACK:      Kind = 26;
pub val LITERAL_INVALID_ESCAPE:       Kind = 27;
pub val NAME_UNRESOLVED:              Kind = 28;
pub val PTR_UNTYPED_ACCESS:           Kind = 29;
pub val FIELD_UNKNOWN:                Kind = 30;
pub val LAYOUT_MEASUREMENT_OVERFLOW:  Kind = 31;
pub val LAYOUT_INTRINSIC_ARITY:       Kind = 32;
pub val LAYOUT_LENGTH_OF_OPERAND:     Kind = 33;
pub val LAYOUT_OFFSET_OF_MEMBER:      Kind = 34;
pub val CONST_TUPLE_DEPENDENT:        Kind = 35;
pub val SHADER_RECURSIVE_REFERENCE:   Kind = 36;
pub val VECTOR_UNDECLARED_FORM:       Kind = 37;
pub val VECTOR_SCALARIZE_REFUSED:     Kind = 38;

# kind:    the row's own kind, which is its position in the table plus one
# key:     the dotted key the kind is printed and selected by
# level:   the severity every diagnostic of the kind is raised at
# source:  the kind is decided by the source alone, whatever the target, goal
#          or profile, so an `#[expect]` of it that nothing fulfils is reported
# retired: nothing raises the kind any more; the row stays so its key is
#          never given to another kind
pub rec Spec {
    kind:    Kind;
    key:     str;
    level:   Level;
    source:  bool;
    retired: bool;
}

pub val COUNT: usize       = 38;
val     KINDS: [COUNT]Spec = [COUNT]Spec{
    Spec{kind: IMPORT_UNUSED, key: "import.unused", level: LEVEL_WARNING, source: true, retired: false},
    Spec{kind: DECL_DEPRECATED, key: "decl.deprecated", level: LEVEL_WARNING, source: true, retired: false},
    Spec{kind: DOC_LINT, key: "doc.lint", level: LEVEL_WARNING, source: true, retired: false},
    Spec{kind: FWD_INSTANCES, key: "fwd.instances", level: LEVEL_WARNING, source: false, retired: false},
    Spec{kind: DEBUG_DROPPED, key: "debug.dropped", level: LEVEL_WARNING, source: false, retired: false},
    Spec{kind: TARGET_SKIPPED, key: "target.skipped", level: LEVEL_WARNING, source: false, retired: false},
    Spec{kind: TARGET_NATIVE_FALLBACK, key: "target.native_fallback", level: LEVEL_WARNING, source: false, retired: false},
    Spec{kind: SECRET_NOT_OBLIVIOUS, key: "secret.not_oblivious", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: FLOAT_INEXACT, key: "float.inexact", level: LEVEL_WARNING, source: true, retired: false},
    Spec{kind: VECTOR_SCALARIZE, key: "vector.scalarize", level: LEVEL_WARNING, source: false, retired: false},
    Spec{kind: EXPECT_UNFULFILLED, key: "expect.unfulfilled", level: LEVEL_WARNING, source: false, retired: false},
    Spec{kind: TEST_DUPLICATE, key: "test.duplicate", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: GLOBAL_INIT_NOT_CONSTANT, key: "global.init_not_constant", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: ALIGN_NOT_INTEGER, key: "align.not_integer", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: ALIGN_NOT_POWER_OF_TWO, key: "align.not_power_of_two", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: ALIGN_TOO_LARGE, key: "align.too_large", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: COMPTIME_CASES_NOT_TAG, key: "comptime.cases_not_tag", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: COMPTIME_FIELDS_NOT_RECORD, key: "comptime.fields_not_record", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: COMPTIME_ARG_NOT_CONSTANT, key: "comptime.arg_not_constant", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: COMPTIME_CASE_NO_PAYLOAD, key: "comptime.case_no_payload", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: COMPTIME_TYPE_NEEDS_INSTANCE, key: "comptime.type_needs_instance", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: ASM_UNAVAILABLE, key: "asm.unavailable", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: ASM_REFERENCE_UNTERMINATED, key: "asm.reference.unterminated", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: ASM_REFERENCE_EMPTY, key: "asm.reference.empty", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: ASM_REFERENCE_UNKNOWN_LOCAL, key: "asm.reference.unknown_local", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: ASM_REFERENCE_NOT_STACK, key: "asm.reference.not_stack", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: LITERAL_INVALID_ESCAPE, key: "literal.invalid_escape", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: NAME_UNRESOLVED, key: "name.unresolved", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: PTR_UNTYPED_ACCESS, key: "ptr.untyped_access", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: FIELD_UNKNOWN, key: "field.unknown", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: LAYOUT_MEASUREMENT_OVERFLOW, key: "layout.measurement_overflow", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: LAYOUT_INTRINSIC_ARITY, key: "layout.intrinsic_arity", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: LAYOUT_LENGTH_OF_OPERAND, key: "layout.length_of_operand", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: LAYOUT_OFFSET_OF_MEMBER, key: "layout.offset_of_member", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: CONST_TUPLE_DEPENDENT, key: "const.tuple_dependent", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: SHADER_RECURSIVE_REFERENCE, key: "shader.recursive_reference", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: VECTOR_UNDECLARED_FORM, key: "vector.undeclared_form", level: LEVEL_ERROR, source: false, retired: false},
    Spec{kind: VECTOR_SCALARIZE_REFUSED, key: "vector.scalarize_refused", level: LEVEL_ERROR, source: false, retired: false},
};

# the row at `i` in declaration order, nil past the end
pub fun at(i: usize) *Spec {
    if (i >= COUNT) { ret nil; }
    ret ?KINDS[i];
}

# the row of `k`, nil for NONE or a kind no row declares
pub fun spec(k: Kind) *Spec {
    if (k == NONE || k::usize > COUNT) { ret nil; }
    ret ?KINDS[k::usize - 1];
}

# the kind can be raised: a row declares it and it is not retired
pub fun live(k: Kind) bool {
    val row: *Spec = spec(k);
    ret row != nil && !row.retired;
}

# the key of `k`, nil for NONE or a kind no row declares
pub fun key_of(k: Kind) str {
    val row: *Spec = spec(k);
    if (row == nil) { ret nil; }
    ret row.key;
}

# the kind whose key is exactly `key`, retired or not
pub fun named(key: str) opt[Kind] {
    var i: usize = 0;
    for (i < COUNT) {
        if (str_equals(KINDS[i].key, key)) { ret opt[Kind].some{KINDS[i].kind}; }
        i = i + 1;
    }
    ret opt[Kind].none{};
}

# a key or a family covers a row when it is the row's key or a whole leading
# run of its components: `vector` covers `vector.scalarize`, `vec` covers nothing
fun covers(selector: str, key: str) bool {
    val n: usize = str_len(selector);
    if (n == 0 || !str_starts_with(key, selector)) { ret false; }
    ret str_len(key) == n || key[n] == '.';
}

# a set of kinds, one bit for every kind the table declares
pub val SET_WORDS: usize = COUNT / 64 + 1;

pub rec KindSet {
    words: [SET_WORDS]u64;
}

pub fun set_empty() KindSet {
    var s: KindSet;
    var i: usize = 0;
    for (i < SET_WORDS) {
        s.words[i] = 0;
        i          = i + 1;
    }
    ret s;
}

# a kind no row declares is never a member
pub fun set_add(s: *KindSet, k: Kind) {
    if (spec(k) == nil) { ret; }
    s.words[(k >> 6)::usize] = s.words[(k >> 6)::usize] | (1::u64 << (k & 63)::u64);
}

pub fun set_has(s: *KindSet, k: Kind) bool {
    if (spec(k) == nil) { ret false; }
    ret (s.words[(k >> 6)::usize] & (1::u64 << (k & 63)::u64)) != 0;
}

pub fun set_union(s: *KindSet, other: *KindSet) {
    var i: usize = 0;
    for (i < SET_WORDS) {
        s.words[i] = s.words[i] | other.words[i];
        i          = i + 1;
    }
}

pub fun set_is_empty(s: *KindSet) bool {
    var i: usize = 0;
    for (i < SET_WORDS) {
        if (s.words[i] != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

# what one key or family selects from the table
#
# warnings: the warning rows it covers
# errors:   how many error rows it covers
# source:   a covered warning row is decided by the source alone
pub rec Selection {
    warnings: KindSet;
    errors:   usize;
    source:   bool;
}

# the rows `selector` covers; nothing at all when it is unknown
pub fun select(selector: str) Selection {
    var s: Selection;
    s.warnings = set_empty();
    s.errors   = 0;
    s.source   = false;
    var i: usize = 0;
    for (i < COUNT) {
        if (!KINDS[i].retired && covers(selector, KINDS[i].key)) {
            if (KINDS[i].level == LEVEL_WARNING) {
                set_add(?s.warnings, KINDS[i].kind);
                if (KINDS[i].source) { s.source = true; }
            }
            or { s.errors = s.errors + 1; }
        }
        i = i + 1;
    }
    ret s;
}

# the selection covers no row
pub fun selection_unknown(s: *Selection) bool {
    ret s.errors == 0 && selection_empty(s);
}

# the selection covers no warning row
pub fun selection_empty(s: *Selection) bool {
    ret set_is_empty(?s.warnings);
}

test table__rows_are_distinct_and_keyed {
    var i: usize = 0;
    for (i < COUNT) {
        if (KINDS[i].kind::usize != i + 1)    { ret 1; }
        if (spec(KINDS[i].kind) != ?KINDS[i]) { ret 2; }
        val back: opt[Kind] = named(KINDS[i].key);
        if (!(sel back.some && back.some == KINDS[i].kind)) { ret 3; }
        # a key is dotted, and no key is a family of another
        if (!covers(KINDS[i].key, KINDS[i].key) || KINDS[i].key[0] == '.') { ret 4; }
        var dotted: bool  = false;
        var c:      usize = 0;
        for (c < str_len(KINDS[i].key)) {
            if (KINDS[i].key[c] == '.') { dotted = true; }
            c = c + 1;
        }
        if (!dotted) { ret 5; }
        var j: usize = 0;
        for (j < COUNT) {
            if (j != i && covers(KINDS[i].key, KINDS[j].key)) { ret 6; }
            j = j + 1;
        }
        i = i + 1;
    }
    if (spec(NONE) != nil) { ret 7; }
    val unknown: opt[Kind] = named("no.such.kind");
    if (sel unknown.some) { ret 8; }
    ret 0;
}

# a family covers whole components only, and an error row is counted apart
test select__families_cover_whole_components {
    var vector: Selection = select("vector");
    if (!set_has(?vector.warnings, VECTOR_SCALARIZE) || vector.source) { ret 1; }
    var exact: Selection = select("vector.scalarize");
    if (!set_has(?exact.warnings, VECTOR_SCALARIZE) || exact.errors != 0) { ret 2; }
    var partial: Selection = select("vec");
    if (!selection_unknown(?partial)) { ret 3; }
    var target: Selection = select("target");
    if (!set_has(?target.warnings, TARGET_SKIPPED) || !set_has(?target.warnings, TARGET_NATIVE_FALLBACK)) { ret 4; }
    var secret: Selection = select("secret.not_oblivious");
    if (secret.errors != 1 || !selection_empty(?secret) || selection_unknown(?secret)) { ret 5; }
    var doc: Selection = select("doc");
    if (!doc.source) { ret 6; }
    var none: Selection = select("");
    if (!selection_unknown(?none)) { ret 7; }
    ret 0;
}

test set__holds_exactly_what_was_added {
    var s: KindSet = set_empty();
    set_add(?s, IMPORT_UNUSED);
    set_add(?s, EXPECT_UNFULFILLED);
    set_add(?s, (COUNT + 1)::Kind);
    if (!set_has(?s, IMPORT_UNUSED))      { ret 1; }
    if (!set_has(?s, EXPECT_UNFULFILLED)) { ret 2; }
    if (set_has(?s, DECL_DEPRECATED))     { ret 3; }
    if (set_has(?s, NONE))                { ret 4; }
    if (set_has(?s, (COUNT + 1)::Kind))   { ret 5; }
    ret 0;
}
