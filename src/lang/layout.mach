}

pub fun read_u64_be(buf: *u8, len: usize, off: usize) R.Result[u64, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_be(buf, len, off, 8);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[u64, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
    var v: u64 = R.unwrap_ok[u64, CheckCause](r);
    ret R.ok[u64, CheckCause](v::u64);
}

pub fun read_i64_le(buf: *u8, len: usize, off: usize) R.Result[i64, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_le(buf, len, off, 8);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[i64, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
    var v: u64 = R.unwrap_ok[u64, CheckCause](r);
    ret R.ok[i64, CheckCause](v::i64);
}

pub fun read_i64_be(buf: *u8, len: usize, off: usize) R.Result[i64, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_be(buf, len, off, 8);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[i64, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
    var v: u64 = R.unwrap_ok[u64, CheckCause](r);
    ret R.ok[i64, CheckCause](v::i64);
}

pub fun write_u64_le(buf: *u8, len: usize, off: usize, value: u64) R.Result[bool, CheckCause] {
    ret write_uint_le(buf, len, off, 8, value::u64);
}

pub fun write_u64_be(buf: *u8, len: usize, off: usize, value: u64) R.Result[bool, CheckCause] {
