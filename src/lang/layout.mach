use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use R: std.types.result;

pub def CheckCause: u8;

pub val CHECK_OK:                   CheckCause = 0;
pub val CHECK_ADD_OVERFLOW:         CheckCause = 1;
pub val CHECK_SUB_UNDERFLOW:        CheckCause = 2;
pub val CHECK_MUL_OVERFLOW:         CheckCause = 3;
pub val CHECK_INVALID_ALIGNMENT:    CheckCause = 4;
pub val CHECK_NON_POWER_ALIGNMENT:  CheckCause = 5;
pub val CHECK_INVALID_RANGE:        CheckCause = 6;
pub val CHECK_NARROWING:            CheckCause = 7;
pub val CHECK_ID_RANGE:             CheckCause = 8;
pub val CHECK_NIL_POINTER:          CheckCause = 9;
pub val CHECK_ZERO_SIZED_ELEMENT:   CheckCause = 10;
pub val CHECK_POINTER_ALIGNMENT:    CheckCause = 11;
pub val CHECK_POINTER_OVERFLOW:     CheckCause = 12;

pub rec ByteUnit {
}

pub rec MemorySpace {
}

pub rec CheckedCount[Unit] {
    value: usize;
}

pub rec CheckedOffset[Unit] {
    value: usize;
}

pub rec CheckedAddress[Space] {
    value: usize;
}

pub rec CheckedRange[Unit] {
    start: CheckedOffset[Unit];
    end:   CheckedOffset[Unit];
}

pub rec CheckedAlignment[Unit] {
    value: usize;
}

pub rec CheckedPowerAlignment[Unit] {
    value: usize;
}

pub rec CheckedId[Domain] {
    value: usize;
}

pub rec CheckedSpan[T] {
    data:  *T;
    count: usize;
    bytes: usize;
    begin: usize;
    end:   usize;
}

pub fun usize_add(left: usize, right: usize) R.Result[usize, CheckCause] {
    val maximum: usize = ~(0::usize);
    if (right > maximum - left) { ret R.err[usize, CheckCause](CHECK_ADD_OVERFLOW); }
    ret R.ok[usize, CheckCause](left + right);
}

pub fun usize_mul(left: usize, right: usize) R.Result[usize, CheckCause] {
    val maximum: usize = ~(0::usize);
    if (left != 0 && right > maximum / left) { ret R.err[usize, CheckCause](CHECK_MUL_OVERFLOW); }
    ret R.ok[usize, CheckCause](left * right);
}

pub fun count[Unit](value: usize) CheckedCount[Unit] {
    var out: CheckedCount[Unit];
    out.value = value;
    ret out;
}

pub fun offset[Unit](value: usize) CheckedOffset[Unit] {
    var out: CheckedOffset[Unit];
    out.value = value;
    ret out;
}

pub fun address[Space](value: usize) CheckedAddress[Space] {
    var out: CheckedAddress[Space];
    out.value = value;
    ret out;
}

pub fun count_add[Unit](left: CheckedCount[Unit], right: CheckedCount[Unit])
                        R.Result[CheckedCount[Unit], CheckCause] {
    val added: R.Result[usize, CheckCause] = usize_add(left.value, right.value);
    if (R.is_err[usize, CheckCause](added)) {
        ret R.err[CheckedCount[Unit], CheckCause](R.unwrap_err[usize, CheckCause](added));
    }
    ret R.ok[CheckedCount[Unit], CheckCause](count[Unit](R.unwrap_ok[usize, CheckCause](added)));
}

pub fun count_sub[Unit](left: CheckedCount[Unit], right: CheckedCount[Unit])
                        R.Result[CheckedCount[Unit], CheckCause] {
    if (right.value > left.value) {
        ret R.err[CheckedCount[Unit], CheckCause](CHECK_SUB_UNDERFLOW);
    }
    ret R.ok[CheckedCount[Unit], CheckCause](count[Unit](left.value - right.value));
}

pub fun count_mul[Unit](value: CheckedCount[Unit], factor: usize)
                        R.Result[CheckedCount[Unit], CheckCause] {
    val multiplied: R.Result[usize, CheckCause] = usize_mul(value.value, factor);
    if (R.is_err[usize, CheckCause](multiplied)) {
        ret R.err[CheckedCount[Unit], CheckCause](R.unwrap_err[usize, CheckCause](multiplied));
    }
    ret R.ok[CheckedCount[Unit], CheckCause](count[Unit](R.unwrap_ok[usize, CheckCause](multiplied)));
}

pub fun count_grow[Unit](current: CheckedCount[Unit], required: CheckedCount[Unit])
                         R.Result[CheckedCount[Unit], CheckCause] {
    if (required.value <= current.value) { ret R.ok[CheckedCount[Unit], CheckCause](current); }
    if (current.value == 0) {
        var first: usize = 1;
        if (required.value > first) { first = required.value; }
        ret R.ok[CheckedCount[Unit], CheckCause](count[Unit](first));
    }
    val doubled: R.Result[usize, CheckCause] = usize_mul(current.value, 2);
    var next: usize = required.value;
    if (R.is_ok[usize, CheckCause](doubled)) {
        val candidate: usize = R.unwrap_ok[usize, CheckCause](doubled);
        if (candidate > next) { next = candidate; }
    }
    if (next <= current.value || next < required.value) {
        ret R.err[CheckedCount[Unit], CheckCause](CHECK_ADD_OVERFLOW);
    }
    ret R.ok[CheckedCount[Unit], CheckCause](count[Unit](next));
}

pub fun offset_add[Unit](base: CheckedOffset[Unit], amount: CheckedCount[Unit])
                         R.Result[CheckedOffset[Unit], CheckCause] {
    val added: R.Result[usize, CheckCause] = usize_add(base.value, amount.value);
    if (R.is_err[usize, CheckCause](added)) {
        ret R.err[CheckedOffset[Unit], CheckCause](R.unwrap_err[usize, CheckCause](added));
    }
    ret R.ok[CheckedOffset[Unit], CheckCause](offset[Unit](R.unwrap_ok[usize, CheckCause](added)));
}

pub fun address_add[Space](base: CheckedAddress[Space], amount: CheckedCount[ByteUnit])
                           R.Result[CheckedAddress[Space], CheckCause] {
    val added: R.Result[usize, CheckCause] = usize_add(base.value, amount.value);
    if (R.is_err[usize, CheckCause](added)) {
        ret R.err[CheckedAddress[Space], CheckCause](R.unwrap_err[usize, CheckCause](added));
    }
    ret R.ok[CheckedAddress[Space], CheckCause](address[Space](R.unwrap_ok[usize, CheckCause](added)));
}

pub fun checked_range[Unit](start: CheckedOffset[Unit], end: CheckedOffset[Unit])
                            R.Result[CheckedRange[Unit], CheckCause] {
    if (end.value < start.value) {
        ret R.err[CheckedRange[Unit], CheckCause](CHECK_INVALID_RANGE);
    }
    var out: CheckedRange[Unit];
    out.start = start;
    out.end = end;
    ret R.ok[CheckedRange[Unit], CheckCause](out);
}

pub fun range_from_count[Unit](start: CheckedOffset[Unit], length: CheckedCount[Unit])
                               R.Result[CheckedRange[Unit], CheckCause] {
    val end: R.Result[CheckedOffset[Unit], CheckCause] = offset_add[Unit](start, length);
    if (R.is_err[CheckedOffset[Unit], CheckCause](end)) {
        ret R.err[CheckedRange[Unit], CheckCause](R.unwrap_err[CheckedOffset[Unit], CheckCause](end));
    }
    ret checked_range[Unit](start, R.unwrap_ok[CheckedOffset[Unit], CheckCause](end));
}

pub fun range_count[Unit](value: CheckedRange[Unit]) R.Result[CheckedCount[Unit], CheckCause] {
    if (value.end.value < value.start.value) {
        ret R.err[CheckedCount[Unit], CheckCause](CHECK_INVALID_RANGE);
    }
    ret R.ok[CheckedCount[Unit], CheckCause](count[Unit](value.end.value - value.start.value));
}

pub fun range_contains[Unit](value: CheckedRange[Unit], position: CheckedOffset[Unit]) bool {
    if (value.end.value < value.start.value) { ret false; }
    ret position.value >= value.start.value && position.value < value.end.value;
}

pub fun range_contains_range[Unit](outer: CheckedRange[Unit], inner: CheckedRange[Unit]) bool {
    if (outer.end.value < outer.start.value || inner.end.value < inner.start.value) { ret false; }
    ret inner.start.value >= outer.start.value && inner.end.value <= outer.end.value;
}

pub fun range_fits[Unit](available: CheckedCount[Unit], start: CheckedOffset[Unit],
                         length: CheckedCount[Unit]) bool {
    val made: R.Result[CheckedRange[Unit], CheckCause] = range_from_count[Unit](start, length);
    if (R.is_err[CheckedRange[Unit], CheckCause](made)) { ret false; }
    ret R.unwrap_ok[CheckedRange[Unit], CheckCause](made).end.value <= available.value;
}

pub fun alignment[Unit](value: usize) R.Result[CheckedAlignment[Unit], CheckCause] {
    if (value == 0) { ret R.err[CheckedAlignment[Unit], CheckCause](CHECK_INVALID_ALIGNMENT); }
    var out: CheckedAlignment[Unit];
    out.value = value;
    ret R.ok[CheckedAlignment[Unit], CheckCause](out);
}

pub fun power_alignment[Unit](value: usize) R.Result[CheckedPowerAlignment[Unit], CheckCause] {
    if (value == 0) {
        ret R.err[CheckedPowerAlignment[Unit], CheckCause](CHECK_INVALID_ALIGNMENT);
    }
    if ((value & (value - 1)) != 0) {
        ret R.err[CheckedPowerAlignment[Unit], CheckCause](CHECK_NON_POWER_ALIGNMENT);
    }
    var out: CheckedPowerAlignment[Unit];
    out.value = value;
    ret R.ok[CheckedPowerAlignment[Unit], CheckCause](out);
}

pub fun general_alignment[Unit](value: CheckedPowerAlignment[Unit])
                                R.Result[CheckedAlignment[Unit], CheckCause] {
    val checked: R.Result[CheckedPowerAlignment[Unit], CheckCause] = power_alignment[Unit](value.value);
    if (R.is_err[CheckedPowerAlignment[Unit], CheckCause](checked)) {
        ret R.err[CheckedAlignment[Unit], CheckCause](
            R.unwrap_err[CheckedPowerAlignment[Unit], CheckCause](checked));
    }
    ret alignment[Unit](value.value);
}

pub fun align_offset_up[Unit](value: CheckedOffset[Unit], align: CheckedAlignment[Unit])
                              R.Result[CheckedOffset[Unit], CheckCause] {
    if (align.value == 0) {
        ret R.err[CheckedOffset[Unit], CheckCause](CHECK_INVALID_ALIGNMENT);
    }
    val remainder: usize = value.value % align.value;
    if (remainder == 0) { ret R.ok[CheckedOffset[Unit], CheckCause](value); }
    ret offset_add[Unit](value, count[Unit](align.value - remainder));
}

pub fun align_offset_down[Unit](value: CheckedOffset[Unit], align: CheckedAlignment[Unit])
                                R.Result[CheckedOffset[Unit], CheckCause] {
    if (align.value == 0) {
        ret R.err[CheckedOffset[Unit], CheckCause](CHECK_INVALID_ALIGNMENT);
    }
    ret R.ok[CheckedOffset[Unit], CheckCause](offset[Unit](value.value - value.value % align.value));
}

pub fun id[Domain](value: usize) CheckedId[Domain] {
    var out: CheckedId[Domain];
    out.value = value;
    ret out;
}

pub fun id_below[Domain](value: usize, upper: CheckedCount[Domain])
                         R.Result[CheckedId[Domain], CheckCause] {
    if (value >= upper.value) { ret R.err[CheckedId[Domain], CheckCause](CHECK_ID_RANGE); }
    ret R.ok[CheckedId[Domain], CheckCause](id[Domain](value));
}

pub fun id_at_most[Domain](value: usize, maximum: CheckedId[Domain])
                           R.Result[CheckedId[Domain], CheckCause] {
    if (value > maximum.value) { ret R.err[CheckedId[Domain], CheckCause](CHECK_ID_RANGE); }
    ret R.ok[CheckedId[Domain], CheckCause](id[Domain](value));
}

pub fun usize_to_u8(value: usize) R.Result[u8, CheckCause] {
    if (value::u8::usize != value) { ret R.err[u8, CheckCause](CHECK_NARROWING); }
    ret R.ok[u8, CheckCause](value::u8);
}

pub fun usize_to_u16(value: usize) R.Result[u16, CheckCause] {
    if (value::u16::usize != value) { ret R.err[u16, CheckCause](CHECK_NARROWING); }
    ret R.ok[u16, CheckCause](value::u16);
}

pub fun usize_to_u32(value: usize) R.Result[u32, CheckCause] {
    if (value::u32::usize != value) { ret R.err[u32, CheckCause](CHECK_NARROWING); }
    ret R.ok[u32, CheckCause](value::u32);
}

pub fun u64_to_usize(value: u64) R.Result[usize, CheckCause] {
    if (value::usize::u64 != value) { ret R.err[usize, CheckCause](CHECK_NARROWING); }
    ret R.ok[usize, CheckCause](value::usize);
}

pub fun u64_to_u32(value: u64) R.Result[u32, CheckCause] {
    if (value::u32::u64 != value) { ret R.err[u32, CheckCause](CHECK_NARROWING); }
    ret R.ok[u32, CheckCause](value::u32);
}

pub fun i64_to_i32(value: i64) R.Result[i32, CheckCause] {
    if (value::i32::i64 != value) { ret R.err[i32, CheckCause](CHECK_NARROWING); }
    ret R.ok[i32, CheckCause](value::i32);
}

pub fun i64_to_u32(value: i64) R.Result[u32, CheckCause] {
    if (value < 0 || value::u32::i64 != value) { ret R.err[u32, CheckCause](CHECK_NARROWING); }
    ret R.ok[u32, CheckCause](value::u32);
}

pub fun usize_to_i32(value: usize) R.Result[i32, CheckCause] {
    if (value > 2147483647) { ret R.err[i32, CheckCause](CHECK_NARROWING); }
    ret R.ok[i32, CheckCause](value::i32);
}

pub fun pointer_count[T](data: *T, count: usize) R.Result[CheckedSpan[T], CheckCause] {
    if (count > 0 && data == nil) { ret R.err[CheckedSpan[T], CheckCause](CHECK_NIL_POINTER); }
    if (count > 0 && $size_of(T) == 0) {
        ret R.err[CheckedSpan[T], CheckCause](CHECK_ZERO_SIZED_ELEMENT);
    }
    val multiplied: R.Result[usize, CheckCause] = usize_mul(count, $size_of(T));
    if (R.is_err[usize, CheckCause](multiplied)) {
        ret R.err[CheckedSpan[T], CheckCause](R.unwrap_err[usize, CheckCause](multiplied));
    }
    val bytes: usize = R.unwrap_ok[usize, CheckCause](multiplied);
    var begin: usize = 0;
    if (data != nil) {
        begin = data::usize;
        if (begin % $align_of(T) != 0) {
            ret R.err[CheckedSpan[T], CheckCause](CHECK_POINTER_ALIGNMENT);
        }
    }
    val added: R.Result[usize, CheckCause] = usize_add(begin, bytes);
    if (R.is_err[usize, CheckCause](added)) {
        ret R.err[CheckedSpan[T], CheckCause](CHECK_POINTER_OVERFLOW);
    }
    var out: CheckedSpan[T];
    out.data = data;
    out.count = count;
    out.bytes = bytes;
    out.begin = begin;
    out.end = R.unwrap_ok[usize, CheckCause](added);
    ret R.ok[CheckedSpan[T], CheckCause](out);
}

pub fun span_valid[T](value: *CheckedSpan[T]) bool {
    if (value == nil) { ret false; }
    val made: R.Result[CheckedSpan[T], CheckCause] = pointer_count[T](value.data, value.count);
    if (R.is_err[CheckedSpan[T], CheckCause](made)) { ret false; }
    val expected: CheckedSpan[T] = R.unwrap_ok[CheckedSpan[T], CheckCause](made);
    ret value.data == expected.data && value.count == expected.count
        && value.bytes == expected.bytes && value.begin == expected.begin && value.end == expected.end;
}

pub fun check_cause_name(cause: CheckCause) str {
    if (cause == CHECK_OK)                  { ret "no failure"; }
    if (cause == CHECK_ADD_OVERFLOW)        { ret "addition overflow"; }
    if (cause == CHECK_SUB_UNDERFLOW)       { ret "subtraction underflow"; }
    if (cause == CHECK_MUL_OVERFLOW)        { ret "multiplication overflow"; }
    if (cause == CHECK_INVALID_ALIGNMENT)   { ret "zero alignment"; }
    if (cause == CHECK_NON_POWER_ALIGNMENT) { ret "non-power-of-two alignment"; }
    if (cause == CHECK_INVALID_RANGE)       { ret "reversed range"; }
    if (cause == CHECK_NARROWING)           { ret "unrepresentable narrowing"; }
    if (cause == CHECK_ID_RANGE)            { ret "identifier outside its domain"; }
    if (cause == CHECK_NIL_POINTER)         { ret "nil pointer with nonzero count"; }
    if (cause == CHECK_ZERO_SIZED_ELEMENT)  { ret "nonzero count of zero-sized elements"; }
    if (cause == CHECK_POINTER_ALIGNMENT)   { ret "misaligned typed pointer"; }
    if (cause == CHECK_POINTER_OVERFLOW)    { ret "pointer extent overflow"; }
    ret "unknown checked arithmetic failure";
}

rec TestUnit {
}

rec TestDomain {
}

rec ZeroSized {
}

fun count_is_error(result: R.Result[CheckedCount[TestUnit], CheckCause], cause: CheckCause) bool {
    if (!R.is_err[CheckedCount[TestUnit], CheckCause](result)) { ret false; }
    ret R.unwrap_err[CheckedCount[TestUnit], CheckCause](result) == cause;
}

test "mach.lang.layout.checked_count:boundaries_and_properties" {
    val maximum: usize = ~(0::usize);
    val zero: CheckedCount[TestUnit] = count[TestUnit](0);
    val one: CheckedCount[TestUnit] = count[TestUnit](1);
    val largest: CheckedCount[TestUnit] = count[TestUnit](maximum);
    val zero_sum: R.Result[CheckedCount[TestUnit], CheckCause] = count_add[TestUnit](zero, zero);
    if (R.is_err[CheckedCount[TestUnit], CheckCause](zero_sum)) { ret 1; }
    if (R.unwrap_ok[CheckedCount[TestUnit], CheckCause](zero_sum).value != 0) { ret 1; }
    val maximum_sum: R.Result[CheckedCount[TestUnit], CheckCause] = count_add[TestUnit](largest, zero);
    if (R.is_err[CheckedCount[TestUnit], CheckCause](maximum_sum)) { ret 1; }
    if (R.unwrap_ok[CheckedCount[TestUnit], CheckCause](maximum_sum).value != maximum) { ret 1; }
    if (!count_is_error(count_add[TestUnit](largest, one), CHECK_ADD_OVERFLOW)) { ret 1; }
    if (!count_is_error(count_sub[TestUnit](zero, one), CHECK_SUB_UNDERFLOW)) { ret 1; }
    val maximum_sub: R.Result[CheckedCount[TestUnit], CheckCause] = count_sub[TestUnit](largest, largest);
    if (R.is_err[CheckedCount[TestUnit], CheckCause](maximum_sub)) { ret 1; }
    if (R.unwrap_ok[CheckedCount[TestUnit], CheckCause](maximum_sub).value != 0) { ret 1; }
    val zero_product: R.Result[CheckedCount[TestUnit], CheckCause] = count_mul[TestUnit](largest, 0);
    if (R.is_err[CheckedCount[TestUnit], CheckCause](zero_product)) { ret 1; }
    if (R.unwrap_ok[CheckedCount[TestUnit], CheckCause](zero_product).value != 0) { ret 1; }
    val maximum_product: R.Result[CheckedCount[TestUnit], CheckCause] = count_mul[TestUnit](largest, 1);
    if (R.is_err[CheckedCount[TestUnit], CheckCause](maximum_product)) { ret 1; }
    if (R.unwrap_ok[CheckedCount[TestUnit], CheckCause](maximum_product).value != maximum) { ret 1; }
    if (!count_is_error(count_mul[TestUnit](largest, 2), CHECK_MUL_OVERFLOW)) { ret 1; }

    var values: [9]usize;
    values[0] = 0;
    values[1] = 1;
    values[2] = 2;
    values[3] = 3;
    values[4] = 7;
    values[5] = maximum / 2;
    values[6] = maximum / 2 + 1;
    values[7] = maximum - 1;
    values[8] = maximum;
    var i: usize = 0;
    for (i < 9) {
        var j: usize = 0;
        for (j < 9) {
            val left: usize = values[i];
            val right: usize = values[j];
            val added: R.Result[CheckedCount[TestUnit], CheckCause] = count_add[TestUnit](
                count[TestUnit](left), count[TestUnit](right));
            if (right <= maximum - left) {
                if (R.is_err[CheckedCount[TestUnit], CheckCause](added)) { ret 1; }
                if (R.unwrap_ok[CheckedCount[TestUnit], CheckCause](added).value != left + right) { ret 1; }
            }
            or {
                if (!count_is_error(added, CHECK_ADD_OVERFLOW)) { ret 1; }
            }
            val multiplied: R.Result[CheckedCount[TestUnit], CheckCause] = count_mul[TestUnit](
                count[TestUnit](left), right);
            if (left == 0 || right <= maximum / left) {
                if (R.is_err[CheckedCount[TestUnit], CheckCause](multiplied)) { ret 1; }
                if (R.unwrap_ok[CheckedCount[TestUnit], CheckCause](multiplied).value != left * right) { ret 1; }
            }
            or {
                if (!count_is_error(multiplied, CHECK_MUL_OVERFLOW)) { ret 1; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.layout.checked_growth:always_meets_required_progress" {
    val maximum: usize = ~(0::usize);
    var current: usize = 0;
    for (current < 128) {
        var required: usize = current;
        for (required < 160) {
            val grown: R.Result[CheckedCount[TestUnit], CheckCause] = count_grow[TestUnit](
                count[TestUnit](current), count[TestUnit](required));
            if (R.is_err[CheckedCount[TestUnit], CheckCause](grown)) { ret 1; }
            val capacity: usize = R.unwrap_ok[CheckedCount[TestUnit], CheckCause](grown).value;
            if (capacity < required) { ret 1; }
            if (required > current && capacity <= current) { ret 1; }
            required = required + 1;
        }
        current = current + 1;
    }
    val high_current: usize = maximum / 2 + 1;
    val high_required: usize = high_current + 1;
    val high: R.Result[CheckedCount[TestUnit], CheckCause] = count_grow[TestUnit](
        count[TestUnit](high_current), count[TestUnit](high_required));
    if (R.is_err[CheckedCount[TestUnit], CheckCause](high)) { ret 1; }
    if (R.unwrap_ok[CheckedCount[TestUnit], CheckCause](high).value != high_required) { ret 1; }
    val final_step: R.Result[CheckedCount[TestUnit], CheckCause] = count_grow[TestUnit](
        count[TestUnit](maximum - 1), count[TestUnit](maximum));
    if (R.is_err[CheckedCount[TestUnit], CheckCause](final_step)) { ret 1; }
    if (R.unwrap_ok[CheckedCount[TestUnit], CheckCause](final_step).value != maximum) { ret 1; }
    val no_growth: R.Result[CheckedCount[TestUnit], CheckCause] = count_grow[TestUnit](
        count[TestUnit](maximum), count[TestUnit](maximum));
    if (R.is_err[CheckedCount[TestUnit], CheckCause](no_growth)) { ret 1; }
    if (R.unwrap_ok[CheckedCount[TestUnit], CheckCause](no_growth).value != maximum) { ret 1; }
    ret 0;
}

test "mach.lang.layout.checked_alignment:general_and_power_boundaries" {
    val maximum: usize = ~(0::usize);
    val zero: R.Result[CheckedAlignment[TestUnit], CheckCause] = alignment[TestUnit](0);
    if (!R.is_err[CheckedAlignment[TestUnit], CheckCause](zero)) { ret 1; }
    if (R.unwrap_err[CheckedAlignment[TestUnit], CheckCause](zero) != CHECK_INVALID_ALIGNMENT) { ret 1; }
    val zero_power: R.Result[CheckedPowerAlignment[TestUnit], CheckCause] = power_alignment[TestUnit](0);
    if (!R.is_err[CheckedPowerAlignment[TestUnit], CheckCause](zero_power)) { ret 1; }
    if (R.unwrap_err[CheckedPowerAlignment[TestUnit], CheckCause](zero_power) != CHECK_INVALID_ALIGNMENT) {
        ret 1;
    }
    val three_power: R.Result[CheckedPowerAlignment[TestUnit], CheckCause] = power_alignment[TestUnit](3);
    if (!R.is_err[CheckedPowerAlignment[TestUnit], CheckCause](three_power)) { ret 1; }
    if (R.unwrap_err[CheckedPowerAlignment[TestUnit], CheckCause](three_power)
        != CHECK_NON_POWER_ALIGNMENT) { ret 1; }
    val general_three: R.Result[CheckedAlignment[TestUnit], CheckCause] = alignment[TestUnit](3);
    if (R.is_err[CheckedAlignment[TestUnit], CheckCause](general_three)) { ret 1; }
    if (R.unwrap_ok[CheckedAlignment[TestUnit], CheckCause](general_three).value != 3) { ret 1; }
    val six: R.Result[CheckedOffset[TestUnit], CheckCause] = align_offset_up[TestUnit](
        offset[TestUnit](4), R.unwrap_ok[CheckedAlignment[TestUnit], CheckCause](general_three));
    if (R.is_err[CheckedOffset[TestUnit], CheckCause](six)) { ret 1; }
    if (R.unwrap_ok[CheckedOffset[TestUnit], CheckCause](six).value != 6) { ret 1; }
    val two_power: CheckedPowerAlignment[TestUnit] = R.unwrap_ok[
        CheckedPowerAlignment[TestUnit], CheckCause](power_alignment[TestUnit](2));
    val two_made: R.Result[CheckedAlignment[TestUnit], CheckCause] = general_alignment[TestUnit](
        two_power);
    if (R.is_err[CheckedAlignment[TestUnit], CheckCause](two_made)) { ret 1; }
    val two: CheckedAlignment[TestUnit] = R.unwrap_ok[CheckedAlignment[TestUnit], CheckCause](two_made);
    val overflow: R.Result[CheckedOffset[TestUnit], CheckCause] = align_offset_up[TestUnit](
        offset[TestUnit](maximum), two);
    if (!R.is_err[CheckedOffset[TestUnit], CheckCause](overflow)) { ret 1; }
    if (R.unwrap_err[CheckedOffset[TestUnit], CheckCause](overflow) != CHECK_ADD_OVERFLOW) { ret 1; }
    val down: R.Result[CheckedOffset[TestUnit], CheckCause] = align_offset_down[TestUnit](
        offset[TestUnit](maximum), two);
    if (R.is_err[CheckedOffset[TestUnit], CheckCause](down)) { ret 1; }
    if (R.unwrap_ok[CheckedOffset[TestUnit], CheckCause](down).value != maximum - 1) { ret 1; }

    var forged_zero: CheckedPowerAlignment[TestUnit];
    val forged_zero_result: R.Result[CheckedAlignment[TestUnit], CheckCause] = general_alignment[TestUnit](
        forged_zero);
    if (!R.is_err[CheckedAlignment[TestUnit], CheckCause](forged_zero_result)) { ret 1; }
    if (R.unwrap_err[CheckedAlignment[TestUnit], CheckCause](forged_zero_result)
        != CHECK_INVALID_ALIGNMENT) { ret 1; }
    var forged_three: CheckedPowerAlignment[TestUnit];
    forged_three.value = 3;
    val forged_three_result: R.Result[CheckedAlignment[TestUnit], CheckCause] = general_alignment[TestUnit](
        forged_three);
    if (!R.is_err[CheckedAlignment[TestUnit], CheckCause](forged_three_result)) { ret 1; }
    if (R.unwrap_err[CheckedAlignment[TestUnit], CheckCause](forged_three_result)
        != CHECK_NON_POWER_ALIGNMENT) { ret 1; }

    var a: usize = 1;
    for (a <= 17) {
        val made: R.Result[CheckedAlignment[TestUnit], CheckCause] = alignment[TestUnit](a);
        if (R.is_err[CheckedAlignment[TestUnit], CheckCause](made)) { ret 1; }
        val checked: CheckedAlignment[TestUnit] = R.unwrap_ok[CheckedAlignment[TestUnit], CheckCause](made);
        val made_power: R.Result[CheckedPowerAlignment[TestUnit], CheckCause] = power_alignment[TestUnit](a);
        val expected_power: bool = (a & (a - 1)) == 0;
        if (R.is_ok[CheckedPowerAlignment[TestUnit], CheckCause](made_power) != expected_power) { ret 1; }
        var value: usize = 0;
        for (value < 128) {
            val rounded: R.Result[CheckedOffset[TestUnit], CheckCause] = align_offset_up[TestUnit](
                offset[TestUnit](value), checked);
            if (R.is_err[CheckedOffset[TestUnit], CheckCause](rounded)) { ret 1; }
            val result: usize = R.unwrap_ok[CheckedOffset[TestUnit], CheckCause](rounded).value;
            if (result < value || result % a != 0 || result - value >= a) { ret 1; }
            value = value + 1;
        }
        a = a + 1;
    }
    ret 0;
}

test "mach.lang.layout.checked_range:is_half_open_and_overflow_safe" {
    val maximum: usize = ~(0::usize);
    val made: R.Result[CheckedRange[TestUnit], CheckCause] = range_from_count[TestUnit](
        offset[TestUnit](5), count[TestUnit](3));
    if (R.is_err[CheckedRange[TestUnit], CheckCause](made)) { ret 1; }
    val value: CheckedRange[TestUnit] = R.unwrap_ok[CheckedRange[TestUnit], CheckCause](made);
    if (!range_contains[TestUnit](value, offset[TestUnit](5))) { ret 1; }
    if (!range_contains[TestUnit](value, offset[TestUnit](7))) { ret 1; }
    if (range_contains[TestUnit](value, offset[TestUnit](8))) { ret 1; }
    val length: R.Result[CheckedCount[TestUnit], CheckCause] = range_count[TestUnit](value);
    if (R.is_err[CheckedCount[TestUnit], CheckCause](length)) { ret 1; }
    if (R.unwrap_ok[CheckedCount[TestUnit], CheckCause](length).value != 3) { ret 1; }
    val inner: CheckedRange[TestUnit] = R.unwrap_ok[CheckedRange[TestUnit], CheckCause](
        checked_range[TestUnit](offset[TestUnit](6), offset[TestUnit](8)));
    if (!range_contains_range[TestUnit](value, inner)) { ret 1; }
    if (!range_fits[TestUnit](count[TestUnit](8), offset[TestUnit](5), count[TestUnit](3))) { ret 1; }
    if (range_fits[TestUnit](count[TestUnit](7), offset[TestUnit](5), count[TestUnit](3))) { ret 1; }
    if (range_fits[TestUnit](count[TestUnit](maximum), offset[TestUnit](maximum),
                            count[TestUnit](1))) { ret 1; }
    val empty: CheckedRange[TestUnit] = R.unwrap_ok[CheckedRange[TestUnit], CheckCause](
        checked_range[TestUnit](offset[TestUnit](maximum), offset[TestUnit](maximum)));
    if (range_contains[TestUnit](empty, offset[TestUnit](maximum))) { ret 1; }
    if (!range_contains_range[TestUnit](empty, empty)) { ret 1; }
    val reversed: R.Result[CheckedRange[TestUnit], CheckCause] = checked_range[TestUnit](
        offset[TestUnit](9), offset[TestUnit](8));
    if (!R.is_err[CheckedRange[TestUnit], CheckCause](reversed)) { ret 1; }
    if (R.unwrap_err[CheckedRange[TestUnit], CheckCause](reversed) != CHECK_INVALID_RANGE) { ret 1; }
    val overflow: R.Result[CheckedRange[TestUnit], CheckCause] = range_from_count[TestUnit](
        offset[TestUnit](maximum), count[TestUnit](1));
    if (!R.is_err[CheckedRange[TestUnit], CheckCause](overflow)) { ret 1; }
    if (R.unwrap_err[CheckedRange[TestUnit], CheckCause](overflow) != CHECK_ADD_OVERFLOW) { ret 1; }
    var forged: CheckedRange[TestUnit];
    forged.start = offset[TestUnit](2);
    forged.end = offset[TestUnit](1);
    if (range_contains[TestUnit](forged, offset[TestUnit](1))) { ret 1; }
    if (!R.is_err[CheckedCount[TestUnit], CheckCause](range_count[TestUnit](forged))) { ret 1; }

    var start: usize = 0;
    for (start < 32) {
        var end: usize = start;
        for (end <= 32) {
            val candidate: CheckedRange[TestUnit] = R.unwrap_ok[CheckedRange[TestUnit], CheckCause](
                checked_range[TestUnit](offset[TestUnit](start), offset[TestUnit](end)));
            val candidate_count: R.Result[CheckedCount[TestUnit], CheckCause] = range_count[TestUnit](
                candidate);
            if (R.is_err[CheckedCount[TestUnit], CheckCause](candidate_count)) { ret 1; }
            if (R.unwrap_ok[CheckedCount[TestUnit], CheckCause](candidate_count).value != end - start) {
                ret 1;
            }
            var position: usize = 0;
            for (position <= 32) {
                val expected: bool = position >= start && position < end;
                if (range_contains[TestUnit](candidate, offset[TestUnit](position)) != expected) { ret 1; }
                position = position + 1;
            }
            end = end + 1;
        }
        start = start + 1;
    }

    var outer_start: usize = 0;
    for (outer_start <= 6) {
        var outer_end: usize = 0;
        for (outer_end <= 6) {
            var outer: CheckedRange[TestUnit];
            outer.start = offset[TestUnit](outer_start);
            outer.end = offset[TestUnit](outer_end);
            var inner_start: usize = 0;
            for (inner_start <= 6) {
                var inner_end: usize = 0;
                for (inner_end <= 6) {
                    var candidate_inner: CheckedRange[TestUnit];
                    candidate_inner.start = offset[TestUnit](inner_start);
                    candidate_inner.end = offset[TestUnit](inner_end);
                    val expected: bool = outer_start <= outer_end && inner_start <= inner_end
                        && inner_start >= outer_start && inner_end <= outer_end;
                    if (range_contains_range[TestUnit](outer, candidate_inner) != expected) { ret 1; }
                    inner_end = inner_end + 1;
                }
                inner_start = inner_start + 1;
            }
            outer_end = outer_end + 1;
        }
        outer_start = outer_start + 1;
    }
    ret 0;
}

test "mach.lang.layout.checked_address:rejects_wrapped_endpoints" {
    val maximum: usize = ~(0::usize);
    val ordinary: R.Result[CheckedAddress[MemorySpace], CheckCause] = address_add[MemorySpace](
        address[MemorySpace](12), count[ByteUnit](4));
    if (R.is_err[CheckedAddress[MemorySpace], CheckCause](ordinary)) { ret 1; }
    if (R.unwrap_ok[CheckedAddress[MemorySpace], CheckCause](ordinary).value != 16) { ret 1; }
    val final_address: R.Result[CheckedAddress[MemorySpace], CheckCause] = address_add[MemorySpace](
        address[MemorySpace](maximum), count[ByteUnit](0));
    if (R.is_err[CheckedAddress[MemorySpace], CheckCause](final_address)) { ret 1; }
    if (R.unwrap_ok[CheckedAddress[MemorySpace], CheckCause](final_address).value != maximum) { ret 1; }
    val overflow: R.Result[CheckedAddress[MemorySpace], CheckCause] = address_add[MemorySpace](
        address[MemorySpace](maximum), count[ByteUnit](1));
    if (!R.is_err[CheckedAddress[MemorySpace], CheckCause](overflow)) { ret 1; }
    if (R.unwrap_err[CheckedAddress[MemorySpace], CheckCause](overflow) != CHECK_ADD_OVERFLOW) { ret 1; }
    ret 0;
}

test "mach.lang.layout.checked_narrowing:rejects_every_unrepresentable_boundary" {
    val usize_maximum: usize = ~(0::usize);
    if (R.is_err[u8, CheckCause](usize_to_u8(255))) { ret 1; }
    if (!R.is_err[u8, CheckCause](usize_to_u8(256))) { ret 1; }
    if (usize_maximum <= 65535) {
        if (R.is_err[u16, CheckCause](usize_to_u16(usize_maximum))) { ret 1; }
    }
    or {
        if (!R.is_err[u16, CheckCause](usize_to_u16(usize_maximum))) { ret 1; }
    }
    if (usize_maximum > 65535) {
        if (R.is_err[u16, CheckCause](usize_to_u16(65535))) { ret 1; }
        if (!R.is_err[u16, CheckCause](usize_to_u16(65536))) { ret 1; }
    }
    if (usize_maximum <= 4294967295) {
        if (R.is_err[u32, CheckCause](usize_to_u32(usize_maximum))) { ret 1; }
    }
    or {
        if (R.is_err[u32, CheckCause](usize_to_u32(4294967295))) { ret 1; }
        if (!R.is_err[u32, CheckCause](usize_to_u32(4294967296::usize))) { ret 1; }
    }
    if (R.is_err[u32, CheckCause](u64_to_u32(4294967295))) { ret 1; }
    if (!R.is_err[u32, CheckCause](u64_to_u32(4294967296))) { ret 1; }
    if (R.is_err[i32, CheckCause](i64_to_i32(-2147483648))) { ret 1; }
    if (R.is_err[i32, CheckCause](i64_to_i32(2147483647))) { ret 1; }
    if (!R.is_err[i32, CheckCause](i64_to_i32(-2147483649))) { ret 1; }
    if (!R.is_err[i32, CheckCause](i64_to_i32(2147483648))) { ret 1; }
    if (R.is_err[u32, CheckCause](i64_to_u32(0))) { ret 1; }
    if (!R.is_err[u32, CheckCause](i64_to_u32(-1))) { ret 1; }
    if (!R.is_err[u32, CheckCause](i64_to_u32(4294967296))) { ret 1; }
    if (usize_maximum <= 2147483647) {
        if (R.is_err[i32, CheckCause](usize_to_i32(usize_maximum))) { ret 1; }
    }
    or {
        if (R.is_err[i32, CheckCause](usize_to_i32(2147483647))) { ret 1; }
        if (!R.is_err[i32, CheckCause](usize_to_i32(2147483648))) { ret 1; }
    }
    val portable: u64 = usize_maximum::u64;
    if (R.is_err[usize, CheckCause](u64_to_usize(portable))) { ret 1; }
    if (R.unwrap_ok[usize, CheckCause](u64_to_usize(portable)) != usize_maximum) { ret 1; }
    if ($size_of(usize) < $size_of(u64)) {
        if (!R.is_err[usize, CheckCause](u64_to_usize(portable + 1))) { ret 1; }
    }
    ret 0;
}

test "mach.lang.layout.checked_ids:enforce_sparse_and_count_bounds" {
    val maximum: usize = ~(0::usize);
    val none: R.Result[CheckedId[TestDomain], CheckCause] = id_below[TestDomain](
        0, count[TestDomain](0));
    if (!R.is_err[CheckedId[TestDomain], CheckCause](none)) { ret 1; }
    val last: R.Result[CheckedId[TestDomain], CheckCause] = id_below[TestDomain](
        9, count[TestDomain](10));
    if (R.is_err[CheckedId[TestDomain], CheckCause](last)) { ret 1; }
    if (R.unwrap_ok[CheckedId[TestDomain], CheckCause](last).value != 9) { ret 1; }
    if (!R.is_err[CheckedId[TestDomain], CheckCause](
        id_below[TestDomain](10, count[TestDomain](10)))) { ret 1; }
    val sparse_maximum: R.Result[CheckedId[TestDomain], CheckCause] = id_at_most[TestDomain](
        maximum, id[TestDomain](maximum));
    if (R.is_err[CheckedId[TestDomain], CheckCause](sparse_maximum)) { ret 1; }
    if (R.unwrap_ok[CheckedId[TestDomain], CheckCause](sparse_maximum).value != maximum) { ret 1; }
    if (!R.is_err[CheckedId[TestDomain], CheckCause](
        id_at_most[TestDomain](10, id[TestDomain](9)))) { ret 1; }
    ret 0;
}

test "mach.lang.layout.checked_pointer_count:validates_shape_extent_and_alignment" {
    val empty: R.Result[CheckedSpan[u32], CheckCause] = pointer_count[u32](nil, 0);
    if (R.is_err[CheckedSpan[u32], CheckCause](empty)) { ret 1; }
    val empty_span: CheckedSpan[u32] = R.unwrap_ok[CheckedSpan[u32], CheckCause](empty);
    if (empty_span.data != nil || empty_span.count != 0 || empty_span.bytes != 0) { ret 1; }
    val nil_nonempty: R.Result[CheckedSpan[u32], CheckCause] = pointer_count[u32](nil, 1);
    if (!R.is_err[CheckedSpan[u32], CheckCause](nil_nonempty)) { ret 1; }
    if (R.unwrap_err[CheckedSpan[u32], CheckCause](nil_nonempty) != CHECK_NIL_POINTER) { ret 1; }
    var storage: [3]u32;
    val valid: R.Result[CheckedSpan[u32], CheckCause] = pointer_count[u32](?storage[0], 3);
    if (R.is_err[CheckedSpan[u32], CheckCause](valid)) { ret 1; }
    val span: CheckedSpan[u32] = R.unwrap_ok[CheckedSpan[u32], CheckCause](valid);
    if (span.count != 3 || span.bytes != 12 || span.begin != (?storage[0])::usize) { ret 1; }
    if (span.end != span.begin + 12) { ret 1; }
    if (!span_valid[u32](?span)) { ret 1; }
    var forged: CheckedSpan[u32] = span;
    forged.bytes = 11;
    if (span_valid[u32](?forged)) { ret 1; }
    val zero_nonnull: R.Result[CheckedSpan[u32], CheckCause] = pointer_count[u32](?storage[0], 0);
    if (R.is_err[CheckedSpan[u32], CheckCause](zero_nonnull)) { ret 1; }
    val misaligned: *u32 = ((?storage[0])::usize + 1)::*u32;
    val bad_alignment: R.Result[CheckedSpan[u32], CheckCause] = pointer_count[u32](misaligned, 1);
    if (!R.is_err[CheckedSpan[u32], CheckCause](bad_alignment)) { ret 1; }
    if (R.unwrap_err[CheckedSpan[u32], CheckCause](bad_alignment) != CHECK_POINTER_ALIGNMENT) { ret 1; }
    val maximum: usize = ~(0::usize);
    val near_end: *u32 = (maximum - 3)::*u32;
    val pointer_overflow: R.Result[CheckedSpan[u32], CheckCause] = pointer_count[u32](near_end, 1);
    if (!R.is_err[CheckedSpan[u32], CheckCause](pointer_overflow)) { ret 1; }
    if (R.unwrap_err[CheckedSpan[u32], CheckCause](pointer_overflow) != CHECK_POINTER_OVERFLOW) { ret 1; }
    val count_overflow: R.Result[CheckedSpan[u32], CheckCause] = pointer_count[u32](?storage[0], maximum);
    if (!R.is_err[CheckedSpan[u32], CheckCause](count_overflow)) { ret 1; }
    if (R.unwrap_err[CheckedSpan[u32], CheckCause](count_overflow) != CHECK_MUL_OVERFLOW) { ret 1; }
    var zero_value: ZeroSized;
    val zero_sized: R.Result[CheckedSpan[ZeroSized], CheckCause] = pointer_count[ZeroSized](
        ?zero_value, 1);
    if (!R.is_err[CheckedSpan[ZeroSized], CheckCause](zero_sized)) { ret 1; }
    if (R.unwrap_err[CheckedSpan[ZeroSized], CheckCause](zero_sized) != CHECK_ZERO_SIZED_ELEMENT) { ret 1; }
    ret 0;
}

fun field_fits(len: usize, off: usize, width: usize) R.Result[bool, CheckCause] {
    val end: R.Result[usize, CheckCause] = usize_add(off, width);
    if (R.is_err[usize, CheckCause](end)) {
        ret R.err[bool, CheckCause](R.unwrap_err[usize, CheckCause](end));
    }
    if (R.unwrap_ok[usize, CheckCause](end) > len) {
        ret R.err[bool, CheckCause](CHECK_INVALID_RANGE);
    }
    ret R.ok[bool, CheckCause](true);
}

fun read_uint_le(buf: *u8, len: usize, off: usize, width: usize) R.Result[u64, CheckCause] {
    val ck: R.Result[bool, CheckCause] = field_fits(len, off, width);
    if (R.is_err[bool, CheckCause](ck)) { ret R.err[u64, CheckCause](R.unwrap_err[bool, CheckCause](ck)); }
    var v: u64 = 0;
    var i: usize = 0;
    for (i < width) {
        v = v | (buf[off + i]::u64 << (i::u64 * 8));
        i = i + 1;
    }
    ret R.ok[u64, CheckCause](v);
}

fun read_uint_be(buf: *u8, len: usize, off: usize, width: usize) R.Result[u64, CheckCause] {
    val ck: R.Result[bool, CheckCause] = field_fits(len, off, width);
    if (R.is_err[bool, CheckCause](ck)) { ret R.err[u64, CheckCause](R.unwrap_err[bool, CheckCause](ck)); }
    var v: u64 = 0;
    var i: usize = 0;
    for (i < width) {
        v = (v << 8) | buf[off + i]::u64;
        i = i + 1;
    }
    ret R.ok[u64, CheckCause](v);
}

fun write_uint_le(buf: *u8, len: usize, off: usize, width: usize, value: u64) R.Result[bool, CheckCause] {
    val ck: R.Result[bool, CheckCause] = field_fits(len, off, width);
    if (R.is_err[bool, CheckCause](ck)) { ret ck; }
    var i: usize = 0;
    for (i < width) {
        buf[off + i] = ((value >> (i::u64 * 8)) & 0xFF)::u8;
        i = i + 1;
    }
    ret R.ok[bool, CheckCause](true);
}

fun write_uint_be(buf: *u8, len: usize, off: usize, width: usize, value: u64) R.Result[bool, CheckCause] {
    val ck: R.Result[bool, CheckCause] = field_fits(len, off, width);
    if (R.is_err[bool, CheckCause](ck)) { ret ck; }
    var i: usize = 0;
    for (i < width) {
        val shift: u64 = ((width - 1 - i)::u64) * 8;
        buf[off + i] = ((value >> shift) & 0xFF)::u8;
        i = i + 1;
    }
    ret R.ok[bool, CheckCause](true);
}

pub fun read_u8(buf: *u8, len: usize, off: usize) R.Result[u8, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_le(buf, len, off, 1);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[u8, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
    var v: u64 = R.unwrap_ok[u64, CheckCause](r);
    ret R.ok[u8, CheckCause](v::u8);
}

pub fun read_i8(buf: *u8, len: usize, off: usize) R.Result[i8, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_le(buf, len, off, 1);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[i8, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
    var v: u64 = R.unwrap_ok[u64, CheckCause](r);
    ret R.ok[i8, CheckCause](v::i8);
}

pub fun write_u8(buf: *u8, len: usize, off: usize, value: u8) R.Result[bool, CheckCause] {
    ret write_uint_le(buf, len, off, 1, value::u64);
}

pub fun write_i8(buf: *u8, len: usize, off: usize, value: i8) R.Result[bool, CheckCause] {
    ret write_uint_le(buf, len, off, 1, value::u64);
}

pub fun read_u16_le(buf: *u8, len: usize, off: usize) R.Result[u16, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_le(buf, len, off, 2);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[u16, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
    var v: u64 = R.unwrap_ok[u64, CheckCause](r);
    ret R.ok[u16, CheckCause](v::u16);
}

pub fun read_u16_be(buf: *u8, len: usize, off: usize) R.Result[u16, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_be(buf, len, off, 2);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[u16, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
    var v: u64 = R.unwrap_ok[u64, CheckCause](r);
    ret R.ok[u16, CheckCause](v::u16);
}

pub fun read_i16_le(buf: *u8, len: usize, off: usize) R.Result[i16, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_le(buf, len, off, 2);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[i16, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
    var v: u64 = R.unwrap_ok[u64, CheckCause](r);
    ret R.ok[i16, CheckCause](v::i16);
}

pub fun read_i16_be(buf: *u8, len: usize, off: usize) R.Result[i16, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_be(buf, len, off, 2);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[i16, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
    var v: u64 = R.unwrap_ok[u64, CheckCause](r);
    ret R.ok[i16, CheckCause](v::i16);
}

pub fun write_u16_le(buf: *u8, len: usize, off: usize, value: u16) R.Result[bool, CheckCause] {
    ret write_uint_le(buf, len, off, 2, value::u64);
}

pub fun write_u16_be(buf: *u8, len: usize, off: usize, value: u16) R.Result[bool, CheckCause] {
    ret write_uint_be(buf, len, off, 2, value::u64);
}

pub fun write_i16_le(buf: *u8, len: usize, off: usize, value: i16) R.Result[bool, CheckCause] {
    ret write_uint_le(buf, len, off, 2, value::u64);
}

pub fun write_i16_be(buf: *u8, len: usize, off: usize, value: i16) R.Result[bool, CheckCause] {
    ret write_uint_be(buf, len, off, 2, value::u64);
}

pub fun read_u24_le(buf: *u8, len: usize, off: usize) R.Result[u32, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_le(buf, len, off, 3);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[u32, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
    var v: u64 = R.unwrap_ok[u64, CheckCause](r);
    ret R.ok[u32, CheckCause](v::u32);
}

pub fun read_u24_be(buf: *u8, len: usize, off: usize) R.Result[u32, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_be(buf, len, off, 3);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[u32, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
    var v: u64 = R.unwrap_ok[u64, CheckCause](r);
    ret R.ok[u32, CheckCause](v::u32);
}

pub fun read_i24_le(buf: *u8, len: usize, off: usize) R.Result[i32, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_le(buf, len, off, 3);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[i32, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
    var v: u64 = R.unwrap_ok[u64, CheckCause](r);
    if ((v & 0x800000::u64) != 0) { v = v | 0xFF800000::u64; }
    ret R.ok[i32, CheckCause](v::i32);
}

pub fun read_i24_be(buf: *u8, len: usize, off: usize) R.Result[i32, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_be(buf, len, off, 3);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[i32, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
    var v: u64 = R.unwrap_ok[u64, CheckCause](r);
    if ((v & 0x800000::u64) != 0) { v = v | 0xFF800000::u64; }
    ret R.ok[i32, CheckCause](v::i32);
}

pub fun write_u24_le(buf: *u8, len: usize, off: usize, value: u32) R.Result[bool, CheckCause] {
    if (value > 0xFFFFFF::u32) { ret R.err[bool, CheckCause](CHECK_NARROWING); }
    ret write_uint_le(buf, len, off, 3, value::u64);
}

pub fun write_u24_be(buf: *u8, len: usize, off: usize, value: u32) R.Result[bool, CheckCause] {
    if (value > 0xFFFFFF::u32) { ret R.err[bool, CheckCause](CHECK_NARROWING); }
    ret write_uint_be(buf, len, off, 3, value::u64);
}

pub fun write_i24_le(buf: *u8, len: usize, off: usize, value: i32) R.Result[bool, CheckCause] {
    if (value < -0x800000::i32 || value > 0x7FFFFF::i32) { ret R.err[bool, CheckCause](CHECK_NARROWING); }
    ret write_uint_le(buf, len, off, 3, (value::u64) & 0xFFFFFF::u64);
}

pub fun write_i24_be(buf: *u8, len: usize, off: usize, value: i32) R.Result[bool, CheckCause] {
    if (value < -0x800000::i32 || value > 0x7FFFFF::i32) { ret R.err[bool, CheckCause](CHECK_NARROWING); }
    ret write_uint_be(buf, len, off, 3, (value::u64) & 0xFFFFFF::u64);
}

pub fun read_u32_le(buf: *u8, len: usize, off: usize) R.Result[u32, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_le(buf, len, off, 4);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[u32, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
    var v: u64 = R.unwrap_ok[u64, CheckCause](r);
    ret R.ok[u32, CheckCause](v::u32);
}

pub fun read_u32_be(buf: *u8, len: usize, off: usize) R.Result[u32, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_be(buf, len, off, 4);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[u32, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
    var v: u64 = R.unwrap_ok[u64, CheckCause](r);
    ret R.ok[u32, CheckCause](v::u32);
}

pub fun read_i32_le(buf: *u8, len: usize, off: usize) R.Result[i32, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_le(buf, len, off, 4);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[i32, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
    var v: u64 = R.unwrap_ok[u64, CheckCause](r);
    ret R.ok[i32, CheckCause](v::i32);
}

pub fun read_i32_be(buf: *u8, len: usize, off: usize) R.Result[i32, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_be(buf, len, off, 4);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[i32, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
    var v: u64 = R.unwrap_ok[u64, CheckCause](r);
    ret R.ok[i32, CheckCause](v::i32);
}

pub fun write_u32_le(buf: *u8, len: usize, off: usize, value: u32) R.Result[bool, CheckCause] {
    ret write_uint_le(buf, len, off, 4, value::u64);
}

pub fun write_u32_be(buf: *u8, len: usize, off: usize, value: u32) R.Result[bool, CheckCause] {
    ret write_uint_be(buf, len, off, 4, value::u64);
}

pub fun write_i32_le(buf: *u8, len: usize, off: usize, value: i32) R.Result[bool, CheckCause] {
    ret write_uint_le(buf, len, off, 4, value::u64);
}

pub fun write_i32_be(buf: *u8, len: usize, off: usize, value: i32) R.Result[bool, CheckCause] {
    ret write_uint_be(buf, len, off, 4, value::u64);
}

pub fun read_u64_le(buf: *u8, len: usize, off: usize) R.Result[u64, CheckCause] {
    val r: R.Result[u64, CheckCause] = read_uint_le(buf, len, off, 8);
    if (R.is_err[u64, CheckCause](r)) { ret R.err[u64, CheckCause](R.unwrap_err[u64, CheckCause](r)); }
