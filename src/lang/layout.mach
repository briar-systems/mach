use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

pub def CheckCause: u8;

pub val CHECK_ADD_OVERFLOW:        CheckCause = 1;
#[testing]
val     CHECK_SUB_UNDERFLOW:       CheckCause = 2;
val     CHECK_MUL_OVERFLOW:        CheckCause = 3;
val     CHECK_INVALID_ALIGNMENT:   CheckCause = 4;
val     CHECK_NON_POWER_ALIGNMENT: CheckCause = 5;
val     CHECK_INVALID_RANGE:       CheckCause = 6;
val     CHECK_NARROWING:           CheckCause = 7;
val     CHECK_ID_RANGE:            CheckCause = 8;
#[testing]
val     CHECK_NIL_POINTER:         CheckCause = 9;
#[testing]
val     CHECK_ZERO_SIZED_ELEMENT:  CheckCause = 10;
#[testing]
val     CHECK_POINTER_ALIGNMENT:   CheckCause = 11;
#[testing]
val     CHECK_POINTER_OVERFLOW:    CheckCause = 12;

pub rec ByteUnit {}

pub rec MemorySpace {}

pub rec CheckedCount[Unit] {
    value: usize;
}

pub rec CheckedOffset[Unit] {
    value: usize;
}

pub rec CheckedAddress[Space] {
    value: usize;
}

rec CheckedRange[Unit] {
    start: CheckedOffset[Unit];
    end:   CheckedOffset[Unit];
}

pub rec CheckedAlignment[Unit] {
    value: usize;
}

pub rec CheckedPowerAlignment[Unit] {
    value: usize;
}

pub rec CheckedId[Domain] {
    value: usize;
}

#[testing]
rec CheckedSpan[T] {
    data:  *T;
    count: usize;
    bytes: usize;
    begin: usize;
    end:   usize;
}

pub fun usize_add(left: usize, right: usize) res[usize, CheckCause] {
    val maximum: usize = ~(0::usize);
    if (right > maximum - left) { ret res[usize, CheckCause].err{CHECK_ADD_OVERFLOW}; }
    ret res[usize, CheckCause].ok{left + right};
}

pub fun usize_mul(left: usize, right: usize) res[usize, CheckCause] {
    val maximum: usize = ~(0::usize);
    if (left != 0 && right > maximum / left) { ret res[usize, CheckCause].err{CHECK_MUL_OVERFLOW}; }
    ret res[usize, CheckCause].ok{left * right};
}

pub fun count[Unit](value: usize) CheckedCount[Unit] {
    var out: CheckedCount[Unit];
    out.value = value;
    ret out;
}

pub fun offset[Unit](value: usize) CheckedOffset[Unit] {
    var out: CheckedOffset[Unit];
    out.value = value;
    ret out;
}

pub fun address[Space](value: usize) CheckedAddress[Space] {
    var out: CheckedAddress[Space];
    out.value = value;
    ret out;
}

pub fun count_add[Unit](left: CheckedCount[Unit], right: CheckedCount[Unit])
    res[CheckedCount[Unit], CheckCause] {
    val added: res[usize, CheckCause] = usize_add(left.value, right.value);
    if (sel added.err) {
        ret res[CheckedCount[Unit], CheckCause].err{added.err};
    }
    ret res[CheckedCount[Unit], CheckCause].ok{count[Unit](added.ok)};
}

#[testing]
fun count_sub[Unit](left: CheckedCount[Unit], right: CheckedCount[Unit])
    res[CheckedCount[Unit], CheckCause] {
    if (right.value > left.value) {
        ret res[CheckedCount[Unit], CheckCause].err{CHECK_SUB_UNDERFLOW};
    }
    ret res[CheckedCount[Unit], CheckCause].ok{count[Unit](left.value - right.value)};
}

pub fun count_mul[Unit](value: CheckedCount[Unit], factor: usize)
    res[CheckedCount[Unit], CheckCause] {
    val multiplied: res[usize, CheckCause] = usize_mul(value.value, factor);
    if (sel multiplied.err) {
        ret res[CheckedCount[Unit], CheckCause].err{multiplied.err};
    }
    ret res[CheckedCount[Unit], CheckCause].ok{count[Unit](multiplied.ok)};
}

pub fun count_grow[Unit](current: CheckedCount[Unit], required: CheckedCount[Unit])
    res[CheckedCount[Unit], CheckCause] {
    if (required.value <= current.value) { ret res[CheckedCount[Unit], CheckCause].ok{current}; }
    if (current.value == 0) {
        var first: usize = 1;
        if (required.value > first) { first = required.value; }
        ret res[CheckedCount[Unit], CheckCause].ok{count[Unit](first)};
    }
    val doubled: res[usize, CheckCause] = usize_mul(current.value, 2);
    var next:    usize                  = required.value;
    if (sel doubled.ok) {
        val candidate: usize = doubled.ok;
        if (candidate > next) { next = candidate; }
    }
    if (next <= current.value || next < required.value) {
        ret res[CheckedCount[Unit], CheckCause].err{CHECK_ADD_OVERFLOW};
    }
    ret res[CheckedCount[Unit], CheckCause].ok{count[Unit](next)};
}

pub fun offset_add[Unit](base: CheckedOffset[Unit], amount: CheckedCount[Unit])
    res[CheckedOffset[Unit], CheckCause] {
    val added: res[usize, CheckCause] = usize_add(base.value, amount.value);
    if (sel added.err) {
        ret res[CheckedOffset[Unit], CheckCause].err{added.err};
    }
    ret res[CheckedOffset[Unit], CheckCause].ok{offset[Unit](added.ok)};
}

pub fun address_add[Space](base: CheckedAddress[Space], amount: CheckedCount[ByteUnit])
    res[CheckedAddress[Space], CheckCause] {
    val added: res[usize, CheckCause] = usize_add(base.value, amount.value);
    if (sel added.err) {
        ret res[CheckedAddress[Space], CheckCause].err{added.err};
    }
    ret res[CheckedAddress[Space], CheckCause].ok{address[Space](added.ok)};
}

fun checked_range[Unit](start: CheckedOffset[Unit], end: CheckedOffset[Unit])
    res[CheckedRange[Unit], CheckCause] {
    if (end.value < start.value) {
        ret res[CheckedRange[Unit], CheckCause].err{CHECK_INVALID_RANGE};
    }
    var out: CheckedRange[Unit];
    out.start = start;
    out.end   = end;
    ret res[CheckedRange[Unit], CheckCause].ok{out};
}

fun range_from_count[Unit](start: CheckedOffset[Unit], length: CheckedCount[Unit])
    res[CheckedRange[Unit], CheckCause] {
    val end: res[CheckedOffset[Unit], CheckCause] = offset_add[Unit](start, length);
    if (sel end.err) {
        ret res[CheckedRange[Unit], CheckCause].err{end.err};
    }
    ret checked_range[Unit](start, end.ok);
}

#[testing]
pub fun range_count[Unit](value: CheckedRange[Unit]) res[CheckedCount[Unit], CheckCause] {
    if (value.end.value < value.start.value) {
        ret res[CheckedCount[Unit], CheckCause].err{CHECK_INVALID_RANGE};
    }
    ret res[CheckedCount[Unit], CheckCause].ok{count[Unit](value.end.value - value.start.value)};
}

#[testing]
fun range_contains[Unit](value: CheckedRange[Unit], position: CheckedOffset[Unit]) bool {
    if (value.end.value < value.start.value) { ret false; }
    ret position.value >= value.start.value && position.value < value.end.value;
}

#[testing]
fun range_contains_range[Unit](outer: CheckedRange[Unit], inner: CheckedRange[Unit]) bool {
    if (outer.end.value < outer.start.value || inner.end.value < inner.start.value) { ret false; }
    ret inner.start.value >= outer.start.value && inner.end.value <= outer.end.value;
}

pub fun range_fits[Unit](available: CheckedCount[Unit], start: CheckedOffset[Unit],
    length: CheckedCount[Unit]) bool {
    val made: res[CheckedRange[Unit], CheckCause] = range_from_count[Unit](start, length);
    if (sel made.err) { ret false; }
    ret made.ok.end.value <= available.value;
}

pub fun alignment[Unit](value: usize) res[CheckedAlignment[Unit], CheckCause] {
    if (value == 0) { ret res[CheckedAlignment[Unit], CheckCause].err{CHECK_INVALID_ALIGNMENT}; }
    var out: CheckedAlignment[Unit];
    out.value = value;
    ret res[CheckedAlignment[Unit], CheckCause].ok{out};
}

pub fun power_alignment[Unit](value: usize) res[CheckedPowerAlignment[Unit], CheckCause] {
    if (value == 0) {
        ret res[CheckedPowerAlignment[Unit], CheckCause].err{CHECK_INVALID_ALIGNMENT};
    }
    if ((value & (value - 1)) != 0) {
        ret res[CheckedPowerAlignment[Unit], CheckCause].err{CHECK_NON_POWER_ALIGNMENT};
    }
    var out: CheckedPowerAlignment[Unit];
    out.value = value;
    ret res[CheckedPowerAlignment[Unit], CheckCause].ok{out};
}

#[testing]
fun general_alignment[Unit](value: CheckedPowerAlignment[Unit])
    res[CheckedAlignment[Unit], CheckCause] {
    val checked: res[CheckedPowerAlignment[Unit], CheckCause] = power_alignment[Unit](value.value);
    if (sel checked.err) {
        ret res[CheckedAlignment[Unit], CheckCause].err{checked.err};
    }
    ret alignment[Unit](value.value);
}

pub fun align_offset_up[Unit](value: CheckedOffset[Unit], align: CheckedAlignment[Unit])
    res[CheckedOffset[Unit], CheckCause] {
    if (align.value == 0) {
        ret res[CheckedOffset[Unit], CheckCause].err{CHECK_INVALID_ALIGNMENT};
    }
    val remainder: usize = value.value % align.value;
    if (remainder == 0) { ret res[CheckedOffset[Unit], CheckCause].ok{value}; }
    ret offset_add[Unit](value, count[Unit](align.value - remainder));
}

# the address-space twin of align_offset_up: a u64 value rounded up to a
# power-of-two alignment, refusing an invalid alignment and an overflow
pub fun align_u64_up(value: u64, align: u64) res[u64, CheckCause] {
    if (align == 0)                 { ret res[u64, CheckCause].err{CHECK_INVALID_ALIGNMENT}; }
    if ((align & (align - 1)) != 0) { ret res[u64, CheckCause].err{CHECK_NON_POWER_ALIGNMENT}; }
    val remainder: u64 = value % align;
    if (remainder == 0) { ret res[u64, CheckCause].ok{value}; }
    val pad_by: u64 = align - remainder;
    if (pad_by > ~(0::u64) - value) { ret res[u64, CheckCause].err{CHECK_ADD_OVERFLOW}; }
    ret res[u64, CheckCause].ok{value + pad_by};
}

#[testing]
fun align_offset_down[Unit](value: CheckedOffset[Unit], align: CheckedAlignment[Unit])
    res[CheckedOffset[Unit], CheckCause] {
    if (align.value == 0) {
        ret res[CheckedOffset[Unit], CheckCause].err{CHECK_INVALID_ALIGNMENT};
    }
    ret res[CheckedOffset[Unit], CheckCause].ok{offset[Unit](value.value - value.value % align.value)};
}

pub fun id[Domain](value: usize) CheckedId[Domain] {
    var out: CheckedId[Domain];
    out.value = value;
    ret out;
}

pub fun id_below[Domain](value: usize, upper: CheckedCount[Domain])
    res[CheckedId[Domain], CheckCause] {
    if (value >= upper.value) { ret res[CheckedId[Domain], CheckCause].err{CHECK_ID_RANGE}; }
    ret res[CheckedId[Domain], CheckCause].ok{id[Domain](value)};
}

#[testing]
pub fun usize_to_u8(value: usize) res[u8, CheckCause] {
    if (value::u8::usize != value) { ret res[u8, CheckCause].err{CHECK_NARROWING}; }
    ret res[u8, CheckCause].ok{value::u8};
}

pub fun usize_to_u16(value: usize) res[u16, CheckCause] {
    if (value::u16::usize != value) { ret res[u16, CheckCause].err{CHECK_NARROWING}; }
    ret res[u16, CheckCause].ok{value::u16};
}

pub fun usize_to_u32(value: usize) res[u32, CheckCause] {
    if (value::u32::usize != value) { ret res[u32, CheckCause].err{CHECK_NARROWING}; }
    ret res[u32, CheckCause].ok{value::u32};
}

#[testing]
fun u64_to_usize(value: u64) res[usize, CheckCause] {
    if (value::usize::u64 != value) { ret res[usize, CheckCause].err{CHECK_NARROWING}; }
    ret res[usize, CheckCause].ok{value::usize};
}

pub fun u64_to_u32(value: u64) res[u32, CheckCause] {
    if (value::u32::u64 != value) { ret res[u32, CheckCause].err{CHECK_NARROWING}; }
    ret res[u32, CheckCause].ok{value::u32};
}

#[testing]
fun i64_to_i32(value: i64) res[i32, CheckCause] {
    if (value::i32::i64 != value) { ret res[i32, CheckCause].err{CHECK_NARROWING}; }
    ret res[i32, CheckCause].ok{value::i32};
}

#[testing]
fun i64_to_u32(value: i64) res[u32, CheckCause] {
    if (value < 0 || value::u32::i64 != value) { ret res[u32, CheckCause].err{CHECK_NARROWING}; }
    ret res[u32, CheckCause].ok{value::u32};
}

pub fun usize_to_i32(value: usize) res[i32, CheckCause] {
    if (value > 2147483647) { ret res[i32, CheckCause].err{CHECK_NARROWING}; }
    ret res[i32, CheckCause].ok{value::i32};
}

#[testing]
fun pointer_count[T](data: *T, count: usize) res[CheckedSpan[T], CheckCause] {
    if (count > 0 && data == nil) { ret res[CheckedSpan[T], CheckCause].err{CHECK_NIL_POINTER}; }
    if (count > 0 && $size_of(T) == 0) {
        ret res[CheckedSpan[T], CheckCause].err{CHECK_ZERO_SIZED_ELEMENT};
    }
    val multiplied: res[usize, CheckCause] = usize_mul(count, $size_of(T));
    if (sel multiplied.err) {
        ret res[CheckedSpan[T], CheckCause].err{multiplied.err};
    }
    val bytes: usize = multiplied.ok;
    var begin: usize = 0;
    if (data != nil) {
        begin = data::usize;
        if (begin % $align_of(T) != 0) {
            ret res[CheckedSpan[T], CheckCause].err{CHECK_POINTER_ALIGNMENT};
        }
    }
    val added: res[usize, CheckCause] = usize_add(begin, bytes);
    if (sel added.err) {
        ret res[CheckedSpan[T], CheckCause].err{CHECK_POINTER_OVERFLOW};
    }
    var out: CheckedSpan[T];
    out.data  = data;
    out.count = count;
    out.bytes = bytes;
    out.begin = begin;
    out.end   = added.ok;
    ret res[CheckedSpan[T], CheckCause].ok{out};
}

#[testing]
fun span_valid[T](value: *CheckedSpan[T]) bool {
    if (value == nil) { ret false; }
    val made: res[CheckedSpan[T], CheckCause] = pointer_count[T](value.data, value.count);
    if (sel made.err) { ret false; }
    val expected: CheckedSpan[T] = made.ok;
    ret value.data == expected.data && value.count == expected.count
        && value.bytes == expected.bytes && value.begin == expected.begin && value.end == expected.end;
}

#[testing]
rec TestUnit {}

#[testing]
rec ZeroSized {}

#[testing]
fun count_is_error(result: res[CheckedCount[TestUnit], CheckCause], cause: CheckCause) bool {
    if (!sel result.err) { ret false; }
    ret result.err == cause;
}

test count__add_sub_mul_boundaries {
    val maximum:  usize                                   = ~(0::usize);
    val zero:     CheckedCount[TestUnit]                  = count[TestUnit](0);
    val one:      CheckedCount[TestUnit]                  = count[TestUnit](1);
    val largest:  CheckedCount[TestUnit]                  = count[TestUnit](maximum);
    val zero_sum: res[CheckedCount[TestUnit], CheckCause] = count_add[TestUnit](zero, zero);
    if (sel zero_sum.err)       { ret 1; }
    if (zero_sum.ok.value != 0) { ret 1; }
    val maximum_sum: res[CheckedCount[TestUnit], CheckCause] = count_add[TestUnit](largest, zero);
    if (sel maximum_sum.err)                                                    { ret 1; }
    if (maximum_sum.ok.value != maximum)                                        { ret 1; }
    if (!count_is_error(count_add[TestUnit](largest, one), CHECK_ADD_OVERFLOW)) { ret 1; }
    if (!count_is_error(count_sub[TestUnit](zero, one), CHECK_SUB_UNDERFLOW))   { ret 1; }
    val maximum_sub: res[CheckedCount[TestUnit], CheckCause] = count_sub[TestUnit](largest, largest);
    if (sel maximum_sub.err)       { ret 1; }
    if (maximum_sub.ok.value != 0) { ret 1; }
    val zero_product: res[CheckedCount[TestUnit], CheckCause] = count_mul[TestUnit](largest, 0);
    if (sel zero_product.err)       { ret 1; }
    if (zero_product.ok.value != 0) { ret 1; }
    val maximum_product: res[CheckedCount[TestUnit], CheckCause] = count_mul[TestUnit](largest, 1);
    if (sel maximum_product.err)                                              { ret 1; }
    if (maximum_product.ok.value != maximum)                                  { ret 1; }
    if (!count_is_error(count_mul[TestUnit](largest, 2), CHECK_MUL_OVERFLOW)) { ret 1; }
    ret 0;
}

#[testing]
fun grows_to(current: usize, required: usize, expect: usize) bool {
    val grown: res[CheckedCount[TestUnit], CheckCause] = count_grow[TestUnit](count[TestUnit](current), count[TestUnit](required));
    if (sel grown.err) { ret false; }
    ret grown.ok.value == expect;
}

test count_grow__meets_required_progress {
    val maximum: usize = ~(0::usize);
    if (!grows_to(5, 3, 5))                                             { ret 1; }
    if (!grows_to(0, 0, 0) || !grows_to(0, 1, 1) || !grows_to(0, 9, 9)) { ret 2; }
    if (!grows_to(4, 5, 8) || !grows_to(4, 20, 20))                     { ret 3; }
    if (!grows_to(maximum / 2 + 1, maximum / 2 + 2, maximum / 2 + 2))   { ret 4; }
    if (!grows_to(maximum - 1, maximum, maximum))                       { ret 5; }
    if (!grows_to(maximum, maximum, maximum))                           { ret 6; }
    ret 0;
}

test alignment__general_and_power_boundaries {
    val maximum: usize                                       = ~(0::usize);
    val zero:    res[CheckedAlignment[TestUnit], CheckCause] = alignment[TestUnit](0);
    if (!sel zero.err)                       { ret 1; }
    if (zero.err != CHECK_INVALID_ALIGNMENT) { ret 1; }
    val zero_power: res[CheckedPowerAlignment[TestUnit], CheckCause] = power_alignment[TestUnit](0);
    if (!sel zero_power.err) { ret 1; }
    if (zero_power.err != CHECK_INVALID_ALIGNMENT) {
        ret 1;
    }
    val three_power: res[CheckedPowerAlignment[TestUnit], CheckCause] = power_alignment[TestUnit](3);
    if (!sel three_power.err)                         { ret 1; }
    if (three_power.err != CHECK_NON_POWER_ALIGNMENT) { ret 1; }
    val general_three: res[CheckedAlignment[TestUnit], CheckCause] = alignment[TestUnit](3);
    if (sel general_three.err)       { ret 1; }
    if (general_three.ok.value != 3) { ret 1; }
    val six: res[CheckedOffset[TestUnit], CheckCause] = align_offset_up[TestUnit](
        offset[TestUnit](4), general_three.ok);
    if (sel six.err)       { ret 1; }
    if (six.ok.value != 6) { ret 1; }
    val kept: res[CheckedOffset[TestUnit], CheckCause] = align_offset_up[TestUnit](six.ok, general_three.ok);
    if (sel kept.err)       { ret 1; }
    if (kept.ok.value != 6) { ret 1; }
    val two_power_r: res[CheckedPowerAlignment[TestUnit], CheckCause] = power_alignment[TestUnit](2);
    if (sel two_power_r.err) { ret 1; }
    val two_power: CheckedPowerAlignment[TestUnit]             = two_power_r.ok;
    val two_made:  res[CheckedAlignment[TestUnit], CheckCause] = general_alignment[TestUnit](
        two_power);
    if (sel two_made.err) { ret 1; }
    val two:      CheckedAlignment[TestUnit]               = two_made.ok;
    val overflow: res[CheckedOffset[TestUnit], CheckCause] = align_offset_up[TestUnit](
        offset[TestUnit](maximum), two);
    if (!sel overflow.err)                  { ret 1; }
    if (overflow.err != CHECK_ADD_OVERFLOW) { ret 1; }
    val down: res[CheckedOffset[TestUnit], CheckCause] = align_offset_down[TestUnit](
        offset[TestUnit](maximum), two);
    if (sel down.err)                 { ret 1; }
    if (down.ok.value != maximum - 1) { ret 1; }

    var forged_zero:        CheckedPowerAlignment[TestUnit];
    val forged_zero_result: res[CheckedAlignment[TestUnit], CheckCause] = general_alignment[TestUnit](
        forged_zero);
    if (!sel forged_zero_result.err)                       { ret 1; }
    if (forged_zero_result.err != CHECK_INVALID_ALIGNMENT) { ret 1; }
    var forged_three: CheckedPowerAlignment[TestUnit];
    forged_three.value = 3;
    val forged_three_result: res[CheckedAlignment[TestUnit], CheckCause] = general_alignment[TestUnit](
        forged_three);
    if (!sel forged_three_result.err)                         { ret 1; }
    if (forged_three_result.err != CHECK_NON_POWER_ALIGNMENT) { ret 1; }
    ret 0;
}

test checked_range__is_half_open_and_overflow_safe {
    val maximum: usize                                   = ~(0::usize);
    val made:    res[CheckedRange[TestUnit], CheckCause] = range_from_count[TestUnit](
        offset[TestUnit](5), count[TestUnit](3));
    if (sel made.err) { ret 1; }
    val value: CheckedRange[TestUnit] = made.ok;
    if (!range_contains[TestUnit](value, offset[TestUnit](5))) { ret 1; }
    if (!range_contains[TestUnit](value, offset[TestUnit](7))) { ret 1; }
    if (range_contains[TestUnit](value, offset[TestUnit](8)))  { ret 1; }
    val length: res[CheckedCount[TestUnit], CheckCause] = range_count[TestUnit](value);
    if (sel length.err)       { ret 1; }
    if (length.ok.value != 3) { ret 1; }
    val inner_r: res[CheckedRange[TestUnit], CheckCause] = checked_range[TestUnit](offset[TestUnit](6), offset[TestUnit](8));
    if (sel inner_r.err) { ret 1; }
    val inner: CheckedRange[TestUnit] = inner_r.ok;
    if (!range_contains_range[TestUnit](value, inner))                                      { ret 1; }
    if (!range_fits[TestUnit](count[TestUnit](8), offset[TestUnit](5), count[TestUnit](3))) { ret 1; }
    if (range_fits[TestUnit](count[TestUnit](7), offset[TestUnit](5), count[TestUnit](3)))  { ret 1; }
    if (range_fits[TestUnit](count[TestUnit](maximum), offset[TestUnit](maximum),
        count[TestUnit](1))) { ret 1; }
    val empty_r: res[CheckedRange[TestUnit], CheckCause] = checked_range[TestUnit](offset[TestUnit](maximum), offset[TestUnit](maximum));
    if (sel empty_r.err) { ret 1; }
    val empty: CheckedRange[TestUnit] = empty_r.ok;
    if (range_contains[TestUnit](empty, offset[TestUnit](maximum))) { ret 1; }
    if (!range_contains_range[TestUnit](empty, empty))              { ret 1; }
    val reversed: res[CheckedRange[TestUnit], CheckCause] = checked_range[TestUnit](
        offset[TestUnit](9), offset[TestUnit](8));
    if (!sel reversed.err)                   { ret 1; }
    if (reversed.err != CHECK_INVALID_RANGE) { ret 1; }
    val overflow: res[CheckedRange[TestUnit], CheckCause] = range_from_count[TestUnit](
        offset[TestUnit](maximum), count[TestUnit](1));
    if (!sel overflow.err)                  { ret 1; }
    if (overflow.err != CHECK_ADD_OVERFLOW) { ret 1; }
    var forged: CheckedRange[TestUnit];
    forged.start = offset[TestUnit](2);
    forged.end   = offset[TestUnit](1);
    if (range_contains[TestUnit](forged, offset[TestUnit](1))) { ret 1; }
    val r_591: res[CheckedCount[TestUnit], CheckCause] = range_count[TestUnit](forged);
    if (!sel r_591.err) { ret 1; }
    ret 0;
}

test narrowing__rejects_one_past_each_boundary {
    val usize_maximum: usize               = ~(0::usize);
    val r_662:         res[u8, CheckCause] = usize_to_u8(255);
    if (sel r_662.err) { ret 1; }
    val r_663: res[u8, CheckCause] = usize_to_u8(256);
    if (!sel r_663.err) { ret 1; }
    if (usize_maximum <= 65535) {
        val r_665: res[u16, CheckCause] = usize_to_u16(usize_maximum);
        if (sel r_665.err) { ret 1; }
    }
    or {
        val r_668: res[u16, CheckCause] = usize_to_u16(usize_maximum);
        if (!sel r_668.err) { ret 1; }
    }
    if (usize_maximum > 65535) {
        val r_671: res[u16, CheckCause] = usize_to_u16(65535);
        if (sel r_671.err) { ret 1; }
        val r_672: res[u16, CheckCause] = usize_to_u16(65536);
        if (!sel r_672.err) { ret 1; }
    }
    if (usize_maximum <= 4294967295) {
        val r_675: res[u32, CheckCause] = usize_to_u32(usize_maximum);
        if (sel r_675.err) { ret 1; }
    }
    or {
        val r_678: res[u32, CheckCause] = usize_to_u32(4294967295);
        if (sel r_678.err) { ret 1; }
        val r_679: res[u32, CheckCause] = usize_to_u32(4294967296::usize);
        if (!sel r_679.err) { ret 1; }
    }
    val r_681: res[u32, CheckCause] = u64_to_u32(4294967295);
    if (sel r_681.err) { ret 1; }
    val r_682: res[u32, CheckCause] = u64_to_u32(4294967296);
    if (!sel r_682.err) { ret 1; }
    val r_683: res[i32, CheckCause] = i64_to_i32(-2147483648);
    if (sel r_683.err) { ret 1; }
    val r_684: res[i32, CheckCause] = i64_to_i32(2147483647);
    if (sel r_684.err) { ret 1; }
    val r_685: res[i32, CheckCause] = i64_to_i32(-2147483649);
    if (!sel r_685.err) { ret 1; }
    val r_686: res[i32, CheckCause] = i64_to_i32(2147483648);
    if (!sel r_686.err) { ret 1; }
    val r_687: res[u32, CheckCause] = i64_to_u32(0);
    if (sel r_687.err) { ret 1; }
    val r_688: res[u32, CheckCause] = i64_to_u32(-1);
    if (!sel r_688.err) { ret 1; }
    val r_689: res[u32, CheckCause] = i64_to_u32(4294967296);
    if (!sel r_689.err) { ret 1; }
    if (usize_maximum <= 2147483647) {
        val r_691: res[i32, CheckCause] = usize_to_i32(usize_maximum);
        if (sel r_691.err) { ret 1; }
    }
    or {
        val r_694: res[i32, CheckCause] = usize_to_i32(2147483647);
        if (sel r_694.err) { ret 1; }
        val r_695: res[i32, CheckCause] = usize_to_i32(2147483648);
        if (!sel r_695.err) { ret 1; }
    }
    val portable: u64                    = usize_maximum::u64;
    val r_698:    res[usize, CheckCause] = u64_to_usize(portable);
    if (sel r_698.err) { ret 1; }
    val r_699: res[usize, CheckCause] = u64_to_usize(portable);
    if (sel r_699.err)             { ret 1; }
    if (r_699.ok != usize_maximum) { ret 1; }
    if ($size_of(usize) < $size_of(u64)) {
        val r_701: res[usize, CheckCause] = u64_to_usize(portable + 1);
        if (!sel r_701.err) { ret 1; }
    }
    ret 0;
}

test pointer_count__validates_shape_extent_and_alignment {
    val empty: res[CheckedSpan[u32], CheckCause] = pointer_count[u32](nil, 0);
    if (sel empty.err) { ret 1; }
    val empty_span: CheckedSpan[u32] = empty.ok;
    if (empty_span.data != nil || empty_span.count != 0 || empty_span.bytes != 0) { ret 1; }
    val nil_nonempty: res[CheckedSpan[u32], CheckCause] = pointer_count[u32](nil, 1);
    if (!sel nil_nonempty.err)                 { ret 1; }
    if (nil_nonempty.err != CHECK_NIL_POINTER) { ret 1; }
    var storage: [3]u32;
    val valid:   res[CheckedSpan[u32], CheckCause] = pointer_count[u32](?storage[0], 3);
    if (sel valid.err) { ret 1; }
    val span: CheckedSpan[u32] = valid.ok;
    if (span.count != 3 || span.bytes != 12 || span.begin != (?storage[0])::usize) { ret 1; }
    if (span.end != span.begin + 12)                                               { ret 1; }
    if (!span_valid[u32](?span))                                                   { ret 1; }
    var forged: CheckedSpan[u32] = span;
    forged.bytes = 11;
    if (span_valid[u32](?forged)) { ret 1; }
    val zero_nonnull: res[CheckedSpan[u32], CheckCause] = pointer_count[u32](?storage[0], 0);
    if (sel zero_nonnull.err) { ret 1; }
    val misaligned:    *u32                              = ((?storage[0])::usize + 1)::*u32;
    val bad_alignment: res[CheckedSpan[u32], CheckCause] = pointer_count[u32](misaligned, 1);
    if (!sel bad_alignment.err)                       { ret 1; }
    if (bad_alignment.err != CHECK_POINTER_ALIGNMENT) { ret 1; }
    val maximum:          usize                             = ~(0::usize);
    val near_end:         *u32                              = (maximum - 3)::*u32;
    val pointer_overflow: res[CheckedSpan[u32], CheckCause] = pointer_count[u32](near_end, 1);
    if (!sel pointer_overflow.err)                      { ret 1; }
    if (pointer_overflow.err != CHECK_POINTER_OVERFLOW) { ret 1; }
    val count_overflow: res[CheckedSpan[u32], CheckCause] = pointer_count[u32](?storage[0], maximum);
    if (!sel count_overflow.err)                  { ret 1; }
    if (count_overflow.err != CHECK_MUL_OVERFLOW) { ret 1; }
    var zero_value: ZeroSized;
    val zero_sized: res[CheckedSpan[ZeroSized], CheckCause] = pointer_count[ZeroSized](
        ?zero_value, 1);
    if (!sel zero_sized.err)                        { ret 1; }
    if (zero_sized.err != CHECK_ZERO_SIZED_ELEMENT) { ret 1; }
    ret 0;
}

def NodeKind: u8;

pub val NODE_UNKNOWN:   NodeKind = 0;
pub val NODE_SCALAR:    NodeKind = 1;
pub val NODE_POINTER:   NodeKind = 2;
pub val NODE_VECTOR:    NodeKind = 3;
pub val NODE_ARRAY:     NodeKind = 4;
pub val NODE_AGGREGATE: NodeKind = 5;
pub val NODE_ZERO:      NodeKind = 6;
pub val NODE_OPAQUE:    NodeKind = 7;
pub val NODE_TAG:       NodeKind = 8;

# `vector_bits` is the narrowest vector register and `register_bits` the
# widest the selected extensions give, each a power of two times the one
# before: 128 and 256 on x86-64 with avx (#4128)
pub rec Machine {
    ptr_width:     u32;
    vector_bits:   u32;
    register_bits: u32;
}

pub fun machine(ptr_width: u32, vector_bits: u32, register_bits: u32) Machine {
    var m: Machine;
    m.ptr_width     = ptr_width;
    m.vector_bits   = vector_bits;
    m.register_bits = register_bits;
    ret m;
}

# a vector at least as wide as the narrowest vector register aligns to the
# widest register it fills: its size when that is a register's, else the
# widest register narrower than it
fun register_align(m: Machine, size: u32) u32 {
    var align: u32 = m.vector_bits / 8;
    for (align * 2 <= size && align * 2 <= m.register_bits / 8) { align = align * 2; }
    ret align;
}

pub rec Node {
    kind:        NodeKind;
    bytes:       u32;
    count:       u32;
    child:       u32;
    field_count: u32;
    decl_align:  u32;
    overlays:    bool;
    packed:      bool;
}

pub def ExtentCause: u8;

val     EXTENT_OK:             ExtentCause = 0;
pub val EXTENT_UNKNOWN_NODE:   ExtentCause = 1;
val     EXTENT_DEPTH:          ExtentCause = 2;
val     EXTENT_ARRAY_OVERFLOW: ExtentCause = 3;
val     EXTENT_NOT_AGGREGATE:  ExtentCause = 4;
pub val EXTENT_FIELD_RANGE:    ExtentCause = 5;
pub val EXTENT_SIZE_OVERFLOW:  ExtentCause = 6;
val     EXTENT_INVALID_ALIGN:  ExtentCause = 7;
val     EXTENT_INVALID_GRAPH:  ExtentCause = 8;
val     EXTENT_EMPTY_TAG:      ExtentCause = 9;

pub rec Extent {
    ok:    bool;
    cause: ExtentCause;
    size:  u32;
    align: u32;
}

pub val DEPTH_UNBOUNDED: u32 = 0;

val MAX_SIZE: u64 = 4294967295;

pub fun unknown_extent(cause: ExtentCause) Extent {
    var e: Extent;
    e.ok    = false;
    e.cause = cause;
    e.size  = 0;
    e.align = 0;
    ret e;
}

pub fun extent(size: u32, align: u32) Extent {
    if (align == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
    var e: Extent;
    e.ok    = true;
    e.cause = EXTENT_OK;
    e.size  = size;
    e.align = align;
    ret e;
}

pub fun node(kind: NodeKind) Node {
    var n: Node;
    n.kind        = kind;
    n.bytes       = 0;
    n.count       = 0;
    n.child       = 0;
    n.field_count = 0;
    n.decl_align  = 0;
    n.overlays    = false;
    n.packed      = false;
    ret n;
}

pub fun checked_round_up(value: u32, align: u32) Extent {
    if (align == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
    val rem: u32 = value % align;
    if (rem == 0) { ret extent(value, align); }
    val increment: u64 = (align - rem)::u64;
    val rounded:   u64 = value::u64 + increment;
    if (rounded > MAX_SIZE) { ret unknown_extent(EXTENT_SIZE_OVERFLOW); }
    ret extent(rounded::u32, align);
}

fun checked_add(left: u32, right: u32, align: u32) Extent {
    val sum: u64 = left::u64 + right::u64;
    if (sum > MAX_SIZE) { ret unknown_extent(EXTENT_SIZE_OVERFLOW); }
    ret extent(sum::u32, align);
}

pub fun extent_of[T](ctx: *T, describe: fun(*T, u32) Node, field: fun(*T, u32, u32) u32,
    id: u32, m: Machine, max_depth: u32) Extent {
    if (ctx == nil || describe == nil || field == nil) {
        ret unknown_extent(EXTENT_INVALID_GRAPH);
    }
    ret walk[T](ctx, describe, field, id, m, 0, max_depth);
}

pub fun field_offset_of[T](ctx: *T, describe: fun(*T, u32) Node,
    field: fun(*T, u32, u32) u32, id: u32, field_ix: u32,
    m: Machine, max_depth: u32) Extent {
    if (ctx == nil || describe == nil || field == nil) {
        ret unknown_extent(EXTENT_INVALID_GRAPH);
    }
    val n: Node = describe(ctx, id);
    if (n.kind == NODE_TAG) {
        if (field_ix >= n.field_count) { ret unknown_extent(EXTENT_FIELD_RANGE); }
        ret tag_layout[T](ctx, describe, field, id, n, m, 0, max_depth).payload;
    }
    if (n.kind != NODE_AGGREGATE)  { ret unknown_extent(EXTENT_NOT_AGGREGATE); }
    if (field_ix >= n.field_count) { ret unknown_extent(EXTENT_FIELD_RANGE); }
    if (n.overlays)                { ret extent(0, 1); }

    var offset: u32 = 0;
    var i:      u32 = 0;
    for (i < n.field_count) {
        val fe: Extent = walk[T](ctx, describe, field, field(ctx, id, i), m, 1, max_depth);
        if (!fe.ok)        { ret unknown_extent(fe.cause); }
        if (fe.align == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
        if (!n.packed) {
            val aligned: Extent = checked_round_up(offset, fe.align);
            if (!aligned.ok) { ret aligned; }
            offset = aligned.size;
        }
        if (i == field_ix) {
            if (n.packed) { ret extent(offset, 1); }
            ret extent(offset, fe.align);
        }
        val advanced: Extent = checked_add(offset, fe.size, fe.align);
        if (!advanced.ok) { ret advanced; }
        offset = advanced.size;
        i      = i + 1;
    }
    ret unknown_extent(EXTENT_FIELD_RANGE);
}

fun walk[T](ctx: *T, describe: fun(*T, u32) Node, field: fun(*T, u32, u32) u32,
    id: u32, m: Machine, depth: u32, max_depth: u32) Extent {
    if (max_depth != DEPTH_UNBOUNDED && depth > max_depth) { ret unknown_extent(EXTENT_DEPTH); }

    val n: Node = describe(ctx, id);

    if (n.kind == NODE_TAG)  { ret tag_layout[T](ctx, describe, field, id, n, m, depth, max_depth).object; }
    if (n.kind == NODE_ZERO) { ret extent(0, 1); }
    if (n.kind == NODE_SCALAR) {
        if (n.bytes == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
        ret extent(n.bytes, n.bytes);
    }
    if (n.kind == NODE_POINTER) {
        if (m.ptr_width == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
        ret extent(m.ptr_width, m.ptr_width);
    }
    if (n.kind == NODE_OPAQUE) {
        if (n.decl_align == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
        ret extent(n.bytes, n.decl_align);
    }

    if (n.kind == NODE_VECTOR) {
        if (n.bytes == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
        val total: u64 = n.bytes::u64 * n.count::u64;
        if (total > MAX_SIZE) { ret unknown_extent(EXTENT_SIZE_OVERFLOW); }
        val size: u32 = total::u32;
        val reg:  u32 = m.vector_bits / 8;
        if (reg > 0 && size >= reg) { ret extent(size, register_align(m, size)); }
        ret extent(size, n.bytes);
    }

    if (n.kind == NODE_ARRAY) {
        val e: Extent = walk[T](ctx, describe, field, n.child, m, depth + 1, max_depth);
        if (!e.ok)        { ret unknown_extent(e.cause); }
        if (e.align == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
        val total: u64 = e.size::u64 * n.count::u64;
        if (total > MAX_SIZE) { ret unknown_extent(EXTENT_ARRAY_OVERFLOW); }
        ret extent(total::u32, e.align);
    }

    if (n.kind == NODE_AGGREGATE) {
        var align:  u32 = 1;
        var offset: u32 = 0;
        var widest: u32 = 0;
        var i:      u32 = 0;
        for (i < n.field_count) {
            val e: Extent = walk[T](ctx, describe, field, field(ctx, id, i), m,
                depth + 1, max_depth);
            if (!e.ok)        { ret unknown_extent(e.cause); }
            if (e.align == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
            if (!n.packed) {
                if (e.align > align) { align = e.align; }
            }
            if (n.overlays) {
                if (e.size > widest) { widest = e.size; }
            }
            or {
                if (!n.packed) {
                    val aligned: Extent = checked_round_up(offset, e.align);
                    if (!aligned.ok) { ret aligned; }
                    offset = aligned.size;
                }
                val advanced: Extent = checked_add(offset, e.size, e.align);
                if (!advanced.ok) { ret advanced; }
                offset = advanced.size;
            }
            i = i + 1;
        }
        if (n.decl_align > align) { align = n.decl_align; }
        if (align == 0)           { ret unknown_extent(EXTENT_INVALID_ALIGN); }
        if (n.overlays)           { ret checked_round_up(widest, align); }
        ret checked_round_up(offset, align);
    }

    ret unknown_extent(EXTENT_UNKNOWN_NODE);
}

# the narrowest discriminator that can number every case
#[testing]
pub fun discriminator_bytes(case_count: u64) u32 {
    if (case_count == 0)          { ret 0; }
    if (case_count <= 256)        { ret 1; }
    if (case_count <= 65536)      { ret 2; }
    if (case_count <= 4294967296) { ret 4; }
    ret 8;
}

rec TagLayout {
    object:  Extent;
    payload: Extent;
}

fun tag_failure(cause: ExtentCause) TagLayout {
    ret TagLayout{object: unknown_extent(cause), payload: unknown_extent(cause)};
}

# a tag node carries its declared discriminator width in `bytes`
fun tag_layout[T](ctx: *T, describe: fun(*T, u32) Node, field: fun(*T, u32, u32) u32,
    id: u32, n: Node, m: Machine, depth: u32, max_depth: u32) TagLayout {
    if (n.field_count == 0) { ret tag_failure(EXTENT_EMPTY_TAG); }
    val discriminator: u32 = n.bytes;
    if (discriminator != 1 && discriminator != 2 && discriminator != 4 && discriminator != 8) {
        ret tag_failure(EXTENT_INVALID_ALIGN);
    }
    var payload_size:  u32 = 0;
    var payload_align: u32 = 1;
    var i:             u32 = 0;
    for (i < n.field_count) {
        val child: Extent = walk[T](ctx, describe, field, field(ctx, id, i), m, depth + 1, max_depth);
        if (!child.ok)                                { ret tag_failure(child.cause); }
        if (child.align == 0)                         { ret tag_failure(EXTENT_INVALID_ALIGN); }
        if (child.size > payload_size)                { payload_size = child.size; }
        if (!n.packed && child.align > payload_align) { payload_align = child.align; }
        i = i + 1;
    }
    val payload: Extent = checked_round_up(discriminator, payload_align);
    if (!payload.ok) { ret tag_failure(payload.cause); }
    var align: u32 = payload_align;
    if (!n.packed && discriminator > align) { align = discriminator; }
    if (n.decl_align > align)               { align = n.decl_align; }
    val combined: Extent = checked_add(payload.size, payload_size, align);
    if (!combined.ok) { ret tag_failure(combined.cause); }
    val object: Extent = checked_round_up(combined.size, align);
    if (!object.ok) { ret tag_failure(object.cause); }
    ret TagLayout{object: object, payload: payload};
}

# the text of an extent cause; absent for a tag outside the catalog
pub fun cause_name(cause: ExtentCause) opt[str] {
    if (cause == EXTENT_EMPTY_TAG)      { ret opt[str].some{"a tag with no cases"}; }
    if (cause == EXTENT_OK)             { ret opt[str].some{"no failure"}; }
    if (cause == EXTENT_UNKNOWN_NODE)   { ret opt[str].some{"a type the layout policy cannot classify"}; }
    if (cause == EXTENT_DEPTH)          { ret opt[str].some{"a type graph deeper than the walk's depth bound"}; }
    if (cause == EXTENT_ARRAY_OVERFLOW) { ret opt[str].some{"an array whose total size does not fit in 32 bits"}; }
    if (cause == EXTENT_NOT_AGGREGATE)  { ret opt[str].some{"a field offset asked of a non-aggregate type"}; }
    if (cause == EXTENT_FIELD_RANGE)    { ret opt[str].some{"a field index past the aggregate's field count"}; }
    if (cause == EXTENT_SIZE_OVERFLOW)  { ret opt[str].some{"a type extent that does not fit in 32 bits"}; }
    if (cause == EXTENT_INVALID_ALIGN)  { ret opt[str].some{"a type with zero-byte alignment"}; }
    if (cause == EXTENT_INVALID_GRAPH)  { ret opt[str].some{"a layout graph with a missing context or callback"}; }
    ret opt[str].none{};
}

test checked_round_up__boundaries {
    val zero: Extent = checked_round_up(0, 0);
    if (zero.ok || zero.cause != EXTENT_INVALID_ALIGN) { ret 1; }
    val one: Extent = checked_round_up(7, 1);
    if (!one.ok || one.size != 7) { ret 1; }
    val exact: Extent = checked_round_up(8, 4);
    if (!exact.ok || exact.size != 8) { ret 1; }
    val next: Extent = checked_round_up(9, 4);
    if (!next.ok || next.size != 12) { ret 1; }
    val wider: Extent = checked_round_up(1, 8);
    if (!wider.ok || wider.size != 8) { ret 1; }
    val overflow: Extent = checked_round_up(4294967295, 2);
    if (overflow.ok || overflow.cause != EXTENT_SIZE_OVERFLOW) { ret 1; }
    ret 0;
}

#[testing]
var tg_nodes:  [72]Node;
#[testing]
var tg_fields: [144]u32;

#[testing]
rec LayoutTestGraph {
    nodes:  *Node;
    fields: *u32;
    stride: u32;
}

#[testing]
var tg_graph: LayoutTestGraph;

#[testing]
fun tg_describe(ctx: *LayoutTestGraph, id: u32) Node {
    ret ctx.nodes[id];
}

#[testing]
fun tg_field(ctx: *LayoutTestGraph, id: u32, index: u32) u32 {
    ret ctx.fields[id * ctx.stride + index];
}

#[testing]
fun tg_extent(id: u32, m: Machine, max_depth: u32) Extent {
    tg_graph.nodes  = ?tg_nodes[0];
    tg_graph.fields = ?tg_fields[0];
    tg_graph.stride = 2;
    ret extent_of[LayoutTestGraph](?tg_graph, tg_describe, tg_field, id, m, max_depth);
}

#[testing]
fun tg_offset(id: u32, field_ix: u32, m: Machine, max_depth: u32) Extent {
    tg_graph.nodes  = ?tg_nodes[0];
    tg_graph.fields = ?tg_fields[0];
    tg_graph.stride = 2;
    ret field_offset_of[LayoutTestGraph](?tg_graph, tg_describe, tg_field, id, field_ix,
        m, max_depth);
}

#[testing]
fun tg_chain(n: u32) {
    var i: u32 = 0;
    for (i < n - 1) {
        tg_nodes[i]             = node(NODE_AGGREGATE);
        tg_nodes[i].field_count = 1;
        tg_fields[i * 2]        = i + 1;
        i                       = i + 1;
    }
    tg_nodes[n - 1]       = node(NODE_SCALAR);
    tg_nodes[n - 1].bytes = 1;
}

test extent__vector_is_lane_derived {
    tg_nodes[0] = node(NODE_VECTOR);

    var eb: [4]u32;
    var ln: [4]u32;
    eb[0] = 4;
    ln[0] = 4;
    eb[1] = 8;
    ln[1] = 2;
    eb[2] = 1;
    ln[2] = 16;
    eb[3] = 2;
    ln[3] = 8;

    var i: u32 = 0;
    for (i < 4) {
        tg_nodes[0].bytes = eb[i];
        tg_nodes[0].count = ln[i];
        val e: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
        if (!e.ok)         { ret 1; }
        if (e.size != 16)  { ret 1; }
        if (e.align != 16) { ret 1; }
        i = i + 1;
    }

    tg_nodes[0].bytes = 4;
    tg_nodes[0].count = 3;
    val v3: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (v3.size != 12) { ret 1; }
    if (v3.align != 4) { ret 1; }

    tg_nodes[0].bytes = 4;
    tg_nodes[0].count = 2;
    val v2: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (v2.size != 8)  { ret 1; }
    if (v2.align != 4) { ret 1; }

    tg_nodes[0].bytes = 2;
    tg_nodes[0].count = 4;
    val i16x4: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (i16x4.size != 8)  { ret 1; }
    if (i16x4.align != 2) { ret 1; }

    tg_nodes[0].bytes = 4;
    tg_nodes[0].count = 4;
    val at128: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (at128.align != 16) { ret 1; }
    val at256: Extent = tg_extent(0, machine(8, 256, 256), DEPTH_UNBOUNDED);
    if (at256.size != 16) { ret 1; }
    if (at256.align != 4) { ret 1; }

    # 128-bit registers widened to 256 (#4128): a vector aligns to the widest
    # register it fills, and one narrower than the narrowest to its lane
    val sizes:  [5]u32 = [5]u32{3, 4, 5, 8, 16};
    val aligns: [5]u32 = [5]u32{4, 16, 16, 32, 32};
    var k:      u32    = 0;
    for (k < 5) {
        tg_nodes[0].bytes = 4;
        tg_nodes[0].count = sizes[k];
        val wide: Extent = tg_extent(0, machine(8, 128, 256), DEPTH_UNBOUNDED);
        if (wide.size != sizes[k] * 4 || wide.align != aligns[k]) { ret 2; }
        k = k + 1;
    }

    ret 0;
}

test extent__causes_are_distinguishable {
    val missing: Extent = extent_of[LayoutTestGraph](nil::*LayoutTestGraph, tg_describe,
        tg_field, 0, machine(8, 128, 128),
        DEPTH_UNBOUNDED);
    if (missing.ok || missing.cause != EXTENT_INVALID_GRAPH) { ret 1; }

    tg_nodes[0] = node(NODE_UNKNOWN);
    val unk: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (unk.ok)                           { ret 1; }
    if (unk.cause != EXTENT_UNKNOWN_NODE) { ret 1; }

    tg_nodes[0]             = node(NODE_AGGREGATE);
    tg_nodes[0].field_count = 1;
    tg_fields[0]            = 1;
    tg_nodes[1]             = node(NODE_UNKNOWN);
    val prop: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (prop.ok)                           { ret 1; }
    if (prop.cause != EXTENT_UNKNOWN_NODE) { ret 1; }

    tg_nodes[0]             = node(NODE_AGGREGATE);
    tg_nodes[0].field_count = 1;
    tg_fields[0]            = 1;
    tg_nodes[1]             = node(NODE_ARRAY);
    tg_nodes[1].child       = 2;
    tg_nodes[1].count       = 4294967295;
    tg_nodes[2]             = node(NODE_SCALAR);
    tg_nodes[2].bytes       = 4;
    val prop2: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (prop2.ok)                             { ret 1; }
    if (prop2.cause != EXTENT_ARRAY_OVERFLOW) { ret 1; }

    val prop3: Extent = tg_offset(0, 0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (prop3.ok)                             { ret 1; }
    if (prop3.cause != EXTENT_ARRAY_OVERFLOW) { ret 1; }

    tg_chain(8);
    val prop4: Extent = tg_extent(0, machine(8, 128, 128), 3);
    if (prop4.ok)                    { ret 1; }
    if (prop4.cause != EXTENT_DEPTH) { ret 1; }

    tg_nodes[0]       = node(NODE_ARRAY);
    tg_nodes[0].child = 1;
    tg_nodes[0].count = 4294967295;
    tg_nodes[1]       = node(NODE_SCALAR);
    tg_nodes[1].bytes = 4;
    val ovf: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (ovf.ok)                             { ret 1; }
    if (ovf.cause != EXTENT_ARRAY_OVERFLOW) { ret 1; }

    tg_nodes[0]       = node(NODE_SCALAR);
    tg_nodes[0].bytes = 4;
    val nag: Extent = tg_offset(0, 0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (nag.ok)                            { ret 1; }
    if (nag.cause != EXTENT_NOT_AGGREGATE) { ret 1; }

    tg_nodes[0]             = node(NODE_AGGREGATE);
    tg_nodes[0].field_count = 1;
    tg_fields[0]            = 1;
    tg_nodes[1]             = node(NODE_SCALAR);
    tg_nodes[1].bytes       = 4;
    val rng: Extent = tg_offset(0, 3, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (rng.ok)                          { ret 1; }
    if (rng.cause != EXTENT_FIELD_RANGE) { ret 1; }

    val good: Extent = tg_extent(1, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (!good.ok)                { ret 1; }
    if (good.cause != EXTENT_OK) { ret 1; }
    ret 0;
}

test extent__rejects_invalid_and_overflowing_extents {
    tg_nodes[0]       = node(NODE_VECTOR);
    tg_nodes[0].bytes = 4294967295;
    tg_nodes[0].count = 2;
    val vector_overflow: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (vector_overflow.ok || vector_overflow.cause != EXTENT_SIZE_OVERFLOW) { ret 1; }

    tg_nodes[0]       = node(NODE_SCALAR);
    tg_nodes[0].bytes = 0;
    val scalar_align: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (scalar_align.ok || scalar_align.cause != EXTENT_INVALID_ALIGN) { ret 1; }

    tg_nodes[0] = node(NODE_POINTER);
    val pointer_align: Extent = tg_extent(0, machine(0, 128, 128), DEPTH_UNBOUNDED);
    if (pointer_align.ok || pointer_align.cause != EXTENT_INVALID_ALIGN) { ret 1; }

    tg_nodes[0]            = node(NODE_OPAQUE);
    tg_nodes[0].bytes      = 4;
    tg_nodes[0].decl_align = 0;
    val opaque_align: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (opaque_align.ok || opaque_align.cause != EXTENT_INVALID_ALIGN) { ret 1; }

    tg_nodes[0]             = node(NODE_AGGREGATE);
    tg_nodes[0].field_count = 2;
    tg_nodes[0].packed      = true;
    tg_fields[0]            = 1;
    tg_fields[1]            = 1;
    tg_nodes[1]             = node(NODE_SCALAR);
    tg_nodes[1].bytes       = 4294967295;
    val aggregate_add: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (aggregate_add.ok || aggregate_add.cause != EXTENT_SIZE_OVERFLOW) { ret 1; }

    tg_nodes[0].field_count = 1;
    tg_nodes[0].decl_align  = 2;
    val aggregate_round: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (aggregate_round.ok || aggregate_round.cause != EXTENT_SIZE_OVERFLOW) { ret 1; }
    ret 0;
}

test extent__unbounded_depth_walks_past_any_constant {
    tg_chain(70);
    val deep: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (!deep.ok)        { ret 1; }
    if (deep.size != 1)  { ret 1; }
    if (deep.align != 1) { ret 1; }

    val bounded: Extent = tg_extent(0, machine(8, 128, 128), 64);
    if (bounded.ok)                    { ret 1; }
    if (bounded.cause != EXTENT_DEPTH) { ret 1; }

    val fits: Extent = tg_extent(0, machine(8, 128, 128), 69);
    if (!fits.ok)       { ret 1; }
    if (fits.size != 1) { ret 1; }
    ret 0;
}

test extent__packed_removes_padding {
    tg_nodes[1]       = node(NODE_SCALAR);
    tg_nodes[1].bytes = 1;
    tg_nodes[2]       = node(NODE_SCALAR);
    tg_nodes[2].bytes = 4;
    tg_fields[0]      = 1;
    tg_fields[1]      = 2;

    tg_nodes[0]             = node(NODE_AGGREGATE);
    tg_nodes[0].field_count = 2;

    val nat: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (!nat.ok)        { ret 1; }
    if (nat.size != 8)  { ret 1; }
    if (nat.align != 4) { ret 1; }

    tg_nodes[0].packed = true;
    val pkd: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (!pkd.ok)        { ret 1; }
    if (pkd.size != 5)  { ret 1; }
    if (pkd.align != 1) { ret 1; }

    tg_nodes[0].decl_align = 8;
    val both: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (!both.ok)        { ret 1; }
    if (both.size != 8)  { ret 1; }
    if (both.align != 8) { ret 1; }

    tg_nodes[0].decl_align = 0;
    tg_nodes[0].overlays   = true;
    val uni_p: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (uni_p.size != 4)  { ret 1; }
    if (uni_p.align != 1) { ret 1; }

    tg_nodes[0].packed = false;
    val uni_n: Extent = tg_extent(0, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (uni_n.size != 4)  { ret 1; }
    if (uni_n.align != 4) { ret 1; }

    ret 0;
}

test extent__packed_does_not_propagate {
    tg_nodes[3]             = node(NODE_SCALAR);
    tg_nodes[3].bytes       = 1;
    tg_nodes[4]             = node(NODE_SCALAR);
    tg_nodes[4].bytes       = 4;
    tg_fields[10]           = 3;
    tg_fields[11]           = 4;
    tg_nodes[5]             = node(NODE_AGGREGATE);
    tg_nodes[5].field_count = 2;

    val inner: Extent = tg_extent(5, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (inner.size != 8) { ret 1; }

    tg_nodes[6]             = node(NODE_SCALAR);
    tg_nodes[6].bytes       = 1;
    tg_fields[14]           = 6;
    tg_fields[15]           = 5;
    tg_nodes[7]             = node(NODE_AGGREGATE);
    tg_nodes[7].field_count = 2;
    tg_nodes[7].packed      = true;

    val outer: Extent = tg_extent(7, machine(8, 128, 128), DEPTH_UNBOUNDED);
    if (!outer.ok)        { ret 1; }
    if (outer.size != 9)  { ret 1; }
    if (outer.align != 1) { ret 1; }
    ret 0;
}

test tag__discriminator_width_boundaries {
    if (discriminator_bytes(0) != 0 || discriminator_bytes(1) != 1 || discriminator_bytes(256) != 1) { ret 1; }
    if (discriminator_bytes(257) != 2 || discriminator_bytes(65536) != 2)                            { ret 2; }
    if (discriminator_bytes(65537) != 4 || discriminator_bytes(4294967296) != 4)                     { ret 3; }
    if (discriminator_bytes(4294967297) != 8 || discriminator_bytes(18446744073709551615) != 8)      { ret 4; }
    ret 0;
}

test tag__common_payload_offset_packing_and_outer_alignment {
    tg_nodes[0]             = node(NODE_TAG);
    tg_nodes[0].bytes       = 1;
    tg_nodes[0].field_count = 2;
    tg_fields[0]            = 1;
    tg_fields[1]            = 2;
    tg_nodes[1]             = node(NODE_ZERO);
    tg_nodes[2]             = node(NODE_SCALAR);
    tg_nodes[2].bytes       = 8;
    val natural: Extent = tg_extent(0, machine(8, 128, 128), 16);
    val payload: Extent = tg_offset(0, 1, machine(8, 128, 128), 16);
    if (!natural.ok || natural.size != 16 || natural.align != 8 || !payload.ok || payload.size != 8 || payload.align != 8) { ret 1; }
    tg_nodes[0].packed = true;
    val packed:         Extent = tg_extent(0, machine(8, 128, 128), 16);
    val packed_payload: Extent = tg_offset(0, 1, machine(8, 128, 128), 16);
    if (!packed.ok || packed.size != 9 || packed.align != 1 || !packed_payload.ok || packed_payload.size != 1 || packed_payload.align != 1) { ret 2; }
    tg_nodes[0].decl_align = 16;
    val aligned: Extent = tg_extent(0, machine(8, 128, 128), 16);
    if (!aligned.ok || aligned.size != 16 || aligned.align != 16) { ret 3; }
    tg_nodes[0].packed     = false;
    tg_nodes[0].decl_align = 32;
    val raised:         Extent = tg_extent(0, machine(8, 128, 128), 16);
    val raised_payload: Extent = tg_offset(0, 1, machine(8, 128, 128), 16);
    if (!raised.ok || raised.size != 32 || raised.align != 32 || raised_payload.size != 8) { ret 4; }
    tg_nodes[0].decl_align = 0;
    tg_nodes[0].bytes      = 4;
    val wide:         Extent = tg_extent(0, machine(8, 128, 128), 16);
    val wide_payload: Extent = tg_offset(0, 1, machine(8, 128, 128), 16);
    if (!wide.ok || wide.size != 16 || wide.align != 8 || wide_payload.size != 8) { ret 5; }
    tg_nodes[0].bytes = 0;
    val undeclared: Extent = tg_extent(0, machine(8, 128, 128), 16);
    if (undeclared.ok || undeclared.cause != EXTENT_INVALID_ALIGN) { ret 6; }
    ret 0;
}

test tag__payloadless_nested_overflow_and_recursive_cases {
    tg_nodes[0]             = node(NODE_TAG);
    tg_nodes[0].bytes       = 1;
    tg_nodes[0].field_count = 1;
    tg_fields[0]            = 1;
    tg_nodes[1]             = node(NODE_ZERO);
    val empty: Extent = tg_extent(0, machine(8, 128, 128), 8);
    if (!empty.ok || empty.size != 1 || empty.align != 1) { ret 1; }
    tg_nodes[1]             = node(NODE_TAG);
    tg_nodes[1].bytes       = 1;
    tg_nodes[1].field_count = 1;
    tg_fields[2]            = 2;
    tg_nodes[2]             = node(NODE_SCALAR);
    tg_nodes[2].bytes       = 8;
    tg_nodes[0].packed      = true;
    val nested: Extent = tg_extent(0, machine(8, 128, 128), 8);
    if (!nested.ok || nested.size != 17 || nested.align != 1) { ret 2; }
    tg_nodes[1]            = node(NODE_OPAQUE);
    tg_nodes[1].bytes      = 4294967295;
    tg_nodes[1].decl_align = 1;
    val overflow: Extent = tg_extent(0, machine(8, 128, 128), 8);
    if (overflow.ok || overflow.cause != EXTENT_SIZE_OVERFLOW) { ret 3; }
    tg_fields[0] = 0;
    val recursive: Extent = tg_extent(0, machine(8, 128, 128), 8);
    if (recursive.ok || recursive.cause != EXTENT_DEPTH) { ret 4; }
    tg_nodes[0].field_count = 0;
    val absent: Extent = tg_extent(0, machine(8, 128, 128), 8);
    if (absent.ok || absent.cause != EXTENT_EMPTY_TAG) { ret 5; }
    ret 0;
}
