pub fun write_i32_le(buf: *u8, len: usize, off: usize, value: i32) res[bool, CheckCause] {
    ret write_uint_le(buf, len, off, 4, value::u64);
}

pub fun write_i32_be(buf: *u8, len: usize, off: usize, value: i32) res[bool, CheckCause] {
    ret write_uint_be(buf, len, off, 4, value::u64);
}

pub fun read_u64_le(buf: *u8, len: usize, off: usize) res[u64, CheckCause] {
    val r: res[u64, CheckCause] = read_uint_le(buf, len, off, 8);
    if (sel r.err) { ret res[u64, CheckCause].err{r.err}; }
    var v: u64 = r.ok;
    ret res[u64, CheckCause].ok{v::u64};
}

pub fun read_u64_be(buf: *u8, len: usize, off: usize) res[u64, CheckCause] {
    val r: res[u64, CheckCause] = read_uint_be(buf, len, off, 8);
    if (sel r.err) { ret res[u64, CheckCause].err{r.err}; }
    var v: u64 = r.ok;
    ret res[u64, CheckCause].ok{v::u64};
}

pub fun read_i64_le(buf: *u8, len: usize, off: usize) res[i64, CheckCause] {
    val r: res[u64, CheckCause] = read_uint_le(buf, len, off, 8);
    if (sel r.err) { ret res[i64, CheckCause].err{r.err}; }
    var v: u64 = r.ok;
    ret res[i64, CheckCause].ok{v::i64};
}

pub fun read_i64_be(buf: *u8, len: usize, off: usize) res[i64, CheckCause] {
    val r: res[u64, CheckCause] = read_uint_be(buf, len, off, 8);
    if (sel r.err) { ret res[i64, CheckCause].err{r.err}; }
    var v: u64 = r.ok;
    ret res[i64, CheckCause].ok{v::i64};
}

pub fun write_u64_le(buf: *u8, len: usize, off: usize, value: u64) res[bool, CheckCause] {
    ret write_uint_le(buf, len, off, 8, value::u64);
}

pub fun write_u64_be(buf: *u8, len: usize, off: usize, value: u64) res[bool, CheckCause] {
    ret write_uint_be(buf, len, off, 8, value::u64);
}

pub fun write_i64_le(buf: *u8, len: usize, off: usize, value: i64) res[bool, CheckCause] {
    ret write_uint_le(buf, len, off, 8, value::u64);
}

pub fun write_i64_be(buf: *u8, len: usize, off: usize, value: i64) res[bool, CheckCause] {
    ret write_uint_be(buf, len, off, 8, value::u64);
}

test "mach.lang.layout.checked_fields:known_byte_vectors_round_trip" {
    var buf: [8]u8;
    var i:   usize = 0;
    for (i < 8) {
        buf[i] = 0;
        i      = i + 1;
    }

    val r_1032: res[bool, CheckCause] = write_u16_le(?buf[0], 8, 0, 0x1234);
    if (sel r_1032.err)                   { ret 1; }
    if (buf[0] != 0x34 || buf[1] != 0x12) { ret 1; }
    val r16le: res[u16, CheckCause] = read_u16_le(?buf[0], 8, 0);
    if (sel r16le.err)      { ret 1; }
    if (r16le.ok != 0x1234) { ret 1; }

    val r_1038: res[bool, CheckCause] = write_u16_be(?buf[0], 8, 0, 0x1234);
    if (sel r_1038.err)                   { ret 1; }
    if (buf[0] != 0x12 || buf[1] != 0x34) { ret 1; }
    val r16be: res[u16, CheckCause] = read_u16_be(?buf[0], 8, 0);
    if (sel r16be.err)      { ret 1; }
    if (r16be.ok != 0x1234) { ret 1; }

    val r_1044: res[bool, CheckCause] = write_u24_le(?buf[0], 8, 0, 0xABCDEF);
    if (sel r_1044.err)                                     { ret 1; }
    if (buf[0] != 0xEF || buf[1] != 0xCD || buf[2] != 0xAB) { ret 1; }
    val r24le: res[u32, CheckCause] = read_u24_le(?buf[0], 8, 0);
    if (sel r24le.err)        { ret 1; }
    if (r24le.ok != 0xABCDEF) { ret 1; }

    val r_1050: res[bool, CheckCause] = write_u24_be(?buf[0], 8, 0, 0xABCDEF);
    if (sel r_1050.err)                                     { ret 1; }
    if (buf[0] != 0xAB || buf[1] != 0xCD || buf[2] != 0xEF) { ret 1; }
    val r24be: res[u32, CheckCause] = read_u24_be(?buf[0], 8, 0);
    if (sel r24be.err)        { ret 1; }
    if (r24be.ok != 0xABCDEF) { ret 1; }

    val r_1056: res[bool, CheckCause] = write_u32_le(?buf[0], 8, 0, 0x89ABCDEF);
    if (sel r_1056.err)                                                       { ret 1; }
    if (buf[0] != 0xEF || buf[1] != 0xCD || buf[2] != 0xAB || buf[3] != 0x89) { ret 1; }
    val r32le: res[u32, CheckCause] = read_u32_le(?buf[0], 8, 0);
    if (sel r32le.err)          { ret 1; }
    if (r32le.ok != 0x89ABCDEF) { ret 1; }

    val r_1062: res[bool, CheckCause] = write_u32_be(?buf[0], 8, 0, 0x89ABCDEF);
    if (sel r_1062.err)                                                       { ret 1; }
    if (buf[0] != 0x89 || buf[1] != 0xAB || buf[2] != 0xCD || buf[3] != 0xEF) { ret 1; }
    val r32be: res[u32, CheckCause] = read_u32_be(?buf[0], 8, 0);
    if (sel r32be.err)          { ret 1; }
    if (r32be.ok != 0x89ABCDEF) { ret 1; }

    val r_1068: res[bool, CheckCause] = write_u64_le(?buf[0], 8, 0, 0x0123456789ABCDEF);
    if (sel r_1068.err)                   { ret 1; }
    if (buf[0] != 0xEF || buf[7] != 0x01) { ret 1; }
    val r64le: res[u64, CheckCause] = read_u64_le(?buf[0], 8, 0);
    if (sel r64le.err)                  { ret 1; }
    if (r64le.ok != 0x0123456789ABCDEF) { ret 1; }

    val r_1074: res[bool, CheckCause] = write_u64_be(?buf[0], 8, 0, 0x0123456789ABCDEF);
    if (sel r_1074.err)                   { ret 1; }
    if (buf[0] != 0x01 || buf[7] != 0xEF) { ret 1; }
    val r64be: res[u64, CheckCause] = read_u64_be(?buf[0], 8, 0);
    if (sel r64be.err)                  { ret 1; }
    if (r64be.ok != 0x0123456789ABCDEF) { ret 1; }

    ret 0;
}

test "mach.lang.layout.checked_fields:signed_round_trip_and_sign_extension" {
    var buf: [8]u8;
    var i:   usize = 0;
    for (i < 8) {
        buf[i] = 0;
        i      = i + 1;
    }

    val r_1088: res[bool, CheckCause] = write_i8(?buf[0], 8, 0, -1);
    if (sel r_1088.err) { ret 1; }
    if (buf[0] != 0xFF) { ret 1; }
    val ri8: res[i8, CheckCause] = read_i8(?buf[0], 8, 0);
    if (sel ri8.err)  { ret 1; }
    if (ri8.ok != -1) { ret 1; }

    val r_1094: res[bool, CheckCause] = write_i16_le(?buf[0], 8, 0, -2);
    if (sel r_1094.err) { ret 1; }
    val ri16: res[i16, CheckCause] = read_i16_le(?buf[0], 8, 0);
    if (sel ri16.err)  { ret 1; }
    if (ri16.ok != -2) { ret 1; }

    val r_1099: res[bool, CheckCause] = write_i24_le(?buf[0], 8, 0, -3);
    if (sel r_1099.err) { ret 1; }
    val ri24: res[i32, CheckCause] = read_i24_le(?buf[0], 8, 0);
    if (sel ri24.err)  { ret 1; }
    if (ri24.ok != -3) { ret 1; }

    val r_1104: res[bool, CheckCause] = write_i24_be(?buf[0], 8, 0, -3);
    if (sel r_1104.err) { ret 1; }
    val ri24be: res[i32, CheckCause] = read_i24_be(?buf[0], 8, 0);
    if (sel ri24be.err)  { ret 1; }
    if (ri24be.ok != -3) { ret 1; }

    val r_1109: res[bool, CheckCause] = write_i32_le(?buf[0], 8, 0, -4);
    if (sel r_1109.err) { ret 1; }
    val ri32: res[i32, CheckCause] = read_i32_le(?buf[0], 8, 0);
    if (sel ri32.err)  { ret 1; }
    if (ri32.ok != -4) { ret 1; }

    val r_1114: res[bool, CheckCause] = write_i64_le(?buf[0], 8, 0, -5);
    if (sel r_1114.err) { ret 1; }
    val ri64: res[i64, CheckCause] = read_i64_le(?buf[0], 8, 0);
    if (sel ri64.err)  { ret 1; }
    if (ri64.ok != -5) { ret 1; }

    ret 0;
}

test "mach.lang.layout.checked_fields:refuses_out_of_range_and_wrapped_offsets" {
    var buf: [4]u8;
    var i:   usize = 0;
    for (i < 4) {
        buf[i] = 0;
        i      = i + 1;
    }

    val ok_read: res[u32, CheckCause] = read_u32_le(?buf[0], 4, 0);
    if (sel ok_read.err) { ret 1; }

    val short_read: res[u32, CheckCause] = read_u32_le(?buf[0], 4, 1);
    if (!sel short_read.err)                   { ret 1; }
    if (short_read.err != CHECK_INVALID_RANGE) { ret 1; }

    val exact_boundary: res[u8, CheckCause] = read_u8(?buf[0], 4, 3);
    if (sel exact_boundary.err) { ret 1; }
    val one_past: res[u8, CheckCause] = read_u8(?buf[0], 4, 4);
    if (!sel one_past.err) { ret 1; }

    val maximum:        usize                = ~(0::usize);
    val wrapped_offset: res[u32, CheckCause] = read_u32_le(?buf[0], 4, maximum - 1);
    if (!sel wrapped_offset.err)                  { ret 1; }
    if (wrapped_offset.err != CHECK_ADD_OVERFLOW) { ret 1; }

    var before: [4]u8;
    before[0] = buf[0];
    before[1] = buf[1];
    before[2] = buf[2];
    before[3] = buf[3];

    val short_write: res[bool, CheckCause] = write_u32_le(?buf[0], 4, 1, 0xFFFFFFFF);
    if (!sel short_write.err)                                                                     { ret 1; }
    if (buf[0] != before[0] || buf[1] != before[1] || buf[2] != before[2] || buf[3] != before[3]) { ret 1; }

    val wrapped_write: res[bool, CheckCause] = write_u32_le(?buf[0], 4, maximum - 1, 0xFFFFFFFF);
    if (!sel wrapped_write.err)                                                                   { ret 1; }
    if (wrapped_write.err != CHECK_ADD_OVERFLOW)                                                  { ret 1; }
    if (buf[0] != before[0] || buf[1] != before[1] || buf[2] != before[2] || buf[3] != before[3]) { ret 1; }

    ret 0;
}

test "mach.lang.layout.checked_fields:narrowing_refuses_one_past_the_boundary" {
    var buf: [4]u8;
    var i:   usize = 0;
    for (i < 4) {
        buf[i] = 0;
        i      = i + 1;
    }

    val r_1164: res[bool, CheckCause] = write_u24_le(?buf[0], 4, 0, 0xFFFFFF);
    if (sel r_1164.err) { ret 1; }
    val over: res[bool, CheckCause] = write_u24_le(?buf[0], 4, 0, 0x1000000);
    if (!sel over.err)               { ret 1; }
    if (over.err != CHECK_NARROWING) { ret 1; }

    val r_1169: res[bool, CheckCause] = write_u24_be(?buf[0], 4, 0, 0xFFFFFF);
    if (sel r_1169.err) { ret 1; }
    val over_be: res[bool, CheckCause] = write_u24_be(?buf[0], 4, 0, 0x1000000);
    if (!sel over_be.err)               { ret 1; }
    if (over_be.err != CHECK_NARROWING) { ret 1; }

    val r_1174: res[bool, CheckCause] = write_i24_le(?buf[0], 4, 0, 0x7FFFFF);
    if (sel r_1174.err) { ret 1; }
    val over_pos: res[bool, CheckCause] = write_i24_le(?buf[0], 4, 0, 0x800000);
    if (!sel over_pos.err)               { ret 1; }
    if (over_pos.err != CHECK_NARROWING) { ret 1; }

    val r_1179: res[bool, CheckCause] = write_i24_be(?buf[0], 4, 0, 0x7FFFFF);
    if (sel r_1179.err) { ret 1; }
    val over_pos_be: res[bool, CheckCause] = write_i24_be(?buf[0], 4, 0, 0x800000);
    if (!sel over_pos_be.err)               { ret 1; }
    if (over_pos_be.err != CHECK_NARROWING) { ret 1; }

    val r_1184: res[bool, CheckCause] = write_i24_le(?buf[0], 4, 0, -0x800000);
    if (sel r_1184.err) { ret 1; }
    val under_neg: res[bool, CheckCause] = write_i24_le(?buf[0], 4, 0, -0x800001);
    if (!sel under_neg.err)               { ret 1; }
    if (under_neg.err != CHECK_NARROWING) { ret 1; }

    val r_1189: res[bool, CheckCause] = write_i24_be(?buf[0], 4, 0, -0x800000);
    if (sel r_1189.err) { ret 1; }
    val under_neg_be: res[bool, CheckCause] = write_i24_be(?buf[0], 4, 0, -0x800001);
    if (!sel under_neg_be.err)               { ret 1; }
    if (under_neg_be.err != CHECK_NARROWING) { ret 1; }

    ret 0;
}

test "mach.lang.layout.checked_fields:sums_wide_and_narrows_once_like_a_hostile_section_count" {
    var term: [2]u8;
    term[0] = 0xFF;
    term[1] = 0xFF;

    var total: CheckedCount[TestUnit] = count[TestUnit](0);
    var i:     u32                    = 0;
    for (i < 70000) {
        val r: res[u16, CheckCause] = read_u16_le(?term[0], 2, 0);
        if (sel r.err) { ret 1; }
        val added: res[CheckedCount[TestUnit], CheckCause] = count_add[TestUnit](total, count[TestUnit](r.ok::usize));
        if (sel added.err) { ret 1; }
        total = added.ok;
        i     = i + 1;
    }
    if (total.value != 70000::usize * 65535::usize) { ret 1; }

    val narrowed: res[u32, CheckCause] = usize_to_u32(total.value);
    if (!sel narrowed.err)               { ret 1; }
    if (narrowed.err != CHECK_NARROWING) { ret 1; }

    var small_total: CheckedCount[TestUnit] = count[TestUnit](0);
    var j:           u32                    = 0;
    for (j < 4) {
        val r2: res[u16, CheckCause] = read_u16_le(?term[0], 2, 0);
        if (sel r2.err) { ret 1; }
        val added2: res[CheckedCount[TestUnit], CheckCause] = count_add[TestUnit](small_total, count[TestUnit](r2.ok::usize));
        if (sel added2.err) { ret 1; }
        small_total = added2.ok;
        j           = j + 1;
    }
    val narrowed_ok: res[u32, CheckCause] = usize_to_u32(small_total.value);
    if (sel narrowed_ok.err)                   { ret 1; }
    if (narrowed_ok.ok != 4::u32 * 65535::u32) { ret 1; }

    ret 0;
}

test "mach.lang.layout.checked_fields:per_term_narrowing_would_have_wrapped_silently" {
    var acc: u32 = 0;
    var i:   u32 = 0;
    for (i < 70000) {
        acc = acc + 65535::u32;
        i   = i + 1;
    }
    if (acc != 292482704::u32) { ret 1; }
    ret 0;
}

pub def NodeKind: u8;

pub val NODE_UNKNOWN:   NodeKind = 0;
pub val NODE_SCALAR:    NodeKind = 1;
pub val NODE_POINTER:   NodeKind = 2;
pub val NODE_VECTOR:    NodeKind = 3;
pub val NODE_ARRAY:     NodeKind = 4;
pub val NODE_AGGREGATE: NodeKind = 5;
pub val NODE_ZERO:      NodeKind = 6;
pub val NODE_OPAQUE:    NodeKind = 7;
pub val NODE_TAG:       NodeKind = 8;

pub rec Machine {
    ptr_width:   u32;
    vector_bits: u32;
}

pub fun machine(ptr_width: u32, vector_bits: u32) Machine {
    var m: Machine;
    m.ptr_width   = ptr_width;
    m.vector_bits = vector_bits;
    ret m;
}

pub rec Node {
    kind:        NodeKind;
    bytes:       u32;
    count:       u32;
    child:       u32;
    field_count: u32;
    decl_align:  u32;
    overlays:    bool;
    packed:      bool;
}

pub def ExtentCause: u8;

pub val EXTENT_OK:             ExtentCause = 0;
pub val EXTENT_UNKNOWN_NODE:   ExtentCause = 1;
pub val EXTENT_DEPTH:          ExtentCause = 2;
pub val EXTENT_ARRAY_OVERFLOW: ExtentCause = 3;
pub val EXTENT_NOT_AGGREGATE:  ExtentCause = 4;
pub val EXTENT_FIELD_RANGE:    ExtentCause = 5;
pub val EXTENT_SIZE_OVERFLOW:  ExtentCause = 6;
pub val EXTENT_INVALID_ALIGN:  ExtentCause = 7;
pub val EXTENT_INVALID_GRAPH:  ExtentCause = 8;
pub val EXTENT_EMPTY_TAG:      ExtentCause = 9;

pub rec Extent {
    ok:    bool;
    cause: ExtentCause;
    size:  u32;
    align: u32;
}

pub val DEPTH_UNBOUNDED: u32 = 0;

val MAX_SIZE: u64 = 4294967295;

pub fun unknown_extent(cause: ExtentCause) Extent {
    var e: Extent;
    e.ok    = false;
    e.cause = cause;
    e.size  = 0;
    e.align = 0;
    ret e;
}

pub fun extent(size: u32, align: u32) Extent {
    if (align == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
    var e: Extent;
    e.ok    = true;
    e.cause = EXTENT_OK;
    e.size  = size;
    e.align = align;
    ret e;
}

pub fun node(kind: NodeKind) Node {
    var n: Node;
    n.kind        = kind;
    n.bytes       = 0;
    n.count       = 0;
    n.child       = 0;
    n.field_count = 0;
    n.decl_align  = 0;
    n.overlays    = false;
    n.packed      = false;
    ret n;
}

pub fun checked_round_up(value: u32, align: u32) Extent {
    if (align == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
    val rem: u32 = value % align;
    if (rem == 0) { ret extent(value, align); }
    val increment: u64 = (align - rem)::u64;
    val rounded:   u64 = value::u64 + increment;
    if (rounded > MAX_SIZE) { ret unknown_extent(EXTENT_SIZE_OVERFLOW); }
    ret extent(rounded::u32, align);
}

fun checked_add(left: u32, right: u32, align: u32) Extent {
    val sum: u64 = left::u64 + right::u64;
    if (sum > MAX_SIZE) { ret unknown_extent(EXTENT_SIZE_OVERFLOW); }
    ret extent(sum::u32, align);
}

pub fun extent_of[T](ctx: *T, describe: fun(*T, u32) Node, field: fun(*T, u32, u32) u32,
    id: u32, m: Machine, max_depth: u32) Extent {
    if (ctx == nil || describe == nil || field == nil) {
        ret unknown_extent(EXTENT_INVALID_GRAPH);
    }
    ret walk[T](ctx, describe, field, id, m, 0, max_depth);
}

pub fun field_offset_of[T](ctx: *T, describe: fun(*T, u32) Node,
    field: fun(*T, u32, u32) u32, id: u32, field_ix: u32,
    m: Machine, max_depth: u32) Extent {
    if (ctx == nil || describe == nil || field == nil) {
        ret unknown_extent(EXTENT_INVALID_GRAPH);
    }
    val n: Node = describe(ctx, id);
    if (n.kind == NODE_TAG) {
        if (field_ix >= n.field_count) { ret unknown_extent(EXTENT_FIELD_RANGE); }
        ret tag_layout[T](ctx, describe, field, id, n, m, 0, max_depth).payload;
    }
    if (n.kind != NODE_AGGREGATE)  { ret unknown_extent(EXTENT_NOT_AGGREGATE); }
    if (field_ix >= n.field_count) { ret unknown_extent(EXTENT_FIELD_RANGE); }
    if (n.overlays)                { ret extent(0, 1); }

    var offset: u32 = 0;
    var i:      u32 = 0;
    for (i < n.field_count) {
        val fe: Extent = walk[T](ctx, describe, field, field(ctx, id, i), m, 1, max_depth);
        if (!fe.ok)        { ret unknown_extent(fe.cause); }
        if (fe.align == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
        if (!n.packed) {
            val aligned: Extent = checked_round_up(offset, fe.align);
            if (!aligned.ok) { ret aligned; }
            offset = aligned.size;
        }
        if (i == field_ix) {
            if (n.packed) { ret extent(offset, 1); }
            ret extent(offset, fe.align);
        }
        val advanced: Extent = checked_add(offset, fe.size, fe.align);
        if (!advanced.ok) { ret advanced; }
        offset = advanced.size;
        i      = i + 1;
    }
    ret unknown_extent(EXTENT_FIELD_RANGE);
}

fun walk[T](ctx: *T, describe: fun(*T, u32) Node, field: fun(*T, u32, u32) u32,
    id: u32, m: Machine, depth: u32, max_depth: u32) Extent {
    if (max_depth != DEPTH_UNBOUNDED && depth > max_depth) { ret unknown_extent(EXTENT_DEPTH); }

    val n: Node = describe(ctx, id);

    if (n.kind == NODE_TAG)  { ret tag_layout[T](ctx, describe, field, id, n, m, depth, max_depth).object; }
    if (n.kind == NODE_ZERO) { ret extent(0, 1); }
    if (n.kind == NODE_SCALAR) {
        if (n.bytes == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
        ret extent(n.bytes, n.bytes);
    }
    if (n.kind == NODE_POINTER) {
        if (m.ptr_width == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
        ret extent(m.ptr_width, m.ptr_width);
    }
    if (n.kind == NODE_OPAQUE) {
        if (n.decl_align == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
        ret extent(n.bytes, n.decl_align);
    }

    if (n.kind == NODE_VECTOR) {
        if (n.bytes == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
        val total: u64 = n.bytes::u64 * n.count::u64;
        if (total > MAX_SIZE) { ret unknown_extent(EXTENT_SIZE_OVERFLOW); }
        val size: u32 = total::u32;
        val reg:  u32 = m.vector_bits / 8;
        if (reg > 0 && size >= reg) { ret extent(size, reg); }
        ret extent(size, n.bytes);
    }

    if (n.kind == NODE_ARRAY) {
        val e: Extent = walk[T](ctx, describe, field, n.child, m, depth + 1, max_depth);
        if (!e.ok)        { ret unknown_extent(e.cause); }
        if (e.align == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
        val total: u64 = e.size::u64 * n.count::u64;
        if (total > MAX_SIZE) { ret unknown_extent(EXTENT_ARRAY_OVERFLOW); }
        ret extent(total::u32, e.align);
    }

    if (n.kind == NODE_AGGREGATE) {
        var align:  u32 = 1;
        var offset: u32 = 0;
        var widest: u32 = 0;
        var i:      u32 = 0;
        for (i < n.field_count) {
            val e: Extent = walk[T](ctx, describe, field, field(ctx, id, i), m,
                depth + 1, max_depth);
            if (!e.ok)        { ret unknown_extent(e.cause); }
            if (e.align == 0) { ret unknown_extent(EXTENT_INVALID_ALIGN); }
            if (!n.packed) {
                if (e.align > align) { align = e.align; }
            }
            if (n.overlays) {
                if (e.size > widest) { widest = e.size; }
            }
            or {
                if (!n.packed) {
                    val aligned: Extent = checked_round_up(offset, e.align);
                    if (!aligned.ok) { ret aligned; }
                    offset = aligned.size;
                }
                val advanced: Extent = checked_add(offset, e.size, e.align);
                if (!advanced.ok) { ret advanced; }
                offset = advanced.size;
            }
            i = i + 1;
        }
        if (n.decl_align > align) { align = n.decl_align; }
        if (align == 0)           { ret unknown_extent(EXTENT_INVALID_ALIGN); }
        if (n.overlays)           { ret checked_round_up(widest, align); }
        ret checked_round_up(offset, align);
    }

    ret unknown_extent(EXTENT_UNKNOWN_NODE);
}

# the narrowest discriminator that can number every case
pub fun discriminator_bytes(case_count: u64) u32 {
    if (case_count == 0)          { ret 0; }
    if (case_count <= 256)        { ret 1; }
    if (case_count <= 65536)      { ret 2; }
    if (case_count <= 4294967296) { ret 4; }
    ret 8;
}

rec TagLayout {
    object:  Extent;
    payload: Extent;
}

fun tag_failure(cause: ExtentCause) TagLayout {
    ret TagLayout{object: unknown_extent(cause), payload: unknown_extent(cause)};
}

# a tag node carries its declared discriminator width in `bytes`
fun tag_layout[T](ctx: *T, describe: fun(*T, u32) Node, field: fun(*T, u32, u32) u32,
    id: u32, n: Node, m: Machine, depth: u32, max_depth: u32) TagLayout {
    if (n.field_count == 0) { ret tag_failure(EXTENT_EMPTY_TAG); }
    val discriminator: u32 = n.bytes;
    if (discriminator != 1 && discriminator != 2 && discriminator != 4 && discriminator != 8) {
        ret tag_failure(EXTENT_INVALID_ALIGN);
    }
    var payload_size:  u32 = 0;
    var payload_align: u32 = 1;
    var i:             u32 = 0;
    for (i < n.field_count) {
        val child: Extent = walk[T](ctx, describe, field, field(ctx, id, i), m, depth + 1, max_depth);
        if (!child.ok)                                { ret tag_failure(child.cause); }
        if (child.align == 0)                         { ret tag_failure(EXTENT_INVALID_ALIGN); }
        if (child.size > payload_size)                { payload_size = child.size; }
        if (!n.packed && child.align > payload_align) { payload_align = child.align; }
        i = i + 1;
    }
    val payload: Extent = checked_round_up(discriminator, payload_align);
    if (!payload.ok) { ret tag_failure(payload.cause); }
    var align: u32 = payload_align;
    if (!n.packed && discriminator > align) { align = discriminator; }
    if (n.decl_align > align)               { align = n.decl_align; }
    val combined: Extent = checked_add(payload.size, payload_size, align);
    if (!combined.ok) { ret tag_failure(combined.cause); }
    val object: Extent = checked_round_up(combined.size, align);
    if (!object.ok) { ret tag_failure(object.cause); }
    ret TagLayout{object: object, payload: payload};
}

# the text of an extent cause; absent for a tag outside the catalog
pub fun cause_name(cause: ExtentCause) opt[str] {
    if (cause == EXTENT_EMPTY_TAG)      { ret opt[str].some{"a tag with no cases"}; }
    if (cause == EXTENT_OK)             { ret opt[str].some{"no failure"}; }
    if (cause == EXTENT_UNKNOWN_NODE)   { ret opt[str].some{"a type the layout policy cannot classify"}; }
    if (cause == EXTENT_DEPTH)          { ret opt[str].some{"a type graph deeper than the walk's depth bound"}; }
    if (cause == EXTENT_ARRAY_OVERFLOW) { ret opt[str].some{"an array whose total size does not fit in 32 bits"}; }
    if (cause == EXTENT_NOT_AGGREGATE)  { ret opt[str].some{"a field offset asked of a non-aggregate type"}; }
    if (cause == EXTENT_FIELD_RANGE)    { ret opt[str].some{"a field index past the aggregate's field count"}; }
    if (cause == EXTENT_SIZE_OVERFLOW)  { ret opt[str].some{"a type extent that does not fit in 32 bits"}; }
    if (cause == EXTENT_INVALID_ALIGN)  { ret opt[str].some{"a type with zero-byte alignment"}; }
    if (cause == EXTENT_INVALID_GRAPH)  { ret opt[str].some{"a layout graph with a missing context or callback"}; }
    ret opt[str].none{};
}

test "mach.lang.layout.checked_round_up:cases" {
    val zero: Extent = checked_round_up(0, 0);
    if (zero.ok || zero.cause != EXTENT_INVALID_ALIGN) { ret 1; }
    val one: Extent = checked_round_up(7, 1);
    if (!one.ok || one.size != 7) { ret 1; }
    val exact: Extent = checked_round_up(8, 4);
    if (!exact.ok || exact.size != 8) { ret 1; }
    val next: Extent = checked_round_up(9, 4);
    if (!next.ok || next.size != 12) { ret 1; }
    val wider: Extent = checked_round_up(1, 8);
    if (!wider.ok || wider.size != 8) { ret 1; }
    val overflow: Extent = checked_round_up(4294967295, 2);
    if (overflow.ok || overflow.cause != EXTENT_SIZE_OVERFLOW) { ret 1; }
    ret 0;
}

var tg_nodes:  [72]Node;
var tg_fields: [144]u32;

rec LayoutTestGraph {
    nodes:  *Node;
    fields: *u32;
    stride: u32;
}

var tg_graph: LayoutTestGraph;

fun tg_describe(ctx: *LayoutTestGraph, id: u32) Node {
    ret ctx.nodes[id];
}

fun tg_field(ctx: *LayoutTestGraph, id: u32, index: u32) u32 {
    ret ctx.fields[id * ctx.stride + index];
}

fun tg_extent(id: u32, m: Machine, max_depth: u32) Extent {
    tg_graph.nodes  = ?tg_nodes[0];
    tg_graph.fields = ?tg_fields[0];
    tg_graph.stride = 2;
    ret extent_of[LayoutTestGraph](?tg_graph, tg_describe, tg_field, id, m, max_depth);
}

fun tg_offset(id: u32, field_ix: u32, m: Machine, max_depth: u32) Extent {
    tg_graph.nodes  = ?tg_nodes[0];
    tg_graph.fields = ?tg_fields[0];
    tg_graph.stride = 2;
    ret field_offset_of[LayoutTestGraph](?tg_graph, tg_describe, tg_field, id, field_ix,
        m, max_depth);
}

fun tg_chain(n: u32) {
    var i: u32 = 0;
    for (i < n - 1) {
        tg_nodes[i]             = node(NODE_AGGREGATE);
        tg_nodes[i].field_count = 1;
        tg_fields[i * 2]        = i + 1;
        i                       = i + 1;
    }
    tg_nodes[n - 1]       = node(NODE_SCALAR);
    tg_nodes[n - 1].bytes = 1;
}

test "mach.lang.layout.extent:vector_is_lane_derived" {
    tg_nodes[0] = node(NODE_VECTOR);

    var eb: [10]u32;
    var ln: [10]u32;
    eb[0] = 4;
    ln[0] = 4;
    eb[1] = 8;
    ln[1] = 2;
    eb[2] = 1;
    ln[2] = 16;
    eb[3] = 2;
    ln[3] = 8;
    eb[4] = 4;
    ln[4] = 4;
    eb[5] = 8;
    ln[5] = 2;
    eb[6] = 1;
    ln[6] = 16;
    eb[7] = 2;
    ln[7] = 8;
    eb[8] = 4;
    ln[8] = 4;
    eb[9] = 8;
    ln[9] = 2;

    var i: u32 = 0;
    for (i < 10) {
        tg_nodes[0].bytes = eb[i];
        tg_nodes[0].count = ln[i];
        val e: Extent = tg_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
        if (!e.ok)         { ret 1; }
        if (e.size != 16)  { ret 1; }
        if (e.align != 16) { ret 1; }
        i = i + 1;
    }

    tg_nodes[0].bytes = 4;
    tg_nodes[0].count = 3;
    val v3: Extent = tg_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (v3.size != 12) { ret 1; }
    if (v3.align != 4) { ret 1; }

    tg_nodes[0].bytes = 4;
    tg_nodes[0].count = 2;
    val v2: Extent = tg_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (v2.size != 8)  { ret 1; }
    if (v2.align != 4) { ret 1; }

    tg_nodes[0].bytes = 2;
    tg_nodes[0].count = 4;
    val i16x4: Extent = tg_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (i16x4.size != 8)  { ret 1; }
    if (i16x4.align != 2) { ret 1; }

    tg_nodes[0].bytes = 4;
    tg_nodes[0].count = 4;
    val at128: Extent = tg_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (at128.align != 16) { ret 1; }
    val at256: Extent = tg_extent(0, machine(8, 256), DEPTH_UNBOUNDED);
    if (at256.size != 16) { ret 1; }
    if (at256.align != 4) { ret 1; }

    ret 0;
}

test "mach.lang.layout.extent:causes_are_distinguishable" {
    val missing: Extent = extent_of[LayoutTestGraph](nil::*LayoutTestGraph, tg_describe,
        tg_field, 0, machine(8, 128),
        DEPTH_UNBOUNDED);
    if (missing.ok || missing.cause != EXTENT_INVALID_GRAPH) { ret 1; }

    tg_nodes[0] = node(NODE_UNKNOWN);
    val unk: Extent = tg_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (unk.ok)                           { ret 1; }
    if (unk.cause != EXTENT_UNKNOWN_NODE) { ret 1; }

    tg_nodes[0]             = node(NODE_AGGREGATE);
    tg_nodes[0].field_count = 1;
    tg_fields[0]            = 1;
    tg_nodes[1]             = node(NODE_UNKNOWN);
    val prop: Extent = tg_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (prop.ok)                           { ret 1; }
    if (prop.cause != EXTENT_UNKNOWN_NODE) { ret 1; }

    tg_nodes[0]             = node(NODE_AGGREGATE);
    tg_nodes[0].field_count = 1;
    tg_fields[0]            = 1;
    tg_nodes[1]             = node(NODE_ARRAY);
    tg_nodes[1].child       = 2;
    tg_nodes[1].count       = 4294967295;
    tg_nodes[2]             = node(NODE_SCALAR);
    tg_nodes[2].bytes       = 4;
    val prop2: Extent = tg_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (prop2.ok)                             { ret 1; }
    if (prop2.cause != EXTENT_ARRAY_OVERFLOW) { ret 1; }

    val prop3: Extent = tg_offset(0, 0, machine(8, 128), DEPTH_UNBOUNDED);
    if (prop3.ok)                             { ret 1; }
    if (prop3.cause != EXTENT_ARRAY_OVERFLOW) { ret 1; }

    tg_chain(8);
    val prop4: Extent = tg_extent(0, machine(8, 128), 3);
    if (prop4.ok)                    { ret 1; }
    if (prop4.cause != EXTENT_DEPTH) { ret 1; }

    tg_nodes[0]       = node(NODE_ARRAY);
    tg_nodes[0].child = 1;
    tg_nodes[0].count = 4294967295;
    tg_nodes[1]       = node(NODE_SCALAR);
    tg_nodes[1].bytes = 4;
    val ovf: Extent = tg_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (ovf.ok)                             { ret 1; }
    if (ovf.cause != EXTENT_ARRAY_OVERFLOW) { ret 1; }

    tg_chain(8);
    val deep: Extent = tg_extent(0, machine(8, 128), 3);
    if (deep.ok)                    { ret 1; }
    if (deep.cause != EXTENT_DEPTH) { ret 1; }

    tg_nodes[0]       = node(NODE_SCALAR);
    tg_nodes[0].bytes = 4;
    val nag: Extent = tg_offset(0, 0, machine(8, 128), DEPTH_UNBOUNDED);
    if (nag.ok)                            { ret 1; }
    if (nag.cause != EXTENT_NOT_AGGREGATE) { ret 1; }

    tg_nodes[0]             = node(NODE_AGGREGATE);
    tg_nodes[0].field_count = 1;
    tg_fields[0]            = 1;
    tg_nodes[1]             = node(NODE_SCALAR);
    tg_nodes[1].bytes       = 4;
    val rng: Extent = tg_offset(0, 3, machine(8, 128), DEPTH_UNBOUNDED);
    if (rng.ok)                          { ret 1; }
    if (rng.cause != EXTENT_FIELD_RANGE) { ret 1; }

    val good: Extent = tg_extent(1, machine(8, 128), DEPTH_UNBOUNDED);
    if (!good.ok)                { ret 1; }
    if (good.cause != EXTENT_OK) { ret 1; }
    ret 0;
}

test "mach.lang.layout.extent:rejects_invalid_and_overflowing_extents" {
    tg_nodes[0]       = node(NODE_VECTOR);
    tg_nodes[0].bytes = 4294967295;
    tg_nodes[0].count = 2;
    val vector_overflow: Extent = tg_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (vector_overflow.ok || vector_overflow.cause != EXTENT_SIZE_OVERFLOW) { ret 1; }

    tg_nodes[0]       = node(NODE_SCALAR);
    tg_nodes[0].bytes = 0;
    val scalar_align: Extent = tg_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (scalar_align.ok || scalar_align.cause != EXTENT_INVALID_ALIGN) { ret 1; }

    tg_nodes[0] = node(NODE_POINTER);
    val pointer_align: Extent = tg_extent(0, machine(0, 128), DEPTH_UNBOUNDED);
    if (pointer_align.ok || pointer_align.cause != EXTENT_INVALID_ALIGN) { ret 1; }

    tg_nodes[0]            = node(NODE_OPAQUE);
    tg_nodes[0].bytes      = 4;
    tg_nodes[0].decl_align = 0;
    val opaque_align: Extent = tg_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (opaque_align.ok || opaque_align.cause != EXTENT_INVALID_ALIGN) { ret 1; }

    tg_nodes[0]             = node(NODE_AGGREGATE);
    tg_nodes[0].field_count = 2;
    tg_nodes[0].packed      = true;
    tg_fields[0]            = 1;
    tg_fields[1]            = 1;
    tg_nodes[1]             = node(NODE_SCALAR);
    tg_nodes[1].bytes       = 4294967295;
    val aggregate_add: Extent = tg_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (aggregate_add.ok || aggregate_add.cause != EXTENT_SIZE_OVERFLOW) { ret 1; }

    tg_nodes[0].field_count = 1;
    tg_nodes[0].decl_align  = 2;
    val aggregate_round: Extent = tg_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (aggregate_round.ok || aggregate_round.cause != EXTENT_SIZE_OVERFLOW) { ret 1; }
    ret 0;
}

test "mach.lang.layout.extent:unbounded_walks_past_any_constant" {
    tg_chain(70);
    val deep: Extent = tg_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (!deep.ok)        { ret 1; }
    if (deep.size != 1)  { ret 1; }
    if (deep.align != 1) { ret 1; }

    val bounded: Extent = tg_extent(0, machine(8, 128), 64);
    if (bounded.ok)                    { ret 1; }
    if (bounded.cause != EXTENT_DEPTH) { ret 1; }

    val fits: Extent = tg_extent(0, machine(8, 128), 69);
    if (!fits.ok)       { ret 1; }
    if (fits.size != 1) { ret 1; }
    ret 0;
}

var pk_nodes:  [8]Node;
var pk_fields: [16]u32;

var pk_graph: LayoutTestGraph;

fun pk_describe(ctx: *LayoutTestGraph, id: u32) Node {
    ret ctx.nodes[id];
}

fun pk_field(ctx: *LayoutTestGraph, id: u32, index: u32) u32 {
    ret ctx.fields[id * ctx.stride + index];
}

fun pk_extent(id: u32, m: Machine, max_depth: u32) Extent {
    pk_graph.nodes  = ?pk_nodes[0];
    pk_graph.fields = ?pk_fields[0];
    pk_graph.stride = 2;
    ret extent_of[LayoutTestGraph](?pk_graph, pk_describe, pk_field, id, m, max_depth);
}

test "mach.lang.layout.extent:packed_removes_padding" {
    pk_nodes[1]       = node(NODE_SCALAR);
    pk_nodes[1].bytes = 1;
    pk_nodes[2]       = node(NODE_SCALAR);
    pk_nodes[2].bytes = 4;
    pk_fields[0]      = 1;
    pk_fields[1]      = 2;

    pk_nodes[0]             = node(NODE_AGGREGATE);
    pk_nodes[0].field_count = 2;

    val nat: Extent = pk_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (!nat.ok)        { ret 1; }
    if (nat.size != 8)  { ret 1; }
    if (nat.align != 4) { ret 1; }

    pk_nodes[0].packed = true;
    val pkd: Extent = pk_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (!pkd.ok)        { ret 1; }
    if (pkd.size != 5)  { ret 1; }
    if (pkd.align != 1) { ret 1; }

    pk_nodes[0].decl_align = 8;
    val both: Extent = pk_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (!both.ok)        { ret 1; }
    if (both.size != 8)  { ret 1; }
    if (both.align != 8) { ret 1; }

    pk_nodes[0].decl_align = 0;
    pk_nodes[0].overlays   = true;
    val uni_p: Extent = pk_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (uni_p.size != 4)  { ret 1; }
    if (uni_p.align != 1) { ret 1; }

    pk_nodes[0].packed = false;
    val uni_n: Extent = pk_extent(0, machine(8, 128), DEPTH_UNBOUNDED);
    if (uni_n.size != 4)  { ret 1; }
    if (uni_n.align != 4) { ret 1; }

    ret 0;
}

test "mach.lang.layout.extent:packed_does_not_propagate" {
    pk_nodes[3]             = node(NODE_SCALAR);
    pk_nodes[3].bytes       = 1;
    pk_nodes[4]             = node(NODE_SCALAR);
    pk_nodes[4].bytes       = 4;
    pk_fields[10]           = 3;
    pk_fields[11]           = 4;
    pk_nodes[5]             = node(NODE_AGGREGATE);
    pk_nodes[5].field_count = 2;

    val inner: Extent = pk_extent(5, machine(8, 128), DEPTH_UNBOUNDED);
    if (inner.size != 8) { ret 1; }

    pk_nodes[6]             = node(NODE_SCALAR);
    pk_nodes[6].bytes       = 1;
    pk_fields[14]           = 6;
    pk_fields[15]           = 5;
    pk_nodes[7]             = node(NODE_AGGREGATE);
    pk_nodes[7].field_count = 2;
    pk_nodes[7].packed      = true;

    val outer: Extent = pk_extent(7, machine(8, 128), DEPTH_UNBOUNDED);
    if (!outer.ok)        { ret 1; }
    if (outer.size != 9)  { ret 1; }
    if (outer.align != 1) { ret 1; }
    ret 0;
}

test "mach.lang.layout.tag:discriminator_width_boundaries" {
    if (discriminator_bytes(0) != 0 || discriminator_bytes(1) != 1 || discriminator_bytes(256) != 1) { ret 1; }
    if (discriminator_bytes(257) != 2 || discriminator_bytes(65536) != 2)                            { ret 2; }
    if (discriminator_bytes(65537) != 4 || discriminator_bytes(4294967296) != 4)                     { ret 3; }
    if (discriminator_bytes(4294967297) != 8 || discriminator_bytes(18446744073709551615) != 8)      { ret 4; }
    ret 0;
}

test "mach.lang.layout.tag:common_payload_offset_packing_and_outer_alignment" {
    tg_nodes[0]             = node(NODE_TAG);
    tg_nodes[0].bytes       = 1;
    tg_nodes[0].field_count = 2;
    tg_fields[0]            = 1;
    tg_fields[1]            = 2;
    tg_nodes[1]             = node(NODE_ZERO);
    tg_nodes[2]             = node(NODE_SCALAR);
    tg_nodes[2].bytes       = 8;
    val natural: Extent = tg_extent(0, machine(8, 128), 16);
    val payload: Extent = tg_offset(0, 1, machine(8, 128), 16);
    if (!natural.ok || natural.size != 16 || natural.align != 8 || !payload.ok || payload.size != 8 || payload.align != 8) { ret 1; }
    tg_nodes[0].packed = true;
    val packed:         Extent = tg_extent(0, machine(8, 128), 16);
    val packed_payload: Extent = tg_offset(0, 1, machine(8, 128), 16);
    if (!packed.ok || packed.size != 9 || packed.align != 1 || !packed_payload.ok || packed_payload.size != 1 || packed_payload.align != 1) { ret 2; }
    tg_nodes[0].decl_align = 16;
    val aligned: Extent = tg_extent(0, machine(8, 128), 16);
    if (!aligned.ok || aligned.size != 16 || aligned.align != 16) { ret 3; }
    tg_nodes[0].packed     = false;
    tg_nodes[0].decl_align = 32;
    val raised:         Extent = tg_extent(0, machine(8, 128), 16);
    val raised_payload: Extent = tg_offset(0, 1, machine(8, 128), 16);
    if (!raised.ok || raised.size != 32 || raised.align != 32 || raised_payload.size != 8) { ret 4; }
    tg_nodes[0].decl_align = 0;
    tg_nodes[0].bytes      = 4;
    val wide:         Extent = tg_extent(0, machine(8, 128), 16);
    val wide_payload: Extent = tg_offset(0, 1, machine(8, 128), 16);
    if (!wide.ok || wide.size != 16 || wide.align != 8 || wide_payload.size != 8) { ret 5; }
    tg_nodes[0].bytes = 0;
    val undeclared: Extent = tg_extent(0, machine(8, 128), 16);
    if (undeclared.ok || undeclared.cause != EXTENT_INVALID_ALIGN) { ret 6; }
    ret 0;
}

test "mach.lang.layout.tag:payloadless_nested_overflow_and_recursive_cases" {
    tg_nodes[0]             = node(NODE_TAG);
    tg_nodes[0].bytes       = 1;
    tg_nodes[0].field_count = 1;
    tg_fields[0]            = 1;
    tg_nodes[1]             = node(NODE_ZERO);
    val empty: Extent = tg_extent(0, machine(8, 128), 8);
    if (!empty.ok || empty.size != 1 || empty.align != 1) { ret 1; }
    tg_nodes[1]             = node(NODE_TAG);
    tg_nodes[1].bytes       = 1;
    tg_nodes[1].field_count = 1;
    tg_fields[2]            = 2;
    tg_nodes[2]             = node(NODE_SCALAR);
    tg_nodes[2].bytes       = 8;
    tg_nodes[0].packed      = true;
    val nested: Extent = tg_extent(0, machine(8, 128), 8);
    if (!nested.ok || nested.size != 17 || nested.align != 1) { ret 2; }
    tg_nodes[1]            = node(NODE_OPAQUE);
    tg_nodes[1].bytes      = 4294967295;
    tg_nodes[1].decl_align = 1;
    val overflow: Extent = tg_extent(0, machine(8, 128), 8);
    if (overflow.ok || overflow.cause != EXTENT_SIZE_OVERFLOW) { ret 3; }
    tg_fields[0] = 0;
    val recursive: Extent = tg_extent(0, machine(8, 128), 8);
    if (recursive.ok || recursive.cause != EXTENT_DEPTH) { ret 4; }
    tg_nodes[0].field_count = 0;
    val absent: Extent = tg_extent(0, machine(8, 128), 8);
    if (absent.ok || absent.cause != EXTENT_EMPTY_TAG) { ret 5; }
    ret 0;
}
