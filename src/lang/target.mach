    if (R.is_err[resolved.Target, str](res_dw)) { bad = true; }
    or (!str_empty(R.unwrap_ok[resolved.Target, str](res_dw).fs_policy.dynamic_interpreter)) { bad = true; }

    val res_win: R.Result[resolved.Target, str] = select(?reg, "x86_64", "windows", "win64");
    if (R.is_err[resolved.Target, str](res_win)) { bad = true; }
    or (!str_empty(R.unwrap_ok[resolved.Target, str](res_win).fs_policy.dynamic_interpreter)) { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.fingerprint_fs_policy:isolated_to_declared_policy_fields" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var bad: bool = false;

    var pa: os.FsPolicy;
    pa.sysroot = "";
    pa.toolchain_root = "";
    pa.dynamic_interpreter = "/lib64/ld-linux-x86-64.so.2";
    pa.platform_lib = "";
    pa.libdirs[0] = "/lib64";
    pa.libdir_len = 1;

    var pb: os.FsPolicy = pa;
    pb.dynamic_interpreter = "/lib/ld-linux-aarch64.so.1";

    var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint_fs_policy(?pa, ?ea)) { bad = true; }
    if (!fingerprint_fs_policy(?pb, ?eb)) { bad = true; }
    if (fp_bytes_equal(?ea, ?eb)) { bad = true; }
    if (ea.len == 0) { bad = true; }

    var ea2: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint_fs_policy(?pa, ?ea2)) { bad = true; }
    if (!fp_bytes_equal(?ea, ?ea2)) { bad = true; }

    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);
    binary.encoder_dnit(?ea2);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.select:c_variadic_stack_is_per_os_and_isa" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }

    val da: R.Result[resolved.Target, str] = select(?reg, "aarch64", "darwin", "aapcs64");
    if (R.is_err[resolved.Target, str](da))                                     { ret 1; }
    if (!R.unwrap_ok[resolved.Target, str](da).variadic_args_on_stack)          { ret 1; }

    val la: R.Result[resolved.Target, str] = select(?reg, "aarch64", "linux", "aapcs64");
    if (R.is_err[resolved.Target, str](la))                                     { ret 1; }
    if (R.unwrap_ok[resolved.Target, str](la).variadic_args_on_stack)           { ret 1; }
    if (R.unwrap_ok[resolved.Target, str](da).abi != R.unwrap_ok[resolved.Target, str](la).abi) { ret 1; }

    val dx: R.Result[resolved.Target, str] = select(?reg, "x86_64", "darwin", "sysv64");
    if (R.is_err[resolved.Target, str](dx))                                     { ret 1; }
    if (R.unwrap_ok[resolved.Target, str](dx).variadic_args_on_stack)           { ret 1; }

    val lx: R.Result[resolved.Target, str] = select(?reg, "x86_64", "linux", "sysv64");
    if (R.is_err[resolved.Target, str](lx))                                     { ret 1; }
    if (R.unwrap_ok[resolved.Target, str](lx).variadic_args_on_stack)           { ret 1; }

    ret 0;
}

