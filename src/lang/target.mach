# target resolution: a target request read against the owners' catalogs
#
# a request names an architecture and a system as mink spells them, the
# environment its manifest states, a calling convention, a baseline as masc
# spells one and the extensions it adds. each part is looked up in its owner's
# catalog: mink's architecture and system lists, the host mink states for them,
# masc's extension catalog of the architecture, and the target mirl assembles
# from the five. every fact the build reads of a target comes from those rows,
# and mach states none of them. what mach requires of the images it builds,
# where the manifest states nothing, is its own data (mach.lang.target.defaults)
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use A:                  std.allocator;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.text.string.str_free;

use masc_diagnostic: masc.core.diagnostic;
use masc_extension:  masc.core.extension;
use masc_set:        masc.core.set;
use masc_isa:        masc.isa.isa;
use mink_fail:       mink.base.fail;
use mink_arch:       mink.catalog.arch;
use mink_arch_list:  mink.catalog.arch.list;
use catalog_format:  mink.catalog.format;
use mink.catalog.format.Format;
use mink_kind:    mink.catalog.kind;
use mink_os:      mink.catalog.os;
use mink_os_list: mink.catalog.os.list;
use mink_output:  mink.catalog.output;
use mirl_target:  mirl.target;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.layout;
use mach.lang.target.assembled;
use catalog_artifact: mach.lang.target.catalog.artifact;
use target_defaults:  mach.lang.target.defaults;
use target_host:      mach.lang.target.host;
use mach.lang.target.resolved;
use target_tags: mach.lang.target.tags;
use mach.lang.textbuild;

fwd resolved.Target;

pub rec TargetRequest {
    arch_name:     str;
    sys_name:      str;
    abi_name:      str;
    of_name:       str;
    base:          u64;
    stack_reserve: u64;
    stack_commit:  u64;
    env_name:      str;
    # where the caller's `env` was written, which a refusal of it names
    env_origin: str;
    # names of masc's catalog of the architecture, borrowed for the call
    extensions:      *str;
    extension_count: u32;
    # the baseline the target stands on, in masc's spelling, "" for its host's floor
    isa_name: str;
}

pub fun target_request(arch_name: str, sys_name: str, abi_name: str) TargetRequest {
    var r: TargetRequest;
    r.arch_name       = arch_name;
    r.sys_name        = sys_name;
    r.abi_name        = abi_name;
    r.of_name         = "";
    r.base            = 0;
    r.stack_reserve   = 0;
    r.stack_commit    = 0;
    r.env_name        = "";
    r.env_origin      = "";
    r.extensions      = nil;
    r.extension_count = 0;
    r.isa_name        = "";
    ret r;
}

pub fun with_isa(req: *TargetRequest, isa_name: str) {
    req.isa_name = isa_name;
}

pub fun with_extensions(req: *TargetRequest, names: *str, count: u32) {
    req.extensions      = names;
    req.extension_count = count;
}

pub fun with_of(req: *TargetRequest, of_name: str) {
    req.of_name = of_name;
}

pub fun with_env(req: *TargetRequest, env_name: str, origin: str) {
    req.env_name   = env_name;
    req.env_origin = origin;
}

pub fun with_image(req: *TargetRequest, base: u64, stack_reserve: u64, stack_commit: u64) {
    req.base          = base;
    req.stack_reserve = stack_reserve;
    req.stack_commit  = stack_commit;
}

# the architecture the compiler itself was built for, as its manifest names it
pub fun host_arch_name() str {
    ret $project.target.arch;
}

# the system the compiler itself was built for, as its manifest names it
pub fun host_sys_name() str {
    ret $project.target.sys;
}

# the calling convention the compiler itself was built for, as its manifest names it
pub fun host_abi_name() str {
    ret $project.target.abi;
}

# the request a `native` selection resolves: the host's architecture, system and
# convention as the compiler's own manifest names them. no environment is filled
# in, since env comes from a manifest alone
pub fun host_request() TargetRequest {
    ret target_request(host_arch_name(), host_sys_name(), host_abi_name());
}

# the names of a row list, `, `-separated, owned by `a`
fun names_of(a: *A.Allocator, count: usize, name_at: fun(usize) str) res[str, fail.Fail] {
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    var i: usize                 = 0;
    for (i < count) {
        if (i > 0) { val sep: err[textbuild.Error] = textbuild.tb_append(?b, ", "); }
        val named: err[textbuild.Error] = textbuild.tb_append(?b, name_at(i));
        i = i + 1;
    }
    val done: res[str, textbuild.Error] = textbuild.tb_finish(?b);
    if (sel done.err) {
        textbuild.tb_dnit(?b);
        ret res[str, fail.Fail].err{fail.message(textbuild.text(done.err))};
    }
    ret res[str, fail.Fail].ok{done.ok};
}

fun arch_name_at(i: usize) str {
    ret mink_arch_list.at(i).name;
}

fun sys_name_at(i: usize) str {
    ret mink_os_list.at(i).name;
}

# a part no row of its owner's catalog spells, refused with the spellings it holds
fun unknown(a: *A.Allocator, noun: str, owner: str, name: str, count: usize, name_at: fun(usize) str) fail.Fail {
    val known: res[str, fail.Fail] = names_of(a, count, name_at);
    if (sel known.err) { ret known.err; }
    fin { str_free(a, known.ok); }
    ret fail.formatted_user(a, diagnostic_kind.TARGET_UNSUPPORTED, "target: {} `{}` is not a row of {} (its rows: {})", noun, name, owner, known.ok);
}

# masc's instruction set for `arch`, none where masc serves it with none
pub fun set_of(arch: *mink_arch.Arch) opt[*masc_set.Set] {
    ret masc_set.find(?masc_isa.REGISTRY, arch);
}

# the object format the target writes: the one it names of those its system
# accepts, else the system's own, the first its row lists
fun format_of(a: *A.Allocator, sys: *mink_os.System, named: str) res[*Format, fail.Fail] {
    if (sys.format_count == 0) {
        ret res[*Format, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.TARGET_UNSUPPORTED, "target: system `{}` writes no object format", sys.name)};
    }
    if (str_empty(named)) { ret res[*Format, fail.Fail].ok{sys.formats[0]}; }
    var i: usize = 0;
    for (i < sys.format_count) {
        if (str_equals(sys.formats[i].name, named)) { ret res[*Format, fail.Fail].ok{sys.formats[i]}; }
        i = i + 1;
    }
    ret res[*Format, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.TARGET_UNSUPPORTED, "target: system `{}` writes no `{}` objects", sys.name, named)};
}

# the closed selection of `isa` with the names `added` adds, read by masc's catalog
# for the architecture; none selected where masc serves it with no instruction set
fun selection_of(a: *A.Allocator, arch: *mink_arch.Arch, isa: str, added: *str, count: u32) res[resolved.Selected, fail.Fail] {
    val set:     opt[*masc_set.Set]      = set_of(arch);
    var catalog: *masc_extension.Catalog = nil;
    if (sel set.some) { catalog = set.some.extensions; }
    if (catalog == nil) {
        if (count > 0) {
            ret res[resolved.Selected, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.EXTENSION_UNKNOWN,
                "target: arch `{}` takes no `ext`: masc states no extension catalog for it", arch.name)};
        }
        ret res[resolved.Selected, fail.Fail].ok{resolved.selected_none()};
    }
    val c:    *masc_extension.Catalog                             = catalog;
    val base: res[masc_extension.Selection, masc_extension.Error] = masc_extension.select(a, c, isa, masc_diagnostic.START);
    if (sel base.err) {
        ret res[resolved.Selected, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.TARGET_UNSUPPORTED, "target: isa `{}` on arch `{}`: masc's catalog refuses it", isa, arch.name)};
    }
    var held: masc_extension.Selection = base.ok;
    fin { val dropped: err[A.Error] = masc_extension.release(?held); }
    val opened: res[masc_extension.Request, masc_extension.Error] = masc_extension.request(a, c, isa, masc_diagnostic.START);
    if (sel opened.err) { ret res[resolved.Selected, fail.Fail].err{fail.message("target: masc opened no request over its catalog")}; }
    var r: masc_extension.Request = opened.ok;
    var i: u32                    = 0;
    for (i < c.count) {
        if (masc_extension.has(?held, i)) { masc_extension.request_edit(?r, masc_extension.Edit.enable{i}); }
        i = i + 1;
    }
    i = 0;
    for (i < held.stated.len) {
        masc_extension.request_edit(?r, masc_extension.Edit.state{held.stated.at[i]});
        i = i + 1;
    }
    i = 0;
    for (i < count) {
        val name: str                            = added[i];
        val e:    opt[*masc_extension.NameEntry] = masc_extension.entry(c, View{data: name, len: str_len(name)}, false);
        if (sel e.none) {
            val freed: err[A.Error] = masc_extension.request_release(?r);
            ret res[resolved.Selected, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.EXTENSION_UNKNOWN,
                "target: `{}` is not a name of masc's extension catalog of arch `{}`", name, arch.name)};
        }
        masc_extension.request_entry(?r, e.some);
        i = i + 1;
    }
    val closed: res[masc_extension.Selection, masc_extension.Error] = masc_extension.close(r);
    if (sel closed.err) {
        ret res[resolved.Selected, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.TARGET_UNSUPPORTED,
            "target: the extensions the target adds over isa `{}` on arch `{}` conflict in masc's catalog", isa, arch.name)};
    }
    var whole: masc_extension.Selection = closed.ok;
    fin { val dropped: err[A.Error] = masc_extension.release(?whole); }
    ret res[resolved.Selected, fail.Fail].ok{resolved.selected_of(?whole)};
}

# the target a request names, every fact of it read from its owners
pub fun resolve(a: *A.Allocator, req: *TargetRequest) res[resolved.Target, fail.Fail] {
    if (req == nil) { ret res[resolved.Target, fail.Fail].err{fail.message("target: resolve requires a target request")}; }
    val arch_r: res[*mink_arch.Arch, mink_fail.Fail] = mink_arch_list.by_name(req.arch_name);
    if (sel arch_r.err) { ret res[resolved.Target, fail.Fail].err{unknown(a, "arch", "mink's architecture catalog", req.arch_name, mink_arch_list.count(), arch_name_at)}; }
    val sys_r: res[*mink_os.System, mink_fail.Fail] = mink_os_list.by_name(req.sys_name);
    if (sel sys_r.err) { ret res[resolved.Target, fail.Fail].err{unknown(a, "sys", "mink's system catalog", req.sys_name, mink_os_list.count(), sys_name_at)}; }
    val arch: *mink_arch.Arch   = arch_r.ok;
    val sys:  *mink_os.System   = sys_r.ok;
    var env:  opt[*mink_os.Env] = opt[*mink_os.Env].none{};
    if (!str_empty(req.env_name)) {
        val named: res[*mink_os.Env, mink_fail.Fail] = mink_os_list.env_by_name(sys, req.env_name);
        if (sel named.err) {
            if (str_empty(req.env_origin)) {
                ret res[resolved.Target, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.MANIFEST_INVALID_VALUE, "env \"{}\": system `{}` has no environment of that name in mink's catalog", req.env_name, sys.name)};
            }
            ret res[resolved.Target, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.MANIFEST_INVALID_VALUE, "{}: system `{}` has no environment of that name in mink's catalog", req.env_origin, sys.name)};
        }
        env = opt[*mink_os.Env].some{named.ok};
    }
    if (!mink_os.runs(sys, env, arch)) {
        ret res[resolved.Target, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.TARGET_UNSUPPORTED, "target: mink's catalog holds no host of system `{}` running arch `{}` under the environment the target states", sys.name, arch.name)};
    }

    var abi: str = req.abi_name;
    if (str_empty(abi)) {
        val plain: res[*mink_os.Host, fail.Fail] = target_host.of(a, sys, env, arch, "");
        if (sel plain.err) { ret res[resolved.Target, fail.Fail].err{plain.err}; }
        val stated: opt[str] = target_host.default_abi(plain.ok);
        if (sel stated.none) {
            ret res[resolved.Target, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.MANIFEST_INVALID_VALUE, "target: system `{}` names no default calling convention for arch `{}`, so the target must state its `abi`", sys.name, arch.name)};
        }
        abi = stated.some;
    }
    val host_r: res[*mink_os.Host, fail.Fail] = target_host.of(a, sys, env, arch, abi);
    if (sel host_r.err) { ret res[resolved.Target, fail.Fail].err{host_r.err}; }
    val host: *mink_os.Host = host_r.ok;

    var isa: str = req.isa_name;
    if (str_empty(isa)) {
        val floor: opt[str] = target_host.floor(host);
        if (sel floor.none) {
            ret res[resolved.Target, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.TARGET_BASELINE_REQUIRED,
                "target: a `{}` target on {} must state its `isa`, the selection its chip implements: the system states no floor, so no default is right", arch.name, sys.name)};
        }
        isa = floor.some;
    }
    if (req.extension_count > resolved.MAX_ADDED) {
        ret res[resolved.Target, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.EXTENSION_TOO_MANY, "target: the target adds more than {} extensions", resolved.MAX_ADDED)};
    }
    val format_r: res[*Format, fail.Fail] = format_of(a, sys, req.of_name);
    if (sel format_r.err) { ret res[resolved.Target, fail.Fail].err{format_r.err}; }
    val selected_r: res[resolved.Selected, fail.Fail] = selection_of(a, arch, isa, req.extensions, req.extension_count);
    if (sel selected_r.err) { ret res[resolved.Target, fail.Fail].err{selected_r.err}; }

    var t: resolved.Target = resolved.none();
    t.arch          = arch;
    t.sys           = sys;
    t.env           = env;
    t.abi           = abi;
    t.isa           = isa;
    t.format        = format_r.ok;
    t.env_name      = req.env_name;
    t.base          = req.base;
    t.stack_reserve = req.stack_reserve;
    t.stack_commit  = req.stack_commit;
    if (req.stack_reserve == 0 && req.stack_commit == 0) {
        val reserve: opt[u64] = target_defaults.stack_reserve(sys);
        if (sel reserve.some) { t.stack_reserve = reserve.some; }
    }
    t.added_count = req.extension_count;
    var i: u32 = 0;
    for (i < req.extension_count) {
        t.added[i] = req.extensions[i];
        i          = i + 1;
    }
    t.selected = selected_r.ok;
    val served: opt[*masc_set.Set] = set_of(arch);
    t.has_assembly = sel served.some;
    t.os_id        = target_tags.sys_id(sys);
    t.arch_id      = target_tags.arch_id(arch);
    t.abi_id       = target_tags.abi_named(abi);

    val caps_r: res[mink_os.Caps, fail.Fail] = target_host.caps(a, host);
    if (sel caps_r.err) { ret res[resolved.Target, fail.Fail].err{caps_r.err}; }
    t.pie_default = (caps_r.ok & mink_os.PIE_DEFAULT) != 0;
    t.relocated   = sel host.placement.relocated;
    t.subsystem   = host.subsystem;

    val made: res[*assembled.Assembled, fail.Fail] = assembled.assemble(a, ?t);
    if (sel made.err) { ret res[resolved.Target, fail.Fail].err{made.err}; }
    val x: *assembled.Assembled = made.ok;
    fin { assembled.release(a, x); }
    val scalars: res[layout.Scalars, fail.Fail] = assembled.scalars_of(a, x);
    if (sel scalars.err) { ret res[resolved.Target, fail.Fail].err{scalars.err}; }
    t.scalars = scalars.ok;
    t.nans    = assembled.nans_of(x);
    t.va_list = assembled.va_list_of(a, x);
    if (sel t.scalars.pointer.none) {
        ret res[resolved.Target, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.TARGET_UNSUPPORTED,
            "target: mirl holds the pointers of arch `{}` on {} logically and states no address width, so `usize` has none", arch.name, sys.name)};
    }
    t.pointer_width   = t.scalars.pointer.some.size;
    t.flat_addressing = true;
    ret res[resolved.Target, fail.Fail].ok{t};
}

# the naming of an artifact's file, as mink's system names a file of its kind:
# prefix, then the artifact's name, then the extension
# ---
# prefix: written before its name
# suffix: written after its name, with its dot
pub rec ArtifactName {
    prefix: str;
    suffix: str;
}

# the executable mink builds on the target: a finished module for a format that
# finishes its modules, a position independent executable where the host runs one
# by default or its loader places every image, else a fixed-address executable
pub fun executable_output(t: *resolved.Target) *mink_output.Kind {
    if (finished_modules(t))          { ret ?mink_output.MODULE; }
    if (t.pie_default || t.relocated) { ret ?mink_output.PIE; }
    ret ?mink_output.STATIC;
}

# the output mink builds for an artifact of `kind` on the target: its executable for
# an executable, a shared library, and for an object directory its relocatable
# objects. none for a static library, which mink archives rather than links
pub fun output_of(t: *resolved.Target, kind: catalog_artifact.Kind) opt[*mink_output.Kind] {
    if (kind == catalog_artifact.EXECUTABLE) { ret opt[*mink_output.Kind].some{executable_output(t)}; }
    if (kind == catalog_artifact.SHARED)     { ret opt[*mink_output.Kind].some{?mink_output.SHARED}; }
    if (kind == catalog_artifact.OBJECTS)    { ret opt[*mink_output.Kind].some{?mink_output.RELOCATABLE}; }
    ret opt[*mink_output.Kind].none{};
}

# the name an artifact of `kind` takes on the target, mink's system's name of the
# file: an archive for a static library, and for every other kind the kind of file
# its output reads back as. refused, with mink's reason, where the system builds none
pub fun artifact_naming(a: *A.Allocator, t: *resolved.Target, kind: catalog_artifact.Kind) res[ArtifactName, fail.Fail] {
    if (!resolved.is_selected(t)) { ret res[ArtifactName, fail.Fail].err{fail.message("artifact naming: no target is selected")}; }
    var file: *mink_kind.Kind        = ?mink_kind.ARCHIVE;
    val out:  opt[*mink_output.Kind] = output_of(t, kind);
    if (sel out.some) { file = out.some.reads_as; }
    val named: res[*mink_os.Filename, mink_fail.Fail] = mink_os.filename(t.sys, file);
    if (sel named.err) {
        val why: mink_fail.Fail = named.err;
        if (why.cite == nil) {
            ret res[ArtifactName, fail.Fail].err{fail.formatted(a, "artifact naming: mink's system `{}` names no {} file: {}", t.sys.name, file.name, why.text)};
        }
        ret res[ArtifactName, fail.Fail].err{fail.formatted(a, "artifact naming: mink's system `{}` names no {} file: {} ({})", t.sys.name, file.name, why.text, why.cite)};
    }
    ret res[ArtifactName, fail.Fail].ok{ArtifactName{prefix: named.ok.prefix, suffix: named.ok.extension}};
}

# whether the target's object format holds each module as its own artifact, as a
# SPIR-V module: mink builds a module of the format and no executable of it
pub fun finished_modules(t: *resolved.Target) bool {
    if (t.format == nil) { ret false; }
    ret mink_output.builds(?mink_output.MODULE, t.format) && !mink_output.builds(?mink_output.STATIC, t.format);
}

# whether the target's object format is a flat image, mink's flat format
pub fun flat_image(t: *resolved.Target) bool {
    ret t.format != nil && t.format == ?catalog_format.FLAT;
}

# whether the target's images state a subsystem, as mink's host of it names a
# default one, so an artifact's `subsystem`, icon and manifest mean something
pub fun states_subsystem(t: *resolved.Target) bool {
    ret sel t.subsystem.some;
}

# whether a module's object is read again by a link or the cache, so it carries
# mach's record section: every object but a flat image's and a finished module's
pub fun carries_record(t: *resolved.Target) bool {
    ret t.format != nil && !flat_image(t) && !finished_modules(t);
}

# one target the new path builds: a host mink states, the convention and the floor
# it runs under, as mirl assembles them
pub rec Cell {
    arch:   *mink_arch.Arch;
    sys:    *mink_os.System;
    env:    opt[*mink_os.Env];
    abi:    str;
    isa:    str;
    format: *Format;
}

fun same_env(x: opt[*mink_os.Env], y: opt[*mink_os.Env]) bool {
    if (sel x.none) { ret sel y.none; }
    ret sel y.some && y.some == x.some;
}

fun listed(out: *Vector[Cell], arch: *mink_arch.Arch, sys: *mink_os.System, env: opt[*mink_os.Env], abi: str) bool {
    var i: usize = 0;
    for (i < out.len) {
        val c: *Cell = ?out.data[i];
        if (c.arch == arch && c.sys == sys && same_env(c.env, env) && str_equals(c.abi, abi)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether mirl assembles a target from the host's row under the convention `abi`
fun assembles(a: *A.Allocator, h: *mink_os.Host, abi: str, floor: str) bool {
    var t: resolved.Target = resolved.none();
    t.arch = h.arch;
    t.sys  = h.sys;
    t.env  = h.env;
    t.abi  = abi;
    t.isa  = floor;
    val built: res[mirl_target.Target, fail.Fail] = assembled.made(a, assembled.tuple_of(?t));
    if (sel built.err) { ret false; }
    var target: mirl_target.Target = built.ok;
    mirl_target.release(a, ?target);
    ret true;
}

fun cell_add(a: *A.Allocator, out: *Vector[Cell], h: *mink_os.Host, abi: str, floor: str) err[fail.Fail] {
    if (listed(out, h.arch, h.sys, h.env, abi)) { ret err[fail.Fail].ok{}; }
    if (!assembles(a, h, abi, floor))           { ret err[fail.Fail].ok{}; }
    if (h.sys.format_count == 0)                { ret err[fail.Fail].ok{}; }
    val pushed: res[usize, A.Error] = collections_vector.push[Cell](out, Cell{arch: h.arch, sys: h.sys, env: h.env, abi: abi, isa: floor, format: h.sys.formats[0]});
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# every target the new path builds over its host's floor, in mink's system order: each
# host row of each system, under the convention it calls by default, else each its
# architecture's family names, that mirl assembles a target from. a host that states no
# floor is a target only with the `isa` its chip implements, so it is not listed
pub fun cells(a: *A.Allocator, out: *Vector[Cell]) err[fail.Fail] {
    var s: usize = 0;
    for (s < mink_os_list.count()) {
        val sys: *mink_os.System = mink_os_list.at(s);
        var h:   usize           = 0;
        for (h < sys.host_count) {
            val host:  *mink_os.Host = ?sys.hosts[h];
            val floor: opt[str]      = target_host.floor(host);
            h = h + 1;
            if (sel floor.none) { cnt; }
            val stated: opt[str] = target_host.default_abi(host);
            if (sel stated.some) {
                val added: err[fail.Fail] = cell_add(a, out, host, stated.some, floor.some);
                if (sel added.err) { ret added; }
                cnt;
            }
            val f: *mink_arch.Family = host.arch.family;
            var k: usize             = 0;
            for (k < f.abi_count) {
                if (f.abis[k].arch == host.arch) {
                    val added: err[fail.Fail] = cell_add(a, out, host, f.abis[k].name, floor.some);
                    if (sel added.err) { ret added; }
                }
                k = k + 1;
            }
        }
        s = s + 1;
    }
    ret err[fail.Fail].ok{};
}
