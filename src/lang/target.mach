    arch_vt.machine.dwarf_reg = nil;

    var req:   TargetRequest                   = target_request("x86_64", "linux", "sysv64");
    val r_882: res[resolved.Target, fail.Fail] = resolve(?reg, ?req);
    if (sel r_882.ok) { ret 1; }
    ret 0;
}

test "mach.lang.target.tuple_capability:a_hosted_os_constrains_the_abi_to_its_declared_set" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_reg: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_reg.err) { ret 1; }

    val foreign: res[resolved.Target, fail.Fail] = select(?reg, "x86_64", "linux", "win64");
    if (sel foreign.ok)                                                                                                                                   { ret 2; }
    if (!str_equals(fail.describe(foreign.err), "operating system 'linux' accepts calling convention 'sysv64' on instruction set 'x86_64', not 'win64'")) { ret 3; }
    val darwin_foreign: res[resolved.Target, fail.Fail] = select(?reg, "x86_64", "darwin", "win64");
    if (sel darwin_foreign.ok) { ret 4; }
    val windows_foreign: res[resolved.Target, fail.Fail] = select(?reg, "x86_64", "windows", "sysv64");
    if (sel windows_foreign.ok) { ret 5; }
    val native: res[resolved.Target, fail.Fail] = select(?reg, "x86_64", "linux", "sysv64");
    if (sel native.err) { ret 6; }

    # linux declares the whole riscv64 psABI float family: the kernel abi is integer-only
    val soft: res[resolved.Target, fail.Fail] = select(?reg, "riscv64", "linux", "lp64");
    if (sel soft.err) { ret 7; }
    val single: res[resolved.Target, fail.Fail] = select(?reg, "riscv64", "linux", "lp64f");
    if (sel single.err) { ret 7; }

    # freestanding declares itself unconstrained, so every convention the isa covers stays legal
    val bare_win: res[resolved.Target, fail.Fail] = select(?reg, "x86_64", "freestanding", "win64");
    if (sel bare_win.err) { ret 8; }
    val bare_soft: res[resolved.Target, fail.Fail] = select(?reg, "riscv64", "freestanding", "lp64");
    if (sel bare_soft.err) { ret 9; }

    # the code is its own row, judged after every lower-level capability
    val opt_os:  opt[*os.OsVTable]   = os.lookup(?reg.os, "linux");
    val opt_isa: opt[*isa.IsaVTable] = isa.lookup(?reg.isa, "x86_64");
    val opt_abi: opt[*abi.AbiVTable] = abi.lookup(?reg.abi, "win64");
    val opt_of:  opt[*of.OfVTable]   = of.lookup(?reg.of, "elf");
    if (sel opt_os.none)                                                                        { ret 10; }
    if (sel opt_isa.none)                                                                       { ret 10; }
    if (sel opt_abi.none)                                                                       { ret 10; }
    if (sel opt_of.none)                                                                        { ret 10; }
    if (tuple_capability(opt_os.some, opt_isa.some, opt_abi.some, opt_of.some) != TUPLE_OS_ABI) { ret 11; }

    # a multi-member set is named in full when refusing
    val opt_rv: opt[*isa.IsaVTable] = isa.lookup(?reg.isa, "riscv64");
    if (sel opt_rv.none) { ret 12; }
    var odd: abi.AbiVTable = target_testing.carriers_convention();
    odd.name    = "lp64x";
    odd.arch_id = isa.ARCH_RISCV64;
    if (tuple_capability(opt_os.some, opt_rv.some, ?odd, opt_of.some) != TUPLE_OS_ABI) { ret 13; }
    if (!str_equals(tuple_capability_message(TUPLE_OS_ABI, opt_os.some, opt_rv.some, ?odd, opt_of.some),
        "operating system 'linux' accepts calling conventions 'lp64d', 'lp64', 'lp64f' on instruction set 'riscv64', not 'lp64x'")) { ret 14; }
    ret 0;
}

test "mach.lang.target.tuple_capability_catalog:complete_unique_ordered" {
    if (TUPLE_CAPABILITIES[0].code != TUPLE_OK)              { ret 1; }
    if (TUPLE_CAPABILITIES[1].code != TUPLE_NO_CODEGEN)      { ret 1; }
    if (TUPLE_CAPABILITIES[2].code != TUPLE_ABI_MISMATCH)    { ret 1; }
    if (TUPLE_CAPABILITIES[3].code != TUPLE_OS_NO_OF)        { ret 1; }
    if (TUPLE_CAPABILITIES[4].code != TUPLE_OF_UNCOVERED)    { ret 1; }
    if (TUPLE_CAPABILITIES[5].code != TUPLE_OF_SHAPE)        { ret 1; }
    if (TUPLE_CAPABILITIES[6].code != TUPLE_OS_NO_ISA)       { ret 1; }
    if (TUPLE_CAPABILITIES[7].code != TUPLE_ABI_NEEDS_FLOAT) { ret 1; }
    if (TUPLE_CAPABILITIES[8].code != TUPLE_ABI_TRANSPORT)   { ret 1; }
    if (TUPLE_CAPABILITIES[9].code != TUPLE_OS_ABI)          { ret 1; }

    var i: usize = 0;
    for (i < TUPLE_CAPABILITY_N) {
        var j: usize = 0;
        for (j < TUPLE_CAPABILITY_N) {
            if (i != j) {
                if (TUPLE_CAPABILITIES[i].code == TUPLE_CAPABILITIES[j].code)             { ret 1; }
                if (str_equals(TUPLE_CAPABILITIES[i].label, TUPLE_CAPABILITIES[j].label)) { ret 1; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

val DIM_ISA:   u32 = 0;
val DIM_OS:    u32 = 1;
val DIM_ABI:   u32 = 2;
val DIM_OF:    u32 = 3;
val DIM_DEBUG: u32 = 4;

fun buf_put(buf: *u8, cap: usize, off: usize, s: str) usize {
    var i: usize = 0;
    val n: usize = str_len(s);
    var o: usize = off;
    for (i < n && o < cap - 1) {
        buf[o] = s[i];
        o      = o + 1;
        i      = i + 1;
    }
    ret o;
}

fun registered_names(reg: *TargetRegistry, dim: u32, buf: *u8, cap: usize) str {
    var count: u32 = 0;
    if (dim == DIM_ISA)   { count = isa.registered_count(?reg.isa); }
    or (dim == DIM_OS)    { count = os.registered_count(?reg.os); }
    or (dim == DIM_ABI)   { count = abi.registered_count(?reg.abi); }
    or (dim == DIM_DEBUG) { count = of.debug_registered_count(?reg.debug); }
    or                    { count = of.registered_count(?reg.of); }

    var off: usize = 0;
    var i:   u32   = 0;
    for (i < count) {
        var nm: str = "";
        if (dim == DIM_ISA) {
            val e: opt[*isa.IsaVTable] = isa.registered(?reg.isa, i);
            if (sel e.some) { nm = e.some.name; }
        }
        or (dim == DIM_OS) {
            val e: opt[*os.OsVTable] = os.registered(?reg.os, i);
            if (sel e.some) { nm = e.some.name; }
        }
        or (dim == DIM_ABI) {
            val e: opt[*abi.AbiVTable] = abi.registered(?reg.abi, i);
            if (sel e.some) { nm = e.some.name; }
        }
        or (dim == DIM_DEBUG) {
            val e: opt[*of.DebugVTable] = of.debug_registered(?reg.debug, i);
            if (sel e.some) { nm = e.some.name; }
        }
        or {
            val e: opt[*of.OfVTable] = of.registered(?reg.of, i);
            if (sel e.some) { nm = e.some.name; }
        }
        if (i > 0) { off = buf_put(buf, cap, off, ", "); }
        off = buf_put(buf, cap, off, nm);
        i   = i + 1;
    }
    if (off >= cap) { off = cap - 1; }
    buf[off] = 0;
    ret buf::str;
}

fun no_fs_policy_message(os_vt: *os.OsVTable, arch_vt: *isa.IsaVTable) str {
    var alloc:        A.Allocator;
    val r_959:        err[A.Error] = page.make(?alloc);
    val alloc_failed: bool         = sel r_959.err;
    val fb:           str          = "no file-system policy declared for the requested target";
    if (alloc_failed) { ret fb; }
    val r: res[str, string.StrError] = str_join(?alloc, "no file-system policy declared for '", arch_vt.name, "-", os_vt.name, "'");
    if (sel r.err) { ret fb; }
    ret r.ok;
}

fun resolve_environment(arch_vt: *isa.IsaVTable, req: *TargetRequest) res[u32, fail.Fail] {
    if (str_empty(req.env_name)) { ret res[u32, fail.Fail].ok{isa.ENV_NONE}; }
    var label: str = req.label;
    if (str_empty(label)) { label = req.isa_name; }
    if (arch_vt.env_count == 0) {
        ret res[u32, fail.Fail].err{fail.message(environment_message(label, req.env_name, arch_vt, "defines no environments; remove `env`"))};
    }
    val id: u32 = isa.environment_lookup(arch_vt, req.env_name);
    if (id == isa.ENV_NONE) {
        ret res[u32, fail.Fail].err{fail.message(environment_message(label, req.env_name, arch_vt, "does not define it"))};
    }
    ret res[u32, fail.Fail].ok{id};
}

fun environment_message(label: str, env: str, arch_vt: *isa.IsaVTable, why: str) str {
    var alloc: A.Allocator;
    val r_983: err[A.Error] = page.make(?alloc);
    if (sel r_983.err) { ret "mach.toml: `env` names an environment the target's isa does not define"; }
    var known: str = "";
    var i:     u32 = 0;
    for (i < arch_vt.env_count) {
        val piece: res[str, format.FormatError] = format.sprint(?alloc, "{}{}{}", known, arch_vt.envs[i].name, ", ");
        if (sel piece.ok) { known = piece.ok; }
        i = i + 1;
    }
    if (arch_vt.env_count == 0) { known = "none, "; }
    val r: res[str, format.FormatError] = format.sprint(?alloc, "mach.toml: [target.{}] env = \"{}\": isa '{}' {} (known: {})", label, env, arch_vt.name, why, known);
    if (sel r.err) { ret "mach.toml: `env` names an environment the target's isa does not define"; }
    val msg: str   = r.ok;
    val n:   usize = str_len(msg);
    if (n >= 3) {
        msg[n - 3] = ')'::u8;
        msg[n - 2] = 0;
    }
    ret msg;
}

# a refused RISC-V selection names the token it stumbled on and the whole string
fun selection_message(why: str, name: str, bad: *rvfeatures.Span) str {
    var alloc:  A.Allocator;
    val r_1003: err[A.Error] = page.make(?alloc);
    if (sel r_1003.err) { ret why; }
    if (bad.len == 0) {
        val whole: res[str, string.StrError] = str_join(?alloc, why, ": selection '", name, "'");
        if (sel whole.err) { ret why; }
        ret whole.ok;
    }
    val rt: res[*char, A.Error] = A.allocate[char](?alloc, bad.len + 1);
    if (sel rt.err) { ret why; }
    val tok: *char = rt.ok;
    var i:   usize = 0;
    for (i < bad.len) {
        tok[i] = name[bad.at + i];
        i      = i + 1;
    }
    tok[bad.len] = 0;
    val r: res[str, string.StrError] = str_join(?alloc, why, ": '", tok::str, "' in selection '", name, "'");
    if (sel r.err) { ret why; }
    ret r.ok;
}

fun unregistered_message(noun: str, name: str, names: str) str {
    var alloc:        A.Allocator;
    val r_1022:       err[A.Error] = page.make(?alloc);
    val alloc_failed: bool         = sel r_1022.err;
    val fb:           str          = "no implementation registered for the requested target name";
    if (alloc_failed) { ret fb; }
    val r: res[str, string.StrError] = str_join(?alloc, "no ", noun, " implementation registered for '", name, "' (registered: ", names, ")");
    if (sel r.err) { ret fb; }
    ret r.ok;
}

test "mach.lang.target:registry_enumeration_agrees_with_lookup" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel res_reg.err) { ret 1; }

    if (isa.registered_count(?reg.isa) < 2) { ret 1; }
    if (os.registered_count(?reg.os) < 3)   { ret 1; }
    if (abi.registered_count(?reg.abi) < 2) { ret 1; }
    if (of.registered_count(?reg.of) < 3)   { ret 1; }

    var i:       u32 = 0;
    val isa_len: u32 = isa.registered_count(?reg.isa);
    for (i < isa_len) {
        val opt_vt: opt[*isa.IsaVTable] = isa.registered(?reg.isa, i);
        if (!sel opt_vt.some) { ret 1; }
        val r_1046: opt[*isa.IsaVTable] = isa.lookup(?reg.isa, opt_vt.some.name);
        if (!sel r_1046.some) { ret 1; }
        i = i + 1;
    }
    val r_1049: opt[*isa.IsaVTable] = isa.registered(?reg.isa, isa_len);
    if (sel r_1049.some) { ret 1; }

    ret 0;
}

test "mach.lang.target:elf_capable_isa_declares_a_reloc_seam" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_1057: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1057.err) { ret 1; }

    val len: u32 = isa.registered_count(?reg.isa);
    if (len == 0) { ret 1; }

    var unpaired: u32 = 0;
    var seams:    u32 = 0;
    var i:        u32 = 0;
    for (i < len) {
        val vt_r: opt[*isa.IsaVTable] = isa.registered(?reg.isa, i);
        if (sel vt_r.none) { ret 1; }
        val vt: *isa.IsaVTable = vt_r.some;

        if (vt.elf_machine != 0) {
            if (!isa.emits_relocations(vt))     { unpaired = unpaired + 1; }
            or (vt.reloc.apply == nil)          { unpaired = unpaired + 1; }
            or (vt.reloc.traits == nil)         { unpaired = unpaired + 1; }
            or (!vt.reloc.has_elf)              { unpaired = unpaired + 1; }
            or (vt.reloc.elf.reloc_type == nil) { unpaired = unpaired + 1; }
        }

        if (isa.emits_whole_module(vt) && isa.emits_relocations(vt)) { unpaired = unpaired + 1; }

        if (isa.emits_relocations(vt)) { seams = seams + 1; }
        i = i + 1;
    }

    if (unpaired != 0) { ret unpaired::i32; }

    if (seams != 4) { ret 1; }
    ret 0;
}

test "mach.lang.target.tuple_capability:refuses_abi_needing_absent_float_extension" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel res_reg.err) { ret 1; }

    val opt_isa: opt[*isa.IsaVTable] = isa.lookup(?reg.isa, "riscv64");
    if (!sel opt_isa.some) { ret 1; }
    val isa_vt: *isa.IsaVTable = opt_isa.some;
    if (isa_vt.model.flen_bits != 64) { ret 1; }

    var quad: abi.AbiVTable = abi.abi_vtable(
        abi.ABI_UNKNOWN, "lp64q", isa.ARCH_RISCV64,
        nil, nil, nil, nil,
        16, 0, 0,
        -1, false,
        false, false,
        128, 8,
        nil);
    if (tuple_capability(nil, isa_vt, ?quad, nil) != TUPLE_ABI_NEEDS_FLOAT) { ret 1; }

    val opt_abi: opt[*abi.AbiVTable] = abi.lookup(?reg.abi, "lp64d");
    if (!sel opt_abi.some) { ret 1; }
    val d_vt: *abi.AbiVTable = opt_abi.some;
    if (d_vt.float_arg_bits != 64) { ret 1; }
    val ok: res[resolved.Target, fail.Fail] = select(?reg, "riscv64", "linux", "lp64d");
    if (sel ok.err) { ret 1; }
    val soft: res[resolved.Target, fail.Fail] = select(?reg, "riscv64", "linux", "lp64");
    if (sel soft.err) { ret 1; }
    ret 0;
}

test "mach.lang.target.tuple_capability:refuses_a_standard_abi_a_narrower_isa_model_cannot_give" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel res_reg.err) { ret 1; }

    val opt_isa: opt[*isa.IsaVTable] = isa.lookup(?reg.isa, "riscv64");
    if (!sel opt_isa.some) { ret 1; }
    val real_isa: *isa.IsaVTable = opt_isa.some;

    val opt_abi: opt[*abi.AbiVTable] = abi.lookup(?reg.abi, "lp64d");
    if (!sel opt_abi.some) { ret 1; }
    val d_vt: *abi.AbiVTable = opt_abi.some;
    if (d_vt.float_arg_bits != 64) { ret 1; }

    var narrow: isa.IsaVTable = @real_isa;
    narrow.model.flen_bits = 0;
    if (tuple_capability(nil, ?narrow, d_vt, nil) != TUPLE_ABI_NEEDS_FLOAT) { ret 1; }

    var mid: isa.IsaVTable = @real_isa;
    mid.model.flen_bits = 32;
    if (tuple_capability(nil, ?mid, d_vt, nil) != TUPLE_ABI_NEEDS_FLOAT) { ret 1; }
    ret 0;
}

test "mach.lang.target.tuple_capability:refuses_an_isa_with_no_registered_code_generator" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel res_reg.err) { ret 1; }

    val opt_isa: opt[*isa.IsaVTable] = isa.lookup(?reg.isa, "riscv64");
    if (!sel opt_isa.some) { ret 1; }
    val real_isa: *isa.IsaVTable = opt_isa.some;
    if (!isa.has_codegen(real_isa)) { ret 1; }

    var stub: isa.IsaVTable = @real_isa;
    stub.machine = nil;
    stub.emitter = nil;
    if (isa.has_codegen(?stub)) { ret 1; }

    if (tuple_capability(nil, ?stub, nil, nil) != TUPLE_NO_CODEGEN) { ret 1; }
    ret 0;
}

test "mach.lang.target.tuple_capability:refuses_an_isa_the_operating_system_does_not_run" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel res_reg.err) { ret 1; }

    val opt_isa: opt[*isa.IsaVTable] = isa.lookup(?reg.isa, "riscv64");
    if (!sel opt_isa.some) { ret 1; }
    val riscv_vt: *isa.IsaVTable = opt_isa.some;

    val opt_abi: opt[*abi.AbiVTable] = abi.lookup(?reg.abi, "lp64d");
    if (!sel opt_abi.some) { ret 1; }
    val d_vt: *abi.AbiVTable = opt_abi.some;

    val opt_os: opt[*os.OsVTable] = os.lookup(?reg.os, "windows");
    if (!sel opt_os.some) { ret 1; }
    val win_vt: *os.OsVTable = opt_os.some;
    if (os.supports_isa(win_vt, isa.ARCH_RISCV64)) { ret 1; }

    if (tuple_capability(win_vt, riscv_vt, d_vt, nil) != TUPLE_OS_NO_ISA) { ret 1; }
    ret 0;
}

test "mach.lang.target.select:linux_aarch64" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel res_reg.err) { ret 1; }

    if (abi.registered_count(?reg.abi) != 10) { ret 1; }

    val res_target: res[resolved.Target, fail.Fail] = select(?reg, "aarch64", "linux", "aapcs64");
    if (sel res_target.err) { ret 1; }
    val t: resolved.Target = res_target.ok;

    if (t.arch == nil)                { ret 1; }
    if (t.isa.id != isa.ARCH_AARCH64) { ret 1; }
    if (t.arch.select == nil)         { ret 1; }
    if (t.arch.encode == nil)         { ret 1; }

    if (t.abi == nil)                { ret 1; }
    if (t.abi.id != abi.ABI_AAPCS64) { ret 1; }
    if (t.abi.arg_passing == nil)    { ret 1; }
    if (t.abi.ret_passing == nil)    { ret 1; }

    ret 0;
}

test "mach.lang.target.select:fs_policy_is_per_tuple_not_shared_across_linux_architectures" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel res_reg.err) { ret 1; }

    val res_x64: res[resolved.Target, fail.Fail] = select(?reg, "x86_64", "linux", "sysv64");
    if (sel res_x64.err) { ret 1; }
    val tx64: resolved.Target = res_x64.ok;

    val res_a64: res[resolved.Target, fail.Fail] = select(?reg, "aarch64", "linux", "aapcs64");
    if (sel res_a64.err) { ret 1; }
    val ta64: resolved.Target = res_a64.ok;

    val res_r64: res[resolved.Target, fail.Fail] = select(?reg, "riscv64", "linux", "lp64d");
    if (sel res_r64.err) { ret 1; }
    val tr64: resolved.Target = res_r64.ok;

    var bad: bool = false;
    if (!str_equals(tx64.fs_policy.dynamic_interpreter, "/lib64/ld-linux-x86-64.so.2"))      { bad = true; }
    if (!str_equals(ta64.fs_policy.dynamic_interpreter, "/lib/ld-linux-aarch64.so.1"))       { bad = true; }
    if (!str_equals(tr64.fs_policy.dynamic_interpreter, "/lib/ld-linux-riscv64-lp64d.so.1")) { bad = true; }

    if (str_equals(tx64.fs_policy.dynamic_interpreter, ta64.fs_policy.dynamic_interpreter)) { bad = true; }
    if (str_equals(tx64.fs_policy.dynamic_interpreter, tr64.fs_policy.dynamic_interpreter)) { bad = true; }
    if (str_equals(ta64.fs_policy.dynamic_interpreter, tr64.fs_policy.dynamic_interpreter)) { bad = true; }

    if (!str_equals(tx64.fs_policy.libdirs[2], "/lib/x86_64-linux-gnu"))  { bad = true; }
    if (!str_equals(ta64.fs_policy.libdirs[0], "/lib/aarch64-linux-gnu")) { bad = true; }
    if (!str_equals(tr64.fs_policy.libdirs[0], "/lib/riscv64-linux-gnu")) { bad = true; }

    var li: u32 = 0;
    for (li < ta64.fs_policy.libdir_len) {
        if (str_equals(ta64.fs_policy.libdirs[li], "/lib/x86_64-linux-gnu")
            || str_equals(ta64.fs_policy.libdirs[li], "/usr/lib/x86_64-linux-gnu")
            || str_equals(ta64.fs_policy.libdirs[li], "/lib64")
            || str_equals(ta64.fs_policy.libdirs[li], "/usr/lib64")) { bad = true; }
        li = li + 1;
    }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.select:darwin_and_windows_and_freestanding_declare_no_dynamic_interpreter" {
