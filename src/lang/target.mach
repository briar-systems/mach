# what a target builds: the host the compiler names, mink's products and linkages, the
# name an artifact's file takes and what the target's object format holds
#
# a target is resolved through mink's catalog and masc's check (mach.lang.target.resolved),
# and every fact read here is read from that resolution's rows
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use A: std.allocator;

use mink_fail:      mink.base.fail;
use catalog_format: mink.catalog.format;
use mink_kind:      mink.catalog.kind;
use mink_os:        mink.catalog.os;
use mink_output:    mink.catalog.output;
use mink.catalog.output.linkage.Linkage;
use mink_product: mink.catalog.output.product;
use mink.catalog.output.product.Product;
use mink_target: mink.catalog.target;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.target.resolved;

# the architecture the compiler itself was built for, as its manifest names it
pub fun host_arch_name() str {
    ret $project.target.arch;
}

# the system the compiler itself was built for, as its manifest names it
pub fun host_sys_name() str {
    ret $project.target.sys;
}

# the calling convention the compiler itself was built for, as its manifest names it
pub fun host_abi_name() str {
    ret $project.target.abi;
}

# the target a `native` selection resolves: the host's architecture, system and convention
# as the compiler's own manifest names them, every other part mink's default
pub fun host(a: *A.Allocator) res[resolved.Target, fail.Fail] {
    val spec: res[mink_target.Spec, mink_target.Refusal] = resolved.spec_of(host_sys_name(), host_arch_name());
    if (sel spec.err) {
        var r: mink_target.Refusal = spec.err;
        ret res[resolved.Target, fail.Fail].err{resolved.refused(a, diagnostic_kind.TARGET_UNSUPPORTED, ?r)};
    }
    var n: mink_target.Narrowing = mink_target.UNNARROWED;
    n.abi = host_abi_name();
    val t: res[resolved.Target, resolved.Refused] = resolved.resolve(a, spec.ok, ?n, resolved.Image{base: 0, stack_reserve: 0, stack_commit: 0});
    if (sel t.err) { ret res[resolved.Target, fail.Fail].err{t.err.why}; }
    ret res[resolved.Target, fail.Fail].ok{t.ok};
}

# the naming of an artifact's file, as mink's system names a file of its kind:
# prefix, then the artifact's name, then the extension
# ---
# prefix: written before its name
# suffix: written after its name, with its dot
pub rec ArtifactName {
    prefix: str;
    suffix: str;
}

# the linkage of an executable built for `t`: the one its narrowing names, else the host's
# default. refused in mink's words, as a user failure of `kind`, where the host runs none
pub fun linkage_of(a: *A.Allocator, t: *resolved.Target, kind: diagnostic_kind.Kind) res[*Linkage, fail.Fail] {
    if (!resolved.is_selected(t)) { ret res[*Linkage, fail.Fail].err{fail.message("linkage: no target is selected")}; }
    val l: res[*Linkage, mink_target.Refusal] = mink_target.executable(?t.target);
    if (sel l.err) {
        var r: mink_target.Refusal = l.err;
        ret res[*Linkage, fail.Fail].err{resolved.refused(a, kind, ?r)};
    }
    ret res[*Linkage, fail.Fail].ok{l.ok};
}

# whether `p` is a library, which a consumer links against rather than runs: an archive, or an
# image of a kind of file a link binds against
pub fun is_library(p: *Product) bool {
    val m: mink_product.Makes = p.makes;
    if (sel m.archive) { ret true; }
    if (sel m.image)   { ret mink_kind.has(m.image.reads_as, mink_kind.BINDS); }
    ret false;
}

# whether `p` is each module's object, written under the obj directory for a later link, so an
# artifact of it delivers no one file at an `out` path
pub fun per_module(p: *Product) bool {
    ret p == ?mink_product.OBJECT;
}

# whether `p` is linked as an executable, of the image kind its linkage names
pub fun is_executable(p: *Product) bool {
    val m: mink_product.Makes = p.makes;
    ret sel m.linked;
}

# the image kind mink builds for a product: an executable's from its linkage, an image product's
# its own. none for a static library, which mink archives rather than links
pub fun output_of(p: *Product, linkage: *Linkage) opt[*mink_output.Kind] {
    val m: mink_product.Makes = p.makes;
    if (sel m.linked) { ret opt[*mink_output.Kind].some{linkage.kind}; }
    if (sel m.image)  { ret opt[*mink_output.Kind].some{m.image}; }
    ret opt[*mink_output.Kind].none{};
}

# the image kind of the executable a build for `t` links, refused where the host runs no
# executable
pub fun executable_output(a: *A.Allocator, t: *resolved.Target) res[*mink_output.Kind, fail.Fail] {
    val l: res[*Linkage, fail.Fail] = linkage_of(a, t, diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED);
    if (sel l.err) { ret res[*mink_output.Kind, fail.Fail].err{l.err}; }
    ret res[*mink_output.Kind, fail.Fail].ok{l.ok.kind};
}

# the name an artifact of product `p` takes on the target, mink's system's name of the file:
# an archive for a static library, and for every other product the kind of file its image
# reads back as, an executable's under the linkage the target resolved to. refused, with
# mink's reason, where the system builds none
pub fun artifact_naming(a: *A.Allocator, t: *resolved.Target, p: *Product) res[ArtifactName, fail.Fail] {
    if (!resolved.is_selected(t)) { ret res[ArtifactName, fail.Fail].err{fail.message("artifact naming: no target is selected")}; }
    var linkage: *Linkage = nil;
    if (is_executable(p)) {
        val l: res[*Linkage, fail.Fail] = linkage_of(a, t, diagnostic_kind.ARTIFACT_KIND_UNSUPPORTED);
        if (sel l.err) { ret res[ArtifactName, fail.Fail].err{l.err}; }
        linkage = l.ok;
    }
    var file: *mink_kind.Kind        = ?mink_kind.ARCHIVE;
    val out:  opt[*mink_output.Kind] = output_of(p, linkage);
    if (sel out.some) { file = out.some.reads_as; }
    val named: res[*mink_os.Filename, mink_fail.Fail] = mink_os.filename(t.target.sys, file);
    if (sel named.err) {
        val why: mink_fail.Fail = named.err;
        if (why.cite == nil) {
            ret res[ArtifactName, fail.Fail].err{fail.formatted(a, "artifact naming: mink's system `{}` names no {} file: {}", t.target.sys.name, file.name, why.text)};
        }
        ret res[ArtifactName, fail.Fail].err{fail.formatted(a, "artifact naming: mink's system `{}` names no {} file: {} ({})", t.target.sys.name, file.name, why.text, why.cite)};
    }
    ret res[ArtifactName, fail.Fail].ok{ArtifactName{prefix: named.ok.prefix, suffix: named.ok.extension}};
}

# whether the target's object format holds each module as its own artifact, as a
# SPIR-V module: mink builds a module of the format and no executable of it
pub fun finished_modules(t: *resolved.Target) bool {
    val f: *catalog_format.Format = t.target.format;
    if (f == nil) { ret false; }
    ret mink_output.builds(?mink_output.MODULE, f) && !mink_output.builds(?mink_output.STATIC, f);
}

# whether the target's object format is a flat image, mink's flat format
pub fun flat_image(t: *resolved.Target) bool {
    ret t.target.format != nil && t.target.format == ?catalog_format.FLAT;
}

# whether the target's images state a subsystem, as mink's host of it names a
# default one, so an artifact's `subsystem`, icon and manifest mean something
pub fun states_subsystem(t: *resolved.Target) bool {
    ret t.target.host != nil && sel t.target.host.subsystem.some;
}

# whether a module's object is read again by a link or the cache, so it carries
# mach's record section: every object but a flat image's and a finished module's
pub fun carries_record(t: *resolved.Target) bool {
    ret t.target.format != nil && !flat_image(t) && !finished_modules(t);
}
