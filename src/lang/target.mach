}

test "mach.lang.target.abi_vtable:granularity_matches_its_classifier" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }

    var i: u32 = 0;
    for (i < reg.abi.count) {
        val vt: *abi.AbiVTable = ?reg.abi.entries[i];
        if (vt.arg_slot_granularity == 0) { ret 1; }
        if (vt.arg_passing == nil)        { i = i + 1; cnt; }

        val fn: abi.ArgPassingFn = vt.arg_passing;
        var agg: abi.AggLayout;
        agg.field_count = 0;
        val slot: abi.ParamSlot = fn(0, 16, 8, false, 0, true, false, 0, 0, 0, 0, agg);
        if (slot.piece_count == 2 && slot.pieces[1].kind == abi.PIECE_GP) {
            if (slot.pieces[1].src_off != vt.arg_slot_granularity::i64) { ret 1; }
        }
        i = i + 1;
    }
    ret 0;
}



test "mach.lang.target.resolve:bakes_image_overrides_into_construction" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }

    var req: TargetRequest = target_request("x86_64", "freestanding", "sysv64");
    with_image(?req, 0x400000, 0x100000, 0x1000);
    val r: R.Result[resolved.Target, str] = resolve(?reg, ?req);
    if (R.is_err[resolved.Target, str](r)) { ret 1; }
    val t: resolved.Target = R.unwrap_ok[resolved.Target, str](r);
    if (t.base != 0x400000)          { ret 1; }
    if (t.stack_reserve != 0x100000) { ret 1; }
    if (t.stack_commit  != 0x1000)   { ret 1; }

    var req2: TargetRequest = target_request("x86_64", "freestanding", "sysv64");
    val r2: R.Result[resolved.Target, str] = resolve(?reg, ?req2);
    if (R.is_err[resolved.Target, str](r2)) { ret 1; }
    val t2: resolved.Target = R.unwrap_ok[resolved.Target, str](r2);
    if (t2.base != 0)          { ret 1; }
    if (t2.stack_reserve != 0) { ret 1; }
    if (t2.stack_commit  != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.select_of:is_a_zero_image_request_to_resolve" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }

    val a: R.Result[resolved.Target, str] = select_of(?reg, "x86_64", "linux", "sysv64", "elf");
    if (R.is_err[resolved.Target, str](a)) { ret 1; }
    val ta: resolved.Target = R.unwrap_ok[resolved.Target, str](a);

    var req: TargetRequest = target_request("x86_64", "linux", "sysv64");
    with_of(?req, "elf");
    val b: R.Result[resolved.Target, str] = resolve(?reg, ?req);
    if (R.is_err[resolved.Target, str](b)) { ret 1; }
    val tb: resolved.Target = R.unwrap_ok[resolved.Target, str](b);

    if (ta.isa != tb.isa) { ret 1; }
    if (ta.abi != tb.abi) { ret 1; }
    if (ta.of  != tb.of)  { ret 1; }
    if (ta.base != tb.base || ta.base != 0) { ret 1; }
    ret 0;
}

fun fp_bytes_equal(a: *binary.Encoder, b: *binary.Encoder) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.target.fingerprint:stable_across_two_encodings_of_the_same_target" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }

    val ra: R.Result[resolved.Target, str] = select_of(?reg, "x86_64", "linux", "sysv64", "elf");
    val rb: R.Result[resolved.Target, str] = select_of(?reg, "x86_64", "linux", "sysv64", "elf");
    if (R.is_err[resolved.Target, str](ra) || R.is_err[resolved.Target, str](rb)) { ret 1; }
    var ta: resolved.Target = R.unwrap_ok[resolved.Target, str](ra);
    var tb: resolved.Target = R.unwrap_ok[resolved.Target, str](rb);

    var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint(?ta, ?ea)) { ret 1; }
    if (!fingerprint(?tb, ?eb)) { ret 1; }
    if (!fp_bytes_equal(?ea, ?eb)) { ret 1; }
    if (ea.len == 0) { ret 1; }

    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);
    ret 0;
}

test "mach.lang.target.fingerprint:sensitive_to_arch_abi_os_of_debug_backend_and_image" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }

    val base: R.Result[resolved.Target, str] = select_of(?reg, "x86_64", "linux", "sysv64", "elf");
    if (R.is_err[resolved.Target, str](base)) { ret 1; }
    var tbase: resolved.Target = R.unwrap_ok[resolved.Target, str](base);
    var ebase: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint(?tbase, ?ebase)) { ret 1; }

    var td_page: resolved.Target = tbase;
    td_page.page_size = tbase.page_size * 2;
    var e_page: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint(?td_page, ?e_page)) { ret 1; }
    if (fp_bytes_equal(?ebase, ?e_page)) { ret 1; }

    val diff_arch: R.Result[resolved.Target, str] = select_of(?reg, "aarch64", "linux", "aapcs64", "elf");
    if (R.is_err[resolved.Target, str](diff_arch)) { ret 1; }
    var td_arch: resolved.Target = R.unwrap_ok[resolved.Target, str](diff_arch);
    var e_arch: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint(?td_arch, ?e_arch)) { ret 1; }
    if (fp_bytes_equal(?ebase, ?e_arch)) { ret 1; }

    val diff_of: R.Result[resolved.Target, str] = select_of(?reg, "x86_64", "freestanding", "sysv64", "raw");
    val same_of: R.Result[resolved.Target, str] = select_of(?reg, "x86_64", "freestanding", "sysv64", "elf");
    if (R.is_err[resolved.Target, str](diff_of) || R.is_err[resolved.Target, str](same_of)) { ret 1; }
    var td_of: resolved.Target = R.unwrap_ok[resolved.Target, str](diff_of);
    var ts_of: resolved.Target = R.unwrap_ok[resolved.Target, str](same_of);
    var e_of_raw: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var e_of_elf: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint(?td_of, ?e_of_raw)) { ret 1; }
    if (!fingerprint(?ts_of, ?e_of_elf)) { ret 1; }
    if (fp_bytes_equal(?e_of_raw, ?e_of_elf)) { ret 1; }

    val diff_os: R.Result[resolved.Target, str] = select_of(?reg, "x86_64", "darwin", "sysv64", "");
    if (R.is_err[resolved.Target, str](diff_os)) { ret 1; }
    var td_os: resolved.Target = R.unwrap_ok[resolved.Target, str](diff_os);
    var e_os: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint(?td_os, ?e_os)) { ret 1; }
    if (fp_bytes_equal(?ebase, ?e_os)) { ret 1; }

    val diff_backend: R.Result[resolved.Target, str] = select_of(?reg, "spirv", "freestanding", "spirv", "spv");
    if (R.is_err[resolved.Target, str](diff_backend)) { ret 1; }
    var td_backend: resolved.Target = R.unwrap_ok[resolved.Target, str](diff_backend);
    var e_backend: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint(?td_backend, ?e_backend)) { ret 1; }
    if (fp_bytes_equal(?ebase, ?e_backend)) { ret 1; }

    var req_a: TargetRequest = target_request("x86_64", "freestanding", "sysv64");
    with_image(?req_a, 0x400000, 0, 0);
    var req_b: TargetRequest = target_request("x86_64", "freestanding", "sysv64");
    with_image(?req_b, 0x500000, 0, 0);
    val ria: R.Result[resolved.Target, str] = resolve(?reg, ?req_a);
    val rib: R.Result[resolved.Target, str] = resolve(?reg, ?req_b);
    if (R.is_err[resolved.Target, str](ria) || R.is_err[resolved.Target, str](rib)) { ret 1; }
    var tia: resolved.Target = R.unwrap_ok[resolved.Target, str](ria);
    var tib: resolved.Target = R.unwrap_ok[resolved.Target, str](rib);
    var e_ia: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var e_ib: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint(?tia, ?e_ia)) { ret 1; }
    if (!fingerprint(?tib, ?e_ib)) { ret 1; }
    if (fp_bytes_equal(?e_ia, ?e_ib)) { ret 1; }

    binary.encoder_dnit(?ebase);
    binary.encoder_dnit(?e_page);
    binary.encoder_dnit(?e_arch);
    binary.encoder_dnit(?e_of_raw);
    binary.encoder_dnit(?e_of_elf);
    binary.encoder_dnit(?e_os);
    binary.encoder_dnit(?e_backend);
    binary.encoder_dnit(?e_ia);
    binary.encoder_dnit(?e_ib);
    ret 0;
}

test "mach.lang.target.fingerprint_model:sensitive_to_every_declared_field" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var base: isa.MachineModel;
    base.pointer_width = 8; base.gpr_width = 8; base.max_alu_width = 8;
    base.alu_min_width = 4; base.spill_width = 8; base.endianness = isa.ENDIAN_LITTLE;
    base.reg_class_len = 0; base.frame_ptr_reg = 6; base.stack_ptr_reg = 7;
    base.reserved_len = 0; base.div_reg = -1; base.div_hi_reg = -1; base.shift_count_reg = -1;
    base.incoming_arg_base = 16; base.stack_align = 16; base.red_zone = 128; base.shadow_space = 0;
    base.has_v128 = true; base.vector_bits = 128; base.max_vector_lanes = isa.VECTOR_LANES_UNBOUNDED;
    base.vector_compute_generic = false; base.has_lane_ops = true; base.has_vec_build = true;
    base.vec_mem_widths = isa.VEC_MEM_ALL_128; base.xbank_widths = isa.XBANK_4_8;
    base.ct_trust_mul = true; base.has_var_shift = true; base.has_mul = true; base.has_float = true;
    base.mul_hi_width = 8; base.flat_addressing = false; base.ct_trust_var_shift = true;
    base.packed_gap_len = 0; base.flen_bits = 64;

    val eb0: binary.Encoder = fp_encode_model(?alloc, ?base);
    if (eb0.len == 0) { ret 1; }

    var m: isa.MachineModel = base; m.pointer_width      = 4; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.gpr_width          = 4; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.max_alu_width      = 4; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.alu_min_width      = 1; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.spill_width        = 4; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.endianness         = isa.ENDIAN_BIG; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.frame_ptr_reg      = 5; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.stack_ptr_reg      = 4; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.div_reg            = 0; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.div_hi_reg         = 0; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.shift_count_reg    = 0; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.incoming_arg_base  = 0; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.stack_align        = 8; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.red_zone           = 0; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.shadow_space       = 32; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.has_v128           = false; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.vector_bits        = 256; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.max_vector_lanes   = 4; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.vector_compute_generic = true; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.has_lane_ops       = false; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.has_vec_build      = false; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.vec_mem_widths     = isa.VEC_MEM_NONE; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.xbank_widths       = isa.XBANK_NONE; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.ct_trust_mul       = false; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.has_var_shift      = false; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.has_mul            = false; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.has_float          = false; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.mul_hi_width       = 4; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.flat_addressing    = true; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.ct_trust_var_shift = false; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m = base; m.flen_bits          = 32; if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }

    var rc: [1]isa.RegClass;
    rc[0].name = "gpr"; rc[0].kind = isa.RC_GENERAL; rc[0].len = 16;
    m = base; m.reg_class_len = 1; m.reg_classes = ?rc[0];
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    var rc2: [1]isa.RegClass;
    rc2[0].name = "gpr"; rc2[0].kind = isa.RC_GENERAL; rc2[0].len = 8;
    var m2: isa.MachineModel = base; m2.reg_class_len = 1; m2.reg_classes = ?rc2[0];
    if (fp_model_equal_pair(?alloc, ?m, ?m2)) { ret 1; }

    var rr: [1]isa.Register;
    rr[0].id = 0; rr[0].size = 8;
    m = base; m.reserved_len = 1; m.reserved_regs = ?rr[0];
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }

    var pg: [1]isa.PackedGap;
    pg[0].op = isa.VEC_OP_MUL; pg[0].is_float = false; pg[0].lane_bits = 32;
    m = base; m.packed_gap_len = 1; m.packed_gaps = ?pg[0];
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }

    ret 0;
}

fun fp_encode_model(alloc: *A.Allocator, m: *isa.MachineModel) binary.Encoder {
    var e: binary.Encoder = binary.encoder(alloc, binary.LITTLE);
    val ok: bool = fingerprint_model(m, ?e);
    if (!ok) { panic("fp_encode_model: encoding failed\n"); }
    ret e;
}

fun fp_model_equal(alloc: *A.Allocator, a: *isa.MachineModel, b: *isa.MachineModel) bool {
    ret fp_model_equal_pair(alloc, a, b);
}

fun fp_model_equal_pair(alloc: *A.Allocator, a: *isa.MachineModel, b: *isa.MachineModel) bool {
    var ea: binary.Encoder = fp_encode_model(alloc, a);
    var eb: binary.Encoder = fp_encode_model(alloc, b);
    val eq: bool = fp_bytes_equal(?ea, ?eb);
    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);
    ret eq;
}

test "mach.lang.target.artifact_naming:every_registered_object_format_has_a_total_object_and_executable_row" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }

    var bad: i32 = 0;
    var i: u32 = 0;
    for (i < reg.of.count) {
        val vt: *of.OfVTable = ?reg.of.entries[i];

        val obj_r: R.Result[of.ArtifactName, str] = of.artifact_naming(vt, "linux", of.ARTIFACT_OBJECT);
        if (R.is_err[of.ArtifactName, str](obj_r)) { bad = 1; }
        or {
            val an: of.ArtifactName = R.unwrap_ok[of.ArtifactName, str](obj_r);
            if (str_len(an.suffix) > 0 && an.suffix[0] != '.') { bad = 1; }
        }

        val exe_linux_r: R.Result[of.ArtifactName, str] = of.artifact_naming(vt, "linux", of.ARTIFACT_EXECUTABLE);
        if (R.is_err[of.ArtifactName, str](exe_linux_r)) { bad = 1; }
        val exe_win_r: R.Result[of.ArtifactName, str] = of.artifact_naming(vt, "windows", of.ARTIFACT_EXECUTABLE);
        if (R.is_err[of.ArtifactName, str](exe_win_r)) { bad = 1; }
        or {
            val an: of.ArtifactName = R.unwrap_ok[of.ArtifactName, str](exe_win_r);
            if (!vt.object_is_artifact && !vt.produces_image && !str_equals(an.suffix, ".exe")) { bad = 1; }
        }
        i = i + 1;
    }
    ret bad;
}

test "mach.lang.target.artifact_naming:elf_coff_macho_conventional_names" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }

    var bad: i32 = 0;

    val elf_o: O.Option[*of.OfVTable] = of.lookup(?reg.of, "elf");
    if (O.is_none[*of.OfVTable](elf_o)) { ret 1; }
    val elf_vt: *of.OfVTable = O.unwrap[*of.OfVTable](elf_o);
    val elf_static: of.ArtifactName = R.unwrap_ok[of.ArtifactName, str](of.artifact_naming(elf_vt, "linux", of.ARTIFACT_STATIC_LIB));
    if (!str_equals(elf_static.prefix, "lib") || !str_equals(elf_static.suffix, ".a")) { bad = 1; }
    val elf_shared: of.ArtifactName = R.unwrap_ok[of.ArtifactName, str](of.artifact_naming(elf_vt, "linux", of.ARTIFACT_SHARED_LIB));
    if (!str_equals(elf_shared.prefix, "lib") || !str_equals(elf_shared.suffix, ".so")) { bad = 1; }

    val macho_o: O.Option[*of.OfVTable] = of.lookup(?reg.of, "macho");
    if (O.is_none[*of.OfVTable](macho_o)) { ret 1; }
    val macho_vt: *of.OfVTable = O.unwrap[*of.OfVTable](macho_o);
    val macho_shared: of.ArtifactName = R.unwrap_ok[of.ArtifactName, str](of.artifact_naming(macho_vt, "darwin", of.ARTIFACT_SHARED_LIB));
    if (!str_equals(macho_shared.prefix, "lib") || !str_equals(macho_shared.suffix, ".dylib")) { bad = 1; }

    val coff_o: O.Option[*of.OfVTable] = of.lookup(?reg.of, "coff");
    if (O.is_none[*of.OfVTable](coff_o)) { ret 1; }
    val coff_vt: *of.OfVTable = O.unwrap[*of.OfVTable](coff_o);
    val coff_static_win: of.ArtifactName = R.unwrap_ok[of.ArtifactName, str](of.artifact_naming(coff_vt, "windows", of.ARTIFACT_STATIC_LIB));
    if (!str_empty(coff_static_win.prefix) || !str_equals(coff_static_win.suffix, ".lib")) { bad = 1; }
    val coff_shared: of.ArtifactName = R.unwrap_ok[of.ArtifactName, str](of.artifact_naming(coff_vt, "windows", of.ARTIFACT_SHARED_LIB));
    if (!str_empty(coff_shared.prefix) || !str_equals(coff_shared.suffix, ".dll")) { bad = 1; }
    val coff_exe: of.ArtifactName = R.unwrap_ok[of.ArtifactName, str](of.artifact_naming(coff_vt, "windows", of.ARTIFACT_EXECUTABLE));
    if (!str_equals(coff_exe.suffix, ".exe")) { bad = 1; }

    ret bad;
}

test "mach.lang.target.artifact_naming:flat_image_and_finished_module_formats_refuse_archive_and_shared_forms" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }

    var bad: i32 = 0;

    val raw_o: O.Option[*of.OfVTable] = of.lookup(?reg.of, "raw");
    if (O.is_none[*of.OfVTable](raw_o)) { ret 1; }
    val raw_vt: *of.OfVTable = O.unwrap[*of.OfVTable](raw_o);
    if (R.is_ok[of.ArtifactName, str](of.artifact_naming(raw_vt, "freestanding", of.ARTIFACT_STATIC_LIB))) { bad = 1; }
    if (R.is_ok[of.ArtifactName, str](of.artifact_naming(raw_vt, "freestanding", of.ARTIFACT_SHARED_LIB))) { bad = 1; }
    val raw_exe: of.ArtifactName = R.unwrap_ok[of.ArtifactName, str](of.artifact_naming(raw_vt, "freestanding", of.ARTIFACT_EXECUTABLE));
    if (!str_empty(raw_exe.prefix) || !str_empty(raw_exe.suffix)) { bad = 1; }

    val spv_o: O.Option[*of.OfVTable] = of.lookup(?reg.of, "spv");
    if (O.is_none[*of.OfVTable](spv_o)) { ret 1; }
    val spv_vt: *of.OfVTable = O.unwrap[*of.OfVTable](spv_o);
    if (R.is_ok[of.ArtifactName, str](of.artifact_naming(spv_vt, "freestanding", of.ARTIFACT_STATIC_LIB))) { bad = 1; }
    if (R.is_ok[of.ArtifactName, str](of.artifact_naming(spv_vt, "freestanding", of.ARTIFACT_SHARED_LIB))) { bad = 1; }
    val spv_exe: of.ArtifactName = R.unwrap_ok[of.ArtifactName, str](of.artifact_naming(spv_vt, "freestanding", of.ARTIFACT_EXECUTABLE));
    if (!str_equals(spv_exe.suffix, ".spv")) { bad = 1; }
    val spv_obj: of.ArtifactName = R.unwrap_ok[of.ArtifactName, str](of.artifact_naming(spv_vt, "freestanding", of.ARTIFACT_OBJECT));
    if (!str_equals(spv_obj.suffix, ".spv")) { bad = 1; }

    ret bad;
}

test "mach.lang.target.artifact_naming:compatibility_key_matches_only_the_same_object_format" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }

    val elf_o: O.Option[*of.OfVTable] = of.lookup(?reg.of, "elf");
    val coff_o: O.Option[*of.OfVTable] = of.lookup(?reg.of, "coff");
    if (O.is_none[*of.OfVTable](elf_o) || O.is_none[*of.OfVTable](coff_o)) { ret 1; }
    val elf_vt: *of.OfVTable = O.unwrap[*of.OfVTable](elf_o);
    val coff_vt: *of.OfVTable = O.unwrap[*of.OfVTable](coff_o);

    val a: of.ArtifactName = R.unwrap_ok[of.ArtifactName, str](of.artifact_naming(elf_vt, "linux", of.ARTIFACT_OBJECT));
    val b: of.ArtifactName = R.unwrap_ok[of.ArtifactName, str](of.artifact_naming(elf_vt, "linux", of.ARTIFACT_EXECUTABLE));
    val c: of.ArtifactName = R.unwrap_ok[of.ArtifactName, str](of.artifact_naming(coff_vt, "windows", of.ARTIFACT_OBJECT));

    if (!str_equals(a.key, b.key)) { ret 1; }
    if (str_equals(a.key, c.key)) { ret 1; }
    ret 0;
}

test "mach.lang.target.select_of:every_capable_tuple_is_selectable_and_the_census_is_stable" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }

    var capable:    u32 = 0;
    var selectable: u32 = 0;
    var oi: u32 = 0;
    for (oi < os.registered_count(?reg.os)) {
        val os_vt: *os.OsVTable = O.unwrap[*os.OsVTable](os.registered(?reg.os, oi));
        var ii: u32 = 0;
        for (ii < isa.registered_count(?reg.isa)) {
            val isa_vt: *isa.IsaVTable = O.unwrap[*isa.IsaVTable](isa.registered(?reg.isa, ii));
            var ai: u32 = 0;
            for (ai < abi.registered_count(?reg.abi)) {
                val abi_vt: *abi.AbiVTable = O.unwrap[*abi.AbiVTable](abi.registered(?reg.abi, ai));
                var fi: u32 = 0;
                for (fi < of.registered_count(?reg.of)) {
                    val of_vt: *of.OfVTable = O.unwrap[*of.OfVTable](of.registered(?reg.of, fi));
                    if (tuple_capability(os_vt, isa_vt, abi_vt, of_vt) == TUPLE_OK) {
                        capable = capable + 1;
                        val r: R.Result[resolved.Target, str] = select_of(?reg, isa_vt.name, os_vt.name, abi_vt.name, of_vt.name);
                        if (R.is_ok[resolved.Target, str](r)) { selectable = selectable + 1; }
                    }
                    fi = fi + 1;
                }
                ai = ai + 1;
            }
            ii = ii + 1;
        }
        oi = oi + 1;
    }
    if (capable == 0)          { ret 1; }
    if (selectable != capable) { ret 2; }
    if (capable != COMPLETE_TUPLE_CENSUS) { print.printf("complete-target census: {} capable tuples, expected {}\n", capable, COMPLETE_TUPLE_CENSUS); ret 3; }
    ret 0;
}

test "mach.lang.target.registry:every_isa_declares_its_index_and_vector_axes" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    var ii: u32 = 0;
    for (ii < isa.registered_count(?reg.isa)) {
        val isa_vt: *isa.IsaVTable = O.unwrap[*isa.IsaVTable](isa.registered(?reg.isa, ii));
        val m: *isa.MachineModel = isa_vt.model;
        if (m.index_width == 0)                       { ret 2; }
        if (m.has_v128 && m.vector_op_bytes == 0)     { ret 3; }
        if (m.auto_vectorize && !m.vectors_in_registers) { ret 4; }
        ii = ii + 1;
    }
    ret 0;
}

test "mach.lang.target.resolve:env_is_member_owned_and_unknown_or_undefined_values_are_refused" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }

    var gpu: TargetRequest = target_request("spirv", "freestanding", "spirv");
    with_env(?gpu, "vulkan1.2", "gpu");
    val ok: R.Result[resolved.Target, str] = resolve(?reg, ?gpu);
    if (R.is_err[resolved.Target, str](ok)) { ret 2; }
    val t: resolved.Target = R.unwrap_ok[resolved.Target, str](ok);
    if (t.env_id != 2 || !str_equals(t.env_name, "vulkan1.2") || t.env_profile != 2) { ret 3; }
    val view: isa.BackendTarget = resolved.backend_target(?t);
    if (view.identity.env_id != 2 || !str_equals(view.identity.env_name, "vulkan1.2")) { ret 4; }

    var none: TargetRequest = target_request("spirv", "freestanding", "spirv");
    val plain: R.Result[resolved.Target, str] = resolve(?reg, ?none);
    if (R.is_err[resolved.Target, str](plain) || R.unwrap_ok[resolved.Target, str](plain).env_id != isa.ENV_NONE) { ret 5; }

    var bogus: TargetRequest = target_request("spirv", "freestanding", "spirv");
    with_env(?bogus, "vulkan9.9", "gpu");
    val rejected: R.Result[resolved.Target, str] = resolve(?reg, ?bogus);
    if (R.is_ok[resolved.Target, str](rejected)) { ret 6; }
    val msg: str = R.unwrap_err[resolved.Target, str](rejected);
    if (!str_contains(msg, "[target.gpu]") || !str_contains(msg, "vulkan9.9") || !str_contains(msg, "vulkan1.0")
        || !str_contains(msg, "vulkan1.3") || !str_contains(msg, "does not define")) { ret 7; }

    var cpu: TargetRequest = target_request("x86_64", "linux", "sysv64");
    with_env(?cpu, "vulkan1.2", "host");
    val undefined: R.Result[resolved.Target, str] = resolve(?reg, ?cpu);
    if (R.is_ok[resolved.Target, str](undefined)) { ret 8; }
    val umsg: str = R.unwrap_err[resolved.Target, str](undefined);
    if (!str_contains(umsg, "[target.host]") || !str_contains(umsg, "defines no environments")) { ret 9; }
    ret 0;
}


fun t_publication_open(operation: *publication.Plan, alloc: *A.Allocator, name: str) R.Result[*publication.Destination, str] {
    val initialized: O.Option[txn.Error] = publication.plan_init(operation, alloc);
    if (O.is_some[txn.Error](initialized)) { ret R.err[*publication.Destination, str](txn.error_message(O.unwrap[txn.Error](initialized))); }
    val destination: R.Result[*publication.Destination, str] = publication.plan_add(operation, name, false);
    if (R.is_err[*publication.Destination, str](destination)) { ret destination; }
    val sealed: O.Option[txn.Error] = publication.plan_seal(operation);
    if (O.is_some[txn.Error](sealed)) { ret R.err[*publication.Destination, str](txn.error_message(O.unwrap[txn.Error](sealed))); }
    ret destination;
}

fun t_publication_close(operation: *publication.Plan, result: R.Result[R.Void, str]) R.Result[R.Void, str] {
    val closed: O.Option[txn.Error] = publication.plan_dnit(operation);
    if (R.is_ok[R.Void, str](result) && O.is_some[txn.Error](closed)) {
        ret R.err[R.Void, str](txn.error_message(O.unwrap[txn.Error](closed)));
    }
    ret result;
}
