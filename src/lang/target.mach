test select__spirv_defaults_to_the_finished_module_format {
    val reg: *TargetRegistry = t_registry();

    val r: res[binding.Binding, fail.Fail] = select(reg, "spirv", "freestanding", "spirv");
    if (sel r.err) { ret 1; }
    val t: binding.Binding = r.ok;

    if (!isa.emits_whole_module(t.isa))      { ret 1; }
    if (!str_equals(t.os.default_of, "raw")) { ret 1; }

    if (t.of == nil)                             { ret 1; }
    if (t.of.id != target_of.SPV)                { ret 1; }
    if (!t.of.object_is_artifact)                { ret 1; }
    if (!str_equals(t.of.object_suffix, ".spv")) { ret 1; }
    if (t.of.object_emit == nil)                 { ret 1; }

    val rm: res[binding.Binding, fail.Fail] = select(reg, "x86_64", "freestanding", "sysv64");
    if (sel rm.err)                   { ret 1; }
    if (rm.ok.of.id != target_of.RAW) { ret 1; }
    val ov: res[binding.Binding, fail.Fail] = select_of(reg, "x86_64", "freestanding", "sysv64", "elf");
    if (sel ov.err)                   { ret 1; }
    if (ov.ok.of.id != target_of.ELF) { ret 1; }

    ret 0;
}

test select_of__rejects_crossed_emission_shapes {
    val reg: *TargetRegistry = t_registry();

    val rw: res[binding.Binding, fail.Fail] = select_of(reg, "spirv", "freestanding", "spirv", "raw");
    if (!sel rw.err) { ret 1; }
    val mw: str = fail.describe(rw.err);
    if (!str_contains(mw, "spirv"))            { ret 1; }
    if (!str_contains(mw, "raw"))              { ret 1; }
    if (!str_contains(mw, "finished modules")) { ret 1; }

    val re: res[binding.Binding, fail.Fail] = select_of(reg, "spirv", "freestanding", "spirv", "elf");
    if (!sel re.err) { ret 1; }

    val rr: res[binding.Binding, fail.Fail] = select_of(reg, "x86_64", "freestanding", "sysv64", "spv");
    if (!sel rr.err) { ret 1; }

    ret 0;
}

test select_of__freestanding_raw_emits_flat_image {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    val reg: *TargetRegistry = t_registry();

    val res_target: res[binding.Binding, fail.Fail] = select_of(reg, "x86_64", "freestanding", "sysv64", "raw");
    if (sel res_target.err) { ret 1; }
    val t: binding.Binding = res_target.ok;
    if (t.of == nil)              { ret 1; }
    if (t.of.id != target_of.RAW) { ret 1; }
    if (t.of.image_emit == nil)   { ret 1; }

    var code_bytes: [4]u8;
    code_bytes[0] = 0xEB;
    code_bytes[1] = 0xFE;
    code_bytes[2] = 0x90;
    code_bytes[3] = 0x90;
    var segs: [1]target_of.LoadSegment;
    segs[0].vaddr  = t.os.base_addr;
    segs[0].filesz = 4;
    segs[0].memsz  = 4;
    segs[0].flags  = target_of.SEG_FLAG_READ | target_of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?code_bytes[0];

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "sel_raw");
    if (sel tf_r.err) { ret 1; }
    var tf:    fs.TempFile = tf_r.ok;
    val tpath: str         = fs.temp_path(?tf);

    val em: err[fail.Fail] = target_of.image_write(t.of.image_emit, target_of.LinkedImage{alloc: ?alloc, interner: ?itn, target: ?t.object, segments: ?segs[0], segment_count: 1, page_size: t.os.page_size, image_base: t.os.base_addr, entry: t.os.base_addr, name: "selraw"::*u8, options: target_of.image_options_default(catalog_subsystem.CONSOLE), product: catalog_artifact.EXECUTABLE}, tpath);
    if (sel em.err) {
        fs.temp_close_and_remove(?tf);
        ret 1;
    }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (sel rr.err) { ret 1; }
    var b: Vector[u8] = rr.ok;

    if (b.len != 4) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }
    if (b.data[0] == 0x7F) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }
    if (b.data[0] != 0xEB) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }
    if (b.data[1] != 0xFE) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }

    collections_vector.dnit[u8](?b);
    ret 0;
}

