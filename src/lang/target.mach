test select__fs_policy_is_per_tuple_not_shared_across_linux_architectures {
    var reg:     TargetRegistry = registry_init();
    val res_reg: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel res_reg.err) { ret 1; }

    val res_x64: res[binding.Binding, fail.Fail] = select(?reg, "x86_64", "linux", "sysv64");
    if (sel res_x64.err) { ret 1; }
    val tx64: binding.Binding = res_x64.ok;

    val res_a64: res[binding.Binding, fail.Fail] = select(?reg, "aarch64", "linux", "aapcs64");
    if (sel res_a64.err) { ret 1; }
    val ta64: binding.Binding = res_a64.ok;

    val res_r64: res[binding.Binding, fail.Fail] = select(?reg, "riscv64", "linux", "lp64d");
    if (sel res_r64.err) { ret 1; }
    val tr64: binding.Binding = res_r64.ok;

    var bad: bool = false;
    if (!str_equals(tx64.target.fs_policy.dynamic_interpreter, "/lib64/ld-linux-x86-64.so.2"))      { bad = true; }
    if (!str_equals(ta64.target.fs_policy.dynamic_interpreter, "/lib/ld-linux-aarch64.so.1"))       { bad = true; }
    if (!str_equals(tr64.target.fs_policy.dynamic_interpreter, "/lib/ld-linux-riscv64-lp64d.so.1")) { bad = true; }

    if (str_equals(tx64.target.fs_policy.dynamic_interpreter, ta64.target.fs_policy.dynamic_interpreter)) { bad = true; }
    if (str_equals(tx64.target.fs_policy.dynamic_interpreter, tr64.target.fs_policy.dynamic_interpreter)) { bad = true; }
    if (str_equals(ta64.target.fs_policy.dynamic_interpreter, tr64.target.fs_policy.dynamic_interpreter)) { bad = true; }

    if (!str_equals(tx64.target.fs_policy.libdirs[2], "/lib/x86_64-linux-gnu"))  { bad = true; }
    if (!str_equals(ta64.target.fs_policy.libdirs[0], "/lib/aarch64-linux-gnu")) { bad = true; }
    if (!str_equals(tr64.target.fs_policy.libdirs[0], "/lib/riscv64-linux-gnu")) { bad = true; }

    if (!str_equals(ta64.target.fs_policy.libdirs[2], "/lib64"))     { bad = true; }
    if (!str_equals(tr64.target.fs_policy.libdirs[3], "/usr/lib64")) { bad = true; }

    var li: u32 = 0;
    for (li < ta64.target.fs_policy.libdir_len) {
        if (str_equals(ta64.target.fs_policy.libdirs[li], "/lib/x86_64-linux-gnu")
            || str_equals(ta64.target.fs_policy.libdirs[li], "/usr/lib/x86_64-linux-gnu")) { bad = true; }
        li = li + 1;
    }

    if (bad) { ret 1; }
    ret 0;
}

