test "mach.lang.target.backend_target:uses_resolved_image_base_and_arch_page_size" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_1365: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1365.err) {
        registry_dnit(?reg);
        ret 1;
    }

    var bad: bool          = false;
    var req: TargetRequest = target_request("aarch64", "linux", "aapcs64");
    with_image(?req, 0x12345000, 0, 0);
    val lr: res[resolved.Target, fail.Fail] = resolve(?reg, ?req);
    if (sel lr.err) { bad = true; }
    or (sel lr.ok) {
        var lt: resolved.Target   = lr.ok;
        val lv: isa.BackendTarget = resolved.backend_target(?lt);
        if (lv.os.image_base != 0x12345000) { bad = true; }
        if (lv.os.page_size != 65536)       { bad = true; }
    }

    val dr: res[resolved.Target, fail.Fail] = select(?reg, "aarch64", "darwin", "aapcs64");
    if (sel dr.err) { bad = true; }
    or (sel dr.ok) {
        var dt: resolved.Target   = dr.ok;
        val dv: isa.BackendTarget = resolved.backend_target(?dt);
        if (dv.os.image_base != darwin.DARWIN_BASE_ADDR) { bad = true; }
        if (dv.os.page_size != 16384)                    { bad = true; }
    }

    registry_dnit(?reg);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.select:linux_riscv64" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel res_reg.err) { ret 1; }

    val res_target: res[resolved.Target, fail.Fail] = select_of(?reg, "riscv64", "linux", "lp64d", "");
    if (sel res_target.err) { ret 1; }
    val t: resolved.Target = res_target.ok;

    if (t.arch == nil)                { ret 1; }
    if (t.isa.id != isa.ARCH_RISCV64) { ret 1; }
    if (t.isa.elf_machine != 243)     { ret 1; }
    if (t.isa.pointer_width != 8)     { ret 1; }

    if (t.arch.select == nil) { ret 1; }
    if (t.arch.encode == nil) { ret 1; }

    if (t.model.pointer_width != 8)              { ret 1; }
    if (t.model.gpr_width != 8)                  { ret 1; }
    if (t.model.endianness != isa.ENDIAN_LITTLE) { ret 1; }
    if (t.model.reg_class_len != 2)              { ret 1; }

    var gp_len: u32 = 0;
    var fp_len: u32 = 0;
    var ci:     u32 = 0;
    for (ci < t.model.reg_class_len) {
        if (t.model.reg_classes[ci].kind == isa.RC_GENERAL) { gp_len = t.model.reg_classes[ci].len; }
        if (t.model.reg_classes[ci].kind == isa.RC_FLOAT)   { fp_len = t.model.reg_classes[ci].len; }
        ci = ci + 1;
    }
    if (gp_len != 32) { ret 1; }
    if (fp_len != 30) { ret 1; }

    var x0_reserved: bool = false;
    var ri:          i32  = 0;
    for (ri < t.model.reserved_len) {
        if (t.model.reserved_regs[ri].id == 0) { x0_reserved = true; }
        ri = ri + 1;
    }
    if (!x0_reserved) { ret 1; }

    if (t.model.frame_ptr_reg != 8) { ret 1; }
    if (t.model.stack_ptr_reg != 2) { ret 1; }

    if (t.abi == nil)              { ret 1; }
    if (t.abi.id != abi.ABI_LP64D) { ret 1; }
    val arg: abi.ArgPassingFn = t.abi.arg_passing;
    val ai:  abi.ParamSlot    = arg(0, 8, 8, false, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (ai.class != abi.CLASS_GP)     { ret 1; }
    if (mir.preg_regid(ai.reg) != 10) { ret 1; }
    val af: abi.ParamSlot = arg(0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (af.class != abi.CLASS_FP)                                           { ret 1; }
    if (mir.preg_regid(af.reg) != isa.regid_make(isa.REG_CLASS_ID_XMM, 10)) { ret 1; }
    val rp: abi.RetPassingFn = t.abi.ret_passing;
    val rr: abi.ParamSlot    = rp(8, 8, false, 0, false, false, 0, 0, abi.agg_none());
    if (rr.class != abi.CLASS_GP)     { ret 1; }
    if (mir.preg_regid(rr.reg) != 10) { ret 1; }

    ret 0;
}

test "mach.lang.target.select:riscv32_freestanding_raw" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel res_reg.err) { ret 1; }

    val res_target: res[resolved.Target, fail.Fail] = select(?reg, "rv32imafdc", "freestanding", "ilp32d");
    if (sel res_target.err) { ret 1; }
    val t: resolved.Target = res_target.ok;

    if (t.arch == nil)                { ret 1; }
    if (t.isa.id != isa.ARCH_RISCV32) { ret 1; }
    if (t.isa.elf_machine != 243)     { ret 1; }
    if (t.isa.pointer_width != 4)     { ret 1; }
    if (t.arch.select == nil)         { ret 1; }
    if (t.arch.encode == nil)         { ret 1; }

    if (t.model.pointer_width != 4) { ret 1; }
    if (t.model.gpr_width != 4)     { ret 1; }
    if (t.model.max_alu_width != 4) { ret 1; }
    if (t.model.spill_width != 4)   { ret 1; }
    if (t.model.alu_min_width != 4) { ret 1; }
    if (t.model.flen_bits != 64)    { ret 1; }

    if (t.model.reg_class_len != 2) { ret 1; }
    var gp_len: u32 = 0;
    var fp_len: u32 = 0;
    var ci:     u32 = 0;
    for (ci < t.model.reg_class_len) {
        if (t.model.reg_classes[ci].kind == isa.RC_GENERAL) { gp_len = t.model.reg_classes[ci].len; }
        if (t.model.reg_classes[ci].kind == isa.RC_FLOAT)   { fp_len = t.model.reg_classes[ci].len; }
        ci = ci + 1;
    }
    if (gp_len != 32)               { ret 1; }
    if (fp_len != 30)               { ret 1; }
    if (t.model.frame_ptr_reg != 8) { ret 1; }
    if (t.model.stack_ptr_reg != 2) { ret 1; }

    val res64: res[resolved.Target, fail.Fail] = select_of(?reg, "riscv64", "linux", "lp64d", "");
    if (sel res64.err) { ret 1; }
    val t64: resolved.Target = res64.ok;
    if (t64.model.gpr_width != 8) { ret 1; }
    if (t.model.gpr_width != 4)   { ret 1; }

    if (t.abi == nil)                    { ret 1; }
    if (t.abi.id != abi.ABI_ILP32D)      { ret 1; }
    if (t.abi.arg_slot_granularity != 4) { ret 1; }
    val arg: abi.ArgPassingFn = t.abi.arg_passing;
    val ai:  abi.ParamSlot    = arg(0, 4, 4, false, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (ai.class != abi.CLASS_GP)     { ret 1; }
    if (mir.preg_regid(ai.reg) != 10) { ret 1; }
    val af: abi.ParamSlot = arg(0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (af.class != abi.CLASS_FP)                                           { ret 1; }
    if (mir.preg_regid(af.reg) != isa.regid_make(isa.REG_CLASS_ID_XMM, 10)) { ret 1; }

    if (t.of == nil)                         { ret 1; }
    if (!str_equals(t.os.default_of, "raw")) { ret 1; }

    val small_r: res[resolved.Target, fail.Fail] = select(?reg, "rv32imc", "freestanding", "ilp32");
    if (sel small_r.err) { ret 2; }
    val small: resolved.Target = small_r.ok;
    if (small.model.riscv_extensions != (rvfeatures.I | rvfeatures.M | rvfeatures.C)
        || small.model.has_float || small.model.flen_bits != 0 || small.model.reg_class_len != 1
        || !small.model.has_mul || rvfeatures.has(small.model.riscv_extensions, rvfeatures.A)) { ret 3; }
    val small_d: res[resolved.Target, fail.Fail] = select(?reg, "rv32imc", "freestanding", "ilp32d");
    if (sel small_d.ok)                                       { ret 4; }
    if (!str_contains(fail.describe(small_d.err), "rv32imc")) { ret 4; }
    val r_1522: res[resolved.Target, fail.Fail] = select(?reg, "riscv32", "freestanding", "ilp32f");
    if (sel r_1522.ok) { ret 5; }
    val default_r: res[resolved.Target, fail.Fail] = select(?reg, "riscv32", "freestanding", "ilp32");
    if (sel default_r.err)                                           { ret 6; }
    if (default_r.ok.model.riscv_extensions != rvfeatures.DEFAULT32) { ret 7; }
    if (t.model.flen_bits != 64 || t.model.reg_class_len != 2
        || t.isa != small.isa || small.model.flen_bits != 0) { ret 8; }
    val f_r: res[resolved.Target, fail.Fail] = select(?reg, "rv64if", "freestanding", "lp64f");
    if (sel f_r.err) { ret 9; }
    val f_only: resolved.Target = f_r.ok;
    if (f_only.model.flen_bits != 32 || !f_only.model.has_float || f_only.model.has_mul) { ret 10; }
    val r_1532: res[resolved.Target, fail.Fail] = select(?reg, "rv64if", "freestanding", "lp64d");
    if (sel r_1532.ok) { ret 11; }
    val default64: res[resolved.Target, fail.Fail] = select(?reg, "riscv64", "linux", "lp64d");
    if (sel default64.err)                                           { ret 12; }
    if (default64.ok.model.riscv_extensions != rvfeatures.DEFAULT64) { ret 12; }
    val r_1536: res[resolved.Target, fail.Fail] = select(?reg, "rv32e", "freestanding", "ilp32");
    if (sel r_1536.ok) { ret 13; }
    val r_1537: res[resolved.Target, fail.Fail] = select(?reg, "rv64iv", "linux", "lp64");
    if (sel r_1537.ok) { ret 13; }
    val r_1538: res[resolved.Target, fail.Fail] = select(?reg, "rv64i_zba", "linux", "lp64");
    if (sel r_1538.ok) { ret 13; }
    val compressed_flags: u32            = isa.machine_flags(small.isa, 0, true);
    val r_1540:           err[fail.Fail] = isa.validate_attributes(small.isa, ?small.model, nil, 0, compressed_flags);
    if (sel r_1540.err) { ret 14; }
    val r_1541: err[fail.Fail] = isa.validate_attributes(f_only.isa, ?f_only.model, nil, 0, compressed_flags);
    if (sel r_1541.ok) { ret 15; }
    ret 0;
}

rec RvMatrixRow {
    isa:  str;
    os:   str;
    abi:  str;
    exts: u32;
    flen: u32;
}

# one retained RISC-V tuple: the selection string, the model it narrows to, the
# ABI's float requirement and the emitted Tag_RISCV_arch must all say the same thing
fun t_rv_matrix_row(reg: *TargetRegistry, alloc: *A.Allocator, row: *RvMatrixRow) i32 {
    val res_: res[resolved.Target, fail.Fail] = select(reg, row.isa, row.os, row.abi);
    if (sel res_.err) { ret 1; }
    val t:      resolved.Target                      = res_.ok;
    val parsed: res[rvfeatures.Selection, fail.Fail] = rvfeatures.parse(row.isa);
    if (sel parsed.err) { ret 2; }
    val selection: rvfeatures.Selection = parsed.ok;
    if (selection.extensions != row.exts || t.model.riscv_extensions != row.exts)         { ret 3; }
    if (t.model.gpr_width != selection.width || t.model.pointer_width != selection.width) { ret 4; }
    if (t.model.has_float != rvfeatures.has(row.exts, rvfeatures.F)
        || t.model.has_mul != rvfeatures.has(row.exts, rvfeatures.M)
        || t.model.flen_bits != row.flen) { ret 5; }
    val need: u32 = rvfeatures.float_requirement(t.abi.float_arg_bits);
    if (!rvfeatures.has(row.exts, need) || t.abi.float_arg_bits > t.model.flen_bits) { ret 6; }
    val has_c:      bool = rvfeatures.has(row.exts, rvfeatures.C);
    val flags:      u32  = isa.machine_flags(t.isa, t.abi.float_arg_bits, has_c);
    var want_flags: u32  = elf.EF_RISCV_FLOAT_ABI_SOFT;
    if (t.abi.float_arg_bits == 32) { want_flags = elf.EF_RISCV_FLOAT_ABI_SINGLE; }
    if (t.abi.float_arg_bits == 64) { want_flags = elf.EF_RISCV_FLOAT_ABI_DOUBLE; }
    if (has_c)                      { want_flags = want_flags | elf.EF_RISCV_RVC; }
    if (flags != want_flags)        { ret 7; }
    var len:   u32                 = 0;
    val built: res[*u8, fail.Fail] = isa.build_attributes(t.isa, ?t.model, alloc, t.abi.float_arg_bits, has_c, ?len);
    if (sel built.err) { ret 8; }
    if (len == 0)      { ret 8; }
    val bytes:  *u8            = built.ok;
    var at:     rvattrs.Attrs;
    val r_1582: err[fail.Fail] = rvattrs.parse_body(bytes, len, ?at);
    if (sel r_1582.err)                      { ret 9; }
    if (!at.has_arch)                        { ret 9; }
    if (at.arch.xlen != selection.width * 8) { ret 10; }
    var ei:      usize = 0;
    var emitted: u32   = 0;
    for (ei < rvfeatures.EXT_COUNT) {
        val spec:    rvfeatures.ExtSpec = rvfeatures.EXTS[ei];
        var present: bool               = false;
        var xi:      u32                = 0;
        for (xi < at.arch.count) {
            val e: *rvattrs.Ext = ?at.arch.exts[xi];
            if (rvfeatures.ext_index((?e.name[0])::str, e.name_len::usize) == ei) {
                present = true;
                if (e.major != spec.major || e.minor != spec.minor) { ret 11; }
            }
            xi = xi + 1;
        }
        val selected: bool = spec.emitted && rvfeatures.has(row.exts, spec.requires);
        if (present != selected) { ret 12; }
        if (present)             { emitted = emitted + 1; }
        ei = ei + 1;
    }
    if (emitted != at.arch.count) { ret 13; }
    val r_1605: err[fail.Fail] = isa.validate_attributes(t.isa, ?t.model, bytes, len, flags);
    if (sel r_1605.err) { ret 14; }
    ret 0;
}

fun t_rv_refused(reg: *TargetRegistry, isa_name: str, os_name: str, abi_name: str, names: str) bool {
    val res_: res[resolved.Target, fail.Fail] = select(reg, isa_name, os_name, abi_name);
    if (sel res_.ok) { ret false; }
    ret str_contains(fail.describe(res_.err), names);
}

test "mach.lang.target.select:riscv_retained_matrix_agrees_on_selection_abi_and_attributes" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_1618: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1618.err) { ret 1; }
    var alloc:  A.Allocator;
    val r_1620: err[A.Error] = page.make(?alloc);
    if (sel r_1620.err) { ret 1; }

    val g:    u32             = rvfeatures.G;
    val rows: [13]RvMatrixRow = [13]RvMatrixRow{
        RvMatrixRow{isa: "riscv64", os: "linux", abi: "lp64d", exts: rvfeatures.DEFAULT64, flen: 64},
        RvMatrixRow{isa: "rv64gc", os: "linux", abi: "lp64d", exts: rvfeatures.DEFAULT64, flen: 64},
        RvMatrixRow{isa: "riscv64", os: "linux", abi: "lp64f", exts: rvfeatures.DEFAULT64, flen: 64},
        RvMatrixRow{isa: "riscv64", os: "linux", abi: "lp64", exts: rvfeatures.DEFAULT64, flen: 64},
        RvMatrixRow{isa: "rv64imafd", os: "linux", abi: "lp64d", exts: g & ~rvfeatures.ZIFENCEI, flen: 64},
        RvMatrixRow{isa: "rv64imafc", os: "freestanding", abi: "lp64f", exts: rvfeatures.I | rvfeatures.M | rvfeatures.A | rvfeatures.F | rvfeatures.C | rvfeatures.ZICSR, flen: 32},
        RvMatrixRow{isa: "rv64if", os: "freestanding", abi: "lp64f", exts: rvfeatures.I | rvfeatures.F | rvfeatures.ZICSR, flen: 32},
        RvMatrixRow{isa: "rv64i", os: "freestanding", abi: "lp64", exts: rvfeatures.I, flen: 0},
        RvMatrixRow{isa: "riscv32", os: "freestanding", abi: "ilp32", exts: rvfeatures.DEFAULT32, flen: 0},
        RvMatrixRow{isa: "rv32imac", os: "freestanding", abi: "ilp32", exts: rvfeatures.DEFAULT32, flen: 0},
        RvMatrixRow{isa: "rv32imc", os: "freestanding", abi: "ilp32", exts: rvfeatures.I | rvfeatures.M | rvfeatures.C, flen: 0},
        RvMatrixRow{isa: "rv32imafdc", os: "freestanding", abi: "ilp32d", exts: (g & ~rvfeatures.ZIFENCEI) | rvfeatures.C, flen: 64},
        RvMatrixRow{isa: "rv32imafc", os: "freestanding", abi: "ilp32f", exts: rvfeatures.I | rvfeatures.M | rvfeatures.A | rvfeatures.F | rvfeatures.C | rvfeatures.ZICSR, flen: 32},
    };
    var i: usize = 0;
    for (i < 13) {
        val code: i32 = t_rv_matrix_row(?reg, ?alloc, ?rows[i]);
        if (code != 0) { ret (i::i32 + 1) * 16 + code; }
        i = i + 1;
    }
    val rv32_d: res[resolved.Target, fail.Fail] = select(?reg, "rv32imafdc", "freestanding", "ilp32");
    val rv32_f: res[resolved.Target, fail.Fail] = select(?reg, "rv32imafdc", "freestanding", "ilp32f");
    if (sel rv32_d.err) { ret 2; }
    if (sel rv32_f.err) { ret 2; }

    # the ABI needs F or D the selection lacks: the letter and the selection are named
    if (!t_rv_refused(?reg, "rv32imc", "freestanding", "ilp32d", "lacks the F and D extensions")
        || !t_rv_refused(?reg, "rv32imc", "freestanding", "ilp32d", "'rv32imc'")) { ret 3; }
    if (!t_rv_refused(?reg, "riscv32", "freestanding", "ilp32f", "lacks the F extension")
        || !t_rv_refused(?reg, "riscv32", "freestanding", "ilp32f", "'riscv32'")) { ret 4; }
    if (!t_rv_refused(?reg, "rv64if", "freestanding", "lp64d", "lacks the D extension")
        || !t_rv_refused(?reg, "rv64if", "freestanding", "lp64d", "'rv64if'")) { ret 5; }
    if (!t_rv_refused(?reg, "rv64i", "linux", "lp64f", "lacks the F extension")) { ret 6; }
    # the E base, an unknown extension, a noncanonical order, a version: token and string
    if (!t_rv_refused(?reg, "rv32e", "freestanding", "ilp32", "E is unsupported")
        || !t_rv_refused(?reg, "rv32e", "freestanding", "ilp32", "'rv32e'")) { ret 7; }
    if (!t_rv_refused(?reg, "rv64iv", "linux", "lp64", "unknown or unavailable RISC-V extension: 'v' in selection 'rv64iv'"))            { ret 8; }
    if (!t_rv_refused(?reg, "rv64i_zba", "linux", "lp64", "'zba' in selection 'rv64i_zba'"))                                             { ret 9; }
    if (!t_rv_refused(?reg, "rv64icm", "linux", "lp64", "noncanonical RISC-V extension order: 'm' in selection 'rv64icm'"))              { ret 10; }
    if (!t_rv_refused(?reg, "rv64imm", "linux", "lp64", "duplicate or noncanonical RISC-V extension order: 'm' in selection 'rv64imm'")) { ret 11; }
    if (!t_rv_refused(?reg, "rv64i3p0", "linux", "lp64", "'3p0' in selection 'rv64i3p0'"))                                               { ret 12; }
    if (!t_rv_refused(?reg, "rv64id", "linux", "lp64", "D extension requires F: selection 'rv64id'"))                                    { ret 13; }
    if (!t_rv_refused(?reg, "rv64i_", "linux", "lp64", "trailing separator in RISC-V extension string: '_' in selection 'rv64i_'"))      { ret 14; }
    ret 0;
}

test "mach.lang.target.select:riscv32_linux_is_refused_because_linux_does_not_list_the_isa" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_1673: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1673.err) { ret 1; }

    val isa_opt: opt[*isa.IsaVTable] = isa.lookup(?reg.isa, "riscv32");
    if (sel isa_opt.none) { ret 1; }
    val abi_opt: opt[*abi.AbiVTable] = abi.lookup(?reg.abi, "ilp32d");
    if (sel abi_opt.none) { ret 1; }

    val res_: res[resolved.Target, fail.Fail] = select(?reg, "riscv32", "linux", "ilp32");
    if (!sel res_.err) { ret 1; }
    val diag: str = fail.describe(res_.err);
    if (!str_contains(diag, "does not run on instruction set")) { ret 1; }
    if (!str_contains(diag, "linux"))                           { ret 1; }
    if (!str_contains(diag, "riscv32"))                         { ret 1; }
    ret 0;
}

test "mach.lang.target.select:x86_64_freestanding_raw" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel res_reg.err) { ret 1; }

    val res_target: res[resolved.Target, fail.Fail] = select(?reg, "x86_64", "freestanding", "sysv64");
    if (sel res_target.err) { ret 1; }
    val t: resolved.Target = res_target.ok;

    if (t.os == nil)                              { ret 1; }
    if (t.os.id != os.OS_FREESTANDING)            { ret 1; }
    if (!str_equals(t.os.entry_symbol, "_start")) { ret 1; }
    if (!str_equals(t.os.default_of, "raw"))      { ret 1; }
    if (t.os.base_addr != 0)                      { ret 1; }
    if (t.os.page_size != 1)                      { ret 1; }

    if (t.of == nil)           { ret 1; }
    if (t.of.id != of.OF_RAW)  { ret 1; }
    if (t.of.emit_exec == nil) { ret 1; }

    if (t.abi == nil)                { ret 1; }
    if (t.abi.id != abi.ABI_SYSV)    { ret 1; }
    if (t.arch == nil)               { ret 1; }
    if (t.isa.id != isa.ARCH_X86_64) { ret 1; }

    ret 0;
}

