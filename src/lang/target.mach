pub fun host_os_id() u32 {
    $if ($mach.build.os == $mach.os.linux)   { ret catalog_os.LINUX; }
    $or ($mach.build.os == $mach.os.darwin)  { ret catalog_os.DARWIN; }
    $or ($mach.build.os == $mach.os.windows) { ret catalog_os.WINDOWS; }
    $or                                      { ret catalog_os.UNKNOWN; }
}

pub fun host_arch_id() u32 {
    $if ($mach.build.arch == $mach.arch.x86_64)  { ret catalog_arch.X86_64; }
    $or ($mach.build.arch == $mach.arch.aarch64) { ret catalog_arch.AARCH64; }
    $or ($mach.build.arch == $mach.arch.riscv64) { ret catalog_arch.RISCV64; }
    $or                                          { ret catalog_arch.UNKNOWN; }
}

pub fun host_abi_id() u32 {
    ret ($mach.build.abi)::u32;
}

# the identity a member restates must be the one the catalog gives its id
fun identity_check(a: *A.Allocator, noun: str, name: str, catalog_name: str) err[fail.Fail] {
    if (str_equals(name, catalog_name)) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{fail.formatted(a, "target: {} '{}' carries the catalog id of '{}'", noun, name, catalog_name)};
}

# the catalog checked whole, once, before it is published: every member's
# identity agrees with the shared catalog, and every format's default debug
# model is registered in the shape the format takes
fun catalog_check(reg: *TargetRegistry) err[fail.Fail] {
    val a: *A.Allocator = ?reg.alloc;
    var i: u32          = 0;
    for (i < reg.isa.count) {
        val vt: *isa.IsaVTable = reg.isa.members[i];
        val ok: err[fail.Fail] = identity_check(a, "instruction set", vt.name, catalog_arch.name_for(vt.id));
        if (sel ok.err) { ret ok; }
        i = i + 1;
    }
    i = 0;
    for (i < reg.os.count) {
        val vt: *lang_target_os.OsVTable = reg.os.members[i];
        val ok: err[fail.Fail]           = identity_check(a, "operating system", vt.name, catalog_os.name_for(vt.id));
        if (sel ok.err) { ret ok; }
        i = i + 1;
    }
    i = 0;
    for (i < reg.abi.count) {
        val vt: *abi.AbiVTable = reg.abi.members[i];
        if (vt.id != catalog_abi.UNKNOWN) {
            val ok: err[fail.Fail] = identity_check(a, "calling convention", vt.name, catalog_abi.name_for(vt.id));
            if (sel ok.err) { ret ok; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < reg.of.count) {
        val fmt: *target_of.OfVTable = reg.of.members[i];
        val ok:  err[fail.Fail]      = identity_check(a, "object format", fmt.name, target_of.of_name_for(fmt.id));
        if (sel ok.err) { ret ok; }
        if (!str_empty(fmt.default_debug)) {
            val dbg_o: opt[*target_of.DebugVTable] = target_registry.find[target_of.DebugVTable](?reg.debug, fmt.default_debug);
            if (sel dbg_o.none) {
                ret err[fail.Fail].err{fail.formatted(a, "target: object format '{}' names debug model '{}', which is not registered", fmt.name, fmt.default_debug)};
            }
            if (dbg_o.some.shape != target_of.debug_shape_for(fmt)) {
                ret err[fail.Fail].err{fail.formatted(a, "target: object format '{}' takes a debug model of another shape than '{}'", fmt.name, fmt.default_debug)};
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# fill an empty registry with the catalog and publish it; a published registry
# is left as it is. a registry refused part way holds nothing that needs
# undoing, and is dropped
# ---
# reg:   the registry
# debug: the dwarf debug model, which the backend declares
pub fun register_all(reg: *TargetRegistry, debug: *target_of.DebugVTable) err[fail.Fail] {
    if (reg == nil || debug == nil) {
        ret err[fail.Fail].err{fail.message("target: register_all requires a registry and the dwarf debug model")};
    }
    if (reg.published) { ret err[fail.Fail].ok{}; }
    if (!target_registry.registry_empty(reg)) {
        ret err[fail.Fail].err{fail.message("target: register_all refuses a partial registry")};
    }
    val a: *A.Allocator = ?reg.alloc;
    defs.build();
    val isas: [5]*isa.IsaVTable = [5]*isa.IsaVTable{?x64_register.VTABLE, ?arm64_register.VTABLE,
        ?riscv_register.VTABLE64, ?riscv_register.VTABLE32, ?spirv_register.VTABLE};
    var i: u32 = 0;
    for (i < 5) {
        val added: err[fail.Fail] = target_registry.add[isa.IsaVTable](?reg.isa, a, isas[i]);
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    val abis: [10]*abi.AbiVTable = [10]*abi.AbiVTable{?sysv.VTABLE, ?win64.VTABLE, ?aapcs64.VTABLE,
        ?abi_riscv.LP64, ?abi_riscv.LP64F, ?abi_riscv.LP64D, ?abi_riscv.ILP32, ?abi_riscv.ILP32F, ?abi_riscv.ILP32D,
        ?abi_spirv.VTABLE};
    i = 0;
    for (i < 10) {
        val added: err[fail.Fail] = target_registry.add[abi.AbiVTable](?reg.abi, a, abis[i]);
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    val ofs: [5]*target_of.OfVTable = [5]*target_of.OfVTable{?elf.VTABLE, ?coff.VTABLE, ?macho.VTABLE, ?raw.VTABLE, ?spv.VTABLE};
    i = 0;
    for (i < 5) {
        val added: err[fail.Fail] = target_registry.add[target_of.OfVTable](?reg.of, a, ofs[i]);
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    val oses: [4]*lang_target_os.OsVTable = [4]*lang_target_os.OsVTable{?target_os_linux.VTABLE, ?target_os_darwin.VTABLE,
        ?target_os_windows.VTABLE, ?freestanding.VTABLE};
    i = 0;
    for (i < 4) {
        val added: err[fail.Fail] = target_registry.add[lang_target_os.OsVTable](?reg.os, a, oses[i]);
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    val dwarf: err[fail.Fail] = target_registry.add[target_of.DebugVTable](?reg.debug, a, debug);
    if (sel dwarf.err) { ret dwarf; }
    val module: err[fail.Fail] = target_registry.add[target_of.DebugVTable](?reg.debug, a, ?spv.DEBUG);
    if (sel module.err) { ret module; }
    val whole: err[fail.Fail] = catalog_check(reg);
    if (sel whole.err) { ret whole; }
    reg.published = true;
    ret err[fail.Fail].ok{};
}

pub rec TargetRequest {
    isa_name:      str;
    os_name:       str;
    abi_name:      str;
    of_name:       str;
    base:          u64;
    stack_reserve: u64;
    stack_commit:  u64;
    env_name:      str;
    # where the caller's `env` was written, which a refusal of it names
    env_origin: str;
    # names from the isa's extension vocabulary, borrowed for the call
    extensions:      *str;
    extension_count: u32;
}

pub fun target_request(isa_name: str, os_name: str, abi_name: str) TargetRequest {
    var r: TargetRequest;
    r.isa_name        = isa_name;
    r.os_name         = os_name;
    r.abi_name        = abi_name;
    r.of_name         = "";
    r.base            = 0;
    r.stack_reserve   = 0;
    r.stack_commit    = 0;
    r.extensions      = nil;
    r.extension_count = 0;
    ret r;
}

pub fun with_extensions(req: *TargetRequest, names: *str, count: u32) {
    req.extensions      = names;
    req.extension_count = count;
}

pub fun with_of(req: *TargetRequest, of_name: str) {
    req.of_name = of_name;
}

pub fun with_env(req: *TargetRequest, env_name: str, origin: str) {
    req.env_name   = env_name;
    req.env_origin = origin;
}

pub fun with_image(req: *TargetRequest, base: u64, stack_reserve: u64, stack_commit: u64) {
    req.base          = base;
    req.stack_reserve = stack_reserve;
    req.stack_commit  = stack_commit;
}

pub fun select_of(reg: *TargetRegistry, isa_name: str, os_name: str, abi_name: str, of_name: str) res[binding.Binding, fail.Fail] {
    var req: TargetRequest = target_request(isa_name, os_name, abi_name);
    with_of(?req, of_name);
    ret resolve(reg, ?req);
}

# the granularity the image is laid out at: a format a loader maps by page puts
# each segment on a page of its own, the operating system's page where it
# declares one (the largest a kernel of that system may use) and the isa's
# hardware page otherwise; a flat image has no page and is laid out byte-tight
fun tuple_page_size(a: *A.Allocator, os_vt: *lang_target_os.OsVTable, arch_vt: *isa.IsaVTable, of_vt: *target_of.OfVTable) res[u64, fail.Fail] {
    if (!of_vt.maps_by_page) { ret res[u64, fail.Fail].ok{1}; }
    val os_page_r: res[u64, fail.Fail] = lang_target_os.page_size_checked_for(os_vt, arch_vt.id);
    if (sel os_page_r.err)      { ret os_page_r; }
    if (os_page_r.ok != 0)      { ret os_page_r; }
    if (arch_vt.page_size != 0) { ret res[u64, fail.Fail].ok{arch_vt.page_size}; }
    ret res[u64, fail.Fail].err{no_page_size(a, os_vt, arch_vt, of_vt)};
}

# every extension vocabulary the registry's instruction sets declare, each table once
fun vocabulary(reg: *TargetRegistry) res[extension.Vocabulary, fail.Fail] {
    var v: extension.Vocabulary = extension.vocabulary_empty();
    var i: u32                  = 0;
    for (i < reg.isa.count) {
        val m: *target_model.Machine = reg.isa.members[i].model;
        if (!extension.vocabulary_add(?v, m.extension_table, m.extension_count)) {
            ret res[extension.Vocabulary, fail.Fail].err{fail.message(
                "target: the registry declares more extension vocabularies than a description carries; raise extension.VOCABULARY_CAP")};
        }
        i = i + 1;
    }
    ret res[extension.Vocabulary, fail.Fail].ok{v};
}

pub fun resolve(reg: *TargetRegistry, req: *TargetRequest) res[binding.Binding, fail.Fail] {
    if (reg == nil || req == nil) {
        ret res[binding.Binding, fail.Fail].err{fail.message("target: resolve requires a registry and target request")};
    }
    if (!target_registry.registry_published(reg)) {
        ret res[binding.Binding, fail.Fail].err{fail.message("target: resolve requires a published registry")};
    }
    val isa_name: str = req.isa_name;
    val os_name:  str = req.os_name;
    val abi_name: str = req.abi_name;
    val of_name:  str = req.of_name;

    val opt_os_vt: opt[*lang_target_os.OsVTable] = target_registry.find[lang_target_os.OsVTable](?reg.os, os_name);
    if (sel opt_os_vt.none) {
        ret res[binding.Binding, fail.Fail].err{unregistered[lang_target_os.OsVTable](reg, ?reg.os, os_name)};
    }
    val os_vt: *lang_target_os.OsVTable = opt_os_vt.some;

    var lookup_name: str = isa_name;
    var rv:          extension_riscv.Selection;
    rv.width      = 0;
    rv.extensions = 0;
    if (extension_riscv.is_name(isa_name)) {
        var bad:    extension_riscv.Span;
        val parsed: res[extension_riscv.Selection, fail.Fail] = extension_riscv.parse_at(isa_name, ?bad);
        if (sel parsed.err) {
            ret res[binding.Binding, fail.Fail].err{selection_refusal(?reg.alloc, fail.describe(parsed.err), isa_name, ?bad)};
        }
        rv          = parsed.ok;
        lookup_name = catalog_arch.name_for(catalog_arch.RISCV64);
        if (rv.width == 4) { lookup_name = catalog_arch.name_for(catalog_arch.RISCV32); }
    }
    val opt_arch_vt: opt[*isa.IsaVTable] = target_registry.find[isa.IsaVTable](?reg.isa, lookup_name);
    if (sel opt_arch_vt.none) {
        ret res[binding.Binding, fail.Fail].err{unregistered[isa.IsaVTable](reg, ?reg.isa, isa_name)};
    }
    val opt_abi_vt: opt[*abi.AbiVTable] = target_registry.find[abi.AbiVTable](?reg.abi, abi_name);
    if (sel opt_abi_vt.none) {
        ret res[binding.Binding, fail.Fail].err{unregistered[abi.AbiVTable](reg, ?reg.abi, abi_name)};
    }

    val arch_vt: *isa.IsaVTable = opt_arch_vt.some;
    val abi_vt:  *abi.AbiVTable = opt_abi_vt.some;

    var of_sel: str = of_name;
    if (str_empty(of_sel)) {
        val opt_def: opt[str] = default_of_name(reg, os_vt, arch_vt);
        if (sel opt_def.none) {
            ret res[binding.Binding, fail.Fail].err{no_module_format(?reg.alloc, arch_vt)};
        }
        of_sel = opt_def.some;
    }
    val opt_of_vt: opt[*target_of.OfVTable] = target_registry.find[target_of.OfVTable](?reg.of, of_sel);
    if (sel opt_of_vt.none) {
        ret res[binding.Binding, fail.Fail].err{unregistered[target_of.OfVTable](reg, ?reg.of, of_sel)};
    }

    val of_vt: *target_of.OfVTable = opt_of_vt.some;

    val added_r: res[u64, fail.Fail] = requested_extensions(?reg.alloc, arch_vt, req);
    if (sel added_r.err) { ret res[binding.Binding, fail.Fail].err{added_r.err}; }
    val env_r: res[u32, fail.Fail] = resolve_environment(?reg.alloc, arch_vt, req);
    if (sel env_r.err) { ret res[binding.Binding, fail.Fail].err{env_r.err}; }
    # the selection holds what the environment guarantees beside what it names
    val added: u64 = added_r.ok | isa.environment_extensions(arch_vt, env_r.ok);

    var selected_model: target_model.Machine;
    val selected_isa:   isa.IsaVTable = select_isa(arch_vt, isa_name, rv, added, ?selected_model);
    val cap:            u32           = tuple_capability(os_vt, ?selected_isa, abi_vt, of_vt);
    if (cap != TUPLE_OK) {
        ret res[binding.Binding, fail.Fail].err{tuple_refusal(?reg.alloc, cap, os_vt, ?selected_isa, abi_vt, of_vt)};
    }

    var b: binding.Binding;
    b.os  = os_vt;
    b.isa = arch_vt;
    isa.object_target(arch_vt, ?b.object);
    b.arch        = arch_vt.machine;
    b.abi         = abi_vt;
    b.of          = of_vt;
    b.reserved_gp = binding.reserved_gp_of(b.arch, os_vt, arch_vt.id);

    val vocabulary_r: res[extension.Vocabulary, fail.Fail] = vocabulary(reg);
    if (sel vocabulary_r.err) { ret res[binding.Binding, fail.Fail].err{vocabulary_r.err}; }

    var t: *resolved.Target = ?b.target;
    t.env_id           = env_r.ok;
    t.env_profile      = isa.environment_profile(arch_vt, t.env_id);
    t.env_name         = req.env_name;
    t.base             = req.base;
    t.stack_reserve    = req.stack_reserve;
    t.stack_commit     = req.stack_commit;
    t.pointer_width    = arch_vt.pointer_width;
    t.defs             = arch_vt.defs;
    t.passing          = abi_vt.passing;
    t.vocabulary       = vocabulary_r.ok;
    t.has_assembly     = isa.has_assembly(arch_vt);
    t.assembly_returns = nil;
    t.int_imm_fits     = nil;
    if (arch_vt.machine != nil) {
        if (arch_vt.machine.has_assembly) { t.assembly_returns = arch_vt.machine.assembly.returns; }
        t.int_imm_fits = arch_vt.machine.int_imm_fits;
    }

    t.variadic_args_on_stack = lang_target_os.variadic_stack_for(os_vt, arch_vt.id);

    t.fixed_args_natural_size = lang_target_os.natural_stack_args_for(os_vt, arch_vt.id);

    t.reg_arg_align = lang_target_os.reg_arg_align_for(os_vt, arch_vt.id);
    # the convention's widening and the platform's are one requirement, so the wider holds
    t.reg_arg_extend = abi_vt.reg_arg_extend;
    val os_extend: u32 = lang_target_os.reg_arg_extend_for(os_vt, arch_vt.id);
    if (os_extend > t.reg_arg_extend) { t.reg_arg_extend = os_extend; }

    t.agg_arg_natural_align = abi_vt.agg_natural_align && !lang_target_os.declared_agg_align_for(os_vt, arch_vt.id);

    var vl_size:  u32                                        = 0;
    var vl_align: u32                                        = 0;
    val vl_r:     res[opt[lang_target_os.VaList], fail.Fail] = lang_target_os.va_list_checked_for(os_vt, arch_vt.id);
    if (sel vl_r.err) {
        ret res[binding.Binding, fail.Fail].err{vl_r.err};
    }
    val vl: opt[lang_target_os.VaList] = vl_r.ok;
    if (sel vl.some) {
        vl_size  = vl.some.size;
        vl_align = vl.some.align;
    }
    t.va_list_size  = vl_size;
    t.va_list_align = vl_align;

    t.os_id   = os_vt.id;
    t.arch_id = arch_vt.id;
    t.abi_id  = abi_vt.id;
    t.of_id   = of_vt.id;

    t.dit_guaranteed = lang_target_os.dit_guaranteed_for(os_vt, arch_vt.id);

    val page_r: res[u64, fail.Fail] = tuple_page_size(?reg.alloc, os_vt, arch_vt, of_vt);
    if (sel page_r.err) { ret res[binding.Binding, fail.Fail].err{page_r.err}; }
    t.page_size = page_r.ok;

    val fp_r: res[opt[catalog_os.FsPolicy], fail.Fail] = lang_target_os.fs_policy_checked_for(os_vt, arch_vt.id);
    if (sel fp_r.err) {
        ret res[binding.Binding, fail.Fail].err{fp_r.err};
    }
    val fp_opt: opt[catalog_os.FsPolicy] = fp_r.ok;
    if (sel fp_opt.none) {
        ret res[binding.Binding, fail.Fail].err{no_fs_policy(?reg.alloc, os_vt, arch_vt)};
    }
    t.fs_policy = fp_opt.some;

    b.debug    = nil;
    t.debug_id = target_of.DBG_UNKNOWN;
    if (!str_empty(of_vt.default_debug)) {
        val opt_dbg: opt[*target_of.DebugVTable] = target_registry.find[target_of.DebugVTable](?reg.debug, of_vt.default_debug);
        if (sel opt_dbg.none) {
            ret res[binding.Binding, fail.Fail].err{unregistered[target_of.DebugVTable](reg, ?reg.debug, of_vt.default_debug)};
        }
        b.debug    = opt_dbg.some;
        t.debug_id = b.debug.id;
        var debug_target: mir_debug.DebugTarget;
        debug_target.arch_id   = arch_vt.id;
        debug_target.os_id     = os_vt.id;
        debug_target.abi_id    = abi_vt.id;
        debug_target.of_id     = of_vt.id;
        debug_target.dwarf_reg = nil;
        debug_target.cv_reg    = nil;
        if (arch_vt.machine != nil) {
            debug_target.dwarf_reg = arch_vt.machine.dwarf_reg;
            debug_target.cv_reg    = arch_vt.machine.cv_reg;
        }
        if (b.debug.shape != target_of.debug_shape_for(of_vt) || b.debug.supports == nil || !b.debug.supports(?debug_target)) {
            ret res[binding.Binding, fail.Fail].err{fail.message("target: selected debug model is incompatible with the target tuple")};
        }
    }

    t.model              = selected_model;
    t.model.stack_align  = abi_vt.stack_align;
    t.model.red_zone     = abi_vt.red_zone;
    t.model.shadow_space = abi_vt.shadow_space;

    ret res[binding.Binding, fail.Fail].ok{b};
}

# the bits a request's extension names select in the isa's vocabulary; a name the
# vocabulary does not hold is refused with the names it does
fun requested_extensions(a: *A.Allocator, arch_vt: *isa.IsaVTable, req: *TargetRequest) res[u64, fail.Fail] {
    var bits: u64 = 0;
    var i:    u32 = 0;
    for (i < req.extension_count) {
        val name: str = req.extensions[i];
        val bit:  u64 = target_model.extension_bundle(arch_vt.model, name, str_len(name));
        if (bit == 0) { ret res[u64, fail.Fail].err{unknown_extension(a, arch_vt, name)}; }
        bits = bits | bit;
        i    = i + 1;
    }
    ret res[u64, fail.Fail].ok{bits};
}

fun unknown_extension(a: *A.Allocator, arch_vt: *isa.IsaVTable, name: str) fail.Fail {
    val known_r: res[str, fail.Fail] = target_model.extension_names(a, arch_vt.model);
    if (sel known_r.err) { ret known_r.err; }
    val known: str = known_r.ok;
    fin { str_free(a, known); }
    val levels_r: res[str, fail.Fail] = target_model.level_names(a, arch_vt.model);
    if (sel levels_r.err) { ret levels_r.err; }
    val levels: str = levels_r.ok;
    fin { str_free(a, levels); }
    if (str_empty(levels)) {
        ret fail.formatted(a, "target: `{}` is not an extension of isa '{}'; its extensions are: {}", name, arch_vt.name, known);
    }
    ret fail.formatted(a, "target: `{}` is not an extension or level of isa '{}'; its extensions are: {}; its levels are: {}",
        name, arch_vt.name, known, levels);
}

# moves whenever the bytes a target fingerprints change meaning
val TARGET_FINGERPRINT_VERSION: u8 = 15;

fun b2u8(b: bool) u8 {
    if (b) { ret 1; }
    ret 0;
}

pub fun fingerprint(t: *binding.Binding, s: *wire.Sink) {
    build_fingerprint.put_domain_str(s, build_fingerprint.DOMAIN_ARCH, TARGET_FINGERPRINT_VERSION, t.target.env_name);

    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_ARCH, catalog_arch.VERSION, catalog_arch.fingerprint_tag(t.target.arch_id));
    build_fingerprint.put_domain_str(s, build_fingerprint.DOMAIN_ARCH, TARGET_FINGERPRINT_VERSION, t.isa.name);

    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_ABI, catalog_abi.VERSION, catalog_abi.fingerprint_tag(t.target.abi_id));
    build_fingerprint.put_domain_str(s, build_fingerprint.DOMAIN_ABI, TARGET_FINGERPRINT_VERSION, t.abi.name);
    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_ABI, TARGET_FINGERPRINT_VERSION, t.abi.passing);

    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_OS, catalog_os.VERSION, catalog_os.fingerprint_tag(t.target.os_id));
    build_fingerprint.put_domain_str(s, build_fingerprint.DOMAIN_OS, TARGET_FINGERPRINT_VERSION, t.os.name);

    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_OF, target_of.OF_FORMAT_CATALOG_VERSION, target_of.of_fingerprint_tag(t.of.id));
    build_fingerprint.put_domain_str(s, build_fingerprint.DOMAIN_OF, TARGET_FINGERPRINT_VERSION, t.of.name);

    build_fingerprint.put_domain_u32(s, build_fingerprint.DOMAIN_DEBUG, TARGET_FINGERPRINT_VERSION, t.target.debug_id);

    var backend_kind: u8 = 0;
    if (isa.emits_whole_module(t.isa)) { backend_kind = 1; }
    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_BACKEND, TARGET_FINGERPRINT_VERSION, backend_kind);

    build_fingerprint.put_domain_u64(s, build_fingerprint.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.target.base);
    build_fingerprint.put_domain_u64(s, build_fingerprint.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.target.page_size);
    build_fingerprint.put_domain_u64(s, build_fingerprint.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.target.stack_reserve);
    build_fingerprint.put_domain_u64(s, build_fingerprint.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.target.stack_commit);
    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, b2u8(t.target.variadic_args_on_stack));
    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, b2u8(t.target.fixed_args_natural_size));
    build_fingerprint.put_domain_u32(s, build_fingerprint.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.target.reg_arg_align);
    build_fingerprint.put_domain_u32(s, build_fingerprint.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.target.reg_arg_extend);
    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, b2u8(t.target.agg_arg_natural_align));
    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.abi.half);
    build_fingerprint.put_domain_u32(s, build_fingerprint.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.target.va_list_size);
    build_fingerprint.put_domain_u32(s, build_fingerprint.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.target.va_list_align);

    fingerprint_model(?t.target.model, s);
    fingerprint_fs_policy(?t.target.fs_policy, s);
}

fun fingerprint_fs_policy(p: *catalog_os.FsPolicy, s: *wire.Sink) {
    val d: build_fingerprint.Domain = build_fingerprint.DOMAIN_FS_POLICY;
    val v: u8                       = TARGET_FINGERPRINT_VERSION;

    build_fingerprint.put_domain_str(s, d, v, p.sysroot);
    build_fingerprint.put_domain_str(s, d, v, p.toolchain_root);
    build_fingerprint.put_domain_str(s, d, v, p.dynamic_interpreter);
    build_fingerprint.put_domain_str(s, d, v, p.platform_lib);
    build_fingerprint.put_domain_u32(s, d, v, p.libdir_len);

    var li: u32 = 0;
    for (li < p.libdir_len) {
        build_fingerprint.put_domain_str(s, d, v, p.libdirs[li]);
        li = li + 1;
    }
}

# a resolved model is the registered template, which the compiler build fixes,
# with the selection applied to it and the convention's stack rules over it;
# the template and the convention are named above, so the selection is what
# tells two models of one compiler apart, and no field of the model is mirrored
fun fingerprint_model(m: *target_model.Machine, s: *wire.Sink) {
    build_fingerprint.put_domain_u64(s, build_fingerprint.DOMAIN_TARGET_MODEL, TARGET_FINGERPRINT_VERSION, m.extensions);
}

fun default_of_name(reg: *TargetRegistry, os_vt: *lang_target_os.OsVTable, isa_vt: *isa.IsaVTable) opt[str] {
    if (!isa.emits_whole_module(isa_vt)) { ret opt[str].some{os_vt.default_of}; }
    var i: u32 = 0;
    for (i < reg.of.count) {
        val of_vt: *target_of.OfVTable = reg.of.members[i];
        if (of_vt.object_is_artifact && target_of.covers_isa(of_vt, isa_vt.id)) {
            ret opt[str].some{of_vt.name};
        }
        i = i + 1;
    }
    ret opt[str].none{};
}

fun no_module_format(a: *A.Allocator, isa_vt: *isa.IsaVTable) fail.Fail {
    ret fail.formatted(a, "instruction set '{}' emits whole modules, but no registered object format carries a finished module for it", isa_vt.name);
}

# the instruction set a selection names: the registered template with a riscv
# selection's extensions applied. model backs the returned vtable's model pointer
# and must outlive it
fun select_isa(arch_vt: *isa.IsaVTable, name: str, rv: extension_riscv.Selection, added: u64, model: *target_model.Machine) isa.IsaVTable {
    @model = @arch_vt.model;
    if (rv.width != 0) { model_riscv.features_select(model, extension_riscv.widen(rv.extensions, added)); }
    or                 { model.extensions = target_model.extension_close(model, model.extensions | added); }
    var selected: isa.IsaVTable = @arch_vt;
    selected.model = model;
    selected.name  = name;
    ret selected;
}

# the instruction set a [target.*] table selects by naming a registered isa: a
# riscv template narrowed to the default extension set its registered name
# parses to, every other template as registered. model backs the returned
# vtable's model pointer and must outlive it
pub fun registered_selection(arch_vt: *isa.IsaVTable, model: *target_model.Machine) isa.IsaVTable {
    var rv: extension_riscv.Selection;
    rv.width      = 0;
    rv.extensions = 0;
    if (extension_riscv.is_name(arch_vt.name)) {
        val parsed: res[extension_riscv.Selection, fail.Fail] = extension_riscv.parse(arch_vt.name);
        if (sel parsed.ok) { rv = parsed.ok; }
    }
    ret select_isa(arch_vt, arch_vt.name, rv, 0, model);
}

# the capability of one cell of the target matrix as a [target.*] table naming
# these four registered spellings composes it: the registered template alone
# overstates a riscv isa, whose default selection may lack the float registers
# an abi passes in
pub fun registered_tuple_capability(os_vt: *lang_target_os.OsVTable, arch_vt: *isa.IsaVTable, abi_vt: *abi.AbiVTable, of_vt: *target_of.OfVTable) u32 {
    var model:    target_model.Machine;
    val selected: isa.IsaVTable = registered_selection(arch_vt, ?model);
    ret tuple_capability(os_vt, ?selected, abi_vt, of_vt);
}

# the canonical selection string for an instruction set and the model selected
# on it (a resolved target's `model`, or the one registered_selection filled),
# written into buf: a riscv isa spells the extensions the model holds, every
# other isa its name
pub fun selection_spelling(isa_vt: *isa.IsaVTable, model: *target_model.Machine, buf: *u8, cap: usize) str {
    if (extension_riscv.is_name(isa_vt.name)) {
        ret extension_riscv.spell(model.gpr_width, model.extensions, buf, cap);
    }
    var off: usize = buf_put(buf, cap, 0, isa_vt.name);
    if (off >= cap) { off = cap - 1; }
    buf[off] = 0;
    ret buf::str;
}

# the request a `native` selection, or a [target.*] table naming the host
# without an object format, resolves: the host os, isa and abi by their
# registered names, the object format left to the os default
pub fun host_request() TargetRequest {
    ret target_request(catalog_arch.name_for(host_arch_id()), catalog_os.name_for(host_os_id()), catalog_abi.name_for(host_abi_id()));
}

pub fun select(reg: *TargetRegistry, isa_name: str, os_name: str, abi_name: str) res[binding.Binding, fail.Fail] {
    ret select_of(reg, isa_name, os_name, abi_name, "");
}

# the catalog every test selects from, composed on first use with the refusing
# debug model of target.testing in place of the backend's dwarf producer
#[testing]
var t_catalog: TargetRegistry;

# the test catalog; one that cannot be composed fails the test outright
#[testing]
pub fun t_registry() *TargetRegistry {
    if (!t_catalog.published) {
        t_catalog = registry_init();
        val composed: err[fail.Fail] = register_all(?t_catalog, ?target_testing.DEBUG);
        if (sel composed.err) { panic("target: the test catalog failed to compose\n"); }
    }
    ret ?t_catalog;
}

# the target `isa_name`, `os_name` and `abi_name` name, selected from the test catalog
#[testing]
pub fun t_select(isa_name: str, os_name: str, abi_name: str) res[binding.Binding, fail.Fail] {
    ret select(t_registry(), isa_name, os_name, abi_name);
}

pub fun artifact_naming(tgt: *binding.Binding, kind: catalog_artifact.Kind) res[target_of.ArtifactName, fail.Fail] {
    if (tgt == nil || tgt.of == nil || tgt.os == nil) {
        ret res[target_of.ArtifactName, fail.Fail].err{fail.message("artifact naming: target has no selected object format")};
    }
    ret target_of.artifact_naming(tgt.of, tgt.os.name, kind);
}

pub val TUPLE_OK:              u32 = 0;
#[testing]
val     COMPLETE_TUPLE_CENSUS: u32 = 27;
val     TUPLE_NO_CODEGEN:      u32 = 1;
val     TUPLE_ABI_MISMATCH:    u32 = 2;
val     TUPLE_OS_NO_OF:        u32 = 3;
val     TUPLE_OF_UNCOVERED:    u32 = 4;
val     TUPLE_OF_SHAPE:        u32 = 5;
val     TUPLE_OS_NO_ISA:       u32 = 6;
val     TUPLE_ABI_NEEDS_FLOAT: u32 = 7;
val     TUPLE_ABI_TRANSPORT:   u32 = 8;
val     TUPLE_OS_ABI:          u32 = 9;

#[testing]
rec TupleCapabilitySpec {
    code:  u32;
    label: str;
}

#[testing]
val TUPLE_CAPABILITY_N: usize                                   = 10;
#[testing]
val TUPLE_CAPABILITIES: [TUPLE_CAPABILITY_N]TupleCapabilitySpec = [TUPLE_CAPABILITY_N]TupleCapabilitySpec{
    TupleCapabilitySpec{code: TUPLE_OK, label: "ok"},
    TupleCapabilitySpec{code: TUPLE_NO_CODEGEN, label: "no_codegen"},
    TupleCapabilitySpec{code: TUPLE_ABI_MISMATCH, label: "abi_mismatch"},
    TupleCapabilitySpec{code: TUPLE_OS_NO_OF, label: "os_no_of"},
    TupleCapabilitySpec{code: TUPLE_OF_UNCOVERED, label: "of_uncovered"},
    TupleCapabilitySpec{code: TUPLE_OF_SHAPE, label: "of_shape"},
    TupleCapabilitySpec{code: TUPLE_OS_NO_ISA, label: "os_no_isa"},
    TupleCapabilitySpec{code: TUPLE_ABI_NEEDS_FLOAT, label: "abi_needs_float"},
    TupleCapabilitySpec{code: TUPLE_ABI_TRANSPORT, label: "abi_transport"},
    TupleCapabilitySpec{code: TUPLE_OS_ABI, label: "os_abi"},
};

fun tuple_capability(os_vt: *lang_target_os.OsVTable, isa_vt: *isa.IsaVTable, abi_vt: *abi.AbiVTable, of_vt: *target_of.OfVTable) u32 {
    if (!isa.has_codegen(isa_vt))           { ret TUPLE_NO_CODEGEN; }
    if (!abi.covers_isa(abi_vt, isa_vt.id)) { ret TUPLE_ABI_MISMATCH; }
    if (abi_vt.passing == catalog_abi.PASSING_VALUES) {
        if (!isa.emits_whole_module(isa_vt)) { ret TUPLE_ABI_TRANSPORT; }
    }
    or (abi_vt.passing == catalog_abi.PASSING_CARRIERS) {
        if (isa_vt.machine == nil) { ret TUPLE_ABI_TRANSPORT; }
    }
    or                                                              { ret TUPLE_ABI_TRANSPORT; }
    if (abi_vt.float_arg_bits > isa_vt.model.flen_bits)             { ret TUPLE_ABI_NEEDS_FLOAT; }
    if (!lang_target_os.supports_isa(os_vt, isa_vt.id))             { ret TUPLE_OS_NO_ISA; }
    if (!lang_target_os.supports_of(os_vt, of_vt.name))             { ret TUPLE_OS_NO_OF; }
    if (!target_of.covers_isa(of_vt, isa_vt.id))                    { ret TUPLE_OF_UNCOVERED; }
    if (isa.emits_whole_module(isa_vt) != of_vt.object_is_artifact) { ret TUPLE_OF_SHAPE; }
    if (!lang_target_os.accepts_abi(os_vt, isa_vt.id, abi_vt.name)) { ret TUPLE_OS_ABI; }
    ret TUPLE_OK;
}

fun tuple_refusal(a: *A.Allocator, code: u32, os_vt: *lang_target_os.OsVTable, isa_vt: *isa.IsaVTable, abi_vt: *abi.AbiVTable, of_vt: *target_of.OfVTable) fail.Fail {
    if (code == TUPLE_ABI_TRANSPORT) {
        if (abi_vt.passing == catalog_abi.PASSING_VALUES) { ret fail.message("calling convention passes logical values, which only a whole-module emitter can carry"); }
        ret fail.message("calling convention passes physical carriers, which only a register machine can carry");
    }
    if (code == TUPLE_NO_CODEGEN) {
        ret fail.formatted(a, "instruction set '{}' has no code generator in this build", isa_vt.name);
    }
    if (code == TUPLE_ABI_MISMATCH) {
        ret fail.formatted(a, "calling convention '{}' does not target instruction set '{}'", abi_vt.name, isa_vt.name);
    }
    if (code == TUPLE_ABI_NEEDS_FLOAT) {
        if (extension_riscv.is_name(isa_vt.name)) {
            val absent: u64 = extension_riscv.float_requirement(abi_vt.float_arg_bits) & ~isa_vt.model.extensions;
            if (absent != 0) {
                var noun: str = "extension";
                if ((absent & (absent - 1)) != 0) { noun = "extensions"; }
                ret fail.formatted(a,
                    "calling convention '{}' passes floating-point arguments in {}-bit float registers, but instruction set '{}' has {}-bit float registers: the selection lacks the {} {}",
                    abi_vt.name, abi_vt.float_arg_bits, isa_vt.name, isa_vt.model.flen_bits, extension_riscv.letters(absent), noun);
            }
        }
        ret fail.formatted(a,
            "calling convention '{}' passes floating-point arguments in {}-bit float registers, but instruction set '{}' has {}-bit float registers",
            abi_vt.name, abi_vt.float_arg_bits, isa_vt.name, isa_vt.model.flen_bits);
    }
    if (code == TUPLE_OS_NO_ISA) {
        ret fail.formatted(a, "operating system '{}' does not run on instruction set '{}'", os_vt.name, isa_vt.name);
    }
    if (code == TUPLE_OS_ABI) {
        var accepted: lang_target_os.AbiSet = lang_target_os.accepted_abis(os_vt, isa_vt.id);
        if (accepted.len == 0) {
            ret fail.formatted(a, "operating system '{}' declares no calling convention on instruction set '{}', so '{}' cannot host it",
                os_vt.name, catalog_arch.name_for(isa_vt.id), abi_vt.name);
        }
        if (accepted.len == 1) {
            ret fail.formatted(a, "operating system '{}' accepts calling convention '{}' on instruction set '{}', not '{}'",
                os_vt.name, accepted.names[0], catalog_arch.name_for(isa_vt.id), abi_vt.name);
        }
        var b:       textbuild.TextBuilder = textbuild.tb_init(a);
        val names_r: res[str, fail.Fail]   = target_model.spelling_finish(?b, quoted_names_append(?b, ?accepted.names[0], accepted.len));
        if (sel names_r.err) { ret names_r.err; }
        val names: str = names_r.ok;
        fin { str_free(a, names); }
        ret fail.formatted(a, "operating system '{}' accepts calling conventions {} on instruction set '{}', not '{}'",
            os_vt.name, names, catalog_arch.name_for(isa_vt.id), abi_vt.name);
    }
    if (code == TUPLE_OS_NO_OF) {
        ret fail.formatted(a, "operating system '{}' does not support object format '{}'", os_vt.name, of_vt.name);
    }
    if (code == TUPLE_OF_UNCOVERED) {
        ret fail.formatted(a, "object format '{}' does not cover {} relocations", of_vt.name, isa_vt.name);
    }
    if (code == TUPLE_OF_SHAPE) {
        var emits: str = "linkable objects";
        var takes: str = "finished modules";
        if (isa.emits_whole_module(isa_vt)) {
            emits = "finished modules";
            takes = "linkable objects";
        }
        ret fail.formatted(a, "instruction set '{}' emits {}, but object format '{}' carries {}", isa_vt.name, emits, of_vt.name, takes);
    }
    ret fail.formatted(a, "target: capability code {} names no refusal", code);
}

# `names`, each quoted, `, `-separated, appended to `b`
fun quoted_names_append(b: *textbuild.TextBuilder, names: *str, count: u32) err[textbuild.Error] {
    var i: u32 = 0;
    for (i < count) {
        if (i > 0) {
            val sep: err[textbuild.Error] = textbuild.tb_append(b, ", ");
            if (sel sep.err) { ret sep; }
        }
        val open: err[textbuild.Error] = textbuild.tb_append(b, "'");
        if (sel open.err) { ret open; }
        val named: err[textbuild.Error] = textbuild.tb_append(b, names[i]);
        if (sel named.err) { ret named; }
        val close: err[textbuild.Error] = textbuild.tb_append(b, "'");
        if (sel close.err) { ret close; }
        i = i + 1;
    }
    ret err[textbuild.Error].ok{};
}

#[testing]
val T_INCOMPLETE_DEBUG: target_of.DebugVTable = target_of.DebugVTable{id: target_of.DBG_DWARF, name: "dwarf", shape: target_of.DEBUG_SHAPE_SECTIONS};

test register_all__publishes_once_and_is_idempotent {
    var reg:   TargetRegistry = registry_init();
    val r_818: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel r_818.err)  { ret 1; }
    if (!reg.published) { ret 2; }

    val isa_count:   u32            = reg.isa.count;
    val os_count:    u32            = reg.os.count;
    val abi_count:   u32            = reg.abi.count;
    val of_count:    u32            = reg.of.count;
    val debug_count: u32            = reg.debug.count;
    val r_826:       err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel r_826.err) { ret 3; }
    if (reg.isa.count != isa_count || reg.os.count != os_count || reg.abi.count != abi_count
        || reg.of.count != of_count || reg.debug.count != debug_count) { ret 4; }
    ret 0;
}

test register_all__refuses_a_partial_registry {
    var reg:   TargetRegistry = registry_init();
    val r_835: err[fail.Fail] = target_registry.add[isa.IsaVTable](?reg.isa, ?reg.alloc, ?x64_register.VTABLE);
    if (sel r_835.err) { ret 1; }
    val r_837: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel r_837.ok)                        { ret 2; }
    if (reg.published || reg.isa.count != 1) { ret 3; }
    ret 0;
}

# a debug model missing its hooks is refused, and the registry it was refused
# into is never published
test register_all__an_incomplete_debug_model_is_refused {
    var reg: TargetRegistry = registry_init();
    val r:   err[fail.Fail] = register_all(?reg, ?T_INCOMPLETE_DEBUG);
    if (sel r.ok)      { ret 1; }
    if (reg.published) { ret 2; }
    var req: TargetRequest                   = target_request("x86_64", "linux", "sysv64");
    val t:   res[binding.Binding, fail.Fail] = resolve(?reg, ?req);
    if (sel t.ok) { ret 3; }
    ret 0;
}

test resolve__requires_a_published_registry_and_complete_request {
    var reg:   TargetRegistry                  = registry_init();
    var req:   TargetRequest                   = target_request("x86_64", "linux", "sysv64");
    val r_865: res[binding.Binding, fail.Fail] = resolve(nil, ?req);
    if (sel r_865.ok) { ret 1; }
    val r_866: res[binding.Binding, fail.Fail] = resolve(?reg, nil);
    if (sel r_866.ok) { ret 1; }
    val r_867: res[binding.Binding, fail.Fail] = resolve(?reg, ?req);
    if (sel r_867.ok) { ret 1; }
    ret 0;
}

# an isa whose machine maps no register to dwarf cannot take the dwarf model
test resolve__rejects_debug_and_isa_capability_mismatch {
    var reg:      TargetRegistry = registry_init();
    var machine:  isa.RegMachine = x64_register.MACHINE;
    var no_dwarf: isa.IsaVTable  = x64_register.VTABLE;
    machine.dwarf_reg = nil;
    no_dwarf.machine  = ?machine;
    val a_isa: err[fail.Fail] = target_registry.add[isa.IsaVTable](?reg.isa, ?reg.alloc, ?no_dwarf);
    val a_os:  err[fail.Fail] = target_registry.add[lang_target_os.OsVTable](?reg.os, ?reg.alloc, ?target_os_linux.VTABLE);
    val a_abi: err[fail.Fail] = target_registry.add[abi.AbiVTable](?reg.abi, ?reg.alloc, ?sysv.VTABLE);
    val a_of:  err[fail.Fail] = target_registry.add[target_of.OfVTable](?reg.of, ?reg.alloc, ?elf.VTABLE);
    val a_dbg: err[fail.Fail] = target_registry.add[target_of.DebugVTable](?reg.debug, ?reg.alloc, ?target_testing.DEBUG);
    if (sel a_isa.err || sel a_os.err || sel a_abi.err || sel a_of.err || sel a_dbg.err) { ret 1; }
    reg.published = true;

    var req:   TargetRequest                   = target_request("x86_64", "linux", "sysv64");
    val r_882: res[binding.Binding, fail.Fail] = resolve(?reg, ?req);
    if (sel r_882.ok) { ret 2; }
    ret 0;
}

test tuple_capability__a_hosted_os_constrains_the_abi_to_its_declared_set {
    var reg:   TargetRegistry = registry_init();
    val r_reg: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel r_reg.err) { ret 1; }

    val foreign: res[binding.Binding, fail.Fail] = select(?reg, "x86_64", "linux", "win64");
    if (sel foreign.ok)                                                                                                                                   { ret 2; }
    if (!str_equals(fail.describe(foreign.err), "operating system 'linux' accepts calling convention 'sysv64' on instruction set 'x86_64', not 'win64'")) { ret 3; }
    val darwin_foreign: res[binding.Binding, fail.Fail] = select(?reg, "x86_64", "darwin", "win64");
    if (sel darwin_foreign.ok) { ret 4; }
    val windows_foreign: res[binding.Binding, fail.Fail] = select(?reg, "x86_64", "windows", "sysv64");
    if (sel windows_foreign.ok) { ret 5; }
    val native: res[binding.Binding, fail.Fail] = select(?reg, "x86_64", "linux", "sysv64");
    if (sel native.err) { ret 6; }

    # linux declares the whole riscv64 psABI float family: the kernel abi is integer-only
    val soft: res[binding.Binding, fail.Fail] = select(?reg, "riscv64", "linux", "lp64");
    if (sel soft.err) { ret 7; }
    val single: res[binding.Binding, fail.Fail] = select(?reg, "riscv64", "linux", "lp64f");
    if (sel single.err) { ret 7; }

    # freestanding declares itself unconstrained, so every convention the isa covers stays legal
    val bare_win: res[binding.Binding, fail.Fail] = select(?reg, "x86_64", "freestanding", "win64");
    if (sel bare_win.err) { ret 8; }
    val bare_soft: res[binding.Binding, fail.Fail] = select(?reg, "riscv64", "freestanding", "lp64");
    if (sel bare_soft.err) { ret 9; }

    # the code is its own row, judged after every lower-level capability
    val opt_os:  opt[*lang_target_os.OsVTable] = target_registry.find[lang_target_os.OsVTable](?reg.os, "linux");
    val opt_isa: opt[*isa.IsaVTable]           = target_registry.find[isa.IsaVTable](?reg.isa, "x86_64");
    val opt_abi: opt[*abi.AbiVTable]           = target_registry.find[abi.AbiVTable](?reg.abi, "win64");
    val opt_of:  opt[*target_of.OfVTable]      = target_registry.find[target_of.OfVTable](?reg.of, "elf");
    if (sel opt_os.none)                                                                        { ret 10; }
    if (sel opt_isa.none)                                                                       { ret 10; }
    if (sel opt_abi.none)                                                                       { ret 10; }
    if (sel opt_of.none)                                                                        { ret 10; }
    if (tuple_capability(opt_os.some, opt_isa.some, opt_abi.some, opt_of.some) != TUPLE_OS_ABI) { ret 11; }

    # a multi-member set is named in full when refusing
    val opt_rv: opt[*isa.IsaVTable] = target_registry.find[isa.IsaVTable](?reg.isa, "riscv64");
    if (sel opt_rv.none) { ret 12; }
    var odd: abi.AbiVTable = target_testing.carriers_convention();
    odd.name    = "lp64x";
    odd.arch_id = catalog_arch.RISCV64;
    if (tuple_capability(opt_os.some, opt_rv.some, ?odd, opt_of.some) != TUPLE_OS_ABI) { ret 13; }
    if (!str_equals(fail.describe(tuple_refusal(?reg.alloc, TUPLE_OS_ABI, opt_os.some, opt_rv.some, ?odd, opt_of.some)),
        "operating system 'linux' accepts calling conventions 'lp64d', 'lp64', 'lp64f' on instruction set 'riscv64', not 'lp64x'")) { ret 14; }
    ret 0;
}

test tuple_capability_catalog__complete_unique_ordered {
    if (TUPLE_CAPABILITIES[0].code != TUPLE_OK)              { ret 1; }
    if (TUPLE_CAPABILITIES[1].code != TUPLE_NO_CODEGEN)      { ret 1; }
    if (TUPLE_CAPABILITIES[2].code != TUPLE_ABI_MISMATCH)    { ret 1; }
    if (TUPLE_CAPABILITIES[3].code != TUPLE_OS_NO_OF)        { ret 1; }
    if (TUPLE_CAPABILITIES[4].code != TUPLE_OF_UNCOVERED)    { ret 1; }
    if (TUPLE_CAPABILITIES[5].code != TUPLE_OF_SHAPE)        { ret 1; }
    if (TUPLE_CAPABILITIES[6].code != TUPLE_OS_NO_ISA)       { ret 1; }
    if (TUPLE_CAPABILITIES[7].code != TUPLE_ABI_NEEDS_FLOAT) { ret 1; }
    if (TUPLE_CAPABILITIES[8].code != TUPLE_ABI_TRANSPORT)   { ret 1; }
    if (TUPLE_CAPABILITIES[9].code != TUPLE_OS_ABI)          { ret 1; }

    var i: usize = 0;
    for (i < TUPLE_CAPABILITY_N) {
        var j: usize = 0;
        for (j < TUPLE_CAPABILITY_N) {
            if (i != j) {
                if (TUPLE_CAPABILITIES[i].code == TUPLE_CAPABILITIES[j].code)             { ret 1; }
                if (str_equals(TUPLE_CAPABILITIES[i].label, TUPLE_CAPABILITIES[j].label)) { ret 1; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

fun buf_put(buf: *u8, cap: usize, off: usize, s: str) usize {
    var i: usize = 0;
    val n: usize = str_len(s);
    var o: usize = off;
    for (i < n && o < cap - 1) {
        buf[o] = s[i];
        o      = o + 1;
        i      = i + 1;
    }
    ret o;
}

# the names an axis holds, `, `-separated, owned by the registry's allocator
fun registered_names[T](reg: *TargetRegistry, ax: *target_registry.Axis[T]) res[str, fail.Fail] {
    var b: textbuild.TextBuilder = textbuild.tb_init(?reg.alloc);
    ret target_model.spelling_finish(?b, registered_names_append[T](?b, ax));
}

fun registered_names_append[T](b: *textbuild.TextBuilder, ax: *target_registry.Axis[T]) err[textbuild.Error] {
    var i: u32 = 0;
    for (i < ax.count) {
        if (i > 0) {
            val sep: err[textbuild.Error] = textbuild.tb_append(b, ", ");
            if (sel sep.err) { ret sep; }
        }
        val named: err[textbuild.Error] = textbuild.tb_append(b, ax.name_of(ax.members[i]));
        if (sel named.err) { ret named; }
        i = i + 1;
    }
    ret err[textbuild.Error].ok{};
}

fun no_fs_policy(a: *A.Allocator, os_vt: *lang_target_os.OsVTable, arch_vt: *isa.IsaVTable) fail.Fail {
    ret fail.formatted(a, "no file-system policy declared for '{}-{}'", arch_vt.name, os_vt.name);
}

fun no_page_size(a: *A.Allocator, os_vt: *lang_target_os.OsVTable, arch_vt: *isa.IsaVTable, of_vt: *target_of.OfVTable) fail.Fail {
    ret fail.formatted(a, "object format '{}' is mapped by page, but neither '{}' nor '{}' declares a page size", of_vt.name, os_vt.name, arch_vt.name);
}

fun resolve_environment(a: *A.Allocator, arch_vt: *isa.IsaVTable, req: *TargetRequest) res[u32, fail.Fail] {
    if (str_empty(req.env_name)) { ret res[u32, fail.Fail].ok{isa.ENV_NONE}; }
    if (arch_vt.env_count == 0) {
        ret res[u32, fail.Fail].err{environment_refusal(a, req, arch_vt, "defines no environments; remove `env`")};
    }
    val id: u32 = isa.environment_lookup(arch_vt, req.env_name);
    if (id == isa.ENV_NONE) {
        ret res[u32, fail.Fail].err{environment_refusal(a, req, arch_vt, "does not define it")};
    }
    ret res[u32, fail.Fail].ok{id};
}

# a refused `env` named where the caller wrote it, with the environments the isa does define
fun environment_refusal(a: *A.Allocator, req: *TargetRequest, arch_vt: *isa.IsaVTable, why: str) fail.Fail {
    var b:       textbuild.TextBuilder = textbuild.tb_init(a);
    val known_r: res[str, fail.Fail]   = target_model.spelling_finish(?b, environment_names_append(?b, arch_vt));
    if (sel known_r.err) { ret known_r.err; }
    val known: str = known_r.ok;
    fin { str_free(a, known); }
    if (str_empty(req.env_origin)) {
        ret fail.formatted(a, "env \"{}\": isa '{}' {} (known: {})", req.env_name, arch_vt.name, why, known);
    }
    ret fail.formatted(a, "{}: isa '{}' {} (known: {})", req.env_origin, arch_vt.name, why, known);
}

# the isa's environment names, `, `-separated, or `none`, appended to `b`
fun environment_names_append(b: *textbuild.TextBuilder, arch_vt: *isa.IsaVTable) err[textbuild.Error] {
    if (arch_vt.env_count == 0) { ret textbuild.tb_append(b, "none"); }
    var i: u32 = 0;
    for (i < arch_vt.env_count) {
        if (i > 0) {
            val sep: err[textbuild.Error] = textbuild.tb_append(b, ", ");
            if (sel sep.err) { ret sep; }
        }
        val named: err[textbuild.Error] = textbuild.tb_append(b, arch_vt.envs[i].name);
        if (sel named.err) { ret named; }
        i = i + 1;
    }
    ret err[textbuild.Error].ok{};
}

# a refused RISC-V selection names the token it stumbled on and the whole string
fun selection_refusal(a: *A.Allocator, why: str, name: str, bad: *extension_riscv.Span) fail.Fail {
    if (bad.len == 0) { ret fail.formatted(a, "{}: selection '{}'", why, name); }
    val made: res[*u8, A.Error] = A.allocate[u8](a, bad.len + 1);
    if (sel made.err) { ret fail.refused(made.err); }
    val tok: *u8 = made.ok;
    fin { A.deallocate[u8](a, tok, bad.len + 1); }
    memory.raw_copy(tok::ptr, (?name[bad.at])::ptr, bad.len);
    tok[bad.len] = 0;
    ret fail.formatted(a, "{}: '{}' in selection '{}'", why, tok::str, name);
}

fun unregistered[T](reg: *TargetRegistry, ax: *target_registry.Axis[T], name: str) fail.Fail {
    val names_r: res[str, fail.Fail] = registered_names[T](reg, ax);
    if (sel names_r.err) { ret names_r.err; }
    val names: str = names_r.ok;
    fin { str_free(?reg.alloc, names); }
    ret fail.formatted(?reg.alloc, "no {} implementation registered for '{}' (registered: {})", ax.noun, name, names);
}

test registry_enumeration_agrees_with_lookup {
    var reg:     TargetRegistry = registry_init();
    val res_reg: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel res_reg.err) { ret 1; }

    if (reg.isa.count < 2) { ret 1; }
    if (reg.os.count < 3)  { ret 1; }
    if (reg.abi.count < 2) { ret 1; }
    if (reg.of.count < 3)  { ret 1; }

    var i:       u32 = 0;
    val isa_len: u32 = reg.isa.count;
    for (i < isa_len) {
        val opt_vt: opt[*isa.IsaVTable] = target_registry.at[isa.IsaVTable](?reg.isa, i);
        if (!sel opt_vt.some) { ret 1; }
        val r_1046: opt[*isa.IsaVTable] = target_registry.find[isa.IsaVTable](?reg.isa, opt_vt.some.name);
        if (!sel r_1046.some) { ret 1; }
        i = i + 1;
    }
    val r_1049: opt[*isa.IsaVTable] = target_registry.at[isa.IsaVTable](?reg.isa, isa_len);
    if (sel r_1049.some) { ret 1; }

    ret 0;
}

test elf_capable_isa_declares_a_reloc_seam {
    var reg:    TargetRegistry = registry_init();
    val r_1057: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel r_1057.err) { ret 1; }

    val len: u32 = reg.isa.count;
    if (len == 0) { ret 1; }

    var unpaired: u32 = 0;
    var seams:    u32 = 0;
    var i:        u32 = 0;
    for (i < len) {
        val vt_r: opt[*isa.IsaVTable] = target_registry.at[isa.IsaVTable](?reg.isa, i);
        if (sel vt_r.none) { ret 1; }
        val vt: *isa.IsaVTable = vt_r.some;

        if (vt.elf_machine != 0) {
            if (!isa.emits_relocations(vt))     { unpaired = unpaired + 1; }
            or (vt.reloc.apply == nil)          { unpaired = unpaired + 1; }
            or (vt.reloc.traits == nil)         { unpaired = unpaired + 1; }
            or (!vt.reloc.has_elf)              { unpaired = unpaired + 1; }
            or (vt.reloc.elf.reloc_type == nil) { unpaired = unpaired + 1; }
        }

        if (isa.emits_whole_module(vt) && isa.emits_relocations(vt)) { unpaired = unpaired + 1; }

        if (isa.emits_relocations(vt)) { seams = seams + 1; }
        i = i + 1;
    }

    if (unpaired != 0) { ret unpaired::i32; }

    if (seams != 4) { ret 1; }
    ret 0;
}

test tuple_capability__refuses_abi_needing_absent_float_extension {
    var reg:     TargetRegistry = registry_init();
    val res_reg: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel res_reg.err) { ret 1; }

    val opt_isa: opt[*isa.IsaVTable] = target_registry.find[isa.IsaVTable](?reg.isa, "riscv64");
    if (!sel opt_isa.some) { ret 1; }
    val isa_vt: *isa.IsaVTable = opt_isa.some;
    if (isa_vt.model.flen_bits != 64) { ret 1; }

    var quad: abi.AbiVTable = abi.AbiVTable{
        passing:               catalog_abi.PASSING_CARRIERS,
        name:                  "lp64q",
        arch_id:               catalog_arch.RISCV64,
        stack_align:           16,
        indirect_result_reg:   -1,
        fp_callee_saved_bytes: 8,
        float_arg_bits:        128,
        arg_slot_granularity:  8,
    };
    if (tuple_capability(nil, isa_vt, ?quad, nil) != TUPLE_ABI_NEEDS_FLOAT) { ret 1; }

    val opt_abi: opt[*abi.AbiVTable] = target_registry.find[abi.AbiVTable](?reg.abi, "lp64d");
    if (!sel opt_abi.some) { ret 1; }
    val d_vt: *abi.AbiVTable = opt_abi.some;
    if (d_vt.float_arg_bits != 64) { ret 1; }
    val ok: res[binding.Binding, fail.Fail] = select(?reg, "riscv64", "linux", "lp64d");
    if (sel ok.err) { ret 1; }
    val soft: res[binding.Binding, fail.Fail] = select(?reg, "riscv64", "linux", "lp64");
    if (sel soft.err) { ret 1; }
    ret 0;
}

test tuple_capability__refuses_a_standard_abi_a_narrower_isa_model_cannot_give {
    var reg:     TargetRegistry = registry_init();
    val res_reg: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel res_reg.err) { ret 1; }

    val opt_isa: opt[*isa.IsaVTable] = target_registry.find[isa.IsaVTable](?reg.isa, "riscv64");
    if (!sel opt_isa.some) { ret 1; }
    val real_isa: *isa.IsaVTable = opt_isa.some;

    val opt_abi: opt[*abi.AbiVTable] = target_registry.find[abi.AbiVTable](?reg.abi, "lp64d");
    if (!sel opt_abi.some) { ret 1; }
    val d_vt: *abi.AbiVTable = opt_abi.some;
    if (d_vt.float_arg_bits != 64) { ret 1; }

    var narrow_model: target_model.Machine = @real_isa.model;
    var narrow:       isa.IsaVTable        = @real_isa;
    narrow_model.flen_bits = 0;
    narrow.model           = ?narrow_model;
    if (tuple_capability(nil, ?narrow, d_vt, nil) != TUPLE_ABI_NEEDS_FLOAT) { ret 1; }

    var mid_model: target_model.Machine = @real_isa.model;
    var mid:       isa.IsaVTable        = @real_isa;
    mid_model.flen_bits = 32;
    mid.model           = ?mid_model;
    if (tuple_capability(nil, ?mid, d_vt, nil) != TUPLE_ABI_NEEDS_FLOAT) { ret 1; }
    ret 0;
}

