    if (sel te.err) { ret 1; }
    val et: resolved.Target = te.ok;
    if (et.debug == nil)             { ret 1; }
    if (et.debug_id != of.DBG_DWARF) { ret 1; }
    if (et.debug.id != of.DBG_DWARF) { ret 1; }

    val tc: res[resolved.Target, fail.Fail] = select_of(?reg, "x86_64", "windows", "win64", "coff");
    if (sel tc.err) { ret 1; }
    val ct: resolved.Target = tc.ok;
    if (ct.debug != nil)               { ret 1; }
    if (ct.debug_id != of.DBG_UNKNOWN) { ret 1; }
    ret 0;
}

test "mach.lang.target.abi_vtable:granularity_matches_its_classifier" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_2075: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2075.err) { ret 1; }

    var i: u32 = 0;
    for (i < reg.abi.count) {
        val vt: *abi.AbiVTable = ?reg.abi.entries[i];
        if (vt.passing == abi.PASSING_VALUES) {
            if (vt.arg_slot_granularity != 0 || vt.gp_arg_regs != nil
                || vt.callee_saved != nil || vt.va_model != nil || vt.arg_passing == nil) { ret 2; }
            val classify: abi.ArgPassingFn = vt.arg_passing;
            val logical:  abi.ParamSlot    = classify(0, 16, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
            if (logical.class != abi.CLASS_VALUE || logical.piece_count != 0 || logical.size != 16 || !mir.preg_is_nil(logical.reg)) { ret 3; }
            i = i + 1;
            cnt;
        }
        if (vt.arg_slot_granularity == 0) { ret 1; }
        if (vt.arg_passing == nil) {
            i = i + 1;
            cnt;
        }

        val fn:  abi.ArgPassingFn = vt.arg_passing;
        var agg: abi.AggLayout;
        agg.field_count = 0;
        val slot: abi.ParamSlot = fn(0, 16, 8, false, 0, true, false, 0, 0, 0, 0, agg);
        if (slot.piece_count == 2 && slot.pieces[1].kind == abi.PIECE_GP) {
            if (slot.pieces[1].src_off != vt.arg_slot_granularity::i64) { ret 1; }
        }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.target.resolve:bakes_image_overrides_into_construction" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_2109: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2109.err) { ret 1; }

    var req: TargetRequest = target_request("x86_64", "freestanding", "sysv64");
    with_image(?req, 0x400000, 0x100000, 0x1000);
    val r: res[resolved.Target, fail.Fail] = resolve(?reg, ?req);
    if (sel r.err) { ret 1; }
    val t: resolved.Target = r.ok;
    if (t.base != 0x400000)          { ret 1; }
    if (t.stack_reserve != 0x100000) { ret 1; }
    if (t.stack_commit != 0x1000)    { ret 1; }

    var req2: TargetRequest                   = target_request("x86_64", "freestanding", "sysv64");
    val r2:   res[resolved.Target, fail.Fail] = resolve(?reg, ?req2);
    if (sel r2.err) { ret 1; }
    val t2: resolved.Target = r2.ok;
    if (t2.base != 0)          { ret 1; }
    if (t2.stack_reserve != 0) { ret 1; }
    if (t2.stack_commit != 0)  { ret 1; }
    ret 0;
}

test "mach.lang.target.select_of:is_a_zero_image_request_to_resolve" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_2133: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2133.err) { ret 1; }

    val a: res[resolved.Target, fail.Fail] = select_of(?reg, "x86_64", "linux", "sysv64", "elf");
    if (sel a.err) { ret 1; }
    val ta: resolved.Target = a.ok;

    var req: TargetRequest = target_request("x86_64", "linux", "sysv64");
    with_of(?req, "elf");
    val b: res[resolved.Target, fail.Fail] = resolve(?reg, ?req);
    if (sel b.err) { ret 1; }
    val tb: resolved.Target = b.ok;

    if (ta.isa != tb.isa)                   { ret 1; }
    if (ta.abi != tb.abi)                   { ret 1; }
    if (ta.of != tb.of)                     { ret 1; }
    if (ta.base != tb.base || ta.base != 0) { ret 1; }
    ret 0;
}

fun fp_bytes_equal(a: *binary.Encoder, b: *binary.Encoder) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.target.fingerprint:stable_across_two_encodings_of_the_same_target" {
    var alloc:  A.Allocator;
    val r_2164: err[A.Error] = page.make(?alloc);
    if (sel r_2164.err) { ret 1; }
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_2167: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2167.err) { ret 1; }

    val ra: res[resolved.Target, fail.Fail] = select_of(?reg, "x86_64", "linux", "sysv64", "elf");
    val rb: res[resolved.Target, fail.Fail] = select_of(?reg, "x86_64", "linux", "sysv64", "elf");
    if (sel ra.err) { ret 1; }
    if (sel rb.err) { ret 1; }
    var ta: resolved.Target = ra.ok;
    var tb: resolved.Target = rb.ok;

    var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint(?ta, ?ea))    { ret 1; }
    if (!fingerprint(?tb, ?eb))    { ret 1; }
    if (!fp_bytes_equal(?ea, ?eb)) { ret 1; }
    if (ea.len == 0)               { ret 1; }

    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);
    ret 0;
}

test "mach.lang.target.fingerprint:sensitive_to_arch_abi_os_of_debug_backend_and_image" {
    var alloc:  A.Allocator;
    val r_2190: err[A.Error] = page.make(?alloc);
    if (sel r_2190.err) { ret 1; }
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_2193: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2193.err) { ret 1; }

    val base: res[resolved.Target, fail.Fail] = select_of(?reg, "x86_64", "linux", "sysv64", "elf");
    if (sel base.err) { ret 1; }
    var tbase: resolved.Target = base.ok;
    var ebase: binary.Encoder  = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint(?tbase, ?ebase)) { ret 1; }

    var value_abi: abi.AbiVTable = @tbase.abi;
    value_abi.passing = abi.PASSING_VALUES;
    var value_target: resolved.Target = tbase;
    value_target.abi = ?value_abi;
    var e_value: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    fin { binary.encoder_dnit(?e_value); }
    if (!fingerprint(?value_target, ?e_value) || fp_bytes_equal(?ebase, ?e_value))          { ret 2; }
    if (tuple_capability(tbase.os, tbase.isa, ?value_abi, tbase.of) != TUPLE_ABI_TRANSPORT) { ret 3; }

    var td_page: resolved.Target = tbase;
    td_page.page_size = tbase.page_size * 2;
    var e_page: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint(?td_page, ?e_page)) { ret 1; }
    if (fp_bytes_equal(?ebase, ?e_page)) { ret 1; }

    val diff_arch: res[resolved.Target, fail.Fail] = select_of(?reg, "aarch64", "linux", "aapcs64", "elf");
    if (sel diff_arch.err) { ret 1; }
    var td_arch: resolved.Target = diff_arch.ok;
    var e_arch:  binary.Encoder  = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint(?td_arch, ?e_arch)) { ret 1; }
    if (fp_bytes_equal(?ebase, ?e_arch)) { ret 1; }

    val diff_of: res[resolved.Target, fail.Fail] = select_of(?reg, "x86_64", "freestanding", "sysv64", "raw");
    val same_of: res[resolved.Target, fail.Fail] = select_of(?reg, "x86_64", "freestanding", "sysv64", "elf");
    if (sel diff_of.err) { ret 1; }
    if (sel same_of.err) { ret 1; }
    var td_of:    resolved.Target = diff_of.ok;
    var ts_of:    resolved.Target = same_of.ok;
    var e_of_raw: binary.Encoder  = binary.encoder(?alloc, binary.LITTLE);
    var e_of_elf: binary.Encoder  = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint(?td_of, ?e_of_raw))      { ret 1; }
    if (!fingerprint(?ts_of, ?e_of_elf))      { ret 1; }
    if (fp_bytes_equal(?e_of_raw, ?e_of_elf)) { ret 1; }

    val diff_os: res[resolved.Target, fail.Fail] = select_of(?reg, "x86_64", "darwin", "sysv64", "");
    if (sel diff_os.err) { ret 1; }
    var td_os: resolved.Target = diff_os.ok;
    var e_os:  binary.Encoder  = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint(?td_os, ?e_os))   { ret 1; }
    if (fp_bytes_equal(?ebase, ?e_os)) { ret 1; }

    val diff_backend: res[resolved.Target, fail.Fail] = select_of(?reg, "spirv", "freestanding", "spirv", "spv");
    if (sel diff_backend.err) { ret 1; }
    var td_backend: resolved.Target = diff_backend.ok;
    var e_backend:  binary.Encoder  = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint(?td_backend, ?e_backend)) { ret 1; }
    if (fp_bytes_equal(?ebase, ?e_backend))    { ret 1; }

    var req_a: TargetRequest = target_request("x86_64", "freestanding", "sysv64");
    with_image(?req_a, 0x400000, 0, 0);
    var req_b: TargetRequest = target_request("x86_64", "freestanding", "sysv64");
    with_image(?req_b, 0x500000, 0, 0);
    val ria: res[resolved.Target, fail.Fail] = resolve(?reg, ?req_a);
    val rib: res[resolved.Target, fail.Fail] = resolve(?reg, ?req_b);
    if (sel ria.err) { ret 1; }
    if (sel rib.err) { ret 1; }
    var tia:  resolved.Target = ria.ok;
    var tib:  resolved.Target = rib.ok;
    var e_ia: binary.Encoder  = binary.encoder(?alloc, binary.LITTLE);
    var e_ib: binary.Encoder  = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint(?tia, ?e_ia))    { ret 1; }
    if (!fingerprint(?tib, ?e_ib))    { ret 1; }
    if (fp_bytes_equal(?e_ia, ?e_ib)) { ret 1; }

    binary.encoder_dnit(?ebase);
    binary.encoder_dnit(?e_page);
    binary.encoder_dnit(?e_arch);
    binary.encoder_dnit(?e_of_raw);
    binary.encoder_dnit(?e_of_elf);
    binary.encoder_dnit(?e_os);
    binary.encoder_dnit(?e_backend);
    binary.encoder_dnit(?e_ia);
    binary.encoder_dnit(?e_ib);
    ret 0;
}

test "mach.lang.target.fingerprint_model:sensitive_to_every_declared_field" {
    var alloc:  A.Allocator;
    val r_2279: err[A.Error] = page.make(?alloc);
    if (sel r_2279.err) { ret 1; }

    var base: isa.MachineModel;
    base.pointer_width          = 8;
    base.gpr_width              = 8;
    base.max_alu_width          = 8;
    base.alu_min_width          = 4;
    base.spill_width            = 8;
    base.endianness             = isa.ENDIAN_LITTLE;
    base.reg_class_len          = 0;
    base.frame_ptr_reg          = 6;
    base.stack_ptr_reg          = 7;
    base.reserved_len           = 0;
    base.div_reg                = -1;
    base.div_hi_reg             = -1;
    base.shift_count_reg        = -1;
    base.incoming_arg_base      = 16;
    base.stack_align            = 16;
    base.red_zone               = 128;
    base.shadow_space           = 0;
    base.has_v128               = true;
    base.vector_bits            = 128;
    base.max_vector_lanes       = isa.VECTOR_LANES_UNBOUNDED;
    base.vector_compute_generic = false;
    base.has_lane_ops           = true;
    base.has_vec_build          = true;
    base.vec_mem_widths         = isa.VEC_MEM_ALL_128;
    base.xbank_widths           = isa.XBANK_4_8;
    base.ct_trust_mul           = true;
    base.has_var_shift          = true;
    base.has_mul                = true;
    base.has_float              = true;
    base.mul_hi_width           = 8;
    base.flat_addressing        = false;
    base.ct_trust_var_shift     = true;
    base.packed_form_len        = 0;
    base.flen_bits              = 64;
    base.riscv_extensions       = 0;

    val eb0: binary.Encoder = fp_encode_model(?alloc, ?base);
    if (eb0.len == 0) { ret 1; }

    var m: isa.MachineModel = base;
    m.pointer_width = 4;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m           = base;
    m.gpr_width = 4;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m               = base;
    m.max_alu_width = 4;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m               = base;
    m.alu_min_width = 1;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m             = base;
    m.spill_width = 4;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m            = base;
    m.endianness = isa.ENDIAN_BIG;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m               = base;
    m.frame_ptr_reg = 5;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m               = base;
    m.stack_ptr_reg = 4;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m         = base;
    m.div_reg = 0;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m            = base;
    m.div_hi_reg = 0;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m                 = base;
    m.shift_count_reg = 0;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m                   = base;
    m.incoming_arg_base = 0;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m             = base;
    m.stack_align = 8;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m          = base;
    m.red_zone = 0;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m              = base;
    m.shadow_space = 32;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m          = base;
    m.has_v128 = false;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m             = base;
    m.vector_bits = 256;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m                  = base;
    m.max_vector_lanes = 4;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m                        = base;
    m.vector_compute_generic = true;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m              = base;
    m.has_lane_ops = false;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m               = base;
    m.has_vec_build = false;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m                = base;
    m.vec_mem_widths = isa.VEC_MEM_NONE;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m              = base;
    m.xbank_widths = isa.XBANK_NONE;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m              = base;
    m.ct_trust_mul = false;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m               = base;
    m.has_var_shift = false;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m         = base;
    m.has_mul = false;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m           = base;
    m.has_float = false;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m              = base;
    m.mul_hi_width = 4;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m                 = base;
    m.flat_addressing = true;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m                     = base;
    m.gp_unaligned_widths = 2 + 8;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m                    = base;
    m.ct_trust_var_shift = false;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m           = base;
    m.flen_bits = 32;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    m                  = base;
    m.riscv_extensions = rvfeatures.I;
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }

    var rc: [1]isa.RegClass;
    rc[0].name      = "gpr";
    rc[0].kind      = isa.RC_GENERAL;
    rc[0].len       = 16;
    m               = base;
    m.reg_class_len = 1;
    m.reg_classes   = ?rc[0];
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }
    var rc2: [1]isa.RegClass;
    rc2[0].name = "gpr";
    rc2[0].kind = isa.RC_GENERAL;
    rc2[0].len  = 8;
    var m2: isa.MachineModel = base;
    m2.reg_class_len = 1;
    m2.reg_classes   = ?rc2[0];
    if (fp_model_equal_pair(?alloc, ?m, ?m2)) { ret 1; }

    var rr: [1]isa.Register;
    rr[0].id        = 0;
    rr[0].size      = 8;
    m               = base;
    m.reserved_len  = 1;
    m.reserved_regs = ?rr[0];
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }

    var pg: [1]isa.PackedForm;
    pg[0].op          = isa.VEC_OP_MUL;
    pg[0].is_float    = false;
    pg[0].lane_bits   = 32;
    m                 = base;
    m.packed_form_len = 1;
    m.packed_forms    = ?pg[0];
    if (fp_model_equal(?alloc, ?base, ?m)) { ret 1; }

    ret 0;
}

fun fp_encode_model(alloc: *A.Allocator, m: *isa.MachineModel) binary.Encoder {
    var e:  binary.Encoder = binary.encoder(alloc, binary.LITTLE);
    val ok: bool           = fingerprint_model(m, ?e);
    if (!ok) { panic("fp_encode_model: encoding failed\n"); }
    ret e;
}

fun fp_model_equal(alloc: *A.Allocator, a: *isa.MachineModel, b: *isa.MachineModel) bool {
    ret fp_model_equal_pair(alloc, a, b);
}

fun fp_model_equal_pair(alloc: *A.Allocator, a: *isa.MachineModel, b: *isa.MachineModel) bool {
    var ea: binary.Encoder = fp_encode_model(alloc, a);
    var eb: binary.Encoder = fp_encode_model(alloc, b);
    val eq: bool           = fp_bytes_equal(?ea, ?eb);
    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);
    ret eq;
}

test "mach.lang.target.artifact_naming:every_registered_object_format_has_a_total_object_and_executable_row" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_2376: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2376.err) { ret 1; }

    var bad: i32 = 0;
    var i:   u32 = 0;
    for (i < reg.of.count) {
        val vt: *of.OfVTable = ?reg.of.entries[i];

        val obj_r: res[of.ArtifactName, fail.Fail] = of.artifact_naming(vt, "linux", of.ARTIFACT_OBJECT);
        if (sel obj_r.err) { bad = 1; }
        or (sel obj_r.ok) {
            val an: of.ArtifactName = obj_r.ok;
            if (str_len(an.suffix) > 0 && an.suffix[0] != '.') { bad = 1; }
        }

        val exe_linux_r: res[of.ArtifactName, fail.Fail] = of.artifact_naming(vt, "linux", of.ARTIFACT_EXECUTABLE);
        if (sel exe_linux_r.err) { bad = 1; }
        val exe_win_r: res[of.ArtifactName, fail.Fail] = of.artifact_naming(vt, "windows", of.ARTIFACT_EXECUTABLE);
        if (sel exe_win_r.err) { bad = 1; }
        or (sel exe_win_r.ok) {
            val an: of.ArtifactName = exe_win_r.ok;
            if (!vt.object_is_artifact && !vt.produces_image && !str_equals(an.suffix, ".exe")) { bad = 1; }
        }
        i = i + 1;
    }
    ret bad;
}

test "mach.lang.target.artifact_naming:elf_coff_macho_conventional_names" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_2406: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2406.err) { ret 1; }

    var bad: i32 = 0;

    val elf_o: opt[*of.OfVTable] = of.lookup(?reg.of, "elf");
    if (sel elf_o.none) { ret 1; }
    val elf_vt:       *of.OfVTable                    = elf_o.some;
    val elf_static_r: res[of.ArtifactName, fail.Fail] = of.artifact_naming(elf_vt, "linux", of.ARTIFACT_STATIC_LIB);
    if (sel elf_static_r.err) { ret 1; }
    val elf_static: of.ArtifactName = elf_static_r.ok;
    if (!str_equals(elf_static.prefix, "lib") || !str_equals(elf_static.suffix, ".a")) { bad = 1; }
    val elf_shared_r: res[of.ArtifactName, fail.Fail] = of.artifact_naming(elf_vt, "linux", of.ARTIFACT_SHARED_LIB);
    if (sel elf_shared_r.err) { ret 1; }
    val elf_shared: of.ArtifactName = elf_shared_r.ok;
    if (!str_equals(elf_shared.prefix, "lib") || !str_equals(elf_shared.suffix, ".so")) { bad = 1; }

    val macho_o: opt[*of.OfVTable] = of.lookup(?reg.of, "macho");
    if (sel macho_o.none) { ret 1; }
    val macho_vt:       *of.OfVTable                    = macho_o.some;
    val macho_shared_r: res[of.ArtifactName, fail.Fail] = of.artifact_naming(macho_vt, "darwin", of.ARTIFACT_SHARED_LIB);
    if (sel macho_shared_r.err) { ret 1; }
    val macho_shared: of.ArtifactName = macho_shared_r.ok;
    if (!str_equals(macho_shared.prefix, "lib") || !str_equals(macho_shared.suffix, ".dylib")) { bad = 1; }

    val coff_o: opt[*of.OfVTable] = of.lookup(?reg.of, "coff");
    if (sel coff_o.none) { ret 1; }
    val coff_vt:           *of.OfVTable                    = coff_o.some;
    val coff_static_win_r: res[of.ArtifactName, fail.Fail] = of.artifact_naming(coff_vt, "windows", of.ARTIFACT_STATIC_LIB);
    if (sel coff_static_win_r.err) { ret 1; }
    val coff_static_win: of.ArtifactName = coff_static_win_r.ok;
    if (!str_empty(coff_static_win.prefix) || !str_equals(coff_static_win.suffix, ".lib")) { bad = 1; }
    val coff_shared_r: res[of.ArtifactName, fail.Fail] = of.artifact_naming(coff_vt, "windows", of.ARTIFACT_SHARED_LIB);
    if (sel coff_shared_r.err) { ret 1; }
    val coff_shared: of.ArtifactName = coff_shared_r.ok;
    if (!str_empty(coff_shared.prefix) || !str_equals(coff_shared.suffix, ".dll")) { bad = 1; }
    val coff_exe_r: res[of.ArtifactName, fail.Fail] = of.artifact_naming(coff_vt, "windows", of.ARTIFACT_EXECUTABLE);
    if (sel coff_exe_r.err) { ret 1; }
    val coff_exe: of.ArtifactName = coff_exe_r.ok;
    if (!str_equals(coff_exe.suffix, ".exe")) { bad = 1; }

    ret bad;
}

