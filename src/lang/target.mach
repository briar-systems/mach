    ret 0;
}

test fingerprint_fs_policy__isolated_to_declared_policy_fields {
    var alloc:  A.Allocator;
    val r_1279: err[A.Error] = page.make(?alloc);
    if (sel r_1279.err) { ret 1; }
    var bad: bool = false;

    var pa: catalog_os.FsPolicy;
    pa.sysroot             = "";
    pa.toolchain_root      = "";
    pa.dynamic_interpreter = "/lib64/ld-linux-x86-64.so.2";
    pa.platform_lib        = "";
    pa.libdirs[0]          = "/lib64";
    pa.libdir_len          = 1;

    var pb: catalog_os.FsPolicy = pa;
    pb.dynamic_interpreter = "/lib/ld-linux-aarch64.so.1";

    var ea: wire.Sink = wire.grown(?alloc);
    var eb: wire.Sink = wire.grown(?alloc);
    fingerprint_fs_policy(?pa, ?ea);
    fingerprint_fs_policy(?pb, ?eb);
    if (t_same_bytes(?ea, ?eb)) { bad = true; }
    if (ea.len == 0)            { bad = true; }

    var ea2: wire.Sink = wire.grown(?alloc);
    fingerprint_fs_policy(?pa, ?ea2);
    if (!t_same_bytes(?ea, ?ea2)) { bad = true; }

    wire.dnit(?ea);
    wire.dnit(?eb);
    wire.dnit(?ea2);
    if (bad) { ret 1; }
    ret 0;
}

test select__c_variadic_stack_is_per_os_and_isa {
    var reg:    TargetRegistry = registry_init();
    val r_1314: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel r_1314.err) { ret 1; }

    val da: res[binding.Binding, fail.Fail] = select(?reg, "aarch64", "darwin", "aapcs64");
    if (sel da.err)                           { ret 1; }
    if (!da.ok.target.variadic_args_on_stack) { ret 1; }

    val la: res[binding.Binding, fail.Fail] = select(?reg, "aarch64", "linux", "aapcs64");
    if (sel la.err)                          { ret 1; }
    if (la.ok.target.variadic_args_on_stack) { ret 1; }
    if (da.ok.abi != la.ok.abi)              { ret 1; }

    val dx: res[binding.Binding, fail.Fail] = select(?reg, "x86_64", "darwin", "sysv64");
    if (sel dx.err)                          { ret 1; }
    if (dx.ok.target.variadic_args_on_stack) { ret 1; }

    val lx: res[binding.Binding, fail.Fail] = select(?reg, "x86_64", "linux", "sysv64");
    if (sel lx.err)                          { ret 1; }
    if (lx.ok.target.variadic_args_on_stack) { ret 1; }

    ret 0;
}

test select__fixed_stack_arg_size_is_per_os_and_isa {
    var reg:    TargetRegistry = registry_init();
    val r_1339: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel r_1339.err) { ret 1; }

    val da: res[binding.Binding, fail.Fail] = select(?reg, "aarch64", "darwin", "aapcs64");
    if (sel da.err)                            { ret 1; }
    if (!da.ok.target.fixed_args_natural_size) { ret 1; }

    val la: res[binding.Binding, fail.Fail] = select(?reg, "aarch64", "linux", "aapcs64");
    if (sel la.err)                           { ret 1; }
    if (la.ok.target.fixed_args_natural_size) { ret 1; }

    val dx: res[binding.Binding, fail.Fail] = select(?reg, "x86_64", "darwin", "sysv64");
    if (sel dx.err)                           { ret 1; }
    if (dx.ok.target.fixed_args_natural_size) { ret 1; }

    val lx: res[binding.Binding, fail.Fail] = select(?reg, "x86_64", "linux", "sysv64");
    if (sel lx.err)                           { ret 1; }
    if (lx.ok.target.fixed_args_natural_size) { ret 1; }

    if (!da.ok.target.variadic_args_on_stack) { ret 1; }

    ret 0;
}

# darwin starts a 16-byte aligned argument in any x register; linux keeps
# AAPCS64's even pair and x86_64 has no such rule on either system
test select__register_argument_alignment_is_per_os_and_isa {
    var reg:        TargetRegistry = registry_init();
    val registered: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel registered.err) { ret 1; }

    val da: res[binding.Binding, fail.Fail] = select(?reg, "aarch64", "darwin", "aapcs64");
    if (sel da.err)                      { ret 2; }
    if (da.ok.target.reg_arg_align != 8) { ret 3; }

    val la: res[binding.Binding, fail.Fail] = select(?reg, "aarch64", "linux", "aapcs64");
    if (sel la.err)                      { ret 4; }
    if (la.ok.target.reg_arg_align != 0) { ret 5; }
    if (da.ok.abi != la.ok.abi)          { ret 6; }

    val dx: res[binding.Binding, fail.Fail] = select(?reg, "x86_64", "darwin", "sysv64");
    if (sel dx.err)                      { ret 7; }
    if (dx.ok.target.reg_arg_align != 0) { ret 8; }

    ret 0;
}

test backend_target__uses_resolved_image_base_and_arch_page_size {
    var reg:    TargetRegistry = registry_init();
    val r_1365: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel r_1365.err) { ret 1; }

    var bad: bool          = false;
    var req: TargetRequest = target_request("aarch64", "linux", "aapcs64");
    with_image(?req, 0x12345000, 0, 0);
    val lr: res[binding.Binding, fail.Fail] = resolve(?reg, ?req);
    if (sel lr.err) { bad = true; }
    or (sel lr.ok) {
        var lt: binding.Binding   = lr.ok;
        val lv: isa.BackendTarget = binding.backend_target(?lt);
        if (lv.os.image_base != 0x12345000) { bad = true; }
        if (lv.os.page_size != 65536)       { bad = true; }
    }

    val dr: res[binding.Binding, fail.Fail] = select(?reg, "aarch64", "darwin", "aapcs64");
    if (sel dr.err) { bad = true; }
    or (sel dr.ok) {
        var dt: binding.Binding   = dr.ok;
        val dv: isa.BackendTarget = binding.backend_target(?dt);
        if (dv.os.image_base != target_os_darwin.DARWIN_BASE_ADDR) { bad = true; }
        if (dv.os.page_size != 16384)                              { bad = true; }
    }

    if (bad) { ret 1; }
    ret 0;
}

test select__linux_riscv64 {
    var reg:     TargetRegistry = registry_init();
    val res_reg: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel res_reg.err) { ret 1; }

    val res_target: res[binding.Binding, fail.Fail] = select_of(?reg, "riscv64", "linux", "lp64d", "");
    if (sel res_target.err) { ret 1; }
    val t: binding.Binding = res_target.ok;

    if (t.arch == nil)                    { ret 1; }
    if (t.isa.id != catalog_arch.RISCV64) { ret 1; }
    if (t.isa.elf_machine != 243)         { ret 1; }
    if (t.isa.pointer_width != 8)         { ret 1; }

    if (t.arch.select == nil)                 { ret 1; }
    if (t.arch.encode.encode_function == nil) { ret 1; }

    if (t.target.model.pointer_width != 8)                       { ret 1; }
    if (t.target.model.gpr_width != 8)                           { ret 1; }
    if (t.target.model.endianness != target_model.ENDIAN_LITTLE) { ret 1; }
    if (t.target.model.reg_class_len != 2)                       { ret 1; }

    var gp_len: u32 = 0;
    var fp_len: u32 = 0;
    var ci:     u32 = 0;
    for (ci < t.target.model.reg_class_len) {
        if (t.target.model.reg_classes[ci].kind == target_model.RC_GENERAL) { gp_len = t.target.model.reg_classes[ci].len; }
        if (t.target.model.reg_classes[ci].kind == target_model.RC_FLOAT)   { fp_len = t.target.model.reg_classes[ci].len; }
        ci = ci + 1;
    }
    if (gp_len != 32) { ret 1; }
    if (fp_len != 30) { ret 1; }

    var x0_reserved: bool = false;
    var ri:          i32  = 0;
    for (ri < t.arch.reserved_reg_count) {
        if (t.arch.reserved_regs[ri].id == 0) { x0_reserved = true; }
        ri = ri + 1;
    }
    if (!x0_reserved) { ret 1; }

    if (t.arch.frame_ptr_reg != 8) { ret 1; }
    if (t.arch.stack_ptr_reg != 2) { ret 1; }

    if (t.abi == nil)                  { ret 1; }
    if (t.abi.id != catalog_abi.LP64D) { ret 1; }
    val arg: abi.ArgPassingFn = t.abi.arg_passing;
    val ai:  abi.ParamSlot    = arg(0, 8, 8, false, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 16);
    if (ai.class != abi.CLASS_GP)          { ret 1; }
    if (lang_mir.preg_regid(ai.reg) != 10) { ret 1; }
    val af: abi.ParamSlot = arg(0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 16);
    if (af.class != abi.CLASS_FP)                                                         { ret 1; }
    if (lang_mir.preg_regid(af.reg) != isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 10)) { ret 1; }
    val rp: abi.RetPassingFn = t.abi.ret_passing;
    val rr: abi.ParamSlot    = rp(8, 8, false, 0, false, false, 0, 0, abi.agg_none(), 16);
    if (rr.class != abi.CLASS_GP)          { ret 1; }
    if (lang_mir.preg_regid(rr.reg) != 10) { ret 1; }

    ret 0;
}

test select__riscv32_freestanding_raw {
    var reg:     TargetRegistry = registry_init();
    val res_reg: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel res_reg.err) { ret 1; }

    val res_target: res[binding.Binding, fail.Fail] = select(?reg, "rv32imafdc", "freestanding", "ilp32d");
    if (sel res_target.err) { ret 1; }
    val t: binding.Binding = res_target.ok;

    if (t.arch == nil)                        { ret 1; }
    if (t.isa.id != catalog_arch.RISCV32)     { ret 1; }
    if (t.isa.elf_machine != 243)             { ret 1; }
    if (t.isa.pointer_width != 4)             { ret 1; }
    if (t.arch.select == nil)                 { ret 1; }
    if (t.arch.encode.encode_function == nil) { ret 1; }

    if (t.target.model.pointer_width != 4)                { ret 1; }
    if (t.target.model.gpr_width != 4)                    { ret 1; }
    if (target_model.max_alu_width(?t.target.model) != 4) { ret 1; }
    if (t.target.model.spill_width != 4)                  { ret 1; }
    if (target_model.alu_min_width(?t.target.model) != 4) { ret 1; }
    if (t.target.model.flen_bits != 64)                   { ret 1; }

    if (t.target.model.reg_class_len != 2) { ret 1; }
    var gp_len: u32 = 0;
    var fp_len: u32 = 0;
    var ci:     u32 = 0;
    for (ci < t.target.model.reg_class_len) {
        if (t.target.model.reg_classes[ci].kind == target_model.RC_GENERAL) { gp_len = t.target.model.reg_classes[ci].len; }
        if (t.target.model.reg_classes[ci].kind == target_model.RC_FLOAT)   { fp_len = t.target.model.reg_classes[ci].len; }
        ci = ci + 1;
    }
    if (gp_len != 32)              { ret 1; }
    if (fp_len != 30)              { ret 1; }
    if (t.arch.frame_ptr_reg != 8) { ret 1; }
    if (t.arch.stack_ptr_reg != 2) { ret 1; }

    val res64: res[binding.Binding, fail.Fail] = select_of(?reg, "riscv64", "linux", "lp64d", "");
    if (sel res64.err) { ret 1; }
    val t64: binding.Binding = res64.ok;
    if (t64.target.model.gpr_width != 8) { ret 1; }
    if (t.target.model.gpr_width != 4)   { ret 1; }

    if (t.abi == nil)                    { ret 1; }
    if (t.abi.id != catalog_abi.ILP32D)  { ret 1; }
    if (t.abi.arg_slot_granularity != 4) { ret 1; }
    val arg: abi.ArgPassingFn = t.abi.arg_passing;
    val ai:  abi.ParamSlot    = arg(0, 4, 4, false, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 16);
    if (ai.class != abi.CLASS_GP)          { ret 1; }
    if (lang_mir.preg_regid(ai.reg) != 10) { ret 1; }
    val af: abi.ParamSlot = arg(0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 16);
    if (af.class != abi.CLASS_FP)                                                         { ret 1; }
    if (lang_mir.preg_regid(af.reg) != isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 10)) { ret 1; }

    if (t.of == nil)                         { ret 1; }
    if (!str_equals(t.os.default_of, "raw")) { ret 1; }

    val small_r: res[binding.Binding, fail.Fail] = select(?reg, "rv32imc", "freestanding", "ilp32");
    if (sel small_r.err) { ret 2; }
    val small: binding.Binding = small_r.ok;
    if (small.target.model.extensions != (extension_riscv.I | extension_riscv.M | extension_riscv.C)
        || small.target.model.has_float || small.target.model.flen_bits != 0 || small.target.model.reg_class_len != 1
        || !small.target.model.has_mul || extension_riscv.has(small.target.model.extensions, extension_riscv.A)) { ret 3; }
    val small_d: res[binding.Binding, fail.Fail] = select(?reg, "rv32imc", "freestanding", "ilp32d");
    if (sel small_d.ok)                                       { ret 4; }
    if (!str_contains(fail.describe(small_d.err), "rv32imc")) { ret 4; }
    val r_1522: res[binding.Binding, fail.Fail] = select(?reg, "riscv32", "freestanding", "ilp32f");
    if (sel r_1522.ok) { ret 5; }
    val default_r: res[binding.Binding, fail.Fail] = select(?reg, "riscv32", "freestanding", "ilp32");
    if (sel default_r.err)                                                 { ret 6; }
    if (default_r.ok.target.model.extensions != extension_riscv.DEFAULT32) { ret 7; }
    if (t.target.model.flen_bits != 64 || t.target.model.reg_class_len != 2
        || t.isa != small.isa || small.target.model.flen_bits != 0) { ret 8; }
    val f_r: res[binding.Binding, fail.Fail] = select(?reg, "rv64if", "freestanding", "lp64f");
    if (sel f_r.err) { ret 9; }
    val f_only: binding.Binding = f_r.ok;
    if (f_only.target.model.flen_bits != 32 || !f_only.target.model.has_float || f_only.target.model.has_mul) { ret 10; }
    val r_1532: res[binding.Binding, fail.Fail] = select(?reg, "rv64if", "freestanding", "lp64d");
    if (sel r_1532.ok) { ret 11; }
    val default64: res[binding.Binding, fail.Fail] = select(?reg, "riscv64", "linux", "lp64d");
    if (sel default64.err)                                                 { ret 12; }
    if (default64.ok.target.model.extensions != extension_riscv.DEFAULT64) { ret 12; }
    val r_1536: res[binding.Binding, fail.Fail] = select(?reg, "rv32e", "freestanding", "ilp32");
    if (sel r_1536.ok) { ret 13; }
    val r_1537: res[binding.Binding, fail.Fail] = select(?reg, "rv64iv", "linux", "lp64");
    if (sel r_1537.ok) { ret 13; }
    val r_1538: res[binding.Binding, fail.Fail] = select(?reg, "rv64i_zba", "linux", "lp64");
    if (sel r_1538.ok) { ret 13; }
    val compressed_flags: u32            = isa.machine_flags(small.isa, 0, true);
    val r_1540:           err[fail.Fail] = isa.validate_attributes(small.isa, ?small.target.model, nil, 0, compressed_flags);
    if (sel r_1540.err) { ret 14; }
    # compressed code links into a target that does not select C: linking never asks for a capability
    val r_1541: err[fail.Fail] = isa.validate_attributes(f_only.isa, ?f_only.target.model, nil, 0, compressed_flags);
    if (sel r_1541.err) { ret 15; }
    ret 0;
}

#[testing]
rec RvMatrixRow {
    isa:  str;
    os:   str;
    abi:  str;
    exts: u64;
    flen: u32;
}

# one retained RISC-V tuple: the selection string, the model it narrows to, the
# ABI's float requirement and the emitted Tag_RISCV_arch must all say the same thing
#[testing]
fun t_rv_matrix_row(reg: *TargetRegistry, alloc: *A.Allocator, row: *RvMatrixRow) i32 {
    val res_: res[binding.Binding, fail.Fail] = select(reg, row.isa, row.os, row.abi);
    if (sel res_.err) { ret 1; }
    val t:      binding.Binding                           = res_.ok;
    val parsed: res[extension_riscv.Selection, fail.Fail] = extension_riscv.parse(row.isa);
    if (sel parsed.err) { ret 2; }
    val selection: extension_riscv.Selection = parsed.ok;
    if (selection.extensions != row.exts || t.target.model.extensions != row.exts)                      { ret 3; }
    if (t.target.model.gpr_width != selection.width || t.target.model.pointer_width != selection.width) { ret 4; }
    if (t.target.model.has_float != extension_riscv.has(row.exts, extension_riscv.F)
        || t.target.model.has_mul != extension_riscv.has(row.exts, extension_riscv.M)
        || t.target.model.flen_bits != row.flen) { ret 5; }
    val need: u64 = extension_riscv.float_requirement(t.abi.float_arg_bits);
    if (!extension_riscv.has(row.exts, need) || t.abi.float_arg_bits > t.target.model.flen_bits) { ret 6; }
    val has_c:      bool = extension_riscv.has(row.exts, extension_riscv.C);
    val flags:      u32  = isa.machine_flags(t.isa, t.abi.float_arg_bits, has_c);
    var want_flags: u32  = elf.EF_RISCV_FLOAT_ABI_SOFT;
    if (t.abi.float_arg_bits == 32) { want_flags = elf.EF_RISCV_FLOAT_ABI_SINGLE; }
    if (t.abi.float_arg_bits == 64) { want_flags = elf.EF_RISCV_FLOAT_ABI_DOUBLE; }
    if (has_c)                      { want_flags = want_flags | elf.EF_RISCV_RVC; }
    if (flags != want_flags)        { ret 7; }
    var len:   u32                 = 0;
    val built: res[*u8, fail.Fail] = isa.build_attributes(t.isa, ?t.target.model, alloc, t.abi.float_arg_bits, has_c, ?len);
    if (sel built.err) { ret 8; }
    if (len == 0)      { ret 8; }
    val bytes:  *u8            = built.ok;
    var at:     riscv_attributes.Attrs;
    val r_1582: err[fail.Fail] = riscv_attributes.parse_body(bytes, len, ?at);
    if (sel r_1582.err)                      { ret 9; }
    if (!at.has_arch)                        { ret 9; }
    if (at.arch.xlen != selection.width * 8) { ret 10; }
    var ei:      usize = 0;
    var emitted: u32   = 0;
    for (ei < extension_riscv.EXT_COUNT) {
        val spec:    extension_riscv.ExtSpec = extension_riscv.EXTS[ei];
        var present: bool                    = false;
        var xi:      u32                     = 0;
        for (xi < at.arch.count) {
            val e: *riscv_attributes.Ext = ?at.arch.exts[xi];
            if (extension_riscv.ext_index((?e.name[0])::str, e.name_len::usize) == ei) {
                present = true;
                if (e.major != spec.major || e.minor != spec.minor) { ret 11; }
            }
            xi = xi + 1;
        }
        val selected: bool = spec.emitted && extension_riscv.has(row.exts, spec.requires);
        if (present != selected) { ret 12; }
        if (present)             { emitted = emitted + 1; }
        ei = ei + 1;
    }
    if (emitted != at.arch.count) { ret 13; }
    val r_1605: err[fail.Fail] = isa.validate_attributes(t.isa, ?t.target.model, bytes, len, flags);
    if (sel r_1605.err) { ret 14; }
    ret 0;
}

#[testing]
fun t_rv_refused(reg: *TargetRegistry, isa_name: str, os_name: str, abi_name: str, names: str) bool {
    val res_: res[binding.Binding, fail.Fail] = select(reg, isa_name, os_name, abi_name);
    if (sel res_.ok) { ret false; }
    ret str_contains(fail.describe(res_.err), names);
}

test select__riscv_retained_matrix_agrees_on_selection_abi_and_attributes {
    var reg:    TargetRegistry = registry_init();
    val r_1618: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel r_1618.err) { ret 1; }
    var alloc:  A.Allocator;
    val r_1620: err[A.Error] = page.make(?alloc);
    if (sel r_1620.err) { ret 1; }

    val g:    u64             = extension_riscv.G;
    val rows: [13]RvMatrixRow = [13]RvMatrixRow{
        RvMatrixRow{isa: "riscv64", os: "linux", abi: "lp64d", exts: extension_riscv.DEFAULT64, flen: 64},
        RvMatrixRow{isa: "rv64gc", os: "linux", abi: "lp64d", exts: extension_riscv.DEFAULT64, flen: 64},
        RvMatrixRow{isa: "riscv64", os: "linux", abi: "lp64f", exts: extension_riscv.DEFAULT64, flen: 64},
        RvMatrixRow{isa: "riscv64", os: "linux", abi: "lp64", exts: extension_riscv.DEFAULT64, flen: 64},
        RvMatrixRow{isa: "rv64imafd", os: "linux", abi: "lp64d", exts: g & ~extension_riscv.ZIFENCEI, flen: 64},
        RvMatrixRow{isa: "rv64imafc", os: "freestanding", abi: "lp64f", exts: extension_riscv.I | extension_riscv.M | extension_riscv.A | extension_riscv.F | extension_riscv.C | extension_riscv.ZICSR, flen: 32},
        RvMatrixRow{isa: "rv64if", os: "freestanding", abi: "lp64f", exts: extension_riscv.I | extension_riscv.F | extension_riscv.ZICSR, flen: 32},
        RvMatrixRow{isa: "rv64i", os: "freestanding", abi: "lp64", exts: extension_riscv.I, flen: 0},
        RvMatrixRow{isa: "riscv32", os: "freestanding", abi: "ilp32", exts: extension_riscv.DEFAULT32, flen: 0},
        RvMatrixRow{isa: "rv32imac", os: "freestanding", abi: "ilp32", exts: extension_riscv.DEFAULT32, flen: 0},
        RvMatrixRow{isa: "rv32imc", os: "freestanding", abi: "ilp32", exts: extension_riscv.I | extension_riscv.M | extension_riscv.C, flen: 0},
        RvMatrixRow{isa: "rv32imafdc", os: "freestanding", abi: "ilp32d", exts: (g & ~extension_riscv.ZIFENCEI) | extension_riscv.C, flen: 64},
        RvMatrixRow{isa: "rv32imafc", os: "freestanding", abi: "ilp32f", exts: extension_riscv.I | extension_riscv.M | extension_riscv.A | extension_riscv.F | extension_riscv.C | extension_riscv.ZICSR, flen: 32},
    };
    var i: usize = 0;
    for (i < 13) {
        val code: i32 = t_rv_matrix_row(?reg, ?alloc, ?rows[i]);
        if (code != 0) { ret (i::i32 + 1) * 16 + code; }
        i = i + 1;
    }
    val rv32_d: res[binding.Binding, fail.Fail] = select(?reg, "rv32imafdc", "freestanding", "ilp32");
    val rv32_f: res[binding.Binding, fail.Fail] = select(?reg, "rv32imafdc", "freestanding", "ilp32f");
    if (sel rv32_d.err) { ret 2; }
    if (sel rv32_f.err) { ret 2; }

    # the ABI needs F or D the selection lacks: the letter and the selection are named
    if (!t_rv_refused(?reg, "rv32imc", "freestanding", "ilp32d", "lacks the F and D extensions")
        || !t_rv_refused(?reg, "rv32imc", "freestanding", "ilp32d", "'rv32imc'")) { ret 3; }
    if (!t_rv_refused(?reg, "riscv32", "freestanding", "ilp32f", "lacks the F extension")
        || !t_rv_refused(?reg, "riscv32", "freestanding", "ilp32f", "'riscv32'")) { ret 4; }
    if (!t_rv_refused(?reg, "rv64if", "freestanding", "lp64d", "lacks the D extension")
        || !t_rv_refused(?reg, "rv64if", "freestanding", "lp64d", "'rv64if'")) { ret 5; }
    if (!t_rv_refused(?reg, "rv64i", "linux", "lp64f", "lacks the F extension")) { ret 6; }
    # the E base, an unknown extension, a noncanonical order, a version: token and string
    if (!t_rv_refused(?reg, "rv32e", "freestanding", "ilp32", "E is unsupported")
        || !t_rv_refused(?reg, "rv32e", "freestanding", "ilp32", "'rv32e'")) { ret 7; }
    if (!t_rv_refused(?reg, "rv64iv", "linux", "lp64", "unknown or unavailable RISC-V extension: 'v' in selection 'rv64iv'"))            { ret 8; }
    if (!t_rv_refused(?reg, "rv64i_zba", "linux", "lp64", "'zba' in selection 'rv64i_zba'"))                                             { ret 9; }
    if (!t_rv_refused(?reg, "rv64icm", "linux", "lp64", "noncanonical RISC-V extension order: 'm' in selection 'rv64icm'"))              { ret 10; }
    if (!t_rv_refused(?reg, "rv64imm", "linux", "lp64", "duplicate or noncanonical RISC-V extension order: 'm' in selection 'rv64imm'")) { ret 11; }
    if (!t_rv_refused(?reg, "rv64i3p0", "linux", "lp64", "'3p0' in selection 'rv64i3p0'"))                                               { ret 12; }
    if (!t_rv_refused(?reg, "rv64id", "linux", "lp64", "D extension requires F: selection 'rv64id'"))                                    { ret 13; }
    if (!t_rv_refused(?reg, "rv64i_", "linux", "lp64", "trailing separator in RISC-V extension string: '_' in selection 'rv64i_'"))      { ret 14; }
    ret 0;
}

test select__riscv32_linux_is_refused_because_linux_does_not_list_the_isa {
    var reg:    TargetRegistry = registry_init();
    val r_1673: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel r_1673.err) { ret 1; }

    val isa_opt: opt[*isa.IsaVTable] = target_registry.find[isa.IsaVTable](?reg.isa, "riscv32");
    if (sel isa_opt.none) { ret 1; }
    val abi_opt: opt[*abi.AbiVTable] = target_registry.find[abi.AbiVTable](?reg.abi, "ilp32d");
    if (sel abi_opt.none) { ret 1; }

    val res_: res[binding.Binding, fail.Fail] = select(?reg, "riscv32", "linux", "ilp32");
    if (!sel res_.err) { ret 1; }
    val diag: str = fail.describe(res_.err);
    if (!str_contains(diag, "does not run on instruction set")) { ret 1; }
    if (!str_contains(diag, "linux"))                           { ret 1; }
    if (!str_contains(diag, "riscv32"))                         { ret 1; }
    ret 0;
}

test select__x86_64_freestanding_raw {
    var reg:     TargetRegistry = registry_init();
    val res_reg: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel res_reg.err) { ret 1; }

    val res_target: res[binding.Binding, fail.Fail] = select(?reg, "x86_64", "freestanding", "sysv64");
    if (sel res_target.err) { ret 1; }
    val t: binding.Binding = res_target.ok;

    if (t.os == nil)                              { ret 1; }
    if (t.os.id != catalog_os.FREESTANDING)       { ret 1; }
    if (!str_equals(t.os.entry_symbol, "_start")) { ret 1; }
    if (!str_equals(t.os.default_of, "raw"))      { ret 1; }
    if (t.os.base_addr != 0)                      { ret 1; }
    if (t.os.page_size != 0)                      { ret 1; }
    if (t.target.page_size != 1)                  { ret 1; }

    if (t.of == nil)                 { ret 1; }
    if (t.of.id != target_of.OF_RAW) { ret 1; }
    if (t.of.emit_exec == nil)       { ret 1; }

    if (t.abi == nil)                    { ret 1; }
    if (t.abi.id != catalog_abi.SYSV)    { ret 1; }
    if (t.arch == nil)                   { ret 1; }
    if (t.isa.id != catalog_arch.X86_64) { ret 1; }

    ret 0;
}

# the page an image is laid out at comes from the tuple: a page-mapped format on
# a system with no loader of its own takes the isa's hardware page, a flat image
# and a module format have none, and a hosted system's own page stands
test select__page_size_comes_from_the_tuple {
    var reg:     TargetRegistry = registry_init();
    val res_reg: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel res_reg.err) { ret 1; }

    val elf_r: res[binding.Binding, fail.Fail] = select_of(?reg, "x86_64", "freestanding", "sysv64", "elf");
    if (sel elf_r.err)                     { ret 2; }
    if (elf_r.ok.target.page_size != 4096) { ret 3; }
    val arm_r: res[binding.Binding, fail.Fail] = select_of(?reg, "aarch64", "freestanding", "aapcs64", "elf");
    if (sel arm_r.err)                     { ret 4; }
    if (arm_r.ok.target.page_size != 4096) { ret 5; }
    val rv_r: res[binding.Binding, fail.Fail] = select_of(?reg, "riscv32", "freestanding", "ilp32", "elf");
    if (sel rv_r.err)                     { ret 6; }
    if (rv_r.ok.target.page_size != 4096) { ret 7; }

    val raw_r: res[binding.Binding, fail.Fail] = select_of(?reg, "x86_64", "freestanding", "sysv64", "raw");
    if (sel raw_r.err)                  { ret 8; }
    if (raw_r.ok.target.page_size != 1) { ret 9; }
    val spv_r: res[binding.Binding, fail.Fail] = select_of(?reg, "spirv", "freestanding", "spirv", "spv");
    if (sel spv_r.err)                  { ret 10; }
    if (spv_r.ok.target.page_size != 1) { ret 11; }

    val linux_r: res[binding.Binding, fail.Fail] = select_of(?reg, "aarch64", "linux", "aapcs64", "elf");
    if (sel linux_r.err)                      { ret 12; }
    if (linux_r.ok.target.page_size != 65536) { ret 13; }
    ret 0;
}

# a page-mapped format with no page from either the system or the isa is refused
# at selection, naming all three
test tuple_page_size__refuses_a_page_mapped_format_without_a_page {
    var t_alloc: A.Allocator;
    val t_made:  err[A.Error] = page.make(?t_alloc);
    if (sel t_made.err) { ret 90; }
    var os_vt: lang_target_os.OsVTable;
    os_vt.name          = "nowhere";
    os_vt.page_size     = 0;
    os_vt.page_size_for = nil;
    var arch_vt: isa.IsaVTable = isa.IsaVTable{id: catalog_arch.X86_64, name: "pageless", pointer_width: 8};
    var of_vt:   target_of.OfVTable;
    of_vt.name         = "mapped";
    of_vt.maps_by_page = true;

    val r: res[u64, fail.Fail] = tuple_page_size(?t_alloc, ?os_vt, ?arch_vt, ?of_vt);
    if (!sel r.err) { ret 1; }
    val diag: str = fail.describe(r.err);
    if (!str_contains(diag, "mapped"))   { ret 2; }
    if (!str_contains(diag, "nowhere"))  { ret 3; }
    if (!str_contains(diag, "pageless")) { ret 4; }

    of_vt.maps_by_page = false;
    val flat: res[u64, fail.Fail] = tuple_page_size(?t_alloc, ?os_vt, ?arch_vt, ?of_vt);
    if (sel flat.err) { ret 5; }
    if (flat.ok != 1) { ret 6; }
    of_vt.maps_by_page = true;
    arch_vt.page_size  = 4096;
    val hw: res[u64, fail.Fail] = tuple_page_size(?t_alloc, ?os_vt, ?arch_vt, ?of_vt);
    if (sel hw.err)    { ret 7; }
    if (hw.ok != 4096) { ret 8; }
    os_vt.page_size = 16384;
    val hosted: res[u64, fail.Fail] = tuple_page_size(?t_alloc, ?os_vt, ?arch_vt, ?of_vt);
    if (sel hosted.err)     { ret 9; }
    if (hosted.ok != 16384) { ret 10; }
    ret 0;
}

