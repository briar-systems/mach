pub fun host_os_id() u32 {
    $if ($mach.build.os == $mach.os.linux)   { ret os.OS_LINUX; }
    $or ($mach.build.os == $mach.os.darwin)  { ret os.OS_DARWIN; }
    $or ($mach.build.os == $mach.os.windows) { ret os.OS_WINDOWS; }
    $or                                      { ret os.OS_UNKNOWN; }
}

pub fun host_arch_id() u32 {
    $if ($mach.build.arch == $mach.arch.x86_64)  { ret isa.ARCH_X86_64; }
    $or ($mach.build.arch == $mach.arch.aarch64) { ret isa.ARCH_AARCH64; }
    $or ($mach.build.arch == $mach.arch.riscv64) { ret isa.ARCH_RISCV64; }
    $or                                          { ret isa.ARCH_UNKNOWN; }
}

pub fun host_pointer_width() u32 {
    ret ($mach.build.pointer_width)::u32;
}

pub fun host_va_list() opt[os.VaList] {
    $if ($mach.build.os == $mach.os.linux)   { ret linux.linux_va_list(host_arch_id()); }
    $or ($mach.build.os == $mach.os.darwin)  { ret darwin.darwin_va_list(host_arch_id()); }
    $or ($mach.build.os == $mach.os.windows) { ret windows.windows_va_list(host_arch_id()); }
    $or                                      { ret freestanding.freestanding_va_list(host_arch_id()); }
}

pub fun host_abi_id() u32 {
    ret ($mach.build.abi)::u32;
}

pub def DebugDescriptorProvider: fun() res[of.DebugVTable, fail.Fail];

fun isa_identity(reg: *TargetRegistry, name: str, id: u32) bool {
    val found: opt[*isa.IsaVTable] = isa.lookup(?reg.isa, name);
    ret sel found.some && found.some.id == id;
}

fun os_identity(reg: *TargetRegistry, name: str, id: u32) bool {
    val found: opt[*os.OsVTable] = os.lookup(?reg.os, name);
    ret sel found.some && found.some.id == id;
}

fun abi_identity(reg: *TargetRegistry, name: str, id: u32) bool {
    val found: opt[*abi.AbiVTable] = abi.lookup(?reg.abi, name);
    ret sel found.some && found.some.id == id;
}

fun of_identity(reg: *TargetRegistry, name: str, id: u32) bool {
    val found: opt[*of.OfVTable] = of.lookup(?reg.of, name);
    ret sel found.some && found.some.id == id;
}

fun production_registry_complete(reg: *TargetRegistry) bool {
    if (reg == nil) { ret false; }
    val r_160: err[fail.Fail] = isa.registry_validate(?reg.isa);
    if (sel r_160.err) { ret false; }
    val r_161: err[fail.Fail] = os.registry_validate(?reg.os);
    if (sel r_161.err) { ret false; }
    val r_162: err[fail.Fail] = abi.registry_validate(?reg.abi);
    if (sel r_162.err) { ret false; }
    val r_163: err[fail.Fail] = of.registry_validate(?reg.of);
    if (sel r_163.err) { ret false; }
    val r_164: err[fail.Fail] = of.debug_registry_validate(?reg.debug);
    if (sel r_164.err) { ret false; }
    if (isa.registered_count(?reg.isa) < 5
        || !isa_identity(reg, "x86_64", isa.ARCH_X86_64)
        || !isa_identity(reg, "aarch64", isa.ARCH_AARCH64)
        || !isa_identity(reg, "riscv64", isa.ARCH_RISCV64)
        || !isa_identity(reg, "riscv32", isa.ARCH_RISCV32)
        || !isa_identity(reg, "spirv", isa.ARCH_SPIRV)) { ret false; }
    if (os.registered_count(?reg.os) < 4
        || !os_identity(reg, "linux", os.OS_LINUX)
        || !os_identity(reg, "darwin", os.OS_DARWIN)
        || !os_identity(reg, "windows", os.OS_WINDOWS)
        || !os_identity(reg, "freestanding", os.OS_FREESTANDING)) { ret false; }
    if (abi.registered_count(?reg.abi) < 10
        || !abi_identity(reg, "sysv64", abi.ABI_SYSV)
        || !abi_identity(reg, "win64", abi.ABI_WIN64)
        || !abi_identity(reg, "aapcs64", abi.ABI_AAPCS64)
        || !abi_identity(reg, "lp64", abi.ABI_LP64)
        || !abi_identity(reg, "lp64f", abi.ABI_LP64F)
        || !abi_identity(reg, "lp64d", abi.ABI_LP64D)
        || !abi_identity(reg, "ilp32", abi.ABI_ILP32)
        || !abi_identity(reg, "ilp32f", abi.ABI_ILP32F)
        || !abi_identity(reg, "ilp32d", abi.ABI_ILP32D)
        || !abi_identity(reg, "spirv", abi.ABI_SPIRV)) { ret false; }
    if (of.registered_count(?reg.of) < 5
        || !of_identity(reg, "elf", of.OF_ELF)
        || !of_identity(reg, "coff", of.OF_COFF)
        || !of_identity(reg, "macho", of.OF_MACHO)
        || !of_identity(reg, "raw", of.OF_RAW)
        || !of_identity(reg, "spv", of.OF_SPV)) { ret false; }
    if (of.debug_registered_count(?reg.debug) == 0) { ret false; }
    val r_196: err[fail.Fail] = of.debug_hooks_complete(?reg.debug);
    if (sel r_196.err) { ret false; }
    var i: u32 = 0;
    for (i < of.registered_count(?reg.of)) {
        val fmt_o: opt[*of.OfVTable] = of.registered(?reg.of, i);
        if (sel fmt_o.none) { ret false; }
        val fmt: *of.OfVTable = fmt_o.some;
        if (!str_empty(fmt.default_debug)) {
            val dbg_o: opt[*of.DebugVTable] = of.debug_lookup(?reg.debug, fmt.default_debug);
            if (sel dbg_o.none) { ret false; }
            val dbg: *of.DebugVTable = dbg_o.some;
            if (dbg.produce == nil)                                               { ret false; }
            if (str_equals(fmt.default_debug, "dwarf") && dbg.id != of.DBG_DWARF) { ret false; }
        }
        i = i + 1;
    }
    ret true;
}

pub fun register_all(reg: *TargetRegistry, debug_provider: DebugDescriptorProvider) err[fail.Fail] {
    if (reg == nil || debug_provider == nil) {
        ret err[fail.Fail].err{fail.message("target: register_all requires a registry and debug descriptor provider")};
    }
    if (reg.state == treg.REGISTRY_READY) {
        if (reg.version == treg.REGISTRY_VERSION && production_registry_complete(reg)) {
            ret err[fail.Fail].ok{};
        }
        ret err[fail.Fail].err{fail.message("target: published registry invariants do not match this catalog version")};
    }
    if (reg.state == treg.REGISTRY_RELEASED) {
        ret err[fail.Fail].err{fail.message("target: register_all refuses a released registry; a registry is published once")};
    }
    if (reg.state != treg.REGISTRY_FRESH || !treg.registry_empty(reg)) {
        ret err[fail.Fail].err{fail.message("target: register_all refuses a partial or foreign registry")};
    }
    reg.state = treg.REGISTRY_BUILDING;
    var res_: err[fail.Fail] = x64.register_x64(?reg.isa);
    if (sel res_.err) {
        treg.registry_rollback(reg);
        ret res_;
    }
    val res__1: err[fail.Fail] = arm64.register_arm64(?reg.isa);
    if (sel res__1.err) {
        treg.registry_rollback(reg);
        ret res__1;
    }
    val res__2: err[fail.Fail] = riscv.register_riscv64(?reg.isa);
    if (sel res__2.err) {
        treg.registry_rollback(reg);
        ret res__2;
    }
    val res__3: err[fail.Fail] = riscv.register_riscv32(?reg.isa);
    if (sel res__3.err) {
        treg.registry_rollback(reg);
        ret res__3;
    }
    val res__4: err[fail.Fail] = spirv.register_spirv(?reg.isa);
    if (sel res__4.err) {
        treg.registry_rollback(reg);
        ret res__4;
    }

    val res__6: err[fail.Fail] = sysv.register(?reg.abi);
    if (sel res__6.err) {
        treg.registry_rollback(reg);
        ret res__6;
    }
    val res__7: err[fail.Fail] = win64.register_win64(?reg.abi);
    if (sel res__7.err) {
        treg.registry_rollback(reg);
        ret res__7;
    }
    val res__8: err[fail.Fail] = aapcs64.register(?reg.abi);
    if (sel res__8.err) {
        treg.registry_rollback(reg);
        ret res__8;
    }
    val res__9: err[fail.Fail] = rvabi.register(?reg.abi);
    if (sel res__9.err) {
        treg.registry_rollback(reg);
        ret res__9;
    }
    val res__10: err[fail.Fail] = sabi.register(?reg.abi);
    if (sel res__10.err) {
        treg.registry_rollback(reg);
        ret res__10;
    }

    val res__12: err[fail.Fail] = elf.register(?reg.of);
    if (sel res__12.err) {
        treg.registry_rollback(reg);
        ret res__12;
    }
    val res__13: err[fail.Fail] = coff.register_coff(?reg.of);
    if (sel res__13.err) {
        treg.registry_rollback(reg);
        ret res__13;
    }
    val res__14: err[fail.Fail] = macho.register_macho(?reg.of);
    if (sel res__14.err) {
        treg.registry_rollback(reg);
        ret res__14;
    }
    val res__15: err[fail.Fail] = raw.register(?reg.of);
    if (sel res__15.err) {
        treg.registry_rollback(reg);
        ret res__15;
    }
    val res__16: err[fail.Fail] = spv.register(?reg.of);
    if (sel res__16.err) {
        treg.registry_rollback(reg);
        ret res__16;
    }

    val res__17: err[fail.Fail] = linux.register_linux(?reg.os);
    if (sel res__17.err) {
        treg.registry_rollback(reg);
        ret res__17;
    }
    val res__18: err[fail.Fail] = darwin.register_darwin(?reg.os);
    if (sel res__18.err) {
        treg.registry_rollback(reg);
        ret res__18;
    }
    val res__19: err[fail.Fail] = windows.register_windows(?reg.os);
    if (sel res__19.err) {
        treg.registry_rollback(reg);
        ret res__19;
    }
    val res__20: err[fail.Fail] = freestanding.register_freestanding(?reg.os);
    if (sel res__20.err) {
        treg.registry_rollback(reg);
        ret res__20;
    }

    val debug_r: res[of.DebugVTable, fail.Fail] = debug_provider();
    if (sel debug_r.err) {
        val debug_err: str = fail.describe(debug_r.err);
        treg.registry_rollback(reg);
        ret err[fail.Fail].err{fail.message(debug_err)};
    }
    var debug_descriptor: of.DebugVTable = debug_r.ok;
    val res__21:          err[fail.Fail] = of.debug_register(?reg.debug, ?debug_descriptor);
    if (sel res__21.err) {
        treg.registry_rollback(reg);
        ret res__21;
    }
    val res__22: err[fail.Fail] = of.debug_hooks_complete(?reg.debug);
    if (sel res__22.err) {
        treg.registry_rollback(reg);
        ret res__22;
    }
    if (!production_registry_complete(reg)) {
        treg.registry_rollback(reg);
        ret err[fail.Fail].err{fail.message("target: registrar did not construct the complete production registry")};
    }

    reg.version = treg.REGISTRY_VERSION;
    reg.state   = treg.REGISTRY_READY;

    ret err[fail.Fail].ok{};
}

pub rec TargetRequest {
    isa_name:      str;
    os_name:       str;
    abi_name:      str;
    of_name:       str;
    base:          u64;
    stack_reserve: u64;
    stack_commit:  u64;
    env_name:      str;
    label:         str;
}

pub fun target_request(isa_name: str, os_name: str, abi_name: str) TargetRequest {
    var r: TargetRequest;
    r.isa_name      = isa_name;
    r.os_name       = os_name;
    r.abi_name      = abi_name;
    r.of_name       = "";
    r.base          = 0;
    r.stack_reserve = 0;
    r.stack_commit  = 0;
    ret r;
}

pub fun with_of(req: *TargetRequest, of_name: str) {
    req.of_name = of_name;
}

pub fun with_env(req: *TargetRequest, env_name: str, label: str) {
    req.env_name = env_name;
    req.label    = label;
}

pub fun with_image(req: *TargetRequest, base: u64, stack_reserve: u64, stack_commit: u64) {
    req.base          = base;
    req.stack_reserve = stack_reserve;
    req.stack_commit  = stack_commit;
}

pub fun select_of(reg: *TargetRegistry, isa_name: str, os_name: str, abi_name: str, of_name: str) res[resolved.Target, fail.Fail] {
    var req: TargetRequest = target_request(isa_name, os_name, abi_name);
    with_of(?req, of_name);
    ret resolve(reg, ?req);
}

pub fun resolve(reg: *TargetRegistry, req: *TargetRequest) res[resolved.Target, fail.Fail] {
    if (reg == nil || req == nil) {
        ret res[resolved.Target, fail.Fail].err{fail.message("target: resolve requires a registry and target request")};
    }
    if (!treg.registry_published(reg) || !production_registry_complete(reg)) {
        ret res[resolved.Target, fail.Fail].err{fail.message("target: resolve requires a published registry at the current catalog version")};
    }
    val isa_name: str = req.isa_name;
    val os_name:  str = req.os_name;
    val abi_name: str = req.abi_name;
    val of_name:  str = req.of_name;

    val opt_os_vt: opt[*os.OsVTable] = os.lookup(?reg.os, os_name);
    if (sel opt_os_vt.none) {
        var nb: [256]u8;
        ret res[resolved.Target, fail.Fail].err{fail.message(unregistered_message("os", os_name, registered_names(reg, DIM_OS, ?nb[0], 256)))};
    }
    val os_vt: *os.OsVTable = opt_os_vt.some;

    var lookup_name: str = isa_name;
    var rv:          rvfeatures.Selection;
    rv.width      = 0;
    rv.extensions = 0;
    if (rvfeatures.is_name(isa_name)) {
        var bad:    rvfeatures.Span;
        val parsed: res[rvfeatures.Selection, fail.Fail] = rvfeatures.parse_at(isa_name, ?bad);
        if (sel parsed.err) {
            ret res[resolved.Target, fail.Fail].err{fail.message(selection_message(fail.describe(parsed.err), isa_name, ?bad))};
        }
        rv          = parsed.ok;
        lookup_name = isa.arch_name_for(isa.ARCH_RISCV64);
        if (rv.width == 4) { lookup_name = isa.arch_name_for(isa.ARCH_RISCV32); }
    }
    val opt_arch_vt: opt[*isa.IsaVTable] = isa.lookup(?reg.isa, lookup_name);
    if (sel opt_arch_vt.none) {
        var nb: [256]u8;
        ret res[resolved.Target, fail.Fail].err{fail.message(unregistered_message("isa", isa_name, registered_names(reg, DIM_ISA, ?nb[0], 256)))};
    }
    val opt_abi_vt: opt[*abi.AbiVTable] = abi.lookup(?reg.abi, abi_name);
    if (sel opt_abi_vt.none) {
        var nb: [256]u8;
        ret res[resolved.Target, fail.Fail].err{fail.message(unregistered_message("abi", abi_name, registered_names(reg, DIM_ABI, ?nb[0], 256)))};
    }

    val arch_vt: *isa.IsaVTable = opt_arch_vt.some;
    val abi_vt:  *abi.AbiVTable = opt_abi_vt.some;

    var of_sel: str = of_name;
    if (str_empty(of_sel)) {
        val opt_def: opt[str] = default_of_name(reg, os_vt, arch_vt);
        if (sel opt_def.none) {
            ret res[resolved.Target, fail.Fail].err{fail.message(no_module_format_message(arch_vt))};
        }
        of_sel = opt_def.some;
    }
    val opt_of_vt: opt[*of.OfVTable] = of.lookup(?reg.of, of_sel);
    if (sel opt_of_vt.none) {
        var nb: [256]u8;
        ret res[resolved.Target, fail.Fail].err{fail.message(unregistered_message("object-format", of_sel, registered_names(reg, DIM_OF, ?nb[0], 256)))};
    }

    val of_vt: *of.OfVTable = opt_of_vt.some;

    var selected_model: isa.MachineModel;
    val selected_isa:   isa.IsaVTable = select_isa(arch_vt, isa_name, rv, ?selected_model);
    val cap:            u32           = tuple_capability(os_vt, ?selected_isa, abi_vt, of_vt);
    if (cap != TUPLE_OK) {
        ret res[resolved.Target, fail.Fail].err{fail.message(tuple_capability_message(cap, os_vt, ?selected_isa, abi_vt, of_vt))};
    }

    var t: resolved.Target;
    t.registry = reg;
    t.os       = os_vt;
    val env_r: res[u32, fail.Fail] = resolve_environment(arch_vt, req);
    if (sel env_r.err) { ret res[resolved.Target, fail.Fail].err{env_r.err}; }
    t.env_id        = env_r.ok;
    t.env_profile   = isa.environment_profile(arch_vt, t.env_id);
    t.env_name      = req.env_name;
    t.base          = req.base;
    t.stack_reserve = req.stack_reserve;
    t.stack_commit  = req.stack_commit;
    t.isa           = arch_vt;
    isa.object_target(arch_vt, ?t.object);
    t.arch = arch_vt.machine;
    t.abi  = abi_vt;
    t.of   = of_vt;

    t.variadic_args_on_stack = os.variadic_stack_for(os_vt, arch_vt.id);

    t.fixed_args_natural_size = os.natural_stack_args_for(os_vt, arch_vt.id);

    var vl_size:  u32                            = 0;
    var vl_align: u32                            = 0;
    val vl_r:     res[opt[os.VaList], fail.Fail] = os.va_list_checked_for(os_vt, arch_vt.id);
    if (sel vl_r.err) {
        ret res[resolved.Target, fail.Fail].err{vl_r.err};
    }
    val vl: opt[os.VaList] = vl_r.ok;
    if (sel vl.some) {
        vl_size  = vl.some.size;
        vl_align = vl.some.align;
    }
    t.va_list_size  = vl_size;
    t.va_list_align = vl_align;

    t.os_id   = t.os.id;
    t.arch_id = t.isa.id;
    t.abi_id  = t.abi.id;

    val page_r: res[u64, fail.Fail] = os.page_size_checked_for(os_vt, arch_vt.id);
    if (sel page_r.err) { ret res[resolved.Target, fail.Fail].err{page_r.err}; }
    t.page_size = page_r.ok;

    val fp_r: res[opt[os.FsPolicy], fail.Fail] = os.fs_policy_checked_for(os_vt, arch_vt.id);
    if (sel fp_r.err) {
        ret res[resolved.Target, fail.Fail].err{fp_r.err};
    }
    val fp_opt: opt[os.FsPolicy] = fp_r.ok;
    if (sel fp_opt.none) {
        ret res[resolved.Target, fail.Fail].err{fail.message(no_fs_policy_message(os_vt, arch_vt))};
    }
    t.fs_policy = fp_opt.some;

    t.debug    = nil;
    t.debug_id = of.DBG_UNKNOWN;
    if (!str_empty(of_vt.default_debug)) {
        val opt_dbg: opt[*of.DebugVTable] = of.debug_lookup(?reg.debug, of_vt.default_debug);
        if (sel opt_dbg.none) {
            var nb: [256]u8;
            ret res[resolved.Target, fail.Fail].err{fail.message(unregistered_message("debug", of_vt.default_debug, registered_names(reg, DIM_DEBUG, ?nb[0], 256)))};
        }
        t.debug    = opt_dbg.some;
        t.debug_id = t.debug.id;
        var debug_target: debug_input.DebugTarget;
        debug_target.arch_id   = arch_vt.id;
        debug_target.os_id     = os_vt.id;
        debug_target.abi_id    = abi_vt.id;
        debug_target.of_id     = of_vt.id;
        debug_target.dwarf_reg = nil;
        debug_target.cv_reg    = nil;
        if (arch_vt.machine != nil) {
            debug_target.dwarf_reg = arch_vt.machine.dwarf_reg;
            debug_target.cv_reg    = arch_vt.machine.cv_reg;
        }
        if (t.debug.supports == nil || !t.debug.supports(?debug_target)) {
            ret res[resolved.Target, fail.Fail].err{fail.message("target: selected debug model is incompatible with the target tuple")};
        }
    }

    t.model              = selected_model;
    t.model.stack_align  = t.abi.stack_align;
    t.model.red_zone     = t.abi.red_zone;
    t.model.shadow_space = t.abi.shadow_space;

    ret res[resolved.Target, fail.Fail].ok{t};
}

pub val TARGET_FINGERPRINT_VERSION: u8 = 3;

fun b2u8(b: bool) u8 {
    if (b) { ret 1; }
    ret 0;
}

pub fun fingerprint(t: *resolved.Target, e: *binary.Encoder) bool {
    var ok: bool = true;

    ok = ok && fp.write_domain_str(e, fp.DOMAIN_ARCH, TARGET_FINGERPRINT_VERSION, t.env_name);

    ok = ok && fp.write_domain_u8(e, fp.DOMAIN_ARCH, isa.ARCH_CATALOG_VERSION, isa.arch_fingerprint_tag(t.arch_id));
    ok = ok && fp.write_domain_str(e, fp.DOMAIN_ARCH, TARGET_FINGERPRINT_VERSION, t.isa.name);

    ok = ok && fp.write_domain_u8(e, fp.DOMAIN_ABI, abi.ABI_CATALOG_VERSION, abi.abi_fingerprint_tag(t.abi_id));
    ok = ok && fp.write_domain_str(e, fp.DOMAIN_ABI, TARGET_FINGERPRINT_VERSION, t.abi.name);
    ok = ok && fp.write_domain_u8(e, fp.DOMAIN_ABI, TARGET_FINGERPRINT_VERSION, t.abi.passing);

    ok = ok && fp.write_domain_u8(e, fp.DOMAIN_OS, os.OS_CATALOG_VERSION, os.os_fingerprint_tag(t.os_id));
    ok = ok && fp.write_domain_str(e, fp.DOMAIN_OS, TARGET_FINGERPRINT_VERSION, t.os.name);

    ok = ok && fp.write_domain_u8(e, fp.DOMAIN_OF, of.OF_FORMAT_CATALOG_VERSION, of.of_fingerprint_tag(t.of.id));
    ok = ok && fp.write_domain_str(e, fp.DOMAIN_OF, TARGET_FINGERPRINT_VERSION, t.of.name);

    ok = ok && fp.write_domain_u32(e, fp.DOMAIN_DEBUG, TARGET_FINGERPRINT_VERSION, t.debug_id);

    var backend_kind: u8 = 0;
    if (isa.emits_whole_module(t.isa)) { backend_kind = 1; }
    ok = ok && fp.write_domain_u8(e, fp.DOMAIN_BACKEND, TARGET_FINGERPRINT_VERSION, backend_kind);

    ok = ok && fp.write_domain_u64(e, fp.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.base);
    ok = ok && fp.write_domain_u64(e, fp.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.page_size);
    ok = ok && fp.write_domain_u64(e, fp.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.stack_reserve);
    ok = ok && fp.write_domain_u64(e, fp.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.stack_commit);
    ok = ok && fp.write_domain_u8(e, fp.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, b2u8(t.variadic_args_on_stack));
    ok = ok && fp.write_domain_u8(e, fp.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, b2u8(t.fixed_args_natural_size));
    ok = ok && fp.write_domain_u32(e, fp.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.va_list_size);
    ok = ok && fp.write_domain_u32(e, fp.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.va_list_align);

    ok = ok && fingerprint_model(?t.model, e);
    ok = ok && fingerprint_fs_policy(?t.fs_policy, e);

    ret ok;
}

fun fingerprint_fs_policy(p: *os.FsPolicy, e: *binary.Encoder) bool {
    var ok: bool      = true;
    val d:  fp.Domain = fp.DOMAIN_FS_POLICY;
    val v:  u8        = TARGET_FINGERPRINT_VERSION;

    ok = ok && fp.write_domain_str(e, d, v, p.sysroot);
    ok = ok && fp.write_domain_str(e, d, v, p.toolchain_root);
    ok = ok && fp.write_domain_str(e, d, v, p.dynamic_interpreter);
    ok = ok && fp.write_domain_str(e, d, v, p.platform_lib);
    ok = ok && fp.write_domain_u32(e, d, v, p.libdir_len);

    var li: u32 = 0;
    for (li < p.libdir_len) {
        ok = ok && fp.write_domain_str(e, d, v, p.libdirs[li]);
        li = li + 1;
    }

    ret ok;
}

fun fingerprint_model(m: *isa.MachineModel, e: *binary.Encoder) bool {
    var ok: bool      = true;
    val d:  fp.Domain = fp.DOMAIN_TARGET_MODEL;
    val v:  u8        = TARGET_FINGERPRINT_VERSION;

    ok = ok && fp.write_domain_u32(e, d, v, m.pointer_width);
    ok = ok && fp.write_domain_u32(e, d, v, m.gpr_width);
    ok = ok && fp.write_domain_u32(e, d, v, m.gp_unaligned_widths);
    ok = ok && fp.write_domain_u32(e, d, v, m.max_alu_width);
    ok = ok && fp.write_domain_u32(e, d, v, m.alu_min_width);
    ok = ok && fp.write_domain_u32(e, d, v, m.spill_width);
    ok = ok && fp.write_domain_u8(e, d, v, m.endianness);
    ok = ok && fp.write_domain_u32(e, d, v, m.reg_class_len);

    var ci: u32 = 0;
    for (ci < m.reg_class_len) {
        ok = ok && fp.write_domain_u8(e, d, v, m.reg_classes[ci].kind);
        ok = ok && fp.write_domain_u32(e, d, v, m.reg_classes[ci].len);
        ci = ci + 1;
    }

    ok = ok && fp.write_domain_u32(e, d, v, m.frame_ptr_reg::u32);
    ok = ok && fp.write_domain_u32(e, d, v, m.stack_ptr_reg::u32);
    ok = ok && fp.write_domain_u32(e, d, v, m.reserved_len::u32);

    var ri: i32 = 0;
    for (ri < m.reserved_len) {
        ok = ok && fp.write_domain_u32(e, d, v, m.reserved_regs[ri].id::u32);
        ok = ok && fp.write_domain_u8(e, d, v, m.reserved_regs[ri].size);
        ri = ri + 1;
    }

    ok = ok && fp.write_domain_u32(e, d, v, m.div_reg::u32);
    ok = ok && fp.write_domain_u32(e, d, v, m.div_hi_reg::u32);
    ok = ok && fp.write_domain_u32(e, d, v, m.shift_count_reg::u32);
    ok = ok && fp.write_domain_u64(e, d, v, m.incoming_arg_base::u64);
    ok = ok && fp.write_domain_u32(e, d, v, m.stack_align);
    ok = ok && fp.write_domain_u32(e, d, v, m.red_zone);
    ok = ok && fp.write_domain_u32(e, d, v, m.shadow_space);
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.has_v128));
    ok = ok && fp.write_domain_u32(e, d, v, m.vector_bits);
    ok = ok && fp.write_domain_u32(e, d, v, m.max_vector_lanes);
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.vector_compute_generic));
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.has_lane_ops));
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.has_vec_build));
    ok = ok && fp.write_domain_u32(e, d, v, m.vec_mem_widths);
    ok = ok && fp.write_domain_u32(e, d, v, m.xbank_widths);
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.ct_trust_mul));
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.has_var_shift));
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.has_mul));
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.has_float));
    ok = ok && fp.write_domain_u32(e, d, v, m.mul_hi_width);
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.flat_addressing));
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.ct_trust_var_shift));
    ok = ok && fp.write_domain_u32(e, d, v, m.packed_form_len);

    var gi: u32 = 0;
    for (gi < m.packed_form_len) {
        ok = ok && fp.write_domain_u32(e, d, v, m.packed_forms[gi].op);
        ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.packed_forms[gi].is_float));
        ok = ok && fp.write_domain_u32(e, d, v, m.packed_forms[gi].lane_bits);
        gi = gi + 1;
    }

    ok = ok && fp.write_domain_u32(e, d, v, m.flen_bits);
    ok = ok && fp.write_domain_u32(e, d, v, m.riscv_extensions);

    ret ok;
}

fun default_of_name(reg: *TargetRegistry, os_vt: *os.OsVTable, isa_vt: *isa.IsaVTable) opt[str] {
    if (!isa.emits_whole_module(isa_vt)) { ret opt[str].some{os_vt.default_of}; }

    var i:   u32 = 0;
    val len: u32 = of.registered_count(?reg.of);
    for (i < len) {
        val of_vt_r: opt[*of.OfVTable] = of.registered(?reg.of, i);
        if (sel of_vt_r.none) { ret opt[str].none{}; }
        val of_vt: *of.OfVTable = of_vt_r.some;
        if (of_vt.object_is_artifact && of.covers_isa(of_vt, isa_vt.id)) {
            ret opt[str].some{of_vt.name};
        }
        i = i + 1;
    }
    ret opt[str].none{};
}

fun no_module_format_message(isa_vt: *isa.IsaVTable) str {
    val fb:    str          = "instruction set emits whole modules, but no registered object format carries one";
    var alloc: A.Allocator;
    val r_655: err[A.Error] = page.make(?alloc);
    if (sel r_655.err) { ret fb; }
    val r: res[str, string.StrError] = str_join(?alloc, "instruction set '", isa_vt.name, "' emits whole modules, but no registered object format carries a finished module for it");
    if (sel r.err) { ret fb; }
    ret r.ok;
}

# the instruction set a selection names: the registered template with a riscv
# selection's extensions applied. model backs the returned vtable's model pointer
# and must outlive it
fun select_isa(arch_vt: *isa.IsaVTable, name: str, rv: rvfeatures.Selection, model: *isa.MachineModel) isa.IsaVTable {
    @model = @arch_vt.model;
    if (rv.width != 0) { riscv.select_features(model, rv.extensions); }
    var selected: isa.IsaVTable = @arch_vt;
    selected.model = model;
    selected.name  = name;
    ret selected;
}

# the instruction set a [target.*] table selects by naming a registered isa: a
# riscv template narrowed to the default extension set its registered name
# parses to, every other template as registered. model backs the returned
# vtable's model pointer and must outlive it
pub fun registered_selection(arch_vt: *isa.IsaVTable, model: *isa.MachineModel) isa.IsaVTable {
    var rv: rvfeatures.Selection;
    rv.width      = 0;
    rv.extensions = 0;
    if (rvfeatures.is_name(arch_vt.name)) {
        val parsed: res[rvfeatures.Selection, fail.Fail] = rvfeatures.parse(arch_vt.name);
        if (sel parsed.ok) { rv = parsed.ok; }
    }
    ret select_isa(arch_vt, arch_vt.name, rv, model);
}

# the capability of one cell of the target matrix as a [target.*] table naming
# these four registered spellings composes it: the registered template alone
# overstates a riscv isa, whose default selection may lack the float registers
# an abi passes in
pub fun registered_tuple_capability(os_vt: *os.OsVTable, arch_vt: *isa.IsaVTable, abi_vt: *abi.AbiVTable, of_vt: *of.OfVTable) u32 {
    var model:    isa.MachineModel;
    val selected: isa.IsaVTable = registered_selection(arch_vt, ?model);
    ret tuple_capability(os_vt, ?selected, abi_vt, of_vt);
}

# the canonical selection string for an instruction set and the model selected
# on it (a resolved target's `model`, or the one registered_selection filled),
# written into buf: a riscv isa spells the extensions the model holds, every
# other isa its name
pub fun selection_spelling(isa_vt: *isa.IsaVTable, model: *isa.MachineModel, buf: *u8, cap: usize) str {
    if (rvfeatures.is_name(isa_vt.name)) {
        ret rvfeatures.spell(model.gpr_width, model.riscv_extensions, buf, cap);
    }
    var off: usize = buf_put(buf, cap, 0, isa_vt.name);
    if (off >= cap) { off = cap - 1; }
    buf[off] = 0;
    ret buf::str;
}

# the request a `native` selection, or a [target.*] table naming the host
# without an object format, resolves: the host os, isa and abi by their
# registered names, the object format left to the os default
pub fun host_request() TargetRequest {
    ret target_request(isa.arch_name_for(host_arch_id()), os.os_name_for(host_os_id()), abi.abi_name_for(host_abi_id()));
}

pub fun select(reg: *TargetRegistry, isa_name: str, os_name: str, abi_name: str) res[resolved.Target, fail.Fail] {
    ret select_of(reg, isa_name, os_name, abi_name, "");
}

pub fun artifact_naming(tgt: *resolved.Target, kind: of.ArtifactOutputKind) res[of.ArtifactName, fail.Fail] {
    if (tgt == nil || tgt.of == nil || tgt.os == nil) {
        ret res[of.ArtifactName, fail.Fail].err{fail.message("artifact naming: target has no selected object format")};
    }
    ret of.artifact_naming(tgt.of, tgt.os.name, kind);
}

pub val TUPLE_OK:              u32 = 0;
val     COMPLETE_TUPLE_CENSUS: u32 = 27;
pub val TUPLE_NO_CODEGEN:      u32 = 1;
pub val TUPLE_ABI_MISMATCH:    u32 = 2;
pub val TUPLE_OS_NO_OF:        u32 = 3;
pub val TUPLE_OF_UNCOVERED:    u32 = 4;
pub val TUPLE_OF_SHAPE:        u32 = 5;
pub val TUPLE_OS_NO_ISA:       u32 = 6;
pub val TUPLE_ABI_NEEDS_FLOAT: u32 = 7;
pub val TUPLE_ABI_TRANSPORT:   u32 = 8;
pub val TUPLE_OS_ABI:          u32 = 9;

rec TupleCapabilitySpec {
    code:  u32;
    label: str;
}

val TUPLE_CAPABILITY_N: usize                                   = 10;
val TUPLE_CAPABILITIES: [TUPLE_CAPABILITY_N]TupleCapabilitySpec = [TUPLE_CAPABILITY_N]TupleCapabilitySpec{
    TupleCapabilitySpec{code: TUPLE_OK, label: "ok"},
    TupleCapabilitySpec{code: TUPLE_NO_CODEGEN, label: "no_codegen"},
    TupleCapabilitySpec{code: TUPLE_ABI_MISMATCH, label: "abi_mismatch"},
    TupleCapabilitySpec{code: TUPLE_OS_NO_OF, label: "os_no_of"},
    TupleCapabilitySpec{code: TUPLE_OF_UNCOVERED, label: "of_uncovered"},
    TupleCapabilitySpec{code: TUPLE_OF_SHAPE, label: "of_shape"},
    TupleCapabilitySpec{code: TUPLE_OS_NO_ISA, label: "os_no_isa"},
    TupleCapabilitySpec{code: TUPLE_ABI_NEEDS_FLOAT, label: "abi_needs_float"},
    TupleCapabilitySpec{code: TUPLE_ABI_TRANSPORT, label: "abi_transport"},
    TupleCapabilitySpec{code: TUPLE_OS_ABI, label: "os_abi"},
};

pub fun tuple_capability(os_vt: *os.OsVTable, isa_vt: *isa.IsaVTable, abi_vt: *abi.AbiVTable, of_vt: *of.OfVTable) u32 {
    if (!isa.has_codegen(isa_vt))           { ret TUPLE_NO_CODEGEN; }
    if (!abi.covers_isa(abi_vt, isa_vt.id)) { ret TUPLE_ABI_MISMATCH; }
    if (abi_vt.passing == abi.PASSING_VALUES) {
        if (!isa.emits_whole_module(isa_vt)) { ret TUPLE_ABI_TRANSPORT; }
    }
    or (abi_vt.passing == abi.PASSING_CARRIERS) {
        if (isa_vt.machine == nil) { ret TUPLE_ABI_TRANSPORT; }
    }
    or                                                              { ret TUPLE_ABI_TRANSPORT; }
    if (abi_vt.float_arg_bits > isa_vt.model.flen_bits)             { ret TUPLE_ABI_NEEDS_FLOAT; }
    if (!os.supports_isa(os_vt, isa_vt.id))                         { ret TUPLE_OS_NO_ISA; }
    if (!os.supports_of(os_vt, of_vt.name))                         { ret TUPLE_OS_NO_OF; }
    if (!of.covers_isa(of_vt, isa_vt.id))                           { ret TUPLE_OF_UNCOVERED; }
    if (isa.emits_whole_module(isa_vt) != of_vt.object_is_artifact) { ret TUPLE_OF_SHAPE; }
    if (!os.accepts_abi(os_vt, isa_vt.id, abi_vt.name))             { ret TUPLE_OS_ABI; }
    ret TUPLE_OK;
}

fun tuple_capability_message(code: u32, os_vt: *os.OsVTable, isa_vt: *isa.IsaVTable, abi_vt: *abi.AbiVTable, of_vt: *of.OfVTable) str {
    if (code == TUPLE_ABI_TRANSPORT) {
        if (abi_vt.passing == abi.PASSING_VALUES) { ret "calling convention passes logical values, which only a whole-module emitter can carry"; }
        ret "calling convention passes physical carriers, which only a register machine can carry";
    }
    var alloc:        A.Allocator;
    val r_726:        err[A.Error] = page.make(?alloc);
    val alloc_failed: bool         = sel r_726.err;

    if (code == TUPLE_NO_CODEGEN) {
        val fb: str = "instruction set has no code generator in this build";
        if (alloc_failed) { ret fb; }
        val r: res[str, string.StrError] = str_join(?alloc, "instruction set '", isa_vt.name, "' has no code generator in this build");
        if (sel r.err) { ret fb; }
        ret r.ok;
    }
    if (code == TUPLE_ABI_MISMATCH) {
        val fb: str = "calling convention does not target the selected instruction set";
        if (alloc_failed) { ret fb; }
        val r: res[str, string.StrError] = str_join(?alloc, "calling convention '", abi_vt.name, "' does not target instruction set '", isa_vt.name, "'");
        if (sel r.err) { ret fb; }
        ret r.ok;
    }
    if (code == TUPLE_ABI_NEEDS_FLOAT) {
        val fb: str = "calling convention passes floats in a float register the instruction set does not have";
        if (alloc_failed) { ret fb; }
        var r: res[str, format.FormatError] = format.sprint(?alloc,
            "calling convention '{}' passes floating-point arguments in {}-bit float registers, but instruction set '{}' has {}-bit float registers",
            abi_vt.name, abi_vt.float_arg_bits, isa_vt.name, isa_vt.model.flen_bits);
        if (rvfeatures.is_name(isa_vt.name)) {
            val absent: u32 = rvfeatures.float_requirement(abi_vt.float_arg_bits) & ~isa_vt.model.riscv_extensions;
            if (absent != 0) {
                var noun: str = "extension";
                if ((absent & (absent - 1)) != 0) { noun = "extensions"; }
                r = format.sprint(?alloc,
                    "calling convention '{}' passes floating-point arguments in {}-bit float registers, but instruction set '{}' has {}-bit float registers: the selection lacks the {} {}",
                    abi_vt.name, abi_vt.float_arg_bits, isa_vt.name, isa_vt.model.flen_bits, rvfeatures.letters(absent), noun);
            }
        }
        if (sel r.err) { ret fb; }
        ret r.ok;
    }
    if (code == TUPLE_OS_NO_ISA) {
        val fb: str = "operating system does not run on the selected instruction set";
        if (alloc_failed) { ret fb; }
        val r: res[str, string.StrError] = str_join(?alloc, "operating system '", os_vt.name, "' does not run on instruction set '", isa_vt.name, "'");
        if (sel r.err) { ret fb; }
        ret r.ok;
    }
    if (code == TUPLE_OS_ABI) {
        val fb: str = "operating system requires its own calling convention on the selected instruction set";
        if (alloc_failed) { ret fb; }
        val accepted: os.AbiSet = os.accepted_abis(os_vt, isa_vt.id);
        if (accepted.len == 0) {
            val r0: res[str, string.StrError] = str_join(?alloc, "operating system '", os_vt.name, "' declares no calling convention on instruction set '",
                isa.arch_name_for(isa_vt.id), "', so '", abi_vt.name, "' cannot host it");
            if (sel r0.err) { ret fb; }
            ret r0.ok;
        }
        if (accepted.len == 1) {
            val r1: res[str, string.StrError] = str_join(?alloc, "operating system '", os_vt.name, "' accepts calling convention '",
                accepted.names[0], "' on instruction set '", isa.arch_name_for(isa_vt.id), "', not '", abi_vt.name, "'");
            if (sel r1.err) { ret fb; }
            ret r1.ok;
        }
        var nb:  [128]u8;
        var off: usize = 0;
        var i:   u32   = 0;
        for (i < accepted.len) {
            if (i > 0) { off = buf_put(?nb[0], 128, off, ", "); }
            off = buf_put(?nb[0], 128, off, "'");
            off = buf_put(?nb[0], 128, off, accepted.names[i]);
            off = buf_put(?nb[0], 128, off, "'");
            i   = i + 1;
        }
        nb[off] = 0;
        val r: res[str, string.StrError] = str_join(?alloc, "operating system '", os_vt.name, "' accepts calling conventions ",
            (?nb[0])::str, " on instruction set '", isa.arch_name_for(isa_vt.id), "', not '", abi_vt.name, "'");
        if (sel r.err) { ret fb; }
        ret r.ok;
    }
    if (code == TUPLE_OS_NO_OF) {
        val fb: str = "operating system does not support the selected object format";
        if (alloc_failed) { ret fb; }
        val r: res[str, string.StrError] = str_join(?alloc, "operating system '", os_vt.name, "' does not support object format '", of_vt.name, "'");
        if (sel r.err) { ret fb; }
        ret r.ok;
    }
    if (code == TUPLE_OF_UNCOVERED) {
        val fb: str = "object format does not cover the selected instruction set's relocations";
        if (alloc_failed) { ret fb; }
        val r: res[str, string.StrError] = str_join(?alloc, "object format '", of_vt.name, "' does not cover ", isa_vt.name, " relocations");
        if (sel r.err) { ret fb; }
        ret r.ok;
    }
    if (code == TUPLE_OF_SHAPE) {
        var emits: str = "linkable objects";
        var takes: str = "finished modules";
        if (isa.emits_whole_module(isa_vt)) {
            emits = "finished modules";
            takes = "linkable objects";
        }
        val fb: str = "object format's emission shape does not match the instruction set's";
        if (alloc_failed) { ret fb; }
        val r: res[str, string.StrError] = str_join(?alloc, "instruction set '", isa_vt.name, "' emits ", emits, ", but object format '", of_vt.name, "' carries ", takes);
        if (sel r.err) { ret fb; }
        ret r.ok;
    }
    panic("target: tuple_capability_message called with an undeclared capability code\n");
    ret "";
}

fun t_debug_provider_failure() res[of.DebugVTable, fail.Fail] {
    ret res[of.DebugVTable, fail.Fail].err{fail.message("injected debug descriptor failure")};
}

fun t_incomplete_debug_provider() res[of.DebugVTable, fail.Fail] {
    var descriptor: of.DebugVTable;
    descriptor.id       = of.DBG_DWARF;
    descriptor.name     = "dwarf";
    descriptor.produce  = nil;
    descriptor.supports = nil;
    ret res[of.DebugVTable, fail.Fail].ok{descriptor};
}

test "mach.lang.target.register_all:publishes_once_and_is_idempotent" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_818: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_818.err)                                                            { ret 1; }
    if (reg.state != treg.REGISTRY_READY || reg.version != treg.REGISTRY_VERSION) { ret 1; }

    val isa_count:   u32            = reg.isa.count;
    val os_count:    u32            = reg.os.count;
    val abi_count:   u32            = reg.abi.count;
    val of_count:    u32            = reg.of.count;
    val debug_count: u32            = reg.debug.count;
    val r_826:       err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_826.err) { ret 1; }
    if (reg.isa.count != isa_count || reg.os.count != os_count || reg.abi.count != abi_count
        || reg.of.count != of_count || reg.debug.count != debug_count) { ret 1; }
    ret 0;
}

test "mach.lang.target.register_all:rejects_partial_state_without_destroying_it" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_835: err[fail.Fail] = x64.register_x64(?reg.isa);
    if (sel r_835.err) { ret 1; }
    val count: u32            = reg.isa.count;
    val r_837: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_837.ok)                                                                   { ret 1; }
    if (reg.state != treg.REGISTRY_FRESH || reg.version != 0 || reg.isa.count != count) { ret 1; }
    val r_839: opt[*isa.IsaVTable] = isa.lookup(?reg.isa, "x86_64");
    if (sel r_839.none) { ret 1; }
    ret 0;
}

