test "mach.lang.target.select:classify_vector_sse_class" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_2034: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2034.err) { ret 1; }
    val tx: res[resolved.Target, fail.Fail] = select_of(?reg, "x86_64", "linux", "sysv64", "");
    if (sel tx.err) { ret 1; }
    val t: resolved.Target = tx.ok;

    val arg: abi.ArgPassingFn = t.abi.arg_passing;
    val a:   abi.ParamSlot    = arg(0, 16, 16, false, 0, false, true, 0, 0, 0, 0, abi.agg_none());
    if (a.class != abi.CLASS_FP) { ret 1; }
    if (a.size != 16)            { ret 1; }

    val rp: abi.RetPassingFn = t.abi.ret_passing;
    val r:  abi.ParamSlot    = rp(16, 16, false, 0, false, true, 0, 0, abi.agg_none());
    if (r.class != abi.CLASS_FP) { ret 1; }
    if (r.size != 16)            { ret 1; }

    ret 0;
}

test "mach.lang.target.select_of:resolves_debug_model" {
    var reg: TargetRegistry = registry_init();
