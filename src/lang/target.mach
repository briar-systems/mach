    if (t.os == nil)                              { ret 1; }
    if (t.os.id != catalog_os.FREESTANDING)       { ret 1; }
    if (!str_equals(t.os.entry_symbol, "_start")) { ret 1; }
    if (!str_equals(t.os.default_of, "raw"))      { ret 1; }
    if (t.os.base_addr != 0)                      { ret 1; }
    if (t.os.page_size != 0)                      { ret 1; }
    if (t.target.page_size != 1)                  { ret 1; }

    if (t.of == nil)              { ret 1; }
    if (t.of.id != target_of.RAW) { ret 1; }
    if (t.of.image_emit == nil)   { ret 1; }

    if (t.abi == nil)                    { ret 1; }
    if (t.abi.id != catalog_abi.SYSV)    { ret 1; }
    if (t.arch == nil)                   { ret 1; }
    if (t.isa.id != catalog_arch.X86_64) { ret 1; }

    ret 0;
}

# the page an image is laid out at comes from the tuple: a page-mapped format on
# a system with no loader of its own takes the isa's hardware page, a flat image
# and a module format have none, and a hosted system's own page stands
test select__page_size_comes_from_the_tuple {
    val reg: *TargetRegistry = t_registry();

    val elf_r: res[binding.Binding, fail.Fail] = select_of(reg, "x86_64", "freestanding", "sysv64", "elf");
    if (sel elf_r.err)                     { ret 2; }
    if (elf_r.ok.target.page_size != 4096) { ret 3; }
    val arm_r: res[binding.Binding, fail.Fail] = select_of(reg, "aarch64", "freestanding", "aapcs64", "elf");
    if (sel arm_r.err)                     { ret 4; }
    if (arm_r.ok.target.page_size != 4096) { ret 5; }
    val rv_r: res[binding.Binding, fail.Fail] = select_of(reg, "riscv32", "freestanding", "ilp32", "elf");
    if (sel rv_r.err)                     { ret 6; }
    if (rv_r.ok.target.page_size != 4096) { ret 7; }

    val raw_r: res[binding.Binding, fail.Fail] = select_of(reg, "x86_64", "freestanding", "sysv64", "raw");
    if (sel raw_r.err)                  { ret 8; }
    if (raw_r.ok.target.page_size != 1) { ret 9; }
    val spv_r: res[binding.Binding, fail.Fail] = select_of(reg, "spirv", "freestanding", "spirv", "spv");
    if (sel spv_r.err)                  { ret 10; }
    if (spv_r.ok.target.page_size != 1) { ret 11; }

    val linux_r: res[binding.Binding, fail.Fail] = select_of(reg, "aarch64", "linux", "aapcs64", "elf");
    if (sel linux_r.err)                      { ret 12; }
    if (linux_r.ok.target.page_size != 65536) { ret 13; }
    ret 0;
}

# a page-mapped format with no page from either the system or the isa is refused
# at selection, naming all three
test tuple_page_size__refuses_a_page_mapped_format_without_a_page {
    var t_alloc: A.Allocator;
    val t_made:  err[A.Error] = page.make(?t_alloc);
    if (sel t_made.err) { ret 90; }
    var os_vt: lang_target_os.OsVTable;
    os_vt.name      = "nowhere";
    os_vt.page_size = 0;
    var arch_vt: isa.IsaVTable = isa.IsaVTable{id: catalog_arch.X86_64, name: "pageless", pointer_width: 8};
    var of_vt:   target_of.OfVTable;
    of_vt.name         = "mapped";
    of_vt.maps_by_page = true;

    val r: res[u64, fail.Fail] = tuple_page_size(?t_alloc, ?os_vt, ?arch_vt, ?of_vt);
    if (!sel r.err) { ret 1; }
    val diag: str = fail.describe(r.err);
    if (!str_contains(diag, "mapped"))   { ret 2; }
    if (!str_contains(diag, "nowhere"))  { ret 3; }
    if (!str_contains(diag, "pageless")) { ret 4; }

    of_vt.maps_by_page = false;
    val flat: res[u64, fail.Fail] = tuple_page_size(?t_alloc, ?os_vt, ?arch_vt, ?of_vt);
    if (sel flat.err) { ret 5; }
    if (flat.ok != 1) { ret 6; }
    of_vt.maps_by_page = true;
    arch_vt.page_size  = 4096;
    val hw: res[u64, fail.Fail] = tuple_page_size(?t_alloc, ?os_vt, ?arch_vt, ?of_vt);
    if (sel hw.err)    { ret 7; }
    if (hw.ok != 4096) { ret 8; }
    os_vt.page_size = 16384;
    val hosted: res[u64, fail.Fail] = tuple_page_size(?t_alloc, ?os_vt, ?arch_vt, ?of_vt);
    if (sel hosted.err)     { ret 9; }
    if (hosted.ok != 16384) { ret 10; }
    ret 0;
}

