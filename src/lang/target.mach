    val tc: R.Result[resolved.Target, str] = select_of(?reg, "x86_64", "windows", "win64", "coff");
    if (R.is_err[resolved.Target, str](tc)) { ret 1; }
    val ct: resolved.Target = R.unwrap_ok[resolved.Target, str](tc);
