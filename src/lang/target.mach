test "mach.lang.target.select:vector_lane_ceiling" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_1959: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1959.err) { ret 1; }

    val tx: res[resolved.Target, fail.Fail] = select_of(?reg, "x86_64", "linux", "sysv64", "");
    if (sel tx.err) { ret 1; }
    val mx: isa.MachineModel = tx.ok.model;
    if (mx.max_vector_lanes != isa.VECTOR_LANES_UNBOUNDED)      { ret 1; }
    if (isa.packed_lane_cap(?mx, 8) != 16)                      { ret 1; }
    if (isa.packed_lane_cap(?mx, 32) != 4)                      { ret 1; }
    if (isa.packed_width(?mx, isa.VEC_OP_ADD, false, 8) != 128) { ret 1; }

    val ta: res[resolved.Target, fail.Fail] = select_of(?reg, "aarch64", "linux", "aapcs64", "");
    if (sel ta.err) { ret 1; }
    val ma: isa.MachineModel = ta.ok.model;
    if (ma.max_vector_lanes != isa.VECTOR_LANES_UNBOUNDED)      { ret 1; }
    if (isa.packed_width(?ma, isa.VEC_OP_ADD, false, 8) != 128) { ret 1; }

    val tr: res[resolved.Target, fail.Fail] = select_of(?reg, "riscv64", "linux", "lp64d", "");
    if (sel tr.err)                                                 { ret 1; }
    if (tr.ok.model.max_vector_lanes != isa.VECTOR_LANES_UNBOUNDED) { ret 1; }

    val ts: res[resolved.Target, fail.Fail] = select_of(?reg, "spirv", "freestanding", "spirv", "spv");
    if (sel ts.err) { ret 1; }
    val ms: isa.MachineModel = ts.ok.model;
    if (ms.max_vector_lanes != 4)                                { ret 1; }
    if (isa.packed_lane_cap(?ms, 8) != 4)                        { ret 1; }
    if (isa.packed_width(?ms, isa.VEC_OP_ADD, false, 8) != 32)   { ret 1; }
    if (isa.packed_width(?ms, isa.VEC_OP_ADD, false, 32) != 128) { ret 1; }
    val mr: isa.MachineModel = tr.ok.model;
    if (mx.packed_form_len != 39 || ma.packed_form_len != 41
        || ms.packed_form_len != 46 || mr.packed_form_len != 0) { ret 2; }
    var bits: u32 = 8;
    for (bits <= 64) {
        if (isa.packed_width(?mx, isa.VEC_OP_DIV, false, bits) != 0
            || isa.packed_width(?ma, isa.VEC_OP_DIV, false, bits) != 0
            || isa.packed_width(?mr, isa.VEC_OP_ADD, false, bits) != 0) { ret 3; }
        if (isa.packed_width(?ms, isa.VEC_OP_DIV, false, bits) == 0) { ret 4; }
        val xmul: bool = isa.packed_width(?mx, isa.VEC_OP_MUL, false, bits) != 0;
        val amul: bool = isa.packed_width(?ma, isa.VEC_OP_MUL, false, bits) != 0;
        if (xmul != (bits == 16) || amul != (bits != 64)) { ret 5; }
        bits = bits * 2;
    }
    if (isa.packed_width(?mx, isa.VEC_OP_DIV, true, 64) != 128
        || isa.packed_width(?ma, isa.VEC_OP_DIV, true, 32) != 128) { ret 6; }
    if (isa.packed_width(?mx, 999, false, 32) != 0
        || isa.packed_width(?ms, isa.VEC_OP_AND, true, 32) != 0
        || isa.packed_width(?ma, isa.VEC_OP_SHL, false, 32) != 0) { ret 7; }
    ret 0;
}

