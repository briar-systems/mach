    val lx: res[resolved.Target, fail.Fail] = select(?reg, "x86_64", "linux", "sysv64");
    if (sel lx.err)                   { ret 1; }
    if (lx.ok.variadic_args_on_stack) { ret 1; }

    ret 0;
}

