test "mach.lang.target.artifact_naming:compatibility_key_matches_only_the_same_object_format" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_2468: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2468.err) { ret 1; }

    val elf_o:  opt[*of.OfVTable] = of.lookup(?reg.of, "elf");
    val coff_o: opt[*of.OfVTable] = of.lookup(?reg.of, "coff");
    if (sel elf_o.none)  { ret 1; }
    if (sel coff_o.none) { ret 1; }
    val elf_vt:  *of.OfVTable = elf_o.some;
    val coff_vt: *of.OfVTable = coff_o.some;

    val a_r: res[of.ArtifactName, fail.Fail] = of.artifact_naming(elf_vt, "linux", of.ARTIFACT_OBJECT);
    if (sel a_r.err) { ret 1; }
    val a:   of.ArtifactName                 = a_r.ok;
    val b_r: res[of.ArtifactName, fail.Fail] = of.artifact_naming(elf_vt, "linux", of.ARTIFACT_EXECUTABLE);
    if (sel b_r.err) { ret 1; }
    val b:   of.ArtifactName                 = b_r.ok;
    val c_r: res[of.ArtifactName, fail.Fail] = of.artifact_naming(coff_vt, "windows", of.ARTIFACT_OBJECT);
    if (sel c_r.err) { ret 1; }
    val c: of.ArtifactName = c_r.ok;

    if (!str_equals(a.key, b.key)) { ret 1; }
    if (str_equals(a.key, c.key))  { ret 1; }
    ret 0;
}

test "mach.lang.target.select_of:every_capable_tuple_is_selectable_and_the_census_is_stable" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_2489: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2489.err) { ret 1; }

    var capable:    u32 = 0;
    var selectable: u32 = 0;
    var oi:         u32 = 0;
    for (oi < os.registered_count(?reg.os)) {
        val os_vt_r: opt[*os.OsVTable] = os.registered(?reg.os, oi);
        if (sel os_vt_r.none) { ret 1; }
        val os_vt: *os.OsVTable = os_vt_r.some;
        var ii:    u32          = 0;
        for (ii < isa.registered_count(?reg.isa)) {
            val isa_vt_r: opt[*isa.IsaVTable] = isa.registered(?reg.isa, ii);
            if (sel isa_vt_r.none) { ret 1; }
            val isa_vt: *isa.IsaVTable = isa_vt_r.some;
            var ai:     u32            = 0;
            for (ai < abi.registered_count(?reg.abi)) {
                val abi_vt_r: opt[*abi.AbiVTable] = abi.registered(?reg.abi, ai);
                if (sel abi_vt_r.none) { ret 1; }
                val abi_vt: *abi.AbiVTable = abi_vt_r.some;
                var fi:     u32            = 0;
                for (fi < of.registered_count(?reg.of)) {
                    val of_vt_r: opt[*of.OfVTable] = of.registered(?reg.of, fi);
                    if (sel of_vt_r.none) { ret 1; }
                    val of_vt: *of.OfVTable = of_vt_r.some;
                    if (tuple_capability(os_vt, isa_vt, abi_vt, of_vt) == TUPLE_OK) {
                        capable = capable + 1;
                        var concrete_isa: str = isa_vt.name;
                        if (isa_vt.id == isa.ARCH_RISCV32) { concrete_isa = "rv32imafdc"; }
                        val r: res[resolved.Target, fail.Fail] = select_of(?reg, concrete_isa, os_vt.name, abi_vt.name, of_vt.name);
                        if (sel r.ok) { selectable = selectable + 1; }
                    }
                    fi = fi + 1;
                }
                ai = ai + 1;
            }
            ii = ii + 1;
        }
        oi = oi + 1;
    }
    if (capable == 0)          { ret 1; }
    if (selectable != capable) { ret 2; }
    if (capable != COMPLETE_TUPLE_CENSUS) {
        print.printf("complete-target census: {} capable tuples, expected {}\n", capable, COMPLETE_TUPLE_CENSUS);
        ret 3;
    }
    ret 0;
}

test "mach.lang.target.registry:every_isa_declares_its_index_and_vector_axes" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_2529: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2529.err) { ret 1; }
    var ii: u32 = 0;
    for (ii < isa.registered_count(?reg.isa)) {
        val isa_vt_r: opt[*isa.IsaVTable] = isa.registered(?reg.isa, ii);
        if (sel isa_vt_r.none) { ret 1; }
        val isa_vt: *isa.IsaVTable    = isa_vt_r.some;
        val m:      *isa.MachineModel = isa_vt.model;
        if (m.index_width == 0)                          { ret 2; }
        if (m.has_v128 && m.vector_op_bytes == 0)        { ret 3; }
        if (m.auto_vectorize && !m.vectors_in_registers) { ret 4; }
        ii = ii + 1;
    }
    ret 0;
}

test "mach.lang.target.resolve:env_is_member_owned_and_unknown_or_undefined_values_are_refused" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_2545: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2545.err) { ret 1; }

    var gpu: TargetRequest = target_request("spirv", "freestanding", "spirv");
    with_env(?gpu, "vulkan1.2", "gpu");
    val ok: res[resolved.Target, fail.Fail] = resolve(?reg, ?gpu);
    if (sel ok.err) { ret 2; }
    val t: resolved.Target = ok.ok;
    if (t.env_id != 2 || !str_equals(t.env_name, "vulkan1.2") || t.env_profile != 2) { ret 3; }
    val view: isa.BackendTarget = resolved.backend_target(?t);
    if (view.identity.env_id != 2 || !str_equals(view.identity.env_name, "vulkan1.2")) { ret 4; }

    var none:  TargetRequest                   = target_request("spirv", "freestanding", "spirv");
    val plain: res[resolved.Target, fail.Fail] = resolve(?reg, ?none);
    if (sel plain.err)                   { ret 5; }
    if (plain.ok.env_id != isa.ENV_NONE) { ret 5; }

    var bogus: TargetRequest = target_request("spirv", "freestanding", "spirv");
    with_env(?bogus, "vulkan9.9", "gpu");
    val rejected: res[resolved.Target, fail.Fail] = resolve(?reg, ?bogus);
    if (sel rejected.ok) { ret 6; }
    val msg: str = fail.describe(rejected.err);
    if (!str_contains(msg, "[target.gpu]") || !str_contains(msg, "vulkan9.9") || !str_contains(msg, "vulkan1.0")
        || !str_contains(msg, "vulkan1.3") || !str_contains(msg, "does not define")) { ret 7; }

    var cpu: TargetRequest = target_request("x86_64", "linux", "sysv64");
    with_env(?cpu, "vulkan1.2", "host");
    val undefined: res[resolved.Target, fail.Fail] = resolve(?reg, ?cpu);
    if (sel undefined.ok) { ret 8; }
    val umsg: str = fail.describe(undefined.err);
    if (!str_contains(umsg, "[target.host]") || !str_contains(umsg, "defines no environments")) { ret 9; }
    ret 0;
}

fun t_publication_open(operation: *publication.Plan, alloc: *A.Allocator, name: str) res[*publication.Destination, fail.Fail] {
    val initialized: err[txn.Error] = publication.plan_init(operation, alloc);
    if (sel initialized.err) { ret res[*publication.Destination, fail.Fail].err{fail.message(txn.error_message(initialized.err))}; }
    val destination: res[*publication.Destination, outcome.Fail] = publication.plan_add(operation, name, false);
    if (sel destination.err) { ret res[*publication.Destination, fail.Fail].err{fail.message(outcome.describe(destination.err))}; }
    val sealed: err[txn.Error] = publication.plan_seal(operation);
    if (sel sealed.err)      { ret res[*publication.Destination, fail.Fail].err{fail.message(txn.error_message(sealed.err))}; }
    if (sel destination.err) { ret res[*publication.Destination, fail.Fail].err{fail.message(outcome.describe(destination.err))}; }
    ret res[*publication.Destination, fail.Fail].ok{destination.ok};
}

fun t_publication_close(operation: *publication.Plan, result: err[fail.Fail]) err[fail.Fail] {
    val closed: err[txn.Error] = publication.plan_dnit(operation);
    if (sel closed.err) {
        if (sel result.ok) { ret err[fail.Fail].err{fail.message(txn.error_message(closed.err))}; }
    }
    ret result;
}

rec Walk {
    depth: u32;
}

# the operation under the probe: one heap registry born, published and
# borrowed; the registry comes back through `out` for the attempt to release
# whichever way the operation ended. a nonzero `bad` is the fixture's own
# contract failure, not a refusal
fun t_registry_build(owner: *A.Allocator, out: **TargetRegistry, bad: *i32) err[fail.Fail] {
    val made: res[*TargetRegistry, fail.Fail] = registry_new(owner);
    if (sel made.err) { ret err[fail.Fail].err{made.err}; }
    val reg: *TargetRegistry = made.ok;
    @out = reg;
    if (reg.owner != owner || reg.state != treg.REGISTRY_FRESH) {
        @bad = 20;
        ret err[fail.Fail].ok{};
    }
    val published: err[fail.Fail] = register_all(reg, target_testing.debug_descriptor);
    if (sel published.err) {
        if (reg.state != treg.REGISTRY_FRESH || !treg.registry_empty(reg)) { @bad = 24; }
        ret published;
    }
    if (!registry_published(reg)) {
        @bad = 21;
        ret err[fail.Fail].ok{};
    }
    val selected: res[resolved.Target, fail.Fail] = select(reg, "x86_64", "linux", "sysv64");
    if (sel selected.err) { ret err[fail.Fail].err{selected.err}; }
    var t: resolved.Target = selected.ok;
    if (t.registry != reg) {
        @bad = 22;
        ret err[fail.Fail].ok{};
    }
    val borrow: err[fail.Fail] = resolved.live(?t);
    if (sel borrow.err) { @bad = 23; }
    ret err[fail.Fail].ok{};
}

# at ordinal zero everything succeeds; at every other ordinal the refusal
# comes back typed as the allocation layer's text, and either way the probe
# ends clean, which is the leak check
fun t_registry_attempt(w: *Walk, p: *probe.Probe) i32 {
    val owner: *A.Allocator = probe.allocator_of(p);
    probe.arm(p);
    var reg:     *TargetRegistry = nil;
    var bad:     i32             = 0;
    val outcome: err[fail.Fail]  = t_registry_build(owner, ?reg, ?bad);
    registry_dnit(reg);
    probe.clear_failure(p);
    if (bad != 0) { ret bad; }
    if (p.ordinal == 0) {
        if (sel outcome.err) { ret 3; }
        ret 0;
    }
    if (sel outcome.ok) { ret 4; }
    val text:     str  = fail.describe(outcome.err);
    val expected: bool = str_equals(text, alloc.text(A.Error.exhausted{}));
    if (probe.owns(p, text::ptr)) { str_free(owner, text); }
    if (!expected) {
        print.eprintlnf("refusal text: {}", text);
        ret 5;
    }
    ret 0;
}

test "mach.lang.target.registry:heap_registry_fail_at_n_releases_everything" {
    var w:   Walk          = Walk{depth: 0};
    val out: probe.Outcome = probe.walk[Walk](?w, t_registry_attempt);
    if (out.code != 0) {
        print.eprintlnf("fail-at-N: code {} at ordinal {} of {} requests", out.code, out.ordinal, out.attempts);
    }
    ret out.code;
}

# a target borrowed from a released registry is refused, not followed; the
# in-place form keeps the storage alive so the refusal reads a released
# state and never a freed block
test "mach.lang.target.registry:target_used_after_dnit_is_refused_and_release_is_terminal" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val published: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel published.err) { ret 1; }
    val selected: res[resolved.Target, fail.Fail] = select(?reg, "x86_64", "linux", "sysv64");
    if (sel selected.err) { ret 2; }
    var t: resolved.Target = selected.ok;
    if (t.registry != ?reg) { ret 3; }
    val before: err[fail.Fail] = resolved.live(?t);
    if (sel before.err) { ret 4; }

    registry_dnit(?reg);
    if (reg.state != treg.REGISTRY_RELEASED) { ret 5; }
    val after: err[fail.Fail] = resolved.live(?t);
    if (sel after.ok)                                                     { ret 6; }
    if (!str_contains(fail.describe(after.err), "outlived the registry")) { ret 7; }

    val again: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel again.ok)                                                 { ret 8; }
    if (!str_contains(fail.describe(again.err), "released registry")) { ret 9; }
    val resolve_again: res[resolved.Target, fail.Fail] = select(?reg, "x86_64", "linux", "sysv64");
    if (sel resolve_again.ok) { ret 10; }
    registry_dnit(?reg);
    if (reg.state != treg.REGISTRY_RELEASED) { ret 11; }
    ret 0;
}

# a publication that fails part way rolls back to fresh, and a fresh
# registry publishes; a copy of a resolved target keeps the same borrow
test "mach.lang.target.registry:heap_registry_is_owned_once_and_borrowed_by_copies" {
    var backing:      A.Allocator;
    val made_backing: err[A.Error] = page.make(?backing);
    if (sel made_backing.err) { ret 1; }
    val made: res[*TargetRegistry, fail.Fail] = registry_new(?backing);
    if (sel made.err) { ret 2; }
    val reg:       *TargetRegistry = made.ok;
    val published: err[fail.Fail]  = register_all(reg, target_testing.debug_descriptor);
    if (sel published.err) {
        registry_dnit(reg);
        ret 3;
    }
    val selected: res[resolved.Target, fail.Fail] = select(reg, "aarch64", "darwin", "aapcs64");
    if (sel selected.err) {
        registry_dnit(reg);
        ret 4;
    }
    val first: resolved.Target = selected.ok;
    val copy:  resolved.Target = first;
    if (copy.registry != reg || copy.isa != first.isa || copy.os != first.os) {
        registry_dnit(reg);
        ret 5;
    }
    val borrow: err[fail.Fail] = resolved.live(?copy);
    if (sel borrow.err) {
        registry_dnit(reg);
        ret 6;
    }
    registry_dnit(reg);
    ret 0;
}
