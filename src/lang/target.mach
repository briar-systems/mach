pub fun host_os_id() u32 {
    $if ($mach.build.os == $mach.os.linux)   { ret os.OS_LINUX; }
    $or ($mach.build.os == $mach.os.darwin)  { ret os.OS_DARWIN; }
    $or ($mach.build.os == $mach.os.windows) { ret os.OS_WINDOWS; }
    $or                                      { ret os.OS_UNKNOWN; }
}

pub fun host_arch_id() u32 {
    $if ($mach.build.arch == $mach.arch.x86_64)  { ret isa.ARCH_X86_64; }
    $or ($mach.build.arch == $mach.arch.aarch64) { ret isa.ARCH_AARCH64; }
    $or ($mach.build.arch == $mach.arch.riscv64) { ret isa.ARCH_RISCV64; }
    $or                                          { ret isa.ARCH_UNKNOWN; }
}

pub fun host_pointer_width() u32 {
    ret ($mach.build.pointer_width)::u32;
}

pub fun host_va_list() O.Option[os.VaList] {
    $if ($mach.build.os == $mach.os.linux)   { ret linux.linux_va_list(host_arch_id()); }
    $or ($mach.build.os == $mach.os.darwin)  { ret darwin.darwin_va_list(host_arch_id()); }
    $or ($mach.build.os == $mach.os.windows) { ret windows.windows_va_list(host_arch_id()); }
    $or                                      { ret freestanding.freestanding_va_list(host_arch_id()); }
}

pub fun host_abi_id() u32 {
    ret ($mach.build.abi)::u32;
}

pub rec TargetRegistry {
    isa:   isa.IsaRegistry;
    os:    os.OsRegistry;
    abi:   abi.AbiRegistry;
    of:    of.OfRegistry;
    debug: of.DebugRegistry;
    state: u8;
    version: u32;
}

pub def DebugDescriptorProvider: fun() R.Result[of.DebugVTable, str];

val REGISTRY_FRESH:    u8 = 0;
val REGISTRY_BUILDING: u8 = 1;
val REGISTRY_READY:    u8 = 2;
val REGISTRY_VERSION: u32 = 1;

pub fun registry_init() TargetRegistry {
    var reg: TargetRegistry;
    reg.isa   = isa.registry_init();
    reg.os    = os.registry_init();
    reg.abi   = abi.registry_init();
    reg.of    = of.registry_init();
    reg.debug = of.debug_registry_init();
    reg.state = REGISTRY_FRESH;
    reg.version = 0;
    ret reg;
}

pub fun registry_dnit(reg: *TargetRegistry) {
    if (reg == nil) { ret; }
    isa.registry_dnit(?reg.isa);
    os.registry_dnit(?reg.os);
    abi.registry_dnit(?reg.abi);
    of.registry_dnit(?reg.of);
    of.debug_registry_dnit(?reg.debug);
    reg.state = REGISTRY_FRESH;
    reg.version = 0;
}

fun registry_empty(reg: *TargetRegistry) bool {
    ret reg != nil && reg.isa.count == 0 && reg.os.count == 0 && reg.abi.count == 0
        && reg.of.count == 0 && reg.debug.count == 0;
}

fun isa_identity(reg: *TargetRegistry, name: str, id: u32) bool {
    val found: O.Option[*isa.IsaVTable] = isa.lookup(?reg.isa, name);
    ret O.is_some[*isa.IsaVTable](found) && O.unwrap[*isa.IsaVTable](found).id == id;
}

fun os_identity(reg: *TargetRegistry, name: str, id: u32) bool {
    val found: O.Option[*os.OsVTable] = os.lookup(?reg.os, name);
    ret O.is_some[*os.OsVTable](found) && O.unwrap[*os.OsVTable](found).id == id;
}

fun abi_identity(reg: *TargetRegistry, name: str, id: u32) bool {
    val found: O.Option[*abi.AbiVTable] = abi.lookup(?reg.abi, name);
    ret O.is_some[*abi.AbiVTable](found) && O.unwrap[*abi.AbiVTable](found).id == id;
}

fun of_identity(reg: *TargetRegistry, name: str, id: u32) bool {
    val found: O.Option[*of.OfVTable] = of.lookup(?reg.of, name);
    ret O.is_some[*of.OfVTable](found) && O.unwrap[*of.OfVTable](found).id == id;
}

fun production_registry_complete(reg: *TargetRegistry) bool {
    if (reg == nil) { ret false; }
    if (R.is_err[R.Void, str](isa.registry_validate(?reg.isa))
        || R.is_err[R.Void, str](os.registry_validate(?reg.os))
        || R.is_err[R.Void, str](abi.registry_validate(?reg.abi))
        || R.is_err[R.Void, str](of.registry_validate(?reg.of))
        || R.is_err[R.Void, str](of.debug_registry_validate(?reg.debug))) { ret false; }
    if (isa.registered_count(?reg.isa) < 6
        || !isa_identity(reg, "x86_64", isa.ARCH_X86_64)
        || !isa_identity(reg, "aarch64", isa.ARCH_AARCH64)
        || !isa_identity(reg, "riscv64", isa.ARCH_RISCV64)
        || !isa_identity(reg, "riscv32", isa.ARCH_RISCV32)
        || !isa_identity(reg, "spirv", isa.ARCH_SPIRV)
        || !isa_identity(reg, "mos6502", isa.ARCH_MOS6502)) { ret false; }
    if (os.registered_count(?reg.os) < 4
        || !os_identity(reg, "linux", os.OS_LINUX)
        || !os_identity(reg, "darwin", os.OS_DARWIN)
        || !os_identity(reg, "windows", os.OS_WINDOWS)
        || !os_identity(reg, "freestanding", os.OS_FREESTANDING)) { ret false; }
    if (abi.registered_count(?reg.abi) < 11
        || !abi_identity(reg, "sysv64", abi.ABI_SYSV)
        || !abi_identity(reg, "win64", abi.ABI_WIN64)
        || !abi_identity(reg, "aapcs64", abi.ABI_AAPCS64)
        || !abi_identity(reg, "lp64", abi.ABI_LP64)
        || !abi_identity(reg, "lp64f", abi.ABI_LP64F)
        || !abi_identity(reg, "lp64d", abi.ABI_LP64D)
        || !abi_identity(reg, "ilp32", abi.ABI_ILP32)
        || !abi_identity(reg, "ilp32f", abi.ABI_ILP32F)
        || !abi_identity(reg, "ilp32d", abi.ABI_ILP32D)
        || !abi_identity(reg, "spirv", abi.ABI_SPIRV)
        || !abi_identity(reg, "mos6502", abi.ABI_UNKNOWN)) { ret false; }
    if (of.registered_count(?reg.of) < 5
        || !of_identity(reg, "elf", of.OF_ELF)
        || !of_identity(reg, "coff", of.OF_COFF)
        || !of_identity(reg, "macho", of.OF_MACHO)
        || !of_identity(reg, "raw", of.OF_RAW)
        || !of_identity(reg, "spv", of.OF_SPV)) { ret false; }
    if (of.debug_registered_count(?reg.debug) == 0
        || R.is_err[R.Void, str](of.debug_hooks_complete(?reg.debug))) { ret false; }
    var i: u32 = 0;
    for (i < of.registered_count(?reg.of)) {
        val fmt_o: O.Option[*of.OfVTable] = of.registered(?reg.of, i);
        if (O.is_none[*of.OfVTable](fmt_o)) { ret false; }
        val fmt: *of.OfVTable = O.unwrap[*of.OfVTable](fmt_o);
        if (!str_empty(fmt.default_debug)) {
            val dbg_o: O.Option[*of.DebugVTable] = of.debug_lookup(?reg.debug, fmt.default_debug);
            if (O.is_none[*of.DebugVTable](dbg_o)) { ret false; }
            val dbg: *of.DebugVTable = O.unwrap[*of.DebugVTable](dbg_o);
            if (dbg.produce == nil) { ret false; }
            if (str_equals(fmt.default_debug, "dwarf") && dbg.id != of.DBG_DWARF) { ret false; }
        }
        i = i + 1;
    }
    ret true;
}

pub fun register_all(reg: *TargetRegistry, debug_provider: DebugDescriptorProvider) R.Result[R.Void, str] {
    if (reg == nil || debug_provider == nil) {
        ret R.err[R.Void, str]("target: register_all requires a registry and debug descriptor provider");
    }
    if (reg.state == REGISTRY_READY) {
        if (reg.version == REGISTRY_VERSION && production_registry_complete(reg)) {
            ret R.ok_void[str]();
        }
        ret R.err[R.Void, str]("target: published registry invariants do not match this catalog version");
    }
    if (reg.state != REGISTRY_FRESH || !registry_empty(reg)) {
        ret R.err[R.Void, str]("target: register_all refuses a partial or foreign registry");
    }
    reg.state = REGISTRY_BUILDING;
    var res: R.Result[R.Void, str] = x64.register_x64(?reg.isa);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = arm64.register_arm64(?reg.isa);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = riscv.register_riscv64(?reg.isa);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = riscv.register_riscv32(?reg.isa);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = spirv.register_spirv(?reg.isa);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = m6502.register_mos6502(?reg.isa);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }

    res = sysv.register(?reg.abi);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = win64.register_win64(?reg.abi);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = aapcs64.register(?reg.abi);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = rvabi.register(?reg.abi);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = sabi.register(?reg.abi);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = mos6502.register(?reg.abi);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }

    res = elf.register(?reg.of);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = coff.register_coff(?reg.of);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = macho.register_macho(?reg.of);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = raw.register(?reg.of);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = spv.register(?reg.of);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }

    res = linux.register_linux(?reg.os);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = darwin.register_darwin(?reg.os);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = windows.register_windows(?reg.os);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = freestanding.register_freestanding(?reg.os);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }

    val debug_r: R.Result[of.DebugVTable, str] = debug_provider();
    if (R.is_err[of.DebugVTable, str](debug_r)) {
        val debug_err: str = R.unwrap_err[of.DebugVTable, str](debug_r);
        registry_dnit(reg);
        ret R.err[R.Void, str](debug_err);
    }
    var debug_descriptor: of.DebugVTable = R.unwrap_ok[of.DebugVTable, str](debug_r);
    res = of.debug_register(?reg.debug, ?debug_descriptor);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    res = of.debug_hooks_complete(?reg.debug);
    if (R.is_err[R.Void, str](res)) { registry_dnit(reg); ret res; }
    if (!production_registry_complete(reg)) {
        registry_dnit(reg);
        ret R.err[R.Void, str]("target: registrar did not construct the complete production registry");
    }

    reg.version = REGISTRY_VERSION;
    reg.state = REGISTRY_READY;

    ret R.ok_void[str]();
}

pub rec TargetRequest {
    isa_name:      str;
    os_name:       str;
    abi_name:      str;
    of_name:       str;
    base:          u64;
    stack_reserve: u64;
    stack_commit:  u64;
    env_name:      str;
    label:         str;
}

pub fun target_request(isa_name: str, os_name: str, abi_name: str) TargetRequest {
    var r: TargetRequest;
    r.isa_name      = isa_name;
    r.os_name       = os_name;
    r.abi_name      = abi_name;
    r.of_name       = "";
    r.base          = 0;
    r.stack_reserve = 0;
    r.stack_commit  = 0;
    ret r;
}

pub fun with_of(req: *TargetRequest, of_name: str) {
    req.of_name = of_name;
}

pub fun with_env(req: *TargetRequest, env_name: str, label: str) {
    req.env_name = env_name;
    req.label    = label;
}

pub fun with_image(req: *TargetRequest, base: u64, stack_reserve: u64, stack_commit: u64) {
    req.base          = base;
    req.stack_reserve = stack_reserve;
    req.stack_commit  = stack_commit;
}

pub fun select_of(reg: *TargetRegistry, isa_name: str, os_name: str, abi_name: str, of_name: str) R.Result[resolved.Target, str] {
    var req: TargetRequest = target_request(isa_name, os_name, abi_name);
    with_of(?req, of_name);
    ret resolve(reg, ?req);
}

pub fun resolve(reg: *TargetRegistry, req: *TargetRequest) R.Result[resolved.Target, str] {
    if (reg == nil || req == nil) {
        ret R.err[resolved.Target, str]("target: resolve requires a registry and target request");
    }
    if (reg.state != REGISTRY_READY || reg.version != REGISTRY_VERSION
        || !production_registry_complete(reg)) {
        ret R.err[resolved.Target, str]("target: resolve requires a published registry at the current catalog version");
    }
    val isa_name: str = req.isa_name;
    val os_name:  str = req.os_name;
    val abi_name: str = req.abi_name;
    val of_name:  str = req.of_name;

    val opt_os_vt: O.Option[*os.OsVTable] = os.lookup(?reg.os, os_name);
    if (O.is_none[*os.OsVTable](opt_os_vt)) {
        var nb: [256]u8;
        ret R.err[resolved.Target, str](unregistered_message("os", os_name, registered_names(reg, DIM_OS, ?nb[0], 256)));
    }
    val os_vt: *os.OsVTable = O.unwrap[*os.OsVTable](opt_os_vt);

    val opt_arch_vt: O.Option[*isa.IsaVTable] = isa.lookup(?reg.isa, isa_name);
    if (O.is_none[*isa.IsaVTable](opt_arch_vt)) {
        var nb: [256]u8;
        ret R.err[resolved.Target, str](unregistered_message("isa", isa_name, registered_names(reg, DIM_ISA, ?nb[0], 256)));
    }
    val opt_abi_vt: O.Option[*abi.AbiVTable] = abi.lookup(?reg.abi, abi_name);
    if (O.is_none[*abi.AbiVTable](opt_abi_vt)) {
        var nb: [256]u8;
        ret R.err[resolved.Target, str](unregistered_message("abi", abi_name, registered_names(reg, DIM_ABI, ?nb[0], 256)));
    }

    val arch_vt: *isa.IsaVTable = O.unwrap[*isa.IsaVTable](opt_arch_vt);
    val abi_vt:  *abi.AbiVTable = O.unwrap[*abi.AbiVTable](opt_abi_vt);

    var of_sel: str = of_name;
    if (str_empty(of_sel)) {
        val opt_def: O.Option[str] = default_of_name(reg, os_vt, arch_vt);
        if (O.is_none[str](opt_def)) {
            ret R.err[resolved.Target, str](no_module_format_message(arch_vt));
        }
        of_sel = O.unwrap[str](opt_def);
    }
    val opt_of_vt: O.Option[*of.OfVTable] = of.lookup(?reg.of, of_sel);
    if (O.is_none[*of.OfVTable](opt_of_vt)) {
        var nb: [256]u8;
        ret R.err[resolved.Target, str](unregistered_message("object-format", of_sel, registered_names(reg, DIM_OF, ?nb[0], 256)));
    }

    val of_vt: *of.OfVTable = O.unwrap[*of.OfVTable](opt_of_vt);

    val cap: u32 = tuple_capability(os_vt, arch_vt, abi_vt, of_vt);
    if (cap != TUPLE_OK) {
        ret R.err[resolved.Target, str](tuple_capability_message(cap, os_vt, arch_vt, abi_vt, of_vt));
    }

    var t: resolved.Target;
    t.os      = os_vt;
    val env_r: R.Result[u32, str] = resolve_environment(arch_vt, req);
    if (R.is_err[u32, str](env_r)) { ret R.err[resolved.Target, str](R.unwrap_err[u32, str](env_r)); }
    t.env_id      = R.unwrap_ok[u32, str](env_r);
    t.env_profile = isa.environment_profile(arch_vt, t.env_id);
    t.env_name    = req.env_name;
    t.base    = req.base;
    t.stack_reserve = req.stack_reserve;
    t.stack_commit  = req.stack_commit;
    t.isa     = arch_vt;
    isa.object_target(arch_vt, ?t.object);
    t.arch    = arch_vt.machine;
    t.abi     = abi_vt;
    t.of      = of_vt;

    t.variadic_args_on_stack = os.variadic_stack_for(os_vt, arch_vt.id);

    t.fixed_args_natural_size = os.natural_stack_args_for(os_vt, arch_vt.id);

    var vl_size:  u32 = 0;
    var vl_align: u32 = 0;
    val vl_r: R.Result[O.Option[os.VaList], str] = os.va_list_checked_for(os_vt, arch_vt.id);
    if (R.is_err[O.Option[os.VaList], str](vl_r)) {
        ret R.err[resolved.Target, str](R.unwrap_err[O.Option[os.VaList], str](vl_r));
    }
    val vl: O.Option[os.VaList] = R.unwrap_ok[O.Option[os.VaList], str](vl_r);
    if (O.is_some[os.VaList](vl)) {
        vl_size  = O.unwrap[os.VaList](vl).size;
        vl_align = O.unwrap[os.VaList](vl).align;
    }
    t.va_list_size  = vl_size;
    t.va_list_align = vl_align;

    t.os_id   = t.os.id;
    t.arch_id = t.isa.id;
    t.abi_id  = t.abi.id;

    val page_r: R.Result[u64, str] = os.page_size_checked_for(os_vt, arch_vt.id);
    if (R.is_err[u64, str](page_r)) { ret R.err[resolved.Target, str](R.unwrap_err[u64, str](page_r)); }
    t.page_size = R.unwrap_ok[u64, str](page_r);

    val fp_r: R.Result[O.Option[os.FsPolicy], str] = os.fs_policy_checked_for(os_vt, arch_vt.id);
    if (R.is_err[O.Option[os.FsPolicy], str](fp_r)) {
        ret R.err[resolved.Target, str](R.unwrap_err[O.Option[os.FsPolicy], str](fp_r));
    }
    val fp_opt: O.Option[os.FsPolicy] = R.unwrap_ok[O.Option[os.FsPolicy], str](fp_r);
    if (O.is_none[os.FsPolicy](fp_opt)) {
        ret R.err[resolved.Target, str](no_fs_policy_message(os_vt, arch_vt));
    }
    t.fs_policy = O.unwrap[os.FsPolicy](fp_opt);

    t.debug    = nil;
    t.debug_id = of.DBG_UNKNOWN;
    if (!str_empty(of_vt.default_debug)) {
        val opt_dbg: O.Option[*of.DebugVTable] = of.debug_lookup(?reg.debug, of_vt.default_debug);
        if (O.is_none[*of.DebugVTable](opt_dbg)) {
            var nb: [256]u8;
            ret R.err[resolved.Target, str](unregistered_message("debug", of_vt.default_debug, registered_names(reg, DIM_DEBUG, ?nb[0], 256)));
        }
        t.debug    = O.unwrap[*of.DebugVTable](opt_dbg);
        t.debug_id = t.debug.id;
        var debug_target: debug_input.DebugTarget;
        debug_target.arch_id = arch_vt.id;
        debug_target.os_id   = os_vt.id;
        debug_target.abi_id  = abi_vt.id;
        debug_target.of_id   = of_vt.id;
        debug_target.dwarf_reg = nil;
        debug_target.cv_reg    = nil;
        if (arch_vt.machine != nil) {
            debug_target.dwarf_reg = arch_vt.machine.dwarf_reg;
            debug_target.cv_reg    = arch_vt.machine.cv_reg;
        }
        if (t.debug.supports == nil || !t.debug.supports(?debug_target)) {
            ret R.err[resolved.Target, str]("target: selected debug model is incompatible with the target tuple");
        }
    }

    val model_tmpl: *isa.MachineModel = t.isa.model;
    t.model              = @model_tmpl;
    t.model.stack_align  = t.abi.stack_align;
    t.model.red_zone     = t.abi.red_zone;
    t.model.shadow_space = t.abi.shadow_space;

    ret R.ok[resolved.Target, str](t);
}

pub val TARGET_FINGERPRINT_VERSION: u8 = 2;

fun b2u8(b: bool) u8 {
    if (b) { ret 1; }
    ret 0;
}

pub fun fingerprint(t: *resolved.Target, e: *binary.Encoder) bool {
    var ok: bool = true;

    ok = ok && fp.write_domain_str(e, fp.DOMAIN_ARCH, TARGET_FINGERPRINT_VERSION, t.env_name);

    ok = ok && fp.write_domain_u8(e, fp.DOMAIN_ARCH, isa.ARCH_CATALOG_VERSION, isa.arch_fingerprint_tag(t.arch_id));
    ok = ok && fp.write_domain_str(e, fp.DOMAIN_ARCH, TARGET_FINGERPRINT_VERSION, t.isa.name);

    ok = ok && fp.write_domain_u8(e, fp.DOMAIN_ABI, abi.ABI_CATALOG_VERSION, abi.abi_fingerprint_tag(t.abi_id));
    ok = ok && fp.write_domain_str(e, fp.DOMAIN_ABI, TARGET_FINGERPRINT_VERSION, t.abi.name);

    ok = ok && fp.write_domain_u8(e, fp.DOMAIN_OS, os.OS_CATALOG_VERSION, os.os_fingerprint_tag(t.os_id));
    ok = ok && fp.write_domain_str(e, fp.DOMAIN_OS, TARGET_FINGERPRINT_VERSION, t.os.name);

    ok = ok && fp.write_domain_u8(e, fp.DOMAIN_OF, of.OF_FORMAT_CATALOG_VERSION, of.of_fingerprint_tag(t.of.id));
    ok = ok && fp.write_domain_str(e, fp.DOMAIN_OF, TARGET_FINGERPRINT_VERSION, t.of.name);

    ok = ok && fp.write_domain_u32(e, fp.DOMAIN_DEBUG, TARGET_FINGERPRINT_VERSION, t.debug_id);

    var backend_kind: u8 = 0;
    if (isa.emits_whole_module(t.isa)) { backend_kind = 1; }
    ok = ok && fp.write_domain_u8(e, fp.DOMAIN_BACKEND, TARGET_FINGERPRINT_VERSION, backend_kind);

    ok = ok && fp.write_domain_u64(e, fp.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.base);
    ok = ok && fp.write_domain_u64(e, fp.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.page_size);
    ok = ok && fp.write_domain_u64(e, fp.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.stack_reserve);
    ok = ok && fp.write_domain_u64(e, fp.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.stack_commit);
    ok = ok && fp.write_domain_u8(e, fp.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, b2u8(t.variadic_args_on_stack));
    ok = ok && fp.write_domain_u8(e, fp.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, b2u8(t.fixed_args_natural_size));
    ok = ok && fp.write_domain_u32(e, fp.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.va_list_size);
    ok = ok && fp.write_domain_u32(e, fp.DOMAIN_IMAGE, TARGET_FINGERPRINT_VERSION, t.va_list_align);

    ok = ok && fingerprint_model(?t.model, e);
    ok = ok && fingerprint_fs_policy(?t.fs_policy, e);

    ret ok;
}

fun fingerprint_fs_policy(p: *os.FsPolicy, e: *binary.Encoder) bool {
    var ok: bool = true;
    val d: fp.Domain = fp.DOMAIN_FS_POLICY;
    val v: u8 = TARGET_FINGERPRINT_VERSION;

    ok = ok && fp.write_domain_str(e, d, v, p.sysroot);
    ok = ok && fp.write_domain_str(e, d, v, p.toolchain_root);
    ok = ok && fp.write_domain_str(e, d, v, p.dynamic_interpreter);
    ok = ok && fp.write_domain_str(e, d, v, p.platform_lib);
    ok = ok && fp.write_domain_u32(e, d, v, p.libdir_len);

    var li: u32 = 0;
    for (li < p.libdir_len) {
        ok = ok && fp.write_domain_str(e, d, v, p.libdirs[li]);
        li = li + 1;
    }

    ret ok;
}

fun fingerprint_model(m: *isa.MachineModel, e: *binary.Encoder) bool {
    var ok: bool = true;
    val d: fp.Domain = fp.DOMAIN_TARGET_MODEL;
    val v: u8 = TARGET_FINGERPRINT_VERSION;

    ok = ok && fp.write_domain_u32(e, d, v, m.pointer_width);
    ok = ok && fp.write_domain_u32(e, d, v, m.gpr_width);
    ok = ok && fp.write_domain_u32(e, d, v, m.max_alu_width);
    ok = ok && fp.write_domain_u32(e, d, v, m.alu_min_width);
    ok = ok && fp.write_domain_u32(e, d, v, m.spill_width);
    ok = ok && fp.write_domain_u8(e, d, v, m.endianness);
    ok = ok && fp.write_domain_u32(e, d, v, m.reg_class_len);

    var ci: u32 = 0;
    for (ci < m.reg_class_len) {
        ok = ok && fp.write_domain_u8(e, d, v, m.reg_classes[ci].kind);
        ok = ok && fp.write_domain_u32(e, d, v, m.reg_classes[ci].len);
        ci = ci + 1;
    }

    ok = ok && fp.write_domain_u32(e, d, v, m.frame_ptr_reg::u32);
    ok = ok && fp.write_domain_u32(e, d, v, m.stack_ptr_reg::u32);
    ok = ok && fp.write_domain_u32(e, d, v, m.reserved_len::u32);

    var ri: i32 = 0;
    for (ri < m.reserved_len) {
        ok = ok && fp.write_domain_u32(e, d, v, m.reserved_regs[ri].id::u32);
        ok = ok && fp.write_domain_u8(e, d, v, m.reserved_regs[ri].size);
        ri = ri + 1;
    }

    ok = ok && fp.write_domain_u32(e, d, v, m.div_reg::u32);
    ok = ok && fp.write_domain_u32(e, d, v, m.div_hi_reg::u32);
    ok = ok && fp.write_domain_u32(e, d, v, m.shift_count_reg::u32);
    ok = ok && fp.write_domain_u64(e, d, v, m.incoming_arg_base::u64);
    ok = ok && fp.write_domain_u32(e, d, v, m.stack_align);
    ok = ok && fp.write_domain_u32(e, d, v, m.red_zone);
    ok = ok && fp.write_domain_u32(e, d, v, m.shadow_space);
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.has_v128));
    ok = ok && fp.write_domain_u32(e, d, v, m.vector_bits);
    ok = ok && fp.write_domain_u32(e, d, v, m.max_vector_lanes);
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.vector_compute_generic));
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.has_lane_ops));
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.has_vec_build));
    ok = ok && fp.write_domain_u32(e, d, v, m.vec_mem_widths);
    ok = ok && fp.write_domain_u32(e, d, v, m.xbank_widths);
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.ct_trust_mul));
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.has_var_shift));
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.has_mul));
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.has_float));
    ok = ok && fp.write_domain_u32(e, d, v, m.mul_hi_width);
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.flat_addressing));
    ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.ct_trust_var_shift));
    ok = ok && fp.write_domain_u32(e, d, v, m.packed_gap_len);

    var gi: u32 = 0;
    for (gi < m.packed_gap_len) {
        ok = ok && fp.write_domain_u32(e, d, v, m.packed_gaps[gi].op);
        ok = ok && fp.write_domain_u8(e, d, v, b2u8(m.packed_gaps[gi].is_float));
        ok = ok && fp.write_domain_u32(e, d, v, m.packed_gaps[gi].lane_bits);
        gi = gi + 1;
    }

    ok = ok && fp.write_domain_u32(e, d, v, m.flen_bits);

    ret ok;
}

fun default_of_name(reg: *TargetRegistry, os_vt: *os.OsVTable, isa_vt: *isa.IsaVTable) O.Option[str] {
    if (!isa.emits_whole_module(isa_vt)) { ret O.some[str](os_vt.default_of); }

    var i:   u32 = 0;
    val len: u32 = of.registered_count(?reg.of);
    for (i < len) {
        val of_vt: *of.OfVTable = O.unwrap[*of.OfVTable](of.registered(?reg.of, i));
        if (of_vt.object_is_artifact && of.covers_isa(of_vt, isa_vt.id)) {
            ret O.some[str](of_vt.name);
        }
        i = i + 1;
    }
    ret O.none[str]();
}

fun no_module_format_message(isa_vt: *isa.IsaVTable) str {
    val fb: str = "instruction set emits whole modules, but no registered object format carries one";
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret fb; }
    val r: R.Result[str, str] = str_join(?alloc, "instruction set '", isa_vt.name, "' emits whole modules, but no registered object format carries a finished module for it");
    if (R.is_err[str, str](r)) { ret fb; }
    ret R.unwrap_ok[str, str](r);
}

pub fun select(reg: *TargetRegistry, isa_name: str, os_name: str, abi_name: str) R.Result[resolved.Target, str] {
    ret select_of(reg, isa_name, os_name, abi_name, "");
}

pub fun artifact_naming(tgt: *resolved.Target, kind: of.ArtifactOutputKind) R.Result[of.ArtifactName, str] {
    if (tgt == nil || tgt.of == nil || tgt.os == nil) {
        ret R.err[of.ArtifactName, str]("artifact naming: target has no selected object format");
    }
    ret of.artifact_naming(tgt.of, tgt.os.name, kind);
}

pub val TUPLE_OK:           u32 = 0;
val COMPLETE_TUPLE_CENSUS:  u32 = 30;
pub val TUPLE_NO_CODEGEN:   u32 = 1;
pub val TUPLE_ABI_MISMATCH: u32 = 2;
pub val TUPLE_OS_NO_OF:     u32 = 3;
pub val TUPLE_OF_UNCOVERED: u32 = 4;
pub val TUPLE_OF_SHAPE:     u32 = 5;
pub val TUPLE_OS_NO_ISA:    u32 = 6;
pub val TUPLE_ABI_NEEDS_FLOAT: u32 = 7;
pub val TUPLE_TARGET_UNAVAILABLE: u32 = 8;

rec TupleCapabilitySpec {
    code:  u32;
    label: str;
}

val TUPLE_CAPABILITY_N: usize = 9;
val TUPLE_CAPABILITIES: [TUPLE_CAPABILITY_N]TupleCapabilitySpec = [TUPLE_CAPABILITY_N]TupleCapabilitySpec{
    TupleCapabilitySpec{ code: TUPLE_OK,             label: "ok" },
    TupleCapabilitySpec{ code: TUPLE_NO_CODEGEN,      label: "no_codegen" },
    TupleCapabilitySpec{ code: TUPLE_ABI_MISMATCH,    label: "abi_mismatch" },
    TupleCapabilitySpec{ code: TUPLE_OS_NO_OF,        label: "os_no_of" },
    TupleCapabilitySpec{ code: TUPLE_OF_UNCOVERED,    label: "of_uncovered" },
    TupleCapabilitySpec{ code: TUPLE_OF_SHAPE,        label: "of_shape" },
    TupleCapabilitySpec{ code: TUPLE_OS_NO_ISA,       label: "os_no_isa" },
    TupleCapabilitySpec{ code: TUPLE_ABI_NEEDS_FLOAT, label: "abi_needs_float" },
    TupleCapabilitySpec{ code: TUPLE_TARGET_UNAVAILABLE, label: "target_unavailable" },
};

pub fun tuple_capability(os_vt: *os.OsVTable, isa_vt: *isa.IsaVTable, abi_vt: *abi.AbiVTable, of_vt: *of.OfVTable) u32 {
    if (isa_vt.id == isa.ARCH_MOS6502)       { ret TUPLE_TARGET_UNAVAILABLE; }
    if (!isa.has_codegen(isa_vt))            { ret TUPLE_NO_CODEGEN; }
    if (!abi.covers_isa(abi_vt, isa_vt.id))  { ret TUPLE_ABI_MISMATCH; }
    if (abi_vt.float_arg_bits > isa_vt.model.flen_bits) { ret TUPLE_ABI_NEEDS_FLOAT; }
    if (!os.supports_isa(os_vt, isa_vt.id))  { ret TUPLE_OS_NO_ISA; }
    if (!os.supports_of(os_vt, of_vt.name))  { ret TUPLE_OS_NO_OF; }
    if (!of.covers_isa(of_vt, isa_vt.id))    { ret TUPLE_OF_UNCOVERED; }
    if (isa.emits_whole_module(isa_vt) != of_vt.object_is_artifact) { ret TUPLE_OF_SHAPE; }
    ret TUPLE_OK;
}

fun tuple_capability_message(code: u32, os_vt: *os.OsVTable, isa_vt: *isa.IsaVTable, abi_vt: *abi.AbiVTable, of_vt: *of.OfVTable) str {
    var alloc: A.Allocator;
    val alloc_failed: bool = O.is_some[str](page.make(?alloc));

    if (code == TUPLE_NO_CODEGEN) {
        val fb: str = "instruction set has no code generator in this build";
        if (alloc_failed) { ret fb; }
        val r: R.Result[str, str] = str_join(?alloc, "instruction set '", isa_vt.name, "' has no code generator in this build");
        if (R.is_err[str, str](r)) { ret fb; }
        ret R.unwrap_ok[str, str](r);
    }
    if (code == TUPLE_ABI_MISMATCH) {
        val fb: str = "calling convention does not target the selected instruction set";
        if (alloc_failed) { ret fb; }
        val r: R.Result[str, str] = str_join(?alloc, "calling convention '", abi_vt.name, "' does not target instruction set '", isa_vt.name, "'");
        if (R.is_err[str, str](r)) { ret fb; }
        ret R.unwrap_ok[str, str](r);
    }
    if (code == TUPLE_ABI_NEEDS_FLOAT) {
        val fb: str = "calling convention passes floats in a float register the instruction set does not have";
        if (alloc_failed) { ret fb; }
        val r: R.Result[str, str] = format.sprint(?alloc,
            "calling convention '{}' passes floating-point arguments in {}-bit float registers, but instruction set '{}' has {}-bit float registers",
            abi_vt.name, abi_vt.float_arg_bits, isa_vt.name, isa_vt.model.flen_bits);
        if (R.is_err[str, str](r)) { ret fb; }
        ret R.unwrap_ok[str, str](r);
    }
    if (code == TUPLE_OS_NO_ISA) {
        val fb: str = "operating system does not run on the selected instruction set";
        if (alloc_failed) { ret fb; }
        val r: R.Result[str, str] = str_join(?alloc, "operating system '", os_vt.name, "' does not run on instruction set '", isa_vt.name, "'");
        if (R.is_err[str, str](r)) { ret fb; }
        ret R.unwrap_ok[str, str](r);
    }
    if (code == TUPLE_OS_NO_OF) {
        val fb: str = "operating system does not support the selected object format";
        if (alloc_failed) { ret fb; }
        val r: R.Result[str, str] = str_join(?alloc, "operating system '", os_vt.name, "' does not support object format '", of_vt.name, "'");
        if (R.is_err[str, str](r)) { ret fb; }
        ret R.unwrap_ok[str, str](r);
    }
    if (code == TUPLE_OF_UNCOVERED) {
        val fb: str = "object format does not cover the selected instruction set's relocations";
        if (alloc_failed) { ret fb; }
        val r: R.Result[str, str] = str_join(?alloc, "object format '", of_vt.name, "' does not cover ", isa_vt.name, " relocations");
        if (R.is_err[str, str](r)) { ret fb; }
        ret R.unwrap_ok[str, str](r);
    }
    if (code == TUPLE_OF_SHAPE) {
        var emits: str = "linkable objects";
        var takes: str = "finished modules";
        if (isa.emits_whole_module(isa_vt)) {
            emits = "finished modules";
            takes = "linkable objects";
        }
        val fb: str = "object format's emission shape does not match the instruction set's";
        if (alloc_failed) { ret fb; }
        val r: R.Result[str, str] = str_join(?alloc, "instruction set '", isa_vt.name, "' emits ", emits, ", but object format '", of_vt.name, "' carries ", takes);
        if (R.is_err[str, str](r)) { ret fb; }
        ret R.unwrap_ok[str, str](r);
    }
    if (code == TUPLE_TARGET_UNAVAILABLE) {
        ret "target 'mos6502' remains unavailable pending its complete implementation and evidence";
    }
    panic("target: tuple_capability_message called with an undeclared capability code\n");
    ret "";
}

fun t_debug_provider_failure() R.Result[of.DebugVTable, str] {
    ret R.err[of.DebugVTable, str]("injected debug descriptor failure");
}

fun t_incomplete_debug_provider() R.Result[of.DebugVTable, str] {
    var descriptor: of.DebugVTable;
    descriptor.id = of.DBG_DWARF;
    descriptor.name = "dwarf";
    descriptor.produce = nil;
    descriptor.supports = nil;
    ret R.ok[of.DebugVTable, str](descriptor);
}

test "mach.lang.target.register_all:publishes_once_and_is_idempotent" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    if (reg.state != REGISTRY_READY || reg.version != REGISTRY_VERSION) { ret 1; }

    val isa_count: u32 = reg.isa.count;
    val os_count: u32 = reg.os.count;
    val abi_count: u32 = reg.abi.count;
    val of_count: u32 = reg.of.count;
    val debug_count: u32 = reg.debug.count;
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    if (reg.isa.count != isa_count || reg.os.count != os_count || reg.abi.count != abi_count
        || reg.of.count != of_count || reg.debug.count != debug_count) { ret 1; }
    ret 0;
}

test "mach.lang.target.register_all:rejects_partial_state_without_destroying_it" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](x64.register_x64(?reg.isa))) { ret 1; }
    val count: u32 = reg.isa.count;
    if (R.is_ok[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    if (reg.state != REGISTRY_FRESH || reg.version != 0 || reg.isa.count != count) { ret 1; }
    if (O.is_none[*isa.IsaVTable](isa.lookup(?reg.isa, "x86_64"))) { ret 1; }
    ret 0;
}

test "mach.lang.target.register_all:provider_failure_rolls_back_and_allows_retry" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_ok[R.Void, str](register_all(?reg, t_debug_provider_failure))) { ret 1; }
    if (reg.state != REGISTRY_FRESH || reg.version != 0 || !registry_empty(?reg)) { ret 1; }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    ret 0;
}

test "mach.lang.target.register_all:incomplete_descriptor_rolls_back_and_allows_retry" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_ok[R.Void, str](register_all(?reg, t_incomplete_debug_provider))) { ret 1; }
    if (reg.state != REGISTRY_FRESH || reg.version != 0 || !registry_empty(?reg)) { ret 1; }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    ret 0;
}

test "mach.lang.target.resolve:requires_a_published_registry_and_complete_request" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var req: TargetRequest = target_request("x86_64", "linux", "sysv64");
    if (R.is_ok[resolved.Target, str](resolve(nil, ?req))) { ret 1; }
    if (R.is_ok[resolved.Target, str](resolve(?reg, nil))) { ret 1; }
    if (R.is_ok[resolved.Target, str](resolve(?reg, ?req))) { ret 1; }
    ret 0;
}

test "mach.lang.target.resolve:rejects_debug_and_isa_capability_mismatch" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    val arch_o: O.Option[*isa.IsaVTable] = isa.lookup(?reg.isa, "x86_64");
    if (O.is_none[*isa.IsaVTable](arch_o)) { ret 1; }
    val arch_vt: *isa.IsaVTable = O.unwrap[*isa.IsaVTable](arch_o);
    if (arch_vt.machine == nil || arch_vt.machine.dwarf_reg == nil) { ret 1; }
    arch_vt.machine.dwarf_reg = nil;

    var req: TargetRequest = target_request("x86_64", "linux", "sysv64");
    if (R.is_ok[resolved.Target, str](resolve(?reg, ?req))) { ret 1; }
    ret 0;
}

test "mach.lang.target.tuple_capability_catalog:complete_unique_ordered" {
    if (TUPLE_CAPABILITIES[0].code != TUPLE_OK)             { ret 1; }
    if (TUPLE_CAPABILITIES[1].code != TUPLE_NO_CODEGEN)      { ret 1; }
    if (TUPLE_CAPABILITIES[2].code != TUPLE_ABI_MISMATCH)    { ret 1; }
    if (TUPLE_CAPABILITIES[3].code != TUPLE_OS_NO_OF)        { ret 1; }
    if (TUPLE_CAPABILITIES[4].code != TUPLE_OF_UNCOVERED)    { ret 1; }
    if (TUPLE_CAPABILITIES[5].code != TUPLE_OF_SHAPE)        { ret 1; }
    if (TUPLE_CAPABILITIES[6].code != TUPLE_OS_NO_ISA)       { ret 1; }
    if (TUPLE_CAPABILITIES[7].code != TUPLE_ABI_NEEDS_FLOAT) { ret 1; }
    if (TUPLE_CAPABILITIES[8].code != TUPLE_TARGET_UNAVAILABLE) { ret 1; }

    var i: usize = 0;
    for (i < TUPLE_CAPABILITY_N) {
        var j: usize = 0;
        for (j < TUPLE_CAPABILITY_N) {
            if (i != j) {
                if (TUPLE_CAPABILITIES[i].code == TUPLE_CAPABILITIES[j].code) { ret 1; }
                if (str_equals(TUPLE_CAPABILITIES[i].label, TUPLE_CAPABILITIES[j].label)) { ret 1; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

val DIM_ISA:   u32 = 0;
val DIM_OS:    u32 = 1;
val DIM_ABI:   u32 = 2;
val DIM_OF:    u32 = 3;
val DIM_DEBUG: u32 = 4;

fun buf_put(buf: *u8, cap: usize, off: usize, s: str) usize {
    var i: usize = 0;
    val n: usize = str_len(s);
    var o: usize = off;
    for (i < n && o < cap - 1) {
        buf[o] = s[i];
        o = o + 1;
        i = i + 1;
    }
    ret o;
}

fun registered_names(reg: *TargetRegistry, dim: u32, buf: *u8, cap: usize) str {
    var count: u32 = 0;
    if (dim == DIM_ISA)     { count = isa.registered_count(?reg.isa); }
    or (dim == DIM_OS)      { count = os.registered_count(?reg.os); }
    or (dim == DIM_ABI)     { count = abi.registered_count(?reg.abi); }
    or (dim == DIM_DEBUG)   { count = of.debug_registered_count(?reg.debug); }
    or                      { count = of.registered_count(?reg.of); }

    var off: usize = 0;
    var i: u32 = 0;
    for (i < count) {
        var nm: str = "";
        if (dim == DIM_ISA)   { nm = O.unwrap[*isa.IsaVTable](isa.registered(?reg.isa, i)).name; }
        or (dim == DIM_OS)    { nm = O.unwrap[*os.OsVTable](os.registered(?reg.os, i)).name; }
        or (dim == DIM_ABI)   { nm = O.unwrap[*abi.AbiVTable](abi.registered(?reg.abi, i)).name; }
        or (dim == DIM_DEBUG) { nm = O.unwrap[*of.DebugVTable](of.debug_registered(?reg.debug, i)).name; }
        or                    { nm = O.unwrap[*of.OfVTable](of.registered(?reg.of, i)).name; }
        if (i > 0) { off = buf_put(buf, cap, off, ", "); }
        off = buf_put(buf, cap, off, nm);
        i = i + 1;
    }
    if (off >= cap) { off = cap - 1; }
    buf[off] = 0;
    ret buf::str;
}

fun no_fs_policy_message(os_vt: *os.OsVTable, arch_vt: *isa.IsaVTable) str {
    var alloc: A.Allocator;
    val alloc_failed: bool = O.is_some[str](page.make(?alloc));
    val fb: str = "no file-system policy declared for the requested target";
    if (alloc_failed) { ret fb; }
    val r: R.Result[str, str] = str_join(?alloc, "no file-system policy declared for '", arch_vt.name, "-", os_vt.name, "'");
    if (R.is_err[str, str](r)) { ret fb; }
    ret R.unwrap_ok[str, str](r);
}

fun resolve_environment(arch_vt: *isa.IsaVTable, req: *TargetRequest) R.Result[u32, str] {
    if (str_empty(req.env_name)) { ret R.ok[u32, str](isa.ENV_NONE); }
    var label: str = req.label;
    if (str_empty(label)) { label = req.isa_name; }
    if (arch_vt.env_count == 0) {
        ret R.err[u32, str](environment_message(label, req.env_name, arch_vt, "defines no environments; remove `env`"));
    }
    val id: u32 = isa.environment_lookup(arch_vt, req.env_name);
    if (id == isa.ENV_NONE) {
        ret R.err[u32, str](environment_message(label, req.env_name, arch_vt, "does not define it"));
    }
    ret R.ok[u32, str](id);
}

fun environment_message(label: str, env: str, arch_vt: *isa.IsaVTable, why: str) str {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret "mach.toml: `env` names an environment the target's isa does not define"; }
    var known: str = "";
    var i: u32 = 0;
    for (i < arch_vt.env_count) {
        val piece: R.Result[str, str] = format.sprint(?alloc, "{}{}{}", known, arch_vt.envs[i].name, ", ");
        if (R.is_ok[str, str](piece)) { known = R.unwrap_ok[str, str](piece); }
        i = i + 1;
    }
    if (arch_vt.env_count == 0) { known = "none, "; }
    val r: R.Result[str, str] = format.sprint(?alloc, "mach.toml: [target.{}] env = \"{}\": isa '{}' {} (known: {})", label, env, arch_vt.name, why, known);
    if (R.is_err[str, str](r)) { ret "mach.toml: `env` names an environment the target's isa does not define"; }
    val msg: str = R.unwrap_ok[str, str](r);
    val n: usize = str_len(msg);
    if (n >= 3) { msg[n - 3] = ')'::u8; msg[n - 2] = 0; }
    ret msg;
}

fun unregistered_message(noun: str, name: str, names: str) str {
    var alloc: A.Allocator;
    val alloc_failed: bool = O.is_some[str](page.make(?alloc));
    val fb: str = "no implementation registered for the requested target name";
    if (alloc_failed) { ret fb; }
    val r: R.Result[str, str] = str_join(?alloc, "no ", noun, " implementation registered for '", name, "' (registered: ", names, ")");
    if (R.is_err[str, str](r)) { ret fb; }
    ret R.unwrap_ok[str, str](r);
}

test "mach.lang.target:registry_enumeration_agrees_with_lookup" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: R.Result[R.Void, str] = register_all(?reg, target_testing.debug_descriptor);
    if (R.is_err[R.Void, str](res_reg)) { ret 1; }

    if (isa.registered_count(?reg.isa) < 2) { ret 1; }
    if (os.registered_count(?reg.os)   < 3) { ret 1; }
    if (abi.registered_count(?reg.abi) < 2) { ret 1; }
    if (of.registered_count(?reg.of)   < 3) { ret 1; }

    var i: u32 = 0;
    val isa_len: u32 = isa.registered_count(?reg.isa);
    for (i < isa_len) {
        val opt_vt: O.Option[*isa.IsaVTable] = isa.registered(?reg.isa, i);
        if (!O.is_some[*isa.IsaVTable](opt_vt))                                                      { ret 1; }
        if (!O.is_some[*isa.IsaVTable](isa.lookup(?reg.isa, O.unwrap[*isa.IsaVTable](opt_vt).name))) { ret 1; }
        i = i + 1;
    }
    if (O.is_some[*isa.IsaVTable](isa.registered(?reg.isa, isa_len))) { ret 1; }

    ret 0;
}

test "mach.lang.target:elf_capable_isa_declares_a_reloc_seam" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }

    val len: u32 = isa.registered_count(?reg.isa);
    if (len == 0) { ret 1; }

    var unpaired: u32 = 0;
    var seams:    u32 = 0;
    var i: u32 = 0;
    for (i < len) {
        val vt: *isa.IsaVTable = O.unwrap[*isa.IsaVTable](isa.registered(?reg.isa, i));

        if (vt.elf_machine != 0) {
            if (!isa.emits_relocations(vt))      { unpaired = unpaired + 1; }
            or (vt.reloc.apply == nil)           { unpaired = unpaired + 1; }
            or (vt.reloc.traits == nil)          { unpaired = unpaired + 1; }
            or (!vt.reloc.has_elf)                { unpaired = unpaired + 1; }
            or (vt.reloc.elf.reloc_type == nil)   { unpaired = unpaired + 1; }
        }

        if (isa.emits_whole_module(vt) && isa.emits_relocations(vt)) { unpaired = unpaired + 1; }

        if (isa.emits_relocations(vt)) { seams = seams + 1; }
        i = i + 1;
    }

    if (unpaired != 0) { ret unpaired::i32; }

    if (seams != 5) { ret 1; }
    ret 0;
}

test "mach.lang.target.tuple_capability:refuses_abi_needing_absent_float_extension" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: R.Result[R.Void, str] = register_all(?reg, target_testing.debug_descriptor);
    if (R.is_err[R.Void, str](res_reg)) { ret 1; }

    val opt_isa: O.Option[*isa.IsaVTable] = isa.lookup(?reg.isa, "riscv64");
    if (!O.is_some[*isa.IsaVTable](opt_isa)) { ret 1; }
    val isa_vt: *isa.IsaVTable = O.unwrap[*isa.IsaVTable](opt_isa);
    if (isa_vt.model.flen_bits != 64) { ret 1; }

    var quad: abi.AbiVTable = abi.abi_vtable(
        abi.ABI_UNKNOWN, "lp64q", isa.ARCH_RISCV64,
        nil, nil, nil, nil,
        16, 0, 0,
        -1, false,
        false, false,
        128, 8,
        nil
    );
    if (tuple_capability(nil, isa_vt, ?quad, nil) != TUPLE_ABI_NEEDS_FLOAT) { ret 1; }

    val opt_abi: O.Option[*abi.AbiVTable] = abi.lookup(?reg.abi, "lp64d");
    if (!O.is_some[*abi.AbiVTable](opt_abi)) { ret 1; }
    val d_vt: *abi.AbiVTable = O.unwrap[*abi.AbiVTable](opt_abi);
    if (d_vt.float_arg_bits != 64) { ret 1; }
    val ok: R.Result[resolved.Target, str] = select(?reg, "riscv64", "linux", "lp64d");
    if (R.is_err[resolved.Target, str](ok)) { ret 1; }
    val soft: R.Result[resolved.Target, str] = select(?reg, "riscv64", "linux", "lp64");
    if (R.is_err[resolved.Target, str](soft)) { ret 1; }
    ret 0;
}

test "mach.lang.target.tuple_capability:refuses_a_standard_abi_a_narrower_isa_model_cannot_give" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: R.Result[R.Void, str] = register_all(?reg, target_testing.debug_descriptor);
    if (R.is_err[R.Void, str](res_reg)) { ret 1; }

    val opt_isa: O.Option[*isa.IsaVTable] = isa.lookup(?reg.isa, "riscv64");
    if (!O.is_some[*isa.IsaVTable](opt_isa)) { ret 1; }
    val real_isa: *isa.IsaVTable = O.unwrap[*isa.IsaVTable](opt_isa);

    val opt_abi: O.Option[*abi.AbiVTable] = abi.lookup(?reg.abi, "lp64d");
    if (!O.is_some[*abi.AbiVTable](opt_abi)) { ret 1; }
    val d_vt: *abi.AbiVTable = O.unwrap[*abi.AbiVTable](opt_abi);
    if (d_vt.float_arg_bits != 64) { ret 1; }

    var narrow: isa.IsaVTable = @real_isa;
    narrow.model.flen_bits = 0;
    if (tuple_capability(nil, ?narrow, d_vt, nil) != TUPLE_ABI_NEEDS_FLOAT) { ret 1; }

    var mid: isa.IsaVTable = @real_isa;
    mid.model.flen_bits = 32;
    if (tuple_capability(nil, ?mid, d_vt, nil) != TUPLE_ABI_NEEDS_FLOAT) { ret 1; }
    ret 0;
}

test "mach.lang.target.tuple_capability:refuses_an_isa_with_no_registered_code_generator" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: R.Result[R.Void, str] = register_all(?reg, target_testing.debug_descriptor);
    if (R.is_err[R.Void, str](res_reg)) { ret 1; }

    val opt_isa: O.Option[*isa.IsaVTable] = isa.lookup(?reg.isa, "riscv64");
    if (!O.is_some[*isa.IsaVTable](opt_isa)) { ret 1; }
    val real_isa: *isa.IsaVTable = O.unwrap[*isa.IsaVTable](opt_isa);
    if (!isa.has_codegen(real_isa)) { ret 1; }

    var stub: isa.IsaVTable = @real_isa;
    stub.machine = nil;
    stub.emitter = nil;
    if (isa.has_codegen(?stub)) { ret 1; }

    if (tuple_capability(nil, ?stub, nil, nil) != TUPLE_NO_CODEGEN) { ret 1; }
    ret 0;
}

test "mach.lang.target.tuple_capability:refuses_an_isa_the_operating_system_does_not_run" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: R.Result[R.Void, str] = register_all(?reg, target_testing.debug_descriptor);
    if (R.is_err[R.Void, str](res_reg)) { ret 1; }

    val opt_isa: O.Option[*isa.IsaVTable] = isa.lookup(?reg.isa, "riscv64");
    if (!O.is_some[*isa.IsaVTable](opt_isa)) { ret 1; }
    val riscv_vt: *isa.IsaVTable = O.unwrap[*isa.IsaVTable](opt_isa);

    val opt_abi: O.Option[*abi.AbiVTable] = abi.lookup(?reg.abi, "lp64d");
    if (!O.is_some[*abi.AbiVTable](opt_abi)) { ret 1; }
    val d_vt: *abi.AbiVTable = O.unwrap[*abi.AbiVTable](opt_abi);

    val opt_os: O.Option[*os.OsVTable] = os.lookup(?reg.os, "windows");
    if (!O.is_some[*os.OsVTable](opt_os)) { ret 1; }
    val win_vt: *os.OsVTable = O.unwrap[*os.OsVTable](opt_os);
    if (os.supports_isa(win_vt, isa.ARCH_RISCV64)) { ret 1; }

    if (tuple_capability(win_vt, riscv_vt, d_vt, nil) != TUPLE_OS_NO_ISA) { ret 1; }
    ret 0;
}

test "mach.lang.target.select:linux_aarch64" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: R.Result[R.Void, str] = register_all(?reg, target_testing.debug_descriptor);
    if (R.is_err[R.Void, str](res_reg)) { ret 1; }

    if (abi.registered_count(?reg.abi) != 11) { ret 1; }

    val res_target: R.Result[resolved.Target, str] = select(?reg, "aarch64", "linux", "aapcs64");
    if (R.is_err[resolved.Target, str](res_target)) { ret 1; }
    val t: resolved.Target = R.unwrap_ok[resolved.Target, str](res_target);

    if (t.arch == nil)                 { ret 1; }
    if (t.isa.id != isa.ARCH_AARCH64) { ret 1; }
    if (t.arch.select == nil)          { ret 1; }
    if (t.arch.encode == nil)          { ret 1; }

    if (t.abi == nil)                { ret 1; }
    if (t.abi.id != abi.ABI_AAPCS64) { ret 1; }
    if (t.abi.arg_passing == nil)    { ret 1; }
    if (t.abi.ret_passing == nil)    { ret 1; }

    ret 0;
}

test "mach.lang.target.select:fs_policy_is_per_tuple_not_shared_across_linux_architectures" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: R.Result[R.Void, str] = register_all(?reg, target_testing.debug_descriptor);
    if (R.is_err[R.Void, str](res_reg)) { ret 1; }

    val res_x64: R.Result[resolved.Target, str] = select(?reg, "x86_64", "linux", "sysv64");
    if (R.is_err[resolved.Target, str](res_x64)) { ret 1; }
    val tx64: resolved.Target = R.unwrap_ok[resolved.Target, str](res_x64);

    val res_a64: R.Result[resolved.Target, str] = select(?reg, "aarch64", "linux", "aapcs64");
    if (R.is_err[resolved.Target, str](res_a64)) { ret 1; }
    val ta64: resolved.Target = R.unwrap_ok[resolved.Target, str](res_a64);

    val res_r64: R.Result[resolved.Target, str] = select(?reg, "riscv64", "linux", "lp64d");
    if (R.is_err[resolved.Target, str](res_r64)) { ret 1; }
    val tr64: resolved.Target = R.unwrap_ok[resolved.Target, str](res_r64);

    var bad: bool = false;
    if (!str_equals(tx64.fs_policy.dynamic_interpreter, "/lib64/ld-linux-x86-64.so.2"))       { bad = true; }
    if (!str_equals(ta64.fs_policy.dynamic_interpreter, "/lib/ld-linux-aarch64.so.1"))        { bad = true; }
    if (!str_equals(tr64.fs_policy.dynamic_interpreter, "/lib/ld-linux-riscv64-lp64d.so.1"))  { bad = true; }

    if (str_equals(tx64.fs_policy.dynamic_interpreter, ta64.fs_policy.dynamic_interpreter)) { bad = true; }
    if (str_equals(tx64.fs_policy.dynamic_interpreter, tr64.fs_policy.dynamic_interpreter)) { bad = true; }
    if (str_equals(ta64.fs_policy.dynamic_interpreter, tr64.fs_policy.dynamic_interpreter)) { bad = true; }

    if (!str_equals(tx64.fs_policy.libdirs[2], "/lib/x86_64-linux-gnu"))  { bad = true; }
    if (!str_equals(ta64.fs_policy.libdirs[0], "/lib/aarch64-linux-gnu")) { bad = true; }
    if (!str_equals(tr64.fs_policy.libdirs[0], "/lib/riscv64-linux-gnu")) { bad = true; }

    var li: u32 = 0;
    for (li < ta64.fs_policy.libdir_len) {
        if (str_equals(ta64.fs_policy.libdirs[li], "/lib/x86_64-linux-gnu")
            || str_equals(ta64.fs_policy.libdirs[li], "/usr/lib/x86_64-linux-gnu")
            || str_equals(ta64.fs_policy.libdirs[li], "/lib64")
            || str_equals(ta64.fs_policy.libdirs[li], "/usr/lib64")) { bad = true; }
        li = li + 1;
    }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.select:darwin_and_windows_and_freestanding_declare_no_dynamic_interpreter" {
