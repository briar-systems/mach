pub fun host_os_id() u32 {
    $if ($mach.build.os == $mach.os.linux)   { ret catalog_os.LINUX; }
    $or ($mach.build.os == $mach.os.darwin)  { ret catalog_os.DARWIN; }
    $or ($mach.build.os == $mach.os.windows) { ret catalog_os.WINDOWS; }
    $or                                      { ret catalog_os.UNKNOWN; }
}

pub fun host_arch_id() u32 {
    ret catalog_arch.host_id();
}

pub fun host_abi_id() u32 {
    ret ($mach.build.abi)::u32;
}

# the identity a member restates must be the one the catalog gives its id
fun identity_check(a: *A.Allocator, noun: str, name: str, catalog_name: str) err[fail.Fail] {
    if (str_equals(name, catalog_name)) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{fail.formatted(a, "target: {} '{}' carries the catalog id of '{}'", noun, name, catalog_name)};
}

# the catalog row a registry holds no member for, refused by noun and spelling
fun catalog_covered[T](a: *A.Allocator, ax: *target_registry.Axis[T], noun: str, count: usize, name_at: fun(usize) str) err[fail.Fail] {
    var i: usize = 0;
    for (i < count) {
        val name:  str     = name_at(i);
        val found: opt[*T] = target_registry.find[T](ax, name);
        if (sel found.none) {
            ret err[fail.Fail].err{fail.formatted(a, "target: the catalog's {} '{}' has no registered member", noun, name)};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the catalog checked whole, once, before it is published: every catalog row
# has a registered member, every member's identity agrees with the shared
# catalog, every format's fingerprint tag is its own, and every format's
# default debug model is registered in the shape the format takes
fun catalog_check(reg: *TargetRegistry) err[fail.Fail] {
    val a:            *A.Allocator   = ?reg.alloc;
    val isas_covered: err[fail.Fail] = catalog_covered[isa.IsaVTable](a, ?reg.isa, "instruction set", catalog_arch.count(), catalog_arch.name_at);
    if (sel isas_covered.err) { ret isas_covered; }
    val oses_covered: err[fail.Fail] = catalog_covered[lang_target_os.OsVTable](a, ?reg.os, "operating system", catalog_os.count(), catalog_os.name_at);
    if (sel oses_covered.err) { ret oses_covered; }
    val abis_covered: err[fail.Fail] = catalog_covered[abi.AbiVTable](a, ?reg.abi, "calling convention", catalog_abi.count(), catalog_abi.name_at);
    if (sel abis_covered.err) { ret abis_covered; }
    var i: u32 = 0;
    for (i < reg.isa.count) {
        val vt: *isa.IsaVTable = reg.isa.members[i];
        val ok: err[fail.Fail] = identity_check(a, "instruction set", vt.name, catalog_arch.name_for(vt.id));
        if (sel ok.err) { ret ok; }
        i = i + 1;
    }
    i = 0;
    for (i < reg.os.count) {
        val vt: *lang_target_os.OsVTable = reg.os.members[i];
        val ok: err[fail.Fail]           = identity_check(a, "operating system", vt.name, catalog_os.name_for(vt.id));
        if (sel ok.err) { ret ok; }
        i = i + 1;
    }
    i = 0;
    for (i < reg.abi.count) {
        val vt: *abi.AbiVTable = reg.abi.members[i];
        if (vt.id != catalog_abi.UNKNOWN) {
            val ok: err[fail.Fail] = identity_check(a, "calling convention", vt.name, catalog_abi.name_for(vt.id));
            if (sel ok.err) { ret ok; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < reg.of.count) {
        val fmt: *target_of.OfVTable = reg.of.members[i];
        var j:   u32                 = 0;
        for (j < i) {
            if (reg.of.members[j].fingerprint_tag == fmt.fingerprint_tag) {
                ret err[fail.Fail].err{fail.formatted(a, "target: object formats '{}' and '{}' declare one fingerprint tag", reg.of.members[j].name, fmt.name)};
            }
            j = j + 1;
        }
        if (!str_empty(fmt.default_debug)) {
            val dbg_o: opt[*target_of.DebugVTable] = target_registry.find[target_of.DebugVTable](?reg.debug, fmt.default_debug);
            if (sel dbg_o.none) {
                ret err[fail.Fail].err{fail.formatted(a, "target: object format '{}' names debug model '{}', which is not registered", fmt.name, fmt.default_debug)};
            }
            if (dbg_o.some.shape != target_of.debug_shape_for(fmt)) {
                ret err[fail.Fail].err{fail.formatted(a, "target: object format '{}' takes a debug model of another shape than '{}'", fmt.name, fmt.default_debug)};
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# fill an empty registry with the catalog and publish it; a published registry
# is left as it is. a registry refused part way holds nothing that needs
# undoing, and is dropped
# ---
# reg:   the registry
# debug: the dwarf debug model, which the backend declares
pub fun register_all(reg: *TargetRegistry, debug: *target_of.DebugVTable) err[fail.Fail] {
    if (reg == nil || debug == nil) {
        ret err[fail.Fail].err{fail.message("target: register_all requires a registry and the dwarf debug model")};
    }
    if (reg.published) { ret err[fail.Fail].ok{}; }
    if (!target_registry.registry_empty(reg)) {
        ret err[fail.Fail].err{fail.message("target: register_all refuses a partial registry")};
    }
    val a: *A.Allocator = ?reg.alloc;
    var i: u32          = 0;
    for (i < members.ISA_COUNT) {
        val vt: *isa.IsaVTable = members.ISAS[i];
        if (vt.prepare != nil) { vt.prepare(); }
        val added: err[fail.Fail] = target_registry.add[isa.IsaVTable](?reg.isa, a, vt);
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    i = 0;
    for (i < members.ABI_COUNT) {
        val added: err[fail.Fail] = target_registry.add[abi.AbiVTable](?reg.abi, a, members.ABIS[i]);
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    i = 0;
    for (i < members.FORMAT_COUNT) {
        val added: err[fail.Fail] = target_registry.add[target_of.OfVTable](?reg.of, a, members.FORMATS[i]);
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    i = 0;
    for (i < members.OS_COUNT) {
        val added: err[fail.Fail] = target_registry.add[lang_target_os.OsVTable](?reg.os, a, members.OSES[i]);
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    val dwarf: err[fail.Fail] = target_registry.add[target_of.DebugVTable](?reg.debug, a, debug);
    if (sel dwarf.err) { ret dwarf; }
    i = 0;
    for (i < members.DEBUG_COUNT) {
        val added: err[fail.Fail] = target_registry.add[target_of.DebugVTable](?reg.debug, a, members.DEBUGS[i]);
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    val whole: err[fail.Fail] = catalog_check(reg);
    if (sel whole.err) { ret whole; }
    reg.published = true;
    ret err[fail.Fail].ok{};
}

pub rec TargetRequest {
    isa_name:      str;
    os_name:       str;
    abi_name:      str;
    of_name:       str;
    base:          u64;
    stack_reserve: u64;
    stack_commit:  u64;
    env_name:      str;
    # where the caller's `env` was written, which a refusal of it names
    env_origin: str;
    # names from the isa's extension vocabulary, borrowed for the call
    extensions:      *str;
    extension_count: u32;
    # the selection the target stands on, in masc's spelling, "" for the isa's default
    baseline_name: str;
}

pub fun target_request(isa_name: str, os_name: str, abi_name: str) TargetRequest {
    var r: TargetRequest;
    r.isa_name        = isa_name;
    r.os_name         = os_name;
    r.abi_name        = abi_name;
    r.of_name         = "";
    r.base            = 0;
    r.stack_reserve   = 0;
    r.stack_commit    = 0;
    r.env_name        = "";
    r.env_origin      = "";
    r.extensions      = nil;
    r.extension_count = 0;
    r.baseline_name   = "";
    ret r;
}

pub fun with_baseline(req: *TargetRequest, baseline_name: str) {
    req.baseline_name = baseline_name;
}

pub fun with_extensions(req: *TargetRequest, names: *str, count: u32) {
    req.extensions      = names;
    req.extension_count = count;
}

pub fun with_of(req: *TargetRequest, of_name: str) {
    req.of_name = of_name;
}

pub fun with_env(req: *TargetRequest, env_name: str, origin: str) {
    req.env_name   = env_name;
    req.env_origin = origin;
}

pub fun with_image(req: *TargetRequest, base: u64, stack_reserve: u64, stack_commit: u64) {
    req.base          = base;
    req.stack_reserve = stack_reserve;
    req.stack_commit  = stack_commit;
}

pub fun select_of(reg: *TargetRegistry, isa_name: str, os_name: str, abi_name: str, of_name: str) res[binding.Binding, fail.Fail] {
    var req: TargetRequest = target_request(isa_name, os_name, abi_name);
    with_of(?req, of_name);
    ret resolve(reg, ?req);
}

# the granularity the image is laid out at: a format a loader maps by page puts
# each segment on a page of its own, the operating system's page where it
# declares one (the largest a kernel of that system may use) and the isa's
# hardware page otherwise; a flat image has no page and is laid out byte-tight
fun tuple_page_size(a: *A.Allocator, os_vt: *lang_target_os.OsVTable, arch_vt: *isa.IsaVTable, of_vt: *target_of.OfVTable) res[u64, fail.Fail] {
    if (!of_vt.maps_by_page) { ret res[u64, fail.Fail].ok{1}; }
    val os_page_r: res[u64, fail.Fail] = lang_target_os.page_size_checked_for(os_vt, arch_vt.id);
    if (sel os_page_r.err)      { ret os_page_r; }
    if (os_page_r.ok != 0)      { ret os_page_r; }
    if (arch_vt.page_size != 0) { ret res[u64, fail.Fail].ok{arch_vt.page_size}; }
    ret res[u64, fail.Fail].err{no_page_size(a, os_vt, arch_vt, of_vt)};
}

# every extension vocabulary the registry's instruction sets declare, each table once
fun vocabulary(reg: *TargetRegistry) res[extension.Vocabulary, fail.Fail] {
    var v: extension.Vocabulary = extension.vocabulary_empty();
    var i: u32                  = 0;
    for (i < reg.isa.count) {
        val m: *target_model.Machine = reg.isa.members[i].model;
        if (!extension.vocabulary_add(?v, m.extension_table)) {
            ret res[extension.Vocabulary, fail.Fail].err{fail.message(
                "target: the registry declares more extension vocabularies than a description carries; raise extension.VOCABULARY_CAP")};
        }
        i = i + 1;
    }
    ret res[extension.Vocabulary, fail.Fail].ok{v};
}

pub fun resolve(reg: *TargetRegistry, req: *TargetRequest) res[binding.Binding, fail.Fail] {
    if (reg == nil || req == nil) {
        ret res[binding.Binding, fail.Fail].err{fail.message("target: resolve requires a registry and target request")};
    }
    if (!target_registry.registry_published(reg)) {
        ret res[binding.Binding, fail.Fail].err{fail.message("target: resolve requires a published registry")};
    }
    val isa_name: str = req.isa_name;
    val os_name:  str = req.os_name;
    val abi_name: str = req.abi_name;
    val of_name:  str = req.of_name;

    val opt_os_vt: opt[*lang_target_os.OsVTable] = target_registry.find[lang_target_os.OsVTable](?reg.os, os_name);
    if (sel opt_os_vt.none) {
        ret res[binding.Binding, fail.Fail].err{unregistered[lang_target_os.OsVTable](reg, ?reg.os, os_name)};
    }
    val os_vt: *lang_target_os.OsVTable = opt_os_vt.some;

    val opt_arch_vt: opt[*isa.IsaVTable] = target_registry.find[isa.IsaVTable](?reg.isa, isa_name);
    if (sel opt_arch_vt.none) {
        ret res[binding.Binding, fail.Fail].err{unregistered[isa.IsaVTable](reg, ?reg.isa, isa_name)};
    }
    val opt_abi_vt: opt[*abi.AbiVTable] = target_registry.find[abi.AbiVTable](?reg.abi, abi_name);
    if (sel opt_abi_vt.none) {
        ret res[binding.Binding, fail.Fail].err{unregistered[abi.AbiVTable](reg, ?reg.abi, abi_name)};
    }

    val arch_vt: *isa.IsaVTable = opt_arch_vt.some;
    val abi_vt:  *abi.AbiVTable = opt_abi_vt.some;

    var of_sel: str = of_name;
    if (str_empty(of_sel)) {
        val opt_def: opt[str] = default_of_name(reg, os_vt, arch_vt);
        if (sel opt_def.none) {
            ret res[binding.Binding, fail.Fail].err{no_module_format(?reg.alloc, arch_vt)};
        }
        of_sel = opt_def.some;
    }
    val opt_of_vt: opt[*target_of.OfVTable] = target_registry.find[target_of.OfVTable](?reg.of, of_sel);
    if (sel opt_of_vt.none) {
        ret res[binding.Binding, fail.Fail].err{unregistered[target_of.OfVTable](reg, ?reg.of, of_sel)};
    }

    val of_vt: *target_of.OfVTable = opt_of_vt.some;

    # a baseline is the floor of a host that runs the isa, so an os that does not
    # run it is refused before one is read
    if (!lang_target_os.supports_isa(os_vt, arch_vt.id)) {
        ret res[binding.Binding, fail.Fail].err{tuple.refusal(?reg.alloc, tuple.OS_NO_ISA, os_vt, arch_vt, abi_vt, of_vt)};
    }
    val spelled_r: res[opt[str], fail.Fail] = baseline_spelling(?reg.alloc, os_vt, arch_vt, abi_vt, req.baseline_name, req.env_name);
    if (sel spelled_r.err) { ret res[binding.Binding, fail.Fail].err{spelled_r.err}; }
    val base_r: res[u64, fail.Fail] = baseline_bits(?reg.alloc, arch_vt, spelled_r.ok);
    if (sel base_r.err) { ret res[binding.Binding, fail.Fail].err{base_r.err}; }
    val added_r: res[u64, fail.Fail] = requested_extensions(?reg.alloc, arch_vt, req);
    if (sel added_r.err) { ret res[binding.Binding, fail.Fail].err{added_r.err}; }
    val env_r: res[u32, fail.Fail] = resolve_environment(?reg.alloc, arch_vt, req);
    if (sel env_r.err) { ret res[binding.Binding, fail.Fail].err{env_r.err}; }
    # the selection holds what the environment guarantees beside what it names
    val added: u64 = added_r.ok | isa_environment.extensions(?arch_vt.environments, env_r.ok);

    var selected_model: target_model.Machine;
    val selected_isa:   isa.IsaVTable = select_isa(arch_vt, base_r.ok, added, ?selected_model);
    val cap:            u32           = tuple.capability(os_vt, ?selected_isa, abi_vt, of_vt);
    if (cap != tuple.OK) {
        ret res[binding.Binding, fail.Fail].err{tuple.refusal(?reg.alloc, cap, os_vt, ?selected_isa, abi_vt, of_vt)};
    }

    var b: binding.Binding;
    b.os  = os_vt;
    b.isa = arch_vt;
    isa.object_target(arch_vt, ?b.object);
    b.object.extensions     = selected_model.extensions;
    b.object.float_arg_bits = abi_vt.float_arg_bits;
    b.arch                  = arch_vt.machine;
    b.abi                   = abi_vt;
    b.of                    = of_vt;
    b.reserved_gp           = binding.reserved_gp_of(b.arch, os_vt, arch_vt.id);

    val vocabulary_r: res[extension.Vocabulary, fail.Fail] = vocabulary(reg);
    if (sel vocabulary_r.err) { ret res[binding.Binding, fail.Fail].err{vocabulary_r.err}; }

    var t: *resolved.Target = ?b.target;
    t.env_id           = env_r.ok;
    t.env_profile      = isa_environment.profile(?arch_vt.environments, t.env_id);
    t.env_name         = req.env_name;
    t.base             = req.base;
    t.stack_reserve    = req.stack_reserve;
    t.stack_commit     = req.stack_commit;
    t.pointer_width    = arch_vt.pointer_width;
    t.defs             = arch_vt.defs;
    t.passing          = abi_vt.passing;
    t.vocabulary       = vocabulary_r.ok;
    t.has_assembly     = isa.has_assembly(arch_vt);
    t.assembly_returns = nil;
    t.int_imm_fits     = nil;
    if (arch_vt.machine != nil) {
        if (arch_vt.machine.has_assembly) { t.assembly_returns = arch_vt.machine.assembly.returns; }
        t.int_imm_fits = arch_vt.machine.int_imm_fits;
    }

    t.variadic_args_on_stack = lang_target_os.variadic_stack_for(os_vt, arch_vt.id);

    t.fixed_args_natural_size = lang_target_os.natural_stack_args_for(os_vt, arch_vt.id);

    t.reg_arg_align = lang_target_os.reg_arg_align_for(os_vt, arch_vt.id);
    # the convention's widening and the platform's are one requirement, so the wider holds
    t.reg_arg_extend = abi_vt.reg_arg_extend;
    val os_extend: u32 = lang_target_os.reg_arg_extend_for(os_vt, arch_vt.id);
    if (os_extend > t.reg_arg_extend) { t.reg_arg_extend = os_extend; }

    t.agg_arg_natural_align = abi_vt.agg_natural_align && !lang_target_os.declared_agg_align_for(os_vt, arch_vt.id);

    var vl_size:  u32                                        = 0;
    var vl_align: u32                                        = 0;
    val vl_r:     res[opt[lang_target_os.VaList], fail.Fail] = lang_target_os.va_list_checked_for(os_vt, arch_vt.id);
    if (sel vl_r.err) {
        ret res[binding.Binding, fail.Fail].err{vl_r.err};
    }
    val vl: opt[lang_target_os.VaList] = vl_r.ok;
    if (sel vl.some) {
        vl_size  = vl.some.size;
        vl_align = vl.some.align;
    }
    t.va_list_size  = vl_size;
    t.va_list_align = vl_align;

    t.os_id   = os_vt.id;
    t.arch_id = arch_vt.id;
    t.abi_id  = abi_vt.id;
    t.of_id   = of_vt.id;

    val caps_r: res[mink_os.Caps, fail.Fail] = target_host.caps(?reg.alloc, os_vt.id, arch_vt.id, abi_vt.id, req.env_name);
    if (sel caps_r.err) { ret res[binding.Binding, fail.Fail].err{caps_r.err}; }
    t.timing_mode_provable = (caps_r.ok & mink_os.TIMING_MODE_PROVABLE) != 0;
    t.pie_default          = (caps_r.ok & mink_os.PIE_DEFAULT) != 0;

    val page_r: res[u64, fail.Fail] = tuple_page_size(?reg.alloc, os_vt, arch_vt, of_vt);
    if (sel page_r.err) { ret res[binding.Binding, fail.Fail].err{page_r.err}; }
    t.page_size = page_r.ok;

    val fp_r: res[opt[catalog_os.FsPolicy], fail.Fail] = lang_target_os.fs_policy_checked_for(os_vt, arch_vt.id);
    if (sel fp_r.err) {
        ret res[binding.Binding, fail.Fail].err{fp_r.err};
    }
    val fp_opt: opt[catalog_os.FsPolicy] = fp_r.ok;
    if (sel fp_opt.none) {
        ret res[binding.Binding, fail.Fail].err{no_fs_policy(?reg.alloc, os_vt, arch_vt)};
    }
    t.fs_policy = fp_opt.some;

    b.debug    = nil;
    t.debug_id = target_of.DBG_UNKNOWN;
    if (!str_empty(of_vt.default_debug)) {
        val opt_dbg: opt[*target_of.DebugVTable] = target_registry.find[target_of.DebugVTable](?reg.debug, of_vt.default_debug);
        if (sel opt_dbg.none) {
            ret res[binding.Binding, fail.Fail].err{unregistered[target_of.DebugVTable](reg, ?reg.debug, of_vt.default_debug)};
        }
        b.debug    = opt_dbg.some;
        t.debug_id = b.debug.id;
        var debug_target: mir_debug.DebugTarget;
        debug_target.arch_id   = arch_vt.id;
        debug_target.os_id     = os_vt.id;
        debug_target.abi_id    = abi_vt.id;
        debug_target.of_id     = of_vt.id;
        debug_target.dwarf_reg = nil;
        debug_target.cv_reg    = nil;
        if (arch_vt.machine != nil) {
            debug_target.dwarf_reg = arch_vt.machine.dwarf_reg;
            debug_target.cv_reg    = arch_vt.machine.cv_reg;
        }
        if (b.debug.shape != target_of.debug_shape_for(of_vt) || b.debug.supports == nil || !b.debug.supports(?debug_target)) {
            ret res[binding.Binding, fail.Fail].err{fail.message("target: selected debug model is incompatible with the target tuple")};
        }
    }

    # the selection the owners' target stands on: the baseline with the extensions
    # the target adds, so a convention an added extension carries holds over it
    # a target whose isa takes no baseline stands on what its environment sets
    var stands: opt[str] = isa_environment.stands(?arch_vt.environments, env_r.ok);
    if (sel spelled_r.ok.some) {
        val wide: res[str, fail.Fail] = target_baseline.widened(?reg.alloc, catalog_arch.owner_of(arch_vt.id), selected_model.extension_table, spelled_r.ok.some, selected_model.extensions);
        if (sel wide.err) { ret res[binding.Binding, fail.Fail].err{wide.err}; }
        stands = opt[str].some{wide.ok};
    }
    t.stands  = stands;
    t.scalars = layout.scalars_none();
    t.nans    = resolved.nans_of_rule(selected_model.nan_rule);
    val owned_r: res[opt[target_owner.Owned], fail.Fail] = target_owner.owned_for(?reg.alloc, os_vt.id, arch_vt.id, abi_vt.id, req.env_name, stands, selected_model.extension_table, selected_model.extensions);
    if (sel owned_r.err) { ret res[binding.Binding, fail.Fail].err{owned_r.err}; }
    if (sel owned_r.ok.some) {
        val held: layout.Scalars = owned_r.ok.some.scalars;
        t.scalars = held;
        t.nans    = owned_r.ok.some.nans;
        if (sel held.pointer.some) { t.pointer_width = held.pointer.some.size; }
    }

    t.model              = selected_model;
    t.model.stack_align  = abi_vt.stack_align;
    t.model.red_zone     = abi_vt.red_zone;
    t.model.shadow_space = abi_vt.shadow_space;

    ret res[binding.Binding, fail.Fail].ok{b};
}

# the selection the target stands on, as masc's catalog for its isa spells it:
# the one it names, else the floor its host states. a target whose host states no
# floor, as every freestanding one, names its baseline, since the chip decides it
# and no default is right. none for an instruction set whose catalog spells no
# selection, which takes no baseline and stands on its model's own extensions
fun baseline_spelling(a: *A.Allocator, os_vt: *lang_target_os.OsVTable, arch_vt: *isa.IsaVTable, abi_vt: *abi.AbiVTable, named: str, env: str) res[opt[str], fail.Fail] {
    if (!target_baseline.takes_baseline(catalog_arch.owner_of(arch_vt.id), arch_vt.model.extension_table)) {
        if (!str_empty(named)) {
            ret res[opt[str], fail.Fail].err{fail.formatted(a,
                "target: isa '{}' takes no `baseline`: masc's extension catalog for it spells no selection; name what it adds with `extensions`", arch_vt.name)};
        }
        ret res[opt[str], fail.Fail].ok{opt[str].none{}};
    }
    if (!str_empty(named)) { ret res[opt[str], fail.Fail].ok{opt[str].some{named}}; }
    val floor: res[opt[str], fail.Fail] = target_host.floor(a, os_vt.id, arch_vt.id, abi_vt.id, env);
    if (sel floor.err) { ret res[opt[str], fail.Fail].err{floor.err}; }
    if (sel floor.ok.none) {
        ret res[opt[str], fail.Fail].err{fail.formatted_user(a, diagnostic_kind.TARGET_BASELINE_REQUIRED,
            "target: a '{}' target on {} must state its `baseline`, the selection its chip implements: the system states no floor, so no default is right", arch_vt.name, os_vt.name)};
    }
    ret floor;
}

# the bits the selection `spelled` selects, read by masc's catalog for the isa,
# the model's own extensions where the isa takes no baseline
fun baseline_bits(a: *A.Allocator, arch_vt: *isa.IsaVTable, spelled: opt[str]) res[u64, fail.Fail] {
    if (sel spelled.none) { ret res[u64, fail.Fail].ok{arch_vt.model.extensions}; }
    val picked: res[u64, fail.Fail] = target_baseline.select(a, catalog_arch.owner_of(arch_vt.id), arch_vt.model.extension_table, spelled.some);
    if (sel picked.err) {
        ret res[u64, fail.Fail].err{fail.formatted(a, "target: baseline `{}` on isa '{}': {}", spelled.some, arch_vt.name, fail.describe(picked.err))};
    }
    ret picked;
}

# the bits a request's extension names select in the isa's vocabulary; a name the
# vocabulary does not hold is refused with the names it does
fun requested_extensions(a: *A.Allocator, arch_vt: *isa.IsaVTable, req: *TargetRequest) res[u64, fail.Fail] {
    var bits: u64 = 0;
    var i:    u32 = 0;
    for (i < req.extension_count) {
        val name: str = req.extensions[i];
        val bit:  u64 = target_model.extension_bundle(arch_vt.model, name, str_len(name));
        if (bit == 0) { ret res[u64, fail.Fail].err{unknown_extension(a, arch_vt, name)}; }
        bits = bits | bit;
        i    = i + 1;
    }
    ret res[u64, fail.Fail].ok{bits};
}

fun unknown_extension(a: *A.Allocator, arch_vt: *isa.IsaVTable, name: str) fail.Fail {
    val known_r: res[str, fail.Fail] = target_model.extension_names(a, arch_vt.model);
    if (sel known_r.err) { ret known_r.err; }
    val known: str = known_r.ok;
    fin { str_free(a, known); }
    val levels_r: res[str, fail.Fail] = target_model.level_names(a, arch_vt.model);
    if (sel levels_r.err) { ret levels_r.err; }
    val levels: str = levels_r.ok;
    fin { str_free(a, levels); }
    if (str_empty(levels)) {
        ret fail.formatted(a, "target: `{}` is not an extension of isa '{}'; its extensions are: {}", name, arch_vt.name, known);
    }
    ret fail.formatted(a, "target: `{}` is not an extension or level of isa '{}'; its extensions are: {}; its levels are: {}",
        name, arch_vt.name, known, levels);
}

fun default_of_name(reg: *TargetRegistry, os_vt: *lang_target_os.OsVTable, isa_vt: *isa.IsaVTable) opt[str] {
    if (!isa.emits_whole_module(isa_vt)) { ret opt[str].some{os_vt.default_of}; }
    var i: u32 = 0;
    for (i < reg.of.count) {
        val of_vt: *target_of.OfVTable = reg.of.members[i];
        if (of_vt.object_is_artifact && target_of.covers_isa(of_vt, isa_vt.id)) {
            ret opt[str].some{of_vt.name};
        }
        i = i + 1;
    }
    ret opt[str].none{};
}

fun no_module_format(a: *A.Allocator, isa_vt: *isa.IsaVTable) fail.Fail {
    ret fail.formatted(a, "instruction set '{}' emits whole modules, but no registered object format carries a finished module for it", isa_vt.name);
}

# the instruction set the registered template selects with the baseline's
# extensions, and those the request adds, applied. model backs the returned
# vtable's model pointer and must outlive it
fun select_isa(arch_vt: *isa.IsaVTable, base: u64, added: u64, model: *target_model.Machine) isa.IsaVTable {
    @model = @arch_vt.model;
    isa.extensions_select(arch_vt, model, target_model.extension_close(model, base | added));
    var selected: isa.IsaVTable = @arch_vt;
    selected.model = model;
    ret selected;
}

# the instruction set a [target.*] table selects by naming a registered isa and no
# baseline: the template narrowed to its host's floor, or the whole template
# where the host states none and a target names the baseline. model backs the
# returned vtable's model pointer and must outlive it
pub fun registered_selection(os_vt: *lang_target_os.OsVTable, arch_vt: *isa.IsaVTable, abi_vt: *abi.AbiVTable, model: *target_model.Machine) isa.IsaVTable {
    var a: A.Allocator;
    page.make(?a);
    var base:    u64                      = arch_vt.model.extensions;
    val spelled: res[opt[str], fail.Fail] = baseline_spelling(?a, os_vt, arch_vt, abi_vt, "", "");
    if (sel spelled.ok) {
        val bits: res[u64, fail.Fail] = baseline_bits(?a, arch_vt, spelled.ok);
        if (sel bits.ok) { base = bits.ok; }
    }
    ret select_isa(arch_vt, base, 0, model);
}

# the capability of one cell of the target matrix as a [target.*] table naming
# these four registered spellings composes it: the registered template alone
# overstates an isa whose default selection may lack the float registers an
# abi passes in
pub fun registered_tuple_capability(os_vt: *lang_target_os.OsVTable, arch_vt: *isa.IsaVTable, abi_vt: *abi.AbiVTable, of_vt: *target_of.OfVTable) u32 {
    var model:    target_model.Machine;
    val selected: isa.IsaVTable = registered_selection(os_vt, arch_vt, abi_vt, ?model);
    ret tuple.capability(os_vt, ?selected, abi_vt, of_vt);
}

# the selection an instruction set and the model selected on it hold (a resolved
# target's `model`, or the one registered_selection filled), written into buf: an
# isa whose catalog spells a selection gives masc's spelling of the extensions the
# model holds, every other isa its name
pub fun selection_spelling(isa_vt: *isa.IsaVTable, model: *target_model.Machine, buf: *u8, cap: usize) str {
    var text: str = isa_vt.name;
    var a:    A.Allocator;
    page.make(?a);
    if (target_baseline.takes_baseline(catalog_arch.owner_of(isa_vt.id), model.extension_table)) {
        val spelled: res[str, fail.Fail] = target_baseline.spell(?a, catalog_arch.owner_of(isa_vt.id), model.extension_table, model.extensions, false);
        if (sel spelled.ok) {
            var off: usize = buf_put(buf, cap, 0, spelled.ok);
            str_free(?a, spelled.ok);
            if (off >= cap) { off = cap - 1; }
            buf[off] = 0;
            ret buf::str;
        }
    }
    var off: usize = buf_put(buf, cap, 0, text);
    if (off >= cap) { off = cap - 1; }
    buf[off] = 0;
    ret buf::str;
}

# the request a `native` selection, or a [target.*] table naming the host
# without an object format, resolves: the host os, isa and abi by their
# registered names, the object format left to the os default
pub fun host_request() TargetRequest {
    ret target_request(catalog_arch.name_for(host_arch_id()), catalog_os.name_for(host_os_id()), catalog_abi.name_for(host_abi_id()));
}

pub fun select(reg: *TargetRegistry, isa_name: str, os_name: str, abi_name: str) res[binding.Binding, fail.Fail] {
    ret select_of(reg, isa_name, os_name, abi_name, "");
}

pub fun artifact_naming(tgt: *binding.Binding, kind: catalog_artifact.Kind) res[target_of.ArtifactName, fail.Fail] {
    if (tgt == nil || tgt.of == nil || tgt.os == nil) {
        ret res[target_of.ArtifactName, fail.Fail].err{fail.message("artifact naming: target has no selected object format")};
    }
    ret target_of.artifact_naming(tgt.of, ?tgt.os.naming, kind);
}

fun buf_put(buf: *u8, cap: usize, off: usize, s: str) usize {
    var i: usize = 0;
    val n: usize = str_len(s);
    var o: usize = off;
    for (i < n && o < cap - 1) {
        buf[o] = s[i];
        o      = o + 1;
        i      = i + 1;
    }
    ret o;
}

# the names an axis holds, `, `-separated, owned by the registry's allocator
fun registered_names[T](reg: *TargetRegistry, ax: *target_registry.Axis[T]) res[str, fail.Fail] {
    var b: textbuild.TextBuilder = textbuild.tb_init(?reg.alloc);
    ret target_model.spelling_finish(?b, registered_names_append[T](?b, ax));
}

fun registered_names_append[T](b: *textbuild.TextBuilder, ax: *target_registry.Axis[T]) err[textbuild.Error] {
    var i: u32 = 0;
    for (i < ax.count) {
        if (i > 0) {
            val sep: err[textbuild.Error] = textbuild.tb_append(b, ", ");
            if (sel sep.err) { ret sep; }
        }
        val named: err[textbuild.Error] = textbuild.tb_append(b, ax.name_of(ax.members[i]));
        if (sel named.err) { ret named; }
        i = i + 1;
    }
    ret err[textbuild.Error].ok{};
}

fun no_fs_policy(a: *A.Allocator, os_vt: *lang_target_os.OsVTable, arch_vt: *isa.IsaVTable) fail.Fail {
    ret fail.formatted(a, "no file-system policy declared for '{}-{}'", arch_vt.name, os_vt.name);
}

fun no_page_size(a: *A.Allocator, os_vt: *lang_target_os.OsVTable, arch_vt: *isa.IsaVTable, of_vt: *target_of.OfVTable) fail.Fail {
    ret fail.formatted(a, "object format '{}' is mapped by page, but neither '{}' nor '{}' declares a page size", of_vt.name, os_vt.name, arch_vt.name);
}

# the isa's own environment named by `env`, NONE where the isa defines none and the
# value is the system's alone, which mink's host rows and mirl's record check
fun resolve_environment(a: *A.Allocator, arch_vt: *isa.IsaVTable, req: *TargetRequest) res[u32, fail.Fail] {
    if (str_empty(req.env_name) || arch_vt.environments.count == 0) { ret res[u32, fail.Fail].ok{isa_environment.NONE}; }
    val id: u32 = isa_environment.lookup(?arch_vt.environments, req.env_name);
    if (id == isa_environment.NONE) {
        ret res[u32, fail.Fail].err{environment_refusal(a, req, arch_vt, "does not define it")};
    }
    ret res[u32, fail.Fail].ok{id};
}

# a refused `env` named where the caller wrote it, with the environments the isa does define
fun environment_refusal(a: *A.Allocator, req: *TargetRequest, arch_vt: *isa.IsaVTable, why: str) fail.Fail {
    var b:       textbuild.TextBuilder = textbuild.tb_init(a);
    val known_r: res[str, fail.Fail]   = target_model.spelling_finish(?b, environment_names_append(?b, arch_vt));
    if (sel known_r.err) { ret known_r.err; }
    val known: str = known_r.ok;
    fin { str_free(a, known); }
    if (str_empty(req.env_origin)) {
        ret fail.formatted(a, "env \"{}\": isa '{}' {} (known: {})", req.env_name, arch_vt.name, why, known);
    }
    ret fail.formatted(a, "{}: isa '{}' {} (known: {})", req.env_origin, arch_vt.name, why, known);
}

# the isa's environment names, `, `-separated, appended to `b`
fun environment_names_append(b: *textbuild.TextBuilder, arch_vt: *isa.IsaVTable) err[textbuild.Error] {
    var i: u32 = 0;
    for (i < arch_vt.environments.count) {
        if (i > 0) {
            val sep: err[textbuild.Error] = textbuild.tb_append(b, ", ");
            if (sel sep.err) { ret sep; }
        }
        val named: err[textbuild.Error] = textbuild.tb_append(b, arch_vt.environments.rows[i].name);
        if (sel named.err) { ret named; }
        i = i + 1;
    }
    ret err[textbuild.Error].ok{};
}

fun unregistered[T](reg: *TargetRegistry, ax: *target_registry.Axis[T], name: str) fail.Fail {
    val names_r: res[str, fail.Fail] = registered_names[T](reg, ax);
    if (sel names_r.err) { ret names_r.err; }
    val names: str = names_r.ok;
    fin { str_free(?reg.alloc, names); }
    ret fail.formatted(?reg.alloc, "no {} implementation registered for '{}' (registered: {})", ax.noun, name, names);
}
