    ret 0;
}

test "mach.lang.target.select_of:freestanding_raw_emits_flat_image" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: R.Result[R.Void, str] = register_all(?reg, target_testing.debug_descriptor);
    if (R.is_err[R.Void, str](res_reg)) { ret 1; }

    val res_target: R.Result[resolved.Target, str] = select_of(?reg, "x86_64", "freestanding", "sysv64", "raw");
    if (R.is_err[resolved.Target, str](res_target)) { ret 1; }
    val t: resolved.Target = R.unwrap_ok[resolved.Target, str](res_target);
    if (t.of == nil)           { ret 1; }
    if (t.of.id != of.OF_RAW)  { ret 1; }
    if (t.of.emit_exec == nil) { ret 1; }

    var code_bytes: [4]u8;
    code_bytes[0] = 0xEB; code_bytes[1] = 0xFE; code_bytes[2] = 0x90; code_bytes[3] = 0x90;
    var segs: [1]of.LoadSegment;
    segs[0].vaddr = t.os.base_addr; segs[0].filesz = 4; segs[0].memsz = 4;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?code_bytes[0];

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "sel_raw");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    var operation: publication.Plan;
    val opened: R.Result[*publication.Destination, str] = t_publication_open(?operation, ?alloc, tpath);
    if (R.is_err[*publication.Destination, str](opened)) {
        val failed: R.Result[R.Void, str] = t_publication_close(?operation, R.err[R.Void, str](R.unwrap_err[*publication.Destination, str](opened)));
        fs.temp_close_and_remove(?tf);
        if (R.is_err[R.Void, str](failed)) { ret 1; }
        ret 1;
    }
    val em: R.Result[R.Void, str] =
        t_publication_close(?operation, t.of.emit_exec(?alloc, ?itn, ?t.object, ?segs[0], 1, t.os.page_size,
                       t.os.base_addr, t.os.base_addr, nil::*of.ExecFunction, 0,
                       nil::*of.Section, 0, nil::*of.Section, 0,
                       nil::*of.SymtabEntry, 0,
                       R.unwrap_ok[*publication.Destination, str](opened), "selraw"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE)));
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rr: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rr)) { ret 1; }
    var b: Vector[u8] = R.unwrap_ok[Vector[u8], str](rr);

    if (b.len != 4)        { vector.dnit[u8](?b); ret 1; }
    if (b.data[0] == 0x7F) { vector.dnit[u8](?b); ret 1; }
    if (b.data[0] != 0xEB) { vector.dnit[u8](?b); ret 1; }
    if (b.data[1] != 0xFE) { vector.dnit[u8](?b); ret 1; }

    vector.dnit[u8](?b);
    ret 0;
}

