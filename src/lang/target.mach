test select__vector_lane_ceiling {
    val reg: *TargetRegistry = t_registry();

    val tx: res[binding.Binding, fail.Fail] = select_of(reg, "x86_64", "linux", "sysv64", "");
    if (sel tx.err) { ret 1; }
    val mx: target_model.Machine = tx.ok.target.model;
    if (mx.max_vector_lanes != target_model.VECTOR_LANES_UNBOUNDED)                  { ret 1; }
    if (target_model.packed_lane_cap(?mx, false, 8) != 16)                           { ret 1; }
    if (target_model.packed_lane_cap(?mx, false, 32) != 4)                           { ret 1; }
    if (target_model.packed_width(?mx, target_model.VEC_OP_ADD, false, 8, 8) != 128) { ret 1; }

    val ta: res[binding.Binding, fail.Fail] = select_of(reg, "aarch64", "linux", "aapcs64", "");
    if (sel ta.err) { ret 1; }
    val ma: target_model.Machine = ta.ok.target.model;
    if (ma.max_vector_lanes != target_model.VECTOR_LANES_UNBOUNDED)                  { ret 1; }
    if (target_model.packed_width(?ma, target_model.VEC_OP_ADD, false, 8, 8) != 128) { ret 1; }

    val tr: res[binding.Binding, fail.Fail] = select_of(reg, "riscv64", "linux", "lp64d", "");
    if (sel tr.err)                                                                 { ret 1; }
    if (tr.ok.target.model.max_vector_lanes != target_model.VECTOR_LANES_UNBOUNDED) { ret 1; }

    val ts: res[binding.Binding, fail.Fail] = select_of(reg, "spirv", "freestanding", "spirv", "spv");
    if (sel ts.err) { ret 1; }
    val ms: target_model.Machine = ts.ok.target.model;
    if (ms.max_vector_lanes != 4)                                                      { ret 1; }
    if (target_model.packed_lane_cap(?ms, false, 8) != 4)                              { ret 1; }
    if (target_model.packed_width(?ms, target_model.VEC_OP_ADD, false, 8, 8) != 32)    { ret 1; }
    if (target_model.packed_width(?ms, target_model.VEC_OP_ADD, false, 32, 32) != 128) { ret 1; }
    # spir-v's ceiling is a component count, so 64-bit lanes pack four wide
    if (target_model.packed_lane_cap(?ms, false, 64) != 4 || target_model.packed_lane_cap(?ms, true, 64) != 4) { ret 3; }
    if (target_model.packed_width(?ms, target_model.VEC_OP_ADD, true, 64, 64) != 256)                          { ret 3; }
    val mr: target_model.Machine = tr.ok.target.model;
    if (mx.packed_form_len != 144 || ma.packed_form_len != 148
        || ms.packed_form_len != 93 || mr.packed_form_len != 0) { ret 2; }
    # a conversion packs only where the lane result is the scalar one, and its
    # wider side sets the extent
    if (target_model.packed_width(?mx, target_model.VEC_OP_SEXT, false, 64, 8) != 128
        || target_model.packed_width(?ma, target_model.VEC_OP_FP_TO_UI, false, 8, 64) != 128
        || target_model.packed_width(?ms, target_model.VEC_OP_TRUNC, false, 8, 64) != 256) { ret 7; }
    if (target_model.packed_width(?mx, target_model.VEC_OP_FP_TO_UI, false, 8, 32) != 0
        || target_model.packed_width(?mx, target_model.VEC_OP_SI_TO_FP, true, 64, 64) != 0
        || target_model.packed_width(?ma, target_model.VEC_OP_SI_TO_FP, true, 32, 64) != 0
        || target_model.packed_width(?ms, target_model.VEC_OP_FP_EXT, true, 64, 32) != 0) { ret 8; }
    if (target_model.packed_lane_cap(?mx, false, 64) != 2) { ret 9; }
    # the baseline register is the compute width; avx widens it to ymm
    if (target_model.vector_register_bytes(?mx) != 16 || target_model.vector_register_bytes(?ma) != 16) { ret 14; }
    var mv: target_model.Machine = mx;
    mv.extensions = extension_x64.AVX | extension_x64.SSE42 | extension_x64.SSE41 | extension_x64.SSSE3;
    if (target_model.vector_register_bytes(?mv) != 32 || !target_model.vector_upper_clear(?mv, 32) || target_model.vector_upper_clear(?mv, 16)) { ret 15; }
    if (target_model.vector_upper_clear(?mx, 32))                                                                                               { ret 16; }
    # avx computes the float lanes at 256 bits and avx2 the integer ones, a
    # conversion between the kinds only as wide as both are
    if (target_model.packed_lane_cap(?mv, true, 32) != 8 || target_model.packed_lane_cap(?mv, false, 32) != 4) { ret 19; }
    if (target_model.packed_width(?mv, target_model.VEC_OP_SI_TO_FP, true, 32, 32) != 128)                     { ret 19; }
    mv.extensions = mv.extensions | extension_x64.AVX2;
    if (target_model.packed_lane_cap(?mv, false, 8) != 32 || target_model.packed_lane_cap(?mv, true, 64) != 4) { ret 20; }
    if (target_model.packed_width(?mv, target_model.VEC_OP_SI_TO_FP, true, 32, 32) != 256)                     { ret 20; }
    if (target_model.packed_lane_cap(?mx, true, 32) != 4 || target_model.vector_register_bits(?mx) != 128)     { ret 21; }
    # a lane range and a lane join pack where a vector lives in a register and
    # keep the lane path on spir-v
    if (target_model.vector_form(?mx, target_model.VEC_OP_RANGE, false, 8, 8) != target_model.FORM_PACKED
        || target_model.vector_form(?mx, target_model.VEC_OP_RANGE, true, 64, 64) != target_model.FORM_PACKED
        || target_model.vector_form(?ma, target_model.VEC_OP_RANGE, false, 32, 32) != target_model.FORM_PACKED
        || target_model.vector_form(?mx, target_model.VEC_OP_CONCAT, false, 16, 16) != target_model.FORM_PACKED
        || target_model.vector_form(?ma, target_model.VEC_OP_CONCAT, true, 64, 64) != target_model.FORM_PACKED
        || target_model.vector_form(?ms, target_model.VEC_OP_RANGE, true, 32, 32) != target_model.FORM_SCALAR
        || target_model.vector_form(?ms, target_model.VEC_OP_CONCAT, false, 8, 8) != target_model.FORM_SCALAR) { ret 13; }
    # a widening group sum packs bytes into quadwords as psadbw, and every
    # other cell and target keeps the per-lane sum
    if (target_model.vector_form(?mx, target_model.VEC_OP_WIDEN_SUM_U, false, 64, 8) != target_model.FORM_PACKED
        || target_model.vector_form(?mx, target_model.VEC_OP_WIDEN_SUM_U, false, 32, 8) != target_model.FORM_SCALAR
        || target_model.vector_form(?ma, target_model.VEC_OP_WIDEN_SUM_U, false, 64, 8) != target_model.FORM_SCALAR
        || target_model.vector_form(?ms, target_model.VEC_OP_WIDEN_SUM_U, false, 64, 8) != target_model.FORM_SCALAR) { ret 17; }
    # a lane sign mask packs as pcmpgt* at 8, 16 and 32 bits, and every other
    # cell and target declares the per-lane shift it is never formed as
    if (target_model.vector_form(?mx, target_model.VEC_OP_SIGN_MASK, false, 8, 8) != target_model.FORM_PACKED
        || target_model.vector_form(?mx, target_model.VEC_OP_SIGN_MASK, false, 32, 32) != target_model.FORM_PACKED
        || target_model.vector_form(?mx, target_model.VEC_OP_SIGN_MASK, false, 64, 64) != target_model.FORM_SCALAR
        || target_model.vector_form(?ma, target_model.VEC_OP_SIGN_MASK, false, 8, 8) != target_model.FORM_SCALAR
        || target_model.vector_form(?ms, target_model.VEC_OP_SIGN_MASK, false, 8, 8) != target_model.FORM_SCALAR) { ret 18; }
    # a widening multiply packs where the ISA has the instruction, and every
    # other cell keeps the extend-then-multiply path
    var from: u32 = 8;
    for (from <= 32) {
        val xs: bool = target_model.vector_form(?mx, target_model.VEC_OP_MUL_WIDE_S, false, from * 2, from) == target_model.FORM_PACKED;
        val xu: bool = target_model.vector_form(?mx, target_model.VEC_OP_MUL_WIDE_U, false, from * 2, from) == target_model.FORM_PACKED;
        if (xs != (from == 16) || xu != (from != 8)) { ret 10; }
        if (target_model.vector_form(?ma, target_model.VEC_OP_MUL_WIDE_S, false, from * 2, from) != target_model.FORM_PACKED
            || target_model.vector_form(?ma, target_model.VEC_OP_MUL_WIDE_U, false, from * 2, from) != target_model.FORM_PACKED) { ret 11; }
        if (target_model.vector_form(?ms, target_model.VEC_OP_MUL_WIDE_S, false, from * 2, from) != target_model.FORM_SCALAR
            || target_model.vector_form(?mr, target_model.VEC_OP_MUL_WIDE_U, false, from * 2, from) != target_model.FORM_SCALAR) { ret 12; }
        from = from * 2;
    }
    var bits: u32 = 8;
    for (bits <= 64) {
        if (target_model.packed_width(?mx, target_model.VEC_OP_DIV, false, bits, bits) != 0
            || target_model.packed_width(?ma, target_model.VEC_OP_DIV, false, bits, bits) != 0
            || target_model.packed_width(?mr, target_model.VEC_OP_ADD, false, bits, bits) != 0) { ret 3; }
        if (target_model.packed_width(?ms, target_model.VEC_OP_DIV, false, bits, bits) == 0) { ret 4; }
        val xmul: bool = target_model.packed_width(?mx, target_model.VEC_OP_MUL, false, bits, bits) != 0;
        val amul: bool = target_model.packed_width(?ma, target_model.VEC_OP_MUL, false, bits, bits) != 0;
        if (xmul != (bits != 8) || amul != (bits != 64)) { ret 5; }
        bits = bits * 2;
    }
    if (target_model.packed_width(?mx, target_model.VEC_OP_DIV, true, 64, 64) != 128
        || target_model.packed_width(?ma, target_model.VEC_OP_DIV, true, 32, 32) != 128) { ret 6; }
    if (target_model.packed_width(?mx, 999, false, 32, 32) != 0
        || target_model.packed_width(?ms, target_model.VEC_OP_AND, true, 32, 32) != 0
        || target_model.packed_width(?mr, target_model.VEC_OP_SHL_U, false, 32, 32) != 0) { ret 7; }
    # a uniform shift count packs on x86_64 at every lane width but the
    # arithmetic 64-bit one, which has no instruction below avx512vl; a
    # per-lane count packs nowhere on the baseline. aarch64 and spir-v
    # pack every shift cell
    bits = 8;
    for (bits <= 64) {
        if (target_model.packed_width(?mx, target_model.VEC_OP_SHL_U, false, bits, bits) != 128
            || target_model.packed_width(?mx, target_model.VEC_OP_SHR_U_U, false, bits, bits) != 128) { ret 8; }
        if ((target_model.packed_width(?mx, target_model.VEC_OP_SHR_S_U, false, bits, bits) != 0) != (bits != 64)) { ret 9; }
        if (target_model.vector_form(?mx, target_model.VEC_OP_SHL_V, false, bits, bits) != target_model.FORM_SCALAR
            || target_model.vector_form(?mx, target_model.VEC_OP_SHR_S_V, false, bits, bits) != target_model.FORM_SCALAR) { ret 10; }
        var op: target_model.VecOp = target_model.VEC_OP_SHL_U;
        for (op <= target_model.VEC_OP_SHR_S_V) {
            if (target_model.vector_form(?ma, op, false, bits, bits) != target_model.FORM_PACKED
                || target_model.vector_form(?ms, op, false, bits, bits) != target_model.FORM_PACKED) { ret 17; }
            op = op + 1;
        }
        bits = bits * 2;
    }
    if (target_model.vector_form(?mx, target_model.VEC_OP_SHR_S_U, false, 64, 64) != target_model.FORM_SCALAR) { ret 11; }
    ret 0;
}

# a declared extension reaches the resolved model and its packed-form lookup:
# the baseline holds no sse41 bit and the request that names it does, while
# the 32- and 64-bit integer multiplies pack on both because the SSE2 pmuludq
# sequences carry them; the gate itself is exercised on a
# synthetic catalog in target_model.packed_width:gated_row_needs_every_selected_bit
test select__declared_extension_reaches_packed_forms {
    val reg: *TargetRegistry = t_registry();

    var base: TargetRequest                   = target_request("x86_64", "linux", "sysv64");
    val tb:   res[binding.Binding, fail.Fail] = resolve(reg, ?base);
    if (sel tb.err)                                                                                                        { ret 2; }
    if ((tb.ok.target.model.extensions & extension_x64.SSE41) != 0)                                                        { ret 3; }
    if (target_model.vector_form(?tb.ok.target.model, target_model.VEC_OP_MUL, false, 32, 32) != target_model.FORM_PACKED) { ret 4; }
    if (target_model.packed_width(?tb.ok.target.model, target_model.VEC_OP_MUL, false, 64, 64) != 128)                     { ret 5; }

    var names: [1]str        = [1]str{"sse41"};
    var req:   TargetRequest = target_request("x86_64", "linux", "sysv64");
    with_extensions(?req, ?names[0], 1);
    val ts: res[binding.Binding, fail.Fail] = resolve(reg, ?req);
    if (sel ts.err)                                                                                                        { ret 6; }
    if ((ts.ok.target.model.extensions & extension_x64.SSE41) == 0)                                                        { ret 7; }
    if (target_model.vector_form(?ts.ok.target.model, target_model.VEC_OP_MUL, false, 32, 32) != target_model.FORM_PACKED) { ret 8; }
    if (target_model.packed_width(?ts.ok.target.model, target_model.VEC_OP_MUL, false, 64, 64) != 128)                     { ret 9; }
    # ssse3 alone, which sse41 implies, does not bring the sse41 bit along
    var lower: [1]str        = [1]str{"ssse3"};
    var req3:  TargetRequest = target_request("x86_64", "linux", "sysv64");
    with_extensions(?req3, ?lower[0], 1);
    val t3: res[binding.Binding, fail.Fail] = resolve(reg, ?req3);
    if (sel t3.err)                                                 { ret 10; }
    if ((t3.ok.target.model.extensions & extension_x64.SSE41) != 0) { ret 11; }
    if ((t3.ok.target.model.extensions & extension_x64.SSSE3) == 0) { ret 12; }
    ret 0;
}

# only x86-64 declares reading a spilled operand in place, at every general
# width and no wider
test select__slot_read_widths {
    val reg: *TargetRegistry = t_registry();

    val tx: res[binding.Binding, fail.Fail] = select_of(reg, "x86_64", "linux", "sysv64", "");
    if (sel tx.err) { ret 2; }
    val mx: target_model.Machine = tx.ok.target.model;
    if (!target_model.reads_slot_operand(?mx, 1) || !target_model.reads_slot_operand(?mx, 2)) { ret 3; }
    if (!target_model.reads_slot_operand(?mx, 4) || !target_model.reads_slot_operand(?mx, 8)) { ret 4; }
    if (target_model.reads_slot_operand(?mx, 0) || target_model.reads_slot_operand(?mx, 16))  { ret 5; }
    if (target_model.reads_slot_operand(?mx, 3))                                              { ret 6; }

    val ta: res[binding.Binding, fail.Fail] = select_of(reg, "aarch64", "linux", "aapcs64", "");
    if (sel ta.err) { ret 7; }
    val ma: target_model.Machine = ta.ok.target.model;
    if (target_model.reads_slot_operand(?ma, 8)) { ret 8; }

    val tr: res[binding.Binding, fail.Fail] = select_of(reg, "riscv64", "linux", "lp64d", "");
    if (sel tr.err) { ret 9; }
    val mr: target_model.Machine = tr.ok.target.model;
    if (target_model.reads_slot_operand(?mr, 8)) { ret 10; }

    val ts: res[binding.Binding, fail.Fail] = select_of(reg, "spirv", "freestanding", "spirv", "spv");
    if (sel ts.err) { ret 11; }
    val ms: target_model.Machine = ts.ok.target.model;
    if (target_model.reads_slot_operand(?ms, 4)) { ret 12; }
    ret 0;
}

test select__alu_min_width {
    val reg: *TargetRegistry = t_registry();

    val tx: res[binding.Binding, fail.Fail] = select_of(reg, "x86_64", "linux", "sysv64", "");
    if (sel tx.err)                                           { ret 1; }
    if (target_model.alu_min_width(?tx.ok.target.model) != 4) { ret 1; }

    val ta: res[binding.Binding, fail.Fail] = select_of(reg, "aarch64", "linux", "aapcs64", "");
    if (sel ta.err)                                           { ret 1; }
    if (target_model.alu_min_width(?ta.ok.target.model) != 4) { ret 1; }

    val tr: res[binding.Binding, fail.Fail] = select_of(reg, "riscv64", "linux", "lp64d", "");
    if (sel tr.err)                                           { ret 1; }
    if (target_model.alu_min_width(?tr.ok.target.model) != 4) { ret 1; }

    val ts: res[binding.Binding, fail.Fail] = select_of(reg, "spirv", "freestanding", "spirv", "spv");
    if (sel ts.err)                                           { ret 1; }
    if (target_model.alu_min_width(?ts.ok.target.model) != 1) { ret 1; }
    ret 0;
}

test select__classify_vector_sse_class {
    val reg: *TargetRegistry                 = t_registry();
    val tx:  res[binding.Binding, fail.Fail] = select_of(reg, "x86_64", "linux", "sysv64", "");
    if (sel tx.err) { ret 1; }
    val t: binding.Binding = tx.ok;
    val a: abi.ParamSlot   = abi.arg_slot_for(t.abi, abi.arg_query(0, 16, 16, false, 0, false, true, 0, 0, 0, 0, abi.agg_none(), 16));
    if (a.class != abi.CLASS_FP) { ret 1; }
    if (a.size != 16)            { ret 1; }
    val r: abi.ParamSlot = abi.ret_slot_for(t.abi, abi.ret_query(16, 16, false, 0, false, true, 0, 0, abi.agg_none(), 16));
    if (r.class != abi.CLASS_FP) { ret 1; }
    if (r.size != 16)            { ret 1; }

    ret 0;
}

test select_of__resolves_debug_model {
    val reg: *TargetRegistry = t_registry();

    val te: res[binding.Binding, fail.Fail] = select_of(reg, "x86_64", "linux", "sysv64", "elf");
    if (sel te.err) { ret 1; }
    val et: binding.Binding = te.ok;
    if (et.debug == nil)                           { ret 1; }
    if (et.target.debug_id != target_of.DBG_DWARF) { ret 1; }
    if (et.debug.id != target_of.DBG_DWARF)        { ret 1; }

    val tc: res[binding.Binding, fail.Fail] = select_of(reg, "x86_64", "windows", "win64", "coff");
    if (sel tc.err) { ret 1; }
    val ct: binding.Binding = tc.ok;
    if (ct.debug == nil)                                  { ret 1; }
    if (ct.target.debug_id != target_of.DBG_DWARF)        { ret 1; }
    if (ct.of.debug_offset_kind != target_of.RK_SECREL32) { ret 1; }
    if (et.of.debug_offset_kind != target_of.RK_ABS32)    { ret 1; }

    val tr: res[binding.Binding, fail.Fail] = select_of(reg, "x86_64", "freestanding", "sysv64", "raw");
    if (sel tr.err)                                     { ret 1; }
    if (tr.ok.debug != nil)                             { ret 1; }
    if (tr.ok.target.debug_id != target_of.DBG_UNKNOWN) { ret 1; }
    ret 0;
}

test abi_vtable__granularity_matches_its_classifier {
    val reg: *TargetRegistry = t_registry();

    var i: u32 = 0;
    for (i < reg.abi.count) {
        val vt: *abi.AbiVTable = reg.abi.members[i];
        if (vt.passing == catalog_abi.PASSING_VALUES) {
            if (vt.arg_slot_granularity != 0 || vt.gp_arg_regs.count != 0
                || vt.callee_saved.count != 0 || vt.va_model != nil || vt.arg_passing == nil) { ret 2; }
            val logical: abi.ParamSlot = abi.arg_slot_for(vt, abi.arg_query(0, 16, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none(), 16));
            if (logical.class != abi.CLASS_VALUE || logical.piece_count != 0 || logical.size != 16 || !lang_mir.preg_is_nil(logical.reg)) { ret 3; }
            i = i + 1;
            cnt;
        }
        if (vt.arg_slot_granularity == 0) { ret 1; }
        if (vt.arg_passing == nil) {
            i = i + 1;
            cnt;
        }

        var agg: abi.AggLayout;
        agg.field_count = 0;
        val slot: abi.ParamSlot = abi.arg_slot_for(vt, abi.arg_query(0, 16, 8, false, 0, true, false, 0, 0, 0, 0, agg, 16));
        if (slot.piece_count == 2 && slot.pieces[1].kind == abi.PIECE_GP) {
            if (slot.pieces[1].src_off != vt.arg_slot_granularity::i64) { ret 1; }
        }
        i = i + 1;
    }
    ret 0;
}

test resolve__bakes_image_overrides_into_construction {
    val reg: *TargetRegistry = t_registry();

    var req: TargetRequest = target_request("x86_64", "freestanding", "sysv64");
    with_image(?req, 0x400000, 0x100000, 0x1000);
    val r: res[binding.Binding, fail.Fail] = resolve(reg, ?req);
    if (sel r.err) { ret 1; }
    val t: binding.Binding = r.ok;
    if (t.target.base != 0x400000)          { ret 1; }
    if (t.target.stack_reserve != 0x100000) { ret 1; }
    if (t.target.stack_commit != 0x1000)    { ret 1; }

    var req2: TargetRequest                   = target_request("x86_64", "freestanding", "sysv64");
    val r2:   res[binding.Binding, fail.Fail] = resolve(reg, ?req2);
    if (sel r2.err) { ret 1; }
    val t2: binding.Binding = r2.ok;
    if (t2.target.base != 0)          { ret 1; }
    if (t2.target.stack_reserve != 0) { ret 1; }
    if (t2.target.stack_commit != 0)  { ret 1; }
    ret 0;
}

test select_of__is_a_zero_image_request_to_resolve {
    val reg: *TargetRegistry = t_registry();

    val a: res[binding.Binding, fail.Fail] = select_of(reg, "x86_64", "linux", "sysv64", "elf");
    if (sel a.err) { ret 1; }
    val ta: binding.Binding = a.ok;

    var req: TargetRequest = target_request("x86_64", "linux", "sysv64");
    with_of(?req, "elf");
    val b: res[binding.Binding, fail.Fail] = resolve(reg, ?req);
    if (sel b.err) { ret 1; }
    val tb: binding.Binding = b.ok;

    if (ta.isa != tb.isa)                                        { ret 1; }
    if (ta.abi != tb.abi)                                        { ret 1; }
    if (ta.of != tb.of)                                          { ret 1; }
    if (ta.target.base != tb.target.base || ta.target.base != 0) { ret 1; }
    ret 0;
}

#[testing]
fun t_with_extensions(reg: *TargetRegistry, isa_name: str, abi_name: str, names: *str, count: u32) res[binding.Binding, fail.Fail] {
    var req: TargetRequest = target_request(isa_name, "linux", abi_name);
    with_extensions(?req, names, count);
    ret resolve(reg, ?req);
}

# the manifest's names select bits of the isa's own vocabulary, a level is the
# bundle of its rows, and an unknown name is refused with the known ones
test resolve__extensions_select_from_the_isa_vocabulary {
    val reg: *TargetRegistry = t_registry();

    val base: res[binding.Binding, fail.Fail] = select(reg, "x86_64", "linux", "sysv64");
    if (sel base.err)                         { ret 2; }
    if (base.ok.target.model.extensions != 0) { ret 2; }
    var names: [3]str                          = [3]str{"sha", "ssse3", "sha"};
    val sha:   res[binding.Binding, fail.Fail] = t_with_extensions(reg, "x86_64", "sysv64", ?names[0], 3);
    if (sel sha.err)                                                                 { ret 3; }
    if (sha.ok.target.model.extensions != (extension_x64.SHA | extension_x64.SSSE3)) { ret 4; }

    var arm:   [1]str                          = [1]str{"sha2"};
    val cross: res[binding.Binding, fail.Fail] = t_with_extensions(reg, "x86_64", "sysv64", ?arm[0], 1);
    if (sel cross.ok)                                                                                                                                                                                              { ret 5; }
    if (!str_contains(fail.describe(cross.err), "`sha2` is not an extension or level of isa 'x86_64'"))                                                                                                            { ret 6; }
    if (!str_contains(fail.describe(cross.err), "ssse3, sse41, sha, fsgsbase, popcnt, lzcnt, bmi1, sse42, cx16, avx, avx2, bmi2, fma, movbe, f16c, avx512f, avx512bw, avx512cd, avx512dq, avx512vl, aes, pclmul")) { ret 7; }
    if (!str_contains(fail.describe(cross.err), "its levels are: x86-64-v2, x86-64-v3, x86-64-v4"))                                                                                                                { ret 17; }
    val a64: res[binding.Binding, fail.Fail] = t_with_extensions(reg, "aarch64", "aapcs64", ?arm[0], 1);
    if (sel a64.err)                                            { ret 8; }
    if (a64.ok.target.model.extensions != extension_arm64.SHA2) { ret 8; }

    # a level is a bundle: sse41 brings ssse3
    var s41:   [1]str                          = [1]str{"sse41"};
    val sse41: res[binding.Binding, fail.Fail] = t_with_extensions(reg, "x86_64", "sysv64", ?s41[0], 1);
    if (sel sse41.err)                                                                   { ret 12; }
    if (sse41.ok.target.model.extensions != (extension_x64.SSE41 | extension_x64.SSSE3)) { ret 12; }

    ret 0;
}

# how the registered system `os_name` names its artifacts
#[testing]
fun t_system_naming(reg: *TargetRegistry, os_name: str) *target_of.SystemNaming {
    val found: opt[*lang_target_os.OsVTable] = target_registry.find[lang_target_os.OsVTable](?reg.os, os_name);
    if (sel found.some) { ret ?found.some.naming; }
    panic("target: the test registry has no such system\n");
    ret nil;
}

test artifact_naming__every_registered_object_format_has_a_total_object_and_executable_row {
    val reg: *TargetRegistry = t_registry();

    var bad: i32 = 0;
    var i:   u32 = 0;
    for (i < reg.of.count) {
        val vt: *target_of.OfVTable = reg.of.members[i];

        val obj_r: res[target_of.ArtifactName, fail.Fail] = target_of.artifact_naming(vt, t_system_naming(reg, "linux"), catalog_artifact.OBJECTS);
        if (sel obj_r.err) { bad = 1; }
        or (sel obj_r.ok) {
            val an: target_of.ArtifactName = obj_r.ok;
            if (str_len(an.suffix) > 0 && an.suffix[0] != '.') { bad = 1; }
        }

        val exe_linux_r: res[target_of.ArtifactName, fail.Fail] = target_of.artifact_naming(vt, t_system_naming(reg, "linux"), catalog_artifact.EXECUTABLE);
        if (sel exe_linux_r.err) { bad = 1; }
        val exe_win_r: res[target_of.ArtifactName, fail.Fail] = target_of.artifact_naming(vt, t_system_naming(reg, "windows"), catalog_artifact.EXECUTABLE);
        if (sel exe_win_r.err) { bad = 1; }
        or (sel exe_win_r.ok) {
            val an: target_of.ArtifactName = exe_win_r.ok;
            if (!vt.object_is_artifact && !vt.produces_image && !str_equals(an.suffix, ".exe")) { bad = 1; }
        }
        i = i + 1;
    }
    ret bad;
}

test artifact_naming__elf_coff_macho_conventional_names {
    val reg: *TargetRegistry = t_registry();

    var bad: i32 = 0;

    val elf_o: opt[*target_of.OfVTable] = target_registry.find[target_of.OfVTable](?reg.of, "elf");
    if (sel elf_o.none) { ret 1; }
    val elf_vt:       *target_of.OfVTable                    = elf_o.some;
    val elf_static_r: res[target_of.ArtifactName, fail.Fail] = target_of.artifact_naming(elf_vt, t_system_naming(reg, "linux"), catalog_artifact.STATIC);
    if (sel elf_static_r.err) { ret 1; }
    val elf_static: target_of.ArtifactName = elf_static_r.ok;
    if (!str_equals(elf_static.prefix, "lib") || !str_equals(elf_static.suffix, ".a")) { bad = 1; }
    val elf_shared_r: res[target_of.ArtifactName, fail.Fail] = target_of.artifact_naming(elf_vt, t_system_naming(reg, "linux"), catalog_artifact.SHARED);
    if (sel elf_shared_r.err) { ret 1; }
    val elf_shared: target_of.ArtifactName = elf_shared_r.ok;
    if (!str_equals(elf_shared.prefix, "lib") || !str_equals(elf_shared.suffix, ".so")) { bad = 1; }

    val macho_o: opt[*target_of.OfVTable] = target_registry.find[target_of.OfVTable](?reg.of, "macho");
    if (sel macho_o.none) { ret 1; }
    val macho_vt:       *target_of.OfVTable                    = macho_o.some;
    val macho_shared_r: res[target_of.ArtifactName, fail.Fail] = target_of.artifact_naming(macho_vt, t_system_naming(reg, "darwin"), catalog_artifact.SHARED);
    if (sel macho_shared_r.err) { ret 1; }
    val macho_shared: target_of.ArtifactName = macho_shared_r.ok;
    if (!str_equals(macho_shared.prefix, "lib") || !str_equals(macho_shared.suffix, ".dylib")) { bad = 1; }

    val coff_o: opt[*target_of.OfVTable] = target_registry.find[target_of.OfVTable](?reg.of, "coff");
    if (sel coff_o.none) { ret 1; }
    val coff_vt:           *target_of.OfVTable                    = coff_o.some;
    val coff_static_win_r: res[target_of.ArtifactName, fail.Fail] = target_of.artifact_naming(coff_vt, t_system_naming(reg, "windows"), catalog_artifact.STATIC);
    if (sel coff_static_win_r.err) { ret 1; }
    val coff_static_win: target_of.ArtifactName = coff_static_win_r.ok;
    if (!str_empty(coff_static_win.prefix) || !str_equals(coff_static_win.suffix, ".lib")) { bad = 1; }
    val coff_shared_r: res[target_of.ArtifactName, fail.Fail] = target_of.artifact_naming(coff_vt, t_system_naming(reg, "windows"), catalog_artifact.SHARED);
    if (sel coff_shared_r.err) { ret 1; }
    val coff_shared: target_of.ArtifactName = coff_shared_r.ok;
    if (!str_empty(coff_shared.prefix) || !str_equals(coff_shared.suffix, ".dll")) { bad = 1; }
    val coff_exe_r: res[target_of.ArtifactName, fail.Fail] = target_of.artifact_naming(coff_vt, t_system_naming(reg, "windows"), catalog_artifact.EXECUTABLE);
    if (sel coff_exe_r.err) { ret 1; }
    val coff_exe: target_of.ArtifactName = coff_exe_r.ok;
    if (!str_equals(coff_exe.suffix, ".exe")) { bad = 1; }

    ret bad;
}

test artifact_naming__flat_image_and_finished_module_formats_refuse_archive_and_shared_forms {
    val reg: *TargetRegistry = t_registry();

    var bad: i32 = 0;

    val raw_o: opt[*target_of.OfVTable] = target_registry.find[target_of.OfVTable](?reg.of, "raw");
    if (sel raw_o.none) { ret 1; }
    val raw_vt: *target_of.OfVTable                    = raw_o.some;
    var naming: res[target_of.ArtifactName, fail.Fail] = target_of.artifact_naming(raw_vt, t_system_naming(reg, "freestanding"), catalog_artifact.STATIC);
    if (sel naming.ok) { bad = 1; }
    naming = target_of.artifact_naming(raw_vt, t_system_naming(reg, "freestanding"), catalog_artifact.SHARED);
    if (sel naming.ok) { bad = 1; }
    val raw_exe_r: res[target_of.ArtifactName, fail.Fail] = target_of.artifact_naming(raw_vt, t_system_naming(reg, "freestanding"), catalog_artifact.EXECUTABLE);
    if (sel raw_exe_r.err) { ret 1; }
    val raw_exe: target_of.ArtifactName = raw_exe_r.ok;
    if (!str_empty(raw_exe.prefix) || !str_empty(raw_exe.suffix)) { bad = 1; }

    val spv_o: opt[*target_of.OfVTable] = target_registry.find[target_of.OfVTable](?reg.of, "spv");
    if (sel spv_o.none) { ret 1; }
    val spv_vt: *target_of.OfVTable = spv_o.some;
    naming = target_of.artifact_naming(spv_vt, t_system_naming(reg, "freestanding"), catalog_artifact.STATIC);
    if (sel naming.ok) { bad = 1; }
    naming = target_of.artifact_naming(spv_vt, t_system_naming(reg, "freestanding"), catalog_artifact.SHARED);
    if (sel naming.ok) { bad = 1; }
    val spv_exe_r: res[target_of.ArtifactName, fail.Fail] = target_of.artifact_naming(spv_vt, t_system_naming(reg, "freestanding"), catalog_artifact.EXECUTABLE);
    if (sel spv_exe_r.err) { ret 1; }
    val spv_exe: target_of.ArtifactName = spv_exe_r.ok;
    if (!str_equals(spv_exe.suffix, ".spv")) { bad = 1; }
    val spv_obj_r: res[target_of.ArtifactName, fail.Fail] = target_of.artifact_naming(spv_vt, t_system_naming(reg, "freestanding"), catalog_artifact.OBJECTS);
    if (sel spv_obj_r.err) { ret 1; }
    val spv_obj: target_of.ArtifactName = spv_obj_r.ok;
    if (!str_equals(spv_obj.suffix, ".spv")) { bad = 1; }

    ret bad;
}

test artifact_naming__compatibility_key_matches_only_the_same_object_format {
    val reg: *TargetRegistry = t_registry();

    val elf_o:  opt[*target_of.OfVTable] = target_registry.find[target_of.OfVTable](?reg.of, "elf");
    val coff_o: opt[*target_of.OfVTable] = target_registry.find[target_of.OfVTable](?reg.of, "coff");
    if (sel elf_o.none)  { ret 1; }
    if (sel coff_o.none) { ret 1; }
    val elf_vt:  *target_of.OfVTable = elf_o.some;
    val coff_vt: *target_of.OfVTable = coff_o.some;

    val a_r: res[target_of.ArtifactName, fail.Fail] = target_of.artifact_naming(elf_vt, t_system_naming(reg, "linux"), catalog_artifact.OBJECTS);
    if (sel a_r.err) { ret 1; }
    val a:   target_of.ArtifactName                 = a_r.ok;
    val b_r: res[target_of.ArtifactName, fail.Fail] = target_of.artifact_naming(elf_vt, t_system_naming(reg, "linux"), catalog_artifact.EXECUTABLE);
    if (sel b_r.err) { ret 1; }
    val b:   target_of.ArtifactName                 = b_r.ok;
    val c_r: res[target_of.ArtifactName, fail.Fail] = target_of.artifact_naming(coff_vt, t_system_naming(reg, "windows"), catalog_artifact.OBJECTS);
    if (sel c_r.err) { ret 1; }
    val c: target_of.ArtifactName = c_r.ok;

    if (!str_equals(a.key, b.key)) { ret 1; }
    if (str_equals(a.key, c.key))  { ret 1; }
    ret 0;
}

test every_isa_declares_its_index_and_vector_axes {
    val reg: *TargetRegistry = t_registry();
    var ii:  u32             = 0;
    for (ii < reg.isa.count) {
        val isa_vt_r: opt[*isa.IsaVTable] = target_registry.at[isa.IsaVTable](?reg.isa, ii);
        if (sel isa_vt_r.none) { ret 1; }
        val isa_vt: *isa.IsaVTable        = isa_vt_r.some;
        val m:      *target_model.Machine = isa_vt.model;
        if (m.index_width == 0)                          { ret 2; }
        if (m.has_v128 && m.vector_op_bytes == 0)        { ret 3; }
        if (m.auto_vectorize && !m.vectors_in_registers) { ret 4; }
        ii = ii + 1;
    }
    ret 0;
}

test resolve__env_is_member_owned_and_unknown_or_undefined_values_are_refused {
    val reg: *TargetRegistry = t_registry();

    var gpu: TargetRequest = target_request("spirv", "freestanding", "spirv");
    with_env(?gpu, "vulkan1.2", "");
    val ok: res[binding.Binding, fail.Fail] = resolve(reg, ?gpu);
    if (sel ok.err) { ret 2; }
    val t: binding.Binding = ok.ok;
    if (t.target.env_id != 2 || !str_equals(t.target.env_name, "vulkan1.2") || t.target.env_profile != 2) { ret 3; }
    val view: isa.BackendTarget = binding.backend_target(?t);
    if (view.identity.env_id != 2 || !str_equals(view.identity.env_name, "vulkan1.2")) { ret 4; }

    var none:  TargetRequest                   = target_request("spirv", "freestanding", "spirv");
    val plain: res[binding.Binding, fail.Fail] = resolve(reg, ?none);
    if (sel plain.err)                                  { ret 5; }
    if (plain.ok.target.env_id != isa_environment.NONE) { ret 5; }

    var bogus: TargetRequest = target_request("spirv", "freestanding", "spirv");
    with_env(?bogus, "vulkan9.9", "[target.gpu] env = \"vulkan9.9\"");
    val rejected: res[binding.Binding, fail.Fail] = resolve(reg, ?bogus);
    if (sel rejected.ok) { ret 6; }
    val msg: str = fail.describe(rejected.err);
    if (!str_contains(msg, "[target.gpu]") || !str_contains(msg, "vulkan9.9") || !str_contains(msg, "vulkan1.0")
        || !str_contains(msg, "vulkan1.3") || !str_contains(msg, "does not define")) { ret 7; }

    var cpu: TargetRequest = target_request("x86_64", "linux", "sysv64");
    with_env(?cpu, "vulkan1.2", "[target.host] env = \"vulkan1.2\"");
    val undefined: res[binding.Binding, fail.Fail] = resolve(reg, ?cpu);
    if (sel undefined.ok) { ret 8; }
    val umsg: str = fail.describe(undefined.err);
    if (!str_contains(umsg, "[target.host]") || !str_contains(umsg, "defines no environments")) { ret 9; }
    ret 0;
}

#[testing]
fun t_held[T](found: opt[*T], want: *T) bool {
    if (sel found.some) { ret found.some == want; }
    ret false;
}

# registration keeps each member's own static descriptor: nothing is copied,
# so the registry hands back the very descriptor the member declares, and a
# binding resolved from it reads that descriptor too
test register_all__holds_each_member_by_its_static_descriptor {
    var reg: TargetRegistry = registry_init();
    if (t_register_all_refused(?reg, ?target_testing.DEBUG)) { ret 1; }
    val x: opt[*isa.IsaVTable] = target_registry.find[isa.IsaVTable](?reg.isa, "x86_64");
    if (!t_held[isa.IsaVTable](x, ?x64_register.VTABLE)) { ret 2; }
    val a64: opt[*isa.IsaVTable] = target_registry.find[isa.IsaVTable](?reg.isa, "aarch64");
    if (!t_held[isa.IsaVTable](a64, ?arm64_register.VTABLE)) { ret 3; }
    val os: opt[*lang_target_os.OsVTable] = target_registry.find[lang_target_os.OsVTable](?reg.os, "linux");
    if (!t_held[lang_target_os.OsVTable](os, ?target_os_linux.VTABLE)) { ret 4; }
    val ab: opt[*abi.AbiVTable] = target_registry.find[abi.AbiVTable](?reg.abi, "aapcs64");
    if (!t_held[abi.AbiVTable](ab, ?aapcs64.VTABLE)) { ret 5; }
    val of: opt[*target_of.OfVTable] = target_registry.find[target_of.OfVTable](?reg.of, "macho");
    if (!t_held[target_of.OfVTable](of, ?macho.VTABLE)) { ret 6; }
    val dbg: opt[*target_of.DebugVTable] = target_registry.find[target_of.DebugVTable](?reg.debug, "dwarf");
    if (!t_held[target_of.DebugVTable](dbg, ?target_testing.DEBUG)) { ret 7; }
    val selected: res[binding.Binding, fail.Fail] = select(?reg, "x86_64", "linux", "sysv64");
    if (sel selected.err)                                                                                                        { ret 8; }
    if (selected.ok.isa != ?x64_register.VTABLE || selected.ok.arch != ?x64_register.MACHINE || selected.ok.abi != ?sysv.VTABLE) { ret 9; }
    ret 0;
}

test tuple_capability__a_hosted_os_constrains_the_abi_to_its_declared_set {
    val reg: *TargetRegistry = t_registry();

    val foreign: res[binding.Binding, fail.Fail] = select(reg, "x86_64", "linux", "win64");
    if (sel foreign.ok)                                                                                                                                   { ret 2; }
    if (!str_equals(fail.describe(foreign.err), "operating system 'linux' accepts calling convention 'sysv64' on instruction set 'x86_64', not 'win64'")) { ret 3; }
    val darwin_foreign: res[binding.Binding, fail.Fail] = select(reg, "x86_64", "darwin", "win64");
    if (sel darwin_foreign.ok) { ret 4; }
    val windows_foreign: res[binding.Binding, fail.Fail] = select(reg, "x86_64", "windows", "sysv64");
    if (sel windows_foreign.ok) { ret 5; }
    val native: res[binding.Binding, fail.Fail] = select(reg, "x86_64", "linux", "sysv64");
    if (sel native.err) { ret 6; }

    # linux declares the whole riscv64 psABI float family: the kernel abi is integer-only
    val soft: res[binding.Binding, fail.Fail] = select(reg, "riscv64", "linux", "lp64");
    if (sel soft.err) { ret 7; }
    val single: res[binding.Binding, fail.Fail] = select(reg, "riscv64", "linux", "lp64f");
    if (sel single.err) { ret 7; }

    # freestanding declares itself unconstrained, so every convention the isa covers stays legal
    val bare_win: res[binding.Binding, fail.Fail] = select(reg, "x86_64", "freestanding", "win64");
    if (sel bare_win.err) { ret 8; }
    val bare_soft: res[binding.Binding, fail.Fail] = select(reg, "riscv64", "freestanding", "lp64");
    if (sel bare_soft.err) { ret 9; }

    # the code is its own row, judged after every lower-level capability
    val opt_os:  opt[*lang_target_os.OsVTable] = target_registry.find[lang_target_os.OsVTable](?reg.os, "linux");
    val opt_isa: opt[*isa.IsaVTable]           = target_registry.find[isa.IsaVTable](?reg.isa, "x86_64");
    val opt_abi: opt[*abi.AbiVTable]           = target_registry.find[abi.AbiVTable](?reg.abi, "win64");
    val opt_of:  opt[*target_of.OfVTable]      = target_registry.find[target_of.OfVTable](?reg.of, "elf");
    if (sel opt_os.none)                                                                        { ret 10; }
    if (sel opt_isa.none)                                                                       { ret 10; }
    if (sel opt_abi.none)                                                                       { ret 10; }
    if (sel opt_of.none)                                                                        { ret 10; }
    if (tuple.capability(opt_os.some, opt_isa.some, opt_abi.some, opt_of.some) != tuple.OS_ABI) { ret 11; }

    # a multi-member set is named in full when refusing
    val opt_rv: opt[*isa.IsaVTable] = target_registry.find[isa.IsaVTable](?reg.isa, "riscv64");
    if (sel opt_rv.none) { ret 12; }
    var odd: abi.AbiVTable = target_testing.carriers_convention();
    odd.name    = "lp64x";
    odd.arch_id = catalog_arch.RISCV64;
    if (tuple.capability(opt_os.some, opt_rv.some, ?odd, opt_of.some) != tuple.OS_ABI) { ret 13; }
    if (!str_equals(fail.describe(tuple.refusal(?reg.alloc, tuple.OS_ABI, opt_os.some, opt_rv.some, ?odd, opt_of.some)),
        "operating system 'linux' accepts calling conventions 'lp64d', 'lp64', 'lp64f' on instruction set 'riscv64', not 'lp64x'")) { ret 14; }
    ret 0;
}

test tuple_capability__refuses_abi_needing_absent_float_extension {
    val reg: *TargetRegistry = t_registry();

    val opt_isa: opt[*isa.IsaVTable] = target_registry.find[isa.IsaVTable](?reg.isa, "riscv64");
    if (!sel opt_isa.some) { ret 1; }
    val isa_vt: *isa.IsaVTable = opt_isa.some;
    if (isa_vt.model.flen_bits != 64) { ret 1; }

    var quad: abi.AbiVTable = abi.AbiVTable{
        passing:               catalog_abi.PASSING_CARRIERS,
        name:                  "lp64q",
        arch_id:               catalog_arch.RISCV64,
        stack_align:           16,
        indirect_result_reg:   isa_inst.REG_NONE,
        fp_callee_saved_bytes: 8,
        float_arg_bits:        128,
        arg_slot_granularity:  8,
    };
    if (tuple.capability(nil, isa_vt, ?quad, nil) != tuple.ABI_NEEDS_FLOAT) { ret 1; }

    val opt_abi: opt[*abi.AbiVTable] = target_registry.find[abi.AbiVTable](?reg.abi, "lp64d");
    if (!sel opt_abi.some) { ret 1; }
    val d_vt: *abi.AbiVTable = opt_abi.some;
    if (d_vt.float_arg_bits != 64) { ret 1; }
    val ok: res[binding.Binding, fail.Fail] = select(reg, "riscv64", "linux", "lp64d");
    if (sel ok.err) { ret 1; }
    val soft: res[binding.Binding, fail.Fail] = select(reg, "riscv64", "linux", "lp64");
    if (sel soft.err) { ret 1; }
    ret 0;
}

test tuple_capability__refuses_a_standard_abi_a_narrower_isa_model_cannot_give {
    val reg: *TargetRegistry = t_registry();

    val opt_isa: opt[*isa.IsaVTable] = target_registry.find[isa.IsaVTable](?reg.isa, "riscv64");
    if (!sel opt_isa.some) { ret 1; }
    val real_isa: *isa.IsaVTable = opt_isa.some;

    val opt_abi: opt[*abi.AbiVTable] = target_registry.find[abi.AbiVTable](?reg.abi, "lp64d");
    if (!sel opt_abi.some) { ret 1; }
    val d_vt: *abi.AbiVTable = opt_abi.some;
    if (d_vt.float_arg_bits != 64) { ret 1; }

    var narrow_model: target_model.Machine = @real_isa.model;
    var narrow:       isa.IsaVTable        = @real_isa;
    narrow_model.flen_bits = 0;
    narrow.model           = ?narrow_model;
    if (tuple.capability(nil, ?narrow, d_vt, nil) != tuple.ABI_NEEDS_FLOAT) { ret 1; }

    var mid_model: target_model.Machine = @real_isa.model;
    var mid:       isa.IsaVTable        = @real_isa;
    mid_model.flen_bits = 32;
    mid.model           = ?mid_model;
    if (tuple.capability(nil, ?mid, d_vt, nil) != tuple.ABI_NEEDS_FLOAT) { ret 1; }
    ret 0;
}

test tuple_capability__refuses_an_isa_with_no_registered_code_generator {
    val reg: *TargetRegistry = t_registry();

    val opt_isa: opt[*isa.IsaVTable] = target_registry.find[isa.IsaVTable](?reg.isa, "riscv64");
    if (!sel opt_isa.some) { ret 1; }
    val real_isa: *isa.IsaVTable = opt_isa.some;
    if (!isa.has_codegen(real_isa)) { ret 1; }

    var stub: isa.IsaVTable = @real_isa;
    stub.machine = nil;
    stub.emitter = nil;
    if (isa.has_codegen(?stub)) { ret 1; }

    if (tuple.capability(nil, ?stub, nil, nil) != tuple.NO_CODEGEN) { ret 1; }
    ret 0;
}

test tuple_capability__refuses_an_isa_the_operating_system_does_not_run {
    val reg: *TargetRegistry = t_registry();

    val opt_isa: opt[*isa.IsaVTable] = target_registry.find[isa.IsaVTable](?reg.isa, "riscv64");
    if (!sel opt_isa.some) { ret 1; }
    val riscv_vt: *isa.IsaVTable = opt_isa.some;

    val opt_abi: opt[*abi.AbiVTable] = target_registry.find[abi.AbiVTable](?reg.abi, "lp64d");
    if (!sel opt_abi.some) { ret 1; }
    val d_vt: *abi.AbiVTable = opt_abi.some;

    val opt_os: opt[*lang_target_os.OsVTable] = target_registry.find[lang_target_os.OsVTable](?reg.os, "windows");
    if (!sel opt_os.some) { ret 1; }
    val win_vt: *lang_target_os.OsVTable = opt_os.some;
    if (lang_target_os.supports_isa(win_vt, catalog_arch.RISCV64)) { ret 1; }

    if (tuple.capability(win_vt, riscv_vt, d_vt, nil) != tuple.OS_NO_ISA) { ret 1; }
    ret 0;
}

test select_of__every_capable_tuple_is_selectable_and_the_census_is_stable {
    val reg: *TargetRegistry = t_registry();

    var capable:    u32 = 0;
    var selectable: u32 = 0;
    var oi:         u32 = 0;
    for (oi < reg.os.count) {
        val os_vt_r: opt[*lang_target_os.OsVTable] = target_registry.at[lang_target_os.OsVTable](?reg.os, oi);
        if (sel os_vt_r.none) { ret 1; }
        val os_vt: *lang_target_os.OsVTable = os_vt_r.some;
        var ii:    u32                      = 0;
        for (ii < reg.isa.count) {
            val isa_vt_r: opt[*isa.IsaVTable] = target_registry.at[isa.IsaVTable](?reg.isa, ii);
            if (sel isa_vt_r.none) { ret 1; }
            val isa_vt: *isa.IsaVTable = isa_vt_r.some;
            var ai:     u32            = 0;
            for (ai < reg.abi.count) {
                val abi_vt_r: opt[*abi.AbiVTable] = target_registry.at[abi.AbiVTable](?reg.abi, ai);
                if (sel abi_vt_r.none) { ret 1; }
                val abi_vt: *abi.AbiVTable = abi_vt_r.some;
                var fi:     u32            = 0;
                for (fi < reg.of.count) {
                    val of_vt_r: opt[*target_of.OfVTable] = target_registry.at[target_of.OfVTable](?reg.of, fi);
                    if (sel of_vt_r.none) { ret 1; }
                    val of_vt: *target_of.OfVTable = of_vt_r.some;
                    if (tuple.capability(os_vt, isa_vt, abi_vt, of_vt) == tuple.OK) {
                        capable = capable + 1;
                        var concrete_isa: str = isa_vt.name;
                        if (isa_vt.id == catalog_arch.RISCV32) { concrete_isa = "rv32imafdc"; }
                        val r: res[binding.Binding, fail.Fail] = select_of(reg, concrete_isa, os_vt.name, abi_vt.name, of_vt.name);
                        if (sel r.ok) { selectable = selectable + 1; }
                    }
                    fi = fi + 1;
                }
                ai = ai + 1;
            }
            ii = ii + 1;
        }
        oi = oi + 1;
    }
    if (capable == 0)          { ret 1; }
    if (selectable != capable) { ret 2; }
    if (capable != tuple.COMPLETE_CENSUS) {
        print.printf("complete-target census: {} capable tuples, expected {}\n", capable, tuple.COMPLETE_CENSUS);
        ret 3;
    }
    ret 0;
}
