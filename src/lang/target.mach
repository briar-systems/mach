test "mach.lang.target.select:vector_lane_ceiling" {
    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_all(?reg, target_testing.debug_descriptor))) { ret 1; }

    val tx: R.Result[resolved.Target, str] = select_of(?reg, "x86_64", "linux", "sysv64", "");
    if (R.is_err[resolved.Target, str](tx)) { ret 1; }
    val mx: isa.MachineModel = R.unwrap_ok[resolved.Target, str](tx).model;
    if (mx.max_vector_lanes != isa.VECTOR_LANES_UNBOUNDED)          { ret 1; }
    if (isa.packed_lane_cap(?mx, 8)  != 16)                         { ret 1; }
    if (isa.packed_lane_cap(?mx, 32) != 4)                          { ret 1; }
    if (isa.packed_width(?mx, isa.VEC_OP_ADD, false, 8) != 128)     { ret 1; }

    val ta: R.Result[resolved.Target, str] = select_of(?reg, "aarch64", "linux", "aapcs64", "");
    if (R.is_err[resolved.Target, str](ta)) { ret 1; }
    val ma: isa.MachineModel = R.unwrap_ok[resolved.Target, str](ta).model;
    if (ma.max_vector_lanes != isa.VECTOR_LANES_UNBOUNDED)          { ret 1; }
    if (isa.packed_width(?ma, isa.VEC_OP_ADD, false, 8) != 128)     { ret 1; }

    val tr: R.Result[resolved.Target, str] = select_of(?reg, "riscv64", "linux", "lp64d", "");
    if (R.is_err[resolved.Target, str](tr)) { ret 1; }
    if (R.unwrap_ok[resolved.Target, str](tr).model.max_vector_lanes != isa.VECTOR_LANES_UNBOUNDED) { ret 1; }

    val ts: R.Result[resolved.Target, str] = select_of(?reg, "spirv", "freestanding", "spirv", "spv");
    if (R.is_err[resolved.Target, str](ts)) { ret 1; }
    val ms: isa.MachineModel = R.unwrap_ok[resolved.Target, str](ts).model;
    if (ms.max_vector_lanes != 4)                                   { ret 1; }
    if (isa.packed_lane_cap(?ms, 8)  != 4)                          { ret 1; }
    if (isa.packed_width(?ms, isa.VEC_OP_ADD, false, 8)  != 32)     { ret 1; }
    if (isa.packed_width(?ms, isa.VEC_OP_ADD, false, 32) != 128)    { ret 1; }
    ret 0;
}

