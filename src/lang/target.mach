    val r_win: res[binding.Binding, fail.Fail] = select(reg, "x86_64", "windows", "win64");
    if (sel r_win.err)                                { ret 1; }
    if (!str_equals(r_win.ok.os.c_symbol_prefix, "")) { ret 1; }

    val r_fre: res[binding.Binding, fail.Fail] = select(reg, "x86_64", "freestanding", "sysv64");
    if (sel r_fre.err)                                { ret 1; }
    if (!str_equals(r_fre.ok.os.c_symbol_prefix, "")) { ret 1; }
    ret 0;
}

