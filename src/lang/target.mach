test select_of__freestanding_raw_emits_flat_image {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var reg:     TargetRegistry = registry_init();
    val res_reg: err[fail.Fail] = register_all(?reg, ?target_testing.DEBUG);
    if (sel res_reg.err) { ret 1; }

    val res_target: res[binding.Binding, fail.Fail] = select_of(?reg, "x86_64", "freestanding", "sysv64", "raw");
    if (sel res_target.err) { ret 1; }
    val t: binding.Binding = res_target.ok;
    if (t.of == nil)                 { ret 1; }
    if (t.of.id != target_of.OF_RAW) { ret 1; }
    if (t.of.emit_exec == nil)       { ret 1; }

    var code_bytes: [4]u8;
    code_bytes[0] = 0xEB;
    code_bytes[1] = 0xFE;
    code_bytes[2] = 0x90;
    code_bytes[3] = 0x90;
    var segs: [1]target_of.LoadSegment;
    segs[0].vaddr  = t.os.base_addr;
    segs[0].filesz = 4;
    segs[0].memsz  = 4;
    segs[0].flags  = target_of.SEG_FLAG_READ | target_of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?code_bytes[0];

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "sel_raw");
    if (sel tf_r.err) { ret 1; }
    var tf:    fs.TempFile = tf_r.ok;
    val tpath: str         = fs.temp_path(?tf);

    val em: err[fail.Fail] = t.of.emit_exec(?alloc, ?itn, ?t.object, ?segs[0], 1, t.os.page_size,
        t.os.base_addr, t.os.base_addr, nil::*target_of.ExecFunction, 0,
        nil::*target_of.Section, 0, nil::*target_of.Section, 0,
        nil::*target_of.SymtabEntry, 0,
        tpath, "selraw"::*u8, target_of.image_options_default(catalog_subsystem.CONSOLE));
    if (sel em.err) {
        fs.temp_close_and_remove(?tf);
        ret 1;
    }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (sel rr.err) { ret 1; }
    var b: Vector[u8] = rr.ok;

    if (b.len != 4) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }
    if (b.data[0] == 0x7F) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }
    if (b.data[0] != 0xEB) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }
    if (b.data[1] != 0xFE) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }

    collections_vector.dnit[u8](?b);
    ret 0;
}

