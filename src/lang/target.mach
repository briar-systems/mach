test "mach.lang.target.select_of:freestanding_raw_emits_flat_image" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var reg: TargetRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val res_reg: err[fail.Fail] = register_all(?reg, target_testing.debug_descriptor);
    if (sel res_reg.err) { ret 1; }

    val res_target: res[resolved.Target, fail.Fail] = select_of(?reg, "x86_64", "freestanding", "sysv64", "raw");
    if (sel res_target.err) { ret 1; }
    val t: resolved.Target = res_target.ok;
    if (t.of == nil)           { ret 1; }
    if (t.of.id != of.OF_RAW)  { ret 1; }
    if (t.of.emit_exec == nil) { ret 1; }

    var code_bytes: [4]u8;
    code_bytes[0] = 0xEB;
    code_bytes[1] = 0xFE;
    code_bytes[2] = 0x90;
    code_bytes[3] = 0x90;
    var segs: [1]of.LoadSegment;
    segs[0].vaddr  = t.os.base_addr;
    segs[0].filesz = 4;
    segs[0].memsz  = 4;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?code_bytes[0];

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "sel_raw");
    if (sel tf_r.err) { ret 1; }
    var tf:    fs.TempFile = tf_r.ok;
    val tpath: str         = fs.temp_path(?tf);

    var operation: publication.Plan;
    val opened:    res[*publication.Destination, fail.Fail] = t_publication_open(?operation, ?alloc, tpath);
    if (sel opened.err) {
        val failed: err[fail.Fail] = t_publication_close(?operation, err[fail.Fail].err{opened.err});
        fs.temp_close_and_remove(?tf);
        if (sel failed.err) { ret 1; }
        ret 1;
    }
    val em: err[fail.Fail] =
        t_publication_close(?operation, t.of.emit_exec(?alloc, ?itn, ?t.object, ?segs[0], 1, t.os.page_size,
        t.os.base_addr, t.os.base_addr, nil::*of.ExecFunction, 0,
        nil::*of.Section, 0, nil::*of.Section, 0,
        nil::*of.SymtabEntry, 0,
        opened.ok, "selraw"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE)));
    if (sel em.err) {
        fs.temp_close_and_remove(?tf);
        ret 1;
    }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (sel rr.err) { ret 1; }
    var b: Vector[u8] = rr.ok;

    if (b.len != 4) {
        vector.dnit[u8](?b);
        ret 1;
    }
    if (b.data[0] == 0x7F) {
        vector.dnit[u8](?b);
        ret 1;
    }
    if (b.data[0] != 0xEB) {
        vector.dnit[u8](?b);
        ret 1;
    }
    if (b.data[1] != 0xFE) {
        vector.dnit[u8](?b);
        ret 1;
    }

    vector.dnit[u8](?b);
    ret 0;
}

