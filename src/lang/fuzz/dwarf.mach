use mach.lang.fail;
use std.print;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;

use codegen_dwarf: mach.lang.be.codegen.dwarf;
use mach.lang.be.obj;
use mach.lang.fuzz.cursor;
use mach.lang.fuzz.verdict;
use mach.lang.intern;
use mach.lang.layout;
use me_ir:     mach.lang.me.ir;
use ir_type:   mach.lang.me.ir.type;
use lang_mir:  mach.lang.mir;
use mir_debug: mach.lang.mir.debug;
use mach.lang.session;
use lang_source: mach.lang.source;
use target_of:   mach.lang.target.of;
use mach.lang.type;

#[testing]
val TEXT_BYTES: u32   = 64;
#[testing]
val STREAM_CAP: usize = 8;

#[testing]
fun debug_reg(reg: i32) i32 {
    ret reg;
}

#[testing]
pub fun answer(alloc: *A.Allocator, data: *u8, len: usize) verdict.Verdict {
    if (len == 0) { ret verdict.rejected("fuzz.dwarf: an empty input names no debug input"); }

    var c: cursor.Cursor = cursor.init(data, len);

    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret verdict.rejected(fail.describe(sr.err)); }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val nr: res[intern.StrId, A.Error] = intern.add(?s.interner, "fuzz");
    if (sel nr.err) {
        ret verdict.rejected("fuzz.dwarf: cannot intern");
    }
    val name: intern.StrId = nr.ok;

    val mr: res[me_ir.Module, fail.Fail] = me_ir.init(alloc, name);
    if (sel mr.err) {
        ret verdict.rejected("fuzz.dwarf: cannot make a module");
    }
    var irmod: me_ir.Module = mr.ok;
    fin { me_ir.dnit(?irmod); }
    val r_70: res[u32, fail.Fail] = me_ir.function_add(?irmod, name, ir_type.IRT_NIL, 0);
    if (sel r_70.err) {
        ret verdict.rejected("fuzz.dwarf: cannot add a function");
    }

    var mirmod: lang_mir.MirModule;
    mirmod.alloc        = alloc;
    mirmod.interner     = ?s.interner;
    mirmod.srcmap       = ?s.sources;
    mirmod.functions    = nil;
    mirmod.function_len = 0;
    mirmod.function_cap = 0;

    val ir_img: res[target_of.ObjectImage, fail.Fail] = obj.image_init(alloc, ?s.interner, name);
    if (sel ir_img.err) {
        ret verdict.rejected("fuzz.dwarf: cannot make an image");
    }
    var image: target_of.ObjectImage = ir_img.ok;
    fin { obj.dnit(?image); }

    val br: res[*u8, A.Error] = A.allocate[u8](alloc, TEXT_BYTES::usize);
    if (sel br.err) {
        ret verdict.rejected("fuzz.dwarf: cannot allocate a text section");
    }
    val text_bytes: *u8 = br.ok;
    var bi:         u32 = 0;
    for (bi < TEXT_BYTES) {
        text_bytes[bi] = cursor.byte(?c);
        bi             = bi + 1;
    }

    var text: target_of.Section;
    text.name  = name;
    text.kind  = target_of.SK_TEXT;
    text.bytes = text_bytes;
    text.len   = TEXT_BYTES;
    text.align = 1;
    text.flags = 0;
    val section_install_r: res[u32, fail.Fail] = target_of.section_install(?image, ?text);
    if (sel section_install_r.err) {
        ret verdict.rejected("fuzz.dwarf: cannot install a text section");
    }

    var sym: target_of.Symbol;
    sym.name     = name;
    sym.section  = target_of.section_id(0);
    sym.offset   = cursor.word(?c) % (TEXT_BYTES + 1);
    sym.size     = cursor.word(?c) % (TEXT_BYTES + 1);
    sym.flags    = target_of.SYM_OBJ_FLAG_FUNCTION;
    sym.fallback = target_of.SYMBOL_NONE;
    sym.align    = 1;
    val symbol_add_r: res[u32, fail.Fail] = target_of.symbol_add(?image, sym);
    if (sel symbol_add_r.err) {
        ret verdict.rejected("fuzz.dwarf: cannot add a symbol");
    }

    var rows:       [STREAM_CAP]mir_debug.LineRow;
    var varlocs:    [STREAM_CAP]mir_debug.VarLoc;
    var inline_pcs: [STREAM_CAP]mir_debug.InlinePc;

    var i: usize = 0;
    for (i < STREAM_CAP) {
        rows[i].text_offset = cursor.word(?c);
        rows[i].sec         = cursor.word(?c);
        rows[i].loc         = lang_source.location_nil();

        inline_pcs[i].text_offset = cursor.word(?c);
        inline_pcs[i].sec         = cursor.word(?c);
        inline_pcs[i].inline_site = cursor.word(?c);

        varlocs[i].text_offset = cursor.word(?c);
        varlocs[i].sec         = cursor.word(?c);
        varlocs[i].iid         = cursor.word(?c);
        varlocs[i].kind        = cursor.byte(?c);
        varlocs[i].reg         = cursor.word(?c)::i32;
        varlocs[i].off         = cursor.dword(?c)::i64;
        varlocs[i].off_storage = (cursor.byte(?c) & 1) == 1;
        varlocs[i].end_offset  = cursor.word(?c);
        varlocs[i].sub_lhs     = cursor.byte(?c);
        varlocs[i].sub_rhs     = cursor.byte(?c);
        varlocs[i].reg2        = cursor.word(?c)::i32;
        varlocs[i].off2        = cursor.dword(?c)::i64;
        varlocs[i].cmp_rel     = cursor.byte(?c);
        varlocs[i].cmp_signed  = (cursor.byte(?c) & 1) == 1;
        varlocs[i].cmp_width   = cursor.byte(?c);
        i                      = i + 1;
    }

    var req: target_of.DebugProduceRequest;
    req.program.alloc         = alloc;
    req.program.interner      = ?s.interner;
    req.program.types         = ?s.types;
    req.program.sources       = ?s.sources;
    req.program.type_aligns   = ?s.type_aligns;
    req.program.type_packed   = ?s.type_packed;
    req.program.field_epoch   = type.field_epoch(?s.types);
    req.program.ir_module     = ?irmod;
    req.program.mir_module    = ?mirmod;
    req.program.layout        = layout.machine(8, 128, 128);
    req.program.pointer_width = 8;
    req.program.dwarf_reg     = debug_reg;
    req.program.frame_ptr_reg = cursor.word(?c)::i32;
    req.program.stack_ptr_reg = cursor.word(?c)::i32;

    req.image           = ?image;
    req.rows            = ?rows[0];
    req.row_count       = (cursor.word(?c)::usize % (STREAM_CAP + 1))::u32;
    req.varlocs         = ?varlocs[0];
    req.varloc_count    = (cursor.word(?c)::usize % (STREAM_CAP + 1))::u32;
    req.inline_pcs      = ?inline_pcs[0];
    req.inline_pc_count = (cursor.word(?c)::usize % (STREAM_CAP + 1))::u32;
    req.producer        = name;
    req.comp_dir        = name;
    req.text_section    = cursor.word(?c);

    val before_sections: u32 = image.section_count;
    val before_symbols:  u32 = image.symbol_count;
    val before_relocs:   u32 = image.reloc_count;

    val pr: err[fail.Fail] = codegen_dwarf.produce_debug(?req);

    var broke: str = "";
    if (sel pr.err) {
        if (image.section_count != before_sections
            || image.symbol_count != before_symbols
            || image.reloc_count != before_relocs) {
            broke = "a debug production that failed still changed the object image";
        }
    }
    or (image.section_count < before_sections) {
        broke = "a debug production that succeeded removed a section from the object image";
    }

    if (str_len(broke) != 0) { ret verdict.violated(broke); }
    if (sel pr.err)          { ret verdict.rejected(fail.describe(pr.err)); }
    ret verdict.accepted();
}

#[testing]
rec Input {
    bytes: [32]u8;
}

#[testing]
fun t_answer_attempt(input: *Input, t: *T.Testing) i32 {
    T.arm(t);
    answer(T.allocator_of(t), ?input.bytes[0], 32);
    T.clear_failure(t);
    ret 0;
}

# an answer releases what it built on every exit, whichever allocation is refused
test answer__releases_its_fixture_on_every_exit {
    var input: Input;
    var i:     usize = 0;
    for (i < 32) {
        input.bytes[i] = (i * 37 + 11)::u8;
        i              = i + 1;
    }
    val out: T.Outcome = T.walk[Input](?input, t_answer_attempt);
    if (out.code != 0) {
        print.eprintlnf("fail-at-N: code {} at ordinal {} of {} requests", out.code, out.ordinal, out.attempts);
    }
    ret out.code;
}
