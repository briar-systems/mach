use std.types.bool.bool;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use R: std.types.result;

use verdict: mach.lang.fuzz.verdict;
use mach.lang.be.codegen.debug_input;
use mach.lang.be.codegen.dwarf;
use mach.lang.be.codegen.mir;
use mach.lang.be.obj;
use mach.lang.intern;
use mach.lang.layout;
use mach.lang.me.ir;
use irtype: mach.lang.me.ir.type;
use mach.lang.session;
use mach.lang.source;
use mach.lang.target.of;
use semtype: mach.lang.type;

val TEXT_BYTES:  u32   = 64;
val STREAM_CAP:  usize = 8;

rec Cursor {
    data: *u8;
    len:  usize;
    at:   usize;
}

fun byte(c: *Cursor) u8 {
    if (c.len == 0) { ret 0; }
    val b: u8 = c.data[c.at % c.len];
    c.at = c.at + 1;
    ret b;
}

fun word(c: *Cursor) u32 {
    ret byte(c)::u32 | (byte(c)::u32 << 8) | (byte(c)::u32 << 16) | (byte(c)::u32 << 24);
}

fun dword(c: *Cursor) u64 {
    ret word(c)::u64 | (word(c)::u64 << 32);
}

fun debug_reg(reg: i32) i32 { ret reg; }

pub fun answer(alloc: *A.Allocator, data: *u8, len: usize) verdict.Verdict {
    if (len == 0) { ret verdict.rejected("fuzz.dwarf: an empty input names no debug input"); }

    var c: Cursor;
    c.data = data;
    c.len  = len;
    c.at   = 0;

    val sr: R.Result[session.Session, str] = session.init(alloc);
    if (R.is_err[session.Session, str](sr)) {
        ret verdict.rejected(R.unwrap_err[session.Session, str](sr));
    }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val nr: R.Result[intern.StrId, str] = intern.intern(?s.interner, "fuzz");
    if (R.is_err[intern.StrId, str](nr)) { session.dnit(?s); ret verdict.rejected("fuzz.dwarf: cannot intern"); }
    val name: intern.StrId = R.unwrap_ok[intern.StrId, str](nr);

    val mr: R.Result[ir.Module, str] = ir.init(alloc, name);
    if (R.is_err[ir.Module, str](mr)) { session.dnit(?s); ret verdict.rejected("fuzz.dwarf: cannot make a module"); }
    var irmod: ir.Module = R.unwrap_ok[ir.Module, str](mr);
    if (R.is_err[u32, str](ir.function_add(?irmod, name, irtype.IRT_NIL, 0))) {
        ir.dnit(?irmod); session.dnit(?s);
        ret verdict.rejected("fuzz.dwarf: cannot add a function");
    }

    var mirmod: mir.MirModule;
    mirmod.alloc        = alloc;
    mirmod.interner     = ?s.interner;
    mirmod.srcmap       = ?s.sources;
    mirmod.functions    = nil;
    mirmod.function_len = 0;
    mirmod.function_cap = 0;

    val ir_img: R.Result[of.ObjectImage, str] = obj.init(alloc, ?s.interner, name);
    if (R.is_err[of.ObjectImage, str](ir_img)) {
        ir.dnit(?irmod); session.dnit(?s);
        ret verdict.rejected("fuzz.dwarf: cannot make an image");
    }
    var image: of.ObjectImage = R.unwrap_ok[of.ObjectImage, str](ir_img);

    val br: R.Result[*u8, str] = A.allocate[u8](alloc, TEXT_BYTES::usize);
    if (R.is_err[*u8, str](br)) {
        obj.dnit(?image); ir.dnit(?irmod); session.dnit(?s);
        ret verdict.rejected("fuzz.dwarf: cannot allocate a text section");
    }
    val text_bytes: *u8 = R.unwrap_ok[*u8, str](br);
    var bi: u32 = 0;
    for (bi < TEXT_BYTES) { text_bytes[bi] = byte(?c); bi = bi + 1; }

    var text: of.Section;
    text.name  = name;
    text.kind  = of.SK_TEXT;
    text.bytes = text_bytes;
    text.len   = TEXT_BYTES;
    text.align = 1;
    text.flags = 0;
    if (R.is_err[u32, str](obj.install_section(?image, ?text))) {
        obj.dnit(?image); ir.dnit(?irmod); session.dnit(?s);
        ret verdict.rejected("fuzz.dwarf: cannot install a text section");
    }

    var sym: of.Symbol;
    sym.name     = name;
    sym.section  = 0;
    sym.offset   = word(?c) % (TEXT_BYTES + 1);
    sym.size     = word(?c) % (TEXT_BYTES + 1);
    sym.flags    = of.SYM_OBJ_FLAG_FUNCTION;
    sym.fallback = of.SYMBOL_NONE;
    sym.align    = 1;
    if (R.is_err[u32, str](obj.add_symbol(?image, sym))) {
        obj.dnit(?image); ir.dnit(?irmod); session.dnit(?s);
        ret verdict.rejected("fuzz.dwarf: cannot add a symbol");
    }

    var rows:       [STREAM_CAP]debug_input.LineRow;
    var varlocs:    [STREAM_CAP]debug_input.VarLoc;
    var inline_pcs: [STREAM_CAP]debug_input.InlinePc;

    var i: usize = 0;
    for (i < STREAM_CAP) {
        rows[i].text_offset = word(?c);
        rows[i].sec         = word(?c);
        rows[i].loc         = source.loc_nil();

        inline_pcs[i].text_offset = word(?c);
        inline_pcs[i].sec         = word(?c);
        inline_pcs[i].inline_site = word(?c);

        varlocs[i].text_offset = word(?c);
        varlocs[i].sec         = word(?c);
        varlocs[i].iid         = word(?c);
        varlocs[i].kind        = byte(?c);
        varlocs[i].reg         = word(?c)::i32;
        varlocs[i].off         = dword(?c)::i64;
        varlocs[i].off_storage = (byte(?c) & 1) == 1;
        varlocs[i].end_offset  = word(?c);
        varlocs[i].sub_lhs     = byte(?c);
        varlocs[i].sub_rhs     = byte(?c);
        varlocs[i].reg2        = word(?c)::i32;
        varlocs[i].off2        = dword(?c)::i64;
        varlocs[i].cmp_rel     = byte(?c);
        varlocs[i].cmp_signed  = (byte(?c) & 1) == 1;
        varlocs[i].cmp_width   = byte(?c);
        i = i + 1;
    }

    var req: of.DebugProduceRequest;
    req.program.alloc         = alloc;
    req.program.interner      = ?s.interner;
    req.program.types         = ?s.types;
    req.program.sources       = ?s.sources;
    req.program.type_aligns   = ?s.type_aligns;
    req.program.type_packed   = ?s.type_packed;
    req.program.field_epoch   = semtype.field_epoch(?s.types);
    req.program.ir_module     = ?irmod;
    req.program.mir_module    = ?mirmod;
    req.program.layout        = layout.machine(8, 128);
    req.program.pointer_width = 8;
    req.program.dwarf_reg     = debug_reg;
    req.program.frame_ptr_reg = word(?c)::i32;
    req.program.stack_ptr_reg = word(?c)::i32;

    req.image           = ?image;
    req.rows            = ?rows[0];
    req.row_count       = (word(?c)::usize % (STREAM_CAP + 1))::u32;
    req.varlocs         = ?varlocs[0];
    req.varloc_count    = (word(?c)::usize % (STREAM_CAP + 1))::u32;
    req.inline_pcs      = ?inline_pcs[0];
    req.inline_pc_count = (word(?c)::usize % (STREAM_CAP + 1))::u32;
    req.producer        = name;
    req.comp_dir        = name;
    req.text_section    = word(?c);

    val before_sections: u32 = image.section_count;
    val before_symbols:  u32 = image.symbol_count;
    val before_relocs:   u32 = image.reloc_count;

    val pr: R.Result[R.Void, str] = dwarf.produce(?req);

    var broke: str = "";
    if (R.is_err[R.Void, str](pr)) {
        if (image.section_count != before_sections
            || image.symbol_count != before_symbols
            || image.reloc_count != before_relocs) {
            broke = "a debug production that failed still changed the object image";
        }
    }
    or (image.section_count < before_sections) {
        broke = "a debug production that succeeded removed a section from the object image";
    }

    obj.dnit(?image);
    ir.dnit(?irmod);
    session.dnit(?s);

    if (str_len(broke) != 0) { ret verdict.violated(broke); }
    if (R.is_err[R.Void, str](pr)) { ret verdict.rejected(R.unwrap_err[R.Void, str](pr)); }
    ret verdict.accepted();
}
