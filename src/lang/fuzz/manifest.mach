use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use std.data.toml;

use verdict: mach.lang.fuzz.verdict;
use mach.lang.intern;
use man: mach.lang.manifest;

pub fun answer(alloc: *A.Allocator, data: *u8, len: usize) verdict.Verdict {
    val source: str = data::usize::str;

    val sr: R.Result[R.Void, str] = man.validate_source_bytes(data, len);
    if (R.is_err[R.Void, str](sr)) { ret verdict.rejected(R.unwrap_err[R.Void, str](sr)); }

    val tr: R.Result[toml.Table, str] = toml.parse(alloc, source);
    if (R.is_err[toml.Table, str](tr)) { ret verdict.rejected(R.unwrap_err[toml.Table, str](tr)); }
    var t: toml.Table = R.unwrap_ok[toml.Table, str](tr);

    var itn: intern.Interner = intern.init(alloc);
    val root: R.Result[man.Manifest, str] = man.parse(alloc, ?itn, ?t, true);
    if (R.is_err[man.Manifest, str](root)) {
        val dep_only: R.Result[man.Manifest, str] = man.parse(alloc, ?itn, ?t, false);
        if (!R.is_err[man.Manifest, str](dep_only)) {
            var d: man.Manifest = R.unwrap_ok[man.Manifest, str](dep_only);
            man.dnit(?d, alloc);
        }
        toml.dnit(alloc, ?t);
        ret verdict.rejected(R.unwrap_err[man.Manifest, str](root));
    }
    var m: man.Manifest = R.unwrap_ok[man.Manifest, str](root);
    toml.dnit(alloc, ?t);

    var broke: str = dangling_name(?itn, ?m);
    if (str_len(broke) == 0) { broke = resolve_every_cell(alloc, ?itn, ?m); }
    man.dnit(?m, alloc);
    if (str_len(broke) != 0) { ret verdict.violated(broke); }

    ret dep_table_round_trip(alloc, source);
}

fun resolves(itn: *intern.Interner, id: intern.StrId) bool {
    if (id == intern.STR_NIL) { ret true; }
    ret O.is_some[str](intern.lookup(itn, id));
}

fun list_resolves(itn: *intern.Interner, ids: *intern.StrId, n: u32) bool {
    if (n == 0) { ret true; }
    if (ids == nil) { ret false; }
    var i: u32 = 0;
    for (i < n) {
        if (!resolves(itn, ids[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun dangling_name(itn: *intern.Interner, m: *man.Manifest) str {
    if (!resolves(itn, m.id) || !resolves(itn, m.version) || !resolves(itn, m.src)
        || !resolves(itn, m.out_tmpl) || !resolves(itn, m.default_target)) {
        ret "an accepted manifest names a project string that is not interned";
    }
    var i: u32 = 0;
    for (i < m.target_count) {
        val t: *man.TargetDef = ?m.targets[i];
        if (!resolves(itn, t.name) || !resolves(itn, t.isa) || !resolves(itn, t.os)
            || !resolves(itn, t.abi) || !resolves(itn, t.of) || !resolves(itn, t.platform)) {
            ret "an accepted manifest names a target string that is not interned";
        }
        i = i + 1;
    }
    i = 0;
    for (i < m.artifact_count) {
        val a: *man.ArtifactDef = ?m.artifacts[i];
        if (!resolves(itn, a.name) || !resolves(itn, a.kind) || !resolves(itn, a.entry)
            || !resolves(itn, a.out) || !resolves(itn, a.icon) || !resolves(itn, a.app_manifest)
            || !list_resolves(itn, a.targets, a.target_count)
            || !list_resolves(itn, a.link, a.link_count)
            || !list_resolves(itn, a.need, a.need_count)) {
            ret "an accepted manifest names an artifact string that is not interned";
        }
        i = i + 1;
    }
    i = 0;
    for (i < m.profile_count) {
        if (!resolves(itn, m.profiles[i].name)) {
            ret "an accepted manifest names a profile string that is not interned";
        }
        i = i + 1;
    }
    i = 0;
    for (i < m.dep_count) {
        val d: *man.DepDef = ?m.deps[i];
        if (!resolves(itn, d.name) || !resolves(itn, d.git) || !resolves(itn, d.path)
            || !resolves(itn, d.ref)) {
            ret "an accepted manifest names a dependency string that is not interned";
        }
        i = i + 1;
    }
    i = 0;
    for (i < m.link_count) {
        val l: *man.LinkDef = ?m.links[i];
        if (!resolves(itn, l.name) || !resolves(itn, l.library) || !resolves(itn, l.lib_name)
            || !resolves(itn, l.path)
            || !list_resolves(itn, l.symbols, l.symbol_count)
            || !list_resolves(itn, l.os, l.os_count)
            || !list_resolves(itn, l.isa, l.isa_count)
            || !list_resolves(itn, l.abi, l.abi_count)) {
            ret "an accepted manifest names a link string that is not interned";
        }
        i = i + 1;
    }
    i = 0;
    for (i < m.step_count) {
        val s: *man.StepDef = ?m.steps[i];
        if (!resolves(itn, s.name)
            || !list_resolves(itn, s.argv, s.argv_count)
            || !list_resolves(itn, s.env_keys, s.env_count)
            || !list_resolves(itn, s.env_values, s.env_count)
            || !list_resolves(itn, s.in, s.in_count)
            || !list_resolves(itn, s.out, s.out_count)
            || !list_resolves(itn, s.need, s.need_count)) {
            ret "an accepted manifest names a step string that is not interned";
        }
        i = i + 1;
    }
    ret "";
}

fun resolve_every_cell(alloc: *A.Allocator, itn: *intern.Interner, m: *man.Manifest) str {
    var ti: u32 = 0;
    for (ti < m.target_count) {
        var pi: u32 = 0;
        for (pi < m.profile_count) {
            val pn: O.Option[str] = intern.lookup(itn, m.profiles[pi].name);
            pi = pi + 1;
            if (!O.is_some[str](pn)) { cnt; }
            var v: man.TmplVars = man.tmpl_vars_of(itn, ?m.targets[ti], O.unwrap[str](pn));

            val cc: R.Result[R.Void, str] = man.check_collisions(alloc, itn, m, ?v);
            if (R.is_err[R.Void, str](cc)) { cnt; }

            var ai: u32 = 0;
            for (ai < m.artifact_count) {
                val an: O.Option[str] = intern.lookup(itn, m.artifacts[ai].name);
                ai = ai + 1;
                if (!O.is_some[str](an)) { cnt; }
                var sel: man.Selection;
                sel.target       = "";
                sel.profile      = "";
                sel.artifact     = O.unwrap[str](an);
                sel.want_lib     = false;
                sel.has_artifact = true;

                val sr: R.Result[R.Void, str] = man.select_sole_target_artifact(alloc, itn, m, ?sel);
                if (R.is_err[R.Void, str](sr)) { cnt; }
                val br: R.Result[man.BuildUnit, str] = man.resolve_build_unit(alloc, itn, m, sel);
                if (R.is_err[man.BuildUnit, str](br)) { cnt; }
                val bu: man.BuildUnit = R.unwrap_ok[man.BuildUnit, str](br);
                if (!resolves(itn, bu.entry) || !resolves(itn, bu.bin_path)
                    || !resolves(itn, bu.obj_root) || !resolves(itn, bu.ir_root)
                    || !resolves(itn, bu.asm_root) || !resolves(itn, bu.test_root)) {
                    ret "a resolved build unit names a path string that is not interned";
                }
            }
        }
        ti = ti + 1;
    }
    var qi: u32 = 0;
    for (qi < m.profile_count) {
        val pn: O.Option[str] = intern.lookup(itn, m.profiles[qi].name);
        qi = qi + 1;
        if (!O.is_some[str](pn)) { cnt; }
        val rp: R.Result[man.ResolvedProfile, str] = man.resolve_profile(alloc, itn, m, O.unwrap[str](pn));
        if (R.is_err[man.ResolvedProfile, str](rp)) { cnt; }
    }
    ret "";
}

fun dep_table_round_trip(alloc: *A.Allocator, source: str) verdict.Verdict {
    var spec: man.DepTableSpec;
    spec.name   = "fuzz-dep";
    spec.source = man.DEP_SOURCE_PATH;
    spec.value  = "dep/fuzz-dep";
    spec.ref    = "";

    val ar: R.Result[str, str] = man.manifest_add_dep_table(alloc, source, ?spec);
    if (R.is_err[str, str](ar)) { ret verdict.rejected(R.unwrap_err[str, str](ar)); }
    val added: str = R.unwrap_ok[str, str](ar);

    val at: R.Result[toml.Table, str] = toml.parse(alloc, added);
    if (R.is_err[toml.Table, str](at)) {
        ret verdict.violated("adding a dependency table produced a manifest that is no longer TOML");
    }
    var addedt: toml.Table = R.unwrap_ok[toml.Table, str](at);
    toml.dnit(alloc, ?addedt);

    val rr: R.Result[str, str] = man.manifest_remove_dep_table(alloc, added, "fuzz-dep");
    if (R.is_err[str, str](rr)) {
        ret verdict.violated("a dependency table that was just added could not be removed");
    }
    val removed: str = R.unwrap_ok[str, str](rr);

    val rt: R.Result[toml.Table, str] = toml.parse(alloc, removed);
    if (R.is_err[toml.Table, str](rt)) {
        ret verdict.violated("removing a dependency table produced a manifest that is no longer TOML");
    }
    var removedt: toml.Table = R.unwrap_ok[toml.Table, str](rt);
    toml.dnit(alloc, ?removedt);
    ret verdict.accepted();
}
