use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use verdict: mach.lang.fuzz.verdict;
use mach.lang.be.codegen.dwarf;
use mach.lang.target;
use mach.lang.target.of;
use mach.lang.target.isa;

fun provide_debug_descriptor() R.Result[of.DebugVTable, str] {
    ret R.ok[of.DebugVTable, str](dwarf.debug_descriptor());
}

val DIALECT_COUNT: usize = 6;

fun dialects(out: *str) usize {
    out[0] = "x86_64";
    out[1] = "aarch64";
    out[2] = "riscv64";
    out[3] = "riscv32";
    out[4] = "mos6502";
    out[5] = "spirv";
    ret DIALECT_COUNT;
}

pub fun answer(alloc: *A.Allocator, data: *u8, len: usize) verdict.Verdict {
    val body: str = data::usize::str;

    var reg: target.TargetRegistry = target.registry_init();
    val rr: R.Result[R.Void, str] = target.register_all(?reg, provide_debug_descriptor);
    if (R.is_err[R.Void, str](rr)) {
        target.registry_dnit(?reg);
        ret verdict.rejected(R.unwrap_err[R.Void, str](rr));
    }

    var names: [DIALECT_COUNT]str;
    val n: usize = dialects(?names[0]);

    var scanned: usize = 0;
    var i: usize = 0;
    for (i < n) {
        val found: O.Option[*isa.IsaVTable] = isa.lookup(?reg.isa, names[i]);
        i = i + 1;
        if (!O.is_some[*isa.IsaVTable](found)) { cnt; }
        val vt: *isa.IsaVTable = O.unwrap[*isa.IsaVTable](found);
        if (vt.machine == nil || !vt.machine.has_assembly) { cnt; }

        if (vt.machine.assembly.clobbers != nil) {
            var gp: u32 = 0;
            var fp: u32 = 0;
            vt.machine.assembly.clobbers(body, ?gp, ?fp);
        }
        if (vt.machine.assembly.returns != nil) { vt.machine.assembly.returns(body); }
        if (vt.machine.assembly.ct_scan != nil) {
            var secrets: [2]str;
            secrets[0] = "a";
            secrets[1] = "secret_local";
            val plain: R.Result[R.Void, str] = vt.machine.assembly.ct_scan(body, ?secrets[0], 2, false, false, alloc);
            if (!R.is_err[R.Void, str](plain)) {
                val trusting: R.Result[R.Void, str] = vt.machine.assembly.ct_scan(body, ?secrets[0], 2, true, true, alloc);
                if (R.is_err[R.Void, str](trusting)) {
                    target.registry_dnit(?reg);
                    ret verdict.violated("a body that passed the constant-time scan was refused once the scan was allowed to trust more");
                }
            }
            val none: R.Result[R.Void, str] = vt.machine.assembly.ct_scan(body, nil, 0, false, false, alloc);
            if (R.is_err[R.Void, str](none) && !R.is_err[R.Void, str](plain)) {
                target.registry_dnit(?reg);
                ret verdict.violated("a body that passed the constant-time scan with secrets named was refused with none named");
            }
        }
        scanned = scanned + 1;
    }
    target.registry_dnit(?reg);

    if (scanned == 0) {
        ret verdict.rejected("fuzz.asm: no registered instruction set declares an assembly seam");
    }
    ret verdict.accepted();
}
