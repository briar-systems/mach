use mach.lang.fail;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.ct;
use mach.lang.fuzz.verdict;
use lang_target: mach.lang.target;
use mach.lang.target.isa;
use target_of:       mach.lang.target.of;
use target_registry: mach.lang.target.registry;
use mach.lang.toolchain;

#[testing]
val DIALECT_COUNT: usize = 5;

#[testing]
fun dialects(out: *str) usize {
    out[0] = "x86_64";
    out[1] = "aarch64";
    out[2] = "riscv64";
    out[3] = "riscv32";
    out[4] = "spirv";
    ret DIALECT_COUNT;
}

#[testing]
pub fun answer(alloc: *A.Allocator, data: *u8, len: usize) verdict.Verdict {
    val body: str = data::usize::str;

    val rr: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel rr.err) {
        ret verdict.rejected(fail.describe(rr.err));
    }
    val reg: *lang_target.TargetRegistry = rr.ok;

    var names: [DIALECT_COUNT]str;
    val n:     usize = dialects(?names[0]);

    var scanned: usize = 0;
    var i:       usize = 0;
    for (i < n) {
        val found: opt[*isa.IsaVTable] = target_registry.find[isa.IsaVTable](?reg.isa, names[i]);
        i = i + 1;
        if (sel found.none) { cnt; }
        val vt: *isa.IsaVTable = found.some;
        if (vt.machine == nil || !vt.machine.has_assembly) { cnt; }

        if (vt.machine.assembly.clobbers != nil) {
            var gp: u32 = 0;
            var fp: u32 = 0;
            vt.machine.assembly.clobbers(body, ?gp, ?fp);
        }
        if (vt.machine.assembly.returns != nil) { vt.machine.assembly.returns(body); }
        if (vt.machine.assembly.ct_scan != nil) {
            var secrets: [3]ct.AsmSecret;
            secrets[0] = ct.asm_secret_value("a");
            secrets[1] = ct.asm_secret_value("secret_local");
            secrets[2] = ct.asm_secret_pointee("p");
            val plain: err[ct.AsmRefusal] = vt.machine.assembly.ct_scan(body, ?secrets[0], 3, ct.mul_mask_none(), false, alloc);
            if (sel plain.ok) {
                val trusting: err[ct.AsmRefusal] = vt.machine.assembly.ct_scan(body, ?secrets[0], 3, ct.CtMulMask{scalar: 0xFFFFFFFFFFFFFFFF, vector: 0xFFFFFFFFFFFFFFFF}, true, alloc);
                if (sel trusting.err) {
                    ret verdict.violated("a body that passed the constant-time scan was refused once the scan was allowed to trust more");
                }
            }
            val none: err[ct.AsmRefusal] = vt.machine.assembly.ct_scan(body, nil, 0, ct.mul_mask_none(), false, alloc);
            if (sel none.err && sel plain.ok) {
                ret verdict.violated("a body that passed the constant-time scan with secrets named was refused with none named");
            }
        }
        scanned = scanned + 1;
    }

    if (scanned == 0) {
        ret verdict.rejected("fuzz.asm: no registered instruction set declares an assembly seam");
    }
    ret verdict.accepted();
}
