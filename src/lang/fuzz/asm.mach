use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use verdict: mach.lang.fuzz.verdict;
use mach.lang.be.codegen.dwarf;
use mach.lang.target;
use mach.lang.target.of;
use mach.lang.target.isa;

fun provide_debug_descriptor() res[of.DebugVTable, fail.Fail] {
    ret res[of.DebugVTable, fail.Fail].ok{dwarf.debug_descriptor()};
}

val DIALECT_COUNT: usize = 6;

fun dialects(out: *str) usize {
    out[0] = "x86_64";
    out[1] = "aarch64";
    out[2] = "riscv64";
    out[3] = "riscv32";
    out[4] = "mos6502";
    out[5] = "spirv";
    ret DIALECT_COUNT;
}

pub fun answer(alloc: *A.Allocator, data: *u8, len: usize) verdict.Verdict {
    val body: str = data::usize::str;

    var reg: target.TargetRegistry = target.registry_init();
    val rr: err[fail.Fail] = target.register_all(?reg, provide_debug_descriptor);
    if (sel rr.err) {
        target.registry_dnit(?reg);
        ret verdict.rejected(fail.describe(rr.err));
    }

    var names: [DIALECT_COUNT]str;
    val n: usize = dialects(?names[0]);

    var scanned: usize = 0;
    var i: usize = 0;
    for (i < n) {
        val found: opt[*isa.IsaVTable] = isa.lookup(?reg.isa, names[i]);
        i = i + 1;
        if (sel found.none) { cnt; }
        val vt: *isa.IsaVTable = found.some;
        if (vt.machine == nil || !vt.machine.has_assembly) { cnt; }

        if (vt.machine.assembly.clobbers != nil) {
            var gp: u32 = 0;
            var fp: u32 = 0;
            vt.machine.assembly.clobbers(body, ?gp, ?fp);
        }
        if (vt.machine.assembly.returns != nil) { vt.machine.assembly.returns(body); }
        if (vt.machine.assembly.ct_scan != nil) {
            var secrets: [2]str;
            secrets[0] = "a";
            secrets[1] = "secret_local";
            val plain: err[fail.Fail] = vt.machine.assembly.ct_scan(body, ?secrets[0], 2, false, false, alloc);
            if (sel plain.ok) {
                val trusting: err[fail.Fail] = vt.machine.assembly.ct_scan(body, ?secrets[0], 2, true, true, alloc);
                if (sel trusting.err) {
                    target.registry_dnit(?reg);
                    ret verdict.violated("a body that passed the constant-time scan was refused once the scan was allowed to trust more");
                }
            }
            val none: err[fail.Fail] = vt.machine.assembly.ct_scan(body, nil, 0, false, false, alloc);
            if (sel none.err && sel plain.ok) {
                target.registry_dnit(?reg);
                ret verdict.violated("a body that passed the constant-time scan with secrets named was refused with none named");
            }
        }
        scanned = scanned + 1;
    }
    target.registry_dnit(?reg);

    if (scanned == 0) {
        ret verdict.rejected("fuzz.asm: no registered instruction set declares an assembly seam");
    }
    ret verdict.accepted();
}
