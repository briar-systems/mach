use mach.lang.fail;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.be.codegen.ctvalidate;
use mach.lang.ct;
use mach.lang.fuzz.cursor;
use mach.lang.fuzz.verdict;
use mach.lang.intern;
use lang_mir:    mach.lang.mir;
use lang_target: mach.lang.target;
use mach.lang.target.binding;

#[testing]
val FUNCTION_COUNT: u32 = 2;
#[testing]
val BLOCK_COUNT:    u32 = 4;
#[testing]
val INSTR_COUNT:    u32 = 6;
#[testing]
val OPERAND_COUNT:  u32 = 3;
#[testing]
val VREG_COUNT:     u32 = 5;

#[testing]
val PREG_LIMIT: u32 = 256;

# a trusted multiply: the low half at every scalar width
#[testing]
var fuzz_mul_rows: [4]ct.CtMulForm = [4]ct.CtMulForm{
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0}
};

#[testing]
pub fun answer(alloc: *A.Allocator, data: *u8, len: usize) verdict.Verdict {
    if (len == 0) { ret verdict.rejected("fuzz.mir: an empty input names no corruption"); }

    var c: cursor.Cursor = cursor.init(data, len);

    val tr: res[binding.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    if (sel tr.err) { ret verdict.rejected(fail.describe(tr.err)); }
    var tgt: binding.Binding = tr.ok;
    tgt.target.model.ct_mul_forms    = nil;
    tgt.target.model.ct_mul_form_len = 0;
    if ((cursor.byte(?c) & 1) == 1) {
        tgt.target.model.ct_mul_forms    = ?fuzz_mul_rows[0];
        tgt.target.model.ct_mul_form_len = 4;
    }
    tgt.target.model.ct_trust_var_shift = (cursor.byte(?c) & 1) == 1;

    var itn: intern.Interner = intern.init(alloc);
    fin { intern.dnit(?itn); }

    var operands: [FUNCTION_COUNT][BLOCK_COUNT][INSTR_COUNT][OPERAND_COUNT]lang_mir.MirOperand;
    var instrs:   [FUNCTION_COUNT][BLOCK_COUNT][INSTR_COUNT]lang_mir.MirInstr;
    var blocks:   [FUNCTION_COUNT][BLOCK_COUNT]lang_mir.MirBlock;
    var vregs:    [FUNCTION_COUNT][VREG_COUNT]lang_mir.MirVReg;
    var fns:      [FUNCTION_COUNT]lang_mir.MirFunction;

    var f: u32 = 0;
    for (f < FUNCTION_COUNT) {
        var v: u32 = 0;
        for (v < VREG_COUNT) {
            vregs[f][v] = lang_mir.vreg(cursor.word(?c), cursor.word(?c), (cursor.byte(?c) & 1) * 16, (cursor.byte(?c) & 1) == 1);
            v           = v + 1;
        }
        var b: u32 = 0;
        for (b < BLOCK_COUNT) {
            var i: u32 = 0;
            for (i < INSTR_COUNT) {
                var o: u32 = 0;
                for (o < OPERAND_COUNT) {
                    var op: lang_mir.MirOperand;
                    op.kind    = cursor.byte(?c)::lang_mir.MirOperandKind;
                    op.vreg    = lang_mir.vreg_id(cursor.word(?c) % PREG_LIMIT);
                    op.preg    = lang_mir.preg_id((cursor.word(?c) % PREG_LIMIT)::i32);
                    op.imm     = cursor.dword(?c)::i64;
                    op.sym     = intern.STR_NIL;
                    op.sym_off = cursor.word(?c)::i32::i64;
                    val index: u32 = cursor.word(?c);
                    op.scale = cursor.byte(?c);
                    val index_case: u8 = cursor.byte(?c) % 3;
                    op.index = lang_mir.index_none();
                    if (index_case == 1) { op.index = lang_mir.index_vreg(lang_mir.vreg_id(index)); }
                    or (index_case == 2) { op.index = lang_mir.index_preg(lang_mir.preg_id(index::i32)); }
                    op.sym_got           = (cursor.byte(?c) & 1) == 1;
                    operands[f][b][i][o] = op;
                    o                    = o + 1;
                }
                var mi: lang_mir.MirInstr = lang_mir.instr(cursor.word(?c)::lang_mir.MirOpcode,
                    ?operands[f][b][i][0], cursor.word(?c) % (OPERAND_COUNT + 1),
                    cursor.byte(?c), cursor.byte(?c));
                mi.asm_block         = nil;
                mi.dbg_bindings      = nil;
                mi.dbg_binding_count = 0;
                mi.inline_site       = cursor.word(?c);
                mi.vec_lane          = cursor.word(?c);
                mi.writes_secret     = (cursor.byte(?c) & 1) == 1;
                instrs[f][b][i]      = mi;
                i                    = i + 1;
            }
            var blk: lang_mir.MirBlock;
            blk.id          = cursor.word(?c);
            blk.instrs      = ?instrs[f][b][0];
            blk.instr_count = cursor.word(?c) % (INSTR_COUNT + 1);
            blk.instr_cap   = INSTR_COUNT;
            blocks[f][b]    = blk;
            b               = b + 1;
        }
        var fn: lang_mir.MirFunction;
        fn.name           = intern.STR_NIL;
        fn.blocks         = ?blocks[f][0];
        fn.block_count    = cursor.word(?c) % (BLOCK_COUNT + 1);
        fn.block_cap      = BLOCK_COUNT;
        fn.emit_order     = nil;
        fn.vregs          = ?vregs[f][0];
        fn.vreg_count     = cursor.word(?c) % (VREG_COUNT + 1);
        fn.vreg_cap       = VREG_COUNT;
        fn.callee_mask    = cursor.word(?c);
        fn.callee_mask_fp = cursor.word(?c);
        fn.oblivious      = true;
        fn.naked          = (cursor.byte(?c) & 1) == 1;
        fns[f]            = fn;
        f                 = f + 1;
    }

    var m: lang_mir.MirModule;
    m.alloc        = alloc;
    m.interner     = ?itn;
    m.srcmap       = nil;
    m.functions    = ?fns[0];
    m.function_len = cursor.word(?c) % (FUNCTION_COUNT + 1);
    m.function_cap = FUNCTION_COUNT;

    val rr: err[fail.Fail] = ctvalidate.validate(?tgt, ?m);
    if (sel rr.err) { ret verdict.rejected(fail.describe(rr.err)); }
    ret verdict.accepted();
}
