use mach.lang.fail;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use mach.lang.be.codegen.ctvalidate;
use codegen_mir: mach.lang.be.codegen.mir;
use mach.lang.build.outcome;
use mach.lang.ct;
use mach.lang.fuzz.cursor;
use mach.lang.fuzz.verdict;
use mach.lang.intern;
use lang_target: mach.lang.target;
use mach.lang.target.resolved;
use target_testing: mach.lang.target.testing;
use mach.lang.validation;
use mach.lang.validation.catalog;

#[testing]
val FUNCTION_COUNT: u32 = 2;
#[testing]
val BLOCK_COUNT:    u32 = 4;
#[testing]
val INSTR_COUNT:    u32 = 6;
#[testing]
val OPERAND_COUNT:  u32 = 3;
#[testing]
val VREG_COUNT:     u32 = 5;

#[testing]
val PREG_LIMIT: u32 = 256;

# a trusted multiply: the low half at every scalar width
#[testing]
var fuzz_mul_rows: [4]ct.CtMulForm = [4]ct.CtMulForm{
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0}
};

#[testing]
pub fun answer(alloc: *A.Allocator, data: *u8, len: usize) verdict.Verdict {
    if (len == 0) { ret verdict.rejected("fuzz.mir: an empty input names no corruption"); }

    var c: cursor.Cursor = cursor.init(data, len);

    val caught: str = catalog_answers(alloc, ?c, data);
    if (str_len(caught) != 0) { ret verdict.violated(caught); }

    var reg: lang_target.TargetRegistry = lang_target.registry_init();
    fin { lang_target.registry_dnit(?reg); }
    val r_62: err[fail.Fail] = lang_target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_62.err) { ret verdict.rejected("fuzz.mir: the target registry did not publish"); }
    val tr: res[resolved.Target, fail.Fail] = lang_target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret verdict.rejected(fail.describe(tr.err)); }
    var tgt: resolved.Target = tr.ok;
    tgt.model.ct_mul_forms    = nil;
    tgt.model.ct_mul_form_len = 0;
    if ((cursor.byte(?c) & 1) == 1) {
        tgt.model.ct_mul_forms    = ?fuzz_mul_rows[0];
        tgt.model.ct_mul_form_len = 4;
    }
    tgt.model.ct_trust_var_shift = (cursor.byte(?c) & 1) == 1;

    var itn: intern.Interner = intern.init(alloc);

    var operands: [FUNCTION_COUNT][BLOCK_COUNT][INSTR_COUNT][OPERAND_COUNT]codegen_mir.MirOperand;
    var instrs:   [FUNCTION_COUNT][BLOCK_COUNT][INSTR_COUNT]codegen_mir.MirInstr;
    var blocks:   [FUNCTION_COUNT][BLOCK_COUNT]codegen_mir.MirBlock;
    var vregs:    [FUNCTION_COUNT][VREG_COUNT]codegen_mir.MirVReg;
    var fns:      [FUNCTION_COUNT]codegen_mir.MirFunction;

    var f: u32 = 0;
    for (f < FUNCTION_COUNT) {
        var v: u32 = 0;
        for (v < VREG_COUNT) {
            vregs[f][v] = codegen_mir.vreg(cursor.word(?c), cursor.word(?c), (cursor.byte(?c) & 1) * 16, (cursor.byte(?c) & 1) == 1);
            v           = v + 1;
        }
        var b: u32 = 0;
        for (b < BLOCK_COUNT) {
            var i: u32 = 0;
            for (i < INSTR_COUNT) {
                var o: u32 = 0;
                for (o < OPERAND_COUNT) {
                    var op: codegen_mir.MirOperand;
                    op.kind    = cursor.byte(?c)::codegen_mir.MirOperandKind;
                    op.vreg    = codegen_mir.vreg_id(cursor.word(?c) % PREG_LIMIT);
                    op.preg    = codegen_mir.preg_id((cursor.word(?c) % PREG_LIMIT)::i32);
                    op.imm     = cursor.dword(?c)::i64;
                    op.sym     = intern.STR_NIL;
                    op.sym_off = cursor.word(?c)::i32::i64;
                    val index: u32 = cursor.word(?c);
                    op.scale = cursor.byte(?c);
                    val index_case: u8 = cursor.byte(?c) % 3;
                    op.index = codegen_mir.index_none();
                    if (index_case == 1) { op.index = codegen_mir.index_vreg(codegen_mir.vreg_id(index)); }
                    or (index_case == 2) { op.index = codegen_mir.index_preg(codegen_mir.preg_id(index::i32)); }
                    op.sym_got           = (cursor.byte(?c) & 1) == 1;
                    operands[f][b][i][o] = op;
                    o                    = o + 1;
                }
                var mi: codegen_mir.MirInstr = codegen_mir.instr(cursor.word(?c)::codegen_mir.MirOpcode,
                    ?operands[f][b][i][0], cursor.word(?c) % (OPERAND_COUNT + 1),
                    cursor.byte(?c), cursor.byte(?c));
                mi.asm_block         = nil;
                mi.dbg_bindings      = nil;
                mi.dbg_binding_count = 0;
                mi.inline_site       = cursor.word(?c);
                mi.vec_lane          = cursor.word(?c);
                mi.writes_secret     = (cursor.byte(?c) & 1) == 1;
                instrs[f][b][i]      = mi;
                i                    = i + 1;
            }
            var blk: codegen_mir.MirBlock;
            blk.id          = cursor.word(?c);
            blk.instrs      = ?instrs[f][b][0];
            blk.instr_count = cursor.word(?c) % (INSTR_COUNT + 1);
            blk.instr_cap   = INSTR_COUNT;
            blk.preds       = nil;
            blk.pred_count  = 0;
            blk.pred_cap    = 0;
            blocks[f][b]    = blk;
            b               = b + 1;
        }
        var fn: codegen_mir.MirFunction;
        fn.name           = intern.STR_NIL;
        fn.blocks         = ?blocks[f][0];
        fn.block_count    = cursor.word(?c) % (BLOCK_COUNT + 1);
        fn.block_cap      = BLOCK_COUNT;
        fn.emit_order     = nil;
        fn.vregs          = ?vregs[f][0];
        fn.vreg_count     = cursor.word(?c) % (VREG_COUNT + 1);
        fn.vreg_cap       = VREG_COUNT;
        fn.callee_mask    = cursor.word(?c);
        fn.callee_mask_fp = cursor.word(?c);
        fn.oblivious      = true;
        fn.naked          = (cursor.byte(?c) & 1) == 1;
        fns[f]            = fn;
        f                 = f + 1;
    }

    var m: codegen_mir.MirModule;
    m.alloc        = alloc;
    m.interner     = ?itn;
    m.srcmap       = nil;
    m.functions    = ?fns[0];
    m.function_len = cursor.word(?c) % (FUNCTION_COUNT + 1);
    m.function_cap = FUNCTION_COUNT;

    val rr: err[fail.Fail] = ctvalidate.validate(?tgt, ?m);
    if (sel rr.err) { ret verdict.rejected(fail.describe(rr.err)); }
    ret verdict.accepted();
}

#[testing]
fun catalog_answers(alloc: *A.Allocator, c: *cursor.Cursor, data: *u8) str {
    val named: str = data::usize::str;

    val listed: catalog.CatalogLookup = catalog.catalog_lookup(named);
    if (listed.kind == catalog.CATALOG_NOT_LISTED && str_len(listed.entry.boundary) != 0) {
        ret "an unlisted validation boundary came back carrying a catalog entry";
    }

    var kind:  validation.ValidationGateResultKind = cursor.byte(c)::validation.ValidationGateResultKind;
    var cause: validation.ValidationCause          = cursor.byte(c)::validation.ValidationCause;
    val r:     validation.ValidationGateResult     = validation.gate_result(kind, cause, named);

    var tally:  outcome.GateTally = outcome.gate_tally_init(alloc);
    val before: u32               = outcome.gate_tally_total(?tally);
    val folded: err[fail.Fail]    = catalog.catalog_fold(?tally, alloc, named, r);
    val after:  u32               = outcome.gate_tally_total(?tally);

    var broke: str = "";
    if (listed.kind == catalog.CATALOG_NOT_LISTED) {
        if (sel folded.ok) {
            broke = "an unlisted validation boundary was folded into the tally instead of being refused";
        }
        or (after != before) {
            broke = "a refused validation boundary still moved the gate tally";
        }
    }
    outcome.gate_tally_dnit(?tally);
    ret broke;
}
