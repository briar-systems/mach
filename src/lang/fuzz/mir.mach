use std.types.bool.bool;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use R: std.types.result;

use verdict: mach.lang.fuzz.verdict;
use mach.lang.be.codegen.ctvalidate;
use mach.lang.be.codegen.mir;
use mach.lang.build.outcome;
use mach.lang.intern;
use mach.lang.target;
use mach.lang.target.resolved;
use mach.lang.validation;
use mach.lang.validation.catalog;
use target_testing: mach.lang.target.testing;

val FUNCTION_COUNT: u32 = 2;
val BLOCK_COUNT:    u32 = 4;
val INSTR_COUNT:    u32 = 6;
val OPERAND_COUNT:  u32 = 3;
val VREG_COUNT:     u32 = 5;

val PREG_LIMIT: u32 = 256;

rec Cursor {
    data: *u8;
    len:  usize;
    at:   usize;
}

fun byte(c: *Cursor) u8 {
    if (c.len == 0) { ret 0; }
    val b: u8 = c.data[c.at % c.len];
    c.at = c.at + 1;
    ret b;
}

fun word(c: *Cursor) u32 {
    ret byte(c)::u32 | (byte(c)::u32 << 8) | (byte(c)::u32 << 16) | (byte(c)::u32 << 24);
}

fun dword(c: *Cursor) u64 {
    ret word(c)::u64 | (word(c)::u64 << 32);
}

pub fun answer(alloc: *A.Allocator, data: *u8, len: usize) verdict.Verdict {
    if (len == 0) { ret verdict.rejected("fuzz.mir: an empty input names no corruption"); }

    var c: Cursor;
    c.data = data;
    c.len  = len;
    c.at   = 0;

    val caught: str = catalog_answers(alloc, ?c, data);
    if (str_len(caught) != 0) { ret verdict.violated(caught); }

    var reg: target.TargetRegistry = target.registry_init();
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) {
        target.registry_dnit(?reg);
        ret verdict.rejected("fuzz.mir: the target registry did not publish");
    }
    val tr: R.Result[resolved.Target, str] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (R.is_err[resolved.Target, str](tr)) {
        target.registry_dnit(?reg);
        ret verdict.rejected(R.unwrap_err[resolved.Target, str](tr));
    }
    var tgt: resolved.Target = R.unwrap_ok[resolved.Target, str](tr);
    tgt.model.ct_trust_mul       = (byte(?c) & 1) == 1;
    tgt.model.ct_trust_var_shift = (byte(?c) & 1) == 1;

    var itn: intern.Interner = intern.init(alloc);

    var operands: [FUNCTION_COUNT][BLOCK_COUNT][INSTR_COUNT][OPERAND_COUNT]mir.MirOperand;
    var instrs:   [FUNCTION_COUNT][BLOCK_COUNT][INSTR_COUNT]mir.MirInstr;
    var blocks:   [FUNCTION_COUNT][BLOCK_COUNT]mir.MirBlock;
    var vregs:    [FUNCTION_COUNT][VREG_COUNT]mir.MirVReg;
    var fns:      [FUNCTION_COUNT]mir.MirFunction;

    var f: u32 = 0;
    for (f < FUNCTION_COUNT) {
        var v: u32 = 0;
        for (v < VREG_COUNT) {
            vregs[f][v] = mir.vreg(word(?c), word(?c), (byte(?c) & 1) == 1, (byte(?c) & 1) == 1);
            v = v + 1;
        }
        var b: u32 = 0;
        for (b < BLOCK_COUNT) {
            var i: u32 = 0;
            for (i < INSTR_COUNT) {
                var o: u32 = 0;
                for (o < OPERAND_COUNT) {
                    var op: mir.MirOperand;
                    op.kind          = byte(?c)::mir.MirOperandKind;
                    op.vreg          = word(?c) % PREG_LIMIT;
                    op.preg          = word(?c) % PREG_LIMIT;
                    op.imm           = dword(?c)::i64;
                    op.sym           = intern.STR_NIL;
                    op.sym_off       = word(?c)::i32;
                    op.index         = word(?c);
                    op.scale         = byte(?c);
                    op.index_is_preg = (byte(?c) & 1) == 1;
                    op.sym_got       = (byte(?c) & 1) == 1;
                    operands[f][b][i][o] = op;
                    o = o + 1;
                }
                var mi: mir.MirInstr = mir.instr(word(?c)::mir.MirOpcode,
                    ?operands[f][b][i][0], word(?c) % (OPERAND_COUNT + 1),
                    byte(?c), byte(?c));
                mi.asm_block         = nil;
                mi.dbg_bindings      = nil;
                mi.dbg_binding_count = 0;
                mi.inline_site       = word(?c);
                mi.vec_lane          = word(?c);
                mi.writes_secret     = (byte(?c) & 1) == 1;
                instrs[f][b][i] = mi;
                i = i + 1;
            }
            var blk: mir.MirBlock;
            blk.id          = word(?c);
            blk.instrs      = ?instrs[f][b][0];
            blk.instr_count = word(?c) % (INSTR_COUNT + 1);
            blk.instr_cap   = INSTR_COUNT;
            blk.preds       = nil;
            blk.pred_count  = 0;
            blk.pred_cap    = 0;
            blocks[f][b] = blk;
            b = b + 1;
        }
        var fn: mir.MirFunction;
        fn.name        = intern.STR_NIL;
        fn.blocks      = ?blocks[f][0];
        fn.block_count = word(?c) % (BLOCK_COUNT + 1);
        fn.block_cap   = BLOCK_COUNT;
        fn.emit_order  = nil;
        fn.vregs       = ?vregs[f][0];
        fn.vreg_count  = word(?c) % (VREG_COUNT + 1);
        fn.vreg_cap    = VREG_COUNT;
        fn.callee_mask    = word(?c);
        fn.callee_mask_fp = word(?c);
        fn.oblivious   = true;
        fn.naked       = (byte(?c) & 1) == 1;
        fns[f] = fn;
        f = f + 1;
    }

    var m: mir.MirModule;
    m.alloc        = alloc;
    m.interner     = ?itn;
    m.srcmap       = nil;
    m.functions    = ?fns[0];
    m.function_len = word(?c) % (FUNCTION_COUNT + 1);
    m.function_cap = FUNCTION_COUNT;

    val rr: R.Result[R.Void, str] = ctvalidate.run(?tgt, ?m);
    target.registry_dnit(?reg);
    if (R.is_err[R.Void, str](rr)) { ret verdict.rejected(R.unwrap_err[R.Void, str](rr)); }
    ret verdict.accepted();
}

fun catalog_answers(alloc: *A.Allocator, c: *Cursor, data: *u8) str {
    val named: str = data::usize::str;

    val listed: catalog.CatalogLookup = catalog.catalog_lookup(named);
    if (listed.kind == catalog.CATALOG_NOT_LISTED && str_len(listed.entry.boundary) != 0) {
        ret "an unlisted validation boundary came back carrying a catalog entry";
    }

    var kind:  validation.ValidationGateResultKind = byte(c)::validation.ValidationGateResultKind;
    var cause: validation.ValidationCause          = byte(c)::validation.ValidationCause;
    val r: validation.ValidationGateResult = validation.gate_result(kind, cause, named);

    var tally: outcome.GateTally = outcome.gate_tally_init(alloc);
    val before: u32 = outcome.gate_tally_total(?tally);
    val folded: R.Result[R.Void, str] = catalog.catalog_fold(?tally, alloc, named, r);
    val after: u32 = outcome.gate_tally_total(?tally);

    var broke: str = "";
    if (listed.kind == catalog.CATALOG_NOT_LISTED) {
        if (!R.is_err[R.Void, str](folded)) {
            broke = "an unlisted validation boundary was folded into the tally instead of being refused";
        }
        or (after != before) {
            broke = "a refused validation boundary still moved the gate tally";
        }
    }
    outcome.gate_tally_dnit(?tally);
    ret broke;
}
