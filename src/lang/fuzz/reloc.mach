use std.types.bool.bool;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use verdict: mach.lang.fuzz.verdict;
use mach.lang.be.codegen.dwarf;
use mach.lang.target;
use mach.lang.target.isa;
use mach.lang.target.of;
use rel: mach.lang.target.of.reloc;

val RECORD_BYTES: usize = 54;

val SECTION_BYTES: usize = 256;
val GUARD_BYTES:   usize = 64;
val ARENA_BYTES:   usize = 384;

val POISON: u8 = 0xAA;

val ISA_COUNT: usize = 5;

fun provide_debug_descriptor() R.Result[of.DebugVTable, str] {
    ret R.ok[of.DebugVTable, str](dwarf.debug_descriptor());
}

fun isa_names(out: *str) usize {
    out[0] = "x86_64";
    out[1] = "aarch64";
    out[2] = "riscv64";
    out[3] = "riscv32";
    out[4] = "mos6502";
    ret ISA_COUNT;
}

fun read_u32(data: *u8, at: usize) u32 {
    ret data[at]::u32
      | (data[at + 1]::u32 << 8)
      | (data[at + 2]::u32 << 16)
      | (data[at + 3]::u32 << 24);
}

fun read_u64(data: *u8, at: usize) u64 {
    ret read_u32(data, at)::u64 | (read_u32(data, at + 4)::u64 << 32);
}

pub fun answer(alloc: *A.Allocator, data: *u8, len: usize) verdict.Verdict {
    if (len < RECORD_BYTES) {
        ret verdict.rejected("fuzz.reloc: input is shorter than one relocation record");
    }

    var reg: target.TargetRegistry = target.registry_init();
    val rr: R.Result[R.Void, str] = target.register_all(?reg, provide_debug_descriptor);
    if (R.is_err[R.Void, str](rr)) {
        target.registry_dnit(?reg);
        ret verdict.rejected(R.unwrap_err[R.Void, str](rr));
    }

    var names: [ISA_COUNT]str;
    val n_isa: usize = isa_names(?names[0]);

    var arena: [ARENA_BYTES]u8;
    var applied: usize = 0;
    var at: usize = 0;
    for (at + RECORD_BYTES <= len) {
        val which: usize = data[at]::usize % n_isa;
        val kind:  of.RelocKind = data[at + 1]::of.RelocKind;

        val found: O.Option[*isa.IsaVTable] = isa.lookup(?reg.isa, names[which]);
        at = at + RECORD_BYTES;
        if (!O.is_some[*isa.IsaVTable](found)) { cnt; }
        val vt: *isa.IsaVTable = O.unwrap[*isa.IsaVTable](found);
        if (vt.reloc == nil || vt.reloc.apply == nil) { cnt; }

        val base: usize = at - RECORD_BYTES;
        val sec_len: u32 = (read_u32(data, base + 2)::usize % (SECTION_BYTES + 1))::u32;
        val patch_off: u32 = read_u32(data, base + 6);
        var tgt: rel.RelocTarget = rel.target(read_u64(data, base + 10),
                                             read_u64(data, base + 18),
                                             read_u32(data, base + 26));
        val addend:   i64 = read_u64(data, base + 30)::i64;
        val patch_va: u64 = read_u64(data, base + 38);
        val extra:    u64 = read_u64(data, base + 46);

        var i: usize = 0;
        for (i < ARENA_BYTES) { arena[i] = POISON; i = i + 1; }

        val dst: *u8 = ?arena[GUARD_BYTES];
        vt.reloc.apply(kind, dst, patch_off, sec_len, tgt, addend, patch_va, extra);
        applied = applied + 1;

        val bad: usize = first_byte_written_outside(?arena[0], sec_len::usize);
        if (bad != ARENA_BYTES) {
            target.registry_dnit(?reg);
            ret verdict.violated("applying a relocation wrote outside the section it was handed");
        }
    }
    target.registry_dnit(?reg);

    if (applied == 0) {
        ret verdict.rejected("fuzz.reloc: no record named an instruction set that applies relocations");
    }
    ret verdict.accepted();
}

fun first_byte_written_outside(arena: *u8, sec_len: usize) usize {
    var i: usize = 0;
    for (i < ARENA_BYTES) {
        val inside: bool = i >= GUARD_BYTES && i < GUARD_BYTES + sec_len;
        if (!inside && arena[i] != POISON) { ret i; }
        i = i + 1;
    }
    ret ARENA_BYTES;
}
