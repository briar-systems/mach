use std.types.bool.bool;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.allocator.arena;
use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use T: std.allocator.testing;

use verdict: mach.lang.fuzz.verdict;
use mach.lang.diagnostic;
use mach.lang.fe.ast;
use mach.lang.fe.ast.id;
use lex: mach.lang.fe.lexer;
use parse_mod: mach.lang.fe.parser;
use mach.lang.fe.parser.state;
use src: mach.lang.source;

pub fun answer(alloc: *A.Allocator, data: *u8, len: usize) verdict.Verdict {
    val source: str = data::usize::str;

    var ar: arena.Arena;
    var arena_alloc: A.Allocator;
    if (O.is_some[str](arena.init(?ar, alloc, 0)))            { ret verdict.accepted(); }
    if (O.is_some[str](arena.make(?arena_alloc, ?ar)))        { arena.dnit(?ar); ret verdict.accepted(); }
    val v: verdict.Verdict = answer_in(?arena_alloc, alloc, source, data, len);
    arena.dnit(?ar);
    ret v;
}

fun answer_in(alloc: *A.Allocator, backing: *A.Allocator, source: str,
              data: *u8, len: usize) verdict.Verdict {

    val tr: R.Result[lex.TokenStream, str] = lex.tokenize(source, alloc, 0::src.FileId);
    if (R.is_err[lex.TokenStream, str](tr)) {
        ret verdict.rejected(R.unwrap_err[lex.TokenStream, str](tr));
    }
    var stream: lex.TokenStream = R.unwrap_ok[lex.TokenStream, str](tr);

    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(alloc);
    var out:   ast.Ast                    = ast.init(alloc, 0::src.FileId);

    val pr: R.Result[bool, state.ParseFail] = parse_mod.parse(?stream, ?out, ?diags);
    lex.dnit(?stream, alloc);

    if (R.is_err[bool, state.ParseFail](pr)) {
        val pristine: bool = is_pristine(?out);
        val f: state.ParseFail = R.unwrap_err[bool, state.ParseFail](pr);
        val why: str = fail_kind_name(f.kind);
        ast.dnit(?out);
        diagnostic.store_dnit(?diags);
        if (!pristine) {
            ret verdict.violated("a failed parse published part of an abstract syntax tree");
        }
        ret verdict.rejected(why);
    }

    val dangling: str = dangling_reference(?out);
    ast.dnit(?out);
    diagnostic.store_dnit(?diags);
    if (!is_empty(dangling)) { ret verdict.violated(dangling); }
    ret under_allocation_refusal(backing, source, ordinal_from(data, len));
}

fun ordinal_from(data: *u8, len: usize) usize {
    var h: usize = 1;
    var i: usize = 0;
    for (i < len) { h = h * 31 + data[i]::usize; i = i + 1; }
    ret 1 + h % 256;
}

fun under_allocation_refusal(backing: *A.Allocator, source: str, ordinal: usize) verdict.Verdict {
    val tr: R.Result[lex.TokenStream, str] = lex.tokenize(source, backing, 0::src.FileId);
    if (R.is_err[lex.TokenStream, str](tr)) { ret verdict.accepted(); }
    var stream: lex.TokenStream = R.unwrap_ok[lex.TokenStream, str](tr);

    var failing: T.Testing;
    if (O.is_some[str](T.make(?failing))) {
        lex.dnit(?stream, backing);
        ret verdict.accepted();
    }
    T.fail_at_ordinal(?failing, ordinal);

    var out:   ast.Ast                    = ast.init(T.allocator_of(?failing), 0::src.FileId);
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(backing);

    val pr: R.Result[bool, state.ParseFail] = parse_mod.parse(?stream, ?out, ?diags);
    var broke: str = "";
    if (R.is_err[bool, state.ParseFail](pr) && !is_pristine(?out)) {
        broke = "a parse that ran out of memory published part of an abstract syntax tree";
    }
    ast.dnit(?out);
    diagnostic.store_dnit(?diags);
    lex.dnit(?stream, backing);

    if (is_empty(broke) && !T.tracking_exhausted(?failing)) {
        if (T.leaked(?failing))                    { broke = "a parse leaked when an allocation was refused"; }
        or (T.double_free_count(?failing) != 0)    { broke = "a parse freed the same allocation twice when an allocation was refused"; }
    }
    T.dnit(?failing);
    if (!is_empty(broke)) { ret verdict.violated(broke); }
    ret verdict.accepted();
}

fun is_empty(s: str) bool { ret str_len(s) == 0; }

fun fail_kind_name(kind: state.ParseFailKind) str {
    if (kind == state.PARSE_FAIL_OOM)   { ret "the parse ran out of memory"; }
    if (kind == state.PARSE_FAIL_ICE)   { ret "the parse hit an internal compiler error"; }
    if (kind == state.PARSE_FAIL_DEPTH) { ret "the input nests deeper than the parser descends"; }
    ret "the parse could not record a diagnostic";
}

fun is_pristine(out: *ast.Ast) bool {
    ret out.module_len == 0 && out.expr_len == 0 && out.stmt_len == 0
     && out.decl_len == 0 && out.type_len == 0
     && out.typed_name_len == 0 && out.field_init_len == 0
     && out.generic_name_len == 0 && out.comptime_branch_len == 0
     && out.decorator_len == 0 && out.decl_id_len == 0
     && out.stmt_id_len == 0 && out.expr_id_len == 0 && out.type_id_len == 0
     && out.root_module == id.MODULE_NODE_NIL;
}

fun dangling_reference(out: *ast.Ast) str {
    if (out.root_module != id.MODULE_NODE_NIL
        && out.root_module::usize >= out.module_len) {
        ret "a published tree names a module node that does not exist";
    }
    var i: usize = 0;
    for (i < out.decl_id_len) {
        val v: id.DeclId = out.decl_ids[i];
        if (v != id.DECL_NIL && v::usize >= out.decl_len) {
            ret "a published tree names a declaration that does not exist";
        }
        i = i + 1;
    }
    i = 0;
    for (i < out.stmt_id_len) {
        val v: id.StmtId = out.stmt_ids[i];
        if (v != id.STMT_NIL && v::usize >= out.stmt_len) {
            ret "a published tree names a statement that does not exist";
        }
        i = i + 1;
    }
    i = 0;
    for (i < out.expr_id_len) {
        val v: id.ExprId = out.expr_ids[i];
        if (v != id.EXPR_NIL && v::usize >= out.expr_len) {
            ret "a published tree names an expression that does not exist";
        }
        i = i + 1;
    }
    i = 0;
    for (i < out.type_id_len) {
        val v: id.TypeId = out.type_ids[i];
        if (v != id.TYPE_NIL && v::usize >= out.type_len) {
            ret "a published tree names a type that does not exist";
        }
        i = i + 1;
    }
    ret "";
}
