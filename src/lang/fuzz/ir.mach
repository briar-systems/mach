use mach.lang.fail;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use mach.lang.fuzz.verdict;
use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use irtype: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.me.ir.verify;
use mach.lang.source;
use mach.lang.target;
use mach.lang.target.resolved;
use target_testing: mach.lang.target.testing;

val BLOCK_COUNT: u32 = 6;

rec Cursor {
    data: *u8;
    len:  usize;
    at:   usize;
}

fun byte(c: *Cursor) u8 {
    if (c.len == 0) { ret 0; }
    val b: u8 = c.data[c.at % c.len];
    c.at = c.at + 1;
    ret b;
}

fun word(c: *Cursor) u32 {
    ret byte(c)::u32 | (byte(c)::u32 << 8) | (byte(c)::u32 << 16) | (byte(c)::u32 << 24);
}

fun bounded(c: *Cursor, limit: u32) u32 {
    if (limit == 0) { ret 0; }
    ret word(c) % limit;
}

pub fun answer(alloc: *A.Allocator, data: *u8, len: usize) verdict.Verdict {
    if (len == 0) { ret verdict.rejected("fuzz.ir: an empty input names no corruption"); }

    var reg:  target.TargetRegistry = target.registry_init();
    val r_54: err[fail.Fail]        = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_54.err) {
        target.registry_dnit(?reg);
        ret verdict.rejected("fuzz.ir: the target registry did not publish");
    }
    val tr: res[resolved.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) {
        target.registry_dnit(?reg);
        ret verdict.rejected(fail.describe(tr.err));
    }
    var tgt: resolved.Target = tr.ok;

    var itn: intern.Interner = intern.init(alloc);
    fin { intern.dnit(?itn); }
    val mr: res[ir.Module, fail.Fail] = ir.init(alloc, intern.STR_NIL);
    if (sel mr.err) {
        target.registry_dnit(?reg);
        ret verdict.rejected(fail.describe(mr.err));
    }
    var m: ir.Module = mr.ok;

    if (!skeleton(?m)) {
        ir.dnit(?m);
        target.registry_dnit(?reg);
        ret verdict.rejected("fuzz.ir: the skeleton module could not be built");
    }

    var c: Cursor;
    c.data = data;
    c.len  = len;
    c.at   = 0;
    corrupt(?m, ?c);

    val full: bool = (byte(?c) & 1) == 1;
    val repr: bool = (byte(?c) & 1) == 1;

    val rr: res[verify.VerifyReport, fail.Fail] =
        verify.verify_module_ext(?m, alloc, verify.opts(?tgt, full, repr));
    if (sel rr.err) {
        val why: str = fail.describe(rr.err);
        ir.dnit(?m);
        target.registry_dnit(?reg);
        ret verdict.rejected(why);
    }
    var report: verify.VerifyReport = rr.ok;

    var broke:             str = "";
    var rendering_failure: str = nil;
    var i:                 u32 = 0;
    for (i < report.len) {
        val v: *verify.Violation = ?report.violations[i];
        if (v.function >= m.function_len) {
            broke = "the verifier reported a violation in a function that does not exist";
        }
        val check_text: opt[str] = verify.describe(v.check);
        if (sel check_text.none) {
            broke = "the verifier reported a violation whose check is outside the VerifyCheck catalog";
        }
        val loc: source.SrcLoc = verify.violation_loc(?m, v);
        if (source.loc_is_valid(loc) && v.instr == id.INSTR_NIL) {
            broke = "the verifier gave a source location for a violation that names no instruction";
        }
        val described: res[str, fail.Fail] = verify.describe_located(?m, v, ?itn, nil, alloc);
        if (sel described.err) {
            rendering_failure = fail.describe(described.err);
            brk;
        }
        str_free(alloc, described.ok);
        i = i + 1;
    }

    verify.dnit_report(?report);
    ir.dnit(?m);
    target.registry_dnit(?reg);
    if (rendering_failure != nil) { ret verdict.rejected(rendering_failure); }
    if (str_len(broke) != 0)      { ret verdict.violated(broke); }
    ret verdict.accepted();
}

fun skeleton(m: *ir.Module) bool {
    val it: res[irtype.IrTypeId, fail.Fail] = irtype.intern_int(?m.types, 64);
    if (sel it.err) { ret false; }
    val i64ty: irtype.IrTypeId = it.ok;

    val vt: res[irtype.IrTypeId, fail.Fail] = irtype.intern_void(?m.types);
    if (sel vt.err) { ret false; }
    val voidty: irtype.IrTypeId = vt.ok;

    val sr: res[irtype.IrTypeId, fail.Fail] = irtype.intern_fn(?m.types, voidty, nil, 0, false);
    if (sel sr.err) { ret false; }
    val sig: irtype.IrTypeId = sr.ok;

    val r_139: res[u32, fail.Fail] = ir.function_add(m, intern.STR_NIL, sig, 0);
    if (sel r_139.err) { ret false; }

    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, ?m.functions[0]);

    var blocks: [BLOCK_COUNT]id.BlockId;
    var k:      u32 = 0;
    for (k < BLOCK_COUNT) {
        val br: res[id.BlockId, fail.Fail] = builder.new_block(?b);
        if (sel br.err) { ret false; }
        blocks[k] = br.ok;
        k         = k + 1;
    }

    val zero: value.Value = value.const_int(0, i64ty);
    val one:  value.Value = value.const_int(1, i64ty);

    builder.set_block(?b, blocks[0]);
    val av: res[value.Value, fail.Fail] = builder.emit_add(?b, zero, one);
    if (sel av.err) { ret false; }
    val defined: value.Value                 = av.ok;
    val r_160:   res[value.Value, fail.Fail] = builder.emit_alloca(?b, i64ty, one);
    if (sel r_160.err) { ret false; }
    val r_161: err[fail.Fail] = builder.emit_cbr(?b, one, blocks[1], blocks[2]);
    if (sel r_161.err) { ret false; }

    builder.set_block(?b, blocks[1]);
    val r_164: res[value.Value, fail.Fail] = builder.emit_mul(?b, defined, one);
    if (sel r_164.err) { ret false; }
    val r_165: err[fail.Fail] = builder.emit_br(?b, blocks[3]);
    if (sel r_165.err) { ret false; }

    builder.set_block(?b, blocks[2]);
    val r_168: res[value.Value, fail.Fail] = builder.emit_bitcast(?b, defined, i64ty);
    if (sel r_168.err) { ret false; }
    val r_169: err[fail.Fail] = builder.emit_br(?b, blocks[3]);
    if (sel r_169.err) { ret false; }

    builder.set_block(?b, blocks[3]);
    val r_172: res[value.Value, fail.Fail] = builder.emit_cmp_eq(?b, defined, zero);
    if (sel r_172.err) { ret false; }
    val r_173: err[fail.Fail] = builder.emit_br(?b, blocks[4]);
    if (sel r_173.err) { ret false; }

    builder.set_block(?b, blocks[4]);
    val r_176: res[value.Value, fail.Fail] = builder.emit_trunc(?b, defined, i64ty);
    if (sel r_176.err) { ret false; }
    val r_177: err[fail.Fail] = builder.emit_cbr(?b, one, blocks[4], blocks[5]);
    if (sel r_177.err) { ret false; }

    builder.set_block(?b, blocks[5]);
    val r_180: err[fail.Fail] = builder.emit_ret_void(?b);
    if (sel r_180.err) { ret false; }
    ret true;
}

fun corrupt(m: *ir.Module, c: *Cursor) {
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];

        var ii: u32 = 0;
        for (ii < fn.instr_len) {
            val ins: *instruction.Instruction = ?fn.instrs[ii];
            ins.kind   = byte(c)::instruction.InstrKind;
            ins.ty     = word(c)::irtype.IrTypeId;
            ins.aux_ty = word(c)::irtype.IrTypeId;
            ins.flags  = (byte(c)::u16 | (byte(c)::u16 << 8));
            ins.secret = (byte(c) & 1) == 1;

            var oi: u32 = 0;
            for (oi < ins.operand_cap) {
                val op: *value.Value = ?ins.operands[oi];
                op.kind       = byte(c)::value.ValueKind;
                op.ty         = word(c)::irtype.IrTypeId;
                op.secret     = (byte(c) & 1) == 1;
                op.data.instr = word(c)::id.InstructionId;
                oi            = oi + 1;
            }
            ins.operand_count = bounded(c, ins.operand_cap + 1);
            ii                = ii + 1;
        }

        var bi: u32 = 0;
        for (bi < fn.block_count) {
            val blk: *ir.Block = ?fn.blocks[bi];
            blk.terminator = word(c)::id.InstructionId;

            var si: u32 = 0;
            for (si < blk.instr_cap) {
                blk.instructions[si] = word(c)::id.InstructionId;
                si                   = si + 1;
            }
            blk.instr_count = bounded(c, blk.instr_cap + 1);

            var pi: u32 = 0;
            for (pi < blk.phi_cap) {
                blk.phis[pi] = word(c)::id.InstructionId;
                pi           = pi + 1;
            }
            blk.phi_count = bounded(c, blk.phi_cap + 1);

            var di: u32 = 0;
            for (di < blk.pred_cap) {
                blk.preds[di] = word(c)::id.BlockId;
                di            = di + 1;
            }
            blk.pred_count = bounded(c, blk.pred_cap + 1);
            bi             = bi + 1;
        }
        fi = fi + 1;
    }
}
