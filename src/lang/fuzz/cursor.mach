use std.types.size.usize;

# reads fuzz input bytes in order, wrapping at the end so any length drives a whole fixture
#[testing]
pub rec Cursor {
    data: *u8;
    len:  usize;
    at:   usize;
}

#[testing]
pub fun init(data: *u8, len: usize) Cursor {
    ret Cursor{data: data, len: len, at: 0};
}

#[testing]
pub fun byte(c: *Cursor) u8 {
    if (c.len == 0) { ret 0; }
    val b: u8 = c.data[c.at % c.len];
    c.at = c.at + 1;
    ret b;
}

#[testing]
pub fun word(c: *Cursor) u32 {
    ret byte(c)::u32 | (byte(c)::u32 << 8) | (byte(c)::u32 << 16) | (byte(c)::u32 << 24);
}

#[testing]
pub fun dword(c: *Cursor) u64 {
    ret word(c)::u64 | (word(c)::u64 << 32);
}
