use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

#[testing]
val DETAIL_CAP: usize = 512;

# an answer's verdict; it holds its own copy of the detail, truncated to fit, so
# an answer releases whatever the text lived in before it returns
#[testing]
pub rec Verdict {
    finding: bool;
    text:    [DETAIL_CAP]u8;
}

#[testing]
fun make(finding: bool, detail: str) Verdict {
    var v: Verdict;
    v.finding = finding;
    var n: usize = 0;
    if (detail != nil)   { n = str_len(detail); }
    if (n >= DETAIL_CAP) { n = DETAIL_CAP - 1; }
    var i: usize = 0;
    for (i < n) {
        v.text[i] = detail[i];
        i         = i + 1;
    }
    v.text[n] = 0;
    ret v;
}

# the verdict's detail, empty for an accepted input
#[testing]
pub fun detail(v: *Verdict) str {
    ret (?v.text[0])::usize::str;
}

#[testing]
pub fun accepted() Verdict {
    ret make(false, "");
}

#[testing]
pub fun rejected(detail: str) Verdict {
    ret make(false, detail);
}

#[testing]
pub fun violated(detail: str) Verdict {
    ret make(true, detail);
}

#[testing]
pub fun rejected_if_err(r: err[fail.Fail]) Verdict {
    if (sel r.err) { ret rejected(fail.describe(r.err)); }
    ret accepted();
}
