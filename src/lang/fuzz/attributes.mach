use std.types.result.res;
use std.types.error.err;
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use verdict: mach.lang.fuzz.verdict;
use attrs: mach.lang.target.isa.riscv.attributes;

val U32_CAP: usize = 0xFFFFFFFF;

pub fun answer(alloc: *A.Allocator, data: *u8, len: usize) verdict.Verdict {
    if (len > U32_CAP) {
        ret verdict.rejected("fuzz.attributes: input is longer than a section length can name");
    }
    val n: u32 = len::u32;

    var arch: attrs.Arch;
    attrs.parse_arch(data, n, ?arch);

    var one: attrs.Attrs;
    val p1: err[fail.Fail] = attrs.parse_body(data, n, ?one);
    if (sel p1.err) { ret verdict.rejected(fail.describe(p1.err)); }

    var first_len: u32 = 0;
    val s1: res[*u8, fail.Fail] = attrs.serialize(alloc, ?one, ?first_len);
    if (sel s1.err) { ret verdict.rejected(fail.describe(s1.err)); }
    val first: *u8 = s1.ok;

    var two: attrs.Attrs;
    val p2: err[fail.Fail] = attrs.parse_body(first, first_len, ?two);
    if (sel p2.err) {
        A.deallocate[u8](alloc, first, first_len::usize);
        ret verdict.violated("a serialized attribute body did not parse back");
    }

    var second_len: u32 = 0;
    val s2: res[*u8, fail.Fail] = attrs.serialize(alloc, ?two, ?second_len);
    if (sel s2.err) {
        A.deallocate[u8](alloc, first, first_len::usize);
        ret verdict.rejected(fail.describe(s2.err));
    }
    val second: *u8 = s2.ok;

    val same: bool = bytes_equal(first, first_len, second, second_len);
    A.deallocate[u8](alloc, second, second_len::usize);
    if (!same) {
        A.deallocate[u8](alloc, first, first_len::usize);
        ret verdict.violated("serializing an attribute body twice did not reach a fixed point");
    }

    val cut: u32 = split_at(data, n);
    var merged_len: u32 = 0;
    val mr: res[*u8, fail.Fail] = attrs.riscv64_merge_attributes(
        alloc, data, cut, ?data[cut::usize], n - cut, ?merged_len);
    if (sel mr.err) {
        A.deallocate[u8](alloc, first, first_len::usize);
        ret verdict.rejected(fail.describe(mr.err));
    }
    A.deallocate[u8](alloc, mr.ok, merged_len::usize);

    var self_len: u32 = 0;
    val sr: res[*u8, fail.Fail] = attrs.riscv64_merge_attributes(
        alloc, data, n, data, n, ?self_len);
    if (sel sr.err) {
        A.deallocate[u8](alloc, first, first_len::usize);
        ret verdict.violated("an attribute body that parsed did not merge with itself");
    }
    val self_merged: *u8 = sr.ok;
    val idempotent: bool = bytes_equal(first, first_len, self_merged, self_len);
    A.deallocate[u8](alloc, self_merged, self_len::usize);
    A.deallocate[u8](alloc, first, first_len::usize);
    if (!idempotent) {
        ret verdict.violated("merging an attribute body with itself did not reproduce it");
    }
    ret verdict.accepted();
}

fun split_at(data: *u8, n: u32) u32 {
    if (n == 0) { ret 0; }
    ret data[0]::u32 % (n + 1);
}

fun bytes_equal(a: *u8, a_len: u32, b: *u8, b_len: u32) bool {
    if (a_len != b_len) { ret false; }
    var i: u32 = 0;
    for (i < a_len) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}
