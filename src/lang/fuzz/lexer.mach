use std.types.bool.bool;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use R: std.types.result;

use verdict: mach.lang.fuzz.verdict;
use mach.lang.diagnostic;
use lex: mach.lang.fe.lexer;
use mach.lang.fe.token;
use src: mach.lang.source;

pub fun answer(alloc: *A.Allocator, data: *u8, len: usize) verdict.Verdict {
    val source: str  = data::usize::str;
    val n:      usize = str_len(source);

    val tr: R.Result[lex.TokenStream, str] = lex.tokenize(source, alloc, 0::src.FileId);
    if (R.is_err[lex.TokenStream, str](tr)) {
        ret verdict.rejected(R.unwrap_err[lex.TokenStream, str](tr));
    }
    var stream: lex.TokenStream = R.unwrap_ok[lex.TokenStream, str](tr);

    var i: usize = 0;
    for (i < stream.len) {
        if (!span_inside(?stream.tokens[i].span, n)) {
            lex.dnit(?stream, alloc);
            ret verdict.violated("a token span reaches past the end of the source");
        }
        i = i + 1;
    }
    var e: usize = 0;
    for (e < stream.error_len) {
        if (!span_inside(?stream.errors[e].span, n)) {
            lex.dnit(?stream, alloc);
            ret verdict.violated("a lexical error span reaches past the end of the source");
        }
        e = e + 1;
    }
    var c: usize = 0;
    for (c < stream.comment_len) {
        if (!span_inside(?stream.comments[c].span, n)) {
            lex.dnit(?stream, alloc);
            ret verdict.violated("a comment run reaches past the end of the source");
        }
        c = c + 1;
    }

    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(alloc);
    val de: R.Result[R.Void, str] = lex.emit_diagnostics(?stream, ?diags);
    if (R.is_err[R.Void, str](de)) {
        diagnostic.store_dnit(?diags);
        lex.dnit(?stream, alloc);
        ret verdict.rejected(R.unwrap_err[R.Void, str](de));
    }

    var t: usize = 0;
    for (t < stream.len) {
        val run: token.Span = lex.doc_run_above(?stream, stream.tokens[t].span.offset);
        if (!span_inside(?run, n)) {
            diagnostic.store_dnit(?diags);
            lex.dnit(?stream, alloc);
            ret verdict.violated("a documentation run reaches past the end of the source");
        }
        t = t + 1;
    }

    diagnostic.store_dnit(?diags);
    lex.dnit(?stream, alloc);
    ret verdict.accepted();
}

fun span_inside(s: *token.Span, n: usize) bool {
    if (s.offset > n) { ret false; }
    if (s.len > n)    { ret false; }
    ret s.offset + s.len <= n;
}
