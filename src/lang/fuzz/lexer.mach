use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std_allocator: std.allocator;

use mach.lang.diagnostic;
use fe_lexer: mach.lang.fe.lexer;
use mach.lang.fe.token;
use mach.lang.fuzz.verdict;
use lang_source: mach.lang.source;

#[testing]
pub fun answer(alloc: *std_allocator.Allocator, data: *u8, len: usize) verdict.Verdict {
    val source: str   = data::usize::str;
    val n:      usize = str_len(source);

    val tr: res[fe_lexer.TokenStream, fail.Fail] = fe_lexer.tokenize(source, alloc, 0::lang_source.FileId);
    if (sel tr.err) {
        ret verdict.rejected(fail.describe(tr.err));
    }
    var stream: fe_lexer.TokenStream = tr.ok;

    var i: usize = 0;
    for (i < stream.len) {
        if (!span_inside(?stream.tokens[i].span, n)) {
            fe_lexer.dnit(?stream, alloc);
            ret verdict.violated("a token span reaches past the end of the source");
        }
        i = i + 1;
    }
    var e: usize = 0;
    for (e < stream.error_len) {
        if (!span_inside(?stream.errors[e].span, n)) {
            fe_lexer.dnit(?stream, alloc);
            ret verdict.violated("a lexical error span reaches past the end of the source");
        }
        e = e + 1;
    }
    var c: usize = 0;
    for (c < stream.comment_len) {
        if (!span_inside(?stream.comments[c].span, n)) {
            fe_lexer.dnit(?stream, alloc);
            ret verdict.violated("a comment run reaches past the end of the source");
        }
        c = c + 1;
    }

    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(alloc);
    val de:    err[fail.Fail]             = fe_lexer.emit_diagnostics(?stream, ?diags);
    if (sel de.err) {
        diagnostic.store_dnit(?diags);
        fe_lexer.dnit(?stream, alloc);
        ret verdict.rejected(fail.describe(de.err));
    }

    var t: usize = 0;
    for (t < stream.len) {
        val run: token.Span = fe_lexer.doc_run_above(?stream, stream.tokens[t].span.offset);
        if (!span_inside(?run, n)) {
            diagnostic.store_dnit(?diags);
            fe_lexer.dnit(?stream, alloc);
            ret verdict.violated("a documentation run reaches past the end of the source");
        }
        t = t + 1;
    }

    diagnostic.store_dnit(?diags);
    fe_lexer.dnit(?stream, alloc);
    ret verdict.accepted();
}

#[testing]
fun span_inside(s: *token.Span, n: usize) bool {
    if (s.offset > n) { ret false; }
    if (s.len > n)    { ret false; }
    ret s.offset + s.len <= n;
}
