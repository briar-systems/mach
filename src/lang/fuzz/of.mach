use std.types.bool.bool;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use fuzz: mach.lang.fuzz.verdict;
use mach.lang.intern;
use mach.lang.target.of;
use mach.lang.target.of.ar;
use mach.lang.target.of.coff;
use mach.lang.target.of.elf;
use mach.lang.target.of.macho;
use mach.lang.target.of.spv;

val AR_MEMBER_CAP: u32 = 0xFFFF;

pub fun answer_elf(alloc: *A.Allocator, data: *u8, len: usize) fuzz.Verdict {
    ret fuzz.rejected_if_err(parse_registered(alloc, "elf", data, len));
}

pub fun answer_coff(alloc: *A.Allocator, data: *u8, len: usize) fuzz.Verdict {
    ret fuzz.rejected_if_err(parse_registered(alloc, "coff", data, len));
}

pub fun answer_macho(alloc: *A.Allocator, data: *u8, len: usize) fuzz.Verdict {
    ret fuzz.rejected_if_err(parse_registered(alloc, "macho", data, len));
}

pub fun answer_ar(alloc: *A.Allocator, data: *u8, len: usize) fuzz.Verdict {
    ret fuzz.rejected_if_err(walk_archive(data, len));
}

pub fun answer_spv(alloc: *A.Allocator, data: *u8, len: usize) fuzz.Verdict {
    val r: R.Result[spv.SpvSummary, str] = spv.validate(data, len);
    if (R.is_err[spv.SpvSummary, str](r)) {
        ret fuzz.rejected(R.unwrap_err[spv.SpvSummary, str](r));
    }
    ret fuzz.accepted();
}

fun walk_archive(data: *u8, len: usize) R.Result[R.Void, str] {
    if (!ar.is_archive(data, len)) {
        ret R.err[R.Void, str]("fuzz.of: input does not carry the archive magic");
    }
    var pos: usize = ar.first_member();
    var seen: u32 = 0;
    for (seen < AR_MEMBER_CAP) {
        val step: ar.Step = ar.next_member(data, len, pos);
        if (!step.ok)         { ret R.err[R.Void, str]("fuzz.of: archive member is malformed"); }
        if (step.done)        { ret R.ok_void[str](); }
        if (step.next <= pos) { ret R.err[R.Void, str]("fuzz.of: archive walk did not advance"); }
        pos = step.next;
        seen = seen + 1;
    }
    ret R.err[R.Void, str]("fuzz.of: archive member count exceeded the walk bound");
}

fun parse_registered(alloc: *A.Allocator, format: str, data: *u8, len: usize) R.Result[R.Void, str] {
    var itn: intern.Interner = intern.init(alloc);

    var reg: of.OfRegistry = of.registry_init();
    val re: R.Result[R.Void, str] = elf.register(?reg);
    if (R.is_err[R.Void, str](re)) { ret re; }
    val rc: R.Result[R.Void, str] = coff.register_coff(?reg);
    if (R.is_err[R.Void, str](rc)) { ret rc; }
    val rm: R.Result[R.Void, str] = macho.register_macho(?reg);
    if (R.is_err[R.Void, str](rm)) { ret rm; }

    val found: O.Option[*of.OfVTable] = of.lookup(?reg, format);
    if (!O.is_some[*of.OfVTable](found)) {
        ret R.err[R.Void, str]("fuzz.of: no registered object format by that name");
    }
    val vt: *of.OfVTable = O.unwrap[*of.OfVTable](found);
    if (vt.parse_object == nil) {
        ret R.err[R.Void, str]("fuzz.of: the named object format declares no parser");
    }

    var image: of.ObjectImage;
    ret vt.parse_object(alloc, ?itn, data, len, ?image);
}
