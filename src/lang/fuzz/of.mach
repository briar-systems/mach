use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use fuzz: mach.lang.fuzz.verdict;
use mach.lang.intern;
use mach.lang.target.of;
use mach.lang.target.of.ar;
use mach.lang.target.of.coff;
use mach.lang.target.of.elf;
use mach.lang.target.of.macho;
use mach.lang.target.of.spv;

val AR_MEMBER_CAP: u32 = 0xFFFF;

pub fun answer_elf(alloc: *A.Allocator, data: *u8, len: usize) fuzz.Verdict {
    ret fuzz.rejected_if_err(parse_registered(alloc, "elf", data, len));
}

pub fun answer_coff(alloc: *A.Allocator, data: *u8, len: usize) fuzz.Verdict {
    ret fuzz.rejected_if_err(parse_registered(alloc, "coff", data, len));
}

pub fun answer_macho(alloc: *A.Allocator, data: *u8, len: usize) fuzz.Verdict {
    ret fuzz.rejected_if_err(parse_registered(alloc, "macho", data, len));
}

pub fun answer_ar(alloc: *A.Allocator, data: *u8, len: usize) fuzz.Verdict {
    ret fuzz.rejected_if_err(walk_archive(data, len));
}

pub fun answer_spv(alloc: *A.Allocator, data: *u8, len: usize) fuzz.Verdict {
    val r: res[spv.SpvSummary, fail.Fail] = spv.validate(data, len);
    if (sel r.err) {
        ret fuzz.rejected(fail.describe(r.err));
    }
    ret fuzz.accepted();
}

fun walk_archive(data: *u8, len: usize) err[fail.Fail] {
    if (!ar.is_archive(data, len)) {
        ret err[fail.Fail].err{fail.message("fuzz.of: input does not carry the archive magic")};
    }
    var pos: usize = ar.first_member();
    var seen: u32 = 0;
    for (seen < AR_MEMBER_CAP) {
        val step: ar.Step = ar.next_member(data, len, pos);
        if (!step.ok)         { ret err[fail.Fail].err{fail.message("fuzz.of: archive member is malformed")}; }
        if (step.done)        { ret err[fail.Fail].ok{}; }
        if (step.next <= pos) { ret err[fail.Fail].err{fail.message("fuzz.of: archive walk did not advance")}; }
        pos = step.next;
        seen = seen + 1;
    }
    ret err[fail.Fail].err{fail.message("fuzz.of: archive member count exceeded the walk bound")};
}

fun parse_registered(alloc: *A.Allocator, format: str, data: *u8, len: usize) err[fail.Fail] {
    var itn: intern.Interner = intern.init(alloc);

    var reg: of.OfRegistry = of.registry_init();
    val re: err[fail.Fail] = elf.register(?reg);
    if (sel re.err) { ret re; }
    val rc: err[fail.Fail] = coff.register_coff(?reg);
    if (sel rc.err) { ret rc; }
    val rm: err[fail.Fail] = macho.register_macho(?reg);
    if (sel rm.err) { ret rm; }

    val found: opt[*of.OfVTable] = of.lookup(?reg, format);
    if (sel found.none) {
        ret err[fail.Fail].err{fail.message("fuzz.of: no registered object format by that name")};
    }
    val vt: *of.OfVTable = found.some;
    if (vt.parse_object == nil) {
        ret err[fail.Fail].err{fail.message("fuzz.of: the named object format declares no parser")};
    }

    var image: of.ObjectImage;
    ret vt.parse_object(alloc, ?itn, data, len, ?image);
}
