# 128-bit integer carrier over two u64 limbs
#
# the compiler cannot yet spell u128 in its own source, so this module is the
# exact arithmetic behind 128-bit literals, comptime evaluation, constant
# folding and IR constants. every operation is total: wrapping where the name
# says so, flagged where the caller must know, never undefined.
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_region_equals;

use mach.lang.float;

pub rec Wide {
    lo: u64;
    hi: u64;
}

val ALL_ONES: u64 = ~(0::u64);
val TOP_BIT:  u64 = 1::u64 << 63;

pub fun zero() Wide {
    ret Wide{lo: 0, hi: 0};
}

pub fun make(lo: u64, hi: u64) Wide {
    ret Wide{lo: lo, hi: hi};
}

pub fun from_u64(v: u64) Wide {
    ret Wide{lo: v, hi: 0};
}

pub fun from_i64(v: i64) Wide {
    var hi: u64 = 0;
    if (v < 0) { hi = ALL_ONES; }
    ret Wide{lo: v:~u64, hi: hi};
}

pub fun is_zero(a: Wide) bool {
    ret a.lo == 0 && a.hi == 0;
}

pub fun eq(a: Wide, b: Wide) bool {
    ret a.lo == b.lo && a.hi == b.hi;
}

pub fun lt_u(a: Wide, b: Wide) bool {
    if (a.hi != b.hi) { ret a.hi < b.hi; }
    ret a.lo < b.lo;
}

pub fun lt_s(a: Wide, b: Wide) bool {
    if (a.hi != b.hi) { ret (a.hi:~i64) < (b.hi:~i64); }
    ret a.lo < b.lo;
}

pub fun is_negative(a: Wide) bool {
    ret (a.hi & TOP_BIT) != 0;
}

pub fun add(a: Wide, b: Wide) Wide {
    var c: bool;
    ret add_carry(a, b, ?c);
}

pub fun add_carry(a: Wide, b: Wide, carry_out: *bool) Wide {
    val lo:    u64 = a.lo + b.lo;
    var carry: u64 = 0;
    if (lo < a.lo) { carry = 1; }
    val hi1: u64 = a.hi + b.hi;
    val hi:  u64 = hi1 + carry;
    @carry_out = hi1 < a.hi || hi < hi1;
    ret Wide{lo: lo, hi: hi};
}

pub fun sub(a: Wide, b: Wide) Wide {
    var c: bool;
    ret sub_borrow(a, b, ?c);
}

pub fun sub_borrow(a: Wide, b: Wide, borrow_out: *bool) Wide {
    val lo:     u64 = a.lo - b.lo;
    var borrow: u64 = 0;
    if (a.lo < b.lo) { borrow = 1; }
    val hi1: u64 = a.hi - b.hi;
    val hi:  u64 = hi1 - borrow;
    @borrow_out = a.hi < b.hi || hi1 < borrow;
    ret Wide{lo: lo, hi: hi};
}

# the two's complement sum, flagging a signed overflow: both operands share a
# sign the sum does not
pub fun add_signed(a: Wide, b: Wide, overflow_out: *bool) Wide {
    val s: Wide = add(a, b);
    @overflow_out = is_negative(a) == is_negative(b) && is_negative(s) != is_negative(a);
    ret s;
}

# the two's complement difference, flagging a signed overflow: the operands
# differ in sign and the difference does not share the minuend's
pub fun sub_signed(a: Wide, b: Wide, overflow_out: *bool) Wide {
    val d: Wide = sub(a, b);
    @overflow_out = is_negative(a) != is_negative(b) && is_negative(d) != is_negative(a);
    ret d;
}

pub fun neg(a: Wide) Wide {
    ret sub(zero(), a);
}

pub fun max_u() Wide {
    ret Wide{lo: ALL_ONES, hi: ALL_ONES};
}

#[testing]
pub fun max_s() Wide {
    ret Wide{lo: ALL_ONES, hi: ALL_ONES >> 1};
}

pub fun min_s() Wide {
    ret Wide{lo: 0, hi: TOP_BIT};
}

pub fun not(a: Wide) Wide {
    ret Wide{lo: ~a.lo, hi: ~a.hi};
}

pub fun and(a: Wide, b: Wide) Wide {
    ret Wide{lo: a.lo & b.lo, hi: a.hi & b.hi};
}

pub fun or (a: Wide, b: Wide) Wide {
    ret Wide{lo: a.lo | b.lo, hi: a.hi | b.hi};
}

pub fun xor(a: Wide, b: Wide) Wide {
    ret Wide{lo: a.lo ^ b.lo, hi: a.hi ^ b.hi};
}

pub fun mul_u64(a: u64, b: u64) Wide {
    val a0: u64 = a & 0xFFFFFFFF;
    val a1: u64 = a >> 32;
    val b0: u64 = b & 0xFFFFFFFF;
    val b1: u64 = b >> 32;

    val p00: u64 = a0 * b0;
    val p01: u64 = a0 * b1;
    val p10: u64 = a1 * b0;
    val p11: u64 = a1 * b1;

    # the middle column sums two 64-bit partials plus a 32-bit carry-in and
    # cannot overflow: each partial is below 2^64 - 2^33 + 1
    val mid: u64 = (p00 >> 32) + (p01 & 0xFFFFFFFF) + p10;
    val lo:  u64 = (p00 & 0xFFFFFFFF) | (mid << 32);
    val hi:  u64 = p11 + (p01 >> 32) + (mid >> 32);
    ret Wide{lo: lo, hi: hi};
}

pub fun mul(a: Wide, b: Wide) Wide {
    val low: Wide = mul_u64(a.lo, b.lo);
    val hi:  u64  = low.hi + a.lo * b.hi + a.hi * b.lo;
    ret Wide{lo: low.lo, hi: hi};
}

pub fun mul_overflows_u(a: Wide, b: Wide) bool {
    if (a.hi != 0 && b.hi != 0) { ret true; }
    # at most one cross product is live, so their low halves add without carry
    val c1: Wide = mul_u64(a.lo, b.hi);
    val c2: Wide = mul_u64(a.hi, b.lo);
    if (c1.hi != 0 || c2.hi != 0) { ret true; }
    val low: Wide = mul_u64(a.lo, b.lo);
    val hi:  u64  = low.hi + c1.lo + c2.lo;
    ret hi < low.hi;
}

pub fun mul_overflows_s(a: Wide, b: Wide) bool {
    if (is_zero(a) || is_zero(b)) { ret false; }
    var ma: Wide = a;
    var mb: Wide = b;
    if (is_negative(a))          { ma = neg(a); }
    if (is_negative(b))          { mb = neg(b); }
    if (mul_overflows_u(ma, mb)) { ret true; }
    val p:   Wide = mul(ma, mb);
    val min: Wide = Wide{lo: 0, hi: TOP_BIT};
    if (is_negative(a) != is_negative(b)) { ret lt_u(min, p); }
    ret is_negative(p);
}

#[testing]
pub fun mul_high_s64(a: i64, b: i64) i64 {
    val au: u64 = a:~u64;
    val bu: u64 = b:~u64;
    var hi: u64 = mul_u64(au, bu).hi;
    if (a < 0) { hi = hi - bu; }
    if (b < 0) { hi = hi - au; }
    ret hi:~i64;
}

pub fun divmod_u(a: Wide, b: Wide, q: *Wide, r: *Wide) bool {
    if (is_zero(b)) { ret false; }
    if (a.hi == 0 && b.hi == 0) {
        @q = from_u64(a.lo / b.lo);
        @r = from_u64(a.lo % b.lo);
        ret true;
    }
    if (lt_u(a, b)) {
        @q = zero();
        @r = a;
        ret true;
    }
    var quot: Wide = zero();
    var rem:  Wide = zero();
    var i:    u32  = bit_length(a);
    for (i > 0) {
        i   = i - 1;
        rem = shl(rem, 1);
        if (bit(a, i)) { rem.lo = rem.lo | 1; }
        if (!lt_u(rem, b)) {
            rem  = sub(rem, b);
            quot = or (quot, shl(from_u64(1), i));
        }
    }
    @q = quot;
    @r = rem;
    ret true;
}

pub fun divmod_s(a: Wide, b: Wide, q: *Wide, r: *Wide) bool {
    if (is_zero(b)) { ret false; }
    var ma: Wide = a;
    var mb: Wide = b;
    if (is_negative(a)) { ma = neg(a); }
    if (is_negative(b)) { mb = neg(b); }
    var mq: Wide;
    var mr: Wide;
    divmod_u(ma, mb, ?mq, ?mr);
    # MIN / -1 lands here as 2^127 with the sign flip wrapping it back to MIN
    if (is_negative(a) != is_negative(b)) { mq = neg(mq); }
    if (is_negative(a))                   { mr = neg(mr); }
    @q = mq;
    @r = mr;
    ret true;
}

fun bit(a: Wide, i: u32) bool {
    if (i >= 64) { ret ((a.hi >> (i - 64)::u64) & 1) != 0; }
    ret ((a.lo >> i::u64) & 1) != 0;
}

pub fun shl(a: Wide, n: u32) Wide {
    if (n == 0)   { ret a; }
    if (n >= 128) { ret zero(); }
    if (n >= 64)  { ret Wide{lo: 0, hi: a.lo << (n - 64)::u64}; }
    val s: u64 = n::u64;
    ret Wide{lo: a.lo << s, hi: (a.hi << s) | (a.lo >> (64 - s))};
}

pub fun shr_u(a: Wide, n: u32) Wide {
    if (n == 0)   { ret a; }
    if (n >= 128) { ret zero(); }
    if (n >= 64)  { ret Wide{lo: a.hi >> (n - 64)::u64, hi: 0}; }
    val s: u64 = n::u64;
    ret Wide{lo: (a.lo >> s) | (a.hi << (64 - s)), hi: a.hi >> s};
}

pub fun shr_s(a: Wide, n: u32) Wide {
    var fill: u64 = 0;
    if (is_negative(a)) { fill = ALL_ONES; }
    if (n == 0)         { ret a; }
    if (n >= 128)       { ret Wide{lo: fill, hi: fill}; }
    if (n >= 64)        { ret Wide{lo: ((a.hi:~i64) >> (n - 64)::i64):~u64, hi: fill}; }
    val s: u64 = n::u64;
    ret Wide{lo: (a.lo >> s) | (a.hi << (64 - s)), hi: ((a.hi:~i64) >> s::i64):~u64};
}

# all ones in the low `bits` positions, `bits` in 1..128
fun low_mask(bits: u32) Wide {
    if (bits >= 128) { ret Wide{lo: ALL_ONES, hi: ALL_ONES}; }
    if (bits == 64)  { ret Wide{lo: ALL_ONES, hi: 0}; }
    if (bits > 64)   { ret Wide{lo: ALL_ONES, hi: (1::u64 << (bits - 64)::u64) - 1}; }
    ret Wide{lo: (1::u64 << bits::u64) - 1, hi: 0};
}

pub fun trunc(a: Wide, bits: u32) Wide {
    ret and(a, low_mask(bits));
}

pub fun sext(a: Wide, bits: u32) Wide {
    val mask: Wide = low_mask(bits);
    val t:    Wide = and(a, mask);
    if (bits >= 128 || !bit(t, bits - 1)) { ret t; }
    ret or (t, not(mask));
}

pub fun fits_unsigned(a: Wide, bits: u32) bool {
    ret is_zero(shr_u(a, bits));
}

#[testing]
pub fun fits_signed(a: Wide, bits: u32) bool {
    ret eq(sext(a, bits), a);
}

fun bit_length_u64(v: u64) u32 {
    var n: u32 = 0;
    var x: u64 = v;
    for (x != 0) {
        x = x >> 1;
        n = n + 1;
    }
    ret n;
}

fun trailing_zeros_u64(v: u64) u32 {
    if (v == 0) { ret 64; }
    var n: u32 = 0;
    var x: u64 = v;
    for ((x & 1) == 0) {
        x = x >> 1;
        n = n + 1;
    }
    ret n;
}

pub fun bit_length(a: Wide) u32 {
    if (a.hi != 0) { ret 64 + bit_length_u64(a.hi); }
    ret bit_length_u64(a.lo);
}

pub fun trailing_zeros(a: Wide) u32 {
    if (a.lo != 0) { ret trailing_zeros_u64(a.lo); }
    ret 64 + trailing_zeros_u64(a.hi);
}

pub fun is_pow2(a: Wide) bool {
    if (is_zero(a)) { ret false; }
    ret is_zero(and(a, sub(a, from_u64(1))));
}

pub fun mul_add_small(a: Wide, m: u64, d: u64, overflow: *bool) Wide {
    val mw: Wide = from_u64(m);
    if (mul_overflows_u(a, mw)) {
        @overflow = true;
        ret zero();
    }
    ret add_carry(mul(a, mw), from_u64(d), overflow);
}

pub fun to_f64_u(a: Wide) f64 {
    val bl: u32 = bit_length(a);
    if (bl == 0) { ret 0.0; }
    var exp:  u64 = (bl - 1)::u64;
    var mant: u64;
    if (bl <= 53) {
        mant = shl(a, 53 - bl).lo;
    }
    or {
        # keep the top 53 bits, then round half to even on what fell below
        val shift: u32 = bl - 53;
        mant = shr_u(a, shift).lo;
        val rem:  Wide = trunc(a, shift);
        val half: Wide = shl(from_u64(1), shift - 1);
        if (lt_u(half, rem) || (eq(rem, half) && (mant & 1) != 0)) {
            mant = mant + 1;
            if (mant == (1::u64 << 53)) {
                mant = mant >> 1;
                exp  = exp + 1;
            }
        }
    }
    ret float.bits_f64(((exp + 1023) << 52) | (mant & 0xFFFFFFFFFFFFF));
}

pub fun to_f64_s(a: Wide) f64 {
    if (!is_negative(a)) { ret to_f64_u(a); }
    ret float.f64_neg(to_f64_u(neg(a)));
}

# magnitude of a finite f64 truncated toward zero, saturating at all ones
# for any magnitude of 2^128 or more; `sat` reports that the cap was hit
fun f64_magnitude(f: f64, sat: *bool) Wide {
    val bits: u64 = float.f64_bits(f);
    val exp:  u64 = (bits >> 52) & 0x7FF;
    val frac: u64 = bits & 0xFFFFFFFFFFFFF;
    @sat = false;
    if (exp < 1023) { ret zero(); }
    val e: u32 = (exp - 1023)::u32;
    if (e >= 128) {
        @sat = true;
        ret Wide{lo: ALL_ONES, hi: ALL_ONES};
    }
    val mant: u64 = frac | (1::u64 << 52);
    if (e >= 52) { ret shl(from_u64(mant), e - 52); }
    ret from_u64(mant >> (52 - e)::u64);
}

fun f64_is_nan(f: f64) bool {
    val bits: u64 = float.f64_bits(f);
    ret ((bits >> 52) & 0x7FF) == 0x7FF && (bits & 0xFFFFFFFFFFFFF) != 0;
}

pub fun from_f64_u(f: f64) Wide {
    if (f64_is_nan(f) || float.f64_signbit(f)) { ret zero(); }
    var sat: bool;
    ret f64_magnitude(f, ?sat);
}

pub fun from_f64_s(f: f64) Wide {
    if (f64_is_nan(f)) { ret zero(); }
    var sat: bool;
    val mag: Wide = f64_magnitude(f, ?sat);
    val min: Wide = Wide{lo: 0, hi: TOP_BIT};
    if (float.f64_signbit(f)) {
        if (sat || lt_u(min, mag)) { ret min; }
        ret neg(mag);
    }
    if (sat || !lt_u(mag, min)) { ret Wide{lo: ALL_ONES, hi: TOP_BIT - 1}; }
    ret mag;
}

pub fun format_u(a: Wide, buf: *u8, cap: usize) usize {
    if (cap < 39) { ret 0; }
    var tmp: [39]u8;
    var n:   usize = 0;
    var cur: Wide  = a;
    val ten: Wide  = from_u64(10);
    if (is_zero(cur)) {
        tmp[0] = '0';
        n      = 1;
    }
    for (!is_zero(cur)) {
        var q: Wide;
        var r: Wide;
        divmod_u(cur, ten, ?q, ?r);
        tmp[n] = '0' + r.lo::u8;
        n      = n + 1;
        cur    = q;
    }
    var i: usize = 0;
    for (i < n) {
        buf[i] = tmp[n - 1 - i];
        i      = i + 1;
    }
    ret n;
}

pub fun format_s(a: Wide, buf: *u8, cap: usize) usize {
    if (!is_negative(a)) { ret format_u(a, buf, cap); }
    if (cap < 40)        { ret 0; }
    buf[0] = '-';
    val n: usize = format_u(neg(a), ?buf[1], cap - 1);
    if (n == 0) { ret 0; }
    ret n + 1;
}

#[testing]
pub fun format_hex(a: Wide, buf: *u8, cap: usize) usize {
    if (cap < 32) { ret 0; }
    val digits: str = "0123456789abcdef";
    if (is_zero(a)) {
        buf[0] = '0';
        ret 1;
    }
    var nibbles: u32   = (bit_length(a) + 3) / 4;
    var n:       usize = 0;
    for (nibbles > 0) {
        nibbles = nibbles - 1;
        val v: u64 = shr_u(a, nibbles * 4).lo & 0xF;
        buf[n] = digits[v];
        n      = n + 1;
    }
    ret n;
}

# room for any formatted value: a sign, 39 decimal digits and the terminator
pub val FORMAT_CAP: usize = 41;

# the decimal text of an unsigned value, terminated, in a FORMAT_CAP buffer
pub fun text_u(a: Wide, buf: *u8) str {
    val n: usize = format_u(a, buf, FORMAT_CAP);
    buf[n] = 0;
    ret buf::str;
}

# the decimal text of a signed value, terminated, in a FORMAT_CAP buffer
pub fun text_s(a: Wide, buf: *u8) str {
    val n: usize = format_s(a, buf, FORMAT_CAP);
    buf[n] = 0;
    ret buf::str;
}

#[testing]
fun digit_value(c: u8) u32 {
    if (c >= '0' && c <= '9') { ret (c - '0')::u32; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a')::u32 + 10; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A')::u32 + 10; }
    ret 0xFF;
}

#[testing]
pub fun parse_u(text: *u8, len: usize, base: u32, out: *Wide) bool {
    var acc:    Wide  = zero();
    var digits: usize = 0;
    var i:      usize = 0;
    for (i < len) {
        val c: u8 = text[i];
        i = i + 1;
        if (c == '_') { cnt; }
        val d: u32 = digit_value(c);
        if (d >= base) { ret false; }
        var overflow: bool;
        acc = mul_add_small(acc, base::u64, d::u64, ?overflow);
        if (overflow) { ret false; }
        digits = digits + 1;
    }
    if (digits == 0) { ret false; }
    @out = acc;
    ret true;
}

#[testing]
fun t_wide(lo: u64, hi: u64) Wide {
    ret Wide{lo: lo, hi: hi};
}

#[testing]
fun t_min() Wide {
    ret Wide{lo: 0, hi: TOP_BIT};
}

#[testing]
fun t_max_s() Wide {
    ret Wide{lo: ALL_ONES, hi: TOP_BIT - 1};
}

#[testing]
fun t_max_u() Wide {
    ret Wide{lo: ALL_ONES, hi: ALL_ONES};
}

#[testing]
fun t_format_u_is(a: Wide, expect: str) bool {
    var buf: [40]u8;
    val n:   usize = format_u(a, ?buf[0], 40);
    ret n != 0 && str_region_equals(?buf[0], 0, n, expect);
}

#[testing]
fun t_format_s_is(a: Wide, expect: str) bool {
    var buf: [40]u8;
    val n:   usize = format_s(a, ?buf[0], 40);
    ret n != 0 && str_region_equals(?buf[0], 0, n, expect);
}

#[testing]
fun t_format_hex_is(a: Wide, expect: str) bool {
    var buf: [32]u8;
    val n:   usize = format_hex(a, ?buf[0], 32);
    ret n != 0 && str_region_equals(?buf[0], 0, n, expect);
}

#[testing]
fun t_parse_is(text: str, len: usize, base: u32, expect: Wide) bool {
    var got: Wide;
    if (!parse_u(text, len, base, ?got)) { ret false; }
    ret eq(got, expect);
}

test add__lane_carry_and_flags {
    var c: bool;
    val r: Wide = add_carry(from_u64(ALL_ONES), from_u64(1), ?c);
    if (!eq(r, t_wide(0, 1)) || c) { ret 1; }
    val w: Wide = add_carry(t_max_u(), from_u64(1), ?c);
    if (!is_zero(w) || !c) { ret 2; }
    val hi: Wide = add_carry(t_wide(ALL_ONES, ALL_ONES - 1), from_u64(1), ?c);
    if (!eq(hi, t_wide(0, ALL_ONES)) || c) { ret 3; }
    val both: Wide = add_carry(t_max_u(), t_max_u(), ?c);
    if (!eq(both, t_wide(ALL_ONES - 1, ALL_ONES)) || !c) { ret 4; }
    if (!eq(add(from_i64(-1), from_u64(1)), zero()))     { ret 5; }
    ret 0;
}

test sub__lane_borrow_and_flags {
    var b: bool;
    val r: Wide = sub_borrow(t_wide(0, 1), from_u64(1), ?b);
    if (!eq(r, from_u64(ALL_ONES)) || b) { ret 1; }
    val u: Wide = sub_borrow(zero(), from_u64(1), ?b);
    if (!eq(u, t_max_u()) || !b) { ret 2; }
    val e: Wide = sub_borrow(t_wide(5, 7), t_wide(5, 7), ?b);
    if (!is_zero(e) || b) { ret 3; }
    val cross: Wide = sub_borrow(t_wide(0, 7), t_wide(1, 6), ?b);
    if (!eq(cross, from_u64(ALL_ONES)) || b) { ret 4; }
    ret 0;
}

test add_signed__overflow_edges {
    var o: bool;
    if (!eq(add_signed(t_max_s(), from_u64(1), ?o), t_min()) || !o)                     { ret 1; }
    if (!eq(add_signed(t_min(), from_i64(-1), ?o), t_max_s()) || !o)                    { ret 2; }
    if (!eq(add_signed(t_max_s(), from_i64(-1), ?o), sub(t_max_s(), from_u64(1))) || o) { ret 3; }
    if (!eq(add_signed(from_i64(-3), from_i64(-4), ?o), from_i64(-7)) || o)             { ret 4; }
    if (!eq(add_signed(t_min(), t_max_s(), ?o), from_i64(-1)) || o)                     { ret 5; }
    ret 0;
}

test sub_signed__overflow_edges {
    var o: bool;
    if (!eq(sub_signed(t_min(), from_u64(1), ?o), t_max_s()) || !o)        { ret 1; }
    if (!eq(sub_signed(t_max_s(), from_i64(-1), ?o), t_min()) || !o)       { ret 2; }
    if (!eq(sub_signed(from_i64(-3), from_i64(-4), ?o), from_u64(1)) || o) { ret 3; }
    if (!eq(sub_signed(zero(), t_min(), ?o), t_min()) || !o)               { ret 4; }
    if (!eq(sub_signed(from_i64(-1), t_max_s(), ?o), t_min()) || o)        { ret 5; }
    ret 0;
}

test lt__signed_and_unsigned_orders {
    if (!lt_u(from_u64(1), t_wide(0, 1)))  { ret 1; }
    if (lt_u(t_max_u(), zero()))           { ret 2; }
    if (!lt_s(t_max_u(), zero()))          { ret 3; }
    if (!lt_s(t_min(), t_max_s()))         { ret 4; }
    if (lt_s(t_max_s(), t_min()))          { ret 5; }
    if (!lt_s(from_i64(-2), from_i64(-1))) { ret 6; }
    if (lt_s(from_i64(-1), from_i64(-1)))  { ret 7; }
    if (!lt_u(t_max_s(), t_min()))         { ret 8; }
    ret 0;
}

test shl__boundaries {
    val one: Wide = from_u64(1);
    val a:   Wide = t_wide(0x8000000000000001, 0x1);
    if (!eq(shl(a, 0), a))                                            { ret 1; }
    if (!eq(shl(a, 1), t_wide(0x2, 0x3)))                             { ret 2; }
    if (!eq(shl(one, 63), t_wide(TOP_BIT, 0)))                        { ret 3; }
    if (!eq(shl(one, 64), t_wide(0, 1)))                              { ret 4; }
    if (!eq(shl(a, 64), t_wide(0, 0x8000000000000001)))               { ret 5; }
    if (!eq(shl(a, 65), t_wide(0, 0x2)))                              { ret 6; }
    if (!eq(shl(one, 127), t_min()))                                  { ret 7; }
    if (!is_zero(shl(t_max_u(), 128)))                                { ret 8; }
    if (!is_zero(shl(t_max_u(), 200)))                                { ret 9; }
    if (!eq(shl(t_wide(ALL_ONES, 0), 4), t_wide(ALL_ONES << 4, 0xF))) { ret 10; }
    ret 0;
}

test shr_u__boundaries {
    val a: Wide = t_wide(0x1, 0x8000000000000001);
    if (!eq(shr_u(a, 0), a))                                   { ret 1; }
    if (!eq(shr_u(a, 1), t_wide(TOP_BIT, 0x4000000000000000))) { ret 2; }
    if (!eq(shr_u(t_min(), 63), t_wide(0, 1)))                 { ret 3; }
    if (!eq(shr_u(a, 64), t_wide(0x8000000000000001, 0)))      { ret 4; }
    if (!eq(shr_u(a, 65), t_wide(0x4000000000000000, 0)))      { ret 5; }
    if (!eq(shr_u(t_max_u(), 127), from_u64(1)))               { ret 6; }
    if (!is_zero(shr_u(t_max_u(), 128)))                       { ret 7; }
    if (!is_zero(shr_u(t_max_u(), 200)))                       { ret 8; }
    ret 0;
}

test shr_s__sign_fill {
    val n: Wide = t_wide(0x1, 0x8000000000000001);
    if (!eq(shr_s(n, 0), n))                                     { ret 1; }
    if (!eq(shr_s(n, 1), t_wide(TOP_BIT, 0xC000000000000000)))   { ret 2; }
    if (!eq(shr_s(t_min(), 63), t_wide(0, ALL_ONES)))            { ret 3; }
    if (!eq(shr_s(n, 64), t_wide(0x8000000000000001, ALL_ONES))) { ret 4; }
    if (!eq(shr_s(n, 65), t_wide(0xC000000000000000, ALL_ONES))) { ret 5; }
    if (!eq(shr_s(t_min(), 127), t_max_u()))                     { ret 6; }
    if (!eq(shr_s(t_min(), 128), t_max_u()))                     { ret 7; }
    if (!eq(shr_s(t_min(), 200), t_max_u()))                     { ret 8; }
    val p: Wide = t_wide(0x1, 0x4000000000000001);
    if (!eq(shr_s(p, 64), from_u64(0x4000000000000001))) { ret 9; }
    if (!is_zero(shr_s(p, 128)))                         { ret 10; }
    if (!eq(shr_s(p, 1), shr_u(p, 1)))                   { ret 11; }
    ret 0;
}

test mul_u64__full_product {
    val sq: Wide = mul_u64(ALL_ONES, ALL_ONES);
    if (!eq(sq, t_wide(0x1, 0xFFFFFFFFFFFFFFFE)))                           { ret 1; }
    if (!eq(mul_u64(TOP_BIT, 2), t_wide(0, 1)))                             { ret 2; }
    if (!eq(mul_u64(0x123456789ABCDEF0, 0), zero()))                        { ret 3; }
    if (!eq(mul_u64(0x100000000, 0x100000000), t_wide(0, 1)))               { ret 4; }
    if (!eq(mul_u64(0xFFFFFFFF, 0xFFFFFFFF), from_u64(0xFFFFFFFE00000001))) { ret 5; }
    ret 0;
}

test mul__wrapping_and_overflow_flags {
    val two64: Wide = t_wide(0, 1);
    if (!is_zero(mul(two64, two64)))                              { ret 1; }
    if (!mul_overflows_u(two64, two64))                           { ret 2; }
    if (mul_overflows_u(two64, from_u64(ALL_ONES)))               { ret 3; }
    if (!eq(mul(two64, from_u64(ALL_ONES)), t_wide(0, ALL_ONES))) { ret 4; }
    if (!mul_overflows_u(t_wide(0, 2), from_u64(TOP_BIT)))        { ret 5; }
    if (mul_overflows_u(t_wide(0, 1), from_u64(TOP_BIT)))         { ret 6; }
    if (!mul_overflows_u(t_max_u(), from_u64(2)))                 { ret 7; }
    if (mul_overflows_u(t_max_u(), from_u64(1)))                  { ret 8; }
    if (mul_overflows_u(t_max_u(), zero()))                       { ret 9; }
    if (!eq(mul(t_max_u(), t_max_u()), from_u64(1)))              { ret 10; }
    if (!eq(mul(from_i64(-3), from_i64(7)), from_i64(-21)))       { ret 11; }
    # a spill from the low product carries into the middle column
    val a: Wide = t_wide(0xFFFFFFFFFFFFFFFF, 0x1);
    val b: Wide = from_u64(0xFFFFFFFFFFFFFFFF);
    if (!eq(mul(a, b), t_wide(0x1, 0xFFFFFFFFFFFFFFFD))) { ret 12; }
    if (!mul_overflows_u(a, b))                          { ret 13; }
    ret 0;
}

test mul_overflows_s__edges {
    if (mul_overflows_s(t_min(), from_u64(1)))                        { ret 1; }
    if (!mul_overflows_s(t_min(), from_i64(-1)))                      { ret 2; }
    if (mul_overflows_s(t_max_s(), from_i64(-1)))                     { ret 3; }
    if (!mul_overflows_s(t_max_s(), from_u64(2)))                     { ret 4; }
    if (mul_overflows_s(t_wide(0, 0x4000000000000000), from_i64(-2))) { ret 5; }
    if (!mul_overflows_s(t_wide(0, 0x4000000000000000), from_u64(2))) { ret 6; }
    if (mul_overflows_s(t_min(), zero()))                             { ret 7; }
    if (mul_overflows_s(from_i64(-3), from_i64(-7)))                  { ret 8; }
    if (!mul_overflows_s(t_min(), t_min()))                           { ret 9; }
    if (!mul_overflows_s(from_i64(-1), t_min()))                      { ret 10; }
    ret 0;
}

test mul_high_s64__negative_operands {
    if (mul_high_s64(-1, 1) != -1) { ret 1; }
    if (mul_high_s64(1, -1) != -1) { ret 2; }
    if (mul_high_s64(-1, -1) != 0) { ret 3; }
    val min: i64 = TOP_BIT:~i64;
    if (mul_high_s64(min, min) != 0x4000000000000000)                               { ret 4; }
    if (mul_high_s64(min, 2) != -1)                                                 { ret 5; }
    if (mul_high_s64(min, -2) != 1)                                                 { ret 6; }
    if (mul_high_s64(0x7FFFFFFFFFFFFFFF, 0x7FFFFFFFFFFFFFFF) != 0x3FFFFFFFFFFFFFFF) { ret 7; }
    if (mul_high_s64(0x100000000, 0x100000000) != 1)                                { ret 8; }
    ret 0;
}

test divmod_u__wide_divisors_and_zero {
    var q: Wide;
    var r: Wide;
    if (divmod_u(from_u64(5), zero(), ?q, ?r))        { ret 1; }
    if (!divmod_u(from_u64(17), from_u64(5), ?q, ?r)) { ret 2; }
    if (!eq(q, from_u64(3)) || !eq(r, from_u64(2)))   { ret 3; }
    val a: Wide = t_wide(0x5, 0x10);
    val b: Wide = t_wide(0x0, 0x3);
    if (!divmod_u(a, b, ?q, ?r))                                                       { ret 4; }
    if (!eq(q, from_u64(5)) || !eq(r, t_wide(0x5, 0x1)))                               { ret 5; }
    if (!divmod_u(from_u64(7), b, ?q, ?r))                                             { ret 6; }
    if (!is_zero(q) || !eq(r, from_u64(7)))                                            { ret 7; }
    if (!divmod_u(t_max_u(), from_u64(10), ?q, ?r))                                    { ret 8; }
    if (!eq(q, t_wide(0x9999999999999999, 0x1999999999999999)) || !eq(r, from_u64(5))) { ret 9; }
    if (!divmod_u(t_max_u(), t_max_u(), ?q, ?r))                                       { ret 10; }
    if (!eq(q, from_u64(1)) || !is_zero(r))                                            { ret 11; }
    if (!divmod_u(t_wide(0, 1), from_u64(3), ?q, ?r))                                  { ret 12; }
    if (!eq(q, from_u64(0x5555555555555555)) || !eq(r, from_u64(1)))                   { ret 13; }
    ret 0;
}

test divmod_s__truncation_and_min {
    var q: Wide;
    var r: Wide;
    if (divmod_s(from_u64(5), zero(), ?q, ?r))                { ret 1; }
    if (!divmod_s(t_min(), from_i64(-1), ?q, ?r))             { ret 2; }
    if (!eq(q, t_min()) || !is_zero(r))                       { ret 3; }
    if (!divmod_s(from_i64(-7), from_i64(2), ?q, ?r))         { ret 4; }
    if (!eq(q, from_i64(-3)) || !eq(r, from_i64(-1)))         { ret 5; }
    if (!divmod_s(from_i64(7), from_i64(-2), ?q, ?r))         { ret 6; }
    if (!eq(q, from_i64(-3)) || !eq(r, from_i64(1)))          { ret 7; }
    if (!divmod_s(from_i64(-7), from_i64(-2), ?q, ?r))        { ret 8; }
    if (!eq(q, from_i64(3)) || !eq(r, from_i64(-1)))          { ret 9; }
    if (!divmod_s(t_min(), from_i64(2), ?q, ?r))              { ret 10; }
    if (!eq(q, t_wide(0, 0xC000000000000000)) || !is_zero(r)) { ret 11; }
    if (!divmod_s(t_min(), t_max_s(), ?q, ?r))                { ret 12; }
    if (!eq(q, from_i64(-1)) || !eq(r, from_i64(-1)))         { ret 13; }
    ret 0;
}

test trunc__widths {
    val a: Wide = t_max_u();
    if (!eq(trunc(a, 1), from_u64(1)))                      { ret 1; }
    if (!eq(trunc(a, 8), from_u64(0xFF)))                   { ret 2; }
    if (!eq(trunc(a, 64), from_u64(ALL_ONES)))              { ret 3; }
    if (!eq(trunc(a, 65), t_wide(ALL_ONES, 1)))             { ret 4; }
    if (!eq(trunc(a, 127), t_max_s()))                      { ret 5; }
    if (!eq(trunc(a, 128), a))                              { ret 6; }
    if (!eq(trunc(t_wide(0x1FE, 0xFF), 8), from_u64(0xFE))) { ret 7; }
    ret 0;
}

test sext__widths {
    if (!eq(sext(from_u64(1), 1), t_max_u()))                            { ret 1; }
    if (!is_zero(sext(from_u64(2), 1)))                                  { ret 2; }
    if (!eq(sext(from_u64(0x80), 8), from_i64(-128)))                    { ret 3; }
    if (!eq(sext(from_u64(0x7F), 8), from_u64(0x7F)))                    { ret 4; }
    if (!eq(sext(from_u64(TOP_BIT), 64), t_wide(TOP_BIT, ALL_ONES)))     { ret 5; }
    if (!eq(sext(t_wide(TOP_BIT, 0xFF), 64), t_wide(TOP_BIT, ALL_ONES))) { ret 6; }
    if (!eq(sext(t_wide(0, 1), 65), t_wide(0, ALL_ONES)))                { ret 7; }
    if (!eq(sext(t_wide(5, 0xFE), 65), from_u64(5)))                     { ret 8; }
    if (!eq(sext(t_min(), 128), t_min()))                                { ret 9; }
    if (!eq(sext(t_max_s(), 128), t_max_s()))                            { ret 10; }
    ret 0;
}

test fits__every_edge {
    val two63:  Wide = from_u64(TOP_BIT);
    val two63m: Wide = from_u64(TOP_BIT - 1);
    val neg63:  Wide = t_wide(TOP_BIT, ALL_ONES);
    if (!fits_unsigned(two63, 64) || fits_unsigned(two63, 63))               { ret 1; }
    if (fits_signed(two63, 64) || !fits_signed(two63, 65))                   { ret 2; }
    if (!fits_signed(two63m, 64) || !fits_unsigned(two63m, 63))              { ret 3; }
    if (!fits_signed(neg63, 64) || fits_signed(neg63, 63))                   { ret 4; }
    if (fits_unsigned(neg63, 64) || fits_unsigned(neg63, 127))               { ret 5; }
    if (!fits_signed(t_max_s(), 128) || fits_signed(t_max_s(), 127))         { ret 6; }
    if (!fits_unsigned(t_max_s(), 127))                                      { ret 7; }
    if (!fits_signed(t_min(), 128) || fits_signed(t_min(), 127))             { ret 8; }
    if (!fits_unsigned(t_max_u(), 128) || fits_unsigned(t_max_u(), 127))     { ret 9; }
    if (!fits_signed(t_max_u(), 1))                                          { ret 10; }
    if (!fits_unsigned(from_u64(1), 1) || fits_unsigned(from_u64(2), 1))     { ret 11; }
    if (!fits_signed(from_i64(-1), 1) || fits_signed(from_u64(1), 1))        { ret 12; }
    if (!fits_signed(from_i64(-128), 8) || fits_signed(from_i64(-129), 8))   { ret 13; }
    if (!fits_signed(from_u64(127), 8) || fits_signed(from_u64(128), 8))     { ret 14; }
    if (!fits_unsigned(from_u64(255), 8) || fits_unsigned(from_u64(256), 8)) { ret 15; }
    ret 0;
}

test bit_length__and_trailing_zeros {
    if (bit_length(zero()) != 0)                  { ret 1; }
    if (bit_length(from_u64(1)) != 1)             { ret 2; }
    if (bit_length(from_u64(ALL_ONES)) != 64)     { ret 3; }
    if (bit_length(t_wide(0, 1)) != 65)           { ret 4; }
    if (bit_length(t_min()) != 128)               { ret 5; }
    if (trailing_zeros(zero()) != 128)            { ret 6; }
    if (trailing_zeros(from_u64(1)) != 0)         { ret 7; }
    if (trailing_zeros(t_wide(0, 1)) != 64)       { ret 8; }
    if (trailing_zeros(t_min()) != 127)           { ret 9; }
    if (trailing_zeros(t_wide(TOP_BIT, 5)) != 63) { ret 10; }
    ret 0;
}

test mul_add_small__exact_and_overflow {
    var ov: bool;
    val r:  Wide = mul_add_small(from_u64(ALL_ONES), 16, 15, ?ov);
    if (ov || !eq(r, t_wide(ALL_ONES, 0xF))) { ret 1; }
    mul_add_small(t_max_u(), 2, 0, ?ov);
    if (!ov) { ret 2; }
    mul_add_small(t_max_u(), 1, 1, ?ov);
    if (!ov) { ret 3; }
    val keep: Wide = mul_add_small(t_max_u(), 1, 0, ?ov);
    if (ov || !eq(keep, t_max_u())) { ret 4; }
    val top: Wide = mul_add_small(t_wide(0x9999999999999999, 0x1999999999999999), 10, 5, ?ov);
    if (ov || !eq(top, t_max_u())) { ret 5; }
    mul_add_small(t_wide(0x9999999999999999, 0x1999999999999999), 10, 6, ?ov);
    if (!ov) { ret 6; }
    ret 0;
}

test to_f64__correct_rounding {
    if (to_f64_u(zero()) != 0.0)                                    { ret 1; }
    if (to_f64_u(from_u64(1)) != 1.0)                               { ret 2; }
    if (to_f64_u(from_u64(0x20000000000000)) != 9007199254740992.0) { ret 3; }
    # 2^64 + 1 is a non-tie below half an ulp: rounds down to 2^64
    val two64: f64 = float.bits_f64(0x43F0000000000000);
    if (to_f64_u(t_wide(1, 1)) != two64) { ret 4; }
    # 2^64 + 2^11 is a tie with an even mantissa: stays at 2^64
    if (to_f64_u(t_wide(0x800, 1)) != two64) { ret 5; }
    # 2^64 + 2^11 + 1 is above the tie: rounds up one ulp
    val two64_up: f64 = float.bits_f64(0x43F0000000000001);
    if (to_f64_u(t_wide(0x801, 1)) != two64_up) { ret 6; }
    # 2^64 + 3 * 2^11 is a tie with an odd mantissa: rounds up to even
    val two64_up2: f64 = float.bits_f64(0x43F0000000000002);
    if (to_f64_u(t_wide(0x1800, 1)) != two64_up2) { ret 7; }
    # 2^127 + 2^74 is a tie with an even mantissa: stays at 2^127
    val two127: f64 = float.bits_f64(0x47E0000000000000);
    if (to_f64_u(t_wide(0, TOP_BIT | (1::u64 << 10))) != two127)                             { ret 8; }
    if (to_f64_u(t_wide(1, TOP_BIT | (1::u64 << 10))) != float.bits_f64(0x47E0000000000001)) { ret 9; }
    # 2^128 - 1 rounds up to 2^128
    if (to_f64_u(t_max_u()) != float.bits_f64(0x47F0000000000000)) { ret 10; }
    # a value below the rounding point in the top limb only rounds down
    if (to_f64_u(t_wide(ALL_ONES, TOP_BIT | 0x3FF)) != two127)      { ret 11; }
    if (to_f64_s(from_i64(-1)) != -1.0)                             { ret 12; }
    if (to_f64_s(t_min()) != float.f64_neg(two127))                 { ret 13; }
    if (to_f64_s(t_max_s()) != two127)                              { ret 14; }
    if (to_f64_s(neg(t_wide(0x801, 1))) != float.f64_neg(two64_up)) { ret 15; }
    ret 0;
}

test from_f64__truncation_and_saturation {
    val two64:  f64 = float.bits_f64(0x43F0000000000000);
    val two127: f64 = float.bits_f64(0x47E0000000000000);
    val two128: f64 = float.bits_f64(0x47F0000000000000);
    val inf:    f64 = float.bits_f64(0x7FF0000000000000);
    val nan:    f64 = float.bits_f64(0x7FF8000000000000);
    if (!is_zero(from_f64_u(0.0)))                                                          { ret 1; }
    if (!is_zero(from_f64_u(0.999)))                                                        { ret 2; }
    if (!eq(from_f64_u(1.0), from_u64(1)))                                                  { ret 3; }
    if (!eq(from_f64_u(3.99), from_u64(3)))                                                 { ret 4; }
    if (!is_zero(from_f64_u(-3.5)))                                                         { ret 5; }
    if (!is_zero(from_f64_u(nan)))                                                          { ret 6; }
    if (!eq(from_f64_u(two64), t_wide(0, 1)))                                               { ret 7; }
    if (!eq(from_f64_u(two127), t_min()))                                                   { ret 8; }
    if (!eq(from_f64_u(two128), t_max_u()))                                                 { ret 9; }
    if (!eq(from_f64_u(inf), t_max_u()))                                                    { ret 10; }
    if (!eq(from_f64_u(9007199254740992.0), from_u64(0x20000000000000)))                    { ret 11; }
    if (!eq(from_f64_s(-3.99), from_i64(-3)))                                               { ret 12; }
    if (!is_zero(from_f64_s(-0.5)))                                                         { ret 13; }
    if (!is_zero(from_f64_s(nan)))                                                          { ret 14; }
    if (!eq(from_f64_s(float.f64_neg(two127)), t_min()))                                    { ret 15; }
    if (!eq(from_f64_s(float.f64_neg(two128)), t_min()))                                    { ret 16; }
    if (!eq(from_f64_s(float.f64_neg(inf)), t_min()))                                       { ret 17; }
    if (!eq(from_f64_s(two127), t_max_s()))                                                 { ret 18; }
    if (!eq(from_f64_s(inf), t_max_s()))                                                    { ret 19; }
    if (!eq(from_f64_s(float.bits_f64(0x47DFFFFFFFFFFFFF)), t_wide(0, 0x7FFFFFFFFFFFFC00))) { ret 20; }
    if (!eq(from_f64_s(float.f64_neg(two64)), neg(t_wide(0, 1))))                           { ret 21; }
    ret 0;
}

test format_u__decimal {
    if (!t_format_u_is(zero(), "0"))                                          { ret 1; }
    if (!t_format_u_is(from_u64(1234567890), "1234567890"))                   { ret 2; }
    if (!t_format_u_is(from_u64(ALL_ONES), "18446744073709551615"))           { ret 3; }
    if (!t_format_u_is(t_wide(0, 1), "18446744073709551616"))                 { ret 4; }
    if (!t_format_u_is(t_max_u(), "340282366920938463463374607431768211455")) { ret 5; }
    if (!t_format_u_is(t_min(), "170141183460469231731687303715884105728"))   { ret 6; }
    var small: [8]u8;
    if (format_u(from_u64(1), ?small[0], 8) != 0) { ret 7; }
    ret 0;
}

test format_s__sign {
    if (!t_format_s_is(zero(), "0"))                                          { ret 1; }
    if (!t_format_s_is(from_i64(-1), "-1"))                                   { ret 2; }
    if (!t_format_s_is(from_i64(42), "42"))                                   { ret 3; }
    if (!t_format_s_is(t_min(), "-170141183460469231731687303715884105728"))  { ret 4; }
    if (!t_format_s_is(t_max_s(), "170141183460469231731687303715884105727")) { ret 5; }
    var small: [39]u8;
    if (format_s(from_i64(-1), ?small[0], 39) != 0) { ret 6; }
    ret 0;
}

test format_hex__no_leading_zeros {
    if (!t_format_hex_is(zero(), "0"))                                            { ret 1; }
    if (!t_format_hex_is(from_u64(0xABC), "abc"))                                 { ret 2; }
    if (!t_format_hex_is(t_wide(0, 1), "10000000000000000"))                      { ret 3; }
    if (!t_format_hex_is(t_wide(0x0123456789ABCDEF, 0x10), "100123456789abcdef")) { ret 4; }
    if (!t_format_hex_is(t_max_u(), "ffffffffffffffffffffffffffffffff"))          { ret 5; }
    if (!t_format_hex_is(t_min(), "80000000000000000000000000000000"))            { ret 6; }
    ret 0;
}

test parse_u__bases_separators_and_overflow {
    var out: Wide;
    if (!t_parse_is("0", 1, 10, zero()))                                           { ret 1; }
    if (!t_parse_is("1_000_000", 9, 10, from_u64(1000000)))                        { ret 2; }
    if (!t_parse_is("340282366920938463463374607431768211455", 39, 10, t_max_u())) { ret 3; }
    if (parse_u("340282366920938463463374607431768211456", 39, 10, ?out))          { ret 4; }
    if (parse_u("3402823669209384634633746074317682114550", 40, 10, ?out))         { ret 5; }
    if (!t_parse_is("ffffffffffffffffffffffffffffffff", 32, 16, t_max_u()))        { ret 6; }
    if (!t_parse_is("8000_0000_0000_0000_0000_0000_0000_0000", 39, 16, t_min()))   { ret 7; }
    if (parse_u("1_0000_0000_0000_0000_0000_0000_0000_0000", 41, 16, ?out))        { ret 8; }
    if (!t_parse_is("DeadBeef", 8, 16, from_u64(0xDEADBEEF)))                      { ret 9; }
    if (!t_parse_is("1010_1010", 9, 2, from_u64(0xAA)))                            { ret 10; }
    if (parse_u("102", 3, 2, ?out))                                                { ret 11; }
    if (!t_parse_is("777", 3, 8, from_u64(0x1FF)))                                 { ret 12; }
    if (parse_u("778", 3, 8, ?out))                                                { ret 13; }
    if (parse_u("12a", 3, 10, ?out))                                               { ret 14; }
    if (parse_u("", 0, 10, ?out))                                                  { ret 15; }
    if (parse_u("___", 3, 10, ?out))                                               { ret 16; }
    if (parse_u("-1", 2, 10, ?out))                                                { ret 17; }
    # decimal and hex round trips through the formatters
    var buf: [40]u8;
    val n:   usize = format_u(t_wide(0x123456789ABCDEF0, 0xFEDCBA9876543210), ?buf[0], 40);
    if (!t_parse_is(?buf[0], n, 10, t_wide(0x123456789ABCDEF0, 0xFEDCBA9876543210))) { ret 18; }
    val h: usize = format_hex(t_wide(0x123456789ABCDEF0, 0xFEDCBA9876543210), ?buf[0], 40);
    if (!t_parse_is(?buf[0], h, 16, t_wide(0x123456789ABCDEF0, 0xFEDCBA9876543210))) { ret 19; }
    ret 0;
}
