use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;
use O: std.types.option;
use R: std.types.result;

use mach.lang.validation;
use mach.lang.build.outcome;

pub def ValidationGateCategory: u8;

pub val GATE_CAT_INVARIANT:         ValidationGateCategory = 0;
pub val GATE_CAT_FAILURE_INJECTION: ValidationGateCategory = 1;
pub val GATE_CAT_PROPERTY:          ValidationGateCategory = 2;
pub val GATE_CAT_FUZZ:              ValidationGateCategory = 3;
pub val GATE_CAT_DIFFERENTIAL:      ValidationGateCategory = 4;
pub val GATE_CAT_EXTERNAL_ORACLE:   ValidationGateCategory = 5;
pub val GATE_CAT_MATRIX:            ValidationGateCategory = 6;
pub val GATE_CAT_REPLAY:            ValidationGateCategory = 7;
pub val GATE_CAT_SCALE_CORRECTNESS: ValidationGateCategory = 8;

pub val GATE_CATEGORY_COUNT: usize = 9;

val GATE_CATEGORY_NAMES: [GATE_CATEGORY_COUNT]str = [GATE_CATEGORY_COUNT]str{
    "invariant", "failure-injection", "property", "fuzz", "differential",
    "external-oracle", "matrix", "replay", "scale-correctness",
};

pub fun gate_category_valid(c: ValidationGateCategory) bool {
    ret c::usize < GATE_CATEGORY_COUNT;
}

pub fun gate_category_name(c: ValidationGateCategory) str {
    if (!gate_category_valid(c)) { ret nil; }
    ret GATE_CATEGORY_NAMES[c::usize];
}

pub def ValidationResourceClass: u8;

pub val RESOURCE_FAST_DETERMINISTIC: ValidationResourceClass = 0;
pub val RESOURCE_PLATFORM:           ValidationResourceClass = 1;
pub val RESOURCE_FUZZ:               ValidationResourceClass = 2;
pub val RESOURCE_SCALE:              ValidationResourceClass = 3;
pub val RESOURCE_RELEASE:            ValidationResourceClass = 4;

pub val RESOURCE_CLASS_COUNT: usize = 5;

pub fun resource_class_valid(c: ValidationResourceClass) bool {
    ret c::usize < RESOURCE_CLASS_COUNT;
}

pub rec ValidationCatalogEntry {
    boundary:            str;
    remediation:         str;
    product_owner:       str;
    input_domain:        str;
    oracle:              str;
    adapter:             str;
    failure_schedule:    str;
    cross_product_axes:  str;
    resource_class:      ValidationResourceClass;
    required_result:     validation.ValidationGateResultKind;
    evidence_identity:   str;
    downstream_consumer: str;
    gates:               [GATE_CATEGORY_COUNT]validation.ValidationGateId;
}

pub val VALIDATION_CATALOG_COUNT: usize = 3;

