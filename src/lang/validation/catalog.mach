pub def CatalogLookupKind: u8;

pub val CATALOG_LISTED:     CatalogLookupKind = 0;
pub val CATALOG_NOT_LISTED: CatalogLookupKind = 1;

pub rec CatalogLookup {
    kind:  CatalogLookupKind;
    entry: ValidationCatalogEntry;
}

pub fun catalog_lookup(boundary: str) CatalogLookup {
    var i: usize = 0;
    for (i < VALIDATION_CATALOG_COUNT) {
        if (str_equals(VALIDATION_CATALOG[i].boundary, boundary)) {
            ret CatalogLookup{ kind: CATALOG_LISTED, entry: VALIDATION_CATALOG[i] };
        }
        i = i + 1;
    }
    var empty: ValidationCatalogEntry;
    ret CatalogLookup{ kind: CATALOG_NOT_LISTED, entry: empty };
}

pub fun catalog_fold(gt: *outcome.GateTally, a: *A.Allocator, boundary: str,
                     r: validation.ValidationGateResult) R.Result[R.Void, str] {
    val lookup: CatalogLookup = catalog_lookup(boundary);
    if (lookup.kind == CATALOG_NOT_LISTED) {
        ret R.err[R.Void, str]("validation catalog: boundary not listed, refusing to fold");
    }
    ret outcome.record_gate(gt, a, r);
}

test "mach.lang.validation.catalog.validation_catalog:complete_unique_well_formed_roundtrip" {
    if (VALIDATION_CATALOG_COUNT != 3) { ret 1; }
    if (GATE_CATEGORY_COUNT != 9)      { ret 1; }

    var i: usize = 0;
    for (i < VALIDATION_CATALOG_COUNT) {
        val e: *ValidationCatalogEntry = ?VALIDATION_CATALOG[i];

        if (str_len(e.boundary) == 0)            { ret 1; }
        if (str_len(e.remediation) == 0)         { ret 1; }
        if (str_len(e.product_owner) == 0)       { ret 1; }
        if (str_len(e.input_domain) == 0)        { ret 1; }
        if (str_len(e.oracle) == 0)              { ret 1; }
        if (str_len(e.adapter) == 0)             { ret 1; }
        if (str_len(e.cross_product_axes) == 0)  { ret 1; }
        if (str_len(e.evidence_identity) == 0)   { ret 1; }
        if (str_len(e.downstream_consumer) == 0) { ret 1; }
        if (!resource_class_valid(e.resource_class))            { ret 1; }
        if (e.required_result > validation.RESULT_INVALID_INJECTION) { ret 1; }

        var required_count: usize = 0;
        var has_failure_injection: bool = false;
        var c: usize = 0;
        for (c < GATE_CATEGORY_COUNT) {
            val g: *validation.ValidationGateId = ?e.gates[c];
            if (validation.gate_id_valid(g)) {
                if (!str_equals(g.namespace, e.boundary))              { ret 1; }
                if (!str_equals(g.name, GATE_CATEGORY_NAMES[c]))       { ret 1; }
                if (g.version == 0)                                    { ret 1; }
                required_count = required_count + 1;
                if (c == GATE_CAT_FAILURE_INJECTION::usize) { has_failure_injection = true; }
            } or {
                if (str_len(g.namespace) != 0 || str_len(g.name) != 0 || g.version != 0) { ret 1; }
            }
            c = c + 1;
        }
        if (required_count == 0) { ret 1; }
        if (has_failure_injection && str_len(e.failure_schedule) == 0)  { ret 1; }
        if (!has_failure_injection && str_len(e.failure_schedule) != 0) { ret 1; }

        var j: usize = 0;
        for (j < i) {
            val prior: *ValidationCatalogEntry = ?VALIDATION_CATALOG[j];
            if (str_equals(prior.boundary, e.boundary))                 { ret 1; }
            if (str_equals(prior.evidence_identity, e.evidence_identity)) { ret 1; }
            j = j + 1;
        }

        val lookup: CatalogLookup = catalog_lookup(e.boundary);
        if (lookup.kind != CATALOG_LISTED)                  { ret 1; }
        if (!str_equals(lookup.entry.boundary, e.boundary)) { ret 1; }

        i = i + 1;
    }

    var k: usize = 0;
    for (k < GATE_CATEGORY_COUNT) {
        if (str_len(GATE_CATEGORY_NAMES[k]) == 0)               { ret 1; }
        if (!str_equals(gate_category_name(k::u8), GATE_CATEGORY_NAMES[k])) { ret 1; }
        k = k + 1;
    }
    if (gate_category_name(GATE_CATEGORY_COUNT::u8) != nil) { ret 1; }
    if (gate_category_valid(GATE_CATEGORY_COUNT::u8))       { ret 1; }
    if (resource_class_valid(RESOURCE_CLASS_COUNT::u8))     { ret 1; }

    ret 0;
}

test "mach.lang.validation.catalog.catalog_lookup:absent_boundary_is_not_listed_not_pass" {
    val miss1: CatalogLookup = catalog_lookup("");
    if (miss1.kind != CATALOG_NOT_LISTED) { ret 1; }

    val miss2: CatalogLookup = catalog_lookup("mach.lang.does-not-exist");
    if (miss2.kind != CATALOG_NOT_LISTED) { ret 1; }

    val miss3: CatalogLookup = catalog_lookup("mach.lang.driver.tests.codegen-terminal-oracl");
    if (miss3.kind != CATALOG_NOT_LISTED) { ret 1; }

    if (CATALOG_LISTED == CATALOG_NOT_LISTED) { ret 1; }
    ret 0;
}

test "mach.lang.validation.catalog.catalog_fold:unlisted_boundary_is_rejected_not_folded" {
    var a: A.Allocator;
    page.make(?a);
    var gt: outcome.GateTally = outcome.gate_tally_init(?a);

    val r: R.Result[R.Void, str] = catalog_fold(?gt, ?a, "mach.lang.does-not-exist",
        validation.gate_result(validation.RESULT_PASS, validation.CAUSE_PASS, nil));
    if (R.is_ok[R.Void, str](r))                              { ret 1; }
    if (outcome.gate_tally_total(?gt) != 0 || gt.results.len != 0) { ret 2; }

    outcome.gate_tally_dnit(?gt);
    ret 0;
}

test "mach.lang.validation.catalog.catalog_fold:listed_boundary_folds_into_the_shared_tally" {
    var a: A.Allocator;
    page.make(?a);
    var gt: outcome.GateTally = outcome.gate_tally_init(?a);

    val boundary: str = VALIDATION_CATALOG[0].boundary;
    val r: R.Result[R.Void, str] = catalog_fold(?gt, ?a, boundary,
        validation.gate_result(validation.RESULT_PASS, validation.CAUSE_PASS, nil));
    if (R.is_err[R.Void, str](r))                       { ret 1; }
    if (outcome.gate_tally_total(?gt) != 1 || gt.pass != 1) { ret 2; }

    val r2: R.Result[R.Void, str] = catalog_fold(?gt, ?a, boundary,
        validation.gate_result(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_EXIT, "second"));
    if (R.is_err[R.Void, str](r2))                                  { ret 3; }
    if (outcome.gate_tally_total(?gt) != 2 || gt.semantic_mismatch != 1) { ret 4; }

    outcome.gate_tally_dnit(?gt);
    ret 0;
}

test "mach.lang.validation.catalog.catalog_fold:fails_closed_under_allocator_exhaustion" {
    var found: bool = false;
    var ordinal: u64 = 1;
    for (ordinal <= 16 && !found) {
        var backing: A.Allocator;
        page.make(?backing);
        var failing: T.Testing;
        if (O.is_some[str](T.make(?failing))) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);

        var gt: outcome.GateTally = outcome.gate_tally_init(T.allocator_of(?failing));
        val boundary: str = VALIDATION_CATALOG[1].boundary;
        val r: R.Result[R.Void, str] = catalog_fold(?gt, T.allocator_of(?failing), boundary,
            validation.gate_result(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_EXIT, "poisoned"));
        if (R.is_err[R.Void, str](r) && outcome.gate_tally_total(?gt) == 0 && gt.results.len == 0) {
            found = true;
        }

        outcome.gate_tally_dnit(?gt);
        if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }
    if (!found) { ret 1; }
    ret 0;
}
