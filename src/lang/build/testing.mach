pub fun classify_subprocess(term: *subprocess.SubprocessTerminal, expired: bool, cap_ok: bool, cap: *subprocess.CaptureIoResult) testrun.GateResult {
    if (cap_ok && (cap.read_failed || cap.write_failed || cap.close_failed)) {
        ret testrun.gate_result(testrun.RESULT_INFRASTRUCTURE_FAILURE, testrun.CAUSE_ORACLE_CAPTURE, nil);
    }
    if (!cap_ok) {
        ret testrun.gate_result(testrun.RESULT_INFRASTRUCTURE_FAILURE, testrun.CAUSE_ORACLE_CAPTURE, nil);
    }
    if (expired) {
        ret testrun.gate_result(testrun.RESULT_RESOURCE_EXHAUSTION, testrun.CAUSE_ORACLE_TIMEOUT, nil);
    }
    if (term.kind == subprocess.STATE_EXITED && term.code == 0) {
        ret testrun.gate_result(testrun.RESULT_PASS, testrun.CAUSE_PASS, nil);
    }
    if (term.kind == subprocess.STATE_EXITED && term.code == testrun.EXIT_SKIP) {
        ret testrun.gate_result(testrun.RESULT_SKIP, testrun.CAUSE_SKIP, nil);
    }
    if (term.kind == subprocess.STATE_EXITED) {
        ret testrun.gate_result(testrun.RESULT_SEMANTIC_MISMATCH, testrun.CAUSE_ORACLE_EXIT, nil);
    }
    if (term.kind == subprocess.STATE_SIGNALED) {
        ret testrun.gate_result(testrun.RESULT_SEMANTIC_MISMATCH, testrun.CAUSE_ORACLE_SIGNAL, nil);
    }
    if (term.kind == subprocess.STATE_SPAWN_FAILURE) {
        ret testrun.gate_result(testrun.RESULT_INFRASTRUCTURE_FAILURE, testrun.CAUSE_ORACLE_SPAWN_FAILURE, nil);
    }
    ret testrun.gate_result(testrun.RESULT_INFRASTRUCTURE_FAILURE, testrun.CAUSE_INVALID_TERMINAL, nil);
}

pub fun classify_setup_failure() testrun.GateResult {
    ret testrun.gate_result(testrun.RESULT_INFRASTRUCTURE_FAILURE, testrun.CAUSE_ORACLE_SPAWN_FAILURE, nil);
}

pub fun classify_wait_failure() testrun.GateResult {
    ret testrun.gate_result(testrun.RESULT_INFRASTRUCTURE_FAILURE, testrun.CAUSE_INVALID_TERMINAL, nil);
}

pub rec TestScope {
    col:     testrunner.Collected;
    have:    bool;
    pick:    *testrunner.Test;
    sel_len: u32;
}

# col is the unit's test declarations in module order; the scope owns it from here
pub fun collect_scope(p: *project.Project, col: testrunner.Collected, sc: *TestScope) err[fail.Fail] {
    sc.have    = false;
    sc.pick    = nil;
    sc.sel_len = 0;

    sc.col  = col;
    sc.have = true;
    var handed: bool = false;
    fin {
        if (!handed) { free_scope(p, sc); }
    }
    if (sc.col.count == 0) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TEST_NONE_DECLARED, "no 'test' declarations found (add 'test name { ... }' blocks)")};
    }

    val res_sel: res[*testrunner.Test, A.Error] = A.allocate[testrunner.Test](p.alloc, sc.col.count::usize);
    if (sel res_sel.err) { ret err[fail.Fail].err{fail.refused(res_sel.err)}; }
    sc.pick = res_sel.ok;
    var i: u32 = 0;
    for (i < sc.col.count) {
        if (test_selected(p, ?sc.col.tests[i])) {
            sc.pick[sc.sel_len] = sc.col.tests[i];
            sc.sel_len          = sc.sel_len + 1;
        }
        i = i + 1;
    }
    handed = true;
    ret err[fail.Fail].ok{};
}

pub fun free_scope(p: *project.Project, sc: *TestScope) {
    if (sc.pick != nil && sc.have && sc.col.count > 0) {
        A.deallocate[testrunner.Test](p.alloc, sc.pick, sc.col.count::usize);
    }
    sc.pick    = nil;
    sc.sel_len = 0;
    if (sc.have) {
        testrunner.free(p.s, ?sc.col);
        sc.have = false;
    }
}

pub fun record_tests(p: *project.Project, sc: *TestScope, exe: *u8, target: str, profile: str,
    bo: *outcome.BuildOutcome, oa: *A.Allocator) err[fail.Fail] {
    var k: u32 = 0;
    for (k < sc.sel_len) {
        val rc: err[fail.Fail] = record_test(p, ?sc.pick[k], exe, target, profile, k, bo);
        if (sel rc.err) { ret rc; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

# a run selects the project's own tests, or its dependencies' too under
# `--include-deps`, whose qualified name contains the filter
fun test_selected(p: *project.Project, t: *testrunner.Test) bool {
    if (!p.req.include_deps && !test_in_project(p, t)) { ret false; }
    if (str_empty(p.req.test_filter))                  { ret true; }
    val name: opt[str] = intern.get(?p.s.interner, t.name);
    if (sel name.none) { ret false; }
    ret str_contains(name.some, p.req.test_filter);
}

fun test_in_project(p: *project.Project, t: *testrunner.Test) bool {
    if (t.mod_idx >= project.module_count(p)) { ret false; }
    val m: *project.ModuleEntry = project.module_at(p, t.mod_idx);
    ret driver.module_in_current_project(p, m.fqn);
}

# what the dispatcher links beside the build's images: the external objects and
# the dynamic libraries the artifact names
pub rec DispatchInputs {
    ext:        *target_of.ObjectInput;
    ext_len:    u32;
    dynlibs:    *target_of.DynLib;
    dynlib_len: u32;
}

pub fun collect_dispatch_inputs(p: *project.Project, unit: *build_plan.BuildUnit) res[DispatchInputs, fail.Fail] {
    var di: DispatchInputs = DispatchInputs{};
    val ec: err[fail.Fail] = build_emit.append_external_inputs(p, unit, ?di.ext, ?di.ext_len, ?di.dynlibs, ?di.dynlib_len);
    if (sel ec.err) {
        free_dispatch_inputs(p, ?di);
        ret res[DispatchInputs, fail.Fail].err{ec.err};
    }
    ret res[DispatchInputs, fail.Fail].ok{di};
}

pub fun free_dispatch_inputs(p: *project.Project, di: *DispatchInputs) {
    build_emit.free_inputs(p.alloc, di.ext, di.ext_len, di.ext_len);
    build_emit.free_dynlibs(p.alloc, di.dynlibs, di.dynlib_len);
    @di = DispatchInputs{};
}

# synthesize the dispatcher over the selected tests, write its object to `dispatcher`, and
# link it with the test objects and the normal objects into `artifact`
# ---
# modules: the build's current objects: test and normal objects in topological order
pub fun link_dispatcher(p: *project.Project, sc: *TestScope, di: *DispatchInputs,
    modules: **Object, module_len: u32, dispatcher: str, artifact: str) err[fail.Fail] {
    if (p.target_entry == nil) { ret err[fail.Fail].err{fail.message("no target selected")}; }
    ret build_dispatch_executable(p, dispatcher, artifact, sc.pick, sc.sel_len, modules, module_len, di);
}

pub fun fingerprint_scope(s: *wire.Sink, p: *project.Project, sc: *TestScope) {
    wire.put_u32(s, sc.sel_len);
    var i: u32 = 0;
    for (i < sc.sel_len) {
        val t: *testrunner.Test = ?sc.pick[i];
        lang_fingerprint.put_text(s, scope_name(p, t.name)::str);
        wire.put_u32(s, t.line);
        wire.put_u32(s, t.mod_idx);
        i = i + 1;
    }
}

fun scope_name(p: *project.Project, id: intern.StrId) *u8 {
    val nm: opt[str] = intern.get(?p.s.interner, id);
    if (sel nm.some) { ret nm.some::*u8; }
    ret ""::*u8;
}

fun build_dispatch_executable(p: *project.Project, dispatcher: str, artifact: str,
    pick: *testrunner.Test, sel_len: u32,
    modules: **Object, module_len: u32, di: *DispatchInputs) err[fail.Fail] {
    val machine: res[*lower_context.Machine, fail.Fail] = backend.machine(?p.back);
    if (sel machine.err) { ret err[fail.Fail].err{machine.err}; }
    project.set_origin(p, diagnostic.ORIGIN_LOWER);
    val res_synth: res[lower_context.Unit, fail.Fail] = testrunner.synthesize_dispatcher(p.s, machine.ok, pick, sel_len);
    if (sel res_synth.err) { ret err[fail.Fail].err{res_synth.err}; }
    var entry: lower_context.Unit = res_synth.ok;
    fin { lower_context.unit_dnit(?entry); }

    project.set_origin(p, diagnostic.ORIGIN_CODEGEN);
    val compiled: res[Object, fail.Fail] = passes.compile_object(p, ?entry);
    if (sel compiled.err) { ret err[fail.Fail].err{compiled.err}; }
    var entry_object: Object = compiled.ok;
    fin { backend.release_object(?entry_object); }
    var written:  build_emit.ObjectWrite = build_emit.ObjectWrite{p: p, o: ?entry_object, record: nil};
    val res_emit: err[fail.Fail]         = build_emit.write_object(?written, dispatcher);
    if (sel res_emit.err) { ret err[fail.Fail].err{fail.as_user(diagnostic_kind.OUTPUT_WRITE, res_emit.err)}; }

    # the dispatcher is the test executable's `main`: an artifact's own `main` yields to it
    # as a weak definition, in a copy, so the normal object stays as the cache holds it
    val total: u32                    = module_len + 1;
    val made:  res[**Object, A.Error] = A.allocate[*Object](p.alloc, total::usize);
    if (sel made.err) { ret err[fail.Fail].err{fail.refused(made.err)}; }
    val objects: **Object = made.ok;
    fin { A.deallocate[*Object](p.alloc, objects, total::usize); }
    var yielded: Object;
    var yields:  bool = false;
    fin {
        if (yields) { backend.release_object(?yielded); }
    }
    objects[0] = ?entry_object;
    var i: u32 = 0;
    for (i < module_len) {
        objects[i + 1] = modules[i];
        if (!yields) {
            val weak: res[opt[Object], fail.Fail] = backend.weakened(p.s.backing, modules[i], testrunner.MAIN_LINKAGE);
            if (sel weak.err) { ret err[fail.Fail].err{weak.err}; }
            if (sel weak.ok.some) {
                yielded        = weak.ok.some;
                yields         = true;
                objects[i + 1] = ?yielded;
            }
        }
        i = i + 1;
    }

    project.set_origin(p, diagnostic.ORIGIN_LINK);
    ret build_emit.link_image(p, ?mink_output.STATIC, false, objects, total, di.ext, di.ext_len, di.dynlib_len, artifact, nil);
}

fun record_test(p: *project.Project, t: *testrunner.Test, exe: *u8, target: str, profile: str, idx: u32,
    bo: *outcome.BuildOutcome) err[fail.Fail] {
    val name: str = intern.text(?p.s.interner, t.name);
    if (t.mod_idx >= project.module_count(p)) { ret err[fail.Fail].err{fail.message("a test names a module the project never loaded")}; }
    val m:    *project.ModuleEntry         = project.module_at(p, t.mod_idx);
    val file: opt[*lang_source.SourceFile] = lang_source.get(?p.s.sources, m.file_id);
    if (sel file.none) { ret err[fail.Fail].err{fail.message("a test's module has no source file")}; }

    val located: res[str, fail.Fail] = cache.test_object_path(p, m, p.alloc);
    if (sel located.err) { ret err[fail.Fail].err{located.err}; }
    val object: *u8          = located.ok::*u8;
    val rec_r:  err[A.Error] = outcome.record_test(bo, testrun.TestArtifact{
        module: intern.text(?p.s.interner, m.fqn)::*u8, name: name::*u8, file: file.some.path::*u8,
        line:   t.line, object: object, exe: exe, idx: idx, target: target::*u8, profile: profile::*u8
    });
    if (object != nil) { str_free(p.alloc, object::str); }
    if (sel rec_r.err) { ret err[fail.Fail].err{fail.refused(rec_r.err)}; }
    ret err[fail.Fail].ok{};
}

test classify_subprocess__maps_every_terminal_and_capture_shape {
    var term: subprocess.SubprocessTerminal;
    var cap:  subprocess.CaptureIoResult;
    cap.bytes        = 0;
    cap.truncated    = false;
    cap.short_read   = false;
    cap.read_failed  = false;
    cap.write_failed = false;
    cap.close_failed = false;
    cap.closed       = true;
    cap.owned        = true;

    var bad: i32 = 0;

    term.kind = subprocess.STATE_EXITED;
    term.code = 0;
    val pass_r: testrun.GateResult = classify_subprocess(?term, false, true, ?cap);
    if (pass_r.kind != testrun.RESULT_PASS || pass_r.cause != testrun.CAUSE_PASS) { bad = 1; }

    term.code = 7;
    val exit_r: testrun.GateResult = classify_subprocess(?term, false, true, ?cap);
    if (exit_r.kind != testrun.RESULT_SEMANTIC_MISMATCH || exit_r.cause != testrun.CAUSE_ORACLE_EXIT) { bad = 1; }

    term.code = 77;
    val skip_r: testrun.GateResult = classify_subprocess(?term, false, true, ?cap);
    if (skip_r.kind != testrun.RESULT_SKIP || skip_r.cause != testrun.CAUSE_SKIP) { bad = 1; }

    term.kind = subprocess.STATE_SIGNALED;
    term.code = 77;
    val sig_skip_r: testrun.GateResult = classify_subprocess(?term, false, true, ?cap);
    if (sig_skip_r.kind != testrun.RESULT_SEMANTIC_MISMATCH || sig_skip_r.cause != testrun.CAUSE_ORACLE_SIGNAL) { bad = 1; }

    term.code = 9;
    val sig_r: testrun.GateResult = classify_subprocess(?term, false, true, ?cap);
    if (sig_r.kind != testrun.RESULT_SEMANTIC_MISMATCH || sig_r.cause != testrun.CAUSE_ORACLE_SIGNAL) { bad = 1; }

    term.kind = subprocess.STATE_SPAWN_FAILURE;
    term.code = 0;
    val spawn_r: testrun.GateResult = classify_subprocess(?term, false, true, ?cap);
    if (spawn_r.kind != testrun.RESULT_INFRASTRUCTURE_FAILURE || spawn_r.cause != testrun.CAUSE_ORACLE_SPAWN_FAILURE) { bad = 1; }

    term.kind = subprocess.STATE_UNSTARTED;
    val invalid_r: testrun.GateResult = classify_subprocess(?term, false, true, ?cap);
    if (invalid_r.kind != testrun.RESULT_INFRASTRUCTURE_FAILURE || invalid_r.cause != testrun.CAUSE_INVALID_TERMINAL) { bad = 1; }

    term.kind = subprocess.STATE_EXITED;
    term.code = 0;
    val no_capture_r: testrun.GateResult = classify_subprocess(?term, false, false, ?cap);
    if (no_capture_r.kind != testrun.RESULT_INFRASTRUCTURE_FAILURE || no_capture_r.cause != testrun.CAUSE_ORACLE_CAPTURE) { bad = 1; }

    term.kind = subprocess.STATE_SIGNALED;
    term.code = 15;
    val timeout_r: testrun.GateResult = classify_subprocess(?term, true, true, ?cap);
    if (timeout_r.kind != testrun.RESULT_RESOURCE_EXHAUSTION || timeout_r.cause != testrun.CAUSE_ORACLE_TIMEOUT) { bad = 1; }

    term.kind = subprocess.STATE_EXITED;
    term.code = 0;
    val timeout_capture_r: testrun.GateResult = classify_subprocess(?term, true, false, ?cap);
    if (timeout_capture_r.kind != testrun.RESULT_INFRASTRUCTURE_FAILURE || timeout_capture_r.cause != testrun.CAUSE_ORACLE_CAPTURE) { bad = 1; }

    cap.read_failed = true;
    val bad_read_r: testrun.GateResult = classify_subprocess(?term, false, true, ?cap);
    if (bad_read_r.kind != testrun.RESULT_INFRASTRUCTURE_FAILURE || bad_read_r.cause != testrun.CAUSE_ORACLE_CAPTURE) { bad = 1; }
    cap.read_failed = false;

    cap.write_failed = true;
    val bad_write_r: testrun.GateResult = classify_subprocess(?term, false, true, ?cap);
    if (bad_write_r.kind != testrun.RESULT_INFRASTRUCTURE_FAILURE || bad_write_r.cause != testrun.CAUSE_ORACLE_CAPTURE) { bad = 1; }
    cap.write_failed = false;

    cap.close_failed = true;
    val bad_close_r: testrun.GateResult = classify_subprocess(?term, false, true, ?cap);
    if (bad_close_r.kind != testrun.RESULT_INFRASTRUCTURE_FAILURE || bad_close_r.cause != testrun.CAUSE_ORACLE_CAPTURE) { bad = 1; }

    ret bad;
}
