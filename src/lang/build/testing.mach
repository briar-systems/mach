pub fun classify_subprocess(term: *subprocess.SubprocessTerminal, expired: bool, cap_ok: bool, cap: *subprocess.CaptureIoResult) validation.ValidationGateResult {
    if (cap_ok && (cap.read_failed || cap.write_failed || cap.close_failed)) {
        ret validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_CAPTURE, nil);
    }
    if (!cap_ok) {
        ret validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_CAPTURE, nil);
    }
    if (expired) {
        ret validation.gate_result(validation.RESULT_RESOURCE_EXHAUSTION, validation.CAUSE_ORACLE_TIMEOUT, nil);
    }
    if (term.kind == subprocess.STATE_EXITED && term.code == 0) {
        ret validation.gate_result(validation.RESULT_PASS, validation.CAUSE_PASS, nil);
    }
    if (term.kind == subprocess.STATE_EXITED) {
        ret validation.gate_result(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_EXIT, nil);
    }
    if (term.kind == subprocess.STATE_SIGNALED) {
        ret validation.gate_result(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_SIGNAL, nil);
    }
    if (term.kind == subprocess.STATE_SPAWN_FAILURE) {
        ret validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_SPAWN_FAILURE, nil);
    }
    ret validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_INVALID_TERMINAL, nil);
}

pub fun classify_setup_failure() validation.ValidationGateResult {
    ret validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_SPAWN_FAILURE, nil);
}

pub fun classify_timeout() validation.ValidationGateResult {
    ret validation.gate_result(validation.RESULT_RESOURCE_EXHAUSTION, validation.CAUSE_ORACLE_TIMEOUT, nil);
}

pub fun classify_wait_failure() validation.ValidationGateResult {
    ret validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_INVALID_TERMINAL, nil);
}

pub rec TestScope {
    col:     testrunner.Collected;
    have:    bool;
    pick:    *testrunner.Test;
    sel_len: u32;
}

# col is the unit's test declarations in module order; the scope owns it from here
pub fun collect_scope(p: *driver.Project, col: testrunner.Collected, sc: *TestScope) err[outcome.Fail] {
    sc.have    = false;
    sc.pick    = nil;
    sc.sel_len = 0;

    sc.col  = col;
    sc.have = true;
    if (sc.col.count == 0) {
        free_scope(p, sc);
        ret err[outcome.Fail].err{outcome.user("no 'test' declarations found (add 'test name { ... }' blocks)")};
    }

    val include_deps: bool = p.req.include_deps;

    val res_sel: res[*testrunner.Test, A.Error] = A.allocate[testrunner.Test](p.alloc, sc.col.count::usize);
    if (sel res_sel.err) {
        free_scope(p, sc);
        ret err[outcome.Fail].err{outcome.internal("out of memory")};
    }
    sc.pick = res_sel.ok;
    var i: u32 = 0;
    for (i < sc.col.count) {
        if (test_selected(p, ?sc.col.tests[i], include_deps)) {
            sc.pick[sc.sel_len] = sc.col.tests[i];
            sc.sel_len          = sc.sel_len + 1;
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

pub fun free_scope(p: *driver.Project, sc: *TestScope) {
    if (sc.pick != nil && sc.have && sc.col.count > 0) {
        A.deallocate[testrunner.Test](p.alloc, sc.pick, sc.col.count::usize);
    }
    sc.pick    = nil;
    sc.sel_len = 0;
    if (sc.have) {
        testrunner.free(p.s, ?sc.col);
        sc.have = false;
    }
}

pub fun record_tests(p: *driver.Project, sc: *TestScope, exe: *u8,
    bo: *outcome.BuildOutcome, oa: *A.Allocator) err[outcome.Fail] {
    var k: u32 = 0;
    for (k < sc.sel_len) {
        val rc: err[outcome.Fail] = record_test(p, ?sc.pick[k], exe, k, bo);
        if (sel rc.err) { ret rc; }
        k = k + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun test_selected(p: *driver.Project, t: *testrunner.Test, include_deps: bool) bool {
    if (include_deps) { ret true; }
    ret test_in_project(p, t);
}

fun test_in_project(p: *driver.Project, t: *testrunner.Test) bool {
    if (t.mod_idx >= driver.module_count(p)) { ret false; }
    val m: *driver.ModuleEntry = driver.module_at(p, t.mod_idx);
    ret driver.module_in_current_project(p, m.fqn);
}

pub rec DispatchInputs {
    shared:     **u8;
    shared_len: u32;
    borrowed:   u32;
    dynlibs:    *of.DynLib;
    dynlib_len: u32;
}

pub fun collect_dispatch_inputs(p: *driver.Project, unit: *plan.BuildUnit,
    obj_paths: **u8) res[DispatchInputs, outcome.Fail] {
    var di: DispatchInputs;
    di.shared     = nil;
    di.shared_len = 0;
    di.borrowed   = p.emit_len;
    di.dynlibs    = nil;
    di.dynlib_len = 0;

    val res_sh: res[**u8, A.Error] = A.allocate[*u8](p.alloc, di.borrowed::usize);
    if (sel res_sh.err) { ret res[DispatchInputs, outcome.Fail].err{outcome.refused(res_sh.err)}; }
    di.shared = res_sh.ok;
    var i: u32 = 0;
    for (i < di.borrowed) {
        di.shared[i] = obj_paths[i];
        i            = i + 1;
    }
    di.shared_len = di.borrowed;

    val ec: err[outcome.Fail] = emit.append_external_inputs(p, unit, ?di.shared, ?di.shared_len, ?di.dynlibs, ?di.dynlib_len);
    if (sel ec.err) {
        free_dispatch_inputs(p, ?di);
        ret res[DispatchInputs, outcome.Fail].err{ec.err};
    }
    ret res[DispatchInputs, outcome.Fail].ok{di};
}

pub fun free_dispatch_inputs(p: *driver.Project, di: *DispatchInputs) {
    free_shared(p, di.shared, di.shared_len, di.borrowed);
    emit.free_dynlibs(p.alloc, di.dynlibs, di.dynlib_len);
    di.shared     = nil;
    di.shared_len = 0;
    di.dynlibs    = nil;
    di.dynlib_len = 0;
}

pub fun link_dispatcher(p: *driver.Project, unit: *plan.BuildUnit, sc: *TestScope,
    di: *DispatchInputs, dispatcher: str,
    artifact: str) err[outcome.Fail] {
    val te: *driver.TargetEntry = p.target_entry;
    if (te == nil) {
        ret err[outcome.Fail].err{outcome.internal("no target selected")};
    }

    val shared:     **u8       = di.shared;
    val shared_len: u32        = di.shared_len;
    val dynlibs:    *of.DynLib = di.dynlibs;
    val dynlib_len: u32        = di.dynlib_len;

    var scratch_backing: A.Allocator;
    val make_r:          err[A.Error] = page.make(?scratch_backing);
    if (sel make_r.err) {
        ret err[outcome.Fail].err{outcome.internal("failed to initialise test allocator")};
    }
    var scratch_ar: arena.Arena;
    val init_r:     err[A.Error] = arena.init(?scratch_ar, ?scratch_backing, 0);
    if (sel init_r.err) {
        ret err[outcome.Fail].err{outcome.internal("failed to initialise test allocator")};
    }
    var scratch_alloc: A.Allocator;
    val make_r2:       err[A.Error] = arena.make(?scratch_alloc, ?scratch_ar);
    if (sel make_r2.err) {
        arena.dnit(?scratch_ar);
        ret err[outcome.Fail].err{outcome.internal("failed to initialise test allocator")};
    }

    val persistent: *A.Allocator = p.s.alloc;

    p.s.alloc = ?scratch_alloc;
    val result: err[outcome.Fail] = build_dispatch_executable(p, dispatcher, artifact,
        sc.pick, sc.sel_len, shared, shared_len,
        dynlibs, dynlib_len);
    p.s.alloc = persistent;
    arena.dnit(?scratch_ar);
    ret result;
}

pub fun fingerprint_scope(fb: *dq.FpBuf, p: *driver.Project, sc: *TestScope) err[outcome.Fail] {
    val rc: err[fail.Fail] = dq.fp_u32(fb, sc.sel_len);
    if (sel rc.err) { ret err[outcome.Fail].err{outcome.from_fail(rc.err)}; }
    var i: u32 = 0;
    for (i < sc.sel_len) {
        val t:  *testrunner.Test = ?sc.pick[i];
        val rl: err[fail.Fail]   = dq.fp_cstr(fb, scope_name(p, t.name));
        if (sel rl.err) { ret err[outcome.Fail].err{outcome.from_fail(rl.err)}; }
        val rn: err[fail.Fail] = dq.fp_u32(fb, t.line);
        if (sel rn.err) { ret err[outcome.Fail].err{outcome.from_fail(rn.err)}; }
        val rm: err[fail.Fail] = dq.fp_u32(fb, t.mod_idx);
        if (sel rm.err) { ret err[outcome.Fail].err{outcome.from_fail(rm.err)}; }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun scope_name(p: *driver.Project, id: intern.StrId) *u8 {
    val nm: opt[str] = intern.lookup(?p.s.interner, id);
    if (sel nm.some) { ret nm.some::*u8; }
    ret ""::*u8;
}

fun free_shared(p: *driver.Project, shared: **u8, shared_len: u32, borrowed: u32) {
    if (shared == nil) { ret; }
    var i: u32 = borrowed;
    for (i < shared_len) {
        if (shared[i] != nil) {
            A.deallocate[u8](p.alloc, shared[i], (str_len(shared[i]::str) + 1)::usize);
        }
        i = i + 1;
    }
    A.deallocate[*u8](p.alloc, shared, shared_len::usize);
}

fun build_dispatch_executable(p: *driver.Project, dispatcher: str, artifact: str,
    pick: *testrunner.Test, sel_len: u32,
    shared: **u8, shared_len: u32,
    dynlibs: *of.DynLib, dynlib_len: u32) err[outcome.Fail] {
    val res_synth: res[ir.Module, fail.Fail] = testrunner.synthesize_dispatcher(p.s, pick, sel_len);
    if (sel res_synth.err) {
        ret err[outcome.Fail].err{outcome.from_fail(res_synth.err)};
    }
    var entry_ir: ir.Module = res_synth.ok;

    var preq: pipeline.PipelineRequest;
    preq.module            = ?entry_ir;
    preq.target            = ?p.target;
    preq.level             = p.req.opt;
    preq.vectorize_enabled = pipeline.VectorizeEnabledOption{v: p.req.vectorize};
    preq.simd_require      = pipeline.SimdRequireOption{v: p.req.simd == manifest.SIMD_REQUIRE};
    preq.float_reassoc     = pipeline.FloatReassocOption{v: p.req.float_reassoc};
    preq.interner          = ?p.s.interner;
    preq.source_map        = ?p.s.sources;
    preq.diags             = ?p.diags;
    val res_opt: res[bool, fail.Fail] = pipeline.run(?preq);
    if (sel res_opt.err) {
        ir.dnit(?entry_ir);
        ret err[outcome.Fail].err{outcome.from_fail(res_opt.err)};
    }

    val dbg_r: res[codegen.DebugInfo, fail.Fail] = driver.debug_info_of(p);
    if (sel dbg_r.err) {
        ir.dnit(?entry_ir);
        ret err[outcome.Fail].err{outcome.from_fail(dbg_r.err)};
    }

    val res_codegen: res[of.ObjectImage, fail.Fail] = codegen.codegen_unit(p.s, ?p.target, ?entry_ir, cgunit.ir_set_empty(), nil, p.req.placement_policy, dbg_r.ok, ?p.diags);
    if (sel res_codegen.err) {
        ir.dnit(?entry_ir);
        ret err[outcome.Fail].err{outcome.from_fail(res_codegen.err)};
    }
    var entry_img: of.ObjectImage = res_codegen.ok;

    val entry_path: str            = dispatcher;
    val res_emit:   err[fail.Fail] = obj.emit_image(?entry_img, ?p.target, dispatcher);
    obj.dnit(?entry_img);
    ir.dnit(?entry_ir);
    if (sel res_emit.err) {
        ret err[outcome.Fail].err{outcome.user_fail(res_emit.err)};
    }

    ret link_one_test(p, shared, shared_len, dynlibs, dynlib_len, entry_path, artifact);
}

fun link_one_test(p: *driver.Project, shared: **u8, shared_len: u32,
    dynlibs: *of.DynLib, dynlib_len: u32,
    entry_path: *u8, artifact: str) err[outcome.Fail] {
    val total:     u32                = shared_len + 1;
    val res_paths: res[**u8, A.Error] = A.allocate[*u8](p.alloc, total::usize);
    if (sel res_paths.err) { ret err[outcome.Fail].err{outcome.refused(res_paths.err)}; }
    val paths: **u8 = res_paths.ok;

    val per_module: u32 = p.emit_len;
    var i:          u32 = 0;
    for (i < per_module) {
        paths[i] = shared[i];
        i        = i + 1;
    }
    paths[per_module] = entry_path;
    var j: u32 = per_module;
    for (j < shared_len) {
        paths[j + 1] = shared[j];
        j            = j + 1;
    }

    val res_link: err[fail.Fail] = linker.link(p.s, ?p.target, paths, total, dynlibs, dynlib_len, artifact, emit.artifact_product_name(p), linker.LINK_EXE, p.req.pie, of.image_options_default(p.req.subsystem));
    A.deallocate[*u8](p.alloc, paths, total::usize);
    if (sel res_link.err) {
        ret err[outcome.Fail].err{outcome.from_fail(res_link.err)};
    }
    ret err[outcome.Fail].ok{};
}

fun record_test(p: *driver.Project, t: *testrunner.Test, exe: *u8, idx: u32,
    bo: *outcome.BuildOutcome) err[outcome.Fail] {
    val opt_name: opt[str] = intern.lookup(?p.s.interner, t.name);
    var name:     str      = "<test>";
    if (sel opt_name.some) { name = opt_name.some; }

    val rec_r: err[A.Error] = outcome.record_test(bo,
        test_module_fqn(p, t.mod_idx)::str, name, test_source_path(p, t.mod_idx)::str,
        t.line, exe::str, idx);
    if (sel rec_r.err) { ret err[outcome.Fail].err{outcome.refused(rec_r.err)}; }
    ret err[outcome.Fail].ok{};
}

fun test_module_fqn(p: *driver.Project, mod_idx: u32) *u8 {
    if (mod_idx >= driver.module_count(p)) { ret "<unknown>"; }
    val m:       *driver.ModuleEntry = driver.module_at(p, mod_idx);
    val opt_fqn: opt[str]            = intern.lookup(?p.s.interner, m.fqn);
    if (sel opt_fqn.none) { ret "<unknown>"; }
    ret opt_fqn.some::*u8;
}

fun test_source_path(p: *driver.Project, mod_idx: u32) *u8 {
    if (mod_idx >= driver.module_count(p)) { ret "<unknown>"; }
    val m:        *driver.ModuleEntry     = driver.module_at(p, mod_idx);
    val opt_file: opt[*source.SourceFile] = source.get(?p.s.sources, m.file_id);
    if (sel opt_file.none) { ret "<unknown>"; }
    ret opt_file.some.path::*u8;
}

#[testing]
fun testing_name(s: *session.Session, name: str) intern.StrId {
    val r: res[intern.StrId, A.Error] = intern.intern(?s.interner, name);
    if (sel r.err) { ret intern.STR_NIL; }
    ret r.ok;
}

# links `paths` into `out` and reads the image back
#[testing]
fun t_link_image(s: *session.Session, tgt: *target.Target, paths: **u8, count: u32, out: str, image: *Vector[u8]) bool {
    val linked: err[fail.Fail] = linker.link(s, tgt, paths, count, nil, 0, out, "coff-atom-test", linker.LINK_EXE, false,
        of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel linked.err) {
        print.eprintln(fail.describe(linked.err));
        ret false;
    }
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(s.alloc, out);
    if (sel read.err) { ret false; }
    @image = read.ok;
    ret true;
}

# a weak body that loses to another object's is discarded whole: linking the loser
# beside the winner produces exactly the image the winner alone produces
test coff_link__discards_the_losing_weak_body {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val register_all_r: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel register_all_r.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "windows", "win64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    val text:        intern.StrId = testing_name(?s, ".text");
    val entry:       intern.StrId = testing_name(?s, "mainCRTStartup");
    val weak:        intern.StrId = testing_name(?s, "dedup$u64");
    val winner_name: intern.StrId = testing_name(?s, "coff-winner");
    val loser_name:  intern.StrId = testing_name(?s, "coff-loser");
    if (text == intern.STR_NIL || entry == intern.STR_NIL || weak == intern.STR_NIL
        || winner_name == intern.STR_NIL || loser_name == intern.STR_NIL) { ret 1; }

    var winner_bytes: [16]u8;
    var loser_bytes:  [8]u8;
    var i:            u32 = 0;
    for (i < 8) {
        winner_bytes[i]     = 0xC3;
        winner_bytes[8 + i] = (0x40 + i)::u8;
        loser_bytes[i]      = (0xA0 + i)::u8;
        i                   = i + 1;
    }

    var winner_sections: [1]of.Section;
    var loser_sections:  [1]of.Section;
    winner_sections[0].name  = text;
    winner_sections[0].kind  = of.SK_TEXT;
    winner_sections[0].bytes = ?winner_bytes[0];
    winner_sections[0].len   = 16;
    winner_sections[0].align = 8;
    loser_sections[0].name   = text;
    loser_sections[0].kind   = of.SK_TEXT;
    loser_sections[0].bytes  = ?loser_bytes[0];
    loser_sections[0].len    = 8;
    loser_sections[0].align  = 8;

    val strong_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    val weak_flags:   u32 =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    var winner_symbols: [2]of.Symbol;
    var loser_symbols:  [1]of.Symbol;
    winner_symbols[0].name    = entry;
    winner_symbols[0].section = of.section_id(0);
    winner_symbols[0].offset  = 0;
    winner_symbols[0].size    = 8;
    winner_symbols[0].flags   = strong_flags;
    winner_symbols[1].name    = weak;
    winner_symbols[1].section = of.section_id(0);
    winner_symbols[1].offset  = 8;
    winner_symbols[1].size    = 8;
    winner_symbols[1].flags   = weak_flags;
    loser_symbols[0].name     = weak;
    loser_symbols[0].section  = of.section_id(0);
    loser_symbols[0].offset   = 0;
    loser_symbols[0].size     = 8;
    loser_symbols[0].flags    = weak_flags;

    var winner: of.ObjectImage;
    winner.alloc         = ?alloc;
    winner.interner      = ?s.interner;
    winner.name          = winner_name;
    winner.sections      = ?winner_sections[0];
    winner.section_count = 1;
    winner.symbols       = ?winner_symbols[0];
    winner.symbol_count  = 2;
    winner.relocations   = nil;
    winner.reloc_count   = 0;
    var loser: of.ObjectImage;
    loser.alloc         = ?alloc;
    loser.interner      = ?s.interner;
    loser.name          = loser_name;
    loser.sections      = ?loser_sections[0];
    loser.section_count = 1;
    loser.symbols       = ?loser_symbols[0];
    loser.symbol_count  = 1;
    loser.relocations   = nil;
    loser.reloc_count   = 0;

    val ar: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "mach_coff_atom_a");
    if (sel ar.err) { ret 2; }
    var af: fixture.Output = ar.ok;
    fin { fixture.dnit(?af); }
    val br: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "mach_coff_atom_b");
    if (sel br.err) { ret 2; }
    var bf: fixture.Output = br.ok;
    fin { fixture.dnit(?bf); }
    val er: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "mach_coff_atom_exe");
    if (sel er.err) { ret 2; }
    var ef: fixture.Output = er.ok;
    fin { fixture.dnit(?ef); }
    val apath: str               = fixture.path(?af);
    val bpath: str               = fixture.path(?bf);
    val epath: str               = fixture.path(?ef);
    val ac:    err[outcome.Fail] = fixture.close(?af);
    val bc:    err[outcome.Fail] = fixture.close(?bf);
    val ec:    err[outcome.Fail] = fixture.close(?ef);
    if (sel ac.err || sel bc.err || sel ec.err) { ret 3; }

    val wrote_winner: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?winner, apath);
    if (sel wrote_winner.err) { ret 4; }
    val wrote_loser: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?loser, bpath);
    if (sel wrote_loser.err) { ret 4; }

    var one: [1]*u8;
    one[0] = apath::*u8;
    var control: Vector[u8];
    if (!t_link_image(?s, ?tgt, ?one[0], 1, epath, ?control)) { ret 5; }
    fin { vector.dnit[u8](?control); }
    var both: [2]*u8;
    both[0] = apath::*u8;
    both[1] = bpath::*u8;
    var combined: Vector[u8];
    if (!t_link_image(?s, ?tgt, ?both[0], 2, epath, ?combined)) { ret 6; }
    fin { vector.dnit[u8](?combined); }

    if (control.len != combined.len) { ret 7; }
    var at: usize = 0;
    for (at < control.len) {
        if (control.data[at] != combined.data[at]) { ret 8; }
        at = at + 1;
    }
    ret 0;
}

test classify_subprocess__maps_every_terminal_and_capture_shape {
    var term: subprocess.SubprocessTerminal;
    var cap:  subprocess.CaptureIoResult;
    cap.bytes        = 0;
    cap.truncated    = false;
    cap.short_read   = false;
    cap.read_failed  = false;
    cap.write_failed = false;
    cap.close_failed = false;
    cap.closed       = true;
    cap.owned        = true;

    var bad: i32 = 0;

    term.kind = subprocess.STATE_EXITED;
    term.code = 0;
    val pass_r: validation.ValidationGateResult = classify_subprocess(?term, false, true, ?cap);
    if (pass_r.kind != validation.RESULT_PASS || pass_r.cause != validation.CAUSE_PASS) { bad = 1; }

    term.code = 7;
    val exit_r: validation.ValidationGateResult = classify_subprocess(?term, false, true, ?cap);
    if (exit_r.kind != validation.RESULT_SEMANTIC_MISMATCH || exit_r.cause != validation.CAUSE_ORACLE_EXIT) { bad = 1; }

    term.kind = subprocess.STATE_SIGNALED;
    term.code = 9;
    val sig_r: validation.ValidationGateResult = classify_subprocess(?term, false, true, ?cap);
    if (sig_r.kind != validation.RESULT_SEMANTIC_MISMATCH || sig_r.cause != validation.CAUSE_ORACLE_SIGNAL) { bad = 1; }

    term.kind = subprocess.STATE_SPAWN_FAILURE;
    term.code = 0;
    val spawn_r: validation.ValidationGateResult = classify_subprocess(?term, false, true, ?cap);
    if (spawn_r.kind != validation.RESULT_INFRASTRUCTURE_FAILURE || spawn_r.cause != validation.CAUSE_ORACLE_SPAWN_FAILURE) { bad = 1; }

    term.kind = subprocess.STATE_UNSTARTED;
    val invalid_r: validation.ValidationGateResult = classify_subprocess(?term, false, true, ?cap);
    if (invalid_r.kind != validation.RESULT_INFRASTRUCTURE_FAILURE || invalid_r.cause != validation.CAUSE_INVALID_TERMINAL) { bad = 1; }

    term.kind = subprocess.STATE_EXITED;
    term.code = 0;
    val no_capture_r: validation.ValidationGateResult = classify_subprocess(?term, false, false, ?cap);
    if (no_capture_r.kind != validation.RESULT_INFRASTRUCTURE_FAILURE || no_capture_r.cause != validation.CAUSE_ORACLE_CAPTURE) { bad = 1; }

    term.kind = subprocess.STATE_SIGNALED;
    term.code = 15;
    val timeout_r: validation.ValidationGateResult = classify_subprocess(?term, true, true, ?cap);
    if (timeout_r.kind != validation.RESULT_RESOURCE_EXHAUSTION || timeout_r.cause != validation.CAUSE_ORACLE_TIMEOUT) { bad = 1; }

    term.kind = subprocess.STATE_EXITED;
    term.code = 0;
    val timeout_capture_r: validation.ValidationGateResult = classify_subprocess(?term, true, false, ?cap);
    if (timeout_capture_r.kind != validation.RESULT_INFRASTRUCTURE_FAILURE || timeout_capture_r.cause != validation.CAUSE_ORACLE_CAPTURE) { bad = 1; }

    cap.read_failed = true;
    val bad_read_r: validation.ValidationGateResult = classify_subprocess(?term, false, true, ?cap);
    if (bad_read_r.kind != validation.RESULT_INFRASTRUCTURE_FAILURE || bad_read_r.cause != validation.CAUSE_ORACLE_CAPTURE) { bad = 1; }
    cap.read_failed = false;

    cap.write_failed = true;
    val bad_write_r: validation.ValidationGateResult = classify_subprocess(?term, false, true, ?cap);
    if (bad_write_r.kind != validation.RESULT_INFRASTRUCTURE_FAILURE || bad_write_r.cause != validation.CAUSE_ORACLE_CAPTURE) { bad = 1; }
    cap.write_failed = false;

    cap.close_failed = true;
    val bad_close_r: validation.ValidationGateResult = classify_subprocess(?term, false, true, ?cap);
    if (bad_close_r.kind != validation.RESULT_INFRASTRUCTURE_FAILURE || bad_close_r.cause != validation.CAUSE_ORACLE_CAPTURE) { bad = 1; }

    ret bad;
}
