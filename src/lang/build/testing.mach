pub fun classify_subprocess(term: *subprocess.SubprocessTerminal, expired: bool, cap_ok: bool, cap: *subprocess.CaptureIoResult) validation.ValidationGateResult {
    if (cap_ok && (cap.read_failed || cap.write_failed || cap.close_failed)) {
        ret validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_CAPTURE, nil);
    }
    if (!cap_ok) {
        ret validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_CAPTURE, nil);
    }
    if (expired) {
        ret validation.gate_result(validation.RESULT_RESOURCE_EXHAUSTION, validation.CAUSE_ORACLE_TIMEOUT, nil);
    }
    if (term.kind == subprocess.STATE_EXITED && term.code == 0) {
        ret validation.gate_result(validation.RESULT_PASS, validation.CAUSE_PASS, nil);
    }
    if (term.kind == subprocess.STATE_EXITED) {
        ret validation.gate_result(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_EXIT, nil);
    }
    if (term.kind == subprocess.STATE_SIGNALED) {
        ret validation.gate_result(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_SIGNAL, nil);
    }
    if (term.kind == subprocess.STATE_SPAWN_FAILURE) {
        ret validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_SPAWN_FAILURE, nil);
    }
    ret validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_INVALID_TERMINAL, nil);
}

pub fun classify_setup_failure() validation.ValidationGateResult {
    ret validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_SPAWN_FAILURE, nil);
}

pub fun classify_timeout() validation.ValidationGateResult {
    ret validation.gate_result(validation.RESULT_RESOURCE_EXHAUSTION, validation.CAUSE_ORACLE_TIMEOUT, nil);
}

pub fun classify_wait_failure() validation.ValidationGateResult {
    ret validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_INVALID_TERMINAL, nil);
}

pub rec TestScope {
    col:     testrunner.Collected;
    have:    bool;
    sel:     *testrunner.Test;
    sel_len: u32;
    skipped: u32;
}

pub fun collect_scope(p: *driver.Project, irs: *ir.Module, sc: *TestScope) R.Result[R.Void, outcome.Fail] {
    sc.have    = false;
    sc.sel     = nil;
    sc.sel_len = 0;
    sc.skipped = driver.count_target_gated(p);

    val res_collect: R.Result[testrunner.Collected, fail.Fail] = testrunner.collect(p.s, irs, p.module_len);
    if (R.is_err[testrunner.Collected, fail.Fail](res_collect)) {
        ret R.err[R.Void, outcome.Fail](outcome.from_fail(R.unwrap_err[testrunner.Collected, fail.Fail](res_collect)));
    }
    sc.col  = R.unwrap_ok[testrunner.Collected, fail.Fail](res_collect);
    sc.have = true;
    if (sc.col.count == 0) {
        free_scope(p, sc);
        ret R.err[R.Void, outcome.Fail](outcome.user("no 'test' declarations found (add 'test \"name\" { ... }' blocks)"));
    }

    val include_deps: bool = p.req.include_deps;

    val res_sel: R.Result[*testrunner.Test, str] = A.allocate[testrunner.Test](p.alloc, sc.col.count::usize);
    if (R.is_err[*testrunner.Test, str](res_sel)) {
        free_scope(p, sc);
        ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory"));
    }
    sc.sel = R.unwrap_ok[*testrunner.Test, str](res_sel);
    var i: u32 = 0;
    for (i < sc.col.count) {
        if (test_selected(p, ?sc.col.tests[i], include_deps)) {
            sc.sel[sc.sel_len] = sc.col.tests[i];
            sc.sel_len = sc.sel_len + 1;
        }
        i = i + 1;
    }
    ret R.ok_void[outcome.Fail]();
}

pub fun free_scope(p: *driver.Project, sc: *TestScope) {
    if (sc.sel != nil && sc.have && sc.col.count > 0) {
        A.deallocate[testrunner.Test](p.alloc, sc.sel, sc.col.count::usize);
    }
    sc.sel     = nil;
    sc.sel_len = 0;
    if (sc.have) {
        testrunner.free(p.s, ?sc.col);
        sc.have = false;
    }
}

pub fun record_tests(p: *driver.Project, sc: *TestScope, exe: *u8,
                     bo: *outcome.BuildOutcome, oa: *A.Allocator) R.Result[R.Void, outcome.Fail] {
    var k: u32 = 0;
    for (k < sc.sel_len) {
        val rc: R.Result[R.Void, outcome.Fail] = record_test(p, ?sc.sel[k], exe, k, bo);
        if (R.is_err[R.Void, outcome.Fail](rc)) { ret rc; }
        k = k + 1;
    }
    ret R.ok_void[outcome.Fail]();
}

fun test_selected(p: *driver.Project, t: *testrunner.Test, include_deps: bool) bool {
    if (include_deps) { ret true; }
    ret test_in_project(p, t);
}

fun test_in_project(p: *driver.Project, t: *testrunner.Test) bool {
    if (t.mod_idx >= p.module_len) { ret false; }
    val m: *driver.ModuleEntry = ?p.modules[t.mod_idx];
    ret driver.module_in_current_project(p, m.fqn);
}

pub rec DispatchInputs {
    shared:     **u8;
    shared_len: u32;
    borrowed:   u32;
    dynlibs:    *of.DynLib;
    dynlib_len: u32;
}

pub fun collect_dispatch_inputs(p: *driver.Project, unit: *plan.BuildUnit,
                                obj_paths: **u8) R.Result[DispatchInputs, outcome.Fail] {
    var di: DispatchInputs;
    di.shared     = nil;
    di.shared_len = 0;
    di.borrowed   = p.emit_len;
    di.dynlibs    = nil;
    di.dynlib_len = 0;

    val res_sh: R.Result[**u8, str] = A.allocate[*u8](p.alloc, di.borrowed::usize);
    if (R.is_err[**u8, str](res_sh)) { ret R.err[DispatchInputs, outcome.Fail](outcome.internal("out of memory")); }
    di.shared = R.unwrap_ok[**u8, str](res_sh);
    var i: u32 = 0;
    for (i < di.borrowed) { di.shared[i] = obj_paths[i]; i = i + 1; }
    di.shared_len = di.borrowed;

    val ec: R.Result[R.Void, outcome.Fail] = emit.append_external_inputs(p, unit, ?di.shared, ?di.shared_len, ?di.dynlibs, ?di.dynlib_len);
    if (R.is_err[R.Void, outcome.Fail](ec)) {
        free_dispatch_inputs(p, ?di);
        ret R.err[DispatchInputs, outcome.Fail](R.unwrap_err[R.Void, outcome.Fail](ec));
    }
    ret R.ok[DispatchInputs, outcome.Fail](di);
}

pub fun free_dispatch_inputs(p: *driver.Project, di: *DispatchInputs) {
    free_shared(p, di.shared, di.shared_len, di.borrowed);
    emit.free_dynlibs(p.alloc, di.dynlibs, di.dynlib_len);
    di.shared     = nil;
    di.shared_len = 0;
    di.dynlibs    = nil;
    di.dynlib_len = 0;
}

pub fun link_dispatcher(p: *driver.Project, unit: *plan.BuildUnit, sc: *TestScope,
                        di: *DispatchInputs) R.Result[R.Void, outcome.Fail] {
    val te: *driver.TargetEntry = p.target_entry;
    if (te == nil) {
        ret R.err[R.Void, outcome.Fail](outcome.internal("no target selected"));
    }

    val shared: **u8       = di.shared;
    val shared_len: u32    = di.shared_len;
    val dynlibs: *of.DynLib = di.dynlibs;
    val dynlib_len: u32     = di.dynlib_len;

    var scratch_backing: A.Allocator;
    if (O.is_some[str](page.make(?scratch_backing))) {
        ret R.err[R.Void, outcome.Fail](outcome.internal("failed to initialise test allocator"));
    }
    var scratch_ar: arena.Arena;
    if (O.is_some[str](arena.init(?scratch_ar, ?scratch_backing, 0))) {
        ret R.err[R.Void, outcome.Fail](outcome.internal("failed to initialise test allocator"));
    }
    var scratch_alloc: A.Allocator;
    if (O.is_some[str](arena.make(?scratch_alloc, ?scratch_ar))) {
        arena.dnit(?scratch_ar);
        ret R.err[R.Void, outcome.Fail](outcome.internal("failed to initialise test allocator"));
    }

    val persistent: *A.Allocator = p.s.alloc;

    p.s.alloc = ?scratch_alloc;
    val result: R.Result[R.Void, outcome.Fail] = build_dispatch_executable(p, unit, unit.obj_dir::*u8,
                                              sc.sel, sc.sel_len, shared, shared_len,
                                              dynlibs, dynlib_len);
    p.s.alloc = persistent;
    arena.dnit(?scratch_ar);
    ret result;
}

pub fun fingerprint_scope(fb: *dq.FpBuf, p: *driver.Project, sc: *TestScope) R.Result[R.Void, str] {
    val rc: R.Result[R.Void, str] = dq.fp_u32(fb, sc.sel_len);
    if (R.is_err[R.Void, str](rc)) { ret rc; }
    var i: u32 = 0;
    for (i < sc.sel_len) {
        val t: *testrunner.Test = ?sc.sel[i];
        val rl: R.Result[R.Void, str] = dq.fp_cstr(fb, scope_name(p, t.linkage)); if (R.is_err[R.Void, str](rl)) { ret rl; }
        val rb: R.Result[R.Void, str] = dq.fp_cstr(fb, scope_name(p, t.label));   if (R.is_err[R.Void, str](rb)) { ret rb; }
        val rn: R.Result[R.Void, str] = dq.fp_u32(fb, t.line);                    if (R.is_err[R.Void, str](rn)) { ret rn; }
        val rm: R.Result[R.Void, str] = dq.fp_u32(fb, t.mod_idx);                 if (R.is_err[R.Void, str](rm)) { ret rm; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun scope_name(p: *driver.Project, id: intern.StrId) *u8 {
    val nm: O.Option[str] = intern.lookup(?p.s.interner, id);
    if (O.is_some[str](nm)) { ret O.unwrap[str](nm)::*u8; }
    ret ""::*u8;
}

fun free_shared(p: *driver.Project, shared: **u8, shared_len: u32, borrowed: u32) {
    if (shared == nil) { ret; }
    var i: u32 = borrowed;
    for (i < shared_len) {
        if (shared[i] != nil) {
            A.deallocate[u8](p.alloc, shared[i], (str_len(shared[i]::str) + 1)::usize);
        }
        i = i + 1;
    }
    A.deallocate[*u8](p.alloc, shared, shared_len::usize);
}

fun build_dispatch_executable(p: *driver.Project, unit: *plan.BuildUnit, obj_base: *u8,
                              sel: *testrunner.Test, sel_len: u32,
                              shared: **u8, shared_len: u32,
                              dynlibs: *of.DynLib, dynlib_len: u32) R.Result[R.Void, outcome.Fail] {
    val res_synth: R.Result[ir.Module, fail.Fail] = testrunner.synthesize_dispatcher(p.s, sel, sel_len);
    if (R.is_err[ir.Module, fail.Fail](res_synth)) {
        ret R.err[R.Void, outcome.Fail](outcome.from_fail(R.unwrap_err[ir.Module, fail.Fail](res_synth)));
    }
    var entry_ir: ir.Module = R.unwrap_ok[ir.Module, fail.Fail](res_synth);

    var preq: pipeline.PipelineRequest;
    preq.module            = ?entry_ir;
    preq.target             = ?p.target;
    preq.level               = p.req.opt;
    preq.vectorize_enabled   = pipeline.VectorizeEnabledOption{ v: p.req.vectorize };
    preq.simd_require        = pipeline.SimdRequireOption{ v: p.req.simd == manifest.SIMD_REQUIRE };
    preq.float_reassoc       = pipeline.FloatReassocOption{ v: p.req.float_reassoc };
    preq.interner            = ?p.s.interner;
    preq.source_map          = ?p.s.sources;
    val res_opt: R.Result[bool, str] = pipeline.run(?preq);
    if (R.is_err[bool, str](res_opt)) {
        ir.dnit(?entry_ir);
        ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[bool, str](res_opt)));
    }

    val dbg_r: R.Result[codegen.DebugInfo, str] = driver.debug_info_of(p);
    if (R.is_err[codegen.DebugInfo, str](dbg_r)) {
        ir.dnit(?entry_ir);
        ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[codegen.DebugInfo, str](dbg_r)));
    }

    val res_codegen: R.Result[of.ObjectImage, str] = codegen.codegen_module(p.s, ?p.target, ?entry_ir, cgunit.ir_set_empty(), nil, p.req.placement_policy, R.unwrap_ok[codegen.DebugInfo, str](dbg_r));
    if (R.is_err[of.ObjectImage, str](res_codegen)) {
        ir.dnit(?entry_ir);
        ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[of.ObjectImage, str](res_codegen)));
    }
    var entry_img: of.ObjectImage = R.unwrap_ok[of.ObjectImage, str](res_codegen);

    val ep_r: R.Result[str, str] = path.join(p.alloc, obj_base::str, "__mach_test_dispatch.o");
    if (R.is_err[str, str](ep_r)) {
        obj.dnit(?entry_img);
        ir.dnit(?entry_ir);
        ret R.err[R.Void, outcome.Fail](outcome.internal("failed to create test object directory"));
    }
    val entry_path: str = R.unwrap_ok[str, str](ep_r);
    if (O.is_some[str](emit.ensure_parents(p.alloc, entry_path))) {
        obj.dnit(?entry_img);
        ir.dnit(?entry_ir);
        ret R.err[R.Void, outcome.Fail](outcome.internal("failed to create test object directory"));
    }
    val res_emit: R.Result[R.Void, str] = obj.emit(?entry_img, ?p.target, entry_path);
    obj.dnit(?entry_img);
    ir.dnit(?entry_ir);
    if (R.is_err[R.Void, str](res_emit)) {
        ret R.err[R.Void, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](res_emit)));
    }

    if (O.is_some[str](emit.ensure_parents(p.alloc, unit.out_path))) {
        ret R.err[R.Void, outcome.Fail](outcome.internal("failed to resolve the test executable path; check the `tests` template in mach.toml"));
    }

    ret link_one_test(p, shared, shared_len, dynlibs, dynlib_len, entry_path, unit.out_path::*u8);
}

fun link_one_test(p: *driver.Project, shared: **u8, shared_len: u32,
                  dynlibs: *of.DynLib, dynlib_len: u32,
                  entry_path: *u8, exe_path: *u8) R.Result[R.Void, outcome.Fail] {
    val total: u32 = shared_len + 1;
    val res_paths: R.Result[**u8, str] = A.allocate[*u8](p.alloc, total::usize);
    if (R.is_err[**u8, str](res_paths)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    val paths: **u8 = R.unwrap_ok[**u8, str](res_paths);

    val per_module: u32 = p.emit_len;
    var i: u32 = 0;
    for (i < per_module) { paths[i] = shared[i]; i = i + 1; }
    paths[per_module] = entry_path;
    var j: u32 = per_module;
    for (j < shared_len) { paths[j + 1] = shared[j]; j = j + 1; }

    val res_link: R.Result[R.Void, str] =
        linker.link(p.s, ?p.target, paths, total, dynlibs, dynlib_len, exe_path, emit.artifact_product_name(p), linker.LINK_EXE, p.req.pie, of.image_options_default(p.req.subsystem));
    A.deallocate[*u8](p.alloc, paths, total::usize);
    if (R.is_err[R.Void, str](res_link)) {
        ret R.err[R.Void, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](res_link)));
    }
    ret R.ok_void[outcome.Fail]();
}

fun record_test(p: *driver.Project, t: *testrunner.Test, exe: *u8, idx: u32,
                bo: *outcome.BuildOutcome) R.Result[R.Void, outcome.Fail] {
    val opt_label: O.Option[str] = intern.lookup(?p.s.interner, t.label);
    var label_src: str = "<test>";
    if (O.is_some[str](opt_label)) { label_src = O.unwrap[str](opt_label); }

    val rec_r: R.Result[R.Void, str] = outcome.record_test(bo,
        test_module_fqn(p, t.mod_idx)::str, label_src, test_source_path(p, t.mod_idx)::str,
        t.line, exe::str, idx);
    if (R.is_err[R.Void, str](rec_r)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    ret R.ok_void[outcome.Fail]();
}

fun test_module_fqn(p: *driver.Project, mod_idx: u32) *u8 {
    if (mod_idx >= p.module_len) { ret "<unknown>"; }
    val m: *driver.ModuleEntry = ?p.modules[mod_idx];
    val opt_fqn: O.Option[str] = intern.lookup(?p.s.interner, m.fqn);
    if (O.is_none[str](opt_fqn)) { ret "<unknown>"; }
    ret O.unwrap[str](opt_fqn)::*u8;
}

fun test_source_path(p: *driver.Project, mod_idx: u32) *u8 {
    if (mod_idx >= p.module_len) { ret "<unknown>"; }
    val m: *driver.ModuleEntry = ?p.modules[mod_idx];
    val opt_file: O.Option[*source.SourceFile] = source.get(?p.s.sources, m.file_id);
    if (O.is_none[*source.SourceFile](opt_file)) { ret "<unknown>"; }
    ret O.unwrap[*source.SourceFile](opt_file).path::*u8;
}

fun testing_name(s: *session.Session, name: str) intern.StrId {
    val r: R.Result[intern.StrId, str] = intern.intern(?s.interner, name);
    if (R.is_err[intern.StrId, str](r)) { ret intern.STR_NIL; }
    ret R.unwrap_ok[intern.StrId, str](r);
}

fun remove_coff_atom_files(a: *fs.TempFile, b: *fs.TempFile, out: *fs.TempFile) {
    fs.temp_remove(a);
    fs.temp_remove(b);
    fs.temp_remove(out);
}

test "mach.lang.build.testing:coff_final_link_discards_losing_weak_body" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) {
        session.dnit(?s);
        ret 1;
    }
    val tr: R.Result[target.Target, str] =
        target.select(?reg, "x86_64", "windows", "win64");
    if (R.is_err[target.Target, str](tr)) {
        session.dnit(?s);
        ret 1;
    }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);

    val text: intern.StrId = testing_name(?s, ".text");
    val entry: intern.StrId = testing_name(?s, "mainCRTStartup");
    val weak: intern.StrId = testing_name(?s, "dedup$u64");
    val winner_name: intern.StrId = testing_name(?s, "coff-winner");
    val loser_name: intern.StrId = testing_name(?s, "coff-loser");
    if (text == intern.STR_NIL || entry == intern.STR_NIL || weak == intern.STR_NIL
        || winner_name == intern.STR_NIL || loser_name == intern.STR_NIL) {
        session.dnit(?s);
        ret 1;
    }

    var winner_bytes: [16]u8;
    var loser_bytes: [8]u8;
    var i: u32 = 0;
    for (i < 8) {
        winner_bytes[i] = 0xC3;
        winner_bytes[8 + i] = (0x40 + i)::u8;
        loser_bytes[i] = (0xA0 + i)::u8;
        i = i + 1;
    }

    var winner_sections: [1]of.Section;
    var loser_sections: [1]of.Section;
    winner_sections[0].name = text;
    winner_sections[0].kind = of.SK_TEXT;
    winner_sections[0].bytes = ?winner_bytes[0];
    winner_sections[0].len = 16;
    winner_sections[0].align = 8;
    loser_sections[0].name = text;
    loser_sections[0].kind = of.SK_TEXT;
    loser_sections[0].bytes = ?loser_bytes[0];
    loser_sections[0].len = 8;
    loser_sections[0].align = 8;

    val strong_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    val weak_flags: u32 =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    var winner_symbols: [2]of.Symbol;
    var loser_symbols: [1]of.Symbol;
    winner_symbols[0].name = entry;
    winner_symbols[0].section = 0;
    winner_symbols[0].offset = 0;
    winner_symbols[0].size = 8;
    winner_symbols[0].flags = strong_flags;
    winner_symbols[1].name = weak;
    winner_symbols[1].section = 0;
    winner_symbols[1].offset = 8;
    winner_symbols[1].size = 8;
    winner_symbols[1].flags = weak_flags;
    loser_symbols[0].name = weak;
    loser_symbols[0].section = 0;
    loser_symbols[0].offset = 0;
    loser_symbols[0].size = 8;
    loser_symbols[0].flags = weak_flags;

    var winner: of.ObjectImage;
    winner.alloc = ?alloc;
    winner.interner = ?s.interner;
    winner.name = winner_name;
    winner.sections = ?winner_sections[0];
    winner.section_count = 1;
    winner.symbols = ?winner_symbols[0];
    winner.symbol_count = 2;
    winner.relocations = nil;
    winner.reloc_count = 0;
    var loser: of.ObjectImage;
    loser.alloc = ?alloc;
    loser.interner = ?s.interner;
    loser.name = loser_name;
    loser.sections = ?loser_sections[0];
    loser.section_count = 1;
    loser.symbols = ?loser_symbols[0];
    loser.symbol_count = 1;
    loser.relocations = nil;
    loser.reloc_count = 0;

    val ar: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_coff_atom_a");
    if (R.is_err[fs.TempFile, str](ar)) { session.dnit(?s); ret 1; }
    var af: fs.TempFile = R.unwrap_ok[fs.TempFile, str](ar);
    val br: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_coff_atom_b");
    if (R.is_err[fs.TempFile, str](br)) {
        fs.temp_close_and_remove(?af);
        session.dnit(?s);
        ret 1;
    }
    var bf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](br);
    val er: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_coff_atom_exe");
    if (R.is_err[fs.TempFile, str](er)) {
        fs.temp_close_and_remove(?af);
        fs.temp_close_and_remove(?bf);
        session.dnit(?s);
        ret 1;
    }
    var ef: fs.TempFile = R.unwrap_ok[fs.TempFile, str](er);
    val apath: str = fs.temp_path(?af);
    val bpath: str = fs.temp_path(?bf);
    val epath: str = fs.temp_path(?ef);
    val ac: O.Option[str] = fs.temp_close(?af);
    val bc: O.Option[str] = fs.temp_close(?bf);
    val ec: O.Option[str] = fs.temp_close(?ef);
    if (O.is_some[str](ac) || O.is_some[str](bc) || O.is_some[str](ec)) {
        remove_coff_atom_files(?af, ?bf, ?ef);
        session.dnit(?s);
        ret 1;
    }

    var bad: i32 = 0;
    if (R.is_err[R.Void, str](obj.emit(?winner, ?tgt, apath::*u8))) { bad = 1; }
    if (bad == 0 && R.is_err[R.Void, str](obj.emit(?loser, ?tgt, bpath::*u8))) { bad = 1; }

    var control: Vector[u8];
    var combined: Vector[u8];
    var have_control: bool = false;
    var have_combined: bool = false;
    var one: [1]*u8;
    one[0] = apath::*u8;
    if (bad == 0) {
        val lr: R.Result[R.Void, str] =
            linker.link(?s, ?tgt, ?one[0], 1, nil, 0, epath::*u8,
                        "coff-atom-test", linker.LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
        if (R.is_err[R.Void, str](lr)) { bad = 1; }
    }
    if (bad == 0) {
        val rr: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, epath);
        if (R.is_err[Vector[u8], str](rr)) { bad = 1; }
        or { control = R.unwrap_ok[Vector[u8], str](rr); have_control = true; }
    }

    var both: [2]*u8;
    both[0] = apath::*u8;
    both[1] = bpath::*u8;
    if (bad == 0) {
        val lr: R.Result[R.Void, str] =
            linker.link(?s, ?tgt, ?both[0], 2, nil, 0, epath::*u8,
                        "coff-atom-test", linker.LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
        if (R.is_err[R.Void, str](lr)) { bad = 1; }
    }
    if (bad == 0) {
        val rr: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, epath);
        if (R.is_err[Vector[u8], str](rr)) { bad = 1; }
        or { combined = R.unwrap_ok[Vector[u8], str](rr); have_combined = true; }
    }

    if (bad == 0 && control.len != combined.len) { bad = 1; }
    var at: usize = 0;
    for (bad == 0 && at < control.len) {
        if (control.data[at] != combined.data[at]) { bad = 1; }
        at = at + 1;
    }

    if (have_control)  { vector.dnit[u8](?control); }
    if (have_combined) { vector.dnit[u8](?combined); }
    remove_coff_atom_files(?af, ?bf, ?ef);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.build.testing.classify_subprocess:maps_every_terminal_and_capture_shape" {
    var term: subprocess.SubprocessTerminal;
    var cap: subprocess.CaptureIoResult;
    cap.bytes        = 0;
    cap.truncated     = false;
    cap.short_read    = false;
    cap.read_failed   = false;
    cap.write_failed  = false;
    cap.close_failed  = false;
    cap.closed        = true;
    cap.owned         = true;

    var bad: i32 = 0;

    term.kind = subprocess.STATE_EXITED;
    term.code = 0;
    val pass_r: validation.ValidationGateResult = classify_subprocess(?term, false, true, ?cap);
    if (pass_r.kind != validation.RESULT_PASS || pass_r.cause != validation.CAUSE_PASS) { bad = 1; }

    term.code = 7;
    val exit_r: validation.ValidationGateResult = classify_subprocess(?term, false, true, ?cap);
    if (exit_r.kind != validation.RESULT_SEMANTIC_MISMATCH || exit_r.cause != validation.CAUSE_ORACLE_EXIT) { bad = 1; }

    term.kind = subprocess.STATE_SIGNALED;
    term.code = 9;
    val sig_r: validation.ValidationGateResult = classify_subprocess(?term, false, true, ?cap);
    if (sig_r.kind != validation.RESULT_SEMANTIC_MISMATCH || sig_r.cause != validation.CAUSE_ORACLE_SIGNAL) { bad = 1; }

    term.kind = subprocess.STATE_SPAWN_FAILURE;
    term.code = 0;
    val spawn_r: validation.ValidationGateResult = classify_subprocess(?term, false, true, ?cap);
    if (spawn_r.kind != validation.RESULT_INFRASTRUCTURE_FAILURE || spawn_r.cause != validation.CAUSE_ORACLE_SPAWN_FAILURE) { bad = 1; }

    term.kind = subprocess.STATE_UNSTARTED;
    val invalid_r: validation.ValidationGateResult = classify_subprocess(?term, false, true, ?cap);
    if (invalid_r.kind != validation.RESULT_INFRASTRUCTURE_FAILURE || invalid_r.cause != validation.CAUSE_INVALID_TERMINAL) { bad = 1; }

    term.kind = subprocess.STATE_EXITED;
    term.code = 0;
    val no_capture_r: validation.ValidationGateResult = classify_subprocess(?term, false, false, ?cap);
    if (no_capture_r.kind != validation.RESULT_INFRASTRUCTURE_FAILURE || no_capture_r.cause != validation.CAUSE_ORACLE_CAPTURE) { bad = 1; }

    term.kind = subprocess.STATE_SIGNALED;
    term.code = 15;
    val timeout_r: validation.ValidationGateResult = classify_subprocess(?term, true, true, ?cap);
    if (timeout_r.kind != validation.RESULT_RESOURCE_EXHAUSTION || timeout_r.cause != validation.CAUSE_ORACLE_TIMEOUT) { bad = 1; }

    term.kind = subprocess.STATE_EXITED;
    term.code = 0;
    val timeout_capture_r: validation.ValidationGateResult = classify_subprocess(?term, true, false, ?cap);
    if (timeout_capture_r.kind != validation.RESULT_INFRASTRUCTURE_FAILURE || timeout_capture_r.cause != validation.CAUSE_ORACLE_CAPTURE) { bad = 1; }

    cap.read_failed = true;
    val bad_read_r: validation.ValidationGateResult = classify_subprocess(?term, false, true, ?cap);
    if (bad_read_r.kind != validation.RESULT_INFRASTRUCTURE_FAILURE || bad_read_r.cause != validation.CAUSE_ORACLE_CAPTURE) { bad = 1; }
    cap.read_failed = false;

    cap.write_failed = true;
    val bad_write_r: validation.ValidationGateResult = classify_subprocess(?term, false, true, ?cap);
    if (bad_write_r.kind != validation.RESULT_INFRASTRUCTURE_FAILURE || bad_write_r.cause != validation.CAUSE_ORACLE_CAPTURE) { bad = 1; }
    cap.write_failed = false;

    cap.close_failed = true;
    val bad_close_r: validation.ValidationGateResult = classify_subprocess(?term, false, true, ?cap);
    if (bad_close_r.kind != validation.RESULT_INFRASTRUCTURE_FAILURE || bad_close_r.cause != validation.CAUSE_ORACLE_CAPTURE) { bad = 1; }

    ret bad;
}

test "mach.lang.build.testing.classify_setup_failure_and_wait_failure:are_distinct_infrastructure_causes" {
    val setup_r: validation.ValidationGateResult = classify_setup_failure();
    val wait_r:  validation.ValidationGateResult = classify_wait_failure();
    if (setup_r.kind != validation.RESULT_INFRASTRUCTURE_FAILURE) { ret 1; }
    if (wait_r.kind != validation.RESULT_INFRASTRUCTURE_FAILURE)  { ret 2; }
    if (setup_r.cause == wait_r.cause)                            { ret 3; }
    ret 0;
}
