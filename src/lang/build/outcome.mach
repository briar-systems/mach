use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;

use std.text.string.str_free;
use std.text.string.str_dup;

use std.collections.vector;
use std.collections.vector.Vector;

use A: std.allocator;
use R: std.types.result;
use T: std.allocator.testing;
use format: std.format;
use page: std.allocator.page;
use binary: std.encoding.binary;
use env: std.process.env;
use exec: std.process.exec;
use fs: std.filesystem;
use io_error: std.io.error;
use os: std.system.os;
use parse: std.text.parse;
use reader: std.io.reader;
use removal: std.filesystem.removal;
use semver: std.types.semver;
use string: std.types.string;
use thread: std.sync.thread;
use toml: std.data.toml;
use txn: std.filesystem.transaction;
use writer: std.io.writer;

use mach.lang.alloc;
use mach.lang.diagnostic;
use mach.lang.source;
use mach.lang.validation;
use mach.lang.fail;

# the driver's failure: already reported through diagnostics, the input was
# wrong (a manifest error, a missing project), an invariant the compiler owns
# was broken, or the machine rather than the input (a tool that could not be
# spawned, a resource that was not there). the exit code derives from the
# case: 1 for user, 2 for internal, 3 where a command distinguishes the
# environment; a compiler failure never renders as a test failure. `reported`
# is declared first so a zero outcome is a failure that invents no text
pub tag Fail: u8 {
    reported;
    user:        str;
    internal:    str;
    environment: str;
}

pub fun reported() Fail { ret Fail.reported{}; }
pub fun user(message: str) Fail { ret Fail.user{message}; }
pub fun internal(message: str) Fail { ret Fail.internal{message}; }
pub fun environment(message: str) Fail { ret Fail.environment{message}; }

# an allocation refusal stays an internal failure (exit 2), as it always has;
# reclassifying it as environmental changes exit codes and is the CLI lane's
pub fun refused(e: A.Error) Fail { ret Fail.internal{alloc.text(e)}; }

# the text a std refusal renders as when a driver operation reports it: the
# operation keeps its own classification (user, internal, environment) and
# names the cause once through these. `alloc.text` is the allocator's
pub fun alloc_text(e: A.Error) str { ret alloc.text(e); }

pub fun io_text(e: io_error.Error) str { ret io_error.message(e); }

pub fun read_text(e: reader.ReadError) str {
    if (sel e.eof)         { ret "unexpected end of input"; }
    or (sel e.would_block) { ret "read would block"; }
    or (sel e.native)      { ret io_error.message(e.native.error); }
    ret alloc.text(e.alloc);
}

pub fun write_text(e: writer.WriteError) str {
    if (sel e.stalled)     { ret "short write"; }
    or (sel e.would_block) { ret "write would block"; }
    ret io_error.message(e.native.error);
}

pub fun fs_text(e: fs.FsError) str {
    if (sel e.io)        { ret io_error.message(e.io); }
    or (sel e.alloc)     { ret alloc.text(e.alloc); }
    or (sel e.read)      { ret read_text(e.read); }
    or (sel e.write)     { ret write_text(e.write); }
    or (sel e.removal)   { ret removal.message(e.removal); }
    or (sel e.exhausted) { ret "temp file: max attempts exceeded"; }
    ret io_error.message(e.published);
}

pub fun str_text(e: string.StrError) str {
    if (sel e.alloc) { ret alloc.text(e.alloc); }
    ret "slice out of bounds";
}

pub fun format_text(e: format.FormatError) str {
    if (sel e.syntax)     { ret "format: malformed format string"; }
    or (sel e.few_holes)  { ret "format: too few arguments"; }
    or (sel e.many_holes) { ret "format: too many arguments"; }
    or (sel e.write)      { ret write_text(e.write); }
    ret alloc.text(e.alloc);
}

pub fun encode_text(e: binary.EncodeError) str {
    if (sel e.alloc)     { ret alloc.text(e.alloc); }
    or (sel e.overflow)  { ret "encoder: length overflow"; }
    or (sel e.invalid)   { ret "encoder: invalid state"; }
    or (sel e.full)      { ret "encoder: capacity exhausted"; }
    or (sel e.alignment) { ret "encoder: alignment is not a power of two"; }
    or (sel e.reserved)  { ret "encoder: reservation pending"; }
    or (sel e.bounds)    { ret "encoder: checkpoint out of bounds"; }
    or (sel e.inactive)  { ret "encoder: no active builder"; }
    or (sel e.stale)     { ret "encoder: stale checkpoint"; }
    ret "encoder: busy";
}

pub fun decode_text(e: binary.DecodeError) str {
    if (sel e.short)     { ret "decoder: unexpected end of input"; }
    or (sel e.invalid)   { ret "decoder: invalid cursor"; }
    or (sel e.alignment) { ret "decoder: alignment is not a power of two"; }
    or (sel e.bounds)    { ret "decoder: checkpoint out of bounds"; }
    ret "decoder: unterminated string";
}

pub fun toml_text(e: toml.TomlError) str {
    if (sel e.syntax)   { ret "toml: syntax error"; }
    or (sel e.overflow) { ret "toml: integer overflow"; }
    or (sel e.depth)    { ret "toml: nesting too deep"; }
    or (sel e.conflict) { ret "toml: key conflicts with an existing value"; }
    ret alloc.text(e.alloc);
}

pub fun env_text(e: env.EnvError) str {
    if (sel e.native) { ret os.message(e.native); }
    or (sel e.alloc)  { ret alloc.text(e.alloc); }
    ret "environment changed during the read";
}

pub fun exec_text(e: exec.Error) str { ret exec.error_message(e); }

pub fun parse_text(e: parse.ParseError) str {
    if (sel e.empty)    { ret "empty number"; }
    or (sel e.syntax)   { ret "invalid digit"; }
    or (sel e.overflow) { ret "number out of range"; }
    ret "invalid base";
}

pub fun thread_text(e: thread.ThreadError) str {
    if (sel e.invalid)     { ret "thread handle is invalid"; }
    or (sel e.exhausted)   { ret "thread limit reached"; }
    or (sel e.unsupported) { ret "threads are unsupported on this platform"; }
    ret os.message(e.native);
}

pub fun txn_text(e: txn.Error) str { ret txn.error_message(e); }

pub fun semver_text(e: semver.SemverError) str {
    if (sel e.empty)  { ret "semver: empty version"; }
    or (sel e.syntax) { ret "semver: syntax error"; }
    ret alloc.text(e.alloc);
}

# translation shims (#3226): a legacy message result read by a migrated
# driver operation, classified as the site always classified it, and a typed
# outcome spelled as the legacy carrier for a consumer that has not migrated.
# removed by C5 with the last legacy carrier
pub fun lift_user[T](r: R.Result[T, str]) res[T, Fail] {
    if (R.is_err[T, str](r)) { ret res[T, Fail].err{user(R.unwrap_err[T, str](r))}; }
    ret res[T, Fail].ok{R.unwrap_ok[T, str](r)};
}

pub fun lift_internal[T](r: R.Result[T, str]) res[T, Fail] {
    if (R.is_err[T, str](r)) { ret res[T, Fail].err{internal(R.unwrap_err[T, str](r))}; }
    ret res[T, Fail].ok{R.unwrap_ok[T, str](r)};
}

pub fun lift_environment[T](r: R.Result[T, str]) res[T, Fail] {
    if (R.is_err[T, str](r)) { ret res[T, Fail].err{environment(R.unwrap_err[T, str](r))}; }
    ret res[T, Fail].ok{R.unwrap_ok[T, str](r)};
}

pub fun lift_user_unit(r: R.Result[R.Void, str]) err[Fail] {
    if (R.is_err[R.Void, str](r)) { ret err[Fail].err{user(R.unwrap_err[R.Void, str](r))}; }
    ret err[Fail].ok{};
}

pub fun lift_internal_unit(r: R.Result[R.Void, str]) err[Fail] {
    if (R.is_err[R.Void, str](r)) { ret err[Fail].err{internal(R.unwrap_err[R.Void, str](r))}; }
    ret err[Fail].ok{};
}

pub fun lift_environment_unit(r: R.Result[R.Void, str]) err[Fail] {
    if (R.is_err[R.Void, str](r)) { ret err[Fail].err{environment(R.unwrap_err[R.Void, str](r))}; }
    ret err[Fail].ok{};
}

pub fun lower[T](r: res[T, Fail]) R.Result[T, str] {
    if (sel r.err) { ret R.err[T, str](describe(r.err)); }
    ret R.ok[T, str](r.ok);
}

pub fun lower_unit(r: err[Fail]) R.Result[R.Void, str] {
    if (sel r.err) { ret R.err[R.Void, str](describe(r.err)); }
    ret R.ok_void[str]();
}

pub fun lower_fail[T](r: res[T, Fail]) R.Result[T, Fail] {
    if (sel r.err) { ret R.err[T, Fail](r.err); }
    ret R.ok[T, Fail](r.ok);
}

pub fun lower_fail_unit(r: err[Fail]) R.Result[R.Void, Fail] {
    if (sel r.err) { ret R.err[R.Void, Fail](r.err); }
    ret R.ok_void[Fail]();
}

pub fun is_reported(f: Fail) bool    { ret sel f.reported; }
pub fun is_user(f: Fail) bool        { ret sel f.user; }
pub fun is_internal(f: Fail) bool    { ret sel f.internal; }
pub fun is_environment(f: Fail) bool { ret sel f.environment; }

# the message a failure carries, absent for a reported one
pub fun text(f: Fail) opt[str] {
    if (sel f.user)        { ret opt[str].some{f.user}; }
    or (sel f.internal)    { ret opt[str].some{f.internal}; }
    or (sel f.environment) { ret opt[str].some{f.environment}; }
    ret opt[str].none{};
}

# the failure as one line of presentation text; a reported failure has no
# text of its own and is named as such, never as an empty message
pub fun describe(f: Fail) str {
    if (sel f.user)        { ret f.user; }
    or (sel f.internal)    { ret f.internal; }
    or (sel f.environment) { ret f.environment; }
    ret fail.REPORTED_TEXT;
}

# release the text a failure owns through `a`; a reported failure owns nothing
pub fun release_text(a: *A.Allocator, f: Fail) {
    val carried: opt[str] = text(f);
    if (sel carried.some) {
        if (carried.some != nil) { str_free(a, carried.some); }
    }
}

# the same failure carrying `message` instead: the case is kept, the text
# replaced (a caller that copies the message into storage it owns)
pub fun with_text(f: Fail, message: str) Fail {
    if (sel f.user)        { ret Fail.user{message}; }
    or (sel f.internal)    { ret Fail.internal{message}; }
    or (sel f.environment) { ret Fail.environment{message}; }
    ret Fail.reported{};
}

# the closed-catalog policy lifted into the driver's kind: an input or
# capability fault is the user's, a compiler-produced member is internal. the
# message belongs to the caller's allocator
pub fun catalog(a: *A.Allocator, c: fail.Catalog) Fail {
    val message: res[str, format.FormatError] = fail.catalog_text(a, c);
    if (sel message.err) {
        if (sel message.err.alloc) { ret refused(message.err.alloc); }
        ret internal("catalog diagnostic could not be formatted");
    }
    if (fail.is_internal_member(c)) { ret internal(message.ok); }
    ret user(message.ok);
}

pub fun unknown_catalog(a: *A.Allocator, catalog_name: str, tag: u32) Fail {
    ret catalog(a, fail.unknown_member(catalog_name, tag));
}

pub fun from_fail(f: fail.Fail) Fail {
    if (sel f.message) { ret internal(f.message); }
    ret reported();
}

pub def ArtifactKind: u8;
pub val ART_BINARY:  ArtifactKind = 0;
pub val ART_OBJECTS: ArtifactKind = 1;
pub val ART_ARCHIVE: ArtifactKind = 2;
pub val ART_SHARED:  ArtifactKind = 3;
pub val ART_TESTS:   ArtifactKind = 4;

pub rec Artifact {
    kind: ArtifactKind;
    path: str;
}

pub rec TestArtifact {
    module: *u8;
    label:  *u8;
    file:   *u8;
    line:   u32;
    exe:    *u8;
    idx:    u32;
}

pub rec BuildUnitEvent {
    artifact:     str;
    target:       str;
    has_artifact: bool;
}

pub rec DiagnosticBatch {
    sources: *source.SourceMap;
    diags:   *diagnostic.DiagnosticStore;
}

# what a build recorded, in order: a unit finished, a scalarization note
# (the count), a failure, or a batch of diagnostics with the sources they
# refer to. every payload is owned by the outcome's allocator
pub tag BuildEvent: u8 {
    unit:        BuildUnitEvent;
    note:        u32;
    fail:        Fail;
    diagnostics: DiagnosticBatch;
}

pub def BuildSeverity: u8;

pub val BUILD_OK:          BuildSeverity = 0;
pub val BUILD_USER:        BuildSeverity = 1;
pub val BUILD_ENVIRONMENT: BuildSeverity = 2;
pub val BUILD_INTERNAL:    BuildSeverity = 3;

pub rec BuildOutcome {
    severity:      BuildSeverity;
    artifacts:     Vector[Artifact];
    tests:         Vector[TestArtifact];
    events:        Vector[BuildEvent];
    tests_skipped: u32;
}

pub fun outcome_init(oa: *A.Allocator) BuildOutcome {
    var bo: BuildOutcome;
    bo.severity      = BUILD_OK;
    bo.artifacts     = vector.init[Artifact](oa);
    bo.tests         = vector.init[TestArtifact](oa);
    bo.events        = vector.init[BuildEvent](oa);
    bo.tests_skipped = 0;
    ret bo;
}

fun free_artifact(a: *A.Allocator, art: *Artifact) {
    if (art.path != nil) { str_free(a, art.path); }
}

fun free_test_artifact(a: *A.Allocator, t: *TestArtifact) {
    if (t.module != nil) { str_free(a, t.module::str); }
    if (t.label != nil)  { str_free(a, t.label::str); }
    if (t.file != nil)   { str_free(a, t.file::str); }
    if (t.exe != nil)    { str_free(a, t.exe::str); }
}

fun free_fail(a: *A.Allocator, f: *Fail) { release_text(a, @f); }

fun free_diagnostic_batch(a: *A.Allocator, batch: *DiagnosticBatch) {
    if (batch.diags != nil) {
        diagnostic.store_dnit(batch.diags);
        A.deallocate[diagnostic.DiagnosticStore](a, batch.diags, 1);
    }
    if (batch.sources != nil) {
        source.dnit(batch.sources);
        A.deallocate[source.SourceMap](a, batch.sources, 1);
    }
}

fun free_event(a: *A.Allocator, ev: *BuildEvent) {
    if (sel ev.unit) {
        if (ev.unit.artifact != nil) { str_free(a, ev.unit.artifact); }
        if (ev.unit.target != nil)   { str_free(a, ev.unit.target); }
    }
    or (sel ev.fail)        { free_fail(a, ?ev.fail); }
    or (sel ev.diagnostics) { free_diagnostic_batch(a, ?ev.diagnostics); }
}

pub fun outcome_dnit(bo: *BuildOutcome) {
    if (bo == nil) { ret; }

    var i: usize = 0;
    for (i < bo.artifacts.len) {
        free_artifact(bo.artifacts.a, ?bo.artifacts.data[i]);
        i = i + 1;
    }
    vector.dnit[Artifact](?bo.artifacts);

    var j: usize = 0;
    for (j < bo.tests.len) {
        free_test_artifact(bo.tests.a, ?bo.tests.data[j]);
        j = j + 1;
    }
    vector.dnit[TestArtifact](?bo.tests);

    var k: usize = 0;
    for (k < bo.events.len) {
        free_event(bo.events.a, ?bo.events.data[k]);
        k = k + 1;
    }
    vector.dnit[BuildEvent](?bo.events);

    bo.tests_skipped = 0;
    bo.severity       = BUILD_OK;
}

# every record_* copies what it stores into the outcome's allocator; a refused
# copy or push leaves the outcome exactly as it was and releases the copies
# made before the refusal
pub fun record_artifact(bo: *BuildOutcome, kind: ArtifactKind, path: str) err[A.Error] {
    val a: *A.Allocator = bo.artifacts.a;
    val dup_r: res[str, A.Error] = str_dup(a, path);
    if (sel dup_r.err) { ret err[A.Error].err{dup_r.err}; }

    var art: Artifact;
    art.kind = kind;
    art.path = dup_r.ok;

    val push_r: res[usize, A.Error] = vector.push[Artifact](?bo.artifacts, art);
    if (sel push_r.err) {
        str_free(a, art.path);
        ret err[A.Error].err{push_r.err};
    }
    ret err[A.Error].ok{};
}

pub fun record_test(bo: *BuildOutcome, module: str, label: str, file: str, line: u32, exe: str, idx: u32) err[A.Error] {
    val a: *A.Allocator = bo.tests.a;
    val mod_r: res[str, A.Error] = str_dup(a, module);
    if (sel mod_r.err) { ret err[A.Error].err{mod_r.err}; }
    val mod_owned: str = mod_r.ok;

    val label_r: res[str, A.Error] = str_dup(a, label);
    if (sel label_r.err) {
        str_free(a, mod_owned);
        ret err[A.Error].err{label_r.err};
    }
    val label_owned: str = label_r.ok;

    val file_r: res[str, A.Error] = str_dup(a, file);
    if (sel file_r.err) {
        str_free(a, mod_owned);
        str_free(a, label_owned);
        ret err[A.Error].err{file_r.err};
    }
    val file_owned: str = file_r.ok;

    var exe_owned: str = nil;
    if (exe != nil) {
        val exe_r: res[str, A.Error] = str_dup(a, exe);
        if (sel exe_r.err) {
            str_free(a, mod_owned);
            str_free(a, label_owned);
            str_free(a, file_owned);
            ret err[A.Error].err{exe_r.err};
        }
        exe_owned = exe_r.ok;
    }

    var t: TestArtifact;
    t.module = mod_owned::*u8;
    t.label  = label_owned::*u8;
    t.file   = file_owned::*u8;
    t.line   = line;
    t.exe    = exe_owned::*u8;
    t.idx    = idx;

    val push_r: res[usize, A.Error] = vector.push[TestArtifact](?bo.tests, t);
    if (sel push_r.err) {
        str_free(a, mod_owned);
        str_free(a, label_owned);
        str_free(a, file_owned);
        if (exe_owned != nil) { str_free(a, exe_owned); }
        ret err[A.Error].err{push_r.err};
    }
    ret err[A.Error].ok{};
}

pub fun record_unit(bo: *BuildOutcome, artifact: str, target: str, has_artifact: bool) err[A.Error] {
    var artifact_owned: str = nil;
    if (artifact != nil) {
        val artifact_r: res[str, A.Error] = str_dup(bo.events.a, artifact);
        if (sel artifact_r.err) { ret err[A.Error].err{artifact_r.err}; }
        artifact_owned = artifact_r.ok;
    }

    var target_owned: str = nil;
    if (target != nil) {
        val target_r: res[str, A.Error] = str_dup(bo.events.a, target);
        if (sel target_r.err) {
            if (artifact_owned != nil) { str_free(bo.events.a, artifact_owned); }
            ret err[A.Error].err{target_r.err};
        }
        target_owned = target_r.ok;
    }

    val ev: BuildEvent = BuildEvent.unit{BuildUnitEvent{artifact: artifact_owned, target: target_owned, has_artifact: has_artifact}};
    val push_r: res[usize, A.Error] = vector.push[BuildEvent](?bo.events, ev);
    if (sel push_r.err) {
        if (target_owned != nil)   { str_free(bo.events.a, target_owned); }
        if (artifact_owned != nil) { str_free(bo.events.a, artifact_owned); }
        ret err[A.Error].err{push_r.err};
    }
    ret err[A.Error].ok{};
}

pub fun record_note(bo: *BuildOutcome, scalarized: u32) err[A.Error] {
    val push_r: res[usize, A.Error] = vector.push[BuildEvent](?bo.events, BuildEvent.note{scalarized});
    if (sel push_r.err) { ret err[A.Error].err{push_r.err}; }
    ret err[A.Error].ok{};
}

# the failure is copied whole: its text into the outcome's allocator
pub fun record_fail(bo: *BuildOutcome, f: *Fail) err[A.Error] {
    var owned: Fail = reported();
    val carried: opt[str] = text(@f);
    if (sel carried.some) {
        var copied: str = nil;
        if (carried.some != nil) {
            val dup_r: res[str, A.Error] = str_dup(bo.events.a, carried.some);
            if (sel dup_r.err) { ret err[A.Error].err{dup_r.err}; }
            copied = dup_r.ok;
        }
        owned = with_text(@f, copied);
    }

    val push_r: res[usize, A.Error] = vector.push[BuildEvent](?bo.events, BuildEvent.fail{owned});
    if (sel push_r.err) {
        free_fail(bo.events.a, ?owned);
        ret err[A.Error].err{push_r.err};
    }
    ret err[A.Error].ok{};
}

# the batch is a composite of two subsystems' snapshots, so its refusal is
# the driver's failure: an internal one carrying the snapshot's own text, or
# the allocation refusal of the push
pub fun record_diagnostics(bo: *BuildOutcome, sources: *source.SourceMap, diags: *diagnostic.DiagnosticStore) err[Fail] {
    if (diagnostic.len(diags) == 0 && diagnostic.lost_count(diags) == 0) { ret err[Fail].ok{}; }

    val sources_r: R.Result[*source.SourceMap, str] = source.snapshot_from(sources, bo.events.a);
    if (R.is_err[*source.SourceMap, str](sources_r)) {
        ret err[Fail].err{internal(R.unwrap_err[*source.SourceMap, str](sources_r))};
    }
    val owned_sources: *source.SourceMap = R.unwrap_ok[*source.SourceMap, str](sources_r);

    val diags_r: R.Result[*diagnostic.DiagnosticStore, str] = diagnostic.snapshot_from(diags, 0, bo.events.a);
    if (R.is_err[*diagnostic.DiagnosticStore, str](diags_r)) {
        source.dnit(owned_sources);
        A.deallocate[source.SourceMap](bo.events.a, owned_sources, 1);
        ret err[Fail].err{internal(R.unwrap_err[*diagnostic.DiagnosticStore, str](diags_r))};
    }
    val owned_diags: *diagnostic.DiagnosticStore = R.unwrap_ok[*diagnostic.DiagnosticStore, str](diags_r);

    var batch: DiagnosticBatch;
    batch.sources = owned_sources;
    batch.diags   = owned_diags;
    val push_r: res[usize, A.Error] = vector.push[BuildEvent](?bo.events, BuildEvent.diagnostics{batch});
    if (sel push_r.err) {
        free_diagnostic_batch(bo.events.a, ?batch);
        ret err[Fail].err{refused(push_r.err)};
    }
    ret err[Fail].ok{};
}

pub fun severity_of(f: *Fail) BuildSeverity {
    if (sel f.environment) { ret BUILD_ENVIRONMENT; }
    or (sel f.internal)    { ret BUILD_INTERNAL; }
    ret BUILD_USER;
}

# a reported or user failure is the user's; the severity never regresses
pub fun fold_fail(bo: *BuildOutcome, f: *Fail) {
    val sev: BuildSeverity = severity_of(f);
    if (sev > bo.severity) { bo.severity = sev; }
}

# capacity is reserved for all three transfers before any element moves, so
# a refused reservation leaves both outcomes exactly as they were
pub fun merge(agg: *BuildOutcome, unit: *BuildOutcome) err[A.Error] {
    val ar: res[usize, A.Error] = vector.reserve[Artifact](?agg.artifacts, unit.artifacts.len);
    if (sel ar.err) { ret err[A.Error].err{ar.err}; }
    val tr: res[usize, A.Error] = vector.reserve[TestArtifact](?agg.tests, unit.tests.len);
    if (sel tr.err) { ret err[A.Error].err{tr.err}; }
    val er: res[usize, A.Error] = vector.reserve[BuildEvent](?agg.events, unit.events.len);
    if (sel er.err) { ret err[A.Error].err{er.err}; }

    var i: usize = 0;
    for (i < unit.artifacts.len) {
        val pr: res[usize, A.Error] = vector.push[Artifact](?agg.artifacts, unit.artifacts.data[i]);
        if (sel pr.err) { ret err[A.Error].err{pr.err}; }
        i = i + 1;
    }
    var j: usize = 0;
    for (j < unit.tests.len) {
        val pr: res[usize, A.Error] = vector.push[TestArtifact](?agg.tests, unit.tests.data[j]);
        if (sel pr.err) { ret err[A.Error].err{pr.err}; }
        j = j + 1;
    }
    var k: usize = 0;
    for (k < unit.events.len) {
        val pr: res[usize, A.Error] = vector.push[BuildEvent](?agg.events, unit.events.data[k]);
        if (sel pr.err) { ret err[A.Error].err{pr.err}; }
        k = k + 1;
    }

    agg.tests_skipped = agg.tests_skipped + unit.tests_skipped;
    if (unit.severity > agg.severity) { agg.severity = unit.severity; }

    vector.dnit[Artifact](?unit.artifacts);
    vector.dnit[TestArtifact](?unit.tests);
    vector.dnit[BuildEvent](?unit.events);
    unit.tests_skipped = 0;
    unit.severity       = BUILD_OK;
    ret err[A.Error].ok{};
}

pub rec GateTally {
    pass:                   u32;
    semantic_mismatch:      u32;
    unsupported_input:      u32;
    tool_unavailable:       u32;
    infrastructure_failure: u32;
    resource_exhaustion:    u32;
    invalid_injection:      u32;
    results:                Vector[validation.ValidationGateResult];
}

pub fun gate_tally_init(a: *A.Allocator) GateTally {
    var gt: GateTally;
    gt.pass                   = 0;
    gt.semantic_mismatch      = 0;
    gt.unsupported_input      = 0;
    gt.tool_unavailable       = 0;
    gt.infrastructure_failure = 0;
    gt.resource_exhaustion    = 0;
    gt.invalid_injection      = 0;
    gt.results                = vector.init[validation.ValidationGateResult](a);
    ret gt;
}

pub fun gate_tally_dnit(gt: *GateTally) {
    if (gt == nil) { ret; }
    var i: usize = 0;
    for (i < gt.results.len) {
        val r: *validation.ValidationGateResult = ?gt.results.data[i];
        if (r.detail_identity != nil) { str_free(gt.results.a, r.detail_identity); }
        i = i + 1;
    }
    vector.dnit[validation.ValidationGateResult](?gt.results);
    gt.pass                   = 0;
    gt.semantic_mismatch      = 0;
    gt.unsupported_input      = 0;
    gt.tool_unavailable       = 0;
    gt.infrastructure_failure = 0;
    gt.resource_exhaustion    = 0;
    gt.invalid_injection      = 0;
}

pub fun record_gate(gt: *GateTally, a: *A.Allocator, r: validation.ValidationGateResult) err[A.Error] {
    var stored: validation.ValidationGateResult = r;
    if (r.detail_identity != nil) {
        val dup_r: res[str, A.Error] = str_dup(a, r.detail_identity);
        if (sel dup_r.err) { ret err[A.Error].err{dup_r.err}; }
        stored.detail_identity = dup_r.ok;
    }

    val push_r: res[usize, A.Error] = vector.push[validation.ValidationGateResult](?gt.results, stored);
    if (sel push_r.err) {
        if (stored.detail_identity != nil) { str_free(a, stored.detail_identity); }
        ret err[A.Error].err{push_r.err};
    }

    if (r.kind == validation.RESULT_PASS)                   { gt.pass                   = gt.pass + 1;                   }
    or (r.kind == validation.RESULT_SEMANTIC_MISMATCH)      { gt.semantic_mismatch      = gt.semantic_mismatch + 1;      }
    or (r.kind == validation.RESULT_UNSUPPORTED_INPUT)      { gt.unsupported_input      = gt.unsupported_input + 1;      }
    or (r.kind == validation.RESULT_TOOL_UNAVAILABLE)       { gt.tool_unavailable       = gt.tool_unavailable + 1;       }
    or (r.kind == validation.RESULT_INFRASTRUCTURE_FAILURE) { gt.infrastructure_failure = gt.infrastructure_failure + 1; }
    or (r.kind == validation.RESULT_RESOURCE_EXHAUSTION)    { gt.resource_exhaustion    = gt.resource_exhaustion + 1;    }
    or (r.kind == validation.RESULT_INVALID_INJECTION)      { gt.invalid_injection      = gt.invalid_injection + 1;      }
    ret err[A.Error].ok{};
}

pub fun gate_tally_total(gt: *GateTally) u32 {
    ret gt.pass + gt.semantic_mismatch + gt.unsupported_input + gt.tool_unavailable
      + gt.infrastructure_failure + gt.resource_exhaustion + gt.invalid_injection;
}

fun t_refused(r: err[A.Error]) bool { ret sel r.err; }
fun t_accepted(r: err[A.Error]) bool { ret sel r.ok; }

fun t_note_is(ev: *BuildEvent, want: u32) bool {
    if (!sel ev.note) { ret false; }
    ret ev.note == want;
}

fun t_unit_is(ev: *BuildEvent, artifact: str, target: str) bool {
    if (!sel ev.unit) { ret false; }
    ret str_equals(ev.unit.artifact, artifact) && str_equals(ev.unit.target, target);
}

# the recorded failure keeps the case and owns a fresh copy of the text
fun t_fail_copied(ev: *BuildEvent, original: Fail) bool {
    if (!sel ev.fail) { ret false; }
    if (!sel ev.fail.user) { ret false; }
    if (!sel original.user) { ret false; }
    if (ev.fail.user == original.user) { ret false; }
    ret str_equals(ev.fail.user, original.user);
}

# the three closed-catalog classes land on distinct driver outcomes: a member
# from input or a cross-module product and a declared member a target cannot
# honor are the user's (exit 1), a member the compiler produced is internal
# (exit 2); each message names the catalog and the member
fun t_user_with(f: Fail, want: str) bool {
    if (!sel f.user) { ret false; }
    ret str_equals(f.user, want);
}

fun t_internal_with(f: Fail, want: str) bool {
    if (!sel f.internal) { ret false; }
    ret str_equals(f.internal, want);
}

fun t_release(a: *A.Allocator, f: Fail) {
    val carried: opt[str] = text(f);
    if (sel carried.some) { str_free(a, carried.some); }
}

test "mach.lang.build.outcome.catalog:three_classes_land_on_distinct_kinds_naming_catalog_and_member" {
    var a: A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    val malformed: Fail = catalog(?a, fail.malformed_member("SectionKind", 200));
    fin { t_release(?a, malformed); }
    if (!t_user_with(malformed, "malformed SectionKind tag 200")) { ret 2; }
    val unsupported: Fail = catalog(?a, fail.unsupported_member("Subsystem", "gui", "x86_64-linux"));
    fin { t_release(?a, unsupported); }
    if (!t_user_with(unsupported, "Subsystem gui is unsupported by x86_64-linux")) { ret 3; }
    val internal_fail: Fail = unknown_catalog(?a, "PhaseKind", 255);
    fin { t_release(?a, internal_fail); }
    if (!t_internal_with(internal_fail, "unknown PhaseKind tag 255")) { ret 4; }
    if (sel malformed.internal || sel unsupported.internal) { ret 5; }
    ret 0;
}

test "mach.lang.build.outcome.fail:cases_text_and_lift" {
    val r: Fail = reported();
    if (!sel r.reported) { ret 1; }
    val rt: opt[str] = text(r);
    if (!sel rt.none) { ret 2; }
    if (!t_user_with(user("nope"), "nope")) { ret 3; }
    if (!t_internal_with(internal("boom"), "boom")) { ret 4; }
    val e: Fail = environment("disk full");
    if (!sel e.environment) { ret 5; }
    val et: opt[str] = text(e);
    if (!sel et.some) { ret 6; }
    if (!str_equals(et.some, "disk full")) { ret 6; }
    if (!t_internal_with(refused(A.Error.exhausted{}), "out of memory")) { ret 7; }
    if (!t_internal_with(from_fail(fail.message("lower: bad")), "lower: bad")) { ret 8; }
    val lifted: Fail = from_fail(fail.reported());
    if (!sel lifted.reported) { ret 9; }
    val kept: Fail = with_text(e, "replaced");
    if (!sel kept.environment) { ret 10; }
    if (!str_equals(kept.environment, "replaced")) { ret 10; }
    val still: Fail = with_text(r, "ignored");
    if (!sel still.reported) { ret 11; }
    var zero: Fail;
    if (!sel zero.reported) { ret 12; }
    if (severity_of(?r) != BUILD_USER || severity_of(?e) != BUILD_ENVIRONMENT) { ret 13; }
    ret 0;
}

test "mach.lang.build.outcome.outcome_init:round_trips_empty_and_populated" {
    var a: A.Allocator;
    page.make(?a);
    var bo: BuildOutcome = outcome_init(?a);

    var bad: i32 = 0;
    if (bo.severity != BUILD_OK)      { bad = 1; }
    if (bo.artifacts.len != 0)        { bad = 1; }
    if (bo.tests.len != 0)            { bad = 1; }
    if (bo.events.len != 0)           { bad = 1; }
    if (bo.tests_skipped != 0)        { bad = 1; }
    outcome_dnit(?bo);

    var bo2: BuildOutcome = outcome_init(?a);
    if (t_refused(record_artifact(?bo2, ART_BINARY, "out/bin/x")))        { bad = 1; }
    if (t_refused(record_test(?bo2, "m", "l", "f", 3, nil, 0)))           { bad = 1; }
    if (t_refused(record_unit(?bo2, "x", "native", true)))                 { bad = 1; }
    if (t_refused(record_note(?bo2, 2)))                                   { bad = 1; }
    if (bo2.artifacts.len != 1 || bo2.tests.len != 1 || bo2.events.len != 2)         { bad = 1; }
    outcome_dnit(?bo2);
    if (bo2.artifacts.len != 0 || bo2.tests.len != 0)                               { bad = 1; }

    ret bad;
}

test "mach.lang.build.outcome.record_artifact:fails_closed_without_a_partial_record" {
    var backing: A.Allocator;
    page.make(?backing);
    var failing: T.Testing;
    val made: err[A.Error] = T.make(?failing);
    if (sel made.err) { ret 1; }
    T.fail_at_ordinal(?failing, 1::usize);

    var bo: BuildOutcome = outcome_init(T.allocator_of(?failing));
    if (t_accepted(record_artifact(?bo, ART_BINARY, "out/bin/x"))) { ret 1; }
    if (bo.artifacts.len != 0) { ret 1; }

    outcome_dnit(?bo);
    if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
    if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
    T.dnit(?failing);
    ret 0;
}

test "mach.lang.build.outcome.record_test:rolls_back_every_owned_string_on_failure" {
    var found: bool = false;
    var ordinal: u64 = 1;
    for (ordinal <= 16 && !found) {
        var backing: A.Allocator;
        page.make(?backing);
        var failing: T.Testing;
        val made: err[A.Error] = T.make(?failing);
    if (sel made.err) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);

        var bo: BuildOutcome = outcome_init(T.allocator_of(?failing));
        val r: err[A.Error] = record_test(?bo, "mod", "label", "file.mach", 7, "exe", 2);
        if (sel r.err && bo.tests.len == 0) { found = true; }

        outcome_dnit(?bo);
        if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }
    if (!found) { ret 1; }
    ret 0;
}

test "mach.lang.build.outcome.fold_fail:internal_dominates_and_never_regresses" {
    var bo: BuildOutcome;
    bo.severity      = BUILD_OK;
    bo.tests_skipped = 0;

    var reported_f: Fail = reported();
    fold_fail(?bo, ?reported_f);
    if (bo.severity != BUILD_USER) { ret 1; }

    var env_f: Fail = environment("disk full");
    fold_fail(?bo, ?env_f);
    if (bo.severity != BUILD_ENVIRONMENT) { ret 2; }

    var user_f: Fail = user("nope");
    fold_fail(?bo, ?user_f);
    if (bo.severity != BUILD_ENVIRONMENT) { ret 3; }

    var internal_f: Fail = internal("boom");
    fold_fail(?bo, ?internal_f);
    if (bo.severity != BUILD_INTERNAL) { ret 4; }

    var env_f2: Fail = environment("disk full again");
    fold_fail(?bo, ?env_f2);
    if (bo.severity != BUILD_INTERNAL) { ret 5; }

    ret 0;
}

test "mach.lang.build.outcome.merge:severity_and_skipped_are_order_independent" {
    var a: A.Allocator;
    page.make(?a);

    var agg_first: BuildOutcome = outcome_init(?a);
    var user_unit: BuildOutcome = outcome_init(?a);
    user_unit.severity      = BUILD_USER;
    user_unit.tests_skipped = 3;
    var internal_unit: BuildOutcome = outcome_init(?a);
    internal_unit.severity      = BUILD_INTERNAL;
    internal_unit.tests_skipped = 2;

    if (t_refused(merge(?agg_first, ?user_unit)))     { ret 1; }
    if (t_refused(merge(?agg_first, ?internal_unit))) { ret 2; }
    if (agg_first.severity != BUILD_INTERNAL)                   { ret 3; }
    if (agg_first.tests_skipped != 5)                           { ret 4; }
    outcome_dnit(?agg_first);

    var agg_second: BuildOutcome = outcome_init(?a);
    var internal_unit2: BuildOutcome = outcome_init(?a);
    internal_unit2.severity      = BUILD_INTERNAL;
    internal_unit2.tests_skipped = 2;
    var user_unit2: BuildOutcome = outcome_init(?a);
    user_unit2.severity      = BUILD_USER;
    user_unit2.tests_skipped = 3;

    if (t_refused(merge(?agg_second, ?internal_unit2))) { ret 5; }
    if (t_refused(merge(?agg_second, ?user_unit2)))     { ret 6; }
    if (agg_second.severity != BUILD_INTERNAL)                    { ret 7; }
    if (agg_second.tests_skipped != 5)                            { ret 8; }
    outcome_dnit(?agg_second);

    ret 0;
}

test "mach.lang.build.outcome.merge:transfers_artifacts_and_tests_and_empties_the_source" {
    var a: A.Allocator;
    page.make(?a);

    var agg: BuildOutcome = outcome_init(?a);
    if (t_refused(record_artifact(?agg, ART_BINARY, "agg-existing")))      { ret 1; }

    var unit: BuildOutcome = outcome_init(?a);
    if (t_refused(record_artifact(?unit, ART_OBJECTS, "unit-object")))     { ret 2; }
    if (t_refused(record_test(?unit, "m", "l", "f", 1, nil, 0)))           { ret 3; }
    if (t_refused(record_note(?unit, 4)))                                  { ret 3; }

    if (t_refused(merge(?agg, ?unit))) { ret 4; }

    var bad: i32 = 0;
    if (agg.artifacts.len != 2)                                             { bad = 1; }
    or (!str_equals(agg.artifacts.data[0].path, "agg-existing"))            { bad = 1; }
    or (!str_equals(agg.artifacts.data[1].path, "unit-object"))             { bad = 1; }
    if (agg.tests.len != 1)                                                 { bad = 1; }
    if (agg.events.len != 1 || !t_note_is(?agg.events.data[0], 4))          { bad = 1; }
    if (unit.artifacts.len != 0 || unit.tests.len != 0 || unit.events.len != 0) { bad = 1; }

    outcome_dnit(?agg);
    ret bad;
}

test "mach.lang.build.outcome.merge:reserve_failure_leaves_both_sides_untouched" {
    var backing: A.Allocator;
    page.make(?backing);
    var failing: T.Testing;
    val made: err[A.Error] = T.make(?failing);
    if (sel made.err) { ret 1; }
    T.fail_at_ordinal(?failing, 1::usize);

    var agg: BuildOutcome = outcome_init(T.allocator_of(?failing));
    var unit: BuildOutcome = outcome_init(?backing);
    if (t_refused(record_artifact(?unit, ART_BINARY, "x"))) { ret 1; }

    if (t_accepted(merge(?agg, ?unit))) { ret 2; }
    if (agg.artifacts.len != 0)  { ret 3; }
    if (unit.artifacts.len != 1) { ret 4; }

    outcome_dnit(?agg);
    outcome_dnit(?unit);
    if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
    if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
    T.dnit(?failing);
    ret 0;
}

test "mach.lang.build.outcome.events:own_payloads_and_preserve_order" {
    var a: A.Allocator;
    page.make(?a);
    var bo: BuildOutcome = outcome_init(?a);

    var f: Fail = user("bad input");
    if (t_refused(record_unit(?bo, "app", "linux-x86_64", true))) { outcome_dnit(?bo); ret 1; }
    if (t_refused(record_note(?bo, 3)))                           { outcome_dnit(?bo); ret 1; }
    if (t_refused(record_fail(?bo, ?f)))                          { outcome_dnit(?bo); ret 1; }

    var bad: i32 = 0;
    if (bo.events.len != 3)                                              { bad = 1; }
    or (!t_unit_is(?bo.events.data[0], "app", "linux-x86_64"))           { bad = 1; }
    or (!t_note_is(?bo.events.data[1], 3))                               { bad = 1; }
    or (!t_fail_copied(?bo.events.data[2], f))                           { bad = 1; }

    outcome_dnit(?bo);
    ret bad;
}

test "mach.lang.build.outcome.gate_tally:counts_and_retains_identity_for_every_kind" {
    var a: A.Allocator;
    page.make(?a);
    var gt: GateTally = gate_tally_init(?a);

    if (t_refused(record_gate(?gt, ?a, validation.gate_result(validation.RESULT_PASS, validation.CAUSE_PASS, nil))))                                          { ret 1; }
    if (t_refused(record_gate(?gt, ?a, validation.gate_result(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_EXIT, "case-a"))))                 { ret 2; }
    if (t_refused(record_gate(?gt, ?a, validation.gate_result(validation.RESULT_UNSUPPORTED_INPUT, validation.CAUSE_UNSUPPORTED, nil))))                      { ret 3; }
    if (t_refused(record_gate(?gt, ?a, validation.gate_result(validation.RESULT_TOOL_UNAVAILABLE, validation.CAUSE_TOOL_UNAVAILABLE, nil))))                  { ret 4; }
    if (t_refused(record_gate(?gt, ?a, validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_CAPTURE, nil))))              { ret 5; }
    if (t_refused(record_gate(?gt, ?a, validation.gate_result(validation.RESULT_RESOURCE_EXHAUSTION, validation.CAUSE_ORACLE_OUTPUT_LIMIT, nil))))            { ret 6; }
    if (t_refused(record_gate(?gt, ?a, validation.gate_result(validation.RESULT_INVALID_INJECTION, validation.CAUSE_INVALID_INJECTOR, nil))))                 { ret 7; }

    var bad: i32 = 0;
    if (gt.pass != 1)                   { bad = 1; }
    or (gt.semantic_mismatch != 1)      { bad = 1; }
    or (gt.unsupported_input != 1)      { bad = 1; }
    or (gt.tool_unavailable != 1)       { bad = 1; }
    or (gt.infrastructure_failure != 1) { bad = 1; }
    or (gt.resource_exhaustion != 1)    { bad = 1; }
    or (gt.invalid_injection != 1)      { bad = 1; }
    or (gate_tally_total(?gt) != 7)     { bad = 1; }
    or (gt.results.len != 7)            { bad = 1; }
    or (!str_equals(gt.results.data[1].detail_identity, "case-a")) { bad = 1; }

    gate_tally_dnit(?gt);
    if (gate_tally_total(?gt) != 0 || gt.results.len != 0) { bad = 1; }

    ret bad;
}

test "mach.lang.build.outcome.record_gate:fails_closed_and_frees_the_duplicated_identity" {
    var backing: A.Allocator;
    page.make(?backing);
    var failing: T.Testing;
    val made: err[A.Error] = T.make(?failing);
    if (sel made.err) { ret 1; }
    T.fail_at_ordinal(?failing, 2::usize);

    var gt: GateTally = gate_tally_init(T.allocator_of(?failing));
    val r: err[A.Error] = record_gate(?gt, T.allocator_of(?failing),
        validation.gate_result(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_EXIT, "identity"));
    if (sel r.ok) { ret 1; }
    if (gt.results.len != 0 || gate_tally_total(?gt) != 0) { ret 2; }

    gate_tally_dnit(?gt);
    if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
    if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
    T.dnit(?failing);
    ret 0;
}
