use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use std.text.string.str_free;
use std.text.string.str_dup;

use std.collections.vector;
use std.collections.vector.Vector;

use A: std.allocator;
use T: std.allocator.testing;
use O: std.types.option;
use R: std.types.result;
use std.system.panic.panic;

use mach.lang.diagnostic;
use mach.lang.source;
use mach.lang.validation;
use mach.lang.fail;

pub def FailKind: u8;

pub val FAIL_REPORTED:    FailKind = 0;
pub val FAIL_USER:        FailKind = 1;
pub val FAIL_INTERNAL:    FailKind = 2;
pub val FAIL_ENVIRONMENT: FailKind = 3;

pub rec Fail {
    kind:    FailKind;
    message: str;
}

pub fun user(message: str) Fail {
    var f: Fail;
    f.kind    = FAIL_USER;
    f.message = message;
    ret f;
}

pub fun internal(message: str) Fail {
    var f: Fail;
    f.kind    = FAIL_INTERNAL;
    f.message = message;
    ret f;
}

pub fun reported() Fail {
    var f: Fail;
    f.kind    = FAIL_REPORTED;
    f.message = nil;
    ret f;
}

pub fun from_fail(f: fail.Fail) Fail {
    if (f.kind == fail.REPORTED) { ret reported(); }
    ret internal(f.message);
}

pub fun environment(message: str) Fail {
    var f: Fail;
    f.kind    = FAIL_ENVIRONMENT;
    f.message = message;
    ret f;
}

pub def ArtifactKind: u8;
pub val ART_BINARY:  ArtifactKind = 0;
pub val ART_OBJECTS: ArtifactKind = 1;
pub val ART_ARCHIVE: ArtifactKind = 2;
pub val ART_SHARED:  ArtifactKind = 3;
pub val ART_TESTS:   ArtifactKind = 4;

pub rec Artifact {
    kind: ArtifactKind;
    path: str;
}

pub rec TestArtifact {
    module: *u8;
    label:  *u8;
    file:   *u8;
    line:   u32;
    exe:    *u8;
    idx:    u32;
}

pub def BuildEventKind: u8;

pub val BUILD_EVENT_UNIT:        BuildEventKind = 0;
pub val BUILD_EVENT_NOTE:        BuildEventKind = 1;
pub val BUILD_EVENT_FAIL:        BuildEventKind = 2;
pub val BUILD_EVENT_DIAGNOSTICS: BuildEventKind = 3;

pub rec BuildUnitEvent {
    artifact:     str;
    target:       str;
    has_artifact: bool;
}

pub rec DiagnosticBatch {
    sources: *source.SourceMap;
    diags:   *diagnostic.DiagnosticStore;
}

pub rec BuildEvent {
    kind: BuildEventKind;
    data: uni {
        unit:        BuildUnitEvent;
        scalarized:  u32;
        fail:        Fail;
        diagnostics: DiagnosticBatch;
    };
}

pub def BuildSeverity: u8;

pub val BUILD_OK:          BuildSeverity = 0;
pub val BUILD_USER:        BuildSeverity = 1;
pub val BUILD_ENVIRONMENT: BuildSeverity = 2;
pub val BUILD_INTERNAL:    BuildSeverity = 3;

pub rec BuildOutcome {
    severity:      BuildSeverity;
    artifacts:     Vector[Artifact];
    tests:         Vector[TestArtifact];
    events:        Vector[BuildEvent];
    tests_skipped: u32;
}

pub fun outcome_init(oa: *A.Allocator) BuildOutcome {
    var bo: BuildOutcome;
    bo.severity      = BUILD_OK;
    bo.artifacts     = vector.init[Artifact](oa);
    bo.tests         = vector.init[TestArtifact](oa);
    bo.events        = vector.init[BuildEvent](oa);
    bo.tests_skipped = 0;
    ret bo;
}

fun free_artifact(a: *A.Allocator, art: *Artifact) {
    if (art.path != nil) { str_free(a, art.path); }
}

fun free_test_artifact(a: *A.Allocator, t: *TestArtifact) {
    if (t.module != nil) { str_free(a, t.module::str); }
    if (t.label != nil)  { str_free(a, t.label::str); }
    if (t.file != nil)   { str_free(a, t.file::str); }
    if (t.exe != nil)    { str_free(a, t.exe::str); }
}

fun free_fail(a: *A.Allocator, f: *Fail) {
    if (f.kind != FAIL_REPORTED && f.message != nil) { str_free(a, f.message); }
}

fun free_diagnostic_batch(a: *A.Allocator, batch: *DiagnosticBatch) {
    if (batch.diags != nil) {
        diagnostic.store_dnit(batch.diags);
        A.deallocate[diagnostic.DiagnosticStore](a, batch.diags, 1);
    }
    if (batch.sources != nil) {
        source.dnit(batch.sources);
        A.deallocate[source.SourceMap](a, batch.sources, 1);
    }
}

fun free_event(a: *A.Allocator, ev: *BuildEvent) {
    if (ev.kind == BUILD_EVENT_UNIT) {
        if (ev.data.unit.artifact != nil) { str_free(a, ev.data.unit.artifact); }
        if (ev.data.unit.target != nil)   { str_free(a, ev.data.unit.target); }
    }
    or (ev.kind == BUILD_EVENT_FAIL)        { free_fail(a, ?ev.data.fail); }
    or (ev.kind == BUILD_EVENT_DIAGNOSTICS) { free_diagnostic_batch(a, ?ev.data.diagnostics); }
}

pub fun outcome_dnit(bo: *BuildOutcome) {
    if (bo == nil) { ret; }

    var i: usize = 0;
    for (i < bo.artifacts.len) {
        free_artifact(bo.artifacts.a, ?bo.artifacts.data[i]);
        i = i + 1;
    }
    vector.dnit[Artifact](?bo.artifacts);

    var j: usize = 0;
    for (j < bo.tests.len) {
        free_test_artifact(bo.tests.a, ?bo.tests.data[j]);
        j = j + 1;
    }
    vector.dnit[TestArtifact](?bo.tests);

    var k: usize = 0;
    for (k < bo.events.len) {
        free_event(bo.events.a, ?bo.events.data[k]);
        k = k + 1;
    }
    vector.dnit[BuildEvent](?bo.events);

    bo.tests_skipped = 0;
    bo.severity       = BUILD_OK;
}

pub fun record_artifact(bo: *BuildOutcome, kind: ArtifactKind, path: str) R.Result[R.Void, str] {
    val a: *A.Allocator = bo.artifacts.a;
    val dup_r: R.Result[str, str] = str_dup(a, path);
    if (R.is_err[str, str](dup_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](dup_r)); }

    var art: Artifact;
    art.kind = kind;
    art.path = R.unwrap_ok[str, str](dup_r);

    val push_r: R.Result[usize, str] = vector.push[Artifact](?bo.artifacts, art);
    if (R.is_err[usize, str](push_r)) {
        str_free(a, art.path);
        ret R.err[R.Void, str](R.unwrap_err[usize, str](push_r));
    }
    ret R.ok_void[str]();
}

pub fun record_test(bo: *BuildOutcome, module: str, label: str, file: str, line: u32, exe: str, idx: u32) R.Result[R.Void, str] {
    val a: *A.Allocator = bo.tests.a;
    val mod_r: R.Result[str, str] = str_dup(a, module);
    if (R.is_err[str, str](mod_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](mod_r)); }
    val mod_owned: str = R.unwrap_ok[str, str](mod_r);

    val label_r: R.Result[str, str] = str_dup(a, label);
    if (R.is_err[str, str](label_r)) {
        str_free(a, mod_owned);
        ret R.err[R.Void, str](R.unwrap_err[str, str](label_r));
    }
    val label_owned: str = R.unwrap_ok[str, str](label_r);

    val file_r: R.Result[str, str] = str_dup(a, file);
    if (R.is_err[str, str](file_r)) {
        str_free(a, mod_owned);
        str_free(a, label_owned);
        ret R.err[R.Void, str](R.unwrap_err[str, str](file_r));
    }
    val file_owned: str = R.unwrap_ok[str, str](file_r);

    var exe_owned: str = nil;
    if (exe != nil) {
        val exe_r: R.Result[str, str] = str_dup(a, exe);
        if (R.is_err[str, str](exe_r)) {
            str_free(a, mod_owned);
            str_free(a, label_owned);
            str_free(a, file_owned);
            ret R.err[R.Void, str](R.unwrap_err[str, str](exe_r));
        }
        exe_owned = R.unwrap_ok[str, str](exe_r);
    }

    var t: TestArtifact;
    t.module = mod_owned::*u8;
    t.label  = label_owned::*u8;
    t.file   = file_owned::*u8;
    t.line   = line;
    t.exe    = exe_owned::*u8;
    t.idx    = idx;

    val push_r: R.Result[usize, str] = vector.push[TestArtifact](?bo.tests, t);
    if (R.is_err[usize, str](push_r)) {
        str_free(a, mod_owned);
        str_free(a, label_owned);
        str_free(a, file_owned);
        if (exe_owned != nil) { str_free(a, exe_owned); }
        ret R.err[R.Void, str](R.unwrap_err[usize, str](push_r));
    }
    ret R.ok_void[str]();
}

pub fun record_unit(bo: *BuildOutcome, artifact: str, target: str, has_artifact: bool) R.Result[R.Void, str] {
    if (bo == nil) { ret R.err[R.Void, str]("build outcome is nil"); }

    var artifact_owned: str = nil;
    if (artifact != nil) {
        val artifact_r: R.Result[str, str] = str_dup(bo.events.a, artifact);
        if (R.is_err[str, str](artifact_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](artifact_r)); }
        artifact_owned = R.unwrap_ok[str, str](artifact_r);
    }

    var target_owned: str = nil;
    if (target != nil) {
        val target_r: R.Result[str, str] = str_dup(bo.events.a, target);
        if (R.is_err[str, str](target_r)) {
            if (artifact_owned != nil) { str_free(bo.events.a, artifact_owned); }
            ret R.err[R.Void, str](R.unwrap_err[str, str](target_r));
        }
        target_owned = R.unwrap_ok[str, str](target_r);
    }

    var ev: BuildEvent;
    ev.kind                   = BUILD_EVENT_UNIT;
    ev.data.unit.artifact     = artifact_owned;
    ev.data.unit.target       = target_owned;
    ev.data.unit.has_artifact = has_artifact;
    val push_r: R.Result[usize, str] = vector.push[BuildEvent](?bo.events, ev);
    if (R.is_err[usize, str](push_r)) {
        if (target_owned != nil)   { str_free(bo.events.a, target_owned); }
        if (artifact_owned != nil) { str_free(bo.events.a, artifact_owned); }
        ret R.err[R.Void, str](R.unwrap_err[usize, str](push_r));
    }
    ret R.ok_void[str]();
}

pub fun record_note(bo: *BuildOutcome, scalarized: u32) R.Result[R.Void, str] {
    if (bo == nil) { ret R.err[R.Void, str]("build outcome is nil"); }
    var ev: BuildEvent;
    ev.kind            = BUILD_EVENT_NOTE;
    ev.data.scalarized = scalarized;
    val push_r: R.Result[usize, str] = vector.push[BuildEvent](?bo.events, ev);
    if (R.is_err[usize, str](push_r)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](push_r)); }
    ret R.ok_void[str]();
}

pub fun record_fail(bo: *BuildOutcome, f: *Fail) R.Result[R.Void, str] {
    if (bo == nil || f == nil) { ret R.err[R.Void, str]("build outcome failure requires an outcome and value"); }
    if (f.kind != FAIL_REPORTED && f.kind != FAIL_USER && f.kind != FAIL_ENVIRONMENT && f.kind != FAIL_INTERNAL) {
        ret R.err[R.Void, str]("build outcome failure kind is invalid");
    }

    var owned: Fail;
    owned.kind    = f.kind;
    owned.message = nil;
    if (f.kind != FAIL_REPORTED && f.message != nil) {
        val dup_r: R.Result[str, str] = str_dup(bo.events.a, f.message);
        if (R.is_err[str, str](dup_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](dup_r)); }
        owned.message = R.unwrap_ok[str, str](dup_r);
    }

    var ev: BuildEvent;
    ev.kind      = BUILD_EVENT_FAIL;
    ev.data.fail = owned;
    val push_r: R.Result[usize, str] = vector.push[BuildEvent](?bo.events, ev);
    if (R.is_err[usize, str](push_r)) {
        free_fail(bo.events.a, ?owned);
        ret R.err[R.Void, str](R.unwrap_err[usize, str](push_r));
    }
    ret R.ok_void[str]();
}

pub fun record_diagnostics(bo: *BuildOutcome, sources: *source.SourceMap, diags: *diagnostic.DiagnosticStore) R.Result[R.Void, str] {
    if (bo == nil || sources == nil || diags == nil) {
        ret R.err[R.Void, str]("build diagnostics require an outcome, sources, and diagnostic store");
    }
    if (diagnostic.len(diags) == 0) { ret R.ok_void[str](); }

    val sources_r: R.Result[*source.SourceMap, str] = source.snapshot_from(sources, bo.events.a);
    if (R.is_err[*source.SourceMap, str](sources_r)) {
        ret R.err[R.Void, str](R.unwrap_err[*source.SourceMap, str](sources_r));
    }
    val owned_sources: *source.SourceMap = R.unwrap_ok[*source.SourceMap, str](sources_r);

    val diags_r: R.Result[*diagnostic.DiagnosticStore, str] = diagnostic.snapshot_from(diags, 0, bo.events.a);
    if (R.is_err[*diagnostic.DiagnosticStore, str](diags_r)) {
        source.dnit(owned_sources);
        A.deallocate[source.SourceMap](bo.events.a, owned_sources, 1);
        ret R.err[R.Void, str](R.unwrap_err[*diagnostic.DiagnosticStore, str](diags_r));
    }
    val owned_diags: *diagnostic.DiagnosticStore = R.unwrap_ok[*diagnostic.DiagnosticStore, str](diags_r);

    var ev: BuildEvent;
    ev.kind                     = BUILD_EVENT_DIAGNOSTICS;
    ev.data.diagnostics.sources = owned_sources;
    ev.data.diagnostics.diags   = owned_diags;
    val push_r: R.Result[usize, str] = vector.push[BuildEvent](?bo.events, ev);
    if (R.is_err[usize, str](push_r)) {
        free_diagnostic_batch(bo.events.a, ?ev.data.diagnostics);
        ret R.err[R.Void, str](R.unwrap_err[usize, str](push_r));
    }
    ret R.ok_void[str]();
}

pub fun fold_fail(bo: *BuildOutcome, f: *Fail) {
    var sev: BuildSeverity = BUILD_OK;
    if (f.kind == FAIL_REPORTED)         { sev = BUILD_USER; }
    or (f.kind == FAIL_USER)             { sev = BUILD_USER; }
    or (f.kind == FAIL_ENVIRONMENT)      { sev = BUILD_ENVIRONMENT; }
    or (f.kind == FAIL_INTERNAL)         { sev = BUILD_INTERNAL; }
    or { panic("build.outcome.fold_fail: unrecognized outcome.FailKind\n"); }
    if (sev > bo.severity) { bo.severity = sev; }
}

pub fun merge(agg: *BuildOutcome, unit: *BuildOutcome) R.Result[R.Void, str] {
    val ar: R.Result[usize, str] = vector.reserve[Artifact](?agg.artifacts, unit.artifacts.len);
    if (R.is_err[usize, str](ar)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](ar)); }
    val tr: R.Result[usize, str] = vector.reserve[TestArtifact](?agg.tests, unit.tests.len);
    if (R.is_err[usize, str](tr)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](tr)); }
    val er: R.Result[usize, str] = vector.reserve[BuildEvent](?agg.events, unit.events.len);
    if (R.is_err[usize, str](er)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](er)); }

    var i: usize = 0;
    for (i < unit.artifacts.len) {
        val pr: R.Result[usize, str] = vector.push[Artifact](?agg.artifacts, unit.artifacts.data[i]);
        if (R.is_err[usize, str](pr)) { ret R.err[R.Void, str]("build outcome merge: artifact push failed after capacity reservation"); }
        i = i + 1;
    }
    var j: usize = 0;
    for (j < unit.tests.len) {
        val pr: R.Result[usize, str] = vector.push[TestArtifact](?agg.tests, unit.tests.data[j]);
        if (R.is_err[usize, str](pr)) { ret R.err[R.Void, str]("build outcome merge: test push failed after capacity reservation"); }
        j = j + 1;
    }
    var k: usize = 0;
    for (k < unit.events.len) {
        val pr: R.Result[usize, str] = vector.push[BuildEvent](?agg.events, unit.events.data[k]);
        if (R.is_err[usize, str](pr)) { ret R.err[R.Void, str]("build outcome merge: event push failed after capacity reservation"); }
        k = k + 1;
    }

    agg.tests_skipped = agg.tests_skipped + unit.tests_skipped;
    if (unit.severity > agg.severity) { agg.severity = unit.severity; }

    vector.dnit[Artifact](?unit.artifacts);
    vector.dnit[TestArtifact](?unit.tests);
    vector.dnit[BuildEvent](?unit.events);
    unit.tests_skipped = 0;
    unit.severity       = BUILD_OK;
    ret R.ok_void[str]();
}

pub rec GateTally {
    pass:                   u32;
    semantic_mismatch:      u32;
    unsupported_input:      u32;
    tool_unavailable:       u32;
    infrastructure_failure: u32;
    resource_exhaustion:    u32;
    invalid_injection:      u32;
    results:                Vector[validation.ValidationGateResult];
}

pub fun gate_tally_init(a: *A.Allocator) GateTally {
    var gt: GateTally;
    gt.pass                   = 0;
    gt.semantic_mismatch      = 0;
    gt.unsupported_input      = 0;
    gt.tool_unavailable       = 0;
    gt.infrastructure_failure = 0;
    gt.resource_exhaustion    = 0;
    gt.invalid_injection      = 0;
    gt.results                = vector.init[validation.ValidationGateResult](a);
    ret gt;
}

pub fun gate_tally_dnit(gt: *GateTally) {
    if (gt == nil) { ret; }
    var i: usize = 0;
    for (i < gt.results.len) {
        val r: *validation.ValidationGateResult = ?gt.results.data[i];
        if (r.detail_identity != nil) { str_free(gt.results.a, r.detail_identity); }
        i = i + 1;
    }
    vector.dnit[validation.ValidationGateResult](?gt.results);
    gt.pass                   = 0;
    gt.semantic_mismatch      = 0;
    gt.unsupported_input      = 0;
    gt.tool_unavailable       = 0;
    gt.infrastructure_failure = 0;
    gt.resource_exhaustion    = 0;
    gt.invalid_injection      = 0;
}

pub fun record_gate(gt: *GateTally, a: *A.Allocator, r: validation.ValidationGateResult) R.Result[R.Void, str] {
    var stored: validation.ValidationGateResult = r;
    if (r.detail_identity != nil) {
        val dup_r: R.Result[str, str] = str_dup(a, r.detail_identity);
        if (R.is_err[str, str](dup_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](dup_r)); }
        stored.detail_identity = R.unwrap_ok[str, str](dup_r);
    }

    val push_r: R.Result[usize, str] = vector.push[validation.ValidationGateResult](?gt.results, stored);
    if (R.is_err[usize, str](push_r)) {
        if (stored.detail_identity != nil) { str_free(a, stored.detail_identity); }
        ret R.err[R.Void, str](R.unwrap_err[usize, str](push_r));
    }

    if (r.kind == validation.RESULT_PASS)                   { gt.pass                   = gt.pass + 1;                   }
    or (r.kind == validation.RESULT_SEMANTIC_MISMATCH)      { gt.semantic_mismatch      = gt.semantic_mismatch + 1;      }
    or (r.kind == validation.RESULT_UNSUPPORTED_INPUT)      { gt.unsupported_input      = gt.unsupported_input + 1;      }
    or (r.kind == validation.RESULT_TOOL_UNAVAILABLE)       { gt.tool_unavailable       = gt.tool_unavailable + 1;       }
    or (r.kind == validation.RESULT_INFRASTRUCTURE_FAILURE) { gt.infrastructure_failure = gt.infrastructure_failure + 1; }
    or (r.kind == validation.RESULT_RESOURCE_EXHAUSTION)    { gt.resource_exhaustion    = gt.resource_exhaustion + 1;    }
    or (r.kind == validation.RESULT_INVALID_INJECTION)      { gt.invalid_injection      = gt.invalid_injection + 1;      }
    ret R.ok_void[str]();
}

pub fun gate_tally_total(gt: *GateTally) u32 {
    ret gt.pass + gt.semantic_mismatch + gt.unsupported_input + gt.tool_unavailable
      + gt.infrastructure_failure + gt.resource_exhaustion + gt.invalid_injection;
}

test "mach.lang.build.outcome.outcome_init:round_trips_empty_and_populated" {
    var a: A.Allocator;
    page.make(?a);
    var bo: BuildOutcome = outcome_init(?a);

    var bad: i32 = 0;
    if (bo.severity != BUILD_OK)      { bad = 1; }
    if (bo.artifacts.len != 0)        { bad = 1; }
    if (bo.tests.len != 0)            { bad = 1; }
    if (bo.events.len != 0)           { bad = 1; }
    if (bo.tests_skipped != 0)        { bad = 1; }
    outcome_dnit(?bo);

    var bo2: BuildOutcome = outcome_init(?a);
    if (R.is_err[R.Void, str](record_artifact(?bo2, ART_BINARY, "out/bin/x")))        { bad = 1; }
    if (R.is_err[R.Void, str](record_test(?bo2, "m", "l", "f", 3, nil, 0)))           { bad = 1; }
    if (R.is_err[R.Void, str](record_unit(?bo2, "x", "native", true)))                 { bad = 1; }
    if (R.is_err[R.Void, str](record_note(?bo2, 2)))                                   { bad = 1; }
    if (bo2.artifacts.len != 1 || bo2.tests.len != 1 || bo2.events.len != 2)         { bad = 1; }
    outcome_dnit(?bo2);
    if (bo2.artifacts.len != 0 || bo2.tests.len != 0)                               { bad = 1; }

    ret bad;
}

test "mach.lang.build.outcome.record_artifact:fails_closed_without_a_partial_record" {
    var backing: A.Allocator;
    page.make(?backing);
    var failing: T.Testing;
    if (O.is_some[str](T.make(?failing))) { ret 1; }
    T.fail_at_ordinal(?failing, 1::usize);

    var bo: BuildOutcome = outcome_init(T.allocator_of(?failing));
    if (R.is_ok[R.Void, str](record_artifact(?bo, ART_BINARY, "out/bin/x"))) { ret 1; }
    if (bo.artifacts.len != 0) { ret 1; }

    outcome_dnit(?bo);
    if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
    if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
    T.dnit(?failing);
    ret 0;
}

test "mach.lang.build.outcome.record_test:rolls_back_every_owned_string_on_failure" {
    var found: bool = false;
    var ordinal: u64 = 1;
    for (ordinal <= 16 && !found) {
        var backing: A.Allocator;
        page.make(?backing);
        var failing: T.Testing;
        if (O.is_some[str](T.make(?failing))) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);

        var bo: BuildOutcome = outcome_init(T.allocator_of(?failing));
        val r: R.Result[R.Void, str] = record_test(?bo, "mod", "label", "file.mach", 7, "exe", 2);
        if (R.is_err[R.Void, str](r) && bo.tests.len == 0) { found = true; }

        outcome_dnit(?bo);
        if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }
    if (!found) { ret 1; }
    ret 0;
}

test "mach.lang.build.outcome.fold_fail:internal_dominates_and_never_regresses" {
    var bo: BuildOutcome;
    bo.severity      = BUILD_OK;
    bo.tests_skipped = 0;

    var reported_f: Fail = reported();
    fold_fail(?bo, ?reported_f);
    if (bo.severity != BUILD_USER) { ret 1; }

    var env_f: Fail = environment("disk full");
    fold_fail(?bo, ?env_f);
    if (bo.severity != BUILD_ENVIRONMENT) { ret 2; }

    var user_f: Fail = user("nope");
    fold_fail(?bo, ?user_f);
    if (bo.severity != BUILD_ENVIRONMENT) { ret 3; }

    var internal_f: Fail = internal("boom");
    fold_fail(?bo, ?internal_f);
    if (bo.severity != BUILD_INTERNAL) { ret 4; }

    var env_f2: Fail = environment("disk full again");
    fold_fail(?bo, ?env_f2);
    if (bo.severity != BUILD_INTERNAL) { ret 5; }

    ret 0;
}

test "mach.lang.build.outcome.merge:severity_and_skipped_are_order_independent" {
    var a: A.Allocator;
    page.make(?a);

    var agg_first: BuildOutcome = outcome_init(?a);
    var user_unit: BuildOutcome = outcome_init(?a);
    user_unit.severity      = BUILD_USER;
    user_unit.tests_skipped = 3;
    var internal_unit: BuildOutcome = outcome_init(?a);
    internal_unit.severity      = BUILD_INTERNAL;
    internal_unit.tests_skipped = 2;

    if (R.is_err[R.Void, str](merge(?agg_first, ?user_unit)))     { ret 1; }
    if (R.is_err[R.Void, str](merge(?agg_first, ?internal_unit))) { ret 2; }
    if (agg_first.severity != BUILD_INTERNAL)                   { ret 3; }
    if (agg_first.tests_skipped != 5)                           { ret 4; }
    outcome_dnit(?agg_first);

    var agg_second: BuildOutcome = outcome_init(?a);
    var internal_unit2: BuildOutcome = outcome_init(?a);
    internal_unit2.severity      = BUILD_INTERNAL;
    internal_unit2.tests_skipped = 2;
    var user_unit2: BuildOutcome = outcome_init(?a);
    user_unit2.severity      = BUILD_USER;
    user_unit2.tests_skipped = 3;

    if (R.is_err[R.Void, str](merge(?agg_second, ?internal_unit2))) { ret 5; }
    if (R.is_err[R.Void, str](merge(?agg_second, ?user_unit2)))     { ret 6; }
    if (agg_second.severity != BUILD_INTERNAL)                    { ret 7; }
    if (agg_second.tests_skipped != 5)                            { ret 8; }
    outcome_dnit(?agg_second);

    ret 0;
}

test "mach.lang.build.outcome.merge:transfers_artifacts_and_tests_and_empties_the_source" {
    var a: A.Allocator;
    page.make(?a);

    var agg: BuildOutcome = outcome_init(?a);
    if (R.is_err[R.Void, str](record_artifact(?agg, ART_BINARY, "agg-existing")))      { ret 1; }

    var unit: BuildOutcome = outcome_init(?a);
    if (R.is_err[R.Void, str](record_artifact(?unit, ART_OBJECTS, "unit-object")))     { ret 2; }
    if (R.is_err[R.Void, str](record_test(?unit, "m", "l", "f", 1, nil, 0)))           { ret 3; }
    if (R.is_err[R.Void, str](record_note(?unit, 4)))                                  { ret 3; }

    if (R.is_err[R.Void, str](merge(?agg, ?unit))) { ret 4; }

    var bad: i32 = 0;
    if (agg.artifacts.len != 2)                                             { bad = 1; }
    or (!str_equals(agg.artifacts.data[0].path, "agg-existing"))            { bad = 1; }
    or (!str_equals(agg.artifacts.data[1].path, "unit-object"))             { bad = 1; }
    if (agg.tests.len != 1)                                                 { bad = 1; }
    if (agg.events.len != 1 || agg.events.data[0].data.scalarized != 4)     { bad = 1; }
    if (unit.artifacts.len != 0 || unit.tests.len != 0 || unit.events.len != 0) { bad = 1; }

    outcome_dnit(?agg);
    ret bad;
}

test "mach.lang.build.outcome.merge:reserve_failure_leaves_both_sides_untouched" {
    var backing: A.Allocator;
    page.make(?backing);
    var failing: T.Testing;
    if (O.is_some[str](T.make(?failing))) { ret 1; }
    T.fail_at_ordinal(?failing, 1::usize);

    var agg: BuildOutcome = outcome_init(T.allocator_of(?failing));
    var unit: BuildOutcome = outcome_init(?backing);
    if (R.is_err[R.Void, str](record_artifact(?unit, ART_BINARY, "x"))) { ret 1; }

    if (R.is_ok[R.Void, str](merge(?agg, ?unit))) { ret 2; }
    if (agg.artifacts.len != 0)  { ret 3; }
    if (unit.artifacts.len != 1) { ret 4; }

    outcome_dnit(?agg);
    outcome_dnit(?unit);
    if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
    if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
    T.dnit(?failing);
    ret 0;
}

test "mach.lang.build.outcome.events:own_payloads_and_preserve_order" {
    var a: A.Allocator;
    page.make(?a);
    var bo: BuildOutcome = outcome_init(?a);

    var f: Fail = user("bad input");
    if (R.is_err[R.Void, str](record_unit(?bo, "app", "linux-x86_64", true))) { outcome_dnit(?bo); ret 1; }
    if (R.is_err[R.Void, str](record_note(?bo, 3)))                           { outcome_dnit(?bo); ret 1; }
    if (R.is_err[R.Void, str](record_fail(?bo, ?f)))                          { outcome_dnit(?bo); ret 1; }

    var bad: i32 = 0;
    if (bo.events.len != 3)                                              { bad = 1; }
    or (bo.events.data[0].kind != BUILD_EVENT_UNIT)                      { bad = 1; }
    or (!str_equals(bo.events.data[0].data.unit.artifact, "app"))        { bad = 1; }
    or (!str_equals(bo.events.data[0].data.unit.target, "linux-x86_64")) { bad = 1; }
    or (bo.events.data[1].kind != BUILD_EVENT_NOTE)                      { bad = 1; }
    or (bo.events.data[1].data.scalarized != 3)                          { bad = 1; }
    or (bo.events.data[2].kind != BUILD_EVENT_FAIL)                      { bad = 1; }
    or (bo.events.data[2].data.fail.message == f.message)                { bad = 1; }
    or (!str_equals(bo.events.data[2].data.fail.message, "bad input"))   { bad = 1; }

    outcome_dnit(?bo);
    ret bad;
}

test "mach.lang.build.outcome.gate_tally:counts_and_retains_identity_for_every_kind" {
    var a: A.Allocator;
    page.make(?a);
    var gt: GateTally = gate_tally_init(?a);

    if (R.is_err[R.Void, str](record_gate(?gt, ?a, validation.gate_result(validation.RESULT_PASS, validation.CAUSE_PASS, nil))))                                          { ret 1; }
    if (R.is_err[R.Void, str](record_gate(?gt, ?a, validation.gate_result(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_EXIT, "case-a"))))                 { ret 2; }
    if (R.is_err[R.Void, str](record_gate(?gt, ?a, validation.gate_result(validation.RESULT_UNSUPPORTED_INPUT, validation.CAUSE_UNSUPPORTED, nil))))                      { ret 3; }
    if (R.is_err[R.Void, str](record_gate(?gt, ?a, validation.gate_result(validation.RESULT_TOOL_UNAVAILABLE, validation.CAUSE_TOOL_UNAVAILABLE, nil))))                  { ret 4; }
    if (R.is_err[R.Void, str](record_gate(?gt, ?a, validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_CAPTURE, nil))))              { ret 5; }
    if (R.is_err[R.Void, str](record_gate(?gt, ?a, validation.gate_result(validation.RESULT_RESOURCE_EXHAUSTION, validation.CAUSE_ORACLE_OUTPUT_LIMIT, nil))))            { ret 6; }
    if (R.is_err[R.Void, str](record_gate(?gt, ?a, validation.gate_result(validation.RESULT_INVALID_INJECTION, validation.CAUSE_INVALID_INJECTOR, nil))))                 { ret 7; }

    var bad: i32 = 0;
    if (gt.pass != 1)                   { bad = 1; }
    or (gt.semantic_mismatch != 1)      { bad = 1; }
    or (gt.unsupported_input != 1)      { bad = 1; }
    or (gt.tool_unavailable != 1)       { bad = 1; }
    or (gt.infrastructure_failure != 1) { bad = 1; }
    or (gt.resource_exhaustion != 1)    { bad = 1; }
    or (gt.invalid_injection != 1)      { bad = 1; }
    or (gate_tally_total(?gt) != 7)     { bad = 1; }
    or (gt.results.len != 7)            { bad = 1; }
    or (!str_equals(gt.results.data[1].detail_identity, "case-a")) { bad = 1; }

    gate_tally_dnit(?gt);
    if (gate_tally_total(?gt) != 0 || gt.results.len != 0) { bad = 1; }

    ret bad;
}

test "mach.lang.build.outcome.record_gate:fails_closed_and_frees_the_duplicated_identity" {
    var backing: A.Allocator;
    page.make(?backing);
    var failing: T.Testing;
    if (O.is_some[str](T.make(?failing))) { ret 1; }
    T.fail_at_ordinal(?failing, 2::usize);

    var gt: GateTally = gate_tally_init(T.allocator_of(?failing));
    val r: R.Result[R.Void, str] = record_gate(?gt, T.allocator_of(?failing),
        validation.gate_result(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_EXIT, "identity"));
    if (R.is_ok[R.Void, str](r)) { ret 1; }
    if (gt.results.len != 0 || gate_tally_total(?gt) != 0) { ret 2; }

    gate_tally_dnit(?gt);
    if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
    if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
    T.dnit(?failing);
    ret 0;
}
