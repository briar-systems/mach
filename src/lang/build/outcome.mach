use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use std.text.string.str_dup;
use std.text.string.str_free;

use std.collections.vector;
use std.collections.vector.Vector;

use A: std.allocator;
use std.allocator.page;
use T: std.allocator.testing;
use std.data.toml;
use std.encoding.binary;
use fs: std.filesystem;
use std.filesystem.removal;
use std.format;
use io_error: std.io.error;
use std.io.reader;
use std.io.writer;
use std.process.env;
use std.system.os;
use std.types.string;

use mach.lang.alloc;
use mach.lang.diagnostic;
use dkind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.source;
use mach.lang.validation;

# the driver's failure: already reported through diagnostics, the input was
# wrong (a manifest error, a missing project), an invariant the compiler owns
# was broken, or the machine rather than the input (a tool that could not be
# spawned, a resource that was not there). the exit code derives from the
# case: 1 for user, 2 for internal, 3 where a command distinguishes the
# environment; a compiler failure never renders as a test failure. `reported`
# is declared first so a zero outcome is a failure that invents no text. a
# user or environment failure names the diagnostic kind it is reported as; an
# internal one is always `compiler.internal`
pub tag Fail: u8 {
    reported;
    user:        Keyed;
    internal:    str;
    environment: Keyed;
}

# kind: the row of the diagnostic kind table the failure is reported as
# text: the message
# at:   where in the file that caused it the failure points, the zero place
#       when it points nowhere
# also: the other places the failure names, none when it names no other
pub rec Keyed {
    kind: dkind.Kind;
    text: str;
    at:   Place;
    also: Related;
}

# the other places a failure names, in order, each in its own file: the other
# edges of a cycle, the other claims a collision is between. the array and
# each resolved place's path share the failure's lifetime as `at`'s path does
# ---
# items: the places, nil when there are none
# count: how many
pub rec Related {
    items: *Place;
    count: usize;
}

# where a failure points: the bytes [start, end) of the file at `path`, and the
# line and column of `start` and of `end`, each from 1 with columns counted in
# UTF-8 bytes. a place whose range is known before its file is `spanned` with a
# nil path until `placed` names the file. the path shares the message's
# lifetime: a copy of the failure that outlives its message copies both
# ---
# path:     the file, nil until the place is resolved
# spanned:  whether a range is known; false with a nil path is no place
# start:    the byte offset of the first byte
# end:      the byte offset just past the last byte
# line:     the line of `start`
# col:      the column of `start`
# end_line: the line of `end`
# end_col:  the column of `end`
pub rec Place {
    path:     str;
    spanned:  bool;
    start:    usize;
    end:      usize;
    line:     usize;
    col:      usize;
    end_line: usize;
    end_col:  usize;
}

pub fun reported() Fail {
    ret Fail.reported{};
}

# a failure names a live row of the registry: one that names none, or a
# retired one, is a compiler defect and becomes an internal failure
pub fun user(k: dkind.Kind, message: str) Fail {
    if (!dkind.live(k)) { ret Fail.internal{message}; }
    ret Fail.user{Keyed{kind: k, text: message}};
}

pub fun internal(message: str) Fail {
    ret Fail.internal{message};
}

# the same failure pointing at the bytes [start, end) of the file that caused
# it, which `placed` names. a failure that already points somewhere keeps its
# place, the innermost site knowing best, and one with no kind points nowhere
pub fun spanned(f: Fail, start: usize, end: usize) Fail {
    var out: Fail = f;
    if (sel out.user) {
        if (!out.user.at.spanned) { out.user.at = span_only(start, end); }
    }
    or (sel out.environment) {
        if (!out.environment.at.spanned) { out.environment.at = span_only(start, end); }
    }
    ret out;
}

fun span_only(start: usize, end: usize) Place {
    var p: Place;
    p.spanned = true;
    p.start   = start;
    p.end     = end;
    ret p;
}

# the same failure with its ranges resolved in `text`, the file at `path`, as
# `located` places them: its own and each related one still without a file. a
# failure without a range, or one already resolved, is returned as it is
pub fun placed(a: *A.Allocator, f: Fail, path: str, text: str) Fail {
    ret placed_bytes(a, f, path, text::*u8, str_len(text));
}

# `placed` over the `n` bytes at `data`, for a file that may hold a NUL
pub fun placed_bytes(a: *A.Allocator, f: Fail, path: str, data: *u8, n: usize) Fail {
    val k_o: opt[Keyed] = keyed(f);
    if (sel k_o.none) { ret f; }
    val k: Keyed = k_o.some;
    var i: usize = 0;
    for (i < k.also.count) {
        val r: *Place = ?k.also.items[i];
        if (r.spanned && r.path == nil) {
            val path_r: res[str, A.Error] = str_dup(a, path);
            if (sel path_r.err) { ret refused(path_r.err); }
            @r = place(path_r.ok, data, n, r.start, r.end);
        }
        i = i + 1;
    }
    if (!k.at.spanned || k.at.path != nil) { ret f; }
    ret located(a, f, place(path, data, n, k.at.start, k.at.end));
}

# the same failure pointing at `p`, a place a model recorded: one without a
# file is a range `placed` resolves, one with a file is copied as `located`
# copies it. a failure that already points somewhere keeps its place
pub fun at(a: *A.Allocator, f: Fail, p: Place) Fail {
    val k_o: opt[Keyed] = keyed(f);
    if (sel k_o.none)        { ret f; }
    if (k_o.some.at.spanned) { ret f; }
    if (!p.spanned)          { ret f; }
    if (p.path == nil)       { ret spanned(f, p.start, p.end); }
    ret located(a, f, p);
}

# the same failure naming the `n` places at `ps` as its related places, in
# order, each copied through `a` as `at` copies a place; an unspanned place is
# skipped. a failure that already names related places keeps them, and one
# whose copy is refused is that refusal
pub fun with_related(a: *A.Allocator, f: Fail, ps: *Place, n: usize) Fail {
    val k_o: opt[Keyed] = keyed(f);
    if (sel k_o.none)             { ret f; }
    if (k_o.some.also.count != 0) { ret f; }
    var count: usize = 0;
    var i:     usize = 0;
    for (i < n) {
        if (ps[i].spanned) { count = count + 1; }
        i = i + 1;
    }
    if (count == 0) { ret f; }
    val items_r: res[*Place, A.Error] = A.allocate[Place](a, count);
    if (sel items_r.err) { ret refused(items_r.err); }
    var also: Related = Related{items: items_r.ok, count: 0};
    i = 0;
    for (i < n) {
        if (ps[i].spanned) {
            var p: Place = ps[i];
            if (p.path != nil) {
                val path_r: res[str, A.Error] = str_dup(a, p.path);
                if (sel path_r.err) {
                    release_related(a, also, count);
                    ret refused(path_r.err);
                }
                p.path = path_r.ok;
            }
            also.items[also.count] = p;
            also.count             = also.count + 1;
        }
        i = i + 1;
    }
    var k: Keyed = k_o.some;
    k.also = also;
    ret rekeyed(f, k);
}

# the related places a failure names, none for one that names no other
pub fun related_of(f: Fail) Related {
    val k_o: opt[Keyed] = keyed(f);
    if (sel k_o.some) { ret k_o.some.also; }
    ret Related{items: nil, count: 0};
}

fun keyed(f: Fail) opt[Keyed] {
    if (sel f.user)        { ret opt[Keyed].some{f.user}; }
    or (sel f.environment) { ret opt[Keyed].some{f.environment}; }
    ret opt[Keyed].none{};
}

fun rekeyed(f: Fail, k: Keyed) Fail {
    if (sel f.user)        { ret Fail.user{k}; }
    or (sel f.environment) { ret Fail.environment{k}; }
    ret f;
}

# free the paths of `also`'s places and its array, allocated `cap` places long
fun release_related(a: *A.Allocator, also: Related, cap: usize) {
    if (also.items == nil) { ret; }
    var i: usize = 0;
    for (i < also.count) {
        if (also.items[i].path != nil) { str_free(a, also.items[i].path); }
        i = i + 1;
    }
    A.deallocate[Place](a, also.items, cap);
}

# the same failure pointing at `at`, its path copied through `a` so the failure
# owns it as it owns its text. a failure with no kind points nowhere, and one
# whose copy is refused is that refusal
pub fun located(a: *A.Allocator, f: Fail, at: Place) Fail {
    if (!sel f.user && !sel f.environment) { ret f; }
    if (at.path == nil)                    { ret f; }
    val path_r: res[str, A.Error] = str_dup(a, at.path);
    if (sel path_r.err) { ret refused(path_r.err); }
    var owned: Place = at;
    owned.path = path_r.ok;
    var out: Fail = f;
    if (sel out.user)        { out.user.at = owned; }
    or (sel out.environment) { out.environment.at = owned; }
    ret out;
}

# the bytes [start, end) of the `n` bytes at `data`, the file at `path`, as a
# place; a range past the end is clamped to it
pub fun place(path: str, data: *u8, n: usize, start: usize, end: usize) Place {
    var s: usize = start;
    if (s > n) { s = n; }
    var e: usize = end;
    if (e > n) { e = n; }
    if (e < s) { e = s; }
    var p: Place;
    p.path    = path;
    p.spanned = true;
    p.start   = s;
    p.end     = e;
    var lines:   usize = 0;
    var line_at: usize = 0;
    var i:       usize = 0;
    for (i < e) {
        if (i == s) {
            p.line = lines + 1;
            p.col  = s - line_at + 1;
        }
        if (data[i] == '\n') {
            lines   = lines + 1;
            line_at = i + 1;
        }
        i = i + 1;
    }
    if (s == e) {
        p.line = lines + 1;
        p.col  = s - line_at + 1;
    }
    p.end_line = lines + 1;
    p.end_col  = e - line_at + 1;
    ret p;
}

# the offsets the lines of one file start at, for resolving many places in it
# as `place` resolves one, each in time logarithmic in the file's lines
# ---
# path:   the file, which every place resolved here names
# n:      the file's length in bytes
# starts: the offset of each line's first byte, the first line's 0
pub rec Lines {
    path:   str;
    n:      usize;
    starts: Vector[usize];
}

# the lines of the `n` bytes at `data`, the file at `path`; released with `lines_dnit`
pub fun lines_of(a: *A.Allocator, path: str, data: *u8, n: usize) res[Lines, A.Error] {
    var l:     Lines               = Lines{path: path, n: n, starts: vector.init[usize](a)};
    val first: res[usize, A.Error] = vector.push[usize](?l.starts, 0);
    if (sel first.err) { ret res[Lines, A.Error].err{first.err}; }
    var i: usize = 0;
    for (i < n) {
        if (data[i] == '\n') {
            val pushed: res[usize, A.Error] = vector.push[usize](?l.starts, i + 1);
            if (sel pushed.err) {
                vector.dnit[usize](?l.starts);
                ret res[Lines, A.Error].err{pushed.err};
            }
        }
        i = i + 1;
    }
    ret res[Lines, A.Error].ok{l};
}

pub fun lines_dnit(l: *Lines) {
    vector.dnit[usize](?l.starts);
}

# the bytes [start, end) of the file `l` indexes as a place, as `place` makes it
pub fun lines_place(l: *Lines, start: usize, end: usize) Place {
    var s: usize = start;
    if (s > l.n) { s = l.n; }
    var e: usize = end;
    if (e > l.n) { e = l.n; }
    if (e < s)   { e = s; }
    var p: Place;
    p.path    = l.path;
    p.spanned = true;
    p.start   = s;
    p.end     = e;
    val sl: usize = line_index(l, s);
    p.line = sl + 1;
    p.col  = s - l.starts.data[sl] + 1;
    val el: usize = line_index(l, e);
    p.end_line = el + 1;
    p.end_col  = e - l.starts.data[el] + 1;
    ret p;
}

# the index of the line holding offset `at`: the last line starting at or before it
fun line_index(l: *Lines, at: usize) usize {
    var lo: usize = 0;
    var hi: usize = l.starts.len;
    for (hi - lo > 1) {
        val mid: usize = lo + (hi - lo) / 2;
        if (l.starts.data[mid] <= at) { lo = mid; }
        or                            { hi = mid; }
    }
    ret lo;
}

# where the failure points, when it points at a file
pub fun place_of(f: Fail) opt[Place] {
    var at: Place;
    if (sel f.user)        { at = f.user.at; }
    or (sel f.environment) { at = f.environment.at; }
    or                     { ret opt[Place].none{}; }
    if (at.path == nil)    { ret opt[Place].none{}; }
    ret opt[Place].some{at};
}

pub fun environment(k: dkind.Kind, message: str) Fail {
    if (!dkind.live(k)) { ret Fail.internal{message}; }
    ret Fail.environment{Keyed{kind: k, text: message}};
}

# the kind the failure is reported as, NONE for a reported one, whose
# diagnostics carry their own
pub fun kind_of(f: Fail) dkind.Kind {
    if (sel f.user)        { ret f.user.kind; }
    or (sel f.environment) { ret f.environment.kind; }
    or (sel f.internal)    { ret dkind.COMPILER_INTERNAL; }
    ret dkind.NONE;
}

# an allocation refusal stays an internal failure (exit 2), as it always has;
# reclassifying it as environmental changes exit codes and is the CLI lane's
pub fun refused(e: A.Error) Fail {
    ret Fail.internal{alloc.text(e)};
}

# the text a std refusal renders as when a driver operation reports it: the
# operation keeps its own classification (user, internal, environment) and
# names the cause once through these. `alloc.text` is the allocator's
pub fun alloc_text(e: A.Error) str {
    ret alloc.text(e);
}

pub fun io_text(e: io_error.Error) str {
    ret os.message(e);
}

pub fun read_text(e: reader.ReadError) str {
    if (sel e.eof)         { ret "unexpected end of input"; }
    or (sel e.would_block) { ret "read would block"; }
    or (sel e.native)      { ret os.message(e.native.error); }
    ret alloc.text(e.alloc);
}

pub fun write_text(e: writer.WriteError) str {
    if (sel e.stalled)     { ret "short write"; }
    or (sel e.would_block) { ret "write would block"; }
    ret os.message(e.native.error);
}

pub fun fs_text(e: fs.FsError) str {
    if (sel e.io)        { ret os.message(e.io); }
    or (sel e.alloc)     { ret alloc.text(e.alloc); }
    or (sel e.read)      { ret read_text(e.read); }
    or (sel e.write)     { ret write_text(e.write); }
    or (sel e.removal)   { ret removal.message(e.removal); }
    or (sel e.exhausted) { ret "temp file: max attempts exceeded"; }
    ret os.message(e.published);
}

pub fun str_text(e: string.StrError) str {
    if (sel e.alloc) { ret alloc.text(e.alloc); }
    ret "slice out of bounds";
}

pub fun format_text(e: format.FormatError) str {
    if (sel e.syntax)     { ret "format: malformed format string"; }
    or (sel e.few_holes)  { ret "format: too few arguments"; }
    or (sel e.many_holes) { ret "format: too many arguments"; }
    or (sel e.write)      { ret write_text(e.write); }
    ret alloc.text(e.alloc);
}

#[testing]
pub fun decode_text(e: binary.DecodeError) str {
    if (sel e.short)     { ret "decoder: unexpected end of input"; }
    or (sel e.invalid)   { ret "decoder: invalid cursor"; }
    or (sel e.alignment) { ret "decoder: alignment is not a power of two"; }
    or (sel e.bounds)    { ret "decoder: checkpoint out of bounds"; }
    ret "decoder: unterminated string";
}

pub fun toml_text(e: toml.TomlError) str {
    if (sel e.syntax)   { ret "toml: syntax error"; }
    or (sel e.overflow) { ret "toml: integer overflow"; }
    or (sel e.depth)    { ret "toml: nesting too deep"; }
    or (sel e.conflict) { ret "toml: key conflicts with an existing value"; }
    ret alloc.text(e.alloc);
}

# a document that does not parse is the user's, pointing at the byte the parser
# refused; one the allocator refused is internal
pub fun toml_failure(e: toml.TomlError) Fail {
    if (sel e.alloc) { ret refused(e.alloc); }
    var at: usize = 0;
    if (sel e.syntax)   { at = e.syntax; }
    or (sel e.overflow) { at = e.overflow; }
    or (sel e.depth)    { at = e.depth; }
    or (sel e.conflict) { at = e.conflict; }
    ret spanned(user(dkind.TOML_MALFORMED, toml_text(e)), at, at);
}

pub fun env_text(e: env.EnvError) str {
    if (sel e.native) { ret os.error_message(e.native); }
    or (sel e.alloc)  { ret alloc.text(e.alloc); }
    ret "environment changed during the read";
}

# the unit outcome of an operation whose value is not needed
pub fun unit[T](r: res[T, Fail]) err[Fail] {
    if (sel r.err) { ret err[Fail].err{r.err}; }
    ret err[Fail].ok{};
}

pub fun is_reported(f: Fail) bool {
    ret sel f.reported;
}

#[testing]
pub fun is_user(f: Fail) bool {
    ret sel f.user;
}

pub fun is_internal(f: Fail) bool {
    ret sel f.internal;
}

# the message a failure carries, absent for a reported one
pub fun text(f: Fail) opt[str] {
    if (sel f.user)        { ret opt[str].some{f.user.text}; }
    or (sel f.internal)    { ret opt[str].some{f.internal}; }
    or (sel f.environment) { ret opt[str].some{f.environment.text}; }
    ret opt[str].none{};
}

# the failure as one line of presentation text; a reported failure has no
# text of its own and is named as such, never as an empty message
pub fun describe(f: Fail) str {
    if (sel f.user)        { ret f.user.text; }
    or (sel f.internal)    { ret f.internal; }
    or (sel f.environment) { ret f.environment.text; }
    ret fail.REPORTED_TEXT;
}

# release the text a failure owns through `a`; a reported failure owns nothing
fun release_text(a: *A.Allocator, f: Fail) {
    val carried: opt[str] = text(f);
    if (sel carried.some) {
        if (carried.some != nil) { str_free(a, carried.some); }
    }
}

# the same failure carrying `message` instead: the case and the place are
# kept, the text replaced (a caller that copies the message into storage it owns)
pub fun with_text(f: Fail, message: str) Fail {
    var out: Fail = f;
    if (sel out.user)        { out.user.text = message; }
    or (sel out.internal)    { ret Fail.internal{message}; }
    or (sel out.environment) { out.environment.text = message; }
    or                       { ret Fail.reported{}; }
    ret out;
}

# a copy of the failure that owns its text and its places through `a`, for a
# failure that outlives the storage its message was made in; released with
# `release`
pub fun retain(a: *A.Allocator, f: Fail) res[Fail, A.Error] {
    var out:     Fail     = f;
    val carried: opt[str] = text(f);
    if (sel carried.some) {
        if (carried.some != nil) {
            val dup_r: res[str, A.Error] = str_dup(a, carried.some);
            if (sel dup_r.err) { ret res[Fail, A.Error].err{dup_r.err}; }
            out = with_text(out, dup_r.ok);
        }
    }
    val placed_r: res[Fail, A.Error] = retain_places(a, out);
    if (sel placed_r.err) {
        release_text(a, out);
        ret placed_r;
    }
    ret placed_r;
}

# release what a retained failure owns through `a`: its text and its places
pub fun release(a: *A.Allocator, f: Fail) {
    release_text(a, f);
    release_places(a, f);
}

# a copy of the failure whose places, its own path and every related place,
# are owned through `a`, its text left as it is; for a holder that keeps the
# text apart. released with `release_places`
pub fun retain_places(a: *A.Allocator, f: Fail) res[Fail, A.Error] {
    val k_o: opt[Keyed] = keyed(f);
    if (sel k_o.none) { ret res[Fail, A.Error].ok{f}; }
    var k: Keyed = k_o.some;
    if (k.at.path != nil) {
        val path_r: res[str, A.Error] = str_dup(a, k.at.path);
        if (sel path_r.err) { ret res[Fail, A.Error].err{path_r.err}; }
        k.at.path = path_r.ok;
    }
    if (k.also.count > 0) {
        val items_r: res[*Place, A.Error] = A.allocate[Place](a, k.also.count);
        if (sel items_r.err) {
            if (k.at.path != nil) { str_free(a, k.at.path); }
            ret res[Fail, A.Error].err{items_r.err};
        }
        var also: Related = Related{items: items_r.ok, count: 0};
        var i:    usize   = 0;
        for (i < k.also.count) {
            var p: Place = k.also.items[i];
            if (p.path != nil) {
                val path_r: res[str, A.Error] = str_dup(a, p.path);
                if (sel path_r.err) {
                    release_related(a, also, k.also.count);
                    if (k.at.path != nil) { str_free(a, k.at.path); }
                    ret res[Fail, A.Error].err{path_r.err};
                }
                p.path = path_r.ok;
            }
            also.items[i] = p;
            also.count    = i + 1;
            i             = i + 1;
        }
        k.also = also;
    }
    ret res[Fail, A.Error].ok{rekeyed(f, k)};
}

# release the places a failure owns through `a`, as `retain_places` made them
pub fun release_places(a: *A.Allocator, f: Fail) {
    val k_o: opt[Keyed] = keyed(f);
    if (sel k_o.none)            { ret; }
    if (k_o.some.at.path != nil) { str_free(a, k_o.some.at.path); }
    release_related(a, k_o.some.also, k_o.some.also.count);
}

# the same failure pointing nowhere and naming no related place, for a holder
# whose places were released or never copied
pub fun without_places(f: Fail) Fail {
    val k_o: opt[Keyed] = keyed(f);
    if (sel k_o.none) { ret f; }
    var k: Keyed = k_o.some;
    k.at   = Place{};
    k.also = Related{items: nil, count: 0};
    ret rekeyed(f, k);
}

# whether two failures hold the same places: the same path storage and the
# same related array, as a holder that copied them once sees its own copy
pub fun same_places(x: Fail, y: Fail) bool {
    val kx: opt[Keyed] = keyed(x);
    val ky: opt[Keyed] = keyed(y);
    if (sel kx.none) { ret sel ky.none; }
    if (sel ky.none) { ret false; }
    ret kx.some.at.path == ky.some.at.path && kx.some.also.items == ky.some.also.items;
}

# the closed-catalog policy lifted into the driver's kind: an input or
# capability fault is the user's, a compiler-produced member is internal. the
# message belongs to the caller's allocator
pub fun catalog(a: *A.Allocator, c: fail.Catalog) Fail {
    val message: res[str, format.FormatError] = fail.catalog_text(a, c);
    if (sel message.err) {
        if (sel message.err.alloc) { ret refused(message.err.alloc); }
        ret internal("catalog diagnostic could not be formatted");
    }
    if (fail.is_internal_member(c)) { ret internal(message.ok); }
    if (sel c.unsupported)          { ret user(dkind.CATALOG_UNSUPPORTED, message.ok); }
    ret user(dkind.CATALOG_MALFORMED, message.ok);
}

pub fun unknown_catalog(a: *A.Allocator, catalog_name: str, tag: u32) Fail {
    ret catalog(a, fail.unknown_member(catalog_name, tag));
}

# a language failure keeps its class and its kind
pub fun from_fail(f: fail.Fail) Fail {
    if (sel f.message)     { ret internal(f.message); }
    or (sel f.user)        { ret user(f.user.kind, f.user.text); }
    or (sel f.environment) { ret environment(f.environment.kind, f.environment.text); }
    ret reported();
}

# a driver failure met inside a language pass (an output write): the class
# and the kind are kept
pub fun to_fail(f: Fail) fail.Fail {
    if (sel f.user)        { ret fail.user(f.user.kind, f.user.text); }
    or (sel f.environment) { ret fail.environment(f.environment.kind, f.environment.text); }
    or (sel f.internal)    { ret fail.message(f.internal); }
    ret fail.reported();
}

# a phase failure the user caused (target selection, source loading, import
# libraries): an unkeyed text becomes the user class under `k`, a keyed
# failure keeps its own class and kind, a reported failure stays reported
pub fun user_fail(k: dkind.Kind, f: fail.Fail) Fail {
    if (sel f.message) { ret user(k, f.message); }
    ret from_fail(f);
}

pub def ArtifactKind: u8;
pub val ART_BINARY:  ArtifactKind = 0;
pub val ART_OBJECTS: ArtifactKind = 1;
pub val ART_ARCHIVE: ArtifactKind = 2;
pub val ART_SHARED:  ArtifactKind = 3;
pub val ART_TESTS:   ArtifactKind = 4;

pub rec Artifact {
    kind: ArtifactKind;
    path: str;
}

# a collected test: its qualified name, where it is declared, the test object
# that holds it, the dispatcher that runs it as `<exe> <idx>`, and the target and
# profile that dispatcher was built for
pub rec TestArtifact {
    module:  *u8;
    name:    *u8;
    file:    *u8;
    line:    u32;
    object:  *u8;
    exe:     *u8;
    idx:     u32;
    target:  *u8;
    profile: *u8;
}

# verb: what the unit's goal calls working on it, borrowed from the goal catalog
# rather than owned, since every spelling there is a static string
pub rec BuildUnitEvent {
    artifact:     str;
    target:       str;
    verb:         str;
    has_artifact: bool;
}

pub rec DiagnosticBatch {
    sources: *source.SourceMap;
    diags:   *diagnostic.DiagnosticStore;
}

# what a build recorded, in order: a unit finished, a failure, or a batch of
# diagnostics with the sources they refer to. every payload is owned by the
# outcome's allocator
pub tag BuildEvent: u8 {
    unit:        BuildUnitEvent;
    fail:        FailEvent;
    diagnostics: DiagnosticBatch;
}

# a failure recorded outside a diagnostic store, and the phase it is reported under
pub rec FailEvent {
    fail:   Fail;
    origin: diagnostic.Origin;
}

pub def BuildSeverity: u8;

pub val BUILD_OK:          BuildSeverity = 0;
pub val BUILD_USER:        BuildSeverity = 1;
pub val BUILD_ENVIRONMENT: BuildSeverity = 2;
pub val BUILD_INTERNAL:    BuildSeverity = 3;

# what a build produced and recorded. owned by the allocator outcome_init was given:
# every artifact path, test artifact, event payload and failure text in it is released
# together by outcome_dnit, and a refused record_* leaves the outcome exactly as it was
# ---
# severity:  the worst standing recorded, BUILD_OK to BUILD_INTERNAL; ordered, compared with >
# artifacts: the outputs written, in build order
# tests:     the test dispatchers built, for the runner
# events:    everything recorded, in order
pub rec BuildOutcome {
    severity:  BuildSeverity;
    artifacts: Vector[Artifact];
    tests:     Vector[TestArtifact];
    events:    Vector[BuildEvent];
}

# an empty outcome whose records `oa` will own
pub fun outcome_init(oa: *A.Allocator) BuildOutcome {
    var bo: BuildOutcome;
    bo.severity  = BUILD_OK;
    bo.artifacts = vector.init[Artifact](oa);
    bo.tests     = vector.init[TestArtifact](oa);
    bo.events    = vector.init[BuildEvent](oa);
    ret bo;
}

fun free_artifact(a: *A.Allocator, art: *Artifact) {
    if (art.path != nil) { str_free(a, art.path); }
}

fun free_test_artifact(a: *A.Allocator, t: *TestArtifact) {
    if (t.module != nil)  { str_free(a, t.module::str); }
    if (t.name != nil)    { str_free(a, t.name::str); }
    if (t.file != nil)    { str_free(a, t.file::str); }
    if (t.object != nil)  { str_free(a, t.object::str); }
    if (t.exe != nil)     { str_free(a, t.exe::str); }
    if (t.target != nil)  { str_free(a, t.target::str); }
    if (t.profile != nil) { str_free(a, t.profile::str); }
}

fun free_fail(a: *A.Allocator, f: *Fail) {
    release(a, @f);
}

fun free_diagnostic_batch(a: *A.Allocator, batch: *DiagnosticBatch) {
    if (batch.diags != nil) {
        diagnostic.store_dnit(batch.diags);
        A.deallocate[diagnostic.DiagnosticStore](a, batch.diags, 1);
    }
    if (batch.sources != nil) {
        source.dnit(batch.sources);
        A.deallocate[source.SourceMap](a, batch.sources, 1);
    }
}

fun free_event(a: *A.Allocator, ev: *BuildEvent) {
    if (sel ev.unit) {
        if (ev.unit.artifact != nil) { str_free(a, ev.unit.artifact); }
        if (ev.unit.target != nil)   { str_free(a, ev.unit.target); }
    }
    or (sel ev.fail)        { free_fail(a, ?ev.fail.fail); }
    or (sel ev.diagnostics) { free_diagnostic_batch(a, ?ev.diagnostics); }
}

# release an outcome and everything it recorded; nil is a no-op
pub fun outcome_dnit(bo: *BuildOutcome) {
    if (bo == nil) { ret; }

    var i: usize = 0;
    for (i < bo.artifacts.len) {
        free_artifact(bo.artifacts.a, ?bo.artifacts.data[i]);
        i = i + 1;
    }
    vector.dnit[Artifact](?bo.artifacts);

    var j: usize = 0;
    for (j < bo.tests.len) {
        free_test_artifact(bo.tests.a, ?bo.tests.data[j]);
        j = j + 1;
    }
    vector.dnit[TestArtifact](?bo.tests);

    var k: usize = 0;
    for (k < bo.events.len) {
        free_event(bo.events.a, ?bo.events.data[k]);
        k = k + 1;
    }
    vector.dnit[BuildEvent](?bo.events);

    bo.severity = BUILD_OK;
}

# every record_* copies what it stores into the outcome's allocator; a refused
# copy or push leaves the outcome exactly as it was and releases the copies
# made before the refusal
pub fun record_artifact(bo: *BuildOutcome, kind: ArtifactKind, path: str) err[A.Error] {
    val a:     *A.Allocator      = bo.artifacts.a;
    val dup_r: res[str, A.Error] = str_dup(a, path);
    if (sel dup_r.err) { ret err[A.Error].err{dup_r.err}; }

    var art: Artifact;
    art.kind = kind;
    art.path = dup_r.ok;

    val push_r: res[usize, A.Error] = vector.push[Artifact](?bo.artifacts, art);
    if (sel push_r.err) {
        str_free(a, art.path);
        ret err[A.Error].err{push_r.err};
    }
    ret err[A.Error].ok{};
}

# t's text is borrowed; the outcome keeps its own copy. a nil text stays nil
pub fun record_test(bo: *BuildOutcome, t: TestArtifact) err[A.Error] {
    val a:     *A.Allocator = bo.tests.a;
    var owned: TestArtifact = TestArtifact{line: t.line, idx: t.idx};
    val r:     err[A.Error] = own_test(a, ?t, ?owned);
    if (sel r.err) {
        free_test_artifact(a, ?owned);
        ret r;
    }
    val push_r: res[usize, A.Error] = vector.push[TestArtifact](?bo.tests, owned);
    if (sel push_r.err) {
        free_test_artifact(a, ?owned);
        ret err[A.Error].err{push_r.err};
    }
    ret err[A.Error].ok{};
}

fun own_test(a: *A.Allocator, t: *TestArtifact, owned: *TestArtifact) err[A.Error] {
    val module: err[A.Error] = dup_text(a, t.module, ?owned.module);
    if (sel module.err) { ret module; }
    val name: err[A.Error] = dup_text(a, t.name, ?owned.name);
    if (sel name.err) { ret name; }
    val file: err[A.Error] = dup_text(a, t.file, ?owned.file);
    if (sel file.err) { ret file; }
    val object: err[A.Error] = dup_text(a, t.object, ?owned.object);
    if (sel object.err) { ret object; }
    val target: err[A.Error] = dup_text(a, t.target, ?owned.target);
    if (sel target.err) { ret target; }
    val profile: err[A.Error] = dup_text(a, t.profile, ?owned.profile);
    if (sel profile.err) { ret profile; }
    ret dup_text(a, t.exe, ?owned.exe);
}

fun dup_text(a: *A.Allocator, text: *u8, out: **u8) err[A.Error] {
    @out = nil;
    if (text == nil) { ret err[A.Error].ok{}; }
    val dup_r: res[str, A.Error] = str_dup(a, text::str);
    if (sel dup_r.err) { ret err[A.Error].err{dup_r.err}; }
    @out = dup_r.ok::*u8;
    ret err[A.Error].ok{};
}

pub fun record_unit(bo: *BuildOutcome, artifact: str, target: str, verb: str, has_artifact: bool) err[A.Error] {
    var artifact_owned: str = nil;
    if (artifact != nil) {
        val artifact_r: res[str, A.Error] = str_dup(bo.events.a, artifact);
        if (sel artifact_r.err) { ret err[A.Error].err{artifact_r.err}; }
        artifact_owned = artifact_r.ok;
    }

    var target_owned: str = nil;
    if (target != nil) {
        val target_r: res[str, A.Error] = str_dup(bo.events.a, target);
        if (sel target_r.err) {
            if (artifact_owned != nil) { str_free(bo.events.a, artifact_owned); }
            ret err[A.Error].err{target_r.err};
        }
        target_owned = target_r.ok;
    }

    val ev:     BuildEvent          = BuildEvent.unit{BuildUnitEvent{artifact: artifact_owned, target: target_owned, verb: verb, has_artifact: has_artifact}};
    val push_r: res[usize, A.Error] = vector.push[BuildEvent](?bo.events, ev);
    if (sel push_r.err) {
        if (target_owned != nil)   { str_free(bo.events.a, target_owned); }
        if (artifact_owned != nil) { str_free(bo.events.a, artifact_owned); }
        ret err[A.Error].err{push_r.err};
    }
    ret err[A.Error].ok{};
}

# the failure is copied whole: its text into the outcome's allocator
# ---
# origin: the phase the failure is reported under
pub fun record_fail(bo: *BuildOutcome, f: *Fail, origin: diagnostic.Origin) err[A.Error] {
    val kept: res[Fail, A.Error] = retain(bo.events.a, @f);
    if (sel kept.err) { ret err[A.Error].err{kept.err}; }
    var owned: Fail = kept.ok;

    val push_r: res[usize, A.Error] = vector.push[BuildEvent](?bo.events, BuildEvent.fail{FailEvent{fail: owned, origin: origin}});
    if (sel push_r.err) {
        free_fail(bo.events.a, ?owned);
        ret err[A.Error].err{push_r.err};
    }
    ret err[A.Error].ok{};
}

# the batch is a composite of two subsystems' snapshots, so its refusal is
# the driver's failure: an internal one carrying the snapshot's own text, or
# the allocation refusal of the push
pub fun record_diagnostics(bo: *BuildOutcome, sources: *source.SourceMap, diags: *diagnostic.DiagnosticStore) err[Fail] {
    if (diagnostic.len(diags) == 0 && diagnostic.lost_count(diags) == 0) { ret err[Fail].ok{}; }

    val sources_r: res[*source.SourceMap, fail.Fail] = source.snapshot_from(sources, bo.events.a);
    if (sel sources_r.err) { ret err[Fail].err{from_fail(sources_r.err)}; }
    val owned_sources: *source.SourceMap = sources_r.ok;

    val diags_r: res[*diagnostic.DiagnosticStore, fail.Fail] = diagnostic.snapshot_from(diags, 0, bo.events.a);
    if (sel diags_r.err) {
        source.dnit(owned_sources);
        A.deallocate[source.SourceMap](bo.events.a, owned_sources, 1);
        ret err[Fail].err{from_fail(diags_r.err)};
    }
    val owned_diags: *diagnostic.DiagnosticStore = diags_r.ok;

    var batch: DiagnosticBatch;
    batch.sources = owned_sources;
    batch.diags   = owned_diags;
    val push_r: res[usize, A.Error] = vector.push[BuildEvent](?bo.events, BuildEvent.diagnostics{batch});
    if (sel push_r.err) {
        free_diagnostic_batch(bo.events.a, ?batch);
        ret err[Fail].err{refused(push_r.err)};
    }
    ret err[Fail].ok{};
}

pub fun severity_of(f: *Fail) BuildSeverity {
    if (sel f.environment) { ret BUILD_ENVIRONMENT; }
    or (sel f.internal)    { ret BUILD_INTERNAL; }
    ret BUILD_USER;
}

# a reported or user failure is the user's; the severity never regresses
pub fun fold_fail(bo: *BuildOutcome, f: *Fail) {
    val sev: BuildSeverity = severity_of(f);
    if (sev > bo.severity) { bo.severity = sev; }
}

# capacity is reserved for all three transfers before any element moves, so
# a refused reservation leaves both outcomes exactly as they were
pub fun merge(agg: *BuildOutcome, unit: *BuildOutcome) err[A.Error] {
    val ar: res[usize, A.Error] = vector.reserve[Artifact](?agg.artifacts, unit.artifacts.len);
    if (sel ar.err) { ret err[A.Error].err{ar.err}; }
    val tr: res[usize, A.Error] = vector.reserve[TestArtifact](?agg.tests, unit.tests.len);
    if (sel tr.err) { ret err[A.Error].err{tr.err}; }
    val er: res[usize, A.Error] = vector.reserve[BuildEvent](?agg.events, unit.events.len);
    if (sel er.err) { ret err[A.Error].err{er.err}; }

    var i: usize = 0;
    for (i < unit.artifacts.len) {
        val pr: res[usize, A.Error] = vector.push[Artifact](?agg.artifacts, unit.artifacts.data[i]);
        if (sel pr.err) { ret err[A.Error].err{pr.err}; }
        i = i + 1;
    }
    var j: usize = 0;
    for (j < unit.tests.len) {
        val pr: res[usize, A.Error] = vector.push[TestArtifact](?agg.tests, unit.tests.data[j]);
        if (sel pr.err) { ret err[A.Error].err{pr.err}; }
        j = j + 1;
    }
    var k: usize = 0;
    for (k < unit.events.len) {
        val pr: res[usize, A.Error] = vector.push[BuildEvent](?agg.events, unit.events.data[k]);
        if (sel pr.err) { ret err[A.Error].err{pr.err}; }
        k = k + 1;
    }

    if (unit.severity > agg.severity) { agg.severity = unit.severity; }

    vector.dnit[Artifact](?unit.artifacts);
    vector.dnit[TestArtifact](?unit.tests);
    vector.dnit[BuildEvent](?unit.events);
    unit.severity = BUILD_OK;
    ret err[A.Error].ok{};
}

pub rec GateTally {
    pass:                   u32;
    semantic_mismatch:      u32;
    unsupported_input:      u32;
    tool_unavailable:       u32;
    infrastructure_failure: u32;
    resource_exhaustion:    u32;
    invalid_injection:      u32;
    results:                Vector[validation.ValidationGateResult];
}

pub fun gate_tally_init(a: *A.Allocator) GateTally {
    var gt: GateTally;
    gt.pass                   = 0;
    gt.semantic_mismatch      = 0;
    gt.unsupported_input      = 0;
    gt.tool_unavailable       = 0;
    gt.infrastructure_failure = 0;
    gt.resource_exhaustion    = 0;
    gt.invalid_injection      = 0;
    gt.results                = vector.init[validation.ValidationGateResult](a);
    ret gt;
}

#[testing]
pub fun gate_tally_dnit(gt: *GateTally) {
    if (gt == nil) { ret; }
    var i: usize = 0;
    for (i < gt.results.len) {
        val r: *validation.ValidationGateResult = ?gt.results.data[i];
        if (r.detail_identity != nil) { str_free(gt.results.a, r.detail_identity); }
        i = i + 1;
    }
    vector.dnit[validation.ValidationGateResult](?gt.results);
    gt.pass                   = 0;
    gt.semantic_mismatch      = 0;
    gt.unsupported_input      = 0;
    gt.tool_unavailable       = 0;
    gt.infrastructure_failure = 0;
    gt.resource_exhaustion    = 0;
    gt.invalid_injection      = 0;
}

pub fun record_gate(gt: *GateTally, a: *A.Allocator, r: validation.ValidationGateResult) err[A.Error] {
    var stored: validation.ValidationGateResult = r;
    if (r.detail_identity != nil) {
        val dup_r: res[str, A.Error] = str_dup(a, r.detail_identity);
        if (sel dup_r.err) { ret err[A.Error].err{dup_r.err}; }
        stored.detail_identity = dup_r.ok;
    }

    val push_r: res[usize, A.Error] = vector.push[validation.ValidationGateResult](?gt.results, stored);
    if (sel push_r.err) {
        if (stored.detail_identity != nil) { str_free(a, stored.detail_identity); }
        ret err[A.Error].err{push_r.err};
    }

    if (r.kind == validation.RESULT_PASS)                   { gt.pass = gt.pass + 1; }
    or (r.kind == validation.RESULT_SEMANTIC_MISMATCH)      { gt.semantic_mismatch = gt.semantic_mismatch + 1; }
    or (r.kind == validation.RESULT_UNSUPPORTED_INPUT)      { gt.unsupported_input = gt.unsupported_input + 1; }
    or (r.kind == validation.RESULT_TOOL_UNAVAILABLE)       { gt.tool_unavailable = gt.tool_unavailable + 1; }
    or (r.kind == validation.RESULT_INFRASTRUCTURE_FAILURE) { gt.infrastructure_failure = gt.infrastructure_failure + 1; }
    or (r.kind == validation.RESULT_RESOURCE_EXHAUSTION)    { gt.resource_exhaustion = gt.resource_exhaustion + 1; }
    or (r.kind == validation.RESULT_INVALID_INJECTION)      { gt.invalid_injection = gt.invalid_injection + 1; }
    ret err[A.Error].ok{};
}

#[testing]
pub fun gate_tally_total(gt: *GateTally) u32 {
    ret gt.pass + gt.semantic_mismatch + gt.unsupported_input + gt.tool_unavailable
        + gt.infrastructure_failure + gt.resource_exhaustion + gt.invalid_injection;
}

#[testing]
fun t_owned_nothing(t: *T.Testing) bool {
    ret !T.tracking_exhausted(t) && !T.leaked(t) && T.double_free_count(t) == 0;
}

#[testing]
fun t_refused(r: err[A.Error]) bool {
    ret sel r.err;
}

#[testing]
fun t_accepted(r: err[A.Error]) bool {
    ret sel r.ok;
}

#[testing]
fun t_unit_is(ev: *BuildEvent, artifact: str, target: str) bool {
    if (!sel ev.unit) { ret false; }
    ret str_equals(ev.unit.artifact, artifact) && str_equals(ev.unit.target, target);
}

# the recorded failure keeps the case and owns a fresh copy of the text
#[testing]
fun t_fail_copied(ev: *BuildEvent, original: Fail) bool {
    if (!sel ev.fail)                                 { ret false; }
    if (!sel ev.fail.fail.user)                       { ret false; }
    if (!sel original.user)                           { ret false; }
    if (ev.fail.fail.user.text == original.user.text) { ret false; }
    ret ev.fail.fail.user.kind == original.user.kind && str_equals(ev.fail.fail.user.text, original.user.text);
}

# the three closed-catalog classes land on distinct driver outcomes: a member
# from input or a cross-module product and a declared member a target cannot
# honor are the user's (exit 1), a member the compiler produced is internal
# (exit 2); each message names the catalog and the member
#[testing]
fun t_user_with(f: Fail, want: str) bool {
    if (!sel f.user) { ret false; }
    ret str_equals(f.user.text, want);
}

#[testing]
fun t_internal_with(f: Fail, want: str) bool {
    if (!sel f.internal) { ret false; }
    ret str_equals(f.internal, want);
}

#[testing]
fun t_release(a: *A.Allocator, f: Fail) {
    val carried: opt[str] = text(f);
    if (sel carried.some) { str_free(a, carried.some); }
}

# a site cannot report a user or environment failure without naming its
# registry row: an unkeyed one is a compiler defect
test user__a_failure_without_a_kind_is_internal {
    val unkeyed: Fail = user(dkind.NONE, "no kind");
    if (!sel unkeyed.internal || kind_of(unkeyed) != dkind.COMPILER_INTERNAL) { ret 1; }
    val env: Fail = environment(dkind.NONE, "no kind");
    if (!sel env.internal) { ret 2; }
    val keyed: Fail = user(dkind.TOML_MALFORMED, "keyed");
    if (!sel keyed.user || kind_of(keyed) != dkind.TOML_MALFORMED) { ret 3; }
    ret 0;
}

test catalog__three_classes_land_on_distinct_kinds_naming_the_member {
    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    val malformed: Fail = catalog(?a, fail.malformed_member("SectionKind", 200));
    fin { t_release(?a, malformed); }
    if (!t_user_with(malformed, "malformed SectionKind tag 200")) { ret 2; }
    val unsupported: Fail = catalog(?a, fail.unsupported_member("Subsystem", "gui", "x86_64-linux"));
    fin { t_release(?a, unsupported); }
    if (!t_user_with(unsupported, "Subsystem gui is unsupported by x86_64-linux")) { ret 3; }
    val internal_fail: Fail = unknown_catalog(?a, "PhaseKind", 255);
    fin { t_release(?a, internal_fail); }
    if (!t_internal_with(internal_fail, "unknown PhaseKind tag 255")) { ret 4; }
    if (sel malformed.internal || sel unsupported.internal)           { ret 5; }
    ret 0;
}

test fail__cases_carry_their_text_and_lift_from_a_lang_fail {
    val r: Fail = reported();
    if (!sel r.reported) { ret 1; }
    val rt: opt[str] = text(r);
    if (!sel rt.none)                                             { ret 2; }
    if (!t_user_with(user(dkind.TOML_MALFORMED, "nope"), "nope")) { ret 3; }
    if (!t_internal_with(internal("boom"), "boom"))               { ret 4; }
    val e: Fail = environment(dkind.TOML_MALFORMED, "disk full");
    if (!sel e.environment) { ret 5; }
    val et: opt[str] = text(e);
    if (!sel et.some)                                                          { ret 6; }
    if (!str_equals(et.some, "disk full"))                                     { ret 6; }
    if (!t_internal_with(refused(A.Error.exhausted{}), "out of memory"))       { ret 7; }
    if (!t_internal_with(from_fail(fail.message("lower: bad")), "lower: bad")) { ret 8; }
    val lifted: Fail = from_fail(fail.reported());
    if (!sel lifted.reported) { ret 9; }
    val kept: Fail = with_text(e, "replaced");
    if (!sel kept.environment)                          { ret 10; }
    if (!str_equals(kept.environment.text, "replaced")) { ret 10; }
    val still: Fail = with_text(r, "ignored");
    if (!sel still.reported) { ret 11; }
    var zero: Fail;
    if (!sel zero.reported)                                                    { ret 12; }
    if (severity_of(?r) != BUILD_USER || severity_of(?e) != BUILD_ENVIRONMENT) { ret 13; }
    ret 0;
}

# a range resolves to the line and column of each end, a related range with it,
# and the places survive a text swap and a recorded copy, which owns its own
# paths (#3607, #4116)
test place__a_located_failure_keeps_its_places_through_copies {
    var tracking: T.Testing;
    val made:     err[A.Error] = T.make(?tracking);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?tracking); }
    val a:    *A.Allocator = T.allocator_of(?tracking);
    val text: str          = "[project]\nmach = \"^x\"\n";
    var also: Place;
    also.spanned = true;
    also.start   = 0;
    also.end     = 9;
    val keyed: Fail       = with_related(a, spanned(user(dkind.VERSION_INVALID_RANGE, "bad range"), 17, 21), ?also, 1);
    val f:     Fail       = placed(a, keyed, "mach.toml", text);
    val at:    opt[Place] = place_of(f);
    if (sel at.none) { ret 2; }
    val p: Place = at.some;
    if (!str_equals(p.path, "mach.toml") || p.start != 17 || p.end != 21) { ret 3; }
    if (p.line != 2 || p.col != 8 || p.end_line != 2 || p.end_col != 12)  { ret 4; }
    val rel: Related = related_of(f);
    if (rel.count != 1 || !str_equals(rel.items[0].path, "mach.toml"))                                               { ret 9; }
    if (rel.items[0].line != 1 || rel.items[0].col != 1 || rel.items[0].end_line != 1 || rel.items[0].end_col != 10) { ret 9; }
    val renamed: opt[Place] = place_of(with_text(f, "renamed"));
    if (sel renamed.none)            { ret 5; }
    if (renamed.some.path != p.path) { ret 5; }

    var bo: BuildOutcome = outcome_init(a);
    var fv: Fail         = f;
    if (t_refused(record_fail(?bo, ?fv, diagnostic.ORIGIN_BUILD))) { ret 6; }
    var kept:      opt[Place]  = opt[Place].none{};
    var kept_also: Related     = Related{items: nil, count: 0};
    val ev:        *BuildEvent = ?bo.events.data[0];
    if (sel ev.fail) {
        kept      = place_of(ev.fail.fail);
        kept_also = related_of(ev.fail.fail);
    }
    var bad: i32 = 0;
    if (sel kept.some) {
        if (kept.some.path == p.path || !str_equals(kept.some.path, "mach.toml") || kept.some.start != 17) { bad = 7; }
    }
    or { bad = 7; }
    if (kept_also.count != 1 || kept_also.items == rel.items || kept_also.items[0].path == rel.items[0].path
        || kept_also.items[0].end != 9) { bad = 10; }
    outcome_dnit(?bo);
    release_places(a, f);
    if (bad != 0)                    { ret bad; }
    if (!t_owned_nothing(?tracking)) { ret 8; }
    ret 0;
}

test record_artifact__fails_closed_without_a_partial_record {
    var failing: T.Testing;
    val made:    err[A.Error] = T.make(?failing);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?failing); }
    T.fail_at_ordinal(?failing, 1::usize);

    var bo: BuildOutcome = outcome_init(T.allocator_of(?failing));
    if (t_accepted(record_artifact(?bo, ART_BINARY, "out/bin/x"))) { ret 1; }
    if (bo.artifacts.len != 0)                                     { ret 1; }

    outcome_dnit(?bo);
    if (!t_owned_nothing(?failing)) { ret 1; }
    ret 0;
}

test record_test__rolls_back_every_owned_string_on_failure {
    var found:   bool = false;
    var ordinal: u64  = 1;
    for (ordinal <= 16 && !found) {
        var failing: T.Testing;
        val made:    err[A.Error] = T.make(?failing);
        if (sel made.err) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);

        var bo: BuildOutcome = outcome_init(T.allocator_of(?failing));
        val r:  err[A.Error] = record_test(?bo, TestArtifact{module: "mod", name: "mod#name", file: "file.mach", line: 7, object: "mod.test.o", exe: "exe", idx: 2});
        if (sel r.err && bo.tests.len == 0) { found = true; }

        outcome_dnit(?bo);
        val clean: bool = t_owned_nothing(?failing);
        T.dnit(?failing);
        if (!clean) { ret 1; }
        ordinal = ordinal + 1;
    }
    if (!found) { ret 1; }
    ret 0;
}

test fold_fail__internal_dominates_and_never_regresses {
    var bo: BuildOutcome;
    bo.severity = BUILD_OK;

    var reported_f: Fail = reported();
    fold_fail(?bo, ?reported_f);
    if (bo.severity != BUILD_USER) { ret 1; }

    var env_f: Fail = environment(dkind.TOML_MALFORMED, "disk full");
    fold_fail(?bo, ?env_f);
    if (bo.severity != BUILD_ENVIRONMENT) { ret 2; }

    var user_f: Fail = user(dkind.TOML_MALFORMED, "nope");
    fold_fail(?bo, ?user_f);
    if (bo.severity != BUILD_ENVIRONMENT) { ret 3; }

    var internal_f: Fail = internal("boom");
    fold_fail(?bo, ?internal_f);
    if (bo.severity != BUILD_INTERNAL) { ret 4; }

    var env_f2: Fail = environment(dkind.TOML_MALFORMED, "disk full again");
    fold_fail(?bo, ?env_f2);
    if (bo.severity != BUILD_INTERNAL) { ret 5; }

    ret 0;
}

test merge__severity_is_order_independent {
    var a: A.Allocator;
    page.make(?a);

    var agg_first: BuildOutcome = outcome_init(?a);
    var user_unit: BuildOutcome = outcome_init(?a);
    user_unit.severity = BUILD_USER;
    var internal_unit: BuildOutcome = outcome_init(?a);
    internal_unit.severity = BUILD_INTERNAL;

    if (t_refused(merge(?agg_first, ?user_unit)))     { ret 1; }
    if (t_refused(merge(?agg_first, ?internal_unit))) { ret 2; }
    if (agg_first.severity != BUILD_INTERNAL)         { ret 3; }
    outcome_dnit(?agg_first);

    var agg_second:     BuildOutcome = outcome_init(?a);
    var internal_unit2: BuildOutcome = outcome_init(?a);
    internal_unit2.severity = BUILD_INTERNAL;
    var user_unit2: BuildOutcome = outcome_init(?a);
    user_unit2.severity = BUILD_USER;

    if (t_refused(merge(?agg_second, ?internal_unit2))) { ret 5; }
    if (t_refused(merge(?agg_second, ?user_unit2)))     { ret 6; }
    if (agg_second.severity != BUILD_INTERNAL)          { ret 7; }
    outcome_dnit(?agg_second);

    ret 0;
}

test merge__transfers_artifacts_and_tests_and_empties_the_source {
    var a: A.Allocator;
    page.make(?a);

    var agg: BuildOutcome = outcome_init(?a);
    if (t_refused(record_artifact(?agg, ART_BINARY, "agg-existing"))) { ret 1; }

    var unit: BuildOutcome = outcome_init(?a);
    if (t_refused(record_artifact(?unit, ART_OBJECTS, "unit-object")))                           { ret 2; }
    if (t_refused(record_test(?unit, TestArtifact{module: "m", name: "l", file: "f", line: 1}))) { ret 3; }

    if (t_refused(merge(?agg, ?unit))) { ret 4; }

    var bad: i32 = 0;
    if (agg.artifacts.len != 2)                                                 { bad = 1; }
    or (!str_equals(agg.artifacts.data[0].path, "agg-existing"))                { bad = 1; }
    or (!str_equals(agg.artifacts.data[1].path, "unit-object"))                 { bad = 1; }
    if (agg.tests.len != 1)                                                     { bad = 1; }
    if (unit.artifacts.len != 0 || unit.tests.len != 0 || unit.events.len != 0) { bad = 1; }

    outcome_dnit(?agg);
    ret bad;
}

test merge__reserve_failure_leaves_both_sides_untouched {
    var backing: A.Allocator;
    page.make(?backing);
    var failing: T.Testing;
    val made:    err[A.Error] = T.make(?failing);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?failing); }
    T.fail_at_ordinal(?failing, 1::usize);

    var agg:  BuildOutcome = outcome_init(T.allocator_of(?failing));
    var unit: BuildOutcome = outcome_init(?backing);
    if (t_refused(record_artifact(?unit, ART_BINARY, "x"))) { ret 1; }

    if (t_accepted(merge(?agg, ?unit))) { ret 2; }
    if (agg.artifacts.len != 0)         { ret 3; }
    if (unit.artifacts.len != 1)        { ret 4; }

    outcome_dnit(?agg);
    outcome_dnit(?unit);
    if (!t_owned_nothing(?failing)) { ret 1; }
    ret 0;
}

test events__own_payloads_and_preserve_order {
    var a: A.Allocator;
    page.make(?a);
    var bo: BuildOutcome = outcome_init(?a);

    var f: Fail = user(dkind.TOML_MALFORMED, "bad input");
    if (t_refused(record_unit(?bo, "app", "linux-x86_64", "building", true))) {
        outcome_dnit(?bo);
        ret 1;
    }
    if (t_refused(record_fail(?bo, ?f, diagnostic.ORIGIN_BUILD))) {
        outcome_dnit(?bo);
        ret 1;
    }

    var bad: i32 = 0;
    if (bo.events.len != 2)                                    { bad = 1; }
    or (!t_unit_is(?bo.events.data[0], "app", "linux-x86_64")) { bad = 1; }
    or (!t_fail_copied(?bo.events.data[1], f))                 { bad = 1; }

    outcome_dnit(?bo);
    ret bad;
}

test gate_tally__counts_and_retains_identity_for_every_kind {
    var a: A.Allocator;
    page.make(?a);
    var gt: GateTally = gate_tally_init(?a);

    if (t_refused(record_gate(?gt, ?a, validation.gate_result(validation.RESULT_PASS, validation.CAUSE_PASS, nil))))                               { ret 1; }
    if (t_refused(record_gate(?gt, ?a, validation.gate_result(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_EXIT, "case-a"))))      { ret 2; }
    if (t_refused(record_gate(?gt, ?a, validation.gate_result(validation.RESULT_UNSUPPORTED_INPUT, validation.CAUSE_UNSUPPORTED, nil))))           { ret 3; }
    if (t_refused(record_gate(?gt, ?a, validation.gate_result(validation.RESULT_TOOL_UNAVAILABLE, validation.CAUSE_TOOL_UNAVAILABLE, nil))))       { ret 4; }
    if (t_refused(record_gate(?gt, ?a, validation.gate_result(validation.RESULT_INFRASTRUCTURE_FAILURE, validation.CAUSE_ORACLE_CAPTURE, nil))))   { ret 5; }
    if (t_refused(record_gate(?gt, ?a, validation.gate_result(validation.RESULT_RESOURCE_EXHAUSTION, validation.CAUSE_ORACLE_OUTPUT_LIMIT, nil)))) { ret 6; }
    if (t_refused(record_gate(?gt, ?a, validation.gate_result(validation.RESULT_INVALID_INJECTION, validation.CAUSE_INVALID_INJECTOR, nil))))      { ret 7; }

    var bad: i32 = 0;
    if (gt.pass != 1)                                              { bad = 1; }
    or (gt.semantic_mismatch != 1)                                 { bad = 1; }
    or (gt.unsupported_input != 1)                                 { bad = 1; }
    or (gt.tool_unavailable != 1)                                  { bad = 1; }
    or (gt.infrastructure_failure != 1)                            { bad = 1; }
    or (gt.resource_exhaustion != 1)                               { bad = 1; }
    or (gt.invalid_injection != 1)                                 { bad = 1; }
    or (gate_tally_total(?gt) != 7)                                { bad = 1; }
    or (gt.results.len != 7)                                       { bad = 1; }
    or (!str_equals(gt.results.data[1].detail_identity, "case-a")) { bad = 1; }

    gate_tally_dnit(?gt);
    if (gate_tally_total(?gt) != 0 || gt.results.len != 0) { bad = 1; }

    ret bad;
}

test record_gate__fails_closed_and_frees_the_duplicated_identity {
    var failing: T.Testing;
    val made:    err[A.Error] = T.make(?failing);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?failing); }
    T.fail_at_ordinal(?failing, 2::usize);

    var gt: GateTally    = gate_tally_init(T.allocator_of(?failing));
    val r:  err[A.Error] = record_gate(?gt, T.allocator_of(?failing),
        validation.gate_result(validation.RESULT_SEMANTIC_MISMATCH, validation.CAUSE_ORACLE_EXIT, "identity"));
    if (sel r.ok)                                          { ret 1; }
    if (gt.results.len != 0 || gate_tally_total(?gt) != 0) { ret 2; }

    gate_tally_dnit(?gt);
    if (!t_owned_nothing(?failing)) { ret 1; }
    ret 0;
}
