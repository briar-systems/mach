# an executable's resources as a 32-bit resource file, the input mink builds a
# PE image's resource tree from: its icon's images and their group, its version
# information and its application manifest (Win32 RESOURCEHEADER, VS_VERSIONINFO,
# and the icon directory of an .ico file)
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use utf8: std.text.utf8;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mink_fail: mink.base.fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;

val RT_ICON:       u16 = 3;
val RT_GROUP_ICON: u16 = 14;
val RT_VERSION:    u16 = 16;
val RT_MANIFEST:   u16 = 24;

# a header with a numbered type and name: its two sizes, the two keys, then the
# data version, memory flags, language, version and characteristics
val HEADER_SIZE: u32 = 32;
# the code unit that marks a key as a number
val NUMBERED: u16 = 0xffff;
# moveable, pure and discardable, as a resource compiler marks a resource. an
# image's resource tree carries no flags, so mink reads none
val MEMORY_FLAGS: u16 = 0x1030;

val ICONDIR_SIZE:         usize = 6;
val ICONDIRENTRY_SIZE:    usize = 16;
val GRPICONDIRENTRY_SIZE: usize = 14;

# the most bytes a version node's 16-bit length states
val NODE_LIMIT: usize = 65535;
val FIXED_SIZE: u16   = 52;
# the language and code page of the version strings: us english, unicode
val STRING_TABLE: str = "040904B0";
val TRANSLATION:  u32 = 0x04B00409;

# what an executable declares of its resources
# ---
# icon:              the .ico file's bytes, nil for none
# icon_len:          how many
# manifest:          the application manifest's bytes, nil for none
# manifest_len:      how many
# version:           the version its version information states
# internal_name:     the name its version information states
# original_filename: the file name its version information states
# product_name:      the product its version information states
pub rec Declared {
    icon:              *u8;
    icon_len:          usize;
    manifest:          *u8;
    manifest_len:      usize;
    version:           str;
    internal_name:     str;
    original_filename: str;
    product_name:      str;
}

# a resource file being written. a failed write poisons it, and a version node
# past its 16-bit length marks it too large, which finishing reports
rec Out {
    s:         Sink;
    poisoned:  bool;
    too_large: bool;
}

fun out_make(a: *A.Allocator) Out {
    ret Out{s: sink.make(a, LITTLE), poisoned: false, too_large: false};
}

fun keep(o: *Out, r: err[mink_fail.Fail]) {
    if (sel r.err) { o.poisoned = true; }
}

fun w16(o: *Out, v: u16) {
    keep(o, sink.u16(?o.s, v));
}

fun w32(o: *Out, v: u32) {
    keep(o, sink.u32(?o.s, v));
}

fun align4(o: *Out) {
    keep(o, sink.pad_to(?o.s, 4));
}

fun rd16(p: *u8, off: usize) u16 {
    ret p[off]::u16 | (p[off + 1]::u16 << 8);
}

fun rd32(p: *u8, off: usize) u32 {
    ret rd16(p, off)::u32 | (rd16(p, off + 2)::u32 << 16);
}

fun region_ok(len: usize, off: usize, n: usize) bool {
    ret off <= len && n <= len - off;
}

# the header of a resource of numbered `type` and `name` holding `len` bytes
fun header(o: *Out, type: u16, name: u16, flags: u16, len: usize) {
    w32(o, len::u32);
    w32(o, HEADER_SIZE);
    w16(o, NUMBERED);
    w16(o, type);
    w16(o, NUMBERED);
    w16(o, name);
    w32(o, 0);
    w16(o, flags);
    w16(o, 0);
    w32(o, 0);
    w32(o, 0);
}

# a resource of numbered `type` and `name` holding the `len` bytes at `data`, and
# the padding to the next header
fun resource(o: *Out, type: u16, name: u16, data: *u8, len: usize) {
    header(o, type, name, MEMORY_FLAGS, len);
    if (len != 0) { keep(o, sink.bytes(?o.s, data, len)); }
    align4(o);
}

fun malformed_icon(text: str) fail.Fail {
    ret fail.user(diagnostic_kind.RESOURCE_ICON_MALFORMED, text);
}

# how many images the .ico file at `icon` holds, each within it
fun icon_images(icon: *u8, len: usize) res[u16, fail.Fail] {
    if (!region_ok(len, 0, ICONDIR_SIZE)) { ret res[u16, fail.Fail].err{malformed_icon("icon buffer too small for header")}; }
    if (rd16(icon, 0) != 0)                { ret res[u16, fail.Fail].err{malformed_icon("icon reserved field must be 0")}; }
    if (rd16(icon, 2) != 1)                { ret res[u16, fail.Fail].err{malformed_icon("icon type field must be 1")}; }
    val count: u16 = rd16(icon, 4);
    if (count == 0) { ret res[u16, fail.Fail].err{malformed_icon("icon directory is empty")}; }
    val dir_len: usize = count::usize * ICONDIRENTRY_SIZE;
    if (!region_ok(len, ICONDIR_SIZE, dir_len)) { ret res[u16, fail.Fail].err{malformed_icon("icon directory runs past end of buffer")}; }
    var i: usize = 0;
    for (i < count::usize) {
        val at:     usize = ICONDIR_SIZE + i * ICONDIRENTRY_SIZE;
        val size:   u32   = rd32(icon, at + 8);
        val offset: u32   = rd32(icon, at + 12);
        if (size == 0)                                      { ret res[u16, fail.Fail].err{malformed_icon("icon image data is empty")}; }
        if (offset::usize < ICONDIR_SIZE + dir_len)         { ret res[u16, fail.Fail].err{malformed_icon("icon image data overlaps its directory")}; }
        if (!region_ok(len, offset::usize, size::usize))    { ret res[u16, fail.Fail].err{malformed_icon("icon image data runs past end of buffer")}; }
        i = i + 1;
    }
    ret res[u16, fail.Fail].ok{count};
}

# each image of the icon as its own resource, named from 1, then the group naming them
fun icon(o: *Out, icon: *u8, count: u16) {
    var i: usize = 0;
    for (i < count::usize) {
        val at: usize = ICONDIR_SIZE + i * ICONDIRENTRY_SIZE;
        resource(o, RT_ICON, (i + 1)::u16, (icon::usize + rd32(icon, at + 12)::usize)::*u8, rd32(icon, at + 8)::usize);
        i = i + 1;
    }
    header(o, RT_GROUP_ICON, 1, MEMORY_FLAGS, ICONDIR_SIZE + count::usize * GRPICONDIRENTRY_SIZE);
    w16(o, 0);
    w16(o, 1);
    w16(o, count);
    i = 0;
    for (i < count::usize) {
        val at: usize = ICONDIR_SIZE + i * ICONDIRENTRY_SIZE;
        keep(o, sink.bytes(?o.s, (icon::usize + at)::*u8, 4));
        w16(o, rd16(icon, at + 4));
        w16(o, rd16(icon, at + 6));
        w32(o, rd32(icon, at + 8));
        w16(o, (i + 1)::u16);
        i = i + 1;
    }
    align4(o);
}

# the four 16-bit parts of a dotted version, missing parts 0
rec Parts {
    at: [4]u16;
}

fun parts_of(version: str) res[Parts, fail.Fail] {
    var p: Parts;
    p.at[0] = 0;
    p.at[1] = 0;
    p.at[2] = 0;
    p.at[3] = 0;
    if (version == nil) { ret res[Parts, fail.Fail].ok{p}; }
    val len: usize = str_len(version);
    var idx: usize = 0;
    var cur: u32   = 0;
    var i:   usize = 0;
    for (i < len && idx < 4) {
        val c: u8 = version[i]::u8;
        if (c >= '0'::u8 && c <= '9'::u8) {
            cur = cur * 10 + (c - '0'::u8)::u32;
            if (cur > 65535) {
                ret res[Parts, fail.Fail].err{fail.user(diagnostic_kind.RESOURCE_METADATA_INVALID, "version component exceeds 65535")};
            }
            i = i + 1;
            cnt;
        }
        if (c != '.'::u8) { brk; }
        p.at[idx] = cur::u16;
        idx       = idx + 1;
        cur       = 0;
        i         = i + 1;
    }
    if (idx < 4) { p.at[idx] = cur::u16; }
    ret res[Parts, fail.Fail].ok{p};
}

# whether `s` is UTF-8 a version string can carry
fun valid_text(s: str) bool {
    ret s != nil && utf8.validate(s::*u8, str_len(s));
}

# the UTF-16 code units of `s` with its NUL
fun units_of(s: str) usize {
    val len:   usize = str_len(s);
    var off:   usize = 0;
    var units: usize = 1;
    for (off < len) {
        var cp:   utf8.Codepoint = 0;
        val used: usize          = utf8.decode((s::usize + off)::*u8, len - off, ?cp);
        if (used == 0) { brk; }
        units = units + 1;
        if (cp > 0xffff) { units = units + 1; }
        off = off + used;
    }
    ret units;
}

# `s` in UTF-16 with its NUL
fun wide(o: *Out, s: str) {
    val len: usize = str_len(s);
    var off: usize = 0;
    for (off < len) {
        var cp:   utf8.Codepoint = 0;
        val used: usize          = utf8.decode((s::usize + off)::*u8, len - off, ?cp);
        if (used == 0) { brk; }
        if (cp <= 0xffff) { w16(o, cp::u16); }
        or {
            val v: u32 = cp::u32 - 0x10000;
            w16(o, (0xd800 | (v >> 10))::u16);
            w16(o, (0xdc00 | (v & 0x3ff))::u16);
        }
        off = off + used;
    }
    w16(o, 0);
}

# the start of a version node with `value_len` of value, of `kind` 1 for text and
# 0 for binary, named `key`, its length patched when it closes
fun node_open(o: *Out, value_len: usize, kind: u16, key: str) usize {
    align4(o);
    val at: usize = sink.len(?o.s);
    w16(o, 0);
    if (value_len > NODE_LIMIT) { o.too_large = true; }
    w16(o, value_len::u16);
    w16(o, kind);
    wide(o, key);
    align4(o);
    ret at;
}

fun node_close(o: *Out, at: usize) {
    val n: usize = sink.len(?o.s) - at;
    if (n > NODE_LIMIT) {
        o.too_large = true;
        ret;
    }
    keep(o, sink.patch(?o.s, at, n::u64, 2));
}

fun string_node(o: *Out, key: str, value: str) {
    val at: usize = node_open(o, units_of(value), 1, key);
    wide(o, value);
    node_close(o, at);
}

# VS_FIXEDFILEINFO for a file and product of version `p`
fun fixed(o: *Out, p: Parts) {
    val ms: u32 = (p.at[0]::u32 << 16) | p.at[1]::u32;
    val ls: u32 = (p.at[2]::u32 << 16) | p.at[3]::u32;
    w32(o, 0xfeef04bd);
    w32(o, 0x00010000);
    w32(o, ms);
    w32(o, ls);
    w32(o, ms);
    w32(o, ls);
    w32(o, 0x3f);
    w32(o, 0);
    w32(o, 0x00040004);
    w32(o, 1);
    w32(o, 0);
    w32(o, 0);
    w32(o, 0);
}

# the version information `d` states, written into `o` as one resource's data
fun version_info(o: *Out, d: *Declared, p: Parts) {
    val root: usize = node_open(o, FIXED_SIZE::usize, 0, "VS_VERSION_INFO");
    fixed(o, p);
    val sfi: usize = node_open(o, 0, 1, "StringFileInfo");
    val st:  usize = node_open(o, 0, 1, STRING_TABLE);
    string_node(o, "FileVersion", d.version);
    string_node(o, "InternalName", d.internal_name);
    string_node(o, "OriginalFilename", d.original_filename);
    string_node(o, "ProductName", d.product_name);
    string_node(o, "ProductVersion", d.version);
    node_close(o, st);
    node_close(o, sfi);
    val vfi: usize = node_open(o, 0, 1, "VarFileInfo");
    val tr:  usize = node_open(o, 4, 0, "Translation");
    w32(o, TRANSLATION);
    node_close(o, tr);
    node_close(o, vfi);
    node_close(o, root);
}

fun finished(o: *Out, what: str) err[fail.Fail] {
    if (o.too_large) { ret err[fail.Fail].err{fail.user(diagnostic_kind.RESOURCE_SIZE_LIMIT, "version information exceeds 65535 bytes")}; }
    if (o.poisoned)  { ret err[fail.Fail].err{fail.message(what)}; }
    ret err[fail.Fail].ok{};
}

# the resource file of what `d` declares, owned by the caller: the icon's images
# and group where it declares an icon, the version information, and the manifest
# where it declares one
pub fun file_of(a: *A.Allocator, d: *Declared) res[Sink, fail.Fail] {
    if (d.manifest != nil && d.manifest_len == 0) { ret res[Sink, fail.Fail].err{fail.user(diagnostic_kind.ARTIFACT_RESOURCE_EMPTY, "application manifest is empty")}; }
    if (d.manifest_len > 0xffffffff::usize)       { ret res[Sink, fail.Fail].err{fail.user(diagnostic_kind.RESOURCE_SIZE_LIMIT, "application manifest exceeds PE's 32-bit size field")}; }
    var count: u16 = 0;
    if (d.icon != nil) {
        val images: res[u16, fail.Fail] = icon_images(d.icon, d.icon_len);
        if (sel images.err) { ret res[Sink, fail.Fail].err{images.err}; }
        count = images.ok;
    }
    if (!valid_text(d.version) || !valid_text(d.internal_name) || !valid_text(d.original_filename) || !valid_text(d.product_name)) {
        ret res[Sink, fail.Fail].err{fail.user(diagnostic_kind.RESOURCE_METADATA_INVALID, "version metadata is not valid UTF-8")};
    }
    val parts: res[Parts, fail.Fail] = parts_of(d.version);
    if (sel parts.err) { ret res[Sink, fail.Fail].err{parts.err}; }

    var v: Out = out_make(a);
    fin { val freed: err[mink_fail.Fail] = sink.release(?v.s); }
    version_info(?v, d, parts.ok);
    val built: err[fail.Fail] = finished(?v, "the version information could not be written");
    if (sel built.err) { ret res[Sink, fail.Fail].err{built.err}; }

    var o:    Out  = out_make(a);
    var kept: bool = false;
    fin {
        if (!kept) { val freed: err[mink_fail.Fail] = sink.release(?o.s); }
    }
    header(?o, 0, 0, 0, 0);
    if (count != 0) { icon(?o, d.icon, count); }
    resource(?o, RT_VERSION, 1, sink.data(?v.s), sink.len(?v.s));
    if (d.manifest != nil) { resource(?o, RT_MANIFEST, 1, d.manifest, d.manifest_len); }
    val wrote: err[fail.Fail] = finished(?o, "the resource file could not be written");
    if (sel wrote.err) { ret res[Sink, fail.Fail].err{wrote.err}; }
    kept = true;
    ret res[Sink, fail.Fail].ok{o.s};
}
