rec UnitState {
    inputs:     *target_of.ObjectInput;
    obj_len:    u32;
    dynlibs:    *target_of.DynLib;
    dynlib_len: u32;

    out_path: *u8;
    scope:    build_testing.TestScope;
    objects:  *str;
    # beside objects: the test object path of each emitted module that has one, else nil
    test_objects: *str;
    ir_outputs:   *str;
    asm_outputs:  *str;
    artifact:     str;
    dispatcher:   str;
    # what the host's earlier links wrote, read and extended by this unit's
    published: *publication.Publications;
}

fun label_failed(failed: *Vector[str], label: str) bool {
    var j: usize = 0;
    for (j < failed.len) {
        if (str_equals(failed.data[j], label)) { ret true; }
        j = j + 1;
    }
    ret false;
}

# the label of a failed cell `u` waits on, none when none has failed. a manifest
# requirement is labelled in `u`'s own scope, `<owner>.<artifact>` for a dependency
fun blocking_requirement(oa: *A.Allocator, failed: *Vector[str], u: *build_plan.BuildUnit) res[opt[str], fail.Fail] {
    var i: usize = 0;
    for (i < u.requires.len) {
        var label: str = u.requires.data[i];
        if (!str_empty(u.owner)) {
            val owned: res[str, fail.Fail] = fail.join(oa, u.owner, ".", label);
            if (sel owned.err) { ret res[opt[str], fail.Fail].err{owned.err}; }
            label = owned.ok;
        }
        if (label_failed(failed, label)) { ret res[opt[str], fail.Fail].ok{opt[str].some{label}}; }
        i = i + 1;
    }
    i = 0;
    for (i < u.dep_requires.len) {
        if (label_failed(failed, u.dep_requires.data[i])) { ret res[opt[str], fail.Fail].ok{opt[str].some{u.dep_requires.data[i]}}; }
        i = i + 1;
    }
    ret res[opt[str], fail.Fail].ok{opt[str].none{}};
}

fun record_blocked_unit(bo: *outcome.BuildOutcome, sink: *readout.Sink, oa: *A.Allocator, failed: *Vector[str],
    u: *build_plan.BuildUnit, blocked_by: str) err[fail.Fail] {
    var f: fail.Fail = fail.user_of(diagnostic_kind.ARTIFACT_BLOCKED, fail.join(oa,
        "artifact '", u.label, "' was not built: it requires artifact '", blocked_by,
        "', which failed to build"));
    readout.failure(sink, ?f, diagnostic.ORIGIN_BUILD);
    outcome.fold_fail(bo, ?f);
    val pr: res[usize, A.Error] = collections_vector.push[str](failed, u.label);
    if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
    ret err[fail.Fail].ok{};
}

# run every planned cell cold: each unit gets its own session and arena over `backing`
# and is torn down when it finishes, so nothing of one unit's frontend survives into the
# next. a unit whose requirement failed is recorded as blocked and skipped; a unit that
# fails is recorded and the remaining units still run. ok is the outcome of the whole
# plan, its severity the worst unit's; err is a failure of the engine itself, never of a
# unit
# ---
# bp:      the plan, its closure located; read only, and trusted as planned
# backing: the allocator each unit's arena grows from; released per unit
# oa:      owns the returned outcome and every path and text in it
# sink:    where every unit, failure, diagnostic and phase row is sent as it happens; nil for none
# ret:     the outcome, released with outcome.outcome_dnit, or an engine failure whose text
#          `oa` owns
pub fun execute(bp: *build_plan.BuildPlan, backing: *A.Allocator, oa: *A.Allocator,
    sink: *readout.Sink) res[outcome.BuildOutcome, fail.Fail] {
    var bo:     outcome.BuildOutcome = outcome.outcome_init(oa);
    var failed: Vector[str]          = collections_vector.init[str](oa);
    var handed: bool                 = false;
    fin {
        if (!handed) { outcome.outcome_dnit(?bo); }
    }

    var i: usize = 0;
    for (i < bp.units.len) {
        val unit: *build_plan.BuildUnit = ?bp.units.data[i];
        readout.unit(sink, unit.label, unit.sel_target, unit.profile, request.goal_verb(unit.goal));

        val blocked_by: res[opt[str], fail.Fail] = blocking_requirement(oa, ?failed, unit);
        if (sel blocked_by.err) { ret res[outcome.BuildOutcome, fail.Fail].err{blocked_by.err}; }
        if (sel blocked_by.ok.some) {
            val br: err[fail.Fail] = record_blocked_unit(?bo, sink, oa, ?failed, unit, blocked_by.ok.some);
            if (sel br.err) { ret res[outcome.BuildOutcome, fail.Fail].err{br.err}; }
            i = i + 1;
            cnt;
        }

        val ur: res[outcome.BuildOutcome, fail.Fail] = execute_unit_cold(bp, i, backing, oa, sink);
        if (sel ur.err) {
            var f: fail.Fail = ur.err;
            readout.failure(sink, ?f, diagnostic.ORIGIN_BUILD);
            outcome.fold_fail(?bo, ?f);
            val pr: res[usize, A.Error] = collections_vector.push[str](?failed, unit.label);
            if (sel pr.err) { ret res[outcome.BuildOutcome, fail.Fail].err{fail.refused(pr.err)}; }
        }
        if (sel ur.ok) {
            var ubo:       outcome.BuildOutcome = ur.ok;
            var ubo_moved: bool                 = false;
            fin {
                if (!ubo_moved) { outcome.outcome_dnit(?ubo); }
            }
            if (ubo.severity != outcome.BUILD_OK) {
                val fr: res[usize, A.Error] = collections_vector.push[str](?failed, unit.label);
                if (sel fr.err) { ret res[outcome.BuildOutcome, fail.Fail].err{fail.refused(fr.err)}; }
            }
            val mr: err[A.Error] = outcome.merge(?bo, ?ubo);
            if (sel mr.err) { ret res[outcome.BuildOutcome, fail.Fail].err{fail.message("failed to merge build outcome")}; }
            ubo_moved = true;
        }
        i = i + 1;
    }
    handed = true;
    ret res[outcome.BuildOutcome, fail.Fail].ok{bo};
}

fun execute_unit_cold(bp: *build_plan.BuildPlan, unit_index: usize, backing: *A.Allocator,
    oa: *A.Allocator, sink: *readout.Sink) res[outcome.BuildOutcome, fail.Fail] {
    var u_ar:   arena.Arena;
    val init_r: err[A.Error] = arena.init(?u_ar, backing, 0);
    if (sel init_r.err) {
        ret cold_fail(oa, sink, fail.message("failed to initialise allocator"));
    }
    fin { arena.dnit(?u_ar); }
    var u_alloc: A.Allocator;
    val make_r:  err[A.Error] = arena.make(?u_alloc, ?u_ar);
    if (sel make_r.err) { ret cold_fail(oa, sink, fail.message("failed to initialise allocator")); }

    var r: res[outcome.BuildOutcome, fail.Fail];
    # the unit's session reads the plan's names, so its manifest and cells read as planned
    val res_session: res[session.Session, fail.Fail] = toolchain.session_init_over(?u_alloc, bp.names);
    if (sel res_session.err) {
        r = cold_fail(oa, sink, fail.prefixed(?u_alloc, "failed to initialise compiler session: ", res_session.err));
    }
    if (sel res_session.ok) {
        # the session ends with the unit, so its links' record does too
        var s:         session.Session          = res_session.ok;
        var published: publication.Publications = publication.init(?u_alloc);
        s.backing = backing;
        r         = execute_warm(bp, unit_index, ?s, ?published, oa, sink);
        publication.dnit(?published);
        session.dnit(?s);
    }

    ret r;
}

fun cold_fail(oa: *A.Allocator, sink: *readout.Sink, f: fail.Fail) res[outcome.BuildOutcome, fail.Fail] {
    var bo: outcome.BuildOutcome = outcome.outcome_init(oa);
    ret warm_fail(?bo, sink, f);
}

# a warm build of a scaffolded project: a session over the toolchain catalog,
# the project root, its manifest and its plan; it must not move once made
#[testing]
rec WarmProject {
    alloc:     A.Allocator;
    s:         session.Session;
    published: publication.Publications;
    root:      str;
    m:         manifest.Manifest;
    plan:      build_plan.BuildPlan;
}

# the allocator and the session, released with warm_project_dnit once made
#[testing]
fun warm_project_init(w: *WarmProject) err[fail.Fail] {
    val made: err[A.Error] = page.make(?w.alloc);
    if (sel made.err) { ret err[fail.Fail].err{fail.refused(made.err)}; }
    val s: res[session.Session, fail.Fail] = toolchain.session_init(?w.alloc);
    if (sel s.err) { ret err[fail.Fail].err{s.err}; }
    w.s         = s.ok;
    w.published = publication.init(?w.alloc);
    w.root      = nil;
    ret err[fail.Fail].ok{};
}

# the project of the manifest `text` and the `n` sources under src, whose root
# warm_project_dnit removes
#[testing]
fun warm_project_scaffold(w: *WarmProject, text: str, names: *str, texts: *str, n: u32) err[fail.Fail] {
    val root: res[str, fail.Fail] = driver.scaffold(?w.alloc, text, names, texts, n);
    if (sel root.err) { ret err[fail.Fail].err{root.err}; }
    w.root = root.ok;
    ret err[fail.Fail].ok{};
}

# the manifest loaded from the project root, and `rq` planned over it there
#[testing]
fun warm_project_plan(w: *WarmProject, rq: request.BuildRequest) err[fail.Fail] {
    val loaded: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?w.s, w.root);
    if (sel loaded.err) { ret err[fail.Fail].err{loaded.err}; }
    w.m = loaded.ok;
    var at: request.BuildRequest = rq;
    at.project_root = w.root;
    val planned: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_to_run(?w.alloc, ?w.s, toolchain.t_registry(), ?w.m, at);
    if (sel planned.err) { ret err[fail.Fail].err{planned.err}; }
    w.plan = planned.ok;
    ret err[fail.Fail].ok{};
}

#[testing]
fun warm_project_dnit(w: *WarmProject) {
    if (w.root != nil) { fs.remove_all(?w.alloc, w.root); }
    publication.dnit(?w.published);
    session.dnit(?w.s);
}

# the sent failure was live (unpoisoned) when it arrived, and names the cause
#[testing]
fun t_failure_text_contains(rd: *readout.Recording, needle: str) bool {
    if (rd.failures.len != 1) { ret false; }
    val text: str = rd.failures.data[0];
    if (text == nil || (text::*u8)[0] == T.POISON_FREE) { ret false; }
    ret str_contains(text, needle);
}

test execute_unit_cold__session_init_failure_is_sent_before_arena_teardown {
    # the unit's backing poisons and unmaps what the arena releases, so a failure
    # still pointing into the arena reads poison or faults
    var t:      T.Testing;
    val make_r: err[A.Error] = T.make(?t);
    if (sel make_r.err) { ret 1; }
    fin { T.dnit(?t); }
    T.fail_at_ordinal(?t, 1);

    var oa:      A.Allocator;
    val make_r2: err[A.Error] = page.make(?oa);
    if (sel make_r2.err) { ret 2; }

    var rd: readout.Recording;
    readout.recording_init(?rd, ?oa, readout.LEVEL_RESULTS);
    var names: intern.Interner = intern.init(?oa);
    fin { intern.dnit(?names); }
    var bp: build_plan.BuildPlan;
    bp.names = ?names;
    val r: res[outcome.BuildOutcome, fail.Fail] = execute_unit_cold(?bp, 0::usize, T.allocator_of(?t), ?oa, ?rd.sink);
    if (sel r.err) { ret 3; }

    var bo:  outcome.BuildOutcome = r.ok;
    var bad: i32                  = 0;
    if (bo.severity != outcome.BUILD_INTERNAL)                                  { bad = 1; }
    or (!t_failure_text_contains(?rd, "failed to initialise compiler session")) { bad = 1; }
    if (!T.clean(?t))                                                           { bad = 1; }
    outcome.outcome_dnit(?bo);
    readout.recording_dnit(?rd);
    ret bad;
}

# run one planned cell through a caller-owned session, reusing its query cache, source
# overlays and typed surface across calls (the editor's build path). the session's
# diagnostic store is replaced for the call and its build allocator is a per-call arena
# restored on return, so every raw product a caller borrowed from the session before the
# call is expired by it
# ---
# bp:         the plan, its closure located; read only, and trusted as planned: neither the manifest
#             nor the closure is read again, and a manifest the session reloaded since is refused
# unit_index: the cell to run; out of range is an internal failure
# s:          the warm session; its sources and queries carry over between calls
# oa:         owns the returned outcome
# sink:       where the unit's failures, diagnostics and phase rows are sent as they happen; nil for none
# ret:        the outcome of that one unit, released with outcome.outcome_dnit, or an engine failure
pub fun execute_warm(bp: *build_plan.BuildPlan, unit_index: usize, s: *session.Session,
    published: *publication.Publications, oa: *A.Allocator, sink: *readout.Sink) res[outcome.BuildOutcome, fail.Fail] {
    if (unit_index >= bp.units.len) {
        ret res[outcome.BuildOutcome, fail.Fail].err{fail.message("build unit index out of range")};
    }
    val planned: *build_plan.BuildUnit = ?bp.units.data[unit_index];

    var bo:       outcome.BuildOutcome = outcome.outcome_init(oa);
    var progress: readout.Progress;
    val pr:       *readout.Progress    = readout.start(?progress, sink);

    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(s.alloc);

    var call_ar: arena.Arena;
    val init_r:  err[A.Error] = arena.init(?call_ar, s.backing, 0);
    if (sel init_r.err) {
        ret warm_fail(?bo, sink, fail.message("failed to initialise allocator"));
    }
    fin { arena.dnit(?call_ar); }
    var call_alloc: A.Allocator;
    val make_r2:    err[A.Error] = arena.make(?call_alloc, ?call_ar);
    if (sel make_r2.err) { ret warm_fail(?bo, sink, fail.message("failed to initialise allocator")); }

    val prior_build: *A.Allocator = s.build_alloc;
    s.build_alloc = ?call_alloc;
    fin { s.build_alloc = prior_build; }

    val held: err[fail.Fail] = plan_held(bp, s);
    if (sel held.err) { ret warm_fail(?bo, sink, held.err); }

    var req: request.BuildRequest =
        request.for_cell(?bp.request, planned.owner, planned.sel_target, planned.sel_artifact,
        planned.subsystem, planned.goal);

    val begin_r: res[project.Project, fail.Fail] = driver.begin_build(s, bp.manifest, ?bp.closure, ?req, pr);
    if (sel begin_r.err) {
        readout.diagnostics(sink, ?s.sources, ?s.diags);
        ret warm_fail(?bo, sink, begin_r.err);
    }
    var p: project.Project = begin_r.ok;
    fin { project.dnit_project(?p); }

    val unit: *build_plan.BuildUnit = planned;
    # the cell's objects live in its obj directory, which is the object cache
    p.object_dir = unit.obj_dir;
    p.cache_dir  = unit.cache_dir;
    p.out_dir    = unit.out_dir;

    var st: UnitState;
    st.inputs        = nil;
    st.obj_len       = 0;
    st.dynlibs       = nil;
    st.dynlib_len    = 0;
    st.out_path      = nil;
    st.scope.have    = false;
    st.scope.pick    = nil;
    st.scope.sel_len = 0;
    st.published     = published;

    var result:        err[fail.Fail]    = err[fail.Fail].ok{};
    var failed_origin: diagnostic.Origin = diagnostic.ORIGIN_BUILD;
    var pi:            usize             = 0;
    for (pi < unit.phases.len) {
        result = run_phase(unit.phases.data[pi], ?p, unit, ?st, ?bo, oa);
        if (sel result.err) {
            failed_origin = build_plan.phase_origin(unit.phases.data[pi]);
            brk;
        }
        pi = pi + 1;
    }

    val result_ok3: bool = sel result.ok && req.goal == request.GOAL_TEST_LIST;
    if (result_ok3) {
        result = list_tests(?p, unit, ?st, ?bo, oa);
    }

    val result_ok4: bool = sel result.ok;
    if (result_ok4) {
        result = record_artifact(?p, unit, ?st, ?bo);
    }

    if (st.out_path != nil) { st.out_path = unit.out_path::*u8; }
    release_outputs(?p, ?st);
    val refreshed: err[fail.Fail] = driver.refresh_diagnostics(?p);
    if (sel result.err) {
        var f: fail.Fail = result.err;
        readout.failure(sink, ?f, failed_origin);
    }
    if (sel refreshed.err) {
        var failure: fail.Fail = refreshed.err;
        readout.failure(sink, ?failure, diagnostic.ORIGIN_BUILD);
        outcome.fold_fail(?bo, ?failure);
        val result_ok: bool = sel result.ok;
        if (result_ok) { result = refreshed; }
    }
    if (sel result.ok && pr != nil && req.goal != request.GOAL_CHECK) {
        emit_unit_summary(?p, ?st);
    }

    readout.diagnostics(sink, ?s.sources, ?s.diags);
    build_testing.free_scope(?p, ?st.scope);
    pcg_sweep_staged(?p);

    if (sel result.err) {
        var f: fail.Fail = result.err;
        outcome.fold_fail(?bo, ?f);
    }
    ret res[outcome.BuildOutcome, fail.Fail].ok{bo};
}

# a session runs a plan it reads as planned: the plan located its closure, and
# the session holds the plan's names, as the session it was planned in or one
# layered over that session's names. the session it was planned in also holds
# the manifest's text, which must still be the text the plan was made from
fun plan_held(bp: *build_plan.BuildPlan, s: *session.Session) err[fail.Fail] {
    if (!bp.located) { ret err[fail.Fail].err{fail.message("internal: a plan runs only once its dependency closure is located")}; }
    if (?s.interner != bp.names) {
        if (!intern.descends(?s.interner, bp.names)) { ret err[fail.Fail].err{fail.message("internal: the session does not hold the plan's names")}; }
        ret err[fail.Fail].ok{};
    }
    val m: *manifest.Manifest = bp.manifest;
    if (lang_source.file_is_nil(m.source)) { ret err[fail.Fail].ok{}; }
    val now: query.Revision = query.peek_revision(?s.queries, ?session.FILE_TEXT, lang_source.file_index(m.source)::u64);
    if (now != m.source_revision) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.MANIFEST_CHANGED, "the manifest changed after this build was planned; re-run the build")};
    }
    ret err[fail.Fail].ok{};
}

fun pcg_sweep_staged(p: *project.Project) {
    project.release_all_staged(p);
}

fun warm_fail(bo: *outcome.BuildOutcome, sink: *readout.Sink, f: fail.Fail) res[outcome.BuildOutcome, fail.Fail] {
    var fv: fail.Fail = f;
    readout.failure(sink, ?fv, diagnostic.ORIGIN_BUILD);
    outcome.fold_fail(bo, ?fv);
    ret res[outcome.BuildOutcome, fail.Fail].ok{@bo};
}

fun plan_module_outputs(p: *project.Project, base: str, suffix: str) res[*str, fail.Fail] {
    if (p.emit_len == 0) { ret res[*str, fail.Fail].ok{nil}; }
    val allocated: res[*str, A.Error] = A.zallocate[str](p.alloc, p.emit_len::usize);
    if (sel allocated.err) {
        ret res[*str, fail.Fail].err{fail.refused(allocated.err)};
    }
    val destinations: *str = allocated.ok;
    var complete:     bool = false;
    fin {
        if (!complete) { release_names(p, destinations); }
    }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m:   *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        val fqn: opt[str]             = intern.get(?p.s.interner, m.fqn);
        if (sel fqn.none) {
            ret res[*str, fail.Fail].err{fail.message("module FQN not interned")};
        }
        val name_r: res[str, fail.Fail] = output.mirror_fqn(p.alloc, base, fqn.some, suffix);
        if (sel name_r.err) {
            ret res[*str, fail.Fail].err{name_r.err};
        }
        val name:     str            = name_r.ok;
        val reserved: err[fail.Fail] = reserve_output(p, name);
        if (sel reserved.err) {
            str_free(p.alloc, name);
            ret res[*str, fail.Fail].err{reserved.err};
        }
        destinations[i] = name;
        i               = i + 1;
    }
    complete = true;
    ret res[*str, fail.Fail].ok{destinations};
}

# an output's parent directory exists before its phase runs; the file itself
# is written in place, a build product regenerable by the next build
fun reserve_output(p: *project.Project, name: str) err[fail.Fail] {
    ret output.reserve(p.alloc, p.out_dir, name);
}

fun plan_outputs(p: *project.Project, unit: *build_plan.BuildUnit, st: *UnitState) err[fail.Fail] {
    val goal:    request.BuildGoal = p.req.goal;
    val flat:    bool              = p.target.of != nil && p.target.of.produces_image;
    val objects: bool              = (goal == request.GOAL_ARTIFACT && !flat)
        || goal == request.GOAL_OBJECTS || goal == request.GOAL_TESTS;
    if (objects) {
        val planned: res[*str, fail.Fail] = plan_module_outputs(p, unit.obj_dir, target_of.object_ext(p.target.of));
        if (sel planned.err) { ret err[fail.Fail].err{planned.err}; }
        st.objects = planned.ok;
    }
    if (p.req.emit_ir) {
        val planned: res[*str, fail.Fail] = plan_module_outputs(p, unit.ir_dir, "ir");
        if (sel planned.err) { ret err[fail.Fail].err{planned.err}; }
        st.ir_outputs = planned.ok;
    }
    if (p.req.emit_asm) {
        val planned: res[*str, fail.Fail] = plan_module_outputs(p, unit.asm_dir, "s");
        if (sel planned.err) { ret err[fail.Fail].err{planned.err}; }
        st.asm_outputs = planned.ok;
    }
    if (goal == request.GOAL_ARTIFACT || goal == request.GOAL_TESTS) {
        val reserved: err[fail.Fail] = reserve_output(p, unit.out_path);
        if (sel reserved.err) { ret reserved; }
        st.artifact = unit.out_path;
    }
    if (goal == request.GOAL_TESTS) {
        val file_r: res[str, fail.Fail] = fail.join(p.alloc, "dispatch.", target_of.object_ext(p.target.of));
        if (sel file_r.err) { ret err[fail.Fail].err{file_r.err}; }
        val name_r: res[str, A.Error] = types_path.join(p.alloc, unit.test_dir, file_r.ok);
        str_free(p.alloc, file_r.ok);
        if (sel name_r.err) { ret err[fail.Fail].err{fail.refused(name_r.err)}; }
        val name:     str            = name_r.ok;
        val reserved: err[fail.Fail] = reserve_output(p, name);
        if (sel reserved.err) {
            str_free(p.alloc, name);
            ret reserved;
        }
        st.dispatcher = name;
        val planned: res[*str, fail.Fail] = plan_test_outputs(p);
        if (sel planned.err) { ret err[fail.Fail].err{planned.err}; }
        st.test_objects = planned.ok;
    }
    ret err[fail.Fail].ok{};
}

# `obj/<project>/<module>.test.<object suffix>` for each emitted module with a test object
fun plan_test_outputs(p: *project.Project) res[*str, fail.Fail] {
    if (p.emit_len == 0) { ret res[*str, fail.Fail].ok{nil}; }
    val allocated: res[*str, A.Error] = A.zallocate[str](p.alloc, p.emit_len::usize);
    if (sel allocated.err) { ret res[*str, fail.Fail].err{fail.refused(allocated.err)}; }
    val destinations: *str = allocated.ok;
    var complete:     bool = false;
    fin {
        if (!complete) { release_names(p, destinations); }
    }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (passes.has_test_object(p, m)) {
            val named: res[str, fail.Fail] = cache.test_object_path(p, m, p.alloc);
            if (sel named.err) { ret res[*str, fail.Fail].err{named.err}; }
            destinations[i] = named.ok;
            val reserved: err[fail.Fail] = reserve_output(p, named.ok);
            if (sel reserved.err) { ret res[*str, fail.Fail].err{reserved.err}; }
        }
        i = i + 1;
    }
    complete = true;
    ret res[*str, fail.Fail].ok{destinations};
}

# release the destination names `names`; a nil list owns nothing
fun release_names(p: *project.Project, names: *str) {
    if (names == nil) { ret; }
    var i: usize = 0;
    for (i < p.emit_len::usize) {
        if (names[i] != nil) { str_free(p.alloc, names[i]); }
        i = i + 1;
    }
    A.deallocate[str](p.alloc, names, p.emit_len::usize);
}

fun release_outputs(p: *project.Project, st: *UnitState) {
    release_names(p, st.objects);
    release_names(p, st.test_objects);
    release_names(p, st.ir_outputs);
    release_names(p, st.asm_outputs);
    st.objects      = nil;
    st.test_objects = nil;
    st.ir_outputs   = nil;
    st.asm_outputs  = nil;
    if (st.dispatcher != nil) {
        str_free(p.alloc, st.dispatcher);
        st.dispatcher = nil;
    }
    st.artifact = nil;
}

fun run_phase(ph: build_plan.PhaseKind, p: *project.Project, unit: *build_plan.BuildUnit, st: *UnitState,
    bo: *outcome.BuildOutcome, oa: *A.Allocator) err[fail.Fail] {
    val phase_name_r: opt[str] = build_plan.phase_name(ph);
    if (sel phase_name_r.none) {
        ret err[fail.Fail].err{build_plan.unknown_phase(oa, ph)};
    }
    var result: err[fail.Fail] = err[fail.Fail].err{fail.message("unknown build phase")};
    if (ph == build_plan.PH_STEPS) { result = driver.phase_finish(p, step.run(p.alloc, p)); }
    if (ph == build_plan.PH_DEP_STEPS) {
        val te: *project.TargetEntry = p.target_entry;
        result = driver.phase_finish(p, step.dependency_run(p, te.isa_name, te.os_name, te.abi_name));
    }
    if (ph == build_plan.PH_LOAD)  { result = load_phase(p); }
    if (ph == build_plan.PH_SEMA)  { result = driver.run_sema_pass(p); }
    if (ph == build_plan.PH_LOWER) { result = lower_phase(p, st, bo); }
    if (ph == build_plan.PH_CODEGEN) {
        result = plan_outputs(p, unit, st);
        val result_ok: bool = sel result.ok;
        if (result_ok) { result = codegen_phase(p, st); }
    }
    if (ph == build_plan.PH_TEST) { result = test_phase(p, st); }
    if (ph == build_plan.PH_EMIT) { result = emit_phase(p, unit, st, bo); }
    if (ph == build_plan.PH_LINK) { result = link_phase(p, unit, st, bo, oa); }

    if (sel result.err) { ret result; }
    if (ph == build_plan.PH_LOAD || ph == build_plan.PH_SEMA) {
        val status: fail.PhaseStatus = driver.frontend_status(p);
        if (!sel status.kind.accepted) { ret err[fail.Fail].err{fail.phase_failure(status)}; }
    }
    ret result;
}

test run_phase__unknown_catalog_member_is_internal_before_execution {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val link: opt[str] = build_plan.phase_name(build_plan.PH_LINK);
    if (sel link.none)                  { ret 2; }
    if (!str_equals(link.some, "link")) { ret 2; }
    val phase_name_r: opt[str] = build_plan.phase_name(255::build_plan.PhaseKind);
    if (sel phase_name_r.some) { ret 3; }
    val result: err[fail.Fail] = run_phase(255::build_plan.PhaseKind, nil, nil, nil, nil, ?a);
    if (sel result.ok) { ret 4; }
    val failure: fail.Fail = result.err;
    fin { fail.dnit(?a, failure); }
    if (!sel failure.message)                               { ret 5; }
    if (!str_contains(fail.describe(failure), "PhaseKind")) { ret 5; }
    if (!str_contains(fail.describe(failure), "255"))       { ret 5; }
    ret 0;
}

fun load_phase(p: *project.Project) err[fail.Fail] {
    val lr: err[fail.Fail] = driver.run_load_phase(p);
    if (sel lr.err) { ret lr; }
    if (project.module_count(p) == 0) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.PROJECT_EMPTY, "project graph is empty; the entrypoint loaded no modules")};
    }
    ret err[fail.Fail].ok{};
}

# tests are gathered in module order from the lowered test ir, or from the facts
# a restored test object carries, so a cached test build lists the same tests in
# the same order as a clean one
fun collect_test_scope(p: *project.Project, st: *UnitState) err[fail.Fail] {
    var col: testrunner.Collected = testrunner.collected_init();
    var i:   u32                  = 0;
    for (i < project.module_count(p)) {
        val gathered: err[fail.Fail] = cache.collect_tests(p, project.module_at(p, i), i, ?col);
        if (sel gathered.err) {
            testrunner.free(p.s, ?col);
            ret err[fail.Fail].err{gathered.err};
        }
        i = i + 1;
    }
    ret build_testing.collect_scope(p, col, ?st.scope);
}

# the ir and asm emitters read each module's unit before codegen compiles it in place
fun emit_unit_texts(p: *project.Project, st: *UnitState) err[fail.Fail] {
    if (!p.req.emit_ir && !p.req.emit_asm) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.unit == nil) { ret err[fail.Fail].err{fail.message("ir and asm emission require a current lowered module")}; }
        if (p.req.emit_ir) {
            val res_ir: err[fail.Fail] = build_emit.emit_ir(p, st.ir_outputs[i], m.unit);
            if (sel res_ir.err) { ret res_ir; }
        }
        if (p.req.emit_asm) {
            val res_asm: err[fail.Fail] = build_emit.emit_asm(p, st.asm_outputs[i], m.unit);
            if (sel res_asm.err) { ret res_asm; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the lower and optimize rows count the modules that lowered: a module whose
# object the load restored does not
fun lower_phase(p: *project.Project, st: *UnitState, bo: *outcome.BuildOutcome) err[fail.Fail] {
    readout.phase_begin(p.progress, readout.LOWER);
    readout.phase_begin(p.progress, readout.OPTIMIZE);
    readout.phase_carved(p.progress, readout.OPTIMIZE);

    val res_lower: err[fail.Fail] = driver.run_lower_pass(p);
    if (sel res_lower.err) { ret res_lower; }
    val texts: err[fail.Fail] = emit_unit_texts(p, st);
    if (sel texts.err) { ret texts; }

    val lowered: u32 = cache.lowered_count(p);
    readout.phase_end(p.progress, readout.LOWER, lowered, "module", "modules");
    readout.phase_end(p.progress, readout.OPTIMIZE, lowered, "module", "modules");
    ret err[fail.Fail].ok{};
}

# a test build's test objects: each lowered against its module's normal object and
# generated, or restored from `obj/`, read out as a test lower row and a test
# codegen row. the tests they hold are collected here
fun test_phase(p: *project.Project, st: *UnitState) err[fail.Fail] {
    readout.phase_begin(p.progress, readout.TEST_LOWER);
    project.set_origin(p, diagnostic.ORIGIN_CODEGEN);

    var roots: Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    val rooted: err[fail.Fail] = driver.append_test_roots(p, ?roots);
    if (sel rooted.err) { ret rooted; }
    var objects: u32 = 0;
    var i:       u32 = 0;
    for (i < p.emit_len) {
        if (passes.has_test_object(p, project.module_at(p, p.topo[i]::u32))) { objects = objects + 1; }
        i = i + 1;
    }
    val started: res[query.Operation, fail.Fail] = driver.begin_query_phase(p);
    if (sel started.err) { ret err[fail.Fail].err{started.err}; }
    val operation:  query.Operation = started.ok;
    var result:     err[fail.Fail]  = passes.acquire_test_inputs(p);
    val lowered_ok: bool            = sel result.ok;
    if (lowered_ok) {
        readout.phase_end(p.progress, readout.TEST_LOWER, objects, "object", "objects");
        readout.phase_begin(p.progress, readout.TEST_CODEGEN);
    }
    val parallel_ok: bool = sel result.ok && pcg_enabled(p);
    if (parallel_ok) {
        val parallel: err[fail.Fail] = run_codegen_parallel(p, true);
        if (sel parallel.err) { result = err[fail.Fail].err{parallel.err}; }
    }
    val result_ok: bool = sel result.ok;
    if (result_ok) { result = passes.run_test_object_pass(p); }
    val finished: err[fail.Fail] = driver.finish_query_phase(p, operation, roots.data, roots.len, result);
    if (sel finished.err) { ret finished; }

    val collected: err[fail.Fail] = collect_test_scope(p, st);
    if (sel collected.err) { ret collected; }
    readout.phase_end(p.progress, readout.TEST_CODEGEN, objects, "object", "objects");
    ret err[fail.Fail].ok{};
}

fun codegen_phase(p: *project.Project, st: *UnitState) err[fail.Fail] {
    readout.phase_begin(p.progress, readout.CODEGEN);
    project.set_origin(p, diagnostic.ORIGIN_CODEGEN);
    var roots: Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    val frontend: err[fail.Fail] = driver.append_frontend_roots(p, ?roots);
    if (sel frontend.err) { ret frontend; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m:       *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        val key:     u64                  = passes.back_half_key_for(p, m);
        val lowered: res[usize, A.Error]  = collections_vector.push[query.QueryKey](?roots,
            query.QueryKey{kind: ?passes.LOWER, key: key});
        if (sel lowered.err) {
            ret err[fail.Fail].err{fail.refused(lowered.err)};
        }
        val emitted: res[usize, A.Error] = collections_vector.push[query.QueryKey](?roots,
            query.QueryKey{kind: ?passes.CODEGEN, key: key});
        if (sel emitted.err) {
            ret err[fail.Fail].err{fail.refused(emitted.err)};
        }
        i = i + 1;
    }
    val started: res[query.Operation, fail.Fail] = driver.begin_query_phase(p);
    if (sel started.err) {
        ret err[fail.Fail].err{started.err};
    }
    val operation:  query.Operation = started.ok;
    var result:     err[fail.Fail]  = passes.acquire_codegen_inputs(p);
    val result_ok3: bool            = sel result.ok && pcg_enabled(p);
    if (result_ok3) {
        val parallel: err[fail.Fail] = run_codegen_parallel(p, false);
        if (sel parallel.err) {
            result = err[fail.Fail].err{parallel.err};
        }
    }
    val result_ok2: bool = sel result.ok;
    if (result_ok2) { result = passes.run_codegen_pass(p); }
    val result2: err[fail.Fail] = driver.finish_query_phase(p, operation, roots.data, roots.len, result);
    if (sel result2.err) { ret result2; }

    readout.phase_end(p.progress, readout.CODEGEN, cache.generated_count(p), "module", "modules");
    ret err[fail.Fail].ok{};
}

fun emit_phase(p: *project.Project, unit: *build_plan.BuildUnit, st: *UnitState,
    bo: *outcome.BuildOutcome) err[fail.Fail] {
    val goal: request.BuildGoal = p.req.goal;
    val flat: bool              = p.target.of != nil && p.target.of.produces_image;

    readout.phase_begin(p.progress, readout.EMIT);

    if (goal == request.GOAL_TESTS) {
        if (st.scope.sel_len == 0) {
            readout.phase_end(p.progress, readout.EMIT, 0, "object", "objects");
            ret err[fail.Fail].ok{};
        }
    }

    val objects: bool = (goal == request.GOAL_ARTIFACT && !flat)
        || goal == request.GOAL_OBJECTS
        || goal == request.GOAL_TESTS;
    if (objects) {
        val oc: err[fail.Fail] = build_emit.write_objects(p, st.objects, ?st.inputs);
        if (sel oc.err) { ret oc; }
        st.obj_len = p.emit_len;
    }
    if (goal == request.GOAL_TESTS) {
        val tc: err[fail.Fail] = build_emit.write_test_objects(p, st.test_objects);
        if (sel tc.err) { ret tc; }
    }

    if (goal == request.GOAL_OBJECTS) {
        st.out_path = unit.out_path::*u8;
    }

    if (objects) { readout.phase_end(p.progress, readout.EMIT, st.obj_len, "object", "objects"); }
    or           { readout.phase_end(p.progress, readout.EMIT, p.emit_len, "module", "modules"); }
    ret err[fail.Fail].ok{};
}

fun artifact_digest(path: *u8, out: *u8) err[fail.Fail] {
    val rr: err[fail.Fail] = lang_fingerprint.file_sha256(path::str, out);
    if (sel rr.err) {
        ret err[fail.Fail].err{rr.err};
    }
    ret err[fail.Fail].ok{};
}

# whether the artifact on disk is the one this revision's link published; one
# relinked, missing, or never published at this revision is not
fun artifact_reusable(p: *project.Project, st: *UnitState, relinked: bool, artifact: *u8, revision: query.Revision) res[bool, fail.Fail] {
    if (relinked) { ret res[bool, fail.Fail].ok{false}; }
    val is_file_r: res[bool, io_error.Error] = fs.is_file(artifact::str);
    if (sel is_file_r.err) {
        if (is_file_r.err.kind == io_error.NOT_FOUND) { ret res[bool, fail.Fail].ok{false}; }
        ret res[bool, fail.Fail].err{fail.environment(diagnostic_kind.FS_STAT, fail.io_text(is_file_r.err))};
    }
    if (!is_file_r.ok) { ret res[bool, fail.Fail].ok{false}; }
    val recorded: res[opt[[32]u8], fail.Fail] = publication.at(st.published, ?p.s.interner, artifact::str, revision);
    if (sel recorded.err) { ret res[bool, fail.Fail].err{recorded.err}; }
    val written: opt[[32]u8] = recorded.ok;
    if (sel written.none) { ret res[bool, fail.Fail].ok{false}; }
    var want: [32]u8         = written.some;
    var cur:  [32]u8;
    val d_r:  err[fail.Fail] = artifact_digest(artifact, ?cur[0]);
    if (sel d_r.err) { ret res[bool, fail.Fail].err{d_r.err}; }
    ret res[bool, fail.Fail].ok{memory.raw_equal((?cur[0])::ptr, (?want[0])::ptr, 32::usize)};
}

fun record_artifact_publication(p: *project.Project, st: *UnitState, artifact: *u8, revision: query.Revision) err[fail.Fail] {
    if (query.peek_revision(?p.s.queries, ?passes.LINK, 0) != revision) {
        ret err[fail.Fail].err{fail.message("the link query's revision moved while the artifact was being written")};
    }
    var d:   [32]u8;
    val d_r: err[fail.Fail] = artifact_digest(artifact, ?d[0]);
    if (sel d_r.err) { ret d_r; }
    ret publication.record(st.published, ?p.s.interner, artifact::str, revision, ?d);
}

fun link_phase(p: *project.Project, unit: *build_plan.BuildUnit, st: *UnitState,
    bo: *outcome.BuildOutcome, oa: *A.Allocator) err[fail.Fail] {
    val goal: request.BuildGoal = p.req.goal;
    project.set_origin(p, diagnostic.ORIGIN_LINK);

    readout.phase_begin(p.progress, readout.LINK);
    val t_link: readout.Instant = readout.item_begin(p.progress);

    if (goal == request.GOAL_TESTS) {
        if (st.scope.sel_len == 0) {
            readout.phase_end(p.progress, readout.LINK, 0, "binary", "binaries");
            ret err[fail.Fail].ok{};
        }
        val dr: err[fail.Fail] = link_dispatch_phase(p, unit, st, t_link);
        if (sel dr.err) { ret dr; }
        val rr: err[fail.Fail] = build_testing.record_tests(p, ?st.scope, unit.out_path::*u8,
            intern.text(?p.s.interner, unit.target_entry.name), unit.profile, bo, oa);
        if (sel rr.err) { ret rr; }
        st.out_path = unit.out_path::*u8;
        readout.item(p.progress, readout.LINK, unit.out_path, t_link);
        readout.phase_end(p.progress, readout.LINK, 1, "binary", "binaries");
        ret err[fail.Fail].ok{};
    }

    val te: *project.TargetEntry = p.target_entry;
    if (te == nil) { ret err[fail.Fail].err{fail.message("no target selected")}; }

    if (p.target.of != nil && p.target.of.produces_image) { ret link_flat(p, unit, st, t_link); }
    if (build_plan.finished_modules(?p.target)) {
        ret link_finished(p, unit, st, t_link);
    }

    if (te.kind == catalog_artifact.STATIC) {
        val ordered: res[**Object, fail.Fail] = build_emit.indexed_objects(p);
        if (sel ordered.err) { ret err[fail.Fail].err{ordered.err}; }
        fin { build_emit.release_indexed(p, ordered.ok); }
        val arc_r: err[fail.Fail] = build_emit.emit_static_archive(p, st.artifact, ordered.ok, st.inputs, ?st.out_path);
        if (sel arc_r.err) { ret arc_r; }
        readout.phase_end(p.progress, readout.LINK, 1, "archive", "archives");
        ret err[fail.Fail].ok{};
    }
    if (te.kind == catalog_artifact.SHARED) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_NO_LOADER, "a shared library is not yet linked through mink")};
    }
    if (te.kind == catalog_artifact.OBJECTS) {
        st.out_path = unit.obj_dir::*u8;
        readout.phase_end(p.progress, readout.LINK, st.obj_len, "object", "objects");
        ret err[fail.Fail].ok{};
    }
    if (te.kind != catalog_artifact.EXECUTABLE) {
        ret err[fail.Fail].err{fail.unknown_catalog(p.alloc, "artifact kind", te.kind::u32)};
    }

    val ext_r: err[fail.Fail] = build_emit.append_external_inputs(p, unit, ?st.inputs, ?st.obj_len, ?st.dynlibs, ?st.dynlib_len);
    if (sel ext_r.err) { ret ext_r; }

    val artifact: str = unit.out_path;

    val ext_from:  u32                                           = p.emit_len;
    val ext_count: u32                                           = st.obj_len - p.emit_len;
    val loaded_r:  res[build_emit.LoadedImageOptions, fail.Fail] = build_emit.load_image_options(p, catalog_artifact.EXECUTABLE, artifact::*u8);
    if (sel loaded_r.err) {
        ret err[fail.Fail].err{loaded_r.err};
    }
    var loaded: build_emit.LoadedImageOptions = loaded_r.ok;
    fin { build_emit.dnit_image_options(p.alloc, ?loaded); }

    val cfg_r: err[fail.Fail] = set_link_config_input(p, artifact::*u8, build_emit.artifact_product_name(p), catalog_artifact.EXECUTABLE::u32,
        ?st.inputs[ext_from], ext_count, st.dynlibs, st.dynlib_len, ?loaded);
    if (sel cfg_r.err) { ret cfg_r; }
    val relink_r: res[bool, fail.Fail] = driver.run_link_pass(p);
    if (sel relink_r.err) { ret err[fail.Fail].err{relink_r.err}; }
    val link_rev: query.Revision       = query.peek_revision(?p.s.queries, ?passes.LINK, 0);
    val reusable: res[bool, fail.Fail] = artifact_reusable(p, st, relink_r.ok, artifact::*u8, link_rev);
    if (sel reusable.err) { ret err[fail.Fail].err{reusable.err}; }
    if (reusable.ok) {
        st.out_path = artifact::*u8;
        readout.item(p.progress, readout.LINK, artifact, t_link);
        readout.phase_end(p.progress, readout.LINK, 1, "binary", "binaries");
        ret err[fail.Fail].ok{};
    }

    val ordered: res[**Object, fail.Fail] = build_emit.ordered_objects(p);
    if (sel ordered.err) { ret err[fail.Fail].err{ordered.err}; }
    fin { build_emit.release_ordered(p, ordered.ok); }
    val res_link: err[fail.Fail] = build_emit.link_image(p, ?mink_output.STATIC, false, ordered.ok, p.emit_len,
        ?st.inputs[ext_from], ext_count, st.dynlib_len, st.artifact, ?loaded);
    if (sel res_link.err) { ret res_link; }

    val publish_r: err[fail.Fail] = record_artifact_publication(p, st, artifact::*u8, link_rev);
    if (sel publish_r.err) { ret publish_r; }

    st.out_path = artifact::*u8;
    readout.item(p.progress, readout.LINK, artifact, t_link);
    readout.phase_end(p.progress, readout.LINK, 1, "binary", "binaries");
    ret err[fail.Fail].ok{};
}

fun link_dispatch_phase(p: *project.Project, unit: *build_plan.BuildUnit, st: *UnitState,
    t_link: readout.Instant) err[fail.Fail] {
    val artifact: str = unit.out_path;

    val in_r: res[build_testing.DispatchInputs, fail.Fail] = build_testing.collect_dispatch_inputs(p, unit);
    if (sel in_r.err) {
        ret err[fail.Fail].err{in_r.err};
    }
    var di: build_testing.DispatchInputs = in_r.ok;
    fin { build_testing.free_dispatch_inputs(p, ?di); }

    val cfg_r: err[fail.Fail] = set_dispatch_config_input(p, artifact::*u8,
        di.ext, di.ext_len, di.dynlibs, di.dynlib_len, ?st.scope);
    if (sel cfg_r.err) { ret cfg_r; }

    val relink_r: res[bool, fail.Fail] = driver.run_link_pass(p);
    if (sel relink_r.err) { ret err[fail.Fail].err{relink_r.err}; }
    val link_rev: query.Revision       = query.peek_revision(?p.s.queries, ?passes.LINK, 0);
    val reusable: res[bool, fail.Fail] = artifact_reusable(p, st, relink_r.ok, artifact::*u8, link_rev);
    if (sel reusable.err) { ret err[fail.Fail].err{reusable.err}; }
    if (reusable.ok)      { ret err[fail.Fail].ok{}; }

    val gathered: res[ObjectList, fail.Fail] = test_link_objects(p);
    if (sel gathered.err) { ret err[fail.Fail].err{gathered.err}; }
    var objects: ObjectList = gathered.ok;
    fin { A.deallocate[*Object](p.alloc, objects.data, objects.cap::usize); }
    val lr: err[fail.Fail] = build_testing.link_dispatcher(p, ?st.scope, ?di, objects.data, objects.len, st.dispatcher, st.artifact);
    if (sel lr.err) { ret lr; }

    ret record_artifact_publication(p, st, artifact::*u8, link_rev);
}

rec ObjectList {
    # one slot past the objects for the dispatcher's own
    data: **Object;
    len:  u32;
    cap:  u32;
}

# the objects a dispatcher links after its own: every emitted module's test object, then
# every emitted module's normal object, in topological order
fun test_link_objects(p: *project.Project) res[ObjectList, fail.Fail] {
    val cap:       u32                    = p.emit_len * 2 + 1;
    val allocated: res[**Object, A.Error] = A.allocate[*Object](p.alloc, cap::usize);
    if (sel allocated.err) { ret res[ObjectList, fail.Fail].err{fail.refused(allocated.err)}; }
    var list: ObjectList = ObjectList{data: allocated.ok, len: 0, cap: cap};
    var i:    u32        = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.test.object != nil) {
            list.data[list.len] = m.test.object;
            list.len            = list.len + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.object == nil) {
            A.deallocate[*Object](p.alloc, list.data, cap::usize);
            ret res[ObjectList, fail.Fail].err{fail.message("a test link requires every module's current object")};
        }
        list.data[list.len] = m.object;
        list.len            = list.len + 1;
        i                   = i + 1;
    }
    ret res[ObjectList, fail.Fail].ok{list};
}

fun set_dispatch_config_input(p: *project.Project, out_path: *u8,
    ext: *target_of.ObjectInput, ext_count: u32,
    dynlibs: *target_of.DynLib, dynlib_count: u32,
    sc: *build_testing.TestScope) err[fail.Fail] {
    var fb: wire.Sink = wire.grown(p.alloc);
    fin { wire.dnit(?fb); }
    write_link_config(?fb, p, out_path, build_emit.artifact_product_name(p),
        catalog_artifact.EXECUTABLE::u32, ext, ext_count, dynlibs, dynlib_count, nil);
    build_testing.fingerprint_scope(?fb, p, sc);
    ret set_link_config(p, ?fb);
}

fun link_flat(p: *project.Project, unit: *build_plan.BuildUnit, st: *UnitState, t_link: readout.Instant) err[fail.Fail] {
    val artifact: str = unit.out_path;

    val cfg_r: err[fail.Fail] = set_link_config_input(p, artifact::*u8, build_emit.artifact_product_name(p), catalog_artifact.EXECUTABLE::u32, nil, 0, nil, 0, nil);
    if (sel cfg_r.err) { ret cfg_r; }
    val relink_r: res[bool, fail.Fail] = driver.run_link_pass(p);
    if (sel relink_r.err) { ret err[fail.Fail].err{relink_r.err}; }
    val link_rev: query.Revision       = query.peek_revision(?p.s.queries, ?passes.LINK, 0);
    val reusable: res[bool, fail.Fail] = artifact_reusable(p, st, relink_r.ok, artifact::*u8, link_rev);
    if (sel reusable.err) { ret err[fail.Fail].err{reusable.err}; }
    if (reusable.ok) {
        st.out_path = artifact::*u8;
        readout.item(p.progress, readout.LINK, artifact, t_link);
        readout.phase_end(p.progress, readout.LINK, 1, "binary", "binaries");
        ret err[fail.Fail].ok{};
    }

    val ordered: res[**Object, fail.Fail] = build_emit.ordered_objects(p);
    if (sel ordered.err) { ret err[fail.Fail].err{ordered.err}; }
    fin { build_emit.release_ordered(p, ordered.ok); }
    val res_link: err[fail.Fail] = build_emit.link_image(p, ?mink_output.STATIC, true, ordered.ok, p.emit_len,
        nil, 0, 0, st.artifact, nil);
    if (sel res_link.err) { ret res_link; }

    val publish_r: err[fail.Fail] = record_artifact_publication(p, st, artifact::*u8, link_rev);
    if (sel publish_r.err) { ret publish_r; }

    st.out_path = artifact::*u8;
    readout.item(p.progress, readout.LINK, artifact, t_link);
    readout.phase_end(p.progress, readout.LINK, 1, "binary", "binaries");
    ret err[fail.Fail].ok{};
}

# a finished-module format links its modules into one module image, through mink
fun link_finished(p: *project.Project, unit: *build_plan.BuildUnit, st: *UnitState, t_link: readout.Instant) err[fail.Fail] {
    val artifact: str = unit.out_path;

    val cfg_r: err[fail.Fail] = set_link_config_input(p, artifact::*u8, build_emit.artifact_product_name(p), catalog_artifact.EXECUTABLE::u32, nil, 0, nil, 0, nil);
    if (sel cfg_r.err) { ret cfg_r; }
    val relink_r: res[bool, fail.Fail] = driver.run_link_pass(p);
    if (sel relink_r.err) { ret err[fail.Fail].err{relink_r.err}; }
    val link_rev: query.Revision       = query.peek_revision(?p.s.queries, ?passes.LINK, 0);
    val reusable: res[bool, fail.Fail] = artifact_reusable(p, st, relink_r.ok, artifact::*u8, link_rev);
    if (sel reusable.err) { ret err[fail.Fail].err{reusable.err}; }
    if (!reusable.ok) {
        val ordered: res[**Object, fail.Fail] = build_emit.ordered_objects(p);
        if (sel ordered.err) { ret err[fail.Fail].err{ordered.err}; }
        fin { build_emit.release_ordered(p, ordered.ok); }
        val published: err[fail.Fail] = build_emit.link_image(p, ?mink_output.MODULE, false, ordered.ok, p.emit_len,
            nil, 0, 0, st.artifact, nil);
        if (sel published.err) { ret published; }
        val publish_r: err[fail.Fail] = record_artifact_publication(p, st, artifact::*u8, link_rev);
        if (sel publish_r.err) { ret publish_r; }
    }

    st.out_path = artifact::*u8;
    readout.item(p.progress, readout.LINK, artifact, t_link);
    readout.phase_end(p.progress, readout.LINK, 1, "module", "modules");
    ret err[fail.Fail].ok{};
}

fun list_tests(p: *project.Project, unit: *build_plan.BuildUnit, st: *UnitState, bo: *outcome.BuildOutcome, oa: *A.Allocator) err[fail.Fail] {
    ret build_testing.record_tests(p, ?st.scope, nil, intern.text(?p.s.interner, unit.target_entry.name), unit.profile, bo, oa);
}

fun record_artifact(p: *project.Project, unit: *build_plan.BuildUnit, st: *UnitState, bo: *outcome.BuildOutcome) err[fail.Fail] {
    if (st.out_path == nil) { ret err[fail.Fail].ok{}; }

    var kind: catalog_artifact.Kind = catalog_artifact.EXECUTABLE;
    if (p.req.goal == request.GOAL_OBJECTS) { kind = catalog_artifact.OBJECTS; }
    or (p.req.goal == request.GOAL_TESTS)   { kind = catalog_artifact.EXECUTABLE; }
    or (p.target_entry != nil)              { kind = p.target_entry.kind; }

    val rec_r: err[A.Error] = outcome.record_artifact(bo, kind, st.out_path::str);
    if (sel rec_r.err) { ret err[fail.Fail].err{fail.refused(rec_r.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_unit_summary(p: *project.Project, st: *UnitState) {
    var out_str: str = "<output>";
    if (st.out_path != nil) { out_str = st.out_path::str; }

    val te:       *project.TargetEntry = p.target_entry;
    val emit_obj: bool                 = p.req.goal == request.GOAL_OBJECTS;
    val is_lib:   bool                 = emit_obj || (te != nil && catalog_artifact.is_library(te.kind));

    if (!is_lib && st.out_path != nil) {
        val fi_r: res[fs.Metadata, io_error.Error] = fs.metadata(st.out_path::str);
        if (sel fi_r.ok) {
            readout.summary(p.progress, out_str, p.emit_len, fi_r.ok.size, true);
            ret;
        }
    }
    readout.summary(p.progress, out_str, p.emit_len, 0, false);
}

fun pcg_enabled(p: *project.Project) bool {
    ret p.req.jobs >= 1 && p.emit_len > 0;
}

# publish the link configuration of a project as the Q_LINK_CONFIG query input: the
# output path, product name, link kind, external inputs, dynamic libraries with their
# provider policy, and the loaded-image options, fingerprinted so an unchanged
# configuration keeps its revision and any change invalidates the link
# ---
# p:   the project whose session holds the query db
# ret: ok, or the fingerprint or query failure
fun set_link_config_input(p: *project.Project, out_path: *u8, product: *u8, out_kind: u32,
    ext: *target_of.ObjectInput, ext_count: u32,
    dynlibs: *target_of.DynLib, dynlib_count: u32,
    image: *build_emit.LoadedImageOptions) err[fail.Fail] {
    var fb: wire.Sink = wire.grown(p.alloc);
    fin { wire.dnit(?fb); }
    write_link_config(?fb, p, out_path, product, out_kind, ext, ext_count, dynlibs, dynlib_count, image);
    ret set_link_config(p, ?fb);
}

# the link configuration a sink holds, as the link's query input
fun set_link_config(p: *project.Project, fb: *wire.Sink) err[fail.Fail] {
    val taken: res[query.QueryOutput, fail.Fail] = codec.output(fb);
    if (sel taken.err) { ret err[fail.Fail].err{taken.err}; }
    val si: err[fail.Fail] = query.set_input(?p.s.queries, ?passes.LINK_CONFIG, 0, taken.ok.bytes, taken.ok.len);
    if (taken.ok.bytes != nil) { A.deallocate[u8](p.alloc, taken.ok.bytes, taken.ok.len::usize); }
    ret si;
}

fun write_link_config(fb: *wire.Sink, p: *project.Project, out_path: *u8, product: *u8, out_kind: u32,
    ext: *target_of.ObjectInput, ext_count: u32,
    dynlibs: *target_of.DynLib, dynlib_count: u32,
    image: *build_emit.LoadedImageOptions) {
    wire.put_u32(fb, out_kind);
    var pie_axis: u32 = 0;
    if (p.req.pie) { pie_axis = 1; }
    wire.put_u32(fb, pie_axis);
    lang_fingerprint.put_text(fb, out_path::str);
    lang_fingerprint.put_text(fb, product::str);
    lang_fingerprint.put_domain_u8(fb, lang_fingerprint.DOMAIN_SUBSYSTEM,
        catalog_subsystem.VERSION, catalog_subsystem.fingerprint_tag(p.req.subsystem));

    var has_resources: u32 = 0;
    if (image != nil && image.resource != nil) { has_resources = 1; }
    wire.put_u32(fb, has_resources);
    if (has_resources != 0) {
        lang_fingerprint.put_text(fb, image.icon_path);
        lang_fingerprint.put_content(fb, image.icon_bytes.data, image.icon_bytes.len);
        lang_fingerprint.put_text(fb, image.manifest_path);
        lang_fingerprint.put_content(fb, image.manifest_bytes.data, image.manifest_bytes.len);
        lang_fingerprint.put_text(fb, image.resource.version);
        lang_fingerprint.put_text(fb, image.resource.internal_name);
        lang_fingerprint.put_text(fb, image.resource.original_filename);
        lang_fingerprint.put_text(fb, image.resource.product_name);
    }

    wire.put_u32(fb, ext_count);
    var i: u32 = 0;
    for (i < ext_count) {
        lang_fingerprint.put_text(fb, ext[i].path::str);
        lang_fingerprint.put_file(fb, ext[i].path::str);
        i = i + 1;
    }
    wire.put_u32(fb, dynlib_count);
    var j: u32 = 0;
    for (j < dynlib_count) {
        lang_fingerprint.put_name(fb, ?p.s.interner, dynlibs[j].name);
        lang_fingerprint.put_name(fb, ?p.s.interner, dynlibs[j].soname);
        lang_fingerprint.put_name(fb, ?p.s.interner, dynlibs[j].rpath);
        var referenced: u8 = 0;
        if (dynlibs[j].include_referenced) { referenced = 1; }
        wire.put_u8(fb, referenced);
        j = j + 1;
    }
}

test link_config__provider_policy_invalidates_without_changing_names {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = toolchain.session_init(?a);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    var p: project.Project;
    project.init_project(?p, ?s);
    fin { project.dnit_project(?p); }
    val name: res[intern.StrId, A.Error] = intern.add(?s.interner, "provider");
    if (sel name.err) { ret 3; }
    var lib: target_of.DynLib = target_of.DynLib{
        name:   name.ok,
        soname: name.ok,
        rpath:  intern.STR_NIL, include_referenced: false
    };
    val set_link_config_input_r: err[fail.Fail] = set_link_config_input(?p, "app", "app", catalog_artifact.EXECUTABLE::u32,
        nil, 0, ?lib, 1, nil);
    if (sel set_link_config_input_r.err) { ret 4; }
    val baseline: query.Revision = query.peek_revision(?s.queries, ?passes.LINK_CONFIG, 0);
    if (baseline == 0) { ret 5; }
    val set_link_config_input_r2: err[fail.Fail] = set_link_config_input(?p, "app", "app", catalog_artifact.EXECUTABLE::u32,
        nil, 0, ?lib, 1, nil);
    if (sel set_link_config_input_r2.err)                                    { ret 6; }
    if (query.peek_revision(?s.queries, ?passes.LINK_CONFIG, 0) != baseline) { ret 7; }
    lib.include_referenced = true;
    val set_link_config_input_r3: err[fail.Fail] = set_link_config_input(?p, "app", "app", catalog_artifact.EXECUTABLE::u32,
        nil, 0, ?lib, 1, nil);
    if (sel set_link_config_input_r3.err) { ret 8; }
    val changed: query.Revision = query.peek_revision(?s.queries, ?passes.LINK_CONFIG, 0);
    if (changed == baseline) { ret 9; }
    val set_link_config_input_r4: err[fail.Fail] = set_link_config_input(?p, "app", "app", catalog_artifact.EXECUTABLE::u32,
        nil, 0, ?lib, 1, nil);
    if (sel set_link_config_input_r4.err)                                   { ret 10; }
    if (query.peek_revision(?s.queries, ?passes.LINK_CONFIG, 0) != changed) { ret 11; }
    ret 0;
}

rec PcgSlot {
    object: Object;
    made:   bool;
    failed: bool;
    fail:   fail.Fail;
}

rec ParallelCodegen {
    p:          *project.Project;
    next:       i64;
    worker_seq: i64;
    stop:       i64;
    nworkers:   u32;
    slots:      *PcgSlot;
    stale:      *u32;
    stale_len:  u32;
    # compiling the modules' test objects rather than their normal objects
    test: bool;
    # the readout row the compiled objects are items of
    phase: readout.Phase;
}

# the unit a codegen worker compiles for module m
fun pcg_unit(m: *project.ModuleEntry, test: bool) *lower_context.Unit {
    if (test) { ret m.test.unit; }
    ret m.unit;
}

# each worker compiles its units with the session's backing allocator, which every thread
# shares, and the objects it makes are handed to the module as they are
fun pcg_worker_main(arg: *u8) {
    val pc: *ParallelCodegen = arg::*ParallelCodegen;
    if (pc == nil) { panic("a codegen worker started with no section"); }
    val wid_raw: i64 = atomic.fetch_add(?pc.worker_seq, 1::i64);
    if (wid_raw < 0 || wid_raw >= pc.nworkers::i64) { ret; }

    for (true) {
        if (atomic.load(?pc.stop) != 0) { ret; }
        val idx_raw: i64 = atomic.fetch_add(?pc.next, 1::i64);
        if (idx_raw >= pc.stale_len::i64) { ret; }
        val idx: u32 = idx_raw::u32;

        val mid:  session.ModuleId     = pc.p.topo[pc.stale[idx::usize]];
        val m:    *project.ModuleEntry = project.module_at(pc.p, mid::u32);
        val slot: *PcgSlot             = ?pc.slots[idx::usize];

        val t0:   readout.Instant        = readout.item_begin(pc.p.progress);
        val made: res[Object, fail.Fail] = passes.compile_object(pc.p, pcg_unit(m, pc.test));
        readout.item_post(pc.p.progress, pc.phase, intern.text(?pc.p.s.interner, m.fqn), readout.elapsed(t0));
        if (sel made.err) {
            # a refusal of the source stops nothing, so the one reported is the first in
            # module order, as a threadless build reports it
            val refused: fail.Fail = made.err;
            slot.fail   = refused;
            slot.failed = true;
            if (!sel refused.user) {
                atomic.store(?pc.stop, 1::i64);
                ret;
            }
            cnt;
        }
        slot.object = made.ok;
        slot.made   = true;
    }
}

# compile the stale units on worker threads and stage the objects for the codegen queries
# to publish: the modules' normal objects, or with `test` their test objects
fun run_codegen_parallel(p: *project.Project, test: bool) err[fail.Fail] {
    val emit_len: u32 = p.emit_len;
    if (emit_len == 0) { ret err[fail.Fail].ok{}; }

    val rstale: res[*u32, A.Error] = A.allocate[u32](p.alloc, emit_len::usize);
    if (sel rstale.err) { ret err[fail.Fail].err{fail.refused(rstale.err)}; }
    val stale: *u32 = rstale.ok;
    fin { A.deallocate[u32](p.alloc, stale, emit_len::usize); }
    var stale_len: u32 = 0;
    var ti:        u32 = 0;
    for (ti < emit_len) {
        val m:        *project.ModuleEntry = project.module_at(p, p.topo[ti]::u32);
        var reusable: res[bool, fail.Fail] = res[bool, fail.Fail].ok{true};
        if (!test)                        { reusable = passes.codegen_reusable(p, p.topo[ti]); }
        or (passes.has_test_object(p, m)) { reusable = passes.test_codegen_reusable(p, p.topo[ti]); }
        if (sel reusable.err)             { ret err[fail.Fail].err{reusable.err}; }
        if (!reusable.ok && pcg_unit(m, test) != nil) {
            stale[stale_len] = ti;
            stale_len        = stale_len + 1;
        }
        ti = ti + 1;
    }
    if (stale_len <= 1) { ret err[fail.Fail].ok{}; }

    var nworkers: u32 = p.req.jobs;
    if (nworkers == 0)        { nworkers = 1; }
    if (nworkers > stale_len) { nworkers = stale_len; }
    if (nworkers <= 1)        { ret err[fail.Fail].ok{}; }

    val rslots: res[*PcgSlot, A.Error] = A.zallocate[PcgSlot](p.alloc, stale_len::usize);
    if (sel rslots.err) { ret err[fail.Fail].err{fail.refused(rslots.err)}; }
    val slots:  *PcgSlot = rslots.ok;
    var handed: bool     = false;
    fin {
        if (!handed) { pcg_release_slots(slots, stale_len); }
        A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
    }

    var ctx: ParallelCodegen;
    ctx.p          = p;
    ctx.next       = 0;
    ctx.worker_seq = 0;
    ctx.stop       = 0;
    ctx.nworkers   = nworkers;
    ctx.slots      = slots;
    ctx.stale      = stale;
    ctx.stale_len  = stale_len;
    ctx.test       = test;
    ctx.phase      = readout.CODEGEN;
    if (test) { ctx.phase = readout.TEST_CODEGEN; }
    val queued: err[fail.Fail] = readout.workers_begin(p.progress, p.alloc, stale_len::usize);
    if (sel queued.err) { ret queued; }

    var threads: *sync_thread.Thread               = nil;
    val extra:   u32                               = nworkers - 1;
    val rt:      res[*sync_thread.Thread, A.Error] = A.allocate[sync_thread.Thread](p.alloc, extra::usize);
    if (sel rt.err) {
        readout.workers_end(p.progress, p.alloc, ctx.phase, 1);
        ret err[fail.Fail].err{fail.refused(rt.err)};
    }
    threads = rt.ok;
    var k: u32 = 0;
    for (k < extra) {
        sync_thread.spawn_with(pcg_worker_main, (?ctx)::*u8, ?threads[k]);
        k = k + 1;
    }

    pcg_worker_main((?ctx)::*u8);

    k = 0;
    for (k < extra) {
        if (threads[k].tid >= 0) { sync_thread.join(?threads[k]); }
        k = k + 1;
    }
    A.deallocate[sync_thread.Thread](p.alloc, threads, extra::usize);
    readout.workers_end(p.progress, p.alloc, ctx.phase, nworkers);

    var ei: u32 = 0;
    for (ei < stale_len) {
        if (slots[ei].failed) { ret err[fail.Fail].err{slots[ei].fail}; }
        ei = ei + 1;
    }
    handed = true;
    ret pcg_collect(p, ?ctx);
}

fun pcg_release_slots(slots: *PcgSlot, n: u32) {
    var i: u32 = 0;
    for (i < n) {
        if (slots[i].made) {
            backend.release_object(?slots[i].object);
            slots[i].made = false;
        }
        i = i + 1;
    }
}

# box each compiled object and stage it on its module; an object that cannot be boxed is
# released with the rest
fun pcg_collect(p: *project.Project, ctx: *ParallelCodegen) err[fail.Fail] {
    var i: u32 = 0;
    fin { pcg_release_slots(ctx.slots, ctx.stale_len); }
    for (i < ctx.stale_len) {
        val slot: *PcgSlot = ?ctx.slots[i::usize];
        if (!slot.made) {
            i = i + 1;
            cnt;
        }
        val rbox: res[*Object, A.Error] = A.allocate[Object](p.s.alloc, 1::usize);
        if (sel rbox.err) { ret err[fail.Fail].err{fail.refused(rbox.err)}; }
        @rbox.ok  = slot.object;
        slot.made = false;
        val mid: session.ModuleId     = p.topo[ctx.stale[i::usize]];
        val m:   *project.ModuleEntry = project.module_at(p, mid::u32);
        if (ctx.test) { m.test.staged = rbox.ok; }
        or            { m.staged = rbox.ok; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

#[testing]
fun write_source(alloc: *A.Allocator, root: str, name: str, text: str) bool {
    val file: res[str, fail.Fail] = fail.join(alloc, root, "/src/", name);
    if (sel file.err) { ret false; }
    val wrote: err[fs.FsError] = fs.write_bytes(file.ok, text, str_len(text), 420);
    ret sel wrote.ok;
}

# a rebuild of the project at `root` on a live session, its default cell typed and lowered
#[testing]
fun lowered(s: *session.Session, root: str) res[project.Project, fail.Fail] {
    var selection: manifest.Selectors              = manifest.t_selectors("", "", "");
    val pr:        res[project.Project, fail.Fail] = driver.build_project(s, root, ?selection);
    if (sel pr.err) { ret pr; }
    var p:      project.Project = pr.ok;
    var handed: bool            = false;
    fin {
        if (!handed) { project.dnit_project(?p); }
    }
    val se: err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) { ret res[project.Project, fail.Fail].err{se.err}; }
    val le: err[fail.Fail] = driver.run_lower_pass(?p);
    if (sel le.err) { ret res[project.Project, fail.Fail].err{le.err}; }
    handed = true;
    ret res[project.Project, fail.Fail].ok{p};
}

# a lowered rebuild linked, which generates each module's code first
#[testing]
fun generated(s: *session.Session, root: str) res[project.Project, fail.Fail] {
    val pr: res[project.Project, fail.Fail] = lowered(s, root);
    if (sel pr.err) { ret pr; }
    var p:      project.Project = pr.ok;
    var handed: bool            = false;
    fin {
        if (!handed) { project.dnit_project(?p); }
    }
    val configured: err[fail.Fail] = set_link_config_input(?p, "out/app"::*u8, "app"::*u8, 0, nil, 0, nil, 0, nil);
    if (sel configured.err) { ret res[project.Project, fail.Fail].err{configured.err}; }
    val linked: res[bool, fail.Fail] = driver.run_link_pass(?p);
    if (sel linked.err) { ret res[project.Project, fail.Fail].err{linked.err}; }
    handed = true;
    ret res[project.Project, fail.Fail].ok{p};
}

# the symbol the host's executables enter at
#[testing]
fun entry_symbol() str {
    $if ($mach.build.os == $mach.os.windows) { ret "mainCRTStartup"; }
    $or ($mach.build.os == $mach.os.darwin)  { ret "start"; }
    ret "_start";
}

#[testing]
fun lower_lc(s: *session.Session, stable: session.StableModuleId) query.Revision {
    val revision: query.Revision = query.peek_revision(?s.queries, ?passes.LOWER, module.stable_index(stable)::u64);
    if (revision == 0) { ret 0xFFFFFFFFFFFFFFFF; }
    ret revision;
}

#[testing]
fun surface_lc(s: *session.Session, stable: session.StableModuleId) query.Revision {
    val revision: query.Revision = query.peek_revision(?s.queries, ?passes.LOWERED_SURFACE, module.stable_index(stable)::u64);
    if (revision == 0) { ret 0xFFFFFFFFFFFFFFFF; }
    ret revision;
}

#[testing]
fun codegen_lc(s: *session.Session, stable: session.StableModuleId) query.Revision {
    val revision: query.Revision = query.peek_revision(?s.queries, ?passes.CODEGEN, module.stable_index(stable)::u64);
    if (revision == 0) { ret 0xFFFFFFFFFFFFFFFF; }
    ret revision;
}

#[testing]
fun link_lc(s: *session.Session) query.Revision {
    val revision: query.Revision = query.peek_revision(?s.queries, ?passes.LINK, 0);
    if (revision == 0) { ret 0xFFFFFFFFFFFFFFFF; }
    ret revision;
}

# a provider body edit re-lowers only the provider and leaves the importer's code; a
# generic body edit moves the surface and re-lowers the importer
test lower__surface_firewall {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.plain;\nuse uniontest.leaf.wrap;\nfun main() i32 { ret plain() + wrap[i32](2); }\n";
    texts[1] = "pub fun plain() i32 { ret 1; }\npub fun wrap[T](x: T) T { ret x; }\n";
    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, fail.Fail] = generated(?sA, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p1:        project.Project        = p1r.ok;
    val st_main:   session.StableModuleId = project.stable_named(?p1, "uniontest.main");
    val st_leaf:   session.StableModuleId = project.stable_named(?p1, "uniontest.leaf");
    val lo_main_1: query.Revision         = lower_lc(?sA, st_main);
    val cg_main_1: query.Revision         = codegen_lc(?sA, st_main);
    val lo_leaf_1: query.Revision         = lower_lc(?sA, st_leaf);
    val sf_leaf_1: query.Revision         = surface_lc(?sA, st_leaf);
    project.dnit_project(?p1);

    val leaf_v2: str = "pub fun plain() i32 { ret 2; }\npub fun wrap[T](x: T) T { ret x; }\n";
    if (!write_source(?alloc, root, "leaf.mach", leaf_v2)) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val p2r: res[project.Project, fail.Fail] = generated(?sA, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p2:        project.Project = p2r.ok;
    val lo_main_2: query.Revision  = lower_lc(?sA, st_main);
    val cg_main_2: query.Revision  = codegen_lc(?sA, st_main);
    val lo_leaf_2: query.Revision  = lower_lc(?sA, st_leaf);
    val sf_leaf_2: query.Revision  = surface_lc(?sA, st_leaf);
    project.dnit_project(?p2);
    if (sf_leaf_2 != sf_leaf_1) { bad = 1; }
    if (lo_leaf_2 == lo_leaf_1) { bad = 1; }
    if (lo_main_2 != lo_main_1) { bad = 1; }
    if (cg_main_2 != cg_main_1) { bad = 1; }

    val leaf_v3: str = "pub fun plain() i32 { ret 2; }\npub fun wrap[T](x: T) T { val y: T = x; ret y; }\n";
    if (!write_source(?alloc, root, "leaf.mach", leaf_v3)) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val p3r: res[project.Project, fail.Fail] = generated(?sA, root);
    if (sel p3r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p3:        project.Project = p3r.ok;
    val lo_main_3: query.Revision  = lower_lc(?sA, st_main);
    val sf_leaf_3: query.Revision  = surface_lc(?sA, st_leaf);
    project.dnit_project(?p3);
    if (sf_leaf_3 == sf_leaf_2) { bad = 1; }
    if (lo_main_3 == lo_main_2) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

# a warm rebuild generates no module's code again, and an edit to a body generates only its
# own module's code again
test codegen__reuses_unchanged_and_recomputes_edited {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 2; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [3]str = [3]str{"main.mach", "a.mach", "b.mach"};
    var texts: [3]str = [3]str{"use uniontest.a.fa;\nuse uniontest.b.fb;\n\n#[symbol(\"_start\")]\nfun start() i32 { ret fa() + fb(); }\n",
        "pub fun fa() i32 { ret 1; }\n", "pub fun fb() i32 { ret 2; }\n"};
    var modules: [3]str              = [3]str{"uniontest.main", "uniontest.a", "uniontest.b"};
    val root_r:  res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 3);
    if (sel root_r.err) { ret 3; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    var cold:   CachedBuild = CachedBuild{};
    var warm:   CachedBuild = CachedBuild{};
    var edited: CachedBuild = CachedBuild{};
    fin {
        cached_build_dnit(?cold);
        cached_build_dnit(?warm);
        cached_build_dnit(?edited);
    }
    if (cached_build_in(?s, ?alloc, root, "linux", false, false, ?modules[0], ?cold) != 0)      { ret 4; }
    if (reached(?cold.generated_of) != 7)                                                       { ret 5; }
    if (cached_build_in(?s, ?alloc, root, "linux", false, false, ?modules[0], ?warm) != 0)      { ret 6; }
    if (reached(?warm.generated_of) != 0)                                                       { ret 7; }
    if (!write_source(?alloc, root, "a.mach", "pub fun fa() i32 { val t: i32 = 1; ret t; }\n")) { ret 8; }
    if (cached_build_in(?s, ?alloc, root, "linux", false, false, ?modules[0], ?edited) != 0)    { ret 9; }
    if (reached(?edited.generated_of) != 2)                                                     { ret 10; }
    ret 0;
}

test link__reuse_and_fingerprint {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA: session.Session = sr.ok;

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.a.fa;\nuse uniontest.b.fb;\nfun main() i32 { ret fa() + fb(); }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, fail.Fail] = lowered(?sA, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p1:                      project.Project        = p1r.ok;
    val st_a:                    session.StableModuleId = project.stable_named(?p1, "uniontest.a");
    val st_b:                    session.StableModuleId = project.stable_named(?p1, "uniontest.b");
    val st_main:                 session.StableModuleId = project.stable_named(?p1, "uniontest.main");
    val set_link_config_input_r: err[fail.Fail]         = set_link_config_input(?p1, "out/app"::*u8, "app"::*u8, 0, nil, 0, nil, 0, nil);
    if (sel set_link_config_input_r.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val r1: res[bool, fail.Fail] = driver.run_link_pass(?p1);
    if (sel r1.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (!r1.ok) { bad = 1; }
    val lk1: query.Revision = link_lc(?sA);
    project.dnit_project(?p1);

    val p2r: res[project.Project, fail.Fail] = lowered(?sA, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p2:                       project.Project = p2r.ok;
    val set_link_config_input_r2: err[fail.Fail]  = set_link_config_input(?p2, "out/app"::*u8, "app"::*u8, 0, nil, 0, nil, 0, nil);
    if (sel set_link_config_input_r2.err) {
        project.dnit_project(?p2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val r2: res[bool, fail.Fail] = driver.run_link_pass(?p2);
    if (sel r2.err) {
        project.dnit_project(?p2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (r2.ok) { bad = 1; }
    val lk2: query.Revision = link_lc(?sA);
    if (lk2 != lk1) { bad = 1; }
    project.dnit_project(?p2);

    if (!write_source(?alloc, root, "a.mach", "pub fun fa() i32 { val t: i32 = 1; ret t; }\n")) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    val p3r: res[project.Project, fail.Fail] = lowered(?sA, root);
    if (sel p3r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p3:                       project.Project = p3r.ok;
    val set_link_config_input_r3: err[fail.Fail]  = set_link_config_input(?p3, "out/app"::*u8, "app"::*u8, 0, nil, 0, nil, 0, nil);
    if (sel set_link_config_input_r3.err) {
        project.dnit_project(?p3);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val r3: res[bool, fail.Fail] = driver.run_link_pass(?p3);
    if (sel r3.err) {
        project.dnit_project(?p3);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (!r3.ok) { bad = 1; }
    val lk3: query.Revision = link_lc(?sA);
    if (lk3 == lk2) { bad = 1; }
    project.dnit_project(?p3);

    val p4r: res[project.Project, fail.Fail] = lowered(?sA, root);
    if (sel p4r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p4:                       project.Project = p4r.ok;
    val cg_a_before:              query.Revision  = codegen_lc(?sA, st_a);
    val cg_b_before:              query.Revision  = codegen_lc(?sA, st_b);
    val cg_main_before:           query.Revision  = codegen_lc(?sA, st_main);
    val set_link_config_input_r4: err[fail.Fail]  = set_link_config_input(?p4, "out/other"::*u8, "app"::*u8, 0, nil, 0, nil, 0, nil);
    if (sel set_link_config_input_r4.err) {
        project.dnit_project(?p4);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val r4: res[bool, fail.Fail] = driver.run_link_pass(?p4);
    if (sel r4.err) {
        project.dnit_project(?p4);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (!r4.ok)                                     { bad = 1; }
    if (link_lc(?sA) == lk3)                        { bad = 1; }
    if (codegen_lc(?sA, st_a) != cg_a_before)       { bad = 1; }
    if (codegen_lc(?sA, st_b) != cg_b_before)       { bad = 1; }
    if (codegen_lc(?sA, st_main) != cg_main_before) { bad = 1; }
    project.dnit_project(?p4);

    var icon_bytes: [4]u8;
    icon_bytes[0] = 1;
    icon_bytes[1] = 2;
    icon_bytes[2] = 3;
    icon_bytes[3] = 4;
    var ri: target_of.ResourceInfo;
    ri.icon              = ?icon_bytes[0];
    ri.icon_len          = 4;
    ri.app_manifest      = nil;
    ri.app_manifest_len  = 0;
    ri.version           = "1.0";
    ri.internal_name     = "app";
    ri.original_filename = "other.exe";
    ri.product_name      = "app";
    var loaded: build_emit.LoadedImageOptions;
    loaded.options           = target_of.image_options_default(catalog_subsystem.CONSOLE);
    loaded.options.resources = ?ri;
    loaded.resource          = ?ri;
    loaded.icon_bytes        = collections_vector.init[u8](?alloc);
    fin { collections_vector.dnit[u8](?loaded.icon_bytes); }
    val icon_held: res[usize, A.Error] = collections_vector.extend[u8](?loaded.icon_bytes, Slice[u8]{data: ?icon_bytes[0], size: 4});
    if (sel icon_held.err) { ret 1; }
    # the resource reads the icon through the vector's own bytes, so one write below changes both
    ri.icon               = loaded.icon_bytes.data;
    loaded.manifest_bytes = collections_vector.init[u8](?alloc);
    loaded.icon_path      = "assets/app.ico";
    loaded.manifest_path  = nil;

    val p5r: res[project.Project, fail.Fail] = lowered(?sA, root);
    if (sel p5r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p5:                       project.Project = p5r.ok;
    val set_link_config_input_r5: err[fail.Fail]  = set_link_config_input(?p5, "out/other"::*u8, "app"::*u8, 0, nil, 0, nil, 0, ?loaded);
    if (sel set_link_config_input_r5.err) {
        project.dnit_project(?p5);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val r5: res[bool, fail.Fail] = driver.run_link_pass(?p5);
    if (!(sel r5.ok && !(!r5.ok))) { bad = 1; }
    val lk5: query.Revision = link_lc(?sA);
    project.dnit_project(?p5);

    val p6r: res[project.Project, fail.Fail] = lowered(?sA, root);
    if (sel p6r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p6:                       project.Project = p6r.ok;
    val set_link_config_input_r6: err[fail.Fail]  = set_link_config_input(?p6, "out/other"::*u8, "app"::*u8, 0, nil, 0, nil, 0, ?loaded);
    if (sel set_link_config_input_r6.err) {
        project.dnit_project(?p6);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val r6: res[bool, fail.Fail] = driver.run_link_pass(?p6);
    if (!(sel r6.ok && (!(r6.ok) && link_lc(?sA) == lk5))) { bad = 1; }
    project.dnit_project(?p6);

    loaded.icon_bytes.data[3] = 5;
    val p7r: res[project.Project, fail.Fail] = lowered(?sA, root);
    if (sel p7r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p7:                       project.Project = p7r.ok;
    val set_link_config_input_r7: err[fail.Fail]  = set_link_config_input(?p7, "out/other"::*u8, "app"::*u8, 0, nil, 0, nil, 0, ?loaded);
    if (sel set_link_config_input_r7.err) {
        project.dnit_project(?p7);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val r7: res[bool, fail.Fail] = driver.run_link_pass(?p7);
    if (!(sel r7.ok && (!(!r7.ok) && link_lc(?sA) != lk5))) { bad = 1; }
    project.dnit_project(?p7);

    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test link__external_content_fingerprint {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA: session.Session = sr.ok;

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.a.fa;\nuse uniontest.b.fb;\nfun main() i32 { ret fa() + fb(); }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    val ext1_r: res[str, A.Error] = types_path.join(?alloc, root, "libx.a");
    if (sel ext1_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val ext1:          str             = ext1_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(ext1, "AAAA", 4, 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var ext_a: [1]target_of.ObjectInput;
    ext_a[0] = target_of.ObjectInput{path: ext1::*u8, origin: target_of.RELOC_INPUT};

    var bad: i32 = 0;

    val pAr: res[project.Project, fail.Fail] = lowered(?sA, root);
    if (sel pAr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA:                      project.Project = pAr.ok;
    val set_link_config_input_r: err[fail.Fail]  = set_link_config_input(?pA, "out/app"::*u8, "app"::*u8, 0, ?ext_a[0], 1, nil, 0, nil);
    if (sel set_link_config_input_r.err) {
        project.dnit_project(?pA);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val rlA: res[bool, fail.Fail] = driver.run_link_pass(?pA);
    if (sel rlA.err) {
        project.dnit_project(?pA);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (!rlA.ok) { bad = 1; }
    val lkA: query.Revision = link_lc(?sA);
    project.dnit_project(?pA);

    val pBr: res[project.Project, fail.Fail] = lowered(?sA, root);
    if (sel pBr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pB:                       project.Project = pBr.ok;
    val set_link_config_input_r2: err[fail.Fail]  = set_link_config_input(?pB, "out/app"::*u8, "app"::*u8, 0, ?ext_a[0], 1, nil, 0, nil);
    if (sel set_link_config_input_r2.err) {
        project.dnit_project(?pB);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val rlB: res[bool, fail.Fail] = driver.run_link_pass(?pB);
    if (sel rlB.err) {
        project.dnit_project(?pB);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (rlB.ok)              { bad = 1; }
    if (link_lc(?sA) != lkA) { bad = 1; }
    project.dnit_project(?pB);

    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(ext1, "BBBB", 4, 420);
    if (sel write_bytes_r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val pCr: res[project.Project, fail.Fail] = lowered(?sA, root);
    if (sel pCr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pC:                       project.Project = pCr.ok;
    val set_link_config_input_r3: err[fail.Fail]  = set_link_config_input(?pC, "out/app"::*u8, "app"::*u8, 0, ?ext_a[0], 1, nil, 0, nil);
    if (sel set_link_config_input_r3.err) {
        project.dnit_project(?pC);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val rlC: res[bool, fail.Fail] = driver.run_link_pass(?pC);
    if (sel rlC.err) {
        project.dnit_project(?pC);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (!rlC.ok) { bad = 1; }
    val lkC: query.Revision = link_lc(?sA);
    if (lkC == lkA) { bad = 1; }
    project.dnit_project(?pC);

    val ext2_r: res[str, A.Error] = types_path.join(?alloc, root, "liby.a");
    if (sel ext2_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val ext2:           str             = ext2_r.ok;
    val write_bytes_r3: err[fs.FsError] = fs.write_bytes(ext2, "CCCC", 4, 420);
    if (sel write_bytes_r3.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var ext_b: [1]target_of.ObjectInput;
    ext_b[0] = target_of.ObjectInput{path: ext2::*u8, origin: target_of.RELOC_INPUT};
    val pDr: res[project.Project, fail.Fail] = lowered(?sA, root);
    if (sel pDr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pD:                       project.Project = pDr.ok;
    val set_link_config_input_r4: err[fail.Fail]  = set_link_config_input(?pD, "out/app"::*u8, "app"::*u8, 0, ?ext_b[0], 1, nil, 0, nil);
    if (sel set_link_config_input_r4.err) {
        project.dnit_project(?pD);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val rlD: res[bool, fail.Fail] = driver.run_link_pass(?pD);
    if (sel rlD.err) {
        project.dnit_project(?pD);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (!rlD.ok) { bad = 1; }
    val lkD: query.Revision = link_lc(?sA);
    if (lkD == lkC) { bad = 1; }
    project.dnit_project(?pD);

    val sn_r: res[intern.StrId, A.Error] = intern.add(?sA.interner, "libfoo");
    if (sel sn_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var libs: [1]target_of.DynLib;
    libs[0].name   = sn_r.ok;
    libs[0].soname = libs[0].name;
    libs[0].rpath  = intern.STR_NIL;
    val pEr: res[project.Project, fail.Fail] = lowered(?sA, root);
    if (sel pEr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pE:                       project.Project = pEr.ok;
    val set_link_config_input_r5: err[fail.Fail]  = set_link_config_input(?pE, "out/app"::*u8, "app"::*u8, 0, ?ext_b[0], 1, ?libs[0], 1, nil);
    if (sel set_link_config_input_r5.err) {
        project.dnit_project(?pE);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val rlE: res[bool, fail.Fail] = driver.run_link_pass(?pE);
    if (sel rlE.err) {
        project.dnit_project(?pE);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (!rlE.ok) { bad = 1; }
    val lkE: query.Revision = link_lc(?sA);
    if (lkE == lkD) { bad = 1; }
    project.dnit_project(?pE);

    val rp_r: res[intern.StrId, A.Error] = intern.add(?sA.interner, "/opt/lib");
    if (sel rp_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    libs[0].rpath = rp_r.ok;
    val pFr: res[project.Project, fail.Fail] = lowered(?sA, root);
    if (sel pFr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pF:                       project.Project = pFr.ok;
    val set_link_config_input_r6: err[fail.Fail]  = set_link_config_input(?pF, "out/app"::*u8, "app"::*u8, 0, ?ext_b[0], 1, ?libs[0], 1, nil);
    if (sel set_link_config_input_r6.err) {
        project.dnit_project(?pF);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val rlF: res[bool, fail.Fail] = driver.run_link_pass(?pF);
    if (sel rlF.err) {
        project.dnit_project(?pF);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (!rlF.ok)             { bad = 1; }
    if (link_lc(?sA) == lkE) { bad = 1; }
    project.dnit_project(?pF);

    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test readout__a_phase_counts_what_it_processed {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "keep.mach";
    var texts:   [2]str;
    val entered: res[str, fail.Fail] = fail.join(?alloc, "use uniontest.keep;\n\n#[symbol(\"", entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n");
    if (sel entered.err) {
        session.dnit(?s);
        ret 2;
    }
    texts[0] = entered.ok;
    texts[1] = "pub fun keep() i32 { ret 1; }\n\ntest keep { ret 0; }\n";
    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_TEST_LIST;
    val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_to_run(?alloc, ?s, toolchain.t_registry(), ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: build_plan.BuildPlan = pr.ok;

    var rd: readout.Recording;
    readout.recording_init(?rd, ?alloc, readout.LEVEL_ITEMS);

    var bad:       i32                      = 0;
    var published: publication.Publications = publication.init(?alloc);
    fin { publication.dnit(?published); }
    val r: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?bp, 0, ?s, ?published, ?alloc, ?rd.sink);
    if (sel r.err) { bad = 2; }
    if (sel r.ok) {
        var listed: outcome.BuildOutcome = r.ok;
        if (listed.severity != outcome.BUILD_OK || listed.tests.len != 1) { bad = 3; }
        or {
            if (!str_empty(listed.tests.data[0].exe)) { bad = 4; }
        }
        outcome.outcome_dnit(?listed);
    }

    val lm: *readout.Recorded = ?rd.phases[readout.LOAD];
    val rm: *readout.Recorded = ?rd.phases[readout.RESOLVE];
    if (lm.occurrences == 0) { bad = 3; }
    if (rm.occurrences == 0) { bad = 4; }

    # a test build loads the artifact closure, and every module it loads resolves
    if (lm.dropped != 0) { bad = 5; }

    if (lm.processed != lm.items) { bad = 6; }

    if (lm.processed != rm.processed + lm.dropped) { bad = 7; }

    val sm:  *readout.Recorded = ?rd.phases[readout.SEMA];
    val lwm: *readout.Recorded = ?rd.phases[readout.LOWER];
    val om:  *readout.Recorded = ?rd.phases[readout.OPTIMIZE];
    val cm:  *readout.Recorded = ?rd.phases[readout.CODEGEN];
    val em:  *readout.Recorded = ?rd.phases[readout.EMIT];
    if (sm.occurrences > 0 && sm.processed != sm.items)    { bad = 8; }
    if (lwm.occurrences > 0 && lwm.processed != lwm.items) { bad = 9; }
    if (om.occurrences > 0 && om.processed != om.items)    { bad = 10; }
    # listing generates the test objects the tests are read from, and emits and links nothing
    if (cm.occurrences == 0 || rd.phases[readout.TEST_CODEGEN].occurrences == 0) { bad = 11; }
    if (rd.phases[readout.TEST_LOWER].occurrences == 0)                          { bad = 11; }
    if (em.occurrences != 0 || rd.phases[readout.LINK].occurrences != 0)         { bad = 12; }
    # each test object is one item of each test row, never two
    val tl: *readout.Recorded = ?rd.phases[readout.TEST_LOWER];
    val tc: *readout.Recorded = ?rd.phases[readout.TEST_CODEGEN];
    if (tl.items > tl.processed || tc.items > tc.processed) { bad = 13; }

    readout.recording_dnit(?rd);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

#[testing]
val CACHED_MODULES: u32 = 3;

# a build of root's executable for target in session s: the artifact's bytes,
# how many modules each phase processed, and which of the first
# CACHED_MODULES `modules` it typed, lowered and generated code for
#[testing]
rec CachedBuild {
    bytes:       Vector[u8];
    cached:      u32;
    resolved:    u32;
    typed:       u32;
    lowered:     u32;
    generated:   u32;
    cache_first: bool;
    # how many warnings the build reported, and a print of what they say and where
    warnings:      u32;
    warning_print: u64;
    typed_of:      [3]bool;
    lowered_of:    [3]bool;
    generated_of:  [3]bool;
}

#[testing]
fun print_mix(h: u64, v: u64) u64 {
    ret (h ^ v) * 0x100000001b3;
}

#[testing]
fun print_text(h: u64, t: str) u64 {
    var out: u64 = h;
    if (t == nil) { ret print_mix(out, 0xFF); }
    val n: usize = str_len(t);
    var i: usize = 0;
    for (i < n) {
        out = print_mix(out, t[i]::u64);
        i   = i + 1;
    }
    ret print_mix(out, n::u64);
}

# every warning the warm session's last build reported: its message, file, span, notes
# and related locations
#[testing]
fun warning_print(s: *session.Session, out: *CachedBuild) {
    var h: u64   = 0xcbf29ce484222325;
    var d: usize = 0;
    for (d < s.diags.items.len) {
        val diag: *diagnostic.Diagnostic = ?s.diags.items.data[d];
        if (!diagnostic_kind.is_error(diag.kind)) {
            out.warnings = out.warnings + 1;
            h            = print_text(h, diag.message);
            val file: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, diag.loc.file);
            if (sel file.some) { h = print_text(h, file.some.path); }
            h = print_mix(h, diag.loc.span.offset::u64);
            h = print_mix(h, diag.loc.span.len::u64);
            h = print_mix(h, diag.children.len::u64);
            h = print_mix(h, diag.related.len::u64);
        }
        d = d + 1;
    }
    out.warning_print = h;
}

#[testing]
fun cached_build_in(s: *session.Session, alloc: *A.Allocator, root: str, target: str, cached: bool, debug: bool,
    modules: *str, out: *CachedBuild) i32 {
    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(s, root);
    if (sel mr.err) { ret 1; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = target;
    rq.goal         = request.GOAL_ARTIFACT;
    rq.object_cache = cached;
    rq.debug        = debug;
    val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_to_run(alloc, s, toolchain.t_registry(), ?m, rq);
    if (sel pr.err) { ret 2; }
    var bp: build_plan.BuildPlan = pr.ok;
    var rd: readout.Recording;
    readout.recording_init(?rd, alloc, readout.LEVEL_ITEMS);
    fin { readout.recording_dnit(?rd); }
    var published: publication.Publications = publication.init(alloc);
    fin { publication.dnit(?published); }
    val r: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?bp, 0, s, ?published, alloc, ?rd.sink);
    if (sel r.err) {
        print.eprintln(fail.describe(r.err));
        ret 3;
    }
    var built:     outcome.BuildOutcome = r.ok;
    val succeeded: bool                 = built.severity == outcome.BUILD_OK;
    warning_print(s, out);
    outcome.outcome_dnit(?built);
    if (!succeeded) { ret 3; }
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, bp.units.data[0].out_path);
    if (sel read.err) { ret 4; }
    out.bytes     = read.ok;
    out.cached    = rd.phases[readout.CACHE].processed;
    out.resolved  = rd.phases[readout.RESOLVE].processed;
    out.typed     = rd.phases[readout.SEMA].processed;
    out.lowered   = rd.phases[readout.LOWER].processed;
    out.generated = rd.phases[readout.CODEGEN].processed;
    val cache_row:   i64 = readout.recording_row(?rd, readout.CACHE);
    val resolve_row: i64 = readout.recording_row(?rd, readout.RESOLVE);
    out.cache_first = cache_row >= 0 && cache_row < resolve_row;
    var i: u32 = 0;
    for (i < CACHED_MODULES) {
        out.typed_of[i]     = readout.recording_has_item(?rd, readout.SEMA, modules[i]);
        out.lowered_of[i]   = readout.recording_has_item(?rd, readout.LOWER, modules[i]);
        out.generated_of[i] = readout.recording_has_item(?rd, readout.CODEGEN, modules[i]);
        i                   = i + 1;
    }
    ret 0;
}

# the same build in a fresh session, as a new compiler process runs it
#[testing]
fun cached_build(alloc: *A.Allocator, root: str, target: str, cached: bool, debug: bool,
    modules: *str, out: *CachedBuild) i32 {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    ret cached_build_in(?s, alloc, root, target, cached, debug, modules, out);
}

#[testing]
fun cached_build_dnit(b: *CachedBuild) {
    if (b.bytes.data != nil) { collections_vector.dnit[u8](?b.bytes); }
    @b = CachedBuild{};
}

#[testing]
fun same_bytes(a: *CachedBuild, b: *CachedBuild) bool {
    if (a.bytes.len == 0 || a.bytes.len != b.bytes.len) { ret false; }
    ret memory.raw_equal(a.bytes.data::ptr, b.bytes.data::ptr, a.bytes.len);
}

# which of the three modules a phase reached, as bits: main 1, a 2, b 4
#[testing]
fun reached(of: *[3]bool) u32 {
    var bits: u32 = 0;
    var i:    u32 = 0;
    for (i < 3) {
        if ((@of)[i]) { bits = bits | (1::u32 << i); }
        i = i + 1;
    }
    ret bits;
}

# a warm build reuses every module's `obj/` object, resolving, typing,
# lowering and generating nothing, and links the binary a cold build linked,
# byte for byte, on each relocatable format: the record each object carries
# changes nothing a link reads, and the link collects the unreferenced function
# and keeps the unreferenced global of a named section as it did cold. the
# cache row precedes resolve's, and the warning the skipped importer reported
# when it compiled is reported again
test object_cache__warm_build_links_the_same_binary {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var targets: [3]str = [3]str{"linux", "windows", "darwin-x86_64"};
    var entries: [3]str = [3]str{"_start", "mainCRTStartup", "start"};
    var modules: [3]str = [3]str{"uniontest.main", "uniontest.leaf", "uniontest.main"};
    var t:       usize  = 0;
    for (t < 3) {
        var names: [2]str;
        names[0] = "main.mach";
        names[1] = "leaf.mach";
        var texts:   [2]str;
        val entered: res[str, fail.Fail] = fail.join(?alloc, "use uniontest.leaf;\n\n#[symbol(\"", entries[t], "\")]\nfun start() i32 { ret leaf.one(); }\n");
        if (sel entered.err) { ret 2; }
        texts[0] = entered.ok;
        texts[1] = "fun unused(x: i32) i32 { ret x * 3; }\n\n#[deprecated(\"retired\")]\npub fun one() i32 { ret 1; }\n\n#[section(\".kept\")]\npub var kept: [2]u64 = [2]u64{5, 6};\n";
        val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 2);
        if (sel root_r.err) { ret 1; }
        val root: str         = root_r.ok;
        var cold: CachedBuild = CachedBuild{};
        var warm: CachedBuild = CachedBuild{};
        var bad:  i32         = cached_build(?alloc, root, targets[t], true, false, ?modules[0], ?cold);
        if (bad == 0) { bad = 10 + cached_build(?alloc, root, targets[t], true, false, ?modules[0], ?warm); }
        if (bad == 10) {
            if (cold.lowered != 2 || cold.generated != 2 || cold.typed != 2 || cold.cached != 0)   { bad = 20; }
            if (warm.resolved != 0 || warm.typed != 0 || warm.lowered != 0 || warm.generated != 0) { bad = 21; }
            if (warm.cached != 2 || !warm.cache_first)                                             { bad = 22; }
            if (!same_bytes(?cold, ?warm))                                                         { bad = 23; }
            if (cold.warnings == 0 || warm.warnings != cold.warnings
                || warm.warning_print != cold.warning_print) { bad = 24; }
            if (bad == 10) { bad = 0; }
        }
        cached_build_dnit(?cold);
        cached_build_dnit(?warm);
        fs.remove_all(?alloc, root);
        if (bad != 0) { ret (t::i32 + 1) * 100 + bad; }
        t = t + 1;
    }
    ret 0;
}

# a module's key covers its own source and the surfaces it imports: a body
# edit rebuilds the edited module alone, a public declaration rebuilds it and
# its importer but not a module that does not import it, and a request input
# that reaches codegen rebuilds everything. each result is the binary an
# uncached build links, and a warm session keys an edit it sees in place
test object_cache__per_module_keys_rebuild_an_edit_and_the_importers_of_its_surface {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names: [3]str = [3]str{"main.mach", "a.mach", "b.mach"};
    var texts: [3]str;
    texts[0] = "use uniontest.a;\nuse uniontest.b;\n\n#[symbol(\"_start\")]\nfun start() i32 { ret a.one() + b.two(); }\n";
    texts[1] = "pub fun one() i32 { ret 1; }\n";
    texts[2] = "pub fun two() i32 { ret 2; }\n";
    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 3);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    var modules: [3]str = [3]str{"uniontest.main", "uniontest.a", "uniontest.b"};
    val target:  str    = "linux";

    var cold: CachedBuild = CachedBuild{};
    fin { cached_build_dnit(?cold); }
    if (cached_build(?alloc, root, target, true, false, ?modules[0], ?cold) != 0) { ret 2; }
    if (reached(?cold.generated_of) != 7)                                         { ret 3; }

    # a body edit on the same line: only the edited module is typed, lowered
    # and generated, and nothing that imports it is
    val body_edit: str = "pub fun one() i32 { ret 3; }\n";
    if (!write_source(?alloc, root, "a.mach", body_edit)) { ret 4; }
    var body: CachedBuild = CachedBuild{};
    fin { cached_build_dnit(?body); }
    if (cached_build(?alloc, root, target, true, false, ?modules[0], ?body) != 0) { ret 5; }
    if (reached(?body.generated_of) != 2 || reached(?body.lowered_of) != 2
        || reached(?body.typed_of) != 2 || body.cached != 2) { ret 6; }
    var body_uncached: CachedBuild = CachedBuild{};
    fin { cached_build_dnit(?body_uncached); }
    if (cached_build(?alloc, root, target, false, false, ?modules[0], ?body_uncached) != 0) { ret 7; }
    if (!same_bytes(?body, ?body_uncached) || same_bytes(?body, ?cold))                     { ret 8; }
    if (body_uncached.cached != 0 || reached(?body_uncached.generated_of) != 7)             { ret 8; }

    # the uncached build wrote objects without keys, so a cached one reuses
    # none and publishes them again, then an edit to the public surface
    # reaches the importer
    var primed: CachedBuild = CachedBuild{};
    fin { cached_build_dnit(?primed); }
    if (cached_build(?alloc, root, target, true, false, ?modules[0], ?primed) != 0) { ret 9; }
    if (primed.cached != 0 || reached(?primed.generated_of) != 7)                   { ret 9; }
    val surface_edit: str = "pub fun one() i32 { ret 3; }\npub fun spare() i32 { ret 4; }\n";
    if (!write_source(?alloc, root, "a.mach", surface_edit)) { ret 10; }
    var surface: CachedBuild = CachedBuild{};
    fin { cached_build_dnit(?surface); }
    if (cached_build(?alloc, root, target, true, false, ?modules[0], ?surface) != 0) { ret 11; }
    if (reached(?surface.generated_of) != 3 || surface.cached != 1)                  { ret 12; }

    # one session across rebuilds: an edit it has not seen is keyed again,
    # and the next build of the same sources reuses everything
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 15; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var warm: CachedBuild = CachedBuild{};
    fin { cached_build_dnit(?warm); }
    if (cached_build_in(?s, ?alloc, root, target, true, false, ?modules[0], ?warm) != 0) { ret 16; }
    if (warm.generated != 0 || warm.typed != 0 || !same_bytes(?warm, ?surface))          { ret 17; }
    val b_edit: str = "pub fun two() i32 { ret 5; }\n";
    if (!write_source(?alloc, root, "b.mach", b_edit)) { ret 18; }
    var b_warm: CachedBuild = CachedBuild{};
    fin { cached_build_dnit(?b_warm); }
    if (cached_build_in(?s, ?alloc, root, target, true, false, ?modules[0], ?b_warm) != 0) { ret 19; }
    if (reached(?b_warm.generated_of) != 4 || same_bytes(?b_warm, ?warm))                  { ret 20; }
    var again: CachedBuild = CachedBuild{};
    fin { cached_build_dnit(?again); }
    if (cached_build_in(?s, ?alloc, root, target, true, false, ?modules[0], ?again) != 0) { ret 21; }
    if (again.generated != 0 || !same_bytes(?again, ?b_warm))                             { ret 22; }
    # a request input that reaches codegen keys every module again; last,
    # because its objects replace every other
    var debug: CachedBuild = CachedBuild{};
    fin { cached_build_dnit(?debug); }
    if (cached_build(?alloc, root, target, true, true, ?modules[0], ?debug) != 0) { ret 23; }
    if (reached(?debug.generated_of) != 7 || debug.cached != 0)                   { ret 24; }
    ret 0;
}

#[testing]
fun bytes_contain(b: *CachedBuild, needle: str) bool {
    val n: usize = str_len(needle);
    if (n == 0 || b.bytes.len < n) { ret false; }
    var i: usize = 0;
    for (i + n <= b.bytes.len) {
        if (memory.raw_equal((b.bytes.data::usize + i)::ptr, needle::ptr, n)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a decorator argument read from another module's constant is a dependency:
# editing the constant renames the importer's symbol on the next build, warm
# in one session and through the object cache in a fresh one
test object_cache__a_decorator_constant_edit_rebuilds_its_reader {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names: [3]str = [3]str{"main.mach", "a.mach", "b.mach"};
    var texts: [3]str;
    texts[0] = "use uniontest.a;\n\n#[symbol(\"_start\")]\nfun start() i32 { ret a.named(); }\n";
    texts[1] = "use uniontest.b;\n\n#[symbol(b.NAME)]\n#[noinline]\npub fun named() i32 { ret 7; }\n";
    texts[2] = "pub val NAME: *u8 = \"attr_first_name\";\n";
    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 3);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    var modules: [3]str = [3]str{"uniontest.main", "uniontest.a", "uniontest.b"};
    val target:  str    = "linux";

    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 2; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var first: CachedBuild = CachedBuild{};
    fin { cached_build_dnit(?first); }
    if (cached_build_in(?s, ?alloc, root, target, true, false, ?modules[0], ?first) != 0) { ret 3; }
    if (!bytes_contain(?first, "attr_first_name"))                                        { ret 4; }

    val edit: str = "pub val NAME: *u8 = \"attr_second_name\";\n";
    if (!write_source(?alloc, root, "b.mach", edit)) { ret 5; }

    var warm: CachedBuild = CachedBuild{};
    fin { cached_build_dnit(?warm); }
    if (cached_build_in(?s, ?alloc, root, target, true, false, ?modules[0], ?warm) != 0) { ret 6; }
    if (!bytes_contain(?warm, "attr_second_name"))                                       { ret 7; }
    if (bytes_contain(?warm, "attr_first_name"))                                         { ret 8; }

    var fresh: CachedBuild = CachedBuild{};
    fin { cached_build_dnit(?fresh); }
    if (cached_build(?alloc, root, target, true, false, ?modules[0], ?fresh) != 0) { ret 9; }
    if (!same_bytes(?fresh, ?warm))                                                { ret 10; }
    ret 0;
}

# a module behind a deferred gate is counted once by the load row and resolved in one
# resolve row, and the load row renders first
test readout__a_gate_deferred_module_is_counted_once {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "helper.mach";
    names[2] = "extra.mach";
    var texts: [3]str;
    # extra enters the build only through a gate on a constant a later `use`
    # imports, which the load walks on demand
    val entered: res[str, fail.Fail] = fail.join(?alloc,
        "$if (helper.FLAG == 1) {\n    use uniontest.extra;\n}\n\nuse uniontest.helper;\n\n#[symbol(\"",
        entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n");
    if (sel entered.err) {
        session.dnit(?s);
        ret 2;
    }
    texts[0] = entered.ok;
    texts[1] = "pub val FLAG: u8 = 1;\n\ntest flag { ret 0; }\n";
    texts[2] = "pub fun extra() i32 { ret 3; }\n";
    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_OBJECTS;
    val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_to_run(?alloc, ?s, toolchain.t_registry(), ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: build_plan.BuildPlan = pr.ok;

    var rd: readout.Recording;
    readout.recording_init(?rd, ?alloc, readout.LEVEL_ITEMS);

    var bad:       i32                      = 0;
    var published: publication.Publications = publication.init(?alloc);
    fin { publication.dnit(?published); }
    val r: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?bp, 0, ?s, ?published, ?alloc, ?rd.sink);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        var listed: outcome.BuildOutcome = r.ok;
        if (listed.severity != outcome.BUILD_OK) { bad = 1; }
        outcome.outcome_dnit(?listed);
    }

    val lm: *readout.Recorded = ?rd.phases[readout.LOAD];
    val rm: *readout.Recorded = ?rd.phases[readout.RESOLVE];

    # one load row counts every module the build loaded, including the one
    # behind the gate, so it agrees with the resolve row
    if (lm.occurrences != 1)          { bad = 2; }
    if (lm.processed != 3)            { bad = 3; }
    if (lm.items != lm.processed)     { bad = 4; }
    if (lm.processed != rm.processed) { bad = 5; }
    if (rm.occurrences != 1)          { bad = 7; }
    if (rm.items != rm.processed)     { bad = 8; }

    # the load row is sent before the resolve row
    val load_at:    i64 = readout.recording_row(?rd, readout.LOAD);
    val resolve_at: i64 = readout.recording_row(?rd, readout.RESOLVE);
    if (load_at < 0 || resolve_at < 0 || load_at > resolve_at) { bad = 6; }

    readout.recording_dnit(?rd);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

# the entry stub the test dispatcher a linux x86_64 test build links is started through
#[testing]
fun dispatcher_stub() str {
    ret "\n#[symbol(\"_start\")]\npub fun start() {\n    asm x86_64 {\n        mov rax, rsp\n        mov rdi, [rax]\n        lea rsi, [rax+8]\n        and rsp, -16\n        call main\n        mov rdi, rax\n        mov rax, 60\n        syscall\n    }\n}\n";
}

# the exit code of the built test dispatcher `exe` running the test at `idx`, -1 when it
# did not run to an exit
#[testing]
fun dispatch_status(exe: str, idx: u32) i32 {
    var ibuf: [std_format.DECIMAL_MAX + 1]u8;
    val len:  usize = std_format.put_u64(?ibuf[0], idx::u64);
    ibuf[len] = 0;
    var argv: [3]*u8;
    argv[0] = exe::*u8;
    argv[1] = ?ibuf[0];
    argv[2] = nil;
    val spawned: res[exec.Child, exec.Error] = exec.spawn(exe, ?argv[0], exec.Environment.inherit{});
    if (sel spawned.err) { ret -1; }
    val waited: res[exec.ExitStatus, exec.Error] = exec.wait(spawned.ok);
    if (sel waited.err)          { ret -1; }
    if (!exec.exited(waited.ok)) { ret -1; }
    ret exec.code(waited.ok)::i32;
}

# the freestanding entry stub the native fixtures start through, on each linux isa
#[testing]
fun native_stub() str {
    ret "\n#[symbol(\"_start\")]\npub fun start() {\n    $if ($mach.build.arch == $mach.arch.x86_64) {\n        asm x86_64 {\n            mov rdi, [rsp]\n            and rsp, -16\n            call main\n            mov rdi, rax\n            mov rax, 60\n            syscall\n        }\n    }\n    $or ($mach.build.arch == $mach.arch.aarch64) {\n        asm aarch64 {\n            ldr x0, [sp]\n            bl main\n            mov x8, 93\n            svc 0\n        }\n    }\n    $or {\n        asm riscv64 {\n            ld a0, 0(sp)\n            call main\n            li a7, 93\n            ecall\n        }\n    }\n}\n";
}

# a manifest for a native fixture: the bin `divtrap` on the three linux isas, with a debug
# and a release profile
#[testing]
fun native_manifest() str {
    ret "[project]\nmach = \">=5\"\nid = \"divtrap\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.linux-x86_64]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.linux-arm64]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n\n[target.linux-riscv64]\nisa = \"riscv64\"\nos = \"linux\"\nabi = \"lp64d\"\n\n[artifact.divtrap]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/divtrap\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
}

# a manifest for the static library `lib` of the project `id`, with its entry `lib.mach`
#[testing]
fun lib_manifest(alloc: *A.Allocator, id: str) str {
    val made: res[str, std_format.FormatError] = std_format.sprint(alloc, "[project]\nmach = \">=5\"\nid = \"{}\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{{target.name}}/{{profile.name}}\"\n[profile.debug]\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.lib]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"{{project.work}}/lib/l\"\ntargets = [\"*\"]\nlink = []\nneed = []\n", id);
    if (sel made.ok) { ret made.ok; }
    panic("engine: a library manifest was refused\n");
    ret "";
}

# the environment a fixture under `root` runs in: `inherited` with WINEPREFIX and
# XDG_RUNTIME_DIR replaced by private directories under `root`, and WINEDLLOVERRIDES by
# overrides that disable the wayland and x11 drivers and the debugger, so a wine runner
# never opens the caller's prefix or display session. the runtime directory is made, the
# prefix is left for wine to make
# ---
# ret: the entries, which the caller frees with driver_environment.strings_free
#[testing]
fun fixture_environment(a: *A.Allocator, root: str, inherited: exec.Environment) res[driver_environment.Strings, fail.Fail] {
    val prefix: res[str, A.Error] = types_path.join(a, root, "wine-prefix");
    if (sel prefix.err) { ret res[driver_environment.Strings, fail.Fail].err{fail.refused(prefix.err)}; }
    fin { str_free(a, prefix.ok); }
    val runtime: res[str, A.Error] = types_path.join(a, root, "xdg-runtime");
    if (sel runtime.err) { ret res[driver_environment.Strings, fail.Fail].err{fail.refused(runtime.err)}; }
    fin { str_free(a, runtime.ok); }
    val made: err[fs.FsError] = fs.create_dir_all(a, runtime.ok, 448);
    if (sel made.err) { ret res[driver_environment.Strings, fail.Fail].err{fail.message("the fixture's runtime directory could not be made")}; }
    val cr: res[driver_environment.Environment, fail.Fail] = driver_environment.capture(a, inherited);
    if (sel cr.err) { ret res[driver_environment.Strings, fail.Fail].err{cr.err}; }
    var values: driver_environment.Environment = cr.ok;
    fin { driver_environment.dnit(?values); }
    var names: [3]str = [3]str{"WINEPREFIX", "XDG_RUNTIME_DIR", "WINEDLLOVERRIDES"};
    var texts: [3]str = [3]str{prefix.ok, runtime.ok, "winewayland.drv=d;winex11.drv=d;winedbg.exe=d"};
    var i:     usize  = 0;
    for (i < 3) {
        val put: err[fail.Fail] = driver_environment.put(?values, names[i], texts[i], true);
        if (sel put.err) { ret res[driver_environment.Strings, fail.Fail].err{put.err}; }
        i = i + 1;
    }
    ret driver_environment.to_strings(?values);
}

# run `program` from the fixture root `cwd`, through `runner` unless it is empty, with `argc`
# arguments counting its own name, in the fixture_environment of `cwd`, and say whether a
# trap ended it and with what exit code it ended
# ---
# ret: false when it could not be run or waited for
#[testing]
pub fun run_with_argc(cwd: str, runner: str, program: str, argc: usize, trapped: *bool, exit_code: *i32) bool {
    ret run_fixture(cwd, runner, program, argc, exec.Environment.inherit{}, trapped, exit_code);
}

# run_with_argc over the caller environment `inherited`
#[testing]
fun run_fixture(cwd: str, runner: str, program: str, argc: usize, inherited: exec.Environment, trapped: *bool, exit_code: *i32) bool {
    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret false; }
    val er: res[driver_environment.Strings, fail.Fail] = fixture_environment(?a, cwd, inherited);
    if (sel er.err) { ret false; }
    var env: driver_environment.Strings = er.ok;
    fin { driver_environment.strings_free(?a, ?env); }
    var argv:   [12]*u8;
    var n:      usize = 0;
    var launch: str   = program;
    if (!str_empty(runner)) {
        argv[n] = runner::*u8;
        n       = n + 1;
        launch  = runner;
    }
    argv[n] = program::*u8;
    n       = n + 1;
    var extra: usize = 1;
    for (extra < argc) {
        argv[n] = "x"::*u8;
        n       = n + 1;
        extra   = extra + 1;
    }
    argv[n] = nil;
    var child: subprocess.OwnedSubprocess;
    subprocess.init(?child);
    fin { subprocess.dnit(?a, ?child); }
    var options: subprocess.SpawnOptions = subprocess.spawn_options();
    options.cwd = cwd;
    val spawned: err[subprocess.Error] = subprocess.spawn_native(?a, ?child, launch, ?argv[0], exec.NativeEnvironment.given{env.items}, options);
    if (sel spawned.err) { ret false; }
    val waited: res[subprocess.SubprocessTerminal, subprocess.Error] = subprocess.wait(?a, ?child);
    if (sel waited.err) { ret false; }
    val terminal: subprocess.SubprocessTerminal = waited.ok;
    @trapped   = false;
    @exit_code = -1;
    if (terminal.kind == subprocess.STATE_SIGNALED) {
        @trapped = terminal.code == 4 || terminal.code == 5 || terminal.code == 8;
        ret true;
    }
    if (terminal.kind != subprocess.STATE_EXITED) { ret false; }
    @exit_code = terminal.code;
    @trapped   = @exit_code == 132 || @exit_code == 133 || @exit_code == 136;
    ret true;
}

# build the fixture `program` for one target and profile under the manifest `manifest_text`,
# with the `root_count` files `root_names` holds written at the project root, and run it; the
# fixture exits 0 when every check holds. a runner that is absent skips the arm with 77
#[testing]
fun native_case_files(alloc: *A.Allocator, manifest_text: str, root_names: *str, root_texts: *str, root_count: u32,
    target_name: str, runner_name: str, release: bool, program: str, label: str) i32 {
    var runner: str = "";
    if (!str_empty(runner_name)) {
        val found: res[str, exec.Error] = exec.resolve(alloc, runner_name);
        if (sel found.err) {
            print.print("tag-native: runner absent, arm skipped: ");
            print.print(runner_name);
            print.print("\n");
            ret 77;
        }
        runner = found.ok;
    }
    var w:    WarmProject;
    val made: err[fail.Fail] = warm_project_init(?w);
    if (sel made.err) { ret 1; }
    fin { warm_project_dnit(?w); }
    var names: [1]str = [1]str{"main.mach"};
    var texts: [1]str = [1]str{program};
    if (root_count == 0) { texts[0] = driver.joined(alloc, program, native_stub()); }
    val scaffolded: err[fail.Fail] = warm_project_scaffold(?w, manifest_text, ?names[0], ?texts[0], 1);
    if (sel scaffolded.err) { ret 2; }
    var ri: u32 = 0;
    for (ri < root_count) {
        val fp: res[str, A.Error] = types_path.join(alloc, w.root, root_names[ri]);
        if (sel fp.err) { ret 3; }
        val wrote: err[fs.FsError] = fs.write_bytes(fp.ok, root_texts[ri], str_len(root_texts[ri]), 420);
        if (sel wrote.err) { ret 4; }
        ri = ri + 1;
    }
    var rq: request.BuildRequest = request.defaults();
    rq.target = target_name;
    if (release) {
        rq.profile = "release";
        rq.opt     = request.OPT_RELEASE;
    }
    val planned: err[fail.Fail] = warm_project_plan(?w, rq);
    if (sel planned.err) { ret 5; }
    val built: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, alloc, nil);
    if (sel built.err) {
        print.print("tag-native: build failed for ");
        print.print(label);
        print.print(" on ");
        print.print(target_name);
        print.print("\n");
        ret 6;
    }
    val bo: outcome.BuildOutcome = built.ok;
    if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { ret 7; }
    var trapped: bool = false;
    var code:    i32  = 0;
    if (!run_with_argc(w.root, runner, bo.artifacts.data[0].path, 1, ?trapped, ?code)) { ret 8; }
    if (trapped || code != 0) {
        var profile_name: str = "debug";
        if (release) { profile_name = "release"; }
        print.printf("tag-native: {} on {} {} (trapped {}, exit {})\n", label, target_name, profile_name, trapped::u8, code);
        ret 9;
    }
    ret 0;
}

# the same over the native manifest with no other file
#[testing]
fun native_case(alloc: *A.Allocator, target_name: str, runner_name: str, release: bool, program: str, label: str) i32 {
    ret native_case_files(alloc, native_manifest(), nil, nil, 0, target_name, runner_name, release, program, label);
}

# one fixture on the three native linux targets in both profiles; 77 when an arm skipped and none failed
#[testing]
fun native_all(alloc: *A.Allocator, program: str, label: str) i32 {
    var skipped: bool = false;
    var release: bool = false;
    var pass:    u32  = 0;
    for (pass < 2) {
        if (testrun.arm_failed(native_case(alloc, "linux-x86_64", "", release, program, label), ?skipped))              { ret 1; }
        if (testrun.arm_failed(native_case(alloc, "linux-arm64", "qemu-aarch64", release, program, label), ?skipped))   { ret 2; }
        if (testrun.arm_failed(native_case(alloc, "linux-riscv64", "qemu-riscv64", release, program, label), ?skipped)) { ret 3; }
        release = true;
        pass    = pass + 1;
    }
    if (skipped) { ret 77; }
    ret 0;
}

# tag locals, globals, array elements, record fields, nested tags and pointer receivers: reads, writes, `?` addresses and whole copies
#[testing]
fun tag_storage_program() str {
    ret "tag Reply: u8 { empty; value: i64; }\ntag Outer: u8 { none; inner: Reply; byte: u8; }\nrec Box { n: u8; r: Reply; m: i64; }\n\nvar g_zero: Reply;\nvar g_init: Reply = Reply.value{42};\nvar g_arr: [3]Reply;\nvar g_box: Box;\nvar g_out: Outer = Outer.inner{Reply.value{9}};\n\n#[noinline]\nfun make(v: i64) Reply { ret Reply.value{v}; }\n\n#[noinline]\nfun take(r: Reply) i64 { if (sel r.value) { ret r.value; } ret -1; }\n\n#[noinline]\nfun bump(p: *Reply) { if (sel (@p).value) { (@p).value = (@p).value + 1; } }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    # locals\n    var l0: Reply;\n    if (take(l0) != -1) { ret 1; }\n    var l1: Reply = Reply.value{42};\n    if (!sel l1.value) { ret 2; }\n    if (l1.value != 42) { ret 3; }\n    if (sel l1.value) { l1.value = 7; }\n    if (sel l1.value && l1.value != 7) { ret 4; }\n    if (sel l1.value) { val q: *i64 = ?l1.value; @q = 8; }\n    if (take(l1) != 8) { ret 5; }\n    val c1: Reply = l1;\n    if (take(c1) != 8) { ret 6; }\n    l0 = c1;\n    if (take(l0) != 8) { ret 7; }\n    l0 = Reply.empty{};\n    if (take(l0) != -1) { ret 8; }\n    val m: Reply = make(11);\n    if (take(m) != 11) { ret 9; }\n\n    # globals\n    if (take(g_zero) != -1) { ret 10; }\n    if (take(g_init) != 42) { ret 11; }\n    g_zero = Reply.value{5};\n    if (take(g_zero) != 5) { ret 12; }\n    if (sel g_zero.value) { g_zero.value = 6; }\n    if (take(g_zero) != 6) { ret 13; }\n    if (sel g_zero.value) { val q: *i64 = ?g_zero.value; @q = @q + 1; }\n    if (take(g_zero) != 7) { ret 14; }\n    g_init = g_zero;\n    if (take(g_init) != 7) { ret 15; }\n    val gc: Reply = g_init;\n    if (take(gc) != 7) { ret 16; }\n\n    # arrays\n    var a: [3]Reply;\n    if (take(a[0]) != -1 || take(a[1]) != -1 || take(a[2]) != -1) { ret 20; }\n    a[1] = Reply.value{21};\n    if (take(a[1]) != 21) { ret 21; }\n    if (sel a[1].value) { a[1].value = 22; }\n    if (take(a[1]) != 22) { ret 22; }\n    if (sel a[1].value) { val q: *i64 = ?a[1].value; @q = 23; }\n    if (take(a[1]) != 23) { ret 23; }\n    a[2] = a[1];\n    if (take(a[2]) != 23) { ret 24; }\n    if (take(a[0]) != -1) { ret 25; }\n    val ac: [3]Reply = a;\n    if (take(ac[2]) != 23 || take(ac[0]) != -1) { ret 26; }\n    if (take(g_arr[2]) != -1) { ret 27; }\n    g_arr[2] = Reply.value{28};\n    if (take(g_arr[2]) != 28) { ret 28; }\n    g_arr = a;\n    if (take(g_arr[1]) != 23 || take(g_arr[0]) != -1) { ret 29; }\n\n    # record fields\n    var b: Box;\n    if (take(b.r) != -1) { ret 30; }\n    b.r = Reply.value{31};\n    if (take(b.r) != 31) { ret 31; }\n    if (sel b.r.value) { b.r.value = 32; }\n    if (take(b.r) != 32) { ret 32; }\n    if (sel b.r.value) { val q: *i64 = ?b.r.value; @q = 33; }\n    if (take(b.r) != 33) { ret 33; }\n    val bc: Box = b;\n    if (take(bc.r) != 33) { ret 34; }\n    val b2: Box = Box{n: 1, r: Reply.value{35}, m: 2};\n    if (take(b2.r) != 35 || b2.n != 1 || b2.m != 2) { ret 35; }\n    if (take(g_box.r) != -1) { ret 36; }\n    g_box = b2;\n    if (take(g_box.r) != 35) { ret 37; }\n\n    # tags in tags\n    var o: Outer;\n    if (is_none(o) == 0) { ret 40; }\n    o = Outer.inner{Reply.value{41}};\n    if (is_inner(o) == 0) { ret 41; }\n    if (sel o.inner && !sel o.inner.value) { ret 42; }\n    if (sel o.inner) { if (sel o.inner.value) { if (o.inner.value != 41) { ret 43; } } }\n    if (sel o.inner) { if (sel o.inner.value) { o.inner.value = 44; } }\n    if (sel o.inner) { if (take(o.inner) != 44) { ret 44; } }\n    if (sel o.inner) { o.inner = Reply.empty{}; if (!sel o.inner.empty) { ret 45; } }\n    if (sel o.inner) { val q: *Reply = ?o.inner; @q = Reply.value{46}; if (take(o.inner) != 46) { ret 46; } }\n    val oc: Outer = o;\n    if (sel oc.inner) { if (take(oc.inner) != 46) { ret 47; } } or { ret 47; }\n    if (is_inner(g_out) == 0) { ret 48; }\n    if (sel g_out.inner) { if (take(g_out.inner) != 9) { ret 49; } }\n    o = Outer.byte{3};\n    if (is_inner(o) != 0 || is_none(o) != 0) { ret 50; } if (sel o.byte && o.byte != 3) { ret 50; }\n\n    # through pointers\n    var pr: Reply = Reply.value{51};\n    val p: *Reply = ?pr;\n    if (take(@p) != 51) { ret 51; }\n    if (sel (@p).value && (@p).value != 51) { ret 52; }\n    if (sel (@p).value && (@p).value != 51) { ret 53; }\n    bump(p);\n    if (take(pr) != 52) { ret 54; }\n    @p = Reply.value{55};\n    if (take(pr) != 55) { ret 55; }\n    val d: Reply = @p;\n    if (take(d) != 55) { ret 56; }\n    if (sel (@p).value) { (@p).value = 57; }\n    if (take(pr) != 57) { ret 57; }\n    if (sel (@p).value) { val q: *i64 = ?(@p).value; @q = 58; }\n    if (take(pr) != 58) { ret 58; }\n    val pa: *[3]Reply = ?a;\n    if (take((@pa)[1]) != 23) { ret 59; }\n    (@pa)[0] = Reply.value{60};\n    if (take(a[0]) != 60) { ret 60; }\n    val pb: *Box = ?b;\n    if (take(pb.r) != 33) { ret 61; }\n    pb.r = Reply.value{62};\n    if (take(b.r) != 62) { ret 62; }\n    ret 0;\n}\n\n#[noinline]\nfun is_none(o: Outer) u8 { if (sel o.none) { ret 1; } ret 0; }\n#[noinline]\nfun is_inner(o: Outer) u8 { if (sel o.inner) { ret 1; } ret 0; }\n";
}

# byte-level replacement checks: inactive suffix, discriminator gap, payloadless replacement, tail padding, a 4-byte payload in a 20-byte tag,
# and constructions in callees whose frames overlay a poisoned stack region
#[testing]
fun tag_zeroing_program() str {
    ret "tag Reply: u8 { empty; value: i64; }\ntag Big: u8 { small: u8; big: [16]u8; mid: u32; }\ntag Wide: u32 { a; b: u64; }\ntag Tail: u8 { a; b: u16; c: [3]u8; }\n\n#[noinline]\nfun fill(n: u8) [16]u8 { var a: [16]u8; var i: u64 = 0; for (i < 16) { a[i] = n; i = i + 1; } ret a; }\n\n#[noinline]\nfun byte_at(p: *u8, i: u64) u8 { ret p[i]; }\n\n#[noinline]\nfun poison(p: *u8, from: u64, to: u64) { var i: u64 = from; for (i < to) { p[i] = 0xAA; i = i + 1; } }\n\n#[noinline]\nfun sink(p: *u8) u8 { ret p[0]; }\n\n# dirties the stack region a following callee's frame will occupy\n#[noinline]\nfun dirty() u8 { var junk: [1024]u8; var i: u64 = 0; for (i < 1024) { junk[i] = 0xAA; i = i + 1; } ret sink(?junk[0]); }\n\n#[noinline]\nfun mk_small(v: u8) Big { ret Big.small{v}; }\n#[noinline]\nfun mk_mid(v: u32) Big { ret Big.mid{v}; }\n#[noinline]\nfun mk_empty() Reply { ret Reply.empty{}; }\n#[noinline]\nfun mk_tail(v: u16) Tail { ret Tail.b{v}; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    # replacing a larger case by a smaller one clears the inactive suffix\n    if ($size_of(Big) != 20 || $offset_of(Big, big) != 4) { ret 100; }\n    var b: Big = Big.big{fill(0xFF)};\n    val pb: *u8 = (?b)::*u8;\n    if (byte_at(pb, 0) != 1) { ret 1; }\n    if (byte_at(pb, 4) != 0xFF || byte_at(pb, 19) != 0xFF) { ret 2; }\n    b = Big.small{7};\n    if (byte_at(pb, 0) != 0 || byte_at(pb, 4) != 7) { ret 3; }\n    var i: u64 = 1;\n    for (i < 20) { if (i != 4 && byte_at(pb, i) != 0) { ret 4; } i = i + 1; }\n    # tag-owned gap between discriminator and payload is zeroed on replacement\n    var r: Reply = Reply.value{-1};\n    val pr: *u8 = (?r)::*u8;\n    poison(pr, 1, 8);\n    r = Reply.value{5};\n    i = 1;\n    for (i < 8) { if (byte_at(pr, i) != 0) { ret 5; } i = i + 1; }\n    if (byte_at(pr, 8) != 5) { ret 6; }\n    # inactive suffix after replacing a payload case by the payloadless case\n    r = Reply.empty{};\n    i = 0;\n    for (i < 16) { if (byte_at(pr, i) != 0) { ret 7; } i = i + 1; }\n    # tail padding of a u32-discriminated tag (size 16: 4 disc + 4 gap + 8 payload; no tail) and a mid case\n    var w: Wide = Wide.b{0xFFFFFFFFFFFFFFFF};\n    val pw: *u8 = (?w)::*u8;\n    poison(pw, 4, 8);\n    w = Wide.a{};\n    i = 0;\n    for (i < 16) { if (byte_at(pw, i) != 0) { ret 8; } i = i + 1; }\n    # a u32 payload in a 17-byte payload area leaves bytes 5..17 zero\n    b = Big.big{fill(0xEE)};\n    b = Big.mid{0x01020304};\n    if (byte_at(pb, 0) != 2 || byte_at(pb, 4) != 4 || byte_at(pb, 7) != 1) { ret 9; }\n    i = 8;\n    for (i < 20) { if (byte_at(pb, i) != 0) { ret 10; } i = i + 1; }\n    # construction into a fresh local: poison the slot's stack before use is impossible here, so check an array element\n    var arr: [2]Big;\n    arr[1] = Big.big{fill(0xCC)};\n    arr[1] = Big.small{1};\n    val pa: *u8 = (?arr[1])::*u8;\n    i = 5;\n    for (i < 20) { if (byte_at(pa, i) != 0) { ret 11; } i = i + 1; }\n    # tail padding: size 6 with payload at 2, byte 5 is padding and is zeroed by construction\n    if ($size_of(Tail) != 6 || $offset_of(Tail, c) != 2) { ret 12; }\n    var t: Tail = Tail.c{[3]u8{1, 2, 3}};\n    val pt: *u8 = (?t)::*u8;\n    if (byte_at(pt, 0) != 2 || byte_at(pt, 2) != 1 || byte_at(pt, 4) != 3) { ret 13; }\n    poison(pt, 5, 6);\n    t = Tail.b{0x0102};\n    if (byte_at(pt, 0) != 1 || byte_at(pt, 1) != 0 || byte_at(pt, 2) != 2 || byte_at(pt, 3) != 1 || byte_at(pt, 4) != 0 || byte_at(pt, 5) != 0) { ret 14; }\n    # constructions whose temp slot sits on a poisoned stack region are still fully zeroed\n    if (dirty() != 0xAA) { ret 15; }\n    var d1: Big = mk_small(7);\n    val pd1: *u8 = (?d1)::*u8;\n    if (byte_at(pd1, 0) != 0 || byte_at(pd1, 4) != 7) { ret 16; }\n    i = 1;\n    for (i < 20) { if (i != 4 && byte_at(pd1, i) != 0) { ret 17; } i = i + 1; }\n    if (dirty() != 0xAA) { ret 18; }\n    var d2: Big = mk_mid(0x01020304);\n    val pd2: *u8 = (?d2)::*u8;\n    if (byte_at(pd2, 0) != 2 || byte_at(pd2, 4) != 4 || byte_at(pd2, 7) != 1) { ret 19; }\n    i = 1;\n    for (i < 20) { if ((i < 4 || i > 7) && byte_at(pd2, i) != 0) { ret 20; } i = i + 1; }\n    if (dirty() != 0xAA) { ret 21; }\n    var d3: Reply = mk_empty();\n    val pd3: *u8 = (?d3)::*u8;\n    i = 0;\n    for (i < 16) { if (byte_at(pd3, i) != 0) { ret 22; } i = i + 1; }\n    if (dirty() != 0xAA) { ret 23; }\n    var d4: Tail = mk_tail(0x0102);\n    val pd4: *u8 = (?d4)::*u8;\n    if (byte_at(pd4, 0) != 1 || byte_at(pd4, 1) != 0 || byte_at(pd4, 2) != 2 || byte_at(pd4, 3) != 1 || byte_at(pd4, 4) != 0 || byte_at(pd4, 5) != 0) { ret 24; }\n    ret 0;\n}\n";
}

# rhs-first assignment: the destination index, a replacement initializer reading the old payload, a destination call and an aliasing self-copy
#[testing]
fun tag_order_program() str {
    ret "tag Reply: u8 { empty; value: i64; }\nvar seq: i64 = 0;\n\n#[noinline]\nfun next(i: *i64) Reply { @i = @i + 1; ret Reply.value{@i * 10}; }\n\n#[noinline]\nfun peek(r: *Reply) i64 { if (sel (@r).value) { ret (@r).value; } ret 0; }\n\n#[noinline]\nfun take(r: Reply) i64 { if (sel r.value) { ret r.value; } ret -1; }\n\n#[noinline]\nfun pick(a: *[2]Reply, which: *i64) *Reply { @which = 1; ret ?(@a)[1]; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    # rhs-first: the index reads the value the rhs call wrote\n    var a: [2]Reply;\n    var i: i64 = 0;\n    a[i] = next(?i);\n    if (take(a[1]) != 10) { ret 1; }\n    if (take(a[0]) != -1) { ret 2; }\n    # a replacement initializer may read the old payload before the destination is overwritten\n    var r: Reply = Reply.value{5};\n    r = Reply.value{peek(?r) + 1};\n    if (take(r) != 6) { ret 3; }\n    # destination through a call that runs after the rhs\n    var which: i64 = 0;\n    var b: [2]Reply;\n    @pick(?b, ?which) = next(?which);\n    if (take(b[1]) != 10) { ret 4; }\n    # self-copy through an aliasing pointer: rhs snapshot precedes the overwrite\n    var s: Reply = Reply.value{9};\n    val ps: *Reply = ?s;\n    s = @ps;\n    if (take(s) != 9) { ret 5; }\n    ret 0;\n}\n";
}

# `#[packed]` tags: size, offsets, stride 17 unaligned payloads, nested record payload writes, copies, `u16` discriminator
#[testing]
fun tag_packed_program() str {
    ret "rec Pair { a: u32; b: u64; }\n#[packed]\ntag P: u8 { empty; value: u64; pair: Pair; }\n#[packed]\ntag Q: u16 { empty; value: u32; }\ntag N: u8 { empty; value: u64; }\n\nvar g: [3]P;\n\n#[noinline]\nfun take(p: P) u64 { if (sel p.value) { ret p.value; } if (sel p.pair) { ret p.pair.a::u64 + p.pair.b; } ret 0xFFFF; }\n#[noinline]\nfun takeq(q: Q) u32 { if (sel q.value) { ret q.value; } ret 0xFFFF; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if ($size_of(P) != 17 || $align_of(P) != 1) { ret 1; }\n    if ($offset_of(P, value) != 1 || $offset_of(P, pair) != 1) { ret 2; }\n    if ($size_of(Q) != 6 || $align_of(Q) != 1 || $offset_of(Q, value) != 2) { ret 3; }\n    if ($size_of(N) != 16 || $align_of(N) != 8 || $offset_of(N, value) != 8) { ret 4; }\n    var a: [3]P;\n    val base: u64 = (?a)::u64;\n    if ((?a[1])::u64 - base != 17) { ret 5; }\n    a[1] = P.value{0x0102030405060708};\n    if (take(a[1]) != 0x0102030405060708) { ret 6; }\n    val pa: *u8 = (?a)::*u8;\n    if (pa[17] != 1 || pa[18] != 0x08 || pa[25] != 0x01) { ret 7; }\n    if (sel a[1].value) { a[1].value = a[1].value + 1; }\n    if (take(a[1]) != 0x0102030405060709) { ret 8; }\n    a[2] = P.pair{Pair{a: 3, b: 4}};\n    if (take(a[2]) != 7) { ret 9; }\n    if (pa[34] != 2 || pa[35] != 3 || pa[43] != 4) { ret 10; }\n    if (sel a[2].pair) { a[2].pair.b = 40; }\n    if (take(a[2]) != 43) { ret 11; }\n    a[0] = a[2];\n    if (take(a[0]) != 43) { ret 12; }\n    g = a;\n    if (take(g[0]) != 43 || take(g[1]) != 0x0102030405060709) { ret 13; }\n    val pp: *P = ?g[1];\n    if (sel (@pp).value && (@pp).value != 0x0102030405060709) { ret 14; }\n    @pp = P.empty{};\n    if (take(g[1]) != 0xFFFF) { ret 15; }\n    var qs: [3]Q;\n    qs[1] = Q.value{0xDEADBEEF};\n    if (takeq(qs[1]) != 0xDEADBEEF) { ret 16; }\n    val pq: *u8 = (?qs)::*u8;\n    if (pq[6] != 1 || pq[7] != 0 || pq[8] != 0xEF || pq[11] != 0xDE) { ret 17; }\n    ret 0;\n}\n";
}

# `#[align(N)]` tags: object alignment and size, locals in a frame with saved registers, globals, array elements and record fields
#[testing]
fun tag_aligned_program() str {
    ret "#[align(16)]\ntag A: u8 { empty; value: u64; }\n#[align(32)]\ntag B: u8 { empty; value: u8; }\nrec Holder { c: u8; a: A; }\n\nvar ga: A = A.value{1};\nvar garr: [3]A;\nvar gh: Holder;\n\n#[noinline]\nfun take(a: A) u64 { if (sel a.value) { ret a.value; } ret 0xFFFF; }\n#[noinline]\nfun takeb(b: B) u8 { if (sel b.value) { ret b.value; } ret 0xFF; }\n#[noinline]\nfun spill(x: u64, y: u64, z: u64) u64 {\n    var a: A = A.value{x};\n    var b: A = A.value{y};\n    var c: A = A.value{z};\n    if ((?a)::u64 % 16 != 0 || (?b)::u64 % 16 != 0 || (?c)::u64 % 16 != 0) { ret 0xFFFF; }\n    ret take(a) + take(b) + take(c);\n}\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if ($size_of(A) != 16 || $align_of(A) != 16) { ret 1; }\n    if ($size_of(B) != 32 || $align_of(B) != 32) { ret 2; }\n    if ($size_of(Holder) != 32 || $offset_of(Holder, a) != 16) { ret 3; }\n    var a: A = A.value{5};\n    if ((?a)::u64 % 16 != 0) { ret 4; }\n    if ((?ga)::u64 % 16 != 0 || (?garr[1])::u64 % 16 != 0 || (?gh.a)::u64 % 16 != 0) { ret 5; }\n    var b: B = B.value{9};\n    if ((?b)::u64 % 32 != 0) { ret 6; }\n    if (takeb(b) != 9) { ret 7; }\n    if (spill(1, 2, 3) != 6) { ret 8; }\n    var arr: [3]A;\n    if ((?arr[2])::u64 - (?arr[0])::u64 != 32) { ret 9; }\n    arr[2] = a;\n    if (take(arr[2]) != 5) { ret 10; }\n    gh.a = arr[2];\n    if (take(gh.a) != 5) { ret 11; }\n    ret 0;\n}\n";
}

# by-value transfer of tags from 2 to 32 bytes, a float payload, a nested tag and nine tag arguments
#[testing]
fun tag_abi_program() str {
    ret "tag T1: u8 { a; b; }\ntag T2: u8 { a; b: u8; }\ntag T9: u8 { a; b: [8]u8; }\ntag T16: u8 { a; b: i64; }\ntag T24: u8 { a; b: [2]i64; c: u8; }\ntag T32: u8 { a; b: [3]i64; }\ntag TF: u8 { a; b: f64; }\ntag Nest: u8 { a; b: T16; c: T2; }\n\n#[noinline] fun m1(x: u8) T1 { if (x == 0) { ret T1.a{}; } ret T1.b{}; }\n#[noinline] fun m2(x: u8) T2 { ret T2.b{x}; }\n#[noinline] fun m9(x: u8) T9 { var a: [8]u8; a[0] = x; a[7] = x + 1; ret T9.b{a}; }\n#[noinline] fun m16(x: i64) T16 { ret T16.b{x}; }\n#[noinline] fun m24(x: i64) T24 { var a: [2]i64; a[0] = x; a[1] = x + 1; ret T24.b{a}; }\n#[noinline] fun m32(x: i64) T32 { var a: [3]i64; a[0] = x; a[1] = x + 1; a[2] = x + 2; ret T32.b{a}; }\n#[noinline] fun mf(x: f64) TF { ret TF.b{x}; }\n#[noinline] fun mn(x: i64) Nest { ret Nest.b{m16(x)}; }\n\n#[noinline] fun t1(v: T1) u8 { if (sel v.b) { ret 1; } ret 0; }\n#[noinline] fun t2(v: T2) u8 { if (sel v.b) { ret v.b; } ret 0; }\n#[noinline] fun t9(v: T9) u8 { if (sel v.b) { ret v.b[0] + v.b[7]; } ret 0; }\n#[noinline] fun t16(v: T16) i64 { if (sel v.b) { ret v.b; } ret -1; }\n#[noinline] fun t24(v: T24) i64 { if (sel v.b) { ret v.b[0] + v.b[1]; } ret -1; }\n#[noinline] fun t32(v: T32) i64 { if (sel v.b) { ret v.b[0] + v.b[1] + v.b[2]; } ret -1; }\n#[noinline] fun tf(v: TF) f64 { if (sel v.b) { ret v.b; } ret -1.0; }\n#[noinline] fun tn(v: Nest) i64 { if (sel v.b) { ret t16(v.b); } ret -1; }\n#[noinline] fun many(a: T16, b: T16, c: T16, d: T16, e: T16, f: T16, g: T16, h: T16, i: T16) i64 { ret t16(a) + t16(b) + t16(c) + t16(d) + t16(e) + t16(f) + t16(g) + t16(h) + t16(i); }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if (t1(m1(0)) != 0 || t1(m1(1)) != 1) { ret 1; }\n    if (t2(m2(7)) != 7) { ret 2; }\n    if (t9(m9(3)) != 7) { ret 3; }\n    if (t16(m16(100)) != 100) { ret 4; }\n    if (t24(m24(5)) != 11) { ret 5; }\n    if (t32(m32(5)) != 18) { ret 6; }\n    if (tf(mf(2.5)) != 2.5) { ret 7; }\n    if (tn(mn(77)) != 77) { ret 8; }\n    if (many(m16(1), m16(2), m16(3), m16(4), m16(5), m16(6), m16(7), m16(8), m16(9)) != 45) { ret 9; }\n    val n: Nest = mn(3);\n    val c: Nest = n;\n    if (tn(c) != 3) { ret 10; }\n    var arr: [4]Nest;\n    arr[3] = c;\n    val arr2: [4]Nest = arr;\n    if (tn(arr2[3]) != 3 || tn(arr2[0]) != -1) { ret 11; }\n    ret 0;\n}\n";
}

# static `val` tags, arrays, records and a packed tag byte-compared with their runtime construction, and
# initializers that name another constant: a tag, an identity cast, a record, an array and an element
#[testing]
fun tag_static_program() str {
    ret "tag Reply: u8 { empty; value: i64; }\ntag Big: u8 { small: u8; big: [16]u8; mid: u32; }\nrec Box { n: u8; r: Reply; }\n#[packed]\ntag P: u8 { empty; value: u64; }\n\nval S_VAL: Reply = Reply.value{42};\nval S_EMPTY: Reply = Reply.empty{};\nval S_ARR: [3]Reply = [3]Reply{Reply.value{1}, Reply.empty{}, Reply.value{3}};\nval S_BOX: Box = Box{n: 9, r: Reply.value{7}};\nval S_MID: Big = Big.mid{0x01020304};\nval S_P: P = P.value{0x0102030405060708};\nval S_NEST: [2]Box = [2]Box{Box{n: 1}, Box{n: 2, r: Reply.value{5}}};\nval K: Reply = Reply.value{42};\nval K2: Reply = K;\nval K3: Reply = K::Reply;\nval KB: Box = Box{n: 1, r: K};\nval KBB: Box = KB;\nval KA: [2]Reply = [2]Reply{Reply.value{1}, K};\nval KA2: [2]Reply = KA;\nval KC: Reply = KA2[1];\n\n#[noinline] fun take(r: Reply) i64 { if (sel r.value) { ret r.value; } ret -1; }\n#[noinline] fun rt_val() Reply { ret Reply.value{42}; }\n#[noinline] fun rt_mid() Big { ret Big.mid{0x01020304}; }\n#[noinline] fun rt_p() P { ret P.value{0x0102030405060708}; }\n#[noinline] fun same(a: *u8, b: *u8, n: u64) u8 { var i: u64 = 0; for (i < n) { if (a[i] != b[i]) { ret 0; } i = i + 1; } ret 1; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if (take(S_VAL) != 42 || take(S_EMPTY) != -1) { ret 1; }\n    if (take(S_ARR[0]) != 1 || take(S_ARR[1]) != -1 || take(S_ARR[2]) != 3) { ret 2; }\n    if (S_BOX.n != 9 || take(S_BOX.r) != 7) { ret 3; }\n    var r: Reply = rt_val();\n    if (same((?S_VAL)::*u8, (?r)::*u8, 16) == 0) { ret 4; }\n    var m: Big = rt_mid();\n    if (same((?S_MID)::*u8, (?m)::*u8, 17) == 0) { ret 5; }\n    var p: P = rt_p();\n    if (same((?S_P)::*u8, (?p)::*u8, 9) == 0) { ret 6; }\n    if (take(S_NEST[0].r) != -1 || take(S_NEST[1].r) != 5) { ret 7; }\n    val pe: *u8 = (?S_EMPTY)::*u8;\n    var i: u64 = 0;\n    for (i < 16) { if (pe[i] != 0) { ret 8; } i = i + 1; }\n    # initializers that name another constant fold to the constant's value\n    if (take(K2) != 42) { ret 11; }\n    if (take(K3) != 42) { ret 12; }\n    if (take(KB.r) != 42 || KB.n != 1) { ret 13; }\n    if (take(KBB.r) != 42 || KBB.n != 1) { ret 14; }\n    if (take(KA2[0]) != 1 || take(KA2[1]) != 42) { ret 15; }\n    if (take(KC) != 42) { ret 16; }\n    if (same((?K)::*u8, (?K2)::*u8, $size_of(Reply)) == 0) { ret 17; }\n    if (same((?KB)::*u8, (?KBB)::*u8, $size_of(Box)) == 0) { ret 18; }\n    if (same((?KA)::*u8, (?KA2)::*u8, $size_of([2]Reply)) == 0) { ret 19; }\n    ret 0;\n}\n";
}

# generic tags nested three deep, arrays and record fields of generic instances, runtime indices
#[testing]
fun tag_generic_program() str {
    ret "tag rs[T, E]: u8 { err: E; ok: T; }\ntag op[T]: u8 { none; some: T; }\ntag Reply: u8 { empty; value: i64; }\nrec Pair { a: op[i64]; b: rs[Reply, u8]; }\n\nvar g: op[op[i64]];\nvar garr: [2]rs[Reply, u8];\n\n#[noinline] fun take(r: Reply) i64 { if (sel r.value) { ret r.value; } ret -1; }\n#[noinline] fun inner(o: op[op[i64]]) i64 { if (sel o.some) { if (sel o.some.some) { ret o.some.some; } ret -2; } ret -1; }\n#[noinline] fun okv(r: rs[Reply, u8]) i64 { if (sel r.ok) { ret take(r.ok); } if (sel r.err) { ret -100 - r.err::i64; } ret -1000; }\n#[noinline] fun mk(v: i64) rs[Reply, u8] { ret rs[Reply, u8].ok{Reply.value{v}}; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if (inner(g) != -1) { ret 1; }\n    g = op[op[i64]].some{op[i64].none{}};\n    if (inner(g) != -2) { ret 2; }\n    g = op[op[i64]].some{op[i64].some{7}};\n    if (inner(g) != 7) { ret 3; }\n    if (sel g.some) { if (sel g.some.some) { g.some.some = 8; } }\n    if (inner(g) != 8) { ret 4; }\n    if (sel g.some) { g.some = op[i64].none{}; }\n    if (inner(g) != -2) { ret 5; }\n    var l: op[op[i64]] = g;\n    if (inner(l) != -2) { ret 6; }\n    if (okv(garr[0]) != -100) { ret 7; }\n    garr[1] = mk(9);\n    if (okv(garr[1]) != 9) { ret 8; }\n    var i: i64 = 1;\n    if (sel garr[i].ok) { if (sel garr[i].ok.value) { garr[i].ok.value = 10; } }\n    if (okv(garr[i]) != 10) { ret 9; }\n    if (sel garr[i].ok) { val q: *Reply = ?garr[i].ok; @q = Reply.empty{}; }\n    if (okv(garr[1]) != -1) { ret 10; }\n    garr[1] = rs[Reply, u8].err{3};\n    if (okv(garr[1]) != -103) { ret 11; }\n    var p: Pair;\n    if (okv(p.b) != -100) { ret 12; }\n    p = Pair{a: op[i64].some{4}, b: mk(5)};\n    if (okv(p.b) != 5) { ret 13; }\n    if (sel p.a.some && p.a.some != 4) { ret 14; }\n    val pc: Pair = p;\n    if (okv(pc.b) != 5) { ret 15; }\n    val q: Pair = Pair{a: op[i64].some{1}};\n    if (okv(q.b) != -100) { ret 16; }\n    ret 0;\n}\n";
}

# vector, 4096-byte, `u16`/`u64`-discriminated and union payloads, capture through a pointer into the destination, omitted runtime tag field
#[testing]
fun tag_payloads_program() str {
    ret "tag V: u8 { none; v: f32x4; }\ntag Huge: u8 { none; buf: [4096]u8; small: u16; }\ntag D16: u16 { a; b: u8; }\ntag D64: u64 { a; b: u8; c: [3]u8; }\nuni U { a: u8; b: u64; }\ntag TU: u8 { none; u: U; }\ntag Reply: u8 { empty; value: i64; }\ntag Outer: u8 { none; inner: Reply; }\nrec Box { n: u8; r: Reply; }\n\n#[noinline] fun fill(n: u8) [4096]u8 { var a: [4096]u8; var i: u64 = 0; for (i < 4096) { a[i] = n; i = i + 1; } ret a; }\n#[noinline] fun sumv(t: V) f32 { if (sel t.v) { ret t.v[0] + t.v[1] + t.v[2] + t.v[3]; } ret -1.0; }\n#[noinline] fun last(h: Huge) u8 { if (sel h.buf) { ret h.buf[4095]; } ret 0xFF; }\n#[noinline] fun d16(t: D16) u8 { if (sel t.b) { ret t.b; } ret 0xFF; }\n#[noinline] fun d64(t: D64) u8 { if (sel t.b) { ret t.b; } if (sel t.c) { ret t.c[2]; } ret 0xFF; }\n#[noinline] fun ub(t: TU) u64 { if (sel t.u) { ret t.u.b; } ret 0; }\n#[noinline] fun take(r: Reply) i64 { if (sel r.value) { ret r.value; } ret -1; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    var v: V = V.v{f32x4{1.0, 2.0, 3.0, 4.0}};\n    if ($align_of(V) != 16 || $offset_of(V, v) != 16 || $size_of(V) != 32) { ret 1; }\n    if (sumv(v) != 10.0) { ret 2; }\n    if (sel v.v) { v.v = f32x4{2.0, 2.0, 2.0, 2.0}; }\n    if (sumv(v) != 8.0) { ret 3; }\n    val vc: V = v;\n    if (sumv(vc) != 8.0) { ret 4; }\n    var arr: [2]V;\n    arr[1] = vc;\n    if (sumv(arr[1]) != 8.0 || sumv(arr[0]) != -1.0) { ret 5; }\n\n    var h: Huge = Huge.buf{fill(0x5A)};\n    if (last(h) != 0x5A) { ret 6; }\n    val ph: *u8 = (?h)::*u8;\n    if (ph[0] != 1 || ph[2] != 0x5A || ph[4097] != 0x5A) { ret 7; }\n    h = Huge.small{0x0102};\n    if (ph[0] != 2 || ph[2] != 2 || ph[3] != 1) { ret 8; }\n    var i: u64 = 4;\n    for (i < 4098) { if (ph[i] != 0) { ret 9; } i = i + 1; }\n    var hc: Huge = h;\n    hc = Huge.buf{fill(0x33)};\n    if (last(hc) != 0x33) { ret 10; }\n    h = hc;\n    if (last(h) != 0x33 || ph[4097] != 0x33) { ret 11; }\n\n    if ($size_of(D16) != 4 || $offset_of(D16, b) != 2) { ret 12; }\n    if ($size_of(D64) != 16 || $offset_of(D64, b) != 8) { ret 13; }\n    var s: D16 = D16.b{9};\n    val ps: *u8 = (?s)::*u8;\n    if (ps[0] != 1 || ps[1] != 0 || ps[2] != 9 || ps[3] != 0) { ret 14; }\n    if (d16(s) != 9) { ret 15; }\n    var w: D64 = D64.c{[3]u8{1, 2, 3}};\n    val pw: *u8 = (?w)::*u8;\n    if (pw[0] != 2 || pw[7] != 0 || pw[8] != 1 || pw[10] != 3 || pw[11] != 0) { ret 16; }\n    if (d64(w) != 3) { ret 17; }\n    w = D64.b{5};\n    if (pw[0] != 1 || pw[8] != 5 || pw[9] != 0 || pw[10] != 0) { ret 18; }\n\n    var u: U;\n    u.b = 0x1122334455667788;\n    u.a = 0xFF;\n    var tu: TU = TU.u{u};\n    val pu: *u8 = (?tu)::*u8;\n    if (pu[8] != 0xFF || pu[9] != 0x77 || pu[15] != 0x11) { ret 19; }\n    if (ub(tu) != 0x11223344556677FF) { ret 20; }\n\n    # a replacement initializer reading the old payload through a pointer sees the old bytes\n    var o: Outer = Outer.inner{Reply.value{21}};\n    var q: *Reply = nil;\n    if (sel o.inner) { q = ?o.inner; }\n    o = Outer.inner{@q};\n    if (sel o.inner) { if (take(o.inner) != 21) { ret 21; } } or { ret 21; }\n    var r: Reply = Reply.value{22};\n    val pr: *Reply = ?r;\n    r = Reply.value{take(@pr) + 1};\n    if (take(r) != 23) { ret 22; }\n    # omitted tag field of a runtime record literal is zero\n    var bx: Box = Box{n: 1};\n    if (take(bx.r) != -1) { ret 23; }\n    val pbx: *u8 = (?bx)::*u8;\n    i = 8;\n    for (i < 24) { if (pbx[i] != 0) { ret 24; } i = i + 1; }\n    ret 0;\n}\n";
}

# a packed record holding a natural tag and a packed `u32` tag, and 65-byte packed tag copies through arrays and globals
#[testing]
fun tag_packed_record_program() str {
    ret "tag Reply: u8 { empty; value: i64; }\n#[packed]\ntag Q4: u32 { empty; value: u32; }\n#[packed]\ntag PB: u8 { empty; buf: [64]u8; }\n#[packed]\nrec W { c: u8; r: Reply; q: Q4; }\nrec Wrap { c: u8; w: W; }\n\nvar garr: [3]PB;\n\n#[noinline] fun fill(n: u8) [64]u8 { var a: [64]u8; var i: u64 = 0; for (i < 64) { a[i] = n + i::u8; i = i + 1; } ret a; }\n#[noinline] fun take(r: Reply) i64 { if (sel r.value) { ret r.value; } ret -1; }\n#[noinline] fun q4(q: Q4) u32 { if (sel q.value) { ret q.value; } ret 0xFFFF; }\n#[noinline] fun pb(p: PB) u32 { if (sel p.buf) { ret p.buf[0]::u32 + p.buf[63]::u32; } ret 0xFFFF; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if ($size_of(W) != 1 + 16 + 8 || $offset_of(W, r) != 1 || $offset_of(W, q) != 17) { ret 1; }\n    var w: W;\n    if (take(w.r) != -1 || q4(w.q) != 0xFFFF) { ret 2; }\n    w.r = Reply.value{0x0102030405060708};\n    if (take(w.r) != 0x0102030405060708) { ret 3; }\n    if (sel w.r.value) { w.r.value = w.r.value + 1; }\n    if (take(w.r) != 0x0102030405060709) { ret 4; }\n    w.q = Q4.value{0xDEADBEEF};\n    if (sel w.q.value && w.q.value != 0xDEADBEEF) { ret 5; }\n    if (sel w.q.value) { w.q.value = 0xCAFEBABE; }\n    if (q4(w.q) != 0xCAFEBABE) { ret 6; }\n    val pw: *u8 = (?w)::*u8;\n    if (pw[1] != 1 || pw[9] != 0x09 || pw[16] != 0x01 || pw[17] != 1 || pw[21] != 0xBE || pw[24] != 0xCA) { ret 7; }\n    var wrap: Wrap = Wrap{c: 1, w: w};\n    if (take(wrap.w.r) != 0x0102030405060709 || q4(wrap.w.q) != 0xCAFEBABE) { ret 8; }\n    val wc: W = wrap.w;\n    if (take(wc.r) != 0x0102030405060709) { ret 9; }\n    wrap.w.r = Reply.empty{};\n    if (take(wrap.w.r) != -1) { ret 10; }\n    var i: u64 = 0;\n    val pwr: *u8 = (?wrap.w)::*u8;\n    i = 1;\n    for (i < 17) { if (pwr[i] != 0) { ret 11; } i = i + 1; }\n\n    var a: [3]PB;\n    if ($size_of(PB) != 65 || (?a[1])::u64 - (?a[0])::u64 != 65) { ret 12; }\n    a[1] = PB.buf{fill(0x10)};\n    if (pb(a[1]) != 0x10 + 0x4F) { ret 13; }\n    a[2] = a[1];\n    a[0] = a[2];\n    if (pb(a[0]) != 0x10 + 0x4F) { ret 14; }\n    garr = a;\n    if (pb(garr[0]) != 0x10 + 0x4F || pb(garr[2]) != 0x10 + 0x4F) { ret 15; }\n    val pa: *u8 = (?a)::*u8;\n    if (pa[0] != 1 || pa[1] != 0x10 || pa[64] != 0x4F || pa[65] != 1 || pa[66] != 0x10 || pa[129] != 0x4F) { ret 16; }\n    a[2] = PB.empty{};\n    i = 130;\n    for (i < 195) { if (pa[i] != 0) { ret 17; } i = i + 1; }\n    if (sel a[0].buf) { a[0].buf[63] = 1; }\n    if (pb(a[0]) != 0x11) { ret 18; }\n    ret 0;\n}\n";
}

# transport extents: every carrier class on a poisoned stack, the callee never reads carrier padding as payload,
# a returned carrier never writes beyond the logical object, and gap/suffix/tail bytes are zero after the round trip
#[testing]
fun tag_extents_program() str {
    ret "tag P1: u8 { a; b; }\ntag T3: u8 { a; b: [2]u8; }\ntag T9: u8 { a; b: [8]u8; }\ntag S4: u8 { a; b: u16; }\ntag Nest: u8 { a; b: S4; }\n#[packed]\ntag PK9: u8 { a; b: u64; }\n#[align(16)]\ntag AL16: u8 { a; b: u8; }\ntag TF: u8 { a; b: f64; }\ntag TFM: u8 { a; b: f64; c: i64; }\ntag Mid: u8 { a; b: [3]u8; c: [10]u8; }\n#[packed]\nrec Cell { lo: u8; t: T3; hi: u8; }\nrec Row { lo: u8; t: T9; hi: u8; }\n\n#[noinline] fun byte_at(p: *u8, i: u64) u8 { ret p[i]; }\n#[noinline] fun sink(p: *u8) u8 { ret p[0]; }\n# dirties the stack region a following callee's frame and its carrier homes will occupy\n#[noinline] fun dirty() u8 { var junk: [2048]u8; var i: u64 = 0; for (i < 2048) { junk[i] = 0xAA; i = i + 1; } ret sink(?junk[0]); }\n#[noinline] fun zeros_from(p: *u8, from: u64, to: u64) u8 { var i: u64 = from; for (i < to) { if (p[i] != 0) { ret 0; } i = i + 1; } ret 1; }\n\n#[noinline] fun mk_p1(x: u8) P1 { if (x == 0) { ret P1.a{}; } ret P1.b{}; }\n#[noinline] fun mk_t3(x: u8) T3 { var a: [2]u8; a[0] = x; a[1] = x + 1; ret T3.b{a}; }\n#[noinline] fun mk_t9(x: u8) T9 { var a: [8]u8; a[0] = x; a[7] = x + 1; ret T9.b{a}; }\n#[noinline] fun mk_s4(x: u16) S4 { ret S4.b{x}; }\n#[noinline] fun mk_nest(x: u16) Nest { ret Nest.b{mk_s4(x)}; }\n#[noinline] fun mk_pk9(x: u64) PK9 { ret PK9.b{x}; }\n#[noinline] fun mk_al16(x: u8) AL16 { ret AL16.b{x}; }\n#[noinline] fun mk_tf(x: f64) TF { ret TF.b{x}; }\n#[noinline] fun mk_tfm(x: i64) TFM { ret TFM.c{x}; }\n#[noinline] fun mk_mid(x: u8) Mid { var a: [3]u8; a[0] = x; a[2] = x + 2; ret Mid.b{a}; }\n\n# callee-side checks: the carrier's padding never becomes payload, and a copy of the parameter keeps its zero suffix\n#[noinline] fun t_p1(v: P1) u8 { if (sel v.b) { ret 1; } ret 0; }\n#[noinline] fun t_t3(v: T3) u8 { val c: T3 = v; if (sel c.b) { ret c.b[0] + c.b[1]; } ret 0xFF; }\n#[noinline] fun t_t9(v: T9) u8 { val c: T9 = v; val p: *u8 = (?c)::*u8; if (byte_at(p, 0) != 1) { ret 0xFE; } if (sel c.b) { ret c.b[0] + c.b[7]; } ret 0xFF; }\n#[noinline] fun t_s4(v: S4) u16 { val p: *u8 = (?v)::*u8; if (byte_at(p, 1) != 0) { ret 0xFFFE; } if (sel v.b) { ret v.b; } ret 0xFFFF; }\n#[noinline] fun t_nest(v: Nest) u16 { val p: *u8 = (?v)::*u8; if (byte_at(p, 1) != 0 || byte_at(p, 3) != 0) { ret 0xFFFE; } if (sel v.b) { ret t_s4(v.b); } ret 0xFFFF; }\n#[noinline] fun t_pk9(v: PK9) u64 { val c: PK9 = v; if (sel c.b) { ret c.b; } ret 0; }\n#[noinline] fun t_al16(v: AL16) u8 { val p: *u8 = (?v)::*u8; if (zeros_from(p, 2, 16) == 0) { ret 0xFE; } val c: AL16 = v; val q: *u8 = (?c)::*u8; if (zeros_from(q, 2, 16) == 0) { ret 0xFD; } if (sel c.b) { ret c.b; } ret 0xFF; }\n#[noinline] fun t_tf(v: TF) f64 { val p: *u8 = (?v)::*u8; if (zeros_from(p, 1, 8) == 0) { ret -2.0; } if (sel v.b) { ret v.b; } ret -1.0; }\n#[noinline] fun t_tfm(v: TFM) i64 { val p: *u8 = (?v)::*u8; if (zeros_from(p, 1, 8) == 0) { ret -2; } if (sel v.c) { ret v.c; } ret -1; }\n#[noinline] fun t_mid(v: Mid) u8 { val p: *u8 = (?v)::*u8; if (zeros_from(p, 4, 11) == 0) { ret 0xFE; } if (sel v.b) { ret v.b[0] + v.b[2]; } ret 0xFF; }\n#[noinline] fun many9(a: T9, b: T9, c: T9, d: T9, e: T9, f: T9, g: T9, h: T9, i: T9) u64 { ret t_t9(a)::u64 + t_t9(b)::u64 + t_t9(c)::u64 + t_t9(d)::u64 + t_t9(e)::u64 + t_t9(f)::u64 + t_t9(g)::u64 + t_t9(h)::u64 + t_t9(i)::u64; }\n#[noinline] fun many_al(a: AL16, b: AL16, c: AL16, d: AL16, e: AL16, f: AL16, g: AL16, h: AL16, i: AL16) u64 { ret t_al16(a)::u64 + t_al16(b)::u64 + t_al16(c)::u64 + t_al16(d)::u64 + t_al16(e)::u64 + t_al16(f)::u64 + t_al16(g)::u64 + t_al16(h)::u64 + t_al16(i)::u64; }\n#[noinline] fun after_al(a: AL16, next: i64) i64 { if (sel a.b) { ret a.b::i64 + next; } ret -1; }\n#[noinline] fun al_after(first: i64, a: AL16, next: i64) i64 { if (sel a.b) { ret a.b::i64 + next + first; } ret -1; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if ($size_of(T3) != 3 || $size_of(T9) != 9 || $size_of(S4) != 4 || $size_of(Nest) != 6 || $size_of(PK9) != 9 || $size_of(AL16) != 16 || $align_of(AL16) != 16 || $size_of(TF) != 16 || $size_of(Mid) != 11) { ret 100; }\n    # round trips through carriers wider than the object, on a poisoned stack\n    dirty();\n    if (t_p1(mk_p1(0)) != 0 || t_p1(mk_p1(1)) != 1) { ret 1; }\n    dirty();\n    if (t_t3(mk_t3(3)) != 7) { ret 2; }\n    dirty();\n    if (t_t9(mk_t9(4)) != 9) { ret 3; }\n    dirty();\n    if (t_s4(mk_s4(0x1234)) != 0x1234) { ret 4; }\n    dirty();\n    if (t_nest(mk_nest(0x0506)) != 0x0506) { ret 5; }\n    dirty();\n    if (t_pk9(mk_pk9(0x1122334455667788)) != 0x1122334455667788) { ret 6; }\n    dirty();\n    if (t_al16(mk_al16(9)) != 9) { ret 7; }\n    dirty();\n    if (t_tf(mk_tf(2.5)) != 2.5) { ret 8; }\n    dirty();\n    if (t_tfm(mk_tfm(-77)) != -77) { ret 9; }\n    dirty();\n    if (t_mid(mk_mid(1)) != 4) { ret 10; }\n    dirty();\n    if (many9(mk_t9(1), mk_t9(2), mk_t9(3), mk_t9(4), mk_t9(5), mk_t9(6), mk_t9(7), mk_t9(8), mk_t9(9)) != 99) { ret 11; }\n    dirty();\n    if (many_al(mk_al16(1), mk_al16(2), mk_al16(3), mk_al16(4), mk_al16(5), mk_al16(6), mk_al16(7), mk_al16(8), mk_al16(9)) != 45) { ret 12; }\n    # the argument after an over-aligned tag lands where the convention puts it\n    if (after_al(mk_al16(3), 40) != 43 || al_after(100, mk_al16(3), 40) != 143) { ret 13; }\n    # storing a returned carrier never writes beyond the logical object\n    var cell: Cell;\n    cell.lo = 0x5A; cell.hi = 0xA5;\n    dirty();\n    cell.t = mk_t3(1);\n    if (cell.lo != 0x5A || cell.hi != 0xA5 || t_t3(cell.t) != 3) { ret 20; }\n    var row: Row;\n    row.lo = 0x5A; row.hi = 0xA5;\n    dirty();\n    row.t = mk_t9(1);\n    if (row.lo != 0x5A || row.hi != 0xA5 || t_t9(row.t) != 3) { ret 21; }\n    var arr: [3]T9;\n    val pa: *u8 = (?arr)::*u8;\n    var i: u64 = 0;\n    for (i < 27) { pa[i] = 0xCC; i = i + 1; }\n    dirty();\n    arr[1] = mk_t9(2);\n    if (byte_at(pa, 8) != 0xCC || byte_at(pa, 18) != 0xCC || byte_at(pa, 9) != 1 || t_t9(arr[1]) != 5) { ret 22; }\n    var cells: [3]T3;\n    val pc: *u8 = (?cells)::*u8;\n    i = 0;\n    for (i < 9) { pc[i] = 0xCC; i = i + 1; }\n    dirty();\n    cells[1] = mk_t3(2);\n    if (byte_at(pc, 2) != 0xCC || byte_at(pc, 6) != 0xCC || byte_at(pc, 3) != 1 || byte_at(pc, 4) != 2 || byte_at(pc, 5) != 3) { ret 23; }\n    # the inactive suffix and padding of a returned object are zero after the round trip\n    dirty();\n    var s: S4 = mk_s4(7);\n    val ps: *u8 = (?s)::*u8;\n    if (byte_at(ps, 1) != 0) { ret 30; }\n    dirty();\n    var n: Nest = mk_nest(8);\n    val pn: *u8 = (?n)::*u8;\n    if (byte_at(pn, 1) != 0 || byte_at(pn, 3) != 0) { ret 31; }\n    dirty();\n    var al: AL16 = mk_al16(1);\n    if (zeros_from((?al)::*u8, 2, 16) == 0) { ret 32; }\n    dirty();\n    var tf: TF = mk_tf(1.0);\n    if (zeros_from((?tf)::*u8, 1, 8) == 0) { ret 33; }\n    dirty();\n    var m: Mid = mk_mid(0);\n    if (zeros_from((?m)::*u8, 4, 11) == 0) { ret 34; }\n    dirty();\n    var p: P1 = mk_p1(0);\n    if (byte_at((?p)::*u8, 0) != 0) { ret 35; }\n    ret 0;\n}\n";
}

# the C half of the transport controls: each struct is the C spelling of a tag of matching layout
#[testing]
fun tag_c_probe() str {
    ret "/* C half of the tag transport controls. Each struct is the C\n * spelling of a mach tag of matching layout: the discriminator first, then a union of\n * the payloads at the tag's common payload offset. A tag's payload area is a union even\n * with one payload case, which is what keeps every convention from flattening a float\n * payload into the float registers. Compiled at -O0 so every field read really happens. */\n/* the MSVC-target compiler marks floating-point use with this symbol; nothing links a C runtime here */\n#ifdef _WIN32\nint _fltused = 0;\n#endif\n\nstruct p1 { unsigned char d; };\nstruct t3 { unsigned char d; union { unsigned char p[2]; } u; };\nstruct s8 { unsigned char d; union { unsigned int p; } u; };\nstruct t9 { unsigned char d; union { unsigned char p[8]; } u; };\nstruct t16 { unsigned char d; union { long long p; } u; };\nstruct o24 { unsigned char d; union { long long p[2]; unsigned char q; } u; };\nstruct nest { unsigned char d; union { struct s8 p; } u; };\nstruct al16 { unsigned char d; union { unsigned char p; } u; } __attribute__((aligned(16)));\nstruct tf { unsigned char d; union { double p; } u; };\nstruct tf8 { unsigned char d; union { float p; } u; };\nstruct tfm { unsigned char d; union { double p; long long q; } u; };\n/* packed shapes: pk9 holds its payload union at an offset the union's alignment does not divide (System V\n * MEMORY class, as for the packed record), pka packs an 8-byte discriminator ahead of a payload that sits\n * aligned anyway */\n#pragma pack(push, 1)\nstruct pk9 { unsigned char d; union { long long p; } u; };\nstruct pka { unsigned long long d; union { long long p; } u; };\n#pragma pack(pop)\n\nlong long c_p1(struct p1 v, long long next) { return v.d * 100 + next; }\nlong long c_t3(struct t3 v, long long next) { return v.d * 100 + v.u.p[0] + v.u.p[1] * 10 + next * 1000; }\nlong long c_s8(struct s8 v, long long next) { return v.d * 100 + (long long)v.u.p + next * 1000000; }\nlong long c_t9(struct t9 v, long long next) { return v.d * 100 + v.u.p[0] + v.u.p[7] * 10 + next * 1000; }\nlong long c_t16(struct t16 v, long long next) { return v.d * 100 + v.u.p + next * 1000000; }\nlong long c_o24(struct o24 v, long long next) { return v.d * 100 + v.u.p[0] + v.u.p[1] * 10 + next * 1000; }\nlong long c_nest(struct nest v, long long next) { return v.d * 100 + v.u.p.d * 10 + (long long)v.u.p.u.p + next * 1000000; }\nlong long c_al16(struct al16 v, long long next) { return v.d * 100 + v.u.p + next * 1000; }\nlong long c_al16_after(long long first, struct al16 v, long long next) { return first + v.d * 100 + v.u.p + next * 1000; }\nlong long c_tf(struct tf v, long long next) { return v.d * 100 + (long long)v.u.p + next * 1000; }\nlong long c_tf8(struct tf8 v, long long next) { return v.d * 100 + (long long)v.u.p + next * 1000; }\nlong long c_tfm(struct tfm v, long long next) { return v.d * 100 + v.u.q + next * 1000; }\nlong long c_pk9(struct pk9 v, long long next) { return v.d * 100 + v.u.p + next * 1000000; }\nlong long c_pka(struct pka v, long long next) { return (long long)v.d * 100 + v.u.p + next * 1000000; }\n\nstruct p1 c_mk_p1(unsigned char d) { struct p1 r; r.d = d; return r; }\nstruct t3 c_mk_t3(unsigned char x) { struct t3 r; r.d = 1; r.u.p[0] = x; r.u.p[1] = x + 1; return r; }\nstruct s8 c_mk_s8(unsigned int x) { struct s8 r; r.d = 1; r.u.p = x; return r; }\nstruct t9 c_mk_t9(unsigned char x) { struct t9 r; r.d = 1; r.u.p[0] = x; r.u.p[7] = x + 1; return r; }\nstruct t16 c_mk_t16(long long x) { struct t16 r; r.d = 1; r.u.p = x; return r; }\nstruct o24 c_mk_o24(long long x) { struct o24 r; r.d = 1; r.u.p[0] = x; r.u.p[1] = x + 1; return r; }\nstruct nest c_mk_nest(unsigned int x) { struct nest r; r.d = 1; r.u.p.d = 1; r.u.p.u.p = x; return r; }\nstruct al16 c_mk_al16(unsigned char x) { struct al16 r; r.d = 1; r.u.p = x; return r; }\nstruct tf c_mk_tf(double x) { struct tf r; r.d = 1; r.u.p = x; return r; }\nstruct tf8 c_mk_tf8(float x) { struct tf8 r; r.d = 1; r.u.p = x; return r; }\nstruct tfm c_mk_tfm(long long x) { struct tfm r; r.d = 2; r.u.q = x; return r; }\nstruct pk9 c_mk_pk9(long long x) { struct pk9 r; r.d = 1; r.u.p = x; return r; }\nstruct pka c_mk_pka(long long x) { struct pka r; r.d = 1; r.u.p = x; return r; }\n\n/* the reverse direction: C calls mach with the same shapes */\nlong long m_t3(struct t3 v, long long next);\nlong long m_t9(struct t9 v, long long next);\nlong long m_al16(struct al16 v, long long next);\nlong long m_al16_after(long long first, struct al16 v, long long next);\nlong long m_tf(struct tf v, long long next);\nlong long m_o24(struct o24 v, long long next);\nstruct t9 m_mk_t9(unsigned char x);\nstruct al16 m_mk_al16(unsigned char x);\nstruct tf m_mk_tf(double x);\nstruct t3 m_mk_t3(unsigned char x);\nlong long m_pk9(struct pk9 v, long long next);\nlong long m_pka(struct pka v, long long next);\nstruct pk9 m_mk_pk9(long long x);\nstruct pka m_mk_pka(long long x);\n\nlong long c_drives_mach(void) {\n    struct t3 a = c_mk_t3(4);\n    struct t9 b = c_mk_t9(5);\n    struct al16 c = c_mk_al16(6);\n    struct tf d = c_mk_tf(7.5);\n    struct o24 e = c_mk_o24(8);\n    if (m_t3(a, 1) != 100 + 4 + 50 + 1000) return 1;\n    if (m_t9(b, 2) != 100 + 5 + 60 + 2000) return 2;\n    if (m_al16(c, 3) != 100 + 6 + 3000) return 3;\n    if (m_al16_after(9, c, 3) != 9 + 100 + 6 + 3000) return 4;\n    if (m_tf(d, 4) != 100 + 7 + 4000) return 5;\n    if (m_o24(e, 5) != 100 + 8 + 90 + 5000) return 6;\n    struct t9 rb = m_mk_t9(11);\n    if (rb.d != 1 || rb.u.p[0] != 11 || rb.u.p[7] != 12) return 7;\n    struct al16 rc = m_mk_al16(13);\n    if (rc.d != 1 || rc.u.p != 13) return 8;\n    struct tf rd = m_mk_tf(14.5);\n    if (rd.d != 1 || rd.u.p != 14.5) return 9;\n    struct t3 ra = m_mk_t3(15);\n    if (ra.d != 1 || ra.u.p[0] != 15 || ra.u.p[1] != 16) return 10;\n    struct pk9 g = c_mk_pk9(-5000000000LL);\n    struct pka h = c_mk_pka(21);\n    if (m_pk9(g, 7) != 100 - 5000000000LL + 7000000) return 11;\n    if (m_pka(h, 8) != 100 + 21 + 8000000) return 12;\n    struct pk9 rg = m_mk_pk9(-6000000000LL);\n    if (rg.d != 1 || rg.u.p != -6000000000LL) return 13;\n    struct pka rh = m_mk_pka(22);\n    if (rh.d != 1 || rh.u.p != 22) return 14;\n    return 0;\n}\n";
}

# compiles the probe for the target a build step is producing; no libc headers are needed
#[testing]
fun tag_cc_script() str {
    ret "#!/bin/sh\n# compiles the C half for the target the mach step is building; no libc headers are needed\nset -eu\ncase \"$MACH_TARGET_ISA-$MACH_TARGET_OS\" in\n    x86_64-linux)  clang -c -O0 -fno-stack-protector probe.c -o \"$1\" ;;\n    aarch64-linux) clang -target aarch64-linux-gnu -c -O0 -fno-stack-protector probe.c -o \"$1\" ;;\n    riscv64-linux) clang -target riscv64-linux-gnu -march=rv64gc -mabi=lp64d -mno-relax -fno-asynchronous-unwind-tables -fno-unwind-tables -fno-jump-tables -c -O0 -fno-stack-protector probe.c -o \"$1\" ;;\n    x86_64-windows) clang -target x86_64-pc-windows-msvc -c -O0 -fno-stack-protector -fno-asynchronous-unwind-tables -fno-unwind-tables probe.c -o \"$1\" ;;\n    *) echo \"cc-probe.sh: no toolchain rule for $MACH_TARGET_ISA-$MACH_TARGET_OS\" >&2; exit 1 ;;\nesac\n";
}

# a manifest for the C controls: the bin `tagabi` on the four targets they run on, its C half compiled by a step
#[testing]
fun tag_c_manifest() str {
    ret "[project]\nmach = \">=5\"\nid = \"tagabi\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.linux-x86_64]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.linux-arm64]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n\n[target.linux-riscv64]\nisa = \"riscv64\"\nos = \"linux\"\nabi = \"lp64d\"\n\n[target.windows-x86_64]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[step.probe]\nargv = [\"sh\", \"cc-probe.sh\", \"{project.work}/obj/probe.o\"]\nenv = { MACH_TARGET_ISA = \"{target.isa}\", MACH_TARGET_OS = \"{target.os}\" }\nin = [\"probe.c\", \"cc-probe.sh\"]\nout = [\"{project.work}/obj/probe.o\"]\nneed = []\n\n[link.probe]\nsource = \"local\"\npath = \"{project.work}/obj/probe.o\"\nos = [\"*\"]\nisa = [\"*\"]\nabi = [\"*\"]\nexport = false\n\n[artifact.tagabi]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/tagabi\"\ntargets = [\"*\"]\nlink = [\"probe\"]\nneed = []\n\n[profile.debug]\noptimize = false\ndebug = false\nsimd = \"scalarize\"\ndefault = true\n\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
}

# mach calls C with every shape and reads every shape back, then C calls mach with the same shapes
#[testing]
fun tag_c_program() str {
    ret "tag P1: u8 { a; b; }\ntag T3: u8 { a; b: [2]u8; }\ntag S8: u8 { a; b: u32; }\ntag T9: u8 { a; b: [8]u8; }\ntag T16: u8 { a; b: i64; }\ntag O24: u8 { a; b: [2]i64; c: u8; }\ntag Nest: u8 { a; b: S8; }\n#[align(16)]\ntag AL16: u8 { a; b: u8; }\ntag TF: u8 { a; b: f64; }\ntag TF8: u8 { a; b: f32; }\ntag TFM: u8 { a; b: f64; c: i64; }\n#[packed]\ntag PK9: u8 { a; b: i64; }\n#[packed]\ntag PKA: u64 { a; b: i64; }\n\next fun c_p1(v: P1, next: i64) i64;\next fun c_t3(v: T3, next: i64) i64;\next fun c_s8(v: S8, next: i64) i64;\next fun c_t9(v: T9, next: i64) i64;\next fun c_t16(v: T16, next: i64) i64;\next fun c_o24(v: O24, next: i64) i64;\next fun c_nest(v: Nest, next: i64) i64;\next fun c_al16(v: AL16, next: i64) i64;\next fun c_al16_after(first: i64, v: AL16, next: i64) i64;\next fun c_tf(v: TF, next: i64) i64;\next fun c_tf8(v: TF8, next: i64) i64;\next fun c_tfm(v: TFM, next: i64) i64;\next fun c_mk_p1(d: u8) P1;\next fun c_mk_t3(x: u8) T3;\next fun c_mk_s8(x: u32) S8;\next fun c_mk_t9(x: u8) T9;\next fun c_mk_t16(x: i64) T16;\next fun c_mk_o24(x: i64) O24;\next fun c_mk_nest(x: u32) Nest;\next fun c_mk_al16(x: u8) AL16;\next fun c_mk_tf(x: f64) TF;\next fun c_mk_tf8(x: f32) TF8;\next fun c_mk_tfm(x: i64) TFM;\next fun c_pk9(v: PK9, next: i64) i64;\next fun c_pka(v: PKA, next: i64) i64;\next fun c_mk_pk9(x: i64) PK9;\next fun c_mk_pka(x: i64) PKA;\next fun c_drives_mach() i64;\n\n#[symbol(\"m_t3\")] pub fun m_t3(v: T3, next: i64) i64 { if (sel v.b) { ret 100 + v.b[0]::i64 + v.b[1]::i64 * 10 + next * 1000; } ret -1; }\n#[symbol(\"m_t9\")] pub fun m_t9(v: T9, next: i64) i64 { if (sel v.b) { ret 100 + v.b[0]::i64 + v.b[7]::i64 * 10 + next * 1000; } ret -1; }\n#[symbol(\"m_al16\")] pub fun m_al16(v: AL16, next: i64) i64 { if (sel v.b) { ret 100 + v.b::i64 + next * 1000; } ret -1; }\n#[symbol(\"m_al16_after\")] pub fun m_al16_after(first: i64, v: AL16, next: i64) i64 { if (sel v.b) { ret first + 100 + v.b::i64 + next * 1000; } ret -1; }\n#[symbol(\"m_tf\")] pub fun m_tf(v: TF, next: i64) i64 { if (sel v.b) { ret 100 + v.b::i64 + next * 1000; } ret -1; }\n#[symbol(\"m_o24\")] pub fun m_o24(v: O24, next: i64) i64 { if (sel v.b) { ret 100 + v.b[0] + v.b[1] * 10 + next * 1000; } ret -1; }\n#[symbol(\"m_mk_t9\")] pub fun m_mk_t9(x: u8) T9 { var a: [8]u8; a[0] = x; a[7] = x + 1; ret T9.b{a}; }\n#[symbol(\"m_mk_al16\")] pub fun m_mk_al16(x: u8) AL16 { ret AL16.b{x}; }\n#[symbol(\"m_mk_tf\")] pub fun m_mk_tf(x: f64) TF { ret TF.b{x}; }\n#[symbol(\"m_mk_t3\")] pub fun m_mk_t3(x: u8) T3 { var a: [2]u8; a[0] = x; a[1] = x + 1; ret T3.b{a}; }\n#[symbol(\"m_pk9\")] pub fun m_pk9(v: PK9, next: i64) i64 { if (sel v.b) { ret 100 + v.b + next * 1000000; } ret -1; }\n#[symbol(\"m_pka\")] pub fun m_pka(v: PKA, next: i64) i64 { if (sel v.b) { ret 100 + v.b + next * 1000000; } ret -1; }\n#[symbol(\"m_mk_pk9\")] pub fun m_mk_pk9(x: i64) PK9 { ret PK9.b{x}; }\n#[symbol(\"m_mk_pka\")] pub fun m_mk_pka(x: i64) PKA { ret PKA.b{x}; }\n\n#[noinline] fun zeros_from(p: *u8, from: u64, to: u64) u8 { var i: u64 = from; for (i < to) { if (p[i] != 0) { ret 0; } i = i + 1; } ret 1; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    # mach calls C: the callee reads the discriminator, the payload and the argument after the tag\n    if (c_p1(P1.b{}, 7) != 107) { ret 1; }\n    var a3: [2]u8; a3[0] = 4; a3[1] = 5;\n    if (c_t3(T3.b{a3}, 1) != 1154) { ret 2; }\n    if (c_s8(S8.b{9}, 2) != 2000109) { ret 3; }\n    var a9: [8]u8; a9[0] = 5; a9[7] = 6;\n    if (c_t9(T9.b{a9}, 2) != 2165) { ret 4; }\n    if (c_t16(T16.b{-3}, 3) != 3000097) { ret 5; }\n    var a24: [2]i64; a24[0] = 8; a24[1] = 9;\n    if (c_o24(O24.b{a24}, 5) != 5198) { ret 6; }\n    if (c_nest(Nest.b{S8.b{6}}, 4) != 4000116) { ret 7; }\n    if (c_al16(AL16.b{6}, 3) != 3106) { ret 8; }\n    if (c_al16_after(9, AL16.b{6}, 3) != 3115) { ret 9; }\n    if (c_tf(TF.b{7.5}, 4) != 4107) { ret 10; }\n    if (c_tf8(TF8.b{2.5}, 1) != 1102) { ret 11; }\n    if (c_tfm(TFM.c{-9}, 2) != 2191) { ret 12; }\n    if (c_pk9(PK9.b{-5000000000}, 8) != -4991999900) { ret 13; }\n    if (c_pka(PKA.b{21}, 9) != 9000121) { ret 14; }\n    # C returns to mach: the discriminator and payload arrive, and the logical object holds nothing else\n    val r1: P1 = c_mk_p1(1);\n    if (!sel r1.b) { ret 20; }\n    val r3: T3 = c_mk_t3(4);\n    if (!sel r3.b) { ret 21; } if (r3.b[0] != 4 || r3.b[1] != 5) { ret 22; }\n    val r8: S8 = c_mk_s8(0x01020304);\n    if (!sel r8.b) { ret 23; } if (r8.b != 0x01020304) { ret 24; }\n    val r9: T9 = c_mk_t9(7);\n    if (!sel r9.b) { ret 25; } if (r9.b[0] != 7 || r9.b[7] != 8) { ret 26; }\n    val r16: T16 = c_mk_t16(-11);\n    if (!sel r16.b) { ret 27; } if (r16.b != -11) { ret 28; }\n    val r24: O24 = c_mk_o24(12);\n    if (!sel r24.b) { ret 29; } if (r24.b[0] != 12 || r24.b[1] != 13) { ret 30; }\n    val rn: Nest = c_mk_nest(14);\n    if (!sel rn.b) { ret 31; } if (!sel rn.b.b) { ret 32; } if (rn.b.b != 14) { ret 33; }\n    val ral: AL16 = c_mk_al16(15);\n    if (!sel ral.b) { ret 34; } if (ral.b != 15) { ret 35; }\n    val rtf: TF = c_mk_tf(16.5);\n    if (!sel rtf.b) { ret 36; } if (rtf.b != 16.5) { ret 37; }\n    val rtf8: TF8 = c_mk_tf8(2.5);\n    if (!sel rtf8.b) { ret 38; } if (rtf8.b != 2.5) { ret 39; }\n    val rtfm: TFM = c_mk_tfm(-17);\n    if (!sel rtfm.c) { ret 40; } if (rtfm.c != -17) { ret 41; }\n    val rpk9: PK9 = c_mk_pk9(-6000000000);\n    if (!sel rpk9.b) { ret 42; } if (rpk9.b != -6000000000) { ret 43; }\n    val rpka: PKA = c_mk_pka(22);\n    if (!sel rpka.b) { ret 44; } if (rpka.b != 22) { ret 45; }\n    # C calls mach with the same shapes, and reads what mach returns\n    val cd: i64 = c_drives_mach();\n    if (cd != 0) { ret 50 + cd; }\n    ret 0;\n}\n\n$if ($mach.build.os == $mach.os.windows) {\n    #[symbol(\"mainCRTStartup\")]\n    pub fun start() i32 { ret main(1)::i32; }\n}\n$or {\n    #[symbol(\"_start\")]\n    pub fun start() {\n        $if ($mach.build.arch == $mach.arch.x86_64) {\n            asm x86_64 {\n                mov rdi, [rsp]\n                and rsp, -16\n                call main\n                mov rdi, rax\n                mov rax, 60\n                syscall\n            }\n        }\n        $or ($mach.build.arch == $mach.arch.aarch64) {\n            asm aarch64 {\n                ldr x0, [sp]\n                bl main\n                mov x8, 93\n                svc 0\n            }\n        }\n        $or {\n            asm riscv64 {\n                ld a0, 0(sp)\n                call main\n                li a7, 93\n                ecall\n            }\n        }\n    }\n    \n    \n}\n";
}

# comptime-constructed tag values (folded globals) against runtime constructions, byte for byte, including inside generic instantiations
#[testing]
fun tag_agreement_program() str {
    ret "tag Reply: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec Pair { a: u32; b: u64; }\ntag Zero: u8 { first: i64; second; }\nrec ZRec { a: u32; t: Zero; }\ntag Multi: u16 { a; b: u8; c: Pair; d: Reply; }\n\nval g_zrec: ZRec = ZRec{a: 1};\nval g_zero: Zero = g_zrec.t;\nval g_reply: Reply = Reply.value{42};\nval g_empty: Reply = Reply.empty{};\nval g_box: Box[u32] = Box[u32].some{7};\nval g_boxp: Box[Pair] = Box[Pair].some{Pair{a: 1, b: 2}};\nval g_multi_c: Multi = Multi.c{Pair{a: 3, b: 4}};\nval g_multi_d: Multi = Multi.d{Reply.value{5}};\nval g_multi_b: Multi = Multi.b{9};\n\n#[noinline] fun same(a: *u8, b: *u8, n: u64) u8 { var i: u64 = 0; for (i < n) { if (a[i] != b[i]) { ret 0; } i = i + 1; } ret 1; }\n#[noinline] fun mk_reply(v: i64) Reply { ret Reply.value{v}; }\n#[noinline] fun build[T](x: T) Box[T] { $each c in $cases(Box[T]) { $if (c.has_payload) { ret Box[T].[c]{x}; } } ret Box[T].none{}; }\n#[noinline] fun build_named[T](x: T) Box[T] { ret Box[T].some{x}; }\n#[noinline] fun code_of[T](v: T) u64 { $each c in $cases(T) { if (sel v.[c]) { ret c.code; } } ret 99; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    # a comptime-constructed global and a runtime construction of the same value are byte-identical\n    var r: Reply = mk_reply(42);\n    if (same((?g_reply)::*u8, (?r)::*u8, $size_of(Reply)) == 0) { ret 1; }\n    var e: Reply = Reply.empty{};\n    if (same((?g_empty)::*u8, (?e)::*u8, $size_of(Reply)) == 0) { ret 2; }\n    # inside a generic instantiation, through a descriptor and through the named case\n    var b: Box[u32] = build[u32](7);\n    if (same((?g_box)::*u8, (?b)::*u8, $size_of(Box[u32])) == 0) { ret 3; }\n    var b2: Box[u32] = build_named[u32](7);\n    if (same((?g_box)::*u8, (?b2)::*u8, $size_of(Box[u32])) == 0) { ret 4; }\n    var bp: Box[Pair] = build[Pair](Pair{a: 1, b: 2});\n    if (same((?g_boxp)::*u8, (?bp)::*u8, $size_of(Box[Pair])) == 0) { ret 5; }\n    # a u16 discriminator, a record payload and a nested tag payload\n    var mc: Multi = Multi.c{Pair{a: 3, b: 4}};\n    if (same((?g_multi_c)::*u8, (?mc)::*u8, $size_of(Multi)) == 0) { ret 6; }\n    var md: Multi = Multi.d{mk_reply(5)};\n    if (same((?g_multi_d)::*u8, (?md)::*u8, $size_of(Multi)) == 0) { ret 7; }\n    var mb: Multi = Multi.b{9};\n    if (same((?g_multi_b)::*u8, (?mb)::*u8, $size_of(Multi)) == 0) { ret 8; }\n    # the descriptor code is the stored discriminator on every case\n    if (code_of[Multi](g_multi_c) != 2 || code_of[Multi](g_multi_d) != 3 || code_of[Multi](g_multi_b) != 1) { ret 9; }\n    if (code_of[Reply](g_reply) != 1 || code_of[Reply](g_empty) != 0) { ret 10; }\n    if (code_of[Box[Pair]](g_boxp) != 1) { ret 11; }\n    val pm: *u8 = (?g_multi_d)::*u8;\n    if (pm[0] != 3 || pm[1] != 0) { ret 12; }\n    # `$cases` over a generic instantiation names the specialized payload type and its real offset\n    $each c in $cases(Box[Pair]) {\n        $if (c.has_payload) {\n            $if (c.type == Pair) {} $or { ret 13; }\n            if (c.offset != $offset_of(Box[Pair], some)) { ret 14; }\n            if (sel g_boxp.[c] && g_boxp.[c].b != 2) { ret 15; }\n        }\n    }\n    $each c in $cases(Box[u32]) { $if (c.has_payload) { $if (c.type == u32) {} $or { ret 16; } } }\n    # a tag a constant literal leaves out is its first case over a zero payload, as at runtime\n    var z: Zero;\n    if (sel g_zero.first) { if (g_zero.first != 0) { ret 91; } } or { ret 90; }\n    if (sel z.first) { if (z.first != 0) { ret 91; } } or { ret 90; }\n    if (same((?g_zero)::*u8, (?z)::*u8, $size_of(Zero)) == 0) { ret 92; }\n    ret 0;\n}\n";
}

# the failure tags written as ordinary tag declarations, every reflection item run over them and over the std spellings declared the same way
#[testing]
fun tag_failure_tags_program() str {
    ret "# the canonical failure types as ordinary tag declarations, with the contract's exact shapes\ntag Res[T, E]: u8 { err: E; ok: T; }\ntag Opt[T]: u8 { none; some: T; }\ntag Err[E]: u8 { err: E; ok; }\ntag ParseError: u8 { invalid; overflow; }\n\n#[noinline] fun strlen(p: *u8) u64 { var n: u64 = 0; for (p[n] != 0) { n = n + 1; } ret n; }\n\n# every reflection item over a user-declared shape; nothing here is compiler-known\n#[noinline]\nfun probe_res(r: Res[i64, ParseError]) i64 {\n    $each c in $cases(Res[i64, ParseError]) {\n        $if (c.has_payload) {\n            $if (c.type == i64) {\n                if (c.code != 1 || strlen(c.name) != 2 || c.offset != $offset_of(Res[i64, ParseError], ok)) { ret -100; }\n                if (sel r.[c]) { ret r.[c]; }\n            }\n            $or {\n                if (c.code != 0 || c.offset != $offset_of(Res[i64, ParseError], err)) { ret -101; }\n                if (sel r.[c]) { if (sel r.[c].overflow) { ret -2; } ret -1; }\n            }\n        }\n        $or { ret -102; }\n    }\n    ret -3;\n}\n\n#[noinline]\nfun probe_opt(o: Opt[u8]) i64 {\n    $each c in $cases(Opt[u8]) {\n        $if (c.has_payload) { if (sel o.[c]) { ret o.[c]::i64; } }\n        $or { if (sel o.[c]) { if (c.code != 0) { ret -100; } ret -1; } }\n    }\n    ret -3;\n}\n\n#[noinline]\nfun probe_err(e: Err[u32]) i64 {\n    $each c in $cases(Err[u32]) {\n        $if (c.has_payload) { if (sel e.[c]) { ret e.[c]::i64; } }\n        $or { if (sel e.[c]) { if (c.code != 1) { ret -100; } ret -1; } }\n    }\n    ret -3;\n}\n\n#[noinline] fun mk_ok[T, E](v: T) Res[T, E] { $each c in $cases(Res[T, E]) { $if (c.has_payload) { $if (c.type == T) { ret Res[T, E].[c]{v}; } } } var z: Res[T, E]; ret z; }\n#[noinline] fun mk_none[T]() Opt[T] { $each c in $cases(Opt[T]) { $if (c.has_payload) {} $or { ret Opt[T].[c]{}; } } var z: Opt[T]; ret z; }\n\n# the same walk over the lowercase std spellings, declared here exactly as std declares them\ntag res[T, E]: u8 { err: E; ok: T; } tag opt[T]: u8 { none; some: T; } tag err[E]: u8 { err: E; ok; }\n#[noinline]\nfun probe_canon(r: res[i64, u32], o: opt[u8], e: err[u32]) i64 {\n    $each c in $cases(res[i64, u32]) { $if (c.has_payload) { $if (c.type == i64) { if (c.code != 1) { ret -100; } if (sel r.[c] && r.[c] != 7) { ret -1; } } } }\n    $each c in $cases(opt[u8]) { $if (c.has_payload) { if (sel o.[c]) { o.[c] = 5; } } }\n    if (sel o.some && o.some != 5) { ret -2; }\n    $each c in $cases(err[u32]) { $if (c.has_payload) {} $or { if (!sel e.[c] || c.code != 1) { ret -3; } } }\n    $each c in $cases(opt[u8]) { $if (c.has_payload) { o = opt[u8].[c]{6}; } }\n    if (sel o.some && o.some != 6) { ret -4; }\n    if ($offset_of(opt[u8], some) != 1 || $offset_of(res[i64, u32], ok) != 8 || $offset_of(err[u32], err) != 4) { ret -5; }\n    ret 0;\n}\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    if ($size_of(Res[i64, ParseError]) != 16 || $align_of(Res[i64, ParseError]) != 8) { ret 1; }\n    if ($size_of(Opt[u8]) != 2 || $size_of(Err[u32]) != 8) { ret 2; }\n    var r: Res[i64, ParseError];\n    if (probe_res(r) != -1) { ret 3; }\n    r = Res[i64, ParseError].err{ParseError.overflow{}};\n    if (probe_res(r) != -2) { ret 4; }\n    r = mk_ok[i64, ParseError](40);\n    if (probe_res(r) != 40) { ret 5; }\n    var o: Opt[u8];\n    if (probe_opt(o) != -1) { ret 6; }\n    o = Opt[u8].some{9};\n    if (probe_opt(o) != 9) { ret 7; }\n    o = mk_none[u8]();\n    if (probe_opt(o) != -1) { ret 8; }\n    var e: Err[u32];\n    if (probe_err(e) != 0) { ret 9; }\n    e = Err[u32].ok{};\n    if (probe_err(e) != -1) { ret 10; }\n    e = Err[u32].err{3};\n    if (probe_err(e) != 3) { ret 11; }\n    var cr: res[i64, u32] = res[i64, u32].ok{7};\n    var co: opt[u8] = opt[u8].some{1};\n    var ce: err[u32] = err[u32].ok{};\n    if (probe_canon(cr, co, ce) != 0) { ret 12; }\n    ret 0;\n}\n";
}

# `sel` and the payload place through a pointer receiver: reads, writes, addresses, exiting chains,
# `&&`, a record field behind a pointer, nested tags and rebinding the pointer inside its guard
#[testing]
fun tag_autoderef_program() str {
    ret "tag Reply: u8 { empty; value: i64; }\ntag Outer: u8 { none; inner: Reply; }\nrec Box { n: u8; r: Reply; }\n#[noinline] fun through(p: *Reply) i64 { if (!sel p.value) { ret -1; } p.value = p.value + 1; ret p.value; }\n#[noinline] fun andop(p: *Reply) i64 { if (sel p.value && p.value > 3) { ret 1; } ret 0; }\n#[noinline] fun boxed(b: *Box) i64 { if (sel b.r.value) { ret b.r.value; } ret -1; }\n#[noinline] fun nested(o: *Outer) i64 { if (sel o.inner) { if (sel o.inner.value) { val q: *i64 = ?o.inner.value; @q = @q + 1; ret o.inner.value; } } ret -1; }\n#[noinline] fun rebind(p: *Reply, q: *Reply) i64 { var c: *Reply = p; if (sel c.value) { c = q; } if (sel c.value) { ret c.value; } ret -1; }\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    var r: Reply = Reply.value{argc + 41};\n    val p: *Reply = ?r;\n    var t: i64 = 0;\n    if (sel p.value) { p.value = p.value + 1; val q: *i64 = ?p.value; t = t + @q; }\n    if (t != 43) { ret 1; }\n    if (through(p) != 44) { ret 2; }\n    if (andop(p) != 1) { ret 3; }\n    var b: Box = Box{n: 1, r: Reply.value{5}};\n    if (boxed(?b) != 5) { ret 4; }\n    var e: Reply = Reply.empty{};\n    if (through(?e) != -1) { ret 5; }\n    if (sel p.empty) { ret 6; }\n    var o: Outer = Outer.inner{Reply.value{7}};\n    if (nested(?o) != 8) { ret 7; }\n    var q: Reply = Reply.value{9};\n    if (rebind(?r, ?q) != 9) { ret 8; }\n    if (rebind(?e, ?q) != -1) { ret 9; }\n    ret 0;\n}\n";
}

# every guard kind against every access kind: arm, exiting chains by ret, brk and cnt, the `&&`
# right operand, a three-case chain, nested guards, and the same over a global, a field and a pointer
#[testing]
fun tag_guards_program() str {
    ret "tag Reply: u8 { empty; value: i64; }\ntag Outer: u8 { none; inner: Reply; }\nrec Box { n: u8; r: Reply; }\nvar g: Reply = Reply.value{3};\n\n#[noinline] fun make(v: i64) Reply { ret Reply.value{v}; }\n#[noinline] fun bump(p: *i64) { @p = @p + 100; }\n\n# arm guard: read, write and address\n#[noinline] fun arm(r: Reply) i64 {\n    var t: Reply = r;\n    if (sel t.value) { t.value = t.value + 1; bump(?t.value); ret t.value; }\n    ret -1;\n}\n# exiting chain by ret: read, write and address after the chain\n#[noinline] fun chain_ret(r: Reply) i64 {\n    var t: Reply = r;\n    if (!sel t.value) { ret -1; }\n    t.value = t.value + 1;\n    bump(?t.value);\n    ret t.value;\n}\n# exiting chain by brk: the rest of the loop body is guarded\n#[noinline] fun chain_brk(r: Reply) i64 {\n    var t: Reply = r;\n    var out: i64 = -1;\n    for (1 == 1) {\n        if (!sel t.value) { brk; }\n        t.value = t.value + 1;\n        bump(?t.value);\n        out = t.value;\n        brk;\n    }\n    ret out;\n}\n# exiting chain by cnt: read, write and address on every iteration\n#[noinline] fun chain_cnt(a: *[3]Reply) i64 {\n    var sum: i64 = 0;\n    var i: u64 = 0;\n    for (i < 3) {\n        val j: u64 = i;\n        i = i + 1;\n        if (!sel (@a)[j].value) { cnt; }\n        (@a)[j].value = (@a)[j].value + 1;\n        bump(?(@a)[j].value);\n        sum = sum + (@a)[j].value;\n    }\n    ret sum;\n}\n# `&&` right operand: read and address inside the condition\n#[noinline] fun andop(r: Reply) i64 {\n    var t: Reply = r;\n    var out: i64 = 0;\n    if (sel t.value && t.value > 3) { out = out + 1; }\n    if (sel t.value && @(?t.value) > 3) { out = out + 10; }\n    ret out;\n}\n# three-case tag, the exiting chain leaves one case untested\ntag Three: u8 { a; b: i64; c: u8; }\n#[noinline] fun three(t: Three) i64 {\n    var v: Three = t;\n    if (sel v.a) { ret -1; } or (sel v.c) { ret v.c::i64; }\n    v.b = v.b + 1;\n    val p: *i64 = ?v.b;\n    ret @p;\n}\n# nested guards: read, write and address of the inner payload\n#[noinline] fun nested(o: Outer) i64 {\n    var v: Outer = o;\n    if (sel v.inner) {\n        if (!sel v.inner.value) { ret -1; }\n        v.inner.value = v.inner.value + 1;\n        bump(?v.inner.value);\n        ret v.inner.value;\n    }\n    ret -2;\n}\n# the same guards over a global, a record field and a pointer receiver\n#[noinline] fun places(b: *Box) i64 {\n    var out: i64 = 0;\n    if (!sel g.value) { ret -1; }\n    g.value = g.value + 1;\n    bump(?g.value);\n    out = out + g.value;\n    if (sel b.r.value) { if (b.r.value > 0) { b.r.value = b.r.value + 1; bump(?b.r.value); out = out + b.r.value; } }\n    ret out;\n}\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    val seed: i64 = argc + 41;\n    if (arm(make(seed)) != 143) { ret 1; }\n    if (arm(Reply.empty{}) != -1) { ret 2; }\n    if (chain_ret(make(seed)) != 143) { ret 3; }\n    if (chain_ret(Reply.empty{}) != -1) { ret 4; }\n    if (chain_brk(make(seed)) != 143) { ret 5; }\n    if (chain_brk(Reply.empty{}) != -1) { ret 6; }\n    var a: [3]Reply;\n    a[0] = make(1); a[2] = make(2);\n    if (chain_cnt(?a) != 205) { ret 7; }\n    if (andop(make(seed)) != 11) { ret 8; }\n    if (andop(make(1)) != 0) { ret 9; }\n    if (andop(Reply.empty{}) != 0) { ret 10; }\n    if (three(Three.b{5}) != 6) { ret 11; }\n    if (three(Three.c{9}) != 9) { ret 12; }\n    if (three(Three.a{}) != -1) { ret 13; }\n    if (nested(Outer.inner{make(seed)}) != 143) { ret 14; }\n    if (nested(Outer.inner{Reply.empty{}}) != -1) { ret 15; }\n    if (nested(Outer.none{}) != -2) { ret 16; }\n    var b: Box = Box{n: 1, r: make(seed)};\n    if (places(?b) != 104 + 143) { ret 17; }\n    if (sel b.r.value) { if (b.r.value != 143) { ret 18; } } or { ret 19; }\n    ret 0;\n}\n";
}

# runtime and comptime twins over module constants, a constant array and case descriptors
#[testing]
fun tag_comptime_program() str {
    ret "tag Reply: u8 { empty; value: i64; }\ntag Outer: u8 { none; inner: Reply; }\nrec Pair { a: u32; b: u64; }\ntag Multi: u16 { a; b: u8; c: Pair; d: Reply; }\nval C: Reply = Reply.value{42};\nval E: Reply = Reply.empty{};\nval O: Outer = Outer.inner{Reply.value{7}};\nval M: Multi = Multi.c{Pair{a: 3, b: 4}};\nval TAGS: [3]Reply = [3]Reply{Reply.value{1}, Reply.empty{}, Reply.value{3}};\n\n#[noinline] fun rt_value(r: Reply) i64 { if (sel r.value) { ret r.value; } ret -1; }\n#[noinline] fun rt_code(r: Reply) i64 { $each c in $cases(Reply) { if (sel r.[c]) { ret c.code::i64; } } ret -1; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    # a module constant: runtime test and read against the comptime twins\n    var k_c: i64 = -1;\n    $if (sel C.value && C.value == 42) { k_c = 42; }\n    var k_e: i64 = -1;\n    $if (sel E.value) { k_e = 0; }\n    $if (sel E.empty) { k_e = k_e + 1; }\n    if (rt_value(C) != k_c || k_c != 42) { ret 1; }\n    if (rt_value(E) != -1 || k_e != 0) { ret 2; }\n    # a `$if` arm whose condition is `sel C.value` guards the read in its body\n    var k_arm: i64 = 0;\n    $if (sel C.value) { k_arm = C.value; }\n    if (k_arm != 42) { ret 3; }\n    # `$each` over a constant array: comptime and runtime walks agree\n    var ct_sum: i64 = 0;\n    $each t in TAGS {\n        $if (sel t.value) { ct_sum = ct_sum + t.value; }\n        $or { ct_sum = ct_sum + 100; }\n    }\n    var rt_sum: i64 = 0;\n    var i: u64 = 0;\n    for (i < 3) {\n        if (sel TAGS[i].value) { rt_sum = rt_sum + TAGS[i].value; } or { rt_sum = rt_sum + 100; }\n        i = i + 1;\n    }\n    if (ct_sum != rt_sum || ct_sum != 104) { ret 4; }\n    # the runtime `sel` over a `$each` element folds like its comptime twin\n    var fold_sum: i64 = 0;\n    $each t in TAGS {\n        if (sel t.value) { fold_sum = fold_sum + t.value; }\n        if (sel t.empty) { fold_sum = fold_sum + 100; }\n    }\n    if (fold_sum != 104) { ret 5; }\n    # a case descriptor names the case at compile time as at run time\n    var ct_code: i64 = -1;\n    $each c in $cases(Reply) {\n        $if (sel C.[c]) { ct_code = c.code::i64; }\n    }\n    if (ct_code != rt_code(C) || ct_code != 1) { ret 6; }\n    # nested constants: a tag inside a tag and a record inside a tag\n    var k_o: i64 = -1;\n    $if (sel O.inner && (sel O.inner.value && O.inner.value == 7)) { k_o = 7; }\n    if (sel O.inner) { if (sel O.inner.value) { if (O.inner.value != k_o) { ret 7; } } or { ret 7; } } or { ret 7; }\n    var k_m: i64 = -1;\n    $if (sel M.c && M.c.b == 4) { $if (sel M.c) { k_m = M.c.a::i64; } }\n    if (sel M.c) { if (M.c.a::i64 != k_m || k_m != 3) { ret 8; } } or { ret 8; }\n    $if (sel M.d) { ret 9; }\n    ret 0;\n}\n";
}

# argc selects one guarded access whose case is switched through a raw pointer between the guard
# and the access; every one traps under debug and reads or writes through under release
#[testing]
fun tag_trap_program() str {
    ret "tag Reply: u8 { empty; value: i64; }\ntag Outer: u8 { none; inner: Reply; }\npub var SEED: i64 = 42;\n#[noinline] fun make(v: i64) Reply { ret Reply.value{v}; }\n# switches the case behind the guard's back, through a raw pointer\n#[noinline] fun flip(p: *Reply) i64 { val code: *u8 = p::*u8; @code = 0; ret 1; }\n#[noinline] fun flip_inner(p: *Outer) i64 { val code: *u8 = p::*u8; code[$offset_of(Outer, inner)] = 0; ret 1; }\n#[noinline] fun sink(p: *i64) i64 { ret @p; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    var r: Reply = make(SEED);\n    var o: Outer = Outer.inner{make(SEED)};\n    # 1: arm read after the switch\n    if (argc == 1) { if (sel r.value) { flip(?r); ret r.value; } ret 1; }\n    # 2: arm write after the switch, then the byte the write landed on\n    if (argc == 2) { if (sel r.value) { flip(?r); r.value = 7; ret r.value; } ret 1; }\n    # 3: arm address after the switch\n    if (argc == 3) { if (sel r.value) { flip(?r); ret sink(?r.value); } ret 1; }\n    # 4: exiting-chain read after the switch\n    if (argc == 4) { if (!sel r.value) { ret 1; } flip(?r); ret r.value; }\n    # 5: `&&` right operand read after a switch inside the operand\n    if (argc == 5) { if (sel r.value && flip(?r) + r.value > 3) { ret 42; } ret 1; }\n    # 6: nested inner read after the inner case is switched\n    if (argc == 6) { if (sel o.inner) { if (sel o.inner.value) { flip_inner(?o); ret o.inner.value; } } ret 1; }\n    # 7: pointer auto-deref read after the switch\n    if (argc == 7) { val p: *Reply = ?r; if (sel p.value) { flip(p); ret p.value; } ret 1; }\n    # 8: no switch: every access reads through under both profiles\n    if (sel r.value) { r.value = r.value + 1; val q: *i64 = ?r.value; if (@q != 43) { ret 1; } }\n    if (!sel o.inner) { ret 1; }\n    if (!sel o.inner.value) { ret 1; }\n    ret o.inner.value;\n}\n";
}

# a generic instantiated over a user-declared res reaches the mangler with a real owner module
#[testing]
fun generic_over_user_res_program() str {
    ret "tag res[T, E]: u8 { err: E; ok: T; }\nrec Vector[T] { items: [4]T; len: u64; }\n#[noinline] fun push[T](v: *Vector[T], x: T) { (@v).items[(@v).len] = x; (@v).len = (@v).len + 1; }\n#[noinline] fun at[T](v: *Vector[T], i: u64) T { ret (@v).items[i]; }\n#[noinline] fun sum(v: *Vector[res[i32, u8]]) i64 { var t: i64 = 0; var i: u64 = 0; for (i < (@v).len) { val e: res[i32, u8] = at[res[i32, u8]](v, i); if (sel e.ok) { t = t + e.ok::i64; } or (sel e.err) { t = t - e.err::i64; } i = i + 1; } ret t; }\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    var v: Vector[res[i32, u8]];\n    push[res[i32, u8]](?v, res[i32, u8].ok{7});\n    push[res[i32, u8]](?v, res[i32, u8].err{3});\n    if (v.len != 2 || $size_of(Vector[res[i32, u8]]) != 40) { ret 1; }\n    val a: res[i32, u8] = at[res[i32, u8]](?v, 0);\n    if (sel a.ok) { if (a.ok != 7) { ret 2; } } or { ret 2; }\n    val b: res[i32, u8] = at[res[i32, u8]](?v, 1);\n    if (sel b.err) { if (b.err != 3) { ret 3; } } or { ret 3; }\n    if (sum(?v) != 4) { ret 4; }\n    ret 0;\n}\n";
}

# the outcome of building the fixture project at `root` for `goal` on linux in a fresh session,
# and whether its diagnostics hold an error that says `needle`
#[testing]
fun built_outcome(alloc: *A.Allocator, root: str, goal: request.BuildGoal, artifact: str, needle: str, out: *outcome.BuildOutcome, said: *bool) i32 {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val loaded: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel loaded.err) { ret 2; }
    var m:  manifest.Manifest    = loaded.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = "linux";
    rq.goal         = goal;
    rq.artifact     = artifact;
    rq.object_cache = true;
    val planned: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_to_run(alloc, ?s, toolchain.t_registry(), ?m, rq);
    if (sel planned.err) { ret 3; }
    var bp:        build_plan.BuildPlan     = planned.ok;
    var published: publication.Publications = publication.init(alloc);
    fin { publication.dnit(?published); }
    val built: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?bp, 0, ?s, ?published, alloc, nil);
    if (sel built.err) {
        print.eprintln(fail.describe(built.err));
        ret 4;
    }
    @out  = built.ok;
    @said = str_empty(needle) || diagnostic.error_says(?s.diags, needle);
    ret 0;
}

# zero when a project whose module `mid` forwards `leaf.original_name` under two names, with
# the entry `main_text`, builds and links
#[testing]
fun renamed_reexport_links(main_text: str) i32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var names: [3]str              = [3]str{"main.mach", "mid.mach", "leaf.mach"};
    var texts: [3]str              = [3]str{main_text, "fwd renamed_alias: uniontest.leaf.original_name;\nfwd uniontest.leaf.original_name;\n", "pub fun original_name() i32 { ret 42; }\n"};
    val made:  res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 3);
    if (sel made.err) { ret 1; }
    fin { fs.remove_all(?alloc, made.ok); }
    var built: outcome.BuildOutcome;
    var said:  bool = false;
    val ran:   i32  = built_outcome(?alloc, made.ok, request.GOAL_ARTIFACT, "", "", ?built, ?said);
    if (ran != 0) { ret 10 + ran; }
    fin { outcome.outcome_dnit(?built); }
    if (built.severity != outcome.BUILD_OK) { ret 2; }
    ret 0;
}

# a renamed re-export links across the module boundary whichever order its names are imported in
test fwd__renamed_reexport_links {
    var alloc: A.Allocator;
    page.make(?alloc);
    val qualified: i32 = renamed_reexport_links(driver.joined(?alloc, "use uniontest.mid;\n#[symbol(\"main\")]\nfun main() i32 { ret mid.renamed_alias() - mid.original_name(); }\n", native_stub()));
    if (qualified != 0) { ret 100 + qualified; }
    val leaves: i32 = renamed_reexport_links(driver.joined(?alloc, "use uniontest.mid.renamed_alias;\nuse uniontest.mid.original_name;\n#[symbol(\"main\")]\nfun main() i32 { ret renamed_alias() - original_name(); }\n", native_stub()));
    if (leaves != 0) { ret 200 + leaves; }
    ret 0;
}

# a consumer whose path dependency `leaf` exposes a `pub #[testing]` helper, with the entry
# `main_text` started through the test dispatcher's stub
#[testing]
fun testing_dep_scaffold(alloc: *A.Allocator, main_text: str) res[str, fail.Fail] {
    var names:    [1]str              = [1]str{"main.mach"};
    var texts:    [1]str              = [1]str{driver.joined(alloc, main_text, dispatcher_stub())};
    val consumer: str                 = driver.joined(alloc, driver.fixture_manifest(), "\n[dep.leaf]\npath = \"dep/leaf\"\n");
    val made:     res[str, fail.Fail] = driver.scaffold(alloc, consumer, ?names[0], ?texts[0], 1);
    if (sel made.err) { ret made; }
    val root:    str               = made.ok;
    val dep_src: res[str, A.Error] = types_path.join(alloc, root, "dep/leaf/src");
    if (sel dep_src.err) { ret res[str, fail.Fail].err{fail.refused(dep_src.err)}; }
    val dir: err[fs.FsError] = fs.create_dir_all(alloc, dep_src.ok, 493);
    if (sel dir.err) { ret res[str, fail.Fail].err{fail.fs_refused(dir.err)}; }
    var paths:        [3]str;
    var bytes:        [3]str;
    val dep_manifest: res[str, A.Error] = types_path.join(alloc, root, "dep/leaf");
    if (sel dep_manifest.err) { ret res[str, fail.Fail].err{fail.refused(dep_manifest.err)}; }
    var files: [3]str = [3]str{manifest.MANIFEST_FILE, "lib.mach", "shape.mach"};
    var dirs:  [3]str = [3]str{dep_manifest.ok, dep_src.ok, dep_src.ok};
    var i:     u32    = 0;
    for (i < 3) {
        val at: res[str, A.Error] = types_path.join(alloc, dirs[i], files[i]);
        if (sel at.err) { ret res[str, fail.Fail].err{fail.refused(at.err)}; }
        paths[i] = at.ok;
        i        = i + 1;
    }
    bytes[0] = lib_manifest(alloc, "leaf");
    bytes[1] = "use leaf.shape;\nval BASE: u64 = 4 * $size_of(shape.Pair);\n#[testing]\nval END: u64 = BASE - 22;\n#[testing]\npub fun helper() i32 { ret END::i32; }\npub fun plain() i32 { ret (BASE - 64)::i32; }\n";
    bytes[2] = "pub rec Pair {\n    a: u64;\n    b: u64;\n}\n";
    i        = 0;
    for (i < 3) {
        val wrote: err[fs.FsError] = fs.write_bytes(paths[i], bytes[i], str_len(bytes[i]), 420);
        if (sel wrote.err) { ret res[str, fail.Fail].err{fail.fs_refused(wrote.err)}; }
        i = i + 1;
    }
    ret res[str, fail.Fail].ok{root};
}

# a dependency's `#[testing]` helper is refused to a consumer's production code
test testing_mark__dependency_helper_is_refused_to_consumer_production {
    var alloc: A.Allocator;
    page.make(?alloc);
    val made: res[str, fail.Fail] = testing_dep_scaffold(?alloc, "use leaf.lib;\npub fun main() i32 { ret lib.helper(); }\n");
    if (sel made.err) { ret 1; }
    fin { fs.remove_all(?alloc, made.ok); }
    var built:   outcome.BuildOutcome;
    var refused: bool = false;
    val ran:     i32  = built_outcome(?alloc, made.ok, request.GOAL_OBJECTS, "uniontest", "is a `#[testing]` declaration", ?built, ?refused);
    if (ran != 0) { ret 10 + ran; }
    fin { outcome.outcome_dnit(?built); }
    if (built.severity == outcome.BUILD_OK) { ret 2; }
    if (!refused)                           { ret 3; }
    ret 0;
}

# zero when debug and release builds of each of the `count` fixtures at `rows`, beneath the std
# tag prelude, reach their verdicts as objects, else the code of the first that misses one
#[testing]
fun tag_verdicts(rows: *fe_sema.TagFixture, count: usize) i32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: usize = 0;
    for (i < count) {
        var names: [1]str = [1]str{"main.mach"};
        var texts: [1]str = [1]str{driver.joined(?alloc, fe_sema.TAG_STD_PRELUDE, rows[i].text)};
        var pass:  u32    = 0;
        for (pass < 2) {
            var w:    WarmProject;
            val made: err[fail.Fail] = warm_project_init(?w);
            if (sel made.err) { ret -1; }
            fin { warm_project_dnit(?w); }
            val scaffolded: err[fail.Fail] = warm_project_scaffold(?w, driver.fixture_manifest(), ?names[0], ?texts[0], 1);
            if (sel scaffolded.err) { ret -2; }
            var rq: request.BuildRequest = request.defaults();
            rq.target = "linux";
            rq.goal   = request.GOAL_OBJECTS;
            if (pass == 1) {
                rq.profile = "release";
                rq.opt     = request.OPT_RELEASE;
            }
            val planned: err[fail.Fail] = warm_project_plan(?w, rq);
            if (sel planned.err) { ret -3; }
            val built: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, nil);
            if (sel built.err) { ret -4; }
            var bo:       outcome.BuildOutcome  = built.ok;
            val severity: outcome.BuildSeverity = bo.severity;
            outcome.outcome_dnit(?bo);
            if (severity > outcome.BUILD_USER || (severity == outcome.BUILD_OK) != rows[i].accept) {
                print.printf("tag-verdict: profile {} severity {} for fixture code {}\n", pass, severity::u64, rows[i].code);
                ret rows[i].code;
            }
            pass = pass + 1;
        }
        i = i + 1;
    }
    ret 0;
}

# each tag fixture's verdict holds through lowering and codegen under both profiles
test tag_corpus__verdict_matches_across_profiles {
    if (tag_verdicts(?fe_sema.TAG_CASE_RECIPES[0], $length_of(fe_sema.TAG_CASE_RECIPES)) != 0)                 { ret 1; }
    if (tag_verdicts(?fe_sema.TAG_CONSTRUCTION_NAMES[0], $length_of(fe_sema.TAG_CONSTRUCTION_NAMES)) != 0)     { ret 2; }
    if (tag_verdicts(?fe_sema.TAG_RECORD_LITERAL_FORMS[0], $length_of(fe_sema.TAG_RECORD_LITERAL_FORMS)) != 0) { ret 3; }
    if (tag_verdicts(?fe_sema.TAG_FORGED_CASTS[0], $length_of(fe_sema.TAG_FORGED_CASTS)) != 0)                 { ret 4; }
    if (tag_verdicts(?fe_sema.TAG_IS_TAG_QUERIES[0], $length_of(fe_sema.TAG_IS_TAG_QUERIES)) != 0)             { ret 5; }
    if (tag_verdicts(?fe_sema.CANONICAL_CONSTRUCTION[0], $length_of(fe_sema.CANONICAL_CONSTRUCTION)) != 0)     { ret 6; }
    if (tag_verdicts(?fe_sema.CANONICAL_ARITY[0], $length_of(fe_sema.CANONICAL_ARITY)) != 0)                   { ret 7; }
    if (tag_verdicts(?fe_sema.CANONICAL_PAYLOADS[0], $length_of(fe_sema.CANONICAL_PAYLOADS)) != 0)             { ret 8; }
    if (tag_verdicts(?fe_sema.CANONICAL_DISTINCTNESS[0], $length_of(fe_sema.CANONICAL_DISTINCTNESS)) != 0)     { ret 9; }
    if (tag_verdicts(?fe_sema.CANONICAL_CASTS[0], $length_of(fe_sema.CANONICAL_CASTS)) != 0)                   { ret 10; }
    if (tag_verdicts(?fe_sema.SEL_PAYLOAD_GUARDS[0], $length_of(fe_sema.SEL_PAYLOAD_GUARDS)) != 0)             { ret 11; }
    if (tag_verdicts(?fe_sema.SEL_SELECTOR_USAGE[0], $length_of(fe_sema.SEL_SELECTOR_USAGE)) != 0)             { ret 12; }
    if (tag_verdicts(?fe_sema.SEL_ONE_CASE[0], $length_of(fe_sema.SEL_ONE_CASE)) != 0)                         { ret 13; }
    if (tag_verdicts(?fe_sema.SEL_NON_PLACES[0], $length_of(fe_sema.SEL_NON_PLACES)) != 0)                     { ret 14; }
    if (tag_verdicts(?fe_sema.SEL_ESCAPES[0], $length_of(fe_sema.SEL_ESCAPES)) != 0)                           { ret 15; }
    if (tag_verdicts(?fe_sema.SEL_ARMS[0], $length_of(fe_sema.SEL_ARMS)) != 0)                                 { ret 16; }
    if (tag_verdicts(?fe_sema.SEL_OUTSIDE_GUARDS[0], $length_of(fe_sema.SEL_OUTSIDE_GUARDS)) != 0)             { ret 17; }
    if (tag_verdicts(?fe_sema.SEL_AND_GUARDS[0], $length_of(fe_sema.SEL_AND_GUARDS)) != 0)                     { ret 18; }
    if (tag_verdicts(?fe_sema.SEL_EXITING_CHAINS[0], $length_of(fe_sema.SEL_EXITING_CHAINS)) != 0)             { ret 19; }
    if (tag_verdicts(?fe_sema.SEL_WHOLE_ASSIGNMENT[0], $length_of(fe_sema.SEL_WHOLE_ASSIGNMENT)) != 0)         { ret 20; }
    if (tag_verdicts(?fe_sema.SEL_FIN_RETURNS[0], $length_of(fe_sema.SEL_FIN_RETURNS)) != 0)                   { ret 21; }
    if (tag_verdicts(?fe_sema.SEL_AUTO_DEREF[0], $length_of(fe_sema.SEL_AUTO_DEREF)) != 0)                     { ret 22; }
    if (tag_verdicts(?fe_sema.SEL_COMPTIME[0], $length_of(fe_sema.SEL_COMPTIME)) != 0)                         { ret 23; }
    ret 0;
}

# zero when the trap fixture built for `target_name` in one profile traps on every guarded access
# under debug and reads or writes through under release; a runner that is absent skips the arm with 77
#[testing]
fun trap_target(alloc: *A.Allocator, target_name: str, runner_name: str, release: bool) i32 {
    var runner: str = "";
    if (!str_empty(runner_name)) {
        val found: res[str, exec.Error] = exec.resolve(alloc, runner_name);
        if (sel found.err) {
            print.print("tag-trap: runner absent, arm skipped: ");
            print.print(runner_name);
            print.print("\n");
            ret 77;
        }
        runner = found.ok;
    }
    var w:    WarmProject;
    val made: err[fail.Fail] = warm_project_init(?w);
    if (sel made.err) { ret 1; }
    fin { warm_project_dnit(?w); }
    var names:      [1]str         = [1]str{"main.mach"};
    var texts:      [1]str         = [1]str{driver.joined(alloc, tag_trap_program(), native_stub())};
    val scaffolded: err[fail.Fail] = warm_project_scaffold(?w, native_manifest(), ?names[0], ?texts[0], 1);
    if (sel scaffolded.err) { ret 2; }
    var rq: request.BuildRequest = request.defaults();
    rq.target = target_name;
    if (release) {
        rq.profile = "release";
        rq.opt     = request.OPT_RELEASE;
    }
    val planned: err[fail.Fail] = warm_project_plan(?w, rq);
    if (sel planned.err) { ret 3; }
    val built: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, alloc, nil);
    if (sel built.err) { ret 4; }
    val bo: outcome.BuildOutcome = built.ok;
    if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { ret 5; }
    val program: str = bo.artifacts.data[0].path;
    # release reads through: argc 2 lands the write on the payload, every other access sees 42
    var release_exit: [8]i32 = [8]i32{42, 7, 42, 42, 42, 42, 42, 42};
    var argc:         usize  = 1;
    for (argc <= 8) {
        var trapped: bool = false;
        var code:    i32  = 0;
        var bad:     i32  = 0;
        if (!run_with_argc(w.root, runner, program, argc, ?trapped, ?code)) { bad = 6; }
        or (release || argc == 8) {
            if (trapped || code != release_exit[argc - 1]) { bad = 7; }
        }
        or (!trapped) { bad = 8; }
        if (bad != 0) {
            print.printf("tag-trap: unexpected outcome on {} (argc {}, step {}, trapped {}, exit {})\n", target_name, argc, bad, trapped::u8, code);
            ret bad;
        }
        argc = argc + 1;
    }
    ret 0;
}

$if ($mach.build.os == $mach.os.linux && $mach.build.arch == $mach.arch.x86_64) {
    # a grouped literal and a grouped assignment target keep their values in a built program
    test grouped_expr__values_survive_to_run_time {
        var alloc: A.Allocator;
        page.make(?alloc);
        var names: [1]str              = [1]str{"main.mach"};
        var texts: [1]str              = [1]str{driver.joined(?alloc, "val N: i32 = (4);\ntest grouped {\n    var x: i32 = (N);\n    (x) = ('a')::i32 + (1);\n    val s: *u8 = (\"hi\");\n    val p: *u8 = (nil);\n    val f: f64 = (2.5);\n    if (p != nil) { ret 11; }\n    if (f != 2.5) { ret 12; }\n    if (s[0] != 104 || s[1] != 105 || s[2] != 0) { ret 13; }\n    ret (x) - 98;\n}\n", dispatcher_stub())};
        val made:  res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 1);
        if (sel made.err) { ret 1; }
        fin { fs.remove_all(?alloc, made.ok); }
        var built: outcome.BuildOutcome;
        var said:  bool = false;
        val ran:   i32  = built_outcome(?alloc, made.ok, request.GOAL_TESTS, "", "", ?built, ?said);
        if (ran != 0) { ret 10 + ran; }
        fin { outcome.outcome_dnit(?built); }
        if (built.severity != outcome.BUILD_OK) { ret 2; }
        if (built.tests.len != 1)               { ret 3; }
        val art: *testrun.TestArtifact = ?built.tests.data[0];
        val got: i32                   = dispatch_status(art.exe::str, art.idx);
        if (got != 0) {
            print.eprintlnf("grouped: exit {}", got::i64);
            ret 4;
        }
        ret 0;
    }

    # a dependency's modules are built in the consumer's mode: after an ordinary build has
    # produced and cached the dependency's objects without the helper, `mach test` in a fresh
    # session still links the helper the consumer's test calls, and the test passes. the
    # helper returns a `#[testing]` constant folded from one the reused object's lowering
    # bound, from a layout of another module, so the reuse cannot change what it folds to
    test testing_mark__dependency_helper_serves_consumer_tests {
        var alloc: A.Allocator;
        page.make(?alloc);
        val made: res[str, fail.Fail] = testing_dep_scaffold(?alloc, "use leaf.lib;\n#[symbol(\"main\")]\nfun main() i32 { ret lib.plain(); }\ntest leaf_helper { if (lib.helper() != 42) { ret 1; } ret 0; }\n");
        if (sel made.err) { ret 1; }
        fin { fs.remove_all(?alloc, made.ok); }
        var ordinary: outcome.BuildOutcome;
        var said:     bool = false;
        val first:    i32  = built_outcome(?alloc, made.ok, request.GOAL_ARTIFACT, "uniontest", "", ?ordinary, ?said);
        if (first != 0) { ret 10 + first; }
        val severity: outcome.BuildSeverity = ordinary.severity;
        outcome.outcome_dnit(?ordinary);
        if (severity != outcome.BUILD_OK) { ret 2; }
        var tested: outcome.BuildOutcome;
        val second: i32 = built_outcome(?alloc, made.ok, request.GOAL_TESTS, "uniontest", "", ?tested, ?said);
        if (second != 0) { ret 20 + second; }
        fin { outcome.outcome_dnit(?tested); }
        if (tested.severity != outcome.BUILD_OK || tested.tests.len != 1) { ret 3; }
        val art: *testrun.TestArtifact = ?tested.tests.data[0];
        if (dispatch_status(art.exe::str, art.idx) != 0) { ret 4; }
        ret 0;
    }

    # a `$each` over a constant array reads each element from the array's published value, alike for
    # an array the module imports, one of its own and one local to a body: record and nested fields,
    # a field the literal leaves out, a string, a case payload under a folded `sel`, a whole record
    # and a function-pointer field, which the value holds no compile-time value for and the array
    # itself is read for
    test each__reads_imported_own_and_local_arrays_alike {
        var alloc: A.Allocator;
        page.make(?alloc);
        var names:   [1]str = [1]str{"src/a.mach"};
        var texts:   [1]str = [1]str{"pub tag Reply: u8 { empty; value: i64; }\npub rec P { x: i64; y: i64; }\npub rec Q { p: P; name: *u8; }\npub rec Rule { tag: i64; fn: fun(i64) i64; }\npub fun inc(n: i64) i64 { ret n + 1; }\npub fun dbl(n: i64) i64 { ret n * 2; }\npub val PS: [2]P = [2]P{P{x: 1, y: 2}, P{x: 30, y: 4}};\npub val QS: [2]Q = [2]Q{Q{p: P{x: 5, y: 6}, name: \"ab\"}, Q{p: P{x: 7}, name: \"cde\"}};\npub val TS: [2]Reply = [2]Reply{Reply.value{100}, Reply.empty{}};\npub val RULES: [2]Rule = [2]Rule{Rule{tag: 1, fn: inc}, Rule{tag: 2, fn: dbl}};\n"};
        val program: str    = driver.joined(?alloc, "use divtrap.a;\nval PS: [2]a.P = [2]a.P{a.P{x: 1, y: 2}, a.P{x: 30, y: 4}};\nval QS: [2]a.Q = [2]a.Q{a.Q{p: a.P{x: 5, y: 6}, name: \"ab\"}, a.Q{p: a.P{x: 7}, name: \"cde\"}};\nval TS: [2]a.Reply = [2]a.Reply{a.Reply.value{100}, a.Reply.empty{}};\nval RULES: [2]a.Rule = [2]a.Rule{a.Rule{tag: 1, fn: a.inc}, a.Rule{tag: 2, fn: a.dbl}};\n\n#[noinline] fun take(p: a.P) i64 { ret p.x * 10 + p.y; }\n#[noinline] fun local($n: i64) i64 { val L: [2]a.P = [2]a.P{a.P{x: n, y: 1}, a.P{x: 2}}; var s: i64 = 0; $each p in L { s = s + take(p); } ret s; }\n\n#[symbol(\"main\")]\nfun main(argc: i64) i64 {\n    var s: i64 = 0;\n    $each p in a.PS { s = s + take(p); $if (p.x == 30) { s = s + 1000; } }\n    $each p in PS { s = s - take(p); $if (p.x == 30) { s = s - 1000; } }\n    if (s != 0) { ret 1; }\n    $each q in a.QS { s = s + q.p.x * 100 + q.p.y + q.name[1]::i64; }\n    $each q in QS { s = s - q.p.x * 100 - q.p.y - q.name[1]::i64; }\n    if (s != 0) { ret 2; }\n    $each t in a.TS { $if (sel t.value) { s = s + t.value; } $or { s = s + 1; } }\n    $each t in TS { if (sel t.value) { s = s - t.value; } or { s = s - 1; } }\n    if (s != 0) { ret 3; }\n    $each r in a.RULES { s = s + r.fn(10) + r.tag; }\n    $each r in RULES { s = s - r.fn(10) - r.tag; }\n    if (s != 0) { ret 4; }\n    if (local(5) != 71 || local(6) != 81) { ret 5; }\n    ret 0;\n}\n", native_stub());
        if (native_case_files(?alloc, native_manifest(), ?names[0], ?texts[0], 1, "linux-x86_64", "", false, program, "each arrays") != 0) { ret 1; }
        if (native_case_files(?alloc, native_manifest(), ?names[0], ?texts[0], 1, "linux-x86_64", "", true, program, "each arrays") != 0)  { ret 2; }
        ret 0;
    }

