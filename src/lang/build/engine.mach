rec UnitState {
    inputs:     *target_of.ObjectInput;
    obj_len:    u32;
    dynlibs:    *target_of.DynLib;
    dynlib_len: u32;

    out_path: *u8;
    scope:    build_testing.TestScope;
    objects:  *str;
    # beside objects: the test object path of each emitted module that has one, else nil
    test_objects: *str;
    ir_outputs:   *str;
    asm_outputs:  *str;
    artifact:     str;
    dispatcher:   str;
}

fun label_failed(failed: *Vector[str], label: str) bool {
    var j: usize = 0;
    for (j < failed.len) {
        if (str_equals(failed.data[j], label)) { ret true; }
        j = j + 1;
    }
    ret false;
}

# the label of a failed cell `u` waits on, none when none has failed. a manifest
# requirement is labelled in `u`'s own scope, `<owner>.<artifact>` for a dependency
fun blocking_requirement(oa: *A.Allocator, failed: *Vector[str], u: *build_plan.BuildUnit) res[opt[str], fail.Fail] {
    var i: usize = 0;
    for (i < u.requires.len) {
        var label: str = u.requires.data[i];
        if (!str_empty(u.owner)) {
            val owned: res[str, fail.Fail] = build_plan.join_msg(oa, u.owner, ".", label);
            if (sel owned.err) { ret res[opt[str], fail.Fail].err{owned.err}; }
            label = owned.ok;
        }
        if (label_failed(failed, label)) { ret res[opt[str], fail.Fail].ok{opt[str].some{label}}; }
        i = i + 1;
    }
    i = 0;
    for (i < u.dep_requires.len) {
        if (label_failed(failed, u.dep_requires.data[i])) { ret res[opt[str], fail.Fail].ok{opt[str].some{u.dep_requires.data[i]}}; }
        i = i + 1;
    }
    ret res[opt[str], fail.Fail].ok{opt[str].none{}};
}

fun record_blocked_unit(bo: *outcome.BuildOutcome, sink: *readout.Sink, oa: *A.Allocator, failed: *Vector[str],
    u: *build_plan.BuildUnit, blocked_by: str) err[fail.Fail] {
    var f: fail.Fail = fail.user_of(diagnostic_kind.ARTIFACT_BLOCKED, build_plan.join_msg(oa,
        "artifact '", u.label, "' was not built: it requires artifact '", blocked_by,
        "', which failed to build"));
    readout.failure(sink, ?f, diagnostic.ORIGIN_BUILD);
    outcome.fold_fail(bo, ?f);
    val pr: res[usize, A.Error] = collections_vector.push[str](failed, u.label);
    if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
    ret err[fail.Fail].ok{};
}

# run every planned cell cold: each unit gets its own session and arena over `backing`
# and is torn down when it finishes, so nothing of one unit's frontend survives into the
# next. a unit whose requirement failed is recorded as blocked and skipped; a unit that
# fails is recorded and the remaining units still run. ok is the outcome of the whole
# plan, its severity the worst unit's; err is a failure of the engine itself, never of a
# unit
# ---
# bp:      the plan, read only
# backing: the allocator each unit's arena grows from; released per unit
# oa:      owns the returned outcome and every path and text in it
# sink:    where every unit, failure, diagnostic and phase row is sent as it happens; nil for none
# ret:     the outcome, released with outcome.outcome_dnit, or an engine failure whose text
#          `oa` owns
pub fun execute(bp: *build_plan.BuildPlan, backing: *A.Allocator, oa: *A.Allocator,
    sink: *readout.Sink) res[outcome.BuildOutcome, fail.Fail] {
    var bo:     outcome.BuildOutcome = outcome.outcome_init(oa);
    var failed: Vector[str]          = collections_vector.init[str](oa);

    var i: usize = 0;
    for (i < bp.units.len) {
        val unit: *build_plan.BuildUnit = ?bp.units.data[i];
        readout.unit(sink, unit.label, unit.sel_target, unit.profile, request.goal_verb(unit.goal), unit.has_artifact);

        val blocked_by: res[opt[str], fail.Fail] = blocking_requirement(oa, ?failed, unit);
        if (sel blocked_by.err) {
            outcome.outcome_dnit(?bo);
            ret res[outcome.BuildOutcome, fail.Fail].err{blocked_by.err};
        }
        if (sel blocked_by.ok.some) {
            val br: err[fail.Fail] = record_blocked_unit(?bo, sink, oa, ?failed, unit, blocked_by.ok.some);
            if (sel br.err) {
                outcome.outcome_dnit(?bo);
                ret res[outcome.BuildOutcome, fail.Fail].err{br.err};
            }
            i = i + 1;
            cnt;
        }

        val ur: res[outcome.BuildOutcome, fail.Fail] = execute_unit_cold(bp, i, backing, oa, sink);
        if (sel ur.err) {
            var f: fail.Fail = ur.err;
            readout.failure(sink, ?f, diagnostic.ORIGIN_BUILD);
            outcome.fold_fail(?bo, ?f);
            val pr: res[usize, A.Error] = collections_vector.push[str](?failed, unit.label);
            if (sel pr.err) {
                outcome.outcome_dnit(?bo);
                ret res[outcome.BuildOutcome, fail.Fail].err{fail.message("out of memory")};
            }
        }
        if (sel ur.ok) {
            var ubo: outcome.BuildOutcome = ur.ok;
            if (ubo.severity != outcome.BUILD_OK) {
                val fr: res[usize, A.Error] = collections_vector.push[str](?failed, unit.label);
                if (sel fr.err) {
                    outcome.outcome_dnit(?ubo);
                    outcome.outcome_dnit(?bo);
                    ret res[outcome.BuildOutcome, fail.Fail].err{fail.message("out of memory")};
                }
            }
            val mr: err[A.Error] = outcome.merge(?bo, ?ubo);
            if (sel mr.err) {
                outcome.outcome_dnit(?ubo);
                outcome.outcome_dnit(?bo);
                ret res[outcome.BuildOutcome, fail.Fail].err{fail.message("failed to merge build outcome")};
            }
        }
        i = i + 1;
    }
    ret res[outcome.BuildOutcome, fail.Fail].ok{bo};
}

fun execute_unit_cold(bp: *build_plan.BuildPlan, unit_index: usize, backing: *A.Allocator,
    oa: *A.Allocator, sink: *readout.Sink) res[outcome.BuildOutcome, fail.Fail] {
    var u_ar:   arena.Arena;
    val init_r: err[A.Error] = arena.init(?u_ar, backing, 0);
    if (sel init_r.err) {
        ret cold_fail(oa, sink, fail.message("failed to initialise allocator"));
    }
    var u_alloc: A.Allocator;
    val make_r:  err[A.Error] = arena.make(?u_alloc, ?u_ar);
    if (sel make_r.err) {
        arena.dnit(?u_ar);
        ret cold_fail(oa, sink, fail.message("failed to initialise allocator"));
    }

    var r:           res[outcome.BuildOutcome, fail.Fail];
    val res_session: res[session.Session, fail.Fail] = session.init(?u_alloc);
    if (sel res_session.err) {
        val f: fail.Fail = fail.message_of(build_plan.join_msg(?u_alloc, "failed to initialise compiler session: ", fail.describe(res_session.err)));
        r = cold_fail(oa, sink, f);
    }
    if (sel res_session.ok) {
        var s: session.Session = res_session.ok;
        s.backing = backing;
        r         = execute_warm(bp, unit_index, ?s, oa, sink);
        session.dnit(?s);
    }

    arena.dnit(?u_ar);
    ret r;
}

fun cold_fail(oa: *A.Allocator, sink: *readout.Sink, f: fail.Fail) res[outcome.BuildOutcome, fail.Fail] {
    var bo: outcome.BuildOutcome = outcome.outcome_init(oa);
    ret warm_fail(?bo, sink, f);
}

#[testing]
rec PoisonState {
    real:    A.Allocator;
    fail_at: usize;
    calls:   usize;
}

#[testing]
fun poison_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val st: *PoisonState = ctx::*PoisonState;
    st.calls = st.calls + 1;
    if (st.fail_at != 0 && st.calls == st.fail_at) { ret opt[ptr].none{}; }
    ret st.real.fn_allocate(st.real.ctx, size, align);
}

#[testing]
fun poison_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val st: *PoisonState = ctx::*PoisonState;
    ret st.real.fn_reallocate(st.real.ctx, p, old_size, new_size, align);
}

#[testing]
fun poison_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    if (p != nil && size > 0) {
        var i: usize = 0;
        for (i < size) {
            (p::*u8)[i] = 0xAA::u8;
            i           = i + 1;
        }
    }
    ret 0;
}

# the sent failure was live (unpoisoned) when it arrived, and names the cause
#[testing]
fun t_failure_text_contains(rd: *readout.Recording, needle: str) bool {
    if (rd.failures.len != 1) { ret false; }
    val text: str = rd.failures.data[0];
    if (text == nil || (text::*u8)[0] == 0xAA::u8) { ret false; }
    ret str_contains(text, needle);
}

test execute_unit_cold__session_init_failure_is_sent_before_arena_teardown {
    var real:   A.Allocator;
    val make_r: err[A.Error] = page.make(?real);
    if (sel make_r.err) { ret 1; }
    var st: PoisonState;
    st.real    = real;
    st.fail_at = 1;
    st.calls   = 0;
    var backing: A.Allocator;
    backing.ctx           = (?st)::ptr;
    backing.fn_allocate   = poison_allocate;
    backing.fn_reallocate = poison_reallocate;
    backing.fn_deallocate = poison_deallocate;

    var oa:      A.Allocator;
    val make_r2: err[A.Error] = page.make(?oa);
    if (sel make_r2.err) { ret 2; }

    var rd: readout.Recording;
    readout.recording_init(?rd, ?oa, readout.LEVEL_RESULTS);
    var bp: build_plan.BuildPlan;
    val r:  res[outcome.BuildOutcome, fail.Fail] = execute_unit_cold(?bp, 0::usize, ?backing, ?oa, ?rd.sink);
    if (sel r.err) { ret 3; }

    var bo:  outcome.BuildOutcome = r.ok;
    var bad: i32                  = 0;
    if (bo.severity != outcome.BUILD_INTERNAL)                                  { bad = 1; }
    or (!t_failure_text_contains(?rd, "failed to initialise compiler session")) { bad = 1; }
    outcome.outcome_dnit(?bo);
    readout.recording_dnit(?rd);
    ret bad;
}

# run one planned cell through a caller-owned session, reusing its query cache, source
# overlays and typed surface across calls (the editor's build path). the session's
# diagnostic store is replaced for the call and its build allocator is a per-call arena
# restored on return, so every raw product a caller borrowed from the session before the
# call is expired by it
# ---
# bp:         the plan, read only
# unit_index: the cell to run; out of range is an internal failure
# s:          the warm session; its registry, sources and queries carry over between calls
# oa:         owns the returned outcome
# sink:       where the unit's failures, diagnostics and phase rows are sent as they happen; nil for none
# ret:        the outcome of that one unit, released with outcome.outcome_dnit, or an engine failure
pub fun execute_warm(bp: *build_plan.BuildPlan, unit_index: usize, s: *session.Session, oa: *A.Allocator,
    sink: *readout.Sink) res[outcome.BuildOutcome, fail.Fail] {
    if (unit_index >= bp.units.len) {
        ret res[outcome.BuildOutcome, fail.Fail].err{fail.message("build unit index out of range")};
    }
    val planned: *build_plan.BuildUnit = ?bp.units.data[unit_index];

    var bo:       outcome.BuildOutcome = outcome.outcome_init(oa);
    var progress: readout.Progress;
    val pr:       *readout.Progress    = readout.start(?progress, sink);

    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(s.alloc);

    var call_ar: arena.Arena;
    val init_r:  err[A.Error] = arena.init(?call_ar, s.backing, 0);
    if (sel init_r.err) {
        ret warm_fail(?bo, sink, fail.message("failed to initialise allocator"));
    }
    var call_alloc: A.Allocator;
    val make_r2:    err[A.Error] = arena.make(?call_alloc, ?call_ar);
    if (sel make_r2.err) {
        arena.dnit(?call_ar);
        ret warm_fail(?bo, sink, fail.message("failed to initialise allocator"));
    }

    val prior_build: *A.Allocator = s.build_alloc;
    s.build_alloc = ?call_alloc;
    fin {
        s.build_alloc = prior_build;
        arena.dnit(?call_ar);
    }

    val res_register: err[fail.Fail] = driver.setup_registry(s.registry);
    if (sel res_register.err) {
        val r: res[outcome.BuildOutcome, fail.Fail] = warm_fail(?bo, sink, res_register.err);
        ret r;
    }

    val res_manifest: res[manifest.Manifest, fail.Fail] = driver.load_manifest(s, bp.request.project_root);
    if (sel res_manifest.err) {
        val r: res[outcome.BuildOutcome, fail.Fail] = warm_fail(?bo, sink, res_manifest.err);
        ret r;
    }
    var m: manifest.Manifest = res_manifest.ok;

    var req: request.BuildRequest =
        request.for_cell(?bp.request, planned.owner, planned.sel_target, planned.sel_artifact, planned.want_lib,
        planned.subsystem, planned.goal);

    val begin_r: res[driver.Project, fail.Fail] = driver.begin_build(s, ?m, ?req, pr);
    if (sel begin_r.err) {
        readout.diagnostics(sink, ?s.sources, ?s.diags);
        ret warm_fail(?bo, sink, begin_r.err);
    }
    var p: driver.Project = begin_r.ok;

    # a dependency's cell replans in the scope its configuration realized
    var scope: manifest.Scope = manifest.root_scope(?m);
    if (p.config.dependency_owned) { scope = manifest.dependency_scope(?m, ?p.config.owner.manifest); }
    val replan_r: res[build_plan.BuildUnit, fail.Fail] = build_plan.replan_unit(?call_alloc, ?s.interner, s.registry, ?scope, ?req, planned);
    if (sel replan_r.err) {
        driver.dnit_project(?p);
        val r: res[outcome.BuildOutcome, fail.Fail] = warm_fail(?bo, sink, replan_r.err);
        ret r;
    }
    var cell: build_plan.BuildUnit  = replan_r.ok;
    val unit: *build_plan.BuildUnit = ?cell;
    # the cell's objects live in its obj directory, which is the object cache
    p.object_dir = unit.obj_dir;
    p.cache_dir  = unit.cache_dir;
    p.out_dir    = unit.out_dir;

    var st: UnitState;
    st.inputs        = nil;
    st.obj_len       = 0;
    st.dynlibs       = nil;
    st.dynlib_len    = 0;
    st.out_path      = nil;
    st.scope.have    = false;
    st.scope.pick    = nil;
    st.scope.sel_len = 0;

    var result:        err[fail.Fail]    = err[fail.Fail].ok{};
    var failed_origin: diagnostic.Origin = diagnostic.ORIGIN_BUILD;
    var pi:            usize             = 0;
    for (pi < unit.phases.len) {
        result = run_phase(unit.phases.data[pi], ?p, unit, ?st, ?bo, oa);
        if (sel result.err) {
            failed_origin = build_plan.phase_origin(unit.phases.data[pi]);
            brk;
        }
        pi = pi + 1;
    }

    val result_ok3: bool = sel result.ok && req.goal == request.GOAL_TEST_LIST;
    if (result_ok3) {
        result = list_tests(?p, unit, ?st, ?bo, oa);
    }

    val result_ok4: bool = sel result.ok;
    if (result_ok4) {
        result = record_artifact(?p, unit, ?st, ?bo);
    }

    if (st.out_path != nil) { st.out_path = unit.out_path::*u8; }
    release_outputs(?p, ?st);
    val refreshed: err[fail.Fail] = driver.refresh_diagnostics(?p);
    if (sel result.err) {
        var f: fail.Fail = result.err;
        readout.failure(sink, ?f, failed_origin);
    }
    if (sel refreshed.err) {
        var failure: fail.Fail = refreshed.err;
        readout.failure(sink, ?failure, diagnostic.ORIGIN_BUILD);
        outcome.fold_fail(?bo, ?failure);
        val result_ok: bool = sel result.ok;
        if (result_ok) { result = refreshed; }
    }
    if (sel result.ok && pr != nil && req.goal != request.GOAL_CHECK) {
        emit_unit_summary(?p, ?st);
    }

    readout.diagnostics(sink, ?s.sources, ?s.diags);
    build_testing.free_scope(?p, ?st.scope);
    pcg_sweep_staged(?p);
    driver.dnit_project(?p);

    if (sel result.err) {
        var f: fail.Fail = result.err;
        outcome.fold_fail(?bo, ?f);
    }
    ret res[outcome.BuildOutcome, fail.Fail].ok{bo};
}

# execute_warm over every planned cell in order, merged into one outcome the way
# execute merges its cold units: blocked units recorded and skipped, a failed unit
# recorded and the rest still run, the severity the worst unit's
# ---
# bp:   the plan, read only
# s:    the warm session
# oa:   owns the returned outcome
# sink: where every unit's events are sent as they happen; nil for none
# ret:  the merged outcome, released with outcome.outcome_dnit, or an engine failure
# the plan is one round of the session's active retainer: every unit's modules stay held until the plan
# ends, so one unit never releases another's, and a plan that stops early or fails keeps what it had
#[testing]
pub fun execute_warm_all(bp: *build_plan.BuildPlan, s: *session.Session, oa: *A.Allocator,
    sink: *readout.Sink) res[outcome.BuildOutcome, fail.Fail] {
    val t:            *retention.Retention = ?s.retention;
    val prior_rounds: bool                 = t.rounds;
    var finished:     bool                 = false;
    t.rounds = false;
    val ran: res[outcome.BuildOutcome, fail.Fail] = execute_warm_units(bp, s, oa, sink, ?finished);
    t.rounds = prior_rounds;
    var kept:  err[fail.Fail] = retention.end_round(t, t.active, finished);
    val ended: bool           = sel kept.ok;
    if (ended) { kept = retention.retire(t, ?s.queries); }
    if (sel kept.err) {
        if (sel ran.ok) {
            var bo: outcome.BuildOutcome = ran.ok;
            outcome.outcome_dnit(?bo);
            ret res[outcome.BuildOutcome, fail.Fail].err{kept.err};
        }
    }
    ret ran;
}

#[testing]
fun execute_warm_units(bp: *build_plan.BuildPlan, s: *session.Session, oa: *A.Allocator,
    sink: *readout.Sink, finished: *bool) res[outcome.BuildOutcome, fail.Fail] {
    var bo:     outcome.BuildOutcome = outcome.outcome_init(oa);
    var failed: Vector[str]          = collections_vector.init[str](oa);

    var i: usize = 0;
    for (i < bp.units.len) {
        val unit: *build_plan.BuildUnit = ?bp.units.data[i];
        readout.unit(sink, unit.label, unit.sel_target, unit.profile, request.goal_verb(unit.goal), unit.has_artifact);

        val blocked_by: res[opt[str], fail.Fail] = blocking_requirement(oa, ?failed, unit);
        if (sel blocked_by.err) {
            outcome.outcome_dnit(?bo);
            ret res[outcome.BuildOutcome, fail.Fail].err{blocked_by.err};
        }
        if (sel blocked_by.ok.some) {
            val br: err[fail.Fail] = record_blocked_unit(?bo, sink, oa, ?failed, unit, blocked_by.ok.some);
            if (sel br.err) {
                outcome.outcome_dnit(?bo);
                ret res[outcome.BuildOutcome, fail.Fail].err{br.err};
            }
            i = i + 1;
            cnt;
        }

        val ur: res[outcome.BuildOutcome, fail.Fail] = execute_warm(bp, i, s, oa, sink);
        if (sel ur.err) {
            var f: fail.Fail = ur.err;
            readout.failure(sink, ?f, diagnostic.ORIGIN_BUILD);
            outcome.fold_fail(?bo, ?f);
            val pr: res[usize, A.Error] = collections_vector.push[str](?failed, unit.label);
            if (sel pr.err) {
                outcome.outcome_dnit(?bo);
                ret res[outcome.BuildOutcome, fail.Fail].err{fail.message("out of memory")};
            }
        }
        if (sel ur.ok) {
            var ubo: outcome.BuildOutcome = ur.ok;
            if (ubo.severity != outcome.BUILD_OK) {
                val fr: res[usize, A.Error] = collections_vector.push[str](?failed, unit.label);
                if (sel fr.err) {
                    outcome.outcome_dnit(?ubo);
                    outcome.outcome_dnit(?bo);
                    ret res[outcome.BuildOutcome, fail.Fail].err{fail.message("out of memory")};
                }
            }
            val mr: err[A.Error] = outcome.merge(?bo, ?ubo);
            if (sel mr.err) {
                outcome.outcome_dnit(?ubo);
                outcome.outcome_dnit(?bo);
                ret res[outcome.BuildOutcome, fail.Fail].err{fail.message("failed to merge build outcome")};
            }
        }
        i = i + 1;
    }
    # a failed or blocked unit left its modules unloaded, so the plan counts as unfinished
    @finished = failed.len == 0;
    ret res[outcome.BuildOutcome, fail.Fail].ok{bo};
}

fun pcg_sweep_staged(p: *driver.Project) {
    project.release_all_staged(p);
}

fun warm_fail(bo: *outcome.BuildOutcome, sink: *readout.Sink, f: fail.Fail) res[outcome.BuildOutcome, fail.Fail] {
    var fv: fail.Fail = f;
    readout.failure(sink, ?fv, diagnostic.ORIGIN_BUILD);
    outcome.fold_fail(bo, ?fv);
    ret res[outcome.BuildOutcome, fail.Fail].ok{@bo};
}

fun plan_module_outputs(p: *driver.Project, base: str, suffix: str) res[*str, fail.Fail] {
    if (p.emit_len == 0) { ret res[*str, fail.Fail].ok{nil}; }
    val allocated: res[*str, A.Error] = A.zallocate[str](p.alloc, p.emit_len::usize);
    if (sel allocated.err) {
        ret res[*str, fail.Fail].err{fail.refused(allocated.err)};
    }
    val destinations: *str = allocated.ok;
    var complete:     bool = false;
    fin {
        if (!complete) { release_names(p, destinations); }
    }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m:   *driver.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        val fqn: opt[str]            = intern.get(?p.s.interner, m.fqn);
        if (sel fqn.none) {
            ret res[*str, fail.Fail].err{fail.message("module FQN not interned")};
        }
        val name_r: res[str, fail.Fail] = output.mirror_fqn(p.alloc, base, fqn.some, suffix);
        if (sel name_r.err) {
            ret res[*str, fail.Fail].err{name_r.err};
        }
        val name:     str            = name_r.ok;
        val reserved: err[fail.Fail] = reserve_output(p, name);
        if (sel reserved.err) {
            str_free(p.alloc, name);
            ret res[*str, fail.Fail].err{reserved.err};
        }
        destinations[i] = name;
        i               = i + 1;
    }
    complete = true;
    ret res[*str, fail.Fail].ok{destinations};
}

# an output's parent directory exists before its phase runs; the file itself
# is written in place, a build product regenerable by the next build
fun reserve_output(p: *driver.Project, name: str) err[fail.Fail] {
    ret output.reserve(p.alloc, p.out_dir, name);
}

fun plan_outputs(p: *driver.Project, unit: *build_plan.BuildUnit, st: *UnitState) err[fail.Fail] {
    val goal:    request.BuildGoal = p.req.goal;
    val flat:    bool              = p.target.of != nil && p.target.of.produces_image;
    val objects: bool              = (goal == request.GOAL_ARTIFACT && !flat)
        || goal == request.GOAL_OBJECTS || goal == request.GOAL_TESTS;
    if (objects) {
        val planned: res[*str, fail.Fail] = plan_module_outputs(p, unit.obj_dir, p.target.of.object_ext);
        if (sel planned.err) { ret err[fail.Fail].err{planned.err}; }
        st.objects = planned.ok;
    }
    if (p.req.emit_ir) {
        val planned: res[*str, fail.Fail] = plan_module_outputs(p, unit.ir_dir, "ir");
        if (sel planned.err) { ret err[fail.Fail].err{planned.err}; }
        st.ir_outputs = planned.ok;
    }
    if (p.req.emit_asm) {
        val planned: res[*str, fail.Fail] = plan_module_outputs(p, unit.asm_dir, "s");
        if (sel planned.err) { ret err[fail.Fail].err{planned.err}; }
        st.asm_outputs = planned.ok;
    }
    if (goal == request.GOAL_ARTIFACT || goal == request.GOAL_TESTS) {
        val reserved: err[fail.Fail] = reserve_output(p, unit.out_path);
        if (sel reserved.err) { ret reserved; }
        st.artifact = unit.out_path;
    }
    if (goal == request.GOAL_TESTS) {
        val name_r: res[str, A.Error] = types_path.join(p.alloc, unit.test_dir, "dispatch.o");
        if (sel name_r.err) { ret err[fail.Fail].err{fail.refused(name_r.err)}; }
        val name:     str            = name_r.ok;
        val reserved: err[fail.Fail] = reserve_output(p, name);
        if (sel reserved.err) {
            str_free(p.alloc, name);
            ret reserved;
        }
        st.dispatcher = name;
        val planned: res[*str, fail.Fail] = plan_test_outputs(p);
        if (sel planned.err) { ret err[fail.Fail].err{planned.err}; }
        st.test_objects = planned.ok;
    }
    ret err[fail.Fail].ok{};
}

# `obj/<project>/<module>.test.o` for each emitted module with a test object
fun plan_test_outputs(p: *driver.Project) res[*str, fail.Fail] {
    if (p.emit_len == 0) { ret res[*str, fail.Fail].ok{nil}; }
    val allocated: res[*str, A.Error] = A.zallocate[str](p.alloc, p.emit_len::usize);
    if (sel allocated.err) { ret res[*str, fail.Fail].err{fail.refused(allocated.err)}; }
    val destinations: *str = allocated.ok;
    var complete:     bool = false;
    fin {
        if (!complete) { release_names(p, destinations); }
    }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *driver.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (passes.has_test_object(p, m)) {
            val named: res[str, fail.Fail] = cache.test_object_path(p, m, p.alloc);
            if (sel named.err) { ret res[*str, fail.Fail].err{named.err}; }
            destinations[i] = named.ok;
            val reserved: err[fail.Fail] = reserve_output(p, named.ok);
            if (sel reserved.err) { ret res[*str, fail.Fail].err{reserved.err}; }
        }
        i = i + 1;
    }
    complete = true;
    ret res[*str, fail.Fail].ok{destinations};
}

fun release_names(p: *driver.Project, names: *str) {
    if (names == nil) { ret; }
    var i: usize = 0;
    for (i < p.emit_len::usize) {
        if (names[i] != nil) { str_free(p.alloc, names[i]); }
        i = i + 1;
    }
    A.deallocate[str](p.alloc, names, p.emit_len::usize);
}

fun release_outputs(p: *driver.Project, st: *UnitState) {
    release_names(p, st.objects);
    release_names(p, st.test_objects);
    release_names(p, st.ir_outputs);
    release_names(p, st.asm_outputs);
    st.objects      = nil;
    st.test_objects = nil;
    st.ir_outputs   = nil;
    st.asm_outputs  = nil;
    if (st.dispatcher != nil) {
        str_free(p.alloc, st.dispatcher);
        st.dispatcher = nil;
    }
    st.artifact = nil;
}

fun run_phase(ph: build_plan.PhaseKind, p: *driver.Project, unit: *build_plan.BuildUnit, st: *UnitState,
    bo: *outcome.BuildOutcome, oa: *A.Allocator) err[fail.Fail] {
    val phase_name_r: opt[str] = build_plan.phase_name(ph);
    if (sel phase_name_r.none) {
        ret err[fail.Fail].err{build_plan.unknown_phase(oa, ph)};
    }
    var result: err[fail.Fail] = err[fail.Fail].err{fail.message("unknown build phase")};
    if (ph == build_plan.PH_STEPS)     { result = driver.run_steps_phase(p); }
    if (ph == build_plan.PH_DEP_STEPS) { result = driver.run_dep_steps_phase(p); }
    if (ph == build_plan.PH_LOAD)      { result = load_phase(p); }
    if (ph == build_plan.PH_SEMA)      { result = driver.run_sema_pass(p); }
    if (ph == build_plan.PH_LOWER)     { result = lower_phase(p, st, bo); }
    if (ph == build_plan.PH_CODEGEN) {
        result = plan_outputs(p, unit, st);
        val result_ok: bool = sel result.ok;
        if (result_ok) { result = codegen_phase(p, st); }
    }
    if (ph == build_plan.PH_TEST) { result = test_phase(p, st); }
    if (ph == build_plan.PH_EMIT) { result = emit_phase(p, unit, st, bo); }
    if (ph == build_plan.PH_LINK) { result = link_phase(p, unit, st, bo, oa); }

    if (sel result.err) { ret result; }
    if (ph == build_plan.PH_LOAD || ph == build_plan.PH_SEMA) {
        val status: fail.PhaseStatus = driver.frontend_status(p);
        if (!sel status.kind.accepted) { ret err[fail.Fail].err{fail.phase_failure(status)}; }
    }
    ret result;
}

test run_phase__unknown_catalog_member_is_internal_before_execution {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val link: opt[str] = build_plan.phase_name(build_plan.PH_LINK);
    if (sel link.none)                  { ret 2; }
    if (!str_equals(link.some, "link")) { ret 2; }
    val phase_name_r: opt[str] = build_plan.phase_name(255::build_plan.PhaseKind);
    if (sel phase_name_r.some) { ret 3; }
    val result: err[fail.Fail] = run_phase(255::build_plan.PhaseKind, nil, nil, nil, nil, ?a);
    if (sel result.ok) { ret 4; }
    val failure: fail.Fail = result.err;
    fin { fail.dnit(?a, failure); }
    if (!sel failure.message)                               { ret 5; }
    if (!str_contains(fail.describe(failure), "PhaseKind")) { ret 5; }
    if (!str_contains(fail.describe(failure), "255"))       { ret 5; }
    ret 0;
}

fun load_phase(p: *driver.Project) err[fail.Fail] {
    val lr: err[fail.Fail] = driver.run_load_phase(p);
    if (sel lr.err) { ret lr; }
    if (project.module_count(p) == 0) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.PROJECT_EMPTY, "project graph is empty; the entrypoint loaded no modules")};
    }
    ret err[fail.Fail].ok{};
}

# tests are gathered in module order from the lowered test ir, or from the facts
# a restored test object carries, so a cached test build lists the same tests in
# the same order as a clean one
fun collect_test_scope(p: *driver.Project, st: *UnitState) err[fail.Fail] {
    var col: testrunner.Collected = testrunner.collected_init();
    var i:   u32                  = 0;
    for (i < project.module_count(p)) {
        val gathered: err[fail.Fail] = cache.collect_tests(p, project.module_at(p, i), i, ?col);
        if (sel gathered.err) {
            testrunner.free(p.s, ?col);
            ret err[fail.Fail].err{gathered.err};
        }
        i = i + 1;
    }
    ret build_testing.collect_scope(p, col, ?st.scope);
}

fun current_image_headers(p: *driver.Project) res[*target_of.ObjectImage, fail.Fail] {
    val allocated: res[*target_of.ObjectImage, A.Error] = A.zallocate[target_of.ObjectImage](p.alloc, project.module_count(p)::usize);
    if (sel allocated.err) {
        ret res[*target_of.ObjectImage, fail.Fail].err{fail.refused(allocated.err)};
    }
    val headers: *target_of.ObjectImage = allocated.ok;
    var i:       u32                    = 0;
    for (i < p.emit_len) {
        val mid:     session.ModuleId       = p.topo[i];
        val current: *target_of.ObjectImage = project.module_at(p, mid::u32).object_image;
        if (current == nil) {
            A.deallocate[target_of.ObjectImage](p.alloc, headers, project.module_count(p)::usize);
            ret res[*target_of.ObjectImage, fail.Fail].err{fail.message("image publication requires a current codegen module")};
        }
        headers[mid::u32] = @current;
        i                 = i + 1;
    }
    ret res[*target_of.ObjectImage, fail.Fail].ok{headers};
}

# the lower and optimize rows count the modules that lowered: a module whose
# object the load restored does not
fun lower_phase(p: *driver.Project, st: *UnitState, bo: *outcome.BuildOutcome) err[fail.Fail] {
    readout.phase_begin(p.progress, readout.LOWER);
    readout.phase_begin(p.progress, readout.OPTIMIZE);
    readout.phase_carved(p.progress, readout.OPTIMIZE);

    val res_lower: err[fail.Fail] = driver.run_lower_pass(p);
    if (sel res_lower.err) { ret res_lower; }

    val lowered: u32 = cache.lowered_count(p);
    readout.phase_end(p.progress, readout.LOWER, lowered, "module", "modules");
    readout.phase_end(p.progress, readout.OPTIMIZE, lowered, "module", "modules");
    ret err[fail.Fail].ok{};
}

# a test build's test objects: each lowered against its module's normal object and
# generated, or restored from `obj/`, read out as a test lower row and a test
# codegen row. the tests they hold are collected here
fun test_phase(p: *driver.Project, st: *UnitState) err[fail.Fail] {
    readout.phase_begin(p.progress, readout.TEST_LOWER);
    project.set_origin(p, diagnostic.ORIGIN_CODEGEN);

    var roots: Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    val rooted: err[fail.Fail] = driver.append_test_roots(p, ?roots);
    if (sel rooted.err) { ret rooted; }
    var objects: u32 = 0;
    var i:       u32 = 0;
    for (i < p.emit_len) {
        if (passes.has_test_object(p, project.module_at(p, p.topo[i]::u32))) { objects = objects + 1; }
        i = i + 1;
    }
    val started: res[query.Operation, fail.Fail] = driver.begin_query_phase(p);
    if (sel started.err) { ret err[fail.Fail].err{started.err}; }
    val operation:  query.Operation = started.ok;
    var result:     err[fail.Fail]  = passes.acquire_test_inputs(p);
    val lowered_ok: bool            = sel result.ok;
    if (lowered_ok) {
        readout.phase_end(p.progress, readout.TEST_LOWER, objects, "object", "objects");
        readout.phase_begin(p.progress, readout.TEST_CODEGEN);
    }
    val parallel_ok: bool = sel result.ok && pcg_enabled(p);
    if (parallel_ok) {
        val parallel: err[fail.Fail] = run_codegen_parallel(p, true);
        if (sel parallel.err) { result = err[fail.Fail].err{parallel.err}; }
    }
    val result_ok: bool = sel result.ok;
    if (result_ok) { result = passes.run_test_object_pass(p); }
    val finished: err[fail.Fail] = driver.finish_query_phase(p, operation, roots.data, roots.len, result);
    if (sel finished.err) { ret finished; }

    val collected: err[fail.Fail] = collect_test_scope(p, st);
    if (sel collected.err) { ret collected; }
    readout.phase_end(p.progress, readout.TEST_CODEGEN, objects, "object", "objects");
    ret err[fail.Fail].ok{};
}

fun codegen_phase(p: *driver.Project, st: *UnitState) err[fail.Fail] {
    readout.phase_begin(p.progress, readout.CODEGEN);
    project.set_origin(p, diagnostic.ORIGIN_CODEGEN);
    val prepared: err[fail.Fail] = passes.prepare_codegen_pass(p);
    if (sel prepared.err) { ret prepared; }

    var roots: Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    val frontend: err[fail.Fail] = driver.append_frontend_roots(p, ?roots);
    if (sel frontend.err) { ret frontend; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m:       *driver.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        val key:     u64                 = passes.back_half_key_for(p, m);
        val lowered: res[usize, A.Error] = collections_vector.push[query.QueryKey](?roots,
            query.QueryKey{kind: query.Q_LOWER, key: key});
        if (sel lowered.err) {
            ret err[fail.Fail].err{fail.refused(lowered.err)};
        }
        val emitted: res[usize, A.Error] = collections_vector.push[query.QueryKey](?roots,
            query.QueryKey{kind: query.Q_CODEGEN, key: key});
        if (sel emitted.err) {
            ret err[fail.Fail].err{fail.refused(emitted.err)};
        }
        i = i + 1;
    }
    val started: res[query.Operation, fail.Fail] = driver.begin_query_phase(p);
    if (sel started.err) {
        ret err[fail.Fail].err{started.err};
    }
    val operation:  query.Operation = started.ok;
    var result:     err[fail.Fail]  = passes.acquire_codegen_inputs(p);
    val result_ok3: bool            = sel result.ok && pcg_enabled(p);
    if (result_ok3) {
        val parallel: err[fail.Fail] = run_codegen_parallel(p, false);
        if (sel parallel.err) {
            result = err[fail.Fail].err{parallel.err};
        }
    }
    val result_ok2: bool = sel result.ok;
    if (result_ok2) { result = passes.run_codegen_pass(p); }
    val result2: err[fail.Fail] = driver.finish_query_phase(p, operation, roots.data, roots.len, result);
    if (sel result2.err) { ret result2; }

    readout.phase_end(p.progress, readout.CODEGEN, cache.generated_count(p), "module", "modules");
    ret err[fail.Fail].ok{};
}

fun emit_phase(p: *driver.Project, unit: *build_plan.BuildUnit, st: *UnitState,
    bo: *outcome.BuildOutcome) err[fail.Fail] {
    val goal: request.BuildGoal = p.req.goal;
    val flat: bool              = p.target.of != nil && p.target.of.produces_image;

    readout.phase_begin(p.progress, readout.EMIT);

    if (p.req.emit_ir || p.req.emit_asm) {
        var i: u32 = 0;
        for (i < p.emit_len) {
            val mid: session.ModuleId    = p.topo[i];
            val m:   *driver.ModuleEntry = project.module_at(p, mid::u32);
            if (m.ir_module == nil) { ret err[fail.Fail].err{fail.message("ir and asm emission require a current lowered module")}; }
            if (p.req.emit_ir) {
                val res_ir: err[fail.Fail] = build_emit.emit_ir(p, st.ir_outputs[i], m.ir_module);
                if (sel res_ir.err) {
                    ret err[fail.Fail].err{res_ir.err};
                }
            }
            if (p.req.emit_asm) {
                val res_asm: err[fail.Fail] = build_emit.emit_asm(p, st.asm_outputs[i], m.ir_module);
                if (sel res_asm.err) {
                    ret err[fail.Fail].err{res_asm.err};
                }
            }
            i = i + 1;
        }
    }

    if (goal == request.GOAL_OBJECTS && flat) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "a flat-image object format produces only executables; library and '--emit obj' outputs are unsupported")};
    }

    if (goal == request.GOAL_TESTS && build_plan.finished_modules(?p.target)) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "a finished-module object format produces no executable; this target cannot build or run tests")};
    }

    if (build_plan.finished_modules(?p.target) && p.target_entry != nil
        && p.target_entry.mode == driver.MODE_LIBRARY) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "a finished-module object format has no archive or shared-library form; each module is its own artifact")};
    }

    if (goal == request.GOAL_TESTS) {
        if (st.scope.sel_len == 0) {
            readout.phase_end(p.progress, readout.EMIT, 0, "object", "objects");
            ret err[fail.Fail].ok{};
        }
    }

    val objects: bool = (goal == request.GOAL_ARTIFACT && !flat)
        || goal == request.GOAL_OBJECTS
        || goal == request.GOAL_TESTS;
    if (objects) {
        val borrowed: res[*target_of.ObjectImage, fail.Fail] = current_image_headers(p);
        if (sel borrowed.err) { ret err[fail.Fail].err{borrowed.err}; }
        val images: *target_of.ObjectImage = borrowed.ok;
        fin { A.deallocate[target_of.ObjectImage](p.alloc, images, project.module_count(p)::usize); }
        val oc: err[fail.Fail] = build_emit.write_objects(p, images, st.objects, ?st.inputs);
        if (sel oc.err) { ret oc; }
        st.obj_len = p.emit_len;
    }
    if (goal == request.GOAL_TESTS) {
        val tc: err[fail.Fail] = build_emit.write_test_objects(p, st.test_objects);
        if (sel tc.err) { ret tc; }
    }

    if (goal == request.GOAL_OBJECTS) {
        st.out_path = unit.out_path::*u8;
    }

    if (objects) { readout.phase_end(p.progress, readout.EMIT, st.obj_len, "object", "objects"); }
    or           { readout.phase_end(p.progress, readout.EMIT, p.emit_len, "module", "modules"); }
    ret err[fail.Fail].ok{};
}

fun artifact_digest(path: *u8, out: *u8) err[fail.Fail] {
    val rr: err[fail.Fail] = build_fingerprint.file_sha256(path::str, out);
    if (sel rr.err) {
        ret err[fail.Fail].err{rr.err};
    }
    ret err[fail.Fail].ok{};
}

# whether the artifact on disk is the one this revision's link published; one
# relinked, missing, or never published at this revision is not
fun artifact_reusable(s: *session.Session, relinked: bool, artifact: *u8, revision: query.Revision) res[bool, fail.Fail] {
    if (relinked) { ret res[bool, fail.Fail].ok{false}; }
    val is_file_r: res[bool, io_error.Error] = fs.is_file(artifact::str);
    if (sel is_file_r.err) {
        if (is_file_r.err.kind == io_error.NOT_FOUND) { ret res[bool, fail.Fail].ok{false}; }
        ret res[bool, fail.Fail].err{fail.environment(diagnostic_kind.FS_STAT, fail.io_text(is_file_r.err))};
    }
    if (!is_file_r.ok) { ret res[bool, fail.Fail].ok{false}; }
    val recorded: opt[[32]u8] = session.link_publication_at(s, artifact::str, revision);
    if (sel recorded.none) { ret res[bool, fail.Fail].ok{false}; }
    var want: [32]u8         = recorded.some;
    var cur:  [32]u8;
    val d_r:  err[fail.Fail] = artifact_digest(artifact, ?cur[0]);
    if (sel d_r.err) { ret res[bool, fail.Fail].err{d_r.err}; }
    ret res[bool, fail.Fail].ok{memory.raw_equal((?cur[0])::ptr, (?want[0])::ptr, 32::usize)};
}

fun record_artifact_publication(s: *session.Session, artifact: *u8, revision: query.Revision) err[fail.Fail] {
    if (query.peek_revision(?s.queries, query.Q_LINK, 0) != revision) {
        ret err[fail.Fail].err{fail.message("the link query's revision moved while the artifact was being written")};
    }
    var d:   [32]u8;
    val d_r: err[fail.Fail] = artifact_digest(artifact, ?d[0]);
    if (sel d_r.err) { ret d_r; }
    val rec_r: err[fail.Fail] = session.record_link_publication(s, artifact::str, revision, ?d);
    if (sel rec_r.err) { ret err[fail.Fail].err{rec_r.err}; }
    ret err[fail.Fail].ok{};
}

fun link_phase(p: *driver.Project, unit: *build_plan.BuildUnit, st: *UnitState,
    bo: *outcome.BuildOutcome, oa: *A.Allocator) err[fail.Fail] {
    val goal: request.BuildGoal = p.req.goal;
    project.set_origin(p, diagnostic.ORIGIN_LINK);

    readout.phase_begin(p.progress, readout.LINK);
    val t_link: readout.Instant = readout.item_begin(p.progress);

    if (goal == request.GOAL_TESTS) {
        if (st.scope.sel_len == 0) {
            readout.phase_end(p.progress, readout.LINK, 0, "binary", "binaries");
            ret err[fail.Fail].ok{};
        }
        val dr: err[fail.Fail] = link_dispatch_phase(p, unit, st, t_link);
        if (sel dr.err) { ret dr; }
        val rr: err[fail.Fail] = build_testing.record_tests(p, ?st.scope, unit.out_path::*u8,
            intern.text(?p.s.interner, unit.target_entry.name), unit.profile, bo, oa);
        if (sel rr.err) { ret rr; }
        st.out_path = unit.out_path::*u8;
        readout.item(p.progress, readout.LINK, unit.out_path, t_link);
        readout.phase_end(p.progress, readout.LINK, 1, "binary", "binaries");
        ret err[fail.Fail].ok{};
    }

    val te: *driver.TargetEntry = p.target_entry;
    if (te == nil) { ret err[fail.Fail].err{fail.message("no target selected")}; }

    if (p.target.of != nil && p.target.of.produces_image) {
        if (te.mode == driver.MODE_LIBRARY) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "a flat-image object format produces only executables; library and '--emit obj' outputs are unsupported")};
        }
        ret link_flat(p, unit, st, t_link);
    }
    if (build_plan.finished_modules(?p.target)) {
        ret link_finished(p, unit, st, t_link);
    }

    if (te.mode == driver.MODE_LIBRARY) {
        if (te.lib_kind == manifest.LIBKIND_STATIC) {
            val borrowed: res[*target_of.ObjectImage, fail.Fail] = current_image_headers(p);
            if (sel borrowed.err) { ret err[fail.Fail].err{borrowed.err}; }
            val images: *target_of.ObjectImage = borrowed.ok;
            fin { A.deallocate[target_of.ObjectImage](p.alloc, images, project.module_count(p)::usize); }
            val arc_r: err[fail.Fail] = build_emit.emit_static_archive(p, st.artifact, images, st.inputs, ?st.out_path);
            if (sel arc_r.err) { ret arc_r; }
            readout.phase_end(p.progress, readout.LINK, 1, "archive", "archives");
            ret err[fail.Fail].ok{};
        }
        if (te.lib_kind == manifest.LIBKIND_SHARED) {
            val ext_r: err[fail.Fail] = build_emit.append_external_inputs(p, unit, ?st.inputs, ?st.obj_len, ?st.dynlibs, ?st.dynlib_len);
            if (sel ext_r.err) { ret ext_r; }
            var so_r: err[fail.Fail] = err[fail.Fail].ok{};
            if (p.target.of.links_from_image) {
                val borrowed: res[*target_of.ObjectImage, fail.Fail] = current_image_headers(p);
                if (sel borrowed.err) { ret err[fail.Fail].err{borrowed.err}; }
                val images: *target_of.ObjectImage = borrowed.ok;
                fin { A.deallocate[target_of.ObjectImage](p.alloc, images, project.module_count(p)::usize); }
                so_r = build_emit.link_shared_images(p, images, ?st.inputs[p.emit_len], st.obj_len - p.emit_len,
                    st.dynlibs, st.dynlib_len, st.artifact, ?st.out_path);
            }
            or {
                so_r = build_emit.emit_shared_library(p, st.artifact, st.inputs, st.obj_len, st.dynlibs, st.dynlib_len, ?st.out_path);
            }
            if (sel so_r.err) { ret so_r; }
            readout.phase_end(p.progress, readout.LINK, 1, "library", "libraries");
            ret err[fail.Fail].ok{};
        }
        st.out_path = unit.obj_dir::*u8;
        readout.phase_end(p.progress, readout.LINK, st.obj_len, "object", "objects");
        ret err[fail.Fail].ok{};
    }

    val ext_r: err[fail.Fail] = build_emit.append_external_inputs(p, unit, ?st.inputs, ?st.obj_len, ?st.dynlibs, ?st.dynlib_len);
    if (sel ext_r.err) { ret ext_r; }

    val artifact: str = unit.out_path;

    val ext_from:  u32                                           = p.emit_len;
    val ext_count: u32                                           = st.obj_len - p.emit_len;
    val loaded_r:  res[build_emit.LoadedImageOptions, fail.Fail] = build_emit.load_image_options(p, linker.LINK_EXE, artifact::*u8);
    if (sel loaded_r.err) {
        ret err[fail.Fail].err{loaded_r.err};
    }
    var loaded: build_emit.LoadedImageOptions = loaded_r.ok;

    val cfg_r: err[fail.Fail] = set_link_config_input(p, artifact::*u8, build_emit.artifact_product_name(p), linker.LINK_EXE::u32,
        ?st.inputs[ext_from], ext_count, st.dynlibs, st.dynlib_len, ?loaded);
    if (sel cfg_r.err) {
        build_emit.dnit_image_options(p.alloc, ?loaded);
        ret cfg_r;
    }
    val relink_r: res[bool, fail.Fail] = driver.run_link_pass(p);
    if (sel relink_r.err) {
        build_emit.dnit_image_options(p.alloc, ?loaded);
        ret err[fail.Fail].err{relink_r.err};
    }
    val link_rev: query.Revision       = query.peek_revision(?p.s.queries, query.Q_LINK, 0);
    val reusable: res[bool, fail.Fail] = artifact_reusable(p.s, relink_r.ok, artifact::*u8, link_rev);
    if (sel reusable.err) {
        build_emit.dnit_image_options(p.alloc, ?loaded);
        ret err[fail.Fail].err{reusable.err};
    }
    if (reusable.ok) {
        st.out_path = artifact::*u8;
        readout.item(p.progress, readout.LINK, artifact, t_link);
        readout.phase_end(p.progress, readout.LINK, 1, "binary", "binaries");
        build_emit.dnit_image_options(p.alloc, ?loaded);
        ret err[fail.Fail].ok{};
    }

    val from_image: bool           = p.target.of.links_from_image;
    var res_link:   err[fail.Fail] = err[fail.Fail].ok{};
    if (from_image) {
        val borrowed: res[*target_of.ObjectImage, fail.Fail] = current_image_headers(p);
        if (sel borrowed.err) {
            build_emit.dnit_image_options(p.alloc, ?loaded);
            ret err[fail.Fail].err{borrowed.err};
        }
        val images: *target_of.ObjectImage = borrowed.ok;
        fin { A.deallocate[target_of.ObjectImage](p.alloc, images, project.module_count(p)::usize); }
        res_link = build_emit.link_mixed_images(p, images, ?st.inputs[ext_from], ext_count, st.dynlibs, st.dynlib_len, st.artifact, loaded.options);
    }
    if (!from_image) {
        res_link = build_emit.link_executable(p, st.inputs, st.obj_len, st.dynlibs, st.dynlib_len, st.artifact, loaded.options);
    }
    build_emit.dnit_image_options(p.alloc, ?loaded);
    if (sel res_link.err) { ret res_link; }

    val publish_r: err[fail.Fail] = record_artifact_publication(p.s, artifact::*u8, link_rev);
    if (sel publish_r.err) { ret publish_r; }

    st.out_path = artifact::*u8;
    readout.item(p.progress, readout.LINK, artifact, t_link);
    readout.phase_end(p.progress, readout.LINK, 1, "binary", "binaries");
    ret err[fail.Fail].ok{};
}

fun link_dispatch_phase(p: *driver.Project, unit: *build_plan.BuildUnit, st: *UnitState,
    t_link: readout.Instant) err[fail.Fail] {
    val artifact: str = unit.out_path;

    val in_r: res[build_testing.DispatchInputs, fail.Fail] = build_testing.collect_dispatch_inputs(p, unit);
    if (sel in_r.err) {
        ret err[fail.Fail].err{in_r.err};
    }
    var di: build_testing.DispatchInputs = in_r.ok;
    fin { build_testing.free_dispatch_inputs(p, ?di); }

    val cfg_r: err[fail.Fail] = set_dispatch_config_input(p, artifact::*u8,
        di.ext, di.ext_len, di.dynlibs, di.dynlib_len, ?st.scope);
    if (sel cfg_r.err) { ret cfg_r; }

    val relink_r: res[bool, fail.Fail] = driver.run_link_pass(p);
    if (sel relink_r.err) { ret err[fail.Fail].err{relink_r.err}; }
    val link_rev: query.Revision       = query.peek_revision(?p.s.queries, query.Q_LINK, 0);
    val reusable: res[bool, fail.Fail] = artifact_reusable(p.s, relink_r.ok, artifact::*u8, link_rev);
    if (sel reusable.err) { ret err[fail.Fail].err{reusable.err}; }
    if (reusable.ok)      { ret err[fail.Fail].ok{}; }

    val gathered: res[ImageList, fail.Fail] = test_link_images(p);
    if (sel gathered.err) { ret err[fail.Fail].err{gathered.err}; }
    var images: ImageList = gathered.ok;
    fin { A.deallocate[target_of.ObjectImage](p.alloc, images.data, images.cap::usize); }
    val lr: err[fail.Fail] = build_testing.link_dispatcher(p, ?st.scope, ?di, images.data, images.len, st.dispatcher, st.artifact);
    if (sel lr.err) { ret lr; }

    ret record_artifact_publication(p.s, artifact::*u8, link_rev);
}

rec ImageList {
    data: *target_of.ObjectImage;
    len:  u32;
    cap:  u32;
}

# the images a dispatcher links: every emitted module's test object, then every
# emitted module's normal object, in topological order
fun test_link_images(p: *driver.Project) res[ImageList, fail.Fail] {
    val cap:       u32                                  = p.emit_len * 2;
    val allocated: res[*target_of.ObjectImage, A.Error] = A.allocate[target_of.ObjectImage](p.alloc, cap::usize);
    if (sel allocated.err) { ret res[ImageList, fail.Fail].err{fail.refused(allocated.err)}; }
    var list: ImageList = ImageList{data: allocated.ok, len: 0, cap: cap};
    var i:    u32       = 0;
    for (i < p.emit_len) {
        val m: *driver.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.test.object_image != nil) {
            list.data[list.len] = @m.test.object_image;
            list.len            = list.len + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < p.emit_len) {
        val m: *driver.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.object_image == nil) {
            A.deallocate[target_of.ObjectImage](p.alloc, list.data, cap::usize);
            ret res[ImageList, fail.Fail].err{fail.message("a test link requires every module's current image")};
        }
        list.data[list.len] = @m.object_image;
        list.len            = list.len + 1;
        i                   = i + 1;
    }
    ret res[ImageList, fail.Fail].ok{list};
}

fun set_dispatch_config_input(p: *driver.Project, out_path: *u8,
    ext: *target_of.ObjectInput, ext_count: u32,
    dynlibs: *target_of.DynLib, dynlib_count: u32,
    sc: *build_testing.TestScope) err[fail.Fail] {
    var fb: wire.Sink = wire.grown(p.alloc);
    fin { wire.dnit(?fb); }
    write_link_config(?fb, p, out_path, build_emit.artifact_product_name(p),
        linker.LINK_EXE::u32, ext, ext_count, dynlibs, dynlib_count, nil);
    build_testing.fingerprint_scope(?fb, p, sc);
    ret set_link_config(p, ?fb);
}

fun link_flat(p: *driver.Project, unit: *build_plan.BuildUnit, st: *UnitState, t_link: readout.Instant) err[fail.Fail] {
    val artifact: str = unit.out_path;

    val cfg_r: err[fail.Fail] = set_link_config_input(p, artifact::*u8, build_emit.artifact_product_name(p), linker.LINK_EXE::u32, nil, 0, nil, 0, nil);
    if (sel cfg_r.err) { ret cfg_r; }
    val relink_r: res[bool, fail.Fail] = driver.run_link_pass(p);
    if (sel relink_r.err) { ret err[fail.Fail].err{relink_r.err}; }
    val link_rev: query.Revision       = query.peek_revision(?p.s.queries, query.Q_LINK, 0);
    val reusable: res[bool, fail.Fail] = artifact_reusable(p.s, relink_r.ok, artifact::*u8, link_rev);
    if (sel reusable.err) { ret err[fail.Fail].err{reusable.err}; }
    if (reusable.ok) {
        st.out_path = artifact::*u8;
        readout.item(p.progress, readout.LINK, artifact, t_link);
        readout.phase_end(p.progress, readout.LINK, 1, "binary", "binaries");
        ret err[fail.Fail].ok{};
    }

    val borrowed: res[*target_of.ObjectImage, fail.Fail] = current_image_headers(p);
    if (sel borrowed.err) { ret err[fail.Fail].err{borrowed.err}; }
    val images: *target_of.ObjectImage = borrowed.ok;
    fin { A.deallocate[target_of.ObjectImage](p.alloc, images, project.module_count(p)::usize); }
    val res_link: err[fail.Fail] = build_emit.link_flat_images(p, images, st.artifact,
        target_of.image_options_default(p.req.subsystem));
    if (sel res_link.err) { ret res_link; }

    val publish_r: err[fail.Fail] = record_artifact_publication(p.s, artifact::*u8, link_rev);
    if (sel publish_r.err) { ret publish_r; }

    st.out_path = artifact::*u8;
    readout.item(p.progress, readout.LINK, artifact, t_link);
    readout.phase_end(p.progress, readout.LINK, 1, "binary", "binaries");
    ret err[fail.Fail].ok{};
}

# a finished-module format has no linker: the entry module's object is already the
# whole artifact, so publishing it at the artifact path is the link
fun link_finished(p: *driver.Project, unit: *build_plan.BuildUnit, st: *UnitState, t_link: readout.Instant) err[fail.Fail] {
    val artifact: str = unit.out_path;

    val cfg_r: err[fail.Fail] = set_link_config_input(p, artifact::*u8, build_emit.artifact_product_name(p), linker.LINK_EXE::u32, nil, 0, nil, 0, nil);
    if (sel cfg_r.err) { ret cfg_r; }
    val relink_r: res[bool, fail.Fail] = driver.run_link_pass(p);
    if (sel relink_r.err) { ret err[fail.Fail].err{relink_r.err}; }
    val link_rev: query.Revision       = query.peek_revision(?p.s.queries, query.Q_LINK, 0);
    val reusable: res[bool, fail.Fail] = artifact_reusable(p.s, relink_r.ok, artifact::*u8, link_rev);
    if (sel reusable.err) { ret err[fail.Fail].err{reusable.err}; }
    if (!reusable.ok) {
        val borrowed: res[*target_of.ObjectImage, fail.Fail] = current_image_headers(p);
        if (sel borrowed.err) { ret err[fail.Fail].err{borrowed.err}; }
        val images: *target_of.ObjectImage = borrowed.ok;
        fin { A.deallocate[target_of.ObjectImage](p.alloc, images, project.module_count(p)::usize); }
        val published: err[fail.Fail] = build_emit.publish_entry_module(p, images, artifact);
        if (sel published.err) { ret published; }
        val publish_r: err[fail.Fail] = record_artifact_publication(p.s, artifact::*u8, link_rev);
        if (sel publish_r.err) { ret publish_r; }
    }

    st.out_path = artifact::*u8;
    readout.item(p.progress, readout.LINK, artifact, t_link);
    readout.phase_end(p.progress, readout.LINK, 1, "module", "modules");
    ret err[fail.Fail].ok{};
}

fun list_tests(p: *driver.Project, unit: *build_plan.BuildUnit, st: *UnitState, bo: *outcome.BuildOutcome, oa: *A.Allocator) err[fail.Fail] {
    ret build_testing.record_tests(p, ?st.scope, nil, intern.text(?p.s.interner, unit.target_entry.name), unit.profile, bo, oa);
}

fun record_artifact(p: *driver.Project, unit: *build_plan.BuildUnit, st: *UnitState, bo: *outcome.BuildOutcome) err[fail.Fail] {
    if (st.out_path == nil) { ret err[fail.Fail].ok{}; }

    var kind: outcome.ArtifactKind = outcome.ART_BINARY;
    if (p.req.goal == request.GOAL_OBJECTS) { kind = outcome.ART_OBJECTS; }
    or (p.req.goal == request.GOAL_TESTS)   { kind = outcome.ART_TESTS; }
    or (p.target_entry != nil && p.target_entry.mode == driver.MODE_LIBRARY) {
        kind = outcome.ART_OBJECTS;
        if (p.target_entry.lib_kind == manifest.LIBKIND_STATIC) { kind = outcome.ART_ARCHIVE; }
        if (p.target_entry.lib_kind == manifest.LIBKIND_SHARED) { kind = outcome.ART_SHARED; }
    }

    val rec_r: err[A.Error] = outcome.record_artifact(bo, kind, st.out_path::str);
    if (sel rec_r.err) { ret err[fail.Fail].err{fail.refused(rec_r.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_unit_summary(p: *driver.Project, st: *UnitState) {
    var out_str: str = "<output>";
    if (st.out_path != nil) { out_str = st.out_path::str; }

    val te:       *driver.TargetEntry = p.target_entry;
    val emit_obj: bool                = p.req.goal == request.GOAL_OBJECTS;
    val is_lib:   bool                = emit_obj || (te != nil && te.mode == driver.MODE_LIBRARY);

    if (!is_lib && st.out_path != nil) {
        val fi_r: res[fs.Metadata, io_error.Error] = fs.metadata(st.out_path::str);
        if (sel fi_r.ok) {
            readout.summary(p.progress, out_str, p.emit_len, fi_r.ok.size, true);
            ret;
        }
    }
    readout.summary(p.progress, out_str, p.emit_len, 0, false);
}

fun pcg_enabled(p: *driver.Project) bool {
    ret p.req.jobs >= 1 && p.emit_len > 0;
}

# publish the link configuration of a project as the Q_LINK_CONFIG query input: the
# output path, product name, link kind, external inputs, dynamic libraries with their
# provider policy, and the loaded-image options, fingerprinted so an unchanged
# configuration keeps its revision and any change invalidates the link
# ---
# p:   the project whose session holds the query db
# ret: ok, or the fingerprint or query failure
pub fun set_link_config_input(p: *driver.Project, out_path: *u8, product: *u8, out_kind: u32,
    ext: *target_of.ObjectInput, ext_count: u32,
    dynlibs: *target_of.DynLib, dynlib_count: u32,
    image: *build_emit.LoadedImageOptions) err[fail.Fail] {
    var fb: wire.Sink = wire.grown(p.alloc);
    fin { wire.dnit(?fb); }
    write_link_config(?fb, p, out_path, product, out_kind, ext, ext_count, dynlibs, dynlib_count, image);
    ret set_link_config(p, ?fb);
}

# the link configuration a sink holds, as the link's query input
fun set_link_config(p: *driver.Project, fb: *wire.Sink) err[fail.Fail] {
    val taken: res[query.QueryOutput, fail.Fail] = driver_query.output(fb);
    if (sel taken.err) { ret err[fail.Fail].err{taken.err}; }
    val si: err[fail.Fail] = query.set_input(?p.s.queries, query.Q_LINK_CONFIG, 0, taken.ok.bytes, taken.ok.len);
    if (taken.ok.bytes != nil) { A.deallocate[u8](p.alloc, taken.ok.bytes, taken.ok.len::usize); }
    ret si;
}

fun write_link_config(fb: *wire.Sink, p: *driver.Project, out_path: *u8, product: *u8, out_kind: u32,
    ext: *target_of.ObjectInput, ext_count: u32,
    dynlibs: *target_of.DynLib, dynlib_count: u32,
    image: *build_emit.LoadedImageOptions) {
    wire.put_u32(fb, out_kind);
    var pie_axis: u32 = 0;
    if (p.req.pie) { pie_axis = 1; }
    wire.put_u32(fb, pie_axis);
    build_fingerprint.put_text(fb, out_path::str);
    build_fingerprint.put_text(fb, product::str);
    build_fingerprint.put_domain_u8(fb, build_fingerprint.DOMAIN_SUBSYSTEM,
        target_of.SUBSYSTEM_CATALOG_VERSION, target_of.subsystem_fingerprint_tag(p.req.subsystem));

    var has_resources: u32 = 0;
    if (image != nil && image.resource != nil) { has_resources = 1; }
    wire.put_u32(fb, has_resources);
    if (has_resources != 0) {
        build_fingerprint.put_text(fb, image.icon_path);
        build_fingerprint.put_content(fb, image.icon_bytes.data, image.icon_bytes.len);
        build_fingerprint.put_text(fb, image.manifest_path);
        build_fingerprint.put_content(fb, image.manifest_bytes.data, image.manifest_bytes.len);
        build_fingerprint.put_text(fb, image.resource.version);
        build_fingerprint.put_text(fb, image.resource.internal_name);
        build_fingerprint.put_text(fb, image.resource.original_filename);
        build_fingerprint.put_text(fb, image.resource.product_name);
    }

    wire.put_u32(fb, ext_count);
    var i: u32 = 0;
    for (i < ext_count) {
        build_fingerprint.put_text(fb, ext[i].path::str);
        build_fingerprint.put_file(fb, ext[i].path::str);
        i = i + 1;
    }
    wire.put_u32(fb, dynlib_count);
    var j: u32 = 0;
    for (j < dynlib_count) {
        build_fingerprint.put_name(fb, ?p.s.interner, dynlibs[j].name);
        build_fingerprint.put_name(fb, ?p.s.interner, dynlibs[j].soname);
        build_fingerprint.put_name(fb, ?p.s.interner, dynlibs[j].rpath);
        var referenced: u8 = 0;
        if (dynlibs[j].include_referenced) { referenced = 1; }
        wire.put_u8(fb, referenced);
        j = j + 1;
    }
}

test link_config__provider_policy_invalidates_without_changing_names {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = session.init(?a);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    var p: driver.Project;
    project.init_project(?p, ?s);
    fin { driver.dnit_project(?p); }
    val name: res[intern.StrId, A.Error] = intern.add(?s.interner, "provider");
    if (sel name.err) { ret 3; }
    var lib: target_of.DynLib = target_of.DynLib{
        name:   name.ok,
        soname: name.ok,
        rpath:  intern.STR_NIL, include_referenced: false
    };
    val set_link_config_input_r: err[fail.Fail] = set_link_config_input(?p, "app", "app", linker.LINK_EXE::u32,
        nil, 0, ?lib, 1, nil);
    if (sel set_link_config_input_r.err) { ret 4; }
    val baseline: query.Revision = query.peek_revision(?s.queries, query.Q_LINK_CONFIG, 0);
    if (baseline == 0) { ret 5; }
    val set_link_config_input_r2: err[fail.Fail] = set_link_config_input(?p, "app", "app", linker.LINK_EXE::u32,
        nil, 0, ?lib, 1, nil);
    if (sel set_link_config_input_r2.err)                                    { ret 6; }
    if (query.peek_revision(?s.queries, query.Q_LINK_CONFIG, 0) != baseline) { ret 7; }
    lib.include_referenced = true;
    val set_link_config_input_r3: err[fail.Fail] = set_link_config_input(?p, "app", "app", linker.LINK_EXE::u32,
        nil, 0, ?lib, 1, nil);
    if (sel set_link_config_input_r3.err) { ret 8; }
    val changed: query.Revision = query.peek_revision(?s.queries, query.Q_LINK_CONFIG, 0);
    if (changed == baseline) { ret 9; }
    val set_link_config_input_r4: err[fail.Fail] = set_link_config_input(?p, "app", "app", linker.LINK_EXE::u32,
        nil, 0, ?lib, 1, nil);
    if (sel set_link_config_input_r4.err)                                   { ret 10; }
    if (query.peek_revision(?s.queries, query.Q_LINK_CONFIG, 0) != changed) { ret 11; }
    ret 0;
}

rec PcgWorker {
    ar:     arena.Arena;
    alloc:  A.Allocator;
    sess:   session.Session;
    active: bool;
}

# rejected: the worker's codegen refused the program. the pre-pass stages
# products only; the query pass recomputes a rejected module against the
# product store that owns its diagnostics, so the refusal is reported once
rec PcgSlot {
    image:    *target_of.ObjectImage;
    worker:   u32;
    failed:   bool;
    rejected: bool;
    fail:     fail.Fail;
}

rec ParallelCodegen {
    p:          *driver.Project;
    next:       i64;
    worker_seq: i64;
    stop:       i64;
    nworkers:   u32;
    workers:    *PcgWorker;
    slots:      *PcgSlot;
    stale:      *u32;
    stale_len:  u32;
    dbg:        codegen.DebugInfo;
    # generating the modules' test objects rather than their normal objects
    test: bool;
    # the readout row the generated objects are items of
    phase: readout.Phase;
}

# the ir a codegen worker generates for module m
fun pcg_ir(m: *driver.ModuleEntry, test: bool) *me_ir.Module {
    if (test) { ret m.test.ir_module; }
    ret m.ir_module;
}

fun pcg_worker_init(w: *PcgWorker, p: *driver.Project) err[fail.Fail] {
    w.active = false;
    val init_r: err[A.Error] = arena.init(?w.ar, p.s.backing, 0);
    if (sel init_r.err) { ret err[fail.Fail].err{fail.message("parallel codegen: worker arena init failed")}; }
    val make_r2: err[A.Error] = arena.make(?w.alloc, ?w.ar);
    if (sel make_r2.err) {
        arena.dnit(?w.ar);
        ret err[fail.Fail].err{fail.message("parallel codegen: worker arena bind failed")};
    }

    # the worker's session view borrows the project's registry by pointer;
    # the project session is its one owner and outlives every worker
    w.sess          = @p.s;
    w.sess.alloc    = ?w.alloc;
    w.sess.interner = intern.child_init(?p.s.interner, ?w.alloc);
    w.active        = true;
    ret err[fail.Fail].ok{};
}

fun pcg_worker_teardown(w: *PcgWorker) {
    if (!w.active) { ret; }
    arena.dnit(?w.ar);
    w.active = false;
}

fun pcg_stable_err(p: *driver.Project, msg: str) str {
    val kept: res[str, fail.Fail] = fail.text_retain(?p.s.interner, msg);
    if (sel kept.ok) { ret kept.ok; }
    ret "parallel codegen failed, and re-homing its diagnostic off the worker arena failed in turn (allocation failure)";
}

fun pcg_worker_main(arg: *u8) {
    val pc: *ParallelCodegen = arg::*ParallelCodegen;
    if (pc == nil) { ret; }
    val wid_raw: i64 = atomic.fetch_add(?pc.worker_seq, 1::i64);
    if (wid_raw < 0 || wid_raw >= pc.nworkers::i64) { ret; }
    val wid: u32        = wid_raw::u32;
    val w:   *PcgWorker = ?pc.workers[wid::usize];

    for (true) {
        if (atomic.load(?pc.stop) != 0) { ret; }
        val idx_raw: i64 = atomic.fetch_add(?pc.next, 1::i64);
        if (idx_raw >= pc.stale_len::i64) { ret; }
        val idx: u32 = idx_raw::u32;

        val mid:  session.ModuleId    = pc.p.topo[pc.stale[idx::usize]];
        val m:    *driver.ModuleEntry = project.module_at(pc.p, mid::u32);
        val slot: *PcgSlot            = ?pc.slots[idx::usize];
        slot.worker = wid;

        val t0: readout.Instant = readout.item_begin(pc.p.progress);

        val source: *me_ir.Module                      = pcg_ir(m, pc.test);
        val srcs_r: res[driver.CodeSources, fail.Fail] = driver.code_sources(pc.p, mid, source, ?w.alloc);
        if (sel srcs_r.err) {
            slot.fail   = srcs_r.err;
            slot.failed = true;
            slot.image  = nil;
            atomic.store(?pc.stop, 1::i64);
            ret;
        }
        var srcs: driver.CodeSources = srcs_r.ok;

        # the worker's store is scratch: a rejection is recomputed by the query pass
        var scratch_diags: diagnostic.DiagnosticStore            = diagnostic.store_init(?w.alloc);
        val r:             res[target_of.ObjectImage, fail.Fail] = codegen.codegen_unit(?w.sess, ?pc.p.target, source, srcs.set, nil, pc.dbg, ?scratch_diags);
        diagnostic.store_dnit(?scratch_diags);
        driver.sources_dnit(?w.alloc, ?srcs);
        readout.item_post(pc.p.progress, pc.phase, intern.text(?pc.p.s.interner, m.fqn), readout.elapsed(t0));
        if (sel r.err) {
            slot.image = nil;
            if (sel r.err.reported) {
                slot.rejected = true;
                cnt;
            }
            slot.fail   = r.err;
            slot.failed = true;
            atomic.store(?pc.stop, 1::i64);
            ret;
        }
        var img: target_of.ObjectImage                = r.ok;
        val br:  res[*target_of.ObjectImage, A.Error] = A.allocate[target_of.ObjectImage](?w.alloc, 1::usize);
        if (sel br.err) {
            slot.fail   = fail.message("parallel codegen: worker image box allocation failed");
            slot.failed = true;
            slot.image  = nil;
            atomic.store(?pc.stop, 1::i64);
            ret;
        }
        val box: *target_of.ObjectImage = br.ok;
        box[0]      = img;
        slot.image  = box;
        slot.failed = false;
    }
}

# generate the stale objects on worker threads and stage them for the codegen
# queries to publish: the modules' normal objects, or with `test` their test objects
fun run_codegen_parallel(p: *driver.Project, test: bool) err[fail.Fail] {
    val emit_len: u32 = p.emit_len;
    if (emit_len == 0) { ret err[fail.Fail].ok{}; }

    val rstale: res[*u32, A.Error] = A.allocate[u32](p.alloc, emit_len::usize);
    if (sel rstale.err) { ret err[fail.Fail].err{fail.refused(rstale.err)}; }
    val stale:     *u32 = rstale.ok;
    var stale_len: u32  = 0;
    var ti:        u32  = 0;
    for (ti < emit_len) {
        val m:        *driver.ModuleEntry  = project.module_at(p, p.topo[ti]::u32);
        var reusable: res[bool, fail.Fail] = res[bool, fail.Fail].ok{true};
        if (!test)                        { reusable = passes.codegen_reusable(p, p.topo[ti]); }
        or (passes.has_test_object(p, m)) { reusable = passes.test_codegen_reusable(p, p.topo[ti]); }
        if (sel reusable.err) {
            A.deallocate[u32](p.alloc, stale, emit_len::usize);
            ret err[fail.Fail].err{reusable.err};
        }
        if (!reusable.ok && pcg_ir(m, test) != nil) {
            stale[stale_len] = ti;
            stale_len        = stale_len + 1;
        }
        ti = ti + 1;
    }
    if (stale_len <= 1) {
        A.deallocate[u32](p.alloc, stale, emit_len::usize);
        ret err[fail.Fail].ok{};
    }

    var nworkers: u32 = p.req.jobs;
    if (nworkers == 0)        { nworkers = 1; }
    if (nworkers > stale_len) { nworkers = stale_len; }

    if (nworkers <= 1) {
        A.deallocate[u32](p.alloc, stale, emit_len::usize);
        ret err[fail.Fail].ok{};
    }

    val rslots: res[*PcgSlot, A.Error] = A.allocate[PcgSlot](p.alloc, stale_len::usize);
    if (sel rslots.err) {
        A.deallocate[u32](p.alloc, stale, emit_len::usize);
        ret err[fail.Fail].err{fail.refused(rslots.err)};
    }
    val slots: *PcgSlot = rslots.ok;
    var si:    u32      = 0;
    for (si < stale_len) {
        slots[si].image    = nil;
        slots[si].worker   = 0;
        slots[si].failed   = false;
        slots[si].rejected = false;
        si                 = si + 1;
    }

    val rdbg: res[codegen.DebugInfo, fail.Fail] = driver.debug_info_of(p);
    if (sel rdbg.err) {
        A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
        A.deallocate[u32](p.alloc, stale, emit_len::usize);
        ret err[fail.Fail].err{rdbg.err};
    }
    val dbg: codegen.DebugInfo = rdbg.ok;

    val rworkers: res[*PcgWorker, A.Error] = A.allocate[PcgWorker](p.alloc, nworkers::usize);
    if (sel rworkers.err) {
        A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
        A.deallocate[u32](p.alloc, stale, emit_len::usize);
        ret err[fail.Fail].err{fail.refused(rworkers.err)};
    }
    val workers: *PcgWorker = rworkers.ok;

    var wi: u32 = 0;
    for (wi < nworkers) {
        val io: err[fail.Fail] = pcg_worker_init(?workers[wi], p);
        if (sel io.err) {
            var wj: u32 = 0;
            for (wj < wi) {
                pcg_worker_teardown(?workers[wj]);
                wj = wj + 1;
            }
            A.deallocate[PcgWorker](p.alloc, workers, nworkers::usize);
            A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
            A.deallocate[u32](p.alloc, stale, emit_len::usize);
            ret err[fail.Fail].err{io.err};
        }
        wi = wi + 1;
    }

    var ctx: ParallelCodegen;
    ctx.p          = p;
    ctx.next       = 0;
    ctx.worker_seq = 0;
    ctx.stop       = 0;
    ctx.nworkers   = nworkers;
    ctx.workers    = workers;
    ctx.slots      = slots;
    ctx.stale      = stale;
    ctx.stale_len  = stale_len;
    ctx.dbg        = dbg;
    ctx.test       = test;
    ctx.phase      = readout.CODEGEN;
    if (test) { ctx.phase = readout.TEST_CODEGEN; }
    val queued: err[fail.Fail] = readout.workers_begin(p.progress, p.alloc, stale_len::usize);
    if (sel queued.err) {
        var wq: u32 = 0;
        for (wq < nworkers) {
            pcg_worker_teardown(?workers[wq]);
            wq = wq + 1;
        }
        A.deallocate[PcgWorker](p.alloc, workers, nworkers::usize);
        A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
        A.deallocate[u32](p.alloc, stale, emit_len::usize);
        ret queued;
    }

    var threads: *sync_thread.Thread = nil;
    val extra:   u32                 = nworkers - 1;
    if (extra > 0) {
        val rt: res[*sync_thread.Thread, A.Error] = A.allocate[sync_thread.Thread](p.alloc, extra::usize);
        if (sel rt.err) {
            readout.workers_end(p.progress, p.alloc, ctx.phase, 1);
            var wk: u32 = 0;
            for (wk < nworkers) {
                pcg_worker_teardown(?workers[wk]);
                wk = wk + 1;
            }
            A.deallocate[PcgWorker](p.alloc, workers, nworkers::usize);
            A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
            A.deallocate[u32](p.alloc, stale, emit_len::usize);
            ret err[fail.Fail].err{fail.refused(rt.err)};
        }
        threads = rt.ok;
        var k: u32 = 0;
        for (k < extra) {
            sync_thread.spawn_with(pcg_worker_main, (?ctx)::*u8, ?threads[k]);
            k = k + 1;
        }
    }

    pcg_worker_main((?ctx)::*u8);

    if (extra > 0) {
        var k: u32 = 0;
        for (k < extra) {
            if (threads[k].tid >= 0) { sync_thread.join(?threads[k]); }
            k = k + 1;
        }
        A.deallocate[sync_thread.Thread](p.alloc, threads, extra::usize);
    }

    readout.workers_end(p.progress, p.alloc, ctx.phase, nworkers);

    var ei: u32 = 0;
    for (ei < stale_len) {
        if (slots[ei].failed) {
            val msg: str = pcg_stable_err(p, fail.describe(slots[ei].fail));
            var wk:  u32 = 0;
            for (wk < nworkers) {
                pcg_worker_teardown(?workers[wk]);
                wk = wk + 1;
            }
            A.deallocate[PcgWorker](p.alloc, workers, nworkers::usize);
            A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
            A.deallocate[u32](p.alloc, stale, emit_len::usize);
            ret err[fail.Fail].err{fail.message(msg)};
        }
        ei = ei + 1;
    }

    val cr: err[fail.Fail] = pcg_collect(p, ?ctx);

    var wk: u32 = 0;
    for (wk < nworkers) {
        pcg_worker_teardown(?workers[wk]);
        wk = wk + 1;
    }
    A.deallocate[PcgWorker](p.alloc, workers, nworkers::usize);
    A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
    A.deallocate[u32](p.alloc, stale, emit_len::usize);
    if (sel cr.err) { ret err[fail.Fail].err{cr.err}; }
    ret err[fail.Fail].ok{};
}

fun pcg_collect(p: *driver.Project, ctx: *ParallelCodegen) err[fail.Fail] {
    val nworkers: u32 = ctx.nworkers;

    val rmaps: res[*intern.Remap, A.Error] = A.allocate[intern.Remap](p.alloc, nworkers::usize);
    if (sel rmaps.err) {
        ret err[fail.Fail].err{fail.refused(rmaps.err)};
    }
    val remaps: *intern.Remap = rmaps.ok;

    var wi: u32 = 0;
    for (wi < nworkers) {
        val rr: res[intern.Remap, A.Error] = intern.child_reintern(?workers_at(ctx, wi).sess.interner, p.alloc);
        if (sel rr.err) {
            pcg_free_remaps(p, remaps, wi);
            A.deallocate[intern.Remap](p.alloc, remaps, nworkers::usize);
            ret err[fail.Fail].err{fail.refused(rr.err)};
        }
        remaps[wi] = rr.ok;
        wi         = wi + 1;
    }

    var i: u32 = 0;
    for (i < ctx.stale_len) {
        val slot: *PcgSlot = ?ctx.slots[i::usize];
        if (slot.rejected) {
            i = i + 1;
            cnt;
        }
        val rehomed: res[target_of.ObjectImage, fail.Fail] = obj.rehome(p.s.alloc, ?p.s.interner, slot.image, remaps[slot.worker]);
        if (sel rehomed.err) {
            pcg_free_remaps(p, remaps, nworkers);
            A.deallocate[intern.Remap](p.alloc, remaps, nworkers::usize);
            ret err[fail.Fail].err{rehomed.err};
        }
        val rbox: res[*target_of.ObjectImage, A.Error] = A.allocate[target_of.ObjectImage](p.s.alloc, 1::usize);
        if (sel rbox.err) {
            var tmp: target_of.ObjectImage = rehomed.ok;
            obj.dnit(?tmp);
            pcg_free_remaps(p, remaps, nworkers);
            A.deallocate[intern.Remap](p.alloc, remaps, nworkers::usize);
            ret err[fail.Fail].err{fail.refused(rbox.err)};
        }
        val box: *target_of.ObjectImage = rbox.ok;
        box[0] = rehomed.ok;

        val mid: session.ModuleId    = p.topo[ctx.stale[i::usize]];
        val m:   *driver.ModuleEntry = project.module_at(p, mid::u32);
        if (ctx.test) { m.test.staged_image = box; }
        or            { m.staged_image = box; }
        i = i + 1;
    }

    pcg_free_remaps(p, remaps, nworkers);
    A.deallocate[intern.Remap](p.alloc, remaps, nworkers::usize);
    ret err[fail.Fail].ok{};
}

fun workers_at(ctx: *ParallelCodegen, wi: u32) *PcgWorker {
    ret ?ctx.workers[wi::usize];
}

fun pcg_free_remaps(p: *driver.Project, remaps: *intern.Remap, n: u32) {
    var wi: u32 = 0;
    for (wi < n) {
        intern.remap_dnit(p.alloc, ?remaps[wi]);
        wi = wi + 1;
    }
}
