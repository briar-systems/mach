#[testing]
fun manifest_mixed_targets() str {
    ret "[project]\nmach = \">=5\"\nid = \"mixtest\"\nversion = \"0.1.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.linux-x86_64]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.spirv]\nisa = \"spirv\"\nos = \"vulkan\"\nabi = \"spirv\"\nof = \"spirv\"\n\n[profile.debug]\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.host]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"{project.work}/lib/mixtest\"\ntargets = [\"linux-x86_64\"]\nlink = []\nneed = []\n\n[artifact.probe_frag]\nkind = \"bin\"\nentry = \"probe_frag.mach\"\nout = \"{project.work}/probe_frag.spv\"\ntargets = [\"spirv\"]\nlink = []\nneed = []\n";
}

#[testing]
fun shard_len(s: *session.Session, kind: *query.Kind) u32 {
    ret query.shard_len(?s.queries, kind);
}

#[testing]
fun stable_of(s: *session.Session, fqn: str) session.StableModuleId {
    val idr: res[intern.StrId, A.Error] = intern.add(?s.interner, fqn);
    if (sel idr.err) { ret session.STABLE_MODULE_NIL; }
    ret session.stable_module_id_lookup(s, idr.ok);
}

test execute__artifact_build_roots_at_reachable_modules {
    var w:      WarmProject;
    val opened: err[fail.Fail] = warm_project_init(?w);
    if (sel opened.err) { ret 1; }
    fin { warm_project_dnit(?w); }

    var names: [3]str;
    names[0] = "lib.mach";
    names[1] = "probe_frag.mach";
    names[2] = "other.mach";
    var texts: [3]str;
    texts[0] = "pub fun hello() i32 { ret missing_host_function(); }\n";
    texts[1] = "#[output(0)] var out_colour: f32x4;\n\n#[stage(\"fragment\")]\nfun frag_main() {\n    out_colour = f32x4{1.0, 0.0, 0.0, 1.0};\n}\n";
    texts[2] = "pub fun touch() { missing_unrelated_function(); }\n";
    val scaffolded: err[fail.Fail] = warm_project_scaffold(?w, manifest_mixed_targets(), ?names[0], ?texts[0], 3);
    if (sel scaffolded.err) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.target   = "spirv";
    rq.artifact = "probe_frag";
    val planned: err[fail.Fail] = warm_project_plan(?w, rq);
    if (sel planned.err) { ret 1; }

    var bad: i32                                  = 0;
    val r:   res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, nil);
    if (sel r.err)                         { ret 1; }
    if (r.ok.severity != outcome.BUILD_OK) { bad = 1; }

    val st_shader: session.StableModuleId = stable_of(?w.s, "mixtest.probe_frag");
    val st_host:   session.StableModuleId = stable_of(?w.s, "mixtest.lib");
    val st_other:  session.StableModuleId = stable_of(?w.s, "mixtest.other");
    if (module.stable_is_nil(st_shader))                                                              { bad = 1; }
    if (!module.stable_is_nil(st_host))                                                               { bad = 1; }
    if (!module.stable_is_nil(st_other))                                                              { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?frontend.SEMA, module.stable_index(st_shader)::u64) == 0)  { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_shader)::u64) == 0) { bad = 1; }

    ret bad;
}

# a root project whose surface module re-exports one declaration of every kind
# that has instances instead of a definition, one ordinary declaration, and a
# whole module that holds a generic; built as a shared library, a static
# archive and an executable
#[testing]
fun manifest_shared_fwd() str {
    ret "[project]\nmach = \">=5\"\nid = \"shfwd\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[target.linux-arm64]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n\n[target.linux-riscv64]\nisa = \"riscv64\"\nos = \"linux\"\nabi = \"lp64d\"\n\n[target.darwin-x86_64]\nisa = \"x86_64\"\nos = \"darwin\"\nabi = \"sysv64\"\n\n[target.darwin-arm64]\nisa = \"aarch64\"\nos = \"darwin\"\nabi = \"aapcs64\"\n\n[artifact.shared]\nkind = \"shared\"\nentry = \"lib.mach\"\nout = \"{project.work}/lib/shared\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.archive]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"{project.work}/lib/archive\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.program]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/program\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n";
}

#[testing]
val SHARED_FWD_WARNING: str = "exports nothing from a shared library";

#[testing]
fun diag_count_warning(d: *diagnostic.DiagnosticStore, needle: str) u32 {
    var hits: u32   = 0;
    var i:    usize = 0;
    for (i < diagnostic.len(d)) {
        if (!diagnostic_kind.is_error(d.items.data[i].kind)
            && str_contains(d.items.data[i].message, needle)) { hits = hits + 1; }
        i = i + 1;
    }
    ret hits;
}

# builds the named artifact of the shared-fwd project and reports how many
# re-export warnings the build raised; negative is a scaffold or engine failure
#[testing]
fun shared_fwd_arm(alloc: *A.Allocator, artifact: str, s: *session.Session) i32 {
    var names: [4]str;
    names[0] = "lib.mach";
    names[1] = "parts.mach";
    names[2] = "deep.mach";
    names[3] = "main.mach";
    var texts: [4]str;
    texts[0] = "use shfwd.parts;\n\nfwd parts.ident;\nfwd parts.plain;\nfwd parts.sized;\nfwd parts.total;\nfwd shfwd.deep;\n\npub fun anchor() i32 { ret 1; }\n";
    texts[1] = "pub fun ident[T](x: T) T { ret x; }\npub fun plain(x: i32) i32 { ret x; }\npub fun sized($n: i32) i32 { ret n; }\npub fun total(xs: ...) i32 { ret 0; }\n";
    texts[2] = "pub fun gen[T](x: T) T { ret x; }\npub fun leaf() i32 { ret 2; }\n";
    texts[3] = driver.joined(alloc, "use shfwd.parts;\n\nfwd parts.ident;\n\n#[symbol(\"", entry_symbol(), "\")]\nfun start() i32 { ret parts.plain(0); }\n");
    val root_r: res[str, fail.Fail] = driver.scaffold(alloc, manifest_shared_fwd(), ?names[0], ?texts[0], 4);
    if (sel root_r.err) { ret -1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(alloc, root); }

    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(s, root);
    if (sel mr.err) { ret -2; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.artifact     = artifact;
    val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_to_run(alloc, s, toolchain.t_registry(), ?m, rq);
    if (sel pr.err) { ret -3; }
    var bp: build_plan.BuildPlan = pr.ok;

    # the warning is raised at lowering, so the link's verdict on this host is
    # not what the arm measures
    var published: publication.Publications = publication.init(alloc);
    fin { publication.dnit(?published); }
    val r: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?bp, 0, s, ?published, alloc, nil);
    if (sel r.err)                       { ret -4; }
    if (diagnostic.has_errors(?s.diags)) { ret -5; }
    ret diag_count_warning(?s.diags, SHARED_FWD_WARNING)::i32;
}

# a shared library build warns once per `fwd` of a generic, comptime-parameter
# or pack declaration, naming it, and says nothing about the ordinary `fwd` or
# the `fwd` of a module
test execute_warm__a_shared_library_fwd_of_a_generic_warns_at_the_fwd {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val count: i32 = shared_fwd_arm(?alloc, "shared", ?s);
    if (count < 0)                                                                                          { ret 10 - count; }
    if (count != 3)                                                                                         { ret 2; }
    if (!diag_has_warning(?s.diags, "`fwd` of the generic declaration `ident` exports nothing"))            { ret 3; }
    if (!diag_has_warning(?s.diags, "`fwd` of the comptime-parameter declaration `sized` exports nothing")) { ret 4; }
    if (!diag_has_warning(?s.diags, "`fwd` of the pack declaration `total` exports nothing"))               { ret 5; }
    if (!diag_has_warning(?s.diags, "export a `pub` non-generic wrapper"))                                  { ret 6; }
    if (diag_has_warning(?s.diags, "`plain`"))                                                              { ret 7; }
    # `fwd` of a whole module exports its non-generic surface, so nothing names what it holds
    if (diag_has_warning(?s.diags, "`gen`"))  { ret 8; }
    if (diag_has_warning(?s.diags, "`leaf`")) { ret 9; }
    if (diag_has_warning(?s.diags, "`deep`")) { ret 10; }
    ret 0;
}

# the same `fwd` lines in a static archive or an executable raise nothing: no
# export surface is at stake
test execute_warm__a_static_or_executable_fwd_of_a_generic_does_not_warn {
    var artifacts: [2]str = [2]str{"archive", "program"};
    var i:         usize  = 0;
    for (i < 2) {
        var alloc:  A.Allocator;
        val make_r: err[A.Error] = page.make(?alloc);
        if (sel make_r.err) { ret 1; }
        val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
        if (sel sr.err) { ret 1; }
        var s:     session.Session = sr.ok;
        val count: i32             = shared_fwd_arm(?alloc, artifacts[i], ?s);
        session.dnit(?s);
        if (count < 0)  { ret 10 - count; }
        if (count != 0) { ret 2 + i::i32; }
        i = i + 1;
    }
    ret 0;
}

# `[project].work` is the user's: the build replaces a stale entry beneath it
# but never a file standing where the output directory itself belongs
test execute_warm__blocked_output_directory_is_environmental {
    var w:      WarmProject;
    val opened: err[fail.Fail] = warm_project_init(?w);
    if (sel opened.err) { ret 1; }
    fin { warm_project_dnit(?w); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = driver.joined(?w.alloc, "#[symbol(\"", entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n");
    val scaffolded: err[fail.Fail] = warm_project_scaffold(?w, driver.fixture_manifest(), ?names[0], ?texts[0], 1);
    if (sel scaffolded.err) { ret 1; }

    val out_path: str             = driver.joined(?w.alloc, w.root, "/", "out");
    val blk:      err[fs.FsError] = fs.write_bytes(out_path, "blocked", 7, 420);
    if (sel blk.err) { ret 1; }

    var rq:      request.BuildRequest = request.defaults();
    val planned: err[fail.Fail]       = warm_project_plan(?w, rq);
    if (sel planned.err) { ret 1; }

    var bad: i32                                  = 0;
    val r:   res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, nil);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        val bo: outcome.BuildOutcome = r.ok;
        if (bo.severity != outcome.BUILD_ENVIRONMENT) { bad = 1; }
    }

    ret bad;
}

# an unchanged rebuild in one warm session reuses every query in memory, and an edit reruns
# only what it reaches. the object cache is off (request.defaults), so nothing here is read
# from obj/: a cached rebuild is object_cache__warm_build_links_the_same_binary's
test execute_warm__unchanged_rebuild_reuses_and_stays_bounded {
    var w:      WarmProject;
    val opened: err[fail.Fail] = warm_project_init(?w);
    if (sel opened.err) { ret 1; }
    fin { warm_project_dnit(?w); }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = driver.joined(?w.alloc, "use uniontest.a.fa;\nuse uniontest.b.fb;\n#[symbol(\"", entry_symbol(), "\")]\nfun start() i32 { ret fa() + fb(); }\n");
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val scaffolded: err[fail.Fail] = warm_project_scaffold(?w, driver.fixture_manifest(), ?names[0], ?texts[0], 3);
    if (sel scaffolded.err) { ret 1; }

    var rq:      request.BuildRequest = request.defaults();
    val planned: err[fail.Fail]       = warm_project_plan(?w, rq);
    if (sel planned.err) { ret 1; }

    var bad: i32 = 0;

    val r1: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, nil);
    if (sel r1.err) { ret 1; }
    val bo1: outcome.BuildOutcome = r1.ok;
    if (bo1.severity != outcome.BUILD_OK) { bad = 1; }
    if (bo1.artifacts.len != 1)           { bad = 1; }
    or {
        val is_file_r: res[bool, io_error.Error] = fs.is_file(bo1.artifacts.data[0].path);
        if (sel is_file_r.err)                   { ret 99; }
        if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }
    }

    val st_main: session.StableModuleId = stable_of(?w.s, "uniontest.main");
    val st_a:    session.StableModuleId = stable_of(?w.s, "uniontest.a");
    val st_b:    session.StableModuleId = stable_of(?w.s, "uniontest.b");
    if (module.stable_is_nil(st_main) || module.stable_is_nil(st_a) || module.stable_is_nil(st_b)) { bad = 1; }

    val sema_a_1: query.Revision = query.peek_revision(?w.s.queries, ?frontend.SEMA, module.stable_index(st_a)::u64);
    val low_a_1:  query.Revision = query.peek_revision(?w.s.queries, ?passes.LOWER, module.stable_index(st_a)::u64);
    val cg_m_1:   query.Revision = query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_main)::u64);
    val cg_a_1:   query.Revision = query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_a)::u64);
    val cg_b_1:   query.Revision = query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_b)::u64);
    val lk_1:     query.Revision = query.peek_revision(?w.s.queries, ?passes.LINK, 0);
    if (sema_a_1 == 0 || low_a_1 == 0 || cg_m_1 == 0 || cg_a_1 == 0 || cg_b_1 == 0 || lk_1 == 0) { bad = 1; }
    val interned_1: usize = intern.count(?w.s.interner);
    val sources_1:  usize = lang_source.count(?w.s.sources);
    val n_parse_1:  u32   = shard_len(?w.s, ?frontend.PARSE);
    val n_sema_1:   u32   = shard_len(?w.s, ?frontend.SEMA);
    val n_low_1:    u32   = shard_len(?w.s, ?passes.LOWER);
    val n_cg_1:     u32   = shard_len(?w.s, ?passes.CODEGEN);

    val r2: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, nil);
    if (sel r2.err)                                                                                      { ret 1; }
    if (r2.ok.severity != outcome.BUILD_OK)                                                              { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?frontend.SEMA, module.stable_index(st_a)::u64) != sema_a_1)   { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?passes.LOWER, module.stable_index(st_a)::u64) != low_a_1)     { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_main)::u64) != cg_m_1) { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_a)::u64) != cg_a_1)    { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_b)::u64) != cg_b_1)    { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?passes.LINK, 0) != lk_1)                                      { bad = 1; }
    if (intern.count(?w.s.interner) != interned_1)                                                       { bad = 1; }
    if (lang_source.count(?w.s.sources) != sources_1)                                                    { bad = 1; }
    if (shard_len(?w.s, ?frontend.PARSE) != n_parse_1)                                                   { bad = 1; }
    if (shard_len(?w.s, ?frontend.SEMA) != n_sema_1)                                                     { bad = 1; }
    if (shard_len(?w.s, ?passes.LOWER) != n_low_1)                                                       { bad = 1; }
    if (shard_len(?w.s, ?passes.CODEGEN) != n_cg_1)                                                      { bad = 1; }

    val src_dir:       str             = driver.joined(?w.alloc, w.root, "/", "src");
    val a_path:        str             = driver.joined(?w.alloc, src_dir, "/", "a.mach");
    val a_v2:          str             = "pub fun fa() i32 { val t: i32 = 1; ret t; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(a_path, a_v2, str_len(a_v2), 420);
    if (sel write_bytes_r.err) { ret 1; }

    val r3: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, nil);
    if (sel r3.err)                                                                                   { ret 1; }
    if (r3.ok.severity != outcome.BUILD_OK)                                                           { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_a)::u64) == cg_a_1) { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_b)::u64) != cg_b_1) { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?passes.LINK, 0) == lk_1)                                   { bad = 1; }
    if (lang_source.count(?w.s.sources) != sources_1)                                                 { bad = 1; }
    if (shard_len(?w.s, ?frontend.PARSE) != n_parse_1)                                                { bad = 1; }
    if (shard_len(?w.s, ?frontend.SEMA) != n_sema_1)                                                  { bad = 1; }
    if (shard_len(?w.s, ?passes.LOWER) != n_low_1)                                                    { bad = 1; }
    if (shard_len(?w.s, ?passes.CODEGEN) != n_cg_1)                                                   { bad = 1; }

    ret bad;
}

# the reuse refused here is the warm session's link query; the object cache is off
test execute_warm__tampered_artifact_forces_relink_not_silent_reuse {
    var w:      WarmProject;
    val opened: err[fail.Fail] = warm_project_init(?w);
    if (sel opened.err) { ret 1; }
    fin { warm_project_dnit(?w); }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = driver.joined(?w.alloc, "use uniontest.a.fa;\nuse uniontest.b.fb;\n#[symbol(\"", entry_symbol(), "\")]\nfun start() i32 { ret fa() + fb(); }\n");
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val scaffolded: err[fail.Fail] = warm_project_scaffold(?w, driver.fixture_manifest(), ?names[0], ?texts[0], 3);
    if (sel scaffolded.err) { ret 1; }

    var rq:      request.BuildRequest = request.defaults();
    val planned: err[fail.Fail]       = warm_project_plan(?w, rq);
    if (sel planned.err) { ret 1; }

    var bad: i32 = 0;

    val r1: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, nil);
    if (sel r1.err) { ret 1; }
    val bo1: outcome.BuildOutcome = r1.ok;
    if (bo1.severity != outcome.BUILD_OK) { bad = 1; }
    or (bo1.artifacts.len != 1)           { bad = 1; }
    or {
        val is_file_r: res[bool, io_error.Error] = fs.is_file(bo1.artifacts.data[0].path);
        if (sel is_file_r.err)                   { ret 99; }
        if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }
    }
    val artifact: str = bo1.artifacts.data[0].path;

    val lk_1: query.Revision = query.peek_revision(?w.s.queries, ?passes.LINK, 0);
    if (lk_1 == 0) { bad = 1; }

    val marker:        str             = "TAMPERED-DEFECT-B-MARKER-NOT-A-REAL-BINARY";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(artifact, marker, str_len(marker), 420);
    if (sel write_bytes_r.err) { bad = 1; }

    val r2: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, nil);
    if (sel r2.err) { ret 1; }
    val bo2: outcome.BuildOutcome = r2.ok;
    if (bo2.severity != outcome.BUILD_OK) { bad = 1; }

    val lk_2: query.Revision = query.peek_revision(?w.s.queries, ?passes.LINK, 0);
    if (lk_2 != lk_1) { bad = 1; }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?w.alloc, artifact);
    if (sel rr.err) { bad = 1; }
    if (sel rr.ok) {
        var buf:            Vector[u8] = rr.ok;
        val mbytes:         *u8        = marker::*u8;
        val mlen:           usize      = str_len(marker);
        var matches_marker: bool       = buf.len::usize == mlen;
        if (matches_marker) {
            var i: usize = 0;
            for (i < mlen) {
                if (buf.data[i] != mbytes[i]) {
                    matches_marker = false;
                    brk;
                }
                i = i + 1;
            }
        }
        if (matches_marker) { bad = 1; }
        collections_vector.dnit[u8](?buf);
    }

    ret bad;
}

$if ($mach.build.os != $mach.os.windows) {
    # a symlink to a directory at the artifact fails the link: the build replaces
    # a stale directory there, never a link
    test execute_warm__failed_link_retries_at_unchanged_revision {
        var w:      WarmProject;
        val opened: err[fail.Fail] = warm_project_init(?w);
        if (sel opened.err) { ret 1; }
        fin { warm_project_dnit(?w); }

        var names: [1]str;
        names[0] = "main.mach";
        var texts: [1]str;
        texts[0] = driver.joined(?w.alloc, "#[symbol(\"", entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n\ntest main_zero { ret 0; }\n");
        val scaffolded: err[fail.Fail] = warm_project_scaffold(?w, driver.fixture_manifest(), ?names[0], ?texts[0], 1);
        if (sel scaffolded.err) { ret 1; }

        var rq: request.BuildRequest = request.defaults();
        rq.goal = request.GOAL_TESTS;
        val planned: err[fail.Fail] = warm_project_plan(?w, rq);
        if (sel planned.err) { ret 1; }

        val artifact:  str               = w.plan.units.data[0].out_path;
        val elsewhere: res[str, A.Error] = types_path.join(?w.alloc, w.root, "elsewhere");
        if (sel elsewhere.err) { ret 1; }
        val made: err[fs.FsError] = fs.create_dir_all(?w.alloc, elsewhere.ok, 493);
        if (sel made.err) { ret 1; }
        val parent: res[str, A.Error] = types_path.parent(?w.alloc, artifact);
        if (sel parent.err) { ret 1; }
        val made_parent: err[fs.FsError] = fs.create_dir_all(?w.alloc, parent.ok, 493);
        if (sel made_parent.err) { ret 1; }
        val linked: err[io_error.Error] = fs.symlink(elsewhere.ok, artifact);
        if (sel linked.err) { ret 1; }

        var bad: i32                                  = 0;
        val r1:  res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, nil);
        if (sel r1.err) { bad = 1; }
        if (sel r1.ok) {
            val bo1: outcome.BuildOutcome = r1.ok;
            if (bo1.severity == outcome.BUILD_OK) { bad = 1; }
        }

        val lk_1: query.Revision = query.peek_revision(?w.s.queries, ?passes.LINK, 0);
        if (lk_1 == 0) { bad = 1; }
        fs.remove_file(artifact);

        val r2: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, nil);
        if (sel r2.err) { bad = 1; }
        if (sel r2.ok) {
            val bo2: outcome.BuildOutcome = r2.ok;
            if (bo2.severity != outcome.BUILD_OK) { bad = 1; }
        }
        if (query.peek_revision(?w.s.queries, ?passes.LINK, 0) != lk_1) { bad = 1; }
        val is_file_r: res[bool, io_error.Error] = fs.is_file(artifact);
        if (sel is_file_r.err)                   { ret 99; }
        if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }

        ret bad;
    }
}

# the modules left alone keep their codegen queries in the warm session; the object cache is
# off, so none is restored from obj/
test execute_warm__parallel_pool_rebuilds_only_stale_modules {
    var w:      WarmProject;
    val opened: err[fail.Fail] = warm_project_init(?w);
    if (sel opened.err) { ret 1; }
    fin { warm_project_dnit(?w); }

    var names: [4]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    names[3] = "c.mach";
    var texts: [4]str;
    texts[0] = driver.joined(?w.alloc, "use uniontest.a.fa;\nuse uniontest.b.fb;\nuse uniontest.c.fc;\n#[symbol(\"", entry_symbol(), "\")]\nfun start() i32 { ret fa() + fb() + fc(); }\n");
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    texts[3] = "pub fun fc() i32 { ret 3; }\n";
    val scaffolded: err[fail.Fail] = warm_project_scaffold(?w, driver.fixture_manifest(), ?names[0], ?texts[0], 4);
    if (sel scaffolded.err) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.jobs = 2;
    val planned: err[fail.Fail] = warm_project_plan(?w, rq);
    if (sel planned.err) { ret 1; }

    var bad: i32 = 0;

    val r1: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, nil);
    if (sel r1.err) { ret 1; }
    val bo1: outcome.BuildOutcome = r1.ok;
    if (bo1.severity != outcome.BUILD_OK) { bad = 1; }
    if (bo1.artifacts.len != 1)           { bad = 1; }
    or {
        val is_file_r: res[bool, io_error.Error] = fs.is_file(bo1.artifacts.data[0].path);
        if (sel is_file_r.err)                   { ret 99; }
        if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }
    }

    val st_main: session.StableModuleId = stable_of(?w.s, "uniontest.main");
    val st_a:    session.StableModuleId = stable_of(?w.s, "uniontest.a");
    val st_b:    session.StableModuleId = stable_of(?w.s, "uniontest.b");
    val st_c:    session.StableModuleId = stable_of(?w.s, "uniontest.c");
    if (module.stable_is_nil(st_main) || module.stable_is_nil(st_a)
        || module.stable_is_nil(st_b) || module.stable_is_nil(st_c)) { bad = 1; }

    val cg_m_1: query.Revision = query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_main)::u64);
    val cg_a_1: query.Revision = query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_a)::u64);
    val cg_b_1: query.Revision = query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_b)::u64);
    val cg_c_1: query.Revision = query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_c)::u64);
    val lk_1:   query.Revision = query.peek_revision(?w.s.queries, ?passes.LINK, 0);
    if (cg_m_1 == 0 || cg_a_1 == 0 || cg_b_1 == 0 || cg_c_1 == 0 || lk_1 == 0) { bad = 1; }
    val n_cg_1: u32 = shard_len(?w.s, ?passes.CODEGEN);

    val r2: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, nil);
    if (sel r2.err)                                                                                   { ret 1; }
    if (r2.ok.severity != outcome.BUILD_OK)                                                           { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_a)::u64) != cg_a_1) { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_c)::u64) != cg_c_1) { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?passes.LINK, 0) != lk_1)                                   { bad = 1; }

    val src_dir:       str             = driver.joined(?w.alloc, w.root, "/", "src");
    val a_path:        str             = driver.joined(?w.alloc, src_dir, "/", "a.mach");
    val c_path:        str             = driver.joined(?w.alloc, src_dir, "/", "c.mach");
    val a_v2:          str             = "pub fun fa() i32 { val t: i32 = 1; ret t; }\n";
    val c_v2:          str             = "pub fun fc() i32 { val t: i32 = 3; ret t; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(a_path, a_v2, str_len(a_v2), 420);
    if (sel write_bytes_r.err) { ret 1; }
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(c_path, c_v2, str_len(c_v2), 420);
    if (sel write_bytes_r2.err) { ret 1; }

    val r3: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, nil);
    if (sel r3.err) { ret 1; }
    val bo3: outcome.BuildOutcome = r3.ok;
    if (bo3.severity != outcome.BUILD_OK) { bad = 1; }
    if (bo3.artifacts.len != 1)           { bad = 1; }
    or {
        val is_file_r2: res[bool, io_error.Error] = fs.is_file(bo3.artifacts.data[0].path);
        if (sel is_file_r2.err)                    { ret 99; }
        if (!(sel is_file_r2.ok && is_file_r2.ok)) { bad = 1; }
    }
    if (query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_a)::u64) == cg_a_1)    { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_c)::u64) == cg_c_1)    { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_main)::u64) != cg_m_1) { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?passes.CODEGEN, module.stable_index(st_b)::u64) != cg_b_1)    { bad = 1; }
    if (query.peek_revision(?w.s.queries, ?passes.LINK, 0) == lk_1)                                      { bad = 1; }
    if (shard_len(?w.s, ?passes.CODEGEN) != n_cg_1)                                                      { bad = 1; }

    ret bad;
}

#[testing]
fun scale_names(alloc: *A.Allocator, names: *str, texts: *str) {
    names[0] = "main.mach";
    var uses:  str = "";
    var calls: str = "";
    var i:     u32 = 1;
    for (i <= 8) {
        val idx: str = u32_str(alloc, i);
        val nm:  str = driver.joined(alloc, "m", idx, ".mach");
        names[i] = nm;
        val head: str = driver.joined(alloc, "pub fun f", idx, "() i32 {\n    val x: f64 = ");
        val mid:  str = driver.joined(alloc, idx, ".25;\n    val y: f64 = x * 2.0 + 0.5;\n    var acc: i32 = 0;\n    var j: i32 = 0;\n    for (j < 40) {\n        acc = acc + j * 2;\n        j = j + 1;\n    }\n    ret acc + (y::i32) + ", idx);
        val body: str = driver.joined(alloc, head, mid, ";\n}\n");
        texts[i] = body;
        uses     = driver.joined(alloc, uses, "use scaletest.m", driver.joined(alloc, idx, ".f", idx));
        uses     = driver.joined(alloc, uses, ";\n", "");
        calls    = driver.joined(alloc, calls, "acc = acc + f", driver.joined(alloc, idx, "();\n", ""));
        i        = i + 1;
    }
    texts[0] = driver.joined(alloc, uses, driver.joined(alloc, "#[symbol(\"", "_start", "\")]\n"),
        driver.joined(alloc, "fun start() i32 {\n    var acc: i32 = 0;\n", calls, "    ret acc;\n}\n"));
}

#[testing]
fun u32_str(alloc: *A.Allocator, v: u32) str {
    var digits: [std_format.DECIMAL_MAX]u8;
    val n:      usize             = std_format.put_u64(?digits[0], v::u64);
    val r:      res[*u8, A.Error] = A.allocate[u8](alloc, n + 1);
    if (sel r.err) { ret "0"; }
    val buf: *u8 = r.ok;
    memory.raw_copy(buf::ptr, (?digits[0])::ptr, n);
    buf[n] = 0;
    ret buf::str;
}

#[testing]
fun build_scale(alloc: *A.Allocator, root: str, jobs: u32, out_bytes: *Vector[u8]) i32 {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = "linux";
    rq.jobs         = jobs;
    rq.opt          = request.OPT_RELEASE;
    rq.debug        = true;
    val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_to_run(alloc, ?s, toolchain.t_registry(), ?m, rq);
    if (sel pr.err) { ret 1; }
    var bp: build_plan.BuildPlan = pr.ok;

    var published: publication.Publications = publication.init(alloc);
    fin { publication.dnit(?published); }
    val r: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?bp, 0, ?s, ?published, alloc, nil);
    if (sel r.err) { ret 1; }
    val bo: outcome.BuildOutcome = r.ok;
    if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { ret 1; }
    val is_file_r: res[bool, io_error.Error] = fs.is_file(bo.artifacts.data[0].path);
    if (sel is_file_r.err)                   { ret 99; }
    if (!(sel is_file_r.ok && is_file_r.ok)) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, bo.artifacts.data[0].path);
    if (sel rb.err) { ret 1; }
    @out_bytes = rb.ok;

    ret 0;
}

#[testing]
fun manifest_scale() str {
    ret "[project]\nmach = \">=5\"\nid = \"scaletest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.scaletest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/scaletest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
}

test execute_warm__worker_count_does_not_change_the_artifact {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var names: [9]str;
    var texts: [9]str;
    scale_names(?alloc, ?names[0], ?texts[0]);
    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, manifest_scale(), ?names[0], ?texts[0], 9);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    var b1: Vector[u8];
    val c1: i32 = build_scale(?alloc, root, 1::u32, ?b1);
    if (c1 != 0) { ret 1; }
    var b6: Vector[u8];
    val c6: i32 = build_scale(?alloc, root, 6::u32, ?b6);
    if (c6 != 0) { ret 1; }

    if (b1.len != b6.len) { ret 1; }
    var i: usize = 0;
    for (i < b1.len) {
        if (b1.data[i] != b6.data[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test execute_warm__replaced_image_owns_section_bytes {
    var w:      WarmProject;
    val opened: err[fail.Fail] = warm_project_init(?w);
    if (sel opened.err) { ret 1; }
    fin { warm_project_dnit(?w); }

    val LIT: str = "warm-owned-section-bytes";

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = driver.joined(?w.alloc, "use uniontest.a.greeting;\n#[symbol(\"", entry_symbol(), "\")]\nfun start() i32 { if (greeting[0] == 'w') { ret 0; } ret 1; }\n");
    texts[1] = "use uniontest.b.fb;\npub val greeting: *u8 = \"warm-owned-section-bytes\";\npub fun fa() i32 { ret fb(); }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val scaffolded: err[fail.Fail] = warm_project_scaffold(?w, driver.fixture_manifest(), ?names[0], ?texts[0], 3);
    if (sel scaffolded.err) { ret 1; }

    var rq:      request.BuildRequest = request.defaults();
    val planned: err[fail.Fail]       = warm_project_plan(?w, rq);
    if (sel planned.err) { ret 1; }

    var bad: i32 = 0;

    val r1: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, nil);
    if (sel r1.err)                         { ret 1; }
    if (r1.ok.severity != outcome.BUILD_OK) { bad = 1; }

    val src_dir:       str             = driver.joined(?w.alloc, w.root, "/", "src");
    val b_path:        str             = driver.joined(?w.alloc, src_dir, "/", "b.mach");
    val b_v2:          str             = "pub fun fb() i32 { ret 2; }\npub fun fb2() i32 { ret 3; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(b_path, b_v2, str_len(b_v2), 420);
    if (sel write_bytes_r.err) { ret 1; }

    val r2: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, nil);
    if (sel r2.err)                         { ret 1; }
    if (r2.ok.severity != outcome.BUILD_OK) { bad = 1; }

    val id_r: res[intern.StrId, A.Error] = intern.add(?w.s.interner, LIT);
    if (sel id_r.ok) {
        val lo: opt[str] = intern.get(?w.s.interner, id_r.ok);
        if (sel lo.none)               { ret 99; }
        if (!str_equals(lo.some, LIT)) { bad = 1; }
    }

    ret bad;
}

# whether a failure or a diagnostic the recording kept, or a file a diagnostic
# points into, holds needle
#[testing]
fun recording_contains(rd: *readout.Recording, needle: str) bool {
    var i: usize = 0;
    for (i < rd.failures.len) {
        if (rd.failures.data[i] != nil && str_contains(rd.failures.data[i], needle)) { ret true; }
        i = i + 1;
    }
    i = 0;
    for (i < rd.diagnostics.len) {
        val d: *readout.RecordedDiagnostic = ?rd.diagnostics.data[i];
        if (d.message != nil && str_contains(d.message, needle)) { ret true; }
        if (d.path != nil && str_contains(d.path, needle))       { ret true; }
        i = i + 1;
    }
    ret false;
}

#[testing]
fun manifest_two_bins() str {
    ret "[project]\nmach = \">=5\"\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[target.linux-arm64]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n\n[target.linux-riscv64]\nisa = \"riscv64\"\nos = \"linux\"\nabi = \"lp64d\"\n\n[target.darwin-x86_64]\nisa = \"x86_64\"\nos = \"darwin\"\nabi = \"sysv64\"\n\n[target.darwin-arm64]\nisa = \"aarch64\"\nos = \"darwin\"\nabi = \"aapcs64\"\n\n[artifact.alpha]\nkind = \"bin\"\nentry = \"alpha.mach\"\nout = \"{project.work}/bin/alpha\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.beta]\nkind = \"bin\"\nentry = \"beta.mach\"\nout = \"{project.work}/bin/beta\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
}

# a module forking on `$bin.name` compiles once per artifact: the second artifact's build
# reuses neither the warm session's codegen query nor the obj/ object the first one wrote.
# the object cache is on, both artifacts share the cell's obj/, and fresh sessions rebuild
# each artifact through it
test execute_warm__bin_name_keys_the_artifact_cache {
    var w:      WarmProject;
    val opened: err[fail.Fail] = warm_project_init(?w);
    if (sel opened.err) { ret 1; }
    fin { warm_project_dnit(?w); }

    var names: [3]str;
    names[0] = "alpha.mach";
    names[1] = "beta.mach";
    names[2] = "shared.mach";
    var texts: [3]str;
    texts[0] = driver.joined(?w.alloc, "use uniontest.shared.sh;\n#[symbol(\"", entry_symbol(), "\")]\nfun sa() i32 { ret sh(); }\n");
    texts[1] = driver.joined(?w.alloc, "use uniontest.shared.sh;\n#[symbol(\"", entry_symbol(), "\")]\nfun sb() i32 { ret sh(); }\n");
    texts[2] = "pub fun sh() i32 { $if ($bin.name == \"alpha\") { ret 111; } ret 222; }\n";
    val scaffolded: err[fail.Fail] = warm_project_scaffold(?w, manifest_two_bins(), ?names[0], ?texts[0], 3);
    if (sel scaffolded.err) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.object_cache = true;
    val planned: err[fail.Fail] = warm_project_plan(?w, rq);
    if (sel planned.err) { ret 1; }

    var bad: i32 = 0;
    if (w.plan.units.len != 2) { bad = 1; }

    val r0: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, nil);
    if (sel r0.err) { ret 1; }
    val bo0: outcome.BuildOutcome                 = r0.ok;
    val r1:  res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 1, ?w.s, ?w.published, ?w.alloc, nil);
    if (sel r1.err) { ret 1; }
    val bo1: outcome.BuildOutcome = r1.ok;

    if (bo0.severity != outcome.BUILD_OK || bo1.severity != outcome.BUILD_OK) { bad = 1; }
    if (bo0.artifacts.len != 1 || bo1.artifacts.len != 1)                     { ret 1; }

    val f0: res[Vector[u8], fs.FsError] = fs.read_bytes(?w.alloc, bo0.artifacts.data[0].path);
    val f1: res[Vector[u8], fs.FsError] = fs.read_bytes(?w.alloc, bo1.artifacts.data[0].path);
    if (sel f0.err) { ret 1; }
    if (sel f1.err) { ret 1; }
    val v0: Vector[u8] = f0.ok;
    val v1: Vector[u8] = f1.ok;

    if (same_image_bytes(?v0, ?v1)) { bad = 1; }

    # fresh sessions, as new processes run them, rebuild the first artifact and then the
    # second: only obj/ could hand the second the object the first just wrote
    var c0: Vector[u8];
    var c1: Vector[u8];
    if (fresh_unit(?w.alloc, w.root, 0, ?c0) != 0)                  { ret 2; }
    if (fresh_unit(?w.alloc, w.root, 1, ?c1) != 0)                  { ret 2; }
    if (!same_image_bytes(?c0, ?v0) || !same_image_bytes(?c1, ?v1)) { bad = 3; }

    ret bad;
}

# builds planned unit `unit` of the project at `root` in a fresh session with the object cache on
#[testing]
fun fresh_unit(alloc: *A.Allocator, root: str, unit: usize, out_bytes: *Vector[u8]) i32 {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.object_cache = true;
    val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_to_run(alloc, ?s, toolchain.t_registry(), ?m, rq);
    if (sel pr.err) { ret 1; }
    var bp:        build_plan.BuildPlan     = pr.ok;
    var published: publication.Publications = publication.init(alloc);
    fin { publication.dnit(?published); }
    val r: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?bp, unit, ?s, ?published, alloc, nil);
    if (sel r.err) { ret 1; }
    val bo: outcome.BuildOutcome = r.ok;
    if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { ret 1; }
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, bo.artifacts.data[0].path);
    if (sel rb.err) { ret 1; }
    @out_bytes = rb.ok;
    ret 0;
}

#[testing]
fun same_image_bytes(a: *Vector[u8], b: *Vector[u8]) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# under -v a growing cycle shows as it expands, each time its instance count doubles
test execute_warm__growing_cycle_expansion_is_shown {
    var w:      WarmProject;
    val opened: err[fail.Fail] = warm_project_init(?w);
    if (sel opened.err) { ret 1; }
    fin { warm_project_dnit(?w); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = driver.joined(?w.alloc, "fun peel[T](x: i64) i64 { $if ($is_pointer(T)) { ret peel[$pointee_of(T)](x + 1); } ret x; }\n#[symbol(\"",
        entry_symbol(), "\")]\nfun start() i32 { ret peel[*****i64](0)::i32; }\n");
    val scaffolded: err[fail.Fail] = warm_project_scaffold(?w, driver.fixture_manifest(), ?names[0], ?texts[0], 1);
    if (sel scaffolded.err) { ret 1; }
    val planned: err[fail.Fail] = warm_project_plan(?w, request.defaults());
    if (sel planned.err) { ret 1; }

    var rd: readout.Recording;
    readout.recording_init(?rd, ?w.alloc, readout.LEVEL_PHASES);
    fin { readout.recording_dnit(?rd); }
    var bad: i32                                  = 0;
    val r:   res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, ?rd.sink);
    if (sel r.err) { ret 2; }
    var bo: outcome.BuildOutcome = r.ok;
    if (bo.severity != outcome.BUILD_OK) { bad = 3; }
    outcome.outcome_dnit(?bo);
    # five pointers peel to six instances: shown at one, two and four
    if (rd.growths.len != 3)                        { bad = 4; }
    or (!str_equals(rd.growths.data[0], "peel: 1")) { bad = 5; }
    or (!str_equals(rd.growths.data[2], "peel: 4")) { bad = 6; }
    ret bad;
}

test execute_warm__pool_error_message_survives_teardown {
    var w:      WarmProject;
    val opened: err[fail.Fail] = warm_project_init(?w);
    if (sel opened.err) { ret 1; }
    fin { warm_project_dnit(?w); }

    var names: [4]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    names[3] = "c.mach";
    var texts: [4]str;
    texts[0] = driver.joined(?w.alloc, "use uniontest.a.fa;\nuse uniontest.b.fb;\nuse uniontest.c.fc;\n#[symbol(\"", entry_symbol(), "\")]\nfun start() i32 { ret fa() + fb() + fc(); }\n");
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    texts[3] = "pub fun fc() i32 {\n    $if ($mach.build.arch == $mach.arch.x86_64) { asm x86_64 { frobnicate } }\n    $or ($mach.build.arch == $mach.arch.aarch64) { asm aarch64 { frobnicate } }\n    $or { asm riscv64 { frobnicate } }\n    ret 3;\n}\n";
    val scaffolded: err[fail.Fail] = warm_project_scaffold(?w, driver.fixture_manifest(), ?names[0], ?texts[0], 4);
    if (sel scaffolded.err) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.jobs = 2;
    val planned: err[fail.Fail] = warm_project_plan(?w, rq);
    if (sel planned.err) { ret 1; }

    var rd: readout.Recording;
    readout.recording_init(?rd, ?w.alloc, readout.LEVEL_RESULTS);
    fin { readout.recording_dnit(?rd); }
    var bad: i32                                  = 0;
    val r:   res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, ?rd.sink);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        var bo: outcome.BuildOutcome = r.ok;
        if (bo.severity == outcome.BUILD_OK)          { bad = 1; }
        if (rd.failures.len != 1)                     { bad = 1; }
        if (!recording_contains(?rd, "'frobnicate'")) { bad = 1; }
        if (!recording_contains(?rd, "c.mach"))       { bad = 1; }
        outcome.outcome_dnit(?bo);
    }

    ret bad;
}

test execute_warm__sema_phase_diagnostic_fails_build {
    var w:      WarmProject;
    val opened: err[fail.Fail] = warm_project_init(?w);
    if (sel opened.err) { ret 1; }
    fin { warm_project_dnit(?w); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = driver.joined(?w.alloc, "#[symbol(\"", entry_symbol(), "\")]\nfun start() i32 { val x: u32 = \"not a u32\"; ret 0; }\n");
    val scaffolded: err[fail.Fail] = warm_project_scaffold(?w, driver.fixture_manifest(), ?names[0], ?texts[0], 1);
    if (sel scaffolded.err) { ret 1; }

    var rq:      request.BuildRequest = request.defaults();
    val planned: err[fail.Fail]       = warm_project_plan(?w, rq);
    if (sel planned.err) { ret 1; }

    var bad: i32                                  = 0;
    val r:   res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, nil);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        val bo: outcome.BuildOutcome = r.ok;
