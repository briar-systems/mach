    ret bad;
}

#[testing]
fun diag_has_warning(d: *diagnostic.DiagnosticStore, needle: str) bool {
    var i: usize = 0;
    for (i < diagnostic.len(d)) {
        if (!diagnostic_kind.is_error(d.items.data[i].kind)
            && str_contains(d.items.data[i].message, needle)) { ret true; }
        i = i + 1;
    }
    ret false;
}

#[testing]
fun manifest_renamed_artifact() str {
    ret on_host("[project]\nmach = \">=5\"\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/renamed\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n");
}

test execute_warm__refuses_a_manifest_that_changed_after_planning {
    var w:      WarmProject;
    val opened: err[fail.Fail] = warm_project_init(?w);
    if (sel opened.err) { ret 1; }
    fin { warm_project_dnit(?w); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = driver.joined(?w.alloc, "#[symbol(\"", entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n");
    val scaffolded: err[fail.Fail] = warm_project_scaffold(?w, driver.fixture_manifest(), ?names[0], ?texts[0], 1);
    if (sel scaffolded.err) { ret 1; }

    var rq:      request.BuildRequest = request.defaults();
    val planned: err[fail.Fail]       = warm_project_plan(?w, rq);
    if (sel planned.err) { ret 1; }

    val mf:            str             = driver.joined(?w.alloc, w.root, "/", manifest.MANIFEST_FILE);
    val alt:           str             = manifest_renamed_artifact();
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(mf, alt, str_len(alt), 420);
    if (sel write_bytes_r.err) { ret 1; }
    # the host reads the edited manifest into the session; the plan made before it is stale
    val reloaded: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?w.s, w.root);
    if (sel reloaded.err) { ret 1; }
    var edited: manifest.Manifest = reloaded.ok;
    fin { manifest.dnit(?edited, ?w.alloc); }

    var rd: readout.Recording;
    readout.recording_init(?rd, ?w.alloc, readout.LEVEL_RESULTS);
    fin { readout.recording_dnit(?rd); }
    var bad: i32                                  = 0;
    val r:   res[outcome.BuildOutcome, fail.Fail] = execute_warm(?w.plan, 0, ?w.s, ?w.published, ?w.alloc, ?rd.sink);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        var bo: outcome.BuildOutcome = r.ok;
        if (bo.severity != outcome.BUILD_USER)                                { bad = 1; }
        or (!recording_contains(?rd, "changed after this build was planned")) { bad = 1; }
        outcome.outcome_dnit(?bo);
    }

    ret bad;
}

#[testing]
fun ro_mod_text() str {
    ret "pub fun f0(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 1; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f1(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 2; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f2(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 3; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f3(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 4; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f4(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 5; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f5(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 6; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f6(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 7; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f7(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 8; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f8(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 9; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f9(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 10; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f10(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 11; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f11(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 12; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f12(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 13; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f13(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 14; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f14(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 15; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f15(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 16; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f16(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 17; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f17(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 18; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f18(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 19; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f19(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 20; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\n";
}

