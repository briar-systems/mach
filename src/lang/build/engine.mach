#[testing]
fun manifest_two_artifacts() str {
    ret "[project]\nmach = \">=5\"\nid = \"lessons\"\nversion = \"0.1.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\ndefault = true\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.hello]\ndefault = true\nkind = \"bin\"\nentry = \"hello.mach\"\nout = \"{project.work}/bin/hello\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.shaded]\nkind = \"bin\"\nentry = \"shaded.mach\"\nout = \"{project.work}/bin/shaded\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

# a two-artifact project: `common` is shared, `stray` is reached by neither and does not
# type-check, and `shaded` refuses to be compiled for any artifact but its own
#[testing]
fun scaffold_two_artifacts(alloc: *A.Allocator) res[str, fail.Fail] {
    val start: str = dispatcher_stub();
    var names: [4]str;
    var texts: [4]str;
    names[0] = "hello.mach";
    texts[0] = driver.joined(alloc, "use lessons.common;\n\n", start, "\ntest own { ret common.zero(); }\n");
    names[1] = "shaded.mach";
    texts[1] = driver.joined(alloc, "$if ($bin.name != \"shaded\") { $error(\"wrong artifact\"); }\n\nuse lessons.common;\n\n", start,
        "\ntest own { ret common.zero(); }\n");
    names[2] = "common.mach";
    texts[2] = "pub fun zero() i32 { ret 0; }\n\ntest names_its_artifact {\n    $if ($bin.name == \"hello\") { ret 11; }\n    $or ($bin.name == \"shaded\") { ret 12; }\n    ret 13;\n}\n";
    names[3] = "stray.mach";
    texts[3] = "pub fun broken() i32 { ret lessons_undefined_symbol(); }\n\ntest never { ret 0; }\n";
    ret driver.scaffold(alloc, manifest_two_artifacts(), ?names[0], ?texts[0], 4);
}

# the tests `mach test` builds for `artifact` ("" selects the default), each label
# with the status its dispatcher exits with, or the build's failure
#[testing]
fun artifact_test_statuses(alloc: *A.Allocator, s: *session.Session, root: str, artifact: str,
    labels: *Vector[str], statuses: *Vector[i32]) i32 {
    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(s, root);
    if (sel mr.err) { ret 1; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = "linux";
    rq.artifact     = artifact;
    rq.debug        = false;
    rq.goal         = request.GOAL_TESTS;
    val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_to_run(alloc, s, toolchain.t_registry(), ?m, rq);
    if (sel pr.err) {
        print.eprintln(fail.describe(pr.err));
        ret 2;
    }
    var bp:        build_plan.BuildPlan     = pr.ok;
    var published: publication.Publications = publication.init(alloc);
    fin { publication.dnit(?published); }
    val r: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?bp, 0, s, ?published, alloc, nil);
    if (sel r.err) {
        print.eprintln(fail.describe(r.err));
        ret 3;
    }
    var bo: outcome.BuildOutcome = r.ok;
    fin { outcome.outcome_dnit(?bo); }
    if (bo.severity != outcome.BUILD_OK) {
        var di: usize = 0;
        for (di < diagnostic.len(?s.diags)) {
            print.eprintln(s.diags.items.data[di].message);
            di = di + 1;
        }
        ret 4;
    }
    var t: usize = 0;
    for (t < bo.tests.len) {
        val art:   *testrun.TestArtifact = ?bo.tests.data[t];
        val label: res[str, A.Error]     = str_dup(alloc, art.name::str);
        if (sel label.err) { ret 5; }
        val pl: res[usize, A.Error] = collections_vector.push[str](labels, label.ok);
        if (sel pl.err) { ret 5; }
        val ps: res[usize, A.Error] = collections_vector.push[i32](statuses, dispatch_status(art.exe::str, art.idx));
        if (sel ps.err) { ret 5; }
        t = t + 1;
    }
    ret 0;
}

#[testing]
fun status_of(labels: *Vector[str], statuses: *Vector[i32], label: str) i32 {
    var i: usize = 0;
    for (i < labels.len) {
        if (str_equals(labels.data[i], label)) { ret statuses.data[i]; }
        i = i + 1;
    }
    ret -2;
}

$if ($mach.build.os == $mach.os.linux && $mach.build.arch == $mach.arch.x86_64) {
    # `mach test` tests one artifact's closure, the way `mach build` builds it: the default
    # artifact's tests without a selector, the named artifact's under `-a`, never a module
    # neither reaches, and `$bin.name` in a test block is the artifact under test
    test test_goal__tests_the_selected_artifacts_closure {
        var alloc:  A.Allocator;
        val make_r: err[A.Error] = page.make(?alloc);
        if (sel make_r.err) { ret 1; }
        val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
        if (sel sr.err) { ret 1; }
        var s: session.Session = sr.ok;
        fin { session.dnit(?s); }

        val root_r: res[str, fail.Fail] = scaffold_two_artifacts(?alloc);
        if (sel root_r.err) { ret 1; }
        val root: str = root_r.ok;
        fin { fs.remove_all(?alloc, root); }

        var labels:   Vector[str] = collections_vector.init[str](?alloc);
        var statuses: Vector[i32] = collections_vector.init[i32](?alloc);
        fin {
            collections_vector.dnit[str](?labels);
            collections_vector.dnit[i32](?statuses);
        }

        # the default artifact
        val dr: i32 = artifact_test_statuses(?alloc, ?s, root, "", ?labels, ?statuses);
        if (dr != 0)                                                                  { ret 10 + dr; }
        if (labels.len != 2)                                                          { ret 20; }
        if (status_of(?labels, ?statuses, "lessons.hello#own") != 0)                  { ret 21; }
        if (status_of(?labels, ?statuses, "lessons.common#names_its_artifact") != 11) { ret 22; }

        # the other artifact, which a default run never compiles
        collections_vector.truncate[str](?labels, 0);
        collections_vector.truncate[i32](?statuses, 0);
        val sr2: i32 = artifact_test_statuses(?alloc, ?s, root, "shaded", ?labels, ?statuses);
        if (sr2 != 0)                                                                 { ret 30 + sr2; }
        if (labels.len != 2)                                                          { ret 40; }
        if (status_of(?labels, ?statuses, "lessons.shaded#own") != 0)                 { ret 41; }
        if (status_of(?labels, ?statuses, "lessons.common#names_its_artifact") != 12) { ret 42; }
        ret 0;
    }
}

# a compile error in a module the tests reach fails the test build and collects no test
test test_goal__compile_error_collects_no_tests {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "bad.mach";
    var texts: [2]str;
    texts[0] = driver.joined(?alloc, "use uniontest.bad;\n\n#[symbol(\"", entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n\ntest main_runs { ret 0; }\n");
    texts[1] = "pub fun oops() i32 { ret uniontest_undefined_symbol(); }\n";
    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_TESTS;
    val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_to_run(?alloc, ?s, toolchain.t_registry(), ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: build_plan.BuildPlan = pr.ok;

    var bad:       i32                      = 0;
    var published: publication.Publications = publication.init(?alloc);
    fin { publication.dnit(?published); }
    val r: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?bp, 0, ?s, ?published, ?alloc, nil);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        var bo: outcome.BuildOutcome = r.ok;
        if (bo.severity == outcome.BUILD_OK) { bad = 1; }
        or (bo.tests.len != 0)               { bad = 1; }
        outcome.outcome_dnit(?bo);
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

# the failure compiling the linux `app` artifact of the project at `root` to objects reports,
# the steps it needs run first, or none when it compiled clean; `no_cache` reruns every step
#[testing]
fun step_objects(s: *session.Session, alloc: *A.Allocator, root: str, no_cache: bool) opt[str] {
    val loaded: res[manifest.Manifest, fail.Fail] = driver.load_manifest(s, root);
    if (sel loaded.err) { ret opt[str].some{fail.describe(loaded.err)}; }
    var m:  manifest.Manifest    = loaded.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = "linux";
    rq.artifact     = "app";
    rq.goal         = request.GOAL_OBJECTS;
    rq.no_cache     = no_cache;
    val planned: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_to_run(alloc, s, toolchain.t_registry(), ?m, rq);
    if (sel planned.err) { ret opt[str].some{fail.describe(planned.err)}; }
    var bp:        build_plan.BuildPlan     = planned.ok;
    var published: publication.Publications = publication.init(alloc);
    fin { publication.dnit(?published); }
    var rd: readout.Recording;
    readout.recording_init(?rd, alloc, readout.LEVEL_ITEMS);
    fin { readout.recording_dnit(?rd); }
    val built: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?bp, 0, s, ?published, alloc, ?rd.sink);
    if (sel built.err) { ret opt[str].some{fail.describe(built.err)}; }
    var bo:    outcome.BuildOutcome = built.ok;
    val clean: bool                 = bo.severity == outcome.BUILD_OK;
    outcome.outcome_dnit(?bo);
    if (clean) { ret opt[str].none{}; }
    # what the build reported: its failures and its diagnostics, one to a line
    var text: str   = "";
    var i:    usize = 0;
    for (i < rd.failures.len) {
        text = driver.joined(alloc, text, rd.failures.data[i], "\n");
        i    = i + 1;
    }
    i = 0;
    for (i < rd.diagnostics.len) {
        text = driver.joined(alloc, text, rd.diagnostics.data[i].message, "\n");
        i    = i + 1;
    }
    ret opt[str].some{text};
}

# zero when building `src` as the default artifact of the fixture project fails and links nothing
#[testing]
fun engine_build_fails(src: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names:  [1]str              = [1]str{"main.mach"};
    var texts:  [1]str              = [1]str{src};
    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_to_run(?alloc, ?s, toolchain.t_registry(), ?m, rq);
    if (sel pr.err) { ret 1; }
    var bp:        build_plan.BuildPlan     = pr.ok;
    var published: publication.Publications = publication.init(?alloc);
    fin { publication.dnit(?published); }
    val r: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?bp, 0, ?s, ?published, ?alloc, nil);
    if (sel r.err)                         { ret 1; }
    if (r.ok.severity == outcome.BUILD_OK) { ret 1; }
    if (r.ok.artifacts.len != 0)           { ret 1; }
    ret 0;
}
