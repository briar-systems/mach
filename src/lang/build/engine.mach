#[testing]
fun readout_rows_case(jobs: u32) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [17]str;
    var texts: [17]str;
    ro_files(?alloc, ?names[0], ?texts[0]);

    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 17);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.jobs         = jobs;
    val pr_r: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_to_run(?alloc, ?s, toolchain.t_registry(), ?m, rq);
    if (sel pr_r.err) { ret 1; }
    var bp: build_plan.BuildPlan = pr_r.ok;

    var rd: readout.Recording;
    readout.recording_init(?rd, ?alloc, readout.LEVEL_ITEMS);
    fin { readout.recording_dnit(?rd); }

    var published: publication.Publications = publication.init(?alloc);
    fin { publication.dnit(?published); }
    val r: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?bp, 0, ?s, ?published, ?alloc, ?rd.sink);

    var bad: i32 = 0;
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        val bo: outcome.BuildOutcome = r.ok;
        if (bo.severity != outcome.BUILD_OK) { bad = 1; }
        if (bo.artifacts.len != 1)           { bad = 1; }
    }

    var phs: [8]readout.Phase;
    phs[0] = readout.LOAD;
    phs[1] = readout.RESOLVE;
    phs[2] = readout.SEMA;
    phs[3] = readout.LOWER;
    phs[4] = readout.OPTIMIZE;
    phs[5] = readout.CODEGEN;
    phs[6] = readout.EMIT;
    phs[7] = readout.LINK;

    var i: u32 = 0;
    for (i < 8) {
        val pm: *readout.Recorded = ?rd.phases[phs[i]];
        if (pm.occurrences != 1) { bad = 10 + i::i32; }
        if (pm.items == 0)       { bad = 30 + i::i32; }
        if (pm.workers == 0)     { bad = 50 + i::i32; }
        i = i + 1;
    }
    if (rd.summaries != 1 || rd.other < 0) { bad = 1; }

    ret bad;
}

# a serial and a pooled build each send one row per phase, with its items and workers;
# the durations are the clock's and are not checked
test readout__a_build_records_one_row_per_phase_serial_and_pooled {
    val serial: i32 = readout_rows_case(0);
    if (serial != 0) { ret serial; }
    ret readout_rows_case(4);
}

# a linux project whose app needs one step `vendor` running `argv` and declaring the output
# `{project.work}/<out>`
#[testing]
fun manifest_vendor(alloc: *A.Allocator, argv: str, out: str) str {
    val head: str = driver.joined(alloc, "[project]\nmach = \">=5\"\nid = \"vend\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[step.vendor]\nargv = ", argv, "\nin = [\"src/main.mach\"]\nout = [\"{project.work}/");
    ret driver.joined(alloc, head, out, "\"]\nneed = []\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = [\"step.vendor\"]\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n");
}

#[testing]
fun manifest_step_count() str {
    ret "[project]\nmach = \">=5\"\nid = \"repeatw\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[step.count]\nargv = [\"sh\", \"-c\", 'n=0; if [ -f counter ]; then IFS= read -r n < counter; fi; n=$((n + 1)); printf \"%s\" \"$n\" > counter']\nin = [\"watched\"]\nout = [\"counter\"]\nneed = []\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = [\"step.count\"]\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
}

$if ($mach.build.os == $mach.os.linux && $mach.build.arch == $mach.arch.x86_64) {
    # a run-time result outside 0..255 exits 255 instead of its low eight bits, so it
    # can never read as a pass; a result inside the range is the exit code as is
    test dispatcher__folds_a_wide_run_time_result_to_255 {
        var alloc:  A.Allocator;
        val make_r: err[A.Error] = page.make(?alloc);
        if (sel make_r.err) { ret 1; }
        val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
        if (sel sr.err) { ret 1; }
        var s: session.Session = sr.ok;
        fin { session.dnit(?s); }

        var names: [1]str;
        names[0] = "main.mach";
        var texts: [1]str;
        texts[0] = driver.joined(?alloc,
            "#[noinline]\nfun wide(v: i32) i32 { ret v; }\n",
            "test r256 { ret wide(256); }\ntest rneg1 { ret wide(-1); }\ntest r3 { ret 3; }\ntest r255 { ret 255; }\n",
            dispatcher_stub());
        val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 1);
        if (sel root_r.err) { ret 1; }
        val root: str = root_r.ok;
        fin { fs.remove_all(?alloc, root); }

        val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
        if (sel mr.err) { ret 1; }
        var m:  manifest.Manifest    = mr.ok;
        var rq: request.BuildRequest = request.defaults();
        rq.project_root = root;
        rq.target       = "linux";
        rq.goal         = request.GOAL_TESTS;
        val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_to_run(?alloc, ?s, toolchain.t_registry(), ?m, rq);
        if (sel pr.err) { ret 1; }
        var bp:        build_plan.BuildPlan     = pr.ok;
        var published: publication.Publications = publication.init(?alloc);
        fin { publication.dnit(?published); }
        val r: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?bp, 0, ?s, ?published, ?alloc, nil);
        if (sel r.err) {
            print.eprintln(fail.describe(r.err));
            ret 1;
        }
        var bo: outcome.BuildOutcome = r.ok;
        if (bo.severity != outcome.BUILD_OK) { ret 2; }
        if (bo.tests.len != 4)               { ret 3; }

        var labels: [4]str = [4]str{"uniontest.main#r256", "uniontest.main#rneg1", "uniontest.main#r3", "uniontest.main#r255"};
        var want:   [4]i32 = [4]i32{255, 255, 3, 255};
        var i:      usize  = 0;
        for (i < 4) {
            var found: bool  = false;
            var t:     usize = 0;
            for (t < bo.tests.len) {
                val art: *testrun.TestArtifact = ?bo.tests.data[t];
                if (str_equals(art.name::str, labels[i])) {
                    found = true;
                    val got: i32 = dispatch_status(art.exe::str, art.idx);
                    if (got != want[i]) {
                        print.eprintlnf("{}: exit {} (want {})", labels[i], got::i64, want[i]::i64);
                        ret 10 + i::i32;
                    }
                }
                t = t + 1;
            }
            if (!found) { ret 4; }
            i = i + 1;
        }
        ret 0;
    }
}

# builds the app of `mtext` (main and window modules) for linux in a fresh session, after
# writing a stale window.o into the directory `stale` under the root when it is not empty:
# 0 when it built and `needle_len` is 0, or when it was refused naming every needle
#[testing]
fun vendor_build(alloc: *A.Allocator, mtext: str, stale: str, needles: *str, needle_len: usize) i32 {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names:  [2]str              = [2]str{"main.mach", "window.mach"};
    var texts:  [2]str              = [2]str{"fun main() i32 { ret 0; }\n", "pub fun w() i32 { ret 1; }\n"};
    val root_r: res[str, fail.Fail] = driver.scaffold(alloc, mtext, ?names[0], ?texts[0], 2);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(alloc, root); }
    if (!str_equals(stale, "")) {
        val stale_dir: str             = driver.joined(alloc, root, "/", stale);
        val made:      err[fs.FsError] = fs.create_dir_all(alloc, stale_dir, 493);
        if (sel made.err) { ret 2; }
        val wrote: err[fs.FsError] = fs.write_bytes(driver.joined(alloc, stale_dir, "/", "window.o"), "stale-from-a-crashed-run"::*u8, 24, 420);
        if (sel wrote.err) { ret 2; }
    }
    val refused: opt[str] = step_objects(?s, alloc, root, false);
    if (sel refused.none) {
        if (needle_len == 0) { ret 0; }
        ret 3;
    }
    if (needle_len == 0) { ret 4; }
    val msg: str   = refused.some;
    var i:   usize = 0;
    for (i < needle_len) {
        if (!str_contains(msg, needles[i])) { ret 5; }
        i = i + 1;
    }
    ret 0;
}

#[testing]
rec StepOut {
    argv: str;
    out:  str;
    tree: str;
}

#[testing]
val STEP_OUTS: [4]StepOut = [4]StepOut{
    StepOut{argv: "[\"true\"]", out: "obj/vend/window.o", tree: "module object tree"},
    StepOut{argv: "[\"true\"]", out: ".stage/window.o", tree: "build step staging area"},
    StepOut{argv: "[\"true\"]", out: ".cache/window.o", tree: "compiler cache directory"},
    StepOut{argv: "[\"touch\", \"{project.work}/obj/vend-c/window.o\"]", out: "obj/vend-c/window.o", tree: ""}
};

# a step output inside the module object tree, the staging area or the cache is refused
# naming the step, the path and the tree; a sibling of a module's object directory is not
test step_out__refused_inside_compiler_owned_trees {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var i: usize = 0;
    for (i < 4) {
        val c:       StepOut = STEP_OUTS[i];
        var needles: [3]str  = [3]str{"[step.vendor]", c.out, c.tree};
        var n:       usize   = 3;
        if (str_equals(c.tree, "")) { n = 0; }
        val code: i32 = vendor_build(?alloc, manifest_vendor(?alloc, c.argv, c.out), "", ?needles[0], n);
        if (code != 0) { ret (i::i32 + 1) * 10 + code; }
        i = i + 1;
    }
    ret 0;
}

$if ($mach.build.os != $mach.os.windows) {
    # a step runs once, reruns under no-cache, is reused from its stamp, and reruns when its
    # declared input changes
    test build_step__reruns_only_under_no_cache_or_a_changed_input {
        var alloc:  A.Allocator;
        val make_r: err[A.Error] = page.make(?alloc);
        if (sel make_r.err) { ret 1; }
        val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
        if (sel sr.err) { ret 1; }
        var s: session.Session = sr.ok;
        fin { session.dnit(?s); }

        var names:  [1]str              = [1]str{"main.mach"};
        var texts:  [1]str              = [1]str{"fun main() i32 { ret 0; }\n"};
        val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, manifest_step_count(), ?names[0], ?texts[0], 1);
        if (sel root_r.err) { ret 1; }
        val root: str = root_r.ok;
        fin { fs.remove_all(?alloc, root); }
        val counter: str             = driver.joined(?alloc, root, "/", "counter");
        val watched: str             = driver.joined(?alloc, root, "/", "watched");
        val first:   err[fs.FsError] = fs.write_bytes(watched, "a"::*u8, 1, 420);
        if (sel first.err) { ret 2; }

        # round 0 runs the step, round 1 forces it again, round 2 reuses the round-1 stamp, and
        # round 3 follows an edit of the declared input
        val want:  [4]str = [4]str{"1", "2", "2", "3"};
        var round: u32    = 0;
        for (round < 4) {
            if (round == 3) {
                val edited: err[fs.FsError] = fs.write_bytes(watched, "b"::*u8, 1, 420);
                if (sel edited.err) { ret 2; }
            }
            val refused: opt[str] = step_objects(?s, ?alloc, root, round == 1);
            if (sel refused.some) { ret 3; }
            val text_r: res[str, fs.FsError] = fs.read_string(?alloc, counter);
            if (sel text_r.err) { ret 4; }
            val same: bool = str_equals(text_r.ok, want[round::usize]);
            str_free(?alloc, text_r.ok);
            if (!same) { ret (10 + round)::i32; }
            round = round + 1;
        }
        ret 0;
    }
}

$if ($mach.build.os != $mach.os.windows) {
    # a stale staged output left by a crashed run is discarded before the step runs, so a step
    # that never writes its output is refused rather than publishing the stale file
    test build_step__stale_staging_is_discarded_before_the_run {
        var alloc:  A.Allocator;
        val make_r: err[A.Error] = page.make(?alloc);
        if (sel make_r.err) { ret 1; }
        var needles: [1]str = [1]str{"did not publish valid declared output"};
        ret vendor_build(?alloc, manifest_vendor(?alloc, "[\"true\"]", "obj/vend-c/window.o"),
            "out/linux/debug/.stage/vendor/obj/vend-c", ?needles[0], 1);
    }
}

test build__gate_on_a_variable_fails_the_build {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: i32 = 0;

    # a gate reading a variable is refused by sema, which gives every gate its verdict
    val pk: str = driver.joined(?alloc,
        "tag Reply: u8 { empty; value: i64; }\nvar G: Reply = Reply.value{1};\nfun f() i32 { $if (sel G.value) { ret 1; } ret 0; }\n#[symbol(\"",
        entry_symbol(), "\")]\nfun start() i32 { ret f(); }\n");
    val ok: str = driver.joined(?alloc,
        "fun sink(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a; } ret acc; }\n#[symbol(\"",
        entry_symbol(), "\")]\nfun start() i32 { sink(7::u32, 8::u32); ret 0; }\n");

    if (sema_checked.sema_clean(pk)) { bad = 1; }
    if (engine_build_fails(pk) != 0) { bad = 1; }

    if (engine_build_fails(ok) == 0)  { bad = 1; }
    if (!sema_checked.sema_clean(ok)) { bad = 1; }

    ret bad;
}

# a test build links every module's normal object and each test object beside it
test q_link__records_the_normal_and_test_codegen_keys {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    var texts: [2]str;
    texts[0] = driver.joined(?alloc, "use uniontest.a.fa;\n#[symbol(\"", entry_symbol(), "\")]\nfun start() i32 { ret fa(); }\n");
    texts[1] = "pub fun fa() i32 { ret 0; }\n\ntest a_zero { ret fa(); }\n";
    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_TESTS;
    val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_to_run(?alloc, ?s, toolchain.t_registry(), ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: build_plan.BuildPlan = pr.ok;

    var bad:       i32                      = 0;
    var published: publication.Publications = publication.init(?alloc);
    fin { publication.dnit(?published); }
    val r1: res[outcome.BuildOutcome, fail.Fail] = execute_warm(?bp, 0, ?s, ?published, ?alloc, nil);
    if (sel r1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r1.ok.severity != outcome.BUILD_OK) { bad = 1; }

    val keys_r: res[Vector[query.QueryKey], fail.Fail] = query.cached_dependency_keys(?s.queries, ?passes.LINK, 0, ?alloc);
    if (sel keys_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var keys: Vector[query.QueryKey] = keys_r.ok;
    fin { collections_vector.dnit[query.QueryKey](?keys); }

    var normal_deps: u32   = 0;
    var test_deps:   u32   = 0;
    var i:           usize = 0;
    for (i < keys.len) {
        val d: query.QueryKey = keys.data[i];
        if (d.kind == ?passes.CODEGEN) {
            if (passes.back_half_key_is_test(d.key)) { test_deps = test_deps + 1; }
            or                                       { normal_deps = normal_deps + 1; }
        }
        i = i + 1;
    }
    # only uniontest.a declares a test
    if (normal_deps < 2 || test_deps != 1) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

#[testing]
fun manifest_step_target_env() str {
    ret "[project]\nmach = \">=5\"\nid = \"tenv\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[step.probe]\nargv = [\"sh\", \"-c\", 'test \"$MACH_TARGET_ISA\" = x86_64 && test \"$MACH_TARGET_OS\" = linux && test \"$MACH_TARGET_ABI\" = sysv64 && printf ok > seen']\nenv = { MACH_TARGET_ISA = \"spoofed\", CARRIED = \"through\" }\nin = []\nout = [\"seen\"]\nneed = []\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = [\"step.probe\"]\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
}

