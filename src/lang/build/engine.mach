            if (testrun.arm_failed(native_case_files(?alloc, tag_c_manifest(), ?names[0], ?texts[0], 2, "linux-riscv64", "qemu-riscv64", release, tag_c_program(), "C controls"), ?skipped)) { ret 3; }
            if (testrun.arm_failed(native_case_files(?alloc, tag_c_manifest(), ?names[0], ?texts[0], 2, "windows-x86_64", "wine", release, tag_c_program(), "C controls"), ?skipped))        { ret 4; }
