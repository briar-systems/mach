    # a fixture runs with one WINEPREFIX, XDG_RUNTIME_DIR and WINEDLLOVERRIDES each, its own
    # under its root, whatever the caller set, and the rest of the caller's environment
    test fixture_environment__isolates_wine_from_the_caller {
        var alloc: A.Allocator;
        page.make(?alloc);
        val shell: res[str, exec.Error] = exec.resolve(?alloc, "sh");
        if (sel shell.err) { ret 1; }
        var w:    WarmProject;
        val made: err[fail.Fail] = warm_project_init(?w);
        if (sel made.err) { ret 2; }
        fin { warm_project_dnit(?w); }
        var names:      [1]str         = [1]str{"main.mach"};
        var texts:      [1]str         = [1]str{""};
        val scaffolded: err[fail.Fail] = warm_project_scaffold(?w, native_manifest(), ?names[0], ?texts[0], 1);
        if (sel scaffolded.err) { ret 3; }
        val probe: res[str, std_format.FormatError] = std_format.sprint(?alloc, "[ \"$(env | grep -c '^WINEPREFIX=')\" = 1 ] || exit 11\n[ \"$(env | grep -c '^XDG_RUNTIME_DIR=')\" = 1 ] || exit 12\n[ \"$(env | grep -c '^WINEDLLOVERRIDES=')\" = 1 ] || exit 13\n[ \"$WINEPREFIX\" = \"{}/wine-prefix\" ] || exit 14\n[ \"$XDG_RUNTIME_DIR\" = \"{}/xdg-runtime\" ] && [ -d \"$XDG_RUNTIME_DIR\" ] || exit 15\n[ \"$WINEDLLOVERRIDES\" = \"winewayland.drv=d;winex11.drv=d;winedbg.exe=d\" ] || exit 16\n[ \"$KEPT\" = kept ] || exit 17\n", w.root, w.root);
        if (sel probe.err) { ret 4; }
        val path: res[str, A.Error] = types_path.join(?alloc, w.root, "probe.sh");
        if (sel path.err) { ret 5; }
        val wrote: err[fs.FsError] = fs.write_bytes(path.ok, probe.ok, str_len(probe.ok), 420);
        if (sel wrote.err) { ret 6; }
        val inherited: res[opt[OwnedString], env.EnvError] = env.value(?alloc, "PATH");
        if (sel inherited.err)     { ret 9; }
        if (sel inherited.ok.none) { ret 9; }
        val search: res[str, std_format.FormatError] = std_format.sprint(?alloc, "PATH={}", inherited.ok.some.data);
        if (sel search.err) { ret 10; }
        var caller:  [6]*u8 = [6]*u8{search.ok, "WINEPREFIX=/caller/.wine", "XDG_RUNTIME_DIR=/run/user/caller", "WINEDLLOVERRIDES=caller", "KEPT=kept", nil};
        var trapped: bool   = false;
        var code:    i32    = 0;
        if (!run_fixture(w.root, shell.ok, path.ok, 1, exec.Environment.given{?caller[0]}, ?trapped, ?code)) { ret 7; }
        if (trapped)                                                                                         { ret 8; }
        ret code;
    }

