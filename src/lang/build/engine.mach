rec UnitState {
    obj_paths:    **u8;
    obj_len:      u32;
    dynlibs:      *of.DynLib;
    dynlib_len:   u32;

    out_path:     *u8;
    scope:        btest.TestScope;
    outputs:      publication.Plan;
    objects:      **publication.Destination;
    ir_outputs:   **publication.Destination;
    asm_outputs:  **publication.Destination;
    artifact:     *publication.Destination;
    dispatcher:   *publication.Destination;
}


fun blocking_requirement(failed: *Vector[str], u: *plan.BuildUnit) str {
    var i: usize = 0;
    for (i < u.requires.len) {
        var j: usize = 0;
        for (j < failed.len) {
            if (str_equals(failed.data[j], u.requires.data[i])) { ret u.requires.data[i]; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret nil;
}

fun record_blocked_unit(bo: *outcome.BuildOutcome, oa: *A.Allocator, failed: *Vector[str],
                        u: *plan.BuildUnit, blocked_by: str) err[outcome.Fail] {
    var f: outcome.Fail = outcome.user(plan.join_msg(oa,
        "artifact '", u.sel_artifact, "' was not built: it requires artifact '", blocked_by,
        "', which failed to build"));
    val fail_r: err[A.Error] = outcome.record_fail(bo, ?f);
    if (sel fail_r.err) { ret err[outcome.Fail].err{outcome.internal(alloc.text(fail_r.err))}; }
    outcome.fold_fail(bo, ?f);
    val pr: res[usize, A.Error] = vector.push[str](failed, u.sel_artifact);
    if (sel pr.err) { ret err[outcome.Fail].err{outcome.refused(pr.err)}; }
    ret err[outcome.Fail].ok{};
}

pub fun execute(bp: *plan.BuildPlan, backing: *A.Allocator, oa: *A.Allocator,
                ev: *readout.Progress) res[outcome.BuildOutcome, outcome.Fail] {
    var bo: outcome.BuildOutcome = outcome.outcome_init(oa);
    var failed: Vector[str] = vector.init[str](oa);

    var i: usize = 0;
    for (i < bp.units.len) {
        val unit: *plan.BuildUnit = ?bp.units.data[i];
        val event_r: err[A.Error] = outcome.record_unit(?bo, unit.sel_artifact, unit.sel_target, unit.has_artifact);
        if (sel event_r.err) {
            outcome.outcome_dnit(?bo);
            ret res[outcome.BuildOutcome, outcome.Fail].err{outcome.internal("failed to record build unit")};
        }

        val blocked_by: str = blocking_requirement(?failed, unit);
        if (blocked_by != nil) {
            val br: err[outcome.Fail] = record_blocked_unit(?bo, oa, ?failed, unit, blocked_by);
            if (sel br.err) {
                outcome.outcome_dnit(?bo);
                ret res[outcome.BuildOutcome, outcome.Fail].err{br.err};
            }
            i = i + 1;
            cnt;
        }
        readout.unit_begin(ev);

        val ur: res[outcome.BuildOutcome, outcome.Fail] = execute_unit_cold(bp, i, backing, oa, ev);
        if (sel ur.err) {
            var f: outcome.Fail = ur.err;
            val fail_r: err[A.Error] = outcome.record_fail(?bo, ?f);
            if (sel fail_r.err) {
                outcome.outcome_dnit(?bo);
                ret res[outcome.BuildOutcome, outcome.Fail].err{outcome.internal("failed to record build failure")};
            }
            outcome.fold_fail(?bo, ?f);
            val pr: res[usize, A.Error] = vector.push[str](?failed, unit.sel_artifact);
            if (sel pr.err) {
                outcome.outcome_dnit(?bo);
                ret res[outcome.BuildOutcome, outcome.Fail].err{outcome.internal("out of memory")};
            }
        }
        if (sel ur.ok) {
            var ubo: outcome.BuildOutcome = ur.ok;
            if (ubo.severity != outcome.BUILD_OK) {
                val fr: res[usize, A.Error] = vector.push[str](?failed, unit.sel_artifact);
                if (sel fr.err) {
                    outcome.outcome_dnit(?ubo);
                    outcome.outcome_dnit(?bo);
                    ret res[outcome.BuildOutcome, outcome.Fail].err{outcome.internal("out of memory")};
                }
            }
            val mr: err[A.Error] = outcome.merge(?bo, ?ubo);
            if (sel mr.err) {
                outcome.outcome_dnit(?ubo);
                outcome.outcome_dnit(?bo);
                ret res[outcome.BuildOutcome, outcome.Fail].err{outcome.internal("failed to merge build outcome")};
            }
        }
        i = i + 1;
    }
    ret res[outcome.BuildOutcome, outcome.Fail].ok{bo};
}

fun execute_unit_cold(bp: *plan.BuildPlan, unit_index: usize, backing: *A.Allocator,
                      oa: *A.Allocator, ev: *readout.Progress) res[outcome.BuildOutcome, outcome.Fail] {
    var u_ar: arena.Arena;
    val init_r: err[A.Error] = arena.init(?u_ar, backing, 0);
    if (sel init_r.err) {
        ret cold_fail(oa, outcome.internal("failed to initialise allocator"));
    }
    var u_alloc: A.Allocator;
    val make_r: err[A.Error] = arena.make(?u_alloc, ?u_ar);
    if (sel make_r.err) {
        arena.dnit(?u_ar);
        ret cold_fail(oa, outcome.internal("failed to initialise allocator"));
    }

    var r: res[outcome.BuildOutcome, outcome.Fail];
    val res_session: res[session.Session, fail.Fail] = session.init_typed(?u_alloc);
    if (sel res_session.err) {
        val f: outcome.Fail = outcome.internal(plan.join_msg(?u_alloc, "failed to initialise compiler session: ", fail.describe(res_session.err)));
        r = cold_fail(oa, f);
    }
    if (sel res_session.ok) {
        var s: session.Session = res_session.ok;
        r = execute_warm(bp, unit_index, ?s, oa, ev);
        session.dnit(?s);
    }

    arena.dnit(?u_ar);
    ret r;
}

fun cold_fail(oa: *A.Allocator, f: outcome.Fail) res[outcome.BuildOutcome, outcome.Fail] {
    var bo: outcome.BuildOutcome = outcome.outcome_init(oa);
    ret warm_fail(?bo, f);
}

rec PoisonState {
    real:    A.Allocator;
    fail_at: usize;
    calls:   usize;
}

fun poison_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val st: *PoisonState = ctx::*PoisonState;
    st.calls = st.calls + 1;
    if (st.fail_at != 0 && st.calls == st.fail_at) { ret opt[ptr].none{}; }
    ret st.real.fn_allocate(st.real.ctx, size, align);
}

fun poison_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val st: *PoisonState = ctx::*PoisonState;
    ret st.real.fn_reallocate(st.real.ctx, p, old_size, new_size, align);
}

fun poison_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    if (p != nil && size > 0) {
        var i: usize = 0;
        for (i < size) { (p::*u8)[i] = 0xAA::u8; i = i + 1; }
    }
    ret 0;
}

# the recorded failure is internal, owns live (unpoisoned) text, and names the cause
fun t_event_internal_text_contains(ev: *outcome.BuildEvent, needle: str) bool {
    if (!sel ev.fail) { ret false; }
    if (!sel ev.fail.internal) { ret false; }
    if (ev.fail.internal == nil) { ret false; }
    if ((ev.fail.internal::*u8)[0] == 0xAA::u8) { ret false; }
    ret str_contains(ev.fail.internal, needle);
}

test "mach.lang.build.engine.execute_unit_cold:session_init_failure_message_survives_arena_teardown" {
    var real: A.Allocator;
    val make_r: err[A.Error] = page.make(?real);
    if (sel make_r.err) { ret 1; }
    var st: PoisonState;
    st.real    = real;
    st.fail_at = 1;
    st.calls   = 0;
    var backing: A.Allocator;
    backing.ctx           = (?st)::ptr;
    backing.fn_allocate   = poison_allocate;
    backing.fn_reallocate = poison_reallocate;
    backing.fn_deallocate = poison_deallocate;

    var oa: A.Allocator;
    val make_r2: err[A.Error] = page.make(?oa);
    if (sel make_r2.err) { ret 2; }

    var bp: plan.BuildPlan;
    val r: res[outcome.BuildOutcome, outcome.Fail] = execute_unit_cold(?bp, 0::usize, ?backing, ?oa, nil);
    if (sel r.err) { ret 3; }

    var bo: outcome.BuildOutcome = r.ok;
    var bad: i32 = 0;
    if (bo.severity != outcome.BUILD_INTERNAL || bo.events.len != 1) { bad = 1; }
    or (!t_event_internal_text_contains(?bo.events.data[0], "failed to initialise compiler session")) { bad = 1; }
    outcome.outcome_dnit(?bo);
    ret bad;
}

pub fun execute_warm(bp: *plan.BuildPlan, unit_index: usize, s: *session.Session, oa: *A.Allocator,
                     ev: *readout.Progress) res[outcome.BuildOutcome, outcome.Fail] {
    if (unit_index >= bp.units.len) {
        ret res[outcome.BuildOutcome, outcome.Fail].err{outcome.internal("build unit index out of range")};
    }
    val planned: *plan.BuildUnit = ?bp.units.data[unit_index];

    var bo: outcome.BuildOutcome = outcome.outcome_init(oa);

    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(s.alloc);

    var call_backing: A.Allocator;
    val make_r: err[A.Error] = page.make(?call_backing);
    if (sel make_r.err) {
        ret warm_fail(?bo, outcome.internal("failed to initialise allocator"));
    }
    var call_ar: arena.Arena;
    val init_r: err[A.Error] = arena.init(?call_ar, ?call_backing, 0);
    if (sel init_r.err) {
        ret warm_fail(?bo, outcome.internal("failed to initialise allocator"));
    }
    var call_alloc: A.Allocator;
    val make_r2: err[A.Error] = arena.make(?call_alloc, ?call_ar);
    if (sel make_r2.err) {
        arena.dnit(?call_ar);
        ret warm_fail(?bo, outcome.internal("failed to initialise allocator"));
    }

    val prior_build: *A.Allocator = s.build_alloc;
    s.build_alloc = ?call_alloc;
    fin {
        s.build_alloc = prior_build;
        arena.dnit(?call_ar);
    }

    val res_register: err[outcome.Fail] = driver.setup_registry(?s.registry);
    if (sel res_register.err) {
        val r: res[outcome.BuildOutcome, outcome.Fail] = warm_fail(?bo, res_register.err);
        ret r;
    }

    val res_manifest: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(s, bp.request.project_root);
    if (sel res_manifest.err) {
        val r: res[outcome.BuildOutcome, outcome.Fail] = warm_fail(?bo, res_manifest.err);
        ret r;
    }
    var m: manifest.Manifest = res_manifest.ok;

    var req: request.BuildRequest =
        request.for_cell(?bp.request, planned.sel_target, planned.sel_artifact, planned.want_lib,
                         planned.subsystem, planned.goal);

    val replan_r: res[plan.BuildUnit, outcome.Fail] = plan.replan_unit(?call_alloc, ?s.interner, ?s.registry, ?m, ?req, planned);
    if (sel replan_r.err) {
        val r: res[outcome.BuildOutcome, outcome.Fail] = warm_fail(?bo, replan_r.err);
        ret r;
    }
    var cell: plan.BuildUnit = replan_r.ok;
    val unit: *plan.BuildUnit = ?cell;

    val begin_r: res[driver.Project, outcome.Fail] = driver.begin_build(s, ?m, ?req, ev);
    if (sel begin_r.err) {
        val diags_r: err[outcome.Fail] = outcome.record_diagnostics(?bo, ?s.sources, ?s.diags);
        if (sel diags_r.err) {
            outcome.outcome_dnit(?bo);
            ret res[outcome.BuildOutcome, outcome.Fail].err{outcome.internal("failed to snapshot build diagnostics")};
        }
        ret warm_fail(?bo, begin_r.err);
    }
    var p: driver.Project = begin_r.ok;

    var st: UnitState;
    st.obj_paths    = nil;
    st.obj_len      = 0;
    st.dynlibs      = nil;
    st.dynlib_len   = 0;
    st.out_path     = nil;
    st.scope.have    = false;
    st.scope.pick     = nil;
    st.scope.sel_len = 0;
    st.scope.skipped = 0;

    var result: err[outcome.Fail] = err[outcome.Fail].ok{};
    var pi: usize = 0;
    for (pi < unit.phases.len) {
        result = run_phase(unit.phases.data[pi], ?p, unit, ?st, ?bo, oa, ev);
        if (sel result.err) { brk; }
        pi = pi + 1;
    }

    val result_ok3: bool = sel result.ok && req.goal == request.GOAL_TEST_LIST;
    if (result_ok3) {
        result = list_tests(?p, ?st, ?bo, oa);
    }

    val result_ok4: bool = sel result.ok;
    if (result_ok4) {
        result = record_artifact(?p, unit, ?st, ?bo);
    }

    if (st.out_path != nil) { st.out_path = unit.out_path::*u8; }
    val released: err[txn.Error] = release_outputs(?p, ?st);
    val refreshed: err[outcome.Fail] = driver.refresh_diagnostics(?p);
    var event_error: str = nil;
    if (sel result.err) {
        var f: outcome.Fail = result.err;
        val fail_r: err[A.Error] = outcome.record_fail(?bo, ?f);
        if (sel fail_r.err) { event_error = "failed to record build failure"; }
    }
    if (sel refreshed.err) {
        var failure: outcome.Fail = refreshed.err;
        val recorded: err[A.Error] = outcome.record_fail(?bo, ?failure);
        if (sel recorded.err) { event_error = "failed to record diagnostic refresh failure"; }
        outcome.fold_fail(?bo, ?failure);
        val result_ok: bool = sel result.ok;
        if (result_ok) { result = refreshed; }
    }
    if (sel released.err) {
        val error: txn.Error = released.err;
        val detail: str = plan.join_msg(p.alloc, "publication cleanup: ", txn.error_message(error));
        var cleanup: outcome.Fail = outcome.environment(detail);
        if (error.kind == txn.INVALID) { cleanup = outcome.internal(detail); }
        val recorded: err[A.Error] = outcome.record_fail(?bo, ?cleanup);
        if (sel recorded.err) { event_error = "failed to record publication cleanup failure"; }
        outcome.fold_fail(?bo, ?cleanup);
        val result_ok2: bool = sel result.ok;
        if (result_ok2) { result = err[outcome.Fail].err{cleanup}; }
    }
    if (sel result.ok && ev != nil && req.goal != request.GOAL_CHECK) {
        emit_unit_summary(?p, ?st, ev);
    }

    if (event_error == nil) {
        val diags_r: err[outcome.Fail] = outcome.record_diagnostics(?bo, ?s.sources, ?s.diags);
        if (sel diags_r.err) { event_error = "failed to snapshot build diagnostics"; }
    }
    btest.free_scope(?p, ?st.scope);
    pcg_sweep_staged(?p);
    driver.dnit_project(?p);

    if (event_error != nil) {
        outcome.outcome_dnit(?bo);
        ret res[outcome.BuildOutcome, outcome.Fail].err{outcome.internal(event_error)};
    }

    if (sel result.err) {
        var f: outcome.Fail = result.err;
        outcome.fold_fail(?bo, ?f);
    }
    ret res[outcome.BuildOutcome, outcome.Fail].ok{bo};
}

pub fun execute_warm_all(bp: *plan.BuildPlan, s: *session.Session, oa: *A.Allocator,
                         ev: *readout.Progress) res[outcome.BuildOutcome, outcome.Fail] {
    var bo: outcome.BuildOutcome = outcome.outcome_init(oa);
    var failed: Vector[str] = vector.init[str](oa);

    var i: usize = 0;
    for (i < bp.units.len) {
        val unit: *plan.BuildUnit = ?bp.units.data[i];
        val event_r: err[A.Error] = outcome.record_unit(?bo, unit.sel_artifact, unit.sel_target, unit.has_artifact);
        if (sel event_r.err) {
            outcome.outcome_dnit(?bo);
            ret res[outcome.BuildOutcome, outcome.Fail].err{outcome.internal("failed to record build unit")};
        }

        val blocked_by: str = blocking_requirement(?failed, unit);
        if (blocked_by != nil) {
            val br: err[outcome.Fail] = record_blocked_unit(?bo, oa, ?failed, unit, blocked_by);
            if (sel br.err) {
                outcome.outcome_dnit(?bo);
                ret res[outcome.BuildOutcome, outcome.Fail].err{br.err};
            }
            i = i + 1;
            cnt;
        }
        readout.unit_begin(ev);

        val ur: res[outcome.BuildOutcome, outcome.Fail] = execute_warm(bp, i, s, oa, ev);
        if (sel ur.err) {
            var f: outcome.Fail = ur.err;
            val fail_r: err[A.Error] = outcome.record_fail(?bo, ?f);
            if (sel fail_r.err) {
                outcome.outcome_dnit(?bo);
                ret res[outcome.BuildOutcome, outcome.Fail].err{outcome.internal("failed to record build failure")};
            }
            outcome.fold_fail(?bo, ?f);
            val pr: res[usize, A.Error] = vector.push[str](?failed, unit.sel_artifact);
            if (sel pr.err) {
                outcome.outcome_dnit(?bo);
                ret res[outcome.BuildOutcome, outcome.Fail].err{outcome.internal("out of memory")};
            }
        }
        if (sel ur.ok) {
            var ubo: outcome.BuildOutcome = ur.ok;
            if (ubo.severity != outcome.BUILD_OK) {
                val fr: res[usize, A.Error] = vector.push[str](?failed, unit.sel_artifact);
                if (sel fr.err) {
                    outcome.outcome_dnit(?ubo);
                    outcome.outcome_dnit(?bo);
                    ret res[outcome.BuildOutcome, outcome.Fail].err{outcome.internal("out of memory")};
                }
            }
            val mr: err[A.Error] = outcome.merge(?bo, ?ubo);
            if (sel mr.err) {
                outcome.outcome_dnit(?ubo);
                outcome.outcome_dnit(?bo);
                ret res[outcome.BuildOutcome, outcome.Fail].err{outcome.internal("failed to merge build outcome")};
            }
        }
        i = i + 1;
    }
    ret res[outcome.BuildOutcome, outcome.Fail].ok{bo};
}

fun pcg_sweep_staged(p: *driver.Project) {
    var i: u32 = 0;
    for (i < p.module_len) {
        val m: *driver.ModuleEntry = ?p.modules[i];
        if (m.staged_image != nil) {
            obj.dnit(m.staged_image);
            A.deallocate[of.ObjectImage](p.s.alloc, m.staged_image, 1::usize);
            m.staged_image = nil;
        }
        i = i + 1;
    }
}

fun warm_fail(bo: *outcome.BuildOutcome, f: outcome.Fail) res[outcome.BuildOutcome, outcome.Fail] {
    var fv: outcome.Fail = f;
    val fail_r: err[A.Error] = outcome.record_fail(bo, ?fv);
    if (sel fail_r.err) {
        outcome.outcome_dnit(bo);
        ret res[outcome.BuildOutcome, outcome.Fail].err{outcome.internal("failed to record build failure")};
    }
    outcome.fold_fail(bo, ?fv);
    ret res[outcome.BuildOutcome, outcome.Fail].ok{@bo};
}

fun plan_module_outputs(p: *driver.Project, outputs: *publication.Plan, base: str, suffix: str) res[**publication.Destination, outcome.Fail] {
    if (p.emit_len == 0) { ret res[**publication.Destination, outcome.Fail].ok{nil}; }
    val allocated: res[**publication.Destination, A.Error] = A.allocate[*publication.Destination](p.alloc, p.emit_len::usize);
    if (sel allocated.err) {
        ret res[**publication.Destination, outcome.Fail].err{outcome.refused(allocated.err)};
    }
    val destinations: **publication.Destination = allocated.ok;
    var complete: bool = false;
    fin { if (!complete) { A.deallocate[*publication.Destination](p.alloc, destinations, p.emit_len::usize); } }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *driver.ModuleEntry = ?p.modules[p.topo[i]::u32];
        val fqn: opt[str] = intern.lookup_typed(?p.s.interner, m.fqn);
        if (sel fqn.none) {
            ret res[**publication.Destination, outcome.Fail].err{outcome.internal("module FQN not interned")};
        }
        val name_r: res[str, outcome.Fail] = emit.mirror_fqn(p.alloc, base, fqn.some, suffix);
        if (sel name_r.err) {
            ret res[**publication.Destination, outcome.Fail].err{name_r.err};
        }
        val name: str = name_r.ok;
        val reserved: res[*publication.Destination, outcome.Fail] = publication.plan_add_typed(outputs, name, true);
        str_free(p.alloc, name);
        if (sel reserved.err) {
            ret res[**publication.Destination, outcome.Fail].err{reserved.err};
        }
        destinations[i] = reserved.ok;
        i = i + 1;
    }
    complete = true;
    ret res[**publication.Destination, outcome.Fail].ok{destinations};
}

fun plan_outputs(p: *driver.Project, unit: *plan.BuildUnit, st: *UnitState) err[outcome.Fail] {
    val initialized: err[txn.Error] = publication.plan_init_typed(?st.outputs, p.alloc);
    if (sel initialized.err) {
        ret err[outcome.Fail].err{outcome.internal(txn.error_message(initialized.err))};
    }
    val goal: request.BuildGoal = p.req.goal;
    val flat: bool = p.target.of != nil && p.target.of.produces_image;
    val objects: bool = (goal == request.GOAL_EXECUTE && !flat)
        || goal == request.GOAL_OBJECTS || goal == request.GOAL_TESTS;
    if (objects) {
        val planned: res[**publication.Destination, outcome.Fail] = plan_module_outputs(p, ?st.outputs, unit.obj_dir, p.target.of.object_ext);
        if (sel planned.err) { ret err[outcome.Fail].err{planned.err}; }
        st.objects = planned.ok;
    }
    if (p.req.emit_ir) {
        val planned: res[**publication.Destination, outcome.Fail] = plan_module_outputs(p, ?st.outputs, unit.ir_dir, "ir");
        if (sel planned.err) { ret err[outcome.Fail].err{planned.err}; }
        st.ir_outputs = planned.ok;
    }
    if (p.req.emit_asm) {
        val planned: res[**publication.Destination, outcome.Fail] = plan_module_outputs(p, ?st.outputs, unit.asm_dir, "s");
        if (sel planned.err) { ret err[outcome.Fail].err{planned.err}; }
        st.asm_outputs = planned.ok;
    }
    if ((goal == request.GOAL_EXECUTE && !plan.finished_modules(?p.target)) || goal == request.GOAL_TESTS) {
        val planned: res[*publication.Destination, outcome.Fail] = publication.plan_add_typed(?st.outputs, unit.out_path, true);
        if (sel planned.err) {
            ret err[outcome.Fail].err{planned.err};
        }
        st.artifact = planned.ok;
    }
    if (goal == request.GOAL_TESTS) {
        val name_r: res[str, A.Error] = path.join(p.alloc, unit.obj_dir, "__mach_test_dispatch.o");
        if (sel name_r.err) { ret err[outcome.Fail].err{outcome.refused(name_r.err)}; }
        val name: str = name_r.ok;
        val planned: res[*publication.Destination, outcome.Fail] = publication.plan_add_typed(?st.outputs, name, true);
        str_free(p.alloc, name);
        if (sel planned.err) {
            ret err[outcome.Fail].err{planned.err};
        }
        st.dispatcher = planned.ok;
    }
    val sealed: err[txn.Error] = publication.plan_seal_typed(?st.outputs);
    if (sel sealed.err) {
        ret err[outcome.Fail].err{outcome.environment(txn.error_message(sealed.err))};
    }
    ret err[outcome.Fail].ok{};
}

fun release_outputs(p: *driver.Project, st: *UnitState) err[txn.Error] {
    if (st.objects != nil) { A.deallocate[*publication.Destination](p.alloc, st.objects, p.emit_len::usize); st.objects = nil; }
    if (st.ir_outputs != nil) { A.deallocate[*publication.Destination](p.alloc, st.ir_outputs, p.emit_len::usize); st.ir_outputs = nil; }
    if (st.asm_outputs != nil) { A.deallocate[*publication.Destination](p.alloc, st.asm_outputs, p.emit_len::usize); st.asm_outputs = nil; }
    ret publication.plan_dnit_typed(?st.outputs);
}

fun run_phase(ph: plan.PhaseKind, p: *driver.Project, unit: *plan.BuildUnit, st: *UnitState,
              bo: *outcome.BuildOutcome, oa: *A.Allocator,
              ev: *readout.Progress) err[outcome.Fail] {
    val phase_name_r: opt[str] = plan.phase_name(ph);
    if (sel phase_name_r.none) {
        ret err[outcome.Fail].err{plan.unknown_phase(oa, ph)};
    }
    var result: err[outcome.Fail] = err[outcome.Fail].err{outcome.internal("unknown build phase")};
    if (ph == plan.PH_STEPS)     { result = driver.run_steps_phase(p); }
    if (ph == plan.PH_DEP_STEPS) { result = driver.run_dep_steps_phase(p); }
    if (ph == plan.PH_LOAD)      { result = load_phase(p); }
    if (ph == plan.PH_SEMA)      { result = driver.run_sema_pass(p); }
    if (ph == plan.PH_LOWER)     { result = lower_phase(p, st, bo, ev); }
    if (ph == plan.PH_CODEGEN) {
        result = plan_outputs(p, unit, st);
        val result_ok: bool = sel result.ok;
        if (result_ok) { result = codegen_phase(p, st, ev); }
    }
    if (ph == plan.PH_EMIT)      { result = emit_phase(p, unit, st, bo, ev); }
    if (ph == plan.PH_LINK)      { result = link_phase(p, unit, st, bo, oa, ev); }

    if (sel result.err) { ret result; }
    if (ph == plan.PH_LOAD || ph == plan.PH_SEMA) {
        val status: fail.PhaseStatus = driver.frontend_status(p);
        if (!sel status.kind.accepted) { ret err[outcome.Fail].err{outcome.from_fail(fail.phase_failure(status))}; }
    }
    ret result;
}

test "mach.lang.build.engine.run_phase:unknown_catalog_member_is_internal_before_execution" {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val link: opt[str] = plan.phase_name(plan.PH_LINK);
    if (sel link.none) { ret 2; }
    if (!str_equals(link.some, "link")) { ret 2; }
    val phase_name_r: opt[str] = plan.phase_name(255::plan.PhaseKind);
    if (sel phase_name_r.none) { ret 99; }
    if (sel phase_name_r.some) { ret 3; }
    val result: err[outcome.Fail] = run_phase(255::plan.PhaseKind, nil, nil, nil, nil, ?a, nil);
    if (sel result.ok) { ret 4; }
    val failure: outcome.Fail = result.err;
    fin { outcome.release_text(?a, failure); }
    if (!sel failure.internal) { ret 5; }
    if (!str_contains(outcome.describe(failure), "PhaseKind")) { ret 5; }
    if (!str_contains(outcome.describe(failure), "255")) { ret 5; }
    ret 0;
}

fun load_phase(p: *driver.Project) err[outcome.Fail] {
    val lr: err[outcome.Fail] = driver.run_load_phase(p);
    if (sel lr.err) { ret lr; }
    if (p.module_len == 0) {
        ret err[outcome.Fail].err{outcome.user("project graph is empty; the entrypoint loaded no modules")};
    }
    ret err[outcome.Fail].ok{};
}

fun collect_test_scope(p: *driver.Project, st: *UnitState) err[outcome.Fail] {
    val allocated: res[*ir.Module, A.Error] = A.zallocate[ir.Module](p.alloc, p.module_len::usize);
    if (sel allocated.err) {
        ret err[outcome.Fail].err{outcome.refused(allocated.err)};
    }
    val headers: *ir.Module = allocated.ok;
    fin { A.deallocate[ir.Module](p.alloc, headers, p.module_len::usize); }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId = p.topo[i];
        val current: *ir.Module = p.modules[mid::u32].ir_module;
        if (current == nil) { ret err[outcome.Fail].err{outcome.internal("test collection requires a current lowered module")}; }
        headers[mid::u32] = @current;
        i = i + 1;
    }
    ret btest.collect_scope(p, headers, ?st.scope);
}

fun current_image_headers(p: *driver.Project) res[*of.ObjectImage, outcome.Fail] {
    val allocated: res[*of.ObjectImage, A.Error] = A.zallocate[of.ObjectImage](p.alloc, p.module_len::usize);
    if (sel allocated.err) {
        ret res[*of.ObjectImage, outcome.Fail].err{outcome.refused(allocated.err)};
    }
    val headers: *of.ObjectImage = allocated.ok;
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId = p.topo[i];
        val current: *of.ObjectImage = p.modules[mid::u32].object_image;
        if (current == nil) {
            A.deallocate[of.ObjectImage](p.alloc, headers, p.module_len::usize);
            ret res[*of.ObjectImage, outcome.Fail].err{outcome.internal("image publication requires a current codegen module")};
        }
        headers[mid::u32] = @current;
        i = i + 1;
    }
    ret res[*of.ObjectImage, outcome.Fail].ok{headers};
}

fun lower_phase(p: *driver.Project, st: *UnitState, bo: *outcome.BuildOutcome, ev: *readout.Progress) err[outcome.Fail] {
    readout.phase_begin(ev, readout.PH_LOWER);
    readout.phase_begin(ev, readout.PH_OPTIMIZE);
    readout.phase_carved(ev, readout.PH_OPTIMIZE);

    val res_lower: err[outcome.Fail] = driver.run_lower_pass(p);
    if (sel res_lower.err) { ret res_lower; }

    var total: u32 = 0;
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId    = p.topo[i];
        val m:   *driver.ModuleEntry = ?p.modules[mid::u32];
        total = total + m.ir_module.vector_ops_scalarized;
        i = i + 1;
    }
    if (total > 0) {
        val note_r: err[A.Error] = outcome.record_note(bo, total);
        if (sel note_r.err) {
            ret err[outcome.Fail].err{outcome.internal("failed to record scalarization note")};
        }
    }

    if (p.req.goal == request.GOAL_TESTS || p.req.goal == request.GOAL_TEST_LIST) {
        val collected: err[outcome.Fail] = collect_test_scope(p, st);
        if (sel collected.err) { ret collected; }
        bo.tests_skipped = st.scope.skipped;
    }

    readout.phase_end(ev, readout.PH_LOWER, p.emit_len, "module", "modules");
    readout.phase_end(ev, readout.PH_OPTIMIZE, p.emit_len, "module", "modules");
    ret err[outcome.Fail].ok{};
}

fun codegen_phase(p: *driver.Project, st: *UnitState, ev: *readout.Progress) err[outcome.Fail] {
    readout.phase_begin(ev, readout.PH_CODEGEN);
    val prepared: err[outcome.Fail] = passes.prepare_codegen_pass(p);
    if (sel prepared.err) { ret prepared; }

    var roots: Vector[query.QueryKey] = vector.init[query.QueryKey](p.alloc);
    fin { vector.dnit[query.QueryKey](?roots); }
    val frontend: err[outcome.Fail] = driver.append_frontend_roots(p, ?roots);
    if (sel frontend.err) { ret frontend; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *driver.ModuleEntry = ?p.modules[p.topo[i]::u32];
        val key: u64 = passes.back_half_key_for(p, m);
        val lowered: res[usize, A.Error] = vector.push[query.QueryKey](?roots,
            query.QueryKey{kind: query.Q_LOWER, key: key});
        if (sel lowered.err) {
            ret err[outcome.Fail].err{outcome.refused(lowered.err)};
        }
        val emitted: res[usize, A.Error] = vector.push[query.QueryKey](?roots,
            query.QueryKey{kind: query.Q_CODEGEN, key: key});
        if (sel emitted.err) {
            ret err[outcome.Fail].err{outcome.refused(emitted.err)};
        }
        i = i + 1;
    }
    val started: res[query.Operation, outcome.Fail] = driver.begin_query_phase(p);
    if (sel started.err) {
        ret err[outcome.Fail].err{started.err};
    }
    val operation: query.Operation = started.ok;
    var result: err[outcome.Fail] = passes.acquire_codegen_inputs(p);
    val result_ok: bool = sel result.ok;
    if (result_ok) { result = passes.prepare_persistent_cache(p); }
    val result_ok3: bool = sel result.ok && pcg_enabled(p);
    if (result_ok3) {
        val parallel: err[fail.Fail] = run_codegen_parallel(p);
        if (sel parallel.err) {
            result = err[outcome.Fail].err{outcome.from_fail(parallel.err)};
        }
    }
    val result_ok2: bool = sel result.ok;
    if (result_ok2) { result = passes.run_codegen_pass(p); }
    val result2: err[outcome.Fail] = driver.finish_query_phase(p, operation, roots.data, roots.len, result);
    if (sel result2.err) { ret result2; }

    readout.phase_end(ev, readout.PH_CODEGEN, p.emit_len, "module", "modules");
    ret err[outcome.Fail].ok{};
}

fun emit_phase(p: *driver.Project, unit: *plan.BuildUnit, st: *UnitState,
               bo: *outcome.BuildOutcome, ev: *readout.Progress) err[outcome.Fail] {
    val goal: request.BuildGoal = p.req.goal;
    val flat: bool = p.target.of != nil && p.target.of.produces_image;

    readout.phase_begin(ev, readout.PH_EMIT);

    if (p.req.emit_ir || p.req.emit_asm) {
        var i: u32 = 0;
        for (i < p.emit_len) {
            val mid: session.ModuleId    = p.topo[i];
            val m:   *driver.ModuleEntry = ?p.modules[mid::u32];
            if (p.req.emit_ir) {
                val res_ir: err[outcome.Fail] = emit.emit_ir(p, st.ir_outputs[i], m.ir_module);
                if (sel res_ir.err) {
                    ret err[outcome.Fail].err{res_ir.err};
                }
            }
            if (p.req.emit_asm) {
                val res_asm: err[outcome.Fail] = emit.emit_asm(p, st.asm_outputs[i], m.ir_module);
                if (sel res_asm.err) {
                    ret err[outcome.Fail].err{res_asm.err};
                }
            }
            i = i + 1;
        }
    }

    if (goal == request.GOAL_OBJECTS && flat) {
        ret err[outcome.Fail].err{outcome.user("a flat-image object format produces only executables; library and '--emit obj' outputs are unsupported")};
    }

    if (goal == request.GOAL_TESTS && plan.finished_modules(?p.target)) {
        ret err[outcome.Fail].err{outcome.user("a finished-module object format produces no executable; this target cannot build or run tests")};
    }

    if (plan.finished_modules(?p.target) && p.target_entry != nil
        && p.target_entry.mode == driver.MODE_LIBRARY) {
        ret err[outcome.Fail].err{outcome.user("a finished-module object format has no archive or shared-library form; each module is its own artifact")};
    }

    if (goal == request.GOAL_TESTS) {
        if (st.scope.sel_len == 0) {
            readout.phase_end(ev, readout.PH_EMIT, 0, "object", "objects");
            ret err[outcome.Fail].ok{};
        }
    }

    val objects: bool = (goal == request.GOAL_EXECUTE && !flat)
        || goal == request.GOAL_OBJECTS
        || goal == request.GOAL_TESTS;
    if (objects) {
        val borrowed: res[*of.ObjectImage, outcome.Fail] = current_image_headers(p);
        if (sel borrowed.err) { ret err[outcome.Fail].err{borrowed.err}; }
        val images: *of.ObjectImage = borrowed.ok;
        fin { A.deallocate[of.ObjectImage](p.alloc, images, p.module_len::usize); }
        val oc: err[outcome.Fail] = emit.write_objects(p, images, st.objects, ?st.obj_paths);
        if (sel oc.err) { ret oc; }
        st.obj_len = p.emit_len;
    }

    if (goal == request.GOAL_OBJECTS
        || (goal == request.GOAL_EXECUTE && plan.finished_modules(?p.target))) {
        st.out_path = unit.out_path::*u8;
    }

    if (objects) { readout.phase_end(ev, readout.PH_EMIT, st.obj_len, "object", "objects"); }
    or           { readout.phase_end(ev, readout.PH_EMIT, p.emit_len, "module", "modules"); }
    ret err[outcome.Fail].ok{};
}

fun artifact_digest(path: *u8, out: *u8) err[outcome.Fail] {
    val rr: err[outcome.Fail] = fingerprint.file_sha256(path::str, out);
    if (sel rr.err) {
        ret err[outcome.Fail].err{rr.err};
    }
    ret err[outcome.Fail].ok{};
}

fun artifact_reusable(s: *session.Session, artifact: *u8, revision: query.Revision) bool {
    val is_file_r: res[bool, io_error.Error] = fs.is_file(artifact::str);
    if (!(sel is_file_r.ok && is_file_r.ok)) { ret false; }
    var recorded: [32]u8;
    if (!session.lookup_link_publication(s, artifact::str, revision, ?recorded)) { ret false; }
    var cur: [32]u8;
    val d_r: err[outcome.Fail] = artifact_digest(artifact, ?cur[0]);
    if (sel d_r.err) { ret false; }
    ret memory.raw_equal((?cur[0])::ptr, (?recorded[0])::ptr, 32::usize);
}

fun record_artifact_publication(s: *session.Session, artifact: *u8, revision: query.Revision) err[outcome.Fail] {
    if (query.peek_revision(?s.queries, query.Q_LINK, 0) != revision) {
        ret err[outcome.Fail].err{outcome.internal("the link query's revision moved while the artifact was being written")};
    }
    var d: [32]u8;
    val d_r: err[outcome.Fail] = artifact_digest(artifact, ?d[0]);
    if (sel d_r.err) { ret d_r; }
    val rec_r: err[fail.Fail] = session.record_link_publication(s, artifact::str, revision, ?d);
    if (sel rec_r.err) { ret err[outcome.Fail].err{outcome.from_fail(rec_r.err)}; }
    ret err[outcome.Fail].ok{};
}

fun link_phase(p: *driver.Project, unit: *plan.BuildUnit, st: *UnitState,
               bo: *outcome.BuildOutcome, oa: *A.Allocator, ev: *readout.Progress) err[outcome.Fail] {
    val goal: request.BuildGoal = p.req.goal;

    readout.phase_begin(ev, readout.PH_LINK);
    val t_link: readout.Instant = readout.item_begin(ev);

    if (goal == request.GOAL_TESTS) {
        if (st.scope.sel_len == 0) {
            readout.phase_end(ev, readout.PH_LINK, 0, "binary", "binaries");
            ret err[outcome.Fail].ok{};
        }
        val dr: err[outcome.Fail] = link_dispatch_phase(p, unit, st, ev, t_link);
        if (sel dr.err) { ret dr; }
        val rr: err[outcome.Fail] = btest.record_tests(p, ?st.scope, unit.out_path::*u8, bo, oa);
        if (sel rr.err) { ret rr; }
        st.out_path = unit.out_path::*u8;
        readout.item(ev, readout.PH_LINK, unit.out_path, t_link);
        readout.phase_end(ev, readout.PH_LINK, 1, "binary", "binaries");
        ret err[outcome.Fail].ok{};
    }

    val te: *driver.TargetEntry = p.target_entry;
    if (te == nil) { ret err[outcome.Fail].err{outcome.internal("no target selected")}; }

    if (p.target.of != nil && p.target.of.produces_image) {
        if (te.mode == driver.MODE_LIBRARY) {
            ret err[outcome.Fail].err{outcome.user("a flat-image object format produces only executables; library and '--emit obj' outputs are unsupported")};
        }
        ret link_flat(p, unit, st, ev, t_link);
    }

    if (te.mode == driver.MODE_LIBRARY) {
        if (te.lib_kind == manifest.LIBKIND_STATIC) {
            val borrowed: res[*of.ObjectImage, outcome.Fail] = current_image_headers(p);
            if (sel borrowed.err) { ret err[outcome.Fail].err{borrowed.err}; }
            val images: *of.ObjectImage = borrowed.ok;
            fin { A.deallocate[of.ObjectImage](p.alloc, images, p.module_len::usize); }
            val arc_r: err[outcome.Fail] = emit.emit_static_archive(p, st.artifact, images, st.obj_paths, ?st.out_path);
            if (sel arc_r.err) { ret arc_r; }
            readout.phase_end(ev, readout.PH_LINK, 1, "archive", "archives");
            ret err[outcome.Fail].ok{};
        }
        if (te.lib_kind == manifest.LIBKIND_SHARED) {
            val ext_r: err[outcome.Fail] = emit.append_external_inputs(p, unit, ?st.obj_paths, ?st.obj_len, ?st.dynlibs, ?st.dynlib_len);
            if (sel ext_r.err) { ret ext_r; }
            val so_r: err[outcome.Fail] = emit.emit_shared_library(p, st.artifact, st.obj_paths, st.obj_len, st.dynlibs, st.dynlib_len, ?st.out_path);
            if (sel so_r.err) { ret so_r; }
            readout.phase_end(ev, readout.PH_LINK, 1, "library", "libraries");
            ret err[outcome.Fail].ok{};
        }
        st.out_path = unit.obj_dir::*u8;
        readout.phase_end(ev, readout.PH_LINK, st.obj_len, "object", "objects");
        ret err[outcome.Fail].ok{};
    }

    val ext_r: err[outcome.Fail] = emit.append_external_inputs(p, unit, ?st.obj_paths, ?st.obj_len, ?st.dynlibs, ?st.dynlib_len);
    if (sel ext_r.err) { ret ext_r; }

    val artifact: str = unit.out_path;

    val ext_from:  u32 = p.emit_len;
    val ext_count: u32 = st.obj_len - p.emit_len;
    val loaded_r: res[emit.LoadedImageOptions, outcome.Fail] = emit.load_image_options(p, linker.LINK_EXE, artifact::*u8);
    if (sel loaded_r.err) {
        ret err[outcome.Fail].err{loaded_r.err};
    }
    var loaded: emit.LoadedImageOptions = loaded_r.ok;

    val cfg_r: err[outcome.Fail] = set_link_config_input(p, artifact::*u8, emit.artifact_product_name(p), linker.LINK_EXE::u32,
                                                                    ?st.obj_paths[ext_from], ext_count, st.dynlibs, st.dynlib_len, ?loaded);
    if (sel cfg_r.err) { emit.dnit_image_options(p.alloc, ?loaded); ret cfg_r; }
    val relink_r: res[bool, outcome.Fail] = driver.run_link_pass(p);
    if (sel relink_r.err) { emit.dnit_image_options(p.alloc, ?loaded); ret err[outcome.Fail].err{relink_r.err}; }
    val link_rev: query.Revision = query.peek_revision(?p.s.queries, query.Q_LINK, 0);
    if (!relink_r.ok && artifact_reusable(p.s, artifact::*u8, link_rev)) {
        st.out_path = artifact::*u8;
        readout.item(ev, readout.PH_LINK, artifact, t_link);
        readout.phase_end(ev, readout.PH_LINK, 1, "binary", "binaries");
        emit.dnit_image_options(p.alloc, ?loaded);
        ret err[outcome.Fail].ok{};
    }

    val from_image: bool = p.target.of.links_from_image;
    var res_link: err[outcome.Fail] = err[outcome.Fail].ok{};
    if (from_image) {
        val borrowed: res[*of.ObjectImage, outcome.Fail] = current_image_headers(p);
        if (sel borrowed.err) { emit.dnit_image_options(p.alloc, ?loaded); ret err[outcome.Fail].err{borrowed.err}; }
        val images: *of.ObjectImage = borrowed.ok;
        fin { A.deallocate[of.ObjectImage](p.alloc, images, p.module_len::usize); }
        res_link = emit.link_mixed_images(p, images, ?st.obj_paths[ext_from], ext_count, st.dynlibs, st.dynlib_len, st.artifact, loaded.options);
    }
    if (!from_image) {
        res_link = emit.link_executable(p, st.obj_paths, st.obj_len, st.dynlibs, st.dynlib_len, st.artifact, loaded.options);
    }
    emit.dnit_image_options(p.alloc, ?loaded);
    if (sel res_link.err) { ret res_link; }

    val publish_r: err[outcome.Fail] = record_artifact_publication(p.s, artifact::*u8, link_rev);
    if (sel publish_r.err) { ret publish_r; }

    st.out_path = artifact::*u8;
    readout.item(ev, readout.PH_LINK, artifact, t_link);
    readout.phase_end(ev, readout.PH_LINK, 1, "binary", "binaries");
    ret err[outcome.Fail].ok{};
}

fun link_dispatch_phase(p: *driver.Project, unit: *plan.BuildUnit, st: *UnitState,
                        ev: *readout.Progress, t_link: readout.Instant) err[outcome.Fail] {
    val artifact: str = unit.out_path;

    val in_r: res[btest.DispatchInputs, outcome.Fail] = btest.collect_dispatch_inputs(p, unit, st.obj_paths);
    if (sel in_r.err) {
        ret err[outcome.Fail].err{in_r.err};
    }
    var di: btest.DispatchInputs = in_r.ok;

    val ext_from:  u32 = p.emit_len;
    val ext_count: u32 = di.shared_len - p.emit_len;
    var ext_paths: **u8 = nil;
    if (ext_count > 0) { ext_paths = ?di.shared[ext_from]; }

    val cfg_r: err[outcome.Fail] = set_dispatch_config_input(p, artifact::*u8,
        ext_paths, ext_count, di.dynlibs, di.dynlib_len, ?st.scope);
    if (sel cfg_r.err) { btest.free_dispatch_inputs(p, ?di); ret cfg_r; }

    val relink_r: res[bool, outcome.Fail] = driver.run_link_pass(p);
    if (sel relink_r.err) { btest.free_dispatch_inputs(p, ?di); ret err[outcome.Fail].err{relink_r.err}; }
    val link_rev: query.Revision = query.peek_revision(?p.s.queries, query.Q_LINK, 0);
    if (!relink_r.ok && artifact_reusable(p.s, artifact::*u8, link_rev)) {
        btest.free_dispatch_inputs(p, ?di);
        ret err[outcome.Fail].ok{};
    }

    val lr: err[outcome.Fail] = btest.link_dispatcher(p, unit, ?st.scope, ?di, st.dispatcher, st.artifact);
    btest.free_dispatch_inputs(p, ?di);
    if (sel lr.err) { ret lr; }

    ret record_artifact_publication(p.s, artifact::*u8, link_rev);
}

fun set_dispatch_config_input(p: *driver.Project, out_path: *u8,
                              ext_paths: **u8, ext_count: u32,
                              dynlibs: *of.DynLib, dynlib_count: u32,
                              sc: *btest.TestScope) err[outcome.Fail] {
    var fb: dq.FpBuf;
    fb.alloc = p.alloc;
    fb.buf   = nil;
    fb.len   = 0;
    fb.cap   = 0;

    var w: err[outcome.Fail] = write_link_config(?fb, p, out_path, emit.artifact_product_name(p),
        linker.LINK_EXE::u32, ext_paths, ext_count, dynlibs, dynlib_count, nil);
    val w_ok: bool = sel w.ok;
    if (w_ok) { w = btest.fingerprint_scope(?fb, p, sc); }
    if (sel w.err) {
        if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](p.alloc, fb.buf, fb.cap::usize); }
        ret err[outcome.Fail].err{w.err};
    }

    val fl: res[u32, fail.Fail] = dq.fp_input_len(?fb);
    if (sel fl.err) {
        dq.fp_free(?fb);
        ret err[outcome.Fail].err{outcome.from_fail(fl.err)};
    }
    val si: err[fail.Fail] = query.set_input_typed(?p.s.queries, query.Q_LINK_CONFIG, 0, fb.buf, fl.ok);
    if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](p.alloc, fb.buf, fb.cap::usize); }
    if (sel si.err) { ret err[outcome.Fail].err{outcome.from_fail(si.err)}; }
    ret err[outcome.Fail].ok{};
}

fun link_flat(p: *driver.Project, unit: *plan.BuildUnit, st: *UnitState, ev: *readout.Progress, t_link: readout.Instant) err[outcome.Fail] {
    val artifact: str = unit.out_path;

    val cfg_r: err[outcome.Fail] = set_link_config_input(p, artifact::*u8, emit.artifact_product_name(p), linker.LINK_EXE::u32, nil, 0, nil, 0, nil);
    if (sel cfg_r.err) { ret cfg_r; }
    val relink_r: res[bool, outcome.Fail] = driver.run_link_pass(p);
    if (sel relink_r.err) { ret err[outcome.Fail].err{relink_r.err}; }
    val link_rev: query.Revision = query.peek_revision(?p.s.queries, query.Q_LINK, 0);
    if (!relink_r.ok && artifact_reusable(p.s, artifact::*u8, link_rev)) {
        st.out_path = artifact::*u8;
        readout.item(ev, readout.PH_LINK, artifact, t_link);
        readout.phase_end(ev, readout.PH_LINK, 1, "binary", "binaries");
        ret err[outcome.Fail].ok{};
    }

    val borrowed: res[*of.ObjectImage, outcome.Fail] = current_image_headers(p);
    if (sel borrowed.err) { ret err[outcome.Fail].err{borrowed.err}; }
    val images: *of.ObjectImage = borrowed.ok;
    fin { A.deallocate[of.ObjectImage](p.alloc, images, p.module_len::usize); }
    val res_link: err[outcome.Fail] = emit.link_flat_images(p, images, st.artifact,
        of.image_options_default(p.req.subsystem));
    if (sel res_link.err) { ret res_link; }

    val publish_r: err[outcome.Fail] = record_artifact_publication(p.s, artifact::*u8, link_rev);
    if (sel publish_r.err) { ret publish_r; }

    st.out_path = artifact::*u8;
    readout.item(ev, readout.PH_LINK, artifact, t_link);
    readout.phase_end(ev, readout.PH_LINK, 1, "binary", "binaries");
    ret err[outcome.Fail].ok{};
}

fun list_tests(p: *driver.Project, st: *UnitState, bo: *outcome.BuildOutcome, oa: *A.Allocator) err[outcome.Fail] {
    ret btest.record_tests(p, ?st.scope, nil, bo, oa);
}

fun record_artifact(p: *driver.Project, unit: *plan.BuildUnit, st: *UnitState, bo: *outcome.BuildOutcome) err[outcome.Fail] {
    if (st.out_path == nil) { ret err[outcome.Fail].ok{}; }

    var kind: outcome.ArtifactKind = outcome.ART_BINARY;
    if (p.req.goal == request.GOAL_OBJECTS) { kind = outcome.ART_OBJECTS; }
    or (p.req.goal == request.GOAL_TESTS)   { kind = outcome.ART_TESTS; }
    or (plan.finished_modules(?p.target))     { kind = outcome.ART_OBJECTS; }
    or (p.target_entry != nil && p.target_entry.mode == driver.MODE_LIBRARY) {
        kind = outcome.ART_OBJECTS;
        if (p.target_entry.lib_kind == manifest.LIBKIND_STATIC) { kind = outcome.ART_ARCHIVE; }
        if (p.target_entry.lib_kind == manifest.LIBKIND_SHARED) { kind = outcome.ART_SHARED; }
    }

    val rec_r: err[A.Error] = outcome.record_artifact(bo, kind, st.out_path::str);
    if (sel rec_r.err) { ret err[outcome.Fail].err{outcome.refused(rec_r.err)}; }
    ret err[outcome.Fail].ok{};
}

fun emit_unit_summary(p: *driver.Project, st: *UnitState, ev: *readout.Progress) {
    var out_str: str = "<output>";
    if (st.out_path != nil) { out_str = st.out_path::str; }

    val te: *driver.TargetEntry = p.target_entry;
    val emit_obj: bool = p.req.goal == request.GOAL_OBJECTS;
    val is_lib: bool = emit_obj || plan.finished_modules(?p.target)
        || (te != nil && te.mode == driver.MODE_LIBRARY);

    if (!is_lib && st.out_path != nil) {
        val fi_r: res[fs.Metadata, io_error.Error] = fs.metadata(st.out_path::str);
        if (sel fi_r.ok) {
            val fi: fs.Metadata = fi_r.ok;
            var unit_s: str = "B";
            val mag: i64 = readout.size_split(fi.size, ?unit_s);
            readout.summary(ev, out_str, p.emit_len, mag, unit_s, true);
            ret;
        }
    }
    readout.summary(ev, out_str, p.emit_len, 0, "B", false);
}

fun pcg_enabled(p: *driver.Project) bool {
    ret p.req.jobs >= 1 && p.emit_len > 0;
}

pub fun set_link_config_input(p: *driver.Project, out_path: *u8, product: *u8, out_kind: u32,
                              ext_paths: **u8, ext_count: u32,
                              dynlibs: *of.DynLib, dynlib_count: u32,
                              image: *emit.LoadedImageOptions) err[outcome.Fail] {
    var fb: dq.FpBuf;
    fb.alloc = p.alloc;
    fb.buf   = nil;
    fb.len   = 0;
    fb.cap   = 0;

    val w: err[outcome.Fail] = write_link_config(?fb, p, out_path, product, out_kind, ext_paths, ext_count, dynlibs, dynlib_count, image);
    if (sel w.err) {
        if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](p.alloc, fb.buf, fb.cap::usize); }
        ret err[outcome.Fail].err{w.err};
    }

    val fl: res[u32, fail.Fail] = dq.fp_input_len(?fb);
    if (sel fl.err) {
        dq.fp_free(?fb);
        ret err[outcome.Fail].err{outcome.from_fail(fl.err)};
    }
    val si: err[fail.Fail] = query.set_input_typed(?p.s.queries, query.Q_LINK_CONFIG, 0, fb.buf, fl.ok);
    if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](p.alloc, fb.buf, fb.cap::usize); }
    if (sel si.err) { ret err[outcome.Fail].err{outcome.from_fail(si.err)}; }
    ret err[outcome.Fail].ok{};
}

fun write_link_config(fb: *dq.FpBuf, p: *driver.Project, out_path: *u8, product: *u8, out_kind: u32,
                      ext_paths: **u8, ext_count: u32,
                      dynlibs: *of.DynLib, dynlib_count: u32,
                      image: *emit.LoadedImageOptions) err[outcome.Fail] {
    val a0: err[fail.Fail] = dq.fp_u32(fb, out_kind);
    if (sel a0.err) { ret err[outcome.Fail].err{outcome.from_fail(a0.err)}; }
    var pie_axis: u32 = 0;
    if (p.req.pie) { pie_axis = 1; }
    val a1: err[fail.Fail] = dq.fp_u32(fb, pie_axis);
    if (sel a1.err) { ret err[outcome.Fail].err{outcome.from_fail(a1.err)}; }
    val a2: err[fail.Fail] = dq.fp_cstr(fb, out_path);
    if (sel a2.err) { ret err[outcome.Fail].err{outcome.from_fail(a2.err)}; }
    val a3: err[fail.Fail] = dq.fp_cstr(fb, product);
    if (sel a3.err) { ret err[outcome.Fail].err{outcome.from_fail(a3.err)}; }
    val a6: err[fail.Fail] = dq.fp_domain_u8(fb, fingerprint.DOMAIN_SUBSYSTEM,
        of.SUBSYSTEM_CATALOG_VERSION, of.subsystem_fingerprint_tag(p.req.subsystem));
    if (sel a6.err) { ret err[outcome.Fail].err{outcome.from_fail(a6.err)}; }

    var has_resources: u32 = 0;
    if (image != nil && image.resource != nil) { has_resources = 1; }
    val ar0: err[fail.Fail] = dq.fp_u32(fb, has_resources);
    if (sel ar0.err) { ret err[outcome.Fail].err{outcome.from_fail(ar0.err)}; }
    if (has_resources != 0) {
        val ar1: err[fail.Fail] = dq.fp_cstr(fb, image.icon_path::*u8);
        if (sel ar1.err) { ret err[outcome.Fail].err{outcome.from_fail(ar1.err)}; }
        val ar2: err[fail.Fail] = dq.fp_content(fb, image.icon_bytes.data, image.icon_bytes.len);
        if (sel ar2.err) { ret err[outcome.Fail].err{outcome.from_fail(ar2.err)}; }
        val ar3: err[fail.Fail] = dq.fp_cstr(fb, image.manifest_path::*u8);
        if (sel ar3.err) { ret err[outcome.Fail].err{outcome.from_fail(ar3.err)}; }
        val ar4: err[fail.Fail] = dq.fp_content(fb, image.manifest_bytes.data, image.manifest_bytes.len);
        if (sel ar4.err) { ret err[outcome.Fail].err{outcome.from_fail(ar4.err)}; }
        val ar5: err[fail.Fail] = dq.fp_cstr(fb, image.resource.version::*u8);
        if (sel ar5.err) { ret err[outcome.Fail].err{outcome.from_fail(ar5.err)}; }
        val ar6: err[fail.Fail] = dq.fp_cstr(fb, image.resource.internal_name::*u8);
        if (sel ar6.err) { ret err[outcome.Fail].err{outcome.from_fail(ar6.err)}; }
        val ar7: err[fail.Fail] = dq.fp_cstr(fb, image.resource.original_filename::*u8);
        if (sel ar7.err) { ret err[outcome.Fail].err{outcome.from_fail(ar7.err)}; }
        val ar8: err[fail.Fail] = dq.fp_cstr(fb, image.resource.product_name::*u8);
        if (sel ar8.err) { ret err[outcome.Fail].err{outcome.from_fail(ar8.err)}; }
    }

    val a4: err[fail.Fail] = dq.fp_u32(fb, ext_count);
    if (sel a4.err) { ret err[outcome.Fail].err{outcome.from_fail(a4.err)}; }
    var i: u32 = 0;
    for (i < ext_count) {
        val ap: err[fail.Fail] = dq.fp_cstr(fb, ext_paths[i]);
        if (sel ap.err) { ret err[outcome.Fail].err{outcome.from_fail(ap.err)}; }
        val ah: err[fail.Fail] = dq.fp_file_content(fb, ext_paths[i]);
        if (sel ah.err) { ret err[outcome.Fail].err{outcome.from_fail(ah.err)}; }
        i = i + 1;
    }
    val a5: err[fail.Fail] = dq.fp_u32(fb, dynlib_count);
    if (sel a5.err) { ret err[outcome.Fail].err{outcome.from_fail(a5.err)}; }
    var j: u32 = 0;
    for (j < dynlib_count) {
        val an: err[fail.Fail] = dq.fp_name(fb, ?p.s.interner, dynlibs[j].name);
        if (sel an.err) { ret err[outcome.Fail].err{outcome.from_fail(an.err)}; }
        val as: err[fail.Fail] = dq.fp_name(fb, ?p.s.interner, dynlibs[j].soname);
        if (sel as.err) { ret err[outcome.Fail].err{outcome.from_fail(as.err)}; }
        val ar: err[fail.Fail] = dq.fp_name(fb, ?p.s.interner, dynlibs[j].rpath);
        if (sel ar.err) { ret err[outcome.Fail].err{outcome.from_fail(ar.err)}; }
        var referenced: u8 = 0;
        if (dynlibs[j].include_referenced) { referenced = 1; }
        val ai: err[fail.Fail] = dq.fp_u8(fb, referenced);
        if (sel ai.err) { ret err[outcome.Fail].err{outcome.from_fail(ai.err)}; }
        j = j + 1;
    }
    ret err[outcome.Fail].ok{};
}

test "mach.lang.build.engine.link_config:provider_policy_invalidates_without_changing_names" {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = session.init_typed(?a);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    var p: driver.Project;
    project.init_project(?p, ?s);
    fin { driver.dnit_project(?p); }
    val name: res[intern.StrId, A.Error] = intern.intern_typed(?s.interner, "provider");
    if (sel name.err) { ret 3; }
    var lib: of.DynLib = of.DynLib{
        name: name.ok,
        soname: name.ok,
        rpath: intern.STR_NIL, include_referenced: false
    };
    val set_link_config_input_r: err[outcome.Fail] = set_link_config_input(?p, "app", "app", linker.LINK_EXE::u32,
        nil, 0, ?lib, 1, nil);
    if (sel set_link_config_input_r.err) { ret 4; }
    val baseline: query.Revision = query.peek_revision(?s.queries, query.Q_LINK_CONFIG, 0);
    if (baseline == 0) { ret 5; }
    val set_link_config_input_r2: err[outcome.Fail] = set_link_config_input(?p, "app", "app", linker.LINK_EXE::u32,
        nil, 0, ?lib, 1, nil);
    if (sel set_link_config_input_r2.err) { ret 6; }
    if (query.peek_revision(?s.queries, query.Q_LINK_CONFIG, 0) != baseline) { ret 7; }
    lib.include_referenced = true;
    val set_link_config_input_r3: err[outcome.Fail] = set_link_config_input(?p, "app", "app", linker.LINK_EXE::u32,
        nil, 0, ?lib, 1, nil);
    if (sel set_link_config_input_r3.err) { ret 8; }
    val changed: query.Revision = query.peek_revision(?s.queries, query.Q_LINK_CONFIG, 0);
    if (changed == baseline) { ret 9; }
    val set_link_config_input_r4: err[outcome.Fail] = set_link_config_input(?p, "app", "app", linker.LINK_EXE::u32,
        nil, 0, ?lib, 1, nil);
    if (sel set_link_config_input_r4.err) { ret 10; }
    if (query.peek_revision(?s.queries, query.Q_LINK_CONFIG, 0) != changed) { ret 11; }
    ret 0;
}

rec PcgWorker {
    backing: A.Allocator;
    ar:      arena.Arena;
    alloc:   A.Allocator;
    sess:    session.Session;
    active:  bool;
}

rec PcgSlot {
    image:  *of.ObjectImage;
    worker: u32;
    failed: bool;
    fail:   fail.Fail;
    d:      cdur.Duration;
}

rec ParallelCodegen {
    p:          *driver.Project;
    next:       i64;
    worker_seq: i64;
    stop:       i64;
    nworkers:   u32;
    workers:    *PcgWorker;
    slots:      *PcgSlot;
    stale:      *u32;
    stale_len:  u32;
    dbg:        codegen.DebugInfo;
}

fun pcg_worker_init(w: *PcgWorker, p: *driver.Project) err[outcome.Fail] {
    w.active = false;
    val make_r: err[A.Error] = page.make(?w.backing);
    if (sel make_r.err)          { ret err[outcome.Fail].err{outcome.internal("parallel codegen: worker backing alloc failed")}; }
    val init_r: err[A.Error] = arena.init(?w.ar, ?w.backing, 0);
    if (sel init_r.err) { ret err[outcome.Fail].err{outcome.internal("parallel codegen: worker arena init failed")}; }
    val make_r2: err[A.Error] = arena.make(?w.alloc, ?w.ar);
    if (sel make_r2.err)     { arena.dnit(?w.ar); ret err[outcome.Fail].err{outcome.internal("parallel codegen: worker arena bind failed")}; }

    w.sess          = @p.s;
    w.sess.alloc    = ?w.alloc;
    w.sess.interner = intern.make_child(?p.s.interner, ?w.alloc);
    w.active        = true;
    ret err[outcome.Fail].ok{};
}

fun pcg_worker_teardown(w: *PcgWorker) {
    if (!w.active) { ret; }
    arena.dnit(?w.ar);
    w.active = false;
}

fun pcg_stable_err(p: *driver.Project, msg: str) str {
    val ir: res[intern.StrId, A.Error] = intern.intern_typed(?p.s.interner, msg);
    if (sel ir.ok) {
        val nm: opt[str] = intern.lookup_typed(?p.s.interner, ir.ok);
        if (sel nm.some) { ret nm.some; }
    }
    ret "parallel codegen failed, and re-homing its diagnostic off the worker arena failed in turn (allocation failure)";
}

fun pcg_worker_main(arg: *u8) {
    val pc: *ParallelCodegen = arg::*ParallelCodegen;
    if (pc == nil) { ret; }
    val wid_raw: i64 = atomic.fetch_add(?pc.worker_seq, 1::i64);
    if (wid_raw < 0 || wid_raw >= pc.nworkers::i64) { ret; }
    val wid: u32 = wid_raw::u32;
    val w: *PcgWorker = ?pc.workers[wid::usize];

    for (true) {
        if (atomic.load(?pc.stop) != 0) { ret; }
        val idx_raw: i64 = atomic.fetch_add(?pc.next, 1::i64);
        if (idx_raw >= pc.stale_len::i64) { ret; }
        val idx: u32 = idx_raw::u32;

        val mid:  session.ModuleId = pc.p.topo[pc.stale[idx::usize]];
        val m:    *driver.ModuleEntry     = ?pc.p.modules[mid::u32];
        val slot: *PcgSlot         = ?pc.slots[idx::usize];
        slot.worker = wid;

        val t0: readout.Instant = readout.sample();

        val srcs_r: res[driver.CodeSources, fail.Fail] = driver.code_sources(pc.p, mid, ?w.alloc);
        if (sel srcs_r.err) {
            slot.fail   = srcs_r.err;
            slot.failed = true;
            slot.image = nil;
            atomic.store(?pc.stop, 1::i64);
            ret;
        }
        var srcs: driver.CodeSources = srcs_r.ok;

        val r: res[of.ObjectImage, fail.Fail] = codegen.codegen_unit(?w.sess, ?pc.p.target, m.ir_module, srcs.set, nil, pc.p.req.placement_policy, pc.dbg);
        driver.sources_dnit(?w.alloc, ?srcs);
        slot.d = readout.elapsed(t0);
        if (sel r.err) {
            slot.fail   = r.err;
            slot.failed = true;
            slot.image = nil;
            atomic.store(?pc.stop, 1::i64);
            ret;
        }
        var img: of.ObjectImage = r.ok;
        val br: res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](?w.alloc, 1::usize);
        if (sel br.err) {
            slot.fail   = fail.message("parallel codegen: worker image box allocation failed");
            slot.failed = true;
            slot.image = nil;
            atomic.store(?pc.stop, 1::i64);
            ret;
        }
        val box: *of.ObjectImage = br.ok;
        box[0]     = img;
        slot.image = box;
        slot.failed = false;
    }
}

fun run_codegen_parallel(p: *driver.Project) err[fail.Fail] {
    val emit_len: u32 = p.emit_len;
    if (emit_len == 0) { ret err[fail.Fail].ok{}; }

    val rstale: res[*u32, A.Error] = A.allocate[u32](p.alloc, emit_len::usize);
    if (sel rstale.err) { ret err[fail.Fail].err{fail.refused(rstale.err)}; }
    val stale: *u32 = rstale.ok;
    var stale_len: u32 = 0;
    var ti: u32 = 0;
    for (ti < emit_len) {
        val reusable: res[bool, fail.Fail] = passes.codegen_reusable(p, p.topo[ti]);
        if (sel reusable.err) {
            A.deallocate[u32](p.alloc, stale, emit_len::usize);
            ret err[fail.Fail].err{reusable.err};
        }
        if (!reusable.ok) {
            stale[stale_len] = ti;
            stale_len = stale_len + 1;
        }
        ti = ti + 1;
    }
    if (stale_len <= 1) {
        A.deallocate[u32](p.alloc, stale, emit_len::usize);
        ret err[fail.Fail].ok{};
    }

    var nworkers: u32 = p.req.jobs;
    if (nworkers == 0)         { nworkers = 1; }
    if (nworkers > stale_len)  { nworkers = stale_len; }

    if (nworkers <= 1) {
        A.deallocate[u32](p.alloc, stale, emit_len::usize);
        ret err[fail.Fail].ok{};
    }

    val rslots: res[*PcgSlot, A.Error] = A.allocate[PcgSlot](p.alloc, stale_len::usize);
    if (sel rslots.err) {
        A.deallocate[u32](p.alloc, stale, emit_len::usize);
        ret err[fail.Fail].err{fail.refused(rslots.err)};
    }
    val slots: *PcgSlot = rslots.ok;
    var si: u32 = 0;
    for (si < stale_len) { slots[si].image = nil; slots[si].worker = 0; slots[si].failed = false; slots[si].d = 0; si = si + 1; }

    val rdbg: res[codegen.DebugInfo, fail.Fail] = driver.debug_info_of(p);
    if (sel rdbg.err) {
        A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
        A.deallocate[u32](p.alloc, stale, emit_len::usize);
        ret err[fail.Fail].err{rdbg.err};
    }
    val dbg: codegen.DebugInfo = rdbg.ok;

    val rworkers: res[*PcgWorker, A.Error] = A.allocate[PcgWorker](p.alloc, nworkers::usize);
    if (sel rworkers.err) {
        A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
        A.deallocate[u32](p.alloc, stale, emit_len::usize);
        ret err[fail.Fail].err{fail.refused(rworkers.err)};
    }
    val workers: *PcgWorker = rworkers.ok;

    var wi: u32 = 0;
    for (wi < nworkers) {
        val io: err[outcome.Fail] = pcg_worker_init(?workers[wi], p);
        if (sel io.err) {
            var wj: u32 = 0;
            for (wj < wi) { pcg_worker_teardown(?workers[wj]); wj = wj + 1; }
            A.deallocate[PcgWorker](p.alloc, workers, nworkers::usize);
            A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
            A.deallocate[u32](p.alloc, stale, emit_len::usize);
            ret err[fail.Fail].err{fail.message(outcome.describe(io.err))};
        }
        wi = wi + 1;
    }

    var ctx: ParallelCodegen;
    ctx.p          = p;
    ctx.next       = 0;
    ctx.worker_seq = 0;
    ctx.stop       = 0;
    ctx.nworkers   = nworkers;
    ctx.workers    = workers;
    ctx.slots      = slots;
    ctx.stale      = stale;
    ctx.stale_len  = stale_len;
    ctx.dbg        = dbg;

    var threads: *thread.Thread = nil;
    val extra: u32 = nworkers - 1;
    if (extra > 0) {
        val rt: res[*thread.Thread, A.Error] = A.allocate[thread.Thread](p.alloc, extra::usize);
        if (sel rt.err) {
            var wk: u32 = 0;
            for (wk < nworkers) { pcg_worker_teardown(?workers[wk]); wk = wk + 1; }
            A.deallocate[PcgWorker](p.alloc, workers, nworkers::usize);
            A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
            A.deallocate[u32](p.alloc, stale, emit_len::usize);
            ret err[fail.Fail].err{fail.refused(rt.err)};
        }
        threads = rt.ok;
        var k: u32 = 0;
        for (k < extra) { thread.spawn_with(pcg_worker_main, (?ctx)::*u8, ?threads[k]); k = k + 1; }
    }

    pcg_worker_main((?ctx)::*u8);

    if (extra > 0) {
        var k: u32 = 0;
        for (k < extra) {
            if (threads[k].tid >= 0) { thread.join(?threads[k]); }
            k = k + 1;
        }
        A.deallocate[thread.Thread](p.alloc, threads, extra::usize);
    }

    readout.phase_workers(p.events, readout.PH_CODEGEN, nworkers);
    var ii: u32 = 0;
    for (ii < stale_len) {
        val im: *driver.ModuleEntry = ?p.modules[p.topo[stale[ii::usize]]::u32];
        readout.item_dur(p.events, readout.PH_CODEGEN, driver.fqn_name(p, im.fqn), slots[ii].d);
        ii = ii + 1;
    }

    var ei: u32 = 0;
    for (ei < stale_len) {
        if (slots[ei].failed) {
            val msg: str = pcg_stable_err(p, fail.describe(slots[ei].fail));
            var wk: u32 = 0;
            for (wk < nworkers) { pcg_worker_teardown(?workers[wk]); wk = wk + 1; }
            A.deallocate[PcgWorker](p.alloc, workers, nworkers::usize);
            A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
            A.deallocate[u32](p.alloc, stale, emit_len::usize);
            ret err[fail.Fail].err{fail.message(msg)};
        }
        ei = ei + 1;
    }

    val cr: err[outcome.Fail] = pcg_collect(p, ?ctx);

    var wk: u32 = 0;
    for (wk < nworkers) { pcg_worker_teardown(?workers[wk]); wk = wk + 1; }
    A.deallocate[PcgWorker](p.alloc, workers, nworkers::usize);
    A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
    A.deallocate[u32](p.alloc, stale, emit_len::usize);
    if (sel cr.err) { ret err[fail.Fail].err{fail.message(outcome.describe(cr.err))}; }
    ret err[fail.Fail].ok{};
}

fun pcg_collect(p: *driver.Project, ctx: *ParallelCodegen) err[outcome.Fail] {
    val nworkers: u32 = ctx.nworkers;

    val rmaps: res[*intern.ReinternMap, A.Error] = A.allocate[intern.ReinternMap](p.alloc, nworkers::usize);
    if (sel rmaps.err) {
        ret err[outcome.Fail].err{outcome.refused(rmaps.err)};
    }
    val remaps: *intern.ReinternMap = rmaps.ok;

    var wi: u32 = 0;
    for (wi < nworkers) {
        val rr: res[intern.ReinternMap, A.Error] = intern.reintern_child_typed(?workers_at(ctx, wi).sess.interner, p.alloc);
        if (sel rr.err) {
            pcg_free_remaps(p, remaps, wi);
            A.deallocate[intern.ReinternMap](p.alloc, remaps, nworkers::usize);
            ret err[outcome.Fail].err{outcome.refused(rr.err)};
        }
        remaps[wi] = rr.ok;
        wi = wi + 1;
    }

    var i: u32 = 0;
    for (i < ctx.stale_len) {
        val slot: *PcgSlot = ?ctx.slots[i::usize];
        val rehomed: res[of.ObjectImage, fail.Fail] = obj.rehome(p.s.alloc, ?p.s.interner, slot.image, remaps[slot.worker]);
        if (sel rehomed.err) {
            pcg_free_remaps(p, remaps, nworkers);
            A.deallocate[intern.ReinternMap](p.alloc, remaps, nworkers::usize);
            ret err[outcome.Fail].err{outcome.from_fail(rehomed.err)};
        }
        val rbox: res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](p.s.alloc, 1::usize);
        if (sel rbox.err) {
            var tmp: of.ObjectImage = rehomed.ok;
            obj.dnit(?tmp);
            pcg_free_remaps(p, remaps, nworkers);
            A.deallocate[intern.ReinternMap](p.alloc, remaps, nworkers::usize);
            ret err[outcome.Fail].err{outcome.refused(rbox.err)};
        }
        val box: *of.ObjectImage = rbox.ok;
        box[0] = rehomed.ok;

        val mid: session.ModuleId = p.topo[ctx.stale[i::usize]];
        p.modules[mid::u32].staged_image = box;
        i = i + 1;
    }

    pcg_free_remaps(p, remaps, nworkers);
    A.deallocate[intern.ReinternMap](p.alloc, remaps, nworkers::usize);
    ret err[outcome.Fail].ok{};
}

fun workers_at(ctx: *ParallelCodegen, wi: u32) *PcgWorker {
    ret ?ctx.workers[wi::usize];
}

fun pcg_free_remaps(p: *driver.Project, remaps: *intern.ReinternMap, n: u32) {
    var wi: u32 = 0;
    for (wi < n) {
        intern.reintern_map_dnit(p.alloc, ?remaps[wi]);
        wi = wi + 1;
    }
}
