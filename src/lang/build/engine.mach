rec UnitState {
    irs:          *ir.Module;
    ir_ready:     *bool;
    images:       *of.ObjectImage;
    image_ready:  *bool;

    obj_paths:    **u8;
    obj_len:      u32;
    dynlibs:      *of.DynLib;
    dynlib_len:   u32;

    out_path:     *u8;
    scope:        btest.TestScope;
    outputs:      publication.Plan;
    objects:      **publication.Destination;
    ir_outputs:   **publication.Destination;
    asm_outputs:  **publication.Destination;
    artifact:     *publication.Destination;
    dispatcher:   *publication.Destination;
}


fun blocking_requirement(failed: *Vector[str], u: *plan.BuildUnit) str {
    var i: usize = 0;
    for (i < u.requires.len) {
        var j: usize = 0;
        for (j < failed.len) {
            if (str_equals(failed.data[j], u.requires.data[i])) { ret u.requires.data[i]; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret nil;
}

fun record_blocked_unit(bo: *outcome.BuildOutcome, oa: *A.Allocator, failed: *Vector[str],
                        u: *plan.BuildUnit, blocked_by: str) R.Result[R.Void, str] {
    var f: outcome.Fail = outcome.user(plan.join_msg(oa,
        "artifact '", u.sel_artifact, "' was not built: it requires artifact '", blocked_by,
        "', which failed to build"));
    val fail_r: R.Result[R.Void, str] = outcome.record_fail(bo, ?f);
    if (R.is_err[R.Void, str](fail_r)) { ret fail_r; }
    outcome.fold_fail(bo, ?f);
    val pr: R.Result[usize, str] = vector.push[str](failed, u.sel_artifact);
    if (R.is_err[usize, str](pr)) { ret R.err[R.Void, str]("out of memory"); }
    ret R.ok_void[str]();
}

pub fun execute(bp: *plan.BuildPlan, backing: *A.Allocator, oa: *A.Allocator,
                ev: *readout.Progress) R.Result[outcome.BuildOutcome, outcome.Fail] {
    var bo: outcome.BuildOutcome = outcome.outcome_init(oa);
    var failed: Vector[str] = vector.init[str](oa);

    var i: usize = 0;
    for (i < bp.units.len) {
        val unit: *plan.BuildUnit = ?bp.units.data[i];
        val event_r: R.Result[R.Void, str] = outcome.record_unit(?bo, unit.sel_artifact, unit.sel_target, unit.has_artifact);
        if (R.is_err[R.Void, str](event_r)) {
            outcome.outcome_dnit(?bo);
            ret R.err[outcome.BuildOutcome, outcome.Fail](outcome.internal("failed to record build unit"));
        }

        val blocked_by: str = blocking_requirement(?failed, unit);
        if (blocked_by != nil) {
            val br: R.Result[R.Void, str] = record_blocked_unit(?bo, oa, ?failed, unit, blocked_by);
            if (R.is_err[R.Void, str](br)) {
                outcome.outcome_dnit(?bo);
                ret R.err[outcome.BuildOutcome, outcome.Fail](outcome.internal(R.unwrap_err[R.Void, str](br)));
            }
            i = i + 1;
            cnt;
        }
        readout.unit_begin(ev);

        val ur: R.Result[outcome.BuildOutcome, outcome.Fail] = execute_unit_cold(bp, i, backing, oa, ev);
        if (R.is_err[outcome.BuildOutcome, outcome.Fail](ur)) {
            var f: outcome.Fail = R.unwrap_err[outcome.BuildOutcome, outcome.Fail](ur);
            val fail_r: R.Result[R.Void, str] = outcome.record_fail(?bo, ?f);
            if (R.is_err[R.Void, str](fail_r)) {
                outcome.outcome_dnit(?bo);
                ret R.err[outcome.BuildOutcome, outcome.Fail](outcome.internal("failed to record build failure"));
            }
            outcome.fold_fail(?bo, ?f);
            val pr: R.Result[usize, str] = vector.push[str](?failed, unit.sel_artifact);
            if (R.is_err[usize, str](pr)) {
                outcome.outcome_dnit(?bo);
                ret R.err[outcome.BuildOutcome, outcome.Fail](outcome.internal("out of memory"));
            }
        }
        or {
            var ubo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](ur);
            if (ubo.severity != outcome.BUILD_OK) {
                val fr: R.Result[usize, str] = vector.push[str](?failed, unit.sel_artifact);
                if (R.is_err[usize, str](fr)) {
                    outcome.outcome_dnit(?ubo);
                    outcome.outcome_dnit(?bo);
                    ret R.err[outcome.BuildOutcome, outcome.Fail](outcome.internal("out of memory"));
                }
            }
            val mr: R.Result[R.Void, str] = outcome.merge(?bo, ?ubo);
            if (R.is_err[R.Void, str](mr)) {
                outcome.outcome_dnit(?ubo);
                outcome.outcome_dnit(?bo);
                ret R.err[outcome.BuildOutcome, outcome.Fail](outcome.internal("failed to merge build outcome"));
            }
        }
        i = i + 1;
    }
    ret R.ok[outcome.BuildOutcome, outcome.Fail](bo);
}

fun execute_unit_cold(bp: *plan.BuildPlan, unit_index: usize, backing: *A.Allocator,
                      oa: *A.Allocator, ev: *readout.Progress)
                      R.Result[outcome.BuildOutcome, outcome.Fail] {
    var u_ar: arena.Arena;
    if (O.is_some[str](arena.init(?u_ar, backing, 0))) {
        ret cold_fail(oa, outcome.internal("failed to initialise allocator"));
    }
    var u_alloc: A.Allocator;
    if (O.is_some[str](arena.make(?u_alloc, ?u_ar))) {
        arena.dnit(?u_ar);
        ret cold_fail(oa, outcome.internal("failed to initialise allocator"));
    }

    var r: R.Result[outcome.BuildOutcome, outcome.Fail];
    val res_session: R.Result[session.Session, str] = session.init(?u_alloc);
    if (R.is_err[session.Session, str](res_session)) {
        val f: outcome.Fail = outcome.internal(plan.join_msg(?u_alloc, "failed to initialise compiler session: ", R.unwrap_err[session.Session, str](res_session)));
        r = cold_fail(oa, f);
    }
    or {
        var s: session.Session = R.unwrap_ok[session.Session, str](res_session);
        r = execute_warm(bp, unit_index, ?s, oa, ev);
        session.dnit(?s);
    }

    arena.dnit(?u_ar);
    ret r;
}

fun cold_fail(oa: *A.Allocator, f: outcome.Fail) R.Result[outcome.BuildOutcome, outcome.Fail] {
    var bo: outcome.BuildOutcome = outcome.outcome_init(oa);
    ret warm_fail(?bo, f);
}

rec PoisonState {
    real:    A.Allocator;
    fail_at: usize;
    calls:   usize;
}

fun poison_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val st: *PoisonState = ctx::*PoisonState;
    st.calls = st.calls + 1;
    if (st.fail_at != 0 && st.calls == st.fail_at) { ret O.none[ptr](); }
    ret st.real.fn_allocate(st.real.ctx, size, align);
}

fun poison_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    val st: *PoisonState = ctx::*PoisonState;
    ret st.real.fn_reallocate(st.real.ctx, p, old_size, new_size, align);
}

fun poison_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    if (p != nil && size > 0) {
        var i: usize = 0;
        for (i < size) { (p::*u8)[i] = 0xAA::u8; i = i + 1; }
    }
    ret 0;
}

test "mach.lang.build.engine.execute_unit_cold:session_init_failure_message_survives_arena_teardown" {
    var real: A.Allocator;
    if (O.is_some[str](page.make(?real))) { ret 1; }
    var st: PoisonState;
    st.real    = real;
    st.fail_at = 1;
    st.calls   = 0;
    var backing: A.Allocator;
    backing.ctx           = (?st)::ptr;
    backing.fn_allocate   = poison_allocate;
    backing.fn_reallocate = poison_reallocate;
    backing.fn_deallocate = poison_deallocate;

    var oa: A.Allocator;
    if (O.is_some[str](page.make(?oa))) { ret 2; }

    var bp: plan.BuildPlan;
    val r: R.Result[outcome.BuildOutcome, outcome.Fail] = execute_unit_cold(?bp, 0::usize, ?backing, ?oa, nil);
    if (R.is_err[outcome.BuildOutcome, outcome.Fail](r)) { ret 3; }

    var bo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](r);
    var bad: i32 = 0;
    if (bo.severity != outcome.BUILD_INTERNAL || bo.events.len != 1) { bad = 1; }
    or (bo.events.data[0].kind != outcome.BUILD_EVENT_FAIL)          { bad = 1; }
    or (bo.events.data[0].data.fail.message == nil)                  { bad = 1; }
    or ((bo.events.data[0].data.fail.message::*u8)[0] == 0xAA::u8)   { bad = 1; }
    or (!str_contains(bo.events.data[0].data.fail.message, "failed to initialise compiler session")) { bad = 1; }
    outcome.outcome_dnit(?bo);
    ret bad;
}

pub fun execute_warm(bp: *plan.BuildPlan, unit_index: usize, s: *session.Session, oa: *A.Allocator,
                     ev: *readout.Progress) R.Result[outcome.BuildOutcome, outcome.Fail] {
    if (unit_index >= bp.units.len) {
        ret R.err[outcome.BuildOutcome, outcome.Fail](outcome.internal("build unit index out of range"));
    }
    val planned: *plan.BuildUnit = ?bp.units.data[unit_index];

    var bo: outcome.BuildOutcome = outcome.outcome_init(oa);

    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(s.alloc);

    var call_backing: A.Allocator;
    if (O.is_some[str](page.make(?call_backing))) {
        ret warm_fail(?bo, outcome.internal("failed to initialise allocator"));
    }
    var call_ar: arena.Arena;
    if (O.is_some[str](arena.init(?call_ar, ?call_backing, 0))) {
        ret warm_fail(?bo, outcome.internal("failed to initialise allocator"));
    }
    var call_alloc: A.Allocator;
    if (O.is_some[str](arena.make(?call_alloc, ?call_ar))) {
        arena.dnit(?call_ar);
        ret warm_fail(?bo, outcome.internal("failed to initialise allocator"));
    }

    val prior_build: *A.Allocator = s.build_alloc;
    s.build_alloc = ?call_alloc;
    fin {
        s.build_alloc = prior_build;
        arena.dnit(?call_ar);
    }

    val res_register: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](res_register)) {
        val r: R.Result[outcome.BuildOutcome, outcome.Fail] = warm_fail(?bo, outcome.internal(R.unwrap_err[R.Void, str](res_register)));
        ret r;
    }

    val res_manifest: R.Result[manifest.Manifest, str] = driver.load_manifest(s, bp.request.project_root);
    if (R.is_err[manifest.Manifest, str](res_manifest)) {
        val r: R.Result[outcome.BuildOutcome, outcome.Fail] = warm_fail(?bo, outcome.user(R.unwrap_err[manifest.Manifest, str](res_manifest)));
        ret r;
    }
    var m: manifest.Manifest = R.unwrap_ok[manifest.Manifest, str](res_manifest);

    var req: request.BuildRequest =
        request.for_cell(?bp.request, planned.sel_target, planned.sel_artifact, planned.want_lib,
                         planned.subsystem, planned.goal);

    val replan_r: R.Result[plan.BuildUnit, outcome.Fail] =
        plan.replan_unit(?call_alloc, ?s.interner, ?s.registry, ?m, ?req, planned);
    if (R.is_err[plan.BuildUnit, outcome.Fail](replan_r)) {
        val r: R.Result[outcome.BuildOutcome, outcome.Fail] = warm_fail(?bo, R.unwrap_err[plan.BuildUnit, outcome.Fail](replan_r));
        ret r;
    }
    var cell: plan.BuildUnit = R.unwrap_ok[plan.BuildUnit, outcome.Fail](replan_r);
    val unit: *plan.BuildUnit = ?cell;

    val begin_r: R.Result[driver.Project, outcome.Fail] = driver.begin_build(s, ?m, ?req, ev);
    if (R.is_err[driver.Project, outcome.Fail](begin_r)) {
        val r: R.Result[outcome.BuildOutcome, outcome.Fail] = warm_fail(?bo, R.unwrap_err[driver.Project, outcome.Fail](begin_r));
        ret r;
    }
    var p: driver.Project = R.unwrap_ok[driver.Project, outcome.Fail](begin_r);

    var st: UnitState;
    st.irs          = nil;
    st.ir_ready     = nil;
    st.images       = nil;
    st.image_ready  = nil;
    st.obj_paths    = nil;
    st.obj_len      = 0;
    st.dynlibs      = nil;
    st.dynlib_len   = 0;
    st.out_path     = nil;
    st.scope.have    = false;
    st.scope.sel     = nil;
    st.scope.sel_len = 0;
    st.scope.skipped = 0;

    var result: R.Result[R.Void, outcome.Fail] = R.ok_void[outcome.Fail]();
    var pi: usize = 0;
    for (pi < unit.phases.len) {
        result = run_phase(unit.phases.data[pi], ?p, unit, ?st, ?bo, oa, ev);
        if (R.is_err[R.Void, outcome.Fail](result)) { brk; }
        pi = pi + 1;
    }

    if (R.is_ok[R.Void, outcome.Fail](result) && req.goal == request.GOAL_TEST_LIST) {
        result = list_tests(?p, ?st, ?bo, oa);
    }

    if (R.is_ok[R.Void, outcome.Fail](result)) {
        result = record_artifact(?p, unit, ?st, ?bo);
    }

    if (st.out_path != nil) { st.out_path = unit.out_path::*u8; }
    val released: O.Option[txn.Error] = release_outputs(?p, ?st);
    var event_error: str = nil;
    if (R.is_err[R.Void, outcome.Fail](result)) {
        var f: outcome.Fail = R.unwrap_err[R.Void, outcome.Fail](result);
        val fail_r: R.Result[R.Void, str] = outcome.record_fail(?bo, ?f);
        if (R.is_err[R.Void, str](fail_r)) { event_error = "failed to record build failure"; }
    }
    if (O.is_some[txn.Error](released)) {
        val error: txn.Error = O.unwrap[txn.Error](released);
        val detail: str = plan.join_msg(p.alloc, "publication cleanup: ", txn.error_message(error));
        var cleanup: outcome.Fail = outcome.environment(detail);
        if (error.kind == txn.INVALID) { cleanup = outcome.internal(detail); }
        val recorded: R.Result[R.Void, str] = outcome.record_fail(?bo, ?cleanup);
        if (R.is_err[R.Void, str](recorded)) { event_error = "failed to record publication cleanup failure"; }
        outcome.fold_fail(?bo, ?cleanup);
        if (R.is_ok[R.Void, outcome.Fail](result)) { result = R.err[R.Void, outcome.Fail](cleanup); }
    }
    if (R.is_ok[R.Void, outcome.Fail](result) && ev != nil) {
        emit_unit_summary(?p, ?st, ev);
    }

    if (event_error == nil) {
        val diags_r: R.Result[R.Void, str] = outcome.record_diagnostics(?bo, ?s.sources, ?s.diags);
        if (R.is_err[R.Void, str](diags_r)) { event_error = "failed to snapshot build diagnostics"; }
    }
    btest.free_scope(?p, ?st.scope);
    pcg_sweep_staged(?p);
    driver.lower_sweep_staged(?p);
    driver.dnit_project(?p);

    if (event_error != nil) {
        outcome.outcome_dnit(?bo);
        ret R.err[outcome.BuildOutcome, outcome.Fail](outcome.internal(event_error));
    }

    if (R.is_err[R.Void, outcome.Fail](result)) {
        var f: outcome.Fail = R.unwrap_err[R.Void, outcome.Fail](result);
        outcome.fold_fail(?bo, ?f);
    }
    ret R.ok[outcome.BuildOutcome, outcome.Fail](bo);
}

pub fun execute_warm_all(bp: *plan.BuildPlan, s: *session.Session, oa: *A.Allocator,
                         ev: *readout.Progress) R.Result[outcome.BuildOutcome, outcome.Fail] {
    var bo: outcome.BuildOutcome = outcome.outcome_init(oa);
    var failed: Vector[str] = vector.init[str](oa);

    var i: usize = 0;
    for (i < bp.units.len) {
        val unit: *plan.BuildUnit = ?bp.units.data[i];
        val event_r: R.Result[R.Void, str] = outcome.record_unit(?bo, unit.sel_artifact, unit.sel_target, unit.has_artifact);
        if (R.is_err[R.Void, str](event_r)) {
            outcome.outcome_dnit(?bo);
            ret R.err[outcome.BuildOutcome, outcome.Fail](outcome.internal("failed to record build unit"));
        }

        val blocked_by: str = blocking_requirement(?failed, unit);
        if (blocked_by != nil) {
            val br: R.Result[R.Void, str] = record_blocked_unit(?bo, oa, ?failed, unit, blocked_by);
            if (R.is_err[R.Void, str](br)) {
                outcome.outcome_dnit(?bo);
                ret R.err[outcome.BuildOutcome, outcome.Fail](outcome.internal(R.unwrap_err[R.Void, str](br)));
            }
            i = i + 1;
            cnt;
        }
        readout.unit_begin(ev);

        val ur: R.Result[outcome.BuildOutcome, outcome.Fail] = execute_warm(bp, i, s, oa, ev);
        if (R.is_err[outcome.BuildOutcome, outcome.Fail](ur)) {
            var f: outcome.Fail = R.unwrap_err[outcome.BuildOutcome, outcome.Fail](ur);
            val fail_r: R.Result[R.Void, str] = outcome.record_fail(?bo, ?f);
            if (R.is_err[R.Void, str](fail_r)) {
                outcome.outcome_dnit(?bo);
                ret R.err[outcome.BuildOutcome, outcome.Fail](outcome.internal("failed to record build failure"));
            }
            outcome.fold_fail(?bo, ?f);
            val pr: R.Result[usize, str] = vector.push[str](?failed, unit.sel_artifact);
            if (R.is_err[usize, str](pr)) {
                outcome.outcome_dnit(?bo);
                ret R.err[outcome.BuildOutcome, outcome.Fail](outcome.internal("out of memory"));
            }
        }
        or {
            var ubo: outcome.BuildOutcome = R.unwrap_ok[outcome.BuildOutcome, outcome.Fail](ur);
            if (ubo.severity != outcome.BUILD_OK) {
                val fr: R.Result[usize, str] = vector.push[str](?failed, unit.sel_artifact);
                if (R.is_err[usize, str](fr)) {
                    outcome.outcome_dnit(?ubo);
                    outcome.outcome_dnit(?bo);
                    ret R.err[outcome.BuildOutcome, outcome.Fail](outcome.internal("out of memory"));
                }
            }
            val mr: R.Result[R.Void, str] = outcome.merge(?bo, ?ubo);
            if (R.is_err[R.Void, str](mr)) {
                outcome.outcome_dnit(?ubo);
                outcome.outcome_dnit(?bo);
                ret R.err[outcome.BuildOutcome, outcome.Fail](outcome.internal("failed to merge build outcome"));
            }
        }
        i = i + 1;
    }
    ret R.ok[outcome.BuildOutcome, outcome.Fail](bo);
}

fun pcg_sweep_staged(p: *driver.Project) {
    var i: u32 = 0;
    for (i < p.module_len) {
        val m: *driver.ModuleEntry = ?p.modules[i];
        if (m.staged_image != nil) {
            obj.dnit(m.staged_image);
            A.deallocate[of.ObjectImage](p.s.alloc, m.staged_image, 1::usize);
            m.staged_image = nil;
        }
        i = i + 1;
    }
}

fun warm_fail(bo: *outcome.BuildOutcome, f: outcome.Fail) R.Result[outcome.BuildOutcome, outcome.Fail] {
    var fv: outcome.Fail = f;
    val fail_r: R.Result[R.Void, str] = outcome.record_fail(bo, ?fv);
    if (R.is_err[R.Void, str](fail_r)) {
        outcome.outcome_dnit(bo);
        ret R.err[outcome.BuildOutcome, outcome.Fail](outcome.internal("failed to record build failure"));
    }
    outcome.fold_fail(bo, ?fv);
    ret R.ok[outcome.BuildOutcome, outcome.Fail](@bo);
}

fun plan_module_outputs(p: *driver.Project, outputs: *publication.Plan, base: str, suffix: str)
                        R.Result[**publication.Destination, outcome.Fail] {
    if (p.emit_len == 0) { ret R.ok[**publication.Destination, outcome.Fail](nil); }
    val allocated: R.Result[**publication.Destination, str] = A.allocate[*publication.Destination](p.alloc, p.emit_len::usize);
    if (R.is_err[**publication.Destination, str](allocated)) {
        ret R.err[**publication.Destination, outcome.Fail](outcome.internal(R.unwrap_err[**publication.Destination, str](allocated)));
    }
    val destinations: **publication.Destination = R.unwrap_ok[**publication.Destination, str](allocated);
    var complete: bool = false;
    fin { if (!complete) { A.deallocate[*publication.Destination](p.alloc, destinations, p.emit_len::usize); } }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *driver.ModuleEntry = ?p.modules[p.topo[i]::u32];
        val fqn: O.Option[str] = intern.lookup(?p.s.interner, m.fqn);
        if (O.is_none[str](fqn)) {
            ret R.err[**publication.Destination, outcome.Fail](outcome.internal("module FQN not interned"));
        }
        val name_r: R.Result[str, str] = emit.mirror_fqn(p.alloc, base, O.unwrap[str](fqn), suffix);
        if (R.is_err[str, str](name_r)) {
            ret R.err[**publication.Destination, outcome.Fail](outcome.internal(R.unwrap_err[str, str](name_r)));
        }
        val name: str = R.unwrap_ok[str, str](name_r);
        val reserved: R.Result[*publication.Destination, str] = publication.plan_add(outputs, name, true);
        str_free(p.alloc, name);
        if (R.is_err[*publication.Destination, str](reserved)) {
            ret R.err[**publication.Destination, outcome.Fail](outcome.environment(R.unwrap_err[*publication.Destination, str](reserved)));
        }
        destinations[i] = R.unwrap_ok[*publication.Destination, str](reserved);
        i = i + 1;
    }
    complete = true;
    ret R.ok[**publication.Destination, outcome.Fail](destinations);
}

fun plan_outputs(p: *driver.Project, unit: *plan.BuildUnit, st: *UnitState) R.Result[R.Void, outcome.Fail] {
    val initialized: O.Option[txn.Error] = publication.plan_init(?st.outputs, p.alloc);
    if (O.is_some[txn.Error](initialized)) {
        ret R.err[R.Void, outcome.Fail](outcome.internal(txn.error_message(O.unwrap[txn.Error](initialized))));
    }
    val goal: request.BuildGoal = p.req.goal;
    val flat: bool = p.target.of != nil && p.target.of.produces_image;
    val objects: bool = (goal == request.GOAL_EXECUTE && !flat)
        || goal == request.GOAL_OBJECTS || goal == request.GOAL_TESTS;
    if (objects) {
        val planned: R.Result[**publication.Destination, outcome.Fail] = plan_module_outputs(p, ?st.outputs, unit.obj_dir, p.target.of.object_ext);
        if (R.is_err[**publication.Destination, outcome.Fail](planned)) { ret R.void_of[**publication.Destination, outcome.Fail](planned); }
        st.objects = R.unwrap_ok[**publication.Destination, outcome.Fail](planned);
    }
    if (p.req.emit_ir) {
        val planned: R.Result[**publication.Destination, outcome.Fail] = plan_module_outputs(p, ?st.outputs, unit.ir_dir, "ir");
        if (R.is_err[**publication.Destination, outcome.Fail](planned)) { ret R.void_of[**publication.Destination, outcome.Fail](planned); }
        st.ir_outputs = R.unwrap_ok[**publication.Destination, outcome.Fail](planned);
    }
    if (p.req.emit_asm) {
        val planned: R.Result[**publication.Destination, outcome.Fail] = plan_module_outputs(p, ?st.outputs, unit.asm_dir, "s");
        if (R.is_err[**publication.Destination, outcome.Fail](planned)) { ret R.void_of[**publication.Destination, outcome.Fail](planned); }
        st.asm_outputs = R.unwrap_ok[**publication.Destination, outcome.Fail](planned);
    }
    if ((goal == request.GOAL_EXECUTE && !plan.finished_modules(?p.target)) || goal == request.GOAL_TESTS) {
        val planned: R.Result[*publication.Destination, str] = publication.plan_add(?st.outputs, unit.out_path, true);
        if (R.is_err[*publication.Destination, str](planned)) {
            ret R.err[R.Void, outcome.Fail](outcome.environment(R.unwrap_err[*publication.Destination, str](planned)));
        }
        st.artifact = R.unwrap_ok[*publication.Destination, str](planned);
    }
    if (goal == request.GOAL_TESTS) {
        val name_r: R.Result[str, str] = path.join(p.alloc, unit.obj_dir, "__mach_test_dispatch.o");
        if (R.is_err[str, str](name_r)) { ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[str, str](name_r))); }
        val name: str = R.unwrap_ok[str, str](name_r);
        val planned: R.Result[*publication.Destination, str] = publication.plan_add(?st.outputs, name, true);
        str_free(p.alloc, name);
        if (R.is_err[*publication.Destination, str](planned)) {
            ret R.err[R.Void, outcome.Fail](outcome.environment(R.unwrap_err[*publication.Destination, str](planned)));
        }
        st.dispatcher = R.unwrap_ok[*publication.Destination, str](planned);
    }
    val sealed: O.Option[txn.Error] = publication.plan_seal(?st.outputs);
    if (O.is_some[txn.Error](sealed)) {
        ret R.err[R.Void, outcome.Fail](outcome.environment(txn.error_message(O.unwrap[txn.Error](sealed))));
    }
    ret R.ok_void[outcome.Fail]();
}

fun release_outputs(p: *driver.Project, st: *UnitState) O.Option[txn.Error] {
    if (st.objects != nil) { A.deallocate[*publication.Destination](p.alloc, st.objects, p.emit_len::usize); st.objects = nil; }
    if (st.ir_outputs != nil) { A.deallocate[*publication.Destination](p.alloc, st.ir_outputs, p.emit_len::usize); st.ir_outputs = nil; }
    if (st.asm_outputs != nil) { A.deallocate[*publication.Destination](p.alloc, st.asm_outputs, p.emit_len::usize); st.asm_outputs = nil; }
    ret publication.plan_dnit(?st.outputs);
}

fun run_phase(ph: plan.PhaseKind, p: *driver.Project, unit: *plan.BuildUnit, st: *UnitState,
              bo: *outcome.BuildOutcome, oa: *A.Allocator,
              ev: *readout.Progress) R.Result[R.Void, outcome.Fail] {
    var result: R.Result[R.Void, outcome.Fail] = R.err[R.Void, outcome.Fail](outcome.internal("unknown build phase"));
    if (ph == plan.PH_STEPS)     { result = driver.run_steps_phase(p); }
    if (ph == plan.PH_DEP_STEPS) { result = driver.run_dep_steps_phase(p); }
    if (ph == plan.PH_LOAD)      { result = load_phase(p); }
    if (ph == plan.PH_SEMA)      { result = sema_phase(p, st); }
    if (ph == plan.PH_LOWER)     { result = lower_phase(p, st, bo, ev); }
    if (ph == plan.PH_CODEGEN) {
        result = plan_outputs(p, unit, st);
        if (R.is_ok[R.Void, outcome.Fail](result)) { result = codegen_phase(p, st, ev); }
    }
    if (ph == plan.PH_EMIT)      { result = emit_phase(p, unit, st, bo, ev); }
    if (ph == plan.PH_LINK)      { result = link_phase(p, unit, st, bo, oa, ev); }

    if (R.is_err[R.Void, outcome.Fail](result)) { ret result; }
    if (ph == plan.PH_LOAD || ph == plan.PH_SEMA) {
        val status: fail.PhaseStatus = driver.frontend_status(p);
        if (status.kind != fail.ACCEPTED) { ret R.err[R.Void, outcome.Fail](outcome.from_fail(fail.phase_failure(status))); }
    }
    ret result;
}

fun load_phase(p: *driver.Project) R.Result[R.Void, outcome.Fail] {
    val lr: R.Result[R.Void, outcome.Fail] = driver.run_load_phase(p);
    if (R.is_err[R.Void, outcome.Fail](lr)) { ret lr; }
    if (p.module_len == 0) {
        ret R.err[R.Void, outcome.Fail](outcome.user("project graph is empty; the entrypoint loaded no modules"));
    }
    ret R.ok_void[outcome.Fail]();
}

fun ensure_views(p: *driver.Project, st: *UnitState) R.Result[R.Void, outcome.Fail] {
    if (st.irs != nil) { ret R.ok_void[outcome.Fail](); }
    val n: usize = p.module_len::usize;

    val res_irs: R.Result[*ir.Module, str] = A.allocate[ir.Module](p.alloc, n);
    if (R.is_err[*ir.Module, str](res_irs)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    st.irs = R.unwrap_ok[*ir.Module, str](res_irs);

    val res_ir_ready: R.Result[*bool, str] = A.allocate[bool](p.alloc, n);
    if (R.is_err[*bool, str](res_ir_ready)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    st.ir_ready = R.unwrap_ok[*bool, str](res_ir_ready);

    val res_images: R.Result[*of.ObjectImage, str] = A.allocate[of.ObjectImage](p.alloc, n);
    if (R.is_err[*of.ObjectImage, str](res_images)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    st.images = R.unwrap_ok[*of.ObjectImage, str](res_images);

    val res_image_ready: R.Result[*bool, str] = A.allocate[bool](p.alloc, n);
    if (R.is_err[*bool, str](res_image_ready)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    st.image_ready = R.unwrap_ok[*bool, str](res_image_ready);

    var i: u32 = 0;
    for (i < p.module_len) {
        st.ir_ready[i]    = false;
        st.image_ready[i] = false;
        st.irs[i].function_len = 0;
        i = i + 1;
    }
    ret R.ok_void[outcome.Fail]();
}

fun sema_phase(p: *driver.Project, st: *UnitState) R.Result[R.Void, outcome.Fail] {
    val vr: R.Result[R.Void, outcome.Fail] = ensure_views(p, st);
    if (R.is_err[R.Void, outcome.Fail](vr)) { ret vr; }

    ret driver.run_sema_pass(p);
}

fun lower_phase(p: *driver.Project, st: *UnitState, bo: *outcome.BuildOutcome, ev: *readout.Progress) R.Result[R.Void, outcome.Fail] {
    readout.phase_begin(ev, readout.PH_LOWER);
    readout.phase_begin(ev, readout.PH_OPTIMIZE);
    readout.phase_carved(ev, readout.PH_OPTIMIZE);

    val res_lower: R.Result[R.Void, outcome.Fail] = driver.run_lower_pass(p);
    if (R.is_err[R.Void, outcome.Fail](res_lower)) { ret res_lower; }

    var total: u32 = 0;
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId    = p.topo[i];
        val m:   *driver.ModuleEntry = ?p.modules[mid::u32];
        total = total + m.ir_module.vector_ops_scalarized;
        i = i + 1;
    }
    if (total > 0) {
        val note_r: R.Result[R.Void, str] = outcome.record_note(bo, total);
        if (R.is_err[R.Void, str](note_r)) {
            ret R.err[R.Void, outcome.Fail](outcome.internal("failed to record scalarization note"));
        }
    }

    i = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId    = p.topo[i];
        val m:   *driver.ModuleEntry = ?p.modules[mid::u32];
        val irm: *ir.Module          = m.ir_module;
        st.irs[mid::u32]      = @irm;
        st.ir_ready[mid::u32] = true;
        i = i + 1;
    }

    readout.phase_end(ev, readout.PH_LOWER, p.emit_len, "module", "modules");
    readout.phase_end(ev, readout.PH_OPTIMIZE, p.emit_len, "module", "modules");
    ret R.ok_void[outcome.Fail]();
}

fun codegen_phase(p: *driver.Project, st: *UnitState, ev: *readout.Progress) R.Result[R.Void, outcome.Fail] {
    readout.phase_begin(ev, readout.PH_CODEGEN);

    if (pcg_enabled(p)) {
        val rp: R.Result[R.Void, fail.Fail] = run_codegen_parallel(p);
        if (R.is_err[R.Void, fail.Fail](rp)) {
            ret R.err[R.Void, outcome.Fail](outcome.from_fail(R.unwrap_err[R.Void, fail.Fail](rp)));
        }
    }

    val res_codegen: R.Result[R.Void, outcome.Fail] = driver.run_codegen_pass(p);
    if (R.is_err[R.Void, outcome.Fail](res_codegen)) { ret res_codegen; }

    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId    = p.topo[i];
        val m:   *driver.ModuleEntry = ?p.modules[mid::u32];
        val img: *of.ObjectImage     = m.object_image;
        st.images[mid::u32]      = @img;
        st.image_ready[mid::u32] = true;
        i = i + 1;
    }

    readout.phase_end(ev, readout.PH_CODEGEN, p.emit_len, "module", "modules");
    ret R.ok_void[outcome.Fail]();
}

fun emit_phase(p: *driver.Project, unit: *plan.BuildUnit, st: *UnitState,
               bo: *outcome.BuildOutcome, ev: *readout.Progress) R.Result[R.Void, outcome.Fail] {
    val goal: request.BuildGoal = p.req.goal;
    val flat: bool = p.target.of != nil && p.target.of.produces_image;

    readout.phase_begin(ev, readout.PH_EMIT);

    if (p.req.emit_ir || p.req.emit_asm) {
        var i: u32 = 0;
        for (i < p.emit_len) {
            val mid: session.ModuleId    = p.topo[i];
            val m:   *driver.ModuleEntry = ?p.modules[mid::u32];
            if (p.req.emit_ir) {
                val res_ir: R.Result[R.Void, str] = emit.emit_ir(p, st.ir_outputs[i], m.ir_module);
                if (R.is_err[R.Void, str](res_ir)) {
                    ret R.err[R.Void, outcome.Fail](outcome.environment(R.unwrap_err[R.Void, str](res_ir)));
                }
            }
            if (p.req.emit_asm) {
                val res_asm: R.Result[R.Void, str] = emit.emit_asm(p, st.asm_outputs[i], m.ir_module);
                if (R.is_err[R.Void, str](res_asm)) {
                    ret R.err[R.Void, outcome.Fail](outcome.environment(R.unwrap_err[R.Void, str](res_asm)));
                }
            }
            i = i + 1;
        }
    }

    if (goal == request.GOAL_OBJECTS && flat) {
        ret R.err[R.Void, outcome.Fail](outcome.user("a flat-image object format produces only executables; library and '--emit obj' outputs are unsupported"));
    }

    if (goal == request.GOAL_TESTS && plan.finished_modules(?p.target)) {
        ret R.err[R.Void, outcome.Fail](outcome.user("a finished-module object format produces no executable; this target cannot build or run tests"));
    }

    if (plan.finished_modules(?p.target) && p.target_entry != nil
        && p.target_entry.mode == driver.MODE_LIBRARY) {
        ret R.err[R.Void, outcome.Fail](outcome.user("a finished-module object format has no archive or shared-library form; each module is its own artifact"));
    }

    if (goal == request.GOAL_TESTS) {
        val cr: R.Result[R.Void, outcome.Fail] = btest.collect_scope(p, st.irs, ?st.scope);
        if (R.is_err[R.Void, outcome.Fail](cr)) { ret cr; }
        bo.tests_skipped = st.scope.skipped;
        if (st.scope.sel_len == 0) {
            readout.phase_end(ev, readout.PH_EMIT, 0, "object", "objects");
            ret R.ok_void[outcome.Fail]();
        }
    }

    val objects: bool = (goal == request.GOAL_EXECUTE && !flat)
        || goal == request.GOAL_OBJECTS
        || goal == request.GOAL_TESTS;
    if (objects) {
        val oc: R.Result[R.Void, outcome.Fail] = emit.write_objects(p, st.images, st.objects, ?st.obj_paths);
        if (R.is_err[R.Void, outcome.Fail](oc)) { ret oc; }
        st.obj_len = p.emit_len;
    }

    if (goal == request.GOAL_OBJECTS
        || (goal == request.GOAL_EXECUTE && plan.finished_modules(?p.target))) {
        st.out_path = unit.out_path::*u8;
    }

    if (objects) { readout.phase_end(ev, readout.PH_EMIT, st.obj_len, "object", "objects"); }
    or           { readout.phase_end(ev, readout.PH_EMIT, p.emit_len, "module", "modules"); }
    ret R.ok_void[outcome.Fail]();
}

fun artifact_digest(path: *u8, out: *u8) R.Result[R.Void, outcome.Fail] {
    val rr: R.Result[R.Void, str] = fingerprint.file_sha256(path::str, out);
    if (R.is_err[R.Void, str](rr)) {
        ret R.err[R.Void, outcome.Fail](outcome.environment(R.unwrap_err[R.Void, str](rr)));
    }
    ret R.ok_void[outcome.Fail]();
}

fun artifact_reusable(s: *session.Session, artifact: *u8, revision: query.Revision) bool {
    if (!fs.is_file(artifact::str)) { ret false; }
    var recorded: [32]u8;
    if (!session.lookup_link_publication(s, artifact::str, revision, ?recorded)) { ret false; }
    var cur: [32]u8;
    val d_r: R.Result[R.Void, outcome.Fail] = artifact_digest(artifact, ?cur[0]);
    if (R.is_err[R.Void, outcome.Fail](d_r)) { ret false; }
    ret memory.raw_equal((?cur[0])::ptr, (?recorded[0])::ptr, 32::usize);
}

fun record_artifact_publication(s: *session.Session, artifact: *u8, revision: query.Revision) R.Result[R.Void, outcome.Fail] {
    if (query.peek_revision(?s.queries, query.Q_LINK, 0) != revision) {
        ret R.err[R.Void, outcome.Fail](outcome.internal("the link query's revision moved while the artifact was being written"));
    }
    var d: [32]u8;
    val d_r: R.Result[R.Void, outcome.Fail] = artifact_digest(artifact, ?d[0]);
    if (R.is_err[R.Void, outcome.Fail](d_r)) { ret d_r; }
    val rec_r: R.Result[R.Void, str] = session.record_link_publication(s, artifact::str, revision, ?d);
    if (R.is_err[R.Void, str](rec_r)) { ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[R.Void, str](rec_r))); }
    ret R.ok_void[outcome.Fail]();
}

fun link_phase(p: *driver.Project, unit: *plan.BuildUnit, st: *UnitState,
               bo: *outcome.BuildOutcome, oa: *A.Allocator, ev: *readout.Progress) R.Result[R.Void, outcome.Fail] {
    val goal: request.BuildGoal = p.req.goal;

    readout.phase_begin(ev, readout.PH_LINK);
    val t_link: ctime.Time = readout.item_begin(ev);

    if (goal == request.GOAL_TESTS) {
        if (st.scope.sel_len == 0) {
            readout.phase_end(ev, readout.PH_LINK, 0, "binary", "binaries");
            ret R.ok_void[outcome.Fail]();
        }
        val dr: R.Result[R.Void, outcome.Fail] = link_dispatch_phase(p, unit, st, ev, t_link);
        if (R.is_err[R.Void, outcome.Fail](dr)) { ret dr; }
        val rr: R.Result[R.Void, outcome.Fail] = btest.record_tests(p, ?st.scope, unit.out_path::*u8, bo, oa);
        if (R.is_err[R.Void, outcome.Fail](rr)) { ret rr; }
        st.out_path = unit.out_path::*u8;
        readout.item(ev, readout.PH_LINK, unit.out_path, t_link);
        readout.phase_end(ev, readout.PH_LINK, 1, "binary", "binaries");
        ret R.ok_void[outcome.Fail]();
    }

    val te: *driver.TargetEntry = p.target_entry;
    if (te == nil) { ret R.err[R.Void, outcome.Fail](outcome.internal("no target selected")); }

    if (p.target.of != nil && p.target.of.produces_image) {
        if (te.mode == driver.MODE_LIBRARY) {
            ret R.err[R.Void, outcome.Fail](outcome.user("a flat-image object format produces only executables; library and '--emit obj' outputs are unsupported"));
        }
        ret link_flat(p, unit, st, ev, t_link);
    }

    if (te.mode == driver.MODE_LIBRARY) {
        if (te.lib_kind == manifest.LIBKIND_STATIC) {
            val arc_r: R.Result[R.Void, outcome.Fail] = emit.emit_static_archive(p, st.artifact, st.images, st.obj_paths, ?st.out_path);
            if (R.is_err[R.Void, outcome.Fail](arc_r)) { ret arc_r; }
            readout.phase_end(ev, readout.PH_LINK, 1, "archive", "archives");
            ret R.ok_void[outcome.Fail]();
        }
        if (te.lib_kind == manifest.LIBKIND_SHARED) {
            val ext_r: R.Result[R.Void, outcome.Fail] = emit.append_external_inputs(p, unit, ?st.obj_paths, ?st.obj_len, ?st.dynlibs, ?st.dynlib_len);
            if (R.is_err[R.Void, outcome.Fail](ext_r)) { ret ext_r; }
            val so_r: R.Result[R.Void, outcome.Fail] = emit.emit_shared_library(p, st.artifact, st.obj_paths, st.obj_len, st.dynlibs, st.dynlib_len, ?st.out_path);
            if (R.is_err[R.Void, outcome.Fail](so_r)) { ret so_r; }
            readout.phase_end(ev, readout.PH_LINK, 1, "library", "libraries");
            ret R.ok_void[outcome.Fail]();
        }
        st.out_path = unit.obj_dir::*u8;
        readout.phase_end(ev, readout.PH_LINK, st.obj_len, "object", "objects");
        ret R.ok_void[outcome.Fail]();
    }

    val ext_r: R.Result[R.Void, outcome.Fail] = emit.append_external_inputs(p, unit, ?st.obj_paths, ?st.obj_len, ?st.dynlibs, ?st.dynlib_len);
    if (R.is_err[R.Void, outcome.Fail](ext_r)) { ret ext_r; }

    val artifact: str = unit.out_path;

    val ext_from:  u32 = p.emit_len;
    val ext_count: u32 = st.obj_len - p.emit_len;
    val loaded_r: R.Result[emit.LoadedImageOptions, outcome.Fail] =
        emit.load_image_options(p, linker.LINK_EXE, artifact::*u8);
    if (R.is_err[emit.LoadedImageOptions, outcome.Fail](loaded_r)) {
        ret R.err[R.Void, outcome.Fail](R.unwrap_err[emit.LoadedImageOptions, outcome.Fail](loaded_r));
    }
    var loaded: emit.LoadedImageOptions = R.unwrap_ok[emit.LoadedImageOptions, outcome.Fail](loaded_r);

    val cfg_r: R.Result[R.Void, outcome.Fail] = set_link_config_input(p, artifact::*u8, emit.artifact_product_name(p), linker.LINK_EXE::u32,
                                                                    ?st.obj_paths[ext_from], ext_count, st.dynlibs, st.dynlib_len, ?loaded);
    if (R.is_err[R.Void, outcome.Fail](cfg_r)) { emit.dnit_image_options(p.alloc, ?loaded); ret cfg_r; }
    val relink_r: R.Result[bool, outcome.Fail] = driver.run_link_pass(p);
    if (R.is_err[bool, outcome.Fail](relink_r)) { emit.dnit_image_options(p.alloc, ?loaded); ret R.void_of[bool, outcome.Fail](relink_r); }
    val link_rev: query.Revision = query.peek_revision(?p.s.queries, query.Q_LINK, 0);
    if (!R.unwrap_ok[bool, outcome.Fail](relink_r) && artifact_reusable(p.s, artifact::*u8, link_rev)) {
        st.out_path = artifact::*u8;
        readout.item(ev, readout.PH_LINK, artifact, t_link);
        readout.phase_end(ev, readout.PH_LINK, 1, "binary", "binaries");
        emit.dnit_image_options(p.alloc, ?loaded);
        ret R.ok_void[outcome.Fail]();
    }

    val from_image: bool = p.target.of.links_from_image;
    var res_link: R.Result[R.Void, outcome.Fail] = R.ok_void[outcome.Fail]();
    if (from_image) {
        res_link = emit.link_mixed_images(p, st.images, ?st.obj_paths[ext_from], ext_count, st.dynlibs, st.dynlib_len, st.artifact, loaded.options);
    }
    if (!from_image) {
        res_link = emit.link_executable(p, st.obj_paths, st.obj_len, st.dynlibs, st.dynlib_len, st.artifact, loaded.options);
    }
    emit.dnit_image_options(p.alloc, ?loaded);
    if (R.is_err[R.Void, outcome.Fail](res_link)) { ret res_link; }

    val publish_r: R.Result[R.Void, outcome.Fail] = record_artifact_publication(p.s, artifact::*u8, link_rev);
    if (R.is_err[R.Void, outcome.Fail](publish_r)) { ret publish_r; }

    st.out_path = artifact::*u8;
    readout.item(ev, readout.PH_LINK, artifact, t_link);
    readout.phase_end(ev, readout.PH_LINK, 1, "binary", "binaries");
    ret R.ok_void[outcome.Fail]();
}

fun link_dispatch_phase(p: *driver.Project, unit: *plan.BuildUnit, st: *UnitState,
                        ev: *readout.Progress, t_link: ctime.Time) R.Result[R.Void, outcome.Fail] {
    val artifact: str = unit.out_path;

    val in_r: R.Result[btest.DispatchInputs, outcome.Fail] = btest.collect_dispatch_inputs(p, unit, st.obj_paths);
    if (R.is_err[btest.DispatchInputs, outcome.Fail](in_r)) {
        ret R.err[R.Void, outcome.Fail](R.unwrap_err[btest.DispatchInputs, outcome.Fail](in_r));
    }
    var di: btest.DispatchInputs = R.unwrap_ok[btest.DispatchInputs, outcome.Fail](in_r);

    val ext_from:  u32 = p.emit_len;
    val ext_count: u32 = di.shared_len - p.emit_len;
    var ext_paths: **u8 = nil;
    if (ext_count > 0) { ext_paths = ?di.shared[ext_from]; }

    val cfg_r: R.Result[R.Void, outcome.Fail] = set_dispatch_config_input(p, artifact::*u8,
        ext_paths, ext_count, di.dynlibs, di.dynlib_len, ?st.scope);
    if (R.is_err[R.Void, outcome.Fail](cfg_r)) { btest.free_dispatch_inputs(p, ?di); ret cfg_r; }

    val relink_r: R.Result[bool, outcome.Fail] = driver.run_link_pass(p);
    if (R.is_err[bool, outcome.Fail](relink_r)) { btest.free_dispatch_inputs(p, ?di); ret R.void_of[bool, outcome.Fail](relink_r); }
    val link_rev: query.Revision = query.peek_revision(?p.s.queries, query.Q_LINK, 0);
    if (!R.unwrap_ok[bool, outcome.Fail](relink_r) && artifact_reusable(p.s, artifact::*u8, link_rev)) {
        btest.free_dispatch_inputs(p, ?di);
        ret R.ok_void[outcome.Fail]();
    }

    val lr: R.Result[R.Void, outcome.Fail] = btest.link_dispatcher(p, unit, ?st.scope, ?di, st.dispatcher, st.artifact);
    btest.free_dispatch_inputs(p, ?di);
    if (R.is_err[R.Void, outcome.Fail](lr)) { ret lr; }

    ret record_artifact_publication(p.s, artifact::*u8, link_rev);
}

fun set_dispatch_config_input(p: *driver.Project, out_path: *u8,
                              ext_paths: **u8, ext_count: u32,
                              dynlibs: *of.DynLib, dynlib_count: u32,
                              sc: *btest.TestScope) R.Result[R.Void, outcome.Fail] {
    var fb: dq.FpBuf;
    fb.alloc = p.alloc;
    fb.buf   = nil;
    fb.len   = 0;
    fb.cap   = 0;

    var w: R.Result[R.Void, str] = write_link_config(?fb, p, out_path, emit.artifact_product_name(p),
        linker.LINK_EXE::u32, ext_paths, ext_count, dynlibs, dynlib_count, nil);
    if (R.is_ok[R.Void, str](w)) { w = btest.fingerprint_scope(?fb, p, sc); }
    if (R.is_err[R.Void, str](w)) {
        if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](p.alloc, fb.buf, fb.cap::usize); }
        ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[R.Void, str](w)));
    }

    val fl: R.Result[u32, str] = dq.fp_input_len(?fb);
    if (R.is_err[u32, str](fl)) {
        dq.fp_free(?fb);
        ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[u32, str](fl)));
    }
    val si: R.Result[R.Void, str] = query.set_input(?p.s.queries, query.Q_LINK_CONFIG, 0, fb.buf, R.unwrap_ok[u32, str](fl));
    if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](p.alloc, fb.buf, fb.cap::usize); }
    if (R.is_err[R.Void, str](si)) { ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[R.Void, str](si))); }
    ret R.ok_void[outcome.Fail]();
}

fun link_flat(p: *driver.Project, unit: *plan.BuildUnit, st: *UnitState, ev: *readout.Progress, t_link: ctime.Time) R.Result[R.Void, outcome.Fail] {
    val artifact: str = unit.out_path;

    val cfg_r: R.Result[R.Void, outcome.Fail] = set_link_config_input(p, artifact::*u8, emit.artifact_product_name(p), linker.LINK_EXE::u32, nil, 0, nil, 0, nil);
    if (R.is_err[R.Void, outcome.Fail](cfg_r)) { ret cfg_r; }
    val relink_r: R.Result[bool, outcome.Fail] = driver.run_link_pass(p);
    if (R.is_err[bool, outcome.Fail](relink_r)) { ret R.void_of[bool, outcome.Fail](relink_r); }
    val link_rev: query.Revision = query.peek_revision(?p.s.queries, query.Q_LINK, 0);
    if (!R.unwrap_ok[bool, outcome.Fail](relink_r) && artifact_reusable(p.s, artifact::*u8, link_rev)) {
        st.out_path = artifact::*u8;
        readout.item(ev, readout.PH_LINK, artifact, t_link);
        readout.phase_end(ev, readout.PH_LINK, 1, "binary", "binaries");
        ret R.ok_void[outcome.Fail]();
    }

    val res_link: R.Result[R.Void, outcome.Fail] = emit.link_flat_images(p, st.images, st.artifact,
        of.image_options_default(p.req.subsystem));
    if (R.is_err[R.Void, outcome.Fail](res_link)) { ret res_link; }

    val publish_r: R.Result[R.Void, outcome.Fail] = record_artifact_publication(p.s, artifact::*u8, link_rev);
    if (R.is_err[R.Void, outcome.Fail](publish_r)) { ret publish_r; }

    st.out_path = artifact::*u8;
    readout.item(ev, readout.PH_LINK, artifact, t_link);
    readout.phase_end(ev, readout.PH_LINK, 1, "binary", "binaries");
    ret R.ok_void[outcome.Fail]();
}

fun list_tests(p: *driver.Project, st: *UnitState, bo: *outcome.BuildOutcome, oa: *A.Allocator) R.Result[R.Void, outcome.Fail] {
    val cr: R.Result[R.Void, outcome.Fail] = btest.collect_scope(p, st.irs, ?st.scope);
    if (R.is_err[R.Void, outcome.Fail](cr)) { ret cr; }
    bo.tests_skipped = st.scope.skipped;
    ret btest.record_tests(p, ?st.scope, nil, bo, oa);
}

fun record_artifact(p: *driver.Project, unit: *plan.BuildUnit, st: *UnitState, bo: *outcome.BuildOutcome) R.Result[R.Void, outcome.Fail] {
    if (st.out_path == nil) { ret R.ok_void[outcome.Fail](); }

    var kind: outcome.ArtifactKind = outcome.ART_BINARY;
    if (p.req.goal == request.GOAL_OBJECTS) { kind = outcome.ART_OBJECTS; }
    or (p.req.goal == request.GOAL_TESTS)   { kind = outcome.ART_TESTS; }
    or (plan.finished_modules(?p.target))     { kind = outcome.ART_OBJECTS; }
    or (p.target_entry != nil && p.target_entry.mode == driver.MODE_LIBRARY) {
        kind = outcome.ART_OBJECTS;
        if (p.target_entry.lib_kind == manifest.LIBKIND_STATIC) { kind = outcome.ART_ARCHIVE; }
        if (p.target_entry.lib_kind == manifest.LIBKIND_SHARED) { kind = outcome.ART_SHARED; }
    }

    val rec_r: R.Result[R.Void, str] = outcome.record_artifact(bo, kind, st.out_path::str);
    if (R.is_err[R.Void, str](rec_r)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    ret R.ok_void[outcome.Fail]();
}

fun emit_unit_summary(p: *driver.Project, st: *UnitState, ev: *readout.Progress) {
    var out_str: str = "<output>";
    if (st.out_path != nil) { out_str = st.out_path::str; }

    val te: *driver.TargetEntry = p.target_entry;
    val emit_obj: bool = p.req.goal == request.GOAL_OBJECTS;
    val is_lib: bool = emit_obj || plan.finished_modules(?p.target)
        || (te != nil && te.mode == driver.MODE_LIBRARY);

    if (!is_lib && st.out_path != nil) {
        val fi_r: R.Result[fs.Metadata, str] = fs.metadata(st.out_path::str);
        if (R.is_ok[fs.Metadata, str](fi_r)) {
            val fi: fs.Metadata = R.unwrap_ok[fs.Metadata, str](fi_r);
            var unit_s: str = "B";
            val mag: i64 = readout.size_split(fi.size, ?unit_s);
            readout.summary(ev, out_str, p.emit_len, mag, unit_s, true);
            ret;
        }
    }
    readout.summary(ev, out_str, p.emit_len, 0, "B", false);
}

fun pcg_enabled(p: *driver.Project) bool {
    ret p.req.jobs >= 1 && p.emit_len > 0;
}

pub fun set_link_config_input(p: *driver.Project, out_path: *u8, product: *u8, out_kind: u32,
                              ext_paths: **u8, ext_count: u32,
                              dynlibs: *of.DynLib, dynlib_count: u32,
                              image: *emit.LoadedImageOptions) R.Result[R.Void, outcome.Fail] {
    var fb: dq.FpBuf;
    fb.alloc = p.alloc;
    fb.buf   = nil;
    fb.len   = 0;
    fb.cap   = 0;

    val w: R.Result[R.Void, str] = write_link_config(?fb, p, out_path, product, out_kind, ext_paths, ext_count, dynlibs, dynlib_count, image);
    if (R.is_err[R.Void, str](w)) {
        if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](p.alloc, fb.buf, fb.cap::usize); }
        ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[R.Void, str](w)));
    }

    val fl: R.Result[u32, str] = dq.fp_input_len(?fb);
    if (R.is_err[u32, str](fl)) {
        dq.fp_free(?fb);
        ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[u32, str](fl)));
    }
    val si: R.Result[R.Void, str] = query.set_input(?p.s.queries, query.Q_LINK_CONFIG, 0, fb.buf, R.unwrap_ok[u32, str](fl));
    if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](p.alloc, fb.buf, fb.cap::usize); }
    if (R.is_err[R.Void, str](si)) { ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[R.Void, str](si))); }
    ret R.ok_void[outcome.Fail]();
}

fun write_link_config(fb: *dq.FpBuf, p: *driver.Project, out_path: *u8, product: *u8, out_kind: u32,
                      ext_paths: **u8, ext_count: u32,
                      dynlibs: *of.DynLib, dynlib_count: u32,
                      image: *emit.LoadedImageOptions) R.Result[R.Void, str] {
    val a0: R.Result[R.Void, str] = dq.fp_u32(fb, out_kind);            if (R.is_err[R.Void, str](a0)) { ret a0; }
    var pie_axis: u32 = 0;
    if (p.req.pie) { pie_axis = 1; }
    val a1: R.Result[R.Void, str] = dq.fp_u32(fb, pie_axis);            if (R.is_err[R.Void, str](a1)) { ret a1; }
    val a2: R.Result[R.Void, str] = dq.fp_cstr(fb, out_path);           if (R.is_err[R.Void, str](a2)) { ret a2; }
    val a3: R.Result[R.Void, str] = dq.fp_cstr(fb, product);            if (R.is_err[R.Void, str](a3)) { ret a3; }
    val a6: R.Result[R.Void, str] = dq.fp_domain_u8(fb, fingerprint.DOMAIN_SUBSYSTEM,
        of.SUBSYSTEM_CATALOG_VERSION, of.subsystem_fingerprint_tag(p.req.subsystem));
    if (R.is_err[R.Void, str](a6)) { ret a6; }

    var has_resources: u32 = 0;
    if (image != nil && image.resource != nil) { has_resources = 1; }
    val ar0: R.Result[R.Void, str] = dq.fp_u32(fb, has_resources); if (R.is_err[R.Void, str](ar0)) { ret ar0; }
    if (has_resources != 0) {
        val ar1: R.Result[R.Void, str] = dq.fp_cstr(fb, image.icon_path::*u8); if (R.is_err[R.Void, str](ar1)) { ret ar1; }
        val ar2: R.Result[R.Void, str] = dq.fp_content(fb, image.icon_bytes.data, image.icon_bytes.len); if (R.is_err[R.Void, str](ar2)) { ret ar2; }
        val ar3: R.Result[R.Void, str] = dq.fp_cstr(fb, image.manifest_path::*u8); if (R.is_err[R.Void, str](ar3)) { ret ar3; }
        val ar4: R.Result[R.Void, str] = dq.fp_content(fb, image.manifest_bytes.data, image.manifest_bytes.len); if (R.is_err[R.Void, str](ar4)) { ret ar4; }
        val ar5: R.Result[R.Void, str] = dq.fp_cstr(fb, image.resource.version::*u8); if (R.is_err[R.Void, str](ar5)) { ret ar5; }
        val ar6: R.Result[R.Void, str] = dq.fp_cstr(fb, image.resource.internal_name::*u8); if (R.is_err[R.Void, str](ar6)) { ret ar6; }
        val ar7: R.Result[R.Void, str] = dq.fp_cstr(fb, image.resource.original_filename::*u8); if (R.is_err[R.Void, str](ar7)) { ret ar7; }
        val ar8: R.Result[R.Void, str] = dq.fp_cstr(fb, image.resource.product_name::*u8); if (R.is_err[R.Void, str](ar8)) { ret ar8; }
    }

    val a4: R.Result[R.Void, str] = dq.fp_u32(fb, ext_count);           if (R.is_err[R.Void, str](a4)) { ret a4; }
    var i: u32 = 0;
    for (i < ext_count) {
        val ap: R.Result[R.Void, str] = dq.fp_cstr(fb, ext_paths[i]);          if (R.is_err[R.Void, str](ap)) { ret ap; }
        val ah: R.Result[R.Void, str] = dq.fp_file_content(fb, ext_paths[i]); if (R.is_err[R.Void, str](ah)) { ret ah; }
        i = i + 1;
    }
    val a5: R.Result[R.Void, str] = dq.fp_u32(fb, dynlib_count);        if (R.is_err[R.Void, str](a5)) { ret a5; }
    var j: u32 = 0;
    for (j < dynlib_count) {
        val an: R.Result[R.Void, str] = dq.fp_u32(fb, dynlibs[j].name::u32);   if (R.is_err[R.Void, str](an)) { ret an; }
        val as: R.Result[R.Void, str] = dq.fp_u32(fb, dynlibs[j].soname::u32); if (R.is_err[R.Void, str](as)) { ret as; }
        val ar: R.Result[R.Void, str] = dq.fp_u32(fb, dynlibs[j].rpath::u32);  if (R.is_err[R.Void, str](ar)) { ret ar; }
        j = j + 1;
    }
    ret R.ok_void[str]();
}

rec PcgWorker {
    backing: A.Allocator;
    ar:      arena.Arena;
    alloc:   A.Allocator;
    sess:    session.Session;
    active:  bool;
}

rec PcgSlot {
    image:  *of.ObjectImage;
    worker: u32;
    failed: bool;
    fail:   fail.Fail;
    d:      cdur.Duration;
}

rec ParallelCodegen {
    p:          *driver.Project;
    next:       i64;
    worker_seq: i64;
    stop:       i64;
    nworkers:   u32;
    workers:    *PcgWorker;
    slots:      *PcgSlot;
    stale:      *u32;
    stale_len:  u32;
    dbg:        codegen.DebugInfo;
}

fun pcg_worker_init(w: *PcgWorker, p: *driver.Project) O.Option[str] {
    w.active = false;
    if (O.is_some[str](page.make(?w.backing)))          { ret O.some[str]("parallel codegen: worker backing alloc failed"); }
    if (O.is_some[str](arena.init(?w.ar, ?w.backing, 0))) { ret O.some[str]("parallel codegen: worker arena init failed"); }
    if (O.is_some[str](arena.make(?w.alloc, ?w.ar)))     { arena.dnit(?w.ar); ret O.some[str]("parallel codegen: worker arena bind failed"); }

    w.sess          = @p.s;
    w.sess.alloc    = ?w.alloc;
    w.sess.interner = intern.make_child(?p.s.interner, ?w.alloc);
    w.active        = true;
    ret O.none[str]();
}

fun pcg_worker_teardown(w: *PcgWorker) {
    if (!w.active) { ret; }
    arena.dnit(?w.ar);
    w.active = false;
}

fun pcg_stable_err(p: *driver.Project, msg: str) str {
    val ir: R.Result[intern.StrId, str] = intern.intern(?p.s.interner, msg);
    if (R.is_ok[intern.StrId, str](ir)) {
        val nm: O.Option[str] = intern.lookup(?p.s.interner, R.unwrap_ok[intern.StrId, str](ir));
        if (O.is_some[str](nm)) { ret O.unwrap[str](nm); }
    }
    ret "parallel codegen failed, and re-homing its diagnostic off the worker arena failed in turn (allocation failure)";
}

fun pcg_worker_main(arg: *u8) {
    val pc: *ParallelCodegen = arg::*ParallelCodegen;
    if (pc == nil) { ret; }
    val wid_raw: i64 = atomic.fetch_add(?pc.worker_seq, 1::i64);
    if (wid_raw < 0 || wid_raw >= pc.nworkers::i64) { ret; }
    val wid: u32 = wid_raw::u32;
    val w: *PcgWorker = ?pc.workers[wid::usize];

    for (true) {
        if (atomic.load(?pc.stop) != 0) { ret; }
        val idx_raw: i64 = atomic.fetch_add(?pc.next, 1::i64);
        if (idx_raw >= pc.stale_len::i64) { ret; }
        val idx: u32 = idx_raw::u32;

        val mid:  session.ModuleId = pc.p.topo[pc.stale[idx::usize]];
        val m:    *driver.ModuleEntry     = ?pc.p.modules[mid::u32];
        val slot: *PcgSlot         = ?pc.slots[idx::usize];
        slot.worker = wid;

        val t0: ctime.Time = ctime.monotonic();

        val srcs_r: R.Result[driver.CodeSources, str] = driver.code_sources(pc.p, mid, ?w.alloc);
        if (R.is_err[driver.CodeSources, str](srcs_r)) {
            slot.fail   = fail.message(R.unwrap_err[driver.CodeSources, str](srcs_r));
            slot.failed = true;
            slot.image = nil;
            atomic.store(?pc.stop, 1::i64);
            ret;
        }
        var srcs: driver.CodeSources = R.unwrap_ok[driver.CodeSources, str](srcs_r);

        val r: R.Result[of.ObjectImage, fail.Fail] = codegen.codegen_module(?w.sess, ?pc.p.target, m.ir_module, srcs.set, nil, pc.p.req.placement_policy, pc.dbg);
        driver.sources_dnit(?w.alloc, ?srcs);
        slot.d = ctime.time_sub(ctime.monotonic(), t0);
        if (R.is_err[of.ObjectImage, fail.Fail](r)) {
            slot.fail   = R.unwrap_err[of.ObjectImage, fail.Fail](r);
            slot.failed = true;
            slot.image = nil;
            atomic.store(?pc.stop, 1::i64);
            ret;
        }
        var img: of.ObjectImage = R.unwrap_ok[of.ObjectImage, fail.Fail](r);
        val br: R.Result[*of.ObjectImage, str] = A.allocate[of.ObjectImage](?w.alloc, 1::usize);
        if (R.is_err[*of.ObjectImage, str](br)) {
            slot.fail   = fail.message("parallel codegen: worker image box allocation failed");
            slot.failed = true;
            slot.image = nil;
            atomic.store(?pc.stop, 1::i64);
            ret;
        }
        val box: *of.ObjectImage = R.unwrap_ok[*of.ObjectImage, str](br);
        box[0]     = img;
        slot.image = box;
        slot.failed = false;
    }
}

fun run_codegen_parallel(p: *driver.Project) R.Result[R.Void, fail.Fail] {
    val emit_len: u32 = p.emit_len;
    if (emit_len == 0) { ret R.ok_void[fail.Fail](); }

    val rstale: R.Result[*u32, str] = A.allocate[u32](p.alloc, emit_len::usize);
    if (R.is_err[*u32, str](rstale)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*u32, str](rstale))); }
    val stale: *u32 = R.unwrap_ok[*u32, str](rstale);
    var stale_len: u32 = 0;
    var ti: u32 = 0;
    for (ti < emit_len) {
        if (!driver.codegen_reusable(p, p.topo[ti])) {
            stale[stale_len] = ti;
            stale_len = stale_len + 1;
        }
        ti = ti + 1;
    }
    if (stale_len <= 1) {
        A.deallocate[u32](p.alloc, stale, emit_len::usize);
        ret R.ok_void[fail.Fail]();
    }

    var nworkers: u32 = p.req.jobs;
    if (nworkers == 0)         { nworkers = 1; }
    if (nworkers > stale_len)  { nworkers = stale_len; }

    if (nworkers <= 1) {
        A.deallocate[u32](p.alloc, stale, emit_len::usize);
        ret R.ok_void[fail.Fail]();
    }

    val rslots: R.Result[*PcgSlot, str] = A.allocate[PcgSlot](p.alloc, stale_len::usize);
    if (R.is_err[*PcgSlot, str](rslots)) {
        A.deallocate[u32](p.alloc, stale, emit_len::usize);
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*PcgSlot, str](rslots)));
    }
    val slots: *PcgSlot = R.unwrap_ok[*PcgSlot, str](rslots);
    var si: u32 = 0;
    for (si < stale_len) { slots[si].image = nil; slots[si].worker = 0; slots[si].failed = false; slots[si].d = 0; si = si + 1; }

    val rdbg: R.Result[codegen.DebugInfo, str] = driver.debug_info_of(p);
    if (R.is_err[codegen.DebugInfo, str](rdbg)) {
        A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
        A.deallocate[u32](p.alloc, stale, emit_len::usize);
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[codegen.DebugInfo, str](rdbg)));
    }
    val dbg: codegen.DebugInfo = R.unwrap_ok[codegen.DebugInfo, str](rdbg);

    val rworkers: R.Result[*PcgWorker, str] = A.allocate[PcgWorker](p.alloc, nworkers::usize);
    if (R.is_err[*PcgWorker, str](rworkers)) {
        A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
        A.deallocate[u32](p.alloc, stale, emit_len::usize);
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*PcgWorker, str](rworkers)));
    }
    val workers: *PcgWorker = R.unwrap_ok[*PcgWorker, str](rworkers);

    var wi: u32 = 0;
    for (wi < nworkers) {
        val io: O.Option[str] = pcg_worker_init(?workers[wi], p);
        if (O.is_some[str](io)) {
            var wj: u32 = 0;
            for (wj < wi) { pcg_worker_teardown(?workers[wj]); wj = wj + 1; }
            A.deallocate[PcgWorker](p.alloc, workers, nworkers::usize);
            A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
            A.deallocate[u32](p.alloc, stale, emit_len::usize);
            ret R.err[R.Void, fail.Fail](fail.message(O.unwrap[str](io)));
        }
        wi = wi + 1;
    }

    var ctx: ParallelCodegen;
    ctx.p          = p;
    ctx.next       = 0;
    ctx.worker_seq = 0;
    ctx.stop       = 0;
    ctx.nworkers   = nworkers;
    ctx.workers    = workers;
    ctx.slots      = slots;
    ctx.stale      = stale;
    ctx.stale_len  = stale_len;
    ctx.dbg        = dbg;

    var threads: *thread.Thread = nil;
    val extra: u32 = nworkers - 1;
    if (extra > 0) {
        val rt: R.Result[*thread.Thread, str] = A.allocate[thread.Thread](p.alloc, extra::usize);
        if (R.is_err[*thread.Thread, str](rt)) {
            var wk: u32 = 0;
            for (wk < nworkers) { pcg_worker_teardown(?workers[wk]); wk = wk + 1; }
            A.deallocate[PcgWorker](p.alloc, workers, nworkers::usize);
            A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
            A.deallocate[u32](p.alloc, stale, emit_len::usize);
            ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*thread.Thread, str](rt)));
        }
        threads = R.unwrap_ok[*thread.Thread, str](rt);
        var k: u32 = 0;
        for (k < extra) { thread.spawn_with(pcg_worker_main, (?ctx)::*u8, ?threads[k]); k = k + 1; }
    }

    pcg_worker_main((?ctx)::*u8);

    if (extra > 0) {
        var k: u32 = 0;
        for (k < extra) {
            if (threads[k].tid >= 0) { thread.join(?threads[k]); }
            k = k + 1;
        }
        A.deallocate[thread.Thread](p.alloc, threads, extra::usize);
    }

    readout.phase_workers(p.events, readout.PH_CODEGEN, nworkers);
    var ii: u32 = 0;
    for (ii < stale_len) {
        val im: *driver.ModuleEntry = ?p.modules[p.topo[stale[ii::usize]]::u32];
        readout.item_dur(p.events, readout.PH_CODEGEN, driver.fqn_name(p, im.fqn), slots[ii].d);
        ii = ii + 1;
    }

    var ei: u32 = 0;
    for (ei < stale_len) {
        if (slots[ei].failed) {
            val msg: str = pcg_stable_err(p, slots[ei].fail.message);
            var wk: u32 = 0;
            for (wk < nworkers) { pcg_worker_teardown(?workers[wk]); wk = wk + 1; }
            A.deallocate[PcgWorker](p.alloc, workers, nworkers::usize);
            A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
            A.deallocate[u32](p.alloc, stale, emit_len::usize);
            ret R.err[R.Void, fail.Fail](fail.message(msg));
        }
        ei = ei + 1;
    }

    val cr: R.Result[R.Void, str] = pcg_collect(p, ?ctx);

    var wk: u32 = 0;
    for (wk < nworkers) { pcg_worker_teardown(?workers[wk]); wk = wk + 1; }
    A.deallocate[PcgWorker](p.alloc, workers, nworkers::usize);
    A.deallocate[PcgSlot](p.alloc, slots, stale_len::usize);
    A.deallocate[u32](p.alloc, stale, emit_len::usize);
    ret fail.lift[R.Void](cr);
}

fun pcg_collect(p: *driver.Project, ctx: *ParallelCodegen) R.Result[R.Void, str] {
    val nworkers: u32 = ctx.nworkers;

    val rmaps: R.Result[*intern.ReinternMap, str] =
        A.allocate[intern.ReinternMap](p.alloc, nworkers::usize);
    if (R.is_err[*intern.ReinternMap, str](rmaps)) {
        ret R.err[R.Void, str](R.unwrap_err[*intern.ReinternMap, str](rmaps));
    }
    val remaps: *intern.ReinternMap = R.unwrap_ok[*intern.ReinternMap, str](rmaps);

    var wi: u32 = 0;
    for (wi < nworkers) {
        val rr: R.Result[intern.ReinternMap, str] =
            intern.reintern_child(?workers_at(ctx, wi).sess.interner, p.alloc);
        if (R.is_err[intern.ReinternMap, str](rr)) {
            pcg_free_remaps(p, remaps, wi);
            A.deallocate[intern.ReinternMap](p.alloc, remaps, nworkers::usize);
            ret R.err[R.Void, str](R.unwrap_err[intern.ReinternMap, str](rr));
        }
        remaps[wi] = R.unwrap_ok[intern.ReinternMap, str](rr);
        wi = wi + 1;
    }

    var i: u32 = 0;
    for (i < ctx.stale_len) {
        val slot: *PcgSlot = ?ctx.slots[i::usize];
        val rehomed: R.Result[of.ObjectImage, str] =
            obj.rehome_remap(p.s.alloc, ?p.s.interner, slot.image, remaps[slot.worker]);
        if (R.is_err[of.ObjectImage, str](rehomed)) {
            pcg_free_remaps(p, remaps, nworkers);
            A.deallocate[intern.ReinternMap](p.alloc, remaps, nworkers::usize);
            ret R.err[R.Void, str](R.unwrap_err[of.ObjectImage, str](rehomed));
        }
        val rbox: R.Result[*of.ObjectImage, str] = A.allocate[of.ObjectImage](p.s.alloc, 1::usize);
        if (R.is_err[*of.ObjectImage, str](rbox)) {
            var tmp: of.ObjectImage = R.unwrap_ok[of.ObjectImage, str](rehomed);
            obj.dnit(?tmp);
            pcg_free_remaps(p, remaps, nworkers);
            A.deallocate[intern.ReinternMap](p.alloc, remaps, nworkers::usize);
            ret R.err[R.Void, str](R.unwrap_err[*of.ObjectImage, str](rbox));
        }
        val box: *of.ObjectImage = R.unwrap_ok[*of.ObjectImage, str](rbox);
        box[0] = R.unwrap_ok[of.ObjectImage, str](rehomed);

        val mid: session.ModuleId = p.topo[ctx.stale[i::usize]];
        p.modules[mid::u32].staged_image = box;
        i = i + 1;
    }

    pcg_free_remaps(p, remaps, nworkers);
    A.deallocate[intern.ReinternMap](p.alloc, remaps, nworkers::usize);
    ret R.ok_void[str]();
}

fun workers_at(ctx: *ParallelCodegen, wi: u32) *PcgWorker {
    ret ?ctx.workers[wi::usize];
}

fun pcg_free_remaps(p: *driver.Project, remaps: *intern.ReinternMap, n: u32) {
    var wi: u32 = 0;
    for (wi < n) {
        intern.reintern_map_dnit(p.alloc, ?remaps[wi]);
        wi = wi + 1;
    }
}
