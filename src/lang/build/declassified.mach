# the listing of a checked project's declassifications, which `mach check --declassified` prints:
# every `:>T` of the project's own source, read off the syntax and the types sema gave it, so it
# lists what the source states and never what lowering or an instance makes of it

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.view.View;

use std.collections.map;
use std.text.string.str_free;

use A: std.allocator;

use mach.lang.build.outcome;
use driver_frontend: mach.lang.driver.frontend;
use mach.lang.driver.passes;
use mach.lang.driver.project;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl:      mach.lang.fe.ast.decl;
use ast_expr:      mach.lang.fe.ast.expr;
use sema_instance: mach.lang.fe.sema.instance;
use sema_product:  mach.lang.fe.sema.product;
use mach.lang.fe.sema.typename;
use lang_source: mach.lang.source;
use type_kind:   mach.lang.type.kind;

# what the listing names a declassification at module scope by, which stands in no function or test
val NO_FUNCTION: str = "<module>";

# record every declassification of the project's own modules in `bo`, module by module, each in
# source order
pub fun list(p: *project.Project, bo: *outcome.BuildOutcome) err[fail.Fail] {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        i = i + 1;
        if (!passes.module_in_current_project(p, m.fqn)) { cnt; }
        val err_listed: err[fail.Fail] = module_list(p, m, bo);
        if (sel err_listed.err) { ret err_listed; }
    }
    ret err[fail.Fail].ok{};
}

fun module_list(p: *project.Project, m: *project.ModuleEntry, bo: *outcome.BuildOutcome) err[fail.Fail] {
    val tree:     *ast.Ast                     = driver_frontend.syntax(p, m);
    val typed:    *sema_product.SemaResult     = driver_frontend.typed(p, m);
    val opt_file: opt[*lang_source.SourceFile] = lang_source.get(p.s.sources, m.file_id);
    if (tree == nil || typed == nil) { ret err[fail.Fail].ok{}; }
    if (sel opt_file.none)           { ret err[fail.Fail].ok{}; }
    val file: *lang_source.SourceFile = opt_file.some;
    var k:    usize                   = 0;
    for (k < tree.exprs.len) {
        val e: *ast_expr.Expr = ?tree.exprs.data[k];
        k = k + 1;
        if (e.kind != ast_expr.EXPR_KIND_STRIP) { cnt; }
        val operand: u32 = e.data.strip.value::u32;
        if (operand >= typed.expr_count) { cnt; }
        val held: type_kind.TypeId = typed.expr_type[operand];
        if (!type_kind.is_nil(held) && !type_kind.is_error(held)) {
            val err_recorded: err[fail.Fail] = record(p, tree, file, e.span, held, bo);
            if (sel err_recorded.err) { ret err_recorded; }
            cnt;
        }
        val err_expanded: err[fail.Fail] = expanded(p, tree, file, e.span, typed, operand, bo);
        if (sel err_expanded.err) { ret err_expanded; }
    }
    ret err[fail.Fail].ok{};
}

# what the listing names the type of a declassification by whose operand sema typed only in a comptime expansion
# that no frame of the module holds, as a generic's `$each` over its parameter's `$fields`
val EXPANDED: str = "<each expansion's>";

# record the declassification at `at` whose operand `operand` sema typed only in the frames of a comptime expansion,
# as a `$each` over `$fields` is, once for each type a frame gave it, in the order the frames were made, and once as
# typed per expansion where no frame of the module gave it one
fun expanded(p: *project.Project, tree: *ast.Ast, file: *lang_source.SourceFile, at: lang_source.Span, typed: *sema_product.SemaResult, operand: u32, bo: *outcome.BuildOutcome) err[fail.Fail] {
    val frames: *sema_instance.Frame = typed.instances.frames.data;
    var listed: bool                 = false;
    var f:      usize                = 0;
    for (f < typed.instances.frames.len) {
        val opt_found: opt[*type_kind.TypeId] = map.get[u32, type_kind.TypeId](?frames[f].exprs, ?operand);
        f = f + 1;
        if (sel opt_found.none) { cnt; }
        val ty: type_kind.TypeId = @opt_found.some;
        if (type_kind.is_nil(ty) || type_kind.is_error(ty)) { cnt; }
        var seen: bool  = false;
        var g:    usize = 0;
        for (g + 1 < f && !seen) {
            val opt_before: opt[*type_kind.TypeId] = map.get[u32, type_kind.TypeId](?frames[g].exprs, ?operand);
            if (sel opt_before.some) { seen = type_kind.same(@opt_before.some, ty); }
            g = g + 1;
        }
        if (seen) { cnt; }
        val err_recorded: err[fail.Fail] = record(p, tree, file, at, ty, bo);
        if (sel err_recorded.err) { ret err_recorded; }
        listed = true;
    }
    if (listed) { ret err[fail.Fail].ok{}; }
    ret record_spelled(p, tree, file, at, EXPANDED, bo);
}

# record the declassification at `at` of `file`, of a value of the type `secret`
fun record(p: *project.Project, tree: *ast.Ast, file: *lang_source.SourceFile, at: lang_source.Span, secret: type_kind.TypeId, bo: *outcome.BuildOutcome) err[fail.Fail] {
    val res_spelled: res[str, fail.Fail] = typename.type_to_str(p.s, secret);
    if (sel res_spelled.err) { ret err[fail.Fail].err{res_spelled.err}; }
    fin { typename.type_str_free(p.s, res_spelled.ok); }
    ret record_spelled(p, tree, file, at, res_spelled.ok, bo);
}

# record the declassification at `at` of `file`, of a value whose type is spelled `spelled`
fun record_spelled(p: *project.Project, tree: *ast.Ast, file: *lang_source.SourceFile, at: lang_source.Span, spelled: str, bo: *outcome.BuildOutcome) err[fail.Fail] {
    var function: str = NO_FUNCTION;
    var owned:    str = nil;
    fin {
        if (owned != nil) { str_free(p.alloc, owned); }
    }
    val opt_named: opt[View] = enclosing(tree, file, at);
    if (sel opt_named.some) {
        val res_copied: res[str, StrError] = str_copy_slice(p.alloc, opt_named.some.data, 0, opt_named.some.len);
        if (sel res_copied.err) { ret err[fail.Fail].err{fail.str_refused(res_copied.err)}; }
        owned    = res_copied.ok;
        function = owned;
    }
    val place:        lang_source.Position = lang_source.position(file, at.offset);
    val err_recorded: err[A.Error]         = outcome.record_declassified(bo, outcome.Declassified{file: file.path, line: place.line, column: place.col, function: function, secret: spelled});
    if (sel err_recorded.err) { ret err[fail.Fail].err{fail.refused(err_recorded.err)}; }
    ret err[fail.Fail].ok{};
}

# the name of the innermost function or test whose declaration holds `at`, a test's as its
# declaration spells it up to its name, none at module scope
fun enclosing(tree: *ast.Ast, file: *lang_source.SourceFile, at: lang_source.Span) opt[View] {
    var found: opt[View] = opt[View].none{};
    var width: usize     = 0;
    var k:     usize     = 0;
    for (k < tree.decls.len) {
        val d: *ast_decl.Decl = ?tree.decls.data[k];
        k = k + 1;
        if (d.kind != ast_decl.DECL_KIND_FUN && d.kind != ast_decl.DECL_KIND_TEST)                { cnt; }
        if (at.offset < d.span.offset || lang_source.span_end(at) > lang_source.span_end(d.span)) { cnt; }
        if (sel found.some && d.span.len >= width)                                                { cnt; }
        var name: lang_source.Span = lang_source.span_between(d.span.offset, lang_source.span_end(d.data.test_.name));
        if (d.kind == ast_decl.DECL_KIND_FUN) { name = d.data.fun_.name; }
        found = opt[View].some{lang_source.span_view(file.text, name)};
        width = d.span.len;
    }
    ret found;
}
