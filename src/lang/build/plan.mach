    val fake_rr: res[LinkInput, outcome.Fail] = resolve_token(?alloc, ?tgt, ?dirs, "", fake::*u8);
    fs.remove_all(?alloc, root);
    if (sel real_rr.err) { ret 1; }
    if (sel fake_rr.ok) { ret 1; }
    ret 0;
}

