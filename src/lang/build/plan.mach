fun ut_need_src() str {
    ret "[project]\nid = \"p\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n[target.ta]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n[target.tb]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n[artifact.shader-a]\nkind = \"static\"\nentry = \"s.mach\"\nout = \"lib/shader-a.a\"\ntargets = [\"tb\"]\nlink = []\nneed = []\n[artifact.shader-b]\nkind = \"static\"\nentry = \"s.mach\"\nout = \"lib/shader-b.a\"\ntargets = [\"tb\"]\nlink = []\nneed = []\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"ta\"]\nlink = []\nneed = [\"artifact.shader-*\"]\n[artifact.app2]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app2\"\ntargets = [\"ta\"]\nlink = []\nneed = [\"artifact.shader-a\"]\n";
}

test "mach.lang.build.plan.plan:required_artifacts_precede_their_consumer_on_their_own_target" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold_src(?alloc, ?itn, ?reg, ?m, ut_need_src())) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.target       = "ta";
    rq.artifact     = "app";

    val pr: res[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (sel pr.err) { ret 1; }
    val bp: BuildPlan = pr.ok;

    if (bp.units.len != 3)                                    { ret 1; }
    if (!str_equals(bp.units.data[0].sel_artifact, "shader-a")) { ret 1; }
    if (!str_equals(bp.units.data[1].sel_artifact, "shader-b")) { ret 1; }
    if (!str_equals(bp.units.data[2].sel_artifact, "app"))      { ret 1; }

    if (!str_equals(bp.units.data[0].sel_target, "tb"))       { ret 1; }
    if (!str_equals(bp.units.data[1].sel_target, "tb"))       { ret 1; }
    if (!str_equals(bp.units.data[2].sel_target, "ta"))       { ret 1; }

    if (!bp.units.data[0].is_required)                        { ret 1; }
    if (!bp.units.data[1].is_required)                        { ret 1; }
    if (bp.units.data[2].is_required)                         { ret 1; }

    if (!ut_path_eq(bp.units.data[0].out_path, "/r/out/tb/debug/lib/shader-a.a")) { ret 1; }
    if (!ut_path_eq(bp.units.data[2].out_path, "/r/out/ta/debug/bin/app"))        { ret 1; }

    if (bp.units.data[2].requires.len != 2)                   { ret 1; }
    if (!str_equals(bp.units.data[2].requires.data[0], "shader-a")) { ret 1; }
    if (bp.units.data[0].requires.len != 0)                   { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.plan:a_test_build_builds_its_requirements_as_ordinary_artifacts" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold_src(?alloc, ?itn, ?reg, ?m, ut_need_src())) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.target       = "ta";
    rq.artifact     = "app";
    rq.goal         = request.GOAL_TESTS;

    val pr: res[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (sel pr.err) { ret 1; }
    val bp: BuildPlan = pr.ok;

    if (bp.units.len != 3)                                      { ret 1; }
    if (!str_equals(bp.units.data[0].sel_artifact, "shader-a")) { ret 1; }
    if (bp.units.data[0].goal != request.GOAL_EXECUTE)          { ret 1; }
    if (bp.units.data[1].goal != request.GOAL_EXECUTE)          { ret 1; }
    if (bp.units.data[2].goal != request.GOAL_TESTS)            { ret 1; }
    if (!ut_path_eq(bp.units.data[0].out_path, "/r/out/tb/debug/lib/shader-a.a")) { ret 1; }
    ret 0;
}

fun ut_two_bins_src(defaults: str) str {
    var backing: A.Allocator;
    val make_r: err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret ""; }
    val head: str = "[project]\nid = \"p\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n[target.ta]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n[artifact.first]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/first\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val second: str = "[artifact.second]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/second\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val r: res[str, format.FormatError] = format.sprint(?backing, "{}{}{}{}", head, defaults, second, defaults);
    if (sel r.err) { ret ""; }
    ret r.ok;
}

test "mach.lang.build.plan.plan:a_test_goal_selection_error_fails_at_planning_with_the_selector_message_and_plans_nothing" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold_src(?alloc, ?itn, ?reg, ?m, ut_two_bins_src("default = true\n"))) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.target       = "ta";
    rq.goal         = request.GOAL_TESTS;

    val pr: res[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (sel pr.ok) { ret 1; }
    val f: outcome.Fail = pr.err;
    if (!sel f.user) { ret 2; }
    if (!str_contains(outcome.describe(f), "have 'default = true'; exactly one is allowed")) { ret 3; }
    ret 0;
}

