    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val real_r: R.Result[str, str] = path.join(?alloc, root, "libreal.a");
    val fake_r: R.Result[str, str] = path.join(?alloc, root, "libfake.a");
    if (R.is_err[str, str](real_r) || R.is_err[str, str](fake_r)) {
        fs.remove_all(?alloc, root); ret 1;
    }
    val real: str = R.unwrap_ok[str, str](real_r);
    val fake: str = R.unwrap_ok[str, str](fake_r);
    if (O.is_some[str](fs.write_bytes(real, "!<arch>\n", 8, 420))
        || O.is_some[str](fs.write_bytes(fake, "not an archive at all!!", 23, 420))) {
        fs.remove_all(?alloc, root); ret 1;
    }

    var dirs: Vector[str] = vector.init[str](?alloc);
    val real_rr: R.Result[LinkInput, outcome.Fail] =
        resolve_token(?alloc, ?tgt, ?dirs, "", real::*u8);
    val fake_rr: R.Result[LinkInput, outcome.Fail] =
        resolve_token(?alloc, ?tgt, ?dirs, "", fake::*u8);
    fs.remove_all(?alloc, root);
    if (R.is_err[LinkInput, outcome.Fail](real_rr)) { ret 1; }
    if (R.is_ok[LinkInput, outcome.Fail](fake_rr)) { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.resolve_token:truncated_object_refused_not_oob" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    val tr: R.Result[target.Target, str] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (R.is_err[target.Target, str](tr)) { ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);

    val root_r: R.Result[str, str] = ut_temp_dir(?alloc);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val obj_r: R.Result[str, str] = path.join(?alloc, root, "short.o");
    if (R.is_err[str, str](obj_r)) { fs.remove_all(?alloc, root); ret 1; }
    val obj: str = R.unwrap_ok[str, str](obj_r);
    var buf: [19]u8;
    var i: usize = 0;
    for (i < 19) { buf[i] = 0; i = i + 1; }
    buf[0] = 0x7F; buf[1] = 0x45; buf[2] = 0x4C; buf[3] = 0x46;
    if (O.is_some[str](fs.write_bytes(obj, ?buf[0], 19, 420))) {
        fs.remove_all(?alloc, root); ret 1;
    }

    var dirs: Vector[str] = vector.init[str](?alloc);
    val rr: R.Result[LinkInput, outcome.Fail] =
        resolve_token(?alloc, ?tgt, ?dirs, "", obj::*u8);
    fs.remove_all(?alloc, root);
    if (R.is_ok[LinkInput, outcome.Fail](rr)) { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.object_matches_target:declared_length_governs_the_machine_read" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    val tr: R.Result[target.Target, str] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (R.is_err[target.Target, str](tr)) { ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);

    var buf: [20]u8;
    var i: usize = 0;
    for (i < 20) { buf[i] = 0; i = i + 1; }
    buf[0] = 0x7F; buf[1] = 0x45; buf[2] = 0x4C; buf[3] = 0x46;
    bin.write_u16_le(?buf[0], 18, elf.machine_for_arch(isa.ARCH_X86_64));

    if (object_matches_target(?buf[0], 19, ?tgt)) { ret 1; }
    if (!object_matches_target(?buf[0], 20, ?tgt)) { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.extract_fat_dylib_id:selects_target_slice" {
    var buf: [320]u8;
    var i: usize = 0;
    for (i < 320) { buf[i] = 0; i = i + 1; }
    bin.write_u32_be(?buf[0], 0, 0xCAFEBABE);
    bin.write_u32_be(?buf[0], 4, 2);

    bin.write_u32_be(?buf[0], 8, 0x01000007);
    bin.write_u32_be(?buf[0], 12, 3);
    bin.write_u32_be(?buf[0], 16, 64);
    bin.write_u32_be(?buf[0], 20, 128);
    bin.write_u32_be(?buf[0], 24, 6);

    bin.write_u32_be(?buf[0], 28, 0x0100000C);
    bin.write_u32_be(?buf[0], 32, 0);
    bin.write_u32_be(?buf[0], 36, 192);
    bin.write_u32_be(?buf[0], 40, 128);
    bin.write_u32_be(?buf[0], 44, 6);

    if (!ut_fill_dylib(?buf[0], 64, "@rpath/libx.dylib", 0x01000007)
        || !ut_fill_dylib(?buf[0], 192, "@rpath/liba.dylib", 0x0100000C)) {
        ret 1;
    }
    var name: [64]u8;
    if (!extract_fat_dylib_id(?buf[0], 320, false, 0x0100000C, ?name[0], 64)
        || !str_equals((?name[0])::str, "@rpath/liba.dylib")) {
        ret 1;
    }
    if (!extract_fat_dylib_id(?buf[0], 320, false, 0x01000007, ?name[0], 64)
        || !str_equals((?name[0])::str, "@rpath/libx.dylib")) {
        ret 1;
    }
    ret 0;
}

test "mach.lang.build.plan.dylib_rpath:matches_install_name_suffix" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val base: R.Result[str, str] =
        dylib_rpath(?alloc, "/opt/lib/libfoo.dylib"::*u8,
                    "@rpath/libfoo.3.dylib"::*u8);
    val nested: R.Result[str, str] =
        dylib_rpath(?alloc, "/opt/lib/sub/libfoo.dylib"::*u8,
                    "@rpath/sub/libfoo.dylib"::*u8);
    val mismatch: R.Result[str, str] =
        dylib_rpath(?alloc, "/opt/lib/libfoo.dylib"::*u8,
                    "@rpath/sub/libfoo.dylib"::*u8);
    if (R.is_err[str, str](base) || R.is_err[str, str](nested)
        || R.is_ok[str, str](mismatch)) { ret 1; }
    if (!str_equals(R.unwrap_ok[str, str](base), "/opt/lib")
        || !str_equals(R.unwrap_ok[str, str](nested), "/opt/lib")) { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.resolve_requirement:darwin_framework" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    val xr: R.Result[target.Target, str] = target.select(?reg, "x86_64", "darwin", "sysv64");
    val ar: R.Result[target.Target, str] = target.select(?reg, "aarch64", "darwin", "aapcs64");
    val lr: R.Result[target.Target, str] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (R.is_err[target.Target, str](xr) || R.is_err[target.Target, str](ar)
        || R.is_err[target.Target, str](lr)) { ret 1; }
    var xt: target.Target = R.unwrap_ok[target.Target, str](xr);
    var at: target.Target = R.unwrap_ok[target.Target, str](ar);
    var lt: target.Target = R.unwrap_ok[target.Target, str](lr);

    var req: manifest.LinkRequirement;
    req.source = manifest.LINK_FRAMEWORK;
    req.text = R.unwrap_ok[intern.StrId, str](intern.intern(?itn, "AppKit"));
    req.library = R.unwrap_ok[intern.StrId, str](intern.intern(?itn, "appkit"));
    var dirs: Vector[str] = vector.init[str](?alloc);

    val x: R.Result[LinkInput, outcome.Fail] =
        resolve_requirement(?alloc, ?itn, ?xt, ?dirs, "", ?req);
    val a: R.Result[LinkInput, outcome.Fail] =
        resolve_requirement(?alloc, ?itn, ?at, ?dirs, "", ?req);
    val l: R.Result[LinkInput, outcome.Fail] =
        resolve_requirement(?alloc, ?itn, ?lt, ?dirs, "", ?req);
    if (R.is_err[LinkInput, outcome.Fail](x) || R.is_err[LinkInput, outcome.Fail](a)
        || R.is_ok[LinkInput, outcome.Fail](l)) { ret 1; }
    val want: str = "/System/Library/Frameworks/AppKit.framework/AppKit";
    val xi: LinkInput = R.unwrap_ok[LinkInput, outcome.Fail](x);
    val ai: LinkInput = R.unwrap_ok[LinkInput, outcome.Fail](a);
    if (!str_equals(xi.text, want) || !str_equals(ai.text, want)) { ret 1; }
    if (!str_equals(xi.library, "appkit") || !str_equals(ai.library, "appkit")) { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.plan:matrix_expands_targets_outer_artifacts_inner" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold(?alloc, ?itn, ?reg, ?m)) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.all_targets  = true;

    val pr: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_err[BuildPlan, outcome.Fail](pr)) { ret 1; }
    val bp: BuildPlan = R.unwrap_ok[BuildPlan, outcome.Fail](pr);

    if (bp.units.len != 4)                                        { ret 1; }
    if (!str_equals(bp.units.data[0].sel_target, "ta"))           { ret 1; }
    if (!str_equals(bp.units.data[0].sel_artifact, "appa"))       { ret 1; }
    if (!str_equals(bp.units.data[1].sel_target, "ta"))           { ret 1; }
    if (!str_equals(bp.units.data[1].sel_artifact, "libb"))       { ret 1; }
    if (!str_equals(bp.units.data[2].sel_target, "tb"))           { ret 1; }
    if (!str_equals(bp.units.data[2].sel_artifact, "appa"))       { ret 1; }
    if (!str_equals(bp.units.data[3].sel_artifact, "libb"))       { ret 1; }

    if (!ut_path_eq(bp.units.data[0].out_path, "/r/out/ta/debug/bin/appa"))   { ret 1; }
    if (!ut_path_eq(bp.units.data[0].obj_dir, "/r/out/ta/debug/obj"))         { ret 1; }
    if (!ut_path_eq(bp.units.data[1].out_path, "/r/out/ta/debug/lib/libb.a")) { ret 1; }
    if (!ut_path_eq(bp.units.data[2].out_path, "/r/out/tb/debug/bin/appa"))   { ret 1; }

    if (bp.units.data[0].target_entry.mode != project.MODE_EXECUTABLE) { ret 1; }
    if (bp.units.data[1].target_entry.mode != project.MODE_LIBRARY)    { ret 1; }
    if (bp.units.data[1].target_entry.lib_kind != manifest.LIBKIND_STATIC) { ret 1; }
    ret 0;
}

fun ut_split_src() str {
    ret "[project]\nid = \"p\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n[target.kern]\nisa = \"x86_64\"\nos = \"freestanding\"\nabi = \"sysv64\"\n[target.other]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n[artifact.tool]\nkind = \"bin\"\nentry = \"tool.mach\"\nout = \"bin/tool\"\ntargets = [\"host\"]\nlink = []\nneed = []\n[artifact.kernel]\nkind = \"bin\"\nentry = \"kernel.mach\"\nout = \"bin/kernel\"\ntargets = [\"kern\"]\nlink = []\nneed = []\n";
}

test "mach.lang.build.plan.plan:artifacts_expand_filtered_by_target" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold_src(?alloc, ?itn, ?reg, ?m, ut_split_src())) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.target       = "host";

    val pr: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_err[BuildPlan, outcome.Fail](pr)) { ret 1; }
    val bp: BuildPlan = R.unwrap_ok[BuildPlan, outcome.Fail](pr);

    if (bp.units.len != 1)                                  { ret 1; }
    if (!str_equals(bp.units.data[0].sel_artifact, "tool")) { ret 1; }
    if (!ut_path_eq(bp.units.data[0].out_path, "/r/out/host/debug/bin/tool")) { ret 1; }
    ret 0;
}

fun ut_need_src() str {
    ret "[project]\nid = \"p\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n[target.ta]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n[target.tb]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n[artifact.shader-a]\nkind = \"static\"\nentry = \"s.mach\"\nout = \"lib/shader-a.a\"\ntargets = [\"tb\"]\nlink = []\nneed = []\n[artifact.shader-b]\nkind = \"static\"\nentry = \"s.mach\"\nout = \"lib/shader-b.a\"\ntargets = [\"tb\"]\nlink = []\nneed = []\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"ta\"]\nlink = []\nneed = [\"shader-*\"]\n[artifact.app2]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app2\"\ntargets = [\"ta\"]\nlink = []\nneed = [\"shader-a\"]\n";
}

test "mach.lang.build.plan.plan:required_artifacts_precede_their_consumer_on_their_own_target" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold_src(?alloc, ?itn, ?reg, ?m, ut_need_src())) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.target       = "ta";
    rq.artifact     = "app";

    val pr: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_err[BuildPlan, outcome.Fail](pr)) { ret 1; }
    val bp: BuildPlan = R.unwrap_ok[BuildPlan, outcome.Fail](pr);

    if (bp.units.len != 3)                                    { ret 1; }
    if (!str_equals(bp.units.data[0].sel_artifact, "shader-a")) { ret 1; }
    if (!str_equals(bp.units.data[1].sel_artifact, "shader-b")) { ret 1; }
    if (!str_equals(bp.units.data[2].sel_artifact, "app"))      { ret 1; }

    if (!str_equals(bp.units.data[0].sel_target, "tb"))       { ret 1; }
    if (!str_equals(bp.units.data[1].sel_target, "tb"))       { ret 1; }
    if (!str_equals(bp.units.data[2].sel_target, "ta"))       { ret 1; }

    if (!bp.units.data[0].is_required)                        { ret 1; }
    if (!bp.units.data[1].is_required)                        { ret 1; }
    if (bp.units.data[2].is_required)                         { ret 1; }

    if (!ut_path_eq(bp.units.data[0].out_path, "/r/out/tb/debug/lib/shader-a.a")) { ret 1; }
    if (!ut_path_eq(bp.units.data[2].out_path, "/r/out/ta/debug/bin/app"))        { ret 1; }

    if (bp.units.data[2].requires.len != 2)                   { ret 1; }
    if (!str_equals(bp.units.data[2].requires.data[0], "shader-a")) { ret 1; }
    if (bp.units.data[0].requires.len != 0)                   { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.plan:a_test_build_builds_its_requirements_as_ordinary_artifacts" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold_src(?alloc, ?itn, ?reg, ?m, ut_need_src())) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.target       = "ta";
    rq.artifact     = "app";
    rq.goal         = request.GOAL_TESTS;

    val pr: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_err[BuildPlan, outcome.Fail](pr)) { ret 1; }
    val bp: BuildPlan = R.unwrap_ok[BuildPlan, outcome.Fail](pr);

    if (bp.units.len != 3)                                      { ret 1; }
    if (!str_equals(bp.units.data[0].sel_artifact, "shader-a")) { ret 1; }
    if (bp.units.data[0].goal != request.GOAL_EXECUTE)          { ret 1; }
    if (bp.units.data[1].goal != request.GOAL_EXECUTE)          { ret 1; }
    if (bp.units.data[2].goal != request.GOAL_TESTS)            { ret 1; }
    if (!ut_path_eq(bp.units.data[0].out_path, "/r/out/tb/debug/lib/shader-a.a")) { ret 1; }
    ret 0;
}

fun ut_two_bins_src(defaults: str) str {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret ""; }
    val head: str = "[project]\nid = \"p\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n[target.ta]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n[artifact.first]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/first\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val second: str = "[artifact.second]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/second\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val r: R.Result[str, str] = format.sprint(?backing, "{}{}{}{}", head, defaults, second, defaults);
    if (R.is_err[str, str](r)) { ret ""; }
    ret R.unwrap_ok[str, str](r);
}

test "mach.lang.build.plan.plan:a_test_goal_selection_error_fails_at_planning_with_the_selector_message_and_plans_nothing" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold_src(?alloc, ?itn, ?reg, ?m, ut_two_bins_src("default = true\n"))) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.target       = "ta";
    rq.goal         = request.GOAL_TESTS;

    val pr: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_ok[BuildPlan, outcome.Fail](pr)) { ret 1; }
    val f: outcome.Fail = R.unwrap_err[BuildPlan, outcome.Fail](pr);
    if (f.kind != outcome.FAIL_USER) { ret 2; }
    if (!str_contains(f.message, "have 'default = true'; exactly one is allowed")) { ret 3; }
    ret 0;
}

test "mach.lang.build.plan.plan:a_test_goal_without_a_default_takes_the_first_declared_artifact_and_says_so_in_the_request" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold_src(?alloc, ?itn, ?reg, ?m, ut_two_bins_src(""))) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.target       = "ta";
    rq.goal         = request.GOAL_TESTS;

    val pr: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_err[BuildPlan, outcome.Fail](pr)) { ret 1; }
    val bp: BuildPlan = R.unwrap_ok[BuildPlan, outcome.Fail](pr);
    if (bp.units.len != 1) { ret 2; }
    if (!str_equals(bp.request.artifact, "first") || !bp.request.artifact_by_table_order) { ret 3; }
    if (!str_equals(bp.units.data[0].sel_artifact, "first")) { ret 4; }
    ret 0;
}

test "mach.lang.build.plan.plan:a_required_artifact_is_planned_once_for_every_consumer" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold_src(?alloc, ?itn, ?reg, ?m, ut_need_src())) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.all_targets  = true;

    val pr: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_err[BuildPlan, outcome.Fail](pr)) { ret 1; }
    val bp: BuildPlan = R.unwrap_ok[BuildPlan, outcome.Fail](pr);

    if (bp.units.len != 4) { ret 1; }
    var shader_a: u32 = 0;
    var i: usize = 0;
    for (i < bp.units.len) {
        if (str_equals(bp.units.data[i].sel_artifact, "shader-a")) { shader_a = shader_a + 1; }
        i = i + 1;
    }
    if (shader_a != 1) { ret 1; }

    if (!str_equals(bp.units.data[0].sel_artifact, "shader-a")) { ret 1; }
    if (!str_equals(bp.units.data[1].sel_artifact, "shader-b")) { ret 1; }
    if (!str_equals(bp.units.data[2].sel_artifact, "app"))      { ret 1; }
    if (!str_equals(bp.units.data[3].sel_artifact, "app2"))     { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.plan:all_targets_keeps_declared_cells" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold_src(?alloc, ?itn, ?reg, ?m, ut_split_src())) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.all_targets  = true;

    val pr: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_err[BuildPlan, outcome.Fail](pr)) { ret 1; }
    val bp: BuildPlan = R.unwrap_ok[BuildPlan, outcome.Fail](pr);

    if (bp.units.len != 2)                                    { ret 1; }
    if (!str_equals(bp.units.data[0].sel_target, "host"))     { ret 1; }
    if (!str_equals(bp.units.data[0].sel_artifact, "tool"))   { ret 1; }
    if (!str_equals(bp.units.data[1].sel_target, "kern"))     { ret 1; }
    if (!str_equals(bp.units.data[1].sel_artifact, "kernel")) { ret 1; }
    if (!ut_path_eq(bp.units.data[1].out_path, "/r/out/kern/debug/bin/kernel")) { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.plan:explicit_selection_errors_enumerated_filters" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold_src(?alloc, ?itn, ?reg, ?m, ut_split_src())) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.artifact     = "kernel";
    rq.target       = "host";

    val pr: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (!R.is_err[BuildPlan, outcome.Fail](pr)) { ret 1; }
    var f: outcome.Fail = R.unwrap_err[BuildPlan, outcome.Fail](pr);
    if (!str_contains(f.message, "artifact 'kernel' does not support target 'host'")) { ret 1; }

    rq.target      = "";
    rq.all_targets = true;
    val pa: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_err[BuildPlan, outcome.Fail](pa)) { ret 1; }
    val bp: BuildPlan = R.unwrap_ok[BuildPlan, outcome.Fail](pa);
    if (bp.units.len != 1)                                { ret 1; }
    if (!str_equals(bp.units.data[0].sel_target, "kern")) { ret 1; }
    ret 0;
}

