pub def PhaseKind: u8;

pub val PH_DEP_STEPS: PhaseKind = 0;

pub val PH_LOAD:      PhaseKind = 1;

pub val PH_STEPS:     PhaseKind = 2;

pub val PH_SEMA:      PhaseKind = 3;

pub val PH_LOWER:     PhaseKind = 4;

pub val PH_CODEGEN:   PhaseKind = 5;

pub val PH_EMIT:      PhaseKind = 6;

pub val PH_LINK:      PhaseKind = 7;

pub def LinkInputKind: u8;

pub val LINK_STATIC:  LinkInputKind = 0;

pub val LINK_DYNAMIC: LinkInputKind = 1;

pub rec LinkInput {
    kind:               LinkInputKind;
    text:               str;
    library:            str;
    rpath:              str;
    include_referenced: bool;
}

pub rec BuildUnit {
    target_entry: *project.TargetEntry;
    profile:      str;
    opt_level:    u8;
    placement_policy: u32;
    goal:         request.BuildGoal;
    out_path:     str;
    obj_dir:      str;
    ir_dir:       str;
    asm_dir:      str;
    link_inputs:  Vector[LinkInput];
    phases:       Vector[PhaseKind];

    sel_target:   str;
    sel_artifact: str;
    want_lib:     bool;
    has_artifact: bool;
    is_required:  bool;
    requires:     Vector[str];
    subsystem:    of.Subsystem;
}

pub def BuildRequest: request.BuildRequest;

pub rec BuildPlan {
    request: BuildRequest;
    units:   Vector[BuildUnit];
}

pub fun plan(a: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry,
             m: *manifest.Manifest, owned_req: request.BuildRequest) R.Result[BuildPlan, outcome.Fail] {
    var bp: BuildPlan;
    bp.request = owned_req;
    bp.units   = vector.init[BuildUnit](a);
    val req: *request.BuildRequest = ?bp.request;

    if (request.test_goal(req.goal)) {
        var sel: manifest.Selection;
        sel.target       = req.target;
        sel.profile      = req.profile;
        sel.artifact     = req.artifact;
        sel.want_lib     = req.want_lib;
        sel.has_artifact = !str_empty(req.artifact);
        sel.legacy_default = false;
        val psr: R.Result[R.Void, str] = manifest.select_primary_artifact(a, itn, m, ?sel);
        if (R.is_err[R.Void, str](psr)) {
            ret R.err[BuildPlan, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](psr)));
        }
        bp.request.artifact = sel.artifact;
        bp.request.want_lib = sel.want_lib;
        bp.request.artifact_by_table_order = sel.legacy_default;
        val cr: R.Result[R.Void, outcome.Fail] = plan_cell(a, itn, reg, m, req, ?bp,
            req.target, req.artifact, req.want_lib, !str_empty(req.artifact), false);
        if (R.is_err[R.Void, outcome.Fail](cr)) {
            ret R.err[BuildPlan, outcome.Fail](R.unwrap_err[R.Void, outcome.Fail](cr));
        }
        ret R.ok[BuildPlan, outcome.Fail](bp);
    }

    val expand_targets: bool = req.all_targets && str_empty(req.target);
    var tn: u32 = 1;
    if (expand_targets) { tn = m.target_count; }
    if (tn == 0) {
        ret R.err[BuildPlan, outcome.Fail](outcome.user("mach.toml: --all-targets but no [target.*] declared"));
    }

    val expand_artifacts: bool = str_empty(req.artifact);
    var an: u32 = 1;
    if (expand_artifacts) { an = m.artifact_count; }
    if (an == 0) {
        ret R.err[BuildPlan, outcome.Fail](outcome.user("mach.toml: no [artifact.*] artifacts declared"));
    }

    var ti: u32 = 0;
    for (ti < tn) {
        var tname: str = req.target;
        if (expand_targets) {
            val to: O.Option[str] = intern.lookup(itn, m.targets[ti].name);
            if (O.is_none[str](to)) {
                ret R.err[BuildPlan, outcome.Fail](outcome.user("internal: target name not interned"));
            }
            tname = O.unwrap[str](to);
        }
        var ai: u32 = 0;
        for (ai < an) {
            var aname:    str  = req.artifact;
            var want_lib: bool = req.want_lib;
            if (expand_artifacts) {
                val ao: O.Option[str] = intern.lookup(itn, m.artifacts[ai].name);
                if (O.is_none[str](ao)) {
                    ret R.err[BuildPlan, outcome.Fail](outcome.user("internal: artifact name not interned"));
                }
                aname    = O.unwrap[str](ao);
                want_lib = m.artifacts[ai].is_lib;
            }

            if (expand_targets || expand_artifacts) {
                val supported_r: R.Result[bool, str] = cell_declared(a, itn, m, tname, aname, want_lib);
                if (R.is_err[bool, str](supported_r)) {
                    ret R.err[BuildPlan, outcome.Fail](outcome.user(R.unwrap_err[bool, str](supported_r)));
                }
                if (!R.unwrap_ok[bool, str](supported_r)) { ai = ai + 1; cnt; }
            }

            val cr: R.Result[R.Void, outcome.Fail] = plan_cell(a, itn, reg, m, req, ?bp,
                tname, aname, want_lib, true, false);
            if (R.is_err[R.Void, outcome.Fail](cr)) {
                ret R.err[BuildPlan, outcome.Fail](R.unwrap_err[R.Void, outcome.Fail](cr));
            }
            ai = ai + 1;
        }
        ti = ti + 1;
    }

    if (bp.units.len == 0) {
        ret R.err[BuildPlan, outcome.Fail](outcome.user(no_cells_msg(a, itn, m, req.target)));
    }

    if (!str_empty(req.out) && selected_unit_count(?bp) > 1) {
        ret R.err[BuildPlan, outcome.Fail](outcome.user(out_conflict_msg(a, ?bp)));
    }
    ret R.ok[BuildPlan, outcome.Fail](bp);
}

fun selected_unit_count(bp: *BuildPlan) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < bp.units.len) {
        if (!bp.units.data[i].is_required) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun unit_already_planned(bp: *BuildPlan, aname: str, tgt: intern.StrId, want_lib: bool) bool {
    var i: usize = 0;
    for (i < bp.units.len) {
        val u: *BuildUnit = ?bp.units.data[i];
        if (u.target_entry.name == tgt && u.want_lib == want_lib
            && str_equals(u.sel_artifact, aname)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun plan_cell(a: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry,
              m: *manifest.Manifest, req: *request.BuildRequest, bp: *BuildPlan,
              tname: str, aname: str, want_lib: bool, has_artifact: bool,
              is_required: bool) R.Result[R.Void, outcome.Fail] {
    var cell_req: request.BuildRequest = @req;
    if (is_required) { cell_req.goal = request.GOAL_EXECUTE; }
    val ur: R.Result[BuildUnit, outcome.Fail] = plan_unit(a, itn, reg, m, ?cell_req,
        tname, aname, want_lib, has_artifact, is_required);
    if (R.is_err[BuildUnit, outcome.Fail](ur)) {
        ret R.err[R.Void, outcome.Fail](R.unwrap_err[BuildUnit, outcome.Fail](ur));
    }
    var u: BuildUnit = R.unwrap_ok[BuildUnit, outcome.Fail](ur);
    if (unit_already_planned(bp, u.sel_artifact, u.target_entry.name, u.want_lib)) {
        ret R.ok_void[outcome.Fail]();
    }

    var ri: usize = 0;
    for (ri < u.requires.len) {
        val rname: str = u.requires.data[ri];
        val ra: *manifest.ArtifactDef = manifest.find_artifact(itn, m, rname);
        if (ra == nil) {
            ret R.err[R.Void, outcome.Fail](outcome.internal("internal: a required artifact is not declared"));
        }
        var reached: bool = false;
        var ti: u32 = 0;
        for (ti < m.target_count) {
            if (manifest.required_artifact_uses_target(itn, ra, u.target_entry.name, ?m.targets[ti])) {
                val tn: O.Option[str] = intern.lookup(itn, m.targets[ti].name);
                if (O.is_none[str](tn)) {
                    ret R.err[R.Void, outcome.Fail](outcome.internal("internal: target name not interned"));
                }
                val rr: R.Result[R.Void, outcome.Fail] = plan_cell(a, itn, reg, m, ?cell_req, bp,
                    O.unwrap[str](tn), rname, ra.is_lib, true, true);
                if (R.is_err[R.Void, outcome.Fail](rr)) { ret rr; }
                reached = true;
            }
            ti = ti + 1;
        }
        if (!reached) {
            ret R.err[R.Void, outcome.Fail](outcome.user(join_msg(a,
                "mach.toml: artifact '", u.sel_artifact, "' requires artifact '", rname,
                "', which declares no target this build can produce")));
        }
        ri = ri + 1;
    }

    val pr: R.Result[usize, str] = vector.push[BuildUnit](?bp.units, u);
    if (R.is_err[usize, str](pr)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    ret R.ok_void[outcome.Fail]();
}

fun no_cells_msg(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest, tsel: str) str {
    var tname: str = "the default target";
    if (!str_empty(tsel)) { tname = join_msg(a, "target '", tsel, "'"); }

    var nb: textbuild.TextBuilder = textbuild.tb_init(a);
    var i: u32 = 0;
    for (i < m.artifact_count) {
        val ao: O.Option[str] = intern.lookup(itn, m.artifacts[i].name);
        if (O.is_some[str](ao)) {
            if (textbuild.tb_len(?nb) > 0) { textbuild.tb_append(?nb, ", "); }
            textbuild.tb_append(?nb, O.unwrap[str](ao));
        }
        i = i + 1;
    }
    val names_r: R.Result[str, str] = textbuild.tb_finish(?nb);
    var names: str = "<message unavailable: allocation failed>";
    if (R.is_ok[str, str](names_r)) { names = R.unwrap_ok[str, str](names_r); }
    textbuild.tb_dnit(?nb);
    ret join_msg(a, "mach.toml: no artifact declares ", tname, "; declared artifacts: ", names);
}

fun out_conflict_msg(a: *A.Allocator, bp: *BuildPlan) str {
    var cb: textbuild.TextBuilder = textbuild.tb_init(a);
    var i: usize = 0;
    for (i < bp.units.len) {
        if (textbuild.tb_len(?cb) > 0) { textbuild.tb_append(?cb, ", "); }
        var tlabel: str = "the default target";
        if (!str_empty(bp.units.data[i].sel_target)) { tlabel = bp.units.data[i].sel_target; }
        textbuild.tb_append(?cb, bp.units.data[i].sel_artifact);
        textbuild.tb_append(?cb, " for ");
        textbuild.tb_append(?cb, tlabel);
        i = i + 1;
    }
    val cells_r: R.Result[str, str] = textbuild.tb_finish(?cb);
    var cells: str = "<message unavailable: allocation failed>";
    if (R.is_ok[str, str](cells_r)) { cells = R.unwrap_ok[str, str](cells_r); }
    textbuild.tb_dnit(?cb);
    ret join_msg(a, "-o names a single output but the selection resolves to several build units (",
        cells, "); narrow it with --bin/--lib and --target");
}

fun oom_plan() R.Result[BuildPlan, outcome.Fail] {
    ret R.err[BuildPlan, outcome.Fail](outcome.internal("out of memory"));
}

fun cell_declared(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest,
                  tname: str, aname: str, want_lib: bool) R.Result[bool, str] {
    var sel: manifest.Selection;
    sel.target       = tname;
    sel.profile      = "";
    sel.artifact     = aname;
    sel.want_lib     = want_lib;
    sel.has_artifact = true;
    ret manifest.cell_supported(a, itn, m, sel);
}

pub fun replan_unit(a: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry,
                    m: *manifest.Manifest, req: *request.BuildRequest,
                    prior: *BuildUnit) R.Result[BuildUnit, outcome.Fail] {
    val ur: R.Result[BuildUnit, outcome.Fail] = plan_unit(a, itn, reg, m, req,
        prior.sel_target, prior.sel_artifact, prior.want_lib, prior.has_artifact,
        prior.is_required);
    if (R.is_err[BuildUnit, outcome.Fail](ur)) { ret ur; }
    var u: BuildUnit = R.unwrap_ok[BuildUnit, outcome.Fail](ur);
    if (!unit_decisions_equal(?u, prior)) {
        ret R.err[BuildUnit, outcome.Fail](outcome.user(
            "the manifest changed after this build was planned; re-run the build"));
    }
    ret R.ok[BuildUnit, outcome.Fail](u);
}

fun unit_decisions_equal(a: *BuildUnit, b: *BuildUnit) bool {
    if (!str_equals(a.profile, b.profile))   { ret false; }
    if (a.opt_level != b.opt_level)          { ret false; }
    if (a.placement_policy != b.placement_policy) { ret false; }
    if (a.goal != b.goal)                    { ret false; }
    if (a.subsystem != b.subsystem)          { ret false; }
    if (a.want_lib != b.want_lib)            { ret false; }
    if (a.has_artifact != b.has_artifact)    { ret false; }
    if (a.is_required != b.is_required)      { ret false; }

    if (a.requires.len != b.requires.len) { ret false; }
    var ri: usize = 0;
    for (ri < a.requires.len) {
        if (!str_equals(a.requires.data[ri], b.requires.data[ri])) { ret false; }
        ri = ri + 1;
    }
    if (!str_equals(a.out_path, b.out_path)) { ret false; }
    if (!str_equals(a.obj_dir, b.obj_dir))   { ret false; }
    if (!str_equals(a.ir_dir, b.ir_dir))     { ret false; }
    if (!str_equals(a.asm_dir, b.asm_dir))   { ret false; }

    if (a.phases.len != b.phases.len) { ret false; }
    var i: usize = 0;
    for (i < a.phases.len) {
        if (a.phases.data[i] != b.phases.data[i]) { ret false; }
        i = i + 1;
    }

    if (a.link_inputs.len != b.link_inputs.len) { ret false; }
    i = 0;
    for (i < a.link_inputs.len) {
        val la: *LinkInput = ?a.link_inputs.data[i];
        val lb: *LinkInput = ?b.link_inputs.data[i];
        if (la.kind != lb.kind)                             { ret false; }
        if (la.include_referenced != lb.include_referenced) { ret false; }
        if (!str_equals(la.text, lb.text))                  { ret false; }
        if (!str_equals(la.library, lb.library))            { ret false; }
        if (!str_equals(la.rpath, lb.rpath))                { ret false; }
        i = i + 1;
    }
    ret true;
}

fun plan_unit(a: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry,
              m: *manifest.Manifest, req: *request.BuildRequest,
              tname: str, aname: str, want_lib: bool, has_artifact: bool,
              is_required: bool) R.Result[BuildUnit, outcome.Fail] {
    var sel: manifest.Selection;
    sel.target       = tname;
    sel.profile      = req.profile;
    sel.artifact     = aname;
    sel.want_lib     = want_lib;
    sel.has_artifact = has_artifact;

    val ur: R.Result[manifest.BuildUnit, str] = manifest.resolve_build_unit(a, itn, m, sel);
    if (R.is_err[manifest.BuildUnit, str](ur)) {
        ret R.err[BuildUnit, outcome.Fail](outcome.user(R.unwrap_err[manifest.BuildUnit, str](ur)));
    }
    val bu: manifest.BuildUnit = R.unwrap_ok[manifest.BuildUnit, str](ur);

    val os_opt: O.Option[str] = intern.lookup(itn, bu.target.os);
    if (O.is_none[str](os_opt)) { ret R.err[BuildUnit, outcome.Fail](outcome.user("target os name not interned")); }
    val os_s: str = O.unwrap[str](os_opt);
    val isa_opt: O.Option[str] = intern.lookup(itn, bu.target.isa);
    if (O.is_none[str](isa_opt)) { ret R.err[BuildUnit, outcome.Fail](outcome.user("target isa name not interned")); }
    val isa_s: str = O.unwrap[str](isa_opt);
    val abi_opt: O.Option[str] = intern.lookup(itn, bu.target.abi);
    if (O.is_none[str](abi_opt)) { ret R.err[BuildUnit, outcome.Fail](outcome.user("target abi name not interned")); }
    val abi_s: str = O.unwrap[str](abi_opt);
    var of_s: str = "";
    val of_opt: O.Option[str] = intern.lookup(itn, bu.target.of);
    if (O.is_some[str](of_opt)) { of_s = O.unwrap[str](of_opt); }

    val tr: R.Result[target.Target, str] = target.select_of(reg, isa_s, os_s, abi_s, of_s);
    if (R.is_err[target.Target, str](tr)) {
        ret R.err[BuildUnit, outcome.Fail](outcome.user(R.unwrap_err[target.Target, str](tr)));
    }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);

    var u: BuildUnit;
    u.goal         = req.goal;
    u.opt_level    = req.opt;
    u.placement_policy = req.placement_policy;
    u.sel_target   = tname;
    u.sel_artifact = aname;
    u.want_lib     = want_lib;
    u.has_artifact = has_artifact;
    u.is_required  = is_required;

    val rq_r: R.Result[R.Void, outcome.Fail] = collect_requires(a, itn, m, req, ?bu, tname, ?u);
    if (R.is_err[R.Void, outcome.Fail](rq_r)) {
        ret R.err[BuildUnit, outcome.Fail](R.unwrap_err[R.Void, outcome.Fail](rq_r));
    }

    u.subsystem = of.SUBSYSTEM_CONSOLE;
    if (bu.artifact != nil) { u.subsystem = bu.artifact.subsystem; }
    val flag_subsystem: O.Option[of.Subsystem] = request.subsystem_from_flag(req.subsystem_flag);
    if (O.is_some[of.Subsystem](flag_subsystem)) { u.subsystem = O.unwrap[of.Subsystem](flag_subsystem); }

    val pn_opt: O.Option[str] = intern.lookup(itn, bu.profile_name);
    if (O.is_none[str](pn_opt)) { ret R.err[BuildUnit, outcome.Fail](outcome.user("internal: profile name not interned")); }
    u.profile = O.unwrap[str](pn_opt);

    val ter: R.Result[*project.TargetEntry, str] = A.allocate[project.TargetEntry](a, 1::usize);
    if (R.is_err[*project.TargetEntry, str](ter)) { ret oom_unit(); }
    val te: *project.TargetEntry = R.unwrap_ok[*project.TargetEntry, str](ter);
    te.name       = bu.target_name;
    te.os_name    = bu.target.os;
    te.isa_name   = bu.target.isa;
    te.abi_name   = bu.target.abi;
    te.of_name    = bu.target.of;
    te.entrypoint = bu.entry;
    te.mode       = project.MODE_EXECUTABLE;
    if (bu.is_lib) { te.mode = project.MODE_LIBRARY; }
    te.lib_kind   = bu.kind;
    te.opt        = project.map_opt(bu.opt);
    te.libs       = bu.libs;
    te.lib_count  = bu.lib_count;
    u.target_entry = te;

    val root: str = req.project_root;

    val ob_r: R.Result[str, outcome.Fail] = join_template(a, itn, root, bu.obj_root, "project obj output dir: ");
    if (R.is_err[str, outcome.Fail](ob_r)) { ret R.err[BuildUnit, outcome.Fail](R.unwrap_err[str, outcome.Fail](ob_r)); }
    u.obj_dir = R.unwrap_ok[str, outcome.Fail](ob_r);

    u.ir_dir = "";
    if (req.emit_ir) {
        val ib_r: R.Result[str, outcome.Fail] = join_template(a, itn, root, bu.ir_root, "project ir output dir: ");
        if (R.is_err[str, outcome.Fail](ib_r)) { ret R.err[BuildUnit, outcome.Fail](R.unwrap_err[str, outcome.Fail](ib_r)); }
        u.ir_dir = R.unwrap_ok[str, outcome.Fail](ib_r);
    }
    u.asm_dir = "";
    if (req.emit_asm) {
        val ab_r: R.Result[str, outcome.Fail] = join_template(a, itn, root, bu.asm_root, "project asm output dir: ");
        if (R.is_err[str, outcome.Fail](ab_r)) { ret R.err[BuildUnit, outcome.Fail](R.unwrap_err[str, outcome.Fail](ab_r)); }
        u.asm_dir = R.unwrap_ok[str, outcome.Fail](ab_r);
    }

    val op_r: R.Result[str, outcome.Fail] = unit_out_path(a, itn, m, req, ?bu, ?tgt, u.obj_dir, is_required);
    if (R.is_err[str, outcome.Fail](op_r)) { ret R.err[BuildUnit, outcome.Fail](R.unwrap_err[str, outcome.Fail](op_r)); }
    u.out_path = R.unwrap_ok[str, outcome.Fail](op_r);

    u.link_inputs = vector.init[LinkInput](a);
    var ti: usize = 0;
    for (ti < req.link_tokens.len) {
        val token: str = req.link_tokens.data[ti].text;
        val lr: R.Result[LinkInput, outcome.Fail] =
            resolve_token(a, ?tgt, ?req.lib_dirs, root, token::*u8);
        if (R.is_err[LinkInput, outcome.Fail](lr)) {
            ret R.err[BuildUnit, outcome.Fail](R.unwrap_err[LinkInput, outcome.Fail](lr));
        }
        var input: LinkInput = R.unwrap_ok[LinkInput, outcome.Fail](lr);
        if (!request.is_object_path(token::*u8) && !is_shared_path(token::*u8)
            && !is_dll_path(token::*u8) && !is_dylib_path(token::*u8)) {
            input.library = token;
        }
        val pr: R.Result[usize, str] = vector.push[LinkInput](?u.link_inputs, input);
        if (R.is_err[usize, str](pr)) { ret oom_unit(); }
        ti = ti + 1;
    }

    val ph_r: R.Result[R.Void, outcome.Fail] = derive_phases(a, itn, m, req, ?bu, ?tgt, ?u);
    if (R.is_err[R.Void, outcome.Fail](ph_r)) {
        ret R.err[BuildUnit, outcome.Fail](R.unwrap_err[R.Void, outcome.Fail](ph_r));
    }
    ret R.ok[BuildUnit, outcome.Fail](u);
}

fun collect_requires(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest,
                     req: *request.BuildRequest, bu: *manifest.BuildUnit,
                     tname: str, u: *BuildUnit) R.Result[R.Void, outcome.Fail] {
    u.requires = vector.init[str](a);

    val whole_project: bool = request.test_goal(req.goal);
    val consumer: *manifest.ArtifactDef = bu.artifact;
    if (consumer == nil && !whole_project) { ret R.ok_void[outcome.Fail](); }

    var j: u32 = 0;
    for (j < m.artifact_count) {
        if (requires_artifact(itn, m, consumer, ?m.artifacts[j], whole_project)) {
            val no: O.Option[str] = intern.lookup(itn, m.artifacts[j].name);
            if (O.is_none[str](no)) {
                ret R.err[R.Void, outcome.Fail](outcome.internal("internal: artifact name not interned"));
            }
            val pr: R.Result[usize, str] = vector.push[str](?u.requires, O.unwrap[str](no));
            if (R.is_err[usize, str](pr)) {
                ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory"));
            }
        }
        j = j + 1;
    }
    ret R.ok_void[outcome.Fail]();
}

fun requires_artifact(itn: *intern.Interner, m: *manifest.Manifest, consumer: *manifest.ArtifactDef,
                      ra: *manifest.ArtifactDef, whole_project: bool) bool {
    if (whole_project) { ret manifest.artifact_required_by_any(itn, m, ra); }
    if (consumer == nil) { ret false; }
    ret manifest.artifact_needs_artifact(itn, consumer, ra);
}

fun oom_unit() R.Result[BuildUnit, outcome.Fail] {
    ret R.err[BuildUnit, outcome.Fail](outcome.internal("out of memory"));
}

fun join_template(a: *A.Allocator, itn: *intern.Interner, root: str, dir_id: intern.StrId, what: str) R.Result[str, outcome.Fail] {
    val opt_tmpl: O.Option[str] = intern.lookup(itn, dir_id);
    if (O.is_none[str](opt_tmpl)) {
        ret R.err[str, outcome.Fail](outcome.internal(join_msg(a, what, "template not interned", "")));
    }
    val jr: R.Result[str, str] = path.join(a, root, O.unwrap[str](opt_tmpl));
    if (R.is_err[str, str](jr)) {
        ret R.err[str, outcome.Fail](outcome.internal(join_msg(a, what, R.unwrap_err[str, str](jr), "")));
    }
    ret R.ok[str, outcome.Fail](R.unwrap_ok[str, str](jr));
}

pub fun finished_modules(tgt: *target.Target) bool {
    ret tgt.of != nil && tgt.of.object_is_artifact;
}

fun unit_out_path(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest,
                  req: *request.BuildRequest, bu: *manifest.BuildUnit,
                  tgt: *target.Target, obj_dir: str, is_required: bool) R.Result[str, outcome.Fail] {
    if (req.goal == request.GOAL_OBJECTS)   { ret R.ok[str, outcome.Fail](obj_dir); }
    if (req.goal == request.GOAL_TEST_LIST) { ret R.ok[str, outcome.Fail](""); }
    if (req.goal == request.GOAL_EXECUTE && finished_modules(tgt)) {
        ret R.ok[str, outcome.Fail](obj_dir);
    }

    if (req.goal == request.GOAL_TESTS) {
        var name: str = "";
        if (bu.artifact != nil) {
            val an_opt: O.Option[str] = intern.lookup(itn, bu.artifact.name);
            if (O.is_some[str](an_opt)) { name = O.unwrap[str](an_opt); }
        }
        if (str_empty(name)) {
            val id_opt: O.Option[str] = intern.lookup(itn, m.id);
            if (O.is_some[str](id_opt)) { name = O.unwrap[str](id_opt); }
        }
        if (str_empty(name)) { name = "tests"; }

        val tmpl_opt: O.Option[str] = intern.lookup(itn, bu.test_root);
        if (O.is_none[str](tmpl_opt)) { ret test_exe_fail(); }
        val rel_r: R.Result[str, str] = str_replace(a, O.unwrap[str](tmpl_opt), "{name}", name);
        if (R.is_err[str, str](rel_r)) { ret test_exe_fail(); }
        val full_r: R.Result[str, str] = path.join(a, req.project_root, R.unwrap_ok[str, str](rel_r));
        if (R.is_err[str, str](full_r)) { ret test_exe_fail(); }
        ret R.ok[str, outcome.Fail](R.unwrap_ok[str, str](full_r));
    }

    if (!str_empty(req.out) && !is_required) {
        if (!manifest.is_project_path(req.out)) {
            ret R.err[str, outcome.Fail](outcome.user("-o must name a canonical path inside the project root"));
        }
        val op_r: R.Result[str, str] = path.resolve(a, req.project_root, req.out);
        if (R.is_err[str, str](op_r)) { ret R.err[str, outcome.Fail](outcome.internal("out of memory")); }
        ret R.ok[str, outcome.Fail](R.unwrap_ok[str, str](op_r));
    }
    val bin_opt: O.Option[str] = intern.lookup(itn, bu.bin_path);
    if (O.is_none[str](bin_opt) || str_empty(O.unwrap[str](bin_opt))) {
        ret R.err[str, outcome.Fail](outcome.user("selected artifact has no output path; set the `out` template in mach.toml"));
    }
    val op_r: R.Result[str, str] = path.join(a, req.project_root, O.unwrap[str](bin_opt));
    if (R.is_err[str, str](op_r)) { ret R.err[str, outcome.Fail](outcome.internal("out of memory")); }
    ret R.ok[str, outcome.Fail](R.unwrap_ok[str, str](op_r));
}

fun test_exe_fail() R.Result[str, outcome.Fail] {
    ret R.err[str, outcome.Fail](outcome.internal("failed to resolve the test executable path; check the `tests` template in mach.toml"));
}

fun derive_phases(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest,
                  req: *request.BuildRequest, bu: *manifest.BuildUnit,
                  tgt: *target.Target, u: *BuildUnit) R.Result[R.Void, outcome.Fail] {
    u.phases = vector.init[PhaseKind](a);

    val demanded_r: R.Result[bool, outcome.Fail] = steps_demanded(a, itn, m, req, bu);
    if (R.is_err[bool, outcome.Fail](demanded_r)) { ret R.void_of[bool, outcome.Fail](demanded_r); }
    if (m.dep_count > 0) {
        val r1: R.Result[R.Void, outcome.Fail] = push_phase(u, PH_DEP_STEPS);
        if (R.is_err[R.Void, outcome.Fail](r1)) { ret r1; }
    }
    if (R.unwrap_ok[bool, outcome.Fail](demanded_r)) {
        val r2: R.Result[R.Void, outcome.Fail] = push_phase(u, PH_STEPS);
        if (R.is_err[R.Void, outcome.Fail](r2)) { ret r2; }
    }

    val r3: R.Result[R.Void, outcome.Fail] = push_phase(u, PH_LOAD);
    if (R.is_err[R.Void, outcome.Fail](r3)) { ret r3; }
    val r4: R.Result[R.Void, outcome.Fail] = push_phase(u, PH_SEMA);
    if (R.is_err[R.Void, outcome.Fail](r4)) { ret r4; }
    val r5: R.Result[R.Void, outcome.Fail] = push_phase(u, PH_LOWER);
    if (R.is_err[R.Void, outcome.Fail](r5)) { ret r5; }
    val r6: R.Result[R.Void, outcome.Fail] = push_phase(u, PH_CODEGEN);
    if (R.is_err[R.Void, outcome.Fail](r6)) { ret r6; }

    val flat: bool = tgt.of != nil && tgt.of.produces_image;
    var objects: bool = false;
    if (req.goal == request.GOAL_EXECUTE && !flat) { objects = true; }
    if (req.goal == request.GOAL_OBJECTS)          { objects = true; }
    if (req.goal == request.GOAL_TESTS)            { objects = true; }
    if (objects || req.emit_ir || req.emit_asm) {
        val r7: R.Result[R.Void, outcome.Fail] = push_phase(u, PH_EMIT);
        if (R.is_err[R.Void, outcome.Fail](r7)) { ret r7; }
    }
    if ((req.goal == request.GOAL_EXECUTE && !finished_modules(tgt)) || req.goal == request.GOAL_TESTS) {
        val r8: R.Result[R.Void, outcome.Fail] = push_phase(u, PH_LINK);
        if (R.is_err[R.Void, outcome.Fail](r8)) { ret r8; }
    }
    ret R.ok_void[outcome.Fail]();
}

fun push_phase(u: *BuildUnit, k: PhaseKind) R.Result[R.Void, outcome.Fail] {
    val pr: R.Result[usize, str] = vector.push[PhaseKind](?u.phases, k);
    if (R.is_err[usize, str](pr)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    ret R.ok_void[outcome.Fail]();
}

fun steps_demanded(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest,
                   req: *request.BuildRequest, bu: *manifest.BuildUnit) R.Result[bool, outcome.Fail] {
    if (m.step_count == 0) { ret R.ok[bool, outcome.Fail](false); }

    val pn_opt: O.Option[str] = intern.lookup(itn, bu.profile_name);
    if (O.is_none[str](pn_opt)) { ret R.ok[bool, outcome.Fail](false); }
    var v: manifest.TmplVars = manifest.tmpl_vars_of(itn, bu.target, O.unwrap[str](pn_opt));

    val ot_opt: O.Option[str] = intern.lookup(itn, m.out_tmpl);
    if (O.is_none[str](ot_opt)) { ret R.ok[bool, outcome.Fail](false); }
    val po_r: R.Result[str, str] = manifest.expand_project_path(a, O.unwrap[str](ot_opt), "", ?v, "[project].out");
    if (R.is_err[str, str](po_r)) { ret R.err[bool, outcome.Fail](outcome.user(R.unwrap_err[str, str](po_r))); }
    val proj_out: str = R.unwrap_ok[str, str](po_r);

    var names:  *intern.StrId = nil;
    var ncount: u32           = 0;
    var owned:  bool          = false;
    if (request.test_goal(req.goal) && m.artifact_count > 0) {
        val ar: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](a, m.artifact_count::usize);
        if (R.is_err[*intern.StrId, str](ar)) { ret R.err[bool, outcome.Fail](outcome.internal("out of memory")); }
        names = R.unwrap_ok[*intern.StrId, str](ar);
        owned = true;
        var i: u32 = 0;
        for (i < m.artifact_count) { names[i] = m.artifacts[i].name; i = i + 1; }
        ncount = m.artifact_count;
    }
    or {
        if (bu.artifact == nil) { ret R.ok[bool, outcome.Fail](false); }
        names  = ?bu.artifact.name;
        ncount = 1;
    }

    var order: *u32 = nil;
    var count: u32  = 0;
    val r: R.Result[R.Void, str] = manifest.plan_steps(a, itn, m, names, ncount, bu.target, proj_out, ?v, ?order, ?count);
    if (owned) { A.deallocate[intern.StrId](a, names, m.artifact_count::usize); }
    str_free(a, proj_out);
    if (R.is_err[R.Void, str](r)) {
        ret R.err[bool, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](r)));
    }
    if (order != nil && count > 0) { A.deallocate[u32](a, order, count::usize); }
    ret R.ok[bool, outcome.Fail](count > 0);
}

pub fun resolve_token(a: *A.Allocator, tgt: *target.Target, dirs: *Vector[str],
                      root: str, tok: *u8) R.Result[LinkInput, outcome.Fail] {
    if (is_dll_path(tok)) {
        if (!str_equals(tgt.of.shared_input_ext, ".dll")) {
            ret R.err[LinkInput, outcome.Fail](outcome.user(join_msg(a, "'", tok::str, "' is a Windows DLL; .dll inputs require a PE/COFF target")));
        }
        var actual: *u8 = tok;
        var rooted: str = "";
        var exists: bool = fs.is_file(tok);
        if (!exists && tok[0] != '/') {
            val cand_r: R.Result[str, str] = path.join(a, root, tok::str);
            if (R.is_ok[str, str](cand_r)) {
                rooted = R.unwrap_ok[str, str](cand_r);
                if (fs.is_file(rooted)) {
                    actual = rooted::*u8;
                    exists = true;
                }
            }
        }
        if (exists) {
            val res_read: R.Result[Vector[u8], str] = fs.read_bytes(a, actual);
            if (R.is_err[Vector[u8], str](res_read)) {
                ret R.err[LinkInput, outcome.Fail](outcome.user(join_msg(a, "cannot read link input '", actual::str, "'")));
            }
            var b: Vector[u8] = R.unwrap_ok[Vector[u8], str](res_read);
            val good: bool = coff.looks_like_dll(b.data, b.len, coff.machine_for_arch(tgt.arch_id));
            vector.dnit[u8](?b);
            if (!good) {
                ret R.err[LinkInput, outcome.Fail](outcome.user(join_msg(a, "'", actual::str,
                    "' is not a loadable PE DLL for the selected architecture")));
            }
        }
        ret dyn_copy(a, dll_basename(tok));
    }

    if (is_dylib_path(tok)) {
        if (!str_equals(tgt.of.shared_input_ext, ".dylib")) {
            ret R.err[LinkInput, outcome.Fail](outcome.user(join_msg(a, "'", tok::str, "' is a Mach-O dylib; .dylib inputs require a Mach-O target")));
        }
        var actual: *u8 = tok;
        var rooted: str = "";
        var exists: bool = fs.is_file(tok);
        if (!exists && tok[0] != '/') {
            val cand_r: R.Result[str, str] = path.join(a, root, tok::str);
            if (R.is_ok[str, str](cand_r)) {
                rooted = R.unwrap_ok[str, str](cand_r);
                if (fs.is_file(rooted)) {
                    actual = rooted::*u8;
                    exists = true;
                }
            }
        }
        if (exists) {
            var install_name: [4096]u8;
            if (read_dylib_install_name(a, actual, tgt.arch_id, ?install_name[0], 4096)) {
                ret dylib_copy(a, actual, ?install_name[0]);
            }
            ret R.err[LinkInput, outcome.Fail](outcome.user(join_msg(a, "'", actual::str,
                "' is not a loadable Mach-O dylib for the selected architecture")));
        }
        if (str_starts_with(tok::str, "@rpath/")) {
            ret R.err[LinkInput, outcome.Fail](outcome.user(
                "an @rpath dylib input must resolve to an existing file so its runtime search path can be retained"));
        }
        ret dyn_copy(a, tok);
    }

    if (is_shared_path(tok) && !str_equals(tgt.of.shared_input_ext, ".so")) {
        ret R.err[LinkInput, outcome.Fail](outcome.user(join_msg(a, "'", tok::str,
            "' is an ELF shared object; .so inputs require an ELF target")));
    }

    var buf: [4096]u8;
    var found: bool = resolve_input_into(tok, dirs, ?buf[0], 4096,
        str_equals(tgt.of.shared_input_ext, ".dll"));

    if (!found && (request.is_object_path(tok) || is_shared_path(tok)) && tok[0] != '/') {
        val cand_r: R.Result[str, str] = path.join(a, root, tok::str);
        if (R.is_ok[str, str](cand_r)) {
            val cand: str = R.unwrap_ok[str, str](cand_r);
            if (fs.is_file(cand) && str_len(cand) + 1 <= 4096) {
                memory.raw_copy((?buf[0])::ptr, cand::ptr, str_len(cand) + 1);
                found = true;
            }
        }
    }

    if (found && is_shared_path(?buf[0])) {
        var sname: [4096]u8;
        if (read_so_soname(a, ?buf[0], tgt.arch_id, ?sname[0], 4096)) {
            ret dyn_copy(a, ?sname[0]);
        }
        ret R.err[LinkInput, outcome.Fail](outcome.user(join_msg(a, "'", (?buf[0])::str,
            "' is not a loadable ELF shared object for the selected architecture")));
    }

    if (!found && !request.is_object_path(tok) && !is_shared_path(tok)) {
        var sname: [4096]u8;
        var rpath: [4096]u8;
        rpath[0] = 0;
        if (resolve_shared_into(a, tgt, dirs, tok, ?sname[0], 4096,
                                ?rpath[0], 4096)) {
            ret dyn_copy_with_rpath(a, ?sname[0], ?rpath[0]);
        }
    }

    if (!found) {
        ret R.err[LinkInput, outcome.Fail](outcome.user(join_msg(a, "cannot find link input '", tok::str, "'")));
    }

    val res_static: R.Result[Vector[u8], str] = fs.read_bytes(a, ?buf[0]);
    if (R.is_err[Vector[u8], str](res_static)) {
        ret R.err[LinkInput, outcome.Fail](outcome.user(join_msg(a, "cannot read link input '", (?buf[0])::str, "'")));
    }
    var sb: Vector[u8] = R.unwrap_ok[Vector[u8], str](res_static);
    val sb_ok: bool = ar.is_archive(sb.data, sb.len) || object_matches_target(sb.data, sb.len, tgt);
    vector.dnit[u8](?sb);
    if (!sb_ok) {
        ret R.err[LinkInput, outcome.Fail](outcome.user(join_msg(a, "'", (?buf[0])::str,
            "' is not a valid object or archive for the selected target")));
    }

    val dup_r: R.Result[str, str] = str_copy(a, ?buf[0]);
    if (R.is_err[str, str](dup_r)) { ret R.err[LinkInput, outcome.Fail](outcome.internal("out of memory")); }
    var li: LinkInput;
    li.kind = LINK_STATIC;
    li.text = R.unwrap_ok[str, str](dup_r);
    li.library = "";
    li.rpath = "";
    ret R.ok[LinkInput, outcome.Fail](li);
}

pub fun resolve_requirement(a: *A.Allocator, itn: *intern.Interner, tgt: *target.Target,
                            dirs: *Vector[str], root: str,
                            req: *manifest.LinkRequirement) R.Result[LinkInput, outcome.Fail] {
    val text_opt: O.Option[str] = intern.lookup(itn, req.text);
    if (O.is_none[str](text_opt)) {
        ret R.err[LinkInput, outcome.Fail](outcome.internal("link requirement text not interned"));
    }
    val text: str = O.unwrap[str](text_opt);
    val library_opt: O.Option[str] = intern.lookup(itn, req.library);
    if (O.is_none[str](library_opt)) {
        ret R.err[LinkInput, outcome.Fail](outcome.internal("link requirement library not interned"));
    }
    val library: str = O.unwrap[str](library_opt);
    if (req.source == manifest.LINK_FRAMEWORK) {
        val fr: R.Result[LinkInput, outcome.Fail] =
            resolve_framework(a, tgt, text::*u8);
        if (R.is_err[LinkInput, outcome.Fail](fr)) { ret fr; }
        var fi: LinkInput = R.unwrap_ok[LinkInput, outcome.Fail](fr);
        fi.library = library;
        fi.include_referenced = req.include_referenced;
        ret R.ok[LinkInput, outcome.Fail](fi);
    }
    var r: R.Result[LinkInput, outcome.Fail] =
        resolve_token(a, tgt, dirs, root, text::*u8);
    if (R.is_err[LinkInput, outcome.Fail](r)) { ret r; }
    var li: LinkInput = R.unwrap_ok[LinkInput, outcome.Fail](r);
    li.library = library;
    li.include_referenced = req.include_referenced;
    ret R.ok[LinkInput, outcome.Fail](li);
}

fun resolve_framework(a: *A.Allocator, tgt: *target.Target,
                      name: *u8) R.Result[LinkInput, outcome.Fail] {
    if (tgt.os == nil || !str_equals(tgt.os.name, "darwin")
        || !str_equals(tgt.of.shared_input_ext, ".dylib")) {
        ret R.err[LinkInput, outcome.Fail](outcome.user(
            join_msg(a, "framework link input '", name::str, "' requires a Darwin Mach-O target")));
    }
    val install_name: str = join_msg(a, "/System/Library/Frameworks/", name::str,
        ".framework/", name::str);
    var li: LinkInput;
    li.kind    = LINK_DYNAMIC;
    li.text    = install_name;
    li.library = "";
    li.rpath   = "";
    ret R.ok[LinkInput, outcome.Fail](li);
}

fun dyn_copy(a: *A.Allocator, name: *u8) R.Result[LinkInput, outcome.Fail] {
    ret dyn_copy_with_rpath(a, name, ""::*u8);
}

fun dyn_copy_with_rpath(a: *A.Allocator, name: *u8,
                        rpath: *u8) R.Result[LinkInput, outcome.Fail] {
    val dup_r: R.Result[str, str] = str_copy(a, name);
    if (R.is_err[str, str](dup_r)) { ret R.err[LinkInput, outcome.Fail](outcome.internal("out of memory")); }
    var run_path: str = "";
    if (rpath != nil && !str_empty(rpath::str)) {
        val rp_r: R.Result[str, str] = str_copy(a, rpath);
        if (R.is_err[str, str](rp_r)) { ret R.err[LinkInput, outcome.Fail](outcome.internal("out of memory")); }
        run_path = R.unwrap_ok[str, str](rp_r);
    }
    var li: LinkInput;
    li.kind    = LINK_DYNAMIC;
    li.text    = R.unwrap_ok[str, str](dup_r);
    li.library = "";
    li.rpath   = run_path;
    ret R.ok[LinkInput, outcome.Fail](li);
}

fun dylib_copy(a: *A.Allocator, actual: *u8,
               install_name: *u8) R.Result[LinkInput, outcome.Fail] {
    if (!str_starts_with(install_name::str, "@rpath/")) {
        ret dyn_copy(a, install_name);
    }
    val rp_r: R.Result[str, str] = dylib_rpath(a, actual, install_name);
    if (R.is_err[str, str](rp_r)) {
        ret R.err[LinkInput, outcome.Fail](outcome.user(R.unwrap_err[str, str](rp_r)));
    }
    ret dyn_copy_with_rpath(a, install_name, R.unwrap_ok[str, str](rp_r)::*u8);
}

fun object_matches_target(buf: *u8, len: usize, tgt: *target.Target) bool {
    if (tgt == nil || tgt.of == nil || buf == nil) { ret false; }
    if (tgt.of.id == of.OF_ELF) {
        if (len < 20 || buf[0] != 0x7F || buf[1] != 0x45 || buf[2] != 0x4C || buf[3] != 0x46) { ret false; }
        val want: u16 = elf.machine_for_arch(tgt.arch_id);
        ret want != 0 && bin.read_u16_le(buf, 18) == want;
    }
    if (tgt.of.id == of.OF_MACHO) {
        if (len < 8 || bin.read_u32_le(buf, 0) != 0xFEEDFACF) { ret false; }
        val want: u32 = macho.machine_for_arch(tgt.arch_id);
        ret want != 0 && bin.read_u32_le(buf, 4) == want;
    }
    if (tgt.of.id == of.OF_COFF) {
        if (len < 4) { ret false; }
        val want: u16 = coff.machine_for_arch(tgt.arch_id);
        if (want == 0) { ret false; }
        val sig1: u16 = bin.read_u16_le(buf, 0);
        if (sig1 == 0) { ret len >= 8 && bin.read_u16_le(buf, 6) == want; }
        ret sig1 == want;
    }
    ret false;
}

pub fun join_msg(al: *A.Allocator, va: ...) str {
    val r: R.Result[str, str] = str_join(al, va...);
    if (R.is_err[str, str](r)) { ret "<message unavailable: allocation failed>"; }
    ret R.unwrap_ok[str, str](r);
}

fun resolve_input_into(tok: *u8, dirs: *Vector[str], buf: *u8, cap: usize,
                       coff_names: bool) bool {
    if (tok == nil || str_empty(tok::str)) { ret false; }

    if (request.is_object_path(tok)) {
        val n: usize = str_len(tok::str);
        if (n + 1 > cap) { ret false; }
        var i: usize = 0;
        for (i < n) { buf[i] = tok[i]; i = i + 1; }
        buf[n] = 0;
        ret fs.is_file(buf);
    }

    var i: usize = 0;
    for (i < dirs.len) {
        if (try_named_object(dirs.data[i]::*u8, tok, buf, cap, coff_names)) { ret true; }
        i = i + 1;
    }
    if (try_named_object(nil, tok, buf, cap, coff_names)) { ret true; }
    ret false;
}

fun try_named_object(dir: *u8, name: *u8, buf: *u8, cap: usize,
                     coff_names: bool) bool {
    if (write_named_candidate(dir, "lib", name, "o", buf, cap) && fs.is_file(buf)) { ret true; }
    if (write_named_candidate(dir, "", name, "o", buf, cap) && fs.is_file(buf))    { ret true; }
    if (coff_names && write_named_candidate(dir, "lib", name, "obj", buf, cap) && fs.is_file(buf)) { ret true; }
    if (coff_names && write_named_candidate(dir, "", name, "obj", buf, cap) && fs.is_file(buf))    { ret true; }
    if (write_named_candidate(dir, "lib", name, "a", buf, cap) && fs.is_file(buf)) { ret true; }
    if (write_named_candidate(dir, "", name, "a", buf, cap) && fs.is_file(buf))    { ret true; }
    if (coff_names && write_named_candidate(dir, "lib", name, "lib", buf, cap) && fs.is_file(buf)) { ret true; }
    if (coff_names && write_named_candidate(dir, "", name, "lib", buf, cap) && fs.is_file(buf))    { ret true; }
    ret false;
}

fun write_named_candidate(dir: *u8, prefix: *u8, name: *u8, ext: *u8, buf: *u8, cap: usize) bool {
    val dl: usize = str_len(dir);
    val pl: usize = str_len(prefix::str);
    val nl: usize = str_len(name::str);
    val el: usize = str_len(ext::str);
    var need: usize = dl;
    if (dl > 0) { need = need + 1; }
    need = need + pl + nl + 1 + el + 1;
    if (need > cap) { ret false; }

    var k: usize = 0;
    var i: usize = 0;
    if (dir != nil) {
        for (i < dl) { buf[k] = dir[i]; k = k + 1; i = i + 1; }
        if (k > 0 && buf[k - 1] != '/') { buf[k] = '/'; k = k + 1; }
    }
    i = 0;
    for (i < pl) { buf[k] = prefix[i]; k = k + 1; i = i + 1; }
    i = 0;
    for (i < nl) { buf[k] = name[i]; k = k + 1; i = i + 1; }
    buf[k] = '.'; k = k + 1;
    i = 0;
    for (i < el) { buf[k] = ext[i]; k = k + 1; i = i + 1; }
    buf[k] = 0;
    ret true;
}

fun read_so_soname(a: *A.Allocator, so_path: *u8, arch_id: u32, out: *u8, cap: usize) bool {
    val res_read: R.Result[Vector[u8], str] = fs.read_bytes(a, so_path);
    if (R.is_err[Vector[u8], str](res_read)) { ret false; }
    var b: Vector[u8] = R.unwrap_ok[Vector[u8], str](res_read);
    var ok: bool = false;
    val want_machine: u16 = elf.machine_for_arch(arch_id);
    if (want_machine != 0 && b.len >= 64 && b.data[0] == 0x7F && b.data[1] == 0x45 && b.data[2] == 0x4C
        && b.data[3] == 0x46 && b.data[4] == 2 && b.data[5] == 1 && b.data[6] == 1
        && bin.read_u16_le(b.data, 16) == 3
        && bin.read_u16_le(b.data, 18) == want_machine) {
        if (!extract_soname(b.data, b.len, out, cap)) {
            val base: str   = path.filename(so_path::str);
            val bl:   usize = str_len(base);
            if (bl + 1 <= cap) { memory.raw_copy(out::ptr, base::ptr, bl + 1); }
        }
        ok = true;
    }
    vector.dnit[u8](?b);
    ret ok;
}

fun extract_soname(buf: *u8, len: usize, out: *u8, cap: usize) bool {
    val e_shoff:     usize = bin.read_u64_le(buf, 40)::usize;
    val e_shentsize: usize = bin.read_u16_le(buf, 58)::usize;
    val e_shnum:     usize = bin.read_u16_le(buf, 60)::usize;
    if (e_shoff == 0 || e_shnum == 0) { ret false; }

    var dyn_off:    usize = 0;
    var dyn_size:   usize = 0;
    var dynstr_off: usize = 0;
    var sh: usize = 0;
    for (sh < e_shnum) {
        val so: usize = e_shoff + sh * e_shentsize;
        if (so + 64 > len) { ret false; }
        if (bin.read_u32_le(buf, so + 4) == 6) {
            dyn_off  = bin.read_u64_le(buf, so + 24)::usize;
            dyn_size = bin.read_u64_le(buf, so + 32)::usize;
            val link: usize = bin.read_u32_le(buf, so + 40)::usize;
            if (link < e_shnum) {
                val lo: usize = e_shoff + link * e_shentsize;
                if (lo + 64 <= len) { dynstr_off = bin.read_u64_le(buf, lo + 24)::usize; }
            }
        }
        sh = sh + 1;
    }
    if (dyn_off == 0 || dynstr_off == 0) { ret false; }

    var d: usize = 0;
    for (d + 16 <= dyn_size) {
        val eo: usize = dyn_off + d;
        if (eo + 16 > len) { ret false; }
        val tag: u64 = bin.read_u64_le(buf, eo);
        if (tag == 0) { ret false; }
        if (tag == 14) {
            val str_at: usize = dynstr_off + bin.read_u64_le(buf, eo + 8)::usize;
            var k: usize = 0;
            for (str_at + k < len && buf[str_at + k] != 0 && k + 1 < cap) {
                out[k] = buf[str_at + k];
                k = k + 1;
            }
            out[k] = 0;
            ret k > 0;
        }
        d = d + 16;
    }
    ret false;
}

fun read_dylib_install_name(a: *A.Allocator, dylib_path: *u8, arch_id: u32,
                            out: *u8, cap: usize) bool {
    val res_read: R.Result[Vector[u8], str] = fs.read_bytes(a, dylib_path);
    if (R.is_err[Vector[u8], str](res_read)) { ret false; }
    var b: Vector[u8] = R.unwrap_ok[Vector[u8], str](res_read);
    var ok: bool = false;
    val cpu_type: u32 = macho.machine_for_arch(arch_id);
    if (cpu_type == 0) { vector.dnit[u8](?b); ret false; }
    if (b.len >= 4 && bin.read_u32_le(b.data, 0) == 0xFEEDFACF) {
        ok = extract_dylib_id(b.data, b.len, 0, b.len, cpu_type, out, cap);
    }
    or (b.len >= 8 && bin.read_u32_be(b.data, 0) == 0xCAFEBABE) {
        ok = extract_fat_dylib_id(b.data, b.len, false, cpu_type, out, cap);
    }
    or (b.len >= 8 && bin.read_u32_be(b.data, 0) == 0xCAFEBABF) {
        ok = extract_fat_dylib_id(b.data, b.len, true, cpu_type, out, cap);
    }
    vector.dnit[u8](?b);
    ret ok;
}

fun extract_dylib_id(buf: *u8, len: usize, base: usize, slice_len: usize,
                     cpu_type: u32, out: *u8, cap: usize) bool {
    if (base > len || slice_len > len - base || slice_len < 32) { ret false; }
    val end: usize = base + slice_len;
    if (bin.read_u32_le(buf, base) != 0xFEEDFACF) { ret false; }
    if (bin.read_u32_le(buf, base + 4) != cpu_type) { ret false; }
    if (bin.read_u32_le(buf, base + 12) != 6)     { ret false; }
    val ncmds: u32 = bin.read_u32_le(buf, base + 16);
    val sizeofcmds: usize = bin.read_u32_le(buf, base + 20)::usize;
    if (sizeofcmds > end - (base + 32)) { ret false; }
    val cmds_end: usize = base + 32 + sizeofcmds;

    var off: usize = base + 32;
    var i: u32 = 0;
    for (i < ncmds) {
        if (off + 8 > cmds_end) { ret false; }
        val cmd: u32 = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmdsize < 8 || cmdsize > cmds_end - off) { ret false; }
        if (cmd == 0xD) {
            if (cmdsize < 24) { ret false; }
            val name_off: usize = bin.read_u32_le(buf, off + 8)::usize;
            if (name_off < 24 || name_off >= cmdsize) { ret false; }
            val at: usize = off + name_off;
            var k: usize = 0;
            for (at + k < off + cmdsize && buf[at + k] != 0 && k + 1 < cap) {
                out[k] = buf[at + k];
                k = k + 1;
            }
            if (at + k >= off + cmdsize || buf[at + k] != 0 || k == 0) { ret false; }
            out[k] = 0;
            ret true;
        }
        off = off + cmdsize;
        i = i + 1;
    }
    ret false;
}

fun extract_fat_dylib_id(buf: *u8, len: usize, wide: bool,
                         cpu_type: u32, out: *u8, cap: usize) bool {
    val nfat: usize = bin.read_u32_be(buf, 4)::usize;
    var ent_size: usize = 20;
    if (wide) { ent_size = 32; }
    if (nfat > (len - 8) / ent_size) { ret false; }

    var i: usize = 0;
    for (i < nfat) {
        val ent: usize = 8 + i * ent_size;
        var off: usize = bin.read_u32_be(buf, ent + 8)::usize;
        var size: usize = bin.read_u32_be(buf, ent + 12)::usize;
        if (wide) {
            off  = read_u64_be(buf, ent + 8)::usize;
            size = read_u64_be(buf, ent + 16)::usize;
        }
        if (extract_dylib_id(buf, len, off, size, cpu_type, out, cap)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun read_u64_be(buf: *u8, off: usize) u64 {
    ret (bin.read_u32_be(buf, off)::u64 << 32)
        | bin.read_u32_be(buf, off + 4)::u64;
}

fun is_shared_path(tok: *u8) bool {
    if (tok == nil) { ret false; }
    ret str_ends_with(tok::str, ".so") || str_contains(tok::str, ".so.");
}

fun is_dll_path(tok: *u8) bool {
    if (tok == nil) { ret false; }
    val n: usize = str_len(tok::str);
    if (n < 4) { ret false; }
    val d:  u8 = tok[n - 4];
    val l1: u8 = tok[n - 3] | 0x20;
    val l2: u8 = tok[n - 2] | 0x20;
    val l3: u8 = tok[n - 1] | 0x20;
    ret d == '.' && l1 == 'd' && l2 == 'l' && l3 == 'l';
}

fun is_dylib_path(tok: *u8) bool {
    if (tok == nil) { ret false; }
    val n: usize = str_len(tok::str);
    if (n < 6) { ret false; }
    val d:  u8 = tok[n - 6];
    val l1: u8 = tok[n - 5] | 0x20;
    val l2: u8 = tok[n - 4] | 0x20;
    val l3: u8 = tok[n - 3] | 0x20;
    val l4: u8 = tok[n - 2] | 0x20;
    val l5: u8 = tok[n - 1] | 0x20;
    ret d == '.' && l1 == 'd' && l2 == 'y' && l3 == 'l' && l4 == 'i' && l5 == 'b';
}

fun dll_basename(path: *u8) *u8 {
    val n: usize = str_len(path::str);
    var last: usize = 0;
    var i: usize = 0;
    for (i < n) {
        if (path[i] == '/' || path[i] == '\\') { last = i + 1; }
        i = i + 1;
    }
    ret (path::usize + last)::*u8;
}

fun resolve_shared_into(a: *A.Allocator, tgt: *target.Target, dirs: *Vector[str],
                        name: *u8, buf: *u8, cap: usize,
                        rpath: *u8, rpath_cap: usize) bool {
    if (str_equals(tgt.of.shared_input_ext, ".dylib")) {
        ret resolve_dylib_into(a, tgt, dirs, name, buf, cap, rpath, rpath_cap);
    }
    if (!str_equals(tgt.of.shared_input_ext, ".so")) { ret false; }
    ret resolve_elf_shared_into(a, tgt, dirs, name, buf, cap);
}

fun resolve_elf_shared_into(a: *A.Allocator, tgt: *target.Target, dirs: *Vector[str],
                            name: *u8, buf: *u8, cap: usize) bool {
    var i: usize = 0;
    for (i < dirs.len) {
        if (try_shared_in_dir(a, dirs.data[i]::*u8, name, tgt.arch_id, buf, cap)) { ret true; }
        i = i + 1;
    }
    var li: u32 = 0;
    for (li < tgt.fs_policy.libdir_len) {
        val ld: str = tgt.fs_policy.libdirs[li];
        if (!str_empty(ld) && try_shared_in_dir(a, ld::*u8, name, tgt.arch_id, buf, cap)) { ret true; }
        li = li + 1;
    }
    ret false;
}

fun resolve_dylib_into(a: *A.Allocator, tgt: *target.Target, dirs: *Vector[str],
                       name: *u8, buf: *u8, cap: usize,
                       rpath: *u8, rpath_cap: usize) bool {
    var i: usize = 0;
    for (i < dirs.len) {
        if (try_dylib_in_dir(a, dirs.data[i]::*u8, name, tgt.arch_id, buf, cap,
                             rpath, rpath_cap)) { ret true; }
        i = i + 1;
    }
    var li: u32 = 0;
    for (li < tgt.fs_policy.libdir_len) {
        val ld: str = tgt.fs_policy.libdirs[li];
        if (!str_empty(ld) && try_dylib_in_dir(a, ld::*u8, name, tgt.arch_id, buf, cap,
                                               rpath, rpath_cap)) { ret true; }
        li = li + 1;
    }
    ret false;
}

fun try_dylib_in_dir(a: *A.Allocator, dir: *u8, name: *u8,
                     arch_id: u32, buf: *u8, cap: usize,
                     rpath: *u8, rpath_cap: usize) bool {
    var cand: [4096]u8;
    if (write_named_candidate(dir, "lib", name, "dylib", ?cand[0], 4096)
        && accept_dylib(a, ?cand[0], arch_id, buf, cap)) {
        ret dylib_rpath_into(a, ?cand[0], buf, rpath, rpath_cap);
    }
    var v: i64 = 6;
    for (v >= 0) {
        if (write_named_dylib_version(dir, name, v::u32, ?cand[0], 4096)
            && accept_dylib(a, ?cand[0], arch_id, buf, cap)) {
            ret dylib_rpath_into(a, ?cand[0], buf, rpath, rpath_cap);
        }
        v = v - 1;
    }
    ret false;
}

fun dylib_rpath_into(a: *A.Allocator, candidate: *u8, install_name: *u8,
                     out: *u8, cap: usize) bool {
    if (out == nil || cap == 0) { ret false; }
    out[0] = 0;
    if (!str_starts_with(install_name::str, "@rpath/")) { ret true; }
    val rp_r: R.Result[str, str] = dylib_rpath(a, candidate, install_name);
    if (R.is_err[str, str](rp_r)) { ret false; }
    val rp: str = R.unwrap_ok[str, str](rp_r);
    val n: usize = str_len(rp);
    if (n + 1 > cap) { ret false; }
    memory.raw_copy(out::ptr, rp::ptr, n + 1);
    ret true;
}

fun dylib_rpath(a: *A.Allocator, candidate: *u8,
                install_name: *u8) R.Result[str, str] {
    val abs_r: R.Result[str, str] = resolve_from_cwd(a, candidate::str);
    if (R.is_err[str, str](abs_r)) { ret abs_r; }
    val abs: str = R.unwrap_ok[str, str](abs_r);
    val suffix: str = (install_name::usize + 7)::str;
    if (!str_contains(suffix, "/")) { ret path.parent(a, abs); }
    val abs_len: usize = str_len(abs);
    val suffix_len: usize = str_len(suffix);
    if (suffix_len == 0 || suffix[0] == '/' || abs_len <= suffix_len
        || !str_ends_with(abs, suffix)) {
        ret R.err[str, str](
            "the selected dylib path does not match its @rpath install-name suffix");
    }
    var cut: usize = abs_len - suffix_len;
    if (abs[cut - 1] != '/') {
        ret R.err[str, str](
            "the selected dylib path does not match its @rpath install-name suffix");
    }
    if (cut > 1) { cut = cut - 1; }
    (abs::*u8)[cut] = 0;
    ret R.ok[str, str](abs);
}

fun resolve_from_cwd(a: *A.Allocator, p: str) R.Result[str, str] {
    if (path.is_abs(p)) { ret path.clone(a, p); }
    val cwd_r: R.Result[str, str] = env.current_dir(a);
    if (R.is_err[str, str](cwd_r)) { ret R.err[str, str](R.unwrap_err[str, str](cwd_r)); }
    ret path.resolve(a, R.unwrap_ok[str, str](cwd_r), p);
}

fun accept_dylib(a: *A.Allocator, cand: *u8, arch_id: u32,
                 buf: *u8, cap: usize) bool {
    if (!fs.is_file(cand)) { ret false; }
    ret read_dylib_install_name(a, cand, arch_id, buf, cap);
}

fun write_named_dylib_version(dir: *u8, name: *u8, v: u32,
                              buf: *u8, cap: usize) bool {
    if (v > 9) { ret false; }
    val dl: usize = str_len(dir);
    val nl: usize = str_len(name::str);
    val need: usize = dl + 1 + 3 + nl + 1 + 1 + 6 + 1;
    if (need > cap) { ret false; }
    var k: usize = 0;
    var i: usize = 0;
    for (i < dl) { buf[k] = dir[i]; k = k + 1; i = i + 1; }
    if (k > 0 && buf[k - 1] != '/') { buf[k] = '/'; k = k + 1; }
    buf[k] = 'l'; buf[k + 1] = 'i'; buf[k + 2] = 'b'; k = k + 3;
    i = 0;
    for (i < nl) { buf[k] = name[i]; k = k + 1; i = i + 1; }
    buf[k] = '.'; buf[k + 1] = ('0'::u32 + v)::u8; buf[k + 2] = '.'; k = k + 3;
    val ext: str = "dylib";
    i = 0;
    for (i < 5) { buf[k] = ext[i]; k = k + 1; i = i + 1; }
    buf[k] = 0;
    ret true;
}

fun try_shared_in_dir(a: *A.Allocator, dir: *u8, name: *u8, arch_id: u32, buf: *u8, cap: usize) bool {
    var cand: [4096]u8;
    if (write_named_candidate(dir, "lib", name, "so", ?cand[0], 4096) && accept_shared(a, ?cand[0], arch_id, buf, cap)) { ret true; }
    var v: i64 = 6;
    for (v >= 0) {
        if (write_named_versioned(dir, name, v::u32, ?cand[0], 4096) && accept_shared(a, ?cand[0], arch_id, buf, cap)) { ret true; }
        v = v - 1;
    }
    ret false;
}

fun accept_shared(a: *A.Allocator, cand: *u8, arch_id: u32, buf: *u8, cap: usize) bool {
    if (!fs.is_file(cand)) { ret false; }
    if (read_so_soname(a, cand, arch_id, buf, cap)) { ret true; }
    ret false;
}

fun write_named_versioned(dir: *u8, name: *u8, v: u32, buf: *u8, cap: usize) bool {
    if (v > 9)                                                    { ret false; }
    if (!write_named_candidate(dir, "lib", name, "so", buf, cap)) { ret false; }
    val n: usize = str_len(buf::str);
    if (n + 3 > cap) { ret false; }
    buf[n]     = '.';
    buf[n + 1] = ('0'::u32 + v)::u8;
    buf[n + 2] = 0;
    ret true;
}

pub fun explain(p: *BuildPlan, itn: *intern.Interner) {
    print.printf("plan: {}\n", p.request.project_root);
    print.printf("units: {}\n", p.units.len::i64);

    var i: usize = 0;
    for (i < p.units.len) {
        val u: *BuildUnit = ?p.units.data[i];
        print.print("\n");
        print.printf("unit {}: {} ({})  target {}  profile {}\n",
            (i + 1)::i64, unit_artifact_label(u), unit_kind_label(u),
            entry_name(itn, u.target_entry.name), u.profile);
        print.printf("  goal    {}\n", request.goal_name(u.goal));
        print.printf("  tuple   {}-{}-{}\n",
            entry_name(itn, u.target_entry.isa_name),
            entry_name(itn, u.target_entry.os_name),
            entry_name(itn, u.target_entry.abi_name));
        print.printf("  opt     {}\n", opt_name(u.opt_level));
        if (!str_empty(u.out_path)) { print.printf("  out     {}\n", u.out_path); }
        print.printf("  obj     {}\n", u.obj_dir);
        if (!str_empty(u.ir_dir))  { print.printf("  ir      {}\n", u.ir_dir); }
        if (!str_empty(u.asm_dir)) { print.printf("  asm     {}\n", u.asm_dir); }

        var li: usize = 0;
        for (li < u.link_inputs.len) {
            val inp: *LinkInput = ?u.link_inputs.data[li];
            if (inp.kind == LINK_STATIC) { print.printf("  link    static  {}\n", inp.text); }
            or {
                print.printf("  link    dynamic {}\n", inp.text);
                if (!str_empty(inp.rpath)) { print.printf("  rpath   {}\n", inp.rpath); }
            }
            li = li + 1;
        }

        print.print("  phases  ");
        var pi: usize = 0;
        for (pi < u.phases.len) {
            if (pi > 0) { print.print(" -> "); }
            print.print(phase_name(u.phases.data[pi]));
            pi = pi + 1;
        }
        print.print("\n");
        i = i + 1;
    }
}

fun unit_artifact_label(u: *BuildUnit) str {
    if (u.has_artifact) { ret u.sel_artifact; }
    ret "(default)";
}

fun unit_kind_label(u: *BuildUnit) str {
    if (u.target_entry.mode == project.MODE_LIBRARY) {
        if (u.target_entry.lib_kind == manifest.LIBKIND_SHARED) { ret "lib shared"; }
        ret "lib static";
    }
    ret "bin";
}

fun entry_name(itn: *intern.Interner, id: intern.StrId) str {
    val o: O.Option[str] = intern.lookup(itn, id);
    if (O.is_some[str](o)) { ret O.unwrap[str](o); }
    ret "(default)";
}

fun opt_name(level: u8) str {
    if (level == pipeline.OPT_RELEASE) { ret "release"; }
    ret "debug";
}

fun phase_name(k: PhaseKind) str {
    if (k == PH_DEP_STEPS) { ret "dep steps"; }
    if (k == PH_LOAD)      { ret "load"; }
    if (k == PH_STEPS)     { ret "steps"; }
    if (k == PH_SEMA)      { ret "sema"; }
    if (k == PH_LOWER)     { ret "lower"; }
    if (k == PH_CODEGEN)   { ret "codegen"; }
    if (k == PH_EMIT)      { ret "emit"; }
    ret "link";
}

fun ut_manifest_src(a: *A.Allocator, itn: *intern.Interner, src: str, out_m: *manifest.Manifest) bool {
    val source_r: R.Result[R.Void, str] = manifest.validate_source_text(src);
    if (R.is_err[R.Void, str](source_r)) { ret false; }
    val tr: R.Result[toml.Table, str] = toml.parse(a, src);
    if (R.is_err[toml.Table, str](tr)) { ret false; }
    var t: toml.Table = R.unwrap_ok[toml.Table, str](tr);
    val mr: R.Result[manifest.Manifest, str] = manifest.parse(a, itn, ?t, true);
    toml.dnit(a, ?t);
    if (R.is_err[manifest.Manifest, str](mr)) { ret false; }
    @out_m = R.unwrap_ok[manifest.Manifest, str](mr);
    ret true;
}

fun ut_manifest(a: *A.Allocator, itn: *intern.Interner, out_m: *manifest.Manifest) bool {
    ret ut_manifest_src(a, itn, "[project]\nid = \"p\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n[target.ta]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n[target.tb]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n[artifact.appa]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/appa\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[artifact.libb]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/libb.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n", out_m);
}

fun ut_scaffold(alloc: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry, m: *manifest.Manifest) bool {
    if (O.is_some[str](page.make(alloc)))              { ret false; }
    @itn = intern.init(alloc);
    @reg = target.registry_init();
    if (R.is_err[R.Void, str](target.register_all(reg, target_testing.debug_descriptor))) { ret false; }
    if (!ut_manifest(alloc, itn, m))                   { ret false; }
    ret true;
}

fun ut_scaffold_src(alloc: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry, m: *manifest.Manifest, src: str) bool {
    if (O.is_some[str](page.make(alloc)))              { ret false; }
    @itn = intern.init(alloc);
    @reg = target.registry_init();
    if (R.is_err[R.Void, str](target.register_all(reg, target_testing.debug_descriptor))) { ret false; }
    if (!ut_manifest_src(alloc, itn, src, m))          { ret false; }
    ret true;
}

fun ut_path_eq(a: str, b: str) bool {
    if (a == nil) { ret str_empty(b); }
    if (b == nil) { ret str_empty(a); }
    if (a == b)   { ret true; }

    var i: usize = 0;
    for (a[i] != 0 && b[i] != 0) {
        var ca: char = a[i];
        var cb: char = b[i];
        if (ca == 92) { ca = 47; }
        if (cb == 92) { cb = 47; }
        if (ca != cb) { ret false; }
        i = i + 1;
    }

    ret a[i] == b[i];
}

fun ut_write_dylib(path_: str, install_name: str, cpu_type: u32) bool {
    var buf: [160]u8;
    var i: usize = 0;
    for (i < 160) { buf[i] = 0; i = i + 1; }
    if (!ut_fill_dylib(?buf[0], 0, install_name, cpu_type)) { ret false; }
    ret O.is_none[str](fs.write_bytes(path_, ?buf[0], 128, 420));
}

fun ut_fill_dylib(buf: *u8, off: usize, install_name: str,
                  cpu_type: u32) bool {
    val name_len: usize = str_len(install_name);
    if (name_len + 1 > 72) { ret false; }

    bin.write_u32_le(buf, off, 0xFEEDFACF);
    bin.write_u32_le(buf, off + 4, cpu_type);
    bin.write_u32_le(buf, off + 8, 3);
    bin.write_u32_le(buf, off + 12, 6);
    bin.write_u32_le(buf, off + 16, 1);
    bin.write_u32_le(buf, off + 20, 96);
    bin.write_u32_le(buf, off + 32, 0xD);
    bin.write_u32_le(buf, off + 36, 96);
    bin.write_u32_le(buf, off + 40, 24);
    memory.raw_copy((buf::usize + off + 56)::ptr, install_name::ptr, name_len);
    ret true;
}

fun ut_temp_dir(a: *A.Allocator) R.Result[str, str] {
    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(a, "mach_plan_dylib");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret R.err[str, str](R.unwrap_err[fs.TempFile, str](tf_r)); }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val root_r: R.Result[str, str] = str_copy(a, fs.temp_path(?tf)::*u8);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[str, str](root_r)) { ret root_r; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val mk: O.Option[str] = fs.create_dir_all(a, root, 493);
    if (O.is_some[str](mk)) { ret R.err[str, str](O.unwrap[str](mk)); }
    ret R.ok[str, str](root);
}

test "mach.lang.build.plan.resolve_input_into:coff_static_suffixes" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val root_r: R.Result[str, str] = ut_temp_dir(?alloc);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val lib_r: R.Result[str, str] = path.join(?alloc, root, "libmingw32.lib");
    if (R.is_err[str, str](lib_r)) { fs.remove_all(?alloc, root); ret 1; }
    val lib: str = R.unwrap_ok[str, str](lib_r);
    if (O.is_some[str](fs.write_bytes(lib, "!<arch>\n", 8, 420))) {
        fs.remove_all(?alloc, root);
        ret 1;
    }

    var dirs: Vector[str] = vector.init[str](?alloc);
    if (R.is_err[usize, str](vector.push[str](?dirs, root))) {
        fs.remove_all(?alloc, root);
        ret 1;
    }
    var buf: [4096]u8;
    val named: bool = resolve_input_into("mingw32"::*u8, ?dirs, ?buf[0], 4096, true);
    val explicit: bool = resolve_input_into(lib::*u8, ?dirs, ?buf[0], 4096, false);
    fs.remove_all(?alloc, root);
    if (!named || !explicit) { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.resolve_token:linux_ignores_bare_coff_lib" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    val tr: R.Result[target.Target, str] =
        target.select(?reg, "x86_64", "linux", "sysv64");
    if (R.is_err[target.Target, str](tr)) { ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);

    val root_r: R.Result[str, str] = ut_temp_dir(?alloc);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val lib_r: R.Result[str, str] = path.join(?alloc, root, "libfoo.lib");
    val so_r: R.Result[str, str] = path.join(?alloc, root, "libfoo.so");
    if (R.is_err[str, str](lib_r) || R.is_err[str, str](so_r)) {
        fs.remove_all(?alloc, root); ret 1;
    }
    val lib: str = R.unwrap_ok[str, str](lib_r);
    val so: str = R.unwrap_ok[str, str](so_r);
    if (O.is_some[str](fs.write_bytes(lib, "!<arch>\n", 8, 420))
        || !ut_write_elf_object(so, 62, true)) {
        fs.remove_all(?alloc, root); ret 1;
    }

    var dirs: Vector[str] = vector.init[str](?alloc);
    if (R.is_err[usize, str](vector.push[str](?dirs, root))) {
        fs.remove_all(?alloc, root); ret 1;
    }
    val rr: R.Result[LinkInput, outcome.Fail] =
        resolve_token(?alloc, ?tgt, ?dirs, "", "foo"::*u8);
    var explicit_buf: [4096]u8;
    val explicit: bool =
        resolve_input_into(lib::*u8, ?dirs, ?explicit_buf[0], 4096, false);
    fs.remove_all(?alloc, root);
    if (R.is_err[LinkInput, outcome.Fail](rr) || !explicit) { ret 1; }
    val input: LinkInput = R.unwrap_ok[LinkInput, outcome.Fail](rr);
    if (input.kind != LINK_DYNAMIC || !str_equals(input.text, "libfoo.so")) { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.resolve_token:elf_shared_machine_matches_target" {
    var alloc: A.Allocator;
