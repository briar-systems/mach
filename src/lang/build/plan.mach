test "mach.lang.build.plan.plan:phases_follow_goal" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold(?alloc, ?itn, ?reg, ?m)) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.target       = "ta";
    rq.artifact     = "appa";

    val pr: res[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (sel pr.err) { ret 1; }
    val u0: *BuildUnit = ?pr.ok.units.data[0];
    if (u0.phases.len != 6)                 { ret 1; }
    if (u0.phases.data[0] != PH_LOAD)       { ret 1; }
    if (u0.phases.data[1] != PH_SEMA)       { ret 1; }
    if (u0.phases.data[2] != PH_LOWER)      { ret 1; }
    if (u0.phases.data[3] != PH_CODEGEN)    { ret 1; }
    if (u0.phases.data[4] != PH_EMIT)       { ret 1; }
    if (u0.phases.data[5] != PH_LINK)       { ret 1; }

    rq.goal = request.GOAL_OBJECTS;
    val po: res[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (sel po.err) { ret 1; }
    val uo: *BuildUnit = ?po.ok.units.data[0];
    if (uo.phases.len != 5)                       { ret 1; }
    if (uo.phases.data[4] != PH_EMIT)             { ret 1; }
    if (!str_equals(uo.out_path, uo.obj_dir))     { ret 1; }

    rq.goal = request.GOAL_TEST_LIST;
    val pl: res[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (sel pl.err) { ret 1; }
    val ul: *BuildUnit = ?pl.ok.units.data[0];
    if (ul.phases.len != 3)               { ret 1; }
    if (ul.phases.data[0] != PH_LOAD)     { ret 1; }
    if (ul.phases.data[1] != PH_SEMA)     { ret 1; }
    if (ul.phases.data[2] != PH_LOWER)    { ret 1; }
    if (!str_empty(ul.out_path))          { ret 1; }

    rq.emit_ir  = true;
    rq.emit_asm = true;
    val pe: res[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (sel pe.err) { ret 1; }
    val ue: *BuildUnit = ?pe.ok.units.data[0];
    if (ue.phases.len != 3 || ue.phases.data[2] != PH_LOWER) { ret 1; }
    if (!str_empty(ue.out_path))          { ret 1; }
    rq.emit_ir  = false;
    rq.emit_asm = false;

    rq.goal = request.GOAL_TESTS;
    val pt: res[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (sel pt.err) { ret 1; }
    val bt: BuildPlan = pt.ok;
    if (bt.units.len != 1) { ret 1; }
    val ut: *BuildUnit = ?bt.units.data[0];
    if (!ut_path_eq(ut.out_path, "/r/out/ta/debug/test/appa"))   { ret 1; }
    if (ut.phases.data[ut.phases.len - 1] != PH_LINK)            { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.plan:finished_modules_end_at_emit" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold_src(?alloc, ?itn, ?reg, ?m, "[project]\nid = \"p\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n[target.gpu]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n[artifact.appa]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/appa\"\ntargets = [\"*\"]\nlink = []\nneed = []\n")) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.target       = "gpu";
    rq.artifact     = "appa";

    val pe: res[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (sel pe.err) { ret 1; }
    val ue: *BuildUnit = ?pe.ok.units.data[0];

    if (ue.goal != request.GOAL_EXECUTE)                         { ret 1; }
    if (ue.phases.len != 5)                                      { ret 1; }
    if (ue.phases.data[4] != PH_EMIT)                            { ret 1; }
    if (!ut_path_eq(ue.out_path, "/r/out/gpu/debug/obj"))        { ret 1; }
    if (!str_equals(ue.out_path, ue.obj_dir))                    { ret 1; }

    rq.goal = request.GOAL_OBJECTS;
    val po: res[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (sel po.err) { ret 1; }
    val uo: *BuildUnit = ?po.ok.units.data[0];
    if (uo.phases.len != ue.phases.len)         { ret 1; }
    if (!str_equals(uo.out_path, ue.out_path))  { ret 1; }

    var mr: manifest.Manifest;
    if (!ut_manifest(?alloc, ?itn, ?mr)) { ret 1; }
    var rr: request.BuildRequest = request.defaults();
    rr.project_root = "/r";
    rr.target       = "ta";
    rr.artifact     = "appa";
    val pr: res[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?mr, rr);
    if (sel pr.err) { ret 1; }
    val ur: *BuildUnit = ?pr.ok.units.data[0];
    if (ur.phases.data[ur.phases.len - 1] != PH_LINK) { ret 1; }

    ret 0;
}

test "mach.lang.build.plan.plan:dep_steps_precede_project_steps" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold_src(?alloc, ?itn, ?reg, ?m, "[project]\nid = \"p\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n[target.ta]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n[step.s]\nargv = [\"true\"]\nin = []\nout = [\"gen/x\"]\nneed = []\n[dep.d]\npath = \"./vendor/d\"\n[artifact.appa]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/appa\"\ntargets = [\"*\"]\nlink = []\nneed = [\"step.s\"]\n")) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.target       = "ta";
    rq.artifact     = "appa";

    val pr: res[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (sel pr.err) { ret 1; }
    val u0: *BuildUnit = ?pr.ok.units.data[0];

    if (u0.phases.len < 3)                  { ret 1; }
    if (u0.phases.data[0] != PH_DEP_STEPS)  { ret 1; }
    if (u0.phases.data[1] != PH_STEPS)      { ret 1; }
    if (u0.phases.data[2] != PH_LOAD)       { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.plan:out_override_and_emission_dirs" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold(?alloc, ?itn, ?reg, ?m)) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.target       = "ta";
    rq.artifact     = "appa";
    rq.out          = "bin/custom";

    val pr: res[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (sel pr.err) { ret 1; }
    val u0: *BuildUnit = ?pr.ok.units.data[0];
    if (!ut_path_eq(u0.out_path, "/r/bin/custom")) { ret 1; }
    if (!str_empty(u0.ir_dir))                     { ret 1; }
    if (!str_empty(u0.asm_dir))                    { ret 1; }

    rq.out     = "/abs/custom";
    rq.emit_ir = true;
    rq.emit_asm = true;
    val pa: res[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (sel pa.ok) { ret 1; }
    val refused: outcome.Fail = pa.err;
    if (!str_contains(outcome.describe(refused), "inside the project root")) { ret 1; }

    rq.out = "../custom";
    val pp: res[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (sel pp.ok) { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.no_cells_msg:joins_many_artifact_names_without_corruption" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);

    val name_r: res[intern.StrId, A.Error] = intern.intern(?itn, "widget");
    if (sel name_r.err) { ret 1; }
    val name_id: intern.StrId = name_r.ok;

    val n: u32 = 200;
    val defs_r: res[*manifest.ArtifactDef, A.Error] = A.allocate[manifest.ArtifactDef](?alloc, n::usize);
    if (sel defs_r.err) { ret 1; }
    val defs: *manifest.ArtifactDef = defs_r.ok;
    var i: u32 = 0;
    for (i < n) { defs[i].name = name_id; i = i + 1; }

    var m: manifest.Manifest;
    m.artifacts      = defs;
    m.artifact_count = n;

    val msg: str = no_cells_msg(?alloc, ?itn, ?m, "other");
    if (!str_contains(msg, "no artifact declares target 'other'")) { ret 1; }

    var expect: textbuild.TextBuilder = textbuild.tb_init(?alloc);
    i = 0;
    for (i < n) {
        if (i > 0) { textbuild.tb_append(?expect, ", "); }
        textbuild.tb_append(?expect, "widget");
        i = i + 1;
    }
    val expect_r: res[str, textbuild.Error] = textbuild.tb_finish(?expect);
    textbuild.tb_dnit(?expect);
    if (sel expect_r.err) { ret 1; }
    if (!str_contains(msg, expect_r.ok)) { ret 1; }

    A.deallocate[manifest.ArtifactDef](?alloc, defs, n::usize);
    ret 0;
}

test "mach.lang.build.plan.out_conflict_msg:joins_many_units_without_corruption" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var bp: BuildPlan;
    bp.units = vector.init[BuildUnit](?alloc);
    var i: u32 = 0;
    for (i < 150) {
        var u: BuildUnit;
        u.sel_artifact = "appa";
        u.sel_target   = "linux-x86_64";
        val pr: res[usize, A.Error] = vector.push[BuildUnit](?bp.units, u);
        if (sel pr.err) { ret 1; }
        i = i + 1;
    }

    val msg: str = out_conflict_msg(?alloc, ?bp);
    if (!str_contains(msg, "resolves to several build units")) { ret 1; }
    if (!str_contains(msg, "appa for linux-x86_64, appa for linux-x86_64")) { ret 1; }
    ret 0;
}

fun plan_tb_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    ret opt[ptr].none{};
}

fun plan_tb_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    ret opt[ptr].none{};
}

fun plan_tb_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.build.plan.no_cells_msg:reports_the_sentinel_when_the_builder_fails_mid_write" {
    var probe_alloc: A.Allocator;
    probe_alloc.ctx           = nil;
    probe_alloc.fn_allocate   = plan_tb_probe_allocate;
    probe_alloc.fn_reallocate = plan_tb_probe_reallocate;
    probe_alloc.fn_deallocate = plan_tb_probe_deallocate;

    var real_alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?real_alloc);
    if (sel make_r.err) { ret 1; }
    var itn: intern.Interner = intern.init(?real_alloc);
    val name_r: res[intern.StrId, A.Error] = intern.intern(?itn, "widget");
    if (sel name_r.err) { ret 1; }

    var def: manifest.ArtifactDef;
    def.name = name_r.ok;
    var m: manifest.Manifest;
    m.artifacts      = ?def;
    m.artifact_count = 1;

    val msg: str = no_cells_msg(?probe_alloc, ?itn, ?m, "other");
    if (!str_contains(msg, "message unavailable")) { ret 1; }
    ret 0;
}

fun t_plan_from_local_request(alloc: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry,
                              m: *manifest.Manifest) res[BuildPlan, outcome.Fail] {
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/owned-by-the-plan";
    rq.all_targets  = true;
    val pr: res[BuildPlan, outcome.Fail] = plan(alloc, itn, reg, m, rq);
    rq.project_root = "/clobbered-after-planning";
    rq.all_targets  = false;
    ret pr;
}

test "mach.lang.build.plan.plan:owns_its_request_beyond_the_planning_scope" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold(?alloc, ?itn, ?reg, ?m)) { ret 1; }
    val pr: res[BuildPlan, outcome.Fail] = t_plan_from_local_request(?alloc, ?itn, ?reg, ?m);
    if (sel pr.err) { ret 1; }
    val bp: BuildPlan = pr.ok;
    if (!str_equals(bp.request.project_root, "/owned-by-the-plan")) { ret 1; }
    if (!bp.request.all_targets) { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.plan:unknown_request_goal_is_internal_before_manifest_access" {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var req: request.BuildRequest = request.defaults();
    req.goal = 255;
    val result: res[BuildPlan, outcome.Fail] = plan(?a, nil, nil, nil, req);
    if (sel result.ok) { ret 2; }
    val f: outcome.Fail = result.err;
    fin { outcome.release_text(?a, f); }
    if (!sel f.internal) { ret 3; }
    if (!str_contains(outcome.describe(f), "BuildGoal")) { ret 3; }
    if (!str_contains(outcome.describe(f), "255")) { ret 3; }
    ret 0;
}
