    rq.goal         = request.GOAL_TESTS;

    val pr: res[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (sel pr.err) { ret 1; }
    val bp: BuildPlan = pr.ok;
    if (bp.units.len != 1) { ret 2; }
    if (!str_equals(bp.request.artifact, "first") || !bp.request.artifact_by_table_order) { ret 3; }
    if (!str_equals(bp.units.data[0].sel_artifact, "first")) { ret 4; }
    ret 0;
}

test "mach.lang.build.plan.plan:a_required_artifact_is_planned_once_for_every_consumer" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
