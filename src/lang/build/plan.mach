test "mach.lang.build.plan.plan:phases_follow_goal" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold(?alloc, ?itn, ?reg, ?m)) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.target       = "ta";
    rq.artifact     = "appa";

    val pr: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_err[BuildPlan, outcome.Fail](pr)) { ret 1; }
    val u0: *BuildUnit = ?R.unwrap_ok[BuildPlan, outcome.Fail](pr).units.data[0];
    if (u0.phases.len != 6)                 { ret 1; }
    if (u0.phases.data[0] != PH_LOAD)       { ret 1; }
    if (u0.phases.data[1] != PH_SEMA)       { ret 1; }
    if (u0.phases.data[2] != PH_LOWER)      { ret 1; }
    if (u0.phases.data[3] != PH_CODEGEN)    { ret 1; }
    if (u0.phases.data[4] != PH_EMIT)       { ret 1; }
    if (u0.phases.data[5] != PH_LINK)       { ret 1; }

    rq.goal = request.GOAL_OBJECTS;
    val po: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_err[BuildPlan, outcome.Fail](po)) { ret 1; }
    val uo: *BuildUnit = ?R.unwrap_ok[BuildPlan, outcome.Fail](po).units.data[0];
    if (uo.phases.len != 5)                       { ret 1; }
    if (uo.phases.data[4] != PH_EMIT)             { ret 1; }
    if (!str_equals(uo.out_path, uo.obj_dir))     { ret 1; }

    rq.goal = request.GOAL_TEST_LIST;
    val pl: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_err[BuildPlan, outcome.Fail](pl)) { ret 1; }
    val ul: *BuildUnit = ?R.unwrap_ok[BuildPlan, outcome.Fail](pl).units.data[0];
    if (ul.phases.len != 4)               { ret 1; }
    if (ul.phases.data[3] != PH_CODEGEN)  { ret 1; }
    if (!str_empty(ul.out_path))          { ret 1; }

    rq.goal = request.GOAL_TESTS;
    val pt: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_err[BuildPlan, outcome.Fail](pt)) { ret 1; }
    val bt: BuildPlan = R.unwrap_ok[BuildPlan, outcome.Fail](pt);
    if (bt.units.len != 1) { ret 1; }
    val ut: *BuildUnit = ?bt.units.data[0];
    if (!ut_path_eq(ut.out_path, "/r/out/ta/debug/test/appa"))   { ret 1; }
    if (ut.phases.data[ut.phases.len - 1] != PH_LINK)            { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.plan:finished_modules_end_at_emit" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold_src(?alloc, ?itn, ?reg, ?m, "[project]\nid = \"p\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n[target.gpu]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n[artifact.appa]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/appa\"\ntargets = [\"*\"]\nlink = []\nneed = []\n")) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.target       = "gpu";
    rq.artifact     = "appa";

    val pe: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_err[BuildPlan, outcome.Fail](pe)) { ret 1; }
    val ue: *BuildUnit = ?R.unwrap_ok[BuildPlan, outcome.Fail](pe).units.data[0];

    if (ue.goal != request.GOAL_EXECUTE)                         { ret 1; }
    if (ue.phases.len != 5)                                      { ret 1; }
    if (ue.phases.data[4] != PH_EMIT)                            { ret 1; }
    if (!ut_path_eq(ue.out_path, "/r/out/gpu/debug/obj"))        { ret 1; }
    if (!str_equals(ue.out_path, ue.obj_dir))                    { ret 1; }

    rq.goal = request.GOAL_OBJECTS;
    val po: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_err[BuildPlan, outcome.Fail](po)) { ret 1; }
    val uo: *BuildUnit = ?R.unwrap_ok[BuildPlan, outcome.Fail](po).units.data[0];
    if (uo.phases.len != ue.phases.len)         { ret 1; }
    if (!str_equals(uo.out_path, ue.out_path))  { ret 1; }

    var mr: manifest.Manifest;
    if (!ut_manifest(?alloc, ?itn, ?mr)) { ret 1; }
    var rr: request.BuildRequest = request.defaults();
    rr.project_root = "/r";
    rr.target       = "ta";
    rr.artifact     = "appa";
    val pr: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?mr, rr);
    if (R.is_err[BuildPlan, outcome.Fail](pr)) { ret 1; }
    val ur: *BuildUnit = ?R.unwrap_ok[BuildPlan, outcome.Fail](pr).units.data[0];
    if (ur.phases.data[ur.phases.len - 1] != PH_LINK) { ret 1; }

    ret 0;
}

test "mach.lang.build.plan.plan:dep_steps_precede_project_steps" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold_src(?alloc, ?itn, ?reg, ?m, "[project]\nid = \"p\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n[target.ta]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n[step.s]\nargv = [\"true\"]\nin = []\nout = [\"gen/x\"]\nneed = []\n[dep.d]\npath = \"./vendor/d\"\n[artifact.appa]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/appa\"\ntargets = [\"*\"]\nlink = []\nneed = [\"s\"]\n")) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.target       = "ta";
    rq.artifact     = "appa";

    val pr: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_err[BuildPlan, outcome.Fail](pr)) { ret 1; }
    val u0: *BuildUnit = ?R.unwrap_ok[BuildPlan, outcome.Fail](pr).units.data[0];

    if (u0.phases.len < 3)                  { ret 1; }
    if (u0.phases.data[0] != PH_DEP_STEPS)  { ret 1; }
    if (u0.phases.data[1] != PH_STEPS)      { ret 1; }
    if (u0.phases.data[2] != PH_LOAD)       { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.plan:out_override_and_emission_dirs" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold(?alloc, ?itn, ?reg, ?m)) { ret 1; }

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/r";
    rq.target       = "ta";
    rq.artifact     = "appa";
    rq.out          = "bin/custom";

    val pr: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_err[BuildPlan, outcome.Fail](pr)) { ret 1; }
    val u0: *BuildUnit = ?R.unwrap_ok[BuildPlan, outcome.Fail](pr).units.data[0];
    if (!ut_path_eq(u0.out_path, "/r/bin/custom")) { ret 1; }
    if (!str_empty(u0.ir_dir))                     { ret 1; }
    if (!str_empty(u0.asm_dir))                    { ret 1; }

    rq.out     = "/abs/custom";
    rq.emit_ir = true;
    rq.emit_asm = true;
    val pa: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_ok[BuildPlan, outcome.Fail](pa)) { ret 1; }
    var fail: outcome.Fail = R.unwrap_err[BuildPlan, outcome.Fail](pa);
    if (!str_contains(fail.message, "inside the project root")) { ret 1; }

    rq.out = "../custom";
    val pp: R.Result[BuildPlan, outcome.Fail] = plan(?alloc, ?itn, ?reg, ?m, rq);
    if (R.is_ok[BuildPlan, outcome.Fail](pp)) { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.no_cells_msg:joins_many_artifact_names_without_corruption" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);

    val name_r: R.Result[intern.StrId, str] = intern.intern(?itn, "widget");
    if (R.is_err[intern.StrId, str](name_r)) { ret 1; }
    val name_id: intern.StrId = R.unwrap_ok[intern.StrId, str](name_r);

    val n: u32 = 200;
    val defs_r: R.Result[*manifest.ArtifactDef, str] = A.allocate[manifest.ArtifactDef](?alloc, n::usize);
    if (R.is_err[*manifest.ArtifactDef, str](defs_r)) { ret 1; }
    val defs: *manifest.ArtifactDef = R.unwrap_ok[*manifest.ArtifactDef, str](defs_r);
    var i: u32 = 0;
    for (i < n) { defs[i].name = name_id; i = i + 1; }

    var m: manifest.Manifest;
    m.artifacts      = defs;
    m.artifact_count = n;

    val msg: str = no_cells_msg(?alloc, ?itn, ?m, "other");
    if (!str_contains(msg, "no artifact declares target 'other'")) { ret 1; }

    var expect: textbuild.TextBuilder = textbuild.tb_init(?alloc);
    i = 0;
    for (i < n) {
        if (i > 0) { textbuild.tb_append(?expect, ", "); }
        textbuild.tb_append(?expect, "widget");
        i = i + 1;
    }
    val expect_r: R.Result[str, str] = textbuild.tb_finish(?expect);
    textbuild.tb_dnit(?expect);
    if (R.is_err[str, str](expect_r)) { ret 1; }
    if (!str_contains(msg, R.unwrap_ok[str, str](expect_r))) { ret 1; }

    A.deallocate[manifest.ArtifactDef](?alloc, defs, n::usize);
    ret 0;
}

test "mach.lang.build.plan.out_conflict_msg:joins_many_units_without_corruption" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var bp: BuildPlan;
    bp.units = vector.init[BuildUnit](?alloc);
    var i: u32 = 0;
    for (i < 150) {
        var u: BuildUnit;
        u.sel_artifact = "appa";
        u.sel_target   = "linux-x86_64";
        val pr: R.Result[usize, str] = vector.push[BuildUnit](?bp.units, u);
        if (R.is_err[usize, str](pr)) { ret 1; }
        i = i + 1;
    }

    val msg: str = out_conflict_msg(?alloc, ?bp);
    if (!str_contains(msg, "resolves to several build units")) { ret 1; }
    if (!str_contains(msg, "appa for linux-x86_64, appa for linux-x86_64")) { ret 1; }
    ret 0;
}

fun plan_tb_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    ret O.none[ptr]();
}

fun plan_tb_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    ret O.none[ptr]();
}

fun plan_tb_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.build.plan.no_cells_msg:reports_the_sentinel_when_the_builder_fails_mid_write" {
    var probe_alloc: A.Allocator;
    probe_alloc.ctx           = nil;
    probe_alloc.fn_allocate   = plan_tb_probe_allocate;
    probe_alloc.fn_reallocate = plan_tb_probe_reallocate;
    probe_alloc.fn_deallocate = plan_tb_probe_deallocate;

    var real_alloc: A.Allocator;
    if (O.is_some[str](page.make(?real_alloc))) { ret 1; }
    var itn: intern.Interner = intern.init(?real_alloc);
    val name_r: R.Result[intern.StrId, str] = intern.intern(?itn, "widget");
    if (R.is_err[intern.StrId, str](name_r)) { ret 1; }

    var def: manifest.ArtifactDef;
    def.name = R.unwrap_ok[intern.StrId, str](name_r);
    var m: manifest.Manifest;
    m.artifacts      = ?def;
    m.artifact_count = 1;

    val msg: str = no_cells_msg(?probe_alloc, ?itn, ?m, "other");
    if (!str_contains(msg, "message unavailable")) { ret 1; }
    ret 0;
}

fun t_plan_from_local_request(alloc: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry,
                              m: *manifest.Manifest) R.Result[BuildPlan, outcome.Fail] {
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/owned-by-the-plan";
    rq.all_targets  = true;
    val pr: R.Result[BuildPlan, outcome.Fail] = plan(alloc, itn, reg, m, rq);
    rq.project_root = "/clobbered-after-planning";
    rq.all_targets  = false;
    ret pr;
}

test "mach.lang.build.plan.plan:owns_its_request_beyond_the_planning_scope" {
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    var reg:   target.TargetRegistry;
    var m:     manifest.Manifest;
    if (!ut_scaffold(?alloc, ?itn, ?reg, ?m)) { ret 1; }
    val pr: R.Result[BuildPlan, outcome.Fail] = t_plan_from_local_request(?alloc, ?itn, ?reg, ?m);
    if (R.is_err[BuildPlan, outcome.Fail](pr)) { ret 1; }
    val bp: BuildPlan = R.unwrap_ok[BuildPlan, outcome.Fail](pr);
    if (!str_equals(bp.request.project_root, "/owned-by-the-plan")) { ret 1; }
    if (!bp.request.all_targets) { ret 1; }
    ret 0;
}
