    val tr: R.Result[target.Target, str] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (R.is_err[target.Target, str](tr)) { ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);

    val root_r: R.Result[str, str] = ut_temp_dir(?alloc);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val so_r: R.Result[str, str] = path.join(?alloc, root, "libwrong.so");
    if (R.is_err[str, str](so_r)) { fs.remove_all(?alloc, root); ret 1; }
    val so: str = R.unwrap_ok[str, str](so_r);
    if (!ut_write_elf_object(so, elf.machine_for_arch(isa.ARCH_AARCH64), true)) {
        fs.remove_all(?alloc, root); ret 1;
    }

    var dirs: Vector[str] = vector.init[str](?alloc);
    if (R.is_err[usize, str](vector.push[str](?dirs, root))) {
        fs.remove_all(?alloc, root); ret 1;
    }
    val wrong: R.Result[LinkInput, outcome.Fail] =
        resolve_token(?alloc, ?tgt, ?dirs, "", "wrong"::*u8);
    fs.remove_all(?alloc, root);
    if (R.is_ok[LinkInput, outcome.Fail](wrong)) { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.resolve_token:static_object_wrong_architecture_refused" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    val tr: R.Result[target.Target, str] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (R.is_err[target.Target, str](tr)) { ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);

    val root_r: R.Result[str, str] = ut_temp_dir(?alloc);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    val obj_r: R.Result[str, str] = path.join(?alloc, root, "wrong.o");
    val ok_r: R.Result[str, str] = path.join(?alloc, root, "right.o");
    if (R.is_err[str, str](obj_r) || R.is_err[str, str](ok_r)) {
        fs.remove_all(?alloc, root); ret 1;
    }
    val obj: str = R.unwrap_ok[str, str](obj_r);
    val ok_path: str = R.unwrap_ok[str, str](ok_r);
    if (!ut_write_elf_object(obj, elf.machine_for_arch(isa.ARCH_AARCH64), false)
        || !ut_write_elf_object(ok_path, elf.machine_for_arch(isa.ARCH_X86_64), false)) {
        fs.remove_all(?alloc, root); ret 1;
    }

    var dirs: Vector[str] = vector.init[str](?alloc);
    val wrong: R.Result[LinkInput, outcome.Fail] =
        resolve_token(?alloc, ?tgt, ?dirs, "", obj::*u8);
    val right: R.Result[LinkInput, outcome.Fail] =
        resolve_token(?alloc, ?tgt, ?dirs, "", ok_path::*u8);
    fs.remove_all(?alloc, root);
    if (R.is_ok[LinkInput, outcome.Fail](wrong)) { ret 1; }
    if (R.is_err[LinkInput, outcome.Fail](right)) { ret 1; }
    val ri: LinkInput = R.unwrap_ok[LinkInput, outcome.Fail](right);
    if (ri.kind != LINK_STATIC) { ret 1; }
    ret 0;
}

