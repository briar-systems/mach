pub def PhaseKind: u8;

pub val PH_DEP_STEPS: PhaseKind = 0;

pub val PH_LOAD:      PhaseKind = 1;

pub val PH_STEPS:     PhaseKind = 2;

pub val PH_SEMA:      PhaseKind = 3;

pub val PH_LOWER:     PhaseKind = 4;

pub val PH_CODEGEN:   PhaseKind = 5;

pub val PH_EMIT:      PhaseKind = 6;

pub val PH_LINK:      PhaseKind = 7;

pub def LinkInputKind: u8;

pub val LINK_STATIC:  LinkInputKind = 0;

pub val LINK_DYNAMIC: LinkInputKind = 1;

pub rec LinkInput {
    kind:               LinkInputKind;
    text:               str;
    library:            str;
    rpath:              str;
    include_referenced: bool;
}

# one planned cell: an artifact on a target for a profile, with every decision
# the engine executes. `plan` fills everything the root manifest decides; `configure`
# adds what the realized dependency closure decides
# ---
# steps: the root manifest's prerequisite steps in execution order, by name
# dep_steps: exported dependency steps in execution order as `<dep id>.<step>`;
#  empty until `configure`
# export_links: the dependency closure's exported link requirements for this
#  cell, in link order; empty until `configure`
# configured: `configure` ran, so `dep_steps` and `export_links` are effective
pub rec BuildUnit {
    target_entry: *project.TargetEntry;
    profile:      str;
    opt_level:    u8;
    placement_policy: u32;
    goal:         request.BuildGoal;
    out_path:     str;
    obj_dir:      str;
    ir_dir:       str;
    asm_dir:      str;
    link_inputs:  Vector[LinkInput];
    phases:       Vector[PhaseKind];
    steps:        Vector[str];
    dep_steps:    Vector[str];
    export_links: Vector[manifest.LinkRequirement];
    configured:   bool;

    sel_target:   str;
    sel_artifact: str;
    want_lib:     bool;
    has_artifact: bool;
    is_required:  bool;
    requires:     Vector[str];
    subsystem:    of.Subsystem;
}

pub def BuildRequest: request.BuildRequest;

# project: the root manifest's `[project].id`
pub rec BuildPlan {
    request: BuildRequest;
    project: str;
    units:   Vector[BuildUnit];
}

pub fun plan(a: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry,
             m: *manifest.Manifest, owned_req: request.BuildRequest) res[BuildPlan, outcome.Fail] {
    val valid: err[outcome.Fail] = request.validate(a, ?owned_req);
    if (sel valid.err) {
        ret res[BuildPlan, outcome.Fail].err{valid.err};
    }
    var bp: BuildPlan;
    bp.request = owned_req;
    bp.units   = vector.init[BuildUnit](a);
    bp.project = entry_name(itn, m.id);
    val req: *request.BuildRequest = ?bp.request;

    if (request.test_goal(req.goal)) {
        var pick: manifest.Selection;
        pick.target       = req.target;
        pick.profile      = req.profile;
        pick.artifact     = req.artifact;
        pick.want_lib     = req.want_lib;
        pick.has_artifact = !str_empty(req.artifact);
        pick.legacy_default = false;
        val psr: err[outcome.Fail] = manifest.select_primary_artifact(a, itn, m, ?pick);
        if (sel psr.err) {
            ret res[BuildPlan, outcome.Fail].err{psr.err};
        }
        bp.request.artifact = pick.artifact;
        bp.request.want_lib = pick.want_lib;
        bp.request.artifact_by_table_order = pick.legacy_default;
        val cr: err[outcome.Fail] = plan_cell(a, itn, reg, m, req, ?bp,
            req.target, req.artifact, req.want_lib, !str_empty(req.artifact), false);
        if (sel cr.err) {
            ret res[BuildPlan, outcome.Fail].err{cr.err};
        }
        ret res[BuildPlan, outcome.Fail].ok{bp};
    }

    val expand_targets: bool = req.all_targets && str_empty(req.target);
    var tn: u32 = 1;
    if (expand_targets) { tn = m.target_count; }
    if (tn == 0) {
        ret res[BuildPlan, outcome.Fail].err{outcome.user("mach.toml: --all-targets but no [target.*] declared")};
    }

    val expand_artifacts: bool = str_empty(req.artifact);
    var an: u32 = 1;
    if (expand_artifacts) { an = m.artifact_count; }
    if (an == 0) {
        ret res[BuildPlan, outcome.Fail].err{outcome.user("mach.toml: no [artifact.*] artifacts declared")};
    }

    var ti: u32 = 0;
    for (ti < tn) {
        var tname: str = req.target;
        if (expand_targets) {
            val to: opt[str] = intern.lookup(itn, m.targets[ti].name);
            if (sel to.none) {
                ret res[BuildPlan, outcome.Fail].err{outcome.user("internal: target name not interned")};
            }
            tname = to.some;
        }
        var ai: u32 = 0;
        for (ai < an) {
            var aname:    str  = req.artifact;
            var want_lib: bool = req.want_lib;
            if (expand_artifacts) {
                val ao: opt[str] = intern.lookup(itn, m.artifacts[ai].name);
                if (sel ao.none) {
                    ret res[BuildPlan, outcome.Fail].err{outcome.user("internal: artifact name not interned")};
                }
                aname    = ao.some;
                want_lib = m.artifacts[ai].is_lib;
            }

            if (expand_targets || expand_artifacts) {
                val supported_r: res[bool, outcome.Fail] = cell_declared(a, itn, m, tname, aname, want_lib);
                if (sel supported_r.err) {
                    ret res[BuildPlan, outcome.Fail].err{supported_r.err};
                }
                if (!supported_r.ok) { ai = ai + 1; cnt; }
            }

            val cr: err[outcome.Fail] = plan_cell(a, itn, reg, m, req, ?bp,
                tname, aname, want_lib, true, false);
            if (sel cr.err) {
                ret res[BuildPlan, outcome.Fail].err{cr.err};
            }
            ai = ai + 1;
        }
        ti = ti + 1;
    }

    if (bp.units.len == 0) {
        ret res[BuildPlan, outcome.Fail].err{outcome.user(no_cells_msg(a, itn, m, req.target))};
    }

    if (!str_empty(req.out) && selected_unit_count(?bp) > 1) {
        ret res[BuildPlan, outcome.Fail].err{outcome.user(out_conflict_msg(a, ?bp))};
    }
    ret res[BuildPlan, outcome.Fail].ok{bp};
}

# resolve every planned cell against the realized dependency closure, filling in
# the exported dependency steps and export link requirements each cell consumes.
# it configures projects through the same `driver.begin_build` a build runs, so a
# missing realization, an invalid dependency manifest or a dependency cycle is
# reported here exactly as the build would report it. nothing is fetched, no step
# runs and no output is written
# ---
# s: the session the plan was made in
# m: the root manifest
# bp: the plan, mutated in place; each unit becomes `configured`
# ret: ok; the configuration failure of the first cell that has one
pub fun configure(s: *session.Session, m: *manifest.Manifest, bp: *BuildPlan) err[outcome.Fail] {
    var i: usize = 0;
    for (i < bp.units.len) {
        val u: *BuildUnit = ?bp.units.data[i];
        var req: request.BuildRequest = request.for_cell(?bp.request, u.sel_target,
            u.sel_artifact, u.want_lib, u.subsystem, u.goal);
        val begun: res[project.Project, outcome.Fail] = driver.begin_build(s, m, ?req, nil);
        if (sel begun.err) {
            ret err[outcome.Fail].err{begun.err};
        }
        var p: project.Project = begun.ok;
        val collected: err[outcome.Fail] = collect_dependency_plan(?p, u);
        project.dnit_project(?p);
        if (sel collected.err) { ret collected; }
        u.configured = true;
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun collect_dependency_plan(p: *project.Project, u: *BuildUnit) err[outcome.Fail] {
    val itn: *intern.Interner = ?p.s.interner;
    val planned: res[Vector[dcfg.DependencyStep], outcome.Fail] = dcfg.plan_dep_steps(p,
        entry_name(itn, u.target_entry.isa_name), entry_name(itn, u.target_entry.os_name),
        entry_name(itn, u.target_entry.abi_name));
    if (sel planned.err) {
        ret err[outcome.Fail].err{planned.err};
    }
    var steps: Vector[dcfg.DependencyStep] = planned.ok;
    fin { vector.dnit[dcfg.DependencyStep](?steps); }

    var i: usize = 0;
    for (i < steps.len) {
        val selected: dcfg.DependencyStep = steps.data[i];
        val dm: *manifest.Manifest = ?p.config.deps[selected.dependency].manifest;
        val labelled: res[str, format.FormatError] = format.sprint(u.dep_steps.a, "{}.{}",
            entry_name(itn, dm.id), entry_name(itn, dm.steps[selected.step].name));
        if (sel labelled.err) {
            ret err[outcome.Fail].err{outcome.internal(outcome.format_text(labelled.err))};
        }
        val pushed: res[usize, A.Error] = vector.push[str](?u.dep_steps, labelled.ok);
        if (sel pushed.err) {
            ret err[outcome.Fail].err{outcome.refused(pushed.err)};
        }
        i = i + 1;
    }

    # the claimed-symbol array belongs to the project config and dies with it; the
    # plan keeps only the interned identity it displays
    var li: u32 = 0;
    for (li < p.config.cascade_lib_count) {
        var retained: manifest.LinkRequirement = p.config.cascade_libs[li];
        retained.symbols      = nil;
        retained.symbol_count = 0;
        val pushed: res[usize, A.Error] = vector.push[manifest.LinkRequirement](?u.export_links, retained);
        if (sel pushed.err) {
            ret err[outcome.Fail].err{outcome.refused(pushed.err)};
        }
        li = li + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun selected_unit_count(bp: *BuildPlan) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < bp.units.len) {
        if (!bp.units.data[i].is_required) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun unit_already_planned(bp: *BuildPlan, aname: str, tgt: intern.StrId, want_lib: bool) bool {
    var i: usize = 0;
    for (i < bp.units.len) {
        val u: *BuildUnit = ?bp.units.data[i];
        if (u.target_entry.name == tgt && u.want_lib == want_lib
            && str_equals(u.sel_artifact, aname)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun plan_cell(a: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry,
              m: *manifest.Manifest, req: *request.BuildRequest, bp: *BuildPlan,
              tname: str, aname: str, want_lib: bool, has_artifact: bool,
              is_required: bool) err[outcome.Fail] {
    var cell_req: request.BuildRequest = @req;
    if (is_required && req.goal != request.GOAL_CHECK) { cell_req.goal = request.GOAL_EXECUTE; }
    val ur: res[BuildUnit, outcome.Fail] = plan_unit(a, itn, reg, m, ?cell_req,
        tname, aname, want_lib, has_artifact, is_required);
    if (sel ur.err) {
        ret err[outcome.Fail].err{ur.err};
    }
    var u: BuildUnit = ur.ok;
    if (unit_already_planned(bp, u.sel_artifact, u.target_entry.name, u.want_lib)) {
        ret err[outcome.Fail].ok{};
    }

    var ri: usize = 0;
    for (ri < u.requires.len) {
        val rname: str = u.requires.data[ri];
        val ra: *manifest.ArtifactDef = manifest.find_artifact(itn, m, rname);
        if (ra == nil) {
            ret err[outcome.Fail].err{outcome.internal("internal: a required artifact is not declared")};
        }
        var reached: bool = false;
        var ti: u32 = 0;
        for (ti < m.target_count) {
            if (manifest.required_artifact_uses_target(itn, ra, u.target_entry.name, ?m.targets[ti])) {
                val tn: opt[str] = intern.lookup(itn, m.targets[ti].name);
                if (sel tn.none) {
                    ret err[outcome.Fail].err{outcome.internal("internal: target name not interned")};
                }
                val rr: err[outcome.Fail] = plan_cell(a, itn, reg, m, ?cell_req, bp,
                    tn.some, rname, ra.is_lib, true, true);
                if (sel rr.err) { ret rr; }
                reached = true;
            }
            ti = ti + 1;
        }
        if (!reached) {
            ret err[outcome.Fail].err{outcome.user(join_msg(a,
                "mach.toml: artifact '", u.sel_artifact, "' requires artifact '", rname,
                "', which declares no target this build can produce"))};
        }
        ri = ri + 1;
    }

    val pr: res[usize, A.Error] = vector.push[BuildUnit](?bp.units, u);
    if (sel pr.err) { ret err[outcome.Fail].err{outcome.refused(pr.err)}; }
    ret err[outcome.Fail].ok{};
}

fun no_cells_msg(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest, tsel: str) str {
    var tname: str = "the default target";
    if (!str_empty(tsel)) { tname = join_msg(a, "target '", tsel, "'"); }

    var nb: textbuild.TextBuilder = textbuild.tb_init(a);
    var i: u32 = 0;
    for (i < m.artifact_count) {
        val ao: opt[str] = intern.lookup(itn, m.artifacts[i].name);
        if (sel ao.some) {
            if (textbuild.tb_len(?nb) > 0) { textbuild.tb_append(?nb, ", "); }
            textbuild.tb_append(?nb, ao.some);
        }
        i = i + 1;
    }
    val names_r: res[str, textbuild.Error] = textbuild.tb_finish(?nb);
    var names: str = "<message unavailable: allocation failed>";
    if (sel names_r.ok) { names = names_r.ok; }
    textbuild.tb_dnit(?nb);
    ret join_msg(a, "mach.toml: no artifact declares ", tname, "; declared artifacts: ", names);
}

fun out_conflict_msg(a: *A.Allocator, bp: *BuildPlan) str {
    var cb: textbuild.TextBuilder = textbuild.tb_init(a);
    var i: usize = 0;
    for (i < bp.units.len) {
        if (textbuild.tb_len(?cb) > 0) { textbuild.tb_append(?cb, ", "); }
        var tlabel: str = "the default target";
        if (!str_empty(bp.units.data[i].sel_target)) { tlabel = bp.units.data[i].sel_target; }
        textbuild.tb_append(?cb, bp.units.data[i].sel_artifact);
        textbuild.tb_append(?cb, " for ");
        textbuild.tb_append(?cb, tlabel);
        i = i + 1;
    }
    val cells_r: res[str, textbuild.Error] = textbuild.tb_finish(?cb);
    var cells: str = "<message unavailable: allocation failed>";
    if (sel cells_r.ok) { cells = cells_r.ok; }
    textbuild.tb_dnit(?cb);
    ret join_msg(a, "-o names a single output but the selection resolves to several build units (",
        cells, "); narrow it with --bin/--lib and --target");
}

fun oom_plan() res[BuildPlan, outcome.Fail] {
    ret res[BuildPlan, outcome.Fail].err{outcome.internal("out of memory")};
}

fun cell_declared(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest,
                  tname: str, aname: str, want_lib: bool) res[bool, outcome.Fail] {
    var pick: manifest.Selection;
    pick.target       = tname;
    pick.profile      = "";
    pick.artifact     = aname;
    pick.want_lib     = want_lib;
    pick.has_artifact = true;
    ret manifest.cell_supported(a, itn, m, pick);
}

pub fun replan_unit(a: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry,
                    m: *manifest.Manifest, req: *request.BuildRequest,
                    prior: *BuildUnit) res[BuildUnit, outcome.Fail] {
    val ur: res[BuildUnit, outcome.Fail] = plan_unit(a, itn, reg, m, req,
        prior.sel_target, prior.sel_artifact, prior.want_lib, prior.has_artifact,
        prior.is_required);
    if (sel ur.err) { ret ur; }
    var u: BuildUnit = ur.ok;
    if (!unit_decisions_equal(?u, prior)) {
        ret res[BuildUnit, outcome.Fail].err{outcome.user(
            "the manifest changed after this build was planned; re-run the build")};
    }
    ret res[BuildUnit, outcome.Fail].ok{u};
}

fun unit_decisions_equal(a: *BuildUnit, b: *BuildUnit) bool {
    if (!str_equals(a.profile, b.profile))   { ret false; }
    if (a.opt_level != b.opt_level)          { ret false; }
    if (a.placement_policy != b.placement_policy) { ret false; }
    if (a.goal != b.goal)                    { ret false; }
    if (a.subsystem != b.subsystem)          { ret false; }
    if (a.want_lib != b.want_lib)            { ret false; }
    if (a.has_artifact != b.has_artifact)    { ret false; }
    if (a.is_required != b.is_required)      { ret false; }

    if (a.requires.len != b.requires.len) { ret false; }
    var ri: usize = 0;
    for (ri < a.requires.len) {
        if (!str_equals(a.requires.data[ri], b.requires.data[ri])) { ret false; }
        ri = ri + 1;
    }
    if (a.steps.len != b.steps.len) { ret false; }
    var si: usize = 0;
    for (si < a.steps.len) {
        if (!str_equals(a.steps.data[si], b.steps.data[si])) { ret false; }
        si = si + 1;
    }
    if (!str_equals(a.out_path, b.out_path)) { ret false; }
    if (!str_equals(a.obj_dir, b.obj_dir))   { ret false; }
    if (!str_equals(a.ir_dir, b.ir_dir))     { ret false; }
    if (!str_equals(a.asm_dir, b.asm_dir))   { ret false; }

    if (a.phases.len != b.phases.len) { ret false; }
    var i: usize = 0;
    for (i < a.phases.len) {
        if (a.phases.data[i] != b.phases.data[i]) { ret false; }
        i = i + 1;
    }

    if (a.link_inputs.len != b.link_inputs.len) { ret false; }
    i = 0;
    for (i < a.link_inputs.len) {
        val la: *LinkInput = ?a.link_inputs.data[i];
        val lb: *LinkInput = ?b.link_inputs.data[i];
        if (la.kind != lb.kind)                             { ret false; }
        if (la.include_referenced != lb.include_referenced) { ret false; }
        if (!str_equals(la.text, lb.text))                  { ret false; }
        if (!str_equals(la.library, lb.library))            { ret false; }
        if (!str_equals(la.rpath, lb.rpath))                { ret false; }
        i = i + 1;
    }
    ret true;
}

fun plan_unit(a: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry,
              m: *manifest.Manifest, req: *request.BuildRequest,
              tname: str, aname: str, want_lib: bool, has_artifact: bool,
              is_required: bool) res[BuildUnit, outcome.Fail] {
    var pick: manifest.Selection;
    pick.target       = tname;
    pick.profile      = req.profile;
    pick.artifact     = aname;
    pick.want_lib     = want_lib;
    pick.has_artifact = has_artifact;

    val ur: res[manifest.BuildUnit, outcome.Fail] = manifest.resolve_build_unit(a, itn, reg, m, pick);
    if (sel ur.err) {
        ret res[BuildUnit, outcome.Fail].err{ur.err};
    }
    val bu: manifest.BuildUnit = ur.ok;

    val os_opt: opt[str] = intern.lookup(itn, bu.target.os);
    if (sel os_opt.none) { ret res[BuildUnit, outcome.Fail].err{outcome.user("target os name not interned")}; }
    val os_s: str = os_opt.some;
    val isa_opt: opt[str] = intern.lookup(itn, bu.target.isa);
    if (sel isa_opt.none) { ret res[BuildUnit, outcome.Fail].err{outcome.user("target isa name not interned")}; }
    val isa_s: str = isa_opt.some;
    val abi_opt: opt[str] = intern.lookup(itn, bu.target.abi);
    if (sel abi_opt.none) { ret res[BuildUnit, outcome.Fail].err{outcome.user("target abi name not interned")}; }
    val abi_s: str = abi_opt.some;
    var of_s: str = "";
    val of_opt: opt[str] = intern.lookup(itn, bu.target.of);
    if (sel of_opt.some) { of_s = of_opt.some; }

    val tr: res[target.Target, fail.Fail] = target.select_of(reg, isa_s, os_s, abi_s, of_s);
    if (sel tr.err) {
        ret res[BuildUnit, outcome.Fail].err{outcome.user_fail(tr.err)};
    }
    var tgt: target.Target = tr.ok;

    var u: BuildUnit;
    u.goal         = req.goal;
    u.opt_level    = req.opt;
    u.placement_policy = req.placement_policy;
    u.sel_target   = tname;
    u.sel_artifact = aname;
    u.want_lib     = want_lib;
    u.has_artifact = has_artifact;
    u.is_required  = is_required;

    val rq_r: err[outcome.Fail] = collect_requires(a, itn, m, req, ?bu, tname, ?u);
    if (sel rq_r.err) {
        ret res[BuildUnit, outcome.Fail].err{rq_r.err};
    }

    u.subsystem = of.SUBSYSTEM_CONSOLE;
    if (bu.artifact != nil) { u.subsystem = bu.artifact.subsystem; }
    val flag_subsystem: opt[of.Subsystem] = request.subsystem_from_flag(req.subsystem_flag);
    if (sel flag_subsystem.some) { u.subsystem = flag_subsystem.some; }

    val pn_opt: opt[str] = intern.lookup(itn, bu.profile_name);
    if (sel pn_opt.none) { ret res[BuildUnit, outcome.Fail].err{outcome.user("internal: profile name not interned")}; }
    u.profile = pn_opt.some;

    val ter: res[*project.TargetEntry, A.Error] = A.allocate[project.TargetEntry](a, 1::usize);
    if (sel ter.err) { ret oom_unit(); }
    val te: *project.TargetEntry = ter.ok;
    te.name       = bu.target_name;
    te.os_name    = bu.target.os;
    te.isa_name   = bu.target.isa;
    te.abi_name   = bu.target.abi;
    te.of_name    = bu.target.of;
    te.entrypoint = bu.entry;
    te.mode       = project.MODE_EXECUTABLE;
    if (bu.is_lib) { te.mode = project.MODE_LIBRARY; }
    te.lib_kind   = bu.kind;
    te.opt        = project.map_opt(bu.opt);
    te.libs       = bu.libs;
    te.lib_count  = bu.lib_count;
    u.target_entry = te;

    val root: str = req.project_root;

    val ob_r: res[str, outcome.Fail] = join_template(a, itn, root, bu.obj_root, "project obj output dir: ");
    if (sel ob_r.err) { ret res[BuildUnit, outcome.Fail].err{ob_r.err}; }
    u.obj_dir = ob_r.ok;

    u.ir_dir = "";
    if (req.emit_ir) {
        val ib_r: res[str, outcome.Fail] = join_template(a, itn, root, bu.ir_root, "project ir output dir: ");
        if (sel ib_r.err) { ret res[BuildUnit, outcome.Fail].err{ib_r.err}; }
        u.ir_dir = ib_r.ok;
    }
    u.asm_dir = "";
    if (req.emit_asm) {
        val ab_r: res[str, outcome.Fail] = join_template(a, itn, root, bu.asm_root, "project asm output dir: ");
        if (sel ab_r.err) { ret res[BuildUnit, outcome.Fail].err{ab_r.err}; }
        u.asm_dir = ab_r.ok;
    }

    val op_r: res[str, outcome.Fail] = unit_out_path(a, itn, m, req, ?bu, ?tgt, u.obj_dir, is_required);
    if (sel op_r.err) { ret res[BuildUnit, outcome.Fail].err{op_r.err}; }
    u.out_path = op_r.ok;

    u.link_inputs  = vector.init[LinkInput](a);
    u.dep_steps    = vector.init[str](a);
    u.export_links = vector.init[manifest.LinkRequirement](a);
    u.configured   = false;
    var ti: usize = 0;
    for (ti < req.link_tokens.len) {
        val token: str = req.link_tokens.data[ti].text;
        val lr: res[LinkInput, outcome.Fail] = resolve_token(a, ?tgt, ?req.lib_dirs, root, token::*u8);
        if (sel lr.err) {
            ret res[BuildUnit, outcome.Fail].err{lr.err};
        }
        var input: LinkInput = lr.ok;
        if (!request.is_object_path(token::*u8) && !is_shared_path(token::*u8)
            && !is_dll_path(token::*u8) && !is_dylib_path(token::*u8)) {
            input.library = token;
        }
        val pr: res[usize, A.Error] = vector.push[LinkInput](?u.link_inputs, input);
        if (sel pr.err) { ret oom_unit(); }
        ti = ti + 1;
    }

    val ph_r: err[outcome.Fail] = derive_phases(a, itn, m, req, ?bu, ?tgt, ?u);
    if (sel ph_r.err) {
        ret res[BuildUnit, outcome.Fail].err{ph_r.err};
    }
    ret res[BuildUnit, outcome.Fail].ok{u};
}

fun collect_requires(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest,
                     req: *request.BuildRequest, bu: *manifest.BuildUnit,
                     tname: str, u: *BuildUnit) err[outcome.Fail] {
    u.requires = vector.init[str](a);

    val whole_project: bool = request.test_goal(req.goal);
    val consumer: *manifest.ArtifactDef = bu.artifact;
    if (consumer == nil && !whole_project) { ret err[outcome.Fail].ok{}; }

    var j: u32 = 0;
    for (j < m.artifact_count) {
        if (requires_artifact(itn, m, consumer, ?m.artifacts[j], whole_project)) {
            val no: opt[str] = intern.lookup(itn, m.artifacts[j].name);
            if (sel no.none) {
                ret err[outcome.Fail].err{outcome.internal("internal: artifact name not interned")};
            }
            val pr: res[usize, A.Error] = vector.push[str](?u.requires, no.some);
            if (sel pr.err) {
                ret err[outcome.Fail].err{outcome.internal("out of memory")};
            }
        }
        j = j + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun requires_artifact(itn: *intern.Interner, m: *manifest.Manifest, consumer: *manifest.ArtifactDef,
                      ra: *manifest.ArtifactDef, whole_project: bool) bool {
    if (whole_project) { ret manifest.artifact_required_by_any(itn, m, ra); }
    if (consumer == nil) { ret false; }
    ret manifest.artifact_needs_artifact(itn, consumer, ra);
}

fun oom_unit() res[BuildUnit, outcome.Fail] {
    ret res[BuildUnit, outcome.Fail].err{outcome.internal("out of memory")};
}

fun join_template(a: *A.Allocator, itn: *intern.Interner, root: str, dir_id: intern.StrId, what: str) res[str, outcome.Fail] {
    val opt_tmpl: opt[str] = intern.lookup(itn, dir_id);
    if (sel opt_tmpl.none) {
        ret res[str, outcome.Fail].err{outcome.internal(join_msg(a, what, "template not interned", ""))};
    }
    val jr: res[str, A.Error] = path.join(a, root, opt_tmpl.some);
    if (sel jr.err) {
        ret res[str, outcome.Fail].err{outcome.internal(join_msg(a, what, outcome.alloc_text(jr.err), ""))};
    }
    ret res[str, outcome.Fail].ok{jr.ok};
}

pub fun finished_modules(tgt: *target.Target) bool {
    ret tgt.of != nil && tgt.of.object_is_artifact;
}

fun unit_out_path(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest,
                  req: *request.BuildRequest, bu: *manifest.BuildUnit,
                  tgt: *target.Target, obj_dir: str, is_required: bool) res[str, outcome.Fail] {
    if (req.goal == request.GOAL_CHECK)     { ret res[str, outcome.Fail].ok{""}; }
    if (req.goal == request.GOAL_OBJECTS)   { ret res[str, outcome.Fail].ok{obj_dir}; }
    if (req.goal == request.GOAL_TEST_LIST) { ret res[str, outcome.Fail].ok{""}; }
    if (req.goal == request.GOAL_EXECUTE && finished_modules(tgt)) {
        ret res[str, outcome.Fail].ok{obj_dir};
    }

    if (req.goal == request.GOAL_TESTS) {
        var name: str = "";
        if (bu.artifact != nil) {
            val an_opt: opt[str] = intern.lookup(itn, bu.artifact.name);
            if (sel an_opt.some) { name = an_opt.some; }
        }
        if (str_empty(name)) {
            val id_opt: opt[str] = intern.lookup(itn, m.id);
            if (sel id_opt.some) { name = id_opt.some; }
        }
        if (str_empty(name)) { name = "tests"; }

        val tmpl_opt: opt[str] = intern.lookup(itn, bu.test_root);
        if (sel tmpl_opt.none) { ret test_exe_fail(); }
        val rel_r: res[str, string.StrError] = str_replace(a, tmpl_opt.some, "{name}", name);
        if (sel rel_r.err) { ret test_exe_fail(); }
        val full_r: res[str, A.Error] = path.join(a, req.project_root, rel_r.ok);
        if (sel full_r.err) { ret test_exe_fail(); }
        ret res[str, outcome.Fail].ok{full_r.ok};
    }

    if (!str_empty(req.out) && !is_required) {
        if (!manifest.is_project_path(req.out)) {
            ret res[str, outcome.Fail].err{outcome.user("-o must name a canonical path inside the project root")};
        }
        val op_r: res[str, A.Error] = path.resolve(a, req.project_root, req.out);
        if (sel op_r.err) { ret res[str, outcome.Fail].err{outcome.refused(op_r.err)}; }
        ret res[str, outcome.Fail].ok{op_r.ok};
    }
    val bin_opt: opt[str] = intern.lookup(itn, bu.bin_path);
    if (sel bin_opt.none) {
        ret res[str, outcome.Fail].err{outcome.user("selected artifact has no output path; set the `out` template in mach.toml")};
    }
    if (str_empty(bin_opt.some)) {
        ret res[str, outcome.Fail].err{outcome.user("selected artifact has no output path; set the `out` template in mach.toml")};
    }
    val op_r: res[str, A.Error] = path.join(a, req.project_root, bin_opt.some);
    if (sel op_r.err) { ret res[str, outcome.Fail].err{outcome.refused(op_r.err)}; }
    ret res[str, outcome.Fail].ok{op_r.ok};
}

fun test_exe_fail() res[str, outcome.Fail] {
    ret res[str, outcome.Fail].err{outcome.internal("failed to resolve the test executable path; check the `tests` template in mach.toml")};
}

fun derive_phases(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest,
                  req: *request.BuildRequest, bu: *manifest.BuildUnit,
                  tgt: *target.Target, u: *BuildUnit) err[outcome.Fail] {
    u.phases = vector.init[PhaseKind](a);
    u.steps  = vector.init[str](a);
    if (req.goal == request.GOAL_CHECK) {
        val loaded: err[outcome.Fail] = push_phase(u, PH_LOAD);
        if (sel loaded.err) { ret loaded; }
        ret push_phase(u, PH_SEMA);
    }

    val demanded_r: res[bool, outcome.Fail] = steps_demanded(a, itn, m, req, bu, ?u.steps);
    if (sel demanded_r.err) { ret err[outcome.Fail].err{demanded_r.err}; }
    if (m.dep_count > 0) {
        val r1: err[outcome.Fail] = push_phase(u, PH_DEP_STEPS);
        if (sel r1.err) { ret r1; }
    }
    if (demanded_r.ok) {
        val r2: err[outcome.Fail] = push_phase(u, PH_STEPS);
        if (sel r2.err) { ret r2; }
    }

    val r3: err[outcome.Fail] = push_phase(u, PH_LOAD);
    if (sel r3.err) { ret r3; }
    val r4: err[outcome.Fail] = push_phase(u, PH_SEMA);
    if (sel r4.err) { ret r4; }
    val r5: err[outcome.Fail] = push_phase(u, PH_LOWER);
    if (sel r5.err) { ret r5; }
    if (req.goal == request.GOAL_TEST_LIST) { ret err[outcome.Fail].ok{}; }
    val r6: err[outcome.Fail] = push_phase(u, PH_CODEGEN);
    if (sel r6.err) { ret r6; }

    val flat: bool = tgt.of != nil && tgt.of.produces_image;
    var objects: bool = false;
    if (req.goal == request.GOAL_EXECUTE && !flat) { objects = true; }
    if (req.goal == request.GOAL_OBJECTS)          { objects = true; }
    if (req.goal == request.GOAL_TESTS)            { objects = true; }
    if (objects || req.emit_ir || req.emit_asm) {
        val r7: err[outcome.Fail] = push_phase(u, PH_EMIT);
        if (sel r7.err) { ret r7; }
    }
    if ((req.goal == request.GOAL_EXECUTE && !finished_modules(tgt)) || req.goal == request.GOAL_TESTS) {
        val r8: err[outcome.Fail] = push_phase(u, PH_LINK);
        if (sel r8.err) { ret r8; }
    }
    ret err[outcome.Fail].ok{};
}

fun push_phase(u: *BuildUnit, k: PhaseKind) err[outcome.Fail] {
    val pr: res[usize, A.Error] = vector.push[PhaseKind](?u.phases, k);
    if (sel pr.err) { ret err[outcome.Fail].err{outcome.refused(pr.err)}; }
    ret err[outcome.Fail].ok{};
}

# the root manifest's prerequisite steps this cell demands, appended to `steps`
# in execution order. the same `manifest.plan_steps` the driver runs, so the
# displayed order is the executed order
fun steps_demanded(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest,
                   req: *request.BuildRequest, bu: *manifest.BuildUnit,
                   steps: *Vector[str]) res[bool, outcome.Fail] {
    if (m.step_count == 0) { ret res[bool, outcome.Fail].ok{false}; }

    val pn_opt: opt[str] = intern.lookup(itn, bu.profile_name);
    if (sel pn_opt.none) { ret res[bool, outcome.Fail].ok{false}; }
    var v: manifest.TmplVars = manifest.tmpl_vars_of(itn, bu.target, pn_opt.some);

    val ot_opt: opt[str] = intern.lookup(itn, m.out_tmpl);
    if (sel ot_opt.none) { ret res[bool, outcome.Fail].ok{false}; }
    val po_r: res[str, outcome.Fail] = manifest.expand_project_path(a, ot_opt.some, "", ?v, "[project].out");
    if (sel po_r.err) { ret res[bool, outcome.Fail].err{po_r.err}; }
    val proj_out: str = po_r.ok;

    var names:  *intern.StrId = nil;
    var ncount: u32           = 0;
    var owned:  bool          = false;
    if (request.test_goal(req.goal) && m.artifact_count > 0) {
        val ar: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](a, m.artifact_count::usize);
        if (sel ar.err) { ret res[bool, outcome.Fail].err{outcome.refused(ar.err)}; }
        names = ar.ok;
        owned = true;
        var i: u32 = 0;
        for (i < m.artifact_count) { names[i] = m.artifacts[i].name; i = i + 1; }
        ncount = m.artifact_count;
    }
    or {
        if (bu.artifact == nil) { ret res[bool, outcome.Fail].ok{false}; }
        names  = ?bu.artifact.name;
        ncount = 1;
    }

    var order: *u32 = nil;
    var count: u32  = 0;
    val r: err[outcome.Fail] = manifest.plan_steps(a, itn, m, names, ncount, bu.target, proj_out, ?v, ?order, ?count);
    if (owned) { A.deallocate[intern.StrId](a, names, m.artifact_count::usize); }
    str_free(a, proj_out);
    if (sel r.err) {
        ret res[bool, outcome.Fail].err{r.err};
    }
    fin { if (order != nil && count > 0) { A.deallocate[u32](a, order, count::usize); } }
    var i: u32 = 0;
    for (i < count) {
        val named: opt[str] = intern.lookup(itn, m.steps[order[i]].name);
        if (sel named.none) { ret res[bool, outcome.Fail].err{outcome.internal("planned step name is not interned")}; }
        val pushed: res[usize, A.Error] = vector.push[str](steps, named.some);
        if (sel pushed.err) { ret res[bool, outcome.Fail].err{outcome.refused(pushed.err)}; }
        i = i + 1;
    }
    ret res[bool, outcome.Fail].ok{count > 0};
}

pub fun resolve_token(a: *A.Allocator, tgt: *target.Target, dirs: *Vector[str],
                      root: str, tok: *u8) res[LinkInput, outcome.Fail] {
    if (is_dll_path(tok)) {
        if (!str_equals(tgt.of.shared_input_ext, ".dll")) {
            ret res[LinkInput, outcome.Fail].err{outcome.user(join_msg(a, "'", tok::str, "' is a Windows DLL; .dll inputs require a PE/COFF target"))};
        }
        var actual: *u8 = tok;
        var rooted: str = "";
        val is_file_r: res[bool, io_error.Error] = fs.is_file(tok);
        var exists: bool = (sel is_file_r.ok && is_file_r.ok);
        if (!exists && tok[0] != '/') {
            val cand_r: res[str, A.Error] = path.join(a, root, tok::str);
            if (sel cand_r.ok) {
                rooted = cand_r.ok;
                val is_file_r2: res[bool, io_error.Error] = fs.is_file(rooted);
                if ((sel is_file_r2.ok && is_file_r2.ok)) {
                    actual = rooted::*u8;
                    exists = true;
                }
            }
        }
        if (exists) {
            val res_read: res[Vector[u8], fs.FsError] = fs.read_bytes(a, actual);
            if (sel res_read.err) {
                ret res[LinkInput, outcome.Fail].err{outcome.user(join_msg(a, "cannot read link input '", actual::str, "'"))};
            }
            var b: Vector[u8] = res_read.ok;
            val good: bool = coff.looks_like_dll(b.data, b.len, coff.machine_for_arch(tgt.arch_id));
            vector.dnit[u8](?b);
            if (!good) {
                ret res[LinkInput, outcome.Fail].err{outcome.user(join_msg(a, "'", actual::str,
                    "' is not a loadable PE DLL for the selected architecture"))};
            }
        }
        ret dyn_copy(a, dll_basename(tok));
    }

    if (is_dylib_path(tok)) {
        if (!str_equals(tgt.of.shared_input_ext, ".dylib")) {
            ret res[LinkInput, outcome.Fail].err{outcome.user(join_msg(a, "'", tok::str, "' is a Mach-O dylib; .dylib inputs require a Mach-O target"))};
        }
        var actual: *u8 = tok;
        var rooted: str = "";
        val is_file_r3: res[bool, io_error.Error] = fs.is_file(tok);
        var exists: bool = (sel is_file_r3.ok && is_file_r3.ok);
        if (!exists && tok[0] != '/') {
            val cand_r: res[str, A.Error] = path.join(a, root, tok::str);
            if (sel cand_r.ok) {
                rooted = cand_r.ok;
                val is_file_r4: res[bool, io_error.Error] = fs.is_file(rooted);
                if ((sel is_file_r4.ok && is_file_r4.ok)) {
                    actual = rooted::*u8;
                    exists = true;
                }
            }
        }
        if (exists) {
            var install_name: [4096]u8;
            if (read_dylib_install_name(a, actual, tgt.arch_id, ?install_name[0], 4096)) {
                ret dylib_copy(a, actual, ?install_name[0]);
            }
            ret res[LinkInput, outcome.Fail].err{outcome.user(join_msg(a, "'", actual::str,
                "' is not a loadable Mach-O dylib for the selected architecture"))};
        }
        if (str_starts_with(tok::str, "@rpath/")) {
            ret res[LinkInput, outcome.Fail].err{outcome.user(
                "an @rpath dylib input must resolve to an existing file so its runtime search path can be retained")};
        }
        ret dyn_copy(a, tok);
    }

    if (is_shared_path(tok) && !str_equals(tgt.of.shared_input_ext, ".so")) {
        ret res[LinkInput, outcome.Fail].err{outcome.user(join_msg(a, "'", tok::str,
            "' is an ELF shared object; .so inputs require an ELF target"))};
    }

    var buf: [4096]u8;
    var found: bool = resolve_input_into(tok, dirs, ?buf[0], 4096,
        str_equals(tgt.of.shared_input_ext, ".dll"));

    if (!found && (request.is_object_path(tok) || is_shared_path(tok)) && tok[0] != '/') {
        val cand_r: res[str, A.Error] = path.join(a, root, tok::str);
        if (sel cand_r.ok) {
            val cand: str = cand_r.ok;
            val is_file_r5: res[bool, io_error.Error] = fs.is_file(cand);
            if ((sel is_file_r5.ok && is_file_r5.ok) && str_len(cand) + 1 <= 4096) {
                memory.raw_copy((?buf[0])::ptr, cand::ptr, str_len(cand) + 1);
                found = true;
            }
        }
    }

    if (found && is_shared_path(?buf[0])) {
        var sname: [4096]u8;
        if (read_so_soname(a, ?buf[0], tgt.arch_id, ?sname[0], 4096)) {
            ret dyn_copy(a, ?sname[0]);
        }
        ret res[LinkInput, outcome.Fail].err{outcome.user(join_msg(a, "'", (?buf[0])::str,
            "' is not a loadable ELF shared object for the selected architecture"))};
    }

    if (!found && !request.is_object_path(tok) && !is_shared_path(tok)) {
        var sname: [4096]u8;
        var rpath: [4096]u8;
        rpath[0] = 0;
        if (resolve_shared_into(a, tgt, dirs, tok, ?sname[0], 4096,
                                ?rpath[0], 4096)) {
            ret dyn_copy_with_rpath(a, ?sname[0], ?rpath[0]);
        }
    }

    if (!found) {
        ret res[LinkInput, outcome.Fail].err{outcome.user(join_msg(a, "cannot find link input '", tok::str, "'"))};
    }

    val res_static: res[Vector[u8], fs.FsError] = fs.read_bytes(a, ?buf[0]);
    if (sel res_static.err) {
        ret res[LinkInput, outcome.Fail].err{outcome.user(join_msg(a, "cannot read link input '", (?buf[0])::str, "'"))};
    }
    var sb: Vector[u8] = res_static.ok;
    val sb_ok: bool = ar.is_archive(sb.data, sb.len) || object_matches_target(sb.data, sb.len, tgt);
    vector.dnit[u8](?sb);
    if (!sb_ok) {
        ret res[LinkInput, outcome.Fail].err{outcome.user(join_msg(a, "'", (?buf[0])::str,
            "' is not a valid object or archive for the selected target"))};
    }

    val dup_r: res[str, string.StrError] = str_copy(a, ?buf[0]);
    if (sel dup_r.err) { ret res[LinkInput, outcome.Fail].err{outcome.internal("out of memory")}; }
    var li: LinkInput;
    li.kind = LINK_STATIC;
    li.text = dup_r.ok;
    li.library = "";
    li.rpath = "";
    ret res[LinkInput, outcome.Fail].ok{li};
}

pub fun resolve_requirement(a: *A.Allocator, itn: *intern.Interner, tgt: *target.Target,
                            dirs: *Vector[str], root: str,
                            req: *manifest.LinkRequirement) res[LinkInput, outcome.Fail] {
    val text_opt: opt[str] = intern.lookup(itn, req.text);
    if (sel text_opt.none) {
        ret res[LinkInput, outcome.Fail].err{outcome.internal("link requirement text not interned")};
    }
    val text: str = text_opt.some;
    val library_opt: opt[str] = intern.lookup(itn, req.library);
    if (sel library_opt.none) {
        ret res[LinkInput, outcome.Fail].err{outcome.internal("link requirement library not interned")};
    }
    val library: str = library_opt.some;
    if (req.source == manifest.LINK_FRAMEWORK) {
        val fr: res[LinkInput, outcome.Fail] = resolve_framework(a, tgt, text::*u8);
        if (sel fr.err) { ret fr; }
        var fi: LinkInput = fr.ok;
        fi.library = library;
        fi.include_referenced = req.include_referenced;
        ret res[LinkInput, outcome.Fail].ok{fi};
    }
    var r: res[LinkInput, outcome.Fail] = resolve_token(a, tgt, dirs, root, text::*u8);
    if (sel r.err) { ret r; }
    var li: LinkInput = r.ok;
    li.library = library;
    li.include_referenced = req.include_referenced;
    ret res[LinkInput, outcome.Fail].ok{li};
}

fun resolve_framework(a: *A.Allocator, tgt: *target.Target,
                      name: *u8) res[LinkInput, outcome.Fail] {
    if (tgt.os == nil || !str_equals(tgt.os.name, "darwin")
        || !str_equals(tgt.of.shared_input_ext, ".dylib")) {
        ret res[LinkInput, outcome.Fail].err{outcome.user(
            join_msg(a, "framework link input '", name::str, "' requires a Darwin Mach-O target"))};
    }
    val install_name: str = join_msg(a, "/System/Library/Frameworks/", name::str,
        ".framework/", name::str);
    var li: LinkInput;
    li.kind    = LINK_DYNAMIC;
    li.text    = install_name;
    li.library = "";
    li.rpath   = "";
    ret res[LinkInput, outcome.Fail].ok{li};
}

fun dyn_copy(a: *A.Allocator, name: *u8) res[LinkInput, outcome.Fail] {
    ret dyn_copy_with_rpath(a, name, ""::*u8);
}

fun dyn_copy_with_rpath(a: *A.Allocator, name: *u8,
                        rpath: *u8) res[LinkInput, outcome.Fail] {
    val dup_r: res[str, string.StrError] = str_copy(a, name);
    if (sel dup_r.err) { ret res[LinkInput, outcome.Fail].err{outcome.internal("out of memory")}; }
    var run_path: str = "";
    if (rpath != nil && !str_empty(rpath::str)) {
        val rp_r: res[str, string.StrError] = str_copy(a, rpath);
        if (sel rp_r.err) { ret res[LinkInput, outcome.Fail].err{outcome.internal("out of memory")}; }
        run_path = rp_r.ok;
    }
    var li: LinkInput;
    li.kind    = LINK_DYNAMIC;
    li.text    = dup_r.ok;
    li.library = "";
    li.rpath   = run_path;
    ret res[LinkInput, outcome.Fail].ok{li};
}

fun dylib_copy(a: *A.Allocator, actual: *u8,
               install_name: *u8) res[LinkInput, outcome.Fail] {
    if (!str_starts_with(install_name::str, "@rpath/")) {
        ret dyn_copy(a, install_name);
    }
    val rp_r: res[str, outcome.Fail] = dylib_rpath(a, actual, install_name);
    if (sel rp_r.err) {
        ret res[LinkInput, outcome.Fail].err{rp_r.err};
    }
    ret dyn_copy_with_rpath(a, install_name, rp_r.ok::*u8);
}

fun object_matches_target(buf: *u8, len: usize, tgt: *target.Target) bool {
    if (tgt == nil || tgt.of == nil || buf == nil) { ret false; }
    if (tgt.of.id == of.OF_ELF) {
        if (len < 20 || buf[0] != 0x7F || buf[1] != 0x45 || buf[2] != 0x4C || buf[3] != 0x46) { ret false; }
        val want: u16 = elf.machine_for_arch(tgt.arch_id);
        ret want != 0 && bin.read_u16_le(buf, 18) == want;
    }
    if (tgt.of.id == of.OF_MACHO) {
        if (len < 8 || bin.read_u32_le(buf, 0) != 0xFEEDFACF) { ret false; }
        val want: u32 = macho.machine_for_arch(tgt.arch_id);
        ret want != 0 && bin.read_u32_le(buf, 4) == want;
    }
    if (tgt.of.id == of.OF_COFF) {
        if (len < 4) { ret false; }
        val want: u16 = coff.machine_for_arch(tgt.arch_id);
        if (want == 0) { ret false; }
        val sig1: u16 = bin.read_u16_le(buf, 0);
        if (sig1 == 0) { ret len >= 8 && bin.read_u16_le(buf, 6) == want; }
        ret sig1 == want;
    }
    ret false;
}

pub fun join_msg(al: *A.Allocator, va: ...) str {
    val r: res[str, string.StrError] = str_join(al, va...);
    if (sel r.err) { ret "<message unavailable: allocation failed>"; }
    ret r.ok;
}

fun resolve_input_into(tok: *u8, dirs: *Vector[str], buf: *u8, cap: usize,
                       coff_names: bool) bool {
    if (tok == nil || str_empty(tok::str)) { ret false; }

    if (request.is_object_path(tok)) {
        val n: usize = str_len(tok::str);
        if (n + 1 > cap) { ret false; }
        var i: usize = 0;
        for (i < n) { buf[i] = tok[i]; i = i + 1; }
        buf[n] = 0;
        val is_file_r: res[bool, io_error.Error] = fs.is_file(buf);
        ret (sel is_file_r.ok && is_file_r.ok);
    }

    var i: usize = 0;
    for (i < dirs.len) {
        if (try_named_object(dirs.data[i]::*u8, tok, buf, cap, coff_names)) { ret true; }
        i = i + 1;
    }
    if (try_named_object(nil, tok, buf, cap, coff_names)) { ret true; }
    ret false;
}

fun try_named_object(dir: *u8, name: *u8, buf: *u8, cap: usize,
                     coff_names: bool) bool {
    if (write_named_candidate(dir, "lib", name, "o", buf, cap) && file_present(buf)) { ret true; }
    if (write_named_candidate(dir, "", name, "o", buf, cap) && file_present(buf))    { ret true; }
    if (coff_names && write_named_candidate(dir, "lib", name, "obj", buf, cap) && file_present(buf)) { ret true; }
    if (coff_names && write_named_candidate(dir, "", name, "obj", buf, cap) && file_present(buf))    { ret true; }
    if (write_named_candidate(dir, "lib", name, "a", buf, cap) && file_present(buf)) { ret true; }
    if (write_named_candidate(dir, "", name, "a", buf, cap) && file_present(buf))    { ret true; }
    if (coff_names && write_named_candidate(dir, "lib", name, "lib", buf, cap) && file_present(buf)) { ret true; }
    if (coff_names && write_named_candidate(dir, "", name, "lib", buf, cap) && file_present(buf))    { ret true; }
    ret false;
}

fun file_present(p: *u8) bool {
    val r: res[bool, io_error.Error] = fs.is_file(p);
    ret sel r.ok && r.ok;
}

fun write_named_candidate(dir: *u8, prefix: *u8, name: *u8, ext: *u8, buf: *u8, cap: usize) bool {
    val dl: usize = str_len(dir);
    val pl: usize = str_len(prefix::str);
    val nl: usize = str_len(name::str);
    val el: usize = str_len(ext::str);
    var need: usize = dl;
    if (dl > 0) { need = need + 1; }
    need = need + pl + nl + 1 + el + 1;
    if (need > cap) { ret false; }

    var k: usize = 0;
    var i: usize = 0;
    if (dir != nil) {
        for (i < dl) { buf[k] = dir[i]; k = k + 1; i = i + 1; }
        if (k > 0 && buf[k - 1] != '/') { buf[k] = '/'; k = k + 1; }
    }
    i = 0;
    for (i < pl) { buf[k] = prefix[i]; k = k + 1; i = i + 1; }
    i = 0;
    for (i < nl) { buf[k] = name[i]; k = k + 1; i = i + 1; }
    buf[k] = '.'; k = k + 1;
    i = 0;
    for (i < el) { buf[k] = ext[i]; k = k + 1; i = i + 1; }
    buf[k] = 0;
    ret true;
}

fun read_so_soname(a: *A.Allocator, so_path: *u8, arch_id: u32, out: *u8, cap: usize) bool {
    val res_read: res[Vector[u8], fs.FsError] = fs.read_bytes(a, so_path);
    if (sel res_read.err) { ret false; }
    var b: Vector[u8] = res_read.ok;
    var ok: bool = false;
    val want_machine: u16 = elf.machine_for_arch(arch_id);
    if (want_machine != 0 && b.len >= 64 && b.data[0] == 0x7F && b.data[1] == 0x45 && b.data[2] == 0x4C
        && b.data[3] == 0x46 && b.data[4] == 2 && b.data[5] == 1 && b.data[6] == 1
        && bin.read_u16_le(b.data, 16) == 3
        && bin.read_u16_le(b.data, 18) == want_machine) {
        if (!extract_soname(b.data, b.len, out, cap)) {
            val base: str   = path.filename(so_path::str);
            val bl:   usize = str_len(base);
            if (bl + 1 <= cap) { memory.raw_copy(out::ptr, base::ptr, bl + 1); }
        }
        ok = true;
    }
    vector.dnit[u8](?b);
    ret ok;
}

fun extract_soname(buf: *u8, len: usize, out: *u8, cap: usize) bool {
    val e_shoff:     usize = bin.read_u64_le(buf, 40)::usize;
    val e_shentsize: usize = bin.read_u16_le(buf, 58)::usize;
    val e_shnum:     usize = bin.read_u16_le(buf, 60)::usize;
    if (e_shoff == 0 || e_shnum == 0) { ret false; }

    var dyn_off:    usize = 0;
    var dyn_size:   usize = 0;
    var dynstr_off: usize = 0;
    var sh: usize = 0;
    for (sh < e_shnum) {
        val so: usize = e_shoff + sh * e_shentsize;
        if (so + 64 > len) { ret false; }
        if (bin.read_u32_le(buf, so + 4) == 6) {
            dyn_off  = bin.read_u64_le(buf, so + 24)::usize;
            dyn_size = bin.read_u64_le(buf, so + 32)::usize;
            val link: usize = bin.read_u32_le(buf, so + 40)::usize;
            if (link < e_shnum) {
                val lo: usize = e_shoff + link * e_shentsize;
                if (lo + 64 <= len) { dynstr_off = bin.read_u64_le(buf, lo + 24)::usize; }
            }
        }
        sh = sh + 1;
    }
    if (dyn_off == 0 || dynstr_off == 0) { ret false; }

    var d: usize = 0;
    for (d + 16 <= dyn_size) {
        val eo: usize = dyn_off + d;
        if (eo + 16 > len) { ret false; }
        val tag: u64 = bin.read_u64_le(buf, eo);
        if (tag == 0) { ret false; }
        if (tag == 14) {
            val str_at: usize = dynstr_off + bin.read_u64_le(buf, eo + 8)::usize;
            var k: usize = 0;
            for (str_at + k < len && buf[str_at + k] != 0 && k + 1 < cap) {
                out[k] = buf[str_at + k];
                k = k + 1;
            }
            out[k] = 0;
            ret k > 0;
        }
        d = d + 16;
    }
    ret false;
}

fun read_dylib_install_name(a: *A.Allocator, dylib_path: *u8, arch_id: u32,
                            out: *u8, cap: usize) bool {
    val res_read: res[Vector[u8], fs.FsError] = fs.read_bytes(a, dylib_path);
    if (sel res_read.err) { ret false; }
    var b: Vector[u8] = res_read.ok;
    var ok: bool = false;
    val cpu_type: u32 = macho.machine_for_arch(arch_id);
    if (cpu_type == 0) { vector.dnit[u8](?b); ret false; }
    if (b.len >= 4 && bin.read_u32_le(b.data, 0) == 0xFEEDFACF) {
        ok = extract_dylib_id(b.data, b.len, 0, b.len, cpu_type, out, cap);
    }
    or (b.len >= 8 && bin.read_u32_be(b.data, 0) == 0xCAFEBABE) {
        ok = extract_fat_dylib_id(b.data, b.len, false, cpu_type, out, cap);
    }
    or (b.len >= 8 && bin.read_u32_be(b.data, 0) == 0xCAFEBABF) {
        ok = extract_fat_dylib_id(b.data, b.len, true, cpu_type, out, cap);
    }
    vector.dnit[u8](?b);
    ret ok;
}

fun extract_dylib_id(buf: *u8, len: usize, base: usize, slice_len: usize,
                     cpu_type: u32, out: *u8, cap: usize) bool {
    if (base > len || slice_len > len - base || slice_len < 32) { ret false; }
    val end: usize = base + slice_len;
    if (bin.read_u32_le(buf, base) != 0xFEEDFACF) { ret false; }
    if (bin.read_u32_le(buf, base + 4) != cpu_type) { ret false; }
    if (bin.read_u32_le(buf, base + 12) != 6)     { ret false; }
    val ncmds: u32 = bin.read_u32_le(buf, base + 16);
    val sizeofcmds: usize = bin.read_u32_le(buf, base + 20)::usize;
    if (sizeofcmds > end - (base + 32)) { ret false; }
    val cmds_end: usize = base + 32 + sizeofcmds;

    var off: usize = base + 32;
    var i: u32 = 0;
    for (i < ncmds) {
        if (off + 8 > cmds_end) { ret false; }
        val cmd: u32 = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmdsize < 8 || cmdsize > cmds_end - off) { ret false; }
        if (cmd == 0xD) {
            if (cmdsize < 24) { ret false; }
            val name_off: usize = bin.read_u32_le(buf, off + 8)::usize;
            if (name_off < 24 || name_off >= cmdsize) { ret false; }
            val at: usize = off + name_off;
            var k: usize = 0;
            for (at + k < off + cmdsize && buf[at + k] != 0 && k + 1 < cap) {
                out[k] = buf[at + k];
                k = k + 1;
            }
            if (at + k >= off + cmdsize || buf[at + k] != 0 || k == 0) { ret false; }
            out[k] = 0;
            ret true;
        }
        off = off + cmdsize;
        i = i + 1;
    }
    ret false;
}

fun extract_fat_dylib_id(buf: *u8, len: usize, wide: bool,
                         cpu_type: u32, out: *u8, cap: usize) bool {
    val nfat: usize = bin.read_u32_be(buf, 4)::usize;
    var ent_size: usize = 20;
    if (wide) { ent_size = 32; }
    if (nfat > (len - 8) / ent_size) { ret false; }

    var i: usize = 0;
    for (i < nfat) {
        val ent: usize = 8 + i * ent_size;
        var off: usize = bin.read_u32_be(buf, ent + 8)::usize;
        var size: usize = bin.read_u32_be(buf, ent + 12)::usize;
        if (wide) {
            off  = read_u64_be(buf, ent + 8)::usize;
            size = read_u64_be(buf, ent + 16)::usize;
        }
        if (extract_dylib_id(buf, len, off, size, cpu_type, out, cap)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun read_u64_be(buf: *u8, off: usize) u64 {
    ret (bin.read_u32_be(buf, off)::u64 << 32)
        | bin.read_u32_be(buf, off + 4)::u64;
}

fun is_shared_path(tok: *u8) bool {
    if (tok == nil) { ret false; }
    ret str_ends_with(tok::str, ".so") || str_contains(tok::str, ".so.");
}

fun is_dll_path(tok: *u8) bool {
    if (tok == nil) { ret false; }
    val n: usize = str_len(tok::str);
    if (n < 4) { ret false; }
    val d:  u8 = tok[n - 4];
    val l1: u8 = tok[n - 3] | 0x20;
    val l2: u8 = tok[n - 2] | 0x20;
    val l3: u8 = tok[n - 1] | 0x20;
    ret d == '.' && l1 == 'd' && l2 == 'l' && l3 == 'l';
}

fun is_dylib_path(tok: *u8) bool {
    if (tok == nil) { ret false; }
    val n: usize = str_len(tok::str);
    if (n < 6) { ret false; }
    val d:  u8 = tok[n - 6];
    val l1: u8 = tok[n - 5] | 0x20;
    val l2: u8 = tok[n - 4] | 0x20;
    val l3: u8 = tok[n - 3] | 0x20;
    val l4: u8 = tok[n - 2] | 0x20;
    val l5: u8 = tok[n - 1] | 0x20;
    ret d == '.' && l1 == 'd' && l2 == 'y' && l3 == 'l' && l4 == 'i' && l5 == 'b';
}

fun dll_basename(path: *u8) *u8 {
    val n: usize = str_len(path::str);
    var last: usize = 0;
    var i: usize = 0;
    for (i < n) {
        if (path[i] == '/' || path[i] == '\\') { last = i + 1; }
        i = i + 1;
    }
    ret (path::usize + last)::*u8;
}

fun resolve_shared_into(a: *A.Allocator, tgt: *target.Target, dirs: *Vector[str],
                        name: *u8, buf: *u8, cap: usize,
                        rpath: *u8, rpath_cap: usize) bool {
    if (str_equals(tgt.of.shared_input_ext, ".dylib")) {
        ret resolve_dylib_into(a, tgt, dirs, name, buf, cap, rpath, rpath_cap);
    }
    if (!str_equals(tgt.of.shared_input_ext, ".so")) { ret false; }
    ret resolve_elf_shared_into(a, tgt, dirs, name, buf, cap);
}

fun resolve_elf_shared_into(a: *A.Allocator, tgt: *target.Target, dirs: *Vector[str],
                            name: *u8, buf: *u8, cap: usize) bool {
    var i: usize = 0;
    for (i < dirs.len) {
        if (try_shared_in_dir(a, dirs.data[i]::*u8, name, tgt.arch_id, buf, cap)) { ret true; }
        i = i + 1;
    }
    var li: u32 = 0;
    for (li < tgt.fs_policy.libdir_len) {
        val ld: str = tgt.fs_policy.libdirs[li];
        if (!str_empty(ld) && try_shared_in_dir(a, ld::*u8, name, tgt.arch_id, buf, cap)) { ret true; }
        li = li + 1;
    }
    ret false;
}

fun resolve_dylib_into(a: *A.Allocator, tgt: *target.Target, dirs: *Vector[str],
                       name: *u8, buf: *u8, cap: usize,
                       rpath: *u8, rpath_cap: usize) bool {
    var i: usize = 0;
    for (i < dirs.len) {
        if (try_dylib_in_dir(a, dirs.data[i]::*u8, name, tgt.arch_id, buf, cap,
                             rpath, rpath_cap)) { ret true; }
        i = i + 1;
    }
    var li: u32 = 0;
    for (li < tgt.fs_policy.libdir_len) {
        val ld: str = tgt.fs_policy.libdirs[li];
        if (!str_empty(ld) && try_dylib_in_dir(a, ld::*u8, name, tgt.arch_id, buf, cap,
                                               rpath, rpath_cap)) { ret true; }
        li = li + 1;
    }
    ret false;
}

fun try_dylib_in_dir(a: *A.Allocator, dir: *u8, name: *u8,
                     arch_id: u32, buf: *u8, cap: usize,
                     rpath: *u8, rpath_cap: usize) bool {
    var cand: [4096]u8;
    if (write_named_candidate(dir, "lib", name, "dylib", ?cand[0], 4096)
        && accept_dylib(a, ?cand[0], arch_id, buf, cap)) {
        ret dylib_rpath_into(a, ?cand[0], buf, rpath, rpath_cap);
    }
    var v: i64 = 6;
    for (v >= 0) {
        if (write_named_dylib_version(dir, name, v::u32, ?cand[0], 4096)
            && accept_dylib(a, ?cand[0], arch_id, buf, cap)) {
            ret dylib_rpath_into(a, ?cand[0], buf, rpath, rpath_cap);
        }
        v = v - 1;
    }
    ret false;
}

fun dylib_rpath_into(a: *A.Allocator, candidate: *u8, install_name: *u8,
                     out: *u8, cap: usize) bool {
    if (out == nil || cap == 0) { ret false; }
    out[0] = 0;
    if (!str_starts_with(install_name::str, "@rpath/")) { ret true; }
    val rp_r: res[str, outcome.Fail] = dylib_rpath(a, candidate, install_name);
    if (sel rp_r.err) { ret false; }
    val rp: str = rp_r.ok;
    val n: usize = str_len(rp);
    if (n + 1 > cap) { ret false; }
    memory.raw_copy(out::ptr, rp::ptr, n + 1);
    ret true;
}

# an install name is always darwin-flavoured, so its separators are '/', while
# the candidate has been resolved through the host's native separators
fun ends_with_install_suffix(abs: str, suffix: str) bool {
    val abs_len: usize = str_len(abs);
    val suffix_len: usize = str_len(suffix);
    if (suffix_len > abs_len) { ret false; }
    val at: usize = abs_len - suffix_len;
    var i: usize = 0;
    for (i < suffix_len) {
        val have: u8 = abs[at + i];
        val want: u8 = suffix[i];
        if (have != want && !(path.is_separator(have) && path.is_separator(want))) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun dylib_rpath(a: *A.Allocator, candidate: *u8,
                install_name: *u8) res[str, outcome.Fail] {
    val abs_r: res[str, outcome.Fail] = resolve_from_cwd(a, candidate::str);
    if (sel abs_r.err) { ret abs_r; }
    val abs: str = abs_r.ok;
    val suffix: str = (install_name::usize + 7)::str;
    if (!str_contains(suffix, "/")) {
        val parent_r: res[path.Path, A.Error] = path.parent(a, abs);
        if (sel parent_r.err) { ret res[str, outcome.Fail].err{outcome.refused(parent_r.err)}; }
        ret res[str, outcome.Fail].ok{parent_r.ok};
    }
    val abs_len: usize = str_len(abs);
    val suffix_len: usize = str_len(suffix);
    if (suffix_len == 0 || suffix[0] == '/' || abs_len <= suffix_len
        || !ends_with_install_suffix(abs, suffix)) {
        ret res[str, outcome.Fail].err{outcome.user("the selected dylib path does not match its @rpath install-name suffix")};
    }
    var cut: usize = abs_len - suffix_len;
    if (!path.is_separator(abs[cut - 1])) {
        ret res[str, outcome.Fail].err{outcome.user("the selected dylib path does not match its @rpath install-name suffix")};
    }
    if (cut > 1) { cut = cut - 1; }
    (abs::*u8)[cut] = 0;
    ret res[str, outcome.Fail].ok{abs};
}

fun resolve_from_cwd(a: *A.Allocator, p: str) res[str, outcome.Fail] {
    if (path.is_abs(p)) {
        val clone_r: res[path.Path, A.Error] = path.clone(a, p);
        if (sel clone_r.err) { ret res[str, outcome.Fail].err{outcome.refused(clone_r.err)}; }
        ret res[str, outcome.Fail].ok{clone_r.ok};
    }
    val cwd_r: res[string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel cwd_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.env_text(cwd_r.err))}; }
    var cwd: string.OwnedString = cwd_r.ok;
    val resolve_r: res[path.Path, A.Error] = path.resolve(a, cwd.data, p);
    string.owned_release(?cwd);
    if (sel resolve_r.err) { ret res[str, outcome.Fail].err{outcome.refused(resolve_r.err)}; }
    ret res[str, outcome.Fail].ok{resolve_r.ok};
}

fun accept_dylib(a: *A.Allocator, cand: *u8, arch_id: u32,
                 buf: *u8, cap: usize) bool {
    val is_file_r: res[bool, io_error.Error] = fs.is_file(cand);
    if (!(sel is_file_r.ok && is_file_r.ok)) { ret false; }
    ret read_dylib_install_name(a, cand, arch_id, buf, cap);
}

fun write_named_dylib_version(dir: *u8, name: *u8, v: u32,
                              buf: *u8, cap: usize) bool {
    if (v > 9) { ret false; }
    val dl: usize = str_len(dir);
    val nl: usize = str_len(name::str);
    val need: usize = dl + 1 + 3 + nl + 1 + 1 + 6 + 1;
    if (need > cap) { ret false; }
    var k: usize = 0;
    var i: usize = 0;
    for (i < dl) { buf[k] = dir[i]; k = k + 1; i = i + 1; }
    if (k > 0 && buf[k - 1] != '/') { buf[k] = '/'; k = k + 1; }
    buf[k] = 'l'; buf[k + 1] = 'i'; buf[k + 2] = 'b'; k = k + 3;
    i = 0;
    for (i < nl) { buf[k] = name[i]; k = k + 1; i = i + 1; }
    buf[k] = '.'; buf[k + 1] = ('0'::u32 + v)::u8; buf[k + 2] = '.'; k = k + 3;
    val ext: str = "dylib";
    i = 0;
    for (i < 5) { buf[k] = ext[i]; k = k + 1; i = i + 1; }
    buf[k] = 0;
    ret true;
}

fun try_shared_in_dir(a: *A.Allocator, dir: *u8, name: *u8, arch_id: u32, buf: *u8, cap: usize) bool {
    var cand: [4096]u8;
    if (write_named_candidate(dir, "lib", name, "so", ?cand[0], 4096) && accept_shared(a, ?cand[0], arch_id, buf, cap)) { ret true; }
    var v: i64 = 6;
    for (v >= 0) {
        if (write_named_versioned(dir, name, v::u32, ?cand[0], 4096) && accept_shared(a, ?cand[0], arch_id, buf, cap)) { ret true; }
        v = v - 1;
    }
    ret false;
}

fun accept_shared(a: *A.Allocator, cand: *u8, arch_id: u32, buf: *u8, cap: usize) bool {
    val is_file_r: res[bool, io_error.Error] = fs.is_file(cand);
    if (!(sel is_file_r.ok && is_file_r.ok)) { ret false; }
    if (read_so_soname(a, cand, arch_id, buf, cap)) { ret true; }
    ret false;
}

fun write_named_versioned(dir: *u8, name: *u8, v: u32, buf: *u8, cap: usize) bool {
    if (v > 9)                                                    { ret false; }
    if (!write_named_candidate(dir, "lib", name, "so", buf, cap)) { ret false; }
    val n: usize = str_len(buf::str);
    if (n + 3 > cap) { ret false; }
    buf[n]     = '.';
    buf[n + 1] = ('0'::u32 + v)::u8;
    buf[n + 2] = 0;
    ret true;
}

# render the effective plan: one block per selected cell, naming the project,
# target, profile, artifact, entry, output paths, ordered prerequisite steps and
# link requirements. a plan the caller never configured says so instead of
# claiming an empty dependency closure. a phase outside the catalog is an
# internal failure whose message `a` owns
# ---
# w: the sink; `explain` passes stdout
# p: the plan
# itn: resolves interned names
pub fun render(a: *A.Allocator, w: *writer.Writer, p: *BuildPlan, itn: *intern.Interner) err[outcome.Fail] {
    format.format(w, "plan:    {}\n", p.request.project_root);
    format.format(w, "project: {}\n", p.project);
    format.format(w, "units:   {}\n", p.units.len::i64);

    var i: usize = 0;
    for (i < p.units.len) {
        val u: *BuildUnit = ?p.units.data[i];
        format.write_str(w, "\n");
        format.format(w, "unit {}: {} ({})  target {}  profile {}\n",
            (i + 1)::i64, unit_artifact_label(u), unit_kind_label(u),
            entry_name(itn, u.target_entry.name), u.profile);
        format.format(w, "  goal    {}\n", request.goal_name(u.goal));
        format.format(w, "  tuple   {}-{}-{}\n",
            entry_name(itn, u.target_entry.isa_name),
            entry_name(itn, u.target_entry.os_name),
            entry_name(itn, u.target_entry.abi_name));
        format.format(w, "  opt     {}\n", opt_name(u.opt_level));
        format.format(w, "  entry   {}\n", entry_name(itn, u.target_entry.entrypoint));
        if (!str_empty(u.out_path)) { format.format(w, "  out     {}\n", u.out_path); }
        format.format(w, "  obj     {}\n", u.obj_dir);
        if (!str_empty(u.ir_dir))  { format.format(w, "  ir      {}\n", u.ir_dir); }
        if (!str_empty(u.asm_dir)) { format.format(w, "  asm     {}\n", u.asm_dir); }

        var ri: usize = 0;
        for (ri < u.requires.len) {
            format.format(w, "  need    artifact {}\n", u.requires.data[ri]);
            ri = ri + 1;
        }
        var di: usize = 0;
        for (di < u.dep_steps.len) {
            format.format(w, "  step    dependency {}\n", u.dep_steps.data[di]);
            di = di + 1;
        }
        var si: usize = 0;
        for (si < u.steps.len) {
            format.format(w, "  step    project {}\n", u.steps.data[si]);
            si = si + 1;
        }

        var mi: u32 = 0;
        for (mi < u.target_entry.lib_count) {
            format.format(w, "  link    manifest {}\n", link_requirement_label(itn, ?u.target_entry.libs[mi]));
            mi = mi + 1;
        }
        var ei: usize = 0;
        for (ei < u.export_links.len) {
            format.format(w, "  link    dependency export {}\n", link_requirement_label(itn, ?u.export_links.data[ei]));
            ei = ei + 1;
        }
        var li: usize = 0;
        for (li < u.link_inputs.len) {
            val inp: *LinkInput = ?u.link_inputs.data[li];
            if (inp.kind == LINK_STATIC) { format.format(w, "  link    static  {}\n", inp.text); }
            or {
                format.format(w, "  link    dynamic {}\n", inp.text);
                if (!str_empty(inp.rpath)) { format.format(w, "  rpath   {}\n", inp.rpath); }
            }
            li = li + 1;
        }

        format.write_str(w, "  phases  ");
        var pi: usize = 0;
        for (pi < u.phases.len) {
            if (pi > 0) { format.write_str(w, " -> "); }
            val name: opt[str] = phase_name(u.phases.data[pi]);
            if (sel name.none) {
                ret err[outcome.Fail].err{unknown_phase(a, u.phases.data[pi])};
            }
            format.write_str(w, name.some);
            pi = pi + 1;
        }
        format.write_str(w, "\n");

        if (!u.configured) {
            format.write_str(w, "  deps    not resolved: this plan was not configured against the dependency closure\n");
        }
        if (u.dep_steps.len != 0 || u.steps.len != 0 || u.requires.len != 0) {
            format.write_str(w, "  inputs  generated bytes are unresolved until the prerequisites above run\n");
        }
        i = i + 1;
    }
    format.write_str(w, "\nthis plan reports the selected build. it does not read generated bytes, and it does not claim the link succeeds\n");
    ret err[outcome.Fail].ok{};
}

pub fun explain(a: *A.Allocator, p: *BuildPlan, itn: *intern.Interner) err[outcome.Fail] {
    var w: writer.Writer = fs.writer(fs.STDOUT);
    ret render(a, ?w, p, itn);
}

fun link_requirement_label(itn: *intern.Interner, l: *manifest.LinkRequirement) str {
    if (l.source == manifest.LINK_LOCAL) { ret entry_name(itn, l.text); }
    ret entry_name(itn, l.library);
}

fun unit_artifact_label(u: *BuildUnit) str {
    if (u.has_artifact) { ret u.sel_artifact; }
    ret "(default)";
}

fun unit_kind_label(u: *BuildUnit) str {
    if (u.target_entry.mode == project.MODE_LIBRARY) {
        if (u.target_entry.lib_kind == manifest.LIBKIND_SHARED) { ret "lib shared"; }
        ret "lib static";
    }
    ret "bin";
}

fun entry_name(itn: *intern.Interner, id: intern.StrId) str {
    val o: opt[str] = intern.lookup(itn, id);
    if (sel o.some) { ret o.some; }
    ret "(default)";
}

fun opt_name(level: u8) str {
    if (level == pipeline.OPT_RELEASE) { ret "release"; }
    ret "debug";
}

# the name of a declared build phase, absent for an unknown catalog member
pub fun phase_name(k: PhaseKind) opt[str] {
    if (k == PH_DEP_STEPS) { ret opt[str].some{"dep steps"}; }
    if (k == PH_LOAD)      { ret opt[str].some{"load"}; }
    if (k == PH_STEPS)     { ret opt[str].some{"steps"}; }
    if (k == PH_SEMA)      { ret opt[str].some{"sema"}; }
    if (k == PH_LOWER)     { ret opt[str].some{"lower"}; }
    if (k == PH_CODEGEN)   { ret opt[str].some{"codegen"}; }
    if (k == PH_EMIT)      { ret opt[str].some{"emit"}; }
    if (k == PH_LINK)      { ret opt[str].some{"link"}; }
    ret opt[str].none{};
}

# an internal catalog failure with a caller-owned message
pub fun unknown_phase(a: *A.Allocator, k: PhaseKind) outcome.Fail {
    ret outcome.unknown_catalog(a, "PhaseKind", k::u32);
}

fun ut_manifest_src(a: *A.Allocator, itn: *intern.Interner, src: str, out_m: *manifest.Manifest) bool {
    val source_r: err[outcome.Fail] = manifest.validate_source_text(src);
    if (sel source_r.err) { ret false; }
    val tr: res[toml.Table, toml.TomlError] = toml.parse(a, src);
    if (sel tr.err) { ret false; }
    var t: toml.Table = tr.ok;
    val mr: res[manifest.Manifest, outcome.Fail] = manifest.parse(a, itn, ?t, true);
    toml.dnit(a, ?t);
    if (sel mr.err) { ret false; }
    @out_m = mr.ok;
    ret true;
}

fun ut_manifest(a: *A.Allocator, itn: *intern.Interner, out_m: *manifest.Manifest) bool {
    ret ut_manifest_src(a, itn, "[project]\nid = \"p\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n[target.ta]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n[target.tb]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n[artifact.appa]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/appa\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[artifact.libb]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/libb.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n", out_m);
}

fun ut_scaffold(alloc: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry, m: *manifest.Manifest) bool {
    val make_r: err[A.Error] = page.make(alloc);
    if (sel make_r.err)              { ret false; }
    @itn = intern.init(alloc);
    @reg = target.registry_init();
    val register_all_r: err[fail.Fail] = target.register_all(reg, target_testing.debug_descriptor);
    if (sel register_all_r.err) { ret false; }
    if (!ut_manifest(alloc, itn, m))                   { ret false; }
    ret true;
}

fun ut_scaffold_src(alloc: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry, m: *manifest.Manifest, src: str) bool {
    val make_r: err[A.Error] = page.make(alloc);
    if (sel make_r.err)              { ret false; }
    @itn = intern.init(alloc);
    @reg = target.registry_init();
    val register_all_r: err[fail.Fail] = target.register_all(reg, target_testing.debug_descriptor);
    if (sel register_all_r.err) { ret false; }
    if (!ut_manifest_src(alloc, itn, src, m))          { ret false; }
    ret true;
}

fun ut_path_eq(a: str, b: str) bool {
    if (a == nil) { ret str_empty(b); }
    if (b == nil) { ret str_empty(a); }
    if (a == b)   { ret true; }

    var i: usize = 0;
    for (a[i] != 0 && b[i] != 0) {
        var ca: char = a[i];
        var cb: char = b[i];
        if (ca == 92) { ca = 47; }
        if (cb == 92) { cb = 47; }
        if (ca != cb) { ret false; }
        i = i + 1;
    }

    ret a[i] == b[i];
}

fun ut_write_dylib(path_: str, install_name: str, cpu_type: u32) bool {
    var buf: [160]u8;
    var i: usize = 0;
    for (i < 160) { buf[i] = 0; i = i + 1; }
    if (!ut_fill_dylib(?buf[0], 0, install_name, cpu_type)) { ret false; }
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(path_, ?buf[0], 128, 420);
    ret sel write_bytes_r.ok;
}

fun ut_fill_dylib(buf: *u8, off: usize, install_name: str,
                  cpu_type: u32) bool {
    val name_len: usize = str_len(install_name);
    if (name_len + 1 > 72) { ret false; }

    bin.write_u32_le(buf, off, 0xFEEDFACF);
    bin.write_u32_le(buf, off + 4, cpu_type);
    bin.write_u32_le(buf, off + 8, 3);
    bin.write_u32_le(buf, off + 12, 6);
    bin.write_u32_le(buf, off + 16, 1);
    bin.write_u32_le(buf, off + 20, 96);
    bin.write_u32_le(buf, off + 32, 0xD);
    bin.write_u32_le(buf, off + 36, 96);
    bin.write_u32_le(buf, off + 40, 24);
    memory.raw_copy((buf::usize + off + 56)::ptr, install_name::ptr, name_len);
    ret true;
}

fun ut_temp_dir(a: *A.Allocator) res[str, outcome.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(a, "mach_plan_dylib");
    if (sel tf_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.fs_text(tf_r.err))}; }
    var tf: fs.TempFile = tf_r.ok;
    val root_r: res[str, string.StrError] = str_copy(a, fs.temp_path(?tf)::*u8);
    fs.temp_close_and_remove(?tf);
    if (sel root_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(root_r.err))}; }
    val root: str = root_r.ok;
    val mk: err[fs.FsError] = fs.create_dir_all(a, root, 493);
    if (sel mk.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.fs_text(mk.err))}; }
    ret res[str, outcome.Fail].ok{root};
}

test "mach.lang.build.plan.resolve_input_into:coff_static_suffixes" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val root_r: res[str, outcome.Fail] = ut_temp_dir(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    val lib_r: res[str, A.Error] = path.join(?alloc, root, "libmingw32.lib");
    if (sel lib_r.err) { fs.remove_all(?alloc, root); ret 1; }
    val lib: str = lib_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(lib, "!<arch>\n", 8, 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        ret 1;
    }

    var dirs: Vector[str] = vector.init[str](?alloc);
    val push_r: res[usize, A.Error] = vector.push[str](?dirs, root);
    if (sel push_r.err) {
        fs.remove_all(?alloc, root);
        ret 1;
    }
    var buf: [4096]u8;
    val named: bool = resolve_input_into("mingw32"::*u8, ?dirs, ?buf[0], 4096, true);
    val explicit: bool = resolve_input_into(lib::*u8, ?dirs, ?buf[0], 4096, false);
    fs.remove_all(?alloc, root);
    if (!named || !explicit) { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.resolve_token:linux_ignores_bare_coff_lib" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val register_all_r: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel register_all_r.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    val root_r: res[str, outcome.Fail] = ut_temp_dir(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    val lib_r: res[str, A.Error] = path.join(?alloc, root, "libfoo.lib");
    val so_r: res[str, A.Error] = path.join(?alloc, root, "libfoo.so");
    if (sel lib_r.err) {
        fs.remove_all(?alloc, root); ret 1;
    }
    if (sel so_r.err) {
        fs.remove_all(?alloc, root); ret 1;
    }
    val lib: str = lib_r.ok;
    val so: str = so_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(lib, "!<arch>\n", 8, 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root); ret 1;
    }
    if (!ut_write_elf_object(so, 62, true)) {
        fs.remove_all(?alloc, root); ret 1;
    }

    var dirs: Vector[str] = vector.init[str](?alloc);
    val push_r: res[usize, A.Error] = vector.push[str](?dirs, root);
    if (sel push_r.err) {
        fs.remove_all(?alloc, root); ret 1;
    }
    val rr: res[LinkInput, outcome.Fail] = resolve_token(?alloc, ?tgt, ?dirs, "", "foo"::*u8);
    var explicit_buf: [4096]u8;
    val explicit: bool =
        resolve_input_into(lib::*u8, ?dirs, ?explicit_buf[0], 4096, false);
    fs.remove_all(?alloc, root);
    if (sel rr.err) { ret 1; }
    if (!explicit) { ret 1; }
    val input: LinkInput = rr.ok;
    if (input.kind != LINK_DYNAMIC || !str_equals(input.text, "libfoo.so")) { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.resolve_token:elf_shared_machine_matches_target" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val register_all_r: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel register_all_r.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "aarch64", "linux", "aapcs64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    val root_r: res[str, outcome.Fail] = ut_temp_dir(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    val host_r: res[str, A.Error] = path.join(?alloc, root, "libfoo.so");
    val target_r: res[str, A.Error] = path.join(?alloc, root, "libfoo.so.6");
    if (sel host_r.err) {
        fs.remove_all(?alloc, root);
        ret 1;
    }
    if (sel target_r.err) {
        fs.remove_all(?alloc, root);
        ret 1;
    }
    val host: str = host_r.ok;
    val target_so: str = target_r.ok;
    if (!ut_write_elf_object(host, 62, true) || !ut_write_elf_object(target_so, 183, true)) {
        fs.remove_all(?alloc, root);
        ret 1;
    }

    var dirs: Vector[str] = vector.init[str](?alloc);
    val push_r: res[usize, A.Error] = vector.push[str](?dirs, root);
    if (sel push_r.err) {
        fs.remove_all(?alloc, root);
        ret 1;
    }
    val named: res[LinkInput, outcome.Fail] = resolve_token(?alloc, ?tgt, ?dirs, "", "foo"::*u8);
    val explicit: res[LinkInput, outcome.Fail] = resolve_token(?alloc, ?tgt, ?dirs, "", host::*u8);
    fs.remove_all(?alloc, root);
    if (sel named.err) { ret 1; }
    if (sel explicit.ok) { ret 1; }
    val input: LinkInput = named.ok;
    if (input.kind != LINK_DYNAMIC || !str_equals(input.text, "libfoo.so.6")) { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.resolve_token:darwin_dylib_install_name" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val register_all_r: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel register_all_r.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "darwin", "sysv64");
    val ar: res[target.Target, fail.Fail] = target.select(?reg, "aarch64", "darwin", "aapcs64");
    if (sel tr.err) { ret 1; }
    if (sel ar.err) { ret 1; }
    var tgt: target.Target = tr.ok;
    var arm: target.Target = ar.ok;

    val root_r: res[str, outcome.Fail] = ut_temp_dir(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    val dylib_r: res[str, A.Error] = path.join(?alloc, root, "libglfw.dylib");
    val elf_r: res[str, A.Error] = path.join(?alloc, root, "libhostonly.so");
    if (sel dylib_r.err) {
        fs.remove_all(?alloc, root);
        ret 1;
    }
    if (sel elf_r.err) {
        fs.remove_all(?alloc, root);
        ret 1;
    }
    val dylib: str = dylib_r.ok;
    val elf: str = elf_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(elf, "ELF", 3, 420);
    if (!ut_write_dylib(dylib, "@rpath/libglfw.3.dylib", 0x01000007)) {
        fs.remove_all(?alloc, root);
        ret 1;
    }
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        ret 1;
    }

    var dirs: Vector[str] = vector.init[str](?alloc);
    val push_r: res[usize, A.Error] = vector.push[str](?dirs, root);
    if (sel push_r.err) {
        fs.remove_all(?alloc, root);
        ret 1;
    }
    val rr: res[LinkInput, outcome.Fail] = resolve_token(?alloc, ?tgt, ?dirs, "", "glfw"::*u8);
    if (sel rr.err) {
        fs.remove_all(?alloc, root);
        ret 1;
    }
    val li: LinkInput = rr.ok;
    if (li.kind != LINK_DYNAMIC || !str_equals(li.text, "@rpath/libglfw.3.dylib")
        || !str_equals(li.rpath, root)) {
        fs.remove_all(?alloc, root);
        ret 1;
    }

    val wrong_arch: res[LinkInput, outcome.Fail] = resolve_token(?alloc, ?arm, ?dirs, "", "glfw"::*u8);
    if (sel wrong_arch.ok) {
        fs.remove_all(?alloc, root);
        ret 1;
    }

    val wrong_format: res[LinkInput, outcome.Fail] = resolve_token(?alloc, ?tgt, ?dirs, "", elf::*u8);
    if (sel wrong_format.ok) {
        fs.remove_all(?alloc, root);
        ret 1;
    }

    val host_only: res[LinkInput, outcome.Fail] = resolve_token(?alloc, ?tgt, ?dirs, "", "hostonly"::*u8);
    fs.remove_all(?alloc, root);
    if (sel host_only.ok) { ret 1; }
    ret 0;
}

fun ut_write_elf_object(path_: str, machine: u16, is_shared: bool) bool {
    var buf: [64]u8;
    var i: usize = 0;
    for (i < 64) { buf[i] = 0; i = i + 1; }
    buf[0] = 0x7F; buf[1] = 0x45; buf[2] = 0x4C; buf[3] = 0x46;
    buf[4] = 2; buf[5] = 1; buf[6] = 1;
    var e_type: u16 = 1;
    if (is_shared) { e_type = 3; }
    bin.write_u16_le(?buf[0], 16, e_type);
    bin.write_u16_le(?buf[0], 18, machine);
    bin.write_u16_le(?buf[0], 52, 64);
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(path_, ?buf[0], 64, 420);
    ret sel write_bytes_r.ok;
}

fun ut_write_dll(path_: str, machine: u16, is_dll: bool) bool {
    var buf: [128]u8;
    var i: usize = 0;
    for (i < 128) { buf[i] = 0; i = i + 1; }
    buf[0] = 'M'; buf[1] = 'Z';
    bin.write_u32_le(?buf[0], 0x3C, 64);
    bin.write_u32_le(?buf[0], 64, 0x00004550);
    bin.write_u16_le(?buf[0], 68, machine);
    var characteristics: u16 = 0;
    if (is_dll) { characteristics = 0x2000; }
    bin.write_u16_le(?buf[0], 86, characteristics);
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(path_, ?buf[0], 128, 420);
    ret sel write_bytes_r.ok;
}

test "mach.lang.build.plan.resolve_token:elf_shared_object_wrong_architecture_refused" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val register_all_r: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel register_all_r.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    val root_r: res[str, outcome.Fail] = ut_temp_dir(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    val so_r: res[str, A.Error] = path.join(?alloc, root, "libwrong.so");
    if (sel so_r.err) { fs.remove_all(?alloc, root); ret 1; }
    val so: str = so_r.ok;
    if (!ut_write_elf_object(so, elf.machine_for_arch(isa.ARCH_AARCH64), true)) {
        fs.remove_all(?alloc, root); ret 1;
    }

    var dirs: Vector[str] = vector.init[str](?alloc);
    val push_r: res[usize, A.Error] = vector.push[str](?dirs, root);
    if (sel push_r.err) {
        fs.remove_all(?alloc, root); ret 1;
    }
    val wrong: res[LinkInput, outcome.Fail] = resolve_token(?alloc, ?tgt, ?dirs, "", "wrong"::*u8);
    fs.remove_all(?alloc, root);
    if (sel wrong.ok) { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.resolve_token:static_object_wrong_architecture_refused" {
