    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    val obj_r: res[str, A.Error] = path.join(?alloc, root, "wrong.o");
    val ok_r: res[str, A.Error] = path.join(?alloc, root, "right.o");
