        resolve_token(?alloc, ?tgt, ?dirs, root, bad::*u8);
    val good_rr: R.Result[LinkInput, outcome.Fail] =
        resolve_token(?alloc, ?tgt, ?dirs, root, good::*u8);
    fs.remove_all(?alloc, root);
    if (R.is_ok[LinkInput, outcome.Fail](bad_rr)) { ret 1; }
    if (R.is_err[LinkInput, outcome.Fail](good_rr)) { ret 1; }
    ret 0;
}

test "mach.lang.build.plan.resolve_token:archive_content_validated_not_suffix" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    val tr: R.Result[target.Target, str] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (R.is_err[target.Target, str](tr)) { ret 1; }
