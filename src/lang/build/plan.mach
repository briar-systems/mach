    val fake: str = fake_r.ok;
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(real, "!<arch>\n", 8, 420);
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(fake, "not an archive at all!!", 23, 420);
    if (sel write_bytes_r2.err) {
        fs.remove_all(?alloc, root); ret 1;
    }
    if (sel write_bytes_r.err) {
