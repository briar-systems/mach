    fin { target.registry_dnit(?reg); }
    val register_all_r: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel register_all_r.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    val root_r: res[str, outcome.Fail] = ut_temp_dir(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    val real_r: res[str, A.Error] = path.join(?alloc, root, "libreal.a");
    val fake_r: res[str, A.Error] = path.join(?alloc, root, "libfake.a");
