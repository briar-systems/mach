pub def PhaseKind: u8;

pub val PH_DEP_STEPS: PhaseKind = 0;

pub val PH_LOAD: PhaseKind = 1;

pub val PH_STEPS: PhaseKind = 2;

pub val PH_SEMA: PhaseKind = 3;

pub val PH_LOWER: PhaseKind = 4;

pub val PH_CODEGEN: PhaseKind = 5;

pub val PH_EMIT: PhaseKind = 6;

pub val PH_LINK: PhaseKind = 7;

# a test build's test objects, after the normal objects they are lowered against
pub val PH_TEST: PhaseKind = 8;

# one planned cell: an artifact on a target for a profile, with every decision
# the engine executes. `plan` fills everything the root manifest decides; `configure`
# adds what the realized dependency closure decides
# ---
# steps:        the declaring manifest's prerequisite steps in execution order, by name
# dep_steps:    exported dependency steps in execution order as `<dep id>.<step>`;
#               empty until `configure`
# export_links: the dependency closure's exported link requirements for this
#               cell, in link order; empty until `configure`
# configured:   `configure` ran, so `dep_steps` and `export_links` are effective
# requires:     the declaring manifest's artifacts this cell requires, by name
# owner:        "" for a cell of the root manifest, or the id of the dependency
#               whose export library requires the cell
# owner_chain:  the dependency chain that reaches `owner`, "" for the root
# label:        the unit's artifact as requirements name it: `<artifact>` for the
#               root, `<owner>.<artifact>` for a dependency
# dep_requires: the labels of the dependency requirement cells this cell waits on;
#               empty until `plan_dependency_requirements`
pub rec BuildUnit {
    target_entry: *project.TargetEntry;
    profile:      str;
    opt_level:    u8;
    goal:         request.BuildGoal;
    out_path:     str;
    # the expanded `[project].work`: the build owns the layout beneath it
    out_dir: str;
    obj_dir: str;
    # the compiler-only state of the cell's output directory, `<out>/.cache`
    cache_dir:    str;
    ir_dir:       str;
    asm_dir:      str;
    test_dir:     str;
    link_inputs:  Vector[input.Input];
    phases:       Vector[PhaseKind];
    steps:        Vector[str];
    dep_steps:    Vector[str];
    export_links: Vector[manifest.LinkRequirement];
    configured:   bool;

    sel_target:   str;
    sel_artifact: str;
    is_required:  bool;
    requires:     Vector[str];
    subsystem:    catalog_subsystem.Subsystem;

    owner:        str;
    owner_chain:  str;
    label:        str;
    dep_requires: Vector[str];
}

# project:  the root manifest's `[project].id`
# names:    the interner the plan's names live in; a session runs the plan only
#           when it holds them
# manifest: the root manifest the plan was made from, borrowed; it outlives the plan
# closure:  the manifest's dependency closure, located once by
#           `plan_dependency_requirements`; every cell borrows it
# located:  whether `closure` was located as a build needs it, every dependency
#           realized, which running the plan requires
pub rec BuildPlan {
    request:  request.BuildRequest;
    project:  str;
    units:    Vector[BuildUnit];
    names:    *intern.Interner;
    manifest: *manifest.Manifest;
    closure:  project.Closure;
    located:  bool;
}

# plan the request's own selection: `req.artifact` on `req.target`, each an
# exact name or a glob, or empty for the manifest's default, as
# `manifest.resolve_cells` reads them. a test goal takes the one artifact the
# default selection holds, any other goal every one
# ---
# a:         owns the plan
# itn:       resolves names
# reg:       the target registry
# m:         the root manifest
# owned_req: the request; its `profile` is the plan's
# ret:       the plan; err from request validation, selection or planning
pub fun plan(a: *A.Allocator, itn: *intern.Interner, reg: *lang_target.TargetRegistry,
    m: *manifest.Manifest, owned_req: request.BuildRequest) res[BuildPlan, fail.Fail] {
    val valid: err[fail.Fail] = request.validate(a, ?owned_req);
    if (sel valid.err) {
        ret res[BuildPlan, fail.Fail].err{valid.err};
    }
    val made: res[manifest.Selectors, fail.Fail] = manifest.selectors_of(a, owned_req.artifact, owned_req.target, owned_req.profile);
    if (sel made.err) {
        ret res[BuildPlan, fail.Fail].err{made.err};
    }
    var selectors: manifest.Selectors       = made.ok;
    var mode:      manifest.ArtifactDefault = manifest.ARTIFACT_DEFAULT_SET;
    if (request.test_goal(owned_req.goal)) { mode = manifest.ARTIFACT_DEFAULT_ONE; }
    val resolved: res[Vector[manifest.Cell], fail.Fail] = manifest.resolve_cells(a, itn, m, ?selectors, mode);
    if (sel resolved.err) {
        ret res[BuildPlan, fail.Fail].err{resolved.err};
    }
    var cells: Vector[manifest.Cell] = resolved.ok;
    ret plan_validated(a, itn, reg, m, owned_req, ?cells);
}

# `plan`, with the plan's dependency closure located in `s` as
# `plan_dependency_requirements` locates it, so the plan is ready to run there
# ---
# s:   the session the plan's names live in; `itn` of `plan` is its interner
# ret: the plan; err from planning or from locating the closure
pub fun plan_to_run(a: *A.Allocator, s: *session.Session, reg: *lang_target.TargetRegistry,
    m: *manifest.Manifest, owned_req: request.BuildRequest) res[BuildPlan, fail.Fail] {
    val planned: res[BuildPlan, fail.Fail] = plan(a, ?s.interner, reg, m, owned_req);
    if (sel planned.err) { ret planned; }
    var bp:      BuildPlan      = planned.ok;
    val located: err[fail.Fail] = plan_dependency_requirements(s, ?bp, driver_closure.UNREALIZED_REFUSED);
    if (sel located.err) { ret res[BuildPlan, fail.Fail].err{located.err}; }
    ret res[BuildPlan, fail.Fail].ok{bp};
}

# plan resolved cells for one profile: each cell's artifact on its target, and
# before it every artifact it requires. the request's `profile` is the plan's;
# a cell's own profile is its caller's grouping and is not read here
# ---
# a:         owns the plan
# itn:       resolves names
# reg:       the target registry
# m:         the root manifest
# owned_req: the request the cells share
# cells:     the cells, from `manifest.resolve_cells`
# ret:       the plan; err from validation or a cell's planning, or when `-o`
#            names one output and several cells are selected
pub fun plan_cells(a: *A.Allocator, itn: *intern.Interner, reg: *lang_target.TargetRegistry,
    m: *manifest.Manifest, owned_req: request.BuildRequest, cells: *Vector[manifest.Cell]) res[BuildPlan, fail.Fail] {
    val valid: err[fail.Fail] = request.validate(a, ?owned_req);
    if (sel valid.err) {
        ret res[BuildPlan, fail.Fail].err{valid.err};
    }
    ret plan_validated(a, itn, reg, m, owned_req, cells);
}

# `plan_cells` for a request its caller has validated
fun plan_validated(a: *A.Allocator, itn: *intern.Interner, reg: *lang_target.TargetRegistry,
    m: *manifest.Manifest, owned_req: request.BuildRequest, cells: *Vector[manifest.Cell]) res[BuildPlan, fail.Fail] {
    var bp: BuildPlan;
    bp.request  = owned_req;
    bp.units    = collections_vector.init[BuildUnit](a);
    bp.project  = entry_name(itn, m.id);
    bp.names    = itn;
    bp.manifest = m;
    bp.closure  = project.closure_empty(a);
    bp.located  = false;
    val req: *request.BuildRequest = ?bp.request;

    var ci: usize = 0;
    for (ci < cells.len) {
        val c:     *manifest.Cell = ?cells.data[ci];
        var scope: manifest.Scope = manifest.root_scope(m);
        val cr:    err[fail.Fail] = plan_cell(a, itn, reg, ?scope, "", req, ?bp.units,
            c.target, c.artifact, false);
        if (sel cr.err) {
            ret res[BuildPlan, fail.Fail].err{cr.err};
        }
        ci = ci + 1;
    }

    if (!str_empty(req.out) && selected_unit_count(?bp) > 1) {
        ret res[BuildPlan, fail.Fail].err{fail.user_of(diagnostic_kind.OUTPUT_AMBIGUOUS, out_conflict_msg(a, ?bp))};
    }
    ret res[BuildPlan, fail.Fail].ok{bp};
}

# resolve every planned cell against the plan's dependency closure, filling in
# the exported dependency steps and export link requirements each cell consumes.
# it configures projects through the same `driver.begin_build` a build runs, so
# what configuring a cell refuses is reported here exactly as the build would
# report it. nothing is fetched, no step runs and no output is written
# ---
# s:   the session the plan was made in
# bp:  the plan, its closure located; mutated in place, each unit becomes `configured`
# ret: ok; the configuration failure of the first cell that has one
pub fun configure(s: *session.Session, bp: *BuildPlan) err[fail.Fail] {
    if (!bp.located) { ret err[fail.Fail].err{fail.message("internal: a plan is configured only once its closure is located")}; }
    val m: *manifest.Manifest = bp.manifest;
    var i: usize              = 0;
    for (i < bp.units.len) {
        val u:   *BuildUnit           = ?bp.units.data[i];
        var req: request.BuildRequest = request.for_cell(?bp.request, u.owner, u.sel_target,
            u.sel_artifact, u.subsystem, u.goal);
        val begun: res[project.Project, fail.Fail] = driver.begin_build(s, m, ?bp.closure, ?req, nil);
        if (sel begun.err) {
            ret err[fail.Fail].err{begun.err};
        }
        var p:         project.Project = begun.ok;
        val collected: err[fail.Fail]  = collect_dependency_plan(?p, u);
        project.dnit_project(?p);
        if (sel collected.err) { ret collected; }
        u.configured = true;
        i            = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun collect_dependency_plan(p: *project.Project, u: *BuildUnit) err[fail.Fail] {
    val itn:     *intern.Interner                        = ?p.s.interner;
    val planned: res[Vector[step.Dependency], fail.Fail] = step.dependency_plan(p,
        u.target_entry.isa_name, u.target_entry.os_name, u.target_entry.abi_name);
    if (sel planned.err) {
        ret err[fail.Fail].err{planned.err};
    }
    var steps: Vector[step.Dependency] = planned.ok;
    fin { collections_vector.dnit[step.Dependency](?steps); }

    var i: usize = 0;
    for (i < steps.len) {
        val selected: step.Dependency                  = steps.data[i];
        val dm:       *manifest.Manifest               = ?p.config.deps[selected.dependency].manifest;
        val labelled: res[str, std_format.FormatError] = std_format.sprint(u.dep_steps.a, "{}.{}",
            entry_name(itn, dm.id), entry_name(itn, dm.steps[selected.step].name));
        if (sel labelled.err) {
            ret err[fail.Fail].err{fail.message(fail.format_text(labelled.err))};
        }
        val pushed: res[usize, A.Error] = collections_vector.push[str](?u.dep_steps, labelled.ok);
        if (sel pushed.err) {
            ret err[fail.Fail].err{fail.refused(pushed.err)};
        }
        i = i + 1;
    }

    # the claimed-symbol array belongs to the project config and dies with it; the
    # plan keeps only the interned identity it displays
    var li: u32 = 0;
    for (li < p.config.cascade_lib_count) {
        var retained: manifest.LinkRequirement = p.config.cascade_libs[li];
        retained.symbols      = nil;
        retained.symbol_count = 0;
        val pushed: res[usize, A.Error] = collections_vector.push[manifest.LinkRequirement](?u.export_links, retained);
        if (sel pushed.err) {
            ret err[fail.Fail].err{fail.refused(pushed.err)};
        }
        li = li + 1;
    }
    ret err[fail.Fail].ok{};
}

fun selected_unit_count(bp: *BuildPlan) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < bp.units.len) {
        if (!bp.units.data[i].is_required) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun unit_already_planned(units: *Vector[BuildUnit], owner: str, aname: str, tgt: intern.StrId) bool {
    var i: usize = 0;
    for (i < units.len) {
        val u: *BuildUnit = ?units.data[i];
        if (intern.str_same(u.target_entry.name, tgt) && str_equals(u.owner, owner) && str_equals(u.sel_artifact, aname)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# plan a cell of `s` and, before it, every cell it requires within the declaring
# manifest. a cell already planned is not planned again
# ---
# s:           the scope declaring the cell
# owner_chain: the dependency chain reaching a dependency scope, "" for the root
# req:         the request the cell is planned for; its `owner` is replaced by the scope's
# units:       receives the cells in execution order
fun plan_cell(a: *A.Allocator, itn: *intern.Interner, reg: *lang_target.TargetRegistry,
    s: *manifest.Scope, owner_chain: str, req: *request.BuildRequest, units: *Vector[BuildUnit],
    tname: str, aname: str, is_required: bool) err[fail.Fail] {
    var cell_req: request.BuildRequest = @req;
    cell_req.owner = "";
    if (manifest.scope_is_dependency(s))               { cell_req.owner = entry_name(itn, s.owner.id); }
    if (is_required && req.goal != request.GOAL_CHECK) { cell_req.goal = request.GOAL_ARTIFACT; }
    val ur: res[BuildUnit, fail.Fail] = plan_unit(a, itn, reg, s, ?cell_req,
        tname, aname, is_required);
    if (sel ur.err) {
        ret err[fail.Fail].err{in_dependency(a, owner_chain, ur.err)};
    }
    var u: BuildUnit = ur.ok;
    u.owner_chain = owner_chain;
    if (unit_already_planned(units, u.owner, u.sel_artifact, u.target_entry.name)) {
        ret err[fail.Fail].ok{};
    }

    val m:  *manifest.Manifest = s.owner;
    var ri: usize              = 0;
    for (ri < u.requires.len) {
        val rname: str                   = u.requires.data[ri];
        val ra:    *manifest.ArtifactDef = manifest.find_artifact(itn, m, rname);
        if (ra == nil) {
            ret err[fail.Fail].err{fail.message("internal: a required artifact is not declared")};
        }
        var reached: bool = false;
        var ti:      u32  = 0;
        for (ti < m.target_count) {
            if (manifest.required_artifact_uses_target(itn, ra, u.target_entry.name, ?m.targets[ti])) {
                val tn: opt[str] = intern.get(itn, m.targets[ti].name);
                if (sel tn.none) {
                    ret err[fail.Fail].err{fail.message("internal: target name not interned")};
                }
                val rr: err[fail.Fail] = plan_cell(a, itn, reg, s, owner_chain, ?cell_req, units,
                    tn.some, rname, true);
                if (sel rr.err) { ret rr; }
                reached = true;
            }
            ti = ti + 1;
        }
        if (!reached) {
            ret err[fail.Fail].err{in_dependency(a, owner_chain, fail.user_of(diagnostic_kind.ARTIFACT_REQUIREMENT_UNREACHABLE, fail.join(a,
                "mach.toml: artifact '", u.sel_artifact, "' requires artifact '", rname,
                "', which declares no target this build can produce")))};
        }
        ri = ri + 1;
    }

    val pr: res[usize, A.Error] = collections_vector.push[BuildUnit](units, u);
    if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
    ret err[fail.Fail].ok{};
}

# a failure planning a dependency's cell, located by the chain that reaches it
fun in_dependency(a: *A.Allocator, owner_chain: str, f: fail.Fail) fail.Fail {
    if (str_empty(owner_chain)) { ret f; }
    val carried: opt[str] = fail.text(f);
    if (sel carried.none) { ret f; }
    val joined: res[str, fail.Fail] = fail.join(a, "dependency ", owner_chain, ": ", carried.some);
    if (sel joined.err) { ret joined.err; }
    ret fail.owning(fail.with_text(f, joined.ok));
}

# locate the root's dependency closure, once, into the plan, and add the cells a
# dependency's export library requires to it. a plan runs only once this has
# located its closure; every cell compiled against a closure that holds a dependency
# waits on that dependency's requirement cells, which are planned before it with
# the root's profile, for every target they name in the dependency's manifest,
# and against the dependency's own closure in turn. a requirement reached through
# several consumers is planned once. two cells that would write one output path
# are refused
# ---
# s:          the session the plan was made in
# bp:         the plan, mutated in place
# unrealized: what a dependency nothing is realized for is; a plan that leaves
#             one out lists what was built and never runs
# ret:        ok; err from locating the closure, a dependency cell's planning, or an
#             output collision
pub fun plan_dependency_requirements(s: *session.Session, bp: *BuildPlan, unrealized: driver_closure.Unrealized) err[fail.Fail] {
    val m: *manifest.Manifest = bp.manifest;
    if (bp.located) { ret err[fail.Fail].err{fail.message("internal: the plan's dependency closure is already located")}; }
    val toolchain_r: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel toolchain_r.err) { ret err[fail.Fail].err{toolchain_r.err}; }
    val toolchain: *lang_target.TargetRegistry     = toolchain_r.ok;
    val realized:  res[project.Closure, fail.Fail] = driver.closure_locate(s, m, bp.request.project_root, unrealized);
    if (sel realized.err) { ret err[fail.Fail].err{realized.err}; }
    bp.closure = realized.ok;
    bp.located = unrealized == driver_closure.UNREALIZED_REFUSED;
    if (bp.closure.count > 0) {
        val closure: *project.Closure  = ?bp.closure;
        val a:       *A.Allocator      = bp.units.a;
        var planned: Vector[BuildUnit] = collections_vector.init[BuildUnit](a);
        var handed:  bool              = false;
        fin {
            if (!handed) { collections_vector.dnit[BuildUnit](?planned); }
        }
        var i: usize = 0;
        for (i < bp.units.len) {
            var u:       BuildUnit      = bp.units.data[i];
            val reached: err[fail.Fail] = plan_dependency_cells(a, ?s.interner, toolchain, closure, m,
                -1, ?bp.request, ?planned, ?u.dep_requires);
            if (sel reached.err) { ret reached; }
            val pushed: res[usize, A.Error] = collections_vector.push[BuildUnit](?planned, u);
            if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
            i = i + 1;
        }
        collections_vector.dnit[BuildUnit](?bp.units);
        bp.units = planned;
        handed   = true;
    }
    ret check_unit_outputs(bp.units.a, ?bp.units);
}

# the dependencies a consumer compiles against: every dependency of the closure
# for the root (`consumer < 0`), otherwise what closure dependency `consumer`
# reaches through its own edges
fun closure_reach(closure: *project.Closure, reach: *bool, consumer: i64) {
    val n: u32 = closure.count;
    var i: u32 = 0;
    for (i < n) {
        reach[i] = consumer < 0;
        i        = i + 1;
    }
    if (consumer < 0) { ret; }
    reach_edges(closure, reach, consumer::u32);
}

fun reach_edges(closure: *project.Closure, reach: *bool, from: u32) {
    val d: *project.DepEntry = ?closure.deps[from];
    var k: u32               = 0;
    for (k < d.direct_count) {
        var j: u32 = 0;
        for (j < closure.count) {
            if (intern.str_same(closure.deps[j].project_id, d.direct[k]) && !reach[j]) {
                reach[j] = true;
                reach_edges(closure, reach, j);
            }
            j = j + 1;
        }
        k = k + 1;
    }
}

# plan the requirement cells of each dependency `consumer` compiles against and
# record their labels in `labels`
fun plan_dependency_cells(a: *A.Allocator, itn: *intern.Interner, reg: *lang_target.TargetRegistry,
    closure: *project.Closure, root: *manifest.Manifest, consumer: i64, req: *request.BuildRequest,
    units: *Vector[BuildUnit], labels: *Vector[str]) err[fail.Fail] {
    val n: u32 = closure.count;
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val rr: res[*bool, A.Error] = A.allocate[bool](a, n::usize);
    if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
    val reach: *bool = rr.ok;
    fin { A.deallocate[bool](a, reach, n::usize); }
    closure_reach(closure, reach, consumer);

    var di: u32 = 0;
    for (di < n) {
        if (reach[di]) {
            val dep:   *project.DepEntry  = ?closure.deps[di];
            val dm:    *manifest.Manifest = ?dep.manifest;
            var scope: manifest.Scope     = manifest.dependency_scope(root, dm);
            val chain: str                = entry_name(itn, dep.chain);
            val owner: str                = entry_name(itn, dm.id);
            var ai:    u32                = 0;
            for (ai < dm.artifact_count) {
                val ra: *manifest.ArtifactDef = ?dm.artifacts[ai];
                if (manifest.export_requires(itn, dm, ra)) {
                    val rname:   str  = entry_name(itn, ra.name);
                    var reached: bool = false;
                    var ti:      u32  = 0;
                    for (ti < dm.target_count) {
                        if (manifest.artifact_supports_target(itn, ra, dm.targets[ti].name)) {
                            val planned: err[fail.Fail] = plan_dependency_cell(a, itn, reg, closure, root, di,
                                ?scope, chain, req, units, entry_name(itn, dm.targets[ti].name), rname);
                            if (sel planned.err) { ret planned; }
                            reached = true;
                        }
                        ti = ti + 1;
                    }
                    if (!reached) {
                        ret err[fail.Fail].err{in_dependency(a, chain, fail.user_of(diagnostic_kind.ARTIFACT_REQUIREMENT_UNREACHABLE, fail.join(a,
                            "mach.toml: its export library requires artifact '", rname,
                            "', which declares no target")))};
                    }
                    val label_r: res[str, fail.Fail] = fail.join(a, owner, ".", rname);
                    if (sel label_r.err) { ret err[fail.Fail].err{label_r.err}; }
                    val label: str = label_r.ok;
                    if (!label_listed(labels, label)) {
                        val pushed: res[usize, A.Error] = collections_vector.push[str](labels, label);
                        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
                    }
                }
                ai = ai + 1;
            }
        }
        di = di + 1;
    }
    ret err[fail.Fail].ok{};
}

# `plan_cell` for a dependency's requirement: the cell and its own requirement
# cells are planned in the dependency's scope, then each waits on the requirement
# cells of the dependency's own closure
fun plan_dependency_cell(a: *A.Allocator, itn: *intern.Interner, reg: *lang_target.TargetRegistry,
    closure: *project.Closure, root: *manifest.Manifest, owner_index: u32, s: *manifest.Scope, chain: str,
    req: *request.BuildRequest, units: *Vector[BuildUnit], tname: str, aname: str) err[fail.Fail] {
    val first: usize          = units.len;
    val cr:    err[fail.Fail] = plan_cell(a, itn, reg, s, chain, req, units, tname, aname, true);
    if (sel cr.err)         { ret cr; }
    if (units.len == first) { ret err[fail.Fail].ok{}; }

    # the cells just planned all belong to the dependency; each compiles against
    # its closure, so each is preceded by that closure's requirement cells
    var added: Vector[BuildUnit] = collections_vector.init[BuildUnit](a);
    fin { collections_vector.dnit[BuildUnit](?added); }
    for (units.len > first) {
        val taken: opt[BuildUnit] = collections_vector.pop[BuildUnit](units);
        if (sel taken.some) {
            val pushed: res[usize, A.Error] = collections_vector.push[BuildUnit](?added, taken.some);
            if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        }
    }
    # popped last first, so the cells are taken back in planned order
    var i: usize = added.len;
    for (i > 0) {
        i = i - 1;
        var u:       BuildUnit      = added.data[i];
        val reached: err[fail.Fail] = plan_dependency_cells(a, itn, reg, closure, root, owner_index::i64,
            req, units, ?u.dep_requires);
        if (sel reached.err) { ret reached; }
        val pushed: res[usize, A.Error] = collections_vector.push[BuildUnit](units, u);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

fun label_listed(labels: *Vector[str], label: str) bool {
    var i: usize = 0;
    for (i < labels.len) {
        if (str_equals(labels.data[i], label)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# refuse two plans of one selection, one per profile, that would write one
# file: a `[project].work` without `{profile.name}` puts every profile's
# outputs at the same paths
# ---
# a:     owns the message
# plans: the plans, one per profile
# ret:   ok; err naming the two cells and the path
pub fun check_plan_outputs(a: *A.Allocator, plans: *Vector[BuildPlan]) err[fail.Fail] {
    var pi: usize = 0;
    for (pi < plans.len) {
        var qi: usize = pi + 1;
        for (qi < plans.len) {
            val left:  *Vector[BuildUnit] = ?plans.data[pi].units;
            val right: *Vector[BuildUnit] = ?plans.data[qi].units;
            var i:     usize              = 0;
            for (i < left.len) {
                val u: *BuildUnit = ?left.data[i];
                var j: usize      = 0;
                for (j < right.len) {
                    val v: *BuildUnit = ?right.data[j];
                    if (writes_output(u) && writes_output(v) && str_equals(u.out_path, v.out_path)) {
                        ret err[fail.Fail].err{fail.user_of(diagnostic_kind.OUTPUT_COLLISION, fail.join(a,
                            "artifact '", u.label, "' in profiles '", u.profile, "' and '", v.profile,
                            "' collides on output path '", u.out_path, "'; put {profile.name} in [project].work"))};
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
            qi = qi + 1;
        }
        pi = pi + 1;
    }
    ret err[fail.Fail].ok{};
}

# whether `path` lies under the directory `dir`
pub fun under_dir(path: str, dir: str) bool {
    val n: usize = str_len(dir);
    if (n == 0 || str_len(path) <= n || !str_starts_with(path, dir)) { ret false; }
    ret path[n] == '/' || dir[n - 1] == '/';
}

# a unit links one file at its `out_path`: an artifact or a test dispatcher
fun writes_output(u: *BuildUnit) bool {
    ret (u.goal == request.GOAL_ARTIFACT || u.goal == request.GOAL_TESTS) && !str_empty(u.out_path);
}

# refuse two cells that would write one artifact
fun check_unit_outputs(a: *A.Allocator, units: *Vector[BuildUnit]) err[fail.Fail] {
    var i: usize = 0;
    for (i < units.len) {
        val u: *BuildUnit = ?units.data[i];
        if (writes_output(u)) {
            var j: usize = i + 1;
            for (j < units.len) {
                val v: *BuildUnit = ?units.data[j];
                if (writes_output(v) && str_equals(u.out_path, v.out_path)) {
                    ret err[fail.Fail].err{fail.user_of(diagnostic_kind.OUTPUT_COLLISION, fail.join(a,
                        "artifacts '", u.label, "' and '", v.label, "' collide on output path '", u.out_path, "'"))};
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun out_conflict_msg(a: *A.Allocator, bp: *BuildPlan) res[str, fail.Fail] {
    var cb: textbuild.TextBuilder = textbuild.tb_init(a);
    var i:  usize                 = 0;
    for (i < bp.units.len) {
        if (textbuild.tb_len(?cb) > 0) { textbuild.tb_append(?cb, ", "); }
        var tlabel: str = "the default target";
        if (!str_empty(bp.units.data[i].sel_target)) { tlabel = bp.units.data[i].sel_target; }
        textbuild.tb_append(?cb, bp.units.data[i].sel_artifact);
        textbuild.tb_append(?cb, " for ");
        textbuild.tb_append(?cb, tlabel);
        i = i + 1;
    }
    # the builder remembers a refused append, so finishing reports it
    val cells_r: res[str, textbuild.Error] = textbuild.tb_finish(?cb);
    textbuild.tb_dnit(?cb);
    if (sel cells_r.err) { ret res[str, fail.Fail].err{fail.message(textbuild.text(cells_r.err))}; }
    ret fail.join(a, "-o names a single output but the selection resolves to several build units (",
        cells_r.ok, "); narrow it with -a, -t and -p");
}

# `where` names the declaration (the flag, or the manifest key of artifact
# `aname`) so the refusal is located; the text is the catalog policy's
fun subsystem_admitted(a: *A.Allocator, tgt: *lang_target.Binding, tname: str, sub: catalog_subsystem.Subsystem, where: str, aname: str) err[fail.Fail] {
    if (tgt.of.carries_subsystem) { ret err[fail.Fail].ok{}; }
    val text: res[str, std_format.FormatError] = fail.catalog_text(a, fail.unsupported_member("Subsystem", catalog_subsystem.name_for(sub), tgt.of.name));
    if (sel text.err) { ret err[fail.Fail].err{fail.message("subsystem refusal could not be formatted")}; }
    fin { str_free(a, text.ok); }
    var located: res[str, std_format.FormatError];
    if (str_len(aname) == 0) { located = std_format.sprint(a, "{}: {} (target '{}' produces a {} image, which declares no subsystem)", where, text.ok, tname, tgt.of.name); }
    or                       { located = std_format.sprint(a, "{}.{}.subsystem: {} (target '{}' produces a {} image, which declares no subsystem)", where, aname, text.ok, tname, tgt.of.name); }
    if (sel located.err)     { ret err[fail.Fail].err{fail.message("subsystem refusal could not be formatted")}; }
    ret err[fail.Fail].err{fail.user(diagnostic_kind.CATALOG_UNSUPPORTED, located.ok)};
}

fun plan_unit(a: *A.Allocator, itn: *intern.Interner, reg: *lang_target.TargetRegistry,
    s: *manifest.Scope, req: *request.BuildRequest,
    tname: str, aname: str, is_required: bool) res[BuildUnit, fail.Fail] {
    val m:    *manifest.Manifest = s.owner;
    var cell: manifest.Cell      = manifest.cell_of(aname, tname, req.profile);

    val ur: res[manifest.BuildUnit, fail.Fail] = manifest.resolve_scoped_build_unit(a, itn, reg, s, ?cell);
    if (sel ur.err) {
        ret res[BuildUnit, fail.Fail].err{ur.err};
    }
    val bu: manifest.BuildUnit = ur.ok;

    val tr: res[lang_target.Binding, fail.Fail] = manifest.resolve_declared(a, itn, reg, bu.target);
    if (sel tr.err) {
        ret res[BuildUnit, fail.Fail].err{fail.as_user(diagnostic_kind.TARGET_UNSUPPORTED, tr.err)};
    }
    var tgt: lang_target.Binding = tr.ok;

    var u: BuildUnit;
    u.goal         = req.goal;
    u.opt_level    = req.opt;
    u.sel_target   = tname;
    u.sel_artifact = aname;
    u.is_required  = is_required;
    u.owner        = req.owner;
    u.owner_chain  = "";
    u.label        = aname;
    if (!str_empty(req.owner)) {
        val label: res[str, fail.Fail] = fail.join(a, req.owner, ".", aname);
        if (sel label.err) { ret res[BuildUnit, fail.Fail].err{label.err}; }
        u.label = label.ok;
    }
    u.dep_requires = collections_vector.init[str](a);

    val rq_r: err[fail.Fail] = collect_requires(a, itn, m, ?bu, ?u);
    if (sel rq_r.err) {
        ret res[BuildUnit, fail.Fail].err{rq_r.err};
    }

    # a declared subsystem is a capability only a format whose header carries
    # one honors; on any other it is refused as unsupported, never read silently
    u.subsystem = catalog_subsystem.CONSOLE;
    if (bu.artifact != nil && bu.artifact.subsystem_declared) {
        val declared: err[fail.Fail] = subsystem_admitted(a, ?tgt, tname, bu.artifact.subsystem, "mach.toml: artifact", aname);
        if (sel declared.err) { ret res[BuildUnit, fail.Fail].err{declared.err}; }
        u.subsystem = bu.artifact.subsystem;
    }
    val flag_subsystem: opt[catalog_subsystem.Subsystem] = request.subsystem_from_flag(req.subsystem_flag);
    if (sel flag_subsystem.some) {
        val admitted: err[fail.Fail] = subsystem_admitted(a, ?tgt, tname, flag_subsystem.some, "--subsystem", "");
        if (sel admitted.err) { ret res[BuildUnit, fail.Fail].err{admitted.err}; }
        u.subsystem = flag_subsystem.some;
    }

    val pn_opt: opt[str] = intern.get(itn, bu.profile_name);
    if (sel pn_opt.none) { ret res[BuildUnit, fail.Fail].err{fail.message("internal: profile name not interned")}; }
    u.profile = pn_opt.some;

    val ter: res[*project.TargetEntry, A.Error] = A.allocate[project.TargetEntry](a, 1::usize);
    if (sel ter.err) { ret res[BuildUnit, fail.Fail].err{fail.refused(ter.err)}; }
    val te: *project.TargetEntry = ter.ok;
    @te            = project.target_entry_of(?bu);
    u.target_entry = te;

    val root: str = req.project_root;

    val od_r: res[str, fail.Fail] = join_template(a, itn, root, bu.out_root, "project output dir: ");
    if (sel od_r.err) { ret res[BuildUnit, fail.Fail].err{od_r.err}; }
    u.out_dir = od_r.ok;

    val ob_r: res[str, fail.Fail] = layout.under(a, u.out_dir, layout.OBJ);
    if (sel ob_r.err) { ret res[BuildUnit, fail.Fail].err{ob_r.err}; }
    u.obj_dir = ob_r.ok;

    val cb_r: res[str, fail.Fail] = layout.under(a, u.out_dir, layout.CACHE);
    if (sel cb_r.err) { ret res[BuildUnit, fail.Fail].err{cb_r.err}; }
    u.cache_dir = cb_r.ok;

    u.ir_dir = "";
    if (req.emit_ir) {
        val ib_r: res[str, fail.Fail] = layout.under(a, u.out_dir, layout.IR);
        if (sel ib_r.err) { ret res[BuildUnit, fail.Fail].err{ib_r.err}; }
        u.ir_dir = ib_r.ok;
    }
    u.asm_dir = "";
    if (req.emit_asm) {
        val ab_r: res[str, fail.Fail] = layout.under(a, u.out_dir, layout.ASM);
        if (sel ab_r.err) { ret res[BuildUnit, fail.Fail].err{ab_r.err}; }
        u.asm_dir = ab_r.ok;
    }

    val td_r: res[str, fail.Fail] = unit_test_dir(a, itn, m, req, ?bu, u.out_dir);
    if (sel td_r.err) { ret res[BuildUnit, fail.Fail].err{td_r.err}; }
    u.test_dir = td_r.ok;
    val op_r: res[str, fail.Fail] = unit_out_path(a, itn, m, req, ?bu, u.obj_dir, u.test_dir, is_required);
    if (sel op_r.err) { ret res[BuildUnit, fail.Fail].err{op_r.err}; }
    u.out_path = op_r.ok;

    u.link_inputs  = collections_vector.init[input.Input](a);
    u.dep_steps    = collections_vector.init[str](a);
    u.export_links = collections_vector.init[manifest.LinkRequirement](a);
    u.configured   = false;
    var ti: usize = 0;
    for (ti < req.link_tokens.len) {
        val token: str                         = req.link_tokens.data[ti].text;
        val lr:    res[input.Input, fail.Fail] = input.token_resolve(a, ?tgt, ?req.lib_dirs, root, token::*u8);
        if (sel lr.err) {
            ret res[BuildUnit, fail.Fail].err{lr.err};
        }
        var resolved: input.Input = lr.ok;
        if (!input.token_is_path(token::*u8)) { resolved.library = token; }
        val pr: res[usize, A.Error] = collections_vector.push[input.Input](?u.link_inputs, resolved);
        if (sel pr.err) { ret res[BuildUnit, fail.Fail].err{fail.refused(pr.err)}; }
        ti = ti + 1;
    }

    val ph_r: err[fail.Fail] = derive_phases(a, itn, s, req, ?bu, ?tgt, ?u);
    if (sel ph_r.err) {
        ret res[BuildUnit, fail.Fail].err{ph_r.err};
    }
    val admitted: err[fail.Fail] = goal_admitted(?tgt, ?u);
    if (sel admitted.err) { ret res[BuildUnit, fail.Fail].err{admitted.err}; }
    ret res[BuildUnit, fail.Fail].ok{u};
}

fun collect_requires(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest,
    bu: *manifest.BuildUnit, u: *BuildUnit) err[fail.Fail] {
    u.requires = collections_vector.init[str](a);

    val consumer: *manifest.ArtifactDef = bu.artifact;
    if (consumer == nil) { ret err[fail.Fail].ok{}; }

    var j: u32 = 0;
    for (j < m.artifact_count) {
        if (manifest.artifact_needs_artifact(itn, consumer, ?m.artifacts[j])) {
            val no: opt[str] = intern.get(itn, m.artifacts[j].name);
            if (sel no.none) {
                ret err[fail.Fail].err{fail.message("internal: artifact name not interned")};
            }
            val pr: res[usize, A.Error] = collections_vector.push[str](?u.requires, no.some);
            if (sel pr.err) {
                ret err[fail.Fail].err{fail.refused(pr.err)};
            }
        }
        j = j + 1;
    }
    ret err[fail.Fail].ok{};
}

fun join_template(a: *A.Allocator, itn: *intern.Interner, root: str, dir_id: intern.StrId, what: str) res[str, fail.Fail] {
    val opt_tmpl: opt[str] = intern.get(itn, dir_id);
    if (sel opt_tmpl.none) {
        ret res[str, fail.Fail].err{fail.message_of(fail.join(a, what, "template not interned", ""))};
    }
    val jr: res[str, A.Error] = types_path.join(a, root, opt_tmpl.some);
    if (sel jr.err) {
        ret res[str, fail.Fail].err{fail.message_of(fail.join(a, what, lang_alloc.text(jr.err), ""))};
    }
    ret res[str, fail.Fail].ok{jr.ok};
}

pub fun finished_modules(tgt: *lang_target.Binding) bool {
    ret tgt.of != nil && tgt.of.object_is_artifact;
}

fun unit_out_path(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest,
    req: *request.BuildRequest, bu: *manifest.BuildUnit,
    obj_dir: str, test_dir: str, is_required: bool) res[str, fail.Fail] {
    if (req.goal == request.GOAL_CHECK)     { ret res[str, fail.Fail].ok{""}; }
    if (req.goal == request.GOAL_OBJECTS)   { ret res[str, fail.Fail].ok{obj_dir}; }
    if (req.goal == request.GOAL_TEST_LIST) { ret res[str, fail.Fail].ok{""}; }

    # `-o` names the one binary the cell links, a built artifact or a test
    # dispatcher alike; a required artifact keeps its declared output
    if (!str_empty(req.out) && !is_required) {
        if (!manifest.is_project_path(req.out)) {
            ret res[str, fail.Fail].err{fail.user(diagnostic_kind.OUTPUT_PATH_INVALID, manifest.OUTPUT_CONSTRAINT)};
        }
        val op_r: res[str, A.Error] = types_path.resolve(a, req.project_root, req.out);
        if (sel op_r.err) { ret res[str, fail.Fail].err{fail.refused(op_r.err)}; }
        ret res[str, fail.Fail].ok{op_r.ok};
    }

    # the dispatcher is `test/<artifact>/<artifact>`
    if (req.goal == request.GOAL_TESTS) {
        val full_r: res[str, A.Error] = types_path.join(a, test_dir, tested_name(itn, m, bu));
        if (sel full_r.err) { ret res[str, fail.Fail].err{fail.refused(full_r.err)}; }
        ret res[str, fail.Fail].ok{full_r.ok};
    }

    val bin_opt: opt[str] = intern.get(itn, bu.bin_path);
    if (sel bin_opt.none) {
        ret res[str, fail.Fail].err{fail.user(diagnostic_kind.ARTIFACT_NO_OUTPUT, "selected artifact has no output path; set the `out` template in mach.toml")};
    }
    if (str_empty(bin_opt.some)) {
        ret res[str, fail.Fail].err{fail.user(diagnostic_kind.ARTIFACT_NO_OUTPUT, "selected artifact has no output path; set the `out` template in mach.toml")};
    }
    val op_r: res[str, A.Error] = types_path.join(a, req.project_root, bin_opt.some);
    if (sel op_r.err) { ret res[str, fail.Fail].err{fail.refused(op_r.err)}; }
    ret res[str, fail.Fail].ok{op_r.ok};
}

# the name a test run goes by: the artifact under test, else the project
# a run with neither name is `tests`
fun tested_name(itn: *intern.Interner, m: *manifest.Manifest, bu: *manifest.BuildUnit) str {
    if (bu.artifact != nil && !intern.str_is_nil(bu.artifact.name)) {
        val an: str = intern.text(itn, bu.artifact.name);
        if (!str_empty(an)) { ret an; }
    }
    if (!intern.str_is_nil(m.id)) {
        val id: str = intern.text(itn, m.id);
        if (!str_empty(id)) { ret id; }
    }
    ret "tests";
}

# `test/<artifact>`: where a test run's dispatcher object, dispatcher and logs go;
# empty outside a test goal
fun unit_test_dir(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest,
    req: *request.BuildRequest, bu: *manifest.BuildUnit, out_dir: str) res[str, fail.Fail] {
    if (!request.test_goal(req.goal)) { ret res[str, fail.Fail].ok{""}; }
    ret layout.within(a, out_dir, layout.TEST, tested_name(itn, m, bu));
}

fun derive_phases(a: *A.Allocator, itn: *intern.Interner, s: *manifest.Scope,
    req: *request.BuildRequest, bu: *manifest.BuildUnit,
    tgt: *lang_target.Binding, u: *BuildUnit) err[fail.Fail] {
    val m: *manifest.Manifest = s.owner;
    u.phases = collections_vector.init[PhaseKind](a);
    u.steps  = collections_vector.init[str](a);
    if (req.goal == request.GOAL_CHECK) {
        val loaded: err[fail.Fail] = push_phase(u, PH_LOAD);
        if (sel loaded.err) { ret loaded; }
        ret push_phase(u, PH_SEMA);
    }

    val demanded_r: res[bool, fail.Fail] = steps_demanded(a, itn, s, bu, ?u.steps);
    if (sel demanded_r.err) { ret err[fail.Fail].err{demanded_r.err}; }
    if (m.dep_count > 0) {
        val r1: err[fail.Fail] = push_phase(u, PH_DEP_STEPS);
        if (sel r1.err) { ret r1; }
    }
    if (demanded_r.ok) {
        val r2: err[fail.Fail] = push_phase(u, PH_STEPS);
        if (sel r2.err) { ret r2; }
    }

    val r3: err[fail.Fail] = push_phase(u, PH_LOAD);
    if (sel r3.err) { ret r3; }
    val r4: err[fail.Fail] = push_phase(u, PH_SEMA);
    if (sel r4.err) { ret r4; }
    val r5: err[fail.Fail] = push_phase(u, PH_LOWER);
    if (sel r5.err) { ret r5; }
    val r6: err[fail.Fail] = push_phase(u, PH_CODEGEN);
    if (sel r6.err) { ret r6; }
    if (request.test_goal(req.goal)) {
        val rt: err[fail.Fail] = push_phase(u, PH_TEST);
        if (sel rt.err) { ret rt; }
    }
    if (req.goal == request.GOAL_TEST_LIST) { ret err[fail.Fail].ok{}; }

    val flat:    bool = tgt.of != nil && tgt.of.produces_image;
    var objects: bool = false;
    if (req.goal == request.GOAL_ARTIFACT && !flat) { objects = true; }
    if (req.goal == request.GOAL_OBJECTS)           { objects = true; }
    if (req.goal == request.GOAL_TESTS)             { objects = true; }
    if (objects || req.emit_ir || req.emit_asm) {
        val r7: err[fail.Fail] = push_phase(u, PH_EMIT);
        if (sel r7.err) { ret r7; }
    }
    if (req.goal == request.GOAL_ARTIFACT || req.goal == request.GOAL_TESTS) {
        val r8: err[fail.Fail] = push_phase(u, PH_LINK);
        if (sel r8.err) { ret r8; }
    }
    ret err[fail.Fail].ok{};
}

val FLAT_ONLY: str = "a flat-image object format produces only executables; library and '--emit obj' outputs are unsupported";

fun has_phase(u: *BuildUnit, k: PhaseKind) bool {
    var i: usize = 0;
    for (i < u.phases.len) {
        if (u.phases.data[i] == k) { ret true; }
        i = i + 1;
    }
    ret false;
}

# what the target's object format cannot produce for the unit's goal is refused
# as the unit is planned, before anything compiles. a format either is its own
# artifact or links from compiled images, which the registry holds it to, so
# one that is neither never reaches a plan
fun goal_admitted(tgt: *lang_target.Binding, u: *BuildUnit) err[fail.Fail] {
    if (tgt.of == nil) { ret err[fail.Fail].ok{}; }
    val flat:     bool = tgt.of.produces_image;
    val finished: bool = finished_modules(tgt);
    val library:  bool = catalog_artifact.is_library(u.target_entry.kind);
    val emits:    bool = has_phase(u, PH_EMIT);
    val links:    bool = has_phase(u, PH_LINK);
    if (emits && u.goal == request.GOAL_OBJECTS && flat) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, FLAT_ONLY)};
    }
    if (emits && u.goal == request.GOAL_TESTS && finished) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "a finished-module object format produces no executable; this target cannot build or run tests")};
    }
    if (emits && finished && library) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "a finished-module object format has no archive or shared-library form; each module is its own artifact")};
    }
    if (links && u.goal != request.GOAL_TESTS && flat && library) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, FLAT_ONLY)};
    }
    ret err[fail.Fail].ok{};
}

fun push_phase(u: *BuildUnit, k: PhaseKind) err[fail.Fail] {
    val pr: res[usize, A.Error] = collections_vector.push[PhaseKind](?u.phases, k);
    if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
    ret err[fail.Fail].ok{};
}

# the declaring manifest's prerequisite steps this cell demands, appended to
# `steps` in execution order. the same `manifest.plan_steps` the driver runs, so
# the displayed order is the executed order
fun steps_demanded(a: *A.Allocator, itn: *intern.Interner, s: *manifest.Scope,
    bu: *manifest.BuildUnit, steps: *Vector[str]) res[bool, fail.Fail] {
    val m: *manifest.Manifest = s.owner;
    if (m.step_count == 0) { ret res[bool, fail.Fail].ok{false}; }

    val pn_opt: opt[str] = intern.get(itn, bu.profile_name);
    if (sel pn_opt.none) { ret res[bool, fail.Fail].ok{false}; }
    var v: template.Values = template.values_of(itn, bu.target, pn_opt.some);

    val po_r: res[str, fail.Fail] = manifest.expand_project_work(a, itn, s.root, ?v);
    if (sel po_r.err) { ret res[bool, fail.Fail].err{po_r.err}; }
    val proj_out: str = po_r.ok;
    fin { str_free(a, proj_out); }

    if (bu.artifact == nil) { ret res[bool, fail.Fail].ok{false}; }

    var order: *u32           = nil;
    var count: u32            = 0;
    val r:     err[fail.Fail] = manifest.plan_steps(a, itn, m, ?bu.artifact.name, 1, bu.target, proj_out, ?v, ?order, ?count);
    if (sel r.err) {
        ret res[bool, fail.Fail].err{r.err};
    }
    fin {
        if (order != nil && count > 0) { A.deallocate[u32](a, order, count::usize); }
    }
    var i: u32 = 0;
    for (i < count) {
        val named: opt[str] = intern.get(itn, m.steps[order[i]].name);
        if (sel named.none) { ret res[bool, fail.Fail].err{fail.message("planned step name is not interned")}; }
        val pushed: res[usize, A.Error] = collections_vector.push[str](steps, named.some);
        if (sel pushed.err) { ret res[bool, fail.Fail].err{fail.refused(pushed.err)}; }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{count > 0};
}

pub fun resolve_requirement(a: *A.Allocator, itn: *intern.Interner, tgt: *lang_target.Binding,
    dirs: *Vector[str], root: str,
    req: *manifest.LinkRequirement) res[input.Input, fail.Fail] {
    val text_opt: opt[str] = intern.get(itn, req.text);
    if (sel text_opt.none) {
        ret res[input.Input, fail.Fail].err{fail.message("link requirement text not interned")};
    }
    val text:        str      = text_opt.some;
    val library_opt: opt[str] = intern.get(itn, req.key);
    if (sel library_opt.none) {
        ret res[input.Input, fail.Fail].err{fail.message("link requirement library not interned")};
    }
    val library: str                         = library_opt.some;
    var r:       res[input.Input, fail.Fail] = res[input.Input, fail.Fail].err{fail.message("link requirement unresolved")};
    if (req.source == manifest.LINK_FRAMEWORK) { r = input.framework_resolve(a, tgt, text::*u8); }
    or                                         { r = input.token_resolve(a, tgt, dirs, root, text::*u8); }
    if (sel r.err)                             { ret r; }
    var li: input.Input = r.ok;
    li.library            = library;
    li.include_referenced = req.include_referenced;
    ret res[input.Input, fail.Fail].ok{li};
}

# render the effective plan: one block per selected cell, naming the project,
# target, profile, artifact, entry, output paths, ordered prerequisite steps and
# link requirements. a plan the caller never configured says so instead of
# claiming an empty dependency closure. a phase outside the catalog is an
# internal failure whose message `a` owns
# ---
# w:   the sink; `explain` passes stdout
# p:   the plan
# itn: resolves interned names
pub fun render(a: *A.Allocator, w: *io_writer.Writer, p: *BuildPlan, itn: *intern.Interner) err[fail.Fail] {
    std_format.format(w, "plan:    {}\n", p.request.project_root);
    std_format.format(w, "project: {}\n", p.project);
    std_format.format(w, "units:   {}\n", p.units.len::i64);

    var i: usize = 0;
    for (i < p.units.len) {
        val u: *BuildUnit = ?p.units.data[i];
        std_format.write_str(w, "\n");
        std_format.format(w, "unit {}: {} ({})  target {}  profile {}\n",
            (i + 1)::i64, unit_artifact_label(u), unit_kind_label(u),
            entry_name(itn, u.target_entry.name), u.profile);
        std_format.format(w, "  goal    {}\n", unit_goal_label(u));
        if (!str_empty(u.owner)) { std_format.format(w, "  owner   dependency {}\n", u.owner_chain); }
        std_format.format(w, "  tuple   {}-{}-{}\n",
            entry_name(itn, u.target_entry.isa_name),
            entry_name(itn, u.target_entry.os_name),
            entry_name(itn, u.target_entry.abi_name));
        std_format.format(w, "  optimize {}\n", optimize_name(u.opt_level));
        std_format.format(w, "  entry   {}\n", entry_name(itn, u.target_entry.entrypoint));
        if (!str_empty(u.out_path)) { std_format.format(w, "  out     {}\n", u.out_path); }
        std_format.format(w, "  obj     {}\n", u.obj_dir);
        if (!str_empty(u.ir_dir))  { std_format.format(w, "  ir      {}\n", u.ir_dir); }
        if (!str_empty(u.asm_dir)) { std_format.format(w, "  asm     {}\n", u.asm_dir); }

        var ri: usize = 0;
        for (ri < u.requires.len) {
            std_format.format(w, "  need    artifact {}\n", u.requires.data[ri]);
            ri = ri + 1;
        }
        var dri: usize = 0;
        for (dri < u.dep_requires.len) {
            std_format.format(w, "  need    dependency artifact {}\n", u.dep_requires.data[dri]);
            dri = dri + 1;
        }
        var di: usize = 0;
        for (di < u.dep_steps.len) {
            std_format.format(w, "  step    dependency {}\n", u.dep_steps.data[di]);
            di = di + 1;
        }
        var si: usize = 0;
        for (si < u.steps.len) {
            std_format.format(w, "  step    project {}\n", u.steps.data[si]);
            si = si + 1;
        }

        var mi: u32 = 0;
        for (mi < u.target_entry.lib_count) {
            std_format.format(w, "  link    manifest {}\n", link_requirement_label(itn, ?u.target_entry.libs[mi]));
            mi = mi + 1;
        }
        var ei: usize = 0;
        for (ei < u.export_links.len) {
            std_format.format(w, "  link    dependency export {}\n", link_requirement_label(itn, ?u.export_links.data[ei]));
            ei = ei + 1;
        }
        var li: usize = 0;
        for (li < u.link_inputs.len) {
            val inp: *input.Input = ?u.link_inputs.data[li];
            if (inp.kind == input.STATIC) { std_format.format(w, "  link    static  {}\n", inp.text); }
            or {
                std_format.format(w, "  link    dynamic {}\n", inp.text);
                if (!str_empty(inp.rpath)) { std_format.format(w, "  rpath   {}\n", inp.rpath); }
            }
            li = li + 1;
        }

        std_format.write_str(w, "  phases  ");
        var pi: usize = 0;
        for (pi < u.phases.len) {
            if (pi > 0) { std_format.write_str(w, " -> "); }
            val name: opt[str] = phase_name(u.phases.data[pi]);
            if (sel name.none) {
                ret err[fail.Fail].err{unknown_phase(a, u.phases.data[pi])};
            }
            std_format.write_str(w, name.some);
            pi = pi + 1;
        }
        std_format.write_str(w, "\n");

        if (!u.configured) {
            std_format.write_str(w, "  deps    not resolved: this plan was not configured against the dependency closure\n");
        }
        if (u.dep_steps.len != 0 || u.steps.len != 0 || u.requires.len != 0 || u.dep_requires.len != 0) {
            std_format.write_str(w, "  inputs  generated bytes are unresolved until the prerequisites above run\n");
        }
        i = i + 1;
    }
    std_format.write_str(w, "\nthis plan reports the selected build. it does not read generated bytes, and it does not claim the link succeeds\n");
    ret err[fail.Fail].ok{};
}

pub fun explain(a: *A.Allocator, p: *BuildPlan, itn: *intern.Interner) err[fail.Fail] {
    var w: io_writer.Writer = fs.writer(fs.STDOUT);
    ret render(a, ?w, p, itn);
}

fun link_requirement_label(itn: *intern.Interner, l: *manifest.LinkRequirement) str {
    if (l.source == manifest.LINK_LOCAL) { ret entry_name(itn, l.text); }
    ret entry_name(itn, l.key);
}

fun unit_artifact_label(u: *BuildUnit) str {
    ret u.label;
}

fun unit_kind_label(u: *BuildUnit) str {
    ret catalog_artifact.label_for(u.target_entry.kind);
}

# what a unit's build finishes with: the artifact's own output kind when the goal is the
# finished artifact, and the goal otherwise
fun unit_goal_label(u: *BuildUnit) str {
    if (u.goal != request.GOAL_ARTIFACT) { ret request.goal_name(u.goal); }
    ret catalog_artifact.output_for(u.target_entry.kind);
}

# the text of a plan entry, `(default)` for one the manifest leaves unset
fun entry_name(itn: *intern.Interner, id: intern.StrId) str {
    if (intern.str_is_nil(id)) { ret "(default)"; }
    ret intern.text(itn, id);
}

fun optimize_name(level: u8) str {
    if (level == request.OPT_RELEASE) { ret "true"; }
    ret "false";
}

# the name of a declared build phase, absent for an unknown catalog member
pub fun phase_name(k: PhaseKind) opt[str] {
    if (k == PH_DEP_STEPS) { ret opt[str].some{"dep steps"}; }
    if (k == PH_LOAD)      { ret opt[str].some{"load"}; }
    if (k == PH_STEPS)     { ret opt[str].some{"steps"}; }
    if (k == PH_SEMA)      { ret opt[str].some{"sema"}; }
    if (k == PH_LOWER)     { ret opt[str].some{"lower"}; }
    if (k == PH_CODEGEN)   { ret opt[str].some{"codegen"}; }
    if (k == PH_EMIT)      { ret opt[str].some{"emit"}; }
    if (k == PH_LINK)      { ret opt[str].some{"link"}; }
    if (k == PH_TEST)      { ret opt[str].some{"test"}; }
    ret opt[str].none{};
}

# the origin a failure of the phase is reported under: a build step is the
# build's, a test build's test objects are generated code
pub fun phase_origin(k: PhaseKind) diagnostic.Origin {
    if (k == PH_DEP_STEPS || k == PH_STEPS)              { ret diagnostic.ORIGIN_BUILD; }
    if (k == PH_LOAD)                                    { ret diagnostic.ORIGIN_LOAD; }
    if (k == PH_SEMA)                                    { ret diagnostic.ORIGIN_SEMA; }
    if (k == PH_LOWER)                                   { ret diagnostic.ORIGIN_LOWER; }
    if (k == PH_CODEGEN || k == PH_EMIT || k == PH_TEST) { ret diagnostic.ORIGIN_CODEGEN; }
    if (k == PH_LINK)                                    { ret diagnostic.ORIGIN_LINK; }
    ret diagnostic.ORIGIN_BUILD;
}

# an internal catalog failure with a caller-owned message
pub fun unknown_phase(a: *A.Allocator, k: PhaseKind) fail.Fail {
    ret fail.unknown_catalog(a, "PhaseKind", k::u32);
}
