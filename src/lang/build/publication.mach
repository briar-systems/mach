# what the links a warm host ran wrote: for each artifact path, the revision
# of the link query that wrote it and the digest of the bytes written, so a
# later build at the same revision reuses an artifact nobody touched. the host
# that keeps the session between builds keeps this beside it
use std.collections.map;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.intern;
use mach.lang.query;

rec Publication {
    revision: query.Revision;
    digest:   [32]u8;
}

# keyed by the artifact path, interned in the session the links ran in
pub rec Publications {
    by_path: map.Map[intern.StrId, Publication];
}

pub fun init(alloc: *A.Allocator) Publications {
    ret Publications{by_path: map.init[intern.StrId, Publication](alloc)};
}

pub fun dnit(p: *Publications) {
    map.dnit[intern.StrId, Publication](?p.by_path);
}

# the link at `revision` wrote `digest` to `path`
pub fun record(p: *Publications, itn: *intern.Interner, path: str, revision: query.Revision, digest: *[32]u8) err[fail.Fail] {
    val key: res[intern.StrId, A.Error] = intern.add(itn, path);
    if (sel key.err) { ret err[fail.Fail].err{fail.refused(key.err)}; }
    val stored: res[bool, A.Error] = map.insert[intern.StrId, Publication](?p.by_path, key.ok, Publication{revision: revision, digest: @digest});
    if (sel stored.err) { ret err[fail.Fail].err{fail.refused(stored.err)}; }
    ret err[fail.Fail].ok{};
}

# the digest the link at `revision` wrote to `path`, none when it wrote none there
pub fun at(p: *Publications, itn: *intern.Interner, path: str, revision: query.Revision) res[opt[[32]u8], fail.Fail] {
    val key: res[intern.StrId, A.Error] = intern.add(itn, path);
    if (sel key.err) { ret res[opt[[32]u8], fail.Fail].err{fail.refused(key.err)}; }
    var id:  intern.StrId      = key.ok;
    val got: opt[*Publication] = map.get[intern.StrId, Publication](?p.by_path, ?id);
    if (sel got.some) {
        val found: *Publication = got.some;
        if (found.revision == revision) { ret res[opt[[32]u8], fail.Fail].ok{opt[[32]u8].some{found.digest}}; }
    }
    ret res[opt[[32]u8], fail.Fail].ok{opt[[32]u8].none{}};
}
