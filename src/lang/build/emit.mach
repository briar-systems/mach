pub fun artifact_product_name(p: *project.Project) *u8 {
    val nm: opt[str] = intern.get(?p.s.interner, p.config.bin_name);
    if (sel nm.some) { ret nm.some::*u8; }
    ret ""::*u8;
}

# the resources an executable declares: its icon and manifest, read, with the
# version and names an image's version resource states
pub rec LoadedImageOptions {
    declared:          bool;
    icon_bytes:        Vector[u8];
    manifest_bytes:    Vector[u8];
    icon_path:         str;
    manifest_path:     str;
    version:           str;
    internal_name:     str;
    original_filename: str;
    product_name:      str;
}

# release loaded image options; nil options own nothing
pub fun dnit_image_options(a: *A.Allocator, loaded: *LoadedImageOptions) {
    if (loaded == nil) { ret; }
    collections_vector.dnit[u8](?loaded.icon_bytes);
    collections_vector.dnit[u8](?loaded.manifest_bytes);
    if (loaded.icon_path != nil)     { str_free(a, loaded.icon_path); }
    if (loaded.manifest_path != nil) { str_free(a, loaded.manifest_path); }
}

# the resources an executable declares, read where the target's images state a
# subsystem, as mink's host of it names; an image of another host carries none
pub fun load_image_options(p: *project.Project, out_kind: catalog_artifact.Kind,
    exe_path: *u8) res[LoadedImageOptions, fail.Fail] {
    var loaded: LoadedImageOptions;
    var handed: bool = false;
    loaded.declared          = false;
    loaded.icon_bytes        = collections_vector.init[u8](p.alloc);
    loaded.manifest_bytes    = collections_vector.init[u8](p.alloc);
    loaded.icon_path         = nil;
    loaded.manifest_path     = nil;
    loaded.version           = "";
    loaded.internal_name     = "";
    loaded.original_filename = "";
    loaded.product_name      = "";
    fin {
        if (!handed) { dnit_image_options(p.alloc, ?loaded); }
    }

    if (out_kind != catalog_artifact.EXECUTABLE || !lang_target.states_subsystem(?p.target)) {
        handed = true;
        ret res[LoadedImageOptions, fail.Fail].ok{loaded};
    }
    if (intern.str_is_nil(p.config.icon) && intern.str_is_nil(p.config.app_manifest)) {
        handed = true;
        ret res[LoadedImageOptions, fail.Fail].ok{loaded};
    }

    val root_o: opt[str] = intern.get(?p.s.interner, p.config.project_root);
    val ver_o:  opt[str] = intern.get(?p.s.interner, p.config.version);
    val name_o: opt[str] = intern.get(?p.s.interner, p.config.bin_name);
    if (sel root_o.none) { ret res[LoadedImageOptions, fail.Fail].err{fail.message("resource metadata is not interned")}; }
    if (sel ver_o.none)  { ret res[LoadedImageOptions, fail.Fail].err{fail.message("resource metadata is not interned")}; }
    if (sel name_o.none) { ret res[LoadedImageOptions, fail.Fail].err{fail.message("resource metadata is not interned")}; }

    val icon: err[fail.Fail] = declared_resource_read(p, root_o.some, p.config.icon, "icon", ?loaded.icon_path, ?loaded.icon_bytes);
    if (sel icon.err) { ret res[LoadedImageOptions, fail.Fail].err{icon.err}; }
    val manifest_read: err[fail.Fail] = declared_resource_read(p, root_o.some, p.config.app_manifest, "manifest",
        ?loaded.manifest_path, ?loaded.manifest_bytes);
    if (sel manifest_read.err) { ret res[LoadedImageOptions, fail.Fail].err{manifest_read.err}; }

    loaded.declared          = true;
    loaded.version           = ver_o.some;
    loaded.internal_name     = name_o.some;
    loaded.original_filename = types_path.filename(exe_path::str);
    loaded.product_name      = name_o.some;
    handed                   = true;
    ret res[LoadedImageOptions, fail.Fail].ok{loaded};
}

# reads the artifact resource `rel` declares, relative to the project root,
# into `bytes`, recording its path; nothing when it declares none. `noun` names
# the resource in a refusal
fun declared_resource_read(p: *project.Project, root: str, rel: intern.StrId, noun: str,
    path: *str, bytes: *Vector[u8]) err[fail.Fail] {
    if (intern.str_is_nil(rel)) { ret err[fail.Fail].ok{}; }
    val rel_o: opt[str] = intern.get(?p.s.interner, rel);
    if (sel rel_o.none) { ret err[fail.Fail].err{fail.message_of(fail.join(p.alloc, "artifact ", noun, " path is not interned"))}; }
    val pr: res[str, A.Error] = types_path.join(p.alloc, root, rel_o.some);
    if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
    @path = pr.ok;
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(p.alloc, @path);
    if (sel rr.err) {
        ret err[fail.Fail].err{fail.user_of(diagnostic_kind.ARTIFACT_RESOURCE_UNREADABLE, fail.join(p.alloc,
            "cannot read artifact ", noun, " '", rel_o.some, "' (", @path, "): ", fail.fs_text(rr.err)))};
    }
    collections_vector.dnit[u8](bytes);
    @bytes = rr.ok;
    if (bytes.len == 0) {
        ret err[fail.Fail].err{fail.user_of(diagnostic_kind.ARTIFACT_RESOURCE_EMPTY, fail.join(p.alloc,
            "artifact ", noun, " '", rel_o.some, "' is empty"))};
    }
    ret err[fail.Fail].ok{};
}

fun free_read_bufs(alloc: *A.Allocator, bufs: *Vector[u8], cap: u32) {
    var i: u32 = 0;
    for (i < cap) {
        collections_vector.dnit[u8](?bufs[i]);
        i = i + 1;
    }
    A.deallocate[Vector[u8]](alloc, bufs, cap::usize);
}

# the archive of the emitted modules' objects, read back from `inputs`, as mink's
# archive writer lays one out in the variant its registry states for the target's
# format, its index naming each member's exported symbols
pub fun emit_static_archive(p: *project.Project, destination: str, objects: **Object, inputs: *contract.Input, out_path: **u8) err[fail.Fail] {
    val len:     u32                              = p.emit_len;
    val variant: res[*mink_ar.Variant, fail.Fail] = backend.archive_variant(?p.back, p.alloc);
    if (sel variant.err) { ret err[fail.Fail].err{variant.err}; }

    val res_src: res[*mink_ar.Source, A.Error] = A.allocate[mink_ar.Source](p.alloc, len::usize + 1);
    if (sel res_src.err) { ret err[fail.Fail].err{fail.refused(res_src.err)}; }
    val sources: *mink_ar.Source = res_src.ok;
    fin { A.deallocate[mink_ar.Source](p.alloc, sources, len::usize + 1); }

    val res_bufs: res[*Vector[u8], A.Error] = A.allocate[Vector[u8]](p.alloc, len::usize);
    if (sel res_bufs.err) { ret err[fail.Fail].err{fail.refused(res_bufs.err)}; }
    val bufs: *Vector[u8] = res_bufs.ok;
    fin { free_read_bufs(p.alloc, bufs, len); }

    var i: u32 = 0;
    for (i < len) {
        bufs[i] = collections_vector.init[u8](p.alloc);
        i       = i + 1;
    }

    i = 0;
    for (i < len) {
        val mid:     session.ModuleId     = p.topo[i];
        val m:       *project.ModuleEntry = project.module_at(p, mid::u32);
        val fqn_opt: opt[str]             = intern.get(?p.s.interner, m.fqn);
        if (sel fqn_opt.none) { ret err[fail.Fail].err{fail.message("module FQN not interned")}; }

        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(p.alloc, inputs[i].file);
        if (sel rr.err) { ret err[fail.Fail].err{fail.message("cannot read object for archive")}; }
        bufs[i]    = rr.ok;
        sources[i] = mink_ar.Source{
            name:   Bytes{data: fqn_opt.some::*u8, len: str_len(fqn_opt.some)}, data: Bytes{data: bufs[i].data, len: bufs[i].len},
            object: objects[mid::u32], names: nil, count: 0
        };
        i = i + 1;
    }

    val written: res[Sink, mink_fail.Fail] = mink_ar.build(p.alloc, variant.ok, sources, len::usize);
    if (sel written.err) { ret err[fail.Fail].err{backend.refused_by_mink(p.alloc, "the archive could not be written", written.err)}; }
    var bytes: Sink = written.ok;
    fin { val freed: err[mink_fail.Fail] = sink.release(?bytes); }
    var img: Image          = Image{data: sink.data(?bytes), len: sink.len(?bytes)};
    val wr:  err[fail.Fail] = output.through_temporary[Image](p.alloc, destination, ?img, write_image);
    if (sel wr.err) { ret wr; }
    @out_path = destination::*u8;
    ret err[fail.Fail].ok{};
}

# a library the link names, as mink includes one: the manifest's name of it, the
# library a provider is registered under, and its bytes once read
pub rec Library {
    name:     intern.StrId;
    included: Included;
}

# an external input's bytes, read for the link and kept until it ends
rec Held {
    bytes: Vector[u8];
}

# the bytes of the input at `path`, read into `held`
fun read_input(p: *project.Project, path: str, held: *Held) err[fail.Fail] {
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(p.alloc, path);
    if (sel read.err) {
        ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_INPUT_UNREADABLE, fail.join(p.alloc, "cannot read link input '", path, "': ", fail.fs_text(read.err)))};
    }
    held.bytes = read.ok;
    ret err[fail.Fail].ok{};
}

rec Image {
    data: *u8;
    len:  usize;
}

fun write_image(img: *Image, path: str) err[fail.Fail] {
    val wrote: err[fs.FsError] = fs.write_bytes(path, img.data, img.len, 0o755);
    if (sel wrote.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.FS_WRITE, fail.fs_text(wrote.err))}; }
    ret err[fail.Fail].ok{};
}

# the image of `kind` mink links in memory from the `count` objects at `objects`, in link order,
# the `ext_count` external inputs at `ext` and the `library_count` libraries at `libraries`,
# written to `destination`. a flat image, a position independent image and an executable
# carrying resources are refused
pub fun link_image(p: *project.Project, kind: *mink_output.Kind, flat: bool, objects: **Object, count: u32,
    ext: *contract.Input, ext_count: u32, libraries: *Library, library_count: u32, destination: str, image: *LoadedImageOptions) err[fail.Fail] {
    if (flat) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_NO_LOADER, "a flat image waits for the mink that writes flat images (#4848, mink#493)")};
    }
    if (p.target.pie_default) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_NO_LOADER, "a position independent executable is not yet linked through mink")};
    }
    if (image != nil && image.declared) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SECTION_UNSUPPORTED, "an executable's icon and manifest wait for mink to write PE resources (mink#539)")};
    }
    if (count == 0) { ret err[fail.Fail].err{fail.message("a link requires an object")}; }

    val inputs: usize                 = ext_count::usize + library_count::usize;
    val total:  usize                 = count::usize + inputs;
    val made:   res[*Source, A.Error] = A.allocate[Source](p.alloc, total);
    if (sel made.err) { ret err[fail.Fail].err{fail.refused(made.err)}; }
    val sources: *Source = made.ok;
    fin { A.deallocate[Source](p.alloc, sources, total); }
    var heldv: res[*Held, A.Error] = A.zallocate[Held](p.alloc, inputs + 1);
    if (sel heldv.err) { ret err[fail.Fail].err{fail.refused(heldv.err)}; }
    val held: *Held = heldv.ok;
    fin {
        var k: usize = 0;
        for (k < inputs) {
            collections_vector.dnit[u8](?held[k].bytes);
            k = k + 1;
        }
        A.deallocate[Held](p.alloc, held, inputs + 1);
    }
    var i: u32 = 0;
    for (i < count) {
        sources[i] = Source.object{Given{name: "", object: objects[i]}};
        i          = i + 1;
    }
    i = 0;
    for (i < ext_count) {
        val read: err[fail.Fail] = read_input(p, ext[i].file, ?held[i]);
        if (sel read.err) { ret read; }
        sources[count + i] = Source.bytes{contract.Input{file: ext[i].file, data: held[i].bytes.data, len: held[i].bytes.len}};
        i                  = i + 1;
    }
    i = 0;
    for (i < library_count) {
        val at:   usize          = ext_count::usize + i::usize;
        val lib:  *Library       = ?libraries[i];
        val read: err[fail.Fail] = read_input(p, lib.included.input.file, ?held[at]);
        if (sel read.err) { ret read; }
        var included: Included = lib.included;
        included.input.data        = held[at].bytes.data;
        included.input.len         = held[at].bytes.len;
        sources[count::usize + at] = Source.included{included};
        i                          = i + 1;
    }
    var placed: backend.Image = backend.Image{base: opt[u64].none{}, subsystem: catalog_subsystem.image_of(p.req.subsystem)};
    if (p.target.base != 0) { placed.base = opt[u64].some{p.target.base}; }
    val linked: res[Sink, fail.Fail] = backend.link(?p.back, p.alloc, kind, p.back.format, sources, total, destination, true, ?placed);
    if (sel linked.err) { ret err[fail.Fail].err{linked.err}; }
    var bytes: Sink = linked.ok;
    fin { val freed: err[mink_fail.Fail] = sink.release(?bytes); }
    var img: Image = Image{data: sink.data(?bytes), len: sink.len(?bytes)};
    ret output.through_temporary[Image](p.alloc, destination, ?img, write_image);
}

# the emitted modules' objects in topological order, the link's order
pub fun ordered_objects(p: *project.Project) res[**Object, fail.Fail] {
    val made: res[**Object, A.Error] = A.allocate[*Object](p.alloc, p.emit_len::usize + 1);
    if (sel made.err) { ret res[**Object, fail.Fail].err{fail.refused(made.err)}; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.object == nil) {
            A.deallocate[*Object](p.alloc, made.ok, p.emit_len::usize + 1);
            ret res[**Object, fail.Fail].err{fail.message("a link requires every module's current object")};
        }
        made.ok[i] = m.object;
        i          = i + 1;
    }
    ret res[**Object, fail.Fail].ok{made.ok};
}

pub fun release_ordered(p: *project.Project, objects: **Object) {
    A.deallocate[*Object](p.alloc, objects, p.emit_len::usize + 1);
}

# every emitted module's object at its module index, for a reader that walks modules by id
pub fun indexed_objects(p: *project.Project) res[**Object, fail.Fail] {
    val n:    usize                  = project.module_count(p)::usize + 1;
    val made: res[**Object, A.Error] = A.zallocate[*Object](p.alloc, n);
    if (sel made.err) { ret res[**Object, fail.Fail].err{fail.refused(made.err)}; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: u32                  = p.topo[i]::u32;
        val m:   *project.ModuleEntry = project.module_at(p, mid);
        if (m.object == nil) {
            A.deallocate[*Object](p.alloc, made.ok, n);
            ret res[**Object, fail.Fail].err{fail.message("an archive requires every module's current object")};
        }
        made.ok[mid] = m.object;
        i            = i + 1;
    }
    ret res[**Object, fail.Fail].ok{made.ok};
}

pub fun release_indexed(p: *project.Project, objects: **Object) {
    A.deallocate[*Object](p.alloc, objects, project.module_count(p)::usize + 1);
}

fun count_external_tokens(p: *project.Project, unit: *build_plan.BuildUnit) u32 {
    var n:  u32                  = 0;
    val te: *project.TargetEntry = p.target_entry;
    if (te != nil) { n = n + te.lib_count; }
    n = n + p.config.cascade_lib_count;
    n = n + unit.link_inputs.len::u32;
    ret n;
}

# the unit's static link inputs appended to `inputs` after whatever it already
# holds, and the libraries it links against in `libraries`
pub fun append_external_inputs(p: *project.Project, unit: *build_plan.BuildUnit,
    inputs: **contract.Input, len: *u32,
    libraries: **Library, library_len: *u32) err[fail.Fail] {
    @libraries   = nil;
    @library_len = 0;
    linkage.providers_clear(?p.linkage);
    val extra: u32 = count_external_tokens(p, unit);
    if (extra == 0) { ret err[fail.Fail].ok{}; }

    val base:     u32          = @len;
    val grown:    u32          = base + extra;
    var cap:      u32          = base;
    val res_grow: err[A.Error] = growth.resize[contract.Input](p.alloc, inputs, ?cap, grown::usize);
    if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }

    var z: u32 = base;
    for (z < grown) {
        (@inputs)[z] = contract.Input{file: nil, data: nil, len: 0};
        z            = z + 1;
    }
    @len = grown;

    var written: u32 = base;

    val te: *project.TargetEntry = p.target_entry;
    if (te != nil) {
        var i: u32 = 0;
        for (i < te.lib_count) {
            val rc: err[fail.Fail] = resolve_and_store_input(p, ?te.libs[i],
                @inputs, ?written, libraries, library_len);
            if (sel rc.err) {
                shrink_inputs(p, inputs, len, written, grown);
                ret rc;
            }
            i = i + 1;
        }
    }

    var i: u32 = 0;
    for (i < p.config.cascade_lib_count) {
        val rc: err[fail.Fail] = resolve_and_store_input(p, ?p.config.cascade_libs[i],
            @inputs, ?written, libraries, library_len);
        if (sel rc.err) {
            shrink_inputs(p, inputs, len, written, grown);
            ret rc;
        }
        i = i + 1;
    }

    var ti: usize = 0;
    for (ti < unit.link_inputs.len) {
        val rc: err[fail.Fail] = store_fact(p, ?unit.link_inputs.data[ti],
            @inputs, ?written, libraries, library_len);
        if (sel rc.err) {
            shrink_inputs(p, inputs, len, written, grown);
            ret rc;
        }
        ti = ti + 1;
    }

    shrink_inputs(p, inputs, len, written, grown);
    ret err[fail.Fail].ok{};
}

fun store_fact(p: *project.Project, li: *input.Input, inputs: *contract.Input, written: *u32,
    libraries: **Library, library_len: *u32) err[fail.Fail] {
    val pr: err[fail.Fail] = register_link_provider(p, li);
    if (sel pr.err) { ret pr; }
    if (li.kind == input.DYNAMIC) {
        ret append_library(p, li, libraries, library_len);
    }
    if (static_path_present(inputs, @written, li.text)) {
        ret err[fail.Fail].ok{};
    }
    val dup_r: res[str, types_string.StrError] = str_copy(p.alloc, li.text::*u8);
    if (sel dup_r.err) { ret err[fail.Fail].err{fail.str_refused(dup_r.err)}; }
    inputs[@written] = contract.Input{file: dup_r.ok, data: nil, len: 0};
    @written         = @written + 1;
    ret err[fail.Fail].ok{};
}

fun shrink_inputs(p: *project.Project, inputs: **contract.Input, len: *u32, written: u32, grown: u32) {
    var cap:        u32          = grown;
    val res_shrink: err[A.Error] = growth.resize[contract.Input](p.alloc, inputs, ?cap, written::usize);
    if (sel res_shrink.err) {
        @len = grown;
        ret;
    }
    @len = written;
}

# a library the input `li` names joins `libraries` once: the same name found as
# another file is refused
fun append_library(p: *project.Project, li: *input.Input,
    libraries: **Library, library_len: *u32) err[fail.Fail] {
    var name_text: str = li.text;
    if (!str_empty(li.library)) { name_text = li.library; }
    val name_r: res[intern.StrId, A.Error] = intern.add(?p.s.interner, name_text);
    if (sel name_r.err) { ret err[fail.Fail].err{fail.refused(name_r.err)}; }
    val name: intern.StrId = name_r.ok;

    var i: u32 = 0;
    for (i < @library_len) {
        val had: *Library = ?(@libraries)[i];
        if (intern.str_same(had.name, name)) {
            if (str_equals(had.included.input.file, li.text)) { ret err[fail.Fail].ok{}; }
            ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_LOADER_NAME_CONFLICT, library_conflict_message(
                p, name, had.included.input.file, li.text))};
        }
        i = i + 1;
    }

    val path_r: res[intern.StrId, A.Error] = intern.add(?p.s.interner, li.text);
    if (sel path_r.err) { ret err[fail.Fail].err{fail.refused(path_r.err)}; }
    val path: str = intern.text(?p.s.interner, path_r.ok);

    var include: Include = Include.always{};
    if (li.include_referenced) { include = Include.referenced{}; }
    val old:      u32          = @library_len;
    var cap:      u32          = old;
    val res_grow: err[A.Error] = growth.resize[Library](p.alloc, libraries, ?cap, old::usize + 1);
    if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
    (@libraries)[old] = Library{
        name:     name,
        included: Included{input: contract.Input{file: path, data: nil, len: 0}, include: include, searched: !str_empty(li.library), path: path}
    };
    @library_len = old + 1;
    ret err[fail.Fail].ok{};
}

fun library_conflict_message(p: *project.Project, name: intern.StrId, first: str, second: str) res[str, fail.Fail] {
    val r: res[str, types_string.StrError] = str_join(p.alloc,
        "link library '", intern.text(?p.s.interner, name), "' resolves to both '", first, "' and '", second, "'");
    if (sel r.err) { ret res[str, fail.Fail].err{fail.str_refused(r.err)}; }
    ret res[str, fail.Fail].ok{r.ok};
}

pub fun free_libraries(a: *A.Allocator, libraries: *Library, library_len: u32) {
    if (libraries != nil && library_len > 0) {
        A.deallocate[Library](a, libraries, library_len::usize);
    }
}

fun resolve_and_store_input(p: *project.Project, req: *manifest.LinkRequirement,
    inputs: *contract.Input, written: *u32,
    libraries: **Library, library_len: *u32) err[fail.Fail] {
    val lr: res[input.Input, fail.Fail] = build_plan.resolve_requirement(p.alloc, ?p.s.interner, ?p.target,
        ?p.req.lib_dirs, p.req.project_root, req);
    if (sel lr.err) {
        ret err[fail.Fail].err{lr.err};
    }
    val li: input.Input    = lr.ok;
    val pr: err[fail.Fail] = register_link_provider(p, ?li);
    if (sel pr.err) { ret pr; }
    if (li.kind == input.DYNAMIC) {
        val cr: err[fail.Fail] = register_link_claims(p, req);
        if (sel cr.err) { ret cr; }
        ret append_library(p, ?li, libraries, library_len);
    }
    if (req.symbol_count > 0) {
        ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_STATIC_CLAIMS_SYMBOLS, static_claim_message(p, req))};
    }
    if (static_path_present(inputs, @written, li.text)) {
        A.deallocate[u8](p.alloc, li.text::*u8, str_len(li.text) + 1);
        ret err[fail.Fail].ok{};
    }
    inputs[@written] = contract.Input{file: li.text, data: nil, len: 0};
    @written         = @written + 1;
    ret err[fail.Fail].ok{};
}

fun register_link_provider(p: *project.Project, li: *input.Input) err[fail.Fail] {
    if (str_empty(li.library)) { ret err[fail.Fail].ok{}; }
    val nr: res[intern.StrId, A.Error] = intern.add(?p.s.interner, li.library);
    if (sel nr.err) {
        ret err[fail.Fail].err{fail.refused(nr.err)};
    }
    val rr: err[fail.Fail] = linkage.register_provider(?p.linkage, nr.ok, li.kind == input.STATIC);
    if (sel rr.err) { ret rr; }
    ret err[fail.Fail].ok{};
}

fun register_link_claims(p: *project.Project, req: *manifest.LinkRequirement) err[fail.Fail] {
    var i: u32 = 0;
    for (i < req.symbol_count) {
        val ln: res[intern.StrId, fail.Fail] = project.link_name_for(p, req.symbols[i]);
        if (sel ln.err) {
            ret err[fail.Fail].err{ln.err};
        }
        val sym:  intern.StrId = ln.ok;
        val prev: intern.StrId = linkage.import_library(?p.linkage, sym);
        if (!intern.str_is_nil(prev)) {
            val had: intern.StrId = prev;
            if (!intern.str_same(had, req.key)) {
                ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_SYMBOL_CLAIM_CONFLICT,
                    claim_conflict_message(p, sym, had, req.key))};
            }
            i = i + 1;
            cnt;
        }
        val register_import_library_r: err[fail.Fail] = linkage.register_import_library(?p.linkage, sym, req.key);
        if (sel register_import_library_r.err) { ret register_import_library_r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun claim_conflict_message(p: *project.Project, sym: intern.StrId,
    first: intern.StrId, second: intern.StrId) res[str, fail.Fail] {
    val r: res[str, types_string.StrError] = str_join(p.alloc,
        "symbol '", intern.text(?p.s.interner, sym), "' is claimed by link library '",
        intern.text(?p.s.interner, first), "' and '", intern.text(?p.s.interner, second),
        "'; a symbol may name only one providing library");
    if (sel r.err) { ret res[str, fail.Fail].err{fail.str_refused(r.err)}; }
    ret res[str, fail.Fail].ok{r.ok};
}

fun static_claim_message(p: *project.Project, req: *manifest.LinkRequirement) res[str, fail.Fail] {
    val r: res[str, types_string.StrError] = str_join(p.alloc,
        "link entry '", intern.text(?p.s.interner, req.text),
        "' resolves to a static input, which defines symbols rather than importing them; ",
        "remove its 'symbols' key");
    if (sel r.err) { ret res[str, fail.Fail].err{fail.str_refused(r.err)}; }
    ret res[str, fail.Fail].ok{r.ok};
}

fun static_path_present(inputs: *contract.Input, written: u32, candidate: str) bool {
    var i: u32 = 0;
    for (i < written) {
        if (inputs[i].file != nil && str_equals(inputs[i].file, candidate)) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub rec ObjectWrite {
    p:      *project.Project;
    o:      *Object;
    record: *project.Record;
}

pub fun write_object(w: *ObjectWrite, destination: str) err[fail.Fail] {
    var laid: res[Sink, fail.Fail] = res[Sink, fail.Fail].err{fail.message("")};
    if (w.record != nil && w.record.bytes != nil && lang_target.carries_record(?w.p.target)) {
        laid = backend.object_bytes_with(?w.p.back, w.p.alloc, w.o, backend.RECORD_SECTION, w.record.bytes, w.record.len::usize);
    }
    or                { laid = backend.object_bytes(?w.p.back, w.p.alloc, w.o); }
    if (sel laid.err) { ret err[fail.Fail].err{laid.err}; }
    var bytes: Sink = laid.ok;
    fin { val freed: err[mink_fail.Fail] = sink.release(?bytes); }
    val wrote: err[fs.FsError] = fs.write_bytes(destination, sink.data(?bytes), sink.len(?bytes), 0o644);
    if (sel wrote.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.FS_WRITE, fail.fs_text(wrote.err))}; }
    ret err[fail.Fail].ok{};
}

# every module's object reaches `obj/` through a sibling temporary, carrying its cache record,
# since the object cache reads it back; a module the cache restored is already there
pub fun write_objects(p: *project.Project, destinations: *str, inputs_out: **contract.Input) err[fail.Fail] {
    val len: u32 = p.emit_len;
    if (len == 0) {
        @inputs_out = nil;
        ret err[fail.Fail].ok{};
    }
    val res_inputs: res[*contract.Input, A.Error] = A.allocate[contract.Input](p.alloc, len::usize);
    if (sel res_inputs.err) { ret err[fail.Fail].err{fail.refused(res_inputs.err)}; }
    val inputs: *contract.Input = res_inputs.ok;
    var i:      u32             = 0;
    var filled: u32             = 0;
    var handed: bool            = false;
    fin {
        if (!handed) { free_inputs(p.alloc, inputs, filled, len); }
    }
    for (i < len) {
        val mid:         session.ModuleId     = p.topo[i];
        val m:           *project.ModuleEntry = project.module_at(p, mid::u32);
        val destination: str                  = destinations[i];
        val copied:      res[str, A.Error]    = str_dup(p.alloc, destination);
        if (sel copied.err) { ret err[fail.Fail].err{fail.refused(copied.err)}; }
        inputs[i] = contract.Input{file: copied.ok, data: nil, len: 0};
        filled    = i + 1;
        if (cache.restored(p, m)) {
            i = i + 1;
            cnt;
        }
        if (m.object == nil) { ret err[fail.Fail].err{fail.message("an object was not compiled")}; }
        val t_item:  readout.Instant = readout.item_begin(p.progress);
        var write:   ObjectWrite     = ObjectWrite{p: p, o: m.object, record: ?m.record};
        val emitted: err[fail.Fail]  = output.through_temporary[ObjectWrite](p.alloc, destination, ?write, write_object);
        if (sel emitted.err) { ret emitted; }
        readout.item(p.progress, readout.EMIT, intern.text(?p.s.interner, m.fqn), t_item);
        i = i + 1;
    }
    handed      = true;
    @inputs_out = inputs;
    ret err[fail.Fail].ok{};
}

# each test object reaches `obj/` beside its module's object, the same way
# ---
# destinations: per emitted module, its test object's path, nil for a module without one
pub fun write_test_objects(p: *project.Project, destinations: *str) err[fail.Fail] {
    if (destinations == nil) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (destinations[i] == nil || cache.test_restored(p, m)) {
            i = i + 1;
            cnt;
        }
        if (m.test.object == nil) { ret err[fail.Fail].err{fail.message("a test object was not compiled")}; }
        val t_item:  readout.Instant = readout.item_begin(p.progress);
        var write:   ObjectWrite     = ObjectWrite{p: p, o: m.test.object, record: ?m.test.record};
        val emitted: err[fail.Fail]  = output.through_temporary[ObjectWrite](p.alloc, destinations[i], ?write, write_object);
        if (sel emitted.err) { ret emitted; }
        readout.item(p.progress, readout.EMIT, destinations[i], t_item);
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# release `n` object inputs and their array of `cap`; a nil array owns nothing
pub fun free_inputs(a: *A.Allocator, inputs: *contract.Input, n: u32, cap: u32) {
    if (inputs == nil) { ret; }
    var i: u32 = 0;
    for (i < n) {
        if (inputs[i].file != nil) { A.deallocate[u8](a, inputs[i].file::*u8, (str_len(inputs[i].file) + 1)::usize); }
        i = i + 1;
    }
    if (cap > 0) { A.deallocate[contract.Input](a, inputs, cap::usize); }
}
