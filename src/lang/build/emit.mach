val DIR_MODE: i32 = 0o0755;

pub fun ensure_parents(a: *A.Allocator, p: str) O.Option[str] {
    val pr: R.Result[str, str] = path.parent(a, p);
    if (R.is_err[str, str](pr)) { ret O.some[str](R.unwrap_err[str, str](pr)); }
    val parent: str = R.unwrap_ok[str, str](pr);
    fin { str_free(a, parent); }
    ret fs.create_dir_all(a, parent, DIR_MODE);
}

rec AsmWriteContext {
    p:   *driver.Project;
    m:   *ir.Module;
    dbg: codegen.DebugInfo;
}

fun write_asm_codegen(ctx: *AsmWriteContext, out: *writer.Writer) R.Result[R.Void, str] {
    val res: R.Result[of.ObjectImage, fail.Fail] = codegen.codegen_module(ctx.p.s, ?ctx.p.target, ctx.m,
        cgunit.ir_set_empty(), out, ctx.p.req.placement_policy, ctx.dbg);
    if (R.is_err[of.ObjectImage, fail.Fail](res)) {
        ret R.err[R.Void, str](R.unwrap_err[of.ObjectImage, fail.Fail](res).message);
    }
    var img: of.ObjectImage = R.unwrap_ok[of.ObjectImage, fail.Fail](res);
    obj.dnit(?img);
    ret R.ok_void[str]();
}

pub fun emit_asm(p: *driver.Project, destination: *publication.Destination, m: *ir.Module) R.Result[R.Void, str] {

    val dbg_r: R.Result[codegen.DebugInfo, str] = driver.debug_info_of(p);
    if (R.is_err[codegen.DebugInfo, str](dbg_r)) {
        ret R.err[R.Void, str](R.unwrap_err[codegen.DebugInfo, str](dbg_r));
    }

    var ctx: AsmWriteContext;
    ctx.p   = p;
    ctx.m   = m;
    ctx.dbg = R.unwrap_ok[codegen.DebugInfo, str](dbg_r);
    ret publication.writer_at[AsmWriteContext](nil, p.alloc, ?destination.claim, destination.path, ?ctx, write_asm_codegen, 0o644, publication.REPLACE, "write", "the artifact could not be published");
}

rec IrWriteContext {
    m:        *ir.Module;
    interner: *intern.Interner;
    context:  printer.IrDebugContext;
}

fun write_ir_debug(iwc: *IrWriteContext, out: *writer.Writer) R.Result[R.Void, str] {
    var debug: printer.IrDebugWriter = printer.debug_writer(out, iwc.m, iwc.interner, iwc.context);
    ret printer.write_debug(?debug);
}

rec PartialWriteContext {}

fun test_partial_ir_write(ctx: *PartialWriteContext,
                          out: *writer.Writer) R.Result[R.Void, str] {
    val write_r: O.Option[str] = writer.write_all(out, "partial", 7);
    if (O.is_some[str](write_r)) { ret R.err[R.Void, str](O.unwrap[str](write_r)); }
    ret R.err[R.Void, str]("forced IR write failure");
}

test "mach.lang.build.emit.publish_writer_at:writer_failure_preserves_prior_artifact" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val temp_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_emit_ir_publish");
    if (R.is_err[fs.TempFile, str](temp_r)) { ret 1; }
    var temp: fs.TempFile = R.unwrap_ok[fs.TempFile, str](temp_r);
    val artifact_path: str = fs.temp_path(?temp);
    if (O.is_some[str](fs.temp_close(?temp))) { fs.temp_remove(?temp); ret 1; }

    val prior: str = "complete-prior-artifact";
    if (O.is_some[str](fs.write_bytes(artifact_path, prior::*u8, str_len(prior), 0o644))) {
        fs.temp_remove(?temp); ret 1;
    }
    var pwc: PartialWriteContext;
    val publish_r: R.Result[R.Void, str] = publication.writer[PartialWriteContext](nil, ?alloc, artifact_path, ?pwc, test_partial_ir_write, 0o644, publication.REPLACE, publication.PARENTS_CREATE, "write", "the artifact could not be published");
    if (R.is_ok[R.Void, str](publish_r)) { fs.temp_remove(?temp); ret 1; }

    val read_r: R.Result[str, str] = fs.read_string(?alloc, artifact_path);
    if (R.is_err[str, str](read_r)) { fs.temp_remove(?temp); ret 1; }
    val got: str = R.unwrap_ok[str, str](read_r);
    val same: bool = str_equals(got, prior);
    str_free(?alloc, got);
    fs.temp_remove(?temp);
    if (!same) { ret 1; }
    ret 0;
}

pub fun emit_ir(p: *driver.Project, destination: *publication.Destination, m: *ir.Module) R.Result[R.Void, str] {
    if (p.target_entry == nil) { ret R.err[R.Void, str]("selected target is unavailable"); }

    val opt_target: O.Option[str] = intern.lookup(?p.s.interner, p.target_entry.name);
    if (O.is_none[str](opt_target)) { ret R.err[R.Void, str]("selected target name is not interned"); }
    if (p.target.isa == nil || p.target.os == nil || p.target.abi == nil || p.target.of == nil) {
        ret R.err[R.Void, str]("selected target metadata is unavailable");
    }


    var iwc: IrWriteContext;
    iwc.m = m;
    iwc.interner = ?p.s.interner;
    iwc.context = printer.debug_context(
        "post-codegen", O.unwrap[str](opt_target), p.target.isa.name,
        p.target.os.name, p.target.abi.name, p.target.of.name);
    ret publication.writer_at[IrWriteContext](nil, p.alloc, ?destination.claim, destination.path, ?iwc, write_ir_debug, 0o644, publication.REPLACE, "write", "the artifact could not be published");
}

pub fun artifact_product_name(p: *driver.Project) *u8 {
    val nm: O.Option[str] = intern.lookup(?p.s.interner, p.config.bin_name);
    if (O.is_some[str](nm)) { ret O.unwrap[str](nm)::*u8; }
    ret ""::*u8;
}

pub rec LoadedImageOptions {
    options:       of.ImageOptions;
    resource:      *of.ResourceInfo;
    icon_bytes:    Vector[u8];
    manifest_bytes: Vector[u8];
    icon_path:     str;
    manifest_path: str;
}

pub fun dnit_image_options(a: *A.Allocator, loaded: *LoadedImageOptions) {
    if (loaded == nil) { ret; }
    vector.dnit[u8](?loaded.icon_bytes);
    vector.dnit[u8](?loaded.manifest_bytes);
    if (loaded.icon_path != nil) { str_free(a, loaded.icon_path); }
    if (loaded.manifest_path != nil) { str_free(a, loaded.manifest_path); }
    if (loaded.resource != nil) { A.deallocate[of.ResourceInfo](a, loaded.resource, 1); }
}

pub fun load_image_options(p: *driver.Project, out_kind: linker.LinkMode,
                           exe_path: *u8) R.Result[LoadedImageOptions, outcome.Fail] {
    var loaded: LoadedImageOptions;
    loaded.options = of.image_options_default(p.req.subsystem);
    loaded.resource = nil;
    loaded.icon_bytes = vector.init[u8](p.alloc);
    loaded.manifest_bytes = vector.init[u8](p.alloc);
    loaded.icon_path = nil;
    loaded.manifest_path = nil;

    if (out_kind != linker.LINK_EXE || p.target.os_id != os.OS_WINDOWS) {
        ret R.ok[LoadedImageOptions, outcome.Fail](loaded);
    }
    if (p.config.icon == intern.STR_NIL && p.config.app_manifest == intern.STR_NIL) {
        ret R.ok[LoadedImageOptions, outcome.Fail](loaded);
    }

    val root_o: O.Option[str] = intern.lookup(?p.s.interner, p.config.project_root);
    val ver_o: O.Option[str] = intern.lookup(?p.s.interner, p.config.version);
    val name_o: O.Option[str] = intern.lookup(?p.s.interner, p.config.bin_name);
    if (O.is_none[str](root_o) || O.is_none[str](ver_o) || O.is_none[str](name_o)) {
        dnit_image_options(p.alloc, ?loaded);
        ret R.err[LoadedImageOptions, outcome.Fail](outcome.internal("PE resource metadata is not interned"));
    }

    if (p.config.icon != intern.STR_NIL) {
        val rel_o: O.Option[str] = intern.lookup(?p.s.interner, p.config.icon);
        if (O.is_none[str](rel_o)) {
            dnit_image_options(p.alloc, ?loaded);
            ret R.err[LoadedImageOptions, outcome.Fail](outcome.internal("PE icon path is not interned"));
        }
        val pr: R.Result[str, str] = path.join(p.alloc, O.unwrap[str](root_o), O.unwrap[str](rel_o));
        if (R.is_err[str, str](pr)) {
            dnit_image_options(p.alloc, ?loaded);
            ret R.err[LoadedImageOptions, outcome.Fail](outcome.internal(R.unwrap_err[str, str](pr)));
        }
        loaded.icon_path = R.unwrap_ok[str, str](pr);
        val rr: R.Result[Vector[u8], str] = fs.read_bytes(p.alloc, loaded.icon_path);
        if (R.is_err[Vector[u8], str](rr)) {
            val msg_r: R.Result[str, str] = str_join(p.alloc, "cannot read artifact icon '",
                O.unwrap[str](rel_o), "' (", loaded.icon_path, "): ",
                R.unwrap_err[Vector[u8], str](rr));
            var msg: str = "cannot read artifact icon";
            if (R.is_ok[str, str](msg_r)) { msg = R.unwrap_ok[str, str](msg_r); }
            dnit_image_options(p.alloc, ?loaded);
            ret R.err[LoadedImageOptions, outcome.Fail](outcome.user(msg));
        }
        loaded.icon_bytes = R.unwrap_ok[Vector[u8], str](rr);
        if (loaded.icon_bytes.len == 0) {
            val msg_r: R.Result[str, str] = str_join(p.alloc, "artifact icon '",
                O.unwrap[str](rel_o), "' is empty");
            var msg: str = "artifact icon is empty";
            if (R.is_ok[str, str](msg_r)) { msg = R.unwrap_ok[str, str](msg_r); }
            dnit_image_options(p.alloc, ?loaded);
            ret R.err[LoadedImageOptions, outcome.Fail](outcome.user(msg));
        }
    }

    if (p.config.app_manifest != intern.STR_NIL) {
        val rel_o: O.Option[str] = intern.lookup(?p.s.interner, p.config.app_manifest);
        if (O.is_none[str](rel_o)) {
            dnit_image_options(p.alloc, ?loaded);
            ret R.err[LoadedImageOptions, outcome.Fail](outcome.internal("PE manifest path is not interned"));
        }
        val pr: R.Result[str, str] = path.join(p.alloc, O.unwrap[str](root_o), O.unwrap[str](rel_o));
        if (R.is_err[str, str](pr)) {
            dnit_image_options(p.alloc, ?loaded);
            ret R.err[LoadedImageOptions, outcome.Fail](outcome.internal(R.unwrap_err[str, str](pr)));
        }
        loaded.manifest_path = R.unwrap_ok[str, str](pr);
        val rr: R.Result[Vector[u8], str] = fs.read_bytes(p.alloc, loaded.manifest_path);
        if (R.is_err[Vector[u8], str](rr)) {
            val msg_r: R.Result[str, str] = str_join(p.alloc, "cannot read artifact manifest '",
                O.unwrap[str](rel_o), "' (", loaded.manifest_path, "): ",
                R.unwrap_err[Vector[u8], str](rr));
            var msg: str = "cannot read artifact manifest";
            if (R.is_ok[str, str](msg_r)) { msg = R.unwrap_ok[str, str](msg_r); }
            dnit_image_options(p.alloc, ?loaded);
            ret R.err[LoadedImageOptions, outcome.Fail](outcome.user(msg));
        }
        loaded.manifest_bytes = R.unwrap_ok[Vector[u8], str](rr);
        if (loaded.manifest_bytes.len == 0) {
            val msg_r: R.Result[str, str] = str_join(p.alloc, "artifact manifest '",
                O.unwrap[str](rel_o), "' is empty");
            var msg: str = "artifact manifest is empty";
            if (R.is_ok[str, str](msg_r)) { msg = R.unwrap_ok[str, str](msg_r); }
            dnit_image_options(p.alloc, ?loaded);
            ret R.err[LoadedImageOptions, outcome.Fail](outcome.user(msg));
        }
    }

    val ar: R.Result[*of.ResourceInfo, str] = A.zallocate[of.ResourceInfo](p.alloc, 1);
    if (R.is_err[*of.ResourceInfo, str](ar)) {
        dnit_image_options(p.alloc, ?loaded);
        ret R.err[LoadedImageOptions, outcome.Fail](outcome.internal(R.unwrap_err[*of.ResourceInfo, str](ar)));
    }
    loaded.resource = R.unwrap_ok[*of.ResourceInfo, str](ar);
    loaded.resource.icon = loaded.icon_bytes.data;
    loaded.resource.icon_len = loaded.icon_bytes.len;
    loaded.resource.app_manifest = loaded.manifest_bytes.data;
    loaded.resource.app_manifest_len = loaded.manifest_bytes.len;
    loaded.resource.version = O.unwrap[str](ver_o);
    loaded.resource.internal_name = O.unwrap[str](name_o);
    loaded.resource.original_filename = path.filename(exe_path::str);
    loaded.resource.product_name = O.unwrap[str](name_o);
    loaded.options.resources = loaded.resource;
    ret R.ok[LoadedImageOptions, outcome.Fail](loaded);
}

fun free_members(alloc: *A.Allocator, members: *ar.ArMember, cap: u32) {
    var i: u32 = 0;
    for (i < cap) {
        if (members[i].sym_names != nil && members[i].sym_count > 0) { A.deallocate[str](alloc, members[i].sym_names, members[i].sym_count::usize); }
        i = i + 1;
    }
    A.deallocate[ar.ArMember](alloc, members, cap::usize);
}

fun free_read_bufs(alloc: *A.Allocator, bufs: *Vector[u8], cap: u32) {
    var i: u32 = 0;
    for (i < cap) { vector.dnit[u8](?bufs[i]); i = i + 1; }
    A.deallocate[Vector[u8]](alloc, bufs, cap::usize);
}

fun collect_defined_globals(p: *driver.Project, img: *of.ObjectImage, member: *ar.ArMember) bool {
    member.sym_names = nil;
    member.sym_count = 0;
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < img.symbol_count) {
        if ((img.symbols[i].flags & of.SYM_OBJ_FLAG_GLOBAL) != 0 && img.symbols[i].section != of.SECTION_EXTERNAL) { n = n + 1; }
        i = i + 1;
    }
    if (n == 0) { ret true; }
    val res: R.Result[*str, str] = A.allocate[str](p.alloc, n::usize);
    if (R.is_err[*str, str](res)) { ret false; }
    val names: *str = R.unwrap_ok[*str, str](res);
    var w: u32 = 0;
    i = 0;
    for (i < img.symbol_count) {
        if ((img.symbols[i].flags & of.SYM_OBJ_FLAG_GLOBAL) != 0 && img.symbols[i].section != of.SECTION_EXTERNAL) {
            val nm: O.Option[str] = intern.lookup(img.interner, img.symbols[i].name);
            if (O.is_some[str](nm)) { names[w] = O.unwrap[str](nm); w = w + 1; }
        }
        i = i + 1;
    }
    member.sym_names = names;
    member.sym_count = w;
    ret true;
}

pub fun emit_static_archive(p: *driver.Project, destination: *publication.Destination, images: *of.ObjectImage, paths: **u8, out_path: **u8) R.Result[R.Void, outcome.Fail] {
    val len: u32 = p.emit_len;

    val archive: str = destination.path;

    val res_mem: R.Result[*ar.ArMember, str] = A.allocate[ar.ArMember](p.alloc, len::usize);
    if (R.is_err[*ar.ArMember, str](res_mem)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    val members: *ar.ArMember = R.unwrap_ok[*ar.ArMember, str](res_mem);

    val res_bufs: R.Result[*Vector[u8], str] = A.allocate[Vector[u8]](p.alloc, len::usize);
    if (R.is_err[*Vector[u8], str](res_bufs)) { free_members(p.alloc, members, len); ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    val bufs: *Vector[u8] = R.unwrap_ok[*Vector[u8], str](res_bufs);

    var i: u32 = 0;
    for (i < len) {
        members[i].name = ""; members[i].data = nil; members[i].len = 0; members[i].sym_names = nil; members[i].sym_count = 0;
        bufs[i] = vector.init[u8](p.alloc);
        i = i + 1;
    }

    i = 0;
    for (i < len) {
        val mid: session.ModuleId    = p.topo[i];
        val m:   *driver.ModuleEntry = ?p.modules[mid::u32];
        val fqn_opt: O.Option[str]   = intern.lookup(?p.s.interner, m.fqn);
        if (O.is_none[str](fqn_opt)) { free_read_bufs(p.alloc, bufs, len); free_members(p.alloc, members, len); ret R.err[R.Void, outcome.Fail](outcome.internal("module FQN not interned")); }
        members[i].name = O.unwrap[str](fqn_opt);

        val rr: R.Result[Vector[u8], str] = fs.read_bytes(p.alloc, paths[i]::str);
        if (R.is_err[Vector[u8], str](rr)) { free_read_bufs(p.alloc, bufs, len); free_members(p.alloc, members, len); ret R.err[R.Void, outcome.Fail](outcome.internal("cannot read object for archive")); }
        bufs[i] = R.unwrap_ok[Vector[u8], str](rr);
        members[i].data = bufs[i].data;
        members[i].len  = bufs[i].len;

        if (!collect_defined_globals(p, ?images[mid::u32], ?members[i])) { free_read_bufs(p.alloc, bufs, len); free_members(p.alloc, members, len); ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
        i = i + 1;
    }

    val wr: R.Result[R.Void, str] = ar.write_archive(p.alloc, members, len, destination);
    free_read_bufs(p.alloc, bufs, len);
    free_members(p.alloc, members, len);
    if (R.is_err[R.Void, str](wr)) {
        ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[R.Void, str](wr)));
    }
    @out_path = archive;
    ret R.ok_void[outcome.Fail]();
}

pub fun emit_shared_library(p: *driver.Project, destination: *publication.Destination, paths: **u8, len: u32,
                            dynlibs: *of.DynLib, dynlib_len: u32, out_path: **u8) R.Result[R.Void, outcome.Fail] {
    val solib: str = destination.path;

    val res_link: R.Result[R.Void, str] =
        linker.link(p.s, ?p.target, paths, len, dynlibs, dynlib_len, destination, artifact_product_name(p), linker.LINK_SHARED, p.req.pie, of.image_options_default(p.req.subsystem));
    if (R.is_err[R.Void, str](res_link)) {
        ret R.err[R.Void, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](res_link)));
    }
    @out_path = solib;
    ret R.ok_void[outcome.Fail]();
}

pub fun link_executable(p: *driver.Project, paths: **u8, len: u32,
                        dynlibs: *of.DynLib, dynlib_len: u32, destination: *publication.Destination,
                        image_options: of.ImageOptions) R.Result[R.Void, outcome.Fail] {
    val res_link: R.Result[R.Void, str] =
        linker.link(p.s, ?p.target, paths, len, dynlibs, dynlib_len, destination, artifact_product_name(p), linker.LINK_EXE, p.req.pie, image_options);
    if (R.is_err[R.Void, str](res_link)) {
        ret R.err[R.Void, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](res_link)));
    }
    ret R.ok_void[outcome.Fail]();
}

fun gather_topo_images(p: *driver.Project, images: *of.ObjectImage) R.Result[*of.ObjectImage, str] {
    val len: u32 = p.emit_len;
    val res_ord: R.Result[*of.ObjectImage, str] = A.allocate[of.ObjectImage](p.alloc, len::usize);
    if (R.is_err[*of.ObjectImage, str](res_ord)) { ret res_ord; }
    val ordered: *of.ObjectImage = R.unwrap_ok[*of.ObjectImage, str](res_ord);
    var i: u32 = 0;
    for (i < len) {
        ordered[i] = images[(p.topo[i])::u32];
        i = i + 1;
    }
    ret R.ok[*of.ObjectImage, str](ordered);
}

pub fun link_flat_images(p: *driver.Project, images: *of.ObjectImage, destination: *publication.Destination,
                         image_options: of.ImageOptions) R.Result[R.Void, outcome.Fail] {
    val res_ord: R.Result[*of.ObjectImage, str] = gather_topo_images(p, images);
    if (R.is_err[*of.ObjectImage, str](res_ord)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    val ordered: *of.ObjectImage = R.unwrap_ok[*of.ObjectImage, str](res_ord);

    val res_link: R.Result[R.Void, str] =
        linker.link_images(p.s, ?p.target, ordered, p.emit_len, nil::*of.DynLib, 0, destination, artifact_product_name(p), linker.LINK_EXE, p.req.pie, image_options);
    A.deallocate[of.ObjectImage](p.alloc, ordered, p.emit_len::usize);
    if (R.is_err[R.Void, str](res_link)) {
        ret R.err[R.Void, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](res_link)));
    }
    ret R.ok_void[outcome.Fail]();
}

pub fun link_mixed_images(p: *driver.Project, images: *of.ObjectImage,
                          ext_paths: **u8, ext_count: u32,
                          dynlibs: *of.DynLib, dynlib_len: u32, destination: *publication.Destination,
                          image_options: of.ImageOptions) R.Result[R.Void, outcome.Fail] {
    val res_ord: R.Result[*of.ObjectImage, str] = gather_topo_images(p, images);
    if (R.is_err[*of.ObjectImage, str](res_ord)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    val ordered: *of.ObjectImage = R.unwrap_ok[*of.ObjectImage, str](res_ord);

    val res_link: R.Result[R.Void, str] =
        linker.link_mixed(p.s, ?p.target, ordered, p.emit_len, ext_paths, ext_count,
                          dynlibs, dynlib_len, destination, artifact_product_name(p), linker.LINK_EXE, p.req.pie, image_options);
    A.deallocate[of.ObjectImage](p.alloc, ordered, p.emit_len::usize);
    if (R.is_err[R.Void, str](res_link)) {
        ret R.err[R.Void, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](res_link)));
    }
    ret R.ok_void[outcome.Fail]();
}

fun count_external_tokens(p: *driver.Project, unit: *plan.BuildUnit) u32 {
    var n: u32 = 0;
    val te: *driver.TargetEntry = p.target_entry;
    if (te != nil) { n = n + te.lib_count; }
    n = n + p.config.cascade_lib_count;
    n = n + unit.link_inputs.len::u32;
    ret n;
}

pub fun append_external_inputs(p: *driver.Project, unit: *plan.BuildUnit,
                               paths: ***u8, len: *u32,
                               dynlibs: **of.DynLib, dynlib_len: *u32) R.Result[R.Void, outcome.Fail] {
    @dynlibs    = nil;
    @dynlib_len = 0;
    session.reset_link_providers(p.s);
    val extra: u32 = count_external_tokens(p, unit);
    if (extra == 0) { ret R.ok_void[outcome.Fail](); }

    val base:  u32 = @len;
    val grown: u32 = base + extra;
    val res_grow: R.Result[**u8, str] = A.reallocate[*u8](p.alloc, @paths, base::usize, grown::usize);
    if (R.is_err[**u8, str](res_grow)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    @paths = R.unwrap_ok[**u8, str](res_grow);

    var z: u32 = base;
    for (z < grown) { (@paths)[z] = nil; z = z + 1; }
    @len = grown;

    var written: u32 = base;

    val te: *driver.TargetEntry = p.target_entry;
    if (te != nil) {
        var i: u32 = 0;
        for (i < te.lib_count) {
            val rc: R.Result[R.Void, outcome.Fail] = resolve_and_store_input(p, ?te.libs[i],
                                                    @paths, ?written, dynlibs, dynlib_len);
            if (R.is_err[R.Void, outcome.Fail](rc)) { shrink_paths(p, paths, len, written, grown); ret rc; }
            i = i + 1;
        }
    }

    var i: u32 = 0;
    for (i < p.config.cascade_lib_count) {
        val rc: R.Result[R.Void, outcome.Fail] = resolve_and_store_input(p, ?p.config.cascade_libs[i],
                                                @paths, ?written, dynlibs, dynlib_len);
        if (R.is_err[R.Void, outcome.Fail](rc)) { shrink_paths(p, paths, len, written, grown); ret rc; }
        i = i + 1;
    }

    var ti: usize = 0;
    for (ti < unit.link_inputs.len) {
        val rc: R.Result[R.Void, outcome.Fail] = store_fact(p, ?unit.link_inputs.data[ti],
                                                @paths, ?written, dynlibs, dynlib_len);
        if (R.is_err[R.Void, outcome.Fail](rc)) { shrink_paths(p, paths, len, written, grown); ret rc; }
        ti = ti + 1;
    }

    shrink_paths(p, paths, len, written, grown);
    ret R.ok_void[outcome.Fail]();
}

fun store_fact(p: *driver.Project, li: *plan.LinkInput, paths: **u8, written: *u32,
               dynlibs: **of.DynLib, dynlib_len: *u32) R.Result[R.Void, outcome.Fail] {
    val pr: R.Result[R.Void, outcome.Fail] = register_link_provider(p, li);
    if (R.is_err[R.Void, outcome.Fail](pr)) { ret pr; }
    if (li.kind == plan.LINK_DYNAMIC) {
        ret append_dynlib(p, li, dynlibs, dynlib_len);
    }
    if (static_path_present(paths, @written, li.text)) {
        ret R.ok_void[outcome.Fail]();
    }
    val dup_r: R.Result[str, str] = str_copy(p.alloc, li.text::*u8);
    if (R.is_err[str, str](dup_r)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    paths[@written] = R.unwrap_ok[str, str](dup_r);
    @written = @written + 1;
    ret R.ok_void[outcome.Fail]();
}

fun shrink_paths(p: *driver.Project, paths: ***u8, len: *u32, written: u32, grown: u32) {
    if (written < grown) {
        val res_shrink: R.Result[**u8, str] = A.reallocate[*u8](p.alloc, @paths, grown::usize, written::usize);
        if (R.is_ok[**u8, str](res_shrink)) {
            @paths = R.unwrap_ok[**u8, str](res_shrink);
            @len   = written;
            ret;
        }
    }
    @len = grown;
}

fun append_dynlib(p: *driver.Project, li: *plan.LinkInput,
                  dynlibs: **of.DynLib, dynlib_len: *u32) R.Result[R.Void, outcome.Fail] {
    val res_intern: R.Result[intern.StrId, str] = intern.intern(?p.s.interner, li.text);
    if (R.is_err[intern.StrId, str](res_intern)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    val soname: intern.StrId = R.unwrap_ok[intern.StrId, str](res_intern);
    var name: intern.StrId = soname;
    if (!str_empty(li.library)) {
        val name_r: R.Result[intern.StrId, str] =
            intern.intern(?p.s.interner, li.library);
        if (R.is_err[intern.StrId, str](name_r)) {
            ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory"));
        }
        name = R.unwrap_ok[intern.StrId, str](name_r);
    }
    var rpath: intern.StrId = intern.STR_NIL;
    if (!str_empty(li.rpath)) {
        val rp_r: R.Result[intern.StrId, str] = intern.intern(?p.s.interner, li.rpath);
        if (R.is_err[intern.StrId, str](rp_r)) {
            ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory"));
        }
        rpath = R.unwrap_ok[intern.StrId, str](rp_r);
    }

    var i: u32 = 0;
    for (i < @dynlib_len) {
        if ((@dynlibs)[i].name == name) {
            if ((@dynlibs)[i].soname == soname) {
                if ((@dynlibs)[i].rpath == intern.STR_NIL) { (@dynlibs)[i].rpath = rpath; }
                ret R.ok_void[outcome.Fail]();
            }
            ret R.err[R.Void, outcome.Fail](outcome.user(dynlib_conflict_message(
                p, name, (@dynlibs)[i].soname, soname)));
        }
        i = i + 1;
    }

    val old: u32 = @dynlib_len;
    val res_grow: R.Result[*of.DynLib, str] =
        A.reallocate[of.DynLib](p.alloc, @dynlibs, old::usize, (old + 1)::usize);
    if (R.is_err[*of.DynLib, str](res_grow)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    @dynlibs = R.unwrap_ok[*of.DynLib, str](res_grow);
    (@dynlibs)[old].name = name;
    (@dynlibs)[old].soname = soname;
    (@dynlibs)[old].rpath = rpath;
    (@dynlibs)[old].include_referenced = li.include_referenced;
    @dynlib_len = old + 1;
    ret R.ok_void[outcome.Fail]();
}

test "mach.lang.build.emit.append_dynlib:reinterns_logical_name" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var p: driver.Project;
    p.s = ?s;
    p.alloc = ?alloc;
    var li: plan.LinkInput;
    li.kind = plan.LINK_DYNAMIC;
    li.text = "libfoo.so.1";
    li.library = "foo";
    li.rpath = "";
    var libs: *of.DynLib = nil;
    var len: u32 = 0;
    val ar: R.Result[R.Void, outcome.Fail] = append_dynlib(?p, ?li, ?libs, ?len);
    if (R.is_err[R.Void, outcome.Fail](ar) || len != 1) {
        session.dnit(?s);
        ret 1;
    }
    val name: O.Option[str] = intern.lookup(?s.interner, libs[0].name);
    val loader: O.Option[str] = intern.lookup(?s.interner, libs[0].soname);
    val bad: bool = !O.is_some[str](name) || !O.is_some[str](loader)
        || !str_equals(O.unwrap[str](name), "foo")
        || !str_equals(O.unwrap[str](loader), "libfoo.so.1");
    free_dynlibs(?alloc, libs, len);
    session.dnit(?s);
    if (bad) { ret 1; }
    ret 0;
}

fun dynlib_conflict_message(p: *driver.Project, name: intern.StrId,
                            first: intern.StrId, second: intern.StrId) str {
    val n: O.Option[str] = intern.lookup(?p.s.interner, name);
    val a: O.Option[str] = intern.lookup(?p.s.interner, first);
    val b: O.Option[str] = intern.lookup(?p.s.interner, second);
    if (!O.is_some[str](n) || !O.is_some[str](a) || !O.is_some[str](b)) {
        ret "one logical link library resolves to multiple loader names";
    }
    val r: R.Result[str, str] = str_join(p.alloc,
        "link library '", O.unwrap[str](n), "' resolves to both '",
        O.unwrap[str](a), "' and '", O.unwrap[str](b), "'");
    if (R.is_err[str, str](r)) { ret R.unwrap_err[str, str](r); }
    ret R.unwrap_ok[str, str](r);
}

pub fun free_dynlibs(a: *A.Allocator, dynlibs: *of.DynLib, dynlib_len: u32) {
    if (dynlibs != nil && dynlib_len > 0) {
        A.deallocate[of.DynLib](a, dynlibs, dynlib_len::usize);
    }
}

fun resolve_and_store_input(p: *driver.Project, req: *manifest.LinkRequirement,
                            paths: **u8, written: *u32,
                            dynlibs: **of.DynLib, dynlib_len: *u32) R.Result[R.Void, outcome.Fail] {
    val lr: R.Result[plan.LinkInput, outcome.Fail] =
        plan.resolve_requirement(p.alloc, ?p.s.interner, ?p.target,
                                 ?p.req.lib_dirs, p.req.project_root, req);
    if (R.is_err[plan.LinkInput, outcome.Fail](lr)) {
        ret R.err[R.Void, outcome.Fail](R.unwrap_err[plan.LinkInput, outcome.Fail](lr));
    }
    val li: plan.LinkInput = R.unwrap_ok[plan.LinkInput, outcome.Fail](lr);
    val pr: R.Result[R.Void, outcome.Fail] = register_link_provider(p, ?li);
    if (R.is_err[R.Void, outcome.Fail](pr)) { ret pr; }
    if (li.kind == plan.LINK_DYNAMIC) {
        val cr: R.Result[R.Void, outcome.Fail] = register_link_claims(p, req);
        if (R.is_err[R.Void, outcome.Fail](cr)) { ret cr; }
        ret append_dynlib(p, ?li, dynlibs, dynlib_len);
    }
    if (req.symbol_count > 0) {
        ret R.err[R.Void, outcome.Fail](outcome.user(static_claim_message(p, req)));
    }
    if (static_path_present(paths, @written, li.text)) {
        A.deallocate[u8](p.alloc, li.text::*u8, str_len(li.text) + 1);
        ret R.ok_void[outcome.Fail]();
    }
    paths[@written] = li.text::*u8;
    @written = @written + 1;
    ret R.ok_void[outcome.Fail]();
}

fun register_link_provider(p: *driver.Project, li: *plan.LinkInput) R.Result[R.Void, outcome.Fail] {
    if (str_empty(li.library)) { ret R.ok_void[outcome.Fail](); }
    val nr: R.Result[intern.StrId, str] = intern.intern(?p.s.interner, li.library);
    if (R.is_err[intern.StrId, str](nr)) {
        ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory"));
    }
    val rr: R.Result[R.Void, str] = session.register_link_provider(
        p.s, R.unwrap_ok[intern.StrId, str](nr), li.kind == plan.LINK_STATIC);
    if (R.is_err[R.Void, str](rr)) {
        ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory"));
    }
    ret R.ok_void[outcome.Fail]();
}

fun register_link_claims(p: *driver.Project, req: *manifest.LinkRequirement) R.Result[R.Void, outcome.Fail] {
    var i: u32 = 0;
    for (i < req.symbol_count) {
        val ln: R.Result[intern.StrId, str] = driver.link_name_for(p, req.symbols[i]);
        if (R.is_err[intern.StrId, str](ln)) {
            ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[intern.StrId, str](ln)));
        }
        val sym: intern.StrId = R.unwrap_ok[intern.StrId, str](ln);
        val prev: O.Option[intern.StrId] = session.import_library(p.s, sym);
        if (O.is_some[intern.StrId](prev)) {
            val had: intern.StrId = O.unwrap[intern.StrId](prev);
            if (had != req.library) {
                ret R.err[R.Void, outcome.Fail](outcome.user(
                    claim_conflict_message(p, sym, had, req.library)));
            }
            i = i + 1;
            cnt;
        }
        if (R.is_err[R.Void, str](session.register_import_library(p.s, sym, req.library))) {
            ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory"));
        }
        i = i + 1;
    }
    ret R.ok_void[outcome.Fail]();
}

test "mach.lang.build.emit.register_link_claims:pins_and_rejects_conflicts" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { session.dnit(?s); ret 1; }

    var p: driver.Project;
    p.s = ?s;
    p.alloc = ?alloc;

    val sym_r:   R.Result[intern.StrId, str] = intern.intern(?s.interner, "Sleep");
    val pre_r:   R.Result[intern.StrId, str] = intern.intern(?s.interner, "_Sleep");
    val k32_r:   R.Result[intern.StrId, str] = intern.intern(?s.interner, "kernel32");
    val u32_r:   R.Result[intern.StrId, str] = intern.intern(?s.interner, "user32");
    if (R.is_err[intern.StrId, str](sym_r) || R.is_err[intern.StrId, str](pre_r)
        || R.is_err[intern.StrId, str](k32_r)
        || R.is_err[intern.StrId, str](u32_r)) { session.dnit(?s); ret 1; }
    var syms: [1]intern.StrId;
    syms[0] = R.unwrap_ok[intern.StrId, str](sym_r);

    var req: manifest.LinkRequirement;
    req.source       = manifest.LINK_SYSTEM;
    req.text         = R.unwrap_ok[intern.StrId, str](k32_r);
    req.library      = R.unwrap_ok[intern.StrId, str](k32_r);
    req.symbols      = ?syms[0];
    req.symbol_count = 1;

    var code: i32 = 0;

    val lr: R.Result[target.Target, str] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (R.is_err[target.Target, str](lr)) { session.dnit(?s); ret 1; }
    p.target = R.unwrap_ok[target.Target, str](lr);

    if (R.is_err[R.Void, outcome.Fail](register_link_claims(?p, ?req))) { code = 1; }
    val got: O.Option[intern.StrId] = session.import_library(?s, syms[0]);
    if (!O.is_some[intern.StrId](got) || O.unwrap[intern.StrId](got) != req.library) { code = 1; }

    if (R.is_err[R.Void, outcome.Fail](register_link_claims(?p, ?req))) { code = 1; }

    var other: manifest.LinkRequirement = req;
    other.library = R.unwrap_ok[intern.StrId, str](u32_r);
    if (R.is_ok[R.Void, outcome.Fail](register_link_claims(?p, ?other))) { code = 1; }

    session.reset_module_registry(?s);
    val dr: R.Result[target.Target, str] = target.select(?reg, "x86_64", "darwin", "sysv64");
    if (R.is_err[target.Target, str](dr)) { session.dnit(?s); ret 1; }
    p.target = R.unwrap_ok[target.Target, str](dr);

    if (R.is_err[R.Void, outcome.Fail](register_link_claims(?p, ?req))) { code = 1; }
    val dgot: O.Option[intern.StrId] =
        session.import_library(?s, R.unwrap_ok[intern.StrId, str](pre_r));
    if (!O.is_some[intern.StrId](dgot) || O.unwrap[intern.StrId](dgot) != req.library) { code = 1; }
    if (O.is_some[intern.StrId](session.import_library(?s, syms[0]))) { code = 1; }

    if (R.is_ok[R.Void, outcome.Fail](register_link_claims(?p, ?other))) { code = 1; }

    session.dnit(?s);
    ret code;
}

fun claim_conflict_message(p: *driver.Project, sym: intern.StrId,
                           first: intern.StrId, second: intern.StrId) str {
    val n: O.Option[str] = intern.lookup(?p.s.interner, sym);
    val a: O.Option[str] = intern.lookup(?p.s.interner, first);
    val b: O.Option[str] = intern.lookup(?p.s.interner, second);
    if (!O.is_some[str](n) || !O.is_some[str](a) || !O.is_some[str](b)) {
        ret "one symbol is claimed by two link libraries";
    }
    val r: R.Result[str, str] = str_join(p.alloc,
        "symbol '", O.unwrap[str](n), "' is claimed by link library '",
        O.unwrap[str](a), "' and '", O.unwrap[str](b),
        "'; a symbol may name only one providing library");
    if (R.is_err[str, str](r)) { ret R.unwrap_err[str, str](r); }
    ret R.unwrap_ok[str, str](r);
}

fun static_claim_message(p: *driver.Project, req: *manifest.LinkRequirement) str {
    val t: O.Option[str] = intern.lookup(?p.s.interner, req.text);
    if (!O.is_some[str](t)) {
        ret "a link entry that resolves to a static input cannot claim symbols";
    }
    val r: R.Result[str, str] = str_join(p.alloc,
        "link entry '", O.unwrap[str](t),
        "' resolves to a static input, which defines symbols rather than importing them; ",
        "remove its 'symbols' key");
    if (R.is_err[str, str](r)) { ret R.unwrap_err[str, str](r); }
    ret R.unwrap_ok[str, str](r);
}

fun static_path_present(paths: **u8, written: u32, candidate: str) bool {
    var i: u32 = 0;
    for (i < written) {
        if (paths[i] != nil && str_equals(paths[i]::str, candidate)) { ret true; }
        i = i + 1;
    }
    ret false;
}

test "mach.lang.build.emit.static_path_present:deduplicates_exact_paths" {
    var paths: [3]*u8;
    paths[0] = "one.o"::*u8;
    paths[1] = "libsame.a"::*u8;
    paths[2] = nil;
    if (!static_path_present(?paths[0], 2, "libsame.a")) { ret 1; }
    if (static_path_present(?paths[0], 2, "other.a")) { ret 1; }
    ret 0;
}

pub fun write_objects(p: *driver.Project, images: *of.ObjectImage,
                      destinations: **publication.Destination, paths_out: ***u8) R.Result[R.Void, outcome.Fail] {
    val len: u32 = p.emit_len;
    if (len == 0) { @paths_out = nil; ret R.ok_void[outcome.Fail](); }
    val res_paths: R.Result[**u8, str] = A.allocate[*u8](p.alloc, len::usize);
    if (R.is_err[**u8, str](res_paths)) { ret R.err[R.Void, outcome.Fail](outcome.internal("out of memory")); }
    val paths: **u8 = R.unwrap_ok[**u8, str](res_paths);
    var i: u32 = 0;
    for (i < len) {
        val mid: session.ModuleId = p.topo[i];
        val m: *driver.ModuleEntry = ?p.modules[mid::u32];
        val destination: *publication.Destination = destinations[i];
        val copied: R.Result[str, str] = str_dup(p.alloc, destination.path);
        if (R.is_err[str, str](copied)) {
            free_paths(p.alloc, paths, i, len);
            ret R.err[R.Void, outcome.Fail](outcome.internal(R.unwrap_err[str, str](copied)));
        }
        paths[i] = R.unwrap_ok[str, str](copied);
        val t_item: ctime.Time = readout.item_begin(p.events);
        val emitted: R.Result[R.Void, str] = obj.emit(?images[mid::u32], ?p.target, destination);
        if (R.is_err[R.Void, str](emitted)) {
            free_paths(p.alloc, paths, i + 1, len);
            ret R.err[R.Void, outcome.Fail](outcome.environment(R.unwrap_err[R.Void, str](emitted)));
        }
        readout.item(p.events, readout.PH_EMIT, driver.fqn_name(p, m.fqn), t_item);
        i = i + 1;
    }
    @paths_out = paths;
    ret R.ok_void[outcome.Fail]();
}

pub fun mirror_fqn(a: *A.Allocator, base: *u8, fqn: str, suffix: str) R.Result[str, str] {
    val rel_r: R.Result[str, str] = str_replace(a, fqn, ".", "/");
    if (R.is_err[str, str](rel_r)) { ret rel_r; }
    val rel: str = R.unwrap_ok[str, str](rel_r);
    fin { str_free(a, rel); }
    val leaf_r: R.Result[str, str] = str_join(a, rel, ".", suffix);
    if (R.is_err[str, str](leaf_r)) { ret leaf_r; }
    val leaf: str = R.unwrap_ok[str, str](leaf_r);
    fin { str_free(a, leaf); }
    ret path.join(a, base::str, leaf);
}

pub fun free_paths(a: *A.Allocator, paths: **u8, n: u32, cap: u32) {
    if (paths == nil) { ret; }
    var i: u32 = 0;
    for (i < n) {
        if (paths[i] != nil) { A.deallocate[u8](a, paths[i], (str_len(paths[i]::str) + 1)::usize); }
        i = i + 1;
    }
    if (cap > 0) { A.deallocate[*u8](a, paths, cap::usize); }
}
