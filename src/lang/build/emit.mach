rec AsmWriteContext {
    p:   *driver.Project;
    m:   *me_ir.Module;
    dbg: codegen.DebugInfo;
}

# a producer's failure is the transaction's: a refused codegen is a stalled
# write (nothing persisted), which the transaction folds into a rejection
fun write_asm_codegen(ctx: *AsmWriteContext, out: *io_writer.Writer) err[io_writer.WriteError] {
    val outcome_r: res[target_of.ObjectImage, fail.Fail] = codegen.codegen_unit(ctx.p.s, ?ctx.p.target, ctx.m,
        be_codegen_unit.ir_set_empty(), out, ctx.p.req.placement_policy, ctx.dbg, ?ctx.p.diags);
    if (sel outcome_r.err) {
        ret err[io_writer.WriteError].err{io_writer.WriteError.stalled{0}};
    }
    var img: target_of.ObjectImage = outcome_r.ok;
    obj.dnit(?img);
    ret err[io_writer.WriteError].ok{};
}

pub fun emit_asm(p: *driver.Project, destination: str, m: *me_ir.Module) err[outcome.Fail] {
    val dbg_r: res[codegen.DebugInfo, fail.Fail] = driver.debug_info_of(p);
    if (sel dbg_r.err) {
        ret err[outcome.Fail].err{outcome.from_fail(dbg_r.err)};
    }

    var ctx: AsmWriteContext;
    ctx.p   = p;
    ctx.m   = m;
    ctx.dbg = dbg_r.ok;
    ret output.writer[AsmWriteContext](nil, p.alloc, destination, ?ctx, write_asm_codegen, 0o644, "write", "the artifact could not be published");
}

rec IrWriteContext {
    m:        *me_ir.Module;
    interner: *intern.Interner;
    sources:  *lang_source.SourceMap;
    context:  ir_printer.IrContext;
    form:     ir_printer.IrForm;
}

fun write_ir_form(iwc: *IrWriteContext, out: *io_writer.Writer) err[io_writer.WriteError] {
    var w: ir_printer.IrWriter = ir_printer.ir_writer(out, iwc.m, iwc.interner, iwc.sources,
        iwc.context, iwc.form);
    val written: err[fail.Fail] = ir_printer.write_ir(?w);
    if (sel written.err) { ret err[io_writer.WriteError].err{io_writer.WriteError.stalled{0}}; }
    ret err[io_writer.WriteError].ok{};
}

pub fun emit_ir(p: *driver.Project, destination: str, m: *me_ir.Module) err[outcome.Fail] {
    if (p.target_entry == nil) { ret err[outcome.Fail].err{outcome.internal("selected target is unavailable")}; }

    val opt_target: opt[str] = intern.lookup(?p.s.interner, p.target_entry.name);
    if (sel opt_target.none) { ret err[outcome.Fail].err{outcome.internal("selected target name is not interned")}; }
    if (p.target.isa == nil || p.target.os == nil || p.target.abi == nil || p.target.of == nil) {
        ret err[outcome.Fail].err{outcome.internal("selected target metadata is unavailable")};
    }

    var iwc: IrWriteContext;
    iwc.m        = m;
    iwc.interner = ?p.s.interner;
    iwc.sources  = ?p.s.sources;
    iwc.form     = p.req.ir_form;
    iwc.context  = ir_printer.ir_context(
        "post-codegen", opt_target.some, p.target.isa.name,
        p.target.os.name, p.target.abi.name, p.target.of.name);
    ret output.writer[IrWriteContext](nil, p.alloc, destination, ?iwc, write_ir_form, 0o644, "write", "the artifact could not be published");
}

pub fun artifact_product_name(p: *driver.Project) *u8 {
    val nm: opt[str] = intern.lookup(?p.s.interner, p.config.bin_name);
    if (sel nm.some) { ret nm.some::*u8; }
    ret ""::*u8;
}

pub rec LoadedImageOptions {
    options:        target_of.ImageOptions;
    resource:       *target_of.ResourceInfo;
    icon_bytes:     Vector[u8];
    manifest_bytes: Vector[u8];
    icon_path:      str;
    manifest_path:  str;
}

pub fun dnit_image_options(a: *std_allocator.Allocator, loaded: *LoadedImageOptions) {
    if (loaded == nil) { ret; }
    collections_vector.dnit[u8](?loaded.icon_bytes);
    collections_vector.dnit[u8](?loaded.manifest_bytes);
    if (loaded.icon_path != nil)     { str_free(a, loaded.icon_path); }
    if (loaded.manifest_path != nil) { str_free(a, loaded.manifest_path); }
    if (loaded.resource != nil)      { std_allocator.deallocate[target_of.ResourceInfo](a, loaded.resource, 1); }
}

pub fun load_image_options(p: *driver.Project, out_kind: linker.LinkMode,
    exe_path: *u8) res[LoadedImageOptions, outcome.Fail] {
    var loaded: LoadedImageOptions;
    loaded.options        = target_of.image_options_default(p.req.subsystem);
    loaded.resource       = nil;
    loaded.icon_bytes     = collections_vector.init[u8](p.alloc);
    loaded.manifest_bytes = collections_vector.init[u8](p.alloc);
    loaded.icon_path      = nil;
    loaded.manifest_path  = nil;

    if (out_kind != linker.LINK_EXE || p.target.os_id != lang_target_os.OS_WINDOWS) {
        ret res[LoadedImageOptions, outcome.Fail].ok{loaded};
    }
    if (p.config.icon == intern.STR_NIL && p.config.app_manifest == intern.STR_NIL) {
        ret res[LoadedImageOptions, outcome.Fail].ok{loaded};
    }

    val root_o: opt[str] = intern.lookup(?p.s.interner, p.config.project_root);
    val ver_o:  opt[str] = intern.lookup(?p.s.interner, p.config.version);
    val name_o: opt[str] = intern.lookup(?p.s.interner, p.config.bin_name);
    if (sel root_o.none) {
        dnit_image_options(p.alloc, ?loaded);
        ret res[LoadedImageOptions, outcome.Fail].err{outcome.internal("PE resource metadata is not interned")};
    }
    if (sel ver_o.none) {
        dnit_image_options(p.alloc, ?loaded);
        ret res[LoadedImageOptions, outcome.Fail].err{outcome.internal("PE resource metadata is not interned")};
    }
    if (sel name_o.none) {
        dnit_image_options(p.alloc, ?loaded);
        ret res[LoadedImageOptions, outcome.Fail].err{outcome.internal("PE resource metadata is not interned")};
    }

    if (p.config.icon != intern.STR_NIL) {
        val rel_o: opt[str] = intern.lookup(?p.s.interner, p.config.icon);
        if (sel rel_o.none) {
            dnit_image_options(p.alloc, ?loaded);
            ret res[LoadedImageOptions, outcome.Fail].err{outcome.internal("PE icon path is not interned")};
        }
        val pr: res[str, std_allocator.Error] = types_path.join(p.alloc, root_o.some, rel_o.some);
        if (sel pr.err) {
            dnit_image_options(p.alloc, ?loaded);
            ret res[LoadedImageOptions, outcome.Fail].err{outcome.refused(pr.err)};
        }
        loaded.icon_path = pr.ok;
        val rr: res[Vector[u8], std_filesystem.FsError] = std_filesystem.read_bytes(p.alloc, loaded.icon_path);
        if (sel rr.err) {
            val msg_r: res[str, types_string.StrError] = str_join(p.alloc, "cannot read artifact icon '",
                rel_o.some, "' (", loaded.icon_path, "): ",
                outcome.fs_text(rr.err));
            var msg: str = "cannot read artifact icon";
            if (sel msg_r.ok) { msg = msg_r.ok; }
            dnit_image_options(p.alloc, ?loaded);
            ret res[LoadedImageOptions, outcome.Fail].err{outcome.user(diagnostic_kind.ARTIFACT_RESOURCE_UNREADABLE, msg)};
        }
        loaded.icon_bytes = rr.ok;
        if (loaded.icon_bytes.len == 0) {
            val msg_r: res[str, types_string.StrError] = str_join(p.alloc, "artifact icon '",
                rel_o.some, "' is empty");
            var msg: str = "artifact icon is empty";
            if (sel msg_r.ok) { msg = msg_r.ok; }
            dnit_image_options(p.alloc, ?loaded);
            ret res[LoadedImageOptions, outcome.Fail].err{outcome.user(diagnostic_kind.ARTIFACT_RESOURCE_EMPTY, msg)};
        }
    }

    if (p.config.app_manifest != intern.STR_NIL) {
        val rel_o: opt[str] = intern.lookup(?p.s.interner, p.config.app_manifest);
        if (sel rel_o.none) {
            dnit_image_options(p.alloc, ?loaded);
            ret res[LoadedImageOptions, outcome.Fail].err{outcome.internal("PE manifest path is not interned")};
        }
        val pr: res[str, std_allocator.Error] = types_path.join(p.alloc, root_o.some, rel_o.some);
        if (sel pr.err) {
            dnit_image_options(p.alloc, ?loaded);
            ret res[LoadedImageOptions, outcome.Fail].err{outcome.refused(pr.err)};
        }
        loaded.manifest_path = pr.ok;
        val rr: res[Vector[u8], std_filesystem.FsError] = std_filesystem.read_bytes(p.alloc, loaded.manifest_path);
        if (sel rr.err) {
            val msg_r: res[str, types_string.StrError] = str_join(p.alloc, "cannot read artifact manifest '",
                rel_o.some, "' (", loaded.manifest_path, "): ",
                outcome.fs_text(rr.err));
            var msg: str = "cannot read artifact manifest";
            if (sel msg_r.ok) { msg = msg_r.ok; }
            dnit_image_options(p.alloc, ?loaded);
            ret res[LoadedImageOptions, outcome.Fail].err{outcome.user(diagnostic_kind.ARTIFACT_RESOURCE_UNREADABLE, msg)};
        }
        loaded.manifest_bytes = rr.ok;
        if (loaded.manifest_bytes.len == 0) {
            val msg_r: res[str, types_string.StrError] = str_join(p.alloc, "artifact manifest '",
                rel_o.some, "' is empty");
            var msg: str = "artifact manifest is empty";
            if (sel msg_r.ok) { msg = msg_r.ok; }
            dnit_image_options(p.alloc, ?loaded);
            ret res[LoadedImageOptions, outcome.Fail].err{outcome.user(diagnostic_kind.ARTIFACT_RESOURCE_EMPTY, msg)};
        }
    }

    val ar: res[*target_of.ResourceInfo, std_allocator.Error] = std_allocator.zallocate[target_of.ResourceInfo](p.alloc, 1);
    if (sel ar.err) {
        dnit_image_options(p.alloc, ?loaded);
        ret res[LoadedImageOptions, outcome.Fail].err{outcome.refused(ar.err)};
    }
    loaded.resource                   = ar.ok;
    loaded.resource.icon              = loaded.icon_bytes.data;
    loaded.resource.icon_len          = loaded.icon_bytes.len;
    loaded.resource.app_manifest      = loaded.manifest_bytes.data;
    loaded.resource.app_manifest_len  = loaded.manifest_bytes.len;
    loaded.resource.version           = ver_o.some;
    loaded.resource.internal_name     = name_o.some;
    loaded.resource.original_filename = types_path.filename(exe_path::str);
    loaded.resource.product_name      = name_o.some;
    loaded.options.resources          = loaded.resource;
    ret res[LoadedImageOptions, outcome.Fail].ok{loaded};
}

fun free_members(alloc: *std_allocator.Allocator, members: *ar.ArMember, cap: u32) {
    var i: u32 = 0;
    for (i < cap) {
        if (members[i].sym_names != nil && members[i].sym_count > 0) { std_allocator.deallocate[str](alloc, members[i].sym_names, members[i].sym_count::usize); }
        i = i + 1;
    }
    std_allocator.deallocate[ar.ArMember](alloc, members, cap::usize);
}

fun free_read_bufs(alloc: *std_allocator.Allocator, bufs: *Vector[u8], cap: u32) {
    var i: u32 = 0;
    for (i < cap) {
        collections_vector.dnit[u8](?bufs[i]);
        i = i + 1;
    }
    std_allocator.deallocate[Vector[u8]](alloc, bufs, cap::usize);
}

fun collect_defined_globals(p: *driver.Project, img: *target_of.ObjectImage, member: *ar.ArMember) bool {
    member.sym_names = nil;
    member.sym_count = 0;
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < img.symbol_count) {
        if ((img.symbols[i].flags & target_of.SYM_OBJ_FLAG_GLOBAL) != 0 && !target_of.section_is_external(img.symbols[i].section)) { n = n + 1; }
        i = i + 1;
    }
    if (n == 0) { ret true; }
    val outcome_r: res[*str, std_allocator.Error] = std_allocator.allocate[str](p.alloc, n::usize);
    if (sel outcome_r.err) { ret false; }
    val names: *str = outcome_r.ok;
    var w:     u32  = 0;
    i = 0;
    for (i < img.symbol_count) {
        if ((img.symbols[i].flags & target_of.SYM_OBJ_FLAG_GLOBAL) != 0 && !target_of.section_is_external(img.symbols[i].section)) {
            val nm: opt[str] = intern.lookup(img.interner, img.symbols[i].name);
            if (sel nm.some) {
                names[w] = nm.some;
                w        = w + 1;
            }
        }
        i = i + 1;
    }
    member.sym_names = names;
    member.sym_count = w;
    ret true;
}

pub fun emit_static_archive(p: *driver.Project, destination: str, images: *target_of.ObjectImage, inputs: *target_of.ObjectInput, out_path: **u8) err[outcome.Fail] {
    val len: u32 = p.emit_len;

    val archive: str = destination;

    val res_mem: res[*ar.ArMember, std_allocator.Error] = std_allocator.allocate[ar.ArMember](p.alloc, len::usize);
    if (sel res_mem.err) { ret err[outcome.Fail].err{outcome.refused(res_mem.err)}; }
    val members: *ar.ArMember = res_mem.ok;

    val res_bufs: res[*Vector[u8], std_allocator.Error] = std_allocator.allocate[Vector[u8]](p.alloc, len::usize);
    if (sel res_bufs.err) {
        free_members(p.alloc, members, len);
        ret err[outcome.Fail].err{outcome.internal("out of memory")};
    }
    val bufs: *Vector[u8] = res_bufs.ok;

    var i: u32 = 0;
    for (i < len) {
        members[i].name      = "";
        members[i].data      = nil;
        members[i].len       = 0;
        members[i].sym_names = nil;
        members[i].sym_count = 0;
        bufs[i]              = collections_vector.init[u8](p.alloc);
        i                    = i + 1;
    }

    i = 0;
    for (i < len) {
        val mid:     session.ModuleId    = p.topo[i];
        val m:       *driver.ModuleEntry = driver.module_at(p, mid::u32);
        val fqn_opt: opt[str]            = intern.lookup(?p.s.interner, m.fqn);
        if (sel fqn_opt.none) {
            free_read_bufs(p.alloc, bufs, len);
            free_members(p.alloc, members, len);
            ret err[outcome.Fail].err{outcome.internal("module FQN not interned")};
        }
        members[i].name = fqn_opt.some;

        val rr: res[Vector[u8], std_filesystem.FsError] = std_filesystem.read_bytes(p.alloc, inputs[i].path::str);
        if (sel rr.err) {
            free_read_bufs(p.alloc, bufs, len);
            free_members(p.alloc, members, len);
            ret err[outcome.Fail].err{outcome.internal("cannot read object for archive")};
        }
        bufs[i]         = rr.ok;
        members[i].data = bufs[i].data;
        members[i].len  = bufs[i].len;

        if (!collect_defined_globals(p, ?images[mid::u32], ?members[i])) {
            free_read_bufs(p.alloc, bufs, len);
            free_members(p.alloc, members, len);
            ret err[outcome.Fail].err{outcome.internal("out of memory")};
        }
        i = i + 1;
    }

    val wr: err[fail.Fail] = ar.write_archive(p.alloc, members, len, destination);
    free_read_bufs(p.alloc, bufs, len);
    free_members(p.alloc, members, len);
    if (sel wr.err) {
        ret err[outcome.Fail].err{outcome.from_fail(wr.err)};
    }
    @out_path = archive;
    ret err[outcome.Fail].ok{};
}

pub fun emit_shared_library(p: *driver.Project, destination: str, inputs: *target_of.ObjectInput, len: u32,
    dynlibs: *target_of.DynLib, dynlib_len: u32, out_path: **u8) err[outcome.Fail] {
    val solib: str = destination;

    val res_link: err[fail.Fail] = linker.link(p.s, ?p.diags, ?p.target, inputs, len, dynlibs, dynlib_len, destination, artifact_product_name(p), linker.LINK_SHARED, p.req.pie, target_of.image_options_default(p.req.subsystem));
    if (sel res_link.err) {
        ret err[outcome.Fail].err{outcome.from_fail(res_link.err)};
    }
    @out_path = solib;
    ret err[outcome.Fail].ok{};
}

pub fun link_shared_images(p: *driver.Project, images: *target_of.ObjectImage,
    ext: *target_of.ObjectInput, ext_count: u32,
    dynlibs: *target_of.DynLib, dynlib_len: u32, destination: str, out_path: **u8) err[outcome.Fail] {
    val res_ord: res[*target_of.ObjectImage, outcome.Fail] = gather_topo_images(p, images);
    if (sel res_ord.err) { ret err[outcome.Fail].err{outcome.internal("out of memory")}; }
    val ordered: *target_of.ObjectImage = res_ord.ok;

    val res_link: err[fail.Fail] = linker.link_mixed(p.s, ?p.diags, ?p.target, ordered, p.emit_len, ext, ext_count,
        dynlibs, dynlib_len, destination, artifact_product_name(p), linker.LINK_SHARED, p.req.pie,
        target_of.image_options_default(p.req.subsystem));
    std_allocator.deallocate[target_of.ObjectImage](p.alloc, ordered, p.emit_len::usize);
    if (sel res_link.err) {
        ret err[outcome.Fail].err{outcome.from_fail(res_link.err)};
    }
    @out_path = destination::*u8;
    ret err[outcome.Fail].ok{};
}

pub fun link_executable(p: *driver.Project, inputs: *target_of.ObjectInput, len: u32,
    dynlibs: *target_of.DynLib, dynlib_len: u32, destination: str,
    image_options: target_of.ImageOptions) err[outcome.Fail] {
    val res_link: err[fail.Fail] = linker.link(p.s, ?p.diags, ?p.target, inputs, len, dynlibs, dynlib_len, destination, artifact_product_name(p), linker.LINK_EXE, p.req.pie, image_options);
    if (sel res_link.err) {
        ret err[outcome.Fail].err{outcome.from_fail(res_link.err)};
    }
    ret err[outcome.Fail].ok{};
}

fun gather_topo_images(p: *driver.Project, images: *target_of.ObjectImage) res[*target_of.ObjectImage, outcome.Fail] {
    val len:     u32                                              = p.emit_len;
    val res_ord: res[*target_of.ObjectImage, std_allocator.Error] = std_allocator.allocate[target_of.ObjectImage](p.alloc, len::usize);
    if (sel res_ord.err) { ret res[*target_of.ObjectImage, outcome.Fail].err{outcome.refused(res_ord.err)}; }
    val ordered: *target_of.ObjectImage = res_ord.ok;
    var i:       u32                    = 0;
    for (i < len) {
        ordered[i] = images[(p.topo[i])::u32];
        i          = i + 1;
    }
    ret res[*target_of.ObjectImage, outcome.Fail].ok{ordered};
}

pub fun link_flat_images(p: *driver.Project, images: *target_of.ObjectImage, destination: str,
    image_options: target_of.ImageOptions) err[outcome.Fail] {
    val res_ord: res[*target_of.ObjectImage, outcome.Fail] = gather_topo_images(p, images);
    if (sel res_ord.err) { ret err[outcome.Fail].err{outcome.internal("out of memory")}; }
    val ordered: *target_of.ObjectImage = res_ord.ok;

    val res_link: err[fail.Fail] = linker.link_images(p.s, ?p.diags, ?p.target, ordered, p.emit_len, nil::*target_of.DynLib, 0, destination, artifact_product_name(p), linker.LINK_EXE, p.req.pie, image_options);
    std_allocator.deallocate[target_of.ObjectImage](p.alloc, ordered, p.emit_len::usize);
    if (sel res_link.err) {
        ret err[outcome.Fail].err{outcome.from_fail(res_link.err)};
    }
    ret err[outcome.Fail].ok{};
}

# write the artifact entry module's object to `destination`. on a finished-module
# format that object is the complete deliverable, so no other module takes part
pub fun publish_entry_module(p: *driver.Project, images: *target_of.ObjectImage, destination: str) err[outcome.Fail] {
    val fqn_r: res[intern.StrId, fail.Fail] = driver.entry_module_fqn(p, p.target_entry);
    if (sel fqn_r.err) { ret err[outcome.Fail].err{outcome.from_fail(fqn_r.err)}; }
    val entry: opt[*driver.ModuleEntry] = driver.module_by_fqn(p, fqn_r.ok);
    if (sel entry.none) { ret err[outcome.Fail].err{outcome.internal("the artifact's entry module was not loaded")}; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId = p.topo[i];
        if (driver.module_at(p, mid::u32) == entry.some) {
            val emitted: err[fail.Fail] = obj.emit_image(?images[mid::u32], ?p.target, destination);
            if (sel emitted.err) { ret err[outcome.Fail].err{outcome.from_fail(emitted.err)}; }
            ret err[outcome.Fail].ok{};
        }
        i = i + 1;
    }
    ret err[outcome.Fail].err{outcome.internal("the artifact's entry module emitted no object")};
}

pub fun link_mixed_images(p: *driver.Project, images: *target_of.ObjectImage,
    ext: *target_of.ObjectInput, ext_count: u32,
    dynlibs: *target_of.DynLib, dynlib_len: u32, destination: str,
    image_options: target_of.ImageOptions) err[outcome.Fail] {
    val res_ord: res[*target_of.ObjectImage, outcome.Fail] = gather_topo_images(p, images);
    if (sel res_ord.err) { ret err[outcome.Fail].err{outcome.internal("out of memory")}; }
    val ordered: *target_of.ObjectImage = res_ord.ok;

    val res_link: err[fail.Fail] = linker.link_mixed(p.s, ?p.diags, ?p.target, ordered, p.emit_len, ext, ext_count,
        dynlibs, dynlib_len, destination, artifact_product_name(p), linker.LINK_EXE, p.req.pie, image_options);
    std_allocator.deallocate[target_of.ObjectImage](p.alloc, ordered, p.emit_len::usize);
    if (sel res_link.err) {
        ret err[outcome.Fail].err{outcome.from_fail(res_link.err)};
    }
    ret err[outcome.Fail].ok{};
}

fun count_external_tokens(p: *driver.Project, unit: *build_plan.BuildUnit) u32 {
    var n:  u32                 = 0;
    val te: *driver.TargetEntry = p.target_entry;
    if (te != nil) { n = n + te.lib_count; }
    n = n + p.config.cascade_lib_count;
    n = n + unit.link_inputs.len::u32;
    ret n;
}

# the unit's static link inputs, each the user's (RELOC_INPUT), appended to
# `inputs` after whatever it already holds
pub fun append_external_inputs(p: *driver.Project, unit: *build_plan.BuildUnit,
    inputs: **target_of.ObjectInput, len: *u32,
    dynlibs: **target_of.DynLib, dynlib_len: *u32) err[outcome.Fail] {
    @dynlibs    = nil;
    @dynlib_len = 0;
    session.reset_link_providers(p.s);
    val extra: u32 = count_external_tokens(p, unit);
    if (extra == 0) { ret err[outcome.Fail].ok{}; }

    val base:     u32                                              = @len;
    val grown:    u32                                              = base + extra;
    val res_grow: res[*target_of.ObjectInput, std_allocator.Error] = std_allocator.reallocate[target_of.ObjectInput](p.alloc, @inputs, base::usize, grown::usize);
    if (sel res_grow.err) { ret err[outcome.Fail].err{outcome.refused(res_grow.err)}; }
    @inputs = res_grow.ok;

    var z: u32 = base;
    for (z < grown) {
        (@inputs)[z].path   = nil;
        (@inputs)[z].origin = target_of.RELOC_INPUT;
        z                   = z + 1;
    }
    @len = grown;

    var written: u32 = base;

    val te: *driver.TargetEntry = p.target_entry;
    if (te != nil) {
        var i: u32 = 0;
        for (i < te.lib_count) {
            val rc: err[outcome.Fail] = resolve_and_store_input(p, ?te.libs[i],
                @inputs, ?written, dynlibs, dynlib_len);
            if (sel rc.err) {
                shrink_inputs(p, inputs, len, written, grown);
                ret rc;
            }
            i = i + 1;
        }
    }

    var i: u32 = 0;
    for (i < p.config.cascade_lib_count) {
        val rc: err[outcome.Fail] = resolve_and_store_input(p, ?p.config.cascade_libs[i],
            @inputs, ?written, dynlibs, dynlib_len);
        if (sel rc.err) {
            shrink_inputs(p, inputs, len, written, grown);
            ret rc;
        }
        i = i + 1;
    }

    var ti: usize = 0;
    for (ti < unit.link_inputs.len) {
        val rc: err[outcome.Fail] = store_fact(p, ?unit.link_inputs.data[ti],
            @inputs, ?written, dynlibs, dynlib_len);
        if (sel rc.err) {
            shrink_inputs(p, inputs, len, written, grown);
            ret rc;
        }
        ti = ti + 1;
    }

    shrink_inputs(p, inputs, len, written, grown);
    ret err[outcome.Fail].ok{};
}

fun store_fact(p: *driver.Project, li: *build_plan.LinkInput, inputs: *target_of.ObjectInput, written: *u32,
    dynlibs: **target_of.DynLib, dynlib_len: *u32) err[outcome.Fail] {
    val pr: err[outcome.Fail] = register_link_provider(p, li);
    if (sel pr.err) { ret pr; }
    if (li.kind == build_plan.LINK_DYNAMIC) {
        ret append_dynlib(p, li, dynlibs, dynlib_len);
    }
    if (static_path_present(inputs, @written, li.text)) {
        ret err[outcome.Fail].ok{};
    }
    val dup_r: res[str, types_string.StrError] = str_copy(p.alloc, li.text::*u8);
    if (sel dup_r.err) { ret err[outcome.Fail].err{outcome.internal("out of memory")}; }
    inputs[@written].path   = dup_r.ok::*u8;
    inputs[@written].origin = target_of.RELOC_INPUT;
    @written                = @written + 1;
    ret err[outcome.Fail].ok{};
}

fun shrink_inputs(p: *driver.Project, inputs: **target_of.ObjectInput, len: *u32, written: u32, grown: u32) {
    if (written < grown) {
        val res_shrink: res[*target_of.ObjectInput, std_allocator.Error] = std_allocator.reallocate[target_of.ObjectInput](p.alloc, @inputs, grown::usize, written::usize);
        if (sel res_shrink.ok) {
            @inputs = res_shrink.ok;
            @len    = written;
            ret;
        }
    }
    @len = grown;
}

fun append_dynlib(p: *driver.Project, li: *build_plan.LinkInput,
    dynlibs: **target_of.DynLib, dynlib_len: *u32) err[outcome.Fail] {
    val res_intern: res[intern.StrId, std_allocator.Error] = intern.intern(?p.s.interner, li.text);
    if (sel res_intern.err) { ret err[outcome.Fail].err{outcome.refused(res_intern.err)}; }
    val soname: intern.StrId = res_intern.ok;
    var name:   intern.StrId = soname;
    if (!str_empty(li.library)) {
        val name_r: res[intern.StrId, std_allocator.Error] = intern.intern(?p.s.interner, li.library);
        if (sel name_r.err) {
            ret err[outcome.Fail].err{outcome.internal("out of memory")};
        }
        name = name_r.ok;
    }
    var rpath: intern.StrId = intern.STR_NIL;
    if (!str_empty(li.rpath)) {
        val rp_r: res[intern.StrId, std_allocator.Error] = intern.intern(?p.s.interner, li.rpath);
        if (sel rp_r.err) {
            ret err[outcome.Fail].err{outcome.internal("out of memory")};
        }
        rpath = rp_r.ok;
    }

    var i: u32 = 0;
    for (i < @dynlib_len) {
        if ((@dynlibs)[i].name == name) {
            if ((@dynlibs)[i].soname == soname) {
                if ((@dynlibs)[i].rpath == intern.STR_NIL) { (@dynlibs)[i].rpath = rpath; }
                ret err[outcome.Fail].ok{};
            }
            ret err[outcome.Fail].err{outcome.user(diagnostic_kind.LINK_LOADER_NAME_CONFLICT, dynlib_conflict_message(
                p, name, (@dynlibs)[i].soname, soname))};
        }
        i = i + 1;
    }

    val old:      u32                                         = @dynlib_len;
    val res_grow: res[*target_of.DynLib, std_allocator.Error] = std_allocator.reallocate[target_of.DynLib](p.alloc, @dynlibs, old::usize, (old + 1)::usize);
    if (sel res_grow.err) { ret err[outcome.Fail].err{outcome.refused(res_grow.err)}; }
    @dynlibs                           = res_grow.ok;
    (@dynlibs)[old].name               = name;
    (@dynlibs)[old].soname             = soname;
    (@dynlibs)[old].rpath              = rpath;
    (@dynlibs)[old].include_referenced = li.include_referenced;
    @dynlib_len                        = old + 1;
    ret err[outcome.Fail].ok{};
}

test append_dynlib__reinterns_the_logical_name_and_refuses_a_second_loader_name {
    var alloc:  std_allocator.Allocator;
    val make_r: err[std_allocator.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var p: driver.Project;
    p.s     = ?s;
    p.alloc = ?alloc;
    var li: build_plan.LinkInput;
    li.kind    = build_plan.LINK_DYNAMIC;
    li.text    = "libfoo.so.1";
    li.library = "foo";
    li.rpath   = "";
    var libs: *target_of.DynLib = nil;
    var len:  u32               = 0;
    fin { free_dynlibs(?alloc, libs, len); }
    val first: err[outcome.Fail] = append_dynlib(?p, ?li, ?libs, ?len);
    if (sel first.err) { ret 2; }
    val again: err[outcome.Fail] = append_dynlib(?p, ?li, ?libs, ?len);
    if (sel again.err || len != 1) { ret 3; }
    val name:   opt[str] = intern.lookup(?s.interner, libs[0].name);
    val loader: opt[str] = intern.lookup(?s.interner, libs[0].soname);
    if (sel name.none)                           { ret 4; }
    if (sel loader.none)                         { ret 4; }
    if (!str_equals(name.some, "foo"))           { ret 4; }
    if (!str_equals(loader.some, "libfoo.so.1")) { ret 4; }
    li.text = "libfoo.so.2";
    val conflict: err[outcome.Fail] = append_dynlib(?p, ?li, ?libs, ?len);
    if (sel conflict.ok || len != 1) { ret 5; }
    ret 0;
}

fun dynlib_conflict_message(p: *driver.Project, name: intern.StrId,
    first: intern.StrId, second: intern.StrId) str {
    val n: opt[str] = intern.lookup(?p.s.interner, name);
    val a: opt[str] = intern.lookup(?p.s.interner, first);
    val b: opt[str] = intern.lookup(?p.s.interner, second);
    if (sel n.none) {
        ret "one logical link library resolves to multiple loader names";
    }
    if (sel a.none) {
        ret "one logical link library resolves to multiple loader names";
    }
    if (sel b.none) {
        ret "one logical link library resolves to multiple loader names";
    }
    val r: res[str, types_string.StrError] = str_join(p.alloc,
        "link library '", n.some, "' resolves to both '",
        a.some, "' and '", b.some, "'");
    if (sel r.err) { ret outcome.str_text(r.err); }
    ret r.ok;
}

pub fun free_dynlibs(a: *std_allocator.Allocator, dynlibs: *target_of.DynLib, dynlib_len: u32) {
    if (dynlibs != nil && dynlib_len > 0) {
        std_allocator.deallocate[target_of.DynLib](a, dynlibs, dynlib_len::usize);
    }
}

fun resolve_and_store_input(p: *driver.Project, req: *manifest.LinkRequirement,
    inputs: *target_of.ObjectInput, written: *u32,
    dynlibs: **target_of.DynLib, dynlib_len: *u32) err[outcome.Fail] {
    val lr: res[build_plan.LinkInput, outcome.Fail] = build_plan.resolve_requirement(p.alloc, ?p.s.interner, ?p.target,
        ?p.req.lib_dirs, p.req.project_root, req);
    if (sel lr.err) {
        ret err[outcome.Fail].err{lr.err};
    }
    val li: build_plan.LinkInput = lr.ok;
    val pr: err[outcome.Fail]    = register_link_provider(p, ?li);
    if (sel pr.err) { ret pr; }
    if (li.kind == build_plan.LINK_DYNAMIC) {
        val cr: err[outcome.Fail] = register_link_claims(p, req);
        if (sel cr.err) { ret cr; }
        ret append_dynlib(p, ?li, dynlibs, dynlib_len);
    }
    if (req.symbol_count > 0) {
        ret err[outcome.Fail].err{outcome.user(diagnostic_kind.LINK_STATIC_CLAIMS_SYMBOLS, static_claim_message(p, req))};
    }
    if (static_path_present(inputs, @written, li.text)) {
        std_allocator.deallocate[u8](p.alloc, li.text::*u8, str_len(li.text) + 1);
        ret err[outcome.Fail].ok{};
    }
    inputs[@written].path   = li.text::*u8;
    inputs[@written].origin = target_of.RELOC_INPUT;
    @written                = @written + 1;
    ret err[outcome.Fail].ok{};
}

fun register_link_provider(p: *driver.Project, li: *build_plan.LinkInput) err[outcome.Fail] {
    if (str_empty(li.library)) { ret err[outcome.Fail].ok{}; }
    val nr: res[intern.StrId, std_allocator.Error] = intern.intern(?p.s.interner, li.library);
    if (sel nr.err) {
        ret err[outcome.Fail].err{outcome.internal("out of memory")};
    }
    val rr: err[fail.Fail] = session.register_link_provider(
        p.s, nr.ok, li.kind == build_plan.LINK_STATIC);
    if (sel rr.err) {
        ret err[outcome.Fail].err{outcome.internal("out of memory")};
    }
    ret err[outcome.Fail].ok{};
}

fun register_link_claims(p: *driver.Project, req: *manifest.LinkRequirement) err[outcome.Fail] {
    var i: u32 = 0;
    for (i < req.symbol_count) {
        val ln: res[intern.StrId, fail.Fail] = driver.link_name_for(p, req.symbols[i]);
        if (sel ln.err) {
            ret err[outcome.Fail].err{outcome.from_fail(ln.err)};
        }
        val sym:  intern.StrId      = ln.ok;
        val prev: opt[intern.StrId] = session.import_library(p.s, sym);
        if (sel prev.some) {
            val had: intern.StrId = prev.some;
            if (had != req.library) {
                ret err[outcome.Fail].err{outcome.user(diagnostic_kind.LINK_SYMBOL_CLAIM_CONFLICT,
                    claim_conflict_message(p, sym, had, req.library))};
            }
            i = i + 1;
            cnt;
        }
        val register_import_library_r: err[fail.Fail] = session.register_import_library(p.s, sym, req.library);
        if (sel register_import_library_r.err) {
            ret err[outcome.Fail].err{outcome.internal("out of memory")};
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

test register_link_claims__pins_and_rejects_conflicts {
    var alloc:  std_allocator.Allocator;
    val make_r: err[std_allocator.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var reg: lang_target.TargetRegistry = lang_target.registry_init();
    fin { lang_target.registry_dnit(?reg); }
    val register_all_r: err[fail.Fail] = lang_target.register_all(?reg, target_testing.debug_descriptor);
    if (sel register_all_r.err) { ret 1; }

    var p: driver.Project;
    p.s     = ?s;
    p.alloc = ?alloc;

    val sym_r: res[intern.StrId, std_allocator.Error] = intern.intern(?s.interner, "Sleep");
    val pre_r: res[intern.StrId, std_allocator.Error] = intern.intern(?s.interner, "_Sleep");
    val k32_r: res[intern.StrId, std_allocator.Error] = intern.intern(?s.interner, "kernel32");
    val u32_r: res[intern.StrId, std_allocator.Error] = intern.intern(?s.interner, "user32");
    if (sel sym_r.err) { ret 1; }
    if (sel pre_r.err) { ret 1; }
    if (sel k32_r.err) { ret 1; }
    if (sel u32_r.err) { ret 1; }
    var syms: [1]intern.StrId;
    syms[0] = sym_r.ok;

    var req: manifest.LinkRequirement;
    req.source       = manifest.LINK_SYSTEM;
    req.text         = k32_r.ok;
    req.library      = k32_r.ok;
    req.symbols      = ?syms[0];
    req.symbol_count = 1;

    var code: i32 = 0;

    val lr: res[lang_target.Target, fail.Fail] = lang_target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel lr.err) { ret 1; }
    p.target = lr.ok;

    val register_link_claims_r: err[outcome.Fail] = register_link_claims(?p, ?req);
    if (sel register_link_claims_r.err) { code = 1; }
    val got: opt[intern.StrId] = session.import_library(?s, syms[0]);
    if (!(sel got.some && got.some == req.library)) { code = 1; }

    val register_link_claims_r2: err[outcome.Fail] = register_link_claims(?p, ?req);
    if (sel register_link_claims_r2.err) { code = 1; }

    var other: manifest.LinkRequirement = req;
    other.library = u32_r.ok;
    val register_link_claims_r3: err[outcome.Fail] = register_link_claims(?p, ?other);
    if (sel register_link_claims_r3.ok) { code = 1; }

    session.reset_module_registry(?s);
    val dr: res[lang_target.Target, fail.Fail] = lang_target.select(?reg, "x86_64", "darwin", "sysv64");
    if (sel dr.err) { ret 1; }
    p.target = dr.ok;

    val register_link_claims_r4: err[outcome.Fail] = register_link_claims(?p, ?req);
    if (sel register_link_claims_r4.err) { code = 1; }
    val dgot: opt[intern.StrId] = session.import_library(?s, pre_r.ok);
    if (!(sel dgot.some && dgot.some == req.library)) { code = 1; }
    val import_library_r: opt[intern.StrId] = session.import_library(?s, syms[0]);
    if (sel import_library_r.some) { code = 1; }

    val register_link_claims_r5: err[outcome.Fail] = register_link_claims(?p, ?other);
    if (sel register_link_claims_r5.ok) { code = 1; }

    ret code;
}

fun claim_conflict_message(p: *driver.Project, sym: intern.StrId,
    first: intern.StrId, second: intern.StrId) str {
    val n: opt[str] = intern.lookup(?p.s.interner, sym);
    val a: opt[str] = intern.lookup(?p.s.interner, first);
    val b: opt[str] = intern.lookup(?p.s.interner, second);
    if (sel n.none) {
        ret "one symbol is claimed by two link libraries";
    }
    if (sel a.none) {
        ret "one symbol is claimed by two link libraries";
    }
    if (sel b.none) {
        ret "one symbol is claimed by two link libraries";
    }
    val r: res[str, types_string.StrError] = str_join(p.alloc,
        "symbol '", n.some, "' is claimed by link library '",
        a.some, "' and '", b.some,
        "'; a symbol may name only one providing library");
    if (sel r.err) { ret outcome.str_text(r.err); }
    ret r.ok;
}

fun static_claim_message(p: *driver.Project, req: *manifest.LinkRequirement) str {
    val t: opt[str] = intern.lookup(?p.s.interner, req.text);
    if (sel t.none) {
        ret "a link entry that resolves to a static input cannot claim symbols";
    }
    val r: res[str, types_string.StrError] = str_join(p.alloc,
        "link entry '", t.some,
        "' resolves to a static input, which defines symbols rather than importing them; ",
        "remove its 'symbols' key");
    if (sel r.err) { ret outcome.str_text(r.err); }
    ret r.ok;
}

fun static_path_present(inputs: *target_of.ObjectInput, written: u32, candidate: str) bool {
    var i: u32 = 0;
    for (i < written) {
        if (inputs[i].path != nil && str_equals(inputs[i].path::str, candidate)) { ret true; }
        i = i + 1;
    }
    ret false;
}

rec ObjectWrite {
    image:  *target_of.ObjectImage;
    target: *lang_target.Target;
}

fun write_object(w: *ObjectWrite, destination: str) err[fail.Fail] {
    ret obj.emit_image(w.image, w.target, destination);
}

# every module's object reaches `obj/` through a sibling temporary, since the
# object cache reads it back; a module the cache restored is already there
pub fun write_objects(p: *driver.Project, images: *target_of.ObjectImage,
    destinations: *str, inputs_out: **target_of.ObjectInput) err[outcome.Fail] {
    val len: u32 = p.emit_len;
    if (len == 0) {
        @inputs_out = nil;
        ret err[outcome.Fail].ok{};
    }
    val res_inputs: res[*target_of.ObjectInput, std_allocator.Error] = std_allocator.allocate[target_of.ObjectInput](p.alloc, len::usize);
    if (sel res_inputs.err) { ret err[outcome.Fail].err{outcome.refused(res_inputs.err)}; }
    val inputs: *target_of.ObjectInput = res_inputs.ok;
    var i:      u32                    = 0;
    for (i < len) {
        val mid:         session.ModuleId              = p.topo[i];
        val m:           *driver.ModuleEntry           = driver.module_at(p, mid::u32);
        val destination: str                           = destinations[i];
        val copied:      res[str, std_allocator.Error] = str_dup(p.alloc, destination);
        if (sel copied.err) {
            free_inputs(p.alloc, inputs, i, len);
            ret err[outcome.Fail].err{outcome.refused(copied.err)};
        }
        # an object this build wrote: mach produced its bytes
        inputs[i].path   = copied.ok::*u8;
        inputs[i].origin = target_of.RELOC_CODEGEN;
        if (cache.restored(p, m)) {
            i = i + 1;
            cnt;
        }
        val t_item:  readout.Instant   = readout.item_begin(p.events);
        var write:   ObjectWrite       = ObjectWrite{image: ?images[mid::u32], target: ?p.target};
        val emitted: err[outcome.Fail] = output.through_temporary[ObjectWrite](p.alloc, destination, ?write, write_object);
        if (sel emitted.err) {
            free_inputs(p.alloc, inputs, i + 1, len);
            ret emitted;
        }
        readout.item(p.events, readout.PH_EMIT, driver.fqn_name(p, m.fqn), t_item);
        i = i + 1;
    }
    @inputs_out = inputs;
    ret err[outcome.Fail].ok{};
}

# each test object reaches `obj/` beside its module's object, the same way
# ---
# destinations: per emitted module, its test object's path, nil for a module without one
pub fun write_test_objects(p: *driver.Project, destinations: *str) err[outcome.Fail] {
    if (destinations == nil) { ret err[outcome.Fail].ok{}; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *driver.ModuleEntry = driver.module_at(p, p.topo[i]::u32);
        if (destinations[i] == nil || cache.test_restored(p, m)) {
            i = i + 1;
            cnt;
        }
        if (m.test.object_image == nil) { ret err[outcome.Fail].err{outcome.internal("a test object was not generated")}; }
        val t_item:  readout.Instant   = readout.item_begin(p.events);
        var write:   ObjectWrite       = ObjectWrite{image: m.test.object_image, target: ?p.target};
        val emitted: err[outcome.Fail] = output.through_temporary[ObjectWrite](p.alloc, destinations[i], ?write, write_object);
        if (sel emitted.err) { ret emitted; }
        readout.item(p.events, readout.PH_EMIT, destinations[i], t_item);
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

pub fun free_inputs(a: *std_allocator.Allocator, inputs: *target_of.ObjectInput, n: u32, cap: u32) {
    if (inputs == nil) { ret; }
    var i: u32 = 0;
    for (i < n) {
        if (inputs[i].path != nil) { std_allocator.deallocate[u8](a, inputs[i].path, (str_len(inputs[i].path::str) + 1)::usize); }
        i = i + 1;
    }
    if (cap > 0) { std_allocator.deallocate[target_of.ObjectInput](a, inputs, cap::usize); }
}
