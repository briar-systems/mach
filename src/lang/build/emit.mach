pub fun artifact_product_name(p: *project.Project) *u8 {
    val nm: opt[str] = intern.get(?p.s.interner, p.config.bin_name);
    if (sel nm.some) { ret nm.some::*u8; }
    ret ""::*u8;
}

# the resources an executable declares: its icon and manifest, read, with the
# version and names an image's version resource states
pub rec LoadedImageOptions {
    declared:          bool;
    icon_bytes:        Vector[u8];
    manifest_bytes:    Vector[u8];
    icon_path:         str;
    manifest_path:     str;
    version:           str;
    internal_name:     str;
    original_filename: str;
    product_name:      str;
}

# release loaded image options; nil options own nothing
pub fun dnit_image_options(a: *A.Allocator, loaded: *LoadedImageOptions) {
    if (loaded == nil) { ret; }
    collections_vector.dnit[u8](?loaded.icon_bytes);
    collections_vector.dnit[u8](?loaded.manifest_bytes);
    if (loaded.icon_path != nil)     { str_free(a, loaded.icon_path); }
    if (loaded.manifest_path != nil) { str_free(a, loaded.manifest_path); }
}

# the resources an executable declares, read where the target's images state a
# subsystem, as mink's host of it names; an image of another host carries none
pub fun load_image_options(p: *project.Project, out_kind: *Product,
    exe_path: *u8) res[LoadedImageOptions, fail.Fail] {
    var loaded: LoadedImageOptions;
    var handed: bool = false;
    loaded.declared          = false;
    loaded.icon_bytes        = collections_vector.init[u8](p.alloc);
    loaded.manifest_bytes    = collections_vector.init[u8](p.alloc);
    loaded.icon_path         = nil;
    loaded.manifest_path     = nil;
    loaded.version           = "";
    loaded.internal_name     = "";
    loaded.original_filename = "";
    loaded.product_name      = "";
    fin {
        if (!handed) { dnit_image_options(p.alloc, ?loaded); }
    }

    if (!lang_target.is_executable(out_kind) || !lang_target.states_subsystem(?p.target)) {
        handed = true;
        ret res[LoadedImageOptions, fail.Fail].ok{loaded};
    }
    if (intern.str_is_nil(p.config.icon) && intern.str_is_nil(p.config.app_manifest)) {
        handed = true;
        ret res[LoadedImageOptions, fail.Fail].ok{loaded};
    }

    val root_o: opt[str] = intern.get(?p.s.interner, p.config.project_root);
    val ver_o:  opt[str] = intern.get(?p.s.interner, p.config.version);
    val name_o: opt[str] = intern.get(?p.s.interner, p.config.bin_name);
    if (sel root_o.none) { ret res[LoadedImageOptions, fail.Fail].err{fail.message("resource metadata is not interned")}; }
    if (sel ver_o.none)  { ret res[LoadedImageOptions, fail.Fail].err{fail.message("resource metadata is not interned")}; }
    if (sel name_o.none) { ret res[LoadedImageOptions, fail.Fail].err{fail.message("resource metadata is not interned")}; }

    val icon: err[fail.Fail] = declared_resource_read(p, root_o.some, p.config.icon, "icon", ?loaded.icon_path, ?loaded.icon_bytes);
    if (sel icon.err) { ret res[LoadedImageOptions, fail.Fail].err{icon.err}; }
    val manifest_read: err[fail.Fail] = declared_resource_read(p, root_o.some, p.config.app_manifest, "manifest",
        ?loaded.manifest_path, ?loaded.manifest_bytes);
    if (sel manifest_read.err) { ret res[LoadedImageOptions, fail.Fail].err{manifest_read.err}; }

    loaded.declared          = true;
    loaded.version           = ver_o.some;
    loaded.internal_name     = name_o.some;
    loaded.original_filename = types_path.filename(exe_path::str);
    loaded.product_name      = name_o.some;
    handed                   = true;
    ret res[LoadedImageOptions, fail.Fail].ok{loaded};
}

# reads the artifact resource `rel` declares, relative to the project root,
# into `bytes`, recording its path; nothing when it declares none. `noun` names
# the resource in a refusal
fun declared_resource_read(p: *project.Project, root: str, rel: intern.StrId, noun: str,
    path: *str, bytes: *Vector[u8]) err[fail.Fail] {
    if (intern.str_is_nil(rel)) { ret err[fail.Fail].ok{}; }
    val rel_o: opt[str] = intern.get(?p.s.interner, rel);
    if (sel rel_o.none) { ret err[fail.Fail].err{fail.message_of(fail.join(p.alloc, "artifact ", noun, " path is not interned"))}; }
    val pr: res[str, A.Error] = types_path.join(p.alloc, root, rel_o.some);
    if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
    @path = pr.ok;
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(p.alloc, @path);
    if (sel rr.err) {
        ret err[fail.Fail].err{fail.user_of(diagnostic_kind.ARTIFACT_RESOURCE_UNREADABLE, fail.join(p.alloc,
            "cannot read artifact ", noun, " '", rel_o.some, "' (", @path, "): ", fail.fs_text(rr.err)))};
    }
    collections_vector.dnit[u8](bytes);
    @bytes = rr.ok;
    if (bytes.len == 0) {
        ret err[fail.Fail].err{fail.user_of(diagnostic_kind.ARTIFACT_RESOURCE_EMPTY, fail.join(p.alloc,
            "artifact ", noun, " '", rel_o.some, "' is empty"))};
    }
    ret err[fail.Fail].ok{};
}

fun free_read_bufs(alloc: *A.Allocator, bufs: *Vector[u8], cap: u32) {
    var i: u32 = 0;
    for (i < cap) {
        collections_vector.dnit[u8](?bufs[i]);
        i = i + 1;
    }
    A.deallocate[Vector[u8]](alloc, bufs, cap::usize);
}

# the archive of the emitted modules' objects, read back from `inputs`, as mink's
# archive writer lays one out in the variant its registry states for the target's
# format, its index naming each member's exported symbols
pub fun emit_static_archive(p: *project.Project, destination: str, objects: **Object, inputs: *contract.Input, out_path: **u8) err[fail.Fail] {
    val len:     u32                              = p.emit_len;
    val variant: res[*mink_ar.Variant, fail.Fail] = backend.archive_variant(?p.back, p.alloc);
    if (sel variant.err) { ret err[fail.Fail].err{variant.err}; }

    val res_src: res[*mink_ar.Source, A.Error] = A.allocate[mink_ar.Source](p.alloc, len::usize + 1);
    if (sel res_src.err) { ret err[fail.Fail].err{fail.refused(res_src.err)}; }
    val sources: *mink_ar.Source = res_src.ok;
    fin { A.deallocate[mink_ar.Source](p.alloc, sources, len::usize + 1); }

    val res_bufs: res[*Vector[u8], A.Error] = A.allocate[Vector[u8]](p.alloc, len::usize);
    if (sel res_bufs.err) { ret err[fail.Fail].err{fail.refused(res_bufs.err)}; }
    val bufs: *Vector[u8] = res_bufs.ok;
    fin { free_read_bufs(p.alloc, bufs, len); }

    var i: u32 = 0;
    for (i < len) {
        bufs[i] = collections_vector.init[u8](p.alloc);
        i       = i + 1;
    }

    i = 0;
    for (i < len) {
        val mid:     session.ModuleId     = p.topo[i];
        val m:       *project.ModuleEntry = project.module_at(p, mid::u32);
        val fqn_opt: opt[str]             = intern.get(?p.s.interner, m.fqn);
        if (sel fqn_opt.none) { ret err[fail.Fail].err{fail.message("module FQN not interned")}; }

        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(p.alloc, inputs[i].file);
        if (sel rr.err) { ret err[fail.Fail].err{fail.message("cannot read object for archive")}; }
        bufs[i]    = rr.ok;
        sources[i] = mink_ar.Source{
            name:   Bytes{data: fqn_opt.some::*u8, len: str_len(fqn_opt.some)}, data: Bytes{data: bufs[i].data, len: bufs[i].len},
            object: objects[mid::u32], names: nil, count: 0
        };
        i = i + 1;
    }

    val written: res[Sink, mink_fail.Fail] = mink_ar.build(p.alloc, variant.ok, sources, len::usize);
    if (sel written.err) { ret err[fail.Fail].err{backend.refused_by_mink(p.alloc, "the archive could not be written", written.err)}; }
    var bytes: Sink = written.ok;
    fin { val freed: err[mink_fail.Fail] = sink.release(?bytes); }
    var img: Image          = Image{data: sink.data(?bytes), len: sink.len(?bytes)};
    val wr:  err[fail.Fail] = output.through_temporary[Image](p.alloc, destination, ?img, write_image);
    if (sel wr.err) { ret wr; }
    @out_path = destination::*u8;
    ret err[fail.Fail].ok{};
}

rec Image {
    data: *u8;
    len:  usize;
}

# the name the link gives the resource file mach writes of an executable's resources
val RESOURCE_INPUT: str = "the artifact's resources";

# the resource file of the resources `image` declares, owned by the caller
fun resource_file(p: *project.Project, image: *LoadedImageOptions) res[Sink, fail.Fail] {
    var d: build_resource.Declared = build_resource.Declared{
        icon:              nil,
        icon_len:          0,
        manifest:          nil,
        manifest_len:      0,
        version:           image.version,
        internal_name:     image.internal_name,
        original_filename: image.original_filename,
        product_name:      image.product_name
    };
    if (image.icon_path != nil) {
        d.icon     = image.icon_bytes.data;
        d.icon_len = image.icon_bytes.len;
    }
    if (image.manifest_path != nil) {
        d.manifest     = image.manifest_bytes.data;
        d.manifest_len = image.manifest_bytes.len;
    }
    ret build_resource.file_of(p.alloc, ?d);
}

fun write_image(img: *Image, path: str) err[fail.Fail] {
    val wrote: err[fs.FsError] = fs.write_bytes(path, img.data, img.len, 0o755);
    if (sel wrote.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.FS_WRITE, fail.fs_text(wrote.err))}; }
    ret err[fail.Fail].ok{};
}

# the layout the artifact states and the placements its objects carry, handed to mink as one
# link plan: its section order, size ceiling and regions, and an offset for each section a
# global's `#[at]` places, read from the section's name, kept by the link whether referenced
# or not. the layout names only the output sections the link lays some object's section into,
# as mink's layout rules name them, since one artifact's layout serves whatever program it links
rec PlanHeld {
    plan:     backend.Plan;
    present:  Vector[str];
    keep:     Vector[str];
    sections: Vector[str];
    regions:  Vector[Area];
    runs:     Vector[Within];
    loads:    Vector[Within];
    offsets:  Vector[Offset];
}

fun plan_init(a: *A.Allocator) PlanHeld {
    var h: PlanHeld;
    h.present  = collections_vector.init[str](a);
    h.keep     = collections_vector.init[str](a);
    h.sections = collections_vector.init[str](a);
    h.regions  = collections_vector.init[Area](a);
    h.runs     = collections_vector.init[Within](a);
    h.loads    = collections_vector.init[Within](a);
    h.offsets  = collections_vector.init[Offset](a);
    h.plan     = backend.Plan{keep: nil, keep_count: 0, sections: nil, section_count: 0, regions: nil, region_count: 0, runs: nil, run_count: 0,
        loads: nil, load_count: 0, offsets: nil, offset_count: 0, size: opt[u64].none{}};
    ret h;
}

fun plan_dnit(h: *PlanHeld) {
    collections_vector.dnit[str](?h.present);
    collections_vector.dnit[str](?h.keep);
    collections_vector.dnit[str](?h.sections);
    collections_vector.dnit[Area](?h.regions);
    collections_vector.dnit[Within](?h.runs);
    collections_vector.dnit[Within](?h.loads);
    collections_vector.dnit[Offset](?h.offsets);
}

# the plan of the artifact and its `count` objects at `objects` into `h`, whether it states
# anything at all
fun plan_of(p: *project.Project, inputs: *Given, count: u32, h: *PlanHeld) res[bool, fail.Fail] {
    var names: Vector[View] = collections_vector.init[View](p.alloc);
    fin { collections_vector.dnit[View](?names); }
    var symbols: Vector[View] = collections_vector.init[View](p.alloc);
    fin { collections_vector.dnit[View](?symbols); }
    val made: res[backend.Laying, fail.Fail] = backend.laying(?p.back, p.alloc);
    if (sel made.err) { ret res[bool, fail.Fail].err{made.err}; }
    var laying: backend.Laying = made.ok;
    fin { backend.laying_release(?laying); }
    var o: u32 = 0;
    for (o < count) {
        names.len = 0;
        val listed: err[fail.Fail] = backend.section_names(inputs[o].object, ?names);
        if (sel listed.err) { ret res[bool, fail.Fail].err{listed.err}; }
        var k: usize = 0;
        for (k < names.len) {
            val view: View = names.data[k];
            k = k + 1;
            val held: res[intern.StrId, A.Error] = intern.range_add(?p.s.interner, view.data::str, 0, view.len);
            if (sel held.err) { ret res[bool, fail.Fail].err{fail.refused(held.err)}; }
            val name:  str  = intern.text(?p.s.interner, held.ok);
            val first: bool = !plan_holds(h, name);
            if (first) {
                val kept: res[usize, A.Error] = collections_vector.push[str](?h.present, name);
                if (sel kept.err) { ret res[bool, fail.Fail].err{fail.refused(kept.err)}; }
            }
            val at: opt[u64] = placement.offset_of(view);
            if (sel at.none) { cnt; }
            if (!first) {
                ret res[bool, fail.Fail].err{fail.formatted_user(p.alloc, diagnostic_kind.LINK_SECTION_UNSUPPORTED,
                    "two globals are placed at offset {} of the image, and one offset holds one global", at.some)};
            }
            val pushed: res[usize, A.Error] = collections_vector.push[Offset](?h.offsets, Offset{section: name, offset: at.some});
            if (sel pushed.err) { ret res[bool, fail.Fail].err{fail.refused(pushed.err)}; }
            symbols.len = 0;
            val placed: err[fail.Fail] = backend.symbols_in(inputs[o].object, view, ?symbols);
            if (sel placed.err) { ret res[bool, fail.Fail].err{placed.err}; }
            var y: usize = 0;
            for (y < symbols.len) {
                val sym: res[intern.StrId, A.Error] = intern.range_add(?p.s.interner, symbols.data[y].data::str, 0, symbols.data[y].len);
                y = y + 1;
                if (sel sym.err) { ret res[bool, fail.Fail].err{fail.refused(sym.err)}; }
                val kept: res[usize, A.Error] = collections_vector.push[str](?h.keep, intern.text(?p.s.interner, sym.ok));
                if (sel kept.err) { ret res[bool, fail.Fail].err{fail.refused(kept.err)}; }
            }
        }
        # after its own names, so a placed section's name is first seen as its own
        val laid: err[fail.Fail] = plan_laid(p, ?laying, inputs[o].object, h);
        if (sel laid.err) { ret res[bool, fail.Fail].err{laid.err}; }
        o = o + 1;
    }
    val art: *manifest.ArtifactDef = p.config.artifact;
    if (art != nil) {
        var i: u32 = 0;
        for (i < art.section_count) {
            val name: str = intern.text(?p.s.interner, art.sections[i]);
            i = i + 1;
            if (!plan_holds(h, name)) { cnt; }
            val pushed: res[usize, A.Error] = collections_vector.push[str](?h.sections, name);
            if (sel pushed.err) { ret res[bool, fail.Fail].err{fail.refused(pushed.err)}; }
        }
        h.plan.size = art.size;
        i           = 0;
        for (i < art.region_count) {
            val r:      *manifest.RegionDef = ?art.regions[i];
            val pushed: res[usize, A.Error] = collections_vector.push[Area](?h.regions, Area{name: intern.text(?p.s.interner, r.name), origin: r.origin, length: r.length, access: r.access});
            if (sel pushed.err) { ret res[bool, fail.Fail].err{fail.refused(pushed.err)}; }
            var k: u32 = 0;
            for (k < r.run_count) {
                val name: str = intern.text(?p.s.interner, r.run[k]);
                k = k + 1;
                if (!plan_holds(h, name)) { cnt; }
                val run: res[usize, A.Error] = collections_vector.push[Within](?h.runs, Within{section: name, region: i::usize});
                if (sel run.err) { ret res[bool, fail.Fail].err{fail.refused(run.err)}; }
            }
            k = 0;
            for (k < r.load_count) {
                val name: str = intern.text(?p.s.interner, r.load[k]);
                k = k + 1;
                if (!plan_holds(h, name)) { cnt; }
                val load: res[usize, A.Error] = collections_vector.push[Within](?h.loads, Within{section: name, region: i::usize});
                if (sel load.err) { ret res[bool, fail.Fail].err{fail.refused(load.err)}; }
            }
            i = i + 1;
        }
    }
    h.plan.keep          = h.keep.data;
    h.plan.keep_count    = h.keep.len;
    h.plan.sections      = h.sections.data;
    h.plan.section_count = h.sections.len;
    h.plan.regions       = h.regions.data;
    h.plan.region_count  = h.regions.len;
    h.plan.runs          = h.runs.data;
    h.plan.run_count     = h.runs.len;
    h.plan.loads         = h.loads.data;
    h.plan.load_count    = h.loads.len;
    h.plan.offsets       = h.offsets.data;
    h.plan.offset_count  = h.offsets.len;
    ret res[bool, fail.Fail].ok{h.sections.len + h.regions.len + h.offsets.len > 0 || sel h.plan.size.some};
}

# the output sections the link lays the sections of `o` into, added to what `h` holds
fun plan_laid(p: *project.Project, laying: *backend.Laying, o: *Object, h: *PlanHeld) err[fail.Fail] {
    var i: usize = 0;
    for (i < backend.section_count(o)) {
        val laid: res[View, fail.Fail] = backend.laid_name(p.alloc, laying, o, i);
        i = i + 1;
        if (sel laid.err) { ret err[fail.Fail].err{laid.err}; }
        val held: res[intern.StrId, A.Error] = intern.range_add(?p.s.interner, laid.ok.data::str, 0, laid.ok.len);
        if (sel held.err) { ret err[fail.Fail].err{fail.refused(held.err)}; }
        val name: str = intern.text(?p.s.interner, held.ok);
        if (plan_holds(h, name)) { cnt; }
        val kept: res[usize, A.Error] = collections_vector.push[str](?h.present, name);
        if (sel kept.err) { ret err[fail.Fail].err{fail.refused(kept.err)}; }
    }
    ret err[fail.Fail].ok{};
}

# whether some object of the link holds the section `name`
fun plan_holds(h: *PlanHeld, name: str) bool {
    var i: usize = 0;
    for (i < h.present.len) {
        if (str_equals(h.present.data[i], name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the image of `kind` mink links in memory from the `count` objects at `inputs`, in link order,
# then the `link_count` inputs at `links`, written to `destination` with the resources
# `image` declares, laid out as the artifact and its placed globals state, what the link tells of
# itself reported to `diags`
pub fun link_image(p: *project.Project, diags: *diagnostic.DiagnosticStore, kind: *mink_output.Kind, inputs: *Given, count: u32,
    links: *input.Input, link_count: u32, destination: str, image: *LoadedImageOptions) err[fail.Fail] {
    if (count == 0) { ret err[fail.Fail].err{fail.message("a link requires an object")}; }

    var resources: opt[Sink] = opt[Sink].none{};
    fin {
        if (sel resources.some) { val freed: err[mink_fail.Fail] = sink.release(?resources.some); }
    }
    if (image != nil && image.declared) {
        val made_res: res[Sink, fail.Fail] = resource_file(p, image);
        if (sel made_res.err) { ret err[fail.Fail].err{made_res.err}; }
        resources = opt[Sink].some{made_res.ok};
    }
    var carried: usize = 0;
    if (sel resources.some) { carried = 1; }
    val stated: res[opt[Object], fail.Fail] = image_stack(p, inputs, count);
    if (sel stated.err) { ret err[fail.Fail].err{stated.err}; }
    var stack: opt[Object] = stated.ok;
    fin {
        if (sel stack.some) { backend.release_object(?stack.some); }
    }
    var stacked: usize = 0;
    if (sel stack.some) { stacked = 1; }

    val total: usize                  = count::usize + link_count::usize + stacked + carried;
    val made:  res[*Request, A.Error] = A.allocate[Request](p.alloc, total);
    if (sel made.err) { ret err[fail.Fail].err{fail.refused(made.err)}; }
    val requests: *Request = made.ok;
    fin { A.deallocate[Request](p.alloc, requests, total); }
    var i: u32 = 0;
    for (i < count) {
        requests[i] = Request.source{Source.object{inputs[i]}};
        i           = i + 1;
    }
    i = 0;
    for (i < link_count) {
        requests[count + i] = link_request(?links[i]);
        i                   = i + 1;
    }
    if (sel stack.some) {
        requests[count::usize + link_count::usize] = Request.source{Source.object{Given{name: STACK_INPUT, object: ?stack.some}}};
    }
    if (sel resources.some) {
        requests[count::usize + link_count::usize + stacked] = Request.source{Source.bytes{contract.Input{file: RESOURCE_INPUT, data: sink.data(?resources.some), len: sink.len(?resources.some)}}};
    }
    # a library named by name is searched for in the `-L` directories, then the working
    # directory, then the system's
    val dir_count: usize              = p.req.lib_dirs.len + 1;
    val dirs_r:    res[*str, A.Error] = A.allocate[str](p.alloc, dir_count);
    if (sel dirs_r.err) { ret err[fail.Fail].err{fail.refused(dirs_r.err)}; }
    val dirs: *str = dirs_r.ok;
    fin { A.deallocate[str](p.alloc, dirs, dir_count); }
    var d: usize = 0;
    for (d < p.req.lib_dirs.len) {
        dirs[d] = p.req.lib_dirs.data[d];
        d       = d + 1;
    }
    dirs[d] = ".";
    var held_plan: PlanHeld = plan_init(p.alloc);
    fin { plan_dnit(?held_plan); }
    if (sel stack.some) {
        val held: res[usize, A.Error] = collections_vector.push[str](?held_plan.present, backend.STACK_SECTION);
        if (sel held.err) { ret err[fail.Fail].err{fail.refused(held.err)}; }
    }
    val planned: res[bool, fail.Fail] = plan_of(p, inputs, count, ?held_plan);
    if (sel planned.err) { ret err[fail.Fail].err{planned.err}; }
    var placed: backend.Image = backend.Image{
        base:          opt[u64].none{},
        subsystem:     p.req.subsystem,
        libdirs:       dirs,
        libdir_count:  dir_count,
        stack_reserve: opt[u64].none{},
        stack_commit:  opt[u64].none{},
        plan:          nil
    };
    if (planned.ok)         { placed.plan = ?held_plan.plan; }
    if (p.target.base != 0) { placed.base = opt[u64].some{p.target.base}; }
    if (!backend.lays_stack(?p.target)) {
        if (p.target.stack_reserve != 0) { placed.stack_reserve = opt[u64].some{p.target.stack_reserve}; }
        if (p.target.stack_commit != 0)  { placed.stack_commit = opt[u64].some{p.target.stack_commit}; }
    }
    val linked: res[Sink, fail.Fail] = backend.link(?p.back, p.alloc, diags, kind, p.back.format, requests, total, destination, true, ?placed);
    if (sel linked.err) { ret err[fail.Fail].err{linked.err}; }
    var bytes: Sink = linked.ok;
    fin { val freed: err[mink_fail.Fail] = sink.release(?bytes); }
    var img: Image = Image{data: sink.data(?bytes), len: sink.len(?bytes)};
    ret output.through_temporary[Image](p.alloc, destination, ?img, write_image);
}

# the name the link gives the object mach makes of the image's stack
val STACK_INPUT: str = "the image's stack";

# mink's bound names of the start and the top of the stack's section
val STACK_START: str = "__run_start_.stack";
val STACK_TOP:   str = "__run_stop_.stack";

# the object holding the stack of an image whose target lays it as a section, from the
# target's `stack_reserve`. none where the image's headers record its stack or its loader
# gives it one, and none where the target states no stack and no object refers to one. an
# image that refers to the stack's bounds and states no size is refused, naming the key,
# since nothing but the manifest knows how much stack a bare machine has to give
fun image_stack(p: *project.Project, inputs: *Given, count: u32) res[opt[Object], fail.Fail] {
    if (!backend.lays_stack(?p.target)) { ret res[opt[Object], fail.Fail].ok{opt[Object].none{}}; }
    val label:    str                 = target_label(p);
    val declared: *manifest.TargetDef = ?p.target_entry.declared;
    if (p.target.stack_commit != 0) {
        ret res[opt[Object], fail.Fail].err{fail.at(p.alloc, fail.formatted_user(p.alloc, diagnostic_kind.TARGET_STACK_SIZE,
            "{} is not expressible on an image no loader maps, whose stack is a section laid out whole; state its size as `stack_reserve`", declared.stack_commit_from.named),
            declared.stack_commit_from.at)};
    }
    val size: u64 = p.target.stack_reserve;
    if (size == 0) {
        var o: u32 = 0;
        for (o < count) {
            if (backend.refers(inputs[o].object, STACK_TOP) || backend.refers(inputs[o].object, STACK_START)) {
                ret res[opt[Object], fail.Fail].err{fail.formatted_user(p.alloc, diagnostic_kind.TARGET_STACK_SIZE,
                    "mach.toml: [target.{}] states no `stack_reserve`, and the image needs a stack: it refers to the bounds of the `{}` section, which an image no loader maps holds its stack in. state the stack's size in bytes as `stack_reserve`",
                    label, backend.STACK_SECTION)};
            }
            o = o + 1;
        }
        ret res[opt[Object], fail.Fail].ok{opt[Object].none{}};
    }
    if (size % backend.STACK_ALIGN != 0) {
        ret res[opt[Object], fail.Fail].err{fail.at(p.alloc, fail.formatted_user(p.alloc, diagnostic_kind.TARGET_STACK_SIZE,
            "{} is {} bytes, and the `{}` section it lays out keeps its top aligned to {}; state a multiple of {}",
            declared.stack_reserve_from.named, size, backend.STACK_SECTION, backend.STACK_ALIGN, backend.STACK_ALIGN), declared.stack_reserve_from.at)};
    }
    val made: res[Object, fail.Fail] = backend.stack_object(?p.back, p.alloc, size);
    if (sel made.err) { ret res[opt[Object], fail.Fail].err{made.err}; }
    ret res[opt[Object], fail.Fail].ok{opt[Object].some{made.ok}};
}

# the name the manifest declares the build's target under
fun target_label(p: *project.Project) str {
    val te: *project.TargetEntry = p.target_entry;
    if (te == nil) { ret "(unnamed)"; }
    ret intern.text(?p.s.interner, te.name);
}

# how mink's link takes the input `li`: a file at its path, a framework mink finds by its
# bundle, or a library mink searches for by name as the one kind it must be, with no fallback
fun link_request(li: *input.Input) Request {
    var include: Include = Include.always{};
    if (li.include_referenced) { include = Include.referenced{}; }
    if (li.form == input.FILE) { ret Request.file{search.File{path: li.text, include: include}}; }
    if (li.form == input.FRAMEWORK) {
        ret Request.library{search.Wanted{form: search.Form.framework{}, name: li.text, include: include, prefer: search.Prefer.shared_first{}}};
    }
    var prefer: search.Prefer = search.Prefer.shared_only{};
    if (li.kind == input.STATIC) { prefer = search.Prefer.static_only{}; }
    ret Request.library{search.Wanted{form: search.Form.system{}, name: li.text, include: include, prefer: prefer}};
}

# the emitted modules' objects as the link's inputs, in topological order, the link's order
pub fun ordered_inputs(p: *project.Project) res[*Given, fail.Fail] {
    val made: res[*Given, A.Error] = A.allocate[Given](p.alloc, p.emit_len::usize + 1);
    if (sel made.err) { ret res[*Given, fail.Fail].err{fail.refused(made.err)}; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.object == nil) {
            A.deallocate[Given](p.alloc, made.ok, p.emit_len::usize + 1);
            ret res[*Given, fail.Fail].err{fail.message("a link requires every module's current object")};
        }
        made.ok[i] = Given{name: input_name(p, m), object: m.object};
        i          = i + 1;
    }
    ret res[*Given, fail.Fail].ok{made.ok};
}

pub fun release_ordered(p: *project.Project, inputs: *Given) {
    A.deallocate[Given](p.alloc, inputs, p.emit_len::usize + 1);
}

# what the link calls the objects of module `m`: its source file, which outlives the link
pub fun input_name(p: *project.Project, m: *project.ModuleEntry) str {
    val file: opt[*lang_source.SourceFile] = lang_source.get(?p.s.sources, m.file_id);
    if (sel file.some) { ret file.some.path; }
    ret intern.text(?p.s.interner, m.fqn);
}

# the name module m's test object goes to the link under, set apart from its object's
pub fun test_input_name(p: *project.Project, m: *project.ModuleEntry) res[str, fail.Fail] {
    val joined: res[str, fail.Fail] = fail.join(p.alloc, input_name(p, m), " (tests)");
    if (sel joined.err) { ret joined; }
    val named: res[intern.StrId, A.Error] = intern.add(?p.s.interner, joined.ok);
    str_free(p.alloc, joined.ok);
    if (sel named.err) { ret res[str, fail.Fail].err{fail.refused(named.err)}; }
    ret res[str, fail.Fail].ok{intern.text(?p.s.interner, named.ok)};
}

# every emitted module's object at its module index, for a reader that walks modules by id
pub fun indexed_objects(p: *project.Project) res[**Object, fail.Fail] {
    val n:    usize                  = project.module_count(p)::usize + 1;
    val made: res[**Object, A.Error] = A.zallocate[*Object](p.alloc, n);
    if (sel made.err) { ret res[**Object, fail.Fail].err{fail.refused(made.err)}; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: u32                  = p.topo[i]::u32;
        val m:   *project.ModuleEntry = project.module_at(p, mid);
        if (m.object == nil) {
            A.deallocate[*Object](p.alloc, made.ok, n);
            ret res[**Object, fail.Fail].err{fail.message("an archive requires every module's current object")};
        }
        made.ok[mid] = m.object;
        i            = i + 1;
    }
    ret res[**Object, fail.Fail].ok{made.ok};
}

pub fun release_indexed(p: *project.Project, objects: **Object) {
    A.deallocate[*Object](p.alloc, objects, project.module_count(p)::usize + 1);
}

# the inputs the unit links beyond its objects, in link order: the manifest's link entries,
# those its dependencies cascade, then the command line's. an input named twice is linked
# once, and each library registers its provider and the symbols it claims
pub fun external_inputs(p: *project.Project, unit: *build_plan.BuildUnit) res[Vector[input.Input], fail.Fail] {
    linkage.providers_clear(?p.linkage);
    var links:  Vector[input.Input] = collections_vector.init[input.Input](p.alloc);
    var handed: bool                = false;
    fin {
        if (!handed) { collections_vector.dnit[input.Input](?links); }
    }
    val te: *project.TargetEntry = p.target_entry;
    if (te != nil) {
        var i: u32 = 0;
        for (i < te.lib_count) {
            val added: err[fail.Fail] = requirement_add(p, ?te.libs[i], ?links);
            if (sel added.err) { ret res[Vector[input.Input], fail.Fail].err{added.err}; }
            i = i + 1;
        }
    }
    var c: u32 = 0;
    for (c < p.config.cascade_lib_count) {
        val added: err[fail.Fail] = requirement_add(p, ?p.config.cascade_libs[c], ?links);
        if (sel added.err) { ret res[Vector[input.Input], fail.Fail].err{added.err}; }
        c = c + 1;
    }
    var t: usize = 0;
    for (t < unit.link_inputs.len) {
        val added: err[fail.Fail] = input_add(p, unit.link_inputs.data[t], ?links);
        if (sel added.err) { ret res[Vector[input.Input], fail.Fail].err{added.err}; }
        t = t + 1;
    }
    handed = true;
    ret res[Vector[input.Input], fail.Fail].ok{links};
}

# the input a manifest link entry names joins `links`, its text held by the session's names,
# and the symbols it claims are registered as imported from its library
fun requirement_add(p: *project.Project, req: *manifest.LinkRequirement, links: *Vector[input.Input]) err[fail.Fail] {
    val lr: res[input.Input, fail.Fail] = build_plan.requirement_input(p.alloc, ?p.s.interner, p.req.project_root, req);
    if (sel lr.err) { ret err[fail.Fail].err{lr.err}; }
    var li: input.Input = lr.ok;
    if (li.form == input.FILE) {
        val held: res[intern.StrId, A.Error] = intern.add(?p.s.interner, li.text);
        str_free(p.alloc, li.text);
        if (sel held.err) { ret err[fail.Fail].err{fail.refused(held.err)}; }
        li.text = intern.text(?p.s.interner, held.ok);
    }
    val claimed: err[fail.Fail] = register_link_claims(p, req);
    if (sel claimed.err) { ret claimed; }
    ret input_add(p, li, links);
}

# `li` joins `links` unless an input of its form and text is there already, its library
# registered as a provider. one library named as both kinds is refused, as a link holds
# each input once
fun input_add(p: *project.Project, li: input.Input, links: *Vector[input.Input]) err[fail.Fail] {
    if (!str_empty(li.key)) {
        val nr: res[intern.StrId, A.Error] = intern.add(?p.s.interner, li.key);
        if (sel nr.err) { ret err[fail.Fail].err{fail.refused(nr.err)}; }
        val rr: err[fail.Fail] = linkage.register_provider(?p.linkage, nr.ok);
        if (sel rr.err) { ret rr; }
    }
    var i: usize = 0;
    for (i < links.len) {
        if (links.data[i].form == li.form && str_equals(links.data[i].text, li.text)) {
            if (links.data[i].kind != li.kind) {
                ret err[fail.Fail].err{fail.formatted_user(p.alloc, diagnostic_kind.LINK_INPUT_INVALID, "library '{}' is named both shared and static", li.text)};
            }
            ret err[fail.Fail].ok{};
        }
        i = i + 1;
    }
    val pushed: res[usize, A.Error] = collections_vector.push[input.Input](links, li);
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

fun register_link_claims(p: *project.Project, req: *manifest.LinkRequirement) err[fail.Fail] {
    var i: u32 = 0;
    for (i < req.symbol_count) {
        val ln: res[intern.StrId, fail.Fail] = project.link_name_for(p, req.symbols[i]);
        if (sel ln.err) {
            ret err[fail.Fail].err{ln.err};
        }
        val sym:  intern.StrId = ln.ok;
        val prev: intern.StrId = linkage.import_library(?p.linkage, sym);
        if (!intern.str_is_nil(prev)) {
            val had: intern.StrId = prev;
            if (!intern.str_same(had, req.key)) {
                ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_SYMBOL_CLAIM_CONFLICT,
                    claim_conflict_message(p, sym, had, req.key))};
            }
            i = i + 1;
            cnt;
        }
        val register_import_library_r: err[fail.Fail] = linkage.register_import_library(?p.linkage, sym, req.key);
        if (sel register_import_library_r.err) { ret register_import_library_r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun claim_conflict_message(p: *project.Project, sym: intern.StrId,
    first: intern.StrId, second: intern.StrId) res[str, fail.Fail] {
    val r: res[str, types_string.StrError] = str_join(p.alloc,
        "symbol '", intern.text(?p.s.interner, sym), "' is claimed by link library '",
        intern.text(?p.s.interner, first), "' and '", intern.text(?p.s.interner, second),
        "'; a symbol may name only one providing library");
    if (sel r.err) { ret res[str, fail.Fail].err{fail.str_refused(r.err)}; }
    ret res[str, fail.Fail].ok{r.ok};
}

pub rec ObjectWrite {
    p:      *project.Project;
    o:      *Object;
    record: *project.Record;
}

pub fun write_object(w: *ObjectWrite, destination: str) err[fail.Fail] {
    var laid: res[Sink, fail.Fail] = res[Sink, fail.Fail].err{fail.message("")};
    if (w.record != nil && w.record.bytes != nil && lang_target.carries_record(?w.p.target)) {
        laid = backend.object_bytes_with(?w.p.back, w.p.alloc, w.o, backend.RECORD_SECTION, w.record.bytes, w.record.len::usize);
    }
    or                { laid = backend.object_bytes(?w.p.back, w.p.alloc, w.o); }
    if (sel laid.err) { ret err[fail.Fail].err{laid.err}; }
    var bytes: Sink = laid.ok;
    fin { val freed: err[mink_fail.Fail] = sink.release(?bytes); }
    val wrote: err[fs.FsError] = fs.write_bytes(destination, sink.data(?bytes), sink.len(?bytes), 0o644);
    if (sel wrote.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.FS_WRITE, fail.fs_text(wrote.err))}; }
    ret err[fail.Fail].ok{};
}

# every module's object reaches `obj/` through a sibling temporary, carrying its cache record,
# since the object cache reads it back; a module the cache restored is already there
pub fun write_objects(p: *project.Project, destinations: *str, inputs_out: **contract.Input) err[fail.Fail] {
    val len: u32 = p.emit_len;
    if (len == 0) {
        @inputs_out = nil;
        ret err[fail.Fail].ok{};
    }
    val res_inputs: res[*contract.Input, A.Error] = A.allocate[contract.Input](p.alloc, len::usize);
    if (sel res_inputs.err) { ret err[fail.Fail].err{fail.refused(res_inputs.err)}; }
    val inputs: *contract.Input = res_inputs.ok;
    var i:      u32             = 0;
    var filled: u32             = 0;
    var handed: bool            = false;
    fin {
        if (!handed) { free_inputs(p.alloc, inputs, filled, len); }
    }
    for (i < len) {
        val mid:         session.ModuleId     = p.topo[i];
        val m:           *project.ModuleEntry = project.module_at(p, mid::u32);
        val destination: str                  = destinations[i];
        val copied:      res[str, A.Error]    = str_dup(p.alloc, destination);
        if (sel copied.err) { ret err[fail.Fail].err{fail.refused(copied.err)}; }
        inputs[i] = contract.Input{file: copied.ok, data: nil, len: 0};
        filled    = i + 1;
        if (cache.restored(p, m)) {
            i = i + 1;
            cnt;
        }
        if (m.object == nil) { ret err[fail.Fail].err{fail.message("an object was not compiled")}; }
        val t_item:  readout.Instant = readout.item_begin(p.progress);
        var write:   ObjectWrite     = ObjectWrite{p: p, o: m.object, record: ?m.record};
        val emitted: err[fail.Fail]  = output.through_temporary[ObjectWrite](p.alloc, destination, ?write, write_object);
        if (sel emitted.err) { ret emitted; }
        readout.item(p.progress, readout.EMIT, intern.text(?p.s.interner, m.fqn), t_item);
        i = i + 1;
    }
    handed      = true;
    @inputs_out = inputs;
    ret err[fail.Fail].ok{};
}

# each test object reaches `obj/` beside its module's object, the same way
# ---
# destinations: per emitted module, its test object's path, nil for a module without one
pub fun write_test_objects(p: *project.Project, destinations: *str) err[fail.Fail] {
    if (destinations == nil) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (destinations[i] == nil || cache.test_restored(p, m)) {
            i = i + 1;
            cnt;
        }
        if (m.test.object == nil) { ret err[fail.Fail].err{fail.message("a test object was not compiled")}; }
        val t_item:  readout.Instant = readout.item_begin(p.progress);
        var write:   ObjectWrite     = ObjectWrite{p: p, o: m.test.object, record: ?m.test.record};
        val emitted: err[fail.Fail]  = output.through_temporary[ObjectWrite](p.alloc, destinations[i], ?write, write_object);
        if (sel emitted.err) { ret emitted; }
        readout.item(p.progress, readout.EMIT, destinations[i], t_item);
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# release `n` object inputs and their array of `cap`; a nil array owns nothing
pub fun free_inputs(a: *A.Allocator, inputs: *contract.Input, n: u32, cap: u32) {
    if (inputs == nil) { ret; }
    var i: u32 = 0;
    for (i < n) {
        if (inputs[i].file != nil) { A.deallocate[u8](a, inputs[i].file::*u8, (str_len(inputs[i].file) + 1)::usize); }
        i = i + 1;
    }
    if (cap > 0) { A.deallocate[contract.Input](a, inputs, cap::usize); }
}
