val DIR_MODE: i32 = 0o0755;

pub fun ensure_parents(a: *A.Allocator, p: str) err[outcome.Fail] {
    val pr: res[str, A.Error] = path.parent(a, p);
    if (sel pr.err) { ret err[outcome.Fail].err{outcome.refused(pr.err)}; }
    val parent: str = pr.ok;
    fin { str_free(a, parent); }
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(a, parent, DIR_MODE);
    if (sel create_dir_all_r.err) { ret err[outcome.Fail].err{outcome.environment(outcome.fs_text(create_dir_all_r.err))}; }
    ret err[outcome.Fail].ok{};
}

rec AsmWriteContext {
    p:   *driver.Project;
    m:   *ir.Module;
    dbg: codegen.DebugInfo;
}

# a producer's failure is the transaction's: a refused codegen is a stalled
# write (nothing persisted), which the transaction folds into a rejection
fun write_asm_codegen(ctx: *AsmWriteContext, out: *writer.Writer) err[writer.WriteError] {
    val outcome_r: res[of.ObjectImage, fail.Fail] = codegen.codegen_unit(ctx.p.s, ?ctx.p.target, ctx.m,
        cgunit.ir_set_empty(), out, ctx.p.req.placement_policy, ctx.dbg);
    if (sel outcome_r.err) {
        ret err[writer.WriteError].err{writer.WriteError.stalled{0}};
    }
    var img: of.ObjectImage = outcome_r.ok;
    obj.dnit(?img);
    ret err[writer.WriteError].ok{};
}

pub fun emit_asm(p: *driver.Project, destination: *publication.Destination, m: *ir.Module) err[outcome.Fail] {

    val dbg_r: res[codegen.DebugInfo, fail.Fail] = driver.debug_info_of(p);
    if (sel dbg_r.err) {
        ret err[outcome.Fail].err{outcome.from_fail(dbg_r.err)};
    }

    var ctx: AsmWriteContext;
    ctx.p   = p;
    ctx.m   = m;
    ctx.dbg = dbg_r.ok;
    ret publication.writer_at[AsmWriteContext](nil, p.alloc, ?destination.claim, destination.path, ?ctx, write_asm_codegen, 0o644, publication.REPLACE, "write", "the artifact could not be published");
}

rec IrWriteContext {
    m:        *ir.Module;
    interner: *intern.Interner;
    context:  printer.IrDebugContext;
}

fun write_ir_debug(iwc: *IrWriteContext, out: *writer.Writer) err[writer.WriteError] {
    var debug: printer.IrDebugWriter = printer.debug_writer(out, iwc.m, iwc.interner, iwc.context);
    val written: err[fail.Fail] = printer.write_debug(?debug);
    if (sel written.err) { ret err[writer.WriteError].err{writer.WriteError.stalled{0}}; }
    ret err[writer.WriteError].ok{};
}

rec PartialWriteContext {}

fun test_partial_ir_write(ctx: *PartialWriteContext,
                          out: *writer.Writer) err[writer.WriteError] {
    val write_r: err[writer.WriteError] = writer.write_all(out, "partial", 7);
    if (sel write_r.err) { ret write_r; }
    ret err[writer.WriteError].err{writer.WriteError.stalled{7}};
}

test "mach.lang.build.emit.publish_writer_at:writer_failure_preserves_prior_artifact" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val temp_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach_emit_ir_publish");
    if (sel temp_r.err) { ret 1; }
    var temp: fs.TempFile = temp_r.ok;
    val artifact_path: str = fs.temp_path(?temp);
    val temp_close_r: err[io_error.Error] = fs.temp_close(?temp);
    if (sel temp_close_r.err) { fs.temp_remove(?temp); ret 1; }

    val prior: str = "complete-prior-artifact";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(artifact_path, prior::*u8, str_len(prior), 0o644);
    if (sel write_bytes_r.err) {
        fs.temp_remove(?temp); ret 1;
    }
    var pwc: PartialWriteContext;
    val publish_r: err[outcome.Fail] = publication.writer[PartialWriteContext](nil, ?alloc, artifact_path, ?pwc, test_partial_ir_write, 0o644, publication.REPLACE, publication.PARENTS_CREATE, "write", "the artifact could not be published");
    if (sel publish_r.ok) { fs.temp_remove(?temp); ret 1; }

    val read_r: res[str, fs.FsError] = fs.read_string(?alloc, artifact_path);
    if (sel read_r.err) { fs.temp_remove(?temp); ret 1; }
    val got: str = read_r.ok;
    val same: bool = str_equals(got, prior);
    str_free(?alloc, got);
    fs.temp_remove(?temp);
    if (!same) { ret 1; }
    ret 0;
}

pub fun emit_ir(p: *driver.Project, destination: *publication.Destination, m: *ir.Module) err[outcome.Fail] {
    if (p.target_entry == nil) { ret err[outcome.Fail].err{outcome.environment("selected target is unavailable")}; }

    val opt_target: opt[str] = intern.lookup_typed(?p.s.interner, p.target_entry.name);
    if (sel opt_target.none) { ret err[outcome.Fail].err{outcome.environment("selected target name is not interned")}; }
    if (p.target.isa == nil || p.target.os == nil || p.target.abi == nil || p.target.of == nil) {
        ret err[outcome.Fail].err{outcome.environment("selected target metadata is unavailable")};
    }


    var iwc: IrWriteContext;
    iwc.m = m;
    iwc.interner = ?p.s.interner;
    iwc.context = printer.debug_context(
        "post-codegen", opt_target.some, p.target.isa.name,
        p.target.os.name, p.target.abi.name, p.target.of.name);
    ret publication.writer_at[IrWriteContext](nil, p.alloc, ?destination.claim, destination.path, ?iwc, write_ir_debug, 0o644, publication.REPLACE, "write", "the artifact could not be published");
}

pub fun artifact_product_name(p: *driver.Project) *u8 {
    val nm: opt[str] = intern.lookup_typed(?p.s.interner, p.config.bin_name);
    if (sel nm.some) { ret nm.some::*u8; }
    ret ""::*u8;
}

pub rec LoadedImageOptions {
    options:       of.ImageOptions;
    resource:      *of.ResourceInfo;
    icon_bytes:    Vector[u8];
    manifest_bytes: Vector[u8];
    icon_path:     str;
    manifest_path: str;
}

pub fun dnit_image_options(a: *A.Allocator, loaded: *LoadedImageOptions) {
    if (loaded == nil) { ret; }
    vector.dnit[u8](?loaded.icon_bytes);
    vector.dnit[u8](?loaded.manifest_bytes);
    if (loaded.icon_path != nil) { str_free(a, loaded.icon_path); }
    if (loaded.manifest_path != nil) { str_free(a, loaded.manifest_path); }
    if (loaded.resource != nil) { A.deallocate[of.ResourceInfo](a, loaded.resource, 1); }
}

pub fun load_image_options(p: *driver.Project, out_kind: linker.LinkMode,
                           exe_path: *u8) res[LoadedImageOptions, outcome.Fail] {
    var loaded: LoadedImageOptions;
    loaded.options = of.image_options_default(p.req.subsystem);
    loaded.resource = nil;
    loaded.icon_bytes = vector.init[u8](p.alloc);
    loaded.manifest_bytes = vector.init[u8](p.alloc);
    loaded.icon_path = nil;
    loaded.manifest_path = nil;

    if (out_kind != linker.LINK_EXE || p.target.os_id != os.OS_WINDOWS) {
        ret res[LoadedImageOptions, outcome.Fail].ok{loaded};
    }
    if (p.config.icon == intern.STR_NIL && p.config.app_manifest == intern.STR_NIL) {
        ret res[LoadedImageOptions, outcome.Fail].ok{loaded};
    }

    val root_o: opt[str] = intern.lookup_typed(?p.s.interner, p.config.project_root);
    val ver_o: opt[str] = intern.lookup_typed(?p.s.interner, p.config.version);
    val name_o: opt[str] = intern.lookup_typed(?p.s.interner, p.config.bin_name);
    if (sel root_o.none) {
        dnit_image_options(p.alloc, ?loaded);
        ret res[LoadedImageOptions, outcome.Fail].err{outcome.internal("PE resource metadata is not interned")};
    }
    if (sel ver_o.none) {
        dnit_image_options(p.alloc, ?loaded);
        ret res[LoadedImageOptions, outcome.Fail].err{outcome.internal("PE resource metadata is not interned")};
    }
    if (sel name_o.none) {
        dnit_image_options(p.alloc, ?loaded);
        ret res[LoadedImageOptions, outcome.Fail].err{outcome.internal("PE resource metadata is not interned")};
    }

    if (p.config.icon != intern.STR_NIL) {
        val rel_o: opt[str] = intern.lookup_typed(?p.s.interner, p.config.icon);
        if (sel rel_o.none) {
            dnit_image_options(p.alloc, ?loaded);
            ret res[LoadedImageOptions, outcome.Fail].err{outcome.internal("PE icon path is not interned")};
        }
        val pr: res[str, A.Error] = path.join(p.alloc, root_o.some, rel_o.some);
        if (sel pr.err) {
            dnit_image_options(p.alloc, ?loaded);
            ret res[LoadedImageOptions, outcome.Fail].err{outcome.refused(pr.err)};
        }
        loaded.icon_path = pr.ok;
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(p.alloc, loaded.icon_path);
        if (sel rr.err) {
            val msg_r: res[str, string.StrError] = str_join(p.alloc, "cannot read artifact icon '",
                rel_o.some, "' (", loaded.icon_path, "): ",
                outcome.fs_text(rr.err));
            var msg: str = "cannot read artifact icon";
            if (sel msg_r.ok) { msg = msg_r.ok; }
            dnit_image_options(p.alloc, ?loaded);
            ret res[LoadedImageOptions, outcome.Fail].err{outcome.user(msg)};
        }
        loaded.icon_bytes = rr.ok;
        if (loaded.icon_bytes.len == 0) {
            val msg_r: res[str, string.StrError] = str_join(p.alloc, "artifact icon '",
                rel_o.some, "' is empty");
            var msg: str = "artifact icon is empty";
            if (sel msg_r.ok) { msg = msg_r.ok; }
            dnit_image_options(p.alloc, ?loaded);
            ret res[LoadedImageOptions, outcome.Fail].err{outcome.user(msg)};
        }
    }

    if (p.config.app_manifest != intern.STR_NIL) {
        val rel_o: opt[str] = intern.lookup_typed(?p.s.interner, p.config.app_manifest);
        if (sel rel_o.none) {
            dnit_image_options(p.alloc, ?loaded);
            ret res[LoadedImageOptions, outcome.Fail].err{outcome.internal("PE manifest path is not interned")};
        }
        val pr: res[str, A.Error] = path.join(p.alloc, root_o.some, rel_o.some);
        if (sel pr.err) {
            dnit_image_options(p.alloc, ?loaded);
            ret res[LoadedImageOptions, outcome.Fail].err{outcome.refused(pr.err)};
        }
        loaded.manifest_path = pr.ok;
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(p.alloc, loaded.manifest_path);
        if (sel rr.err) {
            val msg_r: res[str, string.StrError] = str_join(p.alloc, "cannot read artifact manifest '",
                rel_o.some, "' (", loaded.manifest_path, "): ",
                outcome.fs_text(rr.err));
            var msg: str = "cannot read artifact manifest";
            if (sel msg_r.ok) { msg = msg_r.ok; }
            dnit_image_options(p.alloc, ?loaded);
            ret res[LoadedImageOptions, outcome.Fail].err{outcome.user(msg)};
        }
        loaded.manifest_bytes = rr.ok;
        if (loaded.manifest_bytes.len == 0) {
            val msg_r: res[str, string.StrError] = str_join(p.alloc, "artifact manifest '",
                rel_o.some, "' is empty");
            var msg: str = "artifact manifest is empty";
            if (sel msg_r.ok) { msg = msg_r.ok; }
            dnit_image_options(p.alloc, ?loaded);
            ret res[LoadedImageOptions, outcome.Fail].err{outcome.user(msg)};
        }
    }

    val ar: res[*of.ResourceInfo, A.Error] = A.zallocate[of.ResourceInfo](p.alloc, 1);
    if (sel ar.err) {
        dnit_image_options(p.alloc, ?loaded);
        ret res[LoadedImageOptions, outcome.Fail].err{outcome.refused(ar.err)};
    }
    loaded.resource = ar.ok;
    loaded.resource.icon = loaded.icon_bytes.data;
    loaded.resource.icon_len = loaded.icon_bytes.len;
    loaded.resource.app_manifest = loaded.manifest_bytes.data;
    loaded.resource.app_manifest_len = loaded.manifest_bytes.len;
    loaded.resource.version = ver_o.some;
    loaded.resource.internal_name = name_o.some;
    loaded.resource.original_filename = path.filename(exe_path::str);
    loaded.resource.product_name = name_o.some;
    loaded.options.resources = loaded.resource;
    ret res[LoadedImageOptions, outcome.Fail].ok{loaded};
}

fun free_members(alloc: *A.Allocator, members: *ar.ArMember, cap: u32) {
    var i: u32 = 0;
    for (i < cap) {
        if (members[i].sym_names != nil && members[i].sym_count > 0) { A.deallocate[str](alloc, members[i].sym_names, members[i].sym_count::usize); }
        i = i + 1;
    }
    A.deallocate[ar.ArMember](alloc, members, cap::usize);
}

fun free_read_bufs(alloc: *A.Allocator, bufs: *Vector[u8], cap: u32) {
    var i: u32 = 0;
    for (i < cap) { vector.dnit[u8](?bufs[i]); i = i + 1; }
    A.deallocate[Vector[u8]](alloc, bufs, cap::usize);
}

fun collect_defined_globals(p: *driver.Project, img: *of.ObjectImage, member: *ar.ArMember) bool {
    member.sym_names = nil;
    member.sym_count = 0;
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < img.symbol_count) {
        if ((img.symbols[i].flags & of.SYM_OBJ_FLAG_GLOBAL) != 0 && !of.section_is_external(img.symbols[i].section)) { n = n + 1; }
        i = i + 1;
    }
    if (n == 0) { ret true; }
    val outcome_r: res[*str, A.Error] = A.allocate[str](p.alloc, n::usize);
    if (sel outcome_r.err) { ret false; }
    val names: *str = outcome_r.ok;
    var w: u32 = 0;
    i = 0;
    for (i < img.symbol_count) {
        if ((img.symbols[i].flags & of.SYM_OBJ_FLAG_GLOBAL) != 0 && !of.section_is_external(img.symbols[i].section)) {
            val nm: opt[str] = intern.lookup_typed(img.interner, img.symbols[i].name);
            if (sel nm.some) { names[w] = nm.some; w = w + 1; }
        }
        i = i + 1;
    }
    member.sym_names = names;
    member.sym_count = w;
    ret true;
}

pub fun emit_static_archive(p: *driver.Project, destination: *publication.Destination, images: *of.ObjectImage, paths: **u8, out_path: **u8) err[outcome.Fail] {
    val len: u32 = p.emit_len;

    val archive: str = destination.path;

    val res_mem: res[*ar.ArMember, A.Error] = A.allocate[ar.ArMember](p.alloc, len::usize);
    if (sel res_mem.err) { ret err[outcome.Fail].err{outcome.refused(res_mem.err)}; }
    val members: *ar.ArMember = res_mem.ok;

    val res_bufs: res[*Vector[u8], A.Error] = A.allocate[Vector[u8]](p.alloc, len::usize);
    if (sel res_bufs.err) { free_members(p.alloc, members, len); ret err[outcome.Fail].err{outcome.internal("out of memory")}; }
    val bufs: *Vector[u8] = res_bufs.ok;

    var i: u32 = 0;
    for (i < len) {
        members[i].name = ""; members[i].data = nil; members[i].len = 0; members[i].sym_names = nil; members[i].sym_count = 0;
        bufs[i] = vector.init[u8](p.alloc);
        i = i + 1;
    }

    i = 0;
    for (i < len) {
        val mid: session.ModuleId    = p.topo[i];
        val m:   *driver.ModuleEntry = ?p.modules[mid::u32];
        val fqn_opt: opt[str] = intern.lookup_typed(?p.s.interner, m.fqn);
        if (sel fqn_opt.none) { free_read_bufs(p.alloc, bufs, len); free_members(p.alloc, members, len); ret err[outcome.Fail].err{outcome.internal("module FQN not interned")}; }
        members[i].name = fqn_opt.some;

        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(p.alloc, paths[i]::str);
        if (sel rr.err) { free_read_bufs(p.alloc, bufs, len); free_members(p.alloc, members, len); ret err[outcome.Fail].err{outcome.internal("cannot read object for archive")}; }
        bufs[i] = rr.ok;
        members[i].data = bufs[i].data;
        members[i].len  = bufs[i].len;

        if (!collect_defined_globals(p, ?images[mid::u32], ?members[i])) { free_read_bufs(p.alloc, bufs, len); free_members(p.alloc, members, len); ret err[outcome.Fail].err{outcome.internal("out of memory")}; }
        i = i + 1;
    }

    val wr: err[fail.Fail] = ar.write_archive(p.alloc, members, len, destination);
    free_read_bufs(p.alloc, bufs, len);
    free_members(p.alloc, members, len);
    if (sel wr.err) {
        ret err[outcome.Fail].err{outcome.from_fail(wr.err)};
    }
    @out_path = archive;
    ret err[outcome.Fail].ok{};
}

pub fun emit_shared_library(p: *driver.Project, destination: *publication.Destination, paths: **u8, len: u32,
                            dynlibs: *of.DynLib, dynlib_len: u32, out_path: **u8) err[outcome.Fail] {
    val solib: str = destination.path;

    val res_link: R.Result[R.Void, str] =
        linker.link(p.s, ?p.target, paths, len, dynlibs, dynlib_len, destination, artifact_product_name(p), linker.LINK_SHARED, p.req.pie, of.image_options_default(p.req.subsystem));
    if (R.is_err[R.Void, str](res_link)) {
        ret err[outcome.Fail].err{outcome.user(R.unwrap_err[R.Void, str](res_link))};
    }
    @out_path = solib;
    ret err[outcome.Fail].ok{};
}

pub fun link_executable(p: *driver.Project, paths: **u8, len: u32,
                        dynlibs: *of.DynLib, dynlib_len: u32, destination: *publication.Destination,
                        image_options: of.ImageOptions) err[outcome.Fail] {
    val res_link: R.Result[R.Void, str] =
        linker.link(p.s, ?p.target, paths, len, dynlibs, dynlib_len, destination, artifact_product_name(p), linker.LINK_EXE, p.req.pie, image_options);
    if (R.is_err[R.Void, str](res_link)) {
        ret err[outcome.Fail].err{outcome.user(R.unwrap_err[R.Void, str](res_link))};
    }
    ret err[outcome.Fail].ok{};
}

fun gather_topo_images(p: *driver.Project, images: *of.ObjectImage) res[*of.ObjectImage, outcome.Fail] {
    val len: u32 = p.emit_len;
    val res_ord: res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](p.alloc, len::usize);
    if (sel res_ord.err) { ret res[*of.ObjectImage, outcome.Fail].err{outcome.refused(res_ord.err)}; }
    val ordered: *of.ObjectImage = res_ord.ok;
    var i: u32 = 0;
    for (i < len) {
        ordered[i] = images[(p.topo[i])::u32];
        i = i + 1;
    }
    ret res[*of.ObjectImage, outcome.Fail].ok{ordered};
}

pub fun link_flat_images(p: *driver.Project, images: *of.ObjectImage, destination: *publication.Destination,
                         image_options: of.ImageOptions) err[outcome.Fail] {
    val res_ord: res[*of.ObjectImage, outcome.Fail] = gather_topo_images(p, images);
    if (sel res_ord.err) { ret err[outcome.Fail].err{outcome.internal("out of memory")}; }
    val ordered: *of.ObjectImage = res_ord.ok;

    val res_link: R.Result[R.Void, str] =
        linker.link_images(p.s, ?p.target, ordered, p.emit_len, nil::*of.DynLib, 0, destination, artifact_product_name(p), linker.LINK_EXE, p.req.pie, image_options);
    A.deallocate[of.ObjectImage](p.alloc, ordered, p.emit_len::usize);
    if (R.is_err[R.Void, str](res_link)) {
        ret err[outcome.Fail].err{outcome.user(R.unwrap_err[R.Void, str](res_link))};
    }
    ret err[outcome.Fail].ok{};
}

pub fun link_mixed_images(p: *driver.Project, images: *of.ObjectImage,
                          ext_paths: **u8, ext_count: u32,
                          dynlibs: *of.DynLib, dynlib_len: u32, destination: *publication.Destination,
                          image_options: of.ImageOptions) err[outcome.Fail] {
    val res_ord: res[*of.ObjectImage, outcome.Fail] = gather_topo_images(p, images);
    if (sel res_ord.err) { ret err[outcome.Fail].err{outcome.internal("out of memory")}; }
    val ordered: *of.ObjectImage = res_ord.ok;

    val res_link: R.Result[R.Void, str] =
        linker.link_mixed(p.s, ?p.target, ordered, p.emit_len, ext_paths, ext_count,
                          dynlibs, dynlib_len, destination, artifact_product_name(p), linker.LINK_EXE, p.req.pie, image_options);
    A.deallocate[of.ObjectImage](p.alloc, ordered, p.emit_len::usize);
    if (R.is_err[R.Void, str](res_link)) {
        ret err[outcome.Fail].err{outcome.user(R.unwrap_err[R.Void, str](res_link))};
    }
    ret err[outcome.Fail].ok{};
}

fun count_external_tokens(p: *driver.Project, unit: *plan.BuildUnit) u32 {
    var n: u32 = 0;
    val te: *driver.TargetEntry = p.target_entry;
    if (te != nil) { n = n + te.lib_count; }
    n = n + p.config.cascade_lib_count;
    n = n + unit.link_inputs.len::u32;
    ret n;
}

pub fun append_external_inputs(p: *driver.Project, unit: *plan.BuildUnit,
                               paths: ***u8, len: *u32,
                               dynlibs: **of.DynLib, dynlib_len: *u32) err[outcome.Fail] {
    @dynlibs    = nil;
    @dynlib_len = 0;
    session.reset_link_providers(p.s);
    val extra: u32 = count_external_tokens(p, unit);
    if (extra == 0) { ret err[outcome.Fail].ok{}; }

    val base:  u32 = @len;
    val grown: u32 = base + extra;
    val res_grow: res[**u8, A.Error] = A.reallocate[*u8](p.alloc, @paths, base::usize, grown::usize);
    if (sel res_grow.err) { ret err[outcome.Fail].err{outcome.refused(res_grow.err)}; }
    @paths = res_grow.ok;

    var z: u32 = base;
    for (z < grown) { (@paths)[z] = nil; z = z + 1; }
    @len = grown;

    var written: u32 = base;

    val te: *driver.TargetEntry = p.target_entry;
    if (te != nil) {
        var i: u32 = 0;
        for (i < te.lib_count) {
            val rc: err[outcome.Fail] = resolve_and_store_input(p, ?te.libs[i],
                                                    @paths, ?written, dynlibs, dynlib_len);
            if (sel rc.err) { shrink_paths(p, paths, len, written, grown); ret rc; }
            i = i + 1;
        }
    }

    var i: u32 = 0;
    for (i < p.config.cascade_lib_count) {
        val rc: err[outcome.Fail] = resolve_and_store_input(p, ?p.config.cascade_libs[i],
                                                @paths, ?written, dynlibs, dynlib_len);
        if (sel rc.err) { shrink_paths(p, paths, len, written, grown); ret rc; }
        i = i + 1;
    }

    var ti: usize = 0;
    for (ti < unit.link_inputs.len) {
        val rc: err[outcome.Fail] = store_fact(p, ?unit.link_inputs.data[ti],
                                                @paths, ?written, dynlibs, dynlib_len);
        if (sel rc.err) { shrink_paths(p, paths, len, written, grown); ret rc; }
        ti = ti + 1;
    }

    shrink_paths(p, paths, len, written, grown);
    ret err[outcome.Fail].ok{};
}

fun store_fact(p: *driver.Project, li: *plan.LinkInput, paths: **u8, written: *u32,
               dynlibs: **of.DynLib, dynlib_len: *u32) err[outcome.Fail] {
    val pr: err[outcome.Fail] = register_link_provider(p, li);
    if (sel pr.err) { ret pr; }
    if (li.kind == plan.LINK_DYNAMIC) {
        ret append_dynlib(p, li, dynlibs, dynlib_len);
    }
    if (static_path_present(paths, @written, li.text)) {
        ret err[outcome.Fail].ok{};
    }
    val dup_r: res[str, string.StrError] = str_copy(p.alloc, li.text::*u8);
    if (sel dup_r.err) { ret err[outcome.Fail].err{outcome.internal("out of memory")}; }
    paths[@written] = dup_r.ok;
    @written = @written + 1;
    ret err[outcome.Fail].ok{};
}

fun shrink_paths(p: *driver.Project, paths: ***u8, len: *u32, written: u32, grown: u32) {
    if (written < grown) {
        val res_shrink: res[**u8, A.Error] = A.reallocate[*u8](p.alloc, @paths, grown::usize, written::usize);
        if (sel res_shrink.ok) {
            @paths = res_shrink.ok;
            @len   = written;
            ret;
        }
    }
    @len = grown;
}

fun append_dynlib(p: *driver.Project, li: *plan.LinkInput,
                  dynlibs: **of.DynLib, dynlib_len: *u32) err[outcome.Fail] {
    val res_intern: res[intern.StrId, A.Error] = intern.intern_typed(?p.s.interner, li.text);
    if (sel res_intern.err) { ret err[outcome.Fail].err{outcome.refused(res_intern.err)}; }
    val soname: intern.StrId = res_intern.ok;
    var name: intern.StrId = soname;
    if (!str_empty(li.library)) {
        val name_r: res[intern.StrId, A.Error] = intern.intern_typed(?p.s.interner, li.library);
        if (sel name_r.err) {
            ret err[outcome.Fail].err{outcome.internal("out of memory")};
        }
        name = name_r.ok;
    }
    var rpath: intern.StrId = intern.STR_NIL;
    if (!str_empty(li.rpath)) {
        val rp_r: res[intern.StrId, A.Error] = intern.intern_typed(?p.s.interner, li.rpath);
        if (sel rp_r.err) {
            ret err[outcome.Fail].err{outcome.internal("out of memory")};
        }
        rpath = rp_r.ok;
    }

    var i: u32 = 0;
    for (i < @dynlib_len) {
        if ((@dynlibs)[i].name == name) {
            if ((@dynlibs)[i].soname == soname) {
                if ((@dynlibs)[i].rpath == intern.STR_NIL) { (@dynlibs)[i].rpath = rpath; }
                ret err[outcome.Fail].ok{};
            }
            ret err[outcome.Fail].err{outcome.user(dynlib_conflict_message(
                p, name, (@dynlibs)[i].soname, soname))};
        }
        i = i + 1;
    }

    val old: u32 = @dynlib_len;
    val res_grow: res[*of.DynLib, A.Error] = A.reallocate[of.DynLib](p.alloc, @dynlibs, old::usize, (old + 1)::usize);
    if (sel res_grow.err) { ret err[outcome.Fail].err{outcome.refused(res_grow.err)}; }
    @dynlibs = res_grow.ok;
    (@dynlibs)[old].name = name;
    (@dynlibs)[old].soname = soname;
    (@dynlibs)[old].rpath = rpath;
    (@dynlibs)[old].include_referenced = li.include_referenced;
    @dynlib_len = old + 1;
    ret err[outcome.Fail].ok{};
}

test "mach.lang.build.emit.append_dynlib:reinterns_logical_name" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init_typed(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var p: driver.Project;
    p.s = ?s;
    p.alloc = ?alloc;
    var li: plan.LinkInput;
    li.kind = plan.LINK_DYNAMIC;
    li.text = "libfoo.so.1";
    li.library = "foo";
    li.rpath = "";
    var libs: *of.DynLib = nil;
    var len: u32 = 0;
    val ar: err[outcome.Fail] = append_dynlib(?p, ?li, ?libs, ?len);
    if (sel ar.err) {
        session.dnit(?s);
        ret 1;
    }
    if (len != 1) {
        session.dnit(?s);
        ret 1;
    }
    val name: opt[str] = intern.lookup_typed(?s.interner, libs[0].name);
    val loader: opt[str] = intern.lookup_typed(?s.interner, libs[0].soname);
    var bad: bool = true;
    if (sel name.some) {
        if (sel loader.some) {
            bad = !str_equals(name.some, "foo") || !str_equals(loader.some, "libfoo.so.1");
        }
    }
    free_dynlibs(?alloc, libs, len);
    session.dnit(?s);
    if (bad) { ret 1; }
    ret 0;
}

fun dynlib_conflict_message(p: *driver.Project, name: intern.StrId,
                            first: intern.StrId, second: intern.StrId) str {
    val n: opt[str] = intern.lookup_typed(?p.s.interner, name);
    val a: opt[str] = intern.lookup_typed(?p.s.interner, first);
    val b: opt[str] = intern.lookup_typed(?p.s.interner, second);
    if (sel n.none) {
        ret "one logical link library resolves to multiple loader names";
    }
    if (sel a.none) {
        ret "one logical link library resolves to multiple loader names";
    }
    if (sel b.none) {
        ret "one logical link library resolves to multiple loader names";
    }
    val r: res[str, string.StrError] = str_join(p.alloc,
        "link library '", n.some, "' resolves to both '",
        a.some, "' and '", b.some, "'");
    if (sel r.err) { ret outcome.str_text(r.err); }
    ret r.ok;
}

pub fun free_dynlibs(a: *A.Allocator, dynlibs: *of.DynLib, dynlib_len: u32) {
    if (dynlibs != nil && dynlib_len > 0) {
        A.deallocate[of.DynLib](a, dynlibs, dynlib_len::usize);
    }
}

fun resolve_and_store_input(p: *driver.Project, req: *manifest.LinkRequirement,
                            paths: **u8, written: *u32,
                            dynlibs: **of.DynLib, dynlib_len: *u32) err[outcome.Fail] {
    val lr: res[plan.LinkInput, outcome.Fail] = plan.resolve_requirement(p.alloc, ?p.s.interner, ?p.target,
                                 ?p.req.lib_dirs, p.req.project_root, req);
    if (sel lr.err) {
        ret err[outcome.Fail].err{lr.err};
    }
    val li: plan.LinkInput = lr.ok;
    val pr: err[outcome.Fail] = register_link_provider(p, ?li);
    if (sel pr.err) { ret pr; }
    if (li.kind == plan.LINK_DYNAMIC) {
        val cr: err[outcome.Fail] = register_link_claims(p, req);
        if (sel cr.err) { ret cr; }
        ret append_dynlib(p, ?li, dynlibs, dynlib_len);
    }
    if (req.symbol_count > 0) {
        ret err[outcome.Fail].err{outcome.user(static_claim_message(p, req))};
    }
    if (static_path_present(paths, @written, li.text)) {
        A.deallocate[u8](p.alloc, li.text::*u8, str_len(li.text) + 1);
        ret err[outcome.Fail].ok{};
    }
    paths[@written] = li.text::*u8;
    @written = @written + 1;
    ret err[outcome.Fail].ok{};
}

fun register_link_provider(p: *driver.Project, li: *plan.LinkInput) err[outcome.Fail] {
    if (str_empty(li.library)) { ret err[outcome.Fail].ok{}; }
    val nr: res[intern.StrId, A.Error] = intern.intern_typed(?p.s.interner, li.library);
    if (sel nr.err) {
        ret err[outcome.Fail].err{outcome.internal("out of memory")};
    }
    val rr: err[fail.Fail] = session.register_link_provider_typed(
        p.s, nr.ok, li.kind == plan.LINK_STATIC);
    if (sel rr.err) {
        ret err[outcome.Fail].err{outcome.internal("out of memory")};
    }
    ret err[outcome.Fail].ok{};
}

fun register_link_claims(p: *driver.Project, req: *manifest.LinkRequirement) err[outcome.Fail] {
    var i: u32 = 0;
    for (i < req.symbol_count) {
        val ln: res[intern.StrId, fail.Fail] = driver.link_name_for(p, req.symbols[i]);
        if (sel ln.err) {
            ret err[outcome.Fail].err{outcome.from_fail(ln.err)};
        }
        val sym: intern.StrId = ln.ok;
        val prev: opt[intern.StrId] = session.import_library_typed(p.s, sym);
        if (sel prev.some) {
            val had: intern.StrId = prev.some;
            if (had != req.library) {
                ret err[outcome.Fail].err{outcome.user(
                    claim_conflict_message(p, sym, had, req.library))};
            }
            i = i + 1;
            cnt;
        }
        val register_import_library_typed_r: err[fail.Fail] = session.register_import_library_typed(p.s, sym, req.library);
        if (sel register_import_library_typed_r.err) {
            ret err[outcome.Fail].err{outcome.internal("out of memory")};
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

test "mach.lang.build.emit.register_link_claims:pins_and_rejects_conflicts" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init_typed(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val register_all_r: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel register_all_r.err) { session.dnit(?s); ret 1; }

    var p: driver.Project;
    p.s = ?s;
    p.alloc = ?alloc;

    val sym_r: res[intern.StrId, A.Error] = intern.intern_typed(?s.interner, "Sleep");
    val pre_r: res[intern.StrId, A.Error] = intern.intern_typed(?s.interner, "_Sleep");
    val k32_r: res[intern.StrId, A.Error] = intern.intern_typed(?s.interner, "kernel32");
    val u32_r: res[intern.StrId, A.Error] = intern.intern_typed(?s.interner, "user32");
    if (sel sym_r.err) { session.dnit(?s); ret 1; }
    if (sel pre_r.err) { session.dnit(?s); ret 1; }
    if (sel k32_r.err) { session.dnit(?s); ret 1; }
    if (sel u32_r.err) { session.dnit(?s); ret 1; }
    var syms: [1]intern.StrId;
    syms[0] = sym_r.ok;

    var req: manifest.LinkRequirement;
    req.source       = manifest.LINK_SYSTEM;
    req.text         = k32_r.ok;
    req.library      = k32_r.ok;
    req.symbols      = ?syms[0];
    req.symbol_count = 1;

    var code: i32 = 0;

    val lr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel lr.err) { session.dnit(?s); ret 1; }
    p.target = lr.ok;

    val register_link_claims_r: err[outcome.Fail] = register_link_claims(?p, ?req);
    if (sel register_link_claims_r.err) { code = 1; }
    val got: opt[intern.StrId] = session.import_library_typed(?s, syms[0]);
    if (!(sel got.some && got.some == req.library)) { code = 1; }

    val register_link_claims_r2: err[outcome.Fail] = register_link_claims(?p, ?req);
    if (sel register_link_claims_r2.err) { code = 1; }

    var other: manifest.LinkRequirement = req;
    other.library = u32_r.ok;
    val register_link_claims_r3: err[outcome.Fail] = register_link_claims(?p, ?other);
    if (sel register_link_claims_r3.ok) { code = 1; }

    session.reset_module_registry(?s);
    val dr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "darwin", "sysv64");
    if (sel dr.err) { session.dnit(?s); ret 1; }
    p.target = dr.ok;

    val register_link_claims_r4: err[outcome.Fail] = register_link_claims(?p, ?req);
    if (sel register_link_claims_r4.err) { code = 1; }
    val dgot: opt[intern.StrId] = session.import_library_typed(?s, pre_r.ok);
    if (!(sel dgot.some && dgot.some == req.library)) { code = 1; }
    val import_library_typed_r: opt[intern.StrId] = session.import_library_typed(?s, syms[0]);
    if (sel import_library_typed_r.none) { ret 99; }
    if (sel import_library_typed_r.some) { code = 1; }

    val register_link_claims_r5: err[outcome.Fail] = register_link_claims(?p, ?other);
    if (sel register_link_claims_r5.ok) { code = 1; }

    session.dnit(?s);
    ret code;
}

fun claim_conflict_message(p: *driver.Project, sym: intern.StrId,
                           first: intern.StrId, second: intern.StrId) str {
    val n: opt[str] = intern.lookup_typed(?p.s.interner, sym);
    val a: opt[str] = intern.lookup_typed(?p.s.interner, first);
    val b: opt[str] = intern.lookup_typed(?p.s.interner, second);
    if (sel n.none) {
        ret "one symbol is claimed by two link libraries";
    }
    if (sel a.none) {
        ret "one symbol is claimed by two link libraries";
    }
    if (sel b.none) {
        ret "one symbol is claimed by two link libraries";
    }
    val r: res[str, string.StrError] = str_join(p.alloc,
        "symbol '", n.some, "' is claimed by link library '",
        a.some, "' and '", b.some,
        "'; a symbol may name only one providing library");
    if (sel r.err) { ret outcome.str_text(r.err); }
    ret r.ok;
}

fun static_claim_message(p: *driver.Project, req: *manifest.LinkRequirement) str {
    val t: opt[str] = intern.lookup_typed(?p.s.interner, req.text);
    if (sel t.none) {
        ret "a link entry that resolves to a static input cannot claim symbols";
    }
    val r: res[str, string.StrError] = str_join(p.alloc,
        "link entry '", t.some,
        "' resolves to a static input, which defines symbols rather than importing them; ",
        "remove its 'symbols' key");
    if (sel r.err) { ret outcome.str_text(r.err); }
    ret r.ok;
}

fun static_path_present(paths: **u8, written: u32, candidate: str) bool {
    var i: u32 = 0;
    for (i < written) {
        if (paths[i] != nil && str_equals(paths[i]::str, candidate)) { ret true; }
        i = i + 1;
    }
    ret false;
}

test "mach.lang.build.emit.static_path_present:deduplicates_exact_paths" {
    var paths: [3]*u8;
    paths[0] = "one.o"::*u8;
    paths[1] = "libsame.a"::*u8;
    paths[2] = nil;
    if (!static_path_present(?paths[0], 2, "libsame.a")) { ret 1; }
    if (static_path_present(?paths[0], 2, "other.a")) { ret 1; }
    ret 0;
}

pub fun write_objects(p: *driver.Project, images: *of.ObjectImage,
                      destinations: **publication.Destination, paths_out: ***u8) err[outcome.Fail] {
    val len: u32 = p.emit_len;
    if (len == 0) { @paths_out = nil; ret err[outcome.Fail].ok{}; }
    val res_paths: res[**u8, A.Error] = A.allocate[*u8](p.alloc, len::usize);
    if (sel res_paths.err) { ret err[outcome.Fail].err{outcome.refused(res_paths.err)}; }
    val paths: **u8 = res_paths.ok;
    var i: u32 = 0;
    for (i < len) {
        val mid: session.ModuleId = p.topo[i];
        val m: *driver.ModuleEntry = ?p.modules[mid::u32];
        val destination: *publication.Destination = destinations[i];
        val copied: res[str, A.Error] = str_dup(p.alloc, destination.path);
        if (sel copied.err) {
            free_paths(p.alloc, paths, i, len);
            ret err[outcome.Fail].err{outcome.refused(copied.err)};
        }
        paths[i] = copied.ok;
        val t_item: readout.Instant = readout.item_begin(p.events);
        val emitted: err[fail.Fail] = obj.emit_image(?images[mid::u32], ?p.target, destination);
        if (sel emitted.err) {
            free_paths(p.alloc, paths, i + 1, len);
            ret err[outcome.Fail].err{outcome.from_fail(emitted.err)};
        }
        readout.item(p.events, readout.PH_EMIT, driver.fqn_name(p, m.fqn), t_item);
        i = i + 1;
    }
    @paths_out = paths;
    ret err[outcome.Fail].ok{};
}

pub fun mirror_fqn(a: *A.Allocator, base: *u8, fqn: str, suffix: str) res[str, outcome.Fail] {
    val rel_r: res[str, string.StrError] = str_replace(a, fqn, ".", "/");
    if (sel rel_r.err) { ret res[str, outcome.Fail].err{outcome.environment(outcome.str_text(rel_r.err))}; }
    val rel: str = rel_r.ok;
    fin { str_free(a, rel); }
    val leaf_r: res[str, string.StrError] = str_join(a, rel, ".", suffix);
    if (sel leaf_r.err) { ret res[str, outcome.Fail].err{outcome.environment(outcome.str_text(leaf_r.err))}; }
    val leaf: str = leaf_r.ok;
    fin { str_free(a, leaf); }
    val join_r: res[path.Path, A.Error] = path.join(a, base::str, leaf);
    if (sel join_r.err) { ret res[str, outcome.Fail].err{outcome.refused(join_r.err)}; }
    ret res[str, outcome.Fail].ok{join_r.ok};
}

pub fun free_paths(a: *A.Allocator, paths: **u8, n: u32, cap: u32) {
    if (paths == nil) { ret; }
    var i: u32 = 0;
    for (i < n) {
        if (paths[i] != nil) { A.deallocate[u8](a, paths[i], (str_len(paths[i]::str) + 1)::usize); }
        i = i + 1;
    }
    if (cap > 0) { A.deallocate[*u8](a, paths, cap::usize); }
}
