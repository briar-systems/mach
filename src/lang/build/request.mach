use mach.lang.me.pass;
use mach.lang.me.pipeline;
use catalog_subsystem: mach.lang.target.catalog.subsystem;
use mach.lang.wire;

# a binary profile lever as the command line sets it
pub def Lever: u8;

# neither `--key` nor `--no-key` was given: the profile decides
pub val LEVER_PROFILE: Lever = 0;
# `--key`
pub val LEVER_ON: Lever = 1;
# `--no-key`
pub val LEVER_OFF: Lever = 2;

# the typed options of a build-shaped command
# ---
# selectors: the `-a`, `-t` and `-p` patterns and `--all`
# work:      the `-w` work directory, nil when absent
# optimize:  `--optimize` or `--no-optimize`
# debug:     `--debug` or `--no-debug`
# simd:      the `--simd` value, nil when absent
# pass:      the `--pass` names, each added to the pass set
# skip:      the `--skip` names, each left out of it
# relax:     the `--relax` names, each permitted
# unrelax:   the `--no-relax` names, each withdrawn
# jobs:      the `--jobs` count, 0 when absent
pub rec CliArgs {
    verbosity:    u8;
    quiet:        bool;
    selectors:    manifest.Selectors;
    output:       *u8;
    work:         *u8;
    emit_asm:     bool;
    emit_ir:      bool;
    emit_ir_form: *u8;
    pie:          bool;
    subsystem:    *u8;
    optimize:     Lever;
    debug:        Lever;
    simd:         *u8;
    pass:         Vector[str];
    skip:         Vector[str];
    relax:        Vector[str];
    unrelax:      Vector[str];
    jobs:         u32;
    include_deps: bool;
    no_cache:     bool;
    link_tokens:  Vector[*u8];
    lib_dirs:     Vector[*u8];
}

pub def SubsystemFlag: u8;

val     SUBSYSTEM_FLAG_NONE:    SubsystemFlag = 0;
pub val SUBSYSTEM_FLAG_CONSOLE: SubsystemFlag = 1;
val     SUBSYSTEM_FLAG_GUI:     SubsystemFlag = 2;

rec SubsystemFlagSpec {
    flag:            SubsystemFlag;
    resolved:        catalog_subsystem.Subsystem;
    fingerprint_tag: u8;
}

val SUBSYSTEM_FLAG_N: usize                               = 2;
val SUBSYSTEM_FLAGS:  [SUBSYSTEM_FLAG_N]SubsystemFlagSpec = [SUBSYSTEM_FLAG_N]SubsystemFlagSpec{
    SubsystemFlagSpec{flag: SUBSYSTEM_FLAG_CONSOLE, resolved: catalog_subsystem.CONSOLE, fingerprint_tag: 1},
    SubsystemFlagSpec{flag: SUBSYSTEM_FLAG_GUI, resolved: catalog_subsystem.GUI, fingerprint_tag: 2},
};

fun subsystem_flag_from_name(name: str) opt[SubsystemFlag] {
    val parsed: opt[catalog_subsystem.Subsystem] = catalog_subsystem.from_name(name);
    if (sel parsed.none) { ret opt[SubsystemFlag].none{}; }
    val s: catalog_subsystem.Subsystem = parsed.some;
    var i: usize                       = 0;
    for (i < SUBSYSTEM_FLAG_N) {
        if (SUBSYSTEM_FLAGS[i].resolved == s) { ret opt[SubsystemFlag].some{SUBSYSTEM_FLAGS[i].flag}; }
        i = i + 1;
    }
    ret opt[SubsystemFlag].none{};
}

pub fun subsystem_from_flag(f: SubsystemFlag) opt[catalog_subsystem.Subsystem] {
    var i: usize = 0;
    for (i < SUBSYSTEM_FLAG_N) {
        if (SUBSYSTEM_FLAGS[i].flag == f) { ret opt[catalog_subsystem.Subsystem].some{SUBSYSTEM_FLAGS[i].resolved}; }
        i = i + 1;
    }
    ret opt[catalog_subsystem.Subsystem].none{};
}

pub def BuildGoal: u8;

# the finished artifact of the unit's kind: an executable, a static archive or a shared library
pub val GOAL_ARTIFACT: BuildGoal = 0;

pub val GOAL_OBJECTS: BuildGoal = 1;

pub val GOAL_TESTS: BuildGoal = 2;

pub val GOAL_TEST_LIST: BuildGoal = 3;

# `mach check`: load, resolve and check the selected artifacts' reachable source
# through the frontend and stop; no step runs and no product is written
pub val GOAL_CHECK: BuildGoal = 4;

# verb:   what the readout calls working on a cell for this goal
# caches: a request from the command line reads and publishes the object cache
# unless `--no-cache` forces an uncached build
rec BuildGoalSpec {
    goal:            BuildGoal;
    display:         str;
    verb:            str;
    emit_name:       str;
    fingerprint_tag: u8;
    caches:          bool;
}

val BUILD_GOAL_CATALOG_VERSION: u8 = 1;

val BUILD_GOAL_N: usize                       = 5;
val BUILD_GOALS:  [BUILD_GOAL_N]BuildGoalSpec = [BUILD_GOAL_N]BuildGoalSpec{
    BuildGoalSpec{goal: GOAL_ARTIFACT, display: "artifact", verb: "building", emit_name: "exe", fingerprint_tag: 1, caches: true},
    BuildGoalSpec{goal: GOAL_OBJECTS, display: "objects", verb: "building", emit_name: "obj", fingerprint_tag: 2, caches: true},
    BuildGoalSpec{goal: GOAL_TESTS, display: "tests", verb: "building", emit_name: "", fingerprint_tag: 3, caches: true},
    BuildGoalSpec{goal: GOAL_TEST_LIST, display: "test list", verb: "building", emit_name: "", fingerprint_tag: 4, caches: true},
    BuildGoalSpec{goal: GOAL_CHECK, display: "check", verb: "checking", emit_name: "", fingerprint_tag: 5, caches: false},
};

pub val EMIT_HELP: str = "obj | exe (default exe; obj stops at the objects)";

pub val EMIT_ERROR: str = "--emit expects 'obj' or 'exe'";

# reached only by mach-lsp
pub rec LinkToken {
    text: str;
}

# owner: "" for a cell of the root manifest, or the id of the closure dependency
#        whose export library requires the cell; `target` and
#        `artifact` then name that dependency's declarations
pub rec BuildRequest {
    project_root: str;
    owner:        str;

    target:   str;
    profile:  str;
    artifact: str;

    goal: BuildGoal;

    opt: u8;
    # the optimization passes run above `opt`'s set and those left out of it
    passes: pipeline.PassSet;
    skips:  pipeline.PassSet;
    relax:  pass.Relax;
    # the command line changed a lever of the selected profile, so a build that
    # publishes artifacts must say where: presentation only, no part of any hash
    overrides:      bool;
    debug:          bool;
    pie:            bool;
    subsystem_flag: SubsystemFlag;
    subsystem:      catalog_subsystem.Subsystem;
    simd:           manifest.SimdMode;
    # the warning kinds the profile silences: presentation only, so no part of the request hash
    allow: diagnostic_kind.KindSet;
    jobs:  u32;

    emit_ir:  bool;
    ir_form:  ir_printer.IrForm;
    emit_asm: bool;
    out:      str;
    # `-w`, the root manifest's work directory in place of its `[project].work`;
    # "" for none
    work: str;

    link_tokens: Vector[LinkToken];
    lib_dirs:    Vector[str];

    include_deps: bool;
    no_cache:     bool;
    object_cache: bool;
    # a test run's selection: the tests whose qualified name contains it, all when empty.
    # it shapes the dispatcher and never an object
    test_filter: str;
}

pub fun defaults() BuildRequest {
    var r: BuildRequest;
    r.project_root     = "";
    r.owner            = "";
    r.target           = "";
    r.profile          = "";
    r.artifact         = "";
    r.goal             = GOAL_ARTIFACT;
    r.opt              = pipeline.OPT_DEBUG;
    r.debug            = false;
    r.pie              = false;
    r.subsystem_flag   = SUBSYSTEM_FLAG_NONE;
    r.subsystem        = catalog_subsystem.CONSOLE;
    r.simd             = manifest.SIMD_SCALARIZE;
    r.passes           = pipeline.set_empty();
    r.skips            = pipeline.set_empty();
    r.relax            = pass.RELAX_NONE;
    r.overrides        = false;
    r.allow            = diagnostic_kind.set_empty();
    r.jobs             = 0;
    r.emit_ir          = false;
    r.ir_form          = ir_printer.IR_FORM_DEBUG;
    r.emit_asm         = false;
    r.out              = "";
    r.work             = "";
    r.link_tokens.a    = nil;
    r.link_tokens.data = nil;
    r.link_tokens.len  = 0;
    r.link_tokens.cap  = 0;
    r.lib_dirs.a       = nil;
    r.lib_dirs.data    = nil;
    r.lib_dirs.len     = 0;
    r.lib_dirs.cap     = 0;
    r.include_deps     = false;
    r.test_filter      = "";
    r.no_cache         = false;
    r.object_cache     = false;
    ret r;
}

pub fun test_goal(g: BuildGoal) bool {
    ret g == GOAL_TESTS || g == GOAL_TEST_LIST;
}

pub fun goal_from_emit_name(name: str) opt[BuildGoal] {
    var i: usize = 0;
    for (i < BUILD_GOAL_N) {
        if (!str_empty(BUILD_GOALS[i].emit_name) && str_equals(BUILD_GOALS[i].emit_name, name)) {
            ret opt[BuildGoal].some{BUILD_GOALS[i].goal};
        }
        i = i + 1;
    }
    ret opt[BuildGoal].none{};
}

pub fun goal_name(goal: BuildGoal) str {
    val spec: *BuildGoalSpec = goal_spec(goal);
    if (spec == nil) { ret "unknown"; }
    ret spec.display;
}

pub fun goal_verb(goal: BuildGoal) str {
    val spec: *BuildGoalSpec = goal_spec(goal);
    if (spec == nil) { ret "building"; }
    ret spec.verb;
}

pub fun validate(a: *A.Allocator, r: *BuildRequest) err[fail.Fail] {
    if (goal_spec(r.goal) == nil) {
        ret err[fail.Fail].err{fail.unknown_catalog(a, "BuildGoal", r.goal::u32)};
    }
    if (r.opt != pipeline.OPT_DEBUG && r.opt != pipeline.OPT_RELEASE) {
        ret err[fail.Fail].err{fail.unknown_catalog(a, "OptLevel", r.opt::u32)};
    }
    if (r.simd != manifest.SIMD_SCALARIZE && r.simd != manifest.SIMD_REQUIRE) {
        ret err[fail.Fail].err{fail.unknown_catalog(a, "SimdMode", r.simd::u32)};
    }
    val subsystem_from_flag_r: opt[catalog_subsystem.Subsystem] = subsystem_from_flag(r.subsystem_flag);
    if (r.subsystem_flag != SUBSYSTEM_FLAG_NONE && sel subsystem_from_flag_r.none) {
        ret err[fail.Fail].err{fail.unknown_catalog(a, "SubsystemFlag", r.subsystem_flag::u32)};
    }
    if (catalog_subsystem.fingerprint_tag(r.subsystem) == 0) {
        ret err[fail.Fail].err{fail.unknown_catalog(a, "Subsystem", r.subsystem::u32)};
    }
    ret err[fail.Fail].ok{};
}

pub fun release(r: *BuildRequest) bool {
    ret r.opt == pipeline.OPT_RELEASE;
}

pub fun compose(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest,
    cli: *CliArgs, root: str, goal: BuildGoal, profile: str) res[BuildRequest, fail.Fail] {
    var r: BuildRequest = defaults();
    r.project_root = root;
    r.goal         = goal;
    val valid: err[fail.Fail] = validate(a, ?r);
    if (sel valid.err) {
        ret res[BuildRequest, fail.Fail].err{valid.err};
    }

    r.profile = profile;

    val pr_r: res[manifest.ResolvedProfile, fail.Fail] = manifest.resolve_profile(a, itn, m, profile);
    if (sel pr_r.err) {
        ret res[BuildRequest, fail.Fail].err{pr_r.err};
    }
    val pf: manifest.ResolvedProfile = pr_r.ok;

    val checked: err[fail.Fail] = profiles_check(a, itn, m);
    if (sel checked.err) { ret res[BuildRequest, fail.Fail].err{checked.err}; }
    val levers: err[fail.Fail] = levers_compose(a, itn, ?pf, cli, ?r);
    if (sel levers.err) { ret res[BuildRequest, fail.Fail].err{levers.err}; }
    r.pie = cli.pie;

    if (cli.subsystem != nil) {
        val ss:   str                = cli.subsystem::str;
        val flag: opt[SubsystemFlag] = subsystem_flag_from_name(ss);
        if (sel flag.none) {
            ret res[BuildRequest, fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_VALUE, "--subsystem expects \"console\" or \"gui\"")};
        }
        r.subsystem_flag = flag.some;
    }

    r.allow = pf.allow;

    r.jobs = workers(cli.jobs);

    r.emit_ir = cli.emit_ir;
    if (cli.emit_ir_form != nil) {
        val form: opt[ir_printer.IrForm] = ir_printer.ir_form_from_name(cli.emit_ir_form::str);
        if (sel form.none) {
            ret res[BuildRequest, fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_VALUE, ir_printer.IR_FORM_ERROR)};
        }
        r.ir_form = form.some;
    }
    r.emit_asm = cli.emit_asm;
    if (cli.output != nil) { r.out = cli.output::str; }
    if (cli.work != nil)   { r.work = cli.work::str; }

    r.link_tokens = collections_vector.init[LinkToken](a);
    var ti: usize = 0;
    for (ti < cli.link_tokens.len) {
        var t: LinkToken;
        t.text = cli.link_tokens.data[ti]::str;
        val pr: res[usize, A.Error] = collections_vector.push[LinkToken](?r.link_tokens, t);
        if (sel pr.err) {
            ret res[BuildRequest, fail.Fail].err{fail.message("out of memory")};
        }
        ti = ti + 1;
    }
    r.lib_dirs = collections_vector.init[str](a);
    var di: usize = 0;
    for (di < cli.lib_dirs.len) {
        val dr: res[usize, A.Error] = collections_vector.push[str](?r.lib_dirs, cli.lib_dirs.data[di]::str);
        if (sel dr.err) {
            ret res[BuildRequest, fail.Fail].err{fail.message("out of memory")};
        }
        di = di + 1;
    }

    r.include_deps = cli.include_deps;
    r.no_cache     = cli.no_cache;
    r.object_cache = goal_caches(goal) && !cli.no_cache;
    ret res[BuildRequest, fail.Fail].ok{r};
}

# the levers of the selected profile `pf`, then the command line's over them,
# into `r`: built-in defaults, then the profile, then the command line
fun levers_compose(a: *A.Allocator, itn: *intern.Interner, pf: *manifest.ResolvedProfile, cli: *CliArgs, r: *BuildRequest) err[fail.Fail] {
    if (pf.optimize) { r.opt = pipeline.OPT_RELEASE; }
    r.debug = pf.debug;
    r.simd  = pf.simd;
    val passes: res[pipeline.PassSet, fail.Fail] = profile_passes(a, itn, pf.name, ?pf.pass, "pass");
    if (sel passes.err) { ret err[fail.Fail].err{passes.err}; }
    r.passes = passes.ok;
    val skips: res[pipeline.PassSet, fail.Fail] = profile_passes(a, itn, pf.name, ?pf.skip, "skip");
    if (sel skips.err) { ret err[fail.Fail].err{skips.err}; }
    r.skips = skips.ok;
    val relax: res[pass.Relax, fail.Fail] = profile_relax(a, itn, pf.name, ?pf.relax);
    if (sel relax.err) { ret err[fail.Fail].err{relax.err}; }
    r.relax = relax.ok;

    val profiled: BuildRequest = @r;
    if (cli.optimize == LEVER_ON)  { r.opt = pipeline.OPT_RELEASE; }
    if (cli.optimize == LEVER_OFF) { r.opt = pipeline.OPT_DEBUG; }
    if (cli.debug == LEVER_ON)     { r.debug = true; }
    if (cli.debug == LEVER_OFF)    { r.debug = false; }
    if (cli.simd != nil) {
        val mode: opt[manifest.SimdMode] = manifest.simd_named(cli.simd::str);
        if (sel mode.none) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.CLI_FLAG_VALUE, "--simd expects \"scalarize\" or \"require\"")};
        }
        r.simd = mode.some;
    }
    var i: usize = 0;
    for (i < cli.pass.len) {
        val at: res[usize, fail.Fail] = cli_pass(a, cli.pass.data[i], "--pass", ?cli.skip, "--skip");
        if (sel at.err) { ret err[fail.Fail].err{at.err}; }
        pipeline.set_add(?r.passes, at.ok);
        pipeline.set_remove(?r.skips, at.ok);
        i = i + 1;
    }
    i = 0;
    for (i < cli.skip.len) {
        val at: res[usize, fail.Fail] = cli_pass(a, cli.skip.data[i], "--skip", ?cli.pass, "--pass");
        if (sel at.err) { ret err[fail.Fail].err{at.err}; }
        pipeline.set_add(?r.skips, at.ok);
        pipeline.set_remove(?r.passes, at.ok);
        i = i + 1;
    }
    i = 0;
    for (i < cli.relax.len) {
        val bit: res[pass.Relax, fail.Fail] = cli_relax(a, cli.relax.data[i], "--relax", ?cli.unrelax, "--no-relax");
        if (sel bit.err) { ret err[fail.Fail].err{bit.err}; }
        r.relax = r.relax | bit.ok;
        i       = i + 1;
    }
    i = 0;
    for (i < cli.unrelax.len) {
        val bit: res[pass.Relax, fail.Fail] = cli_relax(a, cli.unrelax.data[i], "--no-relax", ?cli.relax, "--relax");
        if (sel bit.err) { ret err[fail.Fail].err{bit.err}; }
        r.relax = r.relax & ~bit.ok;
        i       = i + 1;
    }
    r.overrides = r.opt != profiled.opt || r.debug != profiled.debug || r.simd != profiled.simd
        || r.passes.bits != profiled.passes.bits || r.skips.bits != profiled.skips.bits || r.relax != profiled.relax;
    ret err[fail.Fail].ok{};
}

# every profile's set keys name what their catalogs hold, so a profile is
# refused where it is written whichever profile is selected
fun profiles_check(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest) err[fail.Fail] {
    var i: u32 = 0;
    for (i < m.profile_count) {
        val pf: *manifest.ProfileDef = ?m.profiles[i];
        i = i + 1;
        val passes: res[pipeline.PassSet, fail.Fail] = profile_passes(a, itn, pf.name, ?pf.pass, "pass");
        if (sel passes.err) { ret err[fail.Fail].err{passes.err}; }
        val skips: res[pipeline.PassSet, fail.Fail] = profile_passes(a, itn, pf.name, ?pf.skip, "skip");
        if (sel skips.err) { ret err[fail.Fail].err{skips.err}; }
        val relax: res[pass.Relax, fail.Fail] = profile_relax(a, itn, pf.name, ?pf.relax);
        if (sel relax.err) { ret err[fail.Fail].err{relax.err}; }
    }
    ret err[fail.Fail].ok{};
}

# the optimization passes a profile's `key` lists, each refused where it is
# written when the schedule runs no such pass or runs it in every build
fun profile_passes(a: *A.Allocator, itn: *intern.Interner, profile: intern.StrId, names: *manifest.NameList, key: str) res[pipeline.PassSet, fail.Fail] {
    var set: pipeline.PassSet = pipeline.set_empty();
    if (names.count == 0) { ret res[pipeline.PassSet, fail.Fail].ok{set}; }
    val what: res[str, fail.Fail] = fail.format(a, "mach.toml: [profile.{}].{}", intern.text(itn, profile), key);
    if (sel what.err) { ret res[pipeline.PassSet, fail.Fail].err{what.err}; }
    var i: u32 = 0;
    for (i < names.count) {
        val name: str                   = intern.text(itn, names.items[i]);
        val at:   res[usize, fail.Fail] = optimization_pass(a, name, what.ok);
        if (sel at.err) { ret res[pipeline.PassSet, fail.Fail].err{fail.at(a, at.err, names.sites[i])}; }
        pipeline.set_add(?set, at.ok);
        i = i + 1;
    }
    ret res[pipeline.PassSet, fail.Fail].ok{set};
}

# the permissions a profile's `relax` lists, each refused where it is written
# when no such permission exists
fun profile_relax(a: *A.Allocator, itn: *intern.Interner, profile: intern.StrId, names: *manifest.NameList) res[pass.Relax, fail.Fail] {
    var bits: pass.Relax = pass.RELAX_NONE;
    if (names.count == 0) { ret res[pass.Relax, fail.Fail].ok{bits}; }
    val what: res[str, fail.Fail] = fail.format(a, "mach.toml: [profile.{}].relax", intern.text(itn, profile));
    if (sel what.err) { ret res[pass.Relax, fail.Fail].err{what.err}; }
    var i: u32 = 0;
    for (i < names.count) {
        val bit: res[pass.Relax, fail.Fail] = relaxation(a, intern.text(itn, names.items[i]), what.ok);
        if (sel bit.err) { ret res[pass.Relax, fail.Fail].err{fail.at(a, bit.err, names.sites[i])}; }
        bits = bits | bit.ok;
        i    = i + 1;
    }
    ret res[pass.Relax, fail.Fail].ok{bits};
}

# the index of the optimization pass `name`, which `what` names; a legalization
# pass is refused, since every build runs it
fun optimization_pass(a: *A.Allocator, name: str, what: str) res[usize, fail.Fail] {
    val at: opt[usize] = pipeline.pass_named(name);
    if (sel at.none) {
        ret res[usize, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.MANIFEST_INVALID_VALUE,
            "{} names \"{}\", which is no pass; `mach info passes` lists them", what, name)};
    }
    if (pipeline.pass_at(at.some).class != pass.CLASS_OPTIMIZATION) {
        ret res[usize, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.MANIFEST_INVALID_VALUE,
            "{} names \"{}\", a legalization pass, which every build runs and none can add or skip", what, name)};
    }
    ret res[usize, fail.Fail].ok{at.some};
}

# the permission `name`, which `what` names
fun relaxation(a: *A.Allocator, name: str, what: str) res[pass.Relax, fail.Fail] {
    val bit: opt[pass.Relax] = pass.relax_named(name);
    if (sel bit.some) { ret res[pass.Relax, fail.Fail].ok{bit.some}; }
    var names: str   = "";
    var i:     usize = 0;
    for (i < pass.relax_count()) {
        var longer: res[str, fail.Fail];
        if (i == 0)         { longer = fail.format(a, "\"{}\"", pass.relax_name_at(i)); }
        or                  { longer = fail.format(a, "{}, \"{}\"", names, pass.relax_name_at(i)); }
        if (sel longer.err) { ret res[pass.Relax, fail.Fail].err{longer.err}; }
        names = longer.ok;
        i     = i + 1;
    }
    ret res[pass.Relax, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.MANIFEST_INVALID_VALUE,
        "{} names \"{}\", which is no relaxation; the relaxations are {}", what, name, names)};
}

# the index of the pass a command-line set flag names; one the opposite flag
# names too is refused
fun cli_pass(a: *A.Allocator, name: str, flag: str, other: *Vector[str], other_flag: str) res[usize, fail.Fail] {
    val clash: err[fail.Fail] = cli_unclashed(a, name, flag, other, other_flag);
    if (sel clash.err) { ret res[usize, fail.Fail].err{clash.err}; }
    val at: res[usize, fail.Fail] = optimization_pass(a, name, flag);
    if (sel at.err) { ret res[usize, fail.Fail].err{retagged(at.err)}; }
    ret at;
}

# the permission a command-line relax flag names; one the opposite flag names
# too is refused
fun cli_relax(a: *A.Allocator, name: str, flag: str, other: *Vector[str], other_flag: str) res[pass.Relax, fail.Fail] {
    val clash: err[fail.Fail] = cli_unclashed(a, name, flag, other, other_flag);
    if (sel clash.err) { ret res[pass.Relax, fail.Fail].err{clash.err}; }
    val bit: res[pass.Relax, fail.Fail] = relaxation(a, name, flag);
    if (sel bit.err) { ret res[pass.Relax, fail.Fail].err{retagged(bit.err)}; }
    ret bit;
}

# a manifest-shaped refusal of a command-line value, reported as one
fun retagged(f: fail.Fail) fail.Fail {
    if (fail.kind_of(f) != diagnostic_kind.MANIFEST_INVALID_VALUE) { ret f; }
    val text: opt[str] = fail.text(f);
    if (sel text.none) { ret f; }
    ret fail.user(diagnostic_kind.CLI_FLAG_VALUE, text.some);
}

fun cli_unclashed(a: *A.Allocator, name: str, flag: str, other: *Vector[str], other_flag: str) err[fail.Fail] {
    var i: usize = 0;
    for (i < other.len) {
        if (str_equals(other.data[i], name)) {
            ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLI_FLAG_CONFLICT, "{} {} and {} {} cannot be combined", flag, name, other_flag, name)};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# `work`, a `-w` value, in place of the root manifest `m`'s `[project].work`: a
# canonical path inside the project root, taken as written
pub fun work_apply(itn: *intern.Interner, work: str, m: *manifest.Manifest) err[fail.Fail] {
    if (!manifest.is_project_path(work) || str_contains(work, "{")) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.CLI_OUTPUT_PATH, WORK_CONSTRAINT)};
    }
    val id: res[intern.StrId, A.Error] = intern.add(itn, work);
    if (sel id.err) { ret err[fail.Fail].err{fail.refused(id.err)}; }
    m.work_tmpl = id.ok;
    ret err[fail.Fail].ok{};
}

# the rule `-w` keeps
val WORK_CONSTRAINT: str = "-w must name a canonical path inside the project root: relative, with no . or .. component and no template";

# `r`'s `-w` over the root manifest `m` it is built from, nothing when it names none
pub fun request_work_apply(itn: *intern.Interner, r: *BuildRequest, m: *manifest.Manifest) err[fail.Fail] {
    if (str_empty(r.work)) { ret err[fail.Fail].ok{}; }
    ret work_apply(itn, r.work, m);
}

pub fun for_cell(base: *BuildRequest, owner: str, target: str, artifact: str,
    subsystem: catalog_subsystem.Subsystem, goal: BuildGoal) BuildRequest {
    var r: BuildRequest = @base;
    r.owner     = owner;
    r.target    = target;
    r.artifact  = artifact;
    r.subsystem = subsystem;
    r.goal      = goal;
    ret r;
}

# the workers a run uses: the `--jobs` count, or the host's processor count when none was given
# ---
# asked: the count, 0 when none was given
# ret:   at least 1
pub fun workers(asked: u32) u32 {
    if (asked > 0) { ret asked; }
    val nc: i64 = system_os.cpu_count();
    if (nc > 1) { ret nc::u32; }
    ret 1;
}

pub val HASH_SIZE: usize = 32;

fun write_semantic_fields(s: *wire.Sink, r: *BuildRequest) {
    put_text(s, r.project_root);
    put_text(s, r.owner);
    put_text(s, r.target);
    put_text(s, r.profile);
    put_text(s, r.artifact);
    write_goal(s, r.goal);
    wire.put_u8(s, r.opt);
    wire.put_u64(s, r.passes.bits);
    wire.put_u64(s, r.skips.bits);
    wire.put_u32(s, r.relax);
    put_flag(s, r.debug);
    put_flag(s, r.pie);
    wire.put_u8(s, r.simd);
    put_flag(s, r.include_deps);
}

fun goal_spec(goal: BuildGoal) *BuildGoalSpec {
    var i: usize = 0;
    for (i < BUILD_GOAL_N) {
        if (BUILD_GOALS[i].goal == goal) { ret ?BUILD_GOALS[i]; }
        i = i + 1;
    }
    ret nil;
}

fun goal_caches(goal: BuildGoal) bool {
    val spec: *BuildGoalSpec = goal_spec(goal);
    ret spec != nil && spec.caches;
}

fun write_goal(s: *wire.Sink, goal: BuildGoal) {
    val spec: *BuildGoalSpec = goal_spec(goal);
    if (spec == nil) {
        wire.refuse(s, fail.message("build request names an unknown goal"));
        ret;
    }
    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_BUILD_GOAL, BUILD_GOAL_CATALOG_VERSION, spec.fingerprint_tag);
}

#[testing]
fun write_request_extra(s: *wire.Sink, r: *BuildRequest) {
    wire.put_u32(s, r.jobs);
    put_flag(s, r.emit_ir);
    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_IR_FORM,
        ir_printer.IR_FORM_CATALOG_VERSION, ir_printer.ir_form_fingerprint_tag(r.ir_form));
    put_flag(s, r.emit_asm);
    put_flag(s, r.no_cache);
    put_flag(s, r.object_cache);
    put_text(s, r.out);
    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_SUBSYSTEM,
        catalog_subsystem.VERSION, catalog_subsystem.fingerprint_tag(r.subsystem));
    wire.put_u32(s, r.link_tokens.len::u32);
    var ti: usize = 0;
    for (ti < r.link_tokens.len) {
        put_text(s, r.link_tokens.data[ti].text);
        ti = ti + 1;
    }
    wire.put_u32(s, r.lib_dirs.len::u32);
    var di: usize = 0;
    for (di < r.lib_dirs.len) {
        put_text(s, r.lib_dirs.data[di]);
        di = di + 1;
    }
}

# the sha-256 of what the sink holds, or its failure; releases the sink
fun digest_of(s: *wire.Sink, digest: *u8) err[fail.Fail] {
    val failed: opt[fail.Fail] = wire.failure(s);
    if (sel failed.some) {
        wire.dnit(s);
        ret err[fail.Fail].err{failed.some};
    }
    sha256.hash(wire.bytes(s), s.len, digest);
    wire.dnit(s);
    ret err[fail.Fail].ok{};
}

#[testing]
fun request_hash(a: *A.Allocator, r: *BuildRequest, digest: *u8) err[fail.Fail] {
    val valid: err[fail.Fail] = validate(a, r);
    if (sel valid.err) {
        ret err[fail.Fail].err{valid.err};
    }
    var s: wire.Sink = wire.grown(a);
    write_semantic_fields(?s, r);
    write_request_extra(?s, r);
    ret digest_of(?s, digest);
}

pub fun semantic_hash(a: *A.Allocator, r: *BuildRequest, digest: *u8) err[fail.Fail] {
    val valid: err[fail.Fail] = validate(a, r);
    if (sel valid.err) {
        ret err[fail.Fail].err{valid.err};
    }
    var s: wire.Sink = wire.grown(a);
    write_semantic_fields(?s, r);
    ret digest_of(?s, digest);
}

# a text as its u32 length then its bytes
fun put_text(s: *wire.Sink, text: str) {
    wire.put_sized(s, text::*u8, str_len(text));
}

fun put_flag(s: *wire.Sink, v: bool) {
    var b: u8 = 0;
    if (v) { b = 1; }
    wire.put_u8(s, b);
}

test build_goal_catalog__is_complete_unique_ordered_and_round_trips {
    if (BUILD_GOAL_CATALOG_VERSION != 1)       { ret 1; }
    if (BUILD_GOAL_N != GOAL_CHECK::usize + 1) { ret 1; }

    var seen: [BUILD_GOAL_N]bool;
    var i:    usize = 0;
    for (i < BUILD_GOAL_N) {
        seen[i] = false;
        i       = i + 1;
    }

    var emit_count: usize = 0;
    i = 0;
    for (i < BUILD_GOAL_N) {
        val spec: *BuildGoalSpec = ?BUILD_GOALS[i];
        if (spec.goal::usize >= BUILD_GOAL_N)                { ret 1; }
        if (seen[spec.goal::usize])                          { ret 1; }
        if (str_empty(spec.display))                         { ret 1; }
        if (str_empty(spec.verb))                            { ret 1; }
        if (!str_equals(goal_verb(spec.goal), spec.verb))    { ret 1; }
        if (spec.fingerprint_tag != (i + 1)::u8)             { ret 1; }
        if (!str_equals(goal_name(spec.goal), spec.display)) { ret 1; }
        seen[spec.goal::usize] = true;

        var j: usize = 0;
        for (j < i) {
            val prior: *BuildGoalSpec = ?BUILD_GOALS[j];
            if (prior.goal == spec.goal)                       { ret 1; }
            if (prior.fingerprint_tag == spec.fingerprint_tag) { ret 1; }
            if (str_equals(prior.display, spec.display))       { ret 1; }
            if (!str_empty(spec.emit_name)
                && str_equals(prior.emit_name, spec.emit_name)) { ret 1; }
            j = j + 1;
        }

        if (!str_empty(spec.emit_name)) {
            val parsed: opt[BuildGoal] = goal_from_emit_name(spec.emit_name);
            if (sel parsed.none)                           { ret 1; }
            if (parsed.some != spec.goal)                  { ret 1; }
            if (!str_contains(EMIT_HELP, spec.emit_name))  { ret 1; }
            if (!str_contains(EMIT_ERROR, spec.emit_name)) { ret 1; }
            emit_count = emit_count + 1;
        }
        i = i + 1;
    }

    if (emit_count != 2) { ret 1; }
    val goal_from_emit_name_r: opt[BuildGoal] = goal_from_emit_name("tests");
    if (sel goal_from_emit_name_r.some) { ret 1; }
    val goal_from_emit_name_r2: opt[BuildGoal] = goal_from_emit_name("");
    if (sel goal_from_emit_name_r2.some)                   { ret 1; }
    if (!str_equals(goal_name(255::BuildGoal), "unknown")) { ret 1; }
    i = 0;
    for (i < BUILD_GOAL_N) {
        if (!seen[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test subsystem_flag_catalog__is_complete_unique_and_tracks_the_target_catalog {
    var seen: [SUBSYSTEM_FLAG_N]bool;
    var i:    usize = 0;
    for (i < SUBSYSTEM_FLAG_N) {
        seen[i] = false;
        i       = i + 1;
    }

    i = 0;
    for (i < SUBSYSTEM_FLAG_N) {
        val spec: *SubsystemFlagSpec = ?SUBSYSTEM_FLAGS[i];
        if (spec.flag == SUBSYSTEM_FLAG_NONE) { ret 1; }
        val slot: usize = spec.flag::usize - 1;
        if (slot >= SUBSYSTEM_FLAG_N) { ret 1; }
        if (seen[slot])               { ret 1; }
        seen[slot] = true;

        if (spec.fingerprint_tag != catalog_subsystem.fingerprint_tag(spec.resolved)) { ret 1; }

        var j: usize = 0;
        for (j < i) {
            val prior: *SubsystemFlagSpec = ?SUBSYSTEM_FLAGS[j];
            if (prior.flag == spec.flag)         { ret 1; }
            if (prior.resolved == spec.resolved) { ret 1; }
            j = j + 1;
        }

        val name:   str                = catalog_subsystem.name_for(spec.resolved);
        val parsed: opt[SubsystemFlag] = subsystem_flag_from_name(name);
        if (sel parsed.none)          { ret 1; }
        if (parsed.some != spec.flag) { ret 1; }

        val resolved: opt[catalog_subsystem.Subsystem] = subsystem_from_flag(spec.flag);
        if (sel resolved.none)              { ret 1; }
        if (resolved.some != spec.resolved) { ret 1; }
        i = i + 1;
    }

    val subsystem_flag_from_name_r: opt[SubsystemFlag] = subsystem_flag_from_name("");
    if (sel subsystem_flag_from_name_r.some) { ret 1; }
    val subsystem_flag_from_name_r2: opt[SubsystemFlag] = subsystem_flag_from_name("bogus");
    if (sel subsystem_flag_from_name_r2.some) { ret 1; }
    val subsystem_from_flag_r: opt[catalog_subsystem.Subsystem] = subsystem_from_flag(SUBSYSTEM_FLAG_NONE);
    if (sel subsystem_from_flag_r.some) { ret 1; }

    i = 0;
    for (i < SUBSYSTEM_FLAG_N) {
        if (!seen[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

#[testing]
fun dig_eq(a: *u8, b: *u8) bool {
    var i: usize = 0;
    for (i < HASH_SIZE) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# every build goal changes the semantic hash and every subsystem the request hash
test semantic_hash__distinguishes_every_goal_and_request_hash_every_subsystem {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var goals: [BUILD_GOAL_N][32]u8;
    var i:     usize = 0;
    for (i < BUILD_GOAL_N) {
        var req: BuildRequest = defaults();
        req.goal = BUILD_GOALS[i].goal;
        val hashed: err[fail.Fail] = semantic_hash(?alloc, ?req, ?goals[i][0]);
        if (sel hashed.err) { ret 2; }
        var j: usize = 0;
        for (j < i) {
            if (dig_eq(?goals[j][0], ?goals[i][0])) { ret 3; }
            j = j + 1;
        }
        i = i + 1;
    }

    var subsystems: [SUBSYSTEM_FLAG_N][32]u8;
    i = 0;
    for (i < SUBSYSTEM_FLAG_N) {
        var req: BuildRequest = defaults();
        req.subsystem = SUBSYSTEM_FLAGS[i].resolved;
        val hashed: err[fail.Fail] = request_hash(?alloc, ?req, ?subsystems[i][0]);
        if (sel hashed.err) { ret 4; }
        var j: usize = 0;
        for (j < i) {
            if (dig_eq(?subsystems[j][0], ?subsystems[i][0])) { ret 5; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test semantic_hash__omits_nonsemantic_fields {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var ra: BuildRequest = defaults();
    ra.project_root = "/tmp/p";
    ra.opt          = pipeline.OPT_DEBUG;

    var base:            [32]u8;
    val semantic_hash_r: err[fail.Fail] = semantic_hash(?alloc, ?ra, ?base[0]);
    if (sel semantic_hash_r.err) { ret 1; }

    var rb: BuildRequest = ra;
    rb.jobs = ra.jobs + 8;
    var d:                [32]u8;
    val semantic_hash_r2: err[fail.Fail] = semantic_hash(?alloc, ?rb, ?d[0]);
    if (sel semantic_hash_r2.err) { ret 1; }
    if (!dig_eq(?base[0], ?d[0])) { ret 1; }

    var rqa:            [32]u8;
    var rqb:            [32]u8;
    val request_hash_r: err[fail.Fail] = request_hash(?alloc, ?ra, ?rqa[0]);
    if (sel request_hash_r.err) { ret 1; }
    val request_hash_r2: err[fail.Fail] = request_hash(?alloc, ?rb, ?rqb[0]);
    if (sel request_hash_r2.err)  { ret 1; }
    if (dig_eq(?rqa[0], ?rqb[0])) { ret 1; }

    rb              = ra;
    rb.no_cache     = true;
    rb.object_cache = true;
    rb.emit_ir      = true;
    rb.emit_asm     = true;
    rb.out          = "/tmp/out.bin";
    val semantic_hash_r3: err[fail.Fail] = semantic_hash(?alloc, ?rb, ?d[0]);
    if (sel semantic_hash_r3.err) { ret 1; }
    if (!dig_eq(?base[0], ?d[0])) { ret 1; }

    rb           = ra;
    rb.subsystem = catalog_subsystem.GUI;
    val semantic_hash_r4: err[fail.Fail] = semantic_hash(?alloc, ?rb, ?d[0]);
    if (sel semantic_hash_r4.err) { ret 1; }
    if (!dig_eq(?base[0], ?d[0])) { ret 1; }
    val request_hash_r3: err[fail.Fail] = request_hash(?alloc, ?ra, ?rqa[0]);
    if (sel request_hash_r3.err) { ret 1; }
    val request_hash_r4: err[fail.Fail] = request_hash(?alloc, ?rb, ?rqb[0]);
    if (sel request_hash_r4.err)  { ret 1; }
    if (dig_eq(?rqa[0], ?rqb[0])) { ret 1; }

    rb     = ra;
    rb.opt = pipeline.OPT_RELEASE;
    val semantic_hash_r5: err[fail.Fail] = semantic_hash(?alloc, ?rb, ?d[0]);
    if (sel semantic_hash_r5.err) { ret 1; }
    if (dig_eq(?base[0], ?d[0]))  { ret 1; }

    rb     = ra;
    rb.pie = true;
    val semantic_hash_r6: err[fail.Fail] = semantic_hash(?alloc, ?rb, ?d[0]);
    if (sel semantic_hash_r6.err) { ret 1; }
    if (dig_eq(?base[0], ?d[0]))  { ret 1; }
    ret 0;
}

# command-line arguments that set no lever, their sets growable through `a`
#[testing]
fun t_cli_args(a: *A.Allocator) CliArgs {
    var cli: CliArgs;
    cli.pass    = collections_vector.init[str](a);
    cli.skip    = collections_vector.init[str](a);
    cli.relax   = collections_vector.init[str](a);
    cli.unrelax = collections_vector.init[str](a);
    ret cli;
}

# the profile's levers fill the request and each command-line lever wins over
# its profile's, and only a change marks the request as overriding the profile
test levers_compose__the_command_line_wins_over_the_profile {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var itn:   intern.Interner = intern.init(?a);
    var words: [4]str          = [4]str{"p", "inline", "vectorize", "float-reassoc"};
    var ids:   [4]intern.StrId;
    var i:     usize           = 0;
    for (i < 4) {
        val id: res[intern.StrId, A.Error] = intern.add(?itn, words[i]);
        if (sel id.err) { ret 2; }
        ids[i] = id.ok;
        i      = i + 1;
    }
    var sites: [3]fail.Place;
    var pf:    manifest.ResolvedProfile;
    pf.name     = ids[0];
    pf.optimize = false;
    pf.debug    = false;
    pf.simd     = manifest.SIMD_SCALARIZE;
    pf.pass     = manifest.NameList{items: ?ids[1], sites: ?sites[0], count: 1};
    pf.skip     = manifest.NameList{items: ?ids[2], sites: ?sites[1], count: 1};
    pf.relax    = manifest.NameList{items: ?ids[3], sites: ?sites[2], count: 1};
    val inline_at: opt[usize] = pipeline.pass_named("inline");
    val vector_at: opt[usize] = pipeline.pass_named("vectorize");
    if (sel inline_at.none) { ret 3; }
    if (sel vector_at.none) { ret 3; }

    var cli:         CliArgs        = t_cli_args(?a);
    var r:           BuildRequest   = defaults();
    val as_profiled: err[fail.Fail] = levers_compose(?a, ?itn, ?pf, ?cli, ?r);
    if (sel as_profiled.err)                                                                       { ret 4; }
    if (r.opt != pipeline.OPT_DEBUG || r.overrides || r.relax != pass.RELAX_FLOAT_REASSOC)         { ret 5; }
    if (!pipeline.set_has(r.passes, inline_at.some) || !pipeline.set_has(r.skips, vector_at.some)) { ret 6; }

    cli.optimize = LEVER_ON;
    cli.debug    = LEVER_ON;
    collections_vector.push[str](?cli.skip, "inline");
    collections_vector.push[str](?cli.unrelax, "float-reassoc");
    r = defaults();
    val overridden: err[fail.Fail] = levers_compose(?a, ?itn, ?pf, ?cli, ?r);
    if (sel overridden.err)                                                                       { ret 7; }
    if (r.opt != pipeline.OPT_RELEASE || !r.debug || !r.overrides || r.relax != pass.RELAX_NONE)  { ret 8; }
    if (pipeline.set_has(r.passes, inline_at.some) || !pipeline.set_has(r.skips, inline_at.some)) { ret 9; }

    var both: CliArgs = t_cli_args(?a);
    collections_vector.push[str](?both.pass, "licm");
    collections_vector.push[str](?both.skip, "licm");
    r = defaults();
    val clashed: err[fail.Fail] = levers_compose(?a, ?itn, ?pf, ?both, ?r);
    if (!(sel clashed.err && fail.kind_of(clashed.err) == diagnostic_kind.CLI_FLAG_CONFLICT)) { ret 10; }

    val legal: res[intern.StrId, A.Error] = intern.add(?itn, "vecsplit");
    if (sel legal.err) { ret 11; }
    ids[2] = legal.ok;
    var plain: CliArgs = t_cli_args(?a);
    r = defaults();
    val refused: err[fail.Fail] = levers_compose(?a, ?itn, ?pf, ?plain, ?r);
    if (!(sel refused.err && str_contains(fail.describe(refused.err), "[profile.p].skip names \"vecsplit\", a legalization pass"))) { ret 12; }
    ret 0;
}

test validate__unknown_catalog_members_never_hash_as_valid_requests {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var r:          BuildRequest   = defaults();
    val validate_r: err[fail.Fail] = validate(?a, ?r);
    if (sel validate_r.err) { ret 2; }
    val catalogs: [5]str = [5]str{"BuildGoal", "OptLevel", "SimdMode", "SubsystemFlag", "Subsystem"};
    var i:        usize  = 0;
    for (i < 5) {
        r = defaults();
        if (i == 0) { r.goal = 255; }
        or (i == 1) { r.opt = 255; }
        or (i == 2) { r.simd = 255; }
        or (i == 3) { r.subsystem_flag = 255; }
        or          { r.subsystem = 255; }
        val valid: err[fail.Fail] = validate(?a, ?r);
        if (sel valid.ok) { ret 3; }
        val f:       fail.Fail = valid.err;
        val correct: bool      = sel f.message && str_contains(fail.describe(f), catalogs[i])
            && str_contains(fail.describe(f), "255");
        fail.dnit(?a, f);
        if (!correct) { ret 4; }
        var digest: [HASH_SIZE]u8;
        digest[0] = 171;
        val full: err[fail.Fail] = request_hash(?a, ?r, ?digest[0]);
        if (sel full.ok) { ret 5; }
        val full_message: str  = fail.describe(full.err);
        val full_correct: bool = str_contains(full_message, catalogs[i]) && digest[0] == 171;
        str_free(?a, full_message);
        if (!full_correct) { ret 6; }
        val semantic: err[fail.Fail] = semantic_hash(?a, ?r, ?digest[0]);
        if (sel semantic.ok) { ret 7; }
        val semantic_message: str  = fail.describe(semantic.err);
        val semantic_correct: bool = str_contains(semantic_message, catalogs[i]) && digest[0] == 171;
        str_free(?a, semantic_message);
        if (!semantic_correct) { ret 8; }
        i = i + 1;
    }
    ret 0;
}
