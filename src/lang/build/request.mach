use std.types.result.res;
use std.types.option.opt;
use std.types.error.err;
use page: std.allocator.page;
use vector: std.collections.vector;
use std.collections.vector.Vector;
use std.crypto.hash.sha256;
use binary: std.encoding.binary;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_empty;
use std.types.string.str_ends_with;
use std.types.string.str_equals;
use std.types.string.str_len;
use path: std.types.path;
use std.text.string.str_free;

use A: std.allocator;
use sys: std.system.os;

use mach.lang.build.fingerprint;
use mach.lang.build.outcome;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.me.pipeline;
use mach.lang.target.of;

pub rec CliArgs {
    verbosity:   u8;
    quiet:       bool;
    target:      *u8;
    output:      *u8;
    emit_asm:    bool;
    emit_ir:     bool;
    profile:     *u8;
    bin:         *u8;
    lib:         *u8;
    all_targets: bool;
    pie:         bool;
    subsystem:   *u8;
    g:           bool;
    opt_set:      bool;
    opt_release:  bool;
    jobs:         *u8;
    include_deps: bool;
    no_cache:     bool;
    cache:        bool;
    link_tokens:  Vector[*u8];
    lib_dirs:     Vector[*u8];
}

pub fun is_object_path(tok: *u8) bool {
    if (tok == nil || str_empty(tok::str)) { ret false; }
    if (path.has_separator(tok::str))      { ret true; }
    ret str_ends_with(tok::str, ".o") || str_ends_with(tok::str, ".a")
        || ascii_suffix_equals(tok, ".obj"::*u8)
        || ascii_suffix_equals(tok, ".lib"::*u8)
        || ascii_suffix_equals(tok, ".dll"::*u8)
        || ascii_suffix_equals(tok, ".dylib"::*u8)
        || str_ends_with(tok::str, ".so") || str_contains(tok::str, ".so.");
}

fun ascii_suffix_equals(text: *u8, suffix: *u8) bool {
    val text_len: usize = str_len(text::str);
    val suffix_len: usize = str_len(suffix::str);
    if (text_len < suffix_len) { ret false; }

    val start: usize = text_len - suffix_len;
    var i: usize = 0;
    for (i < suffix_len) {
        var lhs: u8 = text[start + i];
        var rhs: u8 = suffix[i];
        if (lhs >= 'A' && lhs <= 'Z') { lhs = lhs + ('a' - 'A'); }
        if (rhs >= 'A' && rhs <= 'Z') { rhs = rhs + ('a' - 'A'); }
        if (lhs != rhs) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub def SubsystemFlag: u8;

pub val SUBSYSTEM_FLAG_NONE:    SubsystemFlag = 0;
pub val SUBSYSTEM_FLAG_CONSOLE: SubsystemFlag = 1;
pub val SUBSYSTEM_FLAG_GUI:     SubsystemFlag = 2;

rec SubsystemFlagSpec {
    flag:            SubsystemFlag;
    resolved:        of.Subsystem;
    fingerprint_tag: u8;
}

val SUBSYSTEM_FLAG_N: usize = 2;
val SUBSYSTEM_FLAGS: [SUBSYSTEM_FLAG_N]SubsystemFlagSpec = [SUBSYSTEM_FLAG_N]SubsystemFlagSpec{
    SubsystemFlagSpec{ flag: SUBSYSTEM_FLAG_CONSOLE, resolved: of.SUBSYSTEM_CONSOLE, fingerprint_tag: 1 },
    SubsystemFlagSpec{ flag: SUBSYSTEM_FLAG_GUI,     resolved: of.SUBSYSTEM_GUI,     fingerprint_tag: 2 },
};

pub fun subsystem_flag_from_name(name: str) opt[SubsystemFlag] {
    val parsed: opt[of.Subsystem] = of.subsystem_from_name(name);
    if (sel parsed.none) { ret opt[SubsystemFlag].none{}; }
    val s: of.Subsystem = parsed.some;
    var i: usize = 0;
    for (i < SUBSYSTEM_FLAG_N) {
        if (SUBSYSTEM_FLAGS[i].resolved == s) { ret opt[SubsystemFlag].some{SUBSYSTEM_FLAGS[i].flag}; }
        i = i + 1;
    }
    ret opt[SubsystemFlag].none{};
}

pub fun subsystem_from_flag(f: SubsystemFlag) opt[of.Subsystem] {
    var i: usize = 0;
    for (i < SUBSYSTEM_FLAG_N) {
        if (SUBSYSTEM_FLAGS[i].flag == f) { ret opt[of.Subsystem].some{SUBSYSTEM_FLAGS[i].resolved}; }
        i = i + 1;
    }
    ret opt[of.Subsystem].none{};
}

pub def BuildGoal: u8;

pub val GOAL_EXECUTE:   BuildGoal = 0;

pub val GOAL_OBJECTS:   BuildGoal = 1;

pub val GOAL_TESTS:     BuildGoal = 2;

pub val GOAL_TEST_LIST: BuildGoal = 3;

# `mach check`: load, resolve and check the selected artifacts' reachable source
# through the frontend and stop; no step runs and no product is written
pub val GOAL_CHECK: BuildGoal = 4;

rec BuildGoalSpec {
    goal:        BuildGoal;
    display:     str;
    emit_name:   str;
    fingerprint_tag: u8;
}

val BUILD_GOAL_CATALOG_VERSION: u8 = 1;

val BUILD_GOAL_N: usize = 5;
val BUILD_GOALS: [BUILD_GOAL_N]BuildGoalSpec = [BUILD_GOAL_N]BuildGoalSpec{
    BuildGoalSpec{ goal: GOAL_EXECUTE,   display: "executable", emit_name: "exe", fingerprint_tag: 1 },
    BuildGoalSpec{ goal: GOAL_OBJECTS,   display: "objects",    emit_name: "obj", fingerprint_tag: 2 },
    BuildGoalSpec{ goal: GOAL_TESTS,     display: "tests",      emit_name: "",    fingerprint_tag: 3 },
    BuildGoalSpec{ goal: GOAL_TEST_LIST, display: "test list",  emit_name: "",    fingerprint_tag: 4 },
    BuildGoalSpec{ goal: GOAL_CHECK,     display: "check",      emit_name: "",    fingerprint_tag: 5 },
};

pub val EMIT_HELP: str = "obj | exe (default exe; obj stops at the objects)";

pub val EMIT_ERROR: str = "--emit expects 'obj' or 'exe'";

pub rec LinkToken {
    text: str;
}

pub rec BuildRequest {
    project_root: str;

    target:       str;
    profile:      str;
    artifact:     str;
    want_lib:     bool;
    all_targets:  bool;

    goal:         BuildGoal;

    opt:          u8;
    debug:        bool;
    pie:          bool;
    subsystem_flag: SubsystemFlag;
    subsystem:      of.Subsystem;
    simd:          manifest.SimdMode;
    vectorize:     bool;
    float_reassoc: bool;
    jobs:         u32;
    placement_policy: u32;

    emit_ir:      bool;
    emit_asm:     bool;
    out:          str;

    link_tokens:  Vector[LinkToken];
    lib_dirs:     Vector[str];

    include_deps: bool;
    no_cache:     bool;
    object_cache: bool;
}

pub fun defaults() BuildRequest {
    var r: BuildRequest;
    r.project_root = "";
    r.target       = "";
    r.profile      = "";
    r.artifact     = "";
    r.want_lib     = false;
    r.all_targets  = false;
    r.goal         = GOAL_EXECUTE;
    r.opt          = pipeline.OPT_DEBUG;
    r.debug        = false;
    r.pie          = false;
    r.subsystem_flag = SUBSYSTEM_FLAG_NONE;
    r.subsystem      = of.SUBSYSTEM_CONSOLE;
    r.simd          = manifest.SIMD_SCALARIZE;
    r.vectorize     = true;
    r.float_reassoc = false;
    r.jobs         = 0;
    r.placement_policy = 0;
    r.emit_ir      = false;
    r.emit_asm     = false;
    r.out          = "";
    r.link_tokens.a    = nil;
    r.link_tokens.data = nil;
    r.link_tokens.len  = 0;
    r.link_tokens.cap  = 0;
    r.lib_dirs.a    = nil;
    r.lib_dirs.data = nil;
    r.lib_dirs.len  = 0;
    r.lib_dirs.cap  = 0;
    r.include_deps = false;
    r.no_cache = false;
    r.object_cache = false;
    ret r;
}

pub fun test_goal(g: BuildGoal) bool {
    ret g == GOAL_TESTS || g == GOAL_TEST_LIST;
}

pub fun goal_from_emit_name(name: str) opt[BuildGoal] {
    var i: usize = 0;
    for (i < BUILD_GOAL_N) {
        if (!str_empty(BUILD_GOALS[i].emit_name) && str_equals(BUILD_GOALS[i].emit_name, name)) {
            ret opt[BuildGoal].some{BUILD_GOALS[i].goal};
        }
        i = i + 1;
    }
    ret opt[BuildGoal].none{};
}

pub fun goal_name(goal: BuildGoal) str {
    val spec: *BuildGoalSpec = goal_spec(goal);
    if (spec == nil) { ret "unknown"; }
    ret spec.display;
}

pub fun validate(a: *A.Allocator, r: *BuildRequest) err[outcome.Fail] {
    if (goal_spec(r.goal) == nil) {
        ret err[outcome.Fail].err{outcome.unknown_catalog(a, "BuildGoal", r.goal::u32)};
    }
    if (r.opt != pipeline.OPT_DEBUG && r.opt != pipeline.OPT_RELEASE) {
        ret err[outcome.Fail].err{outcome.unknown_catalog(a, "OptLevel", r.opt::u32)};
    }
    if (r.simd != manifest.SIMD_SCALARIZE && r.simd != manifest.SIMD_REQUIRE) {
        ret err[outcome.Fail].err{outcome.unknown_catalog(a, "SimdMode", r.simd::u32)};
    }
    val subsystem_from_flag_r: opt[of.Subsystem] = subsystem_from_flag(r.subsystem_flag);
    if (r.subsystem_flag != SUBSYSTEM_FLAG_NONE && sel subsystem_from_flag_r.none) {
        ret err[outcome.Fail].err{outcome.unknown_catalog(a, "SubsystemFlag", r.subsystem_flag::u32)};
    }
    if (of.subsystem_fingerprint_tag(r.subsystem) == 0) {
        ret err[outcome.Fail].err{outcome.unknown_catalog(a, "Subsystem", r.subsystem::u32)};
    }
    ret err[outcome.Fail].ok{};
}

pub fun release(r: *BuildRequest) bool {
    ret r.opt == pipeline.OPT_RELEASE;
}

pub fun compose(a: *A.Allocator, itn: *intern.Interner, m: *manifest.Manifest,
                cli: *CliArgs, root: str, goal: BuildGoal,
                pick: *manifest.Selection) res[BuildRequest, outcome.Fail] {
    var r: BuildRequest = defaults();
    r.project_root = root;
    r.all_targets  = cli.all_targets;
    r.goal         = goal;
    val valid: err[outcome.Fail] = validate(a, ?r);
    if (sel valid.err) {
        ret res[BuildRequest, outcome.Fail].err{valid.err};
    }

    r.target   = pick.target;
    r.profile  = pick.profile;
    r.artifact = pick.artifact;
    r.want_lib = pick.want_lib;

    val pr_r: res[manifest.ResolvedProfile, outcome.Fail] = manifest.resolve_profile(a, itn, m, pick.profile);
    if (sel pr_r.err) {
        ret res[BuildRequest, outcome.Fail].err{pr_r.err};
    }
    val pf: manifest.ResolvedProfile = pr_r.ok;

    if (cli.opt_set) {
        if (cli.opt_release) { r.opt = pipeline.OPT_RELEASE; }
    }
    or (pf.opt == manifest.MOPT_RELEASE) {
        r.opt = pipeline.OPT_RELEASE;
    }

    r.debug     = cli.g || pf.debug;
    r.pie       = cli.pie;

    if (cli.subsystem != nil) {
        val ss: str = cli.subsystem::str;
        val flag: opt[SubsystemFlag] = subsystem_flag_from_name(ss);
        if (sel flag.none) {
            ret res[BuildRequest, outcome.Fail].err{outcome.user("--subsystem expects \"console\" or \"gui\"")};
        }
        r.subsystem_flag = flag.some;
    }

    r.simd          = pf.simd;
    r.vectorize     = pf.vectorize;
    r.float_reassoc = pf.float_reassoc;

    if (cli.jobs != nil) {
        val jv: i64 = parse_jobs(cli.jobs);
        if (jv < 1) {
            ret res[BuildRequest, outcome.Fail].err{outcome.user("--jobs expects a positive integer")};
        }
        r.jobs = jv::u32;
    }
    or {
        r.jobs = 1;
        val nc: i64 = sys.cpu_count();
        if (nc > 1) { r.jobs = nc::u32; }
    }

    r.emit_ir  = cli.emit_ir;
    r.emit_asm = cli.emit_asm;
    if (cli.output != nil) { r.out = cli.output::str; }

    r.link_tokens = vector.init[LinkToken](a);
    var ti: usize = 0;
    for (ti < cli.link_tokens.len) {
        var t: LinkToken;
        t.text = cli.link_tokens.data[ti]::str;
        val pr: res[usize, A.Error] = vector.push[LinkToken](?r.link_tokens, t);
        if (sel pr.err) {
            ret res[BuildRequest, outcome.Fail].err{outcome.internal("out of memory")};
        }
        ti = ti + 1;
    }
    r.lib_dirs = vector.init[str](a);
    var di: usize = 0;
    for (di < cli.lib_dirs.len) {
        val dr: res[usize, A.Error] = vector.push[str](?r.lib_dirs, cli.lib_dirs.data[di]::str);
        if (sel dr.err) {
            ret res[BuildRequest, outcome.Fail].err{outcome.internal("out of memory")};
        }
        di = di + 1;
    }

    r.include_deps = cli.include_deps;
    r.no_cache = cli.no_cache;
    r.object_cache = cli.cache && !cli.no_cache;
    ret res[BuildRequest, outcome.Fail].ok{r};
}

pub fun for_cell(base: *BuildRequest, target: str, artifact: str, want_lib: bool,
                 subsystem: of.Subsystem, goal: BuildGoal) BuildRequest {
    var r: BuildRequest = @base;
    r.target    = target;
    r.artifact  = artifact;
    r.want_lib  = want_lib;
    r.subsystem = subsystem;
    r.goal      = goal;
    ret r;
}

fun parse_jobs(s: *u8) i64 {
    if (s == nil || s[0] == 0) { ret -1; }
    var v: i64 = 0;
    var i: usize = 0;
    for (s[i] != 0) {
        if (s[i] < '0' || s[i] > '9') { ret -1; }
        v = v * 10 + (s[i] - '0')::i64;
        if (v > 65536) { ret -1; }
        i = i + 1;
    }
    ret v;
}

pub val HASH_SIZE: usize = 32;

fun write_semantic_fields(e: *binary.Encoder, r: *BuildRequest) bool {
    var ok: bool = true;
    ok = ok && hs(e, r.project_root);
    ok = ok && hs(e, r.target);
    ok = ok && hs(e, r.profile);
    ok = ok && hs(e, r.artifact);
    ok = ok && hb(e, r.want_lib);
    ok = ok && hb(e, r.all_targets);
    ok = ok && write_goal(e, r.goal);
    if (ok) {
        val write_u8_r: res[usize, binary.EncodeError] = binary.write_u8(e, r.opt); ok = sel write_u8_r.ok; }
    ok = ok && hb(e, r.debug);
    ok = ok && hb(e, r.pie);
    if (ok) {
        val write_u8_r2: res[usize, binary.EncodeError] = binary.write_u8(e, r.simd); ok = sel write_u8_r2.ok; }
    ok = ok && hb(e, r.vectorize);
    ok = ok && hb(e, r.float_reassoc);
    ok = ok && hb(e, r.include_deps);
    ret ok;
}

fun goal_spec(goal: BuildGoal) *BuildGoalSpec {
    var i: usize = 0;
    for (i < BUILD_GOAL_N) {
        if (BUILD_GOALS[i].goal == goal) { ret ?BUILD_GOALS[i]; }
        i = i + 1;
    }
    ret nil;
}

fun write_goal(e: *binary.Encoder, goal: BuildGoal) bool {
    val spec: *BuildGoalSpec = goal_spec(goal);
    if (spec == nil) { ret false; }
    ret fingerprint.write_domain_u8(e, fingerprint.DOMAIN_BUILD_GOAL, BUILD_GOAL_CATALOG_VERSION, spec.fingerprint_tag);
}

fun write_request_extra(e: *binary.Encoder, r: *BuildRequest) bool {
    var ok: bool = true;
    if (ok) {
        val write_u32_r: res[usize, binary.EncodeError] = binary.write_u32(e, r.jobs); ok = sel write_u32_r.ok; }
    ok = ok && hb(e, r.emit_ir);
    ok = ok && hb(e, r.emit_asm);
    ok = ok && hb(e, r.no_cache);
    ok = ok && hb(e, r.object_cache);
    ok = ok && hs(e, r.out);
    ok = ok && fingerprint.write_domain_u8(e, fingerprint.DOMAIN_SUBSYSTEM,
        of.SUBSYSTEM_CATALOG_VERSION, of.subsystem_fingerprint_tag(r.subsystem));
    if (ok) {
        val write_u32_r2: res[usize, binary.EncodeError] = binary.write_u32(e, r.link_tokens.len::u32); ok = sel write_u32_r2.ok; }
    var ti: usize = 0;
    for (ti < r.link_tokens.len) {
        ok = ok && hs(e, r.link_tokens.data[ti].text);
        ti = ti + 1;
    }
    if (ok) {
        val write_u32_r3: res[usize, binary.EncodeError] = binary.write_u32(e, r.lib_dirs.len::u32); ok = sel write_u32_r3.ok; }
    var di: usize = 0;
    for (di < r.lib_dirs.len) {
        ok = ok && hs(e, r.lib_dirs.data[di]);
        di = di + 1;
    }
    ret ok;
}

pub fun request_hash(a: *A.Allocator, r: *BuildRequest, digest: *u8) err[outcome.Fail] {
    val valid: err[outcome.Fail] = validate(a, r);
    if (sel valid.err) {
        ret err[outcome.Fail].err{valid.err};
    }
    var e: binary.Encoder = binary.encoder(a, binary.LITTLE);

    var ok: bool = true;
    ok = ok && write_semantic_fields(?e, r);
    ok = ok && write_request_extra(?e, r);

    if (!ok) {
        binary.encoder_dnit(?e);
        ret err[outcome.Fail].err{outcome.user("out of memory")};
    }
    sha256.hash(e.data, e.len, digest);
    binary.encoder_dnit(?e);
    ret err[outcome.Fail].ok{};
}

pub fun semantic_hash(a: *A.Allocator, r: *BuildRequest, digest: *u8) err[outcome.Fail] {
    val valid: err[outcome.Fail] = validate(a, r);
    if (sel valid.err) {
        ret err[outcome.Fail].err{valid.err};
    }
    var e: binary.Encoder = binary.encoder(a, binary.LITTLE);

    if (!write_semantic_fields(?e, r)) {
        binary.encoder_dnit(?e);
        ret err[outcome.Fail].err{outcome.user("out of memory")};
    }
    sha256.hash(e.data, e.len, digest);
    binary.encoder_dnit(?e);
    ret err[outcome.Fail].ok{};
}

fun hs(e: *binary.Encoder, s: str) bool {
    val n: usize = str_len(s);
    val write_u32_r: res[usize, binary.EncodeError] = binary.write_u32(e, n::u32);
    if (sel write_u32_r.err) { ret false; }
    val write_bytes_r: res[usize, binary.EncodeError] = binary.write_bytes(e, s::*u8, n);
    ret sel write_bytes_r.ok;
}

fun hb(e: *binary.Encoder, v: bool) bool {
    var b: u8 = 0;
    if (v) { b = 1; }
    val write_u8_r: res[usize, binary.EncodeError] = binary.write_u8(e, b);
    ret sel write_u8_r.ok;
}

test "mach.lang.build.request.is_object_path:shared_library_suffixes" {
    if (!is_object_path("libfoo.so"::*u8))    { ret 1; }
    if (!is_object_path("libfoo.so.3"::*u8))  { ret 1; }
    if (!is_object_path("libfoo.dylib"::*u8)) { ret 1; }
    if (!is_object_path("libfoo.DYLIB"::*u8)) { ret 1; }
    if (!is_object_path("foo.dll"::*u8))      { ret 1; }
    if (!is_object_path("foo.DLL"::*u8))      { ret 1; }
    if (!is_object_path("foo.o"::*u8))        { ret 1; }
    if (!is_object_path("foo.a"::*u8))        { ret 1; }
    if (!is_object_path("foo.obj"::*u8))      { ret 1; }
    if (!is_object_path("foo.OBJ"::*u8))      { ret 1; }
    if (!is_object_path("foo.lib"::*u8))      { ret 1; }
    if (!is_object_path("foo.LIB"::*u8))      { ret 1; }
    if (is_object_path("foo"::*u8))           { ret 1; }
    ret 0;
}

test "mach.lang.build.request.for_cell:swaps_selection_only" {
    var base: BuildRequest = defaults();
    base.project_root = "/r";
    base.target       = "";
    base.artifact     = "";
    base.opt          = pipeline.OPT_RELEASE;
    base.debug        = true;
    base.jobs         = 7;

    val c: BuildRequest = for_cell(?base, "tb", "libb", true, of.SUBSYSTEM_GUI, base.goal);
    if (!str_equals(c.target, "tb"))       { ret 1; }
    if (!str_equals(c.artifact, "libb"))   { ret 1; }
    if (!c.want_lib)                       { ret 1; }
    if (c.subsystem != of.SUBSYSTEM_GUI)   { ret 1; }
    if (c.opt != pipeline.OPT_RELEASE)     { ret 1; }
    if (!c.debug)                          { ret 1; }
    if (c.jobs != 7)                       { ret 1; }
    if (!str_equals(c.project_root, "/r")) { ret 1; }

    if (base.subsystem != of.SUBSYSTEM_CONSOLE) { ret 1; }
    ret 0;
}

test "mach.lang.build.request.build_goal_catalog:complete_unique_ordered_roundtrip" {
    if (BUILD_GOAL_CATALOG_VERSION != 1)               { ret 1; }
    if (BUILD_GOAL_N != GOAL_CHECK::usize + 1)         { ret 1; }

    var seen: [BUILD_GOAL_N]bool;
    var i: usize = 0;
    for (i < BUILD_GOAL_N) { seen[i] = false; i = i + 1; }

    var emit_count: usize = 0;
    i = 0;
    for (i < BUILD_GOAL_N) {
        val spec: *BuildGoalSpec = ?BUILD_GOALS[i];
        if (spec.goal::usize >= BUILD_GOAL_N)           { ret 1; }
        if (seen[spec.goal::usize])                     { ret 1; }
        if (str_empty(spec.display))                    { ret 1; }
        if (spec.fingerprint_tag != (i + 1)::u8)        { ret 1; }
        if (!str_equals(goal_name(spec.goal), spec.display)) { ret 1; }
        seen[spec.goal::usize] = true;

        var j: usize = 0;
        for (j < i) {
            val prior: *BuildGoalSpec = ?BUILD_GOALS[j];
            if (prior.goal == spec.goal)                       { ret 1; }
            if (prior.fingerprint_tag == spec.fingerprint_tag) { ret 1; }
            if (str_equals(prior.display, spec.display))       { ret 1; }
            if (!str_empty(spec.emit_name)
                && str_equals(prior.emit_name, spec.emit_name)) { ret 1; }
            j = j + 1;
        }

        if (!str_empty(spec.emit_name)) {
            val parsed: opt[BuildGoal] = goal_from_emit_name(spec.emit_name);
            if (sel parsed.none)                  { ret 1; }
            if (parsed.some != spec.goal)      { ret 1; }
            if (!str_contains(EMIT_HELP, spec.emit_name))      { ret 1; }
            if (!str_contains(EMIT_ERROR, spec.emit_name))     { ret 1; }
            emit_count = emit_count + 1;
        }
        i = i + 1;
    }

    if (emit_count != 2)                                  { ret 1; }
    val goal_from_emit_name_r: opt[BuildGoal] = goal_from_emit_name("tests");
    if (sel goal_from_emit_name_r.some) { ret 1; }
    val goal_from_emit_name_r2: opt[BuildGoal] = goal_from_emit_name("");
    if (sel goal_from_emit_name_r2.some)      { ret 1; }
    if (!str_equals(goal_name(255::BuildGoal), "unknown"))  { ret 1; }
    i = 0;
    for (i < BUILD_GOAL_N) {
        if (!seen[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.build.request.subsystem_flag_catalog:complete_unique_and_tracks_target_catalog" {
    var seen: [SUBSYSTEM_FLAG_N]bool;
    var i: usize = 0;
    for (i < SUBSYSTEM_FLAG_N) { seen[i] = false; i = i + 1; }

    i = 0;
    for (i < SUBSYSTEM_FLAG_N) {
        val spec: *SubsystemFlagSpec = ?SUBSYSTEM_FLAGS[i];
        if (spec.flag == SUBSYSTEM_FLAG_NONE)       { ret 1; }
        val slot: usize = spec.flag::usize - 1;
        if (slot >= SUBSYSTEM_FLAG_N)                { ret 1; }
        if (seen[slot])                              { ret 1; }
        seen[slot] = true;

        if (spec.fingerprint_tag != of.subsystem_fingerprint_tag(spec.resolved)) { ret 1; }

        var j: usize = 0;
        for (j < i) {
            val prior: *SubsystemFlagSpec = ?SUBSYSTEM_FLAGS[j];
            if (prior.flag == spec.flag)         { ret 1; }
            if (prior.resolved == spec.resolved) { ret 1; }
            j = j + 1;
        }

        val name: str = of.subsystem_name(spec.resolved);
        val parsed: opt[SubsystemFlag] = subsystem_flag_from_name(name);
        if (sel parsed.none)                 { ret 1; }
        if (parsed.some != spec.flag)     { ret 1; }

        val resolved: opt[of.Subsystem] = subsystem_from_flag(spec.flag);
        if (sel resolved.none)                { ret 1; }
        if (resolved.some != spec.resolved) { ret 1; }
        i = i + 1;
    }

    val subsystem_flag_from_name_r: opt[SubsystemFlag] = subsystem_flag_from_name("");
    if (sel subsystem_flag_from_name_r.some)       { ret 1; }
    val subsystem_flag_from_name_r2: opt[SubsystemFlag] = subsystem_flag_from_name("bogus");
    if (sel subsystem_flag_from_name_r2.some)  { ret 1; }
    val subsystem_from_flag_r: opt[of.Subsystem] = subsystem_from_flag(SUBSYSTEM_FLAG_NONE);
    if (sel subsystem_from_flag_r.some) { ret 1; }

    i = 0;
    for (i < SUBSYSTEM_FLAG_N) {
        if (!seen[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

fun dig_eq(a: *u8, b: *u8) bool {
    var i: usize = 0;
    for (i < HASH_SIZE) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.build.request.semantic_hash:distinguishes_every_build_goal" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var digests: [BUILD_GOAL_N][32]u8;
    var i: usize = 0;
    for (i < BUILD_GOAL_N) {
        var req: BuildRequest = defaults();
        req.goal = BUILD_GOALS[i].goal;
        val semantic_hash_r: err[outcome.Fail] = semantic_hash(?alloc, ?req, ?digests[i][0]);
        if (sel semantic_hash_r.err) { ret 1; }

        var j: usize = 0;
        for (j < i) {
            if (dig_eq(?digests[j][0], ?digests[i][0])) { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.build.request.request_hash:distinguishes_every_subsystem" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var digests: [SUBSYSTEM_FLAG_N][32]u8;
    var i: usize = 0;
    for (i < SUBSYSTEM_FLAG_N) {
        var req: BuildRequest = defaults();
        req.subsystem = SUBSYSTEM_FLAGS[i].resolved;
        val request_hash_r: err[outcome.Fail] = request_hash(?alloc, ?req, ?digests[i][0]);
        if (sel request_hash_r.err) { ret 1; }

        var j: usize = 0;
        for (j < i) {
            if (dig_eq(?digests[j][0], ?digests[i][0])) { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.build.request.semantic_hash:omits_nonsemantic_fields" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var ra: BuildRequest = defaults();
    ra.project_root = "/tmp/p";
    ra.opt          = pipeline.OPT_DEBUG;

    var base: [32]u8;
    val semantic_hash_r: err[outcome.Fail] = semantic_hash(?alloc, ?ra, ?base[0]);
    if (sel semantic_hash_r.err) { ret 1; }

    var rb: BuildRequest = ra;
    rb.jobs = ra.jobs + 8;
    var d: [32]u8;
    val semantic_hash_r2: err[outcome.Fail] = semantic_hash(?alloc, ?rb, ?d[0]);
    if (sel semantic_hash_r2.err) { ret 1; }
    if (!dig_eq(?base[0], ?d[0])) { ret 1; }

    var rqa: [32]u8;
    var rqb: [32]u8;
    val request_hash_r: err[outcome.Fail] = request_hash(?alloc, ?ra, ?rqa[0]);
    if (sel request_hash_r.err) { ret 1; }
    val request_hash_r2: err[outcome.Fail] = request_hash(?alloc, ?rb, ?rqb[0]);
    if (sel request_hash_r2.err) { ret 1; }
    if (dig_eq(?rqa[0], ?rqb[0])) { ret 1; }

    rb = ra;
    rb.no_cache = true;
    rb.object_cache = true;
    rb.emit_ir  = true;
    rb.emit_asm = true;
    rb.out      = "/tmp/out.bin";
    val semantic_hash_r3: err[outcome.Fail] = semantic_hash(?alloc, ?rb, ?d[0]);
    if (sel semantic_hash_r3.err) { ret 1; }
    if (!dig_eq(?base[0], ?d[0])) { ret 1; }

    rb = ra;
    rb.subsystem = of.SUBSYSTEM_GUI;
    val semantic_hash_r4: err[outcome.Fail] = semantic_hash(?alloc, ?rb, ?d[0]);
    if (sel semantic_hash_r4.err) { ret 1; }
    if (!dig_eq(?base[0], ?d[0])) { ret 1; }
    val request_hash_r3: err[outcome.Fail] = request_hash(?alloc, ?ra, ?rqa[0]);
    if (sel request_hash_r3.err) { ret 1; }
    val request_hash_r4: err[outcome.Fail] = request_hash(?alloc, ?rb, ?rqb[0]);
    if (sel request_hash_r4.err) { ret 1; }
    if (dig_eq(?rqa[0], ?rqb[0])) { ret 1; }

    rb = ra;
    rb.opt = pipeline.OPT_RELEASE;
    val semantic_hash_r5: err[outcome.Fail] = semantic_hash(?alloc, ?rb, ?d[0]);
    if (sel semantic_hash_r5.err) { ret 1; }
    if (dig_eq(?base[0], ?d[0])) { ret 1; }

    rb = ra;
    rb.pie = true;
    val semantic_hash_r6: err[outcome.Fail] = semantic_hash(?alloc, ?rb, ?d[0]);
    if (sel semantic_hash_r6.err) { ret 1; }
    if (dig_eq(?base[0], ?d[0])) { ret 1; }
    ret 0;
}

test "mach.lang.build.request.validate:unknown_catalog_members_never_hash_as_valid_requests" {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var r: BuildRequest = defaults();
    val validate_r: err[outcome.Fail] = validate(?a, ?r);
    if (sel validate_r.err) { ret 2; }
    val catalogs: [5]str = [5]str{ "BuildGoal", "OptLevel", "SimdMode", "SubsystemFlag", "Subsystem" };
    var i: usize = 0;
    for (i < 5) {
        r = defaults();
        if (i == 0) { r.goal = 255; }
        or (i == 1) { r.opt = 255; }
        or (i == 2) { r.simd = 255; }
        or (i == 3) { r.subsystem_flag = 255; }
        or { r.subsystem = 255; }
        val valid: err[outcome.Fail] = validate(?a, ?r);
        if (sel valid.ok) { ret 3; }
        val f: outcome.Fail = valid.err;
        val correct: bool = sel f.internal && str_contains(outcome.describe(f), catalogs[i])
            && str_contains(outcome.describe(f), "255");
        outcome.release_text(?a, f);
        if (!correct) { ret 4; }
        var digest: [HASH_SIZE]u8;
        digest[0] = 171;
        val full: err[outcome.Fail] = request_hash(?a, ?r, ?digest[0]);
        if (sel full.ok) { ret 5; }
        val full_message: str = outcome.describe(full.err);
        val full_correct: bool = str_contains(full_message, catalogs[i]) && digest[0] == 171;
        str_free(?a, full_message);
        if (!full_correct) { ret 6; }
        val semantic: err[outcome.Fail] = semantic_hash(?a, ?r, ?digest[0]);
        if (sel semantic.ok) { ret 7; }
        val semantic_message: str = outcome.describe(semantic.err);
        val semantic_correct: bool = str_contains(semantic_message, catalogs[i]) && digest[0] == 171;
        str_free(?a, semantic_message);
        if (!semantic_correct) { ret 8; }
        i = i + 1;
    }
    ret 0;
}
