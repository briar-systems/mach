use mach.lang.host;
use A: std.allocator;
use std.allocator.page;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;

pub val UNAVAILABLE: u8 = host.FAULT_UNAVAILABLE;
pub val INTERNAL:    u8 = host.FAULT_INTERNAL;
pub rec Error { kind: u8; message: str; }

# where the identity came from: the build id the linker wrote into the running
# image, or the sha-256 of the image file when it carries none
pub val SOURCE_BUILD_ID: u8 = 1;
pub val SOURCE_DIGEST:   u8 = 2;
pub rec Identity { bytes: [32]u8; len: usize; source: u8; }

pub fun identity_clear(id: *Identity) {
    var i: usize = 0;
    for (i < 32) {
        id.bytes[i] = 0;
        i           = i + 1;
    }
    id.len    = 0;
    id.source = 0;
}

#[testing]
pub fun identity_equal(a: *Identity, b: *Identity) bool {
    if (a.len != b.len || a.source != b.source) { ret false; }
    ret memory.raw_equal((?a.bytes[0])::ptr, (?b.bytes[0])::ptr, a.len);
}

# the running image cannot change under a live process (text-busy on linux,
# share-denied on windows, identity-checked on darwin), so one identity serves
# every build unit the process executes; each unit begins a fresh project, and
# only the operation setup on the main thread asks for it
var memo_valid: bool = false;
var memo:       Identity;

# identifies the current executable, never argv[0], once per process: the
# linker's build id when the image carries one, else its sha-256
# success fills the identity, failure leaves the output and the memo untouched
pub fun identity(alloc: *A.Allocator, out: *Identity) err[Error] {
    if (alloc == nil || out == nil) { ret err[Error].err{Error{kind: INTERNAL, message: "compiler identity allocator or output is missing"}}; }
    if (memo_valid) {
        @out = memo;
        ret err[Error].ok{};
    }
    var found: Identity;
    identity_clear(?found);
    found.len = host.image_build_id(?found.bytes[0]);
    if (found.len > 0) { found.source = SOURCE_BUILD_ID; }
    or {
        val hashed: err[host.Fault] = host.image_digest(alloc, ?found.bytes[0]);
        if (sel hashed.err) { ret err[Error].err{Error{kind: hashed.err.kind, message: hashed.err.message}}; }
        found.len    = 32;
        found.source = SOURCE_DIGEST;
    }
    memo       = found;
    memo_valid = true;
    @out       = memo;
    ret err[Error].ok{};
}

test identity__a_second_call_is_served_from_the_memo {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var first: Identity;
    val found: err[Error] = identity(?alloc, ?first);
    if (sel found.err) {
        if (found.err.kind == UNAVAILABLE) { ret 0; }
        ret 2;
    }
    if (!memo_valid)                                                      { ret 3; }
    if (first.source != SOURCE_BUILD_ID && first.source != SOURCE_DIGEST) { ret 4; }
    if (first.len == 0 || first.len > 32)                                 { ret 5; }
    var second:     Identity;
    val identity_r: err[Error] = identity(?alloc, ?second);
    if (sel identity_r.err)               { ret 6; }
    if (!identity_equal(?first, ?second)) { ret 7; }
    # a perturbed memo must show through, proving the second call did not rederive
    val kept: u8 = memo.bytes[0];
    memo.bytes[0] = kept ^ 0xff;
    var third:  Identity;
    val served: err[Error] = identity(?alloc, ?third);
    memo.bytes[0] = kept;
    if (sel served.err)                  { ret 8; }
    if (third.bytes[0] != (kept ^ 0xff)) { ret 8; }
    ret 0;
}

# the test binary is linked by the compiler under test, which emits the note,
# so the identity is the build id and no file is hashed; the note must also
# be exactly what the file carries
test identity__is_the_mapped_build_id {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var found: Identity;
    val got:   err[Error] = identity(?alloc, ?found);
    if (sel got.err) {
        if (got.err.kind == UNAVAILABLE) { ret 0; }
        ret 2;
    }
    if (found.source != SOURCE_BUILD_ID) { ret 3; }
    $if ($mach.build.os == $mach.os.linux) {
        if (found.len != 32) { ret 4; }
    }
    $or {
        if (found.len != 16) { ret 4; }
    }
    var zero: bool  = true;
    var i:    usize = 0;
    for (i < found.len) {
        if (found.bytes[i] != 0) { zero = false; }
        i = i + 1;
    }
    if (zero) { ret 5; }
    var again: [32]u8;
    if (host.image_build_id(?again[0]) != found.len || !memory.raw_equal((?again[0])::ptr, (?found.bytes[0])::ptr, found.len)) { ret 6; }
    ret 0;
}

test identity__a_missing_allocator_keeps_the_output_untouched {
    var output: Identity;
    identity_clear(?output);
    output.bytes[0] = 0xa5;
    output.len      = 7;
    val result: err[Error] = identity(nil, ?output);
    if (sel result.ok)                              { ret 1; }
    if (result.err.kind != INTERNAL)                { ret 1; }
    if (output.bytes[0] != 0xa5 || output.len != 7) { ret 2; }
    ret 0;
}
