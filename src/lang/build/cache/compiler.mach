use std.types.canonical.res;
use std.types.canonical.err;
use outcome: mach.lang.build.outcome;
use A: std.allocator;
use lang_alloc: mach.lang.alloc;
use fs: std.filesystem;
use io_error: std.io.error;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.memory;
use std.system.os;
use page: std.allocator.page;
use identities: std.system.file_identity;
use mach.lang.build.fingerprint;
use mach.lang.target.of.bin;
use mach.lang.target.of.buildid;

pub val UNAVAILABLE: u8 = 1;
pub val INTERNAL: u8 = 2;
pub rec Error { kind: u8; message: str; }

# where the identity came from: the build id the linker wrote into the running
# image, or the sha-256 of the image file when it carries none
pub val SOURCE_BUILD_ID: u8 = 1;
pub val SOURCE_DIGEST:   u8 = 2;
pub rec Identity { bytes: [32]u8; len: usize; source: u8; }

pub fun identity_clear(id: *Identity) {
    var i: usize = 0;
    for (i < 32) { id.bytes[i] = 0; i = i + 1; }
    id.len = 0;
    id.source = 0;
}

pub fun identity_equal(a: *Identity, b: *Identity) bool {
    if (a.len != b.len || a.source != b.source) { ret false; }
    ret memory.raw_equal((?a.bytes[0])::ptr, (?b.bytes[0])::ptr, a.len);
}

fun unavailable(message: str) Error { ret Error{kind: UNAVAILABLE, message: message}; }
fun internal(message: str) Error { ret Error{kind: INTERNAL, message: message}; }
fun io_failure(error: io_error.Error) Error {
    if (error.kind == io_error.RESOURCE_EXHAUSTED || error.kind == io_error.INVALID || error.kind == io_error.CLOSED) {
        ret internal(io_error.message(error));
    }
    ret unavailable(io_error.message(error));
}

fun hash_held(held: fs.File, out: *u8) err[Error] {
    val hashed: err[outcome.Fail] = fingerprint.held_file_sha256(held, out);
    if (sel hashed.err) { ret err[Error].err{internal(outcome.describe(hashed.err))}; }
    ret err[Error].ok{};
}

fun finish_owned(held: *fs.File, out: *u8) err[Error] {
    var computed: [32]u8;
    val hashed: err[Error] = hash_held(@held, ?computed[0]);
    val closed: err[io_error.Error] = fs.close(held);
    if (sel hashed.err) { ret hashed; }
    if (sel closed.err) { ret err[Error].err{internal(io_error.message(closed.err))}; }
    memory.raw_copy(out::ptr, (?computed[0])::ptr, 32);
    ret err[Error].ok{};
}

fun identified_digest(path: str, expected: fs.Identity, out: *u8) err[Error] {
    val opened: res[fs.File, io_error.Error] = fs.open(path);
    if (sel opened.err) { ret err[Error].err{io_failure(opened.err)}; }
    var held: fs.File = opened.ok;
    val observed: res[fs.Identity, io_error.Error] = fs.identity_of(held);
    if (sel observed.err) {
        val closed: err[io_error.Error] = fs.close(?held);
        if (sel closed.err) { ret err[Error].err{internal("compiler identity query and file cleanup both failed")}; }
        ret err[Error].err{io_failure(observed.err)};
    }
    if (!fs.identity_equal(expected, observed.ok)) {
        val closed: err[io_error.Error] = fs.close(?held);
        if (sel closed.err) { ret err[Error].err{internal("compiler identity changed and file cleanup failed")}; }
        ret err[Error].err{unavailable("compiler path no longer names the running image")};
    }
    ret finish_owned(?held, out);
}

$if ($mach.build.os == $mach.os.linux) {
    val AT_PHDR:  u64 = 3;
    val AT_PHENT: u64 = 4;
    val AT_PHNUM: u64 = 5;
    val PT_LOAD:  u32 = 1;
    val PT_NOTE:  u32 = 4;
    val PT_PHDR:  u32 = 6;
    val PHDR64_SIZE: u64 = 56;

    # the auxiliary vector sits past the terminator of the environment block
    # the runtime captured; type/value pairs ended by AT_NULL
    fun auxval(kind: u64) u64 {
        val envp: **u8 = os.environ();
        if (envp == nil) { ret 0; }
        val slots: *u64 = envp::ptr::*u64;
        var i: usize = 0;
        for (slots[i] != 0) { i = i + 1; }
        i = i + 1;
        for (slots[i] != 0) {
            if (slots[i] == kind) { ret slots[i + 1]; }
            i = i + 2;
        }
        ret 0;
    }

    # the note the linker placed in the header page, read through the program
    # header table the kernel mapped: PT_PHDR gives the load bias (zero for an
    # ET_EXEC without one), PT_NOTE the note, and a PT_LOAD must map its whole
    # extent before a byte of it is touched. 0 when the image carries none
    fun mapped_build_id(out: *u8) usize {
        val phdr: u64 = auxval(AT_PHDR);
        val phnum: u64 = auxval(AT_PHNUM);
        if (phdr == 0 || phnum == 0 || phnum > 0xFFFF || auxval(AT_PHENT) != PHDR64_SIZE) { ret 0; }
        val table: *u8 = phdr::usize::ptr::*u8;
        var bias: u64 = 0;
        var note_vaddr: u64 = 0;
        var note_size: u64 = 0;
        var i: usize = 0;
        for (i < phnum::usize) {
            val ph: usize = i * PHDR64_SIZE::usize;
            val kind: u32 = bin.read_u32_le(table, ph);
            if (kind == PT_PHDR) { bias = phdr - bin.read_u64_le(table, ph + 16); }
            if (kind == PT_NOTE && note_size == 0) {
                note_vaddr = bin.read_u64_le(table, ph + 16);
                note_size = bin.read_u64_le(table, ph + 32);
            }
            i = i + 1;
        }
        if (note_size < buildid.ELF_NOTE_SIZE::u64) { ret 0; }
        val note: u64 = note_vaddr + bias;
        var mapped: bool = false;
        i = 0;
        for (i < phnum::usize) {
            val ph: usize = i * PHDR64_SIZE::usize;
            if (bin.read_u32_le(table, ph) == PT_LOAD) {
                val lo: u64 = bin.read_u64_le(table, ph + 16) + bias;
                val filesz: u64 = bin.read_u64_le(table, ph + 32);
                if (note >= lo && filesz >= buildid.ELF_NOTE_SIZE::u64 && note - lo <= filesz - buildid.ELF_NOTE_SIZE::u64) { mapped = true; }
            }
            i = i + 1;
        }
        if (!mapped) { ret 0; }
        val bytes: *u8 = note::usize::ptr::*u8;
        if (!buildid.elf_note_header_valid(bytes)) { ret 0; }
        memory.raw_copy(out::ptr, (bytes::usize + buildid.ELF_NOTE_HEADER)::ptr, buildid.DIGEST_LEN);
        ret buildid.DIGEST_LEN;
    }

    test "mach.lang.build.cache.compiler:auxiliary_vector_names_the_program_headers" {
        val phdr: u64 = auxval(AT_PHDR);
        if (phdr == 0 || auxval(AT_PHNUM) == 0 || auxval(AT_PHENT) != PHDR64_SIZE) { ret 1; }
        if (auxval(6) == 0) { ret 2; }
        if (auxval(0x7fffffff) != 0) { ret 3; }
        ret 0;
    }
}

$if ($mach.build.os == $mach.os.darwin) {
    use ls: std.system.os.darwin.libsystem;

    val MH_MAGIC_64: u32 = 0xFEEDFACF;
    val LC_UUID: u32 = 0x1B;
    val UUID_CMD_SIZE: u32 = 24;

    #[library("libSystem")] #[symbol("__dyld_get_image_header")]
    ext fun dyld_get_image_header(index: u32) ptr;

    # LC_UUID from the main executable's mapped header
    fun mapped_build_id(out: *u8) usize {
        val base: ptr = dyld_get_image_header(0);
        if (base == nil) { ret 0; }
        val header: *u8 = base::*u8;
        if (bin.read_u32_le(header, 0) != MH_MAGIC_64) { ret 0; }
        val ncmds: u32 = bin.read_u32_le(header, 16);
        val sizeofcmds: usize = bin.read_u32_le(header, 20)::usize;
        var off: usize = 32;
        var c: u32 = 0;
        for (c < ncmds) {
            if (off + 8 > 32 + sizeofcmds) { ret 0; }
            val cmd: u32 = bin.read_u32_le(header, off);
            val cmdsize: u32 = bin.read_u32_le(header, off + 4);
            if (cmdsize < 8 || off + cmdsize::usize > 32 + sizeofcmds) { ret 0; }
            if (cmd == LC_UUID && cmdsize == UUID_CMD_SIZE) {
                memory.raw_copy(out::ptr, (header::usize + off + 8)::ptr, buildid.UUID_LEN);
                ret buildid.UUID_LEN;
            }
            off = off + cmdsize::usize;
            c = c + 1;
        }
        ret 0;
    }

    #[library("libSystem")] #[symbol("_proc_pidinfo")]
    ext fun proc_pidinfo(pid: i32, flavor: i32, argument: u64, buffer: ptr, size: i32) i32;

    rec Region {
        protection: u32; maximum_protection: u32; inheritance: u32; flags: u32;
        offset: u64;
        behavior: u32; user_wired_count: u32; user_tag: u32;
        pages_resident: u32; pages_shared_now_private: u32; pages_swapped_out: u32;
        pages_dirtied: u32; ref_count: u32; shadow_depth: u32; share_mode: u32;
        private_pages_resident: u32; shared_pages_resident: u32; object_id: u32; depth: u32;
        address: u64; size: u64;
    }
    rec VnodeStat {
        device: u32; mode: u16; links: u16; inode: u64; uid: u32; gid: u32;
        access_seconds: i64; access_nanoseconds: i64;
        modified_seconds: i64; modified_nanoseconds: i64;
        changed_seconds: i64; changed_nanoseconds: i64;
        birth_seconds: i64; birth_nanoseconds: i64;
        size: i64; blocks: i64; block_size: i32; flags: u32;
        generation: u32; raw_device: u32; reserved: [2]i64;
    }
    rec Vnode {
        stat: VnodeStat; kind: i32; padding: i32; filesystem: [2]i32;
    }
    rec RegionPath {
        region: Region; vnode: Vnode; path: [1024]u8;
    }

    #[noinline]
    fun darwin_digest(out: *u8) err[Error] {
        val address: u64 = darwin_digest::u64;
        var mapped: RegionPath;
        val count: i32 = proc_pidinfo(os.getpid()::i32, 8, address, (?mapped)::ptr, $size_of(RegionPath)::i32);
        if (count <= 0) { ret err[Error].err{io_failure(io_error.from_code(0 - ls.errno()::i64, io_error.OP_OPTION))}; }
        if (count != $size_of(RegionPath)::i32) { ret err[Error].err{internal("running compiler vnode response has the wrong size")}; }
        if (!mapped_region_valid(?mapped, address)) {
            ret err[Error].err{unavailable("running compiler mapping has no complete file identity")};
        }
        val expected: fs.Identity = identities.native(identities.DARWIN_LOCAL,
            (mapped.vnode.stat.device:~i32)::u64, mapped.vnode.stat.inode);
        ret identified_digest((?mapped.path[0])::str, expected, out);
    }

    fun mapped_region_valid(mapped: *RegionPath, address: u64) bool {
        if (address < mapped.region.address || address - mapped.region.address >= mapped.region.size
            || mapped.vnode.kind != 1 || (mapped.vnode.stat.mode & 0xf000) != 0x8000
            || mapped.path[0] != '/') { ret false; }
        var i: usize = 1;
        for (i < 1024) {
            if (mapped.path[i] == 0) { ret true; }
            i = i + 1;
        }
        ret false;
    }

    test "mach.lang.build.cache.compiler:darwin_mapping_layout_and_bounds" {
        if ($size_of(Region) != 96 || $size_of(VnodeStat) != 136 || $size_of(Vnode) != 152
            || $size_of(RegionPath) != 1272 || $offset_of(Region, address) != 80
            || $offset_of(RegionPath, vnode) != 96 || $offset_of(RegionPath, path) != 248
            || $offset_of(VnodeStat, inode) != 8) { ret 1; }
        var mapped: RegionPath;
        mapped.region.address = 100; mapped.region.size = 20;
        mapped.vnode.kind = 1; mapped.vnode.stat.mode = 0x8000;
        mapped.path[0] = '/'; mapped.path[1] = 'x'; mapped.path[2] = 0;
        if (!mapped_region_valid(?mapped, 100) || !mapped_region_valid(?mapped, 119)
            || mapped_region_valid(?mapped, 99) || mapped_region_valid(?mapped, 120)) { ret 2; }
        mapped.vnode.kind = 0;
        if (mapped_region_valid(?mapped, 100)) { ret 3; }
        val address: u64 = darwin_digest::u64;
        val count: i32 = proc_pidinfo(os.getpid()::i32, 8, address, (?mapped)::ptr, $size_of(RegionPath)::i32);
        if (count != $size_of(RegionPath)::i32) { ret 4; }
        if (!mapped_region_valid(?mapped, address)) { ret 5; }
        ret 0;
    }
}

$if ($mach.build.os == $mach.os.windows) {
    use std.types.size.isize;

    #[library("kernel32.dll")]
    ext fun GetModuleHandleW(name: *u16) ptr;
    #[library("kernel32.dll")]
    ext fun GetModuleFileNameW(module: ptr, path: *u16, capacity: u32) u32;
    #[library("kernel32.dll")]
    ext fun K32GetMappedFileNameW(process: isize, address: ptr, path: *u16, capacity: u32) u32;
    #[library("kernel32.dll")]
    ext fun GetFinalPathNameByHandleW(handle: isize, path: *u16, capacity: u32, flags: u32) u32;
    #[library("kernel32.dll")]
    ext fun CreateFileW(path: *u16, access: u32, sharing: u32, security: ptr, disposition: u32, flags: u32, template_file: isize) isize;
    #[library("kernel32.dll")]
    ext fun CloseHandle(handle: isize) i32;
    #[library("kernel32.dll")]
    ext fun GetLastError() u32;
    #[library("kernel32.dll")]
    ext fun GetFileInformationByHandleEx(handle: isize, kind: u32, info: ptr, size: u32) i32;
    #[library("kernel32.dll")]
    ext fun WideCharToMultiByte(codepage: u32, flags: u32, wide: *u16, units: i32, text: *u8, bytes: i32, replacement: *u8, replaced: *i32) i32;

    rec WidePath { data: *u16; capacity: u32; len: u32; }
    rec FileId { volume: u64; file: [16]u8; }

    val PE32PLUS_MAGIC: u16 = 0x20B;
    val IMAGE_DIRECTORY_ENTRY_DEBUG: usize = 6;

    # the codeview guid from the running image's mapped headers: dos header,
    # pe signature, the pe32+ optional header's debug data directory, the
    # first codeview entry and the RSDS record it names, every step bounded
    # by SizeOfImage
    fun mapped_build_id(out: *u8) usize {
        val base: ptr = GetModuleHandleW(nil);
        if (base == nil) { ret 0; }
        val image: *u8 = base::*u8;
        if (image[0] != 'M' || image[1] != 'Z') { ret 0; }
        val pe: usize = bin.read_u32_le(image, 0x3C)::usize;
        if (pe < 0x40 || pe > 0x1000) { ret 0; }
        if (image[pe] != 'P' || image[pe + 1] != 'E' || image[pe + 2] != 0 || image[pe + 3] != 0) { ret 0; }
        val oh: usize = pe + 4 + 20;
        if (bin.read_u16_le(image, oh) != PE32PLUS_MAGIC) { ret 0; }
        val size_of_image: usize = bin.read_u32_le(image, oh + 56)::usize;
        if (bin.read_u32_le(image, oh + 108)::usize <= IMAGE_DIRECTORY_ENTRY_DEBUG) { ret 0; }
        val dd: usize = oh + 112 + IMAGE_DIRECTORY_ENTRY_DEBUG * 8;
        val dir_rva: usize = bin.read_u32_le(image, dd)::usize;
        val dir_size: usize = bin.read_u32_le(image, dd + 4)::usize;
        if (dir_rva == 0 || dir_size < buildid.PE_DEBUG_DIR_SIZE || dir_rva > size_of_image || dir_size > size_of_image - dir_rva) { ret 0; }
        var entry: usize = dir_rva;
        val end: usize = dir_rva + dir_size;
        for (entry + buildid.PE_DEBUG_DIR_SIZE <= end) {
            if (bin.read_u32_le(image, entry + 12) == buildid.PE_DEBUG_TYPE_CODEVIEW) {
                val record_size: usize = bin.read_u32_le(image, entry + 16)::usize;
                val record: usize = bin.read_u32_le(image, entry + 20)::usize;
                if (record != 0 && record_size >= buildid.PE_CODEVIEW_SIZE && record < size_of_image
                    && record_size <= size_of_image - record
                    && buildid.pe_codeview_valid((image::usize + record)::*u8)) {
                    memory.raw_copy(out::ptr, (image::usize + record + buildid.PE_CODEVIEW_GUID)::ptr, buildid.UUID_LEN);
                    ret buildid.UUID_LEN;
                }
            }
            entry = entry + buildid.PE_DEBUG_DIR_SIZE;
        }
        ret 0;
    }

    fun windows_failure(message: str) Error {
        val code: u32 = GetLastError();
        if (code == 8 || code == 14 || code == 1450 || code == 1455 || code == 1816 || code == 6 || code == 87) { ret internal(message); }
        ret unavailable(message);
    }

    # kind selects the loader path, mapped nt path, or held file's normalized nt path
    fun windows_path(a: *A.Allocator, kind: u8, image: ptr, held: isize) res[WidePath, Error] {
        var capacity: u32 = 256;
        for {
            val allocated: res[*u16, A.Error] = A.allocate[u16](a, capacity::usize);
            if (sel allocated.err) { ret res[WidePath, Error].err{internal(lang_alloc.text(allocated.err))}; }
            val data: *u16 = allocated.ok;
            var len: u32 = 0;
            if (kind == 0) { len = GetModuleFileNameW(nil, data, capacity); }
            or (kind == 1) { len = K32GetMappedFileNameW(0 - 1, image, data, capacity); }
            or { len = GetFinalPathNameByHandleW(held, data, capacity, 2); }
            if (len == 0) {
                val failure: Error = windows_failure("cannot obtain the running compiler file path");
                A.deallocate[u16](a, data, capacity::usize);
                ret res[WidePath, Error].err{failure};
            }
            if (len < capacity) {
                if (data[len::usize] != 0) {
                    A.deallocate[u16](a, data, capacity::usize);
                    ret res[WidePath, Error].err{internal("compiler path response has no terminator")};
                }
                ret res[WidePath, Error].ok{WidePath{data: data, capacity: capacity, len: len}};
            }
            A.deallocate[u16](a, data, capacity::usize);
            if (capacity > 0x3fffffff) { ret res[WidePath, Error].err{unavailable("compiler path exceeds the native conversion range")}; }
            capacity = capacity * 2;
        }
        ret res[WidePath, Error].err{internal("compiler path discovery did not finish")};
    }

    fun windows_digest(a: *A.Allocator, out: *u8) err[Error] {
        val image: ptr = GetModuleHandleW(nil);
        if (image == nil) { ret err[Error].err{windows_failure("cannot locate the running compiler image")}; }
        val named: res[WidePath, Error] = windows_path(a, 0, image, 0);
        if (sel named.err) { ret err[Error].err{named.err}; }
        val path: WidePath = named.ok;
        fin { A.deallocate[u16](a, path.data, path.capacity::usize); }
        # deny write/delete sharing while verifying mapping association and hashing
        val guard: isize = CreateFileW(path.data, 0x80000000, 1, nil, 3, 0x80, 0);
        if (guard == (0 - 1)) { ret err[Error].err{windows_failure("cannot retain the running compiler file")}; }
        var computed: [32]u8;
        val hashed: err[Error] = windows_guarded_digest(a, image, guard, path, ?computed[0]);
        val close_ok: i32 = CloseHandle(guard);
        if (close_ok == 0) { ret err[Error].err{internal("cannot close the compiler identity guard")}; }
        if (sel hashed.err) { ret hashed; }
        memory.raw_copy(out::ptr, (?computed[0])::ptr, 32);
        ret err[Error].ok{};
    }

    fun windows_guarded_digest(a: *A.Allocator, image: ptr, guard: isize, path: WidePath, out: *u8) err[Error] {
        val mapped_r: res[WidePath, Error] = windows_path(a, 1, image, guard);
        if (sel mapped_r.err) { ret err[Error].err{mapped_r.err}; }
        val mapped: WidePath = mapped_r.ok;
        fin { A.deallocate[u16](a, mapped.data, mapped.capacity::usize); }
        val final_r: res[WidePath, Error] = windows_path(a, 2, image, guard);
        if (sel final_r.err) { ret err[Error].err{final_r.err}; }
        val final_path: WidePath = final_r.ok;
        fin { A.deallocate[u16](a, final_path.data, final_path.capacity::usize); }
        if (mapped.len != final_path.len || !memory.raw_equal(mapped.data::ptr, final_path.data::ptr, mapped.len::usize * 2)) {
            ret err[Error].err{unavailable("compiler path no longer names the running image")};
        }
        var native_id: FileId;
        if (GetFileInformationByHandleEx(guard, 18, (?native_id)::ptr, $size_of(FileId)::u32) == 0) {
            ret err[Error].err{windows_failure("cannot identify the retained compiler file")};
        }
        var expected: fs.Identity = identities.native(identities.WINDOWS_LOCAL, native_id.volume, 0);
        var i: usize = 0;
        for (i < 16) { expected.representation[25 + i] = native_id.file[i]; i = i + 1; }
        val bytes: i32 = WideCharToMultiByte(65001, 0x80, path.data, path.len::i32, nil, 0, nil, nil);
        if (bytes <= 0) { ret err[Error].err{windows_failure("cannot encode the compiler path as utf-8")}; }
        val allocated: res[*u8, A.Error] = A.allocate[u8](a, bytes::usize + 1);
        if (sel allocated.err) { ret err[Error].err{internal(lang_alloc.text(allocated.err))}; }
        val text: *u8 = allocated.ok;
        fin { A.deallocate[u8](a, text, bytes::usize + 1); }
        if (WideCharToMultiByte(65001, 0x80, path.data, path.len::i32, text, bytes, nil, nil) != bytes) {
            ret err[Error].err{windows_failure("compiler path conversion failed")};
        }
        text[bytes::usize] = 0;
        ret identified_digest(text::str, expected, out);
    }
}

fun running_digest(alloc: *A.Allocator, out: *u8) err[Error] {
    $if ($mach.build.os == $mach.os.linux) {
        val opened: res[fs.File, io_error.Error] = fs.open("/proc/self/exe");
        if (sel opened.err) { ret err[Error].err{io_failure(opened.err)}; }
        var held: fs.File = opened.ok;
        ret finish_owned(?held, out); }
    $or ($mach.build.os == $mach.os.darwin) { ret darwin_digest(out); }
    $or ($mach.build.os == $mach.os.windows) { ret windows_digest(alloc, out); }
    $or { ret err[Error].err{unavailable("running compiler identity is unavailable on this host")}; }
}

# the build id the linker wrote into the running image, read from its mapped
# headers; 0 when the image carries none (a compiler linked by a seed that
# predates the note) or the host has no reader
fun running_build_id(out: *u8) usize {
    $if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin || $mach.build.os == $mach.os.windows) {
        ret mapped_build_id(out);
    }
    $or { ret 0; }
}

# the running image cannot change under a live process (text-busy on linux,
# share-denied on windows, identity-checked on darwin), so one identity serves
# every build unit the process executes; each unit begins a fresh project, and
# only the operation setup on the main thread asks for it
var memo_valid: bool = false;
var memo: Identity;

# identifies the current executable, never argv[0], once per process: the
# linker's build id when the image carries one, else its sha-256
# success fills the identity, failure leaves the output and the memo untouched
pub fun identity(alloc: *A.Allocator, out: *Identity) err[Error] {
    if (alloc == nil || out == nil) { ret err[Error].err{internal("compiler identity allocator or output is missing")}; }
    if (memo_valid) { @out = memo; ret err[Error].ok{}; }
    var found: Identity;
    identity_clear(?found);
    found.len = running_build_id(?found.bytes[0]);
    if (found.len > 0) { found.source = SOURCE_BUILD_ID; }
    or {
        val hashed: err[Error] = running_digest(alloc, ?found.bytes[0]);
        if (sel hashed.err) { ret hashed; }
        found.len = 32;
        found.source = SOURCE_DIGEST;
    }
    memo = found;
    memo_valid = true;
    @out = memo;
    ret err[Error].ok{};
}

test "mach.lang.build.cache.compiler:second_identity_is_served_from_the_memo" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var first: Identity;
    val found: err[Error] = identity(?alloc, ?first);
    if (sel found.err) {
        if (found.err.kind == UNAVAILABLE) { ret 0; }
        ret 2;
    }
    if (!memo_valid) { ret 3; }
    if (first.source != SOURCE_BUILD_ID && first.source != SOURCE_DIGEST) { ret 4; }
    if (first.len == 0 || first.len > 32) { ret 5; }
    var second: Identity;
    val identity_r: err[Error] = identity(?alloc, ?second);
    if (sel identity_r.err) { ret 6; }
    if (!identity_equal(?first, ?second)) { ret 7; }
    # a perturbed memo must show through, proving the second call did not rederive
    val kept: u8 = memo.bytes[0];
    memo.bytes[0] = kept ^ 0xff;
    var third: Identity;
    val served: err[Error] = identity(?alloc, ?third);
    memo.bytes[0] = kept;
    if (sel served.err) { ret 8; }
    if (third.bytes[0] != (kept ^ 0xff)) { ret 8; }
    ret 0;
}

# the test binary is linked by the compiler under test, which emits the note,
# so the identity is the build id and no file is hashed; the note must also
# be exactly what the file carries
test "mach.lang.build.cache.compiler:identity_is_the_mapped_build_id" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var found: Identity;
    val got: err[Error] = identity(?alloc, ?found);
    if (sel got.err) {
        if (got.err.kind == UNAVAILABLE) { ret 0; }
        ret 2;
    }
    if (found.source != SOURCE_BUILD_ID) { ret 3; }
    $if ($mach.build.os == $mach.os.linux) { if (found.len != 32) { ret 4; } }
    $or { if (found.len != 16) { ret 4; } }
    var zero: bool = true;
    var i: usize = 0;
    for (i < found.len) { if (found.bytes[i] != 0) { zero = false; } i = i + 1; }
    if (zero) { ret 5; }
    var again: [32]u8;
    if (running_build_id(?again[0]) != found.len || !memory.raw_equal((?again[0])::ptr, (?found.bytes[0])::ptr, found.len)) { ret 6; }
    ret 0;
}

test "mach.lang.build.cache.compiler:missing_allocator_keeps_output_untouched" {
    var output: Identity;
    identity_clear(?output);
    output.bytes[0] = 0xa5;
    output.len = 7;
    val result: err[Error] = identity(nil, ?output);
    if (sel result.ok) { ret 1; }
    if (result.err.kind != INTERNAL) { ret 1; }
    if (output.bytes[0] != 0xa5 || output.len != 7) { ret 2; }
    ret 0;
}
