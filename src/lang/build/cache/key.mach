use std.crypto.hash.sha256;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use O: std.types.option;
use R: std.types.result;
use mach.lang.intern;

pub rec Builder {
    state: sha256.State;
    error: str;
}

pub fun begin(domain: str) Builder {
    var b: Builder = Builder{state: sha256.init()};
    text(?b, domain);
    ret b;
}

pub fun number(b: *Builder, value: u64) {
    if (b.error != nil) { ret; }
    var wire: [8]u8;
    var i: usize = 0;
    for (i < 8) { wire[i] = (value >> (i * 8))::u8; i = i + 1; }
    sha256.update(?b.state, ?wire[0], 8);
}

pub fun bytes(b: *Builder, data: *u8, len: usize) {
    if (b.error != nil) { ret; }
    if (data == nil && len != 0) { b.error = "cache key has a nonempty input without bytes"; ret; }
    number(b, len::u64);
    if (len != 0) { sha256.update(?b.state, data, len); }
}

pub fun text(b: *Builder, value: str) {
    if (value == nil) { number(b, 0); ret; }
    number(b, 1);
    bytes(b, value, str_len(value));
}

pub fun name(b: *Builder, itn: *intern.Interner, id: intern.StrId) {
    if (b.error != nil) { ret; }
    if (id == intern.STR_NIL) { text(b, nil); ret; }
    val value: O.Option[str] = intern.lookup(itn, id);
    if (O.is_none[str](value)) { b.error = "cache key name is absent from its interner"; ret; }
    text(b, O.unwrap[str](value));
}

pub fun finish(b: *Builder, digest: *[32]u8) R.Result[R.Void, str] {
    if (b.error != nil) { ret R.err[R.Void, str](b.error); }
    if (digest == nil) { ret R.err[R.Void, str]("cache key has no digest destination"); }
    sha256.final(?b.state, ?(@digest)[0]);
    ret R.ok_void[str]();
}

pub fun equal(left: *[32]u8, right: *[32]u8) bool {
    var i: usize = 0;
    for (i < 32) { if ((@left)[i] != (@right)[i]) { ret false; } i = i + 1; }
    ret true;
}

pub fun object(snapshot: *[32]u8, module: str, out: *[32]u8) R.Result[R.Void, str] {
    var b: Builder = begin("mach.object-image");
    bytes(?b, ?(@snapshot)[0], 32);
    text(?b, module);
    ret finish(?b, out);
}

pub fun step(prior: *[32]u8, owner: str, name: str, inputs: *[32]u8) R.Result[R.Void, str] {
    var b: Builder = begin("mach.executed-step");
    bytes(?b, ?(@prior)[0], 32);
    text(?b, owner);
    text(?b, name);
    bytes(?b, ?(@inputs)[0], 32);
    ret finish(?b, prior);
}

use allocator: mach.lang.legacy.allocator;
use page: mach.lang.legacy.page;

test "mach.lang.build.cache.key:framing_domain_and_interning_are_process_independent" {
    var a: allocator.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var left: intern.Interner = intern.init(?a);
    var right: intern.Interner = intern.init(?a);
    fin { intern.dnit(?left); intern.dnit(?right); }
    val original: R.Result[intern.StrId, str] = intern.intern(?left, "module");
    val other: R.Result[intern.StrId, str] = intern.intern(?right, "unrelated");
    val copy: R.Result[intern.StrId, str] = intern.intern(?right, "module");
    if (R.is_err[intern.StrId, str](original) || R.is_err[intern.StrId, str](other)
        || R.is_err[intern.StrId, str](copy)) { ret 2; }
    var l: Builder = begin("object");
    var r: Builder = begin("object");
    name(?l, ?left, R.unwrap_ok[intern.StrId, str](original));
    name(?r, ?right, R.unwrap_ok[intern.StrId, str](copy));
    var ld: [32]u8;
    var rd: [32]u8;
    if (R.is_err[R.Void, str](finish(?l, ?ld)) || R.is_err[R.Void, str](finish(?r, ?rd)) || !equal(?ld, ?rd)) { ret 3; }
    l = begin("object"); r = begin("object");
    text(?l, "ab"); text(?l, "c"); text(?r, "a"); text(?r, "bc");
    finish(?l, ?ld); finish(?r, ?rd);
    if (equal(?ld, ?rd)) { ret 4; }
    l = begin("object"); r = begin("object");
    text(?l, nil); text(?r, "");
    finish(?l, ?ld); finish(?r, ?rd);
    if (equal(?ld, ?rd)) { ret 5; }
    l = begin("object"); r = begin("link");
    text(?l, "same"); text(?r, "same");
    finish(?l, ?ld); finish(?r, ?rd);
    if (equal(?ld, ?rd)) { ret 6; }
    l = begin("object"); name(?l, ?left, 1000);
    if (R.is_ok[R.Void, str](finish(?l, ?ld))) { ret 7; }
    ret 0;
}
