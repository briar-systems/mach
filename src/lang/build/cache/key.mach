use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use mach.lang.fail;
use std.crypto.hash.sha256;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use mach.lang.intern;

pub rec Builder {
    state: sha256.State;
    error: str;
}

pub fun begin(domain: str) Builder {
    var b: Builder = Builder{state: sha256.init()};
    text(?b, domain);
    ret b;
}

pub fun number(b: *Builder, value: u64) {
    if (b.error != nil) { ret; }
    var wire: [8]u8;
    var i: usize = 0;
    for (i < 8) { wire[i] = (value >> (i * 8))::u8; i = i + 1; }
    sha256.update(?b.state, ?wire[0], 8);
}

pub fun bytes(b: *Builder, data: *u8, len: usize) {
    if (b.error != nil) { ret; }
    if (data == nil && len != 0) { b.error = "cache key has a nonempty input without bytes"; ret; }
    number(b, len::u64);
    if (len != 0) { sha256.update(?b.state, data, len); }
}

pub fun text(b: *Builder, value: str) {
    if (value == nil) { number(b, 0); ret; }
    number(b, 1);
    bytes(b, value, str_len(value));
}

pub fun name(b: *Builder, itn: *intern.Interner, id: intern.StrId) {
    if (b.error != nil) { ret; }
    if (id == intern.STR_NIL) { text(b, nil); ret; }
    val value: opt[str] = intern.lookup(itn, id);
    if (sel value.none) { b.error = "cache key name is absent from its interner"; ret; }
    text(b, value.some);
}

pub fun finish(b: *Builder, digest: *[32]u8) err[fail.Fail] {
    if (b.error != nil) { ret err[fail.Fail].err{fail.message(b.error)}; }
    if (digest == nil) { ret err[fail.Fail].err{fail.message("cache key has no digest destination")}; }
    sha256.final(?b.state, ?(@digest)[0]);
    ret err[fail.Fail].ok{};
}

pub fun equal(left: *[32]u8, right: *[32]u8) bool {
    var i: usize = 0;
    for (i < 32) { if ((@left)[i] != (@right)[i]) { ret false; } i = i + 1; }
    ret true;
}

pub fun object(snapshot: *[32]u8, module: str, out: *[32]u8) err[fail.Fail] {
    var b: Builder = begin("mach.object-image");
    bytes(?b, ?(@snapshot)[0], 32);
    text(?b, module);
    ret finish(?b, out);
}

pub fun step(prior: *[32]u8, owner: str, name: str, inputs: *[32]u8) err[fail.Fail] {
    var b: Builder = begin("mach.executed-step");
    bytes(?b, ?(@prior)[0], 32);
    text(?b, owner);
    text(?b, name);
    bytes(?b, ?(@inputs)[0], 32);
    ret finish(?b, prior);
}

use allocator: std.allocator;
use page: std.allocator.page;

test "mach.lang.build.cache.key:framing_domain_and_interning_are_process_independent" {
    var a: allocator.Allocator;
    val make_r: err[allocator.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var left: intern.Interner = intern.init(?a);
    var right: intern.Interner = intern.init(?a);
    fin { intern.dnit(?left); intern.dnit(?right); }
    val original: res[intern.StrId, allocator.Error] = intern.intern(?left, "module");
    val other: res[intern.StrId, allocator.Error] = intern.intern(?right, "unrelated");
    val copy: res[intern.StrId, allocator.Error] = intern.intern(?right, "module");
    if (sel original.err) { ret 2; }
    if (sel other.err) { ret 2; }
    if (sel copy.err) { ret 2; }
    var l: Builder = begin("object");
    var r: Builder = begin("object");
    name(?l, ?left, original.ok);
    name(?r, ?right, copy.ok);
    var ld: [32]u8;
    var rd: [32]u8;
    val finish_r2: err[fail.Fail] = finish(?l, ?ld);
    if (sel finish_r2.err) { ret 3; }
    val finish_r: err[fail.Fail] = finish(?r, ?rd);
    if (sel finish_r.err) { ret 3; }
    if (!equal(?ld, ?rd)) { ret 3; }
    l = begin("object"); r = begin("object");
    text(?l, "ab"); text(?l, "c"); text(?r, "a"); text(?r, "bc");
    finish(?l, ?ld); finish(?r, ?rd);
    if (equal(?ld, ?rd)) { ret 4; }
    l = begin("object"); r = begin("object");
    text(?l, nil); text(?r, "");
    finish(?l, ?ld); finish(?r, ?rd);
    if (equal(?ld, ?rd)) { ret 5; }
    l = begin("object"); r = begin("link");
    text(?l, "same"); text(?r, "same");
    finish(?l, ?ld); finish(?r, ?rd);
    if (equal(?ld, ?rd)) { ret 6; }
    l = begin("object"); name(?l, ?left, 1000);
    val finish_r3: err[fail.Fail] = finish(?l, ?ld);
    if (sel finish_r3.ok) { ret 7; }
    ret 0;
}
