use std.types.canonical.res;
use std.types.canonical.err;
use mach.lang.build.outcome;
use page: std.allocator.page;
use std.text.string.str_free;
use std.crypto.hash.sha256;
use binary: std.encoding.binary;
use fs: std.filesystem;
use io_error: std.io.error;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_len;

use A: std.allocator;

pub def Domain: u16;

pub val DOMAIN_SUBSYSTEM: Domain = 1;
pub val DOMAIN_BUILD_GOAL: Domain = 2;
pub val DOMAIN_ARCH: Domain = 3;
pub val DOMAIN_ABI:  Domain = 4;
pub val DOMAIN_OS:   Domain = 5;
pub val DOMAIN_BUILD_STEP: Domain = 6;

val DOMAIN_COUNT: usize = 12;
val DOMAINS: [DOMAIN_COUNT]Domain = [DOMAIN_COUNT]Domain{
    DOMAIN_SUBSYSTEM, DOMAIN_BUILD_GOAL, DOMAIN_ARCH,
    DOMAIN_ABI, DOMAIN_OS, DOMAIN_BUILD_STEP,
    DOMAIN_OF, DOMAIN_DEBUG, DOMAIN_TARGET_MODEL,
    DOMAIN_BACKEND, DOMAIN_IMAGE, DOMAIN_FS_POLICY,
};

pub val DOMAIN_OF:            Domain = 7;
pub val DOMAIN_DEBUG:         Domain = 8;
pub val DOMAIN_TARGET_MODEL:  Domain = 9;
pub val DOMAIN_BACKEND:       Domain = 10;
pub val DOMAIN_IMAGE:         Domain = 11;
pub val DOMAIN_FS_POLICY:     Domain = 12;

pub val FILE_DIGEST_CHUNK: usize = 8192;

pub fun file_sha256(path: str, digest: *u8) err[outcome.Fail] {
    if (path == nil || digest == nil) { ret err[outcome.Fail].err{outcome.internal("file digest input or output is missing")}; }
    val open_r: res[fs.File, io_error.Error] = fs.open(path);
    if (sel open_r.err) {
        ret err[outcome.Fail].err{outcome.internal(io_error.message(open_r.err))};
    }
    var f: fs.File = open_r.ok;
    var opened: bool = true;
    fin { if (opened) { fs.close(?f); } }
    val before_r: res[fs.Metadata, io_error.Error] = fs.stat_of(f);
    if (sel before_r.err) {
        ret err[outcome.Fail].err{outcome.internal(outcome.io_text(before_r.err))};
    }
    val before: fs.Metadata = before_r.ok;
    if (!fs.meta_is_file(?before)) { ret err[outcome.Fail].err{outcome.internal("cannot digest a non-file path")}; }
    val identity_r: res[fs.Identity, io_error.Error] = fs.identity_of(f);
    if (sel identity_r.err) {
        ret err[outcome.Fail].err{outcome.internal(io_error.message(identity_r.err))};
    }
    val identity: fs.Identity = identity_r.ok;

    var computed: [32]u8;
    val hashed: err[outcome.Fail] = held_file_sha256(f, ?computed[0]);
    if (sel hashed.err) { ret hashed; }
    val validated: err[outcome.Fail] = validate_digest_input(path, f, before, identity);
    if (sel validated.err) { ret validated; }
    val closed: err[io_error.Error] = fs.close(?f);
    opened = false;
    if (sel closed.err) {
        ret err[outcome.Fail].err{outcome.internal(io_error.message(closed.err))};
    }
    var i: usize = 0;
    for (i < 32) { digest[i] = computed[i]; i = i + 1; }
    ret err[outcome.Fail].ok{};
}

# borrows the file and exclusive seek/read access, rewinds first and leaves it at eof
# failure does not publish a digest, the caller retains close ownership
pub fun held_file_sha256(f: fs.File, digest: *u8) err[outcome.Fail] {
    if (digest == nil) { ret err[outcome.Fail].err{outcome.internal("file digest output is missing")}; }
    val before_r: res[fs.Metadata, io_error.Error] = fs.stat_of(f);
    if (sel before_r.err) { ret err[outcome.Fail].err{outcome.internal(outcome.io_text(before_r.err))}; }
    val before: fs.Metadata = before_r.ok;
    if (!fs.meta_is_file(?before)) { ret err[outcome.Fail].err{outcome.internal("cannot digest a non-file handle")}; }
    val rewound: res[i64, io_error.Error] = fs.seek(f, 0, fs.SEEK_SET);
    if (sel rewound.err) {
        ret err[outcome.Fail].err{outcome.internal(io_error.message(rewound.err))};
    }
    if (rewound.ok != 0) { ret err[outcome.Fail].err{outcome.internal("file digest could not rewind its input")}; }
    var st: sha256.State = sha256.init();
    var total: usize = 0;
    var buf: [8192]u8;
    for {
        val rr: res[usize, io_error.Error] = fs.read(f, ?buf[0], FILE_DIGEST_CHUNK);
        if (sel rr.err) {
            ret err[outcome.Fail].err{outcome.internal(io_error.message(rr.err))};
        }
        val n: usize = rr.ok;
        if (n == 0) { brk; }
        if (n > before.size - total) { ret err[outcome.Fail].err{outcome.internal("file grew while computing its digest")}; }
        total = total + n;
        sha256.update(?st, ?buf[0], n);
    }
    if (total != before.size) { ret err[outcome.Fail].err{outcome.internal("file shrank while computing its digest")}; }
    val stable: err[outcome.Fail] = validate_held_digest_input(f, before);
    if (sel stable.err) { ret stable; }
    sha256.final(?st, digest);
    ret err[outcome.Fail].ok{};
}

fun validate_digest_input(path: str, held: fs.File, before: fs.Metadata, identity: fs.Identity) err[outcome.Fail] {
    # follow the same path semantics while keeping the hashed object retained
    val opened: res[fs.File, io_error.Error] = fs.open(path);
    if (sel opened.err) {
        ret err[outcome.Fail].err{outcome.internal(io_error.message(opened.err))};
    }
    var current: fs.File = opened.ok;
    val observed: res[fs.Identity, io_error.Error] = fs.identity_of(current);
    val closed: err[io_error.Error] = fs.close(?current);
    if (sel observed.err) {
        ret err[outcome.Fail].err{outcome.internal(io_error.message(observed.err))};
    }
    if (sel closed.err) {
        ret err[outcome.Fail].err{outcome.internal(io_error.message(closed.err))};
    }
    if (!fs.identity_equal(identity, observed.ok)) {
        ret err[outcome.Fail].err{outcome.internal("file changed while computing its digest")};
    }
    ret validate_held_digest_input(held, before);
}

fun validate_held_digest_input(held: fs.File, before: fs.Metadata) err[outcome.Fail] {
    val after_r: res[fs.Metadata, io_error.Error] = fs.stat_of(held);
    if (sel after_r.err) { ret err[outcome.Fail].err{outcome.internal(outcome.io_text(after_r.err))}; }
    val after: fs.Metadata = after_r.ok;
    if (!fs.meta_is_file(?after) || before.size != after.size
        || before.modified.sec != after.modified.sec
        || before.modified.nsec != after.modified.nsec) {
        ret err[outcome.Fail].err{outcome.internal("file changed while computing its digest")};
    }
    ret err[outcome.Fail].ok{};
}

pub fun write_domain_u8(e: *binary.Encoder, domain: Domain, schema_version: u8, value: u8) bool {
    var ok: bool = true;
    if (ok) {
        val write_u16_r: res[usize, binary.EncodeError] = binary.write_u16(e, domain); ok = sel write_u16_r.ok; }
    if (ok) {
        val write_u8_r: res[usize, binary.EncodeError] = binary.write_u8(e, schema_version); ok = sel write_u8_r.ok; }
    if (ok) {
        val write_u8_r2: res[usize, binary.EncodeError] = binary.write_u8(e, value); ok = sel write_u8_r2.ok; }
    ret ok;
}

pub fun write_domain_u32(e: *binary.Encoder, domain: Domain, schema_version: u8, value: u32) bool {
    var ok: bool = true;
    if (ok) {
        val write_u16_r: res[usize, binary.EncodeError] = binary.write_u16(e, domain); ok = sel write_u16_r.ok; }
    if (ok) {
        val write_u8_r: res[usize, binary.EncodeError] = binary.write_u8(e, schema_version); ok = sel write_u8_r.ok; }
    if (ok) {
        val write_u32_r: res[usize, binary.EncodeError] = binary.write_u32(e, value); ok = sel write_u32_r.ok; }
    ret ok;
}

pub fun write_domain_u64(e: *binary.Encoder, domain: Domain, schema_version: u8, value: u64) bool {
    var ok: bool = true;
    if (ok) {
        val write_u16_r: res[usize, binary.EncodeError] = binary.write_u16(e, domain); ok = sel write_u16_r.ok; }
    if (ok) {
        val write_u8_r: res[usize, binary.EncodeError] = binary.write_u8(e, schema_version); ok = sel write_u8_r.ok; }
    if (ok) {
        val write_u64_r: res[usize, binary.EncodeError] = binary.write_u64(e, value); ok = sel write_u64_r.ok; }
    ret ok;
}

pub fun write_domain_bytes(e: *binary.Encoder, domain: Domain, schema_version: u8, p: *u8, len: usize) bool {
    if (len > 0xFFFFFFFF::usize) { ret false; }
    var ok: bool = true;
    if (ok) {
        val write_u16_r: res[usize, binary.EncodeError] = binary.write_u16(e, domain); ok = sel write_u16_r.ok; }
    if (ok) {
        val write_u8_r: res[usize, binary.EncodeError] = binary.write_u8(e, schema_version); ok = sel write_u8_r.ok; }
    if (ok) {
        val write_u32_r: res[usize, binary.EncodeError] = binary.write_u32(e, len::u32); ok = sel write_u32_r.ok; }
    if (ok) {
        val write_bytes_r: res[usize, binary.EncodeError] = binary.write_bytes(e, p, len); ok = sel write_bytes_r.ok; }
    ret ok;
}

pub fun write_domain_str(e: *binary.Encoder, domain: Domain, schema_version: u8, s: str) bool {
    ret write_domain_bytes(e, domain, schema_version, s::*u8, str_len(s));
}

test "mach.lang.build.fingerprint.write_domain_u8:domain_separated" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!write_domain_u8(?ea, 1, 1, 5)) { ret 1; }
    if (!write_domain_u8(?eb, 2, 1, 5)) { ret 1; }

    if (ea.len != eb.len) { ret 1; }
    if (bytes_eq(ea.data, eb.data, ea.len)) { ret 1; }

    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);
    ret 0;
}

test "mach.lang.build.fingerprint.write_domain_u8:schema_version_separated" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!write_domain_u8(?ea, 1, 1, 5)) { ret 1; }
    if (!write_domain_u8(?eb, 1, 2, 5)) { ret 1; }

    if (ea.len != eb.len) { ret 1; }
    if (bytes_eq(ea.data, eb.data, ea.len)) { ret 1; }

    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);
    ret 0;
}

test "mach.lang.build.fingerprint.write_domain_u8:value_changes_bytes" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!write_domain_u8(?ea, 1, 1, 5)) { ret 1; }
    if (!write_domain_u8(?eb, 1, 1, 6)) { ret 1; }

    if (ea.len != eb.len) { ret 1; }
    if (bytes_eq(ea.data, eb.data, ea.len)) { ret 1; }

    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);
    ret 0;
}

test "mach.lang.build.fingerprint.write_domain_u8:deterministic" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!write_domain_u8(?ea, DOMAIN_SUBSYSTEM, 1, 2)) { ret 1; }
    if (!write_domain_u8(?eb, DOMAIN_SUBSYSTEM, 1, 2)) { ret 1; }

    if (ea.len != eb.len)                      { ret 1; }
    if (!bytes_eq(ea.data, eb.data, ea.len))    { ret 1; }

    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);
    ret 0;
}

test "mach.lang.build.fingerprint.write_domain_bytes:length_delimited_unambiguous" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);

    if (!write_domain_str(?ea, 1, 1, "ab")) { ret 1; }
    if (!write_domain_str(?ea, 1, 1, "c"))  { ret 1; }

    if (!write_domain_str(?eb, 1, 1, "a"))  { ret 1; }
    if (!write_domain_str(?eb, 1, 1, "bc")) { ret 1; }

    if (ea.len != eb.len) { ret 1; }
    if (bytes_eq(ea.data, eb.data, ea.len)) { ret 1; }

    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);
    ret 0;
}

test "mach.lang.build.fingerprint.write_domain_u8:registered_domains_do_not_collide" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val n: usize = DOMAIN_COUNT;

    var i: usize = 0;
    for (i < n) {
        var j: usize = 0;
        for (j < n) {
            if (i != j) {
                if (DOMAINS[i] == DOMAINS[j]) { ret 1; }

                var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
                var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
                if (!write_domain_u8(?ea, DOMAINS[i], 1, 1)) { ret 1; }
                if (!write_domain_u8(?eb, DOMAINS[j], 1, 1)) { ret 1; }

                if (ea.len != eb.len) { ret 1; }
                if (bytes_eq(ea.data, eb.data, ea.len)) { ret 1; }

                binary.encoder_dnit(?ea);
                binary.encoder_dnit(?eb);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

fun bytes_eq(a: *u8, b: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.build.fingerprint.write_domain_u32:value_changes_bytes_and_is_deterministic" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!write_domain_u32(?ea, DOMAIN_TARGET_MODEL, 1, 0xAABBCCDD)) { ret 1; }
    if (!write_domain_u32(?eb, DOMAIN_TARGET_MODEL, 1, 0xAABBCCDE)) { ret 1; }
    if (ea.len != eb.len)                   { ret 1; }
    if (bytes_eq(ea.data, eb.data, ea.len))  { ret 1; }
    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);

    var ec: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var ed: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!write_domain_u32(?ec, DOMAIN_TARGET_MODEL, 1, 7)) { ret 1; }
    if (!write_domain_u32(?ed, DOMAIN_TARGET_MODEL, 1, 7)) { ret 1; }
    if (ec.len != ed.len)                    { ret 1; }
    if (!bytes_eq(ec.data, ed.data, ec.len))  { ret 1; }
    binary.encoder_dnit(?ec);
    binary.encoder_dnit(?ed);
    ret 0;
}

test "mach.lang.build.fingerprint.write_domain_u64:value_changes_bytes_and_is_deterministic" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!write_domain_u64(?ea, DOMAIN_IMAGE, 1, 0x0000000000400000)) { ret 1; }
    if (!write_domain_u64(?eb, DOMAIN_IMAGE, 1, 0x0000000000400001)) { ret 1; }
    if (ea.len != eb.len)                   { ret 1; }
    if (bytes_eq(ea.data, eb.data, ea.len))  { ret 1; }
    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);

    var ec: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var ed: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!write_domain_u64(?ec, DOMAIN_IMAGE, 1, 9)) { ret 1; }
    if (!write_domain_u64(?ed, DOMAIN_IMAGE, 1, 9)) { ret 1; }
    if (ec.len != ed.len)                    { ret 1; }
    if (!bytes_eq(ec.data, ed.data, ec.len))  { ret 1; }
    binary.encoder_dnit(?ec);
    binary.encoder_dnit(?ed);
    ret 0;
}

fun t_digest_observation_case(replace: bool) i32 {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val created: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach-digest-held");
    if (sel created.err) { ret 1; }
    var original: fs.TempFile = created.ok;
    fin { fs.temp_close_and_remove(?original); str_free(?alloc, original.path); }
    val written: res[usize, io_error.Error] = fs.write(original.file, "abc"::*u8, 3::usize);
    if (sel written.err) { ret 1; }
    if (written.ok != 3) { ret 1; }
    var digest: [32]u8;
    val file_sha256_r: err[outcome.Fail] = file_sha256(original.path, ?digest[0]);
    if (sel file_sha256_r.err) { ret 2; }
    val expected: [32]u8 = [32]u8{0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,
        0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23, 0xb0, 0x03, 0x61, 0xa3,
        0x96, 0x17, 0x7a, 0x9c, 0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad};
    if (!bytes_eq(?digest[0], ?expected[0], 32::usize)) { ret 2; }
    val observed: res[fs.Metadata, io_error.Error] = fs.stat_of(original.file);
    val identified: res[fs.Identity, io_error.Error] = fs.identity_of(original.file);
    if (sel observed.err) { ret 1; }
    if (sel identified.err) { ret 1; }
    val before: fs.Metadata = observed.ok;
    val identity: fs.Identity = identified.ok;
    val validate_digest_input_r: err[outcome.Fail] = validate_digest_input(original.path, original.file, before, identity);
    if (sel validate_digest_input_r.err) { ret 2; }
    if (replace) {
        val replacement: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach-digest-replacement");
        if (sel replacement.err) { ret 1; }
        var fresh: fs.TempFile = replacement.ok;
        fin { fs.temp_close_and_remove(?fresh); str_free(?alloc, fresh.path); }
        val filled: res[usize, io_error.Error] = fs.write(fresh.file, "abc"::*u8, 3::usize);
        if (sel filled.err) { ret 1; }
        if (filled.ok != 3) { ret 1; }
        val rename_r: err[io_error.Error] = fs.rename(fresh.path, original.path);
        if (sel rename_r.err) { ret 1; }
    }
    or {
        val filled: res[usize, io_error.Error] = fs.write(original.file, "d"::*u8, 1::usize);
        if (sel filled.err) { ret 1; }
        if (filled.ok != 1) { ret 1; }
    }
    val validate_digest_input_r2: err[outcome.Fail] = validate_digest_input(original.path, original.file, before, identity);
    if (sel validate_digest_input_r2.ok) { ret 3; }
    ret 0;
}

test "mach.lang.build.fingerprint.file_sha256:rejects_path_replacement_while_object_is_held" {
    ret t_digest_observation_case(true);
}

test "mach.lang.build.fingerprint.file_sha256:rejects_changes_to_the_held_object" {
    ret t_digest_observation_case(false);
}


test "mach.lang.build.fingerprint.held_file_sha256:rewinds_and_borrows_the_complete_file" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val created: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach-held-digest");
    if (sel created.err) { ret 1; }
    var file: fs.TempFile = created.ok;
    fin { fs.temp_close_and_remove(?file); str_free(?alloc, file.path); }
    val written: res[usize, io_error.Error] = fs.write(file.file, "abc"::*u8, 3);
    if (sel written.err) { ret 2; }
    if (written.ok != 3) { ret 2; }
    val seeked: res[i64, io_error.Error] = fs.seek(file.file, 1, fs.SEEK_SET);
    if (sel seeked.err) { ret 3; }
    var digest: [32]u8;
    val held_file_sha256_r: err[outcome.Fail] = held_file_sha256(file.file, ?digest[0]);
    if (sel held_file_sha256_r.err) { ret 4; }
    val expected: [32]u8 = [32]u8{0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,
        0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23, 0xb0, 0x03, 0x61, 0xa3,
        0x96, 0x17, 0x7a, 0x9c, 0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad};
    if (!bytes_eq(?digest[0], ?expected[0], 32)) { ret 5; }
    val position: res[i64, io_error.Error] = fs.seek(file.file, 0, fs.SEEK_CUR);
    if (sel position.err) { ret 6; }
    if (position.ok != 3) { ret 6; }
    val held_file_sha256_r2: err[outcome.Fail] = held_file_sha256(file.file, ?digest[0]);
    if (sel held_file_sha256_r2.err) { ret 7; }
    if (!bytes_eq(?digest[0], ?expected[0], 32)) { ret 7; }
    ret 0;
}
