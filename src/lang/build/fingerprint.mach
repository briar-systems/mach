use std.allocator.page;
use std.text.string.str_free;
use std.crypto.hash.sha256;
use std.encoding.binary;
use fs: std.filesystem;
use io_error: std.io.error;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_len;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

pub def Domain: u16;

pub val DOMAIN_SUBSYSTEM: Domain = 1;
pub val DOMAIN_BUILD_GOAL: Domain = 2;
pub val DOMAIN_ARCH: Domain = 3;
pub val DOMAIN_ABI:  Domain = 4;
pub val DOMAIN_OS:   Domain = 5;
pub val DOMAIN_BUILD_STEP: Domain = 6;

val DOMAIN_COUNT: usize = 12;
val DOMAINS: [DOMAIN_COUNT]Domain = [DOMAIN_COUNT]Domain{
    DOMAIN_SUBSYSTEM, DOMAIN_BUILD_GOAL, DOMAIN_ARCH,
    DOMAIN_ABI, DOMAIN_OS, DOMAIN_BUILD_STEP,
    DOMAIN_OF, DOMAIN_DEBUG, DOMAIN_TARGET_MODEL,
    DOMAIN_BACKEND, DOMAIN_IMAGE, DOMAIN_FS_POLICY,
};

pub val DOMAIN_OF:            Domain = 7;
pub val DOMAIN_DEBUG:         Domain = 8;
pub val DOMAIN_TARGET_MODEL:  Domain = 9;
pub val DOMAIN_BACKEND:       Domain = 10;
pub val DOMAIN_IMAGE:         Domain = 11;
pub val DOMAIN_FS_POLICY:     Domain = 12;

pub val FILE_DIGEST_CHUNK: usize = 8192;

pub fun file_sha256(path: str, digest: *u8) R.Result[R.Void, str] {
    val open_r: R.Result[fs.File, io_error.Error] = fs.open(path);
    if (R.is_err[fs.File, io_error.Error](open_r)) {
        ret R.err[R.Void, str](io_error.message(R.unwrap_err[fs.File, io_error.Error](open_r)));
    }
    var f: fs.File = R.unwrap_ok[fs.File, io_error.Error](open_r);
    var opened: bool = true;
    fin { if (opened) { fs.close(?f); } }
    val before_r: R.Result[fs.Metadata, str] = fs.stat_of(f);
    if (R.is_err[fs.Metadata, str](before_r)) {
        ret R.err[R.Void, str](R.unwrap_err[fs.Metadata, str](before_r));
    }
    val before: fs.Metadata = R.unwrap_ok[fs.Metadata, str](before_r);
    if (!fs.meta_is_file(?before)) { ret R.err[R.Void, str]("cannot digest a non-file path"); }
    val identity_r: R.Result[fs.Identity, io_error.Error] = fs.identity_of(f);
    if (R.is_err[fs.Identity, io_error.Error](identity_r)) {
        ret R.err[R.Void, str](io_error.message(R.unwrap_err[fs.Identity, io_error.Error](identity_r)));
    }
    val identity: fs.Identity = R.unwrap_ok[fs.Identity, io_error.Error](identity_r);

    var st: sha256.State = sha256.init();
    var buf: [8192]u8;
    for {
        val rr: R.Result[usize, io_error.Error] = fs.read(f, ?buf[0], FILE_DIGEST_CHUNK);
        if (R.is_err[usize, io_error.Error](rr)) {
            ret R.err[R.Void, str](io_error.message(R.unwrap_err[usize, io_error.Error](rr)));
        }
        val n: usize = R.unwrap_ok[usize, io_error.Error](rr);
        if (n == 0) { brk; }
        sha256.update(?st, ?buf[0], n);
    }
    val validated: R.Result[R.Void, str] = validate_digest_input(path, f, before, identity);
    if (R.is_err[R.Void, str](validated)) { ret validated; }
    val closed: O.Option[io_error.Error] = fs.close(?f);
    opened = false;
    if (O.is_some[io_error.Error](closed)) {
        ret R.err[R.Void, str](io_error.message(O.unwrap[io_error.Error](closed)));
    }
    sha256.final(?st, digest);
    ret R.ok_void[str]();
}

fun validate_digest_input(path: str, held: fs.File, before: fs.Metadata, identity: fs.Identity) R.Result[R.Void, str] {
    # follow the same path semantics while keeping the hashed object retained
    val opened: R.Result[fs.File, io_error.Error] = fs.open(path);
    if (R.is_err[fs.File, io_error.Error](opened)) {
        ret R.err[R.Void, str](io_error.message(R.unwrap_err[fs.File, io_error.Error](opened)));
    }
    var current: fs.File = R.unwrap_ok[fs.File, io_error.Error](opened);
    val observed: R.Result[fs.Identity, io_error.Error] = fs.identity_of(current);
    val closed: O.Option[io_error.Error] = fs.close(?current);
    if (R.is_err[fs.Identity, io_error.Error](observed)) {
        ret R.err[R.Void, str](io_error.message(R.unwrap_err[fs.Identity, io_error.Error](observed)));
    }
    if (O.is_some[io_error.Error](closed)) {
        ret R.err[R.Void, str](io_error.message(O.unwrap[io_error.Error](closed)));
    }
    if (!fs.identity_equal(identity, R.unwrap_ok[fs.Identity, io_error.Error](observed))) {
        ret R.err[R.Void, str]("file changed while computing its digest");
    }
    val after_r: R.Result[fs.Metadata, str] = fs.stat_of(held);
    if (R.is_err[fs.Metadata, str](after_r)) { ret R.err[R.Void, str](R.unwrap_err[fs.Metadata, str](after_r)); }
    val after: fs.Metadata = R.unwrap_ok[fs.Metadata, str](after_r);
    if (!fs.meta_is_file(?after) || before.size != after.size
        || before.modified.sec != after.modified.sec
        || before.modified.nsec != after.modified.nsec) {
        ret R.err[R.Void, str]("file changed while computing its digest");
    }
    ret R.ok_void[str]();
}

pub fun write_domain_u8(e: *binary.Encoder, domain: Domain, schema_version: u8, value: u8) bool {
    var ok: bool = true;
    ok = ok && R.is_ok[usize, str](binary.write_u16(e, domain));
    ok = ok && R.is_ok[usize, str](binary.write_u8(e, schema_version));
    ok = ok && R.is_ok[usize, str](binary.write_u8(e, value));
    ret ok;
}

pub fun write_domain_u32(e: *binary.Encoder, domain: Domain, schema_version: u8, value: u32) bool {
    var ok: bool = true;
    ok = ok && R.is_ok[usize, str](binary.write_u16(e, domain));
    ok = ok && R.is_ok[usize, str](binary.write_u8(e, schema_version));
    ok = ok && R.is_ok[usize, str](binary.write_u32(e, value));
    ret ok;
}

pub fun write_domain_u64(e: *binary.Encoder, domain: Domain, schema_version: u8, value: u64) bool {
    var ok: bool = true;
    ok = ok && R.is_ok[usize, str](binary.write_u16(e, domain));
    ok = ok && R.is_ok[usize, str](binary.write_u8(e, schema_version));
    ok = ok && R.is_ok[usize, str](binary.write_u64(e, value));
    ret ok;
}

pub fun write_domain_bytes(e: *binary.Encoder, domain: Domain, schema_version: u8, p: *u8, len: usize) bool {
    if (len > 0xFFFFFFFF::usize) { ret false; }
    var ok: bool = true;
    ok = ok && R.is_ok[usize, str](binary.write_u16(e, domain));
    ok = ok && R.is_ok[usize, str](binary.write_u8(e, schema_version));
    ok = ok && R.is_ok[usize, str](binary.write_u32(e, len::u32));
    ok = ok && R.is_ok[usize, str](binary.write_bytes(e, p, len));
    ret ok;
}

pub fun write_domain_str(e: *binary.Encoder, domain: Domain, schema_version: u8, s: str) bool {
    ret write_domain_bytes(e, domain, schema_version, s::*u8, str_len(s));
}

test "mach.lang.build.fingerprint.write_domain_u8:domain_separated" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!write_domain_u8(?ea, 1, 1, 5)) { ret 1; }
    if (!write_domain_u8(?eb, 2, 1, 5)) { ret 1; }

    if (ea.len != eb.len) { ret 1; }
    if (bytes_eq(ea.data, eb.data, ea.len)) { ret 1; }

    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);
    ret 0;
}

test "mach.lang.build.fingerprint.write_domain_u8:schema_version_separated" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!write_domain_u8(?ea, 1, 1, 5)) { ret 1; }
    if (!write_domain_u8(?eb, 1, 2, 5)) { ret 1; }

    if (ea.len != eb.len) { ret 1; }
    if (bytes_eq(ea.data, eb.data, ea.len)) { ret 1; }

    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);
    ret 0;
}

test "mach.lang.build.fingerprint.write_domain_u8:value_changes_bytes" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!write_domain_u8(?ea, 1, 1, 5)) { ret 1; }
    if (!write_domain_u8(?eb, 1, 1, 6)) { ret 1; }

    if (ea.len != eb.len) { ret 1; }
    if (bytes_eq(ea.data, eb.data, ea.len)) { ret 1; }

    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);
    ret 0;
}

test "mach.lang.build.fingerprint.write_domain_u8:deterministic" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!write_domain_u8(?ea, DOMAIN_SUBSYSTEM, 1, 2)) { ret 1; }
    if (!write_domain_u8(?eb, DOMAIN_SUBSYSTEM, 1, 2)) { ret 1; }

    if (ea.len != eb.len)                      { ret 1; }
    if (!bytes_eq(ea.data, eb.data, ea.len))    { ret 1; }

    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);
    ret 0;
}

test "mach.lang.build.fingerprint.write_domain_bytes:length_delimited_unambiguous" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);

    if (!write_domain_str(?ea, 1, 1, "ab")) { ret 1; }
    if (!write_domain_str(?ea, 1, 1, "c"))  { ret 1; }

    if (!write_domain_str(?eb, 1, 1, "a"))  { ret 1; }
    if (!write_domain_str(?eb, 1, 1, "bc")) { ret 1; }

    if (ea.len != eb.len) { ret 1; }
    if (bytes_eq(ea.data, eb.data, ea.len)) { ret 1; }

    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);
    ret 0;
}

test "mach.lang.build.fingerprint.write_domain_u8:registered_domains_do_not_collide" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val n: usize = DOMAIN_COUNT;

    var i: usize = 0;
    for (i < n) {
        var j: usize = 0;
        for (j < n) {
            if (i != j) {
                if (DOMAINS[i] == DOMAINS[j]) { ret 1; }

                var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
                var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
                if (!write_domain_u8(?ea, DOMAINS[i], 1, 1)) { ret 1; }
                if (!write_domain_u8(?eb, DOMAINS[j], 1, 1)) { ret 1; }

                if (ea.len != eb.len) { ret 1; }
                if (bytes_eq(ea.data, eb.data, ea.len)) { ret 1; }

                binary.encoder_dnit(?ea);
                binary.encoder_dnit(?eb);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

fun bytes_eq(a: *u8, b: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.build.fingerprint.write_domain_u32:value_changes_bytes_and_is_deterministic" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!write_domain_u32(?ea, DOMAIN_TARGET_MODEL, 1, 0xAABBCCDD)) { ret 1; }
    if (!write_domain_u32(?eb, DOMAIN_TARGET_MODEL, 1, 0xAABBCCDE)) { ret 1; }
    if (ea.len != eb.len)                   { ret 1; }
    if (bytes_eq(ea.data, eb.data, ea.len))  { ret 1; }
    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);

    var ec: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var ed: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!write_domain_u32(?ec, DOMAIN_TARGET_MODEL, 1, 7)) { ret 1; }
    if (!write_domain_u32(?ed, DOMAIN_TARGET_MODEL, 1, 7)) { ret 1; }
    if (ec.len != ed.len)                    { ret 1; }
    if (!bytes_eq(ec.data, ed.data, ec.len))  { ret 1; }
    binary.encoder_dnit(?ec);
    binary.encoder_dnit(?ed);
    ret 0;
}

test "mach.lang.build.fingerprint.write_domain_u64:value_changes_bytes_and_is_deterministic" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var ea: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var eb: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!write_domain_u64(?ea, DOMAIN_IMAGE, 1, 0x0000000000400000)) { ret 1; }
    if (!write_domain_u64(?eb, DOMAIN_IMAGE, 1, 0x0000000000400001)) { ret 1; }
    if (ea.len != eb.len)                   { ret 1; }
    if (bytes_eq(ea.data, eb.data, ea.len))  { ret 1; }
    binary.encoder_dnit(?ea);
    binary.encoder_dnit(?eb);

    var ec: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    var ed: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!write_domain_u64(?ec, DOMAIN_IMAGE, 1, 9)) { ret 1; }
    if (!write_domain_u64(?ed, DOMAIN_IMAGE, 1, 9)) { ret 1; }
    if (ec.len != ed.len)                    { ret 1; }
    if (!bytes_eq(ec.data, ed.data, ec.len))  { ret 1; }
    binary.encoder_dnit(?ec);
    binary.encoder_dnit(?ed);
    ret 0;
}

fun t_digest_observation_case(replace: bool) u8 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val created: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach-digest-held");
    if (R.is_err[fs.TempFile, str](created)) { ret 1; }
    var original: fs.TempFile = R.unwrap_ok[fs.TempFile, str](created);
    fin { fs.temp_close_and_remove(?original); str_free(?alloc, original.path); }
    val written: R.Result[usize, io_error.Error] = fs.write(original.file, "abc"::*u8, 3::usize);
    if (R.is_err[usize, io_error.Error](written) || R.unwrap_ok[usize, io_error.Error](written) != 3) { ret 1; }
    var digest: [32]u8;
    if (R.is_err[R.Void, str](file_sha256(original.path, ?digest[0]))) { ret 2; }
    val expected: [32]u8 = [32]u8{0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,
        0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23, 0xb0, 0x03, 0x61, 0xa3,
        0x96, 0x17, 0x7a, 0x9c, 0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad};
    if (!bytes_eq(?digest[0], ?expected[0], 32::usize)) { ret 2; }
    val observed: R.Result[fs.Metadata, str] = fs.stat_of(original.file);
    val identified: R.Result[fs.Identity, io_error.Error] = fs.identity_of(original.file);
    if (R.is_err[fs.Metadata, str](observed) || R.is_err[fs.Identity, io_error.Error](identified)) { ret 1; }
    val before: fs.Metadata = R.unwrap_ok[fs.Metadata, str](observed);
    val identity: fs.Identity = R.unwrap_ok[fs.Identity, io_error.Error](identified);
    if (R.is_err[R.Void, str](validate_digest_input(original.path, original.file, before, identity))) { ret 2; }
    if (replace) {
        val replacement: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach-digest-replacement");
        if (R.is_err[fs.TempFile, str](replacement)) { ret 1; }
        var fresh: fs.TempFile = R.unwrap_ok[fs.TempFile, str](replacement);
        fin { fs.temp_close_and_remove(?fresh); str_free(?alloc, fresh.path); }
        val filled: R.Result[usize, io_error.Error] = fs.write(fresh.file, "abc"::*u8, 3::usize);
        if (R.is_err[usize, io_error.Error](filled) || R.unwrap_ok[usize, io_error.Error](filled) != 3) { ret 1; }
        if (O.is_some[str](fs.rename(fresh.path, original.path))) { ret 1; }
    }
    or {
        val filled: R.Result[usize, io_error.Error] = fs.write(original.file, "d"::*u8, 1::usize);
        if (R.is_err[usize, io_error.Error](filled) || R.unwrap_ok[usize, io_error.Error](filled) != 1) { ret 1; }
    }
    if (R.is_ok[R.Void, str](validate_digest_input(original.path, original.file, before, identity))) { ret 3; }
    ret 0;
}

test "mach.lang.build.fingerprint.file_sha256:rejects_path_replacement_while_object_is_held" {
    ret t_digest_observation_case(true);
}

test "mach.lang.build.fingerprint.file_sha256:rejects_changes_to_the_held_object" {
    ret t_digest_observation_case(false);
}
