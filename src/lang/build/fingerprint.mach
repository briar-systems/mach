use mach.lang.fail;
use mach.lang.intern;
use mach.lang.wire;
use std.allocator.page;
use std.crypto.hash.sha256;
use fs:       std.filesystem;
use io_error: std.io.error;
use std.memory;
use system_os: std.system.os;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

pub def Domain: u16;

pub val DOMAIN_SUBSYSTEM:  Domain = 1;
pub val DOMAIN_BUILD_GOAL: Domain = 2;
pub val DOMAIN_ARCH:       Domain = 3;
pub val DOMAIN_ABI:        Domain = 4;
pub val DOMAIN_OS:         Domain = 5;
pub val DOMAIN_BUILD_STEP: Domain = 6;

#[testing]
val DOMAIN_COUNT: usize                = 13;
#[testing]
val DOMAINS:      [DOMAIN_COUNT]Domain = [DOMAIN_COUNT]Domain{
    DOMAIN_SUBSYSTEM, DOMAIN_BUILD_GOAL, DOMAIN_ARCH,
    DOMAIN_ABI, DOMAIN_OS, DOMAIN_BUILD_STEP,
    DOMAIN_OF, DOMAIN_DEBUG, DOMAIN_TARGET_MODEL,
    DOMAIN_BACKEND, DOMAIN_IMAGE, DOMAIN_FS_POLICY,
    DOMAIN_IR_FORM,
};

pub val DOMAIN_OF:           Domain = 7;
pub val DOMAIN_DEBUG:        Domain = 8;
pub val DOMAIN_TARGET_MODEL: Domain = 9;
pub val DOMAIN_BACKEND:      Domain = 10;
pub val DOMAIN_IMAGE:        Domain = 11;
pub val DOMAIN_FS_POLICY:    Domain = 12;
#[testing]
pub val DOMAIN_IR_FORM:      Domain = 13;

pub val FILE_DIGEST_CHUNK: usize = 8192;

pub fun file_sha256(path: str, digest: *u8) err[fail.Fail] {
    if (path == nil || digest == nil) { ret err[fail.Fail].err{fail.message("file digest input or output is missing")}; }
    val open_r: res[fs.File, io_error.Error] = fs.open(path);
    if (sel open_r.err) {
        ret err[fail.Fail].err{fail.message(system_os.message(open_r.err))};
    }
    var f:      fs.File = open_r.ok;
    var opened: bool    = true;
    fin {
        if (opened) { fs.close(?f); }
    }
    val before_r: res[fs.Metadata, io_error.Error] = fs.stat_of(f);
    if (sel before_r.err) {
        ret err[fail.Fail].err{fail.message(fail.io_text(before_r.err))};
    }
    val before: fs.Metadata = before_r.ok;
    if (!fs.meta_is_file(?before)) { ret err[fail.Fail].err{fail.message("cannot digest a non-file path")}; }
    val identity_r: res[fs.Identity, io_error.Error] = fs.identity_of(f);
    if (sel identity_r.err) {
        ret err[fail.Fail].err{fail.message(system_os.message(identity_r.err))};
    }
    val identity: fs.Identity = identity_r.ok;

    var computed: [32]u8;
    val hashed:   err[fail.Fail] = held_file_sha256(f, ?computed[0]);
    if (sel hashed.err) { ret hashed; }
    val validated: err[fail.Fail] = validate_digest_input(path, f, before, identity);
    if (sel validated.err) { ret validated; }
    val closed: err[io_error.Error] = fs.close(?f);
    opened = false;
    if (sel closed.err) {
        ret err[fail.Fail].err{fail.message(system_os.message(closed.err))};
    }
    var i: usize = 0;
    for (i < 32) {
        digest[i] = computed[i];
        i         = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# borrows the file and exclusive seek/read access, rewinds first and leaves it at eof
# failure does not publish a digest, the caller retains close ownership
pub fun held_file_sha256(f: fs.File, digest: *u8) err[fail.Fail] {
    if (digest == nil) { ret err[fail.Fail].err{fail.message("file digest output is missing")}; }
    val before_r: res[fs.Metadata, io_error.Error] = fs.stat_of(f);
    if (sel before_r.err) { ret err[fail.Fail].err{fail.message(fail.io_text(before_r.err))}; }
    val before: fs.Metadata = before_r.ok;
    if (!fs.meta_is_file(?before)) { ret err[fail.Fail].err{fail.message("cannot digest a non-file handle")}; }
    val rewound: res[i64, io_error.Error] = fs.seek(f, 0, fs.SEEK_SET);
    if (sel rewound.err) {
        ret err[fail.Fail].err{fail.message(system_os.message(rewound.err))};
    }
    if (rewound.ok != 0) { ret err[fail.Fail].err{fail.message("file digest could not rewind its input")}; }
    var st:    sha256.State = sha256.init();
    var total: usize        = 0;
    var buf:   [8192]u8;
    for {
        val rr: res[usize, io_error.Error] = fs.read(f, ?buf[0], FILE_DIGEST_CHUNK);
        if (sel rr.err) {
            ret err[fail.Fail].err{fail.message(system_os.message(rr.err))};
        }
        val n: usize = rr.ok;
        if (n == 0)                  { brk; }
        if (n > before.size - total) { ret err[fail.Fail].err{fail.message("file grew while computing its digest")}; }
        total = total + n;
        sha256.update(?st, ?buf[0], n);
    }
    if (total != before.size) { ret err[fail.Fail].err{fail.message("file shrank while computing its digest")}; }
    val stable: err[fail.Fail] = validate_held_digest_input(f, before);
    if (sel stable.err) { ret stable; }
    sha256.final(?st, digest);
    ret err[fail.Fail].ok{};
}

fun validate_digest_input(path: str, held: fs.File, before: fs.Metadata, identity: fs.Identity) err[fail.Fail] {
    # follow the same path semantics while keeping the hashed object retained
    val opened: res[fs.File, io_error.Error] = fs.open(path);
    if (sel opened.err) {
        ret err[fail.Fail].err{fail.message(system_os.message(opened.err))};
    }
    var current:  fs.File                          = opened.ok;
    val observed: res[fs.Identity, io_error.Error] = fs.identity_of(current);
    val closed:   err[io_error.Error]              = fs.close(?current);
    if (sel observed.err) {
        ret err[fail.Fail].err{fail.message(system_os.message(observed.err))};
    }
    if (sel closed.err) {
        ret err[fail.Fail].err{fail.message(system_os.message(closed.err))};
    }
    if (!fs.identity_equal(identity, observed.ok)) {
        ret err[fail.Fail].err{fail.message("file changed while computing its digest")};
    }
    ret validate_held_digest_input(held, before);
}

fun validate_held_digest_input(held: fs.File, before: fs.Metadata) err[fail.Fail] {
    val after_r: res[fs.Metadata, io_error.Error] = fs.stat_of(held);
    if (sel after_r.err) { ret err[fail.Fail].err{fail.message(fail.io_text(after_r.err))}; }
    val after: fs.Metadata = after_r.ok;
    if (!fs.meta_is_file(?after) || before.size != after.size
        || before.modified.sec != after.modified.sec
        || before.modified.nsec != after.modified.nsec) {
        ret err[fail.Fail].err{fail.message("file changed while computing its digest")};
    }
    ret err[fail.Fail].ok{};
}

# a domain-separated value: its domain, its schema version, then the value,
# so two fingerprints that differ in any of the three never share bytes
fun put_domain(s: *wire.Sink, domain: Domain, schema_version: u8) {
    wire.put_u16(s, domain);
    wire.put_u8(s, schema_version);
}

pub fun put_domain_u8(s: *wire.Sink, domain: Domain, schema_version: u8, value: u8) {
    put_domain(s, domain, schema_version);
    wire.put_u8(s, value);
}

pub fun put_domain_u32(s: *wire.Sink, domain: Domain, schema_version: u8, value: u32) {
    put_domain(s, domain, schema_version);
    wire.put_u32(s, value);
}

pub fun put_domain_u64(s: *wire.Sink, domain: Domain, schema_version: u8, value: u64) {
    put_domain(s, domain, schema_version);
    wire.put_u64(s, value);
}

pub fun put_domain_bytes(s: *wire.Sink, domain: Domain, schema_version: u8, p: *u8, len: usize) {
    put_domain(s, domain, schema_version);
    wire.put_sized(s, p, len);
}

pub fun put_domain_str(s: *wire.Sink, domain: Domain, schema_version: u8, text: str) {
    put_domain_bytes(s, domain, schema_version, text::*u8, str_len(text));
}

# a text as its u32 length then its bytes; nil and empty both put the length 0
pub fun put_text(s: *wire.Sink, text: str) {
    if (text == nil) {
        wire.put_u32(s, 0);
        ret;
    }
    wire.put_sized(s, text::*u8, str_len(text));
}

# an interned name by its spelling, so fingerprints agree across interners:
# a u8 1 then its text, or a u8 0 for no name
pub fun put_name(s: *wire.Sink, itn: *intern.Interner, name: intern.StrId) {
    if (intern.str_is_nil(name)) {
        wire.put_u8(s, 0);
        ret;
    }
    val text: opt[str] = intern.get(itn, name);
    if (sel text.none) {
        wire.refuse(s, fail.message("fingerprint name is absent from its interner"));
        ret;
    }
    wire.put_u8(s, 1);
    put_text(s, text.some);
}

fun put_digest(s: *wire.Sink, digest: *u8) {
    wire.put_u32(s, sha256.DIGEST_SIZE::u32);
    wire.put_bytes(s, digest, sha256.DIGEST_SIZE);
}

# bytes by their sha-256 digest, a u32 32 then the digest, or the u32 0 when
# there are none
pub fun put_content(s: *wire.Sink, bytes: *u8, len: usize) {
    if (bytes == nil) {
        wire.put_u32(s, 0);
        ret;
    }
    var digest: [32]u8;
    sha256.hash(bytes, len, ?digest[0]);
    put_digest(s, ?digest[0]);
}

# a file by the digest of its contents, as put_content puts bytes
pub fun put_file(s: *wire.Sink, path: str) {
    if (path == nil) {
        wire.put_u32(s, 0);
        ret;
    }
    var digest: [32]u8;
    val hashed: err[fail.Fail] = file_sha256(path, ?digest[0]);
    if (sel hashed.err) {
        wire.refuse(s, hashed.err);
        ret;
    }
    put_digest(s, ?digest[0]);
}

# compares two encodings and releases both
#[testing]
fun t_same(a: *wire.Sink, b: *wire.Sink) bool {
    val same: bool = !a.failed && !b.failed && a.len == b.len
        && memory.raw_equal(wire.bytes(a)::ptr, wire.bytes(b)::ptr, a.len);
    wire.dnit(a);
    wire.dnit(b);
    ret same;
}

# each pair differs in exactly one framed field, so the encodings must differ;
# equal inputs encode equally
test put_domain__separates_domain_schema_value_and_length {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var ea: wire.Sink = wire.grown(?alloc);
    var eb: wire.Sink = wire.grown(?alloc);
    put_domain_u8(?ea, 1, 1, 5);
    put_domain_u8(?eb, 2, 1, 5);
    if (t_same(?ea, ?eb)) { ret 2; }

    ea = wire.grown(?alloc);
    eb = wire.grown(?alloc);
    put_domain_u8(?ea, 1, 1, 5);
    put_domain_u8(?eb, 1, 2, 5);
    if (t_same(?ea, ?eb)) { ret 3; }

    ea = wire.grown(?alloc);
    eb = wire.grown(?alloc);
    put_domain_u8(?ea, 1, 1, 5);
    put_domain_u8(?eb, 1, 1, 6);
    if (t_same(?ea, ?eb)) { ret 4; }

    ea = wire.grown(?alloc);
    eb = wire.grown(?alloc);
    put_domain_u32(?ea, DOMAIN_TARGET_MODEL, 1, 0xAABBCCDD);
    put_domain_u32(?eb, DOMAIN_TARGET_MODEL, 1, 0xAABBCCDE);
    if (t_same(?ea, ?eb)) { ret 5; }

    ea = wire.grown(?alloc);
    eb = wire.grown(?alloc);
    put_domain_u64(?ea, DOMAIN_IMAGE, 1, 0x400000);
    put_domain_u64(?eb, DOMAIN_IMAGE, 1, 0x400001);
    if (t_same(?ea, ?eb)) { ret 6; }

    ea = wire.grown(?alloc);
    eb = wire.grown(?alloc);
    put_domain_str(?ea, 1, 1, "ab");
    put_domain_str(?ea, 1, 1, "c");
    put_domain_str(?eb, 1, 1, "a");
    put_domain_str(?eb, 1, 1, "bc");
    if (t_same(?ea, ?eb)) { ret 7; }

    ea = wire.grown(?alloc);
    eb = wire.grown(?alloc);
    put_domain_u64(?ea, DOMAIN_IMAGE, 1, 9);
    put_domain_u64(?eb, DOMAIN_IMAGE, 1, 9);
    if (!t_same(?ea, ?eb)) { ret 8; }

    # the framing is the domain, the schema and the value, little-endian
    var framed: [4]u8;
    var f:      wire.Sink = wire.fixed(?framed[0], 4);
    put_domain_u8(?f, DOMAIN_SUBSYSTEM, 3, 0xEE);
    if (f.failed || framed[0] != 1 || framed[1] != 0 || framed[2] != 3 || framed[3] != 0xEE) { ret 9; }

    var i: usize = 0;
    for (i < DOMAIN_COUNT) {
        var j: usize = i + 1;
        for (j < DOMAIN_COUNT) {
            if (DOMAINS[i] == DOMAINS[j]) { ret 10; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test put_name__uses_the_spelling_across_independent_interners {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var left:  intern.Interner = intern.init(?a);
    var right: intern.Interner = intern.init(?a);
    fin {
        intern.dnit(?left);
        intern.dnit(?right);
    }
    val l:         res[intern.StrId, A.Error] = intern.add(?left, "debug");
    val unrelated: res[intern.StrId, A.Error] = intern.add(?right, "release");
    val r:         res[intern.StrId, A.Error] = intern.add(?right, "debug");
    val empty_id:  res[intern.StrId, A.Error] = intern.add(?right, "");
    if (sel l.err)                                                           { ret 2; }
    if (sel unrelated.err)                                                   { ret 2; }
    if (sel r.err)                                                           { ret 2; }
    if (sel empty_id.err)                                                    { ret 2; }
    if (intern.str_same(l.ok, r.ok) || !intern.str_same(l.ok, unrelated.ok)) { ret 3; }
    var lf: wire.Sink = wire.grown(?a);
    var rf: wire.Sink = wire.grown(?a);
    put_name(?lf, ?left, l.ok);
    put_name(?rf, ?right, r.ok);
    if (!t_same(?lf, ?rf)) { ret 4; }
    lf = wire.grown(?a);
    rf = wire.grown(?a);
    put_name(?lf, ?left, l.ok);
    put_name(?rf, ?right, unrelated.ok);
    if (t_same(?lf, ?rf)) { ret 5; }
    # no name and the empty name differ
    lf = wire.grown(?a);
    rf = wire.grown(?a);
    put_name(?lf, ?right, intern.STR_NIL);
    put_name(?rf, ?right, empty_id.ok);
    if (t_same(?lf, ?rf)) { ret 6; }
    # a name the interner does not hold fails the sink
    lf = wire.grown(?a);
    put_name(?lf, ?right, intern.str_id(1000));
    val missing: bool = lf.failed;
    wire.dnit(?lf);
    if (!missing) { ret 7; }
    ret 0;
}

#[testing]
fun t_digest_observation_case(replace: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val created: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach-digest-held");
    if (sel created.err) { ret 1; }
    var original: fs.TempFile = created.ok;
    fin {
        fs.temp_close_and_remove(?original);
        str_free(?alloc, original.path);
    }
    val written: res[usize, io_error.Error] = fs.write(original.file, "abc"::*u8, 3::usize);
    if (sel written.err) { ret 1; }
    if (written.ok != 3) { ret 1; }
    var digest:        [32]u8;
    val file_sha256_r: err[fail.Fail] = file_sha256(original.path, ?digest[0]);
    if (sel file_sha256_r.err) { ret 2; }
    val expected: [32]u8 = [32]u8{0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,
        0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23, 0xb0, 0x03, 0x61, 0xa3,
        0x96, 0x17, 0x7a, 0x9c, 0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad};
    if (!memory.raw_equal((?digest[0])::ptr, (?expected[0])::ptr, 32)) { ret 2; }
    val observed:   res[fs.Metadata, io_error.Error] = fs.stat_of(original.file);
    val identified: res[fs.Identity, io_error.Error] = fs.identity_of(original.file);
    if (sel observed.err)   { ret 1; }
    if (sel identified.err) { ret 1; }
    val before:                  fs.Metadata    = observed.ok;
    val identity:                fs.Identity    = identified.ok;
    val validate_digest_input_r: err[fail.Fail] = validate_digest_input(original.path, original.file, before, identity);
    if (sel validate_digest_input_r.err) { ret 2; }
    if (replace) {
        val replacement: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach-digest-replacement");
        if (sel replacement.err) { ret 1; }
        var fresh: fs.TempFile = replacement.ok;
        fin {
            fs.temp_close_and_remove(?fresh);
            str_free(?alloc, fresh.path);
        }
        val filled: res[usize, io_error.Error] = fs.write(fresh.file, "abc"::*u8, 3::usize);
        if (sel filled.err) { ret 1; }
        if (filled.ok != 3) { ret 1; }
        val rename_r: err[io_error.Error] = fs.rename(fresh.path, original.path);
        if (sel rename_r.err) { ret 1; }
    }
    or {
        val filled: res[usize, io_error.Error] = fs.write(original.file, "d"::*u8, 1::usize);
        if (sel filled.err) { ret 1; }
        if (filled.ok != 1) { ret 1; }
    }
    val validate_digest_input_r2: err[fail.Fail] = validate_digest_input(original.path, original.file, before, identity);
    if (sel validate_digest_input_r2.ok) { ret 3; }
    ret 0;
}

test validate_digest_input__rejects_a_replaced_path_and_a_changed_held_object {
    val replaced: i32 = t_digest_observation_case(true);
    if (replaced != 0) { ret replaced; }
    val changed: i32 = t_digest_observation_case(false);
    if (changed != 0) { ret 10 + changed; }
    ret 0;
}

test held_file_sha256__rewinds_and_digests_the_complete_file {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val created: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach-held-digest");
    if (sel created.err) { ret 1; }
    var file: fs.TempFile = created.ok;
    fin {
        fs.temp_close_and_remove(?file);
        str_free(?alloc, file.path);
    }
    val written: res[usize, io_error.Error] = fs.write(file.file, "abc"::*u8, 3);
    if (sel written.err) { ret 2; }
    if (written.ok != 3) { ret 2; }
    val seeked: res[i64, io_error.Error] = fs.seek(file.file, 1, fs.SEEK_SET);
    if (sel seeked.err) { ret 3; }
    var digest:             [32]u8;
    val held_file_sha256_r: err[fail.Fail] = held_file_sha256(file.file, ?digest[0]);
    if (sel held_file_sha256_r.err) { ret 4; }
    val expected: [32]u8 = [32]u8{0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,
        0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23, 0xb0, 0x03, 0x61, 0xa3,
        0x96, 0x17, 0x7a, 0x9c, 0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad};
    if (!memory.raw_equal((?digest[0])::ptr, (?expected[0])::ptr, 32)) { ret 5; }
    val position: res[i64, io_error.Error] = fs.seek(file.file, 0, fs.SEEK_CUR);
    if (sel position.err) { ret 6; }
    if (position.ok != 3) { ret 6; }
    val held_file_sha256_r2: err[fail.Fail] = held_file_sha256(file.file, ?digest[0]);
    if (sel held_file_sha256_r2.err)                                   { ret 7; }
    if (!memory.raw_equal((?digest[0])::ptr, (?expected[0])::ptr, 32)) { ret 7; }
    ret 0;
}

# whether file_sha256 over a file holding `len` bytes of `data` matches the one-shot hash of them
#[testing]
fun t_streamed_digest_matches(alloc: *A.Allocator, data: *u8, len: usize) bool {
    val created: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, "mach-streamed-digest");
    if (sel created.err) { ret false; }
    var file: fs.TempFile = created.ok;
    fin {
        fs.temp_close_and_remove(?file);
        str_free(alloc, file.path);
    }
    if (len != 0) {
        val written: res[usize, io_error.Error] = fs.write(file.file, data, len);
        if (sel written.err)   { ret false; }
        if (written.ok != len) { ret false; }
    }
    var expect: [32]u8;
    sha256.hash(data, len, ?expect[0]);
    var got:      [32]u8;
    val digested: err[fail.Fail] = file_sha256(file.path, ?got[0]);
    if (sel digested.err) { ret false; }
    ret memory.raw_equal((?expect[0])::ptr, (?got[0])::ptr, 32);
}

test file_sha256__matches_the_one_shot_hash_across_chunk_boundaries {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var empty: u8 = 0;
    if (!t_streamed_digest_matches(?alloc, ?empty, 0)) { ret 2; }
    val len:  usize             = FILE_DIGEST_CHUNK * 3 + 17;
    val made: res[*u8, A.Error] = A.allocate[u8](?alloc, len);
    if (sel made.err) { ret 1; }
    val buf: *u8 = made.ok;
    fin { A.deallocate[u8](?alloc, buf, len); }
    var i: usize = 0;
    for (i < len) {
        buf[i] = (i % 251)::u8;
        i      = i + 1;
    }
    if (!t_streamed_digest_matches(?alloc, buf, FILE_DIGEST_CHUNK)) { ret 3; }
    if (!t_streamed_digest_matches(?alloc, buf, len))               { ret 4; }
    ret 0;
}
