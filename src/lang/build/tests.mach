fun ut_manifest_mixed_targets() str {
    ret "[project]\nmach = \">=5\"\nid = \"mixtest\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux-x86_64]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.spirv]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\nof = \"spv\"\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.host]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/mixtest\"\ntargets = [\"linux-x86_64\"]\nlink = []\nneed = []\n\n[artifact.probe_frag]\nkind = \"bin\"\nentry = \"probe_frag.mach\"\nout = \"probe_frag.spv\"\ntargets = [\"spirv\"]\nlink = []\nneed = []\n";
}

fun ut_shard_len(s: *session.Session, kind: query.QueryKind) u32 {
    ret query.shard_len(?s.queries, kind);
}

fun ut_stable_of(s: *session.Session, fqn: str) session.StableModuleId {
    val idr: res[intern.StrId, A.Error] = intern.intern(?s.interner, fqn);
    if (sel idr.err) { ret session.STABLE_MODULE_NIL; }
    ret session.stable_module_id_lookup(s, idr.ok);
}

test execute__artifact_build_roots_at_reachable_modules {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "lib.mach";
    names[1] = "probe_frag.mach";
    names[2] = "other.mach";
    var texts: [3]str;
    texts[0] = "pub fun hello() i32 { ret missing_host_function(); }\n";
    texts[1] = "#[output(0)] var out_colour: f32x4;\n\n#[stage(\"fragment\")]\nfun frag_main() {\n    out_colour = f32x4{1.0, 0.0, 0.0, 1.0};\n}\n";
    texts[2] = "pub fun touch() { missing_unrelated_function(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_mixed_targets(), ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = "spirv";
    rq.artifact     = "probe_frag";
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r.ok.severity != outcome.BUILD_OK) { bad = 1; }

    val st_shader: session.StableModuleId = ut_stable_of(?s, "mixtest.probe_frag");
    val st_host:   session.StableModuleId = ut_stable_of(?s, "mixtest.lib");
    val st_other:  session.StableModuleId = ut_stable_of(?s, "mixtest.other");
    if (st_shader == session.STABLE_MODULE_NIL)                                { bad = 1; }
    if (st_host != session.STABLE_MODULE_NIL)                                  { bad = 1; }
    if (st_other != session.STABLE_MODULE_NIL)                                 { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_SEMA, st_shader::u64) == 0)    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_shader::u64) == 0) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

# a root project whose surface module re-exports one declaration of every kind
# that has instances instead of a definition, one ordinary declaration, and a
# whole module that holds a generic; built as a shared library, a static
# archive and an executable
fun ut_manifest_shared_fwd() str {
    ret "[project]\nmach = \">=5\"\nid = \"shfwd\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[target.linux-arm64]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n\n[target.linux-riscv64]\nisa = \"riscv64\"\nos = \"linux\"\nabi = \"lp64d\"\n\n[target.darwin-x86_64]\nisa = \"x86_64\"\nos = \"darwin\"\nabi = \"sysv64\"\n\n[target.darwin-arm64]\nisa = \"aarch64\"\nos = \"darwin\"\nabi = \"aapcs64\"\n\n[artifact.shared]\nkind = \"shared\"\nentry = \"lib.mach\"\nout = \"lib/shared\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.archive]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"lib/archive\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.program]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/program\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n";
}

val UT_SHARED_FWD_WARNING: str = "exports nothing from a shared library";

fun ut_diag_count_warning(d: *diagnostic.DiagnosticStore, needle: str) u32 {
    var hits: u32   = 0;
    var i:    usize = 0;
    for (i < diagnostic.len(d)) {
        if (d.items.data[i].severity == diagnostic.SEVERITY_WARNING
            && ut_str_contains(d.items.data[i].message, needle)) { hits = hits + 1; }
        i = i + 1;
    }
    ret hits;
}

# builds the named artifact of the shared-fwd project and reports how many
# re-export warnings the build raised; negative is a scaffold or engine failure
fun ut_shared_fwd_arm(alloc: *A.Allocator, artifact: str, want_lib: bool, s: *session.Session) i32 {
    var names: [4]str;
    names[0] = "lib.mach";
    names[1] = "parts.mach";
    names[2] = "deep.mach";
    names[3] = "main.mach";
    var texts: [4]str;
    texts[0] = "use shfwd.parts;\n\nfwd parts.ident;\nfwd parts.plain;\nfwd parts.sized;\nfwd parts.total;\nfwd shfwd.deep;\n\npub fun anchor() i32 { ret 1; }\n";
    texts[1] = "pub fun ident[T](x: T) T { ret x; }\npub fun plain(x: i32) i32 { ret x; }\npub fun sized($n: i32) i32 { ret n; }\npub fun total(xs: ...) i32 { ret 0; }\n";
    texts[2] = "pub fun gen[T](x: T) T { ret x; }\npub fun leaf() i32 { ret 2; }\n";
    texts[3] = ut_cc3(alloc, "use shfwd.parts;\n\nfwd parts.ident;\n\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret parts.plain(0); }\n");
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_manifest_shared_fwd(), ?names[0], ?texts[0], 4);
    if (sel root_r.err) { ret -1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(alloc, root); }

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(s, root);
    if (sel mr.err) { ret -2; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.artifact     = artifact;
    rq.want_lib     = want_lib;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) { ret -3; }
    var bp: bplan.BuildPlan = pr.ok;

    # the warning is raised at lowering, so the link's verdict on this host is
    # not what the arm measures
    val r: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, s, alloc, nil);
    if (sel r.err)                       { ret -4; }
    if (diagnostic.has_errors(?s.diags)) { ret -5; }
    ret ut_diag_count_warning(?s.diags, UT_SHARED_FWD_WARNING)::i32;
}

# a shared library build warns once per `fwd` of a generic, comptime-parameter
# or pack declaration, naming it, and says nothing about the ordinary `fwd`
test execute_warm__shared_library_fwd_of_a_generic_warns_at_the_fwd {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 1; }

    val count: i32 = ut_shared_fwd_arm(?alloc, "shared", true, ?s);
    if (count < 0)                                                                                             { ret 10 - count; }
    if (count != 3)                                                                                            { ret 2; }
    if (!ut_diag_has_warning(?s.diags, "`fwd` of the generic declaration `ident` exports nothing"))            { ret 3; }
    if (!ut_diag_has_warning(?s.diags, "`fwd` of the comptime-parameter declaration `sized` exports nothing")) { ret 4; }
    if (!ut_diag_has_warning(?s.diags, "`fwd` of the pack declaration `total` exports nothing"))               { ret 5; }
    if (!ut_diag_has_warning(?s.diags, "export a `pub` non-generic wrapper"))                                  { ret 6; }
    if (ut_diag_has_warning(?s.diags, "`plain`"))                                                              { ret 7; }
    ret 0;
}

# `fwd` of a module that holds a generic exports the module's non-generic
# surface, which is what was asked for: no warning names the generic
test execute_warm__shared_library_fwd_of_a_module_does_not_warn_for_its_generics {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 1; }

    val count: i32 = ut_shared_fwd_arm(?alloc, "shared", true, ?s);
    if (count < 0)                               { ret 10 - count; }
    if (ut_diag_has_warning(?s.diags, "`gen`"))  { ret 2; }
    if (ut_diag_has_warning(?s.diags, "`leaf`")) { ret 3; }
    if (ut_diag_has_warning(?s.diags, "`deep`")) { ret 4; }
    ret 0;
}

# the same `fwd` lines in a static archive build raise nothing: no export
# surface is at stake
test execute_warm__static_library_fwd_of_a_generic_does_not_warn {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 1; }

    val count: i32 = ut_shared_fwd_arm(?alloc, "archive", true, ?s);
    if (count < 0)  { ret 10 - count; }
    if (count != 0) { ret 2; }
    ret 0;
}

# an executable whose root module `fwd`s a generic raises nothing either
test execute_warm__executable_fwd_of_a_generic_does_not_warn {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) { ret 1; }

    val count: i32 = ut_shared_fwd_arm(?alloc, "program", false, ?s);
    if (count < 0)  { ret 10 - count; }
    if (count != 0) { ret 2; }
    ret 0;
}

test execute_warm__blocked_output_directory_is_environmental {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n");
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val out_path: str             = ut_cc3(?alloc, root, "/", "out");
    val blk:      err[fs.FsError] = fs.write_bytes(out_path, "blocked", 7, 420);
    if (sel blk.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        val bo: outcome.BuildOutcome = r.ok;
        if (bo.severity != outcome.BUILD_ENVIRONMENT) { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test execute_warm__unchanged_rebuild_reuses_and_stays_bounded {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.a.fa;\nuse uniontest.b.fb;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret fa() + fb(); }\n");
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32 = 0;

    val r1: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val bo1: outcome.BuildOutcome = r1.ok;
    if (bo1.severity != outcome.BUILD_OK) { bad = 1; }
    if (bo1.artifacts.len != 1)           { bad = 1; }
    or {
        val is_file_r: res[bool, io_error.Error] = fs.is_file(bo1.artifacts.data[0].path);
        if (sel is_file_r.err)                   { ret 99; }
        if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }
    }

    val st_main: session.StableModuleId = ut_stable_of(?s, "uniontest.main");
    val st_a:    session.StableModuleId = ut_stable_of(?s, "uniontest.a");
    val st_b:    session.StableModuleId = ut_stable_of(?s, "uniontest.b");
    if (st_main == session.STABLE_MODULE_NIL || st_a == session.STABLE_MODULE_NIL || st_b == session.STABLE_MODULE_NIL) { bad = 1; }

    val sema_a_1: query.Revision = query.peek_revision(?s.queries, query.Q_SEMA, st_a::u64);
    val low_a_1:  query.Revision = query.peek_revision(?s.queries, query.Q_LOWER, st_a::u64);
    val cg_m_1:   query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_main::u64);
    val cg_a_1:   query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64);
    val cg_b_1:   query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64);
    val lk_1:     query.Revision = query.peek_revision(?s.queries, query.Q_LINK, 0);
    if (sema_a_1 == 0 || low_a_1 == 0 || cg_m_1 == 0 || cg_a_1 == 0 || cg_b_1 == 0 || lk_1 == 0) { bad = 1; }
    val interned_1: usize = intern.count(?s.interner);
    val sources_1:  usize = src.count(?s.sources);
    val n_parse_1:  u32   = ut_shard_len(?s, query.Q_PARSE);
    val n_sema_1:   u32   = ut_shard_len(?s, query.Q_SEMA);
    val n_low_1:    u32   = ut_shard_len(?s, query.Q_LOWER);
    val n_cg_1:     u32   = ut_shard_len(?s, query.Q_CODEGEN);

    val r2: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r2.ok.severity != outcome.BUILD_OK)                                       { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_SEMA, st_a::u64) != sema_a_1)     { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LOWER, st_a::u64) != low_a_1)     { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_main::u64) != cg_m_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64) != cg_a_1)    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64) != cg_b_1)    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LINK, 0) != lk_1)                 { bad = 1; }
    if (intern.count(?s.interner) != interned_1)                                  { bad = 1; }
    if (src.count(?s.sources) != sources_1)                                       { bad = 1; }
    if (ut_shard_len(?s, query.Q_PARSE) != n_parse_1)                             { bad = 1; }
    if (ut_shard_len(?s, query.Q_SEMA) != n_sema_1)                               { bad = 1; }
    if (ut_shard_len(?s, query.Q_LOWER) != n_low_1)                               { bad = 1; }
    if (ut_shard_len(?s, query.Q_CODEGEN) != n_cg_1)                              { bad = 1; }

    val src_dir:       str             = ut_cc3(?alloc, root, "/", "src");
    val a_path:        str             = ut_cc3(?alloc, src_dir, "/", "a.mach");
    val a_v2:          str             = "pub fun fa() i32 { val t: i32 = 1; ret t; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(a_path, a_v2, str_len(a_v2), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val r3: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r3.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r3.ok.severity != outcome.BUILD_OK)                                    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64) == cg_a_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64) != cg_b_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LINK, 0) == lk_1)              { bad = 1; }
    if (src.count(?s.sources) != sources_1)                                    { bad = 1; }
    if (ut_shard_len(?s, query.Q_PARSE) != n_parse_1)                          { bad = 1; }
    if (ut_shard_len(?s, query.Q_SEMA) != n_sema_1)                            { bad = 1; }
    if (ut_shard_len(?s, query.Q_LOWER) != n_low_1)                            { bad = 1; }
    if (ut_shard_len(?s, query.Q_CODEGEN) != n_cg_1)                           { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test execute_warm__tampered_artifact_forces_relink_not_silent_reuse {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.a.fa;\nuse uniontest.b.fb;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret fa() + fb(); }\n");
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32 = 0;

    val r1: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val bo1: outcome.BuildOutcome = r1.ok;
    if (bo1.severity != outcome.BUILD_OK) { bad = 1; }
    or (bo1.artifacts.len != 1)           { bad = 1; }
    or {
        val is_file_r: res[bool, io_error.Error] = fs.is_file(bo1.artifacts.data[0].path);
        if (sel is_file_r.err)                   { ret 99; }
        if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }
    }
    val artifact: str = bo1.artifacts.data[0].path;

    val lk_1: query.Revision = query.peek_revision(?s.queries, query.Q_LINK, 0);
    if (lk_1 == 0) { bad = 1; }

    val marker:        str             = "TAMPERED-DEFECT-B-MARKER-NOT-A-REAL-BINARY";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(artifact, marker, str_len(marker), 420);
    if (sel write_bytes_r.err) { bad = 1; }

    val r2: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val bo2: outcome.BuildOutcome = r2.ok;
    if (bo2.severity != outcome.BUILD_OK) { bad = 1; }

    val lk_2: query.Revision = query.peek_revision(?s.queries, query.Q_LINK, 0);
    if (lk_2 != lk_1) { bad = 1; }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, artifact);
    if (sel rr.err) { bad = 1; }
    if (sel rr.ok) {
        var buf:            Vector[u8] = rr.ok;
        val mbytes:         *u8        = marker::*u8;
        val mlen:           usize      = str_len(marker);
        var matches_marker: bool       = buf.len::usize == mlen;
        if (matches_marker) {
            var i: usize = 0;
            for (i < mlen) {
                if (buf.data[i] != mbytes[i]) {
                    matches_marker = false;
                    brk;
                }
                i = i + 1;
            }
        }
        if (matches_marker) { bad = 1; }
        vector.dnit[u8](?buf);
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test execute_warm__failed_link_retries_at_unchanged_revision {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret 0; }\n\ntest main_zero { ret 0; }\n");
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.goal         = request.GOAL_TESTS;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    val artifact:         str             = bp.units.data[0].out_path;
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?alloc, artifact, 493);
    if (sel create_dir_all_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    var bad: i32                                     = 0;
    val r1:  res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r1.err) { bad = 1; }
    if (sel r1.ok) {
        val bo1: outcome.BuildOutcome = r1.ok;
        if (bo1.severity == outcome.BUILD_OK) { bad = 1; }
    }

    val lk_1: query.Revision = query.peek_revision(?s.queries, query.Q_LINK, 0);
    if (lk_1 == 0) { bad = 1; }
    fs.remove_all(?alloc, artifact);

    val r2: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r2.err) { bad = 1; }
    if (sel r2.ok) {
        val bo2: outcome.BuildOutcome = r2.ok;
        if (bo2.severity != outcome.BUILD_OK) { bad = 1; }
    }
    if (query.peek_revision(?s.queries, query.Q_LINK, 0) != lk_1) { bad = 1; }
    val is_file_r: res[bool, io_error.Error] = fs.is_file(artifact);
    if (sel is_file_r.err)                   { ret 99; }
    if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test execute_warm__jobs_flip_holds_all_revisions {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.a.fa;\nuse uniontest.b.fb;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret fa() + fb(); }\n");
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.jobs         = 1;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32 = 0;

    val r1: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r1.ok.severity != outcome.BUILD_OK) { bad = 1; }

    val st_main: session.StableModuleId = ut_stable_of(?s, "uniontest.main");
    val st_a:    session.StableModuleId = ut_stable_of(?s, "uniontest.a");
    val st_b:    session.StableModuleId = ut_stable_of(?s, "uniontest.b");
    if (st_main == session.STABLE_MODULE_NIL || st_a == session.STABLE_MODULE_NIL || st_b == session.STABLE_MODULE_NIL) { bad = 1; }

    val tgt_1:   query.Revision = query.peek_revision(?s.queries, query.Q_TARGET, 0);
    val res_a1:  query.Revision = query.peek_revision(?s.queries, query.Q_RESOLVE, st_a::u64);
    val sema_a1: query.Revision = query.peek_revision(?s.queries, query.Q_SEMA, st_a::u64);
    val low_a1:  query.Revision = query.peek_revision(?s.queries, query.Q_LOWER, st_a::u64);
    val cg_m1:   query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_main::u64);
    val cg_a1:   query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64);
    val cg_b1:   query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64);
    val lk_1:    query.Revision = query.peek_revision(?s.queries, query.Q_LINK, 0);
    if (tgt_1 == 0 || res_a1 == 0 || sema_a1 == 0 || low_a1 == 0 || cg_m1 == 0 || cg_a1 == 0 || cg_b1 == 0 || lk_1 == 0) { bad = 1; }
    val n_parse_1: u32 = ut_shard_len(?s, query.Q_PARSE);
    val n_sema_1:  u32 = ut_shard_len(?s, query.Q_SEMA);
    val n_low_1:   u32 = ut_shard_len(?s, query.Q_LOWER);
    val n_cg_1:    u32 = ut_shard_len(?s, query.Q_CODEGEN);

    rq.jobs = 4;
    val r2: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r2.ok.severity != outcome.BUILD_OK) { bad = 1; }

    if (query.peek_revision(?s.queries, query.Q_TARGET, 0) != tgt_1)             { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_RESOLVE, st_a::u64) != res_a1)   { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_SEMA, st_a::u64) != sema_a1)     { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LOWER, st_a::u64) != low_a1)     { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_main::u64) != cg_m1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64) != cg_a1)    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64) != cg_b1)    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LINK, 0) != lk_1)                { bad = 1; }
    if (ut_shard_len(?s, query.Q_PARSE) != n_parse_1)                            { bad = 1; }
    if (ut_shard_len(?s, query.Q_SEMA) != n_sema_1)                              { bad = 1; }
    if (ut_shard_len(?s, query.Q_LOWER) != n_low_1)                              { bad = 1; }
    if (ut_shard_len(?s, query.Q_CODEGEN) != n_cg_1)                             { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test execute_warm__parallel_pool_rebuilds_only_stale_modules {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [4]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    names[3] = "c.mach";
    var texts: [4]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.a.fa;\nuse uniontest.b.fb;\nuse uniontest.c.fc;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { ret fa() + fb() + fc(); }\n");
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    texts[3] = "pub fun fc() i32 { ret 3; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 4);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.jobs         = 2;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32 = 0;

    val r1: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val bo1: outcome.BuildOutcome = r1.ok;
    if (bo1.severity != outcome.BUILD_OK) { bad = 1; }
    if (bo1.artifacts.len != 1)           { bad = 1; }
    or {
        val is_file_r: res[bool, io_error.Error] = fs.is_file(bo1.artifacts.data[0].path);
        if (sel is_file_r.err)                   { ret 99; }
        if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }
    }

    val st_main: session.StableModuleId = ut_stable_of(?s, "uniontest.main");
    val st_a:    session.StableModuleId = ut_stable_of(?s, "uniontest.a");
    val st_b:    session.StableModuleId = ut_stable_of(?s, "uniontest.b");
    val st_c:    session.StableModuleId = ut_stable_of(?s, "uniontest.c");
    if (st_main == session.STABLE_MODULE_NIL || st_a == session.STABLE_MODULE_NIL
        || st_b == session.STABLE_MODULE_NIL || st_c == session.STABLE_MODULE_NIL) { bad = 1; }

    val cg_m_1: query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_main::u64);
    val cg_a_1: query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64);
    val cg_b_1: query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64);
    val cg_c_1: query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_c::u64);
    val lk_1:   query.Revision = query.peek_revision(?s.queries, query.Q_LINK, 0);
    if (cg_m_1 == 0 || cg_a_1 == 0 || cg_b_1 == 0 || cg_c_1 == 0 || lk_1 == 0) { bad = 1; }
    val n_cg_1: u32 = ut_shard_len(?s, query.Q_CODEGEN);

    val r2: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r2.ok.severity != outcome.BUILD_OK)                                    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64) != cg_a_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_c::u64) != cg_c_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LINK, 0) != lk_1)              { bad = 1; }

    val src_dir:       str             = ut_cc3(?alloc, root, "/", "src");
    val a_path:        str             = ut_cc3(?alloc, src_dir, "/", "a.mach");
    val c_path:        str             = ut_cc3(?alloc, src_dir, "/", "c.mach");
    val a_v2:          str             = "pub fun fa() i32 { val t: i32 = 1; ret t; }\n";
    val c_v2:          str             = "pub fun fc() i32 { val t: i32 = 3; ret t; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(a_path, a_v2, str_len(a_v2), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(c_path, c_v2, str_len(c_v2), 420);
    if (sel write_bytes_r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val r3: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r3.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val bo3: outcome.BuildOutcome = r3.ok;
    if (bo3.severity != outcome.BUILD_OK) { bad = 1; }
    if (bo3.artifacts.len != 1)           { bad = 1; }
    or {
        val is_file_r2: res[bool, io_error.Error] = fs.is_file(bo3.artifacts.data[0].path);
        if (sel is_file_r2.err)                    { ret 99; }
        if (!(sel is_file_r2.ok && is_file_r2.ok)) { bad = 1; }
    }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64) == cg_a_1)    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_c::u64) == cg_c_1)    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_main::u64) != cg_m_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64) != cg_b_1)    { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LINK, 0) == lk_1)                 { bad = 1; }
    if (ut_shard_len(?s, query.Q_CODEGEN) != n_cg_1)                              { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_scale_names(alloc: *A.Allocator, names: *str, texts: *str) {
    names[0] = "main.mach";
    var uses:  str = "";
    var calls: str = "";
    var i:     u32 = 1;
    for (i <= 8) {
        val idx: str = ut_u32_str(alloc, i);
        val nm:  str = ut_cc3(alloc, "m", idx, ".mach");
        names[i] = nm;
        val head: str = ut_cc3(alloc, "pub fun f", idx, "() i32 {\n    val x: f64 = ");
        val mid:  str = ut_cc3(alloc, idx, ".25;\n    val y: f64 = x * 2.0 + 0.5;\n    var acc: i32 = 0;\n    var j: i32 = 0;\n    for (j < 40) {\n        acc = acc + j * 2;\n        j = j + 1;\n    }\n    ret acc + (y::i32) + ", idx);
        val body: str = ut_cc3(alloc, head, mid, ";\n}\n");
        texts[i] = body;
        uses     = ut_cc3(alloc, uses, "use scaletest.m", ut_cc3(alloc, idx, ".f", idx));
        uses     = ut_cc3(alloc, uses, ";\n", "");
        calls    = ut_cc3(alloc, calls, "acc = acc + f", ut_cc3(alloc, idx, "();\n", ""));
        i        = i + 1;
    }
    texts[0] = ut_cc3(alloc, uses, ut_cc3(alloc, "#[symbol(\"", "_start", "\")]\n"),
        ut_cc3(alloc, "fun start() i32 {\n    var acc: i32 = 0;\n", calls, "    ret acc;\n}\n"));
}

fun ut_u32_str(alloc: *A.Allocator, v: u32) str {
    var digits: [10]u8;
    var n:      u32 = 0;
    var t:      u32 = v;
    if (t == 0) {
        digits[0] = '0';
        n         = 1;
    }
    for (t > 0) {
        digits[n] = ('0'::u32 + (t % 10))::u8;
        t         = t / 10;
        n         = n + 1;
    }
    val r: res[*u8, A.Error] = A.allocate[u8](alloc, (n + 1)::usize);
    if (sel r.err) { ret "0"; }
    val buf: *u8 = r.ok;
    var i:   u32 = 0;
    for (i < n) {
        buf[i] = digits[n - 1 - i];
        i      = i + 1;
    }
    buf[n] = 0;
    ret buf::str;
}

fun ut_build_scale(alloc: *A.Allocator, root: str, jobs: u32, out_bytes: *Vector[u8]) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.jobs         = jobs;
    rq.opt          = pipeline.OPT_RELEASE;
    rq.debug        = true;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    val r: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (sel r.err) {
        session.dnit(?s);
        ret 1;
    }
    val bo: outcome.BuildOutcome = r.ok;
    if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) {
        session.dnit(?s);
        ret 1;
    }
    val is_file_r: res[bool, io_error.Error] = fs.is_file(bo.artifacts.data[0].path);
    if (sel is_file_r.err) { ret 99; }
    if (!(sel is_file_r.ok && is_file_r.ok)) {
        session.dnit(?s);
        ret 1;
    }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, bo.artifacts.data[0].path);
    if (sel rb.err) {
        session.dnit(?s);
        ret 1;
    }
    @out_bytes = rb.ok;

    session.dnit(?s);
    ret 0;
}

fun ut_manifest_scale() str {
    ret "[project]\nmach = \">=5\"\nid = \"scaletest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.scaletest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/scaletest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

test execute_warm__worker_count_does_not_change_the_artifact {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var names: [9]str;
    var texts: [9]str;
    ut_scale_names(?alloc, ?names[0], ?texts[0]);
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_scale(), ?names[0], ?texts[0], 9);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var b1: Vector[u8];
    val c1: i32 = ut_build_scale(?alloc, root, 1::u32, ?b1);
    if (c1 != 0) {
        fs.remove_all(?alloc, root);
        ret 1;
    }
    var b6: Vector[u8];
    val c6: i32 = ut_build_scale(?alloc, root, 6::u32, ?b6);
    fs.remove_all(?alloc, root);
    if (c6 != 0) { ret 1; }

    if (b1.len != b6.len) { ret 1; }
    var i: usize = 0;
    for (i < b1.len) {
        if (b1.data[i] != b6.data[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test execute_warm__replaced_image_owns_section_bytes {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    val LIT: str = "warm-owned-section-bytes";

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.a.greeting;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 { if (greeting[0] == 'w') { ret 0; } ret 1; }\n");
    texts[1] = "use uniontest.b.fb;\npub val greeting: *u8 = \"warm-owned-section-bytes\";\npub fun fa() i32 { ret fb(); }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32 = 0;

    val r1: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r1.ok.severity != outcome.BUILD_OK) { bad = 1; }

    val src_dir:       str             = ut_cc3(?alloc, root, "/", "src");
    val b_path:        str             = ut_cc3(?alloc, src_dir, "/", "b.mach");
    val b_v2:          str             = "pub fun fb() i32 { ret 2; }\npub fun fb2() i32 { ret 3; }\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(b_path, b_v2, str_len(b_v2), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val r2: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (r2.ok.severity != outcome.BUILD_OK) { bad = 1; }

    val id_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, LIT);
    if (sel id_r.ok) {
        val lo: opt[str] = intern.lookup(?s.interner, id_r.ok);
        if (sel lo.none)               { ret 99; }
        if (!str_equals(lo.some, LIT)) { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

fun ut_outcome_fail_count(bo: *outcome.BuildOutcome) u32 {
    var total: u32   = 0;
    var i:     usize = 0;
    for (i < bo.events.len) {
        if (sel bo.events.data[i].fail) { total = total + 1; }
        i = i + 1;
    }
    ret total;
}

fun ut_outcome_contains(bo: *outcome.BuildOutcome, needle: str) bool {
    var i: usize = 0;
    for (i < bo.events.len) {
        val ev: *outcome.BuildEvent = ?bo.events.data[i];
        if (sel ev.fail) {
            val carried: opt[str] = outcome.text(ev.fail);
            if (sel carried.some) {
                if (carried.some != nil && ut_str_contains(carried.some, needle)) { ret true; }
            }
        }
        or (sel ev.diagnostics) {
            var d: usize = 0;
            for (d < ev.diagnostics.diags.items.len) {
                if (ut_str_contains(ev.diagnostics.diags.items.data[d].message, needle)) { ret true; }
                d = d + 1;
            }
            var f: usize = 1;
            for (f < src.count(ev.diagnostics.sources)) {
                val file: opt[*src.SourceFile] = src.get(ev.diagnostics.sources, f::src.FileId);
                if (sel file.some && ut_str_contains(file.some.path, needle)) { ret true; }
                f = f + 1;
            }
        }
        i = i + 1;
    }
    ret false;
}

fun ut_manifest_two_bins() str {
    ret "[project]\nmach = \">=5\"\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[target.linux-arm64]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n\n[target.linux-riscv64]\nisa = \"riscv64\"\nos = \"linux\"\nabi = \"lp64d\"\n\n[target.darwin-x86_64]\nisa = \"x86_64\"\nos = \"darwin\"\nabi = \"sysv64\"\n\n[target.darwin-arm64]\nisa = \"aarch64\"\nos = \"darwin\"\nabi = \"aapcs64\"\n\n[artifact.alpha]\nkind = \"bin\"\nentry = \"alpha.mach\"\nout = \"bin/alpha\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.beta]\nkind = \"bin\"\nentry = \"beta.mach\"\nout = \"bin/beta\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

test execute_warm_all__two_artifacts_both_link {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [2]str;
    names[0] = "alpha.mach";
    names[1] = "beta.mach";
    var texts: [2]str;
    texts[0] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun sa() i32 { ret 1; }\n");
    texts[1] = ut_cc3(?alloc, "#[symbol(\"", ut_entry_symbol(), "\")]\nfun sb() i32 { ret 2; }\n");
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_two_bins(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m: manifest.Manifest = mr.ok;

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32 = 0;
    if (bp.units.len != 2) { bad = 1; }

    val r: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm_all(?bp, ?s, ?alloc, nil);
    if (sel r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val bo: outcome.BuildOutcome = r.ok;

    if (bo.severity != outcome.BUILD_OK) { bad = 1; }
    if (bo.artifacts.len != 2)           { bad = 1; }
    or {
        val is_file_r: res[bool, io_error.Error] = fs.is_file(bo.artifacts.data[0].path);
        if (sel is_file_r.err)                   { ret 99; }
        if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }
        val is_file_r2: res[bool, io_error.Error] = fs.is_file(bo.artifacts.data[1].path);
        if (sel is_file_r2.err)                                   { ret 99; }
        if (!(sel is_file_r2.ok && is_file_r2.ok))                { bad = 1; }
        if (!ut_str_contains(bo.artifacts.data[0].path, "alpha")) { bad = 1; }
        if (!ut_str_contains(bo.artifacts.data[1].path, "beta"))  { bad = 1; }
        if (ut_str_contains(bo.artifacts.data[0].path, "beta"))   { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test execute_warm__bin_name_keys_the_artifact_cache {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [3]str;
    names[0] = "alpha.mach";
    names[1] = "beta.mach";
    names[2] = "shared.mach";
    var texts: [3]str;
    texts[0] = ut_cc3(?alloc, "use uniontest.shared.sh;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun sa() i32 { ret sh(); }\n");
    texts[1] = ut_cc3(?alloc, "use uniontest.shared.sh;\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun sb() i32 { ret sh(); }\n");
    texts[2] = "pub fun sh() i32 { $if ($bin.name == \"alpha\") { ret 111; } ret 222; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_two_bins(), ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    var bad: i32 = 0;
    if (bp.units.len != 2) { bad = 1; }

    val r0: res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    if (sel r0.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val bo0: outcome.BuildOutcome                    = r0.ok;
    val r1:  res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 1, ?s, ?alloc, nil);
    if (sel r1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val bo1: outcome.BuildOutcome = r1.ok;

    if (bo0.severity != outcome.BUILD_OK || bo1.severity != outcome.BUILD_OK) { bad = 1; }
    if (bo0.artifacts.len != 1 || bo1.artifacts.len != 1) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val f0: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, bo0.artifacts.data[0].path);
    val f1: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, bo1.artifacts.data[0].path);
    if (sel f0.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (sel f1.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val v0: Vector[u8] = f0.ok;
    val v1: Vector[u8] = f1.ok;

    var differ: bool = false;
    if (v0.len != v1.len) { differ = true; }
    or {
        var i: usize = 0;
        for (i < v0.len) {
            if (v0.data[i] != v1.data[i]) {
                differ = true;
                brk;
            }
            i = i + 1;
        }
    }
    if (!differ) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test execute_warm__unit_failure_is_owned_after_teardown {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[symbol(\"_start\")]\nfun start() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    val pr: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr.ok;

    val mf:            str             = ut_cc3(?alloc, root, "/", manifest.MANIFEST_FILE);
    val broken:        str             = "[project]\nmach = \">=5\"\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\nbogus_key = 1\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(mf, broken, str_len(broken), 420);
    if (sel write_bytes_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    var bad: i32                                     = 0;
    val r:   res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, nil);
    session.dnit(?s);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        var bo: outcome.BuildOutcome = r.ok;
        if (bo.severity == outcome.BUILD_OK)        { bad = 1; }
        if (bo.severity == outcome.BUILD_INTERNAL)  { bad = 1; }
        if (ut_outcome_fail_count(?bo) != 1)        { bad = 1; }
        if (!ut_outcome_contains(?bo, "bogus_key")) { bad = 1; }
        outcome.outcome_dnit(?bo);
    }

    fs.remove_all(?alloc, root);
    ret bad;
}

