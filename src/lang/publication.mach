# publication: the one path by which a compiler-controlled file reaches its
# final name. a publication either replaces its destination completely or
# leaves it untouched: the standard library's filesystem transaction writes a
# same-directory staging file, treats a short write as an error, checks the
# close and replaces the destination atomically. this module owns only the
# compiler's additions (the precondition, parent-directory creation, the
# operation name and interned error text, an optional digest of what was
# written); every backend writer, the step stamp, the scaffold and the doc
# generator call one of its four entry points, and the `b-fs-1` census holds
# that nothing else in the compiler writes to a final path
use mach.lang.build.outcome;
use std.format;
use mwriter: std.io.writer;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use mach.lang.intern;
use planned: mach.lang.publication.plan;
use A:       std.allocator;
use std.crypto.rand;
use std.encoding.hex;
use fs:       std.filesystem;
use txn:      std.filesystem.transaction;
use io_error: std.io.error;
use std.system.os;
use std.types.path;
use std.types.string.StrError;
use std.types.string.str_copy_slice;
fwd planned.Plan;
fwd planned.Destination;
fwd planned.Home;
fwd plan_init: planned.init;
fwd plan_add:  planned.add;
fwd plan_seal: planned.seal;
fwd plan_dnit: planned.dnit;

pub def Precondition: u8;

pub val REPLACE: Precondition = 0;
pub val CREATE:  Precondition = 1;

pub def Parents: u8;

pub val PARENTS_EXIST:  Parents = 0;
pub val PARENTS_CREATE: Parents = 1;

pub val DIR_MODE: i32 = 0o755;

pub fun intern_message(itn: *intern.Interner, a: *A.Allocator, buf: *u8, total: usize, generic: str) str {
    buf[total] = 0;
    val res_id: res[intern.StrId, A.Error] = intern.intern(itn, buf::str);
    A.deallocate[u8](a, buf, total + 1);
    if (sel res_id.err) { ret generic; }
    val opt_name: opt[str] = intern.lookup(itn, res_id.ok);
    if (sel opt_name.some) { ret opt_name.some; }
    ret generic;
}

pub fun io_message(itn: *intern.Interner, a: *A.Allocator, op: str, path: str, os_error: str, generic: str) str {
    if (itn == nil || path == nil) { ret generic; }
    val res_msg: res[str, format.FormatError] = format.sprint(a, "{} '{}': {}", op, path, os_error);
    if (sel res_msg.err) { ret generic; }
    val buf: str = res_msg.ok;
    ret intern_message(itn, a, buf, str_len(buf), generic);
}

fun message(itn: *intern.Interner, a: *A.Allocator, op: str, path: str, detail: str, generic: str) str {
    if (itn == nil) { ret detail; }
    ret io_message(itn, a, op, path, detail, generic);
}

fun prepare_options(pre: Precondition) txn.PrepareOptions {
    var required: txn.Precondition = txn.PRE_SAME_OBJECT;
    if (pre == CREATE) { required = txn.PRE_ABSENT; }
    ret txn.PrepareOptions{precondition: required, prior_access: txn.READ_AUTHORIZED,
        durability: txn.durability_none()};
}

fun operation_open(out: *Plan, a: *A.Allocator, home: *Home, path: str, parents: Parents) res[*Destination, outcome.Fail] {
    val initialized: err[txn.Error] = planned.init_homed(out, a, home);
    if (sel initialized.err) {
        ret res[*Destination, outcome.Fail].err{outcome.environment(txn.error_message(initialized.err))};
    }
    val added: res[*Destination, outcome.Fail] = planned.add(out, path, parents == PARENTS_CREATE);
    if (sel added.err) { ret res[*planned.Destination, outcome.Fail].err{added.err}; }
    val admitted: err[txn.Error] = planned.seal(out);
    if (sel admitted.err) {
        ret res[*Destination, outcome.Fail].err{outcome.environment(txn.error_message(admitted.err))};
    }
    ret added;
}

fun operation_finish(operation: *Plan, itn: *intern.Interner, a: *A.Allocator,
    result: err[outcome.Fail]) err[outcome.Fail] {
    val cleanup: err[txn.Error] = planned.dnit(operation);
    if (sel cleanup.ok) { ret result; }
    val detail: str = txn.error_message(cleanup.err);
    if (sel result.ok) { ret err[outcome.Fail].err{outcome.environment(detail)}; }
    val combined: res[str, format.FormatError] = format.sprint(a, "{}, publication cleanup: {}",
        outcome.describe(result.err), detail);
    if (sel combined.err) { ret err[outcome.Fail].err{outcome.environment(outcome.format_text(combined.err))}; }
    val text: str = combined.ok;
    if (itn == nil) { ret err[outcome.Fail].err{outcome.with_text(result.err, text)}; }
    ret err[outcome.Fail].err{outcome.with_text(result.err, intern_message(itn, a, text, str_len(text), detail))};
}

fun abort_failure(itn: *intern.Interner, a: *A.Allocator, t: *txn.Transaction,
    path: str, detail: str, op: str, generic: str) err[outcome.Fail] {
    val aborted: err[txn.Error] = txn.abort(t);
    if (sel aborted.err) {
        val combined: res[str, format.FormatError] = format.sprint(a, "{}; abort: {}", detail,
            txn.error_message(aborted.err));
        if (sel combined.err) { ret err[outcome.Fail].err{outcome.environment(outcome.format_text(combined.err))}; }
        val text: str = combined.ok;
        if (itn == nil) { ret err[outcome.Fail].err{outcome.environment(text)}; }
        fin { str_free(a, text); }
        ret err[outcome.Fail].err{outcome.environment(message(itn, a, op, path, text, generic))};
    }
    ret err[outcome.Fail].err{outcome.environment(message(itn, a, op, path, detail, generic))};
}

fun finish(itn: *intern.Interner, a: *A.Allocator, t: *txn.Transaction, path: str, planned: usize,
    check_len: bool, op: str, generic: str, digest_out: *[32]u8) err[outcome.Fail] {
    if (check_len && txn.transaction_len(t) != planned) {
        ret abort_failure(itn, a, t, path,
            "short write: the staged file holds fewer bytes than the writer planned", op, generic);
    }
    var digest: [32]u8;
    if (digest_out != nil && !txn.transaction_digest(t, ?digest)) {
        ret abort_failure(itn, a, t, path, "publication produced no content digest", op, generic);
    }
    val committed: res[txn.Outcome, txn.Error] = txn.commit(t);
    if (sel committed.err) {
        ret err[outcome.Fail].err{outcome.environment(message(itn, a, op, path,
            txn.error_message(committed.err), generic))};
    }
    if (digest_out != nil) { @digest_out = digest; }
    ret err[outcome.Fail].ok{};
}

# the primary failure is reported; an abort failure of a higher kind outranks it
fun abort_transaction(transaction: *txn.Transaction, primary: txn.Error) err[txn.Error] {
    val aborted: err[txn.Error] = txn.abort(transaction);
    if (sel aborted.err) {
        val cleanup: txn.Error = aborted.err;
        if (cleanup.kind == txn.MEMORY || cleanup.kind == txn.INVALID) { ret err[txn.Error].err{cleanup}; }
    }
    ret err[txn.Error].err{primary};
}

# replace a source object that the caller holds open: `identity` was observed
# on `source_fd` before its content was read, and the commit is refused when
# the destination is no longer that object, so an edit never lands on a file
# that changed underneath the read. `source_fd` stays the caller's on a
# prepare or identity refusal and is consumed otherwise, closed before the
# rename. `exact_mode` publishes `mode` as the final permission bits; false
# keeps the platform's creation policy
pub fun replace_source(a: *A.Allocator, destination: *txn.Claim, source_fd: *i32,
    identity: txn.Identity, bytes: *u8, len: usize, mode: i32,
    exact_mode: bool) err[txn.Error] {
    if (a == nil || destination == nil || source_fd == nil || @source_fd < 0) {
        ret err[txn.Error].err{txn.error(txn.INVALID, txn.OP_PREPARE)};
    }
    var transaction: txn.Transaction;
    val options:     txn.PrepareOptions = txn.PrepareOptions{precondition: txn.PRE_SAME_OBJECT,
        prior_access: txn.READ_AUTHORIZED, exact_mode: exact_mode, durability: txn.durability_file(true)};
    val prepared: err[txn.Error] = txn.prepare_bytes(?transaction, a, destination, bytes, len, mode, false, options);
    if (sel prepared.err) { ret prepared; }
    var prior: txn.Identity;
    if (!txn.transaction_prior_identity(?transaction, ?prior) || !txn.identity_equal(identity, prior)) {
        ret abort_transaction(?transaction, txn.error(txn.PRECONDITION, txn.OP_VALIDATE));
    }
    val fd: i32 = @source_fd;
    @source_fd = -1;
    val closed: i64 = os.close(fd);
    if (closed < 0) { ret abort_transaction(?transaction, txn.io_error(txn.OP_COMMIT, closed)); }
    val committed: res[txn.Outcome, txn.Error] = txn.commit(?transaction);
    if (sel committed.err) { ret err[txn.Error].err{committed.err}; }
    ret err[txn.Error].ok{};
}

pub fun bytes_at_claim(a: *A.Allocator, destination: *txn.Claim, buf: *u8, len: usize,
    mode: i32, pre: Precondition, digest_out: *[32]u8) err[txn.Error] {
    var transaction: txn.Transaction;
    val prepared:    err[txn.Error] = txn.prepare_bytes(?transaction, a, destination,
        buf, len, mode, digest_out != nil, prepare_options(pre));
    if (sel prepared.err) { ret err[txn.Error].err{prepared.err}; }
    if (txn.transaction_len(?transaction) != len) {
        ret abort_transaction(?transaction, txn.error(txn.INVALID, txn.OP_VALIDATE));
    }
    var digest: [32]u8;
    if (digest_out != nil && !txn.transaction_digest(?transaction, ?digest)) {
        ret abort_transaction(?transaction, txn.error(txn.INVALID, txn.OP_VALIDATE));
    }
    val committed: res[txn.Outcome, txn.Error] = txn.commit(?transaction);
    if (sel committed.err) { ret err[txn.Error].err{committed.err}; }
    if (digest_out != nil) { @digest_out = digest; }
    ret err[txn.Error].ok{};
}

pub fun bytes_at(itn: *intern.Interner, a: *A.Allocator, destination: *txn.Claim, path: str,
    buf: *u8, len: usize, mode: i32, pre: Precondition, op: str, generic: str,
    digest_out: *[32]u8) err[outcome.Fail] {
    val result: err[txn.Error] = bytes_at_claim(a, destination, buf, len, mode, pre, digest_out);
    if (sel result.err) {
        ret err[outcome.Fail].err{outcome.environment(message(itn, a, op, path, txn.error_message(result.err), generic))};
    }
    ret err[outcome.Fail].ok{};
}

pub fun bytes(itn: *intern.Interner, a: *A.Allocator, path: str, buf: *u8, len: usize, mode: i32,
    pre: Precondition, parents: Parents, op: str, generic: str,
    digest_out: *[32]u8) err[outcome.Fail] {
    var operation: Plan;
    val opened:    res[*Destination, outcome.Fail] = operation_open(?operation, a, nil, path, parents);
    var result:    err[outcome.Fail]               = err[outcome.Fail].ok{};
    if (sel opened.err) {
        result = err[outcome.Fail].err{outcome.environment(message(itn, a, op, path, outcome.describe(opened.err), generic))};
    }
    if (sel opened.ok) {
        val destination: *Destination = opened.ok;
        result = bytes_at(itn, a, ?destination.claim, path, buf, len, mode, pre, op, generic, digest_out);
    }
    ret operation_finish(?operation, itn, a, result);
}

pub fun writer_at[W](itn: *intern.Interner, a: *A.Allocator, destination: *txn.Claim, path: str, ctx: *W,
    write_cb: fun(*W, *mwriter.Writer) err[mwriter.WriteError], mode: i32,
    pre: Precondition, op: str, generic: str) err[outcome.Fail] {
    var transaction: txn.Transaction;
    val prepared:    err[txn.Error] = txn.prepare[W](?transaction, a, destination,
        ctx, write_cb, mode, false, prepare_options(pre));
    if (sel prepared.err) {
        ret err[outcome.Fail].err{outcome.environment(message(itn, a, op, path, txn.error_message(prepared.err), generic))};
    }
    ret finish(itn, a, ?transaction, path, 0, false, op, generic, nil);
}

pub fun writer[W](itn: *intern.Interner, a: *A.Allocator, path: str, ctx: *W,
    write_cb: fun(*W, *mwriter.Writer) err[mwriter.WriteError], mode: i32,
    pre: Precondition, parents: Parents, op: str, generic: str) err[outcome.Fail] {
    ret writer_homed[W](itn, a, nil, path, ctx, write_cb, mode, pre, parents, op, generic);
}

# `writer` with the destination rooted through `home` when it lies beneath
# the home's path, so its control files land under the build output
pub fun writer_homed[W](itn: *intern.Interner, a: *A.Allocator, home: *Home, path: str, ctx: *W,
    write_cb: fun(*W, *mwriter.Writer) err[mwriter.WriteError], mode: i32,
    pre: Precondition, parents: Parents, op: str, generic: str) err[outcome.Fail] {
    var operation: Plan;
    val opened:    res[*Destination, outcome.Fail] = operation_open(?operation, a, home, path, parents);
    var result:    err[outcome.Fail]               = err[outcome.Fail].ok{};
    if (sel opened.err) {
        result = err[outcome.Fail].err{outcome.environment(message(itn, a, op, path, outcome.describe(opened.err), generic))};
    }
    if (sel opened.ok) {
        val destination: *Destination = opened.ok;
        result = writer_at[W](itn, a, ?destination.claim, path, ctx, write_cb, mode, pre, op, generic);
    }
    ret operation_finish(?operation, itn, a, result);
}

pub fun subtree(a: *A.Allocator, destination: *txn.Claim, inv: *txn.Inventory, dir_mode: i32) err[outcome.Fail] {
    var transaction: txn.Transaction;
    val prepared:    err[txn.Error] = txn.prepare_subtree(?transaction, a, destination,
        inv, dir_mode, prepare_options(CREATE));
    if (sel prepared.err) {
        ret err[outcome.Fail].err{outcome.environment(txn.error_message(prepared.err))};
    }
    val committed: res[txn.Outcome, txn.Error] = txn.commit(?transaction);
    if (sel committed.err) {
        ret err[outcome.Fail].err{outcome.environment(txn.error_message(committed.err))};
    }
    ret err[outcome.Fail].ok{};
}

# the control home of a project: `out/.mach-txn` under its root, created on
# demand, so a publication into the source tree leaves nothing beside the
# sources. a root opened with this home derives children homed by their
# relative path, one claims directory per destination
pub val HOME_OUTPUT: str = "out";
pub val HOME_LEAF:   str = ".mach-txn";

fun make_dir_if_absent(dirfd: i32, leaf: str, mode: i32) err[txn.Error] {
    val made: i64 = os.make_dir(dirfd, leaf, mode);
    if (made < 0 && made != os.EEXIST) { ret err[txn.Error].err{txn.io_error(txn.OP_ROOT_OPEN, made)}; }
    ret err[txn.Error].ok{};
}

pub fun control_home(home: *txn.Root, project: *txn.Root) err[txn.Error] {
    val made_output: err[txn.Error] = make_dir_if_absent(txn.root_fd(project), HOME_OUTPUT, DIR_MODE);
    if (sel made_output.err) { ret made_output; }
    var output: txn.Root;
    val opened: err[txn.Error] = txn.root_open_child(?output, project, HOME_OUTPUT);
    if (sel opened.err) { ret opened; }
    val made:    err[txn.Error] = make_dir_if_absent(txn.root_fd(?output), HOME_LEAF, 0o700);
    var result:  err[txn.Error] = made;
    val made_ok: bool           = sel made.ok;
    if (made_ok) { result = txn.root_open_child(home, ?output, HOME_LEAF); }
    val closed: err[txn.Error] = txn.root_dnit(?output);
    if (sel result.ok && sel closed.err) {
        txn.root_dnit(home);
        ret closed;
    }
    ret result;
}

# open a project root homed at its control home: `home` outlives `out` and
# the caller releases both, `out` first
pub fun project_root(out: *txn.Root, home: *txn.Root, base: str, rel: str) err[txn.Error] {
    var plain:  txn.Root;
    val opened: err[txn.Error] = txn.root_open(?plain, base, rel);
    if (sel opened.err) { ret opened; }
    val homed:    err[txn.Error] = control_home(home, ?plain);
    var result:   err[txn.Error] = homed;
    val homed_ok: bool           = sel homed.ok;
    if (homed_ok) {
        result = txn.root_open_with_home(out, base, rel, home);
        if (sel result.err) { txn.root_dnit(home); }
    }
    val closed: err[txn.Error] = txn.root_dnit(?plain);
    if (sel result.ok && sel closed.err) {
        txn.root_dnit(out);
        txn.root_dnit(home);
        ret closed;
    }
    ret result;
}

# open a project's root and control home for a plan: `out.path` is the
# cleaned base every planned destination is compared against
pub fun project_home(out: *Home, a: *A.Allocator, base: str) err[txn.Error] {
    val cleaned: res[str, outcome.Fail] = planned.absolute_clean(a, base);
    if (sel cleaned.err) { ret err[txn.Error].err{txn.error(txn.IO, txn.OP_ROOT_OPEN)}; }
    out.path = cleaned.ok;
    val opened: err[txn.Error] = project_root(?out.root, ?out.home, out.path, "");
    if (sel opened.err) {
        str_free(a, out.path);
        out.path = nil;
    }
    ret opened;
}

pub fun project_home_dnit(home: *Home, a: *A.Allocator) err[txn.Error] {
    val closed:      err[txn.Error] = txn.root_dnit(?home.root);
    val home_closed: err[txn.Error] = txn.root_dnit(?home.home);
    str_free(a, home.path);
    home.path = nil;
    if (sel closed.err) { ret closed; }
    ret home_closed;
}

val EPHEMERAL_PREFIX:   str   = "mach-txn-";
val EPHEMERAL_ATTEMPTS: usize = 64;

# a private control home under the temporary directory for a publication
# whose project does not exist yet: the destination directory receives no
# sentinel, and exclusion against a concurrent creator rests on the one
# atomic rename. the caller removes it with `ephemeral_home_dnit`
pub fun ephemeral_home(out: *txn.Root, a: *A.Allocator) res[str, txn.Error] {
    var buf:     [512]u8;
    val dir_len: i64 = os.temp_dir(?buf[0], 512);
    if (dir_len < 0) { ret res[str, txn.Error].err{txn.io_error(txn.OP_ROOT_OPEN, dir_len)}; }
    var off: usize = dir_len::usize;
    if (off == 0 || !path.is_separator(buf[off - 1])) {
        buf[off] = os.separator;
        off      = off + 1;
    }
    val prefix_len: usize = str_len(EPHEMERAL_PREFIX);
    if (off + prefix_len + 16 + 1 > 512) { ret res[str, txn.Error].err{txn.io_error(txn.OP_ROOT_OPEN, os.ENAMETOOLONG)}; }
    var i: usize = 0;
    for (i < prefix_len) {
        buf[off + i] = EPHEMERAL_PREFIX[i];
        i            = i + 1;
    }
    off = off + prefix_len;
    var attempt: usize = 0;
    for (attempt < EPHEMERAL_ATTEMPTS) {
        var rnd:    [8]u8;
        val filled: err[io_error.Error] = rand.fill(?rnd[0], 8);
        if (sel filled.err) { ret res[str, txn.Error].err{txn.error(txn.ENTROPY, txn.OP_ROOT_OPEN)}; }
        hex.encode(?rnd[0], 8, ?buf[off], 17);
        buf[off + 16] = 0;
        val made: i64 = os.make_dir(os.AT_FDCWD, (?buf[0])::str, 0o700);
        if (made == os.EEXIST) {
            attempt = attempt + 1;
            cnt;
        }
        if (made < 0) { ret res[str, txn.Error].err{txn.io_error(txn.OP_ROOT_OPEN, made)}; }
        val copied: res[str, StrError] = str_copy_slice(a, (?buf[0])::str, 0, off + 16);
        if (sel copied.err) {
            os.unlink(os.AT_FDCWD, (?buf[0])::str, os.AT_REMOVEDIR);
            ret res[str, txn.Error].err{txn.error(txn.MEMORY, txn.OP_ROOT_OPEN)};
        }
        val home:   str            = copied.ok;
        val opened: err[txn.Error] = txn.root_open(out, home, "");
        if (sel opened.err) {
            os.unlink(os.AT_FDCWD, home, os.AT_REMOVEDIR);
            str_free(a, home);
            ret res[str, txn.Error].err{opened.err};
        }
        ret res[str, txn.Error].ok{home};
    }
    ret res[str, txn.Error].err{txn.error(txn.ENTROPY, txn.OP_ROOT_OPEN)};
}

# release an ephemeral home and remove its directory; `home` must have no
# live lock
pub fun ephemeral_home_dnit(a: *A.Allocator, home: *txn.Root, dir: str) err[txn.Error] {
    val closed:  err[txn.Error]  = txn.root_dnit(home);
    val removed: err[fs.FsError] = fs.remove_all(a, dir);
    str_free(a, dir);
    if (sel closed.err)  { ret closed; }
    if (sel removed.err) { ret err[txn.Error].err{txn.error(txn.IO, txn.OP_ROOT_OPEN)}; }
    ret err[txn.Error].ok{};
}
