use std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.text.string.str_free;
use mwriter: std.io.writer;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use txn: std.filesystem.transaction;
use mach.lang.intern;
use planned: mach.lang.publication.plan;
fwd planned.Plan;
fwd planned.Destination;
fwd plan_init: planned.init;
fwd plan_add: planned.add;
fwd plan_seal: planned.seal;
fwd plan_dnit: planned.dnit;

pub def Precondition: u8;

pub val REPLACE: Precondition = 0;
pub val CREATE:  Precondition = 1;

pub def Parents: u8;

pub val PARENTS_EXIST:  Parents = 0;
pub val PARENTS_CREATE: Parents = 1;

pub val DIR_MODE: i32 = 0o755;

pub fun intern_message(itn: *intern.Interner, a: *A.Allocator, buf: *u8, total: usize, generic: str) str {
    buf[total] = 0;
    val res_id: R.Result[intern.StrId, str] = intern.intern(itn, buf::str);
    A.deallocate[u8](a, buf, total + 1);
    if (R.is_err[intern.StrId, str](res_id)) { ret generic; }
    val opt_name: O.Option[str] = intern.lookup(itn, R.unwrap_ok[intern.StrId, str](res_id));
    if (O.is_some[str](opt_name)) { ret O.unwrap[str](opt_name); }
    ret generic;
}

pub fun io_message(itn: *intern.Interner, a: *A.Allocator, op: str, path: str, os_error: str, generic: str) str {
    if (itn == nil || path == nil) { ret generic; }
    val res_msg: R.Result[str, str] = format.sprint(a, "{} '{}': {}", op, path, os_error);
    if (R.is_err[str, str](res_msg)) { ret generic; }
    val buf: str = R.unwrap_ok[str, str](res_msg);
    ret intern_message(itn, a, buf, str_len(buf), generic);
}

fun message(itn: *intern.Interner, a: *A.Allocator, op: str, path: str, detail: str, generic: str) str {
    if (itn == nil) { ret detail; }
    ret io_message(itn, a, op, path, detail, generic);
}

fun prepare_options(pre: Precondition) txn.PrepareOptions {
    var required: txn.Precondition = txn.PRE_SAME_OBJECT;
    if (pre == CREATE) { required = txn.PRE_ABSENT; }
    ret txn.PrepareOptions{precondition: required, prior_access: txn.READ_AUTHORIZED,
        durability: txn.durability_none()};
}

fun operation_open(out: *Plan, a: *A.Allocator, path: str, parents: Parents) R.Result[*Destination, str] {
    val initialized: O.Option[txn.Error] = planned.init(out, a);
    if (O.is_some[txn.Error](initialized)) {
        ret R.err[*Destination, str](txn.error_message(O.unwrap[txn.Error](initialized)));
    }
    val added: R.Result[*Destination, str] = planned.add(out, path, parents == PARENTS_CREATE);
    if (R.is_err[*Destination, str](added)) { ret added; }
    val admitted: O.Option[txn.Error] = planned.seal(out);
    if (O.is_some[txn.Error](admitted)) {
        ret R.err[*Destination, str](txn.error_message(O.unwrap[txn.Error](admitted)));
    }
    ret added;
}

fun operation_finish(operation: *Plan, itn: *intern.Interner, a: *A.Allocator,
                     result: R.Result[R.Void, str]) R.Result[R.Void, str] {
    val cleanup: O.Option[txn.Error] = planned.dnit(operation);
    if (O.is_none[txn.Error](cleanup)) { ret result; }
    val detail: str = txn.error_message(O.unwrap[txn.Error](cleanup));
    if (R.is_ok[R.Void, str](result)) { ret R.err[R.Void, str](detail); }
    val combined: R.Result[str, str] = format.sprint(a, "{}, publication cleanup: {}",
        R.unwrap_err[R.Void, str](result), detail);
    if (R.is_err[str, str](combined)) { ret R.err[R.Void, str](R.unwrap_err[str, str](combined)); }
    val text: str = R.unwrap_ok[str, str](combined);
    if (itn == nil) { ret R.err[R.Void, str](text); }
    ret R.err[R.Void, str](intern_message(itn, a, text, str_len(text), detail));
}

fun abort_failure(itn: *intern.Interner, a: *A.Allocator, t: *txn.Transaction,
                  path: str, detail: str, op: str, generic: str) R.Result[R.Void, str] {
    val aborted: O.Option[txn.Error] = txn.abort(t);
    if (O.is_some[txn.Error](aborted)) {
        val combined: R.Result[str, str] = format.sprint(a, "{}; abort: {}", detail,
            txn.error_message(O.unwrap[txn.Error](aborted)));
        if (R.is_err[str, str](combined)) { ret R.err[R.Void, str](R.unwrap_err[str, str](combined)); }
        val text: str = R.unwrap_ok[str, str](combined);
        if (itn == nil) { ret R.err[R.Void, str](text); }
        fin { str_free(a, text); }
        ret R.err[R.Void, str](message(itn, a, op, path, text, generic));
    }
    ret R.err[R.Void, str](message(itn, a, op, path, detail, generic));
}

fun finish(itn: *intern.Interner, a: *A.Allocator, t: *txn.Transaction, path: str, planned: usize,
           check_len: bool, op: str, generic: str, digest_out: *[32]u8) R.Result[R.Void, str] {
    if (check_len && txn.transaction_len(t) != planned) {
        ret abort_failure(itn, a, t, path,
            "short write: the staged file holds fewer bytes than the writer planned", op, generic);
    }
    var digest: [32]u8;
    if (digest_out != nil && !txn.transaction_digest(t, ?digest)) {
        ret abort_failure(itn, a, t, path, "publication produced no content digest", op, generic);
    }
    val committed: R.Result[txn.Outcome, txn.Error] = txn.commit(t);
    if (R.is_err[txn.Outcome, txn.Error](committed)) {
        ret R.err[R.Void, str](message(itn, a, op, path,
            txn.error_message(R.unwrap_err[txn.Outcome, txn.Error](committed)), generic));
    }
    if (digest_out != nil) { @digest_out = digest; }
    ret R.ok_void[str]();
}

pub fun bytes_at(itn: *intern.Interner, a: *A.Allocator, destination: *txn.Claim, path: str,
                 buf: *u8, len: usize, mode: i32, pre: Precondition, op: str, generic: str,
                 digest_out: *[32]u8) R.Result[R.Void, str] {
    var transaction: txn.Transaction;
    val prepared: O.Option[txn.Error] = txn.prepare_bytes(?transaction, a, destination,
        buf, len, mode, digest_out != nil, prepare_options(pre));
    if (O.is_some[txn.Error](prepared)) {
        ret R.err[R.Void, str](message(itn, a, op, path, txn.error_message(O.unwrap[txn.Error](prepared)), generic));
    }
    ret finish(itn, a, ?transaction, path, len, true, op, generic, digest_out);
}

pub fun bytes(itn: *intern.Interner, a: *A.Allocator, path: str, buf: *u8, len: usize, mode: i32,
              pre: Precondition, parents: Parents, op: str, generic: str,
              digest_out: *[32]u8) R.Result[R.Void, str] {
    var operation: Plan;
    val opened: R.Result[*Destination, str] = operation_open(?operation, a, path, parents);
    var result: R.Result[R.Void, str] = R.ok_void[str]();
    if (R.is_err[*Destination, str](opened)) {
        result = R.err[R.Void, str](message(itn, a, op, path, R.unwrap_err[*Destination, str](opened), generic));
    } or {
        val destination: *Destination = R.unwrap_ok[*Destination, str](opened);
        result = bytes_at(itn, a, ?destination.claim, path, buf, len, mode, pre, op, generic, digest_out);
    }
    ret operation_finish(?operation, itn, a, result);
}

pub fun writer_at[W](itn: *intern.Interner, a: *A.Allocator, destination: *txn.Claim, path: str, ctx: *W,
                     write_cb: fun(*W, *mwriter.Writer) R.Result[R.Void, str], mode: i32,
                     pre: Precondition, op: str, generic: str) R.Result[R.Void, str] {
    var transaction: txn.Transaction;
    val prepared: O.Option[txn.Error] = txn.prepare[W](?transaction, a, destination,
        ctx, write_cb, mode, false, prepare_options(pre));
    if (O.is_some[txn.Error](prepared)) {
        ret R.err[R.Void, str](message(itn, a, op, path, txn.error_message(O.unwrap[txn.Error](prepared)), generic));
    }
    ret finish(itn, a, ?transaction, path, 0, false, op, generic, nil);
}

pub fun writer[W](itn: *intern.Interner, a: *A.Allocator, path: str, ctx: *W,
                  write_cb: fun(*W, *mwriter.Writer) R.Result[R.Void, str], mode: i32,
                  pre: Precondition, parents: Parents, op: str, generic: str) R.Result[R.Void, str] {
    var operation: Plan;
    val opened: R.Result[*Destination, str] = operation_open(?operation, a, path, parents);
    var result: R.Result[R.Void, str] = R.ok_void[str]();
    if (R.is_err[*Destination, str](opened)) {
        result = R.err[R.Void, str](message(itn, a, op, path, R.unwrap_err[*Destination, str](opened), generic));
    } or {
        val destination: *Destination = R.unwrap_ok[*Destination, str](opened);
        result = writer_at[W](itn, a, ?destination.claim, path, ctx, write_cb, mode, pre, op, generic);
    }
    ret operation_finish(?operation, itn, a, result);
}

pub fun subtree(a: *A.Allocator, destination: *txn.Claim, inv: *txn.Inventory, dir_mode: i32) R.Result[R.Void, str] {
    var transaction: txn.Transaction;
    val prepared: O.Option[txn.Error] = txn.prepare_subtree(?transaction, a, destination,
        inv, dir_mode, prepare_options(CREATE));
    if (O.is_some[txn.Error](prepared)) {
        ret R.err[R.Void, str](txn.error_message(O.unwrap[txn.Error](prepared)));
    }
    val committed: R.Result[txn.Outcome, txn.Error] = txn.commit(?transaction);
    if (R.is_err[txn.Outcome, txn.Error](committed)) {
        ret R.err[R.Void, str](txn.error_message(R.unwrap_err[txn.Outcome, txn.Error](committed)));
    }
    ret R.ok_void[str]();
}
