use std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.text.string.str_free;
use mwriter: std.io.writer;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use fs: std.filesystem;
use spath: std.types.path;
use txn: std.filesystem.transaction;
use mach.lang.intern;

pub def Precondition: u8;

pub val REPLACE: Precondition = 0;
pub val CREATE:  Precondition = 1;

pub def Parents: u8;

pub val PARENTS_EXIST:  Parents = 0;
pub val PARENTS_CREATE: Parents = 1;

pub val DIR_MODE: i32 = 0o755;

pub fun intern_message(itn: *intern.Interner, a: *A.Allocator, buf: *u8, total: usize, generic: str) str {
    buf[total] = 0;
    val res_id: R.Result[intern.StrId, str] = intern.intern(itn, buf::str);
    A.deallocate[u8](a, buf, total + 1);
    if (R.is_err[intern.StrId, str](res_id)) { ret generic; }
    val opt_name: O.Option[str] = intern.lookup(itn, R.unwrap_ok[intern.StrId, str](res_id));
    if (O.is_some[str](opt_name)) { ret O.unwrap[str](opt_name); }
    ret generic;
}

pub fun io_message(itn: *intern.Interner, a: *A.Allocator, op: str, path: str, os_error: str, generic: str) str {
    if (itn == nil || path == nil) { ret generic; }
    val res_msg: R.Result[str, str] = format.sprint(a, "{} '{}': {}", op, path, os_error);
    if (R.is_err[str, str](res_msg)) { ret generic; }
    val buf: str = R.unwrap_ok[str, str](res_msg);
    ret intern_message(itn, a, buf, str_len(buf), generic);
}

fun message(itn: *intern.Interner, a: *A.Allocator, op: str, path: str, detail: str, generic: str) str {
    if (itn == nil) { ret detail; }
    ret io_message(itn, a, op, path, detail, generic);
}

fun precondition_of(pre: Precondition) txn.Precondition {
    if (pre == CREATE) { ret txn.PRE_ABSENT_AT_COMMIT; }
    ret txn.PRE_UNCHANGED_SINCE_PREPARE;
}

fun open_parent(itn: *intern.Interner, a: *A.Allocator, path: str, parents: Parents, op: str, generic: str) R.Result[txn.Root, str] {
    val dir_r: R.Result[str, str] = spath.parent(a, path);
    if (R.is_err[str, str](dir_r)) {
        ret R.err[txn.Root, str](message(itn, a, op, path, R.unwrap_err[str, str](dir_r), generic));
    }
    val dir: str = R.unwrap_ok[str, str](dir_r);
    if (parents == PARENTS_CREATE) {
        val mk: O.Option[str] = fs.create_dir_all(a, dir, DIR_MODE);
        if (O.is_some[str](mk)) {
            val msg: str = message(itn, a, op, path, O.unwrap[str](mk), generic);
            str_free(a, dir);
            ret R.err[txn.Root, str](msg);
        }
    }
    val root_r: R.Result[txn.Root, txn.Error] = txn.root_open(dir, "");
    str_free(a, dir);
    if (R.is_err[txn.Root, txn.Error](root_r)) {
        ret R.err[txn.Root, str](message(itn, a, op, path,
            txn.error_message(R.unwrap_err[txn.Root, txn.Error](root_r)), generic));
    }
    ret R.ok[txn.Root, str](R.unwrap_ok[txn.Root, txn.Error](root_r));
}

fun finish(itn: *intern.Interner, a: *A.Allocator, t: *txn.Transaction, path: str, planned: usize,
           check_len: bool, pre: Precondition, op: str, generic: str, digest_out: *[32]u8) R.Result[R.Void, str] {
    if (check_len && txn.transaction_len(t) != planned) {
        txn.abort(t);
        ret R.err[R.Void, str](message(itn, a, op, path,
            "short write: the staged file holds fewer bytes than the writer planned", generic));
    }
    if (digest_out != nil) {
        var digest: [32]u8;
        if (!txn.transaction_digest(t, ?digest)) {
            txn.abort(t);
            ret R.err[R.Void, str](message(itn, a, op, path, "publication produced no content digest", generic));
        }
        @digest_out = digest;
    }
    val commit_r: R.Result[txn.Outcome, txn.Error] = txn.commit(t, precondition_of(pre), txn.durability_none());
    if (R.is_err[txn.Outcome, txn.Error](commit_r)) {
        ret R.err[R.Void, str](message(itn, a, op, path,
            txn.error_message(R.unwrap_err[txn.Outcome, txn.Error](commit_r)), generic));
    }
    ret R.ok_void[str]();
}

pub fun bytes_at(itn: *intern.Interner, a: *A.Allocator, root: *txn.Root, leaf: str, path: str,
                 buf: *u8, len: usize, mode: i32, pre: Precondition, op: str, generic: str,
                 digest_out: *[32]u8) R.Result[R.Void, str] {
    val prepare_r: R.Result[txn.Transaction, txn.Error] =
        txn.prepare_bytes(a, root, leaf, buf, len, mode, digest_out != nil);
    if (R.is_err[txn.Transaction, txn.Error](prepare_r)) {
        ret R.err[R.Void, str](message(itn, a, op, path,
            txn.error_message(R.unwrap_err[txn.Transaction, txn.Error](prepare_r)), generic));
    }
    var t: txn.Transaction = R.unwrap_ok[txn.Transaction, txn.Error](prepare_r);
    ret finish(itn, a, ?t, path, len, true, pre, op, generic, digest_out);
}

pub fun bytes(itn: *intern.Interner, a: *A.Allocator, path: str, buf: *u8, len: usize, mode: i32,
              pre: Precondition, parents: Parents, op: str, generic: str,
              digest_out: *[32]u8) R.Result[R.Void, str] {
    val root_r: R.Result[txn.Root, str] = open_parent(itn, a, path, parents, op, generic);
    if (R.is_err[txn.Root, str](root_r)) { ret R.err[R.Void, str](R.unwrap_err[txn.Root, str](root_r)); }
    var root: txn.Root = R.unwrap_ok[txn.Root, str](root_r);
    val r: R.Result[R.Void, str] = bytes_at(itn, a, ?root, spath.filename(path), path, buf, len, mode, pre, op, generic, digest_out);
    txn.root_dnit(?root);
    ret r;
}

pub fun writer[W](itn: *intern.Interner, a: *A.Allocator, path: str, ctx: *W,
                  write_cb: fun(*W, *mwriter.Writer) R.Result[R.Void, str], mode: i32,
                  pre: Precondition, parents: Parents, op: str, generic: str) R.Result[R.Void, str] {
    val root_r: R.Result[txn.Root, str] = open_parent(itn, a, path, parents, op, generic);
    if (R.is_err[txn.Root, str](root_r)) { ret R.err[R.Void, str](R.unwrap_err[txn.Root, str](root_r)); }
    var root: txn.Root = R.unwrap_ok[txn.Root, str](root_r);
    val prepare_r: R.Result[txn.Transaction, txn.Error] =
        txn.prepare[W](a, ?root, spath.filename(path), ctx, write_cb, mode, false);
    if (R.is_err[txn.Transaction, txn.Error](prepare_r)) {
        txn.root_dnit(?root);
        ret R.err[R.Void, str](message(itn, a, op, path,
            txn.error_message(R.unwrap_err[txn.Transaction, txn.Error](prepare_r)), generic));
    }
    var t: txn.Transaction = R.unwrap_ok[txn.Transaction, txn.Error](prepare_r);
    val r: R.Result[R.Void, str] = finish(itn, a, ?t, path, 0, false, pre, op, generic, nil);
    txn.root_dnit(?root);
    ret r;
}

pub fun subtree(a: *A.Allocator, d: *txn.Descent, inv: *txn.Inventory, dir_mode: i32) R.Result[R.Void, str] {
    val prep_r: R.Result[txn.Transaction, txn.Error] =
        txn.prepare_subtree(a, ?d.root, d.first_missing, inv, dir_mode);
    if (R.is_err[txn.Transaction, txn.Error](prep_r)) {
        ret R.err[R.Void, str](txn.error_message(R.unwrap_err[txn.Transaction, txn.Error](prep_r)));
    }
    var t: txn.Transaction = R.unwrap_ok[txn.Transaction, txn.Error](prep_r);
    val commit_r: R.Result[txn.Outcome, txn.Error] = txn.commit(?t, txn.PRE_ABSENT_AT_COMMIT, txn.durability_none());
    if (R.is_err[txn.Outcome, txn.Error](commit_r)) {
        ret R.err[R.Void, str](txn.error_message(R.unwrap_err[txn.Outcome, txn.Error](commit_r)));
    }
    ret R.ok_void[str]();
}
