rec SectionPlacement {
    text_start: u32;
    text_end:   u32;
    name:       intern.StrId;
    sec:        u32;
    # the function's entry alignment, which its own section takes
    align: u32;
}

rec PlacedSite {
    sec: u32;
    off: u32;
}

rec TextLayout {
    placements:      *SectionPlacement;
    placement_count: u32;
    placement_cap:   u32;
    text_len:        u32;
    text_sec:        u32;
    # the text section's alignment, a multiple of every function entry's: an
    # excision removes a multiple of it and leaves the remainder as fill, so
    # the functions after it keep their alignment
    align: u32;
    fill:  u8;
}

# the floor of a text section's alignment
val TEXT_SECTION_ALIGN: u32 = 16;

pub rec DebugInfo {
    emit:     bool;
    producer: intern.StrId;
    comp_dir: intern.StrId;
}

pub fun no_debug() DebugInfo {
    var d: DebugInfo;
    d.emit     = false;
    d.producer = intern.STR_NIL;
    d.comp_dir = intern.STR_NIL;
    ret d;
}

rec CodegenContext {
    alloc:   *A.Allocator;
    session: *session.Session;
    diags:   *diagnostic.DiagnosticStore;
}

# the back half of one module. a rejection of the program by any pass is an
# error appended to `diags`, the module's diagnostic store, and answers
# `reported`; a `message` failure is the apparatus (allocator, I/O, a target
# without a model) or a compiler defect
pub fun codegen_unit(s: *session.Session, tgt: *lang_target.Target,
    irmod: *me_ir.Module, deps: be_codegen_unit.IrSet, asm_out: *io_writer.Writer,
    placement_policy: u32, dbg: DebugInfo,
    diags: *diagnostic.DiagnosticStore) res[target_of.ObjectImage, fail.Fail] {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) {
        ret res[target_of.ObjectImage, fail.Fail].err{fail.message("codegen: scratch backing allocator failed")};
    }
    ret codegen_with_backing(s, tgt, irmod, deps, asm_out, placement_policy, dbg, diags, ?backing);
}

fun codegen_with_backing(s: *session.Session, tgt: *lang_target.Target,
    irmod: *me_ir.Module, deps: be_codegen_unit.IrSet, asm_out: *io_writer.Writer,
    placement_policy: u32, dbg: DebugInfo, diags: *diagnostic.DiagnosticStore,
    backing: *A.Allocator) res[target_of.ObjectImage, fail.Fail] {
    if (s == nil)     { ret res[target_of.ObjectImage, fail.Fail].err{fail.message("codegen: nil session")}; }
    if (diags == nil) { ret res[target_of.ObjectImage, fail.Fail].err{fail.message("codegen: nil diagnostic store")}; }
    val borrow: err[fail.Fail] = resolved.live(tgt);
    if (sel borrow.err) { ret res[target_of.ObjectImage, fail.Fail].err{borrow.err}; }
    var scratch:     arena.Arena;
    val initialized: err[A.Error] = arena.init(?scratch, backing, 0);
    if (sel initialized.err) { ret res[target_of.ObjectImage, fail.Fail].err{fail.refused(initialized.err)}; }
    fin { arena.dnit(?scratch); }
    var alloc: A.Allocator;
    val bound: err[A.Error] = arena.make(?alloc, ?scratch);
    if (sel bound.err) { ret res[target_of.ObjectImage, fail.Fail].err{fail.refused(bound.err)}; }
    var context: CodegenContext                        = CodegenContext{alloc: ?alloc, session: s, diags: diags};
    val emitted: res[target_of.ObjectImage, fail.Fail] = codegen_scratch(?context, tgt, irmod, deps, asm_out, placement_policy, dbg);
    if (sel emitted.err) {
        val error: fail.Fail = emitted.err;
        if (sel error.reported) { ret res[target_of.ObjectImage, fail.Fail].err{error}; }
        val stable: res[intern.StrId, A.Error] = intern.intern(?s.interner, fail.describe(error));
        if (sel stable.err) {
            ret res[target_of.ObjectImage, fail.Fail].err{fail.message("codegen: allocation failure retaining diagnostic")};
        }
        val text: opt[str] = intern.lookup(?s.interner, stable.ok);
        if (sel text.none) { ret res[target_of.ObjectImage, fail.Fail].err{fail.message("codegen: retained diagnostic is missing")}; }
        ret res[target_of.ObjectImage, fail.Fail].err{fail.with_text(error, text.some)};
    }
    var temporary: target_of.ObjectImage = emitted.ok;
    fin { obj.dnit(?temporary); }
    val names: intern.ReinternMap = intern.ReinternMap{
        base_len: s.interner.base_len + s.interner.len, ids: nil, len: 0
    };
    ret obj.rehome(s.alloc, ?s.interner, ?temporary, names);
}

fun codegen_scratch(s: *CodegenContext, tgt: *lang_target.Target,
    irmod: *me_ir.Module, deps: be_codegen_unit.IrSet, asm_out: *io_writer.Writer,
    placement_policy: u32, dbg: DebugInfo) res[target_of.ObjectImage, fail.Fail] {
    if (s == nil)     { ret res[target_of.ObjectImage, fail.Fail].err{fail.message("codegen: nil session")}; }
    if (tgt == nil)   { ret res[target_of.ObjectImage, fail.Fail].err{fail.message("codegen: nil target")}; }
    if (irmod == nil) { ret res[target_of.ObjectImage, fail.Fail].err{fail.message("codegen: nil ir module")}; }

    val res_lower: res[codegen_mir.MirModule, fail.Fail] = mir_lower.lower_module(tgt, irmod, s.alloc, ?s.session.interner, ?s.session.sources, s.diags);
    if (sel res_lower.err) {
        ret res[target_of.ObjectImage, fail.Fail].err{res_lower.err};
    }
    var mir_module: codegen_mir.MirModule = res_lower.ok;

    if (isa.emits_whole_module(tgt.isa)) {
        val res_whole: res[target_of.ObjectImage, fail.Fail] = whole_module_image(s, tgt, irmod, ?mir_module, deps, dbg);
        codegen_mir.dnit_module(?mir_module);
        ret res_whole;
    }

    val res_looprotate: err[fail.Fail] = looprotate.run(tgt, ?mir_module);
    if (sel res_looprotate.err) {
        codegen_mir.dnit_module(?mir_module);
        ret res[target_of.ObjectImage, fail.Fail].err{res_looprotate.err};
    }

    val res_extfold: err[fail.Fail] = extfold.run(tgt, ?mir_module);
    if (sel res_extfold.err) {
        codegen_mir.dnit_module(?mir_module);
        ret res[target_of.ObjectImage, fail.Fail].err{res_extfold.err};
    }

    val res_ctvalidate: err[fail.Fail] = ctvalidate.validate(tgt, ?mir_module);
    if (sel res_ctvalidate.err) {
        codegen_mir.dnit_module(?mir_module);
        ret res[target_of.ObjectImage, fail.Fail].err{res_ctvalidate.err};
    }

    val res_legalize: err[fail.Fail] = legalize.run(tgt, ?mir_module);
    if (sel res_legalize.err) {
        codegen_mir.dnit_module(?mir_module);
        ret res[target_of.ObjectImage, fail.Fail].err{res_legalize.err};
    }

    val res_prune: err[fail.Fail] = frame.prune(?mir_module);
    if (sel res_prune.err) {
        codegen_mir.dnit_module(?mir_module);
        ret res[target_of.ObjectImage, fail.Fail].err{res_prune.err};
    }

    val res_isel: err[fail.Fail] = isel.run(tgt, ?mir_module);
    if (sel res_isel.err) {
        codegen_mir.dnit_module(?mir_module);
        ret res[target_of.ObjectImage, fail.Fail].err{res_isel.err};
    }

    val res_regalloc: err[fail.Fail] = regalloc.run(tgt, ?mir_module);
    if (sel res_regalloc.err) {
        codegen_mir.dnit_module(?mir_module);
        ret res[target_of.ObjectImage, fail.Fail].err{res_regalloc.err};
    }

    val res_order: err[fail.Fail] = lay_out_blocks(?mir_module, tgt, resolve_placement_policy(placement_policy));
    if (sel res_order.err) {
        codegen_mir.dnit_module(?mir_module);
        ret res[target_of.ObjectImage, fail.Fail].err{res_order.err};
    }

    val res_frame: err[fail.Fail] = frame.run(tgt, ?mir_module);
    if (sel res_frame.err) {
        codegen_mir.dnit_module(?mir_module);
        ret res[target_of.ObjectImage, fail.Fail].err{res_frame.err};
    }

    val res_encode: res[codegen_encode.EncoderOutput, fail.Fail] = codegen_encode.run(tgt, ?mir_module, asm_out);
    if (sel res_encode.err) {
        codegen_mir.dnit_module(?mir_module);
        ret res[target_of.ObjectImage, fail.Fail].err{res_encode.err};
    }
    val enc: codegen_encode.EncoderOutput = res_encode.ok;

    val res_pack: res[target_of.ObjectImage, fail.Fail] = pack_image(s, tgt, irmod, ?mir_module, ?enc, dbg);
    codegen_mir.dnit_module(?mir_module);
    ret res_pack;
}

fun whole_module_image(s: *CodegenContext, tgt: *lang_target.Target, irmod: *me_ir.Module,
    mirmod: *codegen_mir.MirModule, deps: be_codegen_unit.IrSet, dbg: DebugInfo) res[target_of.ObjectImage, fail.Fail] {
    var u:  be_codegen_unit.Unit;
    val ru: err[fail.Fail] = be_codegen_unit.init(s.alloc, deps.len + 1, ?u);
    if (sel ru.err) { ret res[target_of.ObjectImage, fail.Fail].err{ru.err}; }
    u.root        = 0;
    u.mods[0].ir  = irmod;
    u.mods[0].mir = mirmod;

    var i: u32 = 0;
    for (i < deps.len) {
        val dm: *me_ir.Module                         = deps.mods[i];
        val rd: res[codegen_mir.MirModule, fail.Fail] = mir_lower.lower_module(tgt, dm, s.alloc, ?s.session.interner, ?s.session.sources, s.diags);
        if (sel rd.err) {
            unit_release(s, ?u, i);
            ret res[target_of.ObjectImage, fail.Fail].err{rd.err};
        }
        val rb: res[*codegen_mir.MirModule, A.Error] = A.allocate[codegen_mir.MirModule](s.alloc, 1::usize);
        if (sel rb.err) {
            var dead: codegen_mir.MirModule = rd.ok;
            codegen_mir.dnit_module(?dead);
            unit_release(s, ?u, i);
            ret res[target_of.ObjectImage, fail.Fail].err{fail.refused(rb.err)};
        }
        val box: *codegen_mir.MirModule = rb.ok;
        box[0]            = rd.ok;
        u.mods[i + 1].ir  = dm;
        u.mods[i + 1].mir = box;
        i                 = i + 1;
    }

    i = 0;
    for (i < u.len) {
        val res_ct: err[fail.Fail] = ctvalidate.validate(tgt, u.mods[i].mir);
        if (sel res_ct.err) {
            unit_release(s, ?u, deps.len);
            ret res[target_of.ObjectImage, fail.Fail].err{res_ct.err};
        }
        i = i + 1;
    }

    if (tgt.model.structured_control_flow) {
        i = 0;
        for (i < u.len) {
            val rs: res[*structure.Structure, fail.Fail] = structure.analyze_module(u.mods[i].mir, s.alloc);
            if (sel rs.err) {
                unit_release(s, ?u, deps.len);
                ret res[target_of.ObjectImage, fail.Fail].err{rs.err};
            }
            u.mods[i].shapes = rs.ok;
            i                = i + 1;
        }
    }

    val img: res[target_of.ObjectImage, fail.Fail] = emit_module_image(s, tgt, irmod, ?u, dbg);
    unit_release(s, ?u, deps.len);
    ret img;
}

pub val PLACEMENT_POLICY_VERSION: u32 = 1;

pub fun resolve_placement_policy(requested: u32) u32 {
    if (requested == 0) { ret PLACEMENT_POLICY_VERSION; }
    ret requested;
}

fun lay_out_blocks(m: *codegen_mir.MirModule, tgt: *lang_target.Target, policy: u32) err[fail.Fail] {
    if (policy != PLACEMENT_POLICY_VERSION) { ret err[fail.Fail].err{fail.message("codegen: unknown placement policy version")}; }
    ret blocklayout.run(tgt, m);
}

fun unit_release(s: *CodegenContext, u: *be_codegen_unit.Unit, n: u32) {
    var i: u32 = 0;
    for (i < u.len) {
        if (u.mods[i].shapes != nil) {
            structure.dnit_module(u.mods[i].shapes, u.mods[i].mir.function_len, s.alloc);
            u.mods[i].shapes = nil;
        }
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        val box: *codegen_mir.MirModule = u.mods[i + 1].mir;
        if (box != nil) {
            codegen_mir.dnit_module(box);
            A.deallocate[codegen_mir.MirModule](s.alloc, box, 1::usize);
            u.mods[i + 1].mir = nil;
        }
        i = i + 1;
    }
    be_codegen_unit.dnit(s.alloc, u);
}

fun finish_codegen_image(image: target_of.ObjectImage) res[target_of.ObjectImage, fail.Fail] {
    var made: target_of.ObjectImage = image;
    made.codegen = true;
    val valid: err[fail.Fail] = target_of.validate_owned_object_or_dnit(?made);
    if (sel valid.err) {
        ret res[target_of.ObjectImage, fail.Fail].err{valid.err};
    }
    ret res[target_of.ObjectImage, fail.Fail].ok{made};
}

fun emit_module_image(s: *CodegenContext, tgt: *lang_target.Target, irmod: *me_ir.Module,
    u: *be_codegen_unit.Unit, dbg: DebugInfo) res[target_of.ObjectImage, fail.Fail] {
    var module_debug: debug_input.ModuleDebug = debug_input.no_module_debug();
    if (dbg.emit && tgt.debug != nil) {
        if (tgt.debug.shape != target_of.DEBUG_SHAPE_MODULE) {
            ret res[target_of.ObjectImage, fail.Fail].err{fail.message("codegen: a whole-module emitter was handed a debug model that appends sections")};
        }
        if (!debug_types_ready(s.session)) {
            ret res[target_of.ObjectImage, fail.Fail].err{fail.message("codegen: debug type view was not finalized before code generation")};
        }
        module_debug.emit     = true;
        module_debug.comp_dir = dbg.comp_dir;
        module_debug.types    = ?s.session.types;
    }
    val res_image: res[target_of.ObjectImage, fail.Fail] = obj.image_init(s.alloc, ?s.session.interner, irmod.name);
    if (sel res_image.err) { ret res_image; }
    var image:          target_of.ObjectImage = res_image.ok;
    var backend_target: isa.BackendTarget     = resolved.backend_target(tgt);
    val r:              err[fail.Fail]        = tgt.isa.emitter.emit_module(s.alloc, ?backend_target, u, ?module_debug, ?image);
    if (sel r.err) {
        obj.dnit(?image);
        ret res[target_of.ObjectImage, fail.Fail].err{r.err};
    }
    ret finish_codegen_image(image);
}

# the debug view holds a field table for every instance the producer reaches:
# every instance of the program and what those reach. An expansive generic has
# unboundedly many instances (`rec L[T] { next: *L[*T]; }`), so one minted here
# is prepared only when held by value, and the producer describes a pointer to an
# unprepared one untyped
pub fun prepare_debug(s: *session.Session) err[fail.Fail] {
    if (s == nil) {
        ret err[fail.Fail].err{fail.message("codegen: cannot prepare debug types without a session")};
    }
    val marked: err[fail.Fail] = generics.mark_expansive(s);
    if (sel marked.err) { ret marked; }

    val program: u32 = type.type_count(?s.types);
    var tid:     u32 = 0;
    for (tid < type.type_count(?s.types)) {
        val type_id: type.TypeId     = tid::type.TypeId;
        val ot:      opt[*type.Type] = type.get(?s.types, type_id);
        if (sel ot.some
            && ot.some.kind == type.TYPE_INSTANCE
            && (tid < program || !type.instance_is_expansive(?s.types, type_id))) {
            val prepared: err[fail.Fail] = prepare_debug_instance(s, type_id);
            if (sel prepared.err) { ret prepared; }
        }
        tid = tid + 1;
    }
    ret err[fail.Fail].ok{};
}

fun prepare_debug_instance(s: *session.Session, type_id: type.TypeId) err[fail.Fail] {
    val prepared: err[fail.Fail] = generics.ensure_fields(s, type_id);
    if (sel prepared.err) { ret prepared; }
    val oft: opt[*type.FieldTable] = type.field_table_for(?s.types, type_id);
    if (!(sel oft.some && oft.some.epoch == type.field_epoch(?s.types))) {
        ret err[fail.Fail].err{fail.message("codegen: failed to finalize generic type fields for debug production")};
    }
    if (!type.expansive_any(?s.types)) { ret err[fail.Fail].ok{}; }
    ret prepare_debug_fields(s, type_id);
}

# the expansive instances a nominal's fields hold by value, which the main pass leaves
fun prepare_debug_fields(s: *session.Session, nominal: type.TypeId) err[fail.Fail] {
    val n: u32 = type.field_count(?s.types, nominal);
    var i: u32 = 0;
    for (i < n) {
        val fe: opt[*type.FieldEntry] = type.field_at(?s.types, nominal, i);
        if (sel fe.some) {
            val held: err[fail.Fail] = prepare_debug_held(s, fe.some.ty);
            if (sel held.err) { ret held; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun prepare_debug_held(s: *session.Session, tid: type.TypeId) err[fail.Fail] {
    val base: type.TypeId     = type.strip_secret(?s.types, tid);
    val ot:   opt[*type.Type] = type.get(?s.types, base);
    if (sel ot.none) { ret err[fail.Fail].ok{}; }
    val k: type.TypeKind = ot.some.kind;
    if (k == type.TYPE_ARRAY) { ret prepare_debug_held(s, ot.some.data.array.base); }
    if (k == type.TYPE_INSTANCE) {
        val oft: opt[*type.FieldTable] = type.field_table_for(?s.types, base);
        if (sel oft.some && oft.some.epoch == type.field_epoch(?s.types)) { ret err[fail.Fail].ok{}; }
        ret prepare_debug_instance(s, base);
    }
    if (k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_TAG) { ret prepare_debug_fields(s, base); }
    ret err[fail.Fail].ok{};
}

fun debug_types_ready(s: *session.Session) bool {
    if (s == nil)                          { ret false; }
    if (!type.expansive_current(?s.types)) { ret false; }
    var tid: u32 = 0;
    for (tid < type.type_count(?s.types)) {
        val type_id: type.TypeId     = tid::type.TypeId;
        val ot:      opt[*type.Type] = type.get(?s.types, type_id);
        # an expansive instance is prepared only where it is reached, and the
        # producer refuses one it reaches without a table
        if (sel ot.some
            && ot.some.kind == type.TYPE_INSTANCE
            && !type.instance_is_expansive(?s.types, type_id)) {
            val oft: opt[*type.FieldTable] = type.field_table_for(?s.types, type_id);
            if (sel oft.none)                                 { ret false; }
            if (oft.some.epoch != type.field_epoch(?s.types)) { ret false; }
        }
        tid = tid + 1;
    }
    ret true;
}

fun encoder_output_dnit(s: *CodegenContext, enc: *codegen_encode.EncoderOutput) {
    if (enc.text != nil && enc.text_len > 0) {
        A.deallocate[u8](s.alloc, enc.text, enc.text_len::usize);
    }
    enc.text     = nil;
    enc.text_len = 0;
    codegen_encode.consts_free(s.alloc, enc.consts, enc.const_count, enc.const_count);
    enc.consts      = nil;
    enc.const_count = 0;
    if (enc.symbols != nil && enc.symbol_count > 0) {
        A.deallocate[codegen_encode.SymbolMark](s.alloc, enc.symbols, enc.symbol_count::usize);
    }
    enc.symbols      = nil;
    enc.symbol_count = 0;
    if (enc.relocations != nil && enc.reloc_count > 0) {
        A.deallocate[codegen_encode.PendingReloc](s.alloc, enc.relocations, enc.reloc_count::usize);
    }
    enc.relocations = nil;
    enc.reloc_count = 0;
    if (enc.rows != nil && enc.row_count > 0) {
        A.deallocate[codegen_encode.LineRow](s.alloc, enc.rows, enc.row_count::usize);
    }
    enc.rows      = nil;
    enc.row_count = 0;
    if (enc.varlocs != nil && enc.varloc_count > 0) {
        A.deallocate[codegen_encode.VarLoc](s.alloc, enc.varlocs, enc.varloc_count::usize);
    }
    enc.varlocs      = nil;
    enc.varloc_count = 0;
    if (enc.inline_pcs != nil && enc.inline_pc_count > 0) {
        A.deallocate[codegen_encode.InlinePc](s.alloc, enc.inline_pcs, enc.inline_pc_count::usize);
    }
    enc.inline_pcs      = nil;
    enc.inline_pc_count = 0;
    if (enc.frames != nil && enc.frame_count > 0) {
        A.deallocate[target_of.FrameUnwind](s.alloc, enc.frames, enc.frame_count::usize);
    }
    enc.frames      = nil;
    enc.frame_count = 0;
}

fun pack_image(s: *CodegenContext, tgt: *lang_target.Target, irmod: *me_ir.Module,
    mirmod: *codegen_mir.MirModule, enc: *codegen_encode.EncoderOutput, dbg: DebugInfo) res[target_of.ObjectImage, fail.Fail] {
    val res_output: err[fail.Fail] = validate_encoder_output(?s.session.interner, s.alloc, enc);
    if (sel res_output.err) {
        encoder_output_dnit(s, enc);
        ret res[target_of.ObjectImage, fail.Fail].err{res_output.err};
    }

    val res_layout: res[TextLayout, fail.Fail] = build_text_layout(s, tgt, irmod, mirmod, enc);
    if (sel res_layout.err) {
        encoder_output_dnit(s, enc);
        ret res[target_of.ObjectImage, fail.Fail].err{res_layout.err};
    }
    var text_layout: TextLayout = res_layout.ok;

    val res_image: res[target_of.ObjectImage, fail.Fail] = obj.image_init(s.alloc, ?s.session.interner, irmod.name);
    if (sel res_image.err) {
        text_layout_dnit(s, ?text_layout);
        encoder_output_dnit(s, enc);
        ret res[target_of.ObjectImage, fail.Fail].err{res_image.err};
    }
    var image: target_of.ObjectImage = res_image.ok;

    image.machine_flags = isa.machine_flags(tgt.isa, tgt.abi.float_arg_bits, false);

    var attr_len: u32                 = 0;
    val attr_r:   res[*u8, fail.Fail] = isa.build_attributes(tgt.isa, ?tgt.model, s.alloc,
        tgt.abi.float_arg_bits, false, ?attr_len);
    if (sel attr_r.err) {
        text_layout_dnit(s, ?text_layout);
        encoder_output_dnit(s, enc);
        obj.dnit(?image);
        ret res[target_of.ObjectImage, fail.Fail].err{attr_r.err};
    }
    image.attributes     = attr_r.ok;
    image.attributes_len = attr_len;

    val res_sections: err[fail.Fail] = apply_text_layout(s, ?image, enc, ?text_layout);
    if (sel res_sections.err) {
        text_layout_dnit(s, ?text_layout);
        encoder_output_dnit(s, enc);
        obj.dnit(?image);
        ret res[target_of.ObjectImage, fail.Fail].err{res_sections.err};
    }

    val res_text: res[u32, fail.Fail] = pack_text(s, ?image, enc, ?text_layout);
    if (sel res_text.err) {
        text_layout_dnit(s, ?text_layout);
        encoder_output_dnit(s, enc);
        obj.dnit(?image);
        ret res[target_of.ObjectImage, fail.Fail].err{res_text.err};
    }
    val text_sec: u32 = res_text.ok;
    text_layout.text_sec = text_sec;

    val res_requests: err[fail.Fail] = pack_export_requests(?image, irmod);
    if (sel res_requests.err) {
        text_layout_dnit(s, ?text_layout);
        encoder_output_dnit(s, enc);
        obj.dnit(?image);
        ret res[target_of.ObjectImage, fail.Fail].err{res_requests.err};
    }

    val res_symbols: err[fail.Fail] = pack_symbols(?image, irmod, enc, ?text_layout);
    if (sel res_symbols.err) {
        text_layout_dnit(s, ?text_layout);
        encoder_output_dnit(s, enc);
        obj.dnit(?image);
        ret res[target_of.ObjectImage, fail.Fail].err{res_symbols.err};
    }

    val res_frames: err[fail.Fail] = pack_frames(?image, enc, ?text_layout);
    if (sel res_frames.err) {
        text_layout_dnit(s, ?text_layout);
        encoder_output_dnit(s, enc);
        obj.dnit(?image);
        ret res[target_of.ObjectImage, fail.Fail].err{res_frames.err};
    }

    val res_needs: err[fail.Fail] = pack_needs(?image, mirmod);
    if (sel res_needs.err) {
        text_layout_dnit(s, ?text_layout);
        encoder_output_dnit(s, enc);
        obj.dnit(?image);
        ret res[target_of.ObjectImage, fail.Fail].err{res_needs.err};
    }

    var deferred: obj.DeferredRelocs = obj.deferred_init(s.alloc);

    val res_relocs: err[fail.Fail] = pack_relocs(tgt, ?deferred, enc, ?text_layout);
    if (sel res_relocs.err) {
        text_layout_dnit(s, ?text_layout);
        obj.deferred_dnit(?deferred);
        encoder_output_dnit(s, enc);
        obj.dnit(?image);
        ret res[target_of.ObjectImage, fail.Fail].err{res_relocs.err};
    }
    pack_rows(enc, ?text_layout);
    text_layout_dnit(s, ?text_layout);

    val res_globals: err[fail.Fail] = pack_globals(s, tgt, ?image, ?deferred, irmod);
    if (sel res_globals.err) {
        obj.deferred_dnit(?deferred);
        encoder_output_dnit(s, enc);
        obj.dnit(?image);
        ret res[target_of.ObjectImage, fail.Fail].err{res_globals.err};
    }

    val res_pool: err[fail.Fail] = pack_constpool(s, ?image, enc);
    codegen_encode.consts_free(s.alloc, enc.consts, enc.const_count, enc.const_count);
    enc.consts      = nil;
    enc.const_count = 0;
    if (sel res_pool.err) {
        obj.deferred_dnit(?deferred);
        encoder_output_dnit(s, enc);
        obj.dnit(?image);
        ret res[target_of.ObjectImage, fail.Fail].err{res_pool.err};
    }

    val res_bind: err[fail.Fail] = obj.flush_deferred(?image, ?deferred);
    obj.deferred_dnit(?deferred);
    if (sel res_bind.err) {
        encoder_output_dnit(s, enc);
        obj.dnit(?image);
        ret res[target_of.ObjectImage, fail.Fail].err{res_bind.err};
    }

    if (dbg.emit && tgt.debug != nil) {
        if (tgt.debug.produce == nil) {
            encoder_output_dnit(s, enc);
            obj.dnit(?image);
            ret res[target_of.ObjectImage, fail.Fail].err{fail.message("codegen: debug producer registered no produce hook")};
        }
        if (!debug_types_ready(s.session)) {
            encoder_output_dnit(s, enc);
            obj.dnit(?image);
            ret res[target_of.ObjectImage, fail.Fail].err{fail.message("codegen: debug type view was not finalized before code generation")};
        }
        var req: target_of.DebugProduceRequest;
        req.program.alloc         = s.alloc;
        req.program.interner      = ?s.session.interner;
        req.program.types         = ?s.session.types;
        req.program.sources       = ?s.session.sources;
        req.program.type_aligns   = ?s.session.type_aligns;
        req.program.type_packed   = ?s.session.type_packed;
        req.program.field_epoch   = type.field_epoch(?s.session.types);
        req.program.ir_module     = irmod;
        req.program.mir_module    = mirmod;
        req.program.layout        = layout.machine(tgt.model.pointer_width, tgt.model.vector_bits, isa.vector_register_bits(?tgt.model));
        req.program.pointer_width = tgt.isa.pointer_width;
        req.program.dwarf_reg     = tgt.arch.dwarf_reg;
        req.program.frame_ptr_reg = tgt.arch.frame_ptr_reg;
        req.program.stack_ptr_reg = tgt.arch.stack_ptr_reg;
        req.image                 = ?image;
        req.rows                  = enc.rows;
        req.row_count             = enc.row_count;
        req.varlocs               = enc.varlocs;
        req.varloc_count          = enc.varloc_count;
        req.inline_pcs            = enc.inline_pcs;
        req.inline_pc_count       = enc.inline_pc_count;
        req.producer              = dbg.producer;
        req.comp_dir              = dbg.comp_dir;
        req.text_section          = text_sec;
        req.offset_kind           = tgt.of.debug_offset_kind;
        val res_dwarf: err[fail.Fail] = tgt.debug.produce(?req);
        if (sel res_dwarf.err) {
            encoder_output_dnit(s, enc);
            obj.dnit(?image);
            ret res[target_of.ObjectImage, fail.Fail].err{res_dwarf.err};
        }
    }

    encoder_output_dnit(s, enc);
    ret finish_codegen_image(image);
}

fun pack_text(s: *CodegenContext, image: *target_of.ObjectImage, enc: *codegen_encode.EncoderOutput,
    text_layout: *TextLayout) res[u32, fail.Fail] {
    val res_name: res[intern.StrId, A.Error] = intern.intern(?s.session.interner, ".text");
    if (sel res_name.err) {
        ret res[u32, fail.Fail].err{fail.refused(res_name.err)};
    }

    var sec: target_of.Section;
    sec.name  = res_name.ok;
    sec.kind  = target_of.SK_TEXT;
    sec.align = text_layout.align;
    sec.flags = 0;

    if (text_layout.placement_count == 0) {
        sec.bytes = enc.text;
        sec.len   = enc.text_len;
        val res_add: res[u32, fail.Fail] = target_of.section_install(image, ?sec);
        enc.text     = nil;
        enc.text_len = 0;
        ret res_add;
    }

    val new_len: u32 = enc.text_len - total_excised(text_layout.placements, text_layout.placement_count, text_layout.align);
    if (new_len == 0) {
        sec.bytes = nil;
        sec.len   = 0;
    }
    or {
        val res_buf: res[*u8, A.Error] = A.allocate[u8](s.alloc, new_len::usize);
        if (sel res_buf.err) {
            A.deallocate[u8](s.alloc, enc.text, enc.text_len::usize);
            enc.text     = nil;
            enc.text_len = 0;
            ret res[u32, fail.Fail].err{fail.refused(res_buf.err)};
        }
        val buf: *u8 = res_buf.ok;

        var write_pos: u32 = 0;
        var prev_end:  u32 = 0;
        var i:         u32 = 0;
        for (i < text_layout.placement_count) {
            val p:  *SectionPlacement = ?text_layout.placements[i];
            var ii: u32               = prev_end;
            for (ii < p.text_start) {
                buf[write_pos] = enc.text[ii];
                write_pos      = write_pos + 1;
                ii             = ii + 1;
            }
            var kept: u32 = (p.text_end - p.text_start) - excised_len(p, text_layout.align);
            for (kept > 0) {
                buf[write_pos] = text_layout.fill;
                write_pos      = write_pos + 1;
                kept           = kept - 1;
            }
            prev_end = p.text_end;
            i        = i + 1;
        }
        var ii: u32 = prev_end;
        for (ii < enc.text_len) {
            buf[write_pos] = enc.text[ii];
            write_pos      = write_pos + 1;
            ii             = ii + 1;
        }
        if (write_pos != new_len) {
            A.deallocate[u8](s.alloc, buf, new_len::usize);
            A.deallocate[u8](s.alloc, enc.text, enc.text_len::usize);
            enc.text     = nil;
            enc.text_len = 0;
            ret res[u32, fail.Fail].err{fail.message("codegen: text layout copy did not match its planned extent")};
        }

        sec.bytes = buf;
        sec.len   = new_len;
    }

    A.deallocate[u8](s.alloc, enc.text, enc.text_len::usize);
    enc.text     = nil;
    enc.text_len = 0;
    val res_add: res[u32, fail.Fail] = target_of.section_install(image, ?sec);
    ret res_add;
}

fun pack_export_requests(image: *target_of.ObjectImage, irmod: *me_ir.Module) err[fail.Fail] {
    var i: u32 = 0;
    for (i < irmod.export_request_len) {
        val added: err[fail.Fail] = target_of.export_request_add(image, irmod.export_requests[i]);
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun pack_symbols(image: *target_of.ObjectImage, irmod: *me_ir.Module,
    enc: *codegen_encode.EncoderOutput, text_layout: *TextLayout) err[fail.Fail] {
    var i: u32 = 0;
    for (i < enc.symbol_count) {
        val mark: *codegen_encode.SymbolMark = ?enc.symbols[i];

        var flags: u32 = mark.flags;
        if (function_is_defined(irmod, mark.name)) {
            flags = flags | target_of.SYM_OBJ_FLAG_GLOBAL;
        }
        if (function_is_weak(irmod, mark.name)) {
            flags = flags | target_of.SYM_OBJ_FLAG_WEAK;
        }
        if ((flags & target_of.SYM_OBJ_FLAG_GLOBAL) != 0 && !is_exported_definition(irmod, function_is_pub(irmod, mark.name))) {
            flags = flags | target_of.SYM_OBJ_FLAG_HIDDEN;
        }

        val site: PlacedSite = text_layout_place(text_layout, mark.offset);

        var sym: target_of.Symbol;
        sym.name     = mark.name;
        sym.section  = target_of.section_id(site.sec);
        sym.offset   = site.off;
        sym.size     = mark.size;
        sym.flags    = flags;
        sym.fallback = target_of.SYMBOL_NONE;
        sym.align    = 1;

        val res_sym: res[u32, fail.Fail] = target_of.symbol_add(image, sym);
        if (sel res_sym.err) {
            ret err[fail.Fail].err{res_sym.err};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the module's runtime needs, recorded as object symbols the linker unions: a
# module that multiplies a secret in a DIT_MODE cell carries the DIT marker, a
# local absolute symbol with no storage that never reaches a linked image
fun pack_needs(image: *target_of.ObjectImage, mirmod: *codegen_mir.MirModule) err[fail.Fail] {
    if (!codegen_mir.module_needs_dit(mirmod)) { ret err[fail.Fail].ok{}; }
    val nr: res[intern.StrId, A.Error] = intern.intern(image.interner, ct.DIT_NEED_MARKER);
    if (sel nr.err) { ret err[fail.Fail].err{fail.refused(nr.err)}; }
    var sym: target_of.Symbol;
    sym.name           = nr.ok;
    sym.section        = target_of.absolute_section();
    sym.offset         = 0;
    sym.size           = 0;
    sym.flags          = target_of.SYM_OBJ_FLAG_OBJECT;
    sym.fallback       = target_of.SYMBOL_NONE;
    sym.align          = 1;
    sym.absolute_value = ct.DIT_NEED_VALUE;
    val added: res[u32, fail.Fail] = target_of.symbol_add(image, sym);
    if (sel added.err) { ret err[fail.Fail].err{added.err}; }
    ret err[fail.Fail].ok{};
}

fun pack_frames(image: *target_of.ObjectImage, enc: *codegen_encode.EncoderOutput,
    text_layout: *TextLayout) err[fail.Fail] {
    var i: u32 = 0;
    for (i < enc.frame_count) {
        val site: PlacedSite            = text_layout_place(text_layout, enc.frames[i].offset);
        var fr:   target_of.FrameUnwind = enc.frames[i];
        fr.section = target_of.section_id(site.sec);
        fr.offset  = site.off;
        val res_fr: err[fail.Fail] = target_of.add_frame(image, ?fr);
        if (sel res_fr.err) { ret res_fr; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun pack_relocs(tgt: *lang_target.Target, deferred: *obj.DeferredRelocs, enc: *codegen_encode.EncoderOutput,
    text_layout: *TextLayout) err[fail.Fail] {
    val batch_base: u32 = deferred.count;
    var i:          u32 = 0;
    for (i < enc.reloc_count) {
        val pr: *codegen_encode.PendingReloc = ?enc.relocations[i];

        val site: PlacedSite = text_layout_place(text_layout, pr.offset);

        var rec: obj.DeferredReloc;
        rec.section      = target_of.section_id(site.sec);
        rec.offset       = site.off;
        rec.kind         = pr.kind;
        rec.name         = pr.sym;
        rec.addend       = pr.addend;
        rec.extern_flags = target_of.SYM_OBJ_FLAG_FUNCTION | target_of.SYM_OBJ_FLAG_EXTERN | target_of.SYM_OBJ_FLAG_GLOBAL;
        rec.pair         = 0;
        rec.inst_end     = pr.inst_end;
        rec.origin       = pr.origin;
        if (pr.pair != 0) {
            if (pr.pair > enc.reloc_count) {
                ret err[fail.Fail].err{fail.message("codegen: encoder relocation pair index is out of range")};
            }
            rec.pair = batch_base + pr.pair;
        }

        val res_rel: err[fail.Fail] =
            obj.defer_relocation_for_target(deferred, rec, tgt, target_of.SK_TEXT, true);
        if (sel res_rel.err) {
            ret res_rel;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun pack_rows(enc: *codegen_encode.EncoderOutput, text_layout: *TextLayout) {
    var i: u32 = 0;
    for (i < enc.row_count) {
        val site: PlacedSite = text_layout_place(text_layout, enc.rows[i].text_offset);
        enc.rows[i].sec         = site.sec;
        enc.rows[i].text_offset = site.off;
        i                       = i + 1;
    }
    var v: u32 = 0;
    for (v < enc.varloc_count) {
        val old_start: u32        = enc.varlocs[v].text_offset;
        val vsite:     PlacedSite = text_layout_place(text_layout, old_start);
        enc.varlocs[v].sec         = vsite.sec;
        enc.varlocs[v].text_offset = vsite.off;
        if (enc.varlocs[v].end_offset != 0) {
            val vend: PlacedSite = text_layout_place(text_layout, enc.varlocs[v].end_offset - 1);
            enc.varlocs[v].end_offset = vend.off + 1;
        }
        v = v + 1;
    }
    var ip: u32 = 0;
    for (ip < enc.inline_pc_count) {
        val ipsite: PlacedSite = text_layout_place(text_layout, enc.inline_pcs[ip].text_offset);
        enc.inline_pcs[ip].sec         = ipsite.sec;
        enc.inline_pcs[ip].text_offset = ipsite.off;
        ip                             = ip + 1;
    }
}

fun section_bytes_copy(image: *target_of.ObjectImage, src: *u8, len: u32) res[*u8, fail.Fail] {
    if (src == nil || len == 0) { ret res[*u8, fail.Fail].ok{src}; }
    val res_buf: res[*u8, A.Error] = A.allocate[u8](image.alloc, len::usize);
    if (sel res_buf.err) { ret res[*u8, fail.Fail].err{fail.refused(res_buf.err)}; }
    val buf: *u8 = res_buf.ok;
    memory.raw_copy(buf::ptr, src::ptr, len::usize);
    ret res[*u8, fail.Fail].ok{buf};
}

fun add_global_symbol(image: *target_of.ObjectImage, irmod: *me_ir.Module, g: *me_ir.Global, sec_idx: u32, sec_len: u32) err[fail.Fail] {
    var flags: u32 = target_of.SYM_OBJ_FLAG_OBJECT;
    if (!g.is_local)                                             { flags = flags | target_of.SYM_OBJ_FLAG_GLOBAL; }
    if (!g.is_local && !is_exported_definition(irmod, g.is_pub)) { flags = flags | target_of.SYM_OBJ_FLAG_HIDDEN; }

    var sym: target_of.Symbol;
    sym.name     = g.name;
    sym.section  = target_of.section_id(sec_idx);
    sym.offset   = 0;
    sym.size     = sec_len;
    sym.flags    = flags;
    sym.fallback = target_of.SYMBOL_NONE;
    sym.align    = 1;

    val result: res[u32, fail.Fail] = target_of.symbol_add(image, sym);
    if (sel result.err) { ret err[fail.Fail].err{result.err}; }
    ret err[fail.Fail].ok{};
}

fun embed_section_of(image: *target_of.ObjectImage, irmod: *me_ir.Module, upto: u32, bytes: *u8, len: u32,
    sec_name: intern.StrId, kind: target_of.SectionKind, align: u32) i64 {
    var j: u32 = 0;
    for (j < upto) {
        val o: *me_ir.Global = ?irmod.globals[j];
        if (!o.is_embed || o.is_extern) {
            j = j + 1;
            cnt;
        }
        if (o.init.kind != value.VAL_CONST_BYTES) {
            j = j + 1;
            cnt;
        }
        if (o.init.data.bytes.len != len) {
            j = j + 1;
            cnt;
        }
        if (o.section != sec_name && o.section != intern.STR_NIL) {
            j = j + 1;
            cnt;
        }

        val si: i64 = section_index_of(image, o.name);
        if (si < 0) {
            j = j + 1;
            cnt;
        }
        val sec: *target_of.Section = ?image.sections[si::u32];
        if (sec.kind != kind || sec.name != sec_name || sec.len != len) {
            j = j + 1;
            cnt;
        }
        if (sec.align != align) {
            j = j + 1;
            cnt;
        }
        if (len > 0 && !memory.raw_equal(sec.bytes::ptr, bytes::ptr, len::usize)) {
            j = j + 1;
            cnt;
        }
        ret si;
    }
    ret -1;
}

fun section_index_of(image: *target_of.ObjectImage, name: intern.StrId) i64 {
    var i: u32 = 0;
    for (i < image.symbol_count) {
        if (image.symbols[i].name == name) { ret target_of.section_index(image.symbols[i].section)::i64; }
        i = i + 1;
    }
    ret -1;
}

fun pack_globals(s: *CodegenContext, tgt: *lang_target.Target, image: *target_of.ObjectImage,
    deferred: *obj.DeferredRelocs, irmod: *me_ir.Module) err[fail.Fail] {
    val machine: layout.Machine = resolved.layout_machine(tgt);
    var i:       u32            = 0;
    for (i < irmod.global_len) {
        val g: *me_ir.Global = ?irmod.globals[i];

        if (g.is_extern) {
            val flags:      u32            = target_of.SYM_OBJ_FLAG_OBJECT | target_of.SYM_OBJ_FLAG_EXTERN | target_of.SYM_OBJ_FLAG_GLOBAL;
            val res_extern: err[fail.Fail] = image_extern_symbol_add(image, g.name, flags);
            if (sel res_extern.err) { ret res_extern; }
            i = i + 1;
            cnt;
        }

        var bytes: *u8 = nil;
        var len:   u32 = 0;
        if (g.init.kind == value.VAL_CONST_BYTES) {
            val res_copy: res[*u8, fail.Fail] = section_bytes_copy(image, g.init.data.bytes.ptr, g.init.data.bytes.len);
            if (sel res_copy.err) { ret err[fail.Fail].err{res_copy.err}; }
            bytes = res_copy.ok;
            len   = g.init.data.bytes.len;
        }
        or (g.init.kind == value.VAL_CONST_AGG) {
            val res_copy: res[*u8, fail.Fail] = section_bytes_copy(image, g.init.data.agg.bytes, g.init.data.agg.len);
            if (sel res_copy.err) { ret err[fail.Fail].err{res_copy.err}; }
            bytes = res_copy.ok;
            len   = g.init.data.agg.len;
        }
        or (g.init.kind == value.VAL_CONST_INT || g.init.kind == value.VAL_CONST_FLOAT) {
            val gsz:  u32       = ir_type.byte_size_for_machine(?irmod.types, g.ty, machine);
            var bits: wide.Wide = value.int_of(?g.init);
            if (g.init.kind == value.VAL_CONST_FLOAT && is_f32_type(?irmod.types, g.ty)) {
                bits = wide.from_u64(float.f64_to_f32_bits(bits.lo)::u64);
            }
            if (gsz > 0 && gsz < 16) { bits = wide.trunc(bits, gsz * 8); }
            # a writable zero scalar holds no bytes, so it lands in .bss as a zero aggregate does; the
            # bits are the test, so -0.0 keeps its bytes. read-only and #[section] globals keep theirs (#3421)
            val zero_fill: bool = wide.is_zero(bits) && g.is_mut && g.section == intern.STR_NIL;
            if (gsz == 0 || gsz > 16) {
                if (!wide.is_zero(bits)) {
                    ret err[fail.Fail].err{fail.message("be.codegen.pack_globals: non-zero scalar constant global initializer has unsupported size (expected 1..16 bytes)")};
                }
            }
            or (!zero_fill) {
                val res_bytes: res[*u8, A.Error] = A.allocate[u8](image.alloc, gsz::usize);
                if (sel res_bytes.err) { ret err[fail.Fail].err{fail.refused(res_bytes.err)}; }
                bytes = res_bytes.ok;
                var ii: u32 = 0;
                for (ii < gsz) {
                    bytes[ii] = wide.shr_u(bits, ii * 8).lo::u8;
                    ii        = ii + 1;
                }
                len = gsz;
            }
        }

        var kind:  target_of.SectionKind = target_of.SK_BSS;
        var sname: str                   = ".bss";
        if (bytes != nil || g.is_embed) {
            if (g.is_mut) {
                kind  = target_of.SK_DATA;
                sname = ".data";
            }
            or (g.init.kind == value.VAL_CONST_AGG && g.init.data.agg.reloc_count > 0) {
                kind  = target_of.SK_RELRO;
                sname = ".data.rel.ro";
            }
            or {
                kind  = target_of.SK_RODATA;
                sname = ".rodata";
            }
        }

        var sec_name: intern.StrId = g.section;
        if (sec_name == intern.STR_NIL) {
            val res_name: res[intern.StrId, A.Error] = intern.intern(?s.session.interner, sname);
            if (sel res_name.err) {
                ret err[fail.Fail].err{fail.refused(res_name.err)};
            }
            sec_name = res_name.ok;
        }

        var sec_len: u32 = len;
        if (kind == target_of.SK_BSS) {
            sec_len = ir_type.byte_size_for_machine(?irmod.types, g.ty, machine);
        }

        var sec_align: u32 = 8;
        val tya:       u32 = ir_type.byte_align_for_machine(?irmod.types, g.ty, machine);
        if (tya > sec_align)     { sec_align = tya; }
        if (g.align > sec_align) { sec_align = g.align; }

        if (g.is_embed) {
            val dup: i64 = embed_section_of(image, irmod, i, bytes, sec_len, sec_name, kind, sec_align);
            if (dup >= 0) {
                if (bytes != nil && sec_len > 0) {
                    A.deallocate[u8](image.alloc, bytes, sec_len::usize);
                }
                val res_alias: err[fail.Fail] = add_global_symbol(image, irmod, g, dup::u32, sec_len);
                if (sel res_alias.err) { ret res_alias; }
                i = i + 1;
                cnt;
            }
        }

        var sec: target_of.Section;
        sec.name  = sec_name;
        sec.kind  = kind;
        sec.bytes = bytes;
        sec.len   = sec_len;
        sec.align = sec_align;
        sec.flags = 0;
        if (g.is_embed)                  { sec.flags = target_of.SEC_FLAG_MERGEABLE; }
        if (g.section == intern.STR_NIL) { sec.flags = sec.flags | target_of.SEC_FLAG_COALESCE; }
        or                               { sec.flags = sec.flags | target_of.SEC_FLAG_RETAIN; }

        val res_section: res[u32, fail.Fail] = target_of.section_install(image, ?sec);
        if (sel res_section.err) {
            ret err[fail.Fail].err{res_section.err};
        }
        val sec_idx: u32 = res_section.ok;

        val res_sym: err[fail.Fail] = add_global_symbol(image, irmod, g, sec_idx, sec_len);
        if (sel res_sym.err) { ret res_sym; }

        if (g.init.kind == value.VAL_CONST_AGG) {
            val res_agg: err[fail.Fail] = pack_agg_relocs(tgt, deferred, ?g.init, sec_idx, tgt.isa.pointer_width);
            if (sel res_agg.err) { ret res_agg; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun pack_constpool(s: *CodegenContext, image: *target_of.ObjectImage, enc: *codegen_encode.EncoderOutput) err[fail.Fail] {
    if (enc.const_count == 0) { ret err[fail.Fail].ok{}; }

    val res_name: res[intern.StrId, A.Error] = intern.intern(?s.session.interner, ".rodata.cst");
    if (sel res_name.err) {
        ret err[fail.Fail].err{fail.refused(res_name.err)};
    }
    val sec_name: intern.StrId = res_name.ok;

    var i: u32 = 0;
    for (i < enc.const_count) {
        val e: *codegen_encode.ConstEntry = ?enc.consts[i];

        val res_copy: res[*u8, fail.Fail] = section_bytes_copy(image, e.bytes, e.len);
        if (sel res_copy.err) { ret err[fail.Fail].err{res_copy.err}; }

        var sec: target_of.Section;
        sec.name  = sec_name;
        sec.kind  = target_of.SK_RODATA;
        sec.bytes = res_copy.ok;
        sec.len   = e.len;
        sec.align = e.align;
        sec.flags = target_of.SEC_FLAG_MERGEABLE | target_of.SEC_FLAG_COALESCE;

        val res_sec: res[u32, fail.Fail] = target_of.section_install(image, ?sec);
        if (sel res_sec.err) {
            ret err[fail.Fail].err{res_sec.err};
        }

        var sym: target_of.Symbol;
        sym.name     = e.sym;
        sym.section  = target_of.section_id(res_sec.ok);
        sym.offset   = 0;
        sym.size     = e.len;
        sym.flags    = target_of.SYM_OBJ_FLAG_OBJECT;
        sym.fallback = target_of.SYMBOL_NONE;
        sym.align    = e.align;

        val res_sym: res[u32, fail.Fail] = target_of.symbol_add(image, sym);
        if (sel res_sym.err) { ret err[fail.Fail].err{res_sym.err}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun pack_agg_relocs(tgt: *lang_target.Target, deferred: *obj.DeferredRelocs, init: *value.Value, sec_idx: u32,
    pointer_width: u32) err[fail.Fail] {
    val kind_r: res[target_of.RelocKind, fail.Fail] = target_of.abs_kind_for_pointer_width(pointer_width);
    if (sel kind_r.err) { ret err[fail.Fail].err{kind_r.err}; }
    val kind: target_of.RelocKind = kind_r.ok;

    var i: u32 = 0;
    for (i < init.data.agg.reloc_count) {
        val ar: *value.AggReloc = ?init.data.agg.relocs[i];

        var flags: u32 = target_of.SYM_OBJ_FLAG_OBJECT | target_of.SYM_OBJ_FLAG_EXTERN | target_of.SYM_OBJ_FLAG_GLOBAL;
        if (ar.is_fn) { flags = target_of.SYM_OBJ_FLAG_FUNCTION | target_of.SYM_OBJ_FLAG_EXTERN | target_of.SYM_OBJ_FLAG_GLOBAL; }

        var rec: obj.DeferredReloc;
        rec.section      = target_of.section_id(sec_idx);
        rec.offset       = ar.offset;
        rec.kind         = kind;
        rec.name         = ar.symbol;
        rec.addend       = ar.addend;
        rec.extern_flags = flags;
        rec.pair         = 0;

        val res_rel: err[fail.Fail] =
            obj.defer_relocation_for_target(deferred, rec, tgt, target_of.SK_DATA, true);
        if (sel res_rel.err) { ret res_rel; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun encoder_span_valid[T](items: *T, count: u32) bool {
    ret (items == nil) == (count == 0);
}

# the encoder wrote every member here, so one outside its catalog is internal;
# the message names the catalog and the tag when the caller owns a diagnostic
# interner, and still names the catalog when it does not
fun validate_encoder_output(itn: *intern.Interner, alloc: *A.Allocator, enc: *codegen_encode.EncoderOutput) err[fail.Fail] {
    if (enc == nil) { ret err[fail.Fail].err{fail.message("codegen: nil encoder output")}; }
    if (!encoder_span_valid[u8](enc.text, enc.text_len)
        || !encoder_span_valid[codegen_encode.SymbolMark](enc.symbols, enc.symbol_count)
        || !encoder_span_valid[codegen_encode.PendingReloc](enc.relocations, enc.reloc_count)
        || !encoder_span_valid[codegen_encode.LineRow](enc.rows, enc.row_count)
        || !encoder_span_valid[codegen_encode.VarLoc](enc.varlocs, enc.varloc_count)
        || !encoder_span_valid[codegen_encode.InlinePc](enc.inline_pcs, enc.inline_pc_count)
        || !encoder_span_valid[codegen_encode.ConstEntry](enc.consts, enc.const_count)
        || !encoder_span_valid[target_of.FrameUnwind](enc.frames, enc.frame_count)) {
        ret err[fail.Fail].err{fail.message("codegen: encoder output has a noncanonical collection view")};
    }
    var i: u32 = 0;
    for (i < enc.reloc_count) {
        if (!target_of.reloc_kind_valid(enc.relocations[i].kind)) {
            ret err[fail.Fail].err{fail.message(fail.catalog_message_or(itn, alloc, fail.unknown_member("RelocKind", enc.relocations[i].kind::u32),
                "codegen: encoder output has an unknown RelocKind"))};
        }
        i = i + 1;
    }
    i = 0;
    for (i < enc.const_count) {
        val e: *codegen_encode.ConstEntry = ?enc.consts[i];
        if (e.kind < codegen_encode.CONST_F32 || e.kind > codegen_encode.CONST_VEC) {
            ret err[fail.Fail].err{fail.message(fail.catalog_message_or(itn, alloc, fail.unknown_member("ConstKind", e.kind::u32),
                "codegen: encoder output has an unknown ConstKind"))};
        }
        if (e.bytes == nil || e.len == 0 || e.align == 0 || (e.align & (e.align - 1)) != 0) {
            ret err[fail.Fail].err{fail.message("codegen: encoder output has an invalid constant-pool entry")};
        }
        i = i + 1;
    }
    i = 0;
    for (i < enc.frame_count) {
        val fr: *target_of.FrameUnwind = ?enc.frames[i];
        if (fr.step_count > target_of.FRAME_STEP_CAP) {
            ret err[fail.Fail].err{fail.message("codegen: encoder output has too many unwind steps")};
        }
        var k: u32 = 0;
        for (k < fr.step_count) {
            if (fr.steps[k].kind < target_of.FRAME_STEP_PUSH || fr.steps[k].kind > target_of.FRAME_STEP_LAST) {
                ret err[fail.Fail].err{fail.message(fail.catalog_message_or(itn, alloc, fail.unknown_member("FrameStepKind", fr.steps[k].kind::u32),
                    "codegen: encoder output has an unknown FrameStepKind"))};
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun build_text_layout(s: *CodegenContext, tgt: *lang_target.Target, irmod: *me_ir.Module,
    mirmod: *codegen_mir.MirModule, enc: *codegen_encode.EncoderOutput) res[TextLayout, fail.Fail] {
    var text_layout: TextLayout;
    text_layout.placements      = nil;
    text_layout.placement_count = 0;
    text_layout.placement_cap   = 0;
    text_layout.text_len        = enc.text_len;
    text_layout.text_sec        = target_of.SECTION_EXTERNAL;
    text_layout.align           = TEXT_SECTION_ALIGN;
    text_layout.fill            = tgt.model.code_fill;

    var fi: u32 = 0;
    for (fi < mirmod.function_len) {
        val f: *codegen_mir.MirFunction = ?mirmod.functions[fi];
        if (f.block_count > 0) {
            val a: u32 = codegen_encode.entry_align(?tgt.model, f.align);
            if (a > text_layout.align) { text_layout.align = a; }
        }
        fi = fi + 1;
    }

    if (enc.symbol_count > 0) {
        val res_buf: res[*SectionPlacement, A.Error] = A.allocate[SectionPlacement](s.alloc, enc.symbol_count::usize);
        if (sel res_buf.err) {
            ret res[TextLayout, fail.Fail].err{fail.refused(res_buf.err)};
        }
        text_layout.placements    = res_buf.ok;
        text_layout.placement_cap = enc.symbol_count;
    }

    var i: u32 = 0;
    for (i < enc.symbol_count) {
        val mark: *codegen_encode.SymbolMark = ?enc.symbols[i];
        if (function_is_defined(irmod, mark.name)) {
            val sname: intern.StrId = function_section_name(irmod, mark.name);
            if (sname != intern.STR_NIL) {
                var align: u32 = codegen_encode.entry_align(?tgt.model, function_align(irmod, mark.name));
                if (align < TEXT_SECTION_ALIGN) { align = TEXT_SECTION_ALIGN; }
                val planned: err[fail.Fail] = section_placement_plan(
                    text_layout.placements, ?text_layout.placement_count, text_layout.placement_cap,
                    sname, mark.offset, mark.size, align, enc.text_len);
                if (sel planned.err) {
                    text_layout_dnit(s, ?text_layout);
                    ret res[TextLayout, fail.Fail].err{planned.err};
                }
            }
        }
        i = i + 1;
    }

    if (text_layout.placement_count == 0 && text_layout.placements != nil) {
        A.deallocate[SectionPlacement](s.alloc, text_layout.placements, text_layout.placement_cap::usize);
        text_layout.placements    = nil;
        text_layout.placement_cap = 0;
    }

    val valid: err[fail.Fail] = validate_text_metadata(?text_layout, enc);
    if (sel valid.err) {
        text_layout_dnit(s, ?text_layout);
        ret res[TextLayout, fail.Fail].err{valid.err};
    }
    ret res[TextLayout, fail.Fail].ok{text_layout};
}

fun text_layout_dnit(s: *CodegenContext, text_layout: *TextLayout) {
    if (text_layout.placements != nil && text_layout.placement_cap > 0) {
        A.deallocate[SectionPlacement](s.alloc, text_layout.placements, text_layout.placement_cap::usize);
    }
    text_layout.placements      = nil;
    text_layout.placement_count = 0;
    text_layout.placement_cap   = 0;
    text_layout.text_len        = 0;
    text_layout.text_sec        = target_of.SECTION_EXTERNAL;
}

fun apply_text_layout(s: *CodegenContext, image: *target_of.ObjectImage, enc: *codegen_encode.EncoderOutput,
    text_layout: *TextLayout) err[fail.Fail] {
    var i: u32 = 0;
    for (i < text_layout.placement_count) {
        val res_sec: res[u32, fail.Fail] = func_section_add(
            s, image, text_layout.placements[i].name, enc,
            text_layout.placements[i].text_start, text_layout.placements[i].text_end,
            text_layout.placements[i].align);
        if (sel res_sec.err) {
            ret err[fail.Fail].err{res_sec.err};
        }
        text_layout.placements[i].sec = res_sec.ok;
        i                             = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun section_placement_plan(placements: *SectionPlacement, count: *u32, cap: u32,
    name: intern.StrId, start: u32, size: u32, align: u32,
    text_len: u32) err[fail.Fail] {
    if (placements == nil || count == nil) {
        ret err[fail.Fail].err{fail.message("codegen: section placement plan has no storage")};
    }
    if (size == 0) {
        ret err[fail.Fail].err{fail.message("codegen: a sectioned function has an empty encoded extent")};
    }
    if (@count >= cap) {
        ret err[fail.Fail].err{fail.message("codegen: section placement plan exceeds its capacity")};
    }
    if (start > text_len || size > text_len - start) {
        ret err[fail.Fail].err{fail.message("codegen: a sectioned function lies outside encoded text")};
    }
    val end:    u32 = start + size;
    var insert: u32 = 0;
    for (insert < @count && placements[insert].text_start < start) {
        insert = insert + 1;
    }
    if (insert > 0 && placements[insert - 1].text_end > start) {
        ret err[fail.Fail].err{fail.message("codegen: sectioned function extents overlap")};
    }
    if (insert < @count && end > placements[insert].text_start) {
        ret err[fail.Fail].err{fail.message("codegen: sectioned function extents overlap")};
    }
    var i: u32 = @count;
    for (i > insert) {
        placements[i] = placements[i - 1];
        i             = i - 1;
    }
    placements[insert].text_start = start;
    placements[insert].text_end   = end;
    placements[insert].name       = name;
    placements[insert].sec        = target_of.SECTION_EXTERNAL;
    placements[insert].align      = align;
    @count                        = @count + 1;
    ret err[fail.Fail].ok{};
}

fun func_section_add(s: *CodegenContext, image: *target_of.ObjectImage, sname: intern.StrId,
    enc: *codegen_encode.EncoderOutput, start: u32, end: u32, align: u32) res[u32, fail.Fail] {
    if (s == nil || image == nil || enc == nil || enc.text == nil
        || start >= end || end > enc.text_len) {
        ret res[u32, fail.Fail].err{fail.message("codegen: invalid function-section extent")};
    }
    val len:     u32               = end - start;
    val res_buf: res[*u8, A.Error] = A.allocate[u8](s.alloc, len::usize);
    if (sel res_buf.err) { ret res[u32, fail.Fail].err{fail.refused(res_buf.err)}; }
    val buf: *u8 = res_buf.ok;

    memory.raw_copy(buf::ptr, (enc.text::usize + start::usize)::ptr, len::usize);

    var sec: target_of.Section;
    sec.name  = sname;
    sec.kind  = target_of.SK_TEXT;
    sec.bytes = buf;
    sec.len   = len;
    sec.align = align;
    sec.flags = target_of.SEC_FLAG_RETAIN;
    val res_add: res[u32, fail.Fail] = target_of.section_install(image, ?sec);
    ret res_add;
}

fun image_extern_symbol_add(image: *target_of.ObjectImage, name: intern.StrId, flags: u32) err[fail.Fail] {
    var sym: target_of.Symbol;
    sym.name     = name;
    sym.section  = target_of.external_section();
    sym.offset   = 0;
    sym.size     = 0;
    sym.flags    = flags;
    sym.fallback = target_of.SYMBOL_NONE;
    sym.align    = 1;

    val res_sym: res[u32, fail.Fail] = target_of.symbol_add(image, sym);
    if (sel res_sym.err) { ret err[fail.Fail].err{res_sym.err}; }
    ret err[fail.Fail].ok{};
}

fun text_layout_place(text_layout: *TextLayout, offset: u32) PlacedSite {
    val opt_pl: opt[*SectionPlacement] = placement_for(
        text_layout.placements, text_layout.placement_count, offset);
    if (sel opt_pl.some) {
        val p: *SectionPlacement = opt_pl.some;
        ret PlacedSite{sec: p.sec, off: offset - p.text_start};
    }
    ret PlacedSite{
        sec: text_layout.text_sec,
        off: rebased_text_offset(text_layout.placements, text_layout.placement_count, text_layout.align, offset),
    };
}

fun placement_for(placements: *SectionPlacement, count: u32, offset: u32) opt[*SectionPlacement] {
    var i: u32 = 0;
    for (i < count) {
        val p: *SectionPlacement = ?placements[i];
        if (offset >= p.text_start && offset < p.text_end) { ret opt[*SectionPlacement].some{p}; }
        i = i + 1;
    }
    ret opt[*SectionPlacement].none{};
}

fun text_layout_source_site(text_layout: *TextLayout, offset: u32,
    allow_end: bool) res[PlacedSite, fail.Fail] {
    if (text_layout == nil
        || (text_layout.placement_count > 0 && text_layout.placements == nil)) {
        ret res[PlacedSite, fail.Fail].err{fail.message("codegen: text layout has no placement storage")};
    }
    if (offset > text_layout.text_len || (!allow_end && offset == text_layout.text_len)) {
        ret res[PlacedSite, fail.Fail].err{fail.message("codegen: encoded text point lies outside its source extent")};
    }
    var i: u32 = 0;
    for (i < text_layout.placement_count) {
        val p: *SectionPlacement = ?text_layout.placements[i];
        if (offset >= p.text_start && offset < p.text_end) {
            ret res[PlacedSite, fail.Fail].ok{PlacedSite{sec: i + 1, off: offset - p.text_start}};
        }
        i = i + 1;
    }
    ret res[PlacedSite, fail.Fail].ok{PlacedSite{
        sec: 0,
        off: rebased_text_offset(text_layout.placements, text_layout.placement_count, text_layout.align, offset),
    }};
}

fun text_layout_validate_range(text_layout: *TextLayout, start: u32,
    end: u32) err[fail.Fail] {
    if (start >= end || start >= text_layout.text_len || end > text_layout.text_len) {
        ret err[fail.Fail].err{fail.message("codegen: encoded text range lies outside its source extent")};
    }
    val res_first: res[PlacedSite, fail.Fail] = text_layout_source_site(text_layout, start, false);
    if (sel res_first.err) {
        ret err[fail.Fail].err{res_first.err};
    }
    val res_last: res[PlacedSite, fail.Fail] = text_layout_source_site(text_layout, end - 1, false);
    if (sel res_last.err) {
        ret err[fail.Fail].err{res_last.err};
    }
    val first: PlacedSite = res_first.ok;
    val last:  PlacedSite = res_last.ok;
    if (first.sec != last.sec || last.off < first.off
        || last.off - first.off != end - start - 1) {
        ret err[fail.Fail].err{fail.message("codegen: encoded text range crosses an output-section boundary")};
    }
    ret err[fail.Fail].ok{};
}

fun validate_text_metadata(text_layout: *TextLayout,
    enc: *codegen_encode.EncoderOutput) err[fail.Fail] {
    var i: u32 = 0;
    for (i < enc.symbol_count) {
        val mark: *codegen_encode.SymbolMark = ?enc.symbols[i];
        if (mark.offset > text_layout.text_len
            || mark.size > text_layout.text_len - mark.offset) {
            ret err[fail.Fail].err{fail.message("codegen: encoded symbol lies outside text")};
        }
        if (mark.size == 0) {
            val point: res[PlacedSite, fail.Fail] = text_layout_source_site(text_layout, mark.offset, true);
            if (sel point.err) {
                ret err[fail.Fail].err{fail.message("codegen: encoded symbol lies outside text")};
            }
        }
        or {
            val range: err[fail.Fail] = text_layout_validate_range(
                text_layout, mark.offset, mark.offset + mark.size);
            if (sel range.err) {
                ret err[fail.Fail].err{fail.message("codegen: encoded symbol crosses an output-section boundary")};
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < enc.frame_count) {
        val point: res[PlacedSite, fail.Fail] = text_layout_source_site(
            text_layout, enc.frames[i].offset, true);
        if (sel point.err) {
            ret err[fail.Fail].err{fail.message("codegen: unwind frame lies outside text")};
        }
        i = i + 1;
    }
    i = 0;
    for (i < enc.reloc_count) {
        val point: res[PlacedSite, fail.Fail] = text_layout_source_site(
            text_layout, enc.relocations[i].offset, false);
        if (sel point.err) {
            ret err[fail.Fail].err{fail.message("codegen: relocation lies outside text")};
        }
        i = i + 1;
    }
    i = 0;
    for (i < enc.row_count) {
        val point: res[PlacedSite, fail.Fail] = text_layout_source_site(
            text_layout, enc.rows[i].text_offset, true);
        if (sel point.err) {
            ret err[fail.Fail].err{fail.message("codegen: line row lies outside text")};
        }
        i = i + 1;
    }
    i = 0;
    for (i < enc.varloc_count) {
        val vl:    *codegen_encode.VarLoc     = ?enc.varlocs[i];
        val point: res[PlacedSite, fail.Fail] = text_layout_source_site(
            text_layout, vl.text_offset, false);
        if (sel point.err) {
            ret err[fail.Fail].err{fail.message("codegen: variable location starts outside text")};
        }
        if (vl.end_offset != 0) {
            val range: err[fail.Fail] = text_layout_validate_range(
                text_layout, vl.text_offset, vl.end_offset);
            if (sel range.err) {
                ret err[fail.Fail].err{fail.message("codegen: variable location range crosses an output-section boundary")};
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < enc.inline_pc_count) {
        val point: res[PlacedSite, fail.Fail] = text_layout_source_site(
            text_layout, enc.inline_pcs[i].text_offset, false);
        if (sel point.err) {
            ret err[fail.Fail].err{fail.message("codegen: inline PC lies outside text")};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the bytes a placement takes out of the text section: its extent less the
# remainder past a multiple of the section's alignment, which stays as fill
fun excised_len(p: *SectionPlacement, align: u32) u32 {
    val len: u32 = p.text_end - p.text_start;
    if (align <= 1) { ret len; }
    ret len - len % align;
}

fun total_excised(placements: *SectionPlacement, count: u32, align: u32) u32 {
    var sum: u32 = 0;
    var i:   u32 = 0;
    for (i < count) {
        sum = sum + excised_len(?placements[i], align);
        i   = i + 1;
    }
    ret sum;
}

fun rebased_text_offset(placements: *SectionPlacement, count: u32, align: u32, offset: u32) u32 {
    var shift: u32 = 0;
    var i:     u32 = 0;
    for (i < count) {
        val p: *SectionPlacement = ?placements[i];
        if (p.text_end <= offset) { shift = shift + excised_len(p, align); }
        i = i + 1;
    }
    ret offset - shift;
}

# the module's name table answers first; the scan remains for a module whose
# table names an extern declaration while a definition of the same name exists
fun function_defined_get(irmod: *me_ir.Module, name: intern.StrId) opt[*me_ir.Function] {
    val known: opt[u32] = me_ir.function_lookup(irmod, name);
    if (sel known.some) {
        val kf: *me_ir.Function = ?irmod.functions[known.some];
        if (kf.name == name && (kf.flags & me_ir.FN_FLAG_EXTERN) == 0) { ret opt[*me_ir.Function].some{kf}; }
    }
    var i: u32 = 0;
    for (i < irmod.function_len) {
        val fn: *me_ir.Function = ?irmod.functions[i];
        if (fn.name == name && (fn.flags & me_ir.FN_FLAG_EXTERN) == 0) {
            ret opt[*me_ir.Function].some{fn};
        }
        i = i + 1;
    }
    ret opt[*me_ir.Function].none{};
}

fun function_is_defined(irmod: *me_ir.Module, name: intern.StrId) bool {
    val defined: opt[*me_ir.Function] = function_defined_get(irmod, name);
    ret sel defined.some;
}

fun function_align(irmod: *me_ir.Module, name: intern.StrId) u32 {
    val opt_fn: opt[*me_ir.Function] = function_defined_get(irmod, name);
    if (sel opt_fn.none) { ret 0; }
    val fn: *me_ir.Function = opt_fn.some;
    ret fn.align;
}

fun function_section_name(irmod: *me_ir.Module, name: intern.StrId) intern.StrId {
    val opt_fn: opt[*me_ir.Function] = function_defined_get(irmod, name);
    if (sel opt_fn.none) { ret intern.STR_NIL; }
    val fn: *me_ir.Function = opt_fn.some;
    ret fn.section;
}

# a linked image exports the root project's `pub` declarations: a dependency's
# public surface is the dependency's ABI, not this library's
fun is_exported_definition(irmod: *me_ir.Module, is_pub: bool) bool {
    ret is_pub && irmod.root_project;
}

fun function_is_pub(irmod: *me_ir.Module, name: intern.StrId) bool {
    val opt_fn: opt[*me_ir.Function] = function_defined_get(irmod, name);
    if (sel opt_fn.none) { ret false; }
    val fn: *me_ir.Function = opt_fn.some;
    ret (fn.flags & me_ir.FN_FLAG_PUB) != 0;
}

fun function_is_weak(irmod: *me_ir.Module, name: intern.StrId) bool {
    val opt_fn: opt[*me_ir.Function] = function_defined_get(irmod, name);
    if (sel opt_fn.none) { ret false; }
    val fn: *me_ir.Function = opt_fn.some;
    ret (fn.flags & me_ir.FN_FLAG_WEAK) != 0;
}

fun is_f32_type(types: *ir_type.IrTypeTable, id: ir_type.IrTypeId) bool {
    val opt_type: opt[*ir_type.IrType] = ir_type.get(types, id);
    if (sel opt_type.none) { ret false; }
    val t: *ir_type.IrType = opt_type.some;
    ret t.kind == ir_type.IRT_FLOAT && t.data.bits == 32;
}

test section_placement_plan__sorts_and_rejects_invalid_extents {
    var placements:               [3]SectionPlacement;
    var count:                    u32            = 0;
    val section_placement_plan_r: err[fail.Fail] = section_placement_plan(?placements[0], ?count, 3,
        3::intern.StrId, 16, 4, 16, 32);
    if (sel section_placement_plan_r.err) { ret 1; }
    val section_placement_plan_r2: err[fail.Fail] = section_placement_plan(?placements[0], ?count, 3,
        1::intern.StrId, 0, 8, 16, 32);
    if (sel section_placement_plan_r2.err) { ret 2; }
    val section_placement_plan_r3: err[fail.Fail] = section_placement_plan(?placements[0], ?count, 3,
        2::intern.StrId, 8, 8, 16, 32);
    if (sel section_placement_plan_r3.err) { ret 3; }
    if (count != 3)                        { ret 4; }
    if (placements[0].text_start != 0 || placements[0].text_end != 8
        || placements[0].name != 1::intern.StrId) { ret 5; }
    if (placements[1].text_start != 8 || placements[1].text_end != 16
        || placements[1].name != 2::intern.StrId) { ret 6; }
    if (placements[2].text_start != 16 || placements[2].text_end != 20
        || placements[2].name != 3::intern.StrId) { ret 7; }

    var bad_count:                 u32            = count;
    val section_placement_plan_r4: err[fail.Fail] = section_placement_plan(?placements[0], ?bad_count, 3,
        4::intern.StrId, 20, 1, 16, 32);
    if (sel section_placement_plan_r4.ok) { ret 8; }
    bad_count = 1;
    val section_placement_plan_r5: err[fail.Fail] = section_placement_plan(?placements[0], ?bad_count, 3,
        4::intern.StrId, 7, 2, 16, 32);
    if (sel section_placement_plan_r5.ok) { ret 9; }
    val section_placement_plan_r6: err[fail.Fail] = section_placement_plan(?placements[0], ?bad_count, 3,
        4::intern.StrId, 31, 2, 16, 32);
    if (sel section_placement_plan_r6.ok) { ret 10; }
    val section_placement_plan_r7: err[fail.Fail] = section_placement_plan(?placements[0], ?bad_count, 3,
        4::intern.StrId, 20, 0, 16, 32);
    if (sel section_placement_plan_r7.ok) { ret 11; }
    ret 0;
}

#[testing]
fun t_pair_traits(kind: target_of.RelocKind, section_kind: target_of.SectionKind,
    codegen_image: bool) res[of_reloc.RelocTraits, of_reloc.RelocError] {
    if (kind != target_of.RK_PCREL_HI20 && kind != target_of.RK_PCREL_LO12_I) {
        ret res[of_reloc.RelocTraits, of_reloc.RelocError].err{of_reloc.RELOC_UNSUPPORTED};
    }
    ret res[of_reloc.RelocTraits, of_reloc.RelocError].ok{of_reloc.traits(4, of_reloc.RELOC_ADDEND_SYMBOL, 0, 0)};
}

test pack_relocs__carries_the_encoder_pair_index_to_the_image {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val hi_name:  res[intern.StrId, A.Error] = intern.intern(?s.interner, "pair_target");
    val lo_name:  res[intern.StrId, A.Error] = intern.intern(?s.interner, ".Lpcrel_hi.0");
    val img_name: res[intern.StrId, A.Error] = intern.intern(?s.interner, "pairs.o");
    if (sel hi_name.err)  { ret 2; }
    if (sel lo_name.err)  { ret 2; }
    if (sel img_name.err) { ret 2; }

    var relocations: [2]codegen_encode.PendingReloc;
    relocations[0].offset = 0;
    relocations[0].kind   = target_of.RK_PCREL_HI20;
    relocations[0].sym    = hi_name.ok;
    relocations[0].addend = 0;
    relocations[0].pair   = 0;
    relocations[1].offset = 4;
    relocations[1].kind   = target_of.RK_PCREL_LO12_I;
    relocations[1].sym    = lo_name.ok;
    relocations[1].addend = 0;
    relocations[1].pair   = 1;

    var text: [8]u8;
    var enc:  codegen_encode.EncoderOutput;
    enc.text        = ?text[0];
    enc.text_len    = 8;
    enc.relocations = ?relocations[0];
    enc.reloc_count = 2;

    var text_layout: TextLayout;
    text_layout.placements      = nil;
    text_layout.placement_count = 0;
    text_layout.placement_cap   = 0;
    text_layout.text_len        = 8;
    text_layout.text_sec        = 1;

    var seam:    isa.RelocSeam  = isa.reloc_seam(nil, t_pair_traits, nil);
    var machine: isa.RegMachine = t_placement_machine();
    var model:   isa.MachineModel;
    var vt:      isa.IsaVTable  = isa.machine_isa(isa.ARCH_UNKNOWN, "pairprobe", 0, 8,
        ?model, ?machine, ?seam);
    var tgt: resolved.Target;
    tgt.isa = ?vt;

    var deferred: obj.DeferredRelocs = obj.deferred_init(?alloc);
    fin { obj.deferred_dnit(?deferred); }

    val pack_relocs_r: err[fail.Fail] = pack_relocs(?tgt, ?deferred, ?enc, ?text_layout);
    if (sel pack_relocs_r.err)       { ret 3; }
    if (deferred.count != 2)         { ret 4; }
    if (deferred.items[0].pair != 0) { ret 5; }
    if (deferred.items[1].pair != 1) { ret 6; }

    val image_r: res[target_of.ObjectImage, fail.Fail] = obj.image_init(?alloc, ?s.interner, img_name.ok);
    if (sel image_r.err) { ret 7; }
    var image:   target_of.ObjectImage = image_r.ok;
    var standin: target_of.Relocation;
    standin.section = target_of.section_id(0);
    standin.offset  = 0;
    standin.kind    = target_of.RK_ABS64;
    standin.sym     = 0;
    standin.addend  = 0;
    standin.sym2    = target_of.SYMBOL_NONE;
    standin.pair    = 0;
    val add_relocation_r: err[fail.Fail] = target_of.add_relocation(?image, standin);
    if (sel add_relocation_r.err) { ret 7; }

    val flush_deferred_r: err[fail.Fail] = obj.flush_deferred(?image, ?deferred);
    if (sel flush_deferred_r.err)                                                         { ret 8; }
    if (image.reloc_count != 3)                                                           { ret 9; }
    if (image.relocations[1].pair != 0)                                                   { ret 10; }
    if (image.relocations[2].pair != 2)                                                   { ret 11; }
    if (image.relocations[image.relocations[2].pair - 1].kind != target_of.RK_PCREL_HI20) { ret 12; }
    ret 0;
}

test text_layout__preflights_points_and_half_open_ranges {
    var placements: [1]SectionPlacement;
    placements[0].text_start = 8;
    placements[0].text_end   = 16;
    placements[0].sec        = 5;

    var text_layout: TextLayout;
    text_layout.placements      = ?placements[0];
    text_layout.placement_count = 1;
    text_layout.placement_cap   = 1;
    text_layout.text_len        = 24;
    text_layout.text_sec        = 1;

    var symbols: [3]codegen_encode.SymbolMark;
    symbols[0].offset = 0;
    symbols[0].size   = 8;
    symbols[1].offset = 8;
    symbols[1].size   = 8;
    symbols[2].offset = 16;
    symbols[2].size   = 8;

    var frames: [1]target_of.FrameUnwind;
    frames[0].offset     = 24;
    frames[0].step_count = 0;

    var relocations: [1]codegen_encode.PendingReloc;
    relocations[0].offset = 8;
    relocations[0].kind   = target_of.RK_PC32;

    var rows: [2]codegen_encode.LineRow;
    rows[0].text_offset = 0;
    rows[1].text_offset = 24;

    var varlocs: [2]codegen_encode.VarLoc;
    varlocs[0].text_offset = 8;
    varlocs[0].end_offset  = 16;
    varlocs[1].text_offset = 16;
    varlocs[1].end_offset  = 20;

    var inline_pcs: [1]codegen_encode.InlinePc;
    inline_pcs[0].text_offset = 15;

    var text: [24]u8;
    var enc:  codegen_encode.EncoderOutput;
    enc.text            = ?text[0];
    enc.text_len        = 24;
    enc.symbols         = ?symbols[0];
    enc.symbol_count    = 3;
    enc.frames          = ?frames[0];
    enc.frame_count     = 1;
    enc.relocations     = ?relocations[0];
    enc.reloc_count     = 1;
    enc.rows            = ?rows[0];
    enc.row_count       = 2;
    enc.varlocs         = ?varlocs[0];
    enc.varloc_count    = 2;
    enc.inline_pcs      = ?inline_pcs[0];
    enc.inline_pc_count = 1;

    val validate_encoder_output_r: err[fail.Fail] = validate_encoder_output(nil, nil, ?enc);
    if (sel validate_encoder_output_r.err) { ret 1; }
    val validate_text_metadata_r: err[fail.Fail] = validate_text_metadata(?text_layout, ?enc);
    if (sel validate_text_metadata_r.err) { ret 2; }

    varlocs[0].end_offset = 17;
    val validate_text_metadata_r2: err[fail.Fail] = validate_text_metadata(?text_layout, ?enc);
    if (sel validate_text_metadata_r2.ok) { ret 3; }
    varlocs[0].end_offset = 7;
    val validate_text_metadata_r3: err[fail.Fail] = validate_text_metadata(?text_layout, ?enc);
    if (sel validate_text_metadata_r3.ok) { ret 4; }
    varlocs[0].end_offset = 16;

    rows[1].text_offset = 25;
    val validate_text_metadata_r4: err[fail.Fail] = validate_text_metadata(?text_layout, ?enc);
    if (sel validate_text_metadata_r4.ok) { ret 5; }
    rows[1].text_offset = 24;

    inline_pcs[0].text_offset = 24;
    val validate_text_metadata_r5: err[fail.Fail] = validate_text_metadata(?text_layout, ?enc);
    if (sel validate_text_metadata_r5.ok) { ret 6; }
    inline_pcs[0].text_offset = 15;

    symbols[0].offset = 4;
    val validate_text_metadata_r6: err[fail.Fail] = validate_text_metadata(?text_layout, ?enc);
    if (sel validate_text_metadata_r6.ok) { ret 7; }
    symbols[0].offset = 0;

    relocations[0].offset = 24;
    val validate_text_metadata_r7: err[fail.Fail] = validate_text_metadata(?text_layout, ?enc);
    if (sel validate_text_metadata_r7.ok) { ret 8; }
    relocations[0].offset = 8;

    pack_rows(?enc, ?text_layout);
    if (rows[0].sec != 1 || rows[0].text_offset != 0
        || rows[1].sec != 1 || rows[1].text_offset != 16) { ret 9; }
    if (varlocs[0].sec != 5 || varlocs[0].text_offset != 0 || varlocs[0].end_offset != 8
        || varlocs[1].sec != 1 || varlocs[1].text_offset != 8 || varlocs[1].end_offset != 12) { ret 10; }
    if (inline_pcs[0].sec != 5 || inline_pcs[0].text_offset != 7) { ret 11; }
    ret 0;
}

test embed_section_of__shares_only_on_a_full_match {
    val rodata: intern.StrId = 7::intern.StrId;
    val other:  intern.StrId = 9::intern.StrId;

    var abc: [3]u8;
    abc[0] = 'a';
    abc[1] = 'b';
    abc[2] = 'c';
    var xyz: [3]u8;
    xyz[0] = 'x';
    xyz[1] = 'y';
    xyz[2] = 'z';

    var secs: [1]target_of.Section;
    secs[0].name  = rodata;
    secs[0].kind  = target_of.SK_RODATA;
    secs[0].bytes = ?abc[0];
    secs[0].len   = 3;
    secs[0].align = 8;

    var syms: [1]target_of.Symbol;
    syms[0].name    = 100::intern.StrId;
    syms[0].section = target_of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 3;
    syms[0].flags   = target_of.SYM_OBJ_FLAG_OBJECT;

    var image: target_of.ObjectImage;
    image.sections      = ?secs[0];
    image.section_count = 1;
    image.symbols       = ?syms[0];
    image.symbol_count  = 1;

    var globals: [1]me_ir.Global;
    globals[0].name      = 100::intern.StrId;
    globals[0].init      = value.const_bytes(?abc[0], 3, 0::ir_type.IrTypeId);
    globals[0].is_embed  = true;
    globals[0].is_extern = false;
    globals[0].section   = intern.STR_NIL;

    var irmod: me_ir.Module;
    irmod.globals = ?globals[0];

    if (embed_section_of(?image, ?irmod, 1, ?abc[0], 3, rodata, target_of.SK_RODATA, 8) != 0) { ret 1; }

    if (embed_section_of(?image, ?irmod, 1, ?xyz[0], 3, rodata, target_of.SK_RODATA, 8) != -1) { ret 1; }

    if (embed_section_of(?image, ?irmod, 1, ?abc[0], 3, rodata, target_of.SK_RODATA, 64) != -1) { ret 1; }

    if (embed_section_of(?image, ?irmod, 1, ?abc[0], 3, other, target_of.SK_RODATA, 8) != -1) { ret 1; }

    globals[0].is_embed = false;
    if (embed_section_of(?image, ?irmod, 1, ?abc[0], 3, rodata, target_of.SK_RODATA, 8) != -1) { ret 1; }

    globals[0].is_embed = true;
    globals[0].init     = value.const_bytes(nil, 0, 0::ir_type.IrTypeId);
    secs[0].bytes       = nil;
    secs[0].len         = 0;
    syms[0].size        = 0;
    if (embed_section_of(?image, ?irmod, 1, nil, 0, rodata, target_of.SK_RODATA, 8) != 0) { ret 1; }

    ret 0;
}

#[testing]
fun t_is_trap_stub(opcode: u32) bool {
    ret opcode == codegen_mir.MIR_UNREACHABLE::u32;
}

#[testing]
fun t_is_reg_move_stub(opcode: u32) bool {
    ret false;
}

#[testing]
fun t_placement_machine() isa.RegMachine {
    ret isa.reg_machine(nil, nil, t_is_reg_move_stub, t_is_trap_stub,
        nil, 0, nil, 0,
        -1, -1,
        -1, -1, 0,
        -1, -1, -1);
}

test finish_codegen_image__publishes_only_valid_owned_images {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);

    val empty_r: res[target_of.ObjectImage, fail.Fail] = obj.image_init(?alloc, ?itn, intern.STR_NIL);
    if (sel empty_r.err) {
        intern.dnit(?itn);
        ret 1;
    }
    val published_r: res[target_of.ObjectImage, fail.Fail] =
        finish_codegen_image(empty_r.ok);
    if (sel published_r.err) {
        intern.dnit(?itn);
        ret 1;
    }
    var published: target_of.ObjectImage = published_r.ok;
    val marked:    bool                  = published.codegen;
    obj.dnit(?published);
    if (!marked) {
        intern.dnit(?itn);
        ret 1;
    }

    val malformed_r: res[target_of.ObjectImage, fail.Fail] = obj.image_init(?alloc, ?itn, intern.STR_NIL);
    if (sel malformed_r.err) {
        intern.dnit(?itn);
        ret 1;
    }
    var malformed: target_of.ObjectImage = malformed_r.ok;
    val bytes_r:   res[*u8, A.Error]     = A.allocate[u8](?alloc, 4::usize);
    if (sel bytes_r.err) {
        obj.dnit(?malformed);
        intern.dnit(?itn);
        ret 1;
    }
    var sec: target_of.Section;
    sec.name  = intern.STR_NIL;
    sec.kind  = target_of.SK_TEXT;
    sec.bytes = bytes_r.ok;
    sec.len   = 4;
    sec.align = 3;
    sec.flags = 0;
    val section_install_r: res[u32, fail.Fail] = target_of.section_install(?malformed, ?sec);
    if (sel section_install_r.err) {
        obj.dnit(?malformed);
        intern.dnit(?itn);
        ret 1;
    }
    val rejected: res[target_of.ObjectImage, fail.Fail] = finish_codegen_image(malformed);
    if (sel rejected.ok) {
        var unexpected: target_of.ObjectImage = rejected.ok;
        obj.dnit(?unexpected);
        intern.dnit(?itn);
        ret 1;
    }

    intern.dnit(?itn);
    ret 0;
}

# the export predicate, read off the emitted object: a `pub` definition in a
# root-project module is the only one the image offers, and the same module
# compiled as a dependency's offers nothing
test pack_globals__only_a_root_project_pub_definition_is_left_visible {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val registered: err[fail.Fail] = lang_target.register_all(s.registry, target_testing.debug_descriptor);
    if (sel registered.err) { ret 2; }
    val selected: res[lang_target.Target, fail.Fail] = lang_target.select(s.registry, "x86_64", "linux", "sysv64");
    if (sel selected.err) { ret 2; }
    var tgt: lang_target.Target = selected.ok;

    val open_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "visible_global");
    if (sel open_r.err) { ret 2; }
    val shut_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "private_global");
    if (sel shut_r.err) { ret 2; }
    val open_name: intern.StrId = open_r.ok;
    val shut_name: intern.StrId = shut_r.ok;

    var root: u32 = 0;
    for (root < 2) {
        val initialized: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, open_name);
        if (sel initialized.err) { ret 3; }
        var module: me_ir.Module = initialized.ok;
        module.root_project = root == 1;
        val typed: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?module.types, 64);
        if (sel typed.err) {
            me_ir.dnit(?module);
            ret 3;
        }
        val ty: ir_type.IrTypeId = typed.ok;
        module.globals[0] = me_ir.Global{name: open_name, ty: ty, init: value.const_int(1, ty),
            is_mut:   false, is_pub: true, is_extern: false, is_import: false, is_local: false,
            is_embed: false, align: 8, section: intern.STR_NIL, iface: 0, iface_a: 0, iface_b: 0, iface_flags: 0,
            disp:     intern.STR_NIL, ty_sem: type.TYPE_NIL};
        module.globals[1] = me_ir.Global{name: shut_name, ty: ty, init: value.const_int(2, ty),
            is_mut:   false, is_pub: false, is_extern: false, is_import: false, is_local: false,
            is_embed: false, align: 8, section: intern.STR_NIL, iface: 0, iface_a: 0, iface_b: 0, iface_flags: 0,
            disp:     intern.STR_NIL, ty_sem: type.TYPE_NIL};
        module.global_len = 2;

        val emitted: res[target_of.ObjectImage, fail.Fail] = codegen_unit(?s, ?tgt, ?module,
            be_codegen_unit.ir_set_empty(), nil, PLACEMENT_POLICY_VERSION, no_debug(), ?s.diags);
        me_ir.dnit(?module);
        if (sel emitted.err) { ret 4; }
        var image: target_of.ObjectImage = emitted.ok;
        var seen:  u32                   = 0;
        var i:     u32                   = 0;
        for (i < image.symbol_count) {
            val sym:    *target_of.Symbol = ?image.symbols[i];
            val hidden: bool              = (sym.flags & target_of.SYM_OBJ_FLAG_HIDDEN) != 0;
            if (sym.name == open_name) {
                seen = seen + 1;
                if ((sym.flags & target_of.SYM_OBJ_FLAG_GLOBAL) == 0) {
                    obj.dnit(?image);
                    ret 5;
                }
                # `pub` in the root project is the whole export rule
                if (hidden == (root == 1)) {
                    obj.dnit(?image);
                    ret 6;
                }
            }
            if (sym.name == shut_name) {
                seen = seen + 1;
                if (!hidden) {
                    obj.dnit(?image);
                    ret 7;
                }
            }
            i = i + 1;
        }
        obj.dnit(?image);
        if (seen != 2) { ret 8; }
        root = root + 1;
    }
    ret 0;
}

# the section kind the image gives the symbol `name`, or 255 when it has none
#[testing]
fun t_global_kind(image: *target_of.ObjectImage, name: intern.StrId) u8 {
    var i: u32 = 0;
    for (i < image.symbol_count) {
        if (image.symbols[i].name == name) {
            val sec: *target_of.Section = ?image.sections[target_of.section_index(image.symbols[i].section)];
            if (sec.kind == target_of.SK_BSS && sec.bytes != nil) { ret 254; }
            ret sec.kind::u8;
        }
        i = i + 1;
    }
    ret 255;
}

# a writable global whose scalar initializer has all-zero bits holds no bytes and lands in .bss,
# like a zero aggregate; -0.0, non-zero, read-only and #[section] globals keep their bytes (#3421)
test pack_globals__a_writable_zero_scalar_is_zero_fill {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val registered: err[fail.Fail] = lang_target.register_all(s.registry, target_testing.debug_descriptor);
    if (sel registered.err) { ret 2; }
    val triples: [3][3]str = [3][3]str{[3]str{"x86_64", "linux", "sysv64"}, [3]str{"aarch64", "darwin", "aapcs64"}, [3]str{"x86_64", "windows", "win64"}};
    val labels:  [8]str    = [8]str{"zero_int", "zero_f64", "underflow_f32", "neg_zero_f64", "neg_zero_f32", "one_int", "zero_val", "zero_sectioned"};
    val want:    [8]u8     = [8]u8{target_of.SK_BSS::u8, target_of.SK_BSS::u8, target_of.SK_BSS::u8, target_of.SK_DATA::u8, target_of.SK_DATA::u8, target_of.SK_DATA::u8, target_of.SK_RODATA::u8, target_of.SK_DATA::u8};
    var names:   [8]intern.StrId;
    var n:       u32       = 0;
    for (n < 8) {
        val named: res[intern.StrId, A.Error] = intern.intern(?s.interner, labels[n]);
        if (sel named.err) { ret 2; }
        names[n] = named.ok;
        n        = n + 1;
    }
    val custom_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, ".data.custom");
    if (sel custom_r.err) { ret 2; }

    var t: u32 = 0;
    for (t < 3) {
        val selected: res[lang_target.Target, fail.Fail] = lang_target.select(s.registry, triples[t][0], triples[t][1], triples[t][2]);
        if (sel selected.err) { ret 3; }
        var tgt:         lang_target.Target           = selected.ok;
        val initialized: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, names[0]);
        if (sel initialized.err) { ret 4; }
        var module: me_ir.Module = initialized.ok;
        module.root_project = true;
        val i64_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?module.types, 64);
        val f64_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_float(?module.types, 64);
        val f32_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_float(?module.types, 32);
        var i64_t: ir_type.IrTypeId                 = 0;
        var f64_t: ir_type.IrTypeId                 = 0;
        var f32_t: ir_type.IrTypeId                 = 0;
        if (sel i64_r.ok) { i64_t = i64_r.ok; }
        if (sel f64_r.ok) { f64_t = f64_r.ok; }
        if (sel f32_r.ok) { f32_t = f32_r.ok; }
        if (sel i64_r.err || sel f64_r.err || sel f32_r.err) {
            me_ir.dnit(?module);
            ret 4;
        }
        var neg_f64: value.Value = value.const_int(0x8000000000000000, f64_t);
        neg_f64.kind = value.VAL_CONST_FLOAT;
        var neg_f32: value.Value = value.const_int(0x8000000000000000, f32_t);
        neg_f32.kind = value.VAL_CONST_FLOAT;
        # the smallest f64 denormal is +0.0 as an f32, so it is zero fill, not an unsupported initializer
        var tiny_f32: value.Value = value.const_int(1, f32_t);
        tiny_f32.kind = value.VAL_CONST_FLOAT;
        var inits: [8]value.Value = [8]value.Value{value.const_int(0, i64_t), value.const_float(0.0, f64_t),
            tiny_f32, neg_f64, neg_f32, value.const_int(1, i64_t), value.const_int(0, i64_t),
            value.const_int(0, i64_t)};
        var g: u32 = 0;
        for (g < 8) {
            var section: intern.StrId = intern.STR_NIL;
            if (g == 7) { section = custom_r.ok; }
            module.globals[g] = me_ir.Global{name: names[g], ty: inits[g].ty, init: inits[g],
                is_mut:   g != 6, is_pub: false, is_extern: false, is_import: false, is_local: false,
                is_embed: false, align: 8, section: section, iface: 0, iface_a: 0, iface_b: 0, iface_flags: 0,
                disp:     intern.STR_NIL, ty_sem: type.TYPE_NIL};
            g = g + 1;
        }
        module.global_len = 8;

        val emitted: res[target_of.ObjectImage, fail.Fail] = codegen_unit(?s, ?tgt, ?module,
            be_codegen_unit.ir_set_empty(), nil, PLACEMENT_POLICY_VERSION, no_debug(), ?s.diags);
        me_ir.dnit(?module);
        if (sel emitted.err) { ret 5; }
        var image: target_of.ObjectImage = emitted.ok;
        g = 0;
        for (g < 8) {
            if (t_global_kind(?image, names[g]) != want[g]) {
                obj.dnit(?image);
                ret (10 + t * 10 + g)::i32;
            }
            g = g + 1;
        }
        obj.dnit(?image);
        t = t + 1;
    }
    ret 0;
}

# the initializer bytes the image holds for the symbol `name`, nil when it has none
#[testing]
fun t_global_bytes(image: *target_of.ObjectImage, name: intern.StrId, out_len: *u32) *u8 {
    var i: u32 = 0;
    for (i < image.symbol_count) {
        if (image.symbols[i].name == name) {
            val sec: *target_of.Section = ?image.sections[target_of.section_index(image.symbols[i].section)];
            if (sec.bytes == nil) { ret nil; }
            @out_len = image.symbols[i].size;
            ret ?sec.bytes[image.symbols[i].offset];
        }
        i = i + 1;
    }
    ret nil;
}

# a 128-bit scalar global packs both limbs little-endian, and one whose only
# non-zero bits are in the high limb is not zero fill (#3511)
test pack_globals__a_wide_scalar_packs_both_limbs {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val registered: err[fail.Fail] = lang_target.register_all(s.registry, target_testing.debug_descriptor);
    if (sel registered.err) { ret 2; }
    val labels: [2]str = [2]str{"wide_full", "wide_high_only"};
    var names:  [2]intern.StrId;
    var n:      u32    = 0;
    for (n < 2) {
        val named: res[intern.StrId, A.Error] = intern.intern(?s.interner, labels[n]);
        if (sel named.err) { ret 2; }
        names[n] = named.ok;
        n        = n + 1;
    }
    val selected: res[lang_target.Target, fail.Fail] = lang_target.select(s.registry, "x86_64", "linux", "sysv64");
    if (sel selected.err) { ret 3; }
    var tgt:         lang_target.Target           = selected.ok;
    val initialized: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, names[0]);
    if (sel initialized.err) { ret 4; }
    var module: me_ir.Module = initialized.ok;
    module.root_project = true;
    val u128_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?module.types, 128);
    if (sel u128_r.err) {
        me_ir.dnit(?module);
        ret 4;
    }
    val hi:    u64            = 0x99AABBCCDDEEFF00;
    var inits: [2]value.Value = [2]value.Value{
        value.const_int_wide(wide.make(0x1122334455667788, hi), u128_r.ok),
        value.const_int_wide(wide.make(0, 1), u128_r.ok)
    };
    var g: u32 = 0;
    for (g < 2) {
        module.globals[g] = me_ir.Global{name: names[g], ty: u128_r.ok, init: inits[g],
            is_mut:   true, is_pub: false, is_extern: false, is_import: false, is_local: false,
            is_embed: false, align: 16, section: intern.STR_NIL, iface: 0, iface_a: 0, iface_b: 0, iface_flags: 0,
            disp:     intern.STR_NIL, ty_sem: type.TYPE_NIL};
        g = g + 1;
    }
    module.global_len = 2;

    val emitted: res[target_of.ObjectImage, fail.Fail] = codegen_unit(?s, ?tgt, ?module,
        be_codegen_unit.ir_set_empty(), nil, PLACEMENT_POLICY_VERSION, no_debug(), ?s.diags);
    me_ir.dnit(?module);
    if (sel emitted.err) { ret 5; }
    var image: target_of.ObjectImage = emitted.ok;
    fin { obj.dnit(?image); }

    var len:   u32 = 0;
    val bytes: *u8 = t_global_bytes(?image, names[0], ?len);
    if (bytes == nil || len != 16)                                { ret 6; }
    if (t_global_kind(?image, names[0]) != target_of.SK_DATA::u8) { ret 7; }
    var i: u32 = 0;
    for (i < 8) {
        if (bytes[i] != (0x1122334455667788 >> (i::u64 * 8))::u8) { ret 8; }
        if (bytes[8 + i] != (hi >> (i::u64 * 8))::u8)             { ret 9; }
        i = i + 1;
    }
    var len2:   u32 = 0;
    val bytes2: *u8 = t_global_bytes(?image, names[1], ?len2);
    if (bytes2 == nil || len2 != 16)                              { ret 10; }
    if (t_global_kind(?image, names[1]) != target_of.SK_DATA::u8) { ret 11; }
    if (bytes2[8] != 1)                                           { ret 12; }
    i = 0;
    for (i < 16) {
        if (i != 8 && bytes2[i] != 0) { ret 13; }
        i = i + 1;
    }
    ret 0;
}

test codegen_with_backing__the_image_survives_reclaimed_scratch {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val r_2451: err[fail.Fail] = lang_target.register_all(s.registry, target_testing.debug_descriptor);
    if (sel r_2451.err) { ret 2; }
    val selected: res[lang_target.Target, fail.Fail] = lang_target.select(s.registry, "x86_64", "linux", "sysv64");
    if (sel selected.err) { ret 2; }
    var tgt:   lang_target.Target         = selected.ok;
    val named: res[intern.StrId, A.Error] = intern.intern(?s.interner, "scratch_probe");
    if (sel named.err) { ret 2; }
    val name:        intern.StrId                 = named.ok;
    val initialized: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, name);
    if (sel initialized.err) { ret 2; }
    var module: me_ir.Module = initialized.ok;
    fin { me_ir.dnit(?module); }
    val typed: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?module.types, 64);
    if (sel typed.err) { ret 2; }
    val ty: ir_type.IrTypeId = typed.ok;
    module.globals[0] = me_ir.Global{name: name, ty: ty, init: value.const_int(0x0807060504030201, ty),
        is_mut:   false, is_pub: true, is_extern: false, is_import: false, is_local: false,
        is_embed: false, align: 8, section: intern.STR_NIL, iface: 0, iface_a: 0, iface_b: 0, iface_flags: 0,
        disp:     intern.STR_NIL, ty_sem: type.TYPE_NIL};
    module.global_len = 1;
    var tracking: T.Testing;
    val make_r2:  err[A.Error] = T.make(?tracking);
    if (sel make_r2.err) { ret 2; }
    val emitted: res[target_of.ObjectImage, fail.Fail] = codegen_with_backing(?s, ?tgt, ?module,
        be_codegen_unit.ir_set_empty(), nil, PLACEMENT_POLICY_VERSION, no_debug(), ?s.diags, ?tracking.a);
    # every scratch allocation is back before the image is used
    val clean: bool = tracking.live == 0 && tracking.double_frees == 0;
    T.dnit(?tracking);
    if (!clean)          { ret 3; }
    if (sel emitted.err) { ret 4; }
    var image: target_of.ObjectImage = emitted.ok;
    fin { obj.dnit(?image); }
    if (image.alloc != ?alloc || image.interner != ?s.interner) { ret 5; }
    var found: bool = false;
    var i:     u32  = 0;
    for (i < image.section_count) {
        val sec: *target_of.Section = ?image.sections[i];
        if (sec.kind == target_of.SK_RODATA && sec.len == 8) {
            found = true;
            var k: u32 = 0;
            for (k < 8) {
                if (sec.bytes[k] != (k + 1)::u8) { ret 6; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    if (!found) { ret 7; }
    ret 0;
}

# an oblivious function at the vreg level, the shape the early walk sees:
# v0 is a declared secret, v1 public, v2 is computed from both (derived, not
# seeded), v3 declassifies v2, v4 is public arithmetic on the result
#[testing]
fun t_oblivious_fixture(alloc: *A.Allocator, name: intern.StrId, oblivious: bool) res[codegen_mir.MirFunction, fail.Fail] {
    var f: codegen_mir.MirFunction;
    f.name      = name;
    f.oblivious = oblivious;
    val rv: res[*codegen_mir.MirVReg, A.Error] = A.allocate[codegen_mir.MirVReg](alloc, 5::usize);
    if (sel rv.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(rv.err)}; }
    f.vregs      = rv.ok;
    f.vreg_count = 5;
    f.vreg_cap   = 5;
    var v: u32 = 0;
    for (v < 5) {
        f.vregs[v] = codegen_mir.vreg(v, codegen_mir.REG_CLASS_GP, 0, v == 0);
        v          = v + 1;
    }

    val rb: res[*codegen_mir.MirBlock, A.Error] = A.zallocate[codegen_mir.MirBlock](alloc, 1::usize);
    if (sel rb.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(rb.err)}; }
    f.blocks      = rb.ok;
    f.block_count = 1;
    f.block_cap   = 1;
    val ri: res[*codegen_mir.MirInstr, A.Error] = A.zallocate[codegen_mir.MirInstr](alloc, 6::usize);
    if (sel ri.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(ri.err)}; }
    val instrs: *codegen_mir.MirInstr = ri.ok;

    var k: u32 = 0;
    for (k < 6) {
        var n: u32 = 3;
        if (k == 0 || k == 1 || k == 3) { n = 2; }
        if (k == 5)                     { n = 0; }
        var ops: *codegen_mir.MirOperand = nil;
        if (n > 0) {
            val ro: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](alloc, n::usize);
            if (sel ro.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(ro.err)}; }
            ops = ro.ok;
        }
        if (k == 0) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
            ops[1]    = codegen_mir.op_imm(5);
            instrs[k] = codegen_mir.instr(codegen_mir.MIR_MOV, ops, 2, 8, 8);
        }
        if (k == 1) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
            ops[1]    = codegen_mir.op_imm(7);
            instrs[k] = codegen_mir.instr(codegen_mir.MIR_MOV, ops, 2, 8, 8);
        }
        if (k == 2) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
            ops[1]    = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
            ops[2]    = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
            instrs[k] = codegen_mir.instr(codegen_mir.MIR_XOR, ops, 3, 8, 8);
        }
        if (k == 3) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(3));
            ops[1]    = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
            instrs[k] = codegen_mir.instr(codegen_mir.MIR_DECLASSIFY, ops, 2, 8, 8);
        }
        if (k == 4) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(4));
            ops[1]    = codegen_mir.op_vreg(codegen_mir.vreg_id(3));
            ops[2]    = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
            instrs[k] = codegen_mir.instr(codegen_mir.MIR_ADD, ops, 3, 8, 8);
        }
        if (k == 5) { instrs[k] = codegen_mir.instr(codegen_mir.MIR_RET, nil, 0, 0, 0); }
        instrs[k].loc = lang_source.loc_nil();
        k             = k + 1;
    }
    f.blocks[0].id          = 0;
    f.blocks[0].instrs      = instrs;
    f.blocks[0].instr_count = 6;
    f.blocks[0].instr_cap   = 6;
    ret res[codegen_mir.MirFunction, fail.Fail].ok{f};
}

# the pipeline from the early walk to allocation, as codegen_scratch runs it
#[testing]
fun t_allocate_fixture(tgt: *lang_target.Target, m: *codegen_mir.MirModule) err[fail.Fail] {
    val rc: err[fail.Fail] = ctvalidate.validate(tgt, m);
    if (sel rc.err) { ret rc; }
    val rl: err[fail.Fail] = legalize.run(tgt, m);
    if (sel rl.err) { ret rl; }
    val ri: err[fail.Fail] = isel.run(tgt, m);
    if (sel ri.err) { ret ri; }
    val ra: err[fail.Fail] = regalloc.run(tgt, m);
    if (sel ra.err) { ret ra; }
    ret frame.run(tgt, m);
}

#[testing]
var t_asm_capture:     [16384]u8;
#[testing]
var t_asm_capture_len: usize = 0;

#[testing]
fun t_asm_capture_write(ctx: ptr, buf: *u8, len: usize) res[usize, io_writer.WriteError] {
    var i: usize = 0;
    for (i < len) {
        if (t_asm_capture_len < 16383) {
            t_asm_capture[t_asm_capture_len] = buf[i];
            t_asm_capture_len                = t_asm_capture_len + 1;
        }
        i = i + 1;
    }
    ret res[usize, io_writer.WriteError].ok{len};
}

# instruction lines in the rendering: indented by two spaces, not a directive
#[testing]
fun t_asm_capture_instruction_lines() u32 {
    var n:             u32   = 0;
    var i:             usize = 0;
    var at_line_start: bool  = true;
    for (i < t_asm_capture_len) {
        if (at_line_start && i + 1 < t_asm_capture_len
            && t_asm_capture[i] == ' '::u8 && t_asm_capture[i + 1] == ' '::u8) {
            n = n + 1;
        }
        at_line_start = t_asm_capture[i] == '\n'::u8;
        i             = i + 1;
    }
    ret n;
}

#[testing]
fun t_bytes_equal(a: *u8, an: u32, b: *u8, bn: u32) bool {
    if (an != bn) { ret false; }
    var i: u32 = 0;
    for (i < an) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun t_encoder_output_release(alloc: *A.Allocator, enc: *codegen_encode.EncoderOutput) {
    var ctx: CodegenContext;
    ctx.alloc = alloc;
    encoder_output_dnit(?ctx, enc);
}

# the stream exists on a plain build of a module with an oblivious function,
# notifies exactly the instructions the --emit-asm rendering prints, and
# leaves the emitted bytes identical to a build without the stream
#[testing]
fun t_stream_matches_rendering(arch: str, os_name: str, abi: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var interner: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?interner); }
    var reg: lang_target.TargetRegistry = lang_target.registry_init();
    fin { lang_target.registry_dnit(?reg); }
    val r_2641: err[fail.Fail] = lang_target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2641.err) { ret 2; }
    val ts: res[lang_target.Target, fail.Fail] = lang_target.select(?reg, arch, os_name, abi);
    if (sel ts.err) { ret 3; }
    var tgt: lang_target.Target         = ts.ok;
    val nr:  res[intern.StrId, A.Error] = intern.intern(?interner, "seeded");
    if (sel nr.err) { ret 4; }
    val name: intern.StrId = nr.ok;

    # the oblivious module: plain build, then the rendering
    var m: codegen_mir.MirModule = codegen_mir.MirModule{alloc: ?alloc, interner: ?interner};
    fin { codegen_mir.dnit_module(?m); }
    val rf: res[codegen_mir.MirFunction, fail.Fail] = t_oblivious_fixture(?alloc, name, true);
    if (sel rf.err) { ret 5; }
    val push_function_r: err[fail.Fail] = codegen_mir.push_function(?m, rf.ok);
    if (sel push_function_r.err) { ret 5; }
    val t_allocate_fixture_r: err[fail.Fail] = t_allocate_fixture(?tgt, ?m);
    if (sel t_allocate_fixture_r.err) { ret 6; }

    val plain_r: res[codegen_encode.EncoderOutput, fail.Fail] = codegen_encode.run(?tgt, ?m, nil);
    if (sel plain_r.err) { ret 7; }
    var plain: codegen_encode.EncoderOutput = plain_r.ok;
    fin { t_encoder_output_release(?alloc, ?plain); }
    if (plain.notified == 0) { ret 8; }

    var w: io_writer.Writer;
    w.ctx             = nil;
    w.f_write         = t_asm_capture_write;
    t_asm_capture_len = 0;
    val asm_r: res[codegen_encode.EncoderOutput, fail.Fail] = codegen_encode.run(?tgt, ?m, ?w);
    if (sel asm_r.err) { ret 9; }
    var rendered: codegen_encode.EncoderOutput = asm_r.ok;
    fin { t_encoder_output_release(?alloc, ?rendered); }
    if (rendered.notified != plain.notified)                                          { ret 10; }
    if (t_asm_capture_instruction_lines() != plain.notified)                          { ret 11; }
    if (!t_bytes_equal(plain.text, plain.text_len, rendered.text, rendered.text_len)) { ret 12; }

    # the same function without the contract: no stream, the same bytes
    var open: codegen_mir.MirModule = codegen_mir.MirModule{alloc: ?alloc, interner: ?interner};
    fin { codegen_mir.dnit_module(?open); }
    val rg: res[codegen_mir.MirFunction, fail.Fail] = t_oblivious_fixture(?alloc, name, false);
    if (sel rg.err) { ret 13; }
    val push_function_r2: err[fail.Fail] = codegen_mir.push_function(?open, rg.ok);
    if (sel push_function_r2.err) { ret 13; }
    val t_allocate_fixture_r2: err[fail.Fail] = t_allocate_fixture(?tgt, ?open);
    if (sel t_allocate_fixture_r2.err) { ret 14; }
    val open_r: res[codegen_encode.EncoderOutput, fail.Fail] = codegen_encode.run(?tgt, ?open, nil);
    if (sel open_r.err) { ret 15; }
    var silent: codegen_encode.EncoderOutput = open_r.ok;
    fin { t_encoder_output_release(?alloc, ?silent); }
    if (silent.notified != 0)                                                     { ret 16; }
    if (!t_bytes_equal(plain.text, plain.text_len, silent.text, silent.text_len)) { ret 17; }
    ret 0;
}

# a parameter bound at its definition and read once, then two temporaries in a
# chain, one of which takes the register the parameter left: the debug line of
# each instruction is ten times its index, so the emitted rows give every
# instruction's text offset back
#[testing]
fun t_clobber_fixture(alloc: *A.Allocator, name: intern.StrId) res[codegen_mir.MirFunction, fail.Fail] {
    var f: codegen_mir.MirFunction;
    f.name = name;
    val rv: res[*codegen_mir.MirVReg, A.Error] = A.allocate[codegen_mir.MirVReg](alloc, 3::usize);
    if (sel rv.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(rv.err)}; }
    f.vregs      = rv.ok;
    f.vreg_count = 3;
    f.vreg_cap   = 3;
    var v: u32 = 0;
    for (v < 3) {
        f.vregs[v] = codegen_mir.vreg(v, codegen_mir.REG_CLASS_GP, 0, false);
        v          = v + 1;
    }
    val rb: res[*codegen_mir.MirBlock, A.Error] = A.zallocate[codegen_mir.MirBlock](alloc, 1::usize);
    if (sel rb.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(rb.err)}; }
    f.blocks      = rb.ok;
    f.block_count = 1;
    f.block_cap   = 1;
    val ri: res[*codegen_mir.MirInstr, A.Error] = A.zallocate[codegen_mir.MirInstr](alloc, 4::usize);
    if (sel ri.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(ri.err)}; }
    val instrs: *codegen_mir.MirInstr = ri.ok;
    var k:      u32                   = 0;
    for (k < 4) {
        var n: u32 = 3;
        if (k == 0) { n = 2; }
        if (k == 3) { n = 0; }
        var ops: *codegen_mir.MirOperand = nil;
        if (n > 0) {
            val ro: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](alloc, n::usize);
            if (sel ro.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(ro.err)}; }
            ops = ro.ok;
        }
        if (k == 0) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
            ops[1]    = codegen_mir.op_imm(5);
            instrs[k] = codegen_mir.instr(codegen_mir.MIR_MOV, ops, 2, 8, 8);
            val bound: err[fail.Fail] = codegen_mir.instr_attach_dbg(alloc, ?instrs[k], 100, 0);
            if (sel bound.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{bound.err}; }
        }
        if (k == 1) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
            ops[1]    = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
            ops[2]    = codegen_mir.op_imm(1);
            instrs[k] = codegen_mir.instr(codegen_mir.MIR_ADD, ops, 3, 8, 8);
        }
        if (k == 2) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
            ops[1]    = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
            ops[2]    = codegen_mir.op_imm(1);
            instrs[k] = codegen_mir.instr(codegen_mir.MIR_ADD, ops, 3, 8, 8);
        }
        if (k == 3) { instrs[k] = codegen_mir.instr(codegen_mir.MIR_RET, nil, 0, 0, 0); }
        instrs[k].loc = lang_source.loc(1, (10 * k)::usize);
        k             = k + 1;
    }
    f.blocks[0].id          = 0;
    f.blocks[0].instrs      = instrs;
    f.blocks[0].instr_count = 4;
    f.blocks[0].instr_cap   = 4;
    ret res[codegen_mir.MirFunction, fail.Fail].ok{f};
}

# the text offset of the row whose debug line is `line`, or none
#[testing]
fun t_row_offset(out: *codegen_encode.EncoderOutput, line: usize) opt[u32] {
    var i: u32 = 0;
    for (i < out.row_count) {
        if (out.rows[i].loc.offset == line) { ret opt[u32].some{out.rows[i].text_offset}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# a register location ends where a later instruction defines the register,
# temporaries included: the emitted MIR carries a homeless record for the
# variable at the start of the instruction after the clobber
#[testing]
fun t_clobber_ends_location(arch: str, os_name: str, abi: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var interner: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?interner); }
    var reg: lang_target.TargetRegistry = lang_target.registry_init();
    fin { lang_target.registry_dnit(?reg); }
    val registered: err[fail.Fail] = lang_target.register_all(?reg, target_testing.debug_descriptor);
    if (sel registered.err) { ret 2; }
    val ts: res[lang_target.Target, fail.Fail] = lang_target.select(?reg, arch, os_name, abi);
    if (sel ts.err) { ret 3; }
    var tgt: lang_target.Target         = ts.ok;
    val nr:  res[intern.StrId, A.Error] = intern.intern(?interner, "clobbered");
    if (sel nr.err) { ret 4; }

    var m: codegen_mir.MirModule = codegen_mir.MirModule{alloc: ?alloc, interner: ?interner};
    fin { codegen_mir.dnit_module(?m); }
    val rf: res[codegen_mir.MirFunction, fail.Fail] = t_clobber_fixture(?alloc, nr.ok);
    if (sel rf.err) { ret 5; }
    val pushed: err[fail.Fail] = codegen_mir.push_function(?m, rf.ok);
    if (sel pushed.err) { ret 5; }
    val allocated: err[fail.Fail] = t_allocate_fixture(?tgt, ?m);
    if (sel allocated.err) { ret 6; }
    val run_r: res[codegen_encode.EncoderOutput, fail.Fail] = codegen_encode.run(?tgt, ?m, nil);
    if (sel run_r.err) { ret 7; }
    var out: codegen_encode.EncoderOutput = run_r.ok;
    fin { t_encoder_output_release(?alloc, ?out); }

    # the fixture holds only when a temporary took the parameter's register; the
    # temporary is defined by the instruction of its own index, so the location
    # is lost at the start of the instruction after that one
    val f: *codegen_mir.MirFunction = ?m.functions[0];
    if (codegen_mir.preg_is_nil(f.vregs[0].assigned)) { ret 8; }
    val param_reg: i32 = codegen_mir.preg_regid(f.vregs[0].assigned);
    var clobberer: u32 = 0;
    var t:         u32 = 1;
    for (t < 3) {
        if (!codegen_mir.preg_is_nil(f.vregs[t].assigned) && codegen_mir.preg_regid(f.vregs[t].assigned) == param_reg && clobberer == 0) { clobberer = t; }
        t = t + 1;
    }
    if (clobberer == 0) { ret 9; }

    val after_clobber: opt[u32] = t_row_offset(?out, (10 * (clobberer + 1))::usize);
    if (sel after_clobber.none) { ret 10; }

    var published: i32 = -1;
    var lost:      i32 = -1;
    var i:         u32 = 0;
    for (i < out.varloc_count) {
        val vl: *codegen_encode.VarLoc = ?out.varlocs[i];
        if (vl.iid != 100) {
            i = i + 1;
            cnt;
        }
        if (vl.kind == codegen_encode.VARLOC_REG && vl.reg == param_reg && published < 0) { published = i::i32; }
        or (vl.kind == codegen_encode.VARLOC_NONE && published >= 0 && lost < 0)          { lost = i::i32; }
        i = i + 1;
    }
    if (published < 0)                                                                 { ret 11; }
    if (lost < 0)                                                                      { ret 12; }
    if (out.varlocs[lost::u32].text_offset != after_clobber.some)                      { ret 13; }
    if (out.varlocs[lost::u32].text_offset <= out.varlocs[published::u32].text_offset) { ret 14; }
    ret 0;
}

# a parameter bound at its definition and read once before a call, with a value
# that lives across the call so the parameter is not what the allocator keeps
# in a callee-saved register; the debug line of each instruction is ten times
# its index
#[testing]
fun t_call_clobber_fixture(alloc: *A.Allocator, name: intern.StrId, callee: intern.StrId) res[codegen_mir.MirFunction, fail.Fail] {
    var f: codegen_mir.MirFunction;
    f.name = name;
    val rv: res[*codegen_mir.MirVReg, A.Error] = A.allocate[codegen_mir.MirVReg](alloc, 3::usize);
    if (sel rv.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(rv.err)}; }
    f.vregs      = rv.ok;
    f.vreg_count = 3;
    f.vreg_cap   = 3;
    var v: u32 = 0;
    for (v < 3) {
        f.vregs[v] = codegen_mir.vreg(v, codegen_mir.REG_CLASS_GP, 0, false);
        v          = v + 1;
    }
    val rb: res[*codegen_mir.MirBlock, A.Error] = A.zallocate[codegen_mir.MirBlock](alloc, 1::usize);
    if (sel rb.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(rb.err)}; }
    f.blocks      = rb.ok;
    f.block_count = 1;
    f.block_cap   = 1;
    val ri: res[*codegen_mir.MirInstr, A.Error] = A.zallocate[codegen_mir.MirInstr](alloc, 5::usize);
    if (sel ri.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(ri.err)}; }
    val instrs: *codegen_mir.MirInstr = ri.ok;
    var k:      u32                   = 0;
    for (k < 5) {
        var n: u32 = 3;
        if (k == 0) { n = 2; }
        if (k == 2) { n = 1; }
        if (k == 4) { n = 0; }
        var ops: *codegen_mir.MirOperand = nil;
        if (n > 0) {
            val ro: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](alloc, n::usize);
            if (sel ro.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(ro.err)}; }
            ops = ro.ok;
        }
        if (k == 0) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
            ops[1]    = codegen_mir.op_imm(5);
            instrs[k] = codegen_mir.instr(codegen_mir.MIR_MOV, ops, 2, 8, 8);
            val bound: err[fail.Fail] = codegen_mir.instr_attach_dbg(alloc, ?instrs[k], 100, 0);
            if (sel bound.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{bound.err}; }
        }
        if (k == 1) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
            ops[1]    = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
            ops[2]    = codegen_mir.op_imm(1);
            instrs[k] = codegen_mir.instr(codegen_mir.MIR_ADD, ops, 3, 8, 8);
            val kept: err[fail.Fail] = codegen_mir.instr_attach_dbg(alloc, ?instrs[k], 101, 1);
            if (sel kept.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{kept.err}; }
        }
        if (k == 2) {
            ops[0]    = codegen_mir.op_sym(callee, 0);
            instrs[k] = codegen_mir.instr(codegen_mir.MIR_CALL, ops, 1, 8, 8);
        }
        if (k == 3) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
            ops[1]    = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
            ops[2]    = codegen_mir.op_imm(1);
            instrs[k] = codegen_mir.instr(codegen_mir.MIR_ADD, ops, 3, 8, 8);
        }
        if (k == 4) { instrs[k] = codegen_mir.instr(codegen_mir.MIR_RET, nil, 0, 0, 0); }
        instrs[k].loc = lang_source.loc(1, (10 * k)::usize);
        k             = k + 1;
    }
    f.blocks[0].id          = 0;
    f.blocks[0].instrs      = instrs;
    f.blocks[0].instr_count = 5;
    f.blocks[0].instr_cap   = 5;
    ret res[codegen_mir.MirFunction, fail.Fail].ok{f};
}

#[testing]
fun t_reg_is_callee_saved(tgt: *lang_target.Target, reg: i32) bool {
    var regs: [32]isa.Register;
    val n:    i32 = tgt.abi.callee_saved(?regs[0]);
    var i:    i32 = 0;
    for (i < n && i < 32) {
        if (regs[i].id == reg) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a call defines the ABI's caller-saved registers: a dead parameter left in
# one has its location ended at the start of the instruction after the call
#[testing]
fun t_call_ends_location(arch: str, os_name: str, abi: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var interner: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?interner); }
    var reg: lang_target.TargetRegistry = lang_target.registry_init();
    fin { lang_target.registry_dnit(?reg); }
    val registered: err[fail.Fail] = lang_target.register_all(?reg, target_testing.debug_descriptor);
    if (sel registered.err) { ret 2; }
    val ts: res[lang_target.Target, fail.Fail] = lang_target.select(?reg, arch, os_name, abi);
    if (sel ts.err) { ret 3; }
    var tgt: lang_target.Target         = ts.ok;
    val nr:  res[intern.StrId, A.Error] = intern.intern(?interner, "caller");
    if (sel nr.err) { ret 4; }
    val cr: res[intern.StrId, A.Error] = intern.intern(?interner, "callee");
    if (sel cr.err) { ret 4; }

    var m: codegen_mir.MirModule = codegen_mir.MirModule{alloc: ?alloc, interner: ?interner};
    fin { codegen_mir.dnit_module(?m); }
    val rf: res[codegen_mir.MirFunction, fail.Fail] = t_call_clobber_fixture(?alloc, nr.ok, cr.ok);
    if (sel rf.err) { ret 5; }
    val pushed: err[fail.Fail] = codegen_mir.push_function(?m, rf.ok);
    if (sel pushed.err) { ret 5; }
    val allocated: err[fail.Fail] = t_allocate_fixture(?tgt, ?m);
    if (sel allocated.err) { ret 6; }
    val run_r: res[codegen_encode.EncoderOutput, fail.Fail] = codegen_encode.run(?tgt, ?m, nil);
    if (sel run_r.err) { ret 7; }
    var out: codegen_encode.EncoderOutput = run_r.ok;
    fin { t_encoder_output_release(?alloc, ?out); }

    # the fixture holds only when the parameter sits in a caller-saved register
    # that no instruction before the call redefines
    val f: *codegen_mir.MirFunction = ?m.functions[0];
    if (codegen_mir.preg_is_nil(f.vregs[0].assigned) || codegen_mir.preg_is_nil(f.vregs[1].assigned)) { ret 8; }
    val param_reg: i32 = codegen_mir.preg_regid(f.vregs[0].assigned);
    val kept_reg:  i32 = codegen_mir.preg_regid(f.vregs[1].assigned);
    if (t_reg_is_callee_saved(?tgt, param_reg)) { ret 9; }
    if (!t_reg_is_callee_saved(?tgt, kept_reg)) { ret 9; }

    val after_call: opt[u32] = t_row_offset(?out, 30);
    if (sel after_call.none) { ret 10; }

    # the value the allocator carried across the call in a callee-saved register
    # keeps its location through the call
    var j: u32 = 0;
    for (j < out.varloc_count) {
        val kv: *codegen_encode.VarLoc = ?out.varlocs[j];
        if (kv.iid == 101 && kv.kind == codegen_encode.VARLOC_NONE && kv.text_offset == after_call.some) { ret 15; }
        j = j + 1;
    }

    var published: i32 = -1;
    var lost:      i32 = -1;
    var i:         u32 = 0;
    for (i < out.varloc_count) {
        val vl: *codegen_encode.VarLoc = ?out.varlocs[i];
        if (vl.iid != 100) {
            i = i + 1;
            cnt;
        }
        if (vl.kind == codegen_encode.VARLOC_REG && vl.reg == param_reg && published < 0) { published = i::i32; }
        or (vl.kind == codegen_encode.VARLOC_NONE && published >= 0 && lost < 0)          { lost = i::i32; }
        i = i + 1;
    }
    if (published < 0)                                         { ret 11; }
    if (lost < 0)                                              { ret 12; }
    if (out.varlocs[lost::u32].text_offset != after_call.some) { ret 13; }
    ret 0;
}

# runs a per-target check on each linux isa, offsetting the failing code by isa
#[testing]
fun t_on_linux_arches(check: fun(str, str, str) i32) i32 {
    var r: i32 = check("x86_64", "linux", "sysv64");
    if (r != 0) { ret r; }
    r = check("aarch64", "linux", "aapcs64");
    if (r != 0) { ret 40 + r; }
    r = check("riscv64", "linux", "lp64d");
    if (r != 0) { ret 80 + r; }
    ret 0;
}

test varloc__a_call_ends_a_caller_saved_register_location {
    ret t_on_linux_arches(t_call_ends_location);
}

# a counted loop whose variable is redefined in place: `i = 0` bound at the
# entry branch, `i` bound again at the loop test, and the body adds one into the
# same register and binds `i` to it at the add's end, where lowering publishes
# the binding of the def it just lowered. a second counter's update sits
# between the add and the back branch, the shape of a copy or spill store
# regalloc places there. the debug line of an instruction is ten times its
# position, four positions to a block
#[testing]
fun t_loop_rebind_fixture(alloc: *A.Allocator, name: intern.StrId) res[codegen_mir.MirFunction, fail.Fail] {
    var f: codegen_mir.MirFunction;
    f.name = name;
    val rv: res[*codegen_mir.MirVReg, A.Error] = A.allocate[codegen_mir.MirVReg](alloc, 3::usize);
    if (sel rv.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(rv.err)}; }
    f.vregs      = rv.ok;
    f.vreg_count = 3;
    f.vreg_cap   = 3;
    f.vregs[0]   = codegen_mir.vreg(0, codegen_mir.REG_CLASS_GP, 0, false);
    f.vregs[1]   = codegen_mir.vreg(1, codegen_mir.REG_CLASS_GP, 0, false);
    f.vregs[2]   = codegen_mir.vreg(2, codegen_mir.REG_CLASS_GP, 0, false);
    val rb: res[*codegen_mir.MirBlock, A.Error] = A.zallocate[codegen_mir.MirBlock](alloc, 4::usize);
    if (sel rb.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(rb.err)}; }
    f.blocks      = rb.ok;
    f.block_count = 4;
    f.block_cap   = 4;

    # per block, its instruction count and opcodes in order
    var sizes: [4]u32 = [4]u32{3, 2, 3, 1};
    var shape: [4][3]codegen_mir.MirOpcode;
    shape[0][0] = codegen_mir.MIR_MOV;
    shape[0][1] = codegen_mir.MIR_MOV;
    shape[0][2] = codegen_mir.MIR_BR;
    shape[1][0] = codegen_mir.MIR_CMP_LT_S;
    shape[1][1] = codegen_mir.MIR_CBR;
    shape[2][0] = codegen_mir.MIR_ADD;
    shape[2][1] = codegen_mir.MIR_ADD;
    shape[2][2] = codegen_mir.MIR_BR;
    shape[3][0] = codegen_mir.MIR_RET;

    var b: u32 = 0;
    for (b < 4) {
        val n:  u32                                 = sizes[b];
        val ri: res[*codegen_mir.MirInstr, A.Error] = A.zallocate[codegen_mir.MirInstr](alloc, n::usize);
        if (sel ri.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(ri.err)}; }
        val instrs: *codegen_mir.MirInstr = ri.ok;
        var k:      u32                   = 0;
        for (k < n) {
            val op:    codegen_mir.MirOpcode = shape[b][k];
            var count: u32                   = 3;
            if (op == codegen_mir.MIR_MOV) { count = 2; }
            if (op == codegen_mir.MIR_BR)  { count = 1; }
            if (op == codegen_mir.MIR_RET) { count = 0; }
            var ops: *codegen_mir.MirOperand = nil;
            if (count > 0) {
                val ro: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](alloc, count::usize);
                if (sel ro.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(ro.err)}; }
                ops = ro.ok;
            }
            # the counter i is v0, the loop test v1 and the second counter v2
            var dv: u32 = 0;
            if (k == 1) { dv = 2; }
            if (op == codegen_mir.MIR_MOV) {
                ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(dv));
                ops[1]    = codegen_mir.op_imm(0);
                instrs[k] = codegen_mir.instr(op, ops, 2, 8, 8);
            }
            if (op == codegen_mir.MIR_BR) {
                ops[0]    = codegen_mir.op_block(1);
                instrs[k] = codegen_mir.instr(op, ops, 1, 0, 0);
            }
            if (op == codegen_mir.MIR_CMP_LT_S) {
                ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
                ops[1]    = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
                ops[2]    = codegen_mir.op_imm(10);
                instrs[k] = codegen_mir.instr(op, ops, 3, 8, 8);
            }
            if (op == codegen_mir.MIR_CBR) {
                ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
                ops[1]    = codegen_mir.op_block(2);
                ops[2]    = codegen_mir.op_block(3);
                instrs[k] = codegen_mir.instr(op, ops, 3, 0, 0);
            }
            if (op == codegen_mir.MIR_ADD) {
                ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(dv));
                ops[1]    = codegen_mir.op_vreg(codegen_mir.vreg_id(dv));
                ops[2]    = codegen_mir.op_imm(1 + 2 * dv::i64);
                instrs[k] = codegen_mir.instr(op, ops, 3, 8, 8);
            }
            if (op == codegen_mir.MIR_RET) { instrs[k] = codegen_mir.instr(op, nil, 0, 0, 0); }
            var bound: err[fail.Fail] = err[fail.Fail].ok{};
            if (op == codegen_mir.MIR_BR && b == 0)   { bound = codegen_mir.instr_attach_dbg(alloc, ?instrs[k], 100, 0); }
            if (op == codegen_mir.MIR_CMP_LT_S)       { bound = codegen_mir.instr_attach_dbg(alloc, ?instrs[k], 100, 0); }
            if (op == codegen_mir.MIR_ADD && dv == 0) { bound = codegen_mir.instr_attach_dbg_end(alloc, ?instrs[k], 101, 0); }
            if (sel bound.err)                        { ret res[codegen_mir.MirFunction, fail.Fail].err{bound.err}; }
            instrs[k].loc = lang_source.loc(1, (10 * (4 * b + k + 1))::usize);
            k             = k + 1;
        }
        f.blocks[b].id          = b;
        f.blocks[b].instrs      = instrs;
        f.blocks[b].instr_count = n;
        f.blocks[b].instr_cap   = n;
        b                       = b + 1;
    }
    ret res[codegen_mir.MirFunction, fail.Fail].ok{f};
}

# the loop variable is described at every instruction of the loop: its
# register location opens at the rotated guard, before the body, and where the
# in-place increment ends the earlier binding the rebinding opens at the same
# offset, the add's end, so no instruction sees the variable homeless, the one
# between the add and the back branch included
#[testing]
fun t_loop_rebind_keeps_location(arch: str, os_name: str, abi: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var interner: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?interner); }
    var reg: lang_target.TargetRegistry = lang_target.registry_init();
    fin { lang_target.registry_dnit(?reg); }
    val registered: err[fail.Fail] = lang_target.register_all(?reg, target_testing.debug_descriptor);
    if (sel registered.err) { ret 2; }
    val ts: res[lang_target.Target, fail.Fail] = lang_target.select(?reg, arch, os_name, abi);
    if (sel ts.err) { ret 3; }
    var tgt: lang_target.Target         = ts.ok;
    val nr:  res[intern.StrId, A.Error] = intern.intern(?interner, "counted");
    if (sel nr.err) { ret 4; }

    var m: codegen_mir.MirModule = codegen_mir.MirModule{alloc: ?alloc, interner: ?interner};
    fin { codegen_mir.dnit_module(?m); }
    val rf: res[codegen_mir.MirFunction, fail.Fail] = t_loop_rebind_fixture(?alloc, nr.ok);
    if (sel rf.err) { ret 5; }
    val pushed: err[fail.Fail] = codegen_mir.push_function(?m, rf.ok);
    if (sel pushed.err) { ret 5; }
    val entry_count: u32            = m.functions[0].blocks[0].instr_count;
    val rotated:     err[fail.Fail] = looprotate.run(?tgt, ?m);
    if (sel rotated.err) { ret 6; }
    # the fixture holds only once the loop is rotated: the guard precedes the body
    if (m.functions[0].blocks[0].instr_count != entry_count + 1) { ret 7; }
    val allocated: err[fail.Fail] = t_allocate_fixture(?tgt, ?m);
    if (sel allocated.err) { ret 8; }
    # the pipeline's layout: the body falls through into the bottom-of-loop test
    val ordered: err[fail.Fail] = lay_out_blocks(?m, ?tgt, PLACEMENT_POLICY_VERSION);
    if (sel ordered.err) { ret 8; }
    val run_r: res[codegen_encode.EncoderOutput, fail.Fail] = codegen_encode.run(?tgt, ?m, nil);
    if (sel run_r.err) { ret 9; }
    var out: codegen_encode.EncoderOutput = run_r.ok;
    fin { t_encoder_output_release(?alloc, ?out); }

    val f: *codegen_mir.MirFunction = ?m.functions[0];
    if (codegen_mir.preg_is_nil(f.vregs[0].assigned)) { ret 10; }
    val counter_reg: i32      = codegen_mir.preg_regid(f.vregs[0].assigned);
    val body:        opt[u32] = t_row_offset(?out, 90);
    if (sel body.none) { ret 11; }
    # where the add ends: the second counter's update, before the back branch
    val after_add: opt[u32] = t_row_offset(?out, 100);
    if (sel after_add.none) { ret 23; }

    var first:   i32 = -1;
    var lost:    u32 = 0;
    var rebound: u32 = 0;
    var i:       u32 = 0;
    for (i < out.varloc_count) {
        val vl: *codegen_encode.VarLoc = ?out.varlocs[i];
        if (vl.iid != 100 && vl.iid != 101) {
            i = i + 1;
            cnt;
        }
        if (first < 0) { first = i::i32; }
        if (vl.iid == 101) {
            rebound = rebound + 1;
            # the rebinding opens where the add ends, before anything placed after it
            if (vl.text_offset != after_add.some) { ret 21; }
        }
        if (vl.kind == codegen_encode.VARLOC_NONE) {
            lost = lost + 1;
            # the record that follows is the rebinding, at the same offset, in the same register
            if (i + 1 >= out.varloc_count) { ret 12; }
            val next: *codegen_encode.VarLoc = ?out.varlocs[i + 1];
            if (next.iid != 100 && next.iid != 101)                                { ret 13; }
            if (next.text_offset != vl.text_offset)                                { ret 14; }
            if (next.kind != codegen_encode.VARLOC_REG || next.reg != counter_reg) { ret 15; }
        }
        i = i + 1;
    }
    if (first < 0)                                                 { ret 16; }
    if (out.varlocs[first::u32].kind != codegen_encode.VARLOC_REG) { ret 17; }
    if (out.varlocs[first::u32].reg != counter_reg)                { ret 18; }
    # the guard's binding opens the location before the body's first instruction
    if (out.varlocs[first::u32].text_offset >= body.some) { ret 19; }
    # the in-place increment did end the earlier binding: the property is exercised
    if (lost == 0)    { ret 20; }
    if (rebound == 0) { ret 22; }
    ret 0;
}

test varloc__an_in_place_redefinition_keeps_a_loop_variable_located {
    ret t_on_linux_arches(t_loop_rebind_keeps_location);
}

test varloc__a_temporary_clobber_ends_a_register_location {
    ret t_on_linux_arches(t_clobber_ends_location);
}

test stream__a_plain_build_notifies_every_rendered_instruction {
    ret t_on_linux_arches(t_stream_matches_rendering);
}

# after allocation every register operand names its origin vreg, and the seed
# read at the instruction a notification names agrees with the early walk's
# fixpoint wherever the walk's answer is a seed; the one derived value (v2,
# computed from a secret) is the walk's, not a seed, and the declassify is
# the barrier
#[testing]
fun t_seeds_match_walk(arch: str, os_name: str, abi: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var interner: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?interner); }
    var reg: lang_target.TargetRegistry = lang_target.registry_init();
    fin { lang_target.registry_dnit(?reg); }
    val r_2720: err[fail.Fail] = lang_target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2720.err) { ret 2; }
    val ts: res[lang_target.Target, fail.Fail] = lang_target.select(?reg, arch, os_name, abi);
    if (sel ts.err) { ret 3; }
    var tgt: lang_target.Target         = ts.ok;
    val nr:  res[intern.StrId, A.Error] = intern.intern(?interner, "seeded");
    if (sel nr.err) { ret 4; }

    var m: codegen_mir.MirModule = codegen_mir.MirModule{alloc: ?alloc, interner: ?interner};
    fin { codegen_mir.dnit_module(?m); }
    val rf: res[codegen_mir.MirFunction, fail.Fail] = t_oblivious_fixture(?alloc, nr.ok, true);
    if (sel rf.err) { ret 5; }
    val push_function_r: err[fail.Fail] = codegen_mir.push_function(?m, rf.ok);
    if (sel push_function_r.err) { ret 5; }
    val f: *codegen_mir.MirFunction = ?m.functions[0];

    val wr: res[*bool, fail.Fail] = ctvalidate.derive_secret_vregs(f, ?alloc);
    if (sel wr.err) { ret 6; }
    val walk: *bool = wr.ok;
    fin { A.deallocate[bool](?alloc, walk, 5::usize); }
    if (!walk[0] || walk[1] || !walk[2] || walk[3] || walk[4]) { ret 7; }

    val t_allocate_fixture_r: err[fail.Fail] = t_allocate_fixture(?tgt, ?m);
    if (sel t_allocate_fixture_r.err) { ret 8; }

    var seen_seed:    u32 = 0;
    var seen_barrier: u32 = 0;
    var seen_derived: u32 = 0;
    var bi:           u32 = 0;
    for (bi < f.block_count) {
        val blk: *codegen_mir.MirBlock = ?f.blocks[bi];
        var ii:  u32                   = 0;
        for (ii < blk.instr_count) {
            val mi:   *codegen_mir.MirInstr  = ?blk.instrs[ii];
            var note: codegen_encode.AsmNote = codegen_encode.note_blank();
            note.mi = mi;
            if (codegen_mir.instr_declassifies(mi)) { note.kind = codegen_encode.ASM_NOTE_BARRIER; }
            var seeds: codegen_encode.NoteSeeds;
            codegen_encode.note_seeds(f, ?note, ?seeds);
            if (seeds.barrier) {
                seen_barrier = seen_barrier + 1;
                # the coalesced declassify is a zero-byte marker naming the downgraded vreg
                if (mi.opcode != isa.ISA_USE::codegen_mir.MirOpcode || mi.operand_count != 0) { ret 18; }
                if (seeds.count != 1 || seeds.origin[0].n != 2 || seeds.secret[0])            { ret 19; }
                if (!walk[seeds.origin[0].n])                                                 { ret 20; }
                ii = ii + 1;
                cnt;
            }
            if (seeds.dst_secret)                { ret 9; }
            if (seeds.count != mi.operand_count) { ret 9; }
            var k: u32 = 0;
            for (k < mi.operand_count) {
                val op: *codegen_mir.MirOperand = ?mi.operands[k];
                if (op.kind == codegen_mir.MIR_OP_VREG) { ret 10; }
                if (op.kind != codegen_mir.MIR_OP_PREG) {
                    k = k + 1;
                    cnt;
                }
                val origin: u32 = seeds.origin[k].n;
                if (origin != codegen_mir.operand_origin(op).n)                     { ret 11; }
                if (origin == codegen_mir.MIR_VREG_NIL.n || origin >= f.vreg_count) { ret 11; }
                val listed: bool = seeds.secret[k];
                if (f.vregs[origin].secret != listed) { ret 12; }
                if (listed)                           { seen_seed = seen_seed + 1; }
                # the walk's derived taint is what the seed set does not carry
                if (walk[origin] && !f.vregs[origin].secret) {
                    if (origin != 2 || listed) { ret 13; }
                    seen_derived = seen_derived + 1;
                }
                if (!walk[origin] && listed) { ret 14; }
                k = k + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    if (seen_seed == 0 || seen_barrier != 1 || seen_derived == 0) { ret 15; }
    ret 0;
}

test seeds__register_provenance_matches_the_vreg_walk {
    ret t_on_linux_arches(t_seeds_match_walk);
}

# the post-expansion walk's mutation controls (#3126 part 5): each builds a
# program the vreg walk accepts at its pipeline position, then introduces
# the secret after allocation, where only the physical walk can see it. the
# public sibling of every control passes; the early walk, the validator
# moved back before expansion, accepts every one of them

#[testing]
val WALK_CASE_MUL:      u32 = 0;
#[testing]
val WALK_CASE_DIV:      u32 = 1;
#[testing]
val WALK_CASE_UI_TO_FP: u32 = 2;
#[testing]
val WALK_CASE_LOAD:     u32 = 3;

# v0 and v1 are public constants; v2 is the operation under test; v3 keeps
# the result live. for WALK_CASE_LOAD v0 is the declared secret the reload
# will alias and v2 a public pointer
#[testing]
fun t_walk_fixture(alloc: *A.Allocator, name: intern.StrId, case_id: u32, v0_secret: bool, div_reg: i32) res[codegen_mir.MirFunction, fail.Fail] {
    var f: codegen_mir.MirFunction;
    f.name      = name;
    f.oblivious = true;
    val rv: res[*codegen_mir.MirVReg, A.Error] = A.allocate[codegen_mir.MirVReg](alloc, 4::usize);
    if (sel rv.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(rv.err)}; }
    f.vregs      = rv.ok;
    f.vreg_count = 4;
    f.vreg_cap   = 4;
    var v: u32 = 0;
    for (v < 4) {
        f.vregs[v] = codegen_mir.vreg(v, codegen_mir.REG_CLASS_GP, 0, false);
        v          = v + 1;
    }
    f.vregs[0].secret = v0_secret;
    if (case_id == WALK_CASE_UI_TO_FP) {
        f.vregs[2] = codegen_mir.vreg(2, isa.REG_CLASS_ID_XMM::u32, 0, false);
        f.vregs[3] = codegen_mir.vreg(3, isa.REG_CLASS_ID_XMM::u32, 0, false);
    }

    val rb: res[*codegen_mir.MirBlock, A.Error] = A.zallocate[codegen_mir.MirBlock](alloc, 1::usize);
    if (sel rb.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(rb.err)}; }
    f.blocks      = rb.ok;
    f.block_count = 1;
    f.block_cap   = 1;
    val ri: res[*codegen_mir.MirInstr, A.Error] = A.zallocate[codegen_mir.MirInstr](alloc, 10::usize);
    if (sel ri.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(ri.err)}; }
    val instrs: *codegen_mir.MirInstr = ri.ok;

    var n: u32 = 0;
    var k: u32 = 0;
    for (k < 5) {
        val ro: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](alloc, 3::usize);
        if (sel ro.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(ro.err)}; }
        val ops: *codegen_mir.MirOperand = ro.ok;
        if (k == 0) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
            ops[1]    = codegen_mir.op_imm(5);
            instrs[n] = codegen_mir.instr(codegen_mir.MIR_MOV, ops, 2, 8, 8);
            n         = n + 1;
        }
        if (k == 1) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
            ops[1]    = codegen_mir.op_imm(7);
            instrs[n] = codegen_mir.instr(codegen_mir.MIR_MOV, ops, 2, 8, 8);
            n         = n + 1;
        }
        if (k == 2 && case_id == WALK_CASE_MUL) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
            ops[1]    = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
            ops[2]    = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
            instrs[n] = codegen_mir.instr(codegen_mir.MIR_MUL, ops, 3, 8, 8);
            n         = n + 1;
        }
        if (k == 2 && case_id == WALK_CASE_DIV && div_reg < 0) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
            ops[1]    = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
            ops[2]    = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
            instrs[n] = codegen_mir.instr(codegen_mir.MIR_DIV_U, ops, 3, 8, 8);
            n         = n + 1;
        }
        if (k == 2 && case_id == WALK_CASE_DIV && div_reg >= 0) {
            # the accumulator shape lower_div emits on a machine with a divide register
            val ra: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](alloc, 2::usize);
            if (sel ra.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(ra.err)}; }
            val aops: *codegen_mir.MirOperand = ra.ok;
            aops[0]   = codegen_mir.op_preg(codegen_mir.preg_id(div_reg));
            aops[1]   = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
            instrs[n] = codegen_mir.instr(codegen_mir.MIR_MOV, aops, 2, 8, 8);
            n         = n + 1;
            ops[0]    = codegen_mir.op_preg(codegen_mir.preg_id(div_reg));
            ops[1]    = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
            instrs[n] = codegen_mir.instr(codegen_mir.MIR_DIV_U, ops, 2, 8, 8);
            n         = n + 1;
            val rr: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](alloc, 2::usize);
            if (sel rr.err) { ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(rr.err)}; }
            val rops: *codegen_mir.MirOperand = rr.ok;
            rops[0]   = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
            rops[1]   = codegen_mir.op_preg(codegen_mir.preg_id(div_reg));
            instrs[n] = codegen_mir.instr(codegen_mir.MIR_MOV, rops, 2, 8, 8);
            n         = n + 1;
        }
        if (k == 2 && case_id == WALK_CASE_UI_TO_FP) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
            ops[1]    = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
            instrs[n] = codegen_mir.instr(codegen_mir.MIR_UI_TO_FP, ops, 2, 8, 8);
            n         = n + 1;
        }
        if (k == 2 && case_id == WALK_CASE_LOAD) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
            ops[1]    = codegen_mir.op_imm(4096);
            instrs[n] = codegen_mir.instr(codegen_mir.MIR_MOV, ops, 2, 8, 8);
            n         = n + 1;
        }
        if (k == 3 && case_id == WALK_CASE_LOAD) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(3));
            ops[1]    = codegen_mir.op_mem_value(codegen_mir.vreg_id(2), 0);
            instrs[n] = codegen_mir.instr(codegen_mir.MIR_LOAD, ops, 2, 8, 8);
            n         = n + 1;
        }
        if (k == 3 && case_id == WALK_CASE_UI_TO_FP) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(3));
            ops[1]    = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
            ops[2]    = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
            instrs[n] = codegen_mir.instr(codegen_mir.MIR_FADD, ops, 3, 8, 8);
            n         = n + 1;
        }
        if (k == 3 && (case_id == WALK_CASE_MUL || case_id == WALK_CASE_DIV)) {
            ops[0]    = codegen_mir.op_vreg(codegen_mir.vreg_id(3));
            ops[1]    = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
            ops[2]    = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
            instrs[n] = codegen_mir.instr(codegen_mir.MIR_ADD, ops, 3, 8, 8);
            n         = n + 1;
        }
        if (k == 4) {
            instrs[n] = codegen_mir.instr(codegen_mir.MIR_RET, nil, 0, 0, 0);
            n         = n + 1;
        }
        k = k + 1;
    }
    var j: u32 = 0;
    for (j < n) {
        instrs[j].loc = lang_source.loc_nil();
        j             = j + 1;
    }
    f.blocks[0].id          = 0;
    f.blocks[0].instrs      = instrs;
    f.blocks[0].instr_count = n;
    f.blocks[0].instr_cap   = 10;
    ret res[codegen_mir.MirFunction, fail.Fail].ok{f};
}

# WALK_CASE_LOAD after allocation: home v0 in a spill slot, reload it into
# the ISA's reload scratch, and rewrite the public load's base to that
# scratch. the vreg walk's operand named a public vreg; the physical base is
# the register that now aliases the secret
#[testing]
fun t_walk_alias_reload(tgt: *lang_target.Target, m: *codegen_mir.MirModule, f: *codegen_mir.MirFunction) bool {
    if (tgt.arch.reload_scratch_count < 1) { ret false; }
    val scratch: codegen_mir.PRegId    = codegen_mir.preg_id(tgt.arch.reload_scratch_regs[0].id);
    val blk:     *codegen_mir.MirBlock = ?f.blocks[0];
    var li:      u32                   = blk.instr_count;
    var i:       u32                   = 0;
    for (i < blk.instr_count) {
        val mi: *codegen_mir.MirInstr = ?blk.instrs[i];
        var k:  u32                   = 0;
        for (k < mi.operand_count) {
            if (mi.operands[k].kind == codegen_mir.MIR_OP_MEM && codegen_mir.vreg_is_nil(mi.operands[k].vreg)) { li = i; }
            k = k + 1;
        }
        i = i + 1;
    }
    if (li >= blk.instr_count)                                                                           { ret false; }
    if (blk.instrs[li].operand_count != 2 || blk.instrs[li].operands[0].kind != codegen_mir.MIR_OP_PREG) { ret false; }
    # selection may have rebuilt the instruction array to its exact length
    val grown: res[*codegen_mir.MirInstr, A.Error] = A.zallocate[codegen_mir.MirInstr](m.alloc, (blk.instr_count + 1)::usize);
    if (sel grown.err) { ret false; }
    val instrs: *codegen_mir.MirInstr = grown.ok;
    var c:      u32                   = 0;
    for (c < blk.instr_count) {
        instrs[c] = blk.instrs[c];
        c         = c + 1;
    }
    if (blk.instrs != nil && blk.instr_cap > 0) { A.deallocate[codegen_mir.MirInstr](m.alloc, blk.instrs, blk.instr_cap::usize); }
    blk.instrs    = instrs;
    blk.instr_cap = blk.instr_count + 1;
    val load: *codegen_mir.MirInstr = ?blk.instrs[li];

    val rs: res[*codegen_mir.MirSlot, A.Error] = A.allocate[codegen_mir.MirSlot](m.alloc, 1::usize);
    if (sel rs.err) { ret false; }
    f.frame.slots           = rs.ok;
    f.frame.slots[0].value  = 0;
    f.frame.slots[0].kind   = codegen_mir.SLOT_SPILL;
    f.frame.slots[0].offset = 0;
    f.frame.slots[0].size   = 8;
    f.frame.slots[0].align  = 8;
    f.frame.slots[0].ty     = codegen_mir.SLOT_TY_NIL;
    f.frame.slots[0].origin = codegen_mir.SLOT_ORIGIN_NIL;
    f.frame.slot_count      = 1;
    f.frame.slot_cap        = 1;
    f.vregs[0].spill_slot   = 0;

    val ro: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](m.alloc, 2::usize);
    if (sel ro.err) { ret false; }
    val ops: *codegen_mir.MirOperand = ro.ok;
    ops[0]               = codegen_mir.op_preg_of(scratch, codegen_mir.vreg_id(0));
    ops[0].required_bank = load.operands[0].required_bank;
    ops[1]               = codegen_mir.op_mem_slot(codegen_mir.vreg_id(0), 0);
    ops[1].required_bank = load.operands[1].required_bank;
    var reload: codegen_mir.MirInstr = @load;
    reload.operands      = ops;
    reload.operand_count = 2;

    load.operands[1]               = codegen_mir.op_mem_preg(scratch, 0);
    load.operands[1].required_bank = ops[1].required_bank;

    var j: u32 = blk.instr_count;
    for (j > li) {
        blk.instrs[j] = blk.instrs[j - 1];
        j             = j - 1;
    }
    blk.instrs[li]  = reload;
    blk.instr_count = blk.instr_count + 1;
    ret true;
}

# builds the case on `arch`, checks the early walk accepts it, allocates,
# injects the secret (flip_vreg, or the reload alias for the load case),
# frames and encodes. returns 0 when the encoder's answer matches `needle`
# (nil: must accept), else a code naming the step
#[testing]
fun t_walk_control(arch: str, os_name: str, abi: str, case_id: u32, inject: bool, needle: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var interner: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?interner); }
    var reg: lang_target.TargetRegistry = lang_target.registry_init();
    fin { lang_target.registry_dnit(?reg); }
    val r_2989: err[fail.Fail] = lang_target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2989.err) { ret 2; }
    val ts: res[lang_target.Target, fail.Fail] = lang_target.select(?reg, arch, os_name, abi);
    if (sel ts.err) { ret 3; }
    var tgt: lang_target.Target         = ts.ok;
    val nr:  res[intern.StrId, A.Error] = intern.intern(?interner, "late");
    if (sel nr.err) { ret 4; }

    var m: codegen_mir.MirModule = codegen_mir.MirModule{alloc: ?alloc, interner: ?interner};
    fin { codegen_mir.dnit_module(?m); }
    val rf: res[codegen_mir.MirFunction, fail.Fail] = t_walk_fixture(?alloc, nr.ok, case_id,
        case_id == WALK_CASE_LOAD && inject, tgt.model.div_reg);
    if (sel rf.err) { ret 5; }
    val push_function_r: err[fail.Fail] = codegen_mir.push_function(?m, rf.ok);
    if (sel push_function_r.err) { ret 5; }
    val f: *codegen_mir.MirFunction = ?m.functions[0];

    # the early walk at its pipeline position: the issue's own control
    val run_r: err[fail.Fail] = ctvalidate.validate(?tgt, ?m);
    if (sel run_r.err) { ret 6; }
    val run_r2: err[fail.Fail] = legalize.run(?tgt, ?m);
    if (sel run_r2.err) { ret 7; }
    val run_r3: err[fail.Fail] = isel.run(?tgt, ?m);
    if (sel run_r3.err) { ret 8; }
    val run_r4: err[fail.Fail] = regalloc.run(?tgt, ?m);
    if (sel run_r4.err) { ret 9; }

    if (inject) {
        if (case_id == WALK_CASE_LOAD) {
            if (!t_walk_alias_reload(?tgt, ?m, f)) { ret 10; }
        }
        or (case_id == WALK_CASE_DIV) { f.vregs[1].secret = true; }
        or                            { f.vregs[0].secret = true; }
    }
    val run_r5: err[fail.Fail] = frame.run(?tgt, ?m);
    if (sel run_r5.err) { ret 11; }

    val er: res[codegen_encode.EncoderOutput, fail.Fail] = codegen_encode.run(?tgt, ?m, nil);
    if (sel er.ok) {
        var out: codegen_encode.EncoderOutput = er.ok;
        t_encoder_output_release(?alloc, ?out);
        if (needle == nil) { ret 0; }
        t_walk_dump(?tgt, ?m);
        ret 12;
    }
    val msg: str = fail.describe(er.err);
    if (needle == nil) {
        print.eprintlnf("unexpected refusal: {}", msg);
        ret 13;
    }
    if (!str_contains(msg, needle)) {
        print.eprintlnf("refusal did not name the class: {}", msg);
        ret 14;
    }
    if (!str_contains(msg, "at the emitted instruction `")) { ret 15; }
    ret 0;
}

# on an unexpected acceptance, the rendering the walk consumed
#[testing]
fun t_walk_dump(tgt: *lang_target.Target, m: *codegen_mir.MirModule) {
    var w: io_writer.Writer;
    w.ctx             = nil;
    w.f_write         = t_asm_capture_write;
    t_asm_capture_len = 0;
    val r: res[codegen_encode.EncoderOutput, fail.Fail] = codegen_encode.run(tgt, m, ?w);
    if (sel r.ok) {
        var out: codegen_encode.EncoderOutput = r.ok;
        t_encoder_output_release(m.alloc, ?out);
    }
    t_asm_capture[t_asm_capture_len] = 0;
    print.eprintlnf("accepted stream:\n{}", (?t_asm_capture[0])::str);
    var bi: u32 = 0;
    for (bi < m.functions[0].block_count) {
        val blk: *codegen_mir.MirBlock = ?m.functions[0].blocks[bi];
        var ii:  u32                   = 0;
        for (ii < blk.instr_count) {
            val mi: *codegen_mir.MirInstr = ?blk.instrs[ii];
            var k:  u32                   = 0;
            for (k < mi.operand_count) {
                val op: *codegen_mir.MirOperand = ?mi.operands[k];
                print.eprintlnf("  instr {} opcode {} operand {} kind {} preg {} vreg {} secret {}", ii, mi.opcode, k, op.kind, op.preg.n, op.vreg.n,
                    codegen_mir.operand_seed_secret(?m.functions[0], op));
                k = k + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

#[testing]
val WALK_BRANCH:  str = "branches on";
#[testing]
val WALK_ADDRESS: str = "addresses memory with a secret value";
#[testing]
val WALK_VARLAT:  str = "performs a variable-latency operation on a secret value";

# each control runs its public sibling first, which must pass, then injects the
# secret after allocation, where only the physical walk sees it
#[testing]
fun t_walk_case(arch: str, os_name: str, abi: str, case_id: u32, needle: str) i32 {
    if (t_walk_control(arch, os_name, abi, case_id, false, nil) != 0) { ret 1; }
    ret t_walk_control(arch, os_name, abi, case_id, true, needle);
}

# aarch64 and riscv64 guard the divide with a branch on the divisor; x86-64's
# u64 conversion tests the sign of the source
test walk__rejects_a_late_branch {
    var r: i32 = t_walk_case("aarch64", "linux", "aapcs64", WALK_CASE_DIV, WALK_BRANCH);
    if (r != 0) { ret r; }
    r = t_walk_case("riscv64", "linux", "lp64d", WALK_CASE_DIV, WALK_BRANCH);
    if (r != 0) { ret 40 + r; }
    r = t_walk_case("x86_64", "linux", "sysv64", WALK_CASE_UI_TO_FP, WALK_BRANCH);
    if (r != 0) { ret 80 + r; }
    ret 0;
}

# the reload scratch aliases a spilled secret and is then the base of a load
# the vreg walk saw through a public vreg
test walk__rejects_a_load_through_the_reload_scratch_of_a_spilled_secret {
    var r: i32 = t_walk_case("x86_64", "linux", "sysv64", WALK_CASE_LOAD, WALK_ADDRESS);
    if (r != 0) { ret r; }
    r = t_walk_case("aarch64", "linux", "aapcs64", WALK_CASE_LOAD, WALK_ADDRESS);
    if (r != 0) { ret 40 + r; }
    r = t_walk_case("riscv64", "linux", "lp64d", WALK_CASE_LOAD, WALK_ADDRESS);
    if (r != 0) { ret 80 + r; }
    ret 0;
}

# a late variable-latency use follows the model's declared multiply rows:
# x86-64 admits the 64-bit low half, so its control is the unguarded divide;
# aarch64's rows hold under PSTATE.DIT, which linux declares and freestanding
# does not; riscv64 declares none
test walk__a_late_variable_latency_use_follows_the_declared_rows {
    var r: i32 = t_walk_case("x86_64", "linux", "sysv64", WALK_CASE_DIV, WALK_VARLAT);
    if (r != 0) { ret r; }
    r = t_walk_case("x86_64", "linux", "sysv64", WALK_CASE_MUL, nil);
    if (r != 0) { ret 40 + r; }
    r = t_walk_case("aarch64", "linux", "aapcs64", WALK_CASE_MUL, nil);
    if (r != 0) { ret 80 + r; }
    r = t_walk_case("aarch64", "freestanding", "aapcs64", WALK_CASE_MUL, WALK_VARLAT);
    if (r != 0) { ret 120 + r; }
    r = t_walk_case("riscv64", "linux", "lp64d", WALK_CASE_MUL, WALK_VARLAT);
    if (r != 0) { ret 160 + r; }
    ret 0;
}

# a whole-module emitter no other code knows: two sections, a symbol, one relocation
#[testing]
fun t_fake_emit_module(alloc: *A.Allocator, tgt: *isa.BackendTarget, u: *be_codegen_unit.Unit,
    dbg: *debug_input.ModuleDebug, image: *target_of.ObjectImage) err[fail.Fail] {
    val code_name: res[intern.StrId, A.Error] = intern.intern(image.interner, ".fake.code");
    if (sel code_name.err) { ret err[fail.Fail].err{fail.refused(code_name.err)}; }
    val data_name: res[intern.StrId, A.Error] = intern.intern(image.interner, ".fake.data");
    if (sel data_name.err) { ret err[fail.Fail].err{fail.refused(data_name.err)}; }
    val sym_name: res[intern.StrId, A.Error] = intern.intern(image.interner, "fake_target");
    if (sel sym_name.err) { ret err[fail.Fail].err{fail.refused(sym_name.err)}; }

    val code_bytes: res[*u8, A.Error] = A.allocate[u8](image.alloc, 8::usize);
    if (sel code_bytes.err) { ret err[fail.Fail].err{fail.refused(code_bytes.err)}; }
    memory.raw_fill(code_bytes.ok::ptr, 0x5A, 8);
    var code: target_of.Section;
    code.name  = code_name.ok;
    code.kind  = target_of.SK_TEXT;
    code.bytes = code_bytes.ok;
    code.len   = 8;
    code.align = 4;
    code.flags = 0;
    val code_ix: res[u32, fail.Fail] = target_of.section_install(image, ?code);
    if (sel code_ix.err) { ret err[fail.Fail].err{code_ix.err}; }

    val data_bytes: res[*u8, A.Error] = A.allocate[u8](image.alloc, 4::usize);
    if (sel data_bytes.err) { ret err[fail.Fail].err{fail.refused(data_bytes.err)}; }
    memory.raw_fill(data_bytes.ok::ptr, 0xA5, 4);
    var data: target_of.Section;
    data.name  = data_name.ok;
    data.kind  = target_of.SK_DATA;
    data.bytes = data_bytes.ok;
    data.len   = 4;
    data.align = 4;
    data.flags = 0;
    val data_ix: res[u32, fail.Fail] = target_of.section_install(image, ?data);
    if (sel data_ix.err) { ret err[fail.Fail].err{data_ix.err}; }

    var sym: target_of.Symbol;
    sym.name     = sym_name.ok;
    sym.section  = target_of.section_id(data_ix.ok);
    sym.offset   = 0;
    sym.size     = 4;
    sym.flags    = target_of.SYM_OBJ_FLAG_GLOBAL;
    sym.fallback = target_of.SYMBOL_NONE;
    sym.align    = 4;
    val sym_ix: res[u32, fail.Fail] = target_of.symbol_add(image, sym);
    if (sel sym_ix.err) { ret err[fail.Fail].err{sym_ix.err}; }

    var rel: target_of.Relocation;
    rel.section = target_of.section_id(code_ix.ok);
    rel.offset  = 4;
    rel.kind    = target_of.RK_ABS32;
    rel.sym     = sym_ix.ok;
    rel.addend  = 0;
    rel.sym2    = target_of.SYMBOL_NONE;
    rel.pair    = 0;
    ret target_of.add_relocation(image, rel);
}

#[testing]
fun t_section_named(image: *target_of.ObjectImage, name: str) *target_of.Section {
    var i: u32 = 0;
    for (i < image.section_count) {
        val nm: opt[str] = intern.lookup(image.interner, image.sections[i].name);
        if (sel nm.some && str_equals(nm.some, name)) { ret ?image.sections[i]; }
        i = i + 1;
    }
    ret nil;
}

# codegen hands the image a registered whole-module emitter filled to the linker
# untouched: no section, symbol or relocation is added, dropped or renamed
test emit_module_image__carries_what_a_whole_module_emitter_writes {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val registered: err[fail.Fail] = lang_target.register_all(s.registry, target_testing.debug_descriptor);
    if (sel registered.err) { ret 2; }
    val selected: res[lang_target.Target, fail.Fail] = lang_target.select(s.registry, "spirv", "freestanding", "spirv");
    if (sel selected.err) { ret 2; }
    var tgt: lang_target.Target = selected.ok;

    var reg: isa.IsaRegistry = isa.registry_init();
    fin { isa.registry_dnit(?reg); }
    var emitter:  isa.ModuleEmitter = isa.module_emitter(t_fake_emit_module, false);
    var fake:     isa.IsaVTable     = isa.emitter_isa(isa.ARCH_SPIRV, "fake", tgt.isa.pointer_width, tgt.isa.model, ?emitter);
    val admitted: err[fail.Fail]    = isa.register(?reg, ?fake);
    if (sel admitted.err) { ret 3; }
    val descriptor: opt[*isa.IsaVTable] = isa.registered(?reg, 0);
    if (sel descriptor.none) { ret 3; }
    tgt.isa = descriptor.some;

    val name_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "fake_module");
    if (sel name_r.err) { ret 4; }
    val initialized: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, name_r.ok);
    if (sel initialized.err) { ret 4; }
    var module: me_ir.Module = initialized.ok;

    val emitted: res[target_of.ObjectImage, fail.Fail] = codegen_unit(?s, ?tgt, ?module,
        be_codegen_unit.ir_set_empty(), nil, PLACEMENT_POLICY_VERSION, no_debug(), ?s.diags);
    me_ir.dnit(?module);
    if (sel emitted.err) { ret 5; }
    var image: target_of.ObjectImage = emitted.ok;
    fin { obj.dnit(?image); }

    if (image.section_count != 2) { ret 6; }
    val code: *target_of.Section = t_section_named(?image, ".fake.code");
    val data: *target_of.Section = t_section_named(?image, ".fake.data");
    if (code == nil || data == nil)                                               { ret 7; }
    if (code.kind != target_of.SK_TEXT || code.len != 8 || code.bytes[7] != 0x5A) { ret 8; }
    if (data.kind != target_of.SK_DATA || data.len != 4 || data.bytes[0] != 0xA5) { ret 9; }

    if (image.symbol_count != 1) { ret 10; }
    val sym_name: opt[str] = intern.lookup(image.interner, image.symbols[0].name);
    if (!(sel sym_name.some && str_equals(sym_name.some, "fake_target")))           { ret 11; }
    if (?image.sections[target_of.section_index(image.symbols[0].section)] != data) { ret 12; }

    if (image.reloc_count != 1) { ret 13; }
    val rel: *target_of.Relocation = ?image.relocations[0];
    if (?image.sections[target_of.section_index(rel.section)] != code)                        { ret 14; }
    if (rel.offset != 4 || rel.kind != target_of.RK_ABS32 || rel.sym != 0 || rel.addend != 0) { ret 15; }
    ret 0;
}
