    if (t_walk_control("aarch64", "linux", "aapcs64", WALK_CASE_LOAD, false, nil) != 0) { ret 1; }
    ret t_walk_control("aarch64", "linux", "aapcs64", WALK_CASE_LOAD, true, WALK_ADDRESS);
}

test "mach.lang.be.codegen.walk:riscv64_rejects_a_load_through_the_reload_scratch_of_a_spilled_secret" {
    if (t_walk_control("riscv64", "linux", "lp64d", WALK_CASE_LOAD, false, nil) != 0) { ret 1; }
    ret t_walk_control("riscv64", "linux", "lp64d", WALK_CASE_LOAD, true, WALK_ADDRESS);
}

# (c) a late variable-latency use: a multiply whose operand is seeded secret
# after allocation, on a model that does not trust the multiplier
test "mach.lang.be.codegen.walk:x86_64_rejects_a_multiply_on_an_operand_seeded_after_allocation" {
    if (t_walk_control("x86_64", "linux", "sysv64", WALK_CASE_MUL, false, nil) != 0) { ret 1; }
    ret t_walk_control("x86_64", "linux", "sysv64", WALK_CASE_MUL, true, WALK_VARLAT);
}

test "mach.lang.be.codegen.walk:aarch64_rejects_a_multiply_on_an_operand_seeded_after_allocation" {
    if (t_walk_control("aarch64", "linux", "aapcs64", WALK_CASE_MUL, false, nil) != 0) { ret 1; }
    ret t_walk_control("aarch64", "linux", "aapcs64", WALK_CASE_MUL, true, WALK_VARLAT);
}

test "mach.lang.be.codegen.walk:riscv64_rejects_a_multiply_on_an_operand_seeded_after_allocation" {
    if (t_walk_control("riscv64", "linux", "lp64d", WALK_CASE_MUL, false, nil) != 0) { ret 1; }
    ret t_walk_control("riscv64", "linux", "lp64d", WALK_CASE_MUL, true, WALK_VARLAT);
}

# fail-at-N over the backend for an oblivious function: the shape whose
# encoding runs ctwalk (N5). the fixture is built with the probe unarmed, the
# probe is armed, and legalize, isel, regalloc, frame and encode (which walks
# the emitted stream) run under it. every scratch structure the walk grows
# (its entry table, block-note map, monotone and entry maps, and per-entry
# extents) is on this allocator, so a refusal at any ordinal must come back
# as the allocator's text through the typed outcome and leave nothing live.
fun t_ctwalk_probe(arch: str, os_name: str, abi: str, ordinal: usize, refused_at: *usize) i32 {
    var pb: probe.Probe;
    val made: err[A.Error] = probe.make(?pb);
    if (sel made.err) { ret 1; }
    fin { probe.dnit(?pb); }
    val alloc: *A.Allocator = probe.allocator_of(?pb);
    var interner: intern.Interner = intern.init(alloc);
    fin { intern.dnit(?interner); }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_reg: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_reg.err) { ret 2; }
    val ts: res[target.Target, fail.Fail] = target.select(?reg, arch, os_name, abi);
    if (sel ts.err) { ret 3; }
    var tgt: target.Target = ts.ok;
    val nr: res[intern.StrId, A.Error] = intern.intern(?interner, "obliv");
    if (sel nr.err) { ret 4; }
    var m: mir.MirModule = mir.MirModule{alloc: alloc, interner: ?interner};
    fin { mir.dnit_module(?m); }
    val rf: res[mir.MirFunction, fail.Fail] = t_oblivious_fixture(alloc, nr.ok, true);
    if (sel rf.err) { ret 5; }
    val pushed: err[fail.Fail] = mir.push_function(?m, rf.ok);
    if (sel pushed.err) { ret 6; }

    pb.ordinal = ordinal;
    probe.arm(?pb);
    val pipeline: err[fail.Fail] = t_allocate_fixture(?tgt, ?m);
    var outcome_ok: bool = false;
    var outcome_refused: bool = false;
    if (sel pipeline.err) { outcome_refused = true; }
    or {
        val enc: res[encode.EncoderOutput, fail.Fail] = encode.run(?tgt, ?m, nil);
        if (sel enc.ok) {
            outcome_ok = true;
            var out: encode.EncoderOutput = enc.ok;
            t_encoder_output_release(alloc, ?out);
        }
        or { outcome_refused = true; }
    }
    probe.clear_failure(?pb);
    @refused_at = probe.counted(?pb);

    var bad: i32 = 0;
    if (ordinal == 0) { if (!outcome_ok) { bad = 7; } }
    or { if (!outcome_refused) { bad = 8; } }
    ret bad;
}

fun t_ctwalk_walk(arch: str, os_name: str, abi: str) i32 {
    var attempts: usize = 0;
    val baseline: i32 = t_ctwalk_probe(arch, os_name, abi, 0, ?attempts);
    if (baseline != 0) { ret baseline; }
    if (attempts == 0) { ret 20; }
    var ordinal: usize = 1;
    for (ordinal <= attempts) {
        var ignored: usize = 0;
        val code: i32 = t_ctwalk_probe(arch, os_name, abi, ordinal, ?ignored);
        if (code != 0) { ret code; }
        ordinal = ordinal + 1;
    }
    ret 0;
}

test "mach.lang.be.codegen.ctwalk:refusal_at_every_ordinal_is_typed_and_leaks_nothing_x86_64" {
    ret t_ctwalk_walk("x86_64", "linux", "sysv64");
}
