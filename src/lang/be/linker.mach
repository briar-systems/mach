rec ImageCountUnit {}

pub fun link(s: *session.Session, tgt: *target.Target, obj_paths: **u8,
    obj_count: u32, dynlibs: *of.DynLib, dynlib_count: u32,
    destination: str, name: *u8, mode: LinkMode, pie: bool,
    image_options: of.ImageOptions) err[fail.Fail] {
    if (s == nil)   { ret err[fail.Fail].err{fail.message("link: nil session")}; }
    if (tgt == nil) { ret err[fail.Fail].err{fail.message("link: nil target")}; }
    val borrow: err[fail.Fail] = target.live(tgt);
    if (sel borrow.err)         { ret borrow; }
    if (tgt.of == nil)          { ret err[fail.Fail].err{fail.message("link: target has no object-format vtable")}; }
    if (tgt.os == nil)          { ret err[fail.Fail].err{fail.message("link: target has no OS vtable")}; }
    if (!link_mode_valid(mode)) { ret err[fail.Fail].err{fail.message("link: invalid link mode")}; }
    if (obj_paths == nil || obj_count == 0) {
        ret err[fail.Fail].err{fail.message("link: no input objects")};
    }

    val alloc: *A.Allocator = s.alloc;

    var required: intern.StrId = intern.STR_NIL;
    if (mode == LINK_EXE) {
        val er: res[intern.StrId, A.Error] = intern.intern(?s.interner, tgt.os.entry_symbol);
        if (sel er.err) {
            ret err[fail.Fail].err{fail.refused(er.err)};
        }
        required = er.ok;
    }

    var module_count: u32                             = 0;
    val read_r:       res[*of.ObjectImage, fail.Fail] =
        read_objects(s, tgt, obj_paths, obj_count, nil::*of.ObjectImage, 0,
        required, ?module_count);
    if (sel read_r.err) {
        ret err[fail.Fail].err{read_r.err};
    }
    val modules: *of.ObjectImage = read_r.ok;

    val r: err[fail.Fail] =
        link_modules_nocapture(s, tgt, modules, module_count, 0, dynlibs, dynlib_count,
        destination, name, mode, pie, image_options);
    free_modules(alloc, modules, module_count);
    ret r;
}

pub rec LinkedImage {
    bytes:        *u8;
    len:          usize;
    base:         u64;
    symbols:      *of.SymtabEntry;
    symbol_count: u32;
}

pub fun linked_image_dnit(img: *LinkedImage, alloc: *A.Allocator) {
    if (img == nil)                      { ret; }
    if (img.bytes != nil && img.len > 0) { A.deallocate[u8](alloc, img.bytes, img.len); }
    if (img.symbols != nil && img.symbol_count > 0) {
        A.deallocate[of.SymtabEntry](alloc, img.symbols, img.symbol_count::usize);
    }
    img.bytes        = nil;
    img.len          = 0;
    img.base         = 0;
    img.symbols      = nil;
    img.symbol_count = 0;
}

pub fun linked_image_symbol(img: *LinkedImage, itn: *intern.Interner, name: str) opt[u64] {
    if (img == nil || img.symbols == nil) { ret opt[u64].none{}; }
    var i: u32 = 0;
    for (i < img.symbol_count) {
        val found: opt[str] = intern.lookup(itn, img.symbols[i].name);
        if (sel found.some && str_equals(found.some, name)) {
            ret opt[u64].some{img.symbols[i].vaddr};
        }
        i = i + 1;
    }
    ret opt[u64].none{};
}

# link images into an executable handed back in memory
# ---
# root_names: definitions the caller reaches by name, kept even when the entry
#             does not reach them
# root_count: number of root names
pub fun link_images_captured(s: *session.Session, tgt: *target.Target, images: *of.ObjectImage,
    image_count: u32, dynlibs: *of.DynLib, dynlib_count: u32,
    name: *u8, pie: bool, image_options: of.ImageOptions,
    root_names: *str, root_count: u32, out: *LinkedImage) err[fail.Fail] {
    if (out == nil) { ret err[fail.Fail].err{fail.message("link: nil capture target")}; }
    if (out.bytes != nil || out.symbols != nil) {
        ret err[fail.Fail].err{fail.message("link: capture target is not empty")};
    }
    out.bytes        = nil;
    out.len          = 0;
    out.base         = 0;
    out.symbols      = nil;
    out.symbol_count = 0;

    if (s == nil)   { ret err[fail.Fail].err{fail.message("link: nil session")}; }
    if (tgt == nil) { ret err[fail.Fail].err{fail.message("link: nil target")}; }
    val borrow: err[fail.Fail] = target.live(tgt);
    if (sel borrow.err) { ret borrow; }
    if (tgt.of == nil)  { ret err[fail.Fail].err{fail.message("link: target has no object-format vtable")}; }
    if (tgt.os == nil)  { ret err[fail.Fail].err{fail.message("link: target has no OS vtable")}; }
    if (images == nil || image_count == 0) {
        ret err[fail.Fail].err{fail.message("link: no input objects")};
    }
    if (!tgt.of.produces_image || tgt.of.emit_exec_image == nil) {
        ret err[fail.Fail].err{fail.message("link: this object format cannot hand back a linked image")};
    }

    var roots: *intern.StrId = nil;
    if (root_count > 0) {
        val rr: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](s.alloc, root_count::usize);
        if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
        roots = rr.ok;
    }
    fin {
        if (roots != nil) { A.deallocate[intern.StrId](s.alloc, roots, root_count::usize); }
    }
    var ri: u32 = 0;
    for (ri < root_count) {
        val ir: res[intern.StrId, A.Error] = intern.intern(?s.interner, root_names[ri]);
        if (sel ir.err) { ret err[fail.Fail].err{fail.refused(ir.err)}; }
        roots[ri] = ir.ok;
        ri        = ri + 1;
    }

    ret link_modules(s, tgt, images, image_count, image_count, dynlibs,
        dynlib_count, nil, name, LINK_EXE, pie, image_options, roots, root_count, out);
}

test "mach.lang.be.linker.link_images_captured:rejects_a_dirty_capture_target" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var stale: [4]u8;
    var out:   LinkedImage;
    out.bytes        = ?stale[0];
    out.len          = 4;
    out.base         = 0;
    out.symbols      = nil;
    out.symbol_count = 0;

    val r: err[fail.Fail] = link_images_captured(
        nil::*session.Session, nil::*target.Target, nil::*of.ObjectImage, 0,
        nil::*of.DynLib, 0, ""::*u8, false,
        of.image_options_default(of.SUBSYSTEM_CONSOLE), nil::*str, 0, ?out);
    if (sel r.ok)                                         { ret 1; }
    if (!str_contains(fail.describe(r.err), "not empty")) { ret 1; }
    if (out.bytes != ?stale[0])                           { ret 1; }
    if (out.len != 4)                                     { ret 1; }
    ret 0;
}

pub fun link_images(s: *session.Session, tgt: *target.Target, images: *of.ObjectImage,
    image_count: u32, dynlibs: *of.DynLib, dynlib_count: u32,
    destination: str, name: *u8, mode: LinkMode, pie: bool,
    image_options: of.ImageOptions) err[fail.Fail] {
    if (s == nil)   { ret err[fail.Fail].err{fail.message("link: nil session")}; }
    if (tgt == nil) { ret err[fail.Fail].err{fail.message("link: nil target")}; }
    val borrow: err[fail.Fail] = target.live(tgt);
    if (sel borrow.err)         { ret borrow; }
    if (tgt.of == nil)          { ret err[fail.Fail].err{fail.message("link: target has no object-format vtable")}; }
    if (tgt.os == nil)          { ret err[fail.Fail].err{fail.message("link: target has no OS vtable")}; }
    if (!link_mode_valid(mode)) { ret err[fail.Fail].err{fail.message("link: invalid link mode")}; }
    if (images == nil || image_count == 0) {
        ret err[fail.Fail].err{fail.message("link: no input objects")};
    }
    ret link_modules_nocapture(s, tgt, images, image_count, image_count, dynlibs,
        dynlib_count, destination, name, mode, pie, image_options);
}

pub fun link_mixed(s: *session.Session, tgt: *target.Target,
    images: *of.ObjectImage, image_count: u32,
    obj_paths: **u8, obj_count: u32,
    dynlibs: *of.DynLib, dynlib_count: u32,
    destination: str, name: *u8, mode: LinkMode, pie: bool,
    image_options: of.ImageOptions) err[fail.Fail] {
    if (s == nil)   { ret err[fail.Fail].err{fail.message("link: nil session")}; }
    if (tgt == nil) { ret err[fail.Fail].err{fail.message("link: nil target")}; }
    val borrow: err[fail.Fail] = target.live(tgt);
    if (sel borrow.err)         { ret borrow; }
    if (tgt.of == nil)          { ret err[fail.Fail].err{fail.message("link: target has no object-format vtable")}; }
    if (tgt.os == nil)          { ret err[fail.Fail].err{fail.message("link: target has no OS vtable")}; }
    if (!link_mode_valid(mode)) { ret err[fail.Fail].err{fail.message("link: invalid link mode")}; }
    if (images == nil || image_count == 0) {
        ret err[fail.Fail].err{fail.message("link: no input objects")};
    }

    val alloc: *A.Allocator = s.alloc;

    var required: intern.StrId = intern.STR_NIL;
    if (mode == LINK_EXE) {
        val er: res[intern.StrId, A.Error] = intern.intern(?s.interner, tgt.os.entry_symbol);
        if (sel er.err) {
            ret err[fail.Fail].err{fail.refused(er.err)};
        }
        required = er.ok;
    }

    var ext_count: u32             = 0;
    var ext:       *of.ObjectImage = nil;
    if (obj_paths != nil && obj_count > 0) {
        val read_r: res[*of.ObjectImage, fail.Fail] =
            read_objects(s, tgt, obj_paths, obj_count, images, image_count,
            required, ?ext_count);
        if (sel read_r.err) {
            ret err[fail.Fail].err{read_r.err};
        }
        ext = read_r.ok;
    }

    val total_r: res[u32, fail.Fail] = combined_image_count(image_count, ext_count);
    if (sel total_r.err) {
        free_modules(alloc, ext, ext_count);
        ret err[fail.Fail].err{total_r.err};
    }
    val total: u32                           = total_r.ok;
    val cr:    res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](alloc, total::usize);
    if (sel cr.err) {
        free_modules(alloc, ext, ext_count);
        ret err[fail.Fail].err{fail.refused(cr.err)};
    }
    val combined: *of.ObjectImage = cr.ok;

    var i: u32 = 0;
    for (i < image_count) {
        combined[i] = images[i];
        i           = i + 1;
    }
    var j: u32 = 0;
    for (j < ext_count) {
        combined[image_count + j] = ext[j];
        j                         = j + 1;
    }

    val r: err[fail.Fail] =
        link_modules_nocapture(s, tgt, combined, total, image_count, dynlibs, dynlib_count,
        destination, name, mode, pie, image_options);

    free_modules(alloc, ext, ext_count);
    A.deallocate[of.ObjectImage](alloc, combined, total::usize);
    ret r;
}

fun image_machine_flags(s: *session.Session, tgt: *target.Target,
    modules: *of.ObjectImage, module_count: u32) res[u32, fail.Fail] {
    if (!isa.declares_machine_flags(tgt.isa)) { ret res[u32, fail.Fail].ok{0}; }

    val abi_mask: u32 = isa.machine_flags(tgt.isa, 0, false)
        | isa.machine_flags(tgt.isa, 32, false)
        | isa.machine_flags(tgt.isa, 64, false);
    val abi_bits: u32 = isa.machine_flags(tgt.isa, tgt.abi.float_arg_bits, false) & abi_mask;

    var feature_bits: u32 = 0;
    var i:            u32 = 0;
    for (i < module_count) {
        val got: u32 = modules[i].machine_flags;
        if ((got & abi_mask) != abi_bits) {
            ret res[u32, fail.Fail].err{fail.message(machine_flags_mismatch_message(s, tgt, ?modules[i],
                got & abi_mask, abi_bits))};
        }
        feature_bits = feature_bits | (got & ~abi_mask);
        i            = i + 1;
    }
    ret res[u32, fail.Fail].ok{abi_bits | feature_bits};
}

fun image_attributes(s: *session.Session, tgt: *target.Target, modules: *of.ObjectImage,
    module_count: u32, out_len: *u32) res[*u8, fail.Fail] {
    @out_len = 0;
    if (!isa.declares_attributes(tgt.isa)) { ret res[*u8, fail.Fail].ok{nil}; }

    var acc:     *u8 = nil;
    var acc_len: u32 = 0;
    var i:       u32 = 0;
    for (i < module_count) {
        if (modules[i].attributes == nil || modules[i].attributes_len == 0) {
            i = i + 1;
            cnt;
        }
        var next_len: u32                 = 0;
        val mr:       res[*u8, fail.Fail] = isa.merge_attributes(tgt.isa, s.alloc, acc, acc_len,
            modules[i].attributes,
            modules[i].attributes_len, ?next_len);
        if (sel mr.err) {
            if (acc != nil && acc_len > 0) { A.deallocate[u8](s.alloc, acc, acc_len::usize); }
            ret mr;
        }
        val merged: *u8 = mr.ok;
        if (acc != nil && acc_len > 0 && acc != merged) { A.deallocate[u8](s.alloc, acc, acc_len::usize); }
        acc     = merged;
        acc_len = next_len;
        i       = i + 1;
    }
    @out_len = acc_len;
    ret res[*u8, fail.Fail].ok{acc};
}

fun link_modules_nocapture(s: *session.Session, tgt: *target.Target, modules: *of.ObjectImage,
    module_count: u32, codegen_count: u32,
    dynlibs: *of.DynLib, dynlib_count: u32,
    destination: str, name: *u8, mode: LinkMode, pie_opt_in: bool,
    image_options: of.ImageOptions) err[fail.Fail] {
    ret link_modules(s, tgt, modules, module_count, codegen_count, dynlibs, dynlib_count,
        destination, name, mode, pie_opt_in, image_options, nil::*intern.StrId, 0, nil::*LinkedImage);
}

fun link_modules(s: *session.Session, tgt: *target.Target, modules: *of.ObjectImage,
    module_count: u32, codegen_count: u32,
    dynlibs: *of.DynLib, dynlib_count: u32,
    destination: str, name: *u8, mode: LinkMode, pie_opt_in: bool,
    image_options: of.ImageOptions, root_names: *intern.StrId, root_count: u32,
    capture: *LinkedImage) err[fail.Fail] {
    if (!link_mode_valid(mode)) { ret err[fail.Fail].err{fail.message("link: invalid link mode")}; }
    val inputs_valid: err[fail.Fail] = validate_link_inputs(modules, module_count);
    if (sel inputs_valid.err) {
        ret inputs_valid;
    }
    val surface_r: res[ExportSurface, fail.Fail] = export_surface_build(s, modules, module_count);
    if (sel surface_r.err) { ret err[fail.Fail].err{surface_r.err}; }
    var surface: ExportSurface = surface_r.ok;
    fin { export_surface_free(?surface); }

    var roots: LinkRoots;
    roots.entry      = intern.STR_NIL;
    roots.exports    = mode == LINK_SHARED;
    roots.names      = root_names;
    roots.name_count = root_count;
    roots.surface    = ?surface;
    if (mode == LINK_EXE) {
        val er: res[intern.StrId, A.Error] = intern.intern(?s.interner, tgt.os.entry_symbol);
        if (sel er.err) { ret err[fail.Fail].err{fail.refused(er.err)}; }
        roots.entry = er.ok;
    }
    val alloc0:  *A.Allocator         = s.alloc;
    var commons: of.ObjectImage;
    val made_r:  res[bool, fail.Fail] = synthesize_common_storage(s, modules, module_count, mode, ?commons);
    if (sel made_r.err) { ret err[fail.Fail].err{made_r.err}; }
    if (!made_r.ok) {
        ret link_modules_with_commons(s, tgt, modules, module_count, codegen_count,
            dynlibs, dynlib_count, destination, name, mode,
            pie_opt_in, image_options, ?roots, capture);
    }

    if (module_count == 0xFFFFFFFF) {
        obj.dnit(?commons);
        ret err[fail.Fail].err{fail.message("link: too many input objects to append common storage")};
    }
    val all_r: res[*of.ObjectImage, A.Error] =
        A.allocate[of.ObjectImage](alloc0, (module_count + 1)::usize);
    if (sel all_r.err) {
        obj.dnit(?commons);
        ret err[fail.Fail].err{fail.refused(all_r.err)};
    }
    val all: *of.ObjectImage = all_r.ok;
    var ci:  u32             = 0;
    for (ci < module_count) {
        all[ci] = modules[ci];
        ci      = ci + 1;
    }
    all[module_count] = commons;

    val linked: err[fail.Fail] = link_modules_with_commons(
        s, tgt, all, module_count + 1, codegen_count, dynlibs, dynlib_count,
        destination, name, mode, pie_opt_in, image_options, ?roots, capture);
    A.deallocate[of.ObjectImage](alloc0, all, (module_count + 1)::usize);
    obj.dnit(?commons);
    ret linked;
}

fun opts_attributes_release(alloc: *A.Allocator, opts: *of.ImageOptions) {
    if (opts.attributes != nil && opts.attributes_len > 0) {
        A.deallocate[u8](alloc, opts.attributes, opts.attributes_len::usize);
    }
}

fun link_modules_with_commons(s: *session.Session, tgt: *target.Target, modules: *of.ObjectImage,
    module_count: u32, codegen_count: u32,
    dynlibs: *of.DynLib, dynlib_count: u32,
    destination: str, name: *u8, mode: LinkMode, pie_opt_in: bool,
    image_options: of.ImageOptions, roots: *LinkRoots, capture: *LinkedImage) err[fail.Fail] {
    val alloc: *A.Allocator = s.alloc;
    if (mode != LINK_RELOCATABLE && modules != nil) {
        var ni: u32 = 0;
        for (ni < module_count) {
            val nr: err[fail.Fail] = rel.normalize_image(tgt.isa, alloc, ?modules[ni]);
            if (sel nr.err) { ret nr; }
            ni = ni + 1;
        }
    }
    var attribute_input: u32 = 0;
    for (attribute_input < module_count) {
        val input_attributes_valid: err[fail.Fail] = isa.validate_attributes(
            tgt.isa, ?tgt.model, modules[attribute_input].attributes, modules[attribute_input].attributes_len,
            modules[attribute_input].machine_flags);
        if (sel input_attributes_valid.err) { ret input_attributes_valid; }
        attribute_input = attribute_input + 1;
    }
    val mf_r: res[u32, fail.Fail] = image_machine_flags(s, tgt, modules, module_count);
    if (sel mf_r.err) { ret err[fail.Fail].err{mf_r.err}; }
    var opts: of.ImageOptions = image_options;
    opts.machine_flags = mf_r.ok;
    var attr_len: u32                 = 0;
    val at_r:     res[*u8, fail.Fail] = image_attributes(s, tgt, modules, module_count, ?attr_len);
    if (sel at_r.err) { ret err[fail.Fail].err{at_r.err}; }
    opts.attributes     = at_r.ok;
    opts.attributes_len = attr_len;
    val attributes_valid: err[fail.Fail] = isa.validate_attributes(tgt.isa, ?tgt.model, opts.attributes, attr_len, opts.machine_flags);
    if (sel attributes_valid.err) {
        opts_attributes_release(alloc, ?opts);
        ret attributes_valid;
    }
    if (mode == LINK_RELOCATABLE) {
        val combined: res[of.ObjectImage, fail.Fail] = relocatable.combine(
            alloc, ?s.interner, modules, module_count, opts.machine_flags,
            opts.attributes, opts.attributes_len);
        opts_attributes_release(alloc, ?opts);
        if (sel combined.err) {
            ret err[fail.Fail].err{combined.err};
        }
        var image: of.ObjectImage = combined.ok;
        fin { obj.dnit(?image); }
        ret obj.emit_image(?image, tgt, destination);
    }
    var indirect_input: u32 = 0;
    for (indirect_input < module_count) {
        if (modules[indirect_input].indirect_count != 0) {
            opts_attributes_release(alloc, ?opts);
            ret err[fail.Fail].err{fail.message("link: native indirect symbol sections require relocatable output")};
        }
        indirect_input = indirect_input + 1;
    }
    opts.mapped_by_loader = tgt.os.mapped_by_loader;
    opts.stack_reserve    = tgt.stack_reserve;
    opts.stack_commit     = tgt.stack_commit;
    var local_atoms: AtomPlan;
    init_atom_plan(?local_atoms);
    var pre_atoms:      *AtomPlan = nil;
    var local_sec_base: *u32      = nil;
    if (!str_empty(tgt.of.import_address_prefix) && mode != LINK_RELOCATABLE
        && modules != nil && module_count > 0) {
        val sb_r: res[*u32, A.Error] =
            A.zallocate[u32](alloc, module_count::usize);
        if (sel sb_r.err) {
            opts_attributes_release(alloc, ?opts);
            ret err[fail.Fail].err{fail.refused(sb_r.err)};
        }
        local_sec_base = sb_r.ok;
        val local_sec_total_r: res[u32, fail.Fail] = total_sections(modules, module_count);
        if (sel local_sec_total_r.err) {
            A.deallocate[u32](alloc, local_sec_base, module_count::usize);
            free_atom_plan(alloc, ?local_atoms);
            opts_attributes_release(alloc, ?opts);
            ret err[fail.Fail].err{local_sec_total_r.err};
        }
        val atom_r: err[fail.Fail] = build_atom_plan(
            s, modules, module_count, codegen_count, local_sec_base,
            local_sec_total_r.ok, true, roots, tgt.isa, ?local_atoms);
        if (sel atom_r.err) {
            A.deallocate[u32](alloc, local_sec_base, module_count::usize);
            free_atom_plan(alloc, ?local_atoms);
            opts_attributes_release(alloc, ?opts);
            ret atom_r;
        }
        pre_atoms = ?local_atoms;
    }

    var local_imports: of.ObjectImage;
    val made_r:        res[bool, fail.Fail] = synthesize_local_imports(
        s, tgt.of.import_address_prefix, modules, module_count, mode,
        local_sec_base, ?local_atoms, ?local_imports);
    if (local_sec_base != nil) {
        A.deallocate[u32](alloc, local_sec_base, module_count::usize);
    }
    if (sel made_r.err) {
        free_atom_plan(alloc, ?local_atoms);
        opts_attributes_release(alloc, ?opts);
        ret err[fail.Fail].err{made_r.err};
    }
    if (!made_r.ok) {
        val linked: err[fail.Fail] = link_modules_core(
            s, tgt, modules, module_count, codegen_count,
            dynlibs, dynlib_count, destination, name, mode, pie_opt_in, opts,
            roots, pre_atoms, capture);
        free_atom_plan(alloc, ?local_atoms);
        opts_attributes_release(alloc, ?opts);
        ret linked;
    }

    if (module_count == 0xFFFFFFFF) {
        obj.dnit(?local_imports);
        free_atom_plan(alloc, ?local_atoms);
        opts_attributes_release(alloc, ?opts);
        ret err[fail.Fail].err{fail.message("link: too many input objects for local import pointers")};
    }
    val all_r: res[*of.ObjectImage, A.Error] =
        A.allocate[of.ObjectImage](alloc, (module_count + 1)::usize);
    if (sel all_r.err) {
        obj.dnit(?local_imports);
        free_atom_plan(alloc, ?local_atoms);
        opts_attributes_release(alloc, ?opts);
        ret err[fail.Fail].err{fail.refused(all_r.err)};
    }
    val all: *of.ObjectImage = all_r.ok;
    var i:   u32             = 0;
    for (i < module_count) {
        all[i] = modules[i];
        i      = i + 1;
    }
    all[module_count] = local_imports;

    val linked: err[fail.Fail] = link_modules_core(
        s, tgt, all, module_count + 1, codegen_count,
        dynlibs, dynlib_count, destination, name, mode, pie_opt_in, opts,
        roots, pre_atoms, capture);
    A.deallocate[of.ObjectImage](alloc, all, (module_count + 1)::usize);
    obj.dnit(?local_imports);
    free_atom_plan(alloc, ?local_atoms);
    opts_attributes_release(alloc, ?opts);
    ret linked;
}

fun link_modules_core(s: *session.Session, tgt: *target.Target, modules: *of.ObjectImage,
    module_count: u32, codegen_count: u32,
    dynlibs: *of.DynLib, dynlib_count: u32,
    destination: str, name: *u8, mode: LinkMode, pie_opt_in: bool,
    image_options: of.ImageOptions, roots: *LinkRoots,
    pre_atoms: *AtomPlan, capture: *LinkedImage) err[fail.Fail] {
    val alloc:     *A.Allocator = s.alloc;
    var local_got: LocalGotPlan;
    init_local_got_plan(?local_got);
    var groups: SectionGroups;
    init_section_groups(?groups);
    val shared:               bool = (mode == LINK_SHARED);
    val pie:                  bool = (mode == LINK_EXE) && (target_requires_pie(tgt) || pie_opt_in);
    val position_independent: bool = pie || shared;

    if (module_count == 0) {
        ret err[fail.Fail].err{fail.message("link: no input objects")};
    }
    if (codegen_count > module_count) {
        ret err[fail.Fail].err{fail.message("link: codegen image count exceeds module count")};
    }

    var debug_names: *intern.StrId  = nil;
    var debug_count: u32            = 0;
    val dn_r:        err[fail.Fail] = discover_debug_names(alloc, modules, module_count, ?debug_names, ?debug_count);
    if (sel dn_r.err) { ret dn_r; }

    var dm: u32 = 0;
    for (dm < module_count) {
        if (!module_debug_is_linkable(modules, dm)) { warn_debug_dropped(s, modules[dm].name); }
        dm = dm + 1;
    }

    val patching: bool = (mode == LINK_EXE) || shared;
    var atoms:    AtomPlan;
    init_atom_plan(?atoms);
    var strm: StrMerge;
    val sm_r: res[StrMerge, fail.Fail] = build_str_merge(s, modules, module_count, patching);
    if (sel sm_r.err) {
        if (debug_names != nil && debug_count > 0) { A.deallocate[intern.StrId](alloc, debug_names, debug_count::usize); }
        ret err[fail.Fail].err{sm_r.err};
    }
    strm = sm_r.ok;

    val merged_count_r: res[u32, fail.Fail] = merged_section_count(debug_count);
    if (sel merged_count_r.err) {
        if (debug_names != nil && debug_count > 0) { A.deallocate[intern.StrId](alloc, debug_names, debug_count::usize); }
        free_str_merge(?strm);
        ret err[fail.Fail].err{merged_count_r.err};
    }
    val merged_count: u32                          = merged_count_r.ok;
    var merged:       *MergedSection               = nil;
    val mrg_r:        res[*MergedSection, A.Error] = A.zallocate[MergedSection](alloc, merged_count::usize);
    if (sel mrg_r.err) {
        if (debug_names != nil && debug_count > 0) { A.deallocate[intern.StrId](alloc, debug_names, debug_count::usize); }
        free_str_merge(?strm);
        ret err[fail.Fail].err{fail.refused(mrg_r.err)};
    }
    merged = mrg_r.ok;
    init_merged(merged, debug_names, debug_count);
    var merged_to_out: *u32 = nil;

    val sym_total_r: res[u32, fail.Fail] = total_symbols(modules, module_count);
    if (sel sym_total_r.err) {
        free_scratch(alloc, nil, 0, nil, 0, merged, merged_count, debug_names, debug_count, merged_to_out, nil, nil, 0, ?strm, ?atoms, ?groups);
        ret err[fail.Fail].err{sym_total_r.err};
    }
    val sym_total: u32  = sym_total_r.ok;
    var sym_base:  *u32 = nil;
    var sym_out:   *u32 = nil;

    val sec_total_r: res[u32, fail.Fail] = total_sections(modules, module_count);
    if (sel sec_total_r.err) {
        free_scratch(alloc, nil, 0, nil, 0, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret err[fail.Fail].err{sec_total_r.err};
    }
    val sec_total:  u32        = sec_total_r.ok;
    var placements: *Placement = nil;
    if (sec_total > 0) {
        val pr: res[*Placement, A.Error] = A.zallocate[Placement](alloc, sec_total::usize);
        if (sel pr.err) {
            free_scratch(alloc, nil, 0, nil, 0, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
            ret err[fail.Fail].err{fail.refused(pr.err)};
        }
        placements = pr.ok;
    }

    var sec_base: *u32               = nil;
    val br:       res[*u32, A.Error] = A.zallocate[u32](alloc, module_count::usize);
    if (sel br.err) {
        free_scratch(alloc, placements, sec_total, nil, 0, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret err[fail.Fail].err{fail.refused(br.err)};
    }
    sec_base = br.ok;

    val syb_r: res[*u32, A.Error] = A.zallocate[u32](alloc, module_count::usize);
    if (sel syb_r.err) {
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret err[fail.Fail].err{fail.refused(syb_r.err)};
    }
    sym_base = syb_r.ok;
    val fsb_r: err[fail.Fail] = fill_symbol_bases(modules, module_count, sym_base);
    if (sel fsb_r.err) {
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret fsb_r;
    }

    if (sym_total > 0) {
        val syo_r: res[*u32, A.Error] = A.zallocate[u32](alloc, sym_total::usize);
        if (sel syo_r.err) {
            free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
            ret err[fail.Fail].err{fail.refused(syo_r.err)};
        }
        sym_out = syo_r.ok;
    }

    var atom_r: err[fail.Fail];
    if (pre_atoms != nil) {
        atoms = @pre_atoms;
        init_atom_plan(pre_atoms);
        atom_r = fill_section_bases(modules, module_count, sec_base);
    }
    or {
        atom_r = build_atom_plan(s, modules, module_count, codegen_count, sec_base,
            sec_total, patching, roots, tgt.isa, ?atoms);
    }
    if (sel atom_r.err) {
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret atom_r;
    }

    val acc_r: err[fail.Fail] =
        accumulate_sections(s, modules, module_count, merged, debug_names, debug_count,
        placements, sec_base, ?strm, ?atoms, ?groups);
    if (sel acc_r.err) {
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret acc_r;
    }

    if (tgt.of.produces_image && mode == LINK_EXE) {
        val ei_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, tgt.os.entry_symbol);
        if (sel ei_r.err) {
            free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
            ret err[fail.Fail].err{fail.refused(ei_r.err)};
        }
        val reorder_r: err[fail.Fail] =
            reorder_flat_entry_first(modules, module_count, merged, placements, sec_base,
            ?atoms, ei_r.ok);
        if (sel reorder_r.err) {
            free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
            ret reorder_r;
        }
    }

    val overlap_r: err[fail.Fail] =
        validate_no_contribution_overlap(s, modules, module_count, sec_base, placements, sec_total);
    if (sel overlap_r.err) {
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret overlap_r;
    }

    val assign_vaddrs:  bool = (mode == LINK_EXE) || shared;
    var header_reserve: u64  = 0;
    if (assign_vaddrs) {
        header_reserve = header_reserve_bytes(tgt, position_independent, nil::*of.HeaderShape);
        val vaddr_r: err[fail.Fail] =
            assign_section_vaddrs(tgt, merged, header_reserve);
        if (sel vaddr_r.err) {
            free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
            ret vaddr_r;
        }
        finalize_placement_vaddrs(merged, placements, sec_total);
    }

    var sym_locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](alloc, map.hash_u32, map.eq_u32);

    val collect_r: err[fail.Fail] =
        collect_symbols(s, modules, module_count, placements, sec_base, ?sym_locs,
        assign_vaddrs, ?atoms);
    if (sel collect_r.err) {
        free_local_got_plan(alloc, ?local_got);
        map.dnit[intern.StrId, SymbolLoc](?sym_locs);
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret collect_r;
    }

    if (mode == LINK_EXE || shared) {
        val gp_r: err[fail.Fail] = build_local_got_plan(
            s, tgt.isa, modules, module_count, ?sym_locs, sec_base, ?atoms,
            merged, ?groups, ?local_got);
        if (sel gp_r.err) {
            free_local_got_plan(alloc, ?local_got);
            map.dnit[intern.StrId, SymbolLoc](?sym_locs);
            free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
            ret gp_r;
        }
        if (local_got.count > 0) {
            val got_vaddr_r: err[fail.Fail] =
                assign_section_vaddrs(tgt, merged, header_reserve);
            if (sel got_vaddr_r.err) {
                free_local_got_plan(alloc, ?local_got);
                map.dnit[intern.StrId, SymbolLoc](?sym_locs);
                free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
                ret got_vaddr_r;
            }
            finalize_placement_vaddrs(merged, placements, sec_total);
            finalize_local_got_vaddrs(merged, ?local_got);

            map.dnit[intern.StrId, SymbolLoc](?sym_locs);
            sym_locs = map.init[intern.StrId, SymbolLoc](alloc, map.hash_u32, map.eq_u32);
            val recollect: err[fail.Fail] = collect_symbols(
                s, modules, module_count, placements, sec_base, ?sym_locs,
                assign_vaddrs, ?atoms);
            if (sel recollect.err) {
                free_local_got_plan(alloc, ?local_got);
                map.dnit[intern.StrId, SymbolLoc](?sym_locs);
                free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
                ret recollect;
            }
        }
    }

    var dynamic: bool = (mode == LINK_EXE)
        && (dynlib_count > 0 || pie
        || has_unresolved_declared_imports(
        modules, module_count, ?sym_locs, sec_base, ?atoms));
    if (!dynamic && mode == LINK_EXE) {
        val unresolved_r: res[bool, fail.Fail] = has_unresolved_attributed_imports(
            s, modules, module_count, dynlibs, dynlib_count, ?sym_locs,
            tgt.of.import_address_prefix, sec_base, ?atoms);
        if (sel unresolved_r.err) {
            free_local_got_plan(alloc, ?local_got);
            map.dnit[intern.StrId, SymbolLoc](?sym_locs);
            free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
            ret err[fail.Fail].err{unresolved_r.err};
        }
        dynamic = unresolved_r.ok;
    }

    val no_loader: str = loaderless_request_message(s, tgt, mode, pie, dynamic);
    if (!str_empty(no_loader)) {
        free_local_got_plan(alloc, ?local_got);
        map.dnit[intern.StrId, SymbolLoc](?sym_locs);
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret err[fail.Fail].err{fail.message(no_loader)};
    }

    var out_img: of.ObjectImage;
    val img_r:   res[of.ObjectImage, fail.Fail] = obj.image_init(alloc, ?s.interner, image_name(modules, module_count));
    if (sel img_r.err) {
        free_local_got_plan(alloc, ?local_got);
        map.dnit[intern.StrId, SymbolLoc](?sym_locs);
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret err[fail.Fail].err{img_r.err};
    }
    out_img = img_r.ok;

    val mto_r: res[*u32, A.Error] = A.zallocate[u32](alloc, merged_count::usize);
    if (sel mto_r.err) {
        obj.dnit(?out_img);
        free_local_got_plan(alloc, ?local_got);
        map.dnit[intern.StrId, SymbolLoc](?sym_locs);
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret err[fail.Fail].err{fail.refused(mto_r.err)};
    }
    merged_to_out = mto_r.ok;

    val build_r: err[fail.Fail] =
        build_merged_image(s, ?out_img, modules, module_count, merged, merged_count,
        placements, sec_base, merged_to_out, sym_base, sym_out, ?strm, ?atoms);
    if (sel build_r.err) {
        obj.dnit(?out_img);
        free_local_got_plan(alloc, ?local_got);
        map.dnit[intern.StrId, SymbolLoc](?sym_locs);
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret build_r;
    }

    val built_valid: err[fail.Fail] = of.validate_owned_object(?out_img);
    if (sel built_valid.err) {
        val reason: str = fail.describe(built_valid.err);
        obj.dnit(?out_img);
        free_local_got_plan(alloc, ?local_got);
        map.dnit[intern.StrId, SymbolLoc](?sym_locs);
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret err[fail.Fail].err{fail.message(reason)};
    }

    var dyn: DynState;
    init_dynstate(?dyn);
    dyn.info.pie = position_independent;
    if (dynamic) {
        val dr: err[fail.Fail] =
            build_dynamic_info(s, tgt, ?dyn, modules, module_count, ?sym_locs,
            dynlibs, dynlib_count, sec_base, ?atoms);
        if (sel dr.err) {
            free_dynstate(alloc, ?dyn);
            obj.dnit(?out_img);
            free_local_got_plan(alloc, ?local_got);
            map.dnit[intern.StrId, SymbolLoc](?sym_locs);
            free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
            ret dr;
        }
    }

    if (assign_vaddrs) {
        var shape: of.HeaderShape;
        measure_header_shape(s, ?out_img, merged, ?groups, ?dyn, position_independent, ?shape);
        val want: u64 = header_reserve_bytes(tgt, position_independent, ?shape);
        if (want > header_reserve) {
            header_reserve = want;
            val header_vaddr_r: err[fail.Fail] =
                assign_section_vaddrs(tgt, merged, header_reserve);
            if (sel header_vaddr_r.err) {
                free_dynstate(alloc, ?dyn);
                obj.dnit(?out_img);
                free_local_got_plan(alloc, ?local_got);
                map.dnit[intern.StrId, SymbolLoc](?sym_locs);
                free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
                ret header_vaddr_r;
            }
            finalize_placement_vaddrs(merged, placements, sec_total);
            if (local_got.count > 0) { finalize_local_got_vaddrs(merged, ?local_got); }

            map.dnit[intern.StrId, SymbolLoc](?sym_locs);
            sym_locs = map.init[intern.StrId, SymbolLoc](alloc, map.hash_u32, map.eq_u32);
            val recollect: err[fail.Fail] = collect_symbols(
                s, modules, module_count, placements, sec_base, ?sym_locs,
                assign_vaddrs, ?atoms);
            if (sel recollect.err) {
                free_dynstate(alloc, ?dyn);
                obj.dnit(?out_img);
                free_local_got_plan(alloc, ?local_got);
                map.dnit[intern.StrId, SymbolLoc](?sym_locs);
                free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
                ret recollect;
            }
        }
    }

    val patch_r: err[fail.Fail] =
        patch_relocations(s, ?out_img, modules, module_count, codegen_count,
        placements, sec_base, merged_to_out, ?sym_locs,
        ?dyn, ?local_got, ?strm, tgt.of,
        tgt.isa, os_base_addr(tgt), ?atoms);
    if (sel patch_r.err) {
        free_dynstate(alloc, ?dyn);
        obj.dnit(?out_img);
        free_local_got_plan(alloc, ?local_got);
        map.dnit[intern.StrId, SymbolLoc](?sym_locs);
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret patch_r;
    }

    var emit_r: err[fail.Fail];
    if (shared) {
        emit_r = emit_shared_object(s, tgt, ?out_img, merged, ?groups, modules, module_count, ?sym_locs, ?dyn, roots.surface, destination, image_options);
    }
    or (dynamic) {
        emit_r = emit_executable(s, tgt, ?out_img, merged, ?groups, ?sym_locs, ?dyn, roots.surface, destination, name, image_options, capture);
    }
    or {
        emit_r = emit_executable(s, tgt, ?out_img, merged, ?groups, ?sym_locs, nil::*DynState, roots.surface, destination, name, image_options, capture);
    }

    free_dynstate(alloc, ?dyn);
    obj.dnit(?out_img);
    free_local_got_plan(alloc, ?local_got);
    map.dnit[intern.StrId, SymbolLoc](?sym_locs);
    free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);

    if (sel emit_r.err) {
        ret emit_r;
    }
    ret err[fail.Fail].ok{};
}

test "mach.lang.be.linker.image_attributes:frees_intermediate_accumulators" {
    var page_alloc: A.Allocator;
    page.make(?page_alloc);

    var tracker:     GmTracker;
    val res_entries: res[*GmTrackEntry, A.Error] = A.allocate[GmTrackEntry](?page_alloc, 64::usize);
    if (sel res_entries.err) { ret 1; }
    tracker.entries  = res_entries.ok;
    tracker.cap      = 64;
    tracker.count    = 0;
    tracker.live     = 0;
    tracker.mismatch = false;

    var tp:    *GmTracker = ?tracker;
    var alloc: A.Allocator;
    alloc.ctx           = tp::ptr;
    alloc.fn_allocate   = gm_track_allocate;
    alloc.fn_reallocate = gm_track_reallocate;
    alloc.fn_deallocate = gm_track_deallocate;

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_1682: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1682.err) {
        session.dnit(?s);
        ret 1;
    }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "riscv64", "linux", "lp64d");
    if (sel tr.err) {
        session.dnit(?s);
        ret 1;
    }
    var tgt: target.Target = tr.ok;

    val ta: res[target.Target, fail.Fail] = target.select(?reg, "rv64imafd", "linux", "lp64d");
    val tb: res[target.Target, fail.Fail] = target.select(?reg, "rv64imafdc", "linux", "lp64d");
    if (sel ta.err) {
        session.dnit(?s);
        ret 1;
    }
    if (sel tb.err) {
        session.dnit(?s);
        ret 1;
    }
    var target_a: target.Target       = ta.ok;
    var target_b: target.Target       = tb.ok;
    var len_a:    u32                 = 0;
    val ba:       res[*u8, fail.Fail] = isa.build_attributes(target_a.isa, ?target_a.model, ?alloc, target_a.abi.float_arg_bits, false, ?len_a);
    if (sel ba.err) {
        session.dnit(?s);
        ret 1;
    }
    var len_b: u32                 = 0;
    val bb:    res[*u8, fail.Fail] = isa.build_attributes(target_b.isa, ?target_b.model, ?alloc, target_b.abi.float_arg_bits, true, ?len_b);
    if (sel bb.err) {
        session.dnit(?s);
        ret 1;
    }

    var mods: [2]of.ObjectImage;
    mods[0]                = lt_image(?s, lt_name(?s, "a"), nil::*of.Section, 0, nil::*of.Symbol, 0, nil::*of.Relocation, 0);
    mods[0].attributes     = ba.ok;
    mods[0].attributes_len = len_a;
    mods[1]                = lt_image(?s, lt_name(?s, "b"), nil::*of.Section, 0, nil::*of.Symbol, 0, nil::*of.Relocation, 0);
    mods[1].attributes     = bb.ok;
    mods[1].attributes_len = len_b;

    var out_len: u32                 = 0;
    val ar:      res[*u8, fail.Fail] = image_attributes(?s, ?tgt, ?mods[0], 2, ?out_len);
    if (sel ar.err) {
        session.dnit(?s);
        ret 1;
    }
    val merged: *u8 = ar.ok;

    A.deallocate[u8](?alloc, mods[0].attributes, mods[0].attributes_len::usize);
    A.deallocate[u8](?alloc, mods[1].attributes, mods[1].attributes_len::usize);
    if (merged != nil && out_len > 0) { A.deallocate[u8](?alloc, merged, out_len::usize); }

    session.dnit(?s);

    if (tracker.mismatch)  { ret 1; }
    if (tracker.live != 0) { ret 1; }

    A.deallocate[GmTrackEntry](?page_alloc, tracker.entries, 64::usize);
    ret 0;
}

fun emit_executable(s: *session.Session, tgt: *target.Target, out_img: *of.ObjectImage,
    merged: *MergedSection, groups: *SectionGroups,
    sym_locs: *map.Map[intern.StrId, SymbolLoc],
    dyn: *DynState, surface: *ExportSurface, destination: str, name: *u8,
    image_options: of.ImageOptions, capture: *LinkedImage) err[fail.Fail] {
    if (capture != nil && tgt.of.emit_exec_image == nil) {
        ret err[fail.Fail].err{fail.message("link: this object format cannot hand back a linked image")};
    }
    if (capture == nil && dyn == nil && tgt.of.emit_exec == nil) {
        ret err[fail.Fail].err{fail.message("link: object format cannot write executables")};
    }
    if (dyn != nil && tgt.of.emit_dyn_exec == nil) {
        ret err[fail.Fail].err{fail.message("link: object format cannot write dynamically-linked executables")};
    }
    if (tgt.os == nil) {
        ret err[fail.Fail].err{fail.message("link: target has no operating-system vtable")};
    }

    val alloc: *A.Allocator = s.alloc;

    val er: res[u64, fail.Fail] = entry_vaddr(s, tgt, sym_locs);
    if (sel er.err) { ret err[fail.Fail].err{er.err}; }
    val entry: u64 = er.ok;

    var seg_count: u32                             = 0;
    val sr:        res[*of.LoadSegment, fail.Fail] = build_load_segments(alloc, out_img, merged, groups, ?seg_count);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val segs: *of.LoadSegment = sr.ok;

    var func_count: u32                              = 0;
    val fr:         res[*of.ExecFunction, fail.Fail] = build_exec_functions(alloc, out_img, segs, seg_count, ?func_count);
    if (sel fr.err) {
        free_load_segments(alloc, segs, seg_count);
        ret err[fail.Fail].err{fr.err};
    }
    val funcs: *of.ExecFunction = fr.ok;

    var exc_count: u32                         = 0;
    val xr:        res[*of.Section, fail.Fail] = collect_exception_sections(alloc, out_img, ?exc_count);
    if (sel xr.err) {
        if (funcs != nil && func_count > 0) { A.deallocate[of.ExecFunction](alloc, funcs, func_count::usize); }
        free_load_segments(alloc, segs, seg_count);
        ret err[fail.Fail].err{xr.err};
    }
    val exc: *of.Section = xr.ok;

    var dbg_count: u32                         = 0;
    val dr:        res[*of.Section, fail.Fail] = collect_debug_sections(alloc, out_img, ?dbg_count);
    if (sel dr.err) {
        if (exc != nil && exc_count > 0)    { A.deallocate[of.Section](alloc, exc, exc_count::usize); }
        if (funcs != nil && func_count > 0) { A.deallocate[of.ExecFunction](alloc, funcs, func_count::usize); }
        free_load_segments(alloc, segs, seg_count);
        ret err[fail.Fail].err{dr.err};
    }
    val dbg: *of.Section = dr.ok;

    var emit_r: err[fail.Fail] = err[fail.Fail].ok{};

    var symtab_count: u32                             = 0;
    val ser:          res[*of.SymtabEntry, fail.Fail] = build_symtab_entries(alloc, out_img, segs, seg_count, surface, ?symtab_count);
    if (sel ser.err) {
        if (dbg != nil && dbg_count > 0)    { A.deallocate[of.Section](alloc, dbg, dbg_count::usize); }
        if (exc != nil && exc_count > 0)    { A.deallocate[of.Section](alloc, exc, exc_count::usize); }
        if (funcs != nil && func_count > 0) { A.deallocate[of.ExecFunction](alloc, funcs, func_count::usize); }
        free_load_segments(alloc, segs, seg_count);
        ret err[fail.Fail].err{ser.err};
    }
    val symtab: *of.SymtabEntry = ser.ok;

    if (capture != nil) {
        if (tgt.of.emit_exec_image == nil) {
            emit_r = err[fail.Fail].err{fail.message("link: this object format cannot hand back a linked image")};
        }
        or {
            var cap_base: u64                 = 0;
            var cap_size: usize               = 0;
            val cb:       res[*u8, fail.Fail] =
                tgt.of.emit_exec_image(alloc, segs, seg_count, entry, ?cap_base, ?cap_size);
            if (sel cb.err) { emit_r = err[fail.Fail].err{cb.err}; }
            or (sel cb.ok) {
                capture.bytes        = cb.ok;
                capture.len          = cap_size;
                capture.base         = cap_base;
                capture.symbols      = symtab;
                capture.symbol_count = symtab_count;
            }
        }
    }
    or (dyn == nil) {
        emit_r = tgt.of.emit_exec(alloc, ?s.interner, ?tgt.object, segs, seg_count,
            os_page_size(tgt), os_base_addr(tgt), entry,
            funcs, func_count,
            exc, exc_count, dbg, dbg_count,
            symtab, symtab_count, destination, name, image_options);
    }
    or {
        emit_r = tgt.of.emit_dyn_exec(alloc, ?s.interner, ?tgt.object, segs, seg_count,
            os_page_size(tgt), os_base_addr(tgt), entry,
            funcs, func_count, ?dyn.info, dyn.fixups, dyn.fixup_count,
            exc, exc_count, dbg, dbg_count,
            symtab, symtab_count, destination, name, image_options);
    }

    val kept: bool = capture != nil && sel emit_r.ok;
    if (!kept && symtab != nil && symtab_count > 0) { A.deallocate[of.SymtabEntry](alloc, symtab, symtab_count::usize); }
    if (dbg != nil && dbg_count > 0)                { A.deallocate[of.Section](alloc, dbg, dbg_count::usize); }
    if (exc != nil && exc_count > 0)                { A.deallocate[of.Section](alloc, exc, exc_count::usize); }
    if (funcs != nil && func_count > 0) {
        A.deallocate[of.ExecFunction](alloc, funcs, func_count::usize);
    }
    free_load_segments(alloc, segs, seg_count);

    if (sel emit_r.err) {
        ret emit_r;
    }
    ret err[fail.Fail].ok{};
}

fun emit_shared_object(s: *session.Session, tgt: *target.Target, out_img: *of.ObjectImage,
    merged: *MergedSection, groups: *SectionGroups,
    modules: *of.ObjectImage, module_count: u32,
    sym_locs: *map.Map[intern.StrId, SymbolLoc], dyn: *DynState, surface: *ExportSurface,
    destination: str, image_options: of.ImageOptions) err[fail.Fail] {
    if (tgt.of.emit_shared == nil) {
        ret err[fail.Fail].err{fail.message("link: object format cannot write shared libraries")};
    }
    if (tgt.os == nil) {
        ret err[fail.Fail].err{fail.message("link: target has no operating-system vtable")};
    }

    val alloc: *A.Allocator = s.alloc;

    var seg_count: u32                             = 0;
    val sr:        res[*of.LoadSegment, fail.Fail] = build_load_segments(alloc, out_img, merged, groups, ?seg_count);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val segs: *of.LoadSegment = sr.ok;

    var export_count: u32                           = 0;
    val xr:           res[*of.ExportSym, fail.Fail] = collect_exports(s, modules, module_count, sym_locs, surface, ?export_count);
    if (sel xr.err) {
        free_load_segments(alloc, segs, seg_count);
        ret err[fail.Fail].err{xr.err};
    }
    val exports: *of.ExportSym = xr.ok;

    var dbg_count: u32                         = 0;
    val dr:        res[*of.Section, fail.Fail] = collect_debug_sections(alloc, out_img, ?dbg_count);
    if (sel dr.err) {
        if (exports != nil && export_count > 0) { A.deallocate[of.ExportSym](alloc, exports, export_count::usize); }
        free_load_segments(alloc, segs, seg_count);
        ret err[fail.Fail].err{dr.err};
    }
    val dbg: *of.Section = dr.ok;

    var symtab_count: u32                             = 0;
    val ser:          res[*of.SymtabEntry, fail.Fail] = build_symtab_entries(alloc, out_img, segs, seg_count, surface, ?symtab_count);
    if (sel ser.err) {
        if (dbg != nil && dbg_count > 0)        { A.deallocate[of.Section](alloc, dbg, dbg_count::usize); }
        if (exports != nil && export_count > 0) { A.deallocate[of.ExportSym](alloc, exports, export_count::usize); }
        free_load_segments(alloc, segs, seg_count);
        ret err[fail.Fail].err{ser.err};
    }
    val symtab: *of.SymtabEntry = ser.ok;

    val emit_r: err[fail.Fail] =
        tgt.of.emit_shared(alloc, ?s.interner, ?tgt.object, segs, seg_count, os_page_size(tgt),
        exports, export_count, ?dyn.info, dbg, dbg_count,
        symtab, symtab_count, destination, image_options);

    if (symtab != nil && symtab_count > 0)  { A.deallocate[of.SymtabEntry](alloc, symtab, symtab_count::usize); }
    if (dbg != nil && dbg_count > 0)        { A.deallocate[of.Section](alloc, dbg, dbg_count::usize); }
    if (exports != nil && export_count > 0) { A.deallocate[of.ExportSym](alloc, exports, export_count::usize); }
    free_load_segments(alloc, segs, seg_count);

    ret emit_r;
}

fun combined_image_count(image_count: u32, external_count: u32) res[u32, fail.Fail] {
    val total_r: res[u32, layout.CheckCause] = add_u32_counts[ImageCountUnit](image_count, external_count);
    if (sel total_r.err) {
        ret res[u32, fail.Fail].err{fail.message("linker: combined input object count overflow")};
    }
    ret res[u32, fail.Fail].ok{total_r.ok};
}

fun image_name(modules: *of.ObjectImage, module_count: u32) intern.StrId {
    if (module_count == 0) { ret intern.STR_NIL; }
    ret modules[0].name;
}

fun float_abi_phrase(tgt: *target.Target, abi_bits: u32) str {
    if (abi_bits == isa.machine_flags(tgt.isa, 0, false))  { ret "soft-float"; }
    if (abi_bits == isa.machine_flags(tgt.isa, 32, false)) { ret "single-precision hard-float"; }
    if (abi_bits == isa.machine_flags(tgt.isa, 64, false)) { ret "double-precision hard-float"; }
    ret "an unrecognized float";
}

fun module_display_name(s: *session.Session, img: *of.ObjectImage) str {
    val nm: opt[str] = intern.lookup(?s.interner, img.name);
    if (sel nm.some) { ret nm.some; }
    ret "<input>";
}

fun machine_flags_mismatch_message(s: *session.Session, tgt: *target.Target,
    img: *of.ObjectImage, got: u32, expected: u32) str {
    val tail: str = join3(s, " ABI, but this link targets '", tgt.abi.name,
        "', so every float argument crossing that boundary would read back as garbage",
        " ABI the target does not use");
    val head: str = join3(s, "object '", module_display_name(s, img), "' was built for a ",
        "an input object was built for a ");
    ret join3(s, head, float_abi_phrase(tgt, got), tail,
        "input object float ABI does not match the target convention");
}

fun free_scratch(alloc: *A.Allocator, placements: *Placement, sec_total: u32,
    sec_base: *u32, module_count: u32,
    merged: *MergedSection, merged_count: u32,
    debug_names: *intern.StrId, debug_count: u32,
    merged_to_out: *u32, sym_base: *u32, sym_out: *u32, sym_total: u32,
    strm: *StrMerge, atoms: *AtomPlan, groups: *SectionGroups) {
    free_section_groups(alloc, groups);
    free_placements(alloc, placements, sec_total);
    if (sec_base != nil && module_count > 0) {
        A.deallocate[u32](alloc, sec_base, module_count::usize);
    }
    if (sym_base != nil && module_count > 0) {
        A.deallocate[u32](alloc, sym_base, module_count::usize);
    }
    if (sym_out != nil && sym_total > 0) {
        A.deallocate[u32](alloc, sym_out, sym_total::usize);
    }
    if (merged != nil && merged_count > 0) {
        A.deallocate[MergedSection](alloc, merged, merged_count::usize);
    }
    if (debug_names != nil && debug_count > 0) {
        A.deallocate[intern.StrId](alloc, debug_names, debug_count::usize);
    }
    if (merged_to_out != nil && merged_count > 0) {
        A.deallocate[u32](alloc, merged_to_out, merged_count::usize);
    }
    free_str_merge(strm);
    free_atom_plan(alloc, atoms);
}

test "mach.lang.be.linker.link_mode:rejects_invalid_before_input_work" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_7280: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_7280.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt:     target.Target = tr.ok;
    val invalid: LinkMode      = 255::LinkMode;
    if (link_mode_valid(invalid) || !link_mode_valid(LINK_EXE)
        || !link_mode_valid(LINK_RELOCATABLE) || !link_mode_valid(LINK_SHARED)) { ret 1; }

    var paths: [1]*u8;
    paths[0] = "/mach-link-mode-must-not-touch-object-io"::*u8;
    val from_paths: err[fail.Fail] = link(
        ?s, ?tgt, ?paths[0], 1, nil::*of.DynLib, 0, nil, "invalid"::*u8,
        invalid, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel from_paths.ok)                                                 { ret 1; }
    if (!str_contains(fail.describe(from_paths.err), "invalid link mode")) { ret 1; }

    val from_images: err[fail.Fail] = link_images(
        ?s, ?tgt, nil::*of.ObjectImage, 0, nil::*of.DynLib, 0,
        nil, "invalid"::*u8, invalid, false,
        of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel from_images.ok)                                                 { ret 1; }
    if (!str_contains(fail.describe(from_images.err), "invalid link mode")) { ret 1; }

    val from_mixed: err[fail.Fail] = link_mixed(
        ?s, ?tgt, nil::*of.ObjectImage, 0, nil::**u8, 0, nil::*of.DynLib, 0,
        nil, "invalid"::*u8, invalid, false,
        of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel from_mixed.ok)                                                 { ret 1; }
    if (!str_contains(fail.describe(from_mixed.err), "invalid link mode")) { ret 1; }
    ret 0;
}

fun lt_marker_live_value(bytes: *u8, len: usize, marker: u8, value: *u64) bool {
    var at: usize = 0;
    for (at + 16 <= len) {
        var i: usize = 0;
        for (i < 8 && bytes[at + i] == marker) { i = i + 1; }
        if (i == 8) {
            var found: u64 = 0;
            i = 0;
            for (i < 8) {
                found = found | (bytes[at + 8 + i]::u64 << (i * 8));
                i     = i + 1;
            }
            if (found != 0 && found != DWARF_TOMBSTONE_ADDRESS) {
                @value = found;
                ret true;
            }
        }
        at = at + 1;
    }
    ret false;
}

fun lt_is_mach_shaped(modules: *of.ObjectImage, m: u32) bool {
    ret module_debug_is_linkable(modules, m);
}

fun lt_marker_present(bytes: *u8, len: usize, marker: u8) bool {
    var at: usize = 0;
    for (at + 8 <= len) {
        var i: usize = 0;
        for (i < 8 && bytes[at + i] == marker) { i = i + 1; }
        if (i == 8) { ret true; }
        at = at + 1;
    }
    ret false;
}

fun lt_foreign_dwarf_link(s: *session.Session, tgt: *target.Target,
    out_self: *bool, out_foreign: *bool) bool {
    val alloc:   *A.Allocator = s.alloc;
    val text:    intern.StrId = lt_name(s, ".text");
    val info:    intern.StrId = lt_name(s, ".debug_info");
    val line:    intern.StrId = lt_name(s, ".debug_line");
    val entry:   intern.StrId = lt_name(s, tgt.os.entry_symbol);
    val ffn:     intern.StrId = lt_name(s, "foreign_fn");
    val lanchor: intern.StrId = lt_name(s, "selfrel.debug_line");
    if (text == intern.STR_NIL || info == intern.STR_NIL || line == intern.STR_NIL
        || entry == intern.STR_NIL || ffn == intern.STR_NIL || lanchor == intern.STR_NIL) {
        ret false;
    }

    var self_text:    [16]u8;
    var foreign_text: [16]u8;
    var self_info:    [24]u8;
    var foreign_info: [24]u8;
    var self_line:    [8]u8;
    var foreign_line: [8]u8;
    var i:            u32 = 0;
    for (i < 16) {
        self_text[i]    = (0x10 + i)::u8;
        foreign_text[i] = (0x30 + i)::u8;
        i               = i + 1;
    }
    i = 0;
    for (i < 24) {
        self_info[i]    = 0;
        foreign_info[i] = 0;
        i               = i + 1;
    }
    i = 0;
    for (i < 8) {
        self_info[i]    = 0xAA;
        foreign_info[i] = 0xBB;
        self_line[i]    = 0x5A;
        foreign_line[i] = 0x5B;
        i               = i + 1;
    }

    var self_secs: [3]of.Section;
    self_secs[0].name  = text;
    self_secs[0].kind  = of.SK_TEXT;
    self_secs[0].bytes = ?self_text[0];
    self_secs[0].len   = 16;
    self_secs[0].align = 16;
    self_secs[1].name  = info;
    self_secs[1].kind  = of.SK_DEBUG;
    self_secs[1].bytes = ?self_info[0];
    self_secs[1].len   = 24;
    self_secs[1].align = 1;
    self_secs[2].name  = line;
    self_secs[2].kind  = of.SK_DEBUG;
    self_secs[2].bytes = ?self_line[0];
    self_secs[2].len   = 8;
    self_secs[2].align = 1;

    var foreign_secs: [3]of.Section;
    foreign_secs[0].name  = text;
    foreign_secs[0].kind  = of.SK_TEXT;
    foreign_secs[0].bytes = ?foreign_text[0];
    foreign_secs[0].len   = 16;
    foreign_secs[0].align = 16;
    foreign_secs[1].name  = info;
    foreign_secs[1].kind  = of.SK_DEBUG;
    foreign_secs[1].bytes = ?foreign_info[0];
    foreign_secs[1].len   = 24;
    foreign_secs[1].align = 1;
    foreign_secs[2].name  = line;
    foreign_secs[2].kind  = of.SK_DEBUG;
    foreign_secs[2].bytes = ?foreign_line[0];
    foreign_secs[2].len   = 8;
    foreign_secs[2].align = 1;

    val fn_flags:  u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var self_syms: [2]of.Symbol;
    self_syms[0].name    = entry;
    self_syms[0].section = of.section_id(0);
    self_syms[0].offset  = 0;
    self_syms[0].size    = 16;
    self_syms[0].flags   = fn_flags;
    self_syms[1].name    = lanchor;
    self_syms[1].section = of.section_id(2);
    self_syms[1].offset  = 0;
    self_syms[1].size    = 0;
    self_syms[1].flags   = of.SYM_OBJ_FLAG_GLOBAL;

    var foreign_syms: [1]of.Symbol;
    foreign_syms[0].name    = ffn;
    foreign_syms[0].section = of.section_id(0);
    foreign_syms[0].offset  = 0;
    foreign_syms[0].size    = 16;
    foreign_syms[0].flags   = fn_flags;

    var self_relocs: [2]of.Relocation;
    self_relocs[0].section = of.section_id(1);
    self_relocs[0].offset  = 8;
    self_relocs[0].kind    = of.RK_ABS64;
    self_relocs[0].sym     = 0;
    self_relocs[0].addend  = 0;
    self_relocs[1].section = of.section_id(1);
    self_relocs[1].offset  = 16;
    self_relocs[1].kind    = of.RK_ABS32;
    self_relocs[1].sym     = 1;
    self_relocs[1].addend  = 0;

    var foreign_relocs: [1]of.Relocation;
    foreign_relocs[0].section = of.section_id(1);
    foreign_relocs[0].offset  = 8;
    foreign_relocs[0].kind    = of.RK_ABS64;
    foreign_relocs[0].sym     = 0;
    foreign_relocs[0].addend  = 0;

    var modules: [2]of.ObjectImage;
    modules[0] = lt_image(s, lt_name(s, "selfrel.o"), ?self_secs[0], 3,
        ?self_syms[0], 2, ?self_relocs[0], 2);
    modules[1] = lt_image(s, lt_name(s, "foreign.o"), ?foreign_secs[0], 3,
        ?foreign_syms[0], 1, ?foreign_relocs[0], 1);

    val atf_r: res[fixture.Output, outcome.Fail] = fixture.create(alloc, "foreign_dwarf_self");
    if (sel atf_r.err) { ret false; }
    var atf: fixture.Output = atf_r.ok;
    fin { fixture.dnit(?atf); }
    val btf_r: res[fixture.Output, outcome.Fail] = fixture.create(alloc, "foreign_dwarf_foreign");
    if (sel btf_r.err) { ret false; }
    var btf: fixture.Output = btf_r.ok;
    fin { fixture.dnit(?btf); }
    val etf_r: res[fixture.Output, outcome.Fail] = fixture.create(alloc, "foreign_dwarf_exe");
    if (sel etf_r.err) {
        ret false;
    }
    var etf: fixture.Output = etf_r.ok;
    fin { fixture.dnit(?etf); }
    val apath: str = fixture.path(?atf);
    val bpath: str = fixture.path(?btf);
    val epath: str = fixture.path(?etf);

    var ok:       bool           = true;
    val object_r: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?modules[0], apath);
    if (sel object_r.err) { ok = false; }
    if (ok) {
        val object_r: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?modules[1], bpath);
        if (sel object_r.err) { ok = false; }
    }
    if (ok) {
        var paths: [2]*u8;
        paths[0] = apath::*u8;
        paths[1] = bpath::*u8;
        val lr: err[fail.Fail] = link(s, tgt, ?paths[0], 2,
            nil::*of.DynLib, 0, epath, "foreign_dwarf"::*u8,
            LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
        if (sel lr.err) { ok = false; }
    }
    if (ok) {
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, epath);
        if (sel rr.ok) {
            var out: Vector[u8] = rr.ok;
            @out_self    = lt_marker_present(out.data, out.len, 0xAA);
            @out_foreign = lt_marker_present(out.data, out.len, 0xBB);
            vector.dnit[u8](?out);
        }
        if (sel rr.err) { ok = false; }
    }

    ret ok;
}

fun lt_marked_u64(bytes: *u8, len: usize, marker: u8, value: *u64) bool {
    var at: usize = 0;
    for (at + 16 <= len) {
        var i: usize = 0;
        for (i < 8 && bytes[at + i] == marker) { i = i + 1; }
        if (i == 8) {
            @value = bin.read_u64_le(bytes, at + 8);
            ret true;
        }
        at = at + 1;
    }
    ret false;
}

test "mach.lang.be.linker.debug_merge:collected_definitions_are_tombstoned" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val registered: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel registered.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var text: [24]u8;
    var info: [56]u8;
    var line: [8]u8;
    var i:    u32 = 0;
    for (i < 8) {
        info[i]      = 0xA1;
        info[16 + i] = 0xA2;
        info[32 + i] = 0xA3;
        i            = i + 1;
    }
    var secs: [3]of.Section;
    secs[0].name  = lt_name(?s, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text[0];
    secs[0].len   = 24;
    secs[0].align = 16;
    secs[1].name  = lt_name(?s, ".debug_info");
    secs[1].kind  = of.SK_DEBUG;
    secs[1].bytes = ?info[0];
    secs[1].len   = 56;
    secs[1].align = 1;
    secs[2].name  = lt_name(?s, ".debug_line");
    secs[2].kind  = of.SK_DEBUG;
    secs[2].bytes = ?line[0];
    secs[2].len   = 8;
    secs[2].align = 1;

    val fn_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var syms:     [4]of.Symbol;
    syms[0].name    = lt_name(?s, tgt.os.entry_symbol);
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 8;
    syms[0].flags   = fn_flags;
    syms[1].name    = lt_name(?s, "collected_global");
    syms[1].section = of.section_id(0);
    syms[1].offset  = 8;
    syms[1].size    = 8;
    syms[1].flags   = fn_flags;
    syms[2].name    = lt_name(?s, "collected_local");
    syms[2].section = of.section_id(0);
    syms[2].offset  = 16;
    syms[2].size    = 8;
    syms[2].flags   = of.SYM_OBJ_FLAG_FUNCTION;
    syms[3].name    = lt_name(?s, "tomb.debug_line");
    syms[3].section = of.section_id(2);
    syms[3].offset  = 0;
    syms[3].size    = 0;
    syms[3].flags   = of.SYM_OBJ_FLAG_GLOBAL;

    var relocs: [4]of.Relocation;
    i = 0;
    for (i < 3) {
        relocs[i].section = of.section_id(1);
        relocs[i].offset  = 8 + i * 16;
        relocs[i].kind    = of.RK_ABS64;
        relocs[i].sym     = i;
        relocs[i].addend  = 0;
        relocs[i].sym2    = of.SYMBOL_NONE;
        i                 = i + 1;
    }
    relocs[3].section = of.section_id(1);
    relocs[3].offset  = 48;
    relocs[3].kind    = of.RK_ABS32;
    relocs[3].sym     = 3;
    relocs[3].addend  = 0;
    relocs[3].sym2    = of.SYMBOL_NONE;

    var mods: [1]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "tomb.o"), ?secs[0], 3, ?syms[0], 4, ?relocs[0], 4);

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "gc_tombstones");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val lr: err[fail.Fail] = link_modules_nocapture(?s, ?tgt, ?mods[0], 1, 1, nil::*of.DynLib, 0,
        fixture.path(?tf), "gc_tombstones"::*u8, LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel lr.err) { ret 2; }
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, fixture.path(?tf));
    if (sel rr.err) { ret 3; }
    var out: Vector[u8] = rr.ok;
    fin { vector.dnit[u8](?out); }

    var live:    u64 = 0;
    var global:  u64 = 0;
    var private: u64 = 0;
    if (!lt_marked_u64(out.data, out.len, 0xA1, ?live)
        || !lt_marked_u64(out.data, out.len, 0xA2, ?global)
        || !lt_marked_u64(out.data, out.len, 0xA3, ?private)) { ret 4; }
    if (live == 0 || live == DWARF_TOMBSTONE_ADDRESS) { ret 5; }
    if (global != DWARF_TOMBSTONE_ADDRESS)            { ret 6; }
    if (private != DWARF_TOMBSTONE_ADDRESS)           { ret 7; }
    ret 0;
}

test "mach.lang.be.linker.debug_merge:foreign_dwarf_left_out" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_7552: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_7552.err) { ret 1; }
    val er: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    val mr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "darwin", "sysv64");
    if (sel er.err) { ret 1; }
    if (sel mr.err) { ret 1; }
    var elf_tgt:   target.Target = er.ok;
    var macho_tgt: target.Target = mr.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var code:          i32  = 0;
    var elf_self:      bool = false;
    var elf_foreign:   bool = true;
    var macho_self:    bool = false;
    var macho_foreign: bool = true;
    if (!lt_foreign_dwarf_link(?s, ?elf_tgt, ?elf_self, ?elf_foreign))       { code = 1; }
    if (!lt_foreign_dwarf_link(?s, ?macho_tgt, ?macho_self, ?macho_foreign)) { code = 1; }
    session.dnit(?s);

    if (!elf_self || elf_foreign)     { code = 1; }
    if (!macho_self || macho_foreign) { code = 1; }
    ret code;
}

fun lt_marker_tombstoned(bytes: *u8, len: usize, marker: u8) bool {
    var at: usize = 0;
    for (at + 16 <= len) {
        var i: usize = 0;
        for (i < 8 && bytes[at + i] == marker) { i = i + 1; }
        if (i == 8) {
            i = 0;
            for (i < 8 && bytes[at + 8 + i] == 0xFF) { i = i + 1; }
            if (i == 8) { ret true; }
        }
        at = at + 1;
    }
    ret false;
}

fun lt_parsed_weak_dwarf_target(s: *session.Session, tgt: *target.Target) bool {
    val alloc:       *A.Allocator = s.alloc;
    val text:        intern.StrId = lt_name(s, ".text");
    val dup:         intern.StrId = lt_name(s, "parsed_weak");
    val entry:       intern.StrId = lt_name(s, tgt.os.entry_symbol);
    var debug_names: [4]intern.StrId;
    debug_names[0] = lt_name(s, ".debug_info");
    debug_names[1] = lt_name(s, ".debug_line");
    debug_names[2] = lt_name(s, ".debug_loclists");
    debug_names[3] = lt_name(s, ".debug_rnglists");
    if (text == intern.STR_NIL || dup == intern.STR_NIL || entry == intern.STR_NIL) { ret false; }

    var winner_text:  [16]u8;
    var loser_text:   [8]u8;
    var winner_debug: [4][40]u8;
    var loser_debug:  [4][40]u8;
    var d:            u32 = 0;
    for (d < 4) {
        if (debug_names[d] == intern.STR_NIL) { ret false; }
        var i: u32 = 0;
        for (i < 40) {
            winner_debug[d][i] = 0;
            loser_debug[d][i]  = 0;
            i                  = i + 1;
        }
        i = 0;
        for (i < 8) {
            winner_debug[d][i]      = (0xA0 + d)::u8;
            loser_debug[d][i]       = (0xD0 + d)::u8;
            winner_debug[d][16 + i] = (0xB0 + d)::u8;
            loser_debug[d][16 + i]  = (0xE0 + d)::u8;
            i                       = i + 1;
        }
        d = d + 1;
    }

    var winner_secs: [5]of.Section;
    var loser_secs:  [5]of.Section;
    winner_secs[0].name  = text;
    winner_secs[0].kind  = of.SK_TEXT;
    winner_secs[0].bytes = ?winner_text[0];
    winner_secs[0].len   = 16;
    winner_secs[0].align = 16;
    loser_secs[0].name   = text;
    loser_secs[0].kind   = of.SK_TEXT;
    loser_secs[0].bytes  = ?loser_text[0];
    loser_secs[0].len    = 8;
    loser_secs[0].align  = 16;
    d                    = 0;
    for (d < 4) {
        winner_secs[d + 1].name  = debug_names[d];
        winner_secs[d + 1].kind  = of.SK_DEBUG;
        winner_secs[d + 1].bytes = ?winner_debug[d][0];
        winner_secs[d + 1].len   = 40;
        winner_secs[d + 1].align = 1;
        loser_secs[d + 1].name   = debug_names[d];
        loser_secs[d + 1].kind   = of.SK_DEBUG;
        loser_secs[d + 1].bytes  = ?loser_debug[d][0];
        loser_secs[d + 1].len    = 40;
        loser_secs[d + 1].align  = 1;
        d                        = d + 1;
    }

    val weak_flags: u32 =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    val wline: intern.StrId = lt_name(s, "parsed_weak.w.debug_line");
    val lline: intern.StrId = lt_name(s, "parsed_weak.l.debug_line");
    if (wline == intern.STR_NIL || lline == intern.STR_NIL) { ret false; }

    var winner_syms: [3]of.Symbol;
    winner_syms[0].name    = dup;
    winner_syms[0].section = of.section_id(0);
    winner_syms[0].offset  = 0;
    winner_syms[0].size    = 8;
    winner_syms[0].flags   = weak_flags;
    winner_syms[1].name    = entry;
    winner_syms[1].section = of.section_id(0);
    winner_syms[1].offset  = 8;
    winner_syms[1].size    = 8;
    winner_syms[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    winner_syms[2].name    = wline;
    winner_syms[2].section = of.section_id(2);
    winner_syms[2].offset  = 0;
    winner_syms[2].size    = 0;
    winner_syms[2].flags   = of.SYM_OBJ_FLAG_GLOBAL;
    var loser_syms: [2]of.Symbol;
    loser_syms[0].name    = dup;
    loser_syms[0].section = of.section_id(0);
    loser_syms[0].offset  = 0;
    loser_syms[0].size    = 8;
    loser_syms[0].flags   = weak_flags;
    loser_syms[1].name    = lline;
    loser_syms[1].section = of.section_id(2);
    loser_syms[1].offset  = 0;
    loser_syms[1].size    = 0;
    loser_syms[1].flags   = of.SYM_OBJ_FLAG_GLOBAL;

    var winner_relocs: [9]of.Relocation;
    var loser_relocs:  [9]of.Relocation;
    d = 0;
    for (d < 4) {
        winner_relocs[d].section     = of.section_id(d + 1);
        winner_relocs[d].offset      = 8;
        winner_relocs[d].kind        = of.RK_ABS64;
        winner_relocs[d].sym         = 0;
        winner_relocs[d].addend      = 0;
        loser_relocs[d].section      = of.section_id(d + 1);
        loser_relocs[d].offset       = 8;
        loser_relocs[d].kind         = of.RK_ABS64;
        loser_relocs[d].sym          = 0;
        loser_relocs[d].addend       = 0;
        winner_relocs[4 + d].section = of.section_id(d + 1);
        winner_relocs[4 + d].offset  = 24;
        winner_relocs[4 + d].kind    = of.RK_ABS64;
        winner_relocs[4 + d].sym     = 0;
        winner_relocs[4 + d].addend  = 4;
        loser_relocs[4 + d].section  = of.section_id(d + 1);
        loser_relocs[4 + d].offset   = 24;
        loser_relocs[4 + d].kind     = of.RK_ABS64;
        loser_relocs[4 + d].sym      = 0;
        loser_relocs[4 + d].addend   = 4;
        d                            = d + 1;
    }
    winner_relocs[8].section = of.section_id(1);
    winner_relocs[8].offset  = 32;
    winner_relocs[8].kind    = of.RK_ABS32;
    winner_relocs[8].sym     = 2;
    winner_relocs[8].addend  = 0;
    loser_relocs[8].section  = of.section_id(1);
    loser_relocs[8].offset   = 32;
    loser_relocs[8].kind     = of.RK_ABS32;
    loser_relocs[8].sym      = 1;
    loser_relocs[8].addend   = 0;

    var modules: [2]of.ObjectImage;
    modules[0] = lt_image(s, lt_name(s, "parsed-winner"), ?winner_secs[0], 5,
        ?winner_syms[0], 3, ?winner_relocs[0], 9);
    modules[1] = lt_image(s, lt_name(s, "parsed-loser"), ?loser_secs[0], 5,
        ?loser_syms[0], 2, ?loser_relocs[0], 9);

    if (!lt_is_mach_shaped(?modules[0], 0) || !lt_is_mach_shaped(?modules[0], 1)) { ret false; }

    val wtf_r: res[fixture.Output, outcome.Fail] = fixture.create(alloc, "weak_dwarf_winner");
    if (sel wtf_r.err) { ret false; }
    var wtf: fixture.Output = wtf_r.ok;
    fin { fixture.dnit(?wtf); }
    val ltf_r: res[fixture.Output, outcome.Fail] = fixture.create(alloc, "weak_dwarf_loser");
    if (sel ltf_r.err) {
        ret false;
    }
    var ltf: fixture.Output = ltf_r.ok;
    fin { fixture.dnit(?ltf); }
    val etf_r: res[fixture.Output, outcome.Fail] = fixture.create(alloc, "weak_dwarf_exe");
    if (sel etf_r.err) {
        ret false;
    }
    var etf: fixture.Output = etf_r.ok;
    fin { fixture.dnit(?etf); }
    val wpath: str = fixture.path(?wtf);
    val lpath: str = fixture.path(?ltf);
    val epath: str = fixture.path(?etf);

    var ok:       bool           = true;
    val object_r: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?modules[0], wpath);
    if (sel object_r.err) { ok = false; }
    if (ok) {
        val object_r: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?modules[1], lpath);
        if (sel object_r.err) { ok = false; }
    }
    var paths: [2]*u8;
    paths[0] = wpath::*u8;
    paths[1] = lpath::*u8;
    if (ok) {
        val lr: err[fail.Fail] = link(s, tgt, ?paths[0], 2,
            nil::*of.DynLib, 0, epath, "parsed_weak_dwarf"::*u8,
            LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
        if (sel lr.err) { ok = false; }
    }

    var out: Vector[u8];
    if (ok) {
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, epath);
        if (sel rr.ok) {
            out = rr.ok;
            var live_addr: u64 = 0;
            d = 0;
            for (ok && d < 4) {
                var winner_addr: u64 = 0;
                if (!lt_marker_live_value(out.data, out.len, (0xA0 + d)::u8, ?winner_addr)) {
                    ok = false;
                }
                if (d == 0)                   { live_addr = winner_addr; }
                or (winner_addr != live_addr) { ok = false; }
                if (!lt_marker_tombstoned(out.data, out.len, (0xD0 + d)::u8)) {
                    ok = false;
                }

                var winner_inner: u64 = 0;
                if (!lt_marker_live_value(out.data, out.len, (0xB0 + d)::u8, ?winner_inner)) {
                    ok = false;
                }
                if (winner_inner != live_addr + 4) { ok = false; }
                if (!lt_marker_tombstoned(out.data, out.len, (0xE0 + d)::u8)) {
                    ok = false;
                }
                d = d + 1;
            }
            vector.dnit[u8](?out);
        }
        if (sel rr.err) { ok = false; }
    }

    ret ok;
}

test "mach.lang.be.linker.patch_relocations:parsed_weak_dwarf_tombstones" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_7781: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_7781.err) { ret 1; }
    val er: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "linux", "sysv64");
    val mr: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "darwin", "sysv64");
    if (sel er.err) { ret 1; }
    if (sel mr.err) { ret 1; }
    var elf_tgt:   target.Target = er.ok;
    var macho_tgt: target.Target = mr.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:        session.Session = sr.ok;
    val elf_ok:   bool            = lt_parsed_weak_dwarf_target(?s, ?elf_tgt);
    val macho_ok: bool            = lt_parsed_weak_dwarf_target(?s, ?macho_tgt);
    session.dnit(?s);
    if (!elf_ok || !macho_ok) { ret 1; }
    ret 0;
}

fun lt_dwarf_addend_crossing(s: *session.Session, tgt: *target.Target) i32 {
    val alloc:   *A.Allocator = s.alloc;
    val text:    intern.StrId = lt_name(s, ".text");
    val info:    intern.StrId = lt_name(s, ".debug_info");
    val line:    intern.StrId = lt_name(s, ".debug_line");
    val dup:     intern.StrId = lt_name(s, "crossing_weak");
    val anchor:  intern.StrId = lt_name(s, "crossing_anchor");
    val tail:    intern.StrId = lt_name(s, "crossing_tail");
    val lanchor: intern.StrId = lt_name(s, "crossing.debug_line");
    val entry:   intern.StrId = lt_name(s, tgt.os.entry_symbol);
    if (text == intern.STR_NIL || info == intern.STR_NIL || line == intern.STR_NIL
        || dup == intern.STR_NIL || anchor == intern.STR_NIL || tail == intern.STR_NIL
        || lanchor == intern.STR_NIL || entry == intern.STR_NIL) {
        ret 4;
    }

    var win_text:   [32]u8;
    var cross_text: [48]u8;
    var i:          u32 = 0;
    for (i < 32) {
        win_text[i] = (0x10 + i)::u8;
        i           = i + 1;
    }
    i = 0;
    for (i < 48) {
        cross_text[i] = (0x40 + i)::u8;
        i             = i + 1;
    }

    var cross_info: [56]u8;
    i = 0;
    for (i < 56) {
        cross_info[i] = 0;
        i             = i + 1;
    }
    i = 0;
    for (i < 8) {
        cross_info[i]      = 0xC1;
        cross_info[16 + i] = 0xC2;
        cross_info[32 + i] = 0xC3;
        i                  = i + 1;
    }
    var cross_line: [8]u8;
    i = 0;
    for (i < 8) {
        cross_line[i] = 0x5C;
        i             = i + 1;
    }

    var win_secs: [1]of.Section;
    win_secs[0].name  = text;
    win_secs[0].kind  = of.SK_TEXT;
    win_secs[0].bytes = ?win_text[0];
    win_secs[0].len   = 32;
    win_secs[0].align = 16;

    var cross_secs: [3]of.Section;
    cross_secs[0].name  = text;
    cross_secs[0].kind  = of.SK_TEXT;
    cross_secs[0].bytes = ?cross_text[0];
    cross_secs[0].len   = 48;
    cross_secs[0].align = 16;
    cross_secs[1].name  = info;
    cross_secs[1].kind  = of.SK_DEBUG;
    cross_secs[1].bytes = ?cross_info[0];
    cross_secs[1].len   = 56;
    cross_secs[1].align = 1;
    cross_secs[2].name  = line;
    cross_secs[2].kind  = of.SK_DEBUG;
    cross_secs[2].bytes = ?cross_line[0];
    cross_secs[2].len   = 8;
    cross_secs[2].align = 1;

    val weak_flags: u32 =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    val fn_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var win_syms: [2]of.Symbol;
    win_syms[0].name    = dup;
    win_syms[0].section = of.section_id(0);
    win_syms[0].offset  = 0;
    win_syms[0].size    = 16;
    win_syms[0].flags   = weak_flags;
    win_syms[1].name    = entry;
    win_syms[1].section = of.section_id(0);
    win_syms[1].offset  = 16;
    win_syms[1].size    = 16;
    win_syms[1].flags   = fn_flags;

    var cross_syms: [4]of.Symbol;
    cross_syms[0].name    = anchor;
    cross_syms[0].section = of.section_id(0);
    cross_syms[0].offset  = 0;
    cross_syms[0].size    = 16;
    cross_syms[0].flags   = fn_flags;
    cross_syms[1].name    = dup;
    cross_syms[1].section = of.section_id(0);
    cross_syms[1].offset  = 16;
    cross_syms[1].size    = 16;
    cross_syms[1].flags   = weak_flags;
    cross_syms[2].name    = tail;
    cross_syms[2].section = of.section_id(0);
    cross_syms[2].offset  = 32;
    cross_syms[2].size    = 16;
    cross_syms[2].flags   = fn_flags;
    cross_syms[3].name    = lanchor;
    cross_syms[3].section = of.section_id(2);
    cross_syms[3].offset  = 0;
    cross_syms[3].size    = 0;
    cross_syms[3].flags   = of.SYM_OBJ_FLAG_GLOBAL;

    var cross_relocs: [4]of.Relocation;
    cross_relocs[0].section = of.section_id(1);
    cross_relocs[0].offset  = 8;
    cross_relocs[0].kind    = of.RK_ABS64;
    cross_relocs[0].sym     = 0;
    cross_relocs[0].addend  = 32;
    cross_relocs[1].section = of.section_id(1);
    cross_relocs[1].offset  = 24;
    cross_relocs[1].kind    = of.RK_ABS64;
    cross_relocs[1].sym     = 0;
    cross_relocs[1].addend  = 0;
    cross_relocs[2].section = of.section_id(1);
    cross_relocs[2].offset  = 40;
    cross_relocs[2].kind    = of.RK_ABS64;
    cross_relocs[2].sym     = 2;
    cross_relocs[2].addend  = 0;
    cross_relocs[3].section = of.section_id(1);
    cross_relocs[3].offset  = 48;
    cross_relocs[3].kind    = of.RK_ABS32;
    cross_relocs[3].sym     = 3;
    cross_relocs[3].addend  = 0;

    var modules: [2]of.ObjectImage;
    modules[0] = lt_image(s, lt_name(s, "crossing-winner"), ?win_secs[0], 1,
        ?win_syms[0], 2, nil::*of.Relocation, 0);
    modules[1] = lt_image(s, lt_name(s, "crossing-loser"), ?cross_secs[0], 3,
        ?cross_syms[0], 4, ?cross_relocs[0], 4);

    if (!lt_is_mach_shaped(?modules[0], 1)) { ret 6; }

    val wtf_r: res[fixture.Output, outcome.Fail] = fixture.create(alloc, "cross_dwarf_winner");
    if (sel wtf_r.err) { ret 4; }
    var wtf: fixture.Output = wtf_r.ok;
    fin { fixture.dnit(?wtf); }
    val ltf_r: res[fixture.Output, outcome.Fail] = fixture.create(alloc, "cross_dwarf_loser");
    if (sel ltf_r.err) { ret 4; }
    var ltf: fixture.Output = ltf_r.ok;
    fin { fixture.dnit(?ltf); }
    val etf_r: res[fixture.Output, outcome.Fail] = fixture.create(alloc, "cross_dwarf_exe");
    if (sel etf_r.err) {
        ret 4;
    }
    var etf: fixture.Output = etf_r.ok;
    fin { fixture.dnit(?etf); }
    val wpath: str = fixture.path(?wtf);
    val lpath: str = fixture.path(?ltf);
    val epath: str = fixture.path(?etf);

    var code:     i32            = 4;
    var wrote:    bool           = true;
    val object_r: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?modules[0], wpath);
    if (sel object_r.err) { wrote = false; }
    if (wrote) {
        val object_r: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?modules[1], lpath);
        if (sel object_r.err) { wrote = false; }
    }
    if (wrote) {
        var paths: [2]*u8;
        paths[0] = wpath::*u8;
        paths[1] = lpath::*u8;
        val lr: err[fail.Fail] = link(s, tgt, ?paths[0], 2,
            nil::*of.DynLib, 0, epath, "crossing_dwarf"::*u8,
            LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
        if (sel lr.err) {
            code = 3;
            if (str_contains(fail.describe(lr.err), "crosses a discarded body")) { code = 0; }
        }
        if (sel lr.ok) {
            code = 4;
            val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, epath);
            if (sel rr.ok) {
                var out:       Vector[u8] = rr.ok;
                var anchor_va: u64        = 0;
                var cross_va:  u64        = 0;
                var tail_va:   u64        = 0;
                if (lt_marker_live_value(out.data, out.len, 0xC2, ?anchor_va)
                    && lt_marker_live_value(out.data, out.len, 0xC1, ?cross_va)
                    && lt_marker_live_value(out.data, out.len, 0xC3, ?tail_va)) {
                    code = 5;
                    if (tail_va == anchor_va + 16) {
                        code = 2;
                        if (cross_va == anchor_va + 32) { code = 1; }
                    }
                }
                vector.dnit[u8](?out);
            }
        }
    }

    ret code;
}

test "mach.lang.be.linker.patch_relocations:dwarf_addend_crossing_refused" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_7958: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_7958.err) { ret 1; }
    val er: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel er.err) { ret 1; }
    var elf_tgt: target.Target = er.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:    session.Session = sr.ok;
    val code: i32             = lt_dwarf_addend_crossing(?s, ?elf_tgt);
    session.dnit(?s);
    ret code;
}

test "mach.lang.be.linker.archive_resolution:test_entry_satisfies_main_before_archive" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_8204: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_8204.err) {
        session.dnit(?s);
        ret 1;
    }
    val tr: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "windows", "win64");
    if (sel tr.err) {
        session.dnit(?s);
        ret 1;
    }
    var tgt: target.Target = tr.ok;

    val text:      intern.StrId = lt_name(?s, ".text");
    val entry_sym: intern.StrId = lt_name(?s, "mainCRTStartup");
    val main_sym:  intern.StrId = lt_name(?s, "main");
    val helper:    intern.StrId = lt_name(?s, "helper");
    if (text == intern.STR_NIL || entry_sym == intern.STR_NIL
        || main_sym == intern.STR_NIL || helper == intern.STR_NIL) {
        session.dnit(?s);
        ret 1;
    }

    val def_fn: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    val undef:  u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;

    var eb: [8]u8;
    var cb: [8]u8;
    var hb: [8]u8;
    var sb: [8]u8;
    var i:  u32 = 0;
    for (i < 8) {
        eb[i] = 0xCC;
        cb[i] = 0x90;
        hb[i] = 0xA5;
        sb[i] = 0x33;
        i     = i + 1;
    }

    var entry_secs: [1]of.Section;
    entry_secs[0].name  = text;
    entry_secs[0].kind  = of.SK_TEXT;
    entry_secs[0].bytes = ?eb[0];
    entry_secs[0].len   = 8;
    entry_secs[0].align = 8;
    var entry_syms: [2]of.Symbol;
    entry_syms[0].name    = main_sym;
    entry_syms[0].section = of.section_id(0);
    entry_syms[0].offset  = 0;
    entry_syms[0].size    = 8;
    entry_syms[0].flags   = def_fn;
    entry_syms[1].name    = helper;
    entry_syms[1].section = of.external_section();
    entry_syms[1].offset  = 0;
    entry_syms[1].size    = 0;
    entry_syms[1].flags   = undef;
    var entry_img: of.ObjectImage = lt_image(?s, lt_name(?s, "test-entry"),
        ?entry_secs[0], 1, ?entry_syms[0], 2, nil::*of.Relocation, 0);

    var crt_secs: [1]of.Section;
    crt_secs[0].name  = text;
    crt_secs[0].kind  = of.SK_TEXT;
    crt_secs[0].bytes = ?cb[0];
    crt_secs[0].len   = 8;
    crt_secs[0].align = 8;
    var crt_syms: [2]of.Symbol;
    crt_syms[0].name    = entry_sym;
    crt_syms[0].section = of.section_id(0);
    crt_syms[0].offset  = 0;
    crt_syms[0].size    = 8;
    crt_syms[0].flags   = def_fn;
    crt_syms[1].name    = main_sym;
    crt_syms[1].section = of.external_section();
    crt_syms[1].offset  = 0;
    crt_syms[1].size    = 0;
    crt_syms[1].flags   = undef;
    var crt_img: of.ObjectImage = lt_image(?s, lt_name(?s, "crt"),
        ?crt_secs[0], 1, ?crt_syms[0], 2, nil::*of.Relocation, 0);

    var helper_secs: [1]of.Section;
    helper_secs[0].name  = text;
    helper_secs[0].kind  = of.SK_TEXT;
    helper_secs[0].bytes = ?hb[0];
    helper_secs[0].len   = 8;
    helper_secs[0].align = 8;
    var helper_syms: [1]of.Symbol;
    helper_syms[0].name    = helper;
    helper_syms[0].section = of.section_id(0);
    helper_syms[0].offset  = 0;
    helper_syms[0].size    = 8;
    helper_syms[0].flags   = def_fn;
    var helper_img: of.ObjectImage = lt_image(?s, lt_name(?s, "helper"),
        ?helper_secs[0], 1, ?helper_syms[0], 1, nil::*of.Relocation, 0);

    var stub_secs: [1]of.Section;
    stub_secs[0].name  = text;
    stub_secs[0].kind  = of.SK_TEXT;
    stub_secs[0].bytes = ?sb[0];
    stub_secs[0].len   = 8;
    stub_secs[0].align = 8;
    var stub_syms: [1]of.Symbol;
    stub_syms[0].name    = main_sym;
    stub_syms[0].section = of.section_id(0);
    stub_syms[0].offset  = 0;
    stub_syms[0].size    = 8;
    stub_syms[0].flags   = def_fn;
    var stub_img: of.ObjectImage = lt_image(?s, lt_name(?s, "main-stub"),
        ?stub_secs[0], 1, ?stub_syms[0], 1, nil::*of.Relocation, 0);

    var entry_tf:    fixture.Output;
    var crt_tf:      fixture.Output;
    var helper_tf:   fixture.Output;
    var stub_tf:     fixture.Output;
    var ar_tf:       fixture.Output;
    var exe_tf:      fixture.Output;
    var have_entry:  bool = false;
    var have_crt:    bool = false;
    var have_helper: bool = false;
    var have_stub:   bool = false;
    var have_ar:     bool = false;
    var have_exe:    bool = false;

    val er0: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "mach_2562_entry");
    if (sel er0.err) {
        session.dnit(?s);
        ret 1;
    }
    entry_tf   = er0.ok;
    have_entry = true;
    val er1: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "mach_2562_crt");
    if (sel er1.err) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s);
        ret 1;
    }
    crt_tf   = er1.ok;
    have_crt = true;
    val er2: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "mach_2562_helper");
    if (sel er2.err) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s);
        ret 1;
    }
    helper_tf   = er2.ok;
    have_helper = true;
    val er3: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "mach_2562_stub");
    if (sel er3.err) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s);
        ret 1;
    }
    stub_tf   = er3.ok;
    have_stub = true;
    val er4: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "mach_2562_ar");
    if (sel er4.err) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s);
        ret 1;
    }
    ar_tf   = er4.ok;
    have_ar = true;
    val er5: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "mach_2562_exe");
    if (sel er5.err) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s);
        ret 1;
    }
    exe_tf   = er5.ok;
    have_exe = true;

    val entry_path:  str = fixture.path(?entry_tf);
    val crt_path:    str = fixture.path(?crt_tf);
    val helper_path: str = fixture.path(?helper_tf);
    val stub_path:   str = fixture.path(?stub_tf);
    val ar_path:     str = fixture.path(?ar_tf);
    val exe_path:    str = fixture.path(?exe_tf);

    val close_r:  err[outcome.Fail] = fixture.close(?exe_tf);
    val close_r2: err[outcome.Fail] = fixture.close(?ar_tf);
    val close_r3: err[outcome.Fail] = fixture.close(?stub_tf);
    val close_r4: err[outcome.Fail] = fixture.close(?helper_tf);
    val close_r5: err[outcome.Fail] = fixture.close(?crt_tf);
    val close_r6: err[outcome.Fail] = fixture.close(?entry_tf);
    if (sel close_r6.err) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s);
        ret 1;
    }
    if (sel close_r5.err) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s);
        ret 1;
    }
    if (sel close_r4.err) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s);
        ret 1;
    }
    if (sel close_r3.err) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s);
        ret 1;
    }
    if (sel close_r2.err) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s);
        ret 1;
    }
    if (sel close_r.err) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s);
        ret 1;
    }

    var bad:      i32            = 0;
    val object_r: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?entry_img, entry_path);
    if (sel object_r.err) { bad = 1; }
    if (bad == 0) {
        val object_r: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?crt_img, crt_path);
        if (sel object_r.err) { bad = 1; }
    }
    if (bad == 0) {
        val object_r: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?helper_img, helper_path);
        if (sel object_r.err) { bad = 1; }
    }
    if (bad == 0) {
        val object_r: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?stub_img, stub_path);
        if (sel object_r.err) { bad = 1; }
    }

    var crt_vec:    Vector[u8];
    var helper_vec: Vector[u8];
    var stub_vec:   Vector[u8];
    var have_crt_v: bool = false;
    var have_hlp_v: bool = false;
    var have_stb_v: bool = false;
    if (bad == 0) {
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, crt_path);
        if (sel rr.ok) {
            crt_vec    = rr.ok;
            have_crt_v = true;
        }
        if (sel rr.err) { bad = 1; }
    }
    if (bad == 0) {
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, helper_path);
        if (sel rr.ok) {
            helper_vec = rr.ok;
            have_hlp_v = true;
        }
        if (sel rr.err) { bad = 1; }
    }
    if (bad == 0) {
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, stub_path);
        if (sel rr.ok) {
            stub_vec   = rr.ok;
            have_stb_v = true;
        }
        if (sel rr.err) { bad = 1; }
    }

    if (bad == 0) {
        var crt_names: [1]str;
        crt_names[0] = "mainCRTStartup";
        var helper_names: [1]str;
        helper_names[0] = "helper";
        var stub_names: [1]str;
        stub_names[0] = "main";
        var members: [3]ar.ArMember;
        members[0].name      = "crt.o";
        members[0].data      = crt_vec.data;
        members[0].len       = crt_vec.len;
        members[0].sym_names = ?crt_names[0];
        members[0].sym_count = 1;
        members[1].name      = "helper.o";
        members[1].data      = helper_vec.data;
        members[1].len       = helper_vec.len;
        members[1].sym_names = ?helper_names[0];
        members[1].sym_count = 1;
        members[2].name      = "stub.o";
        members[2].data      = stub_vec.data;
        members[2].len       = stub_vec.len;
        members[2].sym_names = ?stub_names[0];
        members[2].sym_count = 1;
        val wr: err[fail.Fail] = ar.write_archive(?alloc, ?members[0], 3, ar_path);
        if (sel wr.err) { bad = 1; }
    }

    if (bad == 0) {
        var fix_paths: [2]*u8;
        fix_paths[0] = entry_path::*u8;
        fix_paths[1] = ar_path::*u8;
        val lr: err[fail.Fail] =
            link(?s, ?tgt, ?fix_paths[0], 2, nil::*of.DynLib, 0, exe_path,
            "test-entry-fix", LINK_EXE, false,
            of.image_options_default(of.SUBSYSTEM_CONSOLE));
        if (sel lr.err) { bad = 1; }
    }

    if (bad == 0) {
        var bug_paths: [2]*u8;
        bug_paths[0] = ar_path::*u8;
        bug_paths[1] = entry_path::*u8;
        val lr: err[fail.Fail] =
            link(?s, ?tgt, ?bug_paths[0], 2, nil::*of.DynLib, 0, exe_path,
            "test-entry-bug", LINK_EXE, false,
            of.image_options_default(of.SUBSYSTEM_CONSOLE));
        if (sel lr.err) {
            val error: str = fail.describe(lr.err);
            if (!str_equals(error, "multiple definition of 'main'")) { bad = 1; }
        }
        if (sel lr.ok) { bad = 1; }
    }

    if (have_crt_v) { vector.dnit[u8](?crt_vec); }
    if (have_hlp_v) { vector.dnit[u8](?helper_vec); }
    if (have_stb_v) { vector.dnit[u8](?stub_vec); }
    remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
    session.dnit(?s);
    ret bad;
}

fun remove_2562(a: *fixture.Output, b: *fixture.Output, c: *fixture.Output, d: *fixture.Output,
    e: *fixture.Output, f: *fixture.Output,
    ha: bool, hb: bool, hc: bool, hd: bool, he: bool, hf: bool) {
    if (ha) { fixture.dnit(a); }
    if (hb) { fixture.dnit(b); }
    if (hc) { fixture.dnit(c); }
    if (hd) { fixture.dnit(d); }
    if (he) { fixture.dnit(e); }
    if (hf) { fixture.dnit(f); }
}

fun lt_macho_section(buf: *u8, segname: str, sect: str) usize {
    val ncmds: u32   = bin.read_u32_le(buf, 16);
    var off:   usize = 32;
    var c:     u32   = 0;
    for (c < ncmds) {
        if (bin.read_u32_le(buf, off) == 25) {
            val nsects: u32 = bin.read_u32_le(buf, off + 64);
            var k:      u32 = 0;
            for (k < nsects) {
                val sh: usize = off + 72 + k::usize * 80;
                if (lt_fixed16_is(buf, sh, sect) && lt_fixed16_is(buf, sh + 16, segname)) { ret sh; }
                k = k + 1;
            }
        }
        off = off + bin.read_u32_le(buf, off + 4)::usize;
        c   = c + 1;
    }
    ret 0;
}

fun lt_fixed16_is(buf: *u8, off: usize, name: str) bool {
    val n: usize = str_len(name);
    if (n > 16) { ret false; }
    var i: usize = 0;
    for (i < 16) {
        var expect: u8 = 0;
        if (i < n)                  { expect = name[i]; }
        if (buf[off + i] != expect) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.be.linker.link_modules:input_section_names_survive" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_10258: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_10258.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "darwin", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val text:      intern.StrId = lt_name(?s, ".text");
    val data:      intern.StrId = lt_name(?s, ".data");
    val classlist: intern.StrId = lt_name(?s, "__objc_classlist");
    val entry:     intern.StrId = lt_name(?s, tgt.os.entry_symbol);
    if (text == intern.STR_NIL || data == intern.STR_NIL
        || classlist == intern.STR_NIL || entry == intern.STR_NIL) { ret 1; }

    var code: [16]u8;
    var i:    u32 = 0;
    for (i < 16) {
        code[i] = 0x90;
        i       = i + 1;
    }

    var cl0: [8]u8;
    var cl1: [8]u8;
    var d0:  [8]u8;
    i = 0;
    for (i < 8) {
        cl0[i] = 0xA0;
        cl1[i] = 0xB0;
        d0[i]  = 0xDD;
        i      = i + 1;
    }

    var secs0: [3]of.Section;
    secs0[0].name  = text;
    secs0[0].kind  = of.SK_TEXT;
    secs0[0].bytes = ?code[0];
    secs0[0].len   = 16;
    secs0[0].align = 16;
    secs0[1].name  = data;
    secs0[1].kind  = of.SK_DATA;
    secs0[1].bytes = ?d0[0];
    secs0[1].len   = 8;
    secs0[1].align = 8;
    secs0[2].name  = classlist;
    secs0[2].kind  = of.SK_DATA;
    secs0[2].bytes = ?cl0[0];
    secs0[2].len   = 8;
    secs0[2].align = 8;
    secs0[2].flags = of.SEC_FLAG_RETAIN;

    var secs1: [1]of.Section;
    secs1[0].name  = classlist;
    secs1[0].kind  = of.SK_DATA;
    secs1[0].bytes = ?cl1[0];
    secs1[0].len   = 8;
    secs1[0].align = 8;
    secs1[0].flags = of.SEC_FLAG_RETAIN;

    var syms0: [2]of.Symbol;
    syms0[0].name    = entry;
    syms0[0].section = of.section_id(0);
    syms0[0].offset  = 0;
    syms0[0].size    = 16;
    syms0[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms0[1].name    = lt_name(?s, "data0");
    syms0[1].section = of.section_id(1);
    syms0[1].offset  = 0;
    syms0[1].size    = 8;
    syms0[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var relocs0: [1]of.Relocation;
    relocs0[0].section = of.section_id(0);
    relocs0[0].offset  = 4;
    relocs0[0].kind    = of.RK_PC32;
    relocs0[0].sym     = 1;
    relocs0[0].addend  = -4;

    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "m0"), ?secs0[0], 3, ?syms0[0], 2, ?relocs0[0], 1);
    mods[1] = lt_image(?s, lt_name(?s, "m1"), ?secs1[0], 1, nil::*of.Symbol, 0, nil::*of.Relocation, 0);

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_names");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    val lr: err[fail.Fail] =
        link_modules_nocapture(?s, ?tgt, ?mods[0], 2, 2, nil::*of.DynLib, 0, tpath,
        "macho_names"::*u8, LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel lr.err) { ret 1; }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rr.err) { ret 1; }
    var b: Vector[u8] = rr.ok;

    val cls: usize = lt_macho_section(b.data, "__DATA", "__objc_classlist");
    if (cls == 0) {
        vector.dnit[u8](?b);
        ret 1;
    }
    if (bin.read_u64_le(b.data, cls + 40) != 16) {
        vector.dnit[u8](?b);
        ret 1;
    }
    if (bin.read_u32_le(b.data, cls + 52) < 3) {
        vector.dnit[u8](?b);
        ret 1;
    }

    val cls_off: usize = bin.read_u32_le(b.data, cls + 48)::usize;
    if ((bin.read_u64_le(b.data, cls + 32) % 8) != 0) {
        vector.dnit[u8](?b);
        ret 1;
    }
    var j: usize = 0;
    for (j < 8) {
        if (b.data[cls_off + j] != 0xA0) {
            vector.dnit[u8](?b);
            ret 1;
        }
        if (b.data[cls_off + 8 + j] != 0xB0) {
            vector.dnit[u8](?b);
            ret 1;
        }
        j = j + 1;
    }

    val dsec: usize = lt_macho_section(b.data, "__DATA", "__data");
    if (dsec == 0) {
        vector.dnit[u8](?b);
        ret 1;
    }
    if (bin.read_u64_le(b.data, dsec + 40) != 8) {
        vector.dnit[u8](?b);
        ret 1;
    }

    if (lt_macho_section(b.data, "__TEXT", "__text") == 0) {
        vector.dnit[u8](?b);
        ret 1;
    }
    if (lt_macho_section(b.data, "__TEXT", ".text") != 0) {
        vector.dnit[u8](?b);
        ret 1;
    }

    vector.dnit[u8](?b);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.link_modules:flat_entry_leads_regardless_of_order" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_10351: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_10351.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "freestanding", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;
    if (!tgt.of.produces_image) { ret 1; }

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val text:  intern.StrId = lt_name(?s, ".text");
    val other: intern.StrId = lt_name(?s, "other_fn");
    val entry: intern.StrId = lt_name(?s, tgt.os.entry_symbol);
    if (text == intern.STR_NIL || other == intern.STR_NIL || entry == intern.STR_NIL) { ret 1; }

    var b0: [32]u8;
    var b1: [16]u8;
    var i:  u32 = 0;
    for (i < 32) {
        b0[i] = 0x90;
        i     = i + 1;
    }
    i = 0;
    for (i < 16) {
        b1[i] = 0xCC;
        i     = i + 1;
    }

    var secs0: [1]of.Section;
    secs0[0].name  = text;
    secs0[0].kind  = of.SK_TEXT;
    secs0[0].bytes = ?b0[0];
    secs0[0].len   = 32;
    secs0[0].align = 16;
    var secs1: [1]of.Section;
    secs1[0].name  = text;
    secs1[0].kind  = of.SK_TEXT;
    secs1[0].bytes = ?b1[0];
    secs1[0].len   = 16;
    secs1[0].align = 16;

    val fn_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var syms0:    [1]of.Symbol;
    syms0[0].name    = other;
    syms0[0].section = of.section_id(0);
    syms0[0].offset  = 0;
    syms0[0].size    = 0;
    syms0[0].flags   = fn_flags;
    var syms1: [1]of.Symbol;
    syms1[0].name    = entry;
    syms1[0].section = of.section_id(0);
    syms1[0].offset  = 0;
    syms1[0].size    = 0;
    syms1[0].flags   = fn_flags;

    var syms1_ext: [2]of.Symbol;
    syms1_ext[0]         = syms1[0];
    syms1_ext[1].name    = other;
    syms1_ext[1].section = of.external_section();
    syms1_ext[1].offset  = 0;
    syms1_ext[1].size    = 0;
    syms1_ext[1].flags   = fn_flags | of.SYM_OBJ_FLAG_EXTERN;
    var call: [1]of.Relocation;
    call[0].section = of.section_id(0);
    call[0].offset  = 4;
    call[0].kind    = of.RK_PC32;
    call[0].sym     = 1;
    call[0].addend  = -4;

    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "m0"), ?secs0[0], 1, ?syms0[0], 1, nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "m1"), ?secs1[0], 1, ?syms1_ext[0], 2, ?call[0], 1);

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "flat_entry");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    val lr: err[fail.Fail] =
        link_modules_nocapture(?s, ?tgt, ?mods[0], 2, 2, nil::*of.DynLib, 0, tpath, "flat_entry"::*u8, LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel lr.err) { ret 1; }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rr.err) { ret 1; }
    var b: Vector[u8] = rr.ok;

    if (b.len != 48) {
        vector.dnit[u8](?b);
        ret 1;
    }
    if (b.data[0] != 0xCC) {
        vector.dnit[u8](?b);
        ret 1;
    }
    if (b.data[15] != 0xCC) {
        vector.dnit[u8](?b);
        ret 1;
    }
    if (b.data[16] != 0x90) {
        vector.dnit[u8](?b);
        ret 1;
    }

    vector.dnit[u8](?b);
    session.dnit(?s);
    ret 0;
}

fun lt_loader_link(s: *session.Session, tgt: *target.Target, mode: LinkMode, pie: bool,
    dynlibs: *of.DynLib, dynlib_count: u32, out: *Vector[u8]) str {
    val text:  intern.StrId = lt_name(s, ".text");
    val entry: intern.StrId = lt_name(s, tgt.os.entry_symbol);
    if (text == intern.STR_NIL || entry == intern.STR_NIL) { ret "lt: intern failed"; }

    var tb: [16]u8;
    var i:  u32 = 0;
    for (i < 16) {
        tb[i] = 0x90;
        i     = i + 1;
    }

    var secs: [1]of.Section;
    secs[0].name  = text;
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?tb[0];
    secs[0].len   = 16;
    secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name    = entry;
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 0;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var mods: [1]of.ObjectImage;
    mods[0] = lt_image(s, lt_name(s, "loader_req"), ?secs[0], 1, ?syms[0], 1,
        nil::*of.Relocation, 0);
    mods[0].machine_flags = isa.machine_flags(tgt.isa, tgt.abi.float_arg_bits, false);

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(s.alloc, "loader_req");
    if (sel tf_r.err) { ret "lt: temp failed"; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    val lr: err[fail.Fail] =
        link_modules_nocapture(s, tgt, ?mods[0], 1, 1, dynlibs, dynlib_count, tpath,
        "loader_req"::*u8, mode, pie,
        of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel lr.err) {
        ret fail.describe(lr.err);
    }
    if (out != nil) {
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(s.alloc, tpath);
        if (sel rr.err) {
            ret "lt: read failed";
        }
        @out = rr.ok;
    }

    ret "";
}

test "mach.lang.be.linker.link_modules:loaderless_refuses_pie_and_dynamic" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_10469: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_10469.err) { ret 1; }

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val pie_msg: str = "link: a position-independent executable needs a loader to relocate it, and os = \"freestanding\" has none";
    val dyn_msg: str = "link: a dynamically-linked executable needs a loader to resolve it, and os = \"freestanding\" has none";
    val shr_msg: str = "link: a shared library needs a loader to map it, and os = \"freestanding\" has none";

    var isas: [4]str;
    isas[0] = "x86_64";
    isas[1] = "aarch64";
    isas[2] = "riscv64";
    isas[3] = "riscv32";
    var abis: [4]str;
    abis[0] = "sysv64";
    abis[1] = "aapcs64";
    abis[2] = "lp64d";
    abis[3] = "ilp32";

    val libname: intern.StrId = lt_name(?s, "libfoo.so");
    if (libname == intern.STR_NIL) { ret 1; }
    var dl: [1]of.DynLib;
    dl[0].name   = libname;
    dl[0].soname = libname;
    dl[0].rpath  = intern.STR_NIL;

    var bad: bool = false;
    var i:   u32  = 0;
    for (i < 4) {
        val tr: res[target.Target, fail.Fail] =
            target.select_of(?reg, isas[i], "freestanding", abis[i], "elf");
        if (sel tr.err) {
            bad = true;
            i   = i + 1;
            cnt;
        }
        var tgt: target.Target = tr.ok;

        if (!str_equals(lt_loader_link(?s, ?tgt, LINK_EXE, true, nil::*of.DynLib, 0,
            nil::*Vector[u8]), pie_msg)) { bad = true; }
        if (!str_equals(lt_loader_link(?s, ?tgt, LINK_EXE, false, ?dl[0], 1,
            nil::*Vector[u8]), dyn_msg)) { bad = true; }
        if (!str_equals(lt_loader_link(?s, ?tgt, LINK_SHARED, false, nil::*of.DynLib, 0,
            nil::*Vector[u8]), shr_msg)) { bad = true; }
        if (!str_empty(lt_loader_link(?s, ?tgt, LINK_EXE, false, nil::*of.DynLib, 0,
            nil::*Vector[u8]))) { bad = true; }
        i = i + 1;
    }

    val ltr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel ltr.err) { ret 1; }
    var ltgt: target.Target = ltr.ok;
    var img:  Vector[u8];
    if (!str_empty(lt_loader_link(?s, ?ltgt, LINK_EXE, true, nil::*of.DynLib, 0, ?img))) {
        bad = true;
    }
    or {
        if (img.len < 64 || bin.read_u16_le(img.data, 16) != 3) { bad = true; }
        or {
            val phoff:     usize = bin.read_u64_le(img.data, 32)::usize;
            val phentsize: usize = bin.read_u16_le(img.data, 54)::usize;
            val phnum:     usize = bin.read_u16_le(img.data, 56)::usize;
            var headers:   u32   = 0;
            var content:   u32   = 0;
            var lowest:    u64   = 0;
            var p:         usize = 0;
            for (p < phnum) {
                val at: usize = phoff + p * phentsize;
                if (at + 56 > img.len) {
                    p = phnum;
                    cnt;
                }
                if (bin.read_u32_le(img.data, at) == 1) {
                    if (bin.read_u64_le(img.data, at + 8) == 0) {
                        headers = headers + 1;
                        lowest  = bin.read_u64_le(img.data, at + 16);
                    }
                    or { content = content + 1; }
                }
                p = p + 1;
            }
            if (headers != 1 || content == 0)  { bad = true; }
            if (lowest != os_base_addr(?ltgt)) { bad = true; }
        }
        vector.dnit[u8](?img);
    }

    session.dnit(?s);
    if (bad) { ret 1; }
    ret 0;
}

# links one attributed text-only module into an executable and returns the link
# error, or "" when the link succeeded
fun lt_attributed_link(s: *session.Session, tgt: *target.Target, attributes: *u8,
    attributes_len: u32, extra_flags: u32) str {
    val text:  intern.StrId = lt_name(s, ".text");
    val entry: intern.StrId = lt_name(s, tgt.os.entry_symbol);
    if (text == intern.STR_NIL || entry == intern.STR_NIL) { ret "lt: intern failed"; }
    var tb: [16]u8;
    var i:  u32 = 0;
    for (i < 16) {
        tb[i] = 0x13;
        i     = i + 1;
    }
    var secs: [1]of.Section;
    secs[0].name  = text;
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?tb[0];
    secs[0].len   = 16;
    secs[0].align = 16;
    var syms: [1]of.Symbol;
    syms[0].name    = entry;
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 0;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var mods: [1]of.ObjectImage;
    mods[0]                = lt_image(s, lt_name(s, "attributed"), ?secs[0], 1, ?syms[0], 1, nil::*of.Relocation, 0);
    mods[0].machine_flags  = isa.machine_flags(tgt.isa, tgt.abi.float_arg_bits, false) | extra_flags;
    mods[0].attributes     = attributes;
    mods[0].attributes_len = attributes_len;
    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(s.alloc, "attributed");
    if (sel tf_r.err) { ret "lt: temp failed"; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val lr: err[fail.Fail] =
        link_modules_nocapture(s, tgt, ?mods[0], 1, 1, nil::*of.DynLib, 0, fixture.path(?tf),
        "attributed"::*u8, LINK_EXE, false,
        of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel lr.err) { ret fail.describe(lr.err); }
    ret "";
}

test "mach.lang.be.linker.link_modules:riscv_inputs_beyond_the_selected_extensions_are_refused" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_10586: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_10586.err) { ret 1; }
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val full_r: res[target.Target, fail.Fail] = target.select_of(?reg, "rv64imafdc", "freestanding", "lp64d", "elf");
    val soft_r: res[target.Target, fail.Fail] = target.select_of(?reg, "rv64imac", "freestanding", "lp64", "elf");
    val base_r: res[target.Target, fail.Fail] = target.select_of(?reg, "rv64i", "freestanding", "lp64", "elf");
    if (sel full_r.err) { ret 2; }
    if (sel soft_r.err) { ret 2; }
    if (sel base_r.err) { ret 2; }
    var full: target.Target = full_r.ok;
    var soft: target.Target = soft_r.ok;
    var base: target.Target = base_r.ok;

    var full_len:   u32                 = 0;
    val full_attrs: res[*u8, fail.Fail] = isa.build_attributes(full.isa, ?full.model, ?alloc, 0, false, ?full_len);
    if (sel full_attrs.err) { ret 3; }
    fin { A.deallocate[u8](?alloc, full_attrs.ok, full_len::usize); }
    var soft_len:   u32                 = 0;
    val soft_attrs: res[*u8, fail.Fail] = isa.build_attributes(soft.isa, ?soft.model, ?alloc, 0, false, ?soft_len);
    if (sel soft_attrs.err) { ret 3; }
    fin { A.deallocate[u8](?alloc, soft_attrs.ok, soft_len::usize); }

    if (!str_empty(lt_attributed_link(?s, ?full, full_attrs.ok, full_len, 0))) { ret 4; }
    if (!str_empty(lt_attributed_link(?s, ?full, soft_attrs.ok, soft_len, 0))) { ret 5; }
    if (!str_empty(lt_attributed_link(?s, ?soft, soft_attrs.ok, soft_len, 0))) { ret 6; }
    val needs_float: str = lt_attributed_link(?s, ?soft, full_attrs.ok, full_len, 0);
    if (!str_contains(needs_float, "requires the F extension")) { ret 7; }
    val needs_mul: str = lt_attributed_link(?s, ?base, soft_attrs.ok, soft_len, 0);
    if (!str_contains(needs_mul, "requires the M extension")) { ret 8; }
    val needs_c: str = lt_attributed_link(?s, ?base, nil, 0, isa.machine_flags(base.isa, 0, true) & ~isa.machine_flags(base.isa, 0, false));
    if (!str_contains(needs_c, "require the C extension"))                                                                                { ret 9; }
    if (!str_empty(lt_attributed_link(?s, ?soft, nil, 0, isa.machine_flags(soft.isa, 0, true) & ~isa.machine_flags(soft.isa, 0, false)))) { ret 10; }
    ret 0;
}

test "mach.lang.be.linker.patch_relocations:anonymous_section_symbols_stay_distinct" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_10629: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_10629.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "freestanding", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;
    if (!tgt.of.produces_image) { ret 1; }

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val text:   intern.StrId = lt_name(?s, ".text");
    val rodata: intern.StrId = lt_name(?s, ".rodata.str1.1");
    val data:   intern.StrId = lt_name(?s, ".data.rel.ro.local");
    val anon:   intern.StrId = lt_name(?s, "");
    val anchor: intern.StrId = lt_name(?s, "rodata_anchor");
    val entry:  intern.StrId = lt_name(?s, tgt.os.entry_symbol);
    if (text == intern.STR_NIL || rodata == intern.STR_NIL || data == intern.STR_NIL)  { ret 1; }
    if (anon == intern.STR_NIL || anchor == intern.STR_NIL || entry == intern.STR_NIL) { ret 1; }

    var tb: [16]u8;
    var rb: [16]u8;
    var db: [24]u8;
    var i:  u32 = 0;
    for (i < 16) {
        tb[i] = 0x90;
        rb[i] = 0x00;
        i     = i + 1;
    }
    for (i < 24) {
        db[i] = 0x00;
        i     = i + 1;
    }
    i = 0;
    for (i < 8) {
        db[i] = 0xEE;
        i     = i + 1;
    }

    var secs: [3]of.Section;
    secs[0].name  = text;
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?tb[0];
    secs[0].len   = 16;
    secs[0].align = 16;
    secs[1].name  = rodata;
    secs[1].kind  = of.SK_RODATA;
    secs[1].bytes = ?rb[0];
    secs[1].len   = 16;
    secs[1].align = 16;
    secs[2].name  = data;
    secs[2].kind  = of.SK_DATA;
    secs[2].bytes = ?db[0];
    secs[2].len   = 24;
    secs[2].align = 8;

    var syms: [5]of.Symbol;
    syms[0].name    = anon;
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 0;
    syms[0].flags   = 0;
    syms[1].name    = anon;
    syms[1].section = of.section_id(1);
    syms[1].offset  = 0;
    syms[1].size    = 0;
    syms[1].flags   = 0;
    syms[2].name    = anchor;
    syms[2].section = of.section_id(1);
    syms[2].offset  = 8;
    syms[2].size    = 0;
    syms[2].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    syms[3].name    = entry;
    syms[3].section = of.section_id(0);
    syms[3].offset  = 0;
    syms[3].size    = 0;
    syms[3].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[4].name    = lt_name(?s, "table");
    syms[4].section = of.section_id(2);
    syms[4].offset  = 0;
    syms[4].size    = 24;
    syms[4].flags   = of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [3]of.Relocation;
    relocs[0].section = of.section_id(2);
    relocs[0].offset  = 8;
    relocs[0].kind    = of.RK_ABS64;
    relocs[0].sym     = 1;
    relocs[0].addend  = 8;
    relocs[1].section = of.section_id(2);
    relocs[1].offset  = 16;
    relocs[1].kind    = of.RK_ABS64;
    relocs[1].sym     = 2;
    relocs[1].addend  = 0;
    relocs[2].section = of.section_id(0);
    relocs[2].offset  = 4;
    relocs[2].kind    = of.RK_PC32;
    relocs[2].sym     = 4;
    relocs[2].addend  = -4;

    var mods: [1]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "anon_secs"), ?secs[0], 3, ?syms[0], 5, ?relocs[0], 3);

    val etr: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel etr.err) { ret 1; }
    var etgt: target.Target = etr.ok;

    val otf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "anon_section_obj");
    if (sel otf_r.err) { ret 1; }
    var otf: fixture.Output = otf_r.ok;
    fin { fixture.dnit(?otf); }
    val opath: str            = fixture.path(?otf);
    val olr:   err[fail.Fail] =
        link_modules_nocapture(?s, ?etgt, ?mods[0], 1, 0, nil::*of.DynLib, 0, opath,
        "anon_section_obj"::*u8, LINK_RELOCATABLE, false,
        of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel olr.err) { ret 1; }

    val orb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, opath);

    if (sel orb.err) { ret 1; }
    var ob:      Vector[u8]     = orb.ok;
    var carried: of.ObjectImage;
    val opr:     err[fail.Fail] =
        etgt.of.parse_object(?alloc, ?s.interner, ob.data, ob.len, ?carried);
    if (sel opr.err) {
        vector.dnit[u8](?ob);
        ret 1;
    }

    var saw_section: bool = false;
    var saw_anchor:  bool = false;
    var cr:          u32  = 0;
    for (cr < carried.reloc_count) {
        val rr: *of.Relocation = ?carried.relocations[cr];
        if (of.section_index(rr.section) < carried.section_count
            && carried.sections[of.section_index(rr.section)].kind == of.SK_TEXT) {
            cr = cr + 1;
            cnt;
        }
        if (rr.sym >= carried.symbol_count) {
            obj.dnit(?carried);
            vector.dnit[u8](?ob);
            ret 1;
        }
        val cs: *of.Symbol = ?carried.symbols[rr.sym];
        if (of.section_index(cs.section) >= carried.section_count
            || carried.sections[of.section_index(cs.section)].kind != of.SK_RODATA) {
            obj.dnit(?carried);
            vector.dnit[u8](?ob);
            ret 1;
        }
        if (rr.addend == 8 && cs.name == anon && cs.offset == 0)   { saw_section = true; }
        if (rr.addend == 0 && cs.name == anchor && cs.offset == 8) { saw_anchor = true; }
        cr = cr + 1;
    }
    obj.dnit(?carried);
    vector.dnit[u8](?ob);
    if (!saw_section || !saw_anchor) { ret 1; }

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "anon_section_syms");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    val lr: err[fail.Fail] =
        link_modules_nocapture(?s, ?tgt, ?mods[0], 1, 1, nil::*of.DynLib, 0, tpath, "anon_section_syms"::*u8, LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel lr.err) { ret 1; }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rr.err) { ret 1; }
    var b: Vector[u8] = rr.ok;

    if (b.len < 24) {
        vector.dnit[u8](?b);
        ret 1;
    }
    var site: usize = b.len;
    var scan: usize = 0;
    for (scan + 24 <= b.len) {
        if (b.data[scan] == 0xEE && b.data[scan + 7] == 0xEE) {
            site = scan;
            scan = b.len;
        }
        or { scan = scan + 1; }
    }
    if (site + 24 > b.len) {
        vector.dnit[u8](?b);
        ret 1;
    }

    var via_section: u64 = 0;
    var via_name:    u64 = 0;
    i = 0;
    for (i < 8) {
        via_section = via_section | (b.data[site + 8 + i::usize]::u64 << (i * 8));
        via_name    = via_name | (b.data[site + 16 + i::usize]::u64 << (i * 8));
        i           = i + 1;
    }

    if (via_section == 0 || via_name == 0) {
        vector.dnit[u8](?b);
        ret 1;
    }
    if (via_section != via_name) {
        vector.dnit[u8](?b);
        ret 1;
    }

    vector.dnit[u8](?b);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.patch_relocations:duplicate_coff_section_symbols_stay_distinct" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_10772: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_10772.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "windows", "win64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val text:     intern.StrId = lt_name(?s, ".text");
    val rdata:    intern.StrId = lt_name(?s, ".rdata");
    val data:     intern.StrId = lt_name(?s, ".data");
    val anchor_a: intern.StrId = lt_name(?s, "rdata_anchor_a");
    val anchor_b: intern.StrId = lt_name(?s, "rdata_anchor_b");
    val entry:    intern.StrId = lt_name(?s, tgt.os.entry_symbol);
    if (text == intern.STR_NIL || rdata == intern.STR_NIL || data == intern.STR_NIL) { ret 1; }
    if (anchor_a == intern.STR_NIL || anchor_b == intern.STR_NIL
        || entry == intern.STR_NIL) { ret 1; }

    var tb: [16]u8;
    var ra: [16]u8;
    var rb: [16]u8;
    var db: [40]u8;
    var i:  u32 = 0;
    for (i < 16) {
        tb[i] = 0x90;
        ra[i] = 0xA1;
        rb[i] = 0xB2;
        i     = i + 1;
    }
    i = 0;
    for (i < 40) {
        db[i] = 0;
        i     = i + 1;
    }
    i = 0;
    for (i < 8) {
        db[i] = 0xEE;
        i     = i + 1;
    }

    var secs: [4]of.Section;
    secs[0].name  = text;
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?tb[0];
    secs[0].len   = 16;
    secs[0].align = 16;
    secs[1].name  = rdata;
    secs[1].kind  = of.SK_RODATA;
    secs[1].bytes = ?ra[0];
    secs[1].len   = 16;
    secs[1].align = 16;
    secs[2].name  = rdata;
    secs[2].kind  = of.SK_RODATA;
    secs[2].bytes = ?rb[0];
    secs[2].len   = 16;
    secs[2].align = 16;
    secs[3].name  = data;
    secs[3].kind  = of.SK_DATA;
    secs[3].bytes = ?db[0];
    secs[3].len   = 40;
    secs[3].align = 8;

    var syms: [5]of.Symbol;
    syms[0].name    = rdata;
    syms[0].section = of.section_id(1);
    syms[0].offset  = 0;
    syms[0].size    = 0;
    syms[0].flags   = 0;
    syms[1].name    = rdata;
    syms[1].section = of.section_id(2);
    syms[1].offset  = 0;
    syms[1].size    = 0;
    syms[1].flags   = 0;
    syms[2].name    = anchor_a;
    syms[2].section = of.section_id(1);
    syms[2].offset  = 8;
    syms[2].size    = 0;
    syms[2].flags   = 0;
    syms[3].name    = anchor_b;
    syms[3].section = of.section_id(2);
    syms[3].offset  = 8;
    syms[3].size    = 0;
    syms[3].flags   = 0;
    syms[4].name    = entry;
    syms[4].section = of.section_id(0);
    syms[4].offset  = 0;
    syms[4].size    = 16;
    syms[4].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [4]of.Relocation;
    relocs[0].section = of.section_id(3);
    relocs[0].offset  = 8;
    relocs[0].kind    = of.RK_ABS64;
    relocs[0].sym     = 0;
    relocs[0].addend  = 8;
    relocs[1].section = of.section_id(3);
    relocs[1].offset  = 16;
    relocs[1].kind    = of.RK_ABS64;
    relocs[1].sym     = 2;
    relocs[1].addend  = 0;
    relocs[2].section = of.section_id(3);
    relocs[2].offset  = 24;
    relocs[2].kind    = of.RK_ABS64;
    relocs[2].sym     = 1;
    relocs[2].addend  = 8;
    relocs[3].section = of.section_id(3);
    relocs[3].offset  = 32;
    relocs[3].kind    = of.RK_ABS64;
    relocs[3].sym     = 3;
    relocs[3].addend  = 0;

    var mods: [1]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "coff_section_syms"), ?secs[0], 4,
        ?syms[0], 5, ?relocs[0], 4);

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "coff_section_syms");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    val lr: err[fail.Fail] =
        link_modules_nocapture(?s, ?tgt, ?mods[0], 1, 0, nil::*of.DynLib, 0, tpath,
        "coff_section_syms"::*u8, LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel lr.err) { ret 1; }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rr.err) { ret 1; }
    var b: Vector[u8] = rr.ok;

    var site: usize = b.len;
    var scan: usize = 0;
    for (scan + 40 <= b.len) {
        if (b.data[scan] == 0xEE && b.data[scan + 7] == 0xEE) {
            site = scan;
            scan = b.len;
        }
        or { scan = scan + 1; }
    }
    if (site + 40 > b.len) {
        vector.dnit[u8](?b);
        ret 1;
    }

    var values: [4]u64;
    var v:      u32 = 0;
    for (v < 4) {
        i = 0;
        for (i < 8) {
            values[v] = values[v] | (b.data[site + 8 + v::usize * 8 + i::usize]::u64 << (i * 8));
            i         = i + 1;
        }
        v = v + 1;
    }

    if (values[0] == 0 || values[2] == 0) {
        vector.dnit[u8](?b);
        ret 1;
    }
    if (values[0] != values[1] || values[2] != values[3]) {
        vector.dnit[u8](?b);
        ret 1;
    }
    if (values[0] == values[2]) {
        vector.dnit[u8](?b);
        ret 1;
    }

    vector.dnit[u8](?b);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.combined_image_count:refuses_input_count_overflow" {
    val overflow_r: res[u32, fail.Fail] = combined_image_count(0xFFFFFFFF, 1);
    if (sel overflow_r.ok) { ret 1; }

    val normal_r: res[u32, fail.Fail] = combined_image_count(2, 3);
    if (sel normal_r.err) { ret 2; }
    if (normal_r.ok != 5) { ret 3; }
    ret 0;
}

test "mach.lang.be.linker.link_modules:arm64_import_tail_branch" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_12755: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_12755.err) { ret 2; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "aarch64", "darwin", "aapcs64");
    if (sel tr.err) { ret 3; }
    var tgt:                       target.Target  = tr.ok;
    val pin:                       intern.StrId   = lt_name(?s, "libSystem");
    val imported:                  intern.StrId   = lt_name(?s, "_calloc");
    val register_import_library_r: err[fail.Fail] = session.register_import_library(?s, imported, pin);
    if (sel register_import_library_r.err) { ret 4; }
    var provider: of.DynLib;
    provider.name               = pin;
    provider.soname             = lt_name(?s, "/usr/lib/libSystem.B.dylib");
    provider.include_referenced = true;

    var bytes: [8]u8;
    bin.write_u32_le(?bytes[0], 0, 0x14000000);
    bin.write_u32_le(?bytes[0], 4, 0x94000000);
    var section: of.Section;
    section.name  = lt_name(?s, ".text");
    section.kind  = of.SK_TEXT;
    section.bytes = ?bytes[0];
    section.len   = 8;
    section.align = 4;
    var symbols: [2]of.Symbol;
    symbols[0].name    = lt_name(?s, tgt.os.entry_symbol);
    symbols[0].section = of.section_id(0);
    symbols[0].offset  = 0;
    symbols[0].size    = 8;
    symbols[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    symbols[1].name    = imported;
    symbols[1].section = of.external_section();
    symbols[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;
    var relocations: [2]of.Relocation;
    relocations[0].section = of.section_id(0);
    relocations[0].offset  = 0;
    relocations[0].kind    = of.RK_JUMP26;
    relocations[0].sym     = 1;
    relocations[1].section = of.section_id(0);
    relocations[1].offset  = 4;
    relocations[1].kind    = of.RK_PLT32;
    relocations[1].sym     = 1;
    var module: of.ObjectImage = lt_image(?s, lt_name(?s, "tail_import"),
        ?section, 1, ?symbols[0], 2, ?relocations[0], 1);

    val fr: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "tail_import");
    if (sel fr.err) { ret 5; }
    var file: fixture.Output = fr.ok;
    fin { fixture.dnit(?file); }

    val path:  str = fixture.path(?file);
    var count: u32 = 1;
    for (count <= 2) {
        module.reloc_count = count;
        val linked: err[fail.Fail] = link_modules_nocapture(?s, ?tgt,
            ?module, 1, 1, ?provider, 1, path, "tail_import"::*u8,
            LINK_EXE, true, of.image_options_default(of.SUBSYSTEM_CONSOLE));
        if (sel linked.err) { ret 6; }
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, path);
        if (sel rr.err) { ret 7; }
        var image: Vector[u8] = rr.ok;
        fin { vector.dnit[u8](?image); }
        val text:  usize = lt_macho_section(image.data, "__TEXT", "__text");
        val stubs: usize = lt_macho_section(image.data, "__STUBS", "__stubs");
        if (text == 0 || stubs == 0) { ret 8; }
        val file_offset: usize = bin.read_u32_le(image.data, text + 48)::usize;
        val text_va:     u64   = bin.read_u64_le(image.data, text + 32);
        val stub_va:     u64   = bin.read_u64_le(image.data, stubs + 32);
        if (bin.read_u64_le(image.data, stubs + 40) != 12) { ret 9; }
        var i: u32 = 0;
        for (i < count) {
            val word:   u32 = bin.read_u32_le(image.data, file_offset + i::usize * 4);
            var opcode: u32 = 0x14000000;
            if (i == 1)                        { opcode = 0x94000000; }
            if ((word & 0xFC000000) != opcode) { ret 10; }
            val displacement: i64 = ((word & 0x03FFFFFF)::i32 << 6)::i64 >> 4;
            if ((text_va::i64 + i::i64 * 4 + displacement)::u64 != stub_va) { ret 11; }
            i = i + 1;
        }
        count = count + 1;
    }
    val refused: err[fail.Fail] = link_modules_nocapture(?s, ?tgt,
        ?module, 1, 1, nil::*of.DynLib, 0, path, "tail_import"::*u8,
        LINK_EXE, true, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (!sel refused.err)                                                               { ret 12; }
    if (!str_contains(fail.describe(refused.err), "not among the link's dependencies")) { ret 12; }
    ret 0;
}

test "mach.lang.be.linker.local_got_plan:arm64_function_pointer_slot" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var registry: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?registry); }
    val r_12869: err[fail.Fail] = target.register_all(?registry, target_testing.debug_descriptor);
    if (sel r_12869.err) { ret 2; }
    val selected: res[target.Target, fail.Fail] = target.select(?registry, "aarch64", "linux", "aapcs64");
    if (sel selected.err) { ret 3; }
    var tgt:   target.Target = selected.ok;
    var bytes: [24]u8;
    bin.write_u32_le(?bytes[0], 0, 0x90000000);
    bin.write_u32_le(?bytes[0], 4, 0xF9400000);
    bin.write_u32_le(?bytes[0], 8, 0x94000000);
    bin.write_u32_le(?bytes[0], 12, 0xD65F03C0);
    bin.write_u32_le(?bytes[0], 16, 0xD503201F);
    bin.write_u32_le(?bytes[0], 20, 0xD65F03C0);
    var section: of.Section;
    section.name  = lt_name(?s, ".text");
    section.kind  = of.SK_TEXT;
    section.bytes = ?bytes[0];
    section.len   = 24;
    section.align = 4;
    var symbols: [2]of.Symbol;
    symbols[0].name    = lt_name(?s, tgt.os.entry_symbol);
    symbols[0].section = of.section_id(0);
    symbols[0].offset  = 0;
    symbols[0].size    = 20;
    symbols[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    symbols[1].name    = lt_name(?s, "got_function");
    symbols[1].section = of.section_id(0);
    symbols[1].offset  = 20;
    symbols[1].size    = 4;
    symbols[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var relocs: [3]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].sym     = 1;
    relocs[0].kind    = of.RK_GOT_PAGE21;
    relocs[1].section = of.section_id(0);
    relocs[1].offset  = 4;
    relocs[1].sym     = 1;
    relocs[1].kind    = of.RK_GOT_LO12;
    relocs[2].section = of.section_id(0);
    relocs[2].offset  = 8;
    relocs[2].sym     = 1;
    relocs[2].kind    = of.RK_PLT32;
    var module: of.ObjectImage = lt_image(?s, lt_name(?s, "arm-got"), ?section, 1,
        ?symbols[0], 2, ?relocs[0], 3);
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "arm_got_pointer");
    if (sel created.err) { ret 4; }
    var file: fixture.Output = created.ok;
    fin { fixture.dnit(?file); }

    val linked: err[fail.Fail] = link_modules_nocapture(?s, ?tgt,
        ?module, 1, 0, nil::*of.DynLib, 0, fixture.path(?file), "arm-got"::*u8,
        LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel linked.err) { ret 5; }
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, fixture.path(?file));
    if (sel read.err) { ret 6; }
    var image: Vector[u8] = read.ok;
    fin { vector.dnit[u8](?image); }
    if (image.len < 64) { ret 7; }
    val entry: u64 = bin.read_u64_le(image.data, 24);
    val phoff: u64 = bin.read_u64_le(image.data, 32);
    val phnum: u32 = bin.read_u16_le(image.data, 56)::u32;
    if (bin.read_u16_le(image.data, 54) != 56 || phoff > image.len::u64
        || phnum::u64 > (image.len::u64 - phoff) / 56) { ret 7; }
    var text_off: usize = 0;
    var i:        u32   = 0;
    for (i < phnum) {
        val ph:   usize = phoff::usize + i::usize * 56;
        val va:   u64   = bin.read_u64_le(image.data, ph + 16);
        val size: u64   = bin.read_u64_le(image.data, ph + 32);
        val off:  u64   = bin.read_u64_le(image.data, ph + 8);
        if (bin.read_u32_le(image.data, ph) == 1 && entry >= va && entry - va < size) {
            if (off > image.len::u64 || size > image.len::u64 - off || size - (entry - va) < 12) { ret 7; }
            text_off = (off + entry - va)::usize;
        }
        i = i + 1;
    }
    if (text_off == 0) { ret 8; }
    val adrp: u32 = bin.read_u32_le(image.data, text_off);
    val ldr:  u32 = bin.read_u32_le(image.data, text_off + 4);
    val call: u32 = bin.read_u32_le(image.data, text_off + 8);
    if ((adrp & 0x9F00001F) != 0x90000000 || (ldr & 0xFFC003FF) != 0xF9400000
        || (call & 0xFC000000) != 0x94000000) { ret 9; }
    val page_bits:  u32 = ((adrp >> 29) & 3) | (((adrp >> 5) & 0x7FFFF) << 2);
    val page_delta: i64 = ((page_bits::i32 << 11) >> 11)::i64 * 4096;
    val slot:       u64 = ((entry & 0xFFFFFFFFFFFFF000)::i64 + page_delta)::u64 + ((ldr >> 10) & 0xFFF)::u64 * 8;
    val call_delta: i64 = (((call & 0x03FFFFFF)::i32 << 6) >> 4)::i64;
    val function:   u64 = (entry::i64 + 8 + call_delta)::u64;
    if (function != entry + 20 || (function & 7) != 4 || (slot & 7) != 0 || slot == function) { ret 10; }
    i = 0;
    for (i < phnum) {
        val ph:   usize = phoff::usize + i::usize * 56;
        val va:   u64   = bin.read_u64_le(image.data, ph + 16);
        val size: u64   = bin.read_u64_le(image.data, ph + 32);
        val off:  u64   = bin.read_u64_le(image.data, ph + 8);
        if (bin.read_u32_le(image.data, ph) == 1 && slot >= va && slot - va < size) {
            if (off > image.len::u64 || size > image.len::u64 - off || size - (slot - va) < 8) { ret 11; }
            if (bin.read_u64_le(image.data, (off + slot - va)::usize) != function)             { ret 12; }
            ret 0;
        }
        i = i + 1;
    }
    ret 13;
}

rec TestElfLoad {
    offset:    usize;
    remaining: u64;
}

fun t_elf_load(image: *Vector[u8], address: u64, width: u64) res[TestElfLoad, fail.Fail] {
    if (image.len < 64) { ret res[TestElfLoad, fail.Fail].err{fail.message("short ELF header")}; }
    var phoff:  u64 = bin.read_u64_le(image.data, 32);
    var phnum:  u32 = bin.read_u16_le(image.data, 56)::u32;
    var stride: u32 = 56;
    if (image.data[4] == 1) {
        phoff  = bin.read_u32_le(image.data, 28)::u64;
        phnum  = bin.read_u16_le(image.data, 44)::u32;
        stride = 32;
        if (bin.read_u16_le(image.data, 42) != 32) { ret res[TestElfLoad, fail.Fail].err{fail.message("invalid ELF32 program header")}; }
    }
    or {
        if (image.data[4] != 2 || bin.read_u16_le(image.data, 54) != 56) { ret res[TestElfLoad, fail.Fail].err{fail.message("invalid ELF64 program header")}; }
    }
    if (phoff > image.len::u64 || phnum::u64 > (image.len::u64 - phoff) / stride::u64) {
        ret res[TestElfLoad, fail.Fail].err{fail.message("program headers exceed ELF image")};
    }
    var i: u32 = 0;
    for (i < phnum) {
        val ph:   usize = phoff::usize + i::usize * stride::usize;
        var va:   u64   = 0;
        var size: u64   = 0;
        var off:  u64   = 0;
        if (stride == 32) {
            va   = bin.read_u32_le(image.data, ph + 8)::u64;
            size = bin.read_u32_le(image.data, ph + 16)::u64;
            off  = bin.read_u32_le(image.data, ph + 4)::u64;
        }
        or {
            va   = bin.read_u64_le(image.data, ph + 16);
            size = bin.read_u64_le(image.data, ph + 32);
            off  = bin.read_u64_le(image.data, ph + 8);
        }
        if (bin.read_u32_le(image.data, ph) == 1 && address >= va && address - va < size) {
            if (off > image.len::u64 || size > image.len::u64 - off || size - (address - va) < width) {
                ret res[TestElfLoad, fail.Fail].err{fail.message("load range exceeds ELF image")};
            }
            ret res[TestElfLoad, fail.Fail].ok{TestElfLoad{offset: (off + address - va)::usize, remaining: size - (address - va)}};
        }
        i = i + 1;
    }
    ret res[TestElfLoad, fail.Fail].err{fail.message("ELF address is not file backed")};
}

fun t_riscv_got_pointer(arch: str, abi: str, width: u32) i32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var registry: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?registry); }
    val r_13012: err[fail.Fail] = target.register_all(?registry, target_testing.debug_descriptor);
    if (sel r_13012.err) { ret 2; }
    var system: str = "linux";
    if (width == 4) { system = "freestanding"; }
    val selected: res[target.Target, fail.Fail] = target.select_of(?registry, arch, system, abi, "elf");
    if (sel selected.err) { ret 3; }
    var tgt:   target.Target = selected.ok;
    var bytes: [24]u8;
    bin.write_u32_le(?bytes[0], 0, 0x00000517);
    var load: u32 = 0x00053503;
    if (width == 4) { load = 0x00052503; }
    bin.write_u32_le(?bytes[0], 4, load);
    bin.write_u32_le(?bytes[0], 8, 0x00000097);
    bin.write_u32_le(?bytes[0], 12, 0x000080E7);
    bin.write_u32_le(?bytes[0], 16, 0x00008067);
    bin.write_u32_le(?bytes[0], 20, 0x00008067);
    var section: of.Section;
    section.name  = lt_name(?s, ".text");
    section.kind  = of.SK_TEXT;
    section.bytes = ?bytes[0];
    section.len   = 24;
    section.align = 4;
    var symbols: [3]of.Symbol;
    symbols[0].name    = lt_name(?s, tgt.os.entry_symbol);
    symbols[0].section = of.section_id(0);
    symbols[0].offset  = 0;
    symbols[0].size    = 20;
    symbols[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    symbols[1].name    = lt_name(?s, "got_function");
    symbols[1].section = of.section_id(0);
    symbols[1].offset  = 20;
    symbols[1].size    = 4;
    symbols[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    symbols[2].name    = lt_name(?s, ".Lgot_high");
    symbols[2].section = of.section_id(0);
    symbols[2].offset  = 0;
    var relocs: [3]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].sym     = 1;
    relocs[0].kind    = of.RK_GOT_PCREL_HI20;
    relocs[1].section = of.section_id(0);
    relocs[1].offset  = 4;
    relocs[1].sym     = 2;
    relocs[1].kind    = of.RK_PCREL_LO12_I;
    relocs[2].section = of.section_id(0);
    relocs[2].offset  = 8;
    relocs[2].sym     = 1;
    relocs[2].kind    = of.RK_PLT32;
    var module: of.ObjectImage = lt_image(?s, lt_name(?s, "riscv-got"), ?section, 1,
        ?symbols[0], 3, ?relocs[0], 3);
    val r_13044: err[fail.Fail] = rel.normalize_image(tgt.isa, ?alloc, ?module);
    if (sel r_13044.err) { ret 4; }
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "riscv_got_pointer");
    if (sel created.err) { ret 5; }
    var file: fixture.Output = created.ok;
    fin { fixture.dnit(?file); }

    val linked: err[fail.Fail] = link_modules_nocapture(?s, ?tgt,
        ?module, 1, 0, nil::*of.DynLib, 0, fixture.path(?file), "riscv-got"::*u8,
        LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel linked.err) {
        val message: str = fail.describe(linked.err);
        os.write(2, message::*u8, str_len(message));
        ret 6;
    }
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, fixture.path(?file));
    if (sel read.err) { ret 7; }
    var image: Vector[u8] = read.ok;
    fin { vector.dnit[u8](?image); }
    if (image.len < 64) { ret 8; }
    var entry: u64 = bin.read_u64_le(image.data, 24);
    if (width == 4) { entry = bin.read_u32_le(image.data, 24)::u64; }
    val code: res[TestElfLoad, fail.Fail] = t_elf_load(?image, entry, 16);
    if (sel code.err) { ret 8; }
    val off:       usize = code.ok.offset;
    val high:      u32   = bin.read_u32_le(image.data, off);
    val low:       u32   = bin.read_u32_le(image.data, off + 4);
    val call_high: u32   = bin.read_u32_le(image.data, off + 8);
    val call_low:  u32   = bin.read_u32_le(image.data, off + 12);
    if ((high & 0xFFF) != 0x517 || (low & 0xFFFFF) != load
        || (call_high & 0xFFF) != 0x97 || (call_low & 0xFFFFF) != 0x80E7) { ret 9; }
    val slot:     u64 = (entry::i64 + (high & 0xFFFFF000)::i32::i64 + (low::i32 >> 20)::i64)::u64;
    val function: u64 = (entry::i64 + 8 + (call_high & 0xFFFFF000)::i32::i64 + (call_low::i32 >> 20)::i64)::u64;
    if (function != entry + 20 || slot == function || slot % width::u64 != 0) { ret 10; }
    val pointer: res[TestElfLoad, fail.Fail] = t_elf_load(?image, slot, width::u64);
    if (sel pointer.err) { ret 11; }
    val found: TestElfLoad = pointer.ok;
    if (found.remaining != width::u64) { ret 12; }
    var stored: u64 = 0;
    if (width == 4)         { stored = bin.read_u32_le(image.data, found.offset)::u64; }
    or                      { stored = bin.read_u64_le(image.data, found.offset); }
    if (stored != function) { ret 13; }
    ret 0;
}

test "mach.lang.be.linker.local_got_plan:riscv32_paired_pointer_slot" {
    ret t_riscv_got_pointer("riscv32", "ilp32", 4);
}

test "mach.lang.be.linker.local_got_plan:riscv64_paired_pointer_slot" {
    ret t_riscv_got_pointer("riscv64", "lp64", 8);
}
