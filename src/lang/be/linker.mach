fun validate_link_inputs(images: *of.ObjectImage, count: u32) err[fail.Fail] {
    if (count > 0 && images == nil) {
        ret err[fail.Fail].err{fail.message("link: nil input object collection")};
    }
    var i: u32 = 0;
    for (i < count) {
        val valid: err[fail.Fail] = of.validate_object_view(?images[i]);
        if (sel valid.err) {
            ret valid;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun link(s: *session.Session, tgt: *target.Target, obj_paths: **u8,
             obj_count: u32, dynlibs: *of.DynLib, dynlib_count: u32,
             destination: *publication.Destination, name: *u8, mode: LinkMode, pie: bool,
             image_options: of.ImageOptions) err[fail.Fail] {
    if (s == nil)      { ret err[fail.Fail].err{fail.message("link: nil session")}; }
    if (tgt == nil)    { ret err[fail.Fail].err{fail.message("link: nil target")}; }
    if (tgt.of == nil) { ret err[fail.Fail].err{fail.message("link: target has no object-format vtable")}; }
    if (tgt.os == nil) { ret err[fail.Fail].err{fail.message("link: target has no OS vtable")}; }
    if (!link_mode_valid(mode)) { ret err[fail.Fail].err{fail.message("link: invalid link mode")}; }
    if (obj_paths == nil || obj_count == 0) {
        ret err[fail.Fail].err{fail.message("link: no input objects")};
    }

    val alloc: *A.Allocator = s.alloc;

    var required: intern.StrId = intern.STR_NIL;
    if (mode == LINK_EXE) {
        val er: res[intern.StrId, A.Error] = intern.intern(?s.interner, tgt.os.entry_symbol);
        if (sel er.err) {
            ret err[fail.Fail].err{fail.refused(er.err)};
        }
        required = er.ok;
    }

    var module_count: u32 = 0;
    val read_r: res[*of.ObjectImage, fail.Fail] =
        read_objects(s, tgt, obj_paths, obj_count, nil::*of.ObjectImage, 0,
                     required, ?module_count);
    if (sel read_r.err) {
        ret err[fail.Fail].err{read_r.err};
    }
    val modules: *of.ObjectImage = read_r.ok;

    val r: err[fail.Fail] =
        link_modules_nocapture(s, tgt, modules, module_count, 0, dynlibs, dynlib_count,
                     destination, name, mode, pie, image_options);
    free_modules(alloc, modules, module_count);
    ret r;
}

pub rec LinkedImage {
    bytes:        *u8;
    len:          usize;
    base:         u64;
    symbols:      *of.SymtabEntry;
    symbol_count: u32;
}

pub fun linked_image_dnit(img: *LinkedImage, alloc: *A.Allocator) {
    if (img == nil) { ret; }
    if (img.bytes != nil && img.len > 0) { A.deallocate[u8](alloc, img.bytes, img.len); }
    if (img.symbols != nil && img.symbol_count > 0) {
        A.deallocate[of.SymtabEntry](alloc, img.symbols, img.symbol_count::usize);
    }
    img.bytes        = nil;
    img.len          = 0;
    img.base         = 0;
    img.symbols      = nil;
    img.symbol_count = 0;
}

pub fun linked_image_symbol(img: *LinkedImage, itn: *intern.Interner, name: str) opt[u64] {
    if (img == nil || img.symbols == nil) { ret opt[u64].none{}; }
    var i: u32 = 0;
    for (i < img.symbol_count) {
        val found: opt[str] = intern.lookup(itn, img.symbols[i].name);
        if (sel found.some && str_equals(found.some, name)) {
            ret opt[u64].some{img.symbols[i].vaddr};
        }
        i = i + 1;
    }
    ret opt[u64].none{};
}

pub fun link_images_captured(s: *session.Session, tgt: *target.Target, images: *of.ObjectImage,
                             image_count: u32, dynlibs: *of.DynLib, dynlib_count: u32,
                             name: *u8, pie: bool, image_options: of.ImageOptions,
                             out: *LinkedImage) err[fail.Fail] {
    if (out == nil) { ret err[fail.Fail].err{fail.message("link: nil capture target")}; }
    if (out.bytes != nil || out.symbols != nil) {
        ret err[fail.Fail].err{fail.message("link: capture target is not empty")};
    }
    out.bytes        = nil;
    out.len          = 0;
    out.base         = 0;
    out.symbols      = nil;
    out.symbol_count = 0;

    if (s == nil)      { ret err[fail.Fail].err{fail.message("link: nil session")}; }
    if (tgt == nil)    { ret err[fail.Fail].err{fail.message("link: nil target")}; }
    if (tgt.of == nil) { ret err[fail.Fail].err{fail.message("link: target has no object-format vtable")}; }
    if (tgt.os == nil) { ret err[fail.Fail].err{fail.message("link: target has no OS vtable")}; }
    if (images == nil || image_count == 0) {
        ret err[fail.Fail].err{fail.message("link: no input objects")};
    }
    if (!tgt.of.produces_image || tgt.of.emit_exec_image == nil) {
        ret err[fail.Fail].err{fail.message("link: this object format cannot hand back a linked image")};
    }

    ret link_modules(s, tgt, images, image_count, image_count, dynlibs,
                     dynlib_count, nil::*publication.Destination, name, LINK_EXE, pie, image_options, out);
}

test "mach.lang.be.linker.link_images_captured:rejects_a_dirty_capture_target" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var stale: [4]u8;
    var out: LinkedImage;
    out.bytes        = ?stale[0];
    out.len          = 4;
    out.base         = 0;
    out.symbols      = nil;
    out.symbol_count = 0;

    val r: err[fail.Fail] = link_images_captured(
        nil::*session.Session, nil::*target.Target, nil::*of.ObjectImage, 0,
        nil::*of.DynLib, 0, ""::*u8, false,
        of.image_options_default(of.SUBSYSTEM_CONSOLE), ?out);
    if (sel r.ok) { ret 1; }
    if (!str_contains(fail.describe(r.err), "not empty")) { ret 1; }
    if (out.bytes != ?stale[0]) { ret 1; }
    if (out.len != 4)           { ret 1; }
    ret 0;
}

pub fun link_images(s: *session.Session, tgt: *target.Target, images: *of.ObjectImage,
                    image_count: u32, dynlibs: *of.DynLib, dynlib_count: u32,
                    destination: *publication.Destination, name: *u8, mode: LinkMode, pie: bool,
                    image_options: of.ImageOptions) err[fail.Fail] {
    if (s == nil)      { ret err[fail.Fail].err{fail.message("link: nil session")}; }
    if (tgt == nil)    { ret err[fail.Fail].err{fail.message("link: nil target")}; }
    if (tgt.of == nil) { ret err[fail.Fail].err{fail.message("link: target has no object-format vtable")}; }
    if (tgt.os == nil) { ret err[fail.Fail].err{fail.message("link: target has no OS vtable")}; }
    if (!link_mode_valid(mode)) { ret err[fail.Fail].err{fail.message("link: invalid link mode")}; }
    if (images == nil || image_count == 0) {
        ret err[fail.Fail].err{fail.message("link: no input objects")};
    }
    ret link_modules_nocapture(s, tgt, images, image_count, image_count, dynlibs,
                     dynlib_count, destination, name, mode, pie, image_options);
}

pub fun link_mixed(s: *session.Session, tgt: *target.Target,
                   images: *of.ObjectImage, image_count: u32,
                   obj_paths: **u8, obj_count: u32,
                   dynlibs: *of.DynLib, dynlib_count: u32,
                   destination: *publication.Destination, name: *u8, mode: LinkMode, pie: bool,
                   image_options: of.ImageOptions) err[fail.Fail] {
    if (s == nil)      { ret err[fail.Fail].err{fail.message("link: nil session")}; }
    if (tgt == nil)    { ret err[fail.Fail].err{fail.message("link: nil target")}; }
    if (tgt.of == nil) { ret err[fail.Fail].err{fail.message("link: target has no object-format vtable")}; }
    if (tgt.os == nil) { ret err[fail.Fail].err{fail.message("link: target has no OS vtable")}; }
    if (!link_mode_valid(mode)) { ret err[fail.Fail].err{fail.message("link: invalid link mode")}; }
    if (images == nil || image_count == 0) {
        ret err[fail.Fail].err{fail.message("link: no input objects")};
    }

    val alloc: *A.Allocator = s.alloc;

    var required: intern.StrId = intern.STR_NIL;
    if (mode == LINK_EXE) {
        val er: res[intern.StrId, A.Error] = intern.intern(?s.interner, tgt.os.entry_symbol);
        if (sel er.err) {
            ret err[fail.Fail].err{fail.refused(er.err)};
        }
        required = er.ok;
    }

    var ext_count: u32 = 0;
    var ext: *of.ObjectImage = nil;
    if (obj_paths != nil && obj_count > 0) {
        val read_r: res[*of.ObjectImage, fail.Fail] =
            read_objects(s, tgt, obj_paths, obj_count, images, image_count,
                         required, ?ext_count);
        if (sel read_r.err) {
            ret err[fail.Fail].err{read_r.err};
        }
        ext = read_r.ok;
    }

    val total_r: res[u32, fail.Fail] = combined_image_count(image_count, ext_count);
    if (sel total_r.err) {
        free_modules(alloc, ext, ext_count);
        ret err[fail.Fail].err{total_r.err};
    }
    val total: u32 = total_r.ok;
    val cr: res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](alloc, total::usize);
    if (sel cr.err) {
        free_modules(alloc, ext, ext_count);
        ret err[fail.Fail].err{fail.refused(cr.err)};
    }
    val combined: *of.ObjectImage = cr.ok;

    var i: u32 = 0;
    for (i < image_count) { combined[i] = images[i]; i = i + 1; }
    var j: u32 = 0;
    for (j < ext_count) { combined[image_count + j] = ext[j]; j = j + 1; }

    val r: err[fail.Fail] =
        link_modules_nocapture(s, tgt, combined, total, image_count, dynlibs, dynlib_count,
                     destination, name, mode, pie, image_options);

    free_modules(alloc, ext, ext_count);
    A.deallocate[of.ObjectImage](alloc, combined, total::usize);
    ret r;
}

fun image_machine_flags(s: *session.Session, tgt: *target.Target,
                        modules: *of.ObjectImage, module_count: u32) res[u32, fail.Fail] {
    if (!isa.declares_machine_flags(tgt.isa)) { ret res[u32, fail.Fail].ok{0}; }

    val abi_mask: u32 = isa.machine_flags(tgt.isa, 0, false)
                      | isa.machine_flags(tgt.isa, 32, false)
                      | isa.machine_flags(tgt.isa, 64, false);
    val abi_bits: u32 = isa.machine_flags(tgt.isa, tgt.abi.float_arg_bits, false) & abi_mask;

    var feature_bits: u32 = 0;
    var i: u32 = 0;
    for (i < module_count) {
        val got: u32 = modules[i].machine_flags;
        if ((got & abi_mask) != abi_bits) {
            ret res[u32, fail.Fail].err{fail.message(machine_flags_mismatch_message(s, tgt, ?modules[i],
                                                              got & abi_mask, abi_bits))};
        }
        feature_bits = feature_bits | (got & ~abi_mask);
        i = i + 1;
    }
    ret res[u32, fail.Fail].ok{abi_bits | feature_bits};
}

fun image_attributes(s: *session.Session, tgt: *target.Target, modules: *of.ObjectImage,
                     module_count: u32, out_len: *u32) res[*u8, fail.Fail] {
    @out_len = 0;
    if (!isa.declares_attributes(tgt.isa)) { ret res[*u8, fail.Fail].ok{nil}; }

    var acc: *u8 = nil;
    var acc_len: u32 = 0;
    var i: u32 = 0;
    for (i < module_count) {
        if (modules[i].attributes == nil || modules[i].attributes_len == 0) { i = i + 1; cnt; }
        var next_len: u32 = 0;
        val mr: res[*u8, fail.Fail] = isa.merge_attributes(tgt.isa, s.alloc, acc, acc_len,
                                                         modules[i].attributes,
                                                         modules[i].attributes_len, ?next_len);
        if (sel mr.err) {
            if (acc != nil && acc_len > 0) { A.deallocate[u8](s.alloc, acc, acc_len::usize); }
            ret mr;
        }
        val merged: *u8 = mr.ok;
        if (acc != nil && acc_len > 0 && acc != merged) { A.deallocate[u8](s.alloc, acc, acc_len::usize); }
        acc = merged;
        acc_len = next_len;
        i = i + 1;
    }
    @out_len = acc_len;
    ret res[*u8, fail.Fail].ok{acc};
}

fun link_modules_nocapture(s: *session.Session, tgt: *target.Target, modules: *of.ObjectImage,
                           module_count: u32, codegen_count: u32,
                           dynlibs: *of.DynLib, dynlib_count: u32,
                           destination: *publication.Destination, name: *u8, mode: LinkMode, pie_opt_in: bool,
                           image_options: of.ImageOptions) err[fail.Fail] {
    ret link_modules(s, tgt, modules, module_count, codegen_count, dynlibs, dynlib_count,
                     destination, name, mode, pie_opt_in, image_options, nil::*LinkedImage);
}

fun synthesize_common_storage(s: *session.Session, modules: *of.ObjectImage,
                              module_count: u32, mode: LinkMode,
                              out: *of.ObjectImage) res[bool, fail.Fail] {
    if (mode == LINK_RELOCATABLE || modules == nil || module_count == 0) {
        ret res[bool, fail.Fail].ok{false};
    }
    val alloc: *A.Allocator = s.alloc;

    var defined: map.Map[intern.StrId, u32] =
        map.init[intern.StrId, u32](alloc, map.hash_u32, map.eq_u32);
    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if (of.section_is_absolute(sym.section)
                || (!of.section_is_external(sym.section) && of.section_index(sym.section) < modules[m].section_count)) {
                val get_r: opt[*u32] = map.get[intern.StrId, u32](?defined, ?sym.name);
                if (sel get_r.none) {
                    val di: res[bool, A.Error] = map.insert[intern.StrId, u32](?defined, sym.name, 0);
                    if (sel di.err) {
                        map.dnit[intern.StrId, u32](?defined);
                        ret res[bool, fail.Fail].err{fail.refused(di.err)};
                    }
                }
            }
            sy = sy + 1;
        }
        m = m + 1;
    }

    var slot: map.Map[intern.StrId, u32] =
        map.init[intern.StrId, u32](alloc, map.hash_u32, map.eq_u32);
    var names: Vector[intern.StrId] = vector.init[intern.StrId](alloc);
    var sizes: Vector[u32] = vector.init[u32](alloc);
    var aligns: Vector[u32] = vector.init[u32](alloc);

    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if ((sym.flags & of.SYM_OBJ_FLAG_COMMON) == 0) { sy = sy + 1; cnt; }
            val get_r2: opt[*u32] = map.get[intern.StrId, u32](?defined, ?sym.name);
            if (sel get_r2.some) { sy = sy + 1; cnt; }

            var al: u32 = sym.align;
            if (al == 0) { al = 1; }
            val ex: opt[*u32] = map.get[intern.StrId, u32](?slot, ?sym.name);
            if (sel ex.some) {
                val at: u32 = @ex.some;
                if (sym.size > sizes.data[at]) { sizes.data[at] = sym.size; }
                if (al > aligns.data[at])      { aligns.data[at] = al; }
                sy = sy + 1;
                cnt;
            }
            val ins: res[bool, A.Error] = map.insert[intern.StrId, u32](?slot, sym.name, names.len::u32);
            if (sel ins.err) {
                map.dnit[intern.StrId, u32](?slot);
                map.dnit[intern.StrId, u32](?defined);
                vector.dnit[intern.StrId](?names); vector.dnit[u32](?sizes); vector.dnit[u32](?aligns);
                ret res[bool, fail.Fail].err{fail.refused(ins.err)};
            }
            val push_n: res[usize, A.Error] = vector.push[intern.StrId](?names, sym.name);
            if (sel push_n.err) {
                map.dnit[intern.StrId, u32](?slot);
                map.dnit[intern.StrId, u32](?defined);
                vector.dnit[intern.StrId](?names); vector.dnit[u32](?sizes); vector.dnit[u32](?aligns);
                ret res[bool, fail.Fail].err{fail.refused(push_n.err)};
            }
            val push_s: res[usize, A.Error] = vector.push[u32](?sizes, sym.size);
            if (sel push_s.err) {
                map.dnit[intern.StrId, u32](?slot);
                map.dnit[intern.StrId, u32](?defined);
                vector.dnit[intern.StrId](?names); vector.dnit[u32](?sizes); vector.dnit[u32](?aligns);
                ret res[bool, fail.Fail].err{fail.refused(push_s.err)};
            }
            val push_a: res[usize, A.Error] = vector.push[u32](?aligns, al);
            if (sel push_a.err) {
                map.dnit[intern.StrId, u32](?slot);
                map.dnit[intern.StrId, u32](?defined);
                vector.dnit[intern.StrId](?names); vector.dnit[u32](?sizes); vector.dnit[u32](?aligns);
                ret res[bool, fail.Fail].err{fail.refused(push_a.err)};
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    map.dnit[intern.StrId, u32](?slot);
    map.dnit[intern.StrId, u32](?defined);

    if (names.len == 0) {
        vector.dnit[intern.StrId](?names); vector.dnit[u32](?sizes); vector.dnit[u32](?aligns);
        ret res[bool, fail.Fail].ok{false};
    }

    var total: layout.CheckedOffset[CommonStorageUnit] = layout.offset[CommonStorageUnit](0::usize);
    var sec_align: u32 = 1;
    var offs: Vector[u32] = vector.init[u32](alloc);
    var n: usize = 0;
    for (n < names.len) {
        if (aligns.data[n] > sec_align) { sec_align = aligns.data[n]; }
        val align_r: res[layout.CheckedAlignment[CommonStorageUnit], layout.CheckCause] =
            layout.alignment[CommonStorageUnit](aligns.data[n]::usize);
        if (sel align_r.err) {
            vector.dnit[u32](?offs);
            vector.dnit[intern.StrId](?names); vector.dnit[u32](?sizes); vector.dnit[u32](?aligns);
            ret res[bool, fail.Fail].err{fail.message("link: common storage member has invalid alignment")};
        }
        val aligned_r: res[layout.CheckedOffset[CommonStorageUnit], layout.CheckCause] =
            layout.align_offset_up[CommonStorageUnit](total,
                align_r.ok);
        if (sel aligned_r.err) {
            vector.dnit[u32](?offs);
            vector.dnit[intern.StrId](?names); vector.dnit[u32](?sizes); vector.dnit[u32](?aligns);
            ret res[bool, fail.Fail].err{fail.message("link: common storage layout overflow")};
        }
        total = aligned_r.ok;
        if (total.value > 0x7FFFFFFF) {
            vector.dnit[u32](?offs);
            vector.dnit[intern.StrId](?names); vector.dnit[u32](?sizes); vector.dnit[u32](?aligns);
            ret res[bool, fail.Fail].err{fail.message("link: common storage exceeds 2 GiB")};
        }
        val push_o: res[usize, A.Error] = vector.push[u32](?offs, total.value::u32);
        if (sel push_o.err) {
            vector.dnit[u32](?offs);
            vector.dnit[intern.StrId](?names); vector.dnit[u32](?sizes); vector.dnit[u32](?aligns);
            ret res[bool, fail.Fail].err{fail.refused(push_o.err)};
        }
        val grown_r: res[layout.CheckedOffset[CommonStorageUnit], layout.CheckCause] =
            layout.offset_add[CommonStorageUnit](total, layout.count[CommonStorageUnit](sizes.data[n]::usize));
        if (sel grown_r.err) {
            vector.dnit[u32](?offs);
            vector.dnit[intern.StrId](?names); vector.dnit[u32](?sizes); vector.dnit[u32](?aligns);
            ret res[bool, fail.Fail].err{fail.message("link: common storage layout overflow")};
        }
        total = grown_r.ok;
        n = n + 1;
    }

    val image_name_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "<common-storage>");
    val section_name_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, ".bss");
    if (sel image_name_r.err) {
        vector.dnit[u32](?offs);
        vector.dnit[intern.StrId](?names); vector.dnit[u32](?sizes); vector.dnit[u32](?aligns);
        ret res[bool, fail.Fail].err{fail.message("link: could not intern the common storage names")};
    }
    if (sel section_name_r.err) {
        vector.dnit[u32](?offs);
        vector.dnit[intern.StrId](?names); vector.dnit[u32](?sizes); vector.dnit[u32](?aligns);
        ret res[bool, fail.Fail].err{fail.message("link: could not intern the common storage names")};
    }
    val image_r: res[of.ObjectImage, fail.Fail] = obj.image_init(alloc, ?s.interner, image_name_r.ok);
    if (sel image_r.err) {
        vector.dnit[u32](?offs);
        vector.dnit[intern.StrId](?names); vector.dnit[u32](?sizes); vector.dnit[u32](?aligns);
        ret res[bool, fail.Fail].err{image_r.err};
    }
    @out = image_r.ok;

    var sec: of.Section;
    sec.name  = section_name_r.ok;
    sec.kind  = of.SK_BSS;
    sec.bytes = nil;
    sec.len   = total.value::u32;
    sec.align = sec_align;
    sec.flags = 0;
    val sec_r: res[u32, fail.Fail] = obj.section_install(out, ?sec);
    if (sel sec_r.err) {
        vector.dnit[u32](?offs);
        vector.dnit[intern.StrId](?names); vector.dnit[u32](?sizes); vector.dnit[u32](?aligns);
        obj.dnit(out);
        ret res[bool, fail.Fail].err{sec_r.err};
    }
    val sec_ix: u32 = sec_r.ok;

    n = 0;
    for (n < names.len) {
        var osym: of.Symbol;
        osym.name    = names.data[n];
        osym.section = of.section_id(sec_ix);
        osym.offset  = offs.data[n];
        osym.size    = sizes.data[n];
        osym.flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
        osym.fallback = of.SYMBOL_NONE;
        osym.align    = aligns.data[n];
        val sa: res[u32, fail.Fail] = obj.symbol_add(out, osym);
        if (sel sa.err) {
            vector.dnit[u32](?offs);
            vector.dnit[intern.StrId](?names); vector.dnit[u32](?sizes); vector.dnit[u32](?aligns);
            obj.dnit(out);
            ret res[bool, fail.Fail].err{sa.err};
        }
        n = n + 1;
    }

    vector.dnit[u32](?offs);
    vector.dnit[intern.StrId](?names); vector.dnit[u32](?sizes); vector.dnit[u32](?aligns);
    val valid: err[fail.Fail] = of.validate_owned_object_or_dnit(out);
    if (sel valid.err) {
        ret res[bool, fail.Fail].err{valid.err};
    }
    ret res[bool, fail.Fail].ok{true};
}

fun link_modules(s: *session.Session, tgt: *target.Target, modules: *of.ObjectImage,
                 module_count: u32, codegen_count: u32,
                 dynlibs: *of.DynLib, dynlib_count: u32,
                 destination: *publication.Destination, name: *u8, mode: LinkMode, pie_opt_in: bool,
                 image_options: of.ImageOptions, capture: *LinkedImage) err[fail.Fail] {
    if (!link_mode_valid(mode)) { ret err[fail.Fail].err{fail.message("link: invalid link mode")}; }
    val inputs_valid: err[fail.Fail] = validate_link_inputs(modules, module_count);
    if (sel inputs_valid.err) {
        ret inputs_valid;
    }
    val alloc0: *A.Allocator = s.alloc;
    var commons: of.ObjectImage;
    val made_r: res[bool, fail.Fail] = synthesize_common_storage(s, modules, module_count, mode, ?commons);
    if (sel made_r.err) { ret err[fail.Fail].err{made_r.err}; }
    if (!made_r.ok) {
        ret link_modules_with_commons(s, tgt, modules, module_count, codegen_count,
                                      dynlibs, dynlib_count, destination, name, mode,
                                      pie_opt_in, image_options, capture);
    }

    if (module_count == 0xFFFFFFFF) {
        obj.dnit(?commons);
        ret err[fail.Fail].err{fail.message("link: too many input objects to append common storage")};
    }
    val all_r: res[*of.ObjectImage, A.Error] =
        A.allocate[of.ObjectImage](alloc0, (module_count + 1)::usize);
    if (sel all_r.err) {
        obj.dnit(?commons);
        ret err[fail.Fail].err{fail.refused(all_r.err)};
    }
    val all: *of.ObjectImage = all_r.ok;
    var ci: u32 = 0;
    for (ci < module_count) {
        all[ci] = modules[ci];
        ci = ci + 1;
    }
    all[module_count] = commons;

    val linked: err[fail.Fail] = link_modules_with_commons(
        s, tgt, all, module_count + 1, codegen_count, dynlibs, dynlib_count,
        destination, name, mode, pie_opt_in, image_options, capture);
    A.deallocate[of.ObjectImage](alloc0, all, (module_count + 1)::usize);
    obj.dnit(?commons);
    ret linked;
}

fun opts_attributes_release(alloc: *A.Allocator, opts: *of.ImageOptions) {
    if (opts.attributes != nil && opts.attributes_len > 0) {
        A.deallocate[u8](alloc, opts.attributes, opts.attributes_len::usize);
    }
}

fun link_modules_with_commons(s: *session.Session, tgt: *target.Target, modules: *of.ObjectImage,
                 module_count: u32, codegen_count: u32,
                 dynlibs: *of.DynLib, dynlib_count: u32,
                 destination: *publication.Destination, name: *u8, mode: LinkMode, pie_opt_in: bool,
                 image_options: of.ImageOptions, capture: *LinkedImage) err[fail.Fail] {
    val alloc: *A.Allocator = s.alloc;
    if (mode != LINK_RELOCATABLE && modules != nil) {
        var ni: u32 = 0;
        for (ni < module_count) {
            val nr: err[fail.Fail] = rel.normalize_image(tgt.isa, alloc, ?modules[ni]);
            if (sel nr.err) { ret nr; }
            ni = ni + 1;
        }
    }
    var attribute_input: u32 = 0;
    for (attribute_input < module_count) {
        val input_attributes_valid: err[fail.Fail] = isa.validate_attributes(
            tgt.isa, ?tgt.model, modules[attribute_input].attributes, modules[attribute_input].attributes_len,
            modules[attribute_input].machine_flags);
        if (sel input_attributes_valid.err) { ret input_attributes_valid; }
        attribute_input = attribute_input + 1;
    }
    val mf_r: res[u32, fail.Fail] = image_machine_flags(s, tgt, modules, module_count);
    if (sel mf_r.err) { ret err[fail.Fail].err{mf_r.err}; }
    var opts: of.ImageOptions = image_options;
    opts.machine_flags = mf_r.ok;
    var attr_len: u32 = 0;
    val at_r: res[*u8, fail.Fail] = image_attributes(s, tgt, modules, module_count, ?attr_len);
    if (sel at_r.err) { ret err[fail.Fail].err{at_r.err}; }
    opts.attributes = at_r.ok;
    opts.attributes_len = attr_len;
    val attributes_valid: err[fail.Fail] = isa.validate_attributes(tgt.isa, ?tgt.model, opts.attributes, attr_len, opts.machine_flags);
    if (sel attributes_valid.err) {
        opts_attributes_release(alloc, ?opts);
        ret attributes_valid;
    }
    if (mode == LINK_RELOCATABLE) {
        val combined: res[of.ObjectImage, fail.Fail] = relocatable.combine(
            alloc, ?s.interner, modules, module_count, opts.machine_flags,
            opts.attributes, opts.attributes_len);
        opts_attributes_release(alloc, ?opts);
        if (sel combined.err) {
            ret err[fail.Fail].err{combined.err};
        }
        var image: of.ObjectImage = combined.ok;
        fin { obj.dnit(?image); }
        ret obj.emit_image(?image, tgt, destination);
    }
    var indirect_input: u32 = 0;
    for (indirect_input < module_count) {
        if (modules[indirect_input].indirect_count != 0) {
            opts_attributes_release(alloc, ?opts);
            ret err[fail.Fail].err{fail.message("link: native indirect symbol sections require relocatable output")};
        }
        indirect_input = indirect_input + 1;
    }
    opts.mapped_by_loader = tgt.os.mapped_by_loader;
    opts.stack_reserve = tgt.stack_reserve;
    opts.stack_commit  = tgt.stack_commit;
    var local_atoms: AtomPlan;
    init_atom_plan(?local_atoms);
    var pre_atoms: *AtomPlan = nil;
    var local_sec_base: *u32 = nil;
    if (!str_empty(tgt.of.import_address_prefix) && mode != LINK_RELOCATABLE
        && modules != nil && module_count > 0) {
        val sb_r: res[*u32, A.Error] =
            A.zallocate[u32](alloc, module_count::usize);
        if (sel sb_r.err) {
            opts_attributes_release(alloc, ?opts);
            ret err[fail.Fail].err{fail.refused(sb_r.err)};
        }
        local_sec_base = sb_r.ok;
        val local_sec_total_r: res[u32, fail.Fail] = total_sections(modules, module_count);
        if (sel local_sec_total_r.err) {
            A.deallocate[u32](alloc, local_sec_base, module_count::usize);
            free_atom_plan(alloc, ?local_atoms);
            opts_attributes_release(alloc, ?opts);
            ret err[fail.Fail].err{local_sec_total_r.err};
        }
        val atom_r: err[fail.Fail] = build_atom_plan(
            s, modules, module_count, codegen_count, local_sec_base,
            local_sec_total_r.ok, true, tgt.isa, ?local_atoms);
        if (sel atom_r.err) {
            A.deallocate[u32](alloc, local_sec_base, module_count::usize);
            free_atom_plan(alloc, ?local_atoms);
            opts_attributes_release(alloc, ?opts);
            ret atom_r;
        }
        pre_atoms = ?local_atoms;
    }

    var local_imports: of.ObjectImage;
    val made_r: res[bool, fail.Fail] = synthesize_local_imports(
        s, tgt.of.import_address_prefix, modules, module_count, mode,
        local_sec_base, ?local_atoms, ?local_imports);
    if (local_sec_base != nil) {
        A.deallocate[u32](alloc, local_sec_base, module_count::usize);
    }
    if (sel made_r.err) {
        free_atom_plan(alloc, ?local_atoms);
        opts_attributes_release(alloc, ?opts);
        ret err[fail.Fail].err{made_r.err};
    }
    if (!made_r.ok) {
        val linked: err[fail.Fail] = link_modules_core(
            s, tgt, modules, module_count, codegen_count,
            dynlibs, dynlib_count, destination, name, mode, pie_opt_in, opts,
            pre_atoms, capture);
        free_atom_plan(alloc, ?local_atoms);
        opts_attributes_release(alloc, ?opts);
        ret linked;
    }

    if (module_count == 0xFFFFFFFF) {
        obj.dnit(?local_imports);
        free_atom_plan(alloc, ?local_atoms);
        opts_attributes_release(alloc, ?opts);
        ret err[fail.Fail].err{fail.message("link: too many input objects for local import pointers")};
    }
    val all_r: res[*of.ObjectImage, A.Error] =
        A.allocate[of.ObjectImage](alloc, (module_count + 1)::usize);
    if (sel all_r.err) {
        obj.dnit(?local_imports);
        free_atom_plan(alloc, ?local_atoms);
        opts_attributes_release(alloc, ?opts);
        ret err[fail.Fail].err{fail.refused(all_r.err)};
    }
    val all: *of.ObjectImage = all_r.ok;
    var i: u32 = 0;
    for (i < module_count) {
        all[i] = modules[i];
        i = i + 1;
    }
    all[module_count] = local_imports;

    val linked: err[fail.Fail] = link_modules_core(
        s, tgt, all, module_count + 1, codegen_count,
        dynlibs, dynlib_count, destination, name, mode, pie_opt_in, opts,
        pre_atoms, capture);
    A.deallocate[of.ObjectImage](alloc, all, (module_count + 1)::usize);
    obj.dnit(?local_imports);
    free_atom_plan(alloc, ?local_atoms);
    opts_attributes_release(alloc, ?opts);
    ret linked;
}

fun link_modules_core(s: *session.Session, tgt: *target.Target, modules: *of.ObjectImage,
                      module_count: u32, codegen_count: u32,
                      dynlibs: *of.DynLib, dynlib_count: u32,
                      destination: *publication.Destination, name: *u8, mode: LinkMode, pie_opt_in: bool,
                      image_options: of.ImageOptions,
                      pre_atoms: *AtomPlan, capture: *LinkedImage) err[fail.Fail] {
    val alloc: *A.Allocator = s.alloc;
    var local_got: LocalGotPlan;
    init_local_got_plan(?local_got);
    var groups: SectionGroups;
    init_section_groups(?groups);
    val shared: bool = (mode == LINK_SHARED);
    val pie: bool = (mode == LINK_EXE) && (target_requires_pie(tgt) || pie_opt_in);
    val position_independent: bool = pie || shared;

    if (module_count == 0) {
        ret err[fail.Fail].err{fail.message("link: no input objects")};
    }
    if (codegen_count > module_count) {
        ret err[fail.Fail].err{fail.message("link: codegen image count exceeds module count")};
    }

    var debug_names: *intern.StrId = nil;
    var debug_count: u32 = 0;
    val dn_r: err[fail.Fail] = discover_debug_names(alloc, modules, module_count, ?debug_names, ?debug_count);
    if (sel dn_r.err) { ret dn_r; }

    var dm: u32 = 0;
    for (dm < module_count) {
        if (!module_debug_is_linkable(modules, dm)) { warn_debug_dropped(s, modules[dm].name); }
        dm = dm + 1;
    }

    val patching: bool = (mode == LINK_EXE) || shared;
    var atoms: AtomPlan;
    init_atom_plan(?atoms);
    var strm: StrMerge;
    val sm_r: res[StrMerge, fail.Fail] = build_str_merge(s, modules, module_count, patching);
    if (sel sm_r.err) {
        if (debug_names != nil && debug_count > 0) { A.deallocate[intern.StrId](alloc, debug_names, debug_count::usize); }
        ret err[fail.Fail].err{sm_r.err};
    }
    strm = sm_r.ok;

    val merged_count_r: res[u32, fail.Fail] = merged_section_count(debug_count);
    if (sel merged_count_r.err) {
        if (debug_names != nil && debug_count > 0) { A.deallocate[intern.StrId](alloc, debug_names, debug_count::usize); }
        free_str_merge(?strm);
        ret err[fail.Fail].err{merged_count_r.err};
    }
    val merged_count: u32 = merged_count_r.ok;
    var merged: *MergedSection = nil;
    val mrg_r: res[*MergedSection, A.Error] = A.zallocate[MergedSection](alloc, merged_count::usize);
    if (sel mrg_r.err) {
        if (debug_names != nil && debug_count > 0) { A.deallocate[intern.StrId](alloc, debug_names, debug_count::usize); }
        free_str_merge(?strm);
        ret err[fail.Fail].err{fail.refused(mrg_r.err)};
    }
    merged = mrg_r.ok;
    init_merged(merged, debug_names, debug_count);
    var merged_to_out: *u32 = nil;

    val sym_total_r: res[u32, fail.Fail] = total_symbols(modules, module_count);
    if (sel sym_total_r.err) {
        free_scratch(alloc, nil, 0, nil, 0, merged, merged_count, debug_names, debug_count, merged_to_out, nil, nil, 0, ?strm, ?atoms, ?groups);
        ret err[fail.Fail].err{sym_total_r.err};
    }
    val sym_total: u32 = sym_total_r.ok;
    var sym_base: *u32 = nil;
    var sym_out:  *u32 = nil;

    val sec_total_r: res[u32, fail.Fail] = total_sections(modules, module_count);
    if (sel sec_total_r.err) {
        free_scratch(alloc, nil, 0, nil, 0, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret err[fail.Fail].err{sec_total_r.err};
    }
    val sec_total: u32 = sec_total_r.ok;
    var placements: *Placement = nil;
    if (sec_total > 0) {
        val pr: res[*Placement, A.Error] = A.zallocate[Placement](alloc, sec_total::usize);
        if (sel pr.err) {
            free_scratch(alloc, nil, 0, nil, 0, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
            ret err[fail.Fail].err{fail.refused(pr.err)};
        }
        placements = pr.ok;
    }

    var sec_base: *u32 = nil;
    val br: res[*u32, A.Error] = A.zallocate[u32](alloc, module_count::usize);
    if (sel br.err) {
        free_scratch(alloc, placements, sec_total, nil, 0, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret err[fail.Fail].err{fail.refused(br.err)};
    }
    sec_base = br.ok;

    val syb_r: res[*u32, A.Error] = A.zallocate[u32](alloc, module_count::usize);
    if (sel syb_r.err) {
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret err[fail.Fail].err{fail.refused(syb_r.err)};
    }
    sym_base = syb_r.ok;
    val fsb_r: err[fail.Fail] = fill_symbol_bases(modules, module_count, sym_base);
    if (sel fsb_r.err) {
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret fsb_r;
    }

    if (sym_total > 0) {
        val syo_r: res[*u32, A.Error] = A.zallocate[u32](alloc, sym_total::usize);
        if (sel syo_r.err) {
            free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
            ret err[fail.Fail].err{fail.refused(syo_r.err)};
        }
        sym_out = syo_r.ok;
    }

    var atom_r: err[fail.Fail];
    if (pre_atoms != nil) {
        atoms = @pre_atoms;
        init_atom_plan(pre_atoms);
        atom_r = fill_section_bases(modules, module_count, sec_base);
    }
    or {
        atom_r = build_atom_plan(s, modules, module_count, codegen_count, sec_base,
                                 sec_total, patching, tgt.isa, ?atoms);
    }
    if (sel atom_r.err) {
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret atom_r;
    }

    val acc_r: err[fail.Fail] =
        accumulate_sections(s, modules, module_count, merged, debug_names, debug_count,
                            placements, sec_base, ?strm, ?atoms, ?groups);
    if (sel acc_r.err) {
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret acc_r;
    }

    if (tgt.of.produces_image && mode == LINK_EXE) {
        val ei_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, tgt.os.entry_symbol);
        if (sel ei_r.err) {
            free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
            ret err[fail.Fail].err{fail.refused(ei_r.err)};
        }
        val reorder_r: err[fail.Fail] =
            reorder_flat_entry_first(modules, module_count, merged, placements, sec_base,
                                     ?atoms, ei_r.ok);
        if (sel reorder_r.err) {
            free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
            ret reorder_r;
        }
    }

    val overlap_r: err[fail.Fail] =
        validate_no_contribution_overlap(s, modules, module_count, sec_base, placements, sec_total);
    if (sel overlap_r.err) {
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret overlap_r;
    }

    val assign_vaddrs: bool = (mode == LINK_EXE) || shared;
    var header_reserve: u64 = 0;
    if (assign_vaddrs) {
        header_reserve = header_reserve_bytes(tgt, position_independent, nil::*of.HeaderShape);
        val vaddr_r: err[fail.Fail] =
            assign_section_vaddrs(tgt, merged, header_reserve);
        if (sel vaddr_r.err) {
            free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
            ret vaddr_r;
        }
        finalize_placement_vaddrs(merged, placements, sec_total);
    }

    var sym_locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](alloc, map.hash_u32, map.eq_u32);

    val collect_r: err[fail.Fail] =
        collect_symbols(s, modules, module_count, placements, sec_base, ?sym_locs,
                        assign_vaddrs, ?atoms);
    if (sel collect_r.err) {
        free_local_got_plan(alloc, ?local_got);
        map.dnit[intern.StrId, SymbolLoc](?sym_locs);
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret collect_r;
    }

    if (mode == LINK_EXE || shared) {
        val gp_r: err[fail.Fail] = build_local_got_plan(
            s, tgt.isa, modules, module_count, ?sym_locs, sec_base, ?atoms,
            merged, ?groups, ?local_got);
        if (sel gp_r.err) {
            free_local_got_plan(alloc, ?local_got);
            map.dnit[intern.StrId, SymbolLoc](?sym_locs);
            free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
            ret gp_r;
        }
        if (local_got.count > 0) {
            val got_vaddr_r: err[fail.Fail] =
                assign_section_vaddrs(tgt, merged, header_reserve);
            if (sel got_vaddr_r.err) {
                free_local_got_plan(alloc, ?local_got);
                map.dnit[intern.StrId, SymbolLoc](?sym_locs);
                free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
                ret got_vaddr_r;
            }
            finalize_placement_vaddrs(merged, placements, sec_total);
            finalize_local_got_vaddrs(merged, ?local_got);

            map.dnit[intern.StrId, SymbolLoc](?sym_locs);
            sym_locs = map.init[intern.StrId, SymbolLoc](alloc, map.hash_u32, map.eq_u32);
            val recollect: err[fail.Fail] = collect_symbols(
                s, modules, module_count, placements, sec_base, ?sym_locs,
                assign_vaddrs, ?atoms);
            if (sel recollect.err) {
                free_local_got_plan(alloc, ?local_got);
                map.dnit[intern.StrId, SymbolLoc](?sym_locs);
                free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
                ret recollect;
            }
        }
    }

    var dynamic: bool = (mode == LINK_EXE)
        && (dynlib_count > 0 || pie
            || has_unresolved_declared_imports(
                modules, module_count, ?sym_locs));
    if (!dynamic && mode == LINK_EXE) {
        val unresolved_r: res[bool, fail.Fail] = has_unresolved_attributed_imports(
            s, modules, module_count, dynlibs, dynlib_count, ?sym_locs,
            tgt.of.import_address_prefix, sec_base, ?atoms);
        if (sel unresolved_r.err) {
            free_local_got_plan(alloc, ?local_got);
            map.dnit[intern.StrId, SymbolLoc](?sym_locs);
            free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
            ret err[fail.Fail].err{unresolved_r.err};
        }
        dynamic = unresolved_r.ok;
    }

    val no_loader: str = loaderless_request_message(s, tgt, mode, pie, dynamic);
    if (!str_empty(no_loader)) {
        free_local_got_plan(alloc, ?local_got);
        map.dnit[intern.StrId, SymbolLoc](?sym_locs);
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret err[fail.Fail].err{fail.message(no_loader)};
    }

    var out_img: of.ObjectImage;
    val img_r: res[of.ObjectImage, fail.Fail] = obj.image_init(alloc, ?s.interner, image_name(modules, module_count));
    if (sel img_r.err) {
        free_local_got_plan(alloc, ?local_got);
        map.dnit[intern.StrId, SymbolLoc](?sym_locs);
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret err[fail.Fail].err{img_r.err};
    }
    out_img = img_r.ok;

    val mto_r: res[*u32, A.Error] = A.zallocate[u32](alloc, merged_count::usize);
    if (sel mto_r.err) {
        obj.dnit(?out_img);
        free_local_got_plan(alloc, ?local_got);
        map.dnit[intern.StrId, SymbolLoc](?sym_locs);
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret err[fail.Fail].err{fail.refused(mto_r.err)};
    }
    merged_to_out = mto_r.ok;

    val build_r: err[fail.Fail] =
        build_merged_image(s, ?out_img, modules, module_count, merged, merged_count,
                           placements, sec_base, merged_to_out, sym_base, sym_out, ?strm, ?atoms);
    if (sel build_r.err) {
        obj.dnit(?out_img);
        free_local_got_plan(alloc, ?local_got);
        map.dnit[intern.StrId, SymbolLoc](?sym_locs);
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret build_r;
    }

    val built_valid: err[fail.Fail] = of.validate_owned_object(?out_img);
    if (sel built_valid.err) {
        val reason: str = fail.describe(built_valid.err);
        obj.dnit(?out_img);
        free_local_got_plan(alloc, ?local_got);
        map.dnit[intern.StrId, SymbolLoc](?sym_locs);
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret err[fail.Fail].err{fail.message(reason)};
    }

    var dyn: DynState;
    init_dynstate(?dyn);
    dyn.info.pie = position_independent;
    if (dynamic) {
        val dr: err[fail.Fail] =
            build_dynamic_info(s, tgt, ?dyn, modules, module_count, ?sym_locs,
                               dynlibs, dynlib_count, sec_base, ?atoms);
        if (sel dr.err) {
            free_dynstate(alloc, ?dyn);
            obj.dnit(?out_img);
            free_local_got_plan(alloc, ?local_got);
            map.dnit[intern.StrId, SymbolLoc](?sym_locs);
            free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
            ret dr;
        }
    }

    if (assign_vaddrs) {
        var shape: of.HeaderShape;
        measure_header_shape(s, ?out_img, merged, ?groups, ?dyn, position_independent, ?shape);
        val want: u64 = header_reserve_bytes(tgt, position_independent, ?shape);
        if (want > header_reserve) {
            header_reserve = want;
            val header_vaddr_r: err[fail.Fail] =
                assign_section_vaddrs(tgt, merged, header_reserve);
            if (sel header_vaddr_r.err) {
                free_dynstate(alloc, ?dyn);
                obj.dnit(?out_img);
                free_local_got_plan(alloc, ?local_got);
                map.dnit[intern.StrId, SymbolLoc](?sym_locs);
                free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
                ret header_vaddr_r;
            }
            finalize_placement_vaddrs(merged, placements, sec_total);
            if (local_got.count > 0) { finalize_local_got_vaddrs(merged, ?local_got); }

            map.dnit[intern.StrId, SymbolLoc](?sym_locs);
            sym_locs = map.init[intern.StrId, SymbolLoc](alloc, map.hash_u32, map.eq_u32);
            val recollect: err[fail.Fail] = collect_symbols(
                s, modules, module_count, placements, sec_base, ?sym_locs,
                assign_vaddrs, ?atoms);
            if (sel recollect.err) {
                free_dynstate(alloc, ?dyn);
                obj.dnit(?out_img);
                free_local_got_plan(alloc, ?local_got);
                map.dnit[intern.StrId, SymbolLoc](?sym_locs);
                free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
                ret recollect;
            }
        }
    }

    val patch_r: err[fail.Fail] =
        patch_relocations(s, ?out_img, modules, module_count, codegen_count,
                          placements, sec_base, merged_to_out, ?sym_locs,
                          ?dyn, ?local_got, ?strm, tgt.of,
                          tgt.isa, os_base_addr(tgt), ?atoms);
    if (sel patch_r.err) {
        free_dynstate(alloc, ?dyn);
        obj.dnit(?out_img);
        free_local_got_plan(alloc, ?local_got);
        map.dnit[intern.StrId, SymbolLoc](?sym_locs);
        free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);
        ret patch_r;
    }

    var emit_r: err[fail.Fail];
    if (shared) {
        emit_r = emit_shared_object(s, tgt, ?out_img, merged, ?groups, modules, module_count, ?sym_locs, ?dyn, destination, image_options);
    }
    or (dynamic) {
        emit_r = emit_executable(s, tgt, ?out_img, merged, ?groups, ?sym_locs, ?dyn, destination, name, image_options, capture);
    }
    or {
        emit_r = emit_executable(s, tgt, ?out_img, merged, ?groups, ?sym_locs, nil::*DynState, destination, name, image_options, capture);
    }

    free_dynstate(alloc, ?dyn);
    obj.dnit(?out_img);
    free_local_got_plan(alloc, ?local_got);
    map.dnit[intern.StrId, SymbolLoc](?sym_locs);
    free_scratch(alloc, placements, sec_total, sec_base, module_count, merged, merged_count, debug_names, debug_count, merged_to_out, sym_base, sym_out, sym_total, ?strm, ?atoms, ?groups);

    if (sel emit_r.err) {
        ret emit_r;
    }
    ret err[fail.Fail].ok{};
}

fun read_objects(s: *session.Session, tgt: *target.Target, obj_paths: **u8,
                 obj_count: u32, seed: *of.ObjectImage, seed_count: u32,
                 required: intern.StrId,
                 module_count: *u32) res[*of.ObjectImage, fail.Fail] {
    @module_count = 0;
    if (tgt.of.parse_object == nil) {
        ret res[*of.ObjectImage, fail.Fail].err{fail.message("link: object format has no parser")};
    }
    val seed_valid: err[fail.Fail] = validate_link_inputs(seed, seed_count);
    if (sel seed_valid.err) {
        ret res[*of.ObjectImage, fail.Fail].err{seed_valid.err};
    }
    val alloc: *A.Allocator = s.alloc;

    var modules: *of.ObjectImage = nil;
    var count: u32 = 0;
    var cap:   u32 = 0;

    var state: ArchiveResolution;
    init_archive_resolution(alloc, ?state);
    if (required != intern.STR_NIL) {
        val rr: err[fail.Fail] = archive_require(?state, required);
        if (sel rr.err) {
            free_archive_resolution(?state);
            ret res[*of.ObjectImage, fail.Fail].err{rr.err};
        }
    }
    var si: u32 = 0;
    for (si < seed_count) {
        val nr: err[fail.Fail] = archive_note_image(
            s, tgt.of.import_address_prefix, ?state, ?seed[si]);
        if (sel nr.err) {
            free_archive_resolution(?state);
            ret res[*of.ObjectImage, fail.Fail].err{nr.err};
        }
        si = si + 1;
    }

    var i: u32 = 0;
    for (i < obj_count) {
        if (obj_paths[i] == nil) {
            free_archive_resolution(?state);
            free_modules_to(alloc, modules, count, cap);
            ret res[*of.ObjectImage, fail.Fail].err{fail.message("link: nil object path")};
        }

        val path: str = obj_paths[i]::str;

        val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, path);
        if (sel rb.err) {
            free_archive_resolution(?state);
            free_modules_to(alloc, modules, count, cap);
            ret res[*of.ObjectImage, fail.Fail].err{fail.message(read_message(s, path, fail.describe(fail.fs_refused(rb.err))))};
        }
        var buf: Vector[u8] = rb.ok;

        var input_r: err[fail.Fail];
        if (ar.is_archive(buf.data, buf.len)) {
            input_r = parse_archive(s, tgt, path, buf.data, buf.len,
                                    ?state, ?modules, ?count, ?cap);
        }
        or {
            val loose: err[fail.Fail] = parse_loose(alloc, ?s.interner, tgt, path, buf.data, buf.len, ?modules, ?count, ?cap);
            input_r = loose;
            if (sel loose.ok) {
                val accepted: *of.ObjectImage = modules;
                input_r = archive_note_image(
                    s, tgt.of.import_address_prefix, ?state, ?accepted[count - 1]);
            }
        }

        vector.dnit[u8](?buf);
        if (sel input_r.err) {
            free_archive_resolution(?state);
            free_modules_to(alloc, modules, count, cap);
            ret res[*of.ObjectImage, fail.Fail].err{input_r.err};
        }

        i = i + 1;
    }

    if (cap > count) {
        val sr: res[*of.ObjectImage, A.Error] =
            A.reallocate[of.ObjectImage](alloc, modules, cap::usize, count::usize);
        if (sel sr.err) {
            free_archive_resolution(?state);
            free_modules_to(alloc, modules, count, cap);
            ret res[*of.ObjectImage, fail.Fail].err{fail.refused(sr.err)};
        }
        modules = sr.ok;
    }

    free_archive_resolution(?state);
    @module_count = count;
    ret res[*of.ObjectImage, fail.Fail].ok{modules};
}

fun init_archive_resolution(alloc: *A.Allocator, state: *ArchiveResolution) {
    state.providers  = map.init[intern.StrId, u32](alloc, map.hash_u32, map.eq_u32);
    state.unresolved = map.init[intern.StrId, u32](alloc, map.hash_u32, map.eq_u32);
}

fun free_archive_resolution(state: *ArchiveResolution) {
    map.dnit[intern.StrId, u32](?state.providers);
    map.dnit[intern.StrId, u32](?state.unresolved);
}

fun archive_require(state: *ArchiveResolution,
                    name: intern.StrId) err[fail.Fail] {
    if (map.contains[intern.StrId, u32](?state.providers, ?name)) {
        ret err[fail.Fail].ok{};
    }
    val inserted: res[bool, A.Error] = map.insert[intern.StrId, u32](?state.unresolved, name, 1);
    if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
    ret err[fail.Fail].ok{};
}

fun archive_symbol_provides(img: *of.ObjectImage, sym: *of.Symbol) bool {
    if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0) { ret false; }
    if (of.section_is_external(sym.section)) {
        ret (sym.flags & (of.SYM_OBJ_FLAG_FALLBACK | of.SYM_OBJ_FLAG_ALIAS))
            == (of.SYM_OBJ_FLAG_FALLBACK | of.SYM_OBJ_FLAG_ALIAS);
    }
    if (of.section_index(sym.section) < img.section_count
        && img.sections[of.section_index(sym.section)].kind == of.SK_DEBUG) { ret false; }
    ret true;
}

fun weak_fallback_name(img: *of.ObjectImage,
                       sym: *of.Symbol) res[intern.StrId, fail.Fail] {
    if ((sym.flags & of.SYM_OBJ_FLAG_FALLBACK) == 0) {
        ret res[intern.StrId, fail.Fail].err{fail.message("link: symbol has no weak fallback")};
    }
    if (sym.fallback >= img.symbol_count || sym.fallback == of.SYMBOL_NONE) {
        ret res[intern.StrId, fail.Fail].err{fail.message("link: weak fallback index is out of range")};
    }
    ret res[intern.StrId, fail.Fail].ok{img.symbols[sym.fallback].name};
}

fun archive_import_alias(s: *session.Session, prefix: str,
                         symbol: intern.StrId) res[intern.StrId, fail.Fail] {
    if (str_empty(prefix)) { ret res[intern.StrId, fail.Fail].ok{symbol}; }
    val no: opt[str] = intern.lookup(?s.interner, symbol);
    if (sel no.none) { ret res[intern.StrId, fail.Fail].err{fail.message("link: import name not interned")}; }
    val name: str = no.some;
    if (str_starts_with(name, prefix)) { ret res[intern.StrId, fail.Fail].ok{symbol}; }
    val jr: res[str, StrError] = str_join(s.alloc, prefix, name);
    if (sel jr.err) { ret res[intern.StrId, fail.Fail].err{fail.str_refused(jr.err)}; }
    val joined: str = jr.ok;
    val ir: res[intern.StrId, A.Error] = intern.intern(?s.interner, joined);
    str_free(s.alloc, joined);
    if (sel ir.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(ir.err)}; }
    ret res[intern.StrId, fail.Fail].ok{ir.ok};
}

fun archive_note_provider(state: *ArchiveResolution,
                          name: intern.StrId) err[fail.Fail] {
    val ir: res[bool, A.Error] =
        map.insert[intern.StrId, u32](?state.providers, name, 1);
    if (sel ir.err) { ret err[fail.Fail].err{fail.refused(ir.err)}; }
    map.remove[intern.StrId, u32](?state.unresolved, ?name);
    ret err[fail.Fail].ok{};
}

fun archive_note_image(s: *session.Session, import_address_prefix: str,
                       state: *ArchiveResolution,
                       img: *of.ObjectImage) err[fail.Fail] {
    var i: u32 = 0;
    for (i < img.symbol_count) {
        val sym: *of.Symbol = ?img.symbols[i];
        if (archive_symbol_provides(img, sym)) {
            val nr: err[fail.Fail] = archive_note_provider(state, sym.name);
            if (sel nr.err) { ret nr; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < img.import_count) {
        val nr: err[fail.Fail] = archive_note_provider(state, img.imports[i].symbol);
        if (sel nr.err) { ret nr; }
        val ar: res[intern.StrId, fail.Fail] =
            archive_import_alias(s, import_address_prefix, img.imports[i].symbol);
        if (sel ar.err) {
            ret err[fail.Fail].err{ar.err};
        }
        val an: err[fail.Fail] =
            archive_note_provider(state, ar.ok);
        if (sel an.err) { ret an; }
        i = i + 1;
    }
    i = 0;
    for (i < img.symbol_count) {
        val sym: *of.Symbol = ?img.symbols[i];
        if (!is_undefined_extern(sym)) { i = i + 1; cnt; }
        if ((sym.flags & of.SYM_OBJ_FLAG_FALLBACK) != 0) {
            val fr: res[intern.StrId, fail.Fail] = weak_fallback_name(img, sym);
            if (sel fr.err) {
                ret err[fail.Fail].err{fr.err};
            }
            val rr: err[fail.Fail] =
                archive_require(state, fr.ok);
            if (sel rr.err) { ret rr; }
            if ((sym.flags & of.SYM_OBJ_FLAG_SEARCH) != 0) {
                val sr: err[fail.Fail] = archive_require(state, sym.name);
                if (sel sr.err) { ret sr; }
            }
        }
        or ((sym.flags & of.SYM_OBJ_FLAG_WEAK) == 0) {
            val ur: err[fail.Fail] = archive_require(state, sym.name);
            if (sel ur.err) { ret ur; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun archive_image_needed(s: *session.Session, import_address_prefix: str,
                         state: *ArchiveResolution,
                         img: *of.ObjectImage) res[bool, fail.Fail] {
    var i: u32 = 0;
    for (i < img.symbol_count) {
        val sym: *of.Symbol = ?img.symbols[i];
        if (archive_symbol_provides(img, sym)
            && map.contains[intern.StrId, u32](?state.unresolved, ?sym.name)) {
            ret res[bool, fail.Fail].ok{true};
        }
        i = i + 1;
    }
    i = 0;
    for (i < img.import_count) {
        if (map.contains[intern.StrId, u32](?state.unresolved, ?img.imports[i].symbol)) {
            ret res[bool, fail.Fail].ok{true};
        }
        val ar: res[intern.StrId, fail.Fail] =
            archive_import_alias(s, import_address_prefix, img.imports[i].symbol);
        if (sel ar.err) {
            ret res[bool, fail.Fail].err{ar.err};
        }
        val alias: intern.StrId = ar.ok;
        if (map.contains[intern.StrId, u32](?state.unresolved, ?alias)) {
            ret res[bool, fail.Fail].ok{true};
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

fun grow_modules(alloc: *A.Allocator, modules: **of.ObjectImage, count: *u32, cap: *u32) res[u32, fail.Fail] {
    val old: u32 = @count;
    if (old == @cap) {
        val current: layout.CheckedCount[of.ObjectImage] = layout.count[of.ObjectImage]((@cap)::usize);
        val required_r: res[layout.CheckedCount[of.ObjectImage], layout.CheckCause] =
            layout.count_add[of.ObjectImage](current, layout.count[of.ObjectImage](1::usize));
        if (sel required_r.err) {
            ret res[u32, fail.Fail].err{fail.message("linker: module table growth count overflow")};
        }
        val required: layout.CheckedCount[of.ObjectImage] = required_r.ok;
        val grown_r: res[layout.CheckedCount[of.ObjectImage], layout.CheckCause] =
            layout.count_grow[of.ObjectImage](current, required);
        if (sel grown_r.err) {
            ret res[u32, fail.Fail].err{fail.message("linker: module table growth count overflow")};
        }
        val new_cap_fits: res[u32, layout.CheckCause] = layout.usize_to_u32(
            grown_r.ok.value);
        if (sel new_cap_fits.err) {
            ret res[u32, fail.Fail].err{fail.message("linker: module table capacity exceeds the u32 limit")};
        }
        val new_cap: u32 = new_cap_fits.ok;
        val gr: res[*of.ObjectImage, A.Error] =
            A.reallocate[of.ObjectImage](alloc, @modules, (@cap)::usize, new_cap::usize);
        if (sel gr.err) {
            ret res[u32, fail.Fail].err{fail.refused(gr.err)};
        }
        @modules = gr.ok;
        @cap = new_cap;
    }

    val arr: *of.ObjectImage = @modules;
    val slot: *of.ObjectImage = ?arr[old];
    @slot = of.object_image_init(alloc, nil, intern.STR_NIL);

    @count = old + 1;
    ret res[u32, fail.Fail].ok{old};
}

rec GmTrackEntry {
    p:    ptr;
    size: usize;
    live: bool;
}

rec GmTracker {
    entries:  *GmTrackEntry;
    cap:      u32;
    count:    u32;
    live:     u32;
    mismatch: bool;
}

fun gm_track_record(t: *GmTracker, p: ptr, size: usize) {
    if (t.count >= t.cap) { ret; }
    t.entries[t.count].p    = p;
    t.entries[t.count].size = size;
    t.entries[t.count].live = true;
    t.count = t.count + 1;
    t.live  = t.live + 1;
}

fun gm_track_find(t: *GmTracker, p: ptr) i64 {
    var i: u32 = 0;
    for (i < t.count) {
        if (t.entries[i].live && t.entries[i].p == p) { ret i::i64; }
        i = i + 1;
    }
    ret 0 - 1;
}

fun gm_track_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val t: *GmTracker = ctx::*GmTracker;
    val p: ptr = os.allocate(size);
    if (p == nil) { ret opt[ptr].none{}; }
    memory.raw_fill(p, 0xAA, size);
    gm_track_record(t, p, size);
    ret opt[ptr].some{p};
}

fun gm_track_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    if (p == nil || size == 0) { ret 0; }
    val t: *GmTracker = ctx::*GmTracker;
    val idx: i64 = gm_track_find(t, p);
    if (idx < 0) { t.mismatch = true; ret 0; }
    if (t.entries[idx::u32].size != size) { t.mismatch = true; }
    t.entries[idx::u32].live = false;
    t.live = t.live - 1;
    ret os.deallocate(p, size);
}

fun gm_track_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    if (p == nil) { ret gm_track_allocate(ctx, new_size, align); }
    val t: *GmTracker = ctx::*GmTracker;
    val idx: i64 = gm_track_find(t, p);
    if (idx < 0) { t.mismatch = true; }
    or { if (t.entries[idx::u32].size != old_size) { t.mismatch = true; } }
    val np: ptr = os.reallocate(p, old_size, new_size);
    if (np == nil) { ret opt[ptr].none{}; }
    if (new_size > old_size) { memory.raw_fill((np::usize + old_size)::ptr, 0xAA, new_size - old_size); }
    if (idx < 0) { gm_track_record(t, np, new_size); }
    or {
        t.entries[idx::u32].p    = np;
        t.entries[idx::u32].size = new_size;
    }
    ret opt[ptr].some{np};
}

test "mach.lang.be.linker.grow_modules:fresh_slot_is_fully_nil_and_destructible" {
    var page_alloc: A.Allocator;
    page.make(?page_alloc);

    var tracker: GmTracker;
    val res_entries: res[*GmTrackEntry, A.Error] = A.allocate[GmTrackEntry](?page_alloc, 64::usize);
    if (sel res_entries.err) { ret 1; }
    tracker.entries  = res_entries.ok;
    tracker.cap      = 64;
    tracker.count    = 0;
    tracker.live     = 0;
    tracker.mismatch = false;

    var tp: *GmTracker = ?tracker;
    var alloc: A.Allocator;
    alloc.ctx           = tp::ptr;
    alloc.fn_allocate   = gm_track_allocate;
    alloc.fn_reallocate = gm_track_reallocate;
    alloc.fn_deallocate = gm_track_deallocate;

    var modules: *of.ObjectImage = nil;
    var count: u32 = 0;
    var cap:   u32 = 0;
    val gr: res[u32, fail.Fail] = grow_modules(?alloc, ?modules, ?count, ?cap);
    if (sel gr.err) { ret 1; }
    val ix: u32 = gr.ok;
    val slot: *of.ObjectImage = ?modules[ix];

    if (slot.interner != nil)       { ret 1; }
    if (slot.frames != nil)         { ret 1; }
    if (slot.frame_count != 0)      { ret 1; }
    if (slot.machine_flags != 0)    { ret 1; }
    if (slot.attributes != nil)     { ret 1; }
    if (slot.attributes_len != 0)   { ret 1; }

    obj.dnit(slot);
    A.deallocate[of.ObjectImage](?alloc, modules, cap::usize);

    if (tracker.mismatch) { ret 1; }
    if (tracker.live != 0) { ret 1; }

    A.deallocate[GmTrackEntry](?page_alloc, tracker.entries, 64::usize);
    ret 0;
}

test "mach.lang.be.linker.image_attributes:frees_intermediate_accumulators" {
    var page_alloc: A.Allocator;
    page.make(?page_alloc);

    var tracker: GmTracker;
    val res_entries: res[*GmTrackEntry, A.Error] = A.allocate[GmTrackEntry](?page_alloc, 64::usize);
    if (sel res_entries.err) { ret 1; }
    tracker.entries  = res_entries.ok;
    tracker.cap      = 64;
    tracker.count    = 0;
    tracker.live     = 0;
    tracker.mismatch = false;

    var tp: *GmTracker = ?tracker;
    var alloc: A.Allocator;
    alloc.ctx           = tp::ptr;
    alloc.fn_allocate   = gm_track_allocate;
    alloc.fn_reallocate = gm_track_reallocate;
    alloc.fn_deallocate = gm_track_deallocate;

    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_1682: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1682.err) { session.dnit(?s); ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "riscv64", "linux", "lp64d");
    if (sel tr.err) { session.dnit(?s); ret 1; }
    var tgt: target.Target = tr.ok;

    val ta: res[target.Target, fail.Fail] = target.select(?reg, "rv64imafd", "linux", "lp64d");
    val tb: res[target.Target, fail.Fail] = target.select(?reg, "rv64imafdc", "linux", "lp64d");
    if (sel ta.err) { session.dnit(?s); ret 1; }
    if (sel tb.err) { session.dnit(?s); ret 1; }
    var target_a: target.Target = ta.ok;
    var target_b: target.Target = tb.ok;
    var len_a: u32 = 0;
    val ba: res[*u8, fail.Fail] = isa.build_attributes(target_a.isa, ?target_a.model, ?alloc, target_a.abi.float_arg_bits, false, ?len_a);
    if (sel ba.err) { session.dnit(?s); ret 1; }
    var len_b: u32 = 0;
    val bb: res[*u8, fail.Fail] = isa.build_attributes(target_b.isa, ?target_b.model, ?alloc, target_b.abi.float_arg_bits, true, ?len_b);
    if (sel bb.err) { session.dnit(?s); ret 1; }

    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "a"), nil::*of.Section, 0, nil::*of.Symbol, 0, nil::*of.Relocation, 0);
    mods[0].attributes     = ba.ok;
    mods[0].attributes_len = len_a;
    mods[1] = lt_image(?s, lt_name(?s, "b"), nil::*of.Section, 0, nil::*of.Symbol, 0, nil::*of.Relocation, 0);
    mods[1].attributes     = bb.ok;
    mods[1].attributes_len = len_b;

    var out_len: u32 = 0;
    val ar: res[*u8, fail.Fail] = image_attributes(?s, ?tgt, ?mods[0], 2, ?out_len);
    if (sel ar.err) { session.dnit(?s); ret 1; }
    val merged: *u8 = ar.ok;

    A.deallocate[u8](?alloc, mods[0].attributes, mods[0].attributes_len::usize);
    A.deallocate[u8](?alloc, mods[1].attributes, mods[1].attributes_len::usize);
    if (merged != nil && out_len > 0) { A.deallocate[u8](?alloc, merged, out_len::usize); }

    session.dnit(?s);

    if (tracker.mismatch) { ret 1; }
    if (tracker.live != 0) { ret 1; }

    A.deallocate[GmTrackEntry](?page_alloc, tracker.entries, 64::usize);
    ret 0;
}

fun parse_loose(alloc: *A.Allocator, itn: *intern.Interner, tgt: *target.Target,
                path: str, buf: *u8, buf_len: usize,
                modules: **of.ObjectImage, count: *u32, cap: *u32) err[fail.Fail] {
    val gr: res[u32, fail.Fail] = grow_modules(alloc, modules, count, cap);
    if (sel gr.err) { ret err[fail.Fail].err{gr.err}; }
    val ix: u32 = gr.ok;
    val arr: *of.ObjectImage = @modules;
    val pr: err[fail.Fail] = tgt.of.parse_object(alloc, itn, buf, buf_len, ?arr[ix]);
    if (sel pr.err) { ret pr; }
    val nr: res[intern.StrId, A.Error] = intern.intern(itn, path);
    if (sel nr.ok) { arr[ix].name = nr.ok; }
    ret err[fail.Fail].ok{};
}

fun parse_archive(s: *session.Session, tgt: *target.Target, path: str, buf: *u8, buf_len: usize,
                  state: *ArchiveResolution, modules: **of.ObjectImage,
                  count: *u32, cap: *u32) err[fail.Fail] {
    val alloc: *A.Allocator = s.alloc;
    var candidates: *of.ObjectImage = nil;
    var candidate_count: u32 = 0;
    var candidate_cap:   u32 = 0;
    var pos: usize = ar.first_member();
    for (true) {
        val st: ar.Step = ar.next_member(buf, buf_len, pos);
        if (!st.ok) {
            free_modules_to(alloc, candidates, candidate_count, candidate_cap);
            ret err[fail.Fail].err{fail.message(read_message(s, path, "malformed archive member header"))};
        }
        if (st.done) { brk; }

        if (!ar.is_special(st.member)) {
            val gr: res[u32, fail.Fail] =
                grow_modules(alloc, ?candidates, ?candidate_count, ?candidate_cap);
            if (sel gr.err) {
                free_modules_to(alloc, candidates, candidate_count, candidate_cap);
                ret err[fail.Fail].err{gr.err};
            }
            val ix: u32 = gr.ok;
            val pr: err[fail.Fail] =
                tgt.of.parse_object(alloc, ?s.interner, st.member.data, st.member.len,
                                    ?candidates[ix]);
            if (sel pr.err) {
                free_modules_to(alloc, candidates, candidate_count, candidate_cap);
                ret pr;
            }
        }

        pos = st.next;
    }

    if (candidate_count == 0) {
        free_modules_to(alloc, candidates, candidate_count, candidate_cap);
        ret err[fail.Fail].ok{};
    }
    val sr: res[*bool, A.Error] = A.zallocate[bool](alloc, candidate_count::usize);
    if (sel sr.err) {
        free_modules_to(alloc, candidates, candidate_count, candidate_cap);
        ret err[fail.Fail].err{fail.refused(sr.err)};
    }
    val selected: *bool = sr.ok;

    var progress: bool = true;
    for (progress) {
        progress = false;
        var i: u32 = 0;
        for (i < candidate_count) {
            if (selected[i]) { i = i + 1; cnt; }
            val needed_r: res[bool, fail.Fail] =
                archive_image_needed(
                    s, tgt.of.import_address_prefix, state, ?candidates[i]);
            if (sel needed_r.err) {
                free_archive_candidates(alloc, candidates, candidate_count,
                                        candidate_cap, selected);
                ret err[fail.Fail].err{needed_r.err};
            }
            if (!needed_r.ok) { i = i + 1; cnt; }

            val gr: res[u32, fail.Fail] = grow_modules(alloc, modules, count, cap);
            if (sel gr.err) {
                free_archive_candidates(alloc, candidates, candidate_count,
                                        candidate_cap, selected);
                ret err[fail.Fail].err{gr.err};
            }
            val dst: u32 = gr.ok;
            val accepted: *of.ObjectImage = @modules;
            accepted[dst] = candidates[i];
            selected[i] = true;
            val nr: err[fail.Fail] = archive_note_image(
                s, tgt.of.import_address_prefix, state, ?accepted[dst]);
            if (sel nr.err) {
                free_archive_candidates(alloc, candidates, candidate_count,
                                        candidate_cap, selected);
                ret nr;
            }
            progress = true;
            i = i + 1;
        }
    }

    free_archive_candidates(alloc, candidates, candidate_count,
                            candidate_cap, selected);
    ret err[fail.Fail].ok{};
}

fun free_archive_candidates(alloc: *A.Allocator, candidates: *of.ObjectImage,
                            count: u32, cap: u32, selected: *bool) {
    var i: u32 = 0;
    for (i < count) {
        if (!selected[i]) { obj.dnit(?candidates[i]); }
        i = i + 1;
    }
    A.deallocate[bool](alloc, selected, count::usize);
    A.deallocate[of.ObjectImage](alloc, candidates, cap::usize);
}

fun emit_executable(s: *session.Session, tgt: *target.Target, out_img: *of.ObjectImage,
                    merged: *MergedSection, groups: *SectionGroups,
                    sym_locs: *map.Map[intern.StrId, SymbolLoc],
                    dyn: *DynState, destination: *publication.Destination, name: *u8,
                    image_options: of.ImageOptions, capture: *LinkedImage) err[fail.Fail] {
    if (capture != nil && tgt.of.emit_exec_image == nil) {
        ret err[fail.Fail].err{fail.message("link: this object format cannot hand back a linked image")};
    }
    if (capture == nil && dyn == nil && tgt.of.emit_exec == nil) {
        ret err[fail.Fail].err{fail.message("link: object format cannot write executables")};
    }
    if (dyn != nil && tgt.of.emit_dyn_exec == nil) {
        ret err[fail.Fail].err{fail.message("link: object format cannot write dynamically-linked executables")};
    }
    if (tgt.os == nil) {
        ret err[fail.Fail].err{fail.message("link: target has no operating-system vtable")};
    }

    val alloc: *A.Allocator = s.alloc;

    val er: res[u64, fail.Fail] = entry_vaddr(s, tgt, sym_locs);
    if (sel er.err) { ret err[fail.Fail].err{er.err}; }
    val entry: u64 = er.ok;

    var seg_count: u32 = 0;
    val sr: res[*of.LoadSegment, fail.Fail] = build_load_segments(alloc, out_img, merged, groups, ?seg_count);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val segs: *of.LoadSegment = sr.ok;

    var func_count: u32 = 0;
    val fr: res[*of.ExecFunction, fail.Fail] = build_exec_functions(alloc, out_img, segs, seg_count, ?func_count);
    if (sel fr.err) {
        free_load_segments(alloc, segs, seg_count);
        ret err[fail.Fail].err{fr.err};
    }
    val funcs: *of.ExecFunction = fr.ok;

    var exc_count: u32 = 0;
    val xr: res[*of.Section, fail.Fail] = collect_exception_sections(alloc, out_img, ?exc_count);
    if (sel xr.err) {
        if (funcs != nil && func_count > 0) { A.deallocate[of.ExecFunction](alloc, funcs, func_count::usize); }
        free_load_segments(alloc, segs, seg_count);
        ret err[fail.Fail].err{xr.err};
    }
    val exc: *of.Section = xr.ok;

    var dbg_count: u32 = 0;
    val dr: res[*of.Section, fail.Fail] = collect_debug_sections(alloc, out_img, ?dbg_count);
    if (sel dr.err) {
        if (exc != nil && exc_count > 0) { A.deallocate[of.Section](alloc, exc, exc_count::usize); }
        if (funcs != nil && func_count > 0) { A.deallocate[of.ExecFunction](alloc, funcs, func_count::usize); }
        free_load_segments(alloc, segs, seg_count);
        ret err[fail.Fail].err{dr.err};
    }
    val dbg: *of.Section = dr.ok;

    var emit_r: err[fail.Fail] = err[fail.Fail].ok{};

    var symtab_count: u32 = 0;
    val ser: res[*of.SymtabEntry, fail.Fail] = build_symtab_entries(alloc, out_img, segs, seg_count, ?symtab_count);
    if (sel ser.err) {
        if (dbg != nil && dbg_count > 0) { A.deallocate[of.Section](alloc, dbg, dbg_count::usize); }
        if (exc != nil && exc_count > 0) { A.deallocate[of.Section](alloc, exc, exc_count::usize); }
        if (funcs != nil && func_count > 0) { A.deallocate[of.ExecFunction](alloc, funcs, func_count::usize); }
        free_load_segments(alloc, segs, seg_count);
        ret err[fail.Fail].err{ser.err};
    }
    val symtab: *of.SymtabEntry = ser.ok;

    if (capture != nil) {
        if (tgt.of.emit_exec_image == nil) {
            emit_r = err[fail.Fail].err{fail.message("link: this object format cannot hand back a linked image")};
        }
        or {
            var cap_base: u64 = 0;
            var cap_size: usize = 0;
            val cb: res[*u8, fail.Fail] =
                tgt.of.emit_exec_image(alloc, segs, seg_count, entry, ?cap_base, ?cap_size);
            if (sel cb.err) { emit_r = err[fail.Fail].err{cb.err}; }
            or (sel cb.ok) {
                capture.bytes        = cb.ok;
                capture.len          = cap_size;
                capture.base         = cap_base;
                capture.symbols      = symtab;
                capture.symbol_count = symtab_count;
            }
        }
    }
    or (dyn == nil) {
        emit_r = tgt.of.emit_exec(alloc, ?s.interner, ?tgt.object, segs, seg_count,
                                  os_page_size(tgt), os_base_addr(tgt), entry,
                                  funcs, func_count,
                                  exc, exc_count, dbg, dbg_count,
                                  symtab, symtab_count, destination, name, image_options);
    }
    or {
        emit_r = tgt.of.emit_dyn_exec(alloc, ?s.interner, ?tgt.object, segs, seg_count,
                                      os_page_size(tgt), os_base_addr(tgt), entry,
                                      funcs, func_count, ?dyn.info, dyn.fixups, dyn.fixup_count,
                                      exc, exc_count, dbg, dbg_count,
                                      symtab, symtab_count, destination, name, image_options);
    }

    val kept: bool = capture != nil && sel emit_r.ok;
    if (!kept && symtab != nil && symtab_count > 0) { A.deallocate[of.SymtabEntry](alloc, symtab, symtab_count::usize); }
    if (dbg != nil && dbg_count > 0) { A.deallocate[of.Section](alloc, dbg, dbg_count::usize); }
    if (exc != nil && exc_count > 0) { A.deallocate[of.Section](alloc, exc, exc_count::usize); }
    if (funcs != nil && func_count > 0) {
        A.deallocate[of.ExecFunction](alloc, funcs, func_count::usize);
    }
    free_load_segments(alloc, segs, seg_count);

    if (sel emit_r.err) {
        ret emit_r;
    }
    ret err[fail.Fail].ok{};
}

fun emit_shared_object(s: *session.Session, tgt: *target.Target, out_img: *of.ObjectImage,
                       merged: *MergedSection, groups: *SectionGroups,
                       modules: *of.ObjectImage, module_count: u32,
                       sym_locs: *map.Map[intern.StrId, SymbolLoc], dyn: *DynState,
                       destination: *publication.Destination, image_options: of.ImageOptions) err[fail.Fail] {
    if (tgt.of.emit_shared == nil) {
        ret err[fail.Fail].err{fail.message("link: object format cannot write shared libraries")};
    }
    if (tgt.os == nil) {
        ret err[fail.Fail].err{fail.message("link: target has no operating-system vtable")};
    }

    val alloc: *A.Allocator = s.alloc;

    var seg_count: u32 = 0;
    val sr: res[*of.LoadSegment, fail.Fail] = build_load_segments(alloc, out_img, merged, groups, ?seg_count);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val segs: *of.LoadSegment = sr.ok;

    var export_count: u32 = 0;
    val xr: res[*of.ExportSym, fail.Fail] = collect_exports(s, modules, module_count, sym_locs, ?export_count);
    if (sel xr.err) {
        free_load_segments(alloc, segs, seg_count);
        ret err[fail.Fail].err{xr.err};
    }
    val exports: *of.ExportSym = xr.ok;

    var dbg_count: u32 = 0;
    val dr: res[*of.Section, fail.Fail] = collect_debug_sections(alloc, out_img, ?dbg_count);
    if (sel dr.err) {
        if (exports != nil && export_count > 0) { A.deallocate[of.ExportSym](alloc, exports, export_count::usize); }
        free_load_segments(alloc, segs, seg_count);
        ret err[fail.Fail].err{dr.err};
    }
    val dbg: *of.Section = dr.ok;

    var symtab_count: u32 = 0;
    val ser: res[*of.SymtabEntry, fail.Fail] = build_symtab_entries(alloc, out_img, segs, seg_count, ?symtab_count);
    if (sel ser.err) {
        if (dbg != nil && dbg_count > 0) { A.deallocate[of.Section](alloc, dbg, dbg_count::usize); }
        if (exports != nil && export_count > 0) { A.deallocate[of.ExportSym](alloc, exports, export_count::usize); }
        free_load_segments(alloc, segs, seg_count);
        ret err[fail.Fail].err{ser.err};
    }
    val symtab: *of.SymtabEntry = ser.ok;

    val emit_r: err[fail.Fail] =
        tgt.of.emit_shared(alloc, ?s.interner, ?tgt.object, segs, seg_count, os_page_size(tgt),
                           exports, export_count, ?dyn.info, dbg, dbg_count,
                           symtab, symtab_count, destination, image_options);

    if (symtab != nil && symtab_count > 0) { A.deallocate[of.SymtabEntry](alloc, symtab, symtab_count::usize); }
    if (dbg != nil && dbg_count > 0) { A.deallocate[of.Section](alloc, dbg, dbg_count::usize); }
    if (exports != nil && export_count > 0) { A.deallocate[of.ExportSym](alloc, exports, export_count::usize); }
    free_load_segments(alloc, segs, seg_count);

    ret emit_r;
}

fun is_exported_symbol(m: *of.ObjectImage, sym: *of.Symbol) bool {
    if (of.section_is_external(sym.section))        { ret false; }
    if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0) { ret false; }
    if (sym.native.format == of.OF_ELF && (sym.native.flags & 3) != 0 && (sym.native.flags & 3) != 3) { ret false; }
    if (sym.native.format == of.OF_MACHO && (sym.native.kind & 0x10) != 0) { ret false; }
    if (of.section_index(sym.section) < m.section_count && m.sections[of.section_index(sym.section)].kind == of.SK_DEBUG) { ret false; }
    ret true;
}

fun collect_exports(s: *session.Session, modules: *of.ObjectImage, module_count: u32,
                    sym_locs: *map.Map[intern.StrId, SymbolLoc], count: *u32) res[*of.ExportSym, fail.Fail] {
    @count = 0;
    val alloc: *A.Allocator = s.alloc;

    var seen: map.Map[intern.StrId, u32] =
        map.init[intern.StrId, u32](alloc, map.hash_u32, map.eq_u32);
    var n: u32 = 0;
    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if (!is_exported_symbol(?modules[m], sym))                              { sy = sy + 1; cnt; }
            val get_r: opt[*u32] = map.get[intern.StrId, u32](?seen, ?sym.name);
            if (sel get_r.some)   { sy = sy + 1; cnt; }
            val ins: res[bool, A.Error] = map.insert[intern.StrId, u32](?seen, sym.name, n);
            if (sel ins.err) { map.dnit[intern.StrId, u32](?seen); ret res[*of.ExportSym, fail.Fail].err{fail.refused(ins.err)}; }
            n = n + 1;
            sy = sy + 1;
        }
        m = m + 1;
    }
    map.dnit[intern.StrId, u32](?seen);

    if (n == 0) { ret res[*of.ExportSym, fail.Fail].ok{nil}; }

    val ar: res[*of.ExportSym, A.Error] = A.zallocate[of.ExportSym](alloc, n::usize);
    if (sel ar.err) { ret res[*of.ExportSym, fail.Fail].err{fail.refused(ar.err)}; }
    val out: *of.ExportSym = ar.ok;

    var placed: map.Map[intern.StrId, u32] =
        map.init[intern.StrId, u32](alloc, map.hash_u32, map.eq_u32);
    var w: u32 = 0;
    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if (!is_exported_symbol(?modules[m], sym))                              { sy = sy + 1; cnt; }
            val get_r2: opt[*u32] = map.get[intern.StrId, u32](?placed, ?sym.name);
            if (sel get_r2.some) { sy = sy + 1; cnt; }

            val loc_r: opt[*SymbolLoc] = map.get[intern.StrId, SymbolLoc](sym_locs, ?sym.name);
            if (sel loc_r.none) {
                map.dnit[intern.StrId, u32](?placed);
                A.deallocate[of.ExportSym](alloc, out, n::usize);
                ret res[*of.ExportSym, fail.Fail].err{fail.message("link: exported symbol missing from the resolved symbol table")};
            }
            out[w].name    = sym.name;
            out[w].vaddr   = loc_r.some.vaddr;
            out[w].is_func = (sym.flags & of.SYM_OBJ_FLAG_FUNCTION) != 0;
            out[w].absolute = loc_r.some.merged_index == of.SECTION_ABSOLUTE;

            val ins: res[bool, A.Error] = map.insert[intern.StrId, u32](?placed, sym.name, w);
            if (sel ins.err) {
                map.dnit[intern.StrId, u32](?placed);
                A.deallocate[of.ExportSym](alloc, out, n::usize);
                ret res[*of.ExportSym, fail.Fail].err{fail.refused(ins.err)};
            }
            w = w + 1;
            sy = sy + 1;
        }
        m = m + 1;
    }
    map.dnit[intern.StrId, u32](?placed);

    @count = n;
    ret res[*of.ExportSym, fail.Fail].ok{out};
}

fun collect_debug_sections(alloc: *A.Allocator, out_img: *of.ObjectImage, count: *u32) res[*of.Section, fail.Fail] {
    @count = 0;
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < out_img.section_count) {
        if (out_img.sections[i].kind == of.SK_DEBUG) { n = n + 1; }
        i = i + 1;
    }
    if (n == 0) { ret res[*of.Section, fail.Fail].ok{nil}; }

    val ar: res[*of.Section, A.Error] = A.allocate[of.Section](alloc, n::usize);
    if (sel ar.err) { ret res[*of.Section, fail.Fail].err{fail.refused(ar.err)}; }
    val out: *of.Section = ar.ok;

    var w: u32 = 0;
    i = 0;
    for (i < out_img.section_count) {
        if (out_img.sections[i].kind == of.SK_DEBUG) {
            out[w] = out_img.sections[i];
            w = w + 1;
        }
        i = i + 1;
    }

    @count = n;
    ret res[*of.Section, fail.Fail].ok{out};
}

fun collect_exception_sections(alloc: *A.Allocator, out_img: *of.ObjectImage,
                               count: *u32) res[*of.Section, fail.Fail] {
    @count = 0;
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < out_img.section_count) {
        if (out_img.sections[i].kind == of.SK_EXCEPTION) { n = n + 1; }
        i = i + 1;
    }
    if (n == 0) { ret res[*of.Section, fail.Fail].ok{nil}; }

    val ar: res[*of.Section, A.Error] = A.allocate[of.Section](alloc, n::usize);
    if (sel ar.err) { ret res[*of.Section, fail.Fail].err{fail.refused(ar.err)}; }
    val out: *of.Section = ar.ok;

    var w: u32 = 0;
    i = 0;
    for (i < out_img.section_count) {
        if (out_img.sections[i].kind == of.SK_EXCEPTION) {
            out[w] = out_img.sections[i];
            w = w + 1;
        }
        i = i + 1;
    }
    @count = n;
    ret res[*of.Section, fail.Fail].ok{out};
}

fun entry_vaddr(s: *session.Session, tgt: *target.Target,
                sym_locs: *map.Map[intern.StrId, SymbolLoc]) res[u64, fail.Fail] {
    val er: res[intern.StrId, A.Error] = intern.intern(?s.interner, tgt.os.entry_symbol);
    if (sel er.err) { ret res[u64, fail.Fail].err{fail.refused(er.err)}; }
    val entry_name: intern.StrId = er.ok;
    val rr: res[intern.StrId, fail.Fail] = resolved_symbol_name(sym_locs, entry_name);
    if (sel rr.err) { ret res[u64, fail.Fail].err{rr.err}; }
    val resolved_name: intern.StrId = rr.ok;
    val el: opt[*SymbolLoc] =
        map.get[intern.StrId, SymbolLoc](sym_locs, ?resolved_name);
    if (sel el.none) {
        ret res[u64, fail.Fail].err{fail.message(entry_message(s, entry_name))};
    }
    ret res[u64, fail.Fail].ok{el.some.vaddr};
}

fun build_load_segments(alloc: *A.Allocator, out_img: *of.ObjectImage, merged: *MergedSection,
                        groups: *SectionGroups, seg_count: *u32) res[*of.LoadSegment, fail.Fail] {
    var count: u32 = 0;
    var k: u32 = 0;
    for (k < MERGED_KIND_COUNT) {
        if (is_loadable_kind(merged[k].kind) && merged[k].used && merged[k].len > 0) {
            count = count + 1;
        }
        k = k + 1;
    }
    if (count == 0) {
        ret res[*of.LoadSegment, fail.Fail].err{fail.message("link: no loadable sections in any input object; verify inputs contain code or data")};
    }

    val sr: res[*of.LoadSegment, A.Error] = A.zallocate[of.LoadSegment](alloc, count::usize);
    if (sel sr.err) {
        ret res[*of.LoadSegment, fail.Fail].err{fail.refused(sr.err)};
    }
    val segs: *of.LoadSegment = sr.ok;

    var si: u32 = 0;
    k = 0;
    for (k < MERGED_KIND_COUNT) {
        if (is_loadable_kind(merged[k].kind) && merged[k].used && merged[k].len > 0) {
            segs[si].vaddr  = merged[k].vaddr;
            segs[si].memsz  = merged[k].len::usize;
            val seg_flags: opt[u32] = seg_flags_for(merged[k].kind);
            if (sel seg_flags.none) {
                ret res[*of.LoadSegment, fail.Fail].err{fail.message(of.section_kind_rejection(out_img.interner, alloc, merged[k].kind))};
            }
            segs[si].flags  = seg_flags.some;
            if (merged[k].kind == of.SK_BSS) {
                segs[si].filesz = 0;
                segs[si].bytes  = nil;
            }
            or {
                segs[si].filesz = merged[k].len::usize;
                segs[si].bytes  = merged_section_bytes(out_img, merged[k].kind);
            }
            si = si + 1;
        }
        k = k + 1;
    }

    val nr: err[fail.Fail] = attach_load_sections(alloc, segs, count, merged, groups);
    if (sel nr.err) {
        free_load_segments(alloc, segs, count);
        ret res[*of.LoadSegment, fail.Fail].err{nr.err};
    }

    @seg_count = count;
    ret res[*of.LoadSegment, fail.Fail].ok{segs};
}

fun attach_load_sections(alloc: *A.Allocator, segs: *of.LoadSegment, count: u32,
                         merged: *MergedSection, groups: *SectionGroups) err[fail.Fail] {
    var si: u32 = 0;
    var k:  u32 = 0;
    for (k < MERGED_KIND_COUNT) {
        if (!is_loadable_kind(merged[k].kind) || !merged[k].used || merged[k].len == 0) {
            k = k + 1; cnt;
        }

        var n: u32 = 0;
        var i: u32 = 0;
        for (i < groups.count) {
            if (groups.items[i].slot == k && groups.items[i].len > 0) { n = n + 1; }
            i = i + 1;
        }
        if (n == 0) {
            ret err[fail.Fail].err{fail.message("linker: mapped segment carries no named section")};
        }

        val ar: res[*of.LoadSection, A.Error] = A.zallocate[of.LoadSection](alloc, n::usize);
        if (sel ar.err) {
            ret err[fail.Fail].err{fail.refused(ar.err)};
        }
        val secs: *of.LoadSection = ar.ok;

        var w: u32 = 0;
        i = 0;
        for (i < groups.count) {
            if (groups.items[i].slot == k && groups.items[i].len > 0) {
                secs[w].name   = groups.items[i].name;
                secs[w].kind   = merged[k].kind;
                secs[w].offset = groups.items[i].base;
                secs[w].len    = groups.items[i].len;
                secs[w].align  = groups.items[i].align;
                secs[w].flags  = groups.items[i].flags;
                w = w + 1;
            }
            i = i + 1;
        }
        segs[si].sections      = secs;
        segs[si].section_count = n;
        si = si + 1;
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun free_load_segments(alloc: *A.Allocator, segs: *of.LoadSegment, count: u32) {
    if (segs == nil || count == 0) { ret; }
    var i: u32 = 0;
    for (i < count) {
        if (segs[i].sections != nil && segs[i].section_count > 0) {
            A.deallocate[of.LoadSection](alloc, segs[i].sections, segs[i].section_count::usize);
        }
        i = i + 1;
    }
    A.deallocate[of.LoadSegment](alloc, segs, count::usize);
}

fun frame_key_after(a: *of.FrameUnwind, b: *of.FrameUnwind) bool {
    if (!of.section_same(a.section, b.section)) { ret of.section_index(a.section) > of.section_index(b.section); }
    ret a.offset > b.offset;
}

fun frame_find(out_img: *of.ObjectImage, fidx: *u32, section: u32, offset: u32) u32 {
    if (fidx == nil || out_img.frame_count == 0) { ret 0xFFFFFFFF; }
    var lo: u32 = 0;
    var hi: u32 = out_img.frame_count;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        val fr: *of.FrameUnwind = ?out_img.frames[fidx[mid]];
        if (of.section_index(fr.section) == section && fr.offset == offset) { ret fidx[mid]; }
        if (of.section_index(fr.section) < section || (of.section_index(fr.section) == section && fr.offset < offset)) { lo = mid + 1; }
        or                                                                         { hi = mid; }
    }
    ret 0xFFFFFFFF;
}

fun build_exec_functions(alloc: *A.Allocator, out_img: *of.ObjectImage,
                         segs: *of.LoadSegment, seg_count: u32,
                         func_count: *u32) res[*of.ExecFunction, fail.Fail] {
    @func_count = 0;
    if (out_img.symbol_count == 0) { ret res[*of.ExecFunction, fail.Fail].ok{nil}; }

    val ar: res[*of.ExecFunction, A.Error] = A.allocate[of.ExecFunction](alloc, out_img.symbol_count::usize);
    if (sel ar.err) {
        ret res[*of.ExecFunction, fail.Fail].err{fail.refused(ar.err)};
    }
    var funcs: *of.ExecFunction = ar.ok;
    var n: u32 = 0;

    val kr: res[*bool, A.Error] = A.allocate[bool](alloc, out_img.symbol_count::usize);
    if (sel kr.err) {
        A.deallocate[of.ExecFunction](alloc, funcs, out_img.symbol_count::usize);
        ret res[*of.ExecFunction, fail.Fail].err{fail.refused(kr.err)};
    }
    var known: *bool = kr.ok;

    var fidx: *u32 = nil;
    if (out_img.frame_count > 0) {
        val fr: res[*u32, A.Error] = A.allocate[u32](alloc, out_img.frame_count::usize);
        if (sel fr.err) {
            A.deallocate[of.ExecFunction](alloc, funcs, out_img.symbol_count::usize);
            ret res[*of.ExecFunction, fail.Fail].err{fail.refused(fr.err)};
        }
        fidx = fr.ok;
        var k: u32 = 0;
        for (k < out_img.frame_count) { fidx[k] = k; k = k + 1; }
        k = 1;
        for (k < out_img.frame_count) {
            val cur: u32 = fidx[k];
            var j: i32 = k::i32 - 1;
            for (j >= 0 && frame_key_after(?out_img.frames[fidx[j::u32]], ?out_img.frames[cur])) {
                fidx[(j + 1)::u32] = fidx[j::u32];
                j = j - 1;
            }
            fidx[(j + 1)::u32] = cur;
            k = k + 1;
        }
    }

    var si: u32 = 0;
    for (si < out_img.symbol_count) {
        val sym: *of.Symbol = ?out_img.symbols[si];
        if ((sym.flags & of.SYM_OBJ_FLAG_FUNCTION) == 0)                                { si = si + 1; cnt; }
        if (of.section_is_external(sym.section) || of.section_index(sym.section) >= out_img.section_count) { si = si + 1; cnt; }
        if (out_img.sections[of.section_index(sym.section)].kind != of.SK_TEXT)                           { si = si + 1; cnt; }

        val seg: u32 = segment_index_for(out_img, of.section_index(sym.section));
        if (seg >= seg_count)                      { si = si + 1; cnt; }
        if (sym.offset::usize >= segs[seg].filesz) { si = si + 1; cnt; }

        funcs[n].seg_index = seg;
        funcs[n].seg_offset = sym.offset;
        if ((sym.flags & of.SYM_OBJ_FLAG_SIZE_UNKNOWN) == 0) {
            funcs[n].size = sym.size;
            known[n] = true;
        } or {
            funcs[n].size = 0;
            known[n] = false;
        }
        funcs[n].step_count = 0;
        val fmatch: u32 = frame_find(out_img, fidx, of.section_index(sym.section), sym.offset);
        if (fmatch != 0xFFFFFFFF) {
            funcs[n].step_count = out_img.frames[fmatch].step_count;
            var sc: u32 = 0;
            for (sc < out_img.frames[fmatch].step_count) {
                funcs[n].steps[sc] = out_img.frames[fmatch].steps[sc];
                sc = sc + 1;
            }
        }
        n = n + 1;
        si = si + 1;
    }

    if (fidx != nil) { A.deallocate[u32](alloc, fidx, out_img.frame_count::usize); }

    if (n == 0) {
        A.deallocate[bool](alloc, known, out_img.symbol_count::usize);
        A.deallocate[of.ExecFunction](alloc, funcs, out_img.symbol_count::usize);
        ret res[*of.ExecFunction, fail.Fail].ok{nil};
    }

    var i: u32 = 1;
    for (i < n) {
        var cur: of.ExecFunction = funcs[i];
        var cur_known: bool = known[i];
        var j: i32 = i::i32 - 1;
        for (j >= 0
             && (funcs[j::u32].seg_index > cur.seg_index
                 || (funcs[j::u32].seg_index == cur.seg_index
                     && funcs[j::u32].seg_offset > cur.seg_offset))) {
            funcs[(j + 1)::u32] = funcs[j::u32];
            known[(j + 1)::u32] = known[j::u32];
            j = j - 1;
        }
        funcs[(j + 1)::u32] = cur;
        known[(j + 1)::u32] = cur_known;
        i = i + 1;
    }

    var w: u32 = 0;
    i = 0;
    for (i < n) {
        if (known[i]) {
            if (funcs[i].size > 0) { funcs[w] = funcs[i]; w = w + 1; }
            i = i + 1;
            cnt;
        }
        val seg: u32 = funcs[i].seg_index;
        val cur_off: u32 = funcs[i].seg_offset;
        var next_off: u32 = segs[seg].filesz::u32;
        if (i + 1 < n && funcs[i + 1].seg_index == seg) {
            next_off = funcs[i + 1].seg_offset;
        }
        if (next_off > cur_off) {
            funcs[w] = funcs[i];
            funcs[w].size = next_off - cur_off;
            w = w + 1;
        }
        i = i + 1;
    }

    A.deallocate[bool](alloc, known, out_img.symbol_count::usize);

    if (w == 0) {
        A.deallocate[of.ExecFunction](alloc, funcs, out_img.symbol_count::usize);
        ret res[*of.ExecFunction, fail.Fail].ok{nil};
    }
    if (w < out_img.symbol_count) {
        val rr: res[*of.ExecFunction, A.Error] =
            A.reallocate[of.ExecFunction](alloc, funcs, out_img.symbol_count::usize, w::usize);
        if (sel rr.err) {
            A.deallocate[of.ExecFunction](alloc, funcs, out_img.symbol_count::usize);
            ret res[*of.ExecFunction, fail.Fail].err{fail.refused(rr.err)};
        }
        funcs = rr.ok;
    }

    @func_count = w;
    ret res[*of.ExecFunction, fail.Fail].ok{funcs};
}

rec SymtabRow {
    seg_index:  u32;
    seg_offset: u32;
    size:       u32;
    known:      bool;
    name:       intern.StrId;
    global:     bool;
}

fun build_symtab_entries(alloc: *A.Allocator, out_img: *of.ObjectImage,
                         segs: *of.LoadSegment, seg_count: u32,
                         entry_count: *u32) res[*of.SymtabEntry, fail.Fail] {
    @entry_count = 0;
    if (out_img.symbol_count == 0) { ret res[*of.SymtabEntry, fail.Fail].ok{nil}; }

    val rr: res[*SymtabRow, A.Error] = A.allocate[SymtabRow](alloc, out_img.symbol_count::usize);
    if (sel rr.err) {
        ret res[*of.SymtabEntry, fail.Fail].err{fail.refused(rr.err)};
    }
    var rows: *SymtabRow = rr.ok;
    var n: u32 = 0;

    var si: u32 = 0;
    for (si < out_img.symbol_count) {
        val sym: *of.Symbol = ?out_img.symbols[si];
        if ((sym.flags & of.SYM_OBJ_FLAG_FUNCTION) == 0)                                { si = si + 1; cnt; }
        if (of.section_is_external(sym.section) || of.section_index(sym.section) >= out_img.section_count) { si = si + 1; cnt; }
        if (out_img.sections[of.section_index(sym.section)].kind != of.SK_TEXT)                           { si = si + 1; cnt; }

        val seg: u32 = segment_index_for(out_img, of.section_index(sym.section));
        if (seg >= seg_count)                      { si = si + 1; cnt; }
        if (sym.offset::usize >= segs[seg].filesz) { si = si + 1; cnt; }

        rows[n].seg_index  = seg;
        rows[n].seg_offset = sym.offset;
        if ((sym.flags & of.SYM_OBJ_FLAG_SIZE_UNKNOWN) == 0) {
            rows[n].size  = sym.size;
            rows[n].known = true;
        } or {
            rows[n].size  = 0;
            rows[n].known = false;
        }
        rows[n].name       = sym.name;
        rows[n].global     = (sym.flags & of.SYM_OBJ_FLAG_GLOBAL) != 0;
        n = n + 1;
        si = si + 1;
    }

    if (n == 0) {
        A.deallocate[SymtabRow](alloc, rows, out_img.symbol_count::usize);
        ret res[*of.SymtabEntry, fail.Fail].ok{nil};
    }

    var i: u32 = 1;
    for (i < n) {
        var cur: SymtabRow = rows[i];
        var j: i32 = i::i32 - 1;
        for (j >= 0
             && (rows[j::u32].seg_index > cur.seg_index
                 || (rows[j::u32].seg_index == cur.seg_index
                     && rows[j::u32].seg_offset > cur.seg_offset))) {
            rows[(j + 1)::u32] = rows[j::u32];
            j = j - 1;
        }
        rows[(j + 1)::u32] = cur;
        i = i + 1;
    }

    var w: u32 = 0;
    i = 0;
    for (i < n) {
        if (rows[i].known) {
            if (rows[i].size > 0) { rows[w] = rows[i]; w = w + 1; }
            i = i + 1;
            cnt;
        }
        val seg: u32 = rows[i].seg_index;
        val cur_off: u32 = rows[i].seg_offset;
        var next_off: u32 = segs[seg].filesz::u32;
        if (i + 1 < n && rows[i + 1].seg_index == seg) {
            next_off = rows[i + 1].seg_offset;
        }
        if (next_off > cur_off) {
            rows[w] = rows[i];
            rows[w].size = next_off - cur_off;
            w = w + 1;
        }
        i = i + 1;
    }

    if (w == 0) {
        A.deallocate[SymtabRow](alloc, rows, out_img.symbol_count::usize);
        ret res[*of.SymtabEntry, fail.Fail].ok{nil};
    }

    val er: res[*of.SymtabEntry, A.Error] = A.allocate[of.SymtabEntry](alloc, w::usize);
    if (sel er.err) {
        A.deallocate[SymtabRow](alloc, rows, out_img.symbol_count::usize);
        ret res[*of.SymtabEntry, fail.Fail].err{fail.refused(er.err)};
    }
    var entries: *of.SymtabEntry = er.ok;

    var wi: u32 = 0;
    i = 0;
    for (i < w) {
        if (!rows[i].global) {
            entries[wi].name   = rows[i].name;
            entries[wi].vaddr  = segs[rows[i].seg_index].vaddr + rows[i].seg_offset::u64;
            entries[wi].size   = rows[i].size;
            entries[wi].global = false;
            wi = wi + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < w) {
        if (rows[i].global) {
            entries[wi].name   = rows[i].name;
            entries[wi].vaddr  = segs[rows[i].seg_index].vaddr + rows[i].seg_offset::u64;
            entries[wi].size   = rows[i].size;
            entries[wi].global = true;
            wi = wi + 1;
        }
        i = i + 1;
    }

    A.deallocate[SymtabRow](alloc, rows, out_img.symbol_count::usize);
    @entry_count = w;
    ret res[*of.SymtabEntry, fail.Fail].ok{entries};
}

rec SectionGroup {
    name:   intern.StrId;
    slot:   u32;
    flags:  u32;
    align:  u32;
    len:    u32;
    base:   u32;
    cursor: u32;
}

rec SectionGroups {
    items: *SectionGroup;
    count: u32;
    cap:   u32;
}

fun init_section_groups(g: *SectionGroups) {
    g.items = nil;
    g.count = 0;
    g.cap   = 0;
}

fun free_section_groups(alloc: *A.Allocator, g: *SectionGroups) {
    if (g.items != nil && g.cap > 0) { A.deallocate[SectionGroup](alloc, g.items, g.cap::usize); }
    init_section_groups(g);
}

fun grow_cap[T](alloc: *A.Allocator, data: **T, cap: *u32, initial: u32) err[fail.Fail] {
    if (@data == nil) {
        val res_alloc: res[*T, A.Error] = A.allocate[T](alloc, initial::usize);
        if (sel res_alloc.err) { ret err[fail.Fail].err{fail.refused(res_alloc.err)}; }
        @data = res_alloc.ok;
        @cap  = initial;
        ret err[fail.Fail].ok{};
    }
    val current: layout.CheckedCount[T] = layout.count[T]((@cap)::usize);
    val required_r: res[layout.CheckedCount[T], layout.CheckCause] =
        layout.count_add[T](current, layout.count[T](1::usize));
    if (sel required_r.err) {
        ret err[fail.Fail].err{fail.message("linker: growth count overflow")};
    }
    val required: layout.CheckedCount[T] = required_r.ok;
    val grown_r: res[layout.CheckedCount[T], layout.CheckCause] = layout.count_grow[T](current, required);
    if (sel grown_r.err) {
        ret err[fail.Fail].err{fail.message("linker: growth count overflow")};
    }
    val new_cap_fits: res[u32, layout.CheckCause] = layout.usize_to_u32(
        grown_r.ok.value);
    if (sel new_cap_fits.err) {
        ret err[fail.Fail].err{fail.message("linker: growth capacity exceeds the u32 limit")};
    }
    val new_cap: u32 = new_cap_fits.ok;
    val res_realloc: res[*T, A.Error] = A.reallocate[T](alloc, @data, (@cap)::usize, new_cap::usize);
    if (sel res_realloc.err) { ret err[fail.Fail].err{fail.refused(res_realloc.err)}; }
    @data = res_realloc.ok;
    @cap  = new_cap;
    ret err[fail.Fail].ok{};
}

fun section_group_index(g: *SectionGroups, slot: u32, name: intern.StrId, flags: u32) u32 {
    var i: u32 = 0;
    for (i < g.count) {
        if (g.items[i].slot == slot && g.items[i].name == name
            && g.items[i].flags == flags) { ret i; }
        i = i + 1;
    }
    ret 0xFFFFFFFF;
}

fun section_group_add(alloc: *A.Allocator, g: *SectionGroups, slot: u32,
                      name: intern.StrId, flags: u32) res[u32, fail.Fail] {
    if (g.count == g.cap) {
        val grown: err[fail.Fail] = grow_cap[SectionGroup](alloc, ?g.items, ?g.cap, 8);
        if (sel grown.err) { ret res[u32, fail.Fail].err{grown.err}; }
    }
    val i: u32 = g.count;
    g.items[i].name   = name;
    g.items[i].slot   = slot;
    g.items[i].flags  = flags;
    g.items[i].align  = 1;
    g.items[i].len    = 0;
    g.items[i].base   = 0;
    g.items[i].cursor = 0;
    g.count = i + 1;
    ret res[u32, fail.Fail].ok{i};
}

val ATOM_OWNS: u32 = 0xFFFFFFFF;

fun mergeable_atom_eligible(modules: *of.ObjectImage, m: u32, sc: u32,
                            atoms: *AtomPlan, flat: u32) bool {
    val sec: *of.Section = ?modules[m].sections[sc];
    if ((sec.flags & of.SEC_FLAG_MERGEABLE) == 0)      { ret false; }
    if (!is_loadable_kind(sec.kind))               { ret false; }
    if (atom_live_len(atoms, flat, sec.len) != sec.len) { ret false; }
    var ri: u32 = 0;
    for (ri < modules[m].reloc_count) {
        if (of.section_index(modules[m].relocations[ri].section) == sc) { ret false; }
        ri = ri + 1;
    }
    ret true;
}

fun mergeable_atoms_match(a: *of.Section, b: *of.Section) bool {
    if (a.name != b.name || a.kind != b.kind) { ret false; }
    if (a.len != b.len || a.align != b.align) { ret false; }
    if (a.len == 0)                           { ret true; }
    if (a.bytes == nil || b.bytes == nil)     { ret false; }
    ret memory.raw_equal(a.bytes::ptr, b.bytes::ptr, a.len::usize);
}

fun debug_abbrev_tables_equal(a: *of.Section, b: *of.Section) bool {
    if (a == nil || b == nil || a.len != b.len) { ret false; }
    if (a.len == 0)                              { ret true; }
    if (a.bytes == nil || b.bytes == nil)        { ret false; }
    ret memory.raw_equal(a.bytes::ptr, b.bytes::ptr, a.len::usize);
}

fun plan_atom_coalescing(alloc: *A.Allocator, modules: *of.ObjectImage, module_count: u32,
                          sec_base: *u32, sec_total: u32,
                          atoms: *AtomPlan) res[*u32, fail.Fail] {
    if (sec_total == 0) { ret res[*u32, fail.Fail].ok{nil}; }
    val ar: res[*u32, A.Error] = A.allocate[u32](alloc, sec_total::usize);
    if (sel ar.err) { ret res[*u32, fail.Fail].err{fail.refused(ar.err)}; }
    val dup: *u32 = ar.ok;
    var i: u32 = 0;
    for (i < sec_total) { dup[i] = ATOM_OWNS; i = i + 1; }

    var m: u32 = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val flat: u32 = sec_base[m] + sc;
            if (!mergeable_atom_eligible(modules, m, sc, atoms, flat)) { sc = sc + 1; cnt; }
            val sec: *of.Section = ?modules[m].sections[sc];

            var wm: u32 = 0;
            for (wm <= m && dup[flat] == ATOM_OWNS) {
                var wc: u32 = 0;
                for (wc < modules[wm].section_count && dup[flat] == ATOM_OWNS) {
                    val wflat: u32 = sec_base[wm] + wc;
                    if (wflat >= flat)                                          { wc = wc + 1; cnt; }
                    if (dup[wflat] != ATOM_OWNS)                               { wc = wc + 1; cnt; }
                    if (!mergeable_atom_eligible(modules, wm, wc, atoms, wflat))    { wc = wc + 1; cnt; }
                    if (mergeable_atoms_match(?modules[wm].sections[wc], sec))      { dup[flat] = wflat; }
                    wc = wc + 1;
                }
                wm = wm + 1;
            }
            sc = sc + 1;
        }
        m = m + 1;
    }
    ret res[*u32, fail.Fail].ok{dup};
}

fun plan_section_groups(alloc: *A.Allocator, modules: *of.ObjectImage, module_count: u32,
                        merged: *MergedSection, atoms: *AtomPlan, sec_base: *u32,
                        dup: *u32, groups: *SectionGroups) err[fail.Fail] {
    var m: u32 = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val sec: *of.Section = ?modules[m].sections[sc];
            if (sec.kind::u32 >= MERGED_KIND_COUNT) { sc = sc + 1; cnt; }
            if (!is_loadable_kind(sec.kind))        { sc = sc + 1; cnt; }
            if (dup != nil && dup[sec_base[m] + sc] != ATOM_OWNS) { sc = sc + 1; cnt; }

            val slot: u32 = sec.kind::u32;
            var gi: u32 = section_group_index(groups, slot, sec.name, sec.flags & of.SEC_FLAG_IMAGE_MASK);
            if (gi == 0xFFFFFFFF) {
                val ar: res[u32, fail.Fail] = section_group_add(alloc, groups, slot, sec.name, sec.flags & of.SEC_FLAG_IMAGE_MASK);
                if (sel ar.err) { ret err[fail.Fail].err{ar.err}; }
                gi = ar.ok;
            }
            var a: u32 = sec.align;
            if (a == 0) { a = 1; }
            if (a > groups.items[gi].align) { groups.items[gi].align = a; }
            val off_r: res[u64, fail.Fail] = align_up_u64_checked(groups.items[gi].len::u64, a::u64);
            if (sel off_r.err) { ret err[fail.Fail].err{off_r.err}; }
            val off64: u64 = off_r.ok;
            val end: u64 = off64 + atom_live_len(atoms, sec_base[m] + sc, sec.len)::u64;
            if (end > 0xFFFFFFFF) {
                ret err[fail.Fail].err{fail.message("linker: merged section group exceeds the 4 GiB u32 limit")};
            }
            groups.items[gi].len = end::u32;
            sc = sc + 1;
        }
        m = m + 1;
    }

    var slot: u32 = 0;
    for (slot < MERGED_KIND_COUNT) {
        if (!is_loadable_kind(slot::u8)) { slot = slot + 1; cnt; }
        var run: u64 = 0;
        var i: u32 = 0;
        for (i < groups.count) {
            if (groups.items[i].slot == slot) {
                val run_r: res[u64, fail.Fail] = align_up_u64_checked(run, groups.items[i].align::u64);
                if (sel run_r.err) { ret err[fail.Fail].err{run_r.err}; }
                run = run_r.ok;
                if (run + groups.items[i].len::u64 > 0xFFFFFFFF) {
                    ret err[fail.Fail].err{fail.message("linker: merged section exceeds the 4 GiB u32 limit")};
                }
                groups.items[i].base   = run::u32;
                groups.items[i].cursor = run::u32;
                run = run + groups.items[i].len::u64;
            }
            i = i + 1;
        }
        slot = slot + 1;
    }
    ret err[fail.Fail].ok{};
}

# a kind outside the catalog is never loadable; every image here was validated
# at entry, so such a kind never reaches this predicate
fun is_loadable_kind(kind: of.SectionKind) bool {
    val desc: opt[*of.SectionKindDesc] = of.section_desc(kind);
    ret sel desc.some && desc.some.loadable;
}

# the load-segment protection a declared kind needs, absent for a kind outside
# the catalog
fun seg_flags_for(kind: of.SectionKind) opt[u32] {
    val desc: opt[*of.SectionKindDesc] = of.section_desc(kind);
    if (sel desc.none) { ret opt[u32].none{}; }
    val row: *of.SectionKindDesc = desc.some;
    var flags: u32 = of.SEG_FLAG_READ;
    if (row.executable) { flags = flags | of.SEG_FLAG_EXECUTE; }
    if (row.writable)   { flags = flags | of.SEG_FLAG_WRITE; }
    ret opt[u32].some{flags};
}

fun merged_section_bytes(out_img: *of.ObjectImage, kind: of.SectionKind) *u8 {
    var i: u32 = 0;
    for (i < out_img.section_count) {
        if (out_img.sections[i].kind == kind) { ret out_img.sections[i].bytes; }
        i = i + 1;
    }
    ret nil;
}

fun init_merged(merged: *MergedSection, debug_names: *intern.StrId, debug_count: u32) {
    var i: u32 = 0;
    for (i < MERGED_KIND_COUNT) {
        merged[i].kind  = i::u8;
        merged[i].name  = intern.STR_NIL;
        merged[i].align = 1;
        merged[i].len   = 0;
        merged[i].vaddr = 0;
        merged[i].used  = false;
        i = i + 1;
    }
    var d: u32 = 0;
    for (d < debug_count) {
        val slot: u32 = MERGED_KIND_COUNT + d;
        merged[slot].kind  = of.SK_DEBUG;
        merged[slot].name  = debug_names[d];
        merged[slot].align = 1;
        merged[slot].len   = 0;
        merged[slot].vaddr = 0;
        merged[slot].used  = false;
        d = d + 1;
    }
}

fun module_debug_is_linkable(modules: *of.ObjectImage, m: u32) bool {
    var has_debug: bool = false;
    var sc: u32 = 0;
    for (sc < modules[m].section_count) {
        val sec: *of.Section = ?modules[m].sections[sc];
        if (sec.kind == of.SK_DEBUG && sec.len > 0) {
            val nm: opt[str] = intern.lookup(modules[m].interner, sec.name);
            if (sel nm.some && str_equals(nm.some, ".debug_info")) {
                has_debug = true;
            }
        }
        sc = sc + 1;
    }
    if (!has_debug) { ret true; }

    var ri: u32 = 0;
    for (ri < modules[m].reloc_count) {
        val r: *of.Relocation = ?modules[m].relocations[ri];
        if (of.section_index(r.section) >= modules[m].section_count
            || modules[m].sections[of.section_index(r.section)].kind != of.SK_DEBUG
            || r.sym >= modules[m].symbol_count) { ri = ri + 1; cnt; }
        val tsec: u32 = of.section_index(modules[m].symbols[r.sym].section);
        if (tsec != of.SECTION_EXTERNAL && tsec < modules[m].section_count
            && tsec != of.section_index(r.section) && modules[m].sections[tsec].kind == of.SK_DEBUG) {
            ret true;
        }
        ri = ri + 1;
    }
    ret false;
}

fun warn_debug_dropped(s: *session.Session, name: intern.StrId) {
    val nm: opt[str] = intern.lookup(?s.interner, name);
    var on: str = "?";
    if (sel nm.some) { on = nm.some; }
    val result: res[str, format.FormatError] = format.sprint(s.alloc,
        "debug info in '{}' uses unrelocated cross-section offsets and cannot be merged; it is left out of the link",
        on);
    if (sel result.err) { ret; }
    val buf: str = result.ok;
    var span: token.Span;
    span.offset = 0;
    span.len    = 0;
    diagnostic.record_warning(?s.diags, 0xFFFFFFFF::src.FileId, span, buf);
    str_free(s.alloc, buf);
}

fun discover_debug_names(alloc: *A.Allocator, modules: *of.ObjectImage, module_count: u32,
                         out_names: **intern.StrId, out_count: *u32) err[fail.Fail] {
    @out_names = nil;
    @out_count = 0;
    var names: *intern.StrId = nil;
    var count: u32 = 0;
    var cap:   u32 = 0;

    var m: u32 = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val sec: *of.Section = ?modules[m].sections[sc];
            if (sec.kind != of.SK_DEBUG) { sc = sc + 1; cnt; }

            var seen: bool = false;
            var j: u32 = 0;
            for (j < count) {
                if (names[j] == sec.name) { seen = true; }
                j = j + 1;
            }
            if (seen) { sc = sc + 1; cnt; }

            if (count == cap) {
                val current: layout.CheckedCount[intern.StrId] = layout.count[intern.StrId](cap::usize);
                val required_add: res[layout.CheckedCount[intern.StrId], layout.CheckCause] =
                    layout.count_add[intern.StrId](current, layout.count[intern.StrId](1::usize));
                if (sel required_add.err) {
                    if (names != nil && cap > 0) { A.deallocate[intern.StrId](alloc, names, cap::usize); }
                    ret err[fail.Fail].err{fail.message("linker: debug section name table growth count overflow")};
                }
                var required: layout.CheckedCount[intern.StrId] = required_add.ok;
                if (required.value < 4) { required = layout.count[intern.StrId](4::usize); }
                val grown_r: res[layout.CheckedCount[intern.StrId], layout.CheckCause] =
                    layout.count_grow[intern.StrId](current, required);
                if (sel grown_r.err) {
                    if (names != nil && cap > 0) { A.deallocate[intern.StrId](alloc, names, cap::usize); }
                    ret err[fail.Fail].err{fail.message("linker: debug section name table growth count overflow")};
                }
                val new_cap_fits: res[u32, layout.CheckCause] = layout.usize_to_u32(
                    grown_r.ok.value);
                if (sel new_cap_fits.err) {
                    if (names != nil && cap > 0) { A.deallocate[intern.StrId](alloc, names, cap::usize); }
                    ret err[fail.Fail].err{fail.message("linker: debug section name table capacity exceeds the u32 limit")};
                }
                val new_cap: u32 = new_cap_fits.ok;
                val gr: res[*intern.StrId, A.Error] =
                    A.reallocate[intern.StrId](alloc, names, cap::usize, new_cap::usize);
                if (sel gr.err) {
                    if (names != nil && cap > 0) { A.deallocate[intern.StrId](alloc, names, cap::usize); }
                    ret err[fail.Fail].err{fail.refused(gr.err)};
                }
                names = gr.ok;
                cap = new_cap;
            }
            names[count] = sec.name;
            count = count + 1;

            sc = sc + 1;
        }
        m = m + 1;
    }

    if (cap > count) {
        if (count == 0) {
            if (names != nil) { A.deallocate[intern.StrId](alloc, names, cap::usize); }
            names = nil;
        }
        or {
            val sr: res[*intern.StrId, A.Error] = A.reallocate[intern.StrId](alloc, names, cap::usize, count::usize);
            if (sel sr.err) {
                A.deallocate[intern.StrId](alloc, names, cap::usize);
                ret err[fail.Fail].err{fail.refused(sr.err)};
            }
            names = sr.ok;
        }
    }

    @out_names = names;
    @out_count = count;
    ret err[fail.Fail].ok{};
}

test "mach.lang.be.linker.discover_debug_names:shrinks_to_exact_capacity" {
    var page_alloc: A.Allocator;
    page.make(?page_alloc);

    var tracker: GmTracker;
    val res_entries: res[*GmTrackEntry, A.Error] = A.allocate[GmTrackEntry](?page_alloc, 64::usize);
    if (sel res_entries.err) { ret 1; }
    tracker.entries  = res_entries.ok;
    tracker.cap      = 64;
    tracker.count    = 0;
    tracker.live     = 0;
    tracker.mismatch = false;

    var tp: *GmTracker = ?tracker;
    var alloc: A.Allocator;
    alloc.ctx           = tp::ptr;
    alloc.fn_allocate   = gm_track_allocate;
    alloc.fn_reallocate = gm_track_reallocate;
    alloc.fn_deallocate = gm_track_deallocate;

    var secs: [5]of.Section;
    var i: u32 = 0;
    for (i < 5) {
        secs[i].name  = (i + 1)::intern.StrId;
        secs[i].kind  = of.SK_DEBUG;
        secs[i].bytes = nil;
        secs[i].len   = 0;
        secs[i].align = 1;
        i = i + 1;
    }

    var mod: of.ObjectImage;
    mod.sections      = ?secs[0];
    mod.section_count = 5;

    var out_names: *intern.StrId = nil;
    var out_count: u32 = 0;
    val r: err[fail.Fail] = discover_debug_names(?alloc, ?mod, 1, ?out_names, ?out_count);
    if (sel r.err) { ret 1; }
    if (out_count != 5) { ret 1; }

    if (out_names != nil && out_count > 0) {
        A.deallocate[intern.StrId](?alloc, out_names, out_count::usize);
    }

    if (tracker.mismatch) { ret 1; }
    if (tracker.live != 0) { ret 1; }

    A.deallocate[GmTrackEntry](?page_alloc, tracker.entries, 64::usize);
    ret 0;
}

fun str_merge_add_string(s: *session.Session, sm: *StrMerge,
                         section: *of.Section, source_offset: u32) res[u32, fail.Fail] {
    if (section.bytes == nil || source_offset >= section.len) {
        ret res[u32, fail.Fail].err{fail.message("linker: .debug_str string offset is out of range")};
    }
    var terminator: u32 = source_offset;
    for (terminator < section.len && section.bytes[terminator] != 0) {
        terminator = terminator + 1;
    }
    if (terminator >= section.len) {
        ret res[u32, fail.Fail].err{fail.message("linker: malformed .debug_str section: unterminated string")};
    }

    val string_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, (?section.bytes[source_offset])::str);
    if (sel string_r.err) {
        ret res[u32, fail.Fail].err{fail.refused(string_r.err)};
    }
    val string_id: intern.StrId = string_r.ok;
    val get_r: opt[*u32] = map.get[intern.StrId, u32](?sm.offs, ?string_id);
    if (sel get_r.none) {
        val string_len: u64 = (terminator - source_offset)::u64 + 1;
        if (sm.buf.len::u64 > 0xFFFFFFFF - string_len) {
            ret res[u32, fail.Fail].err{fail.message("linker: merged .debug_str section exceeds the 4 GiB u32 limit")};
        }
        val merged_offset: u32 = sm.buf.len::u32;
        var index: u32 = source_offset;
        for (index <= terminator) {
            enc.emit_byte(?sm.buf, section.bytes[index]);
            index = index + 1;
        }
        val inserted_r: res[bool, A.Error] =
            map.insert[intern.StrId, u32](?sm.offs, string_id, merged_offset);
        if (sel inserted_r.err) {
            ret res[u32, fail.Fail].err{fail.refused(inserted_r.err)};
        }
    }
    ret res[u32, fail.Fail].ok{terminator + 1};
}

fun build_str_merge(s: *session.Session, modules: *of.ObjectImage, module_count: u32,
                    patching: bool) res[StrMerge, fail.Fail] {
    val alloc: *A.Allocator = s.alloc;
    var sm: StrMerge;
    sm.buf    = enc.buf_init(alloc);
    sm.offs   = map.init[intern.StrId, u32](alloc, map.hash_u32, map.eq_u32);
    sm.name   = intern.STR_NIL;
    sm.active = false;
    if (!patching) { ret res[StrMerge, fail.Fail].ok{sm}; }

    val nr: res[intern.StrId, A.Error] = intern.intern(?s.interner, ".debug_str");
    if (sel nr.err) { free_str_merge(?sm); ret res[StrMerge, fail.Fail].err{fail.refused(nr.err)}; }
    sm.name = nr.ok;

    var m: u32 = 0;
    for (m < module_count) {
        if (!module_debug_is_linkable(modules, m)) { m = m + 1; cnt; }
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val sec: *of.Section = ?modules[m].sections[sc];
            if (sec.kind != of.SK_DEBUG || sec.name != sm.name || sec.bytes == nil) { sc = sc + 1; cnt; }
            sm.active = true;

            var o: u32 = 0;
            for (o < sec.len) {
                val added_r: res[u32, fail.Fail] = str_merge_add_string(s, ?sm, sec, o);
                if (sel added_r.err) {
                    free_str_merge(?sm);
                    ret res[StrMerge, fail.Fail].err{added_r.err};
                }
                o = added_r.ok;
            }
            sc = sc + 1;
        }

        var relocation_index: u32 = 0;
        for (relocation_index < modules[m].reloc_count) {
            val relocation: *of.Relocation = ?modules[m].relocations[relocation_index];
            if (relocation.sym >= modules[m].symbol_count) {
                relocation_index = relocation_index + 1;
                cnt;
            }
            val target_symbol: *of.Symbol = ?modules[m].symbols[relocation.sym];
            if (!of.section_is_external(target_symbol.section)
                && of.section_index(target_symbol.section) < modules[m].section_count) {
                val target_section: *of.Section =
                    ?modules[m].sections[of.section_index(target_symbol.section)];
                if (target_section.kind == of.SK_DEBUG
                    && target_section.name == sm.name) {
                    val source_offset_r: res[u32, fail.Fail] = debug_str_source_offset(
                        target_symbol.offset, relocation.addend, target_section.len);
                    if (sel source_offset_r.err) {
                        free_str_merge(?sm);
                        ret res[StrMerge, fail.Fail].err{source_offset_r.err};
                    }
                    val suffix_r: res[u32, fail.Fail] = str_merge_add_string(
                        s, ?sm, target_section,
                        source_offset_r.ok);
                    if (sel suffix_r.err) {
                        free_str_merge(?sm);
                        ret res[StrMerge, fail.Fail].err{suffix_r.err};
                    }
                }
            }
            relocation_index = relocation_index + 1;
        }
        m = m + 1;
    }
    ret res[StrMerge, fail.Fail].ok{sm};
}

fun free_str_merge(sm: *StrMerge) {
    if (sm == nil) { ret; }
    map.dnit[intern.StrId, u32](?sm.offs);
    enc.buf_dnit(?sm.buf);
}

fun init_atom_plan(plan: *AtomPlan) {
    plan.drops         = nil;
    plan.drop_count    = 0;
    plan.drop_cap      = 0;
    plan.sections      = nil;
    plan.section_count = 0;
    plan.removed_bytes = 0;
    plan.active        = false;
}

fun free_atom_plan(alloc: *A.Allocator, plan: *AtomPlan) {
    if (plan == nil) { ret; }
    if (plan.drops != nil && plan.drop_cap > 0) {
        A.deallocate[AtomDrop](alloc, plan.drops, plan.drop_cap::usize);
    }
    if (plan.sections != nil && plan.section_count > 0) {
        A.deallocate[AtomSection](alloc, plan.sections, plan.section_count::usize);
    }
    init_atom_plan(plan);
}

fun atom_drop_cmp(a: *AtomDrop, b: *AtomDrop) i64 {
    if (a.section < b.section) { ret -1; }
    if (a.section > b.section) { ret 1; }
    if (a.start < b.start)     { ret -1; }
    if (a.start > b.start)     { ret 1; }
    if (a.end < b.end)         { ret -1; }
    if (a.end > b.end)         { ret 1; }
    ret 0;
}

fun atom_reloc_ref_cmp(a: *AtomRelocRef, b: *AtomRelocRef) i64 {
    if (a.target_section < b.target_section) { ret -1; }
    if (a.target_section > b.target_section) { ret 1; }
    if (a.source_module < b.source_module)   { ret -1; }
    if (a.source_module > b.source_module)   { ret 1; }
    if (a.reloc < b.reloc)                   { ret -1; }
    if (a.reloc > b.reloc)                   { ret 1; }
    ret 0;
}

fun atom_reloc_ref_lower(refs: *AtomRelocRef, count: u32, section: u32) u32 {
    var lo: u32 = 0;
    var hi: u32 = count;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (refs[mid].target_section < section) { lo = mid + 1; }
        or                                      { hi = mid; }
    }
    ret lo;
}

fun atom_resume_offset(dst: u32, end: u32, section_align: u32) u32 {
    if (end <= dst) { ret dst; }
    var a: u32 = section_align;
    if (a == 0) { a = 1; }
    ret dst + (end - dst) % a;
}

fun unreferenced_local(m: *of.ObjectImage, sy: u32) bool {
    if (sy >= m.symbol_count) { ret false; }
    val sym: *of.Symbol = ?m.symbols[sy];
    if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) != 0) { ret false; }
    if (of.section_is_external(sym.section))        { ret false; }
    var ri: u32 = 0;
    for (ri < m.reloc_count) {
        val r: *of.Relocation = ?m.relocations[ri];
        if ((r.sym == sy || (of.is_difference(r.kind) && r.sym2 == sy))
            && !(of.section_index(r.section) < m.section_count && m.sections[of.section_index(r.section)].kind == of.SK_DEBUG)) {
            ret false;
        }
        ri = ri + 1;
    }
    ret true;
}

fun atom_reloc_traits(r: *of.Relocation, section: *of.Section,
                      arch: *isa.IsaVTable,
                      codegen_image: bool) res[rel.RelocTraits, rel.RelocError] {
    var kind: of.RelocKind = r.kind;
    if (of.is_difference(kind)) {
        val applied: opt[of.RelocKind] = of.difference_apply_kind(kind);
        if (sel applied.none) { ret res[rel.RelocTraits, rel.RelocError].err{rel.RELOC_UNSUPPORTED}; }
        kind = applied.some;
    }
    ret arch.reloc.traits(kind, section.kind, codegen_image);
}

fun atom_reloc_ref_set_target(modules: *of.ObjectImage, m: u32, sy: u32,
                              sec_base: *u32,
                              winners: *map.Map[intern.StrId, AtomWinner],
                              reference: *AtomRelocRef) {
    if (sy >= modules[m].symbol_count) { ret; }
    val target_sym: *of.Symbol = ?modules[m].symbols[sy];
    if ((target_sym.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0
        && !of.section_is_external(target_sym.section)
        && of.section_index(target_sym.section) < modules[m].section_count) {
        reference.target_module = m;
        reference.target_symbol = sy;
    }
    or {
        val wr: opt[*AtomWinner] =
            map.get[intern.StrId, AtomWinner](winners, ?target_sym.name);
        if (sel wr.some) {
            val winner: *AtomWinner = wr.some;
            reference.target_module = winner.module;
            reference.target_symbol = winner.symbol;
        }
    }
    if (reference.target_module == 0xFFFFFFFF) { ret; }
    val target: *of.Symbol =
        ?modules[reference.target_module].symbols[reference.target_symbol];
    if (!of.section_is_external(target.section)
        && of.section_index(target.section) < modules[reference.target_module].section_count) {
        reference.target_section = sec_base[reference.target_module] + of.section_index(target.section);
    }
}

fun atom_is_carrier_anchor(m: *of.ObjectImage, owner: *of.Symbol,
                           other: *of.Symbol, start: u32, end: u32) bool {
    if (start != 0 || owner.offset != 0) { ret false; }
    if (of.section_index(owner.section) >= m.section_count || end != m.sections[of.section_index(owner.section)].len) { ret false; }
    if (!of.section_same(other.section, owner.section) || other.offset != 0 || other.size != 0)   { ret false; }
    if (other.flags != 0 || other.name != m.sections[of.section_index(owner.section)].name)          { ret false; }
    ret true;
}

fun atom_effective_offset(base: u32, addend: i64, out: *u32) bool {
    if (addend >= 0) {
        val plus: u64 = addend::u64;
        if (plus > 0xFFFFFFFF - base::u64) { ret false; }
        @out = base + plus::u32;
        ret true;
    }
    if (addend < -(base::i64)) { ret false; }
    @out = (base::i64 + addend)::u32;
    ret true;
}

fun atom_reloc_crosses_candidate(modules: *of.ObjectImage, reference: *AtomRelocRef,
                                 r: *of.Relocation,
                                 candidate_module: u32, candidate_section: u32,
                                 start: u32, end: u32) bool {
    val source_module: u32 = reference.source_module;
    val width: u64 = reference.width::u64;
    if (source_module == candidate_module && of.section_index(r.section) == candidate_section
        && r.offset::u64 >= start::u64
        && r.offset::u64 + width <= end::u64) {
        ret false;
    }

    val target_module: u32 = reference.target_module;
    val target_symbol: u32 = reference.target_symbol;

    val target: *of.Symbol = ?modules[target_module].symbols[target_symbol];
    if (target_module != candidate_module || of.section_index(target.section) != candidate_section) { ret false; }
    if (target.offset > modules[candidate_module].sections[candidate_section].len) { ret false; }

    if (target.offset >= start && target.offset < end) { ret true; }
    if (reference.addend_mode == rel.RELOC_ADDEND_IGNORED) { ret false; }

    var bias_min: i64 = 0;
    var bias_max: i64 = 0;
    if (reference.addend_mode == rel.RELOC_ADDEND_FIELD_BIAS
        && of.section_index(r.section) < modules[source_module].section_count
        && modules[source_module].sections[of.section_index(r.section)].kind == of.SK_TEXT) {
        bias_min = reference.text_bias_min::i64;
        bias_max = reference.text_bias_max::i64;
    }
    if ((bias_min > 0 && r.addend > 9223372036854775807 - bias_min)
        || (bias_min < 0 && r.addend < (-9223372036854775807 - 1) - bias_min)
        || (bias_max > 0 && r.addend > 9223372036854775807 - bias_max)
        || (bias_max < 0 && r.addend < (-9223372036854775807 - 1) - bias_max)) {
        ret true;
    }

    var effective_min: u32 = 0;
    var effective_max: u32 = 0;
    if (!atom_effective_offset(target.offset, r.addend + bias_min, ?effective_min)
        || !atom_effective_offset(target.offset, r.addend + bias_max, ?effective_max)) {
        ret true;
    }
    if (target.offset < start && effective_max >= start) { ret true; }
    if (target.offset >= end && effective_min < end)     { ret true; }
    ret false;
}

fun fill_section_bases(modules: *of.ObjectImage, module_count: u32, sec_base: *u32) err[fail.Fail] {
    var flat: layout.CheckedCount[SectionCountUnit] = layout.count[SectionCountUnit](0::usize);
    var m: u32 = 0;
    for (m < module_count) {
        val flat32: res[u32, layout.CheckCause] = layout.usize_to_u32(flat.value);
        if (sel flat32.err) {
            ret err[fail.Fail].err{fail.message("linker: flattened section index exceeds the u32 limit")};
        }
        sec_base[m] = flat32.ok;
        val added: res[layout.CheckedCount[SectionCountUnit], layout.CheckCause] =
            layout.count_add[SectionCountUnit](flat, layout.count[SectionCountUnit](modules[m].section_count::usize));
        if (sel added.err) {
            ret err[fail.Fail].err{fail.message("linker: total input section count overflow")};
        }
        flat = added.ok;
        m = m + 1;
    }
    ret err[fail.Fail].ok{};
}

fun atom_offset_dead(plan: *AtomPlan, section: u32, off: u32) bool {
    if (plan == nil || !plan.active || section >= plan.section_count) { ret false; }
    val meta: *AtomSection = ?plan.sections[section];
    var i: u32 = meta.first;
    val end: u32 = meta.first + meta.count;
    for (i < end) {
        val drop: *AtomDrop = ?plan.drops[i];
        if (off < drop.start) { ret false; }
        if (off < drop.end)   { ret true; }
        i = i + 1;
    }
    ret false;
}

fun atom_live_offset(plan: *AtomPlan, section: u32, off: u32) u32 {
    if (plan == nil || !plan.active || section >= plan.section_count) { ret off; }
    val meta: *AtomSection = ?plan.sections[section];
    var src_cursor: u32 = 0;
    var dst_cursor: u32 = 0;
    var i: u32 = meta.first;
    val end: u32 = meta.first + meta.count;
    for (i < end) {
        val drop: *AtomDrop = ?plan.drops[i];
        if (off < drop.start) { ret dst_cursor + (off - src_cursor); }
        if (off < drop.end)   { ret drop.resume; }
        src_cursor = drop.end;
        dst_cursor = drop.resume;
        i = i + 1;
    }
    ret dst_cursor + (off - src_cursor);
}

fun atom_live_len(plan: *AtomPlan, section: u32, original_len: u32) u32 {
    if (plan == nil || !plan.active || section >= plan.section_count) { ret original_len; }
    ret plan.sections[section].live_len;
}

fun copy_live_section(dst: *u8, src: *u8, src_len: u32, plan: *AtomPlan, section: u32) {
    if (plan == nil || !plan.active || section >= plan.section_count
        || plan.sections[section].count == 0) {
        memory.copy[u8](dst, src, src_len::usize);
        ret;
    }

    val meta: *AtomSection = ?plan.sections[section];
    var src_cursor: u32 = 0;
    var dst_cursor: u32 = 0;
    var i: u32 = meta.first;
    val end: u32 = meta.first + meta.count;
    for (i < end) {
        val drop: *AtomDrop = ?plan.drops[i];
        val n: u32 = drop.start - src_cursor;
        if (n > 0) {
            memory.copy[u8](?dst[dst_cursor], ?src[src_cursor], n::usize);
            dst_cursor = dst_cursor + n;
        }
        src_cursor = drop.end;
        dst_cursor = drop.resume;
        i = i + 1;
    }
    if (src_cursor < src_len) {
        memory.copy[u8](?dst[dst_cursor], ?src[src_cursor], (src_len - src_cursor)::usize);
    }
}

fun build_atom_plan(s: *session.Session, modules: *of.ObjectImage, module_count: u32,
                    codegen_count: u32, sec_base: *u32, sec_total: u32, enabled: bool,
                    arch: *isa.IsaVTable, plan: *AtomPlan) err[fail.Fail] {
    if (codegen_count > module_count) {
        ret err[fail.Fail].err{fail.message("linker: codegen image count exceeds module count")};
    }
    val fsb_r: err[fail.Fail] = fill_section_bases(modules, module_count, sec_base);
    if (sel fsb_r.err) { ret fsb_r; }
    if (!enabled) { ret err[fail.Fail].ok{}; }

    val symbol_total_r: res[u32, fail.Fail] = total_symbols(modules, module_count);
    if (sel symbol_total_r.err) { ret err[fail.Fail].err{symbol_total_r.err}; }
    val symbol_total: u32 = symbol_total_r.ok;
    var m: u32 = 0;

    var candidates: *AtomCandidate = nil;
    if (symbol_total > 0) {
        val cr: res[*AtomCandidate, A.Error] =
            A.zallocate[AtomCandidate](s.alloc, symbol_total::usize);
        if (sel cr.err) {
            ret err[fail.Fail].err{fail.refused(cr.err)};
        }
        candidates = cr.ok;
    }

    var winners: map.Map[intern.StrId, AtomWinner] =
        map.init[intern.StrId, AtomWinner](s.alloc, map.hash_u32, map.eq_u32);
    var candidate_count: u32 = 0;
    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if (of.section_is_external(sym.section) || of.section_is_absolute(sym.section)) { sy = sy + 1; cnt; }
            if (of.section_index(sym.section) >= modules[m].section_count) {
                map.dnit[intern.StrId, AtomWinner](?winners);
                if (candidates != nil) {
                    A.deallocate[AtomCandidate](s.alloc, candidates, symbol_total::usize);
                }
                ret err[fail.Fail].err{fail.message(oor_section_message(s, sym.name, modules[m].name))};
            }
            if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0) { sy = sy + 1; cnt; }

            val weak: bool = (sym.flags & of.SYM_OBJ_FLAG_WEAK) != 0;
            val existing: opt[*AtomWinner] =
                map.get[intern.StrId, AtomWinner](?winners, ?sym.name);
            if (sel existing.some) {
                val cur: *AtomWinner = existing.some;
                if (weak) {
                    candidates[candidate_count].module = m;
                    candidates[candidate_count].symbol = sy;
                    candidate_count = candidate_count + 1;
                    sy = sy + 1;
                    cnt;
                }
                if (!cur.weak) {
                    map.dnit[intern.StrId, AtomWinner](?winners);
                    if (candidates != nil) {
                        A.deallocate[AtomCandidate](s.alloc, candidates, symbol_total::usize);
                    }
                    ret err[fail.Fail].err{fail.message(dup_message(s, sym.name))};
                }
                candidates[candidate_count].module = cur.module;
                candidates[candidate_count].symbol = cur.symbol;
                candidate_count = candidate_count + 1;
                cur.module = m;
                cur.symbol = sy;
                cur.weak = false;
                sy = sy + 1;
                cnt;
            }

            var winner: AtomWinner;
            winner.module = m;
            winner.symbol = sy;
            winner.weak = weak;
            val ins: res[bool, A.Error] =
                map.insert[intern.StrId, AtomWinner](?winners, sym.name, winner);
            if (sel ins.err) {
                map.dnit[intern.StrId, AtomWinner](?winners);
                if (candidates != nil) {
                    A.deallocate[AtomCandidate](s.alloc, candidates, symbol_total::usize);
                }
                ret err[fail.Fail].err{fail.refused(ins.err)};
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    if (candidate_count == 0) {
        map.dnit[intern.StrId, AtomWinner](?winners);
        if (candidates != nil) {
            A.deallocate[AtomCandidate](s.alloc, candidates, symbol_total::usize);
        }
        ret err[fail.Fail].ok{};
    }

    val dr: res[*AtomDrop, A.Error] =
        A.zallocate[AtomDrop](s.alloc, candidate_count::usize);
    if (sel dr.err) {
        map.dnit[intern.StrId, AtomWinner](?winners);
        A.deallocate[AtomCandidate](s.alloc, candidates, symbol_total::usize);
        ret err[fail.Fail].err{fail.refused(dr.err)};
    }
    val drops: *AtomDrop = dr.ok;
    var drop_count: u32 = 0;

    var ref_total_checked: layout.CheckedCount[AtomRelocRefCountUnit] =
        layout.count[AtomRelocRefCountUnit](0::usize);
    m = 0;
    for (m < module_count) {
        val added: res[layout.CheckedCount[AtomRelocRefCountUnit], layout.CheckCause] =
            layout.count_add[AtomRelocRefCountUnit](ref_total_checked,
                layout.count[AtomRelocRefCountUnit](modules[m].reloc_count::usize));
        if (sel added.err) {
            map.dnit[intern.StrId, AtomWinner](?winners);
            A.deallocate[AtomCandidate](s.alloc, candidates, symbol_total::usize);
            A.deallocate[AtomDrop](s.alloc, drops, candidate_count::usize);
            ret err[fail.Fail].err{fail.message("linker: atom relocation reference count overflow")};
        }
        ref_total_checked =
            added.ok;
        var ri: u32 = 0;
        for (ri < modules[m].reloc_count) {
            if (of.is_difference(modules[m].relocations[ri].kind)) {
                val secondary: res[layout.CheckedCount[AtomRelocRefCountUnit], layout.CheckCause] =
                    layout.count_add[AtomRelocRefCountUnit](ref_total_checked,
                        layout.count[AtomRelocRefCountUnit](1::usize));
                if (sel secondary.err) {
                    map.dnit[intern.StrId, AtomWinner](?winners);
                    A.deallocate[AtomCandidate](s.alloc, candidates, symbol_total::usize);
                    A.deallocate[AtomDrop](s.alloc, drops, candidate_count::usize);
                    ret err[fail.Fail].err{fail.message("linker: atom relocation reference count overflow")};
                }
                ref_total_checked =
                    secondary.ok;
            }
            ri = ri + 1;
        }
        m = m + 1;
    }
    val ref_total_fits: res[u32, layout.CheckCause] =
        layout.usize_to_u32(ref_total_checked.value);
    if (sel ref_total_fits.err) {
        map.dnit[intern.StrId, AtomWinner](?winners);
        A.deallocate[AtomCandidate](s.alloc, candidates, symbol_total::usize);
        A.deallocate[AtomDrop](s.alloc, drops, candidate_count::usize);
        ret err[fail.Fail].err{fail.message("linker: atom relocation reference count exceeds the u32 limit")};
    }
    val ref_total: u32 = ref_total_fits.ok;
    var refs: *AtomRelocRef = nil;
    if (ref_total > 0) {
        if (arch == nil || arch.reloc == nil || arch.reloc.traits == nil) {
            map.dnit[intern.StrId, AtomWinner](?winners);
            A.deallocate[AtomCandidate](s.alloc, candidates, symbol_total::usize);
            A.deallocate[AtomDrop](s.alloc, drops, candidate_count::usize);
            ret err[fail.Fail].err{fail.message("linker: target cannot describe relocations")};
        }
        val rr: res[*AtomRelocRef, A.Error] =
            A.zallocate[AtomRelocRef](s.alloc, ref_total::usize);
        if (sel rr.err) {
            map.dnit[intern.StrId, AtomWinner](?winners);
            A.deallocate[AtomCandidate](s.alloc, candidates, symbol_total::usize);
            A.deallocate[AtomDrop](s.alloc, drops, candidate_count::usize);
            ret err[fail.Fail].err{fail.refused(rr.err)};
        }
        refs = rr.ok;
        var rw: u32 = 0;
        m = 0;
        for (m < module_count) {
            var ri: u32 = 0;
            for (ri < modules[m].reloc_count) {
                val relocation: *of.Relocation = ?modules[m].relocations[ri];
                if (of.section_index(relocation.section) >= modules[m].section_count) {
                    map.dnit[intern.StrId, AtomWinner](?winners);
                    A.deallocate[AtomCandidate](s.alloc, candidates, symbol_total::usize);
                    A.deallocate[AtomDrop](s.alloc, drops, candidate_count::usize);
                    A.deallocate[AtomRelocRef](s.alloc, refs, ref_total::usize);
                    ret err[fail.Fail].err{fail.message(named_message(s, "linker: object '", modules[m].name, "' has a relocation against a section it does not carry", "linker: a relocation names a section its object does not carry"))};
                }
                val ref_traits: res[rel.RelocTraits, rel.RelocError] = atom_reloc_traits(
                    relocation, ?modules[m].sections[of.section_index(relocation.section)],
                    arch, m < codegen_count);
                if (sel ref_traits.err) {
                    map.dnit[intern.StrId, AtomWinner](?winners);
                    A.deallocate[AtomCandidate](s.alloc, candidates, symbol_total::usize);
                    A.deallocate[AtomDrop](s.alloc, drops, candidate_count::usize);
                    A.deallocate[AtomRelocRef](s.alloc, refs, ref_total::usize);
                    ret err[fail.Fail].err{fail.message(named_message(s, "linker: object '", modules[m].name, "' carries a relocation kind this target's catalog does not describe", "linker: an input carries a relocation kind the target's catalog does not describe"))};
                }
                val traits: rel.RelocTraits = ref_traits.ok;
                var operand_count: u32 = 1;
                if (of.is_difference(relocation.kind)) { operand_count = 2; }
                var operand: u32 = 0;
                for (operand < operand_count) {
                    refs[rw].target_section = 0xFFFFFFFF;
                    refs[rw].target_module = 0xFFFFFFFF;
                    refs[rw].target_symbol = 0xFFFFFFFF;
                    refs[rw].source_module = m;
                    refs[rw].reloc = ri;
                    refs[rw].width = traits.field_width;
                    refs[rw].addend_mode = traits.addend_mode;
                    refs[rw].text_bias_min = traits.text_bias_min;
                    refs[rw].text_bias_max = traits.text_bias_max;
                    var target_symbol: u32 = relocation.sym;
                    if (operand == 1) {
                        target_symbol = relocation.sym2;
                        refs[rw].addend_mode = rel.RELOC_ADDEND_IGNORED;
                        refs[rw].text_bias_min = 0;
                        refs[rw].text_bias_max = 0;
                    }
                    if (!(of.section_index(relocation.section) < modules[m].section_count
                        && modules[m].sections[of.section_index(relocation.section)].kind == of.SK_DEBUG)) {
                        atom_reloc_ref_set_target(modules, m, target_symbol, sec_base,
                                                  ?winners, ?refs[rw]);
                    }
                    rw = rw + 1;
                    operand = operand + 1;
                }
                ri = ri + 1;
            }
            m = m + 1;
        }
        sort.sort[AtomRelocRef](refs, ref_total::usize, atom_reloc_ref_cmp);
    }

    var ci: u32 = 0;
    for (ci < candidate_count) {
        val cm: u32 = candidates[ci].module;
        val cy: u32 = candidates[ci].symbol;
        val sym: *of.Symbol = ?modules[cm].symbols[cy];
        val sec: *of.Section = ?modules[cm].sections[of.section_index(sym.section)];
        val need: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
        if ((sym.flags & need) != need || sec.kind != of.SK_TEXT || sec.bytes == nil
            || sym.offset >= sec.len) {
            ci = ci + 1;
            cnt;
        }

        val start: u32 = sym.offset;
        var end: u32 = 0;
        if (sym.size > 0) {
            val sized_end: u64 = start::u64 + sym.size::u64;
            if (sized_end > sec.len::u64) { ci = ci + 1; cnt; }
            end = sized_end::u32;
        }
        or {
            end = sec.len;
            var nsy: u32 = 0;
            for (nsy < modules[cm].symbol_count) {
                val other: *of.Symbol = ?modules[cm].symbols[nsy];
                if (of.section_same(other.section, sym.section)
                    && (other.flags & (of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION))
                        == (of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION)
                    && other.offset > start && other.offset < end) {
                    end = other.offset;
                }
                nsy = nsy + 1;
            }
        }
        if (end <= start) { ci = ci + 1; cnt; }

        var safe: bool = true;
        var sy: u32 = 0;
        for (sy < modules[cm].symbol_count) {
            if (sy != cy) {
                val other: *of.Symbol = ?modules[cm].symbols[sy];
                if (of.section_same(other.section, sym.section)
                    && !atom_is_carrier_anchor(?modules[cm], sym, other, start, end)
                    && !unreferenced_local(?modules[cm], sy)) {
                    if (other.offset >= start && other.offset < end) { safe = false; }
                    if (other.size > 0) {
                        val other_end: u64 = other.offset::u64 + other.size::u64;
                        if (other.offset < end && other_end > start::u64) {
                            safe = false;
                        }
                    }
                }
            }
            sy = sy + 1;
        }

        var ri: u32 = 0;
        for (safe && ri < modules[cm].reloc_count) {
            val r: *of.Relocation = ?modules[cm].relocations[ri];
            if (of.section_same(r.section, sym.section)) {
                val safety_traits: res[rel.RelocTraits, rel.RelocError] = atom_reloc_traits(
                    r, ?modules[cm].sections[of.section_index(r.section)], arch, cm < codegen_count);
                if (sel safety_traits.err) {
                    safe = false;
                }
                if (sel safety_traits.ok) {
                    val rstart: u64 = r.offset::u64;
                    val rend: u64 = rstart
                        + safety_traits.ok.field_width::u64;
                    if (rstart < end::u64 && rend > start::u64
                        && (rstart < start::u64 || rend > end::u64)) {
                        safe = false;
                    }
                }
            }
            ri = ri + 1;
        }

        val candidate_flat: u32 = sec_base[cm] + of.section_index(sym.section);
        var ref_i: u32 = atom_reloc_ref_lower(refs, ref_total, candidate_flat);
        for (safe && ref_i < ref_total
            && refs[ref_i].target_section == candidate_flat) {
            val rm: u32 = refs[ref_i].source_module;
            val rx: u32 = refs[ref_i].reloc;
            if (atom_reloc_crosses_candidate(modules, ?refs[ref_i],
                ?modules[rm].relocations[rx], cm, of.section_index(sym.section), start, end)) {
                safe = false;
            }
            ref_i = ref_i + 1;
        }
        if (safe) {
            drops[drop_count].section = sec_base[cm] + of.section_index(sym.section);
            drops[drop_count].start = start;
            drops[drop_count].end = end;
            drops[drop_count].resume = 0;
            drop_count = drop_count + 1;
        }
        ci = ci + 1;
    }
    map.dnit[intern.StrId, AtomWinner](?winners);
    if (refs != nil) { A.deallocate[AtomRelocRef](s.alloc, refs, ref_total::usize); }
    A.deallocate[AtomCandidate](s.alloc, candidates, symbol_total::usize);

    if (drop_count == 0) {
        A.deallocate[AtomDrop](s.alloc, drops, candidate_count::usize);
        ret err[fail.Fail].ok{};
    }

    sort.sort[AtomDrop](drops, drop_count::usize, atom_drop_cmp);

    var merged_count: u32 = 0;
    var di: u32 = 0;
    for (di < drop_count) {
        if (merged_count > 0
            && drops[merged_count - 1].section == drops[di].section
            && drops[di].start <= drops[merged_count - 1].end) {
            if (drops[di].end > drops[merged_count - 1].end) {
                drops[merged_count - 1].end = drops[di].end;
            }
        }
        or {
            drops[merged_count] = drops[di];
            merged_count = merged_count + 1;
        }
        di = di + 1;
    }

    val sr: res[*AtomSection, A.Error] =
        A.zallocate[AtomSection](s.alloc, sec_total::usize);
    if (sel sr.err) {
        A.deallocate[AtomDrop](s.alloc, drops, candidate_count::usize);
        ret err[fail.Fail].err{fail.refused(sr.err)};
    }
    val sections: *AtomSection = sr.ok;

    di = 0;
    var flat: u32 = 0;
    m = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val sec: *of.Section = ?modules[m].sections[sc];
            val meta: *AtomSection = ?sections[flat];
            meta.first = di;
            var src_cursor: u32 = 0;
            var dst_cursor: u32 = 0;
            for (di < merged_count && drops[di].section == flat) {
                dst_cursor = dst_cursor + (drops[di].start - src_cursor);
                if (drops[di].end < sec.len) {
                    dst_cursor =
                        atom_resume_offset(dst_cursor, drops[di].end, sec.align);
                }
                drops[di].resume = dst_cursor;
                src_cursor = drops[di].end;
                di = di + 1;
            }
            meta.count = di - meta.first;
            meta.live_len = dst_cursor + (sec.len - src_cursor);
            flat = flat + 1;
            sc = sc + 1;
        }
        m = m + 1;
    }

    plan.drops = drops;
    plan.drop_count = merged_count;
    plan.drop_cap = candidate_count;
    plan.sections = sections;
    plan.section_count = sec_total;
    plan.removed_bytes = 0;
    flat = 0;
    m = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            plan.removed_bytes = plan.removed_bytes
                + (modules[m].sections[sc].len - sections[flat].live_len)::u64;
            flat = flat + 1;
            sc = sc + 1;
        }
        m = m + 1;
    }
    plan.active = true;
    ret err[fail.Fail].ok{};
}

fun debug_str_content_eq(src: *u8, src_len: u32, src_off: u32,
                         ded: *u8, ded_len: u32, ded_off: u32) bool {
    var i: u32 = 0;
    for (true) {
        if (src_off::u64 + i::u64 >= src_len::u64) { ret false; }
        if (ded_off::u64 + i::u64 >= ded_len::u64) { ret false; }
        val sc: u8 = src[(src_off + i)::usize];
        val dc: u8 = ded[(ded_off + i)::usize];
        if (sc != dc) { ret false; }
        if (sc == 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun add_u32_counts[Unit](left: u32, right: u32) res[u32, layout.CheckCause] {
    val added_r: res[layout.CheckedCount[Unit], layout.CheckCause] =
        layout.count_add[Unit](layout.count[Unit](left::usize),
                               layout.count[Unit](right::usize));
    if (sel added_r.err) {
        ret res[u32, layout.CheckCause].err{added_r.err};
    }
    val lower_of_r: res[u32, layout.CheckCause] = layout.usize_to_u32(
        added_r.ok.value);
    if (sel lower_of_r.err) { ret res[u32, layout.CheckCause].err{lower_of_r.err}; }
    ret res[u32, layout.CheckCause].ok{lower_of_r.ok};
}

fun combined_image_count(image_count: u32, external_count: u32) res[u32, fail.Fail] {
    val total_r: res[u32, layout.CheckCause] = add_u32_counts[ImageCountUnit](image_count, external_count);
    if (sel total_r.err) {
        ret res[u32, fail.Fail].err{fail.message("linker: combined input object count overflow")};
    }
    ret res[u32, fail.Fail].ok{total_r.ok};
}

fun merged_section_count(debug_count: u32) res[u32, fail.Fail] {
    val total_r: res[u32, layout.CheckCause] = add_u32_counts[MergedSectionCountUnit](MERGED_KIND_COUNT, debug_count);
    if (sel total_r.err) {
        ret res[u32, fail.Fail].err{fail.message("linker: merged section count overflow")};
    }
    ret res[u32, fail.Fail].ok{total_r.ok};
}

fun total_frames(modules: *of.ObjectImage, module_count: u32) res[u32, fail.Fail] {
    var total: layout.CheckedCount[FrameCountUnit] =
        layout.count[FrameCountUnit](0::usize);
    var module_index: u32 = 0;
    for (module_index < module_count) {
        val added_r: res[layout.CheckedCount[FrameCountUnit], layout.CheckCause] =
            layout.count_add[FrameCountUnit](total,
                layout.count[FrameCountUnit](modules[module_index].frame_count::usize));
        if (sel added_r.err) {
            ret res[u32, fail.Fail].err{fail.message("linker: total input frame count overflow")};
        }
        total = added_r.ok;
        module_index = module_index + 1;
    }
    val total32_r: res[u32, layout.CheckCause] = layout.usize_to_u32(total.value);
    if (sel total32_r.err) {
        ret res[u32, fail.Fail].err{fail.message("linker: total input frame count exceeds the u32 limit")};
    }
    ret res[u32, fail.Fail].ok{total32_r.ok};
}

fun total_sections(modules: *of.ObjectImage, module_count: u32) res[u32, fail.Fail] {
    var total: layout.CheckedCount[SectionCountUnit] = layout.count[SectionCountUnit](0::usize);
    var m: u32 = 0;
    for (m < module_count) {
        val added: res[layout.CheckedCount[SectionCountUnit], layout.CheckCause] =
            layout.count_add[SectionCountUnit](total, layout.count[SectionCountUnit](modules[m].section_count::usize));
        if (sel added.err) {
            ret res[u32, fail.Fail].err{fail.message("linker: total input section count overflow")};
        }
        total = added.ok;
        m = m + 1;
    }
    val fits: res[u32, layout.CheckCause] = layout.usize_to_u32(total.value);
    if (sel fits.err) {
        ret res[u32, fail.Fail].err{fail.message("linker: total input section count exceeds the u32 limit")};
    }
    ret res[u32, fail.Fail].ok{fits.ok};
}

fun total_symbols(modules: *of.ObjectImage, module_count: u32) res[u32, fail.Fail] {
    var total: layout.CheckedCount[SymbolCountUnit] = layout.count[SymbolCountUnit](0::usize);
    var m: u32 = 0;
    for (m < module_count) {
        val added: res[layout.CheckedCount[SymbolCountUnit], layout.CheckCause] =
            layout.count_add[SymbolCountUnit](total, layout.count[SymbolCountUnit](modules[m].symbol_count::usize));
        if (sel added.err) {
            ret res[u32, fail.Fail].err{fail.message("linker: total input symbol count overflow")};
        }
        total = added.ok;
        m = m + 1;
    }
    val fits: res[u32, layout.CheckCause] = layout.usize_to_u32(total.value);
    if (sel fits.err) {
        ret res[u32, fail.Fail].err{fail.message("linker: total input symbol count exceeds the u32 limit")};
    }
    ret res[u32, fail.Fail].ok{fits.ok};
}

fun fill_symbol_bases(modules: *of.ObjectImage, module_count: u32, sym_base: *u32) err[fail.Fail] {
    var base: layout.CheckedCount[SymbolCountUnit] = layout.count[SymbolCountUnit](0::usize);
    var m: u32 = 0;
    for (m < module_count) {
        val base32: res[u32, layout.CheckCause] = layout.usize_to_u32(base.value);
        if (sel base32.err) {
            ret err[fail.Fail].err{fail.message("linker: flattened symbol index exceeds the u32 limit")};
        }
        sym_base[m] = base32.ok;
        val added: res[layout.CheckedCount[SymbolCountUnit], layout.CheckCause] =
            layout.count_add[SymbolCountUnit](base, layout.count[SymbolCountUnit](modules[m].symbol_count::usize));
        if (sel added.err) {
            ret err[fail.Fail].err{fail.message("linker: total input symbol count overflow")};
        }
        base = added.ok;
        m = m + 1;
    }
    ret err[fail.Fail].ok{};
}

fun accumulate_sections(s: *session.Session, modules: *of.ObjectImage, module_count: u32,
                        merged: *MergedSection, debug_names: *intern.StrId, debug_count: u32,
                        placements: *Placement, sec_base: *u32, strm: *StrMerge,
                        atoms: *AtomPlan, groups: *SectionGroups) err[fail.Fail] {
    val fsb_r: err[fail.Fail] = fill_section_bases(modules, module_count, sec_base);
    if (sel fsb_r.err) { ret fsb_r; }
    val sec_total_r: res[u32, fail.Fail] = total_sections(modules, module_count);
    if (sel sec_total_r.err) { ret err[fail.Fail].err{sec_total_r.err}; }
    val sec_total: u32 = sec_total_r.ok;
    val dr: res[*u32, fail.Fail] =
        plan_atom_coalescing(s.alloc, modules, module_count, sec_base, sec_total, atoms);
    if (sel dr.err) { ret err[fail.Fail].err{dr.err}; }
    val dup: *u32 = dr.ok;
    fin {
        if (dup != nil && sec_total > 0) { A.deallocate[u32](s.alloc, dup, sec_total::usize); }
    }
    val gp: err[fail.Fail] =
        plan_section_groups(s.alloc, modules, module_count, merged, atoms, sec_base, dup, groups);
    if (sel gp.err) { ret gp; }

    val an_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, ".debug_abbrev");
    if (sel an_r.err) { ret err[fail.Fail].err{fail.refused(an_r.err)}; }
    val abbrev_name: intern.StrId = an_r.ok;
    var abbrev_representative: *of.Section = nil;

    var flat: u32 = 0;
    var m: u32 = 0;
    for (m < module_count) {
        val debug_linkable: bool = module_debug_is_linkable(modules, m);
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val sec: *of.Section = ?modules[m].sections[sc];
            if (sec.kind::u32 >= MERGED_KIND_COUNT) {
                ret err[fail.Fail].err{fail.message(malformed_input_member(s, "SectionKind", sec.kind::u32, modules[m].name))};
            }
            var ki: u32 = sec.kind::u32;
            var dedup: bool = false;
            var str_slot: bool = false;
            if (sec.kind == of.SK_DEBUG) {
                var found: bool = false;
                var di: u32 = 0;
                for (di < debug_count) {
                    if (debug_names[di] == sec.name) { ki = MERGED_KIND_COUNT + di; found = true; }
                    di = di + 1;
                }
                if (!found) { ret err[fail.Fail].err{fail.message("linker: debug section name not registered in the merge")}; }
                if (sec.name == abbrev_name
                    && debug_abbrev_tables_equal(abbrev_representative, sec)) {
                    dedup = true;
                }
                if (strm.active && sec.name == strm.name) { str_slot = true; }
            }

            if (sec.kind == of.SK_DEBUG && !debug_linkable) {
                placements[flat].merged_index = ki;
                placements[flat].offset       = 0;
                placements[flat].vaddr        = 0;
                placements[flat].extent       = 0;
                flat = flat + 1;
                sc = sc + 1;
                cnt;
            }

            if (sec.kind == of.SK_DEBUG && sec.name == abbrev_name && sec.len > 0
                && abbrev_representative == nil) {
                abbrev_representative = sec;
            }

            if (str_slot) {
                var a: u32 = sec.align;
                if (a == 0)               { a = 1; }
                if (a > merged[ki].align) { merged[ki].align = a; }
                merged[ki].len  = strm.buf.len::u32;
                merged[ki].used = true;
                placements[flat].merged_index = ki;
                placements[flat].offset       = 0;
                placements[flat].vaddr        = 0;
                placements[flat].extent       = 0;
            }
            or (dedup) {
                var a: u32 = sec.align;
                if (a == 0)               { a = 1; }
                if (a > merged[ki].align) { merged[ki].align = a; }
                placements[flat].merged_index = ki;
                placements[flat].offset       = 0;
                placements[flat].vaddr        = 0;
                placements[flat].extent       = 0;
            }
            or (dup != nil && dup[flat] != ATOM_OWNS) {
                placements[flat] = placements[dup[flat]];
                placements[flat].extent = 0;
            }
            or {
                var a: u32 = sec.align;
                if (sec.kind == of.SK_EXCEPTION) { a = 4; }
                if (a == 0)               { a = 1; }
                if (a > merged[ki].align) { merged[ki].align = a; }

                var cursor: u64 = merged[ki].len::u64;
                var gi: u32 = 0xFFFFFFFF;
                if (is_loadable_kind(sec.kind)) {
                    gi = section_group_index(groups, ki, sec.name, sec.flags & of.SEC_FLAG_IMAGE_MASK);
                    if (gi == 0xFFFFFFFF) { ret err[fail.Fail].err{fail.message("linker: section group not registered in the merge")}; }
                    cursor = groups.items[gi].cursor::u64;
                }
                val off_r: res[u64, fail.Fail] = align_up_u64_checked(cursor, a::u64);
                if (sel off_r.err) { ret err[fail.Fail].err{off_r.err}; }
                val off64: u64 = off_r.ok;
                val contribution_len: u32 = atom_live_len(atoms, flat, sec.len);
                val newlen: u64 = off64 + contribution_len::u64;
                if (newlen > 0xFFFFFFFF) {
                    ret err[fail.Fail].err{fail.message(named_message(s, "linker: merged section '", merged_section_name(s, sec.kind), "' exceeds the 4 GiB u32 limit", "linker: merged section size exceeds the 4 GiB u32 limit"))};
                }

                placements[flat].merged_index = ki;
                placements[flat].offset       = off64::u32;
                placements[flat].vaddr        = 0;
                placements[flat].extent       = contribution_len;

                if (gi != 0xFFFFFFFF) {
                    groups.items[gi].cursor = newlen::u32;
                    if (newlen::u32 > merged[ki].len) { merged[ki].len = newlen::u32; }
                }
                or { merged[ki].len = newlen::u32; }
                merged[ki].used = true;
                if (sec.kind == of.SK_EXCEPTION && merged[ki].name == intern.STR_NIL) {
                    merged[ki].name = sec.name;
                }
            }

            flat = flat + 1;
            sc = sc + 1;
        }
        m = m + 1;
    }
    ret err[fail.Fail].ok{};
}

rec Contribution {
    merged_index: u32;
    offset:       u32;
    extent:       u32;
    flat:         u32;
}

fun contribution_order(a: *Contribution, b: *Contribution) i64 {
    if (a.merged_index < b.merged_index) { ret -1; }
    if (a.merged_index > b.merged_index) { ret 1; }
    if (a.offset < b.offset)             { ret -1; }
    if (a.offset > b.offset)             { ret 1; }
    if (a.flat < b.flat)                 { ret -1; }
    if (a.flat > b.flat)                 { ret 1; }
    ret 0;
}

fun contribution_name(s: *session.Session, modules: *of.ObjectImage, module_count: u32,
                      sec_base: *u32, flat: u32) str {
    var m: u32 = 0;
    for (m < module_count) {
        val base: u32 = sec_base[m];
        if (flat >= base && flat < base + modules[m].section_count) {
            var mod: str = "?";
            var sec: str = "?";
            val mn: opt[str] = intern.lookup(?s.interner, modules[m].name);
            val sn: opt[str] = intern.lookup(?s.interner, modules[m].sections[flat - base].name);
            if (sel mn.some) { mod = mn.some; }
            if (sel sn.some) { sec = sn.some; }
            ret join3(s, mod, ":", sec, "?");
        }
        m = m + 1;
    }
    ret "?";
}

val OVERLAP_FALLBACK: str = "linker: two section contributions claim overlapping ranges of one merged output section";

fun overlap_message(s: *session.Session, modules: *of.ObjectImage, module_count: u32,
                    sec_base: *u32, a: *Contribution, b: *Contribution) str {
    val an: str = contribution_name(s, modules, module_count, sec_base, a.flat);
    val bn: str = contribution_name(s, modules, module_count, sec_base, b.flat);
    val r: res[str, format.FormatError] = format.sprint(s.alloc,
        "linker: '{}' claims bytes {} through {} of a merged output section and '{}' claims bytes {} through {}; two contributions cannot occupy the same output range",
        an, a.offset::u64, a.offset::u64 + a.extent::u64,
        bn, b.offset::u64, b.offset::u64 + b.extent::u64);
    if (sel r.err) { ret OVERLAP_FALLBACK; }
    val buf: str = r.ok;
    val ir: res[intern.StrId, A.Error] = intern.intern(?s.interner, buf);
    str_free(s.alloc, buf);
    if (sel ir.err) { ret OVERLAP_FALLBACK; }
    val nm: opt[str] = intern.lookup(?s.interner, ir.ok);
    if (sel nm.some) { ret nm.some; }
    ret OVERLAP_FALLBACK;
}

fun validate_no_contribution_overlap(s: *session.Session, modules: *of.ObjectImage,
                                     module_count: u32, sec_base: *u32,
                                     placements: *Placement, sec_total: u32) err[fail.Fail] {
    if (sec_total < 2) { ret err[fail.Fail].ok{}; }

    val ar: res[*Contribution, A.Error] = A.allocate[Contribution](s.alloc, sec_total::usize);
    if (sel ar.err) {
        ret err[fail.Fail].err{fail.refused(ar.err)};
    }
    val items: *Contribution = ar.ok;
    fin { A.deallocate[Contribution](s.alloc, items, sec_total::usize); }

    var n: usize = 0;
    var flat: u32 = 0;
    for (flat < sec_total) {
        if (placements[flat].extent != 0) {
            items[n].merged_index = placements[flat].merged_index;
            items[n].offset       = placements[flat].offset;
            items[n].extent       = placements[flat].extent;
            items[n].flat         = flat;
            n = n + 1;
        }
        flat = flat + 1;
    }
    if (n < 2) { ret err[fail.Fail].ok{}; }

    sort.sort[Contribution](items, n, contribution_order);

    var i: usize = 1;
    for (i < n) {
        val prev: *Contribution = ?items[i - 1];
        val cur:  *Contribution = ?items[i];
        if (prev.merged_index == cur.merged_index
            && prev.offset::u64 + prev.extent::u64 > cur.offset::u64) {
            ret err[fail.Fail].err{fail.message(overlap_message(s, modules, module_count, sec_base, prev, cur))};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# one alignment for the whole linker, over the same primitive the object
# writers' file plan uses
fun align_up_u64_checked(value: u64, alignment: u64) res[u64, fail.Fail] {
    val aligned: res[u64, layout.CheckCause] = layout.align_u64_up(value, alignment);
    if (sel aligned.err) {
        if (aligned.err == layout.CHECK_ADD_OVERFLOW) {
            ret res[u64, fail.Fail].err{fail.message("linker: layout alignment overflows the address space")};
        }
        ret res[u64, fail.Fail].err{fail.message("linker: layout alignment is not a nonzero power of two")};
    }
    ret res[u64, fail.Fail].ok{aligned.ok};
}

fun reorder_flat_entry_first(modules: *of.ObjectImage, module_count: u32,
                             merged: *MergedSection, placements: *Placement, sec_base: *u32,
                             atoms: *AtomPlan, entry_name: intern.StrId) err[fail.Fail] {
    var entry_flat: u32 = 0xFFFFFFFF;
    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if (sym.name == entry_name && !of.section_is_external(sym.section)
                && of.section_index(sym.section) < modules[m].section_count
                && modules[m].sections[of.section_index(sym.section)].kind == of.SK_TEXT) {
                entry_flat = sec_base[m] + of.section_index(sym.section);
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    if (entry_flat == 0xFFFFFFFF) { ret err[fail.Fail].ok{}; }

    val text_slot: u32 = of.SK_TEXT::u32;

    var run: u64 = 0;
    var pass: u32 = 0;
    for (pass < 2) {
        m = 0;
        for (m < module_count) {
            var sc: u32 = 0;
            for (sc < modules[m].section_count) {
                val flat: u32 = sec_base[m] + sc;
                if (placements[flat].merged_index == text_slot) {
                    val is_entry: bool = flat == entry_flat;
                    if ((pass == 0 && is_entry) || (pass == 1 && !is_entry)) {
                        var a: u32 = modules[m].sections[sc].align;
                        if (a == 0) { a = 1; }
                        val aligned_r: res[u64, fail.Fail] = align_up_u64_checked(run, a::u64);
                        if (sel aligned_r.err) {
                            ret err[fail.Fail].err{aligned_r.err};
                        }
                        val aligned: u64 = aligned_r.ok;
                        val contribution: u64 =
                            atom_live_len(atoms, flat, modules[m].sections[sc].len)::u64;
                        if (aligned > 0xFFFFFFFFFFFFFFFF - contribution) {
                            ret err[fail.Fail].err{fail.message("linker: entry-first text layout overflows the address space")};
                        }
                        val next: u64 = aligned + contribution;
                        if (next > 0xFFFFFFFF) {
                            ret err[fail.Fail].err{fail.message("linker: entry-first text layout exceeds the 4 GiB u32 limit")};
                        }
                        placements[flat].offset = aligned::u32;
                        run = next;
                    }
                }
                sc = sc + 1;
            }
            m = m + 1;
        }
        pass = pass + 1;
    }

    merged[text_slot].len = run::u32;
    ret err[fail.Fail].ok{};
}

fun assign_section_vaddrs(tgt: *target.Target, merged: *MergedSection,
                          reserve: u64) err[fail.Fail] {
    val base: u64 = os_base_addr(tgt);
    val page: u64 = os_page_size(tgt);
    if (page == 0 || (page & (page - 1)) != 0) {
        ret err[fail.Fail].err{fail.message("linker: target page size is not a nonzero power of two")};
    }
    if (base > 0xFFFFFFFFFFFFFFFF - reserve) {
        ret err[fail.Fail].err{fail.message("linker: image base and header reserve overflow the address space")};
    }

    var va: u64 = base + reserve;
    var i: u32 = 0;
    for (i < MERGED_KIND_COUNT) {
        if (merged[i].used && is_loadable_kind(merged[i].kind)) {
            var seg_align: u64 = merged[i].align::u64;
            if (seg_align < page) { seg_align = page; }
            val aligned_r: res[u64, fail.Fail] = align_up_u64_checked(va, seg_align);
            if (sel aligned_r.err) {
                ret err[fail.Fail].err{aligned_r.err};
            }
            val aligned: u64 = aligned_r.ok;
            if (aligned > 0xFFFFFFFFFFFFFFFF - merged[i].len::u64) {
                ret err[fail.Fail].err{fail.message("linker: section virtual address range overflows the address space")};
            }
            merged[i].vaddr = aligned;
            va = aligned + merged[i].len::u64;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun finalize_placement_vaddrs(merged: *MergedSection, placements: *Placement, sec_total: u32) {
    var i: u32 = 0;
    for (i < sec_total) {
        val ki: u32 = placements[i].merged_index;
        placements[i].vaddr = merged[ki].vaddr + placements[i].offset::u64;
        i = i + 1;
    }
}

fun resolved_symbol_name(sym_locs: *map.Map[intern.StrId, SymbolLoc],
                         name: intern.StrId) res[intern.StrId, fail.Fail] {
    var cur: intern.StrId = name;
    var hops: usize = 0;
    for (hops <= sym_locs.len) {
        val lr: opt[*SymbolLoc] =
            map.get[intern.StrId, SymbolLoc](sym_locs, ?cur);
        if (sel lr.none) {
            ret res[intern.StrId, fail.Fail].ok{cur};
        }
        val loc: *SymbolLoc = lr.some;
        if (loc.fallback == intern.STR_NIL) {
            ret res[intern.StrId, fail.Fail].ok{cur};
        }
        cur = loc.fallback;
        hops = hops + 1;
    }
    ret res[intern.StrId, fail.Fail].err{fail.message("link: weak fallback cycle")};
}

fun collect_symbols(s: *session.Session, modules: *of.ObjectImage, module_count: u32,
                    placements: *Placement, sec_base: *u32,
                    sym_locs: *map.Map[intern.StrId, SymbolLoc], have_vaddrs: bool,
                    atoms: *AtomPlan) err[fail.Fail] {
    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if (of.section_is_external(sym.section)) { sy = sy + 1; cnt; }
            if (!of.section_is_absolute(sym.section) && of.section_index(sym.section) >= modules[m].section_count) {
                ret err[fail.Fail].err{fail.message(oor_section_message(s, sym.name, modules[m].name))};
            }
            if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0) { sy = sy + 1; cnt; }

            val is_weak: bool = (sym.flags & of.SYM_OBJ_FLAG_WEAK) != 0;
            var vaddr: u64 = sym.absolute_value;
            var section_vaddr: u64 = 0;
            var merged_index: u32 = of.SECTION_ABSOLUTE;
            if (!of.section_is_absolute(sym.section)) {
                val flat: u32 = sec_base[m] + of.section_index(sym.section);
                if (atom_offset_dead(atoms, flat, sym.offset)) { sy = sy + 1; cnt; }
                val pl: *Placement = ?placements[flat];
                merged_index = pl.merged_index;
                vaddr = 0;
                if (have_vaddrs) {
                    vaddr = pl.vaddr + atom_live_offset(atoms, flat, sym.offset)::u64;
                    section_vaddr = pl.vaddr - pl.offset::u64;
                }
            }

            val existing: opt[*SymbolLoc] =
                map.get[intern.StrId, SymbolLoc](sym_locs, ?sym.name);
            if (sel existing.some) {
                val cur: *SymbolLoc = existing.some;
                if (is_weak)   { sy = sy + 1; cnt; }
                if (!cur.weak) { ret err[fail.Fail].err{fail.message(dup_message(s, sym.name))}; }
                cur.vaddr = vaddr;
                cur.section_vaddr = section_vaddr;
                cur.merged_index = merged_index;
                cur.weak = false;
                cur.fallback = intern.STR_NIL;
                sy = sy + 1;
                cnt;
            }

            var loc: SymbolLoc;
            loc.vaddr = vaddr;
            loc.section_vaddr = section_vaddr;
            loc.merged_index = merged_index;
            loc.weak = is_weak;
            loc.fallback = intern.STR_NIL;

            val ins: res[bool, A.Error] =
                map.insert[intern.StrId, SymbolLoc](sym_locs, sym.name, loc);
            if (sel ins.err) {
                ret err[fail.Fail].err{fail.refused(ins.err)};
            }

            sy = sy + 1;
        }
        m = m + 1;
    }

    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if (!is_undefined_extern(sym)
                || (sym.flags & of.SYM_OBJ_FLAG_FALLBACK) == 0) {
                sy = sy + 1; cnt;
            }
            val fr: res[intern.StrId, fail.Fail] = weak_fallback_name(?modules[m], sym);
            if (sel fr.err) {
                ret err[fail.Fail].err{fr.err};
            }
            val fallback: intern.StrId = fr.ok;
            if (fallback == intern.STR_NIL) {
                ret err[fail.Fail].err{fail.message("link: weak fallback has no symbol name")};
            }
            val existing: opt[*SymbolLoc] =
                map.get[intern.StrId, SymbolLoc](sym_locs, ?sym.name);
            if (sel existing.some) {
                val cur: *SymbolLoc = existing.some;
                if (cur.fallback != intern.STR_NIL && cur.fallback != fallback) {
                    ret err[fail.Fail].err{fail.message("link: conflicting weak fallback targets")};
                }
            }
            if (sel existing.none) {
                var loc: SymbolLoc;
                loc.vaddr = 0;
                loc.section_vaddr = 0;
                loc.merged_index = 0;
                loc.weak = true;
                loc.fallback = fallback;
                val ir: res[bool, A.Error] =
                    map.insert[intern.StrId, SymbolLoc](sym_locs, sym.name, loc);
                if (sel ir.err) {
                    ret err[fail.Fail].err{fail.refused(ir.err)};
                }
            }
            sy = sy + 1;
        }
        m = m + 1;
    }

    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if ((sym.flags & of.SYM_OBJ_FLAG_FALLBACK) != 0) {
                val rr: res[intern.StrId, fail.Fail] =
                    resolved_symbol_name(sym_locs, sym.name);
                if (sel rr.err) {
                    ret err[fail.Fail].err{rr.err};
                }
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    ret err[fail.Fail].ok{};
}

fun build_merged_image(s: *session.Session, out_img: *of.ObjectImage,
                       modules: *of.ObjectImage, module_count: u32,
                       merged: *MergedSection, merged_count: u32, placements: *Placement, sec_base: *u32,
                       merged_to_out: *u32, sym_base: *u32, sym_out: *u32, strm: *StrMerge,
                       atoms: *AtomPlan) err[fail.Fail] {
    val alloc: *A.Allocator = s.alloc;
    val frame_total_r: res[u32, fail.Fail] = total_frames(modules, module_count);
    if (sel frame_total_r.err) {
        ret err[fail.Fail].err{frame_total_r.err};
    }
    val frame_total: u32 = frame_total_r.ok;

    var k: u32 = 0;
    for (k < merged_count) { merged_to_out[k] = 0xFFFFFFFF; k = k + 1; }

    k = 0;
    for (k < merged_count) {
        if (!merged[k].used || merged[k].len == 0) { k = k + 1; cnt; }

        var bytes: *u8 = nil;
        if (merged[k].kind != of.SK_BSS) {
            val zr: res[*u8, A.Error] = A.zallocate[u8](alloc, merged[k].len::usize);
            if (sel zr.err) { ret err[fail.Fail].err{fail.refused(zr.err)}; }
            bytes = zr.ok;

            if (strm.active && merged[k].kind == of.SK_DEBUG && merged[k].name == strm.name
                && strm.buf.len > 0) {
                memory.copy[u8](bytes, strm.buf.data, strm.buf.len);
            }
        }

        var sec: of.Section;
        if (merged[k].name == intern.STR_NIL) { sec.name = merged_section_name(s, merged[k].kind); }
        or                                    { sec.name = merged[k].name; }
        sec.kind  = merged[k].kind;
        sec.bytes = bytes;
        sec.len   = merged[k].len;
        sec.align = merged[k].align;
        sec.flags = 0;

        val add_r: res[u32, fail.Fail] = obj.section_install(out_img, ?sec);
        if (sel add_r.err) {
            ret err[fail.Fail].err{add_r.err};
        }
        merged_to_out[k] = add_r.ok;
        k = k + 1;
    }

    var m: u32 = 0;
    for (m < module_count) {
        val debug_linkable: bool = module_debug_is_linkable(modules, m);
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val src: *of.Section = ?modules[m].sections[sc];
            if (src.kind == of.SK_BSS || src.bytes == nil || src.len == 0) { sc = sc + 1; cnt; }
            if (strm.active && src.kind == of.SK_DEBUG && src.name == strm.name) { sc = sc + 1; cnt; }
            if (src.kind == of.SK_DEBUG && !debug_linkable) { sc = sc + 1; cnt; }

            val flat: u32 = sec_base[m] + sc;
            val ki: u32 = placements[flat].merged_index;
            val out_ix: u32 = merged_to_out[ki];
            if (out_ix == 0xFFFFFFFF) { sc = sc + 1; cnt; }

            val dst: *u8 = out_img.sections[out_ix].bytes;
            val off: u32 = placements[flat].offset;
            if (atom_live_len(atoms, flat, src.len) > 0) {
                copy_live_section(?dst[off], src.bytes, src.len, atoms, flat);
            }

            sc = sc + 1;
        }
        m = m + 1;
    }

    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            if (sym_out != nil) { sym_out[sym_base[m] + sy] = of.SYMBOL_NONE; }
            val isym: *of.Symbol = ?modules[m].symbols[sy];
            if (of.section_is_absolute(isym.section)) {
                val added: res[u32, fail.Fail] = obj.symbol_add(out_img, @isym);
                if (sel added.err) { ret err[fail.Fail].err{added.err}; }
                if (sym_out != nil) { sym_out[sym_base[m] + sy] = added.ok; }
                sy = sy + 1; cnt;
            }
            if (of.section_is_external(isym.section) || of.section_index(isym.section) >= modules[m].section_count) {
                sy = sy + 1; cnt;
            }

            val flat: u32 = sec_base[m] + of.section_index(isym.section);
            if (atom_offset_dead(atoms, flat, isym.offset)) { sy = sy + 1; cnt; }
            val ki: u32 = placements[flat].merged_index;
            val out_ix: u32 = merged_to_out[ki];
            if (out_ix == 0xFFFFFFFF) { sy = sy + 1; cnt; }

            var osym: of.Symbol = @isym;
            osym.section = of.section_id(out_ix);
            osym.offset  = placements[flat].offset
                + atom_live_offset(atoms, flat, isym.offset);

            val sa: res[u32, fail.Fail] = obj.symbol_add(out_img, osym);
            if (sel sa.err) { ret err[fail.Fail].err{sa.err}; }
            if (sym_out != nil) {
                sym_out[sym_base[m] + sy] = sa.ok;
            }

            sy = sy + 1;
        }
        m = m + 1;
    }

    if (frame_total > 0) {
        val fa: res[*of.FrameUnwind, A.Error] = A.allocate[of.FrameUnwind](out_img.alloc, frame_total::usize);
        if (sel fa.err) { ret err[fail.Fail].err{fail.refused(fa.err)}; }
        var out_frames: *of.FrameUnwind = fa.ok;
        var fn: u32 = 0;
        m = 0;
        for (m < module_count) {
            var fi: u32 = 0;
            for (fi < modules[m].frame_count) {
                val ifr: *of.FrameUnwind = ?modules[m].frames[fi];
                if (of.section_index(ifr.section) >= modules[m].section_count) { fi = fi + 1; cnt; }
                val flat: u32 = sec_base[m] + of.section_index(ifr.section);
                if (atom_offset_dead(atoms, flat, ifr.offset)) { fi = fi + 1; cnt; }
                val ki: u32 = placements[flat].merged_index;
                val out_ix: u32 = merged_to_out[ki];
                if (out_ix == 0xFFFFFFFF) { fi = fi + 1; cnt; }

                out_frames[fn] = @ifr;
                out_frames[fn].section = of.section_id(out_ix);
                out_frames[fn].offset  = placements[flat].offset
                    + atom_live_offset(atoms, flat, ifr.offset);
                fn = fn + 1;
                fi = fi + 1;
            }
            m = m + 1;
        }
        if (fn == 0) {
            A.deallocate[of.FrameUnwind](out_img.alloc, out_frames, frame_total::usize);
        }
        or {
            if (fn < frame_total) {
                val fs: res[*of.FrameUnwind, A.Error] =
                    A.reallocate[of.FrameUnwind](out_img.alloc, out_frames, frame_total::usize, fn::usize);
                if (sel fs.err) {
                    A.deallocate[of.FrameUnwind](out_img.alloc, out_frames, frame_total::usize);
                    ret err[fail.Fail].err{fail.refused(fs.err)};
                }
                out_frames = fs.ok;
            }
            out_img.frames      = out_frames;
            out_img.frame_count = fn;
            out_img.frame_cap   = fn;
        }
    }

    ret err[fail.Fail].ok{};
}

fun patch_relocations(s: *session.Session, out_img: *of.ObjectImage,
                     modules: *of.ObjectImage, module_count: u32, codegen_count: u32,
                     placements: *Placement, sec_base: *u32, merged_to_out: *u32,
                     sym_locs: *map.Map[intern.StrId, SymbolLoc],
                     dyn: *DynState, local_got: *LocalGotPlan,
                     strm: *StrMerge, format: *of.OfVTable,
                     arch: *isa.IsaVTable,
                     image_base: u64, atoms: *AtomPlan) err[fail.Fail] {
    var m: u32 = 0;
    for (m < module_count) {
        val pr: err[fail.Fail] = patch_module_relocations(s, out_img, modules, m,
            placements, sec_base, merged_to_out, sym_locs, dyn, local_got, strm,
            format, arch, image_base, m < codegen_count, atoms);
        if (sel pr.err) { ret pr; }

        m = m + 1;
    }
    ret err[fail.Fail].ok{};
}

fun difference_subtrahend_vaddr(s: *session.Session, modules: *of.ObjectImage, m: u32,
                                sym2: u32, placements: *Placement, sec_base: *u32,
                                merged_to_out: *u32, out_img: *of.ObjectImage,
                                format: *of.OfVTable, image_base: u64, atoms: *AtomPlan,
                                sym_locs: *map.Map[intern.StrId, SymbolLoc]) res[u64, fail.Fail] {
    if (sym2 >= modules[m].symbol_count) {
        ret res[u64, fail.Fail].err{fail.message("link: a difference relocation names a subtrahend outside the module's symbol table")};
    }
    val sub: *of.Symbol = ?modules[m].symbols[sym2];
    val sub_name: intern.StrId = sub.name;

    if ((sub.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0 && !of.section_is_external(sub.section)) {
        var t: rel.RelocTarget = rel.target(0, 0, 0);
        if (!local_symbol_target(modules, m, sym2, placements, sec_base, merged_to_out,
                                 out_img, format, image_base, atoms, ?t)) {
            ret res[u64, fail.Fail].err{fail.message(undef_message(s, sub_name))};
        }
        ret res[u64, fail.Fail].ok{t.vaddr};
    }

    val rn: res[intern.StrId, fail.Fail] = resolved_symbol_name(sym_locs, sub_name);
    if (sel rn.err) {
        ret res[u64, fail.Fail].err{rn.err};
    }
    val resolved_name: intern.StrId = rn.ok;
    val sl: opt[*SymbolLoc] = map.get[intern.StrId, SymbolLoc](sym_locs, ?resolved_name);
    if (sel sl.none) {
        ret res[u64, fail.Fail].err{fail.message(difference_import_message(s, sub_name))};
    }
    ret res[u64, fail.Fail].ok{sl.some.vaddr};
}

fun difference_relocation_addend(addend: i64, subtrahend: u64) res[i64, fail.Fail] {
    val adjusted: res[i64, rel.RelocError] =
        rel.subtract_u64_from_i64(addend, subtrahend);
    if (sel adjusted.err) {
        ret res[i64, fail.Fail].err{fail.message("link: difference relocation result is outside the signed 64-bit range")};
    }
    ret res[i64, fail.Fail].ok{adjusted.ok};
}

fun base_relocation_target(vaddr: u64, addend: i64) res[u64, fail.Fail] {
    val adjusted: res[u64, rel.RelocError] = rel.add_signed_to_u64(vaddr, addend);
    if (sel adjusted.err) {
        ret res[u64, fail.Fail].err{fail.message("link: PIE base relocation target is outside the 64-bit address range")};
    }
    ret res[u64, fail.Fail].ok{adjusted.ok};
}

fun difference_import_message(s: *session.Session, name: intern.StrId) str {
    val n: opt[str] = intern.lookup(?s.interner, name);
    var shown: str = "<unknown>";
    if (sel n.some) { shown = n.some; }
    val r: res[str, format.FormatError] = format.sprint(s.alloc,
        "link: a difference relocation subtracts `{}`, which this link does not define; the loader chooses its address, so the difference is not a link-time constant",
        shown);
    if (sel r.err) {
        ret "link: a difference relocation subtracts a symbol this link does not define";
    }
    ret r.ok;
}

fun local_symbol_target(modules: *of.ObjectImage, m: u32, sy: u32,
                        placements: *Placement, sec_base: *u32, merged_to_out: *u32,
                        out_img: *of.ObjectImage, format: *of.OfVTable,
                        image_base: u64, atoms: *AtomPlan,
                        out: *rel.RelocTarget) bool {
    val sym: *of.Symbol = ?modules[m].symbols[sy];
    if (of.section_is_absolute(sym.section)) {
        @out = rel.target(sym.absolute_value, 0, 0);
        ret true;
    }
    val flat: u32 = sec_base[m] + of.section_index(sym.section);
    if (atom_offset_dead(atoms, flat, sym.offset)) { ret false; }
    val pl: *Placement = ?placements[flat];
    val out_ix: u32 = merged_to_out[pl.merged_index];
    val section: of.ExecutableSectionLocation = final_section_location_for(
        format, image_base, out_img, out_ix, pl.vaddr - pl.offset::u64);
    @out = rel.target(pl.vaddr + atom_live_offset(atoms, flat, sym.offset)::u64,
                      section.vaddr, section.ordinal);
    ret true;
}

fun module_weak_function_ref_is_dead(modules: *of.ObjectImage, m: u32, name: intern.StrId,
                                     addend: i64, sec_base: *u32, atoms: *AtomPlan) bool {
    var sy: u32 = 0;
    for (sy < modules[m].symbol_count) {
        val sym: *of.Symbol = ?modules[m].symbols[sy];
        if (sym.name == name && !of.section_is_external(sym.section)
            && of.section_index(sym.section) < modules[m].section_count) {
            val need: u32 = of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
            if ((sym.flags & need) != need) { ret false; }
            val eff: i64 = sym.offset::i64 + addend;
            if (eff < 0 || eff > 0xFFFFFFFF) { ret false; }
            ret atom_offset_dead(atoms, sec_base[m] + of.section_index(sym.section), eff::u32);
        }
        sy = sy + 1;
    }
    ret false;
}

fun is_dwarf_code_address(r: *of.Relocation, info_sec: u32, line_sec: u32,
                          loclists_sec: u32, rnglists_sec: u32, pointer_width: u32) bool {
    if (!of.is_pointer_abs_kind(r.kind, pointer_width)) { ret false; }
    ret of.section_index(r.section) == info_sec || of.section_index(r.section) == line_sec
        || of.section_index(r.section) == loclists_sec || of.section_index(r.section) == rnglists_sec;
}

fun dwarf_addend_survives_remap(modules: *of.ObjectImage, m: u32, sy: u32,
                                addend: i64, sec_base: *u32, atoms: *AtomPlan) bool {
    if (addend == 0) { ret true; }
    val sym: *of.Symbol = ?modules[m].symbols[sy];
    if (of.section_is_external(sym.section) || of.section_index(sym.section) >= modules[m].section_count) {
        ret true;
    }
    val eff: i64 = sym.offset::i64 + addend;
    if (eff < 0 || eff > 0xFFFFFFFF) { ret false; }
    val flat: u32 = sec_base[m] + of.section_index(sym.section);
    val e: u32 = eff::u32;
    if (atom_offset_dead(atoms, flat, sym.offset) || atom_offset_dead(atoms, flat, e)) {
        ret true;
    }
    val want: i64 = atom_live_offset(atoms, flat, sym.offset)::i64 + addend;
    ret atom_live_offset(atoms, flat, e)::i64 == want;
}

fun patch_module_relocations(s: *session.Session, out_img: *of.ObjectImage,
                             modules: *of.ObjectImage, m: u32,
                             placements: *Placement, sec_base: *u32, merged_to_out: *u32,
                             sym_locs: *map.Map[intern.StrId, SymbolLoc], dyn: *DynState,
                             local_got: *LocalGotPlan, strm: *StrMerge, format: *of.OfVTable,
                             arch: *isa.IsaVTable, image_base: u64, codegen_image: bool,
                             atoms: *AtomPlan) err[fail.Fail] {
    var info_sec: u32 = 0xFFFFFFFF;
    var line_sec: u32 = 0xFFFFFFFF;
    var loclists_sec: u32 = 0xFFFFFFFF;
    var rnglists_sec: u32 = 0xFFFFFFFF;
    val info_name_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, ".debug_info");
    if (sel info_name_r.err) {
        ret err[fail.Fail].err{fail.refused(info_name_r.err)};
    }
    val line_name_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, ".debug_line");
    if (sel line_name_r.err) {
        ret err[fail.Fail].err{fail.refused(line_name_r.err)};
    }
    val loclists_name_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, ".debug_loclists");
    if (sel loclists_name_r.err) {
        ret err[fail.Fail].err{fail.refused(loclists_name_r.err)};
    }
    val rnglists_name_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, ".debug_rnglists");
    if (sel rnglists_name_r.err) {
        ret err[fail.Fail].err{fail.refused(rnglists_name_r.err)};
    }
    val info_name: intern.StrId = info_name_r.ok;
    val line_name: intern.StrId = line_name_r.ok;
    val loclists_name: intern.StrId = loclists_name_r.ok;
    val rnglists_name: intern.StrId = rnglists_name_r.ok;
    var scx: u32 = 0;
    for (scx < modules[m].section_count) {
        if (modules[m].sections[scx].kind == of.SK_DEBUG) {
            if (modules[m].sections[scx].name == info_name)                { info_sec = scx; }
            or (modules[m].sections[scx].name == line_name)         { line_sec = scx; }
            or (modules[m].sections[scx].name == loclists_name) { loclists_sec = scx; }
            or (modules[m].sections[scx].name == rnglists_name) { rnglists_sec = scx; }
        }
        scx = scx + 1;
    }

    val debug_linkable: bool = module_debug_is_linkable(modules, m);

    var ri: u32 = 0;
    for (ri < modules[m].reloc_count) {
        val r: *of.Relocation = ?modules[m].relocations[ri];
        if (arch == nil || arch.reloc == nil || arch.reloc.traits == nil
            || arch.reloc.apply == nil) {
            ret err[fail.Fail].err{fail.message(unsupported_message(s, arch, r.kind))};
        }
        if (!debug_linkable && of.section_index(r.section) < modules[m].section_count
            && modules[m].sections[of.section_index(r.section)].kind == of.SK_DEBUG) {
            ri = ri + 1; cnt;
        }
        if (of.section_index(r.section) >= modules[m].section_count) {
            ret err[fail.Fail].err{fail.message("linker: relocation names an out-of-range section")};
        }
        val place_traits: res[rel.RelocTraits, rel.RelocError] = atom_reloc_traits(
            r, ?modules[m].sections[of.section_index(r.section)], arch, codegen_image);
        if (sel place_traits.err) {
            ret err[fail.Fail].err{fail.message(unsupported_message(s, arch, r.kind))};
        }
        if (r.offset::u64
            + place_traits.ok.field_width::u64
            > modules[m].sections[of.section_index(r.section)].len::u64) {
            ret err[fail.Fail].err{fail.message("linker: relocation offset is past the end of its section")};
        }

        val flat: u32 = sec_base[m] + of.section_index(r.section);
        if (atom_offset_dead(atoms, flat, r.offset)) { ri = ri + 1; cnt; }
        val pl: *Placement = ?placements[flat];
        val live_off: u32 = atom_live_offset(atoms, flat, r.offset);
        val patch_va: u64 = pl.vaddr + live_off::u64;
        val out_ix: u32 = merged_to_out[pl.merged_index];
        if (out_ix == 0xFFFFFFFF) {
            ret err[fail.Fail].err{fail.message("linker: relocation targets a section with no merged output")};
        }
        val dst: *u8 = out_img.sections[out_ix].bytes;
        if (dst == nil) {
            ret err[fail.Fail].err{fail.message("linker: relocation patch site lands in a BSS section")};
        }
        val patch_off: u32 = pl.offset + live_off;

        val operand_r: res[of.RelocOperand, fail.Fail] =
            rel.resolve_operand(arch, ?modules[m], ri);
        if (sel operand_r.err) {
            ret err[fail.Fail].err{operand_r.err};
        }
        val operand: of.RelocOperand = operand_r.ok;
        val target_sym: u32 = operand.sym;
        val target_addend: i64 = operand.addend;

        if (target_sym >= modules[m].symbol_count) {
            ret err[fail.Fail].err{fail.message("linker: relocation references a symbol outside its module's symbol table")};
        }
        val target: *of.Symbol = ?modules[m].symbols[target_sym];
        val target_name: intern.StrId = target.name;
        if (!of.section_is_external(target.section) && !of.section_is_absolute(target.section)
            && of.section_index(target.section) >= modules[m].section_count) {
            ret err[fail.Fail].err{fail.message(oor_section_message(s, target_name, modules[m].name))};
        }

        if (strm.active && of.section_index(target.section) < modules[m].section_count
            && modules[m].sections[of.section_index(target.section)].kind == of.SK_DEBUG
            && modules[m].sections[of.section_index(target.section)].name == strm.name) {
            val sp: err[fail.Fail] = resolve_strp(s, modules, m, of.section_index(target.section), target, r, strm,
                dst, patch_off, out_img.sections[out_ix].len, patch_va, arch, image_base);
            if (sel sp.err) { ret sp; }
            ri = ri + 1; cnt;
        }

        var resolved: rel.RelocTarget = rel.target(0, 0, 0);
        var resolved_absolute: bool = of.section_is_absolute(target.section);
        var apply_addend: i64 = target_addend;

        if (is_dwarf_code_address(r, info_sec, line_sec, loclists_sec, rnglists_sec, arch.pointer_width)
            && !dwarf_addend_survives_remap(modules, m, target_sym, target_addend, sec_base, atoms)) {
            ret err[fail.Fail].err{fail.message(dwarf_addend_message(s, modules, m, target_name, r))};
        }

        if ((target.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0
            && !of.section_is_external(target.section)) {
            if (!local_symbol_target(modules, m, target_sym, placements, sec_base,
                                     merged_to_out, out_img, format, image_base,
                                     atoms, ?resolved)) {
                ret err[fail.Fail].err{fail.message(undef_message(s, target_name))};
            }
        }
        or {
            val rn: res[intern.StrId, fail.Fail] =
                resolved_symbol_name(sym_locs, target_name);
            if (sel rn.err) {
                ret err[fail.Fail].err{rn.err};
            }
            val resolved_name: intern.StrId = rn.ok;
            val sl: opt[*SymbolLoc] =
                map.get[intern.StrId, SymbolLoc](sym_locs, ?resolved_name);
            if (sel sl.some) {
                val loc: *SymbolLoc = sl.some;
                resolved = rel.target(loc.vaddr, 0, 0);
                resolved_absolute = loc.merged_index == of.SECTION_ABSOLUTE;
                if (loc.merged_index != of.SECTION_ABSOLUTE) {
                    val target_out_ix: u32 = merged_to_out[loc.merged_index];
                    val section: of.ExecutableSectionLocation = final_section_location_for(
                        format, image_base, out_img, target_out_ix, loc.section_vaddr);
                    resolved = rel.target(loc.vaddr, section.vaddr, section.ordinal);
                }
                if ((of.section_index(r.section) == info_sec || of.section_index(r.section) == line_sec
                     || of.section_index(r.section) == loclists_sec || of.section_index(r.section) == rnglists_sec)
                    && of.is_pointer_abs_kind(r.kind, arch.pointer_width)
                    && module_weak_function_ref_is_dead(modules, m, target_name, target_addend, sec_base, atoms)) {
                    resolved.vaddr = DWARF_TOMBSTONE_ADDRESS;
                    apply_addend = 0;
                }
            }
            if (sel sl.none) {
                val cn_r: res[ImportName, fail.Fail] =
                    canonical_import_name(s, format.import_address_prefix, resolved_name);
                if (sel cn_r.err) {
                    ret err[fail.Fail].err{cn_r.err};
                }
                val cn: ImportName = cn_r.ok;
                val imp: res[u32, fail.Fail] = dynstate_import_index(dyn, resolved_name);
                if (sel imp.ok) {
                val import_index: u32 = imp.ok;
                if (cn.indirect && r.kind == of.RK_PC32) {
                    val rec_i: err[fail.Fail] = dynstate_add_import_addr_fixup(
                        s, dyn, segment_index_for(out_img, out_ix), patch_off,
                        import_index, patch_va, r.kind, target_addend);
                    if (sel rec_i.err) {
                        ret rec_i;
                    }
                    ri = ri + 1; cnt;
                }
                if (is_function_branch_kind(r.kind)
                    && dynstate_import_is_func(dyn, import_index)) {
                    val rec_r: err[fail.Fail] = dynstate_add_fixup(s, dyn,
                        segment_index_for(out_img, out_ix), patch_off,
                        import_index, patch_va, target_addend);
                    if (sel rec_r.err) { ret rec_r; }
                    ri = ri + 1; cnt;
                }
                if (is_got_kind(operand.target_kind)) {
                    val rec_g: err[fail.Fail] = dynstate_add_import_addr_fixup(s, dyn,
                        segment_index_for(out_img, out_ix), patch_off,
                        import_index, patch_va, r.kind, target_addend);
                    if (sel rec_g.err) { ret rec_g; }
                    ri = ri + 1; cnt;
                }
                if (of.is_pointer_abs_kind(r.kind, arch.pointer_width)
                    && format.id == of.OF_MACHO) {
                    val rec_b: err[fail.Fail] = dynstate_add_import_addr_fixup(s, dyn,
                        segment_index_for(out_img, out_ix), patch_off,
                        import_index, patch_va, r.kind, target_addend);
                    if (sel rec_b.err) { ret rec_b; }
                    ri = ri + 1; cnt;
                }
                }
                ret err[fail.Fail].err{fail.message(undef_message(s, resolved_name))};
            }
        }

        if (is_got_kind(operand.target_kind)) {
            if (!isa.local_got_kind(arch, operand.target_kind)) {
                ret err[fail.Fail].err{fail.message("linker: target does not support defined GOT references")};
            }
            val local: bool = !of.section_is_external(target.section)
                && (target.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0;
            var effective: intern.StrId = target_name;
            if (!local) {
                val er: res[intern.StrId, fail.Fail] =
                    resolved_symbol_name(sym_locs, target_name);
                if (sel er.err) {
                    ret err[fail.Fail].err{er.err};
                }
                effective = er.ok;
            }
            val slot_i: u32 = local_got_slot_index(
                local_got, m, target_sym, effective, local);
            if (slot_i == 0xFFFFFFFF) {
                ret err[fail.Fail].err{fail.message("linker: defined GOT target has no synthesized slot")};
            }
            val got_out: u32 = merged_to_out[of.SK_RELRO::u32];
            if (got_out == 0xFFFFFFFF || got_out >= out_img.section_count
                || out_img.sections[got_out].bytes == nil) {
                ret err[fail.Fail].err{fail.message("linker: synthesized GOT has no RELRO output section")};
            }
            val slot: *LocalGotSlot = ?local_got.slots[slot_i];
            if (slot.offset::u64 + arch.pointer_width::u64 > out_img.sections[got_out].len::u64) {
                ret err[fail.Fail].err{fail.message("linker: synthesized GOT slot is outside RELRO")};
            }
            if (!slot.initialized) {
                if (arch.pointer_width == 4) {
                    if (resolved.vaddr > 0xFFFFFFFF) {
                        ret err[fail.Fail].err{fail.message("linker: GOT target exceeds the pointer width")};
                    }
                    bin.write_u32_le(out_img.sections[got_out].bytes, slot.offset::usize, resolved.vaddr::u32);
                } or {
                    bin.write_u64_le(out_img.sections[got_out].bytes, slot.offset::usize, resolved.vaddr);
                }
                if (dyn.info.pie && !resolved_absolute) {
                    val br: err[fail.Fail] = dynstate_add_base_reloc(
                        s, dyn, segment_index_for(out_img, got_out),
                        slot.offset, resolved.vaddr);
                    if (sel br.err) {
                        ret br;
                    }
                }
                slot.initialized = true;
            }
            val got_section: of.ExecutableSectionLocation = final_section_location_for(
                format, image_base, out_img, got_out, slot.vaddr - slot.offset::u64);
            val gr: err[fail.Fail] = apply_one(
                s, r.kind, dst, patch_off, out_img.sections[out_ix].len,
                rel.target(slot.vaddr, got_section.vaddr, got_section.ordinal),
                target_addend, patch_va, target_name, arch, image_base);
            if (sel gr.err) {
                ret gr;
            }
            ri = ri + 1; cnt;
        }

        if (dyn.info.pie && resolved_absolute && is_loadable_kind(out_img.sections[out_ix].kind)
            && (r.kind == of.RK_PC32 || r.kind == of.RK_PLT32 || r.kind == of.RK_PAGE21
                || r.kind == of.RK_PCREL_HI20 || r.kind == of.RK_PCREL_LO12_I || r.kind == of.RK_PCREL_LO12_S
                || r.kind == of.RK_JUMP26 || r.kind == of.RK_ADDR32NB)) {
            ret err[fail.Fail].err{fail.message("link: position-independent relocation to an absolute definition requires unsupported runtime adjustment")};
        }
        var apply_kind: of.RelocKind = r.kind;
        if (of.is_difference(r.kind)) {
            val sv: res[u64, fail.Fail] = difference_subtrahend_vaddr(
                s, modules, m, r.sym2, placements, sec_base, merged_to_out, out_img,
                format, image_base, atoms, sym_locs);
            if (sel sv.err) { ret err[fail.Fail].err{sv.err}; }
            if (dyn.info.pie && is_loadable_kind(out_img.sections[out_ix].kind)) {
                val sub: *of.Symbol = ?modules[m].symbols[r.sym2];
                var sub_absolute: bool = of.section_is_absolute(sub.section);
                if ((sub.flags & of.SYM_OBJ_FLAG_GLOBAL) != 0 || of.section_is_external(sub.section)) {
                    val named: res[intern.StrId, fail.Fail] = resolved_symbol_name(sym_locs, sub.name);
                    if (sel named.err) { ret err[fail.Fail].err{named.err}; }
                    val name: intern.StrId = named.ok;
                    val located: opt[*SymbolLoc] = map.get[intern.StrId, SymbolLoc](sym_locs, ?name);
                    if (sel located.none) { ret err[fail.Fail].err{fail.message(undef_message(s, name))}; }
                    sub_absolute = located.some.merged_index == of.SECTION_ABSOLUTE;
                }
                if (resolved_absolute != sub_absolute) {
                    ret err[fail.Fail].err{fail.message("link: position-independent difference mixes absolute and image-relative definitions")};
                }
            }
            val adjusted: res[i64, fail.Fail] = difference_relocation_addend(
                apply_addend, sv.ok);
            if (sel adjusted.err) {
                ret err[fail.Fail].err{adjusted.err};
            }
            apply_addend = adjusted.ok;
            val applied: opt[of.RelocKind] = of.difference_apply_kind(r.kind);
            if (sel applied.none) {
                ret err[fail.Fail].err{fail.message(of.reloc_kind_rejection(?s.interner, s.alloc, r.kind, ""))};
            }
            apply_kind = applied.some;
        }

        val pr: err[fail.Fail] =
            apply_one(s, apply_kind, dst, patch_off, out_img.sections[out_ix].len, resolved,
                      apply_addend, patch_va, target_name, arch, image_base);
        if (sel pr.err) {
            ret pr;
        }

        if (dyn.info.pie && !resolved_absolute && of.is_pointer_abs_kind(r.kind, arch.pointer_width)
            && is_loadable_kind(out_img.sections[out_ix].kind)) {
            val base_target: res[u64, fail.Fail] =
                base_relocation_target(resolved.vaddr, target_addend);
            if (sel base_target.err) {
                ret err[fail.Fail].err{base_target.err};
            }
            val brr: err[fail.Fail] = dynstate_add_base_reloc(s, dyn,
                segment_index_for(out_img, out_ix), patch_off,
                base_target.ok);
            if (sel brr.err) { ret brr; }
        }

        ri = ri + 1;
    }
    ret err[fail.Fail].ok{};
}

fun debug_str_source_offset(target_offset: u32, addend: i64,
                            section_len: u32) res[u32, fail.Fail] {
    var source_offset: u32 = 0;
    if (!atom_effective_offset(target_offset, addend, ?source_offset)
        || source_offset >= section_len) {
        ret res[u32, fail.Fail].err{fail.message("linker: .debug_str strp target offset and addend are out of range")};
    }
    ret res[u32, fail.Fail].ok{source_offset};
}

fun resolve_strp(s: *session.Session, modules: *of.ObjectImage, m: u32, str_sec: u32,
                 target: *of.Symbol, r: *of.Relocation, strm: *StrMerge,
                 dst: *u8, patch_off: u32, sec_len: u32,
                 patch_va: u64, arch: *isa.IsaVTable, image_base: u64) err[fail.Fail] {
    val ssec: *of.Section = ?modules[m].sections[str_sec];
    if (ssec.bytes == nil) {
        ret err[fail.Fail].err{fail.message("linker: .debug_str strp target has no bytes")};
    }
    val source_offset_r: res[u32, fail.Fail] =
        debug_str_source_offset(target.offset, r.addend, ssec.len);
    if (sel source_offset_r.err) {
        ret err[fail.Fail].err{source_offset_r.err};
    }
    val src_off: u32 = source_offset_r.ok;
    var terminator: u32 = src_off;
    for (terminator < ssec.len && ssec.bytes[terminator] != 0) {
        terminator = terminator + 1;
    }
    if (terminator >= ssec.len) {
        ret err[fail.Fail].err{fail.message("linker: malformed .debug_str strp target is unterminated")};
    }

    val sid_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, (?ssec.bytes[src_off])::str);
    if (sel sid_r.err) { ret err[fail.Fail].err{fail.refused(sid_r.err)}; }
    val sid: intern.StrId = sid_r.ok;

    val og: opt[*u32] = map.get[intern.StrId, u32](?strm.offs, ?sid);
    if (sel og.none) {
        ret err[fail.Fail].err{fail.message("linker: .debug_str strp target absent from the deduped table")};
    }
    val ded_off: u32 = @og.some;

    if (!debug_str_content_eq(ssec.bytes, ssec.len, src_off, strm.buf.data, strm.buf.len::u32, ded_off)) {
        ret err[fail.Fail].err{fail.message("linker: .debug_str dedup remapped a strp to divergent content")};
    }

    ret apply_one(s, r.kind, dst, patch_off, sec_len, rel.target(ded_off::u64, 0, 0), 0, patch_va,
                  target.name, arch, image_base);
}

fun init_dynstate(dyn: *DynState) {
    dyn.info.libs         = nil;
    dyn.info.lib_count    = 0;
    dyn.info.imports      = nil;
    dyn.info.import_count = 0;
    dyn.info.interp       = intern.STR_NIL;
    dyn.info.base_relocs      = nil;
    dyn.info.base_reloc_count = 0;
    dyn.info.pie              = false;
    dyn.info.import_addr_fixups       = nil;
    dyn.info.import_addr_fixup_count  = 0;
    dyn.fixups            = nil;
    dyn.fixup_count       = 0;
    dyn.fixup_cap         = 0;
    dyn.import_cap        = 0;
    dyn.base_reloc_cap    = 0;
    dyn.import_addr_fixup_cap = 0;
    dyn.active            = false;
}

fun free_dynstate(alloc: *A.Allocator, dyn: *DynState) {
    if (dyn.info.libs != nil && dyn.info.lib_count > 0) {
        A.deallocate[of.DynLib](alloc, dyn.info.libs, dyn.info.lib_count::usize);
    }
    if (dyn.info.imports != nil && dyn.import_cap > 0) {
        A.deallocate[of.DynImport](alloc, dyn.info.imports, dyn.import_cap::usize);
    }
    if (dyn.fixups != nil && dyn.fixup_cap > 0) {
        A.deallocate[of.PltFixup](alloc, dyn.fixups, dyn.fixup_cap::usize);
    }
    if (dyn.info.base_relocs != nil && dyn.base_reloc_cap > 0) {
        A.deallocate[of.BaseReloc](alloc, dyn.info.base_relocs, dyn.base_reloc_cap::usize);
    }
    if (dyn.info.import_addr_fixups != nil && dyn.import_addr_fixup_cap > 0) {
        A.deallocate[of.ImportAddrFixup](alloc, dyn.info.import_addr_fixups,
                                        dyn.import_addr_fixup_cap::usize);
    }
    if (dyn.active) {
        map.dnit[intern.StrId, u32](?dyn.import_map);
    }
    init_dynstate(dyn);
}

fun reloc_source_live(modules: *of.ObjectImage, m: u32, r: *of.Relocation,
                      sec_base: *u32, atoms: *AtomPlan) bool {
    if (atoms == nil || !atoms.active) { ret true; }
    if (of.section_index(r.section) >= modules[m].section_count) { ret true; }
    ret !atom_offset_dead(atoms, sec_base[m] + of.section_index(r.section), r.offset);
}

fun import_symbol_live(modules: *of.ObjectImage, module_count: u32,
                       symbol_name: intern.StrId, sec_base: *u32,
                       atoms: *AtomPlan) bool {
    if (atoms == nil || !atoms.active) { ret true; }
    var saw: bool = false;
    var m: u32 = 0;
    for (m < module_count) {
        var ri: u32 = 0;
        for (ri < modules[m].reloc_count) {
            val r: *of.Relocation = ?modules[m].relocations[ri];
            if (of.reloc_symbol_name(?modules[m], r) == symbol_name) {
                saw = true;
                if (reloc_source_live(modules, m, r, sec_base, atoms)) { ret true; }
            }
            ri = ri + 1;
        }
        m = m + 1;
    }
    ret !saw;
}

fun has_function_branch_reloc(modules: *of.ObjectImage, module_count: u32,
                   symbol_name: intern.StrId, sec_base: *u32,
                   atoms: *AtomPlan) bool {
    var m: u32 = 0;
    for (m < module_count) {
        var ri: u32 = 0;
        for (ri < modules[m].reloc_count) {
            val r: *of.Relocation = ?modules[m].relocations[ri];
            if (of.reloc_symbol_name(?modules[m], r) == symbol_name && is_function_branch_kind(r.kind)
                && reloc_source_live(modules, m, r, sec_base, atoms)) {
                ret true;
            }
            ri = ri + 1;
        }
        m = m + 1;
    }
    ret false;
}

fun build_dynamic_info(s: *session.Session, tgt: *target.Target, dyn: *DynState,
                       modules: *of.ObjectImage, module_count: u32,
                       sym_locs: *map.Map[intern.StrId, SymbolLoc],
                       dynlibs: *of.DynLib, dynlib_count: u32,
                       sec_base: *u32, atoms: *AtomPlan) err[fail.Fail] {
    val alloc: *A.Allocator = s.alloc;

    dyn.info.interp = intern.STR_NIL;
    if (!str_empty(tgt.fs_policy.dynamic_interpreter)) {
        val dr: res[intern.StrId, A.Error] = intern.intern(?s.interner, tgt.fs_policy.dynamic_interpreter);
        if (sel dr.err) { ret err[fail.Fail].err{fail.refused(dr.err)}; }
        dyn.info.interp = dr.ok;
    }

    var implicit: u32 = 0;
    var implicit_soname: intern.StrId = intern.STR_NIL;
    if (dyn.info.pie && !str_empty(tgt.fs_policy.platform_lib)) {
        val pr: res[intern.StrId, A.Error] = intern.intern(?s.interner, tgt.fs_policy.platform_lib);
        if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
        implicit_soname = pr.ok;
        implicit = 1;
    }

    if (implicit == 1 && dynlib_soname_present(dynlibs, dynlib_count, implicit_soname)) {
        implicit = 0;
    }
    var implicit_lib: of.DynLib;
    var implicit_ptr: *of.DynLib = nil::*of.DynLib;
    if (implicit == 1) {
        implicit_lib.name = implicit_soname;
        implicit_lib.soname = implicit_soname;
        implicit_lib.rpath = intern.STR_NIL;
        implicit_ptr = ?implicit_lib;
    }
    var collision_first: intern.StrId = intern.STR_NIL;
    var collision_second: intern.StrId = intern.STR_NIL;
    var collision_identity: intern.StrId = intern.STR_NIL;
    if (dynlib_identity_collision(dynlibs, dynlib_count, implicit_ptr,
                                  ?collision_first, ?collision_second,
                                  ?collision_identity)) {
        ret err[fail.Fail].err{fail.message(dynlib_identity_conflict_message(
            s, collision_identity, collision_first, collision_second))};
    }

    val explicit_libs: u32 = unique_dynlib_count(dynlibs, dynlib_count);
    val declared_libs: u32 =
        declared_library_count(s, modules, module_count, dynlibs, dynlib_count,
                               implicit_ptr, sym_locs, tgt.of.import_address_prefix,
                               sec_base, atoms);
    val attributed_libs_r: res[u32, fail.Fail] =
        attributed_library_count(s, modules, module_count, dynlibs, dynlib_count,
                                 implicit_ptr, sym_locs, tgt.of.import_address_prefix,
                                 sec_base, atoms);
    if (sel attributed_libs_r.err) { ret err[fail.Fail].err{attributed_libs_r.err}; }
    val attributed_libs: u32 = attributed_libs_r.ok;
    val total_libs: u32 = explicit_libs + implicit + declared_libs + attributed_libs;
    if (total_libs > 0) {
        val lr: res[*of.DynLib, A.Error] = A.zallocate[of.DynLib](alloc, total_libs::usize);
        if (sel lr.err) { ret err[fail.Fail].err{fail.refused(lr.err)}; }
        dyn.info.libs = lr.ok;
        var i: u32 = 0;
        var w: u32 = 0;
        for (i < dynlib_count) {
            if (!dynlibs[i].include_referenced
                && !dynlib_soname_seen_before(dynlibs, i, dynlibs[i].soname)) {
                dyn.info.libs[w] = dynlibs[i];
                if (dyn.info.libs[w].rpath == intern.STR_NIL) {
                    var j: u32 = i + 1;
                    for (j < dynlib_count) {
                        if (dynlibs[j].soname == dynlibs[i].soname
                            && dynlibs[j].rpath != intern.STR_NIL) {
                            dyn.info.libs[w].rpath = dynlibs[j].rpath;
                            brk;
                        }
                        j = j + 1;
                    }
                }
                w = w + 1;
            }
            i = i + 1;
        }
        if (implicit == 1) {
            dyn.info.libs[explicit_libs].name   = implicit_soname;
            dyn.info.libs[explicit_libs].soname = implicit_soname;
            dyn.info.libs[explicit_libs].rpath  = intern.STR_NIL;
        }
        var dw: u32 = explicit_libs + implicit;
        var dm: u32 = 0;
        for (dm < module_count) {
            var di: u32 = 0;
            for (di < modules[dm].import_count) {
                val decl: *of.ImportDecl = ?modules[dm].imports[di];
                if (!declared_import_unresolved(decl, sym_locs)
                    || !declared_import_referenced(s, modules, module_count, decl.symbol,
                                                   tgt.of.import_address_prefix, sec_base, atoms)) {
                    di = di + 1; cnt;
                }
                val lib: intern.StrId = modules[dm].imports[di].library;
                if (!dynlib_name_present(dynlibs, dynlib_count, implicit_ptr, lib)
                    && !emitted_lib_present(dyn.info.libs, dw, lib)) {
                    dyn.info.libs[dw].name   = lib;
                    dyn.info.libs[dw].soname = lib;
                    dyn.info.libs[dw].rpath  = intern.STR_NIL;
                    dw = dw + 1;
                }
                di = di + 1;
            }
            dm = dm + 1;
        }
        var atm: u32 = 0;
        for (atm < module_count) {
            var atsy: u32 = 0;
            for (atsy < modules[atm].symbol_count) {
                val cand_r: res[opt[of.DynLib], fail.Fail] = attributed_import_candidate(
                    s, modules, module_count, atm, atsy, tgt.of.import_address_prefix,
                    dynlibs, dynlib_count, implicit_ptr, sym_locs, sec_base, atoms);
                if (sel cand_r.err) {
                    ret err[fail.Fail].err{cand_r.err};
                }
                val cand: opt[of.DynLib] = cand_r.ok;
                if (sel cand.some) {
                    val entry: of.DynLib = cand.some;
                    if (!emitted_lib_present(dyn.info.libs, dw, entry.soname)) {
                        dyn.info.libs[dw].name   = entry.name;
                        dyn.info.libs[dw].soname = entry.soname;
                        dyn.info.libs[dw].rpath  = entry.rpath;
                        dyn.info.libs[dw].include_referenced = false;
                        dw = dw + 1;
                    }
                }
                atsy = atsy + 1;
            }
            atm = atm + 1;
        }
        dyn.info.lib_count = total_libs;
    }

    var am: u32 = 0;
    for (am < module_count) {
        var ai: u32 = 0;
        for (ai < modules[am].import_count) {
            val d: *of.ImportDecl = ?modules[am].imports[ai];
            if (!declared_import_unresolved(d, sym_locs)) {
                ai = ai + 1; cnt;
            }
            val prev: opt[intern.StrId] = session.import_library(s, d.symbol);
            if (sel prev.some) {
                if (!declared_attribution_matches(dynlibs, dynlib_count, implicit_ptr,
                        prev.some, d.library)) {
                    ret err[fail.Fail].err{fail.message(declared_conflict_message(
                        s, d.symbol, prev.some, d.library))};
                }
            }
            ai = ai + 1;
        }
        am = am + 1;
    }

    dyn.import_map = map.init[intern.StrId, u32](alloc, map.hash_u32, map.eq_u32);
    dyn.active = true;

    var seen: map.Map[intern.StrId, u32] =
        map.init[intern.StrId, u32](alloc, map.hash_u32, map.eq_u32);
    var n_imports: u32 = 0;
    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if (!is_undefined_extern(sym)) { sy = sy + 1; cnt; }
            val rr: res[intern.StrId, fail.Fail] = resolved_symbol_name(sym_locs, sym.name);
            if (sel rr.err) {
                map.dnit[intern.StrId, u32](?seen);
                ret err[fail.Fail].err{rr.err};
            }
            val effective: intern.StrId = rr.ok;
            val get_r: opt[*SymbolLoc] = map.get[intern.StrId, SymbolLoc](sym_locs, ?effective);
            if (sel get_r.some) { sy = sy + 1; cnt; }
            if (!import_symbol_live(modules, module_count, sym.name, sec_base, atoms))             { sy = sy + 1; cnt; }
            val cn_r: res[ImportName, fail.Fail] =
                canonical_import_name(s, tgt.of.import_address_prefix, effective);
            if (sel cn_r.err) {
                map.dnit[intern.StrId, u32](?seen);
                ret err[fail.Fail].err{cn_r.err};
            }
            val cn: ImportName = cn_r.ok;
            val get_r2: opt[*u32] = map.get[intern.StrId, u32](?seen, ?cn.canonical);
            if (sel get_r2.some) {
                sy = sy + 1; cnt;
            }
            val ins: res[bool, A.Error] =
                map.insert[intern.StrId, u32](?seen, cn.canonical, n_imports);
            if (sel ins.err) { map.dnit[intern.StrId, u32](?seen); ret err[fail.Fail].err{fail.refused(ins.err)}; }
            n_imports = n_imports + 1;
            sy = sy + 1;
        }
        m = m + 1;
    }
    map.dnit[intern.StrId, u32](?seen);

    if (n_imports == 0) { ret err[fail.Fail].ok{}; }

    val ir: res[*of.DynImport, A.Error] = A.zallocate[of.DynImport](alloc, n_imports::usize);
    if (sel ir.err) { ret err[fail.Fail].err{fail.refused(ir.err)}; }
    dyn.info.imports = ir.ok;
    dyn.import_cap = n_imports;

    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if (!is_undefined_extern(sym)) { sy = sy + 1; cnt; }
            val rr: res[intern.StrId, fail.Fail] = resolved_symbol_name(sym_locs, sym.name);
            if (sel rr.err) {
                ret err[fail.Fail].err{rr.err};
            }
            val effective: intern.StrId = rr.ok;
            val get_r3: opt[*SymbolLoc] = map.get[intern.StrId, SymbolLoc](sym_locs, ?effective);
            if (sel get_r3.some) { sy = sy + 1; cnt; }
            if (!import_symbol_live(modules, module_count, sym.name, sec_base, atoms))             { sy = sy + 1; cnt; }

            val cn_r: res[ImportName, fail.Fail] =
                canonical_import_name(s, tgt.of.import_address_prefix, effective);
            if (sel cn_r.err) {
                ret err[fail.Fail].err{cn_r.err};
            }
            val cn: ImportName = cn_r.ok;
            val existing: opt[*u32] =
                map.get[intern.StrId, u32](?dyn.import_map, ?cn.canonical);
            if (sel existing.some) {
                val existing_idx: u32 = @existing.some;
                val get_r4: opt[*u32] = map.get[intern.StrId, u32](?dyn.import_map, ?sym.name);
                if (sel get_r4.none) {
                    val alias_r: res[bool, A.Error] =
                        map.insert[intern.StrId, u32](?dyn.import_map, sym.name, existing_idx);
                    if (sel alias_r.err) {
                        ret err[fail.Fail].err{fail.refused(alias_r.err)};
                    }
                }
                val get_r5: opt[*u32] = map.get[intern.StrId, u32](?dyn.import_map, ?effective);
                if (sel get_r5.none) {
                    val effective_r: res[bool, A.Error] =
                        map.insert[intern.StrId, u32](?dyn.import_map, effective, existing_idx);
                    if (sel effective_r.err) {
                        ret err[fail.Fail].err{fail.refused(effective_r.err)};
                    }
                }
                if (!cn.indirect
                    && (((sym.flags & of.SYM_OBJ_FLAG_FUNCTION) != 0)
                        || has_function_branch_reloc(modules, module_count, cn.canonical,
                                          sec_base, atoms)
                        || has_function_branch_reloc(modules, module_count, effective,
                                          sec_base, atoms))) {
                    dyn.info.imports[existing_idx].is_func = true;
                }
                sy = sy + 1; cnt;
            }

            val idx: u32 = dyn.info.import_count;
            dyn.info.imports[idx].symbol    = cn.canonical;
            val decl: *of.ImportDecl =
                declared_import_for(modules, module_count, cn.canonical, sym_locs);
            var lib_opt: opt[intern.StrId] = session.import_library(s, cn.canonical);
            if (decl != nil) { lib_opt = opt[intern.StrId].some{decl.library}; }
            if (sel lib_opt.some) {
                val want: intern.StrId = lib_opt.some;
                var li_opt: opt[u32] =
                    dynlib_index_of(dynlibs, dynlib_count, implicit_ptr, want);
                val li_opt_none: bool = sel li_opt.none;
                if (li_opt_none) {
                    li_opt = emitted_lib_index(dyn.info.libs, explicit_libs + implicit,
                                               dyn.info.lib_count, want);
                }
                if (!sel li_opt.some) {
                    ret err[fail.Fail].err{fail.message(pinned_attribution_message(s, cn.canonical, want))};
                }
                dyn.info.imports[idx].lib_index = li_opt.some;
            }
            or (tgt.of.two_level_namespace) {
                ret err[fail.Fail].err{fail.message(unattributed_import_message(
                    s, cn.canonical, tgt.os.c_symbol_prefix, dynlibs, dynlib_count))};
            }
            or {
                dyn.info.imports[idx].lib_index = of.DYNLIB_ANY;
            }
            dyn.info.imports[idx].is_func = !cn.indirect
                && (((sym.flags & of.SYM_OBJ_FLAG_FUNCTION) != 0)
                    || has_function_branch_reloc(modules, module_count, cn.canonical,
                                      sec_base, atoms)
                    || has_function_branch_reloc(modules, module_count, effective,
                                      sec_base, atoms));
            dyn.info.imports[idx].ordinal = 0;
            dyn.info.imports[idx].by_ordinal = false;
            if (decl != nil) {
                dyn.info.imports[idx].symbol = decl.import_name;
                dyn.info.imports[idx].ordinal = decl.ordinal;
                dyn.info.imports[idx].by_ordinal = !decl.by_name;
            }
            if (!str_empty(tgt.of.import_address_prefix)
                && is_import_address_alias(s, dyn.info.imports[idx].symbol,
                                           tgt.of.import_address_prefix)) {
                ret err[fail.Fail].err{fail.message(import_alias_message(
                    s, dyn.info.imports[idx].symbol, tgt.of.import_address_prefix))};
            }
            val ins: res[bool, A.Error] =
                map.insert[intern.StrId, u32](?dyn.import_map, cn.canonical, idx);
            if (sel ins.err) {
                ret err[fail.Fail].err{fail.refused(ins.err)};
            }
            if (sym.name != cn.canonical) {
                val alias_r: res[bool, A.Error] =
                    map.insert[intern.StrId, u32](?dyn.import_map, sym.name, idx);
                if (sel alias_r.err) {
                    ret err[fail.Fail].err{fail.refused(alias_r.err)};
                }
            }
            if (effective != cn.canonical && effective != sym.name) {
                val effective_r: res[bool, A.Error] =
                    map.insert[intern.StrId, u32](?dyn.import_map, effective, idx);
                if (sel effective_r.err) {
                    ret err[fail.Fail].err{fail.refused(effective_r.err)};
                }
            }
            dyn.info.import_count = idx + 1;

            sy = sy + 1;
        }
        m = m + 1;
    }
    ret err[fail.Fail].ok{};
}

fun dynlib_index_of(dynlibs: *of.DynLib, dynlib_count: u32,
                    implicit: *of.DynLib, lib: intern.StrId) opt[u32] {
    var i: u32 = 0;
    for (i < dynlib_count) {
        if (!dynlibs[i].include_referenced
            && (dynlibs[i].name == lib || dynlibs[i].soname == lib)) {
            var index: u32 = 0;
            var j: u32 = 0;
            for (j < dynlib_count) {
                if (!dynlibs[j].include_referenced
                    && !dynlib_soname_seen_before(dynlibs, j, dynlibs[j].soname)) {
                    if (dynlibs[j].soname == dynlibs[i].soname) {
                        ret opt[u32].some{index};
                    }
                    index = index + 1;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    if (implicit != nil && (implicit.name == lib || implicit.soname == lib)) {
        ret opt[u32].some{unique_dynlib_count(dynlibs, dynlib_count)};
    }
    ret opt[u32].none{};
}

fun dynlib_identity_pair(a: *of.DynLib, b: *of.DynLib,
                         identity: *intern.StrId) bool {
    if (a.soname == b.soname) { ret false; }
    if (a.name == b.name || a.name == b.soname) {
        @identity = a.name;
        ret true;
    }
    if (a.soname == b.name) {
        @identity = a.soname;
        ret true;
    }
    ret false;
}

fun dynlib_identity_collision(dynlibs: *of.DynLib, count: u32,
                              implicit: *of.DynLib,
                              first: *intern.StrId, second: *intern.StrId,
                              identity: *intern.StrId) bool {
    var i: u32 = 0;
    for (i < count) {
        var j: u32 = i + 1;
        for (j < count) {
            if (dynlib_identity_pair(?dynlibs[i], ?dynlibs[j], identity)) {
                @first = dynlibs[i].soname;
                @second = dynlibs[j].soname;
                ret true;
            }
            j = j + 1;
        }
        if (implicit != nil && dynlib_identity_pair(?dynlibs[i], implicit, identity)) {
            @first = dynlibs[i].soname;
            @second = implicit.soname;
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun dynlib_identity_conflict_message(s: *session.Session, identity: intern.StrId,
                                     first: intern.StrId, second: intern.StrId) str {
    val n: opt[str] = intern.lookup(?s.interner, identity);
    val a: opt[str] = intern.lookup(?s.interner, first);
    val b: opt[str] = intern.lookup(?s.interner, second);
    if (sel n.none) {
        ret "one link library identity names multiple loader dependencies";
    }
    if (sel a.none) {
        ret "one link library identity names multiple loader dependencies";
    }
    if (sel b.none) {
        ret "one link library identity names multiple loader dependencies";
    }
    val fallback: str = "one link library identity names multiple loader dependencies";
    val head: str = join3(s, "link library identity '", n.some,
        "' names both loader dependencies '", fallback);
    val middle: str = join3(s, head, a.some, "' and '", fallback);
    ret join3(s, middle, b.some, "'", fallback);
}

fun dynlib_soname_seen_before(dynlibs: *of.DynLib, end: u32,
                              soname: intern.StrId) bool {
    var i: u32 = 0;
    for (i < end) {
        if (!dynlibs[i].include_referenced && dynlibs[i].soname == soname) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun dynlib_soname_present(dynlibs: *of.DynLib, count: u32,
                          soname: intern.StrId) bool {
    var i: u32 = 0;
    for (i < count) {
        if (dynlibs[i].soname == soname) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun symbol_strongly_resolved(sym_locs: *map.Map[intern.StrId, SymbolLoc],
                             name: intern.StrId) bool {
    val rr: res[intern.StrId, fail.Fail] = resolved_symbol_name(sym_locs, name);
    if (sel rr.err) { ret false; }
    val effective: intern.StrId = rr.ok;
    val lr: opt[*SymbolLoc] =
        map.get[intern.StrId, SymbolLoc](sym_locs, ?effective);
    if (sel lr.none) { ret false; }
    ret !lr.some.weak;
}

fun declared_import_unresolved(d: *of.ImportDecl,
                               sym_locs: *map.Map[intern.StrId, SymbolLoc]) bool {
    ret !symbol_strongly_resolved(sym_locs, d.symbol);
}

fun has_unresolved_declared_imports(
        modules: *of.ObjectImage, module_count: u32,
        sym_locs: *map.Map[intern.StrId, SymbolLoc]) bool {
    var m: u32 = 0;
    for (m < module_count) {
        var i: u32 = 0;
        for (i < modules[m].import_count) {
            if (declared_import_unresolved(?modules[m].imports[i], sym_locs)) {
                ret true;
            }
            i = i + 1;
        }
        m = m + 1;
    }
    ret false;
}

fun declared_import_for(modules: *of.ObjectImage, module_count: u32,
                        symbol: intern.StrId,
                        sym_locs: *map.Map[intern.StrId, SymbolLoc]) *of.ImportDecl {
    var m: u32 = 0;
    for (m < module_count) {
        var i: u32 = 0;
        for (i < modules[m].import_count) {
            if (modules[m].imports[i].symbol == symbol
                && declared_import_unresolved(?modules[m].imports[i], sym_locs)) {
                ret ?modules[m].imports[i];
            }
            i = i + 1;
        }
        m = m + 1;
    }
    ret nil;
}

fun declared_attribution_matches(dynlibs: *of.DynLib, count: u32,
                                 implicit: *of.DynLib,
                                 attributed: intern.StrId, loader: intern.StrId) bool {
    if (attributed == loader) { ret true; }
    var i: u32 = 0;
    for (i < count) {
        if ((dynlibs[i].name == attributed || dynlibs[i].soname == attributed)
            && dynlibs[i].soname == loader) { ret true; }
        i = i + 1;
    }
    if (implicit != nil
        && (implicit.name == attributed || implicit.soname == attributed)
        && implicit.soname == loader) { ret true; }
    ret false;
}

fun dynlib_name_present(dynlibs: *of.DynLib, count: u32,
                        implicit: *of.DynLib, name: intern.StrId) bool {
    var i: u32 = 0;
    for (i < count) {
        if (!dynlibs[i].include_referenced
            && (dynlibs[i].name == name || dynlibs[i].soname == name)) { ret true; }
        i = i + 1;
    }
    if (implicit != nil && (implicit.name == name || implicit.soname == name)) { ret true; }
    ret false;
}

fun find_referenced_dynlib(dynlibs: *of.DynLib, count: u32, name: intern.StrId) opt[of.DynLib] {
    var i: u32 = 0;
    for (i < count) {
        if (dynlibs[i].include_referenced && dynlibs[i].name == name) {
            ret opt[of.DynLib].some{dynlibs[i]};
        }
        i = i + 1;
    }
    ret opt[of.DynLib].none{};
}

fun emitted_lib_present(libs: *of.DynLib, count: u32, name: intern.StrId) bool {
    var i: u32 = 0;
    for (i < count) {
        if (libs[i].soname == name) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun emitted_lib_index(libs: *of.DynLib, start: u32, count: u32,
                      name: intern.StrId) opt[u32] {
    if (libs == nil) { ret opt[u32].none{}; }
    var i: u32 = start;
    for (i < count) {
        if (libs[i].name == name || libs[i].soname == name) { ret opt[u32].some{i}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

fun declared_library_count(s: *session.Session, modules: *of.ObjectImage, module_count: u32,
                           dynlibs: *of.DynLib, dynlib_count: u32,
                           implicit: *of.DynLib,
                           sym_locs: *map.Map[intern.StrId, SymbolLoc],
                           prefix: str, sec_base: *u32, atoms: *AtomPlan) u32 {
    var n: u32 = 0;
    var m: u32 = 0;
    for (m < module_count) {
        var i: u32 = 0;
        for (i < modules[m].import_count) {
            val d: *of.ImportDecl = ?modules[m].imports[i];
            if (!declared_import_unresolved(d, sym_locs)
                || !declared_import_referenced(s, modules, module_count, d.symbol,
                                               prefix, sec_base, atoms)) {
                i = i + 1; cnt;
            }
            val lib: intern.StrId = modules[m].imports[i].library;
            if (!dynlib_name_present(dynlibs, dynlib_count, implicit, lib)
                && !declared_library_seen_before(
                    s, modules, module_count, m, i, lib, sym_locs, prefix, sec_base, atoms)) {
                n = n + 1;
            }
            i = i + 1;
        }
        m = m + 1;
    }
    ret n;
}

fun declared_library_seen_before(s: *session.Session, modules: *of.ObjectImage, module_count: u32,
                                 upto_m: u32, upto_i: u32, lib: intern.StrId,
                                 sym_locs: *map.Map[intern.StrId, SymbolLoc],
                                 prefix: str, sec_base: *u32, atoms: *AtomPlan) bool {
    var m: u32 = 0;
    for (m <= upto_m && m < module_count) {
        var i: u32 = 0;
        var end: u32 = modules[m].import_count;
        if (m == upto_m) { end = upto_i; }
        for (i < end) {
            val d: *of.ImportDecl = ?modules[m].imports[i];
            if (d.library == lib
                && declared_import_unresolved(d, sym_locs)
                && declared_import_referenced(s, modules, module_count, d.symbol,
                                              prefix, sec_base, atoms)) {
                ret true;
            }
            i = i + 1;
        }
        m = m + 1;
    }
    ret false;
}

fun attributed_import_candidate(s: *session.Session, modules: *of.ObjectImage, module_count: u32,
                                m: u32, sy: u32, prefix: str,
                                dynlibs: *of.DynLib, dynlib_count: u32, implicit: *of.DynLib,
                                sym_locs: *map.Map[intern.StrId, SymbolLoc],
                                sec_base: *u32, atoms: *AtomPlan) res[opt[of.DynLib], fail.Fail] {
    val none: opt[of.DynLib] = opt[of.DynLib].none{};
    val sym: *of.Symbol = ?modules[m].symbols[sy];
    if (!is_undefined_extern(sym)) { ret res[opt[of.DynLib], fail.Fail].ok{none}; }
    val rr: res[intern.StrId, fail.Fail] = resolved_symbol_name(sym_locs, sym.name);
    if (sel rr.err) {
        ret res[opt[of.DynLib], fail.Fail].err{rr.err};
    }
    val effective: intern.StrId = rr.ok;
    val get_r: opt[*SymbolLoc] = map.get[intern.StrId, SymbolLoc](sym_locs, ?effective);
    if (sel get_r.some) {
        ret res[opt[of.DynLib], fail.Fail].ok{none};
    }
    val cn_r: res[ImportName, fail.Fail] = canonical_import_name(s, prefix, effective);
    if (sel cn_r.err) {
        ret res[opt[of.DynLib], fail.Fail].err{cn_r.err};
    }
    val canonical: intern.StrId = cn_r.ok.canonical;
    if (declared_import_for(modules, module_count, canonical, sym_locs) != nil) {
        ret res[opt[of.DynLib], fail.Fail].ok{none};
    }
    val lib_opt: opt[intern.StrId] = session.import_library(s, canonical);
    if (sel lib_opt.none) {
        ret res[opt[of.DynLib], fail.Fail].ok{none};
    }
    val lib: intern.StrId = lib_opt.some;
    if (dynlib_name_present(dynlibs, dynlib_count, implicit, lib)) {
        ret res[opt[of.DynLib], fail.Fail].ok{none};
    }
    val provider: opt[session.LinkProvider] = session.link_provider(s, lib);
    if (sel provider.some
        && provider.some.is_static) {
        ret res[opt[of.DynLib], fail.Fail].ok{none};
    }
    val referenced_entry: opt[of.DynLib] = find_referenced_dynlib(dynlibs, dynlib_count, lib);
    if (!sel referenced_entry.some) {
        ret res[opt[of.DynLib], fail.Fail].ok{none};
    }
    if (!declared_import_referenced(s, modules, module_count, canonical, prefix, sec_base, atoms)) {
        ret res[opt[of.DynLib], fail.Fail].ok{none};
    }
    ret res[opt[of.DynLib], fail.Fail].ok{referenced_entry};
}

fun attributed_library_seen_before(s: *session.Session, modules: *of.ObjectImage, module_count: u32,
                                   upto_m: u32, upto_sy: u32, soname: intern.StrId, prefix: str,
                                   dynlibs: *of.DynLib, dynlib_count: u32, implicit: *of.DynLib,
                                   sym_locs: *map.Map[intern.StrId, SymbolLoc],
                                   sec_base: *u32, atoms: *AtomPlan) res[bool, fail.Fail] {
    var m: u32 = 0;
    for (m <= upto_m && m < module_count) {
        var sy: u32 = 0;
        var end: u32 = modules[m].symbol_count;
        if (m == upto_m) { end = upto_sy; }
        for (sy < end) {
            val cand_r: res[opt[of.DynLib], fail.Fail] = attributed_import_candidate(
                s, modules, module_count, m, sy, prefix, dynlibs, dynlib_count, implicit,
                sym_locs, sec_base, atoms);
            if (sel cand_r.err) {
                ret res[bool, fail.Fail].err{cand_r.err};
            }
            val cand: opt[of.DynLib] = cand_r.ok;
            if (sel cand.some && cand.some.soname == soname) {
                ret res[bool, fail.Fail].ok{true};
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

fun attributed_library_count(s: *session.Session, modules: *of.ObjectImage, module_count: u32,
                             dynlibs: *of.DynLib, dynlib_count: u32, implicit: *of.DynLib,
                             sym_locs: *map.Map[intern.StrId, SymbolLoc], prefix: str,
                             sec_base: *u32, atoms: *AtomPlan) res[u32, fail.Fail] {
    var n: u32 = 0;
    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val cand_r: res[opt[of.DynLib], fail.Fail] = attributed_import_candidate(
                s, modules, module_count, m, sy, prefix, dynlibs, dynlib_count, implicit,
                sym_locs, sec_base, atoms);
            if (sel cand_r.err) {
                ret res[u32, fail.Fail].err{cand_r.err};
            }
            val cand: opt[of.DynLib] = cand_r.ok;
            if (sel cand.some) {
                val soname: intern.StrId = cand.some.soname;
                val seen_r: res[bool, fail.Fail] = attributed_library_seen_before(
                    s, modules, module_count, m, sy, soname, prefix, dynlibs, dynlib_count, implicit,
                    sym_locs, sec_base, atoms);
                if (sel seen_r.err) { ret res[u32, fail.Fail].err{seen_r.err}; }
                if (!seen_r.ok) { n = n + 1; }
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    ret res[u32, fail.Fail].ok{n};
}

fun has_unresolved_attributed_imports(s: *session.Session, modules: *of.ObjectImage,
                                      module_count: u32, dynlibs: *of.DynLib, dynlib_count: u32,
                                      sym_locs: *map.Map[intern.StrId, SymbolLoc], prefix: str,
                                      sec_base: *u32, atoms: *AtomPlan) res[bool, fail.Fail] {
    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val cand_r: res[opt[of.DynLib], fail.Fail] = attributed_import_candidate(
                s, modules, module_count, m, sy, prefix, dynlibs, dynlib_count, nil::*of.DynLib,
                sym_locs, sec_base, atoms);
            if (sel cand_r.err) {
                ret res[bool, fail.Fail].err{cand_r.err};
            }
            val cand: opt[of.DynLib] = cand_r.ok;
            if (sel cand.some) {
                ret res[bool, fail.Fail].ok{true};
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

fun declared_conflict_message(s: *session.Session, sym: intern.StrId,
                              had: intern.StrId, decl: intern.StrId) str {
    val fallback: str = "an import library contradicts an existing library attribution";
    val n: opt[str] = intern.lookup(?s.interner, sym);
    val a: opt[str] = intern.lookup(?s.interner, had);
    val b: opt[str] = intern.lookup(?s.interner, decl);
    if (sel n.none) { ret fallback; }
    if (sel a.none) { ret fallback; }
    if (sel b.none) { ret fallback; }
    val p1: str = join3(s, "import '", n.some, "' is attributed to library '", fallback);
    val p2: str = join3(s, p1, a.some, "' but an import library declares it in '", fallback);
    ret join3(s, p2, b.some, "'", fallback);
}

fun unique_dynlib_count(dynlibs: *of.DynLib, count: u32) u32 {
    var unique: u32 = 0;
    var i: u32 = 0;
    for (i < count) {
        if (!dynlibs[i].include_referenced
            && !dynlib_soname_seen_before(dynlibs, i, dynlibs[i].soname)) {
            unique = unique + 1;
        }
        i = i + 1;
    }
    ret unique;
}

rec ImportName {
    canonical: intern.StrId;
    indirect:  bool;
}

fun canonical_import_name(s: *session.Session, prefix: str,
                          name: intern.StrId) res[ImportName, fail.Fail] {
    var out: ImportName;
    out.canonical = name;
    out.indirect = false;
    if (str_empty(prefix)) { ret res[ImportName, fail.Fail].ok{out}; }

    val text_o: opt[str] = intern.lookup(?s.interner, name);
    if (sel text_o.none) { ret res[ImportName, fail.Fail].ok{out}; }
    val text: str = text_o.some;
    val prefix_len: usize = str_len(prefix);
    if (!str_starts_with(text, prefix) || str_len(text) <= prefix_len) {
        ret res[ImportName, fail.Fail].ok{out};
    }

    val cr: res[intern.StrId, A.Error] = intern.intern(?s.interner, (text::usize + prefix_len)::str);
    if (sel cr.err) {
        ret res[ImportName, fail.Fail].err{fail.refused(cr.err)};
    }
    out.canonical = cr.ok;
    out.indirect = true;
    ret res[ImportName, fail.Fail].ok{out};
}

fun local_import_candidate(s: *session.Session, prefix: str, sym: *of.Symbol,
                           strong: *map.Map[intern.StrId, u32],
                           defined: *map.Map[intern.StrId, u32]) res[ImportName, fail.Fail] {
    var none: ImportName;
    none.canonical = sym.name;
    none.indirect = false;
    if (!is_undefined_extern(sym)
        || (sym.flags & of.SYM_OBJ_FLAG_FALLBACK) != 0) {
        ret res[ImportName, fail.Fail].ok{none};
    }

    val cn_r: res[ImportName, fail.Fail] =
        canonical_import_name(s, prefix, sym.name);
    if (sel cn_r.err) {
        ret res[ImportName, fail.Fail].err{cn_r.err};
    }
    val cn: ImportName = cn_r.ok;
    if (!cn.indirect
        || !map.contains[intern.StrId, u32](strong, ?cn.canonical)
        || map.contains[intern.StrId, u32](defined, ?sym.name)) {
        ret res[ImportName, fail.Fail].ok{none};
    }
    ret res[ImportName, fail.Fail].ok{cn};
}

fun local_import_storage_size(count: u32) res[u32, fail.Fail] {
    if (count > 0x1FFFFFFF) {
        ret res[u32, fail.Fail].err{fail.message("link: local import pointer section exceeds 32 bits")};
    }
    ret res[u32, fail.Fail].ok{count * 8};
}

fun local_import_referenced(modules: *of.ObjectImage, module_count: u32,
                            alias: intern.StrId, sec_base: *u32,
                            atoms: *AtomPlan) bool {
    var m: u32 = 0;
    for (m < module_count) {
        var ri: u32 = 0;
        for (ri < modules[m].reloc_count) {
            val r: *of.Relocation = ?modules[m].relocations[ri];
            if (r.sym < modules[m].symbol_count) {
                val target: *of.Symbol = ?modules[m].symbols[r.sym];
                if (target.name == alias && is_undefined_extern(target)
                    && (target.flags & of.SYM_OBJ_FLAG_FALLBACK) == 0
                    && reloc_source_live(modules, m, r, sec_base, atoms)) {
                    ret true;
                }
            }
            ri = ri + 1;
        }
        m = m + 1;
    }
    ret false;
}

fun relocation_target_is_alias_of(s: *session.Session, target: *of.Symbol,
                                  prefix: str, canonical_text: str) bool {
    if (str_empty(prefix)) { ret false; }
    val target_text_o: opt[str] = intern.lookup(?s.interner, target.name);
    if (sel target_text_o.none) { ret false; }
    val target_text: str = target_text_o.some;
    val prefix_len: usize = str_len(prefix);
    if (!str_starts_with(target_text, prefix) || str_len(target_text) <= prefix_len) {
        ret false;
    }
    ret str_equals((target_text::usize + prefix_len)::str, canonical_text);
}

fun declared_import_referenced(s: *session.Session, modules: *of.ObjectImage,
                               module_count: u32, symbol: intern.StrId,
                               prefix: str, sec_base: *u32,
                               atoms: *AtomPlan) bool {
    if (local_import_referenced(modules, module_count, symbol, sec_base, atoms)) {
        ret true;
    }
    if (str_empty(prefix)) { ret false; }
    val symbol_text_o: opt[str] = intern.lookup(?s.interner, symbol);
    if (sel symbol_text_o.none) { ret false; }
    val symbol_text: str = symbol_text_o.some;
    var m: u32 = 0;
    for (m < module_count) {
        var ri: u32 = 0;
        for (ri < modules[m].reloc_count) {
            val r: *of.Relocation = ?modules[m].relocations[ri];
            if (r.sym < modules[m].symbol_count) {
                val target: *of.Symbol = ?modules[m].symbols[r.sym];
                if (is_undefined_extern(target)
                    && (target.flags & of.SYM_OBJ_FLAG_FALLBACK) == 0
                    && relocation_target_is_alias_of(s, target, prefix, symbol_text)
                    && reloc_source_live(modules, m, r, sec_base, atoms)) {
                    ret true;
                }
            }
            ri = ri + 1;
        }
        m = m + 1;
    }
    ret false;
}

fun synthesize_local_imports(s: *session.Session, prefix: str,
                             modules: *of.ObjectImage, module_count: u32,
                             mode: LinkMode, sec_base: *u32, atoms: *AtomPlan,
                             out: *of.ObjectImage) res[bool, fail.Fail] {
    if (str_empty(prefix) || mode == LINK_RELOCATABLE || modules == nil
        || module_count == 0) {
        ret res[bool, fail.Fail].ok{false};
    }

    val alloc: *A.Allocator = s.alloc;
    var strong: map.Map[intern.StrId, u32] =
        map.init[intern.StrId, u32](alloc, map.hash_u32, map.eq_u32);
    var defined: map.Map[intern.StrId, u32] =
        map.init[intern.StrId, u32](alloc, map.hash_u32, map.eq_u32);

    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if (!of.section_is_external(sym.section)
                && of.section_index(sym.section) < modules[m].section_count
                && (sym.flags & of.SYM_OBJ_FLAG_GLOBAL) != 0
                && is_loadable_kind(modules[m].sections[of.section_index(sym.section)].kind)) {
                val get_r: opt[*u32] = map.get[intern.StrId, u32](?defined, ?sym.name);
                if (sel get_r.none) {
                    val di: res[bool, A.Error] =
                        map.insert[intern.StrId, u32](?defined, sym.name, 0);
                    if (sel di.err) {
                        map.dnit[intern.StrId, u32](?defined);
                        map.dnit[intern.StrId, u32](?strong);
                        ret res[bool, fail.Fail].err{fail.refused(di.err)};
                    }
                }
                if ((sym.flags & of.SYM_OBJ_FLAG_WEAK) == 0
                    && !map.contains[intern.StrId, u32](?strong, ?sym.name)) {
                    val si: res[bool, A.Error] =
                        map.insert[intern.StrId, u32](?strong, sym.name, 0);
                    if (sel si.err) {
                        map.dnit[intern.StrId, u32](?defined);
                        map.dnit[intern.StrId, u32](?strong);
                        ret res[bool, fail.Fail].err{fail.refused(si.err)};
                    }
                }
            }
            sy = sy + 1;
        }
        m = m + 1;
    }

    var seen: map.Map[intern.StrId, u32] =
        map.init[intern.StrId, u32](alloc, map.hash_u32, map.eq_u32);
    var count: u32 = 0;
    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            val cn_r: res[ImportName, fail.Fail] =
                local_import_candidate(s, prefix, sym, ?strong, ?defined);
            if (sel cn_r.err) {
                map.dnit[intern.StrId, u32](?seen);
                map.dnit[intern.StrId, u32](?defined);
                map.dnit[intern.StrId, u32](?strong);
                ret res[bool, fail.Fail].err{cn_r.err};
            }
            val cn: ImportName = cn_r.ok;
            if (cn.indirect
                && local_import_referenced(
                    modules, module_count, sym.name, sec_base, atoms)
                && !map.contains[intern.StrId, u32](?seen, ?sym.name)) {
                if (count == 0x1FFFFFFF) {
                    map.dnit[intern.StrId, u32](?seen);
                    map.dnit[intern.StrId, u32](?defined);
                    map.dnit[intern.StrId, u32](?strong);
                    ret res[bool, fail.Fail].err{fail.message("link: local import pointer section exceeds 32 bits")};
                }
                val ins: res[bool, A.Error] =
                    map.insert[intern.StrId, u32](?seen, sym.name, count);
                if (sel ins.err) {
                    map.dnit[intern.StrId, u32](?seen);
                    map.dnit[intern.StrId, u32](?defined);
                    map.dnit[intern.StrId, u32](?strong);
                    ret res[bool, fail.Fail].err{fail.refused(ins.err)};
                }
                count = count + 1;
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    map.dnit[intern.StrId, u32](?seen);

    if (count == 0) {
        map.dnit[intern.StrId, u32](?defined);
        map.dnit[intern.StrId, u32](?strong);
        ret res[bool, fail.Fail].ok{false};
    }

    val image_name_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "<local-import-pointers>");
    val section_name_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, ".data.rel.ro");
    if (sel image_name_r.err) {
        map.dnit[intern.StrId, u32](?defined);
        map.dnit[intern.StrId, u32](?strong);
        ret res[bool, fail.Fail].err{fail.refused(image_name_r.err)};
    }
    if (sel section_name_r.err) {
        map.dnit[intern.StrId, u32](?defined);
        map.dnit[intern.StrId, u32](?strong);
        ret res[bool, fail.Fail].err{fail.refused(section_name_r.err)};
    }
    val image_r: res[of.ObjectImage, fail.Fail] = obj.image_init(alloc, ?s.interner, image_name_r.ok);
    if (sel image_r.err) {
        map.dnit[intern.StrId, u32](?defined);
        map.dnit[intern.StrId, u32](?strong);
        ret res[bool, fail.Fail].err{image_r.err};
    }
    @out = image_r.ok;

    val size_r: res[u32, fail.Fail] = local_import_storage_size(count);
    if (sel size_r.err) {
        map.dnit[intern.StrId, u32](?defined);
        map.dnit[intern.StrId, u32](?strong);
        ret res[bool, fail.Fail].err{size_r.err};
    }
    val byte_count: u32 = size_r.ok;
    val bytes_r: res[*u8, A.Error] = A.zallocate[u8](alloc, byte_count::usize);
    if (sel bytes_r.err) {
        map.dnit[intern.StrId, u32](?defined);
        map.dnit[intern.StrId, u32](?strong);
        ret res[bool, fail.Fail].err{fail.refused(bytes_r.err)};
    }
    var sec: of.Section;
    sec.name = section_name_r.ok;
    sec.kind = of.SK_RELRO;
    sec.bytes = bytes_r.ok;
    sec.len = byte_count;
    sec.align = 8;
    sec.flags = 0;
    val sec_r: res[u32, fail.Fail] = obj.section_install(out, ?sec);
    if (sel sec_r.err) {
        obj.dnit(out);
        map.dnit[intern.StrId, u32](?defined);
        map.dnit[intern.StrId, u32](?strong);
        ret res[bool, fail.Fail].err{sec_r.err};
    }

    val symbols_r: res[*of.Symbol, A.Error] =
        A.zallocate[of.Symbol](alloc, (count * 2)::usize);
    if (sel symbols_r.err) {
        obj.dnit(out);
        map.dnit[intern.StrId, u32](?defined);
        map.dnit[intern.StrId, u32](?strong);
        ret res[bool, fail.Fail].err{fail.refused(symbols_r.err)};
    }
    out.symbols = symbols_r.ok;
    out.symbol_count = count * 2;
    out.symbol_cap = count * 2;

    val relocs_r: res[*of.Relocation, A.Error] =
        A.zallocate[of.Relocation](alloc, count::usize);
    if (sel relocs_r.err) {
        obj.dnit(out);
        map.dnit[intern.StrId, u32](?defined);
        map.dnit[intern.StrId, u32](?strong);
        ret res[bool, fail.Fail].err{fail.refused(relocs_r.err)};
    }
    out.relocations = relocs_r.ok;
    out.reloc_count = count;
    out.reloc_cap = count;

    seen = map.init[intern.StrId, u32](alloc, map.hash_u32, map.eq_u32);
    var w: u32 = 0;
    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            val cn_r: res[ImportName, fail.Fail] =
                local_import_candidate(s, prefix, sym, ?strong, ?defined);
            if (sel cn_r.err) {
                map.dnit[intern.StrId, u32](?seen);
                obj.dnit(out);
                map.dnit[intern.StrId, u32](?defined);
                map.dnit[intern.StrId, u32](?strong);
                ret res[bool, fail.Fail].err{cn_r.err};
            }
            val cn: ImportName = cn_r.ok;
            if (!cn.indirect
                || !local_import_referenced(
                    modules, module_count, sym.name, sec_base, atoms)
                || map.contains[intern.StrId, u32](?seen, ?sym.name)) {
                sy = sy + 1; cnt;
            }
            val ins: res[bool, A.Error] =
                map.insert[intern.StrId, u32](?seen, sym.name, w);
            if (sel ins.err) {
                map.dnit[intern.StrId, u32](?seen);
                obj.dnit(out);
                map.dnit[intern.StrId, u32](?defined);
                map.dnit[intern.StrId, u32](?strong);
                ret res[bool, fail.Fail].err{fail.refused(ins.err)};
            }

            val alias_ix: u32 = w * 2;
            val target_ix: u32 = alias_ix + 1;
            out.symbols[alias_ix].name = sym.name;
            out.symbols[alias_ix].section = of.section_id(0);
            out.symbols[alias_ix].offset = w * 8;
            out.symbols[alias_ix].size = 8;
            out.symbols[alias_ix].flags = of.SYM_OBJ_FLAG_GLOBAL;
            out.symbols[alias_ix].fallback = of.SYMBOL_NONE;
            out.symbols[alias_ix].align = 8;
            out.symbols[target_ix].name = cn.canonical;
            out.symbols[target_ix].section = of.external_section();
            out.symbols[target_ix].offset = 0;
            out.symbols[target_ix].size = 0;
            out.symbols[target_ix].flags = of.SYM_OBJ_FLAG_GLOBAL;
            out.symbols[target_ix].fallback = of.SYMBOL_NONE;
            out.symbols[target_ix].align = 1;

            out.relocations[w].section = of.section_id(0);
            out.relocations[w].offset = w * 8;
            out.relocations[w].kind = of.RK_ABS64;
            out.relocations[w].sym = target_ix;
            out.relocations[w].addend = 0;
            out.relocations[w].sym2 = of.SYMBOL_NONE;
            w = w + 1;
            sy = sy + 1;
        }
        m = m + 1;
    }
    map.dnit[intern.StrId, u32](?seen);
    map.dnit[intern.StrId, u32](?defined);
    map.dnit[intern.StrId, u32](?strong);
    if (w != count) {
        obj.dnit(out);
        ret res[bool, fail.Fail].err{fail.message("link: local import pointer synthesis changed between passes")};
    }
    val valid: err[fail.Fail] = of.validate_owned_object_or_dnit(out);
    if (sel valid.err) {
        ret res[bool, fail.Fail].err{valid.err};
    }
    ret res[bool, fail.Fail].ok{true};
}

fun is_undefined_extern(sym: *of.Symbol) bool {
    if (!of.section_is_external(sym.section))        { ret false; }
    if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0) { ret false; }
    ret true;
}

fun dynstate_import_index(dyn: *DynState, name: intern.StrId) res[u32, fail.Fail] {
    if (!dyn.active) { ret res[u32, fail.Fail].err{fail.message("not dynamic")}; }
    val g: opt[*u32] = map.get[intern.StrId, u32](?dyn.import_map, ?name);
    if (sel g.none) { ret res[u32, fail.Fail].err{fail.message("not an import")}; }
    ret res[u32, fail.Fail].ok{@g.some};
}

fun dynstate_import_is_func(dyn: *DynState, idx: u32) bool {
    if (idx >= dyn.info.import_count) { ret false; }
    ret dyn.info.imports[idx].is_func;
}

fun is_function_branch_kind(kind: of.RelocKind) bool {
    ret kind == of.RK_PC32 || kind == of.RK_PLT32 || kind == of.RK_JUMP26;
}

fun is_got_kind(kind: of.RelocKind) bool {
    ret kind == of.RK_GOT_PAGE21 || kind == of.RK_GOT_LO12 || kind == of.RK_GOT_PCREL_HI20
        || kind == of.RK_GOTPCREL || kind == of.RK_GOTPCREL_NORELAX
        || kind == of.RK_GOTPCREL64_NORELAX;
}

fun init_local_got_plan(plan: *LocalGotPlan) {
    plan.slots = nil;
    plan.count = 0;
    plan.cap = 0;
}

fun free_local_got_plan(alloc: *A.Allocator, plan: *LocalGotPlan) {
    if (plan.slots != nil && plan.cap > 0) {
        A.deallocate[LocalGotSlot](alloc, plan.slots, plan.cap::usize);
    }
    init_local_got_plan(plan);
}

fun local_got_slot_index(plan: *LocalGotPlan, module: u32, symbol: u32,
                         name: intern.StrId, local: bool) u32 {
    var i: u32 = 0;
    for (i < plan.count) {
        if (plan.slots[i].local == local) {
            if (local && plan.slots[i].module == module && plan.slots[i].symbol == symbol) { ret i; }
            if (!local && plan.slots[i].name == name) { ret i; }
        }
        i = i + 1;
    }
    ret 0xFFFFFFFF;
}

fun local_got_add(s: *session.Session, plan: *LocalGotPlan,
                  module: u32, symbol: u32, name: intern.StrId,
                  local: bool) err[fail.Fail] {
    if (local_got_slot_index(plan, module, symbol, name, local) != 0xFFFFFFFF) {
        ret err[fail.Fail].ok{};
    }
    if (plan.count == plan.cap) {
        if (plan.cap > 0x7FFFFFFF) {
            ret err[fail.Fail].err{fail.message("linker: synthesized GOT slot count overflow")};
        }
        var next: u32 = plan.cap * 2;
        if (next == 0) { next = 8; }
        val gr: res[*LocalGotSlot, A.Error] = A.reallocate[LocalGotSlot](
            s.alloc, plan.slots, plan.cap::usize, next::usize);
        if (sel gr.err) {
            ret err[fail.Fail].err{fail.refused(gr.err)};
        }
        plan.slots = gr.ok;
        plan.cap = next;
    }
    val i: u32 = plan.count;
    plan.slots[i].module = module;
    plan.slots[i].symbol = symbol;
    plan.slots[i].name = name;
    plan.slots[i].offset = 0;
    plan.slots[i].vaddr = 0;
    plan.slots[i].local = local;
    plan.slots[i].initialized = false;
    plan.count = i + 1;
    ret err[fail.Fail].ok{};
}

fun build_local_got_plan(s: *session.Session, arch: *isa.IsaVTable,
                         modules: *of.ObjectImage,
                         module_count: u32, sym_locs: *map.Map[intern.StrId, SymbolLoc],
                         sec_base: *u32, atoms: *AtomPlan,
                         merged: *MergedSection, groups: *SectionGroups,
                         plan: *LocalGotPlan) err[fail.Fail] {
    if (!isa.declares_local_got(arch)) { ret err[fail.Fail].ok{}; }
    val width: u32 = arch.pointer_width;
    if (width != 4 && width != 8) { ret err[fail.Fail].err{fail.message("linker: unsupported GOT pointer width")}; }
    var m: u32 = 0;
    for (m < module_count) {
        var ri: u32 = 0;
        for (ri < modules[m].reloc_count) {
            val r: *of.Relocation = ?modules[m].relocations[ri];
            if (!reloc_source_live(modules, m, r, sec_base, atoms)) { ri = ri + 1; cnt; }
            val resolved: res[of.RelocOperand, fail.Fail] = rel.resolve_operand(arch, ?modules[m], ri);
            if (sel resolved.err) { ret err[fail.Fail].err{resolved.err}; }
            val operand: of.RelocOperand = resolved.ok;
            if (!isa.local_got_kind(arch, operand.target_kind) || operand.sym >= modules[m].symbol_count) {
                ri = ri + 1; cnt;
            }
            val target: *of.Symbol = ?modules[m].symbols[operand.sym];
            if (!of.section_is_external(target.section) && !of.section_is_absolute(target.section)
                && of.section_index(target.section) >= modules[m].section_count) {
                ri = ri + 1; cnt;
            }
            val local: bool = !of.section_is_external(target.section)
                && (target.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0;
            var effective: intern.StrId = target.name;
            if (!local) {
                val rr: res[intern.StrId, fail.Fail] =
                    resolved_symbol_name(sym_locs, target.name);
                if (sel rr.err) {
                    ret err[fail.Fail].err{rr.err};
                }
                effective = rr.ok;
                val get_r: opt[*SymbolLoc] = map.get[intern.StrId, SymbolLoc](sym_locs, ?effective);
                if (sel get_r.none) {
                    ri = ri + 1; cnt;
                }
            }
            val ar: err[fail.Fail] =
                local_got_add(s, plan, m, operand.sym, effective, local);
            if (sel ar.err) {
                ret ar;
            }
            ri = ri + 1;
        }
        m = m + 1;
    }
    if (plan.count == 0) { ret err[fail.Fail].ok{}; }

    val relro: u32 = of.SK_RELRO::u32;
    val start_r: res[u64, fail.Fail] = align_up_u64_checked(merged[relro].len::u64, width::u64);
    if (sel start_r.err) { ret err[fail.Fail].err{start_r.err}; }
    val start: u64 = start_r.ok;
    val end: u64 = start + plan.count::u64 * width::u64;
    if (end > 0xFFFFFFFF) {
        ret err[fail.Fail].err{fail.message("linker: synthesized GOT exceeds the maximum section size")};
    }
    var i: u32 = 0;
    for (i < plan.count) {
        plan.slots[i].offset = (start + i::u64 * width::u64)::u32;
        i = i + 1;
    }
    merged[relro].used = true;
    if (merged[relro].align < width) { merged[relro].align = width; }
    merged[relro].len = end::u32;

    val gn: intern.StrId = intern_or_nil(s, "__got");
    val ga: res[u32, fail.Fail] = section_group_add(s.alloc, groups, relro, gn, 0);
    if (sel ga.err) { ret err[fail.Fail].err{ga.err}; }
    val gi: u32 = ga.ok;
    groups.items[gi].align  = width;
    groups.items[gi].base   = start::u32;
    groups.items[gi].cursor = end::u32;
    groups.items[gi].len    = (end - start)::u32;
    ret err[fail.Fail].ok{};
}

fun finalize_local_got_vaddrs(merged: *MergedSection, plan: *LocalGotPlan) {
    val base: u64 = merged[of.SK_RELRO::u32].vaddr;
    var i: u32 = 0;
    for (i < plan.count) {
        plan.slots[i].vaddr = base + plan.slots[i].offset::u64;
        i = i + 1;
    }
}

fun segment_index_for(out_img: *of.ObjectImage, out_ix: u32) u32 {
    var seg: u32 = 0;
    var i: u32 = 0;
    for (i < out_ix && i < out_img.section_count) {
        if (is_loadable_kind(out_img.sections[i].kind)) { seg = seg + 1; }
        i = i + 1;
    }
    ret seg;
}

fun final_section_location_for(format: *of.OfVTable, image_base: u64,
                               out_img: *of.ObjectImage, out_ix: u32,
                               content_vaddr: u64) of.ExecutableSectionLocation {
    var loc: of.ExecutableSectionLocation;
    loc.vaddr = content_vaddr;
    loc.ordinal = 0;
    if (out_ix >= out_img.section_count || !is_loadable_kind(out_img.sections[out_ix].kind)) {
        ret loc;
    }

    val seg_index: u32 = segment_index_for(out_img, out_ix);
    loc.ordinal = seg_index + 1;
    if (format != nil && format.executable_section_location != nil) {
        ret format.executable_section_location(image_base, content_vaddr, seg_index);
    }
    ret loc;
}

fun dynstate_add_fixup(s: *session.Session, dyn: *DynState, seg_index: u32, seg_offset: u32,
                       import_index: u32, patch_vaddr: u64, addend: i64) err[fail.Fail] {
    val alloc: *A.Allocator = s.alloc;
    if (dyn.fixup_count == dyn.fixup_cap) {
        val grown: err[fail.Fail] = grow_cap[of.PltFixup](alloc, ?dyn.fixups, ?dyn.fixup_cap, 4);
        if (sel grown.err) { ret grown; }
    }
    val ix: u32 = dyn.fixup_count;
    dyn.fixups[ix].seg_index    = seg_index;
    dyn.fixups[ix].seg_offset   = seg_offset;
    dyn.fixups[ix].import_index = import_index;
    dyn.fixups[ix].patch_vaddr  = patch_vaddr;
    dyn.fixups[ix].addend       = addend;
    dyn.fixup_count = ix + 1;
    ret err[fail.Fail].ok{};
}

fun dynstate_add_import_addr_fixup(s: *session.Session, dyn: *DynState,
                                   seg_index: u32, seg_offset: u32,
                                   import_index: u32, patch_vaddr: u64,
                                   kind: of.RelocKind, addend: i64) err[fail.Fail] {
    val alloc: *A.Allocator = s.alloc;
    if (dyn.info.import_addr_fixup_count == dyn.import_addr_fixup_cap) {
        val grown: err[fail.Fail] =
            grow_cap[of.ImportAddrFixup](alloc, ?dyn.info.import_addr_fixups, ?dyn.import_addr_fixup_cap, 4);
        if (sel grown.err) { ret grown; }
    }
    val ix: u32 = dyn.info.import_addr_fixup_count;
    dyn.info.import_addr_fixups[ix].seg_index    = seg_index;
    dyn.info.import_addr_fixups[ix].seg_offset   = seg_offset;
    dyn.info.import_addr_fixups[ix].import_index = import_index;
    dyn.info.import_addr_fixups[ix].patch_vaddr  = patch_vaddr;
    dyn.info.import_addr_fixups[ix].kind         = kind;
    dyn.info.import_addr_fixups[ix].addend       = addend;
    dyn.info.import_addr_fixup_count = ix + 1;
    ret err[fail.Fail].ok{};
}

fun dynstate_add_base_reloc(s: *session.Session, dyn: *DynState, seg_index: u32,
                            seg_offset: u32, target: u64) err[fail.Fail] {
    val alloc: *A.Allocator = s.alloc;
    if (dyn.info.base_reloc_count == dyn.base_reloc_cap) {
        val grown: err[fail.Fail] =
            grow_cap[of.BaseReloc](alloc, ?dyn.info.base_relocs, ?dyn.base_reloc_cap, 8);
        if (sel grown.err) { ret grown; }
    }
    val ix: u32 = dyn.info.base_reloc_count;
    dyn.info.base_relocs[ix].seg_index  = seg_index;
    dyn.info.base_relocs[ix].seg_offset = seg_offset;
    dyn.info.base_relocs[ix].target     = target;
    dyn.info.base_reloc_count = ix + 1;
    ret err[fail.Fail].ok{};
}

fun apply_one(s: *session.Session, kind: of.RelocKind,
             dst: *u8, patch_off: u32, sec_len: u32,
             target: rel.RelocTarget, addend: i64, patch_va: u64,
             sym_name: intern.StrId, arch: *isa.IsaVTable,
             image_base: u64) err[fail.Fail] {
    if (!isa.emits_relocations(arch)) {
        ret err[fail.Fail].err{fail.message(unsupported_message(s, arch, kind))};
    }
    val r: res[bool, rel.RelocError] =
        arch.reloc.apply(kind, dst, patch_off, sec_len,
                         target, addend, patch_va, image_base);
    if (!sel r.err) { ret err[fail.Fail].ok{}; }
    val error: rel.RelocError = r.err;
    if (error == rel.RELOC_OVERFLOW) {
        ret err[fail.Fail].err{fail.message(overflow_message(s, kind, sym_name))};
    }
    if (error == rel.RELOC_INVALID_INSTRUCTION) {
        ret err[fail.Fail].err{fail.message(invalid_relocation_instruction_message(s, kind))};
    }
    ret err[fail.Fail].err{fail.message(unsupported_message(s, arch, kind))};
}

fun intern_or_nil(s: *session.Session, name: str) intern.StrId {
    val r: res[intern.StrId, A.Error] = intern.intern(?s.interner, name);
    if (sel r.err) { ret intern.STR_NIL; }
    ret r.ok;
}

fun merged_section_name(s: *session.Session, kind: of.SectionKind) intern.StrId {
    if (kind == of.SK_TEXT)   { ret intern_or_nil(s, ".text"); }
    if (kind == of.SK_RODATA) { ret intern_or_nil(s, ".rodata"); }
    if (kind == of.SK_RELRO)  { ret intern_or_nil(s, ".data.rel.ro"); }
    if (kind == of.SK_DATA)   { ret intern_or_nil(s, ".data"); }
    if (kind == of.SK_BSS)    { ret intern_or_nil(s, ".bss"); }
    if (kind == of.SK_DEBUG)  { ret intern_or_nil(s, ".debug"); }
    ret intern_or_nil(s, ".exception");
}

fun image_name(modules: *of.ObjectImage, module_count: u32) intern.StrId {
    if (module_count == 0) { ret intern.STR_NIL; }
    ret modules[0].name;
}

fun header_reserve_page(tgt: *target.Target) bool {
    if (tgt.of == nil) { ret false; }
    ret tgt.of.header_in_first_segment;
}

fun header_reserve_bytes(tgt: *target.Target, pie: bool, shape: *of.HeaderShape) u64 {
    if (!pie && !header_reserve_page(tgt)) { ret 0; }
    val page: u64 = os_page_size(tgt);
    if (tgt.of == nil || tgt.of.header_span == nil || shape == nil) { ret page; }
    val want: u64 = tgt.of.header_span(shape, page);
    if (want <= page) { ret page; }
    val rounded: res[u64, fail.Fail] = align_up_u64_checked(want, page);
    if (sel rounded.err) { ret page; }
    ret rounded.ok;
}

fun measure_header_shape(s: *session.Session, out_img: *of.ObjectImage, merged: *MergedSection,
                         groups: *SectionGroups, dyn: *DynState, pie: bool,
                         shape: *of.HeaderShape) {
    shape.itn       = ?s.interner;
    shape.libs      = dyn.info.libs;
    shape.lib_count = dyn.info.lib_count;
    shape.pie       = pie;
    shape.imports   = dyn.info.import_count > 0;

    var segs:  u32 = 0;
    var sects: u32 = 0;
    var k:     u32 = 0;
    for (k < MERGED_KIND_COUNT) {
        if (is_loadable_kind(merged[k].kind) && merged[k].used && merged[k].len > 0) {
            segs = segs + 1;
            var i: u32 = 0;
            for (i < groups.count) {
                if (groups.items[i].slot == k && groups.items[i].len > 0) { sects = sects + 1; }
                i = i + 1;
            }
        }
        k = k + 1;
    }

    var dbg: u32 = 0;
    var d:   u32 = 0;
    for (d < out_img.section_count) {
        if (out_img.sections[d].kind == of.SK_DEBUG) { dbg = dbg + 1; }
        d = d + 1;
    }

    shape.seg_count   = segs;
    shape.sect_count  = sects;
    shape.debug_count = dbg;
}

fun os_base_addr(tgt: *target.Target) u64 {
    if (tgt.base != 0) { ret tgt.base; }
    ret tgt.os.base_addr;
}

fun target_requires_pie(tgt: *target.Target) bool {
    if (tgt.os == nil || tgt.os.pie_exec == nil) { ret false; }
    ret tgt.os.pie_exec(tgt.isa.id);
}

fun loaderless_request_message(s: *session.Session, tgt: *target.Target, mode: LinkMode,
                               pie: bool, dynamic: bool) str {
    if (tgt.os.mapped_by_loader) { ret ""; }
    if (pie) {
        ret loader_missing_message(s, tgt.os.name,
            "a position-independent executable needs a loader to relocate it");
    }
    if (mode == LINK_SHARED) {
        ret loader_missing_message(s, tgt.os.name,
            "a shared library needs a loader to map it");
    }
    if (dynamic) {
        ret loader_missing_message(s, tgt.os.name,
            "a dynamically-linked executable needs a loader to resolve it");
    }
    ret "";
}

fun loader_missing_message(s: *session.Session, os_name: str, need: str) str {
    val head: str = join3(s, "link: ", need, ", and os = \"",
                          "link: this image needs a loader and the target os has none");
    ret join3(s, head, os_name, "\" has none", head);
}

fun os_page_size(tgt: *target.Target) u64 {
    ret tgt.page_size;
}

# a catalog member an input object carries that its catalog does not declare:
# malformed input, named with the object it came from
fun malformed_input_member(s: *session.Session, catalog: str, tag: u32, object_name: intern.StrId) str {
    var where: str = "";
    val nm: opt[str] = intern.lookup(?s.interner, object_name);
    if (sel nm.some) { where = nm.some; }
    ret fail.catalog_message(?s.interner, s.alloc, fail.malformed_member_in(catalog, tag, where));
}

fun named_message(s: *session.Session, prefix: str, name_id: intern.StrId, suffix: str, fallback: str) str {
    val nm: opt[str] = intern.lookup(?s.interner, name_id);
    if (sel nm.some) { ret join3(s, prefix, nm.some, suffix, fallback); }
    ret fallback;
}

fun oor_section_message(s: *session.Session, sym_name: intern.StrId, obj_name: intern.StrId) str {
    val sn: opt[str] = intern.lookup(?s.interner, sym_name);
    val on: opt[str] = intern.lookup(?s.interner, obj_name);
    if (sel sn.some) {
        if (sel on.some) {
            val pre: str = join3(s, "linker: symbol '", sn.some, "' in object '", "linker: symbol names an out-of-range section");
            ret join3(s, pre, on.some, "' names an out-of-range section", "linker: symbol names an out-of-range section");
    }
    }
    if (sel sn.some) { ret join3(s, "linker: symbol '", sn.some, "' names an out-of-range section", "linker: symbol names an out-of-range section"); }
    ret "linker: symbol names an out-of-range section";
}

fun dup_message(s: *session.Session, name: intern.StrId) str {
    val nm: opt[str] = intern.lookup(?s.interner, name);
    if (sel nm.some) { ret join3(s, "multiple definition of '", nm.some, "'", "multiple definition of symbol"); }
    ret "multiple definition of symbol";
}

fun dwarf_addend_message(s: *session.Session, modules: *of.ObjectImage, m: u32,
                         name: intern.StrId, r: *of.Relocation) str {
    val fallback: str =
        "linker: DWARF code-address addend does not survive dead-code elimination";
    val nm: opt[str] = intern.lookup(?s.interner, name);
    if (sel nm.none) { ret fallback; }
    var sec: str = "?";
    if (of.section_index(r.section) < modules[m].section_count) {
        val sn: opt[str] = intern.lookup(?s.interner, modules[m].sections[of.section_index(r.section)].name);
        if (sel sn.some) { sec = sn.some; }
    }
    val result: res[str, format.FormatError] = format.sprint(s.alloc,
        "linker: {} relocation against '{}' with addend {} crosses a discarded body; its address would be stale",
        sec, nm.some, r.addend);
    if (sel result.err) { ret fallback; }
    ret result.ok;
}

fun undef_message(s: *session.Session, name: intern.StrId) str {
    val pinned: opt[intern.StrId] = session.import_library(s, name);
    if (sel pinned.some) {
        ret pinned_attribution_message(s, name, pinned.some);
    }
    val nm: opt[str] = intern.lookup(?s.interner, name);
    if (sel nm.some) { ret join2(s, "undefined symbol: ", nm.some, "undefined symbol"); }
    ret "undefined symbol";
}

fun pinned_attribution_message(s: *session.Session, sym_name: intern.StrId,
                               lib: intern.StrId) str {
    val provider: opt[session.LinkProvider] = session.link_provider(s, lib);
    if (sel provider.some
        && provider.some.is_static) {
        ret static_provider_message(s, sym_name, lib);
    }
    ret pinned_lib_message(s, sym_name, lib);
}

fun static_provider_message(s: *session.Session, sym_name: intern.StrId,
                            lib: intern.StrId) str {
    val fallback: str =
        "import pinned to a library this link provides as a static input, which defines symbols rather than importing them; the symbol is undefined";
    val sno: opt[str] = intern.lookup(?s.interner, sym_name);
    val lno: opt[str] = intern.lookup(?s.interner, lib);
    if (sel sno.none) { ret fallback; }
    if (sel lno.none) { ret fallback; }
    val pre: str = join3(s, "import '", sno.some, "' is pinned to library '", fallback);
    val mid: str = join3(s, pre, lno.some,
        "', which this link provides as a static input", fallback);
    ret join2(s, mid,
        ". a static input defines symbols rather than importing them, so nothing binds the import: the symbol is not defined by any object or archive in the link. check the declaration's spelling against the library's own symbols, or that the archive was built with it",
        fallback);
}

fun pinned_lib_message(s: *session.Session, sym_name: intern.StrId, lib: intern.StrId) str {
    val fallback: str = "import pinned to a library not among the link's dependencies";
    val sno: opt[str] = intern.lookup(?s.interner, sym_name);
    val lno: opt[str] = intern.lookup(?s.interner, lib);
    if (sel sno.none) { ret fallback; }
    if (sel lno.none) { ret fallback; }
    val pre: str = join3(s, "import '", sno.some, "' pinned to library '", fallback);
    val head: str = join3(s, pre, lno.some,
        "' not among the link's dependencies", fallback);
    val provided: str = join_link_providers(s);
    if (str_len(provided) == 0) { ret head; }
    val sep: str = join2(s, head, "; this link provides: ", head);
    ret join2(s, sep, provided, sep);
}

fun join_link_providers(s: *session.Session) str {
    val provs: *session.LinkProvider = session.link_providers(s);
    val n: u32 = session.link_provider_count(s);
    var acc: str = "";
    var i: u32 = 0;
    for (i < n) {
        val nm: opt[str] = intern.lookup(?s.interner, provs[i].name);
        if (sel nm.none) { i = i + 1; cnt; }
        var piece: str = nm.some;
        if (provs[i].is_static) { piece = join2(s, piece, " (static)", piece); }
        if (str_len(acc) == 0) { acc = piece; }
        or {
            val sep: str = join2(s, acc, ", ", acc);
            acc = join2(s, sep, piece, sep);
        }
        i = i + 1;
    }
    ret acc;
}

fun unattributed_import_message(s: *session.Session, sym_name: intern.StrId,
                                c_symbol_prefix: str,
                                dynlibs: *of.DynLib, dynlib_count: u32) str {
    val sno: opt[str] = intern.lookup(?s.interner, sym_name);
    if (sel sno.none) {
        ret "dynamic import has no #[library] attribution; a two-level-namespace target requires every import to name its providing library - annotate the declaration with #[library(\"...\")], or, when the symbol arrives from a static archive member and has no declaration to annotate, claim it with symbols = [...] on the [link.<entry>] naming its library";
    }
    val name: str = sno.some;
    val head: str = join3(s, "dynamic import '", name,
        "' has no #[library] attribution; a two-level-namespace target requires every import to name its providing library - annotate the declaration with #[library(\"...\")]",
        "dynamic import has no #[library] attribution");
    val claim_pre: str = join2(s,
        head,
        ", or, when the symbol arrives from a static archive member and has no declaration to annotate, claim it with symbols = [\"",
        head);
    val claim: str = join3(s, claim_pre, source_spelling(name, c_symbol_prefix),
        "\"] on the [link.<entry>] naming its library", claim_pre);
    val cands: str = join_dynlibs(s, dynlibs, dynlib_count);
    if (str_len(cands) == 0) { ret claim; }
    val pre: str = join2(s, claim, "; candidate libraries: ", claim);
    ret join2(s, pre, cands, pre);
}

fun source_spelling(name: str, prefix: str) str {
    if (str_empty(prefix) || !str_starts_with(name, prefix)
        || str_len(name) <= str_len(prefix)) {
        ret name;
    }
    ret (name::usize + str_len(prefix))::str;
}

fun is_import_address_alias(s: *session.Session, name: intern.StrId, prefix: str) bool {
    val no: opt[str] = intern.lookup(?s.interner, name);
    if (sel no.none) { ret false; }
    val text: str = no.some;
    ret str_starts_with(text, prefix) && str_len(text) > str_len(prefix);
}

fun import_alias_message(s: *session.Session, name: intern.StrId, prefix: str) str {
    val no: opt[str] = intern.lookup(?s.interner, name);
    if (sel no.none) {
        ret "dynamic import names an import-address alias rather than an export; import the undecorated export instead";
    }
    val text: str = no.some;
    val export: str = (text::usize + str_len(prefix))::str;

    val head: str = join3(s, "dynamic import '", text, "' names the import-address alias of '",
                          "dynamic import names an import-address alias");
    val a: str = join3(s, head, export, "' rather than an export: '", head);
    val b: str = join3(s, a, prefix,
        "' is the convention for the address cell the import table itself synthesizes, so no library exports a symbol under that name and the image would fail to load. import '",
        a);
    ret join3(s, b, export,
        "' instead - the linker emits that import and resolves every alias reference to its address cell", b);
}

fun join_dynlibs(s: *session.Session, dynlibs: *of.DynLib, dynlib_count: u32) str {
    var acc: str = "";
    var i: u32 = 0;
    for (i < dynlib_count) {
        val nm: opt[str] = intern.lookup(?s.interner, dynlibs[i].name);
        if (sel nm.none) { i = i + 1; cnt; }
        var piece: str = nm.some;
        if (dynlibs[i].soname != dynlibs[i].name) {
            val so: opt[str] = intern.lookup(?s.interner, dynlibs[i].soname);
            if (sel so.some) {
                val pre: str = join2(s, piece, " (", piece);
                piece = join2(s, pre, so.some, pre);
                piece = join2(s, piece, ")", piece);
            }
        }
        if (str_len(acc) == 0) { acc = piece; }
        or {
            val sep: str = join2(s, acc, ", ", acc);
            acc = join2(s, sep, piece, sep);
        }
        i = i + 1;
    }
    ret acc;
}

fun overflow_message(s: *session.Session, kind: of.RelocKind, sym_name: intern.StrId) str {
    val named: opt[str] = of.reloc_kind_name(kind);
    if (sel named.none) { ret of.reloc_kind_rejection(?s.interner, s.alloc, kind, ""); }
    val kn: str = named.some;
    val sno: opt[str] = intern.lookup(?s.interner, sym_name);
    if (sel sno.some) {
        val pre: str = join3(s, "relocation '", kn, "' to '", "relocation overflows");
        ret join3(s, pre, sno.some, "' overflows", "relocation overflows");
    }
    ret join3(s, "relocation '", kn, "' overflows", "relocation overflows");
}

# a declared relocation kind the instruction set does not honor, or a member
# outside the catalog; `arch` may be absent when no relocation seam exists
fun unsupported_message(s: *session.Session, arch: *isa.IsaVTable, kind: of.RelocKind) str {
    var by: str = "";
    if (arch != nil) { by = arch.name; }
    ret of.reloc_kind_rejection(?s.interner, s.alloc, kind, by);
}

fun invalid_relocation_instruction_message(s: *session.Session, kind: of.RelocKind) str {
    val named: opt[str] = of.reloc_kind_name(kind);
    if (sel named.none) { ret of.reloc_kind_rejection(?s.interner, s.alloc, kind, ""); }
    ret join3(s, "relocation '", named.some,
                 "' does not match its instruction", "relocation does not match its instruction");
}

fun float_abi_phrase(tgt: *target.Target, abi_bits: u32) str {
    if (abi_bits == isa.machine_flags(tgt.isa, 0, false))  { ret "soft-float"; }
    if (abi_bits == isa.machine_flags(tgt.isa, 32, false)) { ret "single-precision hard-float"; }
    if (abi_bits == isa.machine_flags(tgt.isa, 64, false)) { ret "double-precision hard-float"; }
    ret "an unrecognized float";
}

fun module_display_name(s: *session.Session, img: *of.ObjectImage) str {
    val nm: opt[str] = intern.lookup(?s.interner, img.name);
    if (sel nm.some) { ret nm.some; }
    ret "<input>";
}

fun machine_flags_mismatch_message(s: *session.Session, tgt: *target.Target,
                                   img: *of.ObjectImage, got: u32, expected: u32) str {
    val tail: str = join3(s, " ABI, but this link targets '", tgt.abi.name,
                          "', so every float argument crossing that boundary would read back as garbage",
                          " ABI the target does not use");
    val head: str = join3(s, "object '", module_display_name(s, img), "' was built for a ",
                          "an input object was built for a ");
    ret join3(s, head, float_abi_phrase(tgt, got), tail,
              "input object float ABI does not match the target convention");
}

fun entry_message(s: *session.Session, name: intern.StrId) str {
    val nm: opt[str] = intern.lookup(?s.interner, name);
    if (sel nm.some) { ret join3(s, "undefined entry symbol '", nm.some, "'; ensure the target startup library is linked", "undefined entry symbol; ensure the target startup library is linked"); }
    ret "undefined entry symbol; ensure the target startup library is linked";
}

fun read_message(s: *session.Session, path: str, reason: str) str {
    val pre: str = join3(s, "cannot read object '", path, "': ", "cannot read object");
    ret join2(s, pre, reason, pre);
}

fun join2(s: *session.Session, a: str, b: str, prefix: str) str {
    val la: usize = str_len(a);
    val lb: usize = str_len(b);
    val total: usize = la + lb;

    val r: res[*u8, A.Error] = A.allocate[u8](s.alloc, total + 1);
    if (sel r.err) { ret prefix; }
    val buf: *u8 = r.ok;

    copy_bytes(buf, 0, a, la);
    copy_bytes(buf, la, b, lb);
    buf[total] = 0;

    val ir: res[intern.StrId, A.Error] = intern.intern(?s.interner, buf::str);
    A.deallocate[u8](s.alloc, buf, total + 1);
    if (sel ir.err) { ret prefix; }

    val nm: opt[str] = intern.lookup(?s.interner, ir.ok);
    if (sel nm.some) { ret nm.some; }
    ret prefix;
}

fun join3(s: *session.Session, a: str, b: str, c: str, prefix: str) str {
    val la: usize = str_len(a);
    val lb: usize = str_len(b);
    val lc: usize = str_len(c);
    val total: usize = la + lb + lc;

    val r: res[*u8, A.Error] = A.allocate[u8](s.alloc, total + 1);
    if (sel r.err) { ret prefix; }
    val buf: *u8 = r.ok;

    copy_bytes(buf, 0, a, la);
    copy_bytes(buf, la, b, lb);
    copy_bytes(buf, la + lb, c, lc);
    buf[total] = 0;

    val ir: res[intern.StrId, A.Error] = intern.intern(?s.interner, buf::str);
    A.deallocate[u8](s.alloc, buf, total + 1);
    if (sel ir.err) { ret prefix; }

    val nm: opt[str] = intern.lookup(?s.interner, ir.ok);
    if (sel nm.some) { ret nm.some; }
    ret prefix;
}

fun copy_bytes(dst: *u8, at: usize, src: str, len: usize) {
    memory.raw_copy((dst::usize + at)::ptr, src::ptr, len);
}

fun free_placements(alloc: *A.Allocator, placements: *Placement, sec_total: u32) {
    if (placements != nil && sec_total > 0) {
        A.deallocate[Placement](alloc, placements, sec_total::usize);
    }
}

fun free_scratch(alloc: *A.Allocator, placements: *Placement, sec_total: u32,
                sec_base: *u32, module_count: u32,
                merged: *MergedSection, merged_count: u32,
                debug_names: *intern.StrId, debug_count: u32,
                merged_to_out: *u32, sym_base: *u32, sym_out: *u32, sym_total: u32,
                strm: *StrMerge, atoms: *AtomPlan, groups: *SectionGroups) {
    free_section_groups(alloc, groups);
    free_placements(alloc, placements, sec_total);
    if (sec_base != nil && module_count > 0) {
        A.deallocate[u32](alloc, sec_base, module_count::usize);
    }
    if (sym_base != nil && module_count > 0) {
        A.deallocate[u32](alloc, sym_base, module_count::usize);
    }
    if (sym_out != nil && sym_total > 0) {
        A.deallocate[u32](alloc, sym_out, sym_total::usize);
    }
    if (merged != nil && merged_count > 0) {
        A.deallocate[MergedSection](alloc, merged, merged_count::usize);
    }
    if (debug_names != nil && debug_count > 0) {
        A.deallocate[intern.StrId](alloc, debug_names, debug_count::usize);
    }
    if (merged_to_out != nil && merged_count > 0) {
        A.deallocate[u32](alloc, merged_to_out, merged_count::usize);
    }
    free_str_merge(strm);
    free_atom_plan(alloc, atoms);
}

fun free_modules(alloc: *A.Allocator, modules: *of.ObjectImage, module_count: u32) {
    free_modules_to(alloc, modules, module_count, module_count);
}

fun free_modules_to(alloc: *A.Allocator, modules: *of.ObjectImage, n: u32, cap: u32) {
    if (modules == nil) { ret; }
    var i: u32 = 0;
    for (i < n) {
        obj.dnit(?modules[i]);
        i = i + 1;
    }
    if (cap > 0) {
        A.deallocate[of.ObjectImage](alloc, modules, cap::usize);
    }
}

fun lt_link(s: *session.Session, name: intern.StrId, a: *of.Symbol, b: *of.Symbol) res[u64, fail.Fail] {
    var placements: [2]Placement;
    placements[0].vaddr = 0x1000; placements[0].offset = 0; placements[0].merged_index = 0;
    placements[1].vaddr = 0x2000; placements[1].offset = 0; placements[1].merged_index = 0;
    var sec_base: [2]u32;
    sec_base[0] = 0; sec_base[1] = 1;

    var mods: [2]of.ObjectImage;
    mods[0].alloc = s.alloc; mods[0].symbols = a; mods[0].symbol_count = 1;
    mods[0].sections = nil; mods[0].section_count = 1; mods[0].relocations = nil; mods[0].reloc_count = 0;
    mods[1].alloc = s.alloc; mods[1].symbols = b; mods[1].symbol_count = 1;
    mods[1].sections = nil; mods[1].section_count = 1; mods[1].relocations = nil; mods[1].reloc_count = 0;

    var locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](s.alloc, map.hash_u32, map.eq_u32);
    val cr: err[fail.Fail] =
        collect_symbols(s, ?mods[0], 2, ?placements[0], ?sec_base[0],
                        ?locs, true, nil::*AtomPlan);
    if (sel cr.err) {
        map.dnit[intern.StrId, SymbolLoc](?locs);
        ret res[u64, fail.Fail].err{cr.err};
    }
    val g: opt[*SymbolLoc] = map.get[intern.StrId, SymbolLoc](?locs, ?name);
    if (sel g.none) {
        map.dnit[intern.StrId, SymbolLoc](?locs);
        ret res[u64, fail.Fail].err{fail.message("missing")};
    }
    val v: u64 = g.some.vaddr;
    map.dnit[intern.StrId, SymbolLoc](?locs);
    ret res[u64, fail.Fail].ok{v};
}

fun lt_name(s: *session.Session, name: str) intern.StrId {
    val r: res[intern.StrId, A.Error] = intern.intern(?s.interner, name);
    if (sel r.err) { ret intern.STR_NIL; }
    ret r.ok;
}

test "mach.lang.be.linker.contribution_overlap:two_claims_on_one_range_are_named" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val text_name: intern.StrId = lt_name(?s, ".text");
    var left_bytes: [8]u8;
    var right_bytes: [8]u8;
    var sections: [2]of.Section;
    sections[0].name = text_name; sections[0].kind = of.SK_TEXT;
    sections[0].bytes = ?left_bytes[0];  sections[0].len = 8;
    sections[0].align = 1; sections[0].flags = 0;
    sections[1].name = text_name; sections[1].kind = of.SK_TEXT;
    sections[1].bytes = ?right_bytes[0]; sections[1].len = 8;
    sections[1].align = 1; sections[1].flags = 0;

    var modules: [2]of.ObjectImage;
    modules[0] = lt_image(?s, lt_name(?s, "left.o"), ?sections[0], 1,
                          nil::*of.Symbol, 0, nil::*of.Relocation, 0);
    modules[1] = lt_image(?s, lt_name(?s, "right.o"), ?sections[1], 1,
                          nil::*of.Symbol, 0, nil::*of.Relocation, 0);

    val merged_count_r: res[u32, fail.Fail] = merged_section_count(0);
    if (sel merged_count_r.err) { ret 2; }
    val merged_count: u32 = merged_count_r.ok;
    val merged_r: res[*MergedSection, A.Error] =
        A.zallocate[MergedSection](?alloc, merged_count::usize);
    if (sel merged_r.err) { ret 3; }
    val merged: *MergedSection = merged_r.ok;
    init_merged(merged, nil::*intern.StrId, 0);

    var placements: [2]Placement;
    var sec_base: [2]u32;
    var strm: StrMerge;
    strm.buf = enc.buf_init(?alloc);
    strm.offs = map.init[intern.StrId, u32](?alloc, map.hash_u32, map.eq_u32);
    strm.name = intern.STR_NIL;
    strm.active = false;
    var atoms: AtomPlan;
    init_atom_plan(?atoms);
    var groups: SectionGroups;
    init_section_groups(?groups);

    val acc: err[fail.Fail] = accumulate_sections(
        ?s, ?modules[0], 2, merged, nil::*intern.StrId, 0,
        ?placements[0], ?sec_base[0], ?strm, ?atoms, ?groups);
    var bad: i32 = 0;
    if (sel acc.err)       { bad = 4; }
    or (placements[0].extent != 8)      { bad = 5; }
    or (placements[1].extent != 8)      { bad = 6; }
    or (placements[1].offset != 8)      { bad = 7; }
    if (bad != 0) { ret bad; }

    val clean: err[fail.Fail] = validate_no_contribution_overlap(
        ?s, ?modules[0], 2, ?sec_base[0], ?placements[0], 2);
    if (sel clean.err) { ret 8; }

    placements[1].offset = 4;
    val clash: err[fail.Fail] = validate_no_contribution_overlap(
        ?s, ?modules[0], 2, ?sec_base[0], ?placements[0], 2);
    if (!sel clash.err) { ret 9; }
    val msg: str = fail.describe(clash.err);
    if (!str_contains(msg, "left.o:.text"))  { ret 10; }
    if (!str_contains(msg, "right.o:.text")) { ret 11; }

    placements[1].offset = 8;
    placements[1].extent = 0;
    placements[0].extent = 32;
    val aliased: err[fail.Fail] = validate_no_contribution_overlap(
        ?s, ?modules[0], 2, ?sec_base[0], ?placements[0], 2);
    if (sel aliased.err) { ret 12; }
    ret 0;
}

fun lt_image(s: *session.Session, name: intern.StrId,
             sections: *of.Section, section_count: u32,
             symbols: *of.Symbol, symbol_count: u32,
             relocations: *of.Relocation, reloc_count: u32) of.ObjectImage {
    var img: of.ObjectImage = of.object_image_init(s.alloc, ?s.interner, name);
    img.sections = sections;
    img.section_count = section_count;
    img.symbols = symbols;
    img.symbol_count = symbol_count;
    img.relocations = relocations;
    img.reloc_count = reloc_count;
    ret img;
}

test "mach.lang.be.linker.validate_link_inputs:checks_each_borrowed_image_before_use" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var bytes: [4]u8;
    var section: of.Section;
    section.name  = lt_name(?s, ".text");
    section.kind  = of.SK_TEXT;
    section.bytes = ?bytes[0];
    section.len   = 4;
    section.align = 4;
    section.flags = 0;

    var image: of.ObjectImage = lt_image(
        ?s, lt_name(?s, "input"), ?section, 1,
        nil::*of.Symbol, 0, nil::*of.Relocation, 0);
    val validate_link_inputs_r: err[fail.Fail] = validate_link_inputs(?image, 1);
    if (sel validate_link_inputs_r.err) { ret 1; }
    val validate_link_inputs_r2: err[fail.Fail] = validate_link_inputs(nil::*of.ObjectImage, 0);
    if (sel validate_link_inputs_r2.err) { ret 1; }
    val validate_link_inputs_r3: err[fail.Fail] = validate_link_inputs(nil::*of.ObjectImage, 1);
    if (sel validate_link_inputs_r3.ok) { ret 1; }

    section.align = 3;
    val invalid: err[fail.Fail] = validate_link_inputs(?image, 1);
    if (sel invalid.ok) { ret 1; }
    if (!str_contains(fail.describe(invalid.err), "alignment")) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.link_mode:rejects_invalid_before_input_work" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_7280: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_7280.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;
    val invalid: LinkMode = 255::LinkMode;
    if (link_mode_valid(invalid) || !link_mode_valid(LINK_EXE)
        || !link_mode_valid(LINK_RELOCATABLE) || !link_mode_valid(LINK_SHARED)) { ret 1; }

    var paths: [1]*u8;
    paths[0] = "/mach-link-mode-must-not-touch-object-io"::*u8;
    val from_paths: err[fail.Fail] = t_planned_link(
        ?s, ?tgt, ?paths[0], 1, nil::*of.DynLib, 0, ""::*u8, "invalid"::*u8,
        invalid, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel from_paths.ok) { ret 1; }
    if (!str_contains(fail.describe(from_paths.err), "invalid link mode")) { ret 1; }

    val from_images: err[fail.Fail] = t_planned_link_images(
        ?s, ?tgt, nil::*of.ObjectImage, 0, nil::*of.DynLib, 0,
        ""::*u8, "invalid"::*u8, invalid, false,
        of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel from_images.ok) { ret 1; }
    if (!str_contains(fail.describe(from_images.err), "invalid link mode")) { ret 1; }

    val from_mixed: err[fail.Fail] = t_planned_link_mixed(
        ?s, ?tgt, nil::*of.ObjectImage, 0, nil::**u8, 0, nil::*of.DynLib, 0,
        ""::*u8, "invalid"::*u8, invalid, false,
        of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel from_mixed.ok) { ret 1; }
    if (!str_contains(fail.describe(from_mixed.err), "invalid link mode")) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.debug_abbrev_merge:deduplicates_only_equal_tables" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val session_r: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel session_r.err) { ret 1; }
    var s: session.Session = session_r.ok;

    val abbrev_name: intern.StrId = lt_name(?s, ".debug_abbrev");
    var first_bytes: [2]u8;
    first_bytes[0] = 0x11; first_bytes[1] = 0;
    var distinct_bytes: [3]u8;
    distinct_bytes[0] = 0x22; distinct_bytes[1] = 0x33; distinct_bytes[2] = 0;
    var equal_bytes: [2]u8;
    equal_bytes[0] = 0x11; equal_bytes[1] = 0;

    var sections: [3]of.Section;
    sections[0].name = abbrev_name; sections[0].kind = of.SK_DEBUG;
    sections[0].bytes = ?first_bytes[0]; sections[0].len = 2;
    sections[0].align = 1; sections[0].flags = 0;
    sections[1].name = abbrev_name; sections[1].kind = of.SK_DEBUG;
    sections[1].bytes = ?distinct_bytes[0]; sections[1].len = 3;
    sections[1].align = 1; sections[1].flags = 0;
    sections[2].name = abbrev_name; sections[2].kind = of.SK_DEBUG;
    sections[2].bytes = ?equal_bytes[0]; sections[2].len = 2;
    sections[2].align = 2; sections[2].flags = 0;

    var modules: [3]of.ObjectImage;
    modules[0] = lt_image(?s, lt_name(?s, "first.o"), ?sections[0], 1,
                          nil::*of.Symbol, 0, nil::*of.Relocation, 0);
    modules[1] = lt_image(?s, lt_name(?s, "distinct.o"), ?sections[1], 1,
                          nil::*of.Symbol, 0, nil::*of.Relocation, 0);
    modules[2] = lt_image(?s, lt_name(?s, "equal.o"), ?sections[2], 1,
                          nil::*of.Symbol, 0, nil::*of.Relocation, 0);

    val merged_count_r: res[u32, fail.Fail] = merged_section_count(1);
    if (sel merged_count_r.err) { session.dnit(?s); ret 2; }
    val merged_count: u32 = merged_count_r.ok;
    val merged_r: res[*MergedSection, A.Error] =
        A.zallocate[MergedSection](?alloc, merged_count::usize);
    if (sel merged_r.err) { session.dnit(?s); ret 3; }
    val merged: *MergedSection = merged_r.ok;
    var debug_names: [1]intern.StrId;
    debug_names[0] = abbrev_name;
    init_merged(merged, ?debug_names[0], 1);

    var placements: [3]Placement;
    var sec_base: [3]u32;
    var strm: StrMerge;
    strm.buf = enc.buf_init(?alloc);
    strm.offs = map.init[intern.StrId, u32](?alloc, map.hash_u32, map.eq_u32);
    strm.name = intern.STR_NIL;
    strm.active = false;
    var atoms: AtomPlan;
    init_atom_plan(?atoms);
    var groups: SectionGroups;
    init_section_groups(?groups);

    val accumulated_r: err[fail.Fail] = accumulate_sections(
        ?s, ?modules[0], 3, merged, ?debug_names[0], 1,
        ?placements[0], ?sec_base[0], ?strm, ?atoms, ?groups);
    var bad: i32 = 0;
    val slot: u32 = MERGED_KIND_COUNT;
    if (sel accumulated_r.err) { bad = 4; }
    or (placements[0].offset != 0)          { bad = 5; }
    or (placements[1].offset != 2)          { bad = 6; }
    or (placements[2].offset != 0)          { bad = 7; }
    or (merged[slot].len != 5)              { bad = 8; }
    or (merged[slot].align != 2)            { bad = 9; }

    free_section_groups(?alloc, ?groups);
    free_atom_plan(?alloc, ?atoms);
    free_str_merge(?strm);
    A.deallocate[MergedSection](?alloc, merged, merged_count::usize);
    session.dnit(?s);
    ret bad;
}

fun lt_marker_live_value(bytes: *u8, len: usize, marker: u8, value: *u64) bool {
    var at: usize = 0;
    for (at + 16 <= len) {
        var i: usize = 0;
        for (i < 8 && bytes[at + i] == marker) { i = i + 1; }
        if (i == 8) {
            var found: u64 = 0;
            i = 0;
            for (i < 8) {
                found = found | (bytes[at + 8 + i]::u64 << (i * 8));
                i = i + 1;
            }
            if (found != 0 && found != DWARF_TOMBSTONE_ADDRESS) {
                @value = found;
                ret true;
            }
        }
        at = at + 1;
    }
    ret false;
}

fun lt_is_mach_shaped(modules: *of.ObjectImage, m: u32) bool {
    ret module_debug_is_linkable(modules, m);
}

fun lt_marker_present(bytes: *u8, len: usize, marker: u8) bool {
    var at: usize = 0;
    for (at + 8 <= len) {
        var i: usize = 0;
        for (i < 8 && bytes[at + i] == marker) { i = i + 1; }
        if (i == 8) { ret true; }
        at = at + 1;
    }
    ret false;
}

fun lt_foreign_dwarf_link(s: *session.Session, tgt: *target.Target,
                          out_self: *bool, out_foreign: *bool) bool {
    val alloc: *A.Allocator = s.alloc;
    val text:   intern.StrId = lt_name(s, ".text");
    val info:   intern.StrId = lt_name(s, ".debug_info");
    val line:   intern.StrId = lt_name(s, ".debug_line");
    val entry:  intern.StrId = lt_name(s, tgt.os.entry_symbol);
    val ffn:    intern.StrId = lt_name(s, "foreign_fn");
    val lanchor: intern.StrId = lt_name(s, "selfrel.debug_line");
    if (text == intern.STR_NIL || info == intern.STR_NIL || line == intern.STR_NIL
        || entry == intern.STR_NIL || ffn == intern.STR_NIL || lanchor == intern.STR_NIL) {
        ret false;
    }

    var self_text:    [16]u8;
    var foreign_text: [16]u8;
    var self_info:    [24]u8;
    var foreign_info: [24]u8;
    var self_line:    [8]u8;
    var foreign_line: [8]u8;
    var i: u32 = 0;
    for (i < 16) { self_text[i] = (0x10 + i)::u8; foreign_text[i] = (0x30 + i)::u8; i = i + 1; }
    i = 0;
    for (i < 24) { self_info[i] = 0; foreign_info[i] = 0; i = i + 1; }
    i = 0;
    for (i < 8) {
        self_info[i] = 0xAA; foreign_info[i] = 0xBB;
        self_line[i] = 0x5A; foreign_line[i] = 0x5B;
        i = i + 1;
    }

    var self_secs: [3]of.Section;
    self_secs[0].name = text; self_secs[0].kind = of.SK_TEXT;
    self_secs[0].bytes = ?self_text[0]; self_secs[0].len = 16; self_secs[0].align = 16;
    self_secs[1].name = info; self_secs[1].kind = of.SK_DEBUG;
    self_secs[1].bytes = ?self_info[0]; self_secs[1].len = 24; self_secs[1].align = 1;
    self_secs[2].name = line; self_secs[2].kind = of.SK_DEBUG;
    self_secs[2].bytes = ?self_line[0]; self_secs[2].len = 8; self_secs[2].align = 1;

    var foreign_secs: [3]of.Section;
    foreign_secs[0].name = text; foreign_secs[0].kind = of.SK_TEXT;
    foreign_secs[0].bytes = ?foreign_text[0]; foreign_secs[0].len = 16; foreign_secs[0].align = 16;
    foreign_secs[1].name = info; foreign_secs[1].kind = of.SK_DEBUG;
    foreign_secs[1].bytes = ?foreign_info[0]; foreign_secs[1].len = 24; foreign_secs[1].align = 1;
    foreign_secs[2].name = line; foreign_secs[2].kind = of.SK_DEBUG;
    foreign_secs[2].bytes = ?foreign_line[0]; foreign_secs[2].len = 8; foreign_secs[2].align = 1;

    val fn_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var self_syms: [2]of.Symbol;
    self_syms[0].name = entry; self_syms[0].section = of.section_id(0);
    self_syms[0].offset = 0; self_syms[0].size = 16; self_syms[0].flags = fn_flags;
    self_syms[1].name = lanchor; self_syms[1].section = of.section_id(2);
    self_syms[1].offset = 0; self_syms[1].size = 0; self_syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL;

    var foreign_syms: [1]of.Symbol;
    foreign_syms[0].name = ffn; foreign_syms[0].section = of.section_id(0);
    foreign_syms[0].offset = 0; foreign_syms[0].size = 16; foreign_syms[0].flags = fn_flags;

    var self_relocs: [2]of.Relocation;
    self_relocs[0].section = of.section_id(1); self_relocs[0].offset = 8;
    self_relocs[0].kind = of.RK_ABS64; self_relocs[0].sym = 0; self_relocs[0].addend = 0;
    self_relocs[1].section = of.section_id(1); self_relocs[1].offset = 16;
    self_relocs[1].kind = of.RK_ABS32; self_relocs[1].sym = 1; self_relocs[1].addend = 0;

    var foreign_relocs: [1]of.Relocation;
    foreign_relocs[0].section = of.section_id(1); foreign_relocs[0].offset = 8;
    foreign_relocs[0].kind = of.RK_ABS64; foreign_relocs[0].sym = 0; foreign_relocs[0].addend = 0;

    var modules: [2]of.ObjectImage;
    modules[0] = lt_image(s, lt_name(s, "selfrel.o"), ?self_secs[0], 3,
                          ?self_syms[0], 2, ?self_relocs[0], 2);
    modules[1] = lt_image(s, lt_name(s, "foreign.o"), ?foreign_secs[0], 3,
                          ?foreign_syms[0], 1, ?foreign_relocs[0], 1);

    val atf_r: res[output.Output, outcome.Fail] = output.create(alloc, "foreign_dwarf_self");
    if (sel atf_r.err) { ret false; }
    var atf: output.Output = atf_r.ok;
    fin { output.dnit(?atf); }
    val btf_r: res[output.Output, outcome.Fail] = output.create(alloc, "foreign_dwarf_foreign");
    if (sel btf_r.err) { ret false; }
    var btf: output.Output = btf_r.ok;
    fin { output.dnit(?btf); }
    val etf_r: res[output.Output, outcome.Fail] = output.create(alloc, "foreign_dwarf_exe");
    if (sel etf_r.err) {
        ret false;
    }
    var etf: output.Output = etf_r.ok;
    fin { output.dnit(?etf); }
    val apath: str = output.path(?atf);
    val bpath: str = output.path(?btf);
    val epath: str = output.path(?etf);

    var ok: bool = true;
    val t_planned_object_r: err[fail.Fail] = t_planned_object(tgt, ?modules[0], apath::*u8);
    if (sel t_planned_object_r.err) { ok = false; }
    if (ok) {
        val t_planned_object_r: err[fail.Fail] = t_planned_object(tgt, ?modules[1], bpath::*u8);
        if (sel t_planned_object_r.err) { ok = false; }
    }
    if (ok) {
        var paths: [2]*u8;
        paths[0] = apath::*u8; paths[1] = bpath::*u8;
        val lr: err[fail.Fail] = t_planned_link(s, tgt, ?paths[0], 2,
            nil::*of.DynLib, 0, epath::*u8, "foreign_dwarf"::*u8,
            LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
        if (sel lr.err) { ok = false; }
    }
    if (ok) {
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, epath);
        if (sel rr.ok) {
            var out: Vector[u8] = rr.ok;
            @out_self    = lt_marker_present(out.data, out.len, 0xAA);
            @out_foreign = lt_marker_present(out.data, out.len, 0xBB);
            vector.dnit[u8](?out);
        }
        if (sel rr.err) { ok = false; }
    }

    ret ok;
}

test "mach.lang.be.linker.debug_merge:foreign_dwarf_left_out" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_7552: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_7552.err) { ret 1; }
    val er: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    val mr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "darwin", "sysv64");
    if (sel er.err) { ret 1; }
    if (sel mr.err) { ret 1; }
    var elf_tgt: target.Target = er.ok;
    var macho_tgt: target.Target = mr.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var code: i32 = 0;
    var elf_self: bool = false;
    var elf_foreign: bool = true;
    var macho_self: bool = false;
    var macho_foreign: bool = true;
    if (!lt_foreign_dwarf_link(?s, ?elf_tgt, ?elf_self, ?elf_foreign))       { code = 1; }
    if (!lt_foreign_dwarf_link(?s, ?macho_tgt, ?macho_self, ?macho_foreign)) { code = 1; }
    session.dnit(?s);

    if (!elf_self   || elf_foreign)   { code = 1; }
    if (!macho_self || macho_foreign) { code = 1; }
    ret code;
}

fun lt_marker_tombstoned(bytes: *u8, len: usize, marker: u8) bool {
    var at: usize = 0;
    for (at + 16 <= len) {
        var i: usize = 0;
        for (i < 8 && bytes[at + i] == marker) { i = i + 1; }
        if (i == 8) {
            i = 0;
            for (i < 8 && bytes[at + 8 + i] == 0xFF) { i = i + 1; }
            if (i == 8) { ret true; }
        }
        at = at + 1;
    }
    ret false;
}

fun lt_parsed_weak_dwarf_target(s: *session.Session, tgt: *target.Target) bool {
    val alloc: *A.Allocator = s.alloc;
    val text: intern.StrId = lt_name(s, ".text");
    val dup: intern.StrId = lt_name(s, "parsed_weak");
    val entry: intern.StrId = lt_name(s, tgt.os.entry_symbol);
    var debug_names: [4]intern.StrId;
    debug_names[0] = lt_name(s, ".debug_info");
    debug_names[1] = lt_name(s, ".debug_line");
    debug_names[2] = lt_name(s, ".debug_loclists");
    debug_names[3] = lt_name(s, ".debug_rnglists");
    if (text == intern.STR_NIL || dup == intern.STR_NIL || entry == intern.STR_NIL) { ret false; }

    var winner_text: [16]u8;
    var loser_text: [8]u8;
    var winner_debug: [4][40]u8;
    var loser_debug: [4][40]u8;
    var d: u32 = 0;
    for (d < 4) {
        if (debug_names[d] == intern.STR_NIL) { ret false; }
        var i: u32 = 0;
        for (i < 40) {
            winner_debug[d][i] = 0;
            loser_debug[d][i] = 0;
            i = i + 1;
        }
        i = 0;
        for (i < 8) {
            winner_debug[d][i] = (0xA0 + d)::u8;
            loser_debug[d][i] = (0xD0 + d)::u8;
            winner_debug[d][16 + i] = (0xB0 + d)::u8;
            loser_debug[d][16 + i] = (0xE0 + d)::u8;
            i = i + 1;
        }
        d = d + 1;
    }

    var winner_secs: [5]of.Section;
    var loser_secs: [5]of.Section;
    winner_secs[0].name = text; winner_secs[0].kind = of.SK_TEXT;
    winner_secs[0].bytes = ?winner_text[0]; winner_secs[0].len = 16; winner_secs[0].align = 16;
    loser_secs[0].name = text; loser_secs[0].kind = of.SK_TEXT;
    loser_secs[0].bytes = ?loser_text[0]; loser_secs[0].len = 8; loser_secs[0].align = 16;
    d = 0;
    for (d < 4) {
        winner_secs[d + 1].name = debug_names[d]; winner_secs[d + 1].kind = of.SK_DEBUG;
        winner_secs[d + 1].bytes = ?winner_debug[d][0];
        winner_secs[d + 1].len = 40; winner_secs[d + 1].align = 1;
        loser_secs[d + 1].name = debug_names[d]; loser_secs[d + 1].kind = of.SK_DEBUG;
        loser_secs[d + 1].bytes = ?loser_debug[d][0];
        loser_secs[d + 1].len = 40; loser_secs[d + 1].align = 1;
        d = d + 1;
    }

    val weak_flags: u32 =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    val wline: intern.StrId = lt_name(s, "parsed_weak.w.debug_line");
    val lline: intern.StrId = lt_name(s, "parsed_weak.l.debug_line");
    if (wline == intern.STR_NIL || lline == intern.STR_NIL) { ret false; }

    var winner_syms: [3]of.Symbol;
    winner_syms[0].name = dup; winner_syms[0].section = of.section_id(0);
    winner_syms[0].offset = 0; winner_syms[0].size = 8; winner_syms[0].flags = weak_flags;
    winner_syms[1].name = entry; winner_syms[1].section = of.section_id(0);
    winner_syms[1].offset = 8; winner_syms[1].size = 8;
    winner_syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    winner_syms[2].name = wline; winner_syms[2].section = of.section_id(2);
    winner_syms[2].offset = 0; winner_syms[2].size = 0;
    winner_syms[2].flags = of.SYM_OBJ_FLAG_GLOBAL;
    var loser_syms: [2]of.Symbol;
    loser_syms[0].name = dup; loser_syms[0].section = of.section_id(0);
    loser_syms[0].offset = 0; loser_syms[0].size = 8; loser_syms[0].flags = weak_flags;
    loser_syms[1].name = lline; loser_syms[1].section = of.section_id(2);
    loser_syms[1].offset = 0; loser_syms[1].size = 0;
    loser_syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL;

    var winner_relocs: [9]of.Relocation;
    var loser_relocs: [9]of.Relocation;
    d = 0;
    for (d < 4) {
        winner_relocs[d].section = of.section_id(d + 1); winner_relocs[d].offset = 8;
        winner_relocs[d].kind = of.RK_ABS64; winner_relocs[d].sym = 0;
        winner_relocs[d].addend = 0;
        loser_relocs[d].section = of.section_id(d + 1); loser_relocs[d].offset = 8;
        loser_relocs[d].kind = of.RK_ABS64; loser_relocs[d].sym = 0;
        loser_relocs[d].addend = 0;
        winner_relocs[4 + d].section = of.section_id(d + 1); winner_relocs[4 + d].offset = 24;
        winner_relocs[4 + d].kind = of.RK_ABS64; winner_relocs[4 + d].sym = 0;
        winner_relocs[4 + d].addend = 4;
        loser_relocs[4 + d].section = of.section_id(d + 1); loser_relocs[4 + d].offset = 24;
        loser_relocs[4 + d].kind = of.RK_ABS64; loser_relocs[4 + d].sym = 0;
        loser_relocs[4 + d].addend = 4;
        d = d + 1;
    }
    winner_relocs[8].section = of.section_id(1); winner_relocs[8].offset = 32;
    winner_relocs[8].kind = of.RK_ABS32; winner_relocs[8].sym = 2;
    winner_relocs[8].addend = 0;
    loser_relocs[8].section = of.section_id(1); loser_relocs[8].offset = 32;
    loser_relocs[8].kind = of.RK_ABS32; loser_relocs[8].sym = 1;
    loser_relocs[8].addend = 0;

    var modules: [2]of.ObjectImage;
    modules[0] = lt_image(s, lt_name(s, "parsed-winner"), ?winner_secs[0], 5,
                          ?winner_syms[0], 3, ?winner_relocs[0], 9);
    modules[1] = lt_image(s, lt_name(s, "parsed-loser"), ?loser_secs[0], 5,
                          ?loser_syms[0], 2, ?loser_relocs[0], 9);

    if (!lt_is_mach_shaped(?modules[0], 0) || !lt_is_mach_shaped(?modules[0], 1)) { ret false; }

    val wtf_r: res[output.Output, outcome.Fail] = output.create(alloc, "weak_dwarf_winner");
    if (sel wtf_r.err) { ret false; }
    var wtf: output.Output = wtf_r.ok;
    fin { output.dnit(?wtf); }
    val ltf_r: res[output.Output, outcome.Fail] = output.create(alloc, "weak_dwarf_loser");
    if (sel ltf_r.err) {
        ret false;
    }
    var ltf: output.Output = ltf_r.ok;
    fin { output.dnit(?ltf); }
    val etf_r: res[output.Output, outcome.Fail] = output.create(alloc, "weak_dwarf_exe");
    if (sel etf_r.err) {

        ret false;
    }
    var etf: output.Output = etf_r.ok;
    fin { output.dnit(?etf); }
    val wpath: str = output.path(?wtf);
    val lpath: str = output.path(?ltf);
    val epath: str = output.path(?etf);

    var ok: bool = true;
    val t_planned_object_r: err[fail.Fail] = t_planned_object(tgt, ?modules[0], wpath::*u8);
    if (sel t_planned_object_r.err) { ok = false; }
    if (ok) {
        val t_planned_object_r: err[fail.Fail] = t_planned_object(tgt, ?modules[1], lpath::*u8);
        if (sel t_planned_object_r.err) { ok = false; }
    }
    var paths: [2]*u8;
    paths[0] = wpath::*u8; paths[1] = lpath::*u8;
    if (ok) {
        val lr: err[fail.Fail] = t_planned_link(s, tgt, ?paths[0], 2,
            nil::*of.DynLib, 0, epath::*u8, "parsed_weak_dwarf"::*u8,
            LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
        if (sel lr.err) { ok = false; }
    }

    var out: Vector[u8];
    if (ok) {
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, epath);
        if (sel rr.ok) {
            out = rr.ok;
            var live_addr: u64 = 0;
            d = 0;
            for (ok && d < 4) {
                var winner_addr: u64 = 0;
                if (!lt_marker_live_value(out.data, out.len, (0xA0 + d)::u8, ?winner_addr)) {
                    ok = false;
                }
                if (d == 0) { live_addr = winner_addr; }
                or (winner_addr != live_addr) { ok = false; }
                if (!lt_marker_tombstoned(out.data, out.len, (0xD0 + d)::u8)) {
                    ok = false;
                }

                var winner_inner: u64 = 0;
                if (!lt_marker_live_value(out.data, out.len, (0xB0 + d)::u8, ?winner_inner)) {
                    ok = false;
                }
                if (winner_inner != live_addr + 4) { ok = false; }
                if (!lt_marker_tombstoned(out.data, out.len, (0xE0 + d)::u8)) {
                    ok = false;
                }
                d = d + 1;
            }
            vector.dnit[u8](?out);
        }
        if (sel rr.err) { ok = false; }
    }

    ret ok;
}

test "mach.lang.be.linker.patch_relocations:parsed_weak_dwarf_tombstones" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_7781: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_7781.err) { ret 1; }
    val er: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "linux", "sysv64");
    val mr: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "darwin", "sysv64");
    if (sel er.err) { ret 1; }
    if (sel mr.err) { ret 1; }
    var elf_tgt: target.Target = er.ok;
    var macho_tgt: target.Target = mr.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    val elf_ok: bool = lt_parsed_weak_dwarf_target(?s, ?elf_tgt);
    val macho_ok: bool = lt_parsed_weak_dwarf_target(?s, ?macho_tgt);
    session.dnit(?s);
    if (!elf_ok || !macho_ok) { ret 1; }
    ret 0;
}

fun lt_dwarf_addend_crossing(s: *session.Session, tgt: *target.Target) i32 {
    val alloc: *A.Allocator = s.alloc;
    val text:   intern.StrId = lt_name(s, ".text");
    val info:   intern.StrId = lt_name(s, ".debug_info");
    val line:   intern.StrId = lt_name(s, ".debug_line");
    val dup:    intern.StrId = lt_name(s, "crossing_weak");
    val anchor: intern.StrId = lt_name(s, "crossing_anchor");
    val tail:   intern.StrId = lt_name(s, "crossing_tail");
    val lanchor: intern.StrId = lt_name(s, "crossing.debug_line");
    val entry:  intern.StrId = lt_name(s, tgt.os.entry_symbol);
    if (text == intern.STR_NIL || info == intern.STR_NIL || line == intern.STR_NIL
        || dup == intern.STR_NIL || anchor == intern.STR_NIL || tail == intern.STR_NIL
        || lanchor == intern.STR_NIL || entry == intern.STR_NIL) {
        ret 4;
    }

    var win_text:   [32]u8;
    var cross_text: [48]u8;
    var i: u32 = 0;
    for (i < 32) { win_text[i] = (0x10 + i)::u8; i = i + 1; }
    i = 0;
    for (i < 48) { cross_text[i] = (0x40 + i)::u8; i = i + 1; }

    var cross_info: [56]u8;
    i = 0;
    for (i < 56) { cross_info[i] = 0; i = i + 1; }
    i = 0;
    for (i < 8) {
        cross_info[i] = 0xC1; cross_info[16 + i] = 0xC2; cross_info[32 + i] = 0xC3;
        i = i + 1;
    }
    var cross_line: [8]u8;
    i = 0;
    for (i < 8) { cross_line[i] = 0x5C; i = i + 1; }

    var win_secs: [1]of.Section;
    win_secs[0].name = text; win_secs[0].kind = of.SK_TEXT;
    win_secs[0].bytes = ?win_text[0]; win_secs[0].len = 32; win_secs[0].align = 16;

    var cross_secs: [3]of.Section;
    cross_secs[0].name = text; cross_secs[0].kind = of.SK_TEXT;
    cross_secs[0].bytes = ?cross_text[0]; cross_secs[0].len = 48; cross_secs[0].align = 16;
    cross_secs[1].name = info; cross_secs[1].kind = of.SK_DEBUG;
    cross_secs[1].bytes = ?cross_info[0]; cross_secs[1].len = 56; cross_secs[1].align = 1;
    cross_secs[2].name = line; cross_secs[2].kind = of.SK_DEBUG;
    cross_secs[2].bytes = ?cross_line[0]; cross_secs[2].len = 8; cross_secs[2].align = 1;

    val weak_flags: u32 =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    val fn_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var win_syms: [2]of.Symbol;
    win_syms[0].name = dup; win_syms[0].section = of.section_id(0);
    win_syms[0].offset = 0; win_syms[0].size = 16; win_syms[0].flags = weak_flags;
    win_syms[1].name = entry; win_syms[1].section = of.section_id(0);
    win_syms[1].offset = 16; win_syms[1].size = 16; win_syms[1].flags = fn_flags;

    var cross_syms: [4]of.Symbol;
    cross_syms[0].name = anchor; cross_syms[0].section = of.section_id(0);
    cross_syms[0].offset = 0; cross_syms[0].size = 16; cross_syms[0].flags = fn_flags;
    cross_syms[1].name = dup; cross_syms[1].section = of.section_id(0);
    cross_syms[1].offset = 16; cross_syms[1].size = 16; cross_syms[1].flags = weak_flags;
    cross_syms[2].name = tail; cross_syms[2].section = of.section_id(0);
    cross_syms[2].offset = 32; cross_syms[2].size = 16; cross_syms[2].flags = fn_flags;
    cross_syms[3].name = lanchor; cross_syms[3].section = of.section_id(2);
    cross_syms[3].offset = 0; cross_syms[3].size = 0; cross_syms[3].flags = of.SYM_OBJ_FLAG_GLOBAL;

    var cross_relocs: [4]of.Relocation;
    cross_relocs[0].section = of.section_id(1); cross_relocs[0].offset = 8;
    cross_relocs[0].kind = of.RK_ABS64; cross_relocs[0].sym = 0;
    cross_relocs[0].addend = 32;
    cross_relocs[1].section = of.section_id(1); cross_relocs[1].offset = 24;
    cross_relocs[1].kind = of.RK_ABS64; cross_relocs[1].sym = 0;
    cross_relocs[1].addend = 0;
    cross_relocs[2].section = of.section_id(1); cross_relocs[2].offset = 40;
    cross_relocs[2].kind = of.RK_ABS64; cross_relocs[2].sym = 2;
    cross_relocs[2].addend = 0;
    cross_relocs[3].section = of.section_id(1); cross_relocs[3].offset = 48;
    cross_relocs[3].kind = of.RK_ABS32; cross_relocs[3].sym = 3;
    cross_relocs[3].addend = 0;

    var modules: [2]of.ObjectImage;
    modules[0] = lt_image(s, lt_name(s, "crossing-winner"), ?win_secs[0], 1,
                          ?win_syms[0], 2, nil::*of.Relocation, 0);
    modules[1] = lt_image(s, lt_name(s, "crossing-loser"), ?cross_secs[0], 3,
                          ?cross_syms[0], 4, ?cross_relocs[0], 4);

    if (!lt_is_mach_shaped(?modules[0], 1)) { ret 6; }

    val wtf_r: res[output.Output, outcome.Fail] = output.create(alloc, "cross_dwarf_winner");
    if (sel wtf_r.err) { ret 4; }
    var wtf: output.Output = wtf_r.ok;
    fin { output.dnit(?wtf); }
    val ltf_r: res[output.Output, outcome.Fail] = output.create(alloc, "cross_dwarf_loser");
    if (sel ltf_r.err) { ret 4; }
    var ltf: output.Output = ltf_r.ok;
    fin { output.dnit(?ltf); }
    val etf_r: res[output.Output, outcome.Fail] = output.create(alloc, "cross_dwarf_exe");
    if (sel etf_r.err) {
        ret 4;
    }
    var etf: output.Output = etf_r.ok;
    fin { output.dnit(?etf); }
    val wpath: str = output.path(?wtf);
    val lpath: str = output.path(?ltf);
    val epath: str = output.path(?etf);

    var code: i32 = 4;
    var wrote: bool = true;
    val t_planned_object_r: err[fail.Fail] = t_planned_object(tgt, ?modules[0], wpath::*u8);
    if (sel t_planned_object_r.err) { wrote = false; }
    if (wrote) {
        val t_planned_object_r: err[fail.Fail] = t_planned_object(tgt, ?modules[1], lpath::*u8);
        if (sel t_planned_object_r.err) { wrote = false; }
    }
    if (wrote) {
        var paths: [2]*u8;
        paths[0] = wpath::*u8; paths[1] = lpath::*u8;
        val lr: err[fail.Fail] = t_planned_link(s, tgt, ?paths[0], 2,
            nil::*of.DynLib, 0, epath::*u8, "crossing_dwarf"::*u8,
            LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
        if (sel lr.err) {
            code = 3;
            if (str_contains(fail.describe(lr.err), "crosses a discarded body")) { code = 0; }
        }
        if (sel lr.ok) {
            code = 4;
            val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, epath);
            if (sel rr.ok) {
                var out: Vector[u8] = rr.ok;
                var anchor_va: u64 = 0;
                var cross_va: u64 = 0;
                var tail_va: u64 = 0;
                if (lt_marker_live_value(out.data, out.len, 0xC2, ?anchor_va)
                    && lt_marker_live_value(out.data, out.len, 0xC1, ?cross_va)
                    && lt_marker_live_value(out.data, out.len, 0xC3, ?tail_va)) {
                    code = 5;
                    if (tail_va == anchor_va + 16) {
                        code = 2;
                        if (cross_va == anchor_va + 32) { code = 1; }
                    }
                }
                vector.dnit[u8](?out);
            }
        }
    }

    ret code;
}

test "mach.lang.be.linker.patch_relocations:dwarf_addend_crossing_refused" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_7958: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_7958.err) { ret 1; }
    val er: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel er.err) { ret 1; }
    var elf_tgt: target.Target = er.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    val code: i32 = lt_dwarf_addend_crossing(?s, ?elf_tgt);
    session.dnit(?s);
    ret code;
}

fun lt_roundtrip_symbol_size(s: *session.Session, tgt: *target.Target, out: *u32) bool {
    val alloc: *A.Allocator = s.alloc;
    val text: intern.StrId = lt_name(s, ".text");
    val fname: intern.StrId = lt_name(s, "sized_probe");
    if (text == intern.STR_NIL || fname == intern.STR_NIL) { ret false; }

    var body: [16]u8;
    var i: u32 = 0;
    for (i < 16) { body[i] = (0x90 + i)::u8; i = i + 1; }

    var secs: [1]of.Section;
    secs[0].name = text; secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?body[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = fname; syms[0].section = of.section_id(0); syms[0].offset = 0; syms[0].size = 16;
    syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var img: of.ObjectImage = lt_image(s, lt_name(s, "sized"), ?secs[0], 1,
                                       ?syms[0], 1, nil::*of.Relocation, 0);

    val tf_r: res[output.Output, outcome.Fail] = output.create(alloc, "sym_size_probe");
    if (sel tf_r.err) { ret false; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val path: str = output.path(?tf);

    var ok: bool = false;
    val t_planned_object_r: err[fail.Fail] = t_planned_object(tgt, ?img, path::*u8);
    if (sel t_planned_object_r.ok) {
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, path);
        if (sel rr.ok) {
            var raw: Vector[u8] = rr.ok;
            var back: of.ObjectImage;
            val pr: err[fail.Fail] = tgt.of.parse_object(
                alloc, ?s.interner, raw.data, raw.len, ?back);
            if (sel pr.ok) {
                var sy: u32 = 0;
                for (sy < back.symbol_count) {
                    if (back.symbols[sy].name == fname) { @out = back.symbols[sy].size; ok = true; }
                    sy = sy + 1;
                }
            }
            vector.dnit[u8](?raw);
        }
    }

    ret ok;
}

test "mach.lang.be.linker.symbol_size:carried_by_elf_only" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_8027: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_8027.err) { ret 1; }
    val er: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    val mr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "darwin", "sysv64");
    val cr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "windows", "win64");
    if (sel er.err) { ret 1; }
    if (sel mr.err) { ret 1; }
    if (sel cr.err) { ret 1; }
    var elf_tgt: target.Target = er.ok;
    var macho_tgt: target.Target = mr.ok;
    var coff_tgt: target.Target = cr.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var code: i32 = 0;
    var elf_size: u32 = 0xFFFFFFFF;
    var macho_size: u32 = 0xFFFFFFFF;
    var coff_size: u32 = 0xFFFFFFFF;
    if (!lt_roundtrip_symbol_size(?s, ?elf_tgt, ?elf_size))     { code = 1; }
    if (!lt_roundtrip_symbol_size(?s, ?macho_tgt, ?macho_size)) { code = 1; }
    if (!lt_roundtrip_symbol_size(?s, ?coff_tgt, ?coff_size))   { code = 1; }
    session.dnit(?s);

    if (elf_size != 16)  { code = 1; }
    if (macho_size != 0) { code = 1; }
    if (coff_size != 0)  { code = 1; }
    ret code;
}

fun lt_isa(reg: *target.TargetRegistry, name: str) *isa.IsaVTable {
    val found: opt[*isa.IsaVTable] = isa.lookup(?reg.isa, name);
    if (!sel found.some) { ret nil; }
    ret found.some;
}

test "mach.lang.be.linker.archive_resolution:ordered_fixed_point" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    val root: intern.StrId = lt_name(?s, "root");
    val dep: intern.StrId = lt_name(?s, "dependency");
    val common: intern.StrId = lt_name(?s, "common_data");
    val startup: intern.StrId = lt_name(?s, "WinMainCRTStartup");
    if (root == intern.STR_NIL || dep == intern.STR_NIL || common == intern.STR_NIL
        || startup == intern.STR_NIL) { session.dnit(?s); ret 1; }

    val undef_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;
    val def_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var seed_syms: [2]of.Symbol;
    seed_syms[0].name = root; seed_syms[0].section = of.external_section();
    seed_syms[0].offset = 0; seed_syms[0].size = 0; seed_syms[0].flags = undef_flags;
    seed_syms[1].name = common; seed_syms[1].section = of.external_section();
    seed_syms[1].offset = 8; seed_syms[1].size = 8;
    seed_syms[1].flags = undef_flags | of.SYM_OBJ_FLAG_OBJECT;
    var seed: of.ObjectImage = lt_image(?s, lt_name(?s, "seed"),
        nil::*of.Section, 0, ?seed_syms[0], 2, nil::*of.Relocation, 0);

    var early_sym: of.Symbol;
    early_sym.name = dep; early_sym.section = of.section_id(0); early_sym.offset = 0;
    early_sym.size = 0; early_sym.flags = def_flags | of.SYM_OBJ_FLAG_WEAK;
    var early: of.ObjectImage = lt_image(?s, lt_name(?s, "early"),
        nil::*of.Section, 0, ?early_sym, 1, nil::*of.Relocation, 0);

    var late_syms: [3]of.Symbol;
    late_syms[0].name = root; late_syms[0].section = of.section_id(0); late_syms[0].offset = 0;
    late_syms[0].size = 0; late_syms[0].flags = def_flags;
    late_syms[1].name = dep; late_syms[1].section = of.external_section();
    late_syms[1].offset = 0; late_syms[1].size = 0; late_syms[1].flags = undef_flags;
    late_syms[2].name = root; late_syms[2].section = of.external_section();
    late_syms[2].offset = 0; late_syms[2].size = 0; late_syms[2].flags = undef_flags;
    var late: of.ObjectImage = lt_image(?s, lt_name(?s, "late"),
        nil::*of.Section, 0, ?late_syms[0], 3, nil::*of.Relocation, 0);

    var common_sym: of.Symbol;
    common_sym.name = common; common_sym.section = of.section_id(0); common_sym.offset = 0;
    common_sym.size = 8;
    common_sym.flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    var common_def: of.ObjectImage = lt_image(?s, lt_name(?s, "common-def"),
        nil::*of.Section, 0, ?common_sym, 1, nil::*of.Relocation, 0);

    var unused_sym: of.Symbol;
    unused_sym.name = startup; unused_sym.section = of.section_id(0); unused_sym.offset = 0;
    unused_sym.size = 0; unused_sym.flags = def_flags;
    var unused: of.ObjectImage = lt_image(?s, lt_name(?s, "startup"),
        nil::*of.Section, 0, ?unused_sym, 1, nil::*of.Relocation, 0);

    var dbg_sec: of.Section;
    dbg_sec.name = lt_name(?s, ".debug_info"); dbg_sec.kind = of.SK_DEBUG;
    dbg_sec.bytes = nil; dbg_sec.len = 0; dbg_sec.align = 1;
    var dbg_sym: of.Symbol = late_syms[0];
    var debug_only: of.ObjectImage = lt_image(?s, lt_name(?s, "debug"),
        ?dbg_sec, 1, ?dbg_sym, 1, nil::*of.Relocation, 0);

    var state: ArchiveResolution;
    init_archive_resolution(?alloc, ?state);
    val archive_note_image_r: err[fail.Fail] = archive_note_image(?s, "", ?state, ?seed);
    if (sel archive_note_image_r.err) { ret 1; }
    val e0: res[bool, fail.Fail] = archive_image_needed(?s, "", ?state, ?early);
    val u0: res[bool, fail.Fail] = archive_image_needed(?s, "", ?state, ?unused);
    val d0: res[bool, fail.Fail] = archive_image_needed(?s, "", ?state, ?debug_only);
    val l0: res[bool, fail.Fail] = archive_image_needed(?s, "", ?state, ?late);
    if (sel e0.err) { ret 1; }
    if (e0.ok) { ret 1; }
    if (sel u0.err) { ret 1; }
    if (u0.ok) { ret 1; }
    if (sel d0.err) { ret 1; }
    if (d0.ok) { ret 1; }
    if (sel l0.err) { ret 1; }
    if (!l0.ok) { ret 1; }
    val archive_note_image_r2: err[fail.Fail] = archive_note_image(?s, "", ?state, ?late);
    if (sel archive_note_image_r2.err) { ret 1; }
    val e1: res[bool, fail.Fail] = archive_image_needed(?s, "", ?state, ?early);
    val c1: res[bool, fail.Fail] = archive_image_needed(?s, "", ?state, ?common_def);
    if (sel e1.err) { ret 1; }
    if (!e1.ok) { ret 1; }
    if (sel c1.err) { ret 1; }
    if (!c1.ok) { ret 1; }
    val archive_note_image_r3: err[fail.Fail] = archive_note_image(?s, "", ?state, ?early);
    if (sel archive_note_image_r3.err) { ret 1; }
    val archive_note_image_r4: err[fail.Fail] = archive_note_image(?s, "", ?state, ?common_def);
    if (sel archive_note_image_r4.err) { ret 1; }
    var duplicate: of.ObjectImage = late;
    duplicate.symbols = ?late_syms[1]; duplicate.symbol_count = 1;
    late_syms[1].section = of.section_id(0); late_syms[1].flags = def_flags;
    val dupe: res[bool, fail.Fail] = archive_image_needed(?s, "", ?state, ?duplicate);
    if (sel dupe.err) { ret 1; }
    if (dupe.ok) { ret 1; }
    if (state.unresolved.len != 0) { ret 1; }

    free_archive_resolution(?state);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.archive_resolution:entry_root" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    val entry: intern.StrId = lt_name(?s, "mainCRTStartup");
    var sym: of.Symbol;
    sym.name = entry; sym.section = of.section_id(0); sym.offset = 0; sym.size = 0;
    sym.flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var member: of.ObjectImage = lt_image(?s, lt_name(?s, "entry-member"),
        nil::*of.Section, 0, ?sym, 1, nil::*of.Relocation, 0);

    var state: ArchiveResolution;
    init_archive_resolution(?alloc, ?state);
    val archive_require_r: err[fail.Fail] = archive_require(?state, entry);
    if (sel archive_require_r.err) { ret 1; }
    val needed: res[bool, fail.Fail] = archive_image_needed(?s, "", ?state, ?member);
    if (sel needed.err) { ret 1; }
    if (!needed.ok) { ret 1; }
    val archive_note_image_r: err[fail.Fail] = archive_note_image(?s, "", ?state, ?member);
    if (sel archive_note_image_r.err) { ret 1; }
    if (state.unresolved.len != 0) { ret 1; }

    free_archive_resolution(?state);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.archive_resolution:test_entry_satisfies_main_before_archive" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_8204: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_8204.err) { session.dnit(?s); ret 1; }
    val tr: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "windows", "win64");
    if (sel tr.err) { session.dnit(?s); ret 1; }
    var tgt: target.Target = tr.ok;

    val text:      intern.StrId = lt_name(?s, ".text");
    val entry_sym: intern.StrId = lt_name(?s, "mainCRTStartup");
    val main_sym:  intern.StrId = lt_name(?s, "main");
    val helper:    intern.StrId = lt_name(?s, "helper");
    if (text == intern.STR_NIL || entry_sym == intern.STR_NIL
        || main_sym == intern.STR_NIL || helper == intern.STR_NIL) {
        session.dnit(?s); ret 1;
    }

    val def_fn: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    val undef:  u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;

    var eb: [8]u8;
    var cb: [8]u8;
    var hb: [8]u8;
    var sb: [8]u8;
    var i: u32 = 0;
    for (i < 8) {
        eb[i] = 0xCC; cb[i] = 0x90; hb[i] = 0xA5; sb[i] = 0x33;
        i = i + 1;
    }

    var entry_secs: [1]of.Section;
    entry_secs[0].name = text; entry_secs[0].kind = of.SK_TEXT;
    entry_secs[0].bytes = ?eb[0]; entry_secs[0].len = 8; entry_secs[0].align = 8;
    var entry_syms: [2]of.Symbol;
    entry_syms[0].name = main_sym; entry_syms[0].section = of.section_id(0); entry_syms[0].offset = 0;
    entry_syms[0].size = 8; entry_syms[0].flags = def_fn;
    entry_syms[1].name = helper; entry_syms[1].section = of.external_section();
    entry_syms[1].offset = 0; entry_syms[1].size = 0; entry_syms[1].flags = undef;
    var entry_img: of.ObjectImage = lt_image(?s, lt_name(?s, "test-entry"),
        ?entry_secs[0], 1, ?entry_syms[0], 2, nil::*of.Relocation, 0);

    var crt_secs: [1]of.Section;
    crt_secs[0].name = text; crt_secs[0].kind = of.SK_TEXT;
    crt_secs[0].bytes = ?cb[0]; crt_secs[0].len = 8; crt_secs[0].align = 8;
    var crt_syms: [2]of.Symbol;
    crt_syms[0].name = entry_sym; crt_syms[0].section = of.section_id(0); crt_syms[0].offset = 0;
    crt_syms[0].size = 8; crt_syms[0].flags = def_fn;
    crt_syms[1].name = main_sym; crt_syms[1].section = of.external_section();
    crt_syms[1].offset = 0; crt_syms[1].size = 0; crt_syms[1].flags = undef;
    var crt_img: of.ObjectImage = lt_image(?s, lt_name(?s, "crt"),
        ?crt_secs[0], 1, ?crt_syms[0], 2, nil::*of.Relocation, 0);

    var helper_secs: [1]of.Section;
    helper_secs[0].name = text; helper_secs[0].kind = of.SK_TEXT;
    helper_secs[0].bytes = ?hb[0]; helper_secs[0].len = 8; helper_secs[0].align = 8;
    var helper_syms: [1]of.Symbol;
    helper_syms[0].name = helper; helper_syms[0].section = of.section_id(0); helper_syms[0].offset = 0;
    helper_syms[0].size = 8; helper_syms[0].flags = def_fn;
    var helper_img: of.ObjectImage = lt_image(?s, lt_name(?s, "helper"),
        ?helper_secs[0], 1, ?helper_syms[0], 1, nil::*of.Relocation, 0);

    var stub_secs: [1]of.Section;
    stub_secs[0].name = text; stub_secs[0].kind = of.SK_TEXT;
    stub_secs[0].bytes = ?sb[0]; stub_secs[0].len = 8; stub_secs[0].align = 8;
    var stub_syms: [1]of.Symbol;
    stub_syms[0].name = main_sym; stub_syms[0].section = of.section_id(0); stub_syms[0].offset = 0;
    stub_syms[0].size = 8; stub_syms[0].flags = def_fn;
    var stub_img: of.ObjectImage = lt_image(?s, lt_name(?s, "main-stub"),
        ?stub_secs[0], 1, ?stub_syms[0], 1, nil::*of.Relocation, 0);

    var entry_tf: output.Output;
    var crt_tf:   output.Output;
    var helper_tf: output.Output;
    var stub_tf:  output.Output;
    var ar_tf:    output.Output;
    var exe_tf:   output.Output;
    var have_entry: bool = false;
    var have_crt:   bool = false;
    var have_helper: bool = false;
    var have_stub:  bool = false;
    var have_ar:    bool = false;
    var have_exe:   bool = false;

    val er0: res[output.Output, outcome.Fail] = output.create(?alloc, "mach_2562_entry");
    if (sel er0.err) { session.dnit(?s); ret 1; }
    entry_tf = er0.ok; have_entry = true;
    val er1: res[output.Output, outcome.Fail] = output.create(?alloc, "mach_2562_crt");
    if (sel er1.err) { remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe); session.dnit(?s); ret 1; }
    crt_tf = er1.ok; have_crt = true;
    val er2: res[output.Output, outcome.Fail] = output.create(?alloc, "mach_2562_helper");
    if (sel er2.err) { remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe); session.dnit(?s); ret 1; }
    helper_tf = er2.ok; have_helper = true;
    val er3: res[output.Output, outcome.Fail] = output.create(?alloc, "mach_2562_stub");
    if (sel er3.err) { remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe); session.dnit(?s); ret 1; }
    stub_tf = er3.ok; have_stub = true;
    val er4: res[output.Output, outcome.Fail] = output.create(?alloc, "mach_2562_ar");
    if (sel er4.err) { remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe); session.dnit(?s); ret 1; }
    ar_tf = er4.ok; have_ar = true;
    val er5: res[output.Output, outcome.Fail] = output.create(?alloc, "mach_2562_exe");
    if (sel er5.err) { remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe); session.dnit(?s); ret 1; }
    exe_tf = er5.ok; have_exe = true;

    val entry_path: str = output.path(?entry_tf);
    val crt_path:   str = output.path(?crt_tf);
    val helper_path: str = output.path(?helper_tf);
    val stub_path:  str = output.path(?stub_tf);
    val ar_path:    str = output.path(?ar_tf);
    val exe_path:   str = output.path(?exe_tf);

    val close_r: err[outcome.Fail] = output.close(?exe_tf);
    val close_r2: err[outcome.Fail] = output.close(?ar_tf);
    val close_r3: err[outcome.Fail] = output.close(?stub_tf);
    val close_r4: err[outcome.Fail] = output.close(?helper_tf);
    val close_r5: err[outcome.Fail] = output.close(?crt_tf);
    val close_r6: err[outcome.Fail] = output.close(?entry_tf);
    if (sel close_r6.err) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s); ret 1;
    }
    if (sel close_r5.err) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s); ret 1;
    }
    if (sel close_r4.err) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s); ret 1;
    }
    if (sel close_r3.err) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s); ret 1;
    }
    if (sel close_r2.err) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s); ret 1;
    }
    if (sel close_r.err) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s); ret 1;
    }

    var bad: i32 = 0;
    val t_planned_object_r: err[fail.Fail] = t_planned_object(?tgt, ?entry_img, entry_path::*u8);
    if (sel t_planned_object_r.err) { bad = 1; }
    if (bad == 0) {
        val t_planned_object_r: err[fail.Fail] = t_planned_object(?tgt, ?crt_img, crt_path::*u8);
        if (sel t_planned_object_r.err) { bad = 1; }
    }
    if (bad == 0) {
        val t_planned_object_r: err[fail.Fail] = t_planned_object(?tgt, ?helper_img, helper_path::*u8);
        if (sel t_planned_object_r.err) { bad = 1; }
    }
    if (bad == 0) {
        val t_planned_object_r: err[fail.Fail] = t_planned_object(?tgt, ?stub_img, stub_path::*u8);
        if (sel t_planned_object_r.err) { bad = 1; }
    }

    var crt_vec:    Vector[u8];
    var helper_vec: Vector[u8];
    var stub_vec:   Vector[u8];
    var have_crt_v: bool = false;
    var have_hlp_v: bool = false;
    var have_stb_v: bool = false;
    if (bad == 0) {
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, crt_path);
        if (sel rr.ok) { crt_vec = rr.ok; have_crt_v = true; }
        if (sel rr.err) { bad = 1; }
    }
    if (bad == 0) {
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, helper_path);
        if (sel rr.ok) { helper_vec = rr.ok; have_hlp_v = true; }
        if (sel rr.err) { bad = 1; }
    }
    if (bad == 0) {
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, stub_path);
        if (sel rr.ok) { stub_vec = rr.ok; have_stb_v = true; }
        if (sel rr.err) { bad = 1; }
    }

    if (bad == 0) {
        var crt_names:    [1]str; crt_names[0]    = "mainCRTStartup";
        var helper_names: [1]str; helper_names[0] = "helper";
        var stub_names:   [1]str; stub_names[0]   = "main";
        var members: [3]ar.ArMember;
        members[0].name = "crt.o";    members[0].data = crt_vec.data;    members[0].len = crt_vec.len;    members[0].sym_names = ?crt_names[0];    members[0].sym_count = 1;
        members[1].name = "helper.o"; members[1].data = helper_vec.data; members[1].len = helper_vec.len; members[1].sym_names = ?helper_names[0]; members[1].sym_count = 1;
        members[2].name = "stub.o";   members[2].data = stub_vec.data;   members[2].len = stub_vec.len;   members[2].sym_names = ?stub_names[0];   members[2].sym_count = 1;
        val wr: err[fail.Fail] = t_planned_archive(?alloc, ?members[0], 3, ar_path);
        if (sel wr.err) { bad = 1; }
    }

    if (bad == 0) {
        var fix_paths: [2]*u8;
        fix_paths[0] = entry_path::*u8;
        fix_paths[1] = ar_path::*u8;
        val lr: err[fail.Fail] =
            t_planned_link(?s, ?tgt, ?fix_paths[0], 2, nil::*of.DynLib, 0, exe_path::*u8,
                 "test-entry-fix", LINK_EXE, false,
                 of.image_options_default(of.SUBSYSTEM_CONSOLE));
        if (sel lr.err) { bad = 1; }
    }

    if (bad == 0) {
        var bug_paths: [2]*u8;
        bug_paths[0] = ar_path::*u8;
        bug_paths[1] = entry_path::*u8;
        val lr: err[fail.Fail] =
            t_planned_link(?s, ?tgt, ?bug_paths[0], 2, nil::*of.DynLib, 0, exe_path::*u8,
                 "test-entry-bug", LINK_EXE, false,
                 of.image_options_default(of.SUBSYSTEM_CONSOLE));
        if (sel lr.err) {
            val error: str = fail.describe(lr.err);
            if (!str_equals(error, "multiple definition of 'main'")) { bad = 1; }
        }
        if (sel lr.ok) { bad = 1; }
    }

    if (have_crt_v)  { vector.dnit[u8](?crt_vec); }
    if (have_hlp_v)  { vector.dnit[u8](?helper_vec); }
    if (have_stb_v)  { vector.dnit[u8](?stub_vec); }
    remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
    session.dnit(?s);
    ret bad;
}

fun remove_2562(a: *output.Output, b: *output.Output, c: *output.Output, d: *output.Output,
                e: *output.Output, f: *output.Output,
                ha: bool, hb: bool, hc: bool, hd: bool, he: bool, hf: bool) {
    if (ha) { output.dnit(a); }
    if (hb) { output.dnit(b); }
    if (hc) { output.dnit(c); }
    if (hd) { output.dnit(d); }
    if (he) { output.dnit(e); }
    if (hf) { output.dnit(f); }
}

test "mach.lang.be.linker.archive_resolution:undefined_weak_does_not_extract" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    val name: intern.StrId = lt_name(?s, "optional_hook");
    val undef: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;
    var weak_ref: of.Symbol;
    weak_ref.name = name; weak_ref.section = of.external_section();
    weak_ref.offset = 0; weak_ref.size = 0;
    weak_ref.flags = undef | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    var provider: of.Symbol;
    provider.name = name; provider.section = of.section_id(0); provider.offset = 0; provider.size = 0;
    provider.flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var weak_img: of.ObjectImage = lt_image(?s, lt_name(?s, "weak-user"),
        nil::*of.Section, 0, ?weak_ref, 1, nil::*of.Relocation, 0);
    var provider_img: of.ObjectImage = lt_image(?s, lt_name(?s, "provider"),
        nil::*of.Section, 0, ?provider, 1, nil::*of.Relocation, 0);

    var state: ArchiveResolution;
    init_archive_resolution(?alloc, ?state);
    val archive_note_image_r: err[fail.Fail] = archive_note_image(?s, "", ?state, ?weak_img);
    if (sel archive_note_image_r.err) { ret 1; }
    val optional: res[bool, fail.Fail] = archive_image_needed(?s, "", ?state, ?provider_img);
    if (sel optional.err) { ret 1; }
    if (optional.ok) { ret 1; }
    if (state.unresolved.len != 0) { ret 1; }

    weak_ref.flags = undef | of.SYM_OBJ_FLAG_FUNCTION;
    val archive_note_image_r2: err[fail.Fail] = archive_note_image(?s, "", ?state, ?weak_img);
    if (sel archive_note_image_r2.err) { ret 1; }
    val required: res[bool, fail.Fail] = archive_image_needed(?s, "", ?state, ?provider_img);
    if (sel required.err) { ret 1; }
    if (!required.ok) { ret 1; }

    free_archive_resolution(?state);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.archive_resolution:weak_fallback_modes" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    val public: intern.StrId = lt_name(?s, "weak_public");
    val fallback: intern.StrId = lt_name(?s, "weak_fallback");
    val ext: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;
    var syms: [2]of.Symbol;
    syms[0].name = public; syms[0].section = of.external_section();
    syms[0].offset = 0; syms[0].size = 0; syms[0].fallback = 1;
    syms[1].name = fallback; syms[1].section = of.external_section();
    syms[1].offset = 0; syms[1].size = 0; syms[1].flags = ext;
    syms[1].fallback = of.SYMBOL_NONE;
    var img: of.ObjectImage = lt_image(?s, lt_name(?s, "weak-user"),
        nil::*of.Section, 0, ?syms[0], 2, nil::*of.Relocation, 0);

    var modes: [3]u32;
    modes[0] = 0;
    modes[1] = of.SYM_OBJ_FLAG_SEARCH;
    modes[2] = of.SYM_OBJ_FLAG_ALIAS;
    var mi: u32 = 0;
    for (mi < 3) {
        syms[0].flags = ext | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FALLBACK
            | modes[mi];
        var state: ArchiveResolution;
        init_archive_resolution(?alloc, ?state);
        if (mi == 2) {
            val required: err[fail.Fail] = archive_require(?state, public);
            if (sel required.err) { ret 1; }
        }
        val archive_note_image_r: err[fail.Fail] = archive_note_image(?s, "", ?state, ?img);
        if (sel archive_note_image_r.err) { ret 1; }
        if (!map.contains[intern.StrId, u32](?state.unresolved, ?fallback)) { ret 1; }
        val wants_public: bool =
            map.contains[intern.StrId, u32](?state.unresolved, ?public);
        val provides_public: bool =
            map.contains[intern.StrId, u32](?state.providers, ?public);
        if (wants_public != (mi == 1) || provides_public != (mi == 2)) { ret 1; }
        free_archive_resolution(?state);
        mi = mi + 1;
    }

    syms[0].fallback = 99;
    var malformed: ArchiveResolution;
    init_archive_resolution(?alloc, ?malformed);
    val mr: err[fail.Fail] = archive_note_image(?s, "", ?malformed, ?img);
    free_archive_resolution(?malformed);
    session.dnit(?s);
    if (!sel mr.err) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.collect_symbols:weak_fallback_resolution" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    val one: intern.StrId = lt_name(?s, "fallback_one");
    val two: intern.StrId = lt_name(?s, "fallback_two");
    val three: intern.StrId = lt_name(?s, "fallback_three");
    val ext: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;
    val relation: u32 = ext | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FALLBACK;

    var rel_syms: [2]of.Symbol;
    rel_syms[0].name = one; rel_syms[0].section = of.external_section();
    rel_syms[0].offset = 0; rel_syms[0].size = 0;
    rel_syms[0].flags = relation; rel_syms[0].fallback = 1;
    rel_syms[1].name = two; rel_syms[1].section = of.external_section();
    rel_syms[1].offset = 0; rel_syms[1].size = 0;
    rel_syms[1].flags = ext; rel_syms[1].fallback = of.SYMBOL_NONE;
    var real_one: of.Symbol;
    real_one.name = one; real_one.section = of.section_id(0); real_one.offset = 0;
    real_one.size = 0; real_one.flags = of.SYM_OBJ_FLAG_GLOBAL;
    real_one.fallback = of.SYMBOL_NONE;
    var real_two: of.Symbol = real_one; real_two.name = two;

    var modules: [3]of.ObjectImage;
    modules[0] = lt_image(?s, lt_name(?s, "relation"), nil::*of.Section, 0,
        ?rel_syms[0], 2, nil::*of.Relocation, 0);
    modules[1] = lt_image(?s, lt_name(?s, "real-one"), nil::*of.Section, 1,
        ?real_one, 1, nil::*of.Relocation, 0);
    modules[2] = lt_image(?s, lt_name(?s, "real-two"), nil::*of.Section, 1,
        ?real_two, 1, nil::*of.Relocation, 0);
    var placements: [2]Placement;
    placements[0].vaddr = 0x1000; placements[0].offset = 0; placements[0].merged_index = 0;
    placements[1].vaddr = 0x2000; placements[1].offset = 0; placements[1].merged_index = 0;
    var sec_base: [3]u32; sec_base[0] = 0; sec_base[1] = 0; sec_base[2] = 1;
    var locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    val cr: err[fail.Fail] = collect_symbols(?s, ?modules[0], 3,
        ?placements[0], ?sec_base[0], ?locs, true, nil::*AtomPlan);
    if (sel cr.err) { ret 1; }
    val rn: res[intern.StrId, fail.Fail] = resolved_symbol_name(?locs, one);
    val ol: opt[*SymbolLoc] = map.get[intern.StrId, SymbolLoc](?locs, ?one);
    if (sel rn.err) { ret 1; }
    if (rn.ok != one) { ret 1; }
    if (sel ol.none) { ret 1; }
    if (ol.some.vaddr != 0x1000) { ret 1; }
    map.dnit[intern.StrId, SymbolLoc](?locs);

    var same_object: [2]of.ObjectImage;
    same_object[0] = modules[0]; same_object[1] = modules[2];
    var same_base: [2]u32; same_base[0] = 0; same_base[1] = 0;
    locs = map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    val sc: err[fail.Fail] = collect_symbols(?s, ?same_object[0], 2,
        ?placements[1], ?same_base[0], ?locs, true, nil::*AtomPlan);
    val sn: res[intern.StrId, fail.Fail] = resolved_symbol_name(?locs, one);
    val tl: opt[*SymbolLoc] = map.get[intern.StrId, SymbolLoc](?locs, ?two);
    if (sel sc.err) { ret 1; }
    if (sel sn.err) { ret 1; }
    if (sn.ok != two) { ret 1; }
    if (sel tl.none) { ret 1; }
    if (tl.some.vaddr != 0x2000) { ret 1; }
    map.dnit[intern.StrId, SymbolLoc](?locs);

    var chain: [3]of.Symbol;
    chain[0] = rel_syms[0]; chain[0].fallback = 1;
    chain[1] = rel_syms[0]; chain[1].name = two; chain[1].fallback = 2;
    chain[2] = rel_syms[1]; chain[2].name = three;
    var chain_img: of.ObjectImage = lt_image(?s, lt_name(?s, "chain"),
        nil::*of.Section, 0, ?chain[0], 3, nil::*of.Relocation, 0);
    locs = map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    val cc: err[fail.Fail] = collect_symbols(?s, ?chain_img, 1,
        nil::*Placement, nil::*u32, ?locs, false, nil::*AtomPlan);
    if (sel cc.err) { ret 1; }
    val cn: res[intern.StrId, fail.Fail] = resolved_symbol_name(?locs, one);
    if (sel cn.err) { ret 1; }
    if (cn.ok != three) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_8587: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_8587.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;
    var dyn: DynState; init_dynstate(?dyn);
    val dr: err[fail.Fail] = build_dynamic_info(?s, ?tgt, ?dyn, ?chain_img, 1,
        ?locs, nil::*of.DynLib, 0, nil::*u32, nil::*AtomPlan);
    if (sel dr.err) { ret 1; }
    if (dyn.info.import_count != 1) { ret 1; }
    if (dyn.info.imports[0].symbol != three) { ret 1; }
    free_dynstate(?alloc, ?dyn);
    map.dnit[intern.StrId, SymbolLoc](?locs);

    var conflict: [4]of.Symbol;
    conflict[0] = rel_syms[0]; conflict[0].fallback = 1;
    conflict[1] = rel_syms[1];
    conflict[2] = rel_syms[0]; conflict[2].fallback = 1;
    conflict[3] = rel_syms[1]; conflict[3].name = three;
    var conflict_mods: [2]of.ObjectImage;
    conflict_mods[0] = lt_image(?s, lt_name(?s, "conflict-a"), nil::*of.Section, 0,
        ?conflict[0], 2, nil::*of.Relocation, 0);
    conflict_mods[1] = lt_image(?s, lt_name(?s, "conflict-b"), nil::*of.Section, 0,
        ?conflict[2], 2, nil::*of.Relocation, 0);
    locs = map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    val cf: err[fail.Fail] = collect_symbols(?s, ?conflict_mods[0], 2,
        nil::*Placement, nil::*u32, ?locs, false, nil::*AtomPlan);
    map.dnit[intern.StrId, SymbolLoc](?locs);
    if (!sel cf.err) { ret 1; }

    chain[0].fallback = 1; chain[1].fallback = 0;
    chain_img.symbol_count = 2;
    locs = map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    val cy: err[fail.Fail] = collect_symbols(?s, ?chain_img, 1,
        nil::*Placement, nil::*u32, ?locs, false, nil::*AtomPlan);
    map.dnit[intern.StrId, SymbolLoc](?locs);
    session.dnit(?s);
    if (!sel cy.err) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.relocatable:preserves_sections_and_remaps_relations" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var bytes: [8]u8;
    bytes[0] = 0xA5;
    var sections: [2]of.Section;
    sections[0] = of.Section{};
    sections[0].name = lt_name(?s, ".custom.one");
    sections[0].kind = of.SK_DATA; sections[0].bytes = ?bytes[0];
    sections[0].len = 8; sections[0].align = 8;
    sections[0].native.format = of.OF_COFF;
    sections[0].native.flags = 0x40000040;
    sections[1] = of.Section{};
    sections[1].name = lt_name(?s, ".custom.empty");
    sections[1].kind = of.SK_DATA; sections[1].align = 1;
    sections[1].native.format = of.OF_COFF;
    sections[1].native.flags = 0x40001040;
    sections[1].native.selection = 5;
    sections[1].native.link_section = 1;
    var symbols: [3]of.Symbol;
    symbols[0] = of.Symbol{};
    symbols[0].name = lt_name(?s, "declared");
    symbols[0].section = of.external_section();
    symbols[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FALLBACK;
    symbols[0].fallback = 1; symbols[0].align = 1;
    symbols[1] = of.Symbol{};
    symbols[1].name = lt_name(?s, "defined"); symbols[1].section = of.section_id(0);
    symbols[1].size = 8; symbols[1].align = 8;
    symbols[2] = of.Symbol{name: lt_name(?s, "absolute"), section: of.absolute_section(),
        absolute_value: 0xF123456789ABCDEF};
    var indirect: of.NativeIndirect = of.NativeIndirect{section: of.section_id(0), slot: 0, symbol: 0};
    sections[0].native.format = of.OF_MACHO;
    var reloc: of.Relocation = of.Relocation{};
    reloc.kind = of.RK_DIFF64; reloc.sym = 1; reloc.sym2 = 0; reloc.pair = 1;
    var decl: of.ImportDecl = of.ImportDecl{};
    decl.symbol = lt_name(?s, "public_name");
    decl.import_name = lt_name(?s, "export_name");
    decl.library = lt_name(?s, "provider.dll"); decl.ordinal = 17; decl.by_name = true; decl.is_code = true;
    var inputs: [2]of.ObjectImage;
    inputs[0] = lt_image(?s, lt_name(?s, "first"), ?sections[0], 1, ?symbols[1], 1, nil::*of.Relocation, 0);
    inputs[1] = lt_image(?s, lt_name(?s, "second"), ?sections[0], 2, ?symbols[0], 3, ?reloc, 1);
    inputs[0].indirects = ?indirect; inputs[0].indirect_count = 1;
    inputs[1].indirects = ?indirect; inputs[1].indirect_count = 1;
    inputs[1].imports = ?decl; inputs[1].import_count = 1;
    var attributes: [2]u8; attributes[0] = 4; attributes[1] = 7;
    val combined: res[of.ObjectImage, fail.Fail] = relocatable.combine(?alloc, ?s.interner, ?inputs[0], 2, 9, ?attributes[0], 2);
    if (sel combined.err) { ret 1; }
    var image: of.ObjectImage = combined.ok;
    fin { obj.dnit(?image); }
    if (image.indirect_count != 2 || of.section_index(image.indirects[0].section) != 0 || image.indirects[0].symbol != 0
        || of.section_index(image.indirects[1].section) != 1 || image.indirects[1].symbol != 1
        || !of.section_is_absolute(image.symbols[3].section) || image.symbols[3].absolute_value != symbols[2].absolute_value) { ret 4; }
    if (image.section_count != 3 || image.symbol_count != 4 || image.reloc_count != 1
        || image.sections[0].name != sections[0].name || image.sections[1].name != sections[0].name
        || image.sections[2].name != sections[1].name || image.sections[2].len != 0
        || image.sections[2].native.link_section != 2 || image.sections[2].native.selection != 5
        || image.symbols[1].fallback != 2 || of.section_index(image.symbols[2].section) != 1
        || image.relocations[0].sym != 2 || image.relocations[0].sym2 != 1
        || image.relocations[0].pair != 1 || of.section_index(image.relocations[0].section) != 1
        || image.import_count != 1 || image.imports[0].library != decl.library
        || image.imports[0].import_name != decl.import_name || image.imports[0].ordinal != 17
        || image.machine_flags != 9 || image.attributes_len != 2 || image.attributes[1] != 7) { ret 2; }
    image.sections[1].bytes[0] = 0;
    image.attributes[0] = 0;
    if (bytes[0] != 0xA5 || attributes[0] != 4 || symbols[0].fallback != 1) { ret 3; }
    ret 0;
}

test "mach.lang.be.linker.read_objects:ordered_archive_end_to_end" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_8708: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_8708.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "windows", "win64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    val root: intern.StrId = lt_name(?s, "archive_entry");
    val dep: intern.StrId = lt_name(?s, "earlier_dependency");
    val late: intern.StrId = lt_name(?s, "late_requirement");
    val call: intern.StrId = lt_name(?s, "loose_call");
    val startup: intern.StrId = lt_name(?s, "WinMainCRTStartup");
    val text_name: intern.StrId = lt_name(?s, ".text");
    if (root == intern.STR_NIL || dep == intern.STR_NIL || late == intern.STR_NIL
        || call == intern.STR_NIL || startup == intern.STR_NIL
        || text_name == intern.STR_NIL) { ret 1; }

    var code: [1]u8; code[0] = 0xC3;
    var sec: of.Section;
    sec.name = text_name; sec.kind = of.SK_TEXT; sec.bytes = ?code[0];
    sec.len = 1; sec.align = 1;
    val def: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    val undef: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN
        | of.SYM_OBJ_FLAG_FUNCTION;

    var early_sym: of.Symbol;
    early_sym.name = dep; early_sym.section = of.section_id(0); early_sym.offset = 0;
    early_sym.size = 1; early_sym.flags = def;
    var root_syms: [2]of.Symbol;
    root_syms[0].name = root; root_syms[0].section = of.section_id(0); root_syms[0].offset = 0;
    root_syms[0].size = 1; root_syms[0].flags = def;
    root_syms[1].name = dep; root_syms[1].section = of.external_section();
    root_syms[1].offset = 0; root_syms[1].size = 0; root_syms[1].flags = undef;
    var late_sym: of.Symbol;
    late_sym.name = late; late_sym.section = of.section_id(0); late_sym.offset = 0;
    late_sym.size = 1; late_sym.flags = def;
    var startup_sym: of.Symbol;
    startup_sym.name = startup; startup_sym.section = of.section_id(0); startup_sym.offset = 0;
    startup_sym.size = 1; startup_sym.flags = def;

    var images: [4]of.ObjectImage;
    images[0] = lt_image(?s, lt_name(?s, "early"), ?sec, 1,
                         ?early_sym, 1, nil::*of.Relocation, 0);
    images[1] = lt_image(?s, lt_name(?s, "root"), ?sec, 1,
                         ?root_syms[0], 2, nil::*of.Relocation, 0);
    images[2] = lt_image(?s, lt_name(?s, "late"), ?sec, 1,
                         ?late_sym, 1, nil::*of.Relocation, 0);
    images[3] = lt_image(?s, lt_name(?s, "startup"), ?sec, 1,
                         ?startup_sym, 1, nil::*of.Relocation, 0);

    var member_bytes: [4]Vector[u8];
    var mi: u32 = 0;
    for (mi < 4) {
        val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "archive_member");
        if (sel tf_r.err) { ret 1; }
        var tf: output.Output = tf_r.ok;
        fin { output.dnit(?tf); }
        val er: err[fail.Fail] = t_planned_object(?tgt, ?images[mi], output.path(?tf)::*u8);
        if (sel er.err) { ret 1; }
        val br: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, output.path(?tf));

        if (sel br.err) { ret 1; }
        member_bytes[mi] = br.ok;
        mi = mi + 1;
    }
    var n0: [1]str; n0[0] = "earlier_dependency";
    var n1: [1]str; n1[0] = "archive_entry";
    var n2: [1]str; n2[0] = "late_requirement";
    var n3: [1]str; n3[0] = "WinMainCRTStartup";
    var members: [4]ar.ArMember;
    members[0].name = "early.o"; members[0].data = member_bytes[0].data;
    members[0].len = member_bytes[0].len; members[0].sym_names = ?n0[0]; members[0].sym_count = 1;
    members[1].name = "root.o"; members[1].data = member_bytes[1].data;
    members[1].len = member_bytes[1].len; members[1].sym_names = ?n1[0]; members[1].sym_count = 1;
    members[2].name = "late.o"; members[2].data = member_bytes[2].data;
    members[2].len = member_bytes[2].len; members[2].sym_names = ?n2[0]; members[2].sym_count = 1;
    members[3].name = "startup.o"; members[3].data = member_bytes[3].data;
    members[3].len = member_bytes[3].len; members[3].sym_names = ?n3[0]; members[3].sym_count = 1;

    val at_r: res[output.Output, outcome.Fail] = output.create(?alloc, "ordered_archive");
    if (sel at_r.err) { ret 1; }
    var at: output.Output = at_r.ok;
    fin { output.dnit(?at); }
    val t_planned_archive_r: err[fail.Fail] = t_planned_archive(?alloc, ?members[0], 4, output.path(?at));
    if (sel t_planned_archive_r.err) {

        ret 1;
    }

    var loose_syms: [2]of.Symbol;
    loose_syms[0].name = call; loose_syms[0].section = of.section_id(0); loose_syms[0].offset = 0;
    loose_syms[0].size = 1; loose_syms[0].flags = def;
    loose_syms[1].name = late; loose_syms[1].section = of.external_section();
    loose_syms[1].offset = 0; loose_syms[1].size = 0; loose_syms[1].flags = undef;
    var loose: of.ObjectImage = lt_image(?s, lt_name(?s, "loose"), ?sec, 1,
        ?loose_syms[0], 2, nil::*of.Relocation, 0);
    val lt_r: res[output.Output, outcome.Fail] = output.create(?alloc, "late_loose");
    if (sel lt_r.err) { ret 1; }
    var lt: output.Output = lt_r.ok;
    fin { output.dnit(?lt); }
    val t_planned_object_r: err[fail.Fail] = t_planned_object(?tgt, ?loose, output.path(?lt)::*u8);
    if (sel t_planned_object_r.err) {
        ret 1;
    }

    var paths: [2]*u8;
    paths[0] = output.path(?at)::*u8;
    paths[1] = output.path(?lt)::*u8;
    var module_count: u32 = 0;
    val rr: res[*of.ObjectImage, fail.Fail] = read_objects(?s, ?tgt, ?paths[0], 2,
        nil::*of.ObjectImage, 0, root, ?module_count);

    mi = 0;
    for (mi < 4) { vector.dnit[u8](?member_bytes[mi]); mi = mi + 1; }
    if (sel rr.err) { ret 1; }
    if (module_count != 3) { ret 1; }
    val modules: *of.ObjectImage = rr.ok;

    var saw_root: bool = false;
    var saw_early: bool = false;
    var saw_late: bool = false;
    var saw_startup: bool = false;
    mi = 0;
    for (mi < module_count) {
        var si: u32 = 0;
        for (si < modules[mi].symbol_count) {
            val sym: *of.Symbol = ?modules[mi].symbols[si];
            if (!of.section_is_external(sym.section)) {
                if (sym.name == root)    { saw_root = true; }
                if (sym.name == dep)     { saw_early = true; }
                if (sym.name == late)    { saw_late = true; }
                if (sym.name == startup) { saw_startup = true; }
            }
            si = si + 1;
        }
        mi = mi + 1;
    }
    free_modules(?alloc, modules, module_count);
    session.dnit(?s);
    if (!saw_root || !saw_early || saw_late || saw_startup) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.archive_resolution:import_address_alias" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    val public: intern.StrId = lt_name(?s, "Sleep");
    val indirect: intern.StrId = lt_name(?s, "__imp_Sleep");
    val dll: intern.StrId = lt_name(?s, "kernel32.dll");
    if (public == intern.STR_NIL || indirect == intern.STR_NIL
        || dll == intern.STR_NIL) { session.dnit(?s); ret 1; }

    var sym: of.Symbol;
    sym.name = indirect; sym.section = of.external_section();
    sym.offset = 0; sym.size = 0;
    sym.flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_OBJECT;
    var seed: of.ObjectImage = lt_image(?s, lt_name(?s, "dll-user"),
        nil::*of.Section, 0, ?sym, 1, nil::*of.Relocation, 0);
    var decl: of.ImportDecl;
    decl.symbol = public; decl.import_name = public; decl.library = dll;
    decl.ordinal = 0; decl.by_name = true; decl.is_code = true;
    var record: of.ObjectImage = lt_image(?s, lt_name(?s, "import-record"),
        nil::*of.Section, 0, nil::*of.Symbol, 0, nil::*of.Relocation, 0);
    record.imports = ?decl; record.import_count = 1;

    var state: ArchiveResolution;
    init_archive_resolution(?alloc, ?state);
    val archive_note_image_r: err[fail.Fail] = archive_note_image(?s, "__imp_", ?state, ?seed);
    if (sel archive_note_image_r.err) { ret 1; }
    val needed: res[bool, fail.Fail] = archive_image_needed(?s, "__imp_", ?state, ?record);
    if (sel needed.err) { ret 1; }
    if (!needed.ok) { ret 1; }
    val archive_note_image_r2: err[fail.Fail] = archive_note_image(?s, "__imp_", ?state, ?record);
    if (sel archive_note_image_r2.err) { ret 1; }
    if (state.unresolved.len != 0
        || !map.contains[intern.StrId, u32](?state.providers, ?public)
        || !map.contains[intern.StrId, u32](?state.providers, ?indirect)) { ret 1; }

    free_archive_resolution(?state);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.dynlib_index_of:logical_and_loader_names" {
    var libs: [3]of.DynLib;
    libs[0].name = 41;
    libs[0].soname = 73;
    libs[0].rpath = intern.STR_NIL;
    libs[1].name = 42;
    libs[1].soname = 73;
    libs[1].rpath = intern.STR_NIL;
    libs[2].name = 43;
    libs[2].soname = 74;
    libs[2].rpath = intern.STR_NIL;

    val logical: opt[u32] =
        dynlib_index_of(?libs[0], 3, nil::*of.DynLib, 41);
    val alias: opt[u32] =
        dynlib_index_of(?libs[0], 3, nil::*of.DynLib, 42);
    val loader: opt[u32] =
        dynlib_index_of(?libs[0], 3, nil::*of.DynLib, 73);
    val other: opt[u32] =
        dynlib_index_of(?libs[0], 3, nil::*of.DynLib, 74);
    val missing: opt[u32] =
        dynlib_index_of(?libs[0], 3, nil::*of.DynLib, 99);
    if (!sel logical.some) { ret 1; }
    if (logical.some != 0) { ret 1; }
    if (!sel alias.some) { ret 1; }
    if (alias.some != 0) { ret 1; }
    if (!sel loader.some) { ret 1; }
    if (loader.some != 0) { ret 1; }
    if (!sel other.some) { ret 1; }
    if (other.some != 1) { ret 1; }
    if (sel missing.some) { ret 1; }
    if (unique_dynlib_count(?libs[0], 3) != 2) { ret 1; }
    if (!declared_attribution_matches(?libs[0], 3, nil::*of.DynLib, 41, 73)) { ret 1; }
    if (!declared_attribution_matches(?libs[0], 3, nil::*of.DynLib, 73, 73)) { ret 1; }
    if (declared_attribution_matches(?libs[0], 3, nil::*of.DynLib, 41, 74))  { ret 1; }

    var collision: [2]of.DynLib;
    collision[0].name = 41;
    collision[0].soname = 73;
    collision[0].rpath = intern.STR_NIL;
    collision[1].name = 73;
    collision[1].soname = 74;
    collision[1].rpath = intern.STR_NIL;
    var first: intern.StrId = intern.STR_NIL;
    var second: intern.StrId = intern.STR_NIL;
    var identity: intern.StrId = intern.STR_NIL;
    if (!dynlib_identity_collision(?collision[0], 2, nil::*of.DynLib,
                                   ?first, ?second, ?identity)) { ret 1; }
    if (first != 73 || second != 74 || identity != 73) { ret 1; }

    var reversed: [2]of.DynLib;
    reversed[0] = collision[1];
    reversed[1] = collision[0];
    if (!dynlib_identity_collision(?reversed[0], 2, nil::*of.DynLib,
                                   ?first, ?second, ?identity)) { ret 1; }
    if (identity != 73) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.unattributed_import_message:names_both_routes" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val sym: intern.StrId = lt_name(?s, "Sleep");
    var libs: [1]of.DynLib;
    libs[0].name = lt_name(?s, "kernel32");
    libs[0].soname = lt_name(?s, "kernel32.dll");
    libs[0].rpath = intern.STR_NIL;
    if (sym == intern.STR_NIL || libs[0].name == intern.STR_NIL
        || libs[0].soname == intern.STR_NIL) { ret 1; }

    val msg: str = unattributed_import_message(?s, sym, "", ?libs[0], 1);
    if (!str_contains(msg, "dynamic import 'Sleep'"))        { ret 1; }
    if (!str_contains(msg, "#[library(\"...\")]"))            { ret 1; }
    if (!str_contains(msg, "static archive member"))          { ret 1; }
    if (!str_contains(msg, "no declaration to annotate"))     { ret 1; }
    if (!str_contains(msg, "symbols = [\"Sleep\"]"))          { ret 1; }
    if (!str_contains(msg, "[link.<entry>]"))                 { ret 1; }
    if (!str_contains(msg, "candidate libraries: kernel32 (kernel32.dll)")) { ret 1; }

    val mach_o: intern.StrId = lt_name(?s, "_Sleep");
    if (mach_o == intern.STR_NIL) { ret 1; }
    val dmsg: str = unattributed_import_message(?s, mach_o, "_", ?libs[0], 1);
    if (!str_contains(dmsg, "dynamic import '_Sleep'"))       { ret 1; }
    if (!str_contains(dmsg, "symbols = [\"Sleep\"]"))         { ret 1; }
    if (str_contains(dmsg, "symbols = [\"_Sleep\"]"))         { ret 1; }

    val bare: str = unattributed_import_message(?s, sym, "_", ?libs[0], 1);
    if (!str_contains(bare, "symbols = [\"Sleep\"]"))         { ret 1; }

    val degraded: str =
        unattributed_import_message(?s, intern.STR_NIL, "", nil::*of.DynLib, 0);
    if (!str_contains(degraded, "#[library(\"...\")]"))        { ret 1; }
    if (!str_contains(degraded, "static archive member"))      { ret 1; }
    if (!str_contains(degraded, "symbols = [...]"))            { ret 1; }

    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.build_dynamic_info:linux_interpreter_matches_target" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_9005: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_9005.err) { ret 1; }

    var locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    var names: [3]str;
    names[0] = "x86_64"; names[1] = "aarch64"; names[2] = "riscv64";
    var abis: [3]str;
    abis[0] = "sysv64"; abis[1] = "aapcs64"; abis[2] = "lp64d";
    var paths: [3]str;
    paths[0] = "/lib64/ld-linux-x86-64.so.2";
    paths[1] = "/lib/ld-linux-aarch64.so.1";
    paths[2] = "/lib/ld-linux-riscv64-lp64d.so.1";

    var i: usize = 0;
    for (i < 3) {
        val tr: res[target.Target, fail.Fail] =
            target.select(?reg, names[i], "linux", abis[i]);
        if (sel tr.err) { ret 1; }
        var tgt: target.Target = tr.ok;
        var dyn: DynState;
        init_dynstate(?dyn);
        val built: err[fail.Fail] = build_dynamic_info(
            ?s, ?tgt, ?dyn, nil::*of.ObjectImage, 0, ?locs,
            nil::*of.DynLib, 0, nil::*u32, nil::*AtomPlan);
        if (sel built.err) { ret 1; }
        val interp: opt[str] = intern.lookup(?s.interner, dyn.info.interp);
        if (sel interp.none) {
            ret 1;
        }
        if (!(str_equals(interp.some, paths[i]))) {
            ret 1;
        }
        free_dynstate(?alloc, ?dyn);
        i = i + 1;
    }
    map.dnit[intern.StrId, SymbolLoc](?locs);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.build_dynamic_info:rejects_import_address_alias" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_9050: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_9050.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "windows", "win64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    val symbol: intern.StrId = lt_name(?s, "Sleep");
    val alias: intern.StrId = lt_name(?s, "__imp_Sleep");
    val library: intern.StrId = lt_name(?s, "kernel32.dll");
    if (symbol == intern.STR_NIL || alias == intern.STR_NIL
        || library == intern.STR_NIL) { ret 1; }

    var sym: of.Symbol;
    sym.name = symbol;
    sym.section = of.external_section();
    sym.offset = 0;
    sym.size = 0;
    sym.flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN
              | of.SYM_OBJ_FLAG_FUNCTION;
    var decl: of.ImportDecl;
    decl.symbol = symbol;
    decl.import_name = alias;
    decl.library = library;
    decl.ordinal = 0;
    decl.by_name = true;
    decl.is_code = true;
    var rel: of.Relocation;
    rel.section = of.section_id(0); rel.offset = 0; rel.sym = 0; rel.addend = 0; rel.sym2 = 0;
    var module: of.ObjectImage =
        lt_image(?s, lt_name(?s, "import-user"), nil::*of.Section, 0,
                 ?sym, 1, ?rel, 1);
    module.imports = ?decl;
    module.import_count = 1;

    var locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    var dyn: DynState;
    init_dynstate(?dyn);
    val built: err[fail.Fail] =
        build_dynamic_info(?s, ?tgt, ?dyn, ?module, 1, ?locs,
                           nil::*of.DynLib, 0, nil::*u32, nil::*AtomPlan);

    var code: i32 = 0;
    if (sel built.err) {
        val msg: str = fail.describe(built.err);
        if (dyn.info.import_count != 0)                    { code = 1; }
        if (!str_contains(msg, "'__imp_Sleep'"))           { code = 1; }
        if (!str_contains(msg, "import-address alias"))    { code = 1; }
        if (!str_contains(msg, "import 'Sleep' instead"))  { code = 1; }
    }
    if (sel built.ok) { code = 1; }

    val bare: intern.StrId = lt_name(?s, "__imp_");
    if (is_import_address_alias(?s, bare, "__imp_"))  { code = 1; }
    if (is_import_address_alias(?s, symbol, "__imp_")) { code = 1; }
    if (!is_import_address_alias(?s, alias, "__imp_")) { code = 1; }

    free_dynstate(?alloc, ?dyn);
    map.dnit[intern.StrId, SymbolLoc](?locs);
    session.dnit(?s);
    ret code;
}

