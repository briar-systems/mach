}

test "mach.lang.be.linker.atom_plan:undescribed_kind_is_rejected_not_defaulted" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_11277: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_11277.err) { ret 2; }
    val x64: *isa.IsaVTable = lt_isa(?reg, "x86_64");
    if (x64 == nil) { ret 3; }

    val dup: intern.StrId = lt_name(?s, "atomdup$u64");
    val text: intern.StrId = lt_name(?s, ".text");
    val weak_flags: u32 =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;

    var winner_bytes: [8]u8;
    var loser_bytes: [8]u8;
    var winner_sec: [1]of.Section;
    var loser_sec: [1]of.Section;
    winner_sec[0].name = text; winner_sec[0].kind = of.SK_TEXT;
    winner_sec[0].bytes = ?winner_bytes[0]; winner_sec[0].len = 8; winner_sec[0].align = 1;
    loser_sec[0].name = text; loser_sec[0].kind = of.SK_TEXT;
    loser_sec[0].bytes = ?loser_bytes[0]; loser_sec[0].len = 8; loser_sec[0].align = 1;

    var winner_sym: [1]of.Symbol;
    var loser_syms: [1]of.Symbol;
    winner_sym[0].name = dup; winner_sym[0].section = of.section_id(0); winner_sym[0].offset = 0;
    winner_sym[0].size = 8; winner_sym[0].flags = weak_flags;
    loser_syms[0].name = dup; loser_syms[0].section = of.section_id(0); loser_syms[0].offset = 0;
    loser_syms[0].size = 8; loser_syms[0].flags = weak_flags;

    var relocation: [1]of.Relocation;
    relocation[0].section = of.section_id(0); relocation[0].offset = 0; relocation[0].kind = of.RK_ABS64;
    relocation[0].sym = 0; relocation[0].addend = 0; relocation[0].sym2 = of.SYMBOL_NONE;
    relocation[0].pair = 0;

    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "atomwinner"), ?winner_sec[0], 1,
                       ?winner_sym[0], 1, nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "atomloser"), ?loser_sec[0], 1,
                       ?loser_syms[0], 1, ?relocation[0], 1);

    var bases: [2]u32;
    var plan: AtomPlan;
    init_atom_plan(?plan);
    val described: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, x64, ?plan);
    if (sel described.err) { ret 4; }
    free_atom_plan(?alloc, ?plan);

    relocation[0].kind = of.RK_PAGE21;
    init_atom_plan(?plan);
    val undescribed: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, x64, ?plan);
    if (!sel undescribed.err) { ret 5; }
    if (!str_contains(fail.describe(undescribed.err), "catalog does not describe")) { ret 6; }
    free_atom_plan(?alloc, ?plan);

    relocation[0].kind = of.RK_ABS64;
    relocation[0].section = of.section_id(9);
    init_atom_plan(?plan);
    val stray: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, x64, ?plan);
    if (!sel stray.err) { ret 7; }
    if (!str_contains(fail.describe(stray.err), "does not carry")) { ret 8; }
    free_atom_plan(?alloc, ?plan);
    ret 0;
}

test "mach.lang.be.linker.atom_plan:difference_subtrahend_retains_loser" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_11348: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_11348.err) { ret 1; }
    val x64: *isa.IsaVTable = lt_isa(?reg, "x86_64");
    if (x64 == nil) { ret 1; }

    val dup: intern.StrId = lt_name(?s, "difference$u64");
    val text: intern.StrId = lt_name(?s, ".text");
    val data: intern.StrId = lt_name(?s, ".data");
    val data_base: intern.StrId = lt_name(?s, "data_base");
    val weak_flags: u32 =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    var winner_bytes: [8]u8;
    var loser_text: [8]u8;
    var loser_data: [4]u8;
    var winner_sec: [1]of.Section;
    var loser_secs: [2]of.Section;
    winner_sec[0].name = text; winner_sec[0].kind = of.SK_TEXT;
    winner_sec[0].bytes = ?winner_bytes[0]; winner_sec[0].len = 8; winner_sec[0].align = 1;
    loser_secs[0].name = text; loser_secs[0].kind = of.SK_TEXT;
    loser_secs[0].bytes = ?loser_text[0]; loser_secs[0].len = 8; loser_secs[0].align = 1;
    loser_secs[1].name = data; loser_secs[1].kind = of.SK_DATA;
    loser_secs[1].bytes = ?loser_data[0]; loser_secs[1].len = 4; loser_secs[1].align = 4;

    var winner_sym: [1]of.Symbol;
    var loser_syms: [3]of.Symbol;
    winner_sym[0].name = dup; winner_sym[0].section = of.section_id(0); winner_sym[0].offset = 0;
    winner_sym[0].size = 8; winner_sym[0].flags = weak_flags;
    loser_syms[0].name = dup; loser_syms[0].section = of.section_id(0); loser_syms[0].offset = 0;
    loser_syms[0].size = 8; loser_syms[0].flags = weak_flags;
    loser_syms[1].name = text; loser_syms[1].section = of.section_id(0); loser_syms[1].offset = 0;
    loser_syms[1].size = 0; loser_syms[1].flags = 0;
    loser_syms[2].name = data_base; loser_syms[2].section = of.section_id(1); loser_syms[2].offset = 0;
    loser_syms[2].size = 0; loser_syms[2].flags = 0;

    var relocation: [1]of.Relocation;
    relocation[0].section = of.section_id(1); relocation[0].offset = 0; relocation[0].kind = of.RK_DIFF32;
    relocation[0].sym = 2; relocation[0].addend = 0; relocation[0].sym2 = 1;
    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "winner"), ?winner_sec[0], 1,
                       ?winner_sym[0], 1, nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "loser"), ?loser_secs[0], 2,
                       ?loser_syms[0], 3, ?relocation[0], 1);
    if (unreferenced_local(?mods[1], 1)) { ret 1; }

    var bases: [2]u32;
    var plan: AtomPlan;
    init_atom_plan(?plan);
    val difference: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 3, true, x64, ?plan);
    if (sel difference.err) { ret 1; }
    if (plan.active) { ret 1; }

    relocation[0].kind = of.RK_ABS32;
    if (!unreferenced_local(?mods[1], 1)) { ret 1; }
    val ordinary: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 3, true, x64, ?plan);
    if (sel ordinary.err) { ret 1; }
    if (!plan.active) { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    if (plan.drops[0].section != 1 || plan.drops[0].start != 0
        || plan.drops[0].end != 8) { ret 1; }
    free_atom_plan(?alloc, ?plan);
    ret 0;
}

test "mach.lang.be.linker.atom_plan:sized_extent_and_covering_symbol" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_11421: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_11421.err) { ret 1; }
    val x64: *isa.IsaVTable = lt_isa(?reg, "x86_64");
    if (x64 == nil) { ret 1; }

    val dup: intern.StrId = lt_name(?s, "sized$u64");
    val cover: intern.StrId = lt_name(?s, "cover");
    val text: intern.StrId = lt_name(?s, ".text");
    val weak_flags: u32 =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;

    var a_bytes: [8]u8;
    var b_bytes: [16]u8;
    var i: u32 = 0;
    for (i < 16) { b_bytes[i] = (0x50 + i)::u8; i = i + 1; }
    var a_sec: [1]of.Section;
    var b_sec: [1]of.Section;
    a_sec[0].name = text; a_sec[0].kind = of.SK_TEXT; a_sec[0].bytes = ?a_bytes[0];
    a_sec[0].len = 8; a_sec[0].align = 1;
    b_sec[0].name = text; b_sec[0].kind = of.SK_TEXT; b_sec[0].bytes = ?b_bytes[0];
    b_sec[0].len = 16; b_sec[0].align = 1;

    var a_syms: [1]of.Symbol;
    var b_syms: [2]of.Symbol;
    a_syms[0].name = dup; a_syms[0].section = of.section_id(0); a_syms[0].offset = 0;
    a_syms[0].size = 8; a_syms[0].flags = weak_flags;
    b_syms[0].name = dup; b_syms[0].section = of.section_id(0); b_syms[0].offset = 0;
    b_syms[0].size = 8; b_syms[0].flags = weak_flags;
    b_syms[1].name = cover; b_syms[1].section = of.section_id(0); b_syms[1].offset = 16;
    b_syms[1].size = 0; b_syms[1].flags = 0;

    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(0); relocs[0].offset = 0; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 1; relocs[0].addend = 0;

    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "a"), ?a_sec[0], 1, ?a_syms[0], 1,
                       nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "b"), ?b_sec[0], 1, ?b_syms[0], 2,
                       ?relocs[0], 1);
    var bases: [2]u32;
    var plan: AtomPlan;
    init_atom_plan(?plan);
    val sized: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, x64, ?plan);
    if (sel sized.err) { ret 1; }
    if (!plan.active) { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    if (plan.drops[0].start != 0 || plan.drops[0].end != 8
        || plan.sections[1].live_len != 8) { ret 1; }
    var copied: [8]u8;
    copy_live_section(?copied[0], ?b_bytes[0], 16, ?plan, 1);
    i = 0;
    for (i < 8) {
        if (copied[i] != b_bytes[8 + i]) { ret 1; }
        i = i + 1;
    }
    free_atom_plan(?alloc, ?plan);

    b_syms[0].offset = 8;
    b_syms[0].size = 8;
    b_syms[1].offset = 0;
    b_syms[1].size = 16;
    val covered: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, x64, ?plan);
    if (sel covered.err) { ret 1; }
    if (plan.active) { ret 1; }
    ret 0;
}

