rec ImageCountUnit {}

pub fun link(s: *session.Session, diags: *diagnostic.DiagnosticStore, tgt: *lang_target.Binding, inputs: *target_of.ObjectInput,
    input_count: u32, dynlibs: *target_of.DynLib, dynlib_count: u32,
    destination: str, name: *u8, mode: catalog_artifact.Kind, pie: bool,
    image_options: target_of.ImageOptions) err[fail.Fail] {
    if (s == nil)                          { ret err[fail.Fail].err{fail.message("nil session")}; }
    if (diags == nil)                      { ret err[fail.Fail].err{fail.message("nil diagnostic store")}; }
    if (tgt == nil)                        { ret err[fail.Fail].err{fail.message("nil target")}; }
    if (tgt == nil)                        { ret err[fail.Fail].err{fail.message("target: nil resolved target")}; }
    if (tgt.of == nil)                     { ret err[fail.Fail].err{fail.message("target has no object-format vtable")}; }
    if (tgt.os == nil)                     { ret err[fail.Fail].err{fail.message("target has no OS vtable")}; }
    if (!catalog_artifact.is_linked(mode)) { ret err[fail.Fail].err{fail.message("the linker does not produce this artifact kind")}; }
    if (inputs == nil || input_count == 0) {
        ret err[fail.Fail].err{fail.message("no input objects")};
    }

    val alloc: *A.Allocator = s.alloc;

    var required: intern.StrId = intern.STR_NIL;
    if (mode == catalog_artifact.EXECUTABLE) {
        val er: res[intern.StrId, A.Error] = intern.add(?s.interner, tgt.os.entry_symbol);
        if (sel er.err) {
            ret err[fail.Fail].err{fail.refused(er.err)};
        }
        required = er.ok;
    }

    var module_count: u32                                    = 0;
    val read_r:       res[*target_of.ObjectImage, fail.Fail] =
        read_objects(s, tgt, inputs, input_count, nil::*target_of.ObjectImage, 0,
        required, ?module_count);
    if (sel read_r.err) {
        ret err[fail.Fail].err{read_r.err};
    }
    val modules: *target_of.ObjectImage = read_r.ok;

    fin { free_modules(alloc, modules, module_count); }
    ret link_modules_nocapture(s, diags, tgt, modules, module_count, dynlibs, dynlib_count,
        destination, name, mode, pie, image_options);
}

pub rec LinkedImage {
    bytes:          *u8;
    len:            usize;
    base:           u64;
    symbols:        *target_of.SymtabEntry;
    symbol_count:   u32;
    functions:      *target_of.ExecFunction;
    function_count: u32;
}

#[testing]
pub fun linked_image_dnit(img: *LinkedImage, alloc: *A.Allocator) {
    if (img == nil)                      { ret; }
    if (img.bytes != nil && img.len > 0) { A.deallocate[u8](alloc, img.bytes, img.len); }
    if (img.symbols != nil && img.symbol_count > 0) {
        A.deallocate[target_of.SymtabEntry](alloc, img.symbols, img.symbol_count::usize);
    }
    if (img.functions != nil && img.function_count > 0) {
        A.deallocate[target_of.ExecFunction](alloc, img.functions, img.function_count::usize);
    }
    img.bytes          = nil;
    img.len            = 0;
    img.base           = 0;
    img.symbols        = nil;
    img.symbol_count   = 0;
    img.functions      = nil;
    img.function_count = 0;
}

# link images into an executable handed back in memory
# ---
# root_names: definitions the caller reaches by name, kept even when the entry
#             does not reach them
# root_count: number of root names
#[testing]
pub fun link_images_captured(s: *session.Session, diags: *diagnostic.DiagnosticStore, tgt: *lang_target.Binding, images: *target_of.ObjectImage,
    image_count: u32, dynlibs: *target_of.DynLib, dynlib_count: u32,
    name: *u8, pie: bool, image_options: target_of.ImageOptions,
    root_names: *str, root_count: u32, out: *LinkedImage) err[fail.Fail] {
    if (out == nil) { ret err[fail.Fail].err{fail.message("nil capture target")}; }
    if (out.bytes != nil || out.symbols != nil || out.functions != nil) {
        ret err[fail.Fail].err{fail.message("capture target is not empty")};
    }
    out.bytes          = nil;
    out.len            = 0;
    out.base           = 0;
    out.symbols        = nil;
    out.symbol_count   = 0;
    out.functions      = nil;
    out.function_count = 0;

    if (s == nil)      { ret err[fail.Fail].err{fail.message("nil session")}; }
    if (diags == nil)  { ret err[fail.Fail].err{fail.message("nil diagnostic store")}; }
    if (tgt == nil)    { ret err[fail.Fail].err{fail.message("nil target")}; }
    if (tgt == nil)    { ret err[fail.Fail].err{fail.message("target: nil resolved target")}; }
    if (tgt.of == nil) { ret err[fail.Fail].err{fail.message("target has no object-format vtable")}; }
    if (tgt.os == nil) { ret err[fail.Fail].err{fail.message("target has no OS vtable")}; }
    if (images == nil || image_count == 0) {
        ret err[fail.Fail].err{fail.message("no input objects")};
    }
    if (!tgt.of.produces_image || tgt.of.emit_exec_image == nil) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "this object format cannot hand back a linked image")};
    }

    var roots: *intern.StrId = nil;
    if (root_count > 0) {
        val rr: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](s.alloc, root_count::usize);
        if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
        roots = rr.ok;
    }
    fin {
        if (roots != nil) { A.deallocate[intern.StrId](s.alloc, roots, root_count::usize); }
    }
    var ri: u32 = 0;
    for (ri < root_count) {
        val ir: res[intern.StrId, A.Error] = intern.add(?s.interner, root_names[ri]);
        if (sel ir.err) { ret err[fail.Fail].err{fail.refused(ir.err)}; }
        roots[ri] = ir.ok;
        ri        = ri + 1;
    }

    ret link_modules(s, diags, tgt, images, image_count, dynlibs,
        dynlib_count, nil, name, catalog_artifact.EXECUTABLE, pie, image_options, roots, root_count, out);
}

# links images and objects into an executable at destination the way
# link_mixed does, handing back the symbol table and the unwound functions the
# writer was given, whatever the object format
#[testing]
pub fun link_observed(s: *session.Session, diags: *diagnostic.DiagnosticStore, tgt: *lang_target.Binding,
    images: *target_of.ObjectImage, image_count: u32, inputs: *target_of.ObjectInput, input_count: u32,
    destination: str, name: *u8, image_options: target_of.ImageOptions, out: *LinkedImage) err[fail.Fail] {
    if (s == nil || diags == nil || tgt == nil || out == nil || destination == nil) { ret err[fail.Fail].err{fail.message("incomplete observed link")}; }
    if (tgt == nil)                                                                 { ret err[fail.Fail].err{fail.message("target: nil resolved target")}; }
    if (out.bytes != nil || out.symbols != nil || out.functions != nil) {
        ret err[fail.Fail].err{fail.message("capture target is not empty")};
    }
    val er: res[intern.StrId, A.Error] = intern.add(?s.interner, tgt.os.entry_symbol);
    if (sel er.err) { ret err[fail.Fail].err{fail.refused(er.err)}; }
    var ext_count: u32                    = 0;
    var ext:       *target_of.ObjectImage = nil;
    if (inputs != nil && input_count > 0) {
        val read_r: res[*target_of.ObjectImage, fail.Fail] =
            read_objects(s, tgt, inputs, input_count, images, image_count, er.ok, ?ext_count);
        if (sel read_r.err) { ret err[fail.Fail].err{read_r.err}; }
        ext = read_r.ok;
    }
    fin { free_modules(s.alloc, ext, ext_count); }
    val total_r: res[u32, fail.Fail] = combined_image_count(image_count, ext_count);
    if (sel total_r.err) { ret err[fail.Fail].err{total_r.err}; }
    val total: u32 = total_r.ok;
    if (total == 0) { ret err[fail.Fail].err{fail.message("no input objects")}; }
    val cr: res[*target_of.ObjectImage, A.Error] = A.allocate[target_of.ObjectImage](s.alloc, total::usize);
    if (sel cr.err) { ret err[fail.Fail].err{fail.refused(cr.err)}; }
    val combined: *target_of.ObjectImage = cr.ok;
    fin { A.deallocate[target_of.ObjectImage](s.alloc, combined, total::usize); }
    var i: u32 = 0;
    for (i < image_count) {
        combined[i] = images[i];
        i           = i + 1;
    }
    i = 0;
    for (i < ext_count) {
        combined[image_count + i] = ext[i];
        i                         = i + 1;
    }
    ret link_modules(s, diags, tgt, combined, total, nil::*target_of.DynLib, 0, destination, name, catalog_artifact.EXECUTABLE, false,
        image_options, nil::*intern.StrId, 0, out);
}

pub fun link_images(s: *session.Session, diags: *diagnostic.DiagnosticStore, tgt: *lang_target.Binding, images: *target_of.ObjectImage,
    image_count: u32, dynlibs: *target_of.DynLib, dynlib_count: u32,
    destination: str, name: *u8, mode: catalog_artifact.Kind, pie: bool,
    image_options: target_of.ImageOptions) err[fail.Fail] {
    if (s == nil)                          { ret err[fail.Fail].err{fail.message("nil session")}; }
    if (diags == nil)                      { ret err[fail.Fail].err{fail.message("nil diagnostic store")}; }
    if (tgt == nil)                        { ret err[fail.Fail].err{fail.message("nil target")}; }
    if (tgt == nil)                        { ret err[fail.Fail].err{fail.message("target: nil resolved target")}; }
    if (tgt.of == nil)                     { ret err[fail.Fail].err{fail.message("target has no object-format vtable")}; }
    if (tgt.os == nil)                     { ret err[fail.Fail].err{fail.message("target has no OS vtable")}; }
    if (!catalog_artifact.is_linked(mode)) { ret err[fail.Fail].err{fail.message("the linker does not produce this artifact kind")}; }
    if (images == nil || image_count == 0) {
        ret err[fail.Fail].err{fail.message("no input objects")};
    }
    ret link_modules_nocapture(s, diags, tgt, images, image_count, dynlibs,
        dynlib_count, destination, name, mode, pie, image_options);
}

pub fun link_mixed(s: *session.Session, diags: *diagnostic.DiagnosticStore, tgt: *lang_target.Binding,
    images: *target_of.ObjectImage, image_count: u32,
    inputs: *target_of.ObjectInput, input_count: u32,
    dynlibs: *target_of.DynLib, dynlib_count: u32,
    destination: str, name: *u8, mode: catalog_artifact.Kind, pie: bool,
    image_options: target_of.ImageOptions) err[fail.Fail] {
    if (s == nil)                          { ret err[fail.Fail].err{fail.message("nil session")}; }
    if (diags == nil)                      { ret err[fail.Fail].err{fail.message("nil diagnostic store")}; }
    if (tgt == nil)                        { ret err[fail.Fail].err{fail.message("nil target")}; }
    if (tgt == nil)                        { ret err[fail.Fail].err{fail.message("target: nil resolved target")}; }
    if (tgt.of == nil)                     { ret err[fail.Fail].err{fail.message("target has no object-format vtable")}; }
    if (tgt.os == nil)                     { ret err[fail.Fail].err{fail.message("target has no OS vtable")}; }
    if (!catalog_artifact.is_linked(mode)) { ret err[fail.Fail].err{fail.message("the linker does not produce this artifact kind")}; }
    if (images == nil || image_count == 0) {
        ret err[fail.Fail].err{fail.message("no input objects")};
    }

    val alloc: *A.Allocator = s.alloc;

    var required: intern.StrId = intern.STR_NIL;
    if (mode == catalog_artifact.EXECUTABLE) {
        val er: res[intern.StrId, A.Error] = intern.add(?s.interner, tgt.os.entry_symbol);
        if (sel er.err) {
            ret err[fail.Fail].err{fail.refused(er.err)};
        }
        required = er.ok;
    }

    var ext_count: u32                    = 0;
    var ext:       *target_of.ObjectImage = nil;
    if (inputs != nil && input_count > 0) {
        val read_r: res[*target_of.ObjectImage, fail.Fail] =
            read_objects(s, tgt, inputs, input_count, images, image_count,
            required, ?ext_count);
        if (sel read_r.err) {
            ret err[fail.Fail].err{read_r.err};
        }
        ext = read_r.ok;
    }
    fin { free_modules(alloc, ext, ext_count); }

    val total_r: res[u32, fail.Fail] = combined_image_count(image_count, ext_count);
    if (sel total_r.err) { ret err[fail.Fail].err{total_r.err}; }
    val total: u32                                  = total_r.ok;
    val cr:    res[*target_of.ObjectImage, A.Error] = A.allocate[target_of.ObjectImage](alloc, total::usize);
    if (sel cr.err) { ret err[fail.Fail].err{fail.refused(cr.err)}; }
    val combined: *target_of.ObjectImage = cr.ok;
    fin { A.deallocate[target_of.ObjectImage](alloc, combined, total::usize); }

    var i: u32 = 0;
    for (i < image_count) {
        combined[i] = images[i];
        i           = i + 1;
    }
    var j: u32 = 0;
    for (j < ext_count) {
        combined[image_count + j] = ext[j];
        j                         = j + 1;
    }

    ret link_modules_nocapture(s, diags, tgt, combined, total, dynlibs, dynlib_count,
        destination, name, mode, pie, image_options);
}

fun image_machine_flags(s: *session.Session, tgt: *lang_target.Binding,
    modules: *target_of.ObjectImage, module_count: u32) res[u32, fail.Fail] {
    if (!target_of.declares_machine_flags(tgt.of, tgt.object.arch_id)) { ret res[u32, fail.Fail].ok{0}; }

    val abi_mask: u32 = target_of.machine_flags(tgt.of, tgt.object.arch_id, 0, false)
        | target_of.machine_flags(tgt.of, tgt.object.arch_id, 32, false)
        | target_of.machine_flags(tgt.of, tgt.object.arch_id, 64, false);
    val abi_bits: u32 = target_of.machine_flags(tgt.of, tgt.object.arch_id, tgt.abi.float_arg_bits, false) & abi_mask;

    var feature_bits: u32 = 0;
    var i:            u32 = 0;
    for (i < module_count) {
        val got: u32 = modules[i].machine_flags;
        if ((got & abi_mask) != abi_bits) {
            ret res[u32, fail.Fail].err{fail.user_of(diagnostic_kind.LINK_ABI_MISMATCH, machine_flags_mismatch_message(s, tgt, ?modules[i],
                got & abi_mask, abi_bits))};
        }
        feature_bits = feature_bits | (got & ~abi_mask);
        i            = i + 1;
    }
    ret res[u32, fail.Fail].ok{abi_bits | feature_bits};
}

fun image_attributes(s: *session.Session, tgt: *lang_target.Binding, modules: *target_of.ObjectImage,
    module_count: u32, out_len: *u32) res[*u8, fail.Fail] {
    @out_len = 0;
    if (!target_of.declares_attributes(tgt.of, tgt.object.arch_id)) { ret res[*u8, fail.Fail].ok{nil}; }

    var acc:     *u8 = nil;
    var acc_len: u32 = 0;
    var i:       u32 = 0;
    for (i < module_count) {
        if (modules[i].attributes == nil || modules[i].attributes_len == 0) {
            i = i + 1;
            cnt;
        }
        var next_len: u32                 = 0;
        val mr:       res[*u8, fail.Fail] = target_of.attributes_merge(tgt.of, tgt.object.arch_id, s.alloc, acc, acc_len,
            modules[i].attributes,
            modules[i].attributes_len, ?next_len);
        if (sel mr.err) {
            if (acc != nil && acc_len > 0) { A.deallocate[u8](s.alloc, acc, acc_len::usize); }
            ret res[*u8, fail.Fail].err{input_refusal(s, ?modules[i], mr.err)};
        }
        val merged: *u8 = mr.ok;
        if (acc != nil && acc_len > 0 && acc != merged) { A.deallocate[u8](s.alloc, acc, acc_len::usize); }
        acc     = merged;
        acc_len = next_len;
        i       = i + 1;
    }
    @out_len = acc_len;
    ret res[*u8, fail.Fail].ok{acc};
}

fun link_modules_nocapture(s: *session.Session, diags: *diagnostic.DiagnosticStore, tgt: *lang_target.Binding, modules: *target_of.ObjectImage,
    module_count: u32,
    dynlibs: *target_of.DynLib, dynlib_count: u32,
    destination: str, name: *u8, mode: catalog_artifact.Kind, pie_opt_in: bool,
    image_options: target_of.ImageOptions) err[fail.Fail] {
    ret link_modules(s, diags, tgt, modules, module_count, dynlibs, dynlib_count,
        destination, name, mode, pie_opt_in, image_options, nil::*intern.StrId, 0, nil::*LinkedImage);
}

# the synthetic inputs a link appends, in order: the runtime-needs cell first,
# so the start code's reference resolves and dead-strips like any definition,
# the objc selector stubs ahead of common storage, and the local import
# pointers last, over the atom plan of everything before them
val SYNTHESIZER_COUNT: u32 = 4;

val SYNTHESIZERS: [4]Synthesizer = [4]Synthesizer{
    synthesize_runtime_needs,
    synthesize_objc_stubs,
    synthesize_common_storage,
    synthesize_local_imports,
};

fun link_modules(s: *session.Session, diags: *diagnostic.DiagnosticStore, tgt: *lang_target.Binding, modules: *target_of.ObjectImage,
    module_count: u32,
    dynlibs: *target_of.DynLib, dynlib_count: u32,
    destination: str, name: *u8, mode: catalog_artifact.Kind, pie_opt_in: bool,
    image_options: target_of.ImageOptions, root_names: *intern.StrId, root_count: u32,
    capture: *LinkedImage) err[fail.Fail] {
    if (!catalog_artifact.is_linked(mode)) { ret err[fail.Fail].err{fail.message("the linker does not produce this artifact kind")}; }
    if (module_count == 0)                 { ret err[fail.Fail].err{fail.message("no input objects")}; }
    val inputs_valid: err[fail.Fail] = validate_link_inputs(modules, module_count);
    if (sel inputs_valid.err) { ret inputs_valid; }

    var st: LinkState;
    link_state_init(?st, s, tgt, mode, modules, module_count, image_options);
    fin { link_state_dnit(?st); }
    st.pie = (mode == catalog_artifact.EXECUTABLE) && (target_requires_pie(tgt) || pie_opt_in);

    val rooted: err[fail.Fail] = plan_roots(?st, name, root_names, root_count);
    if (sel rooted.err) { ret rooted; }
    val settled: err[fail.Fail] = settle_inputs(?st);
    if (sel settled.err)                  { ret settled; }
    if (mode == catalog_artifact.OBJECTS) { ret emit_relocatable(?st, destination); }

    var phase: err[fail.Fail] = synthesize_inputs(?st);
    if (!sel phase.err)                  { phase = plan_layout(?st, diags); }
    if (!sel phase.err)                  { phase = resolve_symbols(?st); }
    if (!sel phase.err)                  { phase = reserve_tables(?st, dynlibs, dynlib_count); }
    if (!sel phase.err)                  { phase = build_image(?st); }
    if (!sel phase.err)                  { phase = patch(?st); }
    if (sel phase.err)                   { ret phase; }
    if (mode == catalog_artifact.SHARED) { ret emit_shared_object(?st, destination); }
    ret emit_executable(?st, destination, name, capture);
}

# a final image that is position-independent: a pie, or a shared library
fun position_independent(st: *LinkState) bool {
    ret st.pie || st.mode == catalog_artifact.SHARED;
}

# the export surface and the roots link GC keeps, from the caller's inputs
fun plan_roots(st: *LinkState, name: *u8, root_names: *intern.StrId, root_count: u32) err[fail.Fail] {
    val s:         *session.Session              = st.s;
    val surface_r: res[ExportSurface, fail.Fail] = export_surface_build(s, st.inputs.images, st.inputs.count);
    if (sel surface_r.err) { ret err[fail.Fail].err{surface_r.err}; }
    export_surface_free(?st.surface);
    st.surface          = surface_r.ok;
    st.roots.exports    = st.mode == catalog_artifact.SHARED;
    st.roots.names      = root_names;
    st.roots.name_count = root_count;
    # a final image whose format builds unwind tables carries the foreign frame
    # descriptions into them (claim_unwind_inputs) and rebases what it keeps
    st.roots.carries_frames = st.tgt.of != nil && st.tgt.of.unwind_shape != nil;

    # a shared library with no export surface is callable by nobody, and link GC
    # would leave it an image with nothing in it. refused here, before the plan,
    # so the diagnostic names the rule and not the empty image that follows
    if (st.mode == catalog_artifact.SHARED && !any_exported_symbol(st.inputs.images, st.inputs.count, ?st.surface)) {
        ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_NO_EXPORTS, fail.format_intern(?s.interner, s.alloc,
            "shared library '{}' exports nothing: a shared library needs at least one `pub` declaration in the project, or a `fwd` re-export of one",
            shared_product_name(name)))};
    }
    if (st.mode == catalog_artifact.EXECUTABLE) {
        val er: res[intern.StrId, A.Error] = intern.add(?s.interner, st.tgt.os.entry_symbol);
        if (sel er.err) { ret err[fail.Fail].err{fail.refused(er.err)}; }
        st.roots.entry = er.ok;
    }
    ret err[fail.Fail].ok{};
}

# the caller's inputs in the target's relocation form, their attributes and
# machine flags checked and settled into the image's
fun settle_inputs(st: *LinkState) err[fail.Fail] {
    val s:            *session.Session       = st.s;
    val tgt:          *lang_target.Binding   = st.tgt;
    val modules:      *target_of.ObjectImage = st.inputs.images;
    val module_count: u32                    = st.inputs.count;
    var i:            u32                    = 0;
    if (st.mode != catalog_artifact.OBJECTS) {
        for (i < module_count) {
            val nr: err[fail.Fail] = of_reloc.normalize_image(tgt.isa, s.alloc, ?modules[i]);
            if (sel nr.err) { ret nr; }
            i = i + 1;
        }
    }
    i = 0;
    for (i < module_count) {
        val input_attributes_valid: err[fail.Fail] = target_of.attributes_validate(
            tgt.of, tgt.object.arch_id, tgt.target.model.gpr_width * 8, modules[i].attributes, modules[i].attributes_len,
            modules[i].machine_flags);
        if (sel input_attributes_valid.err) {
            ret err[fail.Fail].err{input_refusal(s, ?modules[i], input_attributes_valid.err)};
        }
        i = i + 1;
    }
    val mf_r: res[u32, fail.Fail] = image_machine_flags(s, tgt, modules, module_count);
    if (sel mf_r.err) { ret err[fail.Fail].err{mf_r.err}; }
    st.opts.machine_flags = mf_r.ok;
    var attr_len: u32                 = 0;
    val at_r:     res[*u8, fail.Fail] = image_attributes(s, tgt, modules, module_count, ?attr_len);
    if (sel at_r.err) { ret err[fail.Fail].err{at_r.err}; }
    st.opts.attributes     = at_r.ok;
    st.opts.attributes_len = attr_len;
    val attributes_valid: err[fail.Fail] = target_of.attributes_validate(tgt.of, tgt.object.arch_id, tgt.target.model.gpr_width * 8,
        st.opts.attributes, attr_len, st.opts.machine_flags);
    if (sel attributes_valid.err)            { ret attributes_valid; }
    if (st.mode == catalog_artifact.OBJECTS) { ret err[fail.Fail].ok{}; }

    i = 0;
    for (i < module_count) {
        if (modules[i].indirect_count != 0) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "native indirect symbol sections require relocatable output")};
        }
        i = i + 1;
    }
    st.opts.mapped_by_loader = tgt.os.mapped_by_loader;
    st.opts.stack_reserve    = tgt.target.stack_reserve;
    st.opts.stack_commit     = tgt.target.stack_commit;
    ret err[fail.Fail].ok{};
}

fun emit_relocatable(st: *LinkState, destination: str) err[fail.Fail] {
    val combined: res[target_of.ObjectImage, fail.Fail] = relocatable.combine(
        st.s.alloc, ?st.s.interner, st.inputs.images, st.inputs.count, st.opts.machine_flags,
        st.opts.attributes, st.opts.attributes_len);
    if (sel combined.err) { ret err[fail.Fail].err{combined.err}; }
    var image: target_of.ObjectImage = combined.ok;
    fin { target_of.object_image_dnit(?image); }
    ret obj.emit_image(?image, st.tgt, destination);
}

# appends each synthetic input the link needs, in table order, so every later
# phase reads them as ordinary inputs
fun synthesize_inputs(st: *LinkState) err[fail.Fail] {
    var i: u32 = 0;
    for (i < SYNTHESIZER_COUNT) {
        var img:  target_of.ObjectImage;
        val made: res[bool, fail.Fail] = SYNTHESIZERS[i](?st.synth, ?st.inputs, ?img);
        if (sel made.err) { ret err[fail.Fail].err{made.err}; }
        if (made.ok) {
            val appended: err[fail.Fail] = input_set_append(st.s.alloc, ?st.inputs, ?img);
            if (sel appended.err) {
                target_of.object_image_dnit(?img);
                ret appended;
            }
        }
        i = i + 1;
    }
    st.resolution.modules      = st.inputs.images;
    st.resolution.module_count = st.inputs.count;
    st.resolution.out_img.name = image_name(st.inputs.images, st.inputs.count);
    ret err[fail.Fail].ok{};
}

# where each input section lands: the merged sections, the atoms that survive,
# the first layout and the symbols it places
fun plan_layout(st: *LinkState, diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    val s:            *session.Session       = st.s;
    val tgt:          *lang_target.Binding   = st.tgt;
    val alloc:        *A.Allocator           = s.alloc;
    val rs:           *Resolution            = ?st.resolution;
    val modules:      *target_of.ObjectImage = rs.modules;
    val module_count: u32                    = rs.module_count;

    val dn_r: err[fail.Fail] = discover_debug_names(alloc, modules, module_count, ?st.debug_names, ?st.debug_count);
    if (sel dn_r.err) { ret dn_r; }
    var dm: u32 = 0;
    for (dm < module_count) {
        if (!module_debug_is_linkable(modules, dm)) {
            val warned: err[fail.Fail] = warn_debug_dropped(s, diags, modules[dm].name);
            if (sel warned.err) { ret warned; }
        }
        dm = dm + 1;
    }

    val sm_r: res[StrMerge, fail.Fail] = build_str_merge(s, modules, module_count, true);
    if (sel sm_r.err) { ret err[fail.Fail].err{sm_r.err}; }
    rs.strm = sm_r.ok;

    val merged_count_r: res[u32, fail.Fail] = merged_section_count(st.debug_count);
    if (sel merged_count_r.err) { ret err[fail.Fail].err{merged_count_r.err}; }
    val mrg_r: res[*MergedSection, A.Error] = A.zallocate[MergedSection](alloc, merged_count_r.ok::usize);
    if (sel mrg_r.err) { ret err[fail.Fail].err{fail.refused(mrg_r.err)}; }
    rs.merged       = mrg_r.ok;
    rs.merged_count = merged_count_r.ok;
    init_merged(rs.merged, st.debug_names, st.debug_count);

    val sym_total_r: res[u32, fail.Fail] = total_symbols(modules, module_count);
    if (sel sym_total_r.err) { ret err[fail.Fail].err{sym_total_r.err}; }
    val sec_total_r: res[u32, fail.Fail] = total_sections(modules, module_count);
    if (sel sec_total_r.err) { ret err[fail.Fail].err{sec_total_r.err}; }
    if (sec_total_r.ok > 0) {
        val pr: res[*Placement, A.Error] = A.zallocate[Placement](alloc, sec_total_r.ok::usize);
        if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
        rs.placements = pr.ok;
        rs.sec_total  = sec_total_r.ok;
    }
    val br: res[*u32, A.Error] = A.zallocate[u32](alloc, module_count::usize);
    if (sel br.err) { ret err[fail.Fail].err{fail.refused(br.err)}; }
    rs.sec_base = br.ok;
    val syb_r: res[*u32, A.Error] = A.zallocate[u32](alloc, module_count::usize);
    if (sel syb_r.err) { ret err[fail.Fail].err{fail.refused(syb_r.err)}; }
    st.sym_base = syb_r.ok;
    val fsb_r: err[fail.Fail] = fill_symbol_bases(modules, module_count, st.sym_base);
    if (sel fsb_r.err) { ret fsb_r; }
    if (sym_total_r.ok > 0) {
        val syo_r: res[*u32, A.Error] = A.zallocate[u32](alloc, sym_total_r.ok::usize);
        if (sel syo_r.err) { ret err[fail.Fail].err{fail.refused(syo_r.err)}; }
        st.sym_out   = syo_r.ok;
        st.sym_total = sym_total_r.ok;
    }

    # a synthesizer that needed the atom plan already built it, over every
    # input but the ones appended after it
    var atom_r: err[fail.Fail];
    if (context_take_atoms(?st.synth, ?rs.atoms)) {
        atom_r = fill_section_bases(modules, module_count, rs.sec_base);
    }
    or {
        atom_r = build_atom_plan(s, modules, module_count, rs.sec_base,
            rs.sec_total, true, ?st.roots, tgt.isa, ?rs.atoms);
    }
    if (sel atom_r.err) { ret atom_r; }

    claim_unwind_inputs(tgt, true, modules, module_count, rs.sec_base, rs.placements);
    val acc_r: err[fail.Fail] =
        accumulate_sections(s, modules, module_count, rs.merged, st.debug_names, st.debug_count,
        rs.placements, rs.sec_base, ?rs.strm, ?rs.atoms, ?rs.groups);
    if (sel acc_r.err) { ret acc_r; }

    if (tgt.of.produces_image && st.mode == catalog_artifact.EXECUTABLE) {
        val ei_r: res[intern.StrId, A.Error] = intern.add(?s.interner, tgt.os.entry_symbol);
        if (sel ei_r.err) { ret err[fail.Fail].err{fail.refused(ei_r.err)}; }
        val reorder_r: err[fail.Fail] =
            reorder_flat_entry_first(modules, module_count, rs.merged, rs.placements, rs.sec_base,
            ?rs.atoms, ei_r.ok);
        if (sel reorder_r.err) { ret reorder_r; }
    }

    val overlap_r: err[fail.Fail] =
        validate_no_contribution_overlap(s, modules, module_count, rs.sec_base, rs.placements, rs.sec_total);
    if (sel overlap_r.err) { ret overlap_r; }

    val reserve_r: res[u64, fail.Fail] = header_reserve_bytes(tgt, position_independent(st), nil::*target_of.HeaderShape);
    if (sel reserve_r.err) { ret err[fail.Fail].err{reserve_r.err}; }
    st.header_reserve = reserve_r.ok;
    ret relayout(st);
}

# the entry an executable needs, refused as soon as the symbols are known and
# before any relocation is applied, so the diagnostic names the missing entry
# and not a relocation its absence leaves unresolvable; then the local GOT
fun resolve_symbols(st: *LinkState) err[fail.Fail] {
    val rs: *Resolution = ?st.resolution;
    if (st.mode == catalog_artifact.EXECUTABLE) {
        val entry_r: res[u64, fail.Fail] = entry_vaddr(st.s, st.tgt, ?rs.sym_locs);
        if (sel entry_r.err) { ret err[fail.Fail].err{entry_r.err}; }
    }
    val gp_r: err[fail.Fail] = build_local_got_plan(
        st.s, st.tgt.isa, rs.modules, rs.module_count, ?rs.sym_locs, rs.sec_base, ?rs.atoms,
        rs.merged, ?rs.groups, ?st.local_got);
    if (sel gp_r.err)           { ret gp_r; }
    if (st.local_got.count > 0) { ret relayout(st); }
    ret err[fail.Fail].ok{};
}

# the tables the image reserves before it takes its bytes: the dynamic imports'
# call stubs and GOT, so they are part of the code's layout rather than an
# afterthought past the data, the islands holding the thunks a branch the
# code's size puts out of reach goes through, and the unwind tables
fun reserve_tables(st: *LinkState, dynlibs: *target_of.DynLib, dynlib_count: u32) err[fail.Fail] {
    val s:            *session.Session       = st.s;
    val tgt:          *lang_target.Binding   = st.tgt;
    val rs:           *Resolution            = ?st.resolution;
    val modules:      *target_of.ObjectImage = rs.modules;
    val module_count: u32                    = rs.module_count;
    val executable:   bool                   = st.mode == catalog_artifact.EXECUTABLE;

    var dynamic: bool = executable && (dynlib_count > 0 || st.pie);
    if (executable && !dynamic) {
        val declared_r: res[bool, fail.Fail] = has_unresolved_declared_imports(
            modules, module_count, ?rs.sym_locs, rs.sec_base, ?rs.atoms);
        if (sel declared_r.err) { ret err[fail.Fail].err{declared_r.err}; }
        dynamic = declared_r.ok;
    }
    if (executable && !dynamic) {
        val unresolved_r: res[bool, fail.Fail] = has_unresolved_attributed_imports(
            s, modules, module_count, dynlibs, dynlib_count, ?rs.sym_locs,
            tgt.of.import_address_prefix, rs.sec_base, ?rs.atoms);
        if (sel unresolved_r.err) { ret err[fail.Fail].err{unresolved_r.err}; }
        dynamic = unresolved_r.ok;
    }
    st.dynamic = dynamic;

    val loader_r: err[fail.Fail] = loader_check(s, tgt, st.mode, st.pie, dynamic);
    if (sel loader_r.err) { ret loader_r; }

    rs.dyn.info.pie = position_independent(st);
    if (dynamic) {
        val dr: err[fail.Fail] =
            build_dynamic_info(s, tgt, ?rs.dyn, modules, module_count, ?rs.sym_locs,
            dynlibs, dynlib_count, rs.sec_base, ?rs.atoms);
        if (sel dr.err) { ret dr; }
        val stubs_r: err[fail.Fail] = reserve_call_stubs(s, tgt, ?rs.dyn, rs.merged, ?rs.groups);
        if (sel stubs_r.err) { ret stubs_r; }
        val got_r: err[fail.Fail] = reserve_import_got(s, tgt, ?rs.dyn, rs.merged, ?rs.groups);
        if (sel got_r.err) { ret got_r; }
    }

    val th_r: err[fail.Fail] = plan_thunks(s, ?st.thunks, rs);
    if (sel th_r.err) { ret th_r; }

    val uw_r: res[bool, fail.Fail] = reserve_unwind_tables(s, tgt, modules, module_count, rs.sec_base, ?rs.atoms, rs.merged, ?rs.groups,
        rs.placements, ?st.unwind);
    if (sel uw_r.err) { ret err[fail.Fail].err{uw_r.err}; }
    st.unwind_reserved = uw_r.ok;
    ret err[fail.Fail].ok{};
}

# the merged image, laid out again when its header grew or a reserved table
# moved everything after it
fun build_image(st: *LinkState) err[fail.Fail] {
    val s:  *session.Session = st.s;
    val rs: *Resolution      = ?st.resolution;

    val mto_r: res[*u32, A.Error] = A.zallocate[u32](s.alloc, rs.merged_count::usize);
    if (sel mto_r.err) { ret err[fail.Fail].err{fail.refused(mto_r.err)}; }
    rs.merged_to_out = mto_r.ok;

    val build_r: err[fail.Fail] =
        build_merged_image(s, ?rs.out_img, rs.modules, rs.module_count, rs.merged, rs.merged_count,
        rs.placements, rs.sec_base, rs.merged_to_out, st.sym_base, st.sym_out, ?rs.strm, ?rs.atoms);
    if (sel build_r.err) { ret build_r; }
    val built_valid: err[fail.Fail] = target_of.validate_owned_object(?rs.out_img);
    if (sel built_valid.err) { ret err[fail.Fail].err{fail.as_internal(built_valid.err)}; }

    var shape: target_of.HeaderShape;
    measure_header_shape(s, ?rs.out_img, rs.merged, ?rs.groups, ?rs.dyn, position_independent(st), ?shape);
    val want_r: res[u64, fail.Fail] = header_reserve_bytes(st.tgt, position_independent(st), ?shape);
    if (sel want_r.err) { ret err[fail.Fail].err{want_r.err}; }
    val want: u64 = want_r.ok;
    if (want > st.header_reserve || rs.dyn.info.stubs.size > 0 || rs.dyn.info.got.size > 0 || st.unwind_reserved
        || thunks_placed(?st.thunks)) {
        if (want > st.header_reserve) { st.header_reserve = want; }
        val relaid: err[fail.Fail] = relayout(st);
        if (sel relaid.err) { ret relaid; }
    }
    place_call_stubs(?rs.dyn, rs.merged);
    place_import_got(?rs.dyn, rs.merged);
    ret err[fail.Fail].ok{};
}

# every address patched into the image once the layout is final, and the
# foreign unwind entries resolved against it
fun patch(st: *LinkState) err[fail.Fail] {
    val rs:      *Resolution    = ?st.resolution;
    val thunked: err[fail.Fail] = write_thunks(st.s, ?st.thunks, rs);
    if (sel thunked.err) { ret thunked; }
    val patched: err[fail.Fail] = patch_relocations(st.s, rs, ?st.local_got, ?st.thunks);
    if (sel patched.err) { ret patched; }
    val natives_r: res[*target_of.NativeUnwind, fail.Fail] = resolve_native_unwind(st.s, ?st.unwind, rs, ?st.local_got, ?st.native_count);
    if (sel natives_r.err) { ret err[fail.Fail].err{natives_r.err}; }
    st.natives = natives_r.ok;
    ret err[fail.Fail].ok{};
}

fun emit_executable(st: *LinkState, destination: str, name: *u8, capture: *LinkedImage) err[fail.Fail] {
    val s:   *session.Session     = st.s;
    val tgt: *lang_target.Binding = st.tgt;
    val rs:  *Resolution          = ?st.resolution;
    var dyn: *DynState            = nil;
    if (st.dynamic) { dyn = ?rs.dyn; }
    if (capture != nil && destination == nil && tgt.of.emit_exec_image == nil) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "this object format cannot hand back a linked image")};
    }
    if (capture == nil && dyn == nil && tgt.of.emit_exec == nil) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "object format cannot write executables")};
    }
    if (dyn != nil && tgt.of.emit_dyn_exec == nil) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "object format cannot write dynamically-linked executables")};
    }
    if (tgt.os == nil) {
        ret err[fail.Fail].err{fail.message("target has no operating-system vtable")};
    }

    val alloc: *A.Allocator = s.alloc;

    val er: res[u64, fail.Fail] = entry_vaddr(s, tgt, ?rs.sym_locs);
    if (sel er.err) { ret err[fail.Fail].err{er.err}; }
    val entry: u64 = er.ok;

    var seg_count: u32                                    = 0;
    val sr:        res[*target_of.LoadSegment, fail.Fail] = build_load_segments(alloc, ?rs.out_img, rs.merged, ?rs.groups, ?seg_count);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val segs: *target_of.LoadSegment = sr.ok;
    fin { free_load_segments(alloc, segs, seg_count); }

    # a capture keeps the symbol table and the unwound functions the writer took
    var kept: bool = false;

    var func_count: u32                                     = 0;
    val fr:         res[*target_of.ExecFunction, fail.Fail] = build_exec_functions(alloc, ?rs.out_img, segs, seg_count, st.natives,
        st.native_count, ?func_count);
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    val funcs: *target_of.ExecFunction = fr.ok;
    fin {
        if (!kept && funcs != nil && func_count > 0) { A.deallocate[target_of.ExecFunction](alloc, funcs, func_count::usize); }
    }

    var exc_count: u32                                = 0;
    val xr:        res[*target_of.Section, fail.Fail] = collect_exception_sections(alloc, ?rs.out_img, ?exc_count);
    if (sel xr.err) { ret err[fail.Fail].err{xr.err}; }
    val exc: *target_of.Section = xr.ok;
    fin {
        if (exc != nil && exc_count > 0) { A.deallocate[target_of.Section](alloc, exc, exc_count::usize); }
    }

    var dbg_count: u32                                = 0;
    val dr:        res[*target_of.Section, fail.Fail] = collect_debug_sections(alloc, ?rs.out_img, ?dbg_count);
    if (sel dr.err) { ret err[fail.Fail].err{dr.err}; }
    val dbg: *target_of.Section = dr.ok;
    fin {
        if (dbg != nil && dbg_count > 0) { A.deallocate[target_of.Section](alloc, dbg, dbg_count::usize); }
    }

    var symtab_count: u32                                    = 0;
    val ser:          res[*target_of.SymtabEntry, fail.Fail] = build_symtab_entries(alloc, ?rs.out_img, segs, seg_count, ?st.surface,
        ?symtab_count);
    if (sel ser.err) { ret err[fail.Fail].err{ser.err}; }
    val symtab: *target_of.SymtabEntry = ser.ok;
    fin {
        if (!kept && symtab != nil && symtab_count > 0) { A.deallocate[target_of.SymtabEntry](alloc, symtab, symtab_count::usize); }
    }

    var emit_r: err[fail.Fail] = err[fail.Fail].ok{};
    if (capture != nil && destination == nil) {
        if (tgt.of.emit_exec_image == nil) {
            emit_r = err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "this object format cannot hand back a linked image")};
        }
        or {
            var cap_base: u64                 = 0;
            var cap_size: usize               = 0;
            val cb:       res[*u8, fail.Fail] =
                tgt.of.emit_exec_image(alloc, segs, seg_count, entry, ?cap_base, ?cap_size);
            if (sel cb.err) { emit_r = err[fail.Fail].err{cb.err}; }
            or (sel cb.ok) {
                capture.bytes = cb.ok;
                capture.len   = cap_size;
                capture.base  = cap_base;
            }
        }
    }
    or (dyn == nil) {
        emit_r = tgt.of.emit_exec(alloc, ?s.interner, ?tgt.object, segs, seg_count,
            os_page_size(tgt), os_base_addr(tgt), entry,
            funcs, func_count,
            exc, exc_count, dbg, dbg_count,
            symtab, symtab_count, destination, name, st.opts);
    }
    or {
        emit_r = tgt.of.emit_dyn_exec(alloc, ?s.interner, ?tgt.object, segs, seg_count,
            os_page_size(tgt), os_base_addr(tgt), entry,
            funcs, func_count, ?dyn.info, dyn.fixups, dyn.fixup_count,
            exc, exc_count, dbg, dbg_count,
            symtab, symtab_count, destination, name, st.opts);
    }

    if (capture != nil && sel emit_r.ok) {
        capture.symbols        = symtab;
        capture.symbol_count   = symtab_count;
        capture.functions      = funcs;
        capture.function_count = func_count;
        kept                   = true;
    }
    ret emit_r;
}

fun emit_shared_object(st: *LinkState, destination: str) err[fail.Fail] {
    val s:   *session.Session     = st.s;
    val tgt: *lang_target.Binding = st.tgt;
    val rs:  *Resolution          = ?st.resolution;
    if (tgt.of.emit_shared == nil) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "object format cannot write shared libraries")};
    }
    if (tgt.os == nil) {
        ret err[fail.Fail].err{fail.message("target has no operating-system vtable")};
    }

    val alloc: *A.Allocator = s.alloc;

    var seg_count: u32                                    = 0;
    val sr:        res[*target_of.LoadSegment, fail.Fail] = build_load_segments(alloc, ?rs.out_img, rs.merged, ?rs.groups, ?seg_count);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val segs: *target_of.LoadSegment = sr.ok;
    fin { free_load_segments(alloc, segs, seg_count); }

    var export_count: u32                                  = 0;
    val xr:           res[*target_of.ExportSym, fail.Fail] = collect_exports(s, rs.modules, rs.module_count, ?rs.sym_locs, ?st.surface,
        ?export_count);
    if (sel xr.err) { ret err[fail.Fail].err{xr.err}; }
    val exports: *target_of.ExportSym = xr.ok;
    fin {
        if (exports != nil && export_count > 0) { A.deallocate[target_of.ExportSym](alloc, exports, export_count::usize); }
    }

    var func_count: u32                                     = 0;
    val fr:         res[*target_of.ExecFunction, fail.Fail] = build_exec_functions(alloc, ?rs.out_img, segs, seg_count, st.natives,
        st.native_count, ?func_count);
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    val funcs: *target_of.ExecFunction = fr.ok;
    fin {
        if (funcs != nil && func_count > 0) { A.deallocate[target_of.ExecFunction](alloc, funcs, func_count::usize); }
    }

    var dbg_count: u32                                = 0;
    val dr:        res[*target_of.Section, fail.Fail] = collect_debug_sections(alloc, ?rs.out_img, ?dbg_count);
    if (sel dr.err) { ret err[fail.Fail].err{dr.err}; }
    val dbg: *target_of.Section = dr.ok;
    fin {
        if (dbg != nil && dbg_count > 0) { A.deallocate[target_of.Section](alloc, dbg, dbg_count::usize); }
    }

    var symtab_count: u32                                    = 0;
    val ser:          res[*target_of.SymtabEntry, fail.Fail] = build_symtab_entries(alloc, ?rs.out_img, segs, seg_count, ?st.surface,
        ?symtab_count);
    if (sel ser.err) { ret err[fail.Fail].err{ser.err}; }
    val symtab: *target_of.SymtabEntry = ser.ok;
    fin {
        if (symtab != nil && symtab_count > 0) { A.deallocate[target_of.SymtabEntry](alloc, symtab, symtab_count::usize); }
    }

    ret tgt.of.emit_shared(alloc, ?s.interner, ?tgt.object, segs, seg_count, os_page_size(tgt),
        funcs, func_count, exports, export_count, ?rs.dyn.info, dbg, dbg_count,
        symtab, symtab_count, destination, st.opts);
}

# the artifact's product name for a diagnostic, never a path: an absolute output
# path in a message a test compares is a path that differs per machine
fun shared_product_name(name: *u8) str {
    if (name == nil) { ret "shared library"; }
    ret name::str;
}

fun combined_image_count(image_count: u32, external_count: u32) res[u32, fail.Fail] {
    val total_r: res[u32, lang_checked.Cause] = add_u32_counts[ImageCountUnit](image_count, external_count);
    if (sel total_r.err) {
        ret res[u32, fail.Fail].err{fail.message("combined input object count overflow")};
    }
    ret res[u32, fail.Fail].ok{total_r.ok};
}

fun image_name(modules: *target_of.ObjectImage, module_count: u32) intern.StrId {
    if (module_count == 0) { ret intern.STR_NIL; }
    ret modules[0].name;
}

fun float_abi_phrase(tgt: *lang_target.Binding, abi_bits: u32) str {
    if (abi_bits == target_of.machine_flags(tgt.of, tgt.object.arch_id, 0, false))  { ret "soft-float"; }
    if (abi_bits == target_of.machine_flags(tgt.of, tgt.object.arch_id, 32, false)) { ret "single-precision hard-float"; }
    if (abi_bits == target_of.machine_flags(tgt.of, tgt.object.arch_id, 64, false)) { ret "double-precision hard-float"; }
    ret "an unrecognized float";
}

# a keyed refusal of one input, its text a predicate on the object, named for the user.
# an unkeyed failure is the linker's own and passes through as it is
fun input_refusal(s: *session.Session, img: *target_of.ObjectImage, f: fail.Fail) fail.Fail {
    if (!(sel f.user)) { ret f; }
    ret fail.user_of(f.user.kind, fail.format_intern(?s.interner, s.alloc, "object '{}' {}",
        name_text(s, img.name, "<input>"), f.user.text));
}

fun machine_flags_mismatch_message(s: *session.Session, tgt: *lang_target.Binding,
    img: *target_of.ObjectImage, got: u32, expected: u32) res[str, fail.Fail] {
    ret fail.format_intern(?s.interner, s.alloc,
        "object '{}' was built for a {} ABI, but this link targets '{}', so every float argument crossing that boundary would read back as garbage",
        name_text(s, img.name, "<input>"), float_abi_phrase(tgt, got), tgt.abi.name);
}

#[testing]
fun lt_marker_live_value(bytes: *u8, len: usize, marker: u8, value: *u64) bool {
    var at: usize = 0;
    for (at + 16 <= len) {
        var i: usize = 0;
        for (i < 8 && bytes[at + i] == marker) { i = i + 1; }
        if (i == 8) {
            var found: u64 = 0;
            i = 0;
            for (i < 8) {
                found = found | (bytes[at + 8 + i]::u64 << (i * 8));
                i     = i + 1;
            }
            if (found != 0 && found != DWARF_TOMBSTONE_ADDRESS) {
                @value = found;
                ret true;
            }
        }
        at = at + 1;
    }
    ret false;
}

#[testing]
fun lt_is_mach_shaped(modules: *target_of.ObjectImage, m: u32) bool {
    ret module_debug_is_linkable(modules, m);
}

#[testing]
fun lt_marker_present(bytes: *u8, len: usize, marker: u8) bool {
    var at: usize = 0;
    for (at + 8 <= len) {
        var i: usize = 0;
        for (i < 8 && bytes[at + i] == marker) { i = i + 1; }
        if (i == 8) { ret true; }
        at = at + 1;
    }
    ret false;
}

#[testing]
fun lt_foreign_dwarf_link(s: *session.Session, tgt: *lang_target.Binding,
    out_self: *bool, out_foreign: *bool) bool {
    val alloc:   *A.Allocator = s.alloc;
    val text:    intern.StrId = lt_name(s, ".text");
    val info:    intern.StrId = lt_name(s, ".debug_info");
    val line:    intern.StrId = lt_name(s, ".debug_line");
    val entry:   intern.StrId = lt_name(s, tgt.os.entry_symbol);
    val ffn:     intern.StrId = lt_name(s, "foreign_fn");
    val lanchor: intern.StrId = lt_name(s, "selfrel.debug_line");
    if (intern.str_is_nil(text) || intern.str_is_nil(info) || intern.str_is_nil(line)
        || intern.str_is_nil(entry) || intern.str_is_nil(ffn) || intern.str_is_nil(lanchor)) {
        ret false;
    }

    var self_text:    [16]u8;
    var foreign_text: [16]u8;
    var self_info:    [24]u8;
    var foreign_info: [24]u8;
    var self_line:    [8]u8;
    var foreign_line: [8]u8;
    var i:            u32 = 0;
    for (i < 16) {
        self_text[i]    = (0x10 + i)::u8;
        foreign_text[i] = (0x30 + i)::u8;
        i               = i + 1;
    }
    i = 0;
    for (i < 24) {
        self_info[i]    = 0;
        foreign_info[i] = 0;
        i               = i + 1;
    }
    i = 0;
    for (i < 8) {
        self_info[i]    = 0xAA;
        foreign_info[i] = 0xBB;
        self_line[i]    = 0x5A;
        foreign_line[i] = 0x5B;
        i               = i + 1;
    }

    var self_secs: [3]target_of.Section;
    self_secs[0].name  = text;
    self_secs[0].kind  = target_of.SK_TEXT;
    self_secs[0].bytes = ?self_text[0];
    self_secs[0].len   = 16;
    self_secs[0].align = 16;
    self_secs[1].name  = info;
    self_secs[1].kind  = target_of.SK_DEBUG;
    self_secs[1].bytes = ?self_info[0];
    self_secs[1].len   = 24;
    self_secs[1].align = 1;
    self_secs[2].name  = line;
    self_secs[2].kind  = target_of.SK_DEBUG;
    self_secs[2].bytes = ?self_line[0];
    self_secs[2].len   = 8;
    self_secs[2].align = 1;

    var foreign_secs: [3]target_of.Section;
    foreign_secs[0].name  = text;
    foreign_secs[0].kind  = target_of.SK_TEXT;
    foreign_secs[0].bytes = ?foreign_text[0];
    foreign_secs[0].len   = 16;
    foreign_secs[0].align = 16;
    foreign_secs[1].name  = info;
    foreign_secs[1].kind  = target_of.SK_DEBUG;
    foreign_secs[1].bytes = ?foreign_info[0];
    foreign_secs[1].len   = 24;
    foreign_secs[1].align = 1;
    foreign_secs[2].name  = line;
    foreign_secs[2].kind  = target_of.SK_DEBUG;
    foreign_secs[2].bytes = ?foreign_line[0];
    foreign_secs[2].len   = 8;
    foreign_secs[2].align = 1;

    val fn_flags:  u32 = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;
    var self_syms: [2]target_of.Symbol;
    self_syms[0].name    = entry;
    self_syms[0].section = target_of.section_id(0);
    self_syms[0].offset  = 0;
    self_syms[0].size    = 16;
    self_syms[0].flags   = fn_flags;
    self_syms[1].name    = lanchor;
    self_syms[1].section = target_of.section_id(2);
    self_syms[1].offset  = 0;
    self_syms[1].size    = 0;
    self_syms[1].flags   = target_of.SYM_OBJ_FLAG_GLOBAL;

    var foreign_syms: [1]target_of.Symbol;
    foreign_syms[0].name    = ffn;
    foreign_syms[0].section = target_of.section_id(0);
    foreign_syms[0].offset  = 0;
    foreign_syms[0].size    = 16;
    foreign_syms[0].flags   = fn_flags;

    var self_relocs: [2]target_of.Relocation;
    self_relocs[0].section = target_of.section_id(1);
    self_relocs[0].offset  = 8;
    self_relocs[0].kind    = target_of.RK_ABS64;
    self_relocs[0].sym     = 0;
    self_relocs[0].addend  = 0;
    self_relocs[1].section = target_of.section_id(1);
    self_relocs[1].offset  = 16;
    self_relocs[1].kind    = target_of.RK_ABS32;
    self_relocs[1].sym     = 1;
    self_relocs[1].addend  = 0;

    var foreign_relocs: [1]target_of.Relocation;
    foreign_relocs[0].section = target_of.section_id(1);
    foreign_relocs[0].offset  = 8;
    foreign_relocs[0].kind    = target_of.RK_ABS64;
    foreign_relocs[0].sym     = 0;
    foreign_relocs[0].addend  = 0;

    var modules: [2]target_of.ObjectImage;
    modules[0] = lt_image(s, lt_name(s, "selfrel.o"), ?self_secs[0], 3,
        ?self_syms[0], 2, ?self_relocs[0], 2);
    modules[1] = lt_image(s, lt_name(s, "foreign.o"), ?foreign_secs[0], 3,
        ?foreign_syms[0], 1, ?foreign_relocs[0], 1);

    val atf_r: res[output_testing.Output, fail.Fail] = output_testing.create(alloc, "foreign_dwarf_self");
    if (sel atf_r.err) { ret false; }
    var atf: output_testing.Output = atf_r.ok;
    fin { output_testing.dnit(?atf); }
    val btf_r: res[output_testing.Output, fail.Fail] = output_testing.create(alloc, "foreign_dwarf_foreign");
    if (sel btf_r.err) { ret false; }
    var btf: output_testing.Output = btf_r.ok;
    fin { output_testing.dnit(?btf); }
    val etf_r: res[output_testing.Output, fail.Fail] = output_testing.create(alloc, "foreign_dwarf_exe");
    if (sel etf_r.err) {
        ret false;
    }
    var etf: output_testing.Output = etf_r.ok;
    fin { output_testing.dnit(?etf); }
    val apath: str = output_testing.path(?atf);
    val bpath: str = output_testing.path(?btf);
    val epath: str = output_testing.path(?etf);

    var ok:       bool           = true;
    val object_r: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?modules[0], apath);
    if (sel object_r.err) { ok = false; }
    if (ok) {
        val object_r: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?modules[1], bpath);
        if (sel object_r.err) { ok = false; }
    }
    if (ok) {
        var paths: [2]target_of.ObjectInput;
        paths[0] = target_of.ObjectInput{path: apath::*u8, origin: target_of.RELOC_INPUT};
        paths[1] = target_of.ObjectInput{path: bpath::*u8, origin: target_of.RELOC_INPUT};
        val lr: err[fail.Fail] = link(s, ?s.diags, tgt, ?paths[0], 2,
            nil::*target_of.DynLib, 0, epath, "foreign_dwarf"::*u8,
            catalog_artifact.EXECUTABLE, false, target_of.image_options_default(catalog_subsystem.CONSOLE));
        if (sel lr.err) { ok = false; }
    }
    if (ok) {
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, epath);
        if (sel rr.ok) {
            var out: Vector[u8] = rr.ok;
            @out_self    = lt_marker_present(out.data, out.len, 0xAA);
            @out_foreign = lt_marker_present(out.data, out.len, 0xBB);
            collections_vector.dnit[u8](?out);
        }
        if (sel rr.err) { ok = false; }
    }

    ret ok;
}

#[testing]
fun lt_marked_u64(bytes: *u8, len: usize, marker: u8, value: *u64) bool {
    var at: usize = 0;
    for (at + 16 <= len) {
        var i: usize = 0;
        for (i < 8 && bytes[at + i] == marker) { i = i + 1; }
        if (i == 8) {
            @value = bin.read_u64_le(bytes, at + 8);
            ret true;
        }
        at = at + 1;
    }
    ret false;
}

test debug_merge__collected_definitions_are_tombstoned {
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: lang_target.Binding = tr.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var text: [24]u8;
    var info: [56]u8;
    var line: [8]u8;
    var i:    u32 = 0;
    for (i < 8) {
        info[i]      = 0xA1;
        info[16 + i] = 0xA2;
        info[32 + i] = 0xA3;
        i            = i + 1;
    }
    var secs: [3]target_of.Section;
    secs[0].name  = lt_name(?s, ".text");
    secs[0].kind  = target_of.SK_TEXT;
    secs[0].bytes = ?text[0];
    secs[0].len   = 24;
    secs[0].align = 16;
    secs[1].name  = lt_name(?s, ".debug_info");
    secs[1].kind  = target_of.SK_DEBUG;
    secs[1].bytes = ?info[0];
    secs[1].len   = 56;
    secs[1].align = 1;
    secs[2].name  = lt_name(?s, ".debug_line");
    secs[2].kind  = target_of.SK_DEBUG;
    secs[2].bytes = ?line[0];
    secs[2].len   = 8;
    secs[2].align = 1;

    val fn_flags: u32 = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;
    var syms:     [4]target_of.Symbol;
    syms[0].name    = lt_name(?s, tgt.os.entry_symbol);
    syms[0].section = target_of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 8;
    syms[0].flags   = fn_flags;
    syms[1].name    = lt_name(?s, "collected_global");
    syms[1].section = target_of.section_id(0);
    syms[1].offset  = 8;
    syms[1].size    = 8;
    syms[1].flags   = fn_flags;
    syms[2].name    = lt_name(?s, "collected_local");
    syms[2].section = target_of.section_id(0);
    syms[2].offset  = 16;
    syms[2].size    = 8;
    syms[2].flags   = target_of.SYM_OBJ_FLAG_FUNCTION;
    syms[3].name    = lt_name(?s, "tomb.debug_line");
    syms[3].section = target_of.section_id(2);
    syms[3].offset  = 0;
    syms[3].size    = 0;
    syms[3].flags   = target_of.SYM_OBJ_FLAG_GLOBAL;

    var relocs: [4]target_of.Relocation;
    i = 0;
    for (i < 3) {
        relocs[i].section = target_of.section_id(1);
        relocs[i].offset  = 8 + i * 16;
        relocs[i].kind    = target_of.RK_ABS64;
        relocs[i].sym     = i;
        relocs[i].addend  = 0;
        relocs[i].sym2    = target_of.SYMBOL_NONE;
        i                 = i + 1;
    }
    relocs[3].section = target_of.section_id(1);
    relocs[3].offset  = 48;
    relocs[3].kind    = target_of.RK_ABS32;
    relocs[3].sym     = 3;
    relocs[3].addend  = 0;
    relocs[3].sym2    = target_of.SYMBOL_NONE;

    var mods: [1]target_of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "tomb.o"), ?secs[0], 3, ?syms[0], 4, ?relocs[0], 4);

    val tf_r: res[output_testing.Output, fail.Fail] = output_testing.create(?alloc, "gc_tombstones");
    if (sel tf_r.err) { ret 1; }
    var tf: output_testing.Output = tf_r.ok;
    fin { output_testing.dnit(?tf); }
    mods[0].codegen = true;
    val lr: err[fail.Fail] = link_modules_nocapture(?s, ?s.diags, ?tgt, ?mods[0], 1, nil::*target_of.DynLib, 0,
        output_testing.path(?tf), "gc_tombstones"::*u8, catalog_artifact.EXECUTABLE, false, target_of.image_options_default(catalog_subsystem.CONSOLE));
    if (sel lr.err) { ret 2; }
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, output_testing.path(?tf));
    if (sel rr.err) { ret 3; }
    var out: Vector[u8] = rr.ok;
    fin { collections_vector.dnit[u8](?out); }

    var live:    u64 = 0;
    var global:  u64 = 0;
    var private: u64 = 0;
    if (!lt_marked_u64(out.data, out.len, 0xA1, ?live)
        || !lt_marked_u64(out.data, out.len, 0xA2, ?global)
        || !lt_marked_u64(out.data, out.len, 0xA3, ?private)) { ret 4; }
    if (live == 0 || live == DWARF_TOMBSTONE_ADDRESS) { ret 5; }
    if (global != DWARF_TOMBSTONE_ADDRESS)            { ret 6; }
    if (private != DWARF_TOMBSTONE_ADDRESS)           { ret 7; }
    ret 0;
}

# rewrite the relocation type of the first RELA entry in the ELF64 object at
# `path`, standing in for an object another toolchain produced
#[testing]
fun lt_retype_first_rela(alloc: *A.Allocator, path: str, r_type: u32) bool {
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, path);
    if (sel rb.err) { ret false; }
    var buf: Vector[u8] = rb.ok;
    fin { collections_vector.dnit[u8](?buf); }
    if (buf.len < 64) { ret false; }
    val shoff: usize = bin.read_u64_le(buf.data, 0x28)::usize;
    val shent: usize = bin.read_u16_le(buf.data, 0x3A)::usize;
    val shnum: usize = bin.read_u16_le(buf.data, 0x3C)::usize;
    var i:     usize = 0;
    for (i < shnum) {
        val sh: usize = shoff + i * shent;
        if (sh + 64 > buf.len) { ret false; }
        # SHT_RELA; an entry is r_offset, r_info, r_addend with the type in r_info's low word
        if (bin.read_u32_le(buf.data, sh + 4) == 4) {
            val rel: usize = bin.read_u64_le(buf.data, sh + 0x18)::usize;
            if (rel + 24 > buf.len) { ret false; }
            bin.write_u32_le(buf.data, rel + 8, r_type);
            val wr: err[fs.FsError] = fs.write_bytes(path, buf.data, buf.len, 0o644);
            ret sel wr.ok;
        }
        i = i + 1;
    }
    ret false;
}

# a relocation the target cannot handle, in an input object mach did not make,
# is the user's; the same bytes named as an object mach wrote are its defect.
# the class comes from the input's origin, through the loader
test link__an_unsupported_relocation_is_classed_by_its_input {
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: lang_target.Binding = tr.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var text: [16]u8;
    var secs: [1]target_of.Section;
    secs[0].name  = lt_name(?s, ".text");
    secs[0].kind  = target_of.SK_TEXT;
    secs[0].bytes = ?text[0];
    secs[0].len   = 16;
    secs[0].align = 16;
    var syms: [1]target_of.Symbol;
    syms[0].name    = lt_name(?s, tgt.os.entry_symbol);
    syms[0].section = target_of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 16;
    syms[0].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;
    var relocs: [1]target_of.Relocation;
    relocs[0].section = target_of.section_id(0);
    relocs[0].offset  = 4;
    relocs[0].kind    = target_of.RK_PC32;
    relocs[0].sym     = 0;
    relocs[0].addend  = -4;
    var image: target_of.ObjectImage = lt_image(?s, lt_name(?s, "foreign.o"), ?secs[0], 1, ?syms[0], 1, ?relocs[0], 1);

    val of_r: res[output_testing.Output, fail.Fail] = output_testing.create(?alloc, "unsupported_reloc_object");
    if (sel of_r.err) { ret 2; }
    var obj_f: output_testing.Output = of_r.ok;
    fin { output_testing.dnit(?obj_f); }
    val ef_r: res[output_testing.Output, fail.Fail] = output_testing.create(?alloc, "unsupported_reloc_exe");
    if (sel ef_r.err) { ret 2; }
    var exe_f: output_testing.Output = ef_r.ok;
    fin { output_testing.dnit(?exe_f); }
    val opath: str = output_testing.path(?obj_f);
    val epath: str = output_testing.path(?exe_f);

    val written: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?image, opath);
    if (sel written.err) { ret 3; }
    # R_AARCH64_ADR_PREL_PG_HI21 is no type an x86_64 object carries, so reading it is refused
    if (!lt_retype_first_rela(?alloc, opath, 275)) { ret 4; }

    var input: [1]target_of.ObjectInput;
    input[0] = target_of.ObjectInput{path: opath::*u8, origin: target_of.RELOC_INPUT};
    val foreign: err[fail.Fail] = link(?s, ?s.diags, ?tgt, ?input[0], 1, nil::*target_of.DynLib, 0, epath, "foreign"::*u8,
        catalog_artifact.EXECUTABLE, false, target_of.image_options_default(catalog_subsystem.CONSOLE));
    if (sel foreign.ok)                                                                           { ret 5; }
    if (!sel foreign.err.user || fail.kind_of(foreign.err) != diagnostic_kind.OBJECT_UNSUPPORTED) { ret 6; }

    input[0].origin = target_of.RELOC_CODEGEN;
    val own: err[fail.Fail] = link(?s, ?s.diags, ?tgt, ?input[0], 1, nil::*target_of.DynLib, 0, epath, "own"::*u8,
        catalog_artifact.EXECUTABLE, false, target_of.image_options_default(catalog_subsystem.CONSOLE));
    if (sel own.ok)                                                 { ret 7; }
    if (fail.kind_of(own.err) != diagnostic_kind.COMPILER_INTERNAL) { ret 8; }
    ret 0;
}

test debug_merge__foreign_dwarf_left_out {
    val er: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    val mr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "darwin", "sysv64");
    if (sel er.err) { ret 1; }
    if (sel mr.err) { ret 1; }
    var elf_tgt:   lang_target.Binding = er.ok;
    var macho_tgt: lang_target.Binding = mr.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var code:          i32  = 0;
    var elf_self:      bool = false;
    var elf_foreign:   bool = true;
    var macho_self:    bool = false;
    var macho_foreign: bool = true;
    if (!lt_foreign_dwarf_link(?s, ?elf_tgt, ?elf_self, ?elf_foreign))       { code = 1; }
    if (!lt_foreign_dwarf_link(?s, ?macho_tgt, ?macho_self, ?macho_foreign)) { code = 1; }
    session.dnit(?s);

    if (!elf_self || elf_foreign)     { code = 1; }
    if (!macho_self || macho_foreign) { code = 1; }
    ret code;
}

#[testing]
fun lt_marker_tombstoned(bytes: *u8, len: usize, marker: u8, tombstone: u8) bool {
    var at: usize = 0;
    for (at + 16 <= len) {
        var i: usize = 0;
        for (i < 8 && bytes[at + i] == marker) { i = i + 1; }
        if (i == 8) {
            i = 0;
            for (i < 8 && bytes[at + 8 + i] == tombstone) { i = i + 1; }
            if (i == 8) { ret true; }
        }
        at = at + 1;
    }
    ret false;
}

#[testing]
fun lt_parsed_weak_dwarf_target(s: *session.Session, tgt: *lang_target.Binding) bool {
    val alloc:       *A.Allocator = s.alloc;
    val text:        intern.StrId = lt_name(s, ".text");
    val dup:         intern.StrId = lt_name(s, "parsed_weak");
    val entry:       intern.StrId = lt_name(s, tgt.os.entry_symbol);
    var debug_names: [4]intern.StrId;
    debug_names[0] = lt_name(s, ".debug_info");
    debug_names[1] = lt_name(s, ".debug_line");
    debug_names[2] = lt_name(s, ".debug_loclists");
    debug_names[3] = lt_name(s, ".debug_rnglists");
    if (intern.str_is_nil(text) || intern.str_is_nil(dup) || intern.str_is_nil(entry)) { ret false; }

    var winner_text:  [16]u8;
    var loser_text:   [8]u8;
    var winner_debug: [4][40]u8;
    var loser_debug:  [4][40]u8;
    var d:            u32 = 0;
    for (d < 4) {
        if (intern.str_is_nil(debug_names[d])) { ret false; }
        var i: u32 = 0;
        for (i < 40) {
            winner_debug[d][i] = 0;
            loser_debug[d][i]  = 0;
            i                  = i + 1;
        }
        i = 0;
        for (i < 8) {
            winner_debug[d][i]      = (0xA0 + d)::u8;
            loser_debug[d][i]       = (0xD0 + d)::u8;
            winner_debug[d][16 + i] = (0xB0 + d)::u8;
            loser_debug[d][16 + i]  = (0xE0 + d)::u8;
            i                       = i + 1;
        }
        d = d + 1;
    }

    var winner_secs: [5]target_of.Section;
    var loser_secs:  [5]target_of.Section;
    winner_secs[0].name  = text;
    winner_secs[0].kind  = target_of.SK_TEXT;
    winner_secs[0].bytes = ?winner_text[0];
    winner_secs[0].len   = 16;
    winner_secs[0].align = 16;
    loser_secs[0].name   = text;
    loser_secs[0].kind   = target_of.SK_TEXT;
    loser_secs[0].bytes  = ?loser_text[0];
    loser_secs[0].len    = 8;
    loser_secs[0].align  = 16;
    d                    = 0;
    for (d < 4) {
        winner_secs[d + 1].name  = debug_names[d];
        winner_secs[d + 1].kind  = target_of.SK_DEBUG;
        winner_secs[d + 1].bytes = ?winner_debug[d][0];
        winner_secs[d + 1].len   = 40;
        winner_secs[d + 1].align = 1;
        loser_secs[d + 1].name   = debug_names[d];
        loser_secs[d + 1].kind   = target_of.SK_DEBUG;
        loser_secs[d + 1].bytes  = ?loser_debug[d][0];
        loser_secs[d + 1].len    = 40;
        loser_secs[d + 1].align  = 1;
        d                        = d + 1;
    }

    val weak_flags: u32 =
        target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_WEAK | target_of.SYM_OBJ_FLAG_FUNCTION;
    val wline: intern.StrId = lt_name(s, "parsed_weak.w.debug_line");
    val lline: intern.StrId = lt_name(s, "parsed_weak.l.debug_line");
    if (intern.str_is_nil(wline) || intern.str_is_nil(lline)) { ret false; }

    var winner_syms: [3]target_of.Symbol;
    winner_syms[0].name    = dup;
    winner_syms[0].section = target_of.section_id(0);
    winner_syms[0].offset  = 0;
    winner_syms[0].size    = 8;
    winner_syms[0].flags   = weak_flags;
    winner_syms[1].name    = entry;
    winner_syms[1].section = target_of.section_id(0);
    winner_syms[1].offset  = 8;
    winner_syms[1].size    = 8;
    winner_syms[1].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;
    winner_syms[2].name    = wline;
    winner_syms[2].section = target_of.section_id(2);
    winner_syms[2].offset  = 0;
    winner_syms[2].size    = 0;
    winner_syms[2].flags   = target_of.SYM_OBJ_FLAG_GLOBAL;
    var loser_syms: [2]target_of.Symbol;
    loser_syms[0].name    = dup;
    loser_syms[0].section = target_of.section_id(0);
    loser_syms[0].offset  = 0;
    loser_syms[0].size    = 8;
    loser_syms[0].flags   = weak_flags;
    loser_syms[1].name    = lline;
    loser_syms[1].section = target_of.section_id(2);
    loser_syms[1].offset  = 0;
    loser_syms[1].size    = 0;
    loser_syms[1].flags   = target_of.SYM_OBJ_FLAG_GLOBAL;

    var winner_relocs: [9]target_of.Relocation;
    var loser_relocs:  [9]target_of.Relocation;
    d = 0;
    for (d < 4) {
        winner_relocs[d].section     = target_of.section_id(d + 1);
        winner_relocs[d].offset      = 8;
        winner_relocs[d].kind        = target_of.RK_ABS64;
        winner_relocs[d].sym         = 0;
        winner_relocs[d].addend      = 0;
        loser_relocs[d].section      = target_of.section_id(d + 1);
        loser_relocs[d].offset       = 8;
        loser_relocs[d].kind         = target_of.RK_ABS64;
        loser_relocs[d].sym          = 0;
        loser_relocs[d].addend       = 0;
        winner_relocs[4 + d].section = target_of.section_id(d + 1);
        winner_relocs[4 + d].offset  = 24;
        winner_relocs[4 + d].kind    = target_of.RK_ABS64;
        winner_relocs[4 + d].sym     = 0;
        winner_relocs[4 + d].addend  = 4;
        loser_relocs[4 + d].section  = target_of.section_id(d + 1);
        loser_relocs[4 + d].offset   = 24;
        loser_relocs[4 + d].kind     = target_of.RK_ABS64;
        loser_relocs[4 + d].sym      = 0;
        loser_relocs[4 + d].addend   = 4;
        d                            = d + 1;
    }
    winner_relocs[8].section = target_of.section_id(1);
    winner_relocs[8].offset  = 32;
    winner_relocs[8].kind    = target_of.RK_ABS32;
    winner_relocs[8].sym     = 2;
    winner_relocs[8].addend  = 0;
    loser_relocs[8].section  = target_of.section_id(1);
    loser_relocs[8].offset   = 32;
    loser_relocs[8].kind     = target_of.RK_ABS32;
    loser_relocs[8].sym      = 1;
    loser_relocs[8].addend   = 0;

    var modules: [2]target_of.ObjectImage;
    modules[0] = lt_image(s, lt_name(s, "parsed-winner"), ?winner_secs[0], 5,
        ?winner_syms[0], 3, ?winner_relocs[0], 9);
    modules[1] = lt_image(s, lt_name(s, "parsed-loser"), ?loser_secs[0], 5,
        ?loser_syms[0], 2, ?loser_relocs[0], 9);

    if (!lt_is_mach_shaped(?modules[0], 0) || !lt_is_mach_shaped(?modules[0], 1)) { ret false; }

    val wtf_r: res[output_testing.Output, fail.Fail] = output_testing.create(alloc, "weak_dwarf_winner");
    if (sel wtf_r.err) { ret false; }
    var wtf: output_testing.Output = wtf_r.ok;
    fin { output_testing.dnit(?wtf); }
    val ltf_r: res[output_testing.Output, fail.Fail] = output_testing.create(alloc, "weak_dwarf_loser");
    if (sel ltf_r.err) {
        ret false;
    }
    var ltf: output_testing.Output = ltf_r.ok;
    fin { output_testing.dnit(?ltf); }
    val etf_r: res[output_testing.Output, fail.Fail] = output_testing.create(alloc, "weak_dwarf_exe");
    if (sel etf_r.err) {
        ret false;
    }
    var etf: output_testing.Output = etf_r.ok;
    fin { output_testing.dnit(?etf); }
    val wpath: str = output_testing.path(?wtf);
    val lpath: str = output_testing.path(?ltf);
    val epath: str = output_testing.path(?etf);

    var ok:       bool           = true;
    val object_r: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?modules[0], wpath);
    if (sel object_r.err) { ok = false; }
    if (ok) {
        val object_r: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?modules[1], lpath);
        if (sel object_r.err) { ok = false; }
    }
    var paths: [2]target_of.ObjectInput;
    paths[0] = target_of.ObjectInput{path: wpath::*u8, origin: target_of.RELOC_INPUT};
    paths[1] = target_of.ObjectInput{path: lpath::*u8, origin: target_of.RELOC_INPUT};
    if (ok) {
        val lr: err[fail.Fail] = link(s, ?s.diags, tgt, ?paths[0], 2,
            nil::*target_of.DynLib, 0, epath, "parsed_weak_dwarf"::*u8,
            catalog_artifact.EXECUTABLE, false, target_of.image_options_default(catalog_subsystem.CONSOLE));
        if (sel lr.err) { ok = false; }
    }

    var out: Vector[u8];
    if (ok) {
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, epath);
        if (sel rr.ok) {
            out = rr.ok;
            var live_addr: u64 = 0;
            d = 0;
            for (ok && d < 4) {
                var winner_addr: u64 = 0;
                if (!lt_marker_live_value(out.data, out.len, (0xA0 + d)::u8, ?winner_addr)) {
                    ok = false;
                }
                if (d == 0)                   { live_addr = winner_addr; }
                or (winner_addr != live_addr) { ok = false; }
                # .debug_line is d == 1, whose dead sequences start at 0
                var tomb: u8 = 0xFF;
                if (d == 1) { tomb = 0; }
                if (!lt_marker_tombstoned(out.data, out.len, (0xD0 + d)::u8, tomb)) {
                    ok = false;
                }

                var winner_inner: u64 = 0;
                if (!lt_marker_live_value(out.data, out.len, (0xB0 + d)::u8, ?winner_inner)) {
                    ok = false;
                }
                if (winner_inner != live_addr + 4) { ok = false; }
                if (!lt_marker_tombstoned(out.data, out.len, (0xE0 + d)::u8, tomb)) {
                    ok = false;
                }
                d = d + 1;
            }
            collections_vector.dnit[u8](?out);
        }
        if (sel rr.err) { ok = false; }
    }

    ret ok;
}

test patch_relocations__parsed_weak_dwarf_tombstones {
    val er: res[lang_target.Binding, fail.Fail] =
        lang_target.t_select("x86_64", "linux", "sysv64");
    val mr: res[lang_target.Binding, fail.Fail] =
        lang_target.t_select("x86_64", "darwin", "sysv64");
    if (sel er.err) { ret 1; }
    if (sel mr.err) { ret 1; }
    var elf_tgt:   lang_target.Binding = er.ok;
    var macho_tgt: lang_target.Binding = mr.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:        session.Session = sr.ok;
    val elf_ok:   bool            = lt_parsed_weak_dwarf_target(?s, ?elf_tgt);
    val macho_ok: bool            = lt_parsed_weak_dwarf_target(?s, ?macho_tgt);
    session.dnit(?s);
    if (!elf_ok || !macho_ok) { ret 1; }
    ret 0;
}

#[testing]
fun lt_dwarf_addend_crossing(s: *session.Session, tgt: *lang_target.Binding) i32 {
    val alloc:   *A.Allocator = s.alloc;
    val text:    intern.StrId = lt_name(s, ".text");
    val info:    intern.StrId = lt_name(s, ".debug_info");
    val line:    intern.StrId = lt_name(s, ".debug_line");
    val dup:     intern.StrId = lt_name(s, "crossing_weak");
    val anchor:  intern.StrId = lt_name(s, "crossing_anchor");
    val tail:    intern.StrId = lt_name(s, "crossing_tail");
    val lanchor: intern.StrId = lt_name(s, "crossing.debug_line");
    val entry:   intern.StrId = lt_name(s, tgt.os.entry_symbol);
    if (intern.str_is_nil(text) || intern.str_is_nil(info) || intern.str_is_nil(line)
        || intern.str_is_nil(dup) || intern.str_is_nil(anchor) || intern.str_is_nil(tail)
        || intern.str_is_nil(lanchor) || intern.str_is_nil(entry)) {
        ret 4;
    }

    var win_text:   [32]u8;
    var cross_text: [48]u8;
    var i:          u32 = 0;
    for (i < 32) {
        win_text[i] = (0x10 + i)::u8;
        i           = i + 1;
    }
    i = 0;
    for (i < 48) {
        cross_text[i] = (0x40 + i)::u8;
        i             = i + 1;
    }

    var cross_info: [56]u8;
    i = 0;
    for (i < 56) {
        cross_info[i] = 0;
        i             = i + 1;
    }
    i = 0;
    for (i < 8) {
        cross_info[i]      = 0xC1;
        cross_info[16 + i] = 0xC2;
        cross_info[32 + i] = 0xC3;
        i                  = i + 1;
    }
    var cross_line: [8]u8;
    i = 0;
    for (i < 8) {
        cross_line[i] = 0x5C;
        i             = i + 1;
    }

    var win_secs: [1]target_of.Section;
    win_secs[0].name  = text;
    win_secs[0].kind  = target_of.SK_TEXT;
    win_secs[0].bytes = ?win_text[0];
    win_secs[0].len   = 32;
    win_secs[0].align = 16;

    var cross_secs: [3]target_of.Section;
    cross_secs[0].name  = text;
    cross_secs[0].kind  = target_of.SK_TEXT;
    cross_secs[0].bytes = ?cross_text[0];
    cross_secs[0].len   = 48;
    cross_secs[0].align = 16;
    cross_secs[1].name  = info;
    cross_secs[1].kind  = target_of.SK_DEBUG;
    cross_secs[1].bytes = ?cross_info[0];
    cross_secs[1].len   = 56;
    cross_secs[1].align = 1;
    cross_secs[2].name  = line;
    cross_secs[2].kind  = target_of.SK_DEBUG;
    cross_secs[2].bytes = ?cross_line[0];
    cross_secs[2].len   = 8;
    cross_secs[2].align = 1;

    val weak_flags: u32 =
        target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_WEAK | target_of.SYM_OBJ_FLAG_FUNCTION;
    val fn_flags: u32 = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;

    var win_syms: [2]target_of.Symbol;
    win_syms[0].name    = dup;
    win_syms[0].section = target_of.section_id(0);
    win_syms[0].offset  = 0;
    win_syms[0].size    = 16;
    win_syms[0].flags   = weak_flags;
    win_syms[1].name    = entry;
    win_syms[1].section = target_of.section_id(0);
    win_syms[1].offset  = 16;
    win_syms[1].size    = 16;
    win_syms[1].flags   = fn_flags;

    var cross_syms: [4]target_of.Symbol;
    cross_syms[0].name    = anchor;
    cross_syms[0].section = target_of.section_id(0);
    cross_syms[0].offset  = 0;
    cross_syms[0].size    = 16;
    cross_syms[0].flags   = fn_flags;
    cross_syms[1].name    = dup;
    cross_syms[1].section = target_of.section_id(0);
    cross_syms[1].offset  = 16;
    cross_syms[1].size    = 16;
    cross_syms[1].flags   = weak_flags;
    cross_syms[2].name    = tail;
    cross_syms[2].section = target_of.section_id(0);
    cross_syms[2].offset  = 32;
    cross_syms[2].size    = 16;
    cross_syms[2].flags   = fn_flags;
    cross_syms[3].name    = lanchor;
    cross_syms[3].section = target_of.section_id(2);
    cross_syms[3].offset  = 0;
    cross_syms[3].size    = 0;
    cross_syms[3].flags   = target_of.SYM_OBJ_FLAG_GLOBAL;

    var cross_relocs: [4]target_of.Relocation;
    cross_relocs[0].section = target_of.section_id(1);
    cross_relocs[0].offset  = 8;
    cross_relocs[0].kind    = target_of.RK_ABS64;
    cross_relocs[0].sym     = 0;
    cross_relocs[0].addend  = 32;
    cross_relocs[1].section = target_of.section_id(1);
    cross_relocs[1].offset  = 24;
    cross_relocs[1].kind    = target_of.RK_ABS64;
    cross_relocs[1].sym     = 0;
    cross_relocs[1].addend  = 0;
    cross_relocs[2].section = target_of.section_id(1);
    cross_relocs[2].offset  = 40;
    cross_relocs[2].kind    = target_of.RK_ABS64;
    cross_relocs[2].sym     = 2;
    cross_relocs[2].addend  = 0;
    cross_relocs[3].section = target_of.section_id(1);
    cross_relocs[3].offset  = 48;
    cross_relocs[3].kind    = target_of.RK_ABS32;
    cross_relocs[3].sym     = 3;
    cross_relocs[3].addend  = 0;

    var modules: [2]target_of.ObjectImage;
    modules[0] = lt_image(s, lt_name(s, "crossing-winner"), ?win_secs[0], 1,
        ?win_syms[0], 2, nil::*target_of.Relocation, 0);
    modules[1] = lt_image(s, lt_name(s, "crossing-loser"), ?cross_secs[0], 3,
        ?cross_syms[0], 4, ?cross_relocs[0], 4);
    lt_retain(?modules[0]);
    lt_retain(?modules[1]);

    if (!lt_is_mach_shaped(?modules[0], 1)) { ret 6; }

    val wtf_r: res[output_testing.Output, fail.Fail] = output_testing.create(alloc, "cross_dwarf_winner");
    if (sel wtf_r.err) { ret 4; }
    var wtf: output_testing.Output = wtf_r.ok;
    fin { output_testing.dnit(?wtf); }
    val ltf_r: res[output_testing.Output, fail.Fail] = output_testing.create(alloc, "cross_dwarf_loser");
    if (sel ltf_r.err) { ret 4; }
    var ltf: output_testing.Output = ltf_r.ok;
    fin { output_testing.dnit(?ltf); }
    val etf_r: res[output_testing.Output, fail.Fail] = output_testing.create(alloc, "cross_dwarf_exe");
    if (sel etf_r.err) {
        ret 4;
    }
    var etf: output_testing.Output = etf_r.ok;
    fin { output_testing.dnit(?etf); }
    val wpath: str = output_testing.path(?wtf);
    val lpath: str = output_testing.path(?ltf);
    val epath: str = output_testing.path(?etf);

    var code:     i32            = 4;
    var wrote:    bool           = true;
    val object_r: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?modules[0], wpath);
    if (sel object_r.err) { wrote = false; }
    if (wrote) {
        val object_r: err[fail.Fail] = tgt.of.emit_object(?tgt.object, ?modules[1], lpath);
        if (sel object_r.err) { wrote = false; }
    }
    if (wrote) {
        var paths: [2]target_of.ObjectInput;
        paths[0] = target_of.ObjectInput{path: wpath::*u8, origin: target_of.RELOC_INPUT};
        paths[1] = target_of.ObjectInput{path: lpath::*u8, origin: target_of.RELOC_INPUT};
        val lr: err[fail.Fail] = link(s, ?s.diags, tgt, ?paths[0], 2,
            nil::*target_of.DynLib, 0, epath, "crossing_dwarf"::*u8,
            catalog_artifact.EXECUTABLE, false, target_of.image_options_default(catalog_subsystem.CONSOLE));
        if (sel lr.err) {
            code = 3;
            if (str_contains(fail.describe(lr.err), "crosses a discarded body")) { code = 0; }
        }
        if (sel lr.ok) {
            code = 4;
            val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, epath);
            if (sel rr.ok) {
                var out:       Vector[u8] = rr.ok;
                var anchor_va: u64        = 0;
                var cross_va:  u64        = 0;
                var tail_va:   u64        = 0;
                if (lt_marker_live_value(out.data, out.len, 0xC2, ?anchor_va)
                    && lt_marker_live_value(out.data, out.len, 0xC1, ?cross_va)
                    && lt_marker_live_value(out.data, out.len, 0xC3, ?tail_va)) {
                    code = 5;
                    if (tail_va == anchor_va + 16) {
                        code = 2;
                        if (cross_va == anchor_va + 32) { code = 1; }
                    }
                }
                collections_vector.dnit[u8](?out);
            }
        }
    }

    ret code;
}

test patch_relocations__dwarf_addend_crossing_refused {
    val er: res[lang_target.Binding, fail.Fail] =
        lang_target.t_select("x86_64", "linux", "sysv64");
