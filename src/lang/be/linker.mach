rec ImageCountUnit {}

pub fun link(s: *session.Session, l: *linkage.Linkage, diags: *diagnostic.DiagnosticStore, tgt: *lang_target.Binding, inputs: *target_of.ObjectInput,
    input_count: u32, dynlibs: *target_of.DynLib, dynlib_count: u32,
    destination: str, name: *u8, mode: catalog_artifact.Kind, pie: bool,
    image_options: target_of.ImageOptions) err[fail.Fail] {
    if (s == nil)                          { ret err[fail.Fail].err{fail.message("nil session")}; }
    if (l == nil)                          { ret err[fail.Fail].err{fail.message("nil linkage")}; }
    if (diags == nil)                      { ret err[fail.Fail].err{fail.message("nil diagnostic store")}; }
    if (tgt == nil)                        { ret err[fail.Fail].err{fail.message("nil target")}; }
    if (tgt == nil)                        { ret err[fail.Fail].err{fail.message("target: nil resolved target")}; }
    if (tgt.of == nil)                     { ret err[fail.Fail].err{fail.message("target has no object-format vtable")}; }
    if (tgt.os == nil)                     { ret err[fail.Fail].err{fail.message("target has no OS vtable")}; }
    if (!catalog_artifact.is_linked(mode)) { ret err[fail.Fail].err{fail.message("the linker does not produce this artifact kind")}; }
    if (inputs == nil || input_count == 0) {
        ret err[fail.Fail].err{fail.message("no input objects")};
    }

    val alloc: *A.Allocator = s.alloc;

    var required: intern.StrId = intern.STR_NIL;
    if (mode == catalog_artifact.EXECUTABLE) {
        val er: res[intern.StrId, A.Error] = intern.add(?s.interner, tgt.os.entry_symbol);
        if (sel er.err) {
            ret err[fail.Fail].err{fail.refused(er.err)};
        }
        required = er.ok;
    }

    var module_count: u32                                    = 0;
    val read_r:       res[*target_of.ObjectImage, fail.Fail] =
        read_objects(s, tgt, inputs, input_count, nil::*target_of.ObjectImage, 0,
        required, ?module_count);
    if (sel read_r.err) {
        ret err[fail.Fail].err{read_r.err};
    }
    val modules: *target_of.ObjectImage = read_r.ok;

    fin { free_modules(alloc, modules, module_count); }
    ret link_modules_nocapture(s, l, diags, tgt, modules, module_count, dynlibs, dynlib_count,
        destination, name, mode, pie, image_options);
}

pub rec CapturedImage {
    bytes:          *u8;
    len:            usize;
    base:           u64;
    symbols:        *target_of.SymtabEntry;
    symbol_count:   u32;
    functions:      *target_of.ExecFunction;
    function_count: u32;
}

pub fun link_images(s: *session.Session, l: *linkage.Linkage, diags: *diagnostic.DiagnosticStore, tgt: *lang_target.Binding, images: *target_of.ObjectImage,
    image_count: u32, dynlibs: *target_of.DynLib, dynlib_count: u32,
    destination: str, name: *u8, mode: catalog_artifact.Kind, pie: bool,
    image_options: target_of.ImageOptions) err[fail.Fail] {
    if (s == nil)                          { ret err[fail.Fail].err{fail.message("nil session")}; }
    if (l == nil)                          { ret err[fail.Fail].err{fail.message("nil linkage")}; }
    if (diags == nil)                      { ret err[fail.Fail].err{fail.message("nil diagnostic store")}; }
    if (tgt == nil)                        { ret err[fail.Fail].err{fail.message("nil target")}; }
    if (tgt == nil)                        { ret err[fail.Fail].err{fail.message("target: nil resolved target")}; }
    if (tgt.of == nil)                     { ret err[fail.Fail].err{fail.message("target has no object-format vtable")}; }
    if (tgt.os == nil)                     { ret err[fail.Fail].err{fail.message("target has no OS vtable")}; }
    if (!catalog_artifact.is_linked(mode)) { ret err[fail.Fail].err{fail.message("the linker does not produce this artifact kind")}; }
    if (images == nil || image_count == 0) {
        ret err[fail.Fail].err{fail.message("no input objects")};
    }
    ret link_modules_nocapture(s, l, diags, tgt, images, image_count, dynlibs,
        dynlib_count, destination, name, mode, pie, image_options);
}

pub fun link_mixed(s: *session.Session, l: *linkage.Linkage, diags: *diagnostic.DiagnosticStore, tgt: *lang_target.Binding,
    images: *target_of.ObjectImage, image_count: u32,
    inputs: *target_of.ObjectInput, input_count: u32,
    dynlibs: *target_of.DynLib, dynlib_count: u32,
    destination: str, name: *u8, mode: catalog_artifact.Kind, pie: bool,
    image_options: target_of.ImageOptions) err[fail.Fail] {
    if (s == nil)                          { ret err[fail.Fail].err{fail.message("nil session")}; }
    if (l == nil)                          { ret err[fail.Fail].err{fail.message("nil linkage")}; }
    if (diags == nil)                      { ret err[fail.Fail].err{fail.message("nil diagnostic store")}; }
    if (tgt == nil)                        { ret err[fail.Fail].err{fail.message("nil target")}; }
    if (tgt == nil)                        { ret err[fail.Fail].err{fail.message("target: nil resolved target")}; }
    if (tgt.of == nil)                     { ret err[fail.Fail].err{fail.message("target has no object-format vtable")}; }
    if (tgt.os == nil)                     { ret err[fail.Fail].err{fail.message("target has no OS vtable")}; }
    if (!catalog_artifact.is_linked(mode)) { ret err[fail.Fail].err{fail.message("the linker does not produce this artifact kind")}; }
    if (images == nil || image_count == 0) {
        ret err[fail.Fail].err{fail.message("no input objects")};
    }

    val alloc: *A.Allocator = s.alloc;

    var required: intern.StrId = intern.STR_NIL;
    if (mode == catalog_artifact.EXECUTABLE) {
        val er: res[intern.StrId, A.Error] = intern.add(?s.interner, tgt.os.entry_symbol);
        if (sel er.err) {
            ret err[fail.Fail].err{fail.refused(er.err)};
        }
        required = er.ok;
    }

    var ext_count: u32                    = 0;
    var ext:       *target_of.ObjectImage = nil;
    if (inputs != nil && input_count > 0) {
        val read_r: res[*target_of.ObjectImage, fail.Fail] =
            read_objects(s, tgt, inputs, input_count, images, image_count,
            required, ?ext_count);
        if (sel read_r.err) {
            ret err[fail.Fail].err{read_r.err};
        }
        ext = read_r.ok;
    }
    fin { free_modules(alloc, ext, ext_count); }

    val total_r: res[u32, fail.Fail] = combined_image_count(image_count, ext_count);
    if (sel total_r.err) { ret err[fail.Fail].err{total_r.err}; }
    val total: u32                                  = total_r.ok;
    val cr:    res[*target_of.ObjectImage, A.Error] = A.allocate[target_of.ObjectImage](alloc, total::usize);
    if (sel cr.err) { ret err[fail.Fail].err{fail.refused(cr.err)}; }
    val combined: *target_of.ObjectImage = cr.ok;
    fin { A.deallocate[target_of.ObjectImage](alloc, combined, total::usize); }

    var i: u32 = 0;
    for (i < image_count) {
        combined[i] = images[i];
        i           = i + 1;
    }
    var j: u32 = 0;
    for (j < ext_count) {
        combined[image_count + j] = ext[j];
        j                         = j + 1;
    }

    ret link_modules_nocapture(s, l, diags, tgt, combined, total, dynlibs, dynlib_count,
        destination, name, mode, pie, image_options);
}

fun image_machine_flags(s: *session.Session, tgt: *lang_target.Binding,
    modules: *target_of.ObjectImage, module_count: u32) res[u32, fail.Fail] {
    if (!target_of.declares_machine_flags(tgt.of, tgt.object.arch_id)) { ret res[u32, fail.Fail].ok{0}; }

    val abi_mask: u32 = target_of.machine_flags_abi(tgt.of, tgt.object.arch_id);
    val abi_bits: u32 = target_of.machine_flags(tgt.of, ?tgt.object) & abi_mask;

    var feature_bits: u32 = 0;
    var i:            u32 = 0;
    for (i < module_count) {
        val got: u32 = modules[i].machine_flags;
        if ((got & abi_mask) != abi_bits) {
            ret res[u32, fail.Fail].err{fail.user_of(diagnostic_kind.LINK_ABI_MISMATCH, machine_flags_mismatch_message(s, tgt, ?modules[i],
                got & abi_mask, abi_bits))};
        }
        feature_bits = feature_bits | (got & ~abi_mask);
        i            = i + 1;
    }
    ret res[u32, fail.Fail].ok{abi_bits | feature_bits};
}

fun image_attributes(s: *session.Session, tgt: *lang_target.Binding, modules: *target_of.ObjectImage,
    module_count: u32, out_len: *u32) res[*u8, fail.Fail] {
    @out_len = 0;
    if (!target_of.declares_attributes(tgt.of, tgt.object.arch_id)) { ret res[*u8, fail.Fail].ok{nil}; }

    var acc:     *u8 = nil;
    var acc_len: u32 = 0;
    var i:       u32 = 0;
    for (i < module_count) {
        if (modules[i].attributes == nil || modules[i].attributes_len == 0) {
            i = i + 1;
            cnt;
        }
        var next_len: u32                 = 0;
        val mr:       res[*u8, fail.Fail] = target_of.attributes_merge(tgt.of, tgt.object.arch_id, s.alloc, acc, acc_len,
            modules[i].attributes,
            modules[i].attributes_len, ?next_len);
        if (sel mr.err) {
            if (acc != nil && acc_len > 0) { A.deallocate[u8](s.alloc, acc, acc_len::usize); }
            ret res[*u8, fail.Fail].err{input_refusal(s, ?modules[i], mr.err)};
        }
        val merged: *u8 = mr.ok;
        if (acc != nil && acc_len > 0 && acc != merged) { A.deallocate[u8](s.alloc, acc, acc_len::usize); }
        acc     = merged;
        acc_len = next_len;
        i       = i + 1;
    }
    @out_len = acc_len;
    ret res[*u8, fail.Fail].ok{acc};
}

fun link_modules_nocapture(s: *session.Session, l: *linkage.Linkage, diags: *diagnostic.DiagnosticStore, tgt: *lang_target.Binding, modules: *target_of.ObjectImage,
    module_count: u32,
    dynlibs: *target_of.DynLib, dynlib_count: u32,
    destination: str, name: *u8, mode: catalog_artifact.Kind, pie_opt_in: bool,
    image_options: target_of.ImageOptions) err[fail.Fail] {
    ret link_modules(s, l, diags, tgt, modules, module_count, dynlibs, dynlib_count,
        destination, name, mode, pie_opt_in, image_options, nil::*intern.StrId, 0, nil::*CapturedImage);
}

# the synthetic inputs a link appends, in order: the runtime-needs cell first,
# so the start code's reference resolves and dead-strips like any definition,
# the objc selector stubs ahead of common storage, and the local import
# pointers last, over the atom plan of everything before them
val SYNTHESIZER_COUNT: u32 = 4;

val SYNTHESIZERS: [4]Synthesizer = [4]Synthesizer{
    synthesize_runtime_needs,
    synthesize_objc_stubs,
    synthesize_common_storage,
    synthesize_local_imports,
};

fun link_modules(s: *session.Session, l: *linkage.Linkage, diags: *diagnostic.DiagnosticStore, tgt: *lang_target.Binding, modules: *target_of.ObjectImage,
    module_count: u32,
    dynlibs: *target_of.DynLib, dynlib_count: u32,
    destination: str, name: *u8, mode: catalog_artifact.Kind, pie_opt_in: bool,
    image_options: target_of.ImageOptions, root_names: *intern.StrId, root_count: u32,
    capture: *CapturedImage) err[fail.Fail] {
    if (!catalog_artifact.is_linked(mode)) { ret err[fail.Fail].err{fail.message("the linker does not produce this artifact kind")}; }
    if (module_count == 0)                 { ret err[fail.Fail].err{fail.message("no input objects")}; }
    val inputs_valid: err[fail.Fail] = validate_link_inputs(modules, module_count);
    if (sel inputs_valid.err) { ret inputs_valid; }

    var st: LinkState;
    link_state_init(?st, s, l, tgt, mode, modules, module_count, image_options);
    fin { link_state_dnit(?st); }
    st.pie = (mode == catalog_artifact.EXECUTABLE) && (target_requires_pie(tgt) || pie_opt_in);

    val rooted: err[fail.Fail] = plan_roots(?st, name, root_names, root_count);
    if (sel rooted.err) { ret rooted; }
    val settled: err[fail.Fail] = settle_inputs(?st);
    if (sel settled.err)                  { ret settled; }
    if (mode == catalog_artifact.OBJECTS) { ret emit_relocatable(?st, destination); }

    var phase: err[fail.Fail] = synthesize_inputs(?st);
    if (!sel phase.err) { phase = plan_layout(?st, diags); }
    if (!sel phase.err) { phase = resolve_symbols(?st); }
    if (!sel phase.err) { phase = reserve_tables(?st, dynlibs, dynlib_count); }
    if (!sel phase.err) { phase = build_image(?st); }
    if (!sel phase.err) { phase = patch(?st); }
    if (sel phase.err)  { ret phase; }
    ret emit_image(?st, destination, name, capture);
}

# a final image that is position-independent: a pie, or a shared library
fun position_independent(st: *LinkState) bool {
    ret st.pie || st.mode == catalog_artifact.SHARED;
}

# the export surface and the roots link GC keeps, from the caller's inputs
fun plan_roots(st: *LinkState, name: *u8, root_names: *intern.StrId, root_count: u32) err[fail.Fail] {
    val s:         *session.Session              = st.s;
    val surface_r: res[ExportSurface, fail.Fail] = export_surface_build(s, st.inputs.images, st.inputs.count);
    if (sel surface_r.err) { ret err[fail.Fail].err{surface_r.err}; }
    export_surface_free(?st.surface);
    st.surface          = surface_r.ok;
    st.roots.exports    = st.mode == catalog_artifact.SHARED;
    st.roots.names      = root_names;
    st.roots.name_count = root_count;
    # a final image whose format builds unwind tables carries the foreign frame
    # descriptions into them (claim_unwind_inputs) and rebases what it keeps
    st.roots.carries_frames = st.tgt.of != nil && st.tgt.of.unwind_shape != nil;

    # a shared library with no export surface is callable by nobody, and link GC
    # would leave it an image with nothing in it. refused here, before the plan,
    # so the diagnostic names the rule and not the empty image that follows
    if (st.mode == catalog_artifact.SHARED && !any_exported_symbol(st.inputs.images, st.inputs.count, ?st.surface)) {
        ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_NO_EXPORTS, fail.format_intern(?s.interner, s.alloc,
            "shared library '{}' exports nothing: a shared library needs at least one `pub` declaration in the project, or a `fwd` re-export of one",
            shared_product_name(name)))};
    }
    if (st.mode == catalog_artifact.EXECUTABLE) {
        val er: res[intern.StrId, A.Error] = intern.add(?s.interner, st.tgt.os.entry_symbol);
        if (sel er.err) { ret err[fail.Fail].err{fail.refused(er.err)}; }
        st.roots.entry = er.ok;
    }
    ret err[fail.Fail].ok{};
}

# the caller's inputs in the target's relocation form, their attributes and
# machine flags checked and settled into the image's
fun settle_inputs(st: *LinkState) err[fail.Fail] {
    val s:            *session.Session       = st.s;
    val tgt:          *lang_target.Binding   = st.tgt;
    val modules:      *target_of.ObjectImage = st.inputs.images;
    val module_count: u32                    = st.inputs.count;
    var i:            u32                    = 0;
    if (st.mode != catalog_artifact.OBJECTS) {
        for (i < module_count) {
            val nr: err[fail.Fail] = of_reloc.normalize_image(tgt.isa, s.alloc, ?modules[i]);
            if (sel nr.err) { ret nr; }
            i = i + 1;
        }
    }
    i = 0;
    for (i < module_count) {
        val input_attributes_valid: err[fail.Fail] = target_of.attributes_validate(tgt.of, ?tgt.object, modules[i].attributes, modules[i].attributes_len,
            modules[i].machine_flags);
        if (sel input_attributes_valid.err) {
            ret err[fail.Fail].err{input_refusal(s, ?modules[i], input_attributes_valid.err)};
        }
        i = i + 1;
    }
    val mf_r: res[u32, fail.Fail] = image_machine_flags(s, tgt, modules, module_count);
    if (sel mf_r.err) { ret err[fail.Fail].err{mf_r.err}; }
    st.opts.machine_flags = mf_r.ok;
    var attr_len: u32                 = 0;
    val at_r:     res[*u8, fail.Fail] = image_attributes(s, tgt, modules, module_count, ?attr_len);
    if (sel at_r.err) { ret err[fail.Fail].err{at_r.err}; }
    st.opts.attributes     = at_r.ok;
    st.opts.attributes_len = attr_len;
    val attributes_valid: err[fail.Fail] = target_of.attributes_validate(tgt.of, ?tgt.object,
        st.opts.attributes, attr_len, st.opts.machine_flags);
    if (sel attributes_valid.err)            { ret attributes_valid; }
    if (st.mode == catalog_artifact.OBJECTS) { ret err[fail.Fail].ok{}; }

    i = 0;
    for (i < module_count) {
        if (modules[i].indirect_count != 0) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "native indirect symbol sections require relocatable output")};
        }
        i = i + 1;
    }
    st.opts.mapped_by_loader = tgt.os.mapped_by_loader;
    st.opts.stack_reserve    = tgt.target.stack_reserve;
    st.opts.stack_commit     = tgt.target.stack_commit;
    ret err[fail.Fail].ok{};
}

fun emit_relocatable(st: *LinkState, destination: str) err[fail.Fail] {
    val combined: res[target_of.ObjectImage, fail.Fail] = relocatable.combine(
        st.s.alloc, ?st.s.interner, st.inputs.images, st.inputs.count, st.opts.machine_flags,
        st.opts.attributes, st.opts.attributes_len);
    if (sel combined.err) { ret err[fail.Fail].err{combined.err}; }
    var image: target_of.ObjectImage = combined.ok;
    fin { target_of.object_image_dnit(?image); }
    ret obj.emit_image(?image, st.tgt, destination);
}

# appends each synthetic input the link needs, in table order, so every later
# phase reads them as ordinary inputs
fun synthesize_inputs(st: *LinkState) err[fail.Fail] {
    var i: u32 = 0;
    for (i < SYNTHESIZER_COUNT) {
        var img:  target_of.ObjectImage;
        val made: res[bool, fail.Fail] = SYNTHESIZERS[i](?st.synth, ?st.inputs, ?img);
        if (sel made.err) { ret err[fail.Fail].err{made.err}; }
        if (made.ok) {
            val appended: err[fail.Fail] = input_set_append(st.s.alloc, ?st.inputs, ?img);
            if (sel appended.err) {
                target_of.object_image_dnit(?img);
                ret appended;
            }
        }
        i = i + 1;
    }
    st.resolution.modules      = st.inputs.images;
    st.resolution.module_count = st.inputs.count;
    st.resolution.out_img.name = image_name(st.inputs.images, st.inputs.count);
    ret err[fail.Fail].ok{};
}

# where each input section lands: the merged sections, the atoms that survive,
# the first layout and the symbols it places
fun plan_layout(st: *LinkState, diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    val s:            *session.Session       = st.s;
    val tgt:          *lang_target.Binding   = st.tgt;
    val alloc:        *A.Allocator           = s.alloc;
    val rs:           *Resolution            = ?st.resolution;
    val modules:      *target_of.ObjectImage = rs.modules;
    val module_count: u32                    = rs.module_count;

    val dn_r: err[fail.Fail] = discover_debug_names(alloc, modules, module_count, ?st.debug_names, ?st.debug_count);
    if (sel dn_r.err) { ret dn_r; }
    var dm: u32 = 0;
    for (dm < module_count) {
        if (!module_debug_is_linkable(modules, dm)) {
            val warned: err[fail.Fail] = warn_debug_dropped(s, diags, modules[dm].name);
            if (sel warned.err) { ret warned; }
        }
        dm = dm + 1;
    }

    val sm_r: res[StrMerge, fail.Fail] = build_str_merge(s, modules, module_count, true);
    if (sel sm_r.err) { ret err[fail.Fail].err{sm_r.err}; }
    rs.strm = sm_r.ok;

    val merged_count_r: res[u32, fail.Fail] = merged_section_count(st.debug_count);
    if (sel merged_count_r.err) { ret err[fail.Fail].err{merged_count_r.err}; }
    val mrg_r: res[*MergedSection, A.Error] = A.zallocate[MergedSection](alloc, merged_count_r.ok::usize);
    if (sel mrg_r.err) { ret err[fail.Fail].err{fail.refused(mrg_r.err)}; }
    rs.merged       = mrg_r.ok;
    rs.merged_count = merged_count_r.ok;
    init_merged(rs.merged, st.debug_names, st.debug_count);

    val sym_total_r: res[u32, fail.Fail] = total_symbols(modules, module_count);
    if (sel sym_total_r.err) { ret err[fail.Fail].err{sym_total_r.err}; }
    val sec_total_r: res[u32, fail.Fail] = total_sections(modules, module_count);
    if (sel sec_total_r.err) { ret err[fail.Fail].err{sec_total_r.err}; }
    if (sec_total_r.ok > 0) {
        val pr: res[*Placement, A.Error] = A.zallocate[Placement](alloc, sec_total_r.ok::usize);
        if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
        rs.placements = pr.ok;
        rs.sec_total  = sec_total_r.ok;
    }
    val br: res[*u32, A.Error] = A.zallocate[u32](alloc, module_count::usize);
    if (sel br.err) { ret err[fail.Fail].err{fail.refused(br.err)}; }
    rs.sec_base = br.ok;
    val syb_r: res[*u32, A.Error] = A.zallocate[u32](alloc, module_count::usize);
    if (sel syb_r.err) { ret err[fail.Fail].err{fail.refused(syb_r.err)}; }
    st.sym_base = syb_r.ok;
    val fsb_r: err[fail.Fail] = fill_symbol_bases(modules, module_count, st.sym_base);
    if (sel fsb_r.err) { ret fsb_r; }
    if (sym_total_r.ok > 0) {
        val syo_r: res[*u32, A.Error] = A.zallocate[u32](alloc, sym_total_r.ok::usize);
        if (sel syo_r.err) { ret err[fail.Fail].err{fail.refused(syo_r.err)}; }
        st.sym_out   = syo_r.ok;
        st.sym_total = sym_total_r.ok;
    }

    # a synthesizer that needed the atom plan already built it, over every
    # input but the ones appended after it
    var atom_r: err[fail.Fail];
    if (context_take_atoms(?st.synth, ?rs.atoms)) {
        atom_r = fill_section_bases(modules, module_count, rs.sec_base);
    }
    or {
        atom_r = build_atom_plan(s, modules, module_count, rs.sec_base,
            rs.sec_total, true, ?st.roots, tgt.isa, ?rs.atoms);
    }
    if (sel atom_r.err) { ret atom_r; }

    claim_unwind_inputs(tgt, true, modules, module_count, rs.sec_base, rs.placements);
    val acc_r: err[fail.Fail] =
        accumulate_sections(s, modules, module_count, rs.merged, st.debug_names, st.debug_count,
        rs.placements, rs.sec_base, ?rs.strm, ?rs.atoms, ?rs.groups);
    if (sel acc_r.err) { ret acc_r; }

    if (tgt.of.produces_image && st.mode == catalog_artifact.EXECUTABLE) {
        val ei_r: res[intern.StrId, A.Error] = intern.add(?s.interner, tgt.os.entry_symbol);
        if (sel ei_r.err) { ret err[fail.Fail].err{fail.refused(ei_r.err)}; }
        val reorder_r: err[fail.Fail] =
            reorder_flat_entry_first(modules, module_count, rs.merged, rs.placements, rs.sec_base,
            ?rs.atoms, ei_r.ok);
        if (sel reorder_r.err) { ret reorder_r; }
    }

    val overlap_r: err[fail.Fail] =
        validate_no_contribution_overlap(s, modules, module_count, rs.sec_base, rs.placements, rs.sec_total);
    if (sel overlap_r.err) { ret overlap_r; }

    val reserve_r: res[u64, fail.Fail] = header_reserve_bytes(tgt, position_independent(st), nil::*target_of.HeaderShape);
    if (sel reserve_r.err) { ret err[fail.Fail].err{reserve_r.err}; }
    st.header_reserve = reserve_r.ok;
    ret relayout(st);
}

# the entry an executable needs, refused as soon as the symbols are known and
# before any relocation is applied, so the diagnostic names the missing entry
# and not a relocation its absence leaves unresolvable, then the local GOT
fun resolve_symbols(st: *LinkState) err[fail.Fail] {
    val rs: *Resolution = ?st.resolution;
    if (st.mode == catalog_artifact.EXECUTABLE) {
        val entry_r: res[u64, fail.Fail] = entry_vaddr(st.s, st.tgt, ?rs.sym_locs);
        if (sel entry_r.err) { ret err[fail.Fail].err{entry_r.err}; }
    }
    val gp_r: err[fail.Fail] = build_local_got_plan(
        st.s, st.tgt.isa, rs.modules, rs.module_count, ?rs.sym_locs, rs.sec_base, ?rs.atoms,
        rs.merged, ?rs.groups, ?st.local_got);
    if (sel gp_r.err)           { ret gp_r; }
    if (st.local_got.count > 0) { ret relayout(st); }
    ret err[fail.Fail].ok{};
}

# the tables the image reserves before it takes its bytes: the dynamic imports'
# call stubs and GOT, so they are part of the code's layout rather than an
# afterthought past the data, the islands holding the thunks a branch the
# code's size puts out of reach goes through, and the unwind tables
fun reserve_tables(st: *LinkState, dynlibs: *target_of.DynLib, dynlib_count: u32) err[fail.Fail] {
    val s:            *session.Session       = st.s;
    val tgt:          *lang_target.Binding   = st.tgt;
    val rs:           *Resolution            = ?st.resolution;
    val modules:      *target_of.ObjectImage = rs.modules;
    val module_count: u32                    = rs.module_count;
    val executable:   bool                   = st.mode == catalog_artifact.EXECUTABLE;

    var dynamic: bool = executable && (dynlib_count > 0 || st.pie);
    if (executable && !dynamic) {
        val declared_r: res[bool, fail.Fail] = has_unresolved_declared_imports(
            modules, module_count, ?rs.sym_locs, rs.sec_base, ?rs.atoms);
        if (sel declared_r.err) { ret err[fail.Fail].err{declared_r.err}; }
        dynamic = declared_r.ok;
    }
    if (executable && !dynamic) {
        val unresolved_r: res[bool, fail.Fail] = has_unresolved_attributed_imports(
            rs.dyn.linkage, s, modules, module_count, dynlibs, dynlib_count, ?rs.sym_locs,
            tgt.of.import_address_prefix, rs.sec_base, ?rs.atoms);
        if (sel unresolved_r.err) { ret err[fail.Fail].err{unresolved_r.err}; }
        dynamic = unresolved_r.ok;
    }
    st.dynamic = dynamic;

    val loader_r: err[fail.Fail] = loader_check(s, tgt, st.mode, st.pie, dynamic);
    if (sel loader_r.err) { ret loader_r; }

    rs.dyn.info.pie = position_independent(st);
    if (dynamic) {
        val dr: err[fail.Fail] =
            build_dynamic_info(s, tgt, ?rs.dyn, modules, module_count, ?rs.sym_locs,
            dynlibs, dynlib_count, rs.sec_base, ?rs.atoms);
        if (sel dr.err) { ret dr; }
        val tables_r: err[fail.Fail] = reserve_import_tables(s, tgt, ?rs.dyn, rs.merged, ?rs.groups);
        if (sel tables_r.err) { ret tables_r; }
    }

    val th_r: err[fail.Fail] = plan_thunks(s, ?st.thunks, rs);
    if (sel th_r.err) { ret th_r; }

    val uw_r: res[bool, fail.Fail] = reserve_unwind_tables(s, tgt, modules, module_count, rs.sec_base, ?rs.atoms, rs.merged, ?rs.groups,
        rs.placements, ?st.unwind);
    if (sel uw_r.err) { ret err[fail.Fail].err{uw_r.err}; }
    st.unwind_reserved = uw_r.ok;
    ret err[fail.Fail].ok{};
}

# the merged image, laid out again when its header grew or a reserved table
# moved everything after it
fun build_image(st: *LinkState) err[fail.Fail] {
    val s:  *session.Session = st.s;
    val rs: *Resolution      = ?st.resolution;

    val mto_r: res[*u32, A.Error] = A.zallocate[u32](s.alloc, rs.merged_count::usize);
    if (sel mto_r.err) { ret err[fail.Fail].err{fail.refused(mto_r.err)}; }
    rs.merged_to_out = mto_r.ok;

    val build_r: err[fail.Fail] =
        build_merged_image(s, ?rs.out_img, rs.modules, rs.module_count, rs.merged, rs.merged_count,
        rs.placements, rs.sec_base, rs.merged_to_out, st.sym_base, st.sym_out, ?rs.strm, ?rs.atoms);
    if (sel build_r.err) { ret build_r; }
    val built_valid: err[fail.Fail] = target_of.validate_owned_object(?rs.out_img);
    if (sel built_valid.err) { ret err[fail.Fail].err{fail.as_internal(built_valid.err)}; }

    var shape: target_of.HeaderShape;
    measure_header_shape(s, ?rs.out_img, rs.merged, ?rs.groups, ?rs.dyn, position_independent(st), ?shape);
    val want_r: res[u64, fail.Fail] = header_reserve_bytes(st.tgt, position_independent(st), ?shape);
    if (sel want_r.err) { ret err[fail.Fail].err{want_r.err}; }
    val want: u64 = want_r.ok;
    if (want > st.header_reserve || rs.dyn.info.stubs.size > 0 || rs.dyn.info.got.size > 0 || st.unwind_reserved
        || thunks_placed(?st.thunks)) {
        if (want > st.header_reserve) { st.header_reserve = want; }
        val relaid: err[fail.Fail] = relayout(st);
        if (sel relaid.err) { ret relaid; }
    }
    place_import_tables(?rs.dyn, rs.merged);
    ret err[fail.Fail].ok{};
}

# every address patched into the image once the layout is final, and the
# foreign unwind entries resolved against it
fun patch(st: *LinkState) err[fail.Fail] {
    val rs:      *Resolution    = ?st.resolution;
    val thunked: err[fail.Fail] = write_thunks(st.s, ?st.thunks, rs);
    if (sel thunked.err) { ret thunked; }
    val patched: err[fail.Fail] = patch_relocations(st.s, rs, ?st.local_got, ?st.thunks);
    if (sel patched.err) { ret patched; }
    val natives_r: res[*target_of.NativeUnwind, fail.Fail] = resolve_native_unwind(st.s, ?st.unwind, rs, ?st.local_got, ?st.native_count);
    if (sel natives_r.err) { ret err[fail.Fail].err{natives_r.err}; }
    st.natives = natives_r.ok;
    ret err[fail.Fail].ok{};
}

# the linked image's files, written by the format and published at
# `destination`, or handed back in `capture` when the caller keeps the image in
# memory
fun emit_image(st: *LinkState, destination: str, name: *u8, capture: *CapturedImage) err[fail.Fail] {
    val s:      *session.Session     = st.s;
    val tgt:    *lang_target.Binding = st.tgt;
    val rs:     *Resolution          = ?st.resolution;
    val shared: bool                 = st.mode == catalog_artifact.SHARED;
    if (shared && !tgt.of.writes_shared) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "object format cannot write shared libraries")};
    }
    if (capture != nil && destination == nil && !tgt.of.produces_image) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "this object format cannot hand back a linked image")};
    }
    if (tgt.of.image_emit == nil) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "object format cannot write executables")};
    }
    if (!shared && st.dynamic && !tgt.of.writes_dynamic) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "object format cannot write dynamically-linked executables")};
    }

    val alloc: *A.Allocator = s.alloc;
    var img:   target_of.LinkedImage;
    img.alloc      = alloc;
    img.interner   = ?s.interner;
    img.target     = ?tgt.object;
    img.product    = st.mode;
    img.page_size  = os_page_size(tgt);
    img.image_base = rs.image_base;
    img.name       = name;
    img.options    = st.opts;
    if (shared || st.dynamic)         { img.dynamic = ?rs.dyn.info; }
    if (shared && destination != nil) { img.library_name = types_path.filename(destination); }
    if (!shared) {
        val er: res[u64, fail.Fail] = entry_vaddr(s, tgt, ?rs.sym_locs);
        if (sel er.err) { ret err[fail.Fail].err{er.err}; }
        img.entry = er.ok;
    }

    val sr: res[*target_of.LoadSegment, fail.Fail] = build_load_segments(alloc, ?rs.out_img, rs.merged, ?rs.groups, ?img.segment_count);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    img.segments = sr.ok;
    fin { free_load_segments(alloc, img.segments, img.segment_count); }

    if (shared) {
        val xr: res[*target_of.ExportSym, fail.Fail] = collect_exports(s, rs.modules, rs.module_count, ?rs.sym_locs, ?st.surface,
            ?img.export_count);
        if (sel xr.err) { ret err[fail.Fail].err{xr.err}; }
        img.exports = xr.ok;
    }
    fin {
        if (img.exports != nil && img.export_count > 0) { A.deallocate[target_of.ExportSym](alloc, img.exports, img.export_count::usize); }
    }

    # a capture keeps the symbol table and the unwound functions the writer took
    var kept: bool = false;

    val fr: res[*target_of.ExecFunction, fail.Fail] = build_exec_functions(alloc, ?rs.out_img, img.segments, img.segment_count,
        st.natives, st.native_count, ?img.function_count);
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    img.functions = fr.ok;
    fin {
        if (!kept && img.functions != nil && img.function_count > 0) {
            A.deallocate[target_of.ExecFunction](alloc, img.functions, img.function_count::usize);
        }
    }

    val xr: res[*target_of.Section, fail.Fail] = collect_exception_sections(alloc, ?rs.out_img, ?img.exception_count);
    if (sel xr.err) { ret err[fail.Fail].err{xr.err}; }
    img.exceptions = xr.ok;
    fin {
        if (img.exceptions != nil && img.exception_count > 0) {
            A.deallocate[target_of.Section](alloc, img.exceptions, img.exception_count::usize);
        }
    }

    val dr: res[*target_of.Section, fail.Fail] = collect_debug_sections(alloc, ?rs.out_img, ?img.debug_count);
    if (sel dr.err) { ret err[fail.Fail].err{dr.err}; }
    img.debug = dr.ok;
    fin {
        if (img.debug != nil && img.debug_count > 0) { A.deallocate[target_of.Section](alloc, img.debug, img.debug_count::usize); }
    }

    val ser: res[*target_of.SymtabEntry, fail.Fail] = build_symtab_entries(alloc, ?rs.out_img, img.segments, img.segment_count,
        ?st.surface, ?img.symbol_count);
    if (sel ser.err) { ret err[fail.Fail].err{ser.err}; }
    img.symbols = ser.ok;
    fin {
        if (!kept && img.symbols != nil && img.symbol_count > 0) {
            A.deallocate[target_of.SymtabEntry](alloc, img.symbols, img.symbol_count::usize);
        }
    }

    if (tgt.of.segment_tables != nil) {
        var tables: target_of.TableList = target_of.table_list_init(alloc);
        fin { target_of.table_list_dnit(?tables); }
        val shaped: err[fail.Fail] = tgt.of.segment_tables(?img, ?tables);
        if (sel shaped.err) { ret shaped; }
        if (tables.count > 0) {
            val appended: res[*target_of.LoadSegment, fail.Fail] = target_of.table_segments_append(alloc, ?s.interner, img.segments,
                img.segment_count, ?tables, img.page_size);
            if (sel appended.err) { ret err[fail.Fail].err{appended.err}; }
            A.deallocate[target_of.LoadSegment](alloc, img.segments, img.segment_count::usize);
            img.segments      = appended.ok;
            img.segment_count = img.segment_count + tables.count;
        }
    }

    var dst: of_destination.Destination = of_destination.init(alloc);
    fin { of_destination.dnit(?dst); }
    val written: err[fail.Fail] = tgt.of.image_emit(?img, ?dst);
    if (sel written.err) { ret written; }

    if (destination != nil) {
        var op: str = "cannot publish executable";
        if (shared) { op = "cannot publish shared library"; }
        val published: err[fail.Fail] = of_destination.publish(?dst, ?s.interner, destination, op);
        if (sel published.err) { ret published; }
    }
    or (capture != nil) {
        val taken: res[*u8, fail.Fail] = of_destination.artifact_take(?dst, ?capture.len);
        if (sel taken.err) { ret err[fail.Fail].err{taken.err}; }
        capture.bytes = taken.ok;
        capture.base  = dst.base;
    }
    if (capture != nil) {
        capture.symbols        = img.symbols;
        capture.symbol_count   = img.symbol_count;
        capture.functions      = img.functions;
        capture.function_count = img.function_count;
        kept                   = true;
    }
    ret err[fail.Fail].ok{};
}

# the artifact's product name for a diagnostic, never a path: an absolute output
# path in a message a test compares is a path that differs per machine
fun shared_product_name(name: *u8) str {
    if (name == nil) { ret "shared library"; }
    ret name::str;
}

fun combined_image_count(image_count: u32, external_count: u32) res[u32, fail.Fail] {
    val total_r: res[u32, lang_checked.Cause] = add_u32_counts[ImageCountUnit](image_count, external_count);
    if (sel total_r.err) {
        ret res[u32, fail.Fail].err{fail.message("combined input object count overflow")};
    }
    ret res[u32, fail.Fail].ok{total_r.ok};
}

fun image_name(modules: *target_of.ObjectImage, module_count: u32) intern.StrId {
    if (module_count == 0) { ret intern.STR_NIL; }
    ret modules[0].name;
}

# a keyed refusal of one input, its text a predicate on the object, named for the user.
# an unkeyed failure is the linker's own and passes through as it is
fun input_refusal(s: *session.Session, img: *target_of.ObjectImage, f: fail.Fail) fail.Fail {
    if (!(sel f.user)) { ret f; }
    ret fail.user_of(f.user.kind, fail.format_intern(?s.interner, s.alloc, "object '{}' {}",
        name_text(s, img.name, "<input>"), f.user.text));
}

fun machine_flags_mismatch_message(s: *session.Session, tgt: *lang_target.Binding,
    img: *target_of.ObjectImage, got: u32, expected: u32) res[str, fail.Fail] {
    ret fail.format_intern(?s.interner, s.alloc,
        "object '{}' was built for a {} ABI, but this link targets '{}', so every float argument crossing that boundary would read back as garbage",
        name_text(s, img.name, "<input>"), target_of.machine_flags_abi_name(tgt.of, tgt.object.arch_id, got), tgt.abi.name);
}
