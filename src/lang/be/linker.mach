    fin { target.registry_dnit(?reg); }
    val r_10012: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_10012.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "windows", "win64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    var sym: of.Symbol;
    sym.name = lt_name(?s, "NoLibrary");
    sym.section = of.external_section(); sym.offset = 0; sym.size = 0;
    sym.flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN
                | of.SYM_OBJ_FLAG_FUNCTION;
    var module: of.ObjectImage = lt_image(
        ?s, lt_name(?s, "unattributed-user"), nil::*of.Section, 0,
        ?sym, 1, nil::*of.Relocation, 0);
    var locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    var dyn: DynState;
    init_dynstate(?dyn);

    val built: err[fail.Fail] = build_dynamic_info(
        ?s, ?tgt, ?dyn, ?module, 1, ?locs,
        nil::*of.DynLib, 0, nil::*u32, nil::*AtomPlan);
    if (!sel built.err) { ret 1; }
    if (dyn.info.imports == nil) { ret 1; }
    if (dyn.info.import_count != 0) { ret 1; }
    if (dyn.import_cap != 1) { ret 1; }
    free_dynstate(?alloc, ?dyn);
    if (dyn.info.imports != nil || dyn.import_cap != 0) { ret 1; }

    map.dnit[intern.StrId, SymbolLoc](?locs);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.build_dynamic_info:implicit_platform_identity" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_10054: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_10054.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] =
        target.select(?reg, "aarch64", "darwin", "aapcs64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    val platform: intern.StrId = lt_name(?s, "/usr/lib/libSystem.B.dylib");
    val other: intern.StrId = lt_name(?s, "@rpath/libother.dylib");
    val symbol: intern.StrId = lt_name(?s, "_platform_call");
    if (platform == intern.STR_NIL || other == intern.STR_NIL
        || symbol == intern.STR_NIL) { ret 1; }

    var locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    var explicit: [1]of.DynLib;
    explicit[0].name = platform;
    explicit[0].soname = other;
    explicit[0].rpath = intern.STR_NIL;
    var collision_dyn: DynState;
    init_dynstate(?collision_dyn);
    collision_dyn.info.pie = true;
    val collision: err[fail.Fail] =
        build_dynamic_info(?s, ?tgt, ?collision_dyn, nil::*of.ObjectImage, 0,
                           ?locs, ?explicit[0], 1, nil::*u32, nil::*AtomPlan);
    if (!sel collision.err) { ret 1; }
    free_dynstate(?alloc, ?collision_dyn);

    var sym: of.Symbol;
    sym.name = symbol;
    sym.section = of.external_section();
    sym.offset = 0;
    sym.size = 0;
    sym.flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN
              | of.SYM_OBJ_FLAG_FUNCTION;
    var module: of.ObjectImage =
        lt_image(?s, lt_name(?s, "platform-user"), nil::*of.Section, 0,
                 ?sym, 1, nil::*of.Relocation, 0);
    val register_import_library_r: err[fail.Fail] = session.register_import_library(?s, symbol, platform);
    if (sel register_import_library_r.err) {
        ret 1;
    }
    var dyn: DynState;
    init_dynstate(?dyn);
    dyn.info.pie = true;
    val built: err[fail.Fail] =
        build_dynamic_info(?s, ?tgt, ?dyn, ?module, 1, ?locs,
                           nil::*of.DynLib, 0, nil::*u32, nil::*AtomPlan);
    if (sel built.err) { ret 1; }
    if (dyn.info.lib_count != 1 || dyn.info.libs[0].name != platform
        || dyn.info.libs[0].soname != platform || dyn.info.import_count != 1
        || dyn.info.imports[0].lib_index != 0) { ret 1; }

    free_dynstate(?alloc, ?dyn);
    map.dnit[intern.StrId, SymbolLoc](?locs);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.os_base_addr:manifest_base_override" {
