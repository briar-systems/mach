    ret bad;
}

test "mach.lang.be.linker.build_str_merge:refuses_unterminated_debug_str_section" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var bad_bytes: [8]u8;
    bad_bytes[0] = 1; bad_bytes[1] = 2; bad_bytes[2] = 3; bad_bytes[3] = 4;
    bad_bytes[4] = 5; bad_bytes[5] = 6; bad_bytes[6] = 7; bad_bytes[7] = 8;

    var sec: of.Section;
    sec.name  = lt_name(?s, ".debug_str");
    sec.kind  = of.SK_DEBUG;
    sec.bytes = ?bad_bytes[0];
    sec.len   = 8;
    sec.align = 1;

    var mods: [1]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "m.o"), ?sec, 1, nil, 0, nil, 0);

    val r: R.Result[StrMerge, str] = build_str_merge(?s, ?mods[0], 1, true);
    var bad: i32 = 0;
    if (R.is_ok[StrMerge, str](r)) {
        bad = 1;
        var sm: StrMerge = R.unwrap_ok[StrMerge, str](r);
        free_str_merge(?sm);
    }

    session.dnit(?s);
    ret bad;
}

test "mach.lang.be.linker.resolve_strp:uses_symbol_offset_and_collects_suffix" {
    var reg: target.TargetRegistry = target.registry_init();
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) {
        target.registry_dnit(?reg);
        ret 1;
    }
    val target_r: R.Result[target.Target, str] =
        target.select(?reg, "x86_64", "linux", "sysv64");
    if (R.is_err[target.Target, str](target_r)) {
        target.registry_dnit(?reg);
        ret 2;
    }
    var selected: target.Target = R.unwrap_ok[target.Target, str](target_r);

    var alloc: A.Allocator;
    page.make(?alloc);
    val session_r: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](session_r)) {
        target.registry_dnit(?reg);
        ret 3;
    }
    var s: session.Session = R.unwrap_ok[session.Session, str](session_r);

    var bytes: [13]u8;
    bytes[0] = 'f'; bytes[1] = 'i'; bytes[2] = 'r'; bytes[3] = 's'; bytes[4] = 't'; bytes[5] = 0;
    bytes[6] = 's'; bytes[7] = 'e'; bytes[8] = 'c'; bytes[9] = 'o';
    bytes[10] = 'n'; bytes[11] = 'd'; bytes[12] = 0;
    var info_bytes: [4]u8;
    var sections: [2]of.Section;
    sections[0].name = lt_name(?s, ".debug_str");
    sections[0].kind = of.SK_DEBUG;
    sections[0].bytes = ?bytes[0];
    sections[0].len = 13;
    sections[0].align = 1;
    sections[0].flags = 0;
    sections[1].name = lt_name(?s, ".debug_info");
    sections[1].kind = of.SK_DEBUG;
    sections[1].bytes = ?info_bytes[0];
    sections[1].len = 4;
    sections[1].align = 1;
    sections[1].flags = 0;
    var symbol: of.Symbol;
    symbol.name = lt_name(?s, "second-string-suffix");
    symbol.section = 0;
    symbol.offset = 7;
    symbol.size = 0;
    symbol.flags = 0;
    symbol.fallback = of.SYMBOL_NONE;
    symbol.align = 1;
    var relocation: of.Relocation;
    relocation.section = 1;
    relocation.offset = 0;
    relocation.kind = of.RK_ABS32;
    relocation.sym = 0;
    relocation.sym2 = of.SYMBOL_NONE;
    relocation.addend = 0;
    var module: of.ObjectImage = lt_image(
        ?s, lt_name(?s, "strings.o"), ?sections[0], 2,
        ?symbol, 1, ?relocation, 1);

    val merge_r: R.Result[StrMerge, str] = build_str_merge(?s, ?module, 1, true);
    if (R.is_err[StrMerge, str](merge_r)) {
        session.dnit(?s);
        target.registry_dnit(?reg);
        ret 4;
    }
    var strm: StrMerge = R.unwrap_ok[StrMerge, str](merge_r);
    var destination: [4]u8;

    val resolved_r: R.Result[R.Void, str] = resolve_strp(
        ?s, ?module, 0, 0, ?symbol, ?relocation, ?strm,
        ?destination[0], 0, 4, 0, selected.isa, 0);
    var bad: i32 = 0;
    if (R.is_err[R.Void, str](resolved_r))                  { bad = 5; }
    or (bin.read_u32_le(?destination[0], 0) != 13)        { bad = 6; }
    or (R.is_ok[u32, str](debug_str_source_offset(0xFFFFFFFF, 1, 0xFFFFFFFF))) {
        bad = 7;
    }

    free_str_merge(?strm);
    session.dnit(?s);
    target.registry_dnit(?reg);
    ret bad;
}

