        "unlinked", "unlinked"::*u8, catalog_artifact.STATIC, false, target_of.image_options_default(catalog_subsystem.CONSOLE));
    if (!sel lr.err)                                                                          { ret 2; }
    if (!str_equals(fail.describe(lr.err), "the linker does not produce this artifact kind")) { ret 3; }
    ret 0;
}

# links one attributed text-only module into an executable
#[testing]
fun lt_attributed_link(s: *session.Session, tgt: *lang_target.Binding, attributes: *u8,
    attributes_len: u32, extra_flags: u32) err[fail.Fail] {
    val text:  intern.StrId = lt_name(s, ".text");
    val entry: intern.StrId = lt_name(s, tgt.os.entry_symbol);
    if (intern.str_is_nil(text) || intern.str_is_nil(entry)) { ret err[fail.Fail].err{fail.message("lt: intern failed")}; }
    var tb: [16]u8;
    var i:  u32 = 0;
    for (i < 16) {
        tb[i] = 0x13;
        i     = i + 1;
    }
    var secs: [1]target_of.Section;
    secs[0].name  = text;
    secs[0].kind  = target_of.SK_TEXT;
    secs[0].bytes = ?tb[0];
    secs[0].len   = 16;
    secs[0].align = 16;
    var syms: [1]target_of.Symbol;
    syms[0].name    = entry;
    syms[0].section = target_of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 0;
    syms[0].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;
    var mods: [1]target_of.ObjectImage;
    mods[0]                = lt_image(s, lt_name(s, "attributed"), ?secs[0], 1, ?syms[0], 1, nil::*target_of.Relocation, 0);
    mods[0].machine_flags  = target_of.machine_flags(tgt.of, tgt.object.arch_id, tgt.abi.float_arg_bits, false) | extra_flags;
    mods[0].attributes     = attributes;
    mods[0].attributes_len = attributes_len;
    val tf_r: res[output_testing.Output, fail.Fail] = output_testing.create(s.alloc, "attributed");
    if (sel tf_r.err) { ret err[fail.Fail].err{fail.message("lt: temp failed")}; }
    var tf: output_testing.Output = tf_r.ok;
    fin { output_testing.dnit(?tf); }
    mods[0].codegen = true;
    ret link_modules_nocapture(s, ?s.diags, tgt, ?mods[0], 1, nil::*target_of.DynLib, 0, output_testing.path(?tf),
        "attributed"::*u8, catalog_artifact.EXECUTABLE, false,
        target_of.image_options_default(catalog_subsystem.CONSOLE));
}

#[testing]
fun lt_refused_as(r: err[fail.Fail], k: diagnostic_kind.Kind) bool {
    if (sel r.err) { ret fail.kind_of(r.err) == k; }
    ret false;
}

#[testing]
fun lt_refused_saying(r: err[fail.Fail], text: str) bool {
    if (sel r.err) { ret str_equals(fail.describe(r.err), text); }
    ret false;
}

# an input's extensions are merged, never checked against the selection; only another XLEN,
# the RV32E/RV64E convention or a malformed section refuses it, keyed and naming the object
test link_modules__riscv_inputs_merge_and_refuse_only_conflicts {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val full_r: res[lang_target.Binding, fail.Fail] = lang_target.select_of(lang_target.t_registry(), "rv64imafdc", "freestanding", "lp64d", "elf");
    val base_r: res[lang_target.Binding, fail.Fail] = lang_target.select_of(lang_target.t_registry(), "rv64i", "freestanding", "lp64", "elf");
    if (sel full_r.err) { ret 2; }
    if (sel base_r.err) { ret 2; }
    var full: lang_target.Binding = full_r.ok;
    var base: lang_target.Binding = base_r.ok;

    var full_len:   u32                 = 0;
    val full_attrs: res[*u8, fail.Fail] = target_of.attributes_build(full.of, full.object.arch_id, ?alloc,
        full.target.model.gpr_width * 8, full.target.model.extensions, 0, false, ?full_len);
    if (sel full_attrs.err) { ret 3; }
    fin { A.deallocate[u8](?alloc, full_attrs.ok, full_len::usize); }
    val wider: err[fail.Fail] = lt_attributed_link(?s, ?base, full_attrs.ok, full_len, 0);
    if (sel wider.err) { ret 4; }
    val rvc:        u32            = target_of.machine_flags(base.of, base.object.arch_id, 0, true) & ~target_of.machine_flags(base.of, base.object.arch_id, 0, false);
    val compressed: err[fail.Fail] = lt_attributed_link(?s, ?base, nil, 0, rvc);
    if (sel compressed.err) { ret 5; }

    var raw:  [96]u8;
    var n:    u32            = elf_riscv.t_arch_body(?raw[0], "rv64i2p1_m2p0_f2p2_d2p2_zfh1p0_zfhmin1p0");
    val half: err[fail.Fail] = lt_attributed_link(?s, ?full, ?raw[0], n, 0);
    if (sel half.err) { ret 6; }

    n = elf_riscv.t_arch_body(?raw[0], "rv32i2p1");
    val xlen: err[fail.Fail] = lt_attributed_link(?s, ?full, ?raw[0], n, 0);
    if (!lt_refused_as(xlen, diagnostic_kind.LINK_ABI_MISMATCH))                                                        { ret 7; }
    if (!lt_refused_saying(xlen, "object 'attributed' declares a Tag_RISCV_arch whose XLEN differs from the target's")) { ret 7; }
    val rve: err[fail.Fail] = lt_attributed_link(?s, ?full, nil, 0, elf_riscv.EF_RVE);
    if (!lt_refused_as(rve, diagnostic_kind.LINK_ABI_MISMATCH)) { ret 8; }
    n = elf_riscv.t_arch_body(?raw[0], "rv64i2p1_zfh1p0");
    val cut: err[fail.Fail] = lt_attributed_link(?s, ?full, ?raw[0], n - 1, 0);
    if (!lt_refused_as(cut, diagnostic_kind.LINK_INPUT_INVALID))                                     { ret 9; }
    if (!lt_refused_saying(cut, "object 'attributed' has an unterminated .riscv.attributes string")) { ret 9; }
    ret 0;
}

test patch_relocations__anonymous_section_symbols_stay_distinct {
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "freestanding", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: lang_target.Binding = tr.ok;
    if (!tgt.of.produces_image) { ret 1; }

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val text:   intern.StrId = lt_name(?s, ".text");
    val rodata: intern.StrId = lt_name(?s, ".rodata.str1.1");
    val data:   intern.StrId = lt_name(?s, ".data.rel.ro.local");
    val anon:   intern.StrId = lt_name(?s, "");
    val anchor: intern.StrId = lt_name(?s, "rodata_anchor");
    val entry:  intern.StrId = lt_name(?s, tgt.os.entry_symbol);
    if (intern.str_is_nil(text) || intern.str_is_nil(rodata) || intern.str_is_nil(data))  { ret 1; }
    if (intern.str_is_nil(anon) || intern.str_is_nil(anchor) || intern.str_is_nil(entry)) { ret 1; }

    var tb: [16]u8;
    var rb: [16]u8;
    var db: [24]u8;
    var i:  u32 = 0;
    for (i < 16) {
        tb[i] = 0x90;
        rb[i] = 0x00;
        i     = i + 1;
    }
    for (i < 24) {
        db[i] = 0x00;
        i     = i + 1;
    }
    i = 0;
    for (i < 8) {
        db[i] = 0xEE;
        i     = i + 1;
    }

    var secs: [3]target_of.Section;
    secs[0].name  = text;
    secs[0].kind  = target_of.SK_TEXT;
    secs[0].bytes = ?tb[0];
    secs[0].len   = 16;
    secs[0].align = 16;
    secs[1].name  = rodata;
    secs[1].kind  = target_of.SK_RODATA;
    secs[1].bytes = ?rb[0];
    secs[1].len   = 16;
    secs[1].align = 16;
    secs[2].name  = data;
    secs[2].kind  = target_of.SK_DATA;
    secs[2].bytes = ?db[0];
    secs[2].len   = 24;
    secs[2].align = 8;

    var syms: [5]target_of.Symbol;
    syms[0].name    = anon;
    syms[0].section = target_of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 0;
    syms[0].flags   = 0;
    syms[1].name    = anon;
    syms[1].section = target_of.section_id(1);
    syms[1].offset  = 0;
    syms[1].size    = 0;
    syms[1].flags   = 0;
    syms[2].name    = anchor;
    syms[2].section = target_of.section_id(1);
    syms[2].offset  = 8;
    syms[2].size    = 0;
    syms[2].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_OBJECT;
    syms[3].name    = entry;
    syms[3].section = target_of.section_id(0);
    syms[3].offset  = 0;
    syms[3].size    = 0;
    syms[3].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;
    syms[4].name    = lt_name(?s, "table");
    syms[4].section = target_of.section_id(2);
    syms[4].offset  = 0;
    syms[4].size    = 24;
    syms[4].flags   = target_of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [3]target_of.Relocation;
    relocs[0].section = target_of.section_id(2);
    relocs[0].offset  = 8;
    relocs[0].kind    = target_of.RK_ABS64;
    relocs[0].sym     = 1;
    relocs[0].addend  = 8;
    relocs[1].section = target_of.section_id(2);
    relocs[1].offset  = 16;
    relocs[1].kind    = target_of.RK_ABS64;
    relocs[1].sym     = 2;
    relocs[1].addend  = 0;
    relocs[2].section = target_of.section_id(0);
    relocs[2].offset  = 4;
    relocs[2].kind    = target_of.RK_PC32;
    relocs[2].sym     = 4;
    relocs[2].addend  = -4;

    var mods: [1]target_of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "anon_secs"), ?secs[0], 3, ?syms[0], 5, ?relocs[0], 3);

    val etr: res[lang_target.Binding, fail.Fail] =
        lang_target.t_select("x86_64", "linux", "sysv64");
    if (sel etr.err) { ret 1; }
    var etgt: lang_target.Binding = etr.ok;

    val otf_r: res[output_testing.Output, fail.Fail] = output_testing.create(?alloc, "anon_section_obj");
    if (sel otf_r.err) { ret 1; }
    var otf: output_testing.Output = otf_r.ok;
    fin { output_testing.dnit(?otf); }
    val opath: str            = output_testing.path(?otf);
    val olr:   err[fail.Fail] =
        link_modules_nocapture(?s, ?s.diags, ?etgt, ?mods[0], 1, nil::*target_of.DynLib, 0, opath,
        "anon_section_obj"::*u8, catalog_artifact.OBJECTS, false,
        target_of.image_options_default(catalog_subsystem.CONSOLE));
    if (sel olr.err) { ret 1; }

    val orb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, opath);

    if (sel orb.err) { ret 1; }
    var ob:      Vector[u8]     = orb.ok;
    var carried: target_of.ObjectImage;
    val opr:     err[fail.Fail] =
        etgt.of.parse_object(?alloc, ?s.interner, ob.data, ob.len, ?carried);
    if (sel opr.err) {
        collections_vector.dnit[u8](?ob);
        ret 1;
    }

    var saw_section: bool = false;
    var saw_anchor:  bool = false;
    var cr:          u32  = 0;
    for (cr < carried.reloc_count) {
        val rr: *target_of.Relocation = ?carried.relocations[cr];
        if (target_of.section_index(rr.section) < carried.section_count
            && carried.sections[target_of.section_index(rr.section)].kind == target_of.SK_TEXT) {
            cr = cr + 1;
            cnt;
        }
        if (rr.sym >= carried.symbol_count) {
            target_of.object_image_dnit(?carried);
            collections_vector.dnit[u8](?ob);
            ret 1;
        }
        val cs: *target_of.Symbol = ?carried.symbols[rr.sym];
        if (target_of.section_index(cs.section) >= carried.section_count
            || carried.sections[target_of.section_index(cs.section)].kind != target_of.SK_RODATA) {
            target_of.object_image_dnit(?carried);
            collections_vector.dnit[u8](?ob);
            ret 1;
        }
        if (rr.addend == 8 && intern.str_same(cs.name, anon) && cs.offset == 0)   { saw_section = true; }
        if (rr.addend == 0 && intern.str_same(cs.name, anchor) && cs.offset == 8) { saw_anchor = true; }
        cr = cr + 1;
    }
    target_of.object_image_dnit(?carried);
    collections_vector.dnit[u8](?ob);
    if (!saw_section || !saw_anchor) { ret 1; }

    val tf_r: res[output_testing.Output, fail.Fail] = output_testing.create(?alloc, "anon_section_syms");
    if (sel tf_r.err) { ret 1; }
    var tf: output_testing.Output = tf_r.ok;
    fin { output_testing.dnit(?tf); }
    val tpath: str = output_testing.path(?tf);

    mods[0].codegen = true;
    val lr: err[fail.Fail] =
        link_modules_nocapture(?s, ?s.diags, ?tgt, ?mods[0], 1, nil::*target_of.DynLib, 0, tpath, "anon_section_syms"::*u8, catalog_artifact.EXECUTABLE, false, target_of.image_options_default(catalog_subsystem.CONSOLE));
    if (sel lr.err) { ret 1; }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rr.err) { ret 1; }
    var b: Vector[u8] = rr.ok;

    if (b.len < 24) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }
    var site: usize = b.len;
    var scan: usize = 0;
    for (scan + 24 <= b.len) {
        if (b.data[scan] == 0xEE && b.data[scan + 7] == 0xEE) {
            site = scan;
            scan = b.len;
        }
        or { scan = scan + 1; }
    }
    if (site + 24 > b.len) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }

    var via_section: u64 = 0;
    var via_name:    u64 = 0;
    i = 0;
    for (i < 8) {
        via_section = via_section | (b.data[site + 8 + i::usize]::u64 << (i * 8));
        via_name    = via_name | (b.data[site + 16 + i::usize]::u64 << (i * 8));
        i           = i + 1;
    }

    if (via_section == 0 || via_name == 0) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }
    if (via_section != via_name) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }

    collections_vector.dnit[u8](?b);
    session.dnit(?s);
    ret 0;
}

test patch_relocations__duplicate_coff_section_symbols_stay_distinct {
    val tr: res[lang_target.Binding, fail.Fail] =
        lang_target.t_select("x86_64", "windows", "win64");
    if (sel tr.err) { ret 1; }
    var tgt: lang_target.Binding = tr.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val text:     intern.StrId = lt_name(?s, ".text");
    val rdata:    intern.StrId = lt_name(?s, ".rdata");
    val data:     intern.StrId = lt_name(?s, ".data");
    val anchor_a: intern.StrId = lt_name(?s, "rdata_anchor_a");
    val anchor_b: intern.StrId = lt_name(?s, "rdata_anchor_b");
    val entry:    intern.StrId = lt_name(?s, tgt.os.entry_symbol);
    if (intern.str_is_nil(text) || intern.str_is_nil(rdata) || intern.str_is_nil(data)) { ret 1; }
    if (intern.str_is_nil(anchor_a) || intern.str_is_nil(anchor_b)
        || intern.str_is_nil(entry)) { ret 1; }

    var tb: [16]u8;
    var ra: [16]u8;
    var rb: [16]u8;
    var db: [40]u8;
    var i:  u32 = 0;
    for (i < 16) {
        tb[i] = 0x90;
        ra[i] = 0xA1;
        rb[i] = 0xB2;
        i     = i + 1;
    }
    i = 0;
    for (i < 40) {
        db[i] = 0;
        i     = i + 1;
    }
    i = 0;
    for (i < 8) {
        db[i] = 0xEE;
        i     = i + 1;
    }

    var secs: [4]target_of.Section;
    secs[0].name  = text;
    secs[0].kind  = target_of.SK_TEXT;
    secs[0].bytes = ?tb[0];
    secs[0].len   = 16;
    secs[0].align = 16;
    secs[1].name  = rdata;
    secs[1].kind  = target_of.SK_RODATA;
    secs[1].bytes = ?ra[0];
    secs[1].len   = 16;
    secs[1].align = 16;
    secs[2].name  = rdata;
    secs[2].kind  = target_of.SK_RODATA;
    secs[2].bytes = ?rb[0];
    secs[2].len   = 16;
    secs[2].align = 16;
    secs[3].name  = data;
    secs[3].kind  = target_of.SK_DATA;
    secs[3].bytes = ?db[0];
    secs[3].len   = 40;
    secs[3].align = 8;

    var syms: [5]target_of.Symbol;
    syms[0].name    = rdata;
    syms[0].section = target_of.section_id(1);
    syms[0].offset  = 0;
    syms[0].size    = 0;
    syms[0].flags   = 0;
    syms[1].name    = rdata;
    syms[1].section = target_of.section_id(2);
    syms[1].offset  = 0;
    syms[1].size    = 0;
    syms[1].flags   = 0;
    syms[2].name    = anchor_a;
    syms[2].section = target_of.section_id(1);
    syms[2].offset  = 8;
    syms[2].size    = 0;
    syms[2].flags   = 0;
    syms[3].name    = anchor_b;
    syms[3].section = target_of.section_id(2);
    syms[3].offset  = 8;
    syms[3].size    = 0;
    syms[3].flags   = 0;
    syms[4].name    = entry;
    syms[4].section = target_of.section_id(0);
    syms[4].offset  = 0;
    syms[4].size    = 16;
    syms[4].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [4]target_of.Relocation;
    relocs[0].section = target_of.section_id(3);
    relocs[0].offset  = 8;
    relocs[0].kind    = target_of.RK_ABS64;
    relocs[0].sym     = 0;
    relocs[0].addend  = 8;
    relocs[1].section = target_of.section_id(3);
    relocs[1].offset  = 16;
    relocs[1].kind    = target_of.RK_ABS64;
    relocs[1].sym     = 2;
    relocs[1].addend  = 0;
    relocs[2].section = target_of.section_id(3);
    relocs[2].offset  = 24;
    relocs[2].kind    = target_of.RK_ABS64;
    relocs[2].sym     = 1;
    relocs[2].addend  = 8;
    relocs[3].section = target_of.section_id(3);
    relocs[3].offset  = 32;
    relocs[3].kind    = target_of.RK_ABS64;
    relocs[3].sym     = 3;
    relocs[3].addend  = 0;

    var mods: [1]target_of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "coff_section_syms"), ?secs[0], 4,
        ?syms[0], 5, ?relocs[0], 4);
    lt_retain(?mods[0]);

    val tf_r: res[output_testing.Output, fail.Fail] = output_testing.create(?alloc, "coff_section_syms");
    if (sel tf_r.err) { ret 1; }
    var tf: output_testing.Output = tf_r.ok;
    fin { output_testing.dnit(?tf); }
    val tpath: str = output_testing.path(?tf);

    val lr: err[fail.Fail] =
        link_modules_nocapture(?s, ?s.diags, ?tgt, ?mods[0], 1, nil::*target_of.DynLib, 0, tpath,
        "coff_section_syms"::*u8, catalog_artifact.EXECUTABLE, false, target_of.image_options_default(catalog_subsystem.CONSOLE));
    if (sel lr.err) { ret 1; }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rr.err) { ret 1; }
    var b: Vector[u8] = rr.ok;

    var site: usize = b.len;
    var scan: usize = 0;
    for (scan + 40 <= b.len) {
        if (b.data[scan] == 0xEE && b.data[scan + 7] == 0xEE) {
            site = scan;
            scan = b.len;
        }
        or { scan = scan + 1; }
    }
    if (site + 40 > b.len) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }

    var values: [4]u64;
    var v:      u32 = 0;
    for (v < 4) {
        i = 0;
        for (i < 8) {
            values[v] = values[v] | (b.data[site + 8 + v::usize * 8 + i::usize]::u64 << (i * 8));
            i         = i + 1;
        }
        v = v + 1;
    }

    if (values[0] == 0 || values[2] == 0) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }
    if (values[0] != values[1] || values[2] != values[3]) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }
    if (values[0] == values[2]) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }

    collections_vector.dnit[u8](?b);
    session.dnit(?s);
    ret 0;
}

test link_modules__arm64_import_tail_branch {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("aarch64", "darwin", "aapcs64");
    if (sel tr.err) { ret 3; }
    var tgt:                       lang_target.Binding = tr.ok;
    val pin:                       intern.StrId        = lt_name(?s, "libSystem");
    val imported:                  intern.StrId        = lt_name(?s, "_calloc");
    val register_import_library_r: err[fail.Fail]      = session.register_import_library(?s, imported, pin);
    if (sel register_import_library_r.err) { ret 4; }
    var provider: target_of.DynLib;
    provider.name               = pin;
    provider.soname             = lt_name(?s, "/usr/lib/libSystem.B.dylib");
    provider.include_referenced = true;

    var bytes: [8]u8;
    bin.write_u32_le(?bytes[0], 0, 0x14000000);
    bin.write_u32_le(?bytes[0], 4, 0x94000000);
    var section: target_of.Section;
    section.name  = lt_name(?s, ".text");
    section.kind  = target_of.SK_TEXT;
    section.bytes = ?bytes[0];
    section.len   = 8;
    section.align = 4;
    var symbols: [2]target_of.Symbol;
    symbols[0].name    = lt_name(?s, tgt.os.entry_symbol);
    symbols[0].section = target_of.section_id(0);
    symbols[0].offset  = 0;
    symbols[0].size    = 8;
    symbols[0].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;
    symbols[1].name    = imported;
    symbols[1].section = target_of.external_section();
    symbols[1].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_EXTERN;
    var relocations: [2]target_of.Relocation;
    relocations[0].section = target_of.section_id(0);
    relocations[0].offset  = 0;
    relocations[0].kind    = target_of.RK_JUMP26;
    relocations[0].sym     = 1;
    relocations[1].section = target_of.section_id(0);
    relocations[1].offset  = 4;
    relocations[1].kind    = target_of.RK_PLT32;
    relocations[1].sym     = 1;
    var module: target_of.ObjectImage = lt_image(?s, lt_name(?s, "tail_import"),
        ?section, 1, ?symbols[0], 2, ?relocations[0], 1);

    val fr: res[output_testing.Output, fail.Fail] = output_testing.create(?alloc, "tail_import");
    if (sel fr.err) { ret 5; }
    var file: output_testing.Output = fr.ok;
    fin { output_testing.dnit(?file); }

    val path:  str = output_testing.path(?file);
    var count: u32 = 1;
    for (count <= 2) {
        module.reloc_count = count;
        module.codegen     = true;
        val linked: err[fail.Fail] = link_modules_nocapture(?s, ?s.diags, ?tgt,
            ?module, 1, ?provider, 1, path, "tail_import"::*u8,
            catalog_artifact.EXECUTABLE, true, target_of.image_options_default(catalog_subsystem.CONSOLE));
        if (sel linked.err) { ret 6; }
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, path);
        if (sel rr.err) { ret 7; }
        var image: Vector[u8] = rr.ok;
        fin { collections_vector.dnit[u8](?image); }
        val text:  usize = lt_macho_section(image.data, "__TEXT", "__text");
        val stubs: usize = lt_macho_section(image.data, "__TEXT", "__stubs");
        if (text == 0 || stubs == 0) { ret 8; }
        val file_offset: usize = bin.read_u32_le(image.data, text + 48)::usize;
        val text_va:     u64   = bin.read_u64_le(image.data, text + 32);
        val stub_va:     u64   = bin.read_u64_le(image.data, stubs + 32);
        if (bin.read_u64_le(image.data, stubs + 40) != 12) { ret 9; }
        var i: u32 = 0;
        for (i < count) {
            val word:   u32 = bin.read_u32_le(image.data, file_offset + i::usize * 4);
            var opcode: u32 = 0x14000000;
            if (i == 1)                        { opcode = 0x94000000; }
            if ((word & 0xFC000000) != opcode) { ret 10; }
            val displacement: i64 = ((word & 0x03FFFFFF)::i32 << 6)::i64 >> 4;
            if ((text_va::i64 + i::i64 * 4 + displacement)::u64 != stub_va) { ret 11; }
            i = i + 1;
        }
        count = count + 1;
    }
    ret 0;
}

# more zero-fill than a BL reaches (+-128 MiB) between the code and the data it
# writes: the stub table is laid out at the end of the code, so the call still
# reaches its stub. a native arm64 darwin host also runs the image, which
# stores into the last byte of the zero-fill and exits through the stub
test link_modules__arm64_import_stub_beside_code_past_large_zero_fill {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("aarch64", "darwin", "aapcs64");
    if (sel tr.err) { ret 3; }
    var tgt:      lang_target.Binding = tr.ok;
    val pin:      intern.StrId        = lt_name(?s, "libSystem");
    val imported: intern.StrId        = lt_name(?s, "_exit");
    val pinned:   err[fail.Fail]      = session.register_import_library(?s, imported, pin);
    if (sel pinned.err) { ret 4; }
    var provider: target_of.DynLib;
    provider.name               = pin;
    provider.soname             = lt_name(?s, "/usr/lib/libSystem.B.dylib");
    provider.include_referenced = true;

    val zero_fill: u32 = 200000000;
    var bytes:     [16]u8;
    bin.write_u32_le(?bytes[0], 0, 0x90000001);
    bin.write_u32_le(?bytes[0], 4, 0x52800540);
    bin.write_u32_le(?bytes[0], 8, 0x39000020);
    bin.write_u32_le(?bytes[0], 12, 0x94000000);
    var sections: [2]target_of.Section;
    sections[0].name  = lt_name(?s, ".text");
    sections[0].kind  = target_of.SK_TEXT;
    sections[0].bytes = ?bytes[0];
    sections[0].len   = 16;
    sections[0].align = 4;
    sections[1].name  = lt_name(?s, ".bss");
    sections[1].kind  = target_of.SK_BSS;
    sections[1].bytes = nil;
    sections[1].len   = zero_fill;
    sections[1].align = 16;
    var symbols: [3]target_of.Symbol;
    symbols[0].name    = lt_name(?s, tgt.os.entry_symbol);
    symbols[0].section = target_of.section_id(0);
    symbols[0].size    = 16;
    symbols[0].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;
    symbols[1].name    = lt_name(?s, "zero_fill_tail");
    symbols[1].section = target_of.section_id(1);
    symbols[1].offset  = 0;
    symbols[1].size    = zero_fill;
    symbols[1].flags   = target_of.SYM_OBJ_FLAG_OBJECT;
    symbols[2].name    = imported;
    symbols[2].section = target_of.external_section();
    symbols[2].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_EXTERN;
    var relocations: [3]target_of.Relocation;
    val last:        i64 = (zero_fill - 1)::i64;
    relocations[0] = target_of.Relocation{section: target_of.section_id(0), offset: 0, kind: target_of.RK_PAGE21, sym: 1, addend: last};
    relocations[1] = target_of.Relocation{section: target_of.section_id(0), offset: 8, kind: target_of.RK_LDST8_LO12, sym: 1, addend: last};
    relocations[2] = target_of.Relocation{section: target_of.section_id(0), offset: 12, kind: target_of.RK_PLT32, sym: 2};
    var module: target_of.ObjectImage = lt_image(?s, lt_name(?s, "zero_fill"),
        ?sections[0], 2, ?symbols[0], 3, ?relocations[0], 3);

    val fr: res[output_testing.Output, fail.Fail] = output_testing.create(?alloc, "zero_fill");
    if (sel fr.err) { ret 5; }
    var file: output_testing.Output = fr.ok;
    fin { output_testing.dnit(?file); }
    # a fresh path in the fixture's directory, so the linker creates the image
    # executable as a build does; the fixture's own file stays 0600
    val named: res[str, types_string.StrError] = str_join(?alloc, file.directory, "/zero_fill");
    if (sel named.err) { ret 5; }
    val path: str = named.ok;
    fin { str_free(?alloc, path); }
    module.codegen = true;
    val linked: err[fail.Fail] = link_modules_nocapture(?s, ?s.diags, ?tgt,
        ?module, 1, ?provider, 1, path, "zero_fill"::*u8,
        catalog_artifact.EXECUTABLE, true, target_of.image_options_default(catalog_subsystem.CONSOLE));
    if (sel linked.err) { ret 6; }
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, path);
    if (sel rr.err) { ret 7; }
    var image: Vector[u8] = rr.ok;
    fin { collections_vector.dnit[u8](?image); }

    val text:  usize = lt_macho_section(image.data, "__TEXT", "__text");
    val stubs: usize = lt_macho_section(image.data, "__TEXT", "__stubs");
    val bss:   usize = lt_macho_section(image.data, "__DATA", "__bss");
    if (text == 0 || stubs == 0 || bss == 0) { ret 8; }
    val text_va: u64 = bin.read_u64_le(image.data, text + 32);
    val stub_va: u64 = bin.read_u64_le(image.data, stubs + 32);
    val bss_va:  u64 = bin.read_u64_le(image.data, bss + 32);
    if (bin.read_u64_le(image.data, bss + 40) < zero_fill::u64) { ret 9; }
    if (stub_va < text_va + 16 || stub_va + 12 > bss_va)        { ret 10; }
    if (bss_va + zero_fill::u64 - text_va < 134217728)          { ret 11; }
    val word:         u32 = bin.read_u32_le(image.data, bin.read_u32_le(image.data, text + 48)::usize + 12);
    val displacement: i64 = ((word & 0x03FFFFFF)::i32 << 6)::i64 >> 4;
    if ((word & 0xFC000000) != 0x94000000)                  { ret 12; }
    if ((text_va::i64 + 12 + displacement)::u64 != stub_va) { ret 13; }

    $if ($mach.build.os == $mach.os.darwin && $mach.build.arch == $mach.arch.aarch64) {
        var argv: [2]*u8;
        argv[0] = path::*u8;
        argv[1] = nil;
        val ran: res[exec.ExitStatus, exec.Error] = exec.run(path, ?argv[0], env.environ());
        if (sel ran.err) { ret 14; }
        if (!exec.exited(ran.ok) || exec.code(ran.ok) != 42) {
            print.eprintlnf("zero_fill image: status kind {} code {} signal {}",
                ran.ok.kind::i64, ran.ok.code::i64, ran.ok.signal::i64);
            ret 15;
        }
    }
    ret 0;
}

# more zero-fill than a rip-relative displacement reaches (+-2 GiB) between the
# code and the end of the image: the import GOT is laid out ahead of the
# zero-fill, so a stub's jmp and a GOTPCREL load still reach their slots.
# a native x86-64 darwin host also runs the image, which stores into the last
# byte of the zero-fill and exits through the stub
test link_modules__x86_64_import_got_ahead_of_large_zero_fill {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "darwin", "sysv64");
    if (sel tr.err) { ret 3; }
    var tgt:         lang_target.Binding = tr.ok;
    val pin:         intern.StrId        = lt_name(?s, "libSystem");
    val called:      intern.StrId        = lt_name(?s, "_exit");
    val loaded:      intern.StrId        = lt_name(?s, "___stderrp");
    val pinned_call: err[fail.Fail]      = session.register_import_library(?s, called, pin);
    if (sel pinned_call.err) { ret 4; }
    val pinned_load: err[fail.Fail] = session.register_import_library(?s, loaded, pin);
    if (sel pinned_load.err) { ret 4; }
    var provider: target_of.DynLib;
    provider.name               = pin;
    provider.soname             = lt_name(?s, "/usr/lib/libSystem.B.dylib");
    provider.include_referenced = true;

    # push %rbp; lea zero_fill_tail(%rip),%rax; mov ___stderrp@GOTPCREL(%rip),%rdx;
    # movabs $zero_fill-1,%rcx; mov $42,%edi; mov %dil,(%rax,%rcx); call _exit
    val zero_fill: u32   = 3000000000;
    var bytes:     [40]u8;
    var k:         usize = 0;
    for (k < 40) {
        bytes[k] = 0xCC;
        k        = k + 1;
    }
    bytes[0]  = 0x55;
    bytes[1]  = 0x48;
    bytes[2]  = 0x8D;
    bytes[3]  = 0x05;
    bytes[8]  = 0x48;
    bytes[9]  = 0x8B;
    bytes[10] = 0x15;
    bytes[15] = 0x48;
    bytes[16] = 0xB9;
    bin.write_u64_le(?bytes[0], 17, (zero_fill - 1)::u64);
    bytes[25] = 0xBF;
    bin.write_u32_le(?bytes[0], 26, 42);
    bytes[30] = 0x40;
    bytes[31] = 0x88;
    bytes[32] = 0x3C;
    bytes[33] = 0x08;
    bytes[34] = 0xE8;
    var sections: [2]target_of.Section;
    sections[0].name  = lt_name(?s, ".text");
    sections[0].kind  = target_of.SK_TEXT;
    sections[0].bytes = ?bytes[0];
    sections[0].len   = 40;
    sections[0].align = 16;
    sections[1].name  = lt_name(?s, ".bss");
    sections[1].kind  = target_of.SK_BSS;
    sections[1].bytes = nil;
    sections[1].len   = zero_fill;
    sections[1].align = 16;
    var symbols: [4]target_of.Symbol;
    symbols[0].name    = lt_name(?s, tgt.os.entry_symbol);
    symbols[0].section = target_of.section_id(0);
    symbols[0].size    = 40;
    symbols[0].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;
    symbols[1].name    = lt_name(?s, "zero_fill_tail");
    symbols[1].section = target_of.section_id(1);
    symbols[1].offset  = 0;
    symbols[1].size    = zero_fill;
    symbols[1].flags   = target_of.SYM_OBJ_FLAG_OBJECT;
    symbols[2].name    = called;
    symbols[2].section = target_of.external_section();
    symbols[2].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_EXTERN;
    symbols[3].name    = loaded;
    symbols[3].section = target_of.external_section();
    symbols[3].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_EXTERN;
    var relocations: [3]target_of.Relocation;
    relocations[0] = target_of.Relocation{section: target_of.section_id(0), offset: 4, kind: target_of.RK_PC32, sym: 1, addend: -4};
    relocations[1] = target_of.Relocation{section: target_of.section_id(0), offset: 11, kind: target_of.RK_GOTPCREL, sym: 3, addend: -4};
    relocations[2] = target_of.Relocation{section: target_of.section_id(0), offset: 35, kind: target_of.RK_PLT32, sym: 2, addend: -4};
    var module: target_of.ObjectImage = lt_image(?s, lt_name(?s, "got_ahead"),
        ?sections[0], 2, ?symbols[0], 4, ?relocations[0], 3);

    val fr: res[output_testing.Output, fail.Fail] = output_testing.create(?alloc, "got_ahead");
    if (sel fr.err) { ret 5; }
    var file: output_testing.Output = fr.ok;
    fin { output_testing.dnit(?file); }
    # a fresh path in the fixture's directory, so the linker creates the image
    # executable as a build does; the fixture's own file stays 0600
    val named: res[str, types_string.StrError] = str_join(?alloc, file.directory, "/got_ahead");
    if (sel named.err) { ret 5; }
    val path: str = named.ok;
    fin { str_free(?alloc, path); }
    module.codegen = true;
    val linked: err[fail.Fail] = link_modules_nocapture(?s, ?s.diags, ?tgt,
        ?module, 1, ?provider, 1, path, "got_ahead"::*u8,
        catalog_artifact.EXECUTABLE, true, target_of.image_options_default(catalog_subsystem.CONSOLE));
    if (sel linked.err) {
        print.eprintlnf("got_ahead link: {}", fail.describe(linked.err));
        ret 6;
    }
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, path);
    if (sel rr.err) { ret 7; }
    var image: Vector[u8] = rr.ok;
    fin { collections_vector.dnit[u8](?image); }

    val text:  usize = lt_macho_section(image.data, "__TEXT", "__text");
    val stubs: usize = lt_macho_section(image.data, "__TEXT", "__stubs");
    val got:   usize = lt_macho_section(image.data, "__DATA_CONST", "__got");
    val bss:   usize = lt_macho_section(image.data, "__DATA", "__bss");
    if (text == 0 || stubs == 0 || got == 0 || bss == 0) { ret 8; }
    val text_va:  u64   = bin.read_u64_le(image.data, text + 32);
    val stub_va:  u64   = bin.read_u64_le(image.data, stubs + 32);
    val got_va:   u64   = bin.read_u64_le(image.data, got + 32);
    val got_size: u64   = bin.read_u64_le(image.data, got + 40);
    val bss_va:   u64   = bin.read_u64_le(image.data, bss + 32);
    val text_off: usize = bin.read_u32_le(image.data, text + 48)::usize;
    val stub_off: usize = bin.read_u32_le(image.data, stubs + 48)::usize;
    if (bin.read_u64_le(image.data, bss + 40) < zero_fill::u64) { ret 9; }
    if (got_size != 16 || got_va + got_size > bss_va)           { ret 10; }
    if (bss_va + zero_fill::u64 - text_va < 2147483648)         { ret 11; }

    # the call reaches the stub, and the stub and the load each reach a slot of their own
    val call:      i64 = (bin.read_u32_le(image.data, text_off + 35)::i32)::i64;
    val stub_disp: i64 = (bin.read_u32_le(image.data, stub_off + 2)::i32)::i64;
    val load_disp: i64 = (bin.read_u32_le(image.data, text_off + 11)::i32)::i64;
    if ((text_va::i64 + 39 + call)::u64 != stub_va)                       { ret 12; }
    if (image.data[stub_off] != 0xFF || image.data[stub_off + 1] != 0x25) { ret 13; }
    val stub_slot: u64 = (stub_va::i64 + 6 + stub_disp)::u64;
    val load_slot: u64 = (text_va::i64 + 15 + load_disp)::u64;
    if (stub_slot < got_va || stub_slot + 8 > got_va + got_size) { ret 14; }
    if (load_slot < got_va || load_slot + 8 > got_va + got_size) { ret 15; }
    if (stub_slot == load_slot)                                  { ret 16; }

    $if ($mach.build.os == $mach.os.darwin && $mach.build.arch == $mach.arch.x86_64) {
        var argv: [2]*u8;
        argv[0] = path::*u8;
        argv[1] = nil;
        val ran: res[exec.ExitStatus, exec.Error] = exec.run(path, ?argv[0], env.environ());
        if (sel ran.err) { ret 17; }
        if (!exec.exited(ran.ok) || exec.code(ran.ok) != 42) {
            print.eprintlnf("got_ahead image: status kind {} code {} signal {}",
                ran.ok.kind::i64, ran.ok.code::i64, ran.ok.signal::i64);
            ret 18;
        }
    }
    ret 0;
}

# the section header named `name` in a linked ELF64 image, or 0
#[testing]
fun lt_elf_section(buf: *u8, len: usize, name: str) usize {
    if (len < 64) { ret 0; }
    val shoff:     usize = bin.read_u64_le(buf, 40)::usize;
    val shentsize: usize = bin.read_u16_le(buf, 58)::usize;
    val shnum:     usize = bin.read_u16_le(buf, 60)::usize;
    val shstrndx:  usize = bin.read_u16_le(buf, 62)::usize;
    if (shentsize < 64 || shstrndx >= shnum || shoff + shnum * shentsize > len) { ret 0; }
    val strtab: usize = bin.read_u64_le(buf, shoff + shstrndx * shentsize + 24)::usize;
    var i:      usize = 0;
    for (i < shnum) {
        val at:    usize               = shoff + i * shentsize;
        val named: res[str, fail.Fail] = bin.cstr_at(buf, len, strtab + bin.read_u32_le(buf, at)::usize);
        if (sel named.ok && str_equals(named.ok, name)) { ret at; }
        i = i + 1;
    }
    ret 0;
}

# the ELF twin of the darwin case above: more zero-fill than a BL reaches
# between the code and the data it writes. the .plt is laid out at the end of
# the code, inside the executable segment, so the call still reaches its stub
#. a native aarch64 linux host also runs the image, which stores into
# the last byte of the zero-fill and exits 42 through the PLT into libc's _exit
test link_modules__elf_arm64_plt_beside_code_past_large_zero_fill {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("aarch64", "linux", "aapcs64");
    if (sel tr.err) { ret 3; }
    var tgt:      lang_target.Binding = tr.ok;
    val pin:      intern.StrId        = lt_name(?s, "libc");
    val imported: intern.StrId        = lt_name(?s, "_exit");
    val pinned:   err[fail.Fail]      = session.register_import_library(?s, imported, pin);
    if (sel pinned.err) { ret 4; }
    var provider: target_of.DynLib;
    provider.name               = pin;
    provider.soname             = lt_name(?s, "libc.so.6");
    provider.rpath              = intern.STR_NIL;
    provider.include_referenced = true;

    val zero_fill: u32 = 200000000;
    var bytes:     [16]u8;
    bin.write_u32_le(?bytes[0], 0, 0x90000001);
    bin.write_u32_le(?bytes[0], 4, 0x52800540);
    bin.write_u32_le(?bytes[0], 8, 0x39000020);
    bin.write_u32_le(?bytes[0], 12, 0x94000000);
    var sections: [2]target_of.Section;
    sections[0].name  = lt_name(?s, ".text");
    sections[0].kind  = target_of.SK_TEXT;
    sections[0].bytes = ?bytes[0];
    sections[0].len   = 16;
    sections[0].align = 4;
    sections[1].name  = lt_name(?s, ".bss");
    sections[1].kind  = target_of.SK_BSS;
    sections[1].bytes = nil;
    sections[1].len   = zero_fill;
    sections[1].align = 16;
    var symbols: [3]target_of.Symbol;
    symbols[0].name    = lt_name(?s, tgt.os.entry_symbol);
    symbols[0].section = target_of.section_id(0);
    symbols[0].size    = 16;
    symbols[0].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;
    symbols[1].name    = lt_name(?s, "zero_fill_tail");
    symbols[1].section = target_of.section_id(1);
    symbols[1].offset  = 0;
    symbols[1].size    = zero_fill;
    symbols[1].flags   = target_of.SYM_OBJ_FLAG_OBJECT;
    symbols[2].name    = imported;
    symbols[2].section = target_of.external_section();
    symbols[2].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_EXTERN;
    var relocations: [3]target_of.Relocation;
    val last:        i64 = (zero_fill - 1)::i64;
    relocations[0] = target_of.Relocation{section: target_of.section_id(0), offset: 0, kind: target_of.RK_PAGE21, sym: 1, addend: last};
    relocations[1] = target_of.Relocation{section: target_of.section_id(0), offset: 8, kind: target_of.RK_LDST8_LO12, sym: 1, addend: last};
    relocations[2] = target_of.Relocation{section: target_of.section_id(0), offset: 12, kind: target_of.RK_PLT32, sym: 2};
    var module: target_of.ObjectImage = lt_image(?s, lt_name(?s, "zero_fill"),
        ?sections[0], 2, ?symbols[0], 3, ?relocations[0], 3);

    val fr: res[output_testing.Output, fail.Fail] = output_testing.create(?alloc, "elf_zero_fill");
    if (sel fr.err) { ret 5; }
    var file: output_testing.Output = fr.ok;
    fin { output_testing.dnit(?file); }
    # a fresh path in the fixture's directory, so the linker creates the image
    # executable as a build does; the fixture's own file stays 0600
    val named: res[str, types_string.StrError] = str_join(?alloc, file.directory, "/elf_zero_fill");
    if (sel named.err) { ret 5; }
    val path: str = named.ok;
    fin { str_free(?alloc, path); }
    module.codegen = true;
    val linked: err[fail.Fail] = link_modules_nocapture(?s, ?s.diags, ?tgt,
        ?module, 1, ?provider, 1, path, "elf_zero_fill"::*u8,
        catalog_artifact.EXECUTABLE, false, target_of.image_options_default(catalog_subsystem.CONSOLE));
    if (sel linked.err) {
        print.eprintlnf("elf_zero_fill link: {}", fail.describe(linked.err));
        ret 6;
    }
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, path);
    if (sel rr.err) { ret 7; }
    var image: Vector[u8] = rr.ok;
    fin { collections_vector.dnit[u8](?image); }

    val text: usize = lt_elf_section(image.data, image.len, ".text");
    val plt:  usize = lt_elf_section(image.data, image.len, ".plt");
    val bss:  usize = lt_elf_section(image.data, image.len, ".bss");
    if (text == 0 || plt == 0 || bss == 0) { ret 8; }
    val text_va: u64 = bin.read_u64_le(image.data, text + 16);
    val plt_va:  u64 = bin.read_u64_le(image.data, plt + 16);
    val bss_va:  u64 = bin.read_u64_le(image.data, bss + 16);
    if (bin.read_u64_le(image.data, bss + 32) < zero_fill::u64) { ret 9; }
    if (plt_va < text_va + 16 || plt_va + 16 > bss_va)          { ret 10; }
    if (bss_va + zero_fill::u64 - text_va < 134217728)          { ret 11; }
    val word:         u32 = bin.read_u32_le(image.data, bin.read_u64_le(image.data, text + 24)::usize + 12);
    val displacement: i64 = ((word & 0x03FFFFFF)::i32 << 6)::i64 >> 4;
    if ((word & 0xFC000000) != 0x94000000)                 { ret 12; }
    if ((text_va::i64 + 12 + displacement)::u64 != plt_va) { ret 13; }

    # the PLT is mapped by an executable load segment, not a segment of its own
    val phoff:  usize = bin.read_u64_le(image.data, 32)::usize;
    val phnum:  usize = bin.read_u16_le(image.data, 56)::usize;
    var mapped: bool  = false;
    var p:      usize = 0;
    for (p < phnum) {
        val at: usize = phoff + p * 56;
        if (bin.read_u32_le(image.data, at) == 1) {
            val va: u64 = bin.read_u64_le(image.data, at + 16);
            val sz: u64 = bin.read_u64_le(image.data, at + 32);
            if (plt_va >= va && plt_va + 16 <= va + sz) {
                if ((bin.read_u32_le(image.data, at + 4) & 1) == 0 || plt_va - va < 16) { ret 14; }
                mapped = true;
            }
        }
        p = p + 1;
    }
    if (!mapped) { ret 15; }

    $if ($mach.build.os == $mach.os.linux && $mach.build.arch == $mach.arch.aarch64) {
        var argv: [2]*u8;
        argv[0] = path::*u8;
        argv[1] = nil;
        val ran: res[exec.ExitStatus, exec.Error] = exec.run(path, ?argv[0], env.environ());
        if (sel ran.err) { ret 16; }
        if (!exec.exited(ran.ok) || exec.code(ran.ok) != 42) {
            print.eprintlnf("elf_zero_fill image: status kind {} code {} signal {}",
                ran.ok.kind::i64, ran.ok.code::i64, ran.ok.signal::i64);
            ret 17;
        }
    }
    ret 0;
}

test local_got_plan__arm64_function_pointer_slot {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val selected: res[lang_target.Binding, fail.Fail] = lang_target.t_select("aarch64", "linux", "aapcs64");
    if (sel selected.err) { ret 3; }
    var tgt:   lang_target.Binding = selected.ok;
    var bytes: [24]u8;
    bin.write_u32_le(?bytes[0], 0, 0x90000000);
    bin.write_u32_le(?bytes[0], 4, 0xF9400000);
    bin.write_u32_le(?bytes[0], 8, 0x94000000);
    bin.write_u32_le(?bytes[0], 12, 0xD65F03C0);
    bin.write_u32_le(?bytes[0], 16, 0xD503201F);
    bin.write_u32_le(?bytes[0], 20, 0xD65F03C0);
    var section: target_of.Section;
    section.name  = lt_name(?s, ".text");
    section.kind  = target_of.SK_TEXT;
    section.bytes = ?bytes[0];
    section.len   = 24;
    section.align = 4;
    var symbols: [2]target_of.Symbol;
    symbols[0].name    = lt_name(?s, tgt.os.entry_symbol);
    symbols[0].section = target_of.section_id(0);
    symbols[0].offset  = 0;
    symbols[0].size    = 20;
    symbols[0].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;
    symbols[1].name    = lt_name(?s, "got_function");
    symbols[1].section = target_of.section_id(0);
    symbols[1].offset  = 20;
    symbols[1].size    = 4;
    symbols[1].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;
    var relocs: [3]target_of.Relocation;
    relocs[0].section = target_of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].sym     = 1;
    relocs[0].kind    = target_of.RK_GOT_PAGE21;
    relocs[1].section = target_of.section_id(0);
    relocs[1].offset  = 4;
    relocs[1].sym     = 1;
    relocs[1].kind    = target_of.RK_GOT_LO12;
    relocs[2].section = target_of.section_id(0);
    relocs[2].offset  = 8;
    relocs[2].sym     = 1;
    relocs[2].kind    = target_of.RK_PLT32;
    var module: target_of.ObjectImage = lt_image(?s, lt_name(?s, "arm-got"), ?section, 1,
        ?symbols[0], 2, ?relocs[0], 3);
    val created: res[output_testing.Output, fail.Fail] = output_testing.create(?alloc, "arm_got_pointer");
    if (sel created.err) { ret 4; }
    var file: output_testing.Output = created.ok;
    fin { output_testing.dnit(?file); }

    val linked: err[fail.Fail] = link_modules_nocapture(?s, ?s.diags, ?tgt,
        ?module, 1, nil::*target_of.DynLib, 0, output_testing.path(?file), "arm-got"::*u8,
        catalog_artifact.EXECUTABLE, false, target_of.image_options_default(catalog_subsystem.CONSOLE));
    if (sel linked.err) { ret 5; }
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, output_testing.path(?file));
    if (sel read.err) { ret 6; }
    var image: Vector[u8] = read.ok;
    fin { collections_vector.dnit[u8](?image); }
    if (image.len < 64) { ret 7; }
    val entry: u64 = bin.read_u64_le(image.data, 24);
    val phoff: u64 = bin.read_u64_le(image.data, 32);
    val phnum: u32 = bin.read_u16_le(image.data, 56)::u32;
    if (bin.read_u16_le(image.data, 54) != 56 || phoff > image.len::u64
        || phnum::u64 > (image.len::u64 - phoff) / 56) { ret 7; }
    var text_off: usize = 0;
    var i:        u32   = 0;
    for (i < phnum) {
        val ph:   usize = phoff::usize + i::usize * 56;
        val va:   u64   = bin.read_u64_le(image.data, ph + 16);
        val size: u64   = bin.read_u64_le(image.data, ph + 32);
        val off:  u64   = bin.read_u64_le(image.data, ph + 8);
        if (bin.read_u32_le(image.data, ph) == 1 && entry >= va && entry - va < size) {
            if (off > image.len::u64 || size > image.len::u64 - off || size - (entry - va) < 12) { ret 7; }
            text_off = (off + entry - va)::usize;
        }
        i = i + 1;
    }
    if (text_off == 0) { ret 8; }
    val adrp: u32 = bin.read_u32_le(image.data, text_off);
    val ldr:  u32 = bin.read_u32_le(image.data, text_off + 4);
    val call: u32 = bin.read_u32_le(image.data, text_off + 8);
    if ((adrp & 0x9F00001F) != 0x90000000 || (ldr & 0xFFC003FF) != 0xF9400000
        || (call & 0xFC000000) != 0x94000000) { ret 9; }
    val page_bits:  u32 = ((adrp >> 29) & 3) | (((adrp >> 5) & 0x7FFFF) << 2);
    val page_delta: i64 = ((page_bits::i32 << 11) >> 11)::i64 * 4096;
    val slot:       u64 = ((entry & 0xFFFFFFFFFFFFF000)::i64 + page_delta)::u64 + ((ldr >> 10) & 0xFFF)::u64 * 8;
    val call_delta: i64 = (((call & 0x03FFFFFF)::i32 << 6) >> 4)::i64;
    val function:   u64 = (entry::i64 + 8 + call_delta)::u64;
    if (function != entry + 20 || (function & 7) != 4 || (slot & 7) != 0 || slot == function) { ret 10; }
    i = 0;
    for (i < phnum) {
        val ph:   usize = phoff::usize + i::usize * 56;
        val va:   u64   = bin.read_u64_le(image.data, ph + 16);
        val size: u64   = bin.read_u64_le(image.data, ph + 32);
        val off:  u64   = bin.read_u64_le(image.data, ph + 8);
        if (bin.read_u32_le(image.data, ph) == 1 && slot >= va && slot - va < size) {
            if (off > image.len::u64 || size > image.len::u64 - off || size - (slot - va) < 8) { ret 11; }
            if (bin.read_u64_le(image.data, (off + slot - va)::usize) != function)             { ret 12; }
            ret 0;
        }
        i = i + 1;
    }
    ret 13;
}

#[testing]
rec TestElfLoad {
    offset:    usize;
    remaining: u64;
}

#[testing]
fun t_elf_load(image: *Vector[u8], address: u64, width: u64) res[TestElfLoad, fail.Fail] {
    if (image.len < 64) { ret res[TestElfLoad, fail.Fail].err{fail.message("short ELF header")}; }
    var phoff:  u64 = bin.read_u64_le(image.data, 32);
    var phnum:  u32 = bin.read_u16_le(image.data, 56)::u32;
    var stride: u32 = 56;
    if (image.data[4] == 1) {
        phoff  = bin.read_u32_le(image.data, 28)::u64;
        phnum  = bin.read_u16_le(image.data, 44)::u32;
        stride = 32;
        if (bin.read_u16_le(image.data, 42) != 32) { ret res[TestElfLoad, fail.Fail].err{fail.message("invalid ELF32 program header")}; }
    }
    or {
        if (image.data[4] != 2 || bin.read_u16_le(image.data, 54) != 56) { ret res[TestElfLoad, fail.Fail].err{fail.message("invalid ELF64 program header")}; }
    }
    if (phoff > image.len::u64 || phnum::u64 > (image.len::u64 - phoff) / stride::u64) {
        ret res[TestElfLoad, fail.Fail].err{fail.message("program headers exceed ELF image")};
    }
    var i: u32 = 0;
    for (i < phnum) {
        val ph:   usize = phoff::usize + i::usize * stride::usize;
        var va:   u64   = 0;
        var size: u64   = 0;
        var off:  u64   = 0;
        if (stride == 32) {
            va   = bin.read_u32_le(image.data, ph + 8)::u64;
            size = bin.read_u32_le(image.data, ph + 16)::u64;
            off  = bin.read_u32_le(image.data, ph + 4)::u64;
        }
        or {
            va   = bin.read_u64_le(image.data, ph + 16);
            size = bin.read_u64_le(image.data, ph + 32);
            off  = bin.read_u64_le(image.data, ph + 8);
        }
        if (bin.read_u32_le(image.data, ph) == 1 && address >= va && address - va < size) {
            if (off > image.len::u64 || size > image.len::u64 - off || size - (address - va) < width) {
                ret res[TestElfLoad, fail.Fail].err{fail.message("load range exceeds ELF image")};
            }
            ret res[TestElfLoad, fail.Fail].ok{TestElfLoad{offset: (off + address - va)::usize, remaining: size - (address - va)}};
        }
        i = i + 1;
    }
    ret res[TestElfLoad, fail.Fail].err{fail.message("ELF address is not file backed")};
}

#[testing]
fun t_riscv_got_pointer(arch: str, abi: str, width: u32) i32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var system: str = "linux";
    if (width == 4) { system = "freestanding"; }
    val selected: res[lang_target.Binding, fail.Fail] = lang_target.select_of(lang_target.t_registry(), arch, system, abi, "elf");
    if (sel selected.err) { ret 3; }
    var tgt:   lang_target.Binding = selected.ok;
    var bytes: [24]u8;
    bin.write_u32_le(?bytes[0], 0, 0x00000517);
    var load: u32 = 0x00053503;
    if (width == 4) { load = 0x00052503; }
    bin.write_u32_le(?bytes[0], 4, load);
    bin.write_u32_le(?bytes[0], 8, 0x00000097);
    bin.write_u32_le(?bytes[0], 12, 0x000080E7);
    bin.write_u32_le(?bytes[0], 16, 0x00008067);
    bin.write_u32_le(?bytes[0], 20, 0x00008067);
    var section: target_of.Section;
    section.name  = lt_name(?s, ".text");
    section.kind  = target_of.SK_TEXT;
    section.bytes = ?bytes[0];
    section.len   = 24;
    section.align = 4;
    var symbols: [3]target_of.Symbol;
    symbols[0].name    = lt_name(?s, tgt.os.entry_symbol);
    symbols[0].section = target_of.section_id(0);
    symbols[0].offset  = 0;
    symbols[0].size    = 20;
    symbols[0].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;
    symbols[1].name    = lt_name(?s, "got_function");
    symbols[1].section = target_of.section_id(0);
    symbols[1].offset  = 20;
    symbols[1].size    = 4;
    symbols[1].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;
    symbols[2].name    = lt_name(?s, ".Lgot_high");
    symbols[2].section = target_of.section_id(0);
    symbols[2].offset  = 0;
    var relocs: [3]target_of.Relocation;
    relocs[0].section = target_of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].sym     = 1;
    relocs[0].kind    = target_of.RK_GOT_PCREL_HI20;
    relocs[1].section = target_of.section_id(0);
    relocs[1].offset  = 4;
    relocs[1].sym     = 2;
    relocs[1].kind    = target_of.RK_PCREL_LO12_I;
    relocs[2].section = target_of.section_id(0);
    relocs[2].offset  = 8;
    relocs[2].sym     = 1;
    relocs[2].kind    = target_of.RK_PLT32;
    var module: target_of.ObjectImage = lt_image(?s, lt_name(?s, "riscv-got"), ?section, 1,
        ?symbols[0], 3, ?relocs[0], 3);
    val r_13044: err[fail.Fail] = of_reloc.normalize_image(tgt.isa, ?alloc, ?module);
    if (sel r_13044.err) { ret 4; }
    val created: res[output_testing.Output, fail.Fail] = output_testing.create(?alloc, "riscv_got_pointer");
    if (sel created.err) { ret 5; }
    var file: output_testing.Output = created.ok;
    fin { output_testing.dnit(?file); }

    val linked: err[fail.Fail] = link_modules_nocapture(?s, ?s.diags, ?tgt,
        ?module, 1, nil::*target_of.DynLib, 0, output_testing.path(?file), "riscv-got"::*u8,
        catalog_artifact.EXECUTABLE, false, target_of.image_options_default(catalog_subsystem.CONSOLE));
    if (sel linked.err) {
        val message: str = fail.describe(linked.err);
        system_os.write(2, message::*u8, str_len(message));
        ret 6;
    }
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, output_testing.path(?file));
    if (sel read.err) { ret 7; }
    var image: Vector[u8] = read.ok;
    fin { collections_vector.dnit[u8](?image); }
    if (image.len < 64) { ret 8; }
    var entry: u64 = bin.read_u64_le(image.data, 24);
    if (width == 4) { entry = bin.read_u32_le(image.data, 24)::u64; }
    val code: res[TestElfLoad, fail.Fail] = t_elf_load(?image, entry, 16);
    if (sel code.err) { ret 8; }
    val off:       usize = code.ok.offset;
    val high:      u32   = bin.read_u32_le(image.data, off);
    val low:       u32   = bin.read_u32_le(image.data, off + 4);
    val call_high: u32   = bin.read_u32_le(image.data, off + 8);
    val call_low:  u32   = bin.read_u32_le(image.data, off + 12);
    if ((high & 0xFFF) != 0x517 || (low & 0xFFFFF) != load
        || (call_high & 0xFFF) != 0x97 || (call_low & 0xFFFFF) != 0x80E7) { ret 9; }
    val slot:     u64 = (entry::i64 + (high & 0xFFFFF000)::i32::i64 + (low::i32 >> 20)::i64)::u64;
    val function: u64 = (entry::i64 + 8 + (call_high & 0xFFFFF000)::i32::i64 + (call_low::i32 >> 20)::i64)::u64;
    if (function != entry + 20 || slot == function || slot % width::u64 != 0) { ret 10; }
    val pointer: res[TestElfLoad, fail.Fail] = t_elf_load(?image, slot, width::u64);
    if (sel pointer.err) { ret 11; }
    val found: TestElfLoad = pointer.ok;
    if (found.remaining != width::u64) { ret 12; }
    var stored: u64 = 0;
    if (width == 4)         { stored = bin.read_u32_le(image.data, found.offset)::u64; }
    or                      { stored = bin.read_u64_le(image.data, found.offset); }
    if (stored != function) { ret 13; }
    ret 0;
}

test local_got_plan__riscv32_paired_pointer_slot {
    ret t_riscv_got_pointer("riscv32", "ilp32", 4);
}

test local_got_plan__riscv64_paired_pointer_slot {
    ret t_riscv_got_pointer("riscv64", "lp64", 8);
}
