test "mach.lang.be.linker.link_modules:arm64_import_tail_branch" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_12755: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_12755.err) { ret 2; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "aarch64", "darwin", "aapcs64");
    if (sel tr.err) { ret 3; }
    var tgt: target.Target = tr.ok;
    val pin: intern.StrId = lt_name(?s, "libSystem");
    val imported: intern.StrId = lt_name(?s, "_calloc");
    val register_import_library_r: err[fail.Fail] = session.register_import_library(?s, imported, pin);
    if (sel register_import_library_r.err) { ret 4; }
    var provider: of.DynLib;
    provider.name = pin;
    provider.soname = lt_name(?s, "/usr/lib/libSystem.B.dylib");
    provider.include_referenced = true;

    var bytes: [8]u8;
    bin.write_u32_le(?bytes[0], 0, 0x14000000);
    bin.write_u32_le(?bytes[0], 4, 0x94000000);
    var section: of.Section;
    section.name = lt_name(?s, ".text"); section.kind = of.SK_TEXT;
    section.bytes = ?bytes[0]; section.len = 8; section.align = 4;
    var symbols: [2]of.Symbol;
    symbols[0].name = lt_name(?s, tgt.os.entry_symbol);
    symbols[0].section = of.section_id(0); symbols[0].offset = 0; symbols[0].size = 8;
    symbols[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    symbols[1].name = imported; symbols[1].section = of.external_section();
    symbols[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;
    var relocations: [2]of.Relocation;
    relocations[0].section = of.section_id(0); relocations[0].offset = 0;
    relocations[0].kind = of.RK_JUMP26; relocations[0].sym = 1;
    relocations[1].section = of.section_id(0); relocations[1].offset = 4;
    relocations[1].kind = of.RK_PLT32; relocations[1].sym = 1;
    var module: of.ObjectImage = lt_image(?s, lt_name(?s, "tail_import"),
        ?section, 1, ?symbols[0], 2, ?relocations[0], 1);

    val fr: res[output.Output, outcome.Fail] = output.create(?alloc, "tail_import");
    if (sel fr.err) { ret 5; }
    var file: output.Output = fr.ok;
    fin { output.dnit(?file); }

    val path: str = output.path(?file);
    var count: u32 = 1;
    for (count <= 2) {
        module.reloc_count = count;
        val linked: err[fail.Fail] = t_planned_link_modules_nocapture(?s, ?tgt,
            ?module, 1, 1, ?provider, 1, path::*u8, "tail_import"::*u8,
            LINK_EXE, true, of.image_options_default(of.SUBSYSTEM_CONSOLE));
        if (sel linked.err) { ret 6; }
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, path);
        if (sel rr.err) { ret 7; }
        var image: Vector[u8] = rr.ok;
        fin { vector.dnit[u8](?image); }
        val text: usize = lt_macho_section(image.data, "__TEXT", "__text");
        val stubs: usize = lt_macho_section(image.data, "__STUBS", "__stubs");
        if (text == 0 || stubs == 0) { ret 8; }
        val file_offset: usize = bin.read_u32_le(image.data, text + 48)::usize;
        val text_va: u64 = bin.read_u64_le(image.data, text + 32);
        val stub_va: u64 = bin.read_u64_le(image.data, stubs + 32);
        if (bin.read_u64_le(image.data, stubs + 40) != 12) { ret 9; }
        var i: u32 = 0;
        for (i < count) {
            val word: u32 = bin.read_u32_le(image.data, file_offset + i::usize * 4);
            var opcode: u32 = 0x14000000;
            if (i == 1) { opcode = 0x94000000; }
            if ((word & 0xFC000000) != opcode) { ret 10; }
            val displacement: i64 = ((word & 0x03FFFFFF)::i32 << 6)::i64 >> 4;
            if ((text_va::i64 + i::i64 * 4 + displacement)::u64 != stub_va) { ret 11; }
            i = i + 1;
        }
        count = count + 1;
    }
    val refused: err[fail.Fail] = t_planned_link_modules_nocapture(?s, ?tgt,
        ?module, 1, 1, nil::*of.DynLib, 0, path::*u8, "tail_import"::*u8,
        LINK_EXE, true, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (!sel refused.err) { ret 12; }
    if (!str_contains(fail.describe(refused.err), "not among the link's dependencies")) { ret 12; }
    ret 0;
}

test "mach.lang.be.linker.publication_fixtures:independent_owners" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val first: res[output.Output, outcome.Fail] = output.create(?alloc, "linker_owner_first");
    if (sel first.err) { ret 1; }
    var a: output.Output = first.ok;
    fin { output.dnit(?a); }

    val second: res[output.Output, outcome.Fail] = output.create(?alloc, "linker_owner_second");
    if (sel second.err) { ret 2; }
    var b: output.Output = second.ok;
    fin { output.dnit(?b); }

    var one: publication.Plan;
    fin { publication.plan_dnit(?one); }
    val opened_one: res[*publication.Destination, fail.Fail] = t_publication_open(?one, ?alloc, output.path(?a));
    if (sel opened_one.err) { ret 3; }
    var two: publication.Plan;
    fin { publication.plan_dnit(?two); }
    val opened_two: res[*publication.Destination, fail.Fail] = t_publication_open(?two, ?alloc, output.path(?b));
    if (sel opened_two.err) { ret 4; }
    val plan_dnit_r: err[txn.Error] = publication.plan_dnit(?two);
    if (sel plan_dnit_r.err) { ret 5; }
    val plan_dnit_r2: err[txn.Error] = publication.plan_dnit(?one);
    if (sel plan_dnit_r2.err) { ret 6; }
    ret 0;
}

test "mach.lang.be.linker.local_got_plan:arm64_function_pointer_slot" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var registry: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?registry); }
    val r_12869: err[fail.Fail] = target.register_all(?registry, target_testing.debug_descriptor);
    if (sel r_12869.err) { ret 2; }
    val selected: res[target.Target, fail.Fail] = target.select(?registry, "aarch64", "linux", "aapcs64");
    if (sel selected.err) { ret 3; }
    var tgt: target.Target = selected.ok;
    var bytes: [24]u8;
    bin.write_u32_le(?bytes[0], 0, 0x90000000);
    bin.write_u32_le(?bytes[0], 4, 0xF9400000);
    bin.write_u32_le(?bytes[0], 8, 0x94000000);
    bin.write_u32_le(?bytes[0], 12, 0xD65F03C0);
    bin.write_u32_le(?bytes[0], 16, 0xD503201F);
    bin.write_u32_le(?bytes[0], 20, 0xD65F03C0);
    var section: of.Section;
    section.name = lt_name(?s, ".text"); section.kind = of.SK_TEXT;
    section.bytes = ?bytes[0]; section.len = 24; section.align = 4;
    var symbols: [2]of.Symbol;
    symbols[0].name = lt_name(?s, tgt.os.entry_symbol);
    symbols[0].section = of.section_id(0); symbols[0].offset = 0; symbols[0].size = 20;
    symbols[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    symbols[1].name = lt_name(?s, "got_function");
    symbols[1].section = of.section_id(0); symbols[1].offset = 20; symbols[1].size = 4;
    symbols[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var relocs: [3]of.Relocation;
    relocs[0].section = of.section_id(0); relocs[0].offset = 0; relocs[0].sym = 1; relocs[0].kind = of.RK_GOT_PAGE21;
    relocs[1].section = of.section_id(0); relocs[1].offset = 4; relocs[1].sym = 1; relocs[1].kind = of.RK_GOT_LO12;
    relocs[2].section = of.section_id(0); relocs[2].offset = 8; relocs[2].sym = 1; relocs[2].kind = of.RK_PLT32;
    var module: of.ObjectImage = lt_image(?s, lt_name(?s, "arm-got"), ?section, 1,
        ?symbols[0], 2, ?relocs[0], 3);
    val created: res[output.Output, outcome.Fail] = output.create(?alloc, "arm_got_pointer");
    if (sel created.err) { ret 4; }
    var file: output.Output = created.ok;
    fin { output.dnit(?file); }

    val linked: err[fail.Fail] = t_planned_link_modules_nocapture(?s, ?tgt,
        ?module, 1, 0, nil::*of.DynLib, 0, output.path(?file)::*u8, "arm-got"::*u8,
        LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel linked.err) { ret 5; }
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, output.path(?file));
    if (sel read.err) { ret 6; }
    var image: Vector[u8] = read.ok;
    fin { vector.dnit[u8](?image); }
    if (image.len < 64) { ret 7; }
    val entry: u64 = bin.read_u64_le(image.data, 24);
    val phoff: u64 = bin.read_u64_le(image.data, 32);
    val phnum: u32 = bin.read_u16_le(image.data, 56)::u32;
    if (bin.read_u16_le(image.data, 54) != 56 || phoff > image.len::u64
        || phnum::u64 > (image.len::u64 - phoff) / 56) { ret 7; }
    var text_off: usize = 0;
    var i: u32 = 0;
    for (i < phnum) {
        val ph: usize = phoff::usize + i::usize * 56;
        val va: u64 = bin.read_u64_le(image.data, ph + 16);
        val size: u64 = bin.read_u64_le(image.data, ph + 32);
        val off: u64 = bin.read_u64_le(image.data, ph + 8);
        if (bin.read_u32_le(image.data, ph) == 1 && entry >= va && entry - va < size) {
            if (off > image.len::u64 || size > image.len::u64 - off || size - (entry - va) < 12) { ret 7; }
            text_off = (off + entry - va)::usize;
        }
        i = i + 1;
    }
    if (text_off == 0) { ret 8; }
    val adrp: u32 = bin.read_u32_le(image.data, text_off);
    val ldr: u32 = bin.read_u32_le(image.data, text_off + 4);
    val call: u32 = bin.read_u32_le(image.data, text_off + 8);
    if ((adrp & 0x9F00001F) != 0x90000000 || (ldr & 0xFFC003FF) != 0xF9400000
        || (call & 0xFC000000) != 0x94000000) { ret 9; }
    val page_bits: u32 = ((adrp >> 29) & 3) | (((adrp >> 5) & 0x7FFFF) << 2);
    val page_delta: i64 = ((page_bits::i32 << 11) >> 11)::i64 * 4096;
    val slot: u64 = ((entry & 0xFFFFFFFFFFFFF000)::i64 + page_delta)::u64 + ((ldr >> 10) & 0xFFF)::u64 * 8;
    val call_delta: i64 = (((call & 0x03FFFFFF)::i32 << 6) >> 4)::i64;
    val function: u64 = (entry::i64 + 8 + call_delta)::u64;
    if (function != entry + 20 || (function & 7) != 4 || (slot & 7) != 0 || slot == function) { ret 10; }
    i = 0;
    for (i < phnum) {
        val ph: usize = phoff::usize + i::usize * 56;
        val va: u64 = bin.read_u64_le(image.data, ph + 16);
        val size: u64 = bin.read_u64_le(image.data, ph + 32);
        val off: u64 = bin.read_u64_le(image.data, ph + 8);
        if (bin.read_u32_le(image.data, ph) == 1 && slot >= va && slot - va < size) {
            if (off > image.len::u64 || size > image.len::u64 - off || size - (slot - va) < 8) { ret 11; }
            if (bin.read_u64_le(image.data, (off + slot - va)::usize) != function) { ret 12; }
            ret 0;
        }
        i = i + 1;
    }
    ret 13;
}

rec TestElfLoad {
    offset: usize;
    remaining: u64;
}

fun t_elf_load(image: *Vector[u8], address: u64, width: u64) res[TestElfLoad, fail.Fail] {
    if (image.len < 64) { ret res[TestElfLoad, fail.Fail].err{fail.message("short ELF header")}; }
    var phoff: u64 = bin.read_u64_le(image.data, 32);
    var phnum: u32 = bin.read_u16_le(image.data, 56)::u32;
    var stride: u32 = 56;
    if (image.data[4] == 1) {
        phoff = bin.read_u32_le(image.data, 28)::u64;
        phnum = bin.read_u16_le(image.data, 44)::u32;
        stride = 32;
        if (bin.read_u16_le(image.data, 42) != 32) { ret res[TestElfLoad, fail.Fail].err{fail.message("invalid ELF32 program header")}; }
    } or {
        if (image.data[4] != 2 || bin.read_u16_le(image.data, 54) != 56) { ret res[TestElfLoad, fail.Fail].err{fail.message("invalid ELF64 program header")}; }
    }
    if (phoff > image.len::u64 || phnum::u64 > (image.len::u64 - phoff) / stride::u64) {
        ret res[TestElfLoad, fail.Fail].err{fail.message("program headers exceed ELF image")};
    }
    var i: u32 = 0;
    for (i < phnum) {
        val ph: usize = phoff::usize + i::usize * stride::usize;
        var va: u64 = 0;
        var size: u64 = 0;
        var off: u64 = 0;
        if (stride == 32) {
            va = bin.read_u32_le(image.data, ph + 8)::u64;
            size = bin.read_u32_le(image.data, ph + 16)::u64;
            off = bin.read_u32_le(image.data, ph + 4)::u64;
        } or {
            va = bin.read_u64_le(image.data, ph + 16);
            size = bin.read_u64_le(image.data, ph + 32);
            off = bin.read_u64_le(image.data, ph + 8);
        }
        if (bin.read_u32_le(image.data, ph) == 1 && address >= va && address - va < size) {
            if (off > image.len::u64 || size > image.len::u64 - off || size - (address - va) < width) {
                ret res[TestElfLoad, fail.Fail].err{fail.message("load range exceeds ELF image")};
            }
            ret res[TestElfLoad, fail.Fail].ok{TestElfLoad{offset: (off + address - va)::usize, remaining: size - (address - va)}};
        }
        i = i + 1;
    }
    ret res[TestElfLoad, fail.Fail].err{fail.message("ELF address is not file backed")};
}

fun t_riscv_got_pointer(arch: str, abi: str, width: u32) i32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var registry: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?registry); }
    val r_13012: err[fail.Fail] = target.register_all(?registry, target_testing.debug_descriptor);
    if (sel r_13012.err) { ret 2; }
    var system: str = "linux";
    if (width == 4) { system = "freestanding"; }
    val selected: res[target.Target, fail.Fail] = target.select_of(?registry, arch, system, abi, "elf");
    if (sel selected.err) { ret 3; }
    var tgt: target.Target = selected.ok;
    var bytes: [24]u8;
    bin.write_u32_le(?bytes[0], 0, 0x00000517);
    var load: u32 = 0x00053503;
    if (width == 4) { load = 0x00052503; }
    bin.write_u32_le(?bytes[0], 4, load);
    bin.write_u32_le(?bytes[0], 8, 0x00000097);
    bin.write_u32_le(?bytes[0], 12, 0x000080E7);
    bin.write_u32_le(?bytes[0], 16, 0x00008067);
    bin.write_u32_le(?bytes[0], 20, 0x00008067);
    var section: of.Section;
    section.name = lt_name(?s, ".text"); section.kind = of.SK_TEXT;
    section.bytes = ?bytes[0]; section.len = 24; section.align = 4;
    var symbols: [3]of.Symbol;
    symbols[0].name = lt_name(?s, tgt.os.entry_symbol);
    symbols[0].section = of.section_id(0); symbols[0].offset = 0; symbols[0].size = 20;
    symbols[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    symbols[1].name = lt_name(?s, "got_function");
    symbols[1].section = of.section_id(0); symbols[1].offset = 20; symbols[1].size = 4;
    symbols[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    symbols[2].name = lt_name(?s, ".Lgot_high"); symbols[2].section = of.section_id(0); symbols[2].offset = 0;
    var relocs: [3]of.Relocation;
    relocs[0].section = of.section_id(0); relocs[0].offset = 0; relocs[0].sym = 1; relocs[0].kind = of.RK_GOT_PCREL_HI20;
    relocs[1].section = of.section_id(0); relocs[1].offset = 4; relocs[1].sym = 2; relocs[1].kind = of.RK_PCREL_LO12_I;
    relocs[2].section = of.section_id(0); relocs[2].offset = 8; relocs[2].sym = 1; relocs[2].kind = of.RK_PLT32;
    var module: of.ObjectImage = lt_image(?s, lt_name(?s, "riscv-got"), ?section, 1,
        ?symbols[0], 3, ?relocs[0], 3);
    val r_13044: err[fail.Fail] = rel.normalize_image(tgt.isa, ?alloc, ?module);
    if (sel r_13044.err) { ret 4; }
    val created: res[output.Output, outcome.Fail] = output.create(?alloc, "riscv_got_pointer");
    if (sel created.err) { ret 5; }
    var file: output.Output = created.ok;
    fin { output.dnit(?file); }

    val linked: err[fail.Fail] = t_planned_link_modules_nocapture(?s, ?tgt,
        ?module, 1, 0, nil::*of.DynLib, 0, output.path(?file)::*u8, "riscv-got"::*u8,
        LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel linked.err) {
        val message: str = fail.describe(linked.err);
        os.write(2, message::*u8, str_len(message));
        ret 6;
    }
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, output.path(?file));
    if (sel read.err) { ret 7; }
    var image: Vector[u8] = read.ok;
    fin { vector.dnit[u8](?image); }
    if (image.len < 64) { ret 8; }
    var entry: u64 = bin.read_u64_le(image.data, 24);
    if (width == 4) { entry = bin.read_u32_le(image.data, 24)::u64; }
    val code: res[TestElfLoad, fail.Fail] = t_elf_load(?image, entry, 16);
    if (sel code.err) { ret 8; }
    val off: usize = code.ok.offset;
    val high: u32 = bin.read_u32_le(image.data, off);
    val low: u32 = bin.read_u32_le(image.data, off + 4);
    val call_high: u32 = bin.read_u32_le(image.data, off + 8);
    val call_low: u32 = bin.read_u32_le(image.data, off + 12);
    if ((high & 0xFFF) != 0x517 || (low & 0xFFFFF) != load
        || (call_high & 0xFFF) != 0x97 || (call_low & 0xFFFFF) != 0x80E7) { ret 9; }
    val slot: u64 = (entry::i64 + (high & 0xFFFFF000)::i32::i64 + (low::i32 >> 20)::i64)::u64;
    val function: u64 = (entry::i64 + 8 + (call_high & 0xFFFFF000)::i32::i64 + (call_low::i32 >> 20)::i64)::u64;
    if (function != entry + 20 || slot == function || slot % width::u64 != 0) { ret 10; }
    val pointer: res[TestElfLoad, fail.Fail] = t_elf_load(?image, slot, width::u64);
    if (sel pointer.err) { ret 11; }
    val found: TestElfLoad = pointer.ok;
    if (found.remaining != width::u64) { ret 12; }
    var stored: u64 = 0;
    if (width == 4) { stored = bin.read_u32_le(image.data, found.offset)::u64; }
    or { stored = bin.read_u64_le(image.data, found.offset); }
    if (stored != function) { ret 13; }
    ret 0;
}

test "mach.lang.be.linker.local_got_plan:riscv32_paired_pointer_slot" {
    ret t_riscv_got_pointer("riscv32", "ilp32", 4);
}

test "mach.lang.be.linker.local_got_plan:riscv64_paired_pointer_slot" {
    ret t_riscv_got_pointer("riscv64", "lp64", 8);
}

test "mach.lang.be.linker:local_and_global_absolute_definitions_resolve_without_sections" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val initialized: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel initialized.err) { ret 1; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    var symbols: [2]of.Symbol;
    symbols[0] = of.Symbol{name: lt_name(?s, "@feat.00"), section: of.absolute_section(), absolute_value: 0x123};
    symbols[1] = of.Symbol{name: lt_name(?s, "public_absolute"), section: of.absolute_section(),
        absolute_value: 0xF123456789ABCDEF, flags: of.SYM_OBJ_FLAG_GLOBAL};
    var image: of.ObjectImage = lt_image(?s, lt_name(?s, "absolute"), nil::*of.Section, 0,
        ?symbols[0], 2, nil::*of.Relocation, 0);
    var locs: map.Map[intern.StrId, SymbolLoc] = map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    fin { map.dnit[intern.StrId, SymbolLoc](?locs); }
    val collected: err[fail.Fail] = collect_symbols(?s, ?image, 1,
        nil::*Placement, nil::*u32, ?locs, true, nil::*AtomPlan);
    if (sel collected.err) { ret 2; }
    val location: opt[*SymbolLoc] = map.get[intern.StrId, SymbolLoc](?locs, ?symbols[1].name);
    if (sel location.none) { ret 3; }
    val found: *SymbolLoc = location.some;
    if (found.vaddr != symbols[1].absolute_value || found.merged_index != of.SECTION_ABSOLUTE) { ret 4; }
    var local: rel.RelocTarget = rel.target(0, 0, 0);
    if (!local_symbol_target(?image, 0, 0, nil::*Placement, nil::*u32, nil::*u32,
        nil::*of.ObjectImage, nil::*of.OfVTable, 0, nil::*AtomPlan, ?local) || local.vaddr != 0x123) { ret 5; }
    val sub: res[u64, fail.Fail] = difference_subtrahend_vaddr(?s, ?image, 0, 1,
        nil::*Placement, nil::*u32, nil::*u32, nil::*of.ObjectImage, nil::*of.OfVTable,
        0, nil::*AtomPlan, ?locs);
    if (sel sub.err) { ret 6; }
    if (sub.ok != symbols[1].absolute_value) { ret 6; }
    ret 0;
}
