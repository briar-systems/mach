    if (sel r_10114.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "freestanding", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    if (tgt.base != 0)                            { ret 1; }
    if (os_base_addr(?tgt) != tgt.os.base_addr)   { ret 1; }
    if (os_base_addr(?tgt) != 0)                  { ret 1; }

    tgt.base = 0xFFFF800000000000;
    if (os_base_addr(?tgt) != 0xFFFF800000000000) { ret 1; }
    ret 0;
}

fun lt_macho_section(buf: *u8, segname: str, sect: str) usize {
    val ncmds: u32 = bin.read_u32_le(buf, 16);
    var off: usize = 32;
    var c: u32 = 0;
    for (c < ncmds) {
        if (bin.read_u32_le(buf, off) == 25) {
            val nsects: u32 = bin.read_u32_le(buf, off + 64);
            var k: u32 = 0;
            for (k < nsects) {
                val sh: usize = off + 72 + k::usize * 80;
                if (lt_fixed16_is(buf, sh, sect) && lt_fixed16_is(buf, sh + 16, segname)) { ret sh; }
                k = k + 1;
            }
        }
        off = off + bin.read_u32_le(buf, off + 4)::usize;
        c = c + 1;
    }
    ret 0;
}

fun lt_fixed16_is(buf: *u8, off: usize, name: str) bool {
    val n: usize = str_len(name);
    if (n > 16) { ret false; }
    var i: usize = 0;
    for (i < 16) {
        var expect: u8 = 0;
        if (i < n) { expect = name[i]; }
        if (buf[off + i] != expect) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun lt_embed_sec(sec: *of.Section, name: intern.StrId, kind: of.SectionKind,
                 bytes: *u8, len: u32, align: u32, embed: bool) {
    sec.name  = name;
    sec.kind  = kind;
    sec.bytes = bytes;
    sec.len   = len;
    sec.align = align;
    sec.flags = 0;
    if (embed) { sec.flags = of.SEC_FLAG_MERGEABLE; }
}

test "mach.lang.be.linker.plan_atom_coalescing:only_matching_embed_atoms" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val rodata: intern.StrId = lt_name(?s, ".rodata");
    val other:  intern.StrId = lt_name(?s, ".rodata.assets");
    if (rodata == intern.STR_NIL || other == intern.STR_NIL) { ret 1; }

    var abc: [4]u8;
    var xyz: [4]u8;
    var i: u32 = 0;
    for (i < 4) { abc[i] = 0xA0 + i::u8; xyz[i] = 0xF0 + i::u8; i = i + 1; }

    var secs0: [1]of.Section;
    lt_embed_sec(?secs0[0], rodata, of.SK_RODATA, ?abc[0], 4, 8, true);

    var secs1: [6]of.Section;
    lt_embed_sec(?secs1[0], rodata, of.SK_RODATA, ?abc[0], 4, 8,  true);
    lt_embed_sec(?secs1[1], rodata, of.SK_RODATA, ?abc[0], 4, 8,  false);
    lt_embed_sec(?secs1[2], rodata, of.SK_RODATA, ?xyz[0], 4, 8,  true);
    lt_embed_sec(?secs1[3], rodata, of.SK_RODATA, ?abc[0], 4, 64, true);
    lt_embed_sec(?secs1[4], other,  of.SK_RODATA, ?abc[0], 4, 8,  true);
    lt_embed_sec(?secs1[5], rodata, of.SK_DATA,   ?abc[0], 4, 8,  true);

    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "m0"), ?secs0[0], 1, nil::*of.Symbol, 0, nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "m1"), ?secs1[0], 6, nil::*of.Symbol, 0, nil::*of.Relocation, 0);

    var sec_base: [2]u32;
    sec_base[0] = 0;
    sec_base[1] = 1;

    val dr: res[*u32, fail.Fail] =
        plan_atom_coalescing(?alloc, ?mods[0], 2, ?sec_base[0], 7, nil::*AtomPlan);
    if (sel dr.err) { ret 1; }
    val dup: *u32 = dr.ok;

    if (dup[0] != ATOM_OWNS) { ret 1; }
    if (dup[1] != 0)          { ret 1; }
    i = 2;
    for (i < 7) {
        if (dup[i] != ATOM_OWNS) { ret 1; }
        i = i + 1;
    }
    A.deallocate[u32](?alloc, dup, 7::usize);

    var secs2: [1]of.Section;
    lt_embed_sec(?secs2[0], rodata, of.SK_RODATA, ?abc[0], 4, 8, true);
    var mods3: [3]of.ObjectImage;
    mods3[0] = mods[0];
    mods3[1] = mods[1];
    mods3[2] = lt_image(?s, lt_name(?s, "m2"), ?secs2[0], 1, nil::*of.Symbol, 0, nil::*of.Relocation, 0);
    var base3: [3]u32;
    base3[0] = 0; base3[1] = 1; base3[2] = 7;
    val dr3: res[*u32, fail.Fail] =
        plan_atom_coalescing(?alloc, ?mods3[0], 3, ?base3[0], 8, nil::*AtomPlan);
    if (sel dr3.err) { ret 1; }
    val dup3: *u32 = dr3.ok;
    if (dup3[7] != 0) { ret 1; }
    A.deallocate[u32](?alloc, dup3, 8::usize);

    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(0); relocs[0].offset = 0; relocs[0].kind = of.RK_ABS64;
    relocs[0].sym = of.SYMBOL_NONE; relocs[0].addend = 0;
    var mods_r: [2]of.ObjectImage;
    mods_r[0] = mods[0];
    mods_r[1] = lt_image(?s, lt_name(?s, "m1r"), ?secs1[0], 1, nil::*of.Symbol, 0, ?relocs[0], 1);
    var base_r: [2]u32;
    base_r[0] = 0; base_r[1] = 1;
    val drr: res[*u32, fail.Fail] =
        plan_atom_coalescing(?alloc, ?mods_r[0], 2, ?base_r[0], 2, nil::*AtomPlan);
    if (sel drr.err) { ret 1; }
    val dupr: *u32 = drr.ok;
    if (dupr[1] != ATOM_OWNS) { ret 1; }
    A.deallocate[u32](?alloc, dupr, 2::usize);

    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.link_modules:input_section_names_survive" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_10258: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_10258.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "darwin", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val text:      intern.StrId = lt_name(?s, ".text");
    val data:      intern.StrId = lt_name(?s, ".data");
    val classlist: intern.StrId = lt_name(?s, "__objc_classlist");
    val entry:     intern.StrId = lt_name(?s, tgt.os.entry_symbol);
    if (text == intern.STR_NIL || data == intern.STR_NIL
        || classlist == intern.STR_NIL || entry == intern.STR_NIL) { ret 1; }

    var code: [16]u8;
    var i: u32 = 0;
    for (i < 16) { code[i] = 0x90; i = i + 1; }

    var cl0: [8]u8;
    var cl1: [8]u8;
    var d0:  [8]u8;
    i = 0;
    for (i < 8) { cl0[i] = 0xA0; cl1[i] = 0xB0; d0[i] = 0xDD; i = i + 1; }

    var secs0: [3]of.Section;
    secs0[0].name = text;      secs0[0].kind = of.SK_TEXT; secs0[0].bytes = ?code[0];
    secs0[0].len = 16; secs0[0].align = 16;
    secs0[1].name = data;      secs0[1].kind = of.SK_DATA; secs0[1].bytes = ?d0[0];
    secs0[1].len = 8;  secs0[1].align = 8;
    secs0[2].name = classlist; secs0[2].kind = of.SK_DATA; secs0[2].bytes = ?cl0[0];
    secs0[2].len = 8;  secs0[2].align = 8;

    var secs1: [1]of.Section;
    secs1[0].name = classlist; secs1[0].kind = of.SK_DATA; secs1[0].bytes = ?cl1[0];
    secs1[0].len = 8;  secs1[0].align = 8;

    var syms0: [1]of.Symbol;
    syms0[0].name = entry; syms0[0].section = of.section_id(0); syms0[0].offset = 0; syms0[0].size = 16;
    syms0[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "m0"), ?secs0[0], 3, ?syms0[0], 1, nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "m1"), ?secs1[0], 1, nil::*of.Symbol, 0, nil::*of.Relocation, 0);

    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "macho_names");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val lr: err[fail.Fail] =
        t_planned_link_modules_nocapture(?s, ?tgt, ?mods[0], 2, 2, nil::*of.DynLib, 0, tpath::*u8,
                     "macho_names"::*u8, LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel lr.err) { ret 1; }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rr.err) { ret 1; }
    var b: Vector[u8] = rr.ok;

    val cls: usize = lt_macho_section(b.data, "__DATA", "__objc_classlist");
    if (cls == 0)                                       { vector.dnit[u8](?b); ret 1; }
    if (bin.read_u64_le(b.data, cls + 40) != 16)        { vector.dnit[u8](?b); ret 1; }
    if (bin.read_u32_le(b.data, cls + 52) < 3)          { vector.dnit[u8](?b); ret 1; }

    val cls_off: usize = bin.read_u32_le(b.data, cls + 48)::usize;
    if ((bin.read_u64_le(b.data, cls + 32) % 8) != 0)   { vector.dnit[u8](?b); ret 1; }
    var j: usize = 0;
    for (j < 8) {
        if (b.data[cls_off + j] != 0xA0)     { vector.dnit[u8](?b); ret 1; }
        if (b.data[cls_off + 8 + j] != 0xB0) { vector.dnit[u8](?b); ret 1; }
        j = j + 1;
    }

    val dsec: usize = lt_macho_section(b.data, "__DATA", "__data");
    if (dsec == 0)                                { vector.dnit[u8](?b); ret 1; }
    if (bin.read_u64_le(b.data, dsec + 40) != 8)  { vector.dnit[u8](?b); ret 1; }

    if (lt_macho_section(b.data, "__TEXT", "__text") == 0) { vector.dnit[u8](?b); ret 1; }
    if (lt_macho_section(b.data, "__TEXT", ".text") != 0)  { vector.dnit[u8](?b); ret 1; }

    vector.dnit[u8](?b);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.link_modules:flat_entry_leads_regardless_of_order" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_10351: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_10351.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "freestanding", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;
    if (!tgt.of.produces_image) { ret 1; }

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val text:  intern.StrId = lt_name(?s, ".text");
    val other: intern.StrId = lt_name(?s, "other_fn");
    val entry: intern.StrId = lt_name(?s, tgt.os.entry_symbol);
    if (text == intern.STR_NIL || other == intern.STR_NIL || entry == intern.STR_NIL) { ret 1; }

    var b0: [32]u8;
    var b1: [16]u8;
    var i: u32 = 0;
    for (i < 32) { b0[i] = 0x90; i = i + 1; }
    i = 0;
    for (i < 16) { b1[i] = 0xCC; i = i + 1; }

    var secs0: [1]of.Section;
    secs0[0].name = text; secs0[0].kind = of.SK_TEXT; secs0[0].bytes = ?b0[0];
    secs0[0].len = 32; secs0[0].align = 16;
    var secs1: [1]of.Section;
    secs1[0].name = text; secs1[0].kind = of.SK_TEXT; secs1[0].bytes = ?b1[0];
    secs1[0].len = 16; secs1[0].align = 16;

    val fn_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var syms0: [1]of.Symbol;
    syms0[0].name = other; syms0[0].section = of.section_id(0); syms0[0].offset = 0; syms0[0].size = 0; syms0[0].flags = fn_flags;
    var syms1: [1]of.Symbol;
    syms1[0].name = entry; syms1[0].section = of.section_id(0); syms1[0].offset = 0; syms1[0].size = 0; syms1[0].flags = fn_flags;

    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "m0"), ?secs0[0], 1, ?syms0[0], 1, nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "m1"), ?secs1[0], 1, ?syms1[0], 1, nil::*of.Relocation, 0);

    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "flat_entry");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val lr: err[fail.Fail] =
        t_planned_link_modules_nocapture(?s, ?tgt, ?mods[0], 2, 2, nil::*of.DynLib, 0, tpath::*u8, "flat_entry"::*u8, LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel lr.err) { ret 1; }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rr.err) { ret 1; }
    var b: Vector[u8] = rr.ok;

    if (b.len != 48)        { vector.dnit[u8](?b); ret 1; }
    if (b.data[0]  != 0xCC) { vector.dnit[u8](?b); ret 1; }
    if (b.data[15] != 0xCC) { vector.dnit[u8](?b); ret 1; }
    if (b.data[16] != 0x90) { vector.dnit[u8](?b); ret 1; }

    vector.dnit[u8](?b);
    session.dnit(?s);
    ret 0;
}

fun lt_loader_link(s: *session.Session, tgt: *target.Target, mode: LinkMode, pie: bool,
                   dynlibs: *of.DynLib, dynlib_count: u32, out: *Vector[u8]) str {
    val text:  intern.StrId = lt_name(s, ".text");
    val entry: intern.StrId = lt_name(s, tgt.os.entry_symbol);
    if (text == intern.STR_NIL || entry == intern.STR_NIL) { ret "lt: intern failed"; }

    var tb: [16]u8;
    var i: u32 = 0;
    for (i < 16) { tb[i] = 0x90; i = i + 1; }

    var secs: [1]of.Section;
    secs[0].name = text; secs[0].kind = of.SK_TEXT; secs[0].bytes = ?tb[0];
    secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = entry; syms[0].section = of.section_id(0); syms[0].offset = 0; syms[0].size = 0;
    syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var mods: [1]of.ObjectImage;
    mods[0] = lt_image(s, lt_name(s, "loader_req"), ?secs[0], 1, ?syms[0], 1,
                       nil::*of.Relocation, 0);
    mods[0].machine_flags = isa.machine_flags(tgt.isa, tgt.abi.float_arg_bits, false);

    val tf_r: res[output.Output, outcome.Fail] = output.create(s.alloc, "loader_req");
    if (sel tf_r.err) { ret "lt: temp failed"; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val lr: err[fail.Fail] =
        t_planned_link_modules_nocapture(s, tgt, ?mods[0], 1, 1, dynlibs, dynlib_count, tpath::*u8,
                     "loader_req"::*u8, mode, pie,
                     of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel lr.err) {

        ret fail.describe(lr.err);
    }
    if (out != nil) {
        val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(s.alloc, tpath);
        if (sel rr.err) {

            ret "lt: read failed";
        }
        @out = rr.ok;
    }

    ret "";
}

test "mach.lang.be.linker.link_modules:loaderless_refuses_pie_and_dynamic" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_10469: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_10469.err) { ret 1; }

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val pie_msg: str = "link: a position-independent executable needs a loader to relocate it, and os = \"freestanding\" has none";
    val dyn_msg: str = "link: a dynamically-linked executable needs a loader to resolve it, and os = \"freestanding\" has none";
    val shr_msg: str = "link: a shared library needs a loader to map it, and os = \"freestanding\" has none";

    var isas: [4]str;
    isas[0] = "x86_64"; isas[1] = "aarch64"; isas[2] = "riscv64"; isas[3] = "riscv32";
    var abis: [4]str;
    abis[0] = "sysv64"; abis[1] = "aapcs64"; abis[2] = "lp64d"; abis[3] = "ilp32";

    val libname: intern.StrId = lt_name(?s, "libfoo.so");
    if (libname == intern.STR_NIL) { ret 1; }
    var dl: [1]of.DynLib;
    dl[0].name = libname; dl[0].soname = libname; dl[0].rpath = intern.STR_NIL;

    var bad: bool = false;
    var i: u32 = 0;
    for (i < 4) {
        val tr: res[target.Target, fail.Fail] =
            target.select_of(?reg, isas[i], "freestanding", abis[i], "elf");
        if (sel tr.err) { bad = true; i = i + 1; cnt; }
        var tgt: target.Target = tr.ok;

        if (!str_equals(lt_loader_link(?s, ?tgt, LINK_EXE, true, nil::*of.DynLib, 0,
                                       nil::*Vector[u8]), pie_msg)) { bad = true; }
        if (!str_equals(lt_loader_link(?s, ?tgt, LINK_EXE, false, ?dl[0], 1,
                                       nil::*Vector[u8]), dyn_msg)) { bad = true; }
        if (!str_equals(lt_loader_link(?s, ?tgt, LINK_SHARED, false, nil::*of.DynLib, 0,
                                       nil::*Vector[u8]), shr_msg)) { bad = true; }
        if (!str_empty(lt_loader_link(?s, ?tgt, LINK_EXE, false, nil::*of.DynLib, 0,
                                      nil::*Vector[u8]))) { bad = true; }
        i = i + 1;
    }

    val ltr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel ltr.err) { ret 1; }
    var ltgt: target.Target = ltr.ok;
    var img: Vector[u8];
    if (!str_empty(lt_loader_link(?s, ?ltgt, LINK_EXE, true, nil::*of.DynLib, 0, ?img))) {
        bad = true;
    }
    or {
        if (img.len < 64 || bin.read_u16_le(img.data, 16) != 3) { bad = true; }
        or {
            val phoff:     usize = bin.read_u64_le(img.data, 32)::usize;
            val phentsize: usize = bin.read_u16_le(img.data, 54)::usize;
            val phnum:     usize = bin.read_u16_le(img.data, 56)::usize;
            var headers: u32 = 0;
            var content: u32 = 0;
            var lowest:  u64 = 0;
            var p: usize = 0;
            for (p < phnum) {
                val at: usize = phoff + p * phentsize;
                if (at + 56 > img.len) { p = phnum; cnt; }
                if (bin.read_u32_le(img.data, at) == 1) {
                    if (bin.read_u64_le(img.data, at + 8) == 0) {
                        headers = headers + 1;
                        lowest = bin.read_u64_le(img.data, at + 16);
                    }
                    or { content = content + 1; }
                }
                p = p + 1;
            }
            if (headers != 1 || content == 0)                              { bad = true; }
            if (lowest != os_base_addr(?ltgt))                             { bad = true; }
        }
        vector.dnit[u8](?img);
    }

    session.dnit(?s);
    if (bad) { ret 1; }
    ret 0;
}

# links one attributed text-only module into an executable and returns the link
# error, or "" when the link succeeded
fun lt_attributed_link(s: *session.Session, tgt: *target.Target, attributes: *u8,
                       attributes_len: u32, extra_flags: u32) str {
    val text:  intern.StrId = lt_name(s, ".text");
    val entry: intern.StrId = lt_name(s, tgt.os.entry_symbol);
    if (text == intern.STR_NIL || entry == intern.STR_NIL) { ret "lt: intern failed"; }
    var tb: [16]u8;
    var i: u32 = 0;
    for (i < 16) { tb[i] = 0x13; i = i + 1; }
    var secs: [1]of.Section;
    secs[0].name = text; secs[0].kind = of.SK_TEXT; secs[0].bytes = ?tb[0];
    secs[0].len = 16; secs[0].align = 16;
    var syms: [1]of.Symbol;
    syms[0].name = entry; syms[0].section = of.section_id(0); syms[0].offset = 0; syms[0].size = 0;
    syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var mods: [1]of.ObjectImage;
    mods[0] = lt_image(s, lt_name(s, "attributed"), ?secs[0], 1, ?syms[0], 1, nil::*of.Relocation, 0);
    mods[0].machine_flags  = isa.machine_flags(tgt.isa, tgt.abi.float_arg_bits, false) | extra_flags;
    mods[0].attributes     = attributes;
    mods[0].attributes_len = attributes_len;
    val tf_r: res[output.Output, outcome.Fail] = output.create(s.alloc, "attributed");
    if (sel tf_r.err) { ret "lt: temp failed"; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val lr: err[fail.Fail] =
        t_planned_link_modules_nocapture(s, tgt, ?mods[0], 1, 1, nil::*of.DynLib, 0, output.path(?tf)::*u8,
                     "attributed"::*u8, LINK_EXE, false,
                     of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel lr.err) { ret fail.describe(lr.err); }
    ret "";
}

test "mach.lang.be.linker.link_modules:riscv_inputs_beyond_the_selected_extensions_are_refused" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_10586: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_10586.err) { ret 1; }
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val full_r: res[target.Target, fail.Fail] = target.select_of(?reg, "rv64imafdc", "freestanding", "lp64d", "elf");
    val soft_r: res[target.Target, fail.Fail] = target.select_of(?reg, "rv64imac", "freestanding", "lp64", "elf");
    val base_r: res[target.Target, fail.Fail] = target.select_of(?reg, "rv64i", "freestanding", "lp64", "elf");
    if (sel full_r.err) { ret 2; }
    if (sel soft_r.err) { ret 2; }
    if (sel base_r.err) { ret 2; }
    var full: target.Target = full_r.ok;
    var soft: target.Target = soft_r.ok;
    var base: target.Target = base_r.ok;

    var full_len: u32 = 0;
    val full_attrs: res[*u8, fail.Fail] = isa.build_attributes(full.isa, ?full.model, ?alloc, 0, false, ?full_len);
    if (sel full_attrs.err) { ret 3; }
    fin { A.deallocate[u8](?alloc, full_attrs.ok, full_len::usize); }
    var soft_len: u32 = 0;
    val soft_attrs: res[*u8, fail.Fail] = isa.build_attributes(soft.isa, ?soft.model, ?alloc, 0, false, ?soft_len);
    if (sel soft_attrs.err) { ret 3; }
    fin { A.deallocate[u8](?alloc, soft_attrs.ok, soft_len::usize); }

    if (!str_empty(lt_attributed_link(?s, ?full, full_attrs.ok, full_len, 0))) { ret 4; }
    if (!str_empty(lt_attributed_link(?s, ?full, soft_attrs.ok, soft_len, 0))) { ret 5; }
    if (!str_empty(lt_attributed_link(?s, ?soft, soft_attrs.ok, soft_len, 0))) { ret 6; }
    val needs_float: str = lt_attributed_link(?s, ?soft, full_attrs.ok, full_len, 0);
    if (!str_contains(needs_float, "requires the F extension")) { ret 7; }
    val needs_mul: str = lt_attributed_link(?s, ?base, soft_attrs.ok, soft_len, 0);
    if (!str_contains(needs_mul, "requires the M extension")) { ret 8; }
    val needs_c: str = lt_attributed_link(?s, ?base, nil, 0, isa.machine_flags(base.isa, 0, true) & ~isa.machine_flags(base.isa, 0, false));
    if (!str_contains(needs_c, "require the C extension")) { ret 9; }
    if (!str_empty(lt_attributed_link(?s, ?soft, nil, 0, isa.machine_flags(soft.isa, 0, true) & ~isa.machine_flags(soft.isa, 0, false)))) { ret 10; }
    ret 0;
}

test "mach.lang.be.linker.patch_relocations:anonymous_section_symbols_stay_distinct" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_10629: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_10629.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "freestanding", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;
    if (!tgt.of.produces_image) { ret 1; }

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val text:   intern.StrId = lt_name(?s, ".text");
    val rodata: intern.StrId = lt_name(?s, ".rodata.str1.1");
    val data:   intern.StrId = lt_name(?s, ".data.rel.ro.local");
    val anon:   intern.StrId = lt_name(?s, "");
    val anchor: intern.StrId = lt_name(?s, "rodata_anchor");
    val entry:  intern.StrId = lt_name(?s, tgt.os.entry_symbol);
    if (text == intern.STR_NIL || rodata == intern.STR_NIL || data == intern.STR_NIL) { ret 1; }
    if (anon == intern.STR_NIL || anchor == intern.STR_NIL || entry == intern.STR_NIL) { ret 1; }

    var tb: [16]u8;
    var rb: [16]u8;
    var db: [24]u8;
    var i: u32 = 0;
    for (i < 16) { tb[i] = 0x90; rb[i] = 0x00; i = i + 1; }
    for (i < 24) { db[i] = 0x00; i = i + 1; }
    i = 0;
    for (i < 8) { db[i] = 0xEE; i = i + 1; }

    var secs: [3]of.Section;
    secs[0].name = text;   secs[0].kind = of.SK_TEXT;   secs[0].bytes = ?tb[0];
    secs[0].len = 16; secs[0].align = 16;
    secs[1].name = rodata; secs[1].kind = of.SK_RODATA; secs[1].bytes = ?rb[0];
    secs[1].len = 16; secs[1].align = 16;
    secs[2].name = data;   secs[2].kind = of.SK_DATA;   secs[2].bytes = ?db[0];
    secs[2].len = 24; secs[2].align = 8;

    var syms: [4]of.Symbol;
    syms[0].name = anon;   syms[0].section = of.section_id(0); syms[0].offset = 0; syms[0].size = 0; syms[0].flags = 0;
    syms[1].name = anon;   syms[1].section = of.section_id(1); syms[1].offset = 0; syms[1].size = 0; syms[1].flags = 0;
    syms[2].name = anchor; syms[2].section = of.section_id(1); syms[2].offset = 8; syms[2].size = 0;
    syms[2].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    syms[3].name = entry;  syms[3].section = of.section_id(0); syms[3].offset = 0; syms[3].size = 0;
    syms[3].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [2]of.Relocation;
    relocs[0].section = of.section_id(2); relocs[0].offset = 8;  relocs[0].kind = of.RK_ABS64;
    relocs[0].sym = 1; relocs[0].addend = 8;
    relocs[1].section = of.section_id(2); relocs[1].offset = 16; relocs[1].kind = of.RK_ABS64;
    relocs[1].sym = 2; relocs[1].addend = 0;

    var mods: [1]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "anon_secs"), ?secs[0], 3, ?syms[0], 4, ?relocs[0], 2);

    val etr: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel etr.err) { ret 1; }
    var etgt: target.Target = etr.ok;

    val otf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "anon_section_obj");
    if (sel otf_r.err) { ret 1; }
    var otf: output.Output = otf_r.ok;
    fin { output.dnit(?otf); }
    val opath: str = output.path(?otf);
    val olr: err[fail.Fail] =
        t_planned_link_modules_nocapture(?s, ?etgt, ?mods[0], 1, 0, nil::*of.DynLib, 0, opath::*u8,
                     "anon_section_obj"::*u8, LINK_RELOCATABLE, false,
                     of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel olr.err) { ret 1; }

    val orb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, opath);

    if (sel orb.err) { ret 1; }
    var ob: Vector[u8] = orb.ok;
    var carried: of.ObjectImage;
    val opr: err[fail.Fail] =
        etgt.of.parse_object(?alloc, ?s.interner, ob.data, ob.len, ?carried);
    if (sel opr.err) { vector.dnit[u8](?ob); ret 1; }

    var saw_section: bool = false;
    var saw_anchor: bool = false;
    var cr: u32 = 0;
    for (cr < carried.reloc_count) {
        val rr: *of.Relocation = ?carried.relocations[cr];
        if (rr.sym >= carried.symbol_count) { obj.dnit(?carried); vector.dnit[u8](?ob); ret 1; }
        val cs: *of.Symbol = ?carried.symbols[rr.sym];
        if (of.section_index(cs.section) >= carried.section_count
            || carried.sections[of.section_index(cs.section)].kind != of.SK_RODATA) {
            obj.dnit(?carried); vector.dnit[u8](?ob); ret 1;
        }
        if (rr.addend == 8 && cs.name == anon && cs.offset == 0) { saw_section = true; }
        if (rr.addend == 0 && cs.name == anchor && cs.offset == 8) { saw_anchor = true; }
        cr = cr + 1;
    }
    obj.dnit(?carried);
    vector.dnit[u8](?ob);
    if (!saw_section || !saw_anchor) { ret 1; }

    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "anon_section_syms");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val lr: err[fail.Fail] =
        t_planned_link_modules_nocapture(?s, ?tgt, ?mods[0], 1, 1, nil::*of.DynLib, 0, tpath::*u8, "anon_section_syms"::*u8, LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel lr.err) { ret 1; }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rr.err) { ret 1; }
    var b: Vector[u8] = rr.ok;

    if (b.len < 24) { vector.dnit[u8](?b); ret 1; }
    var site: usize = b.len;
    var scan: usize = 0;
    for (scan + 24 <= b.len) {
        if (b.data[scan] == 0xEE && b.data[scan + 7] == 0xEE) { site = scan; scan = b.len; }
        or { scan = scan + 1; }
    }
    if (site + 24 > b.len) { vector.dnit[u8](?b); ret 1; }

    var via_section: u64 = 0;
    var via_name:    u64 = 0;
    i = 0;
    for (i < 8) {
        via_section = via_section | (b.data[site + 8 + i::usize]::u64 << (i * 8));
        via_name    = via_name    | (b.data[site + 16 + i::usize]::u64 << (i * 8));
        i = i + 1;
    }

    if (via_section == 0 || via_name == 0)  { vector.dnit[u8](?b); ret 1; }
    if (via_section != via_name)            { vector.dnit[u8](?b); ret 1; }

    vector.dnit[u8](?b);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.patch_relocations:duplicate_coff_section_symbols_stay_distinct" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_10772: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_10772.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "windows", "win64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val text: intern.StrId = lt_name(?s, ".text");
    val rdata: intern.StrId = lt_name(?s, ".rdata");
    val data: intern.StrId = lt_name(?s, ".data");
    val anchor_a: intern.StrId = lt_name(?s, "rdata_anchor_a");
    val anchor_b: intern.StrId = lt_name(?s, "rdata_anchor_b");
    val entry: intern.StrId = lt_name(?s, tgt.os.entry_symbol);
    if (text == intern.STR_NIL || rdata == intern.STR_NIL || data == intern.STR_NIL) { ret 1; }
    if (anchor_a == intern.STR_NIL || anchor_b == intern.STR_NIL
        || entry == intern.STR_NIL) { ret 1; }

    var tb: [16]u8;
    var ra: [16]u8;
    var rb: [16]u8;
    var db: [40]u8;
    var i: u32 = 0;
    for (i < 16) { tb[i] = 0x90; ra[i] = 0xA1; rb[i] = 0xB2; i = i + 1; }
    i = 0;
    for (i < 40) { db[i] = 0; i = i + 1; }
    i = 0;
    for (i < 8) { db[i] = 0xEE; i = i + 1; }

    var secs: [4]of.Section;
    secs[0].name = text;  secs[0].kind = of.SK_TEXT;   secs[0].bytes = ?tb[0];
    secs[0].len = 16; secs[0].align = 16;
    secs[1].name = rdata; secs[1].kind = of.SK_RODATA; secs[1].bytes = ?ra[0];
    secs[1].len = 16; secs[1].align = 16;
    secs[2].name = rdata; secs[2].kind = of.SK_RODATA; secs[2].bytes = ?rb[0];
    secs[2].len = 16; secs[2].align = 16;
    secs[3].name = data;  secs[3].kind = of.SK_DATA;   secs[3].bytes = ?db[0];
    secs[3].len = 40; secs[3].align = 8;

    var syms: [5]of.Symbol;
    syms[0].name = rdata; syms[0].section = of.section_id(1); syms[0].offset = 0;
    syms[0].size = 0; syms[0].flags = 0;
    syms[1].name = rdata; syms[1].section = of.section_id(2); syms[1].offset = 0;
    syms[1].size = 0; syms[1].flags = 0;
    syms[2].name = anchor_a; syms[2].section = of.section_id(1); syms[2].offset = 8;
    syms[2].size = 0; syms[2].flags = 0;
    syms[3].name = anchor_b; syms[3].section = of.section_id(2); syms[3].offset = 8;
    syms[3].size = 0; syms[3].flags = 0;
    syms[4].name = entry;    syms[4].section = of.section_id(0); syms[4].offset = 0; syms[4].size = 16;
    syms[4].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [4]of.Relocation;
    relocs[0].section = of.section_id(3); relocs[0].offset = 8;  relocs[0].kind = of.RK_ABS64;
    relocs[0].sym = 0; relocs[0].addend = 8;
    relocs[1].section = of.section_id(3); relocs[1].offset = 16; relocs[1].kind = of.RK_ABS64;
    relocs[1].sym = 2; relocs[1].addend = 0;
    relocs[2].section = of.section_id(3); relocs[2].offset = 24; relocs[2].kind = of.RK_ABS64;
    relocs[2].sym = 1; relocs[2].addend = 8;
    relocs[3].section = of.section_id(3); relocs[3].offset = 32; relocs[3].kind = of.RK_ABS64;
    relocs[3].sym = 3; relocs[3].addend = 0;

    var mods: [1]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "coff_section_syms"), ?secs[0], 4,
                       ?syms[0], 5, ?relocs[0], 4);

    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "coff_section_syms");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val lr: err[fail.Fail] =
        t_planned_link_modules_nocapture(?s, ?tgt, ?mods[0], 1, 0, nil::*of.DynLib, 0, tpath::*u8,
                     "coff_section_syms"::*u8, LINK_EXE, false, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel lr.err) { ret 1; }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rr.err) { ret 1; }
    var b: Vector[u8] = rr.ok;

    var site: usize = b.len;
    var scan: usize = 0;
    for (scan + 40 <= b.len) {
        if (b.data[scan] == 0xEE && b.data[scan + 7] == 0xEE) { site = scan; scan = b.len; }
        or { scan = scan + 1; }
    }
    if (site + 40 > b.len) { vector.dnit[u8](?b); ret 1; }

    var values: [4]u64;
    var v: u32 = 0;
    for (v < 4) {
        i = 0;
        for (i < 8) {
            values[v] = values[v] | (b.data[site + 8 + v::usize * 8 + i::usize]::u64 << (i * 8));
            i = i + 1;
        }
        v = v + 1;
    }

    if (values[0] == 0 || values[2] == 0) { vector.dnit[u8](?b); ret 1; }
    if (values[0] != values[1] || values[2] != values[3]) { vector.dnit[u8](?b); ret 1; }
    if (values[0] == values[2]) { vector.dnit[u8](?b); ret 1; }

    vector.dnit[u8](?b);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.collect_symbols:weak_strong_order_independent" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val ri: res[intern.StrId, A.Error] = intern.intern(?s.interner, "dup");
    if (sel ri.err) { ret 1; }
    val nm: intern.StrId = ri.ok;

    var weak: of.Symbol;
    weak.name = nm; weak.section = of.section_id(0); weak.offset = 0; weak.size = 0;
    weak.flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK;
    var strong: of.Symbol;
    strong.name = nm; strong.section = of.section_id(0); strong.offset = 0; strong.size = 0;
    strong.flags = of.SYM_OBJ_FLAG_GLOBAL;
    var strong2: of.Symbol;
    strong2.name = nm; strong2.section = of.section_id(0); strong2.offset = 0; strong2.size = 0;
    strong2.flags = of.SYM_OBJ_FLAG_GLOBAL;

    val r1: res[u64, fail.Fail] = lt_link(?s, nm, ?weak, ?strong);
    if (sel r1.err)              { ret 1; }
    if (r1.ok != 0x2000) { ret 1; }

    val r2: res[u64, fail.Fail] = lt_link(?s, nm, ?strong, ?weak);
    if (sel r2.err)              { ret 1; }
    if (r2.ok != 0x1000) { ret 1; }

    val r3: res[u64, fail.Fail] = lt_link(?s, nm, ?strong, ?strong2);
    if (!sel r3.err) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.collect_symbols:winning_section_metadata" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    val name: intern.StrId = lt_name(?s, "section_winner");

    var weak: of.Symbol;
    weak.name = name; weak.section = of.section_id(0); weak.offset = 0x20; weak.size = 0;
    weak.flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK;
    var strong: of.Symbol;
    strong.name = name; strong.section = of.section_id(0); strong.offset = 0x30; strong.size = 0;
    strong.flags = of.SYM_OBJ_FLAG_GLOBAL;

    var modules: [2]of.ObjectImage;
    modules[0] = lt_image(?s, lt_name(?s, "weak"), nil::*of.Section, 1,
                          ?weak, 1, nil::*of.Relocation, 0);
    modules[1] = lt_image(?s, lt_name(?s, "strong"), nil::*of.Section, 1,
                          ?strong, 1, nil::*of.Relocation, 0);
    var placements: [2]Placement;
    placements[0].vaddr = 0x1100; placements[0].offset = 0x100; placements[0].merged_index = 0;
    placements[1].vaddr = 0x2400; placements[1].offset = 0x400; placements[1].merged_index = 1;
    var sec_base: [2]u32;
    sec_base[0] = 0; sec_base[1] = 1;
    var locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);

    val cr: err[fail.Fail] = collect_symbols(?s, ?modules[0], 2,
        ?placements[0], ?sec_base[0], ?locs, true, nil::*AtomPlan);
    if (sel cr.err) { map.dnit[intern.StrId, SymbolLoc](?locs); ret 1; }
    val lr: opt[*SymbolLoc] = map.get[intern.StrId, SymbolLoc](?locs, ?name);
    if (sel lr.none) { map.dnit[intern.StrId, SymbolLoc](?locs); ret 1; }
    val loc: *SymbolLoc = lr.some;
    if (loc.vaddr != 0x2430 || loc.section_vaddr != 0x2000
        || loc.merged_index != 1 || loc.weak) {
        map.dnit[intern.StrId, SymbolLoc](?locs);
        ret 1;
    }
    map.dnit[intern.StrId, SymbolLoc](?locs);
    ret 0;
}

test "mach.lang.be.linker.local_symbol_target:owning_section" {
    var alloc: A.Allocator;
