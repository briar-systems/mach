    session.dnit(?s);
    ret code;
}

#[testing]
fun lt_macho_section(buf: *u8, segname: str, sect: str) usize {
    val ncmds: u32   = bin.read_u32_le(buf, 16);
    var off:   usize = 32;
    var c:     u32   = 0;
    for (c < ncmds) {
        if (bin.read_u32_le(buf, off) == 25) {
            val nsects: u32 = bin.read_u32_le(buf, off + 64);
            var k:      u32 = 0;
            for (k < nsects) {
                val sh: usize = off + 72 + k::usize * 80;
                if (lt_fixed16_is(buf, sh, sect) && lt_fixed16_is(buf, sh + 16, segname)) { ret sh; }
                k = k + 1;
            }
        }
        off = off + bin.read_u32_le(buf, off + 4)::usize;
        c   = c + 1;
    }
    ret 0;
}

#[testing]
fun lt_fixed16_is(buf: *u8, off: usize, name: str) bool {
    val n: usize = str_len(name);
    if (n > 16) { ret false; }
    var i: usize = 0;
    for (i < 16) {
        var expect: u8 = 0;
        if (i < n)                  { expect = name[i]; }
        if (buf[off + i] != expect) { ret false; }
        i = i + 1;
    }
    ret true;
}

test link_modules__flat_entry_leads_regardless_of_order {
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "freestanding", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: lang_target.Binding = tr.ok;
    if (!tgt.of.produces_image) { ret 1; }

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val text:  intern.StrId = lt_name(?s, ".text");
    val other: intern.StrId = lt_name(?s, "other_fn");
    val entry: intern.StrId = lt_name(?s, tgt.os.entry_symbol);
    if (intern.str_is_nil(text) || intern.str_is_nil(other) || intern.str_is_nil(entry)) { ret 1; }

    var b0: [32]u8;
    var b1: [16]u8;
    var i:  u32 = 0;
    for (i < 32) {
        b0[i] = 0x90;
        i     = i + 1;
    }
    i = 0;
    for (i < 16) {
        b1[i] = 0xCC;
        i     = i + 1;
    }

    var secs0: [1]target_of.Section;
    secs0[0].name  = text;
    secs0[0].kind  = target_of.SK_TEXT;
    secs0[0].bytes = ?b0[0];
    secs0[0].len   = 32;
    secs0[0].align = 16;
    var secs1: [1]target_of.Section;
    secs1[0].name  = text;
    secs1[0].kind  = target_of.SK_TEXT;
    secs1[0].bytes = ?b1[0];
    secs1[0].len   = 16;
    secs1[0].align = 16;

    val fn_flags: u32 = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;
    var syms0:    [1]target_of.Symbol;
    syms0[0].name    = other;
    syms0[0].section = target_of.section_id(0);
    syms0[0].offset  = 0;
    syms0[0].size    = 0;
    syms0[0].flags   = fn_flags;
    var syms1: [1]target_of.Symbol;
    syms1[0].name    = entry;
    syms1[0].section = target_of.section_id(0);
    syms1[0].offset  = 0;
    syms1[0].size    = 0;
    syms1[0].flags   = fn_flags;

    var syms1_ext: [2]target_of.Symbol;
    syms1_ext[0]         = syms1[0];
    syms1_ext[1].name    = other;
    syms1_ext[1].section = target_of.external_section();
    syms1_ext[1].offset  = 0;
    syms1_ext[1].size    = 0;
    syms1_ext[1].flags   = fn_flags | target_of.SYM_OBJ_FLAG_EXTERN;
    var call: [1]target_of.Relocation;
    call[0].section = target_of.section_id(0);
    call[0].offset  = 4;
    call[0].kind    = target_of.RK_PC32;
    call[0].sym     = 1;
    call[0].addend  = -4;

    var mods: [2]target_of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "m0"), ?secs0[0], 1, ?syms0[0], 1, nil::*target_of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "m1"), ?secs1[0], 1, ?syms1_ext[0], 2, ?call[0], 1);

    val tf_r: res[output_testing.Output, fail.Fail] = output_testing.create(?alloc, "flat_entry");
    if (sel tf_r.err) { ret 1; }
    var tf: output_testing.Output = tf_r.ok;
    fin { output_testing.dnit(?tf); }
    val tpath: str = output_testing.path(?tf);

    mods[0].codegen = true;
    mods[1].codegen = true;
    val lr: err[fail.Fail] =
        link_modules_nocapture(?s, ?s.diags, ?tgt, ?mods[0], 2, nil::*target_of.DynLib, 0, tpath, "flat_entry"::*u8, catalog_artifact.EXECUTABLE, false, target_of.image_options_default(catalog_subsystem.CONSOLE));
    if (sel lr.err) { ret 1; }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rr.err) { ret 1; }
    var b: Vector[u8] = rr.ok;

    if (b.len != 48) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }
    if (b.data[0] != 0xCC) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }
    if (b.data[15] != 0xCC) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }
    if (b.data[16] != 0x90) {
        collections_vector.dnit[u8](?b);
        ret 1;
    }

    collections_vector.dnit[u8](?b);
    session.dnit(?s);
    ret 0;
}

#[testing]
fun lt_loader_link(s: *session.Session, tgt: *lang_target.Binding, mode: catalog_artifact.Kind, pie: bool,
    dynlibs: *target_of.DynLib, dynlib_count: u32) str {
    val text:  intern.StrId = lt_name(s, ".text");
    val entry: intern.StrId = lt_name(s, tgt.os.entry_symbol);
    if (intern.str_is_nil(text) || intern.str_is_nil(entry)) { ret "lt: intern failed"; }

    var tb: [16]u8;
    var i:  u32 = 0;
    for (i < 16) {
        tb[i] = 0x90;
        i     = i + 1;
    }

    var secs: [1]target_of.Section;
    secs[0].name  = text;
    secs[0].kind  = target_of.SK_TEXT;
    secs[0].bytes = ?tb[0];
    secs[0].len   = 16;
    secs[0].align = 16;

    var syms: [1]target_of.Symbol;
    syms[0].name    = entry;
    syms[0].section = target_of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 0;
    syms[0].flags   = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION;

    var mods: [1]target_of.ObjectImage;
    mods[0] = lt_image(s, lt_name(s, "loader_req"), ?secs[0], 1, ?syms[0], 1,
        nil::*target_of.Relocation, 0);
    mods[0].machine_flags = target_of.machine_flags(tgt.of, tgt.object.arch_id, tgt.abi.float_arg_bits, false);

    val tf_r: res[output_testing.Output, fail.Fail] = output_testing.create(s.alloc, "loader_req");
    if (sel tf_r.err) { ret "lt: temp failed"; }
    var tf: output_testing.Output = tf_r.ok;
    fin { output_testing.dnit(?tf); }
    val tpath: str = output_testing.path(?tf);

    mods[0].codegen = true;
    val lr: err[fail.Fail] =
        link_modules_nocapture(s, ?s.diags, tgt, ?mods[0], 1, dynlibs, dynlib_count, tpath,
        "loader_req"::*u8, mode, pie,
        target_of.image_options_default(catalog_subsystem.CONSOLE));
    # a loader the target lacks is the user's request, never a compiler defect
    if (sel lr.err && fail.kind_of(lr.err) != diagnostic_kind.LINK_NO_LOADER) { ret "lt: not a link.no_loader refusal"; }
    if (sel lr.err)                                                           { ret fail.describe(lr.err); }
    ret "";
}

test link_modules__loaderless_refuses_pie_and_dynamic {
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.select_of(lang_target.t_registry(), "x86_64", "freestanding", "sysv64", "elf");
    if (sel tr.err) { ret 1; }
    var tgt: lang_target.Binding = tr.ok;

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val libname: intern.StrId = lt_name(?s, "libfoo.so");
    var dl:      [1]target_of.DynLib;
    dl[0].name   = libname;
    dl[0].soname = libname;
    dl[0].rpath  = intern.STR_NIL;

    if (!str_equals(lt_loader_link(?s, ?tgt, catalog_artifact.EXECUTABLE, true, nil::*target_of.DynLib, 0),
        "a position-independent executable needs a loader to relocate it, and os = \"freestanding\" has none")) { ret 2; }
    if (!str_equals(lt_loader_link(?s, ?tgt, catalog_artifact.EXECUTABLE, false, ?dl[0], 1),
        "a dynamically-linked executable needs a loader to resolve it, and os = \"freestanding\" has none")) { ret 3; }
    if (!str_equals(lt_loader_link(?s, ?tgt, catalog_artifact.SHARED, false, nil::*target_of.DynLib, 0),
        "a shared library needs a loader to map it, and os = \"freestanding\" has none")) { ret 4; }
    if (!str_empty(lt_loader_link(?s, ?tgt, catalog_artifact.EXECUTABLE, false, nil::*target_of.DynLib, 0))) { ret 5; }
    ret 0;
}

test link__refuses_a_kind_the_linker_does_not_produce {
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.select_of(lang_target.t_registry(), "x86_64", "linux", "sysv64", "elf");
    if (sel tr.err) { ret 1; }
