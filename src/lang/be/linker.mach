    if (symbol == intern.STR_NIL || declared == intern.STR_NIL
        || stale == intern.STR_NIL
        || R.is_err[R.Void, str](session.register_import_library(
            ?s, symbol, stale))) { ret 1; }

    var decl: of.ImportDecl;
    decl.symbol = symbol; decl.import_name = symbol; decl.library = declared;
    decl.ordinal = 0; decl.by_name = true; decl.is_code = true;
    var module: of.ObjectImage = lt_image(
        ?s, lt_name(?s, "selected-import-record"), nil::*of.Section, 0,
        nil::*of.Symbol, 0, nil::*of.Relocation, 0);
    module.imports = ?decl;
    module.import_count = 1;

    var locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    var loc: SymbolLoc;
    loc.vaddr = 0x1000; loc.weak = false; loc.fallback = intern.STR_NIL;
    if (R.is_err[bool, str](map.insert[intern.StrId, SymbolLoc](
        ?locs, symbol, loc))) { ret 1; }
    var dyn: DynState;
    init_dynstate(?dyn);
    val built: R.Result[R.Void, str] = build_dynamic_info(
        ?s, ?tgt, ?dyn, ?module, 1, ?locs,
        nil::*of.DynLib, 0, nil::*u32, nil::*AtomPlan);
    val remains_dynamic: bool = has_unresolved_declared_imports(
        ?module, 1, ?locs);
    if (R.is_err[R.Void, str](built) || dyn.info.lib_count != 0
        || dyn.info.import_count != 0 || remains_dynamic) {
        ret 1;
    }

    free_dynstate(?alloc, ?dyn);
    map.dnit[intern.StrId, SymbolLoc](?locs);

    val weak_symbol: intern.StrId = lt_name(?s, "weak_local");
    val weak_alias: intern.StrId = lt_name(?s, "__imp_weak_local");
    if (weak_symbol == intern.STR_NIL || weak_alias == intern.STR_NIL) { ret 1; }
    var weak_decl: of.ImportDecl;
    weak_decl.symbol = weak_symbol; weak_decl.import_name = weak_symbol;
    weak_decl.library = declared; weak_decl.ordinal = 0;
    weak_decl.by_name = true; weak_decl.is_code = true;
    var weak_syms: [2]of.Symbol;
    weak_syms[0].name = weak_alias; weak_syms[0].section = of.SECTION_EXTERNAL;
    weak_syms[0].offset = 0; weak_syms[0].size = 0;
    weak_syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN
        | of.SYM_OBJ_FLAG_OBJECT;
    weak_syms[1].name = weak_symbol; weak_syms[1].section = of.SECTION_EXTERNAL;
    weak_syms[1].offset = 0; weak_syms[1].size = 0;
    weak_syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN
        | of.SYM_OBJ_FLAG_FUNCTION;
    var weak_rel: of.Relocation;
    weak_rel.section = 0; weak_rel.offset = 0; weak_rel.sym = 1;
    weak_rel.addend = 0; weak_rel.sym2 = 0;
    var weak_module: of.ObjectImage = lt_image(
        ?s, lt_name(?s, "weak-import-record"), nil::*of.Section, 0,
        ?weak_syms[0], 2, ?weak_rel, 1);
    weak_module.imports = ?weak_decl;
    weak_module.import_count = 1;
    locs = map.init[intern.StrId, SymbolLoc](
        ?alloc, map.hash_u32, map.eq_u32);
    loc.vaddr = 0x2000; loc.weak = true; loc.fallback = intern.STR_NIL;
    if (R.is_err[bool, str](map.insert[intern.StrId, SymbolLoc](
        ?locs, weak_symbol, loc))) { ret 1; }
    init_dynstate(?dyn);
    val weak_built: R.Result[R.Void, str] = build_dynamic_info(
        ?s, ?tgt, ?dyn, ?weak_module, 1, ?locs,
        nil::*of.DynLib, 0, nil::*u32, nil::*AtomPlan);
    val weak_dynamic: bool = has_unresolved_declared_imports(
        ?weak_module, 1, ?locs);
    if (R.is_err[R.Void, str](weak_built) || dyn.info.lib_count != 1
        || dyn.info.libs[0].soname != declared || dyn.info.import_count != 1
        || dyn.info.imports[0].symbol != weak_symbol || !weak_dynamic) {
        ret 1;
    }
    free_dynstate(?alloc, ?dyn);
    map.dnit[intern.StrId, SymbolLoc](?locs);
    session.dnit(?s);
    ret 0;
}

