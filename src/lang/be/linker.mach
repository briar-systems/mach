    b_syms[1].name = dup; b_syms[1].section = of.section_id(0); b_syms[1].offset = 8;
    b_syms[1].size = 8; b_syms[1].flags = weak_flags;
    b_syms[2].name = tail; b_syms[2].section = of.section_id(0); b_syms[2].offset = 16;
    b_syms[2].size = 8; b_syms[2].flags = strong_flags;

    var reloc: [1]of.Relocation;
    reloc[0].section = of.section_id(1); reloc[0].offset = 0; reloc[0].kind = of.RK_ABS64;
    reloc[0].sym = 0; reloc[0].addend = 16;
    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "winner"), ?a_sec[0], 1, ?a_syms[0], 1,
                       nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "loser"), ?b_secs[0], 2, ?b_syms[0], 3,
                       ?reloc[0], 1);
    var bases: [2]u32;
    var plan: AtomPlan;
    init_atom_plan(?plan);
    val from_debug: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 3, true, x64, ?plan);
    if (sel from_debug.err) { ret 1; }
    if (!plan.active) { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    free_atom_plan(?alloc, ?plan);

    b_secs[1].kind = of.SK_TEXT;
    val from_text: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 3, true, x64, ?plan);
    if (sel from_text.err) { ret 1; }
    if (plan.active) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.atom_plan:anchor_addend_crossing_retains_loser" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_11709: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_11709.err) { ret 1; }
    val x64: *isa.IsaVTable = lt_isa(?reg, "x86_64");
    val arm64: *isa.IsaVTable = lt_isa(?reg, "aarch64");
    if (x64 == nil || arm64 == nil) { ret 1; }

    val dup: intern.StrId = lt_name(?s, "cross$u64");
    val base: intern.StrId = lt_name(?s, "section_base");
    val tail: intern.StrId = lt_name(?s, "tail");
    val text: intern.StrId = lt_name(?s, ".text");
    val data: intern.StrId = lt_name(?s, ".data");
    val weak_flags: u32 =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    val strong_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var a_bytes: [8]u8;
    var b_bytes: [24]u8;
    var b_data: [4]u8;
    var a_sec: [1]of.Section;
    var b_secs: [2]of.Section;
    a_sec[0].name = text; a_sec[0].kind = of.SK_TEXT; a_sec[0].bytes = ?a_bytes[0];
    a_sec[0].len = 8; a_sec[0].align = 1;
    b_secs[0].name = text; b_secs[0].kind = of.SK_TEXT; b_secs[0].bytes = ?b_bytes[0];
    b_secs[0].len = 24; b_secs[0].align = 1;
    b_secs[1].name = data; b_secs[1].kind = of.SK_DATA; b_secs[1].bytes = ?b_data[0];
    b_secs[1].len = 4; b_secs[1].align = 4;

    var a_syms: [1]of.Symbol;
    var b_syms: [3]of.Symbol;
    a_syms[0].name = dup; a_syms[0].section = of.section_id(0); a_syms[0].offset = 0;
    a_syms[0].size = 8; a_syms[0].flags = weak_flags;
    b_syms[0].name = base; b_syms[0].section = of.section_id(0); b_syms[0].offset = 0;
    b_syms[0].size = 0; b_syms[0].flags = 0;
    b_syms[1].name = dup; b_syms[1].section = of.section_id(0); b_syms[1].offset = 8;
    b_syms[1].size = 8; b_syms[1].flags = weak_flags;
    b_syms[2].name = tail; b_syms[2].section = of.section_id(0); b_syms[2].offset = 16;
    b_syms[2].size = 8; b_syms[2].flags = strong_flags;

    var reloc: [1]of.Relocation;
    reloc[0].section = of.section_id(0); reloc[0].offset = 0; reloc[0].kind = of.RK_ABS64;
    reloc[0].sym = 0; reloc[0].addend = 16;
    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "winner"), ?a_sec[0], 1, ?a_syms[0], 1,
                       nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "loser"), ?b_secs[0], 2, ?b_syms[0], 3,
                       ?reloc[0], 1);
    var bases: [2]u32;
    var plan: AtomPlan;
    init_atom_plan(?plan);
    val crossing: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 3, true, x64, ?plan);
    if (sel crossing.err) { ret 1; }
    if (plan.active) { ret 1; }

    reloc[0].addend = 4;
    val same_side: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 3, true, x64, ?plan);
    if (sel same_side.err) { ret 1; }
    if (!plan.active) { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    free_atom_plan(?alloc, ?plan);

    b_bytes[3] = 0xE8;
    reloc[0].offset = 4;
    reloc[0].kind = of.RK_PC32;
    reloc[0].addend = -4;
    val pc_local: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 3, true, x64, ?plan);
    if (sel pc_local.err) { ret 1; }
    if (plan.active) { ret 1; }
    reloc[0].sym = 2;
    reloc[0].kind = of.RK_PLT32;

    val parsed_plt_data: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 1, ?bases[0], 3, true, x64, ?plan);
    if (sel parsed_plt_data.err) { ret 1; }
    if (plan.active) { ret 1; }

    reloc[0].sym = 0;
    reloc[0].addend = 3;
    val parsed_plt_trailing: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 1, ?bases[0], 3, true, x64, ?plan);
    if (sel parsed_plt_trailing.err) { ret 1; }
    if (plan.active) { ret 1; }

    reloc[0].sym = 2;
    reloc[0].addend = -4;
    reloc[0].kind = of.RK_PC32;
    val codegen_pc: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 2, ?bases[0], 3, true, x64, ?plan);
    if (sel codegen_pc.err) { ret 1; }
    if (!plan.active) { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    free_atom_plan(?alloc, ?plan);

    val arm_global: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 2, ?bases[0], 3, true, arm64, ?plan);
    if (sel arm_global.err) { ret 1; }
    if (plan.active) { ret 1; }

    reloc[0].section = of.section_id(1);
    reloc[0].offset = 0;
    reloc[0].kind = of.RK_PC32;
    val data_pc: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 2, ?bases[0], 3, true, x64, ?plan);
    if (sel data_pc.err) { ret 1; }
    if (plan.active) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.atom_plan:rv64_plt_pair_boundary" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_11825: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_11825.err) { ret 1; }
    val x64: *isa.IsaVTable = lt_isa(?reg, "x86_64");
    val arm64: *isa.IsaVTable = lt_isa(?reg, "aarch64");
    val rv64: *isa.IsaVTable = lt_isa(?reg, "riscv64");
    if (x64 == nil || arm64 == nil || rv64 == nil) { ret 1; }

    val dup: intern.StrId = lt_name(?s, "rvpair$u64");
    val ext: intern.StrId = lt_name(?s, "callee");
    val text: intern.StrId = lt_name(?s, ".text");
    val weak_flags: u32 =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    var a_bytes: [8]u8;
    var b_bytes: [16]u8;
    var a_sec: [1]of.Section;
    var b_sec: [1]of.Section;
    a_sec[0].name = text; a_sec[0].kind = of.SK_TEXT; a_sec[0].bytes = ?a_bytes[0];
    a_sec[0].len = 8; a_sec[0].align = 1;
    b_sec[0].name = text; b_sec[0].kind = of.SK_TEXT; b_sec[0].bytes = ?b_bytes[0];
    b_sec[0].len = 16; b_sec[0].align = 1;

    var a_syms: [1]of.Symbol;
    var b_syms: [2]of.Symbol;
    a_syms[0].name = dup; a_syms[0].section = of.section_id(0); a_syms[0].offset = 0;
    a_syms[0].size = 8; a_syms[0].flags = weak_flags;
    b_syms[0].name = dup; b_syms[0].section = of.section_id(0); b_syms[0].offset = 8;
    b_syms[0].size = 8; b_syms[0].flags = weak_flags;
    b_syms[1].name = ext; b_syms[1].section = of.external_section();
    b_syms[1].offset = 0; b_syms[1].size = 0;
    b_syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_FUNCTION;

    var reloc: [1]of.Relocation;
    reloc[0].section = of.section_id(0); reloc[0].offset = 4; reloc[0].kind = of.RK_PLT32;
    reloc[0].sym = 1; reloc[0].addend = 0;
    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "winner"), ?a_sec[0], 1, ?a_syms[0], 1,
                       nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "loser"), ?b_sec[0], 1, ?b_syms[0], 2,
                       ?reloc[0], 1);
    var bases: [2]u32;
    var plan: AtomPlan;
    init_atom_plan(?plan);

    val x: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, x64, ?plan);
    if (sel x.err) { ret 1; }
    if (!plan.active) { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    free_atom_plan(?alloc, ?plan);

    val arm: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, arm64, ?plan);
    if (sel arm.err) { ret 1; }
    if (!plan.active) { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    free_atom_plan(?alloc, ?plan);

    val rv: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, rv64, ?plan);
    if (sel rv.err) { ret 1; }
    if (plan.active) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.pinned_attribution_message:static_provider_vs_absent" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var bad: i32 = 0;

    val sym_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "provider_valu");
    val vend_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "vendored");
    val shared_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "shared");
    val gone_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "no-such-library");
    if (sel sym_r.err) {
        session.dnit(?s); ret 1;
    }
    if (sel vend_r.err) {
        session.dnit(?s); ret 1;
    }
    if (sel shared_r.err) {
        session.dnit(?s); ret 1;
    }
    if (sel gone_r.err) {
        session.dnit(?s); ret 1;
    }
    val sym:    intern.StrId = sym_r.ok;
    val vend:   intern.StrId = vend_r.ok;
    val shared: intern.StrId = shared_r.ok;
    val gone:   intern.StrId = gone_r.ok;

    val register_link_provider_r: err[fail.Fail] = session.register_link_provider(?s, vend, true);
    if (sel register_link_provider_r.err) {
        session.dnit(?s); ret 1;
    }
    val register_link_provider_r2: err[fail.Fail] = session.register_link_provider(?s, shared, false);
    if (sel register_link_provider_r2.err) {
        session.dnit(?s); ret 1;
    }

    val stat_msg: str = pinned_attribution_message(?s, sym, vend);
    if (!str_contains(stat_msg, "provides as a static input")) { bad = 1; }
    if (!str_contains(stat_msg, "defines symbols rather than importing them")) { bad = 1; }
    if (str_contains(stat_msg, "not among the link's dependencies")) { bad = 1; }

    val gone_msg: str = pinned_attribution_message(?s, sym, gone);
    if (!str_contains(gone_msg, "not among the link's dependencies")) { bad = 1; }
    if (!str_contains(gone_msg, "this link provides: vendored (static), shared")) { bad = 1; }
    if (str_contains(gone_msg, "defines symbols rather than importing them")) { bad = 1; }

    val register_import_library_r: err[fail.Fail] = session.register_import_library(?s, sym, vend);
    if (sel register_import_library_r.err) {
        session.dnit(?s); ret 1;
    }
    if (!str_equals(undef_message(?s, sym), stat_msg)) { bad = 1; }

    val plain_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "plain_sym");
    if (sel plain_r.err) { session.dnit(?s); ret 1; }
    if (!str_equals(undef_message(?s, plain_r.ok),
                    "undefined symbol: plain_sym")) { bad = 1; }

    session.dnit(?s);
    ret bad;
}

test "mach.lang.be.linker.dynstate_add_import_addr_fixup:preserves_addend" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    var dyn: DynState;
    init_dynstate(?dyn);

    val added: err[fail.Fail] = dynstate_add_import_addr_fixup(
        ?s, ?dyn, 2, 8, 3, 0x1234, of.RK_PC32, -4);
    if (sel added.err) { ret 1; }
    if (dyn.info.import_addr_fixup_count != 1) { ret 1; }
    if (dyn.info.import_addr_fixups[0].seg_index != 2) { ret 1; }
    if (dyn.info.import_addr_fixups[0].seg_offset != 8) { ret 1; }
    if (dyn.info.import_addr_fixups[0].import_index != 3) { ret 1; }
    if (dyn.info.import_addr_fixups[0].patch_vaddr != 0x1234) { ret 1; }
    if (dyn.info.import_addr_fixups[0].kind != of.RK_PC32) { ret 1; }
    if (dyn.info.import_addr_fixups[0].addend != -4) { ret 1; }

    free_dynstate(?alloc, ?dyn);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.local_got_plan:deduplicates_effective_target" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_11974: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_11974.err) { ret 1; }
    val x64: *isa.IsaVTable = lt_isa(?reg, "x86_64");
    val arm64: *isa.IsaVTable = lt_isa(?reg, "aarch64");
    if (x64 == nil || arm64 == nil)           { ret 1; }
    if (!isa.declares_local_got(x64))         { ret 1; }
    if (!isa.declares_local_got(arm64))       { ret 1; }

    val target_name: intern.StrId = lt_name(?s, "got_target");
    val text_name: intern.StrId = lt_name(?s, ".text");
    if (target_name == intern.STR_NIL || text_name == intern.STR_NIL) { ret 1; }

    var text_bytes: [24]u8;
    var sections: [1]of.Section;
    sections[0].name = text_name;
    sections[0].kind = of.SK_TEXT;
    sections[0].bytes = ?text_bytes[0];
    sections[0].len = 24;
    sections[0].align = 8;
    var symbols: [1]of.Symbol;
    symbols[0].name = target_name;
    symbols[0].section = of.external_section();
    symbols[0].flags = of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_GLOBAL
        | of.SYM_OBJ_FLAG_OBJECT;
    var relocs: [3]of.Relocation;
    relocs[0].section = of.section_id(0); relocs[0].offset = 0;
    relocs[0].kind = of.RK_GOTPCREL; relocs[0].sym = 0; relocs[0].addend = -4;
    relocs[1].section = of.section_id(0); relocs[1].offset = 8;
    relocs[1].kind = of.RK_GOTPCREL_NORELAX; relocs[1].sym = 0; relocs[1].addend = -4;
    relocs[2].section = of.section_id(0); relocs[2].offset = 16;
    relocs[2].kind = of.RK_GOTPCREL64_NORELAX; relocs[2].sym = 0; relocs[2].addend = -8;
    var module: of.ObjectImage = lt_image(
        ?s, lt_name(?s, "got-user"), ?sections[0], 1,
        ?symbols[0], 1, ?relocs[0], 3);

    var locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    var loc: SymbolLoc;
    loc.vaddr = 0x7000;
    loc.section_vaddr = 0x7000;
    loc.merged_index = of.SK_DATA::u32;
    loc.weak = false;
    loc.fallback = intern.STR_NIL;
    val insert_r: res[bool, A.Error] = map.insert[intern.StrId, SymbolLoc](
        ?locs, target_name, loc);
    if (sel insert_r.err) { ret 1; }

    var merged: [7]MergedSection;
    merged[of.SK_RELRO::u32].len = 3;
    var sec_base: [1]u32;
    sec_base[0] = 0;
    var plan: LocalGotPlan;
    init_local_got_plan(?plan);
    var groups: SectionGroups;
    init_section_groups(?groups);
    var undeclared: LocalGotPlan;
    init_local_got_plan(?undeclared);
    val skipped: err[fail.Fail] = build_local_got_plan(
        ?s, arm64, ?module, 1, ?locs, ?sec_base[0], nil::*AtomPlan,
        ?merged[0], ?groups, ?undeclared);
    if (sel skipped.err) { ret 1; }
    if (undeclared.count != 0) { ret 1; }
    free_local_got_plan(?alloc, ?undeclared);

    val built: err[fail.Fail] = build_local_got_plan(
        ?s, x64, ?module, 1, ?locs, ?sec_base[0], nil::*AtomPlan,
        ?merged[0], ?groups, ?plan);
    if (sel built.err) { ret 1; }
    if (plan.count != 1) { ret 1; }
    if (plan.slots[0].offset != 8) { ret 1; }
    if (merged[of.SK_RELRO::u32].len != 16) { ret 1; }
    if (merged[of.SK_RELRO::u32].align != 8) { ret 1; }
    if (!merged[of.SK_RELRO::u32].used) { ret 1; }

    merged[of.SK_RELRO::u32].vaddr = 0x5000;
    finalize_local_got_vaddrs(?merged[0], ?plan);
    if (plan.slots[0].vaddr != 0x5008) { ret 1; }

    free_local_got_plan(?alloc, ?plan);
    map.dnit[intern.StrId, SymbolLoc](?locs);
    session.dnit(?s);
    ret 0;
}

fun lt_common_module(s: *session.Session, mod_name: str, name: str, size: u32, align: u32) of.ObjectImage {
    val alloc: *A.Allocator = s.alloc;
    val mn: res[intern.StrId, A.Error] = intern.intern(?s.interner, mod_name);
    val sn: res[intern.StrId, A.Error] = intern.intern(?s.interner, name);
    var img: of.ObjectImage;
    if (sel mn.err) { ret img; }
    if (sel sn.err) { ret img; }
    val img_r: res[of.ObjectImage, fail.Fail] = obj.image_init(alloc, ?s.interner, mn.ok);
    if (sel img_r.ok) { img = img_r.ok; }
    var sym: of.Symbol;
    sym.name    = sn.ok;
    sym.section = of.external_section();
    sym.offset  = 0;
    sym.size    = size;
    sym.align   = align;
    sym.flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_COMMON;
    obj.symbol_add(?img, sym);
    ret img;
}

test "mach.lang.be.linker.synthesize_common_storage:coalesces_to_the_largest_request" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var mods: [2]of.ObjectImage;
    mods[0] = lt_common_module(?s, "a.o", "_shared", 8, 4);
    mods[1] = lt_common_module(?s, "b.o", "_shared", 40, 16);

    var bad: i32 = 0;
    var out: of.ObjectImage;
    val cr: res[bool, fail.Fail] = synthesize_common_storage(?s, ?mods[0], 2, LINK_EXE, ?out);
    if (sel cr.err) { bad = 2; }
    or (sel cr.ok && !cr.ok) { bad = 3; }
    or {
        if (out.symbol_count != 1                      && bad == 0) { bad = 4; }
        or (out.section_count != 1                     && bad == 0) { bad = 5; }
        or {
            if (out.symbols[0].size != 40              && bad == 0) { bad = 6; }
            if (out.sections[0].len != 40              && bad == 0) { bad = 7; }
            if (out.sections[0].align != 16            && bad == 0) { bad = 8; }
            if (out.sections[0].kind != of.SK_BSS      && bad == 0) { bad = 9; }
            if (out.sections[0].bytes != nil           && bad == 0) { bad = 10; }
            if ((out.symbols[0].flags & of.SYM_OBJ_FLAG_GLOBAL) == 0 && bad == 0) { bad = 11; }
            if ((out.symbols[0].flags & of.SYM_OBJ_FLAG_EXTERN) != 0 && bad == 0) { bad = 12; }
        }
        obj.dnit(?out);
    }

    obj.dnit(?mods[0]);
    obj.dnit(?mods[1]);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.be.linker.synthesize_common_storage:a_real_definition_wins" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var mods: [2]of.ObjectImage;
    mods[0] = lt_common_module(?s, "a.o", "_shared", 40, 16);

    val mn: res[intern.StrId, A.Error] = intern.intern(?s.interner, "b.o");
    val dn: res[intern.StrId, A.Error] = intern.intern(?s.interner, ".data");
    val sn: res[intern.StrId, A.Error] = intern.intern(?s.interner, "_shared");
    if (sel mn.err) { ret 1; }
    if (sel dn.err) { ret 1; }
    if (sel sn.err) { ret 1; }
    val mod_r: res[of.ObjectImage, fail.Fail] = obj.image_init(?alloc, ?s.interner, mn.ok);
    if (sel mod_r.err) { ret 1; }
    mods[1] = mod_r.ok;
    val bytes_r: res[*u8, A.Error] = A.zallocate[u8](?alloc, 8::usize);
    if (sel bytes_r.err) { ret 1; }
    var sec: of.Section;
    sec.name = dn.ok;
    sec.kind = of.SK_DATA;
    sec.bytes = bytes_r.ok;
    sec.len = 8;
    sec.align = 8;
    sec.flags = 0;
    val si: res[u32, fail.Fail] = obj.section_install(?mods[1], ?sec);
    if (sel si.err) { ret 1; }
    var dsym: of.Symbol;
    dsym.name    = sn.ok;
    dsym.section = of.section_id(si.ok);
    dsym.offset  = 0;
    dsym.size    = 8;
    dsym.flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    dsym.fallback = of.SYMBOL_NONE;
    dsym.align    = 8;
    obj.symbol_add(?mods[1], dsym);

    var bad: i32 = 0;
    var out: of.ObjectImage;
    val cr: res[bool, fail.Fail] = synthesize_common_storage(?s, ?mods[0], 2, LINK_EXE, ?out);
    if (sel cr.ok && cr.ok) {
        bad = 3;
        obj.dnit(?out);
    }

    if (bad == 0) {
        var out2: of.ObjectImage;
        val rr: res[bool, fail.Fail] = synthesize_common_storage(?s, ?mods[0], 1, LINK_RELOCATABLE, ?out2);
        if (sel rr.err) { bad = 4; }
        or (sel rr.ok && rr.ok) { bad = 5; obj.dnit(?out2); }
    }

    obj.dnit(?mods[0]);
    obj.dnit(?mods[1]);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.be.linker.synthesize_common_storage:refuses_layout_exceeding_2gib" {
    var alloc: A.Allocator;
