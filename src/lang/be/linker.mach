test "mach.lang.be.linker.synthesize_local_imports:defined_local_import" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val x: intern.StrId = lt_name(?s, "local_x");
    val y: intern.StrId = lt_name(?s, "weak_y");
    val z: intern.StrId = lt_name(?s, "defined_z");
    val missing: intern.StrId = lt_name(?s, "missing");
    val imp_x: intern.StrId = lt_name(?s, "__imp_local_x");
    val imp_y: intern.StrId = lt_name(?s, "__imp_weak_y");
    val imp_z: intern.StrId = lt_name(?s, "__imp_defined_z");
    val imp_missing: intern.StrId = lt_name(?s, "__imp_missing");
    if (x == intern.STR_NIL || y == intern.STR_NIL || z == intern.STR_NIL
        || missing == intern.STR_NIL || imp_x == intern.STR_NIL
        || imp_y == intern.STR_NIL || imp_z == intern.STR_NIL
        || imp_missing == intern.STR_NIL) { ret 1; }

    var code: [1]u8; code[0] = 0xC3;
    var text: of.Section;
    text.name = lt_name(?s, ".text"); text.kind = of.SK_TEXT;
    text.bytes = ?code[0]; text.len = 1; text.align = 1;
    val global: u32 = of.SYM_OBJ_FLAG_GLOBAL;
    val external: u32 = global | of.SYM_OBJ_FLAG_EXTERN;

    var defs: [4]of.Symbol;
    defs[0].name = x; defs[0].section = 0; defs[0].offset = 0;
    defs[0].size = 1; defs[0].flags = global | of.SYM_OBJ_FLAG_FUNCTION;
    defs[1].name = y; defs[1].section = 0; defs[1].offset = 0;
    defs[1].size = 1; defs[1].flags = global | of.SYM_OBJ_FLAG_WEAK;
    defs[2].name = z; defs[2].section = 0; defs[2].offset = 0;
    defs[2].size = 1; defs[2].flags = global;
    defs[3].name = imp_z; defs[3].section = 0; defs[3].offset = 0;
    defs[3].size = 1; defs[3].flags = global;

    var refs: [6]of.Symbol;
    refs[0].name = imp_x; refs[0].section = of.SECTION_EXTERNAL;
    refs[0].flags = external | of.SYM_OBJ_FLAG_FUNCTION;
    refs[1] = refs[0];
    refs[2].name = imp_y; refs[2].section = of.SECTION_EXTERNAL;
    refs[2].flags = external;
    refs[3].name = imp_z; refs[3].section = of.SECTION_EXTERNAL;
    refs[3].flags = external;
    refs[4].name = imp_missing; refs[4].section = of.SECTION_EXTERNAL;
    refs[4].flags = external;
    refs[5].name = imp_x; refs[5].section = of.SECTION_EXTERNAL;
    refs[5].flags = external | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FALLBACK;
    refs[5].fallback = 4;

    var ref_code: [4]u8;
    var ref_text: of.Section;
    ref_text.name = lt_name(?s, ".text"); ref_text.kind = of.SK_TEXT;
    ref_text.bytes = ?ref_code[0]; ref_text.len = 4; ref_text.align = 1;
    var ref_reloc: of.Relocation;
    ref_reloc.section = 0; ref_reloc.offset = 0;
    ref_reloc.kind = of.RK_PC32; ref_reloc.sym = 0; ref_reloc.addend = 0;

    var modules: [2]of.ObjectImage;
    modules[0] = lt_image(?s, lt_name(?s, "local-defs"), ?text, 1,
                          ?defs[0], 4, nil::*of.Relocation, 0);
    modules[1] = lt_image(?s, lt_name(?s, "local-refs"), ?ref_text, 1,
                          ?refs[0], 6, ?ref_reloc, 1);

    var synth: of.ObjectImage;
    val made: R.Result[bool, str] = synthesize_local_imports(
        ?s, "__imp_", ?modules[0], 2, LINK_EXE,
        nil::*u32, nil::*AtomPlan, ?synth);
    if (R.is_err[bool, str](made) || !R.unwrap_ok[bool, str](made)
        || synth.section_count != 1 || synth.sections[0].kind != of.SK_RELRO
        || synth.sections[0].len != 8 || synth.sections[0].align != 8
        || synth.symbol_count != 2 || synth.reloc_count != 1
        || synth.symbols[0].name != imp_x || synth.symbols[0].section != 0
        || synth.symbols[0].offset != 0 || synth.symbols[0].size != 8
        || synth.symbols[0].flags != global
        || synth.symbols[1].name != x
        || synth.symbols[1].section != of.SECTION_EXTERNAL
        || synth.relocations[0].section != 0 || synth.relocations[0].offset != 0
        || synth.relocations[0].kind != of.RK_ABS64
        || synth.relocations[0].sym != 1 || synth.relocations[0].addend != 0) {
        if (R.is_ok[bool, str](made) && R.unwrap_ok[bool, str](made)) { obj.dnit(?synth); }
        session.dnit(?s);
        ret 1;
    }
    obj.dnit(?synth);

    var untouched: of.ObjectImage;
    val relocatable: R.Result[bool, str] = synthesize_local_imports(
        ?s, "__imp_", ?modules[0], 2, LINK_RELOCATABLE,
        nil::*u32, nil::*AtomPlan, ?untouched);
    if (R.is_err[bool, str](relocatable)
        || R.unwrap_ok[bool, str](relocatable)) {
        session.dnit(?s);
        ret 1;
    }

    var corrupt_def: of.Symbol = defs[0];
    corrupt_def.section = 1;
    var corrupt_modules: [2]of.ObjectImage;
    corrupt_modules[0] = lt_image(?s, lt_name(?s, "corrupt-local-def"), ?text, 1,
                                  ?corrupt_def, 1, nil::*of.Relocation, 0);
    corrupt_modules[1] = modules[1];
    val malformed: R.Result[bool, str] = synthesize_local_imports(
        ?s, "__imp_", ?corrupt_modules[0], 2, LINK_EXE,
        nil::*u32, nil::*AtomPlan, ?untouched);
    var corrupt_locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    val diagnosed: R.Result[R.Void, str] = collect_symbols(
        ?s, ?corrupt_modules[0], 2, nil::*Placement, nil::*u32,
        ?corrupt_locs, false, nil::*AtomPlan);
    map.dnit[intern.StrId, SymbolLoc](?corrupt_locs);
    val max_size: R.Result[u32, str] = local_import_storage_size(0x1FFFFFFF);
    val overflow: R.Result[u32, str] = local_import_storage_size(0x20000000);
    session.dnit(?s);
    if (R.is_err[bool, str](malformed)
        || R.unwrap_ok[bool, str](malformed)
        || !R.is_err[R.Void, str](diagnosed)
        || R.is_err[u32, str](max_size)
        || R.unwrap_ok[u32, str](max_size) != 0xFFFFFFF8
        || !R.is_err[u32, str](overflow)) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.synthesize_local_imports:dead_weak_comdat" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    val tr: R.Result[target.Target, str] =
        target.select(?reg, "x86_64", "windows", "win64");
    if (R.is_err[target.Target, str](tr)) { ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);

    val choice: intern.StrId = lt_name(?s, "qz_select_any");
    val local: intern.StrId = lt_name(?s, "dead_local");
    val alias: intern.StrId = lt_name(?s, "__imp_dead_local");
    if (choice == intern.STR_NIL || local == intern.STR_NIL
        || alias == intern.STR_NIL) { ret 1; }

    var winner_bytes: [4]u8;
    var loser_bytes: [8]u8;
    var provider_bytes: [1]u8;
    var sections: [3]of.Section;
    sections[0].name = lt_name(?s, ".text$winner");
    sections[0].kind = of.SK_TEXT; sections[0].bytes = ?winner_bytes[0];
    sections[0].len = 4; sections[0].align = 1;
    sections[1].name = lt_name(?s, ".text$loser");
    sections[1].kind = of.SK_TEXT; sections[1].bytes = ?loser_bytes[0];
    sections[1].len = 8; sections[1].align = 1;
    sections[2].name = lt_name(?s, ".text");
    sections[2].kind = of.SK_TEXT; sections[2].bytes = ?provider_bytes[0];
    sections[2].len = 1; sections[2].align = 1;

    val weak_fn: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK
        | of.SYM_OBJ_FLAG_FUNCTION;
    var winner: of.Symbol;
    winner.name = choice; winner.section = 0; winner.offset = 0;
    winner.size = 4; winner.flags = weak_fn;
    var loser_syms: [2]of.Symbol;
    loser_syms[0].name = choice; loser_syms[0].section = 0;
    loser_syms[0].offset = 0; loser_syms[0].size = 8;
    loser_syms[0].flags = weak_fn;
    loser_syms[1].name = alias;
    loser_syms[1].section = of.SECTION_EXTERNAL;
    loser_syms[1].offset = 0; loser_syms[1].size = 0;
    loser_syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN
        | of.SYM_OBJ_FLAG_OBJECT;
    var provider: of.Symbol;
    provider.name = local; provider.section = 0; provider.offset = 0;
    provider.size = 1;
    provider.flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var loser_reloc: of.Relocation;
    loser_reloc.section = 0; loser_reloc.offset = 0;
    loser_reloc.kind = of.RK_PC32; loser_reloc.sym = 1;
    loser_reloc.addend = 0;

    var modules: [3]of.ObjectImage;
    modules[0] = lt_image(?s, lt_name(?s, "winner"), ?sections[0], 1,
                          ?winner, 1, nil::*of.Relocation, 0);
    modules[1] = lt_image(?s, lt_name(?s, "loser"), ?sections[1], 1,
                          ?loser_syms[0], 2, ?loser_reloc, 1);
    modules[2] = lt_image(?s, lt_name(?s, "provider"), ?sections[2], 1,
                          ?provider, 1, nil::*of.Relocation, 0);

    var sec_base: [3]u32;
    var atoms: AtomPlan;
    init_atom_plan(?atoms);
    val planned: R.Result[R.Void, str] = build_atom_plan(
        ?s, ?modules[0], 3, 0, ?sec_base[0], 3, true, tgt.isa, ?atoms);
    var synth: of.ObjectImage;
    val dead: R.Result[bool, str] = synthesize_local_imports(
        ?s, "__imp_", ?modules[0], 3, LINK_EXE,
        ?sec_base[0], ?atoms, ?synth);
    var control: of.ObjectImage;
    val inert: R.Result[bool, str] = synthesize_local_imports(
        ?s, "__imp_", ?modules[0], 3, LINK_EXE,
        nil::*u32, nil::*AtomPlan, ?control);
    if (R.is_ok[bool, str](inert) && R.unwrap_ok[bool, str](inert)) {
        obj.dnit(?control);
    }
    val discarded: bool = atoms.active;
    free_atom_plan(?alloc, ?atoms);
    session.dnit(?s);
    if (R.is_err[R.Void, str](planned) || !discarded
        || R.is_err[bool, str](dead) || R.unwrap_ok[bool, str](dead)
        || R.is_err[bool, str](inert) || !R.unwrap_ok[bool, str](inert)) {
        ret 1;
    }
    ret 0;
}

