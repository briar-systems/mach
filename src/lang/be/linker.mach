fun t_planned_object(tgt: *target.Target, image: *of.ObjectImage, name: *u8) R.Result[R.Void, str] {
    var operation: publication.Plan;
    val opened: R.Result[*publication.Destination, str] = t_publication_open(?operation, image.alloc, name::str);
    if (R.is_err[*publication.Destination, str](opened)) { ret t_publication_close(?operation, R.err[R.Void, str](R.unwrap_err[*publication.Destination, str](opened))); }
    ret t_publication_close(?operation, tgt.of.emit_object(?tgt.object, image, R.unwrap_ok[*publication.Destination, str](opened)));
}

fun t_planned_archive(alloc: *A.Allocator, members: *ar.ArMember, count: u32, name: str) R.Result[R.Void, str] {
    var operation: publication.Plan;
    val opened: R.Result[*publication.Destination, str] = t_publication_open(?operation, alloc, name);
    if (R.is_err[*publication.Destination, str](opened)) {
        ret t_publication_close(?operation, R.err[R.Void, str](R.unwrap_err[*publication.Destination, str](opened)));
    }
    ret t_publication_close(?operation, ar.write_archive(alloc, members, count,
        R.unwrap_ok[*publication.Destination, str](opened)));
}

test "mach.lang.be.linker.link_modules:arm64_import_tail_branch" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    fin { session.dnit(?s); }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { ret 2; }
    val tr: R.Result[target.Target, str] = target.select(?reg, "aarch64", "darwin", "aapcs64");
    if (R.is_err[target.Target, str](tr)) { ret 3; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);
    val pin: intern.StrId = lt_name(?s, "libSystem");
    val imported: intern.StrId = lt_name(?s, "_calloc");
    if (R.is_err[R.Void, str](session.register_import_library(?s, imported, pin))) { ret 4; }
    var provider: of.DynLib;
    provider.name = pin;
    provider.soname = lt_name(?s, "/usr/lib/libSystem.B.dylib");
    provider.include_referenced = true;

    var bytes: [8]u8;
    bin.write_u32_le(?bytes[0], 0, 0x14000000);
    bin.write_u32_le(?bytes[0], 4, 0x94000000);
    var section: of.Section;
    section.name = lt_name(?s, ".text"); section.kind = of.SK_TEXT;
    section.bytes = ?bytes[0]; section.len = 8; section.align = 4;
    var symbols: [2]of.Symbol;
    symbols[0].name = lt_name(?s, tgt.os.entry_symbol);
    symbols[0].section = 0; symbols[0].offset = 0; symbols[0].size = 8;
    symbols[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    symbols[1].name = imported; symbols[1].section = of.SECTION_EXTERNAL;
    symbols[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;
    var relocations: [2]of.Relocation;
    relocations[0].section = 0; relocations[0].offset = 0;
    relocations[0].kind = of.RK_JUMP26; relocations[0].sym = 1;
    relocations[1].section = 0; relocations[1].offset = 4;
    relocations[1].kind = of.RK_PLT32; relocations[1].sym = 1;
    var module: of.ObjectImage = lt_image(?s, lt_name(?s, "tail_import"),
        ?section, 1, ?symbols[0], 2, ?relocations[0], 1);

    val fr: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "tail_import");
    if (R.is_err[fs.TempFile, str](fr)) { ret 5; }
    var file: fs.TempFile = R.unwrap_ok[fs.TempFile, str](fr);
    fin { fs.temp_close_and_remove(?file); }
    val path: str = fs.temp_path(?file);
    var count: u32 = 1;
    for (count <= 2) {
        module.reloc_count = count;
        val linked: R.Result[R.Void, str] = link_modules_nocapture(?s, ?tgt,
            ?module, 1, 1, ?provider, 1, path::*u8, "tail_import"::*u8,
            LINK_EXE, true, of.image_options_default(of.SUBSYSTEM_CONSOLE));
        if (R.is_err[R.Void, str](linked)) { ret 6; }
        val rr: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, path);
        if (R.is_err[Vector[u8], str](rr)) { ret 7; }
        var image: Vector[u8] = R.unwrap_ok[Vector[u8], str](rr);
        fin { vector.dnit[u8](?image); }
        val text: usize = lt_macho_section(image.data, "__TEXT", "__text");
        val stubs: usize = lt_macho_section(image.data, "__STUBS", "__stubs");
        if (text == 0 || stubs == 0) { ret 8; }
        val file_offset: usize = bin.read_u32_le(image.data, text + 48)::usize;
        val text_va: u64 = bin.read_u64_le(image.data, text + 32);
        val stub_va: u64 = bin.read_u64_le(image.data, stubs + 32);
        if (bin.read_u64_le(image.data, stubs + 40) != 12) { ret 9; }
        var i: u32 = 0;
        for (i < count) {
            val word: u32 = bin.read_u32_le(image.data, file_offset + i::usize * 4);
            var opcode: u32 = 0x14000000;
            if (i == 1) { opcode = 0x94000000; }
            if ((word & 0xFC000000) != opcode) { ret 10; }
            val displacement: i64 = ((word & 0x03FFFFFF)::i32 << 6)::i64 >> 4;
            if ((text_va::i64 + i::i64 * 4 + displacement)::u64 != stub_va) { ret 11; }
            i = i + 1;
        }
        count = count + 1;
    }
    val refused: R.Result[R.Void, str] = link_modules_nocapture(?s, ?tgt,
        ?module, 1, 1, nil::*of.DynLib, 0, path::*u8, "tail_import"::*u8,
        LINK_EXE, true, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (!R.is_err[R.Void, str](refused)
        || !str_contains(R.unwrap_err[R.Void, str](refused), "not among the link's dependencies")) { ret 12; }
    ret 0;
}
