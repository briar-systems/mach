    bad_bytes[4] = 5; bad_bytes[5] = 6; bad_bytes[6] = 7; bad_bytes[7] = 8;

    var sec: of.Section;
    sec.name  = lt_name(?s, ".debug_str");
    sec.kind  = of.SK_DEBUG;
    sec.bytes = ?bad_bytes[0];
    sec.len   = 8;
    sec.align = 1;

    var mods: [1]of.ObjectImage;
