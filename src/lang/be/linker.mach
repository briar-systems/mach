fun lt_roundtrip_symbol_size(s: *session.Session, tgt: *target.Target, out: *u32) bool {
    val alloc: *A.Allocator = s.alloc;
    val text: intern.StrId = lt_name(s, ".text");
    val fname: intern.StrId = lt_name(s, "sized_probe");
    if (text == intern.STR_NIL || fname == intern.STR_NIL) { ret false; }

    var body: [16]u8;
    var i: u32 = 0;
    for (i < 16) { body[i] = (0x90 + i)::u8; i = i + 1; }

    var secs: [1]of.Section;
    secs[0].name = text; secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?body[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = fname; syms[0].section = 0; syms[0].offset = 0; syms[0].size = 16;
    syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var img: of.ObjectImage = lt_image(s, lt_name(s, "sized"), ?secs[0], 1,
                                       ?syms[0], 1, nil::*of.Relocation, 0);

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(alloc, "sym_size_probe");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret false; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val path: str = fs.temp_path(?tf);

    var ok: bool = false;
    if (R.is_ok[R.Void, str](t_planned_object(tgt, ?img, path::*u8))) {
        val rr: R.Result[Vector[u8], str] = fs.read_bytes(alloc, path);
        if (R.is_ok[Vector[u8], str](rr)) {
            var raw: Vector[u8] = R.unwrap_ok[Vector[u8], str](rr);
            var back: of.ObjectImage;
            val pr: R.Result[R.Void, str] = tgt.of.parse_object(
                alloc, ?s.interner, raw.data, raw.len, ?back);
            if (R.is_ok[R.Void, str](pr)) {
                var sy: u32 = 0;
                for (sy < back.symbol_count) {
                    if (back.symbols[sy].name == fname) { @out = back.symbols[sy].size; ok = true; }
                    sy = sy + 1;
                }
            }
            vector.dnit[u8](?raw);
        }
    }
    fs.temp_close_and_remove(?tf);
    ret ok;
}

test "mach.lang.be.linker.symbol_size:carried_by_elf_only" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    val er: R.Result[target.Target, str] = target.select(?reg, "x86_64", "linux", "sysv64");
    val mr: R.Result[target.Target, str] = target.select(?reg, "x86_64", "darwin", "sysv64");
    val cr: R.Result[target.Target, str] = target.select(?reg, "x86_64", "windows", "win64");
    if (R.is_err[target.Target, str](er) || R.is_err[target.Target, str](mr)
        || R.is_err[target.Target, str](cr)) { ret 1; }
    var elf_tgt: target.Target = R.unwrap_ok[target.Target, str](er);
    var macho_tgt: target.Target = R.unwrap_ok[target.Target, str](mr);
    var coff_tgt: target.Target = R.unwrap_ok[target.Target, str](cr);

    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var code: i32 = 0;
    var elf_size: u32 = 0xFFFFFFFF;
    var macho_size: u32 = 0xFFFFFFFF;
    var coff_size: u32 = 0xFFFFFFFF;
    if (!lt_roundtrip_symbol_size(?s, ?elf_tgt, ?elf_size))     { code = 1; }
    if (!lt_roundtrip_symbol_size(?s, ?macho_tgt, ?macho_size)) { code = 1; }
    if (!lt_roundtrip_symbol_size(?s, ?coff_tgt, ?coff_size))   { code = 1; }
    session.dnit(?s);

    if (elf_size != 16)  { code = 1; }
    if (macho_size != 0) { code = 1; }
    if (coff_size != 0)  { code = 1; }
    ret code;
}

fun lt_isa(reg: *target.TargetRegistry, name: str) *isa.IsaVTable {
    val found: O.Option[*isa.IsaVTable] = isa.lookup(?reg.isa, name);
    if (!O.is_some[*isa.IsaVTable](found)) { ret nil; }
    ret O.unwrap[*isa.IsaVTable](found);
}

test "mach.lang.be.linker.archive_resolution:ordered_fixed_point" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val root: intern.StrId = lt_name(?s, "root");
    val dep: intern.StrId = lt_name(?s, "dependency");
    val common: intern.StrId = lt_name(?s, "common_data");
    val startup: intern.StrId = lt_name(?s, "WinMainCRTStartup");
    if (root == intern.STR_NIL || dep == intern.STR_NIL || common == intern.STR_NIL
        || startup == intern.STR_NIL) { session.dnit(?s); ret 1; }

    val undef_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;
    val def_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var seed_syms: [2]of.Symbol;
    seed_syms[0].name = root; seed_syms[0].section = of.SECTION_EXTERNAL;
    seed_syms[0].offset = 0; seed_syms[0].size = 0; seed_syms[0].flags = undef_flags;
    seed_syms[1].name = common; seed_syms[1].section = of.SECTION_EXTERNAL;
    seed_syms[1].offset = 8; seed_syms[1].size = 8;
    seed_syms[1].flags = undef_flags | of.SYM_OBJ_FLAG_OBJECT;
    var seed: of.ObjectImage = lt_image(?s, lt_name(?s, "seed"),
        nil::*of.Section, 0, ?seed_syms[0], 2, nil::*of.Relocation, 0);

    var early_sym: of.Symbol;
    early_sym.name = dep; early_sym.section = 0; early_sym.offset = 0;
    early_sym.size = 0; early_sym.flags = def_flags | of.SYM_OBJ_FLAG_WEAK;
    var early: of.ObjectImage = lt_image(?s, lt_name(?s, "early"),
        nil::*of.Section, 0, ?early_sym, 1, nil::*of.Relocation, 0);

    var late_syms: [3]of.Symbol;
    late_syms[0].name = root; late_syms[0].section = 0; late_syms[0].offset = 0;
    late_syms[0].size = 0; late_syms[0].flags = def_flags;
    late_syms[1].name = dep; late_syms[1].section = of.SECTION_EXTERNAL;
    late_syms[1].offset = 0; late_syms[1].size = 0; late_syms[1].flags = undef_flags;
    late_syms[2].name = root; late_syms[2].section = of.SECTION_EXTERNAL;
    late_syms[2].offset = 0; late_syms[2].size = 0; late_syms[2].flags = undef_flags;
    var late: of.ObjectImage = lt_image(?s, lt_name(?s, "late"),
        nil::*of.Section, 0, ?late_syms[0], 3, nil::*of.Relocation, 0);

    var common_sym: of.Symbol;
    common_sym.name = common; common_sym.section = 0; common_sym.offset = 0;
    common_sym.size = 8;
    common_sym.flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    var common_def: of.ObjectImage = lt_image(?s, lt_name(?s, "common-def"),
        nil::*of.Section, 0, ?common_sym, 1, nil::*of.Relocation, 0);

    var unused_sym: of.Symbol;
    unused_sym.name = startup; unused_sym.section = 0; unused_sym.offset = 0;
    unused_sym.size = 0; unused_sym.flags = def_flags;
    var unused: of.ObjectImage = lt_image(?s, lt_name(?s, "startup"),
        nil::*of.Section, 0, ?unused_sym, 1, nil::*of.Relocation, 0);

    var dbg_sec: of.Section;
    dbg_sec.name = lt_name(?s, ".debug_info"); dbg_sec.kind = of.SK_DEBUG;
    dbg_sec.bytes = nil; dbg_sec.len = 0; dbg_sec.align = 1;
    var dbg_sym: of.Symbol = late_syms[0];
    var debug_only: of.ObjectImage = lt_image(?s, lt_name(?s, "debug"),
        ?dbg_sec, 1, ?dbg_sym, 1, nil::*of.Relocation, 0);

    var state: ArchiveResolution;
    init_archive_resolution(?alloc, ?state);
    if (R.is_err[R.Void, str](archive_note_image(?s, "", ?state, ?seed))) { ret 1; }
    val e0: R.Result[bool, str] = archive_image_needed(?s, "", ?state, ?early);
    val u0: R.Result[bool, str] = archive_image_needed(?s, "", ?state, ?unused);
    val d0: R.Result[bool, str] = archive_image_needed(?s, "", ?state, ?debug_only);
    val l0: R.Result[bool, str] = archive_image_needed(?s, "", ?state, ?late);
    if (R.is_err[bool, str](e0) || R.unwrap_ok[bool, str](e0)
        || R.is_err[bool, str](u0) || R.unwrap_ok[bool, str](u0)
        || R.is_err[bool, str](d0) || R.unwrap_ok[bool, str](d0)
        || R.is_err[bool, str](l0) || !R.unwrap_ok[bool, str](l0)) { ret 1; }
    if (R.is_err[R.Void, str](archive_note_image(?s, "", ?state, ?late))) { ret 1; }
    val e1: R.Result[bool, str] = archive_image_needed(?s, "", ?state, ?early);
    val c1: R.Result[bool, str] = archive_image_needed(?s, "", ?state, ?common_def);
    if (R.is_err[bool, str](e1) || !R.unwrap_ok[bool, str](e1)
        || R.is_err[bool, str](c1) || !R.unwrap_ok[bool, str](c1)) { ret 1; }
    if (R.is_err[R.Void, str](archive_note_image(?s, "", ?state, ?early))) { ret 1; }
    if (R.is_err[R.Void, str](archive_note_image(?s, "", ?state, ?common_def))) { ret 1; }
    var duplicate: of.ObjectImage = late;
    duplicate.symbols = ?late_syms[1]; duplicate.symbol_count = 1;
    late_syms[1].section = 0; late_syms[1].flags = def_flags;
    val dupe: R.Result[bool, str] = archive_image_needed(?s, "", ?state, ?duplicate);
    if (R.is_err[bool, str](dupe) || R.unwrap_ok[bool, str](dupe)
        || state.unresolved.len != 0) { ret 1; }

    free_archive_resolution(?state);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.archive_resolution:entry_root" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val entry: intern.StrId = lt_name(?s, "mainCRTStartup");
    var sym: of.Symbol;
    sym.name = entry; sym.section = 0; sym.offset = 0; sym.size = 0;
    sym.flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var member: of.ObjectImage = lt_image(?s, lt_name(?s, "entry-member"),
        nil::*of.Section, 0, ?sym, 1, nil::*of.Relocation, 0);

    var state: ArchiveResolution;
    init_archive_resolution(?alloc, ?state);
    if (R.is_err[R.Void, str](archive_require(?state, entry))) { ret 1; }
    val needed: R.Result[bool, str] = archive_image_needed(?s, "", ?state, ?member);
    if (R.is_err[bool, str](needed) || !R.unwrap_ok[bool, str](needed)) { ret 1; }
    if (R.is_err[R.Void, str](archive_note_image(?s, "", ?state, ?member))
        || state.unresolved.len != 0) { ret 1; }

    free_archive_resolution(?state);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.archive_resolution:test_entry_satisfies_main_before_archive" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { session.dnit(?s); ret 1; }
    val tr: R.Result[target.Target, str] =
        target.select(?reg, "x86_64", "windows", "win64");
    if (R.is_err[target.Target, str](tr)) { session.dnit(?s); ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);

    val text:      intern.StrId = lt_name(?s, ".text");
    val entry_sym: intern.StrId = lt_name(?s, "mainCRTStartup");
    val main_sym:  intern.StrId = lt_name(?s, "main");
    val helper:    intern.StrId = lt_name(?s, "helper");
    if (text == intern.STR_NIL || entry_sym == intern.STR_NIL
        || main_sym == intern.STR_NIL || helper == intern.STR_NIL) {
        session.dnit(?s); ret 1;
    }

    val def_fn: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    val undef:  u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;

    var eb: [8]u8; var cb: [8]u8; var hb: [8]u8; var sb: [8]u8;
    var i: u32 = 0;
    for (i < 8) {
        eb[i] = 0xCC; cb[i] = 0x90; hb[i] = 0xA5; sb[i] = 0x33;
        i = i + 1;
    }

    var entry_secs: [1]of.Section;
    entry_secs[0].name = text; entry_secs[0].kind = of.SK_TEXT;
    entry_secs[0].bytes = ?eb[0]; entry_secs[0].len = 8; entry_secs[0].align = 8;
    var entry_syms: [2]of.Symbol;
    entry_syms[0].name = main_sym; entry_syms[0].section = 0; entry_syms[0].offset = 0;
    entry_syms[0].size = 8; entry_syms[0].flags = def_fn;
    entry_syms[1].name = helper; entry_syms[1].section = of.SECTION_EXTERNAL;
    entry_syms[1].offset = 0; entry_syms[1].size = 0; entry_syms[1].flags = undef;
    var entry_img: of.ObjectImage = lt_image(?s, lt_name(?s, "test-entry"),
        ?entry_secs[0], 1, ?entry_syms[0], 2, nil::*of.Relocation, 0);

    var crt_secs: [1]of.Section;
    crt_secs[0].name = text; crt_secs[0].kind = of.SK_TEXT;
    crt_secs[0].bytes = ?cb[0]; crt_secs[0].len = 8; crt_secs[0].align = 8;
    var crt_syms: [2]of.Symbol;
    crt_syms[0].name = entry_sym; crt_syms[0].section = 0; crt_syms[0].offset = 0;
    crt_syms[0].size = 8; crt_syms[0].flags = def_fn;
    crt_syms[1].name = main_sym; crt_syms[1].section = of.SECTION_EXTERNAL;
    crt_syms[1].offset = 0; crt_syms[1].size = 0; crt_syms[1].flags = undef;
    var crt_img: of.ObjectImage = lt_image(?s, lt_name(?s, "crt"),
        ?crt_secs[0], 1, ?crt_syms[0], 2, nil::*of.Relocation, 0);

    var helper_secs: [1]of.Section;
    helper_secs[0].name = text; helper_secs[0].kind = of.SK_TEXT;
    helper_secs[0].bytes = ?hb[0]; helper_secs[0].len = 8; helper_secs[0].align = 8;
    var helper_syms: [1]of.Symbol;
    helper_syms[0].name = helper; helper_syms[0].section = 0; helper_syms[0].offset = 0;
    helper_syms[0].size = 8; helper_syms[0].flags = def_fn;
    var helper_img: of.ObjectImage = lt_image(?s, lt_name(?s, "helper"),
        ?helper_secs[0], 1, ?helper_syms[0], 1, nil::*of.Relocation, 0);

    var stub_secs: [1]of.Section;
    stub_secs[0].name = text; stub_secs[0].kind = of.SK_TEXT;
    stub_secs[0].bytes = ?sb[0]; stub_secs[0].len = 8; stub_secs[0].align = 8;
    var stub_syms: [1]of.Symbol;
    stub_syms[0].name = main_sym; stub_syms[0].section = 0; stub_syms[0].offset = 0;
    stub_syms[0].size = 8; stub_syms[0].flags = def_fn;
    var stub_img: of.ObjectImage = lt_image(?s, lt_name(?s, "main-stub"),
        ?stub_secs[0], 1, ?stub_syms[0], 1, nil::*of.Relocation, 0);

    var entry_tf: fs.TempFile;
    var crt_tf:   fs.TempFile;
    var helper_tf: fs.TempFile;
    var stub_tf:  fs.TempFile;
    var ar_tf:    fs.TempFile;
    var exe_tf:   fs.TempFile;
    var have_entry: bool = false;
    var have_crt:   bool = false;
    var have_helper: bool = false;
    var have_stub:  bool = false;
    var have_ar:    bool = false;
    var have_exe:   bool = false;

    val er0: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_2562_entry");
    if (R.is_err[fs.TempFile, str](er0)) { session.dnit(?s); ret 1; }
    entry_tf = R.unwrap_ok[fs.TempFile, str](er0); have_entry = true;
    val er1: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_2562_crt");
    if (R.is_err[fs.TempFile, str](er1)) { remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe); session.dnit(?s); ret 1; }
    crt_tf = R.unwrap_ok[fs.TempFile, str](er1); have_crt = true;
    val er2: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_2562_helper");
    if (R.is_err[fs.TempFile, str](er2)) { remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe); session.dnit(?s); ret 1; }
    helper_tf = R.unwrap_ok[fs.TempFile, str](er2); have_helper = true;
    val er3: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_2562_stub");
    if (R.is_err[fs.TempFile, str](er3)) { remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe); session.dnit(?s); ret 1; }
    stub_tf = R.unwrap_ok[fs.TempFile, str](er3); have_stub = true;
    val er4: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_2562_ar");
    if (R.is_err[fs.TempFile, str](er4)) { remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe); session.dnit(?s); ret 1; }
    ar_tf = R.unwrap_ok[fs.TempFile, str](er4); have_ar = true;
    val er5: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_2562_exe");
    if (R.is_err[fs.TempFile, str](er5)) { remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe); session.dnit(?s); ret 1; }
    exe_tf = R.unwrap_ok[fs.TempFile, str](er5); have_exe = true;

    val entry_path: str = fs.temp_path(?entry_tf);
    val crt_path:   str = fs.temp_path(?crt_tf);
    val helper_path: str = fs.temp_path(?helper_tf);
    val stub_path:  str = fs.temp_path(?stub_tf);
    val ar_path:    str = fs.temp_path(?ar_tf);
    val exe_path:   str = fs.temp_path(?exe_tf);

    if (O.is_some[str](fs.temp_close(?entry_tf))
        || O.is_some[str](fs.temp_close(?crt_tf))
        || O.is_some[str](fs.temp_close(?helper_tf))
        || O.is_some[str](fs.temp_close(?stub_tf))
        || O.is_some[str](fs.temp_close(?ar_tf))
        || O.is_some[str](fs.temp_close(?exe_tf))) {
        remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
        session.dnit(?s); ret 1;
    }

    var bad: i32 = 0;
    if (R.is_err[R.Void, str](t_planned_object(?tgt, ?entry_img, entry_path::*u8))) { bad = 1; }
    if (bad == 0 && R.is_err[R.Void, str](t_planned_object(?tgt, ?crt_img, crt_path::*u8))) { bad = 1; }
    if (bad == 0 && R.is_err[R.Void, str](t_planned_object(?tgt, ?helper_img, helper_path::*u8))) { bad = 1; }
    if (bad == 0 && R.is_err[R.Void, str](t_planned_object(?tgt, ?stub_img, stub_path::*u8))) { bad = 1; }

    var crt_vec:    Vector[u8];
    var helper_vec: Vector[u8];
    var stub_vec:   Vector[u8];
    var have_crt_v: bool = false;
    var have_hlp_v: bool = false;
    var have_stb_v: bool = false;
    if (bad == 0) {
        val rr: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, crt_path);
        if (R.is_err[Vector[u8], str](rr)) { bad = 1; }
        or { crt_vec = R.unwrap_ok[Vector[u8], str](rr); have_crt_v = true; }
    }
    if (bad == 0) {
        val rr: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, helper_path);
        if (R.is_err[Vector[u8], str](rr)) { bad = 1; }
        or { helper_vec = R.unwrap_ok[Vector[u8], str](rr); have_hlp_v = true; }
    }
    if (bad == 0) {
        val rr: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, stub_path);
        if (R.is_err[Vector[u8], str](rr)) { bad = 1; }
        or { stub_vec = R.unwrap_ok[Vector[u8], str](rr); have_stb_v = true; }
    }

    if (bad == 0) {
        var crt_names:    [1]str; crt_names[0]    = "mainCRTStartup";
        var helper_names: [1]str; helper_names[0] = "helper";
        var stub_names:   [1]str; stub_names[0]   = "main";
        var members: [3]ar.ArMember;
        members[0].name = "crt.o";    members[0].data = crt_vec.data;    members[0].len = crt_vec.len;    members[0].sym_names = ?crt_names[0];    members[0].sym_count = 1;
        members[1].name = "helper.o"; members[1].data = helper_vec.data; members[1].len = helper_vec.len; members[1].sym_names = ?helper_names[0]; members[1].sym_count = 1;
        members[2].name = "stub.o";   members[2].data = stub_vec.data;   members[2].len = stub_vec.len;   members[2].sym_names = ?stub_names[0];   members[2].sym_count = 1;
        val wr: R.Result[R.Void, str] = t_planned_archive(?alloc, ?members[0], 3, ar_path);
        if (R.is_err[R.Void, str](wr)) { bad = 1; }
    }

    if (bad == 0) {
        var fix_paths: [2]*u8;
        fix_paths[0] = entry_path::*u8;
        fix_paths[1] = ar_path::*u8;
        val lr: R.Result[R.Void, str] =
            t_planned_link(?s, ?tgt, ?fix_paths[0], 2, nil::*of.DynLib, 0, exe_path::*u8,
                 "test-entry-fix", LINK_EXE, false,
                 of.image_options_default(of.SUBSYSTEM_CONSOLE));
        if (R.is_err[R.Void, str](lr)) { bad = 1; }
    }

    if (bad == 0) {
        var bug_paths: [2]*u8;
        bug_paths[0] = ar_path::*u8;
        bug_paths[1] = entry_path::*u8;
        val lr: R.Result[R.Void, str] =
            t_planned_link(?s, ?tgt, ?bug_paths[0], 2, nil::*of.DynLib, 0, exe_path::*u8,
                 "test-entry-bug", LINK_EXE, false,
                 of.image_options_default(of.SUBSYSTEM_CONSOLE));
        if (R.is_ok[R.Void, str](lr)) { bad = 1; }
        or {
            val err: str = R.unwrap_err[R.Void, str](lr);
            if (!str_equals(err, "multiple definition of 'main'")) { bad = 1; }
        }
    }

    if (have_crt_v)  { vector.dnit[u8](?crt_vec); }
    if (have_hlp_v)  { vector.dnit[u8](?helper_vec); }
    if (have_stb_v)  { vector.dnit[u8](?stub_vec); }
    remove_2562(?entry_tf, ?crt_tf, ?helper_tf, ?stub_tf, ?ar_tf, ?exe_tf, have_entry, have_crt, have_helper, have_stub, have_ar, have_exe);
    session.dnit(?s);
    ret bad;
}

fun remove_2562(a: *fs.TempFile, b: *fs.TempFile, c: *fs.TempFile, d: *fs.TempFile,
                e: *fs.TempFile, f: *fs.TempFile,
                ha: bool, hb: bool, hc: bool, hd: bool, he: bool, hf: bool) {
    if (ha) { fs.temp_remove(a); }
    if (hb) { fs.temp_remove(b); }
    if (hc) { fs.temp_remove(c); }
    if (hd) { fs.temp_remove(d); }
    if (he) { fs.temp_remove(e); }
    if (hf) { fs.temp_remove(f); }
}

test "mach.lang.be.linker.archive_resolution:undefined_weak_does_not_extract" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val name: intern.StrId = lt_name(?s, "optional_hook");
    val undef: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;
    var weak_ref: of.Symbol;
    weak_ref.name = name; weak_ref.section = of.SECTION_EXTERNAL;
    weak_ref.offset = 0; weak_ref.size = 0;
    weak_ref.flags = undef | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    var provider: of.Symbol;
    provider.name = name; provider.section = 0; provider.offset = 0; provider.size = 0;
    provider.flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var weak_img: of.ObjectImage = lt_image(?s, lt_name(?s, "weak-user"),
        nil::*of.Section, 0, ?weak_ref, 1, nil::*of.Relocation, 0);
    var provider_img: of.ObjectImage = lt_image(?s, lt_name(?s, "provider"),
        nil::*of.Section, 0, ?provider, 1, nil::*of.Relocation, 0);

    var state: ArchiveResolution;
    init_archive_resolution(?alloc, ?state);
    if (R.is_err[R.Void, str](archive_note_image(?s, "", ?state, ?weak_img))) { ret 1; }
    val optional: R.Result[bool, str] = archive_image_needed(?s, "", ?state, ?provider_img);
    if (R.is_err[bool, str](optional) || R.unwrap_ok[bool, str](optional)
        || state.unresolved.len != 0) { ret 1; }

    weak_ref.flags = undef | of.SYM_OBJ_FLAG_FUNCTION;
    if (R.is_err[R.Void, str](archive_note_image(?s, "", ?state, ?weak_img))) { ret 1; }
    val required: R.Result[bool, str] = archive_image_needed(?s, "", ?state, ?provider_img);
    if (R.is_err[bool, str](required) || !R.unwrap_ok[bool, str](required)) { ret 1; }

    free_archive_resolution(?state);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.archive_resolution:weak_fallback_modes" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val public: intern.StrId = lt_name(?s, "weak_public");
    val fallback: intern.StrId = lt_name(?s, "weak_fallback");
    val ext: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;
    var syms: [2]of.Symbol;
    syms[0].name = public; syms[0].section = of.SECTION_EXTERNAL;
    syms[0].offset = 0; syms[0].size = 0; syms[0].fallback = 1;
    syms[1].name = fallback; syms[1].section = of.SECTION_EXTERNAL;
    syms[1].offset = 0; syms[1].size = 0; syms[1].flags = ext;
    syms[1].fallback = of.SYMBOL_NONE;
    var img: of.ObjectImage = lt_image(?s, lt_name(?s, "weak-user"),
        nil::*of.Section, 0, ?syms[0], 2, nil::*of.Relocation, 0);

    var modes: [3]u32;
    modes[0] = 0;
    modes[1] = of.SYM_OBJ_FLAG_SEARCH;
    modes[2] = of.SYM_OBJ_FLAG_ALIAS;
    var mi: u32 = 0;
    for (mi < 3) {
        syms[0].flags = ext | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FALLBACK
            | modes[mi];
        var state: ArchiveResolution;
        init_archive_resolution(?alloc, ?state);
        if (mi == 2 && R.is_err[R.Void, str](archive_require(?state, public))) { ret 1; }
        if (R.is_err[R.Void, str](archive_note_image(?s, "", ?state, ?img))) { ret 1; }
        if (!map.contains[intern.StrId, u32](?state.unresolved, ?fallback)) { ret 1; }
        val wants_public: bool =
            map.contains[intern.StrId, u32](?state.unresolved, ?public);
        val provides_public: bool =
            map.contains[intern.StrId, u32](?state.providers, ?public);
        if (wants_public != (mi == 1) || provides_public != (mi == 2)) { ret 1; }
        free_archive_resolution(?state);
        mi = mi + 1;
    }

    syms[0].fallback = 99;
    var malformed: ArchiveResolution;
    init_archive_resolution(?alloc, ?malformed);
    val mr: R.Result[R.Void, str] = archive_note_image(?s, "", ?malformed, ?img);
    free_archive_resolution(?malformed);
    session.dnit(?s);
    if (!R.is_err[R.Void, str](mr)) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.collect_symbols:weak_fallback_resolution" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val one: intern.StrId = lt_name(?s, "fallback_one");
    val two: intern.StrId = lt_name(?s, "fallback_two");
    val three: intern.StrId = lt_name(?s, "fallback_three");
    val ext: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;
    val relation: u32 = ext | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FALLBACK;

    var rel_syms: [2]of.Symbol;
    rel_syms[0].name = one; rel_syms[0].section = of.SECTION_EXTERNAL;
    rel_syms[0].offset = 0; rel_syms[0].size = 0;
    rel_syms[0].flags = relation; rel_syms[0].fallback = 1;
    rel_syms[1].name = two; rel_syms[1].section = of.SECTION_EXTERNAL;
    rel_syms[1].offset = 0; rel_syms[1].size = 0;
    rel_syms[1].flags = ext; rel_syms[1].fallback = of.SYMBOL_NONE;
    var real_one: of.Symbol;
    real_one.name = one; real_one.section = 0; real_one.offset = 0;
    real_one.size = 0; real_one.flags = of.SYM_OBJ_FLAG_GLOBAL;
    real_one.fallback = of.SYMBOL_NONE;
    var real_two: of.Symbol = real_one; real_two.name = two;

    var modules: [3]of.ObjectImage;
    modules[0] = lt_image(?s, lt_name(?s, "relation"), nil::*of.Section, 0,
        ?rel_syms[0], 2, nil::*of.Relocation, 0);
    modules[1] = lt_image(?s, lt_name(?s, "real-one"), nil::*of.Section, 1,
        ?real_one, 1, nil::*of.Relocation, 0);
    modules[2] = lt_image(?s, lt_name(?s, "real-two"), nil::*of.Section, 1,
        ?real_two, 1, nil::*of.Relocation, 0);
    var placements: [2]Placement;
    placements[0].vaddr = 0x1000; placements[0].offset = 0; placements[0].merged_index = 0;
    placements[1].vaddr = 0x2000; placements[1].offset = 0; placements[1].merged_index = 0;
    var sec_base: [3]u32; sec_base[0] = 0; sec_base[1] = 0; sec_base[2] = 1;
    var locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    val cr: R.Result[R.Void, str] = collect_symbols(?s, ?modules[0], 3,
        ?placements[0], ?sec_base[0], ?locs, true, nil::*AtomPlan);
    if (R.is_err[R.Void, str](cr)) { ret 1; }
    val rn: R.Result[intern.StrId, str] = resolved_symbol_name(?locs, one);
    val ol: R.Result[*SymbolLoc, str] = map.get[intern.StrId, SymbolLoc](?locs, ?one);
    if (R.is_err[intern.StrId, str](rn) || R.unwrap_ok[intern.StrId, str](rn) != one
        || R.is_err[*SymbolLoc, str](ol)
        || R.unwrap_ok[*SymbolLoc, str](ol).vaddr != 0x1000) { ret 1; }
    map.dnit[intern.StrId, SymbolLoc](?locs);

    var same_object: [2]of.ObjectImage;
    same_object[0] = modules[0]; same_object[1] = modules[2];
    var same_base: [2]u32; same_base[0] = 0; same_base[1] = 0;
    locs = map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    val sc: R.Result[R.Void, str] = collect_symbols(?s, ?same_object[0], 2,
        ?placements[1], ?same_base[0], ?locs, true, nil::*AtomPlan);
    val sn: R.Result[intern.StrId, str] = resolved_symbol_name(?locs, one);
    val tl: R.Result[*SymbolLoc, str] = map.get[intern.StrId, SymbolLoc](?locs, ?two);
    if (R.is_err[R.Void, str](sc) || R.is_err[intern.StrId, str](sn)
        || R.unwrap_ok[intern.StrId, str](sn) != two
        || R.is_err[*SymbolLoc, str](tl)
        || R.unwrap_ok[*SymbolLoc, str](tl).vaddr != 0x2000) { ret 1; }
    map.dnit[intern.StrId, SymbolLoc](?locs);

    var chain: [3]of.Symbol;
    chain[0] = rel_syms[0]; chain[0].fallback = 1;
    chain[1] = rel_syms[0]; chain[1].name = two; chain[1].fallback = 2;
    chain[2] = rel_syms[1]; chain[2].name = three;
    var chain_img: of.ObjectImage = lt_image(?s, lt_name(?s, "chain"),
        nil::*of.Section, 0, ?chain[0], 3, nil::*of.Relocation, 0);
    locs = map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    val cc: R.Result[R.Void, str] = collect_symbols(?s, ?chain_img, 1,
        nil::*Placement, nil::*u32, ?locs, false, nil::*AtomPlan);
    if (R.is_err[R.Void, str](cc)) { ret 1; }
    val cn: R.Result[intern.StrId, str] = resolved_symbol_name(?locs, one);
    if (R.is_err[intern.StrId, str](cn)
        || R.unwrap_ok[intern.StrId, str](cn) != three) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    val tr: R.Result[target.Target, str] =
        target.select(?reg, "x86_64", "linux", "sysv64");
    if (R.is_err[target.Target, str](tr)) { ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);
    var dyn: DynState; init_dynstate(?dyn);
    val dr: R.Result[R.Void, str] = build_dynamic_info(?s, ?tgt, ?dyn, ?chain_img, 1,
        ?locs, nil::*of.DynLib, 0, nil::*u32, nil::*AtomPlan);
    if (R.is_err[R.Void, str](dr) || dyn.info.import_count != 1
        || dyn.info.imports[0].symbol != three) { ret 1; }
    free_dynstate(?alloc, ?dyn);
    map.dnit[intern.StrId, SymbolLoc](?locs);

    var conflict: [4]of.Symbol;
    conflict[0] = rel_syms[0]; conflict[0].fallback = 1;
    conflict[1] = rel_syms[1];
    conflict[2] = rel_syms[0]; conflict[2].fallback = 1;
    conflict[3] = rel_syms[1]; conflict[3].name = three;
    var conflict_mods: [2]of.ObjectImage;
    conflict_mods[0] = lt_image(?s, lt_name(?s, "conflict-a"), nil::*of.Section, 0,
        ?conflict[0], 2, nil::*of.Relocation, 0);
    conflict_mods[1] = lt_image(?s, lt_name(?s, "conflict-b"), nil::*of.Section, 0,
        ?conflict[2], 2, nil::*of.Relocation, 0);
    locs = map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    val cf: R.Result[R.Void, str] = collect_symbols(?s, ?conflict_mods[0], 2,
        nil::*Placement, nil::*u32, ?locs, false, nil::*AtomPlan);
    map.dnit[intern.StrId, SymbolLoc](?locs);
    if (!R.is_err[R.Void, str](cf)) { ret 1; }

    chain[0].fallback = 1; chain[1].fallback = 0;
    chain_img.symbol_count = 2;
    locs = map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    val cy: R.Result[R.Void, str] = collect_symbols(?s, ?chain_img, 1,
        nil::*Placement, nil::*u32, ?locs, false, nil::*AtomPlan);
    map.dnit[intern.StrId, SymbolLoc](?locs);
    session.dnit(?s);
    if (!R.is_err[R.Void, str](cy)) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.carry_symbol:weak_fallback_remap" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val ext: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;
    var syms: [2]of.Symbol;
    syms[0].name = lt_name(?s, "carry-public");
    syms[0].section = of.SECTION_EXTERNAL; syms[0].offset = 0; syms[0].size = 0;
    syms[0].flags = ext | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FALLBACK;
    syms[0].fallback = 1;
    syms[1].name = lt_name(?s, "carry-fallback");
    syms[1].section = of.SECTION_EXTERNAL; syms[1].offset = 0; syms[1].size = 0;
    syms[1].flags = ext; syms[1].fallback = of.SYMBOL_NONE;
    var input: of.ObjectImage = lt_image(?s, lt_name(?s, "carry-input"),
        nil::*of.Section, 0, ?syms[0], 2, nil::*of.Relocation, 0);
    var out: of.ObjectImage = lt_image(?s, lt_name(?s, "carry-out"),
        nil::*of.Section, 0, nil::*of.Symbol, 0, nil::*of.Relocation, 0);
    var dummy: of.Symbol = syms[1]; dummy.name = lt_name(?s, "dummy");
    if (R.is_err[u32, str](obj.add_symbol(?out, dummy))) { ret 1; }
    var base: [1]u32; base[0] = 0;
    var remap: [2]u32; remap[0] = of.SYMBOL_NONE; remap[1] = of.SYMBOL_NONE;
    val cr: R.Result[u32, str] =
        carry_symbol(?out, ?input, 0, 0, ?base[0], ?remap[0]);
    if (R.is_err[u32, str](cr) || R.unwrap_ok[u32, str](cr) != 1
        || out.symbol_count != 3 || out.symbols[1].fallback != 2
        || out.symbols[2].name != syms[1].name) { ret 1; }
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.carry_relocations:remaps_both_difference_symbols" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    fin { session.dnit(?s); }

    var section: of.Section;
    section.name  = lt_name(?s, ".data");
    section.kind  = of.SK_BSS;
    section.bytes = nil;
    section.len   = 8;
    section.align = 4;
    section.flags = 0;

    var symbols: [2]of.Symbol;
    symbols[0].name = lt_name(?s, "lhs");
    symbols[1].name = lt_name(?s, "rhs");
    var i: u32 = 0;
    for (i < 2) {
        symbols[i].section  = of.SECTION_EXTERNAL;
        symbols[i].offset   = 0;
        symbols[i].size     = 0;
        symbols[i].flags    = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;
        symbols[i].fallback = of.SYMBOL_NONE;
        symbols[i].align    = 1;
        i = i + 1;
    }

    var relocation: of.Relocation;
    relocation.section = 0;
    relocation.offset  = 0;
    relocation.kind    = of.RK_DIFF32;
    relocation.sym     = 0;
    relocation.addend  = 0;
    relocation.sym2    = 1;
    var input: of.ObjectImage = lt_image(
        ?s, lt_name(?s, "difference-input"), ?section, 1,
        ?symbols[0], 2, ?relocation, 1);

    var out: of.ObjectImage = of.object_image_init(
        ?alloc, ?s.interner, lt_name(?s, "difference-output"));
    fin { obj.dnit(?out); }
    var output_section: of.Section = section;
    if (R.is_err[u32, str](obj.install_section(?out, ?output_section))) { ret 1; }

    var placement: Placement;
    placement.merged_index = 0;
    placement.offset = 0;
    placement.vaddr = 0;
    var sec_base: [1]u32;
    sec_base[0] = 0;
    var merged_to_out: [1]u32;
    merged_to_out[0] = 0;
    var sym_base: [1]u32;
    sym_base[0] = 0;
    var sym_out: [2]u32;
    sym_out[0] = of.SYMBOL_NONE;
    sym_out[1] = of.SYMBOL_NONE;

    val carried: R.Result[R.Void, str] = carry_relocations(
        ?out, ?input, 1, ?placement, ?sec_base[0], ?merged_to_out[0],
        ?sym_base[0], ?sym_out[0]);
    if (R.is_err[R.Void, str](carried)) { ret 1; }
    if (out.symbol_count != 2 || out.reloc_count != 1) { ret 1; }
    if (out.relocations[0].sym != 0 || out.relocations[0].sym2 != 1) { ret 1; }
    if (R.is_err[R.Void, str](of.validate_owned_object(?out))) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.read_objects:ordered_archive_end_to_end" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    val tr: R.Result[target.Target, str] =
        target.select(?reg, "x86_64", "windows", "win64");
    if (R.is_err[target.Target, str](tr)) { ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);

    val root: intern.StrId = lt_name(?s, "archive_entry");
    val dep: intern.StrId = lt_name(?s, "earlier_dependency");
    val late: intern.StrId = lt_name(?s, "late_requirement");
    val call: intern.StrId = lt_name(?s, "loose_call");
    val startup: intern.StrId = lt_name(?s, "WinMainCRTStartup");
    val text_name: intern.StrId = lt_name(?s, ".text");
    if (root == intern.STR_NIL || dep == intern.STR_NIL || late == intern.STR_NIL
        || call == intern.STR_NIL || startup == intern.STR_NIL
        || text_name == intern.STR_NIL) { ret 1; }

    var code: [1]u8; code[0] = 0xC3;
    var sec: of.Section;
    sec.name = text_name; sec.kind = of.SK_TEXT; sec.bytes = ?code[0];
    sec.len = 1; sec.align = 1;
    val def: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    val undef: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN
        | of.SYM_OBJ_FLAG_FUNCTION;

    var early_sym: of.Symbol;
    early_sym.name = dep; early_sym.section = 0; early_sym.offset = 0;
    early_sym.size = 1; early_sym.flags = def;
    var root_syms: [2]of.Symbol;
    root_syms[0].name = root; root_syms[0].section = 0; root_syms[0].offset = 0;
    root_syms[0].size = 1; root_syms[0].flags = def;
    root_syms[1].name = dep; root_syms[1].section = of.SECTION_EXTERNAL;
    root_syms[1].offset = 0; root_syms[1].size = 0; root_syms[1].flags = undef;
    var late_sym: of.Symbol;
    late_sym.name = late; late_sym.section = 0; late_sym.offset = 0;
    late_sym.size = 1; late_sym.flags = def;
    var startup_sym: of.Symbol;
    startup_sym.name = startup; startup_sym.section = 0; startup_sym.offset = 0;
    startup_sym.size = 1; startup_sym.flags = def;

    var images: [4]of.ObjectImage;
    images[0] = lt_image(?s, lt_name(?s, "early"), ?sec, 1,
                         ?early_sym, 1, nil::*of.Relocation, 0);
    images[1] = lt_image(?s, lt_name(?s, "root"), ?sec, 1,
                         ?root_syms[0], 2, nil::*of.Relocation, 0);
    images[2] = lt_image(?s, lt_name(?s, "late"), ?sec, 1,
                         ?late_sym, 1, nil::*of.Relocation, 0);
    images[3] = lt_image(?s, lt_name(?s, "startup"), ?sec, 1,
                         ?startup_sym, 1, nil::*of.Relocation, 0);

    var member_bytes: [4]Vector[u8];
    var mi: u32 = 0;
    for (mi < 4) {
        val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "archive_member");
        if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
        var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
        val er: R.Result[R.Void, str] = t_planned_object(?tgt, ?images[mi], fs.temp_path(?tf)::*u8);
        if (R.is_err[R.Void, str](er)) { fs.temp_close_and_remove(?tf); ret 1; }
        val br: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
        fs.temp_close_and_remove(?tf);
        if (R.is_err[Vector[u8], str](br)) { ret 1; }
        member_bytes[mi] = R.unwrap_ok[Vector[u8], str](br);
        mi = mi + 1;
    }
    var n0: [1]str; n0[0] = "earlier_dependency";
    var n1: [1]str; n1[0] = "archive_entry";
    var n2: [1]str; n2[0] = "late_requirement";
    var n3: [1]str; n3[0] = "WinMainCRTStartup";
    var members: [4]ar.ArMember;
    members[0].name = "early.o"; members[0].data = member_bytes[0].data;
    members[0].len = member_bytes[0].len; members[0].sym_names = ?n0[0]; members[0].sym_count = 1;
    members[1].name = "root.o"; members[1].data = member_bytes[1].data;
    members[1].len = member_bytes[1].len; members[1].sym_names = ?n1[0]; members[1].sym_count = 1;
    members[2].name = "late.o"; members[2].data = member_bytes[2].data;
    members[2].len = member_bytes[2].len; members[2].sym_names = ?n2[0]; members[2].sym_count = 1;
    members[3].name = "startup.o"; members[3].data = member_bytes[3].data;
    members[3].len = member_bytes[3].len; members[3].sym_names = ?n3[0]; members[3].sym_count = 1;

    val at_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "ordered_archive");
    if (R.is_err[fs.TempFile, str](at_r)) { ret 1; }
    var at: fs.TempFile = R.unwrap_ok[fs.TempFile, str](at_r);
    if (R.is_err[R.Void, str](t_planned_archive(?alloc, ?members[0], 4, fs.temp_path(?at)))) {
        fs.temp_close_and_remove(?at);
        ret 1;
    }

    var loose_syms: [2]of.Symbol;
    loose_syms[0].name = call; loose_syms[0].section = 0; loose_syms[0].offset = 0;
    loose_syms[0].size = 1; loose_syms[0].flags = def;
    loose_syms[1].name = late; loose_syms[1].section = of.SECTION_EXTERNAL;
    loose_syms[1].offset = 0; loose_syms[1].size = 0; loose_syms[1].flags = undef;
    var loose: of.ObjectImage = lt_image(?s, lt_name(?s, "loose"), ?sec, 1,
        ?loose_syms[0], 2, nil::*of.Relocation, 0);
    val lt_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "late_loose");
    if (R.is_err[fs.TempFile, str](lt_r)) { fs.temp_close_and_remove(?at); ret 1; }
    var lt: fs.TempFile = R.unwrap_ok[fs.TempFile, str](lt_r);
    if (R.is_err[R.Void, str](t_planned_object(?tgt, ?loose, fs.temp_path(?lt)::*u8))) {
        fs.temp_close_and_remove(?at); fs.temp_close_and_remove(?lt); ret 1;
    }

    var paths: [2]*u8;
    paths[0] = fs.temp_path(?at)::*u8;
    paths[1] = fs.temp_path(?lt)::*u8;
    var module_count: u32 = 0;
    val rr: R.Result[*of.ObjectImage, str] = read_objects(?s, ?tgt, ?paths[0], 2,
        nil::*of.ObjectImage, 0, root, ?module_count);
    fs.temp_close_and_remove(?at);
    fs.temp_close_and_remove(?lt);
    mi = 0;
    for (mi < 4) { vector.dnit[u8](?member_bytes[mi]); mi = mi + 1; }
    if (R.is_err[*of.ObjectImage, str](rr) || module_count != 3) { ret 1; }
    val modules: *of.ObjectImage = R.unwrap_ok[*of.ObjectImage, str](rr);

    var saw_root: bool = false;
    var saw_early: bool = false;
    var saw_late: bool = false;
    var saw_startup: bool = false;
    mi = 0;
    for (mi < module_count) {
        var si: u32 = 0;
        for (si < modules[mi].symbol_count) {
            val sym: *of.Symbol = ?modules[mi].symbols[si];
            if (sym.section != of.SECTION_EXTERNAL) {
                if (sym.name == root)    { saw_root = true; }
                if (sym.name == dep)     { saw_early = true; }
                if (sym.name == late)    { saw_late = true; }
                if (sym.name == startup) { saw_startup = true; }
            }
            si = si + 1;
        }
        mi = mi + 1;
    }
    free_modules(?alloc, modules, module_count);
    session.dnit(?s);
    if (!saw_root || !saw_early || saw_late || saw_startup) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.archive_resolution:import_address_alias" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    val public: intern.StrId = lt_name(?s, "Sleep");
    val indirect: intern.StrId = lt_name(?s, "__imp_Sleep");
    val dll: intern.StrId = lt_name(?s, "kernel32.dll");
    if (public == intern.STR_NIL || indirect == intern.STR_NIL
        || dll == intern.STR_NIL) { session.dnit(?s); ret 1; }

    var sym: of.Symbol;
    sym.name = indirect; sym.section = of.SECTION_EXTERNAL;
    sym.offset = 0; sym.size = 0;
    sym.flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_OBJECT;
    var seed: of.ObjectImage = lt_image(?s, lt_name(?s, "dll-user"),
        nil::*of.Section, 0, ?sym, 1, nil::*of.Relocation, 0);
    var decl: of.ImportDecl;
    decl.symbol = public; decl.import_name = public; decl.library = dll;
    decl.ordinal = 0; decl.by_name = true; decl.is_code = true;
    var record: of.ObjectImage = lt_image(?s, lt_name(?s, "import-record"),
        nil::*of.Section, 0, nil::*of.Symbol, 0, nil::*of.Relocation, 0);
    record.imports = ?decl; record.import_count = 1;

    var state: ArchiveResolution;
    init_archive_resolution(?alloc, ?state);
    if (R.is_err[R.Void, str](archive_note_image(?s, "__imp_", ?state, ?seed))) { ret 1; }
    val needed: R.Result[bool, str] = archive_image_needed(?s, "__imp_", ?state, ?record);
    if (R.is_err[bool, str](needed) || !R.unwrap_ok[bool, str](needed)) { ret 1; }
    if (R.is_err[R.Void, str](archive_note_image(?s, "__imp_", ?state, ?record))) { ret 1; }
    if (state.unresolved.len != 0
        || !map.contains[intern.StrId, u32](?state.providers, ?public)
        || !map.contains[intern.StrId, u32](?state.providers, ?indirect)) { ret 1; }

    free_archive_resolution(?state);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.dynlib_index_of:logical_and_loader_names" {
    var libs: [3]of.DynLib;
    libs[0].name = 41;
    libs[0].soname = 73;
    libs[0].rpath = intern.STR_NIL;
    libs[1].name = 42;
    libs[1].soname = 73;
    libs[1].rpath = intern.STR_NIL;
    libs[2].name = 43;
    libs[2].soname = 74;
    libs[2].rpath = intern.STR_NIL;

    val logical: O.Option[u32] =
        dynlib_index_of(?libs[0], 3, nil::*of.DynLib, 41);
    val alias: O.Option[u32] =
        dynlib_index_of(?libs[0], 3, nil::*of.DynLib, 42);
    val loader: O.Option[u32] =
        dynlib_index_of(?libs[0], 3, nil::*of.DynLib, 73);
    val other: O.Option[u32] =
        dynlib_index_of(?libs[0], 3, nil::*of.DynLib, 74);
    val missing: O.Option[u32] =
        dynlib_index_of(?libs[0], 3, nil::*of.DynLib, 99);
    if (!O.is_some[u32](logical) || O.unwrap[u32](logical) != 0) { ret 1; }
    if (!O.is_some[u32](alias) || O.unwrap[u32](alias) != 0)     { ret 1; }
    if (!O.is_some[u32](loader) || O.unwrap[u32](loader) != 0)   { ret 1; }
    if (!O.is_some[u32](other) || O.unwrap[u32](other) != 1)     { ret 1; }
    if (O.is_some[u32](missing) || unique_dynlib_count(?libs[0], 3) != 2) { ret 1; }
    if (!declared_attribution_matches(?libs[0], 3, nil::*of.DynLib, 41, 73)) { ret 1; }
    if (!declared_attribution_matches(?libs[0], 3, nil::*of.DynLib, 73, 73)) { ret 1; }
    if (declared_attribution_matches(?libs[0], 3, nil::*of.DynLib, 41, 74))  { ret 1; }

    var collision: [2]of.DynLib;
    collision[0].name = 41;
    collision[0].soname = 73;
    collision[0].rpath = intern.STR_NIL;
    collision[1].name = 73;
    collision[1].soname = 74;
    collision[1].rpath = intern.STR_NIL;
    var first: intern.StrId = intern.STR_NIL;
    var second: intern.StrId = intern.STR_NIL;
    var identity: intern.StrId = intern.STR_NIL;
    if (!dynlib_identity_collision(?collision[0], 2, nil::*of.DynLib,
                                   ?first, ?second, ?identity)) { ret 1; }
    if (first != 73 || second != 74 || identity != 73) { ret 1; }

    var reversed: [2]of.DynLib;
    reversed[0] = collision[1];
    reversed[1] = collision[0];
    if (!dynlib_identity_collision(?reversed[0], 2, nil::*of.DynLib,
                                   ?first, ?second, ?identity)) { ret 1; }
    if (identity != 73) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.unattributed_import_message:names_both_routes" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val sym: intern.StrId = lt_name(?s, "Sleep");
    var libs: [1]of.DynLib;
    libs[0].name = lt_name(?s, "kernel32");
    libs[0].soname = lt_name(?s, "kernel32.dll");
    libs[0].rpath = intern.STR_NIL;
    if (sym == intern.STR_NIL || libs[0].name == intern.STR_NIL
        || libs[0].soname == intern.STR_NIL) { ret 1; }

    val msg: str = unattributed_import_message(?s, sym, "", ?libs[0], 1);
    if (!str_contains(msg, "dynamic import 'Sleep'"))        { ret 1; }
    if (!str_contains(msg, "#[library(\"...\")]"))            { ret 1; }
    if (!str_contains(msg, "static archive member"))          { ret 1; }
    if (!str_contains(msg, "no declaration to annotate"))     { ret 1; }
    if (!str_contains(msg, "symbols = [\"Sleep\"]"))          { ret 1; }
    if (!str_contains(msg, "[link.<entry>]"))                 { ret 1; }
    if (!str_contains(msg, "candidate libraries: kernel32 (kernel32.dll)")) { ret 1; }

    val mach_o: intern.StrId = lt_name(?s, "_Sleep");
    if (mach_o == intern.STR_NIL) { ret 1; }
    val dmsg: str = unattributed_import_message(?s, mach_o, "_", ?libs[0], 1);
    if (!str_contains(dmsg, "dynamic import '_Sleep'"))       { ret 1; }
    if (!str_contains(dmsg, "symbols = [\"Sleep\"]"))         { ret 1; }
    if (str_contains(dmsg, "symbols = [\"_Sleep\"]"))         { ret 1; }

    val bare: str = unattributed_import_message(?s, sym, "_", ?libs[0], 1);
    if (!str_contains(bare, "symbols = [\"Sleep\"]"))         { ret 1; }

    val degraded: str =
        unattributed_import_message(?s, intern.STR_NIL, "", nil::*of.DynLib, 0);
    if (!str_contains(degraded, "#[library(\"...\")]"))        { ret 1; }
    if (!str_contains(degraded, "static archive member"))      { ret 1; }
    if (!str_contains(degraded, "symbols = [...]"))            { ret 1; }

    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.build_dynamic_info:linux_interpreter_matches_target" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }

    var locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    var names: [3]str;
    names[0] = "x86_64"; names[1] = "aarch64"; names[2] = "riscv64";
    var abis: [3]str;
    abis[0] = "sysv64"; abis[1] = "aapcs64"; abis[2] = "lp64d";
    var paths: [3]str;
    paths[0] = "/lib64/ld-linux-x86-64.so.2";
    paths[1] = "/lib/ld-linux-aarch64.so.1";
    paths[2] = "/lib/ld-linux-riscv64-lp64d.so.1";

    var i: usize = 0;
    for (i < 3) {
        val tr: R.Result[target.Target, str] =
            target.select(?reg, names[i], "linux", abis[i]);
        if (R.is_err[target.Target, str](tr)) { ret 1; }
        var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);
        var dyn: DynState;
        init_dynstate(?dyn);
        val built: R.Result[R.Void, str] = build_dynamic_info(
            ?s, ?tgt, ?dyn, nil::*of.ObjectImage, 0, ?locs,
            nil::*of.DynLib, 0, nil::*u32, nil::*AtomPlan);
        if (R.is_err[R.Void, str](built)) { ret 1; }
        val interp: O.Option[str] = intern.lookup(?s.interner, dyn.info.interp);
        if (O.is_none[str](interp) || !str_equals(O.unwrap[str](interp), paths[i])) {
            ret 1;
        }
        free_dynstate(?alloc, ?dyn);
        i = i + 1;
    }
    map.dnit[intern.StrId, SymbolLoc](?locs);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.build_dynamic_info:rejects_import_address_alias" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    val tr: R.Result[target.Target, str] =
        target.select(?reg, "x86_64", "windows", "win64");
    if (R.is_err[target.Target, str](tr)) { ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);

    val symbol: intern.StrId = lt_name(?s, "Sleep");
    val alias: intern.StrId = lt_name(?s, "__imp_Sleep");
    val library: intern.StrId = lt_name(?s, "kernel32.dll");
    if (symbol == intern.STR_NIL || alias == intern.STR_NIL
        || library == intern.STR_NIL) { ret 1; }

    var sym: of.Symbol;
    sym.name = symbol;
    sym.section = of.SECTION_EXTERNAL;
    sym.offset = 0;
    sym.size = 0;
    sym.flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN
              | of.SYM_OBJ_FLAG_FUNCTION;
    var decl: of.ImportDecl;
    decl.symbol = symbol;
    decl.import_name = alias;
    decl.library = library;
    decl.ordinal = 0;
    decl.by_name = true;
    decl.is_code = true;
    var rel: of.Relocation;
    rel.section = 0; rel.offset = 0; rel.sym = 0; rel.addend = 0; rel.sym2 = 0;
    var module: of.ObjectImage =
        lt_image(?s, lt_name(?s, "import-user"), nil::*of.Section, 0,
                 ?sym, 1, ?rel, 1);
    module.imports = ?decl;
    module.import_count = 1;

    var locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    var dyn: DynState;
    init_dynstate(?dyn);
    val built: R.Result[R.Void, str] =
        build_dynamic_info(?s, ?tgt, ?dyn, ?module, 1, ?locs,
                           nil::*of.DynLib, 0, nil::*u32, nil::*AtomPlan);

    var code: i32 = 0;
    if (R.is_ok[R.Void, str](built)) { code = 1; }
    or {
        val msg: str = R.unwrap_err[R.Void, str](built);
        if (dyn.info.import_count != 0)                    { code = 1; }
        if (!str_contains(msg, "'__imp_Sleep'"))           { code = 1; }
        if (!str_contains(msg, "import-address alias"))    { code = 1; }
        if (!str_contains(msg, "import 'Sleep' instead"))  { code = 1; }
    }

    val bare: intern.StrId = lt_name(?s, "__imp_");
    if (is_import_address_alias(?s, bare, "__imp_"))  { code = 1; }
    if (is_import_address_alias(?s, symbol, "__imp_")) { code = 1; }
    if (!is_import_address_alias(?s, alias, "__imp_")) { code = 1; }

    free_dynstate(?alloc, ?dyn);
    map.dnit[intern.StrId, SymbolLoc](?locs);
    session.dnit(?s);
    ret code;
}

test "mach.lang.be.linker.build_dynamic_info:declared_import_is_link_local" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    val tr: R.Result[target.Target, str] =
        target.select(?reg, "x86_64", "windows", "win64");
    if (R.is_err[target.Target, str](tr)) { ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);

    val symbol: intern.StrId = lt_name(?s, "PublicName");
    val export_name: intern.StrId = lt_name(?s, "ExportName");
    val library: intern.StrId = lt_name(?s, "demo.dll");
    if (symbol == intern.STR_NIL || export_name == intern.STR_NIL
        || library == intern.STR_NIL) { ret 1; }

    var sym: of.Symbol;
    sym.name = symbol;
    sym.section = of.SECTION_EXTERNAL;
    sym.offset = 0;
    sym.size = 0;
    sym.flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN
              | of.SYM_OBJ_FLAG_FUNCTION;
    var decl: of.ImportDecl;
    decl.symbol = symbol;
