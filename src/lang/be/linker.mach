    var sections: [2]of.Section;
    sections[0].name  = 1::intern.StrId;
    sections[0].kind  = of.SK_TEXT;
    sections[0].bytes = nil;
    sections[0].len   = 1;
    sections[0].align = 32;
    sections[0].flags = 0;
    sections[1].name  = 2::intern.StrId;
    sections[1].kind  = of.SK_TEXT;
    sections[1].bytes = nil;
    sections[1].len   = 0xFFFFFFF0;
    sections[1].align = 1;
    sections[1].flags = 0;

    var entry: of.Symbol;
    entry.name     = 77::intern.StrId;
    entry.section  = of.section_id(1);
    entry.offset   = 0;
    entry.size     = 1;
    entry.flags    = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    entry.fallback = of.SYMBOL_NONE;
    entry.align    = 1;

    var image: of.ObjectImage;
    image.sections      = ?sections[0];
    image.section_count = 2;
    image.symbols       = ?entry;
    image.symbol_count  = 1;

    var merged: [MERGED_KIND_COUNT]MergedSection;
    merged[of.SK_TEXT::u32].kind = of.SK_TEXT;
    merged[of.SK_TEXT::u32].len  = 0xFFFFFFF1;
    merged[of.SK_TEXT::u32].used = true;
    var placements: [2]Placement;
    placements[0].merged_index = of.SK_TEXT::u32;
    placements[1].merged_index = of.SK_TEXT::u32;
    var sec_base: [1]u32;
    sec_base[0] = 0;

    val r: err[fail.Fail] = reorder_flat_entry_first(
        ?image, 1, ?merged[0], ?placements[0], ?sec_base[0], nil::*AtomPlan, entry.name);
    if (sel r.ok) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.assign_section_vaddrs:checks_page_and_address_ranges" {
    var tgt: target.Target;
    tgt.base      = 0xFFFFFFFFFFFFFFF0;
    tgt.page_size = 16;

    var merged: [MERGED_KIND_COUNT]MergedSection;
    merged[of.SK_TEXT::u32].kind  = of.SK_TEXT;
    merged[of.SK_TEXT::u32].align = 16;
    merged[of.SK_TEXT::u32].len   = 32;
    merged[of.SK_TEXT::u32].used  = true;
    val assign_section_vaddrs_r: err[fail.Fail] = assign_section_vaddrs(?tgt, ?merged[0], 0);
    if (sel assign_section_vaddrs_r.ok) { ret 1; }

    tgt.base = 0x1000;
    tgt.page_size = 3;
    val assign_section_vaddrs_r2: err[fail.Fail] = assign_section_vaddrs(?tgt, ?merged[0], 0);
    if (sel assign_section_vaddrs_r2.ok) { ret 2; }

    tgt.page_size = 0x1000;
    val assign_section_vaddrs_r3: err[fail.Fail] = assign_section_vaddrs(?tgt, ?merged[0], 0);
    if (sel assign_section_vaddrs_r3.err) { ret 3; }
    if (merged[of.SK_TEXT::u32].vaddr != 0x1000) { ret 4; }
    ret 0;
}

