pub def LinkMode: u8;

pub val LINK_EXE:         LinkMode = 0;
pub val LINK_RELOCATABLE: LinkMode = 1;
pub val LINK_SHARED:      LinkMode = 2;

fun link_mode_valid(mode: LinkMode) bool {
    ret mode == LINK_EXE || mode == LINK_RELOCATABLE || mode == LINK_SHARED;
}

val MERGED_KIND_COUNT: u32 = of.SK_COUNT;

