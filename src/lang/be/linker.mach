    g.cap   = 0xFFFFFFFF;

    val res: R.Result[u32, str] = section_group_add(?alloc, ?g, 0, 0::intern.StrId, 0);
    if (!R.is_err[u32, str](res)) { g.items = nil; g.count = 0; g.cap = 0; ret 1; }
    if (g.count != 0xFFFFFFFF)    { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.build_symtab_entries:trustworthy_size_wins_over_a_synthetic_gap" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var sec: of.Section;
    sec.name  = 1::intern.StrId;
    sec.kind  = of.SK_TEXT;
    sec.bytes = nil;
    sec.len   = 30;
    sec.align = 1;

    var syms: [2]of.Symbol;
    syms[0].name    = 10::intern.StrId;
    syms[0].section = 0;
    syms[0].offset  = 0;
    syms[0].size    = 10;
    syms[0].flags   = of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = 11::intern.StrId;
    syms[1].section = 0;
    syms[1].offset  = 20;
    syms[1].size    = 0;
    syms[1].flags   = of.SYM_OBJ_FLAG_FUNCTION | of.SYM_OBJ_FLAG_SIZE_UNKNOWN;

    var image: of.ObjectImage;
    image.sections      = ?sec;
    image.section_count = 1;
    image.symbols       = ?syms[0];
    image.symbol_count  = 2;

    var seg: of.LoadSegment;
    seg.vaddr  = 0x1000;
    seg.filesz = 30;
    var segs: [1]of.LoadSegment;
    segs[0] = seg;

    var count: u32 = 0;
    val er: R.Result[*of.SymtabEntry, str] = build_symtab_entries(?alloc, ?image, ?segs[0], 1, ?count);
    if (R.is_err[*of.SymtabEntry, str](er)) { ret 1; }
    val entries: *of.SymtabEntry = R.unwrap_ok[*of.SymtabEntry, str](er);

    if (count != 2) { ret 1; }
    var bad: i32 = 0;
    if (entries[0].vaddr != 0x1000 || entries[0].size != 10)  { bad = 1; }
    if (entries[1].vaddr != 0x1014 || entries[1].size != 10)  { bad = 1; }

    if (count > 0) { A.deallocate[of.SymtabEntry](?alloc, entries, count::usize); }
    ret bad;
}

