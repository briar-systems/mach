use mach.lang.fail;
use mach.lang.publication;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use std.allocator.page;
use std.memory;

use A: std.allocator;

use mach.lang.be.codegen.debug_input;
use mach.lang.intern;
use mach.lang.layout;
use mach.lang.target;
use mach.lang.target.of;
use rel:            mach.lang.target.of.reloc;
use target_testing: mach.lang.target.testing;

pub fun image_init(a: *A.Allocator, interner: *intern.Interner, name: intern.StrId) res[of.ObjectImage, fail.Fail] {
    ret res[of.ObjectImage, fail.Fail].ok{of.object_image_init(a, interner, name)};
}

pub fun dnit(o: *of.ObjectImage) {
    of.object_image_dnit(o);
}

pub fun section_install(o: *of.ObjectImage, s: *of.Section) res[u32, fail.Fail] {
    if (o == nil || o.alloc == nil || s == nil) {
        ret res[u32, fail.Fail].err{fail.message("obj: cannot install a section without complete ownership")};
    }
    if (s.bytes != nil && s.len == 0) {
        ret res[u32, fail.Fail].err{fail.message("obj: section byte allocation has no release extent")};
    }
    val section: of.Section = @s;
    s.bytes = nil;
    s.len   = 0;

    val res_grow: err[fail.Fail] = array_reserve_one[of.Section](
        o.alloc, ?o.sections, o.section_count, ?o.section_cap);
    if (sel res_grow.err) {
        if (section.bytes != nil && section.len > 0) {
            A.deallocate[u8](o.alloc, section.bytes, section.len::usize);
        }
        ret res[u32, fail.Fail].err{res_grow.err};
    }

    val ix: u32 = o.section_count;
    o.sections[ix]  = section;
    o.section_count = o.section_count + 1;
    ret res[u32, fail.Fail].ok{ix};
}

pub fun symbol_add(o: *of.ObjectImage, sym: of.Symbol) res[u32, fail.Fail] {
    val res_grow: err[fail.Fail] = array_reserve_one[of.Symbol](
        o.alloc, ?o.symbols, o.symbol_count, ?o.symbol_cap);
    if (sel res_grow.err) {
        ret res[u32, fail.Fail].err{res_grow.err};
    }

    val ix: u32 = o.symbol_count;
    o.symbols[ix]  = sym;
    o.symbol_count = o.symbol_count + 1;
    ret res[u32, fail.Fail].ok{ix};
}

pub fun add_frame(o: *of.ObjectImage, fr: *of.FrameUnwind) err[fail.Fail] {
    val res_grow: err[fail.Fail] = array_reserve_one[of.FrameUnwind](
        o.alloc, ?o.frames, o.frame_count, ?o.frame_cap);
    if (sel res_grow.err) {
        ret res_grow;
    }

    o.frames[o.frame_count] = @fr;
    o.frame_count           = o.frame_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun add_relocation(o: *of.ObjectImage, rel: of.Relocation) err[fail.Fail] {
    val res_grow: err[fail.Fail] = array_reserve_one[of.Relocation](
        o.alloc, ?o.relocations, o.reloc_count, ?o.reloc_cap);
    if (sel res_grow.err) {
        ret res_grow;
    }

    o.relocations[o.reloc_count] = rel;
    o.reloc_count                = o.reloc_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun symbol_index(o: *of.ObjectImage, name: intern.StrId) u32 {
    if (name == intern.STR_NIL) { ret of.SYMBOL_NONE; }
    var i: u32 = 0;
    for (i < o.symbol_count) {
        if (o.symbols[i].name == name) { ret i; }
        i = i + 1;
    }
    ret of.SYMBOL_NONE;
}

pub rec DeferredReloc {
    section:      of.SectionId;
    offset:       u32;
    kind:         of.RelocKind;
    name:         intern.StrId;
    addend:       i64;
    extern_flags: u32;
    pair:         u32;
}

pub rec DeferredRelocs {
    alloc: *A.Allocator;
    items: *DeferredReloc;
    count: u32;
    cap:   u32;
}

pub fun deferred_init(a: *A.Allocator) DeferredRelocs {
    var d: DeferredRelocs;
    d.alloc = a;
    d.items = nil;
    d.count = 0;
    d.cap   = 0;
    ret d;
}

pub fun deferred_dnit(d: *DeferredRelocs) {
    if (d.items != nil && d.cap > 0) {
        A.deallocate[DeferredReloc](d.alloc, d.items, d.cap::usize);
    }
    d.items = nil;
    d.count = 0;
    d.cap   = 0;
}

pub fun defer_relocation(d: *DeferredRelocs, rec: DeferredReloc) err[fail.Fail] {
    if (d.count == d.cap) {
        var next: u32 = 8;
        if (d.cap > 0) {
            val doubled: res[layout.CheckedCount[DeferredReloc], layout.CheckCause] =
                layout.count_mul[DeferredReloc](layout.count[DeferredReloc](d.cap::usize), 2::usize);
            if (sel doubled.err) {
                ret err[fail.Fail].err{fail.message("obj: deferred relocation queue growth count overflow")};
            }
            val fits: res[u32, layout.CheckCause] = layout.usize_to_u32(doubled.ok.value);
            if (sel fits.err) {
                ret err[fail.Fail].err{fail.message("obj: deferred relocation queue capacity exceeds the u32 limit")};
            }
            next = fits.ok;
        }
        var grown: *DeferredReloc = nil;
        if (d.items == nil) {
            val ar: res[*DeferredReloc, A.Error] = A.allocate[DeferredReloc](d.alloc, next::usize);
            if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
            grown = ar.ok;
        }
        or {
            val rr: res[*DeferredReloc, A.Error] =
                A.reallocate[DeferredReloc](d.alloc, d.items, d.cap::usize, next::usize);
            if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
            grown = rr.ok;
        }
        d.items = grown;
        d.cap   = next;
    }
    d.items[d.count] = rec;
    d.count          = d.count + 1;
    ret err[fail.Fail].ok{};
}

pub fun defer_relocation_for_target(d: *DeferredRelocs, rec: DeferredReloc,
    tgt: *target.Target, section_kind: of.SectionKind,
    codegen_image: bool) err[fail.Fail] {
    if (tgt == nil || tgt.isa == nil || tgt.isa.reloc == nil
        || tgt.isa.reloc.traits == nil) {
        ret err[fail.Fail].err{fail.message("codegen: target cannot describe relocations")};
    }
    val tr: res[rel.RelocTraits, rel.RelocError] =
        tgt.isa.reloc.traits(rec.kind, section_kind, codegen_image);
    if (sel tr.err) {
        ret err[fail.Fail].err{fail.message("codegen: relocation kind is not supported by the selected target")};
    }
    ret defer_relocation(d, rec);
}

fun flush_deferred_consume(d: *DeferredRelocs, flushed: u32) {
    if (flushed == 0) { ret; }
    var i: u32 = flushed;
    for (i < d.count) {
        d.items[i - flushed] = d.items[i];
        i                    = i + 1;
    }
    d.count = d.count - flushed;
}

pub fun flush_deferred(o: *of.ObjectImage, d: *DeferredRelocs) err[fail.Fail] {
    val image_base: u32 = o.reloc_count;
    var i:          u32 = 0;
    for (i < d.count) {
        val pend: *DeferredReloc = ?d.items[i];
        if (pend.name == intern.STR_NIL) {
            flush_deferred_consume(d, i);
            ret err[fail.Fail].err{fail.message("codegen: relocation has no target symbol")};
        }

        var sym_ix: u32 = symbol_index(o, pend.name);
        if (sym_ix == of.SYMBOL_NONE) {
            var ext: of.Symbol;
            ext.name     = pend.name;
            ext.section  = of.external_section();
            ext.offset   = 0;
            ext.size     = 0;
            ext.flags    = pend.extern_flags;
            ext.fallback = of.SYMBOL_NONE;
            ext.align    = 1;
            val sa: res[u32, fail.Fail] = symbol_add(o, ext);
            if (sel sa.err) {
                flush_deferred_consume(d, i);
                ret err[fail.Fail].err{sa.err};
            }
            sym_ix = sa.ok;
        }

        var rel: of.Relocation;
        rel.section = pend.section;
        rel.offset  = pend.offset;
        rel.kind    = pend.kind;
        rel.sym     = sym_ix;
        rel.addend  = pend.addend;
        rel.sym2    = of.SYMBOL_NONE;
        rel.pair    = 0;
        if (pend.pair != 0) {
            if (pend.pair > d.count) {
                flush_deferred_consume(d, i);
                ret err[fail.Fail].err{fail.message("codegen: relocation pair index is outside the deferred batch")};
            }
            rel.pair = image_base + pend.pair;
        }
        val ar: err[fail.Fail] = add_relocation(o, rel);
        if (sel ar.err) {
            flush_deferred_consume(d, i);
            ret ar;
        }

        i = i + 1;
    }
    d.count = 0;
    ret err[fail.Fail].ok{};
}

fun remap_name(id: intern.StrId, remap: intern.ReinternMap) intern.StrId {
    if (id == intern.STR_NIL)       { ret id; }
    if (id::usize < remap.base_len) { ret id; }
    ret remap.ids[id::usize - remap.base_len];
}

fun remap_name_valid(src: *intern.Interner, dst: *intern.Interner, id: intern.StrId,
    remap: intern.ReinternMap) bool {
    if (id == intern.STR_NIL) { ret true; }
    val source_name: opt[str] = intern.lookup(src, id);
    if (sel source_name.none) { ret false; }

    var mapped: intern.StrId = id;
    if (id::usize >= remap.base_len) {
        val local: usize = id::usize - remap.base_len;
        if (remap.ids == nil || local >= remap.len) { ret false; }
        mapped = remap.ids[local];
        if (mapped == intern.STR_NIL) { ret false; }
    }
    val destination_name: opt[str] = intern.lookup(dst, mapped);
    ret sel destination_name.some
        && str_equals(source_name.some, destination_name.some);
}

fun rehome_names_valid(src: *of.ObjectImage, dst_interner: *intern.Interner,
    remap: intern.ReinternMap) bool {
    if ((remap.ids == nil) != (remap.len == 0)) { ret false; }
    if (!remap_name_valid(src.interner, dst_interner, src.name, remap)) {
        ret false;
    }

    var i: u32 = 0;
    for (i < src.section_count) {
        if (!remap_name_valid(src.interner, dst_interner, src.sections[i].name,
            remap)) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < src.symbol_count) {
        if (!remap_name_valid(src.interner, dst_interner, src.symbols[i].name,
            remap)) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < src.import_count) {
        val imp: *of.ImportDecl = ?src.imports[i];
        if (!remap_name_valid(src.interner, dst_interner, imp.symbol,
            remap)
            || !remap_name_valid(src.interner, dst_interner, imp.import_name,
            remap)
            || !remap_name_valid(src.interner, dst_interner, imp.library,
            remap)) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun rehome(dst_alloc: *A.Allocator, dst_interner: *intern.Interner,
    src: *of.ObjectImage, remap: intern.ReinternMap) res[of.ObjectImage, fail.Fail] {
    if (dst_alloc == nil || dst_interner == nil) {
        ret res[of.ObjectImage, fail.Fail].err{fail.message("obj.rehome_remap: destination ownership is incomplete")};
    }
    val source_valid: err[fail.Fail] = of.validate_object_view(src);
    if (sel source_valid.err) {
        ret res[of.ObjectImage, fail.Fail].err{source_valid.err};
    }
    if (!rehome_names_valid(src, dst_interner, remap)) {
        ret res[of.ObjectImage, fail.Fail].err{fail.message("obj.rehome_remap: intern remap does not cover the source image")};
    }
    val res_img: res[of.ObjectImage, fail.Fail] = image_init(dst_alloc, dst_interner, remap_name(src.name, remap));
    if (sel res_img.err) { ret res_img; }
    var img: of.ObjectImage = res_img.ok;
    img.machine_flags  = src.machine_flags;
    img.attributes     = nil;
    img.attributes_len = 0;
    if (src.attributes != nil && src.attributes_len > 0) {
        val ab: res[*u8, A.Error] = A.allocate[u8](dst_alloc, src.attributes_len::usize);
        if (sel ab.err) { ret res[of.ObjectImage, fail.Fail].err{fail.refused(ab.err)}; }
        val abuf: *u8 = ab.ok;
        memory.raw_copy(abuf::ptr, src.attributes::ptr, src.attributes_len::usize);
        img.attributes     = abuf;
        img.attributes_len = src.attributes_len;
    }

    if (src.section_count > 0) {
        val rs: res[*of.Section, A.Error] = A.allocate[of.Section](dst_alloc, src.section_count::usize);
        if (sel rs.err) {
            dnit(?img);
            ret res[of.ObjectImage, fail.Fail].err{fail.refused(rs.err)};
        }
        img.sections    = rs.ok;
        img.section_cap = src.section_count;
        var i: u32 = 0;
        for (i < src.section_count) {
            var sec: of.Section = src.sections[i];
            sec.name = remap_name(src.sections[i].name, remap);
            if (src.sections[i].bytes != nil && src.sections[i].len > 0) {
                val rb: res[*u8, A.Error] = A.allocate[u8](dst_alloc, src.sections[i].len::usize);
                if (sel rb.err) {
                    img.section_count = i;
                    dnit(?img);
                    ret res[of.ObjectImage, fail.Fail].err{fail.refused(rb.err)};
                }
                sec.bytes = rb.ok;
                memory.copy[u8](sec.bytes, src.sections[i].bytes, src.sections[i].len::usize);
            }
            img.sections[i]   = sec;
            img.section_count = i + 1;
            i                 = i + 1;
        }
    }

    if (src.symbol_count > 0) {
        val ry: res[*of.Symbol, A.Error] = A.allocate[of.Symbol](dst_alloc, src.symbol_count::usize);
        if (sel ry.err) {
            dnit(?img);
            ret res[of.ObjectImage, fail.Fail].err{fail.refused(ry.err)};
        }
        img.symbols    = ry.ok;
        img.symbol_cap = src.symbol_count;
        var i: u32 = 0;
        for (i < src.symbol_count) {
            var sym: of.Symbol = src.symbols[i];
            sym.name       = remap_name(src.symbols[i].name, remap);
            img.symbols[i] = sym;
            i              = i + 1;
        }
        img.symbol_count = src.symbol_count;
    }

    if (src.reloc_count > 0) {
        val rr: res[*of.Relocation, A.Error] = A.allocate[of.Relocation](dst_alloc, src.reloc_count::usize);
        if (sel rr.err) {
            dnit(?img);
            ret res[of.ObjectImage, fail.Fail].err{fail.refused(rr.err)};
        }
        img.relocations = rr.ok;
        img.reloc_cap   = src.reloc_count;
        memory.copy[of.Relocation](img.relocations, src.relocations, src.reloc_count::usize);
        img.reloc_count = src.reloc_count;
    }

    if (src.frame_count > 0) {
        val rf: res[*of.FrameUnwind, A.Error] = A.allocate[of.FrameUnwind](dst_alloc, src.frame_count::usize);
        if (sel rf.err) {
            dnit(?img);
            ret res[of.ObjectImage, fail.Fail].err{fail.refused(rf.err)};
        }
        img.frames    = rf.ok;
        img.frame_cap = src.frame_count;
        memory.copy[of.FrameUnwind](img.frames, src.frames, src.frame_count::usize);
        img.frame_count = src.frame_count;
    }

    if (src.indirect_count > 0) {
        val copied: res[*of.NativeIndirect, A.Error] = A.allocate[of.NativeIndirect](dst_alloc, src.indirect_count::usize);
        if (sel copied.err) {
            dnit(?img);
            ret res[of.ObjectImage, fail.Fail].err{fail.refused(copied.err)};
        }
        img.indirects      = copied.ok;
        img.indirect_cap   = src.indirect_count;
        img.indirect_count = src.indirect_count;
        memory.copy[of.NativeIndirect](img.indirects, src.indirects, src.indirect_count::usize);
    }

    if (src.import_count > 0) {
        val ri: res[*of.ImportDecl, A.Error] = A.allocate[of.ImportDecl](dst_alloc, src.import_count::usize);
        if (sel ri.err) {
            dnit(?img);
            ret res[of.ObjectImage, fail.Fail].err{fail.refused(ri.err)};
        }
        img.imports    = ri.ok;
        img.import_cap = src.import_count;
        var i: u32 = 0;
        for (i < src.import_count) {
            var imp: of.ImportDecl = src.imports[i];
            imp.symbol      = remap_name(src.imports[i].symbol, remap);
            imp.import_name = remap_name(src.imports[i].import_name, remap);
            imp.library     = remap_name(src.imports[i].library, remap);
            img.imports[i]  = imp;
            i               = i + 1;
        }
        img.import_count = src.import_count;
    }

    val image_valid: err[fail.Fail] = of.validate_owned_object(?img);
    if (sel image_valid.err) {
        val reason: str = fail.describe(image_valid.err);
        dnit(?img);
        ret res[of.ObjectImage, fail.Fail].err{fail.message(reason)};
    }
    ret res[of.ObjectImage, fail.Fail].ok{img};
}

pub fun emit_image(o: *of.ObjectImage, tgt: *target.Target, destination: *publication.Destination) err[fail.Fail] {
    if (tgt == nil)                { ret err[fail.Fail].err{fail.message("emit: nil target")}; }
    if (tgt.of == nil)             { ret err[fail.Fail].err{fail.message("emit: target has no object-format vtable")}; }
    if (tgt.of.emit_object == nil) { ret err[fail.Fail].err{fail.message("emit: object format has no writer")}; }
    val image_valid: err[fail.Fail] = of.validate_object_view(o);
    if (sel image_valid.err) { ret image_valid; }
    ret tgt.of.emit_object(?tgt.object, o, destination);
}

fun array_reserve_one[T](a: *A.Allocator, arr: **T, len: u32, cap: *u32) err[fail.Fail] {
    if (a == nil || arr == nil || cap == nil) {
        ret err[fail.Fail].err{fail.message("obj: array growth requires initialized ownership")};
    }
    if (len > @cap || ((@arr == nil) != (@cap == 0))) {
        ret err[fail.Fail].err{fail.message("obj: array count, capacity, and storage are inconsistent")};
    }
    if (len < @cap) { ret err[fail.Fail].ok{}; }

    var grown: usize = 8;
    if (@cap > 0) {
        val next: res[layout.CheckedCount[T], layout.CheckCause] =
            layout.count_mul[T](layout.count[T]((@cap)::usize), 2::usize);
        if (sel next.err) {
            ret err[fail.Fail].err{fail.message("obj: array growth count overflow")};
        }
        grown = next.ok.value;
    }
    val fits: res[u32, layout.CheckCause] = layout.usize_to_u32(grown);
    if (sel fits.err) {
        ret err[fail.Fail].err{fail.message("obj: array capacity exceeds the u32 limit")};
    }
    var storage: *T = nil;
    if (@cap == 0) {
        val allocated: res[*T, A.Error] = A.allocate[T](a, grown);
        if (sel allocated.err) {
            ret err[fail.Fail].err{fail.refused(allocated.err)};
        }
        storage = allocated.ok;
    }
    or {
        val reallocated: res[*T, A.Error] = A.reallocate[T](a, @arr, (@cap)::usize, grown);
        if (sel reallocated.err) {
            ret err[fail.Fail].err{fail.refused(reallocated.err)};
        }
        storage = reallocated.ok;
    }
    @arr = storage;
    @cap = fits.ok;
    ret err[fail.Fail].ok{};
}

fun t_obj_intern(itn: *intern.Interner, s: str) intern.StrId {
    val r: res[intern.StrId, A.Error] = intern.intern(itn, s);
    if (sel r.err) { ret intern.STR_NIL; }
    ret r.ok;
}

fun t_debug_produce(req: *of.DebugProduceRequest) err[fail.Fail] {
    val img: *of.ObjectImage   = req.image;
    val br:  res[*u8, A.Error] = A.allocate[u8](img.alloc, 4::usize);
    if (sel br.err) { ret err[fail.Fail].err{fail.refused(br.err)}; }

    var sec: of.Section;
    sec.name  = t_obj_intern(img.interner, ".debug_info");
    sec.kind  = of.SK_DEBUG;
    sec.bytes = br.ok;
    sec.len   = 4;
    sec.align = 1;
    sec.flags = 0;
    val sr: res[u32, fail.Fail] = section_install(img, ?sec);
    if (sel sr.err) {
        ret err[fail.Fail].err{sr.err};
    }
    val sec_idx: u32 = sr.ok;

    var sym: of.Symbol;
    sym.name     = t_obj_intern(img.interner, ".Ldebug_info0");
    sym.section  = of.section_id(sec_idx);
    sym.offset   = 0;
    sym.size     = 0;
    sym.flags    = 0;
    sym.fallback = of.SYMBOL_NONE;
    sym.align    = 1;
    val yr: res[u32, fail.Fail] = symbol_add(img, sym);
    if (sel yr.err) { ret err[fail.Fail].err{yr.err}; }

    var rel: of.Relocation;
    rel.section = of.section_id(sec_idx);
    rel.offset  = 0;
    rel.kind    = of.RK_ABS32;
    rel.sym     = yr.ok;
    rel.addend  = 0;
    rel.sym2    = of.SYMBOL_NONE;
    val added: err[fail.Fail] = add_relocation(img, rel);
    if (sel added.err) { ret added; }
    ret err[fail.Fail].ok{};
}

fun t_debug_supports(tgt: *debug_input.DebugTarget) bool {
    ret tgt != nil;
}

test "mach.lang.be.obj.debug_seam:producer_writes_into_image" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    val ir: res[of.ObjectImage, fail.Fail] = image_init(?alloc, ?itn, t_obj_intern(?itn, "m"));
    if (sel ir.err) { ret 1; }
    var img: of.ObjectImage = ir.ok;

    var reg: of.DebugRegistry = of.debug_registry_init();
    fin { of.debug_registry_dnit(?reg); }
    var vt: of.DebugVTable;
    vt.id       = of.DBG_DWARF;
    vt.name     = "dwarf";
    vt.produce  = t_debug_produce;
    vt.supports = t_debug_supports;
    of.debug_register(?reg, ?vt);

    val got: opt[*of.DebugVTable] = of.debug_lookup(?reg, "dwarf");
    if (!sel got.some) {
        dnit(?img);
        ret 1;
    }

    var req: of.DebugProduceRequest;
    req.image = ?img;
    val pr: err[fail.Fail] = got.some.produce(?req);
    if (sel pr.err) {
        dnit(?img);
        ret 1;
    }

    if (img.section_count != 1) {
        dnit(?img);
        ret 1;
    }
    if (img.sections[0].kind != of.SK_DEBUG) {
        dnit(?img);
        ret 1;
    }
    if (img.symbol_count != 1) {
        dnit(?img);
        ret 1;
    }
    if (of.section_index(img.symbols[0].section) != 0) {
        dnit(?img);
        ret 1;
    }
    if (img.reloc_count != 1) {
        dnit(?img);
        ret 1;
    }
    if (img.relocations[0].kind != of.RK_ABS32) {
        dnit(?img);
        ret 1;
    }

    dnit(?img);
    ret 0;
}

rec ObjProbe {
    backing:  A.Allocator;
    live:     i64;
    calls:    u32;
    fail_at:  u32;
    ptrs:     [32]ptr;
    sizes:    [32]usize;
    mismatch: bool;
}

fun obj_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *ObjProbe = ctx::*ObjProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (sel r.none) { ret r; }
    val item: ptr = r.some;
    memory.raw_fill(item, 0xAA, size);
    var i: usize = 0;
    for (i < 32 && p.ptrs[i] != nil) { i = i + 1; }
    if (i == 32) { p.mismatch = true; }
    or {
        p.ptrs[i]  = item;
        p.sizes[i] = size;
    }
    p.live = p.live + size::i64;
    ret r;
}

fun obj_probe_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val p: *ObjProbe = ctx::*ObjProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (sel r.none) { ret r; }
    val np: ptr   = r.some;
    var i:  usize = 0;
    for (i < 32 && p.ptrs[i] != item) { i = i + 1; }
    if (i == 32) { p.mismatch = true; }
    or {
        p.ptrs[i]  = np;
        p.sizes[i] = new_size;
    }
    p.live = p.live - old_size::i64 + new_size::i64;
    if (new_size > old_size) { memory.raw_fill((np::usize + old_size)::ptr, 0xAA, new_size - old_size); }
    ret r;
}

fun obj_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *ObjProbe = ctx::*ObjProbe;
    var i: usize     = 0;
    for (i < 32 && p.ptrs[i] != item) { i = i + 1; }
    if (i == 32) {
        p.mismatch = true;
        ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
    }
    if (p.sizes[i] != size) { p.mismatch = true; }
    p.live     = p.live - p.sizes[i]::i64;
    p.ptrs[i]  = nil;
    p.sizes[i] = 0;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun obj_probe_make(p: *ObjProbe, fail_at: u32) bool {
    val make_r: err[A.Error] = page.make(?p.backing);
    if (sel make_r.err) { ret false; }
    p.live     = 0;
    p.calls    = 0;
    p.fail_at  = fail_at;
    p.mismatch = false;
    var i: usize = 0;
    for (i < 32) {
        p.ptrs[i]  = nil;
        p.sizes[i] = 0;
        i          = i + 1;
    }
    ret true;
}

test "mach.lang.be.obj.dnit:frees_attributes" {
    var probe: ObjProbe;
    if (!obj_probe_make(?probe, 0)) { ret 1; }
    var pp:    *ObjProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = obj_probe_allocate;
    alloc.fn_reallocate = obj_probe_reallocate;
    alloc.fn_deallocate = obj_probe_deallocate;
    var itn: intern.Interner = intern.init(?alloc);

    val ir: res[of.ObjectImage, fail.Fail] = image_init(?alloc, ?itn, t_obj_intern(?itn, "m"));
    if (sel ir.err) { ret 1; }
    var img: of.ObjectImage = ir.ok;

    val ab: res[*u8, A.Error] = A.allocate[u8](?alloc, 8::usize);
    if (sel ab.err) { ret 1; }
    img.attributes     = ab.ok;
    img.attributes_len = 8;

    dnit(?img);
    intern.dnit(?itn);

    if (probe.mismatch)  { ret 1; }
    if (probe.live != 0) { ret 1; }
    ret 0;
}

test "mach.lang.be.obj.install_section:consumes_payload_on_success_and_failure" {
    var probe: ObjProbe;
    if (!obj_probe_make(?probe, 0)) { ret 1; }
    var pp:    *ObjProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = obj_probe_allocate;
    alloc.fn_reallocate = obj_probe_reallocate;
    alloc.fn_deallocate = obj_probe_deallocate;
    var itn: intern.Interner = intern.init(?alloc);

    val ir: res[of.ObjectImage, fail.Fail] = image_init(?alloc, ?itn, t_obj_intern(?itn, "m"));
    if (sel ir.err) {
        intern.dnit(?itn);
        ret 1;
    }
    var img: of.ObjectImage = ir.ok;

    val br: res[*u8, A.Error] = A.allocate[u8](?alloc, 16::usize);
    if (sel br.err) {
        dnit(?img);
        intern.dnit(?itn);
        ret 1;
    }
    var sec: of.Section;
    sec.name  = t_obj_intern(?itn, ".data");
    sec.kind  = of.SK_DATA;
    sec.bytes = br.ok;
    sec.len   = 16;
    sec.align = 8;
    sec.flags = 0;

    probe.fail_at = probe.calls + 1;
    val installed: res[u32, fail.Fail] = section_install(?img, ?sec);
    probe.fail_at = 0;

    var bad: i32 = 0;
    if (sel installed.ok)                 { bad = 1; }
    if (img.section_count != 0)           { bad = 2; }
    if (sec.bytes != nil || sec.len != 0) { bad = 3; }

    val br2: res[*u8, A.Error] = A.allocate[u8](?alloc, 16::usize);
    if (sel br2.err) {
        dnit(?img);
        intern.dnit(?itn);
        ret 1;
    }
    sec.bytes = br2.ok;
    sec.len   = 16;
    val installed2: res[u32, fail.Fail] = section_install(?img, ?sec);
    if (sel installed2.err)               { bad = 4; }
    if (img.section_count != 1)           { bad = 5; }
    if (sec.bytes != nil || sec.len != 0) { bad = 6; }
    dnit(?img);
    intern.dnit(?itn);
    if (probe.mismatch)  { bad = 7; }
    if (probe.live != 0) { bad = 8; }
    ret bad;
}

test "mach.lang.be.obj.rehome_remap:copies_imports" {
    var probe: ObjProbe;
    if (!obj_probe_make(?probe, 0)) { ret 1; }
    var pp:    *ObjProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = obj_probe_allocate;
    alloc.fn_reallocate = obj_probe_reallocate;
    alloc.fn_deallocate = obj_probe_deallocate;
    var base:      intern.Interner = intern.init(?alloc);
    val base_name: intern.StrId    = t_obj_intern(?base, "base");
    val base_len:  usize           = intern.count(?base);
    var child:     intern.Interner = intern.make_child(?base, ?alloc);

    val ir: res[of.ObjectImage, fail.Fail] = image_init(?alloc, ?child, t_obj_intern(?child, "src"));
    if (sel ir.err) { ret 1; }
    var src: of.ObjectImage = ir.ok;

    val ri: res[*of.ImportDecl, A.Error] = A.allocate[of.ImportDecl](?alloc, 1::usize);
    if (sel ri.err) { ret 1; }
    src.imports                = ri.ok;
    src.import_cap             = 1;
    src.imports[0].symbol      = t_obj_intern(?child, "sym");
    src.imports[0].import_name = t_obj_intern(?child, "sym@0");
    src.imports[0].library     = t_obj_intern(?child, "lib.so");
    src.imports[0].ordinal     = 0;
    src.imports[0].by_name     = true;
    src.imports[0].is_code     = true;
    src.import_count           = 1;

    val remap_r: res[intern.ReinternMap, A.Error] = intern.reintern_child(?child, ?alloc);
    if (sel remap_r.err) {
        dnit(?src);
        ret 1;
    }
    var remap: intern.ReinternMap = remap_r.ok;

    var short_map: intern.ReinternMap = remap;
    short_map.len = 1;
    val short: res[of.ObjectImage, fail.Fail] =
        rehome(?alloc, ?base, ?src, short_map);
    if (sel short.ok) {
        var escaped: of.ObjectImage = short.ok;
        dnit(?escaped);
        dnit(?src);
        ret 1;
    }

    val original: intern.StrId = remap.ids[0];
    remap.ids[0] = base_name;
    val wrong: res[of.ObjectImage, fail.Fail] =
        rehome(?alloc, ?base, ?src, remap);
    remap.ids[0] = original;
    if (sel wrong.ok) {
        var escaped: of.ObjectImage = wrong.ok;
        dnit(?escaped);
        dnit(?src);
        ret 1;
    }

    val rr: res[of.ObjectImage, fail.Fail] =
        rehome(?alloc, ?base, ?src, remap);
    if (sel rr.err) {
        dnit(?src);
        ret 1;
    }
    var dst: of.ObjectImage = rr.ok;

    if (dst.import_count != 1) {
        dnit(?src);
        dnit(?dst);
        ret 1;
    }
    if (dst.imports == src.imports) {
        dnit(?src);
        dnit(?dst);
        ret 1;
    }
    if (!dst.imports[0].by_name) {
        dnit(?src);
        dnit(?dst);
        ret 1;
    }
    if (!dst.imports[0].is_code) {
        dnit(?src);
        dnit(?dst);
        ret 1;
    }
    if (dst.imports[0].symbol != remap.ids[src.imports[0].symbol::usize - base_len]) {
        dnit(?src);
        dnit(?dst);
        ret 1;
    }

    dnit(?src);
    dnit(?dst);
    intern.reintern_map_dnit(?alloc, ?remap);
    intern.dnit(?child);
    intern.dnit(?base);

    if (probe.mismatch)  { ret 1; }
    if (probe.live != 0) { ret 1; }
    ret 0;
}

test "mach.lang.be.obj.flush_deferred:sym2_set_and_retry_consumes_flushed_prefix" {
    var probe: ObjProbe;
    if (!obj_probe_make(?probe, 0)) { ret 1; }
    var pp:    *ObjProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = obj_probe_allocate;
    alloc.fn_reallocate = obj_probe_reallocate;
    alloc.fn_deallocate = obj_probe_deallocate;
    var itn: intern.Interner = intern.init(?alloc);

    val ir: res[of.ObjectImage, fail.Fail] = image_init(?alloc, ?itn, t_obj_intern(?itn, "m"));
    if (sel ir.err) { ret 1; }
    var img: of.ObjectImage = ir.ok;

    val name_a: intern.StrId = t_obj_intern(?itn, "sym_a");
    val name_b: intern.StrId = t_obj_intern(?itn, "sym_b");

    var sym_a: of.Symbol;
    sym_a.name    = name_a;
    sym_a.section = of.section_id(0);
    sym_a.offset  = 0;
    sym_a.size    = 0;
    sym_a.flags   = 0;
    val symbol_add_r: res[u32, fail.Fail] = symbol_add(?img, sym_a);
    if (sel symbol_add_r.err) {
        dnit(?img);
        ret 1;
    }
    var filler: of.Symbol = sym_a;
    filler.name = intern.STR_NIL;
    var fill_i: u32 = 1;
    for (fill_i < 8) {
        val symbol_add_r2: res[u32, fail.Fail] = symbol_add(?img, filler);
        if (sel symbol_add_r2.err) {
            dnit(?img);
            ret 1;
        }
        fill_i = fill_i + 1;
    }

    var deferred: DeferredRelocs = deferred_init(?alloc);
    var rec_a:    DeferredReloc;
    rec_a.section      = of.section_id(0);
    rec_a.offset       = 0;
    rec_a.kind         = of.RK_ABS64;
    rec_a.name         = name_a;
    rec_a.addend       = 0;
    rec_a.extern_flags = 0;
    val defer_relocation_r: err[fail.Fail] = defer_relocation(?deferred, rec_a);
    if (sel defer_relocation_r.err) {
        deferred_dnit(?deferred);
        dnit(?img);
        ret 1;
    }
    var rec_b: DeferredReloc;
    rec_b.section      = of.section_id(0);
    rec_b.offset       = 4;
    rec_b.kind         = of.RK_ABS64;
    rec_b.name         = name_b;
    rec_b.addend       = 0;
    rec_b.extern_flags = 0;
    val defer_relocation_r2: err[fail.Fail] = defer_relocation(?deferred, rec_b);
    if (sel defer_relocation_r2.err) {
        deferred_dnit(?deferred);
        dnit(?img);
        ret 1;
    }

    probe.fail_at = probe.calls + 2;
    val r1: err[fail.Fail] = flush_deferred(?img, ?deferred);
    if (sel r1.ok) {
        deferred_dnit(?deferred);
        dnit(?img);
        ret 1;
    }
    if (deferred.count != 1) {
        deferred_dnit(?deferred);
        dnit(?img);
        ret 1;
    }
    if (img.reloc_count != 1) {
        deferred_dnit(?deferred);
        dnit(?img);
        ret 1;
    }

    probe.fail_at = 0;
    val r2: err[fail.Fail] = flush_deferred(?img, ?deferred);
    if (sel r2.err) {
        deferred_dnit(?deferred);
        dnit(?img);
        ret 1;
    }
    if (deferred.count != 0) {
        deferred_dnit(?deferred);
        dnit(?img);
        ret 1;
    }
    if (img.reloc_count != 2) {
        deferred_dnit(?deferred);
        dnit(?img);
        ret 1;
    }
    if (img.relocations[0].sym2 != of.SYMBOL_NONE) {
        deferred_dnit(?deferred);
        dnit(?img);
        ret 1;
    }
    if (img.relocations[1].sym2 != of.SYMBOL_NONE) {
        deferred_dnit(?deferred);
        dnit(?img);
        ret 1;
    }

    deferred_dnit(?deferred);
    dnit(?img);
    intern.dnit(?itn);

    if (probe.mismatch)  { ret 1; }
    if (probe.live != 0) { ret 1; }
    ret 0;
}

test "mach.lang.be.obj.add_symbol:grows_geometrically_and_releases_capacity" {
    var probe: ObjProbe;
    if (!obj_probe_make(?probe, 0)) { ret 1; }
    var pp:    *ObjProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = obj_probe_allocate;
    alloc.fn_reallocate = obj_probe_reallocate;
    alloc.fn_deallocate = obj_probe_deallocate;
    var itn: intern.Interner = intern.init(?alloc);

    val ir: res[of.ObjectImage, fail.Fail] = image_init(?alloc, ?itn, intern.STR_NIL);
    if (sel ir.err) { ret 1; }
    var img: of.ObjectImage = ir.ok;

    var sym: of.Symbol;
    sym.name     = intern.STR_NIL;
    sym.section  = of.external_section();
    sym.offset   = 0;
    sym.size     = 0;
    sym.flags    = of.SYM_OBJ_FLAG_EXTERN;
    sym.fallback = of.SYMBOL_NONE;
    sym.align    = 1;

    val calls_before: u32 = probe.calls;
    var i:            u32 = 0;
    for (i < 4096) {
        val symbol_add_r: res[u32, fail.Fail] = symbol_add(?img, sym);
        if (sel symbol_add_r.err) {
            dnit(?img);
            intern.dnit(?itn);
            ret 1;
        }
        i = i + 1;
    }
    val growth_calls: u32 = probe.calls - calls_before;

    var bad: i32 = 0;
    if (img.symbol_count != 4096) { bad = 1; }
    if (img.symbol_cap != 4096)   { bad = 2; }
    if (growth_calls != 10)       { bad = 3; }

    dnit(?img);
    intern.dnit(?itn);
    if (probe.mismatch)  { bad = 4; }
    if (probe.live != 0) { bad = 5; }
    ret bad;
}

rec GrowthProbe {
    allocate_calls:   u32;
    reallocate_calls: u32;
}

fun growth_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val g: *GrowthProbe = ctx::*GrowthProbe;
    g.allocate_calls = g.allocate_calls + 1;
    ret opt[ptr].none{};
}

fun growth_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val g: *GrowthProbe = ctx::*GrowthProbe;
    g.reallocate_calls = g.reallocate_calls + 1;
    ret opt[ptr].none{};
}

fun growth_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.be.obj.install_section:refuses_count_overflow_before_reallocating" {
    var probe: GrowthProbe;
    probe.allocate_calls   = 0;
    probe.reallocate_calls = 0;
    var pp:    *GrowthProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = growth_probe_allocate;
    alloc.fn_reallocate = growth_probe_reallocate;
    alloc.fn_deallocate = growth_probe_deallocate;
    var itn: intern.Interner = intern.init(?alloc);

    val ir: res[of.ObjectImage, fail.Fail] = image_init(?alloc, ?itn, t_obj_intern(?itn, "m"));
    if (sel ir.err) { ret 1; }
    var img:   of.ObjectImage = ir.ok;
    var dummy: of.Section;
    img.sections      = ?dummy;
    img.section_count = 0x80000000;
    img.section_cap   = 0x80000000;

    var sec: of.Section;
    sec.name               = t_obj_intern(?itn, ".text");
    sec.kind               = of.SK_TEXT;
    sec.bytes              = nil;
    sec.len                = 0;
    sec.align              = 1;
    probe.allocate_calls   = 0;
    probe.reallocate_calls = 0;
    val r: res[u32, fail.Fail] = section_install(?img, ?sec);

    var bad: i32 = 0;
    if (sel r.ok)                        { bad = 1; }
    if (probe.reallocate_calls != 0)     { bad = 2; }
    if (probe.allocate_calls != 0)       { bad = 3; }
    if (img.section_count != 0x80000000) { bad = 4; }

    intern.dnit(?itn);
    ret bad;
}

test "mach.lang.be.obj.defer_relocation:refuses_capacity_overflow_before_reallocating" {
    var probe: GrowthProbe;
    probe.allocate_calls   = 0;
    probe.reallocate_calls = 0;
    var pp:    *GrowthProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = growth_probe_allocate;
    alloc.fn_reallocate = growth_probe_reallocate;
    alloc.fn_deallocate = growth_probe_deallocate;

    var d:     DeferredRelocs = deferred_init(?alloc);
    var dummy: DeferredReloc;
    d.items = ?dummy;
    d.cap   = 0xFFFFFFFF;
    d.count = 0xFFFFFFFF;

    var drec: DeferredReloc;
    drec.section      = of.section_id(0);
    drec.offset       = 0;
    drec.kind         = of.RK_ABS64;
    drec.name         = intern.STR_NIL;
    drec.addend       = 0;
    drec.extern_flags = 0;
    val r: err[fail.Fail] = defer_relocation(?d, drec);

    var bad: i32 = 0;
    if (sel r.ok)                    { bad = 1; }
    if (probe.reallocate_calls != 0) { bad = 2; }
    if (d.cap != 0xFFFFFFFF)         { bad = 3; }
    ret bad;
}

fun t_x64_target(reg: *target.TargetRegistry, out: *target.Target) bool {
    @reg = target.registry_init();
    val r_1034: err[fail.Fail] = target.register_all(reg, target_testing.debug_descriptor);
    if (sel r_1034.err) { ret false; }
    val ts: res[target.Target, fail.Fail] = target.select(reg, "x86_64", "linux", "sysv64");
    if (sel ts.err) {
        target.registry_dnit(reg);
        ret false;
    }
    @out = ts.ok;
    ret true;
}

test "mach.lang.be.obj.defer_relocation_for_target:refuses_a_kind_the_target_cannot_encode" {
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var t: target.Target;
    if (!t_x64_target(?reg, ?t)) { ret 1; }

    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var d: DeferredRelocs = deferred_init(?alloc);

    var rec: DeferredReloc;
    rec.section      = of.section_id(0);
    rec.offset       = 0;
    rec.kind         = of.RK_PAGE21;
    rec.name         = intern.STR_NIL;
    rec.addend       = 0;
    rec.extern_flags = 0;

    val r:   err[fail.Fail] = defer_relocation_for_target(?d, rec, ?t, of.SK_TEXT, true);
    var bad: i32            = 0;
    if (sel r.ok)     { bad = 1; }
    if (d.count != 0) { bad = 2; }

    deferred_dnit(?d);
    ret bad;
}

test "mach.lang.be.obj.defer_relocation_for_target:admits_a_kind_the_target_can_encode" {
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var t: target.Target;
    if (!t_x64_target(?reg, ?t)) { ret 1; }

    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var d: DeferredRelocs = deferred_init(?alloc);

    var rec: DeferredReloc;
    rec.section      = of.section_id(0);
    rec.offset       = 0;
    rec.kind         = of.RK_PLT32;
    rec.name         = intern.STR_NIL;
    rec.addend       = 0;
    rec.extern_flags = 0;

    val r:   err[fail.Fail] = defer_relocation_for_target(?d, rec, ?t, of.SK_TEXT, true);
    var bad: i32            = 0;
    if (sel r.err)    { bad = 1; }
    if (d.count != 1) { bad = 2; }

    deferred_dnit(?d);
    ret bad;
}
