# the emission unit: what a whole-module emitter is handed instead of one module
#
# A REGISTER MACHINE compiles one mach module to one object and lets the linker
# bind the calls that leave it, so the back half never needs to see more than the
# module in front of it. A WHOLE-MODULE EMITTER has no such second chance: a
# SPIR-V module is self-contained, so a call that leaves the mach module has to be
# answered by emitting the callee's body into the same output. That is not a wider
# loop over one module - it is a wider INPUT, and this record is it.
#
# The unit is a flat table of lowered modules with one of them marked as the root:
# the module the artifact is named for, whose entry points (or, for a library
# module, whose exported functions) are the roots of every reachability walk the
# emitter runs. Every other member is present only because the root, or something
# the root reaches, calls into it. Membership is decided by the driver, which owns
# the module graph; what is REACHED inside a member is decided by the emitter,
# which owns the call graph. Those are two different prunings and they compose:
# importing a large shared module costs the modules it actually supplies code
# from, and within those, the functions actually called.
#
# The table is ordered and the root's position is explicit rather than assumed to
# be 0, so a caller that assembles the members in dependency order does not have
# to reorder them to put the root first. Emission order follows the table, which
# is what makes the output deterministic for a fixed input.
#
# THE GROWTH AXIS. A second whole-module target (WGSL, DXIL, a future SPIR-V
# profile) has the same shape of problem and takes the same unit; nothing here is
# SPIR-V's. What a new member of that axis may need beyond this is more per-module
# facts, which is a field on `UnitModule`, never a second parameter threaded
# through `codegen.EmitModuleFn`.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use R: std.types.result;

use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.be.codegen.mir;

# one member of the emission unit: a mach module, lowered
#
# Both halves are borrowed. The IR is the module's post-pipeline SSA form, which
# carries the signatures, linkage and per-module TYPE TABLE; the MIR is the
# post-lower body form, which carries the instructions. Neither is complete on its
# own for this purpose - a callee's signature is read from the IR and its body
# from the MIR - and an IR type id is meaningful only against the type table of
# the module it came from, which is why the two travel as a pair rather than as
# two independent lists.
# ---
# ir:  the module's optimized IR (signatures, linkage, globals, type table)
# mir: the same module's post-lower MIR (bodies)
pub rec UnitModule {
    ir:  *ir.Module;
    mir: *mir.MirModule;
}

# no member of the unit answers to the requested name
pub val UNIT_NONE: u32 = 0xFFFFFFFF;

# the set of lowered modules one whole-module emission draws from
# ---
# mods: the members, in the order the driver assembled them (borrowed entries)
# len:  how many members there are; always at least 1
# root: index of the module being compiled, whose entry points root the walk
pub rec Unit {
    mods: *UnitModule;
    len:  u32;
    root: u32;
}

# the IR modules a whole-module emitter may draw code from, beyond the root
#
# The DRIVER's half of the hand-off, and deliberately IR-only: which modules can
# supply a called body is a question about the module graph, which the driver
# owns, while lowering them to MIR is codegen's job and happens only on the fork
# that needs it. A register machine is handed an empty set (or none at all) and
# reads nothing from it - it has a linker.
# ---
# mods: borrowed IR modules, in a deterministic order (the build's topo order)
# len:  how many there are; 0 for a build with nothing to draw from
pub rec IrSet {
    mods: **ir.Module;
    len:  u32;
}

# an empty IR set, for a caller with nothing to offer
pub fun ir_set_empty() IrSet {
    var s: IrSet;
    s.mods = nil;
    s.len  = 0;
    ret s;
}

# the root member's IR module
# ---
# u:   the unit
# ret: the root module's IR
pub fun root_ir(u: *Unit) *ir.Module {
    ret u.mods[u.root].ir;
}

# the root member's MIR module
# ---
# u:   the unit
# ret: the root module's MIR
pub fun root_mir(u: *Unit) *mir.MirModule {
    ret u.mods[u.root].mir;
}

# the index of the module's defined (non-extern) function of the given name
#
# Every entry is checked rather than the first match taken: a forward call lowered
# before its target appends a body-less extern stub of the same name, so the
# defined entry may not be the first one.
# ---
# m:    the IR module to search
# name: the interned function symbol
# ret:  the function's index, or UNIT_NONE
pub fun defined_index(m: *ir.Module, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < m.function_len) {
        val fn: *ir.Function = ?m.functions[i];
        if (fn.name == name && (fn.flags & ir.FN_FLAG_EXTERN) == 0) { ret i; }
        i = i + 1;
    }
    ret UNIT_NONE;
}

# the index of a named global DEFINED in one module, or UNIT_NONE
#
# The global counterpart of `defined_index` (#2843). An extern shadow is not a
# definition here for the same reason it is not one there: the point of asking is
# to find the module that owns the declaration, and every consumer of a shared
# variable carries a shadow of it.
# ---
# m:    the module
# name: the interned global symbol
# ret:  the index in `m.globals`, or UNIT_NONE
pub fun defined_global_index(m: *ir.Module, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < m.global_len) {
        val g: *ir.Global = ?m.globals[i];
        if (g.name == name && !g.is_extern) { ret i; }
        i = i + 1;
    }
    ret UNIT_NONE;
}

# the index of the MIR function carrying a named function's body in one member
# ---
# u:    the unit
# mi:   the member index
# name: the interned function symbol
# ret:  the MIR function index, or UNIT_NONE when the member lowered no body for it
pub fun mir_index(u: *Unit, mi: u32, name: intern.StrId) u32 {
    val mm: *mir.MirModule = u.mods[mi].mir;
    if (mm == nil) { ret UNIT_NONE; }
    var i: u32 = 0;
    for (i < mm.function_len) {
        if (mm.functions[i].name == name) { ret i; }
        i = i + 1;
    }
    ret UNIT_NONE;
}

# allocate a unit's member table
# ---
# a:   allocator for the table
# n:   member count
# u:   receives the initialized unit (root 0, members zeroed)
# ret: true on success, or an allocation error
pub fun init(a: *A.Allocator, n: u32, u: *Unit) R.Result[bool, str] {
    u.mods = nil;
    u.len  = 0;
    u.root = 0;
    if (n == 0) { ret R.ok[bool, str](true); }
    val r: R.Result[*UnitModule, str] = A.allocate[UnitModule](a, n::usize);
    if (R.is_err[*UnitModule, str](r)) { ret R.err[bool, str](R.unwrap_err[*UnitModule, str](r)); }
    u.mods = R.unwrap_ok[*UnitModule, str](r);
    u.len  = n;
    var i: u32 = 0;
    for (i < n) { u.mods[i].ir = nil; u.mods[i].mir = nil; i = i + 1; }
    ret R.ok[bool, str](true);
}

# release a unit's member table; the members themselves are borrowed
# ---
# a: the allocator `init` used
# u: the unit
pub fun dnit(a: *A.Allocator, u: *Unit) {
    if (u.mods != nil && u.len > 0) { A.deallocate[UnitModule](a, u.mods, u.len::usize); }
    u.mods = nil;
    u.len  = 0;
}
