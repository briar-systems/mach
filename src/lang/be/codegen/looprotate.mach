use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator.page;

use A: std.allocator;

use lang_mir: mach.lang.mir;
use mach.lang.mir.flow;
use lang_source: mach.lang.source;
use lang_target: mach.lang.target;

# the absent entry in every scratch table here (block position, vreg number, remap)
val NONE: u32 = flow.NONE;

pub fun run(tgt: *lang_target.Binding, m: *lang_mir.MirModule) err[fail.Fail] {
    if (m == nil) { ret err[fail.Fail].err{fail.message("looprotate: nil mir module")}; }
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val r: err[fail.Fail] = rotate_function(m.alloc, ?m.functions[fi]);
        if (sel r.err) { ret r; }
        fi = fi + 1;
    }
    ret err[fail.Fail].ok{};
}

# the graph holds each block's strongly connected component over the
# terminator edges: a header's body is confined to its own component, so
# mark_loop walks the loop rather than everything the body can reach.
# loop_mark stamps a block with the epoch of the mark_loop call that reached
# it, so a candidate header costs the blocks its loop holds rather than a
# sweep of the function. named_in and named_multi record, per virtual
# register, the one block naming it or that several do, so a header's
# definitions are checked for confinement without a sweep of the function
rec LoopScratch {
    graph:       flow.Graph;
    built:       bool;
    loop_mark:   *u32;
    epoch:       u32;
    stack:       *u32;
    block_count: u32;
    named_in:    *u32;
    named_multi: *bool;
    vreg_count:  u32;
}

fun rotate_function(alloc: *A.Allocator, f: *lang_mir.MirFunction) err[fail.Fail] {
    if (f.block_count == 0) { ret err[fail.Fail].ok{}; }

    var sc: LoopScratch;
    val si: err[fail.Fail] = scratch_init(alloc, f, ?sc);
    if (sel si.err) { ret si; }
    fin { scratch_dnit(alloc, ?sc); }

    val rg: err[fail.Fail] = rebuild_graph(alloc, f, ?sc);
    if (sel rg.err) { ret rg; }
    val rn: err[fail.Fail] = rebuild_naming(alloc, f, ?sc);
    if (sel rn.err) { ret rn; }

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val rotated_r: res[bool, fail.Fail] = try_rotate_header(alloc, f, ?sc, bi);
        if (sel rotated_r.err) { ret err[fail.Fail].err{rotated_r.err}; }
        if (rotated_r.ok) {
            val rg2: err[fail.Fail] = rebuild_graph(alloc, f, ?sc);
            if (sel rg2.err) { ret rg2; }
            val rn2: err[fail.Fail] = rebuild_naming(alloc, f, ?sc);
            if (sel rn2.err) { ret rn2; }
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun scratch_init(alloc: *A.Allocator, f: *lang_mir.MirFunction, sc: *LoopScratch) err[fail.Fail] {
    sc.built       = false;
    sc.loop_mark   = nil;
    sc.epoch       = 0;
    sc.stack       = nil;
    sc.block_count = f.block_count;
    sc.named_in    = nil;
    sc.named_multi = nil;
    sc.vreg_count  = 0;

    val rb: res[*u32, A.Error] = A.allocate[u32](alloc, f.block_count::usize);
    if (sel rb.err) { ret err[fail.Fail].err{fail.refused(rb.err)}; }
    sc.loop_mark = rb.ok;
    var mi: u32 = 0;
    for (mi < f.block_count) {
        sc.loop_mark[mi] = 0;
        mi               = mi + 1;
    }

    val rs: res[*u32, A.Error] = A.allocate[u32](alloc, f.block_count::usize);
    if (sel rs.err) {
        scratch_dnit(alloc, sc);
        ret err[fail.Fail].err{fail.refused(rs.err)};
    }
    sc.stack = rs.ok;
    ret err[fail.Fail].ok{};
}

fun scratch_dnit(alloc: *A.Allocator, sc: *LoopScratch) {
    if (sc.built) {
        flow.dnit(?sc.graph);
        sc.built = false;
    }
    if (sc.loop_mark != nil) {
        A.deallocate[u32](alloc, sc.loop_mark, sc.block_count::usize);
        sc.loop_mark = nil;
    }
    if (sc.stack != nil) {
        A.deallocate[u32](alloc, sc.stack, sc.block_count::usize);
        sc.stack = nil;
    }
    naming_dnit(alloc, sc);
}

# a rotation changes the entry block's terminator, so the graph and its
# components are built again after each one
fun rebuild_graph(alloc: *A.Allocator, f: *lang_mir.MirFunction, sc: *LoopScratch) err[fail.Fail] {
    if (sc.built) {
        flow.dnit(?sc.graph);
        sc.built = false;
    }
    val rg: res[flow.Graph, fail.Fail] = flow.init(alloc, f);
    if (sel rg.err) { ret err[fail.Fail].err{rg.err}; }
    sc.graph = rg.ok;
    sc.built = true;
    ret flow.components_build(?sc.graph);
}

fun naming_dnit(alloc: *A.Allocator, sc: *LoopScratch) {
    if (sc.named_in != nil) {
        A.deallocate[u32](alloc, sc.named_in, sc.vreg_count::usize);
        sc.named_in = nil;
    }
    if (sc.named_multi != nil) {
        A.deallocate[bool](alloc, sc.named_multi, sc.vreg_count::usize);
        sc.named_multi = nil;
    }
    sc.vreg_count = 0;
}

fun note_named(sc: *LoopScratch, v: u32, bi: u32) {
    if (v >= sc.vreg_count)     { ret; }
    if (sc.named_in[v] == NONE) { sc.named_in[v] = bi; }
    or (sc.named_in[v] != bi)   { sc.named_multi[v] = true; }
}

# one sweep of the function after every change to it: a rotation adds
# registers and instructions, so the index is rebuilt at the new count
fun rebuild_naming(alloc: *A.Allocator, f: *lang_mir.MirFunction, sc: *LoopScratch) err[fail.Fail] {
    naming_dnit(alloc, sc);
    if (f.vreg_count == 0) { ret err[fail.Fail].ok{}; }
    val rn: res[*u32, A.Error] = A.allocate[u32](alloc, f.vreg_count::usize);
    if (sel rn.err) { ret err[fail.Fail].err{fail.refused(rn.err)}; }
    sc.named_in   = rn.ok;
    sc.vreg_count = f.vreg_count;
    val rm: res[*bool, A.Error] = A.allocate[bool](alloc, f.vreg_count::usize);
    if (sel rm.err) {
        naming_dnit(alloc, sc);
        ret err[fail.Fail].err{fail.refused(rm.err)};
    }
    sc.named_multi = rm.ok;
    var v: u32 = 0;
    for (v < f.vreg_count) {
        sc.named_in[v]    = NONE;
        sc.named_multi[v] = false;
        v                 = v + 1;
    }

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val mb: *lang_mir.MirBlock = ?f.blocks[bi];
        var k:  u32                = 0;
        for (k < mb.instr_count) {
            val ins: *lang_mir.MirInstr = ?mb.instrs[k];
            var o:   u32                = 0;
            for (o < ins.operand_count) {
                val op: *lang_mir.MirOperand = ?ins.operands[o];
                if (op.kind == lang_mir.MIR_OP_VREG) { note_named(sc, op.vreg.n, bi); }
                if (op.kind == lang_mir.MIR_OP_MEM) {
                    note_named(sc, op.vreg.n, bi);
                    if (sel op.index.vreg) { note_named(sc, op.index.vreg.n, bi); }
                }
                o = o + 1;
            }
            k = k + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun try_rotate_header(alloc: *A.Allocator, f: *lang_mir.MirFunction, sc: *LoopScratch,
    hx: u32) res[bool, fail.Fail] {
    val h: *lang_mir.MirBlock = ?f.blocks[hx];
    if (h.instr_count == 0) { ret res[bool, fail.Fail].ok{false}; }
    val term: *lang_mir.MirInstr = ?h.instrs[h.instr_count - 1];
    if (term.opcode != lang_mir.MIR_CBR) { ret res[bool, fail.Fail].ok{false}; }
    if (term.operand_count < 3)          { ret res[bool, fail.Fail].ok{false}; }

    val cond_op: *lang_mir.MirOperand = ?term.operands[0];
    if (cond_op.kind != lang_mir.MIR_OP_VREG)           { ret res[bool, fail.Fail].ok{false}; }
    if (term.operands[1].kind != lang_mir.MIR_OP_BLOCK) { ret res[bool, fail.Fail].ok{false}; }
    if (term.operands[2].kind != lang_mir.MIR_OP_BLOCK) { ret res[bool, fail.Fail].ok{false}; }

    val cond_vreg: u32 = cond_op.vreg.n;
    val b_id:      u32 = term.operands[1].imm::u32;
    val e_id:      u32 = term.operands[2].imm::u32;
    if (b_id == e_id) { ret res[bool, fail.Fail].ok{false}; }
    if (b_id == h.id) { ret res[bool, fail.Fail].ok{false}; }
    if (e_id == h.id) { ret res[bool, fail.Fail].ok{false}; }

    val g:     *flow.Graph = ?sc.graph;
    val first: u32         = g.pred_start[hx];
    val last:  u32         = g.pred_start[hx + 1];
    if (last - first < 2) { ret res[bool, fail.Fail].ok{false}; }

    if (!test_clonable(h, cond_vreg)) { ret res[bool, fail.Fail].ok{false}; }
    if (!defs_confined(sc, hx, h))    { ret res[bool, fail.Fail].ok{false}; }

    val bx: u32 = flow.position_of(?g.index, b_id::i64);
    val ex: u32 = flow.position_of(?g.index, e_id::i64);
    if (!mark_loop(sc, bx, hx, ex)) { ret res[bool, fail.Fail].ok{false}; }
    var px:      u32 = NONE;
    var outside: u32 = 0;
    var inside:  u32 = 0;
    var e:       u32 = first;
    for (e < last) {
        val q: u32 = g.pred[e];
        if (sc.loop_mark[q] == sc.epoch) {
            inside = inside + 1;
        }
        or {
            outside = outside + 1;
            px      = q;
        }
        e = e + 1;
    }
    if (outside != 1) { ret res[bool, fail.Fail].ok{false}; }
    if (inside == 0)  { ret res[bool, fail.Fail].ok{false}; }
    if (px == hx)     { ret res[bool, fail.Fail].ok{false}; }
    if (px == ex)     { ret res[bool, fail.Fail].ok{false}; }

    val p: *lang_mir.MirBlock = ?f.blocks[px];
    if (!ends_in_br_to(p, h.id)) { ret res[bool, fail.Fail].ok{false}; }

    val rotated: err[fail.Fail] = rotate(alloc, f, h, p, b_id, e_id, cond_vreg);

    if (sel rotated.err) { ret res[bool, fail.Fail].err{rotated.err}; }

    ret res[bool, fail.Fail].ok{true};
}

# marks the body of the loop at hx entered at bx: the blocks bx reaches
# inside hx's component without passing through hx or the exit ex
fun mark_loop(sc: *LoopScratch, bx: u32, hx: u32, ex: u32) bool {
    sc.epoch = sc.epoch + 1;
    if (sc.epoch == 0) {
        var i: u32 = 0;
        for (i < sc.block_count) {
            sc.loop_mark[i] = 0;
            i               = i + 1;
        }
        sc.epoch = 1;
    }

    if (bx == NONE) { ret false; }
    val g:    *flow.Graph = ?sc.graph;
    var loop: u32         = NONE;
    if (hx != NONE) { loop = g.component[hx]; }
    sc.loop_mark[bx] = sc.epoch;
    sc.stack[0]      = bx;
    var sp: u32 = 1;
    if (g.component[bx] != loop) { ret true; }

    for (sp > 0) {
        sp = sp - 1;
        val x: u32 = sc.stack[sp];
        var e: u32 = g.succ_start[x];
        for (e < g.succ_start[x + 1]) {
            val t: u32 = g.succ[e];
            if (t != hx && t != ex && sc.loop_mark[t] != sc.epoch && g.component[t] == loop) {
                sc.loop_mark[t] = sc.epoch;
                sc.stack[sp]    = t;
                sp              = sp + 1;
            }
            e = e + 1;
        }
    }
    ret true;
}

fun rotate(alloc: *A.Allocator, f: *lang_mir.MirFunction, h: *lang_mir.MirBlock, p: *lang_mir.MirBlock,
    b_id: u32, e_id: u32, cond_vreg: u32) err[fail.Fail] {
    val orig_vregs: u32                = f.vreg_count;
    val rr:         res[*u32, A.Error] = A.allocate[u32](alloc, orig_vregs::usize);
    if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
    val remap: *u32 = rr.ok;
    var i:     u32  = 0;
    for (i < orig_vregs) {
        remap[i] = NONE;
        i        = i + 1;
    }

    # the entry branch goes, and its debug bindings move to the first guard
    # instruction, the program point that replaces it
    var entry: lang_mir.MirInstr = p.instrs[p.instr_count - 1];
    if (entry.operands != nil && entry.operand_count > 0) {
        A.deallocate[lang_mir.MirOperand](alloc, entry.operands, entry.operand_count::usize);
    }
    val guard_start: u32 = p.instr_count - 1;
    p.instr_count = guard_start;

    var k: u32 = 0;
    for (k < h.instr_count - 1) {
        val cl: res[lang_mir.MirInstr, fail.Fail] = clone_compute(alloc, f, ?h.instrs[k], remap, orig_vregs);
        if (sel cl.err) {
            A.deallocate[u32](alloc, remap, orig_vregs::usize);
            ret err[fail.Fail].err{cl.err};
        }
        val ap: err[fail.Fail] = lang_mir.instr_add(alloc, p, cl.ok);
        if (sel ap.err) {
            A.deallocate[u32](alloc, remap, orig_vregs::usize);
            ret ap;
        }
        k = k + 1;
    }

    val hb: *lang_mir.MirInstr                = ?h.instrs[h.instr_count - 1];
    val gr: res[lang_mir.MirInstr, fail.Fail] = clone_guard_cbr(alloc, hb, remap, orig_vregs, cond_vreg, b_id, e_id);
    if (sel gr.err) {
        A.deallocate[u32](alloc, remap, orig_vregs::usize);
        ret err[fail.Fail].err{gr.err};
    }
    val ap2: err[fail.Fail] = lang_mir.instr_add(alloc, p, gr.ok);
    if (sel ap2.err) {
        A.deallocate[u32](alloc, remap, orig_vregs::usize);
        ret ap2;
    }
    A.deallocate[u32](alloc, remap, orig_vregs::usize);

    ret lang_mir.instr_pass_dbg(alloc, ?entry, ?p.instrs[guard_start]);
}

fun test_clonable(h: *lang_mir.MirBlock, cond_vreg: u32) bool {
    var defines_cond: bool = false;
    var i:            u32  = 0;
    for (i < h.instr_count - 1) {
        val ins: *lang_mir.MirInstr = ?h.instrs[i];
        if (!clonable_opcode(ins.opcode))                 { ret false; }
        if (!lang_mir.instr_defines_shape(ins))           { ret false; }
        if (ins.operand_count == 0)                       { ret false; }
        if (ins.operands[0].kind != lang_mir.MIR_OP_VREG) { ret false; }
        if (ins.operands[0].vreg.n == cond_vreg)          { defines_cond = true; }
        i = i + 1;
    }
    ret defines_cond;
}

# every register the header's test defines is named by the header alone
fun defs_confined(sc: *LoopScratch, hx: u32, h: *lang_mir.MirBlock) bool {
    var i: u32 = 0;
    for (i < h.instr_count - 1) {
        val ins: *lang_mir.MirInstr = ?h.instrs[i];
        if (ins.operand_count > 0 && ins.operands[0].kind == lang_mir.MIR_OP_VREG) {
            val v: u32 = ins.operands[0].vreg.n;
            if (v < sc.vreg_count && (sc.named_multi[v] || (sc.named_in[v] != NONE && sc.named_in[v] != hx))) {
                ret false;
            }
        }
        i = i + 1;
    }
    ret true;
}

fun clonable_opcode(op: lang_mir.MirOpcode) bool {
    ret lang_mir.has(op, lang_mir.MIRF_CLONABLE);
}

fun clone_compute(alloc: *A.Allocator, f: *lang_mir.MirFunction, src: *lang_mir.MirInstr,
    remap: *u32, orig_vregs: u32) res[lang_mir.MirInstr, fail.Fail] {
    val old_dest: u32                 = src.operands[0].vreg.n;
    val nd:       res[u32, fail.Fail] = lang_mir.vreg_add_like(alloc, f, old_dest);
    if (sel nd.err) { ret res[lang_mir.MirInstr, fail.Fail].err{nd.err}; }
    val new_dest: u32 = nd.ok;

    val ro: res[*lang_mir.MirOperand, A.Error] = A.allocate[lang_mir.MirOperand](alloc, src.operand_count::usize);
    if (sel ro.err) { ret res[lang_mir.MirInstr, fail.Fail].err{fail.refused(ro.err)}; }
    val ops: *lang_mir.MirOperand = ro.ok;

    var k: u32 = 1;
    for (k < src.operand_count) {
        ops[k] = remap_operand(src.operands[k], remap, orig_vregs);
        k      = k + 1;
    }
    remap[old_dest] = new_dest;
    ops[0]          = lang_mir.op_vreg(lang_mir.vreg_id(new_dest));

    ret make_instr(alloc, src, ops, src.operand_count, remap, orig_vregs);
}

fun clone_guard_cbr(alloc: *A.Allocator, src: *lang_mir.MirInstr, remap: *u32, orig_vregs: u32,
    cond_vreg: u32, b_id: u32, e_id: u32) res[lang_mir.MirInstr, fail.Fail] {
    val ro: res[*lang_mir.MirOperand, A.Error] = A.allocate[lang_mir.MirOperand](alloc, 3::usize);
    if (sel ro.err) { ret res[lang_mir.MirInstr, fail.Fail].err{fail.refused(ro.err)}; }
    val ops: *lang_mir.MirOperand = ro.ok;

    var cond: lang_mir.MirOperand = lang_mir.op_vreg(lang_mir.vreg_id(cond_vreg));
    if (cond_vreg < orig_vregs && remap[cond_vreg] != NONE) {
        cond = lang_mir.op_vreg(lang_mir.vreg_id(remap[cond_vreg]));
    }
    ops[0] = cond;
    ops[1] = lang_mir.op_block(b_id);
    ops[2] = lang_mir.op_block(e_id);

    ret make_instr(alloc, src, ops, 3, remap, orig_vregs);
}

fun remap_operand(src: lang_mir.MirOperand, remap: *u32, orig_vregs: u32) lang_mir.MirOperand {
    var o: lang_mir.MirOperand = src;
    if (o.kind == lang_mir.MIR_OP_VREG && o.vreg.n < orig_vregs && remap[o.vreg.n] != NONE) {
        o.vreg = lang_mir.vreg_id(remap[o.vreg.n]);
    }
    if (o.kind == lang_mir.MIR_OP_MEM) {
        if (!lang_mir.vreg_is_nil(o.vreg) && o.vreg.n < orig_vregs && remap[o.vreg.n] != NONE) {
            o.vreg = lang_mir.vreg_id(remap[o.vreg.n]);
        }
        var ix: u32 = NONE;
        if (sel o.index.vreg)                     { ix = o.index.vreg.n; }
        if (ix < orig_vregs && remap[ix] != NONE) { o.index = lang_mir.index_vreg(lang_mir.vreg_id(remap[ix])); }
    }
    ret o;
}

# a guard instruction is the header instruction's program point once more, so
# it carries the same debug bindings, renamed where they name a register the
# guard computes its own copy of
fun make_instr(alloc: *A.Allocator, src: *lang_mir.MirInstr, ops: *lang_mir.MirOperand, n: u32,
    remap: *u32, orig_vregs: u32) res[lang_mir.MirInstr, fail.Fail] {
    var mi: lang_mir.MirInstr = lang_mir.instr_like(src, ops, n);
    mi.asm_block         = nil;
    mi.dbg_bindings      = nil;
    mi.dbg_binding_count = 0;
    if (src.dbg_binding_count > 0) {
        val rb: res[*lang_mir.MirDbgBinding, A.Error] = A.allocate[lang_mir.MirDbgBinding](alloc, src.dbg_binding_count::usize);
        if (sel rb.err) {
            A.deallocate[lang_mir.MirOperand](alloc, ops, n::usize);
            ret res[lang_mir.MirInstr, fail.Fail].err{fail.refused(rb.err)};
        }
        mi.dbg_bindings      = rb.ok;
        mi.dbg_binding_count = src.dbg_binding_count;
        var i: u32 = 0;
        for (i < src.dbg_binding_count) {
            var b: lang_mir.MirDbgBinding = src.dbg_bindings[i];
            b.vreg             = remap_vreg(b.vreg, remap, orig_vregs);
            b.vreg2            = remap_vreg(b.vreg2, remap, orig_vregs);
            mi.dbg_bindings[i] = b;
            i                  = i + 1;
        }
    }
    ret res[lang_mir.MirInstr, fail.Fail].ok{mi};
}

fun remap_vreg(v: u32, remap: *u32, orig_vregs: u32) u32 {
    if (v < orig_vregs && remap[v] != NONE) { ret remap[v]; }
    ret v;
}

fun ends_in_br_to(mb: *lang_mir.MirBlock, target: u32) bool {
    if (mb.instr_count == 0) { ret false; }
    val t: *lang_mir.MirInstr = ?mb.instrs[mb.instr_count - 1];
    if (t.opcode != lang_mir.MIR_BR)                 { ret false; }
    if (t.operand_count < 1)                         { ret false; }
    if (t.operands[0].kind != lang_mir.MIR_OP_BLOCK) { ret false; }
    ret t.operands[0].imm::u32 == target;
}

#[testing]
fun t_ops(alloc: *A.Allocator, src: *lang_mir.MirOperand, n: u32) *lang_mir.MirOperand {
    val r: res[*lang_mir.MirOperand, A.Error] = A.allocate[lang_mir.MirOperand](alloc, n::usize);
    if (sel r.err) { ret nil; }
    val out: *lang_mir.MirOperand = r.ok;
    var i:   u32                  = 0;
    for (i < n) {
        out[i] = src[i];
        i      = i + 1;
    }
    ret out;
}

#[testing]
fun t_instr(alloc: *A.Allocator, op: lang_mir.MirOpcode, ops: *lang_mir.MirOperand, n: u32) lang_mir.MirInstr {
    var mi: lang_mir.MirInstr = lang_mir.instr(op, t_ops(alloc, ops, n), n, 8, 8);
    mi.asm_block         = nil;
    mi.loc               = lang_source.location_nil();
    mi.dbg_bindings      = nil;
    mi.dbg_binding_count = 0;
    mi.inline_site       = 0;
    mi.vec_lane          = lang_mir.VEC_LANE_NONE;
    mi.writes_secret     = false;
    ret mi;
}

#[testing]
fun t_block(alloc: *A.Allocator, id: u32, instrs: *lang_mir.MirInstr, n: u32) lang_mir.MirBlock {
    var b: lang_mir.MirBlock;
    val r: res[*lang_mir.MirInstr, A.Error] = A.allocate[lang_mir.MirInstr](alloc, n::usize);
    if (sel r.err) { ret b; }
    val own: *lang_mir.MirInstr = r.ok;
    var i:   u32                = 0;
    for (i < n) {
        own[i] = instrs[i];
        i      = i + 1;
    }

    b.id          = id;
    b.instrs      = own;
    b.instr_count = n;
    b.instr_cap   = n;
    ret b;
}

#[testing]
fun t_fn(alloc: *A.Allocator, blocks: *lang_mir.MirBlock, nb: u32, nv: u32) lang_mir.MirFunction {
    var f: lang_mir.MirFunction;
    f.blocks      = blocks;
    f.block_count = nb;
    f.block_cap   = nb;
    val r: res[*lang_mir.MirVReg, A.Error] = A.allocate[lang_mir.MirVReg](alloc, nv::usize);
    if (sel r.err) { ret f; }
    f.vregs      = r.ok;
    f.vreg_count = nv;
    f.vreg_cap   = nv;
    var i: u32 = 0;
    for (i < nv) {
        f.vregs[i].id         = i;
        f.vregs[i].class      = lang_mir.REG_CLASS_GP;
        f.vregs[i].spill_slot = -1;
        f.vregs[i].assigned   = lang_mir.MIR_PREG_NIL;
        f.vregs[i].vec_bytes  = 0;
        f.vregs[i].secret     = false;
        i                     = i + 1;
    }
    ret f;
}

# the predecessor edges into the block at position b, and the id of the block
# the k-th comes from
#[testing]
fun t_pred_count(alloc: *A.Allocator, f: *lang_mir.MirFunction, b: u32) u32 {
    val rg: res[flow.Graph, fail.Fail] = flow.init(alloc, f);
    if (sel rg.err) { ret NONE; }
    var g: flow.Graph = rg.ok;
    fin { flow.dnit(?g); }
    ret g.pred_start[b + 1] - g.pred_start[b];
}

#[testing]
fun t_pred_id(alloc: *A.Allocator, f: *lang_mir.MirFunction, b: u32, k: u32) u32 {
    val rg: res[flow.Graph, fail.Fail] = flow.init(alloc, f);
    if (sel rg.err) { ret NONE; }
    var g: flow.Graph = rg.ok;
    fin { flow.dnit(?g); }
    ret f.blocks[g.pred[g.pred_start[b] + k]].id;
}

#[testing]
fun t_ends_in_cbr_to(mb: *lang_mir.MirBlock, then_id: u32, else_id: u32) bool {
    if (mb.instr_count == 0) { ret false; }
    val t: *lang_mir.MirInstr = ?mb.instrs[mb.instr_count - 1];
    if (t.opcode != lang_mir.MIR_CBR)                                                     { ret false; }
    if (t.operand_count != 3)                                                             { ret false; }
    if (t.operands[1].kind != lang_mir.MIR_OP_BLOCK || t.operands[1].imm::u32 != then_id) { ret false; }
    if (t.operands[2].kind != lang_mir.MIR_OP_BLOCK || t.operands[2].imm::u32 != else_id) { ret false; }
    ret true;
}

test rotate__a_multi_block_body {
    var alloc: A.Allocator;
    page.make(?alloc);

    var mov: [2]lang_mir.MirOperand;
    mov[0] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    mov[1] = lang_mir.op_imm(0);
    var pbr: [1]lang_mir.MirOperand;
    pbr[0] = lang_mir.op_block(1);
    var b0i: [2]lang_mir.MirInstr;
    b0i[0] = t_instr(?alloc, lang_mir.MIR_MOV, ?mov[0], 2);
    b0i[1] = t_instr(?alloc, lang_mir.MIR_BR, ?pbr[0], 1);

    var cmp: [3]lang_mir.MirOperand;
    cmp[0] = lang_mir.op_vreg(lang_mir.vreg_id(2));
    cmp[1] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    cmp[2] = lang_mir.op_vreg(lang_mir.vreg_id(1));
    var hcbr: [3]lang_mir.MirOperand;
    hcbr[0] = lang_mir.op_vreg(lang_mir.vreg_id(2));
    hcbr[1] = lang_mir.op_block(2);
    hcbr[2] = lang_mir.op_block(5);
    var b1i: [2]lang_mir.MirInstr;
    b1i[0] = t_instr(?alloc, lang_mir.MIR_CMP_LT_S, ?cmp[0], 3);
    b1i[1] = t_instr(?alloc, lang_mir.MIR_CBR, ?hcbr[0], 3);

    var icbr: [3]lang_mir.MirOperand;
    icbr[0] = lang_mir.op_vreg(lang_mir.vreg_id(3));
    icbr[1] = lang_mir.op_block(3);
    icbr[2] = lang_mir.op_block(4);
    var b2i: [1]lang_mir.MirInstr;
    b2i[0] = t_instr(?alloc, lang_mir.MIR_CBR, ?icbr[0], 3);

    var tbr: [1]lang_mir.MirOperand;
    tbr[0] = lang_mir.op_block(4);
    var b3i: [1]lang_mir.MirInstr;
    b3i[0] = t_instr(?alloc, lang_mir.MIR_BR, ?tbr[0], 1);

    var inc: [3]lang_mir.MirOperand;
    inc[0] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    inc[1] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    inc[2] = lang_mir.op_imm(1);
    var lbr: [1]lang_mir.MirOperand;
    lbr[0] = lang_mir.op_block(1);
    var b4i: [2]lang_mir.MirInstr;
    b4i[0] = t_instr(?alloc, lang_mir.MIR_ADD, ?inc[0], 3);
    b4i[1] = t_instr(?alloc, lang_mir.MIR_BR, ?lbr[0], 1);

    var b5i: [1]lang_mir.MirInstr;
    b5i[0] = t_instr(?alloc, lang_mir.MIR_RET, nil, 0);

    var blocks: [6]lang_mir.MirBlock;
    blocks[0] = t_block(?alloc, 0, ?b0i[0], 2);
    blocks[1] = t_block(?alloc, 1, ?b1i[0], 2);
    blocks[2] = t_block(?alloc, 2, ?b2i[0], 1);
    blocks[3] = t_block(?alloc, 3, ?b3i[0], 1);
    blocks[4] = t_block(?alloc, 4, ?b4i[0], 2);
    blocks[5] = t_block(?alloc, 5, ?b5i[0], 1);

    var f: lang_mir.MirFunction = t_fn(?alloc, ?blocks[0], 6, 4);
    val r: err[fail.Fail]       = rotate_function(?alloc, ?f);
    if (sel r.err) { ret 1; }

    if (f.blocks[0].instr_count != 3)                          { ret 1; }
    if (f.blocks[0].instrs[1].opcode != lang_mir.MIR_CMP_LT_S) { ret 1; }
    if (!t_ends_in_cbr_to(?f.blocks[0], 2, 5))                 { ret 1; }
    if (f.blocks[0].instrs[2].operands[0].vreg.n != 4)         { ret 1; }
    if (f.blocks[0].instrs[1].operands[0].vreg.n != 4)         { ret 1; }

    if (t_pred_count(?alloc, ?f, 1) != 1) { ret 1; }
    if (t_pred_id(?alloc, ?f, 1, 0) != 4) { ret 1; }
    if (f.blocks[1].instr_count != 2)     { ret 1; }
    ret 0;
}

# the debug bindings of the rotated blocks describe program points that still
# exist after rotation: the entry branch's point is the first guard instruction
# that replaces it, and the header test's point is also the guard's, with a
# binding to a header-defined register renamed to the guard's copy
test rotate__guard_carries_the_header_and_entry_bindings {
    var alloc: A.Allocator;
    page.make(?alloc);

    var mov: [2]lang_mir.MirOperand;
    mov[0] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    mov[1] = lang_mir.op_imm(0);
    var pbr: [1]lang_mir.MirOperand;
    pbr[0] = lang_mir.op_block(1);
    var b0i: [2]lang_mir.MirInstr;
    b0i[0] = t_instr(?alloc, lang_mir.MIR_MOV, ?mov[0], 2);
    b0i[1] = t_instr(?alloc, lang_mir.MIR_BR, ?pbr[0], 1);
    # `i = 0` is bound at the entry branch, the instruction after the copy
    val entry_bound: err[fail.Fail] = lang_mir.instr_attach_dbg(?alloc, ?b0i[1], 7, 0);
    if (sel entry_bound.err) { ret 1; }

    var cmp: [3]lang_mir.MirOperand;
    cmp[0] = lang_mir.op_vreg(lang_mir.vreg_id(2));
    cmp[1] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    cmp[2] = lang_mir.op_vreg(lang_mir.vreg_id(1));
    var hcbr: [3]lang_mir.MirOperand;
    hcbr[0] = lang_mir.op_vreg(lang_mir.vreg_id(2));
    hcbr[1] = lang_mir.op_block(2);
    hcbr[2] = lang_mir.op_block(3);
    var b1i: [2]lang_mir.MirInstr;
    b1i[0] = t_instr(?alloc, lang_mir.MIR_CMP_LT_S, ?cmp[0], 3);
    b1i[1] = t_instr(?alloc, lang_mir.MIR_CBR, ?hcbr[0], 3);
    # the loop test binds `i` to its register, and the branch after it binds a
    # flag to the test's result, a register the guard computes its own copy of
    val i_bound: err[fail.Fail] = lang_mir.instr_attach_dbg(?alloc, ?b1i[0], 9, 0);
    if (sel i_bound.err) { ret 1; }
    val flag_bound: err[fail.Fail] = lang_mir.instr_attach_dbg(?alloc, ?b1i[1], 11, 2);
    if (sel flag_bound.err) { ret 1; }

    var inc: [3]lang_mir.MirOperand;
    inc[0] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    inc[1] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    inc[2] = lang_mir.op_imm(1);
    var lbr: [1]lang_mir.MirOperand;
    lbr[0] = lang_mir.op_block(1);
    var b2i: [2]lang_mir.MirInstr;
    b2i[0] = t_instr(?alloc, lang_mir.MIR_ADD, ?inc[0], 3);
    b2i[1] = t_instr(?alloc, lang_mir.MIR_BR, ?lbr[0], 1);

    var b3i: [1]lang_mir.MirInstr;
    b3i[0] = t_instr(?alloc, lang_mir.MIR_RET, nil, 0);

    var blocks: [4]lang_mir.MirBlock;
    blocks[0] = t_block(?alloc, 0, ?b0i[0], 2);
    blocks[1] = t_block(?alloc, 1, ?b1i[0], 2);
    blocks[2] = t_block(?alloc, 2, ?b2i[0], 2);
    blocks[3] = t_block(?alloc, 3, ?b3i[0], 1);

    var f: lang_mir.MirFunction = t_fn(?alloc, ?blocks[0], 4, 3);
    val r: err[fail.Fail]       = rotate_function(?alloc, ?f);
    if (sel r.err) { ret 1; }

    if (f.blocks[0].instr_count != 3)                          { ret 2; }
    if (f.blocks[0].instrs[1].opcode != lang_mir.MIR_CMP_LT_S) { ret 2; }
    if (!t_ends_in_cbr_to(?f.blocks[0], 2, 3))                 { ret 2; }
    val guard: *lang_mir.MirInstr = ?f.blocks[0].instrs[1];
    if (guard.operands[0].vreg.n != 3) { ret 2; }

    # the entry binding first, then the header test's; the branch's flag renamed
    if (guard.dbg_binding_count != 2)    { ret 3; }
    if (guard.dbg_bindings[0].iid != 7)  { ret 4; }
    if (guard.dbg_bindings[0].vreg != 0) { ret 4; }
    if (guard.dbg_bindings[1].iid != 9)  { ret 5; }
    if (guard.dbg_bindings[1].vreg != 0) { ret 5; }
    val guard_br: *lang_mir.MirInstr = ?f.blocks[0].instrs[2];
    if (guard_br.dbg_binding_count != 1)    { ret 6; }
    if (guard_br.dbg_bindings[0].iid != 11) { ret 6; }
    if (guard_br.dbg_bindings[0].vreg != 3) { ret 6; }

    # the header keeps its own points unchanged
    val header: *lang_mir.MirInstr = ?f.blocks[1].instrs[0];
    if (header.dbg_binding_count != 1)    { ret 7; }
    if (header.dbg_bindings[0].iid != 9)  { ret 7; }
    if (header.dbg_bindings[0].vreg != 0) { ret 7; }
    val header_br: *lang_mir.MirInstr = ?f.blocks[1].instrs[1];
    if (header_br.dbg_binding_count != 1)    { ret 8; }
    if (header_br.dbg_bindings[0].iid != 11) { ret 8; }
    if (header_br.dbg_bindings[0].vreg != 2) { ret 8; }
    ret 0;
}

test rotate__a_memory_bound_test_is_copied_into_the_guard {
    var alloc: A.Allocator;
    page.make(?alloc);

    var mov: [2]lang_mir.MirOperand;
    mov[0] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    mov[1] = lang_mir.op_imm(0);
    var pbr: [1]lang_mir.MirOperand;
    pbr[0] = lang_mir.op_block(1);
    var b0i: [2]lang_mir.MirInstr;
    b0i[0] = t_instr(?alloc, lang_mir.MIR_MOV, ?mov[0], 2);
    b0i[1] = t_instr(?alloc, lang_mir.MIR_BR, ?pbr[0], 1);

    var ld: [2]lang_mir.MirOperand;
    ld[0] = lang_mir.op_vreg(lang_mir.vreg_id(2));
    ld[1] = lang_mir.op_mem_value(lang_mir.vreg_id(1), 0);
    var cmp: [3]lang_mir.MirOperand;
    cmp[0] = lang_mir.op_vreg(lang_mir.vreg_id(3));
    cmp[1] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    cmp[2] = lang_mir.op_vreg(lang_mir.vreg_id(2));
    var hcbr: [3]lang_mir.MirOperand;
    hcbr[0] = lang_mir.op_vreg(lang_mir.vreg_id(3));
    hcbr[1] = lang_mir.op_block(2);
    hcbr[2] = lang_mir.op_block(3);
    var b1i: [3]lang_mir.MirInstr;
    b1i[0] = t_instr(?alloc, lang_mir.MIR_LOAD, ?ld[0], 2);
    b1i[1] = t_instr(?alloc, lang_mir.MIR_CMP_LT_S, ?cmp[0], 3);
    b1i[2] = t_instr(?alloc, lang_mir.MIR_CBR, ?hcbr[0], 3);

    var inc: [3]lang_mir.MirOperand;
    inc[0] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    inc[1] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    inc[2] = lang_mir.op_imm(1);
    var lbr: [1]lang_mir.MirOperand;
    lbr[0] = lang_mir.op_block(1);
    var b2i: [2]lang_mir.MirInstr;
    b2i[0] = t_instr(?alloc, lang_mir.MIR_ADD, ?inc[0], 3);
    b2i[1] = t_instr(?alloc, lang_mir.MIR_BR, ?lbr[0], 1);

    var b3i: [1]lang_mir.MirInstr;
    b3i[0] = t_instr(?alloc, lang_mir.MIR_RET, nil, 0);

    var blocks: [4]lang_mir.MirBlock;
    blocks[0] = t_block(?alloc, 0, ?b0i[0], 2);
    blocks[1] = t_block(?alloc, 1, ?b1i[0], 3);
    blocks[2] = t_block(?alloc, 2, ?b2i[0], 2);
    blocks[3] = t_block(?alloc, 3, ?b3i[0], 1);

    var f: lang_mir.MirFunction = t_fn(?alloc, ?blocks[0], 4, 4);
    val r: err[fail.Fail]       = rotate_function(?alloc, ?f);
    if (sel r.err) { ret 1; }

    if (f.blocks[0].instr_count != 4)                          { ret 1; }
    if (f.blocks[0].instrs[1].opcode != lang_mir.MIR_LOAD)     { ret 1; }
    if (f.blocks[0].instrs[2].opcode != lang_mir.MIR_CMP_LT_S) { ret 1; }
    if (!t_ends_in_cbr_to(?f.blocks[0], 2, 3))                 { ret 1; }
    if (f.blocks[0].instrs[1].operands[0].vreg.n != 4)         { ret 1; }
    if (f.blocks[0].instrs[2].operands[2].vreg.n != 4)         { ret 1; }
    if (t_pred_count(?alloc, ?f, 1) != 1)                      { ret 1; }
    ret 0;
}

test rotate__declines_a_test_def_the_body_reads {
    var alloc: A.Allocator;
    page.make(?alloc);

    var mov: [2]lang_mir.MirOperand;
    mov[0] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    mov[1] = lang_mir.op_imm(0);
    var pbr: [1]lang_mir.MirOperand;
    pbr[0] = lang_mir.op_block(1);
    var b0i: [2]lang_mir.MirInstr;
    b0i[0] = t_instr(?alloc, lang_mir.MIR_MOV, ?mov[0], 2);
    b0i[1] = t_instr(?alloc, lang_mir.MIR_BR, ?pbr[0], 1);

    var cmp: [3]lang_mir.MirOperand;
    cmp[0] = lang_mir.op_vreg(lang_mir.vreg_id(2));
    cmp[1] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    cmp[2] = lang_mir.op_vreg(lang_mir.vreg_id(1));
    var hcbr: [3]lang_mir.MirOperand;
    hcbr[0] = lang_mir.op_vreg(lang_mir.vreg_id(2));
    hcbr[1] = lang_mir.op_block(2);
    hcbr[2] = lang_mir.op_block(3);
    var b1i: [2]lang_mir.MirInstr;
    b1i[0] = t_instr(?alloc, lang_mir.MIR_CMP_LT_S, ?cmp[0], 3);
    b1i[1] = t_instr(?alloc, lang_mir.MIR_CBR, ?hcbr[0], 3);

    var use: [3]lang_mir.MirOperand;
    use[0] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    use[1] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    use[2] = lang_mir.op_vreg(lang_mir.vreg_id(2));
    var lbr: [1]lang_mir.MirOperand;
    lbr[0] = lang_mir.op_block(1);
    var b2i: [2]lang_mir.MirInstr;
    b2i[0] = t_instr(?alloc, lang_mir.MIR_ADD, ?use[0], 3);
    b2i[1] = t_instr(?alloc, lang_mir.MIR_BR, ?lbr[0], 1);

    var b3i: [1]lang_mir.MirInstr;
    b3i[0] = t_instr(?alloc, lang_mir.MIR_RET, nil, 0);

    var blocks: [4]lang_mir.MirBlock;
    blocks[0] = t_block(?alloc, 0, ?b0i[0], 2);
    blocks[1] = t_block(?alloc, 1, ?b1i[0], 2);
    blocks[2] = t_block(?alloc, 2, ?b2i[0], 2);
    blocks[3] = t_block(?alloc, 3, ?b3i[0], 1);

    var f: lang_mir.MirFunction = t_fn(?alloc, ?blocks[0], 4, 3);
    val r: err[fail.Fail]       = rotate_function(?alloc, ?f);
    if (sel r.err) { ret 1; }

    if (f.blocks[0].instr_count != 2)     { ret 1; }
    if (!ends_in_br_to(?f.blocks[0], 1))  { ret 1; }
    if (t_pred_count(?alloc, ?f, 1) != 2) { ret 1; }
    ret 0;
}

test rotate__declines_two_entries {
    var alloc: A.Allocator;
    page.make(?alloc);

    var e0br: [1]lang_mir.MirOperand;
    e0br[0] = lang_mir.op_block(2);
    var b0i: [1]lang_mir.MirInstr;
    b0i[0] = t_instr(?alloc, lang_mir.MIR_BR, ?e0br[0], 1);

    var e1br: [1]lang_mir.MirOperand;
    e1br[0] = lang_mir.op_block(2);
    var b1i: [1]lang_mir.MirInstr;
    b1i[0] = t_instr(?alloc, lang_mir.MIR_BR, ?e1br[0], 1);

    var cmp: [3]lang_mir.MirOperand;
    cmp[0] = lang_mir.op_vreg(lang_mir.vreg_id(2));
    cmp[1] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    cmp[2] = lang_mir.op_vreg(lang_mir.vreg_id(1));
    var hcbr: [3]lang_mir.MirOperand;
    hcbr[0] = lang_mir.op_vreg(lang_mir.vreg_id(2));
    hcbr[1] = lang_mir.op_block(3);
    hcbr[2] = lang_mir.op_block(4);
    var b2i: [2]lang_mir.MirInstr;
    b2i[0] = t_instr(?alloc, lang_mir.MIR_CMP_LT_S, ?cmp[0], 3);
    b2i[1] = t_instr(?alloc, lang_mir.MIR_CBR, ?hcbr[0], 3);

    var inc: [3]lang_mir.MirOperand;
    inc[0] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    inc[1] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    inc[2] = lang_mir.op_imm(1);
    var lbr: [1]lang_mir.MirOperand;
    lbr[0] = lang_mir.op_block(2);
    var b3i: [2]lang_mir.MirInstr;
    b3i[0] = t_instr(?alloc, lang_mir.MIR_ADD, ?inc[0], 3);
    b3i[1] = t_instr(?alloc, lang_mir.MIR_BR, ?lbr[0], 1);

    var b4i: [1]lang_mir.MirInstr;
    b4i[0] = t_instr(?alloc, lang_mir.MIR_RET, nil, 0);

    var blocks: [5]lang_mir.MirBlock;
    blocks[0] = t_block(?alloc, 0, ?b0i[0], 1);
    blocks[1] = t_block(?alloc, 1, ?b1i[0], 1);
    blocks[2] = t_block(?alloc, 2, ?b2i[0], 2);
    blocks[3] = t_block(?alloc, 3, ?b3i[0], 2);
    blocks[4] = t_block(?alloc, 4, ?b4i[0], 1);

    var f: lang_mir.MirFunction = t_fn(?alloc, ?blocks[0], 5, 3);
    val r: err[fail.Fail]       = rotate_function(?alloc, ?f);
    if (sel r.err) { ret 1; }

    if (f.blocks[0].instr_count != 1)     { ret 1; }
    if (f.blocks[1].instr_count != 1)     { ret 1; }
    if (t_pred_count(?alloc, ?f, 2) != 3) { ret 1; }
    ret 0;
}
