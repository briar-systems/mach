use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.intern;
use mach.lang.be.codegen.mir;
use mach.lang.be.codegen.mir.context;
use mach.lang.me.ir;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.target.abi;
use mach.lang.target.isa;
use treg: mach.lang.target;
use target_testing: mach.lang.target.testing;
use target: mach.lang.target.resolved;
use semtype: mach.lang.type;

val CONV_COUNT: u32 = 7;
val CONV_ARCH: [7]str = [7]str{"x86_64", "x86_64", "x86_64", "aarch64", "riscv64", "riscv32", "spirv"};
val CONV_OS:   [7]str = [7]str{"linux", "windows", "darwin", "linux", "linux", "freestanding", "freestanding"};
val CONV_ABI:  [7]str = [7]str{"sysv64", "win64", "sysv64", "aapcs64", "lp64d", "ilp32d", "spirv"};

val MAX_GP_ARG_REGS: i32 = 16;

pub fun require_abi(tgt: *target.Target) R.Result[R.Void, str] {
    if (tgt == nil)     { ret R.err[R.Void, str]("mir.lower_ir: nil target"); }
    if (tgt.abi == nil) { ret R.err[R.Void, str]("mir.lower_ir: target has no ABI vtable"); }
    if (tgt.isa == nil) { ret R.err[R.Void, str]("mir.lower_ir: target has no ISA vtable"); }
    if (tgt.abi.arg_passing == nil || tgt.abi.ret_passing == nil) {
        ret R.err[R.Void, str]("mir.lower_ir: ABI vtable exposes no arg/ret classifier");
    }
    ret R.ok_void[str]();
}

pub fun abi_gp_arg_reg(tgt: *target.Target, index: i32, out: *i32) R.Result[R.Void, str] {
    if (tgt.abi.gp_arg_regs == nil) {
        ret R.err[R.Void, str]("mir.lower_ir: ABI vtable exposes no GP argument register file");
    }
    var regs: [16]isa.Register;
    val n: i32 = tgt.abi.gp_arg_regs(?regs[0]);
    if (index < 0 || index >= n || index >= MAX_GP_ARG_REGS) {
        ret R.err[R.Void, str]("mir.lower_ir: GP argument register index out of range");
    }
    @out = regs[index].id;
    ret R.ok_void[str]();
}

pub fun abi_va_model(tgt: *target.Target, out: *abi.VaModel) R.Result[R.Void, str] {
    if (tgt.abi.va_model == nil) {
        ret R.err[R.Void, str]("mir.lower_ir: a variadic call is not supported by this calling convention (no variadic save model)");
    }
    @out = tgt.abi.va_model();
    ret R.ok_void[str]();
}

val EB_NO_CLASS: u8 = 0;
val EB_SSE:      u8 = 1;
val EB_INTEGER:  u8 = 2;

fun mark_eightbyte_range(classes: *u8, off: u64, size: u64, cls: u8) {
    if (size == 0) { ret; }
    var i:    u64 = off / 8;
    val last: u64 = (off + size - 1) / 8;
    for (i <= last) {
        if (i < 2 && cls > classes[i]) { classes[i] = cls; }
        i = i + 1;
    }
}

val AGG_LEAF_CAP: u32 = 16;

fun collect_leaves(ctx: *context.LowerCtx, ty: type.IrTypeId, base_off: u64, strict: bool,
                   out: *abi.AggField, cap: u32, count: u32) u32 {
    if (count > cap) { ret count; }
    val it: O.Option[*type.IrType] = type.get(ctx.types, ty);
    if (!O.is_some[*type.IrType](it)) {
        if (strict) { ret cap + 1; }
        ret count;
    }
    val t: *type.IrType = O.unwrap[*type.IrType](it);

    if (t.kind == type.IRT_STRUCT) {
        var c: u32 = count;
        var i: u32 = 0;
        for (i < t.data.struct_.field_count) {
            val fo: u64 = type.byte_offset_for_machine(ctx.types, ty, i, ctx.layout)::u64;
            c = collect_leaves(ctx, t.data.struct_.fields[i], base_off + fo, strict, out, cap, c);
            if (strict && c > cap) { ret c; }
            i = i + 1;
        }
        ret c;
    }
    if (t.kind == type.IRT_ARRAY) {
        val elem: type.IrTypeId = t.data.array_.element;
        val es:   u64 = type.byte_size_for_machine(ctx.types, elem, ctx.layout)::u64;
        val n:    u32 = type.array_count(ctx.types, ty);
        var c: u32 = count;
        var i: u32 = 0;
        for (i < n) {
            c = collect_leaves(ctx, elem, base_off + i::u64 * es, strict, out, cap, c);
            if (strict && c > cap) { ret c; }
            i = i + 1;
        }
        ret c;
    }
    if (t.kind == type.IRT_UNION) {
        if (strict) { ret cap + 1; }
        var c: u32 = count;
        var i: u32 = 0;
        for (i < t.data.struct_.field_count) {
            c = collect_leaves(ctx, t.data.struct_.fields[i], base_off, strict, out, cap, c);
            i = i + 1;
        }
        ret c;
    }

    if (count < cap) {
        out[count].is_float = t.kind == type.IRT_FLOAT;
        out[count].offset   = base_off::u32;
        out[count].width    = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u8;
    }
    ret count + 1;
}

fun aggregate_sse_mask(ctx: *context.LowerCtx, ty: type.IrTypeId) u8 {
    if (!context.value_is_aggregate(ctx, ty)) { ret 0; }
    val size: u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    if (size == 0 || size > 16) { ret 0; }
    var leaves: [16]abi.AggField;
    val n: u32 = collect_leaves(ctx, ty, 0, false, ?leaves[0], AGG_LEAF_CAP, 0);
    var classes: [2]u8;
    classes[0] = EB_NO_CLASS;
    classes[1] = EB_NO_CLASS;
    var i: u32 = 0;
    for (i < n) {
        var cls: u8 = EB_INTEGER;
        if (leaves[i].is_float) { cls = EB_SSE; }
        mark_eightbyte_range(?classes[0], leaves[i].offset::u64, leaves[i].width::u64, cls);
        i = i + 1;
    }
    var mask: u8 = 0;
    if (classes[0] == EB_SSE) { mask = mask | 1; }
    if (classes[1] == EB_SSE) { mask = mask | 2; }
    ret mask;
}

fun hfa_walk(ctx: *context.LowerCtx, ty: type.IrTypeId, out_elem: *u32, out_count: *u32) bool {
    val it: O.Option[*type.IrType] = type.get(ctx.types, ty);
    if (!O.is_some[*type.IrType](it)) { ret false; }
    val t: *type.IrType = O.unwrap[*type.IrType](it);

    if (t.kind == type.IRT_FLOAT) {
        @out_elem  = type.byte_size_for_machine(ctx.types, ty, ctx.layout);
        @out_count = 1;
        ret true;
    }
    if (t.kind == type.IRT_ARRAY) {
        var ee: u32 = 0;
        var ec: u32 = 0;
        if (!hfa_walk(ctx, t.data.array_.element, ?ee, ?ec)) { ret false; }
        @out_elem  = ee;
        @out_count = ec * type.array_count(ctx.types, ty);
        ret true;
    }
    if (t.kind == type.IRT_STRUCT) {
        var elem:  u32 = 0;
        var total: u32 = 0;
        var i:     u32 = 0;
        for (i < t.data.struct_.field_count) {
            var fe: u32 = 0;
            var fc: u32 = 0;
            if (!hfa_walk(ctx, t.data.struct_.fields[i], ?fe, ?fc)) { ret false; }
            if (elem == 0) { elem = fe; } or (elem != fe)           { ret false; }
            total = total + fc;
            i = i + 1;
        }
        if (total == 0) { ret false; }
        @out_elem  = elem;
        @out_count = total;
        ret true;
    }
    if (t.kind == type.IRT_UNION) {
        var elem: u32 = 0;
        var maxc: u32 = 0;
        var i:    u32 = 0;
        for (i < t.data.struct_.field_count) {
            var me: u32 = 0;
            var mc: u32 = 0;
            if (!hfa_walk(ctx, t.data.struct_.fields[i], ?me, ?mc)) { ret false; }
            if (elem == 0) { elem = me; } or (elem != me)           { ret false; }
            if (mc > maxc)                                          { maxc = mc; }
            i = i + 1;
        }
        if (elem == 0) { ret false; }
        @out_elem  = elem;
        @out_count = maxc;
        ret true;
    }
    ret false;
}

fun hfa_info(ctx: *context.LowerCtx, ty: type.IrTypeId, out_members: *u8, out_elem: *u8) {
    @out_members = 0;
    @out_elem    = 0;
    if (!context.value_is_aggregate(ctx, ty)) { ret; }
    var elem:  u32 = 0;
    var count: u32 = 0;
    if (!hfa_walk(ctx, ty, ?elem, ?count)) { ret; }
    if (count < 1 || count > 4)            { ret; }
    if (elem != 4 && elem != 8) { ret; }
    @out_members = count::u8;
    @out_elem    = elem::u8;
}

val AGG_MAX_LEAVES: u32 = 2;

fun agg_layout(ctx: *context.LowerCtx, ty: type.IrTypeId, is_aggr: bool) abi.AggLayout {
    var out: abi.AggLayout;
    out.field_count = 0;
    if (!is_aggr) { ret out; }
    val n: u32 = collect_leaves(ctx, ty, 0, true, ?out.fields[0], AGG_MAX_LEAVES, 0);
    if (n == 1 || n == 2) { out.field_count = n::u8; }
    ret out;
}

fun advance_arg_cursors(slot: *abi.ParamSlot, gp_used: *i32, fp_used: *i32) {
    if (slot.class == abi.CLASS_AGG) {
        @gp_used = @gp_used + 1;
        ret;
    }
    var i: u32 = 0;
    for (i < slot.piece_count) {
        val k: abi.PieceKind = slot.pieces[i].kind;
        if (k == abi.PIECE_GP) {
            @gp_used = @gp_used + 1;
        } or (k == abi.PIECE_FP) {
            @fp_used = @fp_used + 1;
        }
        i = i + 1;
    }
}

fun slot_has_stack_piece(slot: *abi.ParamSlot) bool {
    var i: u32 = 0;
    for (i < slot.piece_count) {
        if (slot.pieces[i].kind == abi.PIECE_STACK) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun split_stack_bytes(tgt: *target.Target, slot: *abi.ParamSlot) i64 {
    var total: i64 = 0;
    var i: u32 = 0;
    for (i < slot.piece_count) {
        if (slot.pieces[i].kind == abi.PIECE_STACK) {
            total = total + context.stack_slot_bytes(tgt, slot.pieces[i].width::u64);
        }
        i = i + 1;
    }
    ret total;
}

fun sret_reserves_gp(ret_class: abi.ParamClass, in_argfile: bool) bool {
    ret ret_class == abi.CLASS_SRET && in_argfile;
}

fun round_up_i64(value: i64, align: u64) i64 {
    if (align <= 1) { ret value; }
    val a:   i64 = align::i64;
    val rem: i64 = value % a;
    if (rem == 0) { ret value; }
    ret value + (a - rem);
}

fun stack_arg_align(tgt: *target.Target, class: abi.ParamClass, align: u64, natural: bool) u64 {
    val ptr:  u64 = tgt.model.pointer_width::u64;
    val word: u64 = tgt.model.gpr_width::u64;
    if (class == abi.CLASS_STACK_BYREF)     { ret ptr; }
    if (class == abi.CLASS_VEC_STACK_BYREF) { ret ptr; }
    if (natural)                            { ret align; }
    if (align < word)                       { ret word; }
    ret align;
}

fun stack_arg_bytes(tgt: *target.Target, size: u64, natural: bool) i64 {
    if (natural) { ret size::i64; }
    ret context.stack_slot_bytes(tgt, size);
}

fun natural_stack_slot(tgt: *target.Target, variadic: bool) bool {
    if (variadic) { ret false; }
    ret tgt.fixed_args_natural_size;
}

fun stack_only_tail_slot(slot: abi.ParamSlot) abi.ParamSlot {
    if (is_stack_slot_class(slot.class)) { ret slot; }
    if (slot.class == abi.CLASS_BYREF) {
        ret abi.make_slot(abi.CLASS_STACK_BYREF, -1, 0, slot.size, 0);
    }
    if (slot.class == abi.CLASS_VEC_BYREF) {
        ret abi.make_slot_indirect(abi.CLASS_VEC_STACK_BYREF, -1, 0, slot.size,
                                   slot.indirect_size, slot.indirect_align);
    }
    ret abi.make_slot(abi.CLASS_STACK, -1, 0, slot.size, 0);
}

fun is_stack_slot_class(class: abi.ParamClass) bool {
    ret class == abi.CLASS_STACK || class == abi.CLASS_STACK_BYREF || class == abi.CLASS_VEC_STACK_BYREF;
}

pub fun classify_signature(ctx: *context.LowerCtx, sig: type.IrTypeId, ret_type: type.IrTypeId,
                           out: *abi.SigLayout) R.Result[R.Void, str] {
    val rok: R.Result[R.Void, str] = require_abi(ctx.tgt);
    if (R.is_err[R.Void, str](rok)) { ret rok; }

    val classify_arg: abi.ArgPassingFn = ctx.tgt.abi.arg_passing;
    val classify_ret: abi.RetPassingFn = ctx.tgt.abi.ret_passing;

    out.params      = nil;
    out.param_count = 0;

    val ret_size:  u64  = type.byte_size_for_machine(ctx.types, ret_type, ctx.layout)::u64;
    val ret_float: bool = context.value_is_float(ctx, ret_type);
    val ret_aggr:  bool = context.value_is_aggregate(ctx, ret_type);
    val ret_vec:   bool = context.value_is_vector(ctx, ret_type);
    val ret_eb:    u8   = aggregate_sse_mask(ctx, ret_type);
    var ret_hm:    u8   = 0;
    var ret_he:    u8   = 0;
    hfa_info(ctx, ret_type, ?ret_hm, ?ret_he);
    val wants_agg: bool = ctx.tgt.abi.consumes_agg_layout;
    var ret_agg: abi.AggLayout = abi.agg_none();
    if (wants_agg) { ret_agg = agg_layout(ctx, ret_type, ret_aggr); }
    out.ret_slot = classify_ret(ret_size, 0, ret_float, ret_eb, ret_aggr, ret_vec, ret_hm, ret_he, ret_agg);

    val fixed_natural: bool = natural_stack_slot(ctx.tgt, false);

    var gp_used:   i32 = 0;
    var fp_used:   i32 = 0;
    var stack_off: i64 = ctx.tgt.abi.shadow_space::i64;

    if (sret_reserves_gp(out.ret_slot.class, ctx.tgt.abi.indirect_result_in_argfile)) {
        gp_used = 1;
    }

    val opt_sig: O.Option[*type.IrType] = type.get(ctx.types, sig);
    var is_fn:   bool = false;
    if (O.is_some[*type.IrType](opt_sig)) {
        val st: *type.IrType = O.unwrap[*type.IrType](opt_sig);
        is_fn = st.kind == type.IRT_FN;
    }
    if (!is_fn) {
        out.gp_used   = gp_used;
        out.fp_used   = fp_used;
        out.stack_off = stack_off;
        ret R.ok_void[str]();
    }
    val t: *type.IrType = O.unwrap[*type.IrType](opt_sig);

    val pc: u32 = t.data.fn.param_count;
    var slots: *abi.ParamSlot = nil;
    if (pc > 0) {
        val sb: R.Result[*abi.ParamSlot, str] = A.allocate[abi.ParamSlot](ctx.alloc, pc::usize);
        if (R.is_err[*abi.ParamSlot, str](sb)) { ret R.err[R.Void, str](R.unwrap_err[*abi.ParamSlot, str](sb)); }
        slots = R.unwrap_ok[*abi.ParamSlot, str](sb);
    }

    var i: u32 = 0;
    for (i < pc) {
        val pty:  type.IrTypeId = t.data.fn.params[i];
        val psz:  u64  = type.byte_size_for_machine(ctx.types, pty, ctx.layout)::u64;
        val pal:  u64  = type.byte_align_for_machine(ctx.types, pty, ctx.layout)::u64;
        val pfl:  bool = context.value_is_float(ctx, pty);
        val pag:  bool = context.value_is_aggregate(ctx, pty);
        val peb:  u8   = aggregate_sse_mask(ctx, pty);
        var phm:  u8   = 0;
        var phe:  u8   = 0;
        hfa_info(ctx, pty, ?phm, ?phe);
        var pagg: abi.AggLayout = abi.agg_none();
        if (wants_agg) { pagg = agg_layout(ctx, pty, pag); }
        val pvec: bool = context.value_is_vector(ctx, pty);
        var slot: abi.ParamSlot = classify_arg(i::i32, psz, pal, pfl, peb, pag, pvec, gp_used, fp_used, phm, phe, pagg);

        if (is_stack_slot_class(slot.class)) {
            stack_off   = round_up_i64(stack_off, stack_arg_align(ctx.tgt, slot.class, pal, fixed_natural));
            slot.offset = stack_off;
            stack_off   = stack_off + stack_arg_bytes(ctx.tgt, slot.size, fixed_natural);
        } or {
            advance_arg_cursors(?slot, ?gp_used, ?fp_used);
            if (slot_has_stack_piece(?slot)) {
                stack_off   = round_up_i64(stack_off, ctx.tgt.model.gpr_width::u64);
                slot.offset = stack_off;
                stack_off   = stack_off + split_stack_bytes(ctx.tgt, ?slot);
            }
        }

        slots[i] = slot;
        i = i + 1;
    }

    out.params      = slots;
    out.param_count = pc;
    out.gp_used     = gp_used;
    out.fp_used     = fp_used;
    out.stack_off   = stack_off;
    ret R.ok_void[str]();
}

pub fun sig_layout_free(ctx: *context.LowerCtx, layout: *abi.SigLayout) {
    if (layout.params != nil && layout.param_count > 0) {
        A.deallocate[abi.ParamSlot](ctx.alloc, layout.params, layout.param_count::usize);
        layout.params      = nil;
        layout.param_count = 0;
    }
}

fun call_ret_type(ctx: *context.LowerCtx, sig: type.IrTypeId, fallback: type.IrTypeId) type.IrTypeId {
    val opt: O.Option[*type.IrType] = type.get(ctx.types, sig);
    if (O.is_some[*type.IrType](opt)) {
        val st: *type.IrType = O.unwrap[*type.IrType](opt);
        if (st.kind == type.IRT_FN && context.value_is_vector(ctx, st.data.fn.ret_type)) {
            ret st.data.fn.ret_type;
        }
    }
    ret fallback;
}

pub fun lower_call(ctx: *context.LowerCtx, mb: *mir.MirBlock, inst: *instruction.Instruction, iid: id.InstructionId) R.Result[R.Void, str] {
    if (inst.operand_count == 0) {
        ret R.err[R.Void, str]("mir.lower_ir: call with no callee operand");
    }
    val rok: R.Result[R.Void, str] = require_abi(ctx.tgt);
    if (R.is_err[R.Void, str](rok)) { ret rok; }

    var pending_registers: mir.MirBlock;
    fin { mir.dnit_block(ctx.alloc, ?pending_registers); }
    var registers: *mir.MirBlock = mb;
    if (ctx.tgt.model.flat_addressing) { registers = ?pending_registers; }

    val classify_arg: abi.ArgPassingFn = ctx.tgt.abi.arg_passing;

    val sig: type.IrTypeId = inst.aux_ty;
    val ret_type: type.IrTypeId = call_ret_type(ctx, sig, inst.ty);
    var layout: abi.SigLayout;
    val cls: R.Result[R.Void, str] = classify_signature(ctx, sig, ret_type, ?layout);
    if (R.is_err[R.Void, str](cls)) { ret cls; }

    val rslot: abi.ParamSlot = layout.ret_slot;

    val sig_it:    O.Option[*type.IrType] = type.get(ctx.types, sig);
    var sig_is_fn: bool = false;
    var sig_is_va: bool = false;
    if (O.is_some[*type.IrType](sig_it)) {
        val sig_t: *type.IrType = O.unwrap[*type.IrType](sig_it);
        sig_is_fn = sig_t.kind == type.IRT_FN;
        sig_is_va = sig_is_fn && sig_t.data.fn.variadic;
    }
    val variadic_call: bool = !sig_is_fn || sig_is_va || ((inst.operand_count - 1) > layout.param_count);

    val ret_size:  u64 = type.byte_size_for_machine(ctx.types, ret_type, ctx.layout)::u64;
    val ret_aggr:  bool = context.value_is_aggregate(ctx, ret_type);
    val ret_vector_register: bool = context.value_is_vector(ctx, inst.ty);
    val ret_mem:   bool = ret_aggr || (context.value_is_vector(ctx, ret_type) && !ret_vector_register && rslot.class == abi.CLASS_SRET);
    val ret_sret_register: bool = rslot.class == abi.CLASS_SRET && !ret_mem;

    var gp_used:   i32 = layout.gp_used;
    var fp_used:   i32 = layout.fp_used;
    var stack_off: i64 = layout.stack_off;

    val res_dst: u32 = context.instr_vreg(ctx, iid);
    var sret_ptr: u32 = mir.MIR_VREG_NIL;
    if (ret_mem && res_dst != mir.MIR_VREG_NIL) {
        var ra: R.Result[R.Void, str] = R.ok_void[str]();
        if (rslot.class == abi.CLASS_AGG) {
            ra = context.alloc_object_storage(ctx, mb, res_dst, ret_type);
        } or {
            var owned_size: u64 = ret_size;
            if (rslot.class != abi.CLASS_SRET) {
                val extent: R.Result[u64, str] = abi.carrier_storage_extent(?rslot);
                if (R.is_err[u64, str](extent)) {
                    sig_layout_free(ctx, ?layout);
                    ret R.err[R.Void, str](R.unwrap_err[u64, str](extent));
                }
                owned_size = R.unwrap_ok[u64, str](extent);
            }
            ra = context.alloc_result_storage(ctx, mb, res_dst, owned_size, context.ret_align(ctx, ret_type));
        }
        if (R.is_err[R.Void, str](ra)) {
            sig_layout_free(ctx, ?layout);
            ret ra;
        }
        sret_ptr = res_dst;
    }
    or (ret_sret_register && res_dst != mir.MIR_VREG_NIL) {
        val sa: R.Result[u32, str] = context.new_vreg(ctx, mir.REG_CLASS_GP);
        if (R.is_err[u32, str](sa)) {
            sig_layout_free(ctx, ?layout);
            ret R.err[R.Void, str](R.unwrap_err[u32, str](sa));
        }
        sret_ptr = R.unwrap_ok[u32, str](sa);
        val ra: R.Result[R.Void, str] = context.alloc_result_storage(ctx, mb, sret_ptr, ret_size, context.ret_align(ctx, ret_type));
        if (R.is_err[R.Void, str](ra)) {
            sig_layout_free(ctx, ?layout);
            ret ra;
        }
    }

    if (rslot.class == abi.CLASS_SRET) {
        if (sret_ptr != mir.MIR_VREG_NIL) {
            val sret_reg: i32 = ctx.tgt.abi.indirect_result_reg;
            val pre: R.Result[R.Void, str] = context.emit_mov_w(ctx, registers,
                mir.op_preg(sret_reg::u32), mir.op_vreg(sret_ptr), ptr_move_width(ctx));
            if (R.is_err[R.Void, str](pre)) {
                sig_layout_free(ctx, ?layout);
                ret pre;
            }
        }
    }

    var i: u32 = 1;
    for (i < inst.operand_count) {
        val av:   value.Value = inst.operands[i];
        val pidx: u32  = i - 1;
        val asz:  u64  = type.byte_size_for_machine(ctx.types, av.ty, ctx.layout)::u64;
        val aag:  bool = context.value_is_aggregate(ctx, av.ty);
        var slot: abi.ParamSlot;
        var soff: i64 = 0;
        if (pidx < layout.param_count) {
            slot = layout.params[pidx];
            soff = slot.offset;
        } or {
            val aal: u64  = type.byte_align_for_machine(ctx.types, av.ty, ctx.layout)::u64;
            var afl: bool = context.value_is_float(ctx, av.ty);
            val avec: bool = context.value_is_vector(ctx, av.ty);
            if (afl) {
                var vafl: abi.VaModel;
                val vfr: R.Result[R.Void, str] = abi_va_model(ctx.tgt, ?vafl);
                if (R.is_err[R.Void, str](vfr)) {
                    sig_layout_free(ctx, ?layout);
                    ret vfr;
                }
                if (!abi.variadic_float_in_fp_bank(?vafl, asz)) { afl = false; }
            }
            slot = classify_arg(pidx::i32, asz, aal, afl, 0, aag, avec, gp_used, fp_used, 0, 0, abi.agg_none());
            if (ctx.tgt.variadic_args_on_stack) { slot = stack_only_tail_slot(slot); }
            if (is_stack_slot_class(slot.class)) {
                stack_off = round_up_i64(stack_off, stack_arg_align(ctx.tgt, slot.class, aal, false));
            } or (slot_has_stack_piece(?slot)) {
                stack_off = round_up_i64(stack_off, ctx.tgt.model.gpr_width::u64);
            }
            soff = stack_off;
        }

        val aor: R.Result[mir.MirOperand, str] = lower_value_addr(ctx, mb, av);
        if (R.is_err[mir.MirOperand, str](aor)) {
            sig_layout_free(ctx, ?layout);
            ret R.err[R.Void, str](R.unwrap_err[mir.MirOperand, str](aor));
        }
        val argop: mir.MirOperand = R.unwrap_ok[mir.MirOperand, str](aor);

        val er: R.Result[R.Void, str] = emit_arg_slot(ctx, mb, registers, slot, argop, soff, aag, av.ty,
                                                    natural_stack_slot(ctx.tgt, pidx >= layout.param_count));
        if (R.is_err[R.Void, str](er)) {
            sig_layout_free(ctx, ?layout);
            ret er;
        }

        if (pidx >= layout.param_count && slot.class == abi.CLASS_FP) {
            var vamodel: abi.VaModel;
            val vmr: R.Result[R.Void, str] = abi_va_model(ctx.tgt, ?vamodel);
            if (R.is_err[R.Void, str](vmr)) {
                sig_layout_free(ctx, ?layout);
                ret vmr;
            }
            if (vamodel.float_dup_gp) {
                var dup_reg: i32 = 0;
                val dr: R.Result[R.Void, str] = abi_gp_arg_reg(ctx.tgt, gp_used + fp_used, ?dup_reg);
                if (R.is_err[R.Void, str](dr)) {
                    sig_layout_free(ctx, ?layout);
                    ret dr;
                }
                val dm: R.Result[R.Void, str] = emit_call_reg(ctx, mb, registers, mir.op_preg(dup_reg::u32), argop, ctx.tgt.model.gpr_width::u8);
                if (R.is_err[R.Void, str](dm)) {
                    sig_layout_free(ctx, ?layout);
                    ret dm;
                }
            }
        }

        if (pidx >= layout.param_count) {
            if (is_stack_slot_class(slot.class)) {
                stack_off = stack_off + stack_arg_bytes(ctx.tgt, slot.size, false);
            } or {
                advance_arg_cursors(?slot, ?gp_used, ?fp_used);
                if (slot_has_stack_piece(?slot)) {
                    stack_off = stack_off + split_stack_bytes(ctx.tgt, ?slot);
                }
            }
        }

        i = i + 1;
    }

    sig_layout_free(ctx, ?layout);

    record_outgoing_size(ctx, stack_off);

    if (variadic_call) {
        var vamodel: abi.VaModel;
        val vmr: R.Result[R.Void, str] = abi_va_model(ctx.tgt, ?vamodel);
        if (R.is_err[R.Void, str](vmr)) { ret vmr; }
        if (vamodel.vector_count_reg >= 0) {
            val al: R.Result[R.Void, str] = context.emit_mov_w(ctx, registers,
                mir.op_preg(vamodel.vector_count_reg::u32), mir.op_imm(fp_used::i64), 4::u8);
            if (R.is_err[R.Void, str](al)) { ret al; }
        }
    }

    val placed: R.Result[R.Void, str] = place_call_registers(ctx, mb, ?pending_registers);
    if (R.is_err[R.Void, str](placed)) { ret placed; }

    val rcall: R.Result[*mir.MirOperand, str] = A.allocate[mir.MirOperand](ctx.alloc, 1::usize);
    if (R.is_err[*mir.MirOperand, str](rcall)) { ret R.err[R.Void, str](R.unwrap_err[*mir.MirOperand, str](rcall)); }
    val callops: *mir.MirOperand = R.unwrap_ok[*mir.MirOperand, str](rcall);
    callops[0] = context.lower_value(ctx, inst.operands[0]);
    var cmi: mir.MirInstr = mir.instr(mir.MIR_CALL, callops, 1,
                                      ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
    val pc: R.Result[R.Void, str] = context.push_instr(ctx, mb, cmi);
    if (R.is_err[R.Void, str](pc)) { ret pc; }

    val dst: u32 = context.instr_vreg(ctx, iid);
    if (dst != mir.MIR_VREG_NIL && rslot.class != abi.CLASS_SRET) {
        val rr: R.Result[R.Void, str] = emit_ret_slot_to_vreg(ctx, mb, rslot, dst, ret_aggr, ret_type);
        if (R.is_err[R.Void, str](rr)) { ret rr; }
    }
    if (ret_sret_register && dst != mir.MIR_VREG_NIL) {
        var lr: R.Result[R.Void, str] = R.ok_void[str]();
        if (ret_vector_register) {
            lr = context.load_subwidth_vector(ctx, mb, mir.op_vreg(dst), mir.op_mem_value(sret_ptr, 0), ret_type);
        } or {
            lr = context.emit_load_from_w(ctx, mb, dst, mir.op_mem_value(sret_ptr, 0), ret_size::u8);
        }
        if (R.is_err[R.Void, str](lr)) { ret lr; }
    }
    if (dst != mir.MIR_VREG_NIL) {
        val rres: R.Result[*mir.MirOperand, str] = A.allocate[mir.MirOperand](ctx.alloc, 1::usize);
        if (R.is_err[*mir.MirOperand, str](rres)) { ret R.err[R.Void, str](R.unwrap_err[*mir.MirOperand, str](rres)); }
        val resops: *mir.MirOperand = R.unwrap_ok[*mir.MirOperand, str](rres);
        resops[0] = mir.op_vreg(dst);
        var rmi: mir.MirInstr = mir.instr(mir.MIR_CALL_RES, resops, 1,
                                          ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
        val pr: R.Result[R.Void, str] = context.push_instr(ctx, mb, rmi);
        if (R.is_err[R.Void, str](pr)) { ret pr; }
    }

    ret R.ok_void[str]();
}


fun emit_call_reg(ctx: *context.LowerCtx, preparation: *mir.MirBlock, registers: *mir.MirBlock,
                  dst: mir.MirOperand, src: mir.MirOperand, width: u8) R.Result[R.Void, str] {
    var value: mir.MirOperand = src;
    if (registers != preparation && src.kind == mir.MIR_OP_MEM) {
        val class: u32 = isa.regid_class(dst.preg::i32)::u32;
        val rv: R.Result[u32, str] = context.new_vreg_vec(ctx, class, class != mir.REG_CLASS_GP && width > 8);
        if (R.is_err[u32, str](rv)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](rv)); }
        val v: u32 = R.unwrap_ok[u32, str](rv);
        ctx.f.vregs[v].secret = ctx.cur_writes_secret;
        val loaded: R.Result[R.Void, str] = context.emit_mov_w(ctx, preparation, mir.op_vreg(v), src, width);
        if (R.is_err[R.Void, str](loaded)) { ret loaded; }
        value = mir.op_vreg(v);
    }
    ret context.emit_mov_w(ctx, registers, dst, value, width);
}

fun place_call_registers(ctx: *context.LowerCtx, mb: *mir.MirBlock, registers: *mir.MirBlock) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < registers.instr_count) {
        val grown: R.Result[R.Void, str] = context.grow_instr(ctx, mb);
        if (R.is_err[R.Void, str](grown)) { ret grown; }
        mb.instrs[mb.instr_count] = registers.instrs[i];
        mb.instr_count = mb.instr_count + 1;
        registers.instrs[i].operands = nil;
        registers.instrs[i].operand_count = 0;
        registers.instrs[i].dbg_bindings = nil;
        registers.instrs[i].dbg_binding_count = 0;
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun lower_value_addr(ctx: *context.LowerCtx, mb: *mir.MirBlock, v: value.Value) R.Result[mir.MirOperand, str] {
    val op: mir.MirOperand = context.lower_value(ctx, v);
    if (op.kind != mir.MIR_OP_SYM || !ctx.tgt.model.flat_addressing) { ret R.ok[mir.MirOperand, str](op); }
    var addr: u32 = mir.MIR_VREG_NIL;
    val ar: R.Result[R.Void, str] = context.addr_to_vreg(ctx, mb, op, ?addr);
    if (R.is_err[R.Void, str](ar)) { ret R.err[mir.MirOperand, str](R.unwrap_err[R.Void, str](ar)); }
    ret R.ok[mir.MirOperand, str](mir.op_vreg(addr));
}

rec PiecePlan {
    store:      bool;
    registers:  *mir.MirBlock;
    mem_base:   u32;
    mem_slot:   bool;
    stack_base: u32;
    stack_off:  i64;
    stack_ok:   bool;
    owned_extent: u64;
}

fun load_piece_carrier(ctx: *context.LowerCtx, mb: *mir.MirBlock, registers: *mir.MirBlock,
                       reg: mir.MirOperand, source: mir.MirOperand,
                       logical_width: u8, carrier_width: u8) R.Result[R.Void, str] {
    if (logical_width == carrier_width) {
        ret emit_call_reg(ctx, mb, registers, reg, source, carrier_width);
    }
    val kr: R.Result[u32, str] = context.new_vreg(ctx, mir.REG_CLASS_GP);
    if (R.is_err[u32, str](kr)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](kr)); }
    val key: u32 = R.unwrap_ok[u32, str](kr);
    val ar: R.Result[R.Void, str] = context.add_alloca_slot(ctx, key,
        carrier_width::u64, carrier_width::u32, mir.SLOT_TY_NIL);
    if (R.is_err[R.Void, str](ar)) { ret ar; }
    var off: u64 = 0;
    for (off < carrier_width::u64) {
        val width: u8 = context.copy_chunk_width(ctx.tgt, carrier_width::u64 - off);
        val zero: R.Result[R.Void, str] = context.push_store_chunk(ctx, mb,
            mir.op_mem_slot(key, off::i64), mir.op_imm(0), width);
        if (R.is_err[R.Void, str](zero)) { ret zero; }
        off = off + width::u64;
    }
    val copied: R.Result[R.Void, str] = context.copy_aggregate(ctx, mb,
        mir.op_mem_slot(key, 0), source, logical_width::u64);
    if (R.is_err[R.Void, str](copied)) { ret copied; }
    ret emit_call_reg(ctx, mb, registers, reg, mir.op_mem_slot(key, 0), carrier_width);
}

fun materialize_pieces(ctx: *context.LowerCtx, mb: *mir.MirBlock, slot: abi.ParamSlot, plan: PiecePlan) R.Result[R.Void, str] {
    val er: R.Result[u64, str] = abi.carrier_storage_extent(?slot);
    if (R.is_err[u64, str](er)) { ret R.err[R.Void, str](R.unwrap_err[u64, str](er)); }
    if (plan.store && plan.owned_extent < R.unwrap_ok[u64, str](er)) {
        ret R.err[R.Void, str]("mir.abi: carrier stores exceed owned destination storage");
    }
    var pending: mir.MirBlock;
    fin { mir.dnit_block(ctx.alloc, ?pending); }
    var registers: *mir.MirBlock = plan.registers;
    if (!plan.store && registers == mb) { registers = ?pending; }
    var i: u32 = 0;
    for (i < slot.piece_count) {
        val p: abi.ParamPiece = slot.pieces[i];
        val wr: R.Result[u8, str] = abi.piece_memory_width(?slot, ?slot.pieces[i]);
        if (R.is_err[u8, str](wr)) { ret R.err[R.Void, str](R.unwrap_err[u8, str](wr)); }
        val logical_width: u8 = R.unwrap_ok[u8, str](wr);
        var mem: mir.MirOperand = mir.op_mem_value(plan.mem_base, p.src_off);
        if (plan.mem_slot) { mem = mir.op_mem_slot(plan.mem_base, p.src_off); }
        if (p.kind == abi.PIECE_STACK) {
            if (!plan.stack_ok) {
                ret R.err[R.Void, str]("mir.lower_ir: return slot carries an outgoing stack chunk");
            }
            val stk: mir.MirOperand = mir.op_mem_preg(plan.stack_base, plan.stack_off + p.stk_off);
            var src: mir.MirOperand = mem;
            var dst: mir.MirOperand = stk;
            if (plan.store) { src = stk; dst = mem; }
            val copied: R.Result[R.Void, str] = context.copy_aggregate(ctx, mb, dst, src, logical_width::u64);
            if (R.is_err[R.Void, str](copied)) { ret copied; }
        } or {
            val reg: mir.MirOperand = mir.op_preg(p.reg::u32);
            if (plan.store) {
                val st: R.Result[R.Void, str] = context.emit_store_to_w(ctx, mb, mem, reg, p.width);
                if (R.is_err[R.Void, str](st)) { ret st; }
            } or {
                val mr: R.Result[R.Void, str] = load_piece_carrier(ctx, mb, registers,
                    reg, mem, logical_width, p.width);
                if (R.is_err[R.Void, str](mr)) { ret mr; }
            }
        }
        i = i + 1;
    }
    if (registers == ?pending) { ret place_call_registers(ctx, mb, ?pending); }
    ret R.ok_void[str]();
}

fun emit_arg_slot(ctx: *context.LowerCtx, mb: *mir.MirBlock, registers: *mir.MirBlock, slot: abi.ParamSlot, argop: mir.MirOperand,
                  stack_off: i64, is_aggr: bool, ty: type.IrTypeId, natural: bool) R.Result[R.Void, str] {
    val size: u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;

    if (is_aggr && (slot.class == abi.CLASS_BYREF || slot.class == abi.CLASS_STACK_BYREF)) {
        var owned: u32 = mir.MIR_VREG_NIL;
        val cr: R.Result[R.Void, str] = copy_aggregate_to_temp(ctx, mb, argop, ty, ?owned);
        if (R.is_err[R.Void, str](cr)) { ret cr; }
        if (slot.class == abi.CLASS_STACK_BYREF) {
            val sp: u32 = ctx.tgt.model.stack_ptr_reg::u32;
            ret context.emit_store_to(ctx, mb, mir.op_mem_preg(sp, stack_off), mir.op_vreg(owned));
        }
        ret emit_call_reg(ctx, mb, registers, mir.op_preg(slot.reg::u32), mir.op_vreg(owned), ptr_move_width(ctx));
    }
    if (slot.class == abi.CLASS_VEC_BYREF || slot.class == abi.CLASS_VEC_STACK_BYREF) {
        var addr: u32 = mir.MIR_VREG_NIL;
        val sr: R.Result[R.Void, str] = spill_vector_to_temp(ctx, mb, slot, argop, ty, ?addr);
        if (R.is_err[R.Void, str](sr)) { ret sr; }
        if (slot.class == abi.CLASS_VEC_STACK_BYREF) {
            val sp: u32 = ctx.tgt.model.stack_ptr_reg::u32;
            ret context.emit_store_to(ctx, mb, mir.op_mem_preg(sp, stack_off), mir.op_vreg(addr));
        }
        ret emit_call_reg(ctx, mb, registers, mir.op_preg(slot.reg::u32), mir.op_vreg(addr), ptr_move_width(ctx));
    }
    if (slot.class == abi.CLASS_STACK_BYREF) {
        val sp: u32 = ctx.tgt.model.stack_ptr_reg::u32;
        var base: u32 = mir.MIR_VREG_NIL;
        val ar: R.Result[R.Void, str] = context.addr_to_vreg(ctx, mb, argop, ?base);
        if (R.is_err[R.Void, str](ar)) { ret ar; }
        ret context.emit_store_to(ctx, mb, mir.op_mem_preg(sp, stack_off), mir.op_vreg(base));
    }
    if (slot.class == abi.CLASS_STACK) {
        val sp: u32 = ctx.tgt.model.stack_ptr_reg::u32;
        if (is_aggr) {
            ret context.copy_aggregate(ctx, mb, mir.op_mem_preg(sp, stack_off), argop, size);
        }
        if (context.subwidth_vector_memory(ctx, ty)) {
            ret context.store_subwidth_vector(ctx, mb, mir.op_mem_preg(sp, stack_off), argop, ty);
        }
        ret context.emit_store_to_w(ctx, mb, mir.op_mem_preg(sp, stack_off), argop,
                                    scalar_mem_move_width(ctx.tgt.model.gpr_width, size, natural));
    }
    if (slot.class == abi.CLASS_BYREF) {
        var base: u32 = mir.MIR_VREG_NIL;
        val ar: R.Result[R.Void, str] = context.addr_to_vreg(ctx, mb, argop, ?base);
        if (R.is_err[R.Void, str](ar)) { ret ar; }
        ret emit_call_reg(ctx, mb, registers, mir.op_preg(slot.reg::u32), mir.op_vreg(base), ptr_move_width(ctx));
    }
    if (slot.class == abi.CLASS_AGG) {
        ret context.emit_agg_load(ctx, registers, slot.reg::u32, argop);
    }
    if (is_aggr) {
        var base: u32 = mir.MIR_VREG_NIL;
        val ar: R.Result[R.Void, str] = context.addr_to_vreg(ctx, mb, argop, ?base);
        if (R.is_err[R.Void, str](ar)) { ret ar; }
        var plan: PiecePlan;
        plan.registers = registers;
        plan.store      = false;
        plan.mem_base   = base;
        plan.mem_slot   = false;
        plan.stack_base = ctx.tgt.model.stack_ptr_reg::u32;
        plan.stack_off  = stack_off;
        plan.stack_ok   = true;
        ret materialize_pieces(ctx, mb, slot, plan);
    }
    if (slot.class == abi.CLASS_FP) {
        val fw: R.Result[u8, str] = fp_move_width(ctx, ty);
        if (R.is_err[u8, str](fw)) { ret R.err[R.Void, str](R.unwrap_err[u8, str](fw)); }
        ret emit_call_reg(ctx, mb, registers, mir.op_preg(slot.reg::u32), argop, R.unwrap_ok[u8, str](fw));
    }
    ret emit_call_reg(ctx, mb, registers, mir.op_preg(slot.reg::u32), argop, scalar_reg_move_width(ctx.tgt.model.gpr_width, size));
}

fun copy_aggregate_to_temp(ctx: *context.LowerCtx, mb: *mir.MirBlock, src: mir.MirOperand,
                           ty: type.IrTypeId, out_addr: *u32) R.Result[R.Void, str] {
    val size:  u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    val align: u32 = type.byte_align_for_machine(ctx.types, ty, ctx.layout);
    val res_key: R.Result[u32, str] = context.new_vreg(ctx, mir.REG_CLASS_GP);
    if (R.is_err[u32, str](res_key)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](res_key)); }
    val sk: u32 = R.unwrap_ok[u32, str](res_key);

    val sr: R.Result[R.Void, str] = context.add_spill_slot_aligned(ctx, sk, size, align);
    if (R.is_err[R.Void, str](sr)) { ret sr; }

    val cr: R.Result[R.Void, str] = context.copy_aggregate(ctx, mb, mir.op_mem_slot(sk, 0), src, size);
    if (R.is_err[R.Void, str](cr)) { ret cr; }

    ret context.emit_lea_slot(ctx, mb, mir.op_mem_slot(sk, 0), out_addr);
}

fun spill_vector_to_temp(ctx: *context.LowerCtx, mb: *mir.MirBlock, slot: abi.ParamSlot,
                         val_op: mir.MirOperand, ty: type.IrTypeId, out_addr: *u32) R.Result[R.Void, str] {
    val logical_size:  u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    val size:  u64 = slot.indirect_size;
    val align: u32 = slot.indirect_align;
    if (size < logical_size || align == 0 || (align & (align - 1)) != 0) {
        ret R.err[R.Void, str]("mir.abi.spill_vector_to_temp: ABI vector placement has invalid indirect storage");
    }
    val res_key: R.Result[u32, str] = context.new_vreg(ctx, mir.REG_CLASS_GP);
    if (R.is_err[u32, str](res_key)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](res_key)); }
    val sk: u32 = R.unwrap_ok[u32, str](res_key);

    val sr: R.Result[R.Void, str] = context.add_spill_slot_aligned(ctx, sk, size, align);
    if (R.is_err[R.Void, str](sr)) { ret sr; }

    var st: R.Result[R.Void, str] = R.ok_void[str]();
    if (context.value_is_vector(ctx, ty)) {
        st = context.store_subwidth_vector(ctx, mb, mir.op_mem_slot(sk, 0), val_op, ty);
    } or {
        st = context.copy_aggregate(ctx, mb, mir.op_mem_slot(sk, 0), val_op, size);
    }
    if (R.is_err[R.Void, str](st)) { ret st; }

    ret context.emit_lea_slot(ctx, mb, mir.op_mem_slot(sk, 0), out_addr);
}

fun fp_move_width(ctx: *context.LowerCtx, ty: type.IrTypeId) R.Result[u8, str] {
    val size: u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    if (context.value_is_vector(ctx, ty)) {
        val vw: u64 = (ctx.tgt.model.vector_bits / 8)::u64;
        if (vw == 0 || size > vw) {
            ret R.err[u8, str]("mir.abi.fp_move_width: vector wider than the target's vector register; an over-width vector's placement is a multi-piece split the convention classifier must decide");
        }
        ret R.ok[u8, str](vw::u8);
    }
    if (size == 4) { ret R.ok[u8, str](4); }
    if (size == 8) { ret R.ok[u8, str](8); }
    ret R.err[u8, str]("mir.abi.fp_move_width: CLASS_FP scalar of unsupported size (expected 4 or 8 bytes)");
}

fun capture_slot_reg(ctx: *context.LowerCtx, mb: *mir.MirBlock, dst: u32, slot: abi.ParamSlot, ty: type.IrTypeId) R.Result[R.Void, str] {
    if (slot.class == abi.CLASS_FP) {
        val fw: R.Result[u8, str] = fp_move_width(ctx, ty);
        if (R.is_err[u8, str](fw)) { ret R.err[R.Void, str](R.unwrap_err[u8, str](fw)); }
        ret context.emit_fmov(ctx, mb, mir.op_vreg(dst), mir.op_preg(slot.reg::u32), R.unwrap_ok[u8, str](fw));
    }
    val size: u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    ret context.emit_mov_w(ctx, mb, mir.op_vreg(dst), mir.op_preg(slot.reg::u32),
                           scalar_reg_move_width(ctx.tgt.model.gpr_width, size));
}

fun scalar_reg_move_width(gpr_width: u32, size: u64) u8 {
    if (size == 4) { ret 4; }
    if (size > gpr_width::u64) { ret size::u8; }
    ret gpr_width::u8;
}

fun scalar_mem_move_width(gpr_width: u32, size: u64, natural: bool) u8 {
    if (natural)               { ret size::u8; }
    if (size > gpr_width::u64) { ret size::u8; }
    ret gpr_width::u8;
}

fun ptr_move_width(ctx: *context.LowerCtx) u8 {
    ret ctx.tgt.model.pointer_width::u8;
}

fun record_outgoing_size(ctx: *context.LowerCtx, bytes: i64) {
    if (bytes <= 0) { ret; }
    val need: u32 = bytes::u32;
    if (need > ctx.f.frame.outgoing_size) {
        ctx.f.frame.outgoing_size = need;
    }
}

fun emit_ret_slot_to_vreg(ctx: *context.LowerCtx, mb: *mir.MirBlock, slot: abi.ParamSlot, dst: u32, is_aggr: bool, ty: type.IrTypeId) R.Result[R.Void, str] {
    if (slot.class == abi.CLASS_AGG) {
        ret context.emit_agg_store(ctx, mb, mir.op_mem_value(dst, 0), slot.reg::u32);
    }
    if (is_aggr) {
        val extent: R.Result[u64, str] = abi.carrier_storage_extent(?slot);
        if (R.is_err[u64, str](extent)) { ret R.err[R.Void, str](R.unwrap_err[u64, str](extent)); }
        var plan: PiecePlan;
        plan.owned_extent = R.unwrap_ok[u64, str](extent);
        plan.registers = mb;
        plan.store      = true;
        plan.mem_base   = dst;
        plan.mem_slot   = false;
        plan.stack_base = 0;
        plan.stack_off  = 0;
        plan.stack_ok   = false;
        ret materialize_pieces(ctx, mb, slot, plan);
    }
    ret capture_slot_reg(ctx, mb, dst, slot, ty);
}

pub fun lower_params(ctx: *context.LowerCtx, mb: *mir.MirBlock) R.Result[R.Void, str] {
    val ret_type: type.IrTypeId = context.fn_return_type(ctx);
    var layout: abi.SigLayout;
    val cls: R.Result[R.Void, str] = classify_signature(ctx, ctx.fn.sig, ret_type, ?layout);
    if (R.is_err[R.Void, str](cls)) { ret cls; }

    if (layout.ret_slot.class == abi.CLASS_SRET) {
        val sret_reg: i32 = ctx.tgt.abi.indirect_result_reg;
        val svr: R.Result[u32, str] = context.new_vreg(ctx, mir.REG_CLASS_GP);
        if (R.is_err[u32, str](svr)) {
            sig_layout_free(ctx, ?layout);
            ret R.err[R.Void, str](R.unwrap_err[u32, str](svr));
        }
        val sv: u32 = R.unwrap_ok[u32, str](svr);
        val mv: R.Result[R.Void, str] = context.emit_mov_w(ctx, mb, mir.op_vreg(sv), mir.op_preg(sret_reg::u32),
                                                         ptr_move_width(ctx));
        if (R.is_err[R.Void, str](mv)) {
            sig_layout_free(ctx, ?layout);
            ret mv;
        }
        ctx.sret_vreg = sv;
    }

    var bound: u32 = ctx.param_count;
    if (layout.param_count < bound) { bound = layout.param_count; }
    var i: u32 = 0;
    for (i < bound) {
        val pv:   u32 = ctx.param_vregs[i];
        val pty:  type.IrTypeId = ctx.fn.params[i].ty;
        val pag:  bool = context.value_is_aggregate(ctx, pty);
        val slot: abi.ParamSlot = layout.params[i];

        if (pag || param_has_use(ctx.fn, i)) {
            val er: R.Result[R.Void, str] = emit_param_slot(ctx, mb, slot, pv, pty, slot.offset, pag);
            if (R.is_err[R.Void, str](er)) {
                sig_layout_free(ctx, ?layout);
                ret er;
            }
        }
        i = i + 1;
    }

    sig_layout_free(ctx, ?layout);
    ret R.ok_void[str]();
}

fun capture_vector_byref(ctx: *context.LowerCtx, mb: *mir.MirBlock, pv: u32,
                         ty: type.IrTypeId, src: mir.MirOperand) R.Result[R.Void, str] {
    if (!context.value_is_vector(ctx, ty)) {
        ret context.emit_mov_w(ctx, mb, mir.op_vreg(pv), src, ptr_move_width(ctx));
    }
    val ar: R.Result[u32, str] = context.new_vreg(ctx, mir.REG_CLASS_GP);
    if (R.is_err[u32, str](ar)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](ar)); }
    val addr: u32 = R.unwrap_ok[u32, str](ar);
    val mr: R.Result[R.Void, str] = context.emit_mov_w(ctx, mb, mir.op_vreg(addr), src, ptr_move_width(ctx));
    if (R.is_err[R.Void, str](mr)) { ret mr; }
    if (context.subwidth_vector_memory(ctx, ty)) {
        ret context.load_subwidth_vector(ctx, mb, mir.op_vreg(pv), mir.op_mem_value(addr, 0), ty);
    }
    val size: u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    ret context.emit_mov_w(ctx, mb, mir.op_vreg(pv), mir.op_mem_value(addr, 0), size::u8);
}

fun emit_param_slot(ctx: *context.LowerCtx, mb: *mir.MirBlock, slot: abi.ParamSlot, pv: u32, ty: type.IrTypeId,
                    stack_off: i64, is_aggr: bool) R.Result[R.Void, str] {
    val size: u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    val arg_base: i64 = ctx.tgt.model.incoming_arg_base;
    if (slot.class == abi.CLASS_VEC_STACK_BYREF) {
        val fp: u32 = ctx.tgt.model.frame_ptr_reg::u32;
        ret capture_vector_byref(ctx, mb, pv, ty, mir.op_mem_preg(fp, arg_base + stack_off));
    }
    if (slot.class == abi.CLASS_VEC_BYREF) {
        ret capture_vector_byref(ctx, mb, pv, ty, mir.op_preg(slot.reg::u32));
    }
    if (slot.class == abi.CLASS_STACK_BYREF) {
        val fp: u32 = ctx.tgt.model.frame_ptr_reg::u32;
        ret context.emit_mov_w(ctx, mb, mir.op_vreg(pv), mir.op_mem_preg(fp, arg_base + stack_off),
                               ptr_move_width(ctx));
    }
    if (slot.class == abi.CLASS_STACK) {
        val fp: u32 = ctx.tgt.model.frame_ptr_reg::u32;
        if (is_aggr) {
            ret context.emit_lea_preg(ctx, mb, pv, fp, arg_base + stack_off);
        }
        if (context.subwidth_vector_memory(ctx, ty)) {
            ret context.load_subwidth_vector(ctx, mb, mir.op_vreg(pv),
                                             mir.op_mem_preg(fp, arg_base + stack_off), ty);
        }
        ret context.emit_mov_w(ctx, mb, mir.op_vreg(pv), mir.op_mem_preg(fp, arg_base + stack_off),
                               scalar_mem_move_width(ctx.tgt.model.gpr_width, size,
                                                     natural_stack_slot(ctx.tgt, false)));
    }
    if (slot.class == abi.CLASS_BYREF) {
        ret context.emit_mov_w(ctx, mb, mir.op_vreg(pv), mir.op_preg(slot.reg::u32), ptr_move_width(ctx));
    }
    if (slot.class == abi.CLASS_AGG) {
        val ar: R.Result[R.Void, str] = context.alloc_object_storage(ctx, mb, pv, ty);
        if (R.is_err[R.Void, str](ar)) { ret ar; }
        ret context.emit_agg_store(ctx, mb, mir.op_mem_value(pv, 0), slot.reg::u32);
    }
    if (is_aggr) {
        val extent: R.Result[u64, str] = abi.carrier_storage_extent(?slot);
        if (R.is_err[u64, str](extent)) { ret R.err[R.Void, str](R.unwrap_err[u64, str](extent)); }
        val sr: R.Result[R.Void, str] = context.add_spill_slot(ctx, pv, R.unwrap_ok[u64, str](extent));
        if (R.is_err[R.Void, str](sr)) { ret sr; }
        var plan: PiecePlan;
        plan.owned_extent = R.unwrap_ok[u64, str](extent);
        plan.registers = mb;
        plan.store      = true;
        plan.mem_base   = pv;
        plan.mem_slot   = true;
        plan.stack_base = ctx.tgt.model.frame_ptr_reg::u32;
        plan.stack_off  = arg_base + stack_off;
        plan.stack_ok   = true;
        ret materialize_pieces(ctx, mb, slot, plan);
    }
    ret capture_slot_reg(ctx, mb, pv, slot, ty);
}

fun param_has_use(fn: *ir.Function, param_ix: u32) bool {
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];

        var pj: u32 = 0;
        for (pj < blk.phi_count) {
            if (instr_names_param(fn, blk.phis[pj], param_ix)) { ret true; }
            pj = pj + 1;
        }

        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            if (instr_names_param(fn, blk.instructions[ii], param_ix)) { ret true; }
            ii = ii + 1;
        }

        if (instr_names_param(fn, blk.terminator, param_ix)) { ret true; }

        bi = bi + 1;
    }
    ret false;
}

fun instr_names_param(fn: *ir.Function, iid: id.InstructionId, param_ix: u32) bool {
    if (iid == id.INSTR_NIL)      { ret false; }
    if (iid::u32 >= fn.instr_len) { ret false; }
    val inst: *instruction.Instruction = ?fn.instrs[iid::u32];
    if (inst.kind == instruction.OP_DBG_VALUE) { ret false; }
    var k: u32 = 0;
    for (k < inst.operand_count) {
        val v: value.Value = inst.operands[k];
        if (v.kind == value.VAL_PARAM && v.data.param_ix == param_ix) { ret true; }
        k = k + 1;
    }
    ret false;
}

pub fun lower_ret(ctx: *context.LowerCtx, mb: *mir.MirBlock, inst: *instruction.Instruction) R.Result[R.Void, str] {
    if (inst.operand_count == 0) {
        ret emit_bare_ret(ctx, mb);
    }
    val rv:   value.Value = inst.operands[0];
    val rt:   type.IrTypeId = context.fn_return_type(ctx);
    val rsz:  u64  = type.byte_size_for_machine(ctx.types, rt, ctx.layout)::u64;
    val rag:  bool = context.value_is_aggregate(ctx, rt);
    var layout: abi.SigLayout;
    val cls: R.Result[R.Void, str] = classify_signature(ctx, ctx.fn.sig, rt, ?layout);
    if (R.is_err[R.Void, str](cls)) { ret cls; }
    val slot: abi.ParamSlot = layout.ret_slot;
    sig_layout_free(ctx, ?layout);
    val rvr: R.Result[mir.MirOperand, str] = lower_value_addr(ctx, mb, rv);
    if (R.is_err[mir.MirOperand, str](rvr)) { ret R.err[R.Void, str](R.unwrap_err[mir.MirOperand, str](rvr)); }
    val rvop: mir.MirOperand = R.unwrap_ok[mir.MirOperand, str](rvr);

    if (slot.class == abi.CLASS_AGG) {
        val lr: R.Result[R.Void, str] = context.emit_agg_load(ctx, mb, slot.reg::u32, rvop);
        if (R.is_err[R.Void, str](lr)) { ret lr; }
        ret emit_bare_ret(ctx, mb);
    }
    if (slot.class == abi.CLASS_SRET) {
        if (ctx.sret_vreg == mir.MIR_VREG_NIL) {
            ret R.err[R.Void, str]("mir.lower_ir: sret return without a captured result-storage pointer");
        }
        if (context.value_is_vector(ctx, rv.ty)) {
            val sr: R.Result[R.Void, str] = context.store_subwidth_vector(ctx, mb, mir.op_mem_value(ctx.sret_vreg, 0), rvop, rt);
            if (R.is_err[R.Void, str](sr)) { ret sr; }
        } or (rag || context.value_is_vector(ctx, rt)) {
            val cr: R.Result[R.Void, str] = context.copy_aggregate(ctx, mb, mir.op_mem_value(ctx.sret_vreg, 0), rvop, rsz);
            if (R.is_err[R.Void, str](cr)) { ret cr; }
        } or {
            val sr: R.Result[R.Void, str] = context.emit_store_to_w(ctx, mb, mir.op_mem_value(ctx.sret_vreg, 0), rvop, rsz::u8);
            if (R.is_err[R.Void, str](sr)) { ret sr; }
        }
        val mr: R.Result[R.Void, str] = context.emit_mov_w(ctx, mb, mir.op_preg(slot.reg::u32),
                                                         mir.op_vreg(ctx.sret_vreg), ptr_move_width(ctx));
        if (R.is_err[R.Void, str](mr)) { ret mr; }
    } or (rag) {
        var base: u32 = mir.MIR_VREG_NIL;
        val ar: R.Result[R.Void, str] = context.addr_to_vreg(ctx, mb, rvop, ?base);
        if (R.is_err[R.Void, str](ar)) { ret ar; }
        var plan: PiecePlan;
        plan.registers = mb;
        plan.store      = false;
        plan.mem_base   = base;
        plan.mem_slot   = false;
        plan.stack_base = 0;
        plan.stack_off  = 0;
        plan.stack_ok   = false;
        val mr: R.Result[R.Void, str] = materialize_pieces(ctx, mb, slot, plan);
        if (R.is_err[R.Void, str](mr)) { ret mr; }
    } or (slot.class == abi.CLASS_FP) {
        val fw: R.Result[u8, str] = fp_move_width(ctx, rt);
        if (R.is_err[u8, str](fw)) { ret R.err[R.Void, str](R.unwrap_err[u8, str](fw)); }
        val mr: R.Result[R.Void, str] = context.emit_fmov(ctx, mb, mir.op_preg(slot.reg::u32), rvop, R.unwrap_ok[u8, str](fw));
        if (R.is_err[R.Void, str](mr)) { ret mr; }
    } or (slot.reg >= 0) {
        val mr: R.Result[R.Void, str] = context.emit_mov_w(ctx, mb, mir.op_preg(slot.reg::u32), rvop, scalar_reg_move_width(ctx.tgt.model.gpr_width, rsz));
        if (R.is_err[R.Void, str](mr)) { ret mr; }
    }

    ret emit_bare_ret(ctx, mb);
}

fun emit_bare_ret(ctx: *context.LowerCtx, mb: *mir.MirBlock) R.Result[R.Void, str] {
    var mi: mir.MirInstr = mir.instr(mir.MIR_RET, nil, 0, ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
    ret context.push_instr(ctx, mb, mi);
}

test "mach.lang.be.codegen.mir.abi.classify_signature:win64_uses_one_platform_boundary" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val ir_r: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](ir_r)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](ir_r);

    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](treg.register_all(?reg, target_testing.debug_descriptor))) { ir.dnit(?m); ret 1; }
    val tgt_r: R.Result[target.Target, str] = treg.select(?reg, "x86_64", "windows", "win64");
    if (R.is_err[target.Target, str](tgt_r)) { ir.dnit(?m); ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tgt_r);

    val void_r: R.Result[type.IrTypeId, str] = type.intern_void(?m.types);
    val i32_r:  R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 32);
    if (R.is_err[type.IrTypeId, str](void_r) || R.is_err[type.IrTypeId, str](i32_r)) { ir.dnit(?m); ret 1; }
    val vec_r: R.Result[type.IrTypeId, str] = type.intern_vector(?m.types, R.unwrap_ok[type.IrTypeId, str](i32_r), 4);
    if (R.is_err[type.IrTypeId, str](vec_r)) { ir.dnit(?m); ret 1; }
    var params: [1]type.IrTypeId;
    params[0] = R.unwrap_ok[type.IrTypeId, str](vec_r);
    val sig_r: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, R.unwrap_ok[type.IrTypeId, str](void_r), ?params[0], 1, false);
    if (R.is_err[type.IrTypeId, str](sig_r)) { ir.dnit(?m); ret 1; }

    var ctx: context.LowerCtx;
    ctx.alloc = ?alloc;
    ctx.tgt   = ?tgt;
    ctx.layout = target.layout_machine(?tgt);
    ctx.m     = ?m;
    ctx.types = ?m.types;

    var layout: abi.SigLayout;
    val cls: R.Result[R.Void, str] = classify_signature(?ctx, R.unwrap_ok[type.IrTypeId, str](sig_r),
                                                       R.unwrap_ok[type.IrTypeId, str](void_r), ?layout);
    if (R.is_err[R.Void, str](cls)) { ir.dnit(?m); ret 1; }
    var bad: i32 = 0;
    if (layout.param_count != 1)                  { bad = 1; }
    or (layout.params[0].class != abi.CLASS_VEC_BYREF) { bad = 1; }
    sig_layout_free(?ctx, ?layout);

    ir.dnit(?m);
    ret bad;
}

test "mach.lang.be.codegen.mir.abi:scalar_move_widths" {
    if (scalar_reg_move_width(8, 1) != 8) { ret 1; }
    if (scalar_reg_move_width(8, 2) != 8) { ret 1; }
    if (scalar_reg_move_width(8, 4) != 4) { ret 1; }
    if (scalar_reg_move_width(8, 8) != 8) { ret 1; }
    if (scalar_mem_move_width(8, 1, false) != 8) { ret 1; }
    if (scalar_mem_move_width(8, 4, false) != 8) { ret 1; }
    if (scalar_mem_move_width(8, 8, false) != 8) { ret 1; }

    if (scalar_reg_move_width(1, 1) != 1) { ret 1; }
    if (scalar_reg_move_width(1, 2) != 2) { ret 1; }
    if (scalar_reg_move_width(1, 4) != 4) { ret 1; }
    if (scalar_reg_move_width(1, 8) != 8) { ret 1; }
    if (scalar_mem_move_width(1, 1, false) != 1) { ret 1; }
    if (scalar_mem_move_width(1, 2, false) != 2) { ret 1; }
    if (scalar_mem_move_width(1, 4, false) != 4) { ret 1; }
    if (scalar_mem_move_width(1, 8, false) != 8) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.mir.abi.sret_reserves_gp" {
    if (!sret_reserves_gp(abi.CLASS_SRET, true)) { ret 1; }
    if (sret_reserves_gp(abi.CLASS_SRET, false)) { ret 1; }
    if (sret_reserves_gp(abi.CLASS_GP, true)) { ret 1; }
    ret 0;
}

fun test_model(tgt: *target.Target, word: u32, ptr: u32) {
    tgt.model.gpr_width     = word;
    tgt.model.pointer_width = ptr;
}

test "mach.lang.be.codegen.mir.abi:stack_arg_alignment" {
    var tgt: target.Target;
    test_model(?tgt, 8, 8);

    if (round_up_i64(8, 8) != 8) { ret 1; }
    if (round_up_i64(0, 8) != 0) { ret 1; }
    if (round_up_i64(8, 16) != 16)  { ret 1; }
    if (round_up_i64(24, 16) != 32) { ret 1; }
    if (stack_arg_align(?tgt, abi.CLASS_STACK_BYREF, 16, false) != 8) { ret 1; }
    if (stack_arg_align(?tgt, abi.CLASS_STACK, 16, false) != 16) { ret 1; }
    if (stack_arg_align(?tgt, abi.CLASS_STACK, 4, false) != 8)   { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.mir.abi:stack_slot_granularity_is_the_machine_word" {
    var w8: target.Target;
    test_model(?w8, 8, 8);
    var w4: target.Target;
    test_model(?w4, 4, 4);

    if (stack_arg_align(?w8, abi.CLASS_STACK, 4, false) != 8) { ret 1; }
    if (stack_arg_align(?w4, abi.CLASS_STACK, 4, false) != 4) { ret 1; }
    if (stack_arg_bytes(?w8, 4, false) != 8) { ret 1; }
    if (stack_arg_bytes(?w4, 4, false) != 4) { ret 1; }
    if (stack_arg_bytes(?w8, 1, false) != 8) { ret 1; }
    if (stack_arg_bytes(?w4, 1, false) != 4) { ret 1; }
    if (stack_arg_bytes(?w4, 9, false) != 12) { ret 1; }
    if (stack_arg_align(?w4, abi.CLASS_STACK, 16, false) != 16) { ret 1; }

    var split: target.Target;
    test_model(?split, 4, 2);
    if (stack_arg_align(?split, abi.CLASS_STACK_BYREF, 16, false) != 2)     { ret 1; }
    if (stack_arg_align(?split, abi.CLASS_VEC_STACK_BYREF, 16, false) != 2) { ret 1; }
    if (stack_arg_align(?split, abi.CLASS_STACK, 1, false) != 4) { ret 1; }

    var off: i64 = 0;
    var n:   u32 = 0;
    for (n < 3) {
        off = round_up_i64(off, stack_arg_align(?w4, abi.CLASS_STACK, 4, false));
        if (off != (n * 4)::i64) { ret 1; }
        off = off + stack_arg_bytes(?w4, 4, false);
        n = n + 1;
    }
    if (off != 12) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.mir.abi:natural_stack_args_pack_a_narrow_argument" {
    var tgt: target.Target;
    test_model(?tgt, 8, 8);

    if (stack_arg_align(?tgt, abi.CLASS_STACK, 4, true) != 4) { ret 1; }
    if (stack_arg_align(?tgt, abi.CLASS_STACK, 1, true) != 1) { ret 1; }
    if (stack_arg_align(?tgt, abi.CLASS_STACK, 16, true) != 16) { ret 1; }
    if (stack_arg_align(?tgt, abi.CLASS_STACK_BYREF, 16, true) != 8) { ret 1; }

    if (stack_arg_bytes(?tgt, 4, true) != 4) { ret 1; }
    if (stack_arg_bytes(?tgt, 1, true) != 1) { ret 1; }
    if (stack_arg_bytes(?tgt, 8, true) != 8) { ret 1; }
    if (stack_arg_bytes(?tgt, 4, false) != 8) { ret 1; }
    if (stack_arg_bytes(?tgt, 1, false) != 8) { ret 1; }

    if (scalar_mem_move_width(8, 4, true) != 4) { ret 1; }
    if (scalar_mem_move_width(8, 1, true) != 1) { ret 1; }
    if (scalar_mem_move_width(8, 8, true) != 8) { ret 1; }

    var off:  i64 = 0;
    var boff: i64 = 0;
    var n:    u32 = 0;
    for (n < 3) {
        off = round_up_i64(off, stack_arg_align(?tgt, abi.CLASS_STACK, 4, true));
        boff = round_up_i64(boff, stack_arg_align(?tgt, abi.CLASS_STACK, 4, false));
        if (n == 0 && (off != 0 || boff != 0))   { ret 1; }
        if (n == 1 && (off != 4 || boff != 8))   { ret 1; }
        if (n == 2 && (off != 8 || boff != 16))  { ret 1; }
        off  = off + stack_arg_bytes(?tgt, 4, true);
        boff = boff + stack_arg_bytes(?tgt, 4, false);
        n = n + 1;
    }
    if (off != 12 || boff != 24) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.mir.abi.natural_stack_slot:fixed_diverges_variadic_does_not" {
    var tgt: target.Target;
    tgt.fixed_args_natural_size = true;
    if (!natural_stack_slot(?tgt, false)) { ret 1; }
    if (natural_stack_slot(?tgt, true))   { ret 1; }
    tgt.fixed_args_natural_size = false;
    if (natural_stack_slot(?tgt, false)) { ret 1; }
    if (natural_stack_slot(?tgt, true))  { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.mir.abi.stack_only_tail_slot:moves_placement_not_form" {
    val gp: abi.ParamSlot = stack_only_tail_slot(abi.make_slot(abi.CLASS_GP, 1, 0, 8, 8));
    if (gp.class != abi.CLASS_STACK) { ret 1; }
    if (gp.reg != -1)                { ret 1; }
    if (gp.piece_count != 0)         { ret 1; }
    if (gp.size != 8)                { ret 1; }
    val fp: abi.ParamSlot = stack_only_tail_slot(abi.make_slot(abi.CLASS_FP, isa.regid_make(isa.REG_CLASS_ID_XMM, 0), 0, 8, 8));
    if (fp.class != abi.CLASS_STACK) { ret 1; }
    val pair: abi.ParamSlot = stack_only_tail_slot(abi.make_slot_pair(abi.CLASS_GP, 0, 1, 0, 16, 8));
    if (pair.class != abi.CLASS_STACK) { ret 1; }
    if (pair.piece_count != 0)         { ret 1; }
    if (pair.size != 16)               { ret 1; }
    val hfa: abi.ParamSlot = stack_only_tail_slot(abi.make_slot_hfa(isa.regid_make(isa.REG_CLASS_ID_XMM, 0), 4, 8, 32));
    if (hfa.class != abi.CLASS_STACK) { ret 1; }
    if (hfa.piece_count != 0)         { ret 1; }
    val byref: abi.ParamSlot = stack_only_tail_slot(abi.make_slot(abi.CLASS_BYREF, 0, 0, 8, 8));
    if (byref.class != abi.CLASS_STACK_BYREF) { ret 1; }
    if (byref.size != 8)                      { ret 1; }
    val vstored: abi.ParamSlot = stack_only_tail_slot(abi.make_slot_indirect(abi.CLASS_VEC_BYREF, 0, 0, 8, 16, 16));
    if (vstored.class != abi.CLASS_VEC_STACK_BYREF) { ret 1; }
    if (vstored.indirect_size != 16)                { ret 1; }
    if (vstored.indirect_align != 16)               { ret 1; }
    val stk: abi.ParamSlot = stack_only_tail_slot(abi.make_slot(abi.CLASS_STACK, -1, 24, 16, 0));
    if (stk.class != abi.CLASS_STACK) { ret 1; }
    if (stk.offset != 24)             { ret 1; }
    ret 0;
}

fun probe_arg(index: i32, size: u64, align: u64, is_float: bool, fp_eightbytes: u8,
              is_aggregate: bool, is_vector: bool,
              gp_used: i32, fp_used: i32,
              hfa_members: u8, hfa_elem: u8, agg: abi.AggLayout) abi.ParamSlot {
    ret abi.make_slot(abi.CLASS_GP, index, 0, size, 8);
}

fun probe_ret(size: u64, align: u64, is_float: bool, fp_eightbytes: u8,
              is_aggregate: bool, is_vector: bool, hfa_members: u8, hfa_elem: u8,
              agg: abi.AggLayout) abi.ParamSlot {
    ret abi.make_slot(abi.CLASS_GP, 0, 0, size, 8);
}

test "mach.lang.be.codegen.mir.abi.require_abi:variadic_facts_are_not_call_preconditions" {
    var vt: isa.IsaVTable = isa.emitter_isa(isa.ARCH_UNKNOWN, "probe", 8, nil, nil);
    var av: abi.AbiVTable = abi.abi_vtable(
        0, "", 0,
probe_arg, probe_ret,
        nil, nil,
        0, 0, 0,
        -1, false,
        false, false,
        0, 8,
        nil
    );

    var t: target.Target;
    t.isa = ?vt;
    t.abi = ?av;

    if (R.is_err[R.Void, str](require_abi(?t))) { ret 1; }

    var reg: i32 = 0;
    if (!R.is_err[R.Void, str](abi_gp_arg_reg(?t, 0, ?reg))) { ret 1; }
    var vm: abi.VaModel;
    if (!R.is_err[R.Void, str](abi_va_model(?t, ?vm))) { ret 1; }

    av.arg_passing = nil;
    if (!R.is_err[R.Void, str](require_abi(?t))) { ret 1; }
    av.arg_passing = probe_arg;
    av.ret_passing = nil;
    if (!R.is_err[R.Void, str](require_abi(?t))) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.mir.abi.param_has_use:dbg_value_is_not_a_use" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_module)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_module);

    val res_i64: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](res_i64)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_i64);

    val res_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](res_fn)];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_entry)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](res_entry));

    if (R.is_err[R.Void, str](builder.emit_dbg_value(?bld, value.param(0, i64t), intern.STR_NIL, i64t, semtype.TYPE_NIL, true, 0))) { ir.dnit(?m); ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, value.param(1, i64t)))) { ir.dnit(?m); ret 1; }

    if (param_has_use(fn, 0) != false) { ir.dnit(?m); ret 1; }
    if (param_has_use(fn, 1) != true)  { ir.dnit(?m); ret 1; }

    ir.dnit(?m);
    ret 0;
}

fun rt_passthru(a: i32x4) i32x4 { ret a; }
fun rt_litret() i32x4 { ret i32x4{266, 10, 70000, 40000}; }
fun rt_localret(seed: i32) i32x4 { var v: i32x4 = i32x4{seed, 10, 70000, 40000}; ret v; }
fun rt_add_one(a: i32x4) i32x4 { var one: i32x4 = i32x4{1, 1, 1, 1}; ret a + one; }
fun rt_mixed(tag: i64, a: i32x4, k: i64) i32x4 { var b: i32x4 = i32x4{tag::i32, k::i32, 70000, 40000}; ret a + b; }
fun rt_pick(flag: i32, a: i32x4, b: i32x4) i32x4 { var r: i32x4 = b; if (flag != 0) { r = a; } ret r; }
fun rt_lane_ok(v: i32x4, l0: i32, l1: i32, l2: i32, l3: i32) bool {
    ret v[0] == l0 && v[1] == l1 && v[2] == l2 && v[3] == l3;
}

test "mach.lang.be.codegen.mir.abi:vector_by_value_roundtrip" {
    val src: i32x4 = i32x4{266, 10, 70000, 40000};
    if (!rt_lane_ok(rt_passthru(src), 266, 10, 70000, 40000)) { ret 1; }
    if (!rt_lane_ok(rt_litret(), 266, 10, 70000, 40000)) { ret 1; }
    if (!rt_lane_ok(rt_localret(266), 266, 10, 70000, 40000)) { ret 1; }
    if (!rt_lane_ok(rt_passthru(rt_litret()), 266, 10, 70000, 40000)) { ret 1; }
    if (!rt_lane_ok(rt_add_one(src), 267, 11, 70001, 40001)) { ret 1; }
    if (!rt_lane_ok(rt_mixed(5, src, 9), 271, 19, 140000, 80000)) { ret 1; }
    if (!rt_lane_ok(rt_pick(1, src, i32x4{5, 6, 7, 8}), 266, 10, 70000, 40000)) { ret 1; }
    if (!rt_lane_ok(rt_pick(0, i32x4{5, 6, 7, 8}, src), 266, 10, 70000, 40000)) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.mir.abi.gp_arg_regs:no_convention_exceeds_the_shared_array" {
    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](treg.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }

    var bad: i32 = 0;
    var checked: i32 = 0;
    var i: u32 = 0;
    for (i < CONV_COUNT) {
        val tr: R.Result[target.Target, str] =
            treg.select(?reg, CONV_ARCH[i], CONV_OS[i], CONV_ABI[i]);
        if (R.is_err[target.Target, str](tr)) { i = i + 1; cnt; }
        var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);
        if (tgt.abi.gp_arg_regs == nil) { i = i + 1; cnt; }

        var scratch: [256]isa.Register;
        val fill: abi.RegFileFn = tgt.abi.gp_arg_regs;
        val n: i32 = fill(?scratch[0]);
        checked = checked + 1;
        if (n > MAX_GP_ARG_REGS) { bad = bad + 1; }
        if (n < 0)               { bad = bad + 1; }
        i = i + 1;
    }

    if (checked == 0) { ret 1; }
    ret bad;
}

test "mach.lang.be.codegen.mir.abi.classify_signature:odd_vector_sret_shifts_mixed_arguments" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val mr: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](mr)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](mr);
    fin { ir.dnit(?m); }
    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](treg.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    val tr: R.Result[target.Target, str] = treg.select(?reg, "x86_64", "windows", "win64");
    if (R.is_err[target.Target, str](tr)) { ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);
    val byte_r: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 8);
    val word_r: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    val float_r: R.Result[type.IrTypeId, str] = type.intern_float(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](byte_r) || R.is_err[type.IrTypeId, str](word_r) || R.is_err[type.IrTypeId, str](float_r)) { ret 1; }
    val vector_r: R.Result[type.IrTypeId, str] = type.intern_vector(?m.types, R.unwrap_ok[type.IrTypeId, str](byte_r), 3);
    if (R.is_err[type.IrTypeId, str](vector_r)) { ret 1; }
    val vector: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](vector_r);
    val word: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](word_r);
    var params: [5]type.IrTypeId = [5]type.IrTypeId{word, R.unwrap_ok[type.IrTypeId, str](float_r), word, word, vector};
    val sig_r: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, vector, ?params[0], 5, false);
    if (R.is_err[type.IrTypeId, str](sig_r)) { ret 1; }
    var ctx: context.LowerCtx;
    ctx.alloc = ?alloc;
    ctx.tgt = ?tgt;
    ctx.layout = target.layout_machine(?tgt);
    ctx.m = ?m;
    ctx.types = ?m.types;
    var slots: abi.SigLayout;
    val sr: R.Result[R.Void, str] = classify_signature(?ctx, R.unwrap_ok[type.IrTypeId, str](sig_r), vector, ?slots);
    if (R.is_err[R.Void, str](sr)) { ret 1; }
    fin { sig_layout_free(?ctx, ?slots); }
    if (slots.ret_slot.class != abi.CLASS_SRET || slots.param_count != 5) { ret 2; }
    if (slots.params[0].reg != 2 || slots.params[1].reg != isa.regid_make(isa.REG_CLASS_ID_XMM, 2) || slots.params[2].reg != 9) { ret 3; }
    if (slots.params[3].class != abi.CLASS_STACK || slots.params[3].offset != 32) { ret 4; }
    if (slots.params[4].class != abi.CLASS_VEC_STACK_BYREF || slots.params[4].offset != 40 || slots.params[4].indirect_size != 3) { ret 5; }
    ret 0;
}

fun t_call_preparation(indirect: bool, sret: bool) i32 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val mr: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](mr)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](mr);
    fin { ir.dnit(?m); }
    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](treg.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    val tr: R.Result[target.Target, str] = treg.select(?reg, "x86_64", "linux", "sysv64");
    if (R.is_err[target.Target, str](tr)) { ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);
    val br: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 8);
    val wr: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    val vr: R.Result[type.IrTypeId, str] = type.intern_void(?m.types);
    if (R.is_err[type.IrTypeId, str](br) || R.is_err[type.IrTypeId, str](wr) || R.is_err[type.IrTypeId, str](vr)) { ret 1; }
    val ar: R.Result[type.IrTypeId, str] = type.intern_array(?m.types, R.unwrap_ok[type.IrTypeId, str](br), 65);
    if (R.is_err[type.IrTypeId, str](ar)) { ret 1; }
    val array: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ar);
    val word: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](wr);
    var params: [7]type.IrTypeId = [7]type.IrTypeId{word, word, word, word, word, word, array};
    var result: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](vr);
    if (sret) { result = array; }
    val sr: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, result, ?params[0], 7, false);
    if (R.is_err[type.IrTypeId, str](sr)) { ret 1; }
    val sig: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](sr);
    if (R.is_err[u32, str](ir.function_add(?m, intern.STR_NIL, sig, ir.FN_FLAG_EXTERN))) { ret 1; }
    var f: mir.MirFunction;
    fin { mir.dnit_function(?alloc, ?f); }
    val fr: R.Result[*mir.MirVReg, str] = A.allocate[mir.MirVReg](?alloc, 8);
    if (R.is_err[*mir.MirVReg, str](fr)) { ret 1; }
    f.vregs = R.unwrap_ok[*mir.MirVReg, str](fr);
    f.vreg_cap = 8;
    f.vreg_count = 3;
    f.vregs[0] = mir.vreg(0, mir.REG_CLASS_GP, false, false);
    f.vregs[1] = mir.vreg(1, mir.REG_CLASS_GP, false, false);
    f.vregs[2] = mir.vreg(2, mir.REG_CLASS_GP, false, false);
    var pv: [2]u32 = [2]u32{0, 1};
    var iv: [1]u32 = [1]u32{2};
    var ctx: context.LowerCtx;
    ctx.alloc = ?alloc;
    ctx.tgt = ?tgt;
    ctx.layout = target.layout_machine(?tgt);
    ctx.m = ?m;
    ctx.types = ?m.types;
    ctx.f = ?f;
    ctx.param_vregs = ?pv[0];
    ctx.param_count = 2;
    ctx.instr_vregs = ?iv[0];
    ctx.instr_count = 1;
    var ops: [8]value.Value;
    ops[0] = value.fn(0, sig);
    if (indirect) { ops[0] = value.param(1, sig); }
    var i: u32 = 1;
    for (i < 7) { ops[i] = value.const_int(i::u64, word); i = i + 1; }
    ops[7] = value.param(0, array);
    var call: instruction.Instruction;
    call.kind = instruction.OP_CALL;
    call.ty = result;
    call.aux_ty = sig;
    call.operands = ?ops[0];
    call.operand_count = 8;
    var mb: mir.MirBlock;
    fin { mir.dnit_block(?alloc, ?mb); }
    var iid: id.InstructionId = id.INSTR_NIL;
    if (sret) { iid = 0; }
    if (R.is_err[R.Void, str](lower_call(?ctx, ?mb, ?call, iid))) { ret 2; }
    var saw_register: bool = false;
    var copies: u32 = 0;
    var registers: u32 = 0;
    var calls: u32 = 0;
    i = 0;
    for (i < mb.instr_count) {
        val mi: *mir.MirInstr = ?mb.instrs[i];
        if (mi.opcode == mir.MIR_MEMCPY) {
            if (saw_register) { ret 3; }
            copies = copies + 1;
        }
        if (mir.instr_defines_shape(mi) && mi.operands[0].kind == mir.MIR_OP_PREG) {
            saw_register = true;
            registers = registers + 1;
        }
        if (mi.opcode == mir.MIR_CALL) {
            calls = calls + 1;
            if (indirect && (mi.operands[0].kind != mir.MIR_OP_VREG || mi.operands[0].vreg != 1)) { ret 4; }
            if (!indirect && mi.operands[0].kind != mir.MIR_OP_SYM) { ret 5; }
        }
        i = i + 1;
    }
    if (copies != 1 || registers != 6 || calls != 1) { ret 6; }
    ret 0;
}

test "mach.lang.be.codegen.mir.abi:owned_argument_preparation_precedes_register_placement" {
    if (t_call_preparation(false, false) != 0) { ret 1; }
    if (t_call_preparation(true, false) != 0) { ret 2; }
    if (t_call_preparation(false, true) != 0) { ret 3; }
    if (t_call_preparation(true, true) != 0) { ret 4; }
    ret 0;
}

rec BulkCallPayload {
    bytes: [65]u8;
}

#[noinline]
fun rt_bulk_call(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, payload: BulkCallPayload) u64 {
    var sum: u64 = a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6;
    var i: u32 = 0;
    for (i < 65) { sum = sum + payload.bytes[i]::u64; i = i + 1; }
    ret sum;
}

#[noinline]
fun rt_bulk_return(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, payload: BulkCallPayload) BulkCallPayload {
    var out: BulkCallPayload = payload;
    out.bytes[0] = (a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6)::u8;
    ret out;
}

#[noinline]
fun rt_bulk_indirect(call: fun(u64, u64, u64, u64, u64, u64, BulkCallPayload) u64, payload: BulkCallPayload) u64 {
    ret call(1, 2, 3, 4, 5, 6, payload);
}

#[noinline]
fun rt_bulk_indirect_return(call: fun(u64, u64, u64, u64, u64, u64, BulkCallPayload) BulkCallPayload, payload: BulkCallPayload) BulkCallPayload {
    ret call(1, 2, 3, 4, 5, 6, payload);
}

test "mach.lang.be.codegen.mir.abi:owned_argument_native_direct_indirect_and_sret" {
    var payload: BulkCallPayload;
    var i: u32 = 0;
    for (i < 65) { payload.bytes[i] = (i + 1)::u8; i = i + 1; }
    if (rt_bulk_call(1, 2, 3, 4, 5, 6, payload) != 2236) { ret 1; }
    if (rt_bulk_indirect(rt_bulk_call, payload) != 2236) { ret 2; }
    val direct: BulkCallPayload = rt_bulk_return(1, 2, 3, 4, 5, 6, payload);
    val indirect: BulkCallPayload = rt_bulk_indirect_return(rt_bulk_return, payload);
    if (direct.bytes[0] != 91 || indirect.bytes[0] != 91) { ret 3; }
    i = 1;
    for (i < 65) {
        if (direct.bytes[i] != (i + 1)::u8 || indirect.bytes[i] != (i + 1)::u8) { ret 4; }
        i = i + 1;
    }
    i = 0;
    for (i < 65) { if (payload.bytes[i] != (i + 1)::u8) { ret 5; } i = i + 1; }
    ret 0;
}

rec CarrierBytes {
    memory: [16][32]u8;
    extent: [16]u32;
    virtual: [64][16]u8;
    physical: [4][16]u8;
    registers: [4]i32;
}

fun t_carrier_address(bytes: *CarrierBytes, operand: mir.MirOperand, width: u32) *u8 {
    if (width > 16) { ret nil; }
    if (operand.kind == mir.MIR_OP_VREG) {
        if (operand.vreg >= 64) { ret nil; }
        ret ?bytes.virtual[operand.vreg][0];
    }
    if (operand.kind == mir.MIR_OP_PREG) {
        var i: u32 = 0;
        for (i < 4) {
            if (bytes.registers[i] == operand.preg::i32) { ret ?bytes.physical[i][0]; }
            i = i + 1;
        }
        ret nil;
    }
    if (operand.kind != mir.MIR_OP_MEM || operand.imm < 0) { ret nil; }
    var key: u32 = operand.vreg;
    if (key == mir.MIR_VREG_NIL) { key = 15; }
    if (key >= 16 || operand.imm::u64 + width::u64 > bytes.extent[key]::u64) { ret nil; }
    ret ?bytes.memory[key][operand.imm::u32];
}

fun t_run_carriers(bytes: *CarrierBytes, block: *mir.MirBlock) i32 {
    var placed: bool = false;
    var i: u32 = 0;
    for (i < block.instr_count) {
        val mi: *mir.MirInstr = ?block.instrs[i];
        if (mi.opcode != mir.MIR_MOV && mi.opcode != mir.MIR_STORE && mi.opcode != mir.MIR_MEMCPY) { ret 1; }
        var width: u32 = mi.width::u32;
        if (mi.opcode == mir.MIR_MEMCPY) { width = mi.operands[2].imm::u32; }
        if (placed && (mi.operands[1].kind == mir.MIR_OP_MEM || mi.opcode == mir.MIR_MEMCPY)) { ret 2; }
        if (mi.operands[0].kind == mir.MIR_OP_PREG) { placed = true; }
        val dst: *u8 = t_carrier_address(bytes, mi.operands[0], width);
        if (dst == nil) { ret 3; }
        var snapshot: [16]u8;
        if (mi.operands[1].kind == mir.MIR_OP_IMM) {
            if (mi.operands[1].imm != 0) { ret 4; }
        } or {
            val src: *u8 = t_carrier_address(bytes, mi.operands[1], width);
            if (src == nil) { ret 5; }
            var j: u32 = 0;
            for (j < width) { snapshot[j] = src[j]; j = j + 1; }
        }
        var j: u32 = 0;
        for (j < width) { dst[j] = snapshot[j]; j = j + 1; }
        i = i + 1;
    }
    ret 0;
}

fun t_carrier_materialization(tgt: *target.Target, slot: abi.ParamSlot,
                              store: bool, separate: bool, insufficient: bool) i32 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var f: mir.MirFunction;
    fin { mir.dnit_function(?alloc, ?f); }
    var ctx: context.LowerCtx;
    ctx.alloc = ?alloc;
    ctx.tgt = tgt;
    ctx.layout = target.layout_machine(tgt);
    ctx.f = ?f;
    val vr: R.Result[*mir.MirVReg, str] = A.allocate[mir.MirVReg](?alloc, 16);
    if (R.is_err[*mir.MirVReg, str](vr)) { ret 2; }
    f.vregs = R.unwrap_ok[*mir.MirVReg, str](vr);
    f.vreg_cap = 16;
    if (R.is_err[u32, str](context.new_vreg(?ctx, mir.REG_CLASS_GP))) { ret 2; }
    var mb: mir.MirBlock;
    fin { mir.dnit_block(?alloc, ?mb); }
    var registers: mir.MirBlock;
    fin { mir.dnit_block(?alloc, ?registers); }
    val er: R.Result[u64, str] = abi.carrier_storage_extent(?slot);
    if (R.is_err[u64, str](er)) { ret 3; }
    val extent: u64 = R.unwrap_ok[u64, str](er);
    var plan: PiecePlan;
    plan.store = store;
    plan.mem_slot = true;
    plan.mem_base = 0;
    plan.stack_ok = true;
    plan.registers = ?mb;
    if (separate) { plan.registers = ?registers; }
    plan.owned_extent = extent;
    if (insufficient) { plan.owned_extent = extent - 1; }
    val mr: R.Result[R.Void, str] = materialize_pieces(?ctx, ?mb, slot, plan);
    if (insufficient) {
        if (!R.is_err[R.Void, str](mr) || mb.instr_count != 0) { ret 4; }
        ret 0;
    }
    if (R.is_err[R.Void, str](mr)) { ret 5; }
    if (separate && R.is_err[R.Void, str](place_call_registers(?ctx, ?mb, ?registers))) { ret 6; }
    var bytes: CarrierBytes;
    var i: u32 = 0;
    for (i < 16) {
        var j: u32 = 0;
        for (j < 32) { bytes.memory[i][j] = 165; j = j + 1; }
        i = i + 1;
    }
    bytes.extent[0] = slot.size::u32;
    if (store) { bytes.extent[0] = extent::u32; }
    i = 0;
    for (i < f.frame.slot_count) {
        val owned: *mir.MirSlot = ?f.frame.slots[i];
        if (owned.value == 0 || owned.value >= 15 || owned.size > 16) { ret 7; }
        bytes.extent[owned.value] = owned.size;
        i = i + 1;
    }
    i = 0;
    for (i < slot.size::u32) { bytes.memory[0][i] = (i * 17 + 3)::u8; i = i + 1; }
    i = 0;
    for (i < slot.piece_count) {
        val p: abi.ParamPiece = slot.pieces[i];
        bytes.registers[i] = p.reg;
        var j: u32 = 0;
        for (j < p.width::u32) {
            var byte: u8 = 0;
            if (p.src_off::u64 + j::u64 < slot.size) { byte = ((p.src_off::u32 + j) * 17 + 3)::u8; }
            if (store) {
                if (p.kind == abi.PIECE_STACK) {
                    if (p.src_off::u64 + j::u64 < slot.size) { bytes.memory[15][j] = byte; }
                }
                or { bytes.physical[i][j] = byte; }
            }
            j = j + 1;
        }
        if (p.kind == abi.PIECE_STACK) { bytes.extent[15] = (slot.size - p.src_off::u64)::u32; }
        i = i + 1;
    }
    val ran: i32 = t_run_carriers(?bytes, ?mb);
    if (ran != 0) { ret 10 + ran; }
    i = 0;
    for (i < slot.piece_count) {
        val p: abi.ParamPiece = slot.pieces[i];
        var count: u32 = p.width::u32;
        if (p.kind == abi.PIECE_STACK) { count = bytes.extent[15]; }
        var j: u32 = 0;
        for (j < count) {
            var expected: u8 = 0;
            if (p.src_off::u64 + j::u64 < slot.size) { expected = ((p.src_off::u32 + j) * 17 + 3)::u8; }
            var actual: u8 = bytes.physical[i][j];
            if (p.kind == abi.PIECE_STACK) { actual = bytes.memory[15][j]; }
            if (store) { actual = bytes.memory[0][p.src_off::u32 + j]; }
            if (actual != expected) { ret 20; }
            j = j + 1;
        }
        i = i + 1;
    }
    i = bytes.extent[0];
    for (i < 32) { if (bytes.memory[0][i] != 165) { ret 21; } i = i + 1; }
    i = bytes.extent[15];
    for (i < 32) { if (bytes.memory[15][i] != 165) { ret 22; } i = i + 1; }
    ret 0;
}

test "mach.lang.be.codegen.mir.abi:carrier_memory_exact_extent_and_padding" {
    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](treg.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    var target_index: u32 = 0;
    for (target_index < 6) {
        val tr: R.Result[target.Target, str] = treg.select(?reg, CONV_ARCH[target_index], CONV_OS[target_index], CONV_ABI[target_index]);
        if (R.is_err[target.Target, str](tr)) { ret 2; }
        var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);
        val word: u32 = tgt.model.gpr_width;
        val arg: abi.ArgPassingFn = tgt.abi.arg_passing;
        val result: abi.RetPassingFn = tgt.abi.ret_passing;
        val classified_arg: abi.ParamSlot = arg(0, 4, 4, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
        val classified_ret: abi.ParamSlot = result(4, 4, false, 0, true, false, 0, 0, abi.agg_none());
        if (classified_arg.size != 4 || classified_ret.size != 4 ||
            classified_arg.piece_count != 1 || classified_ret.piece_count != 1 ||
            classified_arg.pieces[0].width != word::u8 || classified_ret.pieces[0].width != word::u8) { ret 10; }
        var size: u64 = 0;
        for (size <= word::u64 * 2) {
            var slot: abi.ParamSlot = abi.make_slot_pair(abi.CLASS_GP, 0, 1, 0, size, word);
            if (size < word::u64) { slot.piece_count = 1; }
            if (t_carrier_materialization(?tgt, slot, false, false, false) != 0) { ret 3; }
            if (t_carrier_materialization(?tgt, slot, false, true, false) != 0) { ret 4; }
            if (t_carrier_materialization(?tgt, slot, true, false, false) != 0) { ret 5; }
            if (t_carrier_materialization(?tgt, slot, true, false, true) != 0) { ret 6; }
            if (size > word::u64) {
                slot.pieces[1].kind = abi.PIECE_STACK;
                if (t_carrier_materialization(?tgt, slot, false, false, false) != 0) { ret 7; }
                if (t_carrier_materialization(?tgt, slot, true, false, false) != 0) { ret 8; }
            }
            size = size + 1;
        }
        var fp: abi.ParamSlot = abi.make_slot(abi.CLASS_FP, isa.regid_make(isa.REG_CLASS_ID_XMM, 0), 0, 3, 8);
        if (t_carrier_materialization(?tgt, fp, false, false, false) != 0) { ret 9; }
        target_index = target_index + 1;
    }
    ret 0;
}
