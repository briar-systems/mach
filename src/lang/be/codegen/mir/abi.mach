#[testing]
val CONV_COUNT: u32 = 7;
#[testing]
val CONV_ARCH: [7]str = [7]str{"x86_64", "x86_64", "x86_64", "aarch64", "riscv64", "rv32imafdc", "spirv"};
#[testing]
val CONV_OS: [7]str = [7]str{"linux", "windows", "darwin", "linux", "linux", "freestanding", "freestanding"};
#[testing]
val CONV_ABI: [7]str = [7]str{"sysv64", "win64", "sysv64", "aapcs64", "lp64d", "ilp32d", "spirv"};

val MAX_GP_ARG_REGS: i32 = 16;

pub fun require_abi(tgt: *target.Target) err[fail.Fail] {
    if (tgt == nil)     { ret err[fail.Fail].err{fail.message("mir.lower_ir: nil target")}; }
    if (tgt.abi == nil) { ret err[fail.Fail].err{fail.message("mir.lower_ir: target has no ABI vtable")}; }
    if (tgt.isa == nil) { ret err[fail.Fail].err{fail.message("mir.lower_ir: target has no ISA vtable")}; }
    if (tgt.abi.arg_passing == nil || tgt.abi.ret_passing == nil) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: ABI vtable exposes no arg/ret classifier")};
    }
    ret err[fail.Fail].ok{};
}

pub fun abi_gp_arg_reg(tgt: *target.Target, index: i32, out: *i32) err[fail.Fail] {
    if (tgt.abi.gp_arg_regs == nil) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: ABI vtable exposes no GP argument register file")};
    }
    var regs: [16]isa.Register;
    val n:    i32 = tgt.abi.gp_arg_regs(?regs[0]);
    if (index < 0 || index >= n || index >= MAX_GP_ARG_REGS) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: GP argument register index out of range")};
    }
    @out = regs[index].id;
    ret err[fail.Fail].ok{};
}

pub fun abi_va_model(tgt: *target.Target, out: *abi.VaModel) err[fail.Fail] {
    if (tgt.abi.va_model == nil) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: a variadic call is not supported by this calling convention (no variadic save model)")};
    }
    @out = tgt.abi.va_model();
    ret err[fail.Fail].ok{};
}

val EB_NO_CLASS: u8 = 0;
val EB_SSE:      u8 = 1;
val EB_INTEGER:  u8 = 2;

fun mark_eightbyte_range(classes: *u8, off: u64, size: u64, cls: u8) {
    if (size == 0) { ret; }
    var i:    u64 = off / 8;
    val last: u64 = (off + size - 1) / 8;
    for (i <= last) {
        if (i < 2 && cls > classes[i]) { classes[i] = cls; }
        i = i + 1;
    }
}

# merges the class of every scalar the aggregate holds into the eightbytes it covers. members are never
# collected into a bounded list first: a tag's unit cases are zero-width members and its payloads overlap, so
# the member count of a 16-byte aggregate has no bound, and a member dropped past any cap is a dropped class
fun mark_eightbytes(ctx: *context.LowerCtx, ty: type.IrTypeId, base_off: u64, classes: *u8) {
    val it: opt[*type.IrType] = type.get(ctx.types, ty);
    if (!sel it.some) { ret; }
    val t: *type.IrType = it.some;

    if (t.kind == type.IRT_STRUCT) {
        var i: u32 = 0;
        for (i < t.data.struct_.field_count) {
            val fo: u64 = type.byte_offset_for_machine(ctx.types, ty, i, ctx.layout)::u64;
            mark_eightbytes(ctx, t.data.struct_.fields[i], base_off + fo, classes);
            i = i + 1;
        }
        ret;
    }
    if (t.kind == type.IRT_ARRAY) {
        val elem: type.IrTypeId = t.data.array_.element;
        val es:   u64           = type.byte_size_for_machine(ctx.types, elem, ctx.layout)::u64;
        if (es == 0) { ret; }
        val n: u32 = type.array_count(ctx.types, ty);
        var i: u32 = 0;
        for (i < n) {
            mark_eightbytes(ctx, elem, base_off + i::u64 * es, classes);
            i = i + 1;
        }
        ret;
    }
    if (t.kind == type.IRT_UNION) {
        var i: u32 = 0;
        for (i < t.data.struct_.field_count) {
            mark_eightbytes(ctx, t.data.struct_.fields[i], base_off, classes);
            i = i + 1;
        }
        ret;
    }
    if (t.kind == type.IRT_TAG) {
        mark_eightbyte_range(classes, base_off, type.tag_discriminator_bytes(ctx.types, ty)::u64, EB_INTEGER);
        val payload_off: u64 = base_off + type.tag_payload_offset_for_machine(ctx.types, ty, ctx.layout)::u64;
        var i:           u32 = 0;
        for (i < t.data.tag_.case_count) {
            mark_eightbytes(ctx, t.data.tag_.cases[i], payload_off, classes);
            i = i + 1;
        }
        ret;
    }

    var cls: u8 = EB_INTEGER;
    if (t.kind == type.IRT_FLOAT) { cls = EB_SSE; }
    mark_eightbyte_range(classes, base_off, type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64, cls);
}

# flattens an aggregate into at most `cap` scalar leaves for a convention that passes small aggregates field
# by field; a union or tag is never flattened, and an aggregate over the cap reports cap + 1
fun collect_leaves(ctx: *context.LowerCtx, ty: type.IrTypeId, base_off: u64, out: *abi.AggField, cap: u32, count: u32) u32 {
    if (count > cap) { ret count; }
    val it: opt[*type.IrType] = type.get(ctx.types, ty);
    if (!sel it.some) { ret cap + 1; }
    val t: *type.IrType = it.some;

    if (t.kind == type.IRT_STRUCT) {
        var c: u32 = count;
        var i: u32 = 0;
        for (i < t.data.struct_.field_count) {
            val fo: u64 = type.byte_offset_for_machine(ctx.types, ty, i, ctx.layout)::u64;
            c = collect_leaves(ctx, t.data.struct_.fields[i], base_off + fo, out, cap, c);
            if (c > cap) { ret c; }
            i = i + 1;
        }
        ret c;
    }
    if (t.kind == type.IRT_ARRAY) {
        val elem: type.IrTypeId = t.data.array_.element;
        val es:   u64           = type.byte_size_for_machine(ctx.types, elem, ctx.layout)::u64;
        val n:    u32           = type.array_count(ctx.types, ty);
        var c:    u32           = count;
        var i:    u32           = 0;
        for (i < n) {
            c = collect_leaves(ctx, elem, base_off + i::u64 * es, out, cap, c);
            if (c > cap) { ret c; }
            i = i + 1;
        }
        ret c;
    }
    if (t.kind == type.IRT_UNION || t.kind == type.IRT_TAG) { ret cap + 1; }

    if (count < cap) {
        out[count].is_float = t.kind == type.IRT_FLOAT;
        out[count].offset   = base_off::u32;
        out[count].width    = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u8;
    }
    ret count + 1;
}

# the System V unaligned-field rule: a member whose offset is not a multiple of its own type's alignment
# makes the whole aggregate MEMORY class. every struct member is checked against its type's alignment at
# every nesting level and every array element is visited at its own offset, so a packed element whose
# fields sit aligned in element 0 and unaligned in element 1 is caught, exactly as clang walks it
fun has_unaligned_field(ctx: *context.LowerCtx, ty: type.IrTypeId, base_off: u64) bool {
    val it: opt[*type.IrType] = type.get(ctx.types, ty);
    if (!sel it.some) { ret false; }
    val t: *type.IrType = it.some;
    if (t.kind == type.IRT_STRUCT || t.kind == type.IRT_UNION) {
        var i: u32 = 0;
        for (i < t.data.struct_.field_count) {
            val fty: type.IrTypeId = t.data.struct_.fields[i];
            var fo:  u64           = 0;
            if (t.kind == type.IRT_STRUCT) { fo = type.byte_offset_for_machine(ctx.types, ty, i, ctx.layout)::u64; }
            val fal: u64 = type.byte_align_for_machine(ctx.types, fty, ctx.layout)::u64;
            if (fal != 0 && (base_off + fo) % fal != 0)       { ret true; }
            if (has_unaligned_field(ctx, fty, base_off + fo)) { ret true; }
            i = i + 1;
        }
        ret false;
    }
    if (t.kind == type.IRT_ARRAY) {
        val elem: type.IrTypeId = t.data.array_.element;
        val es:   u64           = type.byte_size_for_machine(ctx.types, elem, ctx.layout)::u64;
        val n:    u32           = type.array_count(ctx.types, ty);
        var i:    u32           = 0;
        for (i < n) {
            if (has_unaligned_field(ctx, elem, base_off + i::u64 * es)) { ret true; }
            i = i + 1;
        }
    }
    if (t.kind == type.IRT_TAG) {
        # a tag is the record of its layout: the discriminator at offset 0 against its own width, then every
        # case payload at the common payload offset against that case's alignment
        val dal: u64 = t.data.tag_.disc_bytes::u64;
        if (dal != 0 && base_off % dal != 0) { ret true; }
        val po: u64 = base_off + type.tag_payload_offset_for_machine(ctx.types, ty, ctx.layout)::u64;
        var i:  u32 = 0;
        for (i < t.data.tag_.case_count) {
            val cty: type.IrTypeId = t.data.tag_.cases[i];
            val cal: u64           = type.byte_align_for_machine(ctx.types, cty, ctx.layout)::u64;
            if (cal != 0 && po % cal != 0)         { ret true; }
            if (has_unaligned_field(ctx, cty, po)) { ret true; }
            i = i + 1;
        }
    }
    ret false;
}

fun aggregate_eightbyte_mask(ctx: *context.LowerCtx, ty: type.IrTypeId) u8 {
    if (!context.value_is_aggregate(ctx, ty)) { ret 0; }
    val size: u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    if (size == 0 || size > 16)          { ret 0; }
    if (has_unaligned_field(ctx, ty, 0)) { ret abi.EB_UNALIGNED; }
    var classes: [2]u8;
    classes[0] = EB_NO_CLASS;
    classes[1] = EB_NO_CLASS;
    mark_eightbytes(ctx, ty, 0, ?classes[0]);
    var mask: u8 = 0;
    if (classes[0] == EB_SSE)                  { mask = mask | abi.EB_SSE_LO; }
    if (classes[1] == EB_SSE)                  { mask = mask | abi.EB_SSE_HI; }
    if (classes[0] == EB_NO_CLASS)             { mask = mask | abi.EB_EMPTY_LO; }
    if (size > 8 && classes[1] == EB_NO_CLASS) { mask = mask | abi.EB_EMPTY_HI; }
    ret mask;
}

fun hfa_walk(ctx: *context.LowerCtx, ty: type.IrTypeId, out_elem: *u32, out_count: *u32) bool {
    val it: opt[*type.IrType] = type.get(ctx.types, ty);
    if (!sel it.some) { ret false; }
    val t: *type.IrType = it.some;

    if (t.kind == type.IRT_FLOAT) {
        @out_elem  = type.byte_size_for_machine(ctx.types, ty, ctx.layout);
        @out_count = 1;
        ret true;
    }
    if (t.kind == type.IRT_ARRAY) {
        var ee: u32 = 0;
        var ec: u32 = 0;
        if (!hfa_walk(ctx, t.data.array_.element, ?ee, ?ec)) { ret false; }
        @out_elem  = ee;
        @out_count = ec * type.array_count(ctx.types, ty);
        ret true;
    }
    if (t.kind == type.IRT_STRUCT) {
        var elem:  u32 = 0;
        var total: u32 = 0;
        var i:     u32 = 0;
        for (i < t.data.struct_.field_count) {
            var fe: u32 = 0;
            var fc: u32 = 0;
            if (!hfa_walk(ctx, t.data.struct_.fields[i], ?fe, ?fc)) { ret false; }
            if (elem == 0)                                          { elem = fe; }
            or (elem != fe)                                         { ret false; }
            total = total + fc;
            i     = i + 1;
        }
        if (total == 0) { ret false; }
        @out_elem  = elem;
        @out_count = total;
        ret true;
    }
    if (t.kind == type.IRT_UNION) {
        var elem: u32 = 0;
        var maxc: u32 = 0;
        var i:    u32 = 0;
        for (i < t.data.struct_.field_count) {
            var me: u32 = 0;
            var mc: u32 = 0;
            if (!hfa_walk(ctx, t.data.struct_.fields[i], ?me, ?mc)) { ret false; }
            if (elem == 0)                                          { elem = me; }
            or (elem != me)                                         { ret false; }
            if (mc > maxc)                                          { maxc = mc; }
            i = i + 1;
        }
        if (elem == 0) { ret false; }
        @out_elem  = elem;
        @out_count = maxc;
        ret true;
    }
    ret false;
}

fun hfa_info(ctx: *context.LowerCtx, ty: type.IrTypeId, out_members: *u8, out_elem: *u8) {
    @out_members = 0;
    @out_elem    = 0;
    if (!context.value_is_aggregate(ctx, ty)) { ret; }
    var elem:  u32 = 0;
    var count: u32 = 0;
    if (!hfa_walk(ctx, ty, ?elem, ?count)) { ret; }
    if (count < 1 || count > 4)            { ret; }
    if (elem != 4 && elem != 8)            { ret; }
    @out_members = count::u8;
    @out_elem    = elem::u8;
}

val AGG_MAX_LEAVES: u32 = 2;

fun agg_layout(ctx: *context.LowerCtx, ty: type.IrTypeId, is_aggr: bool) abi.AggLayout {
    var out: abi.AggLayout;
    out.field_count = 0;
    if (!is_aggr) { ret out; }
    val n: u32 = collect_leaves(ctx, ty, 0, ?out.fields[0], AGG_MAX_LEAVES, 0);
    if (n == 1 || n == 2) { out.field_count = n::u8; }
    ret out;
}

# the registers an argument consumes are the slot's declaration, not a count of
# its pieces: an ABI may skip or exhaust registers it never fills, in either bank
fun advance_arg_cursors(slot: *abi.ParamSlot, gp_used: *i32, fp_used: *i32) {
    @gp_used = @gp_used + slot.gp_consumed;
    @fp_used = @fp_used + slot.fp_consumed;
}

fun slot_has_stack_piece(slot: *abi.ParamSlot) bool {
    var i: u32 = 0;
    for (i < slot.piece_count) {
        if (slot.pieces[i].kind == abi.PIECE_STACK) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun split_stack_bytes(tgt: *target.Target, slot: *abi.ParamSlot) i64 {
    var total: i64 = 0;
    var i:     u32 = 0;
    for (i < slot.piece_count) {
        if (slot.pieces[i].kind == abi.PIECE_STACK) {
            total = total + context.stack_slot_bytes(tgt, slot.pieces[i].width::u64);
        }
        i = i + 1;
    }
    ret total;
}

fun sret_reserves_gp(ret_class: abi.ParamClass, in_argfile: bool) bool {
    ret ret_class == abi.CLASS_SRET && in_argfile;
}

fun round_up_i64(value: i64, align: u64) i64 {
    if (align <= 1) { ret value; }
    val a:   i64 = align::i64;
    val rem: i64 = value % a;
    if (rem == 0) { ret value; }
    ret value + (a - rem);
}

fun stack_arg_align(tgt: *target.Target, class: abi.ParamClass, align: u64, natural: bool) u64 {
    val ptr:  u64 = tgt.model.pointer_width::u64;
    val word: u64 = tgt.model.gpr_width::u64;
    if (class == abi.CLASS_STACK_BYREF)     { ret ptr; }
    if (class == abi.CLASS_VEC_STACK_BYREF) { ret ptr; }
    if (natural)                            { ret align; }
    if (align < word)                       { ret word; }
    ret align;
}

fun stack_arg_bytes(tgt: *target.Target, size: u64, natural: bool) i64 {
    if (natural) { ret size::i64; }
    ret context.stack_slot_bytes(tgt, size);
}

# the alignment an argument's register assignment honors: the type's own,
# capped where the platform starts an aligned value in any register (#3922).
# stack placement keeps the type's own alignment
fun reg_arg_align(tgt: *target.Target, align: u64) u64 {
    val cap: u64 = tgt.reg_arg_align::u64;
    if (cap != 0 && align > cap) { ret cap; }
    ret align;
}

# the alignment an argument is placed by, in registers and on the stack: its
# type's own, or for an aggregate where the target places one by its natural
# alignment, the one its members give it before its own #[align] (#3929)
fun arg_align(ctx: *context.LowerCtx, ty: type.IrTypeId, is_aggr: bool) u64 {
    if (is_aggr && ctx.tgt.agg_arg_natural_align) {
        ret type.natural_align_for_machine(ctx.types, ty, ctx.layout)::u64;
    }
    ret type.byte_align_for_machine(ctx.types, ty, ctx.layout)::u64;
}

# a composite that is no HFA or HVA takes a stack slot aligned to at least a word
# and rounded up to a word even where fixed arguments are otherwise placed at their
# natural size and alignment, as Apple clang places one (#3950)
fun word_composite(is_aggr: bool, hfa_members: u8) bool {
    ret is_aggr && hfa_members == 0;
}

fun natural_stack_slot(tgt: *target.Target, variadic: bool) bool {
    if (variadic) { ret false; }
    ret tgt.fixed_args_natural_size;
}

fun stack_only_tail_slot(slot: abi.ParamSlot) abi.ParamSlot {
    if (is_stack_slot_class(slot.class)) { ret slot; }
    # a slot that rides no carrier, an empty record's, takes no stack either (#3930)
    if (slot.piece_count == 0) { ret slot; }
    if (slot.class == abi.CLASS_BYREF) {
        ret abi.make_slot(abi.CLASS_STACK_BYREF, -1, 0, slot.size, 0);
    }
    if (slot.class == abi.CLASS_VEC_BYREF) {
        ret abi.make_slot_indirect(abi.CLASS_VEC_STACK_BYREF, -1, 0, slot.size,
            slot.indirect_size, slot.indirect_align);
    }
    ret abi.make_slot(abi.CLASS_STACK, -1, 0, slot.size, 0);
}

fun is_stack_slot_class(class: abi.ParamClass) bool {
    ret class == abi.CLASS_STACK || class == abi.CLASS_STACK_BYREF || class == abi.CLASS_VEC_STACK_BYREF;
}

pub fun classify_signature(ctx: *context.LowerCtx, sig: type.IrTypeId, ret_type: type.IrTypeId,
    out: *abi.SigLayout) err[fail.Fail] {
    val rok: err[fail.Fail] = require_abi(ctx.tgt);
    if (sel rok.err) { ret rok; }

    val classify_arg: abi.ArgPassingFn = ctx.tgt.abi.arg_passing;
    val classify_ret: abi.RetPassingFn = ctx.tgt.abi.ret_passing;

    out.params      = nil;
    out.param_count = 0;

    val ret_size:  u64  = type.byte_size_for_machine(ctx.types, ret_type, ctx.layout)::u64;
    val ret_float: bool = context.value_is_float(ctx, ret_type);
    val ret_aggr:  bool = context.value_is_aggregate(ctx, ret_type);
    val ret_vec:   bool = context.value_is_vector(ctx, ret_type);
    val ret_eb:    u8   = aggregate_eightbyte_mask(ctx, ret_type);
    var ret_hm:    u8   = 0;
    var ret_he:    u8   = 0;
    hfa_info(ctx, ret_type, ?ret_hm, ?ret_he);
    val wants_agg: bool          = ctx.tgt.abi.consumes_agg_layout;
    var ret_agg:   abi.AggLayout = abi.agg_none();
    if (wants_agg) { ret_agg = agg_layout(ctx, ret_type, ret_aggr); }
    out.ret_slot = classify_ret(ret_size, 0, ret_float, ret_eb, ret_aggr, ret_vec, ret_hm, ret_he, ret_agg);

    val fixed_natural: bool = natural_stack_slot(ctx.tgt, false);

    var gp_used:   i32 = 0;
    var fp_used:   i32 = 0;
    var stack_off: i64 = ctx.tgt.abi.shadow_space::i64;

    if (sret_reserves_gp(out.ret_slot.class, ctx.tgt.abi.indirect_result_in_argfile)) {
        gp_used = 1;
    }

    val opt_sig: opt[*type.IrType] = type.get(ctx.types, sig);
    var is_fn:   bool              = false;
    if (sel opt_sig.some) {
        val st: *type.IrType = opt_sig.some;
        is_fn = st.kind == type.IRT_FN;
    }
    if (!is_fn) {
        out.gp_used   = gp_used;
        out.fp_used   = fp_used;
        out.stack_off = stack_off;
        ret err[fail.Fail].ok{};
    }
    if (sel opt_sig.none) { ret err[fail.Fail].ok{}; }
    val t: *type.IrType = opt_sig.some;

    val pc:    u32            = t.data.fn.param_count;
    var slots: *abi.ParamSlot = nil;
    if (pc > 0) {
        val sb: res[*abi.ParamSlot, A.Error] = A.allocate[abi.ParamSlot](ctx.alloc, pc::usize);
        if (sel sb.err) { ret err[fail.Fail].err{fail.refused(sb.err)}; }
        slots = sb.ok;
    }

    var i: u32 = 0;
    for (i < pc) {
        val pty: type.IrTypeId = t.data.fn.params[i];
        val psz: u64           = type.byte_size_for_machine(ctx.types, pty, ctx.layout)::u64;
        val pfl: bool          = context.value_is_float(ctx, pty);
        val pag: bool          = context.value_is_aggregate(ctx, pty);
        val pal: u64           = arg_align(ctx, pty, pag);
        val peb: u8            = aggregate_eightbyte_mask(ctx, pty);
        var phm: u8            = 0;
        var phe: u8            = 0;
        hfa_info(ctx, pty, ?phm, ?phe);
        var pagg: abi.AggLayout = abi.agg_none();
        if (wants_agg) { pagg = agg_layout(ctx, pty, pag); }
        val pvec: bool          = context.value_is_vector(ctx, pty);
        var slot: abi.ParamSlot = classify_arg(i::i32, psz, reg_arg_align(ctx.tgt, pal), pfl, peb, pag, pvec, gp_used, fp_used, phm, phe, pagg);

        if (is_stack_slot_class(slot.class)) {
            val pnat: bool = fixed_natural && !word_composite(pag, phm);
            stack_off   = round_up_i64(stack_off, stack_arg_align(ctx.tgt, slot.class, pal, pnat));
            slot.offset = stack_off;
            stack_off   = stack_off + stack_arg_bytes(ctx.tgt, slot.size, pnat);
            advance_arg_cursors(?slot, ?gp_used, ?fp_used);
        }
        or {
            advance_arg_cursors(?slot, ?gp_used, ?fp_used);
            if (slot_has_stack_piece(?slot)) {
                stack_off   = round_up_i64(stack_off, ctx.tgt.model.gpr_width::u64);
                slot.offset = stack_off;
                stack_off   = stack_off + split_stack_bytes(ctx.tgt, ?slot);
            }
        }

        slots[i] = slot;
        i        = i + 1;
    }

    out.params      = slots;
    out.param_count = pc;
    out.gp_used     = gp_used;
    out.fp_used     = fp_used;
    out.stack_off   = stack_off;
    ret err[fail.Fail].ok{};
}

pub fun sig_layout_free(ctx: *context.LowerCtx, layout: *abi.SigLayout) {
    if (layout.params != nil && layout.param_count > 0) {
        A.deallocate[abi.ParamSlot](ctx.alloc, layout.params, layout.param_count::usize);
        layout.params      = nil;
        layout.param_count = 0;
    }
}

fun call_ret_type(ctx: *context.LowerCtx, sig: type.IrTypeId, fallback: type.IrTypeId) type.IrTypeId {
    val opt_: opt[*type.IrType] = type.get(ctx.types, sig);
    if (sel opt_.some) {
        val st: *type.IrType = opt_.some;
        if (st.kind == type.IRT_FN && context.value_is_vector(ctx, st.data.fn.ret_type)) {
            ret st.data.fn.ret_type;
        }
    }
    ret fallback;
}

fun value_slot_valid(slot: *abi.ParamSlot, extent: u64) bool {
    ret slot.class == abi.CLASS_VALUE && slot.size == extent && mir.preg_is_nil(slot.reg)
        && slot.piece_count == 0 && slot.offset == 0 && slot.indirect_size == 0 && slot.indirect_align == 0;
}

fun value_operand(ctx: *context.LowerCtx, v: value.Value) res[mir.MirOperand, fail.Fail] {
    val op_r: res[mir.MirOperand, fail.Fail] = context.lower_value(ctx, v);
    if (sel op_r.err) { ret op_r; }
    var op: mir.MirOperand = op_r.ok;
    if (context.value_is_aggregate(ctx, v.ty) && op.kind == mir.MIR_OP_VREG) {
        op = mir.op_mem_value(op.vreg, 0);
    }
    ret res[mir.MirOperand, fail.Fail].ok{op};
}

fun push_value_instr(ctx: *context.LowerCtx, mb: *mir.MirBlock, opcode: mir.MirOpcode,
    ops: *mir.MirOperand, count: u32) err[fail.Fail] {
    val pushed: err[fail.Fail] = context.push_instr(ctx, mb, mir.instr(opcode, ops, count, 0, 0));
    if (sel pushed.err) { A.deallocate[mir.MirOperand](ctx.alloc, ops, count::usize); }
    ret pushed;
}

fun lower_value_call(ctx: *context.LowerCtx, mb: *mir.MirBlock, inst: *instruction.Instruction,
    iid: id.InstructionId, ret_type: type.IrTypeId, slots: *abi.SigLayout) err[fail.Fail] {
    val sig: opt[*type.IrType] = type.get(ctx.types, inst.aux_ty);
    if (sel sig.none) { ret err[fail.Fail].err{fail.message("mir.abi: logical call requires a typed signature")}; }
    val fn_ty: *type.IrType = sig.some;
    if (fn_ty.kind != type.IRT_FN || fn_ty.data.fn.variadic || inst.operand_count - 1 != slots.param_count) {
        ret err[fail.Fail].err{fail.message("mir.abi: logical call requires exact nonvariadic arguments")};
    }
    if (!value_slot_valid(?slots.ret_slot, type.byte_size_for_machine(ctx.types, ret_type, ctx.layout)::u64)) {
        ret err[fail.Fail].err{fail.message("mir.abi: invalid logical result slot")};
    }
    var i: u32 = 0;
    for (i < slots.param_count) {
        if (!value_slot_valid(?slots.params[i], type.byte_size_for_machine(ctx.types, fn_ty.data.fn.params[i], ctx.layout)::u64)) {
            ret err[fail.Fail].err{fail.message("mir.abi: invalid logical argument slot")};
        }
        i = i + 1;
    }
    val dst:    mir.VRegId     = context.instr_vreg(ctx, iid);
    var result: mir.MirOperand = mir.op_vreg(dst);
    if (context.value_is_aggregate(ctx, ret_type)) {
        if (mir.vreg_is_nil(dst)) { ret err[fail.Fail].err{fail.message("mir.abi: logical composite call has no result owner")}; }
        val home: err[fail.Fail] = context.alloc_object_storage(ctx, mb, dst, ret_type);
        if (sel home.err) { ret home; }
        result = mir.op_mem_value(dst, 0);
    }
    if (inst.operand_count == 0xFFFFFFFF) { ret err[fail.Fail].err{fail.message("mir.abi: logical call operand extent overflow")}; }
    val count: u32                           = inst.operand_count + 1;
    val ar:    res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, count::usize);
    if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
    val ops:        *mir.MirOperand                = ar.ok;
    val lowered_14: res[mir.MirOperand, fail.Fail] = context.lower_callee(ctx, inst.operands[0]);
    if (sel lowered_14.err) { ret err[fail.Fail].err{lowered_14.err}; }
    ops[0] = lowered_14.ok;
    ops[1] = result;
    i      = 0;
    for (i < slots.param_count) {
        val lowered_15: res[mir.MirOperand, fail.Fail] = value_operand(ctx, inst.operands[i + 1]);
        if (sel lowered_15.err) { ret err[fail.Fail].err{lowered_15.err}; }
        ops[i + 2] = lowered_15.ok;
        i          = i + 1;
    }
    ret push_value_instr(ctx, mb, mir.MIR_VALUE_CALL, ops, count);
}

fun lower_value_params(ctx: *context.LowerCtx, mb: *mir.MirBlock, slots: *abi.SigLayout) err[fail.Fail] {
    if (slots.param_count != ctx.param_count || slots.param_count != ctx.fn.param_count) {
        ret err[fail.Fail].err{fail.message("mir.abi: logical parameter signature does not match its bindings")};
    }
    var i: u32 = 0;
    for (i < slots.param_count) {
        val ty: type.IrTypeId = ctx.fn.params[i].ty;
        if (!value_slot_valid(?slots.params[i], type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64)) {
            ret err[fail.Fail].err{fail.message("mir.abi: invalid logical parameter slot")};
        }
        val dst:  mir.VRegId     = ctx.param_vregs[i];
        var dest: mir.MirOperand = mir.op_vreg(dst);
        if (context.value_is_aggregate(ctx, ty)) {
            val home: err[fail.Fail] = context.alloc_object_storage(ctx, mb, dst, ty);
            if (sel home.err) { ret home; }
            dest = mir.op_mem_value(dst, 0);
        }
        val ar: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
        if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
        val ops: *mir.MirOperand = ar.ok;
        ops[0] = dest;
        ops[1] = mir.op_imm(i::i64);
        val pushed: err[fail.Fail] = push_value_instr(ctx, mb, mir.MIR_VALUE_PARAM, ops, 2);
        if (sel pushed.err) { ret pushed; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun lower_call(ctx: *context.LowerCtx, mb: *mir.MirBlock, inst: *instruction.Instruction, iid: id.InstructionId) err[fail.Fail] {
    if (inst.operand_count == 0) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: call with no callee operand")};
    }
    val rok: err[fail.Fail] = require_abi(ctx.tgt);
    if (sel rok.err) { ret rok; }

    var pending_registers: mir.MirBlock;
    fin { mir.dnit_block(ctx.alloc, ?pending_registers); }
    var registers: *mir.MirBlock = mb;
    if (ctx.tgt.model.flat_addressing) { registers = ?pending_registers; }

    val classify_arg: abi.ArgPassingFn = ctx.tgt.abi.arg_passing;

    val sig:      type.IrTypeId  = inst.aux_ty;
    val ret_type: type.IrTypeId  = call_ret_type(ctx, sig, inst.ty);
    var layout:   abi.SigLayout;
    val cls:      err[fail.Fail] = classify_signature(ctx, sig, ret_type, ?layout);
    if (sel cls.err) { ret cls; }

    if (context.values_convention(ctx)) {
        val vr: err[fail.Fail] = lower_value_call(ctx, mb, inst, iid, ret_type, ?layout);
        sig_layout_free(ctx, ?layout);
        ret vr;
    }

    val rslot: abi.ParamSlot = layout.ret_slot;

    val sig_it:    opt[*type.IrType] = type.get(ctx.types, sig);
    var sig_is_fn: bool              = false;
    var sig_is_va: bool              = false;
    if (sel sig_it.some) {
        val sig_t: *type.IrType = sig_it.some;
        sig_is_fn = sig_t.kind == type.IRT_FN;
        sig_is_va = sig_is_fn && sig_t.data.fn.variadic;
    }
    val variadic_call: bool = !sig_is_fn || sig_is_va || ((inst.operand_count - 1) > layout.param_count);

    val ret_size:            u64  = type.byte_size_for_machine(ctx.types, ret_type, ctx.layout)::u64;
    var ret_storage_align:   u32  = context.ret_align(ctx, ret_type);
    val ret_aggr:            bool = context.value_is_aggregate(ctx, ret_type);
    val ret_vector_register: bool = context.value_is_vector(ctx, inst.ty);
    val ret_mem:             bool = ret_aggr || (context.value_is_vector(ctx, ret_type) && !ret_vector_register && rslot.class == abi.CLASS_SRET);
    val ret_sret_register:   bool = rslot.class == abi.CLASS_SRET && !ret_mem;

    var gp_used:   i32 = layout.gp_used;
    var fp_used:   i32 = layout.fp_used;
    var stack_off: i64 = layout.stack_off;

    val res_dst:  mir.VRegId = context.instr_vreg(ctx, iid);
    var sret_ptr: mir.VRegId = mir.MIR_VREG_NIL;
    if (ret_mem && !mir.vreg_is_nil(res_dst)) {
        var ra:         err[fail.Fail] = err[fail.Fail].ok{};
        var owned_size: u64            = ret_size;
        if (rslot.class != abi.CLASS_SRET) {
            val extent: res[u64, fail.Fail] = abi.carrier_storage_extent(?rslot);
            if (sel extent.err) {
                sig_layout_free(ctx, ?layout);
                ret err[fail.Fail].err{extent.err};
            }
            owned_size = extent.ok;
            val alignment: res[u32, fail.Fail] = abi.carrier_storage_alignment(?rslot);
            if (sel alignment.err) {
                sig_layout_free(ctx, ?layout);
                ret err[fail.Fail].err{alignment.err};
            }
            if (alignment.ok > ret_storage_align) {
                ret_storage_align = alignment.ok;
            }
        }
        val ra_1: err[fail.Fail] = context.alloc_result_storage(ctx, mb, res_dst, owned_size, ret_storage_align);
        if (sel ra_1.err) {
            sig_layout_free(ctx, ?layout);
            ret ra_1;
        }
        sret_ptr = res_dst;
    }
    or (ret_sret_register && !mir.vreg_is_nil(res_dst)) {
        val sa: res[mir.VRegId, fail.Fail] = context.new_vreg(ctx, mir.REG_CLASS_GP);
        if (sel sa.err) {
            sig_layout_free(ctx, ?layout);
            ret err[fail.Fail].err{sa.err};
        }
        sret_ptr = sa.ok;
        val ra_1: err[fail.Fail] = context.alloc_result_storage(ctx, mb, sret_ptr, ret_size, context.ret_align(ctx, ret_type));
        if (sel ra_1.err) {
            sig_layout_free(ctx, ?layout);
            ret ra_1;
        }
    }

    if (rslot.class == abi.CLASS_SRET) {
        if (!mir.vreg_is_nil(sret_ptr)) {
            val sret_reg: i32            = ctx.tgt.abi.indirect_result_reg;
            val pre:      err[fail.Fail] = context.emit_mov_w(ctx, registers,
                mir.op_preg(mir.preg_id(sret_reg)), mir.op_vreg(sret_ptr), ptr_move_width(ctx));
            if (sel pre.err) {
                sig_layout_free(ctx, ?layout);
                ret pre;
            }
        }
    }

    var i: u32 = 1;
    for (i < inst.operand_count) {
        val av:   value.Value = inst.operands[i];
        val pidx: u32         = i - 1;
        val asz:  u64         = type.byte_size_for_machine(ctx.types, av.ty, ctx.layout)::u64;
        val aag:  bool        = context.value_is_aggregate(ctx, av.ty);
        var slot: abi.ParamSlot;
        var soff: i64         = 0;
        var ext:  type.IntExt = type.EXT_NONE;
        if (pidx < layout.param_count) {
            slot = layout.params[pidx];
            soff = slot.offset;
            ext  = type.ext_at(ctx.types, inst.arg_ext, pidx);
        }
        or {
            val aal:  u64  = arg_align(ctx, av.ty, aag);
            var afl:  bool = context.value_is_float(ctx, av.ty);
            val avec: bool = context.value_is_vector(ctx, av.ty);
            if (afl) {
                var vafl: abi.VaModel;
                val vfr:  err[fail.Fail] = abi_va_model(ctx.tgt, ?vafl);
                if (sel vfr.err) {
                    sig_layout_free(ctx, ?layout);
                    ret vfr;
                }
                if (!abi.variadic_float_in_fp_bank(?vafl, asz)) { afl = false; }
            }
            slot = classify_arg(pidx::i32, asz, reg_arg_align(ctx.tgt, aal), afl, 0, aag, avec, gp_used, fp_used, 0, 0, abi.agg_none());
            if (ctx.tgt.variadic_args_on_stack) { slot = stack_only_tail_slot(slot); }
            if (is_stack_slot_class(slot.class)) {
                stack_off = round_up_i64(stack_off, stack_arg_align(ctx.tgt, slot.class, aal, false));
            }
            or (slot_has_stack_piece(?slot)) {
                stack_off = round_up_i64(stack_off, ctx.tgt.model.gpr_width::u64);
            }
            soff = stack_off;
        }

        val aor: res[mir.MirOperand, fail.Fail] = lower_value_addr(ctx, mb, av);
        if (sel aor.err) {
            sig_layout_free(ctx, ?layout);
            ret err[fail.Fail].err{aor.err};
        }
        val argop: mir.MirOperand = aor.ok;

        # the carriers, the caller's copy and every temporary between them are secret when any byte of the object is
        ctx.cur_writes_secret = av.secret;
        val er: err[fail.Fail] = emit_arg_slot(ctx, mb, registers, slot, argop, soff, aag, av.ty,
            natural_stack_slot(ctx.tgt, pidx >= layout.param_count), ext);
        ctx.cur_writes_secret = false;
        if (sel er.err) {
            sig_layout_free(ctx, ?layout);
            ret er;
        }

        if (pidx >= layout.param_count && slot.class == abi.CLASS_FP) {
            var vamodel: abi.VaModel;
            val vmr:     err[fail.Fail] = abi_va_model(ctx.tgt, ?vamodel);
            if (sel vmr.err) {
                sig_layout_free(ctx, ?layout);
                ret vmr;
            }
            if (vamodel.float_dup_gp) {
                var dup_reg: i32            = 0;
                val dr:      err[fail.Fail] = abi_gp_arg_reg(ctx.tgt, gp_used + fp_used, ?dup_reg);
                if (sel dr.err) {
                    sig_layout_free(ctx, ?layout);
                    ret dr;
                }
                val dm: err[fail.Fail] = emit_call_reg(ctx, mb, registers, mir.op_preg(mir.preg_id(dup_reg)), argop, ctx.tgt.model.gpr_width::u8);
                if (sel dm.err) {
                    sig_layout_free(ctx, ?layout);
                    ret dm;
                }
            }
        }

        if (pidx >= layout.param_count) {
            if (is_stack_slot_class(slot.class)) {
                stack_off = stack_off + stack_arg_bytes(ctx.tgt, slot.size, false);
                advance_arg_cursors(?slot, ?gp_used, ?fp_used);
            }
            or {
                advance_arg_cursors(?slot, ?gp_used, ?fp_used);
                if (slot_has_stack_piece(?slot)) {
                    stack_off = stack_off + split_stack_bytes(ctx.tgt, ?slot);
                }
            }
        }

        i = i + 1;
    }

    sig_layout_free(ctx, ?layout);

    record_outgoing_size(ctx, stack_off);

    if (variadic_call) {
        var vamodel: abi.VaModel;
        val vmr:     err[fail.Fail] = abi_va_model(ctx.tgt, ?vamodel);
        if (sel vmr.err) { ret vmr; }
        if (vamodel.vector_count_reg >= 0) {
            val al: err[fail.Fail] = context.emit_mov_w(ctx, registers,
                mir.op_preg(mir.preg_id(vamodel.vector_count_reg)), mir.op_imm(fp_used::i64), 4::u8);
            if (sel al.err) { ret al; }
        }
    }

    val placed: err[fail.Fail] = append_deferred(ctx, mb, ?pending_registers);
    if (sel placed.err) { ret placed; }

    val rcall: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 1::usize);
    if (sel rcall.err) { ret err[fail.Fail].err{fail.refused(rcall.err)}; }
    val callops:    *mir.MirOperand                = rcall.ok;
    val lowered_16: res[mir.MirOperand, fail.Fail] = context.lower_callee(ctx, inst.operands[0]);
    if (sel lowered_16.err) { ret err[fail.Fail].err{lowered_16.err}; }
    callops[0] = lowered_16.ok;
    var cmi: mir.MirInstr = mir.instr(mir.MIR_CALL, callops, 1,
        ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
    val pc: err[fail.Fail] = context.push_instr(ctx, mb, cmi);
    if (sel pc.err) { ret pc; }

    val dst: mir.VRegId = context.instr_vreg(ctx, iid);
    if (!mir.vreg_is_nil(dst) && rslot.class != abi.CLASS_SRET) {
        ctx.cur_writes_secret = inst.secret;
        val rr: err[fail.Fail] = emit_ret_slot_to_vreg(ctx, mb, rslot, dst, ret_aggr, ret_type, ret_storage_align);
        ctx.cur_writes_secret = false;
        if (sel rr.err) { ret rr; }
    }
    if (ret_sret_register && !mir.vreg_is_nil(dst)) {
        var lr: err[fail.Fail] = err[fail.Fail].ok{};
        if (ret_vector_register) {
            lr = context.load_subwidth_vector(ctx, mb, mir.op_vreg(dst), mir.op_mem_value(sret_ptr, 0), ret_type);
        }
        or {
            lr = context.emit_load_from_w(ctx, mb, dst, mir.op_mem_value(sret_ptr, 0), ret_size::u8);
        }
        if (sel lr.err) { ret lr; }
    }
    if (!mir.vreg_is_nil(dst)) {
        val rres: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 1::usize);
        if (sel rres.err) { ret err[fail.Fail].err{fail.refused(rres.err)}; }
        val resops: *mir.MirOperand = rres.ok;
        resops[0] = mir.op_vreg(dst);
        var rmi: mir.MirInstr = mir.instr(mir.MIR_CALL_RES, resops, 1,
            ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
        val pr: err[fail.Fail] = context.push_instr(ctx, mb, rmi);
        if (sel pr.err) { ret pr; }
    }

    ret err[fail.Fail].ok{};
}

fun emit_call_reg(ctx: *context.LowerCtx, preparation: *mir.MirBlock, registers: *mir.MirBlock,
    dst: mir.MirOperand, src: mir.MirOperand, width: u8) err[fail.Fail] {
    var value: mir.MirOperand = src;
    if (registers != preparation && src.kind == mir.MIR_OP_MEM) {
        val class: u32                        = isa.regid_class(mir.preg_regid(dst.preg))::u32;
        val rv:    res[mir.VRegId, fail.Fail] = context.new_vreg_vec(ctx, class, class != mir.REG_CLASS_GP && width > 8);
        if (sel rv.err) { ret err[fail.Fail].err{rv.err}; }
        val v: mir.VRegId = rv.ok;
        ctx.f.vregs[v.n].secret = ctx.cur_writes_secret;
        val loaded: err[fail.Fail] = context.emit_mov_w(ctx, preparation, mir.op_vreg(v), src, width);
        if (sel loaded.err) { ret loaded; }
        value = mir.op_vreg(v);
    }
    ret context.emit_mov_w(ctx, registers, dst, value, width);
}

fun append_deferred(ctx: *context.LowerCtx, mb: *mir.MirBlock, deferred: *mir.MirBlock) err[fail.Fail] {
    var i: u32 = 0;
    for (i < deferred.instr_count) {
        val grown: err[fail.Fail] = context.grow_instr(ctx, mb);
        if (sel grown.err) { ret grown; }
        mb.instrs[mb.instr_count]            = deferred.instrs[i];
        mb.instr_count                       = mb.instr_count + 1;
        deferred.instrs[i].operands          = nil;
        deferred.instrs[i].operand_count     = 0;
        deferred.instrs[i].dbg_bindings      = nil;
        deferred.instrs[i].dbg_binding_count = 0;
        i                                    = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun lower_value_addr(ctx: *context.LowerCtx, mb: *mir.MirBlock, v: value.Value) res[mir.MirOperand, fail.Fail] {
    val op_r: res[mir.MirOperand, fail.Fail] = context.lower_value(ctx, v);
    if (sel op_r.err) { ret op_r; }
    val op: mir.MirOperand = op_r.ok;
    if (op.kind != mir.MIR_OP_SYM || !ctx.tgt.model.flat_addressing) { ret res[mir.MirOperand, fail.Fail].ok{op}; }
    var addr: mir.VRegId     = mir.MIR_VREG_NIL;
    val ar:   err[fail.Fail] = context.addr_to_vreg(ctx, mb, op, ?addr);
    if (sel ar.err) { ret res[mir.MirOperand, fail.Fail].err{ar.err}; }
    ret res[mir.MirOperand, fail.Fail].ok{mir.op_vreg(addr)};
}

rec PiecePlan {
    store:        bool;
    registers:    *mir.MirBlock;
    mem_base:     mir.VRegId;
    mem_slot:     bool;
    mem_align:    u32;
    copies:       *mir.MirBlock;
    stack_base:   mir.PRegId;
    stack_off:    i64;
    stack_ok:     bool;
    owned_extent: u64;
}

fun carrier_access_legal(ctx: *context.LowerCtx, piece: *abi.ParamPiece, align: u32) bool {
    if (align != 0 && align % piece.width::u32 == 0 && piece.src_off % piece.width::i64 == 0) { ret true; }
    ret piece.kind == abi.PIECE_GP && isa.moves_unaligned_gp(?ctx.tgt.model, piece.width::u32);
}

fun allocate_carrier(ctx: *context.LowerCtx, width: u8) res[mir.VRegId, fail.Fail] {
    val kr: res[mir.VRegId, fail.Fail] = context.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel kr.err) { ret kr; }
    val key: mir.VRegId     = kr.ok;
    val ar:  err[fail.Fail] = context.add_alloca_slot(ctx, key.n,
        width::u64, width::u32, mir.SLOT_TY_NIL);
    if (sel ar.err) { ret res[mir.VRegId, fail.Fail].err{ar.err}; }
    ret res[mir.VRegId, fail.Fail].ok{key};
}

fun load_piece_carrier(ctx: *context.LowerCtx, mb: *mir.MirBlock, registers: *mir.MirBlock,
    reg: mir.MirOperand, source: mir.MirOperand,
    logical_width: u8, carrier_width: u8, direct: bool) err[fail.Fail] {
    if (logical_width == carrier_width && direct) {
        ret emit_call_reg(ctx, mb, registers, reg, source, carrier_width);
    }
    val kr: res[mir.VRegId, fail.Fail] = allocate_carrier(ctx, carrier_width);
    if (sel kr.err) { ret err[fail.Fail].err{kr.err}; }
    val key: mir.VRegId = kr.ok;
    var off: u64        = 0;
    for (logical_width < carrier_width && off < carrier_width::u64) {
        val width: u8             = context.copy_chunk_width(ctx.tgt, carrier_width::u64 - off);
        val zero:  err[fail.Fail] = context.push_store_chunk(ctx, mb,
            mir.op_mem_slot(key, off::i64), mir.op_imm(0), width);
        if (sel zero.err) { ret zero; }
        off = off + width::u64;
    }
    val copied: err[fail.Fail] = context.copy_aggregate(ctx, mb,
        mir.op_mem_slot(key, 0), source, logical_width::u64);
    if (sel copied.err) { ret copied; }
    ret emit_call_reg(ctx, mb, registers, reg, mir.op_mem_slot(key, 0), carrier_width);
}

fun zero_range(ctx: *context.LowerCtx, mb: *mir.MirBlock, plan: PiecePlan, from: u64, to: u64) err[fail.Fail] {
    var off: u64 = from;
    for (off < to) {
        val width: u8             = context.copy_chunk_width(ctx.tgt, to - off);
        var mem:   mir.MirOperand = mir.op_mem_value(plan.mem_base, off::i64);
        if (plan.mem_slot) { mem = mir.op_mem_slot(plan.mem_base, off::i64); }
        val zero: err[fail.Fail] = context.push_store_chunk(ctx, mb, mem, mir.op_imm(0), width);
        if (sel zero.err) { ret zero; }
        off = off + width::u64;
    }
    ret err[fail.Fail].ok{};
}

# a convention may deliver nothing for a padding-only eightbyte; the logical object still owns those bytes,
# so the store side zeroes every logical byte no piece delivers before the pieces land
fun zero_undelivered_bytes(ctx: *context.LowerCtx, mb: *mir.MirBlock, slot: *abi.ParamSlot, plan: PiecePlan) err[fail.Fail] {
    var cursor: u64 = 0;
    var i:      u32 = 0;
    for (i < slot.piece_count) {
        val p:  *abi.ParamPiece    = ?slot.pieces[i];
        val wr: res[u8, fail.Fail] = abi.piece_memory_width(slot, p);
        if (sel wr.err) { ret err[fail.Fail].err{wr.err}; }
        val start: u64 = p.src_off::u64;
        if (start > cursor) {
            val zr: err[fail.Fail] = zero_range(ctx, mb, plan, cursor, start);
            if (sel zr.err) { ret zr; }
        }
        val end: u64 = start + wr.ok::u64;
        if (end > cursor) { cursor = end; }
        i = i + 1;
    }
    if (cursor < slot.size) { ret zero_range(ctx, mb, plan, cursor, slot.size); }
    ret err[fail.Fail].ok{};
}

fun materialize_pieces(ctx: *context.LowerCtx, mb: *mir.MirBlock, slot: abi.ParamSlot, plan: PiecePlan) err[fail.Fail] {
    val er: res[u64, fail.Fail] = abi.carrier_storage_extent(?slot);
    if (sel er.err) { ret err[fail.Fail].err{er.err}; }
    if (plan.store && plan.owned_extent < er.ok) {
        ret err[fail.Fail].err{fail.message("mir.abi: carrier stores exceed owned destination storage")};
    }
    var pending: mir.MirBlock;
    fin { mir.dnit_block(ctx.alloc, ?pending); }
    var pending_copies: mir.MirBlock;
    fin { mir.dnit_block(ctx.alloc, ?pending_copies); }
    var copies: *mir.MirBlock = plan.copies;
    if (copies == nil) { copies = ?pending_copies; }
    var registers: *mir.MirBlock = plan.registers;
    if (!plan.store && registers == mb) { registers = ?pending; }
    if (plan.store) {
        val zr: err[fail.Fail] = zero_undelivered_bytes(ctx, mb, ?slot, plan);
        if (sel zr.err) { ret zr; }
    }
    var i: u32 = 0;
    for (i < slot.piece_count) {
        val p:  abi.ParamPiece     = slot.pieces[i];
        val wr: res[u8, fail.Fail] = abi.piece_memory_width(?slot, ?slot.pieces[i]);
        if (sel wr.err) { ret err[fail.Fail].err{wr.err}; }
        val logical_width: u8             = wr.ok;
        var mem:           mir.MirOperand = mir.op_mem_value(plan.mem_base, p.src_off);
        if (plan.mem_slot) { mem = mir.op_mem_slot(plan.mem_base, p.src_off); }
        if (p.kind == abi.PIECE_STACK) {
            if (!plan.stack_ok) {
                ret err[fail.Fail].err{fail.message("mir.lower_ir: return slot carries an outgoing stack chunk")};
            }
            val stk:       mir.MirOperand = mir.op_mem_preg(plan.stack_base, plan.stack_off + p.stk_off);
            var src:       mir.MirOperand = mem;
            var dst:       mir.MirOperand = stk;
            var transfers: *mir.MirBlock  = mb;
            if (plan.store) {
                src = stk;
                dst = mem;
            }
            if (plan.store) { transfers = copies; }
            val copied: err[fail.Fail] = context.copy_aggregate(ctx, transfers, dst, src, logical_width::u64);
            if (sel copied.err) { ret copied; }
        }
        or {
            val reg:    mir.MirOperand = mir.op_preg(p.reg);
            val direct: bool           = carrier_access_legal(ctx, ?p, plan.mem_align);
            if (plan.store) {
                if (direct) {
                    val st: err[fail.Fail] = context.emit_store_to_w(ctx, mb, mem, reg, p.width);
                    if (sel st.err) { ret st; }
                }
                or {
                    val kr: res[mir.VRegId, fail.Fail] = allocate_carrier(ctx, p.width);
                    if (sel kr.err) { ret err[fail.Fail].err{kr.err}; }
                    val carrier: mir.MirOperand = mir.op_mem_slot(kr.ok, 0);
                    val st:      err[fail.Fail] = context.emit_store_to_w(ctx, mb, carrier, reg, p.width);
                    if (sel st.err) { ret st; }
                    # the owned home includes carrier padding
                    val cr: err[fail.Fail] = context.copy_aggregate(ctx, copies, mem, carrier, p.width::u64);
                    if (sel cr.err) { ret cr; }
                }
            }
            or {
                val mr: err[fail.Fail] = load_piece_carrier(ctx, mb, registers,
                    reg, mem, logical_width, p.width, direct);
                if (sel mr.err) { ret mr; }
            }
        }
        i = i + 1;
    }
    if (copies == ?pending_copies && pending_copies.instr_count != 0) {
        val cr: err[fail.Fail] = append_deferred(ctx, mb, ?pending_copies);
        if (sel cr.err) { ret cr; }
    }
    if (registers == ?pending) { ret append_deferred(ctx, mb, ?pending); }
    ret err[fail.Fail].ok{};
}

fun emit_arg_slot(ctx: *context.LowerCtx, mb: *mir.MirBlock, registers: *mir.MirBlock, slot: abi.ParamSlot, argop: mir.MirOperand,
    stack_off: i64, is_aggr: bool, ty: type.IrTypeId, natural: bool, ext: type.IntExt) err[fail.Fail] {
    val size: u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;

    val scalar_byref: bool = int_by_reference(ctx, ty) &&
        (slot.class == abi.CLASS_BYREF || slot.class == abi.CLASS_STACK_BYREF);
    if (is_aggr && (slot.class == abi.CLASS_BYREF || slot.class == abi.CLASS_STACK_BYREF) || scalar_byref) {
        var owned: mir.VRegId     = mir.MIR_VREG_NIL;
        var cr:    err[fail.Fail] = err[fail.Fail].ok{};
        if (scalar_byref) { cr = copy_scalar_to_temp(ctx, mb, argop, ty, ?owned); }
        or                { cr = copy_aggregate_to_temp(ctx, mb, argop, ty, ?owned); }
        if (sel cr.err)   { ret cr; }
        if (slot.class == abi.CLASS_STACK_BYREF) {
            val sp: mir.PRegId = mir.preg_id(ctx.tgt.model.stack_ptr_reg);
            ret context.emit_store_to(ctx, mb, mir.op_mem_preg(sp, stack_off), mir.op_vreg(owned));
        }
        ret emit_call_reg(ctx, mb, registers, mir.op_preg(slot.reg), mir.op_vreg(owned), ptr_move_width(ctx));
    }
    if (slot.class == abi.CLASS_VEC_BYREF || slot.class == abi.CLASS_VEC_STACK_BYREF) {
        var addr: mir.VRegId     = mir.MIR_VREG_NIL;
        val sr:   err[fail.Fail] = spill_vector_to_temp(ctx, mb, slot, argop, ty, ?addr);
        if (sel sr.err) { ret sr; }
        if (slot.class == abi.CLASS_VEC_STACK_BYREF) {
            val sp: mir.PRegId = mir.preg_id(ctx.tgt.model.stack_ptr_reg);
            ret context.emit_store_to(ctx, mb, mir.op_mem_preg(sp, stack_off), mir.op_vreg(addr));
        }
        ret emit_call_reg(ctx, mb, registers, mir.op_preg(slot.reg), mir.op_vreg(addr), ptr_move_width(ctx));
    }
    if (slot.class == abi.CLASS_STACK_BYREF) {
        val sp:   mir.PRegId     = mir.preg_id(ctx.tgt.model.stack_ptr_reg);
        var base: mir.VRegId     = mir.MIR_VREG_NIL;
        val ar:   err[fail.Fail] = context.addr_to_vreg(ctx, mb, argop, ?base);
        if (sel ar.err) { ret ar; }
        ret context.emit_store_to(ctx, mb, mir.op_mem_preg(sp, stack_off), mir.op_vreg(base));
    }
    if (slot.class == abi.CLASS_STACK) {
        val sp: mir.PRegId = mir.preg_id(ctx.tgt.model.stack_ptr_reg);
        if (is_aggr) {
            ret context.copy_aggregate(ctx, mb, mir.op_mem_preg(sp, stack_off), argop, size);
        }
        if (context.subwidth_vector_memory(ctx, ty)) {
            ret context.store_subwidth_vector(ctx, mb, mir.op_mem_preg(sp, stack_off), argop, ty);
        }
        ret context.emit_store_to_w(ctx, mb, mir.op_mem_preg(sp, stack_off), argop,
            scalar_mem_move_width(ctx.tgt.model.gpr_width, size, natural));
    }
    if (slot.class == abi.CLASS_BYREF) {
        var base: mir.VRegId     = mir.MIR_VREG_NIL;
        val ar:   err[fail.Fail] = context.addr_to_vreg(ctx, mb, argop, ?base);
        if (sel ar.err) { ret ar; }
        ret emit_call_reg(ctx, mb, registers, mir.op_preg(slot.reg), mir.op_vreg(base), ptr_move_width(ctx));
    }

    if (is_aggr) {
        var base: mir.VRegId     = mir.MIR_VREG_NIL;
        val ar:   err[fail.Fail] = context.addr_to_vreg(ctx, mb, argop, ?base);
        if (sel ar.err) { ret ar; }
        var plan: PiecePlan;
        plan.registers  = registers;
        plan.store      = false;
        plan.mem_base   = base;
        plan.mem_slot   = false;
        plan.mem_align  = type.byte_align_for_machine(ctx.types, ty, ctx.layout);
        plan.stack_base = mir.preg_id(ctx.tgt.model.stack_ptr_reg);
        plan.stack_off  = stack_off;
        plan.stack_ok   = true;
        ret materialize_pieces(ctx, mb, slot, plan);
    }
    if (slot.class == abi.CLASS_FP) {
        if (int_rides_fp_slot(ctx, ty)) { ret emit_int_to_fp_reg(ctx, mb, registers, slot.reg, argop, ty); }
        val fw: res[u8, fail.Fail] = fp_move_width(ctx, ty);
        if (sel fw.err) { ret err[fail.Fail].err{fw.err}; }
        ret emit_call_reg(ctx, mb, registers, mir.op_preg(slot.reg), argop, fw.ok);
    }
    if (float_slot_crosses_banks(ctx, ?slot, ty, is_aggr)) {
        ret emit_float_bits_to_slot(ctx, mb, registers, slot, argop, ty,
            mir.preg_id(ctx.tgt.model.stack_ptr_reg), stack_off, true);
    }
    if (slot_is_wide_scalar(ctx, ?slot, ty, is_aggr)) {
        ret emit_slot_lanes(ctx, mb, registers, slot, argop, ty,
            mir.preg_id(ctx.tgt.model.stack_ptr_reg), stack_off, true);
    }
    var value: mir.MirOperand = argop;
    if (caller_widens(ctx.tgt, ext, size)) {
        val wr: res[mir.MirOperand, fail.Fail] = widen_arg(ctx, mb, argop, size, ext);
        if (sel wr.err) { ret err[fail.Fail].err{wr.err}; }
        value = wr.ok;
    }
    ret emit_call_reg(ctx, mb, registers, mir.op_preg(slot.reg), value, scalar_reg_move_width(ctx.tgt.model.gpr_width, size));
}

# the platform widens an integer argument narrower than reg_arg_extend in its
# register by the extension the call declares for it, where the convention
# leaves the upper bits to the callee (darwin aarch64, #3927)
fun caller_widens(tgt: *target.Target, ext: type.IntExt, size: u64) bool {
    ret ext != type.EXT_NONE && size * 8 < tgt.reg_arg_extend::u64;
}

# the value is moved into a general register first, as the register move
# without widening does, since it may live in another bank or in memory. the
# widening is scalar even inside a call that also passes a vector
fun widen_arg(ctx: *context.LowerCtx, mb: *mir.MirBlock, argop: mir.MirOperand, size: u64,
    ext: type.IntExt) res[mir.MirOperand, fail.Fail] {
    val lane: u32 = ctx.cur_vec_lane;
    ctx.cur_vec_lane = mir.VEC_LANE_NONE;
    fin { ctx.cur_vec_lane = lane; }
    var src: mir.MirOperand = argop;
    if (argop.kind != mir.MIR_OP_IMM) {
        val gr: res[mir.VRegId, fail.Fail] = context.new_vreg(ctx, mir.REG_CLASS_GP);
        if (sel gr.err) { ret res[mir.MirOperand, fail.Fail].err{gr.err}; }
        ctx.f.vregs[gr.ok.n].secret = ctx.cur_writes_secret;
        val mv: err[fail.Fail] = context.emit_mov_w(ctx, mb, mir.op_vreg(gr.ok), argop,
            scalar_reg_move_width(ctx.tgt.model.gpr_width, size));
        if (sel mv.err) { ret res[mir.MirOperand, fail.Fail].err{mv.err}; }
        src = mir.op_vreg(gr.ok);
    }
    val vr: res[mir.VRegId, fail.Fail] = context.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel vr.err) { ret res[mir.MirOperand, fail.Fail].err{vr.err}; }
    val v: mir.VRegId = vr.ok;
    ctx.f.vregs[v.n].secret = ctx.cur_writes_secret;
    val pr: err[fail.Fail] = context.emit_promote(ctx, mb, mir.op_vreg(v), src,
        (ctx.tgt.reg_arg_extend / 8)::u8, size::u8, ext == type.EXT_SIGN);
    if (sel pr.err) { ret res[mir.MirOperand, fail.Fail].err{pr.err}; }
    ret res[mir.MirOperand, fail.Fail].ok{mir.op_vreg(v)};
}

# a scalar passed by reference gets a caller-owned copy at its own alignment;
# the store is legalize's to split (#3511)
fun copy_scalar_to_temp(ctx: *context.LowerCtx, mb: *mir.MirBlock, src: mir.MirOperand,
    ty: type.IrTypeId, out_addr: *mir.VRegId) err[fail.Fail] {
    val size:    u64                        = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    val align:   u32                        = type.byte_align_for_machine(ctx.types, ty, ctx.layout);
    val res_key: res[mir.VRegId, fail.Fail] = context.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel res_key.err) { ret err[fail.Fail].err{res_key.err}; }
    val sk: mir.VRegId = res_key.ok;

    val sr: err[fail.Fail] = context.add_spill_slot_aligned(ctx, sk.n, size, align);
    if (sel sr.err) { ret sr; }

    val st: err[fail.Fail] = context.emit_mov_w(ctx, mb, mir.op_mem_slot(sk, 0), src, size::u8);
    if (sel st.err) { ret st; }

    ret context.emit_lea_slot(ctx, mb, mir.op_mem_slot(sk, 0), out_addr);
}

fun copy_aggregate_to_temp(ctx: *context.LowerCtx, mb: *mir.MirBlock, src: mir.MirOperand,
    ty: type.IrTypeId, out_addr: *mir.VRegId) err[fail.Fail] {
    val size:    u64                        = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    val align:   u32                        = type.byte_align_for_machine(ctx.types, ty, ctx.layout);
    val res_key: res[mir.VRegId, fail.Fail] = context.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel res_key.err) { ret err[fail.Fail].err{res_key.err}; }
    val sk: mir.VRegId = res_key.ok;

    val sr: err[fail.Fail] = context.add_spill_slot_aligned(ctx, sk.n, size, align);
    if (sel sr.err) { ret sr; }

    val cr: err[fail.Fail] = context.copy_aggregate(ctx, mb, mir.op_mem_slot(sk, 0), src, size);
    if (sel cr.err) { ret cr; }

    ret context.emit_lea_slot(ctx, mb, mir.op_mem_slot(sk, 0), out_addr);
}

fun spill_vector_to_temp(ctx: *context.LowerCtx, mb: *mir.MirBlock, slot: abi.ParamSlot,
    val_op: mir.MirOperand, ty: type.IrTypeId, out_addr: *mir.VRegId) err[fail.Fail] {
    val logical_size: u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    val size:         u64 = slot.indirect_size;
    val align:        u32 = slot.indirect_align;
    if (size < logical_size || align == 0 || (align & (align - 1)) != 0) {
        ret err[fail.Fail].err{fail.message("mir.abi.spill_vector_to_temp: ABI vector placement has invalid indirect storage")};
    }
    val res_key: res[mir.VRegId, fail.Fail] = context.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel res_key.err) { ret err[fail.Fail].err{res_key.err}; }
    val sk: mir.VRegId = res_key.ok;

    val sr: err[fail.Fail] = context.add_spill_slot_aligned(ctx, sk.n, size, align);
    if (sel sr.err) { ret sr; }

    var st: err[fail.Fail] = err[fail.Fail].ok{};
    if (context.value_is_vector(ctx, ty)) {
        st = context.store_subwidth_vector(ctx, mb, mir.op_mem_slot(sk, 0), val_op, ty);
    }
    or {
        st = context.copy_aggregate(ctx, mb, mir.op_mem_slot(sk, 0), val_op, size);
    }
    if (sel st.err) { ret st; }

    ret context.emit_lea_slot(ctx, mb, mir.op_mem_slot(sk, 0), out_addr);
}

# an integer wider than a general register that a convention carries in a
# vector register (Win64 returns a 16-byte integer in XMM0): no move crosses
# banks at that width, so it goes through a frame slot, its integer lanes
# stored (or loaded) as legalize splits them and the vector register loaded
# (or stored) whole (#3511)
fun int_rides_fp_slot(ctx: *context.LowerCtx, ty: type.IrTypeId) bool {
    if (context.value_is_float(ctx, ty) || context.value_is_vector(ctx, ty) || context.value_is_aggregate(ctx, ty)) { ret false; }
    val size: u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    ret size > ctx.tgt.model.gpr_width::u64;
}

fun int_fp_slot(ctx: *context.LowerCtx, ty: type.IrTypeId, out: *mir.VRegId) err[fail.Fail] {
    val size:    u64                        = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    val align:   u32                        = type.byte_align_for_machine(ctx.types, ty, ctx.layout);
    val res_key: res[mir.VRegId, fail.Fail] = context.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel res_key.err) { ret err[fail.Fail].err{res_key.err}; }
    val sr: err[fail.Fail] = context.add_spill_slot_aligned(ctx, res_key.ok.n, size, align);
    if (sel sr.err) { ret sr; }
    @out = res_key.ok;
    ret err[fail.Fail].ok{};
}

# integer value -> vector register; the store is preparation, the register
# load lands with the other register moves
fun emit_int_to_fp_reg(ctx: *context.LowerCtx, preparation: *mir.MirBlock, registers: *mir.MirBlock,
    reg: mir.PRegId, src: mir.MirOperand, ty: type.IrTypeId) err[fail.Fail] {
    val size: u64            = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    var sk:   mir.VRegId     = mir.MIR_VREG_NIL;
    val slot: err[fail.Fail] = int_fp_slot(ctx, ty, ?sk);
    if (sel slot.err) { ret slot; }
    val st: err[fail.Fail] = context.emit_mov_w(ctx, preparation, mir.op_mem_slot(sk, 0), src, size::u8);
    if (sel st.err) { ret st; }
    ret context.emit_fmov(ctx, registers, mir.op_preg(reg), mir.op_mem_slot(sk, 0), size::u8);
}

# vector register -> integer value
fun emit_fp_reg_to_int(ctx: *context.LowerCtx, mb: *mir.MirBlock, dst: mir.VRegId, reg: mir.PRegId, ty: type.IrTypeId) err[fail.Fail] {
    val size: u64            = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    var sk:   mir.VRegId     = mir.MIR_VREG_NIL;
    val slot: err[fail.Fail] = int_fp_slot(ctx, ty, ?sk);
    if (sel slot.err) { ret slot; }
    val st: err[fail.Fail] = context.emit_fmov(ctx, mb, mir.op_mem_slot(sk, 0), mir.op_preg(reg), size::u8);
    if (sel st.err) { ret st; }
    ret context.emit_mov_w(ctx, mb, mir.op_vreg(dst), mir.op_mem_slot(sk, 0), size::u8);
}

fun fp_move_width(ctx: *context.LowerCtx, ty: type.IrTypeId) res[u8, fail.Fail] {
    val size: u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    if (context.value_is_vector(ctx, ty)) {
        val vw: u64 = (ctx.tgt.model.vector_bits / 8)::u64;
        if (vw == 0 || size > vw) {
            ret res[u8, fail.Fail].err{fail.message("mir.abi.fp_move_width: vector wider than the target's vector register; an over-width vector's placement is a multi-piece split the convention classifier must decide")};
        }
        ret res[u8, fail.Fail].ok{vw::u8};
    }
    if (size == 4) { ret res[u8, fail.Fail].ok{4}; }
    if (size == 8) { ret res[u8, fail.Fail].ok{8}; }
    ret res[u8, fail.Fail].err{fail.message("mir.abi.fp_move_width: CLASS_FP scalar of unsupported size (expected 4 or 8 bytes)")};
}

fun capture_slot_reg(ctx: *context.LowerCtx, mb: *mir.MirBlock, dst: mir.VRegId, slot: abi.ParamSlot, ty: type.IrTypeId) err[fail.Fail] {
    if (slot.class == abi.CLASS_FP) {
        if (int_rides_fp_slot(ctx, ty)) { ret emit_fp_reg_to_int(ctx, mb, dst, slot.reg, ty); }
        val fw: res[u8, fail.Fail] = fp_move_width(ctx, ty);
        if (sel fw.err) { ret err[fail.Fail].err{fw.err}; }
        ret context.emit_fmov(ctx, mb, mir.op_vreg(dst), mir.op_preg(slot.reg), fw.ok);
    }
    val size: u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    ret context.emit_mov_w(ctx, mb, mir.op_vreg(dst), mir.op_preg(slot.reg),
        scalar_reg_move_width(ctx.tgt.model.gpr_width, size));
}

# a scalar slot whose pieces are the lanes of one value wider than the ALU: an
# integer the convention splits across registers, or a register and a stack
# word. its pieces are stated to legalize one lane at a time (MIR_LANE_JOIN,
# MIR_LANE_PICK) so no pass has to find lane k of a register by arithmetic on
# its id (#3602). a float in general registers is one cross-bank move where the
# target spells one, and otherwise travels as float_slot_crosses_banks says
fun slot_is_wide_scalar(ctx: *context.LowerCtx, slot: *abi.ParamSlot, ty: type.IrTypeId, is_aggr: bool) bool {
    if (is_aggr || slot.class != abi.CLASS_GP) { ret false; }
    val maw: u32 = ctx.tgt.model.max_alu_width;
    if (maw == 0)                                                            { ret false; }
    if (context.value_is_float(ctx, ty) || context.value_is_vector(ctx, ty)) { ret false; }
    ret type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64 > maw::u64;
}

# a float the convention carries in general registers on a target with no
# cross-bank move of its width (an f64 past the fa registers on rv32, #3617):
# its bits go through a frame slot, and the general-register side is the
# integer of the same width, wide or not, so the lane path carries it as it
# carries any integer split across registers
fun float_slot_crosses_banks(ctx: *context.LowerCtx, slot: *abi.ParamSlot, ty: type.IrTypeId, is_aggr: bool) bool {
    if (is_aggr || slot.class != abi.CLASS_GP)                                { ret false; }
    if (!context.value_is_float(ctx, ty) || context.value_is_vector(ctx, ty)) { ret false; }
    val size: u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    ret !isa.moves_cross_bank(?ctx.tgt.model, size::u32);
}

fun bits_are_wide(ctx: *context.LowerCtx, size: u64) bool {
    val maw: u32 = ctx.tgt.model.max_alu_width;
    ret maw != 0 && size > maw::u64;
}

# the float's bits leave through a frame slot: stored as a float, read back as
# the integer the general-register pieces carry. an immediate already is its
# bits and is picked from directly
fun emit_float_bits_to_slot(ctx: *context.LowerCtx, mb: *mir.MirBlock, registers: *mir.MirBlock, slot: abi.ParamSlot,
    src: mir.MirOperand, ty: type.IrTypeId, stack_base: mir.PRegId, stack_off: i64, stack_ok: bool) err[fail.Fail] {
    val size: u64            = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    var bits: mir.MirOperand = src;
    if (src.kind != mir.MIR_OP_IMM) {
        var sk:   mir.VRegId     = mir.MIR_VREG_NIL;
        val home: err[fail.Fail] = int_fp_slot(ctx, ty, ?sk);
        if (sel home.err) { ret home; }
        val st: err[fail.Fail] = context.emit_fmov(ctx, mb, mir.op_mem_slot(sk, 0), src, size::u8);
        if (sel st.err) { ret st; }
        bits = mir.op_mem_slot(sk, 0);
    }
    if (bits_are_wide(ctx, size)) {
        ret emit_slot_lanes(ctx, mb, registers, slot, bits, ty, stack_base, stack_off, stack_ok);
    }
    if (mir.preg_is_nil(slot.reg)) { ret err[fail.Fail].err{fail.message("mir.abi: a float's general-register slot names no register")}; }
    ret emit_call_reg(ctx, mb, registers, mir.op_preg(slot.reg), bits, scalar_reg_move_width(ctx.tgt.model.gpr_width, size));
}

# the float's bits arrive in general registers: joined into the integer of its
# width, stored to a frame slot, and read back as the float
fun capture_float_bits_from_slot(ctx: *context.LowerCtx, mb: *mir.MirBlock, dst: mir.VRegId, slot: abi.ParamSlot, ty: type.IrTypeId,
    stack_base: mir.PRegId, stack_off: i64, stack_ok: bool) err[fail.Fail] {
    val size: u64            = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    var sk:   mir.VRegId     = mir.MIR_VREG_NIL;
    val home: err[fail.Fail] = int_fp_slot(ctx, ty, ?sk);
    if (sel home.err) { ret home; }
    if (bits_are_wide(ctx, size)) {
        val gr: res[mir.VRegId, fail.Fail] = context.new_vreg(ctx, mir.REG_CLASS_GP);
        if (sel gr.err) { ret err[fail.Fail].err{gr.err}; }
        val g: mir.VRegId = gr.ok;
        ctx.f.vregs[g.n].secret = ctx.cur_writes_secret;
        val joined: err[fail.Fail] = capture_slot_lanes(ctx, mb, g, slot, ty, stack_base, stack_off, stack_ok);
        if (sel joined.err) { ret joined; }
        val st: err[fail.Fail] = context.emit_mov_w(ctx, mb, mir.op_mem_slot(sk, 0), mir.op_vreg(g), size::u8);
        if (sel st.err) { ret st; }
    }
    or {
        if (mir.preg_is_nil(slot.reg)) { ret err[fail.Fail].err{fail.message("mir.abi: a float's general-register slot names no register")}; }
        val st: err[fail.Fail] = context.emit_mov_w(ctx, mb, mir.op_mem_slot(sk, 0), mir.op_preg(slot.reg), size::u8);
        if (sel st.err) { ret st; }
    }
    ret context.emit_fmov(ctx, mb, mir.op_vreg(dst), mir.op_mem_slot(sk, 0), size::u8);
}

fun lane_width(ctx: *context.LowerCtx) u64 {
    ret ctx.tgt.model.max_alu_width::u64;
}

# the lane a piece carries: pieces are one lane wide at a lane-aligned offset
fun piece_lane(ctx: *context.LowerCtx, p: *abi.ParamPiece) res[u32, fail.Fail] {
    val lane: u64 = lane_width(ctx);
    if (p.width::u64 != lane || p.src_off < 0 || p.src_off::u64 % lane != 0) {
        ret res[u32, fail.Fail].err{fail.message("mir.abi: a wide scalar's piece is not one lane of it")};
    }
    ret res[u32, fail.Fail].ok{(p.src_off::u64 / lane)::u32};
}

# how many lanes a wide scalar slot has, once its pieces are checked to cover
# every lane exactly once
fun wide_slot_lanes(ctx: *context.LowerCtx, slot: *abi.ParamSlot, size: u64) res[u32, fail.Fail] {
    val lane: u64 = lane_width(ctx);
    val n:    u64 = size / lane;
    if (n * lane != size || n < 2 || n > abi.PARAM_MAX_PIECES::u64 || slot.piece_count::u64 != n) {
        ret res[u32, fail.Fail].err{fail.message("mir.abi: a wide scalar's pieces do not cover its lanes")};
    }
    var seen: u32 = 0;
    var i:    u32 = 0;
    for (i < slot.piece_count) {
        val kr: res[u32, fail.Fail] = piece_lane(ctx, ?slot.pieces[i]);
        if (sel kr.err) { ret kr; }
        val bit: u32 = 1 << kr.ok;
        if (kr.ok::u64 >= n || (seen & bit) != 0) {
            ret res[u32, fail.Fail].err{fail.message("mir.abi: a wide scalar's pieces do not cover its lanes")};
        }
        seen = seen | bit;
        i    = i + 1;
    }
    ret res[u32, fail.Fail].ok{n::u32};
}

# where a lane lives: its general register, or its stack word off stack_base
fun lane_piece_operand(ctx: *context.LowerCtx, p: *abi.ParamPiece, stack_base: mir.PRegId, stack_off: i64,
    stack_ok: bool) res[mir.MirOperand, fail.Fail] {
    if (p.kind == abi.PIECE_STACK) {
        if (!stack_ok) {
            ret res[mir.MirOperand, fail.Fail].err{fail.message("mir.abi: a wide scalar's lane rides the stack where the convention passes no stack piece")};
        }
        ret res[mir.MirOperand, fail.Fail].ok{mir.op_mem_preg(stack_base, stack_off + p.stk_off)};
    }
    if (p.kind != abi.PIECE_GP || mir.preg_is_nil(p.reg)) {
        ret res[mir.MirOperand, fail.Fail].err{fail.message("mir.abi: a wide integer's lane has no general register")};
    }
    ret res[mir.MirOperand, fail.Fail].ok{mir.op_preg(p.reg)};
}

# dst is the wide value whose lane k is the slot's piece at k: one
# MIR_LANE_JOIN naming every piece, which legalize turns into a move per lane
fun capture_slot_lanes(ctx: *context.LowerCtx, mb: *mir.MirBlock, dst: mir.VRegId, slot: abi.ParamSlot, ty: type.IrTypeId,
    stack_base: mir.PRegId, stack_off: i64, stack_ok: bool) err[fail.Fail] {
    val size: u64                 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    val nr:   res[u32, fail.Fail] = wide_slot_lanes(ctx, ?slot, size);
    if (sel nr.err) { ret err[fail.Fail].err{nr.err}; }
    val lanes: u32                           = nr.ok;
    val ar:    res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, (lanes + 1)::usize);
    if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
    val ops: *mir.MirOperand = ar.ok;
    ops[0] = mir.op_vreg(dst);
    var i: u32 = 0;
    for (i < slot.piece_count) {
        val kr: res[u32, fail.Fail] = piece_lane(ctx, ?slot.pieces[i]);
        if (sel kr.err) {
            A.deallocate[mir.MirOperand](ctx.alloc, ops, (lanes + 1)::usize);
            ret err[fail.Fail].err{kr.err};
        }
        val pr: res[mir.MirOperand, fail.Fail] = lane_piece_operand(ctx, ?slot.pieces[i], stack_base, stack_off, stack_ok);
        if (sel pr.err) {
            A.deallocate[mir.MirOperand](ctx.alloc, ops, (lanes + 1)::usize);
            ret err[fail.Fail].err{pr.err};
        }
        ops[1 + kr.ok] = pr.ok;
        i              = i + 1;
    }
    var mi: mir.MirInstr = mir.instr(mir.MIR_LANE_JOIN, ops, lanes + 1, size::u8, lane_width(ctx)::u8);
    ret context.push_instr(ctx, mb, mi);
}

# each piece of the slot receives lane k of the value: one MIR_LANE_PICK per
# piece, the register pieces into the deferred register block and a stack
# piece stored where the value is prepared
fun emit_slot_lanes(ctx: *context.LowerCtx, mb: *mir.MirBlock, registers: *mir.MirBlock, slot: abi.ParamSlot,
    src: mir.MirOperand, ty: type.IrTypeId, stack_base: mir.PRegId, stack_off: i64, stack_ok: bool) err[fail.Fail] {
    val size: u64                 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    val nr:   res[u32, fail.Fail] = wide_slot_lanes(ctx, ?slot, size);
    if (sel nr.err) { ret err[fail.Fail].err{nr.err}; }
    # a memory source is loaded into one wide register while the arguments are prepared, as every
    # register-bound argument is; an immediate or register source is picked from directly
    var value: mir.MirOperand = src;
    if (src.kind == mir.MIR_OP_MEM && registers != mb) {
        val vr: res[mir.VRegId, fail.Fail] = context.new_vreg(ctx, mir.REG_CLASS_GP);
        if (sel vr.err) { ret err[fail.Fail].err{vr.err}; }
        val v: mir.VRegId = vr.ok;
        ctx.f.vregs[v.n].secret = ctx.cur_writes_secret;
        val loaded: err[fail.Fail] = context.emit_mov_w(ctx, mb, mir.op_vreg(v), src, size::u8);
        if (sel loaded.err) { ret loaded; }
        value = mir.op_vreg(v);
    }
    var i: u32 = 0;
    for (i < slot.piece_count) {
        val p:  *abi.ParamPiece     = ?slot.pieces[i];
        val kr: res[u32, fail.Fail] = piece_lane(ctx, p);
        if (sel kr.err) { ret err[fail.Fail].err{kr.err}; }
        val pr: res[mir.MirOperand, fail.Fail] = lane_piece_operand(ctx, p, stack_base, stack_off, stack_ok);
        if (sel pr.err) { ret err[fail.Fail].err{pr.err}; }
        val ar: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 3::usize);
        if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
        val ops: *mir.MirOperand = ar.ok;
        ops[0] = pr.ok;
        ops[1] = value;
        ops[2] = mir.op_imm(kr.ok::i64);
        var into: *mir.MirBlock = registers;
        if (p.kind == abi.PIECE_STACK) { into = mb; }
        var mi:     mir.MirInstr   = mir.instr(mir.MIR_LANE_PICK, ops, 3, lane_width(ctx)::u8, size::u8);
        val pushed: err[fail.Fail] = context.push_instr(ctx, into, mi);
        if (sel pushed.err) { ret pushed; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun scalar_reg_move_width(gpr_width: u32, size: u64) u8 {
    if (size == 4)             { ret 4; }
    if (size > gpr_width::u64) { ret size::u8; }
    ret gpr_width::u8;
}

fun scalar_mem_move_width(gpr_width: u32, size: u64, natural: bool) u8 {
    if (natural)               { ret size::u8; }
    if (size > gpr_width::u64) { ret size::u8; }
    ret gpr_width::u8;
}

fun ptr_move_width(ctx: *context.LowerCtx) u8 {
    ret ctx.tgt.model.pointer_width::u8;
}

fun record_outgoing_size(ctx: *context.LowerCtx, bytes: i64) {
    if (bytes <= 0) { ret; }
    val need: u32 = bytes::u32;
    if (need > ctx.f.frame.outgoing_size) {
        ctx.f.frame.outgoing_size = need;
    }
}

fun emit_ret_slot_to_vreg(ctx: *context.LowerCtx, mb: *mir.MirBlock, slot: abi.ParamSlot, dst: mir.VRegId, is_aggr: bool, ty: type.IrTypeId, owned_align: u32) err[fail.Fail] {
    if (is_aggr) {
        val extent: res[u64, fail.Fail] = abi.carrier_storage_extent(?slot);
        if (sel extent.err) { ret err[fail.Fail].err{extent.err}; }
        var plan: PiecePlan;
        plan.owned_extent = extent.ok;
        plan.registers    = mb;
        plan.store        = true;
        plan.mem_base     = dst;
        plan.mem_slot     = false;
        plan.mem_align    = owned_align;
        plan.stack_base   = mir.MIR_PREG_NIL;
        plan.stack_off    = 0;
        plan.stack_ok     = false;
        ret materialize_pieces(ctx, mb, slot, plan);
    }
    if (float_slot_crosses_banks(ctx, ?slot, ty, is_aggr)) {
        ret capture_float_bits_from_slot(ctx, mb, dst, slot, ty, mir.MIR_PREG_NIL, 0, false);
    }
    if (slot_is_wide_scalar(ctx, ?slot, ty, is_aggr)) {
        ret capture_slot_lanes(ctx, mb, dst, slot, ty, mir.MIR_PREG_NIL, 0, false);
    }
    ret capture_slot_reg(ctx, mb, dst, slot, ty);
}

fun append_abi_input(inputs: *V.Vector[mir.MirAbiInput], input: mir.MirAbiInput) err[fail.Fail] {
    if (input.width == 0 || input.logical_width > input.width) {
        ret err[fail.Fail].err{fail.message("mir.abi: invalid incoming carrier extent")};
    }
    if (input.location == mir.ABI_INPUT_REGISTER) {
        if (mir.preg_is_nil(input.reg)) {
            ret err[fail.Fail].err{fail.message("mir.abi: incoming carrier has no physical register")};
        }
    }
    or (input.location != mir.ABI_INPUT_ARG_STACK || input.offset < 0) {
        ret err[fail.Fail].err{fail.message("mir.abi: invalid incoming argument-area location")};
    }
    val pushed: res[usize, A.Error] = V.push[mir.MirAbiInput](inputs, input);
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

fun record_param_input(ctx: *context.LowerCtx, inputs: *V.Vector[mir.MirAbiInput],
    index: u32, slot: abi.ParamSlot) err[fail.Fail] {
    val param: value.Value       = ctx.fn.params[index];
    val ty:    opt[*type.IrType] = type.get(ctx.types, param.ty);
    if (sel ty.none) { ret err[fail.Fail].err{fail.message("mir.abi: incoming parameter type is absent")}; }
    val size: u64 = type.byte_size_for_machine(ctx.types, param.ty, ctx.layout)::u64;
    if (size == 0) { ret err[fail.Fail].ok{}; }
    val aggregate: bool = context.value_is_aggregate(ctx, param.ty);
    val indirect:  bool = slot.class == abi.CLASS_BYREF || slot.class == abi.CLASS_STACK_BYREF
        || slot.class == abi.CLASS_VEC_BYREF || slot.class == abi.CLASS_VEC_STACK_BYREF;
    var input: mir.MirAbiInput;
    input.argument     = index;
    input.reg          = mir.MIR_PREG_NIL;
    input.secret       = param.secret;
    input.content      = mir.ABI_CONTENT_NONE;
    input.content_size = 0;
    # a pointee's secrecy is not visible at the ir boundary, so it is unknown rather than public
    if (ty.some.kind == type.IRT_PTR) { input.content = mir.ABI_CONTENT_UNKNOWN; }
    if (indirect) {
        input.width         = ctx.tgt.model.pointer_width::u64;
        input.logical_width = input.width;
        input.content_size  = size;
        input.content       = mir.ABI_CONTENT_PUBLIC;
        if (input.secret) { input.content = mir.ABI_CONTENT_SECRET; }
        input.secret = false;
        if (slot.class == abi.CLASS_STACK_BYREF || slot.class == abi.CLASS_VEC_STACK_BYREF) {
            input.location = mir.ABI_INPUT_ARG_STACK;
            input.offset   = slot.offset;
        }
        or {
            if (mir.preg_is_nil(slot.reg)) { ret err[fail.Fail].err{fail.message("mir.abi: indirect input has no physical register")}; }
            input.reg = slot.reg;
        }
        ret append_abi_input(inputs, input);
    }
    if (slot.class == abi.CLASS_STACK) {
        input.location = mir.ABI_INPUT_ARG_STACK;
        input.offset   = slot.offset;
        input.width    = size;
        if (!aggregate) {
            input.width = scalar_mem_move_width(ctx.tgt.model.gpr_width, size,
                natural_stack_slot(ctx.tgt, false))::u64;
        }
        input.logical_width = size;
        ret append_abi_input(inputs, input);
    }
    if (slot.class != abi.CLASS_GP && slot.class != abi.CLASS_FP) {
        ret err[fail.Fail].err{fail.message("mir.abi: incoming parameter has no native carrier class")};
    }
    if (slot.piece_count == 0 || slot.piece_count > abi.PARAM_MAX_PIECES) {
        ret err[fail.Fail].err{fail.message("mir.abi: incoming parameter has invalid carrier pieces")};
    }
    var i: u32 = 0;
    for (i < slot.piece_count) {
        val piece: abi.ParamPiece     = slot.pieces[i];
        val wr:    res[u8, fail.Fail] = abi.piece_memory_width(?slot, ?slot.pieces[i]);
        if (sel wr.err) { ret err[fail.Fail].err{wr.err}; }
        input.logical_width = wr.ok::u64;
        input.width         = piece.width::u64;
        input.location      = mir.ABI_INPUT_REGISTER;
        input.offset        = 0;
        if (piece.kind == abi.PIECE_STACK) {
            if (piece.stk_off < 0 || slot.offset < 0 || slot.offset > 0x7FFFFFFFFFFFFFFF - piece.stk_off) {
                ret err[fail.Fail].err{fail.message("mir.abi: incoming stack piece offset overflow")};
            }
            input.location = mir.ABI_INPUT_ARG_STACK;
            input.reg      = mir.MIR_PREG_NIL;
            input.offset   = slot.offset + piece.stk_off;
            input.width    = input.logical_width;
        }
        or {
            if (mir.preg_is_nil(piece.reg)) { ret err[fail.Fail].err{fail.message("mir.abi: incoming piece has no physical register")}; }
            input.reg = piece.reg;
        }
        if (input.logical_width != 0) {
            val added: err[fail.Fail] = append_abi_input(inputs, input);
            if (sel added.err) { ret added; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun record_abi_inputs(ctx: *context.LowerCtx, slots: *abi.SigLayout) err[fail.Fail] {
    if (slots.param_count != ctx.param_count || ctx.param_count != ctx.fn.param_count) {
        ret err[fail.Fail].err{fail.message("mir.abi: incoming signature does not match declared parameters")};
    }
    if (ctx.f.abi_inputs != nil || ctx.f.abi_input_count != 0 || ctx.f.abi_input_cap != 0) {
        ret err[fail.Fail].err{fail.message("mir.abi: incoming carrier facts were already recorded")};
    }
    var inputs: V.Vector[mir.MirAbiInput] = V.init[mir.MirAbiInput](ctx.alloc);
    fin { V.dnit[mir.MirAbiInput](?inputs); }
    if (slots.ret_slot.class == abi.CLASS_SRET) {
        if (ctx.tgt.abi.indirect_result_reg < 0) { ret err[fail.Fail].err{fail.message("mir.abi: indirect result has no physical register")}; }
        var result: mir.MirAbiInput;
        result.argument      = mir.ABI_INPUT_SRET;
        result.reg           = mir.preg_id(ctx.tgt.abi.indirect_result_reg);
        result.width         = ctx.tgt.model.pointer_width::u64;
        result.logical_width = result.width;
        result.secret        = false;
        result.content       = mir.ABI_CONTENT_OUTPUT;
        result.content_size  = type.byte_size_for_machine(ctx.types, context.fn_return_type(ctx), ctx.layout)::u64;
        val added: err[fail.Fail] = append_abi_input(?inputs, result);
        if (sel added.err) { ret added; }
    }
    var i: u32 = 0;
    for (i < slots.param_count) {
        val added: err[fail.Fail] = record_param_input(ctx, ?inputs, i, slots.params[i]);
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    ctx.f.abi_inputs      = inputs.data;
    ctx.f.abi_input_count = inputs.len;
    ctx.f.abi_input_cap   = inputs.cap;
    inputs.data           = nil;
    inputs.len            = 0;
    inputs.cap            = 0;
    ret err[fail.Fail].ok{};
}

pub fun lower_params(ctx: *context.LowerCtx, mb: *mir.MirBlock) err[fail.Fail] {
    var copies: mir.MirBlock;
    fin { mir.dnit_block(ctx.alloc, ?copies); }
    val ret_type: type.IrTypeId  = context.fn_return_type(ctx);
    var layout:   abi.SigLayout;
    val cls:      err[fail.Fail] = classify_signature(ctx, ctx.fn.sig, ret_type, ?layout);
    if (sel cls.err) { ret cls; }

    if (context.values_convention(ctx)) {
        val vr: err[fail.Fail] = lower_value_params(ctx, mb, ?layout);
        sig_layout_free(ctx, ?layout);
        ret vr;
    }

    if (ctx.f.oblivious) {
        val inputs: err[fail.Fail] = record_abi_inputs(ctx, ?layout);
        if (sel inputs.err) {
            sig_layout_free(ctx, ?layout);
            ret inputs;
        }
    }

    if (layout.ret_slot.class == abi.CLASS_SRET) {
        val sret_reg: i32                        = ctx.tgt.abi.indirect_result_reg;
        val svr:      res[mir.VRegId, fail.Fail] = context.new_vreg(ctx, mir.REG_CLASS_GP);
        if (sel svr.err) {
            sig_layout_free(ctx, ?layout);
            ret err[fail.Fail].err{svr.err};
        }
        val sv: mir.VRegId     = svr.ok;
        val mv: err[fail.Fail] = context.emit_mov_w(ctx, mb, mir.op_vreg(sv), mir.op_preg(mir.preg_id(sret_reg)),
            ptr_move_width(ctx));
        if (sel mv.err) {
            sig_layout_free(ctx, ?layout);
            ret mv;
        }
        ctx.sret_vreg = sv;
    }

    var bound: u32 = ctx.param_count;
    if (layout.param_count < bound) { bound = layout.param_count; }
    var i: u32 = 0;
    for (i < bound) {
        val pv:   mir.VRegId    = ctx.param_vregs[i];
        val pty:  type.IrTypeId = ctx.fn.params[i].ty;
        val pag:  bool          = context.value_is_aggregate(ctx, pty);
        val slot: abi.ParamSlot = layout.params[i];

        if (pag || param_has_use(ctx.fn, i)) {
            ctx.cur_writes_secret = ctx.fn.params[i].secret;
            val er: err[fail.Fail] = emit_param_slot(ctx, mb, ?copies, slot, pv, pty, slot.offset, pag);
            ctx.cur_writes_secret = false;
            if (sel er.err) {
                sig_layout_free(ctx, ?layout);
                ret er;
            }
        }
        i = i + 1;
    }

    sig_layout_free(ctx, ?layout);
    ret append_deferred(ctx, mb, ?copies);
}

# an integer the convention passes by reference (Win64's 16-byte integer); a
# vector or aggregate by reference stays an address (#3511)
fun int_by_reference(ctx: *context.LowerCtx, ty: type.IrTypeId) bool {
    val found: opt[*type.IrType] = type.get(ctx.types, ty);
    if (sel found.none) { ret false; }
    ret found.some.kind == type.IRT_INT;
}

# the value is loaded from the caller's copy, whose address `src` carries;
# legalize splits the load into lanes
fun capture_scalar_byref(ctx: *context.LowerCtx, mb: *mir.MirBlock, pv: mir.VRegId,
    ty: type.IrTypeId, src: mir.MirOperand) err[fail.Fail] {
    val ar: res[mir.VRegId, fail.Fail] = context.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel ar.err) { ret err[fail.Fail].err{ar.err}; }
    val addr: mir.VRegId     = ar.ok;
    val mr:   err[fail.Fail] = context.emit_mov_w(ctx, mb, mir.op_vreg(addr), src, ptr_move_width(ctx));
    if (sel mr.err) { ret mr; }
    val size: u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    ret context.emit_mov_w(ctx, mb, mir.op_vreg(pv), mir.op_mem_value(addr, 0), size::u8);
}

fun capture_vector_byref(ctx: *context.LowerCtx, mb: *mir.MirBlock, pv: mir.VRegId,
    ty: type.IrTypeId, src: mir.MirOperand) err[fail.Fail] {
    if (!context.value_is_vector(ctx, ty)) {
        ret context.emit_mov_w(ctx, mb, mir.op_vreg(pv), src, ptr_move_width(ctx));
    }
    val ar: res[mir.VRegId, fail.Fail] = context.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel ar.err) { ret err[fail.Fail].err{ar.err}; }
    val addr: mir.VRegId     = ar.ok;
    val mr:   err[fail.Fail] = context.emit_mov_w(ctx, mb, mir.op_vreg(addr), src, ptr_move_width(ctx));
    if (sel mr.err) { ret mr; }
    if (context.subwidth_vector_memory(ctx, ty)) {
        ret context.load_subwidth_vector(ctx, mb, mir.op_vreg(pv), mir.op_mem_value(addr, 0), ty);
    }
    val size: u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    ret context.emit_mov_w(ctx, mb, mir.op_vreg(pv), mir.op_mem_value(addr, 0), size::u8);
}

fun emit_param_slot(ctx: *context.LowerCtx, mb: *mir.MirBlock, copies: *mir.MirBlock, slot: abi.ParamSlot, pv: mir.VRegId, ty: type.IrTypeId,
    stack_off: i64, is_aggr: bool) err[fail.Fail] {
    val size:     u64 = type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    val arg_base: i64 = ctx.tgt.model.incoming_arg_base;
    if (slot.class == abi.CLASS_VEC_STACK_BYREF) {
        val fp: mir.PRegId = mir.preg_id(ctx.tgt.model.frame_ptr_reg);
        ret capture_vector_byref(ctx, mb, pv, ty, mir.op_mem_preg(fp, arg_base + stack_off));
    }
    if (slot.class == abi.CLASS_VEC_BYREF) {
        ret capture_vector_byref(ctx, mb, pv, ty, mir.op_preg(slot.reg));
    }
    if (slot.class == abi.CLASS_STACK_BYREF) {
        val fp: mir.PRegId = mir.preg_id(ctx.tgt.model.frame_ptr_reg);
        if (int_by_reference(ctx, ty)) {
            ret capture_scalar_byref(ctx, mb, pv, ty, mir.op_mem_preg(fp, arg_base + stack_off));
        }
        ret context.emit_mov_w(ctx, mb, mir.op_vreg(pv), mir.op_mem_preg(fp, arg_base + stack_off),
            ptr_move_width(ctx));
    }
    if (slot.class == abi.CLASS_STACK) {
        val fp: mir.PRegId = mir.preg_id(ctx.tgt.model.frame_ptr_reg);
        if (is_aggr) {
            ret context.emit_lea_preg(ctx, mb, pv, fp, arg_base + stack_off);
        }
        if (context.subwidth_vector_memory(ctx, ty)) {
            ret context.load_subwidth_vector(ctx, mb, mir.op_vreg(pv),
                mir.op_mem_preg(fp, arg_base + stack_off), ty);
        }
        ret context.emit_mov_w(ctx, mb, mir.op_vreg(pv), mir.op_mem_preg(fp, arg_base + stack_off),
            scalar_mem_move_width(ctx.tgt.model.gpr_width, size,
            natural_stack_slot(ctx.tgt, false)));
    }
    if (slot.class == abi.CLASS_BYREF) {
        if (int_by_reference(ctx, ty)) { ret capture_scalar_byref(ctx, mb, pv, ty, mir.op_preg(slot.reg)); }
        ret context.emit_mov_w(ctx, mb, mir.op_vreg(pv), mir.op_preg(slot.reg), ptr_move_width(ctx));
    }

    if (is_aggr) {
        val extent: res[u64, fail.Fail] = abi.carrier_storage_extent(?slot);
        if (sel extent.err) { ret err[fail.Fail].err{extent.err}; }
        val alignment: res[u32, fail.Fail] = abi.carrier_storage_alignment(?slot);
        if (sel alignment.err) { ret err[fail.Fail].err{alignment.err}; }
        var owned_align: u32 = context.ret_align(ctx, ty);
        if (ctx.tgt.model.gpr_width > owned_align) { owned_align = ctx.tgt.model.gpr_width; }
        if (alignment.ok > owned_align)            { owned_align = alignment.ok; }
        # the home is addressed through `pv`, as every other aggregate parameter is.
        # the address is public even when the bytes it names are secret
        val was_secret: bool = ctx.cur_writes_secret;
        ctx.cur_writes_secret = false;
        val hr: err[fail.Fail] = context.alloc_result_storage(ctx, mb, pv, extent.ok, owned_align);
        ctx.cur_writes_secret = was_secret;
        if (sel hr.err) { ret hr; }
        var plan: PiecePlan;
        plan.owned_extent = extent.ok;
        plan.registers    = mb;
        plan.store        = true;
        plan.mem_base     = pv;
        plan.mem_slot     = false;
        plan.mem_align    = owned_align;
        plan.copies       = copies;
        plan.stack_base   = mir.preg_id(ctx.tgt.model.frame_ptr_reg);
        plan.stack_off    = arg_base + stack_off;
        plan.stack_ok     = true;
        ret materialize_pieces(ctx, mb, slot, plan);
    }
    if (float_slot_crosses_banks(ctx, ?slot, ty, is_aggr)) {
        ret capture_float_bits_from_slot(ctx, mb, pv, slot, ty,
            mir.preg_id(ctx.tgt.model.frame_ptr_reg), arg_base + stack_off, true);
    }
    if (slot_is_wide_scalar(ctx, ?slot, ty, is_aggr)) {
        ret capture_slot_lanes(ctx, mb, pv, slot, ty,
            mir.preg_id(ctx.tgt.model.frame_ptr_reg), arg_base + stack_off, true);
    }
    ret capture_slot_reg(ctx, mb, pv, slot, ty);
}

fun param_has_use(fn: *ir.Function, param_ix: u32) bool {
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];

        var pj: u32 = 0;
        for (pj < blk.phi_count) {
            if (instr_names_param(fn, blk.phis[pj], param_ix)) { ret true; }
            pj = pj + 1;
        }

        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            if (instr_names_param(fn, blk.instructions[ii], param_ix)) { ret true; }
            ii = ii + 1;
        }

        if (instr_names_param(fn, blk.terminator, param_ix)) { ret true; }

        bi = bi + 1;
    }
    ret false;
}

fun instr_names_param(fn: *ir.Function, iid: id.InstructionId, param_ix: u32) bool {
    if (iid == id.INSTR_NIL)      { ret false; }
    if (iid::u32 >= fn.instr_len) { ret false; }
    val inst: *instruction.Instruction = ?fn.instrs[iid::u32];
    if (inst.kind == instruction.OP_DBG_VALUE) { ret false; }
    var k: u32 = 0;
    for (k < inst.operand_count) {
        val v: value.Value = inst.operands[k];
        if (v.kind == value.VAL_PARAM && v.data.param_ix == param_ix) { ret true; }
        k = k + 1;
    }
    ret false;
}

pub fun lower_ret(ctx: *context.LowerCtx, mb: *mir.MirBlock, inst: *instruction.Instruction) err[fail.Fail] {
    if (inst.operand_count == 0) {
        ret emit_bare_ret(ctx, mb);
    }
    val rv:     value.Value    = inst.operands[0];
    val rt:     type.IrTypeId  = context.fn_return_type(ctx);
    val rsz:    u64            = type.byte_size_for_machine(ctx.types, rt, ctx.layout)::u64;
    val rag:    bool           = context.value_is_aggregate(ctx, rt);
    var layout: abi.SigLayout;
    val cls:    err[fail.Fail] = classify_signature(ctx, ctx.fn.sig, rt, ?layout);
    if (sel cls.err) { ret cls; }
    val slot: abi.ParamSlot = layout.ret_slot;
    sig_layout_free(ctx, ?layout);
    val rvr: res[mir.MirOperand, fail.Fail] = lower_value_addr(ctx, mb, rv);
    if (sel rvr.err) { ret err[fail.Fail].err{rvr.err}; }
    val rvop: mir.MirOperand = rvr.ok;
    ctx.cur_writes_secret = rv.secret;
    fin { ctx.cur_writes_secret = false; }

    if (context.values_convention(ctx)) {
        if (!value_slot_valid(?slot, rsz)) { ret err[fail.Fail].err{fail.message("mir.abi: invalid logical result slot")}; }
        val ar: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 1::usize);
        if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
        val ops:        *mir.MirOperand                = ar.ok;
        val lowered_17: res[mir.MirOperand, fail.Fail] = value_operand(ctx, rv);
        if (sel lowered_17.err) { ret err[fail.Fail].err{lowered_17.err}; }
        ops[0] = lowered_17.ok;
        ret push_value_instr(ctx, mb, mir.MIR_RET, ops, 1);
    }
    if (slot.class == abi.CLASS_SRET) {
        if (mir.vreg_is_nil(ctx.sret_vreg)) {
            ret err[fail.Fail].err{fail.message("mir.lower_ir: sret return without a captured result-storage pointer")};
        }
        if (context.value_is_vector(ctx, rv.ty)) {
            val sr: err[fail.Fail] = context.store_subwidth_vector(ctx, mb, mir.op_mem_value(ctx.sret_vreg, 0), rvop, rt);
            if (sel sr.err) { ret sr; }
        }
        or (rag || context.value_is_vector(ctx, rt)) {
            val cr: err[fail.Fail] = context.copy_aggregate(ctx, mb, mir.op_mem_value(ctx.sret_vreg, 0), rvop, rsz);
            if (sel cr.err) { ret cr; }
        }
        or {
            val sr: err[fail.Fail] = context.emit_store_to_w(ctx, mb, mir.op_mem_value(ctx.sret_vreg, 0), rvop, rsz::u8);
            if (sel sr.err) { ret sr; }
        }
        val mr: err[fail.Fail] = context.emit_mov_w(ctx, mb, mir.op_preg(slot.reg),
            mir.op_vreg(ctx.sret_vreg), ptr_move_width(ctx));
        if (sel mr.err) { ret mr; }
    }
    or (rag) {
        var base: mir.VRegId     = mir.MIR_VREG_NIL;
        val ar:   err[fail.Fail] = context.addr_to_vreg(ctx, mb, rvop, ?base);
        if (sel ar.err) { ret ar; }
        var plan: PiecePlan;
        plan.registers  = mb;
        plan.store      = false;
        plan.mem_base   = base;
        plan.mem_slot   = false;
        plan.mem_align  = type.byte_align_for_machine(ctx.types, rt, ctx.layout);
        plan.stack_base = mir.MIR_PREG_NIL;
        plan.stack_off  = 0;
        plan.stack_ok   = false;
        val mr: err[fail.Fail] = materialize_pieces(ctx, mb, slot, plan);
        if (sel mr.err) { ret mr; }
    }
    or (slot.class == abi.CLASS_FP && int_rides_fp_slot(ctx, rt)) {
        val mr: err[fail.Fail] = emit_int_to_fp_reg(ctx, mb, mb, slot.reg, rvop, rt);
        if (sel mr.err) { ret mr; }
    }
    or (slot.class == abi.CLASS_FP) {
        val fw: res[u8, fail.Fail] = fp_move_width(ctx, rt);
        if (sel fw.err) { ret err[fail.Fail].err{fw.err}; }
        val mr: err[fail.Fail] = context.emit_fmov(ctx, mb, mir.op_preg(slot.reg), rvop, fw.ok);
        if (sel mr.err) { ret mr; }
    }
    or (float_slot_crosses_banks(ctx, ?slot, rt, rag)) {
        val mr: err[fail.Fail] = emit_float_bits_to_slot(ctx, mb, mb, slot, rvop, rt, mir.MIR_PREG_NIL, 0, false);
        if (sel mr.err) { ret mr; }
    }
    or (slot_is_wide_scalar(ctx, ?slot, rt, rag)) {
        val mr: err[fail.Fail] = emit_slot_lanes(ctx, mb, mb, slot, rvop, rt, mir.MIR_PREG_NIL, 0, false);
        if (sel mr.err) { ret mr; }
    }
    or (!mir.preg_is_nil(slot.reg)) {
        val mr: err[fail.Fail] = context.emit_mov_w(ctx, mb, mir.op_preg(slot.reg), rvop, scalar_reg_move_width(ctx.tgt.model.gpr_width, rsz));
        if (sel mr.err) { ret mr; }
    }

    ret emit_bare_ret(ctx, mb);
}

fun emit_bare_ret(ctx: *context.LowerCtx, mb: *mir.MirBlock) err[fail.Fail] {
    var mi: mir.MirInstr = mir.instr(mir.MIR_RET, nil, 0, ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
    ret context.push_instr(ctx, mb, mi);
}

test classify_signature__win64_uses_one_platform_boundary {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val ir_r: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel ir_r.err) { ret 1; }
    var m: ir.Module = ir_r.ok;

    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    val r_1624: err[fail.Fail] = treg.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1624.err) {
        ir.dnit(?m);
        ret 1;
    }
    val tgt_r: res[target.Target, fail.Fail] = treg.select(?reg, "x86_64", "windows", "win64");
    if (sel tgt_r.err) {
        ir.dnit(?m);
        ret 1;
    }
    var tgt: target.Target = tgt_r.ok;

    val void_r: res[type.IrTypeId, fail.Fail] = type.intern_void(?m.types);
    val i32_r:  res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel void_r.err) {
        ir.dnit(?m);
        ret 1;
    }
    if (sel i32_r.err) {
        ir.dnit(?m);
        ret 1;
    }
    val vec_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?m.types, i32_r.ok, 4);
    if (sel vec_r.err) {
        ir.dnit(?m);
        ret 1;
    }
    var params: [1]type.IrTypeId;
    params[0] = vec_r.ok;
    val sig_r: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, void_r.ok, ?params[0], 1, false);
    if (sel sig_r.err) {
        ir.dnit(?m);
        ret 1;
    }

    var ctx: context.LowerCtx;
    ctx.alloc  = ?alloc;
    ctx.tgt    = ?tgt;
    ctx.layout = target.layout_machine(?tgt);
    ctx.m      = ?m;
    ctx.types  = ?m.types;

    var layout: abi.SigLayout;
    val cls:    err[fail.Fail] = classify_signature(?ctx, sig_r.ok,
        void_r.ok, ?layout);
    if (sel cls.err) {
        ir.dnit(?m);
        ret 1;
    }
    var bad: i32 = 0;
    if (layout.param_count != 1)                       { bad = 1; }
    or (layout.params[0].class != abi.CLASS_VEC_BYREF) { bad = 1; }
    sig_layout_free(?ctx, ?layout);

    ir.dnit(?m);
    ret bad;
}

#[testing]
fun test_model(tgt: *target.Target, word: u32, ptr: u32) {
    tgt.model.gpr_width     = word;
    tgt.model.pointer_width = ptr;
}

test stack_arg__align_and_bytes {
    var w8: target.Target;
    test_model(?w8, 8, 8);
    var w4: target.Target;
    test_model(?w4, 4, 4);
    var split: target.Target;
    test_model(?split, 4, 2);

    # a by-reference argument aligns to the pointer, not its referent
    if (stack_arg_align(?split, abi.CLASS_STACK_BYREF, 16, false) != 2)     { ret 1; }
    if (stack_arg_align(?split, abi.CLASS_VEC_STACK_BYREF, 16, false) != 2) { ret 1; }
    # a word slot floors a narrow alignment at the word and keeps a wider one
    if (stack_arg_align(?w8, abi.CLASS_STACK, 4, false) != 8)   { ret 2; }
    if (stack_arg_align(?w4, abi.CLASS_STACK, 16, false) != 16) { ret 2; }
    if (stack_arg_bytes(?w4, 9, false) != 12)                   { ret 3; }
    if (stack_arg_bytes(?w8, 1, false) != 8)                    { ret 3; }
    # a natural slot packs a narrow argument at its own size and alignment
    if (stack_arg_align(?w8, abi.CLASS_STACK, 1, true) != 1) { ret 4; }
    if (stack_arg_bytes(?w8, 4, true) != 4)                  { ret 4; }
    ret 0;
}

# darwin aarch64 declares 32: an 8- or 16-bit integer with a declared
# extension is widened, a 32-bit one and one with none are not (#3927)
test caller_widens__only_narrow_arguments_with_an_extension {
    var tgt: target.Target;
    tgt.reg_arg_extend = 32;
    if (!caller_widens(?tgt, type.EXT_ZERO, 1)) { ret 1; }
    if (!caller_widens(?tgt, type.EXT_SIGN, 2)) { ret 2; }
    if (caller_widens(?tgt, type.EXT_SIGN, 4))  { ret 3; }
    if (caller_widens(?tgt, type.EXT_NONE, 1))  { ret 4; }
    tgt.reg_arg_extend = 0;
    if (caller_widens(?tgt, type.EXT_ZERO, 1)) { ret 5; }
    ret 0;
}

test stack_only_tail_slot__moves_placement_not_form {
    val gp: abi.ParamSlot = stack_only_tail_slot(abi.make_slot(abi.CLASS_GP, 1, 0, 8, 8));
    if (gp.class != abi.CLASS_STACK) { ret 1; }
    if (!mir.preg_is_nil(gp.reg))    { ret 1; }
    if (gp.piece_count != 0)         { ret 1; }
    if (gp.size != 8)                { ret 1; }
    val fp: abi.ParamSlot = stack_only_tail_slot(abi.make_slot(abi.CLASS_FP, isa.regid_make(isa.REG_CLASS_ID_XMM, 0), 0, 8, 8));
    if (fp.class != abi.CLASS_STACK) { ret 1; }
    val pair: abi.ParamSlot = stack_only_tail_slot(abi.make_slot_pair(abi.CLASS_GP, 0, 1, 0, 16, 8));
    if (pair.class != abi.CLASS_STACK) { ret 1; }
    if (pair.piece_count != 0)         { ret 1; }
    if (pair.size != 16)               { ret 1; }
    val hfa: abi.ParamSlot = stack_only_tail_slot(abi.make_slot_hfa(isa.regid_make(isa.REG_CLASS_ID_XMM, 0), 4, 8, 32));
    if (hfa.class != abi.CLASS_STACK) { ret 1; }
    if (hfa.piece_count != 0)         { ret 1; }
    val byref: abi.ParamSlot = stack_only_tail_slot(abi.make_slot(abi.CLASS_BYREF, 0, 0, 8, 8));
    if (byref.class != abi.CLASS_STACK_BYREF) { ret 1; }
    if (byref.size != 8)                      { ret 1; }
    val vstored: abi.ParamSlot = stack_only_tail_slot(abi.make_slot_indirect(abi.CLASS_VEC_BYREF, 0, 0, 8, 16, 16));
    if (vstored.class != abi.CLASS_VEC_STACK_BYREF) { ret 1; }
    if (vstored.indirect_size != 16)                { ret 1; }
    if (vstored.indirect_align != 16)               { ret 1; }
    val stk: abi.ParamSlot = stack_only_tail_slot(abi.make_slot(abi.CLASS_STACK, -1, 24, 16, 0));
    if (stk.class != abi.CLASS_STACK) { ret 1; }
    if (stk.offset != 24)             { ret 1; }
    val empty: abi.ParamSlot = stack_only_tail_slot(abi.make_slot(abi.CLASS_GP, -1, 0, 0, 0));
    if (empty.class != abi.CLASS_GP || empty.piece_count != 0) { ret 2; }
    ret 0;
}

#[testing]
fun probe_arg(index: i32, size: u64, align: u64, is_float: bool, fp_eightbytes: u8,
    is_aggregate: bool, is_vector: bool,
    gp_used: i32, fp_used: i32,
    hfa_members: u8, hfa_elem: u8, agg: abi.AggLayout) abi.ParamSlot {
    ret abi.make_slot(abi.CLASS_GP, index, 0, size, 8);
}

#[testing]
fun probe_ret(size: u64, align: u64, is_float: bool, fp_eightbytes: u8,
    is_aggregate: bool, is_vector: bool, hfa_members: u8, hfa_elem: u8,
    agg: abi.AggLayout) abi.ParamSlot {
    ret abi.make_slot(abi.CLASS_GP, 0, 0, size, 8);
}

test require_abi__variadic_facts_are_not_call_preconditions {
    var vt: isa.IsaVTable = isa.emitter_isa(isa.ARCH_UNKNOWN, "probe", 8, nil, nil);
    var av: abi.AbiVTable = abi.abi_vtable(
        0, "", 0,
        probe_arg, probe_ret,
        nil, nil,
        0, 0, 0,
        -1, false,
        false, false,
        0, 8,
        nil);

    var t: target.Target;
    t.isa = ?vt;
    t.abi = ?av;

    val require_abi_r: err[fail.Fail] = require_abi(?t);
    if (sel require_abi_r.err) { ret 1; }

    var reg:              i32            = 0;
    val abi_gp_arg_reg_r: err[fail.Fail] = abi_gp_arg_reg(?t, 0, ?reg);
    if (!sel abi_gp_arg_reg_r.err) { ret 1; }
    var vm:             abi.VaModel;
    val abi_va_model_r: err[fail.Fail] = abi_va_model(?t, ?vm);
    if (!sel abi_va_model_r.err) { ret 1; }

    av.arg_passing = nil;
    val require_abi_r2: err[fail.Fail] = require_abi(?t);
    if (!sel require_abi_r2.err) { ret 1; }
    av.arg_passing = probe_arg;
    av.ret_passing = nil;
    val require_abi_r3: err[fail.Fail] = require_abi(?t);
    if (!sel require_abi_r3.err) { ret 1; }
    ret 0;
}

test param_has_use__dbg_value_is_not_a_use {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;

    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i64t: type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn: *ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) {
        ir.dnit(?m);
        ret 1;
    }
    builder.set_block(?bld, res_entry.ok);

    val r_1884: err[fail.Fail] = builder.emit_dbg_value(?bld, value.param(0, i64t), intern.STR_NIL, i64t, semtype.TYPE_NIL, true, 0);
    if (sel r_1884.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_1885: err[fail.Fail] = builder.emit_ret(?bld, value.param(1, i64t));
    if (sel r_1885.err) {
        ir.dnit(?m);
        ret 1;
    }

    if (param_has_use(fn, 0) != false) {
        ir.dnit(?m);
        ret 1;
    }
    if (param_has_use(fn, 1) != true) {
        ir.dnit(?m);
        ret 1;
    }

    ir.dnit(?m);
    ret 0;
}

test gp_arg_regs__no_convention_exceeds_the_shared_array {
    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    val r_1920: err[fail.Fail] = treg.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1920.err) { ret 1; }

    var bad:     i32 = 0;
    var checked: i32 = 0;
    var i:       u32 = 0;
    for (i < CONV_COUNT) {
        val tr: res[target.Target, fail.Fail] =
            treg.select(?reg, CONV_ARCH[i], CONV_OS[i], CONV_ABI[i]);
        if (sel tr.err) {
            i = i + 1;
            cnt;
        }
        var tgt: target.Target = tr.ok;
        if (tgt.abi.gp_arg_regs == nil) {
            i = i + 1;
            cnt;
        }

        var scratch: [256]isa.Register;
        val fill:    abi.RegFileFn = tgt.abi.gp_arg_regs;
        val n:       i32           = fill(?scratch[0]);
        checked = checked + 1;
        if (n > MAX_GP_ARG_REGS) { bad = bad + 1; }
        if (n < 0)               { bad = bad + 1; }
        i = i + 1;
    }

    if (checked == 0) { ret 1; }
    ret bad;
}

test classify_signature__win64_odd_vector_sret_shifts_mixed_arguments {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val mr: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel mr.err) { ret 1; }
    var m: ir.Module = mr.ok;
    fin { ir.dnit(?m); }
    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    val r_1955: err[fail.Fail] = treg.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1955.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = treg.select(?reg, "x86_64", "windows", "win64");
    if (sel tr.err) { ret 1; }
    var tgt:     target.Target                 = tr.ok;
    val byte_r:  res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 8);
    val word_r:  res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    val float_r: res[type.IrTypeId, fail.Fail] = type.intern_float(?m.types, 64);
    if (sel byte_r.err)  { ret 1; }
    if (sel word_r.err)  { ret 1; }
    if (sel float_r.err) { ret 1; }
    val vector_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?m.types, byte_r.ok, 3);
    if (sel vector_r.err) { ret 1; }
    val vector: type.IrTypeId                 = vector_r.ok;
    val word:   type.IrTypeId                 = word_r.ok;
    var params: [5]type.IrTypeId              = [5]type.IrTypeId{word, float_r.ok, word, word, vector};
    val sig_r:  res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, vector, ?params[0], 5, false);
    if (sel sig_r.err) { ret 1; }
    var ctx: context.LowerCtx;
    ctx.alloc  = ?alloc;
    ctx.tgt    = ?tgt;
    ctx.layout = target.layout_machine(?tgt);
    ctx.m      = ?m;
    ctx.types  = ?m.types;
    var slots: abi.SigLayout;
    val sr:    err[fail.Fail] = classify_signature(?ctx, sig_r.ok, vector, ?slots);
    if (sel sr.err) { ret 1; }
    fin { sig_layout_free(?ctx, ?slots); }
    if (slots.ret_slot.class != abi.CLASS_SRET || slots.param_count != 5)                                                                                                       { ret 2; }
    if (mir.preg_regid(slots.params[0].reg) != 2 || mir.preg_regid(slots.params[1].reg) != isa.regid_make(isa.REG_CLASS_ID_XMM, 2) || mir.preg_regid(slots.params[2].reg) != 9) { ret 3; }
    if (slots.params[3].class != abi.CLASS_STACK || slots.params[3].offset != 32)                                                                                               { ret 4; }
    if (slots.params[4].class != abi.CLASS_VEC_STACK_BYREF || slots.params[4].offset != 40 || slots.params[4].indirect_size != 3)                                               { ret 5; }
    ret 0;
}

# (i64, u128, i64) and (i64 x5, u128, u128, i64) on aarch64: darwin starts each u128 in the next x register and
# linux rounds it up to an even pair; both give a last lone register to nothing and stack the value 16-byte aligned,
# as Apple clang and aarch64-linux-gnu clang do (#3922). after eight integers and a byte, a {u8,u8,u8}, {u8; u32}
# or #[packed] {u128} record takes an 8-byte aligned stack slot rounded up to 8 on both systems (#3950)
#[testing]
fun t_wide_after_words(alloc: *A.Allocator, os_name: str, darwin: bool) i32 {
    val mr: res[ir.Module, fail.Fail] = ir.init(alloc, intern.STR_NIL);
    if (sel mr.err) { ret 1; }
    var m: ir.Module = mr.ok;
    fin { ir.dnit(?m); }
    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    val registered: err[fail.Fail] = treg.register_all(?reg, target_testing.debug_descriptor);
    if (sel registered.err) { ret 2; }
    val tr: res[target.Target, fail.Fail] = treg.select(?reg, "aarch64", os_name, "aapcs64");
    if (sel tr.err) { ret 3; }
    var tgt:    target.Target                 = tr.ok;
    val word_r: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    val wide_r: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 128);
    if (sel word_r.err) { ret 4; }
    if (sel wide_r.err) { ret 4; }
    val word: type.IrTypeId = word_r.ok;
    val wide: type.IrTypeId = wide_r.ok;
    var ctx:  context.LowerCtx;
    ctx.alloc  = alloc;
    ctx.tgt    = ?tgt;
    ctx.layout = target.layout_machine(?tgt);
    ctx.m      = ?m;
    ctx.types  = ?m.types;

    var odd:   [3]type.IrTypeId              = [3]type.IrTypeId{word, wide, word};
    val odd_r: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, word, ?odd[0], 3, false);
    if (sel odd_r.err) { ret 5; }
    var a:  abi.SigLayout;
    val ar: err[fail.Fail] = classify_signature(?ctx, odd_r.ok, word, ?a);
    if (sel ar.err) { ret 6; }
    fin { sig_layout_free(?ctx, ?a); }
    var pair: i32 = 2;
    if (darwin) { pair = 1; }

    if (!t_gp_pair(?a.params[1], pair, pair + 1, 8, 8))                                   { ret 7; }
    if (a.params[2].class != abi.CLASS_GP || mir.preg_regid(a.params[2].reg) != pair + 2) { ret 8; }

    var tail:   [8]type.IrTypeId              = [8]type.IrTypeId{word, word, word, word, word, wide, wide, word};
    val tail_r: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, word, ?tail[0], 8, false);
    if (sel tail_r.err) { ret 9; }
    var b:  abi.SigLayout;
    val br: err[fail.Fail] = classify_signature(?ctx, tail_r.ok, word, ?b);
    if (sel br.err) { ret 10; }
    fin { sig_layout_free(?ctx, ?b); }
    pair = 6;
    if (darwin) { pair = 5; }

    if (!t_gp_pair(?b.params[5], pair, pair + 1, 8, 8))                                     { ret 11; }
    if (b.params[6].class != abi.CLASS_STACK || b.params[6].offset != 0)                    { ret 12; }
    if (b.params[7].class != abi.CLASS_STACK || b.params[7].offset != 16 || b.gp_used != 8) { ret 13; }

    val byte_r: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 8);
    val half_r: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel byte_r.err) { ret 14; }
    if (sel half_r.err) { ret 14; }
    val byte:    type.IrTypeId                 = byte_r.ok;
    var three:   [3]type.IrTypeId              = [3]type.IrTypeId{byte, byte, byte};
    var mixed:   [2]type.IrTypeId              = [2]type.IrTypeId{byte, half_r.ok};
    var lone:    [1]type.IrTypeId              = [1]type.IrTypeId{wide};
    val three_r: res[type.IrTypeId, fail.Fail] = type.intern_struct(?m.types, ?three[0], 3, 0, false);
    val mixed_r: res[type.IrTypeId, fail.Fail] = type.intern_struct(?m.types, ?mixed[0], 2, 0, false);
    val packd_r: res[type.IrTypeId, fail.Fail] = type.intern_struct(?m.types, ?lone[0], 1, 0, true);
    if (sel three_r.err) { ret 14; }
    if (sel mixed_r.err) { ret 14; }
    if (sel packd_r.err) { ret 14; }
    var records: [3]type.IrTypeId = [3]type.IrTypeId{three_r.ok, mixed_r.ok, packd_r.ok};
    var nexts:   [3]i64           = [3]i64{16, 16, 24};
    var k:       u32              = 0;
    for (k < 3) {
        var spill:   [11]type.IrTypeId             = [11]type.IrTypeId{word, word, word, word, word, word, word, word, byte, records[k], word};
        val spill_r: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, word, ?spill[0], 11, false);
        if (sel spill_r.err) { ret 15; }
        var c:  abi.SigLayout;
        val cr: err[fail.Fail] = classify_signature(?ctx, spill_r.ok, word, ?c);
        if (sel cr.err) { ret 16; }
        val rec_off:  i64 = c.params[9].offset;
        val next_off: i64 = c.params[10].offset;
        sig_layout_free(?ctx, ?c);
        if (rec_off != 8)         { ret 17 + k::i32; }
        if (next_off != nexts[k]) { ret 20 + k::i32; }
        k = k + 1;
    }
    ret 0;
}

test classify_signature__darwin_starts_a_wide_integer_in_any_register {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val d: i32 = t_wide_after_words(?alloc, "darwin", true);
    if (d != 0) { ret 10 + d; }
    val l: i32 = t_wide_after_words(?alloc, "linux", false);
    if (l != 0) { ret 30 + l; }
    ret 0;
}

test record_abi_inputs__preserve_carriers_and_indirect_contents {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val mr: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel mr.err) { ret 1; }
    var m: ir.Module = mr.ok;
    fin { ir.dnit(?m); }
    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    val r_1999: err[fail.Fail] = treg.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1999.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = treg.select(?reg, "x86_64", "windows", "win64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target                 = tr.ok;
    val br:  res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 8);
    val fr:  res[type.IrTypeId, fail.Fail] = type.intern_float(?m.types, 64);
    val pr:  res[type.IrTypeId, fail.Fail] = type.intern_ptr(?m.types);
    if (sel br.err) { ret 1; }
    if (sel fr.err) { ret 1; }
    if (sel pr.err) { ret 1; }
    val ar: res[type.IrTypeId, fail.Fail] = type.intern_array(?m.types, br.ok, 24);
    val vr: res[type.IrTypeId, fail.Fail] = type.intern_vector(?m.types, br.ok, 16);
    if (sel ar.err) { ret 1; }
    if (sel vr.err) { ret 1; }
    val array: type.IrTypeId    = ar.ok;
    val ptr:   type.IrTypeId    = pr.ok;
    var types: [7]type.IrTypeId = [7]type.IrTypeId{br.ok,
        fr.ok, ptr, ptr, array, array, vr.ok};
    val sr: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, array, ?types[0], 7, false);
    if (sel sr.err) { ret 1; }
    var params: [7]value.Value;
    var i:      u32 = 0;
    for (i < 7) {
        params[i] = value.param(i, types[i]);
        i         = i + 1;
    }
    params[0].secret = true;
    params[3].secret = true;
    params[4].secret = true;
    var fn: ir.Function;
    fn.sig         = sr.ok;
    fn.params      = ?params[0];
    fn.param_count = 7;
    var f: mir.MirFunction;
    fin { mir.dnit_function(?alloc, ?f); }
    var ctx: context.LowerCtx;
    ctx.alloc       = ?alloc;
    ctx.tgt         = ?tgt;
    ctx.layout      = target.layout_machine(?tgt);
    ctx.types       = ?m.types;
    ctx.fn          = ?fn;
    ctx.f           = ?f;
    ctx.param_count = 7;
    var slots:                abi.SigLayout;
    val classify_signature_r: err[fail.Fail] = classify_signature(?ctx, fn.sig, array, ?slots);
    if (sel classify_signature_r.err) { ret 2; }
    fin { sig_layout_free(?ctx, ?slots); }
    val record_abi_inputs_r: err[fail.Fail] = record_abi_inputs(?ctx, ?slots);
    if (sel record_abi_inputs_r.err) { ret 3; }
    if (f.abi_input_count != 8)      { ret 4; }
    val inputs: *mir.MirAbiInput = f.abi_inputs;
    if (inputs[0].argument != mir.ABI_INPUT_SRET || inputs[0].reg.n != 1
        || inputs[0].secret || inputs[0].content != mir.ABI_CONTENT_OUTPUT
        || inputs[0].content_size != 24) { ret 5; }
    i = 1;
    for (i < 8) {
        var logical: u64 = 8;
        if (i == 1) { logical = 1; }
        if (inputs[i].argument != i - 1 || inputs[i].width != 8 || inputs[i].logical_width != logical
            || param_has_use(?fn, i - 1)) { ret 6; }
        i = i + 1;
    }
    i = 0;
    for (i < 4) {
        if (inputs[i].location != mir.ABI_INPUT_REGISTER) { ret 7; }
        i = i + 1;
    }
    if (inputs[1].reg.n != 2 || !inputs[1].secret || inputs[1].content != mir.ABI_CONTENT_NONE
        || mir.preg_regid(inputs[2].reg) != isa.regid_make(isa.REG_CLASS_ID_XMM, 2) || inputs[2].secret
        || inputs[3].reg.n != 9 || inputs[3].secret || inputs[3].content != mir.ABI_CONTENT_UNKNOWN) { ret 7; }
    i = 4;
    for (i < 8) {
        if (inputs[i].location != mir.ABI_INPUT_ARG_STACK || inputs[i].offset != 32 + (i - 4)::i64 * 8) { ret 8; }
        i = i + 1;
    }
    if (!inputs[4].secret || inputs[4].content != mir.ABI_CONTENT_UNKNOWN
        || inputs[5].secret || inputs[5].content != mir.ABI_CONTENT_SECRET || inputs[5].content_size != 24
        || inputs[6].secret || inputs[6].content != mir.ABI_CONTENT_PUBLIC || inputs[6].content_size != 24
        || inputs[7].secret || inputs[7].content != mir.ABI_CONTENT_PUBLIC || inputs[7].content_size != 16) { ret 9; }
    params[0].secret = false;
    val recorded_again: err[fail.Fail] = record_abi_inputs(?ctx, ?slots);
    if (!inputs[1].secret)       { ret 10; }
    if (!sel recorded_again.err) { ret 10; }
    mir.dnit_function(?alloc, ?f);
    if (f.abi_inputs != nil || f.abi_input_count != 0 || f.abi_input_cap != 0) { ret 11; }
    ret 0;
}

#[testing]
fun t_call_preparation(indirect: bool, sret: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val mr: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel mr.err) { ret 1; }
    var m: ir.Module = mr.ok;
    fin { ir.dnit(?m); }
    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    val r_2094: err[fail.Fail] = treg.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2094.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = treg.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target                 = tr.ok;
    val br:  res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 8);
    val wr:  res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    val vr:  res[type.IrTypeId, fail.Fail] = type.intern_void(?m.types);
    if (sel br.err) { ret 1; }
    if (sel wr.err) { ret 1; }
    if (sel vr.err) { ret 1; }
    val ar: res[type.IrTypeId, fail.Fail] = type.intern_array(?m.types, br.ok, 65);
    if (sel ar.err) { ret 1; }
    val array:  type.IrTypeId    = ar.ok;
    val word:   type.IrTypeId    = wr.ok;
    var params: [7]type.IrTypeId = [7]type.IrTypeId{word, word, word, word, word, word, array};
    var result: type.IrTypeId    = vr.ok;
    if (sret) { result = array; }
    val sr: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, result, ?params[0], 7, false);
    if (sel sr.err) { ret 1; }
    val sig:    type.IrTypeId       = sr.ok;
    val r_2114: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, ir.FN_FLAG_EXTERN);
    if (sel r_2114.err) { ret 1; }
    var f: mir.MirFunction;
    fin { mir.dnit_function(?alloc, ?f); }
    val fr: res[*mir.MirVReg, A.Error] = A.allocate[mir.MirVReg](?alloc, 8);
    if (sel fr.err) { ret 1; }
    f.vregs      = fr.ok;
    f.vreg_cap   = 8;
    f.vreg_count = 3;
    f.vregs[0]   = mir.vreg(0, mir.REG_CLASS_GP, false, false);
    f.vregs[1]   = mir.vreg(1, mir.REG_CLASS_GP, false, false);
    f.vregs[2]   = mir.vreg(2, mir.REG_CLASS_GP, false, false);
    var pv:  [2]mir.VRegId = [2]mir.VRegId{mir.vreg_id(0), mir.vreg_id(1)};
    var iv:  [1]mir.VRegId = [1]mir.VRegId{mir.vreg_id(2)};
    var ctx: context.LowerCtx;
    ctx.alloc       = ?alloc;
    ctx.tgt         = ?tgt;
    ctx.layout      = target.layout_machine(?tgt);
    ctx.m           = ?m;
    ctx.types       = ?m.types;
    ctx.f           = ?f;
    ctx.param_vregs = ?pv[0];
    ctx.param_count = 2;
    ctx.instr_vregs = ?iv[0];
    ctx.instr_count = 1;
    var ops: [8]value.Value;
    ops[0] = value.fn(0, sig);
    if (indirect) { ops[0] = value.param(1, sig); }
    var i: u32 = 1;
    for (i < 7) {
        ops[i] = value.const_int(i::u64, word);
        i      = i + 1;
    }
    ops[7] = value.param(0, array);
    var call: instruction.Instruction;
    call.kind          = instruction.OP_CALL;
    call.ty            = result;
    call.aux_ty        = sig;
    call.operands      = ?ops[0];
    call.operand_count = 8;
    var mb: mir.MirBlock;
    fin { mir.dnit_block(?alloc, ?mb); }
    var iid: id.InstructionId = id.INSTR_NIL;
    if (sret) { iid = 0; }
    val lower_call_r: err[fail.Fail] = lower_call(?ctx, ?mb, ?call, iid);
    if (sel lower_call_r.err) { ret 2; }
    var saw_register: bool = false;
    var copies:       u32  = 0;
    var registers:    u32  = 0;
    var calls:        u32  = 0;
    i = 0;
    for (i < mb.instr_count) {
        val mi: *mir.MirInstr = ?mb.instrs[i];
        if (mi.opcode == mir.MIR_MEMCPY) {
            if (saw_register) { ret 3; }
            copies = copies + 1;
        }
        if (mir.instr_defines_shape(mi) && mi.operands[0].kind == mir.MIR_OP_PREG) {
            saw_register = true;
            registers    = registers + 1;
        }
        if (mi.opcode == mir.MIR_CALL) {
            calls = calls + 1;
            if (indirect && (mi.operands[0].kind != mir.MIR_OP_VREG || mi.operands[0].vreg.n != 1)) { ret 4; }
            if (!indirect && mi.operands[0].kind != mir.MIR_OP_SYM)                                 { ret 5; }
        }
        i = i + 1;
    }
    if (copies != 1 || registers != 6 || calls != 1) { ret 6; }
    ret 0;
}

test lower_call__owned_argument_preparation_precedes_register_placement {
    if (t_call_preparation(false, false) != 0) { ret 1; }
    if (t_call_preparation(true, false) != 0)  { ret 2; }
    if (t_call_preparation(false, true) != 0)  { ret 3; }
    if (t_call_preparation(true, true) != 0)   { ret 4; }
    ret 0;
}

#[testing]
rec CarrierBytes {
    memory:                  [16][32]u8;
    extent:                  [16]u32;
    virtual:                 [64][16]u8;
    physical:                [4][16]u8;
    registers:               [4]i32;
    base:                    [16]u32;
    strict_alignment:        bool;
    copy_clobbers_registers: bool;
}

#[testing]
fun t_carrier_address(bytes: *CarrierBytes, operand: mir.MirOperand, width: u32, ordinary: bool) *u8 {
    if (width > 16) { ret nil; }
    if (operand.kind == mir.MIR_OP_VREG) {
        if (operand.vreg.n >= 64) { ret nil; }
        ret ?bytes.virtual[operand.vreg.n][0];
    }
    if (operand.kind == mir.MIR_OP_PREG) {
        var i: u32 = 0;
        for (i < 4) {
            if (bytes.registers[i] == mir.preg_regid(operand.preg)) { ret ?bytes.physical[i][0]; }
            i = i + 1;
        }
        ret nil;
    }
    if (operand.kind != mir.MIR_OP_MEM || operand.imm < 0) { ret nil; }
    var key: u32 = operand.vreg.n;
    if (mir.vreg_is_nil(operand.vreg))                                       { key = 15; }
    if (key >= 16 || operand.imm::u64 + width::u64 > bytes.extent[key]::u64) { ret nil; }
    if (bytes.strict_alignment && ordinary && width > 1 &&
        (bytes.base[key]::u64 + operand.imm::u64) % width::u64 != 0) { ret nil; }
    ret ?bytes.memory[key][operand.imm::u32];
}

# the vreg a parameter's home is addressed through: the destination of the alloca
# the frame slot `value` was handed to, or the slot itself when it has none
#[testing]
fun t_home_of(block: *mir.MirBlock, value: u32) u32 {
    var i: u32 = 0;
    for (i < block.instr_count) {
        val mi: *mir.MirInstr = ?block.instrs[i];
        if (mi.opcode == mir.MIR_ALLOCA && mi.operands[1].kind == mir.MIR_OP_MEM
            && mi.operands[1].vreg.n == value && mi.operands[0].kind == mir.MIR_OP_VREG) {
            ret mi.operands[0].vreg.n;
        }
        i = i + 1;
    }
    ret value;
}

#[testing]
fun t_run_carriers(bytes: *CarrierBytes, block: *mir.MirBlock) i32 {
    var placed: bool = false;
    var i:      u32  = 0;
    for (i < block.instr_count) {
        val mi: *mir.MirInstr = ?block.instrs[i];
        if (mi.opcode == mir.MIR_ALLOCA) {
            i = i + 1;
            cnt;
        }
        if (mi.opcode != mir.MIR_MOV && mi.opcode != mir.MIR_STORE && mi.opcode != mir.MIR_MEMCPY) { ret 1; }
        var width: u32 = mi.width::u32;
        if (mi.opcode == mir.MIR_MEMCPY)                                                      { width = mi.operands[2].imm::u32; }
        if (placed && (mi.operands[1].kind == mir.MIR_OP_MEM || mi.opcode == mir.MIR_MEMCPY)) { ret 2; }
        if (mi.operands[0].kind == mir.MIR_OP_PREG)                                           { placed = true; }
        val dst: *u8 = t_carrier_address(bytes, mi.operands[0], width, mi.opcode != mir.MIR_MEMCPY);
        if (dst == nil) { ret 3; }
        var snapshot: [16]u8;
        if (mi.operands[1].kind == mir.MIR_OP_IMM) {
            if (mi.operands[1].imm != 0) { ret 4; }
        }
        or {
            val src: *u8 = t_carrier_address(bytes, mi.operands[1], width, mi.opcode != mir.MIR_MEMCPY);
            if (src == nil) { ret 5; }
            var j: u32 = 0;
            for (j < width) {
                snapshot[j] = src[j];
                j           = j + 1;
            }
        }
        var j: u32 = 0;
        for (j < width) {
            dst[j] = snapshot[j];
            j      = j + 1;
        }
        if (bytes.copy_clobbers_registers && mi.opcode == mir.MIR_MEMCPY) {
            var r: u32 = 0;
            for (r < 4) {
                j = 0;
                for (j < 16) {
                    bytes.physical[r][j] = 238;
                    j                    = j + 1;
                }
                r = r + 1;
            }
        }
        i = i + 1;
    }
    ret 0;
}

#[testing]
fun t_carrier_materialization(tgt: *target.Target, slot: abi.ParamSlot,
    store: bool, separate: bool, insufficient: bool,
    align: u32, base: u32, strict: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var f: mir.MirFunction;
    fin { mir.dnit_function(?alloc, ?f); }
    var ctx: context.LowerCtx;
    ctx.alloc  = ?alloc;
    ctx.tgt    = tgt;
    ctx.layout = target.layout_machine(tgt);
    ctx.f      = ?f;
    val vr: res[*mir.MirVReg, A.Error] = A.allocate[mir.MirVReg](?alloc, 16);
    if (sel vr.err) { ret 2; }
    f.vregs    = vr.ok;
    f.vreg_cap = 16;
    val new_vreg_r: res[mir.VRegId, fail.Fail] = context.new_vreg(?ctx, mir.REG_CLASS_GP);
    if (sel new_vreg_r.err) { ret 2; }
    var mb: mir.MirBlock;
    fin { mir.dnit_block(?alloc, ?mb); }
    var registers: mir.MirBlock;
    fin { mir.dnit_block(?alloc, ?registers); }
    val er: res[u64, fail.Fail] = abi.carrier_storage_extent(?slot);
    if (sel er.err) { ret 3; }
    val extent: u64 = er.ok;
    var plan:   PiecePlan;
    plan.store     = store;
    plan.mem_slot  = true;
    plan.mem_base  = mir.vreg_id(0);
    plan.mem_align = align;
    plan.stack_ok  = true;
    plan.registers = ?mb;
    if (separate) { plan.registers = ?registers; }
    plan.owned_extent = extent;
    if (insufficient) { plan.owned_extent = extent - 1; }
    val mr: err[fail.Fail] = materialize_pieces(?ctx, ?mb, slot, plan);
    if (insufficient) {
        if (!sel mr.err)         { ret 4; }
        if (mb.instr_count != 0) { ret 4; }
        ret 0;
    }
    if (sel mr.err) { ret 5; }
    if (separate) {
        val appended: err[fail.Fail] = append_deferred(?ctx, ?mb, ?registers);
        if (sel appended.err) { ret 6; }
    }
    var bytes: CarrierBytes;
    bytes.base[0]          = base;
    bytes.strict_alignment = strict;
    var i: u32 = 0;
    for (i < 16) {
        var j: u32 = 0;
        for (j < 32) {
            bytes.memory[i][j] = 165;
            j                  = j + 1;
        }
        i = i + 1;
    }
    bytes.extent[0] = slot.size::u32;
    if (store) { bytes.extent[0] = extent::u32; }
    i = 0;
    for (i < f.frame.slot_count) {
        val owned: *mir.MirSlot = ?f.frame.slots[i];
        if (owned.value == 0 || owned.value >= 15 || owned.size > 16) { ret 7; }
        bytes.extent[owned.value] = owned.size;
        bytes.base[owned.value]   = owned.align;
        i                         = i + 1;
    }
    i = 0;
    for (i < slot.size::u32) {
        bytes.memory[0][i] = (i * 17 + 3)::u8;
        i                  = i + 1;
    }
    i = 0;
    for (i < slot.piece_count) {
        val p: abi.ParamPiece = slot.pieces[i];
        bytes.registers[i] = mir.preg_regid(p.reg);
        var j: u32 = 0;
        for (j < p.width::u32) {
            var byte: u8 = 0;
            if (store)                               { byte = 231; }
            if (p.src_off::u64 + j::u64 < slot.size) { byte = ((p.src_off::u32 + j) * 17 + 3)::u8; }
            if (store) {
                if (p.kind == abi.PIECE_STACK) {
                    if (p.src_off::u64 + j::u64 < slot.size) { bytes.memory[15][j] = byte; }
                }
                or { bytes.physical[i][j] = byte; }
            }
            j = j + 1;
        }
        if (p.kind == abi.PIECE_STACK) { bytes.extent[15] = (slot.size - p.src_off::u64)::u32; }
        i = i + 1;
    }
    val ran: i32 = t_run_carriers(?bytes, ?mb);
    if (ran != 0) { ret 10 + ran; }
    i = 0;
    for (i < slot.piece_count) {
        val p:     abi.ParamPiece = slot.pieces[i];
        var count: u32            = p.width::u32;
        if (p.kind == abi.PIECE_STACK) { count = bytes.extent[15]; }
        var j: u32 = 0;
        for (j < count) {
            var expected: u8 = 0;
            if (store && p.kind != abi.PIECE_STACK)  { expected = 231; }
            if (p.src_off::u64 + j::u64 < slot.size) { expected = ((p.src_off::u32 + j) * 17 + 3)::u8; }
            var actual: u8 = bytes.physical[i][j];
            if (p.kind == abi.PIECE_STACK) { actual = bytes.memory[15][j]; }
            if (store)                     { actual = bytes.memory[0][p.src_off::u32 + j]; }
            if (actual != expected)        { ret 20; }
            j = j + 1;
        }
        i = i + 1;
    }
    i = bytes.extent[0];
    for (i < 32) {
        if (bytes.memory[0][i] != 165) { ret 21; }
        i = i + 1;
    }
    i = bytes.extent[15];
    for (i < 32) {
        if (bytes.memory[15][i] != 165) { ret 22; }
        i = i + 1;
    }
    ret 0;
}

test carrier_memory__exact_extent_and_padding {
    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    val r_2426: err[fail.Fail] = treg.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2426.err) { ret 1; }
    var target_index: u32 = 0;
    for (target_index < 6) {
        val tr: res[target.Target, fail.Fail] = treg.select(?reg, CONV_ARCH[target_index], CONV_OS[target_index], CONV_ABI[target_index]);
        if (sel tr.err) { ret 2; }
        var tgt:            target.Target    = tr.ok;
        val word:           u32              = tgt.model.gpr_width;
        val arg:            abi.ArgPassingFn = tgt.abi.arg_passing;
        val result:         abi.RetPassingFn = tgt.abi.ret_passing;
        val classified_arg: abi.ParamSlot    = arg(0, 4, 4, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
        val classified_ret: abi.ParamSlot    = result(4, 4, false, 0, true, false, 0, 0, abi.agg_none());
        if (classified_arg.size != 4 || classified_ret.size != 4 ||
            classified_arg.piece_count != 1 || classified_ret.piece_count != 1 ||
            classified_arg.pieces[0].width != word::u8 || classified_ret.pieces[0].width != word::u8) { ret 10; }
        # materialization is convention-independent: one 64-bit and one 32-bit word cover it
        var size: u64 = 0;
        if (target_index != 0 && target_index != 5) { size = word::u64 * 2 + 1; }
        for (size <= word::u64 * 2) {
            var slot: abi.ParamSlot = abi.make_slot_pair(abi.CLASS_GP, 0, 1, 0, size, word);
            if (size < word::u64)                                                              { slot.piece_count = 1; }
            if (t_carrier_materialization(?tgt, slot, false, false, false, 16, 0, false) != 0) { ret 3; }
            if (t_carrier_materialization(?tgt, slot, false, true, false, 16, 0, false) != 0)  { ret 4; }
            if (t_carrier_materialization(?tgt, slot, true, false, false, 16, 0, false) != 0)  { ret 5; }
            if (t_carrier_materialization(?tgt, slot, true, false, true, 16, 0, false) != 0)   { ret 6; }
            if (size > word::u64) {
                slot.pieces[1].kind = abi.PIECE_STACK;
                if (t_carrier_materialization(?tgt, slot, false, false, false, 16, 0, false) != 0) { ret 7; }
                if (t_carrier_materialization(?tgt, slot, true, false, false, 16, 0, false) != 0)  { ret 8; }
            }
            size = size + 1;
        }
        var fp: abi.ParamSlot = abi.make_slot(abi.CLASS_FP, isa.regid_make(isa.REG_CLASS_ID_XMM, 0), 0, 3, 8);
        if (t_carrier_materialization(?tgt, fp, false, false, false, 16, 0, false) != 0) { ret 9; }
        target_index = target_index + 1;
    }
    ret 0;
}

test carrier_memory__requires_legal_base_and_piece_alignment {
    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    val r_2465: err[fail.Fail] = treg.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2465.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = treg.select(?reg, "riscv64", "linux", "lp64d");
    if (sel tr.err) { ret 1; }
    var tgt:   target.Target = tr.ok;
    var width: u32           = 2;
    for (width <= 8) {
        var alignment: u32 = 1;
        for (alignment <= width) {
            var residue: u32 = 0;
            for (residue < width) {
                if (residue % alignment == 0) {
                    var slot: abi.ParamSlot = abi.make_slot(abi.CLASS_GP, 0, 0, width::u64, width::u8);
                    val read: i32           = t_carrier_materialization(?tgt, slot, false, false, false, alignment, residue, true);
                    if (read != 0) { ret read; }
                    val write: i32 = t_carrier_materialization(?tgt, slot, true, false, false, alignment, residue, true);
                    if (write != 0) { ret write; }
                    slot.size = width::u64 - 1;
                    if (t_carrier_materialization(?tgt, slot, false, true, false, alignment, residue, true) != 0) { ret 30; }
                }
                residue = residue + 1;
            }
            alignment = alignment * 2;
        }
        width = width * 2;
    }
    var offset: abi.ParamSlot = abi.make_slot(abi.CLASS_GP, 0, 0, 12, 8);
    offset.pieces[0].src_off = 4;
    val offset_read: i32 = t_carrier_materialization(?tgt, offset, false, false, false, 8, 0, true);
    if (offset_read != 0) { ret offset_read; }
    val offset_write: i32 = t_carrier_materialization(?tgt, offset, true, false, false, 8, 0, true);
    if (offset_write != 0) { ret offset_write; }
    tgt.model.gp_unaligned_widths = 2 + 4 + 8;
    offset.pieces[0].kind         = abi.PIECE_FP;
    offset.pieces[0].reg          = mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 0));
    val fp_read: i32 = t_carrier_materialization(?tgt, offset, false, false, false, 8, 0, true);
    if (fp_read != 0) { ret fp_read; }
    val fp_write: i32 = t_carrier_materialization(?tgt, offset, true, false, false, 8, 0, true);
    if (fp_write != 0) { ret fp_write; }
    ret 0;
}

#[testing]
fun t_incoming_arg(index: i32, size: u64, align: u64, is_float: bool, fp_eightbytes: u8,
    is_aggregate: bool, variadic: bool, gp_used: i32, fp_used: i32,
    hfa_count: u8, hfa_width: u8, leaves: abi.AggLayout) abi.ParamSlot {
    if (index == 2) { ret abi.make_slot(abi.CLASS_FP, isa.regid_make(isa.REG_CLASS_ID_XMM, 1), 0, size, 16); }
    if (index != 0) { ret abi.make_slot(abi.CLASS_GP, 1, 0, size, 8); }
    var slot: abi.ParamSlot = abi.make_slot(abi.CLASS_GP, 0, 0, size, 4);
    slot.piece_count = 3;
    slot.pieces[1]   = abi.ParamPiece{kind: abi.PIECE_FP, reg: mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 0)), src_off: 4, width: 8};
    slot.pieces[2]   = abi.ParamPiece{kind: abi.PIECE_STACK, reg: mir.MIR_PREG_NIL, src_off: 12, width: 4};
    slot.fp_consumed = 1;
    ret slot;
}

test incoming_copies__follow_all_parameter_captures {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val mr: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel mr.err) { ret 1; }
    var m: ir.Module = mr.ok;
    fin { ir.dnit(?m); }
    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    val r_2528: err[fail.Fail] = treg.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2528.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = treg.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt:        target.Target = tr.ok;
    var convention: abi.AbiVTable = @tgt.abi;
    convention.arg_passing        = t_incoming_arg;
    tgt.abi                       = ?convention;
    tgt.model.incoming_arg_base   = 0;
    tgt.model.gp_unaligned_widths = 0;
    val br: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 8);
    val vr: res[type.IrTypeId, fail.Fail] = type.intern_void(?m.types);
    if (sel br.err) { ret 1; }
    if (sel vr.err) { ret 1; }
    val ar: res[type.IrTypeId, fail.Fail] = type.intern_array(?m.types, br.ok, 16);
    val zr: res[type.IrTypeId, fail.Fail] = type.intern_array(?m.types, br.ok, 8);
    if (sel ar.err) { ret 1; }
    if (sel zr.err) { ret 1; }
    var types: [3]type.IrTypeId              = [3]type.IrTypeId{ar.ok, zr.ok, ar.ok};
    val sr:    res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, vr.ok, ?types[0], 3, false);
    if (sel sr.err) { ret 1; }
    var params: [3]value.Value = [3]value.Value{value.param(0, types[0]), value.param(1, types[1]), value.param(2, types[2])};
    var fn:     ir.Function;
    fn.sig         = sr.ok;
    fn.params      = ?params[0];
    fn.param_count = 3;
    var f: mir.MirFunction;
    f.oblivious = true;
    fin { mir.dnit_function(?alloc, ?f); }
    val regs: res[*mir.MirVReg, A.Error] = A.allocate[mir.MirVReg](?alloc, mir.INITIAL_VREG_CAP::usize);
    if (sel regs.err) { ret 1; }
    f.vregs    = regs.ok;
    f.vreg_cap = mir.INITIAL_VREG_CAP;
    var pv:  [3]mir.VRegId = [3]mir.VRegId{mir.vreg_id(0), mir.vreg_id(1), mir.vreg_id(2)};
    var ctx: context.LowerCtx;
    ctx.alloc       = ?alloc;
    ctx.tgt         = ?tgt;
    ctx.layout      = target.layout_machine(?tgt);
    ctx.m           = ?m;
    ctx.types       = ?m.types;
    ctx.fn          = ?fn;
    ctx.f           = ?f;
    ctx.param_vregs = ?pv[0];
    ctx.param_count = 3;
    val new_vreg_r:  res[mir.VRegId, fail.Fail] = context.new_vreg(?ctx, mir.REG_CLASS_GP);
    val new_vreg_r2: res[mir.VRegId, fail.Fail] = context.new_vreg(?ctx, mir.REG_CLASS_GP);
    val new_vreg_r3: res[mir.VRegId, fail.Fail] = context.new_vreg(?ctx, mir.REG_CLASS_GP);
    if (sel new_vreg_r.err)  { ret 1; }
    if (sel new_vreg_r2.err) { ret 1; }
    if (sel new_vreg_r3.err) { ret 1; }
    var mb: mir.MirBlock;
    fin { mir.dnit_block(?alloc, ?mb); }
    val lower_params_r: err[fail.Fail] = lower_params(?ctx, ?mb);
    if (sel lower_params_r.err) { ret 2; }
    if (f.abi_input_count != 5 || f.abi_inputs[0].secret || f.abi_inputs[1].secret
        || f.abi_inputs[2].secret || f.abi_inputs[3].secret || f.abi_inputs[4].secret) { ret 4; }
    if (f.abi_inputs[0].width != 4 || f.abi_inputs[1].width != 8
        || mir.preg_regid(f.abi_inputs[1].reg) != isa.regid_make(isa.REG_CLASS_ID_XMM, 0)
        || f.abi_inputs[2].location != mir.ABI_INPUT_ARG_STACK || f.abi_inputs[2].width != 4
        || f.abi_inputs[2].argument != 0 || f.abi_inputs[3].argument != 1
        || f.abi_inputs[4].argument != 2 || f.abi_inputs[4].width != 16) { ret 4; }
    var bytes: CarrierBytes;
    bytes.strict_alignment        = true;
    bytes.copy_clobbers_registers = true;
    bytes.registers[0]            = 0;
    bytes.registers[1]            = isa.regid_make(isa.REG_CLASS_ID_XMM, 0);
    bytes.registers[2]            = 1;
    bytes.registers[3]            = isa.regid_make(isa.REG_CLASS_ID_XMM, 1);
    var i: u32 = 0;
    for (i < f.frame.slot_count) {
        val owned: *mir.MirSlot = ?f.frame.slots[i];
        val home:  u32          = t_home_of(?mb, owned.value);
        if (home >= 15 || owned.size > 32 || owned.align < 8 ||
            (home == 2 && owned.align != 16)) { ret 3; }
        bytes.extent[home] = owned.size;
        bytes.base[home]   = owned.align;
        i                  = i + 1;
    }
    bytes.extent[15] = 4;
    i                = 0;
    for (i < 8) {
        if (i < 4) {
            bytes.physical[0][i] = (i + 1)::u8;
            bytes.memory[15][i]  = (i + 13)::u8;
        }
        bytes.physical[1][i] = (i + 5)::u8;
        bytes.physical[2][i] = (i + 17)::u8;
        i                    = i + 1;
    }
    i = 0;
    for (i < 16) {
        bytes.physical[3][i] = (i + 25)::u8;
        i                    = i + 1;
    }
    val ran: i32 = t_run_carriers(?bytes, ?mb);
    if (ran != 0) { ret 10 + ran; }
    i = 0;
    for (i < 16) {
        if (bytes.memory[0][i] != (i + 1)::u8 || bytes.memory[2][i] != (i + 25)::u8) { ret 20; }
        if (i < 8 && bytes.memory[1][i] != (i + 17)::u8)                             { ret 21; }
        i = i + 1;
    }
    ret 0;
}

# an rv32 f64 past the fa registers follows the integer convention, which
# splits it across a0:a1 and finally a7 with a stack word. rv32 has no 8-byte
# cross-bank move, so each of those parameters arrives as a lane join into a
# general register pair, a store to a frame slot, and a float load from it,
# and no move names a general register beside an f64 float register (#3617)
test rv32_f64__past_the_fa_registers_arrives_through_a_frame_slot {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val mr: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel mr.err) { ret 1; }
    var m: ir.Module = mr.ok;
    fin { ir.dnit(?m); }
    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    val rr: err[fail.Fail] = treg.register_all(?reg, target_testing.debug_descriptor);
    if (sel rr.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = treg.select(?reg, "rv32imafdc", "freestanding", "ilp32d");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target                 = tr.ok;
    val dr:  res[type.IrTypeId, fail.Fail] = type.intern_float(?m.types, 64);
    val ir_: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    val vr:  res[type.IrTypeId, fail.Fail] = type.intern_void(?m.types);
    if (sel dr.err)  { ret 1; }
    if (sel ir_.err) { ret 1; }
    if (sel vr.err)  { ret 1; }
    # eight f64 fill fa0-fa7, the i32 takes a0, then four f64 ride a1:a2, a3:a4,
    # a5:a6 and a7 with the high word on the stack
    var types:  [13]type.IrTypeId;
    var params: [13]value.Value;
    var i:      u32 = 0;
    for (i < 13) {
        types[i] = dr.ok;
        if (i == 8) { types[i] = ir_.ok; }
        params[i] = value.param(i, types[i]);
        i         = i + 1;
    }
    val sr: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, vr.ok, ?types[0], 13, false);
    if (sel sr.err) { ret 1; }
    var fn: ir.Function;
    fn.sig         = sr.ok;
    fn.params      = ?params[0];
    fn.param_count = 13;
    var f: mir.MirFunction;
    f.oblivious = true;
    fin { mir.dnit_function(?alloc, ?f); }
    val regs: res[*mir.MirVReg, A.Error] = A.allocate[mir.MirVReg](?alloc, mir.INITIAL_VREG_CAP::usize);
    if (sel regs.err) { ret 1; }
    f.vregs    = regs.ok;
    f.vreg_cap = mir.INITIAL_VREG_CAP;
    var pv:  [13]mir.VRegId;
    var ctx: context.LowerCtx;
    ctx.alloc       = ?alloc;
    ctx.tgt         = ?tgt;
    ctx.layout      = target.layout_machine(?tgt);
    ctx.m           = ?m;
    ctx.types       = ?m.types;
    ctx.fn          = ?fn;
    ctx.f           = ?f;
    ctx.param_vregs = ?pv[0];
    ctx.param_count = 13;
    i               = 0;
    for (i < 13) {
        var class: u32 = isa.REG_CLASS_ID_XMM::u32;
        if (i == 8) { class = mir.REG_CLASS_GP; }
        val nv: res[mir.VRegId, fail.Fail] = context.new_vreg(?ctx, class);
        if (sel nv.err) { ret 1; }
        pv[i] = nv.ok;
        i     = i + 1;
    }
    var mb:     mir.MirBlock;
    var copies: mir.MirBlock;
    fin { mir.dnit_block(?alloc, ?mb); }
    fin { mir.dnit_block(?alloc, ?copies); }
    var layout: abi.SigLayout;
    val cls:    err[fail.Fail] = classify_signature(?ctx, sr.ok, vr.ok, ?layout);
    if (sel cls.err) { ret 2; }
    fin { sig_layout_free(?ctx, ?layout); }
    if (layout.param_count != 13) { ret 2; }
    i = 9;
    for (i < 13) {
        val captured: err[fail.Fail] = emit_param_slot(?ctx, ?mb, ?copies, layout.params[i], pv[i], dr.ok, layout.params[i].offset, false);
        if (sel captured.err) { ret 2; }
        i = i + 1;
    }

    var joins: u32 = 0;
    i = 0;
    for (i < mb.instr_count) {
        val mi: *mir.MirInstr = ?mb.instrs[i];
        if (mi.opcode == mir.MIR_MOV && mi.operand_count == 2 && mi.width == 8) {
            val d:    *mir.MirOperand = ?mi.operands[0];
            val o:    *mir.MirOperand = ?mi.operands[1];
            val d_fp: bool            = d.kind == mir.MIR_OP_VREG && mir.vreg_is_fp(?f, d.vreg);
            if (d_fp && o.kind == mir.MIR_OP_PREG && isa.regid_class(mir.preg_regid(o.preg)) == isa.REG_CLASS_ID_GP) { ret 3; }
        }
        if (mi.opcode == mir.MIR_LANE_JOIN) {
            if (mi.operand_count != 3 || mi.width != 8 || mi.src_width != 4)                       { ret 4; }
            if (mi.operands[0].kind != mir.MIR_OP_VREG || mir.vreg_is_fp(?f, mi.operands[0].vreg)) { ret 4; }
            val expected: i32 = 11 + (joins * 2)::i32;
            if (mi.operands[1].kind != mir.MIR_OP_PREG || mir.preg_regid(mi.operands[1].preg) != expected) { ret 5; }
            if (joins < 3) {
                if (mi.operands[2].kind != mir.MIR_OP_PREG || mir.preg_regid(mi.operands[2].preg) != expected + 1) { ret 5; }
            }
            or {
                if (mi.operands[2].kind != mir.MIR_OP_MEM) { ret 5; }
            }
            if (i + 2 >= mb.instr_count) { ret 6; }
            val st: *mir.MirInstr = ?mb.instrs[i + 1];
            val ld: *mir.MirInstr = ?mb.instrs[i + 2];
            if (st.opcode != mir.MIR_MOV || st.width != 8 || st.operands[0].kind != mir.MIR_OP_MEM
                || st.operands[1].kind != mir.MIR_OP_VREG || st.operands[1].vreg.n != mi.operands[0].vreg.n) { ret 7; }
            if (ld.opcode != mir.MIR_MOV || ld.width != 8 || ld.operands[1].kind != mir.MIR_OP_MEM
                || ld.operands[1].vreg.n != st.operands[0].vreg.n
                || ld.operands[0].kind != mir.MIR_OP_VREG || ld.operands[0].vreg.n != pv[9 + joins].n) { ret 8; }
            joins = joins + 1;
        }
        i = i + 1;
    }
    if (joins != 4) { ret 9; }
    ret 0;
}

# the outgoing side of the same convention: a float register argument is
# stored to a frame slot while the arguments are prepared and its two lanes are
# picked into the register pair; a float immediate is its own bits and is
# picked directly (#3617)
test rv32_f64__in_a_register_pair_leaves_through_a_frame_slot {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val mr: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel mr.err) { ret 1; }
    var m: ir.Module = mr.ok;
    fin { ir.dnit(?m); }
    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    val rr: err[fail.Fail] = treg.register_all(?reg, target_testing.debug_descriptor);
    if (sel rr.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = treg.select(?reg, "rv32imafdc", "freestanding", "ilp32d");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target                 = tr.ok;
    val dr:  res[type.IrTypeId, fail.Fail] = type.intern_float(?m.types, 64);
    if (sel dr.err) { ret 1; }
    var f: mir.MirFunction;
    fin { mir.dnit_function(?alloc, ?f); }
    val regs: res[*mir.MirVReg, A.Error] = A.allocate[mir.MirVReg](?alloc, mir.INITIAL_VREG_CAP::usize);
    if (sel regs.err) { ret 1; }
    f.vregs    = regs.ok;
    f.vreg_cap = mir.INITIAL_VREG_CAP;
    var ctx: context.LowerCtx;
    ctx.alloc  = ?alloc;
    ctx.tgt    = ?tgt;
    ctx.layout = target.layout_machine(?tgt);
    ctx.m      = ?m;
    ctx.types  = ?m.types;
    ctx.f      = ?f;
    val fv: res[mir.VRegId, fail.Fail] = context.new_vreg(?ctx, isa.REG_CLASS_ID_XMM::u32);
    if (sel fv.err) { ret 1; }
    val slot:       abi.ParamSlot = abi.make_slot_pair(abi.CLASS_GP, 10, 11, 0, 8, 4);
    var mb:         mir.MirBlock;
    var regs_block: mir.MirBlock;
    fin { mir.dnit_block(?alloc, ?mb); }
    fin { mir.dnit_block(?alloc, ?regs_block); }

    val from_reg: err[fail.Fail] = emit_arg_slot(?ctx, ?mb, ?regs_block, slot, mir.op_vreg(fv.ok), 0, false, dr.ok, false, type.EXT_NONE);
    if (sel from_reg.err) { ret 2; }
    # preparation: the float store to the slot, then the slot loaded as one wide general value
    if (mb.instr_count != 2) { ret 3; }
    if (mb.instrs[0].opcode != mir.MIR_MOV || mb.instrs[0].width != 8
        || mb.instrs[0].operands[0].kind != mir.MIR_OP_MEM
        || mb.instrs[0].operands[1].kind != mir.MIR_OP_VREG || mb.instrs[0].operands[1].vreg.n != fv.ok.n) { ret 4; }
    if (mb.instrs[1].opcode != mir.MIR_MOV || mb.instrs[1].width != 8
        || mb.instrs[1].operands[0].kind != mir.MIR_OP_VREG || mir.vreg_is_fp(?f, mb.instrs[1].operands[0].vreg)
        || mb.instrs[1].operands[1].kind != mir.MIR_OP_MEM
        || mb.instrs[1].operands[1].vreg.n != mb.instrs[0].operands[0].vreg.n) { ret 5; }
    if (regs_block.instr_count != 2) { ret 6; }
    var k: u32 = 0;
    for (k < 2) {
        val pick: *mir.MirInstr = ?regs_block.instrs[k];
        if (pick.opcode != mir.MIR_LANE_PICK || pick.operand_count != 3 || pick.width != 4)                         { ret 7; }
        if (pick.operands[0].kind != mir.MIR_OP_PREG || mir.preg_regid(pick.operands[0].preg) != 10 + k::i32)       { ret 7; }
        if (pick.operands[1].kind != mir.MIR_OP_VREG || pick.operands[1].vreg.n != mb.instrs[1].operands[0].vreg.n) { ret 7; }
        if (pick.operands[2].kind != mir.MIR_OP_IMM || pick.operands[2].imm != k::i64)                              { ret 7; }
        k = k + 1;
    }

    mb.instr_count         = 0;
    regs_block.instr_count = 0;
    val from_imm: err[fail.Fail] = emit_arg_slot(?ctx, ?mb, ?regs_block, slot, mir.op_imm(0x3FF0000000000000), 0, false, dr.ok, false, type.EXT_NONE);
    if (sel from_imm.err)                                   { ret 8; }
    if (mb.instr_count != 0 || regs_block.instr_count != 2) { ret 9; }
    k = 0;
    for (k < 2) {
        val pick: *mir.MirInstr = ?regs_block.instrs[k];
        if (pick.opcode != mir.MIR_LANE_PICK || pick.operands[1].kind != mir.MIR_OP_IMM
            || pick.operands[1].imm != 0x3FF0000000000000) { ret 10; }
        k = k + 1;
    }
    ret 0;
}

#[testing]
fun t_result_carrier_alignment(element_bits: u32, count: u32) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val mr: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel mr.err) { ret 1; }
    var m: ir.Module = mr.ok;
    fin { ir.dnit(?m); }
    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    val r_2638: err[fail.Fail] = treg.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2638.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = treg.select(?reg, "riscv64", "linux", "lp64d");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target                 = tr.ok;
    val er:  res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, element_bits);
    if (sel er.err) { ret 1; }
    val ar: res[type.IrTypeId, fail.Fail] = type.intern_array(?m.types, er.ok, count);
    if (sel ar.err) { ret 1; }
    val array: type.IrTypeId                 = ar.ok;
    val sr:    res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, array, nil, 0, false);
    if (sel sr.err) { ret 1; }
    val sig:    type.IrTypeId       = sr.ok;
    val r_2650: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, ir.FN_FLAG_EXTERN);
    if (sel r_2650.err) { ret 1; }
    var f: mir.MirFunction;
    fin { mir.dnit_function(?alloc, ?f); }
    val regs: res[*mir.MirVReg, A.Error] = A.allocate[mir.MirVReg](?alloc, mir.INITIAL_VREG_CAP::usize);
    if (sel regs.err) { ret 1; }
    f.vregs    = regs.ok;
    f.vreg_cap = mir.INITIAL_VREG_CAP;
    var iv:  [1]mir.VRegId = [1]mir.VRegId{mir.vreg_id(0)};
    var ctx: context.LowerCtx;
    ctx.alloc       = ?alloc;
    ctx.tgt         = ?tgt;
    ctx.layout      = target.layout_machine(?tgt);
    ctx.m           = ?m;
    ctx.types       = ?m.types;
    ctx.f           = ?f;
    ctx.instr_vregs = ?iv[0];
    ctx.instr_count = 1;
    val new_vreg_r: res[mir.VRegId, fail.Fail] = context.new_vreg(?ctx, mir.REG_CLASS_GP);
    if (sel new_vreg_r.err) { ret 1; }
    var callee: value.Value = value.fn(0, sig);
    var call:   instruction.Instruction;
    call.kind          = instruction.OP_CALL;
    call.ty            = array;
    call.aux_ty        = sig;
    call.operands      = ?callee;
    call.operand_count = 1;
    var mb: mir.MirBlock;
    fin { mir.dnit_block(?alloc, ?mb); }
    val lower_call_r: err[fail.Fail] = lower_call(?ctx, ?mb, ?call, 0);
    if (sel lower_call_r.err)                                                                  { ret 2; }
    if (f.frame.slot_count == 0 || f.frame.slots[0].align != 8 || f.frame.slots[0].size != 16) { ret 3; }
    if (type.byte_align_for_machine(?m.types, array, ctx.layout) != element_bits / 8 ||
        type.byte_size_for_machine(?m.types, array, ctx.layout) != element_bits / 8 * count) { ret 4; }
    ret 0;
}

test lower_call__result_owns_carrier_alignment_without_changing_logical_layout {
    val nine: i32 = t_result_carrier_alignment(8, 9);
    if (nine != 0) { ret nine; }
    ret t_result_carrier_alignment(32, 3);
}

# record shapes for the transport inventory (#3263); each is a record IR type built the way lower_rec builds it
#[testing]
val REC_P1: u32 = 0;
#[testing]
val REC_T3: u32 = 1;
#[testing]
val REC_S8: u32 = 2;
#[testing]
val REC_T9: u32 = 3;
#[testing]
val REC_T16: u32 = 4;
#[testing]
val REC_O24: u32 = 5;
#[testing]
val REC_NEST: u32 = 6;
#[testing]
val REC_AL16: u32 = 7;
#[testing]
val REC_TF16: u32 = 8;
#[testing]
val REC_TF8: u32 = 9;
#[testing]
val REC_TFM: u32 = 10;
#[testing]
val REC_SHAPE_COUNT: u32 = 11;

# packed shapes (#3266), outside the sweep because their cells differ per convention: an unaligned u32, an
# unaligned i64, a packed record whose fields happen to sit aligned, and an array whose packed element is
# aligned in element 0 and unaligned in element 1
#[testing]
val REC_PK5: u32 = 11;
#[testing]
val REC_PK9: u32 = 12;
#[testing]
val REC_PKA: u32 = 13;
#[testing]
val REC_PKARR: u32 = 14;

#[testing]
fun t_rec_shape(types: *type.IrTypeTable, which: u32) res[type.IrTypeId, fail.Fail] {
    val u8r:  res[type.IrTypeId, fail.Fail] = type.intern_int(types, 8);
    val u32r: res[type.IrTypeId, fail.Fail] = type.intern_int(types, 32);
    val i64r: res[type.IrTypeId, fail.Fail] = type.intern_int(types, 64);
    val f32r: res[type.IrTypeId, fail.Fail] = type.intern_float(types, 32);
    val f64r: res[type.IrTypeId, fail.Fail] = type.intern_float(types, 64);
    if (sel u8r.err)  { ret res[type.IrTypeId, fail.Fail].err{fail.message("leaf")}; }
    if (sel u32r.err) { ret res[type.IrTypeId, fail.Fail].err{fail.message("leaf")}; }
    if (sel i64r.err) { ret res[type.IrTypeId, fail.Fail].err{fail.message("leaf")}; }
    if (sel f32r.err) { ret res[type.IrTypeId, fail.Fail].err{fail.message("leaf")}; }
    if (sel f64r.err) { ret res[type.IrTypeId, fail.Fail].err{fail.message("leaf")}; }
    val u8t:    type.IrTypeId = u8r.ok;
    val u32t:   type.IrTypeId = u32r.ok;
    val i64t:   type.IrTypeId = i64r.ok;
    val f32t:   type.IrTypeId = f32r.ok;
    val f64t:   type.IrTypeId = f64r.ok;
    var fields: [2]type.IrTypeId;
    fields[0] = u8t;
    var count:  u32  = 2;
    var align:  u32  = 0;
    var packed: bool = false;
    if (which == REC_P1) { count = 1; }
    or (which == REC_T3) {
        val a: res[type.IrTypeId, fail.Fail] = type.intern_array(types, u8t, 2);
        if (sel a.err) { ret a; }
        fields[1] = a.ok;
    }
    or (which == REC_S8) { fields[1] = u32t; }
    or (which == REC_T9) {
        val a: res[type.IrTypeId, fail.Fail] = type.intern_array(types, u8t, 8);
        if (sel a.err) { ret a; }
        fields[1] = a.ok;
    }
    or (which == REC_T16) { fields[1] = i64t; }
    or (which == REC_O24) {
        val a: res[type.IrTypeId, fail.Fail] = type.intern_array(types, i64t, 2);
        if (sel a.err) { ret a; }
        fields[1] = a.ok;
    }
    or (which == REC_NEST) {
        val inner: res[type.IrTypeId, fail.Fail] = t_rec_shape(types, REC_S8);
        if (sel inner.err) { ret inner; }
        fields[1] = inner.ok;
    }
    or (which == REC_AL16) {
        fields[1] = u8t;
        align     = 16;
    }
    or (which == REC_TF16) { fields[1] = f64t; }
    or (which == REC_TF8)  { fields[1] = f32t; }
    or (which == REC_TFM) {
        fields[0] = f64t;
        fields[1] = i64t;
    }
    or (which == REC_PK5) {
        fields[1] = u32t;
        packed    = true;
    }
    or (which == REC_PK9) {
        fields[1] = i64t;
        packed    = true;
    }
    or (which == REC_PKA) {
        fields[0] = i64t;
        fields[1] = u32t;
        packed    = true;
    }
    or (which == REC_PKARR) {
        var ef: [2]type.IrTypeId;
        ef[0] = u32t;
        ef[1] = u8t;
        val inner: res[type.IrTypeId, fail.Fail] = type.intern_struct(types, ?ef[0], 2, 0, true);
        if (sel inner.err) { ret inner; }
        val a: res[type.IrTypeId, fail.Fail] = type.intern_array(types, inner.ok, 2);
        if (sel a.err) { ret a; }
        fields[0] = a.ok;
        count     = 1;
    }
    or { ret res[type.IrTypeId, fail.Fail].err{fail.message("shape")}; }
    ret type.intern_struct(types, ?fields[0], count, align, packed);
}

#[testing]
rec RecTransport {
    size:       u64;
    align:      u32;
    hfa:        u8;
    eightbytes: u8;
    arg:        abi.ParamSlot;
    ret:        abi.ParamSlot;
}

# every convention the transport sweeps read, selected once from one registry
#[testing]
rec TConvs {
    reg:         treg.TargetRegistry;
    sysv:        target.Target;
    sysv_darwin: target.Target;
    win64:       target.Target;
    aapcs64:     target.Target;
    lp64d:       target.Target;
    lp64:        target.Target;
    rv32d:       target.Target;
    rv32:        target.Target;
}

#[testing]
fun t_select(reg: *treg.TargetRegistry, isa_name: str, os_name: str, abi_name: str, out: *target.Target) bool {
    val tr: res[target.Target, fail.Fail] = treg.select(reg, isa_name, os_name, abi_name);
    if (sel tr.err) { ret false; }
    @out = tr.ok;
    ret true;
}

#[testing]
fun t_convs_init(c: *TConvs) bool {
    c.reg = treg.registry_init();
    val registered: err[fail.Fail] = treg.register_all(?c.reg, target_testing.debug_descriptor);
    if (sel registered.err) { ret false; }
    ret t_select(?c.reg, "x86_64", "linux", "sysv64", ?c.sysv)
        && t_select(?c.reg, "x86_64", "darwin", "sysv64", ?c.sysv_darwin)
        && t_select(?c.reg, "x86_64", "windows", "win64", ?c.win64)
        && t_select(?c.reg, "aarch64", "linux", "aapcs64", ?c.aapcs64)
        && t_select(?c.reg, "riscv64", "linux", "lp64d", ?c.lp64d)
        && t_select(?c.reg, "riscv64", "linux", "lp64", ?c.lp64)
        && t_select(?c.reg, "rv32imafdc", "freestanding", "ilp32d", ?c.rv32d)
        && t_select(?c.reg, "rv32imc", "freestanding", "ilp32", ?c.rv32);
}

# classifies `fun(T)` and `fun() T` for one convention through the real type derivation and the real vtable
#[testing]
fun t_rec_transport(alloc: *A.Allocator, tgt: *target.Target, which: u32, out: *RecTransport) i32 {
    val mr: res[ir.Module, fail.Fail] = ir.init(alloc, intern.STR_NIL);
    if (sel mr.err) { ret 1; }
    var m: ir.Module = mr.ok;
    fin { ir.dnit(?m); }
    val sr: res[type.IrTypeId, fail.Fail] = t_rec_shape(?m.types, which);
    if (sel sr.err) { ret 4; }
    var rec_t: type.IrTypeId                 = sr.ok;
    val vr:    res[type.IrTypeId, fail.Fail] = type.intern_void(?m.types);
    if (sel vr.err) { ret 5; }
    val void_t: type.IrTypeId = vr.ok;
    # the argument is classified on `fun(T)` and the return on `fun() T`, so a hidden result pointer never shifts the argument
    val ar: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, void_t, ?rec_t, 1, false);
    val rr: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, rec_t, nil, 0, false);
    if (sel ar.err) { ret 5; }
    if (sel rr.err) { ret 5; }
    var ctx: context.LowerCtx;
    ctx.alloc  = alloc;
    ctx.tgt    = tgt;
    ctx.layout = target.layout_machine(tgt);
    ctx.m      = ?m;
    ctx.types  = ?m.types;
    var layout:               abi.SigLayout;
    val classify_signature_r: err[fail.Fail] = classify_signature(?ctx, ar.ok, void_t, ?layout);
    if (sel classify_signature_r.err) { ret 6; }
    if (layout.param_count != 1) {
        sig_layout_free(?ctx, ?layout);
        ret 7;
    }
    out.arg = layout.params[0];
    sig_layout_free(?ctx, ?layout);
    var rlayout:               abi.SigLayout;
    val classify_signature_r2: err[fail.Fail] = classify_signature(?ctx, rr.ok, rec_t, ?rlayout);
    if (sel classify_signature_r2.err) { ret 8; }
    out.ret = rlayout.ret_slot;
    sig_layout_free(?ctx, ?rlayout);
    out.size  = type.byte_size_for_machine(?m.types, rec_t, ctx.layout)::u64;
    out.align = type.byte_align_for_machine(?m.types, rec_t, ctx.layout);
    var he: u8 = 0;
    hfa_info(?ctx, rec_t, ?out.hfa, ?he);
    out.eightbytes = aggregate_eightbyte_mask(?ctx, rec_t);
    ret 0;
}

# one register piece: class, register, transport width; the logical bytes it moves come from piece_memory_width
#[testing]
fun t_piece_is(slot: *abi.ParamSlot, i: u32, kind: abi.PieceKind, reg: i32, width: u8, logical: u8) bool {
    if (i >= slot.piece_count) { ret false; }
    val p: *abi.ParamPiece = ?slot.pieces[i];
    if (p.kind != kind || mir.preg_regid(p.reg) != reg || p.width != width) { ret false; }
    val lw: res[u8, fail.Fail] = abi.piece_memory_width(slot, p);
    if (sel lw.err) { ret false; }
    ret lw.ok == logical;
}

#[testing]
fun t_one_gp(slot: *abi.ParamSlot, reg: i32, width: u8, logical: u8) bool {
    ret slot.class == abi.CLASS_GP && slot.piece_count == 1 && t_piece_is(slot, 0, abi.PIECE_GP, reg, width, logical);
}

#[testing]
fun t_gp_pair(slot: *abi.ParamSlot, r0: i32, r1: i32, width: u8, logical1: u8) bool {
    ret slot.class == abi.CLASS_GP && slot.piece_count == 2
        && t_piece_is(slot, 0, abi.PIECE_GP, r0, width, width)
        && t_piece_is(slot, 1, abi.PIECE_GP, r1, width, logical1);
}

# a two-leaf split: one general and one float register, each carrying its own leaf at its own offset
#[testing]
fun t_leaf_split(slot: *abi.ParamSlot, kind0: abi.PieceKind, r0: i32, w0: u8, kind1: abi.PieceKind, r1: i32, off1: u8, w1: u8) bool {
    ret slot.piece_count == 2
        && t_piece_is(slot, 0, kind0, r0, w0, w0)
        && t_piece_is(slot, 1, kind1, r1, w1, w1)
        && slot.pieces[0].src_off == 0 && slot.pieces[1].src_off == off1::i64;
}

#[testing]
fun t_byref(slot: *abi.ParamSlot, reg: i32) bool {
    ret slot.class == abi.CLASS_BYREF && mir.preg_regid(slot.reg) == reg;
}

#[testing]
fun t_sret(slot: *abi.ParamSlot, reg: i32) bool {
    ret slot.class == abi.CLASS_SRET && mir.preg_regid(slot.reg) == reg;
}

#[testing]
val SYSV_RDI: i32 = 7;
#[testing]
val SYSV_RSI: i32 = 6;
#[testing]
val SYSV_RAX: i32 = 0;
#[testing]
val SYSV_RDX: i32 = 2;
#[testing]
val WIN_RCX: i32 = 1;
#[testing]
val AAPCS_X8: i32 = 8;
#[testing]
val RV_A0: i32 = 10;
#[testing]
val RV_A1: i32 = 11;

#[testing]
fun t_xmm(i: i32) i32 {
    ret isa.regid_make(isa.REG_CLASS_ID_XMM, i);
}

#[testing]
fun t_fa(i: i32) i32 {
    ret isa.regid_make(isa.REG_CLASS_ID_XMM, RV_A0 + i);
}

# the SysV cells: an integer leaf makes its eightbyte INTEGER, a float-only eightbyte is SSE, and an eightbyte
# holding only padding consumes no register at all
#[testing]
fun t_sysv_cells(alloc: *A.Allocator, c: *TConvs) i32 {
    var t: RecTransport;
    if (t_rec_transport(alloc, ?c.sysv, REC_P1, ?t) != 0)                                                             { ret 1; }
    if (t.size != 1 || !t_one_gp(?t.arg, SYSV_RDI, 8, 1) || !t_one_gp(?t.ret, SYSV_RAX, 8, 1))                        { ret 2; }
    if (t_rec_transport(alloc, ?c.sysv, REC_T3, ?t) != 0)                                                             { ret 3; }
    if (t.size != 3 || !t_one_gp(?t.arg, SYSV_RDI, 8, 3) || !t_one_gp(?t.ret, SYSV_RAX, 8, 3))                        { ret 4; }
    if (t_rec_transport(alloc, ?c.sysv, REC_S8, ?t) != 0)                                                             { ret 5; }
    if (t.size != 8 || !t_one_gp(?t.arg, SYSV_RDI, 8, 8) || !t_one_gp(?t.ret, SYSV_RAX, 8, 8))                        { ret 6; }
    if (t_rec_transport(alloc, ?c.sysv, REC_T9, ?t) != 0)                                                             { ret 7; }
    if (t.size != 9 || !t_gp_pair(?t.arg, SYSV_RDI, SYSV_RSI, 8, 1) || !t_gp_pair(?t.ret, SYSV_RAX, SYSV_RDX, 8, 1))  { ret 8; }
    if (t_rec_transport(alloc, ?c.sysv, REC_T16, ?t) != 0)                                                            { ret 9; }
    if (t.size != 16 || !t_gp_pair(?t.arg, SYSV_RDI, SYSV_RSI, 8, 8) || !t_gp_pair(?t.ret, SYSV_RAX, SYSV_RDX, 8, 8)) { ret 10; }
    if (t_rec_transport(alloc, ?c.sysv, REC_O24, ?t) != 0)                                                            { ret 11; }
    if (t.size != 24 || t.arg.class != abi.CLASS_STACK || t.arg.size != 24 || !t_sret(?t.ret, SYSV_RAX))              { ret 12; }
    if (t_rec_transport(alloc, ?c.sysv, REC_NEST, ?t) != 0)                                                           { ret 13; }
    if (t.size != 12 || !t_gp_pair(?t.arg, SYSV_RDI, SYSV_RSI, 8, 4) || !t_gp_pair(?t.ret, SYSV_RAX, SYSV_RDX, 8, 4)) { ret 14; }
    if (t_rec_transport(alloc, ?c.sysv, REC_AL16, ?t) != 0)                                                           { ret 15; }
    if (t.size != 16 || t.align != 16 || t.eightbytes != abi.EB_EMPTY_HI)                                             { ret 16; }
    if (!t_one_gp(?t.arg, SYSV_RDI, 8, 8) || !t_one_gp(?t.ret, SYSV_RAX, 8, 8))                                       { ret 17; }
    if (t_rec_transport(alloc, ?c.sysv, REC_TF16, ?t) != 0)                                                           { ret 18; }
    if (t.size != 16 || t.eightbytes != abi.EB_SSE_HI || t.arg.class != abi.CLASS_GP || t.arg.piece_count != 2)       { ret 19; }
    if (!t_piece_is(?t.arg, 0, abi.PIECE_GP, SYSV_RDI, 8, 8) || !t_piece_is(?t.arg, 1, abi.PIECE_FP, t_xmm(0), 8, 8)) { ret 20; }
    if (!t_piece_is(?t.ret, 0, abi.PIECE_GP, SYSV_RAX, 8, 8) || !t_piece_is(?t.ret, 1, abi.PIECE_FP, t_xmm(0), 8, 8)) { ret 21; }
    if (t_rec_transport(alloc, ?c.sysv, REC_TF8, ?t) != 0)                                                            { ret 22; }
    if (t.size != 8 || t.eightbytes != 0 || !t_one_gp(?t.arg, SYSV_RDI, 8, 8) || !t_one_gp(?t.ret, SYSV_RAX, 8, 8))   { ret 23; }
    if (t_rec_transport(alloc, ?c.sysv, REC_TFM, ?t) != 0)                                                            { ret 24; }
    if (t.size != 16 || t.eightbytes != abi.EB_SSE_LO || t.arg.piece_count != 2)                                      { ret 25; }
    if (!t_piece_is(?t.arg, 0, abi.PIECE_FP, t_xmm(0), 8, 8) || !t_piece_is(?t.arg, 1, abi.PIECE_GP, SYSV_RDI, 8, 8)) { ret 26; }
    if (!t_piece_is(?t.ret, 0, abi.PIECE_FP, t_xmm(0), 8, 8) || !t_piece_is(?t.ret, 1, abi.PIECE_GP, SYSV_RAX, 8, 8)) { ret 27; }
    ret 0;
}

# the Win64 cells: only 1, 2, 4 and 8 byte records ride a register; everything else is the address of a caller copy
#[testing]
fun t_win64_cells(alloc: *A.Allocator, c: *TConvs) i32 {
    var t: RecTransport;
    if (t_rec_transport(alloc, ?c.win64, REC_P1, ?t) != 0)                     { ret 1; }
    if (!t_one_gp(?t.arg, WIN_RCX, 8, 1) || !t_one_gp(?t.ret, SYSV_RAX, 8, 1)) { ret 2; }
    if (t_rec_transport(alloc, ?c.win64, REC_T3, ?t) != 0)                     { ret 3; }
    if (!t_byref(?t.arg, WIN_RCX) || !t_sret(?t.ret, SYSV_RAX))                { ret 4; }
    if (t_rec_transport(alloc, ?c.win64, REC_S8, ?t) != 0)                     { ret 5; }
    if (!t_one_gp(?t.arg, WIN_RCX, 8, 8) || !t_one_gp(?t.ret, SYSV_RAX, 8, 8)) { ret 6; }
    var which: u32 = REC_T9;
    for (which < REC_SHAPE_COUNT) {
        if (which != REC_TF8) {
            if (t_rec_transport(alloc, ?c.win64, which, ?t) != 0)       { ret 7; }
            if (!t_byref(?t.arg, WIN_RCX) || !t_sret(?t.ret, SYSV_RAX)) { ret 8; }
        }
        which = which + 1;
    }
    if (t_rec_transport(alloc, ?c.win64, REC_TF8, ?t) != 0)                    { ret 9; }
    if (!t_one_gp(?t.arg, WIN_RCX, 8, 8) || !t_one_gp(?t.ret, SYSV_RAX, 8, 8)) { ret 10; }
    ret 0;
}

# the AAPCS64 cells: none of these records is an HFA (each has an integer leaf), so every one rides the
# general registers; up to 16 bytes ride x0/x1, larger goes by reference with x8 for returns
#[testing]
fun t_aapcs64_cells(alloc: *A.Allocator, c: *TConvs) i32 {
    var t: RecTransport;
    if (t_rec_transport(alloc, ?c.aapcs64, REC_P1, ?t) != 0)                               { ret 1; }
    if (!t_one_gp(?t.arg, 0, 8, 1) || !t_one_gp(?t.ret, 0, 8, 1))                          { ret 2; }
    if (t_rec_transport(alloc, ?c.aapcs64, REC_T3, ?t) != 0)                               { ret 3; }
    if (!t_one_gp(?t.arg, 0, 8, 3) || !t_one_gp(?t.ret, 0, 8, 3))                          { ret 4; }
    if (t_rec_transport(alloc, ?c.aapcs64, REC_S8, ?t) != 0)                               { ret 5; }
    if (!t_one_gp(?t.arg, 0, 8, 8) || !t_one_gp(?t.ret, 0, 8, 8))                          { ret 6; }
    if (t_rec_transport(alloc, ?c.aapcs64, REC_T9, ?t) != 0)                               { ret 7; }
    if (!t_gp_pair(?t.arg, 0, 1, 8, 1) || !t_gp_pair(?t.ret, 0, 1, 8, 1))                  { ret 8; }
    if (t_rec_transport(alloc, ?c.aapcs64, REC_T16, ?t) != 0)                              { ret 9; }
    if (!t_gp_pair(?t.arg, 0, 1, 8, 8) || !t_gp_pair(?t.ret, 0, 1, 8, 8))                  { ret 10; }
    if (t_rec_transport(alloc, ?c.aapcs64, REC_O24, ?t) != 0)                              { ret 11; }
    if (!t_byref(?t.arg, 0) || !t_sret(?t.ret, AAPCS_X8))                                  { ret 12; }
    if (t_rec_transport(alloc, ?c.aapcs64, REC_NEST, ?t) != 0)                             { ret 13; }
    if (!t_gp_pair(?t.arg, 0, 1, 8, 4) || !t_gp_pair(?t.ret, 0, 1, 8, 4))                  { ret 14; }
    if (t_rec_transport(alloc, ?c.aapcs64, REC_AL16, ?t) != 0)                             { ret 15; }
    if (t.align != 16 || !t_gp_pair(?t.arg, 0, 1, 8, 8) || !t_gp_pair(?t.ret, 0, 1, 8, 8)) { ret 16; }
    if (t_rec_transport(alloc, ?c.aapcs64, REC_TF16, ?t) != 0)                             { ret 17; }
    if (t.hfa != 0 || !t_gp_pair(?t.arg, 0, 1, 8, 8) || !t_gp_pair(?t.ret, 0, 1, 8, 8))    { ret 18; }
    if (t_rec_transport(alloc, ?c.aapcs64, REC_TF8, ?t) != 0)                              { ret 19; }
    if (t.hfa != 0 || !t_one_gp(?t.arg, 0, 8, 8) || !t_one_gp(?t.ret, 0, 8, 8))            { ret 20; }
    if (t_rec_transport(alloc, ?c.aapcs64, REC_TFM, ?t) != 0)                              { ret 21; }
    if (t.hfa != 0 || !t_gp_pair(?t.arg, 0, 1, 8, 8) || !t_gp_pair(?t.ret, 0, 1, 8, 8))    { ret 22; }
    ret 0;
}

# the RV64 cells: integer-only records ride a0/a1 or go by reference above two words; a record of exactly one
# float and one integer leaf splits into a float and an integer register under lp64d and rides a0/a1 under lp64
#[testing]
fun t_rv64_cells(alloc: *A.Allocator, tgt: *target.Target, hard_float: bool) i32 {
    var t: RecTransport;
    if (t_rec_transport(alloc, tgt, REC_P1, ?t) != 0)                                     { ret 1; }
    if (!t_one_gp(?t.arg, RV_A0, 8, 1) || !t_one_gp(?t.ret, RV_A0, 8, 1))                 { ret 2; }
    if (t_rec_transport(alloc, tgt, REC_T3, ?t) != 0)                                     { ret 3; }
    if (!t_one_gp(?t.arg, RV_A0, 8, 3) || !t_one_gp(?t.ret, RV_A0, 8, 3))                 { ret 4; }
    if (t_rec_transport(alloc, tgt, REC_S8, ?t) != 0)                                     { ret 5; }
    if (!t_one_gp(?t.arg, RV_A0, 8, 8) || !t_one_gp(?t.ret, RV_A0, 8, 8))                 { ret 6; }
    if (t_rec_transport(alloc, tgt, REC_T9, ?t) != 0)                                     { ret 7; }
    if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, 1) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, 1)) { ret 8; }
    if (t_rec_transport(alloc, tgt, REC_T16, ?t) != 0)                                    { ret 9; }
    if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, 8) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, 8)) { ret 10; }
    if (t_rec_transport(alloc, tgt, REC_O24, ?t) != 0)                                    { ret 11; }
    if (!t_byref(?t.arg, RV_A0) || !t_sret(?t.ret, RV_A0))                                { ret 12; }
    if (t_rec_transport(alloc, tgt, REC_NEST, ?t) != 0)                                   { ret 13; }
    if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, 4) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, 4)) { ret 14; }
    if (t_rec_transport(alloc, tgt, REC_AL16, ?t) != 0)                                   { ret 15; }
    if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, 8) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, 8)) { ret 16; }
    if (t_rec_transport(alloc, tgt, REC_TF16, ?t) != 0)                                   { ret 17; }
    if (hard_float) {
        if (!t_leaf_split(?t.arg, abi.PIECE_GP, RV_A0, 1, abi.PIECE_FP, t_fa(0), 8, 8)) { ret 18; }
        if (!t_leaf_split(?t.ret, abi.PIECE_GP, RV_A0, 1, abi.PIECE_FP, t_fa(0), 8, 8)) { ret 19; }
    }
    or {
        if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, 8) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, 8)) { ret 20; }
    }
    if (t_rec_transport(alloc, tgt, REC_TF8, ?t) != 0) { ret 21; }
    if (hard_float) {
        if (!t_leaf_split(?t.arg, abi.PIECE_GP, RV_A0, 1, abi.PIECE_FP, t_fa(0), 4, 4)) { ret 22; }
        if (!t_leaf_split(?t.ret, abi.PIECE_GP, RV_A0, 1, abi.PIECE_FP, t_fa(0), 4, 4)) { ret 23; }
    }
    or {
        if (!t_one_gp(?t.arg, RV_A0, 8, 8) || !t_one_gp(?t.ret, RV_A0, 8, 8)) { ret 24; }
    }
    if (t_rec_transport(alloc, tgt, REC_TFM, ?t) != 0) { ret 25; }
    if (hard_float) {
        if (!t_leaf_split(?t.arg, abi.PIECE_FP, t_fa(0), 8, abi.PIECE_GP, RV_A0, 8, 8)) { ret 26; }
        if (!t_leaf_split(?t.ret, abi.PIECE_FP, t_fa(0), 8, abi.PIECE_GP, RV_A0, 8, 8)) { ret 27; }
    }
    or {
        if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, 8) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, 8)) { ret 28; }
    }
    ret 0;
}

# the RV32 cells: the word is four bytes, so an 8-byte record already needs the a0/a1 pair and anything above
# eight bytes goes by reference; the one-float-one-integer split still applies under ilp32d
#[testing]
fun t_rv32_cells(alloc: *A.Allocator, tgt: *target.Target, hard_float: bool) i32 {
    var t: RecTransport;
    if (t_rec_transport(alloc, tgt, REC_P1, ?t) != 0)                                     { ret 1; }
    if (!t_one_gp(?t.arg, RV_A0, 4, 1) || !t_one_gp(?t.ret, RV_A0, 4, 1))                 { ret 2; }
    if (t_rec_transport(alloc, tgt, REC_T3, ?t) != 0)                                     { ret 3; }
    if (!t_one_gp(?t.arg, RV_A0, 4, 3) || !t_one_gp(?t.ret, RV_A0, 4, 3))                 { ret 4; }
    if (t_rec_transport(alloc, tgt, REC_S8, ?t) != 0)                                     { ret 5; }
    if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 4, 4) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 4, 4)) { ret 6; }
    if (t_rec_transport(alloc, tgt, REC_TF8, ?t) != 0)                                    { ret 7; }
    if (hard_float) {
        if (!t_leaf_split(?t.arg, abi.PIECE_GP, RV_A0, 1, abi.PIECE_FP, t_fa(0), 4, 4)) { ret 8; }
        if (!t_leaf_split(?t.ret, abi.PIECE_GP, RV_A0, 1, abi.PIECE_FP, t_fa(0), 4, 4)) { ret 9; }
    }
    or {
        if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 4, 4) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 4, 4)) { ret 10; }
    }
    var which: u32 = REC_T9;
    for (which < REC_SHAPE_COUNT) {
        if (which != REC_TF8) {
            if (t_rec_transport(alloc, tgt, which, ?t) != 0)       { ret 11; }
            if (!t_byref(?t.arg, RV_A0) || !t_sret(?t.ret, RV_A0)) { ret 12; }
        }
        which = which + 1;
    }
    ret 0;
}

# the packed cells (#3266): System V makes any record with an unaligned field MEMORY class (stack argument,
# hidden-pointer return) while a packed record whose fields sit aligned keeps its eightbyte classification;
# Win64 already takes every non-power-of-two size by reference and AAPCS64 and lp64d classify by size alone
#[testing]
fun t_packed_cells(alloc: *A.Allocator, c: *TConvs) i32 {
    var t: RecTransport;
    if (t_rec_transport(alloc, ?c.sysv, REC_PK5, ?t) != 0)                                            { ret 1; }
    if (t.size != 5 || t.align != 1 || t.eightbytes != abi.EB_UNALIGNED)                              { ret 2; }
    if (t.arg.class != abi.CLASS_STACK || t.arg.size != 5 || !t_sret(?t.ret, SYSV_RAX))               { ret 3; }
    if (t_rec_transport(alloc, ?c.sysv, REC_PK9, ?t) != 0)                                            { ret 4; }
    if (t.size != 9 || t.eightbytes != abi.EB_UNALIGNED)                                              { ret 5; }
    if (t.arg.class != abi.CLASS_STACK || t.arg.size != 9 || !t_sret(?t.ret, SYSV_RAX))               { ret 6; }
    if (t_rec_transport(alloc, ?c.sysv, REC_PKA, ?t) != 0)                                            { ret 7; }
    if (t.size != 12 || t.align != 1 || t.eightbytes != 0)                                            { ret 8; }
    if (!t_gp_pair(?t.arg, SYSV_RDI, SYSV_RSI, 8, 4) || !t_gp_pair(?t.ret, SYSV_RAX, SYSV_RDX, 8, 4)) { ret 9; }
    if (t_rec_transport(alloc, ?c.sysv, REC_PKARR, ?t) != 0)                                          { ret 10; }
    if (t.size != 10 || t.eightbytes != abi.EB_UNALIGNED)                                             { ret 11; }
    if (t.arg.class != abi.CLASS_STACK || t.arg.size != 10 || !t_sret(?t.ret, SYSV_RAX))              { ret 12; }

    var which: u32 = REC_PK5;
    for (which <= REC_PKARR) {
        if (t_rec_transport(alloc, ?c.win64, which, ?t) != 0)       { ret 13; }
        if (!t_byref(?t.arg, WIN_RCX) || !t_sret(?t.ret, SYSV_RAX)) { ret 14; }
        which = which + 1;
    }

    if (t_rec_transport(alloc, ?c.aapcs64, REC_PK5, ?t) != 0)             { ret 15; }
    if (!t_one_gp(?t.arg, 0, 8, 5) || !t_one_gp(?t.ret, 0, 8, 5))         { ret 16; }
    if (t_rec_transport(alloc, ?c.aapcs64, REC_PK9, ?t) != 0)             { ret 17; }
    if (!t_gp_pair(?t.arg, 0, 1, 8, 1) || !t_gp_pair(?t.ret, 0, 1, 8, 1)) { ret 18; }
    if (t_rec_transport(alloc, ?c.aapcs64, REC_PKA, ?t) != 0)             { ret 19; }
    if (!t_gp_pair(?t.arg, 0, 1, 8, 4) || !t_gp_pair(?t.ret, 0, 1, 8, 4)) { ret 20; }
    if (t_rec_transport(alloc, ?c.aapcs64, REC_PKARR, ?t) != 0)           { ret 21; }
    if (!t_gp_pair(?t.arg, 0, 1, 8, 2) || !t_gp_pair(?t.ret, 0, 1, 8, 2)) { ret 22; }

    if (t_rec_transport(alloc, ?c.lp64d, REC_PK5, ?t) != 0)                               { ret 23; }
    if (!t_one_gp(?t.arg, RV_A0, 8, 5) || !t_one_gp(?t.ret, RV_A0, 8, 5))                 { ret 24; }
    if (t_rec_transport(alloc, ?c.lp64d, REC_PK9, ?t) != 0)                               { ret 25; }
    if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, 1) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, 1)) { ret 26; }
    if (t_rec_transport(alloc, ?c.lp64d, REC_PKA, ?t) != 0)                               { ret 27; }
    if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, 4) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, 4)) { ret 28; }
    ret 0;
}

test record_transport__packed_unaligned_field_is_sysv_memory_class {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var c: TConvs;
    fin { treg.registry_dnit(?c.reg); }
    if (!t_convs_init(?c)) { ret 2; }
    val r: i32 = t_packed_cells(?alloc, ?c);
    if (r != 0) { ret 30 + r; }
    ret 0;
}

test record_transport__classifies_by_layout_on_every_convention {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var c: TConvs;
    fin { treg.registry_dnit(?c.reg); }
    if (!t_convs_init(?c)) { ret 2; }
    # exit codes: convention block of thirty plus the failing cell
    val sysv: i32 = t_sysv_cells(?alloc, ?c);
    if (sysv != 0) { ret 30 + sysv; }
    val win: i32 = t_win64_cells(?alloc, ?c);
    if (win != 0) { ret 60 + win; }
    val arm: i32 = t_aapcs64_cells(?alloc, ?c);
    if (arm != 0) { ret 90 + arm; }
    val rv64d: i32 = t_rv64_cells(?alloc, ?c.lp64d, true);
    if (rv64d != 0) { ret 120 + rv64d; }
    val rv64: i32 = t_rv64_cells(?alloc, ?c.lp64, false);
    if (rv64 != 0) { ret 150 + rv64; }
    val rv32d: i32 = t_rv32_cells(?alloc, ?c.rv32d, true);
    if (rv32d != 0) { ret 180 + rv32d; }
    val rv32: i32 = t_rv32_cells(?alloc, ?c.rv32, false);
    if (rv32 != 0) { ret 210 + rv32; }
    ret 0;
}

# tag shapes for the L5 transport inventory (#3218); each is a tag IR type built the way lower_tag builds it
#[testing]
val TAG_P1: u32 = 0;
#[testing]
val TAG_T3: u32 = 1;
#[testing]
val TAG_S8: u32 = 2;
#[testing]
val TAG_T9: u32 = 3;
#[testing]
val TAG_T16: u32 = 4;
#[testing]
val TAG_O24: u32 = 5;
#[testing]
val TAG_NEST: u32 = 6;
#[testing]
val TAG_PK9: u32 = 7;
#[testing]
val TAG_AL16: u32 = 8;
#[testing]
val TAG_TF16: u32 = 9;
#[testing]
val TAG_TF8: u32 = 10;
#[testing]
val TAG_TFM: u32 = 11;

# a packed tag whose 8-byte discriminator leaves the payload aligned anyway (mirrors REC_PKA); outside the
# sweep because its cells differ per convention
#[testing]
val TAG_PKA: u32 = 12;

# tags whose unit cases outnumber their bytes (#3400): sixteen zero-width cases ahead of a payload in the second
# eightbyte, integer or float, and the nesting that first showed it, an outer case holding a tag of thirteen
# unit cases and a four-byte payload; outside the sweep because the sweep's cells are keyed by size alone
#[testing]
val TAG_U16: u32 = 13;
#[testing]
val TAG_U16F: u32 = 14;
#[testing]
val TAG_U13: u32 = 15;
#[testing]
val TAG_U13N: u32 = 16;

#[testing]
fun t_tag_shape(types: *type.IrTypeTable, which: u32) res[type.IrTypeId, fail.Fail] {
    val vr:   res[type.IrTypeId, fail.Fail] = type.intern_void(types);
    val u8r:  res[type.IrTypeId, fail.Fail] = type.intern_int(types, 8);
    val u32r: res[type.IrTypeId, fail.Fail] = type.intern_int(types, 32);
    val i64r: res[type.IrTypeId, fail.Fail] = type.intern_int(types, 64);
    val f32r: res[type.IrTypeId, fail.Fail] = type.intern_float(types, 32);
    val f64r: res[type.IrTypeId, fail.Fail] = type.intern_float(types, 64);
    if (sel vr.err)   { ret res[type.IrTypeId, fail.Fail].err{fail.message("leaf")}; }
    if (sel u8r.err)  { ret res[type.IrTypeId, fail.Fail].err{fail.message("leaf")}; }
    if (sel u32r.err) { ret res[type.IrTypeId, fail.Fail].err{fail.message("leaf")}; }
    if (sel i64r.err) { ret res[type.IrTypeId, fail.Fail].err{fail.message("leaf")}; }
    if (sel f32r.err) { ret res[type.IrTypeId, fail.Fail].err{fail.message("leaf")}; }
    if (sel f64r.err) { ret res[type.IrTypeId, fail.Fail].err{fail.message("leaf")}; }
    val void_t: type.IrTypeId = vr.ok;
    val u8t:    type.IrTypeId = u8r.ok;
    val u32t:   type.IrTypeId = u32r.ok;
    val i64t:   type.IrTypeId = i64r.ok;
    val f32t:   type.IrTypeId = f32r.ok;
    val f64t:   type.IrTypeId = f64r.ok;
    var cases:  [17]type.IrTypeId;
    cases[0] = void_t;
    var count:  u32  = 2;
    var disc:   u32  = 1;
    var align:  u32  = 0;
    var packed: bool = false;
    if (which == TAG_P1) { cases[1] = void_t; }
    or (which == TAG_T3) {
        val a: res[type.IrTypeId, fail.Fail] = type.intern_array(types, u8t, 2);
        if (sel a.err) { ret a; }
        cases[1] = a.ok;
    }
    or (which == TAG_S8) { cases[1] = u32t; }
    or (which == TAG_T9) {
        val a: res[type.IrTypeId, fail.Fail] = type.intern_array(types, u8t, 8);
        if (sel a.err) { ret a; }
        cases[1] = a.ok;
    }
    or (which == TAG_T16) { cases[1] = i64t; }
    or (which == TAG_O24) {
        val a: res[type.IrTypeId, fail.Fail] = type.intern_array(types, i64t, 2);
        if (sel a.err) { ret a; }
        cases[1] = a.ok;
        cases[2] = u8t;
        count    = 3;
    }
    or (which == TAG_NEST) {
        val inner: res[type.IrTypeId, fail.Fail] = t_tag_shape(types, TAG_S8);
        if (sel inner.err) { ret inner; }
        cases[1] = inner.ok;
    }
    or (which == TAG_PK9) {
        cases[1] = i64t;
        packed   = true;
    }
    or (which == TAG_AL16) {
        cases[1] = u8t;
        align    = 16;
    }
    or (which == TAG_TF16) { cases[1] = f64t; }
    or (which == TAG_TF8)  { cases[1] = f32t; }
    or (which == TAG_TFM) {
        cases[1] = f64t;
        cases[2] = i64t;
        count    = 3;
    }
    or (which == TAG_PKA) {
        cases[1] = i64t;
        disc     = 8;
        packed   = true;
    }
    or (which == TAG_U16 || which == TAG_U16F || which == TAG_U13) {
        count = 17;
        if (which == TAG_U13) { count = 14; }
        var k: u32 = 1;
        for (k < count - 1) {
            cases[k] = void_t;
            k        = k + 1;
        }
        cases[count - 1] = i64t;
        if (which == TAG_U16F) { cases[count - 1] = f64t; }
        or (which == TAG_U13)  { cases[count - 1] = u32t; }
    }
    or (which == TAG_U13N) {
        val inner: res[type.IrTypeId, fail.Fail] = t_tag_shape(types, TAG_U13);
        if (sel inner.err) { ret inner; }
        cases[1] = inner.ok;
    }
    or { ret res[type.IrTypeId, fail.Fail].err{fail.message("shape")}; }
    ret type.intern_tag(types, ?cases[0], count, disc, align, packed);
}

#[testing]
rec TagTransport {
    size:       u64;
    align:      u32;
    hfa:        u8;
    eightbytes: u8;
    arg:        abi.ParamSlot;
    ret:        abi.ParamSlot;
}

# classifies `fun(T) T` for one convention through the real type derivation and the real vtable
#[testing]
fun t_tag_transport(alloc: *A.Allocator, tgt: *target.Target, which: u32, out: *TagTransport) i32 {
    val mr: res[ir.Module, fail.Fail] = ir.init(alloc, intern.STR_NIL);
    if (sel mr.err) { ret 1; }
    var m: ir.Module = mr.ok;
    fin { ir.dnit(?m); }
    val sr: res[type.IrTypeId, fail.Fail] = t_tag_shape(?m.types, which);
    if (sel sr.err) { ret 4; }
    var tag: type.IrTypeId                 = sr.ok;
    val vr:  res[type.IrTypeId, fail.Fail] = type.intern_void(?m.types);
    if (sel vr.err) { ret 5; }
    val void_t: type.IrTypeId = vr.ok;
    # the argument is classified on `fun(T)` and the return on `fun() T`, so a hidden result pointer never shifts the argument
    val ar: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, void_t, ?tag, 1, false);
    val rr: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, tag, nil, 0, false);
    if (sel ar.err) { ret 5; }
    if (sel rr.err) { ret 5; }
    var ctx: context.LowerCtx;
    ctx.alloc  = alloc;
    ctx.tgt    = tgt;
    ctx.layout = target.layout_machine(tgt);
    ctx.m      = ?m;
    ctx.types  = ?m.types;
    var layout:               abi.SigLayout;
    val classify_signature_r: err[fail.Fail] = classify_signature(?ctx, ar.ok, void_t, ?layout);
    if (sel classify_signature_r.err) { ret 6; }
    if (layout.param_count != 1) {
        sig_layout_free(?ctx, ?layout);
        ret 7;
    }
    out.arg = layout.params[0];
    sig_layout_free(?ctx, ?layout);
    var rlayout:               abi.SigLayout;
    val classify_signature_r2: err[fail.Fail] = classify_signature(?ctx, rr.ok, tag, ?rlayout);
    if (sel classify_signature_r2.err) { ret 8; }
    out.ret = rlayout.ret_slot;
    sig_layout_free(?ctx, ?rlayout);
    out.size  = type.byte_size_for_machine(?m.types, tag, ctx.layout)::u64;
    out.align = type.byte_align_for_machine(?m.types, tag, ctx.layout);
    var he: u8 = 0;
    hfa_info(?ctx, tag, ?out.hfa, ?he);
    out.eightbytes = aggregate_eightbyte_mask(?ctx, tag);
    ret 0;
}

# the SysV cells: every tag classifies as the record of its layout, so the discriminator eightbyte is INTEGER
# and a float payload eightbyte is SSE; a trailing eightbyte that holds only padding consumes no register
#[testing]
fun t_tag_sysv_cells(alloc: *A.Allocator, c: *TConvs) i32 {
    var t: TagTransport;
    if (t_tag_transport(alloc, ?c.sysv, TAG_P1, ?t) != 0)                                                                                                  { ret 1; }
    if (t.size != 1 || !t_one_gp(?t.arg, SYSV_RDI, 8, 1) || !t_one_gp(?t.ret, SYSV_RAX, 8, 1))                                                             { ret 2; }
    if (t_tag_transport(alloc, ?c.sysv, TAG_T3, ?t) != 0)                                                                                                  { ret 3; }
    if (t.size != 3 || !t_one_gp(?t.arg, SYSV_RDI, 8, 3) || !t_one_gp(?t.ret, SYSV_RAX, 8, 3))                                                             { ret 4; }
    if (t_tag_transport(alloc, ?c.sysv, TAG_S8, ?t) != 0)                                                                                                  { ret 5; }
    if (t.size != 8 || !t_one_gp(?t.arg, SYSV_RDI, 8, 8) || !t_one_gp(?t.ret, SYSV_RAX, 8, 8))                                                             { ret 6; }
    if (t_tag_transport(alloc, ?c.sysv, TAG_T9, ?t) != 0)                                                                                                  { ret 7; }
    if (t.size != 9 || !t_gp_pair(?t.arg, SYSV_RDI, SYSV_RSI, 8, 1) || !t_gp_pair(?t.ret, SYSV_RAX, SYSV_RDX, 8, 1))                                       { ret 8; }
    if (t_tag_transport(alloc, ?c.sysv, TAG_T16, ?t) != 0)                                                                                                 { ret 9; }
    if (t.size != 16 || !t_gp_pair(?t.arg, SYSV_RDI, SYSV_RSI, 8, 8) || !t_gp_pair(?t.ret, SYSV_RAX, SYSV_RDX, 8, 8))                                      { ret 10; }
    if (t_tag_transport(alloc, ?c.sysv, TAG_O24, ?t) != 0)                                                                                                 { ret 11; }
    if (t.size != 24 || t.arg.class != abi.CLASS_STACK || t.arg.size != 24 || !t_sret(?t.ret, SYSV_RAX))                                                   { ret 12; }
    if (t_tag_transport(alloc, ?c.sysv, TAG_NEST, ?t) != 0)                                                                                                { ret 13; }
    if (t.size != 12 || !t_gp_pair(?t.arg, SYSV_RDI, SYSV_RSI, 8, 4) || !t_gp_pair(?t.ret, SYSV_RAX, SYSV_RDX, 8, 4))                                      { ret 14; }
    if (t_tag_transport(alloc, ?c.sysv, TAG_PK9, ?t) != 0)                                                                                                 { ret 15; }
    if (t.size != 9 || t.align != 1 || t.eightbytes != abi.EB_UNALIGNED || t.arg.class != abi.CLASS_STACK || t.arg.size != 9 || !t_sret(?t.ret, SYSV_RAX)) { ret 16; }
    if (t_tag_transport(alloc, ?c.sysv, TAG_AL16, ?t) != 0)                                                                                                { ret 17; }
    if (t.size != 16 || t.align != 16 || t.eightbytes != abi.EB_EMPTY_HI)                                                                                  { ret 18; }
    if (!t_one_gp(?t.arg, SYSV_RDI, 8, 8) || !t_one_gp(?t.ret, SYSV_RAX, 8, 8))                                                                            { ret 19; }
    if (t_tag_transport(alloc, ?c.sysv, TAG_TF16, ?t) != 0)                                                                                                { ret 20; }
    if (t.size != 16 || t.eightbytes != abi.EB_SSE_HI || t.arg.class != abi.CLASS_GP || t.arg.piece_count != 2)                                            { ret 21; }
    if (!t_piece_is(?t.arg, 0, abi.PIECE_GP, SYSV_RDI, 8, 8) || !t_piece_is(?t.arg, 1, abi.PIECE_FP, t_xmm(0), 8, 8))                                      { ret 22; }
    if (!t_piece_is(?t.ret, 0, abi.PIECE_GP, SYSV_RAX, 8, 8) || !t_piece_is(?t.ret, 1, abi.PIECE_FP, t_xmm(0), 8, 8))                                      { ret 23; }
    if (t_tag_transport(alloc, ?c.sysv, TAG_TF8, ?t) != 0)                                                                                                 { ret 24; }
    if (t.size != 8 || t.eightbytes != 0 || !t_one_gp(?t.arg, SYSV_RDI, 8, 8) || !t_one_gp(?t.ret, SYSV_RAX, 8, 8))                                        { ret 25; }
    if (t_tag_transport(alloc, ?c.sysv, TAG_TFM, ?t) != 0)                                                                                                 { ret 26; }
    if (t.size != 16 || t.eightbytes != 0 || !t_gp_pair(?t.arg, SYSV_RDI, SYSV_RSI, 8, 8) || !t_gp_pair(?t.ret, SYSV_RAX, SYSV_RDX, 8, 8))                 { ret 27; }
    ret 0;
}

# the AAPCS64 cells: a tag is never an HFA because its discriminator is an integer leaf, so a float payload
# still rides the general registers; up to 16 bytes ride x0/x1, larger goes by reference with x8 for returns
#[testing]
fun t_tag_aapcs64_cells(alloc: *A.Allocator, c: *TConvs) i32 {
    var t: TagTransport;
    if (t_tag_transport(alloc, ?c.aapcs64, TAG_P1, ?t) != 0)                               { ret 1; }
    if (!t_one_gp(?t.arg, 0, 8, 1) || !t_one_gp(?t.ret, 0, 8, 1))                          { ret 2; }
    if (t_tag_transport(alloc, ?c.aapcs64, TAG_T3, ?t) != 0)                               { ret 3; }
    if (!t_one_gp(?t.arg, 0, 8, 3) || !t_one_gp(?t.ret, 0, 8, 3))                          { ret 4; }
    if (t_tag_transport(alloc, ?c.aapcs64, TAG_S8, ?t) != 0)                               { ret 5; }
    if (!t_one_gp(?t.arg, 0, 8, 8) || !t_one_gp(?t.ret, 0, 8, 8))                          { ret 6; }
    if (t_tag_transport(alloc, ?c.aapcs64, TAG_T9, ?t) != 0)                               { ret 7; }
    if (!t_gp_pair(?t.arg, 0, 1, 8, 1) || !t_gp_pair(?t.ret, 0, 1, 8, 1))                  { ret 8; }
    if (t_tag_transport(alloc, ?c.aapcs64, TAG_T16, ?t) != 0)                              { ret 9; }
    if (!t_gp_pair(?t.arg, 0, 1, 8, 8) || !t_gp_pair(?t.ret, 0, 1, 8, 8))                  { ret 10; }
    if (t_tag_transport(alloc, ?c.aapcs64, TAG_O24, ?t) != 0)                              { ret 11; }
    if (!t_byref(?t.arg, 0) || !t_sret(?t.ret, AAPCS_X8))                                  { ret 12; }
    if (t_tag_transport(alloc, ?c.aapcs64, TAG_NEST, ?t) != 0)                             { ret 13; }
    if (!t_gp_pair(?t.arg, 0, 1, 8, 4) || !t_gp_pair(?t.ret, 0, 1, 8, 4))                  { ret 14; }
    if (t_tag_transport(alloc, ?c.aapcs64, TAG_PK9, ?t) != 0)                              { ret 15; }
    if (!t_gp_pair(?t.arg, 0, 1, 8, 1) || !t_gp_pair(?t.ret, 0, 1, 8, 1))                  { ret 16; }
    if (t_tag_transport(alloc, ?c.aapcs64, TAG_AL16, ?t) != 0)                             { ret 17; }
    if (t.align != 16 || !t_gp_pair(?t.arg, 0, 1, 8, 8) || !t_gp_pair(?t.ret, 0, 1, 8, 8)) { ret 18; }
    if (t_tag_transport(alloc, ?c.aapcs64, TAG_TF16, ?t) != 0)                             { ret 19; }
    if (t.hfa != 0 || !t_gp_pair(?t.arg, 0, 1, 8, 8) || !t_gp_pair(?t.ret, 0, 1, 8, 8))    { ret 20; }
    if (t_tag_transport(alloc, ?c.aapcs64, TAG_TF8, ?t) != 0)                              { ret 21; }
    if (t.hfa != 0 || !t_one_gp(?t.arg, 0, 8, 8) || !t_one_gp(?t.ret, 0, 8, 8))            { ret 22; }
    if (t_tag_transport(alloc, ?c.aapcs64, TAG_TFM, ?t) != 0)                              { ret 23; }
    if (t.hfa != 0 || !t_gp_pair(?t.arg, 0, 1, 8, 8) || !t_gp_pair(?t.ret, 0, 1, 8, 8))    { ret 24; }
    ret 0;
}

# the RV64 cells (lp64d and soft-float lp64 agree): a tag's payload area is a union, which the psABI never
# flattens into the float registers, so every tag rides a0/a1 or goes by reference above two words
#[testing]
fun t_tag_rv64_cells(alloc: *A.Allocator, tgt: *target.Target) i32 {
    var t: TagTransport;
    if (t_tag_transport(alloc, tgt, TAG_P1, ?t) != 0)                                     { ret 1; }
    if (!t_one_gp(?t.arg, RV_A0, 8, 1) || !t_one_gp(?t.ret, RV_A0, 8, 1))                 { ret 2; }
    if (t_tag_transport(alloc, tgt, TAG_T3, ?t) != 0)                                     { ret 3; }
    if (!t_one_gp(?t.arg, RV_A0, 8, 3) || !t_one_gp(?t.ret, RV_A0, 8, 3))                 { ret 4; }
    if (t_tag_transport(alloc, tgt, TAG_S8, ?t) != 0)                                     { ret 5; }
    if (!t_one_gp(?t.arg, RV_A0, 8, 8) || !t_one_gp(?t.ret, RV_A0, 8, 8))                 { ret 6; }
    if (t_tag_transport(alloc, tgt, TAG_T9, ?t) != 0)                                     { ret 7; }
    if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, 1) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, 1)) { ret 8; }
    if (t_tag_transport(alloc, tgt, TAG_T16, ?t) != 0)                                    { ret 9; }
    if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, 8) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, 8)) { ret 10; }
    if (t_tag_transport(alloc, tgt, TAG_O24, ?t) != 0)                                    { ret 11; }
    if (!t_byref(?t.arg, RV_A0) || !t_sret(?t.ret, RV_A0))                                { ret 12; }
    if (t_tag_transport(alloc, tgt, TAG_NEST, ?t) != 0)                                   { ret 13; }
    if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, 4) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, 4)) { ret 14; }
    if (t_tag_transport(alloc, tgt, TAG_PK9, ?t) != 0)                                    { ret 15; }
    if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, 1) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, 1)) { ret 16; }
    if (t_tag_transport(alloc, tgt, TAG_AL16, ?t) != 0)                                   { ret 17; }
    if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, 8) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, 8)) { ret 18; }
    if (t_tag_transport(alloc, tgt, TAG_TF16, ?t) != 0)                                   { ret 19; }
    if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, 8) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, 8)) { ret 20; }
    if (t_tag_transport(alloc, tgt, TAG_TF8, ?t) != 0)                                    { ret 21; }
    if (!t_one_gp(?t.arg, RV_A0, 8, 8) || !t_one_gp(?t.ret, RV_A0, 8, 8))                 { ret 22; }
    if (t_tag_transport(alloc, tgt, TAG_TFM, ?t) != 0)                                    { ret 23; }
    if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, 8) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, 8)) { ret 24; }
    ret 0;
}

# the packed tag cells: a tag is the record of its layout, so a packed tag whose payload sits at an offset its
# alignment does not divide is System V MEMORY class exactly as the packed record is, while a packed tag whose
# payload happens to sit aligned keeps its eightbyte classification; AAPCS64 and lp64d classify by size alone
#[testing]
fun t_tag_packed_cells(alloc: *A.Allocator, c: *TConvs) i32 {
    var t: TagTransport;
    if (t_tag_transport(alloc, ?c.sysv, TAG_PK9, ?t) != 0)                                            { ret 1; }
    if (t.size != 9 || t.align != 1 || t.eightbytes != abi.EB_UNALIGNED)                              { ret 2; }
    if (t.arg.class != abi.CLASS_STACK || t.arg.size != 9 || !t_sret(?t.ret, SYSV_RAX))               { ret 3; }
    if (t_tag_transport(alloc, ?c.sysv, TAG_PKA, ?t) != 0)                                            { ret 4; }
    if (t.size != 16 || t.align != 1 || t.eightbytes != 0)                                            { ret 5; }
    if (!t_gp_pair(?t.arg, SYSV_RDI, SYSV_RSI, 8, 8) || !t_gp_pair(?t.ret, SYSV_RAX, SYSV_RDX, 8, 8)) { ret 6; }

    if (t_tag_transport(alloc, ?c.aapcs64, TAG_PK9, ?t) != 0)             { ret 11; }
    if (!t_gp_pair(?t.arg, 0, 1, 8, 1) || !t_gp_pair(?t.ret, 0, 1, 8, 1)) { ret 12; }
    if (t_tag_transport(alloc, ?c.aapcs64, TAG_PKA, ?t) != 0)             { ret 13; }
    if (!t_gp_pair(?t.arg, 0, 1, 8, 8) || !t_gp_pair(?t.ret, 0, 1, 8, 8)) { ret 14; }

    if (t_tag_transport(alloc, ?c.lp64d, TAG_PK9, ?t) != 0)                               { ret 15; }
    if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, 1) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, 1)) { ret 16; }
    if (t_tag_transport(alloc, ?c.lp64d, TAG_PKA, ?t) != 0)                               { ret 17; }
    if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, 8) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, 8)) { ret 18; }
    ret 0;
}

# the unit-case cells: a tag's classification follows its bytes, never its member count, so sixteen unit cases
# change nothing about where the payload rides. System V keeps the payload eightbyte, INTEGER or SSE, on both
# of its hosts, and every other convention reads the same shapes by size
#[testing]
fun t_tag_unit_cells(alloc: *A.Allocator, c: *TConvs) i32 {
    var t:  TagTransport;
    var os: u32 = 0;
    for (os < 2) {
        var host: *target.Target = ?c.sysv;
        if (os == 1) { host = ?c.sysv_darwin; }
        val b: i32 = os::i32 * 10;
        if (t_tag_transport(alloc, host, TAG_U16, ?t) != 0)                                                                                    { ret b + 1; }
        if (t.size != 16 || t.eightbytes != 0 || !t_gp_pair(?t.arg, SYSV_RDI, SYSV_RSI, 8, 8) || !t_gp_pair(?t.ret, SYSV_RAX, SYSV_RDX, 8, 8)) { ret b + 2; }
        if (t_tag_transport(alloc, host, TAG_U16F, ?t) != 0)                                                                                   { ret b + 3; }
        if (t.size != 16 || t.eightbytes != abi.EB_SSE_HI || t.arg.piece_count != 2 || t.ret.piece_count != 2)                                 { ret b + 4; }
        if (!t_piece_is(?t.arg, 0, abi.PIECE_GP, SYSV_RDI, 8, 8) || !t_piece_is(?t.arg, 1, abi.PIECE_FP, t_xmm(0), 8, 8))                      { ret b + 5; }
        if (!t_piece_is(?t.ret, 0, abi.PIECE_GP, SYSV_RAX, 8, 8) || !t_piece_is(?t.ret, 1, abi.PIECE_FP, t_xmm(0), 8, 8))                      { ret b + 6; }
        if (t_tag_transport(alloc, host, TAG_U13N, ?t) != 0)                                                                                   { ret b + 7; }
        if (t.size != 12 || t.eightbytes != 0 || !t_gp_pair(?t.arg, SYSV_RDI, SYSV_RSI, 8, 4) || !t_gp_pair(?t.ret, SYSV_RAX, SYSV_RDX, 8, 4)) { ret b + 8; }
        os = os + 1;
    }

    var which: u32 = TAG_U16;
    for (which <= TAG_U13N) {
        if (which != TAG_U13) {
            var logical: u8 = 8;
            if (which == TAG_U13N)                                                                            { logical = 4; }
            if (t_tag_transport(alloc, ?c.aapcs64, which, ?t) != 0)                                           { ret 23; }
            if (t.hfa != 0 || !t_gp_pair(?t.arg, 0, 1, 8, logical) || !t_gp_pair(?t.ret, 0, 1, 8, logical))   { ret 24; }
            if (t_tag_transport(alloc, ?c.lp64d, which, ?t) != 0)                                             { ret 25; }
            if (!t_gp_pair(?t.arg, RV_A0, RV_A1, 8, logical) || !t_gp_pair(?t.ret, RV_A0, RV_A1, 8, logical)) { ret 26; }
        }
        which = which + 1;
    }
    ret 0;
}

test tag_transport__unit_cases_never_drop_a_payload_eightbyte {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var c: TConvs;
    fin { treg.registry_dnit(?c.reg); }
    if (!t_convs_init(?c)) { ret 2; }
    val r: i32 = t_tag_unit_cells(?alloc, ?c);
    if (r != 0) { ret 30 + r; }
    ret 0;
}

test tag_transport__packed_unaligned_payload_is_sysv_memory_class {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var c: TConvs;
    fin { treg.registry_dnit(?c.reg); }
    if (!t_convs_init(?c)) { ret 2; }
    val r: i32 = t_tag_packed_cells(?alloc, ?c);
    if (r != 0) { ret 30 + r; }
    ret 0;
}

test tag_transport__classifies_as_the_record_of_its_layout {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var c: TConvs;
    fin { treg.registry_dnit(?c.reg); }
    if (!t_convs_init(?c)) { ret 2; }
    # win64 and rv32 take a tag by size alone, as the record sweep covers; these read its leaves
    val sysv: i32 = t_tag_sysv_cells(?alloc, ?c);
    if (sysv != 0) { ret 30 + sysv; }
    val arm: i32 = t_tag_aapcs64_cells(?alloc, ?c);
    if (arm != 0) { ret 90 + arm; }
    val rv64d: i32 = t_tag_rv64_cells(?alloc, ?c.lp64d);
    if (rv64d != 0) { ret 120 + rv64d; }
    ret 0;
}
