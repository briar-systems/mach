use mach.lang.fail;
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;

use std.allocator.page;
use std.collections.map;

use A: std.allocator;

use codegen_mir: mach.lang.be.codegen.mir;
use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.float;
use mach.lang.intern;
use mach.lang.layout;
use me_ir:          mach.lang.me.ir;
use ir_id:          mach.lang.me.ir.id;
use ir_instruction: mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use mach.lang.me.ir.refs;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use lang_source: mach.lang.source;
use mach.lang.target.abi;
use mach.lang.target.isa;
use mach.lang.target.resolved;
use target_testing: mach.lang.target.testing;
use mach.lang.wide;

pub rec LowerCtx {
    alloc:       *A.Allocator;
    tgt:         *resolved.Target;
    layout:      layout.Machine;
    m:           *me_ir.Module;
    types:       *ir_type.IrTypeTable;
    fn:          *me_ir.Function;
    f:           *codegen_mir.MirFunction;
    param_vregs: *codegen_mir.VRegId;
    param_count: u32;
    instr_vregs: *codegen_mir.VRegId;

    slot_key_vregs: *codegen_mir.VRegId;

    # an element address whose every use is the pointer of a scalar load or
    # store is folded into those accesses as their memory operand and never
    # materialized in a register
    gep_fold: *bool;
    gep_mem:  *codegen_mir.MirOperand;

    # a count mask `c & (8 * W - 1)` whose every use is the count of a shift
    # the machine runs at W and reads modulo W is never materialized: each
    # shift takes `c` as its count (#3893)
    count_mask_fold: *bool;

    # an integer compare whose every use is the condition of a select in its
    # own block is never materialized: each select compares for itself (#3346)
    select_cmp_fold: *bool;

    instr_count: u32;
    interner:    *intern.Interner;
    # the module's diagnostic store, where a refusal of the program lands
    diags: *diagnostic.DiagnosticStore;

    sret_vreg: codegen_mir.VRegId;
    # the alloca whose storage is the result storage the caller passed: the
    # memory image of the returned value, written in place (#4120)
    result_image:    ir_id.InstructionId;
    result_in_place: bool;

    # the call lowered as a jump to its callee while `in_tail`, whose return
    # lowers to the bare return the jump replaces (#3417)
    in_tail:   bool;
    tail_call: ir_id.InstructionId;

    cur_loc: lang_source.SrcLoc;

    cur_inline_site: u32;

    cur_vec_lane: u32;

    cur_writes_secret: bool;
    cur_memory_flags:  u8;

    pending:       *codegen_mir.MirDbgBinding;
    pending_count: u32;
    pending_cap:   u32;
    max_block_id:  u32;
}

# lowering rejects the program at the instruction under translation, or at
# the function when no instruction is
pub fun reject(ctx: *LowerCtx, k: diagnostic_kind.Kind, text: str) fail.Fail {
    var loc: lang_source.SrcLoc = ctx.cur_loc;
    if (!lang_source.loc_is_valid(loc) && ctx.fn != nil) { loc = ctx.fn.decl_loc; }
    ret codegen_mir.reject(ctx.diags, k, loc, text);
}

pub fun ctx_setup(ctx: *LowerCtx, tgt: *resolved.Target, fn: *me_ir.Function) err[fail.Fail] {
    ctx.layout = resolved.layout_machine(tgt);
    if (ctx.param_count > 0) {
        val res_params: res[*codegen_mir.VRegId, A.Error] = A.allocate[codegen_mir.VRegId](ctx.alloc, ctx.param_count::usize);
        if (sel res_params.err) { ret err[fail.Fail].err{fail.refused(res_params.err)}; }
        ctx.param_vregs = res_params.ok;
    }

    if (ctx.instr_count > 0) {
        val res_instrs: res[*codegen_mir.VRegId, A.Error] = A.allocate[codegen_mir.VRegId](ctx.alloc, ctx.instr_count::usize);
        if (sel res_instrs.err) { ret err[fail.Fail].err{fail.refused(res_instrs.err)}; }
        ctx.instr_vregs = res_instrs.ok;

        val res_keys: res[*codegen_mir.VRegId, A.Error] = A.allocate[codegen_mir.VRegId](ctx.alloc, ctx.instr_count::usize);
        if (sel res_keys.err) { ret err[fail.Fail].err{fail.refused(res_keys.err)}; }
        ctx.slot_key_vregs = res_keys.ok;

        val res_fold: res[*bool, A.Error] = A.allocate[bool](ctx.alloc, ctx.instr_count::usize);
        if (sel res_fold.err) { ret err[fail.Fail].err{fail.refused(res_fold.err)}; }
        ctx.gep_fold = res_fold.ok;
        val res_mem: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, ctx.instr_count::usize);
        if (sel res_mem.err) { ret err[fail.Fail].err{fail.refused(res_mem.err)}; }
        ctx.gep_mem = res_mem.ok;
        val res_mask: res[*bool, A.Error] = A.allocate[bool](ctx.alloc, ctx.instr_count::usize);
        if (sel res_mask.err) { ret err[fail.Fail].err{fail.refused(res_mask.err)}; }
        ctx.count_mask_fold = res_mask.ok;
        val res_cmp: res[*bool, A.Error] = A.allocate[bool](ctx.alloc, ctx.instr_count::usize);
        if (sel res_cmp.err) { ret err[fail.Fail].err{fail.refused(res_cmp.err)}; }
        ctx.select_cmp_fold = res_cmp.ok;

        var i: u32 = 0;
        for (i < ctx.instr_count) {
            ctx.slot_key_vregs[i] = codegen_mir.MIR_VREG_NIL;
            ctx.gep_fold[i]       = false;
            i                     = i + 1;
        }
        mark_foldable_geps(ctx, tgt, fn);
        mark_foldable_count_masks(ctx, fn);
        mark_foldable_select_cmps(ctx, fn);
    }

    var i: u32 = 0;
    for (i < ctx.param_count) {
        val reg_class: u32                                = reg_class_of(ctx, tgt, fn.params[i].ty);
        val res_vreg:  res[codegen_mir.VRegId, fail.Fail] = new_vreg_vec(ctx, reg_class, vec_bytes_of(ctx, fn.params[i].ty));
        if (sel res_vreg.err) { ret err[fail.Fail].err{res_vreg.err}; }
        val pv: codegen_mir.VRegId = res_vreg.ok;
        ctx.param_vregs[i]   = pv;
        ctx.f.vregs[pv.n].ty = fn.params[i].ty::u32;
        if (fn.params[i].secret && param_holds_value(ctx, i)) { ctx.f.vregs[pv.n].secret = true; }
        i = i + 1;
    }

    i = 0;
    for (i < ctx.instr_count) {
        ctx.instr_vregs[i] = codegen_mir.MIR_VREG_NIL;
        val inst: *ir_instruction.Instruction = ?fn.instrs[i];
        if (defines_value(ctx, inst)) {
            val reg_class: u32                                = reg_class_of(ctx, tgt, inst.ty);
            val res_vreg:  res[codegen_mir.VRegId, fail.Fail] = new_vreg_vec(ctx, reg_class, vec_bytes_of(ctx, inst.ty));
            if (sel res_vreg.err) { ret err[fail.Fail].err{res_vreg.err}; }
            val rv: codegen_mir.VRegId = res_vreg.ok;
            ctx.instr_vregs[i]   = rv;
            ctx.f.vregs[rv.n].ty = inst.ty::u32;
            if (inst.secret && (inst.kind == ir_instruction.OP_LOAD || inst.kind == ir_instruction.OP_CALL)
                && instr_holds_value(ctx, inst)) {
                ctx.f.vregs[rv.n].secret = true;
            }
        }
        i = i + 1;
    }

    ret err[fail.Fail].ok{};
}

# a gep folds when the target addresses memory flatly, the function is not
# constant-time validated, and every use of the address is the pointer of a
# scalar, non-volatile load or store; any other use needs the address in a
# register, and then the accesses take it from there too
fun mark_foldable_geps(ctx: *LowerCtx, tgt: *resolved.Target, fn: *me_ir.Function) {
    if (!tgt.model.flat_addressing || !tgt.model.indexed_memory)         { ret; }
    if ((fn.flags & me_ir.FN_FLAG_OBLIVIOUS) != 0)                       { ret; }
    if (map.length[ir_id.InstructionId, me_ir.IrAsm](fn.asm_blocks) > 0) { ret; }

    var i: u32 = 0;
    for (i < ctx.instr_count) {
        if (fn.instrs[i].kind == ir_instruction.OP_GEP && fn.instrs[i].operand_count > 1) { ctx.gep_fold[i] = true; }
        i = i + 1;
    }
    i = 0;
    for (i < ctx.instr_count) {
        val inst: *ir_instruction.Instruction = ?fn.instrs[i];
        var o:    u32                         = 0;
        for (o < inst.operand_count) {
            val v: value.Value = inst.operands[o];
            if (v.kind == value.VAL_INSTR && v.data.instr::u32 < ctx.instr_count) {
                val g: u32 = v.data.instr::u32;
                if (ctx.gep_fold[g] && !gep_use_folds(ctx, inst, o)) { ctx.gep_fold[g] = false; }
            }
            o = o + 1;
        }
        i = i + 1;
    }
}

pub fun count_mask_folds(ctx: *LowerCtx, iid: ir_id.InstructionId) bool {
    if (ctx.count_mask_fold == nil || iid::u32 >= ctx.instr_count) { ret false; }
    ret ctx.count_mask_fold[iid::u32];
}

# the operand of a count mask that is not its mask constant, or none when
# `inst` is not a scalar `and` of a variable value with a constant
pub fun count_mask_source(ctx: *LowerCtx, inst: *ir_instruction.Instruction) opt[u32] {
    if (inst.kind != ir_instruction.OP_AND || inst.operand_count != 2)     { ret opt[u32].none{}; }
    if (value_is_vector(ctx, inst.ty) || value_is_aggregate(ctx, inst.ty)) { ret opt[u32].none{}; }
    val c0: bool = inst.operands[0].kind == value.VAL_CONST_INT;
    val c1: bool = inst.operands[1].kind == value.VAL_CONST_INT;
    if (c1 && !c0) { ret opt[u32].some{0}; }
    if (c0 && !c1) { ret opt[u32].some{1}; }
    ret opt[u32].none{};
}

# the mask constant of a count mask, at the mask's own width
fun count_mask_constant(ctx: *LowerCtx, mask: *ir_instruction.Instruction) wide.Wide {
    var c: value.Value = mask.operands[1];
    if (mask.operands[0].kind == value.VAL_CONST_INT) { c = mask.operands[0]; }
    ret wide.trunc(value.int_of(?c), op_width_of(ctx, mask.ty)::u32 * 8);
}

# whether a shift reads operand `o` as a count the machine takes modulo the
# width it shifts at, and `mask` is exactly that width's bits less one
fun count_mask_use_folds(ctx: *LowerCtx, inst: *ir_instruction.Instruction, o: u32, mask: wide.Wide) bool {
    if (o != 1)                                                                                                             { ret false; }
    if (inst.kind != ir_instruction.OP_SHL && inst.kind != ir_instruction.OP_SHR_U && inst.kind != ir_instruction.OP_SHR_S) { ret false; }
    if (value_is_vector(ctx, inst.ty) || value_is_vector(ctx, inst.operands[1].ty))                                         { ret false; }
    val natural_w: u8  = op_width_of(ctx, inst.ty);
    val w:         u8  = isa.clamp_alu_width(?ctx.tgt.model, natural_w);
    val maw:       u32 = isa.max_alu_width(?ctx.tgt.model);
    if (w != natural_w || (maw != 0 && w::u32 > maw))       { ret false; }
    if (!isa.shift_count_mod_width(?ctx.tgt.model, w::u32)) { ret false; }
    ret wide.eq(mask, wide.from_u64(w::u64 * 8 - 1));
}

# a count mask folds when every use of it is a shift count that
# count_mask_use_folds admits; any other use needs the masked value itself
pub fun mark_foldable_count_masks(ctx: *LowerCtx, fn: *me_ir.Function) {
    var i: u32 = 0;
    for (i < ctx.instr_count) {
        ctx.count_mask_fold[i] = false;
        i                      = i + 1;
    }
    if (map.length[ir_id.InstructionId, me_ir.IrAsm](fn.asm_blocks) > 0) { ret; }

    i = 0;
    for (i < ctx.instr_count) {
        val src: opt[u32] = count_mask_source(ctx, ?fn.instrs[i]);
        if (sel src.some) { ctx.count_mask_fold[i] = true; }
        i = i + 1;
    }
    i = 0;
    for (i < ctx.instr_count) {
        val inst: *ir_instruction.Instruction = ?fn.instrs[i];
        var o:    u32                         = 0;
        for (o < inst.operand_count) {
            val v: value.Value = inst.operands[o];
            if (v.kind == value.VAL_INSTR && v.data.instr::u32 < ctx.instr_count) {
                val g: u32 = v.data.instr::u32;
                if (ctx.count_mask_fold[g] && !count_mask_use_folds(ctx, inst, o, count_mask_constant(ctx, ?fn.instrs[g]))) {
                    ctx.count_mask_fold[g] = false;
                }
            }
            o = o + 1;
        }
        i = i + 1;
    }
}

pub fun cmp_folds_into_select(ctx: *LowerCtx, iid: ir_id.InstructionId) bool {
    if (ctx.select_cmp_fold == nil || iid::u32 >= ctx.instr_count) { ret false; }
    ret ctx.select_cmp_fold[iid::u32];
}

# a scalar integer compare the alu reads whole
fun select_cmp_candidate(ctx: *LowerCtx, inst: *ir_instruction.Instruction) bool {
    if (!opdesc.has(inst.kind, opdesc.EFF_COMPARE) || inst.operand_count != 2) { ret false; }
    val ty: ir_type.IrTypeId = inst.operands[0].ty;
    if (value_is_vector(ctx, ty) || value_is_float(ctx, ty) || value_is_aggregate(ctx, ty)) { ret false; }
    val maw: u32 = isa.max_alu_width(?ctx.tgt.model);
    ret maw == 0 || op_width_of(ctx, ty)::u32 <= maw;
}

# a compare folds into its selects when it has one and every use is the
# condition of a select in the compare's own block; a debug binding or any
# other reader needs the 0/1 answer itself
fun mark_foldable_select_cmps(ctx: *LowerCtx, fn: *me_ir.Function) {
    var i: u32 = 0;
    for (i < ctx.instr_count) {
        ctx.select_cmp_fold[i] = false;
        i                      = i + 1;
    }
    if (map.length[ir_id.InstructionId, me_ir.IrAsm](fn.asm_blocks) > 0) { ret; }

    var b: u32 = 0;
    for (b < fn.block_count) {
        val blk: *me_ir.Block = ?fn.blocks[b];
        var k:   u32          = 0;
        for (k < blk.instr_count) {
            val iid: u32 = blk.instructions[k]::u32;
            if (iid < ctx.instr_count && select_cmp_candidate(ctx, ?fn.instrs[iid])) { ctx.select_cmp_fold[iid] = true; }
            k = k + 1;
        }
        b = b + 1;
    }
    b = 0;
    for (b < fn.block_count) {
        val blk: *me_ir.Block = ?fn.blocks[b];
        var k:   u32          = 0;
        for (k < blk.phi_count + blk.instr_count + 1) {
            var iid: ir_id.InstructionId = blk.terminator;
            if (k < blk.phi_count)                   { iid = blk.phis[k]; }
            or (k < blk.phi_count + blk.instr_count) { iid = blk.instructions[k - blk.phi_count]; }
            k = k + 1;
            if (iid == ir_id.INSTR_NIL || iid::u32 >= ctx.instr_count) { cnt; }
            val inst: *ir_instruction.Instruction = ?fn.instrs[iid::u32];
            var o:    u32                         = 0;
            for (o < inst.operand_count) {
                val v: value.Value = inst.operands[o];
                o = o + 1;
                if (v.kind != value.VAL_INSTR || v.data.instr::u32 >= ctx.instr_count) { cnt; }
                val g: u32 = v.data.instr::u32;
                if (!ctx.select_cmp_fold[g]) { cnt; }
                if (inst.kind != ir_instruction.OP_SELECT || o != 1 || !defined_in(blk, v.data.instr)) {
                    ctx.select_cmp_fold[g] = false;
                }
            }
        }
        b = b + 1;
    }
}

fun defined_in(blk: *me_ir.Block, iid: ir_id.InstructionId) bool {
    var k: u32 = 0;
    for (k < blk.instr_count) {
        if (blk.instructions[k] == iid) { ret true; }
        k = k + 1;
    }
    ret false;
}

fun gep_use_folds(ctx: *LowerCtx, inst: *ir_instruction.Instruction, o: u32) bool {
    if ((inst.flags & ir_instruction.INSTR_FLAG_VOLATILE) != 0) { ret false; }
    if (inst.kind == ir_instruction.OP_LOAD && o == 0) {
        ret !value_is_aggregate(ctx, inst.ty) && !subwidth_vector_memory(ctx, inst.ty);
    }
    if (inst.kind == ir_instruction.OP_STORE && o == 1 && inst.operand_count >= 2) {
        ret !value_is_aggregate(ctx, inst.operands[0].ty) && !subwidth_vector_memory(ctx, inst.operands[0].ty);
    }
    ret false;
}

pub fun gep_folds(ctx: *LowerCtx, iid: ir_id.InstructionId) bool {
    if (ctx.gep_fold == nil || iid::u32 >= ctx.instr_count) { ret false; }
    ret ctx.gep_fold[iid::u32];
}

# the folded addresses are computed after the use check, from the IR alone;
# a candidate whose address needs an instruction is not folded
pub fun seed_gep_mems(ctx: *LowerCtx, fn: *me_ir.Function, pure: fun(*LowerCtx, *ir_instruction.Instruction) opt[codegen_mir.MirOperand]) {
    if (ctx.gep_fold == nil) { ret; }
    var i: u32 = 0;
    for (i < ctx.instr_count) {
        if (ctx.gep_fold[i]) {
            val m: opt[codegen_mir.MirOperand] = pure(ctx, ?fn.instrs[i]);
            if (sel m.some) { ctx.gep_mem[i] = m.some; }
            or              { ctx.gep_fold[i] = false; }
        }
        i = i + 1;
    }
}

pub fun ctx_dnit(ctx: *LowerCtx) {
    if (ctx.gep_fold != nil && ctx.instr_count > 0) {
        A.deallocate[bool](ctx.alloc, ctx.gep_fold, ctx.instr_count::usize);
        ctx.gep_fold = nil;
    }
    if (ctx.gep_mem != nil && ctx.instr_count > 0) {
        A.deallocate[codegen_mir.MirOperand](ctx.alloc, ctx.gep_mem, ctx.instr_count::usize);
        ctx.gep_mem = nil;
    }
    if (ctx.count_mask_fold != nil && ctx.instr_count > 0) {
        A.deallocate[bool](ctx.alloc, ctx.count_mask_fold, ctx.instr_count::usize);
        ctx.count_mask_fold = nil;
    }
    if (ctx.select_cmp_fold != nil && ctx.instr_count > 0) {
        A.deallocate[bool](ctx.alloc, ctx.select_cmp_fold, ctx.instr_count::usize);
        ctx.select_cmp_fold = nil;
    }
    if (ctx.param_vregs != nil && ctx.param_count > 0) {
        A.deallocate[codegen_mir.VRegId](ctx.alloc, ctx.param_vregs, ctx.param_count::usize);
        ctx.param_vregs = nil;
    }
    if (ctx.instr_vregs != nil && ctx.instr_count > 0) {
        A.deallocate[codegen_mir.VRegId](ctx.alloc, ctx.instr_vregs, ctx.instr_count::usize);
        ctx.instr_vregs = nil;
    }
    if (ctx.slot_key_vregs != nil && ctx.instr_count > 0) {
        A.deallocate[codegen_mir.VRegId](ctx.alloc, ctx.slot_key_vregs, ctx.instr_count::usize);
        ctx.slot_key_vregs = nil;
    }
    if (ctx.pending != nil && ctx.pending_cap > 0) {
        A.deallocate[codegen_mir.MirDbgBinding](ctx.alloc, ctx.pending, ctx.pending_cap::usize);
        ctx.pending = nil;
    }
}

pub fun push_pending_dbg(ctx: *LowerCtx, iid: u32, vreg: u32) err[fail.Fail] {
    ret push_pending_dbg_piece(ctx, iid, vreg, 0, 0, 0, 0);
}

# a pending binding of one piece of a value held in several registers (#3589)
pub fun push_pending_dbg_piece(ctx: *LowerCtx, iid: u32, vreg: u32, lane: u8, lanes: u8, lane_bytes: u8, last_bytes: u8) err[fail.Fail] {
    if (ctx.pending_count >= ctx.pending_cap) {
        var new_cap: u32 = ctx.pending_cap * 2;
        if (new_cap < 4) { new_cap = 4; }
        if (ctx.pending == nil) {
            val ra: res[*codegen_mir.MirDbgBinding, A.Error] = A.allocate[codegen_mir.MirDbgBinding](ctx.alloc, new_cap::usize);
            if (sel ra.err) { ret err[fail.Fail].err{fail.refused(ra.err)}; }
            ctx.pending = ra.ok;
        }
        or {
            val rr: res[*codegen_mir.MirDbgBinding, A.Error] = A.reallocate[codegen_mir.MirDbgBinding](ctx.alloc, ctx.pending, ctx.pending_cap::usize, new_cap::usize);
            if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
            ctx.pending = rr.ok;
        }
        ctx.pending_cap = new_cap;
    }
    ctx.pending[ctx.pending_count].iid        = iid;
    ctx.pending[ctx.pending_count].vreg       = vreg;
    ctx.pending[ctx.pending_count].lane       = lane;
    ctx.pending[ctx.pending_count].lanes      = lanes;
    ctx.pending[ctx.pending_count].lane_bytes = lane_bytes;
    ctx.pending[ctx.pending_count].last_bytes = last_bytes;
    ctx.pending_count                         = ctx.pending_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun drain_pending_dbg(ctx: *LowerCtx, mi: *codegen_mir.MirInstr) err[fail.Fail] {
    var i: u32 = 0;
    for (i < ctx.pending_count) {
        val pb: *codegen_mir.MirDbgBinding = ?ctx.pending[i];
        val ra: err[fail.Fail]             = codegen_mir.instr_attach_dbg_piece(ctx.alloc, mi, pb.iid, pb.vreg, pb.lane, pb.lanes, pb.lane_bytes, pb.last_bytes, false);
        if (sel ra.err) { ret ra; }
        i = i + 1;
    }
    ctx.pending_count = 0;
    ret err[fail.Fail].ok{};
}

# the convention declares how values cross a call: a values convention has no banks, so every vreg is a value
pub fun values_convention(ctx: *LowerCtx) bool {
    ret ctx.tgt.abi.passing == abi.PASSING_VALUES;
}

pub fun new_vreg(ctx: *LowerCtx, reg_class: u32) res[codegen_mir.VRegId, fail.Fail] {
    val f: *codegen_mir.MirFunction = ctx.f;
    if (f.vreg_count >= f.vreg_cap) {
        val new_cap:   u32                                = f.vreg_cap * 2;
        val res_vregs: res[*codegen_mir.MirVReg, A.Error] = A.reallocate[codegen_mir.MirVReg](ctx.alloc, f.vregs, f.vreg_cap::usize, new_cap::usize);
        if (sel res_vregs.err) { ret res[codegen_mir.VRegId, fail.Fail].err{fail.refused(res_vregs.err)}; }
        f.vregs    = res_vregs.ok;
        f.vreg_cap = new_cap;
    }
    val vid:            u32 = f.vreg_count;
    var selected_class: u32 = reg_class;
    if (values_convention(ctx)) { selected_class = codegen_mir.REG_CLASS_VALUE; }
    f.vregs[vid] = codegen_mir.vreg(vid, selected_class, 0, false);
    f.vreg_count = f.vreg_count + 1;
    ret res[codegen_mir.VRegId, fail.Fail].ok{codegen_mir.vreg_id(vid)};
}

pub fun new_vreg_vec(ctx: *LowerCtx, reg_class: u32, vec_bytes: u8) res[codegen_mir.VRegId, fail.Fail] {
    val r: res[codegen_mir.VRegId, fail.Fail] = new_vreg(ctx, reg_class);
    if (sel r.err) { ret r; }
    ctx.f.vregs[r.ok.n].vec_bytes = vec_bytes;
    ret r;
}

# the register bytes a value of `ty` is realized in when it is a vector, 0
# for any other value
fun vec_bytes_of(ctx: *LowerCtx, ty: ir_type.IrTypeId) u8 {
    if (!value_is_vector(ctx, ty)) { ret 0; }
    ret op_width_of(ctx, ty);
}

pub fun instr_vreg(ctx: *LowerCtx, iid: ir_id.InstructionId) codegen_mir.VRegId {
    if (iid == ir_id.INSTR_NIL)      { ret codegen_mir.MIR_VREG_NIL; }
    if (ctx.instr_vregs == nil)      { ret codegen_mir.MIR_VREG_NIL; }
    if (iid::u32 >= ctx.instr_count) { ret codegen_mir.MIR_VREG_NIL; }
    ret ctx.instr_vregs[iid::u32];
}

pub fun slot_key_vreg(ctx: *LowerCtx, iid: ir_id.InstructionId) codegen_mir.VRegId {
    if (iid == ir_id.INSTR_NIL)      { ret codegen_mir.MIR_VREG_NIL; }
    if (ctx.slot_key_vregs == nil)   { ret codegen_mir.MIR_VREG_NIL; }
    if (iid::u32 >= ctx.instr_count) { ret codegen_mir.MIR_VREG_NIL; }
    ret ctx.slot_key_vregs[iid::u32];
}

pub fun value_is_float(ctx: *LowerCtx, ty: ir_type.IrTypeId) bool {
    ret ir_type.is_float_scalar(ctx.types, ty);
}

pub fun value_is_aggregate(ctx: *LowerCtx, ty: ir_type.IrTypeId) bool {
    ret ir_type.is_aggregate(ctx.types, ty);
}

pub fun value_is_vector(ctx: *LowerCtx, ty: ir_type.IrTypeId) bool {
    ret ir_type.is_vector(ctx.types, ty);
}

pub fun vec_lane_for_type(ctx: *LowerCtx, ty: ir_type.IrTypeId) u32 {
    var is_float:   bool = false;
    var elem_bytes: u8   = 0;
    var lanes:      u32  = 0;
    if (!ir_type.vector_lane(ctx.types, ty, ?is_float, ?elem_bytes, ?lanes)) { ret codegen_mir.VEC_LANE_NONE; }
    var kind: u8 = codegen_mir.VEC_LANE_INT;
    if (is_float) { kind = codegen_mir.VEC_LANE_FLOAT; }
    ret codegen_mir.vec_lane_make(kind, elem_bytes, lanes);
}

pub fun compute_vec_lane(ctx: *LowerCtx, inst: *ir_instruction.Instruction) u32 {
    if (inst.kind == ir_instruction.OP_BITCAST) {
        val r: u32 = vec_lane_for_type(ctx, inst.ty);
        if (codegen_mir.vec_lane_is_vector(r)) { ret r; }
    }
    # a lane-changing instruction names its result lane and carries its operand's
    val vclass: opdesc.VecClass = opdesc.vec_class(inst.kind);
    if ((vclass == opdesc.VCLASS_CONVERT || vclass == opdesc.VCLASS_WIDEN || vclass == opdesc.VCLASS_WIDEN_HALF
        || vclass == opdesc.VCLASS_WIDEN_SUM) && inst.operand_count >= 1) {
        val result: u32 = vec_lane_for_type(ctx, inst.ty);
        val from:   u32 = vec_lane_for_type(ctx, inst.operands[0].ty);
        if (codegen_mir.vec_lane_is_vector(result) && codegen_mir.vec_lane_is_vector(from)) {
            ret codegen_mir.vec_lane_make_convert(result, codegen_mir.vec_lane_kind(from), codegen_mir.vec_lane_elem_bytes(from));
        }
    }
    var i: u32 = 0;
    for (i < inst.operand_count) {
        val d: u32 = vec_lane_for_type(ctx, inst.operands[i].ty);
        if (codegen_mir.vec_lane_is_vector(d)) { ret d; }
        i = i + 1;
    }
    ret vec_lane_for_type(ctx, inst.ty);
}

# a parameter's vreg holds its value, rather than the address of it: an
# aggregate, and a vector the middle end places in memory (its ir parameter a
# pointer where the signature declares the vector), arrive as the address of
# their storage, which is public whatever the value's secrecy (#3589)
fun param_holds_value(ctx: *LowerCtx, i: u32) bool {
    val ty: ir_type.IrTypeId = ctx.fn.params[i].ty;
    if (value_is_aggregate(ctx, ty)) { ret false; }
    ret !vector_image(ctx, sig_param_type(ctx, ctx.fn.sig, i), ty);
}

# a secret load or call's vreg holds its value, rather than the address of
# it: an aggregate, and a vector result the middle end places in memory (the
# call's ir type a pointer where its signature returns the vector), arrive as
# the address of their storage, which is public (#4133)
fun instr_holds_value(ctx: *LowerCtx, inst: *ir_instruction.Instruction) bool {
    if (value_is_aggregate(ctx, inst.ty))    { ret false; }
    if (inst.kind != ir_instruction.OP_CALL) { ret true; }
    ret !vector_image(ctx, sig_return_type(ctx, inst.aux_ty), inst.ty);
}

# a value the signature declares a vector and the ir carries as the address of
# its memory image, as scalarize places a vector no register holds
pub fun vector_image(ctx: *LowerCtx, declared: ir_type.IrTypeId, ty: ir_type.IrTypeId) bool {
    ret value_is_vector(ctx, declared) && !value_is_vector(ctx, ty);
}

pub fun param_is_vector_image(ctx: *LowerCtx, i: u32) bool {
    ret vector_image(ctx, sig_param_type(ctx, ctx.fn.sig, i), ctx.fn.params[i].ty);
}

# parameter `i` of a signature, IRT_NIL past its parameters or for a type
# that is not a function's
pub fun sig_param_type(ctx: *LowerCtx, sig: ir_type.IrTypeId, i: u32) ir_type.IrTypeId {
    val opt_type: opt[*ir_type.IrType] = ir_type.get(ctx.types, sig);
    if (sel opt_type.none) { ret ir_type.IRT_NIL; }
    val t: *ir_type.IrType = opt_type.some;
    if (t.kind != ir_type.IRT_FN || i >= t.data.fn.param_count) { ret ir_type.IRT_NIL; }
    ret t.data.fn.params[i];
}

pub fun fn_return_type(ctx: *LowerCtx) ir_type.IrTypeId {
    ret sig_return_type(ctx, ctx.fn.sig);
}

# the return type of a signature, IRT_NIL for a type that is not a function's
fun sig_return_type(ctx: *LowerCtx, sig: ir_type.IrTypeId) ir_type.IrTypeId {
    val opt_type: opt[*ir_type.IrType] = ir_type.get(ctx.types, sig);
    if (sel opt_type.none) { ret ir_type.IRT_NIL; }
    val t: *ir_type.IrType = opt_type.some;
    if (t.kind != ir_type.IRT_FN) { ret ir_type.IRT_NIL; }
    ret t.data.fn.ret_type;
}

# the alloca `iid` is the result storage the caller passed (#4120)
pub fun is_result_image(ctx: *LowerCtx, iid: ir_id.InstructionId) bool {
    ret ctx.result_in_place && iid == ctx.result_image;
}

# whether `v` is the result of the call lowered as a jump
pub fun names_tail_call(ctx: *LowerCtx, v: value.Value) bool {
    ret ctx.in_tail && v.kind == value.VAL_INSTR && v.data.instr == ctx.tail_call;
}

pub fun ret_align(ctx: *LowerCtx, ty: ir_type.IrTypeId) u32 {
    val align: u32 = ir_type.byte_align_for_machine(ctx.types, ty, ctx.layout);
    if (align == 0) { ret ctx.tgt.model.gpr_width; }
    ret align;
}

# the operand width of a scalar is its size at every size the target realizes
# (lower_instr refuses an integer the target does not before this is asked);
# an aggregate or a scalar of no size is one register
pub fun op_width_of(ctx: *LowerCtx, ty: ir_type.IrTypeId) u8 {
    if (value_is_vector(ctx, ty))    { ret vector_op_width(ctx, ty); }
    if (value_is_aggregate(ctx, ty)) { ret ctx.tgt.model.gpr_width::u8; }

    val sz: u32 = ir_type.byte_size_for_machine(ctx.types, ty, ctx.layout);
    if (sz == 1)                                                { ret 1; }
    if (sz == 2)                                                { ret 2; }
    if (sz == 4)                                                { ret 4; }
    if (sz == 8)                                                { ret 8; }
    if (sz == 16 && isa.realizes_int_width(?ctx.tgt.model, 16)) { ret 16; }
    ret ctx.tgt.model.gpr_width::u8;
}

# a vector is one register of the width its lanes' kind computes at that
# holds it (#4128)
fun vector_op_width(ctx: *LowerCtx, ty: ir_type.IrTypeId) u8 {
    var is_float:   bool = false;
    var elem_bytes: u8   = 0;
    var lanes:      u32  = 0;
    if (!ir_type.vector_lane(ctx.types, ty, ?is_float, ?elem_bytes, ?lanes)) { ret ctx.tgt.model.vector_op_bytes::u8; }
    val size: u32 = ir_type.byte_size_for_machine(ctx.types, ty, ctx.layout);
    ret isa.vector_op_bytes(?ctx.tgt.model, is_float, elem_bytes::u32 * 8, size)::u8;
}

# the byte size of an integer scalar the target does not realize, 0 when the
# type is not one: the width refusal's one predicate
pub fun unrealized_int_width(ctx: *LowerCtx, ty: ir_type.IrTypeId) u32 {
    val found: opt[*ir_type.IrType] = ir_type.get(ctx.types, ty);
    if (sel found.none)                     { ret 0; }
    if (found.some.kind != ir_type.IRT_INT) { ret 0; }
    val bytes: u32 = ir_type.byte_size_for_machine(ctx.types, ty, ctx.layout);
    if (bytes == 0)                                    { ret 0; }
    if (isa.realizes_int_width(?ctx.tgt.model, bytes)) { ret 0; }
    ret bytes;
}

pub fun mem_width_of(ctx: *LowerCtx, ty: ir_type.IrTypeId) u8 {
    val sz: u32 = ir_type.byte_size_for_machine(ctx.types, ty, ctx.layout);
    if (sz == 0 || sz > 255) { ret op_width_of(ctx, ty); }
    ret sz::u8;
}

pub fun stack_slot_bytes(tgt: *resolved.Target, size: u64) i64 {
    val word: u64 = tgt.model.gpr_width::u64;
    var n:    u64 = size;
    if (n == 0) { n = word; }
    ret round_up_word(n, word)::i64;
}

fun operand_fail(ctx: *LowerCtx, text: str) res[codegen_mir.MirOperand, fail.Fail] {
    ret res[codegen_mir.MirOperand, fail.Fail].err{fail.message(text)};
}

# the MIR operand of an IR value. a byte or aggregate constant is a declared
# member no operand carries (it is lowered through storage), reported as
# unsupported; a kind outside the catalog is an internal failure naming the
# tag; both were panics behind the verifier
pub fun lower_value(ctx: *LowerCtx, v: value.Value) res[codegen_mir.MirOperand, fail.Fail] {
    if (v.kind == value.VAL_INSTR) {
        ret res[codegen_mir.MirOperand, fail.Fail].ok{codegen_mir.op_vreg(instr_vreg(ctx, v.data.instr))};
    }
    if (v.kind == value.VAL_PARAM) {
        ret res[codegen_mir.MirOperand, fail.Fail].ok{codegen_mir.op_vreg(param_vreg(ctx, v.data.param_ix))};
    }
    if (v.kind == value.VAL_CONST_INT) {
        val w: wide.Wide = value.int_of(?v);
        ret res[codegen_mir.MirOperand, fail.Fail].ok{codegen_mir.op_imm_wide(w.lo:~i64, w.hi:~i64)};
    }
    if (v.kind == value.VAL_CONST_NULL) {
        ret res[codegen_mir.MirOperand, fail.Fail].ok{codegen_mir.op_imm(0)};
    }
    if (v.kind == value.VAL_CONST_FLOAT) {
        if (op_width_of(ctx, v.ty) == 4) {
            ret res[codegen_mir.MirOperand, fail.Fail].ok{codegen_mir.op_imm(float.f64_to_f32_bits(v.data.int_lit)::i64)};
        }
        ret res[codegen_mir.MirOperand, fail.Fail].ok{codegen_mir.op_imm(v.data.int_lit::i64)};
    }
    if (v.kind == value.VAL_GLOBAL) {
        if (v.data.global_ix < ctx.m.global_len) {
            val g: *me_ir.Global = ?ctx.m.globals[v.data.global_ix];
            ret res[codegen_mir.MirOperand, fail.Fail].ok{import_sym(ctx, g.name, g.is_import)};
        }
        ret operand_fail(ctx, "mir.lower_ir: global value index out of range");
    }
    if (v.kind == value.VAL_FN) {
        if (v.data.fn_ix < ctx.m.function_len) {
            val fx: *me_ir.Function = ?ctx.m.functions[v.data.fn_ix];
            ret res[codegen_mir.MirOperand, fail.Fail].ok{import_sym(ctx, fx.name, fx.is_import)};
        }
        ret operand_fail(ctx, "mir.lower_ir: function value index out of range");
    }
    if (v.kind == value.VAL_CONST_BYTES) {
        ret operand_fail(ctx, fail.catalog_message_or(ctx.interner, ctx.alloc,
            fail.unsupported_member("ValueKind", "const_bytes", "a MIR operand"), "ValueKind const_bytes is unsupported as a MIR operand"));
    }
    if (v.kind == value.VAL_CONST_AGG) {
        ret operand_fail(ctx, fail.catalog_message_or(ctx.interner, ctx.alloc,
            fail.unsupported_member("ValueKind", "const_agg", "a MIR operand"), "ValueKind const_agg is unsupported as a MIR operand"));
    }
    ret operand_fail(ctx, fail.catalog_message_or(ctx.interner, ctx.alloc,
        fail.unknown_member_in("ValueKind", v.kind::u32, "the operand lowering"), "unknown ValueKind tag in the operand lowering"));
}

# a symbol's address as an operand. an import's is read from the GOT slot the
# loader binds where the format has one, so it is the definition's own address
# and not a call stub or a copy (#3942)
fun import_sym(ctx: *LowerCtx, name: intern.StrId, is_import: bool) codegen_mir.MirOperand {
    var o: codegen_mir.MirOperand = codegen_mir.op_sym(name, 0);
    o.sym_got = is_import && ctx.tgt.of != nil && ctx.tgt.of.imports_through_got;
    ret o;
}

# the target of a call. a direct call reaches an import through its call stub,
# so the callee is the bare symbol, never its GOT slot
pub fun lower_callee(ctx: *LowerCtx, v: value.Value) res[codegen_mir.MirOperand, fail.Fail] {
    val lowered: res[codegen_mir.MirOperand, fail.Fail] = lower_value(ctx, v);
    if (sel lowered.err) { ret lowered; }
    var o: codegen_mir.MirOperand = lowered.ok;
    if (v.kind == value.VAL_FN) { o.sym_got = false; }
    ret res[codegen_mir.MirOperand, fail.Fail].ok{o};
}

pub fun lower_operand(ctx: *LowerCtx, inst: *ir_instruction.Instruction, idx: u32) res[codegen_mir.MirOperand, fail.Fail] {
    val v: value.Value = inst.operands[idx];
    if (refs.operand_is_block(inst.kind, idx)) {
        ret res[codegen_mir.MirOperand, fail.Fail].ok{codegen_mir.op_block(v.data.int_lit::u32)};
    }
    ret lower_value(ctx, v);
}

pub fun mem_operand_of(ctx: *LowerCtx, v: value.Value) res[codegen_mir.MirOperand, fail.Fail] {
    if (v.kind == value.VAL_INSTR && gep_folds(ctx, v.data.instr)) {
        ret res[codegen_mir.MirOperand, fail.Fail].ok{ctx.gep_mem[v.data.instr::u32]};
    }
    ret mem_operand_of_plain(ctx, v);
}

# the memory operand of a pointer value as lowered, with no folded address
pub fun mem_operand_of_plain(ctx: *LowerCtx, v: value.Value) res[codegen_mir.MirOperand, fail.Fail] {
    val op_r: res[codegen_mir.MirOperand, fail.Fail] = lower_value(ctx, v);
    if (sel op_r.err) { ret op_r; }
    val op: codegen_mir.MirOperand = op_r.ok;
    if (op.kind == codegen_mir.MIR_OP_VREG) { ret res[codegen_mir.MirOperand, fail.Fail].ok{codegen_mir.op_mem_value(op.vreg, 0)}; }
    ret res[codegen_mir.MirOperand, fail.Fail].ok{op};
}

# an address names storage and is public whatever the bytes there hold, so an
# instruction that forms one never declares a secret write (#4133)
fun forms_address(op: codegen_mir.MirOpcode) bool {
    ret op == codegen_mir.MIR_GEP || op == codegen_mir.MIR_ALLOCA;
}

pub fun push_instr(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, mi: codegen_mir.MirInstr) err[fail.Fail] {
    var ni: codegen_mir.MirInstr = mi;
    if (ni.opcode != codegen_mir.MIR_ASM) { ni.asm_block = nil; }
    ni.loc               = ctx.cur_loc;
    ni.inline_site       = ctx.cur_inline_site;
    ni.vec_lane          = ctx.cur_vec_lane;
    ni.writes_secret     = ctx.cur_writes_secret && !forms_address(ni.opcode);
    ni.memory_flags      = ctx.cur_memory_flags;
    ni.dbg_bindings      = nil;
    ni.dbg_binding_count = 0;
    val res_drain: err[fail.Fail] = drain_pending_dbg(ctx, ?ni);
    if (sel res_drain.err) { ret res_drain; }
    val res_grow: err[fail.Fail] = grow_instr(ctx, mb);
    if (sel res_grow.err) { ret res_grow; }
    mb.instrs[mb.instr_count] = ni;
    mb.instr_count            = mb.instr_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun grow_instr(ctx: *LowerCtx, mb: *codegen_mir.MirBlock) err[fail.Fail] {
    if (mb.instr_count >= mb.instr_cap) {
        var new_cap: u32 = mb.instr_cap * 2;
        if (new_cap < codegen_mir.INITIAL_INSTR_CAP) { new_cap = codegen_mir.INITIAL_INSTR_CAP; }
        val res_instrs: res[*codegen_mir.MirInstr, A.Error] = A.reallocate[codegen_mir.MirInstr](ctx.alloc, mb.instrs, mb.instr_cap::usize, new_cap::usize);
        if (sel res_instrs.err) { ret err[fail.Fail].err{fail.refused(res_instrs.err)}; }
        mb.instrs    = res_instrs.ok;
        mb.instr_cap = new_cap;
    }
    ret err[fail.Fail].ok{};
}

pub fun emit_mov(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, dst: codegen_mir.MirOperand, src: codegen_mir.MirOperand) err[fail.Fail] {
    ret inst2(ctx, mb, codegen_mir.MIR_MOV, dst, src, ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
}

pub fun emit_mov_w(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, dst: codegen_mir.MirOperand, src: codegen_mir.MirOperand, w: u8) err[fail.Fail] {
    ret inst2(ctx, mb, codegen_mir.MIR_MOV, dst, src, w, w);
}

fun narrow_imm_value(imm: i64, width: u8, signed: bool) i64 {
    if (width == 0 || width >= 8) { ret imm; }
    val bits: u32 = width::u32 * 8;
    val m:    u64 = (1::u64 << bits) - 1;
    val v:    u64 = imm::u64 & m;
    if (!signed) { ret v::i64; }
    val sign: u64 = 1::u64 << (bits - 1);
    if ((v & sign) == 0) { ret v::i64; }
    ret (v | ~m)::i64;
}

# the 128-bit immediate an immediate of `width` bytes extends to: a zero
# extension of the full 64-bit limb has no sign to fill (#3511)
fun promote_imm(imm: i64, width: u8, signed: bool) codegen_mir.MirOperand {
    val v: i64 = narrow_imm_value(imm, width, signed);
    if (!signed && (width == 0 || width >= 8)) { ret codegen_mir.op_imm_wide(v, 0); }
    ret codegen_mir.op_imm(v);
}

pub fun emit_promote(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, dst: codegen_mir.MirOperand, src: codegen_mir.MirOperand,
    dst_w: u8, src_w: u8, signed: bool) err[fail.Fail] {
    if (src_w >= dst_w) {
        ret emit_mov_w(ctx, mb, dst, src, dst_w);
    }
    if (src.kind == codegen_mir.MIR_OP_IMM) {
        ret emit_mov_w(ctx, mb, dst, promote_imm(src.imm, src_w, signed), dst_w);
    }
    val r: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *codegen_mir.MirOperand = r.ok;
    ops[0] = dst;
    ops[1] = src;
    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_ZEXT, ops, 2, dst_w, src_w);
    if (signed) { mi.opcode = codegen_mir.MIR_SEXT; }
    ret push_instr(ctx, mb, mi);
}

# a zero extension of a full 64-bit immediate has no sign to fill (#3511)
test promote_imm__unsigned_full_limb_is_not_sign_filled {
    val zu: codegen_mir.MirOperand = promote_imm(-1, 8, false);
    if (zu.kind != codegen_mir.MIR_OP_IMM || zu.imm != -1 || zu.imm_hi != 0) { ret 1; }
    val zs: codegen_mir.MirOperand = promote_imm(-1, 8, true);
    if (zs.imm != -1 || zs.imm_hi != -1) { ret 2; }
    val nu: codegen_mir.MirOperand = promote_imm(200, 1, false);
    if (nu.imm != 200 || nu.imm_hi != 0) { ret 3; }
    val ns: codegen_mir.MirOperand = promote_imm(200, 1, true);
    if (ns.imm != -56 || ns.imm_hi != -1) { ret 4; }
    val wu: codegen_mir.MirOperand = promote_imm(0x7FFFFFFF, 4, false);
    if (wu.imm != 0x7FFFFFFF || wu.imm_hi != 0) { ret 5; }
    ret 0;
}

test narrow_imm_value__wraps_only_when_signed {
    if (narrow_imm_value(200, 1, true) != -56)  { ret 1; }
    if (narrow_imm_value(200, 1, false) != 200) { ret 2; }
    if (narrow_imm_value(-56, 8, true) != -56)  { ret 3; }
    if (narrow_imm_value(-56, 0, true) != -56)  { ret 4; }
    ret 0;
}

pub fun emit_declassify(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, dst: codegen_mir.MirOperand, src: codegen_mir.MirOperand, w: u8) err[fail.Fail] {
    ret inst2(ctx, mb, codegen_mir.MIR_DECLASSIFY, dst, src, w, w);
}

pub fun emit_fmov(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, dst: codegen_mir.MirOperand, src: codegen_mir.MirOperand, w: u8) err[fail.Fail] {
    ret inst2(ctx, mb, codegen_mir.MIR_MOV, dst, src, w, w);
}

pub fun emit_store_to(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, mem: codegen_mir.MirOperand, src: codegen_mir.MirOperand) err[fail.Fail] {
    ret inst2(ctx, mb, codegen_mir.MIR_STORE, mem, src, ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
}

pub fun emit_store_to_w(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, mem: codegen_mir.MirOperand, src: codegen_mir.MirOperand, width: u8) err[fail.Fail] {
    ret inst2(ctx, mb, codegen_mir.MIR_STORE, mem, src, width, width);
}

pub fun emit_load_from_w(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, dst: codegen_mir.VRegId, mem: codegen_mir.MirOperand, width: u8) err[fail.Fail] {
    ret inst2(ctx, mb, codegen_mir.MIR_LOAD, codegen_mir.op_vreg(dst), mem, width, width);
}

pub fun push_store_chunk(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, mem: codegen_mir.MirOperand, src: codegen_mir.MirOperand, w: u8) err[fail.Fail] {
    ret inst2(ctx, mb, codegen_mir.MIR_STORE, mem, src, w, w);
}

fun store_vector_register(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, dest: codegen_mir.MirOperand,
    value: codegen_mir.MirOperand, ty: ir_type.IrTypeId) err[fail.Fail] {
    val reg_w: u8                                    = op_width_of(ctx, ty);
    val sr:    res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
    if (sel sr.err) { ret err[fail.Fail].err{fail.refused(sr.err)}; }
    val ops: *codegen_mir.MirOperand = sr.ok;
    ops[0] = dest;
    ops[1] = value;
    var store: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_STORE, ops, 2, reg_w, reg_w);
    store.vec_lane = vec_lane_for_type(ctx, ty);
    ret push_instr(ctx, mb, store);
}

pub fun mem_at(m: codegen_mir.MirOperand, off: i64) codegen_mir.MirOperand {
    var o: codegen_mir.MirOperand = m;
    if (o.kind == codegen_mir.MIR_OP_MEM) {
        o.imm = o.imm + off;
        ret o;
    }
    if (o.kind == codegen_mir.MIR_OP_SYM) {
        o.sym_off = o.sym_off + off;
        ret o;
    }
    ret o;
}

pub fun store_subwidth_vector(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, dest: codegen_mir.MirOperand,
    value: codegen_mir.MirOperand, ty: ir_type.IrTypeId) err[fail.Fail] {
    val mem_w: u8 = mem_width_of(ctx, ty);
    val reg_w: u8 = op_width_of(ctx, ty);
    if (mem_w > reg_w) {
        ret err[fail.Fail].err{fail.message("mir.context.store_subwidth_vector: vector wider than the target's vector register; an over-width vector's placement is a split, not a single move")};
    }
    if (isa.moves_vector_memory(?ctx.tgt.model, mem_w::u32)) {
        val dr: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
        if (sel dr.err) { ret err[fail.Fail].err{fail.refused(dr.err)}; }
        val dops: *codegen_mir.MirOperand = dr.ok;
        dops[0] = dest;
        dops[1] = value;
        var di: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_STORE, dops, 2, mem_w, mem_w);
        di.vec_lane = vec_lane_for_type(ctx, ty);
        ret push_instr(ctx, mb, di);
    }
    val align: u32                                = ir_type.byte_align_for_machine(ctx.types, ty, ctx.layout);
    val skr:   res[codegen_mir.VRegId, fail.Fail] = new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel skr.err) { ret err[fail.Fail].err{skr.err}; }
    val sk: codegen_mir.VRegId = skr.ok;
    val ar: err[fail.Fail]     = add_alloca_slot(ctx, sk.n, reg_w::u64, align, ty::u32);
    if (sel ar.err) { ret ar; }

    val psp: err[fail.Fail] = store_vector_register(ctx, mb, codegen_mir.op_mem_slot(sk, 0), value, ty);
    if (sel psp.err) { ret psp; }

    var off: i64 = 0;
    for (off::u32 < mem_w::u32) {
        val chunk: u8 = copy_chunk_width(ctx.tgt, (mem_w::u32 - off::u32)::u64);

        val tr: res[codegen_mir.VRegId, fail.Fail] = new_vreg(ctx, codegen_mir.REG_CLASS_GP);
        if (sel tr.err) { ret err[fail.Fail].err{tr.err}; }
        val tmp: codegen_mir.VRegId = tr.ok;

        val ld: err[fail.Fail] = emit_load_from_w(ctx, mb, tmp, codegen_mir.op_mem_slot(sk, off), chunk);
        if (sel ld.err) { ret ld; }

        val st: err[fail.Fail] = push_store_chunk(ctx, mb, mem_at(dest, off), codegen_mir.op_vreg(tmp), chunk);
        if (sel st.err) { ret st; }

        off = off + chunk::i64;
    }
    ret err[fail.Fail].ok{};
}

pub fun load_subwidth_vector(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, dst: codegen_mir.MirOperand,
    src: codegen_mir.MirOperand, ty: ir_type.IrTypeId) err[fail.Fail] {
    val mem_w: u8 = mem_width_of(ctx, ty);
    val reg_w: u8 = op_width_of(ctx, ty);
    if (mem_w > reg_w) {
        ret err[fail.Fail].err{fail.message("mir.context.load_subwidth_vector: vector wider than the target's vector register; an over-width vector's placement is a split, not a single move")};
    }
    if (isa.moves_vector_memory(?ctx.tgt.model, mem_w::u32)) {
        val dr: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
        if (sel dr.err) { ret err[fail.Fail].err{fail.refused(dr.err)}; }
        val dops: *codegen_mir.MirOperand = dr.ok;
        dops[0] = dst;
        dops[1] = src;
        var di: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_LOAD, dops, 2, mem_w, mem_w);
        di.vec_lane = vec_lane_for_type(ctx, ty);
        ret push_instr(ctx, mb, di);
    }
    val align: u32                                = ir_type.byte_align_for_machine(ctx.types, ty, ctx.layout);
    val skr:   res[codegen_mir.VRegId, fail.Fail] = new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel skr.err) { ret err[fail.Fail].err{skr.err}; }
    val sk: codegen_mir.VRegId = skr.ok;
    val ar: err[fail.Fail]     = add_alloca_slot(ctx, sk.n, reg_w::u64, align, ty::u32);
    if (sel ar.err) { ret ar; }

    var zoff: i64 = 0;
    for (zoff::u32 < reg_w::u32) {
        val zc: u8             = copy_chunk_width(ctx.tgt, (reg_w::u32 - zoff::u32)::u64);
        val zs: err[fail.Fail] = push_store_chunk(ctx, mb, codegen_mir.op_mem_slot(sk, zoff), codegen_mir.op_imm(0), zc);
        if (sel zs.err) { ret zs; }
        zoff = zoff + zc::i64;
    }

    var off: i64 = 0;
    for (off::u32 < mem_w::u32) {
        val chunk: u8 = copy_chunk_width(ctx.tgt, (mem_w::u32 - off::u32)::u64);

        val tr: res[codegen_mir.VRegId, fail.Fail] = new_vreg(ctx, codegen_mir.REG_CLASS_GP);
        if (sel tr.err) { ret err[fail.Fail].err{tr.err}; }
        val tmp: codegen_mir.VRegId = tr.ok;

        val ld: err[fail.Fail] = emit_load_from_w(ctx, mb, tmp, mem_at(src, off), chunk);
        if (sel ld.err) { ret ld; }

        val st: err[fail.Fail] = push_store_chunk(ctx, mb, codegen_mir.op_mem_slot(sk, off), codegen_mir.op_vreg(tmp), chunk);
        if (sel st.err) { ret st; }

        off = off + chunk::i64;
    }

    val fr: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
    if (sel fr.err) { ret err[fail.Fail].err{fail.refused(fr.err)}; }
    val fops: *codegen_mir.MirOperand = fr.ok;
    fops[0] = dst;
    fops[1] = codegen_mir.op_mem_slot(sk, 0);
    var fi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_LOAD, fops, 2, reg_w, reg_w);
    fi.vec_lane = vec_lane_for_type(ctx, ty);
    ret push_instr(ctx, mb, fi);
}

pub fun subwidth_vector_memory(ctx: *LowerCtx, ty: ir_type.IrTypeId) bool {
    if (!ctx.tgt.model.flat_addressing) { ret false; }
    if (!value_is_vector(ctx, ty))      { ret false; }
    ret mem_width_of(ctx, ty) != op_width_of(ctx, ty);
}

pub fun copy_chunk_width(tgt: *resolved.Target, remaining: u64) u8 {
    var w: u64 = tgt.model.gpr_width::u64;
    for (w > 1) {
        if (remaining >= w) { ret w::u8; }
        w = w / 2;
    }
    ret 1;
}

pub fun emit_bin(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, op: codegen_mir.MirOpcode, dst: codegen_mir.VRegId, a: codegen_mir.MirOperand, b: codegen_mir.MirOperand) err[fail.Fail] {
    ret inst3(ctx, mb, op, codegen_mir.op_vreg(dst), a, b, ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
}

pub fun emit_lea_preg(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, dst: codegen_mir.VRegId, base_preg: codegen_mir.PRegId, disp: i64) err[fail.Fail] {
    ret inst2(ctx, mb, codegen_mir.MIR_GEP, codegen_mir.op_vreg(dst), codegen_mir.op_mem_preg(base_preg, disp), ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
}

pub fun emit_lea_slot(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, mem: codegen_mir.MirOperand, out: *codegen_mir.VRegId) err[fail.Fail] {
    val res_vreg: res[codegen_mir.VRegId, fail.Fail] = new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel res_vreg.err) { ret err[fail.Fail].err{res_vreg.err}; }
    val v: codegen_mir.VRegId = res_vreg.ok;

    val res_emit: err[fail.Fail] = inst2(ctx, mb, codegen_mir.MIR_GEP, codegen_mir.op_vreg(v), mem, ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
    if (sel res_emit.err) { ret res_emit; }
    @out = v;
    ret err[fail.Fail].ok{};
}

pub fun addr_to_vreg(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, argop: codegen_mir.MirOperand, out_vreg: *codegen_mir.VRegId) err[fail.Fail] {
    if (argop.kind == codegen_mir.MIR_OP_VREG) {
        @out_vreg = argop.vreg;
        ret err[fail.Fail].ok{};
    }
    val res_vreg: res[codegen_mir.VRegId, fail.Fail] = new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel res_vreg.err) { ret err[fail.Fail].err{res_vreg.err}; }
    val v: codegen_mir.VRegId = res_vreg.ok;

    val res_emit: err[fail.Fail] = inst2(ctx, mb, codegen_mir.MIR_GEP, codegen_mir.op_vreg(v), argop, ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
    if (sel res_emit.err) { ret res_emit; }
    @out_vreg = v;
    ret err[fail.Fail].ok{};
}

pub fun copy_aggregate(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, dst_mem: codegen_mir.MirOperand, src: codegen_mir.MirOperand, size: u64) err[fail.Fail] {
    var source: codegen_mir.MirOperand = src;
    if (source.kind == codegen_mir.MIR_OP_VREG) { source = codegen_mir.op_mem_value(source.vreg, 0); }
    ret inst3(ctx, mb, codegen_mir.MIR_MEMCPY, dst_mem, source, codegen_mir.op_imm(size::i64),
        ctx.tgt.model.pointer_width::u8, ctx.tgt.model.pointer_width::u8);
}

pub fun alloc_object_storage(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, dst: codegen_mir.VRegId, ty: ir_type.IrTypeId) err[fail.Fail] {
    val res_key: res[codegen_mir.VRegId, fail.Fail] = new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel res_key.err) { ret err[fail.Fail].err{res_key.err}; }
    val sk: codegen_mir.VRegId = res_key.ok;

    val size:     u64            = ir_type.byte_size_for_machine(ctx.types, ty, ctx.layout)::u64;
    val align:    u32            = ir_type.byte_align_for_machine(ctx.types, ty, ctx.layout);
    val res_slot: err[fail.Fail] = add_alloca_slot(ctx, sk.n, size, align, ty);
    if (sel res_slot.err) { ret res_slot; }
    ctx.f.vregs[dst.n].home_key = sk.n;

    ret inst2(ctx, mb, codegen_mir.MIR_ALLOCA, codegen_mir.op_vreg(dst), codegen_mir.op_mem_slot(sk, 0),
        ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
}

pub fun add_alloca_slot(ctx: *LowerCtx, value_id: u32, size: u64, align: u32, ty: u32) err[fail.Fail] {
    var al: u32 = align;
    if (al == 0) { al = 1; }
    var sz: u32 = size::u32;
    if (sz == 0) { sz = al; }
    ret frame_slot_add(ctx, value_id, codegen_mir.SLOT_ALLOCA, sz, al, ty);
}

# record the ir alloca behind the slot just added for `value_id`
pub fun set_slot_origin(ctx: *LowerCtx, value_id: u32, origin: u32) {
    val frame: *codegen_mir.MirFrame = ?ctx.f.frame;
    if (frame.slot_count == 0) { ret; }
    val last: *codegen_mir.MirSlot = ?frame.slots[frame.slot_count - 1];
    if (last.value == value_id) { last.origin = origin; }
}

fun round_up_word(n: u64, word: u64) u64 {
    if (word <= 1) { ret n; }
    ret (n + word - 1) & ~(word - 1);
}

# storage of a given extent, addressed through `dst`: a call's returned object, and the
# home an incoming aggregate assembled from register carriers is written into
pub fun alloc_result_storage(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, dst: codegen_mir.VRegId, size: u64, align: u32) err[fail.Fail] {
    val res_key: res[codegen_mir.VRegId, fail.Fail] = new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel res_key.err) { ret err[fail.Fail].err{res_key.err}; }
    val sk: codegen_mir.VRegId = res_key.ok;

    val res_slot: err[fail.Fail] = add_spill_slot_aligned(ctx, sk.n, size, align);
    if (sel res_slot.err) { ret res_slot; }
    ctx.f.vregs[dst.n].home_key = sk.n;

    ret inst2(ctx, mb, codegen_mir.MIR_ALLOCA, codegen_mir.op_vreg(dst), codegen_mir.op_mem_slot(sk, 0), ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
}

fun defines_value(ctx: *LowerCtx, inst: *ir_instruction.Instruction) bool {
    if (opdesc.is_terminator(inst.kind))      { ret false; }
    if (inst.kind == ir_instruction.OP_STORE) { ret false; }
    val opt_type: opt[*ir_type.IrType] = ir_type.get(ctx.types, inst.ty);
    if (sel opt_type.some) {
        val t: *ir_type.IrType = opt_type.some;
        if (t.kind == ir_type.IRT_VOID) { ret false; }
    }
    ret true;
}

fun param_vreg(ctx: *LowerCtx, ix: u32) codegen_mir.VRegId {
    if (ctx.param_vregs == nil) { ret codegen_mir.MIR_VREG_NIL; }
    if (ix >= ctx.param_count)  { ret codegen_mir.MIR_VREG_NIL; }
    ret ctx.param_vregs[ix];
}

fun reg_class_of(ctx: *LowerCtx, tgt: *resolved.Target, ty: ir_type.IrTypeId) u32 {
    if (values_convention(ctx)) { ret codegen_mir.REG_CLASS_VALUE; }
    val opt_type: opt[*ir_type.IrType] = ir_type.get(ctx.types, ty);
    if (sel opt_type.some) {
        val t: *ir_type.IrType = opt_type.some;
        if (t.kind == ir_type.IRT_FLOAT || t.kind == ir_type.IRT_VECTOR) {
            ret fp_class_index(tgt);
        }
    }
    ret gp_class_index(tgt);
}

fun fp_class_index(tgt: *resolved.Target) u32 {
    var ci: u32 = 0;
    for (ci < tgt.model.reg_class_len) {
        if (tgt.model.reg_classes[ci].kind == isa.RC_FLOAT) {
            ret ci;
        }
        ci = ci + 1;
    }
    panic("mir.lower_ir: target has no float/vector register bank\n");
    ret codegen_mir.REG_CLASS_GP;
}

fun gp_class_index(tgt: *resolved.Target) u32 {
    var ci: u32 = 0;
    for (ci < tgt.model.reg_class_len) {
        if (tgt.model.reg_classes[ci].kind == isa.RC_GENERAL) {
            ret ci;
        }
        ci = ci + 1;
    }
    panic("mir.lower_ir: target has no general-purpose register bank\n");
    ret codegen_mir.REG_CLASS_GP;
}

pub fun add_spill_slot_aligned(ctx: *LowerCtx, value_id: u32, size: u64, align: u32) err[fail.Fail] {
    var al: u32 = align;
    if (al == 0) { al = 1; }
    var sz: u32 = round_up_word(size, ctx.tgt.model.gpr_width::u64)::u32;
    if (sz == 0) { sz = al; }
    ret frame_slot_add(ctx, value_id, codegen_mir.SLOT_SPILL, sz, al, codegen_mir.SLOT_TY_NIL);
}

fun frame_slot_add(ctx: *LowerCtx, value_id: u32, kind: codegen_mir.MirSlotKind, size: u32, align: u32, ty: u32) err[fail.Fail] {
    val f:     *codegen_mir.MirFunction = ctx.f;
    val frame: *codegen_mir.MirFrame    = ?f.frame;
    if (frame.slot_count >= frame.slot_cap) {
        var new_cap: u32 = frame.slot_cap * 2;
        if (new_cap < codegen_mir.INITIAL_SLOT_CAP) { new_cap = codegen_mir.INITIAL_SLOT_CAP; }
        val res_slots: res[*codegen_mir.MirSlot, A.Error] = A.reallocate[codegen_mir.MirSlot](ctx.alloc, frame.slots, frame.slot_cap::usize, new_cap::usize);
        if (sel res_slots.err) { ret err[fail.Fail].err{fail.refused(res_slots.err)}; }
        frame.slots    = res_slots.ok;
        frame.slot_cap = new_cap;
    }
    val si: u32 = frame.slot_count;
    frame.slots[si].value  = value_id;
    frame.slots[si].kind   = kind;
    frame.slots[si].offset = 0;
    frame.slots[si].size   = size;
    frame.slots[si].align  = align;
    frame.slots[si].ty     = ty;
    frame.slots[si].origin = codegen_mir.SLOT_ORIGIN_NIL;
    frame.slot_count       = frame.slot_count + 1;
    ret err[fail.Fail].ok{};
}

fun inst2(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, opcode: codegen_mir.MirOpcode, op0: codegen_mir.MirOperand, op1: codegen_mir.MirOperand,
    width: u8, src_width: u8) err[fail.Fail] {
    val res_ops: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
    if (sel res_ops.err) { ret err[fail.Fail].err{fail.refused(res_ops.err)}; }
    val ops: *codegen_mir.MirOperand = res_ops.ok;
    ops[0] = op0;
    ops[1] = op1;
    var mi: codegen_mir.MirInstr = codegen_mir.instr(opcode, ops, 2, width, src_width);
    ret push_instr(ctx, mb, mi);
}

fun inst3(ctx: *LowerCtx, mb: *codegen_mir.MirBlock, opcode: codegen_mir.MirOpcode, op0: codegen_mir.MirOperand, op1: codegen_mir.MirOperand,
    op2: codegen_mir.MirOperand, width: u8, src_width: u8) err[fail.Fail] {
    val res_ops: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 3::usize);
    if (sel res_ops.err) { ret err[fail.Fail].err{fail.refused(res_ops.err)}; }
    val ops: *codegen_mir.MirOperand = res_ops.ok;
    ops[0] = op0;
    ops[1] = op1;
    ops[2] = op2;
    var mi: codegen_mir.MirInstr = codegen_mir.instr(opcode, ops, 3, width, src_width);
    ret push_instr(ctx, mb, mi);
}

test stack_slot_bytes__rounds_up_to_the_word {
    var w4: resolved.Target;
    w4.model.gpr_width = 4;
    if (stack_slot_bytes(?w4, 0) != 4) { ret 1; }
    if (stack_slot_bytes(?w4, 4) != 4) { ret 2; }
    if (stack_slot_bytes(?w4, 5) != 8) { ret 3; }
    ret 0;
}

test copy_chunk_width__largest_power_of_two_that_fits {
    var w8: resolved.Target;
    w8.model.gpr_width = 8;
    if (copy_chunk_width(?w8, 16) != 8) { ret 1; }
    if (copy_chunk_width(?w8, 7) != 4)  { ret 2; }
    if (copy_chunk_width(?w8, 1) != 1)  { ret 3; }
    ret 0;
}

test vector_value__class_width_and_store {
    var alloc: A.Allocator;
    page.make(?alloc);
    var types: ir_type.IrTypeTable;
    val r_828: err[fail.Fail] = ir_type.init(?types, ?alloc);
    if (sel r_828.err) { ret 1; }

    var classes: [2]isa.RegClass;
    classes[0].kind = isa.RC_GENERAL;
    classes[1].kind = isa.RC_FLOAT;
    var arch: isa.IsaVTable = isa.machine_isa(isa.ARCH_UNKNOWN, "machine", 0, 8,
        nil, nil, nil);
    var tgt: resolved.Target;
    tgt.isa                   = ?arch;
    tgt.model.reg_classes     = ?classes[0];
    tgt.model.reg_class_len   = 2;
    tgt.model.gpr_width       = 8;
    tgt.model.vector_bits     = 128;
    tgt.model.vector_op_bytes = 16;

    var ctx: LowerCtx;
    ctx.alloc = ?alloc;
    ctx.types = ?types;
    var convention: abi.AbiVTable = target_testing.carriers_convention();
    tgt.abi    = ?convention;
    ctx.tgt    = ?tgt;
    ctx.layout = resolved.layout_machine(?tgt);

    val ef: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_float(?types, 32);
    if (sel ef.err) {
        ir_type.dnit(?types);
        ret 1;
    }
    val vr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?types, ef.ok, 4);
    if (sel vr.err) {
        ir_type.dnit(?types);
        ret 1;
    }
    val vecty: ir_type.IrTypeId = vr.ok;

    val ir: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 32);
    if (sel ir.err) {
        ir_type.dnit(?types);
        ret 1;
    }
    val i32ty: ir_type.IrTypeId = ir.ok;

    val i16r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 16);
    if (sel i16r.err) {
        ir_type.dnit(?types);
        ret 1;
    }
    val narrowr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?types, i16r.ok, 4);
    if (sel narrowr.err) {
        ir_type.dnit(?types);
        ret 1;
    }
    val narrowty: ir_type.IrTypeId = narrowr.ok;

    if (reg_class_of(?ctx, ?tgt, vecty) != fp_class_index(?tgt)) {
        ir_type.dnit(?types);
        ret 1;
    }
    if (op_width_of(?ctx, vecty) != 16) {
        ir_type.dnit(?types);
        ret 1;
    }
    if (!value_is_vector(?ctx, vecty)) {
        ir_type.dnit(?types);
        ret 1;
    }

    var mb: codegen_mir.MirBlock;
    val sr: err[fail.Fail] = store_vector_register(?ctx, ?mb, codegen_mir.op_mem_slot(codegen_mir.vreg_id(1), 0), codegen_mir.op_vreg(codegen_mir.vreg_id(2)), narrowty);
    if (sel sr.err) {
        ir_type.dnit(?types);
        ret 1;
    }
    if (mb.instr_count != 1) {
        ir_type.dnit(?types);
        ret 1;
    }
    if (mb.instrs[0].opcode != codegen_mir.MIR_STORE) {
        ir_type.dnit(?types);
        ret 1;
    }
    if (mb.instrs[0].width != 16 || mb.instrs[0].src_width != 16) {
        ir_type.dnit(?types);
        ret 1;
    }

    if (mem_width_of(?ctx, vecty) != 16) {
        ir_type.dnit(?types);
        ret 1;
    }
    if (mem_width_of(?ctx, i32ty) != 4) {
        ir_type.dnit(?types);
        ret 1;
    }

    if (reg_class_of(?ctx, ?tgt, i32ty) != gp_class_index(?tgt)) {
        ir_type.dnit(?types);
        ret 1;
    }
    if (op_width_of(?ctx, i32ty) != 4) {
        ir_type.dnit(?types);
        ret 1;
    }
    if (value_is_vector(?ctx, i32ty)) {
        ir_type.dnit(?types);
        ret 1;
    }

    ir_type.dnit(?types);
    ret 0;
}

test op_width_of__is_a_fact_about_the_value {
    var alloc: A.Allocator;
    page.make(?alloc);
    var types: ir_type.IrTypeTable;
    val r_902: err[fail.Fail] = ir_type.init(?types, ?alloc);
    if (sel r_902.err) { ret 1; }

    var classes: [1]isa.RegClass;
    classes[0].kind = isa.RC_GENERAL;

    var model: isa.MachineModel;
    var arch:  isa.IsaVTable = isa.machine_isa(0, "probe", 0, 8, ?model, nil, nil);
    var tgt:   resolved.Target;
    tgt.isa                 = ?arch;
    tgt.model.reg_classes   = ?classes[0];
    tgt.model.reg_class_len = 1;
    var ctx: LowerCtx;
    ctx.types = ?types;
    var convention: abi.AbiVTable = target_testing.carriers_convention();
    tgt.abi    = ?convention;
    ctx.tgt    = ?tgt;
    ctx.layout = resolved.layout_machine(?tgt);

    var ids:  [4]ir_type.IrTypeId;
    var bits: [4]u32;
    bits[0] = 8;
    bits[1] = 16;
    bits[2] = 32;
    bits[3] = 64;
    var i: u32 = 0;
    for (i < 4) {
        val r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, bits[i]);
        if (sel r.err) {
            ir_type.dnit(?types);
            ret 1;
        }
        ids[i] = r.ok;
        i      = i + 1;
    }

    var words: [2]u32;
    words[0] = 8;
    words[1] = 1;
    var ptrs: [2]u32;
    ptrs[0] = 8;
    ptrs[1] = 2;
    var w: u32 = 0;
    for (w < 2) {
        tgt.model.gpr_width = words[w];
        arch.pointer_width  = ptrs[w];
        i                   = 0;
        for (i < 4) {
            if (op_width_of(?ctx, ids[i])::u32 != bits[i] / 8) {
                ir_type.dnit(?types);
                ret 1;
            }
            i = i + 1;
        }
        w = w + 1;
    }

    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?types);
    if (sel rv.err) {
        ir_type.dnit(?types);
        ret 1;
    }
    val voidty: ir_type.IrTypeId = rv.ok;
    tgt.model.gpr_width = 8;
    if (op_width_of(?ctx, voidty) != 8) {
        ir_type.dnit(?types);
        ret 1;
    }
    tgt.model.gpr_width = 1;
    if (op_width_of(?ctx, voidty) != 1) {
        ir_type.dnit(?types);
        ret 1;
    }

    ir_type.dnit(?types);
    ret 0;
}

test lower_value__unsupported_and_unknown_kinds_are_distinct_failures {
    var alloc: A.Allocator;
    page.make(?alloc);
    var types:  ir_type.IrTypeTable;
    val r_init: err[fail.Fail] = ir_type.init(?types, ?alloc);
    if (sel r_init.err) { ret 1; }
    var ctx: LowerCtx;
    ctx.alloc    = ?alloc;
    ctx.types    = ?types;
    ctx.interner = nil;
    ctx.diags    = nil;

    var code:  i32                                    = 0;
    val int_r: res[codegen_mir.MirOperand, fail.Fail] = lower_value(?ctx, value.const_int(7, ir_type.IRT_NIL));
    if (sel int_r.err) { code = 2; }

    var bytes_v: value.Value;
    bytes_v.kind = value.VAL_CONST_BYTES;
    val bytes_r: res[codegen_mir.MirOperand, fail.Fail] = lower_value(?ctx, bytes_v);
    if (sel bytes_r.ok) { code = 3; }
    or (sel bytes_r.err) {
        if (!str_contains(fail.describe(bytes_r.err), "ValueKind const_bytes is unsupported")) { code = 4; }
    }

    var bogus: value.Value;
    bogus.kind = 255::value.ValueKind;
    val bogus_r: res[codegen_mir.MirOperand, fail.Fail] = lower_value(?ctx, bogus);
    if (sel bogus_r.ok) { code = 5; }
    or (sel bogus_r.err) {
        if (!str_contains(fail.describe(bogus_r.err), "unknown ValueKind tag")) { code = 6; }
    }
    ir_type.dnit(?types);
    ret code;
}
