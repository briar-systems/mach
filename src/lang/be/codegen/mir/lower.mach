pub fun lower_module(tgt: *resolved.Target, m: *me_ir.Module, alloc: *A.Allocator, interner: *intern.Interner, srcmap: *lang_source.SourceMap,
    diags: *diagnostic.DiagnosticStore) res[codegen_mir.MirModule, fail.Fail] {
    if (tgt == nil || m == nil) {
        ret res[codegen_mir.MirModule, fail.Fail].err{fail.message("mir.lower_ir: nil target or module")};
    }

    var mm: codegen_mir.MirModule;
    mm.alloc        = alloc;
    mm.interner     = interner;
    mm.srcmap       = srcmap;
    mm.diags        = diags;
    mm.functions    = nil;
    mm.function_len = 0;
    mm.function_cap = 0;

    val rf: res[*codegen_mir.MirFunction, A.Error] = A.allocate[codegen_mir.MirFunction](alloc, codegen_mir.INITIAL_FN_CAP::usize);
    if (sel rf.err) {
        ret res[codegen_mir.MirModule, fail.Fail].err{fail.refused(rf.err)};
    }
    mm.functions    = rf.ok;
    mm.function_cap = codegen_mir.INITIAL_FN_CAP;

    var fi: u32 = 0;
    for (fi < m.function_len) {
        val lf: res[codegen_mir.MirFunction, fail.Fail] = lower_function(tgt, m, ?m.functions[fi], alloc, interner, diags);
        if (sel lf.err) {
            codegen_mir.dnit_module(?mm);
            ret res[codegen_mir.MirModule, fail.Fail].err{lf.err};
        }
        val push: err[fail.Fail] = codegen_mir.push_function(?mm, lf.ok);
        if (sel push.err) {
            codegen_mir.dnit_module(?mm);
            ret res[codegen_mir.MirModule, fail.Fail].err{push.err};
        }
        fi = fi + 1;
    }

    ret res[codegen_mir.MirModule, fail.Fail].ok{mm};
}

fun lower_function(tgt: *resolved.Target, m: *me_ir.Module, fn: *me_ir.Function, alloc: *A.Allocator, interner: *intern.Interner,
    diags: *diagnostic.DiagnosticStore) res[codegen_mir.MirFunction, fail.Fail] {
    var mf: codegen_mir.MirFunction;
    mf.name                 = fn.name;
    mf.blocks               = nil;
    mf.block_count          = 0;
    mf.block_cap            = 0;
    mf.vregs                = nil;
    mf.vreg_count           = 0;
    mf.vreg_cap             = 0;
    mf.abi_inputs           = nil;
    mf.abi_input_count      = 0;
    mf.abi_input_cap        = 0;
    mf.frame.slots          = nil;
    mf.frame.slot_count     = 0;
    mf.frame.slot_cap       = 0;
    mf.frame.size           = 0;
    mf.frame.align          = 0;
    mf.frame.outgoing_size  = 0;
    mf.frame.outgoing_align = 0;
    mf.frame.realign        = 0;
    mf.frame.base_dist      = 0;
    mf.frame.fp_dist        = 0;
    mf.frame.omit           = false;
    mf.frame.sp_frame       = false;
    mf.frame.sp_fixed       = false;
    mf.frame.opaque         = false;
    mf.callee_mask          = 0;
    mf.callee_mask_fp       = 0;
    mf.oblivious            = (fn.flags & me_ir.FN_FLAG_OBLIVIOUS) != 0;
    mf.naked                = (fn.flags & me_ir.FN_FLAG_NAKED) != 0;
    mf.extensions           = fn.extensions;
    mf.align                = fn.align;
    mf.needs_dit            = false;
    mf.decl_loc             = fn.decl_loc;

    if ((fn.flags & me_ir.FN_FLAG_EXTERN) != 0 || fn.block_count == 0) {
        ret res[codegen_mir.MirFunction, fail.Fail].ok{mf};
    }

    val rv: res[*codegen_mir.MirVReg, A.Error] = A.allocate[codegen_mir.MirVReg](alloc, codegen_mir.INITIAL_VREG_CAP::usize);
    if (sel rv.err) {
        ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(rv.err)};
    }
    mf.vregs    = rv.ok;
    mf.vreg_cap = codegen_mir.INITIAL_VREG_CAP;

    var ctx: mir_context.LowerCtx;
    ctx.alloc             = alloc;
    ctx.tgt               = tgt;
    ctx.layout            = resolved.layout_machine(tgt);
    ctx.m                 = m;
    ctx.types             = ?m.types;
    ctx.fn                = fn;
    ctx.f                 = ?mf;
    ctx.param_vregs       = nil;
    ctx.param_count       = fn.param_count;
    ctx.instr_vregs       = nil;
    ctx.slot_key_vregs    = nil;
    ctx.gep_fold          = nil;
    ctx.gep_mem           = nil;
    ctx.count_mask_fold   = nil;
    ctx.instr_count       = fn.instr_len;
    ctx.interner          = interner;
    ctx.diags             = diags;
    ctx.sret_vreg         = codegen_mir.MIR_VREG_NIL;
    ctx.result_image      = ir_id.INSTR_NIL;
    ctx.result_in_place   = false;
    ctx.in_tail           = false;
    ctx.tail_call         = ir_id.INSTR_NIL;
    ctx.cur_loc           = lang_source.loc_nil();
    ctx.cur_inline_site   = 0;
    ctx.cur_vec_lane      = codegen_mir.VEC_LANE_NONE;
    ctx.cur_writes_secret = false;
    ctx.cur_memory_flags  = 0;
    ctx.pending           = nil;
    ctx.pending_count     = 0;
    ctx.pending_cap       = 0;
    ctx.max_block_id      = 0;

    val widths: err[fail.Fail] = check_signature_int_widths(?ctx, fn);
    if (sel widths.err) {
        mir_context.ctx_dnit(?ctx);
        codegen_mir.dnit_function(alloc, ?mf);
        ret res[codegen_mir.MirFunction, fail.Fail].err{widths.err};
    }

    val setup: err[fail.Fail] = mir_context.ctx_setup(?ctx, tgt, fn);
    if (sel setup.err) {
        mir_context.ctx_dnit(?ctx);
        codegen_mir.dnit_function(alloc, ?mf);
        ret res[codegen_mir.MirFunction, fail.Fail].err{setup.err};
    }

    val rb: res[*codegen_mir.MirBlock, A.Error] = A.allocate[codegen_mir.MirBlock](alloc, fn.block_count::usize);
    if (sel rb.err) {
        mir_context.ctx_dnit(?ctx);
        codegen_mir.dnit_function(alloc, ?mf);
        ret res[codegen_mir.MirFunction, fail.Fail].err{fail.refused(rb.err)};
    }
    mf.blocks    = rb.ok;
    mf.block_cap = fn.block_count;

    mir_context.seed_gep_mems(?ctx, fn, pure_gep_mem);

    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val is_entry: bool           = bi == 0;
        val lb:       err[fail.Fail] = lower_block(?ctx, fn, ?fn.blocks[bi], is_entry);
        if (sel lb.err) {
            mir_context.ctx_dnit(?ctx);
            codegen_mir.dnit_function(alloc, ?mf);
            ret res[codegen_mir.MirFunction, fail.Fail].err{lb.err};
        }
        bi = bi + 1;
    }

    val lph: err[fail.Fail] = lower_phis(?ctx, fn);
    if (sel lph.err) {
        mir_context.ctx_dnit(?ctx);
        codegen_mir.dnit_function(alloc, ?mf);
        ret res[codegen_mir.MirFunction, fail.Fail].err{lph.err};
    }

    val lbk: err[fail.Fail] = bulk.expand(?ctx);
    if (sel lbk.err) {
        mir_context.ctx_dnit(?ctx);
        codegen_mir.dnit_function(alloc, ?mf);
        ret res[codegen_mir.MirFunction, fail.Fail].err{lbk.err};
    }

    mir_context.ctx_dnit(?ctx);
    ret res[codegen_mir.MirFunction, fail.Fail].ok{mf};
}

fun lower_block(ctx: *mir_context.LowerCtx, fn: *me_ir.Function, blk: *me_ir.Block, is_entry: bool) err[fail.Fail] {
    val f:  *codegen_mir.MirFunction = ctx.f;
    val mb: *codegen_mir.MirBlock    = ?f.blocks[f.block_count];
    mb.id = blk.id::u32;
    if (mb.id > ctx.max_block_id) { ctx.max_block_id = mb.id; }
    mb.instrs      = nil;
    mb.instr_count = 0;
    mb.instr_cap   = 0;
    mb.preds       = nil;
    mb.pred_count  = 0;
    mb.pred_cap    = 0;
    f.block_count  = f.block_count + 1;

    val cp: err[fail.Fail] = copy_preds(ctx, mb, blk);
    if (sel cp.err) { ret cp; }

    if (is_entry) {
        val lp: err[fail.Fail] = mir_abi.lower_params(ctx, mb);
        if (sel lp.err) { ret lp; }
    }

    var ii: u32 = 0;
    for (ii < blk.instr_count) {
        val ei: err[fail.Fail] = lower_instr(ctx, fn, mb, blk.instructions[ii]);
        if (sel ei.err) { ret ei; }
        ii = ii + 1;
    }

    if (blk.terminator != ir_id.INSTR_NIL) {
        val et: err[fail.Fail] = lower_instr(ctx, fn, mb, blk.terminator);
        if (sel et.err) { ret et; }
    }

    if (ctx.pending_count > 0 && mb.instr_count > 0) {
        val fl: err[fail.Fail] = mir_context.drain_pending_dbg(ctx, ?mb.instrs[mb.instr_count - 1]);
        if (sel fl.err) { ret fl; }
    }
    ctx.pending_count = 0;

    ret err[fail.Fail].ok{};
}

# whether `mi` writes `v` as its destination
fun instr_defines_vreg(mi: *codegen_mir.MirInstr, v: codegen_mir.VRegId) bool {
    if (!codegen_mir.instr_defines_shape(mi))           { ret false; }
    if (mi.operands[0].kind != codegen_mir.MIR_OP_VREG) { ret false; }
    ret codegen_mir.vreg_same(mi.operands[0].vreg, v);
}

fun copy_preds(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, blk: *me_ir.Block) err[fail.Fail] {
    if (blk.pred_count == 0) { ret err[fail.Fail].ok{}; }
    val r: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, blk.pred_count::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    mb.preds    = r.ok;
    mb.pred_cap = blk.pred_count;
    var i: u32 = 0;
    for (i < blk.pred_count) {
        mb.preds[i] = blk.preds[i]::u32;
        i           = i + 1;
    }
    mb.pred_count = blk.pred_count;
    ret err[fail.Fail].ok{};
}

fun lower_phis(ctx: *mir_context.LowerCtx, fn: *me_ir.Function) err[fail.Fail] {
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *me_ir.Block = ?fn.blocks[bi];
        if (blk.phi_count > 0) {
            val r: err[fail.Fail] = lower_block_phis(ctx, fn, blk);
            if (sel r.err) { ret r; }
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun lower_block_phis(ctx: *mir_context.LowerCtx, fn: *me_ir.Function, blk: *me_ir.Block) err[fail.Fail] {
    val np: u32                               = blk.phi_count;
    val rd: res[*codegen_mir.VRegId, A.Error] = A.allocate[codegen_mir.VRegId](ctx.alloc, np::usize);
    if (sel rd.err) { ret err[fail.Fail].err{fail.refused(rd.err)}; }
    val dsts: *codegen_mir.VRegId                   = rd.ok;
    val rs:   res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, np::usize);
    if (sel rs.err) {
        A.deallocate[codegen_mir.VRegId](ctx.alloc, dsts, np::usize);
        ret err[fail.Fail].err{fail.refused(rs.err)};
    }
    val srcs: *codegen_mir.MirOperand = rs.ok;
    val rw:   res[*u8, A.Error]       = A.allocate[u8](ctx.alloc, np::usize);
    if (sel rw.err) {
        A.deallocate[codegen_mir.VRegId](ctx.alloc, dsts, np::usize);
        A.deallocate[codegen_mir.MirOperand](ctx.alloc, srcs, np::usize);
        ret err[fail.Fail].err{fail.refused(rw.err)};
    }
    val wids: *u8 = rw.ok;

    var failure: err[fail.Fail] = err[fail.Fail].ok{};
    var pi:      u32            = 0;
    for (pi < blk.pred_count && sel failure.ok) {
        val pred_id: u32                   = blk.preds[pi]::u32;
        var pred_mb: *codegen_mir.MirBlock = mir_block_by_id(ctx.f, pred_id);
        if (pred_mb == nil) {
            failure = err[fail.Fail].err{fail.message("mir.lower_ir: phi predecessor block has no MIR block")};
            pi      = pi + 1;
            cnt;
        }

        if (block_ends_in_cbr(pred_mb)) {
            val sr: res[*codegen_mir.MirBlock, fail.Fail] = split_critical_edge(ctx, pred_mb, blk.id::u32);
            if (sel sr.err) {
                failure = err[fail.Fail].err{sr.err};
                pi      = pi + 1;
                cnt;
            }
            pred_mb = sr.ok;
        }

        var nc: u32 = 0;
        var hi: u32 = 0;
        for (hi < blk.phi_count && sel failure.ok) {
            val phi_opt: opt[*ir_instruction.Instruction] = me_ir.instruction_get(fn, blk.phis[hi]);
            if (!sel phi_opt.some) {
                failure = err[fail.Fail].err{fail.message("mir.lower_ir: dangling phi instruction id")};
                hi      = hi + 1;
                cnt;
            }
            val phi:      *ir_instruction.Instruction = phi_opt.some;
            val dst_vreg: codegen_mir.VRegId          = mir_context.instr_vreg(ctx, blk.phis[hi]);
            if (codegen_mir.vreg_is_nil(dst_vreg)) {
                failure = err[fail.Fail].err{fail.message("mir.lower_ir: phi defines no result vreg")};
                hi      = hi + 1;
                cnt;
            }
            var found: bool = false;
            var k:     u32  = 0;
            for (k + 1 < phi.operand_count && found == false) {
                if (phi.operands[k].data.int_lit::u32 == pred_id) {
                    dsts[nc] = dst_vreg;
                    val lowered_1: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, phi.operands[k + 1]);
                    if (sel lowered_1.err) { ret err[fail.Fail].err{lowered_1.err}; }
                    srcs[nc] = lowered_1.ok;
                    wids[nc] = mir_context.op_width_of(ctx, phi.ty);
                    nc       = nc + 1;
                    found    = true;
                }
                k = k + 2;
            }
            if (!found) {
                failure = err[fail.Fail].err{fail.message(phi_edge_err(ctx, blk.id::u32, pred_id, dst_vreg))};
                hi      = hi + 1;
                cnt;
            }
            hi = hi + 1;
        }

        if (sel failure.ok && nc > 0) {
            val r: err[fail.Fail] = emit_edge_copies(ctx, pred_mb, dsts, srcs, wids, nc);
            if (sel r.err) { failure = err[fail.Fail].err{r.err}; }
        }
        pi = pi + 1;
    }

    A.deallocate[codegen_mir.VRegId](ctx.alloc, dsts, np::usize);
    A.deallocate[codegen_mir.MirOperand](ctx.alloc, srcs, np::usize);
    A.deallocate[u8](ctx.alloc, wids, np::usize);
    ret failure;
}

fun phi_edge_err(ctx: *mir_context.LowerCtx, block_id: u32, pred_id: u32, dst_vreg: codegen_mir.VRegId) str {
    val fallback: str                              = "mir.lower_ir: phi has no incoming value for a predecessor edge";
    val rj:       res[str, std_format.FormatError] = std_format.sprint(ctx.alloc,
        "mir.lower_ir: phi in block {} has no incoming value for predecessor block {} (result vreg {})",
        block_id, pred_id, dst_vreg.n);
    if (sel rj.err) { ret fallback; }
    ret rj.ok;
}

# lowering keeps a block's index equal to its id (IR blocks in order, then
# fresh ids past the largest), so the direct slot is checked first and the
# scan covers any function shaped otherwise
fun mir_block_by_id(f: *codegen_mir.MirFunction, block_id: u32) *codegen_mir.MirBlock {
    if (block_id < f.block_count && f.blocks[block_id].id == block_id) { ret ?f.blocks[block_id]; }
    var bi: u32 = 0;
    for (bi < f.block_count) {
        if (f.blocks[bi].id == block_id) { ret ?f.blocks[bi]; }
        bi = bi + 1;
    }
    ret nil;
}

fun emit_edge_copies(ctx: *mir_context.LowerCtx, pred_mb: *codegen_mir.MirBlock, dsts: *codegen_mir.VRegId, srcs: *codegen_mir.MirOperand, wids: *u8, n: u32) err[fail.Fail] {
    val re: res[*bool, A.Error] = A.allocate[bool](ctx.alloc, n::usize);
    if (sel re.err) { ret err[fail.Fail].err{fail.refused(re.err)}; }
    val done: *bool = re.ok;

    var remaining: u32 = 0;
    var i:         u32 = 0;
    for (i < n) {
        if (srcs[i].kind == codegen_mir.MIR_OP_VREG && codegen_mir.vreg_same(srcs[i].vreg, dsts[i])) {
            done[i] = true;
        }
        or {
            done[i]   = false;
            remaining = remaining + 1;
        }
        i = i + 1;
    }

    var failure: err[fail.Fail] = err[fail.Fail].ok{};
    for (remaining > 0 && sel failure.ok) {
        var progressed: bool = false;
        var j:          u32  = 0;
        for (j < n) {
            if (done[j] == false && !dst_is_pending_src(dsts, srcs, done, n, dsts[j])) {
                val mv: err[fail.Fail] = insert_mov_before_terminator(ctx, pred_mb,
                    codegen_mir.op_vreg(dsts[j]), srcs[j], wids[j]);
                if (sel mv.err) {
                    failure = err[fail.Fail].err{mv.err};
                    j       = n;
                    cnt;
                }
                done[j]    = true;
                remaining  = remaining - 1;
                progressed = true;
            }
            j = j + 1;
        }

        if (sel failure.ok && progressed == false && remaining > 0) {
            var c: u32 = 0;
            for (done[c]) { c = c + 1; }
            val freed: codegen_mir.VRegId                 = dsts[c];
            val cls:   u32                                = ctx.f.vregs[freed.n].class;
            val tr:    res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg_vec(ctx, cls, ctx.f.vregs[freed.n].vec_bytes);
            if (sel tr.err) {
                failure = err[fail.Fail].err{tr.err};
                cnt;
            }
            val tmp: codegen_mir.VRegId = tr.ok;
            ctx.f.vregs[tmp.n].ty = ctx.f.vregs[freed.n].ty;
            val sv: err[fail.Fail] = insert_mov_before_terminator(ctx, pred_mb,
                codegen_mir.op_vreg(tmp), codegen_mir.op_vreg(freed), ctx.tgt.model.gpr_width::u8);
            if (sel sv.err) {
                failure = err[fail.Fail].err{sv.err};
                cnt;
            }
            var d: u32 = 0;
            for (d < n) {
                if (done[d] == false && srcs[d].kind == codegen_mir.MIR_OP_VREG && codegen_mir.vreg_same(srcs[d].vreg, freed)) {
                    srcs[d] = codegen_mir.op_vreg(tmp);
                }
                d = d + 1;
            }
        }
    }

    A.deallocate[bool](ctx.alloc, done, n::usize);
    ret failure;
}

fun dst_is_pending_src(dsts: *codegen_mir.VRegId, srcs: *codegen_mir.MirOperand, done: *bool, n: u32, v: codegen_mir.VRegId) bool {
    var i: u32 = 0;
    for (i < n) {
        if (done[i] == false && srcs[i].kind == codegen_mir.MIR_OP_VREG && codegen_mir.vreg_same(srcs[i].vreg, v)) {
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun imm_merge_width(ctx: *mir_context.LowerCtx, wid: u8) u8 {
    if (wid == 4) { ret 4; }
    var w: u8 = ctx.tgt.model.gpr_width::u8;
    if (wid > w) { w = wid; }
    ret w;
}

fun insert_mov_before_terminator(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, dst: codegen_mir.MirOperand, src: codegen_mir.MirOperand, wid: u8) err[fail.Fail] {
    if (mb.instr_count == 0) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: phi predecessor block has no terminator")};
    }
    val term: *codegen_mir.MirInstr = ?mb.instrs[mb.instr_count - 1];
    if (!is_mir_terminator(term.opcode)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: phi predecessor block does not end in a terminator")};
    }

    val r: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *codegen_mir.MirOperand = r.ok;
    ops[0] = dst;
    ops[1] = src;
    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_MOV, ops, 2, 0, 0);
    if (src.kind == codegen_mir.MIR_OP_SYM) { mi.opcode = codegen_mir.MIR_GEP; }
    var copy_w: u8 = ctx.tgt.model.gpr_width::u8;
    if (wid > copy_w) { copy_w = wid; }
    mi.width     = copy_w;
    mi.src_width = copy_w;
    if (src.kind == codegen_mir.MIR_OP_IMM) {
        val iw: u8 = imm_merge_width(ctx, wid);
        mi.width     = iw;
        mi.src_width = iw;
    }
    or (dst.kind == codegen_mir.MIR_OP_VREG && dst.vreg.n < ctx.f.vreg_count && ctx.f.vregs[dst.vreg.n].vec_bytes != 0) {
        mi.width     = ctx.f.vregs[dst.vreg.n].vec_bytes;
        mi.src_width = ctx.f.vregs[dst.vreg.n].vec_bytes;
    }
    mi.loc           = term.loc;
    mi.inline_site   = term.inline_site;
    mi.writes_secret = false;

    val gr: err[fail.Fail] = mir_context.grow_instr(ctx, mb);
    if (sel gr.err) {
        A.deallocate[codegen_mir.MirOperand](ctx.alloc, ops, 2::usize);
        ret gr;
    }
    mb.instrs[mb.instr_count]     = mb.instrs[mb.instr_count - 1];
    mb.instrs[mb.instr_count - 1] = mi;
    mb.instr_count                = mb.instr_count + 1;
    ret err[fail.Fail].ok{};
}

fun is_mir_terminator(o: codegen_mir.MirOpcode) bool {
    ret codegen_mir.is_terminator(o);
}

fun block_ends_in_cbr(mb: *codegen_mir.MirBlock) bool {
    if (mb.instr_count == 0) { ret false; }
    ret mb.instrs[mb.instr_count - 1].opcode == codegen_mir.MIR_CBR;
}

fun grow_block(ctx: *mir_context.LowerCtx) err[fail.Fail] {
    val f: *codegen_mir.MirFunction = ctx.f;
    if (f.block_count >= f.block_cap) {
        var new_cap: u32 = f.block_cap * 2;
        if (new_cap < f.block_count + 1) { new_cap = f.block_count + 1; }
        val r: res[*codegen_mir.MirBlock, A.Error] = A.reallocate[codegen_mir.MirBlock](ctx.alloc, f.blocks, f.block_cap::usize, new_cap::usize);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        f.blocks    = r.ok;
        f.block_cap = new_cap;
    }
    ret err[fail.Fail].ok{};
}

fun fresh_block_id(ctx: *mir_context.LowerCtx) u32 {
    ctx.max_block_id = ctx.max_block_id + 1;
    ret ctx.max_block_id;
}

fun split_critical_edge(ctx: *mir_context.LowerCtx, pred: *codegen_mir.MirBlock, succ_id: u32) res[*codegen_mir.MirBlock, fail.Fail] {
    val pred_id: u32 = pred.id;
    val new_id:  u32 = fresh_block_id(ctx);

    val gr: err[fail.Fail] = grow_block(ctx);
    if (sel gr.err) { ret res[*codegen_mir.MirBlock, fail.Fail].err{gr.err}; }

    val f: *codegen_mir.MirFunction = ctx.f;
    val b: *codegen_mir.MirBlock    = ?f.blocks[f.block_count];
    b.id          = new_id;
    b.instrs      = nil;
    b.instr_count = 0;
    b.instr_cap   = 0;
    b.preds       = nil;
    b.pred_count  = 0;
    b.pred_cap    = 0;

    val rb: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 1::usize);
    if (sel rb.err) { ret res[*codegen_mir.MirBlock, fail.Fail].err{fail.refused(rb.err)}; }
    val bops: *codegen_mir.MirOperand = rb.ok;
    bops[0] = codegen_mir.op_block(succ_id);
    var br: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_BR, bops, 1,
        ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);

    val ri: res[*codegen_mir.MirInstr, A.Error] = A.allocate[codegen_mir.MirInstr](ctx.alloc, 1::usize);
    if (sel ri.err) {
        A.deallocate[codegen_mir.MirOperand](ctx.alloc, bops, 1::usize);
        ret res[*codegen_mir.MirBlock, fail.Fail].err{fail.refused(ri.err)};
    }
    b.instrs      = ri.ok;
    b.instrs[0]   = br;
    b.instr_count = 1;
    b.instr_cap   = 1;

    val rp: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, 1::usize);
    if (sel rp.err) { ret res[*codegen_mir.MirBlock, fail.Fail].err{fail.refused(rp.err)}; }
    b.preds      = rp.ok;
    b.preds[0]   = pred_id;
    b.pred_count = 1;
    b.pred_cap   = 1;

    f.block_count = f.block_count + 1;

    retarget_cbr(mir_block_by_id(f, pred_id), succ_id, new_id);
    replace_pred(mir_block_by_id(f, succ_id), pred_id, new_id);

    ret res[*codegen_mir.MirBlock, fail.Fail].ok{?f.blocks[f.block_count - 1]};
}

fun retarget_cbr(mb: *codegen_mir.MirBlock, from: u32, to: u32) {
    if (mb == nil || mb.instr_count == 0) { ret; }
    val term: *codegen_mir.MirInstr = ?mb.instrs[mb.instr_count - 1];
    var i:    u32                   = 0;
    for (i < term.operand_count) {
        if (term.operands[i].kind == codegen_mir.MIR_OP_BLOCK && term.operands[i].imm::u32 == from) {
            term.operands[i].imm = to::i64;
        }
        i = i + 1;
    }
}

fun replace_pred(mb: *codegen_mir.MirBlock, from: u32, to: u32) {
    if (mb == nil) { ret; }
    var i: u32 = 0;
    for (i < mb.pred_count) {
        if (mb.preds[i] == from) {
            mb.preds[i] = to;
            ret;
        }
        i = i + 1;
    }
}

fun lower_instr(ctx: *mir_context.LowerCtx, fn: *me_ir.Function, mb: *codegen_mir.MirBlock, iid: ir_id.InstructionId) err[fail.Fail] {
    val gi: opt[*ir_instruction.Instruction] = me_ir.instruction_get(fn, iid);
    if (!sel gi.some) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: dangling instruction id")};
    }
    val inst: *ir_instruction.Instruction = gi.some;
    if (mir_context.count_mask_folds(ctx, iid))      { ret err[fail.Fail].ok{}; }
    if (mir_context.cmp_folds_into_select(ctx, iid)) { ret err[fail.Fail].ok{}; }

    ctx.cur_loc           = inst.loc;
    ctx.cur_inline_site   = me_ir.instr_inline_site_of(fn, iid);
    ctx.cur_vec_lane      = mir_context.compute_vec_lane(ctx, inst);
    ctx.cur_writes_secret = (inst.kind == ir_instruction.OP_STORE || inst.kind == ir_instruction.OP_MEMZERO) && inst.secret;
    ctx.cur_memory_flags  = 0;
    if ((inst.flags & ir_instruction.INSTR_FLAG_VOLATILE) != 0) { ctx.cur_memory_flags = codegen_mir.MEMORY_VOLATILE; }

    val unrealized: err[fail.Fail] = check_int_widths(ctx, inst);
    if (sel unrealized.err) { ret unrealized; }

    var cop: ct.CtOp = opcode_ct_op(inst.kind);
    if (is_float_op(ctx, inst)) { cop = ct.CT_OP_FLOAT; }
    val declared_cap: opt[ct.CtCap] = ct.ct_cap(cop);
    if (sel declared_cap.none) {
        ret err[fail.Fail].err{fail.message(fail.catalog_message_or(ctx.interner, ctx.alloc, fail.unknown_member("CtOp", cop::u32), "unknown CtOp tag"))};
    }
    val ccap: ct.CtCap = declared_cap.some;
    if (ccap != ct.CT_CAP_OK && instr_has_secret_ct_operand(inst, cop)) {
        val cell: ct.CtMulCell = ir_mul_cell(ctx, inst);
        if (!ct.target_provides(resolved.ct_mul_admitted(ctx.tgt), cell, ctx.tgt.model.ct_trust_var_shift, ccap)) {
            val why: opt[str] = secret_ct_op_unsupported(cop);
            if (sel why.none) {
                ret err[fail.Fail].err{fail.message(fail.catalog_message_or(ctx.interner, ctx.alloc, fail.unknown_member("CtOp", cop::u32), "unknown CtOp tag"))};
            }
            if (cop == ct.CT_OP_INT_MUL && ct.mul_mask_has(resolved.ct_mul_dit_cells(ctx.tgt), cell)) {
                ret err[fail.Fail].err{mir_context.reject(ctx, diagnostic_kind.SECRET_VARIABLE_LATENCY, secret_mul_dit_unguaranteed(ctx))};
            }
            ret err[fail.Fail].err{mir_context.reject(ctx, diagnostic_kind.SECRET_VARIABLE_LATENCY, why.some)};
        }
        # an admitted secret multiply in a DIT row is the program's need for the mode
        if (cop == ct.CT_OP_INT_MUL && ct.mul_mask_has(resolved.ct_mul_dit_cells(ctx.tgt), cell)) {
            ctx.f.needs_dit = true;
        }
    }

    val route: opdesc.LowerRoute = opdesc.lower_route(inst.kind);

    if (route != opdesc.LOWER_PHI && route != opdesc.LOWER_DBG
        && instr_touches_vector(ctx, inst)) {
        if (!ctx.tgt.model.has_v128) {
            ret err[fail.Fail].err{mir_context.reject(ctx, diagnostic_kind.TARGET_VECTOR_WIDTH, vector_unsupported(ctx))};
        }
        if (route == opdesc.LOWER_SHIFT) {
            ret lower_vector_shift(ctx, mb, inst, iid);
        }
        if (ctx.tgt.model.vector_compute_generic && is_vector_compute(inst.kind)) {
            ret lower_generic(ctx, mb, inst, iid);
        }
        if (bitcast_crosses_wide(ctx, inst)) {
            ret lower_wide_bitcast(ctx, mb, inst, iid);
        }
    }

    if (route == opdesc.LOWER_CALL) {
        ret mir_abi.lower_call(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_RET) {
        ret mir_abi.lower_ret(ctx, mb, inst);
    }
    if (route == opdesc.LOWER_PHI) {
        ret err[fail.Fail].ok{};
    }
    if (route == opdesc.LOWER_DBG && inst.operand_count > 1) {
        ret lower_dbg_pieces(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_DBG) {
        var vreg: codegen_mir.VRegId = codegen_mir.MIR_VREG_NIL;
        # a tail call's result is the callee's to return and never the caller's
        if (inst.operand_count > 0 && !mir_context.names_tail_call(ctx, inst.operands[0])) {
            val op_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[0]);
            if (sel op_r.err) { ret err[fail.Fail].err{op_r.err}; }
            val op: codegen_mir.MirOperand = op_r.ok;
            if (op.kind == codegen_mir.MIR_OP_VREG) { vreg = op.vreg; }
        }
        # the value exists from the end of the instruction that defines it, so a
        # binding of the def just lowered is published there; anything regalloc
        # or legalize later puts between the def and its successor is covered
        if (!codegen_mir.vreg_is_nil(vreg) && mb.instr_count > 0) {
            val last: *codegen_mir.MirInstr = ?mb.instrs[mb.instr_count - 1];
            if (instr_defines_vreg(last, vreg)) {
                ret codegen_mir.instr_attach_dbg_end(ctx.alloc, last, iid::u32, vreg.n);
            }
        }
        ret mir_context.push_pending_dbg(ctx, iid::u32, vreg.n);
    }
    if (route == opdesc.LOWER_ALLOCA) {
        ret lower_alloca(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_LOAD) {
        ret lower_load(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_STORE) {
        ret lower_store(ctx, mb, inst);
    }
    if (route == opdesc.LOWER_MEMZERO) {
        ret lower_memzero(ctx, mb, inst);
    }
    if (route == opdesc.LOWER_GEP) {
        ret lower_gep(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_VEC_EXTRACT) {
        ret lower_vec_extract(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_VEC_INSERT) {
        ret lower_vec_insert(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_VEC_BUILD) {
        ret lower_vec_build(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_VEC_CONCAT) {
        ret lower_vec_concat(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_DECLASSIFY) {
        val ddst:  codegen_mir.VRegId                     = mir_context.instr_vreg(ctx, iid);
        val src_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[0]);
        if (sel src_r.err) { ret err[fail.Fail].err{src_r.err}; }
        ret mir_context.emit_declassify(ctx, mb, codegen_mir.op_vreg(ddst), src_r.ok, mir_context.op_width_of(ctx, inst.ty));
    }
    if (is_float_op(ctx, inst)) {
        ret lower_float_op(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_NEG && mir_context.value_is_float(ctx, inst.ty)) {
        ret lower_float_neg(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_BITCAST && bitcast_needs_frame(ctx, inst)) {
        ret lower_bitcast_via_frame(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_DIV) {
        ret lower_div(ctx, mb, inst, iid);
    }

    if (route == opdesc.LOWER_SHIFT) {
        ret lower_shift(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_MASK) {
        ret lower_mask_lt_u(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_SELECT) {
        ret lower_select(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_CONST) {
        ret lower_const(ctx, mb, inst, iid);
    }

    if (route == opdesc.LOWER_ASM) {
        ret lower_asm_instr(ctx, mb, iid);
    }

    if (route == opdesc.LOWER_CBR) {
        ret lower_cbr(ctx, mb, inst, iid);
    }

    ret lower_generic(ctx, mb, inst, iid);
}

# a materialized constant is one move of the constant into its register: an
# immediate move, or the constant-pool load the target selects for a float
# (#3807). the allocator rematerializes it rather than spill it
fun lower_const(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    if (inst.operand_count != 1) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: const needs one operand")};
    }
    val dst: codegen_mir.VRegId = mir_context.instr_vreg(ctx, iid);
    if (codegen_mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: const defines no result vreg")};
    }
    val src: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[0]);
    if (sel src.err) { ret err[fail.Fail].err{src.err}; }
    ret mir_context.emit_mov_w(ctx, mb, codegen_mir.op_vreg(dst), src.ok, mir_context.op_width_of(ctx, inst.ty));
}

# an integer the target does not realize is refused at the first instruction
# that produces or consumes one, naming the target and the width: the one
# refusal site for a width outside MachineModel.int_widths (#3511). sema is
# target-independent, so `u128` type-checks everywhere and is refused here
fun check_int_widths(ctx: *mir_context.LowerCtx, inst: *ir_instruction.Instruction) err[fail.Fail] {
    var bytes: u32 = mir_context.unrealized_int_width(ctx, inst.ty);
    var i:     u32 = 0;
    for (bytes == 0 && i < inst.operand_count) {
        if (!refs.operand_is_block(inst.kind, i)) { bytes = mir_context.unrealized_int_width(ctx, inst.operands[i].ty); }
        i = i + 1;
    }
    if (bytes == 0) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{mir_context.reject(ctx, diagnostic_kind.TARGET_INT_WIDTH, unrealized_int_message(ctx, bytes))};
}

# a parameter or the return of the function itself, refused at its declaration
fun check_signature_int_widths(ctx: *mir_context.LowerCtx, fn: *me_ir.Function) err[fail.Fail] {
    var bytes: u32 = mir_context.unrealized_int_width(ctx, mir_context.fn_return_type(ctx));
    var i:     u32 = 0;
    for (bytes == 0 && i < fn.param_count) {
        bytes = mir_context.unrealized_int_width(ctx, fn.params[i].ty);
        i     = i + 1;
    }
    if (bytes == 0) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{mir_context.reject(ctx, diagnostic_kind.TARGET_INT_WIDTH, unrealized_int_message(ctx, bytes))};
}

fun unrealized_int_message(ctx: *mir_context.LowerCtx, bytes: u32) str {
    val fallback: str = "a 128-bit integer is not realized on this target: it declares no integer of that width";
    var arch:     str = ctx.tgt.isa.name;
    if (arch == nil) { arch = "this target"; }
    val rm: res[str, std_format.FormatError] = std_format.sprint(ctx.alloc,
        "a {}-bit integer is not realized on {}: the target declares no integer of that width", bytes * 8, arch);
    if (sel rm.err) { ret fallback; }
    ret intern_owned(ctx, rm.ok, fallback);
}

# a reinterpret between a vector and an integer wider than the ALU: the integer
# lives as one register per lane, so no one move carries it across banks
fun bitcast_crosses_wide(ctx: *mir_context.LowerCtx, inst: *ir_instruction.Instruction) bool {
    if (inst.kind != ir_instruction.OP_BITCAST || inst.operand_count != 1 || mir_context.values_convention(ctx)) { ret false; }
    var scalar: ir_type.IrTypeId = inst.ty;
    if (mir_context.value_is_vector(ctx, inst.ty))                                                                                          { scalar = inst.operands[0].ty; }
    if (mir_context.value_is_vector(ctx, scalar) || mir_context.value_is_float(ctx, scalar) || mir_context.value_is_aggregate(ctx, scalar)) { ret false; }
    ret mir_context.op_width_of(ctx, scalar)::u64 > isa.max_alu_width(?ctx.tgt.model)::u64;
}

# the value crosses through a frame slot: the vector side moves whole in its
# bank, and the integer side is a wide memory access legalize splits into one
# access per lane
fun lower_wide_bitcast(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    val dst: codegen_mir.VRegId = mir_context.instr_vreg(ctx, iid);
    if (codegen_mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: a wide reinterpret defines no result vreg")};
    }
    val src_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[0]);
    if (sel src_r.err) { ret err[fail.Fail].err{src_r.err}; }
    val to_vector: bool             = mir_context.value_is_vector(ctx, inst.ty);
    var vector_ty: ir_type.IrTypeId = inst.operands[0].ty;
    if (to_vector) { vector_ty = inst.ty; }
    val size:  u64 = ir_type.byte_size_for_machine(ctx.types, vector_ty, ctx.layout)::u64;
    val align: u32 = ir_type.byte_align_for_machine(ctx.types, vector_ty, ctx.layout);

    val skr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel skr.err) { ret err[fail.Fail].err{skr.err}; }
    val slot: codegen_mir.MirOperand = codegen_mir.op_mem_slot(skr.ok, 0);
    val ar:   err[fail.Fail]         = mir_context.add_spill_slot_aligned(ctx, skr.ok.n, size, align);
    if (sel ar.err) { ret ar; }

    val lane: u32 = ctx.cur_vec_lane;
    fin { ctx.cur_vec_lane = lane; }
    if (to_vector) {
        ctx.cur_vec_lane = codegen_mir.VEC_LANE_NONE;
        val st: err[fail.Fail] = mir_context.push_store_chunk(ctx, mb, slot, src_r.ok, size::u8);
        if (sel st.err) { ret st; }
        ctx.cur_vec_lane = mir_context.vec_lane_for_type(ctx, vector_ty);
        ret mir_context.load_subwidth_vector(ctx, mb, codegen_mir.op_vreg(dst), slot, vector_ty);
    }
    ctx.cur_vec_lane = mir_context.vec_lane_for_type(ctx, vector_ty);
    val st: err[fail.Fail] = mir_context.store_subwidth_vector(ctx, mb, slot, src_r.ok, vector_ty);
    if (sel st.err) { ret st; }
    ctx.cur_vec_lane = codegen_mir.VEC_LANE_NONE;
    ret mir_context.emit_load_from_w(ctx, mb, dst, slot, size::u8);
}

fun instr_touches_vector(ctx: *mir_context.LowerCtx, inst: *ir_instruction.Instruction) bool {
    if (mir_context.value_is_vector(ctx, inst.ty)) { ret true; }
    var i: u32 = 0;
    for (i < inst.operand_count) {
        if (mir_context.value_is_vector(ctx, inst.operands[i].ty)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun intern_owned(ctx: *mir_context.LowerCtx, buf: str, fallback: str) str {
    val ir: res[intern.StrId, A.Error] = intern.intern(ctx.interner, buf);
    A.deallocate[u8](ctx.alloc, buf::*u8, str_len(buf) + 1);
    if (sel ir.err) { ret fallback; }
    val rn: opt[str] = intern.lookup(ctx.interner, ir.ok);
    if (sel rn.some) { ret rn.some; }
    ret fallback;
}

fun opcode_ct_op(kind: ir_instruction.InstrKind) ct.CtOp {
    val c: opdesc.CtClass = opdesc.ct_class(kind);
    if (c == opdesc.CTC_INT_MUL)   { ret ct.CT_OP_INT_MUL; }
    if (c == opdesc.CTC_VAR_SHIFT) { ret ct.CT_OP_VAR_SHIFT; }
    if (c == opdesc.CTC_FLOAT)     { ret ct.CT_OP_FLOAT; }
    ret ct.CT_OP_NONE;
}

# the multiply cell an IR multiply lowers to: the low half at its operand
# width, a lane multiply at its operand lane width, and a widening one as the
# full product of its operand lanes
fun ir_mul_cell(ctx: *mir_context.LowerCtx, inst: *ir_instruction.Instruction) ct.CtMulCell {
    var op: ct.CtMulOp = ct.CT_MUL_LOW;
    if (inst.kind == ir_instruction.OP_MUL_WIDE_S) { op = ct.CT_MUL_WIDE_S; }
    if (inst.kind == ir_instruction.OP_MUL_WIDE_U) { op = ct.CT_MUL_WIDE_U; }
    if (inst.kind == ir_instruction.OP_MUL_HIGH_S) { op = ct.CT_MUL_HIGH_S; }
    if (inst.kind == ir_instruction.OP_MUL_HIGH_U) { op = ct.CT_MUL_HIGH_U; }
    var operand_ty: ir_type.IrTypeId = inst.ty;
    if (inst.operand_count >= 1) { operand_ty = inst.operands[0].ty; }
    val lane: u32 = mir_context.vec_lane_for_type(ctx, operand_ty);
    if (codegen_mir.vec_lane_is_vector(lane)) {
        ret ct.mul_cell(op, codegen_mir.vec_lane_elem_bytes(lane) * 8, true);
    }
    ret ct.mul_cell(op, mir_context.op_width_of(ctx, operand_ty) * 8, false);
}

fun instr_has_secret_ct_operand(inst: *ir_instruction.Instruction, cop: ct.CtOp) bool {
    if (ct.ct_op_gates_count_only(cop)) {
        ret inst.operand_count >= 2 && inst.operands[1].secret;
    }
    var i: u32 = 0;
    for (i < inst.operand_count) {
        if (inst.operands[i].secret) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the refusal text of a secret operand on an operation whose capability the
# target does not provide; absent for a tag outside the catalog
fun secret_ct_op_unsupported(cop: ct.CtOp) opt[str] {
    if (cop == ct.CT_OP_VAR_SHIFT) {
        ret opt[str].some{"secret value used as a variable shift count on a target without a barrel shifter; the shift's cycle count leaks the secret amount. shift by a public count, or run on a target whose variable shift is constant-time"};
    }
    if (cop == ct.CT_OP_FLOAT) {
        ret opt[str].some{"secret value used as an operand of a variable-latency floating-point operation; the FP unit's timing can depend on the secret operand. compute on public data, or `:>T` to a public value when disclosure is intended"};
    }
    if (cop == ct.CT_OP_INT_MUL) {
        ret opt[str].some{"secret value used as an operand of a variable-latency integer multiply; this target documents no data-independent multiply timing, so the product's latency can leak the secret operand. compute the operation branch-free over public data, or run on a target whose DIT/DOITM mode is trusted"};
    }
    if (cop == ct.CT_OP_INT_DIVMOD) {
        ret opt[str].some{"secret value used as an operand of an integer divide or remainder; the division unit\'s latency is data-dependent, so it leaks the secret operand. compute branch-free over public data"};
    }
    ret opt[str].none{};
}

test ct_gate__secret_operand_by_op_class {
    if (opcode_ct_op(ir_instruction.OP_SHR_U) != ct.CT_OP_VAR_SHIFT) { ret 1; }
    if (opcode_ct_op(ir_instruction.OP_ADD) != ct.CT_OP_NONE)        { ret 1; }
    if (opcode_ct_op(ir_instruction.OP_DIV_S) != ct.CT_OP_NONE)      { ret 1; }

    var ops: [2]value.Value;
    ops[0].kind   = value.VAL_CONST_INT;
    ops[0].secret = false;
    ops[1].kind   = value.VAL_CONST_INT;
    ops[1].secret = true;
    var shl: ir_instruction.Instruction;
    shl.kind          = ir_instruction.OP_SHL;
    shl.operands      = ?ops[0];
    shl.operand_count = 2;

    if (!instr_has_secret_ct_operand(?shl, ct.CT_OP_VAR_SHIFT)) { ret 1; }

    ops[0].secret = true;
    ops[1].secret = false;
    if (instr_has_secret_ct_operand(?shl, ct.CT_OP_VAR_SHIFT)) { ret 1; }

    if (!instr_has_secret_ct_operand(?shl, ct.CT_OP_INT_MUL)) { ret 1; }

    if (!ct.cap_at_mir(ct.ct_cap_or_always(ct.CT_OP_VAR_SHIFT))) { ret 1; }
    val low: ct.CtMulCell = ct.mul_cell(ct.CT_MUL_LOW, 64, false);
    if (ct.target_provides(ct.mul_mask_none(), low, false, ct.ct_cap_or_always(ct.CT_OP_VAR_SHIFT))) { ret 1; }
    if (!ct.target_provides(ct.mul_mask_none(), low, true, ct.ct_cap_or_always(ct.CT_OP_VAR_SHIFT))) { ret 1; }
    ret 0;
}

# a secret multiply in a cell the instruction set declares only under PSTATE.DIT
# on an os that declares no guarantee for the mode: the refusal names both
fun secret_mul_dit_unguaranteed(ctx: *mir_context.LowerCtx) str {
    val fallback: str                              = "codegen: secret value used as an operand of an integer multiply whose timing is data-independent only under PSTATE.DIT, and this operating system declares no guarantee that a process can set and hold that mode (#3508). compute the operation branch-free over public data, or build for an operating system that declares the guarantee";
    val jr:       res[str, std_format.FormatError] = std_format.sprint(ctx.alloc,
        "codegen: secret value used as an operand of an integer multiply whose timing is data-independent only under PSTATE.DIT; the `{}` instruction set declares the multiply under that mode and the `{}` operating system declares no guarantee that a process can set and hold it (#3508). compute the operation branch-free over public data, or build for an operating system that declares the guarantee",
        ctx.tgt.isa.name, ctx.tgt.os.name);
    if (sel jr.err) { ret fallback; }
    ret intern_owned(ctx, jr.ok, fallback);
}

fun vector_unsupported(ctx: *mir_context.LowerCtx) str {
    val prefix:   str = "128-bit vectors not yet supported on ";
    val fallback: str = "128-bit vectors not yet supported on this target";
    val arch:     str = ctx.tgt.isa.name;
    if (arch == nil) { ret fallback; }

    val jr: res[str, StrError] = str_join(ctx.alloc, prefix, arch);
    if (sel jr.err) { ret fallback; }
    ret intern_owned(ctx, jr.ok, fallback);
}

fun lower_cbr(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    if (inst.operand_count < 3) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: conditional branch missing operands")};
    }

    val cond_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_operand(ctx, inst, 0);
    if (sel cond_r.err) { ret err[fail.Fail].err{cond_r.err}; }
    var cond: codegen_mir.MirOperand = cond_r.ok;
    if (cond.kind == codegen_mir.MIR_OP_IMM) {
        val rv: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
        if (sel rv.err) { ret err[fail.Fail].err{rv.err}; }
        val creg: codegen_mir.VRegId = rv.ok;
        val mv:   err[fail.Fail]     = mir_context.emit_mov(ctx, mb, codegen_mir.op_vreg(creg), cond);
        if (sel mv.err) { ret mv; }
        cond = codegen_mir.op_vreg(creg);
    }

    val rop: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 3::usize);
    if (sel rop.err) { ret err[fail.Fail].err{fail.refused(rop.err)}; }
    val ops: *codegen_mir.MirOperand = rop.ok;
    ops[0] = cond;
    val lowered_2: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_operand(ctx, inst, 1);
    if (sel lowered_2.err) { ret err[fail.Fail].err{lowered_2.err}; }
    ops[1] = lowered_2.ok;
    val lowered_3: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_operand(ctx, inst, 2);
    if (sel lowered_3.err) { ret err[fail.Fail].err{lowered_3.err}; }
    ops[2] = lowered_3.ok;

    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_CBR, ops, 3, 0, 0);
    set_generic_widths(ctx, inst, ?mi);
    mi.width = mir_context.op_width_of(ctx, inst.operands[0].ty);
    ret mir_context.push_instr(ctx, mb, mi);
}

fun asm_bind_message(ctx: *mir_context.LowerCtx, prefix: str, name_id: intern.StrId, suffix: str, fallback: str) str {
    val no: opt[str] = intern.lookup(ctx.interner, name_id);
    if (sel no.none) { ret fallback; }
    val nm: str = no.some;

    val jr: res[str, StrError] = str_join(ctx.alloc, prefix, nm, suffix);
    if (sel jr.err) { ret fallback; }
    ret intern_owned(ctx, jr.ok, fallback);
}

fun lower_asm_instr(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, iid: ir_id.InstructionId) err[fail.Fail] {
    var key: ir_id.InstructionId = iid;
    val pr:  opt[*me_ir.IrAsm]   = map.get[ir_id.InstructionId, me_ir.IrAsm](?ctx.fn.asm_blocks, ?key);
    if (sel pr.none) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: OP_ASM instruction has no asm payload")};
    }
    val src: *me_ir.IrAsm = pr.some;

    val isa_opt: opt[str] = intern.lookup(ctx.interner, src.isa);
    if (sel isa_opt.none) { ret err[fail.Fail].err{fail.message("mir.lower_ir: inline-asm ISA tag not interned")}; }
    val body_opt: opt[str] = intern.lookup(ctx.interner, src.body);
    if (sel body_opt.none) { ret err[fail.Fail].err{fail.message("mir.lower_ir: inline-asm body not interned")}; }

    val rp: res[*codegen_mir.MirAsm, A.Error] = A.allocate[codegen_mir.MirAsm](ctx.alloc, 1::usize);
    if (sel rp.err) { ret err[fail.Fail].err{fail.refused(rp.err)}; }
    val payload: *codegen_mir.MirAsm = rp.ok;
    payload.isa        = isa_opt.some;
    payload.body       = body_opt.some;
    payload.binds      = nil;
    payload.bind_count = 0;

    if (src.bind_count > 0) {
        val rb: res[*codegen_mir.MirAsmBind, A.Error] = A.allocate[codegen_mir.MirAsmBind](ctx.alloc, src.bind_count::usize);
        if (sel rb.err) {
            A.deallocate[codegen_mir.MirAsm](ctx.alloc, payload, 1::usize);
            ret err[fail.Fail].err{fail.refused(rb.err)};
        }
        payload.binds = rb.ok;
        var k: u32 = 0;
        for (k < src.bind_count) {
            var vreg: codegen_mir.VRegId = mir_context.slot_key_vreg(ctx, src.binds[k].instr);
            if (codegen_mir.vreg_is_nil(vreg)) { vreg = mir_context.instr_vreg(ctx, src.binds[k].instr); }
            if (codegen_mir.vreg_is_nil(vreg)) {
                val msg: str = asm_bind_message(ctx, "inline-asm local '", src.binds[k].name, "' has no addressable storage slot", "inline-asm local has no addressable storage slot");
                A.deallocate[codegen_mir.MirAsmBind](ctx.alloc, payload.binds, src.bind_count::usize);
                A.deallocate[codegen_mir.MirAsm](ctx.alloc, payload, 1::usize);
                ret err[fail.Fail].err{fail.message(msg)};
            }
            payload.binds[k] = codegen_mir.asm_bind(src.binds[k].name, vreg.n, src.binds[k].secrecy);
            k                = k + 1;
        }
        payload.bind_count = src.bind_count;
    }

    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_ASM, nil, 0, 0, 0);
    mi.asm_block = payload;

    val push: err[fail.Fail] = mir_context.push_instr(ctx, mb, mi);
    if (sel push.err) {
        if (payload.binds != nil) { A.deallocate[codegen_mir.MirAsmBind](ctx.alloc, payload.binds, payload.bind_count::usize); }
        A.deallocate[codegen_mir.MirAsm](ctx.alloc, payload, 1::usize);
        ret push;
    }
    ret err[fail.Fail].ok{};
}

fun narrow_shift_value(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction,
    value: codegen_mir.MirOperand, natural_w: u8, w: u8) res[codegen_mir.MirOperand, fail.Fail] {
    if (inst.kind == ir_instruction.OP_SHL) { ret res[codegen_mir.MirOperand, fail.Fail].ok{value}; }
    if (natural_w >= w)                     { ret res[codegen_mir.MirOperand, fail.Fail].ok{value}; }

    val vr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel vr.err) { ret res[codegen_mir.MirOperand, fail.Fail].err{vr.err}; }
    val v: codegen_mir.VRegId = vr.ok;

    val pr: err[fail.Fail] = mir_context.emit_promote(ctx, mb, codegen_mir.op_vreg(v), value, w, natural_w,
        inst.kind == ir_instruction.OP_SHR_S);
    if (sel pr.err) { ret res[codegen_mir.MirOperand, fail.Fail].err{pr.err}; }
    ret res[codegen_mir.MirOperand, fail.Fail].ok{codegen_mir.op_vreg(v)};
}

# a scalar shift reaches lowering count-bounded: shiftbound proved its count
# below the width or saturated it in the ir (#3885, #3887), so it is the bare
# machine shift, and so is one whose count is a mask the machine applies
# itself (#3893). a variable count without the mark would be the machine's
# answer for a count at or above the width, never the language's, so it is
# refused
fun lower_shift(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    if (inst.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: shift missing value or count operand")};
    }
    val dst: codegen_mir.VRegId = mir_context.instr_vreg(ctx, iid);
    if (codegen_mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: shift defines no result vreg")};
    }
    if ((inst.flags & ir_instruction.INSTR_FLAG_COUNT_BOUNDED) == 0) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: a scalar shift reached lowering without the count bound shiftbound gives it")};
    }
    val natural_w: u8  = mir_context.op_width_of(ctx, inst.ty);
    val w:         u8  = isa.clamp_alu_width(?ctx.tgt.model, natural_w);
    val bits:      i64 = natural_w::i64 * 8;

    var op: codegen_mir.MirOpcode = codegen_mir.MIR_SHR_U;
    if (inst.kind == ir_instruction.OP_SHL)   { op = codegen_mir.MIR_SHL; }
    if (inst.kind == ir_instruction.OP_SHR_S) { op = codegen_mir.MIR_SHR_S; }

    val raw_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[0]);
    if (sel raw_r.err) { ret err[fail.Fail].err{raw_r.err}; }
    val count_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, shift_count_value(ctx, inst.operands[1]));
    if (sel count_r.err) { ret err[fail.Fail].err{count_r.err}; }
    var count: codegen_mir.MirOperand = count_r.ok;
    if (count.kind == codegen_mir.MIR_OP_IMM && (count.imm < 0 || count.imm >= bits)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: a count-bounded shift has a constant count at or above its width")};
    }

    val rv: res[codegen_mir.MirOperand, fail.Fail] = narrow_shift_value(ctx, mb, inst, raw_r.ok, natural_w, w);
    if (sel rv.err) { ret err[fail.Fail].err{rv.err}; }
    val value: codegen_mir.MirOperand = rv.ok;

    if (count.kind != codegen_mir.MIR_OP_IMM) {
        val tr: res[codegen_mir.MirOperand, fail.Fail] = count_at_shift_width(ctx, mb, inst, count, w);
        if (sel tr.err) { ret err[fail.Fail].err{tr.err}; }
        count = tr.ok;
    }

    # the fixed count register serves the machine's own variable shift. a
    # shift wider than the alu is legalized into constant-shift stages selected
    # by the count's bits, so its count stays a vreg legalize reads in the low
    # lane
    var count_op: codegen_mir.MirOperand = count;
    val maw:      u8                     = isa.max_alu_width(?ctx.tgt.model)::u8;
    if (count.kind != codegen_mir.MIR_OP_IMM && (maw == 0 || w <= maw)) {
        val cnt_reg: i32 = ctx.tgt.model.shift_count_reg;
        if (cnt_reg >= 0) {
            val mc: err[fail.Fail] = mir_context.emit_mov_w(ctx, mb, codegen_mir.op_preg(codegen_mir.preg_id(cnt_reg)), count, w);
            if (sel mc.err) { ret mc; }
            count_op = codegen_mir.op_preg(codegen_mir.preg_id(cnt_reg));
        }
    }

    val r: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 3::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *codegen_mir.MirOperand = r.ok;
    ops[0] = codegen_mir.op_vreg(dst);
    ops[1] = value;
    ops[2] = count_op;
    var mi: codegen_mir.MirInstr = codegen_mir.instr(op, ops, 3, w, w);
    ret mir_context.push_instr(ctx, mb, mi);
}

# all ones at the result's width exactly when operand 0 is below operand 1,
# unsigned, both read at their own width (#3887). the compare-to-mask reads
# and writes at most the alu width: a wider mask is its sign extension, and
# operands wider than the alu are compared by the legalized wide compare,
# whose 0/1 answer is zero-extended and negated
fun lower_mask_lt_u(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    if (inst.operand_count != 2) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: mask_lt_u needs two operands")};
    }
    val dst: codegen_mir.VRegId = mir_context.instr_vreg(ctx, iid);
    if (codegen_mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: mask_lt_u defines no result vreg")};
    }
    val ar: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[0]);
    if (sel ar.err) { ret err[fail.Fail].err{ar.err}; }
    val br: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[1]);
    if (sel br.err) { ret err[fail.Fail].err{br.err}; }
    val cw:  u8 = mir_context.op_width_of(ctx, inst.operands[0].ty);
    val mw:  u8 = isa.clamp_alu_width(?ctx.tgt.model, mir_context.op_width_of(ctx, inst.ty));
    val maw: u8 = isa.max_alu_width(?ctx.tgt.model)::u8;

    if (maw != 0 && cw > maw) {
        val kr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
        if (sel kr.err) { ret err[fail.Fail].err{kr.err}; }
        val ce: err[fail.Fail] = emit_alu3(ctx, mb, codegen_mir.MIR_CMP_LT_U, codegen_mir.op_vreg(kr.ok), ar.ok, br.ok, cw);
        if (sel ce.err) { ret ce; }
        val zr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
        if (sel zr.err) { ret err[fail.Fail].err{zr.err}; }
        val pr: err[fail.Fail] = mir_context.emit_promote(ctx, mb, codegen_mir.op_vreg(zr.ok), codegen_mir.op_vreg(kr.ok), mw, 1, false);
        if (sel pr.err) { ret pr; }
        ret emit_alu2(ctx, mb, codegen_mir.MIR_NEG, codegen_mir.op_vreg(dst), codegen_mir.op_vreg(zr.ok), mw);
    }

    var lw: u8 = mw;
    if (maw != 0 && lw > maw) { lw = maw; }
    var narrow: codegen_mir.VRegId = dst;
    if (lw != mw) {
        val nr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
        if (sel nr.err) { ret err[fail.Fail].err{nr.err}; }
        narrow = nr.ok;
    }
    val opr: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 3::usize);
    if (sel opr.err) { ret err[fail.Fail].err{fail.refused(opr.err)}; }
    val ops: *codegen_mir.MirOperand = opr.ok;
    ops[0] = codegen_mir.op_vreg(narrow);
    ops[1] = ar.ok;
    ops[2] = br.ok;
    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_MASK_LT_U, ops, 3, lw, cw);
    val pe: err[fail.Fail]       = mir_context.push_instr(ctx, mb, mi);
    if (sel pe.err || lw == mw) { ret pe; }
    ret mir_context.emit_promote(ctx, mb, codegen_mir.op_vreg(dst), codegen_mir.op_vreg(narrow), mw, lw, true);
}

# a select whose condition is a compare folded into it compares for itself,
# and one that chooses between 1 and 0 is its condition's 0/1 answer widened
# to the result (a setcc and a widen); either way no branch is emitted, so a
# secret condition stays constant-time (#3346)
fun lower_select(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    if (inst.operand_count != 3) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: select needs a condition and two choices")};
    }
    val dst: codegen_mir.VRegId = mir_context.instr_vreg(ctx, iid);
    if (codegen_mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: select defines no result vreg")};
    }
    val natural_w: u8  = mir_context.op_width_of(ctx, inst.ty);
    val maw:       u32 = isa.max_alu_width(?ctx.tgt.model);
    if (maw != 0 && natural_w::u32 > maw) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: a select wider than the alu reached lowering")};
    }
    val w: u8 = isa.clamp_alu_width(?ctx.tgt.model, natural_w);

    val ar: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[1]);
    if (sel ar.err) { ret err[fail.Fail].err{ar.err}; }
    val br: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[2]);
    if (sel br.err) { ret err[fail.Fail].err{br.err}; }

    var cmp: *ir_instruction.Instruction = nil;
    val c:   value.Value                 = inst.operands[0];
    if (c.kind == value.VAL_INSTR && mir_context.cmp_folds_into_select(ctx, c.data.instr)) {
        cmp = ?ctx.fn.instrs[c.data.instr::u32];
    }

    if (imm_is(ar.ok, 1) && imm_is(br.ok, 0)) { ret lower_select_bool(ctx, mb, c, cmp, dst, w, false); }
    if (imm_is(ar.ok, 0) && imm_is(br.ok, 1)) { ret lower_select_bool(ctx, mb, c, cmp, dst, w, true); }

    val ra: res[codegen_mir.MirOperand, fail.Fail] = in_register(ctx, mb, ar.ok, w);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    val rb: res[codegen_mir.MirOperand, fail.Fail] = in_register(ctx, mb, br.ok, w);
    if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }

    if (cmp != nil) {
        var fc: FoldedCompare;
        val fr: err[fail.Fail] = fold_compare(ctx, mb, cmp, false, true, ?fc);
        if (sel fr.err) { ret fr; }
        # the negated compare picks the other choice
        var a: codegen_mir.MirOperand = ra.ok;
        var b: codegen_mir.MirOperand = rb.ok;
        if (fc.negated) {
            a = rb.ok;
            b = ra.ok;
        }
        val r: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 6::usize);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        val ops: *codegen_mir.MirOperand = r.ok;
        ops[0] = codegen_mir.op_vreg(dst);
        ops[1] = fc.lhs;
        ops[2] = fc.rhs;
        ops[3] = a;
        ops[4] = b;
        ops[5] = codegen_mir.op_imm(fc.op::i64);
        var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_SELECT_CMP, ops, 6, w, fc.width);
        ret mir_context.push_instr(ctx, mb, mi);
    }

    val cr: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, c);
    if (sel cr.err) { ret err[fail.Fail].err{cr.err}; }
    # a condition constfold never saw is already decided
    if (cr.ok.kind == codegen_mir.MIR_OP_IMM) {
        if ((cr.ok.imm & 0xFF) != 0) { ret mir_context.emit_mov_w(ctx, mb, codegen_mir.op_vreg(dst), ra.ok, w); }
        ret mir_context.emit_mov_w(ctx, mb, codegen_mir.op_vreg(dst), rb.ok, w);
    }
    val cw: u8                                     = mir_context.op_width_of(ctx, c.ty);
    val rc: res[codegen_mir.MirOperand, fail.Fail] = in_register(ctx, mb, cr.ok, cw);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    val r: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 4::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *codegen_mir.MirOperand = r.ok;
    ops[0] = codegen_mir.op_vreg(dst);
    ops[1] = rc.ok;
    ops[2] = ra.ok;
    ops[3] = rb.ok;
    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_SELECT, ops, 4, w, cw);
    ret mir_context.push_instr(ctx, mb, mi);
}

# `select c, 1, 0` is c widened and `select c, 0, 1` its inverse widened:
# the folded compare's own 0/1 answer, else the condition's
fun lower_select_bool(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, c: value.Value, cmp: *ir_instruction.Instruction,
    dst: codegen_mir.VRegId, w: u8, invert: bool) err[fail.Fail] {
    if (cmp != nil) {
        var fc: FoldedCompare;
        val fr: err[fail.Fail] = fold_compare(ctx, mb, cmp, invert, false, ?fc);
        if (sel fr.err) { ret fr; }
        val tr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
        if (sel tr.err) { ret err[fail.Fail].err{tr.err}; }
        val ce: err[fail.Fail] = emit_alu3(ctx, mb, fc.op, codegen_mir.op_vreg(tr.ok), fc.lhs, fc.rhs, fc.width);
        if (sel ce.err) { ret ce; }
        ret mir_context.emit_promote(ctx, mb, codegen_mir.op_vreg(dst), codegen_mir.op_vreg(tr.ok), w, 1, false);
    }
    val cr: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, c);
    if (sel cr.err) { ret err[fail.Fail].err{cr.err}; }
    if (cr.ok.kind == codegen_mir.MIR_OP_IMM) {
        var bit: i64 = 0;
        if (((cr.ok.imm & 0xFF) != 0) != invert) { bit = 1; }
        ret mir_context.emit_mov_w(ctx, mb, codegen_mir.op_vreg(dst), codegen_mir.op_imm(bit), w);
    }
    if (!invert) { ret mir_context.emit_promote(ctx, mb, codegen_mir.op_vreg(dst), cr.ok, w, 1, false); }
    val tr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel tr.err) { ret err[fail.Fail].err{tr.err}; }
    val bw: u8             = isa.clamp_alu_width(?ctx.tgt.model, 1);
    val xe: err[fail.Fail] = emit_alu3(ctx, mb, codegen_mir.MIR_XOR, codegen_mir.op_vreg(tr.ok), cr.ok, codegen_mir.op_imm(1), bw);
    if (sel xe.err) { ret xe; }
    ret mir_context.emit_promote(ctx, mb, codegen_mir.op_vreg(dst), codegen_mir.op_vreg(tr.ok), w, 1, false);
}

# a compare folded into a select: `op` of `lhs`, which a register holds, and
# `rhs`, read at `width`, answers the IR compare, or its negation when
# `negated` is set
rec FoldedCompare {
    op:      codegen_mir.MirOpcode;
    lhs:     codegen_mir.MirOperand;
    rhs:     codegen_mir.MirOperand;
    width:   u8;
    negated: bool;
}

# `invert` asks for the negated compare. an equality negates by its opcode and
# commutes; an ordered compare negates by trading its operands for its dual
# (not a < b is b <= a), so a constant on the left trades sides only when the
# caller takes a negated answer, and is loaded into a register otherwise
fun fold_compare(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, cmp: *ir_instruction.Instruction, invert: bool,
    negation_ok: bool, out: *FoldedCompare) err[fail.Fail] {
    val mapped: res[codegen_mir.MirOpcode, fail.Fail] = lowered_opcode(cmp.kind);
    if (sel mapped.err) { ret err[fail.Fail].err{mapped.err}; }
    val lr: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, cmp.operands[0]);
    if (sel lr.err) { ret err[fail.Fail].err{lr.err}; }
    val rr: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, cmp.operands[1]);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    val cw: u8 = mir_context.op_width_of(ctx, cmp.operands[0].ty);

    var op:       codegen_mir.MirOpcode = mapped.ok;
    var swap:     bool                  = false;
    var negated:  bool                  = false;
    val left_imm: bool                  = lr.ok.kind == codegen_mir.MIR_OP_IMM && rr.ok.kind != codegen_mir.MIR_OP_IMM;
    if (op == codegen_mir.MIR_CMP_EQ || op == codegen_mir.MIR_CMP_NE) {
        if (invert && op == codegen_mir.MIR_CMP_EQ) { op = codegen_mir.MIR_CMP_NE; }
        or (invert && op == codegen_mir.MIR_CMP_NE) { op = codegen_mir.MIR_CMP_EQ; }
        swap = left_imm;
    }
    or (invert) {
        op   = ordered_dual(op);
        swap = true;
    }
    or (left_imm && negation_ok) {
        op      = ordered_dual(op);
        swap    = true;
        negated = true;
    }
    var l: codegen_mir.MirOperand = lr.ok;
    var r: codegen_mir.MirOperand = rr.ok;
    if (swap) {
        l = rr.ok;
        r = lr.ok;
    }
    val rl: res[codegen_mir.MirOperand, fail.Fail] = in_register(ctx, mb, l, cw);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    var rhs: codegen_mir.MirOperand = r;
    if (r.kind != codegen_mir.MIR_OP_IMM) {
        val rs: res[codegen_mir.MirOperand, fail.Fail] = in_register(ctx, mb, r, cw);
        if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
        rhs = rs.ok;
    }
    out.op      = op;
    out.lhs     = rl.ok;
    out.rhs     = rhs;
    out.width   = cw;
    out.negated = negated;
    ret err[fail.Fail].ok{};
}

# a < b is b <= a negated, and a <= b is b < a negated
fun ordered_dual(op: codegen_mir.MirOpcode) codegen_mir.MirOpcode {
    if (op == codegen_mir.MIR_CMP_LT_S) { ret codegen_mir.MIR_CMP_LE_S; }
    if (op == codegen_mir.MIR_CMP_LE_S) { ret codegen_mir.MIR_CMP_LT_S; }
    if (op == codegen_mir.MIR_CMP_LT_U) { ret codegen_mir.MIR_CMP_LE_U; }
    ret codegen_mir.MIR_CMP_LT_U;
}

fun imm_is(op: codegen_mir.MirOperand, v: i64) bool {
    ret op.kind == codegen_mir.MIR_OP_IMM && op.imm == v && op.imm_hi == 0;
}

# a select reads its choices and its compared left side from registers: a
# constant is loaded into one and a symbol's address computed into one
fun in_register(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, op: codegen_mir.MirOperand, w: u8) res[codegen_mir.MirOperand, fail.Fail] {
    if (op.kind == codegen_mir.MIR_OP_VREG) { ret res[codegen_mir.MirOperand, fail.Fail].ok{op}; }
    if (op.kind == codegen_mir.MIR_OP_SYM) {
        var av: codegen_mir.VRegId = codegen_mir.MIR_VREG_NIL;
        val ae: err[fail.Fail]     = mir_context.addr_to_vreg(ctx, mb, op, ?av);
        if (sel ae.err) { ret res[codegen_mir.MirOperand, fail.Fail].err{ae.err}; }
        ret res[codegen_mir.MirOperand, fail.Fail].ok{codegen_mir.op_vreg(av)};
    }
    if (op.kind != codegen_mir.MIR_OP_IMM) {
        ret res[codegen_mir.MirOperand, fail.Fail].err{fail.message("mir.lower_ir: a select operand is neither a register, a constant nor a symbol")};
    }
    val vr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel vr.err) { ret res[codegen_mir.MirOperand, fail.Fail].err{vr.err}; }
    val me: err[fail.Fail] = mir_context.emit_mov_w(ctx, mb, codegen_mir.op_vreg(vr.ok), op, w);
    if (sel me.err) { ret res[codegen_mir.MirOperand, fail.Fail].err{me.err}; }
    ret res[codegen_mir.MirOperand, fail.Fail].ok{codegen_mir.op_vreg(vr.ok)};
}

fun count_is_folded_mask(ctx: *mir_context.LowerCtx, v: value.Value) bool {
    ret v.kind == value.VAL_INSTR && mir_context.count_mask_folds(ctx, v.data.instr);
}

# the value a shift reads as its count: the masked operand of a count mask
# lowering does not materialize, else the count itself
fun shift_count_value(ctx: *mir_context.LowerCtx, v: value.Value) value.Value {
    if (!count_is_folded_mask(ctx, v)) { ret v; }
    val mask: *ir_instruction.Instruction = ?ctx.fn.instrs[v.data.instr::u32];
    val src:  opt[u32]                    = mir_context.count_mask_source(ctx, mask);
    if (sel src.some) { ret mask.operands[src.some]; }
    ret v;
}

# a packed vector shift reaches here only in a form the target packs, and
# the packed instructions saturate a count at or above the lane width on
# their own, so it carries none of the scalar shift's sequence. a lane
# narrower than the narrowest one the target shifts is shifted as lanes twice
# as wide, each half on its own with the other half cleared (#3740)
fun lower_vector_shift(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    if (inst.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: vector shift missing value or count operand")};
    }
    val lane_bits: u32 = codegen_mir.vec_lane_elem_bytes(ctx.cur_vec_lane)::u32 * 8;
    val min_bits:  u32 = ctx.tgt.model.packed_shift_min_bits;
    if (mir_context.value_is_vector(ctx, inst.operands[1].ty) || lane_bits >= min_bits) {
        ret lower_generic(ctx, mb, inst, iid);
    }
    if (lane_bits * 2 != min_bits) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: vector shift lane is more than one halving below the target's narrowest packed shift")};
    }
    ret lower_halved_vector_shift(ctx, mb, inst, iid);
}

# each wide lane holds a low and a high narrow lane. a left shift moves the
# low half's bits up into the high half, so the low result is the wide shift
# with its high half cleared, and the high result is the wide shift of the
# high half alone; a right shift is the mirror, whose high result is the wide
# shift with its low half cleared and whose low result is the low half moved
# up, shifted, and moved back. a count at or above the narrow width empties
# the narrow lane in every case, and an arithmetic one fills it with the sign
fun lower_halved_vector_shift(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    val dst: codegen_mir.VRegId = mir_context.instr_vreg(ctx, iid);
    if (codegen_mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: vector shift defines no result vreg")};
    }
    val ar: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_operand(ctx, inst, 0);
    if (sel ar.err) { ret err[fail.Fail].err{ar.err}; }
    val cr: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_operand(ctx, inst, 1);
    if (sel cr.err) { ret err[fail.Fail].err{cr.err}; }
    val a:    codegen_mir.MirOperand = ar.ok;
    var c:    codegen_mir.MirOperand = cr.ok;
    val lane: u32                    = ctx.cur_vec_lane;
    val eb:   u8                     = codegen_mir.vec_lane_elem_bytes(lane);

    # the wide shifts read a count of the wide lane's width, so a register
    # count is zero-extended to it: its value, not its low bits, is the count
    if (c.kind != codegen_mir.MIR_OP_IMM) {
        val zr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
        if (sel zr.err) { ret err[fail.Fail].err{zr.err}; }
        ctx.cur_vec_lane = codegen_mir.VEC_LANE_NONE;
        val ze: err[fail.Fail] = mir_context.emit_promote(ctx, mb, codegen_mir.op_vreg(zr.ok), c, eb * 2, eb, false);
        ctx.cur_vec_lane = lane;
        if (sel ze.err) { ret ze; }
        c = codegen_mir.op_vreg(zr.ok);
    }

    val w:    u8                     = mir_context.op_width_of(ctx, inst.ty);
    val half: codegen_mir.MirOperand = codegen_mir.op_imm(eb::i64 * 8);
    var op:   codegen_mir.MirOpcode  = codegen_mir.MIR_SHR_U;
    if (inst.kind == ir_instruction.OP_SHL)   { op = codegen_mir.MIR_SHL; }
    if (inst.kind == ir_instruction.OP_SHR_S) { op = codegen_mir.MIR_SHR_S; }

    var t: [6]codegen_mir.MirOperand;
    var k: u32 = 0;
    for (k < 6) {
        val tr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg_vec(ctx, ctx.f.vregs[dst.n].class, ctx.f.vregs[dst.n].vec_bytes);
        if (sel tr.err) { ret err[fail.Fail].err{tr.err}; }
        ctx.f.vregs[tr.ok.n].ty = inst.ty::u32;
        t[k]                    = codegen_mir.op_vreg(tr.ok);
        k                       = k + 1;
    }

    var steps: [6]VecStep;
    if (op == codegen_mir.MIR_SHL) {
        steps[0] = VecStep{op: codegen_mir.MIR_SHL, d: t[0], x: a, y: c};
        steps[1] = VecStep{op: codegen_mir.MIR_SHL, d: t[1], x: t[0], y: half};
        steps[2] = VecStep{op: codegen_mir.MIR_SHR_U, d: t[2], x: t[1], y: half};
        steps[3] = VecStep{op: codegen_mir.MIR_SHR_U, d: t[3], x: a, y: half};
        steps[4] = VecStep{op: codegen_mir.MIR_SHL, d: t[4], x: t[3], y: half};
        steps[5] = VecStep{op: codegen_mir.MIR_SHL, d: t[5], x: t[4], y: c};
    }
    or {
        steps[0] = VecStep{op: op, d: t[0], x: a, y: c};
        steps[1] = VecStep{op: codegen_mir.MIR_SHR_U, d: t[1], x: t[0], y: half};
        steps[2] = VecStep{op: codegen_mir.MIR_SHL, d: t[2], x: t[1], y: half};
        steps[3] = VecStep{op: codegen_mir.MIR_SHL, d: t[3], x: a, y: half};
        steps[4] = VecStep{op: op, d: t[4], x: t[3], y: c};
        steps[5] = VecStep{op: codegen_mir.MIR_SHR_U, d: t[5], x: t[4], y: half};
    }
    ctx.cur_vec_lane = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, eb * 2, codegen_mir.vec_lane_count(lane) / 2);
    k                = 0;
    for (k < 6) {
        val se: err[fail.Fail] = emit_alu3(ctx, mb, steps[k].op, steps[k].d, steps[k].x, steps[k].y, w);
        if (sel se.err) {
            ctx.cur_vec_lane = lane;
            ret se;
        }
        k = k + 1;
    }
    val oe: err[fail.Fail] = emit_alu3(ctx, mb, codegen_mir.MIR_OR, codegen_mir.op_vreg(dst), t[2], t[5], w);
    ctx.cur_vec_lane = lane;
    ret oe;
}

rec VecStep {
    op: codegen_mir.MirOpcode;
    d:  codegen_mir.MirOperand;
    x:  codegen_mir.MirOperand;
    y:  codegen_mir.MirOperand;
}

# the shift reads its count at its own width. a count the alu holds in one
# register is read there as its low bits, so it is the shift's count as it
# stands (#3892). a count wider than the alu keeps its low bits here: left
# wide, a narrow shift would read a value nothing defines once its lanes
# replace it, as an index wider than the pointer did (#3615)
fun count_at_shift_width(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction,
    count: codegen_mir.MirOperand, w: u8) res[codegen_mir.MirOperand, fail.Fail] {
    val cw: u8 = mir_context.op_width_of(ctx, inst.operands[1].ty);
    if (cw <= w || count.kind != codegen_mir.MIR_OP_VREG || count_fits_alu(ctx, cw)) { ret res[codegen_mir.MirOperand, fail.Fail].ok{count}; }
    val tr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel tr.err) { ret res[codegen_mir.MirOperand, fail.Fail].err{tr.err}; }
    val t:  codegen_mir.VRegId                    = tr.ok;
    val ar: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
    if (sel ar.err) { ret res[codegen_mir.MirOperand, fail.Fail].err{fail.refused(ar.err)}; }
    val ops: *codegen_mir.MirOperand = ar.ok;
    ops[0] = codegen_mir.op_vreg(t);
    ops[1] = count;
    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_TRUNC, ops, 2, w, cw);
    val er: err[fail.Fail]       = mir_context.push_instr(ctx, mb, mi);
    if (sel er.err) { ret res[codegen_mir.MirOperand, fail.Fail].err{er.err}; }
    ret res[codegen_mir.MirOperand, fail.Fail].ok{codegen_mir.op_vreg(t)};
}

fun count_fits_alu(ctx: *mir_context.LowerCtx, cw: u8) bool {
    val maw: u32 = isa.max_alu_width(?ctx.tgt.model);
    ret maw == 0 || cw::u32 <= maw;
}

fun emit_alu2(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, op: codegen_mir.MirOpcode, d: codegen_mir.MirOperand, a: codegen_mir.MirOperand, w: u8) err[fail.Fail] {
    val r: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *codegen_mir.MirOperand = r.ok;
    ops[0] = d;
    ops[1] = a;
    var mi: codegen_mir.MirInstr = codegen_mir.instr(op, ops, 2, w, w);
    ret mir_context.push_instr(ctx, mb, mi);
}

fun emit_alu3(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, op: codegen_mir.MirOpcode, d: codegen_mir.MirOperand, a: codegen_mir.MirOperand, b: codegen_mir.MirOperand, w: u8) err[fail.Fail] {
    val r: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 3::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *codegen_mir.MirOperand = r.ok;
    ops[0] = d;
    ops[1] = a;
    ops[2] = b;
    var mi: codegen_mir.MirInstr = codegen_mir.instr(op, ops, 3, w, w);
    ret mir_context.push_instr(ctx, mb, mi);
}

# a division or remainder by a constant the plan covers runs the plan's steps
# at its width over the dividend extended to it (#3350)
fun lower_div_plan(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, dst: codegen_mir.VRegId,
    p: *divconst.DivPlan) err[fail.Fail] {
    val natural_w: u8  = mir_context.op_width_of(ctx, inst.ty);
    val w:         u8  = p.width;
    val bits:      u32 = w::u32 * 8;

    val dividend_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[0]);
    if (sel dividend_r.err) { ret err[fail.Fail].err{dividend_r.err}; }
    val nvr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel nvr.err) { ret err[fail.Fail].err{nvr.err}; }
    val ne: err[fail.Fail] = mir_context.emit_promote(ctx, mb, codegen_mir.op_vreg(nvr.ok), dividend_r.ok, w, natural_w, p.signed);
    if (sel ne.err) { ret ne; }

    var vals: [divconst.MAX_STEPS + 1]codegen_mir.MirOperand;
    vals[0] = codegen_mir.op_vreg(nvr.ok);
    var i: u32 = 0;
    for (i < p.len) {
        val s:     *divconst.DivStep = ?p.steps[i];
        var count: u32               = 3;
        if (s.b == divconst.OPERAND_NONE) { count = 2; }
        var b: codegen_mir.MirOperand = codegen_mir.op_imm(0);
        if (s.b == divconst.OPERAND_IMM) {
            val imm: wide.Wide = wide.sext(s.imm, bits);
            b = codegen_mir.op_imm_wide(imm.lo:~i64, imm.hi:~i64);
            if (codegen_mir.operand_requires_reg(s.op, 2)) {
                val cvr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
                if (sel cvr.err) { ret err[fail.Fail].err{cvr.err}; }
                val ce: err[fail.Fail] = mir_context.emit_mov_w(ctx, mb, codegen_mir.op_vreg(cvr.ok), b, w);
                if (sel ce.err) { ret ce; }
                b = codegen_mir.op_vreg(cvr.ok);
            }
        }
        or (count == 3) { b = vals[s.b::u32]; }
        val tr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
        if (sel tr.err) { ret err[fail.Fail].err{tr.err}; }
        val rop: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, count::usize);
        if (sel rop.err) { ret err[fail.Fail].err{fail.refused(rop.err)}; }
        val ops: *codegen_mir.MirOperand = rop.ok;
        ops[0] = codegen_mir.op_vreg(tr.ok);
        ops[1] = vals[s.a::u32];
        if (count == 3) { ops[2] = b; }
        var mi: codegen_mir.MirInstr = codegen_mir.instr(s.op, ops, count, w, w);
        val pd: err[fail.Fail]       = mir_context.push_instr(ctx, mb, mi);
        if (sel pd.err) { ret pd; }
        vals[i + 1] = codegen_mir.op_vreg(tr.ok);
        i           = i + 1;
    }
    ret mir_context.emit_mov_w(ctx, mb, codegen_mir.op_vreg(dst), vals[p.len], natural_w);
}

# the plan for a scalar division by a constant, none for any other
fun div_plan(ctx: *mir_context.LowerCtx, inst: *ir_instruction.Instruction) opt[divconst.DivPlan] {
    val v: value.Value = inst.operands[1];
    if (v.kind != value.VAL_CONST_INT || mir_context.value_is_vector(ctx, inst.ty)) { ret opt[divconst.DivPlan].none{}; }
    val natural_w: u8   = mir_context.op_width_of(ctx, inst.ty);
    val signed:    bool = inst.kind == ir_instruction.OP_DIV_S || inst.kind == ir_instruction.OP_REM_S;
    val rem:       bool = inst.kind == ir_instruction.OP_REM_S || inst.kind == ir_instruction.OP_REM_U;
    ret divconst.plan(value.int_of(?v), natural_w, signed, rem,
        isa.clamp_alu_width(?ctx.tgt.model, natural_w), ctx.tgt.model.mul_hi_width);
}

fun lower_div(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    if (inst.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: division missing dividend or divisor operand")};
    }
    val dst: codegen_mir.VRegId = mir_context.instr_vreg(ctx, iid);
    if (codegen_mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: division defines no result vreg")};
    }
    val dp: opt[divconst.DivPlan] = div_plan(ctx, inst);
    if (sel dp.some) {
        var pl: divconst.DivPlan = dp.some;
        ret lower_div_plan(ctx, mb, inst, dst, ?pl);
    }
    val acc_reg: i32 = ctx.tgt.model.div_reg;
    val hi_reg:  i32 = ctx.tgt.model.div_hi_reg;
    if (acc_reg < 0 || hi_reg < 0) {
        ret lower_div_three_address(ctx, mb, inst, iid, dst);
    }
    val signed: bool = inst.kind == ir_instruction.OP_DIV_S || inst.kind == ir_instruction.OP_REM_S;

    val natural_w: u8 = mir_context.op_width_of(ctx, inst.ty);
    val w:         u8 = isa.clamp_alu_width(?ctx.tgt.model, natural_w);

    val dividend_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[0]);
    if (sel dividend_r.err) { ret err[fail.Fail].err{dividend_r.err}; }
    val dividend:  codegen_mir.MirOperand                 = dividend_r.ok;
    val divisor_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[1]);
    if (sel divisor_r.err) { ret err[fail.Fail].err{divisor_r.err}; }
    val divisor: codegen_mir.MirOperand = divisor_r.ok;

    val mr: err[fail.Fail] = mir_context.emit_promote(ctx, mb, codegen_mir.op_preg(codegen_mir.preg_id(acc_reg)), dividend, w, natural_w, signed);
    if (sel mr.err) { ret mr; }

    var div_op: codegen_mir.MirOperand = divisor;
    if (natural_w < w || divisor.kind == codegen_mir.MIR_OP_IMM) {
        val bvr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
        if (sel bvr.err) { ret err[fail.Fail].err{bvr.err}; }
        val bv: codegen_mir.VRegId = bvr.ok;
        val ex: err[fail.Fail]     = mir_context.emit_promote(ctx, mb, codegen_mir.op_vreg(bv), divisor, w, natural_w, signed);
        if (sel ex.err) { ret ex; }
        div_op = codegen_mir.op_vreg(bv);
    }

    val rop: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
    if (sel rop.err) { ret err[fail.Fail].err{fail.refused(rop.err)}; }
    val ops: *codegen_mir.MirOperand = rop.ok;
    ops[0] = codegen_mir.op_preg(codegen_mir.preg_id(acc_reg));
    ops[1] = div_op;
    val op: res[codegen_mir.MirOpcode, fail.Fail] = lowered_opcode(inst.kind);
    if (sel op.err) { ret err[fail.Fail].err{op.err}; }
    var mi: codegen_mir.MirInstr = codegen_mir.instr(op.ok, ops, 2, w, w);
    val pd: err[fail.Fail]       = mir_context.push_instr(ctx, mb, mi);
    if (sel pd.err) { ret pd; }

    var res_reg: i32 = acc_reg;
    if (inst.kind == ir_instruction.OP_REM_S || inst.kind == ir_instruction.OP_REM_U) {
        res_reg = hi_reg;
    }
    ret mir_context.emit_mov_w(ctx, mb, codegen_mir.op_vreg(dst), codegen_mir.op_preg(codegen_mir.preg_id(res_reg)), natural_w);
}

fun lower_div_three_address(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction,
    iid: ir_id.InstructionId, dst: codegen_mir.VRegId) err[fail.Fail] {
    val signed: bool = inst.kind == ir_instruction.OP_DIV_S || inst.kind == ir_instruction.OP_REM_S;

    val natural_w: u8 = mir_context.op_width_of(ctx, inst.ty);
    val w:         u8 = isa.clamp_alu_width(?ctx.tgt.model, natural_w);

    val dividend_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[0]);
    if (sel dividend_r.err) { ret err[fail.Fail].err{dividend_r.err}; }
    val dividend:  codegen_mir.MirOperand                 = dividend_r.ok;
    val divisor_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[1]);
    if (sel divisor_r.err) { ret err[fail.Fail].err{divisor_r.err}; }
    val divisor: codegen_mir.MirOperand = divisor_r.ok;

    var n_op: codegen_mir.MirOperand = dividend;
    if (natural_w < w || dividend.kind == codegen_mir.MIR_OP_IMM) {
        val nvr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
        if (sel nvr.err) { ret err[fail.Fail].err{nvr.err}; }
        val nv: codegen_mir.VRegId = nvr.ok;
        val ne: err[fail.Fail]     = mir_context.emit_promote(ctx, mb, codegen_mir.op_vreg(nv), dividend, w, natural_w, signed);
        if (sel ne.err) { ret ne; }
        n_op = codegen_mir.op_vreg(nv);
    }

    var m_op: codegen_mir.MirOperand = divisor;
    if (natural_w < w || divisor.kind == codegen_mir.MIR_OP_IMM) {
        val mvr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
        if (sel mvr.err) { ret err[fail.Fail].err{mvr.err}; }
        val mv: codegen_mir.VRegId = mvr.ok;
        val me: err[fail.Fail]     = mir_context.emit_promote(ctx, mb, codegen_mir.op_vreg(mv), divisor, w, natural_w, signed);
        if (sel me.err) { ret me; }
        m_op = codegen_mir.op_vreg(mv);
    }

    val rop: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 3::usize);
    if (sel rop.err) { ret err[fail.Fail].err{fail.refused(rop.err)}; }
    val ops: *codegen_mir.MirOperand = rop.ok;
    ops[0] = codegen_mir.op_vreg(dst);
    ops[1] = n_op;
    ops[2] = m_op;
    val op: res[codegen_mir.MirOpcode, fail.Fail] = lowered_opcode(inst.kind);
    if (sel op.err) { ret err[fail.Fail].err{op.err}; }
    var mi: codegen_mir.MirInstr = codegen_mir.instr(op.ok, ops, 3, w, w);
    ret mir_context.push_instr(ctx, mb, mi);
}

# the MIR opcode of a kind its lowering emits by the IR-to-MIR table; a kind
# with no row reaching here is a dispatch defect
fun lowered_opcode(k: ir_instruction.InstrKind) res[codegen_mir.MirOpcode, fail.Fail] {
    val op: codegen_mir.MirOpcode = codegen_mir.lowered_opcode(k);
    if (op == codegen_mir.MIR_OP_NONE) {
        ret res[codegen_mir.MirOpcode, fail.Fail].err{fail.message("mir.lower_ir: an instruction kind with no MIR opcode reached a lowering by kind")};
    }
    ret res[codegen_mir.MirOpcode, fail.Fail].ok{op};
}

fun lower_generic(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    val dst:     codegen_mir.VRegId                    = mir_context.instr_vreg(ctx, iid);
    val has_dst: bool                                  = !codegen_mir.vreg_is_nil(dst);
    val mapped:  res[codegen_mir.MirOpcode, fail.Fail] = lowered_opcode(inst.kind);
    if (sel mapped.err) { ret err[fail.Fail].err{mapped.err}; }
    var kind:  codegen_mir.MirOpcode = mapped.ok;
    var first: u32                   = 0;
    # `0 - x` is the target's negate, with no zero to materialize
    if (is_zero_minuend(ctx, inst)) {
        kind  = codegen_mir.MIR_NEG;
        first = 1;
    }
    var total: u32 = inst.operand_count - first;
    if (has_dst) { total = total + 1; }

    var ops: *codegen_mir.MirOperand = nil;
    if (total > 0) {
        val rop: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, total::usize);
        if (sel rop.err) { ret err[fail.Fail].err{fail.refused(rop.err)}; }
        ops = rop.ok;
    }

    var base: u32 = 0;
    if (has_dst) {
        ops[0] = codegen_mir.op_vreg(dst);
        base   = 1;
    }

    var k: u32 = first;
    for (k < inst.operand_count) {
        val op_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_operand(ctx, inst, k);
        if (sel op_r.err) { ret err[fail.Fail].err{op_r.err}; }
        var op: codegen_mir.MirOperand = op_r.ok;
        if (op.kind == codegen_mir.MIR_OP_SYM) {
            var av: codegen_mir.VRegId = codegen_mir.MIR_VREG_NIL;
            val ar: err[fail.Fail]     = mir_context.addr_to_vreg(ctx, mb, op, ?av);
            if (sel ar.err) { ret ar; }
            op = codegen_mir.op_vreg(av);
        }
        if (op.kind == codegen_mir.MIR_OP_IMM && codegen_mir.operand_requires_reg(kind, base + k - first)) {
            val cvr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
            if (sel cvr.err) { ret err[fail.Fail].err{cvr.err}; }
            val cv: codegen_mir.VRegId = cvr.ok;
            val cw: u8                 = mir_context.op_width_of(ctx, inst.operands[k].ty);
            val ce: err[fail.Fail]     = mir_context.emit_mov_w(ctx, mb, codegen_mir.op_vreg(cv), op, cw);
            if (sel ce.err) { ret ce; }
            op = codegen_mir.op_vreg(cv);
        }
        ops[base + k - first] = op;
        k                     = k + 1;
    }

    var mi: codegen_mir.MirInstr = codegen_mir.instr(kind, ops, total, 0, 0);
    set_generic_widths(ctx, inst, ?mi);
    ret mir_context.push_instr(ctx, mb, mi);
}

# a scalar integer subtraction from the constant zero; a float's `0.0 - x` is
# not `-x` when x is +0.0
fun is_zero_minuend(ctx: *mir_context.LowerCtx, inst: *ir_instruction.Instruction) bool {
    if (inst.kind != ir_instruction.OP_SUB || inst.operand_count != 2) { ret false; }
    val minuend: value.Value = inst.operands[0];
    if (minuend.kind != value.VAL_CONST_INT || !wide.is_zero(value.int_of(?minuend))) { ret false; }
    if (mir_context.value_is_float(ctx, inst.ty))                                     { ret false; }
    ret !instr_touches_vector(ctx, inst);
}

fun set_generic_widths(ctx: *mir_context.LowerCtx, inst: *ir_instruction.Instruction, mi: *codegen_mir.MirInstr) {
    if (is_float_kind(ctx, inst)) {
        set_conv_widths(ctx, inst, mi);
        ret;
    }
    if (is_compare_kind(inst.kind) && inst.operand_count >= 1) {
        val w: u8 = mir_context.op_width_of(ctx, inst.operands[0].ty);
        mi.width     = w;
        mi.src_width = w;
        ret;
    }
    var dw: u8 = ctx.tgt.model.gpr_width::u8;
    if (!opdesc.is_terminator(inst.kind)) { dw = mir_context.op_width_of(ctx, inst.ty); }
    if (is_int_alu_kind(inst.kind))       { dw = isa.clamp_alu_width(?ctx.tgt.model, dw); }
    var sw: u8 = dw;
    if (is_int_conversion_kind(inst.kind) && inst.operand_count >= 1) {
        sw = mir_context.op_width_of(ctx, inst.operands[0].ty);
    }
    # a widening multiply's source width is its operand's, half its result; a
    # lane-halving extension, a lane interleave, a lane range and a widening
    # group sum read their operand the same way
    if ((inst.kind == ir_instruction.OP_MUL_WIDE_S || inst.kind == ir_instruction.OP_MUL_WIDE_U
        || inst.kind == ir_instruction.OP_VEC_WIDEN_S || inst.kind == ir_instruction.OP_VEC_WIDEN_U
        || inst.kind == ir_instruction.OP_VEC_INTERLEAVE || inst.kind == ir_instruction.OP_VEC_RANGE
        || inst.kind == ir_instruction.OP_VEC_WIDEN_SUM_U) && inst.operand_count >= 1) {
        sw = mir_context.op_width_of(ctx, inst.operands[0].ty);
    }
    mi.width     = dw;
    mi.src_width = sw;
}

fun set_conv_widths(ctx: *mir_context.LowerCtx, inst: *ir_instruction.Instruction, mi: *codegen_mir.MirInstr) {
    var dw: u8 = mir_context.op_width_of(ctx, inst.ty);
    var sw: u8 = dw;
    if (inst.operand_count >= 1) { sw = mir_context.op_width_of(ctx, inst.operands[0].ty); }
    mi.width     = dw;
    mi.src_width = sw;
}

fun is_int_alu_kind(k: ir_instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_INT_ALU);
}

fun is_compare_kind(k: ir_instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_COMPARE);
}

fun is_vector_compute(k: ir_instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_VEC_COMPUTE);
}

fun is_int_conversion_kind(k: ir_instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_INT_CONVERSION);
}

fun is_float_op(ctx: *mir_context.LowerCtx, inst: *ir_instruction.Instruction) bool {
    val k:      ir_instruction.InstrKind = inst.kind;
    var shared: bool                     = false;
    if (k == ir_instruction.OP_ADD || k == ir_instruction.OP_SUB || k == ir_instruction.OP_MUL ||
        k == ir_instruction.OP_DIV_S || k == ir_instruction.OP_DIV_U) { shared = true; }
    if (is_compare_kind(k))                                                              { shared = true; }
    if (!shared)                                                                         { ret false; }
    if (mir_context.value_is_float(ctx, inst.ty))                                        { ret true; }
    if (inst.operand_count >= 1 && mir_context.value_is_float(ctx, inst.operands[0].ty)) { ret true; }
    ret false;
}

fun float_op_width(ctx: *mir_context.LowerCtx, inst: *ir_instruction.Instruction) u8 {
    if (is_compare_kind(inst.kind) && inst.operand_count >= 1) {
        ret mir_context.op_width_of(ctx, inst.operands[0].ty);
    }
    ret mir_context.op_width_of(ctx, inst.ty);
}

# an opcode a lowering dispatch reaches that no arm names: a defect, reported
# through the catalog policy in the lowering context's interner
fun unknown_kind(ctx: *mir_context.LowerCtx, k: ir_instruction.InstrKind, where: str) err[fail.Fail] {
    ret err[fail.Fail].err{fail.message(fail.catalog_message_or(ctx.interner, ctx.alloc,
        fail.unknown_member_in("InstrKind", k::u32, where), "unknown InstrKind tag in the float lowering"))};
}

# the float condition code of a compare opcode; absent for an opcode outside
# the compare set, which the caller reports as an unknown member
fun float_cmp_cc(k: ir_instruction.InstrKind) opt[u8] {
    if (k == ir_instruction.OP_CMP_EQ)                                      { ret opt[u8].some{codegen_mir.FCC_EQ}; }
    if (k == ir_instruction.OP_CMP_NE)                                      { ret opt[u8].some{codegen_mir.FCC_NE}; }
    if (k == ir_instruction.OP_CMP_LT_S || k == ir_instruction.OP_CMP_LT_U) { ret opt[u8].some{codegen_mir.FCC_LT}; }
    if (k == ir_instruction.OP_CMP_LE_S || k == ir_instruction.OP_CMP_LE_U) { ret opt[u8].some{codegen_mir.FCC_LE}; }
    ret opt[u8].none{};
}

fun lower_float_op(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    if (inst.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: float op missing operand")};
    }
    val dst: codegen_mir.VRegId = mir_context.instr_vreg(ctx, iid);
    if (codegen_mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: float op defines no result vreg")};
    }

    val rop: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 3::usize);
    if (sel rop.err) { ret err[fail.Fail].err{fail.refused(rop.err)}; }
    val ops: *codegen_mir.MirOperand = rop.ok;
    ops[0] = codegen_mir.op_vreg(dst);
    val lowered_4: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[0]);
    if (sel lowered_4.err) { ret err[fail.Fail].err{lowered_4.err}; }
    ops[1] = lowered_4.ok;
    val lowered_5: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[1]);
    if (sel lowered_5.err) { ret err[fail.Fail].err{lowered_5.err}; }
    ops[2] = lowered_5.ok;

    val w: u8 = float_op_width(ctx, inst);

    val k:  ir_instruction.InstrKind = inst.kind;
    var op: codegen_mir.MirOpcode    = codegen_mir.MIR_FDIV;
    var sw: u8                       = w;
    if (is_compare_kind(k)) {
        val cc: opt[u8] = float_cmp_cc(k);
        if (sel cc.none) { ret unknown_kind(ctx, k, "the float lowering"); }
        op = codegen_mir.MIR_FCMP;
        sw = cc.some;
    }
    or (k == ir_instruction.OP_ADD) {
        op = codegen_mir.MIR_FADD;
    }
    or (k == ir_instruction.OP_SUB) {
        op = codegen_mir.MIR_FSUB;
    }
    or (k == ir_instruction.OP_MUL) {
        op = codegen_mir.MIR_FMUL;
    }
    or (k == ir_instruction.OP_DIV_S || k == ir_instruction.OP_DIV_U) {
        op = codegen_mir.MIR_FDIV;
    }
    or {
        ret unknown_kind(ctx, k, "the float lowering");
    }

    var mi: codegen_mir.MirInstr = codegen_mir.instr(op, ops, 3, w, sw);
    ret mir_context.push_instr(ctx, mb, mi);
}

fun bitcast_needs_frame(ctx: *mir_context.LowerCtx, inst: *ir_instruction.Instruction) bool {
    if (inst.operand_count < 1) { ret false; }

    val dst_float: bool = mir_context.value_is_float(ctx, inst.ty);
    val src_float: bool = mir_context.value_is_float(ctx, inst.operands[0].ty);
    if (dst_float == src_float) { ret false; }

    if (mir_context.value_is_vector(ctx, inst.ty))             { ret false; }
    if (mir_context.value_is_vector(ctx, inst.operands[0].ty)) { ret false; }

    val w: u8 = mir_context.op_width_of(ctx, inst.ty);
    if (w == 0) { ret false; }
    ret !isa.moves_cross_bank(?ctx.tgt.model, w::u32);
}

fun lower_bitcast_via_frame(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    val dst: codegen_mir.VRegId = mir_context.instr_vreg(ctx, iid);
    if (codegen_mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: cross-bank reinterpret defines no result vreg")};
    }
    val w: u8 = mir_context.op_width_of(ctx, inst.ty);

    val skr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel skr.err) { ret err[fail.Fail].err{skr.err}; }
    val sk: codegen_mir.VRegId = skr.ok;

    val ar: err[fail.Fail] = mir_context.add_spill_slot_aligned(ctx, sk.n, w::u64, w::u32);
    if (sel ar.err) { ret ar; }

    val sr: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
    if (sel sr.err) { ret err[fail.Fail].err{fail.refused(sr.err)}; }
    val sops: *codegen_mir.MirOperand = sr.ok;
    sops[0] = codegen_mir.op_mem_slot(sk, 0);
    val lowered_6: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[0]);
    if (sel lowered_6.err) { ret err[fail.Fail].err{lowered_6.err}; }
    sops[1] = lowered_6.ok;
    var si:  codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_MOV, sops, 2, w, w);
    val spr: err[fail.Fail]       = mir_context.push_instr(ctx, mb, si);
    if (sel spr.err) { ret spr; }

    val lr: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
    if (sel lr.err) { ret err[fail.Fail].err{fail.refused(lr.err)}; }
    val lops: *codegen_mir.MirOperand = lr.ok;
    lops[0] = codegen_mir.op_vreg(dst);
    lops[1] = codegen_mir.op_mem_slot(sk, 0);
    var li: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_MOV, lops, 2, w, w);
    ret mir_context.push_instr(ctx, mb, li);
}

fun lower_float_neg(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    if (inst.operand_count < 1) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: float negate missing operand")};
    }
    val dst: codegen_mir.VRegId = mir_context.instr_vreg(ctx, iid);
    if (codegen_mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: float negate defines no result vreg")};
    }

    val rop: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
    if (sel rop.err) { ret err[fail.Fail].err{fail.refused(rop.err)}; }
    val ops: *codegen_mir.MirOperand = rop.ok;
    ops[0] = codegen_mir.op_vreg(dst);
    val lowered_7: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[0]);
    if (sel lowered_7.err) { ret err[fail.Fail].err{lowered_7.err}; }
    ops[1] = lowered_7.ok;

    val w: u8 = mir_context.op_width_of(ctx, inst.ty);

    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_FNEG, ops, 2, w, w);
    ret mir_context.push_instr(ctx, mb, mi);
}

fun is_float_kind(ctx: *mir_context.LowerCtx, inst: *ir_instruction.Instruction) bool {
    if (opdesc.has(inst.kind, opdesc.EFF_FP_CONVERT))                                    { ret true; }
    if (mir_context.value_is_float(ctx, inst.ty))                                        { ret true; }
    if (inst.operand_count >= 1 && mir_context.value_is_float(ctx, inst.operands[0].ty)) { ret true; }
    ret false;
}

fun lower_alloca(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    if (inst.operand_count == 0) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: alloca with no count operand")};
    }
    val cv: value.Value = inst.operands[0];
    if (cv.kind != value.VAL_CONST_INT) {
        ret err[fail.Fail].err{mir_context.reject(ctx, diagnostic_kind.ALLOCA_VARIABLE_SIZE, "variable-length alloca is not supported; use a constant size")};
    }
    val count: u64 = cv.data.int_lit;

    val elem_size:  u32 = ir_type.byte_size_for_machine(ctx.types, inst.aux_ty, ctx.layout);
    val elem_align: u32 = ir_type.byte_align_for_machine(ctx.types, inst.aux_ty, ctx.layout);
    val total:      u64 = elem_size::u64 * count;

    val dst: codegen_mir.VRegId = mir_context.instr_vreg(ctx, iid);
    if (codegen_mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: alloca defines no result vreg")};
    }

    # the image of the returned value is the caller's result storage (#4120)
    if (mir_context.is_result_image(ctx, iid)) {
        ret mir_context.emit_mov_w(ctx, mb, codegen_mir.op_vreg(dst), codegen_mir.op_vreg(ctx.sret_vreg), ctx.tgt.model.pointer_width::u8);
    }

    val skr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel skr.err) { ret err[fail.Fail].err{skr.err}; }
    val sk: codegen_mir.VRegId = skr.ok;

    val ar: err[fail.Fail] = mir_context.add_alloca_slot(ctx, sk.n, total, elem_align, inst.aux_ty::u32);
    if (sel ar.err) { ret ar; }
    mir_context.set_slot_origin(ctx, sk.n, iid::u32);

    if (ctx.slot_key_vregs != nil && iid::u32 < ctx.instr_count) {
        ctx.slot_key_vregs[iid::u32] = sk;
    }

    val r: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *codegen_mir.MirOperand = r.ok;
    ops[0] = codegen_mir.op_vreg(dst);
    ops[1] = codegen_mir.op_mem_slot(sk, 0);
    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_ALLOCA, ops, 2,
        ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
    ret mir_context.push_instr(ctx, mb, mi);
}

fun lower_vec_extract(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    val dst: codegen_mir.VRegId = mir_context.instr_vreg(ctx, iid);
    if (codegen_mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: vector lane read defines no result vreg")};
    }
    if (inst.operands[1].kind != value.VAL_CONST_INT) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: vector lane index is not a constant")};
    }

    val r: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 3::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *codegen_mir.MirOperand = r.ok;
    ops[0] = codegen_mir.op_vreg(dst);
    val lowered_8: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[0]);
    if (sel lowered_8.err) { ret err[fail.Fail].err{lowered_8.err}; }
    ops[1] = lowered_8.ok;
    ops[2] = codegen_mir.op_imm(inst.operands[1].data.int_lit::i64);

    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_VEC_EXTRACT, ops, 3, mir_context.op_width_of(ctx, inst.ty), mir_context.op_width_of(ctx, inst.operands[0].ty));
    ret mir_context.push_instr(ctx, mb, mi);
}

fun lower_vec_insert(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    val dst: codegen_mir.VRegId = mir_context.instr_vreg(ctx, iid);
    if (codegen_mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: vector lane write defines no result vreg")};
    }
    if (inst.operands[1].kind != value.VAL_CONST_INT) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: vector lane index is not a constant")};
    }

    val r: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 4::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *codegen_mir.MirOperand = r.ok;
    ops[0] = codegen_mir.op_vreg(dst);
    val lowered_9: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[0]);
    if (sel lowered_9.err) { ret err[fail.Fail].err{lowered_9.err}; }
    ops[1] = lowered_9.ok;
    ops[2] = codegen_mir.op_imm(inst.operands[1].data.int_lit::i64);
    val lowered_10: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[2]);
    if (sel lowered_10.err) { ret err[fail.Fail].err{lowered_10.err}; }
    ops[3] = lowered_10.ok;

    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_VEC_INSERT, ops, 4, mir_context.op_width_of(ctx, inst.ty), mir_context.op_width_of(ctx, inst.operands[2].ty));
    ret mir_context.push_instr(ctx, mb, mi);
}

# a variable whose value type legalization split is bound to each piece, the
# k-th register-width part of it, and the last the lanes left (#3589)
fun lower_dbg_pieces(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    val lanes: u8  = inst.operand_count::u8;
    val bytes: u8  = ir_type.byte_size_for_machine(ctx.types, inst.operands[0].ty, ctx.layout)::u8;
    val last:  u8  = ir_type.byte_size_for_machine(ctx.types, inst.operands[inst.operand_count - 1].ty, ctx.layout)::u8;
    var k:     u32 = 0;
    for (k < inst.operand_count) {
        val op_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[k]);
        if (sel op_r.err) { ret err[fail.Fail].err{op_r.err}; }
        if (op_r.ok.kind == codegen_mir.MIR_OP_VREG) {
            val vreg:  codegen_mir.VRegId = op_r.ok.vreg;
            var bound: bool               = false;
            if (mb.instr_count > 0) {
                val tail: *codegen_mir.MirInstr = ?mb.instrs[mb.instr_count - 1];
                if (instr_defines_vreg(tail, vreg)) {
                    val r: err[fail.Fail] = codegen_mir.instr_attach_dbg_piece(ctx.alloc, tail, iid::u32, vreg.n, k::u8, lanes, bytes, last, true);
                    if (sel r.err) { ret r; }
                    bound = true;
                }
            }
            if (!bound) {
                val r: err[fail.Fail] = mir_context.push_pending_dbg_piece(ctx, iid::u32, vreg.n, k::u8, lanes, bytes, last);
                if (sel r.err) { ret r; }
            }
        }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

# a join of n parts is n - 1 joins of two, each appending the next part to
# the lanes joined so far, the last into the result (#3589)
fun lower_vec_concat(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    val dst: codegen_mir.VRegId = mir_context.instr_vreg(ctx, iid);
    if (codegen_mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: lane join defines no result vreg")};
    }
    if (inst.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: lane join of fewer than two parts")};
    }
    val lane:  u32                                    = mir_context.vec_lane_for_type(ctx, inst.ty);
    val w:     u8                                     = mir_context.op_width_of(ctx, inst.ty);
    val acc_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[0]);
    if (sel acc_r.err) { ret err[fail.Fail].err{acc_r.err}; }
    var acc:   codegen_mir.MirOperand = acc_r.ok;
    var lanes: u32                    = codegen_mir.vec_lane_count(mir_context.vec_lane_for_type(ctx, inst.operands[0].ty));
    var i:     u32                    = 1;
    for (i < inst.operand_count) {
        val part_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[i]);
        if (sel part_r.err) { ret err[fail.Fail].err{part_r.err}; }
        var out: codegen_mir.VRegId = dst;
        if (i + 1 < inst.operand_count) {
            val tr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg_vec(ctx, ctx.f.vregs[dst.n].class, ctx.f.vregs[dst.n].vec_bytes);
            if (sel tr.err) { ret err[fail.Fail].err{tr.err}; }
            ctx.f.vregs[tr.ok.n].ty = inst.ty::u32;
            out                     = tr.ok;
        }
        val after: u32                                   = lanes + codegen_mir.vec_lane_count(mir_context.vec_lane_for_type(ctx, inst.operands[i].ty));
        val r:     res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 4::usize);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        val ops: *codegen_mir.MirOperand = r.ok;
        ops[0]           = codegen_mir.op_vreg(out);
        ops[1]           = acc;
        ops[2]           = part_r.ok;
        ops[3]           = codegen_mir.op_imm(lanes::i64);
        ctx.cur_vec_lane = codegen_mir.vec_lane_make(codegen_mir.vec_lane_kind(lane), codegen_mir.vec_lane_elem_bytes(lane), after);
        var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_VEC_CONCAT, ops, 4, w, w);
        val pe: err[fail.Fail]       = mir_context.push_instr(ctx, mb, mi);
        ctx.cur_vec_lane = lane;
        if (sel pe.err) { ret pe; }
        acc   = codegen_mir.op_vreg(out);
        lanes = after;
        i     = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun lower_vec_build(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    val dst: codegen_mir.VRegId = mir_context.instr_vreg(ctx, iid);
    if (codegen_mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: vector build defines no result vreg")};
    }
    if (inst.operand_count == 0) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: vector build with no lanes")};
    }

    val n: u32                                   = inst.operand_count + 1;
    val r: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, n::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *codegen_mir.MirOperand = r.ok;
    ops[0] = codegen_mir.op_vreg(dst);
    var i: u32 = 0;
    for (i < inst.operand_count) {
        val lowered_11: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[i]);
        if (sel lowered_11.err) { ret err[fail.Fail].err{lowered_11.err}; }
        ops[1 + i] = lowered_11.ok;
        i          = i + 1;
    }

    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_VEC_BUILD, ops, n, mir_context.op_width_of(ctx, inst.ty), 0);
    ret mir_context.push_instr(ctx, mb, mi);
}

fun lower_load(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    if (inst.operand_count == 0) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: load with no pointer operand")};
    }
    val dst: codegen_mir.VRegId = mir_context.instr_vreg(ctx, iid);
    if (codegen_mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: load defines no result vreg")};
    }
    val mem_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.mem_operand_of(ctx, inst.operands[0]);
    if (sel mem_r.err) { ret err[fail.Fail].err{mem_r.err}; }
    var mem: codegen_mir.MirOperand = mem_r.ok;
    if (ctx.tgt.model.flat_addressing && mem.kind == codegen_mir.MIR_OP_SYM && mir_context.value_is_float(ctx, inst.ty)) {
        var base: codegen_mir.VRegId = codegen_mir.MIR_VREG_NIL;
        val ar:   err[fail.Fail]     = mir_context.addr_to_vreg(ctx, mb, mem, ?base);
        if (sel ar.err) { ret ar; }
        mem = codegen_mir.op_mem_value(base, 0);
    }
    val r: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *codegen_mir.MirOperand = r.ok;
    ops[0] = codegen_mir.op_vreg(dst);
    ops[1] = mem;
    val acc_w: u8 = mir_context.mem_width_of(ctx, inst.ty);
    val reg_w: u8 = mir_context.op_width_of(ctx, inst.ty);
    if (mir_context.subwidth_vector_memory(ctx, inst.ty)) {
        ret mir_context.load_subwidth_vector(ctx, mb, ops[0], ops[1], inst.ty);
    }
    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_LOAD, ops, 2,
        isa.clamp_alu_width(?ctx.tgt.model, reg_w), acc_w);
    ret mir_context.push_instr(ctx, mb, mi);
}

fun lower_store(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction) err[fail.Fail] {
    if (inst.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: store missing value or pointer operand")};
    }
    if (mir_context.value_is_aggregate(ctx, inst.operands[0].ty)) {
        ret lower_store_aggregate(ctx, mb, inst);
    }
    val stored_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[0]);
    if (sel stored_r.err) { ret err[fail.Fail].err{stored_r.err}; }
    var stored: codegen_mir.MirOperand = stored_r.ok;
    if (stored.kind == codegen_mir.MIR_OP_SYM) {
        var addr: codegen_mir.VRegId = codegen_mir.MIR_VREG_NIL;
        val ar:   err[fail.Fail]     = mir_context.addr_to_vreg(ctx, mb, stored, ?addr);
        if (sel ar.err) { ret ar; }
        stored = codegen_mir.op_vreg(addr);
    }
    val dest_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.mem_operand_of(ctx, inst.operands[1]);
    if (sel dest_r.err) { ret err[fail.Fail].err{dest_r.err}; }
    var dest: codegen_mir.MirOperand = dest_r.ok;
    if (ctx.tgt.model.flat_addressing && dest.kind == codegen_mir.MIR_OP_SYM && mir_context.value_is_float(ctx, inst.operands[0].ty)) {
        var dbase: codegen_mir.VRegId = codegen_mir.MIR_VREG_NIL;
        val dr:    err[fail.Fail]     = mir_context.addr_to_vreg(ctx, mb, dest, ?dbase);
        if (sel dr.err) { ret dr; }
        dest = codegen_mir.op_mem_value(dbase, 0);
    }
    val r: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *codegen_mir.MirOperand = r.ok;
    ops[0] = dest;
    ops[1] = stored;
    val st_w:  u8 = mir_context.mem_width_of(ctx, inst.operands[0].ty);
    val src_w: u8 = mir_context.op_width_of(ctx, inst.operands[0].ty);
    if (mir_context.subwidth_vector_memory(ctx, inst.operands[0].ty)) {
        ret mir_context.store_subwidth_vector(ctx, mb, ops[0], ops[1], inst.operands[0].ty);
    }
    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_STORE, ops, 2, st_w, src_w);
    ret mir_context.push_instr(ctx, mb, mi);
}

fun lower_store_aggregate(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction) err[fail.Fail] {
    val size:   u32                                    = ir_type.byte_size_for_machine(ctx.types, inst.operands[0].ty, ctx.layout);
    val dest_r: res[codegen_mir.MirOperand, fail.Fail] = agg_pointer_mem(ctx, inst.operands[1], 0);
    if (sel dest_r.err) { ret err[fail.Fail].err{dest_r.err}; }
    val src_r: res[codegen_mir.MirOperand, fail.Fail] = agg_pointer_mem(ctx, inst.operands[0], 0);
    if (sel src_r.err) { ret err[fail.Fail].err{src_r.err}; }
    ret mir_context.copy_aggregate(ctx, mb, dest_r.ok, src_r.ok, size::u64);
}

fun lower_memzero(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction) err[fail.Fail] {
    if (inst.operand_count < 1) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: memzero missing destination pointer operand")};
    }
    if (inst.aux_ty == ir_type.IRT_NIL) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: memzero is missing its pointee type")};
    }
    val size: u32 = ir_type.byte_size_for_machine(ctx.types, inst.aux_ty, ctx.layout);

    val r: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops:        *codegen_mir.MirOperand                = r.ok;
    val lowered_12: res[codegen_mir.MirOperand, fail.Fail] = agg_pointer_mem(ctx, inst.operands[0], 0);
    if (sel lowered_12.err) { ret err[fail.Fail].err{lowered_12.err}; }
    ops[0] = lowered_12.ok;
    ops[1] = codegen_mir.op_imm(size::i64);
    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_MEMZERO, ops, 2,
        ctx.tgt.model.pointer_width::u8, ctx.tgt.model.pointer_width::u8);
    ret mir_context.push_instr(ctx, mb, mi);
}

fun agg_pointer_mem(ctx: *mir_context.LowerCtx, v: value.Value, disp: i64) res[codegen_mir.MirOperand, fail.Fail] {
    val op_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, v);
    if (sel op_r.err) { ret op_r; }
    val op: codegen_mir.MirOperand = op_r.ok;
    if (op.kind == codegen_mir.MIR_OP_VREG) { ret res[codegen_mir.MirOperand, fail.Fail].ok{codegen_mir.op_mem_value(op.vreg, disp)}; }
    if (op.kind == codegen_mir.MIR_OP_SYM) {
        var so: codegen_mir.MirOperand = codegen_mir.op_sym(op.sym, op.sym_off + disp);
        so.sym_got = op.sym_got;
        ret res[codegen_mir.MirOperand, fail.Fail].ok{so};
    }
    ret res[codegen_mir.MirOperand, fail.Fail].ok{op};
}

# the memory operand of an element address that needs no instruction of its
# own: a register, frame or symbol base, constant indices folded into the
# displacement, and at most one runtime index whose stride the addressing
# mode scales, on a register base. blocks are lowered in index order and the
# address may be defined after its uses, so a folded address is computed
# from the IR alone, never from lowered state
pub fun pure_gep_mem(ctx: *mir_context.LowerCtx, inst: *ir_instruction.Instruction) opt[codegen_mir.MirOperand] {
    if (inst.operand_count < 2 || inst.aux_ty == ir_type.IRT_NIL) { ret opt[codegen_mir.MirOperand].none{}; }
    val base_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.mem_operand_of_plain(ctx, inst.operands[0]);
    if (sel base_r.err) { ret opt[codegen_mir.MirOperand].none{}; }
    val base: codegen_mir.MirOperand = base_r.ok;
    if (base.kind != codegen_mir.MIR_OP_MEM && base.kind != codegen_mir.MIR_OP_SYM) { ret opt[codegen_mir.MirOperand].none{}; }

    var disp:      i64                = 0;
    var idx_vreg:  codegen_mir.VRegId = codegen_mir.MIR_VREG_NIL;
    var idx_scale: u8                 = 0;
    var cur_ty:    ir_type.IrTypeId   = inst.aux_ty;
    var k:         u32                = 1;
    for (k < inst.operand_count) {
        val v:         value.Value = inst.operands[k];
        var stride:    u64         = 0;
        var is_struct: bool        = false;
        if (k == 1) {
            stride = ir_type.byte_size_for_machine(ctx.types, cur_ty, ctx.layout)::u64;
        }
        or {
            val ct_opt: opt[*ir_type.IrType] = ir_type.get(ctx.types, cur_ty);
            if (!sel ct_opt.some) { ret opt[codegen_mir.MirOperand].none{}; }
            val ct: *ir_type.IrType = ct_opt.some;
            if (ct.kind == ir_type.IRT_ARRAY) {
                stride = ir_type.byte_size_for_machine(ctx.types, ct.data.array_.element, ctx.layout)::u64;
                cur_ty = ct.data.array_.element;
            }
            or (ct.kind == ir_type.IRT_VECTOR) {
                stride = ir_type.byte_size_for_machine(ctx.types, ct.data.vector_.element, ctx.layout)::u64;
                cur_ty = ct.data.vector_.element;
            }
            or (ct.kind == ir_type.IRT_STRUCT || ct.kind == ir_type.IRT_UNION || ct.kind == ir_type.IRT_TAG) {
                is_struct = true;
            }
            or {
                ret opt[codegen_mir.MirOperand].none{};
            }
        }
        if (is_struct) {
            if (v.kind != value.VAL_CONST_INT) { ret opt[codegen_mir.MirOperand].none{}; }
            val fo: res[i64, fail.Fail] = struct_field_offset(ctx, cur_ty, v.data.int_lit::u32);
            if (sel fo.err) { ret opt[codegen_mir.MirOperand].none{}; }
            disp = disp + fo.ok;
            val ft: res[ir_type.IrTypeId, fail.Fail] = struct_field_type(ctx, cur_ty, v.data.int_lit::u32);
            if (sel ft.err) { ret opt[codegen_mir.MirOperand].none{}; }
            cur_ty = ft.ok;
        }
        or (v.kind == value.VAL_CONST_INT) {
            disp = disp + (v.data.int_lit * stride)::i64;
        }
        or {
            if (!codegen_mir.vreg_is_nil(idx_vreg) || !is_sib_scale(stride) || base.kind != codegen_mir.MIR_OP_MEM) { ret opt[codegen_mir.MirOperand].none{}; }
            if (v.kind != value.VAL_INSTR && v.kind != value.VAL_PARAM)                                             { ret opt[codegen_mir.MirOperand].none{}; }
            val iv: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, v);
            if (sel iv.err)                            { ret opt[codegen_mir.MirOperand].none{}; }
            if (iv.ok.kind != codegen_mir.MIR_OP_VREG) { ret opt[codegen_mir.MirOperand].none{}; }
            idx_vreg  = iv.ok.vreg;
            idx_scale = stride::u8;
        }
        k = k + 1;
    }

    var o: codegen_mir.MirOperand = base;
    if (base.kind == codegen_mir.MIR_OP_SYM) {
        o.sym_off = base.sym_off + disp;
        if (!isa.sym_offset_folds(?ctx.tgt.model, o.sym_off)) { ret opt[codegen_mir.MirOperand].none{}; }
        ret opt[codegen_mir.MirOperand].some{o};
    }
    o.imm = base.imm + disp;
    if (!isa.mem_disp_folds(?ctx.tgt.model, o.imm)) { ret opt[codegen_mir.MirOperand].none{}; }
    if (!codegen_mir.vreg_is_nil(idx_vreg)) {
        o.index = codegen_mir.index_vreg(idx_vreg);
        o.scale = idx_scale;
    }
    ret opt[codegen_mir.MirOperand].some{o};
}

fun lower_gep(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction, iid: ir_id.InstructionId) err[fail.Fail] {
    if (inst.operand_count == 0) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: gep with no base operand")};
    }
    val dst: codegen_mir.VRegId = mir_context.instr_vreg(ctx, iid);
    if (codegen_mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: gep defines no result vreg")};
    }

    val base_r: res[codegen_mir.MirOperand, fail.Fail] = mir_context.mem_operand_of(ctx, inst.operands[0]);
    if (sel base_r.err) { ret err[fail.Fail].err{base_r.err}; }
    val base: codegen_mir.MirOperand = base_r.ok;

    if (inst.operand_count > 1 && inst.aux_ty == ir_type.IRT_NIL) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: gep with indices is missing its source pointee type")};
    }

    if (!ctx.tgt.model.flat_addressing) {
        ret lower_gep_structural(ctx, mb, inst, dst, base);
    }

    var disp:      i64                = 0;
    var idx_vreg:  codegen_mir.VRegId = codegen_mir.MIR_VREG_NIL;
    var idx_scale: u8                 = 0;
    var cur_ty:    ir_type.IrTypeId   = inst.aux_ty;

    var k: u32 = 1;
    for (k < inst.operand_count) {
        val v:        value.Value = inst.operands[k];
        val is_first: bool        = k == 1;

        var stride:    u64  = 0;
        var is_struct: bool = false;
        if (is_first) {
            stride = ir_type.byte_size_for_machine(ctx.types, cur_ty, ctx.layout)::u64;
        }
        or {
            val ct_opt: opt[*ir_type.IrType] = ir_type.get(ctx.types, cur_ty);
            if (!sel ct_opt.some) {
                ret err[fail.Fail].err{fail.message("mir.lower_ir: gep index walks off a non-aggregate type")};
            }
            val ct: *ir_type.IrType = ct_opt.some;
            if (ct.kind == ir_type.IRT_ARRAY) {
                stride = ir_type.byte_size_for_machine(ctx.types, ct.data.array_.element, ctx.layout)::u64;
                cur_ty = ct.data.array_.element;
            }
            or (ct.kind == ir_type.IRT_VECTOR) {
                stride = ir_type.byte_size_for_machine(ctx.types, ct.data.vector_.element, ctx.layout)::u64;
                cur_ty = ct.data.vector_.element;
            }
            or (ct.kind == ir_type.IRT_STRUCT || ct.kind == ir_type.IRT_UNION || ct.kind == ir_type.IRT_TAG) {
                is_struct = true;
            }
            or {
                ret err[fail.Fail].err{fail.message("mir.lower_ir: gep index into a non-aggregate type")};
            }
        }

        if (is_struct) {
            if (v.kind != value.VAL_CONST_INT) {
                ret err[fail.Fail].err{fail.message("mir.lower_ir: gep struct field index must be constant")};
            }
            val field_ix: u32                 = v.data.int_lit::u32;
            val fo:       res[i64, fail.Fail] = struct_field_offset(ctx, cur_ty, field_ix);
            if (sel fo.err) { ret err[fail.Fail].err{fo.err}; }
            disp = disp + fo.ok;
            val ft: res[ir_type.IrTypeId, fail.Fail] = struct_field_type(ctx, cur_ty, field_ix);
            if (sel ft.err) { ret err[fail.Fail].err{ft.err}; }
            cur_ty = ft.ok;
            k      = k + 1;
            cnt;
        }

        if (v.kind == value.VAL_CONST_INT) {
            disp = disp + (v.data.int_lit * stride)::i64;
            k    = k + 1;
            cnt;
        }

        var new_scale: u8                                     = 0;
        val idx_r:     res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, v);
        if (sel idx_r.err) { ret err[fail.Fail].err{idx_r.err}; }
        val idx_n: res[codegen_mir.MirOperand, fail.Fail] = index_at_pointer_width(ctx, mb, idx_r.ok, v.ty);
        if (sel idx_n.err) { ret err[fail.Fail].err{idx_n.err}; }
        val ir: res[codegen_mir.VRegId, fail.Fail] = fold_runtime_index(ctx, mb, idx_n.ok, stride, idx_vreg, idx_scale, ?new_scale);
        if (sel ir.err) { ret err[fail.Fail].err{ir.err}; }
        idx_vreg  = ir.ok;
        idx_scale = new_scale;
        k         = k + 1;
    }

    val mem: res[codegen_mir.MirOperand, fail.Fail] = fold_gep_mem(ctx, mb, base, idx_vreg, idx_scale, disp);
    if (sel mem.err) { ret err[fail.Fail].err{mem.err}; }

    if (mir_context.gep_folds(ctx, iid)) { ret err[fail.Fail].ok{}; }

    val r: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *codegen_mir.MirOperand = r.ok;
    ops[0] = codegen_mir.op_vreg(dst);
    ops[1] = mem.ok;
    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_GEP, ops, 2,
        ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
    ret mir_context.push_instr(ctx, mb, mi);
}

fun lower_gep_structural(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, inst: *ir_instruction.Instruction,
    dst: codegen_mir.VRegId, base: codegen_mir.MirOperand) err[fail.Fail] {
    val n: usize                                 = (inst.operand_count + 1)::usize;
    val r: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, n);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *codegen_mir.MirOperand = r.ok;
    ops[0] = codegen_mir.op_vreg(dst);
    ops[1] = base;
    var k: u32 = 1;
    for (k < inst.operand_count) {
        val lowered_13: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(ctx, inst.operands[k]);
        if (sel lowered_13.err) { ret err[fail.Fail].err{lowered_13.err}; }
        ops[(k + 1)::usize] = lowered_13.ok;
        k                   = k + 1;
    }
    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_GEP, ops, inst.operand_count + 1,
        ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
    ret mir_context.push_instr(ctx, mb, mi);
}

# a flat address is formed at the pointer width, so an index wider than the
# pointer keeps its low bits: the truncation is stated here, and where the
# pointer is wider than the ALU legalize takes the lane it names. an index
# left wide would reach the address as a value nothing defines once its lanes
# replace it (#3615)
fun index_at_pointer_width(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, idxop: codegen_mir.MirOperand,
    ty: ir_type.IrTypeId) res[codegen_mir.MirOperand, fail.Fail] {
    val iw: u8 = mir_context.op_width_of(ctx, ty);
    val pw: u8 = ctx.tgt.model.pointer_width::u8;
    if (iw <= pw || idxop.kind != codegen_mir.MIR_OP_VREG) { ret res[codegen_mir.MirOperand, fail.Fail].ok{idxop}; }
    val tr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel tr.err) { ret res[codegen_mir.MirOperand, fail.Fail].err{tr.err}; }
    val t:  codegen_mir.VRegId                    = tr.ok;
    val ar: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](ctx.alloc, 2::usize);
    if (sel ar.err) { ret res[codegen_mir.MirOperand, fail.Fail].err{fail.refused(ar.err)}; }
    val ops: *codegen_mir.MirOperand = ar.ok;
    ops[0] = codegen_mir.op_vreg(t);
    ops[1] = idxop;
    var mi: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_TRUNC, ops, 2, pw, iw);
    val er: err[fail.Fail]       = mir_context.push_instr(ctx, mb, mi);
    if (sel er.err) { ret res[codegen_mir.MirOperand, fail.Fail].err{er.err}; }
    ret res[codegen_mir.MirOperand, fail.Fail].ok{codegen_mir.op_vreg(t)};
}

fun fold_runtime_index(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, idxop: codegen_mir.MirOperand, stride: u64,
    acc: codegen_mir.VRegId, acc_scale: u8, scale_out: *u8) res[codegen_mir.VRegId, fail.Fail] {
    if (idxop.kind != codegen_mir.MIR_OP_VREG) {
        ret res[codegen_mir.VRegId, fail.Fail].err{fail.message("mir.lower_ir: gep runtime index is not a register value")};
    }
    val idxv: codegen_mir.VRegId = idxop.vreg;

    if (codegen_mir.vreg_is_nil(acc) && is_sib_scale(stride)) {
        @scale_out = stride::u8;
        ret res[codegen_mir.VRegId, fail.Fail].ok{idxv};
    }

    val tr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel tr.err) { ret res[codegen_mir.VRegId, fail.Fail].err{tr.err}; }
    val t:  codegen_mir.VRegId = tr.ok;
    val mr: err[fail.Fail]     = mir_context.emit_bin(ctx, mb, codegen_mir.MIR_MUL, t, codegen_mir.op_vreg(idxv), codegen_mir.op_imm(stride::i64));
    if (sel mr.err) { ret res[codegen_mir.VRegId, fail.Fail].err{mr.err}; }

    if (codegen_mir.vreg_is_nil(acc)) {
        @scale_out = 1;
        ret res[codegen_mir.VRegId, fail.Fail].ok{t};
    }

    var acc_term: codegen_mir.VRegId = acc;
    if (acc_scale > 1) {
        val sr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
        if (sel sr.err) { ret res[codegen_mir.VRegId, fail.Fail].err{sr.err}; }
        acc_term = sr.ok;
        val smr: err[fail.Fail] = mir_context.emit_bin(ctx, mb, codegen_mir.MIR_MUL, acc_term, codegen_mir.op_vreg(acc), codegen_mir.op_imm(acc_scale::i64));
        if (sel smr.err) { ret res[codegen_mir.VRegId, fail.Fail].err{smr.err}; }
    }
    val ar: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel ar.err) { ret res[codegen_mir.VRegId, fail.Fail].err{ar.err}; }
    val sum: codegen_mir.VRegId = ar.ok;
    val adr: err[fail.Fail]     = mir_context.emit_bin(ctx, mb, codegen_mir.MIR_ADD, sum, codegen_mir.op_vreg(acc_term), codegen_mir.op_vreg(t));
    if (sel adr.err) { ret res[codegen_mir.VRegId, fail.Fail].err{adr.err}; }
    @scale_out = 1;
    ret res[codegen_mir.VRegId, fail.Fail].ok{sum};
}

fun is_sib_scale(s: u64) bool {
    ret s == 1 || s == 2 || s == 4 || s == 8;
}

fun fold_gep_mem(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, base: codegen_mir.MirOperand, idx_vreg: codegen_mir.VRegId, idx_scale: u8, disp: i64) res[codegen_mir.MirOperand, fail.Fail] {
    var o: codegen_mir.MirOperand = base;
    if (base.kind == codegen_mir.MIR_OP_IMM) {
        val vr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
        if (sel vr.err) { ret res[codegen_mir.MirOperand, fail.Fail].err{vr.err}; }
        val vbase: codegen_mir.VRegId = vr.ok;
        val mv:    err[fail.Fail]     = mir_context.emit_mov(ctx, mb, codegen_mir.op_vreg(vbase), codegen_mir.op_imm(base.imm));
        if (sel mv.err) { ret res[codegen_mir.MirOperand, fail.Fail].err{mv.err}; }
        var m: codegen_mir.MirOperand = codegen_mir.op_mem_value(vbase, disp);
        if (!codegen_mir.vreg_is_nil(idx_vreg)) {
            m.index = codegen_mir.index_vreg(idx_vreg);
            m.scale = idx_scale;
        }
        ret within_disp_reach(ctx, mb, m, true);
    }
    if (base.kind == codegen_mir.MIR_OP_MEM) {
        o.imm = base.imm + disp;
        if (!codegen_mir.vreg_is_nil(idx_vreg)) {
            o.index = codegen_mir.index_vreg(idx_vreg);
            o.scale = idx_scale;
        }
        ret within_disp_reach(ctx, mb, o, false);
    }
    if (base.kind == codegen_mir.MIR_OP_SYM) {
        var sym_base: codegen_mir.MirOperand = base;
        var sym_disp: i64                    = disp;
        if (codegen_mir.vreg_is_nil(idx_vreg)) {
            o.sym_off = base.sym_off + disp;
            if (isa.sym_offset_folds(?ctx.tgt.model, o.sym_off)) { ret res[codegen_mir.MirOperand, fail.Fail].ok{o}; }
            sym_base.sym_off = 0;
            sym_disp         = o.sym_off;
        }
        var sbase: codegen_mir.VRegId = codegen_mir.MIR_VREG_NIL;
        val ar:    err[fail.Fail]     = mir_context.addr_to_vreg(ctx, mb, sym_base, ?sbase);
        if (sel ar.err) { ret res[codegen_mir.MirOperand, fail.Fail].err{ar.err}; }
        var m: codegen_mir.MirOperand = codegen_mir.op_mem_value(sbase, sym_disp);
        if (!codegen_mir.vreg_is_nil(idx_vreg)) {
            m.index = codegen_mir.index_vreg(idx_vreg);
            m.scale = idx_scale;
        }
        ret within_disp_reach(ctx, mb, m, true);
    }
    ret res[codegen_mir.MirOperand, fail.Fail].err{fail.message("mir.lower_ir: gep base is neither a memory nor a symbol reference")};
}

# a memory operand whose displacement the target's addressing cannot encode
# is reached through its base and index formed into a register, and the
# displacement added to that: the displacement is never narrowed to fit.
# value_base says the base is a register value rather than a frame slot, so
# with no index it is the address itself (#3907)
fun within_disp_reach(ctx: *mir_context.LowerCtx, mb: *codegen_mir.MirBlock, m: codegen_mir.MirOperand, value_base: bool) res[codegen_mir.MirOperand, fail.Fail] {
    if (isa.mem_disp_folds(?ctx.tgt.model, m.imm)) { ret res[codegen_mir.MirOperand, fail.Fail].ok{m}; }
    var abase: codegen_mir.VRegId = m.vreg;
    if (!value_base || !sel m.index.none) {
        var at: codegen_mir.MirOperand = m;
        at.imm = 0;
        val ar: err[fail.Fail] = mir_context.addr_to_vreg(ctx, mb, at, ?abase);
        if (sel ar.err) { ret res[codegen_mir.MirOperand, fail.Fail].err{ar.err}; }
    }
    val sr: res[codegen_mir.VRegId, fail.Fail] = mir_context.new_vreg(ctx, codegen_mir.REG_CLASS_GP);
    if (sel sr.err) { ret res[codegen_mir.MirOperand, fail.Fail].err{sr.err}; }
    val er: err[fail.Fail] = mir_context.emit_bin(ctx, mb, codegen_mir.MIR_ADD, sr.ok, codegen_mir.op_vreg(abase), codegen_mir.op_imm(m.imm));
    if (sel er.err) { ret res[codegen_mir.MirOperand, fail.Fail].err{er.err}; }
    ret res[codegen_mir.MirOperand, fail.Fail].ok{codegen_mir.op_mem_value(sr.ok, 0)};
}

fun struct_field_offset(ctx: *mir_context.LowerCtx, struct_ty: ir_type.IrTypeId, ix: u32) res[i64, fail.Fail] {
    val st_opt: opt[*ir_type.IrType] = ir_type.get(ctx.types, struct_ty);
    if (!sel st_opt.some) {
        ret res[i64, fail.Fail].err{fail.message("mir.lower_ir: gep struct type not found")};
    }
    val st: *ir_type.IrType = st_opt.some;
    if (st.kind == ir_type.IRT_TAG) {
        if (ix >= ir_type.tag_field_count(ctx.types, struct_ty)) {
            ret res[i64, fail.Fail].err{fail.message("mir.lower_ir: gep tag field index out of range")};
        }
        ret res[i64, fail.Fail].ok{ir_type.tag_field_offset_for_machine(ctx.types, struct_ty, ix, ctx.layout)::i64};
    }
    if (st.kind == ir_type.IRT_UNION) {
        if (ix >= st.data.struct_.field_count) {
            ret res[i64, fail.Fail].err{fail.message("mir.lower_ir: gep union member index out of range")};
        }
        ret res[i64, fail.Fail].ok{0::i64};
    }
    if (st.kind != ir_type.IRT_STRUCT) {
        ret res[i64, fail.Fail].err{fail.message("mir.lower_ir: gep struct index into a non-struct type")};
    }
    if (ix >= st.data.struct_.field_count) {
        ret res[i64, fail.Fail].err{fail.message("mir.lower_ir: gep struct field index out of range")};
    }
    ret res[i64, fail.Fail].ok{ir_type.byte_offset_for_machine(ctx.types, struct_ty, ix, ctx.layout)::i64};
}

fun struct_field_type(ctx: *mir_context.LowerCtx, struct_ty: ir_type.IrTypeId, ix: u32) res[ir_type.IrTypeId, fail.Fail] {
    val st_opt: opt[*ir_type.IrType] = ir_type.get(ctx.types, struct_ty);
    if (!sel st_opt.some) {
        ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("mir.lower_ir: gep struct type not found")};
    }
    val st: *ir_type.IrType = st_opt.some;
    if (st.kind == ir_type.IRT_TAG) {
        if (ix >= ir_type.tag_field_count(ctx.types, struct_ty)) {
            ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("mir.lower_ir: gep tag field index out of range")};
        }
        ret res[ir_type.IrTypeId, fail.Fail].ok{ir_type.tag_field_type(ctx.types, struct_ty, ix)};
    }
    if ((st.kind != ir_type.IRT_STRUCT && st.kind != ir_type.IRT_UNION) || ix >= st.data.struct_.field_count) {
        ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("mir.lower_ir: gep struct field index out of range")};
    }
    ret res[ir_type.IrTypeId, fail.Fail].ok{st.data.struct_.fields[ix]};
}

#[testing]
fun t_lower_diamond_phi(alloc: *A.Allocator, cover_both: bool, out_err: *str) bool {
    out_err[0] = nil;

    var reg: lang_target.TargetRegistry = lang_target.registry_init();
    fin { lang_target.registry_dnit(?reg); }
    val r_1776: err[fail.Fail] = lang_target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1776.err) { ret false; }
    val tr: res[resolved.Target, fail.Fail] = lang_target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret false; }
    var tgt: resolved.Target = tr.ok;

    var itn:  intern.Interner       = intern.init(alloc);
    var smap: lang_source.SourceMap = lang_source.init(alloc);

    val mr: res[me_ir.Module, fail.Fail] = me_ir.init(alloc, intern.STR_NIL);
    if (sel mr.err) { ret false; }
    var m: me_ir.Module = mr.ok;

    val it: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel it.err) { ret false; }
    val i64ty: ir_type.IrTypeId                 = it.ok;
    val vt:    res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel vt.err) { ret false; }
    val voidty: ir_type.IrTypeId                 = vt.ok;
    val sr:     res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?m.types, voidty, nil, 0, false);
    if (sel sr.err) { ret false; }
    val r_1796: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, sr.ok, 0);
    if (sel r_1796.err) { ret false; }

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, ?m.functions[0]);
    var bids: [4]ir_id.BlockId;
    var i:    u32 = 0;
    for (i < 4) {
        val br: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
        if (sel br.err) { ret false; }
        bids[i] = br.ok;
        i       = i + 1;
    }
    val c: value.Value = value.const_int(0, i64ty);

    builder.set_block(?bld, bids[0]);
    val r_1811: err[fail.Fail] = builder.emit_cbr(?bld, value.const_int(1, i64ty), bids[1], bids[2]);
    if (sel r_1811.err) { ret false; }

    builder.set_block(?bld, bids[1]);
    val lv: res[value.Value, fail.Fail] = builder.emit_add(?bld, c, c);
    if (sel lv.err) { ret false; }
    val l:      value.Value    = lv.ok;
    val r_1817: err[fail.Fail] = builder.emit_br(?bld, bids[3]);
    if (sel r_1817.err) { ret false; }

    builder.set_block(?bld, bids[2]);
    val rv: res[value.Value, fail.Fail] = builder.emit_add(?bld, c, c);
    if (sel rv.err) { ret false; }
    val rt:     value.Value    = rv.ok;
    val r_1823: err[fail.Fail] = builder.emit_br(?bld, bids[3]);
    if (sel r_1823.err) { ret false; }

    builder.set_block(?bld, bids[3]);
    val pv: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64ty);
    if (sel pv.err) { ret false; }
    val p:      value.Value    = pv.ok;
    val r_1829: err[fail.Fail] = builder.phi_add_incoming(?bld, p, bids[1], l);
    if (sel r_1829.err) { ret false; }
    if (cover_both) {
        val r_1831: err[fail.Fail] = builder.phi_add_incoming(?bld, p, bids[2], rt);
        if (sel r_1831.err) { ret false; }
    }
    val r_1833: res[value.Value, fail.Fail] = builder.emit_add(?bld, p, c);
    if (sel r_1833.err) { ret false; }
    val r_1834: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_1834.err) { ret false; }

    val lr: res[codegen_mir.MirModule, fail.Fail] = lower_module(?tgt, ?m, alloc, ?itn, ?smap, nil);
    if (sel lr.err) {
        out_err[0] = fail.describe(lr.err);
        ret false;
    }
    ret true;
}

test lower_block_phis__refuses_a_missing_incoming {
    var alloc: A.Allocator;
    page.make(?alloc);
    var error: str = nil;

    if (!t_lower_diamond_phi(?alloc, true, ?error)) { ret 1; }

    if (t_lower_diamond_phi(?alloc, false, ?error)) { ret 1; }
    if (error == nil)                               { ret 1; }
    if (!str_contains(error, "no incoming value"))  { ret 1; }
    if (!str_contains(error, "block 3"))            { ret 1; }
    if (!str_contains(error, "block 2"))            { ret 1; }
    if (!str_contains(error, "result vreg"))        { ret 1; }
    ret 0;
}

test lower_instr__volatile_flag_follows_each_instruction {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var types:  ir_type.IrTypeTable;
    val r_1865: err[fail.Fail] = ir_type.init(?types, ?alloc);
    if (sel r_1865.err) { ret 1; }
    fin { ir_type.dnit(?types); }
    val tr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 64);
    if (sel tr.err) { ret 1; }
    val ty:  ir_type.IrTypeId = tr.ok;
    var tgt: resolved.Target;
    tgt.model.flat_addressing = true;
    tgt.model.pointer_width   = 8;
    tgt.model.gpr_width       = 8;
    tgt.model.int_widths      = isa.INT_WIDTHS_1_2_4_8;
    var parameters: [1]codegen_mir.VRegId = [1]codegen_mir.VRegId{codegen_mir.vreg_id(0)};
    var operands:   [1]value.Value;
    operands[0] = value.param(0, ty);
    var instructions: [2]ir_instruction.Instruction;
    var i:            u32 = 0;
    for (i < 2) {
        instructions[i].kind          = ir_instruction.OP_MEMZERO;
        instructions[i].ty            = ty;
        instructions[i].aux_ty        = ty;
        instructions[i].operands      = ?operands[0];
        instructions[i].operand_count = 1;
        i                             = i + 1;
    }
    instructions[0].flags = ir_instruction.INSTR_FLAG_VOLATILE;
    var fn: me_ir.Function;
    fn.instrs    = ?instructions[0];
    fn.instr_len = 2;
    var ctx: mir_context.LowerCtx;
    ctx.alloc       = ?alloc;
    ctx.tgt         = ?tgt;
    ctx.types       = ?types;
    ctx.param_vregs = ?parameters[0];
    ctx.param_count = 1;
    var mb: codegen_mir.MirBlock;
    fin { codegen_mir.dnit_block(?alloc, ?mb); }
    val lower_instr_r: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 0);
    if (sel lower_instr_r.err) { ret 2; }
    val lower_instr_r2: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 1);
    if (sel lower_instr_r2.err)                                                                           { ret 3; }
    if (mb.instr_count != 2)                                                                              { ret 4; }
    if (mb.instrs[0].opcode != codegen_mir.MIR_MEMZERO || mb.instrs[1].opcode != codegen_mir.MIR_MEMZERO) { ret 5; }
    if (mb.instrs[0].memory_flags != codegen_mir.MEMORY_VOLATILE)                                         { ret 6; }
    if (mb.instrs[1].memory_flags != 0)                                                                   { ret 7; }
    ret 0;
}

# a binding of the value the instruction just lowered defined is published at
# that instruction's end, where the value exists; a binding of an older value
# waits for the next instruction's start (#3688)
test lower_instr__binding_of_the_def_opens_at_its_end {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var types:  ir_type.IrTypeTable;
    val r_init: err[fail.Fail] = ir_type.init(?types, ?alloc);
    if (sel r_init.err) { ret 1; }
    fin { ir_type.dnit(?types); }
    val tr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 64);
    if (sel tr.err) { ret 1; }
    val ty:  ir_type.IrTypeId = tr.ok;
    var tgt: resolved.Target;
    tgt.model.flat_addressing = true;
    tgt.model.pointer_width   = 8;
    tgt.model.gpr_width       = 8;
    tgt.model.int_widths      = isa.INT_WIDTHS_1_2_4_8;
    var parameters: [2]codegen_mir.VRegId = [2]codegen_mir.VRegId{codegen_mir.vreg_id(0), codegen_mir.vreg_id(1)};
    var results:    [4]codegen_mir.VRegId = [4]codegen_mir.VRegId{codegen_mir.vreg_id(2), codegen_mir.MIR_VREG_NIL, codegen_mir.MIR_VREG_NIL, codegen_mir.vreg_id(3)};
    var sum:        [2]value.Value;
    sum[0] = value.param(0, ty);
    sum[1] = value.param(1, ty);
    var of_sum: [1]value.Value;
    of_sum[0] = value.instr(0::ir_id.InstructionId, ty);
    var of_param: [1]value.Value;
    of_param[0] = value.param(0, ty);
    var instructions: [4]ir_instruction.Instruction;
    instructions[0].kind          = ir_instruction.OP_ADD;
    instructions[0].ty            = ty;
    instructions[0].operands      = ?sum[0];
    instructions[0].operand_count = 2;
    instructions[1].kind          = ir_instruction.OP_DBG_VALUE;
    instructions[1].ty            = ty;
    instructions[1].operands      = ?of_sum[0];
    instructions[1].operand_count = 1;
    instructions[2].kind          = ir_instruction.OP_DBG_VALUE;
    instructions[2].ty            = ty;
    instructions[2].operands      = ?of_param[0];
    instructions[2].operand_count = 1;
    instructions[3]               = instructions[0];
    var fn: me_ir.Function;
    fn.instrs    = ?instructions[0];
    fn.instr_len = 4;
    var ctx: mir_context.LowerCtx;
    ctx.alloc         = ?alloc;
    ctx.tgt           = ?tgt;
    ctx.types         = ?types;
    ctx.param_vregs   = ?parameters[0];
    ctx.param_count   = 2;
    ctx.instr_vregs   = ?results[0];
    ctx.instr_count   = 4;
    ctx.pending       = nil;
    ctx.pending_count = 0;
    ctx.pending_cap   = 0;
    fin {
        if (ctx.pending != nil) { A.deallocate[codegen_mir.MirDbgBinding](?alloc, ctx.pending, ctx.pending_cap::usize); }
    }
    var mb: codegen_mir.MirBlock;
    fin { codegen_mir.dnit_block(?alloc, ?mb); }
    var k: u32 = 0;
    for (k < 4) {
        val r: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, k);
        if (sel r.err) { ret 2; }
        k = k + 1;
    }
    if (mb.instr_count != 2) { ret 3; }
    val def: *codegen_mir.MirInstr = ?mb.instrs[0];
    if (def.dbg_binding_count != 1)                                    { ret 4; }
    if (def.dbg_bindings[0].iid != 1 || def.dbg_bindings[0].vreg != 2) { ret 4; }
    if (!def.dbg_bindings[0].at_end)                                   { ret 5; }
    val next: *codegen_mir.MirInstr = ?mb.instrs[1];
    if (next.dbg_binding_count != 1)                                     { ret 6; }
    if (next.dbg_bindings[0].iid != 2 || next.dbg_bindings[0].vreg != 0) { ret 6; }
    if (next.dbg_bindings[0].at_end)                                     { ret 7; }
    ret 0;
}

# a count-bounded shift is the bare machine shift. a shift wider than the alu
# is legalized into constant stages, so its count stays a vreg: a move of a
# two-lane count into rcx would put a wide value in a physical register, which
# legalize refuses (#3511, #3602). a count wider than a narrower shift is read
# at the shift's width, truncated only when the alu cannot hold it (#3892). the
# saturation is the ir's mask_lt_u, one compare-to-mask at most the alu wide
# (#3887), and a shift without the bound, or with a constant count at or above
# its width, is refused
test lower_shift__is_the_bare_shift_and_the_mask_one_compare {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var types:  ir_type.IrTypeTable;
    val r_init: err[fail.Fail] = ir_type.init(?types, ?alloc);
    if (sel r_init.err) { ret 1; }
    fin { ir_type.dnit(?types); }
    val t64_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 64);
    if (sel t64_r.err) { ret 1; }
    val t128_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 128);
    if (sel t128_r.err) { ret 1; }
    val t8_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 8);
    if (sel t8_r.err) { ret 1; }
    val t32_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 32);
    if (sel t32_r.err) { ret 1; }
    val t8:   ir_type.IrTypeId = t8_r.ok;
    val t32:  ir_type.IrTypeId = t32_r.ok;
    val t64:  ir_type.IrTypeId = t64_r.ok;
    val t128: ir_type.IrTypeId = t128_r.ok;
    var tgt:  resolved.Target;
    tgt.model.flat_addressing = true;
    tgt.model.pointer_width   = 8;
    tgt.model.gpr_width       = 8;
    isa.declare_alu_widths(?tgt.model, isa.ALU_WIDTHS_4_8);
    tgt.model.int_widths      = isa.INT_WIDTHS_1_2_4_8_16;
    tgt.model.shift_count_reg = 1;
    var convention: abi.AbiVTable = target_testing.carriers_convention();
    tgt.abi = ?convention;
    var parameters: [2]codegen_mir.VRegId = [2]codegen_mir.VRegId{codegen_mir.vreg_id(0), codegen_mir.vreg_id(1)};

    var wide: [2]value.Value;
    wide[0] = value.param(0, t128);
    wide[1] = value.param(1, t128);
    var narrow_mask: [2]value.Value;
    narrow_mask[0] = value.param(1, t8);
    narrow_mask[1] = value.const_int(64, t8);
    var wide_mask: [2]value.Value;
    wide_mask[0] = value.param(1, t128);
    wide_mask[1] = value.const_int(128, t128);
    var imm: [2]value.Value;
    imm[0] = value.param(0, t64);
    imm[1] = value.const_int(3, t8);
    var widecount: [2]value.Value;
    widecount[0] = value.param(0, t64);
    widecount[1] = value.param(1, t128);
    var fitting: [2]value.Value;
    fitting[0] = value.param(0, t32);
    fitting[1] = value.param(1, t64);
    var plain: [2]value.Value;
    plain[0] = value.param(0, t64);
    plain[1] = value.param(1, t8);
    var over: [2]value.Value;
    over[0] = value.param(0, t64);
    over[1] = value.const_int(64, t8);

    var instructions: [9]ir_instruction.Instruction;
    var ii:           u32 = 0;
    for (ii < 9) {
        instructions[ii].operand_count = 2;
        instructions[ii].flags         = ir_instruction.INSTR_FLAG_COUNT_BOUNDED;
        ii                             = ii + 1;
    }
    instructions[0].kind     = ir_instruction.OP_SHL;
    instructions[0].ty       = t128;
    instructions[0].operands = ?wide[0];
    instructions[1].kind     = ir_instruction.OP_MASK_LT_U;
    instructions[1].ty       = t64;
    instructions[1].operands = ?narrow_mask[0];
    instructions[1].flags    = 0;
    instructions[2].kind     = ir_instruction.OP_MASK_LT_U;
    instructions[2].ty       = t128;
    instructions[2].operands = ?wide_mask[0];
    instructions[2].flags    = 0;
    instructions[3].kind     = ir_instruction.OP_MASK_LT_U;
    instructions[3].ty       = t128;
    instructions[3].operands = ?narrow_mask[0];
    instructions[3].flags    = 0;
    instructions[4].kind     = ir_instruction.OP_SHR_S;
    instructions[4].ty       = t64;
    instructions[4].operands = ?imm[0];
    instructions[5].kind     = ir_instruction.OP_SHR_S;
    instructions[5].ty       = t64;
    instructions[5].operands = ?widecount[0];
    instructions[6].kind     = ir_instruction.OP_SHL;
    instructions[6].ty       = t32;
    instructions[6].operands = ?fitting[0];
    instructions[7].kind     = ir_instruction.OP_SHL;
    instructions[7].ty       = t64;
    instructions[7].operands = ?plain[0];
    instructions[7].flags    = 0;
    instructions[8].kind     = ir_instruction.OP_SHR_U;
    instructions[8].ty       = t64;
    instructions[8].operands = ?over[0];
    var fn: me_ir.Function;
    fn.instrs    = ?instructions[0];
    fn.instr_len = 9;
    var results: [9]codegen_mir.VRegId = [9]codegen_mir.VRegId{codegen_mir.vreg_id(2), codegen_mir.vreg_id(3), codegen_mir.vreg_id(4), codegen_mir.vreg_id(5), codegen_mir.vreg_id(6), codegen_mir.vreg_id(7),
        codegen_mir.vreg_id(8), codegen_mir.vreg_id(9), codegen_mir.vreg_id(10)};
    var f: codegen_mir.MirFunction;
    fin { codegen_mir.dnit_function(?alloc, ?f); }
    val rv: res[*codegen_mir.MirVReg, A.Error] = A.allocate[codegen_mir.MirVReg](?alloc, 11);
    if (sel rv.err) { ret 1; }
    f.vregs      = rv.ok;
    f.vreg_cap   = 11;
    f.vreg_count = 11;
    var vi: u32 = 0;
    for (vi < 11) {
        f.vregs[vi] = codegen_mir.vreg(vi, codegen_mir.REG_CLASS_GP, 0, false);
        vi          = vi + 1;
    }
    var ctx: mir_context.LowerCtx;
    ctx.alloc       = ?alloc;
    ctx.tgt         = ?tgt;
    ctx.types       = ?types;
    ctx.f           = ?f;
    ctx.param_vregs = ?parameters[0];
    ctx.param_count = 2;
    ctx.instr_vregs = ?results[0];
    ctx.instr_count = 9;
    ctx.fn          = ?fn;
    var mb: codegen_mir.MirBlock;
    fin { codegen_mir.dnit_block(?alloc, ?mb); }

    # the wide shift keeps the count vreg itself and writes the result
    val r0: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 0);
    if (sel r0.err)                                               { ret 2; }
    if (mb.instr_count != 1)                                      { ret 3; }
    if (mb.instrs[0].opcode != codegen_mir.MIR_SHL)               { ret 3; }
    if (mb.instrs[0].operands[0].vreg.n != 2)                     { ret 3; }
    if (mb.instrs[0].operands[2].kind != codegen_mir.MIR_OP_VREG) { ret 3; }
    if (mb.instrs[0].operands[2].vreg.n != 1)                     { ret 3; }

    # a u8 count against 64: one compare-to-mask reading the count at width 1
    # and writing the mask at 8
    val r1: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 1);
    if (sel r1.err)                                                                                    { ret 4; }
    if (mb.instr_count != 2)                                                                           { ret 5; }
    if (mb.instrs[1].opcode != codegen_mir.MIR_MASK_LT_U)                                              { ret 5; }
    if (mb.instrs[1].width != 8 || mb.instrs[1].src_width != 1)                                        { ret 5; }
    if (mb.instrs[1].operands[0].vreg.n != 3)                                                          { ret 5; }
    if (mb.instrs[1].operands[2].kind != codegen_mir.MIR_OP_IMM || mb.instrs[1].operands[2].imm != 64) { ret 5; }

    # a count wider than the alu: the wide compare at its own width, its 0/1
    # answer zero-extended and negated into the mask
    val r2: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 2);
    if (sel r2.err)                                              { ret 6; }
    if (mb.instr_count != 5)                                     { ret 7; }
    if (mb.instrs[2].opcode != codegen_mir.MIR_CMP_LT_U)         { ret 7; }
    if (mb.instrs[2].width != 16)                                { ret 7; }
    if (mb.instrs[3].opcode != codegen_mir.MIR_ZEXT)             { ret 8; }
    if (mb.instrs[3].width != 16 || mb.instrs[3].src_width != 1) { ret 8; }
    if (mb.instrs[4].opcode != codegen_mir.MIR_NEG)              { ret 8; }
    if (mb.instrs[4].operands[0].vreg.n != 4)                    { ret 8; }

    # a mask wider than the alu is the sign extension of one at the alu width
    val r3: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 3);
    if (sel r3.err)                                              { ret 9; }
    if (mb.instr_count != 7)                                     { ret 10; }
    if (mb.instrs[5].opcode != codegen_mir.MIR_MASK_LT_U)        { ret 10; }
    if (mb.instrs[5].width != 8 || mb.instrs[5].src_width != 1)  { ret 10; }
    if (mb.instrs[6].opcode != codegen_mir.MIR_SEXT)             { ret 10; }
    if (mb.instrs[6].width != 16 || mb.instrs[6].src_width != 8) { ret 10; }
    if (mb.instrs[6].operands[0].vreg.n != 5)                    { ret 10; }

    # an immediate count is the bare shift by it
    val r4: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 4);
    if (sel r4.err)                                                                                   { ret 11; }
    if (mb.instr_count != 8)                                                                          { ret 12; }
    if (mb.instrs[7].opcode != codegen_mir.MIR_SHR_S)                                                 { ret 12; }
    if (mb.instrs[7].operands[2].kind != codegen_mir.MIR_OP_IMM || mb.instrs[7].operands[2].imm != 3) { ret 12; }

    # a count wider than the alu keeps its low bits for a narrower shift, which
    # never names the wide vreg
    val r5: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 5);
    if (sel r5.err)                                                         { ret 13; }
    if (mb.instr_count != 11)                                               { ret 14; }
    if (mb.instrs[8].opcode != codegen_mir.MIR_TRUNC)                       { ret 14; }
    if (mb.instrs[8].width != 8 || mb.instrs[8].src_width != 16)            { ret 14; }
    if (mb.instrs[9].opcode != codegen_mir.MIR_MOV)                         { ret 15; }
    if (mb.instrs[9].operands[1].vreg.n != mb.instrs[8].operands[0].vreg.n) { ret 15; }
    if (mb.instrs[10].opcode != codegen_mir.MIR_SHR_S)                      { ret 15; }
    if (mb.instrs[10].operands[2].kind != codegen_mir.MIR_OP_PREG)          { ret 15; }

    # a count wider than the shift that the alu holds is not truncated: the
    # fixed register reads its low bits from the count's own vreg
    val r6: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 6);
    if (sel r6.err)                                                                                         { ret 16; }
    if (mb.instr_count != 13)                                                                               { ret 17; }
    if (mb.instrs[11].opcode != codegen_mir.MIR_MOV || mb.instrs[11].width != 4)                            { ret 17; }
    if (mb.instrs[11].operands[1].kind != codegen_mir.MIR_OP_VREG || mb.instrs[11].operands[1].vreg.n != 1) { ret 17; }
    if (mb.instrs[12].opcode != codegen_mir.MIR_SHL)                                                        { ret 17; }

    # without the bound, or with a constant count at the width, it is refused
    val r7: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 7);
    if (sel r7.ok) { ret 18; }
    val r8: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 8);
    if (sel r8.ok) { ret 19; }
    ret 0;
}

# a count masked by the width it shifts at, less one, is the unmasked count to
# a machine that reads the count modulo that width. the mask is not
# materialized when every use of it is such a count, and the shift takes the
# masked operand: never for another constant, a second use, a narrow shift
# the alu widens, or a target that masks nothing (#3893)
test lower_shift__drops_a_count_mask_the_machine_applies {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var types:  ir_type.IrTypeTable;
    val r_init: err[fail.Fail] = ir_type.init(?types, ?alloc);
    if (sel r_init.err) { ret 1; }
    fin { ir_type.dnit(?types); }
    val t64_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 64);
    if (sel t64_r.err) { ret 1; }
    val t32_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 32);
    if (sel t32_r.err) { ret 1; }
    val t8_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 8);
    if (sel t8_r.err) { ret 1; }
    val t64: ir_type.IrTypeId = t64_r.ok;
    val t32: ir_type.IrTypeId = t32_r.ok;
    val t8:  ir_type.IrTypeId = t8_r.ok;
    var tgt: resolved.Target;
    tgt.model.flat_addressing = true;
    tgt.model.pointer_width   = 8;
    tgt.model.gpr_width       = 8;
    isa.declare_alu_widths(?tgt.model, isa.ALU_WIDTHS_4_8);
    tgt.model.int_widths             = isa.INT_WIDTHS_1_2_4_8;
    tgt.model.shift_count_reg        = 1;
    tgt.model.shift_count_mod_widths = isa.SHIFT_MOD_4_8;
    var convention: abi.AbiVTable = target_testing.carriers_convention();
    tgt.abi = ?convention;
    var parameters: [6]codegen_mir.VRegId = [6]codegen_mir.VRegId{codegen_mir.vreg_id(0), codegen_mir.vreg_id(1), codegen_mir.vreg_id(2), codegen_mir.vreg_id(3), codegen_mir.vreg_id(4), codegen_mir.vreg_id(5)};

    # 0, 1: a 64-bit shift by `a & 63`, which folds
    var mask63: [2]value.Value;
    mask63[0] = value.param(0, t64);
    mask63[1] = value.const_int(63, t64);
    var shift0: [2]value.Value;
    shift0[0] = value.param(1, t64);
    shift0[1] = value.instr(0::ir_id.InstructionId, t64);
    # 2, 3: `a & 31` on a 64-bit shift is a real mask
    var mask31: [2]value.Value;
    mask31[0] = value.param(0, t64);
    mask31[1] = value.const_int(31, t64);
    var shift2: [2]value.Value;
    shift2[0] = value.param(1, t64);
    shift2[1] = value.instr(2::ir_id.InstructionId, t64);
    # 4, 5, 6: `a & 63` read by a shift and by an add
    var shift4: [2]value.Value;
    shift4[0] = value.param(1, t64);
    shift4[1] = value.instr(4::ir_id.InstructionId, t64);
    var add4: [2]value.Value;
    add4[0] = value.instr(4::ir_id.InstructionId, t64);
    add4[1] = value.param(1, t64);
    # 7, 8: a 32-bit shift by `31 & c`, the constant first, which folds
    var mask31n: [2]value.Value;
    mask31n[0] = value.const_int(31, t32);
    mask31n[1] = value.param(2, t32);
    var shift7: [2]value.Value;
    shift7[0] = value.param(3, t32);
    shift7[1] = value.instr(7::ir_id.InstructionId, t32);
    # 9, 10: a u8 shift by `c & 7` runs at the 32-bit alu floor, which reads 5 bits
    var mask7: [2]value.Value;
    mask7[0] = value.param(4, t8);
    mask7[1] = value.const_int(7, t8);
    var shift9: [2]value.Value;
    shift9[0] = value.param(5, t8);
    shift9[1] = value.instr(9::ir_id.InstructionId, t8);

    var instructions: [11]ir_instruction.Instruction;
    var ii:           u32 = 0;
    for (ii < 11) {
        instructions[ii].operand_count = 2;
        instructions[ii].flags         = ir_instruction.INSTR_FLAG_COUNT_BOUNDED;
        ii                             = ii + 1;
    }
    instructions[0].kind      = ir_instruction.OP_AND;
    instructions[0].ty        = t64;
    instructions[0].operands  = ?mask63[0];
    instructions[1].kind      = ir_instruction.OP_SHL;
    instructions[1].ty        = t64;
    instructions[1].operands  = ?shift0[0];
    instructions[2].kind      = ir_instruction.OP_AND;
    instructions[2].ty        = t64;
    instructions[2].operands  = ?mask31[0];
    instructions[3].kind      = ir_instruction.OP_SHL;
    instructions[3].ty        = t64;
    instructions[3].operands  = ?shift2[0];
    instructions[4].kind      = ir_instruction.OP_AND;
    instructions[4].ty        = t64;
    instructions[4].operands  = ?mask63[0];
    instructions[5].kind      = ir_instruction.OP_SHR_U;
    instructions[5].ty        = t64;
    instructions[5].operands  = ?shift4[0];
    instructions[6].kind      = ir_instruction.OP_ADD;
    instructions[6].ty        = t64;
    instructions[6].operands  = ?add4[0];
    instructions[7].kind      = ir_instruction.OP_AND;
    instructions[7].ty        = t32;
    instructions[7].operands  = ?mask31n[0];
    instructions[8].kind      = ir_instruction.OP_SHR_S;
    instructions[8].ty        = t32;
    instructions[8].operands  = ?shift7[0];
    instructions[9].kind      = ir_instruction.OP_AND;
    instructions[9].ty        = t8;
    instructions[9].operands  = ?mask7[0];
    instructions[10].kind     = ir_instruction.OP_SHL;
    instructions[10].ty       = t8;
    instructions[10].operands = ?shift9[0];
    ii                        = 0;
    for (ii < 11) {
        if (instructions[ii].kind == ir_instruction.OP_AND || instructions[ii].kind == ir_instruction.OP_ADD) { instructions[ii].flags = 0; }
        ii = ii + 1;
    }

    var fn: me_ir.Function;
    fn.instrs    = ?instructions[0];
    fn.instr_len = 11;
    var results: [11]codegen_mir.VRegId;
    var f:       codegen_mir.MirFunction;
    fin { codegen_mir.dnit_function(?alloc, ?f); }
    val rv: res[*codegen_mir.MirVReg, A.Error] = A.allocate[codegen_mir.MirVReg](?alloc, 17);
    if (sel rv.err) { ret 1; }
    f.vregs      = rv.ok;
    f.vreg_cap   = 17;
    f.vreg_count = 17;
    var vi: u32 = 0;
    for (vi < 17) {
        f.vregs[vi] = codegen_mir.vreg(vi, codegen_mir.REG_CLASS_GP, 0, false);
        if (vi >= 6) { results[vi - 6] = codegen_mir.vreg_id(vi); }
        vi = vi + 1;
    }
    var folds: [11]bool;
    var ctx:   mir_context.LowerCtx;
    ctx.alloc           = ?alloc;
    ctx.tgt             = ?tgt;
    ctx.types           = ?types;
    ctx.f               = ?f;
    ctx.param_vregs     = ?parameters[0];
    ctx.param_count     = 6;
    ctx.instr_vregs     = ?results[0];
    ctx.instr_count     = 11;
    ctx.fn              = ?fn;
    ctx.count_mask_fold = ?folds[0];

    mir_context.mark_foldable_count_masks(?ctx, ?fn);
    if (!folds[0] || folds[2] || folds[4] || !folds[7] || folds[9]) { ret 2; }
    ii = 0;
    for (ii < 11) {
        if (instructions[ii].kind != ir_instruction.OP_AND && folds[ii]) { ret 3; }
        ii = ii + 1;
    }

    # the folded mask emits nothing, and the shift moves `a` itself into the
    # fixed register: no and, no saturation
    var mb: codegen_mir.MirBlock;
    fin { codegen_mir.dnit_block(?alloc, ?mb); }
    val r0: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 0);
    if (sel r0.err)          { ret 4; }
    if (mb.instr_count != 0) { ret 5; }
    val r1: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 1);
    if (sel r1.err)                                                                                       { ret 6; }
    if (mb.instr_count != 2)                                                                              { ret 7; }
    if (mb.instrs[0].opcode != codegen_mir.MIR_MOV)                                                       { ret 8; }
    if (mb.instrs[0].operands[1].kind != codegen_mir.MIR_OP_VREG || mb.instrs[0].operands[1].vreg.n != 0) { ret 8; }
    if (mb.instrs[1].opcode != codegen_mir.MIR_SHL)                                                       { ret 9; }

    # the 32-bit arithmetic shift reads its count's variable operand the same way
    val r7: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 7);
    if (sel r7.err)          { ret 10; }
    if (mb.instr_count != 2) { ret 11; }
    val r8: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 8);
    if (sel r8.err)                                                                                       { ret 12; }
    if (mb.instr_count != 4)                                                                              { ret 13; }
    if (mb.instrs[2].operands[1].kind != codegen_mir.MIR_OP_VREG || mb.instrs[2].operands[1].vreg.n != 2) { ret 13; }
    if (mb.instrs[3].opcode != codegen_mir.MIR_SHR_S)                                                     { ret 13; }

    # a mask that is not the width's is lowered, and the shift reads its result
    val r2: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 2);
    if (sel r2.err)                                 { ret 14; }
    if (mb.instr_count != 5)                        { ret 15; }
    if (mb.instrs[4].opcode != codegen_mir.MIR_AND) { ret 15; }
    val r3: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 3);
    if (sel r3.err)                                                                                       { ret 16; }
    if (mb.instr_count != 7)                                                                              { ret 17; }
    if (mb.instrs[5].operands[1].kind != codegen_mir.MIR_OP_VREG || mb.instrs[5].operands[1].vreg.n != 8) { ret 17; }

    # a target whose shift masks nothing keeps every mask
    tgt.model.shift_count_mod_widths = isa.SHIFT_MOD_NONE;
    mir_context.mark_foldable_count_masks(?ctx, ?fn);
    ii = 0;
    for (ii < 11) {
        if (folds[ii]) { ret 18; }
        ii = ii + 1;
    }
    val r0n: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 0);
    if (sel r0n.err)                                { ret 19; }
    if (mb.instr_count != 8)                        { ret 20; }
    if (mb.instrs[7].opcode != codegen_mir.MIR_AND) { ret 20; }
    val r1n: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 1);
    if (sel r1n.err)                                                                                      { ret 21; }
    if (mb.instr_count != 10)                                                                             { ret 22; }
    if (mb.instrs[8].operands[1].kind != codegen_mir.MIR_OP_VREG || mb.instrs[8].operands[1].vreg.n != 6) { ret 22; }
    ret 0;
}

# the constant-time gate keys a scalar widening multiply by its operand width:
# two i64 operands into an i128 result are the 64-bit wide cell, not a 128-bit
# one, and the high multiply keys the same way (#3511)
test ir_mul_cell__widening_multiply_is_keyed_by_its_operand_width {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var types:  ir_type.IrTypeTable;
    val r_init: err[fail.Fail] = ir_type.init(?types, ?alloc);
    if (sel r_init.err) { ret 1; }
    fin { ir_type.dnit(?types); }
    val t64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 64);
    if (sel t64.err) { ret 1; }
    val t128: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 128);
    if (sel t128.err) { ret 1; }
    var tgt: resolved.Target;
    tgt.model.flat_addressing = true;
    tgt.model.pointer_width   = 8;
    tgt.model.gpr_width       = 8;
    tgt.model.int_widths      = isa.INT_WIDTHS_1_2_4_8_16;
    var operands: [2]value.Value;
    operands[0] = value.param(0, t64.ok);
    operands[1] = value.param(1, t64.ok);
    var inst: ir_instruction.Instruction;
    inst.kind          = ir_instruction.OP_MUL_WIDE_U;
    inst.ty            = t128.ok;
    inst.operands      = ?operands[0];
    inst.operand_count = 2;
    var ctx: mir_context.LowerCtx;
    ctx.alloc = ?alloc;
    ctx.tgt   = ?tgt;
    ctx.types = ?types;

    val wide_u: ct.CtMulCell = ir_mul_cell(?ctx, ?inst);
    if (wide_u.op != ct.CT_MUL_WIDE_U || wide_u.width != 64 || wide_u.vector) { ret 2; }
    inst.kind = ir_instruction.OP_MUL_WIDE_S;
    val wide_s: ct.CtMulCell = ir_mul_cell(?ctx, ?inst);
    if (wide_s.op != ct.CT_MUL_WIDE_S || wide_s.width != 64 || wide_s.vector) { ret 3; }
    inst.kind = ir_instruction.OP_MUL_HIGH_U;
    inst.ty   = t64.ok;
    val high: ct.CtMulCell = ir_mul_cell(?ctx, ?inst);
    if (high.op != ct.CT_MUL_HIGH_U || high.width != 64 || high.vector) { ret 4; }
    inst.kind = ir_instruction.OP_MUL;
    val low: ct.CtMulCell = ir_mul_cell(?ctx, ?inst);
    if (low.op != ct.CT_MUL_LOW || low.width != 64 || low.vector) { ret 5; }
    ret 0;
}

# a narrow divide is widened to the target's narrowest declared ALU width, never
# to a fixed 32 bits: a register machine declares 4 and promotes, a typed target
# like SPIR-V declares 1 and divides at the lane width so the quotient stays
# the lane type (#3318)
#[testing]
fun t_narrow_div_widening(alu_widths: u32, want_width: u8, want_promotes: u32) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var types:  ir_type.IrTypeTable;
    val r_init: err[fail.Fail] = ir_type.init(?types, ?alloc);
    if (sel r_init.err) { ret 1; }
    fin { ir_type.dnit(?types); }
    val tr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 8);
    if (sel tr.err) { ret 1; }
    val ty:  ir_type.IrTypeId = tr.ok;
    var tgt: resolved.Target;
    tgt.model.flat_addressing = true;
    tgt.model.pointer_width   = 4;
    tgt.model.gpr_width       = 4;
    tgt.model.int_widths      = isa.INT_WIDTHS_1_2_4_8;
    isa.declare_alu_widths(?tgt.model, alu_widths);
    tgt.model.div_reg    = -1;
    tgt.model.div_hi_reg = -1;
    var convention: abi.AbiVTable = target_testing.carriers_convention();
    tgt.abi = ?convention;
    var parameters: [2]codegen_mir.VRegId = [2]codegen_mir.VRegId{codegen_mir.vreg_id(0), codegen_mir.vreg_id(1)};
    var results:    [1]codegen_mir.VRegId = [1]codegen_mir.VRegId{codegen_mir.vreg_id(2)};
    var operands:   [2]value.Value;
    operands[0] = value.param(0, ty);
    operands[1] = value.param(1, ty);
    var instructions: [1]ir_instruction.Instruction;
    instructions[0].kind          = ir_instruction.OP_DIV_S;
    instructions[0].ty            = ty;
    instructions[0].operands      = ?operands[0];
    instructions[0].operand_count = 2;
    var fn: me_ir.Function;
    fn.instrs    = ?instructions[0];
    fn.instr_len = 1;
    var f: codegen_mir.MirFunction;
    fin { codegen_mir.dnit_function(?alloc, ?f); }
    val rv: res[*codegen_mir.MirVReg, A.Error] = A.allocate[codegen_mir.MirVReg](?alloc, 8);
    if (sel rv.err) { ret 1; }
    f.vregs      = rv.ok;
    f.vreg_cap   = 8;
    f.vreg_count = 3;
    var i: u32 = 0;
    for (i < 3) {
        f.vregs[i] = codegen_mir.vreg(i, codegen_mir.REG_CLASS_GP, 0, false);
        i          = i + 1;
    }
    var ctx: mir_context.LowerCtx;
    ctx.alloc       = ?alloc;
    ctx.tgt         = ?tgt;
    ctx.types       = ?types;
    ctx.f           = ?f;
    ctx.param_vregs = ?parameters[0];
    ctx.param_count = 2;
    ctx.instr_vregs = ?results[0];
    ctx.instr_count = 1;
    var mb: codegen_mir.MirBlock;
    fin { codegen_mir.dnit_block(?alloc, ?mb); }
    val lr: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 0);
    if (sel lr.err) { ret 2; }
    var promotes: u32 = 0;
    var divides:  u32 = 0;
    i = 0;
    for (i < mb.instr_count) {
        val mi: *codegen_mir.MirInstr = ?mb.instrs[i];
        if (mi.opcode == codegen_mir.MIR_SEXT) {
            if (mi.width != want_width || mi.src_width != 1) { ret 3; }
            promotes = promotes + 1;
        }
        or (mi.opcode == codegen_mir.MIR_DIV_S) {
            if (mi.width != want_width || mi.src_width != want_width) { ret 4; }
            if (mi.operands[0].vreg.n != 2)                           { ret 5; }
            divides = divides + 1;
        }
        or { ret 6; }
        i = i + 1;
    }
    if (divides != 1)              { ret 7; }
    if (promotes != want_promotes) { ret 8; }
    ret 0;
}

test lower_div__narrow_divide_widens_to_the_declared_alu_floor {
    val typed: i32 = t_narrow_div_widening(isa.ALU_WIDTHS_1_2_4_8, 1, 0);
    if (typed != 0) { ret typed; }
    val reg: i32 = t_narrow_div_widening(isa.ALU_WIDTHS_4_8, 4, 2);
    if (reg != 0) { ret 10 + reg; }
    ret 0;
}
