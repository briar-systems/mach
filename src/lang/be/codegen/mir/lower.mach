use mach.lang.target.isa;
use target:         mach.lang.target.resolved;
use target_testing: mach.lang.target.testing;
use mach.lang.wide;

pub fun lower_module(tgt: *target.Target, m: *ir.Module, alloc: *A.Allocator, interner: *intern.Interner, srcmap: *source.SourceMap,
    diags: *diagnostic.DiagnosticStore) res[mir.MirModule, fail.Fail] {
    if (tgt == nil || m == nil) {
        ret res[mir.MirModule, fail.Fail].err{fail.message("mir.lower_ir: nil target or module")};
    }

    var mm: mir.MirModule;
    mm.alloc        = alloc;
    mm.interner     = interner;
    mm.srcmap       = srcmap;
    mm.diags        = diags;
    mm.functions    = nil;
    mm.function_len = 0;
    mm.function_cap = 0;

    val rf: res[*mir.MirFunction, A.Error] = A.allocate[mir.MirFunction](alloc, mir.INITIAL_FN_CAP::usize);
    if (sel rf.err) {
        ret res[mir.MirModule, fail.Fail].err{fail.refused(rf.err)};
    }
    mm.functions    = rf.ok;
    mm.function_cap = mir.INITIAL_FN_CAP;

    var fi: u32 = 0;
    for (fi < m.function_len) {
        val lf: res[mir.MirFunction, fail.Fail] = lower_function(tgt, m, ?m.functions[fi], alloc, interner, diags);
        if (sel lf.err) {
            mir.dnit_module(?mm);
            ret res[mir.MirModule, fail.Fail].err{lf.err};
        }
        val push: err[fail.Fail] = mir.push_function(?mm, lf.ok);
        if (sel push.err) {
            mir.dnit_module(?mm);
            ret res[mir.MirModule, fail.Fail].err{push.err};
        }
        fi = fi + 1;
    }

    ret res[mir.MirModule, fail.Fail].ok{mm};
}

fun lower_function(tgt: *target.Target, m: *ir.Module, fn: *ir.Function, alloc: *A.Allocator, interner: *intern.Interner,
    diags: *diagnostic.DiagnosticStore) res[mir.MirFunction, fail.Fail] {
    var mf: mir.MirFunction;
    mf.name                = fn.name;
    mf.blocks              = nil;
    mf.block_count         = 0;
    mf.block_cap           = 0;
    mf.vregs               = nil;
    mf.vreg_count          = 0;
    mf.vreg_cap            = 0;
    mf.abi_inputs          = nil;
    mf.abi_input_count     = 0;
    mf.abi_input_cap       = 0;
    mf.frame.slots         = nil;
    mf.frame.slot_count    = 0;
    mf.frame.slot_cap      = 0;
    mf.frame.size          = 0;
    mf.frame.align         = 0;
    mf.frame.outgoing_size = 0;
    mf.frame.realign       = 0;
    mf.frame.base_dist     = 0;
    mf.frame.fp_dist       = 0;
    mf.frame.omit          = false;
    mf.frame.sp_fixed      = false;
    mf.callee_mask         = 0;
    mf.callee_mask_fp      = 0;
    mf.oblivious           = (fn.flags & ir.FN_FLAG_OBLIVIOUS) != 0;
    mf.naked               = (fn.flags & ir.FN_FLAG_NAKED) != 0;
    mf.extensions          = fn.extensions;
    mf.needs_dit           = false;
    mf.decl_loc            = fn.decl_loc;

    if ((fn.flags & ir.FN_FLAG_EXTERN) != 0 || fn.block_count == 0) {
        ret res[mir.MirFunction, fail.Fail].ok{mf};
    }

    val rv: res[*mir.MirVReg, A.Error] = A.allocate[mir.MirVReg](alloc, mir.INITIAL_VREG_CAP::usize);
    if (sel rv.err) {
        ret res[mir.MirFunction, fail.Fail].err{fail.refused(rv.err)};
    }
    mf.vregs    = rv.ok;
    mf.vreg_cap = mir.INITIAL_VREG_CAP;

    var ctx: lctx.LowerCtx;
    ctx.alloc             = alloc;
    ctx.tgt               = tgt;
    ctx.layout            = target.layout_machine(tgt);
    ctx.m                 = m;
    ctx.types             = ?m.types;
    ctx.fn                = fn;
    ctx.f                 = ?mf;
    ctx.param_vregs       = nil;
    ctx.param_count       = fn.param_count;
    ctx.instr_vregs       = nil;
    ctx.slot_key_vregs    = nil;
    ctx.gep_fold          = nil;
    ctx.gep_mem           = nil;
    ctx.instr_count       = fn.instr_len;
    ctx.interner          = interner;
    ctx.diags             = diags;
    ctx.sret_vreg         = mir.MIR_VREG_NIL;
    ctx.cur_loc           = source.loc_nil();
    ctx.cur_inline_site   = 0;
    ctx.cur_vec_lane      = mir.VEC_LANE_NONE;
    ctx.cur_writes_secret = false;
    ctx.cur_memory_flags  = 0;
    ctx.pending           = nil;
    ctx.pending_count     = 0;
    ctx.pending_cap       = 0;
    ctx.max_block_id      = 0;

    val widths: err[fail.Fail] = check_signature_int_widths(?ctx, fn);
    if (sel widths.err) {
        lctx.ctx_dnit(?ctx);
        mir.dnit_function(alloc, ?mf);
        ret res[mir.MirFunction, fail.Fail].err{widths.err};
    }

    val setup: err[fail.Fail] = lctx.ctx_setup(?ctx, tgt, fn);
    if (sel setup.err) {
        lctx.ctx_dnit(?ctx);
        mir.dnit_function(alloc, ?mf);
        ret res[mir.MirFunction, fail.Fail].err{setup.err};
    }

    val rb: res[*mir.MirBlock, A.Error] = A.allocate[mir.MirBlock](alloc, fn.block_count::usize);
    if (sel rb.err) {
        lctx.ctx_dnit(?ctx);
        mir.dnit_function(alloc, ?mf);
        ret res[mir.MirFunction, fail.Fail].err{fail.refused(rb.err)};
    }
    mf.blocks    = rb.ok;
    mf.block_cap = fn.block_count;

    lctx.seed_gep_mems(?ctx, fn, pure_gep_mem);

    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val is_entry: bool           = bi == 0;
        val lb:       err[fail.Fail] = lower_block(?ctx, fn, ?fn.blocks[bi], is_entry);
        if (sel lb.err) {
            lctx.ctx_dnit(?ctx);
            mir.dnit_function(alloc, ?mf);
            ret res[mir.MirFunction, fail.Fail].err{lb.err};
        }
        bi = bi + 1;
    }

    val lph: err[fail.Fail] = lower_phis(?ctx, fn);
    if (sel lph.err) {
        lctx.ctx_dnit(?ctx);
        mir.dnit_function(alloc, ?mf);
        ret res[mir.MirFunction, fail.Fail].err{lph.err};
    }

    val lbk: err[fail.Fail] = bulk.expand(?ctx);
    if (sel lbk.err) {
        lctx.ctx_dnit(?ctx);
        mir.dnit_function(alloc, ?mf);
        ret res[mir.MirFunction, fail.Fail].err{lbk.err};
    }

    lctx.ctx_dnit(?ctx);
    ret res[mir.MirFunction, fail.Fail].ok{mf};
}

fun lower_block(ctx: *lctx.LowerCtx, fn: *ir.Function, blk: *ir.Block, is_entry: bool) err[fail.Fail] {
    val f:  *mir.MirFunction = ctx.f;
    val mb: *mir.MirBlock    = ?f.blocks[f.block_count];
    mb.id = blk.id::u32;
    if (mb.id > ctx.max_block_id) { ctx.max_block_id = mb.id; }
    mb.instrs      = nil;
    mb.instr_count = 0;
    mb.instr_cap   = 0;
    mb.preds       = nil;
    mb.pred_count  = 0;
    mb.pred_cap    = 0;
    f.block_count  = f.block_count + 1;

    val cp: err[fail.Fail] = copy_preds(ctx, mb, blk);
    if (sel cp.err) { ret cp; }

    if (is_entry) {
        val lp: err[fail.Fail] = mabi.lower_params(ctx, mb);
        if (sel lp.err) { ret lp; }
    }

    var ii: u32 = 0;
    for (ii < blk.instr_count) {
        val ei: err[fail.Fail] = lower_instr(ctx, fn, mb, blk.instructions[ii]);
        if (sel ei.err) { ret ei; }
        ii = ii + 1;
    }

    if (blk.terminator != id.INSTR_NIL) {
        val et: err[fail.Fail] = lower_instr(ctx, fn, mb, blk.terminator);
        if (sel et.err) { ret et; }
    }

    if (ctx.pending_count > 0 && mb.instr_count > 0) {
        val fl: err[fail.Fail] = lctx.drain_pending_dbg(ctx, ?mb.instrs[mb.instr_count - 1]);
        if (sel fl.err) { ret fl; }
    }
    ctx.pending_count = 0;

    ret err[fail.Fail].ok{};
}

# whether `mi` writes `v` as its destination
fun instr_defines_vreg(mi: *mir.MirInstr, v: mir.VRegId) bool {
    if (!mir.instr_defines_shape(mi))           { ret false; }
    if (mi.operands[0].kind != mir.MIR_OP_VREG) { ret false; }
    ret mir.vreg_same(mi.operands[0].vreg, v);
}

fun copy_preds(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, blk: *ir.Block) err[fail.Fail] {
    if (blk.pred_count == 0) { ret err[fail.Fail].ok{}; }
    val r: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, blk.pred_count::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    mb.preds    = r.ok;
    mb.pred_cap = blk.pred_count;
    var i: u32 = 0;
    for (i < blk.pred_count) {
        mb.preds[i] = blk.preds[i]::u32;
        i           = i + 1;
    }
    mb.pred_count = blk.pred_count;
    ret err[fail.Fail].ok{};
}

fun lower_phis(ctx: *lctx.LowerCtx, fn: *ir.Function) err[fail.Fail] {
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];
        if (blk.phi_count > 0) {
            val r: err[fail.Fail] = lower_block_phis(ctx, fn, blk);
            if (sel r.err) { ret r; }
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun lower_block_phis(ctx: *lctx.LowerCtx, fn: *ir.Function, blk: *ir.Block) err[fail.Fail] {
    val np: u32                       = blk.phi_count;
    val rd: res[*mir.VRegId, A.Error] = A.allocate[mir.VRegId](ctx.alloc, np::usize);
    if (sel rd.err) { ret err[fail.Fail].err{fail.refused(rd.err)}; }
    val dsts: *mir.VRegId                   = rd.ok;
    val rs:   res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, np::usize);
    if (sel rs.err) {
        A.deallocate[mir.VRegId](ctx.alloc, dsts, np::usize);
        ret err[fail.Fail].err{fail.refused(rs.err)};
    }
    val srcs: *mir.MirOperand   = rs.ok;
    val rw:   res[*u8, A.Error] = A.allocate[u8](ctx.alloc, np::usize);
    if (sel rw.err) {
        A.deallocate[mir.VRegId](ctx.alloc, dsts, np::usize);
        A.deallocate[mir.MirOperand](ctx.alloc, srcs, np::usize);
        ret err[fail.Fail].err{fail.refused(rw.err)};
    }
    val wids: *u8 = rw.ok;

    var failure: err[fail.Fail] = err[fail.Fail].ok{};
    var pi:      u32            = 0;
    for (pi < blk.pred_count && sel failure.ok) {
        val pred_id: u32           = blk.preds[pi]::u32;
        var pred_mb: *mir.MirBlock = mir_block_by_id(ctx.f, pred_id);
        if (pred_mb == nil) {
            failure = err[fail.Fail].err{fail.message("mir.lower_ir: phi predecessor block has no MIR block")};
            pi      = pi + 1;
            cnt;
        }

        if (block_ends_in_cbr(pred_mb)) {
            val sr: res[*mir.MirBlock, fail.Fail] = split_critical_edge(ctx, pred_mb, blk.id::u32);
            if (sel sr.err) {
                failure = err[fail.Fail].err{sr.err};
                pi      = pi + 1;
                cnt;
            }
            pred_mb = sr.ok;
        }

        var nc: u32 = 0;
        var hi: u32 = 0;
        for (hi < blk.phi_count && sel failure.ok) {
            val phi_opt: opt[*instr.Instruction] = ir.instruction_get(fn, blk.phis[hi]);
            if (!sel phi_opt.some) {
                failure = err[fail.Fail].err{fail.message("mir.lower_ir: dangling phi instruction id")};
                hi      = hi + 1;
                cnt;
            }
            val phi:      *instr.Instruction = phi_opt.some;
            val dst_vreg: mir.VRegId         = lctx.instr_vreg(ctx, blk.phis[hi]);
            if (mir.vreg_is_nil(dst_vreg)) {
                failure = err[fail.Fail].err{fail.message("mir.lower_ir: phi defines no result vreg")};
                hi      = hi + 1;
                cnt;
            }
            var found: bool = false;
            var k:     u32  = 0;
            for (k + 1 < phi.operand_count && found == false) {
                if (phi.operands[k].data.int_lit::u32 == pred_id) {
                    dsts[nc] = dst_vreg;
                    val lowered_1: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, phi.operands[k + 1]);
                    if (sel lowered_1.err) { ret err[fail.Fail].err{lowered_1.err}; }
                    srcs[nc] = lowered_1.ok;
                    wids[nc] = lctx.op_width_of(ctx, phi.ty);
                    nc       = nc + 1;
                    found    = true;
                }
                k = k + 2;
            }
            if (!found) {
                failure = err[fail.Fail].err{fail.message(phi_edge_err(ctx, blk.id::u32, pred_id, dst_vreg))};
                hi      = hi + 1;
                cnt;
            }
            hi = hi + 1;
        }

        if (sel failure.ok && nc > 0) {
            val r: err[fail.Fail] = emit_edge_copies(ctx, pred_mb, dsts, srcs, wids, nc);
            if (sel r.err) { failure = err[fail.Fail].err{r.err}; }
        }
        pi = pi + 1;
    }

    A.deallocate[mir.VRegId](ctx.alloc, dsts, np::usize);
    A.deallocate[mir.MirOperand](ctx.alloc, srcs, np::usize);
    A.deallocate[u8](ctx.alloc, wids, np::usize);
    ret failure;
}

fun phi_edge_err(ctx: *lctx.LowerCtx, block_id: u32, pred_id: u32, dst_vreg: mir.VRegId) str {
    val fallback: str                          = "mir.lower_ir: phi has no incoming value for a predecessor edge";
    val rj:       res[str, format.FormatError] = format.sprint(ctx.alloc,
        "mir.lower_ir: phi in block {} has no incoming value for predecessor block {} (result vreg {})",
        block_id, pred_id, dst_vreg.n);
    if (sel rj.err) { ret fallback; }
    ret rj.ok;
}

# lowering keeps a block's index equal to its id (IR blocks in order, then
# fresh ids past the largest), so the direct slot is checked first and the
# scan covers any function shaped otherwise
fun mir_block_by_id(f: *mir.MirFunction, block_id: u32) *mir.MirBlock {
    if (block_id < f.block_count && f.blocks[block_id].id == block_id) { ret ?f.blocks[block_id]; }
    var bi: u32 = 0;
    for (bi < f.block_count) {
        if (f.blocks[bi].id == block_id) { ret ?f.blocks[bi]; }
        bi = bi + 1;
    }
    ret nil;
}

fun emit_edge_copies(ctx: *lctx.LowerCtx, pred_mb: *mir.MirBlock, dsts: *mir.VRegId, srcs: *mir.MirOperand, wids: *u8, n: u32) err[fail.Fail] {
    val re: res[*bool, A.Error] = A.allocate[bool](ctx.alloc, n::usize);
    if (sel re.err) { ret err[fail.Fail].err{fail.refused(re.err)}; }
    val done: *bool = re.ok;

    var remaining: u32 = 0;
    var i:         u32 = 0;
    for (i < n) {
        if (srcs[i].kind == mir.MIR_OP_VREG && mir.vreg_same(srcs[i].vreg, dsts[i])) {
            done[i] = true;
        }
        or {
            done[i]   = false;
            remaining = remaining + 1;
        }
        i = i + 1;
    }

    var failure: err[fail.Fail] = err[fail.Fail].ok{};
    for (remaining > 0 && sel failure.ok) {
        var progressed: bool = false;
        var j:          u32  = 0;
        for (j < n) {
            if (done[j] == false && !dst_is_pending_src(dsts, srcs, done, n, dsts[j])) {
                val mv: err[fail.Fail] = insert_mov_before_terminator(ctx, pred_mb,
                    mir.op_vreg(dsts[j]), srcs[j], wids[j]);
                if (sel mv.err) {
                    failure = err[fail.Fail].err{mv.err};
                    j       = n;
                    cnt;
                }
                done[j]    = true;
                remaining  = remaining - 1;
                progressed = true;
            }
            j = j + 1;
        }

        if (sel failure.ok && progressed == false && remaining > 0) {
            var c: u32 = 0;
            for (done[c]) { c = c + 1; }
            val freed: mir.VRegId                 = dsts[c];
            val cls:   u32                        = ctx.f.vregs[freed.n].class;
            val tr:    res[mir.VRegId, fail.Fail] = lctx.new_vreg_vec(ctx, cls, ctx.f.vregs[freed.n].vector);
            if (sel tr.err) {
                failure = err[fail.Fail].err{tr.err};
                cnt;
            }
            val tmp: mir.VRegId = tr.ok;
            ctx.f.vregs[tmp.n].ty = ctx.f.vregs[freed.n].ty;
            val sv: err[fail.Fail] = insert_mov_before_terminator(ctx, pred_mb,
                mir.op_vreg(tmp), mir.op_vreg(freed), ctx.tgt.model.gpr_width::u8);
            if (sel sv.err) {
                failure = err[fail.Fail].err{sv.err};
                cnt;
            }
            var d: u32 = 0;
            for (d < n) {
                if (done[d] == false && srcs[d].kind == mir.MIR_OP_VREG && mir.vreg_same(srcs[d].vreg, freed)) {
                    srcs[d] = mir.op_vreg(tmp);
                }
                d = d + 1;
            }
        }
    }

    A.deallocate[bool](ctx.alloc, done, n::usize);
    ret failure;
}

fun dst_is_pending_src(dsts: *mir.VRegId, srcs: *mir.MirOperand, done: *bool, n: u32, v: mir.VRegId) bool {
    var i: u32 = 0;
    for (i < n) {
        if (done[i] == false && srcs[i].kind == mir.MIR_OP_VREG && mir.vreg_same(srcs[i].vreg, v)) {
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun imm_merge_width(ctx: *lctx.LowerCtx, wid: u8) u8 {
    if (wid == 4) { ret 4; }
    var w: u8 = ctx.tgt.model.gpr_width::u8;
    if (wid > w) { w = wid; }
    ret w;
}

fun insert_mov_before_terminator(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, dst: mir.MirOperand, src: mir.MirOperand, wid: u8) err[fail.Fail] {
    if (mb.instr_count == 0) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: phi predecessor block has no terminator")};
    }
    val term: *mir.MirInstr = ?mb.instrs[mb.instr_count - 1];
    if (!is_mir_terminator(term.opcode)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: phi predecessor block does not end in a terminator")};
    }

    val r: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *mir.MirOperand = r.ok;
    ops[0] = dst;
    ops[1] = src;
    var mi: mir.MirInstr = mir.instr(mir.MIR_MOV, ops, 2, 0, 0);
    if (src.kind == mir.MIR_OP_SYM) { mi.opcode = mir.MIR_GEP; }
    var copy_w: u8 = ctx.tgt.model.gpr_width::u8;
    if (wid > copy_w) { copy_w = wid; }
    mi.width     = copy_w;
    mi.src_width = copy_w;
    if (src.kind == mir.MIR_OP_IMM) {
        val iw: u8 = imm_merge_width(ctx, wid);
        mi.width     = iw;
        mi.src_width = iw;
    }
    or (dst.kind == mir.MIR_OP_VREG && dst.vreg.n < ctx.f.vreg_count && ctx.f.vregs[dst.vreg.n].vector) {
        mi.width     = 16;
        mi.src_width = 16;
    }
    mi.loc           = term.loc;
    mi.inline_site   = term.inline_site;
    mi.writes_secret = false;

    val gr: err[fail.Fail] = lctx.grow_instr(ctx, mb);
    if (sel gr.err) {
        A.deallocate[mir.MirOperand](ctx.alloc, ops, 2::usize);
        ret gr;
    }
    mb.instrs[mb.instr_count]     = mb.instrs[mb.instr_count - 1];
    mb.instrs[mb.instr_count - 1] = mi;
    mb.instr_count                = mb.instr_count + 1;
    ret err[fail.Fail].ok{};
}

fun is_mir_terminator(o: mir.MirOpcode) bool {
    ret mir.is_terminator(o);
}

fun block_ends_in_cbr(mb: *mir.MirBlock) bool {
    if (mb.instr_count == 0) { ret false; }
    ret mb.instrs[mb.instr_count - 1].opcode == mir.MIR_CBR;
}

fun grow_block(ctx: *lctx.LowerCtx) err[fail.Fail] {
    val f: *mir.MirFunction = ctx.f;
    if (f.block_count >= f.block_cap) {
        var new_cap: u32 = f.block_cap * 2;
        if (new_cap < f.block_count + 1) { new_cap = f.block_count + 1; }
        val r: res[*mir.MirBlock, A.Error] = A.reallocate[mir.MirBlock](ctx.alloc, f.blocks, f.block_cap::usize, new_cap::usize);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        f.blocks    = r.ok;
        f.block_cap = new_cap;
    }
    ret err[fail.Fail].ok{};
}

fun fresh_block_id(ctx: *lctx.LowerCtx) u32 {
    ctx.max_block_id = ctx.max_block_id + 1;
    ret ctx.max_block_id;
}

fun split_critical_edge(ctx: *lctx.LowerCtx, pred: *mir.MirBlock, succ_id: u32) res[*mir.MirBlock, fail.Fail] {
    val pred_id: u32 = pred.id;
    val new_id:  u32 = fresh_block_id(ctx);

    val gr: err[fail.Fail] = grow_block(ctx);
    if (sel gr.err) { ret res[*mir.MirBlock, fail.Fail].err{gr.err}; }

    val f: *mir.MirFunction = ctx.f;
    val b: *mir.MirBlock    = ?f.blocks[f.block_count];
    b.id          = new_id;
    b.instrs      = nil;
    b.instr_count = 0;
    b.instr_cap   = 0;
    b.preds       = nil;
    b.pred_count  = 0;
    b.pred_cap    = 0;

    val rb: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 1::usize);
    if (sel rb.err) { ret res[*mir.MirBlock, fail.Fail].err{fail.refused(rb.err)}; }
    val bops: *mir.MirOperand = rb.ok;
    bops[0] = mir.op_block(succ_id);
    var br: mir.MirInstr = mir.instr(mir.MIR_BR, bops, 1,
        ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);

    val ri: res[*mir.MirInstr, A.Error] = A.allocate[mir.MirInstr](ctx.alloc, 1::usize);
    if (sel ri.err) {
        A.deallocate[mir.MirOperand](ctx.alloc, bops, 1::usize);
        ret res[*mir.MirBlock, fail.Fail].err{fail.refused(ri.err)};
    }
    b.instrs      = ri.ok;
    b.instrs[0]   = br;
    b.instr_count = 1;
    b.instr_cap   = 1;

    val rp: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, 1::usize);
    if (sel rp.err) { ret res[*mir.MirBlock, fail.Fail].err{fail.refused(rp.err)}; }
    b.preds      = rp.ok;
    b.preds[0]   = pred_id;
    b.pred_count = 1;
    b.pred_cap   = 1;

    f.block_count = f.block_count + 1;

    retarget_cbr(mir_block_by_id(f, pred_id), succ_id, new_id);
    replace_pred(mir_block_by_id(f, succ_id), pred_id, new_id);

    ret res[*mir.MirBlock, fail.Fail].ok{?f.blocks[f.block_count - 1]};
}

fun retarget_cbr(mb: *mir.MirBlock, from: u32, to: u32) {
    if (mb == nil || mb.instr_count == 0) { ret; }
    val term: *mir.MirInstr = ?mb.instrs[mb.instr_count - 1];
    var i:    u32           = 0;
    for (i < term.operand_count) {
        if (term.operands[i].kind == mir.MIR_OP_BLOCK && term.operands[i].imm::u32 == from) {
            term.operands[i].imm = to::i64;
        }
        i = i + 1;
    }
}

fun replace_pred(mb: *mir.MirBlock, from: u32, to: u32) {
    if (mb == nil) { ret; }
    var i: u32 = 0;
    for (i < mb.pred_count) {
        if (mb.preds[i] == from) {
            mb.preds[i] = to;
            ret;
        }
        i = i + 1;
    }
}

fun lower_instr(ctx: *lctx.LowerCtx, fn: *ir.Function, mb: *mir.MirBlock, iid: id.InstructionId) err[fail.Fail] {
    val gi: opt[*instr.Instruction] = ir.instruction_get(fn, iid);
    if (!sel gi.some) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: dangling instruction id")};
    }
    val inst: *instr.Instruction = gi.some;

    ctx.cur_loc           = inst.loc;
    ctx.cur_inline_site   = ir.instr_inline_site_of(fn, iid);
    ctx.cur_vec_lane      = lctx.compute_vec_lane(ctx, inst);
    ctx.cur_writes_secret = (inst.kind == instr.OP_STORE || inst.kind == instr.OP_MEMZERO) && inst.secret;
    ctx.cur_memory_flags  = 0;
    if ((inst.flags & instr.INSTR_FLAG_VOLATILE) != 0) { ctx.cur_memory_flags = mir.MEMORY_VOLATILE; }

    val unrealized: err[fail.Fail] = check_int_widths(ctx, inst);
    if (sel unrealized.err) { ret unrealized; }

    var cop: ct.CtOp = opcode_ct_op(inst.kind);
    if (is_float_op(ctx, inst)) { cop = ct.CT_OP_FLOAT; }
    val declared_cap: opt[ct.CtCap] = ct.ct_cap(cop);
    if (sel declared_cap.none) {
        ret err[fail.Fail].err{fail.message(fail.catalog_message_or(ctx.interner, ctx.alloc, fail.unknown_member("CtOp", cop::u32), "unknown CtOp tag"))};
    }
    val ccap: ct.CtCap = declared_cap.some;
    if (ccap != ct.CT_CAP_OK && instr_has_secret_ct_operand(inst, cop)) {
        val cell: ct.CtMulCell = ir_mul_cell(ctx, inst);
        if (!ct.target_provides(target.ct_mul_admitted(ctx.tgt), cell, ctx.tgt.model.ct_trust_var_shift, ccap)) {
            val why: opt[str] = secret_ct_op_unsupported(cop);
            if (sel why.none) {
                ret err[fail.Fail].err{fail.message(fail.catalog_message_or(ctx.interner, ctx.alloc, fail.unknown_member("CtOp", cop::u32), "unknown CtOp tag"))};
            }
            if (cop == ct.CT_OP_INT_MUL && ct.mul_mask_has(target.ct_mul_dit_cells(ctx.tgt), cell)) {
                ret err[fail.Fail].err{lctx.reject(ctx, secret_mul_dit_unguaranteed(ctx))};
            }
            ret err[fail.Fail].err{lctx.reject(ctx, why.some)};
        }
        # an admitted secret multiply in a DIT row is the program's need for the mode
        if (cop == ct.CT_OP_INT_MUL && ct.mul_mask_has(target.ct_mul_dit_cells(ctx.tgt), cell)) {
            ctx.f.needs_dit = true;
        }
    }

    val route: opdesc.LowerRoute = opdesc.lower_route(inst.kind);

    if (route != opdesc.LOWER_PHI && route != opdesc.LOWER_DBG
        && instr_touches_vector(ctx, inst)) {
        if (!ctx.tgt.model.has_v128) {
            ret err[fail.Fail].err{lctx.reject(ctx, vector_unsupported(ctx))};
        }
        if (ctx.tgt.model.vector_compute_generic && is_vector_compute(inst.kind)) {
            ret lower_generic(ctx, mb, inst, iid);
        }
    }

    if (route == opdesc.LOWER_CALL) {
        ret mabi.lower_call(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_RET) {
        ret mabi.lower_ret(ctx, mb, inst);
    }
    if (route == opdesc.LOWER_PHI) {
        ret err[fail.Fail].ok{};
    }
    if (route == opdesc.LOWER_DBG) {
        var vreg: mir.VRegId = mir.MIR_VREG_NIL;
        if (inst.operand_count > 0) {
            val op_r: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[0]);
            if (sel op_r.err) { ret err[fail.Fail].err{op_r.err}; }
            val op: mir.MirOperand = op_r.ok;
            if (op.kind == mir.MIR_OP_VREG) { vreg = op.vreg; }
        }
        # the value exists from the end of the instruction that defines it, so a
        # binding of the def just lowered is published there; anything regalloc
        # or legalize later puts between the def and its successor is covered
        if (!mir.vreg_is_nil(vreg) && mb.instr_count > 0) {
            val last: *mir.MirInstr = ?mb.instrs[mb.instr_count - 1];
            if (instr_defines_vreg(last, vreg)) {
                ret mir.instr_attach_dbg_end(ctx.alloc, last, iid::u32, vreg.n);
            }
        }
        ret lctx.push_pending_dbg(ctx, iid::u32, vreg.n);
    }
    if (route == opdesc.LOWER_ALLOCA) {
        ret lower_alloca(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_LOAD) {
        ret lower_load(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_STORE) {
        ret lower_store(ctx, mb, inst);
    }
    if (route == opdesc.LOWER_MEMZERO) {
        ret lower_memzero(ctx, mb, inst);
    }
    if (route == opdesc.LOWER_GEP) {
        ret lower_gep(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_VEC_EXTRACT) {
        ret lower_vec_extract(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_VEC_INSERT) {
        ret lower_vec_insert(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_VEC_BUILD) {
        ret lower_vec_build(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_DECLASSIFY) {
        val ddst:  mir.VRegId                     = lctx.instr_vreg(ctx, iid);
        val src_r: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[0]);
        if (sel src_r.err) { ret err[fail.Fail].err{src_r.err}; }
        ret lctx.emit_declassify(ctx, mb, mir.op_vreg(ddst), src_r.ok, lctx.op_width_of(ctx, inst.ty));
    }
    if (is_float_op(ctx, inst)) {
        ret lower_float_op(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_NEG && lctx.value_is_float(ctx, inst.ty)) {
        ret lower_float_neg(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_BITCAST && bitcast_needs_frame(ctx, inst)) {
        ret lower_bitcast_via_frame(ctx, mb, inst, iid);
    }
    if (route == opdesc.LOWER_DIV) {
        ret lower_div(ctx, mb, inst, iid);
    }

    if (route == opdesc.LOWER_SHIFT) {
        ret lower_shift(ctx, mb, inst, iid);
    }

    if (route == opdesc.LOWER_ASM) {
        ret lower_asm_instr(ctx, mb, iid);
    }

    if (route == opdesc.LOWER_CBR) {
        ret lower_cbr(ctx, mb, inst, iid);
    }

    ret lower_generic(ctx, mb, inst, iid);
}

# an integer the target does not realize is refused at the first instruction
# that produces or consumes one, naming the target and the width: the one
# refusal site for a width outside MachineModel.int_widths (#3511). sema is
# target-independent, so `u128` type-checks everywhere and is refused here
fun check_int_widths(ctx: *lctx.LowerCtx, inst: *instr.Instruction) err[fail.Fail] {
    var bytes: u32 = lctx.unrealized_int_width(ctx, inst.ty);
    var i:     u32 = 0;
    for (bytes == 0 && i < inst.operand_count) {
        if (!refs.operand_is_block(inst.kind, i)) { bytes = lctx.unrealized_int_width(ctx, inst.operands[i].ty); }
        i = i + 1;
    }
    if (bytes == 0) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{lctx.reject(ctx, unrealized_int_message(ctx, bytes))};
}

# a parameter or the return of the function itself, refused at its declaration
fun check_signature_int_widths(ctx: *lctx.LowerCtx, fn: *ir.Function) err[fail.Fail] {
    var bytes: u32 = lctx.unrealized_int_width(ctx, lctx.fn_return_type(ctx));
    var i:     u32 = 0;
    for (bytes == 0 && i < fn.param_count) {
        bytes = lctx.unrealized_int_width(ctx, fn.params[i].ty);
        i     = i + 1;
    }
    if (bytes == 0) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{lctx.reject(ctx, unrealized_int_message(ctx, bytes))};
}

fun unrealized_int_message(ctx: *lctx.LowerCtx, bytes: u32) str {
    val fallback: str = "a 128-bit integer is not realized on this target: it declares no integer of that width";
    var arch:     str = ctx.tgt.isa.name;
    if (arch == nil) { arch = "this target"; }
    val rm: res[str, format.FormatError] = format.sprint(ctx.alloc,
        "a {}-bit integer is not realized on {}: the target declares no integer of that width", bytes * 8, arch);
    if (sel rm.err) { ret fallback; }
    ret intern_owned(ctx, rm.ok, fallback);
}

fun instr_touches_vector(ctx: *lctx.LowerCtx, inst: *instr.Instruction) bool {
    if (lctx.value_is_vector(ctx, inst.ty)) { ret true; }
    var i: u32 = 0;
    for (i < inst.operand_count) {
        if (lctx.value_is_vector(ctx, inst.operands[i].ty)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun intern_owned(ctx: *lctx.LowerCtx, buf: str, fallback: str) str {
    val ir: res[intern.StrId, A.Error] = intern.intern(ctx.interner, buf);
    A.deallocate[u8](ctx.alloc, buf::*u8, str_len(buf) + 1);
    if (sel ir.err) { ret fallback; }
    val rn: opt[str] = intern.lookup(ctx.interner, ir.ok);
    if (sel rn.some) { ret rn.some; }
    ret fallback;
}

fun opcode_ct_op(kind: instr.InstrKind) ct.CtOp {
    val c: opdesc.CtClass = opdesc.ct_class(kind);
    if (c == opdesc.CTC_INT_MUL)   { ret ct.CT_OP_INT_MUL; }
    if (c == opdesc.CTC_VAR_SHIFT) { ret ct.CT_OP_VAR_SHIFT; }
    if (c == opdesc.CTC_FLOAT)     { ret ct.CT_OP_FLOAT; }
    ret ct.CT_OP_NONE;
}

# the multiply cell an IR multiply lowers to: the low half at its operand
# width, a lane multiply at its operand lane width, and a widening one as the
# full product of its operand lanes
fun ir_mul_cell(ctx: *lctx.LowerCtx, inst: *instr.Instruction) ct.CtMulCell {
    var op: ct.CtMulOp = ct.CT_MUL_LOW;
    if (inst.kind == instr.OP_MUL_WIDE_S) { op = ct.CT_MUL_WIDE_S; }
    if (inst.kind == instr.OP_MUL_WIDE_U) { op = ct.CT_MUL_WIDE_U; }
    if (inst.kind == instr.OP_MUL_HIGH_S) { op = ct.CT_MUL_HIGH_S; }
    if (inst.kind == instr.OP_MUL_HIGH_U) { op = ct.CT_MUL_HIGH_U; }
    var operand_ty: ir_type.IrTypeId = inst.ty;
    if (inst.operand_count >= 1) { operand_ty = inst.operands[0].ty; }
    val lane: u32 = lctx.vec_lane_for_type(ctx, operand_ty);
    if (mir.vec_lane_is_vector(lane)) {
        ret ct.mul_cell(op, mir.vec_lane_elem_bytes(lane) * 8, true);
    }
    ret ct.mul_cell(op, lctx.op_width_of(ctx, operand_ty) * 8, false);
}

fun is_fp_convert(kind: instr.InstrKind) bool {
    ret opdesc.has(kind, opdesc.EFF_FP_CONVERT);
}

fun instr_has_secret_ct_operand(inst: *instr.Instruction, cop: ct.CtOp) bool {
    if (ct.ct_op_gates_count_only(cop)) {
        ret inst.operand_count >= 2 && inst.operands[1].secret;
    }
    var i: u32 = 0;
    for (i < inst.operand_count) {
        if (inst.operands[i].secret) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the refusal text of a secret operand on an operation whose capability the
# target does not provide; absent for a tag outside the catalog
fun secret_ct_op_unsupported(cop: ct.CtOp) opt[str] {
    if (cop == ct.CT_OP_VAR_SHIFT) {
        ret opt[str].some{"secret value used as a variable shift count on a target without a barrel shifter; the shift's cycle count leaks the secret amount. shift by a public count, or run on a target whose variable shift is constant-time"};
    }
    if (cop == ct.CT_OP_FLOAT) {
        ret opt[str].some{"secret value used as an operand of a variable-latency floating-point operation; the FP unit's timing can depend on the secret operand. compute on public data, or `:>T` to a public value when disclosure is intended"};
    }
    if (cop == ct.CT_OP_INT_MUL) {
        ret opt[str].some{"secret value used as an operand of a variable-latency integer multiply; this target documents no data-independent multiply timing, so the product's latency can leak the secret operand. compute the operation branch-free over public data, or run on a target whose DIT/DOITM mode is trusted"};
    }
    if (cop == ct.CT_OP_INT_DIVMOD) {
        ret opt[str].some{"secret value used as an operand of an integer divide or remainder; the division unit\'s latency is data-dependent, so it leaks the secret operand. compute branch-free over public data"};
    }
    ret opt[str].none{};
}

test "mach.lang.be.codegen.mir.lower.ct_gate:mechanism" {
    if (opcode_ct_op(instr.OP_MUL) != ct.CT_OP_INT_MUL)     { ret 1; }
    if (opcode_ct_op(instr.OP_SHL) != ct.CT_OP_VAR_SHIFT)   { ret 1; }
    if (opcode_ct_op(instr.OP_SHR_S) != ct.CT_OP_VAR_SHIFT) { ret 1; }
    if (opcode_ct_op(instr.OP_SHR_U) != ct.CT_OP_VAR_SHIFT) { ret 1; }
    if (opcode_ct_op(instr.OP_ADD) != ct.CT_OP_NONE)        { ret 1; }
    if (opcode_ct_op(instr.OP_FP_TO_SI) != ct.CT_OP_FLOAT)  { ret 1; }
    if (opcode_ct_op(instr.OP_FP_EXT) != ct.CT_OP_FLOAT)    { ret 1; }
    if (opcode_ct_op(instr.OP_SI_TO_FP) != ct.CT_OP_FLOAT)  { ret 1; }
    if (opcode_ct_op(instr.OP_DIV_S) != ct.CT_OP_NONE)      { ret 1; }
    if (opcode_ct_op(instr.OP_REM_U) != ct.CT_OP_NONE)      { ret 1; }

    var ops: [2]value.Value;
    ops[0].kind   = value.VAL_CONST_INT;
    ops[0].secret = false;
    ops[1].kind   = value.VAL_CONST_INT;
    ops[1].secret = true;
    var shl: instr.Instruction;
    shl.kind          = instr.OP_SHL;
    shl.operands      = ?ops[0];
    shl.operand_count = 2;

    if (!instr_has_secret_ct_operand(?shl, ct.CT_OP_VAR_SHIFT)) { ret 1; }

    ops[0].secret = true;
    ops[1].secret = false;
    if (instr_has_secret_ct_operand(?shl, ct.CT_OP_VAR_SHIFT)) { ret 1; }

    if (!instr_has_secret_ct_operand(?shl, ct.CT_OP_INT_MUL)) { ret 1; }

    if (!ct.cap_at_mir(ct.ct_cap_or_always(ct.CT_OP_VAR_SHIFT))) { ret 1; }
    val low: ct.CtMulCell = ct.mul_cell(ct.CT_MUL_LOW, 64, false);
    if (ct.target_provides(ct.mul_mask_none(), low, false, ct.ct_cap_or_always(ct.CT_OP_VAR_SHIFT))) { ret 1; }
    if (!ct.target_provides(ct.mul_mask_none(), low, true, ct.ct_cap_or_always(ct.CT_OP_VAR_SHIFT))) { ret 1; }
    ret 0;
}

# the exponent pow2_exponent finds, -1 for none
fun t_pow2(v: value.Value, bits: u32) i64 {
    val k: opt[u32] = pow2_exponent(v, bits);
    if (sel k.some) { ret k.some::i64; }
    ret -1;
}

# a divisor's power-of-two test reads both limbs at the operand width (#3511)
test "mach.lang.be.codegen.mir.lower.pow2_exponent:reads_both_limbs" {
    if (t_pow2(value.const_int(8, 0), 64) != 3)                      { ret 1; }
    if (t_pow2(value.const_int(1, 0), 64) != -1)                     { ret 2; }
    if (t_pow2(value.const_int(12, 0), 64) != -1)                    { ret 3; }
    if (t_pow2(value.const_int_wide(wide.make(0, 1), 0), 128) != 64) { ret 4; }
    if (t_pow2(value.const_int_wide(wide.make(4, 1), 0), 128) != -1) { ret 5; }
    # the operand width truncates: 2^64 at 64 bits is zero
    if (t_pow2(value.const_int_wide(wide.make(0, 1), 0), 64) != -1) { ret 6; }
    if (t_pow2(value.const_int(0x108, 0), 8) != 3)                  { ret 7; }
    ret 0;
}

# a zero extension of a full 64-bit immediate has no sign to fill (#3511)
test "mach.lang.be.codegen.mir.lower.promote_imm:unsigned_full_limb_is_not_sign_filled" {
    val zu: mir.MirOperand = promote_imm(-1, 8, false);
    if (zu.kind != mir.MIR_OP_IMM || zu.imm != -1 || zu.imm_hi != 0) { ret 1; }
    val zs: mir.MirOperand = promote_imm(-1, 8, true);
    if (zs.imm != -1 || zs.imm_hi != -1) { ret 2; }
    val nu: mir.MirOperand = promote_imm(200, 1, false);
    if (nu.imm != 200 || nu.imm_hi != 0) { ret 3; }
    val ns: mir.MirOperand = promote_imm(200, 1, true);
    if (ns.imm != -56 || ns.imm_hi != -1) { ret 4; }
    val wu: mir.MirOperand = promote_imm(0x7FFFFFFF, 4, false);
    if (wu.imm != 0x7FFFFFFF || wu.imm_hi != 0) { ret 5; }
    ret 0;
}

test "mach.lang.be.codegen.mir.lower.narrow_imm_value" {
    if (narrow_imm_value(200, 1, true) != -56)      { ret 1; }
    if (narrow_imm_value(127, 1, true) != 127)      { ret 1; }
    if (narrow_imm_value(128, 1, true) != -128)     { ret 1; }
    if (narrow_imm_value(0, 1, true) != 0)          { ret 1; }
    if (narrow_imm_value(200, 1, false) != 200)     { ret 1; }
    if (narrow_imm_value(255, 1, false) != 255)     { ret 1; }
    if (narrow_imm_value(65535, 2, true) != -1)     { ret 1; }
    if (narrow_imm_value(32768, 2, true) != -32768) { ret 1; }
    if (narrow_imm_value(65535, 2, false) != 65535) { ret 1; }
    if (narrow_imm_value(-56, 1, true) != -56)      { ret 1; }
    if (narrow_imm_value(-56, 4, true) != -56)      { ret 1; }
    if (narrow_imm_value(-56, 8, true) != -56)      { ret 1; }
    if (narrow_imm_value(-56, 0, true) != -56)      { ret 1; }
    ret 0;
}

# a secret multiply in a cell the instruction set declares only under PSTATE.DIT
# on an os that declares no guarantee for the mode: the refusal names both
fun secret_mul_dit_unguaranteed(ctx: *lctx.LowerCtx) str {
    val fallback: str                          = "codegen: secret value used as an operand of an integer multiply whose timing is data-independent only under PSTATE.DIT, and this operating system declares no guarantee that a process can set and hold that mode (#3508). compute the operation branch-free over public data, or build for an operating system that declares the guarantee";
    val jr:       res[str, format.FormatError] = format.sprint(ctx.alloc,
        "codegen: secret value used as an operand of an integer multiply whose timing is data-independent only under PSTATE.DIT; the `{}` instruction set declares the multiply under that mode and the `{}` operating system declares no guarantee that a process can set and hold it (#3508). compute the operation branch-free over public data, or build for an operating system that declares the guarantee",
        ctx.tgt.isa.name, ctx.tgt.os.name);
    if (sel jr.err) { ret fallback; }
    ret intern_owned(ctx, jr.ok, fallback);
}

fun vector_unsupported(ctx: *lctx.LowerCtx) str {
    val prefix:   str = "128-bit vectors not yet supported on ";
    val fallback: str = "128-bit vectors not yet supported on this target";
    val arch:     str = ctx.tgt.isa.name;
    if (arch == nil) { ret fallback; }

    val jr: res[str, StrError] = str_join(ctx.alloc, prefix, arch);
    if (sel jr.err) { ret fallback; }
    ret intern_owned(ctx, jr.ok, fallback);
}

fun lower_cbr(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction, iid: id.InstructionId) err[fail.Fail] {
    if (inst.operand_count < 3) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: conditional branch missing operands")};
    }

    val cond_r: res[mir.MirOperand, fail.Fail] = lctx.lower_operand(ctx, inst, 0);
    if (sel cond_r.err) { ret err[fail.Fail].err{cond_r.err}; }
    var cond: mir.MirOperand = cond_r.ok;
    if (cond.kind == mir.MIR_OP_IMM) {
        val rv: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
        if (sel rv.err) { ret err[fail.Fail].err{rv.err}; }
        val creg: mir.VRegId     = rv.ok;
        val mv:   err[fail.Fail] = lctx.emit_mov(ctx, mb, mir.op_vreg(creg), cond);
        if (sel mv.err) { ret mv; }
        cond = mir.op_vreg(creg);
    }

    val rop: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 3::usize);
    if (sel rop.err) { ret err[fail.Fail].err{fail.refused(rop.err)}; }
    val ops: *mir.MirOperand = rop.ok;
    ops[0] = cond;
    val lowered_2: res[mir.MirOperand, fail.Fail] = lctx.lower_operand(ctx, inst, 1);
    if (sel lowered_2.err) { ret err[fail.Fail].err{lowered_2.err}; }
    ops[1] = lowered_2.ok;
    val lowered_3: res[mir.MirOperand, fail.Fail] = lctx.lower_operand(ctx, inst, 2);
    if (sel lowered_3.err) { ret err[fail.Fail].err{lowered_3.err}; }
    ops[2] = lowered_3.ok;

    var mi: mir.MirInstr = mir.instr(inst.kind::u32, ops, 3, 0, 0);
    set_generic_widths(ctx, inst, ?mi);
    mi.width = lctx.op_width_of(ctx, inst.operands[0].ty);
    ret lctx.push_instr(ctx, mb, mi);
}

fun asm_bind_message(ctx: *lctx.LowerCtx, prefix: str, name_id: intern.StrId, suffix: str, fallback: str) str {
    val no: opt[str] = intern.lookup(ctx.interner, name_id);
    if (sel no.none) { ret fallback; }
    val nm: str = no.some;

    val jr: res[str, StrError] = str_join(ctx.alloc, prefix, nm, suffix);
    if (sel jr.err) { ret fallback; }
    ret intern_owned(ctx, jr.ok, fallback);
}

fun lower_asm_instr(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, iid: id.InstructionId) err[fail.Fail] {
    var key: id.InstructionId = iid;
    val pr:  opt[*ir.IrAsm]   = map.get[id.InstructionId, ir.IrAsm](?ctx.fn.asm_blocks, ?key);
    if (sel pr.none) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: OP_ASM instruction has no asm payload")};
    }
    val src: *ir.IrAsm = pr.some;

    val isa_opt: opt[str] = intern.lookup(ctx.interner, src.isa);
    if (sel isa_opt.none) { ret err[fail.Fail].err{fail.message("mir.lower_ir: inline-asm ISA tag not interned")}; }
    val body_opt: opt[str] = intern.lookup(ctx.interner, src.body);
    if (sel body_opt.none) { ret err[fail.Fail].err{fail.message("mir.lower_ir: inline-asm body not interned")}; }

    val rp: res[*mir.MirAsm, A.Error] = A.allocate[mir.MirAsm](ctx.alloc, 1::usize);
    if (sel rp.err) { ret err[fail.Fail].err{fail.refused(rp.err)}; }
    val payload: *mir.MirAsm = rp.ok;
    payload.isa        = isa_opt.some;
    payload.body       = body_opt.some;
    payload.binds      = nil;
    payload.bind_count = 0;

    if (src.bind_count > 0) {
        val rb: res[*mir.MirAsmBind, A.Error] = A.allocate[mir.MirAsmBind](ctx.alloc, src.bind_count::usize);
        if (sel rb.err) {
            A.deallocate[mir.MirAsm](ctx.alloc, payload, 1::usize);
            ret err[fail.Fail].err{fail.refused(rb.err)};
        }
        payload.binds = rb.ok;
        var k: u32 = 0;
        for (k < src.bind_count) {
            var vreg: mir.VRegId = lctx.slot_key_vreg(ctx, src.binds[k].instr);
            if (mir.vreg_is_nil(vreg)) { vreg = lctx.instr_vreg(ctx, src.binds[k].instr); }
            if (mir.vreg_is_nil(vreg)) {
                val msg: str = asm_bind_message(ctx, "inline-asm local '", src.binds[k].name, "' has no addressable storage slot", "inline-asm local has no addressable storage slot");
                A.deallocate[mir.MirAsmBind](ctx.alloc, payload.binds, src.bind_count::usize);
                A.deallocate[mir.MirAsm](ctx.alloc, payload, 1::usize);
                ret err[fail.Fail].err{fail.message(msg)};
            }
            payload.binds[k] = mir.asm_bind(src.binds[k].name, vreg.n, src.binds[k].secrecy);
            k                = k + 1;
        }
        payload.bind_count = src.bind_count;
    }

    var mi: mir.MirInstr = mir.instr(mir.MIR_ASM, nil, 0, 0, 0);
    mi.asm_block = payload;

    val push: err[fail.Fail] = lctx.push_instr(ctx, mb, mi);
    if (sel push.err) {
        if (payload.binds != nil) { A.deallocate[mir.MirAsmBind](ctx.alloc, payload.binds, payload.bind_count::usize); }
        A.deallocate[mir.MirAsm](ctx.alloc, payload, 1::usize);
        ret push;
    }
    ret err[fail.Fail].ok{};
}

fun narrow_shift_value(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction,
    value: mir.MirOperand, natural_w: u8, w: u8) res[mir.MirOperand, fail.Fail] {
    if (inst.kind == instr.OP_SHL) { ret res[mir.MirOperand, fail.Fail].ok{value}; }
    if (natural_w >= w)            { ret res[mir.MirOperand, fail.Fail].ok{value}; }

    val vr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel vr.err) { ret res[mir.MirOperand, fail.Fail].err{vr.err}; }
    val v: mir.VRegId = vr.ok;

    val pr: err[fail.Fail] = emit_promote(ctx, mb, mir.op_vreg(v), value, w, natural_w,
        inst.kind == instr.OP_SHR_S);
    if (sel pr.err) { ret res[mir.MirOperand, fail.Fail].err{pr.err}; }
    ret res[mir.MirOperand, fail.Fail].ok{mir.op_vreg(v)};
}

# a shift count at or above the operand's width saturates: `<<` and a logical
# `>>` answer 0, an arithmetic `>>` the sign fill (#3756). the machine masks
# the count to its own width, so the saturation is computed here, branch-free,
# from `k = count < W`: a logical result is masked by `0 - k`, an arithmetic
# count becomes `count | (k - 1)`, all ones out of range, which the machine
# masks to its width - 1 and the sign-extended value fills from
fun lower_shift(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction, iid: id.InstructionId) err[fail.Fail] {
    if (inst.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: shift missing value or count operand")};
    }
    val dst: mir.VRegId = lctx.instr_vreg(ctx, iid);
    if (mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: shift defines no result vreg")};
    }
    val natural_w: u8   = lctx.op_width_of(ctx, inst.ty);
    val w:         u8   = lctx.clamp_alu_width(ctx.tgt.model.alu_min_width, natural_w);
    val bits:      i64  = natural_w::i64 * 8;
    val arith:     bool = inst.kind == instr.OP_SHR_S;

    var op: mir.MirOpcode = mir.MIR_SHR_U;
    if (inst.kind == instr.OP_SHL) { op = mir.MIR_SHL; }
    or (arith)                     { op = mir.MIR_SHR_S; }

    val raw_r: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[0]);
    if (sel raw_r.err) { ret err[fail.Fail].err{raw_r.err}; }
    val raw:     mir.MirOperand                 = raw_r.ok;
    val count_r: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[1]);
    if (sel count_r.err) { ret err[fail.Fail].err{count_r.err}; }
    var count: mir.MirOperand = count_r.ok;

    val rv: res[mir.MirOperand, fail.Fail] = narrow_shift_value(ctx, mb, inst, raw, natural_w, w);
    if (sel rv.err) { ret err[fail.Fail].err{rv.err}; }
    val value: mir.MirOperand = rv.ok;

    # a constant count reaching here is below the width unless a fold exposed
    # it after constfold ran; the saturated value is then the whole result
    if (count.kind == mir.MIR_OP_IMM && (count.imm < 0 || count.imm >= bits)) {
        if (!arith) { ret lctx.emit_mov_w(ctx, mb, mir.op_vreg(dst), mir.op_imm(0), w); }
        count = mir.op_imm(bits - 1);
    }

    var in_range: mir.MirOperand = mir.op_imm(1);
    if (count.kind != mir.MIR_OP_IMM) {
        val bounded: bool = count_below(ctx, inst.operands[1], bits);
        if (!bounded) {
            val kr: res[mir.MirOperand, fail.Fail] = emit_count_in_range(ctx, mb, inst, count, bits);
            if (sel kr.err) { ret err[fail.Fail].err{kr.err}; }
            in_range = kr.ok;
        }
        val tr: res[mir.MirOperand, fail.Fail] = count_at_shift_width(ctx, mb, inst, count, w);
        if (sel tr.err) { ret err[fail.Fail].err{tr.err}; }
        count = tr.ok;
        if (arith && !bounded) {
            val nr: res[mir.MirOperand, fail.Fail] = emit_saturating_arith_count(ctx, mb, inst, count, in_range, w);
            if (sel nr.err) { ret err[fail.Fail].err{nr.err}; }
            count = nr.ok;
        }
    }

    # the fixed count register serves the machine's own variable shift. a shift
    # wider than the alu is legalized into constant-shift stages selected by the
    # count's bits, so its count stays a vreg legalize reads in the low lane
    var count_op: mir.MirOperand = count;
    val maw:      u8             = ctx.tgt.model.max_alu_width::u8;
    if (count.kind != mir.MIR_OP_IMM && (maw == 0 || w <= maw)) {
        val cnt_reg: i32 = ctx.tgt.model.shift_count_reg;
        if (cnt_reg >= 0) {
            val mc: err[fail.Fail] = lctx.emit_mov_w(ctx, mb, mir.op_preg(mir.preg_id(cnt_reg)), count, w);
            if (sel mc.err) { ret mc; }
            count_op = mir.op_preg(mir.preg_id(cnt_reg));
        }
    }

    val needs_mask: bool       = !arith && in_range.kind != mir.MIR_OP_IMM;
    var shifted:    mir.VRegId = dst;
    if (needs_mask) {
        val sr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
        if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
        shifted = sr.ok;
    }

    val r: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 3::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *mir.MirOperand = r.ok;
    ops[0] = mir.op_vreg(shifted);
    ops[1] = value;
    ops[2] = count_op;
    var mi: mir.MirInstr   = mir.instr(op, ops, 3, w, w);
    val ps: err[fail.Fail] = lctx.push_instr(ctx, mb, mi);
    if (sel ps.err || !needs_mask) { ret ps; }

    # logical: the result survives only when the count was in range
    val mr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val keep: mir.VRegId     = mr.ok;
    val pr:   err[fail.Fail] = emit_promote(ctx, mb, mir.op_vreg(keep), in_range, w, 1, false);
    if (sel pr.err) { ret pr; }
    val nr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel nr.err) { ret err[fail.Fail].err{nr.err}; }
    val mask: mir.VRegId     = nr.ok;
    val ng:   err[fail.Fail] = emit_alu2(ctx, mb, mir.MIR_NEG, mir.op_vreg(mask), mir.op_vreg(keep), w);
    if (sel ng.err) { ret ng; }
    ret emit_alu3(ctx, mb, mir.MIR_AND, mir.op_vreg(dst), mir.op_vreg(shifted), mir.op_vreg(mask), w);
}

# a count the ir already bounds below the width needs no saturation: a mask by
# a constant under the width, seen through the extends and truncations that
# carry it to the shift's count type
fun count_below(ctx: *lctx.LowerCtx, v: value.Value, bits: i64) bool {
    if (v.kind == value.VAL_CONST_INT)              { ret v.data.int_wide.hi == 0 && v.data.int_wide.lo < bits::u64; }
    if (v.kind != value.VAL_INSTR || ctx.fn == nil) { ret false; }
    if (v.data.instr::u32 >= ctx.fn.instr_len)      { ret false; }
    val def: *instr.Instruction = ?ctx.fn.instrs[v.data.instr::u32];
    if (def.operand_count < 1)                                   { ret false; }
    if (def.kind == instr.OP_ZEXT || def.kind == instr.OP_TRUNC) { ret count_below(ctx, def.operands[0], bits); }
    if (def.kind != instr.OP_AND || def.operand_count < 2)       { ret false; }
    ret count_below(ctx, def.operands[0], bits) || count_below(ctx, def.operands[1], bits);
}

# `count < bits` as a 0/1 byte, compared at the count's own width
fun emit_count_in_range(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction,
    count: mir.MirOperand, bits: i64) res[mir.MirOperand, fail.Fail] {
    val cw: u8                         = lctx.op_width_of(ctx, inst.operands[1].ty);
    val kr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel kr.err) { ret res[mir.MirOperand, fail.Fail].err{kr.err}; }
    val k: mir.VRegId     = kr.ok;
    val e: err[fail.Fail] = emit_alu3(ctx, mb, mir.MIR_CMP_LT_U, mir.op_vreg(k), count, mir.op_imm(bits), cw);
    if (sel e.err) { ret res[mir.MirOperand, fail.Fail].err{e.err}; }
    ret res[mir.MirOperand, fail.Fail].ok{mir.op_vreg(k)};
}

# the range test read the whole count; the shift itself reads it at its own
# width, so a count wider than the shift keeps its low bits here. left wide, a
# narrow shift would read a value nothing defines once its lanes replace it,
# as an index wider than the pointer did (#3615)
fun count_at_shift_width(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction,
    count: mir.MirOperand, w: u8) res[mir.MirOperand, fail.Fail] {
    val cw: u8 = lctx.op_width_of(ctx, inst.operands[1].ty);
    if (cw <= w || count.kind != mir.MIR_OP_VREG) { ret res[mir.MirOperand, fail.Fail].ok{count}; }
    val tr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel tr.err) { ret res[mir.MirOperand, fail.Fail].err{tr.err}; }
    val t:  mir.VRegId                    = tr.ok;
    val ar: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (sel ar.err) { ret res[mir.MirOperand, fail.Fail].err{fail.refused(ar.err)}; }
    val ops: *mir.MirOperand = ar.ok;
    ops[0] = mir.op_vreg(t);
    ops[1] = count;
    var mi: mir.MirInstr   = mir.instr(mir.MIR_TRUNC, ops, 2, w, cw);
    val er: err[fail.Fail] = lctx.push_instr(ctx, mb, mi);
    if (sel er.err) { ret res[mir.MirOperand, fail.Fail].err{er.err}; }
    ret res[mir.MirOperand, fail.Fail].ok{mir.op_vreg(t)};
}

# `count | (in_range - 1)`: the count itself in range, all ones out of range,
# at the count's width once it is no wider than the shift
fun emit_saturating_arith_count(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction,
    count: mir.MirOperand, in_range: mir.MirOperand, w: u8) res[mir.MirOperand, fail.Fail] {
    var cw: u8 = lctx.op_width_of(ctx, inst.operands[1].ty);
    if (cw > w) { cw = w; }
    cw = lctx.clamp_alu_width(ctx.tgt.model.alu_min_width, cw);
    val zr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel zr.err) { ret res[mir.MirOperand, fail.Fail].err{zr.err}; }
    val keep: mir.VRegId     = zr.ok;
    val pr:   err[fail.Fail] = emit_promote(ctx, mb, mir.op_vreg(keep), in_range, cw, 1, false);
    if (sel pr.err) { ret res[mir.MirOperand, fail.Fail].err{pr.err}; }
    val fr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel fr.err) { ret res[mir.MirOperand, fail.Fail].err{fr.err}; }
    val fill: mir.VRegId     = fr.ok;
    val sb:   err[fail.Fail] = emit_alu3(ctx, mb, mir.MIR_SUB, mir.op_vreg(fill), mir.op_vreg(keep), mir.op_imm(1), cw);
    if (sel sb.err) { ret res[mir.MirOperand, fail.Fail].err{sb.err}; }
    val nr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel nr.err) { ret res[mir.MirOperand, fail.Fail].err{nr.err}; }
    val n:   mir.VRegId     = nr.ok;
    val orr: err[fail.Fail] = emit_alu3(ctx, mb, mir.MIR_OR, mir.op_vreg(n), count, mir.op_vreg(fill), cw);
    if (sel orr.err) { ret res[mir.MirOperand, fail.Fail].err{orr.err}; }
    ret res[mir.MirOperand, fail.Fail].ok{mir.op_vreg(n)};
}

fun emit_alu2(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, op: mir.MirOpcode, d: mir.MirOperand, a: mir.MirOperand, w: u8) err[fail.Fail] {
    val r: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *mir.MirOperand = r.ok;
    ops[0] = d;
    ops[1] = a;
    var mi: mir.MirInstr = mir.instr(op, ops, 2, w, w);
    ret lctx.push_instr(ctx, mb, mi);
}

fun emit_alu3(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, op: mir.MirOpcode, d: mir.MirOperand, a: mir.MirOperand, b: mir.MirOperand, w: u8) err[fail.Fail] {
    val r: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 3::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *mir.MirOperand = r.ok;
    ops[0] = d;
    ops[1] = a;
    ops[2] = b;
    var mi: mir.MirInstr = mir.instr(op, ops, 3, w, w);
    ret lctx.push_instr(ctx, mb, mi);
}

# the exponent of a divisor that is a power of two at least 2, or none
fun pow2_exponent(v: value.Value, bits: u32) opt[u32] {
    if (v.kind != value.VAL_CONST_INT) { ret opt[u32].none{}; }
    val m: wide.Wide = wide.trunc(value.int_of(?v), bits);
    if (wide.lt_u(m, wide.from_u64(2)) || !wide.is_pow2(m)) { ret opt[u32].none{}; }
    ret opt[u32].some{wide.trailing_zeros(m)};
}

fun div_temp(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, op: mir.MirOpcode, a: mir.MirOperand, b: mir.MirOperand, w: u8) res[mir.MirOperand, fail.Fail] {
    val tr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel tr.err) { ret res[mir.MirOperand, fail.Fail].err{tr.err}; }
    val rop: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 3::usize);
    if (sel rop.err) { ret res[mir.MirOperand, fail.Fail].err{fail.refused(rop.err)}; }
    val ops: *mir.MirOperand = rop.ok;
    ops[0] = mir.op_vreg(tr.ok);
    ops[1] = a;
    ops[2] = b;
    var mi: mir.MirInstr   = mir.instr(op, ops, 3, w, w);
    val pd: err[fail.Fail] = lctx.push_instr(ctx, mb, mi);
    if (sel pd.err) { ret res[mir.MirOperand, fail.Fail].err{pd.err}; }
    ret res[mir.MirOperand, fail.Fail].ok{mir.op_vreg(tr.ok)};
}

# a division or remainder by a power of two is shifts and masks. the signed
# forms round toward zero by adding the sign-extended low bits of the divisor
# before the arithmetic shift, the way every C compiler does
fun lower_div_pow2(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction, dst: mir.VRegId, k: u32) err[fail.Fail] {
    val signed: bool = inst.kind == instr.OP_DIV_S || inst.kind == instr.OP_REM_S;
    val is_rem: bool = inst.kind == instr.OP_REM_S || inst.kind == instr.OP_REM_U;

    val natural_w: u8  = lctx.op_width_of(ctx, inst.ty);
    val w:         u8  = lctx.clamp_alu_width(ctx.tgt.model.alu_min_width, natural_w);
    val bits:      i64 = w::i64 * 8;

    val dividend_r: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[0]);
    if (sel dividend_r.err) { ret err[fail.Fail].err{dividend_r.err}; }
    val nvr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel nvr.err) { ret err[fail.Fail].err{nvr.err}; }
    val ne: err[fail.Fail] = emit_promote(ctx, mb, mir.op_vreg(nvr.ok), dividend_r.ok, w, natural_w, signed);
    if (sel ne.err) { ret ne; }
    val n: mir.MirOperand = mir.op_vreg(nvr.ok);

    var out: mir.MirOperand = n;
    if (!signed) {
        var r: res[mir.MirOperand, fail.Fail];
        if (is_rem)    { r = div_temp(ctx, mb, mir.MIR_AND, n, mir.op_imm(((1::u64 << k::u64) - 1)::i64), w); }
        or             { r = div_temp(ctx, mb, mir.MIR_SHR_U, n, mir.op_imm(k::i64), w); }
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        out = r.ok;
    }
    or {
        val rs: res[mir.MirOperand, fail.Fail] = div_temp(ctx, mb, mir.MIR_SHR_S, n, mir.op_imm(bits - 1), w);
        if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
        val rb: res[mir.MirOperand, fail.Fail] = div_temp(ctx, mb, mir.MIR_SHR_U, rs.ok, mir.op_imm(bits - k::i64), w);
        if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
        val ra: res[mir.MirOperand, fail.Fail] = div_temp(ctx, mb, mir.MIR_ADD, n, rb.ok, w);
        if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
        if (is_rem) {
            val rm: res[mir.MirOperand, fail.Fail] = div_temp(ctx, mb, mir.MIR_AND, ra.ok, mir.op_imm((0 - (1::i64 << k::i64))), w);
            if (sel rm.err) { ret err[fail.Fail].err{rm.err}; }
            val rr: res[mir.MirOperand, fail.Fail] = div_temp(ctx, mb, mir.MIR_SUB, n, rm.ok, w);
            if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
            out = rr.ok;
        }
        or {
            val rq: res[mir.MirOperand, fail.Fail] = div_temp(ctx, mb, mir.MIR_SHR_S, ra.ok, mir.op_imm(k::i64), w);
            if (sel rq.err) { ret err[fail.Fail].err{rq.err}; }
            out = rq.ok;
        }
    }
    ret lctx.emit_mov_w(ctx, mb, mir.op_vreg(dst), out, natural_w);
}

fun lower_div(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction, iid: id.InstructionId) err[fail.Fail] {
    if (inst.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: division missing dividend or divisor operand")};
    }
    val dst: mir.VRegId = lctx.instr_vreg(ctx, iid);
    if (mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: division defines no result vreg")};
    }
    val kp: opt[u32] = pow2_exponent(inst.operands[1], lctx.op_width_of(ctx, inst.ty)::u32 * 8);
    if (sel kp.some) { ret lower_div_pow2(ctx, mb, inst, dst, kp.some); }
    val acc_reg: i32 = ctx.tgt.model.div_reg;
    val hi_reg:  i32 = ctx.tgt.model.div_hi_reg;
    if (acc_reg < 0 || hi_reg < 0) {
        ret lower_div_three_address(ctx, mb, inst, iid, dst);
    }
    val signed: bool = inst.kind == instr.OP_DIV_S || inst.kind == instr.OP_REM_S;

    val natural_w: u8 = lctx.op_width_of(ctx, inst.ty);
    val w:         u8 = lctx.clamp_alu_width(ctx.tgt.model.alu_min_width, natural_w);

    val dividend_r: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[0]);
    if (sel dividend_r.err) { ret err[fail.Fail].err{dividend_r.err}; }
    val dividend:  mir.MirOperand                 = dividend_r.ok;
    val divisor_r: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[1]);
    if (sel divisor_r.err) { ret err[fail.Fail].err{divisor_r.err}; }
    val divisor: mir.MirOperand = divisor_r.ok;

    val mr: err[fail.Fail] = emit_promote(ctx, mb, mir.op_preg(mir.preg_id(acc_reg)), dividend, w, natural_w, signed);
    if (sel mr.err) { ret mr; }

    var div_op: mir.MirOperand = divisor;
    if (natural_w < w || divisor.kind == mir.MIR_OP_IMM) {
        val bvr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
        if (sel bvr.err) { ret err[fail.Fail].err{bvr.err}; }
        val bv: mir.VRegId     = bvr.ok;
        val ex: err[fail.Fail] = emit_promote(ctx, mb, mir.op_vreg(bv), divisor, w, natural_w, signed);
        if (sel ex.err) { ret ex; }
        div_op = mir.op_vreg(bv);
    }

    val rop: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (sel rop.err) { ret err[fail.Fail].err{fail.refused(rop.err)}; }
    val ops: *mir.MirOperand = rop.ok;
    ops[0] = mir.op_preg(mir.preg_id(acc_reg));
    ops[1] = div_op;
    var mi: mir.MirInstr   = mir.instr(inst.kind::u32, ops, 2, w, w);
    val pd: err[fail.Fail] = lctx.push_instr(ctx, mb, mi);
    if (sel pd.err) { ret pd; }

    var res_reg: i32 = acc_reg;
    if (inst.kind == instr.OP_REM_S || inst.kind == instr.OP_REM_U) {
        res_reg = hi_reg;
    }
    ret lctx.emit_mov_w(ctx, mb, mir.op_vreg(dst), mir.op_preg(mir.preg_id(res_reg)), natural_w);
}

fun lower_div_three_address(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction,
    iid: id.InstructionId, dst: mir.VRegId) err[fail.Fail] {
    val signed: bool = inst.kind == instr.OP_DIV_S || inst.kind == instr.OP_REM_S;

    val natural_w: u8 = lctx.op_width_of(ctx, inst.ty);
    val w:         u8 = lctx.clamp_alu_width(ctx.tgt.model.alu_min_width, natural_w);

    val dividend_r: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[0]);
    if (sel dividend_r.err) { ret err[fail.Fail].err{dividend_r.err}; }
    val dividend:  mir.MirOperand                 = dividend_r.ok;
    val divisor_r: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[1]);
    if (sel divisor_r.err) { ret err[fail.Fail].err{divisor_r.err}; }
    val divisor: mir.MirOperand = divisor_r.ok;

    var n_op: mir.MirOperand = dividend;
    if (natural_w < w || dividend.kind == mir.MIR_OP_IMM) {
        val nvr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
        if (sel nvr.err) { ret err[fail.Fail].err{nvr.err}; }
        val nv: mir.VRegId     = nvr.ok;
        val ne: err[fail.Fail] = emit_promote(ctx, mb, mir.op_vreg(nv), dividend, w, natural_w, signed);
        if (sel ne.err) { ret ne; }
        n_op = mir.op_vreg(nv);
    }

    var m_op: mir.MirOperand = divisor;
    if (natural_w < w || divisor.kind == mir.MIR_OP_IMM) {
        val mvr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
        if (sel mvr.err) { ret err[fail.Fail].err{mvr.err}; }
        val mv: mir.VRegId     = mvr.ok;
        val me: err[fail.Fail] = emit_promote(ctx, mb, mir.op_vreg(mv), divisor, w, natural_w, signed);
        if (sel me.err) { ret me; }
        m_op = mir.op_vreg(mv);
    }

    val rop: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 3::usize);
    if (sel rop.err) { ret err[fail.Fail].err{fail.refused(rop.err)}; }
    val ops: *mir.MirOperand = rop.ok;
    ops[0] = mir.op_vreg(dst);
    ops[1] = n_op;
    ops[2] = m_op;
    var mi: mir.MirInstr = mir.instr(inst.kind::u32, ops, 3, w, w);
    ret lctx.push_instr(ctx, mb, mi);
}

fun narrow_imm_value(imm: i64, width: u8, signed: bool) i64 {
    if (width == 0 || width >= 8) { ret imm; }
    val bits: u32 = width::u32 * 8;
    val m:    u64 = (1::u64 << bits) - 1;
    val v:    u64 = imm::u64 & m;
    if (!signed) { ret v::i64; }
    val sign: u64 = 1::u64 << (bits - 1);
    if ((v & sign) == 0) { ret v::i64; }
    ret (v | ~m)::i64;
}

# the 128-bit immediate an immediate of `width` bytes extends to: a zero
# extension of the full 64-bit limb has no sign to fill (#3511)
fun promote_imm(imm: i64, width: u8, signed: bool) mir.MirOperand {
    val v: i64 = narrow_imm_value(imm, width, signed);
    if (!signed && (width == 0 || width >= 8)) { ret mir.op_imm_wide(v, 0); }
    ret mir.op_imm(v);
}

fun emit_promote(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, dst: mir.MirOperand, src: mir.MirOperand,
    dst_w: u8, src_w: u8, signed: bool) err[fail.Fail] {
    if (src_w >= dst_w) {
        ret lctx.emit_mov_w(ctx, mb, dst, src, dst_w);
    }
    if (src.kind == mir.MIR_OP_IMM) {
        ret lctx.emit_mov_w(ctx, mb, dst, promote_imm(src.imm, src_w, signed), dst_w);
    }
    val r: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *mir.MirOperand = r.ok;
    ops[0] = dst;
    ops[1] = src;
    var mi: mir.MirInstr = mir.instr(mir.MIR_ZEXT, ops, 2, dst_w, src_w);
    if (signed) { mi.opcode = mir.MIR_SEXT; }
    ret lctx.push_instr(ctx, mb, mi);
}

fun lower_generic(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction, iid: id.InstructionId) err[fail.Fail] {
    val dst:     mir.VRegId = lctx.instr_vreg(ctx, iid);
    val has_dst: bool       = !mir.vreg_is_nil(dst);
    var kind:    u32        = inst.kind::u32;
    var first:   u32        = 0;
    # `0 - x` is the target's negate, with no zero to materialize
    if (is_zero_minuend(ctx, inst)) {
        kind  = mir.MIR_NEG::u32;
        first = 1;
    }
    # the high-half multiplies are the one generic pair whose MIR opcode is
    # not their IR kind: MIR claimed them before the IR did (#3511)
    if (inst.kind == instr.OP_MUL_HIGH_S) { kind = mir.MIR_MUL_HI_S::u32; }
    if (inst.kind == instr.OP_MUL_HIGH_U) { kind = mir.MIR_MUL_HI_U::u32; }
    var total: u32 = inst.operand_count - first;
    if (has_dst) { total = total + 1; }

    var ops: *mir.MirOperand = nil;
    if (total > 0) {
        val rop: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, total::usize);
        if (sel rop.err) { ret err[fail.Fail].err{fail.refused(rop.err)}; }
        ops = rop.ok;
    }

    var base: u32 = 0;
    if (has_dst) {
        ops[0] = mir.op_vreg(dst);
        base   = 1;
    }

    var k: u32 = first;
    for (k < inst.operand_count) {
        val op_r: res[mir.MirOperand, fail.Fail] = lctx.lower_operand(ctx, inst, k);
        if (sel op_r.err) { ret err[fail.Fail].err{op_r.err}; }
        var op: mir.MirOperand = op_r.ok;
        if (op.kind == mir.MIR_OP_SYM) {
            var av: mir.VRegId     = mir.MIR_VREG_NIL;
            val ar: err[fail.Fail] = lctx.addr_to_vreg(ctx, mb, op, ?av);
            if (sel ar.err) { ret ar; }
            op = mir.op_vreg(av);
        }
        if (op.kind == mir.MIR_OP_IMM && mir.operand_requires_reg(kind, base + k - first)) {
            val cvr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
            if (sel cvr.err) { ret err[fail.Fail].err{cvr.err}; }
            val cv: mir.VRegId     = cvr.ok;
            val cw: u8             = lctx.op_width_of(ctx, inst.operands[k].ty);
            val ce: err[fail.Fail] = lctx.emit_mov_w(ctx, mb, mir.op_vreg(cv), op, cw);
            if (sel ce.err) { ret ce; }
            op = mir.op_vreg(cv);
        }
        ops[base + k - first] = op;
        k                     = k + 1;
    }

    var mi: mir.MirInstr = mir.instr(kind, ops, total, 0, 0);
    set_generic_widths(ctx, inst, ?mi);
    ret lctx.push_instr(ctx, mb, mi);
}

# a scalar integer subtraction from the constant zero; a float's `0.0 - x` is
# not `-x` when x is +0.0
fun is_zero_minuend(ctx: *lctx.LowerCtx, inst: *instr.Instruction) bool {
    if (inst.kind != instr.OP_SUB || inst.operand_count != 2) { ret false; }
    val minuend: value.Value = inst.operands[0];
    if (minuend.kind != value.VAL_CONST_INT || !wide.is_zero(value.int_of(?minuend))) { ret false; }
    if (lctx.value_is_float(ctx, inst.ty))                                            { ret false; }
    ret !instr_touches_vector(ctx, inst);
}

fun set_generic_widths(ctx: *lctx.LowerCtx, inst: *instr.Instruction, mi: *mir.MirInstr) {
    if (is_float_kind(ctx, inst)) {
        set_conv_widths(ctx, inst, mi);
        ret;
    }
    if (is_compare_kind(inst.kind) && inst.operand_count >= 1) {
        val w: u8 = lctx.op_width_of(ctx, inst.operands[0].ty);
        mi.width     = w;
        mi.src_width = w;
        ret;
    }
    var dw: u8 = ctx.tgt.model.gpr_width::u8;
    if (!opdesc.is_terminator(inst.kind)) { dw = lctx.op_width_of(ctx, inst.ty); }
    if (is_int_alu_kind(inst.kind))       { dw = lctx.clamp_alu_width(ctx.tgt.model.alu_min_width, dw); }
    var sw: u8 = dw;
    if (is_int_conversion_kind(inst.kind) && inst.operand_count >= 1) {
        sw = lctx.op_width_of(ctx, inst.operands[0].ty);
    }
    # a widening multiply's source width is its operand's, half its result; a
    # lane-halving extension reads its operand the same way
    if ((inst.kind == instr.OP_MUL_WIDE_S || inst.kind == instr.OP_MUL_WIDE_U
        || inst.kind == instr.OP_VEC_WIDEN_S || inst.kind == instr.OP_VEC_WIDEN_U) && inst.operand_count >= 1) {
        sw = lctx.op_width_of(ctx, inst.operands[0].ty);
    }
    mi.width     = dw;
    mi.src_width = sw;
}

fun set_conv_widths(ctx: *lctx.LowerCtx, inst: *instr.Instruction, mi: *mir.MirInstr) {
    var dw: u8 = lctx.op_width_of(ctx, inst.ty);
    var sw: u8 = dw;
    if (inst.operand_count >= 1) { sw = lctx.op_width_of(ctx, inst.operands[0].ty); }
    mi.width     = dw;
    mi.src_width = sw;
}

fun is_int_alu_kind(k: instr.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_INT_ALU);
}

fun is_compare_kind(k: instr.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_COMPARE);
}

fun is_vector_compute(k: instr.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_VEC_COMPUTE);
}

fun is_int_conversion_kind(k: instr.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_INT_CONVERSION);
}

fun is_float_op(ctx: *lctx.LowerCtx, inst: *instr.Instruction) bool {
    val k:      instr.InstrKind = inst.kind;
    var shared: bool            = false;
    if (k == instr.OP_ADD || k == instr.OP_SUB || k == instr.OP_MUL ||
        k == instr.OP_DIV_S || k == instr.OP_DIV_U) { shared = true; }
    if (is_compare_kind(k))                                                       { shared = true; }
    if (!shared)                                                                  { ret false; }
    if (lctx.value_is_float(ctx, inst.ty))                                        { ret true; }
    if (inst.operand_count >= 1 && lctx.value_is_float(ctx, inst.operands[0].ty)) { ret true; }
    ret false;
}

fun float_op_width(ctx: *lctx.LowerCtx, inst: *instr.Instruction) u8 {
    if (is_compare_kind(inst.kind) && inst.operand_count >= 1) {
        ret lctx.op_width_of(ctx, inst.operands[0].ty);
    }
    ret lctx.op_width_of(ctx, inst.ty);
}

# an opcode a lowering dispatch reaches that no arm names: a defect, reported
# through the catalog policy in the lowering context's interner
fun unknown_kind(ctx: *lctx.LowerCtx, k: instr.InstrKind, where: str) err[fail.Fail] {
    ret err[fail.Fail].err{fail.message(fail.catalog_message_or(ctx.interner, ctx.alloc,
        fail.unknown_member_in("InstrKind", k::u32, where), "unknown InstrKind tag in the float lowering"))};
}

# the float condition code of a compare opcode; absent for an opcode outside
# the compare set, which the caller reports as an unknown member
fun float_cmp_cc(k: instr.InstrKind) opt[u8] {
    if (k == instr.OP_CMP_EQ)                             { ret opt[u8].some{mir.FCC_EQ}; }
    if (k == instr.OP_CMP_NE)                             { ret opt[u8].some{mir.FCC_NE}; }
    if (k == instr.OP_CMP_LT_S || k == instr.OP_CMP_LT_U) { ret opt[u8].some{mir.FCC_LT}; }
    if (k == instr.OP_CMP_LE_S || k == instr.OP_CMP_LE_U) { ret opt[u8].some{mir.FCC_LE}; }
    ret opt[u8].none{};
}

fun lower_float_op(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction, iid: id.InstructionId) err[fail.Fail] {
    if (inst.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: float op missing operand")};
    }
    val dst: mir.VRegId = lctx.instr_vreg(ctx, iid);
    if (mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: float op defines no result vreg")};
    }

    val rop: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 3::usize);
    if (sel rop.err) { ret err[fail.Fail].err{fail.refused(rop.err)}; }
    val ops: *mir.MirOperand = rop.ok;
    ops[0] = mir.op_vreg(dst);
    val lowered_4: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[0]);
    if (sel lowered_4.err) { ret err[fail.Fail].err{lowered_4.err}; }
    ops[1] = lowered_4.ok;
    val lowered_5: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[1]);
    if (sel lowered_5.err) { ret err[fail.Fail].err{lowered_5.err}; }
    ops[2] = lowered_5.ok;

    val w: u8 = float_op_width(ctx, inst);

    val k:  instr.InstrKind = inst.kind;
    var op: mir.MirOpcode   = mir.MIR_FDIV;
    var sw: u8              = w;
    if (is_compare_kind(k)) {
        val cc: opt[u8] = float_cmp_cc(k);
        if (sel cc.none) { ret unknown_kind(ctx, k, "the float lowering"); }
        op = mir.MIR_FCMP;
        sw = cc.some;
    }
    or (k == instr.OP_ADD) {
        op = mir.MIR_FADD;
    }
    or (k == instr.OP_SUB) {
        op = mir.MIR_FSUB;
    }
    or (k == instr.OP_MUL) {
        op = mir.MIR_FMUL;
    }
    or (k == instr.OP_DIV_S || k == instr.OP_DIV_U) {
        op = mir.MIR_FDIV;
    }
    or {
        ret unknown_kind(ctx, k, "the float lowering");
    }

    var mi: mir.MirInstr = mir.instr(op, ops, 3, w, sw);
    ret lctx.push_instr(ctx, mb, mi);
}

fun bitcast_needs_frame(ctx: *lctx.LowerCtx, inst: *instr.Instruction) bool {
    if (inst.operand_count < 1) { ret false; }

    val dst_float: bool = lctx.value_is_float(ctx, inst.ty);
    val src_float: bool = lctx.value_is_float(ctx, inst.operands[0].ty);
    if (dst_float == src_float) { ret false; }

    if (lctx.value_is_vector(ctx, inst.ty))             { ret false; }
    if (lctx.value_is_vector(ctx, inst.operands[0].ty)) { ret false; }

    val w: u8 = lctx.op_width_of(ctx, inst.ty);
    if (w == 0) { ret false; }
    ret !isa.moves_cross_bank(?ctx.tgt.model, w::u32);
}

fun lower_bitcast_via_frame(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction, iid: id.InstructionId) err[fail.Fail] {
    val dst: mir.VRegId = lctx.instr_vreg(ctx, iid);
    if (mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: cross-bank reinterpret defines no result vreg")};
    }
    val w: u8 = lctx.op_width_of(ctx, inst.ty);

    val skr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel skr.err) { ret err[fail.Fail].err{skr.err}; }
    val sk: mir.VRegId = skr.ok;

    val ar: err[fail.Fail] = lctx.add_spill_slot_aligned(ctx, sk.n, w::u64, w::u32);
    if (sel ar.err) { ret ar; }

    val sr: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (sel sr.err) { ret err[fail.Fail].err{fail.refused(sr.err)}; }
    val sops: *mir.MirOperand = sr.ok;
    sops[0] = mir.op_mem_slot(sk, 0);
    val lowered_6: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[0]);
    if (sel lowered_6.err) { ret err[fail.Fail].err{lowered_6.err}; }
    sops[1] = lowered_6.ok;
    var si:  mir.MirInstr   = mir.instr(mir.MIR_MOV, sops, 2, w, w);
    val spr: err[fail.Fail] = lctx.push_instr(ctx, mb, si);
    if (sel spr.err) { ret spr; }

    val lr: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (sel lr.err) { ret err[fail.Fail].err{fail.refused(lr.err)}; }
    val lops: *mir.MirOperand = lr.ok;
    lops[0] = mir.op_vreg(dst);
    lops[1] = mir.op_mem_slot(sk, 0);
    var li: mir.MirInstr = mir.instr(mir.MIR_MOV, lops, 2, w, w);
    ret lctx.push_instr(ctx, mb, li);
}

fun lower_float_neg(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction, iid: id.InstructionId) err[fail.Fail] {
    if (inst.operand_count < 1) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: float negate missing operand")};
    }
    val dst: mir.VRegId = lctx.instr_vreg(ctx, iid);
    if (mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: float negate defines no result vreg")};
    }

    val rop: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (sel rop.err) { ret err[fail.Fail].err{fail.refused(rop.err)}; }
    val ops: *mir.MirOperand = rop.ok;
    ops[0] = mir.op_vreg(dst);
    val lowered_7: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[0]);
    if (sel lowered_7.err) { ret err[fail.Fail].err{lowered_7.err}; }
    ops[1] = lowered_7.ok;

    val w: u8 = lctx.op_width_of(ctx, inst.ty);

    var mi: mir.MirInstr = mir.instr(mir.MIR_FNEG, ops, 2, w, w);
    ret lctx.push_instr(ctx, mb, mi);
}

fun is_float_kind(ctx: *lctx.LowerCtx, inst: *instr.Instruction) bool {
    if (opdesc.has(inst.kind, opdesc.EFF_FP_CONVERT))                             { ret true; }
    if (lctx.value_is_float(ctx, inst.ty))                                        { ret true; }
    if (inst.operand_count >= 1 && lctx.value_is_float(ctx, inst.operands[0].ty)) { ret true; }
    ret false;
}

fun lower_alloca(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction, iid: id.InstructionId) err[fail.Fail] {
    if (inst.operand_count == 0) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: alloca with no count operand")};
    }
    val cv: value.Value = inst.operands[0];
    if (cv.kind != value.VAL_CONST_INT) {
        ret err[fail.Fail].err{lctx.reject(ctx, "variable-length alloca is not supported; use a constant size")};
    }
    val count: u64 = cv.data.int_lit;

    val elem_size:  u32 = ir_type.byte_size_for_machine(ctx.types, inst.aux_ty, ctx.layout);
    val elem_align: u32 = ir_type.byte_align_for_machine(ctx.types, inst.aux_ty, ctx.layout);
    val total:      u64 = elem_size::u64 * count;

    val dst: mir.VRegId = lctx.instr_vreg(ctx, iid);
    if (mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: alloca defines no result vreg")};
    }

    val skr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel skr.err) { ret err[fail.Fail].err{skr.err}; }
    val sk: mir.VRegId = skr.ok;

    val ar: err[fail.Fail] = lctx.add_alloca_slot(ctx, sk.n, total, elem_align, inst.aux_ty::u32);
    if (sel ar.err) { ret ar; }
    lctx.set_slot_origin(ctx, sk.n, iid::u32);

    if (ctx.slot_key_vregs != nil && iid::u32 < ctx.instr_count) {
        ctx.slot_key_vregs[iid::u32] = sk;
    }

    val r: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *mir.MirOperand = r.ok;
    ops[0] = mir.op_vreg(dst);
    ops[1] = mir.op_mem_slot(sk, 0);
    var mi: mir.MirInstr = mir.instr(mir.MIR_ALLOCA, ops, 2,
        ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
    ret lctx.push_instr(ctx, mb, mi);
}

fun lower_vec_extract(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction, iid: id.InstructionId) err[fail.Fail] {
    val dst: mir.VRegId = lctx.instr_vreg(ctx, iid);
    if (mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: vector lane read defines no result vreg")};
    }
    if (inst.operands[1].kind != value.VAL_CONST_INT) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: vector lane index is not a constant")};
    }

    val r: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 3::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *mir.MirOperand = r.ok;
    ops[0] = mir.op_vreg(dst);
    val lowered_8: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[0]);
    if (sel lowered_8.err) { ret err[fail.Fail].err{lowered_8.err}; }
    ops[1] = lowered_8.ok;
    ops[2] = mir.op_imm(inst.operands[1].data.int_lit::i64);

    var mi: mir.MirInstr = mir.instr(mir.MIR_VEC_EXTRACT, ops, 3, lctx.op_width_of(ctx, inst.ty), lctx.op_width_of(ctx, inst.operands[0].ty));
    ret lctx.push_instr(ctx, mb, mi);
}

fun lower_vec_insert(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction, iid: id.InstructionId) err[fail.Fail] {
    val dst: mir.VRegId = lctx.instr_vreg(ctx, iid);
    if (mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: vector lane write defines no result vreg")};
    }
    if (inst.operands[1].kind != value.VAL_CONST_INT) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: vector lane index is not a constant")};
    }

    val r: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 4::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *mir.MirOperand = r.ok;
    ops[0] = mir.op_vreg(dst);
    val lowered_9: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[0]);
    if (sel lowered_9.err) { ret err[fail.Fail].err{lowered_9.err}; }
    ops[1] = lowered_9.ok;
    ops[2] = mir.op_imm(inst.operands[1].data.int_lit::i64);
    val lowered_10: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[2]);
    if (sel lowered_10.err) { ret err[fail.Fail].err{lowered_10.err}; }
    ops[3] = lowered_10.ok;

    var mi: mir.MirInstr = mir.instr(mir.MIR_VEC_INSERT, ops, 4, lctx.op_width_of(ctx, inst.ty), lctx.op_width_of(ctx, inst.operands[2].ty));
    ret lctx.push_instr(ctx, mb, mi);
}

fun lower_vec_build(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction, iid: id.InstructionId) err[fail.Fail] {
    val dst: mir.VRegId = lctx.instr_vreg(ctx, iid);
    if (mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: vector build defines no result vreg")};
    }
    if (inst.operand_count == 0) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: vector build with no lanes")};
    }

    val n: u32                           = inst.operand_count + 1;
    val r: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, n::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *mir.MirOperand = r.ok;
    ops[0] = mir.op_vreg(dst);
    var i: u32 = 0;
    for (i < inst.operand_count) {
        val lowered_11: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[i]);
        if (sel lowered_11.err) { ret err[fail.Fail].err{lowered_11.err}; }
        ops[1 + i] = lowered_11.ok;
        i          = i + 1;
    }

    var mi: mir.MirInstr = mir.instr(mir.MIR_VEC_BUILD, ops, n, lctx.op_width_of(ctx, inst.ty), 0);
    ret lctx.push_instr(ctx, mb, mi);
}

fun lower_load(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction, iid: id.InstructionId) err[fail.Fail] {
    if (inst.operand_count == 0) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: load with no pointer operand")};
    }
    val dst: mir.VRegId = lctx.instr_vreg(ctx, iid);
    if (mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: load defines no result vreg")};
    }
    val mem_r: res[mir.MirOperand, fail.Fail] = lctx.mem_operand_of(ctx, inst.operands[0]);
    if (sel mem_r.err) { ret err[fail.Fail].err{mem_r.err}; }
    var mem: mir.MirOperand = mem_r.ok;
    if (ctx.tgt.model.flat_addressing && mem.kind == mir.MIR_OP_SYM && lctx.value_is_float(ctx, inst.ty)) {
        var base: mir.VRegId     = mir.MIR_VREG_NIL;
        val ar:   err[fail.Fail] = lctx.addr_to_vreg(ctx, mb, mem, ?base);
        if (sel ar.err) { ret ar; }
        mem = mir.op_mem_value(base, 0);
    }
    val r: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *mir.MirOperand = r.ok;
    ops[0] = mir.op_vreg(dst);
    ops[1] = mem;
    val acc_w: u8 = lctx.mem_width_of(ctx, inst.ty);
    val reg_w: u8 = lctx.op_width_of(ctx, inst.ty);
    if (lctx.subwidth_vector_memory(ctx, inst.ty)) {
        ret lctx.load_subwidth_vector(ctx, mb, ops[0], ops[1], inst.ty);
    }
    var mi: mir.MirInstr = mir.instr(mir.MIR_LOAD, ops, 2,
        lctx.clamp_alu_width(ctx.tgt.model.alu_min_width, reg_w), acc_w);
    ret lctx.push_instr(ctx, mb, mi);
}

fun lower_store(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction) err[fail.Fail] {
    if (inst.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: store missing value or pointer operand")};
    }
    if (lctx.value_is_aggregate(ctx, inst.operands[0].ty)) {
        ret lower_store_aggregate(ctx, mb, inst);
    }
    val stored_r: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[0]);
    if (sel stored_r.err) { ret err[fail.Fail].err{stored_r.err}; }
    var stored: mir.MirOperand = stored_r.ok;
    if (stored.kind == mir.MIR_OP_SYM) {
        var addr: mir.VRegId     = mir.MIR_VREG_NIL;
        val ar:   err[fail.Fail] = lctx.addr_to_vreg(ctx, mb, stored, ?addr);
        if (sel ar.err) { ret ar; }
        stored = mir.op_vreg(addr);
    }
    val dest_r: res[mir.MirOperand, fail.Fail] = lctx.mem_operand_of(ctx, inst.operands[1]);
    if (sel dest_r.err) { ret err[fail.Fail].err{dest_r.err}; }
    var dest: mir.MirOperand = dest_r.ok;
    if (ctx.tgt.model.flat_addressing && dest.kind == mir.MIR_OP_SYM && lctx.value_is_float(ctx, inst.operands[0].ty)) {
        var dbase: mir.VRegId     = mir.MIR_VREG_NIL;
        val dr:    err[fail.Fail] = lctx.addr_to_vreg(ctx, mb, dest, ?dbase);
        if (sel dr.err) { ret dr; }
        dest = mir.op_mem_value(dbase, 0);
    }
    val r: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *mir.MirOperand = r.ok;
    ops[0] = dest;
    ops[1] = stored;
    val st_w:  u8 = lctx.mem_width_of(ctx, inst.operands[0].ty);
    val src_w: u8 = lctx.op_width_of(ctx, inst.operands[0].ty);
    if (lctx.subwidth_vector_memory(ctx, inst.operands[0].ty)) {
        ret lctx.store_subwidth_vector(ctx, mb, ops[0], ops[1], inst.operands[0].ty);
    }
    var mi: mir.MirInstr = mir.instr(mir.MIR_STORE, ops, 2, st_w, src_w);
    ret lctx.push_instr(ctx, mb, mi);
}

fun lower_store_aggregate(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction) err[fail.Fail] {
    val size:   u32                            = ir_type.byte_size_for_machine(ctx.types, inst.operands[0].ty, ctx.layout);
    val dest_r: res[mir.MirOperand, fail.Fail] = agg_pointer_mem(ctx, inst.operands[1], 0);
    if (sel dest_r.err) { ret err[fail.Fail].err{dest_r.err}; }
    val src_r: res[mir.MirOperand, fail.Fail] = agg_pointer_mem(ctx, inst.operands[0], 0);
    if (sel src_r.err) { ret err[fail.Fail].err{src_r.err}; }
    ret lctx.copy_aggregate(ctx, mb, dest_r.ok, src_r.ok, size::u64);
}

fun lower_memzero(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction) err[fail.Fail] {
    if (inst.operand_count < 1) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: memzero missing destination pointer operand")};
    }
    if (inst.aux_ty == ir_type.IRT_NIL) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: memzero is missing its pointee type")};
    }
    val size: u32 = ir_type.byte_size_for_machine(ctx.types, inst.aux_ty, ctx.layout);

    val r: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops:        *mir.MirOperand                = r.ok;
    val lowered_12: res[mir.MirOperand, fail.Fail] = agg_pointer_mem(ctx, inst.operands[0], 0);
    if (sel lowered_12.err) { ret err[fail.Fail].err{lowered_12.err}; }
    ops[0] = lowered_12.ok;
    ops[1] = mir.op_imm(size::i64);
    var mi: mir.MirInstr = mir.instr(mir.MIR_MEMZERO, ops, 2,
        ctx.tgt.model.pointer_width::u8, ctx.tgt.model.pointer_width::u8);
    ret lctx.push_instr(ctx, mb, mi);
}

fun agg_pointer_mem(ctx: *lctx.LowerCtx, v: value.Value, disp: i64) res[mir.MirOperand, fail.Fail] {
    val op_r: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, v);
    if (sel op_r.err) { ret op_r; }
    val op: mir.MirOperand = op_r.ok;
    if (op.kind == mir.MIR_OP_VREG) { ret res[mir.MirOperand, fail.Fail].ok{mir.op_mem_value(op.vreg, disp)}; }
    if (op.kind == mir.MIR_OP_SYM) {
        var so: mir.MirOperand = mir.op_sym(op.sym, op.sym_off + disp::i32);
        so.sym_got = op.sym_got;
        ret res[mir.MirOperand, fail.Fail].ok{so};
    }
    ret res[mir.MirOperand, fail.Fail].ok{op};
}

# the memory operand of an element address that needs no instruction of its
# own: a register, frame or symbol base, constant indices folded into the
# displacement, and at most one runtime index whose stride the addressing
# mode scales, on a register base. blocks are lowered in index order and the
# address may be defined after its uses, so a folded address is computed
# from the IR alone, never from lowered state
pub fun pure_gep_mem(ctx: *lctx.LowerCtx, inst: *instr.Instruction) opt[mir.MirOperand] {
    if (inst.operand_count < 2 || inst.aux_ty == ir_type.IRT_NIL) { ret opt[mir.MirOperand].none{}; }
    val base_r: res[mir.MirOperand, fail.Fail] = lctx.mem_operand_of_plain(ctx, inst.operands[0]);
    if (sel base_r.err) { ret opt[mir.MirOperand].none{}; }
    val base: mir.MirOperand = base_r.ok;
    if (base.kind != mir.MIR_OP_MEM && base.kind != mir.MIR_OP_SYM) { ret opt[mir.MirOperand].none{}; }

    var disp:      i64              = 0;
    var idx_vreg:  mir.VRegId       = mir.MIR_VREG_NIL;
    var idx_scale: u8               = 0;
    var cur_ty:    ir_type.IrTypeId = inst.aux_ty;
    var k:         u32              = 1;
    for (k < inst.operand_count) {
        val v:         value.Value = inst.operands[k];
        var stride:    u64         = 0;
        var is_struct: bool        = false;
        if (k == 1) {
            stride = ir_type.byte_size_for_machine(ctx.types, cur_ty, ctx.layout)::u64;
        }
        or {
            val ct_opt: opt[*ir_type.IrType] = ir_type.get(ctx.types, cur_ty);
            if (!sel ct_opt.some) { ret opt[mir.MirOperand].none{}; }
            val ct: *ir_type.IrType = ct_opt.some;
            if (ct.kind == ir_type.IRT_ARRAY) {
                stride = ir_type.byte_size_for_machine(ctx.types, ct.data.array_.element, ctx.layout)::u64;
                cur_ty = ct.data.array_.element;
            }
            or (ct.kind == ir_type.IRT_VECTOR) {
                stride = ir_type.byte_size_for_machine(ctx.types, ct.data.vector_.element, ctx.layout)::u64;
                cur_ty = ct.data.vector_.element;
            }
            or (ct.kind == ir_type.IRT_STRUCT || ct.kind == ir_type.IRT_UNION || ct.kind == ir_type.IRT_TAG) {
                is_struct = true;
            }
            or {
                ret opt[mir.MirOperand].none{};
            }
        }
        if (is_struct) {
            if (v.kind != value.VAL_CONST_INT) { ret opt[mir.MirOperand].none{}; }
            val fo: res[i64, fail.Fail] = struct_field_offset(ctx, cur_ty, v.data.int_lit::u32);
            if (sel fo.err) { ret opt[mir.MirOperand].none{}; }
            disp = disp + fo.ok;
            val ft: res[ir_type.IrTypeId, fail.Fail] = struct_field_type(ctx, cur_ty, v.data.int_lit::u32);
            if (sel ft.err) { ret opt[mir.MirOperand].none{}; }
            cur_ty = ft.ok;
        }
        or (v.kind == value.VAL_CONST_INT) {
            disp = disp + (v.data.int_lit * stride)::i64;
        }
        or {
            if (!mir.vreg_is_nil(idx_vreg) || !is_sib_scale(stride) || base.kind != mir.MIR_OP_MEM) { ret opt[mir.MirOperand].none{}; }
            if (v.kind != value.VAL_INSTR && v.kind != value.VAL_PARAM)                             { ret opt[mir.MirOperand].none{}; }
            val iv: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, v);
            if (sel iv.err)                    { ret opt[mir.MirOperand].none{}; }
            if (iv.ok.kind != mir.MIR_OP_VREG) { ret opt[mir.MirOperand].none{}; }
            idx_vreg  = iv.ok.vreg;
            idx_scale = stride::u8;
        }
        k = k + 1;
    }

    var o: mir.MirOperand = base;
    if (base.kind == mir.MIR_OP_SYM) {
        o.sym_off = base.sym_off + disp::i32;
        ret opt[mir.MirOperand].some{o};
    }
    o.imm = base.imm + disp;
    if (!mir.vreg_is_nil(idx_vreg)) {
        o.index = mir.index_vreg(idx_vreg);
        o.scale = idx_scale;
    }
    ret opt[mir.MirOperand].some{o};
}

fun lower_gep(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction, iid: id.InstructionId) err[fail.Fail] {
    if (inst.operand_count == 0) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: gep with no base operand")};
    }
    val dst: mir.VRegId = lctx.instr_vreg(ctx, iid);
    if (mir.vreg_is_nil(dst)) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: gep defines no result vreg")};
    }

    val base_r: res[mir.MirOperand, fail.Fail] = lctx.mem_operand_of(ctx, inst.operands[0]);
    if (sel base_r.err) { ret err[fail.Fail].err{base_r.err}; }
    val base: mir.MirOperand = base_r.ok;

    if (inst.operand_count > 1 && inst.aux_ty == ir_type.IRT_NIL) {
        ret err[fail.Fail].err{fail.message("mir.lower_ir: gep with indices is missing its source pointee type")};
    }

    if (!ctx.tgt.model.flat_addressing) {
        ret lower_gep_structural(ctx, mb, inst, dst, base);
    }

    var disp:      i64              = 0;
    var idx_vreg:  mir.VRegId       = mir.MIR_VREG_NIL;
    var idx_scale: u8               = 0;
    var cur_ty:    ir_type.IrTypeId = inst.aux_ty;

    var k: u32 = 1;
    for (k < inst.operand_count) {
        val v:        value.Value = inst.operands[k];
        val is_first: bool        = k == 1;

        var stride:    u64  = 0;
        var is_struct: bool = false;
        if (is_first) {
            stride = ir_type.byte_size_for_machine(ctx.types, cur_ty, ctx.layout)::u64;
        }
        or {
            val ct_opt: opt[*ir_type.IrType] = ir_type.get(ctx.types, cur_ty);
            if (!sel ct_opt.some) {
                ret err[fail.Fail].err{fail.message("mir.lower_ir: gep index walks off a non-aggregate type")};
            }
            val ct: *ir_type.IrType = ct_opt.some;
            if (ct.kind == ir_type.IRT_ARRAY) {
                stride = ir_type.byte_size_for_machine(ctx.types, ct.data.array_.element, ctx.layout)::u64;
                cur_ty = ct.data.array_.element;
            }
            or (ct.kind == ir_type.IRT_VECTOR) {
                stride = ir_type.byte_size_for_machine(ctx.types, ct.data.vector_.element, ctx.layout)::u64;
                cur_ty = ct.data.vector_.element;
            }
            or (ct.kind == ir_type.IRT_STRUCT || ct.kind == ir_type.IRT_UNION || ct.kind == ir_type.IRT_TAG) {
                is_struct = true;
            }
            or {
                ret err[fail.Fail].err{fail.message("mir.lower_ir: gep index into a non-aggregate type")};
            }
        }

        if (is_struct) {
            if (v.kind != value.VAL_CONST_INT) {
                ret err[fail.Fail].err{fail.message("mir.lower_ir: gep struct field index must be constant")};
            }
            val field_ix: u32                 = v.data.int_lit::u32;
            val fo:       res[i64, fail.Fail] = struct_field_offset(ctx, cur_ty, field_ix);
            if (sel fo.err) { ret err[fail.Fail].err{fo.err}; }
            disp = disp + fo.ok;
            val ft: res[ir_type.IrTypeId, fail.Fail] = struct_field_type(ctx, cur_ty, field_ix);
            if (sel ft.err) { ret err[fail.Fail].err{ft.err}; }
            cur_ty = ft.ok;
            k      = k + 1;
            cnt;
        }

        if (v.kind == value.VAL_CONST_INT) {
            disp = disp + (v.data.int_lit * stride)::i64;
            k    = k + 1;
            cnt;
        }

        var new_scale: u8                             = 0;
        val idx_r:     res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, v);
        if (sel idx_r.err) { ret err[fail.Fail].err{idx_r.err}; }
        val idx_n: res[mir.MirOperand, fail.Fail] = index_at_pointer_width(ctx, mb, idx_r.ok, v.ty);
        if (sel idx_n.err) { ret err[fail.Fail].err{idx_n.err}; }
        val ir: res[mir.VRegId, fail.Fail] = fold_runtime_index(ctx, mb, idx_n.ok, stride, idx_vreg, idx_scale, ?new_scale);
        if (sel ir.err) { ret err[fail.Fail].err{ir.err}; }
        idx_vreg  = ir.ok;
        idx_scale = new_scale;
        k         = k + 1;
    }

    val mem: res[mir.MirOperand, fail.Fail] = fold_gep_mem(ctx, mb, base, idx_vreg, idx_scale, disp);
    if (sel mem.err) { ret err[fail.Fail].err{mem.err}; }

    if (lctx.gep_folds(ctx, iid)) { ret err[fail.Fail].ok{}; }

    val r: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *mir.MirOperand = r.ok;
    ops[0] = mir.op_vreg(dst);
    ops[1] = mem.ok;
    var mi: mir.MirInstr = mir.instr(mir.MIR_GEP, ops, 2,
        ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
    ret lctx.push_instr(ctx, mb, mi);
}

fun lower_gep_structural(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, inst: *instr.Instruction,
    dst: mir.VRegId, base: mir.MirOperand) err[fail.Fail] {
    val n: usize                         = (inst.operand_count + 1)::usize;
    val r: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, n);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *mir.MirOperand = r.ok;
    ops[0] = mir.op_vreg(dst);
    ops[1] = base;
    var k: u32 = 1;
    for (k < inst.operand_count) {
        val lowered_13: res[mir.MirOperand, fail.Fail] = lctx.lower_value(ctx, inst.operands[k]);
        if (sel lowered_13.err) { ret err[fail.Fail].err{lowered_13.err}; }
        ops[(k + 1)::usize] = lowered_13.ok;
        k                   = k + 1;
    }
    var mi: mir.MirInstr = mir.instr(mir.MIR_GEP, ops, inst.operand_count + 1,
        ctx.tgt.model.gpr_width::u8, ctx.tgt.model.gpr_width::u8);
    ret lctx.push_instr(ctx, mb, mi);
}

# a flat address is formed at the pointer width, so an index wider than the
# pointer keeps its low bits: the truncation is stated here, and where the
# pointer is wider than the ALU legalize takes the lane it names. an index
# left wide would reach the address as a value nothing defines once its lanes
# replace it (#3615)
fun index_at_pointer_width(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, idxop: mir.MirOperand,
    ty: ir_type.IrTypeId) res[mir.MirOperand, fail.Fail] {
    val iw: u8 = lctx.op_width_of(ctx, ty);
    val pw: u8 = ctx.tgt.model.pointer_width::u8;
    if (iw <= pw || idxop.kind != mir.MIR_OP_VREG) { ret res[mir.MirOperand, fail.Fail].ok{idxop}; }
    val tr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel tr.err) { ret res[mir.MirOperand, fail.Fail].err{tr.err}; }
    val t:  mir.VRegId                    = tr.ok;
    val ar: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (sel ar.err) { ret res[mir.MirOperand, fail.Fail].err{fail.refused(ar.err)}; }
    val ops: *mir.MirOperand = ar.ok;
    ops[0] = mir.op_vreg(t);
    ops[1] = idxop;
    var mi: mir.MirInstr   = mir.instr(mir.MIR_TRUNC, ops, 2, pw, iw);
    val er: err[fail.Fail] = lctx.push_instr(ctx, mb, mi);
    if (sel er.err) { ret res[mir.MirOperand, fail.Fail].err{er.err}; }
    ret res[mir.MirOperand, fail.Fail].ok{mir.op_vreg(t)};
}

fun fold_runtime_index(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, idxop: mir.MirOperand, stride: u64,
    acc: mir.VRegId, acc_scale: u8, scale_out: *u8) res[mir.VRegId, fail.Fail] {
    if (idxop.kind != mir.MIR_OP_VREG) {
        ret res[mir.VRegId, fail.Fail].err{fail.message("mir.lower_ir: gep runtime index is not a register value")};
    }
    val idxv: mir.VRegId = idxop.vreg;

    if (mir.vreg_is_nil(acc) && is_sib_scale(stride)) {
        @scale_out = stride::u8;
        ret res[mir.VRegId, fail.Fail].ok{idxv};
    }

    val tr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel tr.err) { ret res[mir.VRegId, fail.Fail].err{tr.err}; }
    val t:  mir.VRegId     = tr.ok;
    val mr: err[fail.Fail] = lctx.emit_bin(ctx, mb, mir.MIR_MUL, t, mir.op_vreg(idxv), mir.op_imm(stride::i64));
    if (sel mr.err) { ret res[mir.VRegId, fail.Fail].err{mr.err}; }

    if (mir.vreg_is_nil(acc)) {
        @scale_out = 1;
        ret res[mir.VRegId, fail.Fail].ok{t};
    }

    var acc_term: mir.VRegId = acc;
    if (acc_scale > 1) {
        val sr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
        if (sel sr.err) { ret res[mir.VRegId, fail.Fail].err{sr.err}; }
        acc_term = sr.ok;
        val smr: err[fail.Fail] = lctx.emit_bin(ctx, mb, mir.MIR_MUL, acc_term, mir.op_vreg(acc), mir.op_imm(acc_scale::i64));
        if (sel smr.err) { ret res[mir.VRegId, fail.Fail].err{smr.err}; }
    }
    val ar: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
    if (sel ar.err) { ret res[mir.VRegId, fail.Fail].err{ar.err}; }
    val sum: mir.VRegId     = ar.ok;
    val adr: err[fail.Fail] = lctx.emit_bin(ctx, mb, mir.MIR_ADD, sum, mir.op_vreg(acc_term), mir.op_vreg(t));
    if (sel adr.err) { ret res[mir.VRegId, fail.Fail].err{adr.err}; }
    @scale_out = 1;
    ret res[mir.VRegId, fail.Fail].ok{sum};
}

fun is_sib_scale(s: u64) bool {
    ret s == 1 || s == 2 || s == 4 || s == 8;
}

fun fold_gep_mem(ctx: *lctx.LowerCtx, mb: *mir.MirBlock, base: mir.MirOperand, idx_vreg: mir.VRegId, idx_scale: u8, disp: i64) res[mir.MirOperand, fail.Fail] {
    var o: mir.MirOperand = base;
    if (base.kind == mir.MIR_OP_IMM) {
        val vr: res[mir.VRegId, fail.Fail] = lctx.new_vreg(ctx, mir.REG_CLASS_GP);
        if (sel vr.err) { ret res[mir.MirOperand, fail.Fail].err{vr.err}; }
        val vbase: mir.VRegId     = vr.ok;
        val mv:    err[fail.Fail] = lctx.emit_mov(ctx, mb, mir.op_vreg(vbase), mir.op_imm(base.imm));
        if (sel mv.err) { ret res[mir.MirOperand, fail.Fail].err{mv.err}; }
        var m: mir.MirOperand = mir.op_mem_value(vbase, disp);
        if (!mir.vreg_is_nil(idx_vreg)) {
            m.index = mir.index_vreg(idx_vreg);
            m.scale = idx_scale;
        }
        ret res[mir.MirOperand, fail.Fail].ok{m};
    }
    if (base.kind == mir.MIR_OP_MEM) {
        o.imm = base.imm + disp;
        if (!mir.vreg_is_nil(idx_vreg)) {
            o.index = mir.index_vreg(idx_vreg);
            o.scale = idx_scale;
        }
        ret res[mir.MirOperand, fail.Fail].ok{o};
    }
    if (base.kind == mir.MIR_OP_SYM) {
        if (mir.vreg_is_nil(idx_vreg)) {
            o.sym_off = base.sym_off + disp::i32;
            ret res[mir.MirOperand, fail.Fail].ok{o};
        }
        var sbase: mir.VRegId     = mir.MIR_VREG_NIL;
        val ar:    err[fail.Fail] = lctx.addr_to_vreg(ctx, mb, base, ?sbase);
        if (sel ar.err) { ret res[mir.MirOperand, fail.Fail].err{ar.err}; }
        var m: mir.MirOperand = mir.op_mem_value(sbase, disp);
        m.index = mir.index_vreg(idx_vreg);
        m.scale = idx_scale;
        ret res[mir.MirOperand, fail.Fail].ok{m};
    }
    ret res[mir.MirOperand, fail.Fail].err{fail.message("mir.lower_ir: gep base is neither a memory nor a symbol reference")};
}

fun struct_field_offset(ctx: *lctx.LowerCtx, struct_ty: ir_type.IrTypeId, ix: u32) res[i64, fail.Fail] {
    val st_opt: opt[*ir_type.IrType] = ir_type.get(ctx.types, struct_ty);
    if (!sel st_opt.some) {
        ret res[i64, fail.Fail].err{fail.message("mir.lower_ir: gep struct type not found")};
    }
    val st: *ir_type.IrType = st_opt.some;
    if (st.kind == ir_type.IRT_TAG) {
        if (ix >= ir_type.tag_field_count(ctx.types, struct_ty)) {
            ret res[i64, fail.Fail].err{fail.message("mir.lower_ir: gep tag field index out of range")};
        }
        ret res[i64, fail.Fail].ok{ir_type.tag_field_offset_for_machine(ctx.types, struct_ty, ix, ctx.layout)::i64};
    }
    if (st.kind == ir_type.IRT_UNION) {
        if (ix >= st.data.struct_.field_count) {
            ret res[i64, fail.Fail].err{fail.message("mir.lower_ir: gep union member index out of range")};
        }
        ret res[i64, fail.Fail].ok{0::i64};
    }
    if (st.kind != ir_type.IRT_STRUCT) {
        ret res[i64, fail.Fail].err{fail.message("mir.lower_ir: gep struct index into a non-struct type")};
    }
    if (ix >= st.data.struct_.field_count) {
        ret res[i64, fail.Fail].err{fail.message("mir.lower_ir: gep struct field index out of range")};
    }
    ret res[i64, fail.Fail].ok{ir_type.byte_offset_for_machine(ctx.types, struct_ty, ix, ctx.layout)::i64};
}

fun struct_field_type(ctx: *lctx.LowerCtx, struct_ty: ir_type.IrTypeId, ix: u32) res[ir_type.IrTypeId, fail.Fail] {
    val st_opt: opt[*ir_type.IrType] = ir_type.get(ctx.types, struct_ty);
    if (!sel st_opt.some) {
        ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("mir.lower_ir: gep struct type not found")};
    }
    val st: *ir_type.IrType = st_opt.some;
    if (st.kind == ir_type.IRT_TAG) {
        if (ix >= ir_type.tag_field_count(ctx.types, struct_ty)) {
            ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("mir.lower_ir: gep tag field index out of range")};
        }
        ret res[ir_type.IrTypeId, fail.Fail].ok{ir_type.tag_field_type(ctx.types, struct_ty, ix)};
    }
    if ((st.kind != ir_type.IRT_STRUCT && st.kind != ir_type.IRT_UNION) || ix >= st.data.struct_.field_count) {
        ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("mir.lower_ir: gep struct field index out of range")};
    }
    ret res[ir_type.IrTypeId, fail.Fail].ok{st.data.struct_.fields[ix]};
}

fun t_lower_diamond_phi(alloc: *A.Allocator, cover_both: bool, out_err: *str) bool {
    out_err[0] = nil;

    var reg: treg.TargetRegistry = treg.registry_init();
    fin { treg.registry_dnit(?reg); }
    val r_1776: err[fail.Fail] = treg.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1776.err) { ret false; }
    val tr: res[target.Target, fail.Fail] = treg.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret false; }
    var tgt: target.Target = tr.ok;

    var itn:  intern.Interner  = intern.init(alloc);
    var smap: source.SourceMap = source.init(alloc);

    val mr: res[ir.Module, fail.Fail] = ir.init(alloc, intern.STR_NIL);
    if (sel mr.err) { ret false; }
    var m: ir.Module = mr.ok;

    val it: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel it.err) { ret false; }
    val i64ty: ir_type.IrTypeId                 = it.ok;
    val vt:    res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel vt.err) { ret false; }
    val voidty: ir_type.IrTypeId                 = vt.ok;
    val sr:     res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?m.types, voidty, nil, 0, false);
    if (sel sr.err) { ret false; }
    val r_1796: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sr.ok, 0);
    if (sel r_1796.err) { ret false; }

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, ?m.functions[0]);
    var bids: [4]id.BlockId;
    var i:    u32 = 0;
    for (i < 4) {
        val br: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
        if (sel br.err) { ret false; }
        bids[i] = br.ok;
        i       = i + 1;
    }
    val c: value.Value = value.const_int(0, i64ty);

    builder.set_block(?bld, bids[0]);
    val r_1811: err[fail.Fail] = builder.emit_cbr(?bld, value.const_int(1, i64ty), bids[1], bids[2]);
    if (sel r_1811.err) { ret false; }

    builder.set_block(?bld, bids[1]);
    val lv: res[value.Value, fail.Fail] = builder.emit_add(?bld, c, c);
    if (sel lv.err) { ret false; }
    val l:      value.Value    = lv.ok;
    val r_1817: err[fail.Fail] = builder.emit_br(?bld, bids[3]);
    if (sel r_1817.err) { ret false; }

    builder.set_block(?bld, bids[2]);
    val rv: res[value.Value, fail.Fail] = builder.emit_add(?bld, c, c);
    if (sel rv.err) { ret false; }
    val rt:     value.Value    = rv.ok;
    val r_1823: err[fail.Fail] = builder.emit_br(?bld, bids[3]);
    if (sel r_1823.err) { ret false; }

    builder.set_block(?bld, bids[3]);
    val pv: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64ty);
    if (sel pv.err) { ret false; }
    val p:      value.Value    = pv.ok;
    val r_1829: err[fail.Fail] = builder.phi_add_incoming(?bld, p, bids[1], l);
    if (sel r_1829.err) { ret false; }
    if (cover_both) {
        val r_1831: err[fail.Fail] = builder.phi_add_incoming(?bld, p, bids[2], rt);
        if (sel r_1831.err) { ret false; }
    }
    val r_1833: res[value.Value, fail.Fail] = builder.emit_add(?bld, p, c);
    if (sel r_1833.err) { ret false; }
    val r_1834: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_1834.err) { ret false; }

    val lr: res[mir.MirModule, fail.Fail] = lower_module(?tgt, ?m, alloc, ?itn, ?smap, nil);
    if (sel lr.err) {
        out_err[0] = fail.describe(lr.err);
        ret false;
    }
    ret true;
}

test "mach.lang.be.codegen.mir.lower.lower_block_phis:missing_incoming" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var error: str = nil;

    if (!t_lower_diamond_phi(?alloc, true, ?error)) { ret 1; }

    if (t_lower_diamond_phi(?alloc, false, ?error)) { ret 1; }
    if (error == nil)                               { ret 1; }
    if (!str_contains(error, "no incoming value"))  { ret 1; }
    if (!str_contains(error, "block 3"))            { ret 1; }
    if (!str_contains(error, "block 2"))            { ret 1; }
    if (!str_contains(error, "result vreg"))        { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.mir.lower:volatile_memory_flags_follow_each_ir_instruction" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var types:  ir_type.IrTypeTable;
    val r_1865: err[fail.Fail] = ir_type.init(?types, ?alloc);
    if (sel r_1865.err) { ret 1; }
    fin { ir_type.dnit(?types); }
    val tr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 64);
    if (sel tr.err) { ret 1; }
    val ty:  ir_type.IrTypeId = tr.ok;
    var tgt: target.Target;
    tgt.model.flat_addressing = true;
    tgt.model.pointer_width   = 8;
    tgt.model.gpr_width       = 8;
    tgt.model.int_widths      = isa.INT_WIDTHS_1_2_4_8;
    var parameters: [1]mir.VRegId = [1]mir.VRegId{mir.vreg_id(0)};
    var operands:   [1]value.Value;
    operands[0] = value.param(0, ty);
    var instructions: [2]instr.Instruction;
    var i:            u32 = 0;
    for (i < 2) {
        instructions[i].kind          = instr.OP_MEMZERO;
        instructions[i].ty            = ty;
        instructions[i].aux_ty        = ty;
        instructions[i].operands      = ?operands[0];
        instructions[i].operand_count = 1;
        i                             = i + 1;
    }
    instructions[0].flags = instr.INSTR_FLAG_VOLATILE;
    var fn: ir.Function;
    fn.instrs    = ?instructions[0];
    fn.instr_len = 2;
    var ctx: lctx.LowerCtx;
    ctx.alloc       = ?alloc;
    ctx.tgt         = ?tgt;
    ctx.types       = ?types;
    ctx.param_vregs = ?parameters[0];
    ctx.param_count = 1;
    var mb: mir.MirBlock;
    fin { mir.dnit_block(?alloc, ?mb); }
    val lower_instr_r: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 0);
    if (sel lower_instr_r.err) { ret 2; }
    val lower_instr_r2: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 1);
    if (sel lower_instr_r2.err)                                                           { ret 3; }
    if (mb.instr_count != 2)                                                              { ret 4; }
    if (mb.instrs[0].opcode != mir.MIR_MEMZERO || mb.instrs[1].opcode != mir.MIR_MEMZERO) { ret 5; }
    if (mb.instrs[0].memory_flags != mir.MEMORY_VOLATILE)                                 { ret 6; }
    if (mb.instrs[1].memory_flags != 0)                                                   { ret 7; }
    ret 0;
}

# a binding of the value the instruction just lowered defined is published at
# that instruction's end, where the value exists; a binding of an older value
# waits for the next instruction's start (#3688)
test "mach.lang.be.codegen.mir.lower:a_binding_of_the_def_just_lowered_opens_at_its_end" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var types:  ir_type.IrTypeTable;
    val r_init: err[fail.Fail] = ir_type.init(?types, ?alloc);
    if (sel r_init.err) { ret 1; }
    fin { ir_type.dnit(?types); }
    val tr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 64);
    if (sel tr.err) { ret 1; }
    val ty:  ir_type.IrTypeId = tr.ok;
    var tgt: target.Target;
    tgt.model.flat_addressing = true;
    tgt.model.pointer_width   = 8;
    tgt.model.gpr_width       = 8;
    tgt.model.int_widths      = isa.INT_WIDTHS_1_2_4_8;
    var parameters: [2]mir.VRegId = [2]mir.VRegId{mir.vreg_id(0), mir.vreg_id(1)};
    var results:    [4]mir.VRegId = [4]mir.VRegId{mir.vreg_id(2), mir.MIR_VREG_NIL, mir.MIR_VREG_NIL, mir.vreg_id(3)};
    var sum:        [2]value.Value;
    sum[0] = value.param(0, ty);
    sum[1] = value.param(1, ty);
    var of_sum: [1]value.Value;
    of_sum[0] = value.instr(0::id.InstructionId, ty);
    var of_param: [1]value.Value;
    of_param[0] = value.param(0, ty);
    var instructions: [4]instr.Instruction;
    instructions[0].kind          = instr.OP_ADD;
    instructions[0].ty            = ty;
    instructions[0].operands      = ?sum[0];
    instructions[0].operand_count = 2;
    instructions[1].kind          = instr.OP_DBG_VALUE;
    instructions[1].ty            = ty;
    instructions[1].operands      = ?of_sum[0];
    instructions[1].operand_count = 1;
    instructions[2].kind          = instr.OP_DBG_VALUE;
    instructions[2].ty            = ty;
    instructions[2].operands      = ?of_param[0];
    instructions[2].operand_count = 1;
    instructions[3]               = instructions[0];
    var fn: ir.Function;
    fn.instrs    = ?instructions[0];
    fn.instr_len = 4;
    var ctx: lctx.LowerCtx;
    ctx.alloc         = ?alloc;
    ctx.tgt           = ?tgt;
    ctx.types         = ?types;
    ctx.param_vregs   = ?parameters[0];
    ctx.param_count   = 2;
    ctx.instr_vregs   = ?results[0];
    ctx.instr_count   = 4;
    ctx.pending       = nil;
    ctx.pending_count = 0;
    ctx.pending_cap   = 0;
    fin {
        if (ctx.pending != nil) { A.deallocate[mir.MirDbgBinding](?alloc, ctx.pending, ctx.pending_cap::usize); }
    }
    var mb: mir.MirBlock;
    fin { mir.dnit_block(?alloc, ?mb); }
    var k: u32 = 0;
    for (k < 4) {
        val r: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, k);
        if (sel r.err) { ret 2; }
        k = k + 1;
    }
    if (mb.instr_count != 2) { ret 3; }
    val def: *mir.MirInstr = ?mb.instrs[0];
    if (def.dbg_binding_count != 1)                                    { ret 4; }
    if (def.dbg_bindings[0].iid != 1 || def.dbg_bindings[0].vreg != 2) { ret 4; }
    if (!def.dbg_bindings[0].at_end)                                   { ret 5; }
    val next: *mir.MirInstr = ?mb.instrs[1];
    if (next.dbg_binding_count != 1)                                     { ret 6; }
    if (next.dbg_bindings[0].iid != 2 || next.dbg_bindings[0].vreg != 0) { ret 6; }
    if (next.dbg_bindings[0].at_end)                                     { ret 7; }
    ret 0;
}

# the IR high-half multiplies lower to the MIR high multiplies, whose opcodes
# are not the IR kinds (#3511)
test "mach.lang.be.codegen.mir.lower.lower_generic:high_multiply_takes_the_mir_high_opcode" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var types:  ir_type.IrTypeTable;
    val r_init: err[fail.Fail] = ir_type.init(?types, ?alloc);
    if (sel r_init.err) { ret 1; }
    fin { ir_type.dnit(?types); }
    val tr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 64);
    if (sel tr.err) { ret 1; }
    val ty:  ir_type.IrTypeId = tr.ok;
    var tgt: target.Target;
    tgt.model.flat_addressing = true;
    tgt.model.pointer_width   = 8;
    tgt.model.gpr_width       = 8;
    tgt.model.int_widths      = isa.INT_WIDTHS_1_2_4_8;
    var parameters: [2]mir.VRegId = [2]mir.VRegId{mir.vreg_id(0), mir.vreg_id(1)};
    var operands:   [2]value.Value;
    operands[0] = value.param(0, ty);
    operands[1] = value.param(1, ty);
    var instructions: [2]instr.Instruction;
    var i:            u32 = 0;
    for (i < 2) {
        instructions[i].ty            = ty;
        instructions[i].operands      = ?operands[0];
        instructions[i].operand_count = 2;
        i                             = i + 1;
    }
    instructions[0].kind = instr.OP_MUL_HIGH_U;
    instructions[1].kind = instr.OP_MUL_HIGH_S;
    var fn: ir.Function;
    fn.instrs    = ?instructions[0];
    fn.instr_len = 2;
    var ctx: lctx.LowerCtx;
    ctx.alloc       = ?alloc;
    ctx.tgt         = ?tgt;
    ctx.types       = ?types;
    ctx.param_vregs = ?parameters[0];
    ctx.param_count = 2;
    var mb: mir.MirBlock;
    fin { mir.dnit_block(?alloc, ?mb); }
    val r0: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 0);
    if (sel r0.err) { ret 2; }
    val r1: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 1);
    if (sel r1.err)                              { ret 3; }
    if (mb.instr_count != 2)                     { ret 4; }
    if (mb.instrs[0].opcode != mir.MIR_MUL_HI_U) { ret 5; }
    if (mb.instrs[1].opcode != mir.MIR_MUL_HI_S) { ret 6; }
    if (mb.instrs[0].width != 8)                 { ret 7; }
    ret 0;
}

# the fixed shift-count register serves the machine's own variable shift. a
# shift wider than the alu is legalized into constant stages, so its count stays
# a vreg: a move of a two-lane count into rcx would put a wide value in a
# physical register, which legalize refuses (#3511, #3602). both carry the
# saturation (#3756): a logical shift is `k = count < W; shift; and (0 - k)`,
# an arithmetic one shifts by `count | (k - 1)`, and an in-range immediate
# count is the bare machine shift
test "mach.lang.be.codegen.mir.lower.lower_shift:saturates_a_variable_count_and_keeps_a_wide_count_a_vreg" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var types:  ir_type.IrTypeTable;
    val r_init: err[fail.Fail] = ir_type.init(?types, ?alloc);
    if (sel r_init.err) { ret 1; }
    fin { ir_type.dnit(?types); }
    val t64_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 64);
    if (sel t64_r.err) { ret 1; }
    val t128_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 128);
    if (sel t128_r.err) { ret 1; }
    val t8_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 8);
    if (sel t8_r.err) { ret 1; }
    var tgt: target.Target;
    tgt.model.flat_addressing = true;
    tgt.model.pointer_width   = 8;
    tgt.model.gpr_width       = 8;
    tgt.model.max_alu_width   = 8;
    tgt.model.alu_min_width   = 4;
    tgt.model.int_widths      = isa.INT_WIDTHS_1_2_4_8_16;
    tgt.model.shift_count_reg = 1;
    var convention: abi.AbiVTable = target_testing.carriers_convention();
    tgt.abi = ?convention;
    var parameters: [2]mir.VRegId = [2]mir.VRegId{mir.vreg_id(0), mir.vreg_id(1)};
    var wide:       [2]value.Value;
    wide[0] = value.param(0, t128_r.ok);
    wide[1] = value.param(1, t128_r.ok);
    var narrow: [2]value.Value;
    narrow[0] = value.param(0, t64_r.ok);
    narrow[1] = value.param(1, t8_r.ok);
    var arith: [2]value.Value;
    arith[0] = value.param(0, t64_r.ok);
    arith[1] = value.param(1, t8_r.ok);
    var imm: [2]value.Value;
    imm[0] = value.param(0, t64_r.ok);
    imm[1] = value.const_int(3, t8_r.ok);
    var over: [2]value.Value;
    over[0] = value.param(0, t64_r.ok);
    over[1] = value.const_int(64, t8_r.ok);
    var widecount: [2]value.Value;
    widecount[0] = value.param(0, t64_r.ok);
    widecount[1] = value.param(1, t128_r.ok);
    var masked: [2]value.Value;
    masked[0] = value.param(1, t8_r.ok);
    masked[1] = value.const_int(63, t8_r.ok);
    var bounded: [2]value.Value;
    bounded[0] = value.param(0, t64_r.ok);
    bounded[1] = value.instr(6::id.InstructionId, t8_r.ok);
    var masked_wide: [2]value.Value;
    masked_wide[0] = value.param(1, t8_r.ok);
    masked_wide[1] = value.const_int(64, t8_r.ok);
    var unbounded: [2]value.Value;
    unbounded[0] = value.param(0, t64_r.ok);
    unbounded[1] = value.instr(8::id.InstructionId, t8_r.ok);
    var instructions: [10]instr.Instruction;
    instructions[0].kind          = instr.OP_SHL;
    instructions[0].ty            = t128_r.ok;
    instructions[0].operands      = ?wide[0];
    instructions[0].operand_count = 2;
    instructions[1].kind          = instr.OP_SHL;
    instructions[1].ty            = t64_r.ok;
    instructions[1].operands      = ?narrow[0];
    instructions[1].operand_count = 2;
    instructions[2].kind          = instr.OP_SHR_S;
    instructions[2].ty            = t64_r.ok;
    instructions[2].operands      = ?arith[0];
    instructions[2].operand_count = 2;
    instructions[3].kind          = instr.OP_SHR_U;
    instructions[3].ty            = t64_r.ok;
    instructions[3].operands      = ?imm[0];
    instructions[3].operand_count = 2;
    instructions[4].kind          = instr.OP_SHR_S;
    instructions[4].ty            = t64_r.ok;
    instructions[4].operands      = ?over[0];
    instructions[4].operand_count = 2;
    instructions[5].kind          = instr.OP_SHR_S;
    instructions[5].ty            = t64_r.ok;
    instructions[5].operands      = ?widecount[0];
    instructions[5].operand_count = 2;
    instructions[6].kind          = instr.OP_AND;
    instructions[6].ty            = t8_r.ok;
    instructions[6].operands      = ?masked[0];
    instructions[6].operand_count = 2;
    instructions[7].kind          = instr.OP_SHR_S;
    instructions[7].ty            = t64_r.ok;
    instructions[7].operands      = ?bounded[0];
    instructions[7].operand_count = 2;
    instructions[8].kind          = instr.OP_AND;
    instructions[8].ty            = t8_r.ok;
    instructions[8].operands      = ?masked_wide[0];
    instructions[8].operand_count = 2;
    instructions[9].kind          = instr.OP_SHL;
    instructions[9].ty            = t64_r.ok;
    instructions[9].operands      = ?unbounded[0];
    instructions[9].operand_count = 2;
    var fn: ir.Function;
    fn.instrs    = ?instructions[0];
    fn.instr_len = 10;
    var results: [10]mir.VRegId = [10]mir.VRegId{mir.vreg_id(2), mir.vreg_id(3), mir.vreg_id(4), mir.vreg_id(5), mir.vreg_id(6), mir.vreg_id(7),
        mir.vreg_id(8), mir.vreg_id(9), mir.vreg_id(10), mir.vreg_id(11)};
    var f: mir.MirFunction;
    fin { mir.dnit_function(?alloc, ?f); }
    val rv: res[*mir.MirVReg, A.Error] = A.allocate[mir.MirVReg](?alloc, 12);
    if (sel rv.err) { ret 1; }
    f.vregs      = rv.ok;
    f.vreg_cap   = 12;
    f.vreg_count = 12;
    var vi: u32 = 0;
    for (vi < 12) {
        f.vregs[vi] = mir.vreg(vi, mir.REG_CLASS_GP, false, false);
        vi          = vi + 1;
    }
    var ctx: lctx.LowerCtx;
    ctx.alloc       = ?alloc;
    ctx.tgt         = ?tgt;
    ctx.types       = ?types;
    ctx.f           = ?f;
    ctx.param_vregs = ?parameters[0];
    ctx.param_count = 2;
    ctx.instr_vregs = ?results[0];
    ctx.instr_count = 10;
    ctx.fn          = ?fn;
    var mb: mir.MirBlock;
    fin { mir.dnit_block(?alloc, ?mb); }

    # the wide logical shift: compare at the count's width (16), the shift with
    # the count vreg itself, then the zero-extended flag, its negation, the mask
    val r0: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 0);
    if (sel r0.err)                                              { ret 2; }
    if (mb.instr_count != 5)                                     { ret 3; }
    if (mb.instrs[0].opcode != mir.MIR_CMP_LT_U)                 { ret 4; }
    if (mb.instrs[0].width != 16)                                { ret 4; }
    if (mb.instrs[0].operands[2].kind != mir.MIR_OP_IMM)         { ret 4; }
    if (mb.instrs[0].operands[2].imm != 128)                     { ret 4; }
    if (mb.instrs[1].opcode != mir.MIR_SHL)                      { ret 5; }
    if (mb.instrs[1].operands[2].kind != mir.MIR_OP_VREG)        { ret 5; }
    if (mb.instrs[1].operands[2].vreg.n != 1)                    { ret 5; }
    if (mb.instrs[1].operands[0].vreg.n == 2)                    { ret 5; }
    if (mb.instrs[2].opcode != mir.MIR_ZEXT)                     { ret 6; }
    if (mb.instrs[2].width != 16 || mb.instrs[2].src_width != 1) { ret 6; }
    if (mb.instrs[3].opcode != mir.MIR_NEG)                      { ret 6; }
    if (mb.instrs[4].opcode != mir.MIR_AND)                      { ret 7; }
    if (mb.instrs[4].width != 16)                                { ret 7; }
    if (mb.instrs[4].operands[0].vreg.n != 2)                    { ret 7; }

    # the narrow logical shift: the compare reads the u8 count at width 1,
    # the count moves into the fixed register, then the same mask at width 8
    val r1: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 1);
    if (sel r1.err)                                       { ret 8; }
    if (mb.instr_count != 11)                             { ret 9; }
    if (mb.instrs[5].opcode != mir.MIR_CMP_LT_U)          { ret 10; }
    if (mb.instrs[5].width != 1)                          { ret 10; }
    if (mb.instrs[5].operands[2].imm != 64)               { ret 10; }
    if (mb.instrs[6].opcode != mir.MIR_MOV)               { ret 11; }
    if (mb.instrs[6].operands[0].kind != mir.MIR_OP_PREG) { ret 11; }
    if (mb.instrs[7].opcode != mir.MIR_SHL)               { ret 12; }
    if (mb.instrs[7].operands[2].kind != mir.MIR_OP_PREG) { ret 12; }
    if (mb.instrs[8].opcode != mir.MIR_ZEXT)              { ret 13; }
    if (mb.instrs[9].opcode != mir.MIR_NEG)               { ret 13; }
    if (mb.instrs[10].opcode != mir.MIR_AND)              { ret 13; }
    if (mb.instrs[10].width != 8)                         { ret 13; }
    if (mb.instrs[10].operands[0].vreg.n != 3)            { ret 13; }

    # the arithmetic shift saturates its count instead: zext, sub 1, or, and
    # the or'd count is what moves into the fixed register; no mask follows
    val r2: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 2);
    if (sel r2.err)                                                                                                                { ret 14; }
    if (mb.instr_count != 17)                                                                                                      { ret 15; }
    if (mb.instrs[11].opcode != mir.MIR_CMP_LT_U)                                                                                  { ret 16; }
    if (mb.instrs[12].opcode != mir.MIR_ZEXT)                                                                                      { ret 16; }
    if (mb.instrs[12].width != 4)                                                                                                  { ret 16; }
    if (mb.instrs[13].opcode != mir.MIR_SUB)                                                                                       { ret 16; }
    if (mb.instrs[13].operands[2].kind != mir.MIR_OP_IMM)                                                                          { ret 16; }
    if (mb.instrs[13].operands[2].imm != 1)                                                                                        { ret 16; }
    if (mb.instrs[14].opcode != mir.MIR_OR)                                                                                        { ret 17; }
    if (mb.instrs[14].operands[1].kind != mir.MIR_OP_VREG || mb.instrs[14].operands[1].vreg.n != 1)                                { ret 17; }
    if (mb.instrs[15].opcode != mir.MIR_MOV)                                                                                       { ret 18; }
    if (mb.instrs[15].operands[1].kind != mir.MIR_OP_VREG || mb.instrs[15].operands[1].vreg.n != mb.instrs[14].operands[0].vreg.n) { ret 18; }
    if (mb.instrs[16].opcode != mir.MIR_SHR_S)                                                                                     { ret 19; }
    if (mb.instrs[16].operands[0].vreg.n != 4)                                                                                     { ret 19; }

    # an in-range immediate count is the bare shift
    val r3: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 3);
    if (sel r3.err)                                       { ret 20; }
    if (mb.instr_count != 18)                             { ret 21; }
    if (mb.instrs[17].opcode != mir.MIR_SHR_U)            { ret 21; }
    if (mb.instrs[17].operands[2].kind != mir.MIR_OP_IMM) { ret 21; }
    if (mb.instrs[17].operands[2].imm != 3)               { ret 21; }

    # an immediate count at the width, should one reach lowering, is the
    # saturated shift: an arithmetic one by width - 1
    val r4: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 4);
    if (sel r4.err)                            { ret 22; }
    if (mb.instr_count != 19)                  { ret 23; }
    if (mb.instrs[18].opcode != mir.MIR_SHR_S) { ret 23; }
    if (mb.instrs[18].operands[2].imm != 63)   { ret 23; }

    # a count wider than the shift: the range test reads all of it, then the
    # shift's own width keeps its low bits before the saturating or and the
    # fixed register read it; a narrow shift never names the wide vreg
    val r5: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 5);
    if (sel r5.err)                                                { ret 24; }
    if (mb.instr_count != 26)                                      { ret 25; }
    if (mb.instrs[19].opcode != mir.MIR_CMP_LT_U)                  { ret 26; }
    if (mb.instrs[19].width != 16)                                 { ret 26; }
    if (mb.instrs[19].operands[1].vreg.n != 1)                     { ret 26; }
    if (mb.instrs[20].opcode != mir.MIR_TRUNC)                     { ret 27; }
    if (mb.instrs[20].width != 8 || mb.instrs[20].src_width != 16) { ret 27; }
    if (mb.instrs[20].operands[1].vreg.n != 1)                     { ret 27; }
    val low: u32 = mb.instrs[20].operands[0].vreg.n;
    if (mb.instrs[21].opcode != mir.MIR_ZEXT)                                                         { ret 28; }
    if (mb.instrs[21].width != 8)                                                                     { ret 28; }
    if (mb.instrs[22].opcode != mir.MIR_SUB)                                                          { ret 28; }
    if (mb.instrs[23].opcode != mir.MIR_OR)                                                           { ret 29; }
    if (mb.instrs[23].width != 8)                                                                     { ret 29; }
    if (mb.instrs[23].operands[1].kind != mir.MIR_OP_VREG || mb.instrs[23].operands[1].vreg.n != low) { ret 29; }
    if (mb.instrs[24].opcode != mir.MIR_MOV)                                                          { ret 30; }
    if (mb.instrs[25].opcode != mir.MIR_SHR_S)                                                        { ret 30; }
    if (mb.instrs[25].operands[2].kind != mir.MIR_OP_PREG)                                            { ret 30; }
    var k: u32 = 19;
    for (k < 26) {
        var o: u32 = 0;
        for (o < mb.instrs[k].operand_count) {
            val op: mir.MirOperand = mb.instrs[k].operands[o];
            if (op.kind == mir.MIR_OP_VREG && op.vreg.n == 1 && k != 19 && k != 20) { ret 31; }
            o = o + 1;
        }
        k = k + 1;
    }

    # a count masked below the width is already in range: the bare shift, no
    # compare and no saturating or
    val r7: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 7);
    if (sel r7.err)                                                                                 { ret 32; }
    if (mb.instr_count != 28)                                                                       { ret 33; }
    if (mb.instrs[26].opcode != mir.MIR_MOV)                                                        { ret 33; }
    if (mb.instrs[26].operands[1].kind != mir.MIR_OP_VREG || mb.instrs[26].operands[1].vreg.n != 8) { ret 33; }
    if (mb.instrs[27].opcode != mir.MIR_SHR_S)                                                      { ret 33; }
    if (mb.instrs[27].operands[0].vreg.n != 9)                                                      { ret 33; }

    # a mask that admits the width does not bound the count: the full sequence
    val r9: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 9);
    if (sel r9.err)                               { ret 34; }
    if (mb.instr_count != 34)                     { ret 35; }
    if (mb.instrs[28].opcode != mir.MIR_CMP_LT_U) { ret 35; }
    if (mb.instrs[33].opcode != mir.MIR_AND)      { ret 35; }
    if (mb.instrs[33].operands[0].vreg.n != 11)   { ret 35; }
    ret 0;
}

# the constant-time gate keys a scalar widening multiply by its operand width:
# two i64 operands into an i128 result are the 64-bit wide cell, not a 128-bit
# one, and the high multiply keys the same way (#3511)
test "mach.lang.be.codegen.mir.lower.ir_mul_cell:widening_multiply_is_keyed_by_its_operand_width" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var types:  ir_type.IrTypeTable;
    val r_init: err[fail.Fail] = ir_type.init(?types, ?alloc);
    if (sel r_init.err) { ret 1; }
    fin { ir_type.dnit(?types); }
    val t64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 64);
    if (sel t64.err) { ret 1; }
    val t128: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 128);
    if (sel t128.err) { ret 1; }
    var tgt: target.Target;
    tgt.model.flat_addressing = true;
    tgt.model.pointer_width   = 8;
    tgt.model.gpr_width       = 8;
    tgt.model.int_widths      = isa.INT_WIDTHS_1_2_4_8_16;
    var operands: [2]value.Value;
    operands[0] = value.param(0, t64.ok);
    operands[1] = value.param(1, t64.ok);
    var inst: instr.Instruction;
    inst.kind          = instr.OP_MUL_WIDE_U;
    inst.ty            = t128.ok;
    inst.operands      = ?operands[0];
    inst.operand_count = 2;
    var ctx: lctx.LowerCtx;
    ctx.alloc = ?alloc;
    ctx.tgt   = ?tgt;
    ctx.types = ?types;

    val wide_u: ct.CtMulCell = ir_mul_cell(?ctx, ?inst);
    if (wide_u.op != ct.CT_MUL_WIDE_U || wide_u.width != 64 || wide_u.vector) { ret 2; }
    inst.kind = instr.OP_MUL_WIDE_S;
    val wide_s: ct.CtMulCell = ir_mul_cell(?ctx, ?inst);
    if (wide_s.op != ct.CT_MUL_WIDE_S || wide_s.width != 64 || wide_s.vector) { ret 3; }
    inst.kind = instr.OP_MUL_HIGH_U;
    inst.ty   = t64.ok;
    val high: ct.CtMulCell = ir_mul_cell(?ctx, ?inst);
    if (high.op != ct.CT_MUL_HIGH_U || high.width != 64 || high.vector) { ret 4; }
    inst.kind = instr.OP_MUL;
    val low: ct.CtMulCell = ir_mul_cell(?ctx, ?inst);
    if (low.op != ct.CT_MUL_LOW || low.width != 64 || low.vector) { ret 5; }
    ret 0;
}

# a narrow divide is widened to the target's declared ALU floor, never to a
# fixed 32 bits: a register machine declares 4 and promotes, a typed target
# like SPIR-V declares 1 and divides at the lane width so the quotient stays
# the lane type (#3318)
fun t_narrow_div_widening(alu_min_width: u32, want_width: u8, want_promotes: u32) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var types:  ir_type.IrTypeTable;
    val r_init: err[fail.Fail] = ir_type.init(?types, ?alloc);
    if (sel r_init.err) { ret 1; }
    fin { ir_type.dnit(?types); }
    val tr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?types, 8);
    if (sel tr.err) { ret 1; }
    val ty:  ir_type.IrTypeId = tr.ok;
    var tgt: target.Target;
    tgt.model.flat_addressing = true;
    tgt.model.pointer_width   = 4;
    tgt.model.gpr_width       = 4;
    tgt.model.int_widths      = isa.INT_WIDTHS_1_2_4_8;
    tgt.model.alu_min_width   = alu_min_width;
    tgt.model.div_reg         = -1;
    tgt.model.div_hi_reg      = -1;
    var convention: abi.AbiVTable = target_testing.carriers_convention();
    tgt.abi = ?convention;
    var parameters: [2]mir.VRegId = [2]mir.VRegId{mir.vreg_id(0), mir.vreg_id(1)};
    var results:    [1]mir.VRegId = [1]mir.VRegId{mir.vreg_id(2)};
    var operands:   [2]value.Value;
    operands[0] = value.param(0, ty);
    operands[1] = value.param(1, ty);
    var instructions: [1]instr.Instruction;
    instructions[0].kind          = instr.OP_DIV_S;
    instructions[0].ty            = ty;
    instructions[0].operands      = ?operands[0];
    instructions[0].operand_count = 2;
    var fn: ir.Function;
    fn.instrs    = ?instructions[0];
    fn.instr_len = 1;
    var f: mir.MirFunction;
    fin { mir.dnit_function(?alloc, ?f); }
    val rv: res[*mir.MirVReg, A.Error] = A.allocate[mir.MirVReg](?alloc, 8);
    if (sel rv.err) { ret 1; }
    f.vregs      = rv.ok;
    f.vreg_cap   = 8;
    f.vreg_count = 3;
    var i: u32 = 0;
    for (i < 3) {
        f.vregs[i] = mir.vreg(i, mir.REG_CLASS_GP, false, false);
        i          = i + 1;
    }
    var ctx: lctx.LowerCtx;
    ctx.alloc       = ?alloc;
    ctx.tgt         = ?tgt;
    ctx.types       = ?types;
    ctx.f           = ?f;
    ctx.param_vregs = ?parameters[0];
    ctx.param_count = 2;
    ctx.instr_vregs = ?results[0];
    ctx.instr_count = 1;
    var mb: mir.MirBlock;
    fin { mir.dnit_block(?alloc, ?mb); }
    val lr: err[fail.Fail] = lower_instr(?ctx, ?fn, ?mb, 0);
    if (sel lr.err) { ret 2; }
    var promotes: u32 = 0;
    var divides:  u32 = 0;
    i = 0;
    for (i < mb.instr_count) {
        val mi: *mir.MirInstr = ?mb.instrs[i];
        if (mi.opcode == mir.MIR_SEXT) {
            if (mi.width != want_width || mi.src_width != 1) { ret 3; }
            promotes = promotes + 1;
        }
        or (mi.opcode == mir.MIR_DIV_S) {
            if (mi.width != want_width || mi.src_width != want_width) { ret 4; }
            if (mi.operands[0].vreg.n != 2)                           { ret 5; }
            divides = divides + 1;
        }
        or { ret 6; }
        i = i + 1;
    }
    if (divides != 1)              { ret 7; }
    if (promotes != want_promotes) { ret 8; }
    ret 0;
}

test "mach.lang.be.codegen.mir.lower.lower_div:narrow_divide_widens_to_the_declared_alu_floor" {
    val typed: i32 = t_narrow_div_widening(1, 1, 0);
    if (typed != 0) { ret typed; }
    val reg: i32 = t_narrow_div_widening(4, 4, 2);
    if (reg != 0) { ret 10 + reg; }
    ret 0;
}
