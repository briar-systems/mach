use mach.lang.be.codegen.ctvalidate;
use mir_context: mach.lang.be.codegen.mir.context;
use mach.lang.fail;
use mach.lang.growth;
use lang_mir: mach.lang.mir;
use mach.lang.target.abi;
use mach.lang.target.binding;
use mach.lang.target.isa;
use target_model:   mach.lang.target.model;
use target_testing: mach.lang.target.testing;
use A:              std.allocator;
use std.allocator.arena;
use std.allocator.page;
use T: std.allocator.testing;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

# at most eight payload vregs and sixteen memory instructions per snapshot
val SNAPSHOT_PIECES: u32 = 8;
val PIECE_BYTES:     u8  = 8;

rec Expansion {
    ctx:     *mir_context.LowerCtx;
    next_id: u32;
    origin:  *lang_mir.MirInstr;
    pending: lang_mir.MirInstr;
}

fun append_block(e: *Expansion, id: u32) res[u32, fail.Fail] {
    ret lang_mir.block_add(e.ctx.alloc, e.ctx.f, id);
}

fun fresh_block(e: *Expansion) res[u32, fail.Fail] {
    val id: u32 = e.next_id;
    e.next_id = id + 1;
    ret append_block(e, id);
}

fun emit(e: *Expansion, bi: u32, opcode: lang_mir.MirOpcode, operands: *lang_mir.MirOperand, n: u32, width: u8) err[fail.Fail] {
    val rr: res[*lang_mir.MirOperand, A.Error] = A.allocate[lang_mir.MirOperand](e.ctx.alloc, n::usize);
    if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
    val ops: *lang_mir.MirOperand = rr.ok;
    var i:   u32                  = 0;
    for (i < n) {
        ops[i] = operands[i];
        i      = i + 1;
    }
    val mb: *lang_mir.MirBlock = ?e.ctx.f.blocks[bi];
    val gr: err[fail.Fail]     = mir_context.instr_reserve(e.ctx, mb);
    if (sel gr.err) {
        A.deallocate[lang_mir.MirOperand](e.ctx.alloc, ops, n::usize);
        ret gr;
    }
    var mi: lang_mir.MirInstr = lang_mir.instr(opcode, ops, n, width, width);
    mi.loc           = e.origin.loc;
    mi.inline_site   = e.origin.inline_site;
    mi.writes_secret = e.origin.writes_secret && (opcode == lang_mir.MIR_LOAD || opcode == lang_mir.MIR_STORE);
    if (opcode == lang_mir.MIR_LOAD || opcode == lang_mir.MIR_STORE) { mi.memory_flags = e.origin.memory_flags; }
    mb.instrs[mb.instr_count] = mi;
    mb.instr_count            = mb.instr_count + 1;
    ret err[fail.Fail].ok{};
}

fun emit2(e: *Expansion, bi: u32, opcode: lang_mir.MirOpcode, a: lang_mir.MirOperand, b: lang_mir.MirOperand, width: u8) err[fail.Fail] {
    var ops: [2]lang_mir.MirOperand = [2]lang_mir.MirOperand{a, b};
    ret emit(e, bi, opcode, ?ops[0], 2, width);
}

fun emit3(e: *Expansion, bi: u32, opcode: lang_mir.MirOpcode, a: lang_mir.MirOperand, b: lang_mir.MirOperand, c: lang_mir.MirOperand, width: u8) err[fail.Fail] {
    var ops: [3]lang_mir.MirOperand = [3]lang_mir.MirOperand{a, b, c};
    ret emit(e, bi, opcode, ?ops[0], 3, width);
}

fun branch(e: *Expansion, bi: u32, target: u32) err[fail.Fail] {
    var op: lang_mir.MirOperand = lang_mir.op_block(e.ctx.f.blocks[target].id);
    ret emit(e, bi, lang_mir.MIR_BR, ?op, 1, e.ctx.tgt.target.model.pointer_width::u8);
}

fun conditional(e: *Expansion, bi: u32, cond: lang_mir.VRegId, yes: u32, no: u32) err[fail.Fail] {
    ret emit3(e, bi, lang_mir.MIR_CBR, lang_mir.op_vreg(cond), lang_mir.op_block(e.ctx.f.blocks[yes].id),
        lang_mir.op_block(e.ctx.f.blocks[no].id), e.ctx.tgt.target.model.pointer_width::u8);
}

fun address(e: *Expansion, bi: u32, mem: lang_mir.MirOperand) res[lang_mir.VRegId, fail.Fail] {
    val rv: res[lang_mir.VRegId, fail.Fail] = mir_context.new_vreg(e.ctx, lang_mir.REG_CLASS_GP);
    if (sel rv.err) { ret rv; }
    val v:  lang_mir.VRegId = rv.ok;
    val er: err[fail.Fail]  = emit2(e, bi, lang_mir.MIR_GEP, lang_mir.op_vreg(v), mem, e.ctx.tgt.target.model.pointer_width::u8);
    if (sel er.err) { ret res[lang_mir.VRegId, fail.Fail].err{er.err}; }
    ret res[lang_mir.VRegId, fail.Fail].ok{v};
}

fun piece_width(remaining: u64, mask: u32, word: u8) u8 {
    var width: u8 = word;
    if (width > PIECE_BYTES) { width = PIECE_BYTES; }
    for (width > 1 && (width::u64 > remaining || (mask & width::u32) == 0)) { width = width / 2; }
    ret width;
}

fun piece_count(size: u64, mask: u32, word: u8) u32 {
    var count: u32 = 0;
    var off:   u64 = 0;
    for (off < size && count <= SNAPSHOT_PIECES) {
        off   = off + piece_width(size - off, mask, word)::u64;
        count = count + 1;
    }
    ret count;
}

fun small(e: *Expansion, bi: u32, dst: lang_mir.MirOperand, src: lang_mir.MirOperand, size: u64, copy: bool, mask: u32) err[fail.Fail] {
    var values: [8]lang_mir.VRegId;
    val word:   u8  = e.ctx.tgt.target.model.gpr_width::u8;
    var off:    u64 = 0;
    var pi:     u32 = 0;
    if (copy) {
        for (off < size) {
            val width: u8                              = piece_width(size - off, mask, word);
            val rv:    res[lang_mir.VRegId, fail.Fail] = mir_context.new_vreg(e.ctx, lang_mir.REG_CLASS_GP);
            if (sel rv.err) { ret err[fail.Fail].err{rv.err}; }
            values[pi]                         = rv.ok;
            e.ctx.f.vregs[values[pi].n].secret = e.origin.writes_secret;
            val er: err[fail.Fail] = emit2(e, bi, lang_mir.MIR_LOAD, lang_mir.op_vreg(values[pi]), mir_context.mem_at(src, off::i64), width);
            if (sel er.err) { ret er; }
            off = off + width::u64;
            pi  = pi + 1;
        }
    }
    off = 0;
    pi  = 0;
    for (off < size) {
        val width: u8                  = piece_width(size - off, mask, word);
        var value: lang_mir.MirOperand = lang_mir.op_imm(0);
        if (copy) { value = lang_mir.op_vreg(values[pi]); }
        val er: err[fail.Fail] = emit2(e, bi, lang_mir.MIR_STORE, mir_context.mem_at(dst, off::i64), value, width);
        if (sel er.err) { ret er; }
        off = off + width::u64;
        pi  = pi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun loop_path(e: *Expansion, dst: lang_mir.VRegId, src: lang_mir.VRegId, size: u64, copy: bool, backward: bool, width: u8, mask: u32, done: u32) res[u32, fail.Fail] {
    val rs: res[u32, fail.Fail] = fresh_block(e);
    if (sel rs.err) { ret rs; }
    val setup: u32                 = rs.ok;
    val rb:    res[u32, fail.Fail] = fresh_block(e);
    if (sel rb.err) { ret rb; }
    val body: u32                 = rb.ok;
    val rt:   res[u32, fail.Fail] = fresh_block(e);
    if (sel rt.err) { ret rt; }
    val tail: u32                             = rt.ok;
    val rd:   res[lang_mir.VRegId, fail.Fail] = mir_context.new_vreg(e.ctx, lang_mir.REG_CLASS_GP);
    if (sel rd.err) { ret res[u32, fail.Fail].err{rd.err}; }
    val d:    lang_mir.VRegId                 = rd.ok;
    val rsrc: res[lang_mir.VRegId, fail.Fail] = mir_context.new_vreg(e.ctx, lang_mir.REG_CLASS_GP);
    if (sel rsrc.err) { ret res[u32, fail.Fail].err{rsrc.err}; }
    val s:  lang_mir.VRegId                 = rsrc.ok;
    val rc: res[lang_mir.VRegId, fail.Fail] = mir_context.new_vreg(e.ctx, lang_mir.REG_CLASS_GP);
    if (sel rc.err) { ret res[u32, fail.Fail].err{rc.err}; }
    val count: lang_mir.VRegId                 = rc.ok;
    val rv:    res[lang_mir.VRegId, fail.Fail] = mir_context.new_vreg(e.ctx, lang_mir.REG_CLASS_GP);
    if (sel rv.err) { ret res[u32, fail.Fail].err{rv.err}; }
    val value: lang_mir.VRegId = rv.ok;
    e.ctx.f.vregs[value.n].secret = e.origin.writes_secret;
    val rq: res[lang_mir.VRegId, fail.Fail] = mir_context.new_vreg(e.ctx, lang_mir.REG_CLASS_GP);
    if (sel rq.err) { ret res[u32, fail.Fail].err{rq.err}; }
    val more:      lang_mir.VRegId = rq.ok;
    val pw:        u8              = e.ctx.tgt.target.model.pointer_width::u8;
    val remainder: u64             = size % width::u64;
    val whole:     u64             = size - remainder;
    var initial:   i64             = 0;
    if (backward) { initial = whole::i64; }

    val ed: err[fail.Fail] = emit3(e, setup, lang_mir.MIR_ADD, lang_mir.op_vreg(d), lang_mir.op_vreg(dst), lang_mir.op_imm(initial), pw);
    if (sel ed.err) { ret res[u32, fail.Fail].err{ed.err}; }
    if (copy) {
        val es: err[fail.Fail] = emit3(e, setup, lang_mir.MIR_ADD, lang_mir.op_vreg(s), lang_mir.op_vreg(src), lang_mir.op_imm(initial), pw);
        if (sel es.err) { ret res[u32, fail.Fail].err{es.err}; }
    }
    if (backward) {
        val et: err[fail.Fail] = small(e, setup, lang_mir.op_mem_value(d, 0), lang_mir.op_mem_value(s, 0), remainder, copy, mask);
        if (sel et.err) { ret res[u32, fail.Fail].err{et.err}; }
    }
    val ec: err[fail.Fail] = emit2(e, setup, lang_mir.MIR_MOV, lang_mir.op_vreg(count), lang_mir.op_imm(whole::i64), pw);
    if (sel ec.err) { ret res[u32, fail.Fail].err{ec.err}; }
    val eb: err[fail.Fail] = branch(e, setup, body);
    if (sel eb.err) { ret res[u32, fail.Fail].err{eb.err}; }

    if (backward) {
        val edb: err[fail.Fail] = emit3(e, body, lang_mir.MIR_SUB, lang_mir.op_vreg(d), lang_mir.op_vreg(d), lang_mir.op_imm(width::i64), pw);
        if (sel edb.err) { ret res[u32, fail.Fail].err{edb.err}; }
        if (copy) {
            val esb: err[fail.Fail] = emit3(e, body, lang_mir.MIR_SUB, lang_mir.op_vreg(s), lang_mir.op_vreg(s), lang_mir.op_imm(width::i64), pw);
            if (sel esb.err) { ret res[u32, fail.Fail].err{esb.err}; }
        }
    }
    var stored: lang_mir.MirOperand = lang_mir.op_imm(0);
    if (copy) {
        val el: err[fail.Fail] = emit2(e, body, lang_mir.MIR_LOAD, lang_mir.op_vreg(value), lang_mir.op_mem_value(s, 0), width);
        if (sel el.err) { ret res[u32, fail.Fail].err{el.err}; }
        stored = lang_mir.op_vreg(value);
    }
    val ew: err[fail.Fail] = emit2(e, body, lang_mir.MIR_STORE, lang_mir.op_mem_value(d, 0), stored, width);
    if (sel ew.err) { ret res[u32, fail.Fail].err{ew.err}; }
    if (!backward) {
        val edf: err[fail.Fail] = emit3(e, body, lang_mir.MIR_ADD, lang_mir.op_vreg(d), lang_mir.op_vreg(d), lang_mir.op_imm(width::i64), pw);
        if (sel edf.err) { ret res[u32, fail.Fail].err{edf.err}; }
        if (copy) {
            val esf: err[fail.Fail] = emit3(e, body, lang_mir.MIR_ADD, lang_mir.op_vreg(s), lang_mir.op_vreg(s), lang_mir.op_imm(width::i64), pw);
            if (sel esf.err) { ret res[u32, fail.Fail].err{esf.err}; }
        }
    }
    val en: err[fail.Fail] = emit3(e, body, lang_mir.MIR_SUB, lang_mir.op_vreg(count), lang_mir.op_vreg(count), lang_mir.op_imm(width::i64), pw);
    if (sel en.err) { ret res[u32, fail.Fail].err{en.err}; }
    val eq: err[fail.Fail] = emit3(e, body, lang_mir.MIR_CMP_NE, lang_mir.op_vreg(more), lang_mir.op_vreg(count), lang_mir.op_imm(0), pw);
    if (sel eq.err) { ret res[u32, fail.Fail].err{eq.err}; }
    val ej: err[fail.Fail] = conditional(e, body, more, body, tail);
    if (sel ej.err) { ret res[u32, fail.Fail].err{ej.err}; }
    if (!backward) {
        val et: err[fail.Fail] = small(e, tail, lang_mir.op_mem_value(d, 0), lang_mir.op_mem_value(s, 0), remainder, copy, mask);
        if (sel et.err) { ret res[u32, fail.Fail].err{et.err}; }
    }
    val ee: err[fail.Fail] = branch(e, tail, done);
    if (sel ee.err) { ret res[u32, fail.Fail].err{ee.err}; }
    ret res[u32, fail.Fail].ok{setup};
}

fun expand_one(e: *Expansion, bi: u32) res[u32, fail.Fail] {
    val mi:   *lang_mir.MirInstr  = e.origin;
    val copy: bool                = mi.opcode == lang_mir.MIR_MEMCPY;
    val size: u64                 = mi.operands[mi.operand_count - 1].imm::u64;
    val dst:  lang_mir.MirOperand = mi.operands[0];
    var src:  lang_mir.MirOperand;
    if (copy) { src = mi.operands[1]; }
    var word: u8 = e.ctx.tgt.target.model.gpr_width::u8;
    if (word > PIECE_BYTES) { word = PIECE_BYTES; }
    var mask: u32 = 1;
    if ((mi.memory_flags & lang_mir.MEMORY_VOLATILE) == 0) {
        var width: u32 = 2;
        for (width <= word::u32) {
            if (target_model.moves_unaligned_gp(?e.ctx.tgt.target.model, width)) { mask = mask | width; }
            width = width * 2;
        }
    }
    if (piece_count(size, mask, word) <= SNAPSHOT_PIECES) {
        val er: err[fail.Fail] = small(e, bi, dst, src, size, copy, mask);
        if (sel er.err) { ret res[u32, fail.Fail].err{er.err}; }
        ret res[u32, fail.Fail].ok{bi};
    }
    for (word::u64 > size) { word = word / 2; }
    val rd: res[lang_mir.VRegId, fail.Fail] = address(e, bi, dst);
    if (sel rd.err) { ret res[u32, fail.Fail].err{rd.err}; }
    val d: lang_mir.VRegId = rd.ok;
    var s: lang_mir.VRegId = lang_mir.MIR_VREG_NIL;
    if (copy) {
        val rs: res[lang_mir.VRegId, fail.Fail] = address(e, bi, src);
        if (sel rs.err) { ret res[u32, fail.Fail].err{rs.err}; }
        s = rs.ok;
    }
    val re: res[u32, fail.Fail] = fresh_block(e);
    if (sel re.err) { ret re; }
    val done: u32 = re.ok;
    val pw:   u8  = e.ctx.tgt.target.model.pointer_width::u8;
    if ((mask & word::u32) != 0) {
        val rf: res[u32, fail.Fail] = loop_path(e, d, s, size, copy, false, word, mask, done);
        if (sel rf.err) { ret rf; }
        if (!copy) {
            val ej: err[fail.Fail] = branch(e, bi, rf.ok);
            if (sel ej.err) { ret res[u32, fail.Fail].err{ej.err}; }
            ret res[u32, fail.Fail].ok{done};
        }
        val rb: res[u32, fail.Fail] = loop_path(e, d, s, size, true, true, word, mask, done);
        if (sel rb.err) { ret rb; }
        val rq: res[lang_mir.VRegId, fail.Fail] = mir_context.new_vreg(e.ctx, lang_mir.REG_CLASS_GP);
        if (sel rq.err) { ret res[u32, fail.Fail].err{rq.err}; }
        val before: lang_mir.VRegId = rq.ok;
        val ec:     err[fail.Fail]  = emit3(e, bi, lang_mir.MIR_CMP_LT_U, lang_mir.op_vreg(before), lang_mir.op_vreg(d), lang_mir.op_vreg(s), pw);
        if (sel ec.err) { ret res[u32, fail.Fail].err{ec.err}; }
        val ej: err[fail.Fail] = conditional(e, bi, before, rf.ok, rb.ok);
        if (sel ej.err) { ret res[u32, fail.Fail].err{ej.err}; }
        ret res[u32, fail.Fail].ok{done};
    }
    val ra: res[lang_mir.VRegId, fail.Fail] = mir_context.new_vreg(e.ctx, lang_mir.REG_CLASS_GP);
    if (sel ra.err) { ret res[u32, fail.Fail].err{ra.err}; }
    val unaligned: lang_mir.VRegId     = ra.ok;
    var combined:  lang_mir.MirOperand = lang_mir.op_vreg(d);
    if (copy) {
        val eo: err[fail.Fail] = emit3(e, bi, lang_mir.MIR_OR, lang_mir.op_vreg(unaligned), lang_mir.op_vreg(d), lang_mir.op_vreg(s), pw);
        if (sel eo.err) { ret res[u32, fail.Fail].err{eo.err}; }
        combined = lang_mir.op_vreg(unaligned);
    }
    val ea: err[fail.Fail] = emit3(e, bi, lang_mir.MIR_AND, lang_mir.op_vreg(unaligned), combined, lang_mir.op_imm((word - 1)::i64), pw);
    if (sel ea.err) { ret res[u32, fail.Fail].err{ea.err}; }
    val rw: res[u32, fail.Fail] = loop_path(e, d, s, size, copy, false, word, word::u32 * 2 - 1, done);
    if (sel rw.err) { ret rw; }
    val rb: res[u32, fail.Fail] = loop_path(e, d, s, size, copy, false, 1, 1, done);
    if (sel rb.err) { ret rb; }
    if (!copy) {
        val ej: err[fail.Fail] = conditional(e, bi, unaligned, rb.ok, rw.ok);
        if (sel ej.err) { ret res[u32, fail.Fail].err{ej.err}; }
        ret res[u32, fail.Fail].ok{done};
    }
    val rbackw: res[u32, fail.Fail] = loop_path(e, d, s, size, true, true, word, word::u32 * 2 - 1, done);
    if (sel rbackw.err) { ret rbackw; }
    val rbackb: res[u32, fail.Fail] = loop_path(e, d, s, size, true, true, 1, 1, done);
    if (sel rbackb.err) { ret rbackb; }
    val rf: res[u32, fail.Fail] = fresh_block(e);
    if (sel rf.err) { ret rf; }
    val forward: u32                 = rf.ok;
    val rback:   res[u32, fail.Fail] = fresh_block(e);
    if (sel rback.err) { ret rback; }
    val backward: u32            = rback.ok;
    val ef:       err[fail.Fail] = conditional(e, forward, unaligned, rb.ok, rw.ok);
    if (sel ef.err) { ret res[u32, fail.Fail].err{ef.err}; }
    val eb: err[fail.Fail] = conditional(e, backward, unaligned, rbackb.ok, rbackw.ok);
    if (sel eb.err) { ret res[u32, fail.Fail].err{eb.err}; }
    val rq: res[lang_mir.VRegId, fail.Fail] = mir_context.new_vreg(e.ctx, lang_mir.REG_CLASS_GP);
    if (sel rq.err) { ret res[u32, fail.Fail].err{rq.err}; }
    val before: lang_mir.VRegId = rq.ok;
    val ec:     err[fail.Fail]  = emit3(e, bi, lang_mir.MIR_CMP_LT_U, lang_mir.op_vreg(before), lang_mir.op_vreg(d), lang_mir.op_vreg(s), pw);
    if (sel ec.err) { ret res[u32, fail.Fail].err{ec.err}; }
    val ej: err[fail.Fail] = conditional(e, bi, before, forward, backward);
    if (sel ej.err) { ret res[u32, fail.Fail].err{ej.err}; }
    ret res[u32, fail.Fail].ok{done};
}

fun move_bindings(e: *Expansion, dst: *lang_mir.MirInstr, src: *lang_mir.MirInstr) err[fail.Fail] {
    if (src.dbg_binding_count == 0) { ret err[fail.Fail].ok{}; }
    val old:   u32          = dst.dbg_binding_count;
    var cap:   u32          = old;
    val grown: err[A.Error] = growth.resize[lang_mir.MirDbgBinding](e.ctx.alloc, ?dst.dbg_bindings, ?cap, old::usize + src.dbg_binding_count::usize);
    if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    var i: u32 = 0;
    for (i < src.dbg_binding_count) {
        dst.dbg_bindings[old + i] = src.dbg_bindings[i];
        i                         = i + 1;
    }
    dst.dbg_binding_count = cap;
    A.deallocate[lang_mir.MirDbgBinding](e.ctx.alloc, src.dbg_bindings, src.dbg_binding_count::usize);
    src.dbg_bindings      = nil;
    src.dbg_binding_count = 0;
    ret err[fail.Fail].ok{};
}

fun move_instr(e: *Expansion, bi: u32, mi: *lang_mir.MirInstr) err[fail.Fail] {
    val mb: *lang_mir.MirBlock = ?e.ctx.f.blocks[bi];
    val gr: err[fail.Fail]     = mir_context.instr_reserve(e.ctx, mb);
    if (sel gr.err) { ret gr; }
    val dr: err[fail.Fail] = move_bindings(e, mi, ?e.pending);
    if (sel dr.err) { ret dr; }
    mb.instrs[mb.instr_count] = @mi;
    mb.instr_count            = mb.instr_count + 1;
    mi.operands               = nil;
    mi.operand_count          = 0;
    mi.dbg_bindings           = nil;
    mi.dbg_binding_count      = 0;
    mi.asm_block              = nil;
    ret err[fail.Fail].ok{};
}

pub fun expand(ctx: *mir_context.LowerCtx) err[fail.Fail] {
    if (!ctx.tgt.target.model.flat_addressing) { ret err[fail.Fail].ok{}; }
    var found:   bool = false;
    var next_id: u32  = 0;
    var bi:      u32  = 0;
    for (bi < ctx.f.block_count) {
        val mb: *lang_mir.MirBlock = ?ctx.f.blocks[bi];
        if (mb.id >= next_id) { next_id = mb.id + 1; }
        var ii: u32 = 0;
        for (ii < mb.instr_count) {
            val op: lang_mir.MirOpcode = mb.instrs[ii].opcode;
            if (op == lang_mir.MIR_MEMCPY || op == lang_mir.MIR_MEMZERO) { found = true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    if (!found) { ret err[fail.Fail].ok{}; }
    var old: lang_mir.MirFunction;
    old.blocks        = ctx.f.blocks;
    old.block_count   = ctx.f.block_count;
    old.block_cap     = ctx.f.block_cap;
    ctx.f.blocks      = nil;
    ctx.f.block_count = 0;
    ctx.f.block_cap   = 0;
    fin { lang_mir.dnit_function(ctx.alloc, ?old); }
    var e: Expansion;
    e.ctx     = ctx;
    e.next_id = next_id;
    fin {
        if (e.pending.dbg_bindings != nil) {
            A.deallocate[lang_mir.MirDbgBinding](ctx.alloc, e.pending.dbg_bindings, e.pending.dbg_binding_count::usize);
        }
    }
    bi = 0;
    for (bi < old.block_count) {
        val rb: res[u32, fail.Fail] = append_block(?e, old.blocks[bi].id);
        if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
        var current: u32 = rb.ok;
        var ii:      u32 = 0;
        for (ii < old.blocks[bi].instr_count) {
            val mi: *lang_mir.MirInstr = ?old.blocks[bi].instrs[ii];
            if (mi.opcode == lang_mir.MIR_MEMCPY || mi.opcode == lang_mir.MIR_MEMZERO) {
                e.origin = mi;
                val er: res[u32, fail.Fail] = expand_one(?e, current);
                if (sel er.err) { ret err[fail.Fail].err{er.err}; }
                current = er.ok;
                val dr: err[fail.Fail] = move_bindings(?e, ?e.pending, mi);
                if (sel dr.err) { ret dr; }
            }
            or {
                val mr: err[fail.Fail] = move_instr(?e, current, mi);
                if (sel mr.err) { ret mr; }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

#[testing]
fun t_setup(ctx: *mir_context.LowerCtx, size: u64, copy: bool) err[fail.Fail] {
    val rv: res[*lang_mir.MirVReg, A.Error] = A.allocate[lang_mir.MirVReg](ctx.alloc, 8);
    if (sel rv.err) { ret err[fail.Fail].err{fail.refused(rv.err)}; }
    ctx.f.vregs      = rv.ok;
    ctx.f.vreg_cap   = 8;
    ctx.f.vreg_count = 2;
    ctx.f.vregs[0]   = lang_mir.vreg(0, lang_mir.REG_CLASS_GP, 0, false);
    ctx.f.vregs[1]   = lang_mir.vreg(1, lang_mir.REG_CLASS_GP, 0, false);
    var e: Expansion;
    e.ctx = ctx;
    val rb: res[u32, fail.Fail] = append_block(?e, 7);
    if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
    var origin: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_RET, nil, 0, 0, 0);
    origin.inline_site   = 19;
    origin.writes_secret = true;
    e.origin             = ?origin;
    if (copy) {
        val er: err[fail.Fail] = emit3(?e, 0, lang_mir.MIR_MEMCPY, lang_mir.op_mem_value(lang_mir.vreg_id(1), 0), lang_mir.op_mem_value(lang_mir.vreg_id(0), 0), lang_mir.op_imm(size::i64), ctx.tgt.target.model.pointer_width::u8);
        if (sel er.err) { ret er; }
    }
    or {
        val er: err[fail.Fail] = emit2(?e, 0, lang_mir.MIR_MEMZERO, lang_mir.op_mem_value(lang_mir.vreg_id(1), 0), lang_mir.op_imm(size::i64), ctx.tgt.target.model.pointer_width::u8);
        if (sel er.err) { ret er; }
    }
    ctx.f.blocks[0].instrs[0].writes_secret = true;
    ctx.f.blocks[0].instrs[0].memory_flags  = lang_mir.MEMORY_VOLATILE;
    val dr: err[fail.Fail] = lang_mir.instr_attach_dbg(ctx.alloc, ?ctx.f.blocks[0].instrs[0], 29, 1);
    if (sel dr.err) { ret dr; }
    ctx.f.blocks[0].instrs[0].dbg_bindings[0].cmp_width = 4;
    var ret_inst: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_RET, nil, 0, ctx.tgt.target.model.pointer_width::u8, ctx.tgt.target.model.pointer_width::u8);
    ret mir_context.push_instr(ctx, ?ctx.f.blocks[0], ret_inst);
}

#[testing]
fun t_value(op: lang_mir.MirOperand, regs: *u64) u64 {
    if (op.kind == lang_mir.MIR_OP_IMM) { ret op.imm::u64; }
    if (op.kind == lang_mir.MIR_OP_MEM) { ret regs[op.vreg.n] + op.imm::u64; }
    ret regs[op.vreg.n];
}

#[testing]
fun t_execute(f: *lang_mir.MirFunction, bytes: *u8, src: u64, dst: u64, accesses: *u64, unaligned_widths: u32) i32 {
    @accesses = 0;
    var regs: [128]u64;
    regs[0] = src;
    regs[1] = dst;
    var bi:    u32 = 0;
    var steps: u32 = 0;
    for (steps < 100000) {
        val mb:   *lang_mir.MirBlock = ?f.blocks[bi];
        var next: u32                = lang_mir.MIR_VREG_NIL.n;
        var ii:   u32                = 0;
        for (ii < mb.instr_count) {
            val mi: *lang_mir.MirInstr = ?mb.instrs[ii];
            val op: lang_mir.MirOpcode = mi.opcode;
            steps = steps + 1;
            if (op == lang_mir.MIR_RET) { ret 0; }
            if (op == lang_mir.MIR_BR)  { next = mi.operands[0].imm::u32; }
            or (op == lang_mir.MIR_CBR) {
                next = mi.operands[2].imm::u32;
                if (t_value(mi.operands[0], ?regs[0]) != 0) { next = mi.operands[1].imm::u32; }
            }
            or (op == lang_mir.MIR_LOAD || op == lang_mir.MIR_STORE) {
                @accesses = @accesses + mi.width::u64;
                var mem: lang_mir.MirOperand = mi.operands[1];
                if (op == lang_mir.MIR_STORE) { mem = mi.operands[0]; }
                val at: u64 = t_value(mem, ?regs[0]);
                if (at + mi.width::u64 > 1024)                                                          { ret 1; }
                if (mi.width > 1 && at % mi.width::u64 != 0 && (unaligned_widths & mi.width::u32) == 0) { ret 2; }
                var value: u64 = 0;
                if (op == lang_mir.MIR_STORE) { value = t_value(mi.operands[1], ?regs[0]); }
                var j: u32 = 0;
                for (j < mi.width::u32) {
                    if (op == lang_mir.MIR_LOAD) { value = value | (bytes[at + j::u64]::u64 << (j * 8)); }
                    or                           { bytes[at + j::u64] = (value >> (j * 8))::u8; }
                    j = j + 1;
                }
                if (op == lang_mir.MIR_LOAD) { regs[mi.operands[0].vreg.n] = value; }
            }
            or {
                val a: u64 = t_value(mi.operands[1], ?regs[0]);
                var b: u64 = 0;
                if (mi.operand_count == 3) { b = t_value(mi.operands[2], ?regs[0]); }
                var result: u64 = a;
                if (op == lang_mir.MIR_ADD)                           { result = a + b; }
                or (op == lang_mir.MIR_SUB)                           { result = a - b; }
                or (op == lang_mir.MIR_OR)                            { result = a | b; }
                or (op == lang_mir.MIR_AND)                           { result = a & b; }
                or (op == lang_mir.MIR_CMP_NE)                        { result = (a != b)::u64; }
                or (op == lang_mir.MIR_CMP_LT_U)                      { result = (a < b)::u64; }
                or (op != lang_mir.MIR_MOV && op != lang_mir.MIR_GEP) { ret 3; }
                if (mi.width < 8)                                     { result = result & ((1u64 << (mi.width::u32 * 8)) - 1); }
                regs[mi.operands[0].vreg.n] = result;
            }
            ii = ii + 1;
        }
        bi = 0;
        for (bi < f.block_count && f.blocks[bi].id != next) { bi = bi + 1; }
        if (bi == f.block_count) { ret 4; }
    }
    ret 5;
}

#[testing]
fun t_case(size: u64, src: u64, dst: u64, copy: bool, pointer_width: u32, word: u32) i32 {
    ret t_case_model(size, src, dst, copy, pointer_width, word, 0, true);
}

#[testing]
fun t_case_model(size: u64, src: u64, dst: u64, copy: bool, pointer_width: u32, word: u32, unaligned_widths: u32, volatile: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var tgt: binding.Binding;
    tgt.target.model.flat_addressing     = true;
    tgt.target.model.pointer_width       = pointer_width;
    tgt.target.model.gpr_width           = word;
    tgt.target.model.gp_unaligned_widths = unaligned_widths;
    var f: lang_mir.MirFunction;
    fin { lang_mir.dnit_function(?alloc, ?f); }
    var ctx: mir_context.LowerCtx;
    ctx.alloc = ?alloc;
    var convention: abi.AbiVTable = target_testing.carriers_convention();
    tgt.abi = ?convention;
    ctx.tgt = ?tgt;
    ctx.f   = ?f;
    val t_setup_r: err[fail.Fail] = t_setup(?ctx, size, copy);
    if (sel t_setup_r.err) { ret 2; }
    if (!volatile)         { f.blocks[0].instrs[0].memory_flags = 0; }
    val expand_r: err[fail.Fail] = expand(?ctx);
    if (sel expand_r.err) { ret 3; }
    var bytes: [1024]u8;
    var i:     u64 = 0;
    for (i < 1024) {
        bytes[i] = (i % 251)::u8;
        i        = i + 1;
    }
    var accesses: u64 = 0;
    var allowed:  u32 = unaligned_widths;
    if (volatile) { allowed = 0; }
    val executed: i32 = t_execute(?f, ?bytes[0], src, dst, ?accesses, allowed);
    if (executed != 0) { ret 10 + executed; }
    var expected_accesses: u64 = size;
    if (copy)                          { expected_accesses = size * 2; }
    if (accesses != expected_accesses) { ret 21; }
    i = 0;
    for (i < 1024) {
        var expected: u8 = (i % 251)::u8;
        if (i >= dst && i < dst + size) {
            expected = 0;
            if (copy) { expected = ((src + i - dst) % 251)::u8; }
        }
        if (bytes[i] != expected) { ret 20; }
        i = i + 1;
    }
    ret 0;
}

test expand__snapshot_overlap_and_exact_extent {
    var sizes: [8]u64 = [8]u64{0, 1, 3, 15, 16, 17, 65, 257};
    var i:     u32    = 0;
    for (i < 8) {
        if (t_case(sizes[i], 16, 17, true, 8, 8) != 0)  { ret 1; }
        if (t_case(sizes[i], 17, 16, true, 8, 8) != 0)  { ret 2; }
        if (t_case(sizes[i], 16, 24, true, 8, 8) != 0)  { ret 3; }
        if (t_case(sizes[i], 24, 16, true, 8, 8) != 0)  { ret 4; }
        if (t_case(sizes[i], 17, 17, true, 8, 8) != 0)  { ret 5; }
        if (t_case(sizes[i], 16, 320, true, 4, 4) != 0) { ret 6; }
        if (t_case(sizes[i], 16, 17, true, 2, 1) != 0)  { ret 7; }
        if (t_case(sizes[i], 16, 16, false, 8, 8) != 0) { ret 8; }
        if (t_case(sizes[i], 16, 17, false, 8, 8) != 0) { ret 9; }
        i = i + 1;
    }
    ret 0;
}

test expand__bounded_shape_secrecy_and_debug_ownership {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var sizes: [7]u64 = [7]u64{0, 3, 16, 17, 65, 65536, 1048577};
    var si:    u32    = 0;
    for (si < 7) {
        var tgt: binding.Binding;
        tgt.target.model.flat_addressing = true;
        tgt.target.model.pointer_width   = 8;
        tgt.target.model.gpr_width       = 8;
        var f: lang_mir.MirFunction;
        fin { lang_mir.dnit_function(?alloc, ?f); }
        var ctx: mir_context.LowerCtx;
        ctx.alloc = ?alloc;
        var convention: abi.AbiVTable = target_testing.carriers_convention();
        tgt.abi = ?convention;
        ctx.tgt = ?tgt;
        ctx.f   = ?f;
        val t_setup_r: err[fail.Fail] = t_setup(?ctx, sizes[si], true);
        if (sel t_setup_r.err) { ret 2; }
        val expand_r: err[fail.Fail] = expand(?ctx);
        if (sel expand_r.err)                                               { ret 3; }
        if (f.block_count > 16 || f.vreg_count > 64 || f.blocks[0].id != 7) { ret 4; }
        var instructions: u32  = 0;
        var bindings:     u32  = 0;
        var loads:        u32  = 0;
        var stores:       u32  = 0;
        var saw_store:    bool = false;
        var bi:           u32  = 0;
        for (bi < f.block_count) {
            val mb: *lang_mir.MirBlock = ?f.blocks[bi];
            if (mb.instr_count == 0) { ret 5; }
            instructions = instructions + mb.instr_count;
            var ii: u32 = 0;
            for (ii < mb.instr_count) {
                val mi: *lang_mir.MirInstr = ?mb.instrs[ii];
                if (mi.opcode == lang_mir.MIR_MEMCPY || mi.opcode == lang_mir.MIR_MEMZERO) { ret 6; }
                val memory: bool = mi.opcode == lang_mir.MIR_LOAD || mi.opcode == lang_mir.MIR_STORE;
                if (mi.writes_secret != memory)                            { ret 7; }
                if (memory && mi.memory_flags != lang_mir.MEMORY_VOLATILE) { ret 17; }
                if (!memory && mi.memory_flags != 0)                       { ret 18; }
                if (mi.opcode != lang_mir.MIR_RET && mi.inline_site != 19) { ret 8; }
                if (mi.opcode == lang_mir.MIR_LOAD) {
                    loads = loads + 1;
                    if (!f.vregs[mi.operands[0].vreg.n].secret) { ret 9; }
                    if (f.block_count == 1 && saw_store)        { ret 10; }
                }
                if (mi.opcode == lang_mir.MIR_STORE) {
                    stores    = stores + 1;
                    saw_store = true;
                }
                bindings = bindings + mi.dbg_binding_count;
                if (mi.dbg_binding_count > 0) {
                    if (mi.opcode != lang_mir.MIR_RET || mi.dbg_binding_count != 1)        { ret 11; }
                    if (mi.dbg_bindings[0].iid != 29 || mi.dbg_bindings[0].cmp_width != 4) { ret 12; }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        if (instructions > 160 || bindings != 1)           { ret 15; }
        if (sizes[si] == 0 && (loads != 0 || stores != 0)) { ret 16; }
        si = si + 1;
    }
    ret 0;
}

test expand__every_allocation_failure_releases_owned_storage {
    var failing:          usize = 0;
    var allocation_count: usize = 0;
    for (failing == 0 || failing <= allocation_count) {
        var t:    T.Testing;
        val made: err[A.Error] = T.make(?t);
        if (sel made.err) { ret 1; }
        val alloc: *A.Allocator = T.allocator_of(?t);
        var tgt:   binding.Binding;
        tgt.target.model.flat_addressing = true;
        tgt.target.model.pointer_width   = 8;
        tgt.target.model.gpr_width       = 8;
        var f:   lang_mir.MirFunction;
        var ctx: mir_context.LowerCtx;
        ctx.alloc = alloc;
        var convention: abi.AbiVTable = target_testing.carriers_convention();
        tgt.abi = ?convention;
        ctx.tgt = ?tgt;
        ctx.f   = ?f;
        val t_setup_r: err[fail.Fail] = t_setup(?ctx, 257, true);
        if (sel t_setup_r.err) {
            lang_mir.dnit_function(alloc, ?f);
            ret 2;
        }
        val before: usize = T.attempt_count(?t);
        if (failing != 0) { T.fail_at_ordinal(?t, before + failing); }
        val result: err[fail.Fail] = expand(?ctx);
        lang_mir.dnit_function(alloc, ?f);
        if (!T.clean(?t)) { ret 3; }
        if (failing == 0) {
            if (sel result.err) { ret 4; }
            allocation_count = T.attempt_count(?t) - before;
            if (allocation_count == 0) { ret 5; }
        }
        or {
            if (sel result.ok)            { ret 6; }
            if (T.refused_count(?t) != 1) { ret 7; }
        }
        T.dnit(?t);
        failing = failing + 1;
    }
    ret 0;
}

test expand__secret_payload_refuses_secret_addresses {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var scratch: arena.Arena;
    val init_r:  err[A.Error] = arena.init(?scratch, ?backing, 65536);
    if (sel init_r.err) { ret 1; }
    fin { arena.dnit(?scratch); }
    var alloc:   A.Allocator;
    val make_r2: err[A.Error] = arena.make(?alloc, ?scratch);
    if (sel make_r2.err) { ret 1; }
    var tgt: binding.Binding;
    tgt.target.model.flat_addressing = true;
    tgt.target.model.pointer_width   = 8;
    tgt.target.model.gpr_width       = 8;
    var arch: isa.IsaVTable = isa.IsaVTable{name: "bulk", pointer_width: 8, model: ?tgt.target.model};
    tgt.isa = ?arch;
    var f: lang_mir.MirFunction;
    fin { lang_mir.dnit_function(?alloc, ?f); }
    f.oblivious = true;
    var ctx: mir_context.LowerCtx;
    ctx.alloc = ?alloc;
    var convention: abi.AbiVTable = target_testing.carriers_convention();
    tgt.abi = ?convention;
    ctx.tgt = ?tgt;
    ctx.f   = ?f;
    val t_setup_r: err[fail.Fail] = t_setup(?ctx, 257, true);
    if (sel t_setup_r.err) { ret 2; }
    val expand_r: err[fail.Fail] = expand(?ctx);
    if (sel expand_r.err) { ret 3; }
    var module: lang_mir.MirModule;
    module.alloc        = ?alloc;
    module.functions    = ?f;
    module.function_len = 1;
    val validate_r: err[fail.Fail] = ctvalidate.validate(?tgt, ?module);
    if (sel validate_r.err) { ret 4; }
    f.vregs[0].secret = true;
    val validate_r2: err[fail.Fail] = ctvalidate.validate(?tgt, ?module);
    if (!sel validate_r2.err) { ret 5; }
    f.vregs[0].secret = false;
    f.vregs[1].secret = true;
    val validate_r3: err[fail.Fail] = ctvalidate.validate(?tgt, ?module);
    if (!sel validate_r3.err) { ret 6; }
    ret 0;
}

test expand__unaligned_pieces_keep_snapshot_tails_and_volatile_accesses {
    var sizes: [12]u64 = [12]u64{0, 1, 3, 8, 15, 16, 17, 31, 57, 64, 65, 257};
    var i:     u32     = 0;
    for (i < 12) {
        if (t_case_model(sizes[i], 16, 17, true, 8, 8, 14, false) != 0)  { ret 1; }
        if (t_case_model(sizes[i], 17, 16, true, 8, 8, 14, false) != 0)  { ret 2; }
        if (t_case_model(sizes[i], 17, 17, true, 8, 8, 14, false) != 0)  { ret 3; }
        if (t_case_model(sizes[i], 16, 320, true, 8, 8, 14, false) != 0) { ret 4; }
        if (t_case_model(sizes[i], 16, 17, false, 8, 8, 14, false) != 0) { ret 5; }
        if (t_case_model(sizes[i], 16, 17, true, 4, 4, 6, false) != 0)   { ret 6; }
        if (t_case_model(sizes[i], 16, 17, true, 8, 8, 8, false) != 0)   { ret 7; }
        if (t_case_model(sizes[i], 17, 17, true, 8, 8, 14, true) != 0)   { ret 8; }
        if (t_case_model(sizes[i], 16, 17, false, 8, 8, 14, true) != 0)  { ret 9; }
        i = i + 1;
    }
    ret 0;
}

test expand__non_volatile_pieces_stay_secret {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var sizes: [3]u64 = [3]u64{17, 65, 65536};
    var mode:  u32    = 0;
    for (mode < 2) {
        var si: u32 = 0;
        for (si < 3) {
            var tgt: binding.Binding;
            tgt.target.model.flat_addressing     = true;
            tgt.target.model.pointer_width       = 8;
            tgt.target.model.gpr_width           = 8;
            tgt.target.model.gp_unaligned_widths = 14;
            var f: lang_mir.MirFunction;
            fin { lang_mir.dnit_function(?alloc, ?f); }
            var ctx: mir_context.LowerCtx;
            ctx.alloc = ?alloc;
            var convention: abi.AbiVTable = target_testing.carriers_convention();
            tgt.abi = ?convention;
            ctx.tgt = ?tgt;
            ctx.f   = ?f;
            val t_setup_r: err[fail.Fail] = t_setup(?ctx, sizes[si], mode == 1);
            if (sel t_setup_r.err) { ret 2; }
            f.blocks[0].instrs[0].memory_flags = 0;
            val expand_r: err[fail.Fail] = expand(?ctx);
            if (sel expand_r.err) { ret 3; }
            var bi: u32 = 0;
            for (bi < f.block_count) {
                val block: *lang_mir.MirBlock = ?f.blocks[bi];
                var ii:    u32                = 0;
                for (ii < block.instr_count) {
                    val mi: *lang_mir.MirInstr = ?block.instrs[ii];
                    if (mi.opcode == lang_mir.MIR_LOAD
                        && (!mi.writes_secret || !f.vregs[mi.operands[0].vreg.n].secret)) { ret 4; }
                    if (mi.opcode == lang_mir.MIR_STORE && !mi.writes_secret) { ret 5; }
                    ii = ii + 1;
                }
                bi = bi + 1;
            }
            si = si + 1;
        }
        mode = mode + 1;
    }
    ret 0;
}
