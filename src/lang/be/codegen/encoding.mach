use mir_debug: mach.lang.mir.debug;
use mach.lang.intern;
use target_of: mach.lang.target.of;

pub rec EncoderOutput {
    text:            *u8;
    text_len:        u32;
    relocations:     *PendingReloc;
    reloc_count:     u32;
    symbols:         *SymbolMark;
    symbol_count:    u32;
    rows:            *mir_debug.LineRow;
    row_count:       u32;
    varlocs:         *mir_debug.VarLoc;
    varloc_count:    u32;
    inline_pcs:      *mir_debug.InlinePc;
    inline_pc_count: u32;
    consts:          *ConstEntry;
    const_count:     u32;
    frames:          *target_of.FrameUnwind;
    frame_count:     u32;
    # instruction notifications the sink recorded, 0 when no stream was attached
    notified: u32;
}

pub rec PendingReloc {
    offset: u32;
    kind:   target_of.RelocKind;
    sym:    intern.StrId;
    addend: i64;
    pair:   u32;
    # bytes from the field's start to the end of its instruction, 0 when unknown
    inst_end: u8;
    origin:   target_of.RelocOrigin;
}

pub rec SymbolMark {
    name:   intern.StrId;
    offset: u32;
    size:   u32;
    flags:  u32;
}

pub val CONST_F32: u8 = 1;
pub val CONST_F64: u8 = 2;
pub val CONST_VEC: u8 = 3;

pub rec ConstEntry {
    bytes: *u8;
    len:   u32;
    align: u32;
    kind:  u8;
    sym:   intern.StrId;
}
