use std.types.bool.bool;

use mach.lang.intern;
use mach.lang.be.codegen.debug_input;
use mach.lang.target.of;

pub rec EncoderOutput {
    text:         *u8;
    text_len:     u32;
    relocations:  *PendingReloc;
    reloc_count:  u32;
    symbols:      *SymbolMark;
    symbol_count: u32;
    rows:         *LineRow;
    row_count:    u32;
    varlocs:      *VarLoc;
    varloc_count: u32;
    inline_pcs:   *InlinePc;
    inline_pc_count: u32;
    consts:       *ConstEntry;
    const_count:  u32;
    frames:       *of.FrameUnwind;
    frame_count:  u32;
}

pub def LineRow: debug_input.LineRow;
pub def InlinePc: debug_input.InlinePc;
pub def VarLoc: debug_input.VarLoc;

pub val VARLOC_NONE:  u8 = 0;
pub val VARLOC_REG:   u8 = 1;
pub val VARLOC_FRAME: u8 = 2;
pub val VARLOC_CMP:   u8 = 3;
pub val VARLOC_IMM:   u8 = 4;

pub val CMPREL_EQ: u8 = 0;
pub val CMPREL_NE: u8 = 1;
pub val CMPREL_LT: u8 = 2;
pub val CMPREL_LE: u8 = 3;

pub rec PendingReloc {
    offset: u32;
    kind:   of.RelocKind;
    sym:    intern.StrId;
    addend: i32;
    pair:   u32;
}

pub rec SymbolMark {
    name:   intern.StrId;
    offset: u32;
    size:   u32;
    flags:  u32;
}

pub val CONST_F32: u8 = 1;
pub val CONST_F64: u8 = 2;
pub val CONST_VEC: u8 = 3;

pub rec ConstEntry {
    bytes: *u8;
    len:   u32;
    align: u32;
    kind:  u8;
    sym:   intern.StrId;
}
