use mach.lang.fail;
use std.allocator.arena;
use std.allocator.page;
use std.collections.sort;
use std.format;
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;

use mach.lang.be.codegen.mir;
use mach.lang.be.codegen.rules;
use mach.lang.intern;
use mach.lang.layout;
use mach.lang.source;
use mach.lang.target;
use mach.lang.target.abi;
use mach.lang.target.isa;
use mach.lang.target.isa.riscv;
use tos:            mach.lang.target.os;
use target_view:    mach.lang.target.resolved;
use target_testing: mach.lang.target.testing;

pub val REG_CLASS_GP: u32 = 0;

val RANGE_NIL: u32 = 0xFFFFFFFF;
val POS_MAX:   i64 = 0x7FFFFFFFFFFFFFFF;

rec FlatInstr {
    block:   u32;
    instr:   u32;
    is_call: bool;
}

rec LiveRange {
    vreg:         u32;
    start:        i64;
    end_pos:      i64;
    use_count:    u32;
    reg_class:    u32;
    crosses_call: bool;
}

rec BlockSpan {
    start: i64;
    end:   i64;
}

rec CopyHint {
    src_vreg:     u32;
    src_preg:     i32;
    copy_pos:     i64;
    dst_vreg:     u32;
    dst_copy_pos: i64;
    sink_preg:    i32;
}

rec AllocCtx {
    alloc:                *A.Allocator;
    interner:             *intern.Interner;
    f:                    *mir.MirFunction;
    flat:                 *FlatInstr;
    flat_count:           u32;
    order:                *u32;
    ranges:               *LiveRange;
    gp_count:             u32;
    fp_count:             u32;
    spill_width:          u8;
    callee_saved:         *bool;
    fp_callee_saved:      *bool;
    reserved:             *bool;
    gp_busy:              *bool;
    fp_busy:              *bool;
    fp_pinned_end:        *i64;
    active:               *u32;
    active_count:         u32;
    pinned_end:           *i64;
    param_reg_end:        *i64;
    arg_res_reg:          *u32;
    arg_res_start:        *i64;
    arg_res_end:          *i64;
    arg_res_count:        u32;
    def_res_reg:          *u32;
    def_res_pos:          *i64;
    def_res_count:        u32;
    cur_start:            i64;
    cur_end:              i64;
    reload_scratch:       *isa.Register;
    reload_scratch_count: i32;
    block_id_index:       *u32;
    block_id_index_cap:   u32;
    block_spans:          *BlockSpan;
    vreg_slot_flag:       *bool;
    hints:                *CopyHint;
    anchor_until:         *i64;
}

fun ctx_fn_name(ctx: *AllocCtx) str {
    if (ctx.interner == nil) { ret "<unknown>"; }
    val nm: opt[str] = intern.lookup(ctx.interner, ctx.f.name);
    if (sel nm.some) { ret nm.some; }
    ret "<unknown>";
}

fun regalloc_msg(ctx: *AllocCtx, prefix: str, suffix: str, fallback: str) str {
    val name:    str                          = ctx_fn_name(ctx);
    val res_msg: res[str, format.FormatError] = format.sprint(ctx.alloc, "{}{}{}", prefix, name, suffix);
    if (sel res_msg.err) { ret fallback; }
    val buf: str                        = res_msg.ok;
    val ir:  res[intern.StrId, A.Error] = intern.intern(ctx.interner, buf);
    A.deallocate[u8](ctx.alloc, buf, str_len(buf) + 1);
    if (sel ir.err) { ret fallback; }
    val lo: opt[str] = intern.lookup(ctx.interner, ir.ok);
    if (sel lo.some) { ret lo.some; }
    ret fallback;
}

pub fun run(tgt: *target.Target, m: *mir.MirModule) err[fail.Fail] {
    if (tgt == nil)      { ret err[fail.Fail].err{fail.message("regalloc.run: nil target")}; }
    if (m == nil)        { ret err[fail.Fail].err{fail.message("regalloc.run: nil mir module")}; }
    if (tgt.abi == nil)  { ret err[fail.Fail].err{fail.message("regalloc.run: target has no ABI vtable")}; }
    if (tgt.arch == nil) { ret err[fail.Fail].err{fail.message("regalloc.run: target has no ISA vtable")}; }
    if (tgt.abi.callee_saved == nil) {
        ret err[fail.Fail].err{fail.message("regalloc.run: ABI vtable exposes no callee-saved register file")};
    }

    val input: err[fail.Fail] = mir.validate_operands(m);
    if (sel input.err) { ret input; }
    val model: err[fail.Fail] = validate_register_model(tgt, m);
    if (sel model.err) { ret model; }
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val classes: err[fail.Fail] = validate_vreg_classes(tgt, m, ?m.functions[fi]);
        if (sel classes.err) { ret classes; }
        val af: err[fail.Fail] = alloc_function(tgt, m, ?m.functions[fi]);
        if (sel af.err) { ret af; }
        fi = fi + 1;
    }
    ret mir.validate_operands(m);
}

fun validate_register_model(tgt: *target.Target, m: *mir.MirModule) err[fail.Fail] {
    if (tgt.model.reg_class_len == 0 || tgt.model.reg_classes == nil) {
        ret err[fail.Fail].err{fail.message("regalloc: target has no register class model")};
    }
    var ci: u32 = 0;
    for (ci < tgt.model.reg_class_len) {
        val kind: isa.RegClassKind = tgt.model.reg_classes[ci].kind;
        if (kind > isa.RC_FLAGS) { ret mir.catalog_failure(m, "RegClassKind", kind::u32); }
        if ((ci == REG_CLASS_GP) != (kind == isa.RC_GENERAL)) {
            ret err[fail.Fail].err{fail.message("regalloc: target general register class does not match the MIR general bank")};
        }
        ci = ci + 1;
    }
    ret err[fail.Fail].ok{};
}

fun validate_vreg_classes(tgt: *target.Target, m: *mir.MirModule, f: *mir.MirFunction) err[fail.Fail] {
    var vi: u32 = 0;
    for (vi < f.vreg_count) {
        val class: u32 = f.vregs[vi].class;
        if (class >= tgt.model.reg_class_len) { ret mir.catalog_failure(m, "MirRegisterClass", class); }
        val kind: isa.RegClassKind = tgt.model.reg_classes[class].kind;
        if (kind == isa.RC_VECTOR || kind == isa.RC_FLAGS) {
            ret err[fail.Fail].err{fail.message("regalloc: declared target register class is unsupported for MIR virtual registers")};
        }
        vi = vi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun fp_class_index(tgt: *target.Target) u32 {
    var ci: u32 = 0;
    for (ci < tgt.model.reg_class_len) {
        if (tgt.model.reg_classes[ci].kind == isa.RC_FLOAT) { ret ci; }
        ci = ci + 1;
    }
    ret RANGE_NIL;
}

fun bank_count(tgt: *target.Target, class: u32) u32 {
    if (class >= tgt.model.reg_class_len) { ret 0; }
    ret tgt.model.reg_classes[class].len;
}

fun alloc_function(tgt: *target.Target, m: *mir.MirModule, f: *mir.MirFunction) err[fail.Fail] {
    if (f.block_count == 0) { ret err[fail.Fail].ok{}; }
    if (f.vreg_count == 0) {
        f.callee_mask = asm_callee_mask(tgt, f);
        val fp_scratch: u32 = fp_scratch_callee_mask(tgt);
        if (fp_scratch != 0 && function_uses_fp_scratch(f)) {
            f.callee_mask_fp = fp_scratch;
        }
        ret verify_rewritten_operands(tgt, f);
    }

    var ctx: AllocCtx;
    val ic:  err[fail.Fail] = ctx_init(?ctx, tgt, m, f);
    if (sel ic.err) { ret ic; }

    if (function_has_divide(?ctx)) {
        reserve_reg(?ctx, tgt.arch.div_reg);
        reserve_reg(?ctx, tgt.arch.div_hi_reg);
    }

    if (function_has_reg_shift(?ctx)) {
        reserve_reg(?ctx, tgt.arch.shift_count_reg);
    }

    val vs: err[fail.Fail] = build_vreg_slot_flags(?ctx);
    if (sel vs.err) {
        ctx_dnit(?ctx);
        ret vs;
    }

    val ds: err[fail.Fail] = sweep_dead_movs(tgt, ?ctx);
    if (sel ds.err) {
        ctx_dnit(?ctx);
        ret ds;
    }

    val cc: err[fail.Fail] = coalesce_copies(tgt, ?ctx);
    if (sel cc.err) {
        ctx_dnit(?ctx);
        ret cc;
    }

    val bo: err[fail.Fail] = build_order(?ctx);
    if (sel bo.err) {
        ctx_dnit(?ctx);
        ret bo;
    }

    val ao: err[fail.Fail] = apply_order(?ctx);
    if (sel ao.err) {
        ctx_dnit(?ctx);
        ret ao;
    }

    val fl: err[fail.Fail] = flatten(?ctx);
    if (sel fl.err) {
        ctx_dnit(?ctx);
        ret fl;
    }

    val bs: err[fail.Fail] = build_block_spans(?ctx);
    if (sel bs.err) {
        ctx_dnit(?ctx);
        ret bs;
    }

    build_ranges(?ctx);

    val lv: err[fail.Fail] = extend_liveness(?ctx);
    if (sel lv.err) {
        ctx_dnit(?ctx);
        ret lv;
    }

    val mc: err[fail.Fail] = mark_call_crossing(?ctx);
    if (sel mc.err) {
        ctx_dnit(?ctx);
        ret mc;
    }

    build_hints(tgt, ?ctx);

    val sc: err[fail.Fail] = linear_scan(tgt, ?ctx);
    if (sel sc.err) {
        ctx_dnit(?ctx);
        ret sc;
    }

    val sp: err[fail.Fail] = spill_across_calls(tgt, ?ctx);
    if (sel sp.err) {
        ctx_dnit(?ctx);
        ret sp;
    }

    val rw: err[fail.Fail] = rewrite(tgt, ?ctx);
    if (sel rw.err) {
        ctx_dnit(?ctx);
        ret rw;
    }

    val vf: err[fail.Fail] = verify_allocation(tgt, ?ctx);
    if (sel vf.err) {
        ctx_dnit(?ctx);
        ret vf;
    }

    val vo: err[fail.Fail] = verify_rewritten_operands(tgt, ctx.f);
    if (sel vo.err) {
        ctx_dnit(?ctx);
        ret vo;
    }

    drop_self_copies_physical(tgt, ?ctx);
    record_callee_mask(tgt, ?ctx);

    val ro: err[fail.Fail] = restore_order(?ctx);
    if (sel ro.err) {
        ctx_dnit(?ctx);
        ret ro;
    }

    ctx_dnit(?ctx);
    ret err[fail.Fail].ok{};
}

fun ctx_init(ctx: *AllocCtx, tgt: *target.Target, m: *mir.MirModule, f: *mir.MirFunction) err[fail.Fail] {
    ctx.alloc                = m.alloc;
    ctx.interner             = m.interner;
    ctx.f                    = f;
    ctx.flat                 = nil;
    ctx.flat_count           = 0;
    ctx.order                = nil;
    ctx.ranges               = nil;
    ctx.gp_count             = bank_count(tgt, REG_CLASS_GP);
    ctx.fp_count             = bank_count(tgt, fp_class_index(tgt));
    ctx.spill_width          = tgt.model.spill_width::u8;
    ctx.callee_saved         = nil;
    ctx.fp_callee_saved      = nil;
    ctx.reserved             = nil;
    ctx.gp_busy              = nil;
    ctx.fp_busy              = nil;
    ctx.fp_pinned_end        = nil;
    ctx.active               = nil;
    ctx.active_count         = 0;
    ctx.pinned_end           = nil;
    ctx.param_reg_end        = nil;
    ctx.arg_res_reg          = nil;
    ctx.arg_res_start        = nil;
    ctx.arg_res_end          = nil;
    ctx.arg_res_count        = 0;
    ctx.def_res_reg          = nil;
    ctx.def_res_pos          = nil;
    ctx.def_res_count        = 0;
    ctx.cur_start            = 0;
    ctx.cur_end              = 0;
    ctx.reload_scratch       = tgt.arch.reload_scratch_regs;
    ctx.reload_scratch_count = tgt.arch.reload_scratch_count;
    ctx.block_id_index       = nil;
    ctx.block_id_index_cap   = 0;
    ctx.block_spans          = nil;
    ctx.vreg_slot_flag       = nil;
    ctx.hints                = nil;
    ctx.anchor_until         = nil;

    val ro: res[*u32, A.Error] = A.allocate[u32](m.alloc, f.block_count::usize);
    if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
    ctx.order = ro.ok;

    val rr: res[*LiveRange, A.Error] = A.allocate[LiveRange](m.alloc, f.vreg_count::usize);
    if (sel rr.err) {
        ctx_dnit(ctx);
        ret err[fail.Fail].err{fail.refused(rr.err)};
    }
    ctx.ranges = rr.ok;

    var vi: u32 = 0;
    for (vi < f.vreg_count) {
        ctx.ranges[vi].vreg         = vi;
        ctx.ranges[vi].start        = POS_MAX;
        ctx.ranges[vi].end_pos      = -1;
        ctx.ranges[vi].use_count    = 0;
        ctx.ranges[vi].reg_class    = f.vregs[vi].class;
        ctx.ranges[vi].crosses_call = false;
        vi                          = vi + 1;
    }

    if (ctx.gp_count > 0) {
        val rcs: res[*bool, A.Error] = A.allocate[bool](m.alloc, ctx.gp_count::usize);
        if (sel rcs.err) {
            ctx_dnit(ctx);
            ret err[fail.Fail].err{fail.refused(rcs.err)};
        }
        ctx.callee_saved = rcs.ok;
        val rrv: res[*bool, A.Error] = A.allocate[bool](m.alloc, ctx.gp_count::usize);
        if (sel rrv.err) {
            ctx_dnit(ctx);
            ret err[fail.Fail].err{fail.refused(rrv.err)};
        }
        ctx.reserved = rrv.ok;
        val rgb: res[*bool, A.Error] = A.allocate[bool](m.alloc, ctx.gp_count::usize);
        if (sel rgb.err) {
            ctx_dnit(ctx);
            ret err[fail.Fail].err{fail.refused(rgb.err)};
        }
        ctx.gp_busy = rgb.ok;
        val rpe: res[*i64, A.Error] = A.allocate[i64](m.alloc, ctx.gp_count::usize);
        if (sel rpe.err) {
            ctx_dnit(ctx);
            ret err[fail.Fail].err{fail.refused(rpe.err)};
        }
        ctx.pinned_end = rpe.ok;
        val rpr: res[*i64, A.Error] = A.allocate[i64](m.alloc, ctx.gp_count::usize);
        if (sel rpr.err) {
            ctx_dnit(ctx);
            ret err[fail.Fail].err{fail.refused(rpr.err)};
        }
        ctx.param_reg_end = rpr.ok;

        var gi: u32 = 0;
        for (gi < ctx.gp_count) {
            ctx.callee_saved[gi]  = false;
            ctx.reserved[gi]      = false;
            ctx.gp_busy[gi]       = false;
            ctx.pinned_end[gi]    = -1;
            ctx.param_reg_end[gi] = -1;
            gi                    = gi + 1;
        }

        seed_reserved(tgt, ctx);
    }

    if (ctx.fp_count > 0) {
        val rfb: res[*bool, A.Error] = A.allocate[bool](m.alloc, ctx.fp_count::usize);
        if (sel rfb.err) {
            ctx_dnit(ctx);
            ret err[fail.Fail].err{fail.refused(rfb.err)};
        }
        ctx.fp_busy = rfb.ok;
        val rfp: res[*i64, A.Error] = A.allocate[i64](m.alloc, ctx.fp_count::usize);
        if (sel rfp.err) {
            ctx_dnit(ctx);
            ret err[fail.Fail].err{fail.refused(rfp.err)};
        }
        ctx.fp_pinned_end = rfp.ok;
        val rfc: res[*bool, A.Error] = A.allocate[bool](m.alloc, ctx.fp_count::usize);
        if (sel rfc.err) {
            ctx_dnit(ctx);
            ret err[fail.Fail].err{fail.refused(rfc.err)};
        }
        ctx.fp_callee_saved = rfc.ok;
        var fii: u32 = 0;
        for (fii < ctx.fp_count) {
            ctx.fp_busy[fii]         = false;
            ctx.fp_pinned_end[fii]   = -1;
            ctx.fp_callee_saved[fii] = false;
            fii                      = fii + 1;
        }
    }

    seed_callee_saved(tgt, ctx);

    val ra: res[*u32, A.Error] = A.allocate[u32](m.alloc, f.vreg_count::usize);
    if (sel ra.err) {
        ctx_dnit(ctx);
        ret err[fail.Fail].err{fail.refused(ra.err)};
    }
    ctx.active = ra.ok;

    val rh: res[*CopyHint, A.Error] = A.allocate[CopyHint](m.alloc, f.vreg_count::usize);
    if (sel rh.err) {
        ctx_dnit(ctx);
        ret err[fail.Fail].err{fail.refused(rh.err)};
    }
    ctx.hints = rh.ok;
    var hi: u32 = 0;
    for (hi < f.vreg_count) {
        ctx.hints[hi].src_vreg     = mir.MIR_VREG_NIL.n;
        ctx.hints[hi].src_preg     = -1;
        ctx.hints[hi].copy_pos     = -1;
        ctx.hints[hi].dst_vreg     = mir.MIR_VREG_NIL.n;
        ctx.hints[hi].dst_copy_pos = -1;
        ctx.hints[hi].sink_preg    = -1;
        hi                         = hi + 1;
    }

    val rau: res[*i64, A.Error] = A.allocate[i64](m.alloc, f.vreg_count::usize);
    if (sel rau.err) {
        ctx_dnit(ctx);
        ret err[fail.Fail].err{fail.refused(rau.err)};
    }
    ctx.anchor_until = rau.ok;
    var ai: u32 = 0;
    for (ai < f.vreg_count) {
        ctx.anchor_until[ai] = -1;
        ai                   = ai + 1;
    }

    ret err[fail.Fail].ok{};
}

fun ctx_dnit(ctx: *AllocCtx) {
    if (ctx.flat != nil && ctx.flat_count > 0) {
        A.deallocate[FlatInstr](ctx.alloc, ctx.flat, ctx.flat_count::usize);
        ctx.flat = nil;
    }
    if (ctx.order != nil) {
        A.deallocate[u32](ctx.alloc, ctx.order, ctx.f.block_count::usize);
        ctx.order = nil;
    }
    if (ctx.ranges != nil) {
        A.deallocate[LiveRange](ctx.alloc, ctx.ranges, ctx.f.vreg_count::usize);
        ctx.ranges = nil;
    }
    if (ctx.callee_saved != nil) {
        A.deallocate[bool](ctx.alloc, ctx.callee_saved, ctx.gp_count::usize);
        ctx.callee_saved = nil;
    }
    if (ctx.fp_callee_saved != nil) {
        A.deallocate[bool](ctx.alloc, ctx.fp_callee_saved, ctx.fp_count::usize);
        ctx.fp_callee_saved = nil;
    }
    if (ctx.reserved != nil) {
        A.deallocate[bool](ctx.alloc, ctx.reserved, ctx.gp_count::usize);
        ctx.reserved = nil;
    }
    if (ctx.gp_busy != nil) {
        A.deallocate[bool](ctx.alloc, ctx.gp_busy, ctx.gp_count::usize);
        ctx.gp_busy = nil;
    }
    if (ctx.pinned_end != nil) {
        A.deallocate[i64](ctx.alloc, ctx.pinned_end, ctx.gp_count::usize);
        ctx.pinned_end = nil;
    }
    if (ctx.param_reg_end != nil) {
        A.deallocate[i64](ctx.alloc, ctx.param_reg_end, ctx.gp_count::usize);
        ctx.param_reg_end = nil;
    }
    if (ctx.arg_res_reg != nil && ctx.flat_count > 0) {
        A.deallocate[u32](ctx.alloc, ctx.arg_res_reg, ctx.flat_count::usize);
        ctx.arg_res_reg = nil;
    }
    if (ctx.arg_res_start != nil && ctx.flat_count > 0) {
        A.deallocate[i64](ctx.alloc, ctx.arg_res_start, ctx.flat_count::usize);
        ctx.arg_res_start = nil;
    }
    if (ctx.arg_res_end != nil && ctx.flat_count > 0) {
        A.deallocate[i64](ctx.alloc, ctx.arg_res_end, ctx.flat_count::usize);
        ctx.arg_res_end = nil;
    }
    if (ctx.def_res_reg != nil && ctx.flat_count > 0) {
        A.deallocate[u32](ctx.alloc, ctx.def_res_reg, ctx.flat_count::usize);
        ctx.def_res_reg = nil;
    }
    if (ctx.def_res_pos != nil && ctx.flat_count > 0) {
        A.deallocate[i64](ctx.alloc, ctx.def_res_pos, ctx.flat_count::usize);
        ctx.def_res_pos = nil;
    }
    if (ctx.fp_busy != nil) {
        A.deallocate[bool](ctx.alloc, ctx.fp_busy, ctx.fp_count::usize);
        ctx.fp_busy = nil;
    }
    if (ctx.fp_pinned_end != nil) {
        A.deallocate[i64](ctx.alloc, ctx.fp_pinned_end, ctx.fp_count::usize);
        ctx.fp_pinned_end = nil;
    }
    if (ctx.active != nil) {
        A.deallocate[u32](ctx.alloc, ctx.active, ctx.f.vreg_count::usize);
        ctx.active = nil;
    }
    if (ctx.block_id_index != nil && ctx.block_id_index_cap > 0) {
        A.deallocate[u32](ctx.alloc, ctx.block_id_index, ctx.block_id_index_cap::usize);
        ctx.block_id_index = nil;
    }
    if (ctx.block_spans != nil && ctx.f.block_count > 0) {
        A.deallocate[BlockSpan](ctx.alloc, ctx.block_spans, ctx.f.block_count::usize);
        ctx.block_spans = nil;
    }
    if (ctx.vreg_slot_flag != nil && ctx.f.vreg_count > 0) {
        A.deallocate[bool](ctx.alloc, ctx.vreg_slot_flag, ctx.f.vreg_count::usize);
        ctx.vreg_slot_flag = nil;
    }
    if (ctx.hints != nil && ctx.f.vreg_count > 0) {
        A.deallocate[CopyHint](ctx.alloc, ctx.hints, ctx.f.vreg_count::usize);
        ctx.hints = nil;
    }
    if (ctx.anchor_until != nil && ctx.f.vreg_count > 0) {
        A.deallocate[i64](ctx.alloc, ctx.anchor_until, ctx.f.vreg_count::usize);
        ctx.anchor_until = nil;
    }
}

val MAX_REG_FILE: i32 = 32;

fun reserve_reg(ctx: *AllocCtx, id: i32) {
    if (id < 0)                  { ret; }
    if (id::u32 >= ctx.gp_count) { ret; }
    ctx.reserved[id::u32] = true;
}

fun seed_callee_saved(tgt: *target.Target, ctx: *AllocCtx) {
    var regs: [32]isa.Register;
    val fill: abi.RegFileFn = tgt.abi.callee_saved;
    val n:    i32           = fill(?regs[0]);
    var i:    i32           = 0;
    for (i < n && i < MAX_REG_FILE) {
        val id: i32 = regs[i].id;
        if (isa.regid_class(id) == isa.REG_CLASS_ID_GP) {
            if (ctx.callee_saved != nil && id >= 0 && id::u32 < ctx.gp_count) {
                ctx.callee_saved[id::u32] = true;
            }
        }
        or {
            val idx: i32 = isa.regid_index(id);
            if (ctx.fp_callee_saved != nil && idx >= 0 && idx::u32 < ctx.fp_count) {
                ctx.fp_callee_saved[idx::u32] = true;
            }
        }
        i = i + 1;
    }
}

fun seed_reserved(tgt: *target.Target, ctx: *AllocCtx) {
    var i: i32 = 0;
    for (i < tgt.arch.reserved_reg_count && i < MAX_REG_FILE) {
        reserve_reg(ctx, tgt.arch.reserved_regs[i].id);
        i = i + 1;
    }
    var j: i32 = 0;
    for (j < tgt.arch.reload_scratch_count && j < MAX_REG_FILE) {
        reserve_reg(ctx, tgt.arch.reload_scratch_regs[j].id);
        j = j + 1;
    }
    reserve_reg(ctx, tgt.arch.scratch_reg);
    reserve_reg(ctx, tgt.arch.scratch_reg2);

    val platform_mask: u32 = tos.reserved_gp_for(tgt.os, tgt.isa.id);
    var pr:            i32 = 0;
    for (pr < 32) {
        if ((platform_mask & (1::u32 << pr::u32)) != 0) { reserve_reg(ctx, pr); }
        pr = pr + 1;
    }
}

fun function_has_divide(ctx: *AllocCtx) bool {
    val f:  *mir.MirFunction = ctx.f;
    var bi: u32              = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val o: mir.MirOpcode = blk.instrs[ii].opcode;
            if (mir.has(o, mir.MIRF_SEL_DIVIDE)) { ret true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

fun function_has_reg_shift(ctx: *AllocCtx) bool {
    val f:  *mir.MirFunction = ctx.f;
    var bi: u32              = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            val o:  mir.MirOpcode = mi.opcode;
            if (mir.has(o, mir.MIRF_SEL_SHIFT)) {
                if (mi.operand_count >= 3 && mi.operands[2].kind == mir.MIR_OP_PREG) {
                    ret true;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

fun build_order(ctx: *AllocCtx) err[fail.Fail] {
    val f: *mir.MirFunction = ctx.f;
    val n: u32              = f.block_count;

    val bx: err[fail.Fail] = fill_block_id_index(ctx);
    if (sel bx.err) { ret bx; }

    val rv: res[*bool, A.Error] = A.allocate[bool](ctx.alloc, n::usize);
    if (sel rv.err) { ret err[fail.Fail].err{fail.refused(rv.err)}; }
    val visited: *bool = rv.ok;
    var i:       u32   = 0;
    for (i < n) {
        visited[i] = false;
        i          = i + 1;
    }

    val rs: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, n::usize);
    if (sel rs.err) {
        A.deallocate[bool](ctx.alloc, visited, n::usize);
        ret err[fail.Fail].err{fail.refused(rs.err)};
    }
    val stack: *u32               = rs.ok;
    val re:    res[*u32, A.Error] = A.allocate[u32](ctx.alloc, n::usize);
    if (sel re.err) {
        A.deallocate[bool](ctx.alloc, visited, n::usize);
        A.deallocate[u32](ctx.alloc, stack, n::usize);
        ret err[fail.Fail].err{fail.refused(re.err)};
    }
    val succ_ix: *u32 = re.ok;

    val rp: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, n::usize);
    if (sel rp.err) {
        A.deallocate[bool](ctx.alloc, visited, n::usize);
        A.deallocate[u32](ctx.alloc, stack, n::usize);
        A.deallocate[u32](ctx.alloc, succ_ix, n::usize);
        ret err[fail.Fail].err{fail.refused(rp.err)};
    }
    val post:       *u32 = rp.ok;
    var post_count: u32  = 0;

    var sp: u32 = 0;
    stack[sp]   = 0;
    succ_ix[sp] = 0;
    visited[0]  = true;
    sp          = sp + 1;

    for (sp > 0) {
        val top:  u32 = sp - 1;
        val b:    u32 = stack[top];
        val next: u32 = next_unvisited_succ(ctx, b, ?succ_ix[top], visited);
        if (next == RANGE_NIL) {
            post[post_count] = b;
            post_count       = post_count + 1;
            sp               = sp - 1;
        }
        or {
            visited[next] = true;
            stack[sp]     = next;
            succ_ix[sp]   = 0;
            sp            = sp + 1;
        }
    }

    var oi: u32 = 0;
    var k:  u32 = post_count;
    for (k > 0) {
        k             = k - 1;
        ctx.order[oi] = post[k];
        oi            = oi + 1;
    }
    var bi: u32 = 0;
    for (bi < n) {
        if (!visited[bi]) {
            ctx.order[oi] = bi;
            oi            = oi + 1;
        }
        bi = bi + 1;
    }

    A.deallocate[bool](ctx.alloc, visited, n::usize);
    A.deallocate[u32](ctx.alloc, stack, n::usize);
    A.deallocate[u32](ctx.alloc, succ_ix, n::usize);
    A.deallocate[u32](ctx.alloc, post, n::usize);
    ret err[fail.Fail].ok{};
}

fun next_unvisited_succ(ctx: *AllocCtx, b: u32, six: *u32, visited: *bool) u32 {
    val f:   *mir.MirFunction = ctx.f;
    val blk: *mir.MirBlock    = ?f.blocks[b];
    if (blk.instr_count == 0) { ret RANGE_NIL; }

    val term: *mir.MirInstr = ?blk.instrs[blk.instr_count - 1];
    for (@six < term.operand_count) {
        val op: *mir.MirOperand = ?term.operands[@six];
        @six = @six + 1;
        if (op.kind == mir.MIR_OP_BLOCK) {
            val tgt_idx: u32 = block_index_of(ctx, op.imm::u32);
            if (tgt_idx != RANGE_NIL && !visited[tgt_idx]) {
                ret tgt_idx;
            }
        }
    }
    ret RANGE_NIL;
}

fun fill_block_id_index(ctx: *AllocCtx) err[fail.Fail] {
    val f: *mir.MirFunction = ctx.f;
    val n: u32              = f.block_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    if (ctx.block_id_index == nil) {
        var max_id: u32 = 0;
        var i:      u32 = 0;
        for (i < n) {
            if (f.blocks[i].id > max_id) { max_id = f.blocks[i].id; }
            i = i + 1;
        }
        val cap: u32                = max_id + 1;
        val r:   res[*u32, A.Error] = A.allocate[u32](ctx.alloc, cap::usize);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        ctx.block_id_index     = r.ok;
        ctx.block_id_index_cap = cap;
    }

    var j: u32 = 0;
    for (j < ctx.block_id_index_cap) {
        ctx.block_id_index[j] = RANGE_NIL;
        j                     = j + 1;
    }
    var k: u32 = 0;
    for (k < n) {
        ctx.block_id_index[f.blocks[k].id] = k;
        k                                  = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun block_index_of(ctx: *AllocCtx, bid: u32) u32 {
    if (bid >= ctx.block_id_index_cap) { ret RANGE_NIL; }
    ret ctx.block_id_index[bid];
}

fun apply_order(ctx: *AllocCtx) err[fail.Fail] {
    val f: *mir.MirFunction = ctx.f;
    val n: u32              = f.block_count;
    if (n <= 1) { ret err[fail.Fail].ok{}; }

    val rt: res[*mir.MirBlock, A.Error] = A.allocate[mir.MirBlock](ctx.alloc, n::usize);
    if (sel rt.err) { ret err[fail.Fail].err{fail.refused(rt.err)}; }
    val tmp: *mir.MirBlock = rt.ok;

    var i: u32 = 0;
    for (i < n) {
        tmp[i] = f.blocks[ctx.order[i]];
        i      = i + 1;
    }
    i = 0;
    for (i < n) {
        f.blocks[i] = tmp[i];
        i           = i + 1;
    }
    A.deallocate[mir.MirBlock](ctx.alloc, tmp, n::usize);

    ret fill_block_id_index(ctx);
}

fun restore_order(ctx: *AllocCtx) err[fail.Fail] {
    val f: *mir.MirFunction = ctx.f;
    val n: u32              = f.block_count;
    if (n <= 1) { ret err[fail.Fail].ok{}; }

    val rt: res[*mir.MirBlock, A.Error] = A.allocate[mir.MirBlock](ctx.alloc, n::usize);
    if (sel rt.err) { ret err[fail.Fail].err{fail.refused(rt.err)}; }
    val tmp: *mir.MirBlock = rt.ok;

    var i: u32 = 0;
    for (i < n) {
        tmp[ctx.order[i]] = f.blocks[i];
        i                 = i + 1;
    }
    i = 0;
    for (i < n) {
        f.blocks[i] = tmp[i];
        i           = i + 1;
    }
    A.deallocate[mir.MirBlock](ctx.alloc, tmp, n::usize);

    ret err[fail.Fail].ok{};
}

fun flatten(ctx: *AllocCtx) err[fail.Fail] {
    val f:     *mir.MirFunction = ctx.f;
    var total: u32              = 0;
    var bi:    u32              = 0;
    for (bi < f.block_count) {
        total = total + f.blocks[bi].instr_count;
        bi    = bi + 1;
    }
    ctx.flat_count = total;
    if (total == 0) {
        ctx.flat = nil;
        ret err[fail.Fail].ok{};
    }

    val rf: res[*FlatInstr, A.Error] = A.allocate[FlatInstr](ctx.alloc, total::usize);
    if (sel rf.err) {
        ctx.flat       = nil;
        ctx.flat_count = 0;
        ret err[fail.Fail].err{fail.refused(rf.err)};
    }
    ctx.flat = rf.ok;

    var p: u32 = 0;
    bi = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            ctx.flat[p].block   = bi;
            ctx.flat[p].instr   = ii;
            ctx.flat[p].is_call = blk.instrs[ii].opcode == mir.MIR_CALL
                || blk.instrs[ii].asm_block != nil;
            p  = p + 1;
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun flat_instr(ctx: *AllocCtx, pos: u32) *mir.MirInstr {
    val fi: *FlatInstr = ?ctx.flat[pos];
    ret ?ctx.f.blocks[fi.block].instrs[fi.instr];
}

fun touch(ctx: *AllocCtx, v: mir.VRegId, pos: u32) {
    if (v.n >= ctx.f.vreg_count) {
        panic("regalloc: out-of-range vreg id in a MIR operand\n");
    }
    val lr: *LiveRange = ?ctx.ranges[v.n];
    if (pos::i64 < lr.start)   { lr.start = pos::i64; }
    if (pos::i64 > lr.end_pos) { lr.end_pos = pos::i64; }
    lr.use_count = lr.use_count + 1;
}

fun build_ranges(ctx: *AllocCtx) {
    var pos: u32 = 0;
    for (pos < ctx.flat_count) {
        val mi: *mir.MirInstr = flat_instr(ctx, pos);
        var k:  u32           = 0;
        for (k < mi.operand_count) {
            val op: *mir.MirOperand = ?mi.operands[k];
            if (op.kind == mir.MIR_OP_VREG) {
                touch(ctx, op.vreg, pos);
            }
            or (op.kind == mir.MIR_OP_MEM && !mir.vreg_is_nil(op.vreg)) {
                touch(ctx, op.vreg, pos);
            }
            if (sel op.index.vreg) {
                touch(ctx, op.index.vreg, pos);
            }
            k = k + 1;
        }
        pos = pos + 1;
    }
}

fun isa_is_reg_move(tgt: *target.Target, opcode: u32) bool {
    if (tgt.arch.is_reg_move == nil) { ret false; }
    ret tgt.arch.is_reg_move(opcode);
}

fun instr_is_reg_copy(tgt: *target.Target, mi: *mir.MirInstr) bool {
    if (mi.operand_count != 2)            { ret false; }
    if (mi.asm_block != nil)              { ret false; }
    if (mi.width != mi.src_width)         { ret false; }
    if (!isa_is_reg_move(tgt, mi.opcode)) { ret false; }
    val d: *mir.MirOperand = ?mi.operands[0];
    val s: *mir.MirOperand = ?mi.operands[1];
    if (d.kind != mir.MIR_OP_VREG && d.kind != mir.MIR_OP_PREG)                             { ret false; }
    if (s.kind != mir.MIR_OP_VREG && s.kind != mir.MIR_OP_PREG && s.kind != mir.MIR_OP_IMM) { ret false; }
    ret true;
}

fun tally_reads(ctx: *AllocCtx, reads: *u32, nv: u32) {
    val f:  *mir.MirFunction = ctx.f;
    var bi: u32              = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi:      *mir.MirInstr = ?blk.instrs[ii];
            val has_def: bool          = instr_defines(mi);
            var k:       u32           = 0;
            for (k < mi.operand_count) {
                val op: *mir.MirOperand = ?mi.operands[k];
                if (op.kind == mir.MIR_OP_VREG) {
                    val is_dst: bool = has_def && k == 0;
                    if (!is_dst && op.vreg.n < nv) { reads[op.vreg.n] = reads[op.vreg.n] + 1; }
                }
                or (op.kind == mir.MIR_OP_MEM && !mir.vreg_is_nil(op.vreg) && op.vreg.n < nv) {
                    reads[op.vreg.n] = reads[op.vreg.n] + 1;
                }
                if (sel op.index.vreg) {
                    if (op.index.vreg.n < nv) { reads[op.index.vreg.n] = reads[op.index.vreg.n] + 1; }
                }
                k = k + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun is_dead_mov(tgt: *target.Target, ctx: *AllocCtx, mi: *mir.MirInstr, reads: *u32, nv: u32) bool {
    if (!instr_is_reg_copy(tgt, mi)) { ret false; }
    val d: *mir.MirOperand = ?mi.operands[0];
    if (d.kind != mir.MIR_OP_VREG)  { ret false; }
    if (d.vreg.n >= nv)             { ret false; }
    if (vreg_has_slot(ctx, d.vreg)) { ret false; }
    ret reads[d.vreg.n] == 0;
}

fun sweep_dead_movs(tgt: *target.Target, ctx: *AllocCtx) err[fail.Fail] {
    val f:  *mir.MirFunction = ctx.f;
    val nv: u32              = f.vreg_count;
    if (nv == 0)                     { ret err[fail.Fail].ok{}; }
    if (tgt.arch.is_reg_move == nil) { ret err[fail.Fail].ok{}; }

    val rr: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, nv::usize);
    if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
    val reads: *u32 = rr.ok;

    var changed: bool = true;
    for (changed) {
        changed = false;
        var i: u32 = 0;
        for (i < nv) {
            reads[i] = 0;
            i        = i + 1;
        }
        tally_reads(ctx, reads, nv);

        var bi: u32 = 0;
        for (bi < f.block_count) {
            val blk:   *mir.MirBlock = ?f.blocks[bi];
            var write: u32           = 0;
            var read:  u32           = 0;
            for (read < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[read];
                if (is_dead_mov(tgt, ctx, mi, reads, nv)) {
                    if (mi.operands != nil && mi.operand_count > 0) {
                        A.deallocate[mir.MirOperand](ctx.alloc, mi.operands, mi.operand_count::usize);
                    }
                    if (mi.dbg_bindings != nil && mi.dbg_binding_count > 0) {
                        A.deallocate[mir.MirDbgBinding](ctx.alloc, mi.dbg_bindings, mi.dbg_binding_count::usize);
                    }
                    changed = true;
                }
                or {
                    if (write != read) { blk.instrs[write] = blk.instrs[read]; }
                    write = write + 1;
                }
                read = read + 1;
            }
            blk.instr_count = write;
            bi              = bi + 1;
        }
    }

    A.deallocate[u32](ctx.alloc, reads, nv::usize);
    ret err[fail.Fail].ok{};
}

fun instr_reads_vreg(mi: *mir.MirInstr, v: mir.VRegId) bool {
    val has_def: bool = instr_defines(mi);
    var k:       u32  = 0;
    for (k < mi.operand_count) {
        val op: *mir.MirOperand = ?mi.operands[k];
        if (op.kind == mir.MIR_OP_VREG) {
            val is_dst: bool = has_def && k == 0;
            if (!is_dst && mir.vreg_same(op.vreg, v)) { ret true; }
        }
        if (op.kind == mir.MIR_OP_MEM) {
            if (!mir.vreg_is_nil(op.vreg) && mir.vreg_same(op.vreg, v)) { ret true; }
            if (sel op.index.vreg) {
                if (mir.vreg_same(op.index.vreg, v)) { ret true; }
            }
        }
        k = k + 1;
    }
    ret false;
}

fun web_find(parent: *u32, v: u32) u32 {
    var r: u32 = v;
    for (parent[r] != r) { r = parent[r]; }
    var c: u32 = v;
    for (parent[c] != r) {
        val n: u32 = parent[c];
        parent[c] = r;
        c         = n;
    }
    ret r;
}

fun tally_defs(ctx: *AllocCtx, defs: *u32, nv: u32) {
    val f:  *mir.MirFunction = ctx.f;
    var bi: u32              = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (instr_defines(mi)) {
                val d: *mir.MirOperand = ?mi.operands[0];
                if (d.vreg.n < nv) { defs[d.vreg.n] = defs[d.vreg.n] + 1; }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun try_coalesce(tgt: *target.Target, ctx: *AllocCtx, mi: *mir.MirInstr,
    parent: *u32, web_defs: *u32, nv: u32) bool {
    if (!instr_is_reg_copy(tgt, mi)) { ret false; }
    if (mi.width < ctx.spill_width)  { ret false; }
    val dop: *mir.MirOperand = ?mi.operands[0];
    val sop: *mir.MirOperand = ?mi.operands[1];
    if (dop.kind != mir.MIR_OP_VREG || sop.kind != mir.MIR_OP_VREG) { ret false; }
    val d: u32 = dop.vreg.n;
    val s: u32 = sop.vreg.n;
    if (d >= nv || s >= nv || d == s)                                 { ret false; }
    if (vreg_has_slot(ctx, dop.vreg) || vreg_has_slot(ctx, sop.vreg)) { ret false; }

    val dv: *mir.MirVReg = ?ctx.f.vregs[d];
    val sv: *mir.MirVReg = ?ctx.f.vregs[s];
    if (dv.class != sv.class)   { ret false; }
    if (dv.secret != sv.secret) { ret false; }
    if (dv.vector != sv.vector) { ret false; }

    val rd: u32 = web_find(parent, d);
    val rs: u32 = web_find(parent, s);
    if (rd == rs)          { ret false; }
    if (web_defs[rd] != 1) { ret false; }
    if (web_defs[rs] != 1) { ret false; }

    parent[rd] = rs;
    ret true;
}

fun rename_vregs(ctx: *AllocCtx, parent: *u32, nv: u32) {
    val f:  *mir.MirFunction = ctx.f;
    var bi: u32              = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            var k:  u32           = 0;
            for (k < mi.operand_count) {
                val op: *mir.MirOperand = ?mi.operands[k];
                if (op.kind == mir.MIR_OP_VREG && op.vreg.n < nv) {
                    op.vreg = mir.vreg_id(web_find(parent, op.vreg.n));
                }
                or (op.kind == mir.MIR_OP_MEM) {
                    if (!mir.vreg_is_nil(op.vreg) && op.vreg.n < nv) {
                        op.vreg = mir.vreg_id(web_find(parent, op.vreg.n));
                    }
                    var ix: u32 = nv;
                    if (sel op.index.vreg) { ix = op.index.vreg.n; }
                    if (ix < nv)           { op.index = mir.index_vreg(mir.vreg_id(web_find(parent, ix))); }
                }
                k = k + 1;
            }
            var b: u32 = 0;
            for (b < mi.dbg_binding_count) {
                val db: *mir.MirDbgBinding = ?mi.dbg_bindings[b];
                if (db.vreg != mir.MIR_VREG_NIL.n && db.vreg < nv)   { db.vreg = web_find(parent, db.vreg); }
                if (db.vreg2 != mir.MIR_VREG_NIL.n && db.vreg2 < nv) { db.vreg2 = web_find(parent, db.vreg2); }
                b = b + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun drop_self_copies(tgt: *target.Target, ctx: *AllocCtx) {
    val f:  *mir.MirFunction = ctx.f;
    var bi: u32              = 0;
    for (bi < f.block_count) {
        val blk:   *mir.MirBlock = ?f.blocks[bi];
        var write: u32           = 0;
        var read:  u32           = 0;
        for (read < blk.instr_count) {
            val mi:   *mir.MirInstr = ?blk.instrs[read];
            var drop: bool          = false;
            if (instr_is_reg_copy(tgt, mi)) {
                val a: *mir.MirOperand = ?mi.operands[0];
                val b: *mir.MirOperand = ?mi.operands[1];
                drop = a.kind == mir.MIR_OP_VREG && b.kind == mir.MIR_OP_VREG && mir.vreg_same(a.vreg, b.vreg);
            }
            if (drop && mir.instr_declassifies(mi)) {
                val marker: mir.MirInstr = mir.declassify_marker(mi, mi.operands[0].vreg);
                A.deallocate[mir.MirOperand](ctx.alloc, mi.operands, mi.operand_count::usize);
                blk.instrs[write] = marker;
                write             = write + 1;
            }
            or (drop) {
                if (mi.operands != nil && mi.operand_count > 0) {
                    A.deallocate[mir.MirOperand](ctx.alloc, mi.operands, mi.operand_count::usize);
                }
                if (mi.dbg_bindings != nil && mi.dbg_binding_count > 0) {
                    A.deallocate[mir.MirDbgBinding](ctx.alloc, mi.dbg_bindings, mi.dbg_binding_count::usize);
                }
            }
            or {
                if (write != read) { blk.instrs[write] = blk.instrs[read]; }
                write = write + 1;
            }
            read = read + 1;
        }
        blk.instr_count = write;
        bi              = bi + 1;
    }
}

fun coalesce_copies(tgt: *target.Target, ctx: *AllocCtx) err[fail.Fail] {
    val f:  *mir.MirFunction = ctx.f;
    val nv: u32              = f.vreg_count;
    if (nv == 0)                     { ret err[fail.Fail].ok{}; }
    if (tgt.arch.is_reg_move == nil) { ret err[fail.Fail].ok{}; }

    val rp: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, nv::usize);
    if (sel rp.err) { ret err[fail.Fail].err{fail.refused(rp.err)}; }
    val parent: *u32               = rp.ok;
    val rw:     res[*u32, A.Error] = A.allocate[u32](ctx.alloc, nv::usize);
    if (sel rw.err) {
        A.deallocate[u32](ctx.alloc, parent, nv::usize);
        ret err[fail.Fail].err{fail.refused(rw.err)};
    }
    val web_defs: *u32 = rw.ok;

    var i: u32 = 0;
    for (i < nv) {
        parent[i]   = i;
        web_defs[i] = 0;
        i           = i + 1;
    }
    tally_defs(ctx, web_defs, nv);

    var merged: bool = false;
    var bi:     u32  = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            if (try_coalesce(tgt, ctx, ?blk.instrs[ii], parent, web_defs, nv)) { merged = true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    if (merged) {
        rename_vregs(ctx, parent, nv);
        drop_self_copies(tgt, ctx);
    }

    A.deallocate[u32](ctx.alloc, web_defs, nv::usize);
    A.deallocate[u32](ctx.alloc, parent, nv::usize);
    ret err[fail.Fail].ok{};
}

fun reads_in_window(ctx: *AllocCtx, d: u32, from: i64, to: i64) bool {
    var p: i64 = from + 1;
    for (p < to) {
        if (instr_reads_vreg(flat_instr(ctx, p::u32), mir.vreg_id(d))) { ret true; }
        p = p + 1;
    }
    ret false;
}

fun build_hints(tgt: *target.Target, ctx: *AllocCtx) {
    if (tgt.arch.is_reg_move == nil) { ret; }
    val nv:  u32 = ctx.f.vreg_count;
    var pos: u32 = 0;
    for (pos < ctx.flat_count) {
        val mi: *mir.MirInstr = flat_instr(ctx, pos);
        if (instr_is_reg_copy(tgt, mi)) {
            val d: *mir.MirOperand = ?mi.operands[0];
            if (d.kind == mir.MIR_OP_VREG && d.vreg.n < nv
                && ctx.hints[d.vreg.n].src_vreg == mir.MIR_VREG_NIL.n
                && ctx.hints[d.vreg.n].src_preg < 0) {
                val s: *mir.MirOperand = ?mi.operands[1];
                if (s.kind == mir.MIR_OP_VREG && !mir.vreg_same(s.vreg, d.vreg)) {
                    ctx.hints[d.vreg.n].src_vreg = s.vreg.n;
                    ctx.hints[d.vreg.n].copy_pos = pos::i64;
                }
                or (s.kind == mir.MIR_OP_PREG) {
                    ctx.hints[d.vreg.n].src_preg = mir.preg_regid(s.preg);
                    ctx.hints[d.vreg.n].copy_pos = pos::i64;
                }
            }
            maybe_sink_hint(ctx, mi, pos, nv);
            maybe_reverse_hint(ctx, mi, pos, nv);
        }
        or {
            maybe_tie_hint(ctx, mi, pos, nv);
        }
        pos = pos + 1;
    }
}

fun is_two_address_op(op: mir.MirOpcode) bool {
    ret mir.has(op, mir.MIRF_TWO_ADDRESS);
}

fun maybe_tie_hint(ctx: *AllocCtx, mi: *mir.MirInstr, pos: u32, nv: u32) {
    if (!is_two_address_op(mi.opcode)) { ret; }
    if (mi.operand_count < 3)          { ret; }
    val d: *mir.MirOperand = ?mi.operands[0];
    val l: *mir.MirOperand = ?mi.operands[1];
    if (d.kind != mir.MIR_OP_VREG || l.kind != mir.MIR_OP_VREG)            { ret; }
    if (d.vreg.n >= nv || l.vreg.n >= nv || mir.vreg_same(d.vreg, l.vreg)) { ret; }
    if (ctx.hints[d.vreg.n].src_vreg != mir.MIR_VREG_NIL.n
        || ctx.hints[d.vreg.n].src_preg >= 0) { ret; }
    if (ctx.ranges[l.vreg.n].end_pos != pos::i64) { ret; }
    if (ctx.ranges[d.vreg.n].start != pos::i64)   { ret; }
    ctx.hints[d.vreg.n].src_vreg = l.vreg.n;
    ctx.hints[d.vreg.n].copy_pos = pos::i64;
}

fun maybe_sink_hint(ctx: *AllocCtx, mi: *mir.MirInstr, pos: u32, nv: u32) {
    val d: *mir.MirOperand = ?mi.operands[0];
    val s: *mir.MirOperand = ?mi.operands[1];
    if (d.kind != mir.MIR_OP_PREG || s.kind != mir.MIR_OP_VREG) { ret; }
    if (s.vreg.n >= nv)                                         { ret; }
    if (mi.width < ctx.spill_width)                             { ret; }
    val sv: u32 = s.vreg.n;
    if (ctx.hints[sv].sink_preg >= 0)       { ret; }
    if (ctx.ranges[sv].end_pos != pos::i64) { ret; }
    ctx.hints[sv].sink_preg = mir.preg_regid(d.preg);
}

fun maybe_reverse_hint(ctx: *AllocCtx, mi: *mir.MirInstr, pos: u32, nv: u32) {
    val d: *mir.MirOperand = ?mi.operands[0];
    val s: *mir.MirOperand = ?mi.operands[1];
    if (d.kind != mir.MIR_OP_VREG || s.kind != mir.MIR_OP_VREG)            { ret; }
    if (d.vreg.n >= nv || s.vreg.n >= nv || mir.vreg_same(d.vreg, s.vreg)) { ret; }
    val dv: u32 = d.vreg.n;
    val sv: u32 = s.vreg.n;
    if (ctx.hints[sv].dst_vreg != mir.MIR_VREG_NIL.n) { ret; }

    val p:  i64        = pos::i64;
    val dr: *LiveRange = ?ctx.ranges[dv];
    val sr: *LiveRange = ?ctx.ranges[sv];

    if (dr.start >= p || dr.end_pos < p)                      { ret; }
    if (sr.end_pos != p || sr.start >= p || sr.start < 0)     { ret; }
    if (ctx.flat[sr.start::u32].block != ctx.flat[pos].block) { ret; }
    if (reads_in_window(ctx, dv, sr.start, p))                { ret; }

    ctx.hints[sv].dst_vreg     = dv;
    ctx.hints[sv].dst_copy_pos = p;
}

# liveness scratch: per-register use and definition blocks and per-block
# predecessors, each grouped as offset ranges, so the propagation touches
# only the blocks a register reaches instead of a block-by-register matrix
rec LiveScratch {
    alloc:      *A.Allocator;
    nb:         u32;
    nv:         u32;
    use_start:  *u32;
    def_start:  *u32;
    pred_start: *u32;
    use_mark:   *u32;
    def_mark:   *u32;
    def_of:     *u32;
    visited:    *u32;
    pending:    *u32;
    use_count:  u32;
    def_count:  u32;
    edge_count: u32;
    use_blocks: *u32;
    def_blocks: *u32;
    preds:      *u32;
    fill:       bool;
}

fun live_scratch_array(l: *LiveScratch, out: **u32, n: u32, value: u32) err[fail.Fail] {
    if (n == 0) {
        @out = nil;
        ret err[fail.Fail].ok{};
    }
    val r: res[*u32, A.Error] = A.allocate[u32](l.alloc, n::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    @out = r.ok;
    var i: u32 = 0;
    for (i < n) {
        r.ok[i] = value;
        i       = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun live_scratch_release(l: *LiveScratch, arr: **u32, n: u32) {
    if (@arr != nil && n > 0) { A.deallocate[u32](l.alloc, @arr, n::usize); }
    @arr = nil;
}

fun live_scratch_dnit(l: *LiveScratch) {
    live_scratch_release(l, ?l.preds, l.edge_count);
    live_scratch_release(l, ?l.def_blocks, l.def_count);
    live_scratch_release(l, ?l.use_blocks, l.use_count);
    live_scratch_release(l, ?l.pending, l.nb);
    live_scratch_release(l, ?l.visited, l.nb);
    live_scratch_release(l, ?l.def_of, l.nb);
    live_scratch_release(l, ?l.def_mark, l.nv);
    live_scratch_release(l, ?l.use_mark, l.nv);
    live_scratch_release(l, ?l.pred_start, l.nb + 1);
    live_scratch_release(l, ?l.def_start, l.nv + 1);
    live_scratch_release(l, ?l.use_start, l.nv + 1);
}

fun live_scratch_init(l: *LiveScratch, alloc: *A.Allocator, nb: u32, nv: u32) err[fail.Fail] {
    l.alloc      = alloc;
    l.nb         = nb;
    l.nv         = nv;
    l.use_start  = nil;
    l.def_start  = nil;
    l.pred_start = nil;
    l.use_mark   = nil;
    l.def_mark   = nil;
    l.def_of     = nil;
    l.visited    = nil;
    l.pending    = nil;
    l.use_count  = 0;
    l.def_count  = 0;
    l.edge_count = 0;
    l.use_blocks = nil;
    l.def_blocks = nil;
    l.preds      = nil;
    l.fill       = false;
    val r0: err[fail.Fail] = live_scratch_array(l, ?l.use_start, nv + 1, 0);
    if (sel r0.err) { ret r0; }
    val r1: err[fail.Fail] = live_scratch_array(l, ?l.def_start, nv + 1, 0);
    if (sel r1.err) {
        live_scratch_dnit(l);
        ret r1;
    }
    val r2: err[fail.Fail] = live_scratch_array(l, ?l.pred_start, nb + 1, 0);
    if (sel r2.err) {
        live_scratch_dnit(l);
        ret r2;
    }
    val r3: err[fail.Fail] = live_scratch_array(l, ?l.use_mark, nv, RANGE_NIL);
    if (sel r3.err) {
        live_scratch_dnit(l);
        ret r3;
    }
    val r4: err[fail.Fail] = live_scratch_array(l, ?l.def_mark, nv, RANGE_NIL);
    if (sel r4.err) {
        live_scratch_dnit(l);
        ret r4;
    }
    val r5: err[fail.Fail] = live_scratch_array(l, ?l.def_of, nb, RANGE_NIL);
    if (sel r5.err) {
        live_scratch_dnit(l);
        ret r5;
    }
    val r6: err[fail.Fail] = live_scratch_array(l, ?l.visited, nb, RANGE_NIL);
    if (sel r6.err) {
        live_scratch_dnit(l);
        ret r6;
    }
    val r7: err[fail.Fail] = live_scratch_array(l, ?l.pending, nb, RANGE_NIL);
    if (sel r7.err) {
        live_scratch_dnit(l);
        ret r7;
    }
    ret err[fail.Fail].ok{};
}

# a use counts once per block and only before the block's first definition
fun note_use(l: *LiveScratch, reg: u32, block: u32) {
    if (reg >= l.nv || l.def_mark[reg] == block || l.use_mark[reg] == block) { ret; }
    l.use_mark[reg] = block;
    if (l.fill) {
        l.use_blocks[l.use_start[reg]] = block;
        l.use_start[reg]               = l.use_start[reg] + 1;
    }
    or { l.use_start[reg + 1] = l.use_start[reg + 1] + 1; }
}

fun note_def(l: *LiveScratch, reg: u32, block: u32) {
    if (reg >= l.nv || l.def_mark[reg] == block) { ret; }
    l.def_mark[reg] = block;
    if (l.fill) {
        l.def_blocks[l.def_start[reg]] = block;
        l.def_start[reg]               = l.def_start[reg] + 1;
    }
    or { l.def_start[reg + 1] = l.def_start[reg + 1] + 1; }
}

fun note_edge(l: *LiveScratch, pred: u32, succ: u32) {
    if (l.fill) {
        l.preds[l.pred_start[succ]] = pred;
        l.pred_start[succ]          = l.pred_start[succ] + 1;
    }
    or { l.pred_start[succ + 1] = l.pred_start[succ + 1] + 1; }
}

# the same walk counts on the first pass and fills on the second; the start
# arrays hold counts per index + 1 after the first pass, prefix sums after
# exclusive_offsets, and each fill advances its own start, which
# restore_offsets shifts back
fun collect_references(ctx: *AllocCtx, l: *LiveScratch) {
    val f: *mir.MirFunction = ctx.f;
    var i: u32              = 0;
    for (i < l.nv) {
        l.use_mark[i] = RANGE_NIL;
        l.def_mark[i] = RANGE_NIL;
        i             = i + 1;
    }
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi:      *mir.MirInstr = ?blk.instrs[ii];
            val has_def: bool          = instr_defines(mi);
            var k:       u32           = 0;
            for (k < mi.operand_count) {
                val op: *mir.MirOperand = ?mi.operands[k];
                if (op.kind == mir.MIR_OP_VREG || op.kind == mir.MIR_OP_MEM) {
                    val is_dst: bool = has_def && k == 0 && op.kind == mir.MIR_OP_VREG;
                    if (!is_dst) { note_use(l, op.vreg.n, bi); }
                }
                if (sel op.index.vreg) { note_use(l, op.index.vreg.n, bi); }
                k = k + 1;
            }
            if (has_def) { note_def(l, mi.operands[0].vreg.n, bi); }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun collect_edges(ctx: *AllocCtx, l: *LiveScratch) {
    val f:  *mir.MirFunction = ctx.f;
    var bi: u32              = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        if (blk.instr_count > 0) {
            val term: *mir.MirInstr = ?blk.instrs[blk.instr_count - 1];
            var k:    u32           = 0;
            for (k < term.operand_count) {
                val op: *mir.MirOperand = ?term.operands[k];
                if (op.kind == mir.MIR_OP_BLOCK) {
                    val si: u32 = block_index_of(ctx, op.imm::u32);
                    if (si != RANGE_NIL) { note_edge(l, bi, si); }
                }
                k = k + 1;
            }
        }
        if (bi + 1 < f.block_count && block_lists_pred(?f.blocks[bi + 1], blk.id)) {
            note_edge(l, bi, bi + 1);
        }
        bi = bi + 1;
    }
}

fun exclusive_offsets(start: *u32, n: u32) u32 {
    var i: u32 = 0;
    for (i < n) {
        start[i + 1] = start[i + 1] + start[i];
        i            = i + 1;
    }
    ret start[n];
}

fun restore_offsets(start: *u32, n: u32) {
    var i: u32 = n;
    for (i > 0) {
        start[i] = start[i - 1];
        i        = i - 1;
    }
    start[0] = 0;
}

fun extend_liveness(ctx: *AllocCtx) err[fail.Fail] {
    val nb: u32 = ctx.f.block_count;
    val nv: u32 = ctx.f.vreg_count;
    if (nb == 0 || nv == 0) { ret err[fail.Fail].ok{}; }
    var l:  LiveScratch;
    val li: err[fail.Fail] = live_scratch_init(?l, ctx.alloc, nb, nv);
    if (sel li.err) { ret li; }
    fin { live_scratch_dnit(?l); }

    collect_references(ctx, ?l);
    collect_edges(ctx, ?l);
    l.use_count  = exclusive_offsets(l.use_start, nv);
    l.def_count  = exclusive_offsets(l.def_start, nv);
    l.edge_count = exclusive_offsets(l.pred_start, nb);
    val ru: err[fail.Fail] = live_scratch_array(?l, ?l.use_blocks, l.use_count, RANGE_NIL);
    if (sel ru.err) { ret ru; }
    val rd: err[fail.Fail] = live_scratch_array(?l, ?l.def_blocks, l.def_count, RANGE_NIL);
    if (sel rd.err) { ret rd; }
    val rp: err[fail.Fail] = live_scratch_array(?l, ?l.preds, l.edge_count, RANGE_NIL);
    if (sel rp.err) { ret rp; }
    l.fill = true;
    collect_references(ctx, ?l);
    collect_edges(ctx, ?l);
    restore_offsets(l.use_start, nv);
    restore_offsets(l.def_start, nv);
    restore_offsets(l.pred_start, nb);

    propagate_liveness(ctx, ?l);
    ret err[fail.Fail].ok{};
}

# backward reachability per register: every block with an upward-exposed use
# is live-in, every predecessor of a live-in block is live-out, and a
# predecessor without a definition of the register is live-in in turn
fun propagate_liveness(ctx: *AllocCtx, l: *LiveScratch) {
    var reg: u32 = 0;
    for (reg < l.nv) {
        val lr: *LiveRange = ?ctx.ranges[reg];
        var d:  u32        = l.def_start[reg];
        for (d < l.def_start[reg + 1]) {
            l.def_of[l.def_blocks[d]] = reg;
            d                         = d + 1;
        }
        var count: u32 = 0;
        var u:     u32 = l.use_start[reg];
        for (u < l.use_start[reg + 1]) {
            val b: u32 = l.use_blocks[u];
            if (l.visited[b] != reg) {
                l.visited[b]     = reg;
                l.pending[count] = b;
                count            = count + 1;
                extend_range_for_block(lr, ctx.block_spans[b], true, false);
            }
            u = u + 1;
        }
        for (count > 0) {
            count = count - 1;
            val b: u32 = l.pending[count];
            var e: u32 = l.pred_start[b];
            for (e < l.pred_start[b + 1]) {
                val p: u32 = l.preds[e];
                extend_range_for_block(lr, ctx.block_spans[p], false, true);
                if (l.def_of[p] != reg && l.visited[p] != reg) {
                    l.visited[p]     = reg;
                    l.pending[count] = p;
                    count            = count + 1;
                    extend_range_for_block(lr, ctx.block_spans[p], true, false);
                }
                e = e + 1;
            }
        }
        reg = reg + 1;
    }
}

fun extend_range_for_block(lr: *LiveRange, span: BlockSpan, live_in: bool, live_out: bool) {
    if (live_in && span.start >= 0 && span.start < lr.start) { lr.start = span.start; }
    if (live_out && span.end > lr.end_pos)                   { lr.end_pos = span.end; }
}

fun build_block_spans(ctx: *AllocCtx) err[fail.Fail] {
    val f: *mir.MirFunction = ctx.f;
    val n: u32              = f.block_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val r: res[*BlockSpan, A.Error] = A.allocate[BlockSpan](ctx.alloc, n::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    ctx.block_spans = r.ok;

    var i: u32 = 0;
    for (i < n) {
        ctx.block_spans[i].start = -1;
        ctx.block_spans[i].end   = -1;
        i                        = i + 1;
    }
    var pos: u32 = 0;
    for (pos < ctx.flat_count) {
        val b: u32 = ctx.flat[pos].block;
        if (ctx.block_spans[b].start < 0) { ctx.block_spans[b].start = pos::i64; }
        ctx.block_spans[b].end = pos::i64;
        pos                    = pos + 1;
    }
    ret err[fail.Fail].ok{};
}

fun instr_defines(mi: *mir.MirInstr) bool {
    if (!mir.instr_defines_shape(mi)) { ret false; }
    ret mi.operands[0].kind == mir.MIR_OP_VREG;
}

fun block_lists_pred(blk: *mir.MirBlock, pred_id: u32) bool {
    var i: u32 = 0;
    for (i < blk.pred_count) {
        if (blk.preds[i] == pred_id) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun mark_call_crossing(ctx: *AllocCtx) err[fail.Fail] {
    val n: u32 = ctx.flat_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val r: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, (n + 1)::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val prefix: *u32 = r.ok;
    prefix[0] = 0;
    var p: u32 = 0;
    for (p < n) {
        var inc: u32 = 0;
        if (ctx.flat[p].is_call) { inc = 1; }
        prefix[p + 1] = prefix[p] + inc;
        p             = p + 1;
    }

    var v: u32 = 0;
    for (v < ctx.f.vreg_count) {
        val lr: *LiveRange = ?ctx.ranges[v];
        if (lr.end_pos >= 0) {
            if (prefix[(lr.end_pos + 1)::u32] - prefix[lr.start::u32] > 0) {
                lr.crosses_call = true;
            }
        }
        v = v + 1;
    }

    A.deallocate[u32](ctx.alloc, prefix, (n + 1)::usize);
    ret err[fail.Fail].ok{};
}

fun linear_scan(tgt: *target.Target, ctx: *AllocCtx) err[fail.Fail] {
    reserve_param_registers(ctx);
    val br: err[fail.Fail] = build_arg_reservations(ctx);
    if (sel br.err) { ret br; }

    val nv: u32                = ctx.f.vreg_count;
    val ro: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, nv::usize);
    if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
    val order: *u32 = ro.ok;
    var i:     u32  = 0;
    for (i < nv) {
        order[i] = i;
        i        = i + 1;
    }
    val sb: err[fail.Fail] = sort_by_start(ctx, order, nv);
    if (sel sb.err) {
        A.deallocate[u32](ctx.alloc, order, nv::usize);
        ret sb;
    }

    var oi: u32 = 0;
    for (oi < nv) {
        val v:   u32        = order[oi];
        val vid: mir.VRegId = mir.vreg_id(v);
        val lr:  *LiveRange = ?ctx.ranges[v];
        if (lr.end_pos < 0) {
            oi = oi + 1;
            cnt;
        }
        if (vreg_has_slot(ctx, vid)) {
            oi = oi + 1;
            cnt;
        }

        expire_active(ctx, lr.start);
        release_pins(ctx, lr.start);

        ctx.cur_start = lr.start;
        ctx.cur_end   = lr.end_pos;

        var preg: i32 = -1;
        if (ctx.hints[v].src_vreg != mir.MIR_VREG_NIL.n || ctx.hints[v].src_preg >= 0) {
            preg = pick_hint(ctx, vid, lr);
        }
        if (preg < 0 && ctx.hints[v].sink_preg >= 0) {
            preg = pick_sink_hint(ctx, vid, lr);
        }
        if (preg < 0 && ctx.hints[v].dst_vreg != mir.MIR_VREG_NIL.n) {
            val rr: i32 = pick_target_hint(ctx, vid, lr);
            if (rr >= 0) {
                ctx.f.vregs[v].assigned = mir.preg_id(rr);
                val dv: u32 = ctx.hints[v].dst_vreg;
                if (ctx.hints[v].dst_copy_pos > ctx.anchor_until[dv]) {
                    ctx.anchor_until[dv] = ctx.hints[v].dst_copy_pos;
                }
                oi = oi + 1;
                cnt;
            }
        }
        if (preg < 0) {
            if (lr.reg_class == REG_CLASS_GP) {
                preg = pick_gp(ctx, lr.crosses_call);
            }
            or {
                preg = pick_fp(ctx, lr.crosses_call);
            }
        }

        if (preg >= 0) {
            assign(ctx, vid, mir.preg_id(preg), lr.reg_class);
        }
        or {
            val sr: err[fail.Fail] = spill_on_pressure(ctx, vid);
            if (sel sr.err) {
                A.deallocate[u32](ctx.alloc, order, nv::usize);
                ret sr;
            }
        }
        oi = oi + 1;
    }

    A.deallocate[u32](ctx.alloc, order, nv::usize);
    ret err[fail.Fail].ok{};
}

fun reserve_param_registers(ctx: *AllocCtx) {
    val f: *mir.MirFunction = ctx.f;
    if (f.block_count == 0) { ret; }
    val blk: *mir.MirBlock = ?f.blocks[0];
    var pos: u32           = 0;
    var ii:  u32           = 0;
    for (ii < blk.instr_count) {
        val mi: *mir.MirInstr = ?blk.instrs[ii];
        if (mi.operand_count == 2) {
            val d: *mir.MirOperand = ?mi.operands[0];
            val s: *mir.MirOperand = ?mi.operands[1];
            if ((d.kind == mir.MIR_OP_VREG || d.kind == mir.MIR_OP_MEM) && s.kind == mir.MIR_OP_PREG) {
                val r: u32 = s.preg.n;
                if (isa.regid_class(r::i32) == isa.REG_CLASS_ID_GP) {
                    if (r < ctx.gp_count && pos::i64 > ctx.pinned_end[r]) {
                        ctx.pinned_end[r]    = pos::i64;
                        ctx.param_reg_end[r] = pos::i64;
                    }
                }
                or {
                    val fi: u32 = isa.regid_index(r::i32)::u32;
                    if (ctx.fp_pinned_end != nil && fi < ctx.fp_count && pos::i64 > ctx.fp_pinned_end[fi]) {
                        ctx.fp_pinned_end[fi] = pos::i64;
                    }
                }
            }
        }
        pos = pos + 1;
        ii  = ii + 1;
    }
}

fun build_arg_reservations(ctx: *AllocCtx) err[fail.Fail] {
    ctx.arg_res_count = 0;
    ctx.def_res_count = 0;
    if (ctx.flat_count == 0) { ret err[fail.Fail].ok{}; }

    val rr: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, ctx.flat_count::usize);
    if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
    ctx.arg_res_reg = rr.ok;
    val rs: res[*i64, A.Error] = A.allocate[i64](ctx.alloc, ctx.flat_count::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    ctx.arg_res_start = rs.ok;
    val re: res[*i64, A.Error] = A.allocate[i64](ctx.alloc, ctx.flat_count::usize);
    if (sel re.err) { ret err[fail.Fail].err{fail.refused(re.err)}; }
    ctx.arg_res_end = re.ok;
    val dr: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, ctx.flat_count::usize);
    if (sel dr.err) { ret err[fail.Fail].err{fail.refused(dr.err)}; }
    ctx.def_res_reg = dr.ok;
    val dp: res[*i64, A.Error] = A.allocate[i64](ctx.alloc, ctx.flat_count::usize);
    if (sel dp.err) { ret err[fail.Fail].err{fail.refused(dp.err)}; }
    ctx.def_res_pos = dp.ok;

    var pos: u32 = 0;
    for (pos < ctx.flat_count) {
        val mi: *mir.MirInstr = flat_instr(ctx, pos);
        if (!instr_defines_preg(mi)) {
            pos = pos + 1;
            cnt;
        }
        val d: *mir.MirOperand = ?mi.operands[0];
        val r: u32             = d.preg.n;

        ctx.def_res_reg[ctx.def_res_count] = r;
        ctx.def_res_pos[ctx.def_res_count] = pos::i64;
        ctx.def_res_count                  = ctx.def_res_count + 1;

        var c:      u32  = pos + 1;
        var found:  bool = false;
        var killed: bool = false;
        for (c < ctx.flat_count && !found && !killed) {
            if (ctx.flat[c].is_call) {
                found = true;
            }
            or {
                val mj: *mir.MirInstr = flat_instr(ctx, c);
                if (instr_defines_preg(mj) && mj.operands[0].preg.n == r) { killed = true; }
                c = c + 1;
            }
        }
        if (found) {
            ctx.arg_res_reg[ctx.arg_res_count]   = r;
            ctx.arg_res_start[ctx.arg_res_count] = (pos + 1)::i64;
            ctx.arg_res_end[ctx.arg_res_count]   = c::i64;
            ctx.arg_res_count                    = ctx.arg_res_count + 1;
        }
        pos = pos + 1;
    }
    ret err[fail.Fail].ok{};
}

fun instr_defines_preg(mi: *mir.MirInstr) bool {
    if (!mir.instr_defines_shape(mi)) { ret false; }
    ret mi.operands[0].kind == mir.MIR_OP_PREG;
}

fun arg_reg_reserved(ctx: *AllocCtx, id: u32) bool {
    var i: u32 = 0;
    for (i < ctx.arg_res_count) {
        if (ctx.arg_res_reg[i] == id) {
            if (!(ctx.cur_end < ctx.arg_res_start[i] || ctx.cur_start > ctx.arg_res_end[i])) {
                ret true;
            }
        }
        i = i + 1;
    }
    ret false;
}

fun arg_reg_busy_at(ctx: *AllocCtx, id: u32, pos: u32) bool {
    var i: u32 = 0;
    for (i < ctx.arg_res_count) {
        if (ctx.arg_res_reg[i] == id
            && pos::i64 >= ctx.arg_res_start[i]
            && pos::i64 <= ctx.arg_res_end[i]) {
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun release_pins(ctx: *AllocCtx, current_start: i64) {
    var r: u32 = 0;
    for (r < ctx.gp_count) {
        if (ctx.pinned_end[r] >= 0 && ctx.pinned_end[r] < current_start) {
            ctx.pinned_end[r] = -1;
        }
        r = r + 1;
    }
    if (ctx.fp_pinned_end != nil) {
        var fi: u32 = 0;
        for (fi < ctx.fp_count) {
            if (ctx.fp_pinned_end[fi] >= 0 && ctx.fp_pinned_end[fi] < current_start) {
                ctx.fp_pinned_end[fi] = -1;
            }
            fi = fi + 1;
        }
    }
}

fun build_vreg_slot_flags(ctx: *AllocCtx) err[fail.Fail] {
    val f:  *mir.MirFunction = ctx.f;
    val nv: u32              = f.vreg_count;
    if (nv == 0) { ret err[fail.Fail].ok{}; }

    val r: res[*bool, A.Error] = A.allocate[bool](ctx.alloc, nv::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    ctx.vreg_slot_flag = r.ok;
    var i: u32 = 0;
    for (i < nv) {
        ctx.vreg_slot_flag[i] = false;
        i                     = i + 1;
    }

    val frame: *mir.MirFrame = ?f.frame;
    var s:     u32           = 0;
    for (s < frame.slot_count) {
        val owner: u32 = frame.slots[s].value;
        if (owner < nv) { ctx.vreg_slot_flag[owner] = true; }
        s = s + 1;
    }
    ret err[fail.Fail].ok{};
}

fun vreg_has_slot(ctx: *AllocCtx, v: mir.VRegId) bool {
    if (v.n >= ctx.f.vreg_count) { ret false; }
    ret ctx.vreg_slot_flag[v.n];
}

rec RangeKey {
    start:   i64;
    end_pos: i64;
    idx:     u32;
}

fun range_key_cmp(a: *RangeKey, b: *RangeKey) i64 {
    if (a.start < b.start)     { ret -1; }
    if (a.start > b.start)     { ret 1; }
    if (a.end_pos < b.end_pos) { ret -1; }
    if (a.end_pos > b.end_pos) { ret 1; }
    if (a.idx < b.idx)         { ret -1; }
    if (a.idx > b.idx)         { ret 1; }
    ret 0;
}

fun sort_by_start(ctx: *AllocCtx, order: *u32, count: u32) err[fail.Fail] {
    if (count < 2) { ret err[fail.Fail].ok{}; }
    val keys_r: res[*RangeKey, A.Error] = A.allocate[RangeKey](ctx.alloc, count::usize);
    if (sel keys_r.err) { ret err[fail.Fail].err{fail.refused(keys_r.err)}; }
    val keys: *RangeKey = keys_r.ok;
    var i:    u32       = 0;
    for (i < count) {
        keys[i].start   = ctx.ranges[order[i]].start;
        keys[i].end_pos = ctx.ranges[order[i]].end_pos;
        keys[i].idx     = order[i];
        i               = i + 1;
    }
    sort.sort[RangeKey](keys, count::usize, range_key_cmp);
    i = 0;
    for (i < count) {
        order[i] = keys[i].idx;
        i        = i + 1;
    }
    A.deallocate[RangeKey](ctx.alloc, keys, count::usize);
    ret err[fail.Fail].ok{};
}

fun expire_active(ctx: *AllocCtx, current_start: i64) {
    var write: u32 = 0;
    var read:  u32 = 0;
    for (read < ctx.active_count) {
        val v:  u32        = ctx.active[read];
        val lr: *LiveRange = ?ctx.ranges[v];
        if (lr.end_pos >= current_start) {
            ctx.active[write] = v;
            write             = write + 1;
        }
        or {
            free_assigned(ctx, mir.vreg_id(v));
        }
        read = read + 1;
    }
    ctx.active_count = write;
}

fun free_assigned(ctx: *AllocCtx, v: mir.VRegId) {
    val mv: *mir.MirVReg = ?ctx.f.vregs[v.n];
    if (mir.preg_is_nil(mv.assigned)) { ret; }
    val lr:    *LiveRange = ?ctx.ranges[v.n];
    val index: u32        = isa.regid_index(mir.preg_regid(mv.assigned))::u32;
    if (lr.reg_class == REG_CLASS_GP) {
        if (index < ctx.gp_count) { ctx.gp_busy[index] = false; }
    }
    or {
        if (index < ctx.fp_count) { ctx.fp_busy[index] = false; }
    }
}

fun pick_hint(ctx: *AllocCtx, v: mir.VRegId, lr: *LiveRange) i32 {
    val h: *CopyHint = ?ctx.hints[v.n];

    var rid: i32 = -1;
    if (h.src_preg >= 0) {
        rid = h.src_preg;
    }
    or (h.src_vreg != mir.MIR_VREG_NIL.n) {
        val s: mir.VRegId = mir.vreg_id(h.src_vreg);
        if (s.n < ctx.f.vreg_count && !is_spilled(ctx, s) && !vreg_has_slot(ctx, s)) {
            val a: mir.PRegId = ctx.f.vregs[s.n].assigned;
            if (!mir.preg_is_nil(a)) { rid = mir.preg_regid(a); }
        }
    }
    if (rid < 0) { ret -1; }

    val rclass: i32 = isa.regid_class(rid);
    val idx:    u32 = isa.regid_index(rid)::u32;

    if (lr.reg_class == REG_CLASS_GP) {
        if (rclass != isa.REG_CLASS_ID_GP)                               { ret -1; }
        if (idx >= ctx.gp_count)                                         { ret -1; }
        if (ctx.reserved[idx])                                           { ret -1; }
        if (lr.crosses_call && !ctx.callee_saved[idx])                   { ret -1; }
        if (arg_reg_reserved(ctx, rid::u32))                             { ret -1; }
        if (def_reg_reserved(ctx, rid::u32))                             { ret -1; }
        if (ctx.pinned_end[idx] >= 0 && ctx.pinned_end[idx] != lr.start) { ret -1; }
        if (!ctx.gp_busy[idx]) {
            ctx.gp_busy[idx] = true;
            ret rid;
        }
        if (can_transfer(ctx, lr, h)) {
            transfer_source_reg(ctx, mir.vreg_id(h.src_vreg), mir.preg_id(rid));
            ret rid;
        }
        ret -1;
    }
    or {
        if (rclass != isa.REG_CLASS_ID_XMM)                                                                { ret -1; }
        if (idx >= ctx.fp_count)                                                                           { ret -1; }
        if (lr.crosses_call && (ctx.fp_callee_saved == nil || !ctx.fp_callee_saved[idx]))                  { ret -1; }
        if (arg_reg_reserved(ctx, rid::u32))                                                               { ret -1; }
        if (def_reg_reserved(ctx, rid::u32))                                                               { ret -1; }
        if (ctx.fp_pinned_end != nil && ctx.fp_pinned_end[idx] >= 0 && ctx.fp_pinned_end[idx] != lr.start) { ret -1; }
        if (!ctx.fp_busy[idx]) {
            ctx.fp_busy[idx] = true;
            ret rid;
        }
        if (can_transfer(ctx, lr, h)) {
            transfer_source_reg(ctx, mir.vreg_id(h.src_vreg), mir.preg_id(rid));
            ret rid;
        }
        ret -1;
    }
}

fun can_transfer(ctx: *AllocCtx, lr: *LiveRange, h: *CopyHint) bool {
    if (h.src_vreg == mir.MIR_VREG_NIL.n)             { ret false; }
    if (h.copy_pos < 0)                               { ret false; }
    if (ctx.ranges[h.src_vreg].end_pos != h.copy_pos) { ret false; }
    if (lr.start != h.copy_pos)                       { ret false; }
    ret true;
}

fun transfer_source_reg(ctx: *AllocCtx, src: mir.VRegId, rid: mir.PRegId) {
    if (!vreg_in_active(ctx, src) || !mir.preg_same(ctx.f.vregs[src.n].assigned, rid)) {
        panic("regalloc: copy-hint transfer source is not the live owner of its register\n");
    }
    remove_active(ctx, src);
}

fun pick_sink_hint(ctx: *AllocCtx, v: mir.VRegId, lr: *LiveRange) i32 {
    val rid: i32 = ctx.hints[v.n].sink_preg;
    if (rid < 0) { ret -1; }

    val rclass: i32 = isa.regid_class(rid);
    val idx:    u32 = isa.regid_index(rid)::u32;

    if (lr.reg_class == REG_CLASS_GP) {
        if (rclass != isa.REG_CLASS_ID_GP)             { ret -1; }
        if (idx >= ctx.gp_count)                       { ret -1; }
        if (ctx.reserved[idx])                         { ret -1; }
        if (lr.crosses_call && !ctx.callee_saved[idx]) { ret -1; }
        if (!gp_available(ctx, idx))                   { ret -1; }
        ctx.gp_busy[idx] = true;
        ret rid;
    }
    or {
        if (rclass != isa.REG_CLASS_ID_XMM)                                               { ret -1; }
        if (idx >= ctx.fp_count)                                                          { ret -1; }
        if (lr.crosses_call && (ctx.fp_callee_saved == nil || !ctx.fp_callee_saved[idx])) { ret -1; }
        if (!fp_available(ctx, idx))                                                      { ret -1; }
        ctx.fp_busy[idx] = true;
        ret rid;
    }
}

fun pick_target_hint(ctx: *AllocCtx, v: mir.VRegId, lr: *LiveRange) i32 {
    val d: mir.VRegId = mir.vreg_id(ctx.hints[v.n].dst_vreg);
    if (d.n >= ctx.f.vreg_count)                     { ret -1; }
    if (is_spilled(ctx, d) || vreg_has_slot(ctx, d)) { ret -1; }
    val a: mir.PRegId = ctx.f.vregs[d.n].assigned;
    if (mir.preg_is_nil(a)) { ret -1; }

    val rid:    i32 = mir.preg_regid(a);
    val rclass: i32 = isa.regid_class(rid);
    val idx:    u32 = isa.regid_index(rid)::u32;
    if (lr.reg_class == REG_CLASS_GP) {
        if (rclass != isa.REG_CLASS_ID_GP || idx >= ctx.gp_count) { ret -1; }
    }
    or {
        if (rclass != isa.REG_CLASS_ID_XMM || idx >= ctx.fp_count) { ret -1; }
    }
    ret rid;
}

fun vreg_in_active(ctx: *AllocCtx, v: mir.VRegId) bool {
    var i: u32 = 0;
    for (i < ctx.active_count) {
        if (ctx.active[i] == v.n) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun pick_gp(ctx: *AllocCtx, crosses_call: bool) i32 {
    if (crosses_call) {
        var ci: u32 = 0;
        for (ci < ctx.gp_count) {
            if (gp_available(ctx, ci) && ctx.callee_saved[ci] && !ctx.reserved[ci]) {
                ctx.gp_busy[ci] = true;
                ret isa.regid_make(isa.REG_CLASS_ID_GP, ci::i32);
            }
            ci = ci + 1;
        }
    }
    or {
        var ci: u32 = 0;
        for (ci < ctx.gp_count) {
            if (gp_available(ctx, ci) && !ctx.callee_saved[ci] && !ctx.reserved[ci]) {
                ctx.gp_busy[ci] = true;
                ret isa.regid_make(isa.REG_CLASS_ID_GP, ci::i32);
            }
            ci = ci + 1;
        }
    }
    var ci: u32 = 0;
    for (ci < ctx.gp_count) {
        if (gp_available(ctx, ci) && !ctx.reserved[ci]) {
            ctx.gp_busy[ci] = true;
            ret isa.regid_make(isa.REG_CLASS_ID_GP, ci::i32);
        }
        ci = ci + 1;
    }
    ret -1;
}

fun def_reg_reserved(ctx: *AllocCtx, id: u32) bool {
    var i: u32 = 0;
    for (i < ctx.def_res_count) {
        if (ctx.def_res_reg[i] == id
            && ctx.cur_start <= ctx.def_res_pos[i]
            && ctx.cur_end > ctx.def_res_pos[i]) {
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun gp_available(ctx: *AllocCtx, id: u32) bool {
    if (ctx.gp_busy[id])           { ret false; }
    if (ctx.pinned_end[id] >= 0)   { ret false; }
    if (arg_reg_reserved(ctx, id)) { ret false; }
    if (def_reg_reserved(ctx, id)) { ret false; }
    ret true;
}

fun fp_available(ctx: *AllocCtx, fi: u32) bool {
    if (ctx.fp_busy[fi])                                        { ret false; }
    if (ctx.fp_pinned_end != nil && ctx.fp_pinned_end[fi] >= 0) { ret false; }
    val cid: u32 = isa.regid_make(isa.REG_CLASS_ID_XMM, fi::i32)::u32;
    if (arg_reg_reserved(ctx, cid)) { ret false; }
    if (def_reg_reserved(ctx, cid)) { ret false; }
    ret true;
}

fun pick_fp(ctx: *AllocCtx, crosses_call: bool) i32 {
    if (crosses_call) {
        var ci: u32 = 0;
        for (ci < ctx.fp_count) {
            if (fp_available(ctx, ci) && ctx.fp_callee_saved[ci]) {
                ctx.fp_busy[ci] = true;
                ret isa.regid_make(isa.REG_CLASS_ID_XMM, ci::i32);
            }
            ci = ci + 1;
        }
    }
    or {
        var ci: u32 = 0;
        for (ci < ctx.fp_count) {
            if (fp_available(ctx, ci) && !ctx.fp_callee_saved[ci]) {
                ctx.fp_busy[ci] = true;
                ret isa.regid_make(isa.REG_CLASS_ID_XMM, ci::i32);
            }
            ci = ci + 1;
        }
    }
    var fi: u32 = 0;
    for (fi < ctx.fp_count) {
        if (fp_available(ctx, fi)) {
            ctx.fp_busy[fi] = true;
            ret isa.regid_make(isa.REG_CLASS_ID_XMM, fi::i32);
        }
        fi = fi + 1;
    }
    ret -1;
}

fun assign(ctx: *AllocCtx, v: mir.VRegId, preg: mir.PRegId, reg_class: u32) {
    val preg_class: i32 = isa.regid_class(mir.preg_regid(preg));
    if (reg_class == REG_CLASS_GP) {
        if (preg_class != isa.REG_CLASS_ID_GP) {
            panic("regalloc: GP vreg assigned a non-GP register\n");
        }
    }
    or {
        if (preg_class != isa.REG_CLASS_ID_XMM) {
            panic("regalloc: float vreg assigned a non-XMM register\n");
        }
    }
    ctx.f.vregs[v.n].assigned    = preg;
    ctx.active[ctx.active_count] = v.n;
    ctx.active_count             = ctx.active_count + 1;
}

fun spill_on_pressure(ctx: *AllocCtx, v: mir.VRegId) err[fail.Fail] {
    val lr:     *LiveRange = ?ctx.ranges[v.n];
    val victim: mir.VRegId = find_spill_victim(ctx, lr.reg_class);
    if (mir.vreg_is_nil(victim)) {
        ret spill_vreg(ctx, v);
    }

    val vr: *LiveRange = ?ctx.ranges[victim.n];
    if (vr.end_pos < lr.end_pos) {
        ret spill_vreg(ctx, v);
    }

    val freed: mir.PRegId     = ctx.f.vregs[victim.n].assigned;
    val sr:    err[fail.Fail] = spill_vreg(ctx, victim);
    if (sel sr.err) { ret sr; }
    free_assigned_id(ctx, victim, lr.reg_class, freed);
    remove_active(ctx, victim);

    var preg: i32 = -1;
    if (lr.reg_class == REG_CLASS_GP) {
        preg = pick_gp(ctx, lr.crosses_call);
    }
    or {
        preg = pick_fp(ctx, lr.crosses_call);
    }
    if (preg >= 0) {
        assign(ctx, v, mir.preg_id(preg), lr.reg_class);
        ret err[fail.Fail].ok{};
    }
    ret spill_vreg(ctx, v);
}

fun free_assigned_id(ctx: *AllocCtx, v: mir.VRegId, reg_class: u32, preg: mir.PRegId) {
    val index: u32 = isa.regid_index(mir.preg_regid(preg))::u32;
    if (reg_class == REG_CLASS_GP) {
        if (index < ctx.gp_count) { ctx.gp_busy[index] = false; }
    }
    or {
        if (index < ctx.fp_count) { ctx.fp_busy[index] = false; }
    }
}

fun remove_active(ctx: *AllocCtx, v: mir.VRegId) {
    var write: u32 = 0;
    var read:  u32 = 0;
    for (read < ctx.active_count) {
        if (ctx.active[read] != v.n) {
            ctx.active[write] = ctx.active[read];
            write             = write + 1;
        }
        read = read + 1;
    }
    ctx.active_count = write;
}

fun find_spill_victim(ctx: *AllocCtx, reg_class: u32) mir.VRegId {
    var best:         mir.VRegId = mir.MIR_VREG_NIL;
    var best_density: i64        = POS_MAX;
    var best_crosses: bool       = true;
    var ai:           u32        = 0;
    for (ai < ctx.active_count) {
        val v:  u32        = ctx.active[ai];
        val lr: *LiveRange = ?ctx.ranges[v];
        if (lr.reg_class != reg_class) {
            ai = ai + 1;
            cnt;
        }
        if (ctx.anchor_until[v] >= ctx.cur_start) {
            ai = ai + 1;
            cnt;
        }

        val span:    i64 = lr.end_pos - lr.start;
        var density: i64 = lr.use_count::i64 * 1000;
        if (span > 0) { density = density / span; }

        var better: bool = false;
        if (!lr.crosses_call && best_crosses) {
            better = true;
        }
        or (lr.crosses_call == best_crosses && density < best_density) {
            better = true;
        }
        if (better) {
            best_density = density;
            best_crosses = lr.crosses_call;
            best         = mir.vreg_id(v);
        }
        ai = ai + 1;
    }
    ret best;
}

fun spill_vreg(ctx: *AllocCtx, v: mir.VRegId) err[fail.Fail] {
    val mv: *mir.MirVReg = ?ctx.f.vregs[v.n];
    if (mv.spill_slot >= 0) { ret err[fail.Fail].ok{}; }
    mv.assigned = mir.MIR_PREG_NIL;

    val size: u32                 = class_width(ctx, ?ctx.ranges[v.n]);
    val sr:   res[i32, fail.Fail] = add_spill_slot(ctx, v.n, size);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    mv.spill_slot = sr.ok;
    ret err[fail.Fail].ok{};
}

fun class_width(ctx: *AllocCtx, lr: *LiveRange) u32 {
    if (lr.reg_class != REG_CLASS_GP) { ret 16; }
    ret ctx.spill_width::u32;
}

fun spill_slot_align(ctx: *AllocCtx, value_id: u32) u32 {
    if (value_id < ctx.f.vreg_count && ctx.f.vregs[value_id].vector) { ret 16; }
    ret ctx.spill_width::u32;
}

fun add_spill_slot(ctx: *AllocCtx, value_id: u32, size: u32) res[i32, fail.Fail] {
    val frame: *mir.MirFrame = ?ctx.f.frame;
    if (frame.slot_count >= frame.slot_cap) {
        val current:    layout.CheckedCount[mir.MirSlot]                         = layout.count[mir.MirSlot](frame.slot_cap::usize);
        val required_r: res[layout.CheckedCount[mir.MirSlot], layout.CheckCause] =
            layout.count_add[mir.MirSlot](current, layout.count[mir.MirSlot](1::usize));
        if (sel required_r.err) {
            ret res[i32, fail.Fail].err{fail.message("regalloc: spill slot table growth count overflow")};
        }
        var required: layout.CheckedCount[mir.MirSlot] = required_r.ok;
        if (required.value < 8) { required = layout.count[mir.MirSlot](8::usize); }
        val grown_r: res[layout.CheckedCount[mir.MirSlot], layout.CheckCause] =
            layout.count_grow[mir.MirSlot](current, required);
        if (sel grown_r.err) {
            ret res[i32, fail.Fail].err{fail.message("regalloc: spill slot table growth count overflow")};
        }
        val new_cap_fits: res[u32, layout.CheckCause] = layout.usize_to_u32(
            grown_r.ok.value);
        if (sel new_cap_fits.err) {
            ret res[i32, fail.Fail].err{fail.message("regalloc: spill slot table capacity exceeds the u32 limit")};
        }
        val new_cap: u32                        = new_cap_fits.ok;
        val r:       res[*mir.MirSlot, A.Error] = A.reallocate[mir.MirSlot](ctx.alloc, frame.slots, frame.slot_cap::usize, new_cap::usize);
        if (sel r.err) { ret res[i32, fail.Fail].err{fail.refused(r.err)}; }
        frame.slots    = r.ok;
        frame.slot_cap = new_cap;
    }
    val si:      u32                         = frame.slot_count;
    val si_fits: res[i32, layout.CheckCause] = layout.usize_to_i32(si::usize);
    if (sel si_fits.err) {
        ret res[i32, fail.Fail].err{fail.message("regalloc: spill slot index exceeds the i32 limit")};
    }
    frame.slots[si].value  = value_id;
    frame.slots[si].kind   = mir.SLOT_SPILL;
    frame.slots[si].offset = 0;
    frame.slots[si].size   = size;
    frame.slots[si].align  = spill_slot_align(ctx, value_id);
    frame.slot_count       = frame.slot_count + 1;
    ret res[i32, fail.Fail].ok{si_fits.ok};
}

fun asm_instr_clobbers(tgt: *target.Target, mi: *mir.MirInstr, gp: *u32, fp: *u32) bool {
    if (mi.asm_block == nil) { ret false; }
    @gp = 0;
    @fp = 0;
    if (!tgt.arch.has_assembly) {
        @gp = 0xFFFFFFFF;
        @fp = 0xFFFFFFFF;
        ret true;
    }
    tgt.arch.assembly.clobbers(mi.asm_block.body, gp, fp);
    ret true;
}

fun asm_clobbers_at(tgt: *target.Target, ctx: *AllocCtx, pos: u32, gp: *u32, fp: *u32) bool {
    ret asm_instr_clobbers(tgt, flat_instr(ctx, pos), gp, fp);
}

fun abi_callee_saved_gp_mask(tgt: *target.Target) u32 {
    var regs: [32]isa.Register;
    val fill: abi.RegFileFn = tgt.abi.callee_saved;
    val n:    i32           = fill(?regs[0]);
    var m:    u32           = 0;
    var i:    i32           = 0;
    for (i < n && i < MAX_REG_FILE) {
        val id: i32 = regs[i].id;
        if (isa.regid_class(id) == isa.REG_CLASS_ID_GP && id >= 0 && id < 32) {
            m = m | (1::u32 << id::u32);
        }
        i = i + 1;
    }
    ret m;
}

fun abi_callee_saved_fp_mask(tgt: *target.Target) u32 {
    var regs: [32]isa.Register;
    val fill: abi.RegFileFn = tgt.abi.callee_saved;
    val n:    i32           = fill(?regs[0]);
    var m:    u32           = 0;
    var i:    i32           = 0;
    for (i < n && i < MAX_REG_FILE) {
        val id: i32 = regs[i].id;
        if (isa.regid_class(id) == isa.REG_CLASS_ID_XMM) {
            val idx: i32 = isa.regid_index(id);
            if (idx >= 0 && idx < 32) { m = m | (1::u32 << idx::u32); }
        }
        i = i + 1;
    }
    ret m;
}

fun fp_scratch_callee_mask(tgt: *target.Target) u32 {
    val cs: u32 = abi_callee_saved_fp_mask(tgt);
    if (cs == 0) { ret 0; }
    val fpc:        u32 = bank_count(tgt, fp_class_index(tgt));
    var alloc_mask: u32 = 0;
    var i:          u32 = 0;
    for (i < fpc && i < 32) {
        alloc_mask = alloc_mask | (1::u32 << i);
        i          = i + 1;
    }
    ret cs & ~alloc_mask;
}

fun function_uses_fp_scratch(f: *mir.MirFunction) bool {
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            val o:  mir.MirOpcode = mi.opcode;
            if (mi.vec_lane != mir.VEC_LANE_NONE) { ret true; }
            if (mir.has(o, mir.MIRF_FLOAT_UNIT))  { ret true; }
            if (o == mir.MIR_MOV) {
                if (mi.width == 16) { ret true; }
                var k: u32 = 0;
                for (k < mi.operand_count) {
                    val op: *mir.MirOperand = ?mi.operands[k];
                    if (op.kind == mir.MIR_OP_VREG && mir.vreg_is_fp(f, op.vreg)) {
                        ret true;
                    }
                    if (op.kind == mir.MIR_OP_PREG &&
                        isa.regid_class(mir.preg_regid(op.preg)) == isa.REG_CLASS_ID_XMM) {
                        ret true;
                    }
                    k = k + 1;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

fun isa_reserved_gp_mask(tgt: *target.Target) u32 {
    var m: u32 = 0;
    var i: i32 = 0;
    for (i < tgt.arch.reserved_reg_count && i < MAX_REG_FILE) {
        val id: i32 = tgt.arch.reserved_regs[i].id;
        if (id >= 0 && id < 32) { m = m | (1::u32 << id::u32); }
        i = i + 1;
    }
    var j: i32 = 0;
    for (j < tgt.arch.reload_scratch_count && j < MAX_REG_FILE) {
        val id: i32 = tgt.arch.reload_scratch_regs[j].id;
        if (id >= 0 && id < 32) { m = m | (1::u32 << id::u32); }
        j = j + 1;
    }
    val sid: i32 = tgt.arch.scratch_reg;
    if (sid >= 0 && sid < 32) { m = m | (1::u32 << sid::u32); }
    ret m;
}

fun asm_callee_mask(tgt: *target.Target, f: *mir.MirFunction) u32 {
    val cs:     u32 = abi_callee_saved_gp_mask(tgt);
    val result: u32 = isa_reserved_gp_mask(tgt);
    var mask:   u32 = 0;
    var bi:     u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            var agp: u32 = 0;
            var afp: u32 = 0;
            if (asm_instr_clobbers(tgt, ?blk.instrs[ii], ?agp, ?afp)) {
                mask = mask | (agp & cs & ~result);
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret mask;
}

fun asm_callee_mask_fp(tgt: *target.Target, f: *mir.MirFunction) u32 {
    val cs:   u32 = abi_callee_saved_fp_mask(tgt);
    var mask: u32 = 0;
    var bi:   u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            var agp: u32 = 0;
            var afp: u32 = 0;
            if (asm_instr_clobbers(tgt, ?blk.instrs[ii], ?agp, ?afp)) {
                mask = mask | (afp & cs);
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret mask;
}

fun spill_across_calls(tgt: *target.Target, ctx: *AllocCtx) err[fail.Fail] {
    var pos: u32 = 0;
    for (pos < ctx.flat_count) {
        if (!ctx.flat[pos].is_call) {
            pos = pos + 1;
            cnt;
        }
        var asm_gp: u32  = 0;
        var asm_fp: u32  = 0;
        val is_asm: bool = asm_clobbers_at(tgt, ctx, pos, ?asm_gp, ?asm_fp);
        var v:      u32  = 0;
        for (v < ctx.f.vreg_count) {
            val mv: *mir.MirVReg = ?ctx.f.vregs[v];
            if (mir.preg_is_nil(mv.assigned)) {
                v = v + 1;
                cnt;
            }
            if (mv.spill_slot >= 0) {
                v = v + 1;
                cnt;
            }
            val lr: *LiveRange = ?ctx.ranges[v];
            if (lr.start >= pos::i64 || lr.end_pos <= pos::i64) {
                v = v + 1;
                cnt;
            }

            var must_spill: bool = false;
            if (lr.reg_class != REG_CLASS_GP) {
                val xidx: u32 = isa.regid_index(mir.preg_regid(mv.assigned))::u32;
                if (xidx >= ctx.fp_count || !ctx.fp_callee_saved[xidx]) {
                    must_spill = true;
                }
                or (mv.vector && !tgt.abi.fp_callee_saved_full_vector) {
                    must_spill = true;
                }
                or (is_asm && (asm_fp & (1::u32 << xidx)) != 0) {
                    must_spill = true;
                }
            }
            or (isa.regid_index(mir.preg_regid(mv.assigned))::u32 < ctx.gp_count
                && !ctx.callee_saved[isa.regid_index(mir.preg_regid(mv.assigned))::u32]) {
                must_spill = true;
            }
            or (is_asm && isa.regid_index(mir.preg_regid(mv.assigned))::u32 < ctx.gp_count
                && (asm_gp & (1::u32 << isa.regid_index(mir.preg_regid(mv.assigned))::u32)) != 0) {
                must_spill = true;
            }
            if (must_spill) {
                val sr: err[fail.Fail] = spill_vreg(ctx, mir.vreg_id(v));
                if (sel sr.err) { ret sr; }
            }
            v = v + 1;
        }
        pos = pos + 1;
    }
    ret err[fail.Fail].ok{};
}

fun rewritten_preg_ok(tgt: *target.Target, preg: mir.PRegId) bool {
    val rid:    i32 = mir.preg_regid(preg);
    val rclass: i32 = isa.regid_class(rid);
    val ridx:   i32 = isa.regid_index(rid);
    if (ridx < 0) { ret false; }
    if (rclass == isa.REG_CLASS_ID_GP) {
        if (ridx::u32 < bank_count(tgt, REG_CLASS_GP)) { ret true; }
        ret special_gp_register(tgt, rid);
    }
    if (rclass == isa.REG_CLASS_ID_XMM) { ret ridx::u32 < bank_count(tgt, fp_class_index(tgt)); }
    ret false;
}

fun special_gp_register(tgt: *target.Target, rid: i32) bool {
    if (rid == tgt.model.stack_ptr_reg || rid == tgt.model.frame_ptr_reg) { ret true; }
    if (rid == tgt.arch.scratch_reg || rid == tgt.arch.scratch_reg2)      { ret true; }
    var i: i32 = 0;
    for (i < tgt.arch.reserved_reg_count && i < MAX_REG_FILE) {
        if (tgt.arch.reserved_regs[i].id == rid) { ret true; }
        i = i + 1;
    }
    var j: i32 = 0;
    for (j < tgt.arch.reload_scratch_count && j < MAX_REG_FILE) {
        if (tgt.arch.reload_scratch_regs[j].id == rid) { ret true; }
        j = j + 1;
    }
    ret false;
}

fun operand_bank_matches(op: *mir.MirOperand) bool {
    val class: i32 = isa.regid_class(mir.preg_regid(op.preg));
    ret (op.required_bank == mir.BANK_GP && class == isa.REG_CLASS_ID_GP)
        || (op.required_bank == mir.BANK_FP && class == isa.REG_CLASS_ID_XMM);
}

fun verify_rewritten_operands(tgt: *target.Target, f: *mir.MirFunction) err[fail.Fail] {
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            var k:  u32           = 0;
            for (k < mi.operand_count) {
                val op: *mir.MirOperand = ?mi.operands[k];
                if (op.kind == mir.MIR_OP_VREG) {
                    ret err[fail.Fail].err{fail.message("regalloc: a virtual register survived rewriting")};
                }
                if (op.kind == mir.MIR_OP_PREG && !rewritten_preg_ok(tgt, op.preg)) {
                    ret err[fail.Fail].err{fail.message("regalloc: a rewritten operand names a physical register outside every register class")};
                }
                if (op.kind == mir.MIR_OP_PREG && !operand_bank_matches(op)) {
                    ret err[fail.Fail].err{fail.message("regalloc: a rewritten register operand violates its selected bank constraint")};
                }
                if (op.kind == mir.MIR_OP_MEM) {
                    if (mir.vreg_is_nil(op.vreg)
                        && (!rewritten_preg_ok(tgt, op.preg) || isa.regid_class(mir.preg_regid(op.preg)) != isa.REG_CLASS_ID_GP)) {
                        ret err[fail.Fail].err{fail.message("regalloc: a rewritten memory base is not a valid general-bank register")};
                    }
                    if (sel op.index.preg
                        && (!rewritten_preg_ok(tgt, op.index.preg) || isa.regid_class(mir.preg_regid(op.index.preg)) != isa.REG_CLASS_ID_GP)) {
                        ret err[fail.Fail].err{fail.message("regalloc: a rewritten memory index is not a valid general-bank register")};
                    }
                }
                k = k + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun verify_allocation(tgt: *target.Target, ctx: *AllocCtx) err[fail.Fail] {
    var v: u32 = 0;
    for (v < ctx.f.vreg_count) {
        val mv: *mir.MirVReg = ?ctx.f.vregs[v];
        if (mir.preg_is_nil(mv.assigned)) {
            v = v + 1;
            cnt;
        }
        val lr: *LiveRange = ?ctx.ranges[v];

        val rid:    i32 = mir.preg_regid(mv.assigned);
        val rclass: i32 = isa.regid_class(rid);
        val ridx:   i32 = isa.regid_index(rid);

        if (lr.reg_class == REG_CLASS_GP) {
            if (rclass != isa.REG_CLASS_ID_GP || ridx < 0 || ridx::u32 >= ctx.gp_count) {
                ret err[fail.Fail].err{fail.message(regalloc_msg(ctx, "regalloc: invalid GP register id assigned in '", "'", "regalloc: invalid GP register id assigned"))};
            }
            if (ctx.reserved[ridx::u32]) {
                ret err[fail.Fail].err{fail.message(regalloc_msg(ctx, "regalloc: a reserved register was assigned in '", "'", "regalloc: a reserved register was assigned"))};
            }
        }
        or {
            if (rclass != isa.REG_CLASS_ID_XMM || ridx < 0 || ridx::u32 >= ctx.fp_count) {
                ret err[fail.Fail].err{fail.message(regalloc_msg(ctx, "regalloc: invalid FP register id assigned in '", "'", "regalloc: invalid FP register id assigned"))};
            }
        }
        v = v + 1;
    }
    ret err[fail.Fail].ok{};
}

fun record_callee_mask(tgt: *target.Target, ctx: *AllocCtx) {
    var mask:    u32 = 0;
    var fp_mask: u32 = 0;
    var v:       u32 = 0;
    for (v < ctx.f.vreg_count) {
        val mv: *mir.MirVReg = ?ctx.f.vregs[v];
        if (mir.preg_is_nil(mv.assigned)) {
            v = v + 1;
            cnt;
        }
        val lr: *LiveRange = ?ctx.ranges[v];
        if (lr.reg_class == REG_CLASS_GP) {
            val gidx: u32 = isa.regid_index(mir.preg_regid(mv.assigned))::u32;
            if (gidx < ctx.gp_count && ctx.callee_saved[gidx] && !ctx.reserved[gidx]) {
                mask = mask | (1::u32 << gidx);
            }
        }
        or {
            val xidx: u32 = isa.regid_index(mir.preg_regid(mv.assigned))::u32;
            if (ctx.fp_callee_saved != nil && xidx < ctx.fp_count && ctx.fp_callee_saved[xidx]) {
                fp_mask = fp_mask | (1::u32 << xidx);
            }
        }
        v = v + 1;
    }

    mask    = mask | asm_callee_mask(tgt, ctx.f);
    fp_mask = fp_mask | asm_callee_mask_fp(tgt, ctx.f);

    val fp_scratch: u32 = fp_scratch_callee_mask(tgt);
    if (fp_scratch != 0 && function_uses_fp_scratch(ctx.f)) {
        fp_mask = fp_mask | fp_scratch;
    }

    ctx.f.callee_mask    = mask;
    ctx.f.callee_mask_fp = fp_mask;
}

fun drop_self_copies_physical(tgt: *target.Target, ctx: *AllocCtx) {
    val f:  *mir.MirFunction = ctx.f;
    var bi: u32              = 0;
    for (bi < f.block_count) {
        val blk:   *mir.MirBlock = ?f.blocks[bi];
        var write: u32           = 0;
        var read:  u32           = 0;
        for (read < blk.instr_count) {
            val mi:   *mir.MirInstr = ?blk.instrs[read];
            var drop: bool          = false;
            if (instr_is_reg_copy(tgt, mi)) {
                val a: *mir.MirOperand = ?mi.operands[0];
                val b: *mir.MirOperand = ?mi.operands[1];
                drop = a.kind == mir.MIR_OP_PREG && b.kind == mir.MIR_OP_PREG && mir.preg_same(a.preg, b.preg);
            }
            if (drop && mir.instr_declassifies(mi)) {
                val marker: mir.MirInstr = mir.declassify_marker(mi, mi.operands[0].vreg);
                A.deallocate[mir.MirOperand](ctx.alloc, mi.operands, mi.operand_count::usize);
                blk.instrs[write] = marker;
                write             = write + 1;
            }
            or (drop) {
                if (mi.operands != nil && mi.operand_count > 0) {
                    A.deallocate[mir.MirOperand](ctx.alloc, mi.operands, mi.operand_count::usize);
                }
                if (mi.dbg_bindings != nil && mi.dbg_binding_count > 0) {
                    A.deallocate[mir.MirDbgBinding](ctx.alloc, mi.dbg_bindings, mi.dbg_binding_count::usize);
                }
            }
            or {
                if (write != read) { blk.instrs[write] = blk.instrs[read]; }
                write = write + 1;
            }
            read = read + 1;
        }
        blk.instr_count = write;
        bi              = bi + 1;
    }
}

fun rewrite(tgt: *target.Target, ctx: *AllocCtx) err[fail.Fail] {
    val f:         *mir.MirFunction = ctx.f;
    var bi:        u32              = 0;
    var flat_base: u32              = 0;
    for (bi < f.block_count) {
        val blk:        *mir.MirBlock  = ?f.blocks[bi];
        val orig_count: u32            = blk.instr_count;
        val rb:         err[fail.Fail] = rewrite_block(tgt, ctx, blk, bi == 0, flat_base);
        if (sel rb.err) { ret rb; }
        flat_base = flat_base + orig_count;
        bi        = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun rewrite_block(tgt: *target.Target, ctx: *AllocCtx, blk: *mir.MirBlock, is_entry: bool, flat_base: u32) err[fail.Fail] {
    if (blk.instr_count == 0) { ret err[fail.Fail].ok{}; }

    var total: u32 = 0;
    var ii:    u32 = 0;
    for (ii < blk.instr_count) {
        total = total + 1 + extra_movs(ctx, ?blk.instrs[ii]);
        ii    = ii + 1;
    }

    val rn: res[*mir.MirInstr, A.Error] = A.zallocate[mir.MirInstr](ctx.alloc, total::usize);
    if (sel rn.err) { ret err[fail.Fail].err{fail.refused(rn.err)}; }
    val dst: *mir.MirInstr = rn.ok;
    var w:   u32           = 0;

    ii = 0;
    for (ii < blk.instr_count) {
        val mi: *mir.MirInstr  = ?blk.instrs[ii];
        val re: err[fail.Fail] = rewrite_instr(tgt, ctx, mi, dst, ?w, is_entry, flat_base + ii);
        if (sel re.err) {
            var d: u32 = 0;
            for (d < w) {
                if (dst[d].operands != nil && dst[d].operand_count > 0) {
                    A.deallocate[mir.MirOperand](ctx.alloc, dst[d].operands, dst[d].operand_count::usize);
                }
                d = d + 1;
            }
            A.deallocate[mir.MirInstr](ctx.alloc, dst, total::usize);
            ret re;
        }
        ii = ii + 1;
    }

    if (blk.instrs != nil && blk.instr_cap > 0) {
        A.deallocate[mir.MirInstr](ctx.alloc, blk.instrs, blk.instr_cap::usize);
    }
    blk.instrs      = dst;
    blk.instr_count = w;
    blk.instr_cap   = total;
    ret err[fail.Fail].ok{};
}

fun extra_movs(ctx: *AllocCtx, mi: *mir.MirInstr) u32 {
    var n:       u32  = 0;
    val has_def: bool = instr_defines(mi);
    var k:       u32  = 0;
    for (k < mi.operand_count) {
        val op: *mir.MirOperand = ?mi.operands[k];
        if (op.kind == mir.MIR_OP_VREG) {
            if (is_spilled(ctx, op.vreg)) { n = n + 1; }
        }
        or (op.kind == mir.MIR_OP_MEM && !mir.vreg_is_nil(op.vreg)) {
            if (is_spilled(ctx, op.vreg)) { n = n + 1; }
        }
        if (sel op.index.vreg) {
            if (is_spilled(ctx, op.index.vreg)) { n = n + 1; }
        }
        k = k + 1;
    }
    ret n;
}

fun is_spilled(ctx: *AllocCtx, v: mir.VRegId) bool {
    if (v.n >= ctx.f.vreg_count) { ret false; }
    ret ctx.f.vregs[v.n].spill_slot >= 0;
}

fun is_fp_vreg(ctx: *AllocCtx, v: mir.VRegId) bool {
    if (v.n >= ctx.f.vreg_count) { ret false; }
    ret ctx.f.vregs[v.n].class != REG_CLASS_GP;
}

fun is_storage_slot(ctx: *AllocCtx, v: mir.VRegId) bool {
    if (is_spilled(ctx, v)) { ret false; }
    ret vreg_has_slot(ctx, v);
}

fun rewrite_instr(tgt: *target.Target, ctx: *AllocCtx, mi: *mir.MirInstr,
    dst: *mir.MirInstr, wp: *u32, is_entry: bool, src_pos: u32) err[fail.Fail] {
    val n:   u32             = mi.operand_count;
    var ops: *mir.MirOperand = nil;
    if (n > 0) {
        val ro: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, n::usize);
        if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
        ops = ro.ok;
        var c: u32 = 0;
        for (c < n) {
            ops[c] = mi.operands[c];
            c      = c + 1;
        }
    }

    val has_def: bool = instr_defines_ops(mi, ops, n);

    var claimed:       [16]i32;
    var claimed_count: u32 = 0;
    var ci:            u32 = 0;
    for (ci < 16) {
        claimed[ci] = -1;
        ci          = ci + 1;
    }

    var store_dst_vreg:     mir.VRegId = mir.MIR_VREG_NIL;
    var store_dst_tmp:      i32        = -1;
    var store_dst_reloaded: bool       = false;

    var k: u32 = 0;
    for (k < n) {
        val op: *mir.MirOperand = ?ops[k];
        if (op.kind == mir.MIR_OP_VREG) {
            val v: mir.VRegId = op.vreg;
            if (has_def && k == 0) {
                if (is_fp_vreg(ctx, v) && is_spilled(ctx, v)) {
                    ops[k] = mir.op_mem_slot(v, 0);
                }
                or (is_spilled(ctx, v)) {
                    val tmp: i32 = reload_temp(ctx, ?claimed[0], claimed_count, is_entry, src_pos);
                    if (tmp < 0) {
                        free_ops(ctx, ops, n);
                        ret err[fail.Fail].err{fail.message(regalloc_msg(ctx, "regalloc: no free register for spilled destination in '", "'", "regalloc: no free register for spilled destination"))};
                    }
                    claimed[claimed_count] = tmp;
                    claimed_count          = claimed_count + 1;
                    ops[k]                 = mir.op_preg_of(mir.preg_id(tmp), v);
                    store_dst_vreg         = v;
                    store_dst_tmp          = tmp;
                }
                or {
                    ops[k] = preg_of(ctx, v);
                }
            }
            or {
                if (is_fp_vreg(ctx, v) && is_spilled(ctx, v)) {
                    ops[k] = mir.op_mem_slot(v, 0);
                }
                or (store_dst_tmp >= 0 && mir.vreg_same(v, store_dst_vreg)) {
                    if (!store_dst_reloaded) {
                        val er: err[fail.Fail] = emit_reload(ctx, dst, wp, mir.preg_id(store_dst_tmp), v, mi.loc, mi.inline_site);
                        if (sel er.err) {
                            free_ops(ctx, ops, n);
                            ret er;
                        }
                        store_dst_reloaded = true;
                    }
                    ops[k] = mir.op_preg_of(mir.preg_id(store_dst_tmp), v);
                }
                or (is_spilled(ctx, v)) {
                    val tmp: i32 = reload_temp(ctx, ?claimed[0], claimed_count, is_entry, src_pos);
                    if (tmp < 0) {
                        free_ops(ctx, ops, n);
                        ret err[fail.Fail].err{fail.message(regalloc_msg(ctx, "regalloc: no free register for spilled source in '", "'", "regalloc: no free register for spilled source"))};
                    }
                    claimed[claimed_count] = tmp;
                    claimed_count          = claimed_count + 1;
                    val er: err[fail.Fail] = emit_reload(ctx, dst, wp, mir.preg_id(tmp), v, mi.loc, mi.inline_site);
                    if (sel er.err) {
                        free_ops(ctx, ops, n);
                        ret er;
                    }
                    ops[k] = mir.op_preg_of(mir.preg_id(tmp), v);
                }
                or {
                    ops[k] = preg_of(ctx, v);
                }
            }
        }
        or (op.kind == mir.MIR_OP_MEM) {
            if (!mir.vreg_is_nil(op.vreg)) {
                val v: mir.VRegId = op.vreg;
                if (is_storage_slot(ctx, v)) {}
                or (is_spilled(ctx, v)) {
                    val tmp: i32 = reload_temp(ctx, ?claimed[0], claimed_count, is_entry, src_pos);
                    if (tmp < 0) {
                        free_ops(ctx, ops, n);
                        ret err[fail.Fail].err{fail.message(regalloc_msg(ctx, "regalloc: no free register for spilled MEM base in '", "'", "regalloc: no free register for spilled MEM base"))};
                    }
                    claimed[claimed_count] = tmp;
                    claimed_count          = claimed_count + 1;
                    val er: err[fail.Fail] = emit_reload(ctx, dst, wp, mir.preg_id(tmp), v, mi.loc, mi.inline_site);
                    if (sel er.err) {
                        free_ops(ctx, ops, n);
                        ret er;
                    }
                    ops[k].vreg = mir.MIR_VREG_NIL;
                    ops[k].preg = mir.preg_id(tmp);
                }
                or {
                    ops[k].vreg = mir.MIR_VREG_NIL;
                    ops[k].preg = assigned_preg(ctx, v);
                }
            }
            var iv: mir.VRegId = mir.MIR_VREG_NIL;
            if (sel ops[k].index.vreg) { iv = ops[k].index.vreg; }
            if (!mir.vreg_is_nil(iv)) {
                if (is_spilled(ctx, iv)) {
                    val tmp: i32 = reload_temp(ctx, ?claimed[0], claimed_count, is_entry, src_pos);
                    if (tmp < 0) {
                        free_ops(ctx, ops, n);
                        ret err[fail.Fail].err{fail.message(regalloc_msg(ctx, "regalloc: no free register for spilled MEM index in '", "'", "regalloc: no free register for spilled MEM index"))};
                    }
                    claimed[claimed_count] = tmp;
                    claimed_count          = claimed_count + 1;
                    val er: err[fail.Fail] = emit_reload(ctx, dst, wp, mir.preg_id(tmp), iv, mi.loc, mi.inline_site);
                    if (sel er.err) {
                        free_ops(ctx, ops, n);
                        ret er;
                    }
                    ops[k].index = mir.index_preg(mir.preg_id(tmp));
                }
                or {
                    ops[k].index = mir.index_preg(assigned_preg(ctx, iv));
                }
            }
        }
        ops[k].required_bank = mi.operands[k].required_bank;
        k                    = k + 1;
    }

    if (mir.vreg_is_nil(store_dst_vreg)
        && mi.width >= ctx.spill_width
        && instr_is_reg_copy(tgt, mi)
        && ops[0].kind == mir.MIR_OP_PREG && ops[1].kind == mir.MIR_OP_PREG
        && mir.preg_same(ops[0].preg, ops[1].preg)
        && operand_bank_matches(?ops[0]) && operand_bank_matches(?ops[1])) {
        # a declassify keeps a zero-byte marker: the barrier must reach the
        # stream even when the move it selected to is a self-copy
        if (mir.instr_declassifies(mi)) {
            dst[@wp] = mir.declassify_marker(mi, ops[0].vreg);
            @wp      = @wp + 1;
            free_ops(ctx, ops, n);
            if (mi.operands != nil && mi.operand_count > 0) {
                A.deallocate[mir.MirOperand](ctx.alloc, mi.operands, mi.operand_count::usize);
            }
            ret err[fail.Fail].ok{};
        }
        free_ops(ctx, ops, n);
        if (mi.dbg_binding_count > 0) {
            dst[@wp].opcode            = isa.ISA_USE::mir.MirOpcode;
            dst[@wp].width             = mi.width;
            dst[@wp].src_width         = mi.src_width;
            dst[@wp].loc               = mi.loc;
            dst[@wp].inline_site       = mi.inline_site;
            dst[@wp].dbg_bindings      = mi.dbg_bindings;
            dst[@wp].dbg_binding_count = mi.dbg_binding_count;
            @wp                        = @wp + 1;
        }
        if (mi.operands != nil && mi.operand_count > 0) {
            A.deallocate[mir.MirOperand](ctx.alloc, mi.operands, mi.operand_count::usize);
        }
        ret err[fail.Fail].ok{};
    }

    dst[@wp] = mir.instr_like(mi, ops, n);
    @wp      = @wp + 1;

    if (mi.operands != nil && mi.operand_count > 0) {
        A.deallocate[mir.MirOperand](ctx.alloc, mi.operands, mi.operand_count::usize);
    }

    if (!mir.vreg_is_nil(store_dst_vreg)) {
        val sr: err[fail.Fail] = emit_store(ctx, dst, wp, store_dst_vreg, mir.preg_id(store_dst_tmp), mi.loc, mi.inline_site);
        if (sel sr.err) { ret sr; }
    }
    ret err[fail.Fail].ok{};
}

fun instr_defines_ops(mi: *mir.MirInstr, ops: *mir.MirOperand, n: u32) bool {
    if (n == 0)                       { ret false; }
    if (!mir.instr_defines_shape(mi)) { ret false; }
    ret ops[0].kind == mir.MIR_OP_VREG;
}

# the rewritten operand keeps its origin vreg as provenance: the seed the
# physical secrecy walk reads at the instruction the notification names
fun preg_of(ctx: *AllocCtx, v: mir.VRegId) mir.MirOperand {
    ret mir.op_preg_of(assigned_preg(ctx, v), v);
}

fun assigned_preg(ctx: *AllocCtx, v: mir.VRegId) mir.PRegId {
    if (v.n >= ctx.f.vreg_count) {
        panic("regalloc: operand vreg id out of range during rewrite\n");
    }
    val a: mir.PRegId = ctx.f.vregs[v.n].assigned;
    if (mir.preg_is_nil(a)) {
        panic("regalloc: unassigned vreg reached instruction rewrite\n");
    }
    ret a;
}

fun reload_temp(ctx: *AllocCtx, claimed: *i32, claimed_count: u32,
    is_entry: bool, src_pos: u32) i32 {
    var i: i32 = 0;
    for (i < ctx.reload_scratch_count) {
        val id: i32 = ctx.reload_scratch[i].id;
        if (id_claimed(claimed, claimed_count, id)) {
            i = i + 1;
            cnt;
        }
        if (is_entry && id::u32 < ctx.gp_count
            && ctx.param_reg_end[id] >= 0 && src_pos::i64 <= ctx.param_reg_end[id]) {
            i = i + 1;
            cnt;
        }
        if (id::u32 < ctx.gp_count && arg_reg_busy_at(ctx, id::u32, src_pos)) {
            i = i + 1;
            cnt;
        }
        ret id;
    }
    ret -1;
}

fun id_claimed(claimed: *i32, count: u32, id: i32) bool {
    var i: u32 = 0;
    for (i < count) {
        if (claimed[i] == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun emit_reload(ctx: *AllocCtx, dst: *mir.MirInstr, wp: *u32, tmp: mir.PRegId, v: mir.VRegId, loc: source.SrcLoc, inline_site: u32) err[fail.Fail] {
    if (isa.regid_class(mir.preg_regid(tmp)) != isa.REG_CLASS_ID_GP) {
        ret err[fail.Fail].err{fail.message("regalloc: spill transport requires a general-bank scratch register")};
    }
    val ro: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
    val ops: *mir.MirOperand = ro.ok;
    ops[0]                 = mir.op_preg_of(tmp, v);
    ops[0].required_bank   = mir.BANK_GP;
    ops[1]                 = mir.op_mem_slot(v, 0);
    dst[@wp].opcode        = mir.MIR_MOV;
    dst[@wp].operands      = ops;
    dst[@wp].operand_count = 2;
    dst[@wp].width         = ctx.spill_width;
    dst[@wp].src_width     = ctx.spill_width;
    dst[@wp].loc           = loc;
    dst[@wp].inline_site   = inline_site;
    @wp                    = @wp + 1;
    ret err[fail.Fail].ok{};
}

fun emit_store(ctx: *AllocCtx, dst: *mir.MirInstr, wp: *u32, v: mir.VRegId, tmp: mir.PRegId, loc: source.SrcLoc, inline_site: u32) err[fail.Fail] {
    if (isa.regid_class(mir.preg_regid(tmp)) != isa.REG_CLASS_ID_GP) {
        ret err[fail.Fail].err{fail.message("regalloc: spill transport requires a general-bank scratch register")};
    }
    val ro: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
    val ops: *mir.MirOperand = ro.ok;
    ops[0]                 = mir.op_mem_slot(v, 0);
    ops[1]                 = mir.op_preg_of(tmp, v);
    ops[1].required_bank   = mir.BANK_GP;
    dst[@wp].opcode        = mir.MIR_MOV;
    dst[@wp].operands      = ops;
    dst[@wp].operand_count = 2;
    dst[@wp].width         = ctx.spill_width;
    dst[@wp].src_width     = ctx.spill_width;
    dst[@wp].loc           = loc;
    dst[@wp].inline_site   = inline_site;
    @wp                    = @wp + 1;
    ret err[fail.Fail].ok{};
}

fun free_ops(ctx: *AllocCtx, ops: *mir.MirOperand, n: u32) {
    if (ops != nil && n > 0) {
        A.deallocate[mir.MirOperand](ctx.alloc, ops, n::usize);
    }
}

test "mach.lang.be.codegen.regalloc.seed_reserved:aarch64_reserved_and_fp_bank" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val rr: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel rr.err) { ret 1; }

    val ts: res[target.Target, fail.Fail] = target.select(?reg, "aarch64", "linux", "aapcs64");
    if (sel ts.err) { ret 1; }
    var t: target.Target = ts.ok;

    var ctx: AllocCtx;
    ctx.gp_count = bank_count(?t, REG_CLASS_GP);
    var reserved: [64]bool;
    var i:        u32 = 0;
    for (i < 64) {
        reserved[i] = false;
        i           = i + 1;
    }
    ctx.reserved = ?reserved[0];

    seed_reserved(?t, ?ctx);

    if (!reserved[30]) { ret 1; }
    if (!reserved[16]) { ret 1; }
    if (!reserved[17]) { ret 1; }

    if (bank_count(?t, fp_class_index(?t)) != 30) { ret 1; }

    ret 0;
}

test "mach.lang.be.codegen.regalloc.seed_reserved:x18_reserved_on_darwin_only" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val rr: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel rr.err) { ret 1; }

    val ls: res[target.Target, fail.Fail] = target.select(?reg, "aarch64", "linux", "aapcs64");
    if (sel ls.err) { ret 2; }
    var tl:   target.Target = ls.ok;
    var ctxl: AllocCtx;
    ctxl.gp_count = bank_count(?tl, REG_CLASS_GP);
    var reservedl: [64]bool;
    var il:        u32 = 0;
    for (il < 64) {
        reservedl[il] = false;
        il            = il + 1;
    }
    ctxl.reserved = ?reservedl[0];
    seed_reserved(?tl, ?ctxl);
    if (reservedl[18]) { ret 3; }

    val ds: res[target.Target, fail.Fail] = target.select(?reg, "aarch64", "darwin", "aapcs64");
    if (sel ds.err) { ret 4; }
    var td:   target.Target = ds.ok;
    var ctxd: AllocCtx;
    ctxd.gp_count = bank_count(?td, REG_CLASS_GP);
    var reservedd: [64]bool;
    var id:        u32 = 0;
    for (id < 64) {
        reservedd[id] = false;
        id            = id + 1;
    }
    ctxd.reserved = ?reservedd[0];
    seed_reserved(?td, ?ctxd);
    if (!reservedd[18]) { ret 5; }

    ret 0;
}

test "mach.lang.be.codegen.regalloc.verify_allocation:accepts_a_well_formed_assignment" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_2920: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2920.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    var vregs: [2]mir.MirVReg;
    vregs[0]          = mir.vreg(0, REG_CLASS_GP, false, false);
    vregs[0].assigned = mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_GP, 0));
    vregs[1]          = mir.vreg(1, 1, false, false);
    vregs[1].assigned = mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 0));

    var f: mir.MirFunction;
    f.vregs      = ?vregs[0];
    f.vreg_count = 2;

    var ranges: [2]LiveRange;
    ranges[0].reg_class = REG_CLASS_GP;
    ranges[1].reg_class = 1;

    var reserved: [4]bool;
    var ri:       u32 = 0;
    for (ri < 4) {
        reserved[ri] = false;
        ri           = ri + 1;
    }

    var ctx: AllocCtx;
    ctx.alloc    = ?alloc;
    ctx.interner = nil;
    ctx.f        = ?f;
    ctx.ranges   = ?ranges[0];
    ctx.gp_count = 4;
    ctx.fp_count = 4;
    ctx.reserved = ?reserved[0];

    val vr: err[fail.Fail] = verify_allocation(?tgt, ?ctx);
    if (sel vr.err) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.regalloc.verify_allocation:rejects_a_cross_class_register_id" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_2963: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2963.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    var vregs: [1]mir.MirVReg;
    vregs[0]          = mir.vreg(0, REG_CLASS_GP, false, false);
    vregs[0].assigned = mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 0));

    var f: mir.MirFunction;
    f.vregs      = ?vregs[0];
    f.vreg_count = 1;

    var ranges: [1]LiveRange;
    ranges[0].reg_class = REG_CLASS_GP;

    var reserved: [4]bool;
    var ri:       u32 = 0;
    for (ri < 4) {
        reserved[ri] = false;
        ri           = ri + 1;
    }

    var itn: intern.Interner = intern.init(?alloc);
    var ctx: AllocCtx;
    ctx.alloc    = ?alloc;
    ctx.interner = ?itn;
    ctx.f        = ?f;
    ctx.ranges   = ?ranges[0];
    ctx.gp_count = 4;
    ctx.fp_count = 4;
    ctx.reserved = ?reserved[0];

    val vr: err[fail.Fail] = verify_allocation(?tgt, ?ctx);
    if (sel vr.ok) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.regalloc.verify_allocation:rejects_a_reserved_register" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_3004: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_3004.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    var vregs: [1]mir.MirVReg;
    vregs[0]          = mir.vreg(0, REG_CLASS_GP, false, false);
    vregs[0].assigned = mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_GP, 2));

    var f: mir.MirFunction;
    f.vregs      = ?vregs[0];
    f.vreg_count = 1;

    var ranges: [1]LiveRange;
    ranges[0].reg_class = REG_CLASS_GP;

    var reserved: [4]bool;
    var ri:       u32 = 0;
    for (ri < 4) {
        reserved[ri] = false;
        ri           = ri + 1;
    }
    reserved[2] = true;

    var itn: intern.Interner = intern.init(?alloc);
    var ctx: AllocCtx;
    ctx.alloc    = ?alloc;
    ctx.interner = ?itn;
    ctx.f        = ?f;
    ctx.ranges   = ?ranges[0];
    ctx.gp_count = 4;
    ctx.fp_count = 4;
    ctx.reserved = ?reserved[0];

    val vr: err[fail.Fail] = verify_allocation(?tgt, ?ctx);
    if (sel vr.ok) { ret 1; }

    reserved[2] = false;
    val vr2: err[fail.Fail] = verify_allocation(?tgt, ?ctx);
    if (sel vr2.err) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.regalloc.sort_by_start:orders_by_start_then_end_then_original_index" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var ranges: [5]LiveRange;
    ranges[0].start   = 10;
    ranges[0].end_pos = 20;
    ranges[1].start   = 5;
    ranges[1].end_pos = 8;
    ranges[2].start   = 5;
    ranges[2].end_pos = 6;
    ranges[3].start   = 5;
    ranges[3].end_pos = 6;
    ranges[4].start   = 0;
    ranges[4].end_pos = 100;

    var ctx: AllocCtx;
    ctx.alloc  = ?alloc;
    ctx.ranges = ?ranges[0];

    var order: [5]u32;
    var i:     u32 = 0;
    for (i < 5) {
        order[i] = i;
        i        = i + 1;
    }

    val r: err[fail.Fail] = sort_by_start(?ctx, ?order[0], 5);
    if (sel r.err) { ret 1; }

    if (order[0] != 4) { ret 1; }
    if (order[1] != 2) { ret 1; }
    if (order[2] != 3) { ret 1; }
    if (order[3] != 1) { ret 1; }
    if (order[4] != 0) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.regalloc.sort_by_start:leaves_short_orders_untouched" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var ctx: AllocCtx;
    ctx.alloc = ?alloc;

    var order0: [1]u32;
    order0[0] = 77;
    val r0: err[fail.Fail] = sort_by_start(?ctx, ?order0[0], 0);
    if (sel r0.err)      { ret 1; }
    if (order0[0] != 77) { ret 1; }

    var ranges: [1]LiveRange;
    ranges[0].start   = 7;
    ranges[0].end_pos = 9;
    ctx.ranges        = ?ranges[0];
    var order1: [1]u32;
    order1[0] = 0;
    val r1: err[fail.Fail] = sort_by_start(?ctx, ?order1[0], 1);
    if (sel r1.err)     { ret 1; }
    if (order1[0] != 0) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.regalloc.extend_range_for_block:in_out_matrix" {
    var span: BlockSpan;
    span.start = 100;
    span.end   = 110;

    var lr1: LiveRange;
    lr1.start   = 105;
    lr1.end_pos = 106;
    extend_range_for_block(?lr1, span, true, true);
    if (lr1.start != 100 || lr1.end_pos != 110) { ret 1; }

    var lr2: LiveRange;
    lr2.start   = 105;
    lr2.end_pos = 106;
    extend_range_for_block(?lr2, span, true, false);
    if (lr2.start != 100 || lr2.end_pos != 106) { ret 1; }

    var lr3: LiveRange;
    lr3.start   = 105;
    lr3.end_pos = 106;
    extend_range_for_block(?lr3, span, false, true);
    if (lr3.start != 105 || lr3.end_pos != 110) { ret 1; }

    var lr4: LiveRange;
    lr4.start   = 105;
    lr4.end_pos = 106;
    extend_range_for_block(?lr4, span, false, false);
    if (lr4.start != 105 || lr4.end_pos != 106) { ret 1; }

    var empty: BlockSpan;
    empty.start = -1;
    empty.end   = -1;
    var lr5: LiveRange;
    lr5.start   = 105;
    lr5.end_pos = 106;
    extend_range_for_block(?lr5, empty, true, true);
    if (lr5.start != 105 || lr5.end_pos != 106) { ret 1; }

    ret 0;
}

test "mach.lang.be.codegen.regalloc.instr_defines:fused_cbr_shape" {
    var ops: [4]mir.MirOperand;
    ops[0] = mir.op_vreg(mir.vreg_id(3));
    ops[1] = mir.op_vreg(mir.vreg_id(4));
    ops[2] = mir.op_block(1);
    ops[3] = mir.op_block(2);

    var fused: mir.MirInstr = mir.instr(mir.MIR_SEL_CBR_LT_S, ?ops[0], 4, 0, 0);

    if (instr_defines(?fused))                 { ret 1; }
    if (instr_defines_ops(?fused, ?ops[0], 4)) { ret 1; }
    if (mir.instr_defines_shape(?fused))       { ret 1; }

    ops[1] = mir.op_imm(0);
    if (instr_defines(?fused)) { ret 1; }

    ops[0] = mir.op_preg(mir.preg_id(7));
    if (instr_defines_preg(?fused)) { ret 1; }

    var cmp_ops: [3]mir.MirOperand;
    cmp_ops[0] = mir.op_vreg(mir.vreg_id(5));
    cmp_ops[1] = mir.op_vreg(mir.vreg_id(3));
    cmp_ops[2] = mir.op_vreg(mir.vreg_id(4));
    var cmp: mir.MirInstr = mir.instr(mir.MIR_SEL_CMP_LT_S, ?cmp_ops[0], 3, 0, 0);
    if (!instr_defines(?cmp)) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.regalloc.can_transfer:destination_born_guard" {
    var ctx:    AllocCtx;
    var ranges: [4]LiveRange;
    ctx.ranges        = ?ranges[0];
    ranges[1].end_pos = 10;

    var h: CopyHint;
    h.src_vreg = 1;
    h.src_preg = -1;
    h.copy_pos = 10;

    var lr_born: LiveRange;
    lr_born.start = 10;
    if (!can_transfer(?ctx, ?lr_born, ?h)) { ret 1; }

    var lr_live_in: LiveRange;
    lr_live_in.start = 3;
    if (can_transfer(?ctx, ?lr_live_in, ?h)) { ret 1; }

    ranges[1].end_pos = 14;
    if (can_transfer(?ctx, ?lr_born, ?h)) { ret 1; }
    ranges[1].end_pos = 10;

    h.src_vreg = mir.MIR_VREG_NIL.n;
    h.src_preg = 5;
    if (can_transfer(?ctx, ?lr_born, ?h)) { ret 1; }

    ret 0;
}

test "mach.lang.be.codegen.regalloc.is_dead_mov:physical_dest_and_read_guards" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_3195: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_3195.err) { ret 1; }
    val ts: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel ts.err) { ret 1; }
    var t: target.Target = ts.ok;

    var f: mir.MirFunction;
    f.vreg_count = 3;
    var slot: [3]bool;
    slot[0] = false;
    slot[1] = false;
    slot[2] = true;

    var ctx: AllocCtx;
    ctx.f              = ?f;
    ctx.vreg_slot_flag = ?slot[0];

    var reads: [3]u32;
    reads[0] = 0;
    reads[1] = 1;
    reads[2] = 0;

    var ops: [2]mir.MirOperand;
    ops[0] = mir.op_vreg(mir.vreg_id(0));
    ops[1] = mir.op_vreg(mir.vreg_id(1));
    var mv: mir.MirInstr = mir.instr(mir.MIR_MOV, ?ops[0], 2, 8, 8);
    mv.asm_block = nil;

    if (!is_dead_mov(?t, ?ctx, ?mv, ?reads[0], 3)) { ret 1; }

    ops[0] = mir.op_vreg(mir.vreg_id(1));
    if (is_dead_mov(?t, ?ctx, ?mv, ?reads[0], 3)) { ret 1; }

    ops[0] = mir.op_vreg(mir.vreg_id(2));
    if (is_dead_mov(?t, ?ctx, ?mv, ?reads[0], 3)) { ret 1; }

    ops[0] = mir.op_preg(mir.preg_id(0));
    if (is_dead_mov(?t, ?ctx, ?mv, ?reads[0], 3)) { ret 1; }

    ops[0]       = mir.op_vreg(mir.vreg_id(0));
    mv.src_width = 4;
    if (is_dead_mov(?t, ?ctx, ?mv, ?reads[0], 3)) { ret 1; }

    ret 0;
}

test "mach.lang.be.codegen.regalloc.sweep_dead_movs:retallies_to_a_fixpoint" {
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var t: target.Target;
    if (!t_target(?reg, ?t)) { ret 1; }
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 4);
    t_mov(?alloc, ?b, 0, mir.op_vreg(mir.vreg_id(0)), mir.op_preg(mir.preg_id(3)));
    t_mov(?alloc, ?b, 1, mir.op_vreg(mir.vreg_id(1)), mir.op_vreg(mir.vreg_id(0)));
    t_mov(?alloc, ?b, 2, mir.op_vreg(mir.vreg_id(2)), mir.op_preg(mir.preg_id(5)));
    t_mov(?alloc, ?b, 3, mir.op_preg(mir.preg_id(6)), mir.op_vreg(mir.vreg_id(2)));
    f.blocks      = ?b;
    f.block_count = 1;
    f.block_cap   = 1;

    var slots: [3]bool;
    slots[0] = false;
    slots[1] = false;
    slots[2] = false;
    var ctx: AllocCtx;
    t_ctx(?ctx, ?alloc, ?f, ?slots[0]);

    val sweep_dead_movs_r: err[fail.Fail] = sweep_dead_movs(?t, ?ctx);
    if (sel sweep_dead_movs_r.err) { ret 1; }

    if (b.instr_count != 2)                              { ret 1; }
    if (b.instrs[0].operands[0].kind != mir.MIR_OP_VREG) { ret 1; }
    if (b.instrs[0].operands[0].vreg.n != 2)             { ret 1; }
    if (b.instrs[1].operands[0].kind != mir.MIR_OP_PREG) { ret 1; }
    if (b.instrs[1].operands[0].preg.n != 6)             { ret 1; }

    ret 0;
}

test "mach.lang.be.codegen.regalloc.cross_block_liveness:1851" {
    var i:   i32 = 0;
    var a:   i32 = 3;
    var b:   i32 = -7;
    var acc: i32 = 0;
    for (i < 6) {
        if (b < 0) { acc = acc + a; }
        or         { acc = acc - a; }
        b = b + 1;
        a = a + 2;
        i = i + 1;
    }
    if (acc != 48) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.regalloc.phi_neg_i32_signed_compare:1851" {
    var probe: i32 = 0;
    var i:     i32 = 0;
    for (i < 5) {
        probe = probe + i;
        i     = i + 1;
    }
    var v: i32 = -1;
    if (probe > 100) { v = probe; }
    if (v < 0)       { ret 0; }
    ret 1;
}

fun t_vregs(alloc: *A.Allocator, f: *mir.MirFunction, n: u32) {
    val r: res[*mir.MirVReg, A.Error] = A.allocate[mir.MirVReg](alloc, n::usize);
    if (sel r.err) { ret; }
    f.vregs      = r.ok;
    f.vreg_count = n;
    f.vreg_cap   = n;
    var i: u32 = 0;
    for (i < n) {
        f.vregs[i].id         = i;
        f.vregs[i].class      = REG_CLASS_GP;
        f.vregs[i].spill_slot = -1;
        f.vregs[i].assigned   = mir.MIR_PREG_NIL;
        f.vregs[i].vector     = false;
        f.vregs[i].secret     = false;
        i                     = i + 1;
    }
}

fun t_block(alloc: *A.Allocator, b: *mir.MirBlock, n: u32) {
    val r: res[*mir.MirInstr, A.Error] = A.zallocate[mir.MirInstr](alloc, n::usize);
    if (sel r.err) { ret; }
    b.instrs      = r.ok;
    b.instr_count = n;
    b.instr_cap   = n;
    b.id          = 0;
}

fun t_mov(alloc: *A.Allocator, b: *mir.MirBlock, ix: u32, dst: mir.MirOperand, src: mir.MirOperand) {
    val r: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](alloc, 2::usize);
    if (sel r.err) { ret; }
    val arr: *mir.MirOperand = r.ok;
    arr[0]                     = dst;
    arr[1]                     = src;
    b.instrs[ix].opcode        = mir.MIR_MOV;
    b.instrs[ix].operands      = arr;
    b.instrs[ix].operand_count = 2;
    b.instrs[ix].width         = 8;
    b.instrs[ix].src_width     = 8;
    b.instrs[ix].asm_block     = nil;
    b.instrs[ix].vec_lane      = mir.VEC_LANE_NONE;
}

fun t_ctx(ctx: *AllocCtx, alloc: *A.Allocator, f: *mir.MirFunction, slots: *bool) {
    ctx.alloc          = alloc;
    ctx.interner       = nil;
    ctx.f              = f;
    ctx.spill_width    = 8;
    ctx.vreg_slot_flag = slots;
}

fun t_target(reg: *target.TargetRegistry, out: *target.Target) bool {
    @reg = target.registry_init();
    val r_3350: err[fail.Fail] = target.register_all(reg, target_testing.debug_descriptor);
    if (sel r_3350.err) { ret false; }
    val ts: res[target.Target, fail.Fail] = target.select(reg, "x86_64", "linux", "sysv64");
    if (sel ts.err) {
        target.registry_dnit(reg);
        ret false;
    }
    @out = ts.ok;
    ret true;
}

test "mach.lang.be.codegen.regalloc.coalesce_copies:single_assignment_web_is_merged" {
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var t: target.Target;
    if (!t_target(?reg, ?t)) { ret 1; }
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 2);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 3);
    t_mov(?alloc, ?b, 0, mir.op_vreg(mir.vreg_id(0)), mir.op_preg(mir.preg_id(3)));
    t_mov(?alloc, ?b, 1, mir.op_vreg(mir.vreg_id(1)), mir.op_vreg(mir.vreg_id(0)));
    t_mov(?alloc, ?b, 2, mir.op_preg(mir.preg_id(4)), mir.op_vreg(mir.vreg_id(1)));
    f.blocks      = ?b;
    f.block_count = 1;
    f.block_cap   = 1;

    var slots: [2]bool;
    slots[0] = false;
    slots[1] = false;
    var ctx: AllocCtx;
    t_ctx(?ctx, ?alloc, ?f, ?slots[0]);

    val coalesce_copies_r: err[fail.Fail] = coalesce_copies(?t, ?ctx);
    if (sel coalesce_copies_r.err) { ret 1; }

    if (b.instr_count != 2)                              { ret 1; }
    if (b.instrs[1].operands[1].kind != mir.MIR_OP_VREG) { ret 1; }
    if (b.instrs[1].operands[1].vreg.n != 0)             { ret 1; }
    if (b.instrs[0].operands[0].vreg.n != 0)             { ret 1; }

    ret 0;
}

test "mach.lang.be.codegen.regalloc.coalesce_copies:refuses_to_merge_a_secret_with_a_public_web" {
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var t: target.Target;
    if (!t_target(?reg, ?t)) { ret 1; }
    var alloc: A.Allocator;
    page.make(?alloc);

    # the same single-assignment web single_assignment_web_is_merged merges, seeded secret on one side
    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 2);
    f.vregs[0].secret = true;
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 3);
    t_mov(?alloc, ?b, 0, mir.op_vreg(mir.vreg_id(0)), mir.op_preg(mir.preg_id(3)));
    t_mov(?alloc, ?b, 1, mir.op_vreg(mir.vreg_id(1)), mir.op_vreg(mir.vreg_id(0)));
    t_mov(?alloc, ?b, 2, mir.op_preg(mir.preg_id(4)), mir.op_vreg(mir.vreg_id(1)));
    f.blocks      = ?b;
    f.block_count = 1;
    f.block_cap   = 1;
    var slots: [2]bool;
    slots[0] = false;
    slots[1] = false;
    var ctx: AllocCtx;
    t_ctx(?ctx, ?alloc, ?f, ?slots[0]);
    val coalesce_copies_r: err[fail.Fail] = coalesce_copies(?t, ?ctx);
    if (sel coalesce_copies_r.err)                                                  { ret 1; }
    if (b.instr_count != 3)                                                         { ret 2; }
    if (b.instrs[1].operands[0].vreg.n != 1 || b.instrs[1].operands[1].vreg.n != 0) { ret 3; }

    # control: the same web with both sides secret merges
    var f2: mir.MirFunction;
    t_vregs(?alloc, ?f2, 2);
    f2.vregs[0].secret = true;
    f2.vregs[1].secret = true;
    var b2: mir.MirBlock;
    t_block(?alloc, ?b2, 3);
    t_mov(?alloc, ?b2, 0, mir.op_vreg(mir.vreg_id(0)), mir.op_preg(mir.preg_id(3)));
    t_mov(?alloc, ?b2, 1, mir.op_vreg(mir.vreg_id(1)), mir.op_vreg(mir.vreg_id(0)));
    t_mov(?alloc, ?b2, 2, mir.op_preg(mir.preg_id(4)), mir.op_vreg(mir.vreg_id(1)));
    f2.blocks      = ?b2;
    f2.block_count = 1;
    f2.block_cap   = 1;
    var slots2: [2]bool;
    slots2[0] = false;
    slots2[1] = false;
    var ctx2: AllocCtx;
    t_ctx(?ctx2, ?alloc, ?f2, ?slots2[0]);
    val coalesce_copies_r2: err[fail.Fail] = coalesce_copies(?t, ?ctx2);
    if (sel coalesce_copies_r2.err) { ret 4; }
    if (b2.instr_count != 2)        { ret 5; }
    ret 0;
}

fun t_selected_copy(t: *target.Target, opcode: u32, copied: bool) bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    var f: mir.MirFunction;
    var b: mir.MirBlock;
    f.blocks      = ?b;
    f.block_count = 1;
    fin { mir.dnit_function(?alloc, ?f); }
    t_vregs(?alloc, ?f, 2);
    t_block(?alloc, ?b, 3);
    t_mov(?alloc, ?b, 0, mir.op_vreg(mir.vreg_id(0)), mir.op_preg(mir.preg_id(10)));
    t_mov(?alloc, ?b, 1, mir.op_vreg(mir.vreg_id(1)), mir.op_vreg(mir.vreg_id(0)));
    t_mov(?alloc, ?b, 2, mir.op_preg(mir.preg_id(11)), mir.op_vreg(mir.vreg_id(1)));
    var i: u32 = 0;
    for (i < 3) {
        b.instrs[i].width     = t.model.gpr_width::u8;
        b.instrs[i].src_width = t.model.gpr_width::u8;
        i                     = i + 1;
    }
    b.instrs[1].opcode    = opcode;
    b.instrs[1].width     = 4;
    b.instrs[1].src_width = 4;
    var backend:    isa.BackendTarget = target_view.backend_target(t);
    val selected_r: err[fail.Fail]    = t.arch.select(?alloc, ?backend, ?f);
    if (sel selected_r.err) { ret false; }
    var selected: u32 = opcode;
    if (copied)                         { selected = riscv.MOV::u32; }
    if (b.instrs[1].opcode != selected) { ret false; }

    var slots: [2]bool;
    var ctx:   AllocCtx;
    t_ctx(?ctx, ?alloc, ?f, ?slots[0]);
    ctx.spill_width = t.model.spill_width::u8;
    val coalesce_copies_r: err[fail.Fail] = coalesce_copies(t, ?ctx);
    if (sel coalesce_copies_r.err) { ret false; }
    if (!copied)                   { ret b.instr_count == 3 && b.instrs[1].opcode == opcode; }
    ret b.instr_count == 2 && b.instrs[1].operands[1].kind == mir.MIR_OP_VREG &&
        b.instrs[1].operands[1].vreg.n == 0;
}

test "mach.lang.be.codegen.regalloc.coalesce_copies:rv32_guard_uses_each_selected_machine" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_3487: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_3487.err) { ret 1; }
    val s32: res[target.Target, fail.Fail] = target.select(?reg, "rv32imafdc", "freestanding", "ilp32d");
    if (sel s32.err) { ret 2; }
    var rv32: target.Target                 = s32.ok;
    val s64:  res[target.Target, fail.Fail] = target.select(?reg, "riscv64", "linux", "lp64d");
    if (sel s64.err) { ret 3; }
    var rv64: target.Target = s64.ok;
    if (rv32.model.gpr_width != 4 || rv64.model.gpr_width != 8) { ret 4; }
    var pass: u32 = 0;
    for (pass < 3) {
        var current: *target.Target = ?rv32;
        if (pass == 1)                                             { current = ?rv64; }
        if (!t_selected_copy(current, mir.MIR_BITCAST, pass != 1)) { ret 5; }
        if (!t_selected_copy(current, mir.MIR_SEXT, pass != 1))    { ret 6; }
        pass = pass + 1;
    }
    ret 0;
}

test "mach.lang.be.codegen.regalloc.coalesce_copies:refuses_unsafe_shapes" {
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var t: target.Target;
    if (!t_target(?reg, ?t)) { ret 1; }
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 2);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 4);
    t_mov(?alloc, ?b, 0, mir.op_vreg(mir.vreg_id(0)), mir.op_preg(mir.preg_id(3)));
    t_mov(?alloc, ?b, 1, mir.op_vreg(mir.vreg_id(1)), mir.op_vreg(mir.vreg_id(0)));
    t_mov(?alloc, ?b, 2, mir.op_vreg(mir.vreg_id(1)), mir.op_preg(mir.preg_id(5)));
    t_mov(?alloc, ?b, 3, mir.op_preg(mir.preg_id(4)), mir.op_vreg(mir.vreg_id(1)));
    f.blocks      = ?b;
    f.block_count = 1;
    f.block_cap   = 1;

    var slots: [2]bool;
    slots[0] = false;
    slots[1] = false;
    var ctx: AllocCtx;
    t_ctx(?ctx, ?alloc, ?f, ?slots[0]);

    val coalesce_copies_r: err[fail.Fail] = coalesce_copies(?t, ?ctx);
    if (sel coalesce_copies_r.err) { ret 1; }
    if (b.instr_count != 4)        { ret 1; }

    var f2: mir.MirFunction;
    t_vregs(?alloc, ?f2, 2);
    var b2: mir.MirBlock;
    t_block(?alloc, ?b2, 3);
    t_mov(?alloc, ?b2, 0, mir.op_vreg(mir.vreg_id(0)), mir.op_preg(mir.preg_id(3)));
    t_mov(?alloc, ?b2, 1, mir.op_vreg(mir.vreg_id(1)), mir.op_vreg(mir.vreg_id(0)));
    b2.instrs[1].width     = 4;
    b2.instrs[1].src_width = 4;
    t_mov(?alloc, ?b2, 2, mir.op_preg(mir.preg_id(4)), mir.op_vreg(mir.vreg_id(1)));
    f2.blocks      = ?b2;
    f2.block_count = 1;
    f2.block_cap   = 1;

    var slots2: [2]bool;
    slots2[0] = false;
    slots2[1] = false;
    var ctx2: AllocCtx;
    t_ctx(?ctx2, ?alloc, ?f2, ?slots2[0]);
    val coalesce_copies_r2: err[fail.Fail] = coalesce_copies(?t, ?ctx2);
    if (sel coalesce_copies_r2.err) { ret 1; }
    if (b2.instr_count != 3)        { ret 1; }

    var f3: mir.MirFunction;
    t_vregs(?alloc, ?f3, 2);
    var b3: mir.MirBlock;
    t_block(?alloc, ?b3, 3);
    t_mov(?alloc, ?b3, 0, mir.op_vreg(mir.vreg_id(0)), mir.op_preg(mir.preg_id(3)));
    t_mov(?alloc, ?b3, 1, mir.op_vreg(mir.vreg_id(1)), mir.op_vreg(mir.vreg_id(0)));
    t_mov(?alloc, ?b3, 2, mir.op_preg(mir.preg_id(4)), mir.op_vreg(mir.vreg_id(1)));
    f3.blocks      = ?b3;
    f3.block_count = 1;
    f3.block_cap   = 1;

    var slots3: [2]bool;
    slots3[0] = false;
    slots3[1] = true;
    var ctx3: AllocCtx;
    t_ctx(?ctx3, ?alloc, ?f3, ?slots3[0]);
    val coalesce_copies_r3: err[fail.Fail] = coalesce_copies(?t, ?ctx3);
    if (sel coalesce_copies_r3.err) { ret 1; }
    if (b3.instr_count != 3)        { ret 1; }

    ret 0;
}

test "mach.lang.be.codegen.regalloc.maybe_sink_hint:records_only_a_dying_full_width_placement" {
    var ctx:    AllocCtx;
    var ranges: [2]LiveRange;
    var hints:  [2]CopyHint;
    ctx.ranges      = ?ranges[0];
    ctx.hints       = ?hints[0];
    ctx.spill_width = 8;
    var i: u32 = 0;
    for (i < 2) {
        hints[i].src_vreg     = mir.MIR_VREG_NIL.n;
        hints[i].src_preg     = -1;
        hints[i].copy_pos     = -1;
        hints[i].dst_vreg     = mir.MIR_VREG_NIL.n;
        hints[i].dst_copy_pos = -1;
        hints[i].sink_preg    = -1;
        i                     = i + 1;
    }

    var ops: [2]mir.MirOperand;
    ops[0] = mir.op_preg(mir.preg_id(7));
    ops[1] = mir.op_vreg(mir.vreg_id(1));
    var mv: mir.MirInstr = mir.instr(mir.MIR_MOV, ?ops[0], 2, 8, 8);

    ranges[1].end_pos = 10;
    maybe_sink_hint(?ctx, ?mv, 10, 2);
    if (hints[1].sink_preg != 7) { ret 1; }

    ops[0] = mir.op_preg(mir.preg_id(6));
    maybe_sink_hint(?ctx, ?mv, 10, 2);
    if (hints[1].sink_preg != 7) { ret 1; }

    hints[1].sink_preg = -1;
    ranges[1].end_pos  = 14;
    ops[0]             = mir.op_preg(mir.preg_id(7));
    maybe_sink_hint(?ctx, ?mv, 10, 2);
    if (hints[1].sink_preg != -1) { ret 1; }

    ranges[1].end_pos = 10;
    mv.width          = 4;
    mv.src_width      = 4;
    maybe_sink_hint(?ctx, ?mv, 10, 2);
    if (hints[1].sink_preg != -1) { ret 1; }

    mv.width     = 8;
    mv.src_width = 8;
    ops[0]       = mir.op_vreg(mir.vreg_id(0));
    maybe_sink_hint(?ctx, ?mv, 10, 2);
    if (hints[1].sink_preg != -1) { ret 1; }

    ret 0;
}

test "mach.lang.be.codegen.regalloc.maybe_tie_hint:ties_a_dying_left_operand" {
    var ctx:    AllocCtx;
    var ranges: [3]LiveRange;
    var hints:  [3]CopyHint;
    ctx.ranges = ?ranges[0];
    ctx.hints  = ?hints[0];
    var i: u32 = 0;
    for (i < 3) {
        hints[i].src_vreg     = mir.MIR_VREG_NIL.n;
        hints[i].src_preg     = -1;
        hints[i].copy_pos     = -1;
        hints[i].dst_vreg     = mir.MIR_VREG_NIL.n;
        hints[i].dst_copy_pos = -1;
        hints[i].sink_preg    = -1;
        i                     = i + 1;
    }

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_vreg(mir.vreg_id(0));
    ops[1] = mir.op_vreg(mir.vreg_id(1));
    ops[2] = mir.op_vreg(mir.vreg_id(2));
    var op: mir.MirInstr = mir.instr(mir.MIR_SEL_MUL, ?ops[0], 3, 0, 0);

    ranges[1].end_pos = 20;
    ranges[0].start   = 20;
    maybe_tie_hint(?ctx, ?op, 20, 3);
    if (hints[0].src_vreg != 1)  { ret 1; }
    if (hints[0].copy_pos != 20) { ret 1; }

    hints[0].src_vreg = mir.MIR_VREG_NIL.n;
    hints[0].copy_pos = -1;
    ranges[1].end_pos = 24;
    maybe_tie_hint(?ctx, ?op, 20, 3);
    if (hints[0].src_vreg != mir.MIR_VREG_NIL.n) { ret 1; }

    ranges[1].end_pos = 20;
    ranges[0].start   = 12;
    maybe_tie_hint(?ctx, ?op, 20, 3);
    if (hints[0].src_vreg != mir.MIR_VREG_NIL.n) { ret 1; }

    ranges[0].start = 20;
    op.opcode       = mir.MIR_SEL_CMP_EQ;
    maybe_tie_hint(?ctx, ?op, 20, 3);
    if (hints[0].src_vreg != mir.MIR_VREG_NIL.n) { ret 1; }

    if (!is_two_address_op(mir.MIR_SEL_ADD))   { ret 1; }
    if (!is_two_address_op(mir.MIR_SEL_SHR_S)) { ret 1; }
    if (is_two_address_op(mir.MIR_SEL_DIV_S))  { ret 1; }
    if (is_two_address_op(mir.MIR_MOV))        { ret 1; }

    ret 0;
}

fun t_scale(v: i64, k: i64) i64 {
    ret v * k;
}

test "mach.lang.be.codegen.regalloc.coalesce_copies:forwarded_values_survive" {
    var acc: i64 = 0;
    var i:   i64 = 0;
    for (i < 8) {
        val a: i64 = t_scale(i, 3);
        val b: i64 = t_scale(a, 2);
        acc = acc + (b - a);
        i   = i + 1;
    }
    if (acc != 84) { ret 1; }
    ret 0;
}

fun t_self_copy_is_dropped(t: *target.Target, width: u8) bool {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 2);
    t_mov(?alloc, ?b, 0, mir.op_vreg(mir.vreg_id(1)), mir.op_vreg(mir.vreg_id(1)));
    t_mov(?alloc, ?b, 1, mir.op_vreg(mir.vreg_id(2)), mir.op_vreg(mir.vreg_id(0)));
    b.instrs[0].width     = width;
    b.instrs[0].src_width = width;
    b.instrs[1].width     = width;
    b.instrs[1].src_width = width;
    f.blocks              = ?b;
    f.block_count         = 1;
    f.block_cap           = 1;

    var slots: [3]bool;
    slots[0] = false;
    slots[1] = false;
    slots[2] = false;
    var ctx: AllocCtx;
    t_ctx(?ctx, ?alloc, ?f, ?slots[0]);

    drop_self_copies(t, ?ctx);

    if (b.instr_count != 1) { ret false; }
    val kept: *mir.MirOperand = b.instrs[0].operands;
    ret kept[0].kind == mir.MIR_OP_VREG && kept[0].vreg.n == 2 &&
        kept[1].kind == mir.MIR_OP_VREG && kept[1].vreg.n == 0;
}

test "mach.lang.be.codegen.regalloc.drop_self_copies:width_is_not_a_gate" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_3732: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_3732.err) { ret 1; }

    var isa: [3]str;
    var abi: [3]str;
    isa[0] = "x86_64";
    abi[0] = "sysv64";
    isa[1] = "aarch64";
    abi[1] = "aapcs64";
    isa[2] = "riscv64";
    abi[2] = "lp64d";

    var i: usize = 0;
    for (i < 3) {
        val tr: res[target.Target, fail.Fail] = target.select(?reg, isa[i], "linux", abi[i]);
        if (sel tr.err) { ret 1; }
        var t: target.Target = tr.ok;

        var w:      usize = 0;
        var widths: [4]u8;
        widths[0] = 1;
        widths[1] = 2;
        widths[2] = 4;
        widths[3] = 8;
        for (w < 4) {
            if (!t_self_copy_is_dropped(?t, widths[w])) { ret 1; }
            w = w + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.be.codegen.regalloc.drop_self_copies_physical:deletes_only_the_same_register_copy" {
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var t: target.Target;
    if (!t_target(?reg, ?t)) { ret 1; }
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 1);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 3);
    t_mov(?alloc, ?b, 0, mir.op_preg(mir.preg_id(3)), mir.op_preg(mir.preg_id(3)));
    t_mov(?alloc, ?b, 1, mir.op_preg(mir.preg_id(4)), mir.op_preg(mir.preg_id(5)));
    t_mov(?alloc, ?b, 2, mir.op_preg(mir.preg_id(6)), mir.op_preg(mir.preg_id(6)));
    f.blocks      = ?b;
    f.block_count = 1;
    f.block_cap   = 1;

    var slots: [1]bool;
    slots[0] = false;
    var ctx: AllocCtx;
    t_ctx(?ctx, ?alloc, ?f, ?slots[0]);

    drop_self_copies_physical(?t, ?ctx);

    if (b.instr_count != 1) { ret 1; }
    val kept: *mir.MirOperand = b.instrs[0].operands;
    if (kept[0].kind != mir.MIR_OP_PREG || kept[0].preg.n != 4) { ret 1; }
    if (kept[1].kind != mir.MIR_OP_PREG || kept[1].preg.n != 5) { ret 1; }
    ret 0;
}

rec RegallocGrowthProbe {
    reallocate_calls: u32;
    allocate_calls:   u32;
}

fun regalloc_growth_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val g: *RegallocGrowthProbe = ctx::*RegallocGrowthProbe;
    g.allocate_calls = g.allocate_calls + 1;
    ret opt[ptr].none{};
}

fun regalloc_growth_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val g: *RegallocGrowthProbe = ctx::*RegallocGrowthProbe;
    g.reallocate_calls = g.reallocate_calls + 1;
    ret opt[ptr].none{};
}

fun regalloc_growth_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.be.codegen.regalloc.add_spill_slot:refuses_u32_capacity_overflow_before_reallocating" {
    var probe: RegallocGrowthProbe;
    probe.reallocate_calls = 0;
    probe.allocate_calls   = 0;
    var pp:    *RegallocGrowthProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = regalloc_growth_probe_allocate;
    alloc.fn_reallocate = regalloc_growth_probe_reallocate;
    alloc.fn_deallocate = regalloc_growth_probe_deallocate;

    var f: mir.MirFunction;
    f.frame.slots      = nil;
    f.frame.slot_count = 0xFFFFFFFF;
    f.frame.slot_cap   = 0xFFFFFFFF;

    var ctx: AllocCtx;
    ctx.alloc = ?alloc;
    ctx.f     = ?f;

    val r: res[i32, fail.Fail] = add_spill_slot(?ctx, 0, 8);

    var bad: i32 = 0;
    if (!sel r.err)                  { bad = 1; }
    if (probe.reallocate_calls != 0) { bad = 2; }
    if (probe.allocate_calls != 0)   { bad = 3; }
    ret bad;
}

test "mach.lang.be.codegen.regalloc.add_spill_slot:refuses_a_slot_index_past_the_i32_limit" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    f.frame.slots      = nil;
    f.frame.slot_count = 0x80000000;
    f.frame.slot_cap   = 0x80000001;

    var ctx: AllocCtx;
    ctx.alloc = ?alloc;
    ctx.f     = ?f;

    val r: res[i32, fail.Fail] = add_spill_slot(?ctx, 0, 8);

    var bad: i32 = 0;
    if (!sel r.err) { bad = 1; }
    ret bad;
}

test "mach.lang.be.codegen.regalloc.build_order_apply_order_restore_order:round_trips_to_original_identity" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f:  mir.MirFunction;
    val rb: res[*mir.MirBlock, A.Error] = A.zallocate[mir.MirBlock](?alloc, 4::usize);
    if (sel rb.err) { ret 1; }
    f.blocks      = rb.ok;
    f.block_count = 4;

    val ro0: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](?alloc, 2::usize);
    if (sel ro0.err) { ret 1; }
    val ops0: *mir.MirOperand = ro0.ok;
    ops0[0] = mir.op_block(1);
    ops0[1] = mir.op_block(3);

    val ri0: res[*mir.MirInstr, A.Error] = A.zallocate[mir.MirInstr](?alloc, 1::usize);
    if (sel ri0.err) { ret 1; }
    val instrs0: *mir.MirInstr = ri0.ok;
    instrs0[0] = mir.instr(mir.MIR_CBR, ops0, 2, 0, 0);

    val ro1: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](?alloc, 1::usize);
    if (sel ro1.err) { ret 1; }
    val ops1: *mir.MirOperand = ro1.ok;
    ops1[0] = mir.op_block(2);

    val ri1: res[*mir.MirInstr, A.Error] = A.zallocate[mir.MirInstr](?alloc, 1::usize);
    if (sel ri1.err) { ret 1; }
    val instrs1: *mir.MirInstr = ri1.ok;
    instrs1[0] = mir.instr(mir.MIR_BR, ops1, 1, 0, 0);

    f.blocks[0].id          = 0;
    f.blocks[0].instrs      = instrs0;
    f.blocks[0].instr_count = 1;
    f.blocks[1].id          = 1;
    f.blocks[1].instrs      = instrs1;
    f.blocks[1].instr_count = 1;
    f.blocks[2].id          = 2;
    f.blocks[2].instr_count = 0;
    f.blocks[3].id          = 3;
    f.blocks[3].instr_count = 0;

    val ord_r: res[*u32, A.Error] = A.allocate[u32](?alloc, 4::usize);
    if (sel ord_r.err) { ret 1; }

    var ctx: AllocCtx;
    ctx.alloc = ?alloc;
    ctx.f     = ?f;
    ctx.order = ord_r.ok;

    val build_order_r: err[fail.Fail] = build_order(?ctx);
    if (sel build_order_r.err)                                                            { ret 1; }
    if (ctx.order[0] != 0 || ctx.order[1] != 3 || ctx.order[2] != 1 || ctx.order[3] != 2) { ret 1; }

    val apply_order_r: err[fail.Fail] = apply_order(?ctx);
    if (sel apply_order_r.err)                                                                    { ret 1; }
    if (f.blocks[0].id != 0 || f.blocks[1].id != 3 || f.blocks[2].id != 1 || f.blocks[3].id != 2) { ret 1; }

    val restore_order_r: err[fail.Fail] = restore_order(?ctx);
    if (sel restore_order_r.err)                                                                  { ret 1; }
    if (f.blocks[0].id != 0 || f.blocks[1].id != 1 || f.blocks[2].id != 2 || f.blocks[3].id != 3) { ret 1; }

    ret 0;
}

test "mach.lang.be.codegen.regalloc.verify_rewritten_operands:walks_the_program_not_the_allocator" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_3929: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_3929.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;
    val gp:  u32           = bank_count(?tgt, REG_CLASS_GP);

    var ops: [2]mir.MirOperand;
    ops[0] = mir.op_preg(mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_GP, 1)));
    ops[1] = mir.op_preg(mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_GP, 3)));
    var ins: [1]mir.MirInstr;
    ins[0] = mir.instr(mir.MIR_MOV, ?ops[0], 2, 8, 8);
    var blk: [1]mir.MirBlock;
    blk[0].instrs      = ?ins[0];
    blk[0].instr_count = 1;
    var f: mir.MirFunction;
    f.blocks      = ?blk[0];
    f.block_count = 1;

    val capture_operand_banks_r: err[fail.Fail] = rules.capture_operand_banks(?f, ?ins[0]);
    if (sel capture_operand_banks_r.err) { ret 1; }
    val verify_rewritten_operands_r: err[fail.Fail] = verify_rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r.err) { ret 1; }
    ops[1] = mir.op_preg(mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_GP, (gp + 40)::i32)));
    val verify_rewritten_operands_r2: err[fail.Fail] = verify_rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r2.ok) { ret 2; }
    ops[1] = mir.op_preg(mir.preg_id(isa.regid_make(7, 0)));
    val verify_rewritten_operands_r3: err[fail.Fail] = verify_rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r3.ok) { ret 3; }
    ops[1] = mir.op_vreg(mir.vreg_id(0));
    val verify_rewritten_operands_r4: err[fail.Fail] = verify_rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r4.ok) { ret 4; }
    ops[1] = mir.op_mem_preg(mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_GP, (gp + 40)::i32)), 0);
    val verify_rewritten_operands_r5: err[fail.Fail] = verify_rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r5.ok) { ret 5; }
    ops[1] = mir.op_mem_preg(mir.preg_id(tgt.model.stack_ptr_reg), 0);
    val verify_rewritten_operands_r6: err[fail.Fail] = verify_rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r6.err) { ret 6; }
    ret 0;
}

fun t_spilled_update(mode: u32) i32 {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var scratch_arena: arena.Arena;
    val init_r:        err[A.Error] = arena.init(?scratch_arena, ?backing, 65536);
    if (sel init_r.err) { ret 1; }
    fin { arena.dnit(?scratch_arena); }
    var alloc:   A.Allocator;
    val make_r2: err[A.Error] = arena.make(?alloc, ?scratch_arena);
    if (sel make_r2.err) { ret 1; }
    var vregs: [1]mir.MirVReg;
    vregs[0]            = mir.vreg(0, REG_CLASS_GP, false, false);
    vregs[0].spill_slot = 0;
    var f: mir.MirFunction;
    f.vregs      = ?vregs[0];
    f.vreg_count = 1;
    var scratch: [1]isa.Register;
    scratch[0].id = 0;
    var ctx: AllocCtx;
    ctx.alloc                = ?alloc;
    ctx.f                    = ?f;
    ctx.spill_width          = 8;
    ctx.reload_scratch       = ?scratch[0];
    ctx.reload_scratch_count = 1;
    var tgt:   target.Target;
    val count: u32                           = 3;
    val ar:    res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](?alloc, count::usize);
    if (sel ar.err) { ret 1; }
    val ops: *mir.MirOperand = ar.ok;
    ops[0] = mir.op_vreg(mir.vreg_id(0));
    ops[1] = mir.op_vreg(mir.vreg_id(0));
    ops[2] = mir.op_imm(8);
    var mi: mir.MirInstr = mir.instr(mir.MIR_SUB, ops, count, 8, 8);
    if (mode == 1) {
        mi.opcode = mir.MIR_ADD;
        ops[2]    = mir.op_vreg(mir.vreg_id(0));
    }
    or (mode == 2) {
        ops[1] = mir.op_imm(100);
    }
    val capture_operand_banks_r: err[fail.Fail] = rules.capture_operand_banks(?f, ?mi);
    if (sel capture_operand_banks_r.err) { ret 8; }
    var dst:     [5]mir.MirInstr;
    var written: u32 = 0;
    fin {
        var i: u32 = 0;
        for (i < written) {
            free_ops(?ctx, dst[i].operands, dst[i].operand_count);
            i = i + 1;
        }
    }
    val wrong_scratch: mir.PRegId     = mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 0));
    val emit_reload_r: err[fail.Fail] = emit_reload(?ctx, ?dst[0], ?written, wrong_scratch, mir.vreg_id(0), mi.loc, 0);
    if (sel emit_reload_r.ok) {
        free_ops(?ctx, ops, count);
        ret 9;
    }
    val emit_store_r: err[fail.Fail] = emit_store(?ctx, ?dst[0], ?written, mir.vreg_id(0), wrong_scratch, mi.loc, 0);
    if (sel emit_store_r.ok) {
        free_ops(?ctx, ops, count);
        ret 9;
    }
    if (written != 0) {
        free_ops(?ctx, ops, count);
        ret 9;
    }
    val rr: err[fail.Fail] = rewrite_instr(?tgt, ?ctx, ?mi, ?dst[0], ?written, false, 0);
    if (sel rr.err) { ret 2; }
    var slot:   i64 = 40;
    var reg:    i64 = 999;
    var loads:  u32 = 0;
    var stores: u32 = 0;
    var i:      u32 = 0;
    for (i < written) {
        val ins: *mir.MirInstr = ?dst[i];
        var oi:  u32           = 0;
        for (oi < ins.operand_count) {
            if (ins.operands[oi].kind == mir.MIR_OP_PREG && !operand_bank_matches(?ins.operands[oi])) { ret 8; }
            oi = oi + 1;
        }
        val a: *mir.MirOperand = ?ins.operands[0];
        val b: *mir.MirOperand = ?ins.operands[1];
        if (ins.opcode == mir.MIR_MOV) {
            if (a.kind == mir.MIR_OP_PREG && b.kind == mir.MIR_OP_MEM && b.vreg.n == 0) {
                reg   = slot;
                loads = loads + 1;
            }
            or (a.kind == mir.MIR_OP_MEM && a.vreg.n == 0 && b.kind == mir.MIR_OP_PREG) {
                slot   = reg;
                stores = stores + 1;
            }
            or { ret 3; }
        }
        or {
            val c: *mir.MirOperand = ?ins.operands[2];
            if (a.kind != mir.MIR_OP_PREG || a.preg.n != 0) { ret 3; }
            var left:  i64 = b.imm;
            var right: i64 = c.imm;
            if (b.kind == mir.MIR_OP_PREG) {
                if (!mir.preg_same(b.preg, a.preg)) { ret 4; }
                left = reg;
            }
            if (c.kind == mir.MIR_OP_PREG) {
                if (!mir.preg_same(c.preg, a.preg)) { ret 4; }
                right = reg;
            }
            if (ins.opcode == mir.MIR_SUB) { reg = left - right; }
            or (ins.opcode == mir.MIR_ADD) { reg = left + right; }
            or                             { ret 3; }
        }
        i = i + 1;
    }
    var expected: i64 = 32;
    if (mode == 1)        { expected = 80; }
    or (mode == 2)        { expected = 92; }
    if (slot != expected) { ret 5; }
    if (stores != 1)      { ret 6; }
    if (mode == 2) {
        if (loads != 0 || written != 2) { ret 7; }
    }
    or {
        if (loads != 1 || written != 3) { ret 8; }
    }
    ret 0;
}

# a spilled secret travels through a reload scratch and a slot keyed by its own vreg id; these are the
# physical facts a post-allocation validator seeds from (#3126)
test "mach.lang.be.codegen.regalloc.rewrite_instr:a_spilled_secret_keeps_its_slot_key_through_the_scratch" {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var scratch_arena: arena.Arena;
    val init_r:        err[A.Error] = arena.init(?scratch_arena, ?backing, 65536);
    if (sel init_r.err) { ret 1; }
    fin { arena.dnit(?scratch_arena); }
    var alloc:   A.Allocator;
    val make_r2: err[A.Error] = arena.make(?alloc, ?scratch_arena);
    if (sel make_r2.err) { ret 1; }
    var vregs: [2]mir.MirVReg;
    vregs[0]            = mir.vreg(0, REG_CLASS_GP, false, true);
    vregs[0].spill_slot = 0;
    vregs[1]            = mir.vreg(1, REG_CLASS_GP, false, false);
    vregs[1].assigned   = mir.preg_id(7);
    var f: mir.MirFunction;
    f.vregs      = ?vregs[0];
    f.vreg_count = 2;
    var scratch: [1]isa.Register;
    scratch[0].id = 9;
    var ctx: AllocCtx;
    ctx.alloc                = ?alloc;
    ctx.f                    = ?f;
    ctx.spill_width          = 8;
    ctx.reload_scratch       = ?scratch[0];
    ctx.reload_scratch_count = 1;
    var tgt: target.Target;
    val ar:  res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](?alloc, 3::usize);
    if (sel ar.err) { ret 1; }
    val ops: *mir.MirOperand = ar.ok;
    ops[0] = mir.op_vreg(mir.vreg_id(1));
    ops[1] = mir.op_vreg(mir.vreg_id(1));
    ops[2] = mir.op_vreg(mir.vreg_id(0));
    var mi:                      mir.MirInstr   = mir.instr(mir.MIR_ADD, ops, 3, 8, 8);
    val capture_operand_banks_r: err[fail.Fail] = rules.capture_operand_banks(?f, ?mi);
    if (sel capture_operand_banks_r.err) { ret 2; }
    var dst:     [4]mir.MirInstr;
    var written: u32 = 0;
    fin {
        var i: u32 = 0;
        for (i < written) {
            free_ops(?ctx, dst[i].operands, dst[i].operand_count);
            i = i + 1;
        }
    }
    val rewrite_instr_r: err[fail.Fail] = rewrite_instr(?tgt, ?ctx, ?mi, ?dst[0], ?written, false, 0);
    if (sel rewrite_instr_r.err) { ret 3; }
    if (written != 2)            { ret 4; }

    # the reload: the scratch is a physical alias of the secret for one instruction
    val reload: *mir.MirInstr = ?dst[0];
    if (reload.opcode != mir.MIR_MOV || reload.operand_count != 2)                    { ret 5; }
    if (reload.operands[0].kind != mir.MIR_OP_PREG || reload.operands[0].preg.n != 9) { ret 6; }
    if (reload.operands[1].kind != mir.MIR_OP_MEM || reload.operands[1].vreg.n != 0)  { ret 7; }
    if (!f.vregs[reload.operands[1].vreg.n].secret)                                   { ret 8; }

    # the use reads the scratch, and the vreg seed survives rewriting untouched
    val use: *mir.MirInstr = ?dst[1];
    if (use.opcode != mir.MIR_ADD || use.operands[2].kind != mir.MIR_OP_PREG || use.operands[2].preg.n != 9) { ret 9; }
    if (!f.vregs[0].secret || f.vregs[1].secret)                                                             { ret 10; }

    # provenance: the scratch names the secret it aliases at both the reload
    # and the use, and the assigned register names its public vreg
    if (mir.operand_origin(?reload.operands[0]).n != 0 || !mir.operand_seed_secret(?f, ?reload.operands[0])) { ret 11; }
    if (mir.operand_origin(?reload.operands[1]).n != 0 || !mir.operand_seed_secret(?f, ?reload.operands[1])) { ret 12; }
    if (mir.operand_origin(?use.operands[2]).n != 0 || !mir.operand_seed_secret(?f, ?use.operands[2]))       { ret 13; }
    if (mir.operand_origin(?use.operands[0]).n != 1 || mir.operand_seed_secret(?f, ?use.operands[0]))        { ret 14; }
    if (mir.operand_origin(?use.operands[1]).n != 1 || mir.operand_seed_secret(?f, ?use.operands[1]))        { ret 15; }
    ret 0;
}

# a spilled destination stores through the scratch, and the store names the
# vreg it homes as provenance on both its register and its slot
test "mach.lang.be.codegen.regalloc.rewrite_instr:a_spilled_secret_destination_keeps_its_origin_through_the_store" {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var scratch_arena: arena.Arena;
    val init_r:        err[A.Error] = arena.init(?scratch_arena, ?backing, 65536);
    if (sel init_r.err) { ret 1; }
    fin { arena.dnit(?scratch_arena); }
    var alloc:   A.Allocator;
    val make_r2: err[A.Error] = arena.make(?alloc, ?scratch_arena);
    if (sel make_r2.err) { ret 1; }
    var vregs: [2]mir.MirVReg;
    vregs[0]            = mir.vreg(0, REG_CLASS_GP, false, true);
    vregs[0].spill_slot = 0;
    vregs[1]            = mir.vreg(1, REG_CLASS_GP, false, false);
    vregs[1].assigned   = mir.preg_id(7);
    var f: mir.MirFunction;
    f.vregs      = ?vregs[0];
    f.vreg_count = 2;
    var scratch: [1]isa.Register;
    scratch[0].id = 9;
    var ctx: AllocCtx;
    ctx.alloc                = ?alloc;
    ctx.f                    = ?f;
    ctx.spill_width          = 8;
    ctx.reload_scratch       = ?scratch[0];
    ctx.reload_scratch_count = 1;
    var tgt: target.Target;
    val ar:  res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](?alloc, 2::usize);
    if (sel ar.err) { ret 1; }
    val ops: *mir.MirOperand = ar.ok;
    ops[0] = mir.op_vreg(mir.vreg_id(0));
    ops[1] = mir.op_vreg(mir.vreg_id(1));
    var mi:                      mir.MirInstr   = mir.instr(mir.MIR_MOV, ops, 2, 8, 8);
    val capture_operand_banks_r: err[fail.Fail] = rules.capture_operand_banks(?f, ?mi);
    if (sel capture_operand_banks_r.err) { ret 2; }
    var dst:     [4]mir.MirInstr;
    var written: u32 = 0;
    fin {
        var i: u32 = 0;
        for (i < written) {
            free_ops(?ctx, dst[i].operands, dst[i].operand_count);
            i = i + 1;
        }
    }
    val rewrite_instr_r: err[fail.Fail] = rewrite_instr(?tgt, ?ctx, ?mi, ?dst[0], ?written, false, 0);
    if (sel rewrite_instr_r.err) { ret 3; }
    if (written != 2)            { ret 4; }
    val mov: *mir.MirInstr = ?dst[0];
    if (mov.operands[0].kind != mir.MIR_OP_PREG || mov.operands[0].preg.n != 9)                        { ret 5; }
    if (mir.operand_origin(?mov.operands[0]).n != 0 || !mir.operand_seed_secret(?f, ?mov.operands[0])) { ret 6; }
    if (mir.operand_origin(?mov.operands[1]).n != 1 || mir.operand_seed_secret(?f, ?mov.operands[1]))  { ret 7; }
    val store: *mir.MirInstr = ?dst[1];
    if (store.opcode != mir.MIR_MOV || store.operands[0].kind != mir.MIR_OP_MEM)                           { ret 8; }
    if (mir.operand_origin(?store.operands[0]).n != 0 || !mir.operand_seed_secret(?f, ?store.operands[0])) { ret 9; }
    if (store.operands[1].kind != mir.MIR_OP_PREG || store.operands[1].preg.n != 9)                        { ret 10; }
    if (mir.operand_origin(?store.operands[1]).n != 0 || !mir.operand_seed_secret(?f, ?store.operands[1])) { ret 11; }
    ret 0;
}

test "mach.lang.be.codegen.regalloc.rewrite_instr:spilled_update_reloads_previous_value_once" {
    val one: i32 = t_spilled_update(0);
    if (one != 0) { ret one; }
    val repeated: i32 = t_spilled_update(1);
    if (repeated != 0) { ret 10 + repeated; }
    val pure: i32 = t_spilled_update(2);
    if (pure != 0) { ret 20 + pure; }
    ret 0;
}

fun t_verify_bank_slots(tgt: *target.Target, opcode: mir.MirOpcode, bank0: mir.OperandBank,
    bank1: mir.OperandBank, bank2: mir.OperandBank, count: u32, vector: bool) i32 {
    var expected: [3]mir.OperandBank;
    expected[0] = bank0;
    expected[1] = bank1;
    expected[2] = bank2;
    var ops: [3]mir.MirOperand;
    var k:   u32 = 0;
    for (k < count) {
        var class: i32 = isa.REG_CLASS_ID_GP;
        if (expected[k] == mir.BANK_FP) { class = isa.REG_CLASS_ID_XMM; }
        ops[k] = mir.op_preg(mir.preg_id(isa.regid_make(class, 1 + k::i32)));
        k      = k + 1;
    }
    var mi: mir.MirInstr = mir.instr(opcode, ?ops[0], count, 8, 8);
    if (vector) { mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4); }
    var blk: mir.MirBlock;
    blk.instrs      = ?mi;
    blk.instr_count = 1;
    var f: mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    val capture_operand_banks_r: err[fail.Fail] = rules.capture_operand_banks(?f, ?mi);
    if (sel capture_operand_banks_r.err) { ret 1; }
    val verify_rewritten_operands_r: err[fail.Fail] = verify_rewritten_operands(tgt, ?f);
    if (sel verify_rewritten_operands_r.err) { ret 2; }
    k = 0;
    for (k < count) {
        val original: mir.PRegId = ops[k].preg;
        var wrong:    i32        = isa.REG_CLASS_ID_XMM;
        if (expected[k] == mir.BANK_FP) { wrong = isa.REG_CLASS_ID_GP; }
        ops[k].preg = mir.preg_id(isa.regid_make(wrong, 1 + k::i32));
        val verify_rewritten_operands_r2: err[fail.Fail] = verify_rewritten_operands(tgt, ?f);
        if (sel verify_rewritten_operands_r2.ok) { ret 3; }
        ops[k].preg = original;
        k           = k + 1;
    }
    ops[0].required_bank = mir.BANK_UNKNOWN;
    val verify_rewritten_operands_r3: err[fail.Fail] = verify_rewritten_operands(tgt, ?f);
    if (sel verify_rewritten_operands_r3.ok) { ret 4; }
    ret 0;
}

test "mach.lang.be.codegen.regalloc.verify_rewritten_operands:enforces_individual_selected_banks" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_4264: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_4264.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;
    if (t_verify_bank_slots(?tgt, mir.MIR_FADD, mir.BANK_FP, mir.BANK_FP, mir.BANK_FP, 3, false) != 0)          { ret 2; }
    if (t_verify_bank_slots(?tgt, mir.MIR_FCMP, mir.BANK_GP, mir.BANK_FP, mir.BANK_FP, 3, false) != 0)          { ret 3; }
    if (t_verify_bank_slots(?tgt, mir.MIR_FP_TO_SI, mir.BANK_GP, mir.BANK_FP, mir.BANK_UNKNOWN, 2, false) != 0) { ret 4; }
    if (t_verify_bank_slots(?tgt, mir.MIR_SI_TO_FP, mir.BANK_FP, mir.BANK_GP, mir.BANK_UNKNOWN, 2, false) != 0) { ret 5; }
    if (t_verify_bank_slots(?tgt, mir.MIR_MOV, mir.BANK_GP, mir.BANK_GP, mir.BANK_UNKNOWN, 2, false) != 0)      { ret 6; }
    if (t_verify_bank_slots(?tgt, mir.MIR_MOV, mir.BANK_FP, mir.BANK_GP, mir.BANK_UNKNOWN, 2, false) != 0)      { ret 7; }
    if (t_verify_bank_slots(?tgt, mir.MIR_MOV, mir.BANK_GP, mir.BANK_FP, mir.BANK_UNKNOWN, 2, false) != 0)      { ret 8; }
    if (t_verify_bank_slots(?tgt, mir.MIR_ADD, mir.BANK_FP, mir.BANK_FP, mir.BANK_FP, 3, true) != 0)            { ret 9; }
    var ops: [2]mir.MirOperand;
    ops[0] = mir.op_preg(mir.preg_id(1));
    ops[1] = mir.op_mem_preg(mir.preg_id(tgt.model.stack_ptr_reg), 0);
    var mi:  mir.MirInstr = mir.instr(mir.MIR_MOV, ?ops[0], 2, 8, 8);
    var blk: mir.MirBlock;
    blk.instrs      = ?mi;
    blk.instr_count = 1;
    var f: mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    val capture_operand_banks_r: err[fail.Fail] = rules.capture_operand_banks(?f, ?mi);
    if (sel capture_operand_banks_r.err) { ret 10; }
    val verify_rewritten_operands_r: err[fail.Fail] = verify_rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r.err) { ret 11; }
    ops[1].preg = mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 1));
    val verify_rewritten_operands_r2: err[fail.Fail] = verify_rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r2.ok) { ret 12; }
    ops[1].preg  = mir.preg_id(tgt.model.stack_ptr_reg);
    ops[1].index = mir.index_preg(mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 1)));
    val verify_rewritten_operands_r3: err[fail.Fail] = verify_rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r3.ok) { ret 13; }
    val alloc_function_r: err[fail.Fail] = alloc_function(?tgt, nil, ?f);
    if (sel alloc_function_r.ok) { ret 15; }
    ops[1].index = mir.index_preg(mir.preg_id(2));
    val verify_rewritten_operands_r4: err[fail.Fail] = verify_rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r4.err) { ret 14; }
    ret 0;
}

test "mach.lang.be.codegen.regalloc:unknown_catalog_inputs_never_use_the_fp_or_nonregister_defaults" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var interner: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?interner); }
    var registry: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?registry); }
    val r_4309: err[fail.Fail] = target.register_all(?registry, target_testing.debug_descriptor);
    if (sel r_4309.err) { ret 2; }
    val selected: res[target.Target, fail.Fail] = target.select(?registry, "x86_64", "linux", "sysv64");
    if (sel selected.err) { ret 3; }
    var tgt:      target.Target   = selected.ok;
    var reg:      mir.MirVReg     = mir.vreg(0, REG_CLASS_GP, false, false);
    var function: mir.MirFunction = mir.MirFunction{vregs: ?reg, vreg_count: 1};
    var module:   mir.MirModule   = mir.MirModule{alloc: ?alloc, interner: ?interner, functions: ?function, function_len: 1};
    val run_r:    err[fail.Fail]  = run(?tgt, ?module);
    if (sel run_r.err) { ret 4; }
    reg.class = fp_class_index(?tgt);
    val run_r2: err[fail.Fail] = run(?tgt, ?module);
    if (sel run_r2.err) { ret 5; }
    reg.class = 200;
    val unknown: err[fail.Fail] = run(?tgt, ?module);
    if (sel unknown.ok)                                                                { ret 6; }
    if (!str_contains(fail.describe(unknown.err), "unknown MirRegisterClass tag 200")) { ret 6; }
    reg.class = 2;
    if (tgt.model.reg_classes[reg.class].kind != isa.RC_FLAGS) { ret 7; }
    val unsupported: err[fail.Fail] = run(?tgt, ?module);
    if (sel unsupported.ok)                                                                     { ret 8; }
    if (!str_contains(fail.describe(unsupported.err), "unsupported for MIR virtual registers")) { ret 8; }
    var classes: [3]isa.RegClass;
    var ci:      u32 = 0;
    for (ci < 3) {
        classes[ci] = tgt.model.reg_classes[ci];
        ci          = ci + 1;
    }
    tgt.model.reg_classes = ?classes[0];
    val float_class: isa.RegClass = classes[1];
    classes[1] = classes[2];
    classes[2] = float_class;
    reg.class  = 2;
    if (fp_class_index(?tgt) != reg.class) { ret 12; }
    val run_again: err[fail.Fail] = run(?tgt, ?module);
    if (sel run_again.err) { ret 12; }
    classes[1].kind     = 200;
    function.vreg_count = 0;
    val bad_kind: err[fail.Fail] = run(?tgt, ?module);
    if (sel bad_kind.ok)                                                            { ret 9; }
    if (!str_contains(fail.describe(bad_kind.err), "unknown RegClassKind tag 200")) { ret 9; }
    classes[1].kind = isa.RC_FLAGS;
    var operand:     mir.MirOperand = mir.op_imm(7);
    var instruction: mir.MirInstr   = mir.instr(mir.MIR_RET, ?operand, 1, 8, 8);
    var block:       mir.MirBlock   = mir.MirBlock{instrs: ?instruction, instr_count: 1};
    function.blocks      = ?block;
    function.block_count = 1;
    operand.kind         = 200;
    val bad_operand: err[fail.Fail] = run(?tgt, ?module);
    if (sel bad_operand.ok)                                                              { ret 10; }
    if (!str_contains(fail.describe(bad_operand.err), "unknown MirOperandKind tag 200")) { ret 10; }
    ret 0;
}

# the dense block-by-register equations, kept only as the oracle the sparse
# propagation is checked against on small graphs
fun t_dense_liveness(ctx: *AllocCtx) err[fail.Fail] {
    val f:  *mir.MirFunction = ctx.f;
    val nb: u32              = f.block_count;
    val nv: u32              = f.vreg_count;
    if (nb == 0 || nv == 0) { ret err[fail.Fail].ok{}; }
    val total: usize               = (nb::usize) * (nv::usize) * 4;
    val cells: res[*bool, A.Error] = A.allocate[bool](ctx.alloc, total);
    if (sel cells.err) { ret err[fail.Fail].err{fail.refused(cells.err)}; }
    fin { A.deallocate[bool](ctx.alloc, cells.ok, total); }
    val stride:   usize = (nb::usize) * (nv::usize);
    val uses:     *bool = cells.ok;
    val defs:     *bool = ?cells.ok[stride];
    val live_in:  *bool = ?cells.ok[stride * 2];
    val live_out: *bool = ?cells.ok[stride * 3];
    var z:        usize = 0;
    for (z < total) {
        cells.ok[z] = false;
        z           = z + 1;
    }

    var bi: u32 = 0;
    for (bi < nb) {
        val blk:  *mir.MirBlock = ?f.blocks[bi];
        val base: usize         = (bi::usize) * (nv::usize);
        var ii:   u32           = 0;
        for (ii < blk.instr_count) {
            val mi:      *mir.MirInstr = ?blk.instrs[ii];
            val has_def: bool          = instr_defines(mi);
            var k:       u32           = 0;
            for (k < mi.operand_count) {
                val op: *mir.MirOperand = ?mi.operands[k];
                var v:  u32             = mir.MIR_VREG_NIL.n;
                if (op.kind == mir.MIR_OP_VREG || op.kind == mir.MIR_OP_MEM) { v = op.vreg.n; }
                if (v < nv && !(has_def && k == 0 && op.kind == mir.MIR_OP_VREG) && !defs[base + v::usize]) {
                    uses[base + v::usize] = true;
                }
                if (sel op.index.vreg) {
                    if (op.index.vreg.n < nv && !defs[base + op.index.vreg.n::usize]) { uses[base + op.index.vreg.n::usize] = true; }
                }
                k = k + 1;
            }
            if (has_def && mi.operands[0].vreg.n < nv) { defs[base + mi.operands[0].vreg.n::usize] = true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    var changed: bool = true;
    for (changed) {
        changed = false;
        var ri: i64 = nb::i64 - 1;
        for (ri >= 0) {
            val b:    u32   = ri::u32;
            val base: usize = (b::usize) * (nv::usize);
            var v:    u32   = 0;
            for (v < nv) {
                live_out[base + v::usize] = false;
                v                         = v + 1;
            }
            val blk: *mir.MirBlock = ?f.blocks[b];
            if (blk.instr_count > 0) {
                val term: *mir.MirInstr = ?blk.instrs[blk.instr_count - 1];
                var k:    u32           = 0;
                for (k < term.operand_count) {
                    if (term.operands[k].kind == mir.MIR_OP_BLOCK) {
                        val si: u32 = block_index_of(ctx, term.operands[k].imm::u32);
                        if (si != RANGE_NIL) { t_or_row(live_out, base, live_in, (si::usize) * (nv::usize), nv); }
                    }
                    k = k + 1;
                }
            }
            if (b + 1 < nb && block_lists_pred(?f.blocks[b + 1], blk.id)) {
                t_or_row(live_out, base, live_in, ((b + 1)::usize) * (nv::usize), nv);
            }
            v = 0;
            for (v < nv) {
                val idx: usize = base + v::usize;
                if ((uses[idx] || (live_out[idx] && !defs[idx])) && !live_in[idx]) {
                    live_in[idx] = true;
                    changed      = true;
                }
                v = v + 1;
            }
            ri = ri - 1;
        }
    }

    bi = 0;
    for (bi < nb) {
        val base: usize = (bi::usize) * (nv::usize);
        var v:    u32   = 0;
        for (v < nv) {
            extend_range_for_block(?ctx.ranges[v], ctx.block_spans[bi], live_in[base + v::usize], live_out[base + v::usize]);
            v = v + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun t_or_row(dst: *bool, dbase: usize, src: *bool, sbase: usize, nv: u32) {
    var v: u32 = 0;
    for (v < nv) {
        if (src[sbase + v::usize]) { dst[dbase + v::usize] = true; }
        v = v + 1;
    }
}

# eight blocks of four instructions whose uses, definitions, memory operands,
# fallthroughs, self loops and an empty block vary with the sample bits
fun t_sparse_liveness_case(sample: u32, ordinal: usize, attempts: *usize) i32 {
    var track: T.Testing;
    val made:  err[A.Error] = T.make(?track);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?track); }
    var alloc: A.Allocator;
    val paged: err[A.Error] = page.make(?alloc);
    if (sel paged.err) { ret 2; }
    var blocks:    [8]mir.MirBlock;
    var instrs:    [8][4]mir.MirInstr;
    var operands:  [8][4][3]mir.MirOperand;
    var preds:     [8]u32;
    var spans:     [8]BlockSpan;
    var block_map: [64]u32;
    var sparse:    [8]LiveRange;
    var dense:     [8]LiveRange;
    var bi:        u32 = 0;
    for (bi < 64) {
        block_map[bi] = RANGE_NIL;
        bi            = bi + 1;
    }
    bi = 0;
    for (bi < 8) {
        val bid: u32 = 40 - bi * 3;
        blocks[bi].id          = bid;
        block_map[bid]         = bi;
        blocks[bi].instrs      = ?instrs[bi][0];
        blocks[bi].instr_count = 4;
        blocks[bi].preds       = nil;
        blocks[bi].pred_count  = 0;
        if (bi > 0 && ((sample + bi) & 1) == 0) {
            preds[bi]             = 40 - (bi - 1) * 3;
            blocks[bi].preds      = ?preds[bi];
            blocks[bi].pred_count = 1;
        }
        var definition: u32 = 0;
        var use_index:  u32 = 1;
        if ((sample & 2) != 0) {
            definition = 1;
            use_index  = 0;
        }
        operands[bi][definition][0] = mir.op_vreg(mir.vreg_id(bi));
        operands[bi][definition][1] = mir.op_preg(mir.preg_id(0));
        instrs[bi][definition]      = mir.instr(mir.MIR_MOV, ?operands[bi][definition][0], 2, 8, 8);
        operands[bi][use_index][0]  = mir.op_preg(mir.preg_id(0));
        operands[bi][use_index][1]  = mir.op_vreg(mir.vreg_id((bi + sample) % 8));
        instrs[bi][use_index]       = mir.instr(mir.MIR_MOV, ?operands[bi][use_index][0], 2, 8, 8);
        var destination: u32 = (bi + 1) % 8;
        if ((sample & 4) != 0) { destination = bi; }
        if ((sample & 3) == 3) { destination = (bi + 2) % 8; }
        operands[bi][2][0] = mir.op_vreg(mir.vreg_id(destination));
        operands[bi][2][1] = mir.op_mem_value(mir.vreg_id((bi + 2) % 8), 0);
        if ((sample & 1) != 0) { operands[bi][2][1].index = mir.index_preg(mir.preg_id(((bi + 3) % 8)::i32)); }
        or                     { operands[bi][2][1].index = mir.index_vreg(mir.vreg_id((bi + 3) % 8)); }
        instrs[bi][2]      = mir.instr(mir.MIR_LOAD, ?operands[bi][2][0], 2, 8, 8);
        operands[bi][3][0] = mir.op_vreg(mir.vreg_id((bi + 4) % 8));
        operands[bi][3][1] = mir.op_block(40 - ((bi + 1) % 8) * 3);
        operands[bi][3][2] = mir.op_block(40 - ((bi + sample + 6) % 8) * 3);
        instrs[bi][3]      = mir.instr(mir.MIR_CBR, ?operands[bi][3][0], 3, 8, 8);
        spans[bi].start    = (bi * 4)::i64;
        spans[bi].end      = (bi * 4 + 3)::i64;
        if (bi == 5 && (sample & 8) != 0) {
            blocks[bi].instr_count = 0;
            spans[bi].start        = -1;
            spans[bi].end          = -1;
        }
        sparse[bi].vreg    = bi;
        sparse[bi].start   = POS_MAX;
        sparse[bi].end_pos = -1;
        dense[bi]          = sparse[bi];
        bi                 = bi + 1;
    }
    var f: mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 8;
    f.vreg_count  = 8;
    var ctx: AllocCtx;
    ctx.alloc              = T.allocator_of(?track);
    ctx.f                  = ?f;
    ctx.block_spans        = ?spans[0];
    ctx.block_id_index     = ?block_map[0];
    ctx.block_id_index_cap = 64;
    ctx.ranges             = ?sparse[0];
    T.fail_at_ordinal(?track, ordinal);
    val result: err[fail.Fail] = extend_liveness(?ctx);
    @attempts = T.attempt_count(?track);
    if (T.leaked(?track) || T.double_free_count(?track) != 0 || T.tracking_exhausted(?track)) { ret 3; }
    if (ordinal != 0) {
        if (sel result.ok) { ret 4; }
        bi = 0;
        for (bi < 8) {
            if (sparse[bi].start != POS_MAX || sparse[bi].end_pos != -1) { ret 5; }
            bi = bi + 1;
        }
        ret 0;
    }
    if (sel result.err) { ret 6; }
    ctx.alloc  = ?alloc;
    ctx.ranges = ?dense[0];
    val oracle: err[fail.Fail] = t_dense_liveness(?ctx);
    if (sel oracle.err) { ret 7; }
    bi = 0;
    for (bi < 8) {
        if (sparse[bi].start != dense[bi].start || sparse[bi].end_pos != dense[bi].end_pos) { ret 8; }
        bi = bi + 1;
    }
    ret 0;
}

test "mach.lang.be.codegen.regalloc.extend_liveness:sparse_matches_dense_loops_definitions_and_memory_uses" {
    var sample: u32 = 0;
    for (sample < 16) {
        var attempts: usize = 0;
        val result:   i32   = t_sparse_liveness_case(sample, 0, ?attempts);
        if (result != 0) { ret result; }
        sample = sample + 1;
    }
    ret 0;
}

test "mach.lang.be.codegen.regalloc.extend_liveness:allocation_failure_preserves_ranges_and_releases_scratch" {
    var attempts: usize = 0;
    val baseline: i32   = t_sparse_liveness_case(9, 0, ?attempts);
    if (baseline != 0 || attempts == 0) { ret 1; }
    var ordinal: usize = 1;
    for (ordinal <= attempts) {
        var refused_attempts: usize = 0;
        val result:           i32   = t_sparse_liveness_case(9, ordinal, ?refused_attempts);
        if (result != 0) { ret result; }
        ordinal = ordinal + 1;
    }
    ret 0;
}
