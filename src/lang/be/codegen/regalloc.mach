use std.print;
use std.allocator.page;
use std.collections.sort;
use std.format;
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.be.codegen.mir;
use mach.lang.intern;
use mach.lang.layout;
use mach.lang.source;
use mach.lang.target;
use target_testing: mach.lang.target.testing;
use mach.lang.target.abi;
use mach.lang.target.isa;
use tos: mach.lang.target.os;

pub val REG_CLASS_GP: u32 = 0;

val RANGE_NIL: u32 = 0xFFFFFFFF;
val POS_MAX: i64 = 0x7FFFFFFFFFFFFFFF;

rec FlatInstr {
    block:   u32;
    instr:   u32;
    is_call: bool;
}

rec LiveRange {
    vreg:         u32;
    start:        i64;
    end_pos:      i64;
    use_count:    u32;
    reg_class:    u32;
    crosses_call: bool;
}

rec BlockSpan {
    start: i64;
    end:   i64;
}

rec CopyHint {
    src_vreg:     u32;
    src_preg:     i32;
    copy_pos:     i64;
    dst_vreg:     u32;
    dst_copy_pos: i64;
    sink_preg:    i32;
}

rec AllocCtx {
    alloc:                *A.Allocator;
    interner:             *intern.Interner;
    f:                    *mir.MirFunction;
    flat:                 *FlatInstr;
    flat_count:           u32;
    order:                *u32;
    ranges:               *LiveRange;
    gp_count:             u32;
    fp_count:             u32;
    spill_width:          u8;
    callee_saved:         *bool;
    fp_callee_saved:      *bool;
    reserved:             *bool;
    gp_busy:              *bool;
    fp_busy:              *bool;
    fp_pinned_end:        *i64;
    active:               *u32;
    active_count:         u32;
    pinned_end:           *i64;
    param_reg_end:        *i64;
    arg_res_reg:          *u32;
    arg_res_start:        *i64;
    arg_res_end:          *i64;
    arg_res_count:        u32;
    def_res_reg:          *u32;
    def_res_pos:          *i64;
    def_res_count:        u32;
    cur_start:            i64;
    cur_end:              i64;
    reload_scratch:       *isa.Register;
    reload_scratch_count: i32;
    block_id_index:       *u32;
    block_id_index_cap:   u32;
    block_spans:          *BlockSpan;
    vreg_slot_flag:       *bool;
    hints:                *CopyHint;
    anchor_until:         *i64;
}

fun ctx_fn_name(ctx: *AllocCtx) str {
    if (ctx.interner == nil) { ret "<unknown>"; }
    val nm: O.Option[str] = intern.lookup(ctx.interner, ctx.f.name);
    if (O.is_some[str](nm)) { ret O.unwrap[str](nm); }
    ret "<unknown>";
}

fun regalloc_msg(ctx: *AllocCtx, prefix: str, suffix: str, fallback: str) str {
    val name: str = ctx_fn_name(ctx);
    val res_msg: R.Result[str, str] = format.sprint(ctx.alloc, "{}{}{}", prefix, name, suffix);
    if (R.is_err[str, str](res_msg)) { ret fallback; }
    val buf: str = R.unwrap_ok[str, str](res_msg);
    val ir: R.Result[intern.StrId, str] = intern.intern(ctx.interner, buf);
    A.deallocate[u8](ctx.alloc, buf, str_len(buf) + 1);
    if (R.is_err[intern.StrId, str](ir)) { ret fallback; }
    val lo: O.Option[str] = intern.lookup(ctx.interner, R.unwrap_ok[intern.StrId, str](ir));
    if (O.is_some[str](lo)) { ret O.unwrap[str](lo); }
    ret fallback;
}

pub fun run(tgt: *target.Target, m: *mir.MirModule) R.Result[R.Void, str] {
    if (tgt == nil)      { ret R.err[R.Void, str]("regalloc.run: nil target"); }
    if (m == nil)        { ret R.err[R.Void, str]("regalloc.run: nil mir module"); }
    if (tgt.abi == nil)  { ret R.err[R.Void, str]("regalloc.run: target has no ABI vtable"); }
    if (tgt.arch == nil) { ret R.err[R.Void, str]("regalloc.run: target has no ISA vtable"); }
    if (tgt.abi.callee_saved == nil) {
        ret R.err[R.Void, str]("regalloc.run: ABI vtable exposes no callee-saved register file");
    }

    var fi: u32 = 0;
    for (fi < m.function_len) {
        val af: R.Result[R.Void, str] = alloc_function(tgt, m, ?m.functions[fi]);
        if (R.is_err[R.Void, str](af)) { ret af; }
        fi = fi + 1;
    }
    ret R.ok_void[str]();
}

fun fp_class_index(tgt: *target.Target) u32 {
    var ci: u32 = 0;
    for (ci < tgt.model.reg_class_len) {
        if (tgt.model.reg_classes[ci].kind == isa.RC_FLOAT) { ret ci; }
        ci = ci + 1;
    }
    ret RANGE_NIL;
}

fun bank_count(tgt: *target.Target, class: u32) u32 {
    if (class >= tgt.model.reg_class_len) { ret 0; }
    ret tgt.model.reg_classes[class].len;
}

fun alloc_function(tgt: *target.Target, m: *mir.MirModule, f: *mir.MirFunction) R.Result[R.Void, str] {
    if (f.block_count == 0) { ret R.ok_void[str](); }
    if (f.vreg_count == 0)  {
        f.callee_mask = asm_callee_mask(tgt, f);
        val fp_scratch: u32 = fp_scratch_callee_mask(tgt);
        if (fp_scratch != 0 && function_uses_fp_scratch(f)) {
            f.callee_mask_fp = fp_scratch;
        }
        ret R.ok_void[str]();
    }

    var ctx: AllocCtx;
    val ic: R.Result[R.Void, str] = ctx_init(?ctx, tgt, m, f);
    if (R.is_err[R.Void, str](ic)) { ret ic; }

    if (function_has_divide(?ctx)) {
        reserve_reg(?ctx, tgt.arch.div_reg);
        reserve_reg(?ctx, tgt.arch.div_hi_reg);
    }

    if (function_has_reg_shift(?ctx)) {
        reserve_reg(?ctx, tgt.arch.shift_count_reg);
    }

    val vs: R.Result[R.Void, str] = build_vreg_slot_flags(?ctx);
    if (R.is_err[R.Void, str](vs)) { ctx_dnit(?ctx); ret vs; }

    val ds: R.Result[R.Void, str] = sweep_dead_movs(tgt, ?ctx);
    if (R.is_err[R.Void, str](ds)) { ctx_dnit(?ctx); ret ds; }

    val cc: R.Result[R.Void, str] = coalesce_copies(tgt, ?ctx);
    if (R.is_err[R.Void, str](cc)) { ctx_dnit(?ctx); ret cc; }

    val bo: R.Result[R.Void, str] = build_order(?ctx);
    if (R.is_err[R.Void, str](bo)) { ctx_dnit(?ctx); ret bo; }

    val ao: R.Result[R.Void, str] = apply_order(?ctx);
    if (R.is_err[R.Void, str](ao)) { ctx_dnit(?ctx); ret ao; }

    val fl: R.Result[R.Void, str] = flatten(?ctx);
    if (R.is_err[R.Void, str](fl)) { ctx_dnit(?ctx); ret fl; }

    val bs: R.Result[R.Void, str] = build_block_spans(?ctx);
    if (R.is_err[R.Void, str](bs)) { ctx_dnit(?ctx); ret bs; }

    build_ranges(?ctx);

    val lv: R.Result[R.Void, str] = extend_liveness(?ctx);
    if (R.is_err[R.Void, str](lv)) { ctx_dnit(?ctx); ret lv; }

    val mc: R.Result[R.Void, str] = mark_call_crossing(?ctx);
    if (R.is_err[R.Void, str](mc)) { ctx_dnit(?ctx); ret mc; }

    build_hints(tgt, ?ctx);

    val sc: R.Result[R.Void, str] = linear_scan(tgt, ?ctx);
    if (R.is_err[R.Void, str](sc)) { ctx_dnit(?ctx); ret sc; }

    val sp: R.Result[R.Void, str] = spill_across_calls(tgt, ?ctx);
    if (R.is_err[R.Void, str](sp)) { ctx_dnit(?ctx); ret sp; }

    val rw: R.Result[R.Void, str] = rewrite(tgt, ?ctx);
    if (R.is_err[R.Void, str](rw)) { ctx_dnit(?ctx); ret rw; }

    drop_self_copies_physical(tgt, ?ctx);

    val vf: R.Result[R.Void, str] = verify_allocation(tgt, ?ctx);
    if (R.is_err[R.Void, str](vf)) { ctx_dnit(?ctx); ret vf; }

    val vo: R.Result[R.Void, str] = verify_rewritten_operands(tgt, ctx.f);
    if (R.is_err[R.Void, str](vo)) { ctx_dnit(?ctx); ret vo; }

    record_callee_mask(tgt, ?ctx);

    val ro: R.Result[R.Void, str] = restore_order(?ctx);
    if (R.is_err[R.Void, str](ro)) { ctx_dnit(?ctx); ret ro; }

    ctx_dnit(?ctx);
    ret R.ok_void[str]();
}

fun ctx_init(ctx: *AllocCtx, tgt: *target.Target, m: *mir.MirModule, f: *mir.MirFunction) R.Result[R.Void, str] {
    ctx.alloc        = m.alloc;
    ctx.interner     = m.interner;
    ctx.f            = f;
    ctx.flat         = nil;
    ctx.flat_count   = 0;
    ctx.order        = nil;
    ctx.ranges       = nil;
    ctx.gp_count     = bank_count(tgt, REG_CLASS_GP);
    ctx.fp_count     = bank_count(tgt, fp_class_index(tgt));
    ctx.spill_width  = tgt.model.spill_width::u8;
    ctx.callee_saved = nil;
    ctx.fp_callee_saved = nil;
    ctx.reserved     = nil;
    ctx.gp_busy      = nil;
    ctx.fp_busy      = nil;
    ctx.fp_pinned_end = nil;
    ctx.active       = nil;
    ctx.active_count = 0;
    ctx.pinned_end   = nil;
    ctx.param_reg_end = nil;
    ctx.arg_res_reg   = nil;
    ctx.arg_res_start = nil;
    ctx.arg_res_end   = nil;
    ctx.arg_res_count = 0;
    ctx.def_res_reg   = nil;
    ctx.def_res_pos   = nil;
    ctx.def_res_count = 0;
    ctx.cur_start     = 0;
    ctx.cur_end       = 0;
    ctx.reload_scratch       = tgt.arch.reload_scratch_regs;
    ctx.reload_scratch_count = tgt.arch.reload_scratch_count;
    ctx.block_id_index       = nil;
    ctx.block_id_index_cap   = 0;
    ctx.block_spans          = nil;
    ctx.vreg_slot_flag       = nil;
    ctx.hints                = nil;
    ctx.anchor_until         = nil;

    val ro: R.Result[*u32, str] = A.allocate[u32](m.alloc, f.block_count::usize);
    if (R.is_err[*u32, str](ro)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](ro)); }
    ctx.order = R.unwrap_ok[*u32, str](ro);

    val rr: R.Result[*LiveRange, str] = A.allocate[LiveRange](m.alloc, f.vreg_count::usize);
    if (R.is_err[*LiveRange, str](rr)) { ctx_dnit(ctx); ret R.err[R.Void, str](R.unwrap_err[*LiveRange, str](rr)); }
    ctx.ranges = R.unwrap_ok[*LiveRange, str](rr);

    var vi: u32 = 0;
    for (vi < f.vreg_count) {
        ctx.ranges[vi].vreg         = vi;
        ctx.ranges[vi].start        = POS_MAX;
        ctx.ranges[vi].end_pos      = -1;
        ctx.ranges[vi].use_count    = 0;
        ctx.ranges[vi].reg_class    = f.vregs[vi].class;
        ctx.ranges[vi].crosses_call = false;
        vi = vi + 1;
    }

    if (ctx.gp_count > 0) {
        val rcs: R.Result[*bool, str] = A.allocate[bool](m.alloc, ctx.gp_count::usize);
        if (R.is_err[*bool, str](rcs)) { ctx_dnit(ctx); ret R.err[R.Void, str](R.unwrap_err[*bool, str](rcs)); }
        ctx.callee_saved = R.unwrap_ok[*bool, str](rcs);
        val rrv: R.Result[*bool, str] = A.allocate[bool](m.alloc, ctx.gp_count::usize);
        if (R.is_err[*bool, str](rrv)) { ctx_dnit(ctx); ret R.err[R.Void, str](R.unwrap_err[*bool, str](rrv)); }
        ctx.reserved = R.unwrap_ok[*bool, str](rrv);
        val rgb: R.Result[*bool, str] = A.allocate[bool](m.alloc, ctx.gp_count::usize);
        if (R.is_err[*bool, str](rgb)) { ctx_dnit(ctx); ret R.err[R.Void, str](R.unwrap_err[*bool, str](rgb)); }
        ctx.gp_busy = R.unwrap_ok[*bool, str](rgb);
        val rpe: R.Result[*i64, str] = A.allocate[i64](m.alloc, ctx.gp_count::usize);
        if (R.is_err[*i64, str](rpe)) { ctx_dnit(ctx); ret R.err[R.Void, str](R.unwrap_err[*i64, str](rpe)); }
        ctx.pinned_end = R.unwrap_ok[*i64, str](rpe);
        val rpr: R.Result[*i64, str] = A.allocate[i64](m.alloc, ctx.gp_count::usize);
        if (R.is_err[*i64, str](rpr)) { ctx_dnit(ctx); ret R.err[R.Void, str](R.unwrap_err[*i64, str](rpr)); }
        ctx.param_reg_end = R.unwrap_ok[*i64, str](rpr);

        var gi: u32 = 0;
        for (gi < ctx.gp_count) {
            ctx.callee_saved[gi]  = false;
            ctx.reserved[gi]      = false;
            ctx.gp_busy[gi]       = false;
            ctx.pinned_end[gi]    = -1;
            ctx.param_reg_end[gi] = -1;
            gi = gi + 1;
        }

        seed_reserved(tgt, ctx);
    }

    if (ctx.fp_count > 0) {
        val rfb: R.Result[*bool, str] = A.allocate[bool](m.alloc, ctx.fp_count::usize);
        if (R.is_err[*bool, str](rfb)) { ctx_dnit(ctx); ret R.err[R.Void, str](R.unwrap_err[*bool, str](rfb)); }
        ctx.fp_busy = R.unwrap_ok[*bool, str](rfb);
        val rfp: R.Result[*i64, str] = A.allocate[i64](m.alloc, ctx.fp_count::usize);
        if (R.is_err[*i64, str](rfp)) { ctx_dnit(ctx); ret R.err[R.Void, str](R.unwrap_err[*i64, str](rfp)); }
        ctx.fp_pinned_end = R.unwrap_ok[*i64, str](rfp);
        val rfc: R.Result[*bool, str] = A.allocate[bool](m.alloc, ctx.fp_count::usize);
        if (R.is_err[*bool, str](rfc)) { ctx_dnit(ctx); ret R.err[R.Void, str](R.unwrap_err[*bool, str](rfc)); }
        ctx.fp_callee_saved = R.unwrap_ok[*bool, str](rfc);
        var fii: u32 = 0;
        for (fii < ctx.fp_count) {
            ctx.fp_busy[fii] = false;
            ctx.fp_pinned_end[fii] = -1;
            ctx.fp_callee_saved[fii] = false;
            fii = fii + 1;
        }
    }

    seed_callee_saved(tgt, ctx);

    val ra: R.Result[*u32, str] = A.allocate[u32](m.alloc, f.vreg_count::usize);
    if (R.is_err[*u32, str](ra)) { ctx_dnit(ctx); ret R.err[R.Void, str](R.unwrap_err[*u32, str](ra)); }
    ctx.active = R.unwrap_ok[*u32, str](ra);

    val rh: R.Result[*CopyHint, str] = A.allocate[CopyHint](m.alloc, f.vreg_count::usize);
    if (R.is_err[*CopyHint, str](rh)) { ctx_dnit(ctx); ret R.err[R.Void, str](R.unwrap_err[*CopyHint, str](rh)); }
    ctx.hints = R.unwrap_ok[*CopyHint, str](rh);
    var hi: u32 = 0;
    for (hi < f.vreg_count) {
        ctx.hints[hi].src_vreg     = mir.MIR_VREG_NIL;
        ctx.hints[hi].src_preg     = -1;
        ctx.hints[hi].copy_pos     = -1;
        ctx.hints[hi].dst_vreg     = mir.MIR_VREG_NIL;
        ctx.hints[hi].dst_copy_pos = -1;
        ctx.hints[hi].sink_preg    = -1;
        hi = hi + 1;
    }

    val rau: R.Result[*i64, str] = A.allocate[i64](m.alloc, f.vreg_count::usize);
    if (R.is_err[*i64, str](rau)) { ctx_dnit(ctx); ret R.err[R.Void, str](R.unwrap_err[*i64, str](rau)); }
    ctx.anchor_until = R.unwrap_ok[*i64, str](rau);
    var ai: u32 = 0;
    for (ai < f.vreg_count) { ctx.anchor_until[ai] = -1; ai = ai + 1; }

    ret R.ok_void[str]();
}

fun ctx_dnit(ctx: *AllocCtx) {
    if (ctx.flat != nil && ctx.flat_count > 0) {
        A.deallocate[FlatInstr](ctx.alloc, ctx.flat, ctx.flat_count::usize);
        ctx.flat = nil;
    }
    if (ctx.order != nil) {
        A.deallocate[u32](ctx.alloc, ctx.order, ctx.f.block_count::usize);
        ctx.order = nil;
    }
    if (ctx.ranges != nil) {
        A.deallocate[LiveRange](ctx.alloc, ctx.ranges, ctx.f.vreg_count::usize);
        ctx.ranges = nil;
    }
    if (ctx.callee_saved != nil) {
        A.deallocate[bool](ctx.alloc, ctx.callee_saved, ctx.gp_count::usize);
        ctx.callee_saved = nil;
    }
    if (ctx.fp_callee_saved != nil) {
        A.deallocate[bool](ctx.alloc, ctx.fp_callee_saved, ctx.fp_count::usize);
        ctx.fp_callee_saved = nil;
    }
    if (ctx.reserved != nil) {
        A.deallocate[bool](ctx.alloc, ctx.reserved, ctx.gp_count::usize);
        ctx.reserved = nil;
    }
    if (ctx.gp_busy != nil) {
        A.deallocate[bool](ctx.alloc, ctx.gp_busy, ctx.gp_count::usize);
        ctx.gp_busy = nil;
    }
    if (ctx.pinned_end != nil) {
        A.deallocate[i64](ctx.alloc, ctx.pinned_end, ctx.gp_count::usize);
        ctx.pinned_end = nil;
    }
    if (ctx.param_reg_end != nil) {
        A.deallocate[i64](ctx.alloc, ctx.param_reg_end, ctx.gp_count::usize);
        ctx.param_reg_end = nil;
    }
    if (ctx.arg_res_reg != nil && ctx.flat_count > 0) {
        A.deallocate[u32](ctx.alloc, ctx.arg_res_reg, ctx.flat_count::usize);
        ctx.arg_res_reg = nil;
    }
    if (ctx.arg_res_start != nil && ctx.flat_count > 0) {
        A.deallocate[i64](ctx.alloc, ctx.arg_res_start, ctx.flat_count::usize);
        ctx.arg_res_start = nil;
    }
    if (ctx.arg_res_end != nil && ctx.flat_count > 0) {
        A.deallocate[i64](ctx.alloc, ctx.arg_res_end, ctx.flat_count::usize);
        ctx.arg_res_end = nil;
    }
    if (ctx.def_res_reg != nil && ctx.flat_count > 0) {
        A.deallocate[u32](ctx.alloc, ctx.def_res_reg, ctx.flat_count::usize);
        ctx.def_res_reg = nil;
    }
    if (ctx.def_res_pos != nil && ctx.flat_count > 0) {
        A.deallocate[i64](ctx.alloc, ctx.def_res_pos, ctx.flat_count::usize);
        ctx.def_res_pos = nil;
    }
    if (ctx.fp_busy != nil) {
        A.deallocate[bool](ctx.alloc, ctx.fp_busy, ctx.fp_count::usize);
        ctx.fp_busy = nil;
    }
    if (ctx.fp_pinned_end != nil) {
        A.deallocate[i64](ctx.alloc, ctx.fp_pinned_end, ctx.fp_count::usize);
        ctx.fp_pinned_end = nil;
    }
    if (ctx.active != nil) {
        A.deallocate[u32](ctx.alloc, ctx.active, ctx.f.vreg_count::usize);
        ctx.active = nil;
    }
    if (ctx.block_id_index != nil && ctx.block_id_index_cap > 0) {
        A.deallocate[u32](ctx.alloc, ctx.block_id_index, ctx.block_id_index_cap::usize);
        ctx.block_id_index = nil;
    }
    if (ctx.block_spans != nil && ctx.f.block_count > 0) {
        A.deallocate[BlockSpan](ctx.alloc, ctx.block_spans, ctx.f.block_count::usize);
        ctx.block_spans = nil;
    }
    if (ctx.vreg_slot_flag != nil && ctx.f.vreg_count > 0) {
        A.deallocate[bool](ctx.alloc, ctx.vreg_slot_flag, ctx.f.vreg_count::usize);
        ctx.vreg_slot_flag = nil;
    }
    if (ctx.hints != nil && ctx.f.vreg_count > 0) {
        A.deallocate[CopyHint](ctx.alloc, ctx.hints, ctx.f.vreg_count::usize);
        ctx.hints = nil;
    }
    if (ctx.anchor_until != nil && ctx.f.vreg_count > 0) {
        A.deallocate[i64](ctx.alloc, ctx.anchor_until, ctx.f.vreg_count::usize);
        ctx.anchor_until = nil;
    }
}

val MAX_REG_FILE: i32 = 32;

fun reserve_reg(ctx: *AllocCtx, id: i32) {
    if (id < 0)                  { ret; }
    if (id::u32 >= ctx.gp_count) { ret; }
    ctx.reserved[id::u32] = true;
}

fun seed_callee_saved(tgt: *target.Target, ctx: *AllocCtx) {
    var regs: [32]isa.Register;
    val fill: abi.RegFileFn = tgt.abi.callee_saved;
    val n: i32 = fill(?regs[0]);
    var i: i32 = 0;
    for (i < n && i < MAX_REG_FILE) {
        val id: i32 = regs[i].id;
        if (isa.regid_class(id) == isa.REG_CLASS_ID_GP) {
            if (ctx.callee_saved != nil && id >= 0 && id::u32 < ctx.gp_count) {
                ctx.callee_saved[id::u32] = true;
            }
        } or {
            val idx: i32 = isa.regid_index(id);
            if (ctx.fp_callee_saved != nil && idx >= 0 && idx::u32 < ctx.fp_count) {
                ctx.fp_callee_saved[idx::u32] = true;
            }
        }
        i = i + 1;
    }
}

fun seed_reserved(tgt: *target.Target, ctx: *AllocCtx) {
    var i: i32 = 0;
    for (i < tgt.arch.reserved_reg_count && i < MAX_REG_FILE) {
        reserve_reg(ctx, tgt.arch.reserved_regs[i].id);
        i = i + 1;
    }
    var j: i32 = 0;
    for (j < tgt.arch.reload_scratch_count && j < MAX_REG_FILE) {
        reserve_reg(ctx, tgt.arch.reload_scratch_regs[j].id);
        j = j + 1;
    }
    reserve_reg(ctx, tgt.arch.scratch_reg);
    reserve_reg(ctx, tgt.arch.scratch_reg2);

    val platform_mask: u32 = tos.reserved_gp_for(tgt.os, tgt.isa.id);
    var pr: i32 = 0;
    for (pr < 32) {
        if ((platform_mask & (1::u32 << pr::u32)) != 0) { reserve_reg(ctx, pr); }
        pr = pr + 1;
    }
}

fun function_has_divide(ctx: *AllocCtx) bool {
    val f: *mir.MirFunction = ctx.f;
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val o: mir.MirOpcode = blk.instrs[ii].opcode;
            if (mir.has(o, mir.MIRF_SEL_DIVIDE)) { ret true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

fun function_has_reg_shift(ctx: *AllocCtx) bool {
    val f: *mir.MirFunction = ctx.f;
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            val o: mir.MirOpcode = mi.opcode;
            if (mir.has(o, mir.MIRF_SEL_SHIFT)) {
                if (mi.operand_count >= 3 && mi.operands[2].kind == mir.MIR_OP_PREG) {
                    ret true;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

fun build_order(ctx: *AllocCtx) R.Result[R.Void, str] {
    val f: *mir.MirFunction = ctx.f;
    val n: u32 = f.block_count;

    val bx: R.Result[R.Void, str] = fill_block_id_index(ctx);
    if (R.is_err[R.Void, str](bx)) { ret bx; }

    val rv: R.Result[*bool, str] = A.allocate[bool](ctx.alloc, n::usize);
    if (R.is_err[*bool, str](rv)) { ret R.err[R.Void, str](R.unwrap_err[*bool, str](rv)); }
    val visited: *bool = R.unwrap_ok[*bool, str](rv);
    var i: u32 = 0;
    for (i < n) { visited[i] = false; i = i + 1; }

    val rs: R.Result[*u32, str] = A.allocate[u32](ctx.alloc, n::usize);
    if (R.is_err[*u32, str](rs)) { A.deallocate[bool](ctx.alloc, visited, n::usize); ret R.err[R.Void, str](R.unwrap_err[*u32, str](rs)); }
    val stack: *u32 = R.unwrap_ok[*u32, str](rs);
    val re: R.Result[*u32, str] = A.allocate[u32](ctx.alloc, n::usize);
    if (R.is_err[*u32, str](re)) {
        A.deallocate[bool](ctx.alloc, visited, n::usize);
        A.deallocate[u32](ctx.alloc, stack, n::usize);
        ret R.err[R.Void, str](R.unwrap_err[*u32, str](re));
    }
    val succ_ix: *u32 = R.unwrap_ok[*u32, str](re);

    val rp: R.Result[*u32, str] = A.allocate[u32](ctx.alloc, n::usize);
    if (R.is_err[*u32, str](rp)) {
        A.deallocate[bool](ctx.alloc, visited, n::usize);
        A.deallocate[u32](ctx.alloc, stack, n::usize);
        A.deallocate[u32](ctx.alloc, succ_ix, n::usize);
        ret R.err[R.Void, str](R.unwrap_err[*u32, str](rp));
    }
    val post: *u32 = R.unwrap_ok[*u32, str](rp);
    var post_count: u32 = 0;

    var sp: u32 = 0;
    stack[sp] = 0;
    succ_ix[sp] = 0;
    visited[0] = true;
    sp = sp + 1;

    for (sp > 0) {
        val top: u32 = sp - 1;
        val b: u32 = stack[top];
        val next: u32 = next_unvisited_succ(ctx, b, ?succ_ix[top], visited);
        if (next == RANGE_NIL) {
            post[post_count] = b;
            post_count = post_count + 1;
            sp = sp - 1;
        } or {
            visited[next] = true;
            stack[sp] = next;
            succ_ix[sp] = 0;
            sp = sp + 1;
        }
    }

    var oi: u32 = 0;
    var k: u32 = post_count;
    for (k > 0) {
        k = k - 1;
        ctx.order[oi] = post[k];
        oi = oi + 1;
    }
    var bi: u32 = 0;
    for (bi < n) {
        if (!visited[bi]) {
            ctx.order[oi] = bi;
            oi = oi + 1;
        }
        bi = bi + 1;
    }

    A.deallocate[bool](ctx.alloc, visited, n::usize);
    A.deallocate[u32](ctx.alloc, stack, n::usize);
    A.deallocate[u32](ctx.alloc, succ_ix, n::usize);
    A.deallocate[u32](ctx.alloc, post, n::usize);
    ret R.ok_void[str]();
}

fun next_unvisited_succ(ctx: *AllocCtx, b: u32, six: *u32, visited: *bool) u32 {
    val f: *mir.MirFunction = ctx.f;
    val blk: *mir.MirBlock = ?f.blocks[b];
    if (blk.instr_count == 0) { ret RANGE_NIL; }

    val term: *mir.MirInstr = ?blk.instrs[blk.instr_count - 1];
    for (@six < term.operand_count) {
        val op: *mir.MirOperand = ?term.operands[@six];
        @six = @six + 1;
        if (op.kind == mir.MIR_OP_BLOCK) {
            val tgt_idx: u32 = block_index_of(ctx, op.imm::u32);
            if (tgt_idx != RANGE_NIL && !visited[tgt_idx]) {
                ret tgt_idx;
            }
        }
    }
    ret RANGE_NIL;
}

fun fill_block_id_index(ctx: *AllocCtx) R.Result[R.Void, str] {
    val f: *mir.MirFunction = ctx.f;
    val n: u32 = f.block_count;
    if (n == 0) { ret R.ok_void[str](); }

    if (ctx.block_id_index == nil) {
        var max_id: u32 = 0;
        var i: u32 = 0;
        for (i < n) {
            if (f.blocks[i].id > max_id) { max_id = f.blocks[i].id; }
            i = i + 1;
        }
        val cap: u32 = max_id + 1;
        val r: R.Result[*u32, str] = A.allocate[u32](ctx.alloc, cap::usize);
        if (R.is_err[*u32, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](r)); }
        ctx.block_id_index     = R.unwrap_ok[*u32, str](r);
        ctx.block_id_index_cap = cap;
    }

    var j: u32 = 0;
    for (j < ctx.block_id_index_cap) { ctx.block_id_index[j] = RANGE_NIL; j = j + 1; }
    var k: u32 = 0;
    for (k < n) { ctx.block_id_index[f.blocks[k].id] = k; k = k + 1; }
    ret R.ok_void[str]();
}

fun block_index_of(ctx: *AllocCtx, bid: u32) u32 {
    if (bid >= ctx.block_id_index_cap) { ret RANGE_NIL; }
    ret ctx.block_id_index[bid];
}

fun apply_order(ctx: *AllocCtx) R.Result[R.Void, str] {
    val f: *mir.MirFunction = ctx.f;
    val n: u32 = f.block_count;
    if (n <= 1) { ret R.ok_void[str](); }

    val rt: R.Result[*mir.MirBlock, str] = A.allocate[mir.MirBlock](ctx.alloc, n::usize);
    if (R.is_err[*mir.MirBlock, str](rt)) { ret R.err[R.Void, str](R.unwrap_err[*mir.MirBlock, str](rt)); }
    val tmp: *mir.MirBlock = R.unwrap_ok[*mir.MirBlock, str](rt);

    var i: u32 = 0;
    for (i < n) {
        tmp[i] = f.blocks[ctx.order[i]];
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        f.blocks[i] = tmp[i];
        i = i + 1;
    }
    A.deallocate[mir.MirBlock](ctx.alloc, tmp, n::usize);

    ret fill_block_id_index(ctx);
}

fun restore_order(ctx: *AllocCtx) R.Result[R.Void, str] {
    val f: *mir.MirFunction = ctx.f;
    val n: u32 = f.block_count;
    if (n <= 1) { ret R.ok_void[str](); }

    val rt: R.Result[*mir.MirBlock, str] = A.allocate[mir.MirBlock](ctx.alloc, n::usize);
    if (R.is_err[*mir.MirBlock, str](rt)) { ret R.err[R.Void, str](R.unwrap_err[*mir.MirBlock, str](rt)); }
    val tmp: *mir.MirBlock = R.unwrap_ok[*mir.MirBlock, str](rt);

    var i: u32 = 0;
    for (i < n) {
        tmp[ctx.order[i]] = f.blocks[i];
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        f.blocks[i] = tmp[i];
        i = i + 1;
    }
    A.deallocate[mir.MirBlock](ctx.alloc, tmp, n::usize);

    ret R.ok_void[str]();
}

fun flatten(ctx: *AllocCtx) R.Result[R.Void, str] {
    val f: *mir.MirFunction = ctx.f;
    var total: u32 = 0;
    var bi: u32 = 0;
    for (bi < f.block_count) {
        total = total + f.blocks[bi].instr_count;
        bi = bi + 1;
    }
    ctx.flat_count = total;
    if (total == 0) { ctx.flat = nil; ret R.ok_void[str](); }

    val rf: R.Result[*FlatInstr, str] = A.allocate[FlatInstr](ctx.alloc, total::usize);
    if (R.is_err[*FlatInstr, str](rf)) {
        ctx.flat = nil;
        ctx.flat_count = 0;
        ret R.err[R.Void, str](R.unwrap_err[*FlatInstr, str](rf));
    }
    ctx.flat = R.unwrap_ok[*FlatInstr, str](rf);

    var p: u32 = 0;
    bi = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            ctx.flat[p].block   = bi;
            ctx.flat[p].instr   = ii;
            ctx.flat[p].is_call = blk.instrs[ii].opcode == mir.MIR_CALL
                                  || blk.instrs[ii].asm_block != nil;
            p = p + 1;
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret R.ok_void[str]();
}

fun flat_instr(ctx: *AllocCtx, pos: u32) *mir.MirInstr {
    val fi: *FlatInstr = ?ctx.flat[pos];
    ret ?ctx.f.blocks[fi.block].instrs[fi.instr];
}

fun touch(ctx: *AllocCtx, v: u32, pos: u32) {
    if (v >= ctx.f.vreg_count) {
        panic("regalloc: out-of-range vreg id in a MIR operand\n");
    }
    val lr: *LiveRange = ?ctx.ranges[v];
    if (pos::i64 < lr.start)   { lr.start = pos::i64; }
    if (pos::i64 > lr.end_pos) { lr.end_pos = pos::i64; }
    lr.use_count = lr.use_count + 1;
}

fun build_ranges(ctx: *AllocCtx) {
    var pos: u32 = 0;
    for (pos < ctx.flat_count) {
        val mi: *mir.MirInstr = flat_instr(ctx, pos);
        var k: u32 = 0;
        for (k < mi.operand_count) {
            val op: *mir.MirOperand = ?mi.operands[k];
            if (op.kind == mir.MIR_OP_VREG) {
                touch(ctx, op.vreg, pos);
            } or (op.kind == mir.MIR_OP_MEM && op.vreg != mir.MIR_VREG_NIL) {
                touch(ctx, op.vreg, pos);
            }
            if (op.kind == mir.MIR_OP_MEM && !op.index_is_preg && op.index != mir.MIR_VREG_NIL) {
                touch(ctx, op.index, pos);
            }
            k = k + 1;
        }
        pos = pos + 1;
    }
}

fun isa_is_reg_move(tgt: *target.Target, opcode: u32) bool {
    if (tgt.arch.is_reg_move == nil) { ret false; }
    ret tgt.arch.is_reg_move(opcode);
}

fun instr_is_reg_copy(tgt: *target.Target, mi: *mir.MirInstr) bool {
    if (mi.operand_count != 2)            { ret false; }
    if (mi.asm_block != nil)              { ret false; }
    if (mi.width != mi.src_width)         { ret false; }
    if (!isa_is_reg_move(tgt, mi.opcode)) { ret false; }
    val d: *mir.MirOperand = ?mi.operands[0];
    val s: *mir.MirOperand = ?mi.operands[1];
    if (d.kind != mir.MIR_OP_VREG && d.kind != mir.MIR_OP_PREG) { ret false; }
    if (s.kind != mir.MIR_OP_VREG && s.kind != mir.MIR_OP_PREG && s.kind != mir.MIR_OP_IMM) { ret false; }
    ret true;
}

fun tally_reads(ctx: *AllocCtx, reads: *u32, nv: u32) {
    val f: *mir.MirFunction = ctx.f;
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            val has_def: bool = instr_defines(mi);
            var k: u32 = 0;
            for (k < mi.operand_count) {
                val op: *mir.MirOperand = ?mi.operands[k];
                if (op.kind == mir.MIR_OP_VREG) {
                    val is_dst: bool = has_def && k == 0;
                    if (!is_dst && op.vreg < nv) { reads[op.vreg] = reads[op.vreg] + 1; }
                } or (op.kind == mir.MIR_OP_MEM && op.vreg != mir.MIR_VREG_NIL && op.vreg < nv) {
                    reads[op.vreg] = reads[op.vreg] + 1;
                }
                if (op.kind == mir.MIR_OP_MEM && !op.index_is_preg && op.index != mir.MIR_VREG_NIL && op.index < nv) {
                    reads[op.index] = reads[op.index] + 1;
                }
                k = k + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun is_dead_mov(tgt: *target.Target, ctx: *AllocCtx, mi: *mir.MirInstr, reads: *u32, nv: u32) bool {
    if (!instr_is_reg_copy(tgt, mi)) { ret false; }
    val d: *mir.MirOperand = ?mi.operands[0];
    if (d.kind != mir.MIR_OP_VREG) { ret false; }
    if (d.vreg >= nv)              { ret false; }
    if (vreg_has_slot(ctx, d.vreg)) { ret false; }
    ret reads[d.vreg] == 0;
}

fun sweep_dead_movs(tgt: *target.Target, ctx: *AllocCtx) R.Result[R.Void, str] {
    val f: *mir.MirFunction = ctx.f;
    val nv: u32 = f.vreg_count;
    if (nv == 0)                     { ret R.ok_void[str](); }
    if (tgt.arch.is_reg_move == nil) { ret R.ok_void[str](); }

    val rr: R.Result[*u32, str] = A.allocate[u32](ctx.alloc, nv::usize);
    if (R.is_err[*u32, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](rr)); }
    val reads: *u32 = R.unwrap_ok[*u32, str](rr);

    var changed: bool = true;
    for (changed) {
        changed = false;
        var i: u32 = 0;
        for (i < nv) { reads[i] = 0; i = i + 1; }
        tally_reads(ctx, reads, nv);

        var bi: u32 = 0;
        for (bi < f.block_count) {
            val blk: *mir.MirBlock = ?f.blocks[bi];
            var write: u32 = 0;
            var read:  u32 = 0;
            for (read < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[read];
                if (is_dead_mov(tgt, ctx, mi, reads, nv)) {
                    if (mi.operands != nil && mi.operand_count > 0) {
                        A.deallocate[mir.MirOperand](ctx.alloc, mi.operands, mi.operand_count::usize);
                    }
                    if (mi.dbg_bindings != nil && mi.dbg_binding_count > 0) {
                        A.deallocate[mir.MirDbgBinding](ctx.alloc, mi.dbg_bindings, mi.dbg_binding_count::usize);
                    }
                    changed = true;
                } or {
                    if (write != read) { blk.instrs[write] = blk.instrs[read]; }
                    write = write + 1;
                }
                read = read + 1;
            }
            blk.instr_count = write;
            bi = bi + 1;
        }
    }

    A.deallocate[u32](ctx.alloc, reads, nv::usize);
    ret R.ok_void[str]();
}

fun instr_reads_vreg(mi: *mir.MirInstr, v: u32) bool {
    val has_def: bool = instr_defines(mi);
    var k: u32 = 0;
    for (k < mi.operand_count) {
        val op: *mir.MirOperand = ?mi.operands[k];
        if (op.kind == mir.MIR_OP_VREG) {
            val is_dst: bool = has_def && k == 0;
            if (!is_dst && op.vreg == v) { ret true; }
        }
        if (op.kind == mir.MIR_OP_MEM) {
            if (op.vreg != mir.MIR_VREG_NIL && op.vreg == v)                        { ret true; }
            if (!op.index_is_preg && op.index != mir.MIR_VREG_NIL && op.index == v) { ret true; }
        }
        k = k + 1;
    }
    ret false;
}

fun web_find(parent: *u32, v: u32) u32 {
    var r: u32 = v;
    for (parent[r] != r) { r = parent[r]; }
    var c: u32 = v;
    for (parent[c] != r) {
        val n: u32 = parent[c];
        parent[c] = r;
        c = n;
    }
    ret r;
}

fun tally_defs(ctx: *AllocCtx, defs: *u32, nv: u32) {
    val f: *mir.MirFunction = ctx.f;
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (instr_defines(mi)) {
                val d: *mir.MirOperand = ?mi.operands[0];
                if (d.vreg < nv) { defs[d.vreg] = defs[d.vreg] + 1; }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun try_coalesce(tgt: *target.Target, ctx: *AllocCtx, mi: *mir.MirInstr,
                 parent: *u32, web_defs: *u32, nv: u32) bool {
    if (!instr_is_reg_copy(tgt, mi))  { ret false; }
    if (mi.width < ctx.spill_width)   { ret false; }
    val dop: *mir.MirOperand = ?mi.operands[0];
    val sop: *mir.MirOperand = ?mi.operands[1];
    if (dop.kind != mir.MIR_OP_VREG || sop.kind != mir.MIR_OP_VREG) { ret false; }
    val d: u32 = dop.vreg;
    val s: u32 = sop.vreg;
    if (d >= nv || s >= nv || d == s)                { ret false; }
    if (vreg_has_slot(ctx, d) || vreg_has_slot(ctx, s)) { ret false; }

    val dv: *mir.MirVReg = ?ctx.f.vregs[d];
    val sv: *mir.MirVReg = ?ctx.f.vregs[s];
    if (dv.class  != sv.class)  { ret false; }
    if (dv.secret != sv.secret) { ret false; }
    if (dv.vector != sv.vector) { ret false; }

    val rd: u32 = web_find(parent, d);
    val rs: u32 = web_find(parent, s);
    if (rd == rs)            { ret false; }
    if (web_defs[rd] != 1)   { ret false; }
    if (web_defs[rs] != 1)   { ret false; }

    parent[rd] = rs;
    ret true;
}

fun rename_vregs(ctx: *AllocCtx, parent: *u32, nv: u32) {
    val f: *mir.MirFunction = ctx.f;
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            var k: u32 = 0;
            for (k < mi.operand_count) {
                val op: *mir.MirOperand = ?mi.operands[k];
                if (op.kind == mir.MIR_OP_VREG && op.vreg < nv) {
                    op.vreg = web_find(parent, op.vreg);
                } or (op.kind == mir.MIR_OP_MEM) {
                    if (op.vreg != mir.MIR_VREG_NIL && op.vreg < nv) {
                        op.vreg = web_find(parent, op.vreg);
                    }
                    if (!op.index_is_preg && op.index != mir.MIR_VREG_NIL && op.index < nv) {
                        op.index = web_find(parent, op.index);
                    }
                }
                k = k + 1;
            }
            var b: u32 = 0;
            for (b < mi.dbg_binding_count) {
                val db: *mir.MirDbgBinding = ?mi.dbg_bindings[b];
                if (db.vreg  != mir.MIR_VREG_NIL && db.vreg  < nv) { db.vreg  = web_find(parent, db.vreg); }
                if (db.vreg2 != mir.MIR_VREG_NIL && db.vreg2 < nv) { db.vreg2 = web_find(parent, db.vreg2); }
                b = b + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun drop_self_copies(tgt: *target.Target, ctx: *AllocCtx) {
    val f: *mir.MirFunction = ctx.f;
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var write: u32 = 0;
        var read:  u32 = 0;
        for (read < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[read];
            var drop: bool = false;
            if (instr_is_reg_copy(tgt, mi)) {
                val a: *mir.MirOperand = ?mi.operands[0];
                val b: *mir.MirOperand = ?mi.operands[1];
                drop = a.kind == mir.MIR_OP_VREG && b.kind == mir.MIR_OP_VREG && a.vreg == b.vreg;
            }
            if (drop) {
                if (mi.operands != nil && mi.operand_count > 0) {
                    A.deallocate[mir.MirOperand](ctx.alloc, mi.operands, mi.operand_count::usize);
                }
                if (mi.dbg_bindings != nil && mi.dbg_binding_count > 0) {
                    A.deallocate[mir.MirDbgBinding](ctx.alloc, mi.dbg_bindings, mi.dbg_binding_count::usize);
                }
            } or {
                if (write != read) { blk.instrs[write] = blk.instrs[read]; }
                write = write + 1;
            }
            read = read + 1;
        }
        blk.instr_count = write;
        bi = bi + 1;
    }
}

fun coalesce_copies(tgt: *target.Target, ctx: *AllocCtx) R.Result[R.Void, str] {
    val f: *mir.MirFunction = ctx.f;
    val nv: u32 = f.vreg_count;
    if (nv == 0)                     { ret R.ok_void[str](); }
    if (tgt.arch.is_reg_move == nil) { ret R.ok_void[str](); }

    val rp: R.Result[*u32, str] = A.allocate[u32](ctx.alloc, nv::usize);
    if (R.is_err[*u32, str](rp)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](rp)); }
    val parent: *u32 = R.unwrap_ok[*u32, str](rp);
    val rw: R.Result[*u32, str] = A.allocate[u32](ctx.alloc, nv::usize);
    if (R.is_err[*u32, str](rw)) {
        A.deallocate[u32](ctx.alloc, parent, nv::usize);
        ret R.err[R.Void, str](R.unwrap_err[*u32, str](rw));
    }
    val web_defs: *u32 = R.unwrap_ok[*u32, str](rw);

    var i: u32 = 0;
    for (i < nv) { parent[i] = i; web_defs[i] = 0; i = i + 1; }
    tally_defs(ctx, web_defs, nv);

    var merged: bool = false;
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            if (try_coalesce(tgt, ctx, ?blk.instrs[ii], parent, web_defs, nv)) { merged = true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    if (merged) {
        rename_vregs(ctx, parent, nv);
        drop_self_copies(tgt, ctx);
    }

    A.deallocate[u32](ctx.alloc, web_defs, nv::usize);
    A.deallocate[u32](ctx.alloc, parent, nv::usize);
    ret R.ok_void[str]();
}

fun reads_in_window(ctx: *AllocCtx, d: u32, from: i64, to: i64) bool {
    var p: i64 = from + 1;
    for (p < to) {
        if (instr_reads_vreg(flat_instr(ctx, p::u32), d)) { ret true; }
        p = p + 1;
    }
    ret false;
}

fun build_hints(tgt: *target.Target, ctx: *AllocCtx) {
    if (tgt.arch.is_reg_move == nil) { ret; }
    val nv: u32 = ctx.f.vreg_count;
    var pos: u32 = 0;
    for (pos < ctx.flat_count) {
        val mi: *mir.MirInstr = flat_instr(ctx, pos);
        if (instr_is_reg_copy(tgt, mi)) {
            val d: *mir.MirOperand = ?mi.operands[0];
            if (d.kind == mir.MIR_OP_VREG && d.vreg < nv
                && ctx.hints[d.vreg].src_vreg == mir.MIR_VREG_NIL
                && ctx.hints[d.vreg].src_preg < 0) {
                val s: *mir.MirOperand = ?mi.operands[1];
                if (s.kind == mir.MIR_OP_VREG && s.vreg != d.vreg) {
                    ctx.hints[d.vreg].src_vreg = s.vreg;
                    ctx.hints[d.vreg].copy_pos = pos::i64;
                } or (s.kind == mir.MIR_OP_PREG) {
                    ctx.hints[d.vreg].src_preg = s.preg::i32;
                    ctx.hints[d.vreg].copy_pos = pos::i64;
                }
            }
            maybe_sink_hint(ctx, mi, pos, nv);
            maybe_reverse_hint(ctx, mi, pos, nv);
        } or {
            maybe_tie_hint(ctx, mi, pos, nv);
        }
        pos = pos + 1;
    }
}

fun is_two_address_op(op: mir.MirOpcode) bool {
    ret mir.has(op, mir.MIRF_TWO_ADDRESS);
}


fun maybe_tie_hint(ctx: *AllocCtx, mi: *mir.MirInstr, pos: u32, nv: u32) {
    if (!is_two_address_op(mi.opcode)) { ret; }
    if (mi.operand_count < 3)          { ret; }
    val d: *mir.MirOperand = ?mi.operands[0];
    val l: *mir.MirOperand = ?mi.operands[1];
    if (d.kind != mir.MIR_OP_VREG || l.kind != mir.MIR_OP_VREG) { ret; }
    if (d.vreg >= nv || l.vreg >= nv || d.vreg == l.vreg)       { ret; }
    if (ctx.hints[d.vreg].src_vreg != mir.MIR_VREG_NIL
        || ctx.hints[d.vreg].src_preg >= 0)                     { ret; }
    if (ctx.ranges[l.vreg].end_pos != pos::i64)                 { ret; }
    if (ctx.ranges[d.vreg].start != pos::i64)                   { ret; }
    ctx.hints[d.vreg].src_vreg = l.vreg;
    ctx.hints[d.vreg].copy_pos = pos::i64;
}

fun maybe_sink_hint(ctx: *AllocCtx, mi: *mir.MirInstr, pos: u32, nv: u32) {
    val d: *mir.MirOperand = ?mi.operands[0];
    val s: *mir.MirOperand = ?mi.operands[1];
    if (d.kind != mir.MIR_OP_PREG || s.kind != mir.MIR_OP_VREG) { ret; }
    if (s.vreg >= nv)                                           { ret; }
    if (mi.width < ctx.spill_width)                             { ret; }
    val sv: u32 = s.vreg;
    if (ctx.hints[sv].sink_preg >= 0)                           { ret; }
    if (ctx.ranges[sv].end_pos != pos::i64)                     { ret; }
    ctx.hints[sv].sink_preg = d.preg::i32;
}

fun maybe_reverse_hint(ctx: *AllocCtx, mi: *mir.MirInstr, pos: u32, nv: u32) {
    val d: *mir.MirOperand = ?mi.operands[0];
    val s: *mir.MirOperand = ?mi.operands[1];
    if (d.kind != mir.MIR_OP_VREG || s.kind != mir.MIR_OP_VREG) { ret; }
    if (d.vreg >= nv || s.vreg >= nv || d.vreg == s.vreg)       { ret; }
    val dv: u32 = d.vreg;
    val sv: u32 = s.vreg;
    if (ctx.hints[sv].dst_vreg != mir.MIR_VREG_NIL) { ret; }

    val p: i64 = pos::i64;
    val dr: *LiveRange = ?ctx.ranges[dv];
    val sr: *LiveRange = ?ctx.ranges[sv];

    if (dr.start >= p || dr.end_pos < p) { ret; }
    if (sr.end_pos != p || sr.start >= p || sr.start < 0) { ret; }
    if (ctx.flat[sr.start::u32].block != ctx.flat[pos].block) { ret; }
    if (reads_in_window(ctx, dv, sr.start, p)) { ret; }

    ctx.hints[sv].dst_vreg     = dv;
    ctx.hints[sv].dst_copy_pos = p;
}

fun extend_liveness(ctx: *AllocCtx) R.Result[R.Void, str] {
    val f: *mir.MirFunction = ctx.f;
    val nb: u32 = f.block_count;
    val nv: u32 = f.vreg_count;
    if (nb == 0 || nv == 0) { ret R.ok_void[str](); }

    val total: usize = (nb::usize) * (nv::usize);
    val use_set: R.Result[*bool, str] = A.allocate[bool](ctx.alloc, total);
    if (R.is_err[*bool, str](use_set)) { ret R.err[R.Void, str](R.unwrap_err[*bool, str](use_set)); }
    val uses: *bool = R.unwrap_ok[*bool, str](use_set);
    val def_set: R.Result[*bool, str] = A.allocate[bool](ctx.alloc, total);
    if (R.is_err[*bool, str](def_set)) { A.deallocate[bool](ctx.alloc, uses, total); ret R.err[R.Void, str](R.unwrap_err[*bool, str](def_set)); }
    val defs: *bool = R.unwrap_ok[*bool, str](def_set);
    val in_set: R.Result[*bool, str] = A.allocate[bool](ctx.alloc, total);
    if (R.is_err[*bool, str](in_set)) {
        A.deallocate[bool](ctx.alloc, uses, total);
        A.deallocate[bool](ctx.alloc, defs, total);
        ret R.err[R.Void, str](R.unwrap_err[*bool, str](in_set));
    }
    val live_in: *bool = R.unwrap_ok[*bool, str](in_set);
    val out_set: R.Result[*bool, str] = A.allocate[bool](ctx.alloc, total);
    if (R.is_err[*bool, str](out_set)) {
        A.deallocate[bool](ctx.alloc, uses, total);
        A.deallocate[bool](ctx.alloc, defs, total);
        A.deallocate[bool](ctx.alloc, live_in, total);
        ret R.err[R.Void, str](R.unwrap_err[*bool, str](out_set));
    }
    val live_out: *bool = R.unwrap_ok[*bool, str](out_set);

    var z: usize = 0;
    for (z < total) {
        uses[z] = false;
        defs[z] = false;
        live_in[z] = false;
        live_out[z] = false;
        z = z + 1;
    }

    compute_use_def(ctx, uses, defs, nv);

    var changed: bool = true;
    for (changed) {
        changed = false;
        var ri: i64 = nb::i64 - 1;
        for (ri >= 0) {
            val b: u32 = ri::u32;
            val base: usize = (b::usize) * (nv::usize);

            var v: u32 = 0;
            for (v < nv) { live_out[base + v::usize] = false; v = v + 1; }
            union_succ_live_in(ctx, b, live_out, live_in, nv);

            v = 0;
            for (v < nv) {
                val idx: usize = base + v::usize;
                var new_in: bool = uses[idx];
                if (live_out[idx] && !defs[idx]) { new_in = true; }
                if (new_in && !live_in[idx]) {
                    live_in[idx] = true;
                    changed = true;
                }
                v = v + 1;
            }
            ri = ri - 1;
        }
    }

    var bi: u32 = 0;
    for (bi < nb) {
        val span: BlockSpan = ctx.block_spans[bi];
        val base: usize = (bi::usize) * (nv::usize);
        var v: u32 = 0;
        for (v < nv) {
            val idx: usize = base + v::usize;
            extend_range_for_block(?ctx.ranges[v], span, live_in[idx], live_out[idx]);
            v = v + 1;
        }
        bi = bi + 1;
    }

    A.deallocate[bool](ctx.alloc, uses, total);
    A.deallocate[bool](ctx.alloc, defs, total);
    A.deallocate[bool](ctx.alloc, live_in, total);
    A.deallocate[bool](ctx.alloc, live_out, total);
    ret R.ok_void[str]();
}

fun extend_range_for_block(lr: *LiveRange, span: BlockSpan, live_in: bool, live_out: bool) {
    if (live_in && span.start >= 0 && span.start < lr.start) { lr.start = span.start; }
    if (live_out && span.end > lr.end_pos)                   { lr.end_pos = span.end; }
}

fun build_block_spans(ctx: *AllocCtx) R.Result[R.Void, str] {
    val f: *mir.MirFunction = ctx.f;
    val n: u32 = f.block_count;
    if (n == 0) { ret R.ok_void[str](); }

    val r: R.Result[*BlockSpan, str] = A.allocate[BlockSpan](ctx.alloc, n::usize);
    if (R.is_err[*BlockSpan, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*BlockSpan, str](r)); }
    ctx.block_spans = R.unwrap_ok[*BlockSpan, str](r);

    var i: u32 = 0;
    for (i < n) { ctx.block_spans[i].start = -1; ctx.block_spans[i].end = -1; i = i + 1; }
    var pos: u32 = 0;
    for (pos < ctx.flat_count) {
        val b: u32 = ctx.flat[pos].block;
        if (ctx.block_spans[b].start < 0) { ctx.block_spans[b].start = pos::i64; }
        ctx.block_spans[b].end = pos::i64;
        pos = pos + 1;
    }
    ret R.ok_void[str]();
}

fun compute_use_def(ctx: *AllocCtx, uses: *bool, defs: *bool, nv: u32) {
    val f: *mir.MirFunction = ctx.f;
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        val base: usize = (bi::usize) * (nv::usize);
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            val has_def: bool = instr_defines(mi);

            var k: u32 = 0;
            for (k < mi.operand_count) {
                val op: *mir.MirOperand = ?mi.operands[k];
                var v: u32 = mir.MIR_VREG_NIL;
                if (op.kind == mir.MIR_OP_VREG)                               { v = op.vreg; }
                if (op.kind == mir.MIR_OP_MEM && op.vreg != mir.MIR_VREG_NIL) { v = op.vreg; }
                if (v != mir.MIR_VREG_NIL && v < nv) {
                    val is_dst: bool = has_def && k == 0 && op.kind == mir.MIR_OP_VREG;
                    if (!is_dst) {
                        if (!defs[base + v::usize]) { uses[base + v::usize] = true; }
                    }
                }
                if (op.kind == mir.MIR_OP_MEM && !op.index_is_preg && op.index != mir.MIR_VREG_NIL && op.index < nv) {
                    if (!defs[base + op.index::usize]) { uses[base + op.index::usize] = true; }
                }
                k = k + 1;
            }
            if (has_def) {
                val d: *mir.MirOperand = ?mi.operands[0];
                if (d.kind == mir.MIR_OP_VREG && d.vreg < nv) {
                    defs[base + d.vreg::usize] = true;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun instr_defines(mi: *mir.MirInstr) bool {
    if (!mir.instr_defines_shape(mi)) { ret false; }
    ret mi.operands[0].kind == mir.MIR_OP_VREG;
}

fun union_succ_live_in(ctx: *AllocCtx, b: u32, live_out: *bool, live_in: *bool, nv: u32) {
    val f: *mir.MirFunction = ctx.f;
    val blk: *mir.MirBlock = ?f.blocks[b];
    val ob: usize = (b::usize) * (nv::usize);

    if (blk.instr_count > 0) {
        val term: *mir.MirInstr = ?blk.instrs[blk.instr_count - 1];
        var k: u32 = 0;
        for (k < term.operand_count) {
            val op: *mir.MirOperand = ?term.operands[k];
            if (op.kind == mir.MIR_OP_BLOCK) {
                val si: u32 = block_index_of(ctx, op.imm::u32);
                if (si != RANGE_NIL) {
                    or_row(live_out, ob, live_in, (si::usize) * (nv::usize), nv);
                }
            }
            k = k + 1;
        }
    }

    if (b + 1 < f.block_count && block_lists_pred(?f.blocks[b + 1], blk.id)) {
        or_row(live_out, ob, live_in, ((b + 1)::usize) * (nv::usize), nv);
    }
}

fun block_lists_pred(blk: *mir.MirBlock, pred_id: u32) bool {
    var i: u32 = 0;
    for (i < blk.pred_count) {
        if (blk.preds[i] == pred_id) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun or_row(dst: *bool, dbase: usize, src: *bool, sbase: usize, nv: u32) {
    var v: u32 = 0;
    for (v < nv) {
        if (src[sbase + v::usize]) { dst[dbase + v::usize] = true; }
        v = v + 1;
    }
}

fun mark_call_crossing(ctx: *AllocCtx) R.Result[R.Void, str] {
    val n: u32 = ctx.flat_count;
    if (n == 0) { ret R.ok_void[str](); }

    val r: R.Result[*u32, str] = A.allocate[u32](ctx.alloc, (n + 1)::usize);
    if (R.is_err[*u32, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](r)); }
    val prefix: *u32 = R.unwrap_ok[*u32, str](r);
    prefix[0] = 0;
    var p: u32 = 0;
    for (p < n) {
        var inc: u32 = 0;
        if (ctx.flat[p].is_call) { inc = 1; }
        prefix[p + 1] = prefix[p] + inc;
        p = p + 1;
    }

    var v: u32 = 0;
    for (v < ctx.f.vreg_count) {
        val lr: *LiveRange = ?ctx.ranges[v];
        if (lr.end_pos >= 0) {
            if (prefix[(lr.end_pos + 1)::u32] - prefix[lr.start::u32] > 0) {
                lr.crosses_call = true;
            }
        }
        v = v + 1;
    }

    A.deallocate[u32](ctx.alloc, prefix, (n + 1)::usize);
    ret R.ok_void[str]();
}

fun linear_scan(tgt: *target.Target, ctx: *AllocCtx) R.Result[R.Void, str] {
    reserve_param_registers(ctx);
    val br: R.Result[R.Void, str] = build_arg_reservations(ctx);
    if (R.is_err[R.Void, str](br)) { ret br; }

    val nv: u32 = ctx.f.vreg_count;
    val ro: R.Result[*u32, str] = A.allocate[u32](ctx.alloc, nv::usize);
    if (R.is_err[*u32, str](ro)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](ro)); }
    val order: *u32 = R.unwrap_ok[*u32, str](ro);
    var i: u32 = 0;
    for (i < nv) { order[i] = i; i = i + 1; }
    val sb: R.Result[R.Void, str] = sort_by_start(ctx, order, nv);
    if (R.is_err[R.Void, str](sb)) {
        A.deallocate[u32](ctx.alloc, order, nv::usize);
        ret sb;
    }

    var oi: u32 = 0;
    for (oi < nv) {
        val v: u32 = order[oi];
        val lr: *LiveRange = ?ctx.ranges[v];
        if (lr.end_pos < 0) { oi = oi + 1; cnt; }
        if (vreg_has_slot(ctx, v)) { oi = oi + 1; cnt; }

        expire_active(ctx, lr.start);
        release_pins(ctx, lr.start);

        ctx.cur_start = lr.start;
        ctx.cur_end   = lr.end_pos;

        var preg: i32 = -1;
        if (ctx.hints[v].src_vreg != mir.MIR_VREG_NIL || ctx.hints[v].src_preg >= 0) {
            preg = pick_hint(ctx, v, lr);
        }
        if (preg < 0 && ctx.hints[v].sink_preg >= 0) {
            preg = pick_sink_hint(ctx, v, lr);
        }
        if (preg < 0 && ctx.hints[v].dst_vreg != mir.MIR_VREG_NIL) {
            val rr: i32 = pick_target_hint(ctx, v, lr);
            if (rr >= 0) {
                ctx.f.vregs[v].assigned = rr::u32;
                val dv: u32 = ctx.hints[v].dst_vreg;
                if (ctx.hints[v].dst_copy_pos > ctx.anchor_until[dv]) {
                    ctx.anchor_until[dv] = ctx.hints[v].dst_copy_pos;
                }
                oi = oi + 1;
                cnt;
            }
        }
        if (preg < 0) {
            if (lr.reg_class == REG_CLASS_GP) {
                preg = pick_gp(ctx, lr.crosses_call);
            } or {
                preg = pick_fp(ctx, lr.crosses_call);
            }
        }

        if (preg >= 0) {
            assign(ctx, v, preg::u32, lr.reg_class);
        } or {
            val sr: R.Result[R.Void, str] = spill_on_pressure(ctx, v);
            if (R.is_err[R.Void, str](sr)) { A.deallocate[u32](ctx.alloc, order, nv::usize); ret sr; }
        }
        oi = oi + 1;
    }

    A.deallocate[u32](ctx.alloc, order, nv::usize);
    ret R.ok_void[str]();
}

fun reserve_param_registers(ctx: *AllocCtx) {
    val f: *mir.MirFunction = ctx.f;
    if (f.block_count == 0) { ret; }
    val blk: *mir.MirBlock = ?f.blocks[0];
    var pos: u32 = 0;
    var ii: u32 = 0;
    for (ii < blk.instr_count) {
        val mi: *mir.MirInstr = ?blk.instrs[ii];
        if (mi.operand_count == 2) {
            val d: *mir.MirOperand = ?mi.operands[0];
            val s: *mir.MirOperand = ?mi.operands[1];
            if ((d.kind == mir.MIR_OP_VREG || d.kind == mir.MIR_OP_MEM) && s.kind == mir.MIR_OP_PREG) {
                val r: u32 = s.preg;
                if (isa.regid_class(r::i32) == isa.REG_CLASS_ID_GP) {
                    if (r < ctx.gp_count && pos::i64 > ctx.pinned_end[r]) {
                        ctx.pinned_end[r]    = pos::i64;
                        ctx.param_reg_end[r] = pos::i64;
                    }
                } or {
                    val fi: u32 = isa.regid_index(r::i32)::u32;
                    if (ctx.fp_pinned_end != nil && fi < ctx.fp_count && pos::i64 > ctx.fp_pinned_end[fi]) {
                        ctx.fp_pinned_end[fi] = pos::i64;
                    }
                }
            }
        }
        pos = pos + 1;
        ii = ii + 1;
    }
}

fun build_arg_reservations(ctx: *AllocCtx) R.Result[R.Void, str] {
    ctx.arg_res_count = 0;
    ctx.def_res_count = 0;
    if (ctx.flat_count == 0) { ret R.ok_void[str](); }

    val rr: R.Result[*u32, str] = A.allocate[u32](ctx.alloc, ctx.flat_count::usize);
    if (R.is_err[*u32, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](rr)); }
    ctx.arg_res_reg = R.unwrap_ok[*u32, str](rr);
    val rs: R.Result[*i64, str] = A.allocate[i64](ctx.alloc, ctx.flat_count::usize);
    if (R.is_err[*i64, str](rs)) { ret R.err[R.Void, str](R.unwrap_err[*i64, str](rs)); }
    ctx.arg_res_start = R.unwrap_ok[*i64, str](rs);
    val re: R.Result[*i64, str] = A.allocate[i64](ctx.alloc, ctx.flat_count::usize);
    if (R.is_err[*i64, str](re)) { ret R.err[R.Void, str](R.unwrap_err[*i64, str](re)); }
    ctx.arg_res_end = R.unwrap_ok[*i64, str](re);
    val dr: R.Result[*u32, str] = A.allocate[u32](ctx.alloc, ctx.flat_count::usize);
    if (R.is_err[*u32, str](dr)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](dr)); }
    ctx.def_res_reg = R.unwrap_ok[*u32, str](dr);
    val dp: R.Result[*i64, str] = A.allocate[i64](ctx.alloc, ctx.flat_count::usize);
    if (R.is_err[*i64, str](dp)) { ret R.err[R.Void, str](R.unwrap_err[*i64, str](dp)); }
    ctx.def_res_pos = R.unwrap_ok[*i64, str](dp);

    var pos: u32 = 0;
    for (pos < ctx.flat_count) {
        val mi: *mir.MirInstr = flat_instr(ctx, pos);
        if (!instr_defines_preg(mi)) { pos = pos + 1; cnt; }
        val d: *mir.MirOperand = ?mi.operands[0];
        val r: u32 = d.preg;

        ctx.def_res_reg[ctx.def_res_count] = r;
        ctx.def_res_pos[ctx.def_res_count] = pos::i64;
        ctx.def_res_count = ctx.def_res_count + 1;

        var c: u32 = pos + 1;
        var found: bool = false;
        var killed: bool = false;
        for (c < ctx.flat_count && !found && !killed) {
            if (ctx.flat[c].is_call) {
                found = true;
            } or {
                val mj: *mir.MirInstr = flat_instr(ctx, c);
                if (instr_defines_preg(mj) && mj.operands[0].preg == r) { killed = true; }
                c = c + 1;
            }
        }
        if (found) {
            ctx.arg_res_reg[ctx.arg_res_count]   = r;
            ctx.arg_res_start[ctx.arg_res_count] = (pos + 1)::i64;
            ctx.arg_res_end[ctx.arg_res_count]   = c::i64;
            ctx.arg_res_count = ctx.arg_res_count + 1;
        }
        pos = pos + 1;
    }
    ret R.ok_void[str]();
}

fun instr_defines_preg(mi: *mir.MirInstr) bool {
    if (!mir.instr_defines_shape(mi)) { ret false; }
    ret mi.operands[0].kind == mir.MIR_OP_PREG;
}

fun arg_reg_reserved(ctx: *AllocCtx, id: u32) bool {
    var i: u32 = 0;
    for (i < ctx.arg_res_count) {
        if (ctx.arg_res_reg[i] == id) {
            if (!(ctx.cur_end < ctx.arg_res_start[i] || ctx.cur_start > ctx.arg_res_end[i])) {
                ret true;
            }
        }
        i = i + 1;
    }
    ret false;
}

fun arg_reg_busy_at(ctx: *AllocCtx, id: u32, pos: u32) bool {
    var i: u32 = 0;
    for (i < ctx.arg_res_count) {
        if (ctx.arg_res_reg[i] == id
            && pos::i64 >= ctx.arg_res_start[i]
            && pos::i64 <= ctx.arg_res_end[i]) {
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun release_pins(ctx: *AllocCtx, current_start: i64) {
    var r: u32 = 0;
    for (r < ctx.gp_count) {
        if (ctx.pinned_end[r] >= 0 && ctx.pinned_end[r] < current_start) {
            ctx.pinned_end[r] = -1;
        }
        r = r + 1;
    }
    if (ctx.fp_pinned_end != nil) {
        var fi: u32 = 0;
        for (fi < ctx.fp_count) {
            if (ctx.fp_pinned_end[fi] >= 0 && ctx.fp_pinned_end[fi] < current_start) {
                ctx.fp_pinned_end[fi] = -1;
            }
            fi = fi + 1;
        }
    }
}

fun build_vreg_slot_flags(ctx: *AllocCtx) R.Result[R.Void, str] {
    val f: *mir.MirFunction = ctx.f;
    val nv: u32 = f.vreg_count;
    if (nv == 0) { ret R.ok_void[str](); }

    val r: R.Result[*bool, str] = A.allocate[bool](ctx.alloc, nv::usize);
    if (R.is_err[*bool, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*bool, str](r)); }
    ctx.vreg_slot_flag = R.unwrap_ok[*bool, str](r);
    var i: u32 = 0;
    for (i < nv) { ctx.vreg_slot_flag[i] = false; i = i + 1; }

    val frame: *mir.MirFrame = ?f.frame;
    var s: u32 = 0;
    for (s < frame.slot_count) {
        val owner: u32 = frame.slots[s].value;
        if (owner < nv) { ctx.vreg_slot_flag[owner] = true; }
        s = s + 1;
    }
    ret R.ok_void[str]();
}

fun vreg_has_slot(ctx: *AllocCtx, v: u32) bool {
    if (v >= ctx.f.vreg_count) { ret false; }
    ret ctx.vreg_slot_flag[v];
}

rec RangeKey {
    start:   i64;
    end_pos: i64;
    idx:     u32;
}

fun range_key_cmp(a: *RangeKey, b: *RangeKey) i64 {
    if (a.start < b.start)     { ret -1; }
    if (a.start > b.start)     { ret 1; }
    if (a.end_pos < b.end_pos) { ret -1; }
    if (a.end_pos > b.end_pos) { ret 1; }
    if (a.idx < b.idx)         { ret -1; }
    if (a.idx > b.idx)         { ret 1; }
    ret 0;
}

fun sort_by_start(ctx: *AllocCtx, order: *u32, count: u32) R.Result[R.Void, str] {
    if (count < 2) { ret R.ok_void[str](); }
    val keys_r: R.Result[*RangeKey, str] = A.allocate[RangeKey](ctx.alloc, count::usize);
    if (R.is_err[*RangeKey, str](keys_r)) { ret R.err[R.Void, str](R.unwrap_err[*RangeKey, str](keys_r)); }
    val keys: *RangeKey = R.unwrap_ok[*RangeKey, str](keys_r);
    var i: u32 = 0;
    for (i < count) {
        keys[i].start   = ctx.ranges[order[i]].start;
        keys[i].end_pos = ctx.ranges[order[i]].end_pos;
        keys[i].idx     = order[i];
        i = i + 1;
    }
    sort.sort[RangeKey](keys, count::usize, range_key_cmp);
    i = 0;
    for (i < count) {
        order[i] = keys[i].idx;
        i = i + 1;
    }
    A.deallocate[RangeKey](ctx.alloc, keys, count::usize);
    ret R.ok_void[str]();
}

fun expire_active(ctx: *AllocCtx, current_start: i64) {
    var write: u32 = 0;
    var read: u32 = 0;
    for (read < ctx.active_count) {
        val v: u32 = ctx.active[read];
        val lr: *LiveRange = ?ctx.ranges[v];
        if (lr.end_pos >= current_start) {
            ctx.active[write] = v;
            write = write + 1;
        } or {
            free_assigned(ctx, v);
        }
        read = read + 1;
    }
    ctx.active_count = write;
}

fun free_assigned(ctx: *AllocCtx, v: u32) {
    val mv: *mir.MirVReg = ?ctx.f.vregs[v];
    if (mv.assigned == mir.MIR_VREG_NIL) { ret; }
    val lr: *LiveRange = ?ctx.ranges[v];
    val index: u32 = isa.regid_index(mv.assigned::i32)::u32;
    if (lr.reg_class == REG_CLASS_GP) {
        if (index < ctx.gp_count) { ctx.gp_busy[index] = false; }
    } or {
        if (index < ctx.fp_count) { ctx.fp_busy[index] = false; }
    }
}

fun pick_hint(ctx: *AllocCtx, v: u32, lr: *LiveRange) i32 {
    val h: *CopyHint = ?ctx.hints[v];

    var rid: i32 = -1;
    if (h.src_preg >= 0) {
        rid = h.src_preg;
    } or (h.src_vreg != mir.MIR_VREG_NIL) {
        val s: u32 = h.src_vreg;
        if (s < ctx.f.vreg_count && !is_spilled(ctx, s) && !vreg_has_slot(ctx, s)) {
            val a: u32 = ctx.f.vregs[s].assigned;
            if (a != mir.MIR_VREG_NIL) { rid = a::i32; }
        }
    }
    if (rid < 0) { ret -1; }

    val rclass: i32 = isa.regid_class(rid);
    val idx: u32 = isa.regid_index(rid)::u32;

    if (lr.reg_class == REG_CLASS_GP) {
        if (rclass != isa.REG_CLASS_ID_GP) { ret -1; }
        if (idx >= ctx.gp_count)           { ret -1; }
        if (ctx.reserved[idx])             { ret -1; }
        if (lr.crosses_call && !ctx.callee_saved[idx]) { ret -1; }
        if (arg_reg_reserved(ctx, rid::u32)) { ret -1; }
        if (def_reg_reserved(ctx, rid::u32)) { ret -1; }
        if (ctx.pinned_end[idx] >= 0 && ctx.pinned_end[idx] != lr.start) { ret -1; }
        if (!ctx.gp_busy[idx]) {
            ctx.gp_busy[idx] = true;
            ret rid;
        }
        if (can_transfer(ctx, lr, h)) {
            transfer_source_reg(ctx, h.src_vreg, rid::u32);
            ret rid;
        }
        ret -1;
    } or {
        if (rclass != isa.REG_CLASS_ID_XMM) { ret -1; }
        if (idx >= ctx.fp_count)            { ret -1; }
        if (lr.crosses_call && (ctx.fp_callee_saved == nil || !ctx.fp_callee_saved[idx])) { ret -1; }
        if (arg_reg_reserved(ctx, rid::u32)) { ret -1; }
        if (def_reg_reserved(ctx, rid::u32)) { ret -1; }
        if (ctx.fp_pinned_end != nil && ctx.fp_pinned_end[idx] >= 0 && ctx.fp_pinned_end[idx] != lr.start) { ret -1; }
        if (!ctx.fp_busy[idx]) {
            ctx.fp_busy[idx] = true;
            ret rid;
        }
        if (can_transfer(ctx, lr, h)) {
            transfer_source_reg(ctx, h.src_vreg, rid::u32);
            ret rid;
        }
        ret -1;
    }
}

fun can_transfer(ctx: *AllocCtx, lr: *LiveRange, h: *CopyHint) bool {
    if (h.src_vreg == mir.MIR_VREG_NIL) { ret false; }
    if (h.copy_pos < 0)                 { ret false; }
    if (ctx.ranges[h.src_vreg].end_pos != h.copy_pos) { ret false; }
    if (lr.start != h.copy_pos)                       { ret false; }
    ret true;
}

fun transfer_source_reg(ctx: *AllocCtx, src: u32, rid: u32) {
    if (!vreg_in_active(ctx, src) || ctx.f.vregs[src].assigned != rid) {
        panic("regalloc: copy-hint transfer source is not the live owner of its register\n");
    }
    remove_active(ctx, src);
}

fun pick_sink_hint(ctx: *AllocCtx, v: u32, lr: *LiveRange) i32 {
    val rid: i32 = ctx.hints[v].sink_preg;
    if (rid < 0) { ret -1; }

    val rclass: i32 = isa.regid_class(rid);
    val idx: u32 = isa.regid_index(rid)::u32;

    if (lr.reg_class == REG_CLASS_GP) {
        if (rclass != isa.REG_CLASS_ID_GP) { ret -1; }
        if (idx >= ctx.gp_count)           { ret -1; }
        if (ctx.reserved[idx])             { ret -1; }
        if (lr.crosses_call && !ctx.callee_saved[idx]) { ret -1; }
        if (!gp_available(ctx, idx))       { ret -1; }
        ctx.gp_busy[idx] = true;
        ret rid;
    } or {
        if (rclass != isa.REG_CLASS_ID_XMM) { ret -1; }
        if (idx >= ctx.fp_count)            { ret -1; }
        if (lr.crosses_call && (ctx.fp_callee_saved == nil || !ctx.fp_callee_saved[idx])) { ret -1; }
        if (!fp_available(ctx, idx))        { ret -1; }
        ctx.fp_busy[idx] = true;
        ret rid;
    }
}

fun pick_target_hint(ctx: *AllocCtx, v: u32, lr: *LiveRange) i32 {
    val d: u32 = ctx.hints[v].dst_vreg;
    if (d >= ctx.f.vreg_count)                       { ret -1; }
    if (is_spilled(ctx, d) || vreg_has_slot(ctx, d)) { ret -1; }
    val a: u32 = ctx.f.vregs[d].assigned;
    if (a == mir.MIR_VREG_NIL)                       { ret -1; }

    val rid: i32 = a::i32;
    val rclass: i32 = isa.regid_class(rid);
    val idx: u32 = isa.regid_index(rid)::u32;
    if (lr.reg_class == REG_CLASS_GP) {
        if (rclass != isa.REG_CLASS_ID_GP || idx >= ctx.gp_count) { ret -1; }
    } or {
        if (rclass != isa.REG_CLASS_ID_XMM || idx >= ctx.fp_count) { ret -1; }
    }
    ret rid;
}

fun vreg_in_active(ctx: *AllocCtx, v: u32) bool {
    var i: u32 = 0;
    for (i < ctx.active_count) {
        if (ctx.active[i] == v) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun pick_gp(ctx: *AllocCtx, crosses_call: bool) i32 {
    if (crosses_call) {
        var ci: u32 = 0;
        for (ci < ctx.gp_count) {
            if (gp_available(ctx, ci) && ctx.callee_saved[ci] && !ctx.reserved[ci]) {
                ctx.gp_busy[ci] = true;
                ret isa.regid_make(isa.REG_CLASS_ID_GP, ci::i32);
            }
            ci = ci + 1;
        }
    } or {
        var ci: u32 = 0;
        for (ci < ctx.gp_count) {
            if (gp_available(ctx, ci) && !ctx.callee_saved[ci] && !ctx.reserved[ci]) {
                ctx.gp_busy[ci] = true;
                ret isa.regid_make(isa.REG_CLASS_ID_GP, ci::i32);
            }
            ci = ci + 1;
        }
    }
    var ci: u32 = 0;
    for (ci < ctx.gp_count) {
        if (gp_available(ctx, ci) && !ctx.reserved[ci]) {
            ctx.gp_busy[ci] = true;
            ret isa.regid_make(isa.REG_CLASS_ID_GP, ci::i32);
        }
        ci = ci + 1;
    }
    ret -1;
}

fun def_reg_reserved(ctx: *AllocCtx, id: u32) bool {
    var i: u32 = 0;
    for (i < ctx.def_res_count) {
        if (ctx.def_res_reg[i] == id
            && ctx.cur_start <= ctx.def_res_pos[i]
            && ctx.cur_end > ctx.def_res_pos[i]) {
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun gp_available(ctx: *AllocCtx, id: u32) bool {
    if (ctx.gp_busy[id])           { ret false; }
    if (ctx.pinned_end[id] >= 0)   { ret false; }
    if (arg_reg_reserved(ctx, id)) { ret false; }
    if (def_reg_reserved(ctx, id)) { ret false; }
    ret true;
}

fun fp_available(ctx: *AllocCtx, fi: u32) bool {
    if (ctx.fp_busy[fi])                                        { ret false; }
    if (ctx.fp_pinned_end != nil && ctx.fp_pinned_end[fi] >= 0) { ret false; }
    val cid: u32 = isa.regid_make(isa.REG_CLASS_ID_XMM, fi::i32)::u32;
    if (arg_reg_reserved(ctx, cid)) { ret false; }
    if (def_reg_reserved(ctx, cid)) { ret false; }
    ret true;
}

fun pick_fp(ctx: *AllocCtx, crosses_call: bool) i32 {
    if (crosses_call) {
        var ci: u32 = 0;
        for (ci < ctx.fp_count) {
            if (fp_available(ctx, ci) && ctx.fp_callee_saved[ci]) {
                ctx.fp_busy[ci] = true;
                ret isa.regid_make(isa.REG_CLASS_ID_XMM, ci::i32);
            }
            ci = ci + 1;
        }
    } or {
        var ci: u32 = 0;
        for (ci < ctx.fp_count) {
            if (fp_available(ctx, ci) && !ctx.fp_callee_saved[ci]) {
                ctx.fp_busy[ci] = true;
                ret isa.regid_make(isa.REG_CLASS_ID_XMM, ci::i32);
            }
            ci = ci + 1;
        }
    }
    var fi: u32 = 0;
    for (fi < ctx.fp_count) {
        if (fp_available(ctx, fi)) {
            ctx.fp_busy[fi] = true;
            ret isa.regid_make(isa.REG_CLASS_ID_XMM, fi::i32);
        }
        fi = fi + 1;
    }
    ret -1;
}

fun assign(ctx: *AllocCtx, v: u32, preg: u32, reg_class: u32) {
    val preg_class: i32 = isa.regid_class(preg::i32);
    if (reg_class == REG_CLASS_GP) {
        if (preg_class != isa.REG_CLASS_ID_GP) {
            panic("regalloc: GP vreg assigned a non-GP register\n");
        }
    } or {
        if (preg_class != isa.REG_CLASS_ID_XMM) {
            panic("regalloc: float vreg assigned a non-XMM register\n");
        }
    }
    ctx.f.vregs[v].assigned = preg;
    ctx.active[ctx.active_count] = v;
    ctx.active_count = ctx.active_count + 1;
}

fun spill_on_pressure(ctx: *AllocCtx, v: u32) R.Result[R.Void, str] {
    val lr: *LiveRange = ?ctx.ranges[v];
    val victim: u32 = find_spill_victim(ctx, lr.reg_class);
    if (victim == mir.MIR_VREG_NIL) {
        ret spill_vreg(ctx, v);
    }

    val vr: *LiveRange = ?ctx.ranges[victim];
    if (vr.end_pos < lr.end_pos) {
        ret spill_vreg(ctx, v);
    }

    val freed: u32 = ctx.f.vregs[victim].assigned;
    val sr: R.Result[R.Void, str] = spill_vreg(ctx, victim);
    if (R.is_err[R.Void, str](sr)) { ret sr; }
    free_assigned_id(ctx, victim, lr.reg_class, freed);
    remove_active(ctx, victim);

    var preg: i32 = -1;
    if (lr.reg_class == REG_CLASS_GP) {
        preg = pick_gp(ctx, lr.crosses_call);
    } or {
        preg = pick_fp(ctx, lr.crosses_call);
    }
    if (preg >= 0) {
        assign(ctx, v, preg::u32, lr.reg_class);
        ret R.ok_void[str]();
    }
    ret spill_vreg(ctx, v);
}

fun free_assigned_id(ctx: *AllocCtx, v: u32, reg_class: u32, preg: u32) {
    val index: u32 = isa.regid_index(preg::i32)::u32;
    if (reg_class == REG_CLASS_GP) {
        if (index < ctx.gp_count) { ctx.gp_busy[index] = false; }
    } or {
        if (index < ctx.fp_count) { ctx.fp_busy[index] = false; }
    }
}

fun remove_active(ctx: *AllocCtx, v: u32) {
    var write: u32 = 0;
    var read: u32 = 0;
    for (read < ctx.active_count) {
        if (ctx.active[read] != v) {
            ctx.active[write] = ctx.active[read];
            write = write + 1;
        }
        read = read + 1;
    }
    ctx.active_count = write;
}

fun find_spill_victim(ctx: *AllocCtx, reg_class: u32) u32 {
    var best: u32 = mir.MIR_VREG_NIL;
    var best_density: i64 = POS_MAX;
    var best_crosses: bool = true;
    var ai: u32 = 0;
    for (ai < ctx.active_count) {
        val v: u32 = ctx.active[ai];
        val lr: *LiveRange = ?ctx.ranges[v];
        if (lr.reg_class != reg_class)            { ai = ai + 1; cnt; }
        if (ctx.anchor_until[v] >= ctx.cur_start) { ai = ai + 1; cnt; }

        val span: i64 = lr.end_pos - lr.start;
        var density: i64 = lr.use_count::i64 * 1000;
        if (span > 0) { density = density / span; }

        var better: bool = false;
        if (!lr.crosses_call && best_crosses) {
            better = true;
        } or (lr.crosses_call == best_crosses && density < best_density) {
            better = true;
        }
        if (better) {
            best_density = density;
            best_crosses = lr.crosses_call;
            best = v;
        }
        ai = ai + 1;
    }
    ret best;
}

fun spill_vreg(ctx: *AllocCtx, v: u32) R.Result[R.Void, str] {
    val mv: *mir.MirVReg = ?ctx.f.vregs[v];
    if (mv.spill_slot >= 0) { ret R.ok_void[str](); }
    mv.assigned = mir.MIR_VREG_NIL;

    val size: u32 = class_width(ctx, ?ctx.ranges[v]);
    val sr: R.Result[i32, str] = add_spill_slot(ctx, v, size);
    if (R.is_err[i32, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](sr)); }
    mv.spill_slot = R.unwrap_ok[i32, str](sr);
    ret R.ok_void[str]();
}

fun class_width(ctx: *AllocCtx, lr: *LiveRange) u32 {
    if (lr.reg_class != REG_CLASS_GP) { ret 16; }
    ret ctx.spill_width::u32;
}

fun spill_slot_align(ctx: *AllocCtx, value_id: u32) u32 {
    if (value_id < ctx.f.vreg_count && ctx.f.vregs[value_id].vector) { ret 16; }
    ret ctx.spill_width::u32;
}

fun add_spill_slot(ctx: *AllocCtx, value_id: u32, size: u32) R.Result[i32, str] {
    val frame: *mir.MirFrame = ?ctx.f.frame;
    if (frame.slot_count >= frame.slot_cap) {
        val current: layout.CheckedCount[mir.MirSlot] = layout.count[mir.MirSlot](frame.slot_cap::usize);
        val required_r: R.Result[layout.CheckedCount[mir.MirSlot], layout.CheckCause] =
            layout.count_add[mir.MirSlot](current, layout.count[mir.MirSlot](1::usize));
        if (R.is_err[layout.CheckedCount[mir.MirSlot], layout.CheckCause](required_r)) {
            ret R.err[i32, str]("regalloc: spill slot table growth count overflow");
        }
        var required: layout.CheckedCount[mir.MirSlot] =
            R.unwrap_ok[layout.CheckedCount[mir.MirSlot], layout.CheckCause](required_r);
        if (required.value < 8) { required = layout.count[mir.MirSlot](8::usize); }
        val grown_r: R.Result[layout.CheckedCount[mir.MirSlot], layout.CheckCause] =
            layout.count_grow[mir.MirSlot](current, required);
        if (R.is_err[layout.CheckedCount[mir.MirSlot], layout.CheckCause](grown_r)) {
            ret R.err[i32, str]("regalloc: spill slot table growth count overflow");
        }
        val new_cap_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
            R.unwrap_ok[layout.CheckedCount[mir.MirSlot], layout.CheckCause](grown_r).value);
        if (R.is_err[u32, layout.CheckCause](new_cap_fits)) {
            ret R.err[i32, str]("regalloc: spill slot table capacity exceeds the u32 limit");
        }
        val new_cap: u32 = R.unwrap_ok[u32, layout.CheckCause](new_cap_fits);
        val r: R.Result[*mir.MirSlot, str] = A.reallocate[mir.MirSlot](ctx.alloc, frame.slots, frame.slot_cap::usize, new_cap::usize);
        if (R.is_err[*mir.MirSlot, str](r)) { ret R.err[i32, str](R.unwrap_err[*mir.MirSlot, str](r)); }
        frame.slots    = R.unwrap_ok[*mir.MirSlot, str](r);
        frame.slot_cap = new_cap;
    }
    val si: u32 = frame.slot_count;
    val si_fits: R.Result[i32, layout.CheckCause] = layout.usize_to_i32(si::usize);
    if (R.is_err[i32, layout.CheckCause](si_fits)) {
        ret R.err[i32, str]("regalloc: spill slot index exceeds the i32 limit");
    }
    frame.slots[si].value  = value_id;
    frame.slots[si].kind   = mir.SLOT_SPILL;
    frame.slots[si].offset = 0;
    frame.slots[si].size   = size;
    frame.slots[si].align  = spill_slot_align(ctx, value_id);
    frame.slot_count = frame.slot_count + 1;
    ret R.ok[i32, str](R.unwrap_ok[i32, layout.CheckCause](si_fits));
}

fun asm_instr_clobbers(tgt: *target.Target, mi: *mir.MirInstr, gp: *u32, fp: *u32) bool {
    if (mi.asm_block == nil) { ret false; }
    @gp = 0;
    @fp = 0;
    if (!tgt.arch.has_assembly) {
        @gp = 0xFFFFFFFF;
        @fp = 0xFFFFFFFF;
        ret true;
    }
    tgt.arch.assembly.clobbers(mi.asm_block.body, gp, fp);
    ret true;
}

fun asm_clobbers_at(tgt: *target.Target, ctx: *AllocCtx, pos: u32, gp: *u32, fp: *u32) bool {
    ret asm_instr_clobbers(tgt, flat_instr(ctx, pos), gp, fp);
}

fun abi_callee_saved_gp_mask(tgt: *target.Target) u32 {
    var regs: [32]isa.Register;
    val fill: abi.RegFileFn = tgt.abi.callee_saved;
    val n: i32 = fill(?regs[0]);
    var m: u32 = 0;
    var i: i32 = 0;
    for (i < n && i < MAX_REG_FILE) {
        val id: i32 = regs[i].id;
        if (isa.regid_class(id) == isa.REG_CLASS_ID_GP && id >= 0 && id < 32) {
            m = m | (1::u32 << id::u32);
        }
        i = i + 1;
    }
    ret m;
}

fun abi_callee_saved_fp_mask(tgt: *target.Target) u32 {
    var regs: [32]isa.Register;
    val fill: abi.RegFileFn = tgt.abi.callee_saved;
    val n: i32 = fill(?regs[0]);
    var m: u32 = 0;
    var i: i32 = 0;
    for (i < n && i < MAX_REG_FILE) {
        val id: i32 = regs[i].id;
        if (isa.regid_class(id) == isa.REG_CLASS_ID_XMM) {
            val idx: i32 = isa.regid_index(id);
            if (idx >= 0 && idx < 32) { m = m | (1::u32 << idx::u32); }
        }
        i = i + 1;
    }
    ret m;
}

fun fp_scratch_callee_mask(tgt: *target.Target) u32 {
    val cs: u32 = abi_callee_saved_fp_mask(tgt);
    if (cs == 0) { ret 0; }
    val fpc: u32 = bank_count(tgt, fp_class_index(tgt));
    var alloc_mask: u32 = 0;
    var i: u32 = 0;
    for (i < fpc && i < 32) {
        alloc_mask = alloc_mask | (1::u32 << i);
        i = i + 1;
    }
    ret cs & ~alloc_mask;
}

fun function_uses_fp_scratch(f: *mir.MirFunction) bool {
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            val o: mir.MirOpcode = mi.opcode;
            if (mi.vec_lane != mir.VEC_LANE_NONE) { ret true; }
            if (mir.has(o, mir.MIRF_FLOAT_UNIT)) { ret true; }
            if (o == mir.MIR_MOV) {
                if (mi.width == 16) { ret true; }
                var k: u32 = 0;
                for (k < mi.operand_count) {
                    val op: *mir.MirOperand = ?mi.operands[k];
                    if (op.kind == mir.MIR_OP_VREG && mir.vreg_is_fp(f, op.vreg)) {
                        ret true;
                    }
                    if (op.kind == mir.MIR_OP_PREG &&
                        isa.regid_class(op.preg::i32) == isa.REG_CLASS_ID_XMM) {
                        ret true;
                    }
                    k = k + 1;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

fun isa_reserved_gp_mask(tgt: *target.Target) u32 {
    var m: u32 = 0;
    var i: i32 = 0;
    for (i < tgt.arch.reserved_reg_count && i < MAX_REG_FILE) {
        val id: i32 = tgt.arch.reserved_regs[i].id;
        if (id >= 0 && id < 32) { m = m | (1::u32 << id::u32); }
        i = i + 1;
    }
    var j: i32 = 0;
    for (j < tgt.arch.reload_scratch_count && j < MAX_REG_FILE) {
        val id: i32 = tgt.arch.reload_scratch_regs[j].id;
        if (id >= 0 && id < 32) { m = m | (1::u32 << id::u32); }
        j = j + 1;
    }
    val sid: i32 = tgt.arch.scratch_reg;
    if (sid >= 0 && sid < 32) { m = m | (1::u32 << sid::u32); }
    ret m;
}

fun asm_callee_mask(tgt: *target.Target, f: *mir.MirFunction) u32 {
    val cs: u32 = abi_callee_saved_gp_mask(tgt);
    val res: u32 = isa_reserved_gp_mask(tgt);
    var mask: u32 = 0;
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            var agp: u32 = 0;
            var afp: u32 = 0;
            if (asm_instr_clobbers(tgt, ?blk.instrs[ii], ?agp, ?afp)) {
                mask = mask | (agp & cs & ~res);
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret mask;
}

fun asm_callee_mask_fp(tgt: *target.Target, f: *mir.MirFunction) u32 {
    val cs: u32 = abi_callee_saved_fp_mask(tgt);
    var mask: u32 = 0;
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            var agp: u32 = 0;
            var afp: u32 = 0;
            if (asm_instr_clobbers(tgt, ?blk.instrs[ii], ?agp, ?afp)) {
                mask = mask | (afp & cs);
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret mask;
}

fun spill_across_calls(tgt: *target.Target, ctx: *AllocCtx) R.Result[R.Void, str] {
    var pos: u32 = 0;
    for (pos < ctx.flat_count) {
        if (!ctx.flat[pos].is_call) { pos = pos + 1; cnt; }
        var asm_gp: u32 = 0;
        var asm_fp: u32 = 0;
        val is_asm: bool = asm_clobbers_at(tgt, ctx, pos, ?asm_gp, ?asm_fp);
        var v: u32 = 0;
        for (v < ctx.f.vreg_count) {
            val mv: *mir.MirVReg = ?ctx.f.vregs[v];
            if (mv.assigned == mir.MIR_VREG_NIL) { v = v + 1; cnt; }
            if (mv.spill_slot >= 0)              { v = v + 1; cnt; }
            val lr: *LiveRange = ?ctx.ranges[v];
            if (lr.start >= pos::i64 || lr.end_pos <= pos::i64) { v = v + 1; cnt; }

            var must_spill: bool = false;
            if (lr.reg_class != REG_CLASS_GP) {
                val xidx: u32 = isa.regid_index(mv.assigned::i32)::u32;
                if (xidx >= ctx.fp_count || !ctx.fp_callee_saved[xidx]) {
                    must_spill = true;
                } or (mv.vector && !tgt.abi.fp_callee_saved_full_vector) {
                    must_spill = true;
                } or (is_asm && (asm_fp & (1::u32 << xidx)) != 0) {
                    must_spill = true;
                }
            } or (isa.regid_index(mv.assigned::i32)::u32 < ctx.gp_count
                  && !ctx.callee_saved[isa.regid_index(mv.assigned::i32)::u32]) {
                must_spill = true;
            } or (is_asm && isa.regid_index(mv.assigned::i32)::u32 < ctx.gp_count
                  && (asm_gp & (1::u32 << isa.regid_index(mv.assigned::i32)::u32)) != 0) {
                must_spill = true;
            }
            if (must_spill) {
                val sr: R.Result[R.Void, str] = spill_vreg(ctx, v);
                if (R.is_err[R.Void, str](sr)) { ret sr; }
            }
            v = v + 1;
        }
        pos = pos + 1;
    }
    ret R.ok_void[str]();
}

fun rewritten_preg_ok(tgt: *target.Target, preg: u32) bool {
    val rid: i32 = preg::i32;
    val rclass: i32 = isa.regid_class(rid);
    val ridx: i32 = isa.regid_index(rid);
    if (ridx < 0) { ret false; }
    if (rclass == isa.REG_CLASS_ID_GP) {
        if (ridx::u32 < bank_count(tgt, REG_CLASS_GP)) { ret true; }
        ret special_gp_register(tgt, rid);
    }
    if (rclass == isa.REG_CLASS_ID_XMM) { ret ridx::u32 < bank_count(tgt, fp_class_index(tgt)); }
    ret false;
}

fun special_gp_register(tgt: *target.Target, rid: i32) bool {
    if (rid == tgt.model.stack_ptr_reg || rid == tgt.model.frame_ptr_reg) { ret true; }
    if (rid == tgt.arch.scratch_reg || rid == tgt.arch.scratch_reg2) { ret true; }
    var i: i32 = 0;
    for (i < tgt.arch.reserved_reg_count && i < MAX_REG_FILE) {
        if (tgt.arch.reserved_regs[i].id == rid) { ret true; }
        i = i + 1;
    }
    var j: i32 = 0;
    for (j < tgt.arch.reload_scratch_count && j < MAX_REG_FILE) {
        if (tgt.arch.reload_scratch_regs[j].id == rid) { ret true; }
        j = j + 1;
    }
    ret false;
}

fun verify_rewritten_operands(tgt: *target.Target, f: *mir.MirFunction) R.Result[R.Void, str] {
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            var k: u32 = 0;
            for (k < mi.operand_count) {
                val op: *mir.MirOperand = ?mi.operands[k];
                if (op.kind == mir.MIR_OP_VREG) {
                    ret R.err[R.Void, str]("regalloc: a virtual register survived rewriting");
                }
                if (op.kind == mir.MIR_OP_PREG && !rewritten_preg_ok(tgt, op.preg)) {
                    ret R.err[R.Void, str]("regalloc: a rewritten operand names a physical register outside every register class");
                }
                if (op.kind == mir.MIR_OP_MEM) {
                    if (op.vreg == mir.MIR_VREG_NIL && !rewritten_preg_ok(tgt, op.preg)) {
                        ret R.err[R.Void, str]("regalloc: a rewritten memory base names a physical register outside every register class");
                    }
                    if (op.index != mir.MIR_VREG_NIL && op.index_is_preg && !rewritten_preg_ok(tgt, op.index)) {
                        ret R.err[R.Void, str]("regalloc: a rewritten memory index names a physical register outside every register class");
                    }
                }
                k = k + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret R.ok_void[str]();
}

fun verify_allocation(tgt: *target.Target, ctx: *AllocCtx) R.Result[R.Void, str] {
    var v: u32 = 0;
    for (v < ctx.f.vreg_count) {
        val mv: *mir.MirVReg = ?ctx.f.vregs[v];
        if (mv.assigned == mir.MIR_VREG_NIL) { v = v + 1; cnt; }
        val lr: *LiveRange = ?ctx.ranges[v];

        val rid: i32 = mv.assigned::i32;
        val rclass: i32 = isa.regid_class(rid);
        val ridx: i32 = isa.regid_index(rid);

        if (lr.reg_class == REG_CLASS_GP) {
            if (rclass != isa.REG_CLASS_ID_GP || ridx < 0 || ridx::u32 >= ctx.gp_count) {
                ret R.err[R.Void, str](regalloc_msg(ctx, "regalloc: invalid GP register id assigned in '", "'", "regalloc: invalid GP register id assigned"));
            }
            if (ctx.reserved[ridx::u32]) {
                ret R.err[R.Void, str](regalloc_msg(ctx, "regalloc: a reserved register was assigned in '", "'", "regalloc: a reserved register was assigned"));
            }
        } or {
            if (rclass != isa.REG_CLASS_ID_XMM || ridx < 0 || ridx::u32 >= ctx.fp_count) {
                ret R.err[R.Void, str](regalloc_msg(ctx, "regalloc: invalid FP register id assigned in '", "'", "regalloc: invalid FP register id assigned"));
            }
        }
        v = v + 1;
    }
    ret R.ok_void[str]();
}

fun record_callee_mask(tgt: *target.Target, ctx: *AllocCtx) {
    var mask: u32 = 0;
    var fp_mask: u32 = 0;
    var v: u32 = 0;
    for (v < ctx.f.vreg_count) {
        val mv: *mir.MirVReg = ?ctx.f.vregs[v];
        if (mv.assigned == mir.MIR_VREG_NIL) { v = v + 1; cnt; }
        val lr: *LiveRange = ?ctx.ranges[v];
        if (lr.reg_class == REG_CLASS_GP) {
            val gidx: u32 = isa.regid_index(mv.assigned::i32)::u32;
            if (gidx < ctx.gp_count && ctx.callee_saved[gidx] && !ctx.reserved[gidx]) {
                mask = mask | (1::u32 << gidx);
            }
        } or {
            val xidx: u32 = isa.regid_index(mv.assigned::i32)::u32;
            if (ctx.fp_callee_saved != nil && xidx < ctx.fp_count && ctx.fp_callee_saved[xidx]) {
                fp_mask = fp_mask | (1::u32 << xidx);
            }
        }
        v = v + 1;
    }

    mask = mask | asm_callee_mask(tgt, ctx.f);
    fp_mask = fp_mask | asm_callee_mask_fp(tgt, ctx.f);

    val fp_scratch: u32 = fp_scratch_callee_mask(tgt);
    if (fp_scratch != 0 && function_uses_fp_scratch(ctx.f)) {
        fp_mask = fp_mask | fp_scratch;
    }

    ctx.f.callee_mask    = mask;
    ctx.f.callee_mask_fp = fp_mask;
}

fun drop_self_copies_physical(tgt: *target.Target, ctx: *AllocCtx) {
    val f: *mir.MirFunction = ctx.f;
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        var write: u32 = 0;
        var read:  u32 = 0;
        for (read < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[read];
            var drop: bool = false;
            if (instr_is_reg_copy(tgt, mi)) {
                val a: *mir.MirOperand = ?mi.operands[0];
                val b: *mir.MirOperand = ?mi.operands[1];
                drop = a.kind == mir.MIR_OP_PREG && b.kind == mir.MIR_OP_PREG && a.preg == b.preg;
            }
            if (drop) {
                if (mi.operands != nil && mi.operand_count > 0) {
                    A.deallocate[mir.MirOperand](ctx.alloc, mi.operands, mi.operand_count::usize);
                }
                if (mi.dbg_bindings != nil && mi.dbg_binding_count > 0) {
                    A.deallocate[mir.MirDbgBinding](ctx.alloc, mi.dbg_bindings, mi.dbg_binding_count::usize);
                }
            } or {
                if (write != read) { blk.instrs[write] = blk.instrs[read]; }
                write = write + 1;
            }
            read = read + 1;
        }
        blk.instr_count = write;
        bi = bi + 1;
    }
}

fun rewrite(tgt: *target.Target, ctx: *AllocCtx) R.Result[R.Void, str] {
    val f: *mir.MirFunction = ctx.f;
    var bi: u32 = 0;
    var flat_base: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        val orig_count: u32 = blk.instr_count;
        val rb: R.Result[R.Void, str] = rewrite_block(tgt, ctx, blk, bi == 0, flat_base);
        if (R.is_err[R.Void, str](rb)) { ret rb; }
        flat_base = flat_base + orig_count;
        bi = bi + 1;
    }
    ret R.ok_void[str]();
}

fun rewrite_block(tgt: *target.Target, ctx: *AllocCtx, blk: *mir.MirBlock, is_entry: bool, flat_base: u32) R.Result[R.Void, str] {
    if (blk.instr_count == 0) { ret R.ok_void[str](); }

    var total: u32 = 0;
    var ii: u32 = 0;
    for (ii < blk.instr_count) {
        total = total + 1 + extra_movs(ctx, ?blk.instrs[ii]);
        ii = ii + 1;
    }

    val rn: R.Result[*mir.MirInstr, str] = A.zallocate[mir.MirInstr](ctx.alloc, total::usize);
    if (R.is_err[*mir.MirInstr, str](rn)) { ret R.err[R.Void, str](R.unwrap_err[*mir.MirInstr, str](rn)); }
    val dst: *mir.MirInstr = R.unwrap_ok[*mir.MirInstr, str](rn);
    var w: u32 = 0;

    ii = 0;
    for (ii < blk.instr_count) {
        val mi: *mir.MirInstr = ?blk.instrs[ii];
        val re: R.Result[R.Void, str] = rewrite_instr(tgt, ctx, mi, dst, ?w, is_entry, flat_base + ii);
        if (R.is_err[R.Void, str](re)) {
            var d: u32 = 0;
            for (d < w) {
                if (dst[d].operands != nil && dst[d].operand_count > 0) {
                    A.deallocate[mir.MirOperand](ctx.alloc, dst[d].operands, dst[d].operand_count::usize);
                }
                d = d + 1;
            }
            A.deallocate[mir.MirInstr](ctx.alloc, dst, total::usize);
            ret re;
        }
        ii = ii + 1;
    }

    if (blk.instrs != nil && blk.instr_cap > 0) {
        A.deallocate[mir.MirInstr](ctx.alloc, blk.instrs, blk.instr_cap::usize);
    }
    blk.instrs      = dst;
    blk.instr_count = w;
    blk.instr_cap   = total;
    ret R.ok_void[str]();
}

fun extra_movs(ctx: *AllocCtx, mi: *mir.MirInstr) u32 {
    var n: u32 = 0;
    val has_def: bool = instr_defines(mi);
    var k: u32 = 0;
    for (k < mi.operand_count) {
        val op: *mir.MirOperand = ?mi.operands[k];
        if (op.kind == mir.MIR_OP_VREG) {
            if (is_spilled(ctx, op.vreg)) { n = n + 1; }
        } or (op.kind == mir.MIR_OP_MEM && op.vreg != mir.MIR_VREG_NIL) {
            if (is_spilled(ctx, op.vreg)) { n = n + 1; }
        }
        if (op.kind == mir.MIR_OP_MEM && !op.index_is_preg && op.index != mir.MIR_VREG_NIL) {
            if (is_spilled(ctx, op.index)) { n = n + 1; }
        }
        k = k + 1;
    }
    ret n;
}

fun is_spilled(ctx: *AllocCtx, v: u32) bool {
    if (v >= ctx.f.vreg_count) { ret false; }
    ret ctx.f.vregs[v].spill_slot >= 0;
}

fun is_fp_vreg(ctx: *AllocCtx, v: u32) bool {
    if (v >= ctx.f.vreg_count) { ret false; }
    ret ctx.f.vregs[v].class != REG_CLASS_GP;
}

fun is_storage_slot(ctx: *AllocCtx, v: u32) bool {
    if (is_spilled(ctx, v)) { ret false; }
    ret vreg_has_slot(ctx, v);
}

fun rewrite_instr(tgt: *target.Target, ctx: *AllocCtx, mi: *mir.MirInstr,
                  dst: *mir.MirInstr, wp: *u32, is_entry: bool, src_pos: u32) R.Result[R.Void, str] {
    val n: u32 = mi.operand_count;
    var ops: *mir.MirOperand = nil;
    if (n > 0) {
        val ro: R.Result[*mir.MirOperand, str] = A.allocate[mir.MirOperand](ctx.alloc, n::usize);
        if (R.is_err[*mir.MirOperand, str](ro)) { ret R.err[R.Void, str](R.unwrap_err[*mir.MirOperand, str](ro)); }
        ops = R.unwrap_ok[*mir.MirOperand, str](ro);
        var c: u32 = 0;
        for (c < n) { ops[c] = mi.operands[c]; c = c + 1; }
    }

    val has_def: bool = instr_defines_ops(mi, ops, n);

    var claimed: [16]i32;
    var claimed_count: u32 = 0;
    var ci: u32 = 0;
    for (ci < 16) { claimed[ci] = -1; ci = ci + 1; }

    var store_dst_vreg: u32 = mir.MIR_VREG_NIL;
    var store_dst_tmp: i32 = -1;

    var k: u32 = 0;
    for (k < n) {
        val op: *mir.MirOperand = ?ops[k];
        if (op.kind == mir.MIR_OP_VREG) {
            val v: u32 = op.vreg;
            if (has_def && k == 0) {
                if (is_fp_vreg(ctx, v) && is_spilled(ctx, v)) {
                    ops[k] = mir.op_mem_slot(v, 0);
                } or (is_spilled(ctx, v)) {
                    val tmp: i32 = reload_temp(ctx, ?claimed[0], claimed_count, is_entry, src_pos);
                    if (tmp < 0) {
                        free_ops(ctx, ops, n);
                        ret R.err[R.Void, str](regalloc_msg(ctx, "regalloc: no free register for spilled destination in '", "'", "regalloc: no free register for spilled destination"));
                    }
                    claimed[claimed_count] = tmp; claimed_count = claimed_count + 1;
                    ops[k] = mir.op_preg(tmp::u32);
                    store_dst_vreg = v;
                    store_dst_tmp  = tmp;
                } or {
                    ops[k] = preg_of(ctx, v);
                }
            } or {
                if (is_fp_vreg(ctx, v) && is_spilled(ctx, v)) {
                    ops[k] = mir.op_mem_slot(v, 0);
                } or (store_dst_tmp >= 0 && v == store_dst_vreg) {
                    ops[k] = mir.op_preg(store_dst_tmp::u32);
                } or (is_spilled(ctx, v)) {
                    val tmp: i32 = reload_temp(ctx, ?claimed[0], claimed_count, is_entry, src_pos);
                    if (tmp < 0) {
                        free_ops(ctx, ops, n);
                        print.eprintlnf("bulk spill diagnostic opcode={} n={} k={} source_pos={} claimed={} scratch={}", mi.opcode, n, k, src_pos, claimed_count, ctx.reload_scratch_count);
                        var di: u32 = 0;
                        for (di < mi.operand_count) {
                            val dop: mir.MirOperand = mi.operands[di];
                            print.eprintlnf("operand={} kind={} vreg={} preg={} imm={} index={}", di, dop.kind, dop.vreg, dop.preg, dop.imm, dop.index);
                            if (dop.vreg < ctx.f.vreg_count) {
                                print.eprintlnf("assigned={} spill={}", ctx.f.vregs[dop.vreg].assigned, ctx.f.vregs[dop.vreg].spill_slot);
                            }
                            di = di + 1;
                        }
                        di = 0;
                        for (di < claimed_count) { print.eprintlnf("claimed[{}]={}", di, claimed[di]); di = di + 1; }
                        ret R.err[R.Void, str](regalloc_msg(ctx, "regalloc: no free register for spilled source in '", "'", "regalloc: no free register for spilled source"));
                    }
                    claimed[claimed_count] = tmp; claimed_count = claimed_count + 1;
                    val er: R.Result[R.Void, str] = emit_reload(ctx, dst, wp, tmp::u32, v, mi.loc, mi.inline_site);
                    if (R.is_err[R.Void, str](er)) { free_ops(ctx, ops, n); ret er; }
                    ops[k] = mir.op_preg(tmp::u32);
                } or {
                    ops[k] = preg_of(ctx, v);
                }
            }
        } or (op.kind == mir.MIR_OP_MEM) {
            if (op.vreg != mir.MIR_VREG_NIL) {
                val v: u32 = op.vreg;
                if (is_storage_slot(ctx, v)) {
                } or (is_spilled(ctx, v)) {
                    val tmp: i32 = reload_temp(ctx, ?claimed[0], claimed_count, is_entry, src_pos);
                    if (tmp < 0) {
                        free_ops(ctx, ops, n);
                        ret R.err[R.Void, str](regalloc_msg(ctx, "regalloc: no free register for spilled MEM base in '", "'", "regalloc: no free register for spilled MEM base"));
                    }
                    claimed[claimed_count] = tmp; claimed_count = claimed_count + 1;
                    val er: R.Result[R.Void, str] = emit_reload(ctx, dst, wp, tmp::u32, v, mi.loc, mi.inline_site);
                    if (R.is_err[R.Void, str](er)) { free_ops(ctx, ops, n); ret er; }
                    ops[k].vreg = mir.MIR_VREG_NIL;
                    ops[k].preg = tmp::u32;
                } or {
                    ops[k].vreg = mir.MIR_VREG_NIL;
                    ops[k].preg = assigned_preg(ctx, v);
                }
            }
            if (!ops[k].index_is_preg && ops[k].index != mir.MIR_VREG_NIL) {
                val iv: u32 = ops[k].index;
                if (is_spilled(ctx, iv)) {
                    val tmp: i32 = reload_temp(ctx, ?claimed[0], claimed_count, is_entry, src_pos);
                    if (tmp < 0) {
                        free_ops(ctx, ops, n);
                        ret R.err[R.Void, str](regalloc_msg(ctx, "regalloc: no free register for spilled MEM index in '", "'", "regalloc: no free register for spilled MEM index"));
                    }
                    claimed[claimed_count] = tmp; claimed_count = claimed_count + 1;
                    val er: R.Result[R.Void, str] = emit_reload(ctx, dst, wp, tmp::u32, iv, mi.loc, mi.inline_site);
                    if (R.is_err[R.Void, str](er)) { free_ops(ctx, ops, n); ret er; }
                    ops[k].index         = tmp::u32;
                    ops[k].index_is_preg = true;
                } or {
                    ops[k].index         = assigned_preg(ctx, iv);
                    ops[k].index_is_preg = true;
                }
            }
        }
        k = k + 1;
    }

    if (store_dst_vreg == mir.MIR_VREG_NIL
        && mi.width >= ctx.spill_width
        && instr_is_reg_copy(tgt, mi)
        && ops[0].kind == mir.MIR_OP_PREG && ops[1].kind == mir.MIR_OP_PREG
        && ops[0].preg == ops[1].preg) {
        free_ops(ctx, ops, n);
        if (mi.dbg_binding_count > 0) {
            dst[@wp].opcode            = isa.ISA_USE::mir.MirOpcode;
            dst[@wp].width             = mi.width;
            dst[@wp].src_width         = mi.src_width;
            dst[@wp].loc               = mi.loc;
            dst[@wp].inline_site       = mi.inline_site;
            dst[@wp].dbg_bindings      = mi.dbg_bindings;
            dst[@wp].dbg_binding_count = mi.dbg_binding_count;
            @wp = @wp + 1;
        }
        if (mi.operands != nil && mi.operand_count > 0) {
            A.deallocate[mir.MirOperand](ctx.alloc, mi.operands, mi.operand_count::usize);
        }
        ret R.ok_void[str]();
    }

    dst[@wp] = mir.instr_like(mi, ops, n);
    @wp = @wp + 1;

    if (mi.operands != nil && mi.operand_count > 0) {
        A.deallocate[mir.MirOperand](ctx.alloc, mi.operands, mi.operand_count::usize);
    }

    if (store_dst_vreg != mir.MIR_VREG_NIL) {
        val sr: R.Result[R.Void, str] = emit_store(ctx, dst, wp, store_dst_vreg, store_dst_tmp::u32, mi.loc, mi.inline_site);
        if (R.is_err[R.Void, str](sr)) { ret sr; }
    }
    ret R.ok_void[str]();
}

fun instr_defines_ops(mi: *mir.MirInstr, ops: *mir.MirOperand, n: u32) bool {
    if (n == 0)                       { ret false; }
    if (!mir.instr_defines_shape(mi)) { ret false; }
    ret ops[0].kind == mir.MIR_OP_VREG;
}

fun preg_of(ctx: *AllocCtx, v: u32) mir.MirOperand {
    ret mir.op_preg(assigned_preg(ctx, v));
}

fun assigned_preg(ctx: *AllocCtx, v: u32) u32 {
    if (v >= ctx.f.vreg_count) {
        panic("regalloc: operand vreg id out of range during rewrite\n");
    }
    val a: u32 = ctx.f.vregs[v].assigned;
    if (a == mir.MIR_VREG_NIL) {
        panic("regalloc: unassigned vreg reached instruction rewrite\n");
    }
    ret a;
}

fun reload_temp(ctx: *AllocCtx, claimed: *i32, claimed_count: u32,
                is_entry: bool, src_pos: u32) i32 {
    var i: i32 = 0;
    for (i < ctx.reload_scratch_count) {
        val id: i32 = ctx.reload_scratch[i].id;
        if (id_claimed(claimed, claimed_count, id)) { i = i + 1; cnt; }
        if (is_entry && id::u32 < ctx.gp_count
            && ctx.param_reg_end[id] >= 0 && src_pos::i64 <= ctx.param_reg_end[id]) {
            i = i + 1; cnt;
        }
        if (id::u32 < ctx.gp_count && arg_reg_busy_at(ctx, id::u32, src_pos)) {
            i = i + 1; cnt;
        }
        ret id;
    }
    ret -1;
}

fun id_claimed(claimed: *i32, count: u32, id: i32) bool {
    var i: u32 = 0;
    for (i < count) {
        if (claimed[i] == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun emit_reload(ctx: *AllocCtx, dst: *mir.MirInstr, wp: *u32, tmp: u32, v: u32, loc: source.SrcLoc, inline_site: u32) R.Result[R.Void, str] {
    val ro: R.Result[*mir.MirOperand, str] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (R.is_err[*mir.MirOperand, str](ro)) { ret R.err[R.Void, str](R.unwrap_err[*mir.MirOperand, str](ro)); }
    val ops: *mir.MirOperand = R.unwrap_ok[*mir.MirOperand, str](ro);
    ops[0] = mir.op_preg(tmp);
    ops[1] = mir.op_mem_slot(v, 0);
    dst[@wp].opcode        = mir.MIR_MOV;
    dst[@wp].operands      = ops;
    dst[@wp].operand_count = 2;
    dst[@wp].width         = ctx.spill_width;
    dst[@wp].src_width     = ctx.spill_width;
    dst[@wp].loc           = loc;
    dst[@wp].inline_site   = inline_site;
    @wp = @wp + 1;
    ret R.ok_void[str]();
}

fun emit_store(ctx: *AllocCtx, dst: *mir.MirInstr, wp: *u32, v: u32, tmp: u32, loc: source.SrcLoc, inline_site: u32) R.Result[R.Void, str] {
    val ro: R.Result[*mir.MirOperand, str] = A.allocate[mir.MirOperand](ctx.alloc, 2::usize);
    if (R.is_err[*mir.MirOperand, str](ro)) { ret R.err[R.Void, str](R.unwrap_err[*mir.MirOperand, str](ro)); }
    val ops: *mir.MirOperand = R.unwrap_ok[*mir.MirOperand, str](ro);
    ops[0] = mir.op_mem_slot(v, 0);
    ops[1] = mir.op_preg(tmp);
    dst[@wp].opcode        = mir.MIR_MOV;
    dst[@wp].operands      = ops;
    dst[@wp].operand_count = 2;
    dst[@wp].width         = ctx.spill_width;
    dst[@wp].src_width     = ctx.spill_width;
    dst[@wp].loc           = loc;
    dst[@wp].inline_site   = inline_site;
    @wp = @wp + 1;
    ret R.ok_void[str]();
}

fun free_ops(ctx: *AllocCtx, ops: *mir.MirOperand, n: u32) {
    if (ops != nil && n > 0) {
        A.deallocate[mir.MirOperand](ctx.alloc, ops, n::usize);
    }
}

test "mach.lang.be.codegen.regalloc.seed_reserved:aarch64_reserved_and_fp_bank" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val rr: R.Result[R.Void, str] = target.register_all(?reg, target_testing.debug_descriptor);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    val ts: R.Result[target.Target, str] = target.select(?reg, "aarch64", "linux", "aapcs64");
    if (R.is_err[target.Target, str](ts)) { ret 1; }
    var t: target.Target = R.unwrap_ok[target.Target, str](ts);

    var ctx: AllocCtx;
    ctx.gp_count = bank_count(?t, REG_CLASS_GP);
    var reserved: [64]bool;
    var i: u32 = 0;
    for (i < 64) { reserved[i] = false; i = i + 1; }
    ctx.reserved = ?reserved[0];

    seed_reserved(?t, ?ctx);

    if (!reserved[30]) { ret 1; }
    if (!reserved[16]) { ret 1; }
    if (!reserved[17]) { ret 1; }

    if (bank_count(?t, fp_class_index(?t)) != 30) { ret 1; }

    ret 0;
}

test "mach.lang.be.codegen.regalloc.seed_reserved:x18_reserved_on_darwin_only" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val rr: R.Result[R.Void, str] = target.register_all(?reg, target_testing.debug_descriptor);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    val ls: R.Result[target.Target, str] = target.select(?reg, "aarch64", "linux", "aapcs64");
    if (R.is_err[target.Target, str](ls)) { ret 2; }
    var tl: target.Target = R.unwrap_ok[target.Target, str](ls);
    var ctxl: AllocCtx;
    ctxl.gp_count = bank_count(?tl, REG_CLASS_GP);
    var reservedl: [64]bool;
    var il: u32 = 0;
    for (il < 64) { reservedl[il] = false; il = il + 1; }
    ctxl.reserved = ?reservedl[0];
    seed_reserved(?tl, ?ctxl);
    if (reservedl[18]) { ret 3; }

    val ds: R.Result[target.Target, str] = target.select(?reg, "aarch64", "darwin", "aapcs64");
    if (R.is_err[target.Target, str](ds)) { ret 4; }
    var td: target.Target = R.unwrap_ok[target.Target, str](ds);
    var ctxd: AllocCtx;
    ctxd.gp_count = bank_count(?td, REG_CLASS_GP);
    var reservedd: [64]bool;
    var id: u32 = 0;
    for (id < 64) { reservedd[id] = false; id = id + 1; }
    ctxd.reserved = ?reservedd[0];
    seed_reserved(?td, ?ctxd);
    if (!reservedd[18]) { ret 5; }

    ret 0;
}

test "mach.lang.be.codegen.regalloc.verify_allocation:accepts_a_well_formed_assignment" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    val tr: R.Result[target.Target, str] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (R.is_err[target.Target, str](tr)) { ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](tr);

    var vregs: [2]mir.MirVReg;
    vregs[0] = mir.vreg(0, REG_CLASS_GP, false, false);
    vregs[0].assigned = isa.regid_make(isa.REG_CLASS_ID_GP, 0)::u32;
    vregs[1] = mir.vreg(1, 1, false, false);
    vregs[1].assigned = isa.regid_make(isa.REG_CLASS_ID_XMM, 0)::u32;

    var f: mir.MirFunction;
    f.vregs = ?vregs[0];
    f.vreg_count = 2;

    var ranges: [2]LiveRange;
    ranges[0].reg_class = REG_CLASS_GP;
    ranges[1].reg_class = 1;

    var reserved: [4]bool;
    var ri: u32 = 0;
    for (ri < 4) { reserved[ri] = false; ri = ri + 1; }

    var ctx: AllocCtx;
    ctx.alloc     = ?alloc;
    ctx.interner  = nil;
    ctx.f         = ?f;
    ctx.ranges    = ?ranges[0];
    ctx.gp_count  = 4;
    ctx.fp_count  = 4;
    ctx.reserved  = ?reserved[0];

    val vr: R.Result[R.Void, str] = verify_allocation(?tgt, ?ctx);
    if (R.is_err[R.Void, str](vr)) { ret 1; }
    ret 0;
}

