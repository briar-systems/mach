# register allocation for a MIR module: every function is coalesced, put in
# scan order, scanned in rounds until no spilled value earns a piece or a
# rematerialization, then rewritten onto physical registers and verified.
# each phase is a module of its own beside this one, and they share one
# regalloc.context.Context per function
use mach.lang.fail;
use mach.lang.intern;
use lang_mir:    mach.lang.mir;
use lang_target: mach.lang.target;
use mach.lang.target.isa;
use isa_inst:     mach.lang.target.isa.inst;
use isa_rules:    mach.lang.target.isa.rules;
use target_model: mach.lang.target.model;
use A:            std.allocator;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_contains;

use mach.lang.be.codegen.regalloc.coalesce;
use regalloc_context: mach.lang.be.codegen.regalloc.context;
use mach.lang.be.codegen.regalloc.liveness;
use regalloc_order: mach.lang.be.codegen.regalloc.order;
use mach.lang.be.codegen.regalloc.rewrite;
use regalloc_scan: mach.lang.be.codegen.regalloc.scan;
use mach.lang.be.codegen.regalloc.spill;
use regalloc_verify: mach.lang.be.codegen.regalloc.verify;

pub fun run(tgt: *lang_target.Binding, m: *lang_mir.MirModule) err[fail.Fail] {
    if (tgt == nil)      { ret err[fail.Fail].err{fail.message("regalloc: nil target")}; }
    if (m == nil)        { ret err[fail.Fail].err{fail.message("regalloc: nil mir module")}; }
    if (tgt.abi == nil)  { ret err[fail.Fail].err{fail.message("regalloc: target has no ABI vtable")}; }
    if (tgt.arch == nil) { ret err[fail.Fail].err{fail.message("regalloc: target has no ISA vtable")}; }
    if (tgt.abi.callee_saved.regs == nil) {
        ret err[fail.Fail].err{fail.message("regalloc: ABI vtable exposes no callee-saved register file")};
    }

    val input: err[fail.Fail] = lang_mir.validate_operands(m);
    if (sel input.err) { ret input; }
    val model: err[fail.Fail] = validate_register_model(tgt, m);
    if (sel model.err) { ret model; }
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val classes: err[fail.Fail] = validate_vreg_classes(tgt, m, ?m.functions[fi]);
        if (sel classes.err) { ret classes; }
        val af: err[fail.Fail] = alloc_function(tgt, m, ?m.functions[fi]);
        if (sel af.err) { ret af; }
        fi = fi + 1;
    }
    ret lang_mir.validate_operands(m);
}

fun validate_register_model(tgt: *lang_target.Binding, m: *lang_mir.MirModule) err[fail.Fail] {
    if (tgt.target.model.reg_class_len == 0 || tgt.target.model.reg_classes == nil) {
        ret err[fail.Fail].err{fail.message("regalloc: target has no register class model")};
    }
    var ci: u32 = 0;
    for (ci < tgt.target.model.reg_class_len) {
        val kind: target_model.RegClassKind = tgt.target.model.reg_classes[ci].kind;
        if (kind > target_model.RC_FLAGS) { ret lang_mir.catalog_failure(m, "RegClassKind", kind::u32); }
        if ((ci == regalloc_context.REG_CLASS_GP) != (kind == target_model.RC_GENERAL)) {
            ret err[fail.Fail].err{fail.message("regalloc: target general register class does not match the MIR general bank")};
        }
        ci = ci + 1;
    }
    ret err[fail.Fail].ok{};
}

fun validate_vreg_classes(tgt: *lang_target.Binding, m: *lang_mir.MirModule, f: *lang_mir.MirFunction) err[fail.Fail] {
    var vi: u32 = 0;
    for (vi < f.vreg_count) {
        val class: u32 = f.vregs[vi].class;
        if (class >= tgt.target.model.reg_class_len) { ret lang_mir.catalog_failure(m, "MirRegisterClass", class); }
        val kind: target_model.RegClassKind = tgt.target.model.reg_classes[class].kind;
        if (kind == target_model.RC_VECTOR || kind == target_model.RC_FLAGS) {
            ret err[fail.Fail].err{fail.message("regalloc: declared target register class is unsupported for MIR virtual registers")};
        }
        vi = vi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun alloc_function(tgt: *lang_target.Binding, m: *lang_mir.MirModule, f: *lang_mir.MirFunction) err[fail.Fail] {
    if (f.block_count == 0) { ret err[fail.Fail].ok{}; }
    if (f.vreg_count == 0) {
        f.callee_mask = rewrite.asm_callee_mask(tgt, f);
        val fp_scratch: u32 = rewrite.fp_scratch_callee_mask(tgt);
        if (fp_scratch != 0 && rewrite.function_uses_fp_scratch(f)) {
            f.callee_mask_fp = fp_scratch;
        }
        ret regalloc_verify.rewritten_operands(tgt, f);
    }

    var ctx: regalloc_context.Context;
    val ic:  err[fail.Fail] = regalloc_context.init(?ctx, tgt, m, f);
    if (sel ic.err) { ret ic; }
    fin { regalloc_context.dnit(?ctx); }

    if (regalloc_context.function_has_reg_shift(?ctx)) {
        regalloc_context.reserve_reg(?ctx, isa.fixed_reg(tgt.arch, isa.FIXED_SHIFT_COUNT));
    }

    val vs: err[fail.Fail] = regalloc_context.build_vreg_slot_flags(?ctx);
    if (sel vs.err) { ret vs; }
    ctx.round_count = f.vreg_count;

    val ds: err[fail.Fail] = coalesce.sweep_dead_movs(tgt, ?ctx);
    if (sel ds.err) { ret ds; }

    val cc: err[fail.Fail] = coalesce.copies(tgt, ?ctx);
    if (sel cc.err) { ret cc; }

    val bo: err[fail.Fail] = regalloc_order.build(?ctx);
    if (sel bo.err) { ret bo; }

    val ao: err[fail.Fail] = regalloc_order.apply(?ctx);
    if (sel ao.err) { ret ao; }

    val cd: err[fail.Fail] = coalesce.dying_copies(tgt, ?ctx);
    if (sel cd.err) { ret cd; }

    # a round scans the function as it stands; when it leaves a spilled
    # value whose reads a piece could carry, the pieces are inserted and the
    # next round scans them as intervals of their own
    var again: bool = true;
    for (again) {
        val rd: err[fail.Fail] = alloc_round(tgt, ?ctx);
        if (sel rd.err) { ret rd; }
        val rm: res[bool, fail.Fail] = spill.plan_remat(tgt, ?ctx);
        if (sel rm.err) { ret err[fail.Fail].err{rm.err}; }
        val pp: res[bool, fail.Fail] = spill.plan_pieces(tgt, ?ctx);
        if (sel pp.err) { ret err[fail.Fail].err{pp.err}; }
        again = rm.ok || pp.ok;
        if (again) { regalloc_context.round_tables_dnit(?ctx); }
    }

    val gr: err[fail.Fail] = rewrite.guarantee_reload_registers(tgt, ?ctx);
    if (sel gr.err) { ret gr; }

    val ss: err[fail.Fail] = spill.slots_allocate(?ctx);
    if (sel ss.err) { ret ss; }

    val rw: err[fail.Fail] = rewrite.run(tgt, ?ctx);
    if (sel rw.err) { ret rw; }

    val vf: err[fail.Fail] = regalloc_verify.allocation(tgt, ?ctx);
    if (sel vf.err) { ret vf; }

    val vo: err[fail.Fail] = regalloc_verify.rewritten_operands(tgt, ctx.f);
    if (sel vo.err) { ret vo; }

    val dp: err[fail.Fail] = coalesce.drop_self_copies(tgt, ?ctx, lang_mir.MIR_OP_PREG);
    if (sel dp.err) { ret dp; }
    rewrite.record_callee_mask(tgt, ?ctx);

    val ro: err[fail.Fail] = regalloc_order.restore(?ctx);
    if (sel ro.err) { ret ro; }

    ret err[fail.Fail].ok{};
}

# one scan of the function in its current shape, from the flat index to the
# spills the calls force; the per-round tables are the state it leaves
fun alloc_round(tgt: *lang_target.Binding, ctx: *regalloc_context.Context) err[fail.Fail] {
    val rt: err[fail.Fail] = regalloc_context.round_tables_init(ctx);
    if (sel rt.err) { ret rt; }

    val fl: err[fail.Fail] = liveness.flatten(ctx);
    if (sel fl.err) { ret fl; }

    val bs: err[fail.Fail] = liveness.build_block_spans(ctx);
    if (sel bs.err) { ret bs; }

    val bd: err[fail.Fail] = liveness.build_loop_depth(ctx);
    if (sel bd.err) { ret bd; }

    val br: err[fail.Fail] = liveness.build_ranges(ctx);
    if (sel br.err) { ret br; }

    val lv: err[fail.Fail] = liveness.extend(ctx);
    if (sel lv.err) { ret lv; }

    val mc: err[fail.Fail] = liveness.mark_call_crossing(ctx);
    if (sel mc.err) { ret mc; }

    val dr: err[fail.Fail] = spill.discount_remat(tgt, ctx);
    if (sel dr.err) { ret dr; }

    coalesce.build_hints(tgt, ctx);

    val sc: err[fail.Fail] = regalloc_scan.run(tgt, ctx);
    if (sel sc.err) { ret sc; }
    val sd: err[fail.Fail] = regalloc_context.defect_check(ctx);
    if (sel sd.err) { ret sd; }

    # checked while the flat index still names the scanned instructions
    val vi: err[fail.Fail] = regalloc_verify.interference(ctx);
    if (sel vi.err) { ret vi; }

    ret spill.across_calls(tgt, ctx);
}

test rewritten_operands__selected_banks {
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: lang_target.Binding = tr.ok;
    if (regalloc_verify.t_verify_bank_slots(?tgt, lang_mir.MIR_FADD, lang_mir.BANK_FP, lang_mir.BANK_FP, lang_mir.BANK_FP, 3, false) != 0)          { ret 2; }
    if (regalloc_verify.t_verify_bank_slots(?tgt, lang_mir.MIR_FCMP, lang_mir.BANK_GP, lang_mir.BANK_FP, lang_mir.BANK_FP, 3, false) != 0)          { ret 3; }
    if (regalloc_verify.t_verify_bank_slots(?tgt, lang_mir.MIR_FP_TO_SI, lang_mir.BANK_GP, lang_mir.BANK_FP, lang_mir.BANK_UNKNOWN, 2, false) != 0) { ret 4; }
    if (regalloc_verify.t_verify_bank_slots(?tgt, lang_mir.MIR_SI_TO_FP, lang_mir.BANK_FP, lang_mir.BANK_GP, lang_mir.BANK_UNKNOWN, 2, false) != 0) { ret 5; }
    if (regalloc_verify.t_verify_bank_slots(?tgt, lang_mir.MIR_MOV, lang_mir.BANK_GP, lang_mir.BANK_GP, lang_mir.BANK_UNKNOWN, 2, false) != 0)      { ret 6; }
    if (regalloc_verify.t_verify_bank_slots(?tgt, lang_mir.MIR_MOV, lang_mir.BANK_FP, lang_mir.BANK_GP, lang_mir.BANK_UNKNOWN, 2, false) != 0)      { ret 7; }
    if (regalloc_verify.t_verify_bank_slots(?tgt, lang_mir.MIR_MOV, lang_mir.BANK_GP, lang_mir.BANK_FP, lang_mir.BANK_UNKNOWN, 2, false) != 0)      { ret 8; }
    if (regalloc_verify.t_verify_bank_slots(?tgt, lang_mir.MIR_ADD, lang_mir.BANK_FP, lang_mir.BANK_FP, lang_mir.BANK_FP, 3, true) != 0)            { ret 9; }
    var ops: [2]lang_mir.MirOperand;
    ops[0] = lang_mir.op_preg(lang_mir.preg_id(1));
    ops[1] = lang_mir.op_mem_preg(lang_mir.preg_id(tgt.arch.stack_ptr_reg), 0);
    var mi:  lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_MOV, ?ops[0], 2, 8, 8);
    var blk: lang_mir.MirBlock;
    blk.instrs      = ?mi;
    blk.instr_count = 1;
    var f: lang_mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    val capture_operand_banks_r: err[fail.Fail] = isa_rules.capture_operand_banks(?f, ?mi);
    if (sel capture_operand_banks_r.err) { ret 10; }
    val verify_rewritten_operands_r: err[fail.Fail] = regalloc_verify.rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r.err) { ret 11; }
    ops[1].preg = lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 1));
    val verify_rewritten_operands_r2: err[fail.Fail] = regalloc_verify.rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r2.ok) { ret 12; }
    ops[1].preg  = lang_mir.preg_id(tgt.arch.stack_ptr_reg);
    ops[1].index = lang_mir.index_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 1)));
    val verify_rewritten_operands_r3: err[fail.Fail] = regalloc_verify.rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r3.ok) { ret 13; }
    val alloc_function_r: err[fail.Fail] = alloc_function(?tgt, nil, ?f);
    if (sel alloc_function_r.ok) { ret 15; }
    ops[1].index = lang_mir.index_preg(lang_mir.preg_id(2));
    val verify_rewritten_operands_r4: err[fail.Fail] = regalloc_verify.rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r4.err) { ret 14; }
    ret 0;
}

test run__refuses_unknown_catalog_inputs {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var interner: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?interner); }
    val selected: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    if (sel selected.err) { ret 3; }
    var tgt:      lang_target.Binding  = selected.ok;
    var reg:      lang_mir.MirVReg     = lang_mir.vreg(0, regalloc_context.REG_CLASS_GP, 0, false);
    var function: lang_mir.MirFunction = lang_mir.MirFunction{vregs: ?reg, vreg_count: 1};
    var module:   lang_mir.MirModule   = lang_mir.MirModule{alloc: ?alloc, interner: ?interner, functions: ?function, function_len: 1};
    val run_r:    err[fail.Fail]       = run(?tgt, ?module);
    if (sel run_r.err) { ret 4; }
    reg.class = regalloc_context.fp_class_index(?tgt);
    val run_r2: err[fail.Fail] = run(?tgt, ?module);
    if (sel run_r2.err) { ret 5; }
    reg.class = 200;
    val unknown: err[fail.Fail] = run(?tgt, ?module);
    if (sel unknown.ok)                                                                { ret 6; }
    if (!str_contains(fail.describe(unknown.err), "unknown MirRegisterClass tag 200")) { ret 6; }
    reg.class = 2;
    if (tgt.target.model.reg_classes[reg.class].kind != target_model.RC_FLAGS) { ret 7; }
    val unsupported: err[fail.Fail] = run(?tgt, ?module);
    if (sel unsupported.ok)                                                                     { ret 8; }
    if (!str_contains(fail.describe(unsupported.err), "unsupported for MIR virtual registers")) { ret 8; }
    var classes: [3]target_model.RegClass;
    var ci:      u32 = 0;
    for (ci < 3) {
        classes[ci] = tgt.target.model.reg_classes[ci];
        ci          = ci + 1;
    }
    tgt.target.model.reg_classes = ?classes[0];
    val float_class: target_model.RegClass = classes[1];
    classes[1] = classes[2];
    classes[2] = float_class;
    reg.class  = 2;
    if (regalloc_context.fp_class_index(?tgt) != reg.class) { ret 12; }
    val run_again: err[fail.Fail] = run(?tgt, ?module);
    if (sel run_again.err) { ret 12; }
    classes[1].kind     = 200;
    function.vreg_count = 0;
    val bad_kind: err[fail.Fail] = run(?tgt, ?module);
    if (sel bad_kind.ok)                                                            { ret 9; }
    if (!str_contains(fail.describe(bad_kind.err), "unknown RegClassKind tag 200")) { ret 9; }
    classes[1].kind = target_model.RC_FLAGS;
    var operand:     lang_mir.MirOperand = lang_mir.op_imm(7);
    var instruction: lang_mir.MirInstr   = lang_mir.instr(lang_mir.MIR_RET, ?operand, 1, 8, 8);
    var block:       lang_mir.MirBlock   = lang_mir.MirBlock{instrs: ?instruction, instr_count: 1};
    function.blocks      = ?block;
    function.block_count = 1;
    operand.kind         = 200;
    val bad_operand: err[fail.Fail] = run(?tgt, ?module);
    if (sel bad_operand.ok)                                                              { ret 10; }
    if (!str_contains(fail.describe(bad_operand.err), "unknown MirOperandKind tag 200")) { ret 10; }
    ret 0;
}

# 0 when the second call sees the pair in place; the failing code otherwise
#[testing]
fun t_pair_case(isa_name: str, os_name: str, abi_name: str) i32 {
    var t: regalloc_context.TPair;
    if (!regalloc_context.t_pair_init(?t, isa_name, os_name, abi_name)) { ret 1; }
    fin { regalloc_context.t_pair_dnit(?t); }
    val ran: err[fail.Fail] = run(?t.tgt, ?t.m);
    if (sel ran.err) { ret 2; }

    var regs: [64]u8;
    var mem:  [64]u8;
    var i:    u32 = 0;
    for (i < 64) {
        regs[i] = 0;
        mem[i]  = 0;
        i       = i + 1;
    }
    var seen_first: bool = false;
    var ii:         u32  = 0;
    for (ii < t.blocks[1].instr_count) {
        val mi: *lang_mir.MirInstr = ?t.blocks[1].instrs[ii];
        if (mi.opcode == lang_mir.MIR_CALL) {
            if (!seen_first) {
                seen_first     = true;
                regs[t.ret_lo] = 1;
                regs[t.ret_hi] = 2;
            }
            or {
                if (regs[t.arg[0]] != 3) { ret 10; }
                if (regs[t.arg[1]] != 1) { ret 11; }
                if (regs[t.arg[2]] != 2) { ret 12; }
                ret 0;
            }
        }
        or (mi.opcode == lang_mir.MIR_MOV) {
            if (mi.operand_count != 2) { ret 3; }
            val token: u8 = regalloc_context.t_pair_token_of(?regs[0], ?mem[0], ?mi.operands[1]);
            if (!regalloc_context.t_pair_store(?regs[0], ?mem[0], ?mi.operands[0], token)) { ret 4; }
        }
        or (mi.opcode != lang_mir.MIR_RET) {
            ret 5;
        }
        ii = ii + 1;
    }
    ret 6;
}

test run__a_call_result_pair_reaches_the_next_call_shifted_by_one_register {
    # one bit per failing convention, the case code in the high nibble
    var code: i32 = 0;
    val x:    i32 = t_pair_case("x86_64", "linux", "sysv64");
    if (x != 0) { code = code | 1 | (x << 4); }
    val a: i32 = t_pair_case("aarch64", "linux", "aapcs64");
    if (a != 0) { code = code | 2 | (a << 4); }
    val r: i32 = t_pair_case("riscv64", "linux", "lp64d");
    if (r != 0) { code = code | 4 | (r << 4); }
    ret code;
}

test run__a_value_live_across_the_fixed_pair_stays_out_of_both_registers {
    var t: regalloc_context.THigh;
    if (!regalloc_context.t_fixed_init(?t, false)) { ret 1; }
    fin { regalloc_context.t_high_dnit(?t); }
    val ran: err[fail.Fail] = run(?t.tgt, ?t.m);
    if (sel ran.err)                             { ret 2; }
    if (regalloc_context.t_fixed_in_pair(?t, 3)) { ret 3; }
    if (regalloc_context.t_fixed_in_pair(?t, 4)) { ret 4; }
    # outside the multiply the pair is free: the high half keeps rdx
    if (regalloc_context.t_high_reg(?t, 2) != isa.fixed_reg(t.tgt.arch, isa.FIXED_PAIR_HI)) { ret 5; }
    ret 0;
}

test run__a_value_read_by_the_fixed_pair_stays_out_of_the_early_clobbered_register {
    var t: regalloc_context.THigh;
    if (!regalloc_context.t_fixed_init(?t, true)) { ret 1; }
    fin { regalloc_context.t_high_dnit(?t); }
    val ran: err[fail.Fail] = run(?t.tgt, ?t.m);
    if (sel ran.err)                             { ret 2; }
    if (regalloc_context.t_fixed_in_pair(?t, 1)) { ret 3; }
    ret 0;
}
