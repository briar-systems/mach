# block layout after allocation: a block that only jumps is threaded away by
# retargeting whatever names it, then every block is ordered so the successor
# a loop keeps running through follows it and a block ending in a trap goes
# last. a conditional branch whose then arm ends up next is inverted by the
# encoder, so either arm can be the fallthrough
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use lang_mir: mach.lang.mir;
use mach.lang.mir.flow;
use lang_target: mach.lang.target;

val NONE: u32 = flow.NONE;

pub fun run(tgt: *lang_target.Binding, m: *lang_mir.MirModule) err[fail.Fail] {
    if (m == nil) { ret err[fail.Fail].err{fail.message("blocklayout: nil mir module")}; }
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val f: *lang_mir.MirFunction = ?m.functions[fi];
        if (f.block_count > 0) {
            val th: err[fail.Fail] = thread_jumps(m.alloc, f);
            if (sel th.err) { ret th; }
            val ob: err[fail.Fail] = order_blocks(m.alloc, f, tgt);
            if (sel ob.err) { ret ob; }
        }
        fi = fi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun table(alloc: *A.Allocator, n: u32, fill: u32) res[*u32, fail.Fail] {
    var cap: u32 = n;
    if (cap == 0) { cap = 1; }
    val r: res[*u32, A.Error] = A.allocate[u32](alloc, cap::usize);
    if (sel r.err) { ret res[*u32, fail.Fail].err{fail.refused(r.err)}; }
    val t: *u32 = r.ok;
    var i: u32  = 0;
    for (i < cap) {
        t[i] = fill;
        i    = i + 1;
    }
    ret res[*u32, fail.Fail].ok{t};
}

fun table_free(alloc: *A.Allocator, t: *u32, n: u32) {
    var cap: u32 = n;
    if (cap == 0) { cap = 1; }
    A.deallocate[u32](alloc, t, cap::usize);
}

# the block a block that does nothing but jump jumps to: one instruction whose
# only operand names a block, the shape an unconditional branch has on every
# target before and after selection. the entry block stays, and so does a
# jump to itself
fun lone_jump_target(f: *lang_mir.MirFunction, ix: *flow.BlockIndex, b: u32) u32 {
    if (b == 0) { ret NONE; }
    val blk: *lang_mir.MirBlock = ?f.blocks[b];
    if (blk.instr_count != 1) { ret NONE; }
    val mi: *lang_mir.MirInstr = ?blk.instrs[0];
    if (mi.asm_block != nil || mi.operand_count != 1) { ret NONE; }
    if (mi.operands[0].kind != lang_mir.MIR_OP_BLOCK) { ret NONE; }
    val t: u32 = flow.position_of(ix, mi.operands[0].imm);
    if (t == b) { ret NONE; }
    ret t;
}

# every name of a block that only jumps becomes the name of the block its
# chain of such jumps ends at, and the jumping blocks go. a jump's debug
# bindings describe the program point the jump passes control to, which is
# the start of the block it reaches, so they move there, the nearest jump's
# ahead of the target's own and each farther jump's ahead of those
fun thread_jumps(alloc: *A.Allocator, f: *lang_mir.MirFunction) err[fail.Fail] {
    val n: u32 = f.block_count;
    if (n <= 1) { ret err[fail.Fail].ok{}; }

    val ri: res[flow.BlockIndex, fail.Fail] = flow.index_init(alloc, f);
    if (sel ri.err) { ret err[fail.Fail].err{ri.err}; }
    var ix: flow.BlockIndex = ri.ok;
    fin { flow.index_dnit(alloc, ?ix); }

    val rf: res[*u32, fail.Fail] = table(alloc, n, NONE);
    if (sel rf.err) { ret err[fail.Fail].err{rf.err}; }
    val jump: *u32 = rf.ok;
    fin { table_free(alloc, jump, n); }
    var any: bool = false;
    var b:   u32  = 0;
    for (b < n) {
        jump[b] = lone_jump_target(f, ?ix, b);
        if (jump[b] != NONE) { any = true; }
        b = b + 1;
    }
    if (!any) { ret err[fail.Fail].ok{}; }

    val rl: res[*u32, fail.Fail] = table(alloc, n, NONE);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val land: *u32 = rl.ok;
    fin { table_free(alloc, land, n); }
    val rd: res[*u32, fail.Fail] = table(alloc, n, 0);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dist: *u32 = rd.ok;
    fin { table_free(alloc, dist, n); }

    # a chain that closes on itself is a loop of jumps and stays
    var far: u32 = 0;
    b = 0;
    for (b < n) {
        if (jump[b] != NONE) {
            var x:     u32 = b;
            var steps: u32 = 0;
            for (jump[x] != NONE && steps <= n) {
                x     = jump[x];
                steps = steps + 1;
            }
            if (jump[x] == NONE && f.blocks[x].instr_count > 0) {
                land[b] = x;
                dist[b] = steps;
                if (steps > far) { far = steps; }
            }
        }
        b = b + 1;
    }

    var d: u32 = 1;
    for (d <= far) {
        b = 0;
        for (b < n) {
            if (land[b] != NONE && dist[b] == d && f.blocks[b].instrs[0].dbg_binding_count > 0) {
                val moved: err[fail.Fail] = lang_mir.instr_pass_dbg(alloc, ?f.blocks[b].instrs[0], ?f.blocks[land[b]].instrs[0]);
                if (sel moved.err) { ret moved; }
            }
            b = b + 1;
        }
        d = d + 1;
    }

    b = 0;
    for (b < n) {
        if (land[b] == NONE) {
            val blk: *lang_mir.MirBlock = ?f.blocks[b];
            var ii:  u32                = 0;
            for (ii < blk.instr_count) {
                val mi: *lang_mir.MirInstr = ?blk.instrs[ii];
                var k:  u32                = 0;
                for (k < mi.operand_count) {
                    val op: *lang_mir.MirOperand = ?mi.operands[k];
                    if (op.kind == lang_mir.MIR_OP_BLOCK) {
                        val t: u32 = flow.position_of(?ix, op.imm);
                        if (t != NONE && land[t] != NONE) { op.imm = f.blocks[land[t]].id::i64; }
                    }
                    k = k + 1;
                }
                ii = ii + 1;
            }
        }
        b = b + 1;
    }

    var w: u32 = 0;
    b = 0;
    for (b < n) {
        if (land[b] != NONE) {
            lang_mir.dnit_block(alloc, ?f.blocks[b]);
        }
        or {
            if (w != b) { f.blocks[w] = f.blocks[b]; }
            w = w + 1;
        }
        b = b + 1;
    }
    f.block_count = w;
    ret err[fail.Fail].ok{};
}

fun terminator(f: *lang_mir.MirFunction, b: u32) *lang_mir.MirInstr {
    val blk: *lang_mir.MirBlock = ?f.blocks[b];
    if (blk.instr_count == 0) { ret nil; }
    ret ?blk.instrs[blk.instr_count - 1];
}

fun is_trap_terminated(f: *lang_mir.MirFunction, b: u32, tgt: *lang_target.Binding) bool {
    val t: *lang_mir.MirInstr = terminator(f, b);
    if (t == nil) { ret false; }
    ret tgt.arch.is_trap_terminator(t.opcode::u32);
}

# a min-heap of reverse postorder numbers: the ready blocks, earliest first
rec Ready {
    at:  *u32;
    len: u32;
}

fun ready_push(r: *Ready, v: u32) {
    var i: u32 = r.len;
    r.len = r.len + 1;
    for (i > 0) {
        val parent: u32 = (i - 1) / 2;
        if (r.at[parent] <= v) { brk; }
        r.at[i] = r.at[parent];
        i       = parent;
    }
    r.at[i] = v;
}

fun ready_pop(r: *Ready) u32 {
    val top: u32 = r.at[0];
    r.len = r.len - 1;
    val last: u32 = r.at[r.len];
    var i:    u32 = 0;
    for (true) {
        var c: u32 = 2 * i + 1;
        if (c >= r.len)                             { brk; }
        if (c + 1 < r.len && r.at[c + 1] < r.at[c]) { c = c + 1; }
        if (last <= r.at[c])                        { brk; }
        r.at[i] = r.at[c];
        i       = c;
    }
    if (r.len > 0) { r.at[i] = last; }
    ret top;
}

# the placement state: which blocks are placed, how many forward edges into
# each are still unplaced, the blocks that are ready, and the order so far
rec Placement {
    placed: *u32;
    fwd_in: *u32;
    ready:  Ready;
    order:  *u32;
    count:  u32;
    cold:   *u32;
    cold_n: u32;
}

fun place(g: *flow.Graph, p: *Placement, b: u32) {
    p.placed[b]      = 1;
    p.order[p.count] = b;
    p.count          = p.count + 1;
    release(g, p, b);
}

fun release(g: *flow.Graph, p: *Placement, b: u32) {
    var e: u32 = g.succ_start[b];
    for (e < g.succ_start[b + 1]) {
        val s: u32 = g.succ[e];
        if (!flow.edge_is_back(g, b, s)) {
            p.fwd_in[s] = p.fwd_in[s] - 1;
            if (p.fwd_in[s] == 0 && p.placed[s] == 0) { ready_push(?p.ready, g.rpo_num[s]); }
        }
        e = e + 1;
    }
}

# the successor to place right after b: one whose forward predecessors are
# all placed, never a block that ends in a trap, the deepest in loops first,
# so a loop's own successor wins over the way out of it, then the last arm:
# a branch's then arm is the guarded case (an error return, a match) and its
# else arm the way the code goes on
fun likely_successor(f: *lang_mir.MirFunction, tgt: *lang_target.Binding, g: *flow.Graph, p: *Placement, b: u32) u32 {
    var best: u32 = NONE;
    var e:    u32 = g.succ_start[b];
    for (e < g.succ_start[b + 1]) {
        val s: u32 = g.succ[e];
        if (p.placed[s] == 0 && p.fwd_in[s] == 0 && !flow.edge_is_back(g, b, s) && !is_trap_terminated(f, s, tgt)) {
            if (best == NONE || g.depth[s] >= g.depth[best]) { best = s; }
        }
        e = e + 1;
    }
    ret best;
}

# a greedy topological order over the forward edges: each block is followed
# by its likely successor when that one is ready, and otherwise by the ready
# block earliest in reverse postorder. blocks the entry does not reach follow
# in index order, and blocks that end in a trap go last
fun order_blocks(alloc: *A.Allocator, f: *lang_mir.MirFunction, tgt: *lang_target.Binding) err[fail.Fail] {
    val n:  u32                        = f.block_count;
    val rg: res[flow.Graph, fail.Fail] = flow.init(alloc, f);
    if (sel rg.err) { ret err[fail.Fail].err{rg.err}; }
    var g: flow.Graph = rg.ok;
    fin { flow.dnit(?g); }
    val rd: err[fail.Fail] = flow.loops_build(?g);
    if (sel rd.err) { ret rd; }

    var p:  Placement;
    val rp: res[*u32, fail.Fail] = table(alloc, n, 0);
    if (sel rp.err) { ret err[fail.Fail].err{rp.err}; }
    p.placed = rp.ok;
    fin { table_free(alloc, p.placed, n); }
    val rf: res[*u32, fail.Fail] = table(alloc, n, 0);
    if (sel rf.err) { ret err[fail.Fail].err{rf.err}; }
    p.fwd_in = rf.ok;
    fin { table_free(alloc, p.fwd_in, n); }
    val rr: res[*u32, fail.Fail] = table(alloc, n, 0);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    p.ready.at  = rr.ok;
    p.ready.len = 0;
    fin { table_free(alloc, p.ready.at, n); }
    val rc: res[*u32, fail.Fail] = table(alloc, n, 0);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    p.cold   = rc.ok;
    p.cold_n = 0;
    fin { table_free(alloc, p.cold, n); }
    # the order is the function's own, released with it
    val ro: res[*u32, A.Error] = A.allocate[u32](alloc, n::usize);
    if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
    p.order = ro.ok;
    p.count = 0;

    var b: u32 = 0;
    for (b < n) {
        if (flow.block_is_reached(?g, b)) {
            var e: u32 = g.succ_start[b];
            for (e < g.succ_start[b + 1]) {
                val s: u32 = g.succ[e];
                if (!flow.edge_is_back(?g, b, s)) { p.fwd_in[s] = p.fwd_in[s] + 1; }
                e = e + 1;
            }
        }
        b = b + 1;
    }

    place(?g, ?p, 0);
    for (true) {
        var next: u32 = likely_successor(f, tgt, ?g, ?p, p.order[p.count - 1]);
        for (next == NONE && p.ready.len > 0) {
            val c: u32 = g.rpo_block[ready_pop(?p.ready)];
            if (p.placed[c] == 0) {
                if (is_trap_terminated(f, c, tgt)) {
                    p.placed[c]      = 1;
                    p.cold[p.cold_n] = c;
                    p.cold_n         = p.cold_n + 1;
                    release(?g, ?p, c);
                }
                or { next = c; }
            }
        }
        if (next == NONE) { brk; }
        place(?g, ?p, next);
    }

    b = 0;
    for (b < n) {
        if (p.placed[b] == 0) {
            p.order[p.count] = b;
            p.count          = p.count + 1;
        }
        b = b + 1;
    }
    var c: u32 = 0;
    for (c < p.cold_n) {
        p.order[p.count] = p.cold[c];
        p.count          = p.count + 1;
        c                = c + 1;
    }
    f.emit_order = p.order;
    ret err[fail.Fail].ok{};
}

use mach.lang.target.isa;
use isa_encode: mach.lang.target.isa.encode;
use std.allocator.page;

# a block holding one terminator: a jump to a (b NONE), a branch on vreg 0 to
# a or b, or with a NONE the given leaf opcode
#[testing]
fun t_block(alloc: *A.Allocator, id: u32, op: lang_mir.MirOpcode, a: u32, b: u32) lang_mir.MirBlock {
    var ops: [3]lang_mir.MirOperand;
    var n:   u32 = 0;
    if (a != NONE && b != NONE) {
        ops[0] = lang_mir.op_vreg(lang_mir.vreg_id(0));
        ops[1] = lang_mir.op_block(a);
        ops[2] = lang_mir.op_block(b);
        n      = 3;
    }
    or (a != NONE) {
        ops[0] = lang_mir.op_block(a);
        n      = 1;
    }
    var mi: lang_mir.MirInstr = lang_mir.instr_owned(alloc, op, ?ops[0], n, 8, 8);
    ret lang_mir.block_owned(alloc, id, ?mi, 1);
}

#[testing]
fun t_is_trap(opcode: u32) bool {
    ret opcode == lang_mir.MIR_UNREACHABLE::u32;
}

#[testing]
fun t_is_reg_move(opcode: u32) bool {
    ret false;
}

#[testing]
fun t_order_is(f: *lang_mir.MirFunction, ids: *u32, n: u32) bool {
    if (f.emit_order == nil) { ret false; }
    var i: u32 = 0;
    for (i < n) {
        if (f.blocks[f.emit_order[i]].id != ids[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a loop whose body may leave by a brk: the body's way on through the loop
# follows it although it is the branch's then arm, and the loop's exit waits
# for the latch, its last forward predecessor
test order_blocks__a_loop_body_falls_through_its_own_successor {
    var alloc: A.Allocator;
    page.make(?alloc);
    var machine: isa.RegMachine = isa.RegMachine{is_reg_move: t_is_reg_move, is_trap_terminator: t_is_trap, scratch_reg: -1, scratch_reg2: -1, frame_ptr_reg: -1, stack_ptr_reg: -1};
    var tgt:     lang_target.Binding;
    tgt.arch = ?machine;

    var blocks: [6]lang_mir.MirBlock;
    blocks[0] = t_block(?alloc, 0, lang_mir.MIR_CBR, 1, 5);
    blocks[1] = t_block(?alloc, 1, lang_mir.MIR_CBR, 2, 3);
    blocks[2] = t_block(?alloc, 2, lang_mir.MIR_CBR, 1, 5);
    blocks[3] = t_block(?alloc, 3, lang_mir.MIR_BR, 4, NONE);
    blocks[4] = t_block(?alloc, 4, lang_mir.MIR_RET, NONE, NONE);
    blocks[5] = t_block(?alloc, 5, lang_mir.MIR_BR, 4, NONE);
    var f: lang_mir.MirFunction = lang_mir.function_of(?blocks[0], 6);
    val r: err[fail.Fail]       = order_blocks(?alloc, ?f, ?tgt);
    if (sel r.err) { ret 1; }

    var want: [6]u32;
    want[0] = 0;
    want[1] = 1;
    want[2] = 2;
    want[3] = 5;
    want[4] = 3;
    want[5] = 4;
    if (!t_order_is(?f, ?want[0], 6)) { ret 2; }
    ret 0;
}

# a block ending in a trap goes last, never the entry, and block ids and
# array positions do not steer the order, only the branch operands do
test order_blocks__sinks_a_trap_but_not_the_entry {
    var alloc: A.Allocator;
    page.make(?alloc);
    var machine: isa.RegMachine = isa.RegMachine{is_reg_move: t_is_reg_move, is_trap_terminator: t_is_trap, scratch_reg: -1, scratch_reg2: -1, frame_ptr_reg: -1, stack_ptr_reg: -1};
    var tgt:     lang_target.Binding;
    tgt.arch = ?machine;

    var blocks: [4]lang_mir.MirBlock;
    blocks[0] = t_block(?alloc, 0, lang_mir.MIR_CBR, 9, 4);
    blocks[1] = t_block(?alloc, 4, lang_mir.MIR_BR, 7, NONE);
    blocks[2] = t_block(?alloc, 9, lang_mir.MIR_UNREACHABLE, NONE, NONE);
    blocks[3] = t_block(?alloc, 7, lang_mir.MIR_RET, NONE, NONE);
    var f: lang_mir.MirFunction = lang_mir.function_of(?blocks[0], 4);
    val r: err[fail.Fail]       = order_blocks(?alloc, ?f, ?tgt);
    if (sel r.err) { ret 1; }
    var want: [4]u32;
    want[0] = 0;
    want[1] = 4;
    want[2] = 7;
    want[3] = 9;
    if (!t_order_is(?f, ?want[0], 4)) { ret 2; }

    var cold: [2]lang_mir.MirBlock;
    cold[0] = t_block(?alloc, 0, lang_mir.MIR_UNREACHABLE, NONE, NONE);
    cold[1] = t_block(?alloc, 1, lang_mir.MIR_RET, NONE, NONE);
    var g:  lang_mir.MirFunction = lang_mir.function_of(?cold[0], 2);
    val rg: err[fail.Fail]       = order_blocks(?alloc, ?g, ?tgt);
    if (sel rg.err) { ret 3; }
    var entry: [2]u32;
    entry[0] = 0;
    entry[1] = 1;
    if (!t_order_is(?g, ?entry[0], 2)) { ret 4; }
    ret 0;
}

# a chain of blocks that only jump goes: the branch names the block the chain
# ends at, once, and the jumps' bindings open where that block starts, the
# first jump's ahead of the second's and both ahead of the block's own
test thread_jumps__retargets_a_chain_and_keeps_its_bindings {
    var alloc: A.Allocator;
    page.make(?alloc);

    var blocks: [4]lang_mir.MirBlock;
    blocks[0] = t_block(?alloc, 0, lang_mir.MIR_CBR, 1, 3);
    blocks[1] = t_block(?alloc, 1, lang_mir.MIR_BR, 2, NONE);
    blocks[2] = t_block(?alloc, 2, lang_mir.MIR_BR, 3, NONE);
    blocks[3] = t_block(?alloc, 3, lang_mir.MIR_RET, NONE, NONE);
    val b1: err[fail.Fail] = lang_mir.instr_attach_dbg(?alloc, ?blocks[1].instrs[0], 7, 0);
    if (sel b1.err) { ret 1; }
    val b2: err[fail.Fail] = lang_mir.instr_attach_dbg(?alloc, ?blocks[2].instrs[0], 8, 0);
    if (sel b2.err) { ret 1; }
    val b3: err[fail.Fail] = lang_mir.instr_attach_dbg(?alloc, ?blocks[3].instrs[0], 9, 0);
    if (sel b3.err) { ret 1; }
    var f: lang_mir.MirFunction = lang_mir.function_of(?blocks[0], 4);
    val r: err[fail.Fail]       = thread_jumps(?alloc, ?f);
    if (sel r.err) { ret 2; }

    if (f.block_count != 2)                         { ret 3; }
    if (f.blocks[0].instrs[0].operands[1].imm != 3) { ret 4; }
    if (f.blocks[0].instrs[0].operands[2].imm != 3) { ret 4; }
    if (f.blocks[1].id != 3)                        { ret 5; }
    val ret_instr: *lang_mir.MirInstr = ?f.blocks[1].instrs[0];
    if (ret_instr.dbg_binding_count != 3)                                                                               { ret 6; }
    if (ret_instr.dbg_bindings[0].iid != 7 || ret_instr.dbg_bindings[1].iid != 8 || ret_instr.dbg_bindings[2].iid != 9) { ret 7; }
    ret 0;
}
