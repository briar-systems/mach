use mach.lang.fail;
use system_os: std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use std.allocator.page;

use codegen_mir: mach.lang.be.codegen.mir;
use lang_source: mach.lang.source;
use mach.lang.target.isa;

pub def RuleKind: u8;

pub val RULE_RETAG:  RuleKind = 0;
pub val RULE_PASS:   RuleKind = 1;
pub val RULE_EXPAND: RuleKind = 2;

pub def RuleGate: u8;

pub val GATE_ANY:    RuleGate = 0;
pub val GATE_SCALAR: RuleGate = 1;
pub val GATE_VECTOR: RuleGate = 2;

pub def GuardFn: fun(*isa.BackendTarget, *codegen_mir.MirFunction, *codegen_mir.MirInstr) bool;

pub rec ExpansionBuilder {
    allocator: *A.Allocator;
    function:  *codegen_mir.MirFunction;
    source:    *codegen_mir.MirInstr;
    dst:       *codegen_mir.MirInstr;
    cursor:    u32;
    emitted:   u32;
    limit:     u32;
}

pub def ExpandFn: fun(*ExpansionBuilder) err[fail.Fail];

pub rec Rule {
    op:               u32;
    gate:             RuleGate;
    guard:            GuardFn;
    kind:             RuleKind;
    to:               u32;
    expand:           ExpandFn;
    expansion_length: u32;
}

pub rec RulePack {
    name:               str;
    rules:              *Rule;
    rule_count:         u32;
    copy_opcodes:       *u32;
    copy_opcode_count:  u32;
    fused_cbr_ccs:      *u32;
    fused_cbr_cc_count: u32;
}

fun typed_operand_bank(f: *codegen_mir.MirFunction, op: *codegen_mir.MirOperand) res[codegen_mir.OperandBank, fail.Fail] {
    if (op.kind == codegen_mir.MIR_OP_VREG) {
        if (op.vreg.n >= f.vreg_count || f.vregs == nil) { ret res[codegen_mir.OperandBank, fail.Fail].err{fail.message("rules: operand bank refers to a missing virtual register")}; }
        if (codegen_mir.vreg_is_fp(f, op.vreg))          { ret res[codegen_mir.OperandBank, fail.Fail].ok{codegen_mir.BANK_FP}; }
        ret res[codegen_mir.OperandBank, fail.Fail].ok{codegen_mir.BANK_GP};
    }
    if (op.kind == codegen_mir.MIR_OP_PREG) {
        val class: i32 = isa.regid_class(codegen_mir.preg_regid(op.preg));
        if (class == isa.REG_CLASS_ID_GP)  { ret res[codegen_mir.OperandBank, fail.Fail].ok{codegen_mir.BANK_GP}; }
        if (class == isa.REG_CLASS_ID_XMM) { ret res[codegen_mir.OperandBank, fail.Fail].ok{codegen_mir.BANK_FP}; }
        ret res[codegen_mir.OperandBank, fail.Fail].err{fail.message("rules: operand bank refers to an unknown physical register class")};
    }
    ret res[codegen_mir.OperandBank, fail.Fail].err{fail.message("rules: operand is not a register")};
}

pub fun capture_operand_banks(f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr) err[fail.Fail] {
    var k: u32 = 0;
    for (k < mi.operand_count) {
        val op: *codegen_mir.MirOperand = ?mi.operands[k];
        if (op.kind == codegen_mir.MIR_OP_VREG || op.kind == codegen_mir.MIR_OP_PREG) {
            val declared: res[codegen_mir.OperandBank, fail.Fail] = codegen_mir.operand_bank(mi.opcode, k, mi.vec_lane != codegen_mir.VEC_LANE_NONE);
            if (sel declared.err) { ret err[fail.Fail].err{declared.err}; }
            val typed: res[codegen_mir.OperandBank, fail.Fail] = typed_operand_bank(f, op);
            if (sel typed.err) { ret err[fail.Fail].err{typed.err}; }
            val actual:   codegen_mir.OperandBank = typed.ok;
            val required: codegen_mir.OperandBank = declared.ok;
            if (required != codegen_mir.BANK_EITHER && required != actual) {
                ret err[fail.Fail].err{fail.message("rules: register operand is in the wrong bank for its machine opcode")};
            }
            op.required_bank = actual;
        }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun select_function(pack: *RulePack, a: *A.Allocator, tgt: *isa.BackendTarget, f: *codegen_mir.MirFunction) err[fail.Fail] {
    if (pack == nil) { ret err[fail.Fail].err{fail.message("rules: nil rule pack")}; }
    if (a == nil)    { ret err[fail.Fail].err{fail.message("rules: nil allocator")}; }
    if (f == nil)    { ret err[fail.Fail].err{fail.message("rules: nil mir function")}; }
    if (tgt == nil)  { ret err[fail.Fail].err{fail.message("rules: nil backend target")}; }

    if (pack.fused_cbr_cc_count > 0) {
        val res_combine: err[fail.Fail] = combine_cbr(pack, a, f);
        if (sel res_combine.err) { ret res_combine; }
    }

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val res_block: err[fail.Fail] = select_block(pack, a, tgt, f, ?f.blocks[bi]);
        if (sel res_block.err) { ret res_block; }
        bi = bi + 1;
    }

    ret err[fail.Fail].ok{};
}

pub fun is_reg_move(pack: *RulePack, opcode: u32) bool {
    var i: u32 = 0;
    for (i < pack.copy_opcode_count) {
        if (pack.copy_opcodes[i] == opcode) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun find_rule(pack: *RulePack, tgt: *isa.BackendTarget, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr) *Rule {
    var i: u32 = 0;
    for (i < pack.rule_count) {
        val r: *Rule = ?pack.rules[i];
        if (r.op == mi.opcode && gate_admits(r.gate, mi) &&
            (r.guard == nil || r.guard(tgt, f, mi))) {
            ret r;
        }
        i = i + 1;
    }
    ret nil;
}

pub fun emit_instr(builder: *ExpansionBuilder, opcode: u32, operands: *codegen_mir.MirOperand, operand_count: u32) res[*codegen_mir.MirInstr, fail.Fail] {
    if (builder.emitted >= builder.limit) {
        ret res[*codegen_mir.MirInstr, fail.Fail].err{fail.message("rules: expansion emitted more pieces than its rule's declared length")};
    }

    var oi: u32 = 0;
    for (oi < operand_count) {
        val op: *codegen_mir.MirOperand = ?operands[oi];
        if (op.kind == codegen_mir.MIR_OP_VREG || op.kind == codegen_mir.MIR_OP_PREG) {
            if (op.required_bank != codegen_mir.BANK_GP && op.required_bank != codegen_mir.BANK_FP) {
                ret res[*codegen_mir.MirInstr, fail.Fail].err{fail.message("rules: expansion register operand omits its selected bank constraint")};
            }
            val typed: res[codegen_mir.OperandBank, fail.Fail] = typed_operand_bank(builder.function, op);
            if (sel typed.err) { ret res[*codegen_mir.MirInstr, fail.Fail].err{typed.err}; }
            if (typed.ok != op.required_bank) {
                ret res[*codegen_mir.MirInstr, fail.Fail].err{fail.message("rules: expansion register operand violates its selected bank constraint")};
            }
        }
        oi = oi + 1;
    }

    var ops: *codegen_mir.MirOperand = nil;
    if (operand_count > 0) {
        val res_ops: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](builder.allocator, operand_count::usize);
        if (sel res_ops.err) {
            ret res[*codegen_mir.MirInstr, fail.Fail].err{fail.refused(res_ops.err)};
        }
        ops = res_ops.ok;
        var i: u32 = 0;
        for (i < operand_count) {
            ops[i] = operands[i];
            i      = i + 1;
        }
    }

    val piece:  *codegen_mir.MirInstr = ?builder.dst[builder.cursor];
    val source: *codegen_mir.MirInstr = builder.source;
    piece.opcode        = opcode;
    piece.operands      = ops;
    piece.operand_count = operand_count;
    piece.width         = source.width;
    piece.src_width     = source.src_width;
    piece.vec_lane      = source.vec_lane;
    piece.writes_secret = source.writes_secret;
    piece.memory_flags  = source.memory_flags;
    piece.declassifies  = codegen_mir.instr_declassifies(source);
    piece.loc           = source.loc;
    piece.inline_site   = source.inline_site;

    builder.cursor  = builder.cursor + 1;
    builder.emitted = builder.emitted + 1;
    ret res[*codegen_mir.MirInstr, fail.Fail].ok{piece};
}

# a retag loses the generic opcode; the declassify barrier is kept as a flag
fun retag(mi: *codegen_mir.MirInstr, to: u32) {
    if (codegen_mir.instr_declassifies(mi)) { mi.declassifies = true; }
    mi.opcode = to;
}

fun gate_admits(gate: RuleGate, mi: *codegen_mir.MirInstr) bool {
    if (gate == GATE_ANY)    { ret true; }
    if (gate == GATE_SCALAR) { ret mi.vec_lane == 0; }
    ret mi.vec_lane != 0;
}

pub fun operand_rides_fp_bank(f: *codegen_mir.MirFunction, op: *codegen_mir.MirOperand) bool {
    if (op.kind == codegen_mir.MIR_OP_VREG) { ret codegen_mir.vreg_is_fp(f, op.vreg); }
    if (op.kind == codegen_mir.MIR_OP_PREG) { ret isa.regid_class(codegen_mir.preg_regid(op.preg)) == isa.REG_CLASS_ID_XMM; }
    ret false;
}

pub fun guard_fp_bank_move(tgt: *isa.BackendTarget, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr) bool {
    ret operand_rides_fp_bank(f, ?mi.operands[0]) || operand_rides_fp_bank(f, ?mi.operands[1]);
}

fun pack_fuses_cc(pack: *RulePack, op: u32) bool {
    var i: u32 = 0;
    for (i < pack.fused_cbr_cc_count) {
        if (pack.fused_cbr_ccs[i] == op) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun count_vreg_refs(f: *codegen_mir.MirFunction, counts: *u32, nv: u32) {
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val b:  *codegen_mir.MirBlock = ?f.blocks[bi];
        var ii: u32                   = 0;
        for (ii < b.instr_count) {
            val mi: *codegen_mir.MirInstr = ?b.instrs[ii];
            var k:  u32                   = 0;
            for (k < mi.operand_count) {
                val op: *codegen_mir.MirOperand = ?mi.operands[k];
                if (op.kind == codegen_mir.MIR_OP_VREG && op.vreg.n < nv) {
                    counts[op.vreg.n] = counts[op.vreg.n] + 1;
                }
                if (op.kind == codegen_mir.MIR_OP_MEM) {
                    if (!codegen_mir.vreg_is_nil(op.vreg) && op.vreg.n < nv) {
                        counts[op.vreg.n] = counts[op.vreg.n] + 1;
                    }
                    if (sel op.index.vreg) {
                        if (op.index.vreg.n < nv) { counts[op.index.vreg.n] = counts[op.index.vreg.n] + 1; }
                    }
                }
                k = k + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun defines_vreg(mi: *codegen_mir.MirInstr, v: codegen_mir.VRegId) bool {
    if (!codegen_mir.instr_defines_shape(mi)) { ret false; }
    ret mi.operands[0].kind == codegen_mir.MIR_OP_VREG && codegen_mir.vreg_same(mi.operands[0].vreg, v);
}

fun combine_cbr(pack: *RulePack, a: *A.Allocator, f: *codegen_mir.MirFunction) err[fail.Fail] {
    val nv: u32 = f.vreg_count;
    if (nv == 0)              { ret err[fail.Fail].ok{}; }
    if (!function_has_cbr(f)) { ret err[fail.Fail].ok{}; }

    val res_counts: res[*u32, A.Error] = A.zallocate[u32](a, nv::usize);
    if (sel res_counts.err) {
        ret err[fail.Fail].err{fail.refused(res_counts.err)};
    }
    val counts: *u32 = res_counts.ok;
    count_vreg_refs(f, counts, nv);

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val b: *codegen_mir.MirBlock = ?f.blocks[bi];
        var j: u32                   = 0;
        for (j < b.instr_count) {
            val br: *codegen_mir.MirInstr = ?b.instrs[j];
            val ci: u32                   = fusable_cmp_index(pack, b, br, counts, nv, j);
            if (ci == FUSE_NONE) {
                j = j + 1;
                cnt;
            }

            val res_fuse: err[fail.Fail] = fuse_pair(a, b, ci, j);
            if (sel res_fuse.err) {
                A.deallocate[u32](a, counts, nv::usize);
                ret res_fuse;
            }
        }
        bi = bi + 1;
    }

    A.deallocate[u32](a, counts, nv::usize);
    ret err[fail.Fail].ok{};
}

fun function_has_cbr(f: *codegen_mir.MirFunction) bool {
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val b:  *codegen_mir.MirBlock = ?f.blocks[bi];
        var ii: u32                   = 0;
        for (ii < b.instr_count) {
            if (b.instrs[ii].opcode == codegen_mir.MIR_CBR) { ret true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

val FUSE_NONE: u32 = 0xFFFFFFFF;

fun fusable_cmp_index(pack: *RulePack, b: *codegen_mir.MirBlock, br: *codegen_mir.MirInstr,
    counts: *u32, nv: u32, j: u32) u32 {
    if (br.opcode != codegen_mir.MIR_CBR)               { ret FUSE_NONE; }
    if (br.vec_lane != 0)                               { ret FUSE_NONE; }
    if (br.operand_count != 3)                          { ret FUSE_NONE; }
    if (br.operands[0].kind != codegen_mir.MIR_OP_VREG) { ret FUSE_NONE; }
    val v: u32 = br.operands[0].vreg.n;
    if (v >= nv)        { ret FUSE_NONE; }
    if (counts[v] != 2) { ret FUSE_NONE; }

    var k:     u32  = j;
    var found: bool = false;
    for (k > 0 && !found) {
        k = k - 1;
        if (defines_vreg(?b.instrs[k], codegen_mir.vreg_id(v))) { found = true; }
    }
    if (!found) { ret FUSE_NONE; }

    val cmp: *codegen_mir.MirInstr = ?b.instrs[k];
    if (!codegen_mir.is_cmp_opcode(cmp.opcode)) { ret FUSE_NONE; }
    if (!pack_fuses_cc(pack, cmp.opcode))       { ret FUSE_NONE; }
    if (cmp.vec_lane != 0)                      { ret FUSE_NONE; }
    if (cmp.operand_count != 3)                 { ret FUSE_NONE; }

    val lhs: *codegen_mir.MirOperand = ?cmp.operands[1];
    val rhs: *codegen_mir.MirOperand = ?cmp.operands[2];
    if (lhs.kind != codegen_mir.MIR_OP_VREG && lhs.kind != codegen_mir.MIR_OP_IMM) { ret FUSE_NONE; }
    if (rhs.kind != codegen_mir.MIR_OP_VREG && rhs.kind != codegen_mir.MIR_OP_IMM) { ret FUSE_NONE; }

    var m: u32 = k + 1;
    for (m < j) {
        if (lhs.kind == codegen_mir.MIR_OP_VREG && defines_vreg(?b.instrs[m], lhs.vreg)) { ret FUSE_NONE; }
        if (rhs.kind == codegen_mir.MIR_OP_VREG && defines_vreg(?b.instrs[m], rhs.vreg)) { ret FUSE_NONE; }
        m = m + 1;
    }
    ret k;
}

fun fuse_pair(a: *A.Allocator, b: *codegen_mir.MirBlock, ci: u32, j: u32) err[fail.Fail] {
    val cmp: *codegen_mir.MirInstr = ?b.instrs[ci];
    val br:  *codegen_mir.MirInstr = ?b.instrs[j];

    val res_ops: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](a, 4::usize);
    if (sel res_ops.err) {
        ret err[fail.Fail].err{fail.refused(res_ops.err)};
    }
    val ops: *codegen_mir.MirOperand = res_ops.ok;
    ops[0] = cmp.operands[1];
    ops[1] = cmp.operands[2];
    ops[2] = br.operands[1];
    ops[3] = br.operands[2];

    val res_dbg: err[fail.Fail] = codegen_mir.instr_pass_dbg(a, cmp, br);
    if (sel res_dbg.err) {
        A.deallocate[codegen_mir.MirOperand](a, ops, 4::usize);
        ret res_dbg;
    }
    rewrite_cond_bindings(br, br.operands[0].vreg.n, cmp);

    A.deallocate[codegen_mir.MirOperand](a, br.operands, br.operand_count::usize);
    br.opcode        = codegen_mir.fused_cbr_opcode(cmp.opcode);
    br.operands      = ops;
    br.operand_count = 4;
    br.width         = cmp.width;
    br.src_width     = cmp.src_width;

    A.deallocate[codegen_mir.MirOperand](a, cmp.operands, cmp.operand_count::usize);
    var m: u32 = ci;
    for (m + 1 < b.instr_count) {
        b.instrs[m] = b.instrs[m + 1];
        m           = m + 1;
    }
    b.instr_count = b.instr_count - 1;
    ret err[fail.Fail].ok{};
}

fun rewrite_cond_bindings(br: *codegen_mir.MirInstr, cond_vreg: u32, cmp: *codegen_mir.MirInstr) {
    var i: u32 = 0;
    for (i < br.dbg_binding_count) {
        val bind: *codegen_mir.MirDbgBinding = ?br.dbg_bindings[i];
        if (bind.cmp_op == 0 && bind.vreg == cond_vreg) {
            bind.cmp_op    = codegen_mir.fused_cbr_opcode(cmp.opcode);
            bind.cmp_width = cmp.width;
            val lhs: *codegen_mir.MirOperand = ?cmp.operands[1];
            val rhs: *codegen_mir.MirOperand = ?cmp.operands[2];
            if (lhs.kind == codegen_mir.MIR_OP_IMM) {
                bind.lhs_is_imm = true;
                bind.vreg       = codegen_mir.MIR_VREG_NIL.n;
                bind.imm        = lhs.imm;
            }
            or {
                bind.lhs_is_imm = false;
                bind.vreg       = lhs.vreg.n;
                bind.imm        = 0;
            }
            if (rhs.kind == codegen_mir.MIR_OP_IMM) {
                bind.rhs_is_imm = true;
                bind.vreg2      = codegen_mir.MIR_VREG_NIL.n;
                bind.imm2       = rhs.imm;
            }
            or {
                bind.rhs_is_imm = false;
                bind.vreg2      = rhs.vreg.n;
                bind.imm2       = 0;
            }
        }
        i = i + 1;
    }
}

fun select_block(pack: *RulePack, a: *A.Allocator, tgt: *isa.BackendTarget, f: *codegen_mir.MirFunction, b: *codegen_mir.MirBlock) err[fail.Fail] {
    val n: u32 = b.instr_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    var stack_cache:   [RULE_CACHE_STACK]*Rule;
    var rules_for:     **Rule = ?stack_cache[0];
    var cache_on_heap: bool   = false;
    if (n > RULE_CACHE_STACK) {
        val res_cache: res[**Rule, A.Error] = A.allocate[*Rule](a, n::usize);
        if (sel res_cache.err) {
            ret err[fail.Fail].err{fail.refused(res_cache.err)};
        }
        rules_for     = res_cache.ok;
        cache_on_heap = true;
    }

    var total:        u32  = 0;
    var needs_expand: bool = false;
    var i:            u32  = 0;
    for (i < n) {
        val mi:    *codegen_mir.MirInstr = ?b.instrs[i];
        val banks: err[fail.Fail]        = capture_operand_banks(f, mi);
        if (sel banks.err) {
            free_rule_cache(a, rules_for, n, cache_on_heap);
            ret banks;
        }
        val rule: *Rule = find_rule(pack, tgt, f, mi);
        if (rule == nil) {
            write_opcode_ice(mi.opcode);
            free_rule_cache(a, rules_for, n, cache_on_heap);
            ret err[fail.Fail].err{fail.message("internal compiler error: unhandled MIR opcode in instruction selection")};
        }
        if (rule.kind == RULE_EXPAND) {
            if (rule.expand == nil || rule.expansion_length == 0) {
                free_rule_cache(a, rules_for, n, cache_on_heap);
                ret err[fail.Fail].err{fail.message("rules: malformed expansion rule")};
            }
            needs_expand = true;
            total        = total + rule.expansion_length;
        }
        or {
            total = total + 1;
        }
        rules_for[i] = rule;
        i            = i + 1;
    }

    if (!needs_expand) {
        i = 0;
        for (i < n) {
            if (rules_for[i].kind == RULE_RETAG) { retag(?b.instrs[i], rules_for[i].to); }
            i = i + 1;
        }
        free_rule_cache(a, rules_for, n, cache_on_heap);
        ret err[fail.Fail].ok{};
    }

    val res_alloc: res[*codegen_mir.MirInstr, A.Error] = A.zallocate[codegen_mir.MirInstr](a, total::usize);
    if (sel res_alloc.err) {
        free_rule_cache(a, rules_for, n, cache_on_heap);
        ret err[fail.Fail].err{fail.refused(res_alloc.err)};
    }
    val dst: *codegen_mir.MirInstr = res_alloc.ok;

    var w: u32 = 0;
    i = 0;
    for (i < n) {
        val mi:   *codegen_mir.MirInstr = ?b.instrs[i];
        val rule: *Rule                 = rules_for[i];
        if (rule.kind == RULE_EXPAND) {
            var builder: ExpansionBuilder;
            builder.allocator = a;
            builder.function  = f;
            builder.source    = mi;
            builder.dst       = dst;
            builder.cursor    = w;
            builder.emitted   = 0;
            builder.limit     = rule.expansion_length;
            val res_expand: err[fail.Fail] = rule.expand(?builder);
            if (sel res_expand.err) {
                free_partial_rebuild(a, b, rules_for, i, builder.emitted, dst, total);
                free_rule_cache(a, rules_for, n, cache_on_heap);
                ret err[fail.Fail].err{res_expand.err};
            }
            if (builder.emitted != rule.expansion_length) {
                free_partial_rebuild(a, b, rules_for, i, builder.emitted, dst, total);
                free_rule_cache(a, rules_for, n, cache_on_heap);
                ret err[fail.Fail].err{fail.message("rules: expansion emitted a piece count different from its rule's declared length")};
            }
            if (builder.emitted > 0) {
                val res_dbg: err[fail.Fail] = codegen_mir.instr_spread_dbg(a, mi, ?dst[w], ?dst[builder.cursor - 1]);
                if (sel res_dbg.err) {
                    free_partial_rebuild(a, b, rules_for, i, builder.emitted, dst, total);
                    free_rule_cache(a, rules_for, n, cache_on_heap);
                    ret res_dbg;
                }
            }
            w = builder.cursor;
            free_source_operands(a, mi);
        }
        or {
            if (rule.kind == RULE_RETAG) { retag(mi, rule.to); }
            dst[w] = @mi;
            w      = w + 1;
        }
        i = i + 1;
    }

    if (b.instrs != nil && b.instr_cap > 0) {
        A.deallocate[codegen_mir.MirInstr](a, b.instrs, b.instr_cap::usize);
    }
    b.instrs      = dst;
    b.instr_count = total;
    b.instr_cap   = total;

    free_rule_cache(a, rules_for, n, cache_on_heap);
    ret err[fail.Fail].ok{};
}

val RULE_CACHE_STACK: u32 = 128;

fun free_partial_rebuild(a: *A.Allocator, b: *codegen_mir.MirBlock, rules_for: **Rule,
    failed_i: u32, failed_emitted: u32, dst: *codegen_mir.MirInstr, total: u32) {
    var c: u32 = 0;
    var k: u32 = 0;
    for (k <= failed_i) {
        var pieces: u32 = 1;
        if (rules_for[k].kind == RULE_EXPAND) {
            pieces = rules_for[k].expansion_length;
            if (k == failed_i) { pieces = failed_emitted; }
            var p: u32 = 0;
            for (p < pieces) {
                val piece: *codegen_mir.MirInstr = ?dst[c + p];
                if (piece.operands != nil && piece.operand_count > 0) {
                    A.deallocate[codegen_mir.MirOperand](a, piece.operands, piece.operand_count::usize);
                }
                p = p + 1;
            }
        }
        c = c + pieces;
        k = k + 1;
    }
    A.deallocate[codegen_mir.MirInstr](a, dst, total::usize);
}

fun free_rule_cache(a: *A.Allocator, cache: **Rule, n: u32, on_heap: bool) {
    if (on_heap) { A.deallocate[*Rule](a, cache, n::usize); }
}

fun free_source_operands(a: *A.Allocator, mi: *codegen_mir.MirInstr) {
    if (mi.operands != nil && mi.operand_count > 0) {
        A.deallocate[codegen_mir.MirOperand](a, mi.operands, mi.operand_count::usize);
    }
    mi.operands      = nil;
    mi.operand_count = 0;
}

fun write_opcode_ice(opcode: u32) {
    system_os.write(system_os.stderr(), "internal compiler error: unhandled MIR opcode ", 46);

    var digits: [16]u8;
    var len:    usize = 0;
    if (opcode == 0) {
        digits[0] = '0';
        len       = 1;
    }
    or {
        var v: u32 = opcode;
        for (v > 0) {
            digits[len] = (v % 10)::u8 + '0';
            v           = v / 10;
            len         = len + 1;
        }
        var i: usize = 0;
        for (i < len / 2) {
            val swap: u8 = digits[i];
            digits[i]           = digits[len - 1 - i];
            digits[len - 1 - i] = swap;
            i                   = i + 1;
        }
    }

    system_os.write(system_os.stderr(), ?digits[0], len);
    system_os.write(system_os.stderr(), "\n", 1);
}

#[testing]
fun t_operand_zero_is_preg_ten(tgt: *isa.BackendTarget, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr) bool {
    ret mi.operands[0].kind == codegen_mir.MIR_OP_PREG && mi.operands[0].preg.n == 10;
}

#[testing]
fun t_expand_two_pieces(builder: *ExpansionBuilder) err[fail.Fail] {
    var ops: [2]codegen_mir.MirOperand;
    ops[0] = builder.source.operands[0];
    ops[1] = builder.source.operands[1];

    val res_first: res[*codegen_mir.MirInstr, fail.Fail] = emit_instr(builder, 900, ?ops[0], 2);
    if (sel res_first.err) {
        ret err[fail.Fail].err{res_first.err};
    }
    val res_second: res[*codegen_mir.MirInstr, fail.Fail] = emit_instr(builder, 901, ?ops[0], 2);
    if (sel res_second.err) {
        ret err[fail.Fail].err{res_second.err};
    }
    ret err[fail.Fail].ok{};
}

#[testing]
fun t_expand_short_pieces(builder: *ExpansionBuilder) err[fail.Fail] {
    var ops: [2]codegen_mir.MirOperand;
    ops[0] = builder.source.operands[0];
    ops[1] = builder.source.operands[1];

    val res_first: res[*codegen_mir.MirInstr, fail.Fail] = emit_instr(builder, 900, ?ops[0], 2);
    if (sel res_first.err) {
        ret err[fail.Fail].err{res_first.err};
    }
    ret err[fail.Fail].ok{};
}

#[testing]
fun t_function(blk: *codegen_mir.MirBlock, instrs: *codegen_mir.MirInstr, instr_count: u32, f: *codegen_mir.MirFunction) {
    blk.id          = 0;
    blk.instrs      = instrs;
    blk.instr_count = instr_count;
    blk.instr_cap   = instr_count;
    f.blocks        = blk;
    f.block_count   = 1;
}

test select__first_matching_rule_wins {
    var alloc: A.Allocator;
    var tgt:   isa.BackendTarget;

    var instrs: [3]codegen_mir.MirInstr;
    var ops:    [3][2]codegen_mir.MirOperand;
    var i:      u32 = 0;
    for (i < 3) {
        ops[i][0]               = codegen_mir.op_preg(codegen_mir.preg_id(10));
        ops[i][1]               = codegen_mir.op_preg(codegen_mir.preg_id(11));
        instrs[i].operands      = ?ops[i][0];
        instrs[i].operand_count = 2;
        instrs[i].width         = 8;
        i                       = i + 1;
    }
    instrs[0].opcode = 1;
    instrs[1].opcode = 2;
    instrs[2].opcode = 1;

    var rules_table: [4]Rule;
    rules_table[0].op   = 1;
    rules_table[0].kind = RULE_RETAG;
    rules_table[0].to   = 101;
    rules_table[1].op   = 2;
    rules_table[1].kind = RULE_PASS;
    rules_table[2].op   = 3;
    rules_table[2].kind = RULE_RETAG;
    rules_table[2].to   = 103;
    rules_table[3].op   = 1;
    rules_table[3].kind = RULE_RETAG;
    rules_table[3].to   = 999;

    var pack: RulePack;
    pack.name               = "test";
    pack.rules              = ?rules_table[0];
    pack.rule_count         = 4;
    pack.fused_cbr_ccs      = nil;
    pack.fused_cbr_cc_count = 0;

    var blk: codegen_mir.MirBlock;
    var f:   codegen_mir.MirFunction;
    t_function(?blk, ?instrs[0], 3, ?f);

    val r: err[fail.Fail] = select_function(?pack, ?alloc, ?tgt, ?f);
    if (sel r.err) { ret 1; }

    if (instrs[0].opcode != 101)            { ret 1; }
    if (instrs[1].opcode != 2)              { ret 1; }
    if (instrs[2].opcode != 101)            { ret 1; }
    if (instrs[0].operand_count != 2)       { ret 1; }
    if (instrs[0].operands[0].preg.n != 10) { ret 1; }
    if (blk.instr_count != 3)               { ret 1; }
    if (blk.instrs != ?instrs[0])           { ret 1; }
    ret 0;
}

test select__guard_and_gate_route {
    var alloc: A.Allocator;
    var tgt:   isa.BackendTarget;

    var instrs: [2]codegen_mir.MirInstr;
    var ops:    [2][2]codegen_mir.MirOperand;
    ops[0][0] = codegen_mir.op_preg(codegen_mir.preg_id(10));
    ops[0][1] = codegen_mir.op_preg(codegen_mir.preg_id(11));
    ops[1][0] = codegen_mir.op_preg(codegen_mir.preg_id(12));
    ops[1][1] = codegen_mir.op_preg(codegen_mir.preg_id(11));
    var i: u32 = 0;
    for (i < 2) {
        instrs[i].opcode        = 7;
        instrs[i].operands      = ?ops[i][0];
        instrs[i].operand_count = 2;
        instrs[i].width         = 8;
        i                       = i + 1;
    }

    var rules_table: [4]Rule;
    rules_table[0].op    = 7;
    rules_table[0].guard = t_operand_zero_is_preg_ten;
    rules_table[0].kind  = RULE_RETAG;
    rules_table[0].to    = 700;
    rules_table[1].op    = 7;
    rules_table[1].kind  = RULE_RETAG;
    rules_table[1].to    = 701;
    rules_table[2].op    = 5;
    rules_table[2].gate  = GATE_VECTOR;
    rules_table[2].kind  = RULE_RETAG;
    rules_table[2].to    = 502;
    rules_table[3].op    = 5;
    rules_table[3].gate  = GATE_SCALAR;
    rules_table[3].kind  = RULE_RETAG;
    rules_table[3].to    = 501;

    var pack: RulePack;
    pack.name               = "test";
    pack.rules              = ?rules_table[0];
    pack.rule_count         = 4;
    pack.fused_cbr_ccs      = nil;
    pack.fused_cbr_cc_count = 0;

    var blk: codegen_mir.MirBlock;
    var f:   codegen_mir.MirFunction;
    t_function(?blk, ?instrs[0], 2, ?f);

    val guarded: err[fail.Fail] = select_function(?pack, ?alloc, ?tgt, ?f);
    if (sel guarded.err)         { ret 1; }
    if (instrs[0].opcode != 700) { ret 2; }
    if (instrs[1].opcode != 701) { ret 3; }

    i = 0;
    for (i < 2) {
        ops[i][0]        = codegen_mir.op_preg(codegen_mir.preg_id(10));
        ops[i][1]        = codegen_mir.op_preg(codegen_mir.preg_id(11));
        instrs[i].opcode = 5;
        i                = i + 1;
    }
    instrs[1].vec_lane = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_FLOAT, 4, 4);
    ops[1][0]          = codegen_mir.op_preg(codegen_mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 0)));
    ops[1][1]          = codegen_mir.op_preg(codegen_mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 1)));
    val gated: err[fail.Fail] = select_function(?pack, ?alloc, ?tgt, ?f);
    if (sel gated.err)           { ret 4; }
    if (instrs[0].opcode != 501) { ret 5; }
    if (instrs[1].opcode != 502) { ret 6; }
    ret 0;
}

test select__unmatched_opcode_fails {
    var alloc: A.Allocator;
    var tgt:   isa.BackendTarget;

    var instrs: [1]codegen_mir.MirInstr;
    var ops:    [2]codegen_mir.MirOperand;
