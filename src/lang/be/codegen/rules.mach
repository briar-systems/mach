    ret 0;
}

test select__expansion_carries_the_source_identity {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var tgt: isa.BackendTarget;

    val res_instrs: res[*codegen_mir.MirInstr, A.Error] = A.zallocate[codegen_mir.MirInstr](?backing, 3::usize);
    if (sel res_instrs.err) { ret 1; }
    val instrs:      *codegen_mir.MirInstr                 = res_instrs.ok;
    val res_exp_ops: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](?backing, 2::usize);
    if (sel res_exp_ops.err) { ret 1; }
    val exp_ops: *codegen_mir.MirOperand = res_exp_ops.ok;
    exp_ops[0] = codegen_mir.op_preg(codegen_mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 0)));
    exp_ops[1] = codegen_mir.op_preg(codegen_mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 1)));

    var edge_ops: [2][2]codegen_mir.MirOperand;
    edge_ops[0][0] = codegen_mir.op_preg(codegen_mir.preg_id(12));
    edge_ops[0][1] = codegen_mir.op_preg(codegen_mir.preg_id(13));
    edge_ops[1][0] = codegen_mir.op_preg(codegen_mir.preg_id(14));
    edge_ops[1][1] = codegen_mir.op_preg(codegen_mir.preg_id(15));

    # one binding published at the source's start and one at its end, where its def exists
    val res_bind: res[*codegen_mir.MirDbgBinding, A.Error] = A.zallocate[codegen_mir.MirDbgBinding](?backing, 2::usize);
    if (sel res_bind.err) { ret 1; }
    val bindings: *codegen_mir.MirDbgBinding = res_bind.ok;
    bindings[0].iid    = 7;
    bindings[0].vreg   = 3;
    bindings[1].iid    = 8;
    bindings[1].vreg   = 3;
    bindings[1].at_end = true;

    instrs[0].opcode            = 1;
    instrs[0].operands          = ?edge_ops[0][0];
    instrs[0].operand_count     = 2;
    instrs[0].width             = 8;
    instrs[1].opcode            = 9;
    instrs[1].operands          = exp_ops;
    instrs[1].operand_count     = 2;
    instrs[1].width             = 4;
    instrs[1].src_width         = 2;
    instrs[1].vec_lane          = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4);
    instrs[1].loc               = lang_source.loc(3, 77);
    instrs[1].inline_site       = 5;
    instrs[1].memory_flags      = codegen_mir.MEMORY_VOLATILE;
    instrs[1].dbg_bindings      = bindings;
    instrs[1].dbg_binding_count = 2;
    instrs[2].opcode            = 1;
    instrs[2].operands          = ?edge_ops[1][0];
    instrs[2].operand_count     = 2;
    instrs[2].width             = 8;

    var rules_table: [2]Rule;
    rules_table[0].op               = 1;
    rules_table[0].kind             = RULE_RETAG;
    rules_table[0].to               = 101;
    rules_table[1].op               = 9;
    rules_table[1].kind             = RULE_EXPAND;
    rules_table[1].expand           = t_expand_two_pieces;
    rules_table[1].expansion_length = 2;

    var pack: RulePack;
    pack.name               = "test";
    pack.rules              = ?rules_table[0];
    pack.rule_count         = 2;
    pack.fused_cbr_ccs      = nil;
    pack.fused_cbr_cc_count = 0;

    var blk: codegen_mir.MirBlock;
    var f:   codegen_mir.MirFunction;
    t_function(?blk, instrs, 3, ?f);

    val r: err[fail.Fail] = select_function(?pack, ?backing, ?tgt, ?f);
    if (sel r.err) { ret 1; }

    if (blk.instr_count != 4) { ret 1; }
    if (blk.instr_cap != 4)   { ret 1; }

    if (blk.instrs[0].opcode != 101)               { ret 1; }
    if (blk.instrs[0].operands != ?edge_ops[0][0]) { ret 1; }
    if (blk.instrs[3].opcode != 101)               { ret 1; }
    if (blk.instrs[3].operands != ?edge_ops[1][0]) { ret 1; }

    var p: u32 = 1;
    for (p < 3) {
        if (blk.instrs[p].width != 4)                                                                          { ret 1; }
        if (blk.instrs[p].src_width != 2)                                                                      { ret 1; }
        if (blk.instrs[p].vec_lane != codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4))               { ret 1; }
        if (blk.instrs[p].loc.file != 3)                                                                       { ret 1; }
        if (blk.instrs[p].loc.offset != 77)                                                                    { ret 1; }
        if (blk.instrs[p].inline_site != 5)                                                                    { ret 1; }
        if (blk.instrs[p].memory_flags != codegen_mir.MEMORY_VOLATILE)                                         { ret 2; }
        if (blk.instrs[p].asm_block != nil)                                                                    { ret 1; }
        if (blk.instrs[p].operand_count != 2)                                                                  { ret 1; }
        if (codegen_mir.preg_regid(blk.instrs[p].operands[0].preg) != isa.regid_make(isa.REG_CLASS_ID_XMM, 0)) { ret 1; }
        if (blk.instrs[p].operands[0].required_bank != codegen_mir.BANK_FP)                                    { ret 2; }
        p = p + 1;
    }
    if (blk.instrs[1].opcode != 900) { ret 1; }
    if (blk.instrs[2].opcode != 901) { ret 1; }

    # the first piece starts where the source did and the last one ends where it did
    if (blk.instrs[1].dbg_binding_count != 1)                                            { ret 3; }
    if (blk.instrs[1].dbg_bindings[0].iid != 7 || blk.instrs[1].dbg_bindings[0].at_end)  { ret 3; }
    if (blk.instrs[2].dbg_binding_count != 1)                                            { ret 4; }
    if (blk.instrs[2].dbg_bindings[0].iid != 8 || !blk.instrs[2].dbg_bindings[0].at_end) { ret 4; }
    ret 0;
}

test select__expansion_length_is_enforced {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var tgt: isa.BackendTarget;

    val res_instrs: res[*codegen_mir.MirInstr, A.Error] = A.zallocate[codegen_mir.MirInstr](?backing, 1::usize);
    if (sel res_instrs.err) { ret 1; }
    val instrs:  *codegen_mir.MirInstr                 = res_instrs.ok;
    val res_ops: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](?backing, 2::usize);
    if (sel res_ops.err) { ret 1; }
    val ops: *codegen_mir.MirOperand = res_ops.ok;
    ops[0]                  = codegen_mir.op_preg(codegen_mir.preg_id(10));
    ops[1]                  = codegen_mir.op_preg(codegen_mir.preg_id(11));
    instrs[0].opcode        = 9;
    instrs[0].operands      = ops;
    instrs[0].operand_count = 2;

    var rules_table: [1]Rule;
    rules_table[0].op               = 9;
    rules_table[0].kind             = RULE_EXPAND;
    rules_table[0].expand           = t_expand_short_pieces;
    rules_table[0].expansion_length = 2;

    var pack: RulePack;
    pack.name               = "test";
    pack.rules              = ?rules_table[0];
    pack.rule_count         = 1;
    pack.fused_cbr_ccs      = nil;
    pack.fused_cbr_cc_count = 0;

    var blk: codegen_mir.MirBlock;
    var f:   codegen_mir.MirFunction;
    t_function(?blk, instrs, 1, ?f);

    val short: err[fail.Fail] = select_function(?pack, ?backing, ?tgt, ?f);
    if (!sel short.err) { ret 1; }

    rules_table[0].expand           = t_expand_two_pieces;
    rules_table[0].expansion_length = 1;
    val over: err[fail.Fail] = select_function(?pack, ?backing, ?tgt, ?f);
    if (!sel over.err)        { ret 2; }
    if (blk.instrs != instrs) { ret 3; }
    if (blk.instr_count != 1) { ret 4; }
    ret 0;
}

#[testing]
fun t_heap_instr(a: *A.Allocator, mi: *codegen_mir.MirInstr, opcode: u32, operands: *codegen_mir.MirOperand, operand_count: u32) bool {
    val ro: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](a, operand_count::usize);
    if (sel ro.err) { ret false; }
    val ops: *codegen_mir.MirOperand = ro.ok;
    var i:   u32                     = 0;
    for (i < operand_count) {
        ops[i] = operands[i];
        i      = i + 1;
    }
    mi.opcode        = opcode;
    mi.operands      = ops;
    mi.operand_count = operand_count;
    ret true;
}

test combine_cbr__fuses_safe_shape {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var tgt: isa.BackendTarget;

    val res_instrs: res[*codegen_mir.MirInstr, A.Error] = A.zallocate[codegen_mir.MirInstr](?backing, 2::usize);
    if (sel res_instrs.err) { ret 1; }
    val instrs: *codegen_mir.MirInstr = res_instrs.ok;

    var cmp_ops: [3]codegen_mir.MirOperand;
    cmp_ops[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    cmp_ops[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    cmp_ops[2] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    if (!t_heap_instr(?backing, ?instrs[0], codegen_mir.MIR_CMP_LT_S, ?cmp_ops[0], 3)) { ret 1; }
    instrs[0].width     = 4;
    instrs[0].src_width = 4;
    instrs[0].loc       = lang_source.loc(3, 40);
    val res_cb: res[*codegen_mir.MirDbgBinding, A.Error] = A.allocate[codegen_mir.MirDbgBinding](?backing, 1::usize);
    if (sel res_cb.err) { ret 1; }
    instrs[0].dbg_bindings           = res_cb.ok;
    instrs[0].dbg_bindings[0].iid    = 7;
    instrs[0].dbg_bindings[0].cmp_op = 0;
    instrs[0].dbg_bindings[0].vreg   = 2;
    instrs[0].dbg_bindings[0].at_end = true;
    instrs[0].dbg_binding_count      = 1;

    var br_ops: [3]codegen_mir.MirOperand;
    br_ops[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    br_ops[1] = codegen_mir.op_block(5);
    br_ops[2] = codegen_mir.op_block(9);
    if (!t_heap_instr(?backing, ?instrs[1], codegen_mir.MIR_CBR, ?br_ops[0], 3)) { ret 1; }
    instrs[1].width     = 1;
    instrs[1].src_width = 1;
    instrs[1].loc       = lang_source.loc(3, 77);
    val res_bb: res[*codegen_mir.MirDbgBinding, A.Error] = A.allocate[codegen_mir.MirDbgBinding](?backing, 1::usize);
    if (sel res_bb.err) { ret 1; }
    instrs[1].dbg_bindings           = res_bb.ok;
    instrs[1].dbg_bindings[0].iid    = 9;
    instrs[1].dbg_bindings[0].cmp_op = 0;
    instrs[1].dbg_bindings[0].at_end = false;
    instrs[1].dbg_bindings[0].vreg   = 1;
    instrs[1].dbg_binding_count      = 1;

    var ccs: [1]u32;
    ccs[0] = codegen_mir.MIR_CMP_LT_S;
    var rules_table: [1]Rule;
    rules_table[0].op     = codegen_mir.MIR_SEL_CBR_LT_S;
    rules_table[0].gate   = GATE_SCALAR;
    rules_table[0].guard  = nil;
    rules_table[0].kind   = RULE_PASS;
    rules_table[0].expand = nil;

    var pack: RulePack;
    pack.name               = "test";
    pack.rules              = ?rules_table[0];
    pack.rule_count         = 1;
    pack.fused_cbr_ccs      = ?ccs[0];
    pack.fused_cbr_cc_count = 1;

    var blk: codegen_mir.MirBlock;
    var f:   codegen_mir.MirFunction;
    t_function(?blk, instrs, 2, ?f);
    f.vreg_count = 3;
    var vregs: [3]codegen_mir.MirVReg;
    vregs[0] = codegen_mir.vreg(0, codegen_mir.REG_CLASS_GP, 0, false);
    vregs[1] = codegen_mir.vreg(1, codegen_mir.REG_CLASS_GP, 0, false);
    vregs[2] = codegen_mir.vreg(2, codegen_mir.REG_CLASS_GP, 0, false);
    f.vregs  = ?vregs[0];

    val r: err[fail.Fail] = select_function(?pack, ?backing, ?tgt, ?f);
    if (sel r.err) { ret 1; }

    if (blk.instr_count != 1) { ret 1; }
    val fused: *codegen_mir.MirInstr = ?blk.instrs[0];
    if (fused.opcode != codegen_mir.MIR_SEL_CBR_LT_S)                                       { ret 1; }
    if (fused.operand_count != 4)                                                           { ret 1; }
    if (fused.operands[0].kind != codegen_mir.MIR_OP_VREG || fused.operands[0].vreg.n != 0) { ret 1; }
    if (fused.operands[1].kind != codegen_mir.MIR_OP_VREG || fused.operands[1].vreg.n != 1) { ret 1; }
    if (fused.operands[2].kind != codegen_mir.MIR_OP_BLOCK || fused.operands[2].imm != 5)   { ret 1; }
    if (fused.operands[3].kind != codegen_mir.MIR_OP_BLOCK || fused.operands[3].imm != 9)   { ret 1; }

    if (fused.width != 4)       { ret 1; }
    if (fused.src_width != 4)   { ret 1; }
    if (fused.loc.offset != 77) { ret 1; }

    if (fused.dbg_binding_count != 2)                                 { ret 1; }
    if (fused.dbg_bindings[0].iid != 7)                               { ret 1; }
    if (fused.dbg_bindings[0].cmp_op != codegen_mir.MIR_SEL_CBR_LT_S) { ret 1; }
    if (fused.dbg_bindings[0].cmp_width != 4)                         { ret 1; }
    if (fused.dbg_bindings[0].lhs_is_imm)                             { ret 1; }
    if (fused.dbg_bindings[0].vreg != 0)                              { ret 1; }
    if (fused.dbg_bindings[0].rhs_is_imm)                             { ret 1; }
    if (fused.dbg_bindings[0].vreg2 != 1)                             { ret 1; }
    # the compare's end binding is the fused branch's start: the compare is gone
    if (fused.dbg_bindings[0].at_end)      { ret 2; }
    if (fused.dbg_bindings[1].iid != 9)    { ret 1; }
    if (fused.dbg_bindings[1].cmp_op != 0) { ret 1; }
    if (fused.dbg_bindings[1].vreg != 1)   { ret 1; }
    ret 0;
}

test combine_cbr__declines_unsafe_shapes {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }

    var ccs: [6]u32;
    ccs[0] = codegen_mir.MIR_CMP_EQ;
    ccs[1] = codegen_mir.MIR_CMP_NE;
    ccs[2] = codegen_mir.MIR_CMP_LT_S;
    ccs[3] = codegen_mir.MIR_CMP_LT_U;
    ccs[4] = codegen_mir.MIR_CMP_LE_S;
    ccs[5] = codegen_mir.MIR_CMP_LE_U;
    var pack: RulePack;
    pack.name               = "test";
    pack.fused_cbr_ccs      = ?ccs[0];
    pack.fused_cbr_cc_count = 6;

    var cmp_ops: [3]codegen_mir.MirOperand;
    cmp_ops[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    cmp_ops[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    cmp_ops[2] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    var use_ops: [2]codegen_mir.MirOperand;
    use_ops[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(3));
    use_ops[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    var redef_ops: [2]codegen_mir.MirOperand;
    redef_ops[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    redef_ops[1] = codegen_mir.op_imm(4);
    var br_ops: [3]codegen_mir.MirOperand;
    br_ops[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    br_ops[1] = codegen_mir.op_block(5);
    br_ops[2] = codegen_mir.op_block(9);

    var instrs: [3]codegen_mir.MirInstr;
    var blk:    codegen_mir.MirBlock;
    var f:      codegen_mir.MirFunction;

    var zi: u32 = 0;
    for (zi < 3) {
        instrs[zi].vec_lane          = 0;
        instrs[zi].dbg_bindings      = nil;
        instrs[zi].dbg_binding_count = 0;
        zi                           = zi + 1;
    }
    instrs[0].opcode        = codegen_mir.MIR_CMP_EQ;
    instrs[0].operands      = ?cmp_ops[0];
    instrs[0].operand_count = 3;
    instrs[1].opcode        = codegen_mir.MIR_MOV;
    instrs[1].operands      = ?use_ops[0];
    instrs[1].operand_count = 2;
    instrs[2].opcode        = codegen_mir.MIR_CBR;
    instrs[2].operands      = ?br_ops[0];
    instrs[2].operand_count = 3;
    t_function(?blk, ?instrs[0], 3, ?f);
    f.vreg_count = 4;
    val combine_cbr_r: err[fail.Fail] = combine_cbr(?pack, ?backing, ?f);
    if (sel combine_cbr_r.err)                   { ret 1; }
    if (blk.instr_count != 3)                    { ret 1; }
    if (instrs[2].opcode != codegen_mir.MIR_CBR) { ret 1; }

    instrs[1].operands      = ?redef_ops[0];
    instrs[1].operand_count = 2;
    val combine_cbr_r2: err[fail.Fail] = combine_cbr(?pack, ?backing, ?f);
    if (sel combine_cbr_r2.err)                  { ret 2; }
    if (blk.instr_count != 3)                    { ret 2; }
    if (instrs[2].opcode != codegen_mir.MIR_CBR) { ret 2; }

    var blocks: [2]codegen_mir.MirBlock;
    blocks[0].id          = 0;
    blocks[0].instrs      = ?instrs[0];
    blocks[0].instr_count = 1;
    blocks[0].instr_cap   = 1;
    blocks[1].id          = 1;
    blocks[1].instrs      = ?instrs[2];
    blocks[1].instr_count = 1;
    blocks[1].instr_cap   = 1;
    f.blocks              = ?blocks[0];
    f.block_count         = 2;
    val combine_cbr_r3: err[fail.Fail] = combine_cbr(?pack, ?backing, ?f);
    if (sel combine_cbr_r3.err)                  { ret 3; }
    if (blocks[0].instr_count != 1)              { ret 3; }
    if (instrs[2].opcode != codegen_mir.MIR_CBR) { ret 3; }

    instrs[0].opcode        = codegen_mir.MIR_CMP_EQ;
    instrs[1].opcode        = codegen_mir.MIR_CBR;
    instrs[1].operands      = ?br_ops[0];
    instrs[1].operand_count = 3;
    instrs[1].vec_lane      = 0;
    instrs[0].vec_lane      = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4);
    t_function(?blk, ?instrs[0], 2, ?f);
    f.vreg_count = 4;
    val combine_cbr_r4: err[fail.Fail] = combine_cbr(?pack, ?backing, ?f);
    if (sel combine_cbr_r4.err)                  { ret 4; }
    if (blk.instr_count != 2)                    { ret 4; }
    if (instrs[1].opcode != codegen_mir.MIR_CBR) { ret 4; }
    instrs[0].vec_lane = 0;

    pack.fused_cbr_cc_count = 1;
    ccs[0]                  = codegen_mir.MIR_CMP_NE;
    val combine_cbr_r5: err[fail.Fail] = combine_cbr(?pack, ?backing, ?f);
    if (sel combine_cbr_r5.err)                  { ret 5; }
    if (blk.instr_count != 2)                    { ret 5; }
    if (instrs[1].opcode != codegen_mir.MIR_CBR) { ret 5; }
    ret 0;
}

test capture_operand_banks__checks_opcode_before_preserving_type {
    var ops: [3]codegen_mir.MirOperand;
    ops[0] = codegen_mir.op_preg(codegen_mir.preg_id(1));
    ops[1] = codegen_mir.op_preg(codegen_mir.preg_id(2));
    ops[2] = codegen_mir.op_preg(codegen_mir.preg_id(3));
    var mi:                      codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_FADD, ?ops[0], 3, 8, 8);
    var f:                       codegen_mir.MirFunction;
    val capture_operand_banks_r: err[fail.Fail]       = capture_operand_banks(?f, ?mi);
    if (sel capture_operand_banks_r.ok) { ret 1; }
    var k: u32 = 0;
    for (k < 3) {
        ops[k] = codegen_mir.op_preg(codegen_mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, k::i32)));
        k      = k + 1;
    }
    val capture_operand_banks_r2: err[fail.Fail] = capture_operand_banks(?f, ?mi);
    if (sel capture_operand_banks_r2.err) { ret 2; }
    mi.opcode        = codegen_mir.MIR_FP_TO_SI;
    mi.operand_count = 2;
    val capture_operand_banks_r3: err[fail.Fail] = capture_operand_banks(?f, ?mi);
    if (sel capture_operand_banks_r3.ok) { ret 3; }
    ops[0] = codegen_mir.op_preg(codegen_mir.preg_id(1));
    val capture_operand_banks_r4: err[fail.Fail] = capture_operand_banks(?f, ?mi);
    if (sel capture_operand_banks_r4.err)                                                           { ret 4; }
    if (ops[0].required_bank != codegen_mir.BANK_GP || ops[1].required_bank != codegen_mir.BANK_FP) { ret 5; }
    ops[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    val capture_operand_banks_r5: err[fail.Fail] = capture_operand_banks(?f, ?mi);
    if (sel capture_operand_banks_r5.ok) { ret 6; }
    var vregs: [1]codegen_mir.MirVReg;
    vregs[0]     = codegen_mir.vreg(0, codegen_mir.REG_CLASS_GP, 0, false);
    f.vregs      = ?vregs[0];
    f.vreg_count = 1;
    val capture_operand_banks_r6: err[fail.Fail] = capture_operand_banks(?f, ?mi);
    if (sel capture_operand_banks_r6.err)            { ret 7; }
    if (ops[0].required_bank != codegen_mir.BANK_GP) { ret 8; }
    ret 0;
}

test emit_instr__new_registers_require_a_bank {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var f:       codegen_mir.MirFunction;
    var source:  codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_ADD, nil, 0, 0, 0);
    var dst:     [2]codegen_mir.MirInstr;
    var builder: ExpansionBuilder;
    builder.allocator = ?alloc;
    builder.function  = ?f;
    builder.source    = ?source;
    builder.dst       = ?dst[0];
    builder.limit     = 2;
    fin {
        var i: u32 = 0;
        for (i < builder.emitted) {
            A.deallocate[codegen_mir.MirOperand](?alloc, dst[i].operands, dst[i].operand_count::usize);
            i = i + 1;
        }
    }
    var ops: [2]codegen_mir.MirOperand;
    ops[0] = codegen_mir.op_preg(codegen_mir.preg_id(1));
    ops[1] = codegen_mir.op_imm(0);
    val emit_r: res[*codegen_mir.MirInstr, fail.Fail] = emit_instr(?builder, 900, ?ops[0], 2);
    if (sel emit_r.ok)                               { ret 2; }
    if (builder.emitted != 0 || builder.cursor != 0) { ret 3; }
    ops[0].required_bank = codegen_mir.BANK_GP;
    val emit_r2: res[*codegen_mir.MirInstr, fail.Fail] = emit_instr(?builder, 900, ?ops[0], 2);
    if (sel emit_r2.err)                                         { ret 4; }
    if (dst[0].operands[0].required_bank != codegen_mir.BANK_GP) { ret 5; }
    ops[0].required_bank = codegen_mir.BANK_FP;
    val emit_r3: res[*codegen_mir.MirInstr, fail.Fail] = emit_instr(?builder, 900, ?ops[0], 2);
    if (sel emit_r3.ok)                              { ret 6; }
    if (builder.emitted != 1 || builder.cursor != 1) { ret 7; }
    ret 0;
}
