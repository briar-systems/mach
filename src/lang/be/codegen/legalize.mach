use std.types.bool.bool;
use std.types.result.res;
use std.types.error.err;
use mach.lang.fail;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use page: std.allocator.page;
use format: std.format;

use A: std.allocator;

use mach.lang.be.codegen.mir;
use mach.lang.target.isa;
use target: mach.lang.target.resolved;

rec Machine {
    lane_width: u8;
    ptr_width:  u8;
    var_shift:  bool;
    has_mul:    bool;
    mul_hi:     u8;
    stage_lo:   i32;
    stage_hi:   i32;
    fp_class:   u32;
}

val FP_CLASS_NONE: u32 = 0xFFFFFFFF;

fun float_class_of(tgt: *target.Target) u32 {
    if (tgt.model.reg_classes == nil) { ret FP_CLASS_NONE; }
    var i: u32 = 0;
    for (i < tgt.model.reg_class_len) {
        if (tgt.model.reg_classes[i].kind == isa.RC_FLOAT) { ret i; }
        i = i + 1;
    }
    ret FP_CLASS_NONE;
}

rec LanePlan {
    lane_base:  *u32;
    lane_count: *u8;
    orig_count: u32;
    lane_width: u8;
    mach:       Machine;
}

val LANE_NONE: u32 = 0xFFFFFFFF;

pub fun run(tgt: *target.Target, m: *mir.MirModule) err[fail.Fail] {
    if (tgt == nil) { ret err[fail.Fail].err{fail.message("legalize: nil target")}; }
    if (m == nil)   { ret err[fail.Fail].err{fail.message("legalize: nil mir module")}; }

    val maw: u32 = tgt.model.max_alu_width;
    if (maw == 0) { ret err[fail.Fail].ok{}; }

    var mach: Machine;
    mach.lane_width = maw::u8;
    mach.ptr_width  = tgt.model.pointer_width::u8;
    mach.var_shift  = tgt.model.has_var_shift;
    mach.has_mul    = tgt.model.has_mul;
    mach.mul_hi     = tgt.model.mul_hi_width::u8;
    mach.stage_lo   = -1;
    mach.stage_hi   = -1;
    mach.fp_class   = float_class_of(tgt);
    if (tgt.arch != nil) {
        mach.stage_lo = tgt.arch.scratch_reg;
        mach.stage_hi = tgt.arch.scratch_reg2;
    }

    var i: u32 = 0;
    for (i < m.function_len) {
        val res_fn: err[fail.Fail] = legalize_function(m.alloc, ?mach, ?m.functions[i]);
        if (sel res_fn.err) { ret res_fn; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun function_needs_legalize(f: *mir.MirFunction, mach: *Machine) bool {
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val b: *mir.MirBlock = ?f.blocks[bi];
        var ii: u32 = 0;
        for (ii < b.instr_count) {
            if (instr_needs_legalize(f, ?b.instrs[ii], mach)) { ret true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

fun instr_needs_legalize(f: *mir.MirFunction, mi: *mir.MirInstr, mach: *Machine) bool {
    if (conv_is_wide(mach, mi)) { ret true; }
    if (instr_rides_fp_bank(f, mi)) { ret false; }
    if (mi.width > mach.lane_width || mi.src_width > mach.lane_width) { ret true; }
    if (!mach.var_shift && is_shift(mi.opcode)) { ret true; }
    if (!mach.has_mul && mi.opcode == mir.MIR_MUL) { ret true; }
    ret mach.ptr_width > mach.lane_width && instr_has_value_base(mi);
}

fun is_shift(op: mir.MirOpcode) bool {
    ret mir.has(op, mir.MIRF_SHIFT);
}


fun instr_has_value_base(mi: *mir.MirInstr) bool {
    var k: u32 = 0;
    for (k < mi.operand_count) {
        val op: *mir.MirOperand = ?mi.operands[k];
        if (op.kind == mir.MIR_OP_MEM && !mir.vreg_is_nil(op.vreg)) { ret true; }
        k = k + 1;
    }
    ret false;
}

fun instr_rides_fp_bank(f: *mir.MirFunction, mi: *mir.MirInstr) bool {
    if (mi.vec_lane != mir.VEC_LANE_NONE) { ret true; }
    var k: u32 = 0;
    for (k < mi.operand_count) {
        val op: *mir.MirOperand = ?mi.operands[k];
        if (op.kind == mir.MIR_OP_VREG && op.vreg.n < f.vreg_count) {
            if (f.vregs[op.vreg.n].vector)    { ret true; }
            if (mir.vreg_is_fp(f, op.vreg)) { ret true; }
        }
        k = k + 1;
    }
    ret false;
}

fun legalize_function(alloc: *A.Allocator, mach: *Machine, f: *mir.MirFunction) err[fail.Fail] {
    if (!function_needs_legalize(f, mach)) { ret err[fail.Fail].ok{}; }

    var plan: LanePlan;
    val res_plan: err[fail.Fail] = plan_lanes(alloc, mach, f, ?plan);
    if (sel res_plan.err) { ret res_plan; }

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val res_b: err[fail.Fail] = legalize_block(alloc, ?plan, f, ?f.blocks[bi]);
        if (sel res_b.err) { free_plan(alloc, ?plan); ret res_b; }
        bi = bi + 1;
    }

    free_plan(alloc, ?plan);
    ret err[fail.Fail].ok{};
}

fun plan_lanes(alloc: *A.Allocator, mach: *Machine, f: *mir.MirFunction, out: *LanePlan) err[fail.Fail] {
    val maw: u8 = mach.lane_width;
    val n: u32 = f.vreg_count;
    val res_base: res[*u32, A.Error] = A.allocate[u32](alloc, n::usize);
    if (sel res_base.err) { ret err[fail.Fail].err{fail.refused(res_base.err)}; }
    val res_cnt: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel res_cnt.err) {
        A.deallocate[u32](alloc, res_base.ok, n::usize);
        ret err[fail.Fail].err{fail.refused(res_cnt.err)};
    }
    out.lane_base  = res_base.ok;
    out.lane_count = res_cnt.ok;
    out.orig_count = n;
    out.lane_width = maw;
    out.mach       = @mach;

    var v: u32 = 0;
    for (v < n) {
        out.lane_base[v]  = LANE_NONE;
        out.lane_count[v] = 0;
        v = v + 1;
    }

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val b: *mir.MirBlock = ?f.blocks[bi];
        var ii: u32 = 0;
        for (ii < b.instr_count) {
            val mi: *mir.MirInstr = ?b.instrs[ii];
            val conv_dst: bool = conv_is_wide(mach, mi) &&
                                 mi.operand_count > 0 &&
                                 mi.operands[0].kind == mir.MIR_OP_VREG &&
                                 !mir.vreg_is_fp(f, mi.operands[0].vreg);
            if ((!instr_rides_fp_bank(f, mi) || conv_dst) && mir.instr_defines_shape(mi) &&
                !mir.is_cmp_opcode(mi.opcode) &&
                mi.width > maw && mi.operand_count > 0 &&
                mi.operands[0].kind == mir.MIR_OP_VREG) {
                val dv: u32 = mi.operands[0].vreg.n;
                if (dv < n && out.lane_base[dv] == LANE_NONE) {
                    val nlanes: u32 = (mi.width / maw)::u32;
                    val res_l: res[u32, fail.Fail] = alloc_lanes(alloc, f, dv, nlanes);
                    if (sel res_l.err) {
                        free_plan(alloc, out);
                        ret err[fail.Fail].err{res_l.err};
                    }
                    out.lane_base[dv]  = res_l.ok;
                    out.lane_count[dv] = nlanes::u8;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun alloc_lanes(alloc: *A.Allocator, f: *mir.MirFunction, wide: u32, nlanes: u32) res[u32, fail.Fail] {
    val cls: u32 = f.vregs[wide].class;
    var base: u32 = mir.MIR_VREG_NIL.n;
    var i: u32 = 0;
    for (i < nlanes) {
        val res_v: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, cls);
        if (sel res_v.err) { ret res[u32, fail.Fail].err{res_v.err}; }
        val vid: u32 = res_v.ok.n;
        # a lane is the wide value: the seed the validator and the allocator read must follow it
        f.vregs[vid].secret = f.vregs[wide].secret;
        if (i == 0) { base = vid; }
        i = i + 1;
    }
    ret res[u32, fail.Fail].ok{base};
}

fun new_vreg(alloc: *A.Allocator, f: *mir.MirFunction, cls: u32) res[mir.VRegId, fail.Fail] {
    if (f.vreg_count >= f.vreg_cap) {
        var new_cap: u32 = f.vreg_cap * 2;
        if (new_cap == 0) { new_cap = mir.INITIAL_VREG_CAP; }
        val res_v: res[*mir.MirVReg, A.Error] = A.reallocate[mir.MirVReg](alloc, f.vregs, f.vreg_cap::usize, new_cap::usize);
        if (sel res_v.err) { ret res[mir.VRegId, fail.Fail].err{fail.refused(res_v.err)}; }
        f.vregs    = res_v.ok;
        f.vreg_cap = new_cap;
    }
    val vid: u32 = f.vreg_count;
    f.vregs[vid] = mir.vreg(vid, cls, false, false);
    f.vreg_count = f.vreg_count + 1;
    ret res[mir.VRegId, fail.Fail].ok{mir.vreg_id(vid)};
}

fun free_plan(alloc: *A.Allocator, plan: *LanePlan) {
    if (plan.lane_base != nil)  { A.deallocate[u32](alloc, plan.lane_base, plan.orig_count::usize); plan.lane_base = nil; }
    if (plan.lane_count != nil) { A.deallocate[u8](alloc, plan.lane_count, plan.orig_count::usize); plan.lane_count = nil; }
}

fun legalize_block(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, b: *mir.MirBlock) err[fail.Fail] {
    val n: u32 = b.instr_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    var total:        u32  = 0;
    var needs_expand: bool = false;
    var i: u32 = 0;
    for (i < n) {
        val mi: *mir.MirInstr = ?b.instrs[i];
        if (instr_needs_legalize(f, mi, ?plan.mach)) {
            val res_c: res[u32, fail.Fail] = expansion_count(alloc, plan, f, mi);
            if (sel res_c.err) { ret err[fail.Fail].err{res_c.err}; }
            total = total + res_c.ok;
            needs_expand = true;
        }
        or { total = total + 1; }
        i = i + 1;
    }

    if (!needs_expand) { ret err[fail.Fail].ok{}; }

    val res_dst: res[*mir.MirInstr, A.Error] = A.zallocate[mir.MirInstr](alloc, total::usize);
    if (sel res_dst.err) { ret err[fail.Fail].err{fail.refused(res_dst.err)}; }
    val dst: *mir.MirInstr = res_dst.ok;

    var w: u32 = 0;
    i = 0;
    for (i < n) {
        val mi: *mir.MirInstr = ?b.instrs[i];
        if (instr_needs_legalize(f, mi, ?plan.mach)) {
            val res_e: err[fail.Fail] = expand_instr(alloc, plan, f, mi, dst, ?w);
            if (sel res_e.err) {
                free_pieces(alloc, dst, w);
                A.deallocate[mir.MirInstr](alloc, dst, total::usize);
                ret res_e;
            }
            free_source_operands(alloc, mi);
        }
        or {
            dst[w] = @mi;
            w = w + 1;
        }
        i = i + 1;
    }

    if (w != total) {
        free_pieces(alloc, dst, w);
        A.deallocate[mir.MirInstr](alloc, dst, total::usize);
        ret err[fail.Fail].err{fail.message("legalize: an expansion emitted a different number of pieces than it counted (internal compiler error, see briar-systems/mach#2778)")};
    }

    if (b.instrs != nil && b.instr_cap > 0) {
        A.deallocate[mir.MirInstr](alloc, b.instrs, b.instr_cap::usize);
    }
    b.instrs      = dst;
    b.instr_count = w;
    b.instr_cap   = total;
    ret err[fail.Fail].ok{};
}

fun free_pieces(alloc: *A.Allocator, dst: *mir.MirInstr, count: u32) {
    var i: u32 = 0;
    for (i < count) {
        if (dst[i].operands != nil && dst[i].operand_count > 0) {
            A.deallocate[mir.MirOperand](alloc, dst[i].operands, dst[i].operand_count::usize);
        }
        i = i + 1;
    }
}

fun free_source_operands(alloc: *A.Allocator, mi: *mir.MirInstr) {
    if (mi.operands != nil && mi.operand_count > 0) {
        A.deallocate[mir.MirOperand](alloc, mi.operands, mi.operand_count::usize);
    }
    mi.operands      = nil;
    mi.operand_count = 0;
    if (mi.dbg_bindings != nil && mi.dbg_binding_count > 0) {
        A.deallocate[mir.MirDbgBinding](alloc, mi.dbg_bindings, mi.dbg_binding_count::usize);
    }
    mi.dbg_bindings      = nil;
    mi.dbg_binding_count = 0;
}

fun expansion_count(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction,
                    mi: *mir.MirInstr) res[u32, fail.Fail] {
    val op: mir.MirOpcode = mi.opcode;
    val nl: u32 = wide_lane_count(plan, mi);

    if (conv_is_wide(?plan.mach, mi)) { ret conv_piece_count(alloc, plan, f, mi); }

    if (instr_is_memory(mi)) { ret memory_piece_count(alloc, plan, mi); }

    if (op == mir.MIR_AND || op == mir.MIR_OR || op == mir.MIR_XOR || op == mir.MIR_NOT) {
        ret res[u32, fail.Fail].ok{nl};
    }
    if (is_shift(op)) { ret shift_piece_count(alloc, plan, mi); }
    if (op == mir.MIR_MOV || op == mir.MIR_DECLASSIFY || op == mir.MIR_BITCAST) {
        ret res[u32, fail.Fail].ok{nl};
    }
    if (op == mir.MIR_ADD || op == mir.MIR_SUB || op == mir.MIR_NEG) {
        ret res[u32, fail.Fail].ok{addsub_chain_piece_count(nl)};
    }
    if (op == mir.MIR_ZEXT) {
        ret res[u32, fail.Fail].ok{dst_lane_count(plan, mi)};
    }
    if (op == mir.MIR_SEXT) {
        val dl: u32 = dst_lane_count(plan, mi);
        val sl: u32 = src_lane_count(plan, mi);
        var n: u32 = dl;
        if (dl > sl) { n = n + 1; }
        ret res[u32, fail.Fail].ok{n};
    }
    if (op == mir.MIR_TRUNC) {
        ret res[u32, fail.Fail].ok{dst_lane_count(plan, mi)};
    }
    if (op == mir.MIR_MUL) { ret mul_piece_count(alloc, plan, mi); }
    if (op == mir.MIR_DIV_S || op == mir.MIR_DIV_U ||
        op == mir.MIR_REM_S || op == mir.MIR_REM_U) {
        ret divmod_piece_count(alloc, plan, mi);
    }
    if (mir.is_cmp_opcode(op)) { ret cmp_piece_count(alloc, plan, mi); }
    ret res[u32, fail.Fail].err{fail.message(unsupported_message(alloc, op, mi.width))};
}

fun wide_lane_count(plan: *LanePlan, mi: *mir.MirInstr) u32 {
    var wbytes: u8 = mi.width;
    if (mi.src_width > wbytes) { wbytes = mi.src_width; }
    var n: u32 = (wbytes / plan.lane_width)::u32;
    if (n == 0) { n = 1; }
    ret n;
}

fun instr_is_memory(mi: *mir.MirInstr) bool {
    if (!mir.has(mi.opcode, mir.MIRF_ADDRESSED)) { ret false; }
    ret addr_operand_index(mi) >= 0;
}

fun addr_operand_index(mi: *mir.MirInstr) i32 {
    val sym_is_addr: bool = mir.has(mi.opcode, mir.MIRF_MEMORY);
    var k: u32 = 0;
    for (k < mi.operand_count) {
        val kind: mir.MirOperandKind = mi.operands[k].kind;
        if (kind == mir.MIR_OP_MEM) { ret k::i32; }
        if (kind == mir.MIR_OP_SYM && sym_is_addr) { ret k::i32; }
        k = k + 1;
    }
    ret -1;
}

fun addr_displaced(base: *mir.MirOperand, off: i64) mir.MirOperand {
    var o: mir.MirOperand = @base;
    if (o.kind == mir.MIR_OP_SYM) { o.sym_off = base.sym_off + off::i32; ret o; }
    o.imm = base.imm + off;
    ret o;
}

fun base_needs_staging(plan: *LanePlan, mem: *mir.MirOperand) bool {
    ret !mir.vreg_is_nil(mem.vreg) && mem.vreg.n < plan.orig_count &&
        plan.lane_base[mem.vreg.n] != LANE_NONE;
}

fun memory_piece_count(alloc: *A.Allocator, plan: *LanePlan, mi: *mir.MirInstr) res[u32, fail.Fail] {
    if (mi.operand_count != 2) { ret res[u32, fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))}; }
    val mx: i32 = addr_operand_index(mi);
    val vx: u32 = 1 - mx::u32;
    var n: u32 = wide_lane_count(plan, mi);
    if (!operand_is_lane_ready(plan, ?mi.operands[vx], n)) {
        ret res[u32, fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))};
    }
    val mem: *mir.MirOperand = ?mi.operands[mx::u32];
    if (base_needs_staging(plan, mem)) {
        val pl: u32 = plan.lane_count[mem.vreg.n]::u32;
        if (pl != 2 || plan.mach.stage_lo < 0 || plan.mach.stage_hi < 0) {
            ret res[u32, fail.Fail].err{fail.message("legalize: a runtime pointer needs a two-register address-staging pair this target does not reserve")};
        }
        n = n + pl;
    }
    ret res[u32, fail.Fail].ok{n};
}

fun expand_memory(alloc: *A.Allocator, plan: *LanePlan, mi: *mir.MirInstr,
                  dst: *mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val rc: res[u32, fail.Fail] = memory_piece_count(alloc, plan, mi);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }

    val mx:  u32 = addr_operand_index(mi)::u32;
    val vx:  u32 = 1 - mx;
    val lw:  u8  = plan.lane_width;
    val nl:  u32 = wide_lane_count(plan, mi);
    val is_store: bool = mx == 0;

    var base: mir.MirOperand = mi.operands[mx];
    if (base_needs_staging(plan, ?base)) {
        val lo: u32 = plan.lane_base[base.vreg.n];
        val r1: err[fail.Fail] = emit_stage_move(alloc, dst, cursor, mi, plan.mach.stage_lo, lo, lw);
        if (sel r1.err) { ret r1; }
        val r2: err[fail.Fail] = emit_stage_move(alloc, dst, cursor, mi, plan.mach.stage_hi, lo + 1, lw);
        if (sel r2.err) { ret r2; }
        base = mir.op_mem_preg(mir.preg_id(plan.mach.stage_lo), base.imm);
    }

    var i: u32 = 0;
    for (i < nl) {
        val mem: mir.MirOperand = addr_displaced(?base, (i * lw::u32)::i64);
        var ops: [2]mir.MirOperand;
        var opcode: mir.MirOpcode = mir.MIR_LOAD;
        if (is_store) {
            opcode = mir.MIR_STORE;
            ops[0] = mem;
            ops[1] = lane_operand(plan, ?mi.operands[vx], i);
        } or {
            ops[0] = lane_operand(plan, ?mi.operands[vx], i);
            ops[1] = mem;
        }
        val r: err[fail.Fail] = emit_piece(alloc, dst, cursor, mi, opcode, ?ops[0], 2, lw);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun emit_stage_move(alloc: *A.Allocator, dst: *mir.MirInstr, cursor: *u32, src: *mir.MirInstr,
                    preg: i32, lane: u32, lw: u8) err[fail.Fail] {
    var ops: [2]mir.MirOperand;
    ops[0] = mir.op_preg(mir.preg_id(preg));
    ops[1] = mir.op_vreg(mir.vreg_id(lane));
    ret emit_piece(alloc, dst, cursor, src, mir.MIR_MOV, ?ops[0], 2, lw);
}

fun expand_instr(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
                 dst: *mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val op: mir.MirOpcode = mi.opcode;

    if (conv_is_wide(?plan.mach, mi)) {
        ret conv_run(alloc, plan, f, mi, dst, cursor);
    }
    if (instr_is_memory(mi)) {
        ret expand_memory(alloc, plan, mi, dst, cursor);
    }
    if (op == mir.MIR_AND || op == mir.MIR_OR || op == mir.MIR_XOR) {
        ret expand_bitwise(alloc, plan, mi, dst, cursor);
    }
    if (op == mir.MIR_NOT) {
        ret expand_not(alloc, plan, mi, dst, cursor);
    }
    if (is_shift(op)) {
        ret expand_shift(alloc, plan, f, mi, dst, cursor);
    }
    if (op == mir.MIR_MOV || op == mir.MIR_DECLASSIFY || op == mir.MIR_BITCAST) {
        ret expand_mov(alloc, plan, mi, dst, cursor);
    }
    if (op == mir.MIR_ADD || op == mir.MIR_SUB) {
        ret expand_addsub(alloc, plan, f, mi, dst, cursor, op == mir.MIR_SUB);
    }
    if (op == mir.MIR_NEG) {
        ret expand_neg(alloc, plan, f, mi, dst, cursor);
    }
    if (op == mir.MIR_MUL) {
        ret expand_mul(alloc, plan, f, mi, dst, cursor);
    }
    if (op == mir.MIR_DIV_S || op == mir.MIR_DIV_U ||
        op == mir.MIR_REM_S || op == mir.MIR_REM_U) {
        ret expand_divmod(alloc, plan, f, mi, dst, cursor);
    }
    if (mir.is_cmp_opcode(op)) {
        ret expand_cmp(alloc, plan, f, mi, dst, cursor);
    }
    if (op == mir.MIR_ZEXT) {
        ret expand_zext(alloc, plan, mi, dst, cursor);
    }
    if (op == mir.MIR_SEXT) {
        ret expand_sext(alloc, plan, f, mi, dst, cursor);
    }
    if (op == mir.MIR_TRUNC) {
        ret expand_trunc(alloc, plan, mi, dst, cursor);
    }
    ret err[fail.Fail].err{fail.message(unsupported_message(alloc, op, mi.width))};
}

fun emit_piece(alloc: *A.Allocator, dst: *mir.MirInstr, cursor: *u32, src: *mir.MirInstr,
               opcode: mir.MirOpcode, ops: *mir.MirOperand, nops: u32, width: u8) err[fail.Fail] {
    if (src.vec_lane != mir.VEC_LANE_NONE) {
        ret err[fail.Fail].err{fail.message("internal compiler error: width legalization cannot expand a vector-lane instruction without a lane-aware piece emitter; vec_lane would be silently dropped")};
    }
    var arr: *mir.MirOperand = nil;
    if (nops > 0) {
        val res_a: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](alloc, nops::usize);
        if (sel res_a.err) { ret err[fail.Fail].err{fail.refused(res_a.err)}; }
        arr = res_a.ok;
        var j: u32 = 0;
        for (j < nops) { arr[j] = ops[j]; j = j + 1; }
    }
    val ci: u32 = @cursor;
    dst[ci] = mir.instr(opcode, arr, nops, width, width);
    val p: *mir.MirInstr = ?dst[ci];
    p.loc           = src.loc;
    p.inline_site   = src.inline_site;
    p.writes_secret = src.writes_secret;
    p.memory_flags = src.memory_flags;
    @cursor = ci + 1;
    ret err[fail.Fail].ok{};
}

fun lane_operand(plan: *LanePlan, op: *mir.MirOperand, i: u32) mir.MirOperand {
    if (op.kind == mir.MIR_OP_VREG && op.vreg.n < plan.orig_count && plan.lane_base[op.vreg.n] != LANE_NONE) {
        ret mir.op_vreg(mir.vreg_id(plan.lane_base[op.vreg.n] + i));
    }
    if (op.kind == mir.MIR_OP_IMM) {
        ret mir.op_imm(imm_lane(op.imm, i, plan.lane_width));
    }
    if (op.kind == mir.MIR_OP_PREG) {
        ret mir.op_preg(mir.preg_id(mir.preg_regid(op.preg) + i::i32));
    }
    ret @op;
}

fun operand_is_lane_ready(plan: *LanePlan, op: *mir.MirOperand, nl: u32) bool {
    if (op.kind == mir.MIR_OP_VREG) {
        if (op.vreg.n < plan.orig_count && plan.lane_base[op.vreg.n] != LANE_NONE) { ret true; }
        ret nl == 1;
    }
    ret op.kind == mir.MIR_OP_IMM || op.kind == mir.MIR_OP_PREG;
}

fun imm_lane(imm: i64, i: u32, w: u8) i64 {
    val shift: i64 = (i * w::u32)::i64 * 8;
    val mask:  i64 = (1::i64 << (w::i64 * 8)) - 1;
    ret (imm >> shift) & mask;
}

fun operands_are_lane_ready(plan: *LanePlan, mi: *mir.MirInstr, start: u32) bool {
    var k: u32 = start;
    for (k < mi.operand_count) {
        val op: *mir.MirOperand = ?mi.operands[k];
        val is_wide_vreg: bool = op.kind == mir.MIR_OP_VREG && op.vreg.n < plan.orig_count &&
                                 plan.lane_base[op.vreg.n] != LANE_NONE;
        if (!is_wide_vreg && op.kind != mir.MIR_OP_IMM) { ret false; }
        k = k + 1;
    }
    ret true;
}

fun expand_bitwise(alloc: *A.Allocator, plan: *LanePlan, mi: *mir.MirInstr,
                   dst: *mir.MirInstr, cursor: *u32) err[fail.Fail] {
    if (mi.operand_count != 3 || !operands_are_lane_ready(plan, mi, 1)) {
        ret err[fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))};
    }
    val nl: u32 = wide_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;
    var i: u32 = 0;
    for (i < nl) {
        var ops: [3]mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        ops[1] = lane_operand(plan, ?mi.operands[1], i);
        ops[2] = lane_operand(plan, ?mi.operands[2], i);
        val r: err[fail.Fail] = emit_piece(alloc, dst, cursor, mi, mi.opcode, ?ops[0], 3, lw);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_not(alloc: *A.Allocator, plan: *LanePlan, mi: *mir.MirInstr,
               dst: *mir.MirInstr, cursor: *u32) err[fail.Fail] {
    if (mi.operand_count != 2 || !operands_are_lane_ready(plan, mi, 1)) {
        ret err[fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))};
    }
    val nl: u32 = wide_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;
    var i: u32 = 0;
    for (i < nl) {
        var ops: [2]mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        ops[1] = lane_operand(plan, ?mi.operands[1], i);
        val r: err[fail.Fail] = emit_piece(alloc, dst, cursor, mi, mir.MIR_NOT, ?ops[0], 2, lw);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_mov(alloc: *A.Allocator, plan: *LanePlan, mi: *mir.MirInstr,
               dst: *mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val nl: u32 = wide_lane_count(plan, mi);
    if (mi.operand_count != 2 || !operand_is_lane_ready(plan, ?mi.operands[0], nl) ||
        !operand_is_lane_ready(plan, ?mi.operands[1], nl)) {
        ret err[fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))};
    }
    val lw: u8  = plan.lane_width;
    # a declassify is the taint barrier; its lanes must stay one or the barrier is gone
    var piece_op: mir.MirOpcode = mir.MIR_MOV;
    if (mi.opcode == mir.MIR_DECLASSIFY) { piece_op = mir.MIR_DECLASSIFY; }
    var i: u32 = 0;
    for (i < nl) {
        var ops: [2]mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        ops[1] = lane_operand(plan, ?mi.operands[1], i);
        val r: err[fail.Fail] = emit_piece(alloc, dst, cursor, mi, piece_op, ?ops[0], 2, lw);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_addsub(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
                  dst: *mir.MirInstr, cursor: *u32, is_sub: bool) err[fail.Fail] {
    if (mi.operand_count != 3 || !operands_are_lane_ready(plan, mi, 1) ||
        mi.operands[0].kind != mir.MIR_OP_VREG || plan.lane_base[mi.operands[0].vreg.n] == LANE_NONE) {
        ret err[fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))};
    }
    val nl: u32 = wide_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;

    var d_ops: [MAX_SHIFT_LANES]mir.MirOperand;
    var a_ops: [MAX_SHIFT_LANES]mir.MirOperand;
    var b_ops: [MAX_SHIFT_LANES]mir.MirOperand;
    var i: u32 = 0;
    for (i < nl) {
        d_ops[i] = lane_operand(plan, ?mi.operands[0], i);
        a_ops[i] = lane_operand(plan, ?mi.operands[1], i);
        b_ops[i] = lane_operand(plan, ?mi.operands[2], i);
        i = i + 1;
    }
    ret emit_addsub_chain(alloc, f, mi, dst, cursor, ?d_ops[0], ?a_ops[0], ?b_ops[0], nl, lw, is_sub);
}

fun emit_addsub_chain(alloc: *A.Allocator, f: *mir.MirFunction, src: *mir.MirInstr,
                      dst: *mir.MirInstr, cursor: *u32,
                      d_ops: *mir.MirOperand, a_ops: *mir.MirOperand, b_ops: *mir.MirOperand,
                      nl: u32, lw: u8, is_sub: bool) err[fail.Fail] {
    val mi: *mir.MirInstr = src;
    val cmp:  mir.MirOpcode = mir.MIR_CMP_LT_U;
    var op0:  mir.MirOpcode = mir.MIR_ADD;
    if (is_sub) { op0 = mir.MIR_SUB; }

    var carry: mir.VRegId = mir.MIR_VREG_NIL;
    var i: u32 = 0;
    for (i < nl) {
        val d: mir.MirOperand = d_ops[i];
        val a: mir.MirOperand = a_ops[i];
        val b: mir.MirOperand = b_ops[i];
        val is_low: bool = i == 0;
        val is_top: bool = i == nl - 1;

        if (is_low) {
            val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, op0, d, a, b, lw);
            if (sel r1.err) { ret r1; }
            val res_c: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel res_c.err) { ret err[fail.Fail].err{res_c.err}; }
            carry = res_c.ok;
            val cop: mir.MirOperand = mir.op_vreg(carry);
            var rc: err[fail.Fail];
            if (is_sub) { rc = emit_bin(alloc, dst, cursor, mi, cmp, cop, a, b, lw); }
            or          { rc = emit_bin(alloc, dst, cursor, mi, cmp, cop, d, a, lw); }
            if (sel rc.err) { ret rc; }
        }
        or (is_top) {
            val res_t: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel res_t.err) { ret err[fail.Fail].err{res_t.err}; }
            val t: mir.MirOperand = mir.op_vreg(res_t.ok);
            val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, op0, t, a, b, lw);
            if (sel r1.err) { ret r1; }
            val r2: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, op0, d, t, mir.op_vreg(carry), lw);
            if (sel r2.err) { ret r2; }
        }
        or {
            val res_t: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel res_t.err) { ret err[fail.Fail].err{res_t.err}; }
            val t: mir.MirOperand = mir.op_vreg(res_t.ok);
            val cin: mir.MirOperand = mir.op_vreg(carry);

            val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, op0, t, a, b, lw);
            if (sel r1.err) { ret r1; }

            val res_ct: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel res_ct.err) { ret err[fail.Fail].err{res_ct.err}; }
            val ct: mir.MirOperand = mir.op_vreg(res_ct.ok);
            var rct: err[fail.Fail];
            if (is_sub) { rct = emit_bin(alloc, dst, cursor, mi, cmp, ct, a, b, lw); }
            or          { rct = emit_bin(alloc, dst, cursor, mi, cmp, ct, t, a, lw); }
            if (sel rct.err) { ret rct; }

            val r3: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, op0, d, t, cin, lw);
            if (sel r3.err) { ret r3; }

            val res_cd: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel res_cd.err) { ret err[fail.Fail].err{res_cd.err}; }
            val cd: mir.MirOperand = mir.op_vreg(res_cd.ok);
            var rcd: err[fail.Fail];
            if (is_sub) { rcd = emit_bin(alloc, dst, cursor, mi, cmp, cd, t, cin, lw); }
            or          { rcd = emit_bin(alloc, dst, cursor, mi, cmp, cd, d, t, lw); }
            if (sel rcd.err) { ret rcd; }

            val res_co: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel res_co.err) { ret err[fail.Fail].err{res_co.err}; }
            val co: mir.VRegId = res_co.ok;
            val r5: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_OR, mir.op_vreg(co), ct, cd, lw);
            if (sel r5.err) { ret r5; }
            carry = co;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun addsub_chain_piece_count(nl: u32) u32 {
    if (nl <= 1) { ret 2; }
    ret 4 + 5 * (nl - 2);
}

fun expand_neg(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
               dst: *mir.MirInstr, cursor: *u32) err[fail.Fail] {
    if (mi.operand_count != 2 || !operands_are_lane_ready(plan, mi, 1) ||
        mi.operands[0].kind != mir.MIR_OP_VREG || plan.lane_base[mi.operands[0].vreg.n] == LANE_NONE) {
        ret err[fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))};
    }
    var sub: mir.MirInstr = @mi;
    var ops: [3]mir.MirOperand;
    ops[0] = mi.operands[0];
    ops[1] = mir.op_imm(0);
    ops[2] = mi.operands[1];
    sub.operands      = ?ops[0];
    sub.operand_count = 3;
    ret expand_addsub(alloc, plan, f, ?sub, dst, cursor, true);
}

val MAX_SHIFT_LANES: u32 = 8;

val SL_FILL: u32 = 0;
val SL_COPY: u32 = 1;
val SL_ONE:  u32 = 2;
val SL_SIGN: u32 = 3;
val SL_TWO:  u32 = 4;

fun shift_lane_kind(nl: u32, k: u32, r: u32, left: bool, arith: bool, i: u32,
                    a_out: *i32, b_out: *i32) u32 {
    @a_out = -1;
    @b_out = -1;
    if (left) {
        if (i < k) { ret SL_FILL; }
        val a: i32 = i::i32 - k::i32;
        @a_out = a;
        if (r == 0) { ret SL_COPY; }
        if (a == 0) { ret SL_ONE; }
        @b_out = a - 1;
        ret SL_TWO;
    }
    val a: i32 = i::i32 + k::i32;
    if (a >= nl::i32) { ret SL_FILL; }
    @a_out = a;
    if (r == 0) { ret SL_COPY; }
    if (a + 1 >= nl::i32) {
        if (arith) { ret SL_SIGN; }
        ret SL_ONE;
    }
    @b_out = a + 1;
    ret SL_TWO;
}

fun shift_kind_pieces(kind: u32) u32 {
    if (kind == SL_TWO) { ret 3; }
    ret 1;
}

fun const_shift_pieces(nl: u32, k: u32, r: u32, left: bool, arith: bool) u32 {
    var total: u32 = 0;
    var i: u32 = 0;
    for (i < nl) {
        var a: i32 = 0;
        var b: i32 = 0;
        total = total + shift_kind_pieces(shift_lane_kind(nl, k, r, left, arith, i, ?a, ?b));
        i = i + 1;
    }
    ret total;
}

fun needs_sign_fill(arith: bool, k: u32) bool {
    ret arith && k > 0;
}

fun shift_stage_count(bits: u32) u32 {
    if (bits == 0) { ret 0; }
    var s: u32 = 0;
    var w: u32 = bits;
    for (w > 1) {
        if ((w & 1) != 0) { ret 0; }
        w = w >> 1;
        s = s + 1;
    }
    ret s;
}

fun shift_piece_count(alloc: *A.Allocator, plan: *LanePlan, mi: *mir.MirInstr) res[u32, fail.Fail] {
    val nl: u32 = wide_lane_count(plan, mi);
    if (mi.operand_count != 3 || nl > MAX_SHIFT_LANES) {
        ret res[u32, fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))};
    }
    if (mi.operands[0].kind != mir.MIR_OP_VREG ||
        !operand_is_lane_ready(plan, ?mi.operands[0], nl) ||
        !operand_is_lane_ready(plan, ?mi.operands[1], nl) ||
        !operand_is_lane_ready(plan, ?mi.operands[2], 1)) {
        ret res[u32, fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))};
    }

    val lb:   u32 = plan.lane_width::u32 * 8;
    val bits: u32 = nl * lb;
    val stages: u32 = shift_stage_count(bits);
    if (stages == 0) {
        ret res[u32, fail.Fail].err{fail.message("legalize: a shift at a width that is not a power of two is unsupported on this target")};
    }

    val left:  bool = mi.opcode == mir.MIR_SHL;
    val arith: bool = mi.opcode == mir.MIR_SHR_S;

    if (mi.operands[2].kind == mir.MIR_OP_IMM) {
        val c: u32 = (mi.operands[2].imm & (bits - 1)::i64)::u32;
        var total: u32 = const_shift_pieces(nl, c / lb, c % lb, left, arith);
        if (needs_sign_fill(arith, c / lb)) { total = total + 1; }
        ret res[u32, fail.Fail].ok{total};
    }

    var total: u32 = 0;
    if (arith && nl > 1) { total = 1; }
    var j: u32 = 0;
    for (j < stages) {
        if (j == 0) { total = total + 1; }
        or          { total = total + 2; }
        total = total + 1;
        val c: u32 = 1 << j;
        total = total + const_shift_pieces(nl, c / lb, c % lb, left, arith);
        total = total + 3 * nl;
        j = j + 1;
    }
    ret res[u32, fail.Fail].ok{total};
}

fun emit_copy(alloc: *A.Allocator, dst: *mir.MirInstr, cursor: *u32, src: *mir.MirInstr,
              d: mir.MirOperand, a: mir.MirOperand, w: u8) err[fail.Fail] {
    var ops: [2]mir.MirOperand;
    ops[0] = d;
    ops[1] = a;
    ret emit_piece(alloc, dst, cursor, src, mir.MIR_MOV, ?ops[0], 2, w);
}

fun emit_const_shift(alloc: *A.Allocator, f: *mir.MirFunction, src: *mir.MirInstr,
                     dst: *mir.MirInstr, cursor: *u32,
                     in_ops: *mir.MirOperand, out_ops: *mir.MirOperand, nl: u32, lw: u8,
                     k: u32, r: u32, left: bool, arith: bool,
                     fill: mir.MirOperand) err[fail.Fail] {
    val lb: u32 = lw::u32 * 8;
    var step: i32 = 1;
    var i:    i32 = 0;
    if (left) {
        i    = nl::i32 - 1;
        step = -1;
    }
    for (i >= 0 && i < nl::i32) {
        var a: i32 = 0;
        var b: i32 = 0;
        val kind: u32 = shift_lane_kind(nl, k, r, left, arith, i::u32, ?a, ?b);
        val out:  mir.MirOperand = out_ops[i::u32];

        if (kind == SL_FILL) {
            val r1: err[fail.Fail] = emit_copy(alloc, dst, cursor, src, out, fill, lw);
            if (sel r1.err) { ret r1; }
        }
        or (kind == SL_COPY) {
            val r1: err[fail.Fail] = emit_copy(alloc, dst, cursor, src, out, in_ops[a::u32], lw);
            if (sel r1.err) { ret r1; }
        }
        or (kind == SL_ONE || kind == SL_SIGN) {
            var one: mir.MirOpcode = mir.MIR_SHR_U;
            if (left)            { one = mir.MIR_SHL; }
            or (kind == SL_SIGN) { one = mir.MIR_SHR_S; }
            val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, one, out,
                                                   in_ops[a::u32], mir.op_imm(r::i64), lw);
            if (sel r1.err) { ret r1; }
        }
        or {
            var nb: mir.MirOperand = fill;
            if (b >= 0) { nb = in_ops[b::u32]; }

            val rt1: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel rt1.err) { ret err[fail.Fail].err{rt1.err}; }
            val t1: mir.MirOperand = mir.op_vreg(rt1.ok);
            val rt2: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel rt2.err) { ret err[fail.Fail].err{rt2.err}; }
            val t2: mir.MirOperand = mir.op_vreg(rt2.ok);

            var main_op:  mir.MirOpcode = mir.MIR_SHR_U;
            var cross_op: mir.MirOpcode = mir.MIR_SHL;
            if (left) { main_op = mir.MIR_SHL; cross_op = mir.MIR_SHR_U; }

            val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, main_op, t1,
                                                   in_ops[a::u32], mir.op_imm(r::i64), lw);
            if (sel r1.err) { ret r1; }
            val r2: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, cross_op, t2,
                                                   nb, mir.op_imm((lb - r)::i64), lw);
            if (sel r2.err) { ret r2; }
            val r3: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_OR, out, t1, t2, lw);
            if (sel r3.err) { ret r3; }
        }
        i = i + step;
    }
    ret err[fail.Fail].ok{};
}

fun emit_sign_fill(alloc: *A.Allocator, f: *mir.MirFunction, src: *mir.MirInstr,
                   dst: *mir.MirInstr, cursor: *u32, top: mir.MirOperand, lw: u8,
                   out: *mir.MirOperand) err[fail.Fail] {
    val rv: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
    if (sel rv.err) { ret err[fail.Fail].err{rv.err}; }
    @out = mir.op_vreg(rv.ok);
    ret emit_bin(alloc, dst, cursor, src, mir.MIR_SHR_S, @out, top,
                 mir.op_imm((lw::u32 * 8 - 1)::i64), lw);
}

fun expand_shift(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
                 dst: *mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val rc: res[u32, fail.Fail] = shift_piece_count(alloc, plan, mi);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }

    val nl: u32 = wide_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;
    val lb: u32 = lw::u32 * 8;
    val bits: u32 = nl * lb;
    val left:  bool = mi.opcode == mir.MIR_SHL;
    val arith: bool = mi.opcode == mir.MIR_SHR_S;

    var src_ops: [MAX_SHIFT_LANES]mir.MirOperand;
    var dst_ops: [MAX_SHIFT_LANES]mir.MirOperand;
    var i: u32 = 0;
    for (i < nl) {
        src_ops[i] = lane_operand(plan, ?mi.operands[1], i);
        dst_ops[i] = lane_operand(plan, ?mi.operands[0], i);
        i = i + 1;
    }

    if (mi.operands[2].kind == mir.MIR_OP_IMM) {
        val c: u32 = (mi.operands[2].imm & (bits - 1)::i64)::u32;
        var fill: mir.MirOperand = mir.op_imm(0);
        if (needs_sign_fill(arith, c / lb)) {
            val rf: err[fail.Fail] = emit_sign_fill(alloc, f, mi, dst, cursor,
                                                         src_ops[nl - 1], lw, ?fill);
            if (sel rf.err) { ret rf; }
        }
        ret emit_const_shift(alloc, f, mi, dst, cursor, ?src_ops[0], ?dst_ops[0], nl, lw,
                             c / lb, c % lb, left, arith, fill);
    }

    ret emit_shift_barrel(alloc, plan, f, mi, dst, cursor, ?src_ops[0], ?dst_ops[0], nl, lw, left, arith);
}

fun emit_shift_barrel(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
                      dst: *mir.MirInstr, cursor: *u32,
                      src_ops: *mir.MirOperand, dst_ops: *mir.MirOperand, nl: u32, lw: u8,
                      left: bool, arith: bool) err[fail.Fail] {
    val lb:     u32 = lw::u32 * 8;
    val stages: u32 = shift_stage_count(nl * lb);
    val cnt: mir.MirOperand = lane_operand(plan, ?mi.operands[2], 0);

    var fill: mir.MirOperand = mir.op_imm(0);
    if (arith && nl > 1) {
        val rf: err[fail.Fail] = emit_sign_fill(alloc, f, mi, dst, cursor,
                                                     src_ops[nl - 1], lw, ?fill);
        if (sel rf.err) { ret rf; }
    }

    var cur: [MAX_SHIFT_LANES]mir.MirOperand;
    var sh:  [MAX_SHIFT_LANES]mir.MirOperand;
    var nxt: [MAX_SHIFT_LANES]mir.MirOperand;
    var i: u32 = 0;
    for (i < nl) { cur[i] = src_ops[i]; i = i + 1; }

    var j: u32 = 0;
    for (j < stages) {
        var bit_src: mir.MirOperand = cnt;
        if (j > 0) {
            val rt: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel rt.err) { ret err[fail.Fail].err{rt.err}; }
            bit_src = mir.op_vreg(rt.ok);
            val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_SHR_U,
                                                   bit_src, cnt, mir.op_imm(j::i64), lw);
            if (sel r1.err) { ret r1; }
        }
        val rb: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
        val bit: mir.MirOperand = mir.op_vreg(rb.ok);
        val r2: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_AND, bit,
                                               bit_src, mir.op_imm(1), lw);
        if (sel r2.err) { ret r2; }

        val rm: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rm.err) { ret err[fail.Fail].err{rm.err}; }
        val mask: mir.MirOperand = mir.op_vreg(rm.ok);
        val r3: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_SUB, mask,
                                               mir.op_imm(0), bit, lw);
        if (sel r3.err) { ret r3; }

        i = 0;
        for (i < nl) {
            val rs: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
            sh[i] = mir.op_vreg(rs.ok);
            i = i + 1;
        }
        val c: u32 = 1 << j;
        val r4: err[fail.Fail] = emit_const_shift(alloc, f, mi, dst, cursor, ?cur[0], ?sh[0],
                                                       nl, lw, c / lb, c % lb, left, arith, fill);
        if (sel r4.err) { ret r4; }

        if (j == stages - 1) {
            i = 0;
            for (i < nl) { nxt[i] = dst_ops[i]; i = i + 1; }
        }
        or {
            i = 0;
            for (i < nl) {
                val rn: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
                if (sel rn.err) { ret err[fail.Fail].err{rn.err}; }
                nxt[i] = mir.op_vreg(rn.ok);
                i = i + 1;
            }
        }

        i = 0;
        for (i < nl) {
            val rx: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel rx.err) { ret err[fail.Fail].err{rx.err}; }
            val x: mir.MirOperand = mir.op_vreg(rx.ok);
            val r5: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_XOR, x, cur[i], sh[i], lw);
            if (sel r5.err) { ret r5; }

            val ry: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel ry.err) { ret err[fail.Fail].err{ry.err}; }
            val y: mir.MirOperand = mir.op_vreg(ry.ok);
            val r6: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_AND, y, x, mask, lw);
            if (sel r6.err) { ret r6; }

            val r7: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_XOR, nxt[i], cur[i], y, lw);
            if (sel r7.err) { ret r7; }
            i = i + 1;
        }

        i = 0;
        for (i < nl) { cur[i] = nxt[i]; i = i + 1; }
        j = j + 1;
    }
    ret err[fail.Fail].ok{};
}

fun double_and_add_pieces(nl: u32, stages: u32) u32 {
    val per_stage: u32 = 2 + addsub_chain_piece_count(nl) + 3 * nl;
    val shl1: u32 = const_shift_pieces(nl, 0, 1, true, false);
    val shr1: u32 = const_shift_pieces(nl, 0, 1, false, false);
    ret stages * per_stage + (stages - 1) * (shl1 + shr1);
}

fun lane_is_seed_zero(op: mir.MirOperand) bool {
    ret op.kind == mir.MIR_OP_IMM && op.imm == 0;
}

fun accum_into(live: *bool, nl: u32, p: u32) u32 {
    if (!live[p]) { live[p] = true; ret 0; }
    var k: u32 = p;
    for (k < nl) { live[k] = true; k = k + 1; }
    ret accum_lane_pieces(nl, p);
}

fun accum_lane_pieces(nl: u32, p: u32) u32 {
    ret 2 * (nl - p) - 1;
}

fun emit_accumulate_lane(alloc: *A.Allocator, f: *mir.MirFunction, src: *mir.MirInstr,
                         dst: *mir.MirInstr, cursor: *u32, acc: *mir.MirOperand,
                         nl: u32, lw: u8, p: u32, v: mir.MirOperand) err[fail.Fail] {
    if (lane_is_seed_zero(acc[p])) { acc[p] = v; ret err[fail.Fail].ok{}; }

    val rt: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
    if (sel rt.err) { ret err[fail.Fail].err{rt.err}; }
    val t: mir.MirOperand = mir.op_vreg(rt.ok);
    val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_ADD, t, acc[p], v, lw);
    if (sel r1.err) { ret r1; }

    if (p == nl - 1) { acc[p] = t; ret err[fail.Fail].ok{}; }

    val rc: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    var carry: mir.MirOperand = mir.op_vreg(rc.ok);
    val r2: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_CMP_LT_U, carry, t, v, lw);
    if (sel r2.err) { ret r2; }
    acc[p] = t;

    var k: u32 = p + 1;
    for (k < nl) {
        val rn: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rn.err) { ret err[fail.Fail].err{rn.err}; }
        val n: mir.MirOperand = mir.op_vreg(rn.ok);
        val r3: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_ADD, n, acc[k], carry, lw);
        if (sel r3.err) { ret r3; }
        acc[k] = n;
        if (k == nl - 1) { ret err[fail.Fail].ok{}; }

        val rc2: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rc2.err) { ret err[fail.Fail].err{rc2.err}; }
        val c2: mir.MirOperand = mir.op_vreg(rc2.ok);
        val r4: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_CMP_LT_U, c2, n, carry, lw);
        if (sel r4.err) { ret r4; }
        carry = c2;
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun lane_product_pieces(native: bool, want_hi: bool, lane_bits: u32) u32 {
    if (native) {
        if (want_hi) { ret 2; }
        ret 1;
    }
    if (want_hi) { ret double_and_add_pieces(2, lane_bits); }
    ret double_and_add_pieces(1, lane_bits);
}

fun emit_lane_product(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, src: *mir.MirInstr,
                      dst: *mir.MirInstr, cursor: *u32,
                      a: mir.MirOperand, b: mir.MirOperand,
                      lo: mir.MirOperand, hi: mir.MirOperand, want_hi: bool) err[fail.Fail] {
    val lw: u8 = plan.lane_width;
    if (plan.mach.mul_hi != 0) {
        val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_MUL, lo, a, b, lw);
        if (sel r1.err) { ret r1; }
        if (!want_hi) { ret err[fail.Fail].ok{}; }
        ret emit_bin(alloc, dst, cursor, src, mir.MIR_MUL_HI_U, hi, a, b, lw);
    }

    var mc:  [MAX_SHIFT_LANES]mir.MirOperand;
    var mp:  [MAX_SHIFT_LANES]mir.MirOperand;
    var out: [MAX_SHIFT_LANES]mir.MirOperand;
    mc[0]  = a;
    mp[0]  = b;
    out[0] = lo;
    var n: u32 = 1;
    if (want_hi) {
        mc[1]  = mir.op_imm(0);
        mp[1]  = mir.op_imm(0);
        out[1] = hi;
        n = 2;
    }
    ret emit_double_and_add(alloc, plan, f, src, dst, cursor, ?mc[0], ?mp[0], ?out[0], n, lw::u32 * 8);
}

fun mul_schoolbook_pieces(plan: *LanePlan, nl: u32) u32 {
    val native:    bool = plan.mach.mul_hi != 0;
    val lane_bits: u32  = plan.lane_width::u32 * 8;
    var live: [MAX_SHIFT_LANES]bool;
    var total: u32 = 0;
    var i: u32 = 0;
    for (i < nl) { live[i] = false; i = i + 1; }
    i = 0;
    for (i < nl) {
        var j: u32 = 0;
        for (i + j < nl) {
            val p: u32 = i + j;
            val want_hi: bool = p + 1 < nl;
            total = total + lane_product_pieces(native, want_hi, lane_bits);
            total = total + accum_into(?live[0], nl, p);
            if (want_hi) { total = total + accum_into(?live[0], nl, p + 1); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret total + nl;
}

fun mul_piece_count(alloc: *A.Allocator, plan: *LanePlan, mi: *mir.MirInstr) res[u32, fail.Fail] {
    val nl: u32 = wide_lane_count(plan, mi);
    if (mi.operand_count != 3 || nl > MAX_SHIFT_LANES ||
        mi.operands[0].kind != mir.MIR_OP_VREG || !operand_is_lane_ready(plan, ?mi.operands[0], nl) ||
        !operand_is_lane_ready(plan, ?mi.operands[1], nl) || !operand_is_lane_ready(plan, ?mi.operands[2], nl)) {
        ret res[u32, fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))};
    }
    if (plan.mach.mul_hi != 0 && plan.mach.mul_hi != plan.lane_width) {
        ret res[u32, fail.Fail].err{fail.message("legalize: this target declares a widening multiply at a width other than its ALU width, which this pass does not model (see briar-systems/mach#2778)")};
    }
    if (plan.mach.mul_hi != 0 && !plan.mach.has_mul) {
        ret res[u32, fail.Fail].err{fail.message("legalize: this target declares the high half of a multiply but no multiply (see briar-systems/mach#2778)")};
    }
    if (nl > 1) { ret res[u32, fail.Fail].ok{mul_schoolbook_pieces(plan, nl)}; }
    ret res[u32, fail.Fail].ok{double_and_add_pieces(nl, nl * plan.lane_width::u32 * 8)};
}

fun expand_mul(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
               dst: *mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val rc: res[u32, fail.Fail] = mul_piece_count(alloc, plan, mi);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }

    val nl: u32 = wide_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;

    var dst_ops: [MAX_SHIFT_LANES]mir.MirOperand;
    var a_ops:   [MAX_SHIFT_LANES]mir.MirOperand;
    var b_ops:   [MAX_SHIFT_LANES]mir.MirOperand;
    var i: u32 = 0;
    for (i < nl) {
        dst_ops[i] = lane_operand(plan, ?mi.operands[0], i);
        a_ops[i]   = lane_operand(plan, ?mi.operands[1], i);
        b_ops[i]   = lane_operand(plan, ?mi.operands[2], i);
        i = i + 1;
    }

    if (nl == 1) {
        ret emit_double_and_add(alloc, plan, f, mi, dst, cursor, ?a_ops[0], ?b_ops[0], ?dst_ops[0],
                                nl, lw::u32 * 8);
    }

    var acc: [MAX_SHIFT_LANES]mir.MirOperand;
    i = 0;
    for (i < nl) { acc[i] = mir.op_imm(0); i = i + 1; }

    i = 0;
    for (i < nl) {
        var j: u32 = 0;
        for (i + j < nl) {
            val p: u32 = i + j;
            val want_hi: bool = p + 1 < nl;

            val rl: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
            val lo: mir.MirOperand = mir.op_vreg(rl.ok);

            var hi: mir.MirOperand = mir.op_imm(0);
            if (want_hi) {
                val rh: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
                if (sel rh.err) { ret err[fail.Fail].err{rh.err}; }
                hi = mir.op_vreg(rh.ok);
            }

            val rp: err[fail.Fail] = emit_lane_product(alloc, plan, f, mi, dst, cursor,
                                                            a_ops[i], b_ops[j], lo, hi, want_hi);
            if (sel rp.err) { ret rp; }

            val ra: err[fail.Fail] = emit_accumulate_lane(alloc, f, mi, dst, cursor, ?acc[0], nl, lw, p, lo);
            if (sel ra.err) { ret ra; }
            if (want_hi) {
                val rb: err[fail.Fail] = emit_accumulate_lane(alloc, f, mi, dst, cursor, ?acc[0], nl, lw, p + 1, hi);
                if (sel rb.err) { ret rb; }
            }
            j = j + 1;
        }
        i = i + 1;
    }

    i = 0;
    for (i < nl) {
        var ops: [2]mir.MirOperand;
        ops[0] = dst_ops[i];
        ops[1] = acc[i];
        val rm: err[fail.Fail] = emit_piece(alloc, dst, cursor, mi, mir.MIR_MOV, ?ops[0], 2, lw);
        if (sel rm.err) { ret rm; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun emit_double_and_add(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, src: *mir.MirInstr,
                        dst: *mir.MirInstr, cursor: *u32,
                        a_in: *mir.MirOperand, b_in: *mir.MirOperand, out: *mir.MirOperand,
                        nl: u32, stages: u32) err[fail.Fail] {
    val mi: *mir.MirInstr = src;
    val lw: u8 = plan.lane_width;

    var mcand:  [MAX_SHIFT_LANES]mir.MirOperand;
    var mplier: [MAX_SHIFT_LANES]mir.MirOperand;
    var result: [MAX_SHIFT_LANES]mir.MirOperand;
    var i: u32 = 0;
    for (i < nl) {
        mcand[i]  = a_in[i];
        mplier[i] = b_in[i];
        result[i] = mir.op_imm(0);
        i = i + 1;
    }

    var j: u32 = 0;
    for (j < stages) {
        val rb: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
        val bit: mir.MirOperand = mir.op_vreg(rb.ok);
        val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_AND, bit, mplier[0], mir.op_imm(1), lw);
        if (sel r1.err) { ret r1; }

        val rm: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rm.err) { ret err[fail.Fail].err{rm.err}; }
        val mask: mir.MirOperand = mir.op_vreg(rm.ok);
        val r2: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_SUB, mask, mir.op_imm(0), bit, lw);
        if (sel r2.err) { ret r2; }

        var cand: [MAX_SHIFT_LANES]mir.MirOperand;
        i = 0;
        for (i < nl) {
            val rc2: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel rc2.err) { ret err[fail.Fail].err{rc2.err}; }
            cand[i] = mir.op_vreg(rc2.ok);
            i = i + 1;
        }
        val r3: err[fail.Fail] = emit_addsub_chain(alloc, f, mi, dst, cursor, ?cand[0], ?result[0], ?mcand[0], nl, lw, false);
        if (sel r3.err) { ret r3; }

        val is_last: bool = j == stages - 1;
        var nxt: [MAX_SHIFT_LANES]mir.MirOperand;
        i = 0;
        for (i < nl) {
            if (is_last) { nxt[i] = out[i]; }
            or {
                val rn: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
                if (sel rn.err) { ret err[fail.Fail].err{rn.err}; }
                nxt[i] = mir.op_vreg(rn.ok);
            }
            i = i + 1;
        }
        i = 0;
        for (i < nl) {
            val rx: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel rx.err) { ret err[fail.Fail].err{rx.err}; }
            val x: mir.MirOperand = mir.op_vreg(rx.ok);
            val r4: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_XOR, x, result[i], cand[i], lw);
            if (sel r4.err) { ret r4; }

            val ry: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel ry.err) { ret err[fail.Fail].err{ry.err}; }
            val y: mir.MirOperand = mir.op_vreg(ry.ok);
            val r5: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_AND, y, x, mask, lw);
            if (sel r5.err) { ret r5; }

            val r6: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_XOR, nxt[i], result[i], y, lw);
            if (sel r6.err) { ret r6; }
            i = i + 1;
        }
        i = 0;
        for (i < nl) { result[i] = nxt[i]; i = i + 1; }

        if (!is_last) {
            var nmc: [MAX_SHIFT_LANES]mir.MirOperand;
            i = 0;
            for (i < nl) {
                val rmc: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
                if (sel rmc.err) { ret err[fail.Fail].err{rmc.err}; }
                nmc[i] = mir.op_vreg(rmc.ok);
                i = i + 1;
            }
            val r7: err[fail.Fail] = emit_const_shift(alloc, f, mi, dst, cursor, ?mcand[0], ?nmc[0], nl, lw, 0, 1, true, false, mir.op_imm(0));
            if (sel r7.err) { ret r7; }
            i = 0;
            for (i < nl) { mcand[i] = nmc[i]; i = i + 1; }

            var nmp: [MAX_SHIFT_LANES]mir.MirOperand;
            i = 0;
            for (i < nl) {
                val rmp: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
                if (sel rmp.err) { ret err[fail.Fail].err{rmp.err}; }
                nmp[i] = mir.op_vreg(rmp.ok);
                i = i + 1;
            }
            val r8: err[fail.Fail] = emit_const_shift(alloc, f, mi, dst, cursor, ?mplier[0], ?nmp[0], nl, lw, 0, 1, false, false, mir.op_imm(0));
            if (sel r8.err) { ret r8; }
            i = 0;
            for (i < nl) { mplier[i] = nmp[i]; i = i + 1; }
        }
        j = j + 1;
    }
    ret err[fail.Fail].ok{};
}

fun div_is_signed(op: mir.MirOpcode) bool {
    ret mir.has(op, mir.MIRF_DIV_SIGNED);
}


fun div_wants_remainder(op: mir.MirOpcode) bool {
    ret mir.has(op, mir.MIRF_REMAINDER);
}


fun divmod_stage_pieces(nl: u32) u32 {
    val shl1: u32 = const_shift_pieces(nl, 0, 1, true, false);
    ret 2 + shl1 + 1 + shl1
        + wide_rel_pieces(nl, false, false) + 1 + 1 + 1 + nl
        + addsub_chain_piece_count(nl);
}

fun divmod_signed_pieces(nl: u32, rem: bool) u32 {
    val absv: u32 = nl + addsub_chain_piece_count(nl);
    var total: u32 = 2 + 2 * absv;
    if (!rem) { total = total + 1; }
    ret total + absv;
}

fun divmod_zero_fixup_pieces(nl: u32, signed: bool) u32 {
    var total: u32 = (nl - 1) + 1 + nl;
    if (signed) { total = total + 2 + 4 * nl + 1; }
    ret total;
}

fun divmod_piece_count(alloc: *A.Allocator, plan: *LanePlan, mi: *mir.MirInstr) res[u32, fail.Fail] {
    val nl: u32 = wide_lane_count(plan, mi);
    if (mi.operand_count != 3 || nl > MAX_SHIFT_LANES ||
        mi.operands[0].kind != mir.MIR_OP_VREG || !operand_is_lane_ready(plan, ?mi.operands[0], nl) ||
        !operand_is_lane_ready(plan, ?mi.operands[1], nl) || !operand_is_lane_ready(plan, ?mi.operands[2], nl)) {
        ret res[u32, fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))};
    }
    val bits: u32 = nl * plan.lane_width::u32 * 8;
    var total: u32 = bits * divmod_stage_pieces(nl) + divmod_zero_fixup_pieces(nl, div_is_signed(mi.opcode));
    if (div_is_signed(mi.opcode)) {
        total = total + divmod_signed_pieces(nl, div_wants_remainder(mi.opcode));
    }
    ret res[u32, fail.Fail].ok{total};
}

fun new_lane_temps(alloc: *A.Allocator, f: *mir.MirFunction, out: *mir.MirOperand, n: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < n) {
        val r: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        out[i] = mir.op_vreg(r.ok);
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun emit_wide_abs(alloc: *A.Allocator, f: *mir.MirFunction, src: *mir.MirInstr,
                  dst: *mir.MirInstr, cursor: *u32,
                  v_ops: *mir.MirOperand, out: *mir.MirOperand, sign: *mir.MirOperand,
                  nl: u32, lw: u8) err[fail.Fail] {
    val lb: u32 = lw::u32 * 8;
    val rs: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    val s: mir.MirOperand = mir.op_vreg(rs.ok);
    val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_SHR_S, s,
                                           v_ops[nl - 1], mir.op_imm((lb - 1)::i64), lw);
    if (sel r1.err) { ret r1; }
    @sign = s;

    var xr: [MAX_SHIFT_LANES]mir.MirOperand;
    var sb: [MAX_SHIFT_LANES]mir.MirOperand;
    var i: u32 = 0;
    for (i < nl) {
        val rt: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rt.err) { ret err[fail.Fail].err{rt.err}; }
        xr[i] = mir.op_vreg(rt.ok);
        val rx: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_XOR, xr[i], v_ops[i], s, lw);
        if (sel rx.err) { ret rx; }
        sb[i] = s;
        i = i + 1;
    }
    ret emit_addsub_chain(alloc, f, src, dst, cursor, out, ?xr[0], ?sb[0], nl, lw, true);
}

fun emit_apply_sign(alloc: *A.Allocator, f: *mir.MirFunction, src: *mir.MirInstr,
                    dst: *mir.MirInstr, cursor: *u32,
                    v_ops: *mir.MirOperand, out: *mir.MirOperand, s: mir.MirOperand,
                    nl: u32, lw: u8) err[fail.Fail] {
    var xr: [MAX_SHIFT_LANES]mir.MirOperand;
    var sb: [MAX_SHIFT_LANES]mir.MirOperand;
    var i: u32 = 0;
    for (i < nl) {
        val rt: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rt.err) { ret err[fail.Fail].err{rt.err}; }
        xr[i] = mir.op_vreg(rt.ok);
        val rx: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_XOR, xr[i], v_ops[i], s, lw);
        if (sel rx.err) { ret rx; }
        sb[i] = s;
        i = i + 1;
    }
    ret emit_addsub_chain(alloc, f, src, dst, cursor, out, ?xr[0], ?sb[0], nl, lw, true);
}

fun expand_divmod(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
                  dst: *mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val rc: res[u32, fail.Fail] = divmod_piece_count(alloc, plan, mi);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }

    val nl: u32 = wide_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;
    val lb: u32 = lw::u32 * 8;
    val bits: u32 = nl * lb;
    val signed: bool = div_is_signed(mi.opcode);
    val want_rem: bool = div_wants_remainder(mi.opcode);

    var num: [MAX_SHIFT_LANES]mir.MirOperand;
    var den: [MAX_SHIFT_LANES]mir.MirOperand;
    var rem: [MAX_SHIFT_LANES]mir.MirOperand;
    var od: [MAX_SHIFT_LANES]mir.MirOperand;
    var on: [MAX_SHIFT_LANES]mir.MirOperand;
    var i: u32 = 0;
    for (i < nl) {
        num[i] = lane_operand(plan, ?mi.operands[1], i);
        den[i] = lane_operand(plan, ?mi.operands[2], i);
        on[i]  = num[i];
        od[i]  = den[i];
        rem[i] = mir.op_imm(0);
        i = i + 1;
    }

    var sa: mir.MirOperand = mir.op_imm(0);
    var sb: mir.MirOperand = mir.op_imm(0);
    if (signed) {
        var an: [MAX_SHIFT_LANES]mir.MirOperand;
        val ra: err[fail.Fail] = new_lane_temps(alloc, f, ?an[0], nl);
        if (sel ra.err) { ret ra; }
        val r1: err[fail.Fail] = emit_wide_abs(alloc, f, mi, dst, cursor, ?num[0], ?an[0], ?sa, nl, lw);
        if (sel r1.err) { ret r1; }

        var bn: [MAX_SHIFT_LANES]mir.MirOperand;
        val rb2: err[fail.Fail] = new_lane_temps(alloc, f, ?bn[0], nl);
        if (sel rb2.err) { ret rb2; }
        val r2: err[fail.Fail] = emit_wide_abs(alloc, f, mi, dst, cursor, ?den[0], ?bn[0], ?sb, nl, lw);
        if (sel r2.err) { ret r2; }

        i = 0;
        for (i < nl) { num[i] = an[i]; den[i] = bn[i]; i = i + 1; }
    }

    var j: u32 = 0;
    for (j < bits) {
        val rh: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rh.err) { ret err[fail.Fail].err{rh.err}; }
        val hs: mir.MirOperand = mir.op_vreg(rh.ok);
        val e1: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_SHR_U, hs,
                                               num[nl - 1], mir.op_imm((lb - 1)::i64), lw);
        if (sel e1.err) { ret e1; }
        val rh2: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rh2.err) { ret err[fail.Fail].err{rh2.err}; }
        val hb: mir.MirOperand = mir.op_vreg(rh2.ok);
        val e2: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_AND, hb, hs, mir.op_imm(1), lw);
        if (sel e2.err) { ret e2; }

        var rsh: [MAX_SHIFT_LANES]mir.MirOperand;
        val rt1: err[fail.Fail] = new_lane_temps(alloc, f, ?rsh[0], nl);
        if (sel rt1.err) { ret rt1; }
        val e3: err[fail.Fail] = emit_const_shift(alloc, f, mi, dst, cursor, ?rem[0], ?rsh[0],
                                                       nl, lw, 0, 1, true, false, mir.op_imm(0));
        if (sel e3.err) { ret e3; }
        val rl0: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rl0.err) { ret err[fail.Fail].err{rl0.err}; }
        val rlo: mir.MirOperand = mir.op_vreg(rl0.ok);
        val e4: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_OR, rlo, rsh[0], hb, lw);
        if (sel e4.err) { ret e4; }
        rsh[0] = rlo;

        var nsh: [MAX_SHIFT_LANES]mir.MirOperand;
        val rt2: err[fail.Fail] = new_lane_temps(alloc, f, ?nsh[0], nl);
        if (sel rt2.err) { ret rt2; }
        val e5: err[fail.Fail] = emit_const_shift(alloc, f, mi, dst, cursor, ?num[0], ?nsh[0],
                                                       nl, lw, 0, 1, true, false, mir.op_imm(0));
        if (sel e5.err) { ret e5; }

        val rlt: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rlt.err) { ret err[fail.Fail].err{rlt.err}; }
        val lt: mir.MirOperand = mir.op_vreg(rlt.ok);
        val e6: err[fail.Fail] = emit_wide_rel(alloc, f, mi, dst, cursor, lt, ?rsh[0], ?den[0],
                                                    nl, lw, false, false);
        if (sel e6.err) { ret e6; }
        val rge: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rge.err) { ret err[fail.Fail].err{rge.err}; }
        val ge: mir.MirOperand = mir.op_vreg(rge.ok);
        val e7: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_XOR, ge, lt, mir.op_imm(1), lw);
        if (sel e7.err) { ret e7; }

        val rq: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rq.err) { ret err[fail.Fail].err{rq.err}; }
        val qlo: mir.MirOperand = mir.op_vreg(rq.ok);
        val e8: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_OR, qlo, nsh[0], ge, lw);
        if (sel e8.err) { ret e8; }
        nsh[0] = qlo;

        val rm: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rm.err) { ret err[fail.Fail].err{rm.err}; }
        val mask: mir.MirOperand = mir.op_vreg(rm.ok);
        val e9: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_SUB, mask, mir.op_imm(0), ge, lw);
        if (sel e9.err) { ret e9; }

        var md: [MAX_SHIFT_LANES]mir.MirOperand;
        i = 0;
        for (i < nl) {
            val rd: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
            md[i] = mir.op_vreg(rd.ok);
            val rx: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_AND, md[i], den[i], mask, lw);
            if (sel rx.err) { ret rx; }
            i = i + 1;
        }

        var nrem: [MAX_SHIFT_LANES]mir.MirOperand;
        val rt3: err[fail.Fail] = new_lane_temps(alloc, f, ?nrem[0], nl);
        if (sel rt3.err) { ret rt3; }
        val e10: err[fail.Fail] = emit_addsub_chain(alloc, f, mi, dst, cursor, ?nrem[0], ?rsh[0], ?md[0], nl, lw, true);
        if (sel e10.err) { ret e10; }

        i = 0;
        for (i < nl) { rem[i] = nrem[i]; num[i] = nsh[i]; i = i + 1; }
        j = j + 1;
    }

    var lanes: [MAX_SHIFT_LANES]mir.MirOperand;
    i = 0;
    for (i < nl) {
        lanes[i] = num[i];
        if (want_rem) { lanes[i] = rem[i]; }
        i = i + 1;
    }

    var d_ops: [MAX_SHIFT_LANES]mir.MirOperand;
    i = 0;
    for (i < nl) { d_ops[i] = lane_operand(plan, ?mi.operands[0], i); i = i + 1; }

    if (signed) {
        var s: mir.MirOperand = sa;
        if (!want_rem) {
            val rq2: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel rq2.err) { ret err[fail.Fail].err{rq2.err}; }
            s = mir.op_vreg(rq2.ok);
            val rs2: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_XOR, s, sa, sb, lw);
            if (sel rs2.err) { ret rs2; }
        }
        var sres: [MAX_SHIFT_LANES]mir.MirOperand;
        val rst: err[fail.Fail] = new_lane_temps(alloc, f, ?sres[0], nl);
        if (sel rst.err) { ret rst; }
        val rap: err[fail.Fail] = emit_apply_sign(alloc, f, mi, dst, cursor, ?lanes[0], ?sres[0], s, nl, lw);
        if (sel rap.err) { ret rap; }
        i = 0;
        for (i < nl) { lanes[i] = sres[i]; i = i + 1; }
    }

    ret emit_divmod_zero_fixup(alloc, f, mi, dst, cursor, ?lanes[0], ?od[0], ?on[0], ?d_ops[0],
                               nl, lw, want_rem);
}

fun lane_mask(lw: u8) i64 {
    if (lw >= 8) { ret -1; }
    ret (1::i64 << (lw::u64 * 8)) - 1;
}

fun emit_divmod_zero_fixup(alloc: *A.Allocator, f: *mir.MirFunction, src: *mir.MirInstr,
                           dst: *mir.MirInstr, cursor: *u32,
                           result: *mir.MirOperand, den: *mir.MirOperand, num: *mir.MirOperand,
                           d_ops: *mir.MirOperand, nl: u32, lw: u8, rem: bool) err[fail.Fail] {
    var acc: mir.MirOperand = den[0];
    var i: u32 = 1;
    for (i < nl) {
        val ra: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
        val nx: mir.MirOperand = mir.op_vreg(ra.ok);
        val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_OR, nx, acc, den[i], lw);
        if (sel r1.err) { ret r1; }
        acc = nx;
        i = i + 1;
    }

    var divisor: mir.MirOperand = acc;
    if (mir.has(src.opcode, mir.MIRF_DIV_SIGNED)) {
        val rz: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rz.err) { ret err[fail.Fail].err{rz.err}; }
        val z: mir.MirOperand = mir.op_vreg(rz.ok);
        val r2: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_CMP_EQ, z, acc, mir.op_imm(0), lw);
        if (sel r2.err) { ret r2; }
        val rn: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rn.err) { ret err[fail.Fail].err{rn.err}; }
        val nonzero: mir.MirOperand = mir.op_vreg(rn.ok);
        val r3: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_SUB, nonzero, mir.op_imm(1), z, lw);
        if (sel r3.err) { ret r3; }

        val lane_bits: u32 = lw::u32 * 8;
        val lane_min: i64 = (1::i64 << (lane_bits - 1)::u64) & lane_mask(lw);
        var ov: mir.MirOperand = mir.op_imm(1);
        i = 0;
        for (i < nl) {
            val rd1: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel rd1.err) { ret err[fail.Fail].err{rd1.err}; }
            val dm: mir.MirOperand = mir.op_vreg(rd1.ok);
            val e1: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_CMP_EQ, dm, den[i], mir.op_imm(lane_mask(lw)), lw);
            if (sel e1.err) { ret e1; }
            var want: i64 = 0;
            if (i == nl - 1) { want = lane_min; }
            val rn1: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel rn1.err) { ret err[fail.Fail].err{rn1.err}; }
            val nm: mir.MirOperand = mir.op_vreg(rn1.ok);
            val e2: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_CMP_EQ, nm, num[i], mir.op_imm(want), lw);
            if (sel e2.err) { ret e2; }
            val ra1: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel ra1.err) { ret err[fail.Fail].err{ra1.err}; }
            val both: mir.MirOperand = mir.op_vreg(ra1.ok);
            val e3: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_AND, both, dm, nm, lw);
            if (sel e3.err) { ret e3; }
            val ra2: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel ra2.err) { ret err[fail.Fail].err{ra2.err}; }
            val next: mir.MirOperand = mir.op_vreg(ra2.ok);
            val e4: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_AND, next, ov, both, lw);
            if (sel e4.err) { ret e4; }
            ov = next;
            i = i + 1;
        }
        val rd2: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rd2.err) { ret err[fail.Fail].err{rd2.err}; }
        divisor = mir.op_vreg(rd2.ok);
        val r4: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_SUB, divisor, nonzero, ov, lw);
        if (sel r4.err) { ret r4; }
    }

    val rp: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
    if (sel rp.err) { ret err[fail.Fail].err{rp.err}; }
    val probe: mir.MirOperand = mir.op_vreg(rp.ok);
    val r5: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_DIV_U, probe, mir.op_imm(1), divisor, lw);
    if (sel r5.err) { ret r5; }

    i = 0;
    for (i < nl) {
        val e5: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_OR, d_ops[i], result[i], mir.op_imm(0), lw);
        if (sel e5.err) { ret e5; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun cmp_is_equality(op: mir.MirOpcode) bool {
    ret mir.has(op, mir.MIRF_CMP_EQUALITY);
}


fun cmp_is_signed(op: mir.MirOpcode) bool {
    ret mir.has(op, mir.MIRF_CMP_SIGNED);
}


fun cmp_is_le(op: mir.MirOpcode) bool {
    ret mir.has(op, mir.MIRF_CMP_LE);
}


fun cmp_dest_is_native(plan: *LanePlan, d: *mir.MirOperand) bool {
    if (d.kind != mir.MIR_OP_VREG) { ret false; }
    ret d.vreg.n >= plan.orig_count || plan.lane_base[d.vreg.n] == LANE_NONE;
}

fun cmp_rel_pieces(signed: bool, le: bool) u32 {
    var n: u32 = 1;
    if (signed) { n = 3; }
    if (le)     { n = n + 1; }
    ret n;
}

fun emit_lane_rel(alloc: *A.Allocator, f: *mir.MirFunction, src: *mir.MirInstr,
                  dst: *mir.MirInstr, cursor: *u32,
                  d: mir.MirOperand, a: mir.MirOperand, b: mir.MirOperand, lw: u8,
                  signed: bool, le: bool) err[fail.Fail] {
    var x: mir.MirOperand = a;
    var y: mir.MirOperand = b;
    if (le) { x = b; y = a; }

    if (signed) {
        val bias: mir.MirOperand = mir.op_imm(1::i64 << (lw::i64 * 8 - 1));
        val rx: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rx.err) { ret err[fail.Fail].err{rx.err}; }
        val bx: mir.MirOperand = mir.op_vreg(rx.ok);
        val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_XOR, bx, x, bias, lw);
        if (sel r1.err) { ret r1; }

        val ry: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel ry.err) { ret err[fail.Fail].err{ry.err}; }
        val by: mir.MirOperand = mir.op_vreg(ry.ok);
        val r2: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_XOR, by, y, bias, lw);
        if (sel r2.err) { ret r2; }

        x = bx;
        y = by;
    }

    if (!le) { ret emit_bin(alloc, dst, cursor, src, mir.MIR_CMP_LT_U, d, x, y, lw); }

    val rt: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
    if (sel rt.err) { ret err[fail.Fail].err{rt.err}; }
    val t: mir.MirOperand = mir.op_vreg(rt.ok);
    val r3: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, mir.MIR_CMP_LT_U, t, x, y, lw);
    if (sel r3.err) { ret r3; }
    ret emit_bin(alloc, dst, cursor, src, mir.MIR_XOR, d, t, mir.op_imm(1), lw);
}

fun cmp_piece_count(alloc: *A.Allocator, plan: *LanePlan, mi: *mir.MirInstr) res[u32, fail.Fail] {
    val nl: u32 = wide_lane_count(plan, mi);
    if (mi.operand_count != 3 || nl > MAX_SHIFT_LANES ||
        !cmp_dest_is_native(plan, ?mi.operands[0]) ||
        !operand_is_lane_ready(plan, ?mi.operands[1], nl) ||
        !operand_is_lane_ready(plan, ?mi.operands[2], nl)) {
        ret res[u32, fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))};
    }

    val op: mir.MirOpcode = mi.opcode;
    if (cmp_is_equality(op)) { ret res[u32, fail.Fail].ok{2 * nl - 1}; }

    ret res[u32, fail.Fail].ok{wide_rel_pieces(nl, cmp_is_signed(op), cmp_is_le(op))};
}

fun wide_rel_pieces(nl: u32, signed: bool, le: bool) u32 {
    var total: u32 = cmp_rel_pieces(signed && nl == 1, le);
    var i: u32 = 1;
    for (i < nl) {
        total = total + cmp_rel_pieces(signed && i == nl - 1, false) + 3;
        i = i + 1;
    }
    ret total;
}

fun expand_cmp(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
               dst: *mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val rc: res[u32, fail.Fail] = cmp_piece_count(alloc, plan, mi);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }

    if (cmp_is_equality(mi.opcode)) { ret expand_cmp_equality(alloc, plan, f, mi, dst, cursor); }
    ret expand_cmp_ordered(alloc, plan, f, mi, dst, cursor);
}

fun expand_cmp_equality(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
                        dst: *mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val nl: u32 = wide_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;
    val d:  mir.MirOperand = mi.operands[0];

    var lane_op: mir.MirOpcode = mir.MIR_CMP_EQ;
    var join:    mir.MirOpcode = mir.MIR_AND;
    if (mi.opcode == mir.MIR_CMP_NE) { lane_op = mir.MIR_CMP_NE; join = mir.MIR_OR; }

    var acc: mir.MirOperand;
    var i: u32 = 0;
    for (i < nl) {
        var out: mir.MirOperand = d;
        if (nl > 1) {
            val rt: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel rt.err) { ret err[fail.Fail].err{rt.err}; }
            out = mir.op_vreg(rt.ok);
        }
        val rl: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, lane_op, out,
                                               lane_operand(plan, ?mi.operands[1], i),
                                               lane_operand(plan, ?mi.operands[2], i), lw);
        if (sel rl.err) { ret rl; }

        if (i == 0) { acc = out; }
        or {
            var jd: mir.MirOperand = d;
            if (i < nl - 1) {
                val rj: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
                if (sel rj.err) { ret err[fail.Fail].err{rj.err}; }
                jd = mir.op_vreg(rj.ok);
            }
            val rr: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, join, jd, acc, out, lw);
            if (sel rr.err) { ret rr; }
            acc = jd;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_cmp_ordered(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
                       dst: *mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val nl: u32 = wide_lane_count(plan, mi);
    var a_ops: [MAX_SHIFT_LANES]mir.MirOperand;
    var b_ops: [MAX_SHIFT_LANES]mir.MirOperand;
    var i: u32 = 0;
    for (i < nl) {
        a_ops[i] = lane_operand(plan, ?mi.operands[1], i);
        b_ops[i] = lane_operand(plan, ?mi.operands[2], i);
        i = i + 1;
    }
    ret emit_wide_rel(alloc, f, mi, dst, cursor, mi.operands[0], ?a_ops[0], ?b_ops[0],
                      nl, plan.lane_width, cmp_is_signed(mi.opcode), cmp_is_le(mi.opcode));
}

fun emit_wide_rel(alloc: *A.Allocator, f: *mir.MirFunction, src: *mir.MirInstr,
                  dst: *mir.MirInstr, cursor: *u32, d: mir.MirOperand,
                  a_ops: *mir.MirOperand, b_ops: *mir.MirOperand,
                  nl: u32, lw: u8, signed: bool, le: bool) err[fail.Fail] {
    val mi: *mir.MirInstr = src;

    var result: mir.MirOperand = d;
    if (nl > 1) {
        val r0: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel r0.err) { ret err[fail.Fail].err{r0.err}; }
        result = mir.op_vreg(r0.ok);
    }
    val rb: err[fail.Fail] = emit_lane_rel(alloc, f, mi, dst, cursor, result,
                                                a_ops[0], b_ops[0], lw,
                                                signed && nl == 1, le);
    if (sel rb.err) { ret rb; }

    var i: u32 = 1;
    for (i < nl) {
        val a: mir.MirOperand = a_ops[i];
        val b: mir.MirOperand = b_ops[i];

        val rl: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
        val lt: mir.MirOperand = mir.op_vreg(rl.ok);
        val r1: err[fail.Fail] = emit_lane_rel(alloc, f, mi, dst, cursor, lt, a, b, lw,
                                                    signed && i == nl - 1, false);
        if (sel r1.err) { ret r1; }

        val re: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel re.err) { ret err[fail.Fail].err{re.err}; }
        val eq: mir.MirOperand = mir.op_vreg(re.ok);
        val r2: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_CMP_EQ, eq, a, b, lw);
        if (sel r2.err) { ret r2; }

        val rg: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (sel rg.err) { ret err[fail.Fail].err{rg.err}; }
        val g: mir.MirOperand = mir.op_vreg(rg.ok);
        val r3: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_AND, g, eq, result, lw);
        if (sel r3.err) { ret r3; }

        var out: mir.MirOperand = d;
        if (i < nl - 1) {
            val ro: res[mir.VRegId, fail.Fail] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (sel ro.err) { ret err[fail.Fail].err{ro.err}; }
            out = mir.op_vreg(ro.ok);
        }
        val r4: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, mir.MIR_OR, out, lt, g, lw);
        if (sel r4.err) { ret r4; }
        result = out;
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun dst_lane_count(plan: *LanePlan, mi: *mir.MirInstr) u32 {
    var n: u32 = (mi.width / plan.lane_width)::u32;
    if (n == 0) { n = 1; }
    ret n;
}

fun src_lane_count(plan: *LanePlan, mi: *mir.MirInstr) u32 {
    var n: u32 = (mi.src_width / plan.lane_width)::u32;
    if (n == 0) { n = 1; }
    ret n;
}

fun expand_zext(alloc: *A.Allocator, plan: *LanePlan, mi: *mir.MirInstr,
                dst: *mir.MirInstr, cursor: *u32) err[fail.Fail] {
    if (mi.operand_count != 2 ||
        mi.operands[0].kind != mir.MIR_OP_VREG || plan.lane_base[mi.operands[0].vreg.n] == LANE_NONE) {
        ret err[fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))};
    }
    val dl: u32 = dst_lane_count(plan, mi);
    val sl: u32 = src_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;
    var i: u32 = 0;
    for (i < dl) {
        var ops: [2]mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        if (i < sl) { ops[1] = lane_operand(plan, ?mi.operands[1], i); }
        or          { ops[1] = mir.op_imm(0); }
        val r: err[fail.Fail] = emit_piece(alloc, dst, cursor, mi, mir.MIR_MOV, ?ops[0], 2, lw);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_sext(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
                dst: *mir.MirInstr, cursor: *u32) err[fail.Fail] {
    if (mi.operand_count != 2 ||
        mi.operands[0].kind != mir.MIR_OP_VREG || plan.lane_base[mi.operands[0].vreg.n] == LANE_NONE) {
        ret err[fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))};
    }
    val dl: u32 = dst_lane_count(plan, mi);
    val sl: u32 = src_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;

    var fill: mir.MirOperand = mir.op_imm(0);
    if (dl > sl) {
        val top: mir.MirOperand = lane_operand(plan, ?mi.operands[1], sl - 1);
        val rf: err[fail.Fail] = emit_sign_fill(alloc, f, mi, dst, cursor, top, lw, ?fill);
        if (sel rf.err) { ret rf; }
    }

    var i: u32 = 0;
    for (i < dl) {
        var ops: [2]mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        if (i < sl) { ops[1] = lane_operand(plan, ?mi.operands[1], i); }
        or          { ops[1] = fill; }
        val r: err[fail.Fail] = emit_piece(alloc, dst, cursor, mi, mir.MIR_MOV, ?ops[0], 2, lw);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_trunc(alloc: *A.Allocator, plan: *LanePlan, mi: *mir.MirInstr,
                 dst: *mir.MirInstr, cursor: *u32) err[fail.Fail] {
    if (mi.operand_count != 2) {
        ret err[fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))};
    }
    val dl: u32 = dst_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;
    var i: u32 = 0;
    for (i < dl) {
        var ops: [2]mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        ops[1] = lane_operand(plan, ?mi.operands[1], i);
        val r: err[fail.Fail] = emit_piece(alloc, dst, cursor, mi, mir.MIR_MOV, ?ops[0], 2, lw);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

rec ConvEmit {
    alloc:  *A.Allocator;
    f:      *mir.MirFunction;
    src:    *mir.MirInstr;
    dst:    *mir.MirInstr;
    cursor: *u32;
    fp_cls: u32;
    fail:   bool;
}

val CONV_FCC_LT: u8 = 2;

fun cv_emit(cv: *ConvEmit, opcode: mir.MirOpcode, ops: *mir.MirOperand, nops: u32,
            w: u8, sw: u8) {
    val ci: u32 = @cv.cursor;
    @cv.cursor = ci + 1;
    if (cv.dst == nil || cv.fail) { ret; }
    var arr: *mir.MirOperand = nil;
    if (nops > 0) {
        val res_a: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](cv.alloc, nops::usize);
        if (sel res_a.err) { cv.fail = true; ret; }
        arr = res_a.ok;
        var j: u32 = 0;
        for (j < nops) { arr[j] = ops[j]; j = j + 1; }
    }
    cv.dst[ci] = mir.instr(opcode, arr, nops, w, sw);
    val p: *mir.MirInstr = ?cv.dst[ci];
    p.loc         = cv.src.loc;
    p.inline_site = cv.src.inline_site;
}

fun cv3(cv: *ConvEmit, opcode: mir.MirOpcode, d: mir.MirOperand, a: mir.MirOperand,
        b: mir.MirOperand, w: u8, sw: u8) {
    var ops: [3]mir.MirOperand;
    ops[0] = d; ops[1] = a; ops[2] = b;
    cv_emit(cv, opcode, ?ops[0], 3, w, sw);
}

fun cv2(cv: *ConvEmit, opcode: mir.MirOpcode, d: mir.MirOperand, a: mir.MirOperand,
        w: u8, sw: u8) {
    var ops: [2]mir.MirOperand;
    ops[0] = d; ops[1] = a;
    cv_emit(cv, opcode, ?ops[0], 2, w, sw);
}

fun cv_tmp(cv: *ConvEmit, cls: u32) mir.MirOperand {
    if (cv.dst == nil || cv.fail) { ret mir.op_vreg(mir.MIR_VREG_NIL); }
    val r: res[mir.VRegId, fail.Fail] = new_vreg(cv.alloc, cv.f, cls);
    if (sel r.err) { cv.fail = true; ret mir.op_vreg(mir.MIR_VREG_NIL); }
    ret mir.op_vreg(r.ok);
}

fun cv_gp(cv: *ConvEmit) mir.MirOperand { ret cv_tmp(cv, mir.REG_CLASS_GP); }
fun cv_fp(cv: *ConvEmit) mir.MirOperand { ret cv_tmp(cv, cv.fp_cls); }

fun cv_const(cv: *ConvEmit, v: i64) mir.MirOperand {
    val d: mir.MirOperand = cv_gp(cv);
    cv2(cv, mir.MIR_MOV, d, mir.op_imm(v), 4, 4);
    ret d;
}

fun cv_two32(cv: *ConvEmit) mir.MirOperand {
    val k: mir.MirOperand = cv_const(cv, 65536);
    val fk: mir.MirOperand = cv_fp(cv);
    cv2(cv, mir.MIR_UI_TO_FP, fk, k, 8, 4);
    val s: mir.MirOperand = cv_fp(cv);
    cv3(cv, mir.MIR_FMUL, s, fk, fk, 8, 8);
    ret s;
}

fun cv_pair_to_f64(cv: *ConvEmit, d: mir.MirOperand, two32: mir.MirOperand,
                   hi: mir.MirOperand, lo: mir.MirOperand, signed_hi: bool) {
    var hop: mir.MirOpcode = mir.MIR_UI_TO_FP;
    if (signed_hi) { hop = mir.MIR_SI_TO_FP; }
    val fhi: mir.MirOperand = cv_fp(cv);
    cv2(cv, hop, fhi, hi, 8, 4);
    val flo: mir.MirOperand = cv_fp(cv);
    cv2(cv, mir.MIR_UI_TO_FP, flo, lo, 8, 4);
    val t: mir.MirOperand = cv_fp(cv);
    cv3(cv, mir.MIR_FMUL, t, fhi, two32, 8, 8);
    cv3(cv, mir.MIR_FADD, d, t, flo, 8, 8);
}

fun cv_read_lanes(cv: *ConvEmit, plan: *LanePlan, op: *mir.MirOperand,
                  lo: *mir.MirOperand, hi: *mir.MirOperand) {
    @lo = cv_gp(cv);
    cv2(cv, mir.MIR_MOV, @lo, lane_operand(plan, op, 0), 4, 4);
    @hi = cv_gp(cv);
    cv2(cv, mir.MIR_MOV, @hi, lane_operand(plan, op, 1), 4, 4);
}

fun cv_int_to_fp(cv: *ConvEmit, plan: *LanePlan, mi: *mir.MirInstr) {
    val signed: bool = mi.opcode == mir.MIR_SI_TO_FP;
    val dw: u8 = mi.width;
    val dst: mir.MirOperand = mi.operands[0];

    var lo: mir.MirOperand;
    var hi: mir.MirOperand;
    cv_read_lanes(cv, plan, ?mi.operands[1], ?lo, ?hi);

    if (dw == 8) {
        val two32: mir.MirOperand = cv_two32(cv);
        cv_pair_to_f64(cv, dst, two32, hi, lo, signed);
        ret;
    }

    val zero: mir.MirOperand = cv_const(cv, 0);
    var sm: mir.MirOperand = zero;
    var alo: mir.MirOperand = lo;
    var ahi: mir.MirOperand = hi;
    if (signed) {
        sm = cv_gp(cv);
        cv3(cv, mir.MIR_SHR_S, sm, hi, mir.op_imm(31), 4, 4);
        val tl: mir.MirOperand = cv_gp(cv);
        cv3(cv, mir.MIR_XOR, tl, lo, sm, 4, 4);
        val th: mir.MirOperand = cv_gp(cv);
        cv3(cv, mir.MIR_XOR, th, hi, sm, 4, 4);
        val one_if_neg: mir.MirOperand = cv_gp(cv);
        cv3(cv, mir.MIR_SUB, one_if_neg, zero, sm, 4, 4);
        alo = cv_gp(cv);
        cv3(cv, mir.MIR_ADD, alo, tl, one_if_neg, 4, 4);
        val cy: mir.MirOperand = cv_gp(cv);
        cv3(cv, mir.MIR_CMP_LT_U, cy, alo, one_if_neg, 4, 4);
        ahi = cv_gp(cv);
        cv3(cv, mir.MIR_ADD, ahi, th, cy, 4, 4);
    }

    val m11: mir.MirOperand = cv_const(cv, 2047);
    val q: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_AND, q, alo, m11, 4, 4);
    val sticky: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_CMP_NE, sticky, q, zero, 4, 4);
    val r1: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_SHR_U, r1, alo, mir.op_imm(11), 4, 4);
    val r2: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_SHL, r2, ahi, mir.op_imm(21), 4, 4);
    val r3: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_OR, r3, r1, r2, 4, 4);
    val rlo: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_OR, rlo, r3, sticky, 4, 4);
    val rhi: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_SHR_U, rhi, ahi, mir.op_imm(11), 4, 4);

    val h21: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_SHR_U, h21, ahi, mir.op_imm(21), 4, 4);
    val big: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_CMP_NE, big, h21, zero, 4, 4);
    val bm: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_SUB, bm, zero, big, 4, 4);
    val nbm: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_XOR, nbm, bm, mir.op_imm(-1), 4, 4);

    val slo: mir.MirOperand = cv_gp(cv);
    val slo_a: mir.MirOperand = cv_gp(cv);
    val slo_b: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_AND, slo_a, rlo, bm, 4, 4);
    cv3(cv, mir.MIR_AND, slo_b, alo, nbm, 4, 4);
    cv3(cv, mir.MIR_OR, slo, slo_a, slo_b, 4, 4);
    val shi: mir.MirOperand = cv_gp(cv);
    val shi_a: mir.MirOperand = cv_gp(cv);
    val shi_b: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_AND, shi_a, rhi, bm, 4, 4);
    cv3(cv, mir.MIR_AND, shi_b, ahi, nbm, 4, 4);
    cv3(cv, mir.MIR_OR, shi, shi_a, shi_b, 4, 4);

    val sk: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_AND, sk, bm, m11, 4, 4);
    var sc: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_ADD, sc, sk, mir.op_imm(1), 4, 4);
    if (signed) {
        val sx: mir.MirOperand = cv_gp(cv);
        cv3(cv, mir.MIR_XOR, sx, sc, sm, 4, 4);
        val sn: mir.MirOperand = cv_gp(cv);
        cv3(cv, mir.MIR_SUB, sn, sx, sm, 4, 4);
        sc = sn;
    }
    val fsc: mir.MirOperand = cv_fp(cv);
    cv2(cv, mir.MIR_SI_TO_FP, fsc, sc, 8, 4);

    val two32: mir.MirOperand = cv_two32(cv);
    val d: mir.MirOperand = cv_fp(cv);
    cv_pair_to_f64(cv, d, two32, shi, slo, false);
    val p: mir.MirOperand = cv_fp(cv);
    cv3(cv, mir.MIR_FMUL, p, d, fsc, 8, 8);
    cv2(cv, mir.MIR_FP_TRUNC, dst, p, 4, 8);
}

fun cv_f64_to_pair(cv: *ConvEmit, two32: mir.MirOperand, inv32: mir.MirOperand,
                   x: mir.MirOperand, hi: mir.MirOperand, lo: mir.MirOperand) {
    val u: mir.MirOperand = cv_fp(cv);
    cv3(cv, mir.MIR_FMUL, u, x, inv32, 8, 8);
    cv2(cv, mir.MIR_FP_TO_UI, hi, u, 4, 8);
    val fh: mir.MirOperand = cv_fp(cv);
    cv2(cv, mir.MIR_UI_TO_FP, fh, hi, 8, 4);
    val frac: mir.MirOperand = cv_fp(cv);
    cv3(cv, mir.MIR_FSUB, frac, u, fh, 8, 8);
    val rem: mir.MirOperand = cv_fp(cv);
    cv3(cv, mir.MIR_FMUL, rem, frac, two32, 8, 8);
    cv2(cv, mir.MIR_FP_TO_UI, lo, rem, 4, 8);
}

fun cv_fp_to_int(cv: *ConvEmit, plan: *LanePlan, mi: *mir.MirInstr) {
    val signed: bool = mi.opcode == mir.MIR_FP_TO_SI;
    val dlo: mir.MirOperand = lane_operand(plan, ?mi.operands[0], 0);
    val dhi: mir.MirOperand = lane_operand(plan, ?mi.operands[0], 1);

    var x: mir.MirOperand = mi.operands[1];
    if (x.kind != mir.MIR_OP_VREG) {
        val xr: mir.MirOperand = cv_fp(cv);
        cv2(cv, mir.MIR_MOV, xr, x, mi.src_width, mi.src_width);
        x = xr;
    }
    if (mi.src_width == 4) {
        val xe: mir.MirOperand = cv_fp(cv);
        cv2(cv, mir.MIR_FP_EXT, xe, x, 8, 4);
        x = xe;
    }

    val two32: mir.MirOperand = cv_two32(cv);
    val one: mir.MirOperand = cv_const(cv, 1);
    val fone: mir.MirOperand = cv_fp(cv);
    cv2(cv, mir.MIR_UI_TO_FP, fone, one, 8, 4);
    val inv32: mir.MirOperand = cv_fp(cv);
    cv3(cv, mir.MIR_FDIV, inv32, fone, two32, 8, 8);

    if (!signed) {
        cv_f64_to_pair(cv, two32, inv32, x, dhi, dlo);
        ret;
    }

    val zero: mir.MirOperand = cv_const(cv, 0);
    val fzero: mir.MirOperand = cv_fp(cv);
    cv2(cv, mir.MIR_UI_TO_FP, fzero, zero, 8, 4);
    val neg: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_FCMP, neg, x, fzero, 8, CONV_FCC_LT);
    val dbl: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_SHL, dbl, neg, mir.op_imm(1), 4, 4);
    val sgn: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_SUB, sgn, one, dbl, 4, 4);
    val fsgn: mir.MirOperand = cv_fp(cv);
    cv2(cv, mir.MIR_SI_TO_FP, fsgn, sgn, 8, 4);
    val ax: mir.MirOperand = cv_fp(cv);
    cv3(cv, mir.MIR_FMUL, ax, x, fsgn, 8, 8);

    val uh: mir.MirOperand = cv_gp(cv);
    val ul: mir.MirOperand = cv_gp(cv);
    cv_f64_to_pair(cv, two32, inv32, ax, uh, ul);

    val nm: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_SUB, nm, zero, neg, 4, 4);
    val lim: mir.MirOperand = cv_const(cv, 0x7FFFFFFF);
    val mhi: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_ADD, mhi, lim, neg, 4, 4);
    val mlo: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_XOR, mlo, nm, mir.op_imm(-1), 4, 4);

    val g1: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_CMP_LT_U, g1, mhi, uh, 4, 4);
    val eqh: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_CMP_EQ, eqh, uh, mhi, 4, 4);
    val g2: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_CMP_LT_U, g2, mlo, ul, 4, 4);
    val ge: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_AND, ge, eqh, g2, 4, 4);
    val over: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_OR, over, g1, ge, 4, 4);
    val om: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_SUB, om, zero, over, 4, 4);
    val nom: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_XOR, nom, om, mir.op_imm(-1), 4, 4);

    val ch_a: mir.MirOperand = cv_gp(cv);
    val ch_b: mir.MirOperand = cv_gp(cv);
    val ch: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_AND, ch_a, mhi, om, 4, 4);
    cv3(cv, mir.MIR_AND, ch_b, uh, nom, 4, 4);
    cv3(cv, mir.MIR_OR, ch, ch_a, ch_b, 4, 4);
    val cl_a: mir.MirOperand = cv_gp(cv);
    val cl_b: mir.MirOperand = cv_gp(cv);
    val cl: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_AND, cl_a, mlo, om, 4, 4);
    cv3(cv, mir.MIR_AND, cl_b, ul, nom, 4, 4);
    cv3(cv, mir.MIR_OR, cl, cl_a, cl_b, 4, 4);

    val th: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_XOR, th, ch, nm, 4, 4);
    val tl: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_XOR, tl, cl, nm, 4, 4);
    cv3(cv, mir.MIR_ADD, dlo, tl, neg, 4, 4);
    val cy: mir.MirOperand = cv_gp(cv);
    cv3(cv, mir.MIR_CMP_LT_U, cy, dlo, neg, 4, 4);
    cv3(cv, mir.MIR_ADD, dhi, th, cy, 4, 4);
}

fun is_int_fp_conv(op: mir.MirOpcode) bool {
    ret mir.has(op, mir.MIRF_INT_FP_CONV);
}


fun conv_float_operand(op: mir.MirOpcode) i32 {
    if (mir.has(op, mir.MIRF_CONV_TO_FLOAT))   { ret 0; }
    if (mir.has(op, mir.MIRF_CONV_FROM_FLOAT)) { ret 1; }
    ret -1;
}


fun conv_int_width(mi: *mir.MirInstr) u8 {
    if (mi.opcode == mir.MIR_SI_TO_FP || mi.opcode == mir.MIR_UI_TO_FP) { ret mi.src_width; }
    ret mi.width;
}

fun conv_is_wide(mach: *Machine, mi: *mir.MirInstr) bool {
    if (!is_int_fp_conv(mi.opcode)) { ret false; }
    if (mi.operand_count < 2) { ret false; }
    if (mach.fp_class == FP_CLASS_NONE) { ret false; }
    ret conv_int_width(mi) > mach.lane_width;
}

fun conv_prepare(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
                 dst: *mir.MirInstr, cursor: *u32, out: *ConvEmit) err[fail.Fail] {
    if (plan.lane_width != 4 || conv_int_width(mi) != 8) {
        ret err[fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))};
    }
    val ii: u32 = 1 - (conv_float_operand(mi.opcode)::u32);
    if (mi.opcode == mir.MIR_FP_TO_SI || mi.opcode == mir.MIR_FP_TO_UI) {
        val d: *mir.MirOperand = ?mi.operands[0];
        if (d.kind != mir.MIR_OP_VREG || plan.lane_base[d.vreg.n] == LANE_NONE) {
            ret err[fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))};
        }
    } or {
        if (!operand_is_lane_ready(plan, ?mi.operands[ii], 2)) {
            ret err[fail.Fail].err{fail.message(unsupported_message(alloc, mi.opcode, mi.width))};
        }
    }
    out.alloc  = alloc;
    out.f      = f;
    out.src    = mi;
    out.dst    = dst;
    out.cursor = cursor;
    out.fp_cls = plan.mach.fp_class;
    out.fail   = false;
    ret err[fail.Fail].ok{};
}

fun conv_run(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
             dst: *mir.MirInstr, cursor: *u32) err[fail.Fail] {
    var cv: ConvEmit;
    val pr: err[fail.Fail] = conv_prepare(alloc, plan, f, mi, dst, cursor, ?cv);
    if (sel pr.err) { ret pr; }
    if (mi.opcode == mir.MIR_SI_TO_FP || mi.opcode == mir.MIR_UI_TO_FP) {
        cv_int_to_fp(?cv, plan, mi);
    } or {
        cv_fp_to_int(?cv, plan, mi);
    }
    if (cv.fail) { ret err[fail.Fail].err{fail.message("legalize: out of memory expanding a wide float conversion")}; }
    ret err[fail.Fail].ok{};
}

fun conv_piece_count(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction,
                     mi: *mir.MirInstr) res[u32, fail.Fail] {
    var n: u32 = 0;
    val r: err[fail.Fail] = conv_run(alloc, plan, f, mi, nil, ?n);
    if (sel r.err) { ret res[u32, fail.Fail].err{r.err}; }
    ret res[u32, fail.Fail].ok{n};
}

fun emit_bin(alloc: *A.Allocator, dst: *mir.MirInstr, cursor: *u32, src: *mir.MirInstr,
             opcode: mir.MirOpcode, d: mir.MirOperand, a: mir.MirOperand, b: mir.MirOperand, w: u8) err[fail.Fail] {
    var ops: [3]mir.MirOperand;
    ops[0] = d;
    ops[1] = a;
    ops[2] = b;
    ret emit_piece(alloc, dst, cursor, src, opcode, ?ops[0], 3, w);
}

fun unsupported_message(alloc: *A.Allocator, op: mir.MirOpcode, width: u8) str {
    val family: str = unsupported_family(op);
    val rj: res[str, format.FormatError] =
        format.sprint(alloc, "{} ({}, {} bytes wide)", family, mir.opcode_name(op), width);
    if (sel rj.err) { ret family; }
    ret rj.ok;
}

fun unsupported_family(op: mir.MirOpcode) str {
    if (mir.has(op, mir.MIRF_DIVIDE))    { ret "legalize: wide divide is unsupported on this target"; }
    if (mir.has(op, mir.MIRF_REMAINDER)) { ret "legalize: wide remainder is unsupported on this target"; }
    if (is_shift(op)) {
        ret "legalize: shift through an unsupported operand shape on this target";
    }
    if (mir.has(op, mir.MIRF_MEMORY)) {
        ret "legalize: wide memory access through an unsupported operand shape on this target";
    }
    if (mir.is_cmp_opcode(op)) {
        ret "legalize: wide comparison through an unsupported operand shape on this target";
    }
    if (mir.has(op, mir.MIRF_ADDRESS_PRODUCER)) {
        ret "legalize: materializing an address wider than one register is not yet legalized on this target";
    }
    if (is_int_fp_conv(op)) {
        ret "legalize: converting between a float and an integer wider than one register needs a float register bank this target does not have";
    }
    ret "legalize: operation wider than the target ALU is unsupported";
}

fun t_mach(maw: u8, ptr: u8) Machine {
    var m: Machine;
    m.lane_width = maw;
    m.ptr_width  = ptr;
    m.var_shift  = false;
    m.has_mul    = true;
    m.mul_hi     = 0;
    m.stage_lo   = 6;
    m.stage_hi   = 7;
    m.fp_class   = FP_CLASS_NONE;
    ret m;
}

fun t_vregs(alloc: *A.Allocator, f: *mir.MirFunction, n: u32) {
    val r: res[*mir.MirVReg, A.Error] = A.allocate[mir.MirVReg](alloc, n::usize);
    if (sel r.err) { ret; }
    f.vregs     = r.ok;
    f.vreg_count = n;
    f.vreg_cap   = n;
    var i: u32 = 0;
    for (i < n) {
        f.vregs[i].id         = i;
        f.vregs[i].class      = mir.REG_CLASS_GP;
        f.vregs[i].spill_slot = -1;
        f.vregs[i].assigned   = mir.MIR_PREG_NIL;
        f.vregs[i].vector     = false;
        i = i + 1;
    }
}

fun t_block(alloc: *A.Allocator, b: *mir.MirBlock, n: u32) {
    val r: res[*mir.MirInstr, A.Error] = A.zallocate[mir.MirInstr](alloc, n::usize);
    if (sel r.err) { ret; }
    b.instrs      = r.ok;
    b.instr_count = n;
    b.instr_cap   = n;
    b.id          = 0;
}

fun t_instr(alloc: *A.Allocator, b: *mir.MirBlock, ix: u32, opcode: mir.MirOpcode,
            ops: *mir.MirOperand, nops: u32, width: u8) {
    val r: res[*mir.MirOperand, A.Error] = A.allocate[mir.MirOperand](alloc, nops::usize);
    if (sel r.err) { ret; }
    val arr: *mir.MirOperand = r.ok;
    var j: u32 = 0;
    for (j < nops) { arr[j] = ops[j]; j = j + 1; }
    b.instrs[ix].opcode        = opcode;
    b.instrs[ix].operands      = arr;
    b.instrs[ix].operand_count = nops;
    b.instrs[ix].width         = width;
    b.instrs[ix].src_width     = width;
    b.instrs[ix].vec_lane      = mir.VEC_LANE_NONE;
}

test "mach.lang.be.codegen.legalize.emit_piece:refuses_to_silently_drop_a_vector_lane_source" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var dst: mir.MirBlock;
    t_block(?alloc, ?dst, 1);
    var cursor: u32 = 0;

    var src: mir.MirInstr = mir.instr(mir.MIR_ADD, nil, 0, 4, 4);
    src.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);

    val r: err[fail.Fail] = emit_piece(?alloc, dst.instrs, ?cursor, ?src, mir.MIR_ADD, nil, 0, 4);
    if (sel r.err == false) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.legalize:inert_on_native_width" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_vreg(mir.vreg_id(0)); ops[1] = mir.op_vreg(mir.vreg_id(1)); ops[2] = mir.op_vreg(mir.vreg_id(2));
    t_instr(?alloc, ?b, 0, mir.MIR_ADD, ?ops[0], 3, 8);
    f.blocks = ?b; f.block_count = 1;

    val before_ptr:   *mir.MirInstr = b.instrs;
    val before_count: u32           = b.instr_count;
    val before_vregs: u32           = f.vreg_count;

    var mach: Machine = t_mach(8, 8);
    val r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel r.err)         { ret 1; }
    if (b.instrs != before_ptr)         { ret 1; }
    if (b.instr_count != before_count)  { ret 1; }
    if (f.vreg_count != before_vregs)   { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.legalize:expands_wide_add_carry_chain" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 3);
    var m1: [2]mir.MirOperand;
    m1[0] = mir.op_vreg(mir.vreg_id(1)); m1[1] = mir.op_imm(0x0102);
    t_instr(?alloc, ?b, 0, mir.MIR_MOV, ?m1[0], 2, 2);
    var m2: [2]mir.MirOperand;
    m2[0] = mir.op_vreg(mir.vreg_id(2)); m2[1] = mir.op_imm(0x0304);
    t_instr(?alloc, ?b, 1, mir.MIR_MOV, ?m2[0], 2, 2);
    var ad: [3]mir.MirOperand;
    ad[0] = mir.op_vreg(mir.vreg_id(0)); ad[1] = mir.op_vreg(mir.vreg_id(1)); ad[2] = mir.op_vreg(mir.vreg_id(2));
    t_instr(?alloc, ?b, 2, mir.MIR_ADD, ?ad[0], 3, 2);
    f.blocks = ?b; f.block_count = 1;

    var mach: Machine = t_mach(1, 2);
    val r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel r.err) { ret 1; }

    if (f.vreg_count != 11) { ret 1; }

    if (b.instr_count != 8) { ret 1; }

    if (b.instrs[4].opcode != mir.MIR_ADD)      { ret 1; }
    if (b.instrs[4].width != 1)                 { ret 1; }
    if (b.instrs[4].operands[0].vreg.n != 7)      { ret 1; }
    if (b.instrs[5].opcode != mir.MIR_CMP_LT_U) { ret 1; }
    if (b.instrs[6].opcode != mir.MIR_ADD)      { ret 1; }
    if (b.instrs[7].opcode != mir.MIR_ADD)      { ret 1; }
    if (b.instrs[7].operands[0].vreg.n != 8)      { ret 1; }
    ret 0;
}

fun t_divmod_fn(alloc: *A.Allocator, f: *mir.MirFunction, b: *mir.MirBlock,
                op: mir.MirOpcode, width: u8, a: i64, bv: i64) {
    t_vregs(alloc, f, 3);
    t_block(alloc, b, 3);
    var ma: [2]mir.MirOperand;
    ma[0] = mir.op_vreg(mir.vreg_id(1)); ma[1] = mir.op_imm(a);
    t_instr(alloc, b, 0, mir.MIR_MOV, ?ma[0], 2, width);
    var mb: [2]mir.MirOperand;
    mb[0] = mir.op_vreg(mir.vreg_id(2)); mb[1] = mir.op_imm(bv);
    t_instr(alloc, b, 1, mir.MIR_MOV, ?mb[0], 2, width);
    var dv: [3]mir.MirOperand;
    dv[0] = mir.op_vreg(mir.vreg_id(0)); dv[1] = mir.op_vreg(mir.vreg_id(1)); dv[2] = mir.op_vreg(mir.vreg_id(2));
    t_instr(alloc, b, 2, op, ?dv[0], 3, width);
    f.blocks = b; f.block_count = 1;
}

test "mach.lang.be.codegen.legalize:expands_a_wide_divide" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(1, 2);

    var f: mir.MirFunction;
    var b: mir.MirBlock;
    t_divmod_fn(?alloc, ?f, ?b, mir.MIR_DIV_U, 2, 1000, 7);

    var plan: LanePlan;
    val plan_lanes_r: err[fail.Fail] = plan_lanes(?alloc, ?mach, ?f, ?plan);
    if (sel plan_lanes_r.err) { ret 1; }
    val rc: res[u32, fail.Fail] = divmod_piece_count(?alloc, ?plan, ?b.instrs[2]);
    if (sel rc.err) { ret 1; }
    val want: u32 = rc.ok;
    free_plan(?alloc, ?plan);

    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel legalize_function_r.err) { ret 1; }
    if (b.instr_count != 4 + want) { ret 1; }
    var i: u32 = 0;
    var probes: u32 = 0;
    var probe_at: u32 = 0;
    for (i < b.instr_count) {
        if (b.instrs[i].width != 1)            { ret 1; }
        if (b.instrs[i].opcode == mir.MIR_BR)  { ret 1; }
        if (b.instrs[i].opcode == mir.MIR_CBR) { ret 1; }
        if (b.instrs[i].opcode == mir.MIR_DIV_S || b.instrs[i].opcode == mir.MIR_REM_U || b.instrs[i].opcode == mir.MIR_REM_S) { ret 1; }
        if (b.instrs[i].opcode == mir.MIR_DIV_U) {
            if (b.instrs[i].operand_count != 3 || b.instrs[i].operands[1].kind != mir.MIR_OP_IMM
                || b.instrs[i].operands[1].imm != 1 || b.instrs[i].operands[2].kind != mir.MIR_OP_VREG) { ret 1; }
            probes = probes + 1;
            probe_at = i;
        }
        i = i + 1;
    }
    if (f.block_count != 1) { ret 1; }
    if (probes != 1) { ret 1; }

    val last: u32 = b.instr_count - 1;
    if (b.instrs[last].opcode != mir.MIR_OR)          { ret 1; }
    if (b.instrs[last].operands[0].kind != mir.MIR_OP_VREG) { ret 1; }
    if (probe_at >= last) { ret 1; }
    i = 0;
    for (i < b.instr_count) {
        if (b.instrs[i].opcode == mir.MIR_XOR && b.instrs[i].operand_count == 3
            && b.instrs[i].operands[2].kind == mir.MIR_OP_IMM && b.instrs[i].operands[2].imm == -1) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.be.codegen.legalize:divide_family_costs_agree" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(1, 2);

    var du: u32 = 0; var ds: u32 = 0; var ru: u32 = 0; var rs: u32 = 0;
    var ops: [4]mir.MirOpcode;
    ops[0] = mir.MIR_DIV_U; ops[1] = mir.MIR_DIV_S;
    ops[2] = mir.MIR_REM_U; ops[3] = mir.MIR_REM_S;
    var k: u32 = 0;
    for (k < 4) {
        var f: mir.MirFunction;
        var b: mir.MirBlock;
        t_divmod_fn(?alloc, ?f, ?b, ops[k], 2, 1000, 7);
        var plan: LanePlan;
        val plan_lanes_r: err[fail.Fail] = plan_lanes(?alloc, ?mach, ?f, ?plan);
        if (sel plan_lanes_r.err) { ret 1; }
        val rc: res[u32, fail.Fail] = divmod_piece_count(?alloc, ?plan, ?b.instrs[2]);
        if (sel rc.err) { ret 1; }
        val n: u32 = rc.ok;
        free_plan(?alloc, ?plan);
        val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
        if (sel legalize_function_r.err) { ret 1; }
        if (b.instr_count != 4 + n) { ret 1; }
        if (k == 0) { du = n; } or (k == 1) { ds = n; } or (k == 2) { ru = n; } or { rs = n; }
        k = k + 1;
    }

    if (du != ru) { ret 1; }
    if (ds <= du) { ret 1; }
    if (rs <= ru) { ret 1; }
    if (ds != rs + 1) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.legalize:multiply_costs_agree_at_every_lane_count" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var widths: [3]u8;
    widths[0] = 2; widths[1] = 4; widths[2] = 8;
    var native: u32 = 0;
    for (native < 2) {
        var mach: Machine = t_mach(1, 2);
        if (native == 1) { mach.mul_hi = 1; }

        var k: u32 = 0;
        for (k < 3) {
            var f: mir.MirFunction;
            var b: mir.MirBlock;
            t_divmod_fn(?alloc, ?f, ?b, mir.MIR_MUL, widths[k], 1000, 7);
            var plan: LanePlan;
            val plan_lanes_r: err[fail.Fail] = plan_lanes(?alloc, ?mach, ?f, ?plan);
            if (sel plan_lanes_r.err) { ret 1; }
            val rc: res[u32, fail.Fail] = mul_piece_count(?alloc, ?plan, ?b.instrs[2]);
            if (sel rc.err) { ret 1; }
            val n: u32 = rc.ok;
            free_plan(?alloc, ?plan);
            val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
            if (sel legalize_function_r.err) { ret 1; }
            if (b.instr_count != 2 * widths[k]::u32 + n) { ret 1; }
            k = k + 1;
        }
        native = native + 1;
    }
    ret 0;
}

test "mach.lang.be.codegen.legalize:a_declared_widening_multiply_selects_the_native_leaf" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    var b: mir.MirBlock;
    t_divmod_fn(?alloc, ?f, ?b, mir.MIR_MUL, 8, 1000, 7);

    var mach: Machine = t_mach(4, 4);
    mach.mul_hi = 4;
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel legalize_function_r.err) { ret 1; }

    if (b.instr_count != 4 + 8) { ret 1; }

    var muls:   u32 = 0;
    var highs:  u32 = 0;
    var shifts: u32 = 0;
    var i: u32 = 4;
    for (i < b.instr_count) {
        val op: mir.MirOpcode = b.instrs[i].opcode;
        if (op == mir.MIR_MUL)      { muls   = muls + 1; }
        if (op == mir.MIR_MUL_HI_U) { highs  = highs + 1; }
        if (op == mir.MIR_SHL || op == mir.MIR_SHR_U) { shifts = shifts + 1; }
        i = i + 1;
    }
    if (muls != 3)  { ret 1; }
    if (highs != 1) { ret 1; }
    if (shifts != 0) { ret 1; }

    var f2: mir.MirFunction;
    var b2: mir.MirBlock;
    t_divmod_fn(?alloc, ?f2, ?b2, mir.MIR_MUL, 8, 1000, 7);
    var m2: Machine = t_mach(4, 4);
    val legalize_function_r2: err[fail.Fail] = legalize_function(?alloc, ?m2, ?f2);
    if (sel legalize_function_r2.err) { ret 1; }
    var muls2:   u32 = 0;
    var shifts2: u32 = 0;
    i = 4;
    for (i < b2.instr_count) {
        val op: mir.MirOpcode = b2.instrs[i].opcode;
        if (op == mir.MIR_MUL || op == mir.MIR_MUL_HI_U) { muls2 = muls2 + 1; }
        if (op == mir.MIR_SHL || op == mir.MIR_SHR_U)    { shifts2 = shifts2 + 1; }
        i = i + 1;
    }
    if (muls2 != 0)    { ret 1; }
    if (shifts2 == 0)  { ret 1; }
    if (b2.instr_count <= b.instr_count * 10) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.legalize:refuses_an_unmodelled_widening_multiply" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    var b: mir.MirBlock;
    t_divmod_fn(?alloc, ?f, ?b, mir.MIR_MUL, 4, 1000, 7);
    var m1: Machine = t_mach(1, 2);
    m1.mul_hi = 4;
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?m1, ?f);
    if (!sel legalize_function_r.err) { ret 1; }

    var f2: mir.MirFunction;
    var b2: mir.MirBlock;
    t_divmod_fn(?alloc, ?f2, ?b2, mir.MIR_MUL, 4, 1000, 7);
    var m2: Machine = t_mach(1, 2);
    m2.mul_hi  = 1;
    m2.has_mul = false;
    val legalize_function_r2: err[fail.Fail] = legalize_function(?alloc, ?m2, ?f2);
    if (!sel legalize_function_r2.err) { ret 1; }

    var f3: mir.MirFunction;
    var b3: mir.MirBlock;
    t_divmod_fn(?alloc, ?f3, ?b3, mir.MIR_MUL, 4, 1000, 7);
    var m3: Machine = t_mach(1, 2);
    m3.mul_hi = 1;
    val legalize_function_r3: err[fail.Fail] = legalize_function(?alloc, ?m3, ?f3);
    if (sel legalize_function_r3.err) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.legalize:rejects_unsupported_wide_op" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_vreg(mir.vreg_id(0)); ops[1] = mir.op_vreg(mir.vreg_id(1)); ops[2] = mir.op_vreg(mir.vreg_id(2));
    t_instr(?alloc, ?b, 0, mir.MIR_DIV_U, ?ops[0], 3, 2);
    f.blocks = ?b; f.block_count = 1;

    var mach: Machine = t_mach(1, 2);
    val r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (!sel r.err) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.legalize:expands_wide_access_at_a_fixed_base" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 1);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var ld: [2]mir.MirOperand;
    ld[0] = mir.op_vreg(mir.vreg_id(0)); ld[1] = mir.op_mem_preg(mir.preg_id(0), 0);
    t_instr(?alloc, ?b, 0, mir.MIR_MOV, ?ld[0], 2, 4);
    f.blocks = ?b; f.block_count = 1;

    var mach: Machine = t_mach(1, 2);
    val r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel r.err)  { ret 1; }
    if (b.instr_count != 4)      { ret 1; }

    var i: u32 = 0;
    for (i < 4) {
        if (b.instrs[i].opcode != mir.MIR_LOAD)             { ret 1; }
        if (b.instrs[i].width != 1)                         { ret 1; }
        if (b.instrs[i].operands[0].vreg.n != 1 + i)          { ret 1; }
        if (b.instrs[i].operands[1].kind != mir.MIR_OP_MEM) { ret 1; }
        if (b.instrs[i].operands[1].preg.n != 0)              { ret 1; }
        if (b.instrs[i].operands[1].imm != i::i64)          { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.be.codegen.legalize:expands_a_wide_access_at_a_symbol" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 1);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var ld: [2]mir.MirOperand;
    ld[0] = mir.op_vreg(mir.vreg_id(0)); ld[1] = mir.op_sym(7, 0);
    t_instr(?alloc, ?b, 0, mir.MIR_LOAD, ?ld[0], 2, 4);
    f.blocks = ?b; f.block_count = 1;
    fin { mir.dnit_function(?alloc, ?f); }
    b.instrs[0].memory_flags = mir.MEMORY_VOLATILE;

    var mach: Machine = t_mach(2, 2);
    val r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel r.err) { ret 1; }
    if (b.instr_count != 2)     { ret 1; }

    var i: u32 = 0;
    for (i < 2) {
        if (b.instrs[i].opcode != mir.MIR_LOAD)                { ret 1; }
        if (b.instrs[i].memory_flags != mir.MEMORY_VOLATILE) { ret 2; }
        if (b.instrs[i].width != 2)                            { ret 1; }
        if (b.instrs[i].operands[0].vreg.n != 1 + i)             { ret 1; }
        if (b.instrs[i].operands[1].kind != mir.MIR_OP_SYM)    { ret 1; }
        if (b.instrs[i].operands[1].sym != 7)                  { ret 1; }
        if (b.instrs[i].operands[1].sym_off != (i * 2)::i32)   { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.be.codegen.legalize:refuses_a_wide_access_with_no_address_operand" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 2);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var ld: [2]mir.MirOperand;
    ld[0] = mir.op_vreg(mir.vreg_id(0)); ld[1] = mir.op_vreg(mir.vreg_id(1));
    t_instr(?alloc, ?b, 0, mir.MIR_LOAD, ?ld[0], 2, 4);
    f.blocks = ?b; f.block_count = 1;

    var mach: Machine = t_mach(2, 2);
    val r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (!sel r.err) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.legalize:expands_wide_preg_move_onto_consecutive_regs" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 1);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var mv: [2]mir.MirOperand;
    mv[0] = mir.op_vreg(mir.vreg_id(0)); mv[1] = mir.op_preg(mir.preg_id(4));
    t_instr(?alloc, ?b, 0, mir.MIR_MOV, ?mv[0], 2, 2);
    f.blocks = ?b; f.block_count = 1;

    var mach: Machine = t_mach(1, 2);
    val r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel r.err) { ret 1; }
    if (b.instr_count != 2)     { ret 1; }
    if (b.instrs[0].operands[0].vreg.n != 1 || b.instrs[0].operands[1].preg.n != 4) { ret 1; }
    if (b.instrs[1].operands[0].vreg.n != 2 || b.instrs[1].operands[1].preg.n != 5) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.legalize:lanes_of_a_secret_wide_value_stay_secret" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 2);
    f.vregs[0].secret = true;
    f.vregs[1].secret = false;
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 2);
    var seed: [2]mir.MirOperand;
    seed[0] = mir.op_vreg(mir.vreg_id(0)); seed[1] = mir.op_imm(0x0102);
    t_instr(?alloc, ?b, 0, mir.MIR_MOV, ?seed[0], 2, 2);
    var mv: [2]mir.MirOperand;
    mv[0] = mir.op_vreg(mir.vreg_id(1)); mv[1] = mir.op_vreg(mir.vreg_id(0));
    t_instr(?alloc, ?b, 1, mir.MIR_MOV, ?mv[0], 2, 2);
    f.blocks = ?b; f.block_count = 1;

    var mach: Machine = t_mach(1, 2);
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel legalize_function_r.err) { ret 1; }
    if (b.instr_count != 4 || f.vreg_count != 6) { ret 2; }
    var i: u32 = 2;
    for (i < 4) {
        val dst: u32 = b.instrs[i].operands[0].vreg.n;
        val src: u32 = b.instrs[i].operands[1].vreg.n;
        if (dst < 2 || src < 2)     { ret 3; }
        if (!f.vregs[src].secret)   { ret 4; }
        if (f.vregs[dst].secret)    { ret 5; }
        i = i + 1;
    }

    # control: a public wide value legalizes into public lanes
    var g: mir.MirFunction;
    t_vregs(?alloc, ?g, 2);
    g.vregs[0].secret = false;
    g.vregs[1].secret = false;
    var gb: mir.MirBlock;
    t_block(?alloc, ?gb, 2);
    t_instr(?alloc, ?gb, 0, mir.MIR_MOV, ?seed[0], 2, 2);
    t_instr(?alloc, ?gb, 1, mir.MIR_MOV, ?mv[0], 2, 2);
    g.blocks = ?gb; g.block_count = 1;
    val legalize_function_r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?g);
    if (sel legalize_function_r2.err) { ret 6; }
    i = 0;
    for (i < g.vreg_count) {
        if (g.vregs[i].secret) { ret 7; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.be.codegen.legalize:a_wide_declassify_keeps_its_barrier_per_lane" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 2);
    f.vregs[0].secret = true;
    f.vregs[1].secret = false;
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 2);
    var seed: [2]mir.MirOperand;
    seed[0] = mir.op_vreg(mir.vreg_id(0)); seed[1] = mir.op_imm(0x0102);
    t_instr(?alloc, ?b, 0, mir.MIR_MOV, ?seed[0], 2, 2);
    var dc: [2]mir.MirOperand;
    dc[0] = mir.op_vreg(mir.vreg_id(1)); dc[1] = mir.op_vreg(mir.vreg_id(0));
    t_instr(?alloc, ?b, 1, mir.MIR_DECLASSIFY, ?dc[0], 2, 2);
    f.blocks = ?b; f.block_count = 1;

    var mach: Machine = t_mach(1, 2);
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel legalize_function_r.err) { ret 1; }
    if (b.instr_count != 4) { ret 2; }
    if (b.instrs[0].opcode != mir.MIR_MOV || b.instrs[1].opcode != mir.MIR_MOV) { ret 7; }
    var i: u32 = 2;
    for (i < 4) {
        if (b.instrs[i].opcode != mir.MIR_DECLASSIFY) { ret 3; }
        if (b.instrs[i].width != 1)                   { ret 4; }
        i = i + 1;
    }

    # control: a plain wide move stays a move
    var g: mir.MirFunction;
    t_vregs(?alloc, ?g, 2);
    var gb: mir.MirBlock;
    t_block(?alloc, ?gb, 2);
    t_instr(?alloc, ?gb, 0, mir.MIR_MOV, ?seed[0], 2, 2);
    t_instr(?alloc, ?gb, 1, mir.MIR_MOV, ?dc[0], 2, 2);
    g.blocks = ?gb; g.block_count = 1;
    val legalize_function_r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?g);
    if (sel legalize_function_r2.err) { ret 5; }
    if (gb.instrs[2].opcode != mir.MIR_MOV || gb.instrs[3].opcode != mir.MIR_MOV) { ret 6; }
    ret 0;
}

test "mach.lang.be.codegen.legalize:stages_runtime_pointer_into_the_address_pair" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 4);
    var p: [2]mir.MirOperand;
    p[0] = mir.op_vreg(mir.vreg_id(0)); p[1] = mir.op_preg(mir.preg_id(4));
    t_instr(?alloc, ?b, 0, mir.MIR_MOV, ?p[0], 2, 2);
    var v: [2]mir.MirOperand;
    v[0] = mir.op_vreg(mir.vreg_id(1)); v[1] = mir.op_imm(0x01020304);
    t_instr(?alloc, ?b, 1, mir.MIR_MOV, ?v[0], 2, 4);
    var stv: [2]mir.MirOperand;
    stv[0] = mir.op_mem_value(mir.vreg_id(0), 0); stv[1] = mir.op_vreg(mir.vreg_id(1));
    t_instr(?alloc, ?b, 2, mir.MIR_STORE, ?stv[0], 2, 4);
    var ldv: [2]mir.MirOperand;
    ldv[0] = mir.op_vreg(mir.vreg_id(2)); ldv[1] = mir.op_mem_value(mir.vreg_id(0), 3);
    t_instr(?alloc, ?b, 3, mir.MIR_LOAD, ?ldv[0], 2, 1);
    f.blocks = ?b; f.block_count = 1;

    var mach: Machine = t_mach(1, 2);
    val r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel r.err) { ret 1; }
    if (b.instr_count != 15) { ret 1; }

    if (b.instrs[6].operands[0].preg.n != 6) { ret 1; }
    if (b.instrs[7].operands[0].preg.n != 7) { ret 1; }
    var i: u32 = 0;
    for (i < 4) {
        val st: *mir.MirInstr = ?b.instrs[8 + i];
        if (st.opcode != mir.MIR_STORE)             { ret 1; }
        if (st.width != 1)                          { ret 1; }
        if (st.operands[0].kind != mir.MIR_OP_MEM)  { ret 1; }
        if (!mir.vreg_is_nil(st.operands[0].vreg)){ ret 1; }
        if (st.operands[0].preg.n != 6)               { ret 1; }
        if (st.operands[0].imm != i::i64)           { ret 1; }
        i = i + 1;
    }
    if (b.instrs[12].operands[0].preg.n != 6)          { ret 1; }
    if (b.instrs[13].operands[0].preg.n != 7)          { ret 1; }
    if (b.instrs[14].opcode != mir.MIR_LOAD)         { ret 1; }
    if (b.instrs[14].operands[1].preg.n != 6)          { ret 1; }
    if (b.instrs[14].operands[1].imm != 3)           { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.legalize:value_base_is_inert_on_a_wide_pointer_target" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 2);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var ops: [2]mir.MirOperand;
    ops[0] = mir.op_vreg(mir.vreg_id(1)); ops[1] = mir.op_mem_value(mir.vreg_id(0), 0);
    t_instr(?alloc, ?b, 0, mir.MIR_LOAD, ?ops[0], 2, 8);
    f.blocks = ?b; f.block_count = 1;

    val before_ptr:   *mir.MirInstr = b.instrs;
    val before_vregs: u32           = f.vreg_count;

    var mach: Machine = t_mach(8, 8);
    val r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel r.err)       { ret 1; }
    if (b.instrs != before_ptr)       { ret 1; }
    if (b.instr_count != 1)           { ret 1; }
    if (f.vreg_count != before_vregs) { ret 1; }
    ret 0;
}

fun t_shift_fn(alloc: *A.Allocator, f: *mir.MirFunction, b: *mir.MirBlock,
               op: mir.MirOpcode, width: u8, count: mir.MirOperand) {
    t_vregs(alloc, f, 3);
    t_block(alloc, b, 3);
    var mv: [2]mir.MirOperand;
    mv[0] = mir.op_vreg(mir.vreg_id(1)); mv[1] = mir.op_imm(0x01020304);
    t_instr(alloc, b, 0, mir.MIR_MOV, ?mv[0], 2, width);
    var mn: [2]mir.MirOperand;
    mn[0] = mir.op_vreg(mir.vreg_id(2)); mn[1] = mir.op_imm(3);
    t_instr(alloc, b, 1, mir.MIR_MOV, ?mn[0], 2, 1);
    var sh: [3]mir.MirOperand;
    sh[0] = mir.op_vreg(mir.vreg_id(0)); sh[1] = mir.op_vreg(mir.vreg_id(1)); sh[2] = count;
    t_instr(alloc, b, 2, op, ?sh[0], 3, width);
    f.blocks = b; f.block_count = 1;
}

test "mach.lang.be.codegen.legalize:expands_constant_wide_shift_as_a_template" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    var b: mir.MirBlock;
    t_shift_fn(?alloc, ?f, ?b, mir.MIR_SHL, 4, mir.op_imm(3));

    var mach: Machine = t_mach(1, 2);
    val r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel r.err) { ret 1; }

    if (b.instr_count != 15) { ret 1; }
    if (b.instrs[5].opcode != mir.MIR_SHL)      { ret 1; }
    if (b.instrs[6].opcode != mir.MIR_SHR_U)    { ret 1; }
    if (b.instrs[7].opcode != mir.MIR_OR)       { ret 1; }
    if (b.instrs[7].operands[0].vreg.n != 10)     { ret 1; }
    if (b.instrs[14].opcode != mir.MIR_SHL)     { ret 1; }
    if (b.instrs[14].operands[0].vreg.n != 7)     { ret 1; }
    if (b.instrs[14].operands[1].vreg.n != 3)     { ret 1; }
    if (b.instrs[14].operands[2].imm  != 3)     { ret 1; }
    var i: u32 = 5;
    for (i < 15) {
        if (b.instrs[i].width != 1)                { ret 1; }
        if (b.instrs[i].opcode == mir.MIR_BR)      { ret 1; }
        if (b.instrs[i].opcode == mir.MIR_CBR)     { ret 1; }
        i = i + 1;
    }
    if (f.block_count != 1) { ret 1; }

    var f1: mir.MirFunction;
    var b1: mir.MirBlock;
    t_shift_fn(?alloc, ?f1, ?b1, mir.MIR_SHR_S, 1, mir.op_imm(3));
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f1);
    if (sel legalize_function_r.err) { ret 1; }
    if (b1.instr_count != 3)                     { ret 1; }
    if (b1.instrs[2].opcode != mir.MIR_SHR_S)    { ret 1; }

    var f2: mir.MirFunction;
    var b2: mir.MirBlock;
    t_shift_fn(?alloc, ?f2, ?b2, mir.MIR_SHR_S, 2, mir.op_imm(3));
    val legalize_function_r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f2);
    if (sel legalize_function_r2.err) { ret 1; }
    if (b2.instr_count != 7)                     { ret 1; }

    var f3: mir.MirFunction;
    var b3: mir.MirBlock;
    t_shift_fn(?alloc, ?f3, ?b3, mir.MIR_SHR_S, 2, mir.op_imm(8));
    val legalize_function_r3: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f3);
    if (sel legalize_function_r3.err) { ret 1; }
    if (b3.instr_count != 6)                     { ret 1; }
    if (b3.instrs[3].opcode != mir.MIR_SHR_S)    { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.legalize:expands_runtime_shift_as_a_masked_barrel" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var widths: [3]u8;   widths[0] = 1;  widths[1] = 2;  widths[2] = 4;
    var shl:    [3]u32;  shl[0]    = 20; shl[1]    = 49; shl[2]    = 112;
    var shrs:   [3]u32;  shrs[0]   = 20; shrs[1]   = 50; shrs[2]   = 113;

    var w: u32 = 0;
    for (w < 3) {
        var f: mir.MirFunction;
        var b: mir.MirBlock;
        t_shift_fn(?alloc, ?f, ?b, mir.MIR_SHL, widths[w], mir.op_vreg(mir.vreg_id(2)));
        var mach: Machine = t_mach(1, 2);
        val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
        if (sel legalize_function_r.err) { ret 1; }
        if (b.instr_count != widths[w]::u32 + 1 + shl[w]) { ret 1; }
        if (f.block_count != 1)                           { ret 1; }
        var i: u32 = 0;
        for (i < b.instr_count) {
            if (b.instrs[i].opcode == mir.MIR_BR)  { ret 1; }
            if (b.instrs[i].opcode == mir.MIR_CBR) { ret 1; }
            i = i + 1;
        }

        var f2: mir.MirFunction;
        var b2: mir.MirBlock;
        t_shift_fn(?alloc, ?f2, ?b2, mir.MIR_SHR_S, widths[w], mir.op_vreg(mir.vreg_id(2)));
        val legalize_function_r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f2);
        if (sel legalize_function_r2.err) { ret 1; }
        if (b2.instr_count != widths[w]::u32 + 1 + shrs[w]) { ret 1; }
        w = w + 1;
    }
    ret 0;
}

test "mach.lang.be.codegen.legalize:normalizes_an_out_of_range_shift_count" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(1, 2);

    var f3: mir.MirFunction;
    var b3: mir.MirBlock;
    t_shift_fn(?alloc, ?f3, ?b3, mir.MIR_SHL, 2, mir.op_imm(3));
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f3);
    if (sel legalize_function_r.err) { ret 1; }

    var f19: mir.MirFunction;
    var b19: mir.MirBlock;
    t_shift_fn(?alloc, ?f19, ?b19, mir.MIR_SHL, 2, mir.op_imm(19));
    val legalize_function_r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f19);
    if (sel legalize_function_r2.err) { ret 1; }

    if (b19.instr_count != b3.instr_count) { ret 1; }
    var i: u32 = 0;
    for (i < b3.instr_count) {
        if (b19.instrs[i].opcode != b3.instrs[i].opcode) { ret 1; }
        if (b19.instrs[i].operand_count != b3.instrs[i].operand_count) { ret 1; }
        var k: u32 = 0;
        for (k < b3.instrs[i].operand_count) {
            if (b19.instrs[i].operands[k].kind != b3.instrs[i].operands[k].kind) { ret 1; }
            if (b19.instrs[i].operands[k].imm  != b3.instrs[i].operands[k].imm)  { ret 1; }
            if (!mir.vreg_same(b19.instrs[i].operands[k].vreg, b3.instrs[i].operands[k].vreg)) { ret 1; }
            k = k + 1;
        }
        i = i + 1;
    }
    var f16: mir.MirFunction;
    var b16: mir.MirBlock;
    t_shift_fn(?alloc, ?f16, ?b16, mir.MIR_SHL, 2, mir.op_imm(16));
    val legalize_function_r3: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f16);
    if (sel legalize_function_r3.err) { ret 1; }
    if (b16.instr_count != 5)                  { ret 1; }
    if (b16.instrs[3].opcode != mir.MIR_MOV)   { ret 1; }
    if (b16.instrs[4].opcode != mir.MIR_MOV)   { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.legalize:shift_is_inert_on_a_variable_shift_machine" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var sh: [3]mir.MirOperand;
    sh[0] = mir.op_vreg(mir.vreg_id(0)); sh[1] = mir.op_vreg(mir.vreg_id(1)); sh[2] = mir.op_vreg(mir.vreg_id(2));
    t_instr(?alloc, ?b, 0, mir.MIR_SHL, ?sh[0], 3, 8);
    f.blocks = ?b; f.block_count = 1;

    val before_ptr:   *mir.MirInstr = b.instrs;
    val before_vregs: u32           = f.vreg_count;

    var mach: Machine = t_mach(8, 8);
    mach.var_shift = true;
    val r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel r.err)       { ret 1; }
    if (b.instrs != before_ptr)       { ret 1; }
    if (b.instr_count != 1)           { ret 1; }
    if (f.vreg_count != before_vregs) { ret 1; }

    mach.var_shift = false;
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel legalize_function_r.err) { ret 1; }
    if (b.instrs == before_ptr) { ret 1; }
    ret 0;
}

fun t_cmp_fn(alloc: *A.Allocator, f: *mir.MirFunction, b: *mir.MirBlock,
             op: mir.MirOpcode, width: u8) {
    t_vregs(alloc, f, 3);
    t_block(alloc, b, 3);
    var m1: [2]mir.MirOperand;
    m1[0] = mir.op_vreg(mir.vreg_id(1)); m1[1] = mir.op_imm(0x0102030405060708);
    t_instr(alloc, b, 0, mir.MIR_MOV, ?m1[0], 2, width);
    var m2: [2]mir.MirOperand;
    m2[0] = mir.op_vreg(mir.vreg_id(2)); m2[1] = mir.op_imm(0x1122334455667788);
    t_instr(alloc, b, 1, mir.MIR_MOV, ?m2[0], 2, width);
    var cm: [3]mir.MirOperand;
    cm[0] = mir.op_vreg(mir.vreg_id(0)); cm[1] = mir.op_vreg(mir.vreg_id(1)); cm[2] = mir.op_vreg(mir.vreg_id(2));
    t_instr(alloc, b, 2, op, ?cm[0], 3, width);
    f.blocks = b; f.block_count = 1;
}

test "mach.lang.be.codegen.legalize:expands_wide_equality_lane_wise" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(1, 2);

    var f: mir.MirFunction;
    var b: mir.MirBlock;
    t_cmp_fn(?alloc, ?f, ?b, mir.MIR_CMP_EQ, 2);
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel legalize_function_r.err) { ret 1; }

    if (b.instr_count != 7) { ret 1; }
    if (b.instrs[4].opcode != mir.MIR_CMP_EQ) { ret 1; }
    if (b.instrs[4].operands[1].vreg.n != 3)    { ret 1; }
    if (b.instrs[4].operands[2].vreg.n != 5)    { ret 1; }
    if (b.instrs[5].opcode != mir.MIR_CMP_EQ) { ret 1; }
    if (b.instrs[5].operands[1].vreg.n != 4)    { ret 1; }
    if (b.instrs[5].operands[2].vreg.n != 6)    { ret 1; }
    if (b.instrs[6].opcode != mir.MIR_AND)    { ret 1; }
    if (b.instrs[6].operands[0].vreg.n != 0)    { ret 1; }

    var f2: mir.MirFunction;
    var b2: mir.MirBlock;
    t_cmp_fn(?alloc, ?f2, ?b2, mir.MIR_CMP_NE, 2);
    val legalize_function_r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f2);
    if (sel legalize_function_r2.err) { ret 1; }
    if (b2.instr_count != 7)                    { ret 1; }
    if (b2.instrs[4].opcode != mir.MIR_CMP_NE)  { ret 1; }
    if (b2.instrs[5].opcode != mir.MIR_CMP_NE)  { ret 1; }
    if (b2.instrs[6].opcode != mir.MIR_OR)      { ret 1; }
    if (b2.instrs[6].operands[0].vreg.n != 0)     { ret 1; }

    var i: u32 = 4;
    for (i < 7) {
        if (b.instrs[i].width != 1)            { ret 1; }
        if (b.instrs[i].opcode == mir.MIR_BR)  { ret 1; }
        if (b.instrs[i].opcode == mir.MIR_CBR) { ret 1; }
        i = i + 1;
    }
    if (f.block_count != 1) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.legalize:expands_wide_ordered_as_a_lexicographic_walk" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(1, 2);

    var f: mir.MirFunction;
    var b: mir.MirBlock;
    t_cmp_fn(?alloc, ?f, ?b, mir.MIR_CMP_LT_U, 2);
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel legalize_function_r.err) { ret 1; }

    if (b.instr_count != 9) { ret 1; }

    if (b.instrs[4].opcode != mir.MIR_CMP_LT_U) { ret 1; }
    if (b.instrs[4].operands[1].vreg.n != 3)      { ret 1; }
    if (b.instrs[4].operands[2].vreg.n != 5)      { ret 1; }
    if (b.instrs[5].opcode != mir.MIR_CMP_LT_U) { ret 1; }
    if (b.instrs[5].operands[1].vreg.n != 4)      { ret 1; }
    if (b.instrs[6].opcode != mir.MIR_CMP_EQ)   { ret 1; }
    if (b.instrs[6].operands[1].vreg.n != 4)      { ret 1; }
    if (b.instrs[7].opcode != mir.MIR_AND)      { ret 1; }
    if (!mir.vreg_same(b.instrs[7].operands[1].vreg, b.instrs[6].operands[0].vreg)) { ret 1; }
    if (!mir.vreg_same(b.instrs[7].operands[2].vreg, b.instrs[4].operands[0].vreg)) { ret 1; }
    if (b.instrs[8].opcode != mir.MIR_OR)       { ret 1; }
    if (!mir.vreg_same(b.instrs[8].operands[1].vreg, b.instrs[5].operands[0].vreg)) { ret 1; }
    if (b.instrs[8].operands[0].vreg.n != 0)      { ret 1; }

    var fs: mir.MirFunction;
    var bs: mir.MirBlock;
    t_cmp_fn(?alloc, ?fs, ?bs, mir.MIR_CMP_LT_S, 2);
    val legalize_function_r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?fs);
    if (sel legalize_function_r2.err) { ret 1; }
    if (bs.instr_count != 11)                     { ret 1; }
    if (bs.instrs[4].opcode != mir.MIR_CMP_LT_U)  { ret 1; }
    if (bs.instrs[4].operands[1].vreg.n != 3)       { ret 1; }
    if (bs.instrs[5].opcode != mir.MIR_XOR)       { ret 1; }
    if (bs.instrs[5].operands[1].vreg.n != 4)       { ret 1; }
    if (bs.instrs[5].operands[2].imm  != 0x80)    { ret 1; }
    if (bs.instrs[6].opcode != mir.MIR_XOR)       { ret 1; }
    if (bs.instrs[6].operands[2].imm  != 0x80)    { ret 1; }
    if (bs.instrs[7].opcode != mir.MIR_CMP_LT_U)  { ret 1; }
    if (bs.instrs[10].operands[0].vreg.n != 0)      { ret 1; }
    var i: u32 = 0;
    for (i < bs.instr_count) {
        if (bs.instrs[i].opcode == mir.MIR_CMP_LT_S) { ret 1; }
        if (bs.instrs[i].opcode == mir.MIR_CMP_LE_S) { ret 1; }
        if (bs.instrs[i].opcode == mir.MIR_CMP_LE_U) { ret 1; }
        if (bs.instrs[i].opcode == mir.MIR_BR)       { ret 1; }
        if (bs.instrs[i].opcode == mir.MIR_CBR)      { ret 1; }
        i = i + 1;
    }

    var fl: mir.MirFunction;
    var bl: mir.MirBlock;
    t_cmp_fn(?alloc, ?fl, ?bl, mir.MIR_CMP_LE_U, 2);
    val legalize_function_r3: err[fail.Fail] = legalize_function(?alloc, ?mach, ?fl);
    if (sel legalize_function_r3.err) { ret 1; }
    if (bl.instr_count != 10)                    { ret 1; }
    if (bl.instrs[4].opcode != mir.MIR_CMP_LT_U) { ret 1; }
    if (bl.instrs[4].operands[1].vreg.n != 5)      { ret 1; }
    if (bl.instrs[4].operands[2].vreg.n != 3)      { ret 1; }
    if (bl.instrs[5].opcode != mir.MIR_XOR)      { ret 1; }
    if (bl.instrs[5].operands[2].imm != 1)       { ret 1; }
    if (bl.instrs[9].operands[0].vreg.n != 0)      { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.legalize:pins_wide_comparison_piece_counts" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(1, 2);

    var ops: [6]mir.MirOpcode;
    ops[0] = mir.MIR_CMP_EQ;   ops[1] = mir.MIR_CMP_NE;
    ops[2] = mir.MIR_CMP_LT_U; ops[3] = mir.MIR_CMP_LT_S;
    ops[4] = mir.MIR_CMP_LE_U; ops[5] = mir.MIR_CMP_LE_S;

    var widths: [3]u8;  widths[0] = 2; widths[1] = 4; widths[2] = 8;
    var want: [18]u32;
    want[0]  = 3;  want[1]  = 7;  want[2]  = 15;
    want[3]  = 3;  want[4]  = 7;  want[5]  = 15;
    want[6]  = 5;  want[7]  = 13; want[8]  = 29;
    want[9]  = 7;  want[10] = 15; want[11] = 31;
    want[12] = 6;  want[13] = 14; want[14] = 30;
    want[15] = 8;  want[16] = 16; want[17] = 32;

    var r: u32 = 0;
    for (r < 6) {
        var c: u32 = 0;
        for (c < 3) {
            var f: mir.MirFunction;
            var b: mir.MirBlock;
            t_cmp_fn(?alloc, ?f, ?b, ops[r], widths[c]);
            val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
            if (sel legalize_function_r.err) { ret 1; }
            if (b.instr_count != 2 * widths[c]::u32 + want[r * 3 + c]) { ret 1; }
            if (b.instrs[b.instr_count - 1].operands[0].kind != mir.MIR_OP_VREG) { ret 1; }
            if (b.instrs[b.instr_count - 1].operands[0].vreg.n != 0)               { ret 1; }
            c = c + 1;
        }
        r = r + 1;
    }
    ret 0;
}

test "mach.lang.be.codegen.legalize:leaves_a_comparison_destination_unsplit" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(1, 2);

    var f: mir.MirFunction;
    var b: mir.MirBlock;
    t_cmp_fn(?alloc, ?f, ?b, mir.MIR_CMP_EQ, 8);
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel legalize_function_r.err) { ret 1; }

    if (b.instrs[16].operands[0].vreg.n != 19) { ret 1; }

    var writes_v0: u32 = 0;
    var i: u32 = 0;
    for (i < b.instr_count) {
        if (b.instrs[i].operands[0].kind == mir.MIR_OP_VREG &&
            b.instrs[i].operands[0].vreg.n == 0) { writes_v0 = writes_v0 + 1; }
        i = i + 1;
    }
    if (writes_v0 != 1)                                   { ret 1; }
    if (b.instrs[b.instr_count - 1].operands[0].vreg.n != 0) { ret 1; }
    if (b.instrs[b.instr_count - 1].width != 1)            { ret 1; }

    i = 16;
    for (i < b.instr_count) {
        if (b.instrs[i].width != 1) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.be.codegen.legalize:rejects_a_wide_comparison_of_an_unsupported_shape" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(1, 2);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 3);
    var m1: [2]mir.MirOperand;
    m1[0] = mir.op_vreg(mir.vreg_id(1)); m1[1] = mir.op_imm(0x0102);
    t_instr(?alloc, ?b, 0, mir.MIR_MOV, ?m1[0], 2, 2);
    var m2: [2]mir.MirOperand;
    m2[0] = mir.op_vreg(mir.vreg_id(2)); m2[1] = mir.op_imm(0x0304);
    t_instr(?alloc, ?b, 1, mir.MIR_MOV, ?m2[0], 2, 2);
    var cm: [3]mir.MirOperand;
    cm[0] = mir.op_preg(mir.preg_id(4)); cm[1] = mir.op_vreg(mir.vreg_id(1)); cm[2] = mir.op_vreg(mir.vreg_id(2));
    t_instr(?alloc, ?b, 2, mir.MIR_CMP_LT_U, ?cm[0], 3, 2);
    f.blocks = ?b; f.block_count = 1;

    val before: *mir.MirInstr = b.instrs;
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (!sel legalize_function_r.err) { ret 1; }
    if (b.instrs != before)     { ret 1; }
    if (b.instr_count != 3)     { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.legalize:rejects_a_shift_at_a_non_power_of_two_width" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    var b: mir.MirBlock;
    t_shift_fn(?alloc, ?f, ?b, mir.MIR_SHL, 3, mir.op_vreg(mir.vreg_id(2)));
    var mach: Machine = t_mach(1, 2);
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (!sel legalize_function_r.err) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.legalize:a_float_is_not_split_into_integer_lanes" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 2);
    f.vregs[0].class = mir.REG_CLASS_GP + 1;
    f.vregs[1].class = mir.REG_CLASS_GP + 1;
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var mv: [2]mir.MirOperand;
    mv[0] = mir.op_vreg(mir.vreg_id(0)); mv[1] = mir.op_vreg(mir.vreg_id(1));
    t_instr(?alloc, ?b, 0, mir.MIR_MOV, ?mv[0], 2, 8);
    f.blocks = ?b; f.block_count = 1;

    val before_ptr:   *mir.MirInstr = b.instrs;
    val before_count: u32           = b.instr_count;
    val before_vregs: u32           = f.vreg_count;

    var mach: Machine = t_mach(4, 4);
    val r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel r.err)        { ret 1; }
    if (b.instrs != before_ptr)        { ret 1; }
    if (b.instr_count != before_count) { ret 1; }
    if (f.vreg_count != before_vregs)  { ret 1; }

    var gf: mir.MirFunction;
    t_vregs(?alloc, ?gf, 2);
    var gb: mir.MirBlock;
    t_block(?alloc, ?gb, 1);
    var gi: [2]mir.MirOperand;
    gi[0] = mir.op_vreg(mir.vreg_id(0)); gi[1] = mir.op_imm(0x0102030405060708);
    t_instr(?alloc, ?gb, 0, mir.MIR_MOV, ?gi[0], 2, 8);
    gf.blocks = ?gb; gf.block_count = 1;

    val gr: err[fail.Fail] = legalize_function(?alloc, ?mach, ?gf);
    if (sel gr.err)   { ret 1; }
    if (gb.instr_count != 2)       { ret 1; }
    if (gf.vreg_count <= 2)        { ret 1; }

    var sf: mir.MirFunction;
    t_vregs(?alloc, ?sf, 2);
    var sb: mir.MirBlock;
    t_block(?alloc, ?sb, 1);
    t_instr(?alloc, ?sb, 0, mir.MIR_MOV, ?gi[0], 2, 8);
    sf.blocks = ?sb; sf.block_count = 1;

    var m8: Machine = t_mach(1, 2);
    val sr: err[fail.Fail] = legalize_function(?alloc, ?m8, ?sf);
    if (sel sr.err) { ret 1; }
    if (sb.instr_count != 8)     { ret 1; }
    if (sf.vreg_count <= 2)      { ret 1; }
    ret 0;
}

fun t_has_wide_conv(b: *mir.MirBlock, lw: u8) bool {
    var i: u32 = 0;
    for (i < b.instr_count) {
        val mi: *mir.MirInstr = ?b.instrs[i];
        if (is_int_fp_conv(mi.opcode) && conv_int_width(mi) > lw) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun t_conv_fn(alloc: *A.Allocator, f: *mir.MirFunction, b: *mir.MirBlock,
              opcode: mir.MirOpcode, fp_cls: u32, dw: u8, sw: u8) {
    t_vregs(alloc, f, 3);
    val fp_is_dst: bool = opcode == mir.MIR_SI_TO_FP || opcode == mir.MIR_UI_TO_FP;
    if (fp_is_dst) { f.vregs[0].class = fp_cls; }
    or             { f.vregs[1].class = fp_cls; }
    t_block(alloc, b, 2);
    var mv: [2]mir.MirOperand;
    mv[0] = mir.op_vreg(mir.vreg_id(2)); mv[1] = mir.op_imm(0x0102030405060708);
    t_instr(alloc, b, 0, mir.MIR_MOV, ?mv[0], 2, 8);
    var cv: [2]mir.MirOperand;
    cv[0] = mir.op_vreg(mir.vreg_id(0));
    cv[1] = mir.op_vreg(mir.vreg_id(1));
    if (fp_is_dst) { cv[1] = mir.op_vreg(mir.vreg_id(2)); }
    or             { cv[0] = mir.op_vreg(mir.vreg_id(2)); }
    t_instr(alloc, b, 1, opcode, ?cv[0], 2, dw);
    b.instrs[1].src_width = sw;
    f.blocks = b; f.block_count = 1;
}

test "mach.lang.be.codegen.legalize:open_codes_a_wide_int_float_conversion" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val fp: u32 = mir.REG_CLASS_GP + 1;
    var mach: Machine = t_mach(4, 4);
    mach.fp_class = fp;

    var f1: mir.MirFunction;
    var b1: mir.MirBlock;
    t_conv_fn(?alloc, ?f1, ?b1, mir.MIR_SI_TO_FP, fp, 8, 8);
    val r1: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f1);
    if (sel r1.err)          { ret 1; }
    if (t_has_wide_conv(?b1, 4))          { ret 1; }
    if (b1.instr_count != 11)             { ret 1; }
    if (f1.vregs[0].class != fp)          { ret 1; }

    var f2: mir.MirFunction;
    var b2: mir.MirBlock;
    t_conv_fn(?alloc, ?f2, ?b2, mir.MIR_FP_TO_UI, fp, 8, 8);
    val r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f2);
    if (sel r2.err)          { ret 1; }
    if (t_has_wide_conv(?b2, 4))          { ret 1; }
    if (b2.instr_count != 14)             { ret 1; }

    var f3: mir.MirFunction;
    var b3: mir.MirBlock;
    t_conv_fn(?alloc, ?f3, ?b3, mir.MIR_FP_TO_SI, fp, 8, 8);
    val r3: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f3);
    if (sel r3.err)          { ret 1; }
    if (t_has_wide_conv(?b3, 4))          { ret 1; }
    if (b3.instr_count != 43)             { ret 1; }

    var f4: mir.MirFunction;
    var b4: mir.MirBlock;
    t_conv_fn(?alloc, ?f4, ?b4, mir.MIR_SI_TO_FP, fp, 4, 8);
    val r4: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f4);
    if (sel r4.err)          { ret 1; }
    if (t_has_wide_conv(?b4, 4))          { ret 1; }
    if (b4.instr_count != 44)             { ret 1; }

    var f5: mir.MirFunction;
    var b5: mir.MirBlock;
    t_conv_fn(?alloc, ?f5, ?b5, mir.MIR_SI_TO_FP, mir.REG_CLASS_GP, 8, 8);
    var m8: Machine = t_mach(1, 2);
    val r5: err[fail.Fail] = legalize_function(?alloc, ?m8, ?f5);
    if (sel r5.ok)           { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.legalize:a_wide_conversion_is_inert_on_a_wide_alu" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val fp: u32 = mir.REG_CLASS_GP + 1;

    var f: mir.MirFunction;
    var b: mir.MirBlock;
    t_conv_fn(?alloc, ?f, ?b, mir.MIR_SI_TO_FP, fp, 8, 8);
    val before_ptr:   *mir.MirInstr = b.instrs;
    val before_count: u32           = b.instr_count;
    val before_vregs: u32           = f.vreg_count;

    var mach: Machine = t_mach(8, 8);
    mach.fp_class = fp;
    val r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f);
    if (sel r.err)        { ret 1; }
    if (b.instrs != before_ptr)        { ret 1; }
    if (b.instr_count != before_count) { ret 1; }
    if (f.vreg_count != before_vregs)  { ret 1; }
    ret 0;
}
