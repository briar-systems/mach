# width legalization: rewrite MIR the target's ALU cannot execute into native
# sequences
#
# A shared backend pass that runs between MIR lowering (`mir.lower_ir`) and
# instruction selection (`isel.run`). It reads two declared machine facts - the
# target's `MachineModel.max_alu_width` (the widest integer operation the ISA
# computes in one native step, in bytes) and `MachineModel.has_var_shift` (whether
# the ISA shifts by a runtime count at all) - and rewrites every scalar MIR
# instruction they say the ISA cannot realize into a sequence of native ones, so
# selection and the encoder never see such an operation. It is the wide-integer
# analogue of the middle end's `scalarize` pass (which legalizes vectors before
# codegen): scalarize splits a 128-bit vector into lane scalars, this splits a wide
# scalar into native-width byte lanes.
#
# THE INERTNESS CONTRACT. Every 64-bit target declares `max_alu_width = 8` and
# `has_var_shift = true`, and the language's widest scalar is 64-bit (pointers
# included), so on x86-64 / aarch64 / riscv64 no scalar instruction is ever wider
# than the native ALU and no shift is ever one the ISA lacks. The pass proves this
# per function with a single pre-scan (`function_needs_legalize`) and, when nothing
# needs legalizing, RETURNS HAVING TOUCHED NOTHING - no
# allocation, no vreg added, no block rebuilt. The output is therefore byte-
# identical to a build without this pass on every wide-native target; only a
# target that declares a narrow ALU (the 8-bit mos6502 declares 1) drives the
# rewrite. A 128-bit vector instruction (`vec_lane != 0`) is never legalized here:
# it is the vector path's responsibility and was already legalized (or rejected)
# in the middle end.
#
# THE MODEL. A wide value is one vreg; the pass splits it into
# `width / max_alu_width` native-width LANE vregs (lane 0 the least significant),
# assigned once up front for the whole function so a value defined in one block
# and used in another agrees on its lanes. Each wide instruction then expands into
# per-lane native-width instructions: bitwise ops lane-wise, add / sub as an
# explicit CARRY CHAIN (the carry is a computed value, not a hardware flag - this
# IR models no flag register, so a byte carry must be materialized with an
# unsigned compare and threaded as an ordinary vreg), widen / narrow / copy as
# byte moves, and loads / stores as per-lane accesses at successive displacements.
#
# THE ALGORITHM-VS-TEMPLATE SPLIT (documented for the design record). The bitwise
# and copy expansions are naturally rule-shaped (one native op per lane). The
# arithmetic carry chain is an ALGORITHM, not a template: it computes each lane's
# carry-out with a compare and feeds it into the next lane, which no fixed
# per-lane opcode substitution can express. Both live here rather than being
# forced into the selection rule engine, because they are width-driven and
# target-blind - the same expansion serves any ISA that declares a narrow ALU.
#
# THE SHIFT IS BOTH. A constant-count shift is a pure TEMPLATE - a lane renaming plus
# a fixed number of native shifts, with the bits that cross a lane boundary supplied
# by the neighbour - and needs no more machinery than the bitwise ops do. A
# RUNTIME-count shift is an ALGORITHM: a masked barrel over log2(width) stages, each
# deciding arithmetically (not by branching) whether to apply a constant-distance
# shift. Both are straight-line, so neither needs the control flow a variable shift
# was long assumed to require, and the barrel is fixed-cycle by construction. The
# pass owns EVERY shift on a machine declaring `has_var_shift = false`, including
# normalizing an out-of-range count to the operation width, so the backend below it
# only ever sees a native shift at a constant in-range count.
#
# THE ADDRESS IS A VALUE TOO. A target whose registers are narrower than an address
# (mos6502: 8-bit registers, 16-bit pointers) cannot hold a runtime pointer in one
# register either, so a memory access through one is legalized as well - at ANY
# access width, not only a wide one. The pointer's own lanes are staged into the
# backend's reserved address-staging pair (`RegMachine.scratch_reg` /
# `scratch_reg2`, the registers reserved for exactly this address materialization)
# and the access is then decomposed at that FIXED base, one native-width piece per
# lane at successive displacements. Leaving a narrow access through such a pointer
# alone would be a silent miscompile, not merely an unimplemented case: the wide
# pointer's defining instruction is replaced by its lane moves, so an un-rewritten
# base would name a vreg nothing defines.
#
# UNSUPPORTED WIDE OPERATIONS fail loudly and specifically (never silently), the
# same discipline the vector path uses for an unimplemented lane op: a wide
# multiply by a non-constant, any wide divide / remainder, a wide floating-point op,
# a shift at a width that is not a power of two, and any other operation carrying a
# runtime-pointer memory operand are rejected with a diagnostic naming the
# operation and width.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use std.allocator.page;

use A: std.allocator;
use R: std.types.result;

use mach.lang.be.codegen.mir;
use mach.lang.target.isa;
use target: mach.lang.target.resolved;

# the machine facts the pass reads, lifted off the resolved target once
#
# Keeping them in a record rather than threading the whole `target.Target` is what
# lets the pass be exercised directly by its own tests, and it names the exact four
# facts legalization depends on.
# ---
# lane_width: the native ALU width in bytes (`model.max_alu_width`); one lane
# ptr_width:  an address's byte width (`model.pointer_width`)
# var_shift:  whether the ISA shifts by a RUNTIME count at all
#             (`model.has_var_shift`); false hands this pass every shift
# stage_lo:   low half of the backend's reserved address-staging register pair
#             (`RegMachine.scratch_reg`), the fixed base a runtime-pointer access
#             is decomposed at
# stage_hi:   high half of that pair (`RegMachine.scratch_reg2`)
rec Machine {
    lane_width: u8;
    ptr_width:  u8;
    var_shift:  bool;
    stage_lo:   i32;
    stage_hi:   i32;
}

# per-function legalization plan: the lane assignment for every wide vreg
#
# `lane_base[v]` is the first of a wide vreg `v`'s contiguous native-width lane
# vregs (lane `i` is `lane_base[v] + i`), or `LANE_NONE` when `v` is not wide.
# `lane_count[v]` is `v`'s lane count (`width / max_alu_width`), 0 when not wide.
# Both arrays are sized to the function's ORIGINAL vreg count; the lane vregs
# appended during planning are never themselves wide, so they need no entry.
# ---
# lane_base:  first lane vreg id per original vreg (LANE_NONE when not wide)
# lane_count: lane count per original vreg (0 when not wide)
# orig_count: the function's vreg count before lane vregs were appended
# lane_width: the native ALU width in bytes (one lane's byte width)
# mach:       the machine facts the expansions read
rec LanePlan {
    lane_base:  *u32;
    lane_count: *u8;
    orig_count: u32;
    lane_width: u8;
    mach:       Machine;
}

# sentinel "vreg is not wide" in a LanePlan's `lane_base`
val LANE_NONE: u32 = 0xFFFFFFFF;

# legalize every function of a MIR module to the target's native ALU width
#
# The shared entry point the codegen driver calls between `lower_ir` and
# `isel.run`. Reads `tgt.model.max_alu_width` and, per function, rewrites any
# scalar instruction wider than it into native-width sequences. Provably inert on
# a target whose native ALU already covers every scalar (the wide-native targets):
# the per-function pre-scan finds nothing to legalize and the function is returned
# untouched.
# ---
# tgt: resolved compilation target (supplies `model.max_alu_width`)
# m:   the MIR module to legalize in place
# ret: ok(true) on success, or an error naming the first unsupported wide op
pub fun run(tgt: *target.Target, m: *mir.MirModule) R.Result[bool, str] {
    if (tgt == nil) { ret R.err[bool, str]("legalize: nil target"); }
    if (m == nil)   { ret R.err[bool, str]("legalize: nil mir module"); }

    val maw: u32 = tgt.model.max_alu_width;
    # a target that declares no native ALU width (0) legalizes nothing: treat it as
    # already-native so the pass stays a strict no-op rather than dividing by zero.
    if (maw == 0) { ret R.ok[bool, str](true); }

    var mach: Machine;
    mach.lane_width = maw::u8;
    mach.ptr_width  = tgt.model.pointer_width::u8;
    mach.var_shift  = tgt.model.has_var_shift;
    mach.stage_lo   = -1;
    mach.stage_hi   = -1;
    # a register machine declares the reserved scratch pair; a whole-module emitter
    # has no RegMachine at all and never drives a rewrite that needs one.
    if (tgt.arch != nil) {
        mach.stage_lo = tgt.arch.scratch_reg;
        mach.stage_hi = tgt.arch.scratch_reg2;
    }

    var i: u32 = 0;
    for (i < m.function_len) {
        val res_fn: R.Result[bool, str] = legalize_function(m.alloc, ?mach, ?m.functions[i]);
        if (R.is_err[bool, str](res_fn)) { ret res_fn; }
        i = i + 1;
    }
    ret R.ok[bool, str](true);
}

# whether any scalar instruction of the function needs legalizing
#
# The inertness gate: when this returns false the function is returned untouched -
# no allocation, no mutation - so a wide-native target's output is byte-identical.
# ---
# f:    the MIR function to scan
# mach: the machine facts (native lane width, pointer width, shift capability)
# ret:  true when some scalar instruction needs legalization
fun function_needs_legalize(f: *mir.MirFunction, mach: *Machine) bool {
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val b: *mir.MirBlock = ?f.blocks[bi];
        var ii: u32 = 0;
        for (ii < b.instr_count) {
            if (instr_needs_legalize(f, ?b.instrs[ii], mach)) { ret true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

# whether one SCALAR instruction operates wider than the native ALU, reaches memory
# through an address wider than one register, or is a shift the ISA has no
# instruction for
#
# A 128-bit vector instruction is never legalized here - it is the vector path's
# concern (scalarized or selected in the middle end / vector isel). vec_lane is
# the usual vector marker, but the phi/merge move splice in `mir.lower` carries a
# 16-byte width WITHOUT stamping vec_lane, so the vreg table's `vector` flag is
# the authoritative signal a value rides the vector bank; both are honored.
#
# The address clause is what makes a NARROW access through a runtime pointer
# legalizable on a narrow-register target: the pointer is a wide value, so its
# defining instruction is replaced by lane moves and a base left naming it would
# name nothing. On every wide-native target the pointer is a machine word, the
# clause is dead, and the gate is exactly the width test it always was.
#
# The SHIFT clause is what makes this pass the sole owner of shifts on a machine
# declaring `has_var_shift = false` (#2217). It admits EVERY shift there, not just a
# wide or a runtime-count one, because the pass then also owns normalizing the count
# to the operation width - and a normalization that fired only sometimes would leave
# the encoder needing the same rule anyway. A native shift at an in-range constant
# count rewrites to itself, so the clause costs nothing where nothing is needed. On an
# ISA with a variable shift the clause is dead and the gate is the width test alone.
# ---
# f:    the MIR function (for vreg classes / the vector flag)
# mi:   the instruction to test
# mach: the machine facts (native lane width, pointer width, shift capability)
# ret:  true when the instruction needs legalization
fun instr_needs_legalize(f: *mir.MirFunction, mi: *mir.MirInstr, mach: *Machine) bool {
    if (instr_is_vector(f, mi)) { ret false; }
    if (mi.width > mach.lane_width || mi.src_width > mach.lane_width) { ret true; }
    if (!mach.var_shift && is_shift(mi.opcode)) { ret true; }
    ret mach.ptr_width > mach.lane_width && instr_has_value_base(mi);
}

# whether an opcode is one of the three integer shifts
# ---
# op:  the opcode to classify
# ret: true for a left, logical-right, or arithmetic-right shift
fun is_shift(op: mir.MirOpcode) bool {
    ret op == mir.MIR_SHL || op == mir.MIR_SHR_U || op == mir.MIR_SHR_S;
}

# whether the instruction carries a memory operand based on a value vreg
#
# A physical-register base (`[fp + off]`) is already a fixed base and needs no
# rewriting. A frame-slot key rides the same field as a value base and is
# indistinguishable here; it is admitted conservatively and the expansion, which
# consults the lane plan, treats it as the fixed base it is.
# ---
# mi:  the instruction to test
# ret: true when some operand is a MEM with a vreg base
fun instr_has_value_base(mi: *mir.MirInstr) bool {
    var k: u32 = 0;
    for (k < mi.operand_count) {
        val op: *mir.MirOperand = ?mi.operands[k];
        if (op.kind == mir.MIR_OP_MEM && op.vreg != mir.MIR_VREG_NIL) { ret true; }
        k = k + 1;
    }
    ret false;
}

# whether an instruction rides the 128-bit vector bank (via its lane descriptor or
# any vector-flagged vreg operand)
# ---
# f:  the MIR function owning the vreg table
# mi: the instruction to test
# ret: true when the instruction is a vector op
fun instr_is_vector(f: *mir.MirFunction, mi: *mir.MirInstr) bool {
    if (mi.vec_lane != mir.VEC_LANE_NONE) { ret true; }
    var k: u32 = 0;
    for (k < mi.operand_count) {
        val op: *mir.MirOperand = ?mi.operands[k];
        if (op.kind == mir.MIR_OP_VREG && op.vreg < f.vreg_count && f.vregs[op.vreg].vector) { ret true; }
        k = k + 1;
    }
    ret false;
}

# legalize one function to the native ALU width
#
# Returns immediately (inert) when the function has no wide scalar instruction.
# Otherwise assigns lane vregs for every wide vreg, then rebuilds every block with
# each wide instruction replaced by its native-width expansion.
# ---
# alloc: backing allocator for lane vregs and rebuilt blocks
# mach:  the machine facts the expansions read
# f:     the MIR function to legalize in place
# ret:   ok(true) on success, or an error naming an unsupported wide op
fun legalize_function(alloc: *A.Allocator, mach: *Machine, f: *mir.MirFunction) R.Result[bool, str] {
    if (!function_needs_legalize(f, mach)) { ret R.ok[bool, str](true); }

    var plan: LanePlan;
    val res_plan: R.Result[bool, str] = plan_lanes(alloc, mach, f, ?plan);
    if (R.is_err[bool, str](res_plan)) { ret res_plan; }

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val res_b: R.Result[bool, str] = legalize_block(alloc, ?plan, f, ?f.blocks[bi]);
        if (R.is_err[bool, str](res_b)) { free_plan(alloc, ?plan); ret res_b; }
        bi = bi + 1;
    }

    free_plan(alloc, ?plan);
    ret R.ok[bool, str](true);
}

# assign native-width lane vregs for every wide vreg of the function
#
# A vreg is wide when the instruction defining it (operand 0 a VREG destination)
# operates at a width greater than the native ALU. Each such vreg gets
# `width / maw` fresh contiguous lane vregs of its own register class. The plan
# arrays are sized to the pre-expansion vreg count.
# ---
# alloc: backing allocator for the plan arrays and the lane vregs
# mach:  the machine facts (supplies the native lane width)
# f:     the MIR function
# out:   receives the populated LanePlan
# ret:   ok(true) on success, or an allocation error
fun plan_lanes(alloc: *A.Allocator, mach: *Machine, f: *mir.MirFunction, out: *LanePlan) R.Result[bool, str] {
    val maw: u8 = mach.lane_width;
    val n: u32 = f.vreg_count;
    val res_base: R.Result[*u32, str] = A.allocate[u32](alloc, n::usize);
    if (R.is_err[*u32, str](res_base)) { ret R.err[bool, str](R.unwrap_err[*u32, str](res_base)); }
    val res_cnt: R.Result[*u8, str] = A.allocate[u8](alloc, n::usize);
    if (R.is_err[*u8, str](res_cnt)) {
        A.deallocate[u32](alloc, R.unwrap_ok[*u32, str](res_base), n::usize);
        ret R.err[bool, str](R.unwrap_err[*u8, str](res_cnt));
    }
    out.lane_base  = R.unwrap_ok[*u32, str](res_base);
    out.lane_count = R.unwrap_ok[*u8, str](res_cnt);
    out.orig_count = n;
    out.lane_width = maw;
    out.mach       = @mach;

    var v: u32 = 0;
    for (v < n) {
        out.lane_base[v]  = LANE_NONE;
        out.lane_count[v] = 0;
        v = v + 1;
    }

    # find each wide vreg by its defining instruction's width, then allocate its
    # lanes. one forward walk suffices: a vreg is defined once (MIR is not strict
    # SSA post-lowering, but every value vreg has a single defining width).
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val b: *mir.MirBlock = ?f.blocks[bi];
        var ii: u32 = 0;
        for (ii < b.instr_count) {
            val mi: *mir.MirInstr = ?b.instrs[ii];
            if (!instr_is_vector(f, mi) && mir.instr_defines_shape(mi) &&
                mi.width > maw && mi.operand_count > 0 &&
                mi.operands[0].kind == mir.MIR_OP_VREG) {
                val dv: u32 = mi.operands[0].vreg;
                if (dv < n && out.lane_base[dv] == LANE_NONE) {
                    val nlanes: u32 = (mi.width / maw)::u32;
                    val res_l: R.Result[u32, str] = alloc_lanes(alloc, f, dv, nlanes);
                    if (R.is_err[u32, str](res_l)) {
                        free_plan(alloc, out);
                        ret R.err[bool, str](R.unwrap_err[u32, str](res_l));
                    }
                    out.lane_base[dv]  = R.unwrap_ok[u32, str](res_l);
                    out.lane_count[dv] = nlanes::u8;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret R.ok[bool, str](true);
}

# append `nlanes` fresh contiguous lane vregs sharing the wide vreg's class
# ---
# alloc:  backing allocator for the vreg table growth
# f:      the MIR function whose vreg table grows
# wide:   the wide vreg whose class the lanes inherit
# nlanes: number of lane vregs to append
# ret:    the first lane vreg id, or an allocation error
fun alloc_lanes(alloc: *A.Allocator, f: *mir.MirFunction, wide: u32, nlanes: u32) R.Result[u32, str] {
    val cls: u32 = f.vregs[wide].class;
    var base: u32 = mir.MIR_VREG_NIL;
    var i: u32 = 0;
    for (i < nlanes) {
        val res_v: R.Result[u32, str] = new_vreg(alloc, f, cls);
        if (R.is_err[u32, str](res_v)) { ret res_v; }
        val vid: u32 = R.unwrap_ok[u32, str](res_v);
        if (i == 0) { base = vid; }
        i = i + 1;
    }
    ret R.ok[u32, str](base);
}

# append a fresh virtual register in the given class and return its id
#
# The post-lowering analogue of `mir.context.new_vreg` (which needs a lowering
# context); legalization has only the function and an allocator. Grows the vreg
# table on demand.
# ---
# alloc: backing allocator for the vreg table
# f:     the MIR function whose vreg table grows
# cls:   register-class index the new vreg belongs to
# ret:   the new vreg id, or an allocation error
fun new_vreg(alloc: *A.Allocator, f: *mir.MirFunction, cls: u32) R.Result[u32, str] {
    if (f.vreg_count >= f.vreg_cap) {
        var new_cap: u32 = f.vreg_cap * 2;
        if (new_cap == 0) { new_cap = mir.INITIAL_VREG_CAP; }
        val res_v: R.Result[*mir.MirVReg, str] = A.reallocate[mir.MirVReg](alloc, f.vregs, f.vreg_cap::usize, new_cap::usize);
        if (R.is_err[*mir.MirVReg, str](res_v)) { ret R.err[u32, str](R.unwrap_err[*mir.MirVReg, str](res_v)); }
        f.vregs    = R.unwrap_ok[*mir.MirVReg, str](res_v);
        f.vreg_cap = new_cap;
    }
    val vid: u32 = f.vreg_count;
    # the durable taint is re-derived over the final MIR, so false is the correct
    # start state here, matching its twin mir.context.new_vreg (#1646).
    f.vregs[vid] = mir.vreg(vid, cls, false, false);
    f.vreg_count = f.vreg_count + 1;
    ret R.ok[u32, str](vid);
}

# release a lane plan's arrays
# ---
# alloc: allocator the plan arrays came from
# plan:  the plan to free
fun free_plan(alloc: *A.Allocator, plan: *LanePlan) {
    if (plan.lane_base != nil)  { A.deallocate[u32](alloc, plan.lane_base, plan.orig_count::usize); plan.lane_base = nil; }
    if (plan.lane_count != nil) { A.deallocate[u8](alloc, plan.lane_count, plan.orig_count::usize); plan.lane_count = nil; }
}

# rebuild one block with every wide instruction replaced by its native-width
# expansion
#
# Two passes mirroring the rules engine's expand path: pass 1 sums the output
# instruction count (and fails loudly on an unsupported wide op before mutating
# anything), pass 2 writes a fresh exactly-sized array, moving each native
# instruction 1:1 (transferring operand ownership) and emitting each wide
# instruction's lane sequence. The old instruction array is released and swapped
# out, so module teardown still frees everything exactly once.
# ---
# alloc: backing allocator for the rebuilt array and lane temporaries
# plan:  the function's lane assignment
# f:     the MIR function (for appending carry / temp vregs)
# b:     the block to rebuild in place
# ret:   ok(true) on success, or an error naming an unsupported wide op
fun legalize_block(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, b: *mir.MirBlock) R.Result[bool, str] {
    val n: u32 = b.instr_count;
    if (n == 0) { ret R.ok[bool, str](true); }

    var total:        u32  = 0;
    var needs_expand: bool = false;
    var i: u32 = 0;
    for (i < n) {
        val mi: *mir.MirInstr = ?b.instrs[i];
        if (instr_needs_legalize(f, mi, ?plan.mach)) {
            val res_c: R.Result[u32, str] = expansion_count(plan, mi);
            if (R.is_err[u32, str](res_c)) { ret R.err[bool, str](R.unwrap_err[u32, str](res_c)); }
            total = total + R.unwrap_ok[u32, str](res_c);
            needs_expand = true;
        }
        or { total = total + 1; }
        i = i + 1;
    }

    if (!needs_expand) { ret R.ok[bool, str](true); }

    val res_dst: R.Result[*mir.MirInstr, str] = A.zallocate[mir.MirInstr](alloc, total::usize);
    if (R.is_err[*mir.MirInstr, str](res_dst)) { ret R.err[bool, str](R.unwrap_err[*mir.MirInstr, str](res_dst)); }
    val dst: *mir.MirInstr = R.unwrap_ok[*mir.MirInstr, str](res_dst);

    var w: u32 = 0;
    i = 0;
    for (i < n) {
        val mi: *mir.MirInstr = ?b.instrs[i];
        if (instr_needs_legalize(f, mi, ?plan.mach)) {
            val res_e: R.Result[bool, str] = expand_instr(alloc, plan, f, mi, dst, ?w);
            if (R.is_err[bool, str](res_e)) {
                # the pieces already written into dst own fresh operand copies; free
                # them and the array, leaving b.instrs intact for module teardown.
                free_pieces(alloc, dst, w);
                A.deallocate[mir.MirInstr](alloc, dst, total::usize);
                ret res_e;
            }
            free_source_operands(alloc, mi);
        }
        or {
            dst[w] = @mi;
            w = w + 1;
        }
        i = i + 1;
    }

    if (b.instrs != nil && b.instr_cap > 0) {
        A.deallocate[mir.MirInstr](alloc, b.instrs, b.instr_cap::usize);
    }
    b.instrs      = dst;
    b.instr_count = total;
    b.instr_cap   = total;
    ret R.ok[bool, str](true);
}

# free the operand arrays of the first `count` pieces written into a rebuild that
# then failed, honoring exactly-once ownership (a moved 1:1 instruction's array is
# still owned by its source)
# ---
# alloc: allocator the piece operand arrays came from
# dst:   the partially written rebuild
# count: number of pieces written before the failure
fun free_pieces(alloc: *A.Allocator, dst: *mir.MirInstr, count: u32) {
    var i: u32 = 0;
    for (i < count) {
        if (dst[i].operands != nil && dst[i].operand_count > 0) {
            A.deallocate[mir.MirOperand](alloc, dst[i].operands, dst[i].operand_count::usize);
        }
        i = i + 1;
    }
}

# release a wide source instruction's operand array once its expansion is emitted
# (the pieces carry fresh copies), mirroring the rules engine's cleanup
# ---
# alloc: allocator the operand array came from
# mi:    the replaced wide instruction; its operand array is freed and nilled
fun free_source_operands(alloc: *A.Allocator, mi: *mir.MirInstr) {
    if (mi.operands != nil && mi.operand_count > 0) {
        A.deallocate[mir.MirOperand](alloc, mi.operands, mi.operand_count::usize);
    }
    mi.operands      = nil;
    mi.operand_count = 0;
    # a legalized wide value has no single register home, so any -g binding on it
    # is dropped; the only target driving legalization (mos6502 / freestanding)
    # emits no debug info, and inert targets never reach this path.
    if (mi.dbg_bindings != nil && mi.dbg_binding_count > 0) {
        A.deallocate[mir.MirDbgBinding](alloc, mi.dbg_bindings, mi.dbg_binding_count::usize);
    }
    mi.dbg_bindings      = nil;
    mi.dbg_binding_count = 0;
}

# the number of native-width instructions a wide instruction expands into
#
# Must agree exactly with what `expand_instr` emits; both read the destination's
# lane count so they cannot drift. Fails loudly for a wide op this pass does not
# yet legalize, before any block is rebuilt.
# ---
# plan: the function's lane assignment
# mi:   the wide instruction
# ret:  the exact piece count, or an error naming the unsupported wide op
fun expansion_count(plan: *LanePlan, mi: *mir.MirInstr) R.Result[u32, str] {
    val op: mir.MirOpcode = mi.opcode;
    val nl: u32 = wide_lane_count(plan, mi);

    # a memory access - an explicit load / store, or the move form the ABI placement
    # emits against a stack slot - costs one piece per lane plus the pointer's own
    # lanes when its base must be staged into the fixed address pair.
    if (instr_is_memory(mi)) { ret memory_piece_count(plan, mi); }

    if (op == mir.MIR_AND || op == mir.MIR_OR || op == mir.MIR_XOR || op == mir.MIR_NOT) {
        ret R.ok[u32, str](nl);
    }
    if (is_shift(op)) { ret shift_piece_count(plan, mi); }
    # a declassify is a move plus a compile-time barrier; it legalizes exactly like a
    # move (the barrier matters only on the pre-legalize lowered MIR the #1648 re-derive
    # reads). legalize runs before isel, so it sees the un-retagged MIR_DECLASSIFY (#1646).
    if (op == mir.MIR_MOV || op == mir.MIR_DECLASSIFY) {
        ret R.ok[u32, str](nl);
    }
    if (op == mir.MIR_ADD || op == mir.MIR_SUB || op == mir.MIR_NEG) {
        # carry / borrow chain: 2 for the low lane, 5 per middle lane, 2 for the
        # top lane (its carry-out is discarded) = 4 + 5*(nl - 2) for nl >= 2.
        ret R.ok[u32, str](4 + 5 * (nl - 2));
    }
    if (op == mir.MIR_ZEXT) {
        # one move per destination lane (low lanes copy the source, high lanes zero).
        ret R.ok[u32, str](dst_lane_count(plan, mi));
    }
    if (op == mir.MIR_TRUNC) {
        # one move per (narrower) destination lane, copying the low source lanes.
        ret R.ok[u32, str](dst_lane_count(plan, mi));
    }
    ret R.err[u32, str](unsupported_message(op, mi.width));
}

# the lane count of a wide instruction's destination (or its widest operand),
# derived from the operation width and the native lane width
# ---
# plan: the function's lane assignment
# mi:   the wide instruction
# ret:  the number of native-width lanes the operation spans (at least one)
fun wide_lane_count(plan: *LanePlan, mi: *mir.MirInstr) u32 {
    var wbytes: u8 = mi.width;
    if (mi.src_width > wbytes) { wbytes = mi.src_width; }
    var n: u32 = (wbytes / plan.lane_width)::u32;
    if (n == 0) { n = 1; }
    ret n;
}

# whether the instruction is a memory access this pass decomposes per lane
#
# The explicit load / store opcodes, plus the move form the ABI placement emits
# against a stack slot (`MOV pv <- [fp + off]` for an incoming parameter): a move
# with a memory operand IS a load or a store, and decomposing it per lane makes it
# one. A declassify rides the move path for the same reason it does everywhere else.
# ---
# mi:  the instruction to test
# ret: true when the instruction reaches memory
fun instr_is_memory(mi: *mir.MirInstr) bool {
    val op: mir.MirOpcode = mi.opcode;
    if (op == mir.MIR_LOAD || op == mir.MIR_STORE) { ret true; }
    if (op != mir.MIR_MOV && op != mir.MIR_DECLASSIFY) { ret false; }
    ret mem_operand_index(mi) >= 0;
}

# the index of the instruction's single memory operand, or -1 when it has none
#
# A load, a store, and a memory-operand move each carry exactly one; the first one
# found is therefore the one.
# ---
# mi:  the instruction to inspect
# ret: the operand index, or -1
fun mem_operand_index(mi: *mir.MirInstr) i32 {
    var k: u32 = 0;
    for (k < mi.operand_count) {
        if (mi.operands[k].kind == mir.MIR_OP_MEM) { ret k::i32; }
        k = k + 1;
    }
    ret -1;
}

# whether a memory operand's base is a runtime pointer that must be staged
#
# True exactly when the base names a vreg the plan split into lanes - a pointer
# wider than one register. A frame-slot key rides the same field but is never
# defined by a wide instruction, so it is never planned and is correctly reported
# as the fixed base it is.
# ---
# plan: the function's lane assignment
# mem:  the memory operand
# ret:  true when the base needs staging into the fixed address pair
fun base_needs_staging(plan: *LanePlan, mem: *mir.MirOperand) bool {
    ret mem.vreg != mir.MIR_VREG_NIL && mem.vreg < plan.orig_count &&
        plan.lane_base[mem.vreg] != LANE_NONE;
}

# the exact piece count of a memory access's expansion, or a loud error
#
# One piece per access lane, plus one per pointer lane when the base is a runtime
# pointer that must be staged into the fixed address pair. Rejects the shapes the
# expansion cannot realize before any block is rebuilt: a value operand that is
# neither a lane-split vreg, an immediate, nor a physical register, and a pointer
# whose lane count does not match the two-register staging pair the backend
# reserves.
# ---
# plan: the function's lane assignment
# mi:   the memory instruction
# ret:  the exact piece count, or an error naming the unsupported shape
fun memory_piece_count(plan: *LanePlan, mi: *mir.MirInstr) R.Result[u32, str] {
    if (mi.operand_count != 2) { ret R.err[u32, str](unsupported_message(mi.opcode, mi.width)); }
    val mx: i32 = mem_operand_index(mi);
    val vx: u32 = 1 - mx::u32;
    var n: u32 = wide_lane_count(plan, mi);
    if (!operand_is_lane_ready(plan, ?mi.operands[vx], n)) {
        ret R.err[u32, str](unsupported_message(mi.opcode, mi.width));
    }
    val mem: *mir.MirOperand = ?mi.operands[mx::u32];
    if (base_needs_staging(plan, mem)) {
        val pl: u32 = plan.lane_count[mem.vreg]::u32;
        if (pl != 2 || plan.mach.stage_lo < 0 || plan.mach.stage_hi < 0) {
            ret R.err[u32, str]("legalize: a runtime pointer needs a two-register address-staging pair this target does not reserve");
        }
        n = n + pl;
    }
    ret R.ok[u32, str](n);
}

# expand a memory access into per-lane native-width accesses at a fixed base
#
# Stages a runtime-pointer base into the backend's reserved address pair first (one
# native move per pointer lane), then emits one access per value lane at successive
# displacements off that fixed base. A base that is already fixed - a physical
# register or a frame-slot key - is used directly and only the displacement walks.
# The pieces are always the explicit `MIR_LOAD` / `MIR_STORE` opcodes even when the
# source was a memory-operand move, so a backend that has decomposed its addressing
# sees one memory form rather than two.
# ---
# alloc:  backing allocator for piece operand arrays
# plan:   the function's lane assignment
# mi:     the memory instruction to expand
# dst:    the rebuilt instruction array
# cursor: next write index into `dst`; advanced past the emitted pieces
# ret:    ok(true) on success, or an error naming an unsupported shape
fun expand_memory(alloc: *A.Allocator, plan: *LanePlan, mi: *mir.MirInstr,
                  dst: *mir.MirInstr, cursor: *u32) R.Result[bool, str] {
    val rc: R.Result[u32, str] = memory_piece_count(plan, mi);
    if (R.is_err[u32, str](rc)) { ret R.err[bool, str](R.unwrap_err[u32, str](rc)); }

    val mx:  u32 = mem_operand_index(mi)::u32;
    val vx:  u32 = 1 - mx;
    val lw:  u8  = plan.lane_width;
    val nl:  u32 = wide_lane_count(plan, mi);
    val is_store: bool = mx == 0;

    var base: mir.MirOperand = mi.operands[mx];
    if (base_needs_staging(plan, ?base)) {
        # stage the pointer's lanes into the reserved address pair, low half first,
        # so the accesses below read one fixed base the backend knows how to reach.
        val lo: u32 = plan.lane_base[base.vreg];
        val r1: R.Result[bool, str] = emit_stage_move(alloc, dst, cursor, mi, plan.mach.stage_lo, lo, lw);
        if (R.is_err[bool, str](r1)) { ret r1; }
        val r2: R.Result[bool, str] = emit_stage_move(alloc, dst, cursor, mi, plan.mach.stage_hi, lo + 1, lw);
        if (R.is_err[bool, str](r2)) { ret r2; }
        base = mir.op_mem_preg(plan.mach.stage_lo::u32, base.imm);
    }

    var i: u32 = 0;
    for (i < nl) {
        var mem: mir.MirOperand = base;
        mem.imm = base.imm + (i * lw::u32)::i64;
        var ops: [2]mir.MirOperand;
        var opcode: mir.MirOpcode = mir.MIR_LOAD;
        if (is_store) {
            opcode = mir.MIR_STORE;
            ops[0] = mem;
            ops[1] = lane_operand(plan, ?mi.operands[vx], i);
        } or {
            ops[0] = lane_operand(plan, ?mi.operands[vx], i);
            ops[1] = mem;
        }
        val r: R.Result[bool, str] = emit_piece(alloc, dst, cursor, mi, opcode, ?ops[0], 2, lw);
        if (R.is_err[bool, str](r)) { ret r; }
        i = i + 1;
    }
    ret R.ok[bool, str](true);
}

# emit one `MOV preg <- lane` staging move of a pointer lane into the fixed pair
fun emit_stage_move(alloc: *A.Allocator, dst: *mir.MirInstr, cursor: *u32, src: *mir.MirInstr,
                    preg: i32, lane: u32, lw: u8) R.Result[bool, str] {
    var ops: [2]mir.MirOperand;
    ops[0] = mir.op_preg(preg::u32);
    ops[1] = mir.op_vreg(lane);
    ret emit_piece(alloc, dst, cursor, src, mir.MIR_MOV, ?ops[0], 2, lw);
}

# expand one wide instruction into its native-width lane sequence in `dst`
#
# Dispatches on the generic opcode. Each arm emits exactly the count
# `expansion_count` reported. Advances `*cursor` past the emitted pieces.
# ---
# alloc:  backing allocator for piece operand arrays and lane temporaries
# plan:   the function's lane assignment
# f:      the MIR function (for appending carry / temp vregs)
# mi:     the wide instruction to expand
# dst:    the rebuilt instruction array
# cursor: next write index into `dst`; advanced past the emitted pieces
# ret:    ok(true) on success, or an error naming an unsupported wide op
fun expand_instr(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
                 dst: *mir.MirInstr, cursor: *u32) R.Result[bool, str] {
    val op: mir.MirOpcode = mi.opcode;

    if (instr_is_memory(mi)) {
        ret expand_memory(alloc, plan, mi, dst, cursor);
    }
    if (op == mir.MIR_AND || op == mir.MIR_OR || op == mir.MIR_XOR) {
        ret expand_bitwise(alloc, plan, mi, dst, cursor);
    }
    if (op == mir.MIR_NOT) {
        ret expand_not(alloc, plan, mi, dst, cursor);
    }
    if (is_shift(op)) {
        ret expand_shift(alloc, plan, f, mi, dst, cursor);
    }
    if (op == mir.MIR_MOV || op == mir.MIR_DECLASSIFY) {
        ret expand_mov(alloc, plan, mi, dst, cursor);
    }
    if (op == mir.MIR_ADD || op == mir.MIR_SUB) {
        ret expand_addsub(alloc, plan, f, mi, dst, cursor, op == mir.MIR_SUB);
    }
    if (op == mir.MIR_NEG) {
        ret expand_neg(alloc, plan, f, mi, dst, cursor);
    }
    if (op == mir.MIR_ZEXT) {
        ret expand_zext(alloc, plan, mi, dst, cursor);
    }
    if (op == mir.MIR_TRUNC) {
        ret expand_trunc(alloc, plan, mi, dst, cursor);
    }
    ret R.err[bool, str](unsupported_message(op, mi.width));
}

# emit one native-width piece into `dst[*cursor]`, copying the source's location
# metadata and advancing the cursor
#
# Whole-record copy from `mir.instr` into the slot, not a field-by-field rebuild:
# `dst[ci]` is a slot in the caller's rebuilt array, not a fresh declaration, so it
# is invisible to the construction-site census and was the last remaining
# field-by-field `MirInstr` rebuild in the tree (#2335) - the other two sites
# converted to `mir.instr_like` under #2321. `mir.instr` already zero-fills
# `asm_block` / `vec_lane` / `dbg_bindings` / `dbg_binding_count`, so only the three
# fields a piece inherits from `src` need amending afterward.
# ---
# alloc:  allocator for the piece's operand array
# dst:    the rebuilt array
# cursor: next write index; advanced by one
# src:    the wide instruction being replaced (source of loc / inline_site)
# opcode: the piece's opcode
# ops:    operand values copied into a fresh array (nil when count is 0)
# nops:   operand count
# width:  the piece's operation width (the native lane width)
# ret:    ok(true) on success, or an allocation error
fun emit_piece(alloc: *A.Allocator, dst: *mir.MirInstr, cursor: *u32, src: *mir.MirInstr,
               opcode: mir.MirOpcode, ops: *mir.MirOperand, nops: u32, width: u8) R.Result[bool, str] {
    var arr: *mir.MirOperand = nil;
    if (nops > 0) {
        val res_a: R.Result[*mir.MirOperand, str] = A.allocate[mir.MirOperand](alloc, nops::usize);
        if (R.is_err[*mir.MirOperand, str](res_a)) { ret R.err[bool, str](R.unwrap_err[*mir.MirOperand, str](res_a)); }
        arr = R.unwrap_ok[*mir.MirOperand, str](res_a);
        var j: u32 = 0;
        for (j < nops) { arr[j] = ops[j]; j = j + 1; }
    }
    val ci: u32 = @cursor;
    dst[ci] = mir.instr(opcode, arr, nops, width, width);
    val p: *mir.MirInstr = ?dst[ci];
    p.loc           = src.loc;
    p.inline_site   = src.inline_site;
    # a legalized store's narrow-store pieces all write the same secret storage; carry
    # the seed onto each (#1646).
    p.writes_secret = src.writes_secret;
    @cursor = ci + 1;
    ret R.ok[bool, str](true);
}

# the native-width operand for lane `i` of a wide operation's operand
#
# A wide VREG operand yields its `i`-th lane vreg; an immediate yields its `i`-th
# native-width byte group; a PHYSICAL register yields the `i`-th register of the
# consecutive run starting at it - a wide value placed in the register file occupies
# consecutive register ids from its named base, which is what an ABI naming one
# register for a multi-register value means (mos6502's `PTR_LO` names the zero-page
# pair `PTR_LO` / `PTR_LO + 1`).
# ---
# plan: the function's lane assignment
# op:   the wide operand
# i:    the lane index
# ret:  the native-width operand for that lane
fun lane_operand(plan: *LanePlan, op: *mir.MirOperand, i: u32) mir.MirOperand {
    if (op.kind == mir.MIR_OP_VREG && op.vreg < plan.orig_count && plan.lane_base[op.vreg] != LANE_NONE) {
        ret mir.op_vreg(plan.lane_base[op.vreg] + i);
    }
    if (op.kind == mir.MIR_OP_IMM) {
        ret mir.op_imm(imm_lane(op.imm, i, plan.lane_width));
    }
    if (op.kind == mir.MIR_OP_PREG) {
        ret mir.op_preg(op.preg + i);
    }
    # a native-width vreg (lane count 1) rides lane 0 directly; a caller only asks
    # for lane 0 in that case.
    ret @op;
}

# whether one operand can be decomposed into `nl` native-width lanes
#
# A lane-split vreg, an immediate, and a physical register each yield a lane
# operand; anything else (a symbol, a block, a second memory reference) does not.
# A vreg the plan did NOT split is its own lane 0, so it is ready for a single-lane
# operation - the shape a narrow access through a wide pointer takes.
# ---
# plan: the function's lane assignment
# op:   the operand to test
# nl:   the number of lanes the operation spans
# ret:  true when `lane_operand` yields a meaningful lane for it
fun operand_is_lane_ready(plan: *LanePlan, op: *mir.MirOperand, nl: u32) bool {
    if (op.kind == mir.MIR_OP_VREG) {
        if (op.vreg < plan.orig_count && plan.lane_base[op.vreg] != LANE_NONE) { ret true; }
        ret nl == 1;
    }
    ret op.kind == mir.MIR_OP_IMM || op.kind == mir.MIR_OP_PREG;
}

# the `i`-th native-width byte group of an immediate, zero-filled above the value
# ---
# imm: the full immediate value
# i:   the lane index
# w:   the native lane width in bytes
# ret: the immediate's bits for that lane, in [0, 2^(8*w))
fun imm_lane(imm: i64, i: u32, w: u8) i64 {
    val shift: i64 = (i * w::u32)::i64 * 8;
    val mask:  i64 = (1::i64 << (w::i64 * 8)) - 1;
    ret (imm >> shift) & mask;
}

# whether every value operand of a wide ALU instruction is a wide vreg or an
# immediate (the only shapes a lane expansion handles)
# ---
# plan:  the function's lane assignment
# mi:    the wide instruction
# start: first operand index to check (1 to skip the destination)
# ret:   true when operands [start, operand_count) are all wide-vreg or immediate
fun operands_are_lane_ready(plan: *LanePlan, mi: *mir.MirInstr, start: u32) bool {
    var k: u32 = start;
    for (k < mi.operand_count) {
        val op: *mir.MirOperand = ?mi.operands[k];
        val is_wide_vreg: bool = op.kind == mir.MIR_OP_VREG && op.vreg < plan.orig_count &&
                                 plan.lane_base[op.vreg] != LANE_NONE;
        if (!is_wide_vreg && op.kind != mir.MIR_OP_IMM) { ret false; }
        k = k + 1;
    }
    ret true;
}

# expand a wide lane-independent bitwise binary op (AND / OR / XOR) into one
# native op per lane
fun expand_bitwise(alloc: *A.Allocator, plan: *LanePlan, mi: *mir.MirInstr,
                   dst: *mir.MirInstr, cursor: *u32) R.Result[bool, str] {
    if (mi.operand_count != 3 || !operands_are_lane_ready(plan, mi, 1)) {
        ret R.err[bool, str](unsupported_message(mi.opcode, mi.width));
    }
    val nl: u32 = wide_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;
    var i: u32 = 0;
    for (i < nl) {
        var ops: [3]mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        ops[1] = lane_operand(plan, ?mi.operands[1], i);
        ops[2] = lane_operand(plan, ?mi.operands[2], i);
        val r: R.Result[bool, str] = emit_piece(alloc, dst, cursor, mi, mi.opcode, ?ops[0], 3, lw);
        if (R.is_err[bool, str](r)) { ret r; }
        i = i + 1;
    }
    ret R.ok[bool, str](true);
}

# expand a wide bitwise complement into one native NOT per lane
fun expand_not(alloc: *A.Allocator, plan: *LanePlan, mi: *mir.MirInstr,
               dst: *mir.MirInstr, cursor: *u32) R.Result[bool, str] {
    if (mi.operand_count != 2 || !operands_are_lane_ready(plan, mi, 1)) {
        ret R.err[bool, str](unsupported_message(mi.opcode, mi.width));
    }
    val nl: u32 = wide_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;
    var i: u32 = 0;
    for (i < nl) {
        var ops: [2]mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        ops[1] = lane_operand(plan, ?mi.operands[1], i);
        val r: R.Result[bool, str] = emit_piece(alloc, dst, cursor, mi, mir.MIR_NOT, ?ops[0], 2, lw);
        if (R.is_err[bool, str](r)) { ret r; }
        i = i + 1;
    }
    ret R.ok[bool, str](true);
}

# expand a wide register / immediate copy into one native move per lane
#
# A precolored physical-register operand is an ABI placement of a wide value - the
# hidden result-storage pointer arriving in, or returning through, a register the
# convention names. It decomposes onto the consecutive register run starting there,
# which is what naming one register for a multi-register value means.
fun expand_mov(alloc: *A.Allocator, plan: *LanePlan, mi: *mir.MirInstr,
               dst: *mir.MirInstr, cursor: *u32) R.Result[bool, str] {
    val nl: u32 = wide_lane_count(plan, mi);
    if (mi.operand_count != 2 || !operand_is_lane_ready(plan, ?mi.operands[0], nl) ||
        !operand_is_lane_ready(plan, ?mi.operands[1], nl)) {
        ret R.err[bool, str](unsupported_message(mi.opcode, mi.width));
    }
    val lw: u8  = plan.lane_width;
    var i: u32 = 0;
    for (i < nl) {
        var ops: [2]mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        ops[1] = lane_operand(plan, ?mi.operands[1], i);
        val r: R.Result[bool, str] = emit_piece(alloc, dst, cursor, mi, mir.MIR_MOV, ?ops[0], 2, lw);
        if (R.is_err[bool, str](r)) { ret r; }
        i = i + 1;
    }
    ret R.ok[bool, str](true);
}

# expand a wide add or subtract into an explicit native-width carry / borrow chain
#
# Each lane computes its native sum / difference and the carry / borrow out of it
# as an ordinary value (an unsigned compare), threading that into the next lane -
# this IR has no hardware carry flag, so the carry is materialized. The low lane
# needs no carry-in and the top lane's carry-out is discarded (wrapping
# arithmetic), so the shape is: low lane 2 pieces, each middle lane 5, top lane 2.
# ---
# is_sub: true for subtraction (borrow chain), false for addition (carry chain)
fun expand_addsub(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
                  dst: *mir.MirInstr, cursor: *u32, is_sub: bool) R.Result[bool, str] {
    if (mi.operand_count != 3 || !operands_are_lane_ready(plan, mi, 1) ||
        mi.operands[0].kind != mir.MIR_OP_VREG || plan.lane_base[mi.operands[0].vreg] == LANE_NONE) {
        ret R.err[bool, str](unsupported_message(mi.opcode, mi.width));
    }
    val nl: u32 = wide_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;
    val cmp:  mir.MirOpcode = mir.MIR_CMP_LT_U;
    var op0:  mir.MirOpcode = mir.MIR_ADD;
    if (is_sub) { op0 = mir.MIR_SUB; }

    var carry: u32 = mir.MIR_VREG_NIL;  # the carry / borrow vreg out of the last lane
    var i: u32 = 0;
    for (i < nl) {
        val d: mir.MirOperand = lane_operand(plan, ?mi.operands[0], i);
        val a: mir.MirOperand = lane_operand(plan, ?mi.operands[1], i);
        val b: mir.MirOperand = lane_operand(plan, ?mi.operands[2], i);
        val is_low: bool = i == 0;
        val is_top: bool = i == nl - 1;

        if (is_low) {
            # d = a (+/-) b ; carry = is_sub ? (a <u b) : (d <u a)
            val r1: R.Result[bool, str] = emit_bin(alloc, dst, cursor, mi, op0, d, a, b, lw);
            if (R.is_err[bool, str](r1)) { ret r1; }
            val res_c: R.Result[u32, str] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (R.is_err[u32, str](res_c)) { ret R.err[bool, str](R.unwrap_err[u32, str](res_c)); }
            carry = R.unwrap_ok[u32, str](res_c);
            val cop: mir.MirOperand = mir.op_vreg(carry);
            var rc: R.Result[bool, str];
            if (is_sub) { rc = emit_bin(alloc, dst, cursor, mi, cmp, cop, a, b, lw); }
            or          { rc = emit_bin(alloc, dst, cursor, mi, cmp, cop, d, a, lw); }
            if (R.is_err[bool, str](rc)) { ret rc; }
        }
        or (is_top) {
            # t = a (+/-) b ; d = t (+/-) carry   (carry-out discarded)
            val res_t: R.Result[u32, str] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (R.is_err[u32, str](res_t)) { ret R.err[bool, str](R.unwrap_err[u32, str](res_t)); }
            val t: mir.MirOperand = mir.op_vreg(R.unwrap_ok[u32, str](res_t));
            val r1: R.Result[bool, str] = emit_bin(alloc, dst, cursor, mi, op0, t, a, b, lw);
            if (R.is_err[bool, str](r1)) { ret r1; }
            val r2: R.Result[bool, str] = emit_bin(alloc, dst, cursor, mi, op0, d, t, mir.op_vreg(carry), lw);
            if (R.is_err[bool, str](r2)) { ret r2; }
        }
        or {
            # middle lane: t = a (+/-) b ; ct = overflow(t) ; d = t (+/-) carry ;
            #              cd = overflow(d) ; carry = ct | cd
            val res_t: R.Result[u32, str] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (R.is_err[u32, str](res_t)) { ret R.err[bool, str](R.unwrap_err[u32, str](res_t)); }
            val t: mir.MirOperand = mir.op_vreg(R.unwrap_ok[u32, str](res_t));
            val cin: mir.MirOperand = mir.op_vreg(carry);

            val r1: R.Result[bool, str] = emit_bin(alloc, dst, cursor, mi, op0, t, a, b, lw);
            if (R.is_err[bool, str](r1)) { ret r1; }

            val res_ct: R.Result[u32, str] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (R.is_err[u32, str](res_ct)) { ret R.err[bool, str](R.unwrap_err[u32, str](res_ct)); }
            val ct: mir.MirOperand = mir.op_vreg(R.unwrap_ok[u32, str](res_ct));
            var rct: R.Result[bool, str];
            if (is_sub) { rct = emit_bin(alloc, dst, cursor, mi, cmp, ct, a, b, lw); }
            or          { rct = emit_bin(alloc, dst, cursor, mi, cmp, ct, t, a, lw); }
            if (R.is_err[bool, str](rct)) { ret rct; }

            val r3: R.Result[bool, str] = emit_bin(alloc, dst, cursor, mi, op0, d, t, cin, lw);
            if (R.is_err[bool, str](r3)) { ret r3; }

            val res_cd: R.Result[u32, str] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (R.is_err[u32, str](res_cd)) { ret R.err[bool, str](R.unwrap_err[u32, str](res_cd)); }
            val cd: mir.MirOperand = mir.op_vreg(R.unwrap_ok[u32, str](res_cd));
            var rcd: R.Result[bool, str];
            if (is_sub) { rcd = emit_bin(alloc, dst, cursor, mi, cmp, cd, t, cin, lw); }
            or          { rcd = emit_bin(alloc, dst, cursor, mi, cmp, cd, d, t, lw); }
            if (R.is_err[bool, str](rcd)) { ret rcd; }

            val res_co: R.Result[u32, str] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (R.is_err[u32, str](res_co)) { ret R.err[bool, str](R.unwrap_err[u32, str](res_co)); }
            val co: u32 = R.unwrap_ok[u32, str](res_co);
            val r5: R.Result[bool, str] = emit_bin(alloc, dst, cursor, mi, mir.MIR_OR, mir.op_vreg(co), ct, cd, lw);
            if (R.is_err[bool, str](r5)) { ret r5; }
            carry = co;
        }
        i = i + 1;
    }
    ret R.ok[bool, str](true);
}

# expand a wide negate as `0 - value` through the subtract carry chain
fun expand_neg(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
               dst: *mir.MirInstr, cursor: *u32) R.Result[bool, str] {
    if (mi.operand_count != 2 || !operands_are_lane_ready(plan, mi, 1) ||
        mi.operands[0].kind != mir.MIR_OP_VREG || plan.lane_base[mi.operands[0].vreg] == LANE_NONE) {
        ret R.err[bool, str](unsupported_message(mi.opcode, mi.width));
    }
    # synthesize a three-operand subtract `dst = 0 - src` and drive the borrow chain.
    var sub: mir.MirInstr = @mi;
    var ops: [3]mir.MirOperand;
    ops[0] = mi.operands[0];
    ops[1] = mir.op_imm(0);
    ops[2] = mi.operands[1];
    sub.operands      = ?ops[0];
    sub.operand_count = 3;
    ret expand_addsub(alloc, plan, f, ?sub, dst, cursor, true);
}

# the largest lane count a shift expansion works over: the language's widest scalar
# (8 bytes) over the narrowest lane a machine can declare (1 byte)
val MAX_SHIFT_LANES: u32 = 8;

# what one destination lane of a constant-count shift is built from
#
# `k` whole lanes plus `r` bits is the count, so a destination lane is fed by the two
# source lanes that straddle it: one contributes its shifted-in-range bits, the
# neighbour the bits that crossed the lane boundary. The neighbour drops out at the
# ends of the value, where the fill takes its place.
val SL_FILL: u32 = 0;  # the fill byte alone (zero, or an arithmetic shift's sign fill)
val SL_COPY: u32 = 1;  # one whole source lane, unshifted (the count is a lane multiple)
val SL_ONE:  u32 = 2;  # one source lane shifted within itself, nothing crossing in
val SL_SIGN: u32 = 3;  # the TOP lane of an arithmetic right shift, shifted arithmetically
val SL_TWO:  u32 = 4;  # two lanes shifted opposite ways and OR'd together

# classify destination lane `i` of a constant-count shift
#
# The single place the lane algebra is stated, so the piece COUNT and the piece EMIT
# cannot disagree about what a lane costs - the contract `expansion_count` and
# `expand_instr` owe each other.
# ---
# nl:    the operation's lane count
# k:     whole lanes of the count
# r:     bits of the count beyond `k` lanes, in [0, lane bits)
# left:  true for a left shift, false for either right shift
# arith: true for an arithmetic right shift (the fill is the sign, not zero)
# i:     the destination lane
# a_out: receives the source lane supplying the in-range bits, or -1
# b_out: receives the neighbour lane, -1 for the fill operand
# ret:   the SL_* kind
fun shift_lane_kind(nl: u32, k: u32, r: u32, left: bool, arith: bool, i: u32,
                    a_out: *i32, b_out: *i32) u32 {
    @a_out = -1;
    @b_out = -1;
    if (left) {
        if (i < k) { ret SL_FILL; }
        val a: i32 = i::i32 - k::i32;
        @a_out = a;
        if (r == 0) { ret SL_COPY; }
        # below lane 0 a left shift shifts in zeros, so the neighbour drops out.
        if (a == 0) { ret SL_ONE; }
        @b_out = a - 1;
        ret SL_TWO;
    }
    val a: i32 = i::i32 + k::i32;
    if (a >= nl::i32) { ret SL_FILL; }
    @a_out = a;
    if (r == 0) { ret SL_COPY; }
    if (a + 1 >= nl::i32) {
        # nothing crosses into the top source lane from above: a logical shift fills it
        # with zeros, and an arithmetic one fills it with its OWN sign - which is what a
        # native arithmetic shift of that lane already does. Neither costs a second
        # operand, so neither needs the fill.
        if (arith) { ret SL_SIGN; }
        ret SL_ONE;
    }
    @b_out = a + 1;
    ret SL_TWO;
}

# the native-width pieces one classified destination lane costs
# ---
# kind: the SL_* classification
# ret:  the piece count
fun shift_kind_pieces(kind: u32) u32 {
    if (kind == SL_TWO) { ret 3; }
    ret 1;
}

# the native-width pieces a whole constant-count shift template costs
# ---
# nl:    the operation's lane count
# k:     whole lanes of the count
# r:     bits of the count beyond `k` lanes
# left:  true for a left shift
# arith: true for an arithmetic right shift
# ret:   the exact piece count
fun const_shift_pieces(nl: u32, k: u32, r: u32, left: bool, arith: bool) u32 {
    var total: u32 = 0;
    var i: u32 = 0;
    for (i < nl) {
        var a: i32 = 0;
        var b: i32 = 0;
        total = total + shift_kind_pieces(shift_lane_kind(nl, k, r, left, arith, i, ?a, ?b));
        i = i + 1;
    }
    ret total;
}

# whether an arithmetic right shift by `k` whole lanes plus `r` bits needs the sign
# fill materialized
#
# Only a destination lane fed ENTIRELY from above the value reads it, and that happens
# exactly when the count reaches a whole lane. Below that the top lane's own arithmetic
# shift supplies the sign, so no fill byte is built at all.
# ---
# arith: true for an arithmetic right shift
# k:     whole lanes of the count
# ret:   true when the expansion must materialize the sign fill
fun needs_sign_fill(arith: bool, k: u32) bool {
    ret arith && k > 0;
}

# the number of masked-barrel stages a shift at `bits` wide needs
#
# One stage per bit of the count, so the barrel covers every count in [0, bits) - which
# is log2(bits). Returns 0 when `bits` is not a power of two, a width the barrel has no
# meaning for; a lane is at least one byte so `bits` is at least 8 and a real answer is
# never 0.
# ---
# bits: the operation width in bits
# ret:  the stage count, or 0 when `bits` is not a power of two
fun shift_stage_count(bits: u32) u32 {
    if (bits == 0) { ret 0; }
    var s: u32 = 0;
    var w: u32 = bits;
    for (w > 1) {
        if ((w & 1) != 0) { ret 0; }
        w = w >> 1;
        s = s + 1;
    }
    ret s;
}

# the exact piece count of a shift's expansion, or a loud error
#
# Rejects the shapes the expansion cannot realize before any block is rebuilt: an
# operand that is neither lane-split, an immediate, nor a physical register, a lane
# count past what a scalar can span, and an operation width that is not a power of two
# (which the barrel's count masking has no meaning for).
# ---
# plan: the function's lane assignment
# mi:   the shift instruction
# ret:  the exact piece count, or an error naming the unsupported shape
fun shift_piece_count(plan: *LanePlan, mi: *mir.MirInstr) R.Result[u32, str] {
    val nl: u32 = wide_lane_count(plan, mi);
    if (mi.operand_count != 3 || nl > MAX_SHIFT_LANES) {
        ret R.err[u32, str](unsupported_message(mi.opcode, mi.width));
    }
    # the destination and the shifted value span every lane; the COUNT is read out of
    # its low lane alone, since the barrel needs only log2(width) of its bits.
    if (mi.operands[0].kind != mir.MIR_OP_VREG ||
        !operand_is_lane_ready(plan, ?mi.operands[0], nl) ||
        !operand_is_lane_ready(plan, ?mi.operands[1], nl) ||
        !operand_is_lane_ready(plan, ?mi.operands[2], 1)) {
        ret R.err[u32, str](unsupported_message(mi.opcode, mi.width));
    }

    val lb:   u32 = plan.lane_width::u32 * 8;
    val bits: u32 = nl * lb;
    val stages: u32 = shift_stage_count(bits);
    if (stages == 0) {
        ret R.err[u32, str]("legalize: a shift at a width that is not a power of two is unsupported on this target");
    }

    val left:  bool = mi.opcode == mir.MIR_SHL;
    val arith: bool = mi.opcode == mir.MIR_SHR_S;

    if (mi.operands[2].kind == mir.MIR_OP_IMM) {
        val c: u32 = (mi.operands[2].imm & (bits - 1)::i64)::u32;
        var total: u32 = const_shift_pieces(nl, c / lb, c % lb, left, arith);
        if (needs_sign_fill(arith, c / lb)) { total = total + 1; }
        ret R.ok[u32, str](total);
    }

    # the masked barrel: per stage, the count bit, the 0 / -1 mask it becomes, the
    # constant-distance shift of the running value, and the branchless lane select.
    var total: u32 = 0;
    # a stage shifting by a whole lane or more reads the sign fill, so a multi-lane
    # arithmetic barrel materializes it once for every stage.
    if (arith && nl > 1) { total = 1; }
    var j: u32 = 0;
    for (j < stages) {
        if (j == 0) { total = total + 1; }
        or          { total = total + 2; }
        total = total + 1;
        val c: u32 = 1 << j;
        total = total + const_shift_pieces(nl, c / lb, c % lb, left, arith);
        total = total + 3 * nl;
        j = j + 1;
    }
    ret R.ok[u32, str](total);
}

# emit one native two-operand piece `d = a` (a lane move)
fun emit_copy(alloc: *A.Allocator, dst: *mir.MirInstr, cursor: *u32, src: *mir.MirInstr,
              d: mir.MirOperand, a: mir.MirOperand, w: u8) R.Result[bool, str] {
    var ops: [2]mir.MirOperand;
    ops[0] = d;
    ops[1] = a;
    ret emit_piece(alloc, dst, cursor, src, mir.MIR_MOV, ?ops[0], 2, w);
}

# emit `out[] = in[] shifted by a CONSTANT count`, one native piece per classified lane
#
# The template half of the shift work: a count of `k` whole lanes plus `r` bits is a
# lane renaming (free - it only changes which source lane a destination lane names)
# plus, when `r` is non-zero, one native shift per contributing lane and an OR to join
# the two that straddle each destination lane. No control flow, no carry chain: unlike
# add, a shift's lanes do not depend on one another's results.
#
# THE LANE WALK ORDER IS LOAD-BEARING. A left shift reads LOWER lanes than it writes and
# a right shift reads higher ones, so walking the destination from the top for a left
# shift and from the bottom for a right one guarantees a written lane is never a source
# some later lane still needs - which is what lets `in` and `out` be the same storage.
# ---
# alloc:        backing allocator for piece operand arrays and lane temporaries
# f:            the MIR function (for appending temporaries)
# src:          the shift being replaced (source of loc / inline_site)
# dst:          the rebuilt instruction array
# cursor:       next write index into `dst`; advanced past the emitted pieces
# in_ops:       the `nl` source lane operands
# out_ops:      the `nl` destination lane operands
# nl:           the lane count
# lw:           the native lane width in bytes
# k:      whole lanes of the count
# r:      bits of the count beyond `k` lanes
# left:   true for a left shift
# arith:  true for an arithmetic right shift
# fill:   the operand shifted in past the end of the value (read only when `arith`
#         and the count reaches a whole lane)
# ret:    ok(true) on success, or an allocation error
fun emit_const_shift(alloc: *A.Allocator, f: *mir.MirFunction, src: *mir.MirInstr,
                     dst: *mir.MirInstr, cursor: *u32,
                     in_ops: *mir.MirOperand, out_ops: *mir.MirOperand, nl: u32, lw: u8,
                     k: u32, r: u32, left: bool, arith: bool,
                     fill: mir.MirOperand) R.Result[bool, str] {
    val lb: u32 = lw::u32 * 8;
    var step: i32 = 1;
    var i:    i32 = 0;
    if (left) {
        i    = nl::i32 - 1;
        step = -1;
    }
    for (i >= 0 && i < nl::i32) {
        var a: i32 = 0;
        var b: i32 = 0;
        val kind: u32 = shift_lane_kind(nl, k, r, left, arith, i::u32, ?a, ?b);
        val out:  mir.MirOperand = out_ops[i::u32];

        if (kind == SL_FILL) {
            val r1: R.Result[bool, str] = emit_copy(alloc, dst, cursor, src, out, fill, lw);
            if (R.is_err[bool, str](r1)) { ret r1; }
        }
        or (kind == SL_COPY) {
            val r1: R.Result[bool, str] = emit_copy(alloc, dst, cursor, src, out, in_ops[a::u32], lw);
            if (R.is_err[bool, str](r1)) { ret r1; }
        }
        or (kind == SL_ONE || kind == SL_SIGN) {
            var one: mir.MirOpcode = mir.MIR_SHR_U;
            if (left)            { one = mir.MIR_SHL; }
            or (kind == SL_SIGN) { one = mir.MIR_SHR_S; }
            val r1: R.Result[bool, str] = emit_bin(alloc, dst, cursor, src, one, out,
                                                   in_ops[a::u32], mir.op_imm(r::i64), lw);
            if (R.is_err[bool, str](r1)) { ret r1; }
        }
        or {
            # the two straddling lanes: the in-range bits of one, the crossing bits of
            # the neighbour (or of the fill, when the neighbour is past the end).
            var nb: mir.MirOperand = fill;
            if (b >= 0) { nb = in_ops[b::u32]; }

            val rt1: R.Result[u32, str] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (R.is_err[u32, str](rt1)) { ret R.err[bool, str](R.unwrap_err[u32, str](rt1)); }
            val t1: mir.MirOperand = mir.op_vreg(R.unwrap_ok[u32, str](rt1));
            val rt2: R.Result[u32, str] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (R.is_err[u32, str](rt2)) { ret R.err[bool, str](R.unwrap_err[u32, str](rt2)); }
            val t2: mir.MirOperand = mir.op_vreg(R.unwrap_ok[u32, str](rt2));

            var main_op:  mir.MirOpcode = mir.MIR_SHR_U;
            var cross_op: mir.MirOpcode = mir.MIR_SHL;
            if (left) { main_op = mir.MIR_SHL; cross_op = mir.MIR_SHR_U; }

            val r1: R.Result[bool, str] = emit_bin(alloc, dst, cursor, src, main_op, t1,
                                                   in_ops[a::u32], mir.op_imm(r::i64), lw);
            if (R.is_err[bool, str](r1)) { ret r1; }
            val r2: R.Result[bool, str] = emit_bin(alloc, dst, cursor, src, cross_op, t2,
                                                   nb, mir.op_imm((lb - r)::i64), lw);
            if (R.is_err[bool, str](r2)) { ret r2; }
            val r3: R.Result[bool, str] = emit_bin(alloc, dst, cursor, src, mir.MIR_OR, out, t1, t2, lw);
            if (R.is_err[bool, str](r3)) { ret r3; }
        }
        i = i + step;
    }
    ret R.ok[bool, str](true);
}

# emit an arithmetic shift's SIGN FILL: `$00` or `$FF` from the top lane's sign bit
#
# A native arithmetic shift of the top lane by one bit less than a lane replicates its
# sign bit across the whole lane, which is exactly the byte that shifts in past the top
# of the value. One piece, and one for the whole expansion: an arithmetic right shift
# never changes the sign of what it shifts, so the barrel's every stage reuses it.
# ---
# alloc:  backing allocator for the piece's operand array and the fill vreg
# f:      the MIR function (for appending the fill vreg)
# src:    the shift being replaced (source of loc / inline_site)
# dst:    the rebuilt instruction array
# cursor: next write index into `dst`; advanced past the emitted piece
# top:    the value's top lane operand
# lw:     the native lane width in bytes
# out:    receives the fill operand
# ret:    ok(true) on success, or an allocation error
fun emit_sign_fill(alloc: *A.Allocator, f: *mir.MirFunction, src: *mir.MirInstr,
                   dst: *mir.MirInstr, cursor: *u32, top: mir.MirOperand, lw: u8,
                   out: *mir.MirOperand) R.Result[bool, str] {
    val rv: R.Result[u32, str] = new_vreg(alloc, f, mir.REG_CLASS_GP);
    if (R.is_err[u32, str](rv)) { ret R.err[bool, str](R.unwrap_err[u32, str](rv)); }
    @out = mir.op_vreg(R.unwrap_ok[u32, str](rv));
    ret emit_bin(alloc, dst, cursor, src, mir.MIR_SHR_S, @out, top,
                 mir.op_imm((lw::u32 * 8 - 1)::i64), lw);
}

# expand a shift into native-width pieces
#
# A CONSTANT count is a pure template (`emit_const_shift`); a RUNTIME count is a masked
# barrel over that template (`emit_shift_barrel`). Neither needs control flow, which is
# the thing this expansion was long assumed to require.
#
# THE COUNT IS TAKEN MODULO THE OPERATION WIDTH. A count at or past the width has no
# target-independent answer - the middle end declines to fold one for exactly that
# reason - so each target defines it, and the definition here is the one the barrel
# gives for free: it reads log2(width) bits of the count and ignores the rest. That is
# also what the three wide-native ISAs do at their machine width (x86-64 masks a shift
# count to 5 or 6 bits, aarch64 and rv64 likewise), so the constant path masks to match
# rather than answering differently from the runtime path on the same target.
# ---
# alloc:  backing allocator for piece operand arrays and lane temporaries
# plan:   the function's lane assignment
# f:      the MIR function (for appending temporaries)
# mi:     the shift instruction to expand
# dst:    the rebuilt instruction array
# cursor: next write index into `dst`; advanced past the emitted pieces
# ret:    ok(true) on success, or an error naming the unsupported shape
fun expand_shift(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
                 dst: *mir.MirInstr, cursor: *u32) R.Result[bool, str] {
    val rc: R.Result[u32, str] = shift_piece_count(plan, mi);
    if (R.is_err[u32, str](rc)) { ret R.err[bool, str](R.unwrap_err[u32, str](rc)); }

    val nl: u32 = wide_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;
    val lb: u32 = lw::u32 * 8;
    val bits: u32 = nl * lb;
    val left:  bool = mi.opcode == mir.MIR_SHL;
    val arith: bool = mi.opcode == mir.MIR_SHR_S;

    var src_ops: [MAX_SHIFT_LANES]mir.MirOperand;
    var dst_ops: [MAX_SHIFT_LANES]mir.MirOperand;
    var i: u32 = 0;
    for (i < nl) {
        src_ops[i] = lane_operand(plan, ?mi.operands[1], i);
        dst_ops[i] = lane_operand(plan, ?mi.operands[0], i);
        i = i + 1;
    }

    if (mi.operands[2].kind == mir.MIR_OP_IMM) {
        val c: u32 = (mi.operands[2].imm & (bits - 1)::i64)::u32;
        var fill: mir.MirOperand = mir.op_imm(0);
        if (needs_sign_fill(arith, c / lb)) {
            val rf: R.Result[bool, str] = emit_sign_fill(alloc, f, mi, dst, cursor,
                                                         src_ops[nl - 1], lw, ?fill);
            if (R.is_err[bool, str](rf)) { ret rf; }
        }
        ret emit_const_shift(alloc, f, mi, dst, cursor, ?src_ops[0], ?dst_ops[0], nl, lw,
                             c / lb, c % lb, left, arith, fill);
    }

    ret emit_shift_barrel(alloc, plan, f, mi, dst, cursor, ?src_ops[0], ?dst_ops[0], nl, lw, left, arith);
}

# expand a RUNTIME-count shift into a straight-line masked barrel
#
# The classical barrel-shifter emulation, and the reason this expansion needs no loop
# and no jump table. The count's bit `j` decides whether the running value is shifted a
# further `2^j` places, and that decision is made ARITHMETICALLY rather than by
# branching:
#
#   bit    = (count >> j) & 1        a constant-count shift, so the template covers it
#   mask   = 0 - bit                 all-ones when the bit is set, all-zeros when not
#   sh     = value shifted by 2^j    a constant distance, so again the template
#   value  = value ^ ((value ^ sh) & mask)
#
# Every operand is fixed-cost and there is no branch, so the whole sequence runs in ONE
# cycle count for every value AND every count. A jump table over the count would be
# cheaper on average but its cost would track the count, and a loop's would too; the
# masked form is the shape that stays safe when the count becomes secret, and is what
# lets this pass emit a variable shift at all without the control flow it cannot build.
#
# The cost is honest rather than cheap - on a byte-lane machine a `u16` shift is 49
# native pieces, a `u32` one 112 and a `u64` one 251 - which is what a constant-time
# variable shift costs on an 8-bit machine.
# ---
# alloc:   backing allocator for piece operand arrays and lane temporaries
# plan:    the function's lane assignment
# f:       the MIR function (for appending temporaries)
# mi:      the shift instruction being replaced
# dst:     the rebuilt instruction array
# cursor:  next write index into `dst`; advanced past the emitted pieces
# src_ops: the `nl` source lane operands
# dst_ops: the `nl` destination lane operands
# nl:      the lane count
# lw:      the native lane width in bytes
# left:    true for a left shift
# arith:   true for an arithmetic right shift (a non-zero fill)
# ret:     ok(true) on success, or an allocation error
fun emit_shift_barrel(alloc: *A.Allocator, plan: *LanePlan, f: *mir.MirFunction, mi: *mir.MirInstr,
                      dst: *mir.MirInstr, cursor: *u32,
                      src_ops: *mir.MirOperand, dst_ops: *mir.MirOperand, nl: u32, lw: u8,
                      left: bool, arith: bool) R.Result[bool, str] {
    val lb:     u32 = lw::u32 * 8;
    val stages: u32 = shift_stage_count(nl * lb);
    # only the count's low lane is read: log2(width) bits never reach past one lane.
    val cnt: mir.MirOperand = lane_operand(plan, ?mi.operands[2], 0);

    var fill: mir.MirOperand = mir.op_imm(0);
    # a single-lane arithmetic barrel never shifts by a whole lane, so it never reads
    # the fill and never builds one.
    if (arith && nl > 1) {
        val rf: R.Result[bool, str] = emit_sign_fill(alloc, f, mi, dst, cursor,
                                                     src_ops[nl - 1], lw, ?fill);
        if (R.is_err[bool, str](rf)) { ret rf; }
    }

    var cur: [MAX_SHIFT_LANES]mir.MirOperand;
    var sh:  [MAX_SHIFT_LANES]mir.MirOperand;
    var nxt: [MAX_SHIFT_LANES]mir.MirOperand;
    var i: u32 = 0;
    for (i < nl) { cur[i] = src_ops[i]; i = i + 1; }

    var j: u32 = 0;
    for (j < stages) {
        # the count's bit `j`, isolated into a 0 / 1 byte.
        var bit_src: mir.MirOperand = cnt;
        if (j > 0) {
            val rt: R.Result[u32, str] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (R.is_err[u32, str](rt)) { ret R.err[bool, str](R.unwrap_err[u32, str](rt)); }
            bit_src = mir.op_vreg(R.unwrap_ok[u32, str](rt));
            val r1: R.Result[bool, str] = emit_bin(alloc, dst, cursor, mi, mir.MIR_SHR_U,
                                                   bit_src, cnt, mir.op_imm(j::i64), lw);
            if (R.is_err[bool, str](r1)) { ret r1; }
        }
        val rb: R.Result[u32, str] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (R.is_err[u32, str](rb)) { ret R.err[bool, str](R.unwrap_err[u32, str](rb)); }
        val bit: mir.MirOperand = mir.op_vreg(R.unwrap_ok[u32, str](rb));
        val r2: R.Result[bool, str] = emit_bin(alloc, dst, cursor, mi, mir.MIR_AND, bit,
                                               bit_src, mir.op_imm(1), lw);
        if (R.is_err[bool, str](r2)) { ret r2; }

        # `0 - bit` is all-ones exactly when the bit is set: the select's mask.
        val rm: R.Result[u32, str] = new_vreg(alloc, f, mir.REG_CLASS_GP);
        if (R.is_err[u32, str](rm)) { ret R.err[bool, str](R.unwrap_err[u32, str](rm)); }
        val mask: mir.MirOperand = mir.op_vreg(R.unwrap_ok[u32, str](rm));
        val r3: R.Result[bool, str] = emit_bin(alloc, dst, cursor, mi, mir.MIR_SUB, mask,
                                               mir.op_imm(0), bit, lw);
        if (R.is_err[bool, str](r3)) { ret r3; }

        i = 0;
        for (i < nl) {
            val rs: R.Result[u32, str] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (R.is_err[u32, str](rs)) { ret R.err[bool, str](R.unwrap_err[u32, str](rs)); }
            sh[i] = mir.op_vreg(R.unwrap_ok[u32, str](rs));
            i = i + 1;
        }
        val c: u32 = 1 << j;
        val r4: R.Result[bool, str] = emit_const_shift(alloc, f, mi, dst, cursor, ?cur[0], ?sh[0],
                                                       nl, lw, c / lb, c % lb, left, arith, fill);
        if (R.is_err[bool, str](r4)) { ret r4; }

        # the last stage lands in the destination lanes; the rest in fresh running ones.
        if (j == stages - 1) {
            i = 0;
            for (i < nl) { nxt[i] = dst_ops[i]; i = i + 1; }
        }
        or {
            i = 0;
            for (i < nl) {
                val rn: R.Result[u32, str] = new_vreg(alloc, f, mir.REG_CLASS_GP);
                if (R.is_err[u32, str](rn)) { ret R.err[bool, str](R.unwrap_err[u32, str](rn)); }
                nxt[i] = mir.op_vreg(R.unwrap_ok[u32, str](rn));
                i = i + 1;
            }
        }

        i = 0;
        for (i < nl) {
            val rx: R.Result[u32, str] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (R.is_err[u32, str](rx)) { ret R.err[bool, str](R.unwrap_err[u32, str](rx)); }
            val x: mir.MirOperand = mir.op_vreg(R.unwrap_ok[u32, str](rx));
            val r5: R.Result[bool, str] = emit_bin(alloc, dst, cursor, mi, mir.MIR_XOR, x, cur[i], sh[i], lw);
            if (R.is_err[bool, str](r5)) { ret r5; }

            val ry: R.Result[u32, str] = new_vreg(alloc, f, mir.REG_CLASS_GP);
            if (R.is_err[u32, str](ry)) { ret R.err[bool, str](R.unwrap_err[u32, str](ry)); }
            val y: mir.MirOperand = mir.op_vreg(R.unwrap_ok[u32, str](ry));
            val r6: R.Result[bool, str] = emit_bin(alloc, dst, cursor, mi, mir.MIR_AND, y, x, mask, lw);
            if (R.is_err[bool, str](r6)) { ret r6; }

            val r7: R.Result[bool, str] = emit_bin(alloc, dst, cursor, mi, mir.MIR_XOR, nxt[i], cur[i], y, lw);
            if (R.is_err[bool, str](r7)) { ret r7; }
            i = i + 1;
        }

        i = 0;
        for (i < nl) { cur[i] = nxt[i]; i = i + 1; }
        j = j + 1;
    }
    ret R.ok[bool, str](true);
}

# the destination lane count of a width-changing op (its operation width in native
# lanes, at least one)
fun dst_lane_count(plan: *LanePlan, mi: *mir.MirInstr) u32 {
    var n: u32 = (mi.width / plan.lane_width)::u32;
    if (n == 0) { n = 1; }
    ret n;
}

# the source lane count of a width-changing op (its source width in native lanes,
# at least one)
fun src_lane_count(plan: *LanePlan, mi: *mir.MirInstr) u32 {
    var n: u32 = (mi.src_width / plan.lane_width)::u32;
    if (n == 0) { n = 1; }
    ret n;
}

# expand a zero-extension into per-lane moves: the low lanes copy the source, the
# high lanes are zeroed
fun expand_zext(alloc: *A.Allocator, plan: *LanePlan, mi: *mir.MirInstr,
                dst: *mir.MirInstr, cursor: *u32) R.Result[bool, str] {
    if (mi.operand_count != 2 ||
        mi.operands[0].kind != mir.MIR_OP_VREG || plan.lane_base[mi.operands[0].vreg] == LANE_NONE) {
        ret R.err[bool, str](unsupported_message(mi.opcode, mi.width));
    }
    val dl: u32 = dst_lane_count(plan, mi);
    val sl: u32 = src_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;
    var i: u32 = 0;
    for (i < dl) {
        var ops: [2]mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        if (i < sl) { ops[1] = lane_operand(plan, ?mi.operands[1], i); }
        or          { ops[1] = mir.op_imm(0); }
        val r: R.Result[bool, str] = emit_piece(alloc, dst, cursor, mi, mir.MIR_MOV, ?ops[0], 2, lw);
        if (R.is_err[bool, str](r)) { ret r; }
        i = i + 1;
    }
    ret R.ok[bool, str](true);
}

# expand a truncation into per-lane moves of the low destination lanes; the high
# source lanes are dropped
fun expand_trunc(alloc: *A.Allocator, plan: *LanePlan, mi: *mir.MirInstr,
                 dst: *mir.MirInstr, cursor: *u32) R.Result[bool, str] {
    if (mi.operand_count != 2) {
        ret R.err[bool, str](unsupported_message(mi.opcode, mi.width));
    }
    val dl: u32 = dst_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;
    var i: u32 = 0;
    for (i < dl) {
        var ops: [2]mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        ops[1] = lane_operand(plan, ?mi.operands[1], i);
        val r: R.Result[bool, str] = emit_piece(alloc, dst, cursor, mi, mir.MIR_MOV, ?ops[0], 2, lw);
        if (R.is_err[bool, str](r)) { ret r; }
        i = i + 1;
    }
    ret R.ok[bool, str](true);
}

# emit one native three-operand (or two-operand) binary piece `d = a op b`
fun emit_bin(alloc: *A.Allocator, dst: *mir.MirInstr, cursor: *u32, src: *mir.MirInstr,
             opcode: mir.MirOpcode, d: mir.MirOperand, a: mir.MirOperand, b: mir.MirOperand, w: u8) R.Result[bool, str] {
    var ops: [3]mir.MirOperand;
    ops[0] = d;
    ops[1] = a;
    ops[2] = b;
    ret emit_piece(alloc, dst, cursor, src, opcode, ?ops[0], 3, w);
}

# the diagnostic for a wide operation this pass does not legalize
#
# Names the numeric opcode and width so the failure is specific, mirroring the
# vector path's loud unsupported-lane-op discipline. A static message (no
# allocator) keeps the pass allocation-free on its error paths.
# ---
# op:    the unsupported wide opcode
# width: the operation width in bytes
# ret:   the diagnostic string
fun unsupported_message(op: mir.MirOpcode, width: u8) str {
    if (op == mir.MIR_MUL)     { ret "legalize: wide multiply by a non-constant is unsupported on this target"; }
    if (op == mir.MIR_DIV_S || op == mir.MIR_DIV_U) { ret "legalize: wide divide is unsupported on this target"; }
    if (op == mir.MIR_REM_S || op == mir.MIR_REM_U) { ret "legalize: wide remainder is unsupported on this target"; }
    if (is_shift(op)) {
        ret "legalize: shift through an unsupported operand shape on this target";
    }
    if (op == mir.MIR_LOAD || op == mir.MIR_STORE) {
        ret "legalize: wide memory access through an unsupported operand shape on this target";
    }
    if (op == mir.MIR_GEP || op == mir.MIR_ALLOCA) {
        ret "legalize: materializing an address wider than one register is not yet legalized on this target";
    }
    # a wide SIGN-extension became reachable only once an 8-byte scalar reported its
    # real width (#2323); until then no wide value of any kind got this far on the one
    # target that legalizes. It is named rather than left to the generic message, so the
    # frontier reads as the specific unimplemented expansion it is.
    if (op == mir.MIR_SEXT) {
        ret "legalize: wide sign-extension is not yet legalized on this target";
    }
    ret "legalize: operation wider than the target ALU is unsupported";
}

# test-only: the machine facts of a target with `maw`-byte lanes, a machine-word
# pointer, and a two-register address-staging pair at ids 6 / 7 (the mos6502 shape)
fun t_mach(maw: u8, ptr: u8) Machine {
    var m: Machine;
    m.lane_width = maw;
    m.ptr_width  = ptr;
    # the 6502 shape: no variable-count shift, so the pass owns every shift
    m.var_shift  = false;
    m.stage_lo   = 6;
    m.stage_hi   = 7;
    ret m;
}

# test-only: heap vreg table of `n` general-purpose vregs
fun t_vregs(alloc: *A.Allocator, f: *mir.MirFunction, n: u32) {
    val r: R.Result[*mir.MirVReg, str] = A.allocate[mir.MirVReg](alloc, n::usize);
    f.vregs     = R.unwrap_ok[*mir.MirVReg, str](r);
    f.vreg_count = n;
    f.vreg_cap   = n;
    var i: u32 = 0;
    for (i < n) {
        f.vregs[i].id         = i;
        f.vregs[i].class      = mir.REG_CLASS_GP;
        f.vregs[i].spill_slot = -1;
        f.vregs[i].assigned   = mir.MIR_VREG_NIL;
        f.vregs[i].vector     = false;
        i = i + 1;
    }
}

# test-only: heap block of `n` instructions, each with a fresh heap operand array
fun t_block(alloc: *A.Allocator, b: *mir.MirBlock, n: u32) {
    val r: R.Result[*mir.MirInstr, str] = A.zallocate[mir.MirInstr](alloc, n::usize);
    b.instrs      = R.unwrap_ok[*mir.MirInstr, str](r);
    b.instr_count = n;
    b.instr_cap   = n;
    b.id          = 0;
}

# test-only: write instruction `ix` of a block with a heap-copied operand array
fun t_instr(alloc: *A.Allocator, b: *mir.MirBlock, ix: u32, opcode: mir.MirOpcode,
            ops: *mir.MirOperand, nops: u32, width: u8) {
    val r: R.Result[*mir.MirOperand, str] = A.allocate[mir.MirOperand](alloc, nops::usize);
    val arr: *mir.MirOperand = R.unwrap_ok[*mir.MirOperand, str](r);
    var j: u32 = 0;
    for (j < nops) { arr[j] = ops[j]; j = j + 1; }
    b.instrs[ix].opcode        = opcode;
    b.instrs[ix].operands      = arr;
    b.instrs[ix].operand_count = nops;
    b.instrs[ix].width         = width;
    b.instrs[ix].src_width     = width;
    b.instrs[ix].vec_lane      = mir.VEC_LANE_NONE;
}

# a function whose every scalar op fits the native ALU (width <= max_alu_width) is
# returned untouched: no vreg added, the block array pointer and count unchanged.
# this is the byte-identical inertness path every wide-native target takes
test "mach.lang.be.codegen.legalize:inert_on_native_width" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_vreg(0); ops[1] = mir.op_vreg(1); ops[2] = mir.op_vreg(2);
    t_instr(?alloc, ?b, 0, mir.MIR_ADD, ?ops[0], 3, 8);  # width 8 == native
    f.blocks = ?b; f.block_count = 1;

    val before_ptr:   *mir.MirInstr = b.instrs;
    val before_count: u32           = b.instr_count;
    val before_vregs: u32           = f.vreg_count;

    var mach: Machine = t_mach(8, 8);
    val r: R.Result[bool, str] = legalize_function(?alloc, ?mach, ?f);
    if (R.is_err[bool, str](r))         { ret 1; }
    if (b.instrs != before_ptr)         { ret 1; }  # not reallocated
    if (b.instr_count != before_count)  { ret 1; }  # not rewritten
    if (f.vreg_count != before_vregs)   { ret 1; }  # no lane vregs added
    ret 0;
}

# a width-2 add on an 8-bit ALU (max_alu_width 1) expands into the two-lane carry
# chain: low lane `add ; cmp` then top lane `add ; add`, four native-width pieces
# whose destinations are the destination vreg's two fresh byte lanes
test "mach.lang.be.codegen.legalize:expands_wide_add_carry_chain" {
    var alloc: A.Allocator;
    page.make(?alloc);

    # v0 = v1 + v2, all i16; v1 / v2 are defined by wide immediate moves so the
    # planner marks them wide (a real lowered function defines every value vreg).
    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 3);
    var m1: [2]mir.MirOperand;
    m1[0] = mir.op_vreg(1); m1[1] = mir.op_imm(0x0102);
    t_instr(?alloc, ?b, 0, mir.MIR_MOV, ?m1[0], 2, 2);
    var m2: [2]mir.MirOperand;
    m2[0] = mir.op_vreg(2); m2[1] = mir.op_imm(0x0304);
    t_instr(?alloc, ?b, 1, mir.MIR_MOV, ?m2[0], 2, 2);
    var ad: [3]mir.MirOperand;
    ad[0] = mir.op_vreg(0); ad[1] = mir.op_vreg(1); ad[2] = mir.op_vreg(2);
    t_instr(?alloc, ?b, 2, mir.MIR_ADD, ?ad[0], 3, 2);
    f.blocks = ?b; f.block_count = 1;

    var mach: Machine = t_mach(1, 2);
    val r: R.Result[bool, str] = legalize_function(?alloc, ?mach, ?f);
    if (R.is_err[bool, str](r)) { ret 1; }

    # lanes are assigned in definition order (v1 -> v3,v4; v2 -> v5,v6; v0 -> v7,v8),
    # two per wide vreg = 6 fresh lane vregs, plus the two-lane add chain's carry and
    # top-lane temp = 3 + 6 + 2 = 11.
    if (f.vreg_count != 11) { ret 1; }

    # two moves (2 lanes each) + the four-piece add chain = 8 instructions.
    if (b.instr_count != 8) { ret 1; }

    # the add chain occupies pieces 4..7. piece 4: add low lane -> v0 lane 0 (v7);
    # piece 5: cmp producing the carry; piece 6/7: top lane add + carry-in add,
    # the last writing v0 lane 1 (v8).
    if (b.instrs[4].opcode != mir.MIR_ADD)      { ret 1; }
    if (b.instrs[4].width != 1)                 { ret 1; }
    if (b.instrs[4].operands[0].vreg != 7)      { ret 1; }  # v0 lane 0
    if (b.instrs[5].opcode != mir.MIR_CMP_LT_U) { ret 1; }
    if (b.instrs[6].opcode != mir.MIR_ADD)      { ret 1; }
    if (b.instrs[7].opcode != mir.MIR_ADD)      { ret 1; }
    if (b.instrs[7].operands[0].vreg != 8)      { ret 1; }  # v0 lane 1
    ret 0;
}

# a wide operation the pass does not legalize (a divide) fails loudly with a
# diagnostic naming the operation, never silently miscompiling
test "mach.lang.be.codegen.legalize:rejects_unsupported_wide_op" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_vreg(0); ops[1] = mir.op_vreg(1); ops[2] = mir.op_vreg(2);
    t_instr(?alloc, ?b, 0, mir.MIR_DIV_U, ?ops[0], 3, 2);  # wide divide, unsupported
    f.blocks = ?b; f.block_count = 1;

    var mach: Machine = t_mach(1, 2);
    val r: R.Result[bool, str] = legalize_function(?alloc, ?mach, ?f);
    if (!R.is_err[bool, str](r)) { ret 1; }
    ret 0;
}

# a wide memory access at a FIXED base - a physical register, the shape the ABI emits
# for an incoming stack parameter - decomposes into one native access per lane at
# successive displacements, and a move with a memory operand becomes the load it is
test "mach.lang.be.codegen.legalize:expands_wide_access_at_a_fixed_base" {
    var alloc: A.Allocator;
    page.make(?alloc);

    # v0 = [fp + 0] as a width-4 move, exactly `emit_param_slot`'s stack-scalar form.
    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 1);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var ld: [2]mir.MirOperand;
    ld[0] = mir.op_vreg(0); ld[1] = mir.op_mem_preg(0, 0);
    t_instr(?alloc, ?b, 0, mir.MIR_MOV, ?ld[0], 2, 4);
    f.blocks = ?b; f.block_count = 1;

    var mach: Machine = t_mach(1, 2);
    val r: R.Result[bool, str] = legalize_function(?alloc, ?mach, ?f);
    if (R.is_err[bool, str](r))  { ret 1; }
    if (b.instr_count != 4)      { ret 1; }

    var i: u32 = 0;
    for (i < 4) {
        if (b.instrs[i].opcode != mir.MIR_LOAD)             { ret 1; }
        if (b.instrs[i].width != 1)                         { ret 1; }
        if (b.instrs[i].operands[0].vreg != 1 + i)          { ret 1; }  # v0's byte lanes
        if (b.instrs[i].operands[1].kind != mir.MIR_OP_MEM) { ret 1; }
        if (b.instrs[i].operands[1].preg != 0)              { ret 1; }  # still off fp
        if (b.instrs[i].operands[1].imm != i::i64)          { ret 1; }
        i = i + 1;
    }
    ret 0;
}

# a wide value placed in a physical register decomposes onto the CONSECUTIVE register
# run starting there - the hidden result pointer arriving in the convention's pair
test "mach.lang.be.codegen.legalize:expands_wide_preg_move_onto_consecutive_regs" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 1);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var mv: [2]mir.MirOperand;
    mv[0] = mir.op_vreg(0); mv[1] = mir.op_preg(4);
    t_instr(?alloc, ?b, 0, mir.MIR_MOV, ?mv[0], 2, 2);
    f.blocks = ?b; f.block_count = 1;

    var mach: Machine = t_mach(1, 2);
    val r: R.Result[bool, str] = legalize_function(?alloc, ?mach, ?f);
    if (R.is_err[bool, str](r)) { ret 1; }
    if (b.instr_count != 2)     { ret 1; }
    if (b.instrs[0].operands[0].vreg != 1 || b.instrs[0].operands[1].preg != 4) { ret 1; }
    if (b.instrs[1].operands[0].vreg != 2 || b.instrs[1].operands[1].preg != 5) { ret 1; }
    ret 0;
}

# a memory access through a RUNTIME pointer stages the pointer's lanes into the
# backend's reserved address pair and decomposes at that fixed base
#
# Both the wide access (the four bytes of a `u32`) and the NARROW one are covered: the
# narrow case is not an optimization but a correctness requirement, since the pointer's
# defining instruction is replaced by its lane moves and a base still naming it would
# name a vreg nothing defines.
test "mach.lang.be.codegen.legalize:stages_runtime_pointer_into_the_address_pair" {
    var alloc: A.Allocator;
    page.make(?alloc);

    # v0 = the incoming pointer (2 lanes); v1 = a wide value; store v1 through v0, then
    # read one byte back through the same pointer.
    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 4);
    var p: [2]mir.MirOperand;
    p[0] = mir.op_vreg(0); p[1] = mir.op_preg(4);
    t_instr(?alloc, ?b, 0, mir.MIR_MOV, ?p[0], 2, 2);
    var v: [2]mir.MirOperand;
    v[0] = mir.op_vreg(1); v[1] = mir.op_imm(0x01020304);
    t_instr(?alloc, ?b, 1, mir.MIR_MOV, ?v[0], 2, 4);
    var stv: [2]mir.MirOperand;
    stv[0] = mir.op_mem_value(0, 0); stv[1] = mir.op_vreg(1);
    t_instr(?alloc, ?b, 2, mir.MIR_STORE, ?stv[0], 2, 4);
    var ldv: [2]mir.MirOperand;
    ldv[0] = mir.op_vreg(2); ldv[1] = mir.op_mem_value(0, 3);
    t_instr(?alloc, ?b, 3, mir.MIR_LOAD, ?ldv[0], 2, 1);
    f.blocks = ?b; f.block_count = 1;

    var mach: Machine = t_mach(1, 2);
    val r: R.Result[bool, str] = legalize_function(?alloc, ?mach, ?f);
    if (R.is_err[bool, str](r)) { ret 1; }
    # 2 pointer lanes + 4 value lanes + (2 staging + 4 stores) + (2 staging + 1 load).
    if (b.instr_count != 15) { ret 1; }

    # the wide store: staged into the reserved pair, then four byte writes off it.
    if (b.instrs[6].operands[0].preg != 6) { ret 1; }
    if (b.instrs[7].operands[0].preg != 7) { ret 1; }
    var i: u32 = 0;
    for (i < 4) {
        val st: *mir.MirInstr = ?b.instrs[8 + i];
        if (st.opcode != mir.MIR_STORE)             { ret 1; }
        if (st.width != 1)                          { ret 1; }
        if (st.operands[0].kind != mir.MIR_OP_MEM)  { ret 1; }
        if (st.operands[0].vreg != mir.MIR_VREG_NIL){ ret 1; }
        if (st.operands[0].preg != 6)               { ret 1; }
        if (st.operands[0].imm != i::i64)           { ret 1; }
        i = i + 1;
    }
    # the narrow load through the same pointer is staged too, keeping its displacement.
    if (b.instrs[12].operands[0].preg != 6)          { ret 1; }
    if (b.instrs[13].operands[0].preg != 7)          { ret 1; }
    if (b.instrs[14].opcode != mir.MIR_LOAD)         { ret 1; }
    if (b.instrs[14].operands[1].preg != 6)          { ret 1; }
    if (b.instrs[14].operands[1].imm != 3)           { ret 1; }
    ret 0;
}

# a target whose pointer is a machine word never takes the staging path: a narrow
# access through a value base is not wide, so the function is returned untouched.
# this is the inertness clause that keeps every wide-native target byte-identical
test "mach.lang.be.codegen.legalize:value_base_is_inert_on_a_wide_pointer_target" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 2);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var ops: [2]mir.MirOperand;
    ops[0] = mir.op_vreg(1); ops[1] = mir.op_mem_value(0, 0);
    t_instr(?alloc, ?b, 0, mir.MIR_LOAD, ?ops[0], 2, 8);  # width 8 == native
    f.blocks = ?b; f.block_count = 1;

    val before_ptr:   *mir.MirInstr = b.instrs;
    val before_vregs: u32           = f.vreg_count;

    var mach: Machine = t_mach(8, 8);
    val r: R.Result[bool, str] = legalize_function(?alloc, ?mach, ?f);
    if (R.is_err[bool, str](r))       { ret 1; }
    if (b.instrs != before_ptr)       { ret 1; }
    if (b.instr_count != 1)           { ret 1; }
    if (f.vreg_count != before_vregs) { ret 1; }
    ret 0;
}

# test-only: a one-instruction function `v0 = v1 <shift> count` at `width` bytes, with
# `v1` defined by a wide immediate move so the planner marks it (and `v0`) wide
fun t_shift_fn(alloc: *A.Allocator, f: *mir.MirFunction, b: *mir.MirBlock,
               op: mir.MirOpcode, width: u8, count: mir.MirOperand) {
    t_vregs(alloc, f, 3);
    t_block(alloc, b, 3);
    var mv: [2]mir.MirOperand;
    mv[0] = mir.op_vreg(1); mv[1] = mir.op_imm(0x01020304);
    t_instr(alloc, b, 0, mir.MIR_MOV, ?mv[0], 2, width);
    var mn: [2]mir.MirOperand;
    mn[0] = mir.op_vreg(2); mn[1] = mir.op_imm(3);
    t_instr(alloc, b, 1, mir.MIR_MOV, ?mn[0], 2, 1);
    var sh: [3]mir.MirOperand;
    sh[0] = mir.op_vreg(0); sh[1] = mir.op_vreg(1); sh[2] = count;
    t_instr(alloc, b, 2, op, ?sh[0], 3, width);
    f.blocks = b; f.block_count = 1;
}

# a CONSTANT-count wide shift is a pure template: a lane renaming plus one native shift
# per contributing lane, with the bits crossing a lane boundary OR'd in from the
# neighbour. no control flow, and no dependence between lanes
#
# The issue this closes claimed a wide shift needs control flow the legalizer cannot
# emit. It does not - and the constant case never did: the rejection keyed on the
# OPCODE, so `v << 3` on a `u32` died beside `v << n`. A width-4 shift by 3 on an 8-bit
# ALU is four byte lanes: the low lane shifts alone (nothing crosses in from below) and
# each of the three above joins its own shifted bits with the neighbour's, so ten
# pieces - and the block gains no instruction that is not one of them.
test "mach.lang.be.codegen.legalize:expands_constant_wide_shift_as_a_template" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    var b: mir.MirBlock;
    t_shift_fn(?alloc, ?f, ?b, mir.MIR_SHL, 4, mir.op_imm(3));

    var mach: Machine = t_mach(1, 2);
    val r: R.Result[bool, str] = legalize_function(?alloc, ?mach, ?f);
    if (R.is_err[bool, str](r)) { ret 1; }

    # 4 lanes of the wide immediate move + 1 narrow count move + the 10-piece template.
    if (b.instr_count != 15) { ret 1; }
    # lanes are assigned in definition order: the value's four (v3..v6), then the
    # destination's four (v7..v10). the template's first piece is the TOP destination
    # lane - a left shift walks DOWN, so a written lane is never a source a later lane
    # still needs, which is what would let the two lane arrays be the same storage.
    if (b.instrs[5].opcode != mir.MIR_SHL)      { ret 1; }
    if (b.instrs[6].opcode != mir.MIR_SHR_U)    { ret 1; }
    if (b.instrs[7].opcode != mir.MIR_OR)       { ret 1; }
    if (b.instrs[7].operands[0].vreg != 10)     { ret 1; }  # destination lane 3
    # the low lane needs no neighbour: one shift, straight into destination lane 0.
    if (b.instrs[14].opcode != mir.MIR_SHL)     { ret 1; }
    if (b.instrs[14].operands[0].vreg != 7)     { ret 1; }  # destination lane 0
    if (b.instrs[14].operands[1].vreg != 3)     { ret 1; }  # value lane 0
    if (b.instrs[14].operands[2].imm  != 3)     { ret 1; }  # by the constant count
    # every piece is native width, and none is a branch: a shift emits no control flow.
    var i: u32 = 5;
    for (i < 15) {
        if (b.instrs[i].width != 1)                { ret 1; }
        if (b.instrs[i].opcode == mir.MIR_BR)      { ret 1; }
        if (b.instrs[i].opcode == mir.MIR_CBR)     { ret 1; }
        i = i + 1;
    }
    # and the function still has exactly one block: the pass added no region.
    if (f.block_count != 1) { ret 1; }

    # an ARITHMETIC right shift below one whole lane builds NO sign fill: the top source
    # lane's own arithmetic shift already fills with its sign, so nothing reads a fill
    # byte. At one lane that makes a constant shift exactly the one native instruction it
    # should be, and at two lanes it is the straddling pair plus that top-lane shift.
    var f1: mir.MirFunction;
    var b1: mir.MirBlock;
    t_shift_fn(?alloc, ?f1, ?b1, mir.MIR_SHR_S, 1, mir.op_imm(3));
    if (R.is_err[bool, str](legalize_function(?alloc, ?mach, ?f1))) { ret 1; }
    if (b1.instr_count != 3)                     { ret 1; }  # two moves + the shift
    if (b1.instrs[2].opcode != mir.MIR_SHR_S)    { ret 1; }

    var f2: mir.MirFunction;
    var b2: mir.MirBlock;
    t_shift_fn(?alloc, ?f2, ?b2, mir.MIR_SHR_S, 2, mir.op_imm(3));
    if (R.is_err[bool, str](legalize_function(?alloc, ?mach, ?f2))) { ret 1; }
    if (b2.instr_count != 7)                     { ret 1; }  # 2 move lanes + 1 count + 4

    # a count that DOES reach a whole lane leaves a destination lane fed entirely from
    # above the value, so the sign fill is materialized - once, and only then.
    var f3: mir.MirFunction;
    var b3: mir.MirBlock;
    t_shift_fn(?alloc, ?f3, ?b3, mir.MIR_SHR_S, 2, mir.op_imm(8));
    if (R.is_err[bool, str](legalize_function(?alloc, ?mach, ?f3))) { ret 1; }
    if (b3.instr_count != 6)                     { ret 1; }  # 2 move lanes + 1 count + 3
    if (b3.instrs[3].opcode != mir.MIR_SHR_S)    { ret 1; }  # the sign fill itself
    ret 0;
}

# a RUNTIME-count shift expands into a straight-line masked barrel, still with no
# control flow and at a piece count that is a closed formula in the width
#
# The other half the issue got wrong. A loop or a jump table would need blocks this pass
# cannot create; the barrel needs none, and its cost does not depend on the count -
# which a jump table's would. The counts are pinned per width and per shift so a change
# to the expansion has to state what it costs.
test "mach.lang.be.codegen.legalize:expands_runtime_shift_as_a_masked_barrel" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var widths: [3]u8;   widths[0] = 1;  widths[1] = 2;  widths[2] = 4;
    var shl:    [3]u32;  shl[0]    = 20; shl[1]    = 49; shl[2]    = 112;
    var shrs:   [3]u32;  shrs[0]   = 20; shrs[1]   = 50; shrs[2]   = 113;

    var w: u32 = 0;
    for (w < 3) {
        var f: mir.MirFunction;
        var b: mir.MirBlock;
        t_shift_fn(?alloc, ?f, ?b, mir.MIR_SHL, widths[w], mir.op_vreg(2));
        var mach: Machine = t_mach(1, 2);
        if (R.is_err[bool, str](legalize_function(?alloc, ?mach, ?f))) { ret 1; }
        # the wide immediate move's lanes + the narrow count move + the barrel.
        if (b.instr_count != widths[w]::u32 + 1 + shl[w]) { ret 1; }
        if (f.block_count != 1)                           { ret 1; }
        var i: u32 = 0;
        for (i < b.instr_count) {
            if (b.instrs[i].opcode == mir.MIR_BR)  { ret 1; }
            if (b.instrs[i].opcode == mir.MIR_CBR) { ret 1; }
            i = i + 1;
        }

        # the arithmetic form costs one more piece per multi-lane width: the sign fill,
        # materialized once and reused by every stage. at one lane it costs nothing at
        # all, because the top lane's own arithmetic shift already fills with its sign.
        var f2: mir.MirFunction;
        var b2: mir.MirBlock;
        t_shift_fn(?alloc, ?f2, ?b2, mir.MIR_SHR_S, widths[w], mir.op_vreg(2));
        if (R.is_err[bool, str](legalize_function(?alloc, ?mach, ?f2))) { ret 1; }
        if (b2.instr_count != widths[w]::u32 + 1 + shrs[w]) { ret 1; }
        w = w + 1;
    }
    ret 0;
}

# an out-of-range constant count is normalized to the operation width, so the constant
# and the runtime path answer the same thing on the same target
#
# The language declines to fold a count at or past the width (`me.pass.constfold`) - the
# answer is target-defined - so this pass defines it, and defines it as what the barrel
# reads for free: the low log2(width) bits. A count of 19 on a 16-bit value is therefore
# a count of 3, expanding to exactly the same pieces.
test "mach.lang.be.codegen.legalize:normalizes_an_out_of_range_shift_count" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(1, 2);

    var f3: mir.MirFunction;
    var b3: mir.MirBlock;
    t_shift_fn(?alloc, ?f3, ?b3, mir.MIR_SHL, 2, mir.op_imm(3));
    if (R.is_err[bool, str](legalize_function(?alloc, ?mach, ?f3))) { ret 1; }

    var f19: mir.MirFunction;
    var b19: mir.MirBlock;
    t_shift_fn(?alloc, ?f19, ?b19, mir.MIR_SHL, 2, mir.op_imm(19));
    if (R.is_err[bool, str](legalize_function(?alloc, ?mach, ?f19))) { ret 1; }

    if (b19.instr_count != b3.instr_count) { ret 1; }
    var i: u32 = 0;
    for (i < b3.instr_count) {
        if (b19.instrs[i].opcode != b3.instrs[i].opcode) { ret 1; }
        if (b19.instrs[i].operand_count != b3.instrs[i].operand_count) { ret 1; }
        var k: u32 = 0;
        for (k < b3.instrs[i].operand_count) {
            if (b19.instrs[i].operands[k].kind != b3.instrs[i].operands[k].kind) { ret 1; }
            if (b19.instrs[i].operands[k].imm  != b3.instrs[i].operands[k].imm)  { ret 1; }
            if (b19.instrs[i].operands[k].vreg != b3.instrs[i].operands[k].vreg) { ret 1; }
            k = k + 1;
        }
        i = i + 1;
    }
    # a count of exactly the width is a count of zero: the shift becomes a lane copy.
    var f16: mir.MirFunction;
    var b16: mir.MirBlock;
    t_shift_fn(?alloc, ?f16, ?b16, mir.MIR_SHL, 2, mir.op_imm(16));
    if (R.is_err[bool, str](legalize_function(?alloc, ?mach, ?f16))) { ret 1; }
    if (b16.instr_count != 5)                  { ret 1; }  # 2 move lanes + 1 count + 2 copies
    if (b16.instrs[3].opcode != mir.MIR_MOV)   { ret 1; }
    if (b16.instrs[4].opcode != mir.MIR_MOV)   { ret 1; }
    ret 0;
}

# a machine that HAS a variable-count shift is left alone: the shift clause is dead and
# the pass is the width test it always was
#
# This is the inertness half for x86-64 / aarch64 / riscv64, where a shift is a single
# instruction at any count. A native-width shift there must come back untouched - no
# rewrite, no vreg added, no block rebuilt - which is what keeps their output
# byte-identical.
test "mach.lang.be.codegen.legalize:shift_is_inert_on_a_variable_shift_machine" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var sh: [3]mir.MirOperand;
    sh[0] = mir.op_vreg(0); sh[1] = mir.op_vreg(1); sh[2] = mir.op_vreg(2);
    t_instr(?alloc, ?b, 0, mir.MIR_SHL, ?sh[0], 3, 8);  # width 8 == native
    f.blocks = ?b; f.block_count = 1;

    val before_ptr:   *mir.MirInstr = b.instrs;
    val before_vregs: u32           = f.vreg_count;

    var mach: Machine = t_mach(8, 8);
    mach.var_shift = true;
    val r: R.Result[bool, str] = legalize_function(?alloc, ?mach, ?f);
    if (R.is_err[bool, str](r))       { ret 1; }
    if (b.instrs != before_ptr)       { ret 1; }
    if (b.instr_count != 1)           { ret 1; }
    if (f.vreg_count != before_vregs) { ret 1; }

    # the SAME machine without the capability legalizes the shift instead, so the clause
    # is the fact that decides it and not something else about the target.
    mach.var_shift = false;
    if (R.is_err[bool, str](legalize_function(?alloc, ?mach, ?f))) { ret 1; }
    if (b.instrs == before_ptr) { ret 1; }
    ret 0;
}

# a shift at a width that is not a power of two is REFUSED, never silently mis-shifted
#
# The barrel reads log2(width) bits of the count, which only names a width that is a
# power of two; a width of three bytes has no such reading, so the expansion says so
# rather than picking one.
test "mach.lang.be.codegen.legalize:rejects_a_shift_at_a_non_power_of_two_width" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: mir.MirFunction;
    var b: mir.MirBlock;
    t_shift_fn(?alloc, ?f, ?b, mir.MIR_SHL, 3, mir.op_vreg(2));
    var mach: Machine = t_mach(1, 2);
    if (!R.is_err[bool, str](legalize_function(?alloc, ?mach, ?f))) { ret 1; }
    ret 0;
}
