use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator.page;
use std_format: std.format;

use std_allocator: std.allocator;

use codegen_mir: mach.lang.be.codegen.mir;
use mir_context: mach.lang.be.codegen.mir.context;
use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.me.ir.value;
use mach.lang.target.isa;
use mach.lang.target.resolved;
use mach.lang.wide;

# mul_form is the target's declared realization of a lane-width widening
# multiply (isa.MulWideForm); pair_lo and pair_hi are its fixed accumulator
# pair when the form is MULW_FIXED_PAIR (#3511)
rec Machine {
    lane_width: u8;
    ptr_width:  u8;
    var_shift:  bool;
    has_mul:    bool;
    mul_hi:     u8;
    mul_form:   isa.MulWideForm;
    pair_lo:    i32;
    pair_hi:    i32;
    stage_lo:   i32;
    stage_hi:   i32;
    fp_class:   u32;
}

val FP_CLASS_NONE: u32 = 0xFFFFFFFF;

fun float_class_of(tgt: *resolved.Target) u32 {
    if (tgt.model.reg_classes == nil) { ret FP_CLASS_NONE; }
    var i: u32 = 0;
    for (i < tgt.model.reg_class_len) {
        if (tgt.model.reg_classes[i].kind == isa.RC_FLOAT) { ret i; }
        i = i + 1;
    }
    ret FP_CLASS_NONE;
}

# f and diags: the function under legalization and the module's diagnostic
# store, where a refusal of the program's operand widths lands
rec LanePlan {
    lane_base:  *u32;
    lane_count: *u8;
    orig_count: u32;
    lane_width: u8;
    mach:       Machine;
    f:          *codegen_mir.MirFunction;
    diags:      *diagnostic.DiagnosticStore;
}

val LANE_NONE: u32 = 0xFFFFFFFF;

pub fun run(tgt: *resolved.Target, m: *codegen_mir.MirModule) err[fail.Fail] {
    if (tgt == nil) { ret err[fail.Fail].err{fail.message("legalize: nil target")}; }
    if (m == nil)   { ret err[fail.Fail].err{fail.message("legalize: nil mir module")}; }

    val maw: u32 = isa.max_alu_width(?tgt.model);
    if (maw == 0) { ret err[fail.Fail].ok{}; }

    var mach: Machine;
    mach.lane_width = maw::u8;
    mach.ptr_width  = tgt.model.pointer_width::u8;
    mach.var_shift  = tgt.model.has_var_shift;
    mach.has_mul    = tgt.model.has_mul;
    mach.mul_hi     = tgt.model.mul_hi_width::u8;
    mach.mul_form   = tgt.model.mul_wide_form;
    mach.pair_lo    = tgt.model.div_reg;
    mach.pair_hi    = tgt.model.div_hi_reg;
    mach.stage_lo   = -1;
    mach.stage_hi   = -1;
    mach.fp_class   = float_class_of(tgt);
    if (tgt.arch != nil) {
        mach.stage_lo = tgt.arch.scratch_reg;
        mach.stage_hi = tgt.arch.scratch_reg2;
    }

    var i: u32 = 0;
    for (i < m.function_len) {
        val res_fn: err[fail.Fail] = legalize_function(m.alloc, ?mach, ?m.functions[i], m.diags);
        if (sel res_fn.err) { ret res_fn; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun function_needs_legalize(f: *codegen_mir.MirFunction, mach: *Machine) bool {
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val b:  *codegen_mir.MirBlock = ?f.blocks[bi];
        var ii: u32                   = 0;
        for (ii < b.instr_count) {
            if (instr_needs_legalize(f, ?b.instrs[ii], mach)) { ret true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

fun instr_needs_legalize(f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr, mach: *Machine) bool {
    if (is_lane_op(mi.opcode))                                        { ret true; }
    if (conv_is_wide(mach, mi))                                       { ret true; }
    if (is_scalar_wide_mul(mi))                                       { ret true; }
    if (is_mul_hi(mi) && mach.mul_hi == 0)                            { ret true; }
    if (instr_rides_fp_bank(f, mi))                                   { ret false; }
    if (mi.width > mach.lane_width || mi.src_width > mach.lane_width) { ret true; }
    if (!mach.var_shift && is_shift(mi.opcode))                       { ret true; }
    if (!mach.has_mul && mi.opcode == codegen_mir.MIR_MUL)            { ret true; }
    ret mach.ptr_width > mach.lane_width && instr_has_value_base(mi);
}

fun is_shift(op: codegen_mir.MirOpcode) bool {
    ret codegen_mir.has(op, codegen_mir.MIRF_SHIFT);
}

# the lane ops exist only to be expanded here: a wide value stated as its
# pieces by whoever produced them (#3602)
fun is_lane_op(op: codegen_mir.MirOpcode) bool {
    ret op == codegen_mir.MIR_LANE_JOIN || op == codegen_mir.MIR_LANE_PICK;
}

# a scalar widening multiply exists only above the ALU width and is realized
# here through the target's declared form; its vector twin is a packed cell
# isel selects
fun is_scalar_wide_mul(mi: *codegen_mir.MirInstr) bool {
    if (mi.vec_lane != codegen_mir.VEC_LANE_NONE) { ret false; }
    ret mi.opcode == codegen_mir.MIR_MUL_WIDE_U || mi.opcode == codegen_mir.MIR_MUL_WIDE_S;
}

# a scalar high multiply; its vector twin is a packed cell isel selects (#4119)
fun is_mul_hi(mi: *codegen_mir.MirInstr) bool {
    if (mi.vec_lane != codegen_mir.VEC_LANE_NONE) { ret false; }
    ret mi.opcode == codegen_mir.MIR_MUL_HI_U || mi.opcode == codegen_mir.MIR_MUL_HI_S;
}

fun instr_has_value_base(mi: *codegen_mir.MirInstr) bool {
    var k: u32 = 0;
    for (k < mi.operand_count) {
        val op: *codegen_mir.MirOperand = ?mi.operands[k];
        if (op.kind == codegen_mir.MIR_OP_MEM && !codegen_mir.vreg_is_nil(op.vreg)) { ret true; }
        k = k + 1;
    }
    ret false;
}

# a float lives whole in its bank whatever its width, so an instruction that
# names one, by vreg or by physical register, is not split into integer lanes
fun instr_rides_fp_bank(f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr) bool {
    if (mi.vec_lane != codegen_mir.VEC_LANE_NONE) { ret true; }
    var k: u32 = 0;
    for (k < mi.operand_count) {
        val op: *codegen_mir.MirOperand = ?mi.operands[k];
        if (op.kind == codegen_mir.MIR_OP_VREG && op.vreg.n < f.vreg_count) {
            if (f.vregs[op.vreg.n].vec_bytes != 0)  { ret true; }
            if (codegen_mir.vreg_is_fp(f, op.vreg)) { ret true; }
        }
        if (op.kind == codegen_mir.MIR_OP_PREG && isa.regid_class(codegen_mir.preg_regid(op.preg)) != isa.REG_CLASS_ID_GP) { ret true; }
        k = k + 1;
    }
    ret false;
}

fun legalize_function(alloc: *std_allocator.Allocator, mach: *Machine, f: *codegen_mir.MirFunction, diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    if (!function_needs_legalize(f, mach)) { ret err[fail.Fail].ok{}; }

    var plan:     LanePlan;
    val res_plan: err[fail.Fail] = plan_lanes(alloc, mach, f, ?plan);
    if (sel res_plan.err) { ret res_plan; }
    plan.f     = f;
    plan.diags = diags;

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val res_b: err[fail.Fail] = legalize_block(alloc, ?plan, f, ?f.blocks[bi]);
        if (sel res_b.err) {
            free_plan(alloc, ?plan);
            ret res_b;
        }
        bi = bi + 1;
    }

    free_plan(alloc, ?plan);
    ret err[fail.Fail].ok{};
}

fun plan_lanes(alloc: *std_allocator.Allocator, mach: *Machine, f: *codegen_mir.MirFunction, out: *LanePlan) err[fail.Fail] {
    val maw:      u8                             = mach.lane_width;
    val n:        u32                            = f.vreg_count;
    val res_base: res[*u32, std_allocator.Error] = std_allocator.allocate[u32](alloc, n::usize);
    if (sel res_base.err) { ret err[fail.Fail].err{fail.refused(res_base.err)}; }
    val res_cnt: res[*u8, std_allocator.Error] = std_allocator.allocate[u8](alloc, n::usize);
    if (sel res_cnt.err) {
        std_allocator.deallocate[u32](alloc, res_base.ok, n::usize);
        ret err[fail.Fail].err{fail.refused(res_cnt.err)};
    }
    out.lane_base  = res_base.ok;
    out.lane_count = res_cnt.ok;
    out.orig_count = n;
    out.lane_width = maw;
    out.mach       = @mach;

    var v: u32 = 0;
    for (v < n) {
        out.lane_base[v]  = LANE_NONE;
        out.lane_count[v] = 0;
        v                 = v + 1;
    }

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val b:  *codegen_mir.MirBlock = ?f.blocks[bi];
        var ii: u32                   = 0;
        for (ii < b.instr_count) {
            val mi:       *codegen_mir.MirInstr = ?b.instrs[ii];
            val conv_dst: bool                  = conv_is_wide(mach, mi) &&
                mi.operand_count > 0 &&
                mi.operands[0].kind == codegen_mir.MIR_OP_VREG &&
                !codegen_mir.vreg_is_fp(f, mi.operands[0].vreg);
            if ((!instr_rides_fp_bank(f, mi) || conv_dst) && codegen_mir.instr_defines_shape(mi) &&
                !codegen_mir.is_cmp_opcode(mi.opcode) &&
                mi.width > maw && mi.operand_count > 0 &&
                mi.operands[0].kind == codegen_mir.MIR_OP_VREG) {
                val dv: u32 = mi.operands[0].vreg.n;
                if (dv < n && out.lane_base[dv] == LANE_NONE) {
                    val nlanes: u32                 = (mi.width / maw)::u32;
                    val res_l:  res[u32, fail.Fail] = alloc_lanes(alloc, f, dv, nlanes);
                    if (sel res_l.err) {
                        free_plan(alloc, out);
                        ret err[fail.Fail].err{res_l.err};
                    }
                    out.lane_base[dv]  = res_l.ok;
                    out.lane_count[dv] = nlanes::u8;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun alloc_lanes(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, wide: u32, nlanes: u32) res[u32, fail.Fail] {
    val cls:  u32 = f.vregs[wide].class;
    var base: u32 = codegen_mir.MIR_VREG_NIL.n;
    var i:    u32 = 0;
    for (i < nlanes) {
        val res_v: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, cls);
        if (sel res_v.err) { ret res[u32, fail.Fail].err{res_v.err}; }
        val vid: u32 = res_v.ok.n;
        # a lane is the wide value: the seed the validator and the allocator read must follow it
        f.vregs[vid].secret = f.vregs[wide].secret;
        if (i == 0) { base = vid; }
        i = i + 1;
    }
    ret res[u32, fail.Fail].ok{base};
}

fun new_vreg(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, cls: u32) res[codegen_mir.VRegId, fail.Fail] {
    if (f.vreg_count >= f.vreg_cap) {
        var new_cap: u32 = f.vreg_cap * 2;
        if (new_cap == 0) { new_cap = codegen_mir.INITIAL_VREG_CAP; }
        val res_v: res[*codegen_mir.MirVReg, std_allocator.Error] = std_allocator.reallocate[codegen_mir.MirVReg](alloc, f.vregs, f.vreg_cap::usize, new_cap::usize);
        if (sel res_v.err) { ret res[codegen_mir.VRegId, fail.Fail].err{fail.refused(res_v.err)}; }
        f.vregs    = res_v.ok;
        f.vreg_cap = new_cap;
    }
    val vid: u32 = f.vreg_count;
    f.vregs[vid] = codegen_mir.vreg(vid, cls, 0, false);
    f.vreg_count = f.vreg_count + 1;
    ret res[codegen_mir.VRegId, fail.Fail].ok{codegen_mir.vreg_id(vid)};
}

fun free_plan(alloc: *std_allocator.Allocator, plan: *LanePlan) {
    if (plan.lane_base != nil) {
        std_allocator.deallocate[u32](alloc, plan.lane_base, plan.orig_count::usize);
        plan.lane_base = nil;
    }
    if (plan.lane_count != nil) {
        std_allocator.deallocate[u8](alloc, plan.lane_count, plan.orig_count::usize);
        plan.lane_count = nil;
    }
}

fun legalize_block(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, b: *codegen_mir.MirBlock) err[fail.Fail] {
    val n: u32 = b.instr_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    var total:        u32  = 0;
    var needs_expand: bool = false;
    var i:            u32  = 0;
    for (i < n) {
        val mi: *codegen_mir.MirInstr = ?b.instrs[i];
        if (instr_needs_legalize(f, mi, ?plan.mach)) {
            val res_c: res[u32, fail.Fail] = expansion_count(alloc, plan, f, mi);
            if (sel res_c.err) { ret err[fail.Fail].err{res_c.err}; }
            total        = total + res_c.ok;
            needs_expand = true;
        }
        or { total = total + 1; }
        i = i + 1;
    }

    i = 0;
    for (i < n) {
        val ra: err[fail.Fail] = check_address_operands(plan, f, ?b.instrs[i]);
        if (sel ra.err) { ret ra; }
        val rb: err[fail.Fail] = rebind_lanes(alloc, plan, ?b.instrs[i]);
        if (sel rb.err) { ret rb; }
        i = i + 1;
    }

    if (!needs_expand) { ret err[fail.Fail].ok{}; }

    val res_dst: res[*codegen_mir.MirInstr, std_allocator.Error] = std_allocator.zallocate[codegen_mir.MirInstr](alloc, total::usize);
    if (sel res_dst.err) { ret err[fail.Fail].err{fail.refused(res_dst.err)}; }
    val dst: *codegen_mir.MirInstr = res_dst.ok;

    var w: u32 = 0;
    i = 0;
    for (i < n) {
        val mi: *codegen_mir.MirInstr = ?b.instrs[i];
        if (instr_needs_legalize(f, mi, ?plan.mach)) {
            val first: u32            = w;
            val res_e: err[fail.Fail] = expand_instr(alloc, plan, f, mi, dst, ?w);
            if (sel res_e.err) {
                free_pieces(alloc, dst, w);
                std_allocator.deallocate[codegen_mir.MirInstr](alloc, dst, total::usize);
                ret res_e;
            }
            # the expansion starts where the source did and ends where it did
            if (w > first) {
                val res_dbg: err[fail.Fail] = codegen_mir.instr_spread_dbg(alloc, mi, ?dst[first], ?dst[w - 1]);
                if (sel res_dbg.err) {
                    free_pieces(alloc, dst, w);
                    std_allocator.deallocate[codegen_mir.MirInstr](alloc, dst, total::usize);
                    ret res_dbg;
                }
            }
            free_source_operands(alloc, mi);
        }
        or {
            dst[w] = @mi;
            w      = w + 1;
        }
        i = i + 1;
    }

    if (w != total) {
        free_pieces(alloc, dst, w);
        std_allocator.deallocate[codegen_mir.MirInstr](alloc, dst, total::usize);
        ret err[fail.Fail].err{fail.message("legalize: an expansion emitted a different number of pieces than it counted (internal compiler error, see briar-systems/mach#2778)")};
    }

    if (b.instrs != nil && b.instr_cap > 0) {
        std_allocator.deallocate[codegen_mir.MirInstr](alloc, b.instrs, b.instr_cap::usize);
    }
    b.instrs      = dst;
    b.instr_count = w;
    b.instr_cap   = total;
    ret err[fail.Fail].ok{};
}

# an address is formed at the pointer width, so a memory operand may name a
# wide value only where the expansion stages it: a base on a target whose
# pointer is wider than its ALU. an index, or a base anywhere else, would
# leave a use of a value that no longer exists once its lanes replace it (#3615)
fun check_address_operands(plan: *LanePlan, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr) err[fail.Fail] {
    val staged_base: bool = plan.mach.ptr_width > plan.lane_width && instr_needs_legalize(f, mi, ?plan.mach);
    var k:           u32  = 0;
    for (k < mi.operand_count) {
        val op: *codegen_mir.MirOperand = ?mi.operands[k];
        if (op.kind == codegen_mir.MIR_OP_MEM) {
            if (!codegen_mir.vreg_is_nil(op.vreg) && is_wide_vreg(plan, op.vreg.n) && !staged_base) {
                ret err[fail.Fail].err{fail.message("legalize: an address is based on a value wider than the address (internal compiler error: lowering forms an address at the pointer width)")};
            }
            if (sel op.index.vreg) {
                if (is_wide_vreg(plan, op.index.vreg.n)) {
                    ret err[fail.Fail].err{fail.message("legalize: an address is indexed by a value wider than the address (internal compiler error: gep lowering narrows an index to the pointer width, see briar-systems/mach#3615)")};
                }
            }
        }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun free_pieces(alloc: *std_allocator.Allocator, dst: *codegen_mir.MirInstr, count: u32) {
    var i: u32 = 0;
    for (i < count) {
        if (dst[i].operands != nil && dst[i].operand_count > 0) {
            std_allocator.deallocate[codegen_mir.MirOperand](alloc, dst[i].operands, dst[i].operand_count::usize);
        }
        i = i + 1;
    }
}

fun free_source_operands(alloc: *std_allocator.Allocator, mi: *codegen_mir.MirInstr) {
    if (mi.operands != nil && mi.operand_count > 0) {
        std_allocator.deallocate[codegen_mir.MirOperand](alloc, mi.operands, mi.operand_count::usize);
    }
    mi.operands      = nil;
    mi.operand_count = 0;
    if (mi.dbg_bindings != nil && mi.dbg_binding_count > 0) {
        std_allocator.deallocate[codegen_mir.MirDbgBinding](alloc, mi.dbg_bindings, mi.dbg_binding_count::usize);
    }
    mi.dbg_bindings      = nil;
    mi.dbg_binding_count = 0;
}

fun is_wide_vreg(plan: *LanePlan, v: u32) bool {
    ret v < plan.orig_count && plan.lane_base[v] != LANE_NONE;
}

# how many bindings one binding becomes: a lane each for a wide value, none for a
# comparison over one, which no lane expresses
fun rebound_count(plan: *LanePlan, b: *codegen_mir.MirDbgBinding) u32 {
    if (b.cmp_op != 0) {
        if (is_wide_vreg(plan, b.vreg) || is_wide_vreg(plan, b.vreg2)) { ret 0; }
        ret 1;
    }
    if (!is_wide_vreg(plan, b.vreg)) { ret 1; }
    val nl: u32 = plan.lane_count[b.vreg]::u32;
    if (nl > codegen_mir.DBG_LANES_MAX) { ret 1; }
    ret nl;
}

# the lanes are the value once it is legalized, so every binding that names a
# wide value names its lanes instead
fun rebind_lanes(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr) err[fail.Fail] {
    val n:       u32  = mi.dbg_binding_count;
    var total:   u32  = 0;
    var changed: bool = false;
    var i:       u32  = 0;
    for (i < n) {
        val b: *codegen_mir.MirDbgBinding = ?mi.dbg_bindings[i];
        val c: u32                        = rebound_count(plan, b);
        if (c != 1 || (b.cmp_op == 0 && is_wide_vreg(plan, b.vreg))) { changed = true; }
        total = total + c;
        i     = i + 1;
    }
    if (!changed) { ret err[fail.Fail].ok{}; }

    var out: *codegen_mir.MirDbgBinding = nil;
    if (total > 0) {
        val ra: res[*codegen_mir.MirDbgBinding, std_allocator.Error] = std_allocator.allocate[codegen_mir.MirDbgBinding](alloc, total::usize);
        if (sel ra.err) { ret err[fail.Fail].err{fail.refused(ra.err)}; }
        out = ra.ok;
    }
    var w: u32 = 0;
    i = 0;
    for (i < n) {
        val b: *codegen_mir.MirDbgBinding = ?mi.dbg_bindings[i];
        val c: u32                        = rebound_count(plan, b);
        if (c == 1 && (b.cmp_op != 0 || !is_wide_vreg(plan, b.vreg))) {
            out[w] = @b;
            w      = w + 1;
        }
        or (c == 1) {
            # more lanes than a location describes: the variable stays, unlocated
            out[w]      = @b;
            out[w].vreg = codegen_mir.MIR_VREG_NIL.n;
            w           = w + 1;
        }
        or {
            var k: u32 = 0;
            for (k < c) {
                out[w]            = @b;
                out[w].vreg       = plan.lane_base[b.vreg] + k;
                out[w].lane       = k::u8;
                out[w].lanes      = c::u8;
                out[w].lane_bytes = plan.lane_width;
                out[w].last_bytes = 0;
                w                 = w + 1;
                k                 = k + 1;
            }
        }
        i = i + 1;
    }
    std_allocator.deallocate[codegen_mir.MirDbgBinding](alloc, mi.dbg_bindings, n::usize);
    mi.dbg_bindings      = out;
    mi.dbg_binding_count = total;
    ret err[fail.Fail].ok{};
}

fun expansion_count(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction,
    mi: *codegen_mir.MirInstr) res[u32, fail.Fail] {
    val op: codegen_mir.MirOpcode = mi.opcode;
    val nl: u32                   = wide_lane_count(plan, mi);

    if (op == codegen_mir.MIR_LANE_JOIN) { ret lane_join_piece_count(alloc, plan, mi); }
    if (op == codegen_mir.MIR_LANE_PICK) { ret lane_pick_piece_count(alloc, plan, mi); }

    # a physical register is one lane wide: whoever splits a wide value over
    # registers states the pieces with a lane op, and nothing here may find
    # lane k of a register by its id (#3602)
    if (nl > 1 && instr_names_preg(mi)) {
        val rj: res[str, std_format.FormatError] = std_format.sprint(alloc,
            "legalize: a physical register carries a value wider than the ALU ({}, {} bytes wide; internal compiler error: ABI lowering states the lanes with MIR_LANE_JOIN and MIR_LANE_PICK, see briar-systems/mach#3602)",
            codegen_mir.opcode_name(op), mi.width);
        if (sel rj.err) { ret res[u32, fail.Fail].err{fail.format_refused(rj.err)}; }
        ret res[u32, fail.Fail].err{fail.message(rj.ok)};
    }

    if (conv_is_wide(?plan.mach, mi)) { ret conv_piece_count(alloc, plan, f, mi); }

    if (is_scalar_wide_mul(mi)) { ret mul_wide_piece_count(alloc, plan, mi); }
    if (is_mul_hi(mi))          { ret mul_hi_piece_count(alloc, plan, mi); }

    if (instr_is_memory(mi)) { ret memory_piece_count(alloc, plan, mi); }

    if (op == codegen_mir.MIR_AND || op == codegen_mir.MIR_OR || op == codegen_mir.MIR_XOR || op == codegen_mir.MIR_NOT) {
        ret res[u32, fail.Fail].ok{nl};
    }
    if (is_shift(op)) { ret shift_piece_count(alloc, plan, mi); }
    if (op == codegen_mir.MIR_MOV || op == codegen_mir.MIR_DECLASSIFY || op == codegen_mir.MIR_BITCAST) {
        ret res[u32, fail.Fail].ok{nl};
    }
    if (op == codegen_mir.MIR_ADD || op == codegen_mir.MIR_SUB || op == codegen_mir.MIR_NEG) {
        ret res[u32, fail.Fail].ok{addsub_chain_piece_count(nl)};
    }
    if (op == codegen_mir.MIR_ZEXT) {
        ret res[u32, fail.Fail].ok{dst_lane_count(plan, mi)};
    }
    if (op == codegen_mir.MIR_SEXT) {
        val dl: u32 = dst_lane_count(plan, mi);
        val sl: u32 = src_lane_count(plan, mi);
        var n:  u32 = dl;
        if (dl > sl && !sext_folds_immediate(mi)) { n = n + 1; }
        ret res[u32, fail.Fail].ok{n};
    }
    if (op == codegen_mir.MIR_TRUNC) {
        ret res[u32, fail.Fail].ok{dst_lane_count(plan, mi)};
    }
    if (op == codegen_mir.MIR_MUL) { ret mul_piece_count(alloc, plan, mi); }
    if (op == codegen_mir.MIR_DIV_S || op == codegen_mir.MIR_DIV_U ||
        op == codegen_mir.MIR_REM_S || op == codegen_mir.MIR_REM_U) {
        ret divmod_piece_count(alloc, plan, mi);
    }
    if (codegen_mir.is_cmp_opcode(op)) { ret cmp_piece_count(alloc, plan, mi); }
    ret res[u32, fail.Fail].err{unsupported(alloc, plan, mi, op)};
}

fun wide_lane_count(plan: *LanePlan, mi: *codegen_mir.MirInstr) u32 {
    var wbytes: u8 = mi.width;
    if (mi.src_width > wbytes) { wbytes = mi.src_width; }
    var n: u32 = (wbytes / plan.lane_width)::u32;
    if (n == 0) { n = 1; }
    ret n;
}

fun instr_is_memory(mi: *codegen_mir.MirInstr) bool {
    if (!codegen_mir.has(mi.opcode, codegen_mir.MIRF_ADDRESSED)) { ret false; }
    ret addr_operand_index(mi) >= 0;
}

fun addr_operand_index(mi: *codegen_mir.MirInstr) i32 {
    val sym_is_addr: bool = codegen_mir.has(mi.opcode, codegen_mir.MIRF_MEMORY);
    var k:           u32  = 0;
    for (k < mi.operand_count) {
        val kind: codegen_mir.MirOperandKind = mi.operands[k].kind;
        if (kind == codegen_mir.MIR_OP_MEM)                { ret k::i32; }
        if (kind == codegen_mir.MIR_OP_SYM && sym_is_addr) { ret k::i32; }
        k = k + 1;
    }
    ret -1;
}

fun addr_displaced(base: *codegen_mir.MirOperand, off: i64) codegen_mir.MirOperand {
    var o: codegen_mir.MirOperand = @base;
    if (o.kind == codegen_mir.MIR_OP_SYM) {
        o.sym_off = base.sym_off + off;
        ret o;
    }
    o.imm = base.imm + off;
    ret o;
}

fun base_needs_staging(plan: *LanePlan, mem: *codegen_mir.MirOperand) bool {
    ret !codegen_mir.vreg_is_nil(mem.vreg) && mem.vreg.n < plan.orig_count &&
        plan.lane_base[mem.vreg.n] != LANE_NONE;
}

fun memory_piece_count(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr) res[u32, fail.Fail] {
    if (mi.operand_count != 2) { ret res[u32, fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)}; }
    val mx: i32 = addr_operand_index(mi);
    val vx: u32 = 1 - mx::u32;
    var n:  u32 = wide_lane_count(plan, mi);
    if (!operand_is_lane_ready(plan, ?mi.operands[vx], n)) {
        ret res[u32, fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
    }
    val mem: *codegen_mir.MirOperand = ?mi.operands[mx::u32];
    if (base_needs_staging(plan, mem)) {
        val pl: u32 = plan.lane_count[mem.vreg.n]::u32;
        if (pl != 2 || plan.mach.stage_lo < 0 || plan.mach.stage_hi < 0) {
            ret res[u32, fail.Fail].err{codegen_mir.reject_instr_at(plan.diags, diagnostic_kind.TARGET_UNSUPPORTED_OP, plan.f, mi, "a runtime pointer needs a two-register address-staging pair this target does not reserve")};
        }
        n = n + pl;
    }
    ret res[u32, fail.Fail].ok{n};
}

fun expand_memory(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val rc: res[u32, fail.Fail] = memory_piece_count(alloc, plan, mi);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }

    val mx:       u32  = addr_operand_index(mi)::u32;
    val vx:       u32  = 1 - mx;
    val lw:       u8   = plan.lane_width;
    val nl:       u32  = wide_lane_count(plan, mi);
    val is_store: bool = mx == 0;

    var base: codegen_mir.MirOperand = mi.operands[mx];
    if (base_needs_staging(plan, ?base)) {
        val lo: u32            = plan.lane_base[base.vreg.n];
        val r1: err[fail.Fail] = emit_stage_move(alloc, dst, cursor, mi, plan.mach.stage_lo, lo, lw);
        if (sel r1.err) { ret r1; }
        val r2: err[fail.Fail] = emit_stage_move(alloc, dst, cursor, mi, plan.mach.stage_hi, lo + 1, lw);
        if (sel r2.err) { ret r2; }
        base = codegen_mir.op_mem_preg(codegen_mir.preg_id(plan.mach.stage_lo), base.imm);
    }

    var i: u32 = 0;
    for (i < nl) {
        val mem:    codegen_mir.MirOperand = addr_displaced(?base, (i * lw::u32)::i64);
        var ops:    [2]codegen_mir.MirOperand;
        var opcode: codegen_mir.MirOpcode  = codegen_mir.MIR_LOAD;
        if (is_store) {
            opcode = codegen_mir.MIR_STORE;
            ops[0] = mem;
            ops[1] = lane_operand(plan, ?mi.operands[vx], i);
        }
        or {
            ops[0] = lane_operand(plan, ?mi.operands[vx], i);
            ops[1] = mem;
        }
        val r: err[fail.Fail] = emit_piece(alloc, dst, cursor, mi, opcode, ?ops[0], 2, lw);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun emit_stage_move(alloc: *std_allocator.Allocator, dst: *codegen_mir.MirInstr, cursor: *u32, src: *codegen_mir.MirInstr,
    preg: i32, lane: u32, lw: u8) err[fail.Fail] {
    var ops: [2]codegen_mir.MirOperand;
    ops[0] = codegen_mir.op_preg(codegen_mir.preg_id(preg));
    ops[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(lane));
    ret emit_piece(alloc, dst, cursor, src, codegen_mir.MIR_MOV, ?ops[0], 2, lw);
}

fun expand_instr(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val op: codegen_mir.MirOpcode = mi.opcode;

    if (op == codegen_mir.MIR_LANE_JOIN) {
        ret expand_lane_join(alloc, plan, mi, dst, cursor);
    }
    if (op == codegen_mir.MIR_LANE_PICK) {
        ret expand_lane_pick(alloc, plan, mi, dst, cursor);
    }
    if (conv_is_wide(?plan.mach, mi)) {
        ret conv_run(alloc, plan, f, mi, dst, cursor);
    }
    if (is_scalar_wide_mul(mi)) {
        ret expand_mul_wide(alloc, plan, f, mi, dst, cursor);
    }
    if (is_mul_hi(mi)) {
        ret expand_mul_hi(alloc, plan, f, mi, dst, cursor);
    }
    if (instr_is_memory(mi)) {
        ret expand_memory(alloc, plan, mi, dst, cursor);
    }
    if (op == codegen_mir.MIR_AND || op == codegen_mir.MIR_OR || op == codegen_mir.MIR_XOR) {
        ret expand_bitwise(alloc, plan, mi, dst, cursor);
    }
    if (op == codegen_mir.MIR_NOT) {
        ret expand_not(alloc, plan, mi, dst, cursor);
    }
    if (is_shift(op)) {
        ret expand_shift(alloc, plan, f, mi, dst, cursor);
    }
    if (op == codegen_mir.MIR_MOV || op == codegen_mir.MIR_DECLASSIFY || op == codegen_mir.MIR_BITCAST) {
        ret expand_mov(alloc, plan, mi, dst, cursor);
    }
    if (op == codegen_mir.MIR_ADD || op == codegen_mir.MIR_SUB) {
        ret expand_addsub(alloc, plan, f, mi, dst, cursor, op == codegen_mir.MIR_SUB);
    }
    if (op == codegen_mir.MIR_NEG) {
        ret expand_neg(alloc, plan, f, mi, dst, cursor);
    }
    if (op == codegen_mir.MIR_MUL) {
        ret expand_mul(alloc, plan, f, mi, dst, cursor);
    }
    if (op == codegen_mir.MIR_DIV_S || op == codegen_mir.MIR_DIV_U ||
        op == codegen_mir.MIR_REM_S || op == codegen_mir.MIR_REM_U) {
        ret expand_divmod(alloc, plan, f, mi, dst, cursor);
    }
    if (codegen_mir.is_cmp_opcode(op)) {
        ret expand_cmp(alloc, plan, f, mi, dst, cursor);
    }
    if (op == codegen_mir.MIR_ZEXT) {
        ret expand_zext(alloc, plan, mi, dst, cursor);
    }
    if (op == codegen_mir.MIR_SEXT) {
        ret expand_sext(alloc, plan, f, mi, dst, cursor);
    }
    if (op == codegen_mir.MIR_TRUNC) {
        ret expand_trunc(alloc, plan, mi, dst, cursor);
    }
    ret err[fail.Fail].err{unsupported(alloc, plan, mi, op)};
}

fun emit_piece(alloc: *std_allocator.Allocator, dst: *codegen_mir.MirInstr, cursor: *u32, src: *codegen_mir.MirInstr,
    opcode: codegen_mir.MirOpcode, ops: *codegen_mir.MirOperand, nops: u32, width: u8) err[fail.Fail] {
    ret emit_piece_from(alloc, dst, cursor, src, opcode, ops, nops, width, width);
}

# a piece whose source width differs from its width: the lane-wide convert of a
# sub-word source, which is where the shared lowering narrows a scalar convert
fun emit_piece_from(alloc: *std_allocator.Allocator, dst: *codegen_mir.MirInstr, cursor: *u32, src: *codegen_mir.MirInstr,
    opcode: codegen_mir.MirOpcode, ops: *codegen_mir.MirOperand, nops: u32, width: u8, src_width: u8) err[fail.Fail] {
    if (src.vec_lane != codegen_mir.VEC_LANE_NONE) {
        ret err[fail.Fail].err{fail.message("internal compiler error: width legalization cannot expand a vector-lane instruction without a lane-aware piece emitter; vec_lane would be silently dropped")};
    }
    var arr: *codegen_mir.MirOperand = nil;
    if (nops > 0) {
        val res_a: res[*codegen_mir.MirOperand, std_allocator.Error] = std_allocator.allocate[codegen_mir.MirOperand](alloc, nops::usize);
        if (sel res_a.err) { ret err[fail.Fail].err{fail.refused(res_a.err)}; }
        arr = res_a.ok;
        var j: u32 = 0;
        for (j < nops) {
            arr[j] = ops[j];
            j      = j + 1;
        }
    }
    val ci: u32 = @cursor;
    dst[ci] = codegen_mir.instr(opcode, arr, nops, width, src_width);
    val p: *codegen_mir.MirInstr = ?dst[ci];
    p.loc           = src.loc;
    p.inline_site   = src.inline_site;
    p.writes_secret = src.writes_secret;
    p.memory_flags  = src.memory_flags;
    @cursor         = ci + 1;
    ret err[fail.Fail].ok{};
}

# lane i of an operand: a planned vreg's lane, an immediate's slice. a physical
# register has no lane i; expansion_count has refused it before this is asked
fun lane_operand(plan: *LanePlan, op: *codegen_mir.MirOperand, i: u32) codegen_mir.MirOperand {
    if (op.kind == codegen_mir.MIR_OP_VREG && op.vreg.n < plan.orig_count && plan.lane_base[op.vreg.n] != LANE_NONE) {
        ret codegen_mir.op_vreg(codegen_mir.vreg_id(plan.lane_base[op.vreg.n] + i));
    }
    if (op.kind == codegen_mir.MIR_OP_IMM) {
        ret codegen_mir.op_imm(imm_lane(op, i, plan.lane_width));
    }
    ret @op;
}

fun operand_is_lane_ready(plan: *LanePlan, op: *codegen_mir.MirOperand, nl: u32) bool {
    if (op.kind == codegen_mir.MIR_OP_VREG) {
        if (op.vreg.n < plan.orig_count && plan.lane_base[op.vreg.n] != LANE_NONE) { ret true; }
        ret nl == 1;
    }
    ret op.kind == codegen_mir.MIR_OP_IMM;
}

fun instr_names_preg(mi: *codegen_mir.MirInstr) bool {
    var k: u32 = 0;
    for (k < mi.operand_count) {
        if (mi.operands[k].kind == codegen_mir.MIR_OP_PREG) { ret true; }
        k = k + 1;
    }
    ret false;
}

# a lane piece is one register, one narrow vreg or one stack word
fun lane_piece_kind_ok(plan: *LanePlan, op: *codegen_mir.MirOperand) bool {
    if (op.kind == codegen_mir.MIR_OP_VREG) { ret !is_wide_vreg(plan, op.vreg.n); }
    ret op.kind == codegen_mir.MIR_OP_PREG || op.kind == codegen_mir.MIR_OP_MEM;
}

val LANE_JOIN_SHAPE: str = "legalize: a lane join does not name one piece per lane of its value (internal compiler error, see briar-systems/mach#3602)";
val LANE_PICK_SHAPE: str = "legalize: a lane pick does not name a lane of a wide value (internal compiler error, see briar-systems/mach#3602)";

fun lane_join_piece_count(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr) res[u32, fail.Fail] {
    val nl: u32 = wide_lane_count(plan, mi);
    if (nl < 2 || mi.operand_count != nl + 1 || mi.operands[0].kind != codegen_mir.MIR_OP_VREG ||
        !is_wide_vreg(plan, mi.operands[0].vreg.n) || plan.lane_count[mi.operands[0].vreg.n]::u32 != nl) {
        ret res[u32, fail.Fail].err{fail.message(LANE_JOIN_SHAPE)};
    }
    var k: u32 = 1;
    for (k < mi.operand_count) {
        if (!lane_piece_kind_ok(plan, ?mi.operands[k])) { ret res[u32, fail.Fail].err{fail.message(LANE_JOIN_SHAPE)}; }
        k = k + 1;
    }
    ret res[u32, fail.Fail].ok{nl};
}

# lane k of the value is piece k: a move from a register or vreg, a load from
# a stack word
fun expand_lane_join(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val rc: res[u32, fail.Fail] = lane_join_piece_count(alloc, plan, mi);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    val lw:   u8  = plan.lane_width;
    val base: u32 = plan.lane_base[mi.operands[0].vreg.n];
    var k:    u32 = 0;
    for (k < rc.ok) {
        val piece: *codegen_mir.MirOperand = ?mi.operands[1 + k];
        var ops:   [2]codegen_mir.MirOperand;
        ops[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(base + k));
        ops[1] = @piece;
        var opcode: codegen_mir.MirOpcode = codegen_mir.MIR_MOV;
        if (piece.kind == codegen_mir.MIR_OP_MEM) { opcode = codegen_mir.MIR_LOAD; }
        val r: err[fail.Fail] = emit_piece(alloc, dst, cursor, mi, opcode, ?ops[0], 2, lw);
        if (sel r.err) { ret r; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

# the wide value a pick reads: a planned vreg, an immediate, or memory at the
# source width, whose lane k is the word k lanes in
fun lane_pick_source_ok(plan: *LanePlan, mi: *codegen_mir.MirInstr) bool {
    val src: *codegen_mir.MirOperand = ?mi.operands[1];
    val nl:  u32                     = (mi.src_width / plan.lane_width)::u32;
    if (nl < 2) { ret false; }
    if (src.kind == codegen_mir.MIR_OP_VREG) {
        ret is_wide_vreg(plan, src.vreg.n) && plan.lane_count[src.vreg.n]::u32 == nl;
    }
    if (src.kind == codegen_mir.MIR_OP_MEM) { ret mi.operands[0].kind != codegen_mir.MIR_OP_MEM; }
    ret src.kind == codegen_mir.MIR_OP_IMM;
}

fun lane_pick_piece_count(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr) res[u32, fail.Fail] {
    if (mi.operand_count != 3 || mi.operands[2].kind != codegen_mir.MIR_OP_IMM || !lane_piece_kind_ok(plan, ?mi.operands[0]) ||
        !lane_pick_source_ok(plan, mi)) {
        ret res[u32, fail.Fail].err{fail.message(LANE_PICK_SHAPE)};
    }
    val k: i64 = mi.operands[2].imm;
    if (k < 0 || k >= (mi.src_width / plan.lane_width)::i64) {
        ret res[u32, fail.Fail].err{fail.message(LANE_PICK_SHAPE)};
    }
    ret res[u32, fail.Fail].ok{1};
}

# the piece receives lane k of the value: a move into a register or vreg, a
# store into a stack word, a load when the value itself is in memory
fun expand_lane_pick(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val rc: res[u32, fail.Fail] = lane_pick_piece_count(alloc, plan, mi);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    val lw:  u8                      = plan.lane_width;
    val k:   u32                     = mi.operands[2].imm::u32;
    val src: *codegen_mir.MirOperand = ?mi.operands[1];
    var ops: [2]codegen_mir.MirOperand;
    ops[0] = mi.operands[0];
    var opcode: codegen_mir.MirOpcode = codegen_mir.MIR_MOV;
    if (src.kind == codegen_mir.MIR_OP_MEM) {
        opcode = codegen_mir.MIR_LOAD;
        ops[1] = addr_displaced(src, (k * lw::u32)::i64);
    }
    or {
        ops[1] = lane_operand(plan, src, k);
        if (mi.operands[0].kind == codegen_mir.MIR_OP_MEM) { opcode = codegen_mir.MIR_STORE; }
    }
    ret emit_piece(alloc, dst, cursor, mi, opcode, ?ops[0], 2, lw);
}

# lane i of width w of a 128-bit immediate, zero-filled above the lane
fun imm_lane(op: *codegen_mir.MirOperand, i: u32, w: u8) i64 {
    val bits: u32       = w::u32 * 8;
    val full: wide.Wide = wide.make(op.imm:~u64, op.imm_hi:~u64);
    ret wide.trunc(wide.shr_u(full, i * bits), bits).lo:~i64;
}

fun operands_are_lane_ready(plan: *LanePlan, mi: *codegen_mir.MirInstr, start: u32) bool {
    var k: u32 = start;
    for (k < mi.operand_count) {
        val op:           *codegen_mir.MirOperand = ?mi.operands[k];
        val is_wide_vreg: bool                    = op.kind == codegen_mir.MIR_OP_VREG && op.vreg.n < plan.orig_count &&
            plan.lane_base[op.vreg.n] != LANE_NONE;
        if (!is_wide_vreg && op.kind != codegen_mir.MIR_OP_IMM) { ret false; }
        k = k + 1;
    }
    ret true;
}

fun expand_bitwise(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    if (mi.operand_count != 3 || !operands_are_lane_ready(plan, mi, 1)) {
        ret err[fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
    }
    val nl: u32 = wide_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;
    var i:  u32 = 0;
    for (i < nl) {
        var ops: [3]codegen_mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        ops[1] = lane_operand(plan, ?mi.operands[1], i);
        ops[2] = lane_operand(plan, ?mi.operands[2], i);
        val r: err[fail.Fail] = emit_piece(alloc, dst, cursor, mi, mi.opcode, ?ops[0], 3, lw);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_not(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    if (mi.operand_count != 2 || !operands_are_lane_ready(plan, mi, 1)) {
        ret err[fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
    }
    val nl: u32 = wide_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;
    var i:  u32 = 0;
    for (i < nl) {
        var ops: [2]codegen_mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        ops[1] = lane_operand(plan, ?mi.operands[1], i);
        val r: err[fail.Fail] = emit_piece(alloc, dst, cursor, mi, codegen_mir.MIR_NOT, ?ops[0], 2, lw);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_mov(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val nl: u32 = wide_lane_count(plan, mi);
    if (mi.operand_count != 2 || !operand_is_lane_ready(plan, ?mi.operands[0], nl) ||
        !operand_is_lane_ready(plan, ?mi.operands[1], nl)) {
        ret err[fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
    }
    val lw: u8 = plan.lane_width;
    # a declassify is the taint barrier; its lanes must stay one or the barrier is gone
    var piece_op: codegen_mir.MirOpcode = codegen_mir.MIR_MOV;
    if (mi.opcode == codegen_mir.MIR_DECLASSIFY) { piece_op = codegen_mir.MIR_DECLASSIFY; }
    var i: u32 = 0;
    for (i < nl) {
        var ops: [2]codegen_mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        ops[1] = lane_operand(plan, ?mi.operands[1], i);
        val r: err[fail.Fail] = emit_piece(alloc, dst, cursor, mi, piece_op, ?ops[0], 2, lw);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_addsub(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32, is_sub: bool) err[fail.Fail] {
    if (mi.operand_count != 3 || !operands_are_lane_ready(plan, mi, 1) ||
        mi.operands[0].kind != codegen_mir.MIR_OP_VREG || plan.lane_base[mi.operands[0].vreg.n] == LANE_NONE) {
        ret err[fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
    }
    val nl: u32 = wide_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;

    var d_ops: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var a_ops: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var b_ops: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var i:     u32 = 0;
    for (i < nl) {
        d_ops[i] = lane_operand(plan, ?mi.operands[0], i);
        a_ops[i] = lane_operand(plan, ?mi.operands[1], i);
        b_ops[i] = lane_operand(plan, ?mi.operands[2], i);
        i        = i + 1;
    }
    ret emit_addsub_chain(alloc, f, mi, dst, cursor, ?d_ops[0], ?a_ops[0], ?b_ops[0], nl, lw, is_sub);
}

fun emit_addsub_chain(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, src: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32,
    d_ops: *codegen_mir.MirOperand, a_ops: *codegen_mir.MirOperand, b_ops: *codegen_mir.MirOperand,
    nl: u32, lw: u8, is_sub: bool) err[fail.Fail] {
    val mi:  *codegen_mir.MirInstr = src;
    val cmp: codegen_mir.MirOpcode = codegen_mir.MIR_CMP_LT_U;
    var op0: codegen_mir.MirOpcode = codegen_mir.MIR_ADD;
    if (is_sub) { op0 = codegen_mir.MIR_SUB; }

    var carry: codegen_mir.VRegId = codegen_mir.MIR_VREG_NIL;
    var i:     u32                = 0;
    for (i < nl) {
        val d:      codegen_mir.MirOperand = d_ops[i];
        val a:      codegen_mir.MirOperand = a_ops[i];
        val b:      codegen_mir.MirOperand = b_ops[i];
        val is_low: bool                   = i == 0;
        val is_top: bool                   = i == nl - 1;

        if (is_low) {
            val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, op0, d, a, b, lw);
            if (sel r1.err) { ret r1; }
            val res_c: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel res_c.err) { ret err[fail.Fail].err{res_c.err}; }
            carry = res_c.ok;
            val cop: codegen_mir.MirOperand = codegen_mir.op_vreg(carry);
            var rc:  err[fail.Fail];
            if (is_sub)     { rc = emit_bin(alloc, dst, cursor, mi, cmp, cop, a, b, lw); }
            or              { rc = emit_bin(alloc, dst, cursor, mi, cmp, cop, d, a, lw); }
            if (sel rc.err) { ret rc; }
        }
        or (is_top) {
            val res_t: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel res_t.err) { ret err[fail.Fail].err{res_t.err}; }
            val t:  codegen_mir.MirOperand = codegen_mir.op_vreg(res_t.ok);
            val r1: err[fail.Fail]         = emit_bin(alloc, dst, cursor, mi, op0, t, a, b, lw);
            if (sel r1.err) { ret r1; }
            val r2: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, op0, d, t, codegen_mir.op_vreg(carry), lw);
            if (sel r2.err) { ret r2; }
        }
        or {
            val res_t: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel res_t.err) { ret err[fail.Fail].err{res_t.err}; }
            val t:   codegen_mir.MirOperand = codegen_mir.op_vreg(res_t.ok);
            val cin: codegen_mir.MirOperand = codegen_mir.op_vreg(carry);

            val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, op0, t, a, b, lw);
            if (sel r1.err) { ret r1; }

            val res_ct: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel res_ct.err) { ret err[fail.Fail].err{res_ct.err}; }
            val ct:  codegen_mir.MirOperand = codegen_mir.op_vreg(res_ct.ok);
            var rct: err[fail.Fail];
            if (is_sub)      { rct = emit_bin(alloc, dst, cursor, mi, cmp, ct, a, b, lw); }
            or               { rct = emit_bin(alloc, dst, cursor, mi, cmp, ct, t, a, lw); }
            if (sel rct.err) { ret rct; }

            val r3: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, op0, d, t, cin, lw);
            if (sel r3.err) { ret r3; }

            val res_cd: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel res_cd.err) { ret err[fail.Fail].err{res_cd.err}; }
            val cd:  codegen_mir.MirOperand = codegen_mir.op_vreg(res_cd.ok);
            var rcd: err[fail.Fail];
            if (is_sub)      { rcd = emit_bin(alloc, dst, cursor, mi, cmp, cd, t, cin, lw); }
            or               { rcd = emit_bin(alloc, dst, cursor, mi, cmp, cd, d, t, lw); }
            if (sel rcd.err) { ret rcd; }

            val res_co: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel res_co.err) { ret err[fail.Fail].err{res_co.err}; }
            val co: codegen_mir.VRegId = res_co.ok;
            val r5: err[fail.Fail]     = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_OR, codegen_mir.op_vreg(co), ct, cd, lw);
            if (sel r5.err) { ret r5; }
            carry = co;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun addsub_chain_piece_count(nl: u32) u32 {
    if (nl <= 1) { ret 2; }
    ret 4 + 5 * (nl - 2);
}

fun expand_neg(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    if (mi.operand_count != 2 || !operands_are_lane_ready(plan, mi, 1) ||
        mi.operands[0].kind != codegen_mir.MIR_OP_VREG || plan.lane_base[mi.operands[0].vreg.n] == LANE_NONE) {
        ret err[fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
    }
    var sub: codegen_mir.MirInstr = @mi;
    var ops: [3]codegen_mir.MirOperand;
    ops[0]            = mi.operands[0];
    ops[1]            = codegen_mir.op_imm(0);
    ops[2]            = mi.operands[1];
    sub.operands      = ?ops[0];
    sub.operand_count = 3;
    ret expand_addsub(alloc, plan, f, ?sub, dst, cursor, true);
}

val MAX_SHIFT_LANES: u32 = 8;

val SL_FILL: u32 = 0;
val SL_COPY: u32 = 1;
val SL_ONE:  u32 = 2;
val SL_SIGN: u32 = 3;
val SL_TWO:  u32 = 4;

fun shift_lane_kind(nl: u32, k: u32, r: u32, left: bool, arith: bool, i: u32,
    a_out: *i32, b_out: *i32) u32 {
    @a_out = -1;
    @b_out = -1;
    if (left) {
        if (i < k) { ret SL_FILL; }
        val a: i32 = i::i32 - k::i32;
        @a_out = a;
        if (r == 0) { ret SL_COPY; }
        if (a == 0) { ret SL_ONE; }
        @b_out = a - 1;
        ret SL_TWO;
    }
    val a: i32 = i::i32 + k::i32;
    if (a >= nl::i32) { ret SL_FILL; }
    @a_out = a;
    if (r == 0) { ret SL_COPY; }
    if (a + 1 >= nl::i32) {
        if (arith) { ret SL_SIGN; }
        ret SL_ONE;
    }
    @b_out = a + 1;
    ret SL_TWO;
}

fun shift_kind_pieces(kind: u32) u32 {
    if (kind == SL_TWO) { ret 3; }
    ret 1;
}

fun const_shift_pieces(nl: u32, k: u32, r: u32, left: bool, arith: bool) u32 {
    var total: u32 = 0;
    var i:     u32 = 0;
    for (i < nl) {
        var a: i32 = 0;
        var b: i32 = 0;
        total = total + shift_kind_pieces(shift_lane_kind(nl, k, r, left, arith, i, ?a, ?b));
        i     = i + 1;
    }
    ret total;
}

fun needs_sign_fill(arith: bool, k: u32) bool {
    ret arith && k > 0;
}

fun shift_stage_count(bits: u32) u32 {
    if (bits == 0) { ret 0; }
    var s: u32 = 0;
    var w: u32 = bits;
    for (w > 1) {
        if ((w & 1) != 0) { ret 0; }
        w = w >> 1;
        s = s + 1;
    }
    ret s;
}

fun shift_piece_count(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr) res[u32, fail.Fail] {
    val nl: u32 = wide_lane_count(plan, mi);
    if (mi.operand_count != 3 || nl > MAX_SHIFT_LANES) {
        ret res[u32, fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
    }
    if (mi.operands[0].kind != codegen_mir.MIR_OP_VREG ||
        !operand_is_lane_ready(plan, ?mi.operands[0], nl) ||
        !operand_is_lane_ready(plan, ?mi.operands[1], nl) ||
        !operand_is_lane_ready(plan, ?mi.operands[2], 1)) {
        ret res[u32, fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
    }

    val lb:     u32 = plan.lane_width::u32 * 8;
    val bits:   u32 = nl * lb;
    val stages: u32 = shift_stage_count(bits);
    if (stages == 0) {
        ret res[u32, fail.Fail].err{codegen_mir.reject_instr_at(plan.diags, diagnostic_kind.TARGET_UNSUPPORTED_OP, plan.f, mi, "a shift at a width that is not a power of two is unsupported on this target")};
    }

    val left:  bool = mi.opcode == codegen_mir.MIR_SHL;
    val arith: bool = mi.opcode == codegen_mir.MIR_SHR_S;

    if (mi.operands[2].kind == codegen_mir.MIR_OP_IMM) {
        val c:     u32 = (mi.operands[2].imm & (bits - 1)::i64)::u32;
        var total: u32 = const_shift_pieces(nl, c / lb, c % lb, left, arith);
        if (needs_sign_fill(arith, c / lb)) { total = total + 1; }
        ret res[u32, fail.Fail].ok{total};
    }

    var total: u32 = 0;
    if (arith && nl > 1) { total = 1; }
    var j: u32 = 0;
    for (j < stages) {
        if (j == 0) { total = total + 1; }
        or          { total = total + 2; }
        total = total + 1;
        val c: u32 = 1 << j;
        total = total + const_shift_pieces(nl, c / lb, c % lb, left, arith);
        total = total + 3 * nl;
        j     = j + 1;
    }
    ret res[u32, fail.Fail].ok{total};
}

fun emit_copy(alloc: *std_allocator.Allocator, dst: *codegen_mir.MirInstr, cursor: *u32, src: *codegen_mir.MirInstr,
    d: codegen_mir.MirOperand, a: codegen_mir.MirOperand, w: u8) err[fail.Fail] {
    var ops: [2]codegen_mir.MirOperand;
    ops[0] = d;
    ops[1] = a;
    ret emit_piece(alloc, dst, cursor, src, codegen_mir.MIR_MOV, ?ops[0], 2, w);
}

fun emit_const_shift(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, src: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32,
    in_ops: *codegen_mir.MirOperand, out_ops: *codegen_mir.MirOperand, nl: u32, lw: u8,
    k: u32, r: u32, left: bool, arith: bool,
    fill: codegen_mir.MirOperand) err[fail.Fail] {
    val lb:   u32 = lw::u32 * 8;
    var step: i32 = 1;
    var i:    i32 = 0;
    if (left) {
        i    = nl::i32 - 1;
        step = -1;
    }
    for (i >= 0 && i < nl::i32) {
        var a:    i32                    = 0;
        var b:    i32                    = 0;
        val kind: u32                    = shift_lane_kind(nl, k, r, left, arith, i::u32, ?a, ?b);
        val out:  codegen_mir.MirOperand = out_ops[i::u32];

        if (kind == SL_FILL) {
            val r1: err[fail.Fail] = emit_copy(alloc, dst, cursor, src, out, fill, lw);
            if (sel r1.err) { ret r1; }
        }
        or (kind == SL_COPY) {
            val r1: err[fail.Fail] = emit_copy(alloc, dst, cursor, src, out, in_ops[a::u32], lw);
            if (sel r1.err) { ret r1; }
        }
        or (kind == SL_ONE || kind == SL_SIGN) {
            var one: codegen_mir.MirOpcode = codegen_mir.MIR_SHR_U;
            if (left)            { one = codegen_mir.MIR_SHL; }
            or (kind == SL_SIGN) { one = codegen_mir.MIR_SHR_S; }
            val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, one, out,
                in_ops[a::u32], codegen_mir.op_imm(r::i64), lw);
            if (sel r1.err) { ret r1; }
        }
        or {
            var nb: codegen_mir.MirOperand = fill;
            if (b >= 0) { nb = in_ops[b::u32]; }

            val rt1: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel rt1.err) { ret err[fail.Fail].err{rt1.err}; }
            val t1:  codegen_mir.MirOperand             = codegen_mir.op_vreg(rt1.ok);
            val rt2: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel rt2.err) { ret err[fail.Fail].err{rt2.err}; }
            val t2: codegen_mir.MirOperand = codegen_mir.op_vreg(rt2.ok);

            var main_op:  codegen_mir.MirOpcode = codegen_mir.MIR_SHR_U;
            var cross_op: codegen_mir.MirOpcode = codegen_mir.MIR_SHL;
            if (left) {
                main_op  = codegen_mir.MIR_SHL;
                cross_op = codegen_mir.MIR_SHR_U;
            }

            val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, main_op, t1,
                in_ops[a::u32], codegen_mir.op_imm(r::i64), lw);
            if (sel r1.err) { ret r1; }
            val r2: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, cross_op, t2,
                nb, codegen_mir.op_imm((lb - r)::i64), lw);
            if (sel r2.err) { ret r2; }
            val r3: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_OR, out, t1, t2, lw);
            if (sel r3.err) { ret r3; }
        }
        i = i + step;
    }
    ret err[fail.Fail].ok{};
}

fun emit_sign_fill(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, src: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32, top: codegen_mir.MirOperand, lw: u8,
    out: *codegen_mir.MirOperand) err[fail.Fail] {
    val rv: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
    if (sel rv.err) { ret err[fail.Fail].err{rv.err}; }
    @out = codegen_mir.op_vreg(rv.ok);
    ret emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_SHR_S, @out, top,
        codegen_mir.op_imm((lw::u32 * 8 - 1)::i64), lw);
}

fun expand_shift(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val rc: res[u32, fail.Fail] = shift_piece_count(alloc, plan, mi);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }

    val nl:    u32  = wide_lane_count(plan, mi);
    val lw:    u8   = plan.lane_width;
    val lb:    u32  = lw::u32 * 8;
    val bits:  u32  = nl * lb;
    val left:  bool = mi.opcode == codegen_mir.MIR_SHL;
    val arith: bool = mi.opcode == codegen_mir.MIR_SHR_S;

    var src_ops: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var dst_ops: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var i:       u32 = 0;
    for (i < nl) {
        src_ops[i] = lane_operand(plan, ?mi.operands[1], i);
        dst_ops[i] = lane_operand(plan, ?mi.operands[0], i);
        i          = i + 1;
    }

    if (mi.operands[2].kind == codegen_mir.MIR_OP_IMM) {
        val c:    u32                    = (mi.operands[2].imm & (bits - 1)::i64)::u32;
        var fill: codegen_mir.MirOperand = codegen_mir.op_imm(0);
        if (needs_sign_fill(arith, c / lb)) {
            val rf: err[fail.Fail] = emit_sign_fill(alloc, f, mi, dst, cursor,
                src_ops[nl - 1], lw, ?fill);
            if (sel rf.err) { ret rf; }
        }
        ret emit_const_shift(alloc, f, mi, dst, cursor, ?src_ops[0], ?dst_ops[0], nl, lw,
            c / lb, c % lb, left, arith, fill);
    }

    ret emit_shift_barrel(alloc, plan, f, mi, dst, cursor, ?src_ops[0], ?dst_ops[0], nl, lw, left, arith);
}

fun emit_shift_barrel(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32,
    src_ops: *codegen_mir.MirOperand, dst_ops: *codegen_mir.MirOperand, nl: u32, lw: u8,
    left: bool, arith: bool) err[fail.Fail] {
    val lb:     u32                    = lw::u32 * 8;
    val stages: u32                    = shift_stage_count(nl * lb);
    val cnt:    codegen_mir.MirOperand = lane_operand(plan, ?mi.operands[2], 0);

    var fill: codegen_mir.MirOperand = codegen_mir.op_imm(0);
    if (arith && nl > 1) {
        val rf: err[fail.Fail] = emit_sign_fill(alloc, f, mi, dst, cursor,
            src_ops[nl - 1], lw, ?fill);
        if (sel rf.err) { ret rf; }
    }

    var cur: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var sh:  [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var nxt: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var i:   u32 = 0;
    for (i < nl) {
        cur[i] = src_ops[i];
        i      = i + 1;
    }

    var j: u32 = 0;
    for (j < stages) {
        var bit_src: codegen_mir.MirOperand = cnt;
        if (j > 0) {
            val rt: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel rt.err) { ret err[fail.Fail].err{rt.err}; }
            bit_src = codegen_mir.op_vreg(rt.ok);
            val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_SHR_U,
                bit_src, cnt, codegen_mir.op_imm(j::i64), lw);
            if (sel r1.err) { ret r1; }
        }
        val rb: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
        val bit: codegen_mir.MirOperand = codegen_mir.op_vreg(rb.ok);
        val r2:  err[fail.Fail]         = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_AND, bit,
            bit_src, codegen_mir.op_imm(1), lw);
        if (sel r2.err) { ret r2; }

        val rm: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rm.err) { ret err[fail.Fail].err{rm.err}; }
        val mask: codegen_mir.MirOperand = codegen_mir.op_vreg(rm.ok);
        val r3:   err[fail.Fail]         = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_SUB, mask,
            codegen_mir.op_imm(0), bit, lw);
        if (sel r3.err) { ret r3; }

        i = 0;
        for (i < nl) {
            val rs: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
            sh[i] = codegen_mir.op_vreg(rs.ok);
            i     = i + 1;
        }
        val c:  u32            = 1 << j;
        val r4: err[fail.Fail] = emit_const_shift(alloc, f, mi, dst, cursor, ?cur[0], ?sh[0],
            nl, lw, c / lb, c % lb, left, arith, fill);
        if (sel r4.err) { ret r4; }

        if (j == stages - 1) {
            i = 0;
            for (i < nl) {
                nxt[i] = dst_ops[i];
                i      = i + 1;
            }
        }
        or {
            i = 0;
            for (i < nl) {
                val rn: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
                if (sel rn.err) { ret err[fail.Fail].err{rn.err}; }
                nxt[i] = codegen_mir.op_vreg(rn.ok);
                i      = i + 1;
            }
        }

        i = 0;
        for (i < nl) {
            val rx: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel rx.err) { ret err[fail.Fail].err{rx.err}; }
            val x:  codegen_mir.MirOperand = codegen_mir.op_vreg(rx.ok);
            val r5: err[fail.Fail]         = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_XOR, x, cur[i], sh[i], lw);
            if (sel r5.err) { ret r5; }

            val ry: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel ry.err) { ret err[fail.Fail].err{ry.err}; }
            val y:  codegen_mir.MirOperand = codegen_mir.op_vreg(ry.ok);
            val r6: err[fail.Fail]         = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_AND, y, x, mask, lw);
            if (sel r6.err) { ret r6; }

            val r7: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_XOR, nxt[i], cur[i], y, lw);
            if (sel r7.err) { ret r7; }
            i = i + 1;
        }

        i = 0;
        for (i < nl) {
            cur[i] = nxt[i];
            i      = i + 1;
        }
        j = j + 1;
    }
    ret err[fail.Fail].ok{};
}

fun double_and_add_pieces(nl: u32, stages: u32) u32 {
    val per_stage: u32 = 2 + addsub_chain_piece_count(nl) + 3 * nl;
    val shl1:      u32 = const_shift_pieces(nl, 0, 1, true, false);
    val shr1:      u32 = const_shift_pieces(nl, 0, 1, false, false);
    ret stages * per_stage + (stages - 1) * (shl1 + shr1);
}

fun lane_is_seed_zero(op: codegen_mir.MirOperand) bool {
    ret op.kind == codegen_mir.MIR_OP_IMM && op.imm == 0 && op.imm_hi == 0;
}

fun accum_into(live: *bool, nl: u32, p: u32) u32 {
    if (!live[p]) {
        live[p] = true;
        ret 0;
    }
    var k: u32 = p;
    for (k < nl) {
        live[k] = true;
        k       = k + 1;
    }
    ret accum_lane_pieces(nl, p);
}

fun accum_lane_pieces(nl: u32, p: u32) u32 {
    ret 2 * (nl - p) - 1;
}

fun emit_accumulate_lane(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, src: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32, acc: *codegen_mir.MirOperand,
    nl: u32, lw: u8, p: u32, v: codegen_mir.MirOperand) err[fail.Fail] {
    if (lane_is_seed_zero(acc[p])) {
        acc[p] = v;
        ret err[fail.Fail].ok{};
    }

    val rt: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
    if (sel rt.err) { ret err[fail.Fail].err{rt.err}; }
    val t:  codegen_mir.MirOperand = codegen_mir.op_vreg(rt.ok);
    val r1: err[fail.Fail]         = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_ADD, t, acc[p], v, lw);
    if (sel r1.err) { ret r1; }

    if (p == nl - 1) {
        acc[p] = t;
        ret err[fail.Fail].ok{};
    }

    val rc: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    var carry: codegen_mir.MirOperand = codegen_mir.op_vreg(rc.ok);
    val r2:    err[fail.Fail]         = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_CMP_LT_U, carry, t, v, lw);
    if (sel r2.err) { ret r2; }
    acc[p] = t;

    var k: u32 = p + 1;
    for (k < nl) {
        val rn: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rn.err) { ret err[fail.Fail].err{rn.err}; }
        val n:  codegen_mir.MirOperand = codegen_mir.op_vreg(rn.ok);
        val r3: err[fail.Fail]         = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_ADD, n, acc[k], carry, lw);
        if (sel r3.err) { ret r3; }
        acc[k] = n;
        if (k == nl - 1) { ret err[fail.Fail].ok{}; }

        val rc2: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rc2.err) { ret err[fail.Fail].err{rc2.err}; }
        val c2: codegen_mir.MirOperand = codegen_mir.op_vreg(rc2.ok);
        val r4: err[fail.Fail]         = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_CMP_LT_U, c2, n, carry, lw);
        if (sel r4.err) { ret r4; }
        carry = c2;
        k     = k + 1;
    }
    ret err[fail.Fail].ok{};
}

# the pieces of one lane-width product realized through the declared form.
# a low-only product is the target's own multiply; the full product is two
# three-address multiplies, the fixed-pair sequence (stage the accumulator, the
# pair multiply, read back each wanted half, plus one move when the multiplier
# is an immediate the pair instruction cannot take), or double-and-add
fun wide_product_pieces(plan: *LanePlan, a: *codegen_mir.MirOperand, b: *codegen_mir.MirOperand,
    want_lo: bool, want_hi: bool, signed: bool) u32 {
    val lane_bits: u32 = plan.lane_width::u32 * 8;
    if (!want_hi) {
        if (plan.mach.has_mul) { ret 1; }
        ret double_and_add_pieces(1, lane_bits);
    }
    if (plan.mach.mul_form == isa.MULW_THREE_ADDRESS) {
        if (want_lo) { ret 2; }
        ret 1;
    }
    if (plan.mach.mul_form == isa.MULW_FIXED_PAIR) {
        var n: u32 = 3;
        if (want_lo)                                                              { n = n + 1; }
        if (a.kind == codegen_mir.MIR_OP_IMM && b.kind == codegen_mir.MIR_OP_IMM) { n = n + 1; }
        ret n;
    }
    var n: u32 = double_and_add_pieces(2, lane_bits);
    if (signed) { n = n + SIGNED_HIGH_FIX_PIECES; }
    ret n;
}

# the unsigned high half becomes the signed one by subtracting each operand
# that is negative from it: hi -= (a >> (w-1)) & b; hi -= (b >> (w-1)) & a
val SIGNED_HIGH_FIX_PIECES: u32 = 6;

fun emit_signed_high_fix(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, src: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32, a: codegen_mir.MirOperand, b: codegen_mir.MirOperand, hi: codegen_mir.MirOperand, lw: u8) err[fail.Fail] {
    var k: u32 = 0;
    for (k < 2) {
        var x: codegen_mir.MirOperand = a;
        var y: codegen_mir.MirOperand = b;
        if (k == 1) {
            x = b;
            y = a;
        }
        var fill: codegen_mir.MirOperand;
        val rf:   err[fail.Fail] = emit_sign_fill(alloc, f, src, dst, cursor, x, lw, ?fill);
        if (sel rf.err) { ret rf; }
        val rm: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rm.err) { ret err[fail.Fail].err{rm.err}; }
        val masked: codegen_mir.MirOperand = codegen_mir.op_vreg(rm.ok);
        val ra:     err[fail.Fail]         = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_AND, masked, fill, y, lw);
        if (sel ra.err) { ret ra; }
        val rs: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_SUB, hi, hi, masked, lw);
        if (sel rs.err) { ret rs; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

# the full product of two lane-width operands: lo and hi receive the halves
# that are wanted, through the target's declared realization. a low-only
# product is the target's own multiply whatever the form
fun emit_wide_product(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, src: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32,
    a: codegen_mir.MirOperand, b: codegen_mir.MirOperand,
    lo: codegen_mir.MirOperand, hi: codegen_mir.MirOperand, want_lo: bool, want_hi: bool, signed: bool) err[fail.Fail] {
    val lw: u8 = plan.lane_width;
    if (!want_hi && plan.mach.has_mul) { ret emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_MUL, lo, a, b, lw); }

    if (plan.mach.mul_form == isa.MULW_THREE_ADDRESS) {
        if (want_lo) {
            val r1: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_MUL, lo, a, b, lw);
            if (sel r1.err) { ret r1; }
        }
        var op: codegen_mir.MirOpcode = codegen_mir.MIR_MUL_HI_U;
        if (signed) { op = codegen_mir.MIR_MUL_HI_S; }
        ret emit_bin(alloc, dst, cursor, src, op, hi, a, b, lw);
    }

    if (plan.mach.mul_form == isa.MULW_FIXED_PAIR) {
        val acc:    codegen_mir.MirOperand = codegen_mir.op_preg(codegen_mir.preg_id(plan.mach.pair_lo));
        val hi_reg: codegen_mir.MirOperand = codegen_mir.op_preg(codegen_mir.preg_id(plan.mach.pair_hi));
        # the pair multiply takes a register: an immediate multiplier rides the
        # accumulator, and two immediates stage the second in a temporary
        var x: codegen_mir.MirOperand = a;
        var y: codegen_mir.MirOperand = b;
        if (y.kind == codegen_mir.MIR_OP_IMM && x.kind != codegen_mir.MIR_OP_IMM) {
            x = b;
            y = a;
        }
        if (y.kind == codegen_mir.MIR_OP_IMM) {
            val rt: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel rt.err) { ret err[fail.Fail].err{rt.err}; }
            val staged: codegen_mir.MirOperand = codegen_mir.op_vreg(rt.ok);
            val rs:     err[fail.Fail]         = emit_copy(alloc, dst, cursor, src, staged, y, lw);
            if (sel rs.err) { ret rs; }
            y = staged;
        }
        val r0: err[fail.Fail] = emit_copy(alloc, dst, cursor, src, acc, x, lw);
        if (sel r0.err) { ret r0; }
        var op: codegen_mir.MirOpcode = codegen_mir.MIR_MUL_PAIR_U;
        if (signed) { op = codegen_mir.MIR_MUL_PAIR_S; }
        var ops: [2]codegen_mir.MirOperand;
        ops[0] = acc;
        ops[1] = y;
        val r1: err[fail.Fail] = emit_piece(alloc, dst, cursor, src, op, ?ops[0], 2, lw);
        if (sel r1.err) { ret r1; }
        if (want_lo) {
            val r2: err[fail.Fail] = emit_copy(alloc, dst, cursor, src, lo, acc, lw);
            if (sel r2.err) { ret r2; }
        }
        ret emit_copy(alloc, dst, cursor, src, hi, hi_reg, lw);
    }

    var mc:  [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var mp:  [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var out: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    mc[0]  = a;
    mp[0]  = b;
    out[0] = lo;
    var n: u32 = 1;
    if (want_hi) {
        mc[1]  = codegen_mir.op_imm(0);
        mp[1]  = codegen_mir.op_imm(0);
        out[1] = hi;
        n      = 2;
    }
    val rd: err[fail.Fail] = emit_double_and_add(alloc, plan, f, src, dst, cursor, ?mc[0], ?mp[0], ?out[0], n, lw::u32 * 8);
    if (sel rd.err)          { ret rd; }
    if (!want_hi || !signed) { ret err[fail.Fail].ok{}; }
    ret emit_signed_high_fix(alloc, f, src, dst, cursor, a, b, hi, lw);
}

fun lane_product_pieces(plan: *LanePlan, a: *codegen_mir.MirOperand, b: *codegen_mir.MirOperand, want_hi: bool) u32 {
    ret wide_product_pieces(plan, a, b, true, want_hi, false);
}

fun emit_lane_product(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, src: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32,
    a: codegen_mir.MirOperand, b: codegen_mir.MirOperand,
    lo: codegen_mir.MirOperand, hi: codegen_mir.MirOperand, want_hi: bool) err[fail.Fail] {
    ret emit_wide_product(alloc, plan, f, src, dst, cursor, a, b, lo, hi, true, want_hi, false);
}

# a target that names a fixed pair must name both registers; a target with a
# three-address high multiply must declare it at the lane width
fun mul_form_refusal(plan: *LanePlan) opt[str] {
    if (plan.mach.mul_form == isa.MULW_FIXED_PAIR && (plan.mach.pair_lo < 0 || plan.mach.pair_hi < 0)) {
        ret opt[str].some{"this target declares a fixed-pair widening multiply without naming the pair (internal compiler error: MachineModel.div_reg and div_hi_reg, see briar-systems/mach#3511)"};
    }
    if (plan.mach.mul_form == isa.MULW_THREE_ADDRESS && plan.mach.mul_hi != plan.lane_width) {
        ret opt[str].some{"this target declares a three-address widening multiply at a width other than its ALU width, which this pass does not model (see briar-systems/mach#2778)"};
    }
    if (plan.mach.mul_form != isa.MULW_NONE && !plan.mach.has_mul) {
        ret opt[str].some{"this target declares the high half of a multiply but no multiply (see briar-systems/mach#2778)"};
    }
    ret opt[str].none{};
}

fun mul_form_fail(plan: *LanePlan, mi: *codegen_mir.MirInstr, why: str) fail.Fail {
    ret codegen_mir.reject_instr_at(plan.diags, diagnostic_kind.TARGET_UNSUPPORTED_OP, plan.f, mi, why);
}

# the wide value whose lanes are the full product of its two lane-width
# operands (MIR_MUL_WIDE_*, width twice the lane); its operands are plain
# lane-width values
fun mul_wide_piece_count(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr) res[u32, fail.Fail] {
    if (mi.operand_count != 3 || mi.operands[0].kind != codegen_mir.MIR_OP_VREG ||
        dst_lane_count(plan, mi) != 2 || mi.src_width != plan.lane_width ||
        !operand_is_lane_ready(plan, ?mi.operands[0], 2) ||
        !operand_is_lane_ready(plan, ?mi.operands[1], 1) || !operand_is_lane_ready(plan, ?mi.operands[2], 1)) {
        ret res[u32, fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
    }
    val bad: opt[str] = mul_form_refusal(plan);
    if (sel bad.some) { ret res[u32, fail.Fail].err{mul_form_fail(plan, mi, bad.some)}; }
    ret res[u32, fail.Fail].ok{wide_product_pieces(plan, ?mi.operands[1], ?mi.operands[2], true, true,
        mi.opcode == codegen_mir.MIR_MUL_WIDE_S)};
}

fun expand_mul_wide(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val rc: res[u32, fail.Fail] = mul_wide_piece_count(alloc, plan, mi);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    val lo: codegen_mir.MirOperand = lane_operand(plan, ?mi.operands[0], 0);
    val hi: codegen_mir.MirOperand = lane_operand(plan, ?mi.operands[0], 1);
    ret emit_wide_product(alloc, plan, f, mi, dst, cursor, mi.operands[1], mi.operands[2], lo, hi, true, true,
        mi.opcode == codegen_mir.MIR_MUL_WIDE_S);
}

# the high half alone on a target that declares no high multiply
fun mul_hi_piece_count(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr) res[u32, fail.Fail] {
    if (mi.operand_count != 3 || mi.width != plan.lane_width || mi.operands[0].kind != codegen_mir.MIR_OP_VREG ||
        !operand_is_lane_ready(plan, ?mi.operands[1], 1) || !operand_is_lane_ready(plan, ?mi.operands[2], 1)) {
        ret res[u32, fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
    }
    val bad: opt[str] = mul_form_refusal(plan);
    if (sel bad.some) { ret res[u32, fail.Fail].err{mul_form_fail(plan, mi, bad.some)}; }
    ret res[u32, fail.Fail].ok{wide_product_pieces(plan, ?mi.operands[1], ?mi.operands[2], false, true,
        mi.opcode == codegen_mir.MIR_MUL_HI_S)};
}

fun expand_mul_hi(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val rc: res[u32, fail.Fail] = mul_hi_piece_count(alloc, plan, mi);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    # the double-and-add form writes a low half nothing reads
    val rt: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
    if (sel rt.err) { ret err[fail.Fail].err{rt.err}; }
    ret emit_wide_product(alloc, plan, f, mi, dst, cursor, mi.operands[1], mi.operands[2],
        codegen_mir.op_vreg(rt.ok), mi.operands[0], false, true, mi.opcode == codegen_mir.MIR_MUL_HI_S);
}

fun mul_schoolbook_pieces(plan: *LanePlan, mi: *codegen_mir.MirInstr, nl: u32) u32 {
    var live:  [MAX_SHIFT_LANES]bool;
    var total: u32 = 0;
    var i:     u32 = 0;
    for (i < nl) {
        live[i] = false;
        i       = i + 1;
    }
    i = 0;
    for (i < nl) {
        var j: u32 = 0;
        for (i + j < nl) {
            val p:       u32                    = i + j;
            val want_hi: bool                   = p + 1 < nl;
            val a:       codegen_mir.MirOperand = lane_operand(plan, ?mi.operands[1], i);
            val b:       codegen_mir.MirOperand = lane_operand(plan, ?mi.operands[2], j);
            total = total + lane_product_pieces(plan, ?a, ?b, want_hi);
            total = total + accum_into(?live[0], nl, p);
            if (want_hi) { total = total + accum_into(?live[0], nl, p + 1); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret total + nl;
}

fun mul_piece_count(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr) res[u32, fail.Fail] {
    val nl: u32 = wide_lane_count(plan, mi);
    if (mi.operand_count != 3 || nl > MAX_SHIFT_LANES ||
        mi.operands[0].kind != codegen_mir.MIR_OP_VREG || !operand_is_lane_ready(plan, ?mi.operands[0], nl) ||
        !operand_is_lane_ready(plan, ?mi.operands[1], nl) || !operand_is_lane_ready(plan, ?mi.operands[2], nl)) {
        ret res[u32, fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
    }
    val bad: opt[str] = mul_form_refusal(plan);
    if (sel bad.some) { ret res[u32, fail.Fail].err{mul_form_fail(plan, mi, bad.some)}; }
    if (nl > 1)       { ret res[u32, fail.Fail].ok{mul_schoolbook_pieces(plan, mi, nl)}; }
    ret res[u32, fail.Fail].ok{double_and_add_pieces(nl, nl * plan.lane_width::u32 * 8)};
}

fun expand_mul(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val rc: res[u32, fail.Fail] = mul_piece_count(alloc, plan, mi);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }

    val nl: u32 = wide_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;

    var dst_ops: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var a_ops:   [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var b_ops:   [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var i:       u32 = 0;
    for (i < nl) {
        dst_ops[i] = lane_operand(plan, ?mi.operands[0], i);
        a_ops[i]   = lane_operand(plan, ?mi.operands[1], i);
        b_ops[i]   = lane_operand(plan, ?mi.operands[2], i);
        i          = i + 1;
    }

    if (nl == 1) {
        ret emit_double_and_add(alloc, plan, f, mi, dst, cursor, ?a_ops[0], ?b_ops[0], ?dst_ops[0],
            nl, lw::u32 * 8);
    }

    var acc: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    i = 0;
    for (i < nl) {
        acc[i] = codegen_mir.op_imm(0);
        i      = i + 1;
    }

    i = 0;
    for (i < nl) {
        var j: u32 = 0;
        for (i + j < nl) {
            val p:       u32  = i + j;
            val want_hi: bool = p + 1 < nl;

            val rl: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
            val lo: codegen_mir.MirOperand = codegen_mir.op_vreg(rl.ok);

            var hi: codegen_mir.MirOperand = codegen_mir.op_imm(0);
            if (want_hi) {
                val rh: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
                if (sel rh.err) { ret err[fail.Fail].err{rh.err}; }
                hi = codegen_mir.op_vreg(rh.ok);
            }

            val rp: err[fail.Fail] = emit_lane_product(alloc, plan, f, mi, dst, cursor,
                a_ops[i], b_ops[j], lo, hi, want_hi);
            if (sel rp.err) { ret rp; }

            val ra: err[fail.Fail] = emit_accumulate_lane(alloc, f, mi, dst, cursor, ?acc[0], nl, lw, p, lo);
            if (sel ra.err) { ret ra; }
            if (want_hi) {
                val rb: err[fail.Fail] = emit_accumulate_lane(alloc, f, mi, dst, cursor, ?acc[0], nl, lw, p + 1, hi);
                if (sel rb.err) { ret rb; }
            }
            j = j + 1;
        }
        i = i + 1;
    }

    i = 0;
    for (i < nl) {
        var ops: [2]codegen_mir.MirOperand;
        ops[0] = dst_ops[i];
        ops[1] = acc[i];
        val rm: err[fail.Fail] = emit_piece(alloc, dst, cursor, mi, codegen_mir.MIR_MOV, ?ops[0], 2, lw);
        if (sel rm.err) { ret rm; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun emit_double_and_add(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, src: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32,
    a_in: *codegen_mir.MirOperand, b_in: *codegen_mir.MirOperand, out: *codegen_mir.MirOperand,
    nl: u32, stages: u32) err[fail.Fail] {
    val mi: *codegen_mir.MirInstr = src;
    val lw: u8                    = plan.lane_width;

    var mcand:  [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var mplier: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var result: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var i:      u32 = 0;
    for (i < nl) {
        mcand[i]  = a_in[i];
        mplier[i] = b_in[i];
        result[i] = codegen_mir.op_imm(0);
        i         = i + 1;
    }

    var j: u32 = 0;
    for (j < stages) {
        val rb: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
        val bit: codegen_mir.MirOperand = codegen_mir.op_vreg(rb.ok);
        val r1:  err[fail.Fail]         = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_AND, bit, mplier[0], codegen_mir.op_imm(1), lw);
        if (sel r1.err) { ret r1; }

        val rm: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rm.err) { ret err[fail.Fail].err{rm.err}; }
        val mask: codegen_mir.MirOperand = codegen_mir.op_vreg(rm.ok);
        val r2:   err[fail.Fail]         = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_SUB, mask, codegen_mir.op_imm(0), bit, lw);
        if (sel r2.err) { ret r2; }

        var cand: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
        i = 0;
        for (i < nl) {
            val rc2: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel rc2.err) { ret err[fail.Fail].err{rc2.err}; }
            cand[i] = codegen_mir.op_vreg(rc2.ok);
            i       = i + 1;
        }
        val r3: err[fail.Fail] = emit_addsub_chain(alloc, f, mi, dst, cursor, ?cand[0], ?result[0], ?mcand[0], nl, lw, false);
        if (sel r3.err) { ret r3; }

        val is_last: bool = j == stages - 1;
        var nxt:     [MAX_SHIFT_LANES]codegen_mir.MirOperand;
        i = 0;
        for (i < nl) {
            if (is_last) { nxt[i] = out[i]; }
            or {
                val rn: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
                if (sel rn.err) { ret err[fail.Fail].err{rn.err}; }
                nxt[i] = codegen_mir.op_vreg(rn.ok);
            }
            i = i + 1;
        }
        i = 0;
        for (i < nl) {
            val rx: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel rx.err) { ret err[fail.Fail].err{rx.err}; }
            val x:  codegen_mir.MirOperand = codegen_mir.op_vreg(rx.ok);
            val r4: err[fail.Fail]         = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_XOR, x, result[i], cand[i], lw);
            if (sel r4.err) { ret r4; }

            val ry: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel ry.err) { ret err[fail.Fail].err{ry.err}; }
            val y:  codegen_mir.MirOperand = codegen_mir.op_vreg(ry.ok);
            val r5: err[fail.Fail]         = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_AND, y, x, mask, lw);
            if (sel r5.err) { ret r5; }

            val r6: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_XOR, nxt[i], result[i], y, lw);
            if (sel r6.err) { ret r6; }
            i = i + 1;
        }
        i = 0;
        for (i < nl) {
            result[i] = nxt[i];
            i         = i + 1;
        }

        if (!is_last) {
            var nmc: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
            i = 0;
            for (i < nl) {
                val rmc: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
                if (sel rmc.err) { ret err[fail.Fail].err{rmc.err}; }
                nmc[i] = codegen_mir.op_vreg(rmc.ok);
                i      = i + 1;
            }
            val r7: err[fail.Fail] = emit_const_shift(alloc, f, mi, dst, cursor, ?mcand[0], ?nmc[0], nl, lw, 0, 1, true, false, codegen_mir.op_imm(0));
            if (sel r7.err) { ret r7; }
            i = 0;
            for (i < nl) {
                mcand[i] = nmc[i];
                i        = i + 1;
            }

            var nmp: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
            i = 0;
            for (i < nl) {
                val rmp: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
                if (sel rmp.err) { ret err[fail.Fail].err{rmp.err}; }
                nmp[i] = codegen_mir.op_vreg(rmp.ok);
                i      = i + 1;
            }
            val r8: err[fail.Fail] = emit_const_shift(alloc, f, mi, dst, cursor, ?mplier[0], ?nmp[0], nl, lw, 0, 1, false, false, codegen_mir.op_imm(0));
            if (sel r8.err) { ret r8; }
            i = 0;
            for (i < nl) {
                mplier[i] = nmp[i];
                i         = i + 1;
            }
        }
        j = j + 1;
    }
    ret err[fail.Fail].ok{};
}

fun div_is_signed(op: codegen_mir.MirOpcode) bool {
    ret codegen_mir.has(op, codegen_mir.MIRF_DIV_SIGNED);
}

fun div_wants_remainder(op: codegen_mir.MirOpcode) bool {
    ret codegen_mir.has(op, codegen_mir.MIRF_REMAINDER);
}

fun divmod_stage_pieces(nl: u32) u32 {
    val shl1: u32 = const_shift_pieces(nl, 0, 1, true, false);
    ret 2 + shl1 + 1 + shl1
        + wide_rel_pieces(nl, false, false) + 1 + 1 + 1 + nl
        + addsub_chain_piece_count(nl);
}

fun divmod_signed_pieces(nl: u32, rem: bool) u32 {
    val absv:  u32 = nl + addsub_chain_piece_count(nl);
    var total: u32 = 2 + 2 * absv;
    if (!rem) { total = total + 1; }
    ret total + absv;
}

fun divmod_zero_fixup_pieces(nl: u32, signed: bool) u32 {
    var total: u32 = (nl - 1) + 1 + nl;
    if (signed) { total = total + 2 + 4 * nl + 1; }
    ret total;
}

fun divmod_piece_count(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr) res[u32, fail.Fail] {
    val nl: u32 = wide_lane_count(plan, mi);
    if (mi.operand_count != 3 || nl > MAX_SHIFT_LANES ||
        mi.operands[0].kind != codegen_mir.MIR_OP_VREG || !operand_is_lane_ready(plan, ?mi.operands[0], nl) ||
        !operand_is_lane_ready(plan, ?mi.operands[1], nl) || !operand_is_lane_ready(plan, ?mi.operands[2], nl)) {
        ret res[u32, fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
    }
    val bits:  u32 = nl * plan.lane_width::u32 * 8;
    var total: u32 = bits * divmod_stage_pieces(nl) + divmod_zero_fixup_pieces(nl, div_is_signed(mi.opcode));
    if (div_is_signed(mi.opcode)) {
        total = total + divmod_signed_pieces(nl, div_wants_remainder(mi.opcode));
    }
    ret res[u32, fail.Fail].ok{total};
}

fun new_lane_temps(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, out: *codegen_mir.MirOperand, n: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < n) {
        val r: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        out[i] = codegen_mir.op_vreg(r.ok);
        i      = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun emit_wide_abs(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, src: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32,
    v_ops: *codegen_mir.MirOperand, out: *codegen_mir.MirOperand, sign: *codegen_mir.MirOperand,
    nl: u32, lw: u8) err[fail.Fail] {
    val lb: u32                                = lw::u32 * 8;
    val rs: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    val s:  codegen_mir.MirOperand = codegen_mir.op_vreg(rs.ok);
    val r1: err[fail.Fail]         = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_SHR_S, s,
        v_ops[nl - 1], codegen_mir.op_imm((lb - 1)::i64), lw);
    if (sel r1.err) { ret r1; }
    @sign = s;

    var xr: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var sb: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var i:  u32 = 0;
    for (i < nl) {
        val rt: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rt.err) { ret err[fail.Fail].err{rt.err}; }
        xr[i] = codegen_mir.op_vreg(rt.ok);
        val rx: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_XOR, xr[i], v_ops[i], s, lw);
        if (sel rx.err) { ret rx; }
        sb[i] = s;
        i     = i + 1;
    }
    ret emit_addsub_chain(alloc, f, src, dst, cursor, out, ?xr[0], ?sb[0], nl, lw, true);
}

fun emit_apply_sign(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, src: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32,
    v_ops: *codegen_mir.MirOperand, out: *codegen_mir.MirOperand, s: codegen_mir.MirOperand,
    nl: u32, lw: u8) err[fail.Fail] {
    var xr: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var sb: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var i:  u32 = 0;
    for (i < nl) {
        val rt: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rt.err) { ret err[fail.Fail].err{rt.err}; }
        xr[i] = codegen_mir.op_vreg(rt.ok);
        val rx: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_XOR, xr[i], v_ops[i], s, lw);
        if (sel rx.err) { ret rx; }
        sb[i] = s;
        i     = i + 1;
    }
    ret emit_addsub_chain(alloc, f, src, dst, cursor, out, ?xr[0], ?sb[0], nl, lw, true);
}

fun expand_divmod(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val rc: res[u32, fail.Fail] = divmod_piece_count(alloc, plan, mi);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }

    val nl:       u32  = wide_lane_count(plan, mi);
    val lw:       u8   = plan.lane_width;
    val lb:       u32  = lw::u32 * 8;
    val bits:     u32  = nl * lb;
    val signed:   bool = div_is_signed(mi.opcode);
    val want_rem: bool = div_wants_remainder(mi.opcode);

    var num: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var den: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var rem: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var od:  [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var on:  [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var i:   u32 = 0;
    for (i < nl) {
        num[i] = lane_operand(plan, ?mi.operands[1], i);
        den[i] = lane_operand(plan, ?mi.operands[2], i);
        on[i]  = num[i];
        od[i]  = den[i];
        rem[i] = codegen_mir.op_imm(0);
        i      = i + 1;
    }

    var sa: codegen_mir.MirOperand = codegen_mir.op_imm(0);
    var sb: codegen_mir.MirOperand = codegen_mir.op_imm(0);
    if (signed) {
        var an: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
        val ra: err[fail.Fail] = new_lane_temps(alloc, f, ?an[0], nl);
        if (sel ra.err) { ret ra; }
        val r1: err[fail.Fail] = emit_wide_abs(alloc, f, mi, dst, cursor, ?num[0], ?an[0], ?sa, nl, lw);
        if (sel r1.err) { ret r1; }

        var bn:  [MAX_SHIFT_LANES]codegen_mir.MirOperand;
        val rb2: err[fail.Fail] = new_lane_temps(alloc, f, ?bn[0], nl);
        if (sel rb2.err) { ret rb2; }
        val r2: err[fail.Fail] = emit_wide_abs(alloc, f, mi, dst, cursor, ?den[0], ?bn[0], ?sb, nl, lw);
        if (sel r2.err) { ret r2; }

        i = 0;
        for (i < nl) {
            num[i] = an[i];
            den[i] = bn[i];
            i      = i + 1;
        }
    }

    var j: u32 = 0;
    for (j < bits) {
        val rh: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rh.err) { ret err[fail.Fail].err{rh.err}; }
        val hs: codegen_mir.MirOperand = codegen_mir.op_vreg(rh.ok);
        val e1: err[fail.Fail]         = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_SHR_U, hs,
            num[nl - 1], codegen_mir.op_imm((lb - 1)::i64), lw);
        if (sel e1.err) { ret e1; }
        val rh2: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rh2.err) { ret err[fail.Fail].err{rh2.err}; }
        val hb: codegen_mir.MirOperand = codegen_mir.op_vreg(rh2.ok);
        val e2: err[fail.Fail]         = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_AND, hb, hs, codegen_mir.op_imm(1), lw);
        if (sel e2.err) { ret e2; }

        var rsh: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
        val rt1: err[fail.Fail] = new_lane_temps(alloc, f, ?rsh[0], nl);
        if (sel rt1.err) { ret rt1; }
        val e3: err[fail.Fail] = emit_const_shift(alloc, f, mi, dst, cursor, ?rem[0], ?rsh[0],
            nl, lw, 0, 1, true, false, codegen_mir.op_imm(0));
        if (sel e3.err) { ret e3; }
        val rl0: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rl0.err) { ret err[fail.Fail].err{rl0.err}; }
        val rlo: codegen_mir.MirOperand = codegen_mir.op_vreg(rl0.ok);
        val e4:  err[fail.Fail]         = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_OR, rlo, rsh[0], hb, lw);
        if (sel e4.err) { ret e4; }
        rsh[0] = rlo;

        var nsh: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
        val rt2: err[fail.Fail] = new_lane_temps(alloc, f, ?nsh[0], nl);
        if (sel rt2.err) { ret rt2; }
        val e5: err[fail.Fail] = emit_const_shift(alloc, f, mi, dst, cursor, ?num[0], ?nsh[0],
            nl, lw, 0, 1, true, false, codegen_mir.op_imm(0));
        if (sel e5.err) { ret e5; }

        val rlt: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rlt.err) { ret err[fail.Fail].err{rlt.err}; }
        val lt: codegen_mir.MirOperand = codegen_mir.op_vreg(rlt.ok);
        val e6: err[fail.Fail]         = emit_wide_rel(alloc, f, mi, dst, cursor, lt, ?rsh[0], ?den[0],
            nl, lw, false, false);
        if (sel e6.err) { ret e6; }
        val rge: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rge.err) { ret err[fail.Fail].err{rge.err}; }
        val ge: codegen_mir.MirOperand = codegen_mir.op_vreg(rge.ok);
        val e7: err[fail.Fail]         = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_XOR, ge, lt, codegen_mir.op_imm(1), lw);
        if (sel e7.err) { ret e7; }

        val rq: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rq.err) { ret err[fail.Fail].err{rq.err}; }
        val qlo: codegen_mir.MirOperand = codegen_mir.op_vreg(rq.ok);
        val e8:  err[fail.Fail]         = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_OR, qlo, nsh[0], ge, lw);
        if (sel e8.err) { ret e8; }
        nsh[0] = qlo;

        val rm: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rm.err) { ret err[fail.Fail].err{rm.err}; }
        val mask: codegen_mir.MirOperand = codegen_mir.op_vreg(rm.ok);
        val e9:   err[fail.Fail]         = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_SUB, mask, codegen_mir.op_imm(0), ge, lw);
        if (sel e9.err) { ret e9; }

        var md: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
        i = 0;
        for (i < nl) {
            val rd: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
            md[i] = codegen_mir.op_vreg(rd.ok);
            val rx: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_AND, md[i], den[i], mask, lw);
            if (sel rx.err) { ret rx; }
            i = i + 1;
        }

        var nrem: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
        val rt3:  err[fail.Fail] = new_lane_temps(alloc, f, ?nrem[0], nl);
        if (sel rt3.err) { ret rt3; }
        val e10: err[fail.Fail] = emit_addsub_chain(alloc, f, mi, dst, cursor, ?nrem[0], ?rsh[0], ?md[0], nl, lw, true);
        if (sel e10.err) { ret e10; }

        i = 0;
        for (i < nl) {
            rem[i] = nrem[i];
            num[i] = nsh[i];
            i      = i + 1;
        }
        j = j + 1;
    }

    var lanes: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    i = 0;
    for (i < nl) {
        lanes[i] = num[i];
        if (want_rem) { lanes[i] = rem[i]; }
        i = i + 1;
    }

    var d_ops: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    i = 0;
    for (i < nl) {
        d_ops[i] = lane_operand(plan, ?mi.operands[0], i);
        i        = i + 1;
    }

    if (signed) {
        var s: codegen_mir.MirOperand = sa;
        if (!want_rem) {
            val rq2: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel rq2.err) { ret err[fail.Fail].err{rq2.err}; }
            s = codegen_mir.op_vreg(rq2.ok);
            val rs2: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_XOR, s, sa, sb, lw);
            if (sel rs2.err) { ret rs2; }
        }
        var sres: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
        val rst:  err[fail.Fail] = new_lane_temps(alloc, f, ?sres[0], nl);
        if (sel rst.err) { ret rst; }
        val rap: err[fail.Fail] = emit_apply_sign(alloc, f, mi, dst, cursor, ?lanes[0], ?sres[0], s, nl, lw);
        if (sel rap.err) { ret rap; }
        i = 0;
        for (i < nl) {
            lanes[i] = sres[i];
            i        = i + 1;
        }
    }

    ret emit_divmod_zero_fixup(alloc, f, mi, dst, cursor, ?lanes[0], ?od[0], ?on[0], ?d_ops[0],
        nl, lw, want_rem);
}

fun lane_mask(lw: u8) i64 {
    if (lw >= 8) { ret -1; }
    ret (1::i64 << (lw::u64 * 8)) - 1;
}

fun emit_divmod_zero_fixup(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, src: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32,
    result: *codegen_mir.MirOperand, den: *codegen_mir.MirOperand, num: *codegen_mir.MirOperand,
    d_ops: *codegen_mir.MirOperand, nl: u32, lw: u8, rem: bool) err[fail.Fail] {
    var acc: codegen_mir.MirOperand = den[0];
    var i:   u32                    = 1;
    for (i < nl) {
        val ra: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
        val nx: codegen_mir.MirOperand = codegen_mir.op_vreg(ra.ok);
        val r1: err[fail.Fail]         = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_OR, nx, acc, den[i], lw);
        if (sel r1.err) { ret r1; }
        acc = nx;
        i   = i + 1;
    }

    var divisor: codegen_mir.MirOperand = acc;
    if (codegen_mir.has(src.opcode, codegen_mir.MIRF_DIV_SIGNED)) {
        val rz: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rz.err) { ret err[fail.Fail].err{rz.err}; }
        val z:  codegen_mir.MirOperand = codegen_mir.op_vreg(rz.ok);
        val r2: err[fail.Fail]         = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_CMP_EQ, z, acc, codegen_mir.op_imm(0), lw);
        if (sel r2.err) { ret r2; }
        val rn: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rn.err) { ret err[fail.Fail].err{rn.err}; }
        val nonzero: codegen_mir.MirOperand = codegen_mir.op_vreg(rn.ok);
        val r3:      err[fail.Fail]         = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_SUB, nonzero, codegen_mir.op_imm(1), z, lw);
        if (sel r3.err) { ret r3; }

        val lane_bits: u32                    = lw::u32 * 8;
        val lane_min:  i64                    = (1::i64 << (lane_bits - 1)::u64) & lane_mask(lw);
        var ov:        codegen_mir.MirOperand = codegen_mir.op_imm(1);
        i = 0;
        for (i < nl) {
            val rd1: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel rd1.err) { ret err[fail.Fail].err{rd1.err}; }
            val dm: codegen_mir.MirOperand = codegen_mir.op_vreg(rd1.ok);
            val e1: err[fail.Fail]         = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_CMP_EQ, dm, den[i], codegen_mir.op_imm(lane_mask(lw)), lw);
            if (sel e1.err) { ret e1; }
            var want: i64 = 0;
            if (i == nl - 1) { want = lane_min; }
            val rn1: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel rn1.err) { ret err[fail.Fail].err{rn1.err}; }
            val nm: codegen_mir.MirOperand = codegen_mir.op_vreg(rn1.ok);
            val e2: err[fail.Fail]         = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_CMP_EQ, nm, num[i], codegen_mir.op_imm(want), lw);
            if (sel e2.err) { ret e2; }
            val ra1: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel ra1.err) { ret err[fail.Fail].err{ra1.err}; }
            val both: codegen_mir.MirOperand = codegen_mir.op_vreg(ra1.ok);
            val e3:   err[fail.Fail]         = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_AND, both, dm, nm, lw);
            if (sel e3.err) { ret e3; }
            val ra2: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel ra2.err) { ret err[fail.Fail].err{ra2.err}; }
            val next: codegen_mir.MirOperand = codegen_mir.op_vreg(ra2.ok);
            val e4:   err[fail.Fail]         = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_AND, next, ov, both, lw);
            if (sel e4.err) { ret e4; }
            ov = next;
            i  = i + 1;
        }
        val rd2: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rd2.err) { ret err[fail.Fail].err{rd2.err}; }
        divisor = codegen_mir.op_vreg(rd2.ok);
        val r4: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_SUB, divisor, nonzero, ov, lw);
        if (sel r4.err) { ret r4; }
    }

    val rp: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
    if (sel rp.err) { ret err[fail.Fail].err{rp.err}; }
    val probe: codegen_mir.MirOperand = codegen_mir.op_vreg(rp.ok);
    val r5:    err[fail.Fail]         = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_DIV_U, probe, codegen_mir.op_imm(1), divisor, lw);
    if (sel r5.err) { ret r5; }

    i = 0;
    for (i < nl) {
        val e5: err[fail.Fail] = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_OR, d_ops[i], result[i], codegen_mir.op_imm(0), lw);
        if (sel e5.err) { ret e5; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun cmp_is_equality(op: codegen_mir.MirOpcode) bool {
    ret codegen_mir.has(op, codegen_mir.MIRF_CMP_EQUALITY);
}

fun cmp_is_signed(op: codegen_mir.MirOpcode) bool {
    ret codegen_mir.has(op, codegen_mir.MIRF_CMP_SIGNED);
}

fun cmp_is_le(op: codegen_mir.MirOpcode) bool {
    ret codegen_mir.has(op, codegen_mir.MIRF_CMP_LE);
}

fun cmp_dest_is_native(plan: *LanePlan, d: *codegen_mir.MirOperand) bool {
    if (d.kind != codegen_mir.MIR_OP_VREG) { ret false; }
    ret d.vreg.n >= plan.orig_count || plan.lane_base[d.vreg.n] == LANE_NONE;
}

fun cmp_rel_pieces(signed: bool, le: bool) u32 {
    var n: u32 = 1;
    if (signed) { n = 3; }
    if (le)     { n = n + 1; }
    ret n;
}

fun emit_lane_rel(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, src: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32,
    d: codegen_mir.MirOperand, a: codegen_mir.MirOperand, b: codegen_mir.MirOperand, lw: u8,
    signed: bool, le: bool) err[fail.Fail] {
    var x: codegen_mir.MirOperand = a;
    var y: codegen_mir.MirOperand = b;
    if (le) {
        x = b;
        y = a;
    }

    if (signed) {
        val bias: codegen_mir.MirOperand             = codegen_mir.op_imm(1::i64 << (lw::i64 * 8 - 1));
        val rx:   res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rx.err) { ret err[fail.Fail].err{rx.err}; }
        val bx: codegen_mir.MirOperand = codegen_mir.op_vreg(rx.ok);
        val r1: err[fail.Fail]         = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_XOR, bx, x, bias, lw);
        if (sel r1.err) { ret r1; }

        val ry: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel ry.err) { ret err[fail.Fail].err{ry.err}; }
        val by: codegen_mir.MirOperand = codegen_mir.op_vreg(ry.ok);
        val r2: err[fail.Fail]         = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_XOR, by, y, bias, lw);
        if (sel r2.err) { ret r2; }

        x = bx;
        y = by;
    }

    if (!le) { ret emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_CMP_LT_U, d, x, y, lw); }

    val rt: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
    if (sel rt.err) { ret err[fail.Fail].err{rt.err}; }
    val t:  codegen_mir.MirOperand = codegen_mir.op_vreg(rt.ok);
    val r3: err[fail.Fail]         = emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_CMP_LT_U, t, x, y, lw);
    if (sel r3.err) { ret r3; }
    ret emit_bin(alloc, dst, cursor, src, codegen_mir.MIR_XOR, d, t, codegen_mir.op_imm(1), lw);
}

fun cmp_piece_count(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr) res[u32, fail.Fail] {
    val nl: u32 = wide_lane_count(plan, mi);
    if (mi.operand_count != 3 || nl > MAX_SHIFT_LANES ||
        !cmp_dest_is_native(plan, ?mi.operands[0]) ||
        !operand_is_lane_ready(plan, ?mi.operands[1], nl) ||
        !operand_is_lane_ready(plan, ?mi.operands[2], nl)) {
        ret res[u32, fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
    }

    val op: codegen_mir.MirOpcode = mi.opcode;
    if (cmp_is_equality(op)) { ret res[u32, fail.Fail].ok{2 * nl - 1}; }

    ret res[u32, fail.Fail].ok{wide_rel_pieces(nl, cmp_is_signed(op), cmp_is_le(op))};
}

fun wide_rel_pieces(nl: u32, signed: bool, le: bool) u32 {
    var total: u32 = cmp_rel_pieces(signed && nl == 1, le);
    var i:     u32 = 1;
    for (i < nl) {
        total = total + cmp_rel_pieces(signed && i == nl - 1, false) + 3;
        i     = i + 1;
    }
    ret total;
}

fun expand_cmp(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val rc: res[u32, fail.Fail] = cmp_piece_count(alloc, plan, mi);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }

    if (cmp_is_equality(mi.opcode)) { ret expand_cmp_equality(alloc, plan, f, mi, dst, cursor); }
    ret expand_cmp_ordered(alloc, plan, f, mi, dst, cursor);
}

fun expand_cmp_equality(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val nl: u32                    = wide_lane_count(plan, mi);
    val lw: u8                     = plan.lane_width;
    val d:  codegen_mir.MirOperand = mi.operands[0];

    var lane_op: codegen_mir.MirOpcode = codegen_mir.MIR_CMP_EQ;
    var join:    codegen_mir.MirOpcode = codegen_mir.MIR_AND;
    if (mi.opcode == codegen_mir.MIR_CMP_NE) {
        lane_op = codegen_mir.MIR_CMP_NE;
        join    = codegen_mir.MIR_OR;
    }

    var acc: codegen_mir.MirOperand;
    var i:   u32 = 0;
    for (i < nl) {
        var out: codegen_mir.MirOperand = d;
        if (nl > 1) {
            val rt: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel rt.err) { ret err[fail.Fail].err{rt.err}; }
            out = codegen_mir.op_vreg(rt.ok);
        }
        val rl: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, lane_op, out,
            lane_operand(plan, ?mi.operands[1], i),
            lane_operand(plan, ?mi.operands[2], i), lw);
        if (sel rl.err) { ret rl; }

        if (i == 0) { acc = out; }
        or {
            var jd: codegen_mir.MirOperand = d;
            if (i < nl - 1) {
                val rj: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
                if (sel rj.err) { ret err[fail.Fail].err{rj.err}; }
                jd = codegen_mir.op_vreg(rj.ok);
            }
            val rr: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, join, jd, acc, out, lw);
            if (sel rr.err) { ret rr; }
            acc = jd;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_cmp_ordered(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    val nl:    u32 = wide_lane_count(plan, mi);
    var a_ops: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var b_ops: [MAX_SHIFT_LANES]codegen_mir.MirOperand;
    var i:     u32 = 0;
    for (i < nl) {
        a_ops[i] = lane_operand(plan, ?mi.operands[1], i);
        b_ops[i] = lane_operand(plan, ?mi.operands[2], i);
        i        = i + 1;
    }
    ret emit_wide_rel(alloc, f, mi, dst, cursor, mi.operands[0], ?a_ops[0], ?b_ops[0],
        nl, plan.lane_width, cmp_is_signed(mi.opcode), cmp_is_le(mi.opcode));
}

fun emit_wide_rel(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, src: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32, d: codegen_mir.MirOperand,
    a_ops: *codegen_mir.MirOperand, b_ops: *codegen_mir.MirOperand,
    nl: u32, lw: u8, signed: bool, le: bool) err[fail.Fail] {
    val mi: *codegen_mir.MirInstr = src;

    var result: codegen_mir.MirOperand = d;
    if (nl > 1) {
        val r0: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel r0.err) { ret err[fail.Fail].err{r0.err}; }
        result = codegen_mir.op_vreg(r0.ok);
    }
    val rb: err[fail.Fail] = emit_lane_rel(alloc, f, mi, dst, cursor, result,
        a_ops[0], b_ops[0], lw,
        signed && nl == 1, le);
    if (sel rb.err) { ret rb; }

    var i: u32 = 1;
    for (i < nl) {
        val a: codegen_mir.MirOperand = a_ops[i];
        val b: codegen_mir.MirOperand = b_ops[i];

        val rl: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
        val lt: codegen_mir.MirOperand = codegen_mir.op_vreg(rl.ok);
        val r1: err[fail.Fail]         = emit_lane_rel(alloc, f, mi, dst, cursor, lt, a, b, lw,
            signed && i == nl - 1, false);
        if (sel r1.err) { ret r1; }

        val re: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel re.err) { ret err[fail.Fail].err{re.err}; }
        val eq: codegen_mir.MirOperand = codegen_mir.op_vreg(re.ok);
        val r2: err[fail.Fail]         = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_CMP_EQ, eq, a, b, lw);
        if (sel r2.err) { ret r2; }

        val rg: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
        if (sel rg.err) { ret err[fail.Fail].err{rg.err}; }
        val g:  codegen_mir.MirOperand = codegen_mir.op_vreg(rg.ok);
        val r3: err[fail.Fail]         = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_AND, g, eq, result, lw);
        if (sel r3.err) { ret r3; }

        var out: codegen_mir.MirOperand = d;
        if (i < nl - 1) {
            val ro: res[codegen_mir.VRegId, fail.Fail] = new_vreg(alloc, f, codegen_mir.REG_CLASS_GP);
            if (sel ro.err) { ret err[fail.Fail].err{ro.err}; }
            out = codegen_mir.op_vreg(ro.ok);
        }
        val r4: err[fail.Fail] = emit_bin(alloc, dst, cursor, mi, codegen_mir.MIR_OR, out, lt, g, lw);
        if (sel r4.err) { ret r4; }
        result = out;
        i      = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun dst_lane_count(plan: *LanePlan, mi: *codegen_mir.MirInstr) u32 {
    var n: u32 = (mi.width / plan.lane_width)::u32;
    if (n == 0) { n = 1; }
    ret n;
}

fun src_lane_count(plan: *LanePlan, mi: *codegen_mir.MirInstr) u32 {
    var n: u32 = (mi.src_width / plan.lane_width)::u32;
    if (n == 0) { n = 1; }
    ret n;
}

# a source narrower than a lane arrives with whatever its producer left above
# its width (sub-word arithmetic does not mask), so the lane that receives it
# is the same lane-wide convert the shared lowering emits for a scalar widen,
# not a move; the lanes above it are the fill. the source is narrower than a
# lane exactly when it has one lane and a width under the lane's
fun emit_low_lanes(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32, sl: u32) err[fail.Fail] {
    val lw: u8  = plan.lane_width;
    var i:  u32 = 0;
    for (i < sl) {
        var ops: [2]codegen_mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        ops[1] = lane_operand(plan, ?mi.operands[1], i);
        var r: err[fail.Fail] = err[fail.Fail].ok{};
        if (mi.src_width < lw) { r = emit_piece_from(alloc, dst, cursor, mi, mi.opcode, ?ops[0], 2, lw, mi.src_width); }
        or                     { r = emit_piece(alloc, dst, cursor, mi, codegen_mir.MIR_MOV, ?ops[0], 2, lw); }
        if (sel r.err)         { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun emit_high_lanes(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32, sl: u32, dl: u32, fill: codegen_mir.MirOperand) err[fail.Fail] {
    val lw: u8  = plan.lane_width;
    var i:  u32 = sl;
    for (i < dl) {
        var ops: [2]codegen_mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        ops[1] = fill;
        val r: err[fail.Fail] = emit_piece(alloc, dst, cursor, mi, codegen_mir.MIR_MOV, ?ops[0], 2, lw);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_zext(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    if (mi.operand_count != 2 ||
        mi.operands[0].kind != codegen_mir.MIR_OP_VREG || plan.lane_base[mi.operands[0].vreg.n] == LANE_NONE) {
        ret err[fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
    }
    val dl: u32            = dst_lane_count(plan, mi);
    val sl: u32            = src_lane_count(plan, mi);
    val rl: err[fail.Fail] = emit_low_lanes(alloc, plan, mi, dst, cursor, sl);
    if (sel rl.err) { ret rl; }
    ret emit_high_lanes(alloc, plan, mi, dst, cursor, sl, dl, codegen_mir.op_imm(0));
}

# the sign fill is taken from the destination's top source lane once it holds
# the lane-wide value, so a sub-word source's sign bit is the one the convert
# placed, not a bit its producer left in the register
fun expand_sext(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    if (mi.operand_count != 2 ||
        mi.operands[0].kind != codegen_mir.MIR_OP_VREG || plan.lane_base[mi.operands[0].vreg.n] == LANE_NONE) {
        ret err[fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
    }
    val dl: u32 = dst_lane_count(plan, mi);
    val sl: u32 = src_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;

    if (sext_folds_immediate(mi)) { ret emit_sext_immediate(alloc, plan, mi, dst, cursor, dl); }

    val rl: err[fail.Fail] = emit_low_lanes(alloc, plan, mi, dst, cursor, sl);
    if (sel rl.err) { ret rl; }

    var fill: codegen_mir.MirOperand = codegen_mir.op_imm(0);
    if (dl > sl) {
        val top: codegen_mir.MirOperand = lane_operand(plan, ?mi.operands[0], sl - 1);
        val rf:  err[fail.Fail]         = emit_sign_fill(alloc, f, mi, dst, cursor, top, lw, ?fill);
        if (sel rf.err) { ret rf; }
    }
    ret emit_high_lanes(alloc, plan, mi, dst, cursor, sl, dl, fill);
}

# an immediate source of at most 64 bits is widened by folding
fun sext_folds_immediate(mi: *codegen_mir.MirInstr) bool {
    ret mi.operand_count == 2 && mi.operands[1].kind == codegen_mir.MIR_OP_IMM && mi.src_width <= 8;
}

# a signed widen of an immediate is known whole at legalization: the value is
# the immediate read at its source width, and every destination lane is a move
# of that value's lane, the high ones its sign, so no runtime fill is emitted
fun emit_sext_immediate(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32, dl: u32) err[fail.Fail] {
    val lw:       u8  = plan.lane_width;
    val src_bits: u32 = mi.src_width::u32 * 8;
    var v:        i64 = mi.operands[1].imm;
    if (src_bits < 64) {
        val drop: u32 = 64 - src_bits;
        v = ((v:~u64 << drop::u64):~i64) >> drop::i64;
    }
    var whole: codegen_mir.MirOperand = codegen_mir.op_imm(v);
    var i:     u32                    = 0;
    for (i < dl) {
        var ops: [2]codegen_mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        ops[1] = codegen_mir.op_imm(imm_lane(?whole, i, lw));
        val r: err[fail.Fail] = emit_piece(alloc, dst, cursor, mi, codegen_mir.MIR_MOV, ?ops[0], 2, lw);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_trunc(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    if (mi.operand_count != 2) {
        ret err[fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
    }
    val dl: u32 = dst_lane_count(plan, mi);
    val lw: u8  = plan.lane_width;
    var i:  u32 = 0;
    for (i < dl) {
        var ops: [2]codegen_mir.MirOperand;
        ops[0] = lane_operand(plan, ?mi.operands[0], i);
        ops[1] = lane_operand(plan, ?mi.operands[1], i);
        val r: err[fail.Fail] = emit_piece(alloc, dst, cursor, mi, codegen_mir.MIR_MOV, ?ops[0], 2, lw);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

rec ConvEmit {
    alloc:  *std_allocator.Allocator;
    f:      *codegen_mir.MirFunction;
    src:    *codegen_mir.MirInstr;
    dst:    *codegen_mir.MirInstr;
    cursor: *u32;
    fp_cls: u32;
    fail:   bool;
}

val CONV_FCC_LT: u8 = 2;

fun cv_emit(cv: *ConvEmit, opcode: codegen_mir.MirOpcode, ops: *codegen_mir.MirOperand, nops: u32,
    w: u8, sw: u8) {
    val ci: u32 = @cv.cursor;
    @cv.cursor = ci + 1;
    if (cv.dst == nil || cv.fail) { ret; }
    var arr: *codegen_mir.MirOperand = nil;
    if (nops > 0) {
        val res_a: res[*codegen_mir.MirOperand, std_allocator.Error] = std_allocator.allocate[codegen_mir.MirOperand](cv.alloc, nops::usize);
        if (sel res_a.err) {
            cv.fail = true;
            ret;
        }
        arr = res_a.ok;
        var j: u32 = 0;
        for (j < nops) {
            arr[j] = ops[j];
            j      = j + 1;
        }
    }
    cv.dst[ci] = codegen_mir.instr(opcode, arr, nops, w, sw);
    val p: *codegen_mir.MirInstr = ?cv.dst[ci];
    p.loc         = cv.src.loc;
    p.inline_site = cv.src.inline_site;
}

fun cv3(cv: *ConvEmit, opcode: codegen_mir.MirOpcode, d: codegen_mir.MirOperand, a: codegen_mir.MirOperand,
    b: codegen_mir.MirOperand, w: u8, sw: u8) {
    var ops: [3]codegen_mir.MirOperand;
    ops[0] = d;
    ops[1] = a;
    ops[2] = b;
    cv_emit(cv, opcode, ?ops[0], 3, w, sw);
}

fun cv2(cv: *ConvEmit, opcode: codegen_mir.MirOpcode, d: codegen_mir.MirOperand, a: codegen_mir.MirOperand,
    w: u8, sw: u8) {
    var ops: [2]codegen_mir.MirOperand;
    ops[0] = d;
    ops[1] = a;
    cv_emit(cv, opcode, ?ops[0], 2, w, sw);
}

fun cv_tmp(cv: *ConvEmit, cls: u32) codegen_mir.MirOperand {
    if (cv.dst == nil || cv.fail) { ret codegen_mir.op_vreg(codegen_mir.MIR_VREG_NIL); }
    val r: res[codegen_mir.VRegId, fail.Fail] = new_vreg(cv.alloc, cv.f, cls);
    if (sel r.err) {
        cv.fail = true;
        ret codegen_mir.op_vreg(codegen_mir.MIR_VREG_NIL);
    }
    ret codegen_mir.op_vreg(r.ok);
}

fun cv_gp(cv: *ConvEmit) codegen_mir.MirOperand {
    ret cv_tmp(cv, codegen_mir.REG_CLASS_GP);
}

fun cv_fp(cv: *ConvEmit) codegen_mir.MirOperand {
    ret cv_tmp(cv, cv.fp_cls);
}

fun cv_const(cv: *ConvEmit, v: i64) codegen_mir.MirOperand {
    val d: codegen_mir.MirOperand = cv_gp(cv);
    cv2(cv, codegen_mir.MIR_MOV, d, codegen_mir.op_imm(v), 4, 4);
    ret d;
}

fun cv_two32(cv: *ConvEmit) codegen_mir.MirOperand {
    val k:  codegen_mir.MirOperand = cv_const(cv, 65536);
    val fk: codegen_mir.MirOperand = cv_fp(cv);
    cv2(cv, codegen_mir.MIR_UI_TO_FP, fk, k, 8, 4);
    val s: codegen_mir.MirOperand = cv_fp(cv);
    cv3(cv, codegen_mir.MIR_FMUL, s, fk, fk, 8, 8);
    ret s;
}

fun cv_pair_to_f64(cv: *ConvEmit, d: codegen_mir.MirOperand, two32: codegen_mir.MirOperand,
    hi: codegen_mir.MirOperand, lo: codegen_mir.MirOperand, signed_hi: bool) {
    var hop: codegen_mir.MirOpcode = codegen_mir.MIR_UI_TO_FP;
    if (signed_hi) { hop = codegen_mir.MIR_SI_TO_FP; }
    val fhi: codegen_mir.MirOperand = cv_fp(cv);
    cv2(cv, hop, fhi, hi, 8, 4);
    val flo: codegen_mir.MirOperand = cv_fp(cv);
    cv2(cv, codegen_mir.MIR_UI_TO_FP, flo, lo, 8, 4);
    val t: codegen_mir.MirOperand = cv_fp(cv);
    cv3(cv, codegen_mir.MIR_FMUL, t, fhi, two32, 8, 8);
    cv3(cv, codegen_mir.MIR_FADD, d, t, flo, 8, 8);
}

fun cv_read_lanes(cv: *ConvEmit, plan: *LanePlan, op: *codegen_mir.MirOperand,
    lo: *codegen_mir.MirOperand, hi: *codegen_mir.MirOperand) {
    @lo = cv_gp(cv);
    cv2(cv, codegen_mir.MIR_MOV, @lo, lane_operand(plan, op, 0), 4, 4);
    @hi = cv_gp(cv);
    cv2(cv, codegen_mir.MIR_MOV, @hi, lane_operand(plan, op, 1), 4, 4);
}

fun cv_int_to_fp(cv: *ConvEmit, plan: *LanePlan, mi: *codegen_mir.MirInstr) {
    val signed: bool                   = mi.opcode == codegen_mir.MIR_SI_TO_FP;
    val dw:     u8                     = mi.width;
    val dst:    codegen_mir.MirOperand = mi.operands[0];

    var lo: codegen_mir.MirOperand;
    var hi: codegen_mir.MirOperand;
    cv_read_lanes(cv, plan, ?mi.operands[1], ?lo, ?hi);

    if (dw == 8) {
        val two32: codegen_mir.MirOperand = cv_two32(cv);
        cv_pair_to_f64(cv, dst, two32, hi, lo, signed);
        ret;
    }

    val zero: codegen_mir.MirOperand = cv_const(cv, 0);
    var sm:   codegen_mir.MirOperand = zero;
    var alo:  codegen_mir.MirOperand = lo;
    var ahi:  codegen_mir.MirOperand = hi;
    if (signed) {
        sm = cv_gp(cv);
        cv3(cv, codegen_mir.MIR_SHR_S, sm, hi, codegen_mir.op_imm(31), 4, 4);
        val tl: codegen_mir.MirOperand = cv_gp(cv);
        cv3(cv, codegen_mir.MIR_XOR, tl, lo, sm, 4, 4);
        val th: codegen_mir.MirOperand = cv_gp(cv);
        cv3(cv, codegen_mir.MIR_XOR, th, hi, sm, 4, 4);
        val one_if_neg: codegen_mir.MirOperand = cv_gp(cv);
        cv3(cv, codegen_mir.MIR_SUB, one_if_neg, zero, sm, 4, 4);
        alo = cv_gp(cv);
        cv3(cv, codegen_mir.MIR_ADD, alo, tl, one_if_neg, 4, 4);
        val cy: codegen_mir.MirOperand = cv_gp(cv);
        cv3(cv, codegen_mir.MIR_CMP_LT_U, cy, alo, one_if_neg, 4, 4);
        ahi = cv_gp(cv);
        cv3(cv, codegen_mir.MIR_ADD, ahi, th, cy, 4, 4);
    }

    val m11: codegen_mir.MirOperand = cv_const(cv, 2047);
    val q:   codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_AND, q, alo, m11, 4, 4);
    val sticky: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_CMP_NE, sticky, q, zero, 4, 4);
    val r1: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_SHR_U, r1, alo, codegen_mir.op_imm(11), 4, 4);
    val r2: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_SHL, r2, ahi, codegen_mir.op_imm(21), 4, 4);
    val r3: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_OR, r3, r1, r2, 4, 4);
    val rlo: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_OR, rlo, r3, sticky, 4, 4);
    val rhi: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_SHR_U, rhi, ahi, codegen_mir.op_imm(11), 4, 4);

    val h21: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_SHR_U, h21, ahi, codegen_mir.op_imm(21), 4, 4);
    val big: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_CMP_NE, big, h21, zero, 4, 4);
    val bm: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_SUB, bm, zero, big, 4, 4);
    val nbm: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_XOR, nbm, bm, codegen_mir.op_imm(-1), 4, 4);

    val slo:   codegen_mir.MirOperand = cv_gp(cv);
    val slo_a: codegen_mir.MirOperand = cv_gp(cv);
    val slo_b: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_AND, slo_a, rlo, bm, 4, 4);
    cv3(cv, codegen_mir.MIR_AND, slo_b, alo, nbm, 4, 4);
    cv3(cv, codegen_mir.MIR_OR, slo, slo_a, slo_b, 4, 4);
    val shi:   codegen_mir.MirOperand = cv_gp(cv);
    val shi_a: codegen_mir.MirOperand = cv_gp(cv);
    val shi_b: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_AND, shi_a, rhi, bm, 4, 4);
    cv3(cv, codegen_mir.MIR_AND, shi_b, ahi, nbm, 4, 4);
    cv3(cv, codegen_mir.MIR_OR, shi, shi_a, shi_b, 4, 4);

    val sk: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_AND, sk, bm, m11, 4, 4);
    var sc: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_ADD, sc, sk, codegen_mir.op_imm(1), 4, 4);
    if (signed) {
        val sx: codegen_mir.MirOperand = cv_gp(cv);
        cv3(cv, codegen_mir.MIR_XOR, sx, sc, sm, 4, 4);
        val sn: codegen_mir.MirOperand = cv_gp(cv);
        cv3(cv, codegen_mir.MIR_SUB, sn, sx, sm, 4, 4);
        sc = sn;
    }
    val fsc: codegen_mir.MirOperand = cv_fp(cv);
    cv2(cv, codegen_mir.MIR_SI_TO_FP, fsc, sc, 8, 4);

    val two32: codegen_mir.MirOperand = cv_two32(cv);
    val d:     codegen_mir.MirOperand = cv_fp(cv);
    cv_pair_to_f64(cv, d, two32, shi, slo, false);
    val p: codegen_mir.MirOperand = cv_fp(cv);
    cv3(cv, codegen_mir.MIR_FMUL, p, d, fsc, 8, 8);
    cv2(cv, codegen_mir.MIR_FP_TRUNC, dst, p, 4, 8);
}

fun cv_f64_to_pair(cv: *ConvEmit, two32: codegen_mir.MirOperand, inv32: codegen_mir.MirOperand,
    x: codegen_mir.MirOperand, hi: codegen_mir.MirOperand, lo: codegen_mir.MirOperand) {
    val u: codegen_mir.MirOperand = cv_fp(cv);
    cv3(cv, codegen_mir.MIR_FMUL, u, x, inv32, 8, 8);
    cv2(cv, codegen_mir.MIR_FP_TO_UI, hi, u, 4, 8);
    val fh: codegen_mir.MirOperand = cv_fp(cv);
    cv2(cv, codegen_mir.MIR_UI_TO_FP, fh, hi, 8, 4);
    val frac: codegen_mir.MirOperand = cv_fp(cv);
    cv3(cv, codegen_mir.MIR_FSUB, frac, u, fh, 8, 8);
    val rem: codegen_mir.MirOperand = cv_fp(cv);
    cv3(cv, codegen_mir.MIR_FMUL, rem, frac, two32, 8, 8);
    cv2(cv, codegen_mir.MIR_FP_TO_UI, lo, rem, 4, 8);
}

fun cv_fp_to_int(cv: *ConvEmit, plan: *LanePlan, mi: *codegen_mir.MirInstr) {
    val signed: bool                   = mi.opcode == codegen_mir.MIR_FP_TO_SI;
    val dlo:    codegen_mir.MirOperand = lane_operand(plan, ?mi.operands[0], 0);
    val dhi:    codegen_mir.MirOperand = lane_operand(plan, ?mi.operands[0], 1);

    var x: codegen_mir.MirOperand = mi.operands[1];
    if (x.kind != codegen_mir.MIR_OP_VREG) {
        val xr: codegen_mir.MirOperand = cv_fp(cv);
        cv2(cv, codegen_mir.MIR_MOV, xr, x, mi.src_width, mi.src_width);
        x = xr;
    }
    if (mi.src_width == 4) {
        val xe: codegen_mir.MirOperand = cv_fp(cv);
        cv2(cv, codegen_mir.MIR_FP_EXT, xe, x, 8, 4);
        x = xe;
    }

    val two32: codegen_mir.MirOperand = cv_two32(cv);
    val one:   codegen_mir.MirOperand = cv_const(cv, 1);
    val fone:  codegen_mir.MirOperand = cv_fp(cv);
    cv2(cv, codegen_mir.MIR_UI_TO_FP, fone, one, 8, 4);
    val inv32: codegen_mir.MirOperand = cv_fp(cv);
    cv3(cv, codegen_mir.MIR_FDIV, inv32, fone, two32, 8, 8);

    if (!signed) {
        cv_f64_to_pair(cv, two32, inv32, x, dhi, dlo);
        ret;
    }

    val zero:  codegen_mir.MirOperand = cv_const(cv, 0);
    val fzero: codegen_mir.MirOperand = cv_fp(cv);
    cv2(cv, codegen_mir.MIR_UI_TO_FP, fzero, zero, 8, 4);
    val neg: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_FCMP, neg, x, fzero, 8, CONV_FCC_LT);
    val dbl: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_SHL, dbl, neg, codegen_mir.op_imm(1), 4, 4);
    val sgn: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_SUB, sgn, one, dbl, 4, 4);
    val fsgn: codegen_mir.MirOperand = cv_fp(cv);
    cv2(cv, codegen_mir.MIR_SI_TO_FP, fsgn, sgn, 8, 4);
    val ax: codegen_mir.MirOperand = cv_fp(cv);
    cv3(cv, codegen_mir.MIR_FMUL, ax, x, fsgn, 8, 8);

    val uh: codegen_mir.MirOperand = cv_gp(cv);
    val ul: codegen_mir.MirOperand = cv_gp(cv);
    cv_f64_to_pair(cv, two32, inv32, ax, uh, ul);

    val nm: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_SUB, nm, zero, neg, 4, 4);
    val lim: codegen_mir.MirOperand = cv_const(cv, 0x7FFFFFFF);
    val mhi: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_ADD, mhi, lim, neg, 4, 4);
    val mlo: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_XOR, mlo, nm, codegen_mir.op_imm(-1), 4, 4);

    val g1: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_CMP_LT_U, g1, mhi, uh, 4, 4);
    val eqh: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_CMP_EQ, eqh, uh, mhi, 4, 4);
    val g2: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_CMP_LT_U, g2, mlo, ul, 4, 4);
    val ge: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_AND, ge, eqh, g2, 4, 4);
    val over: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_OR, over, g1, ge, 4, 4);
    val om: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_SUB, om, zero, over, 4, 4);
    val nom: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_XOR, nom, om, codegen_mir.op_imm(-1), 4, 4);

    val ch_a: codegen_mir.MirOperand = cv_gp(cv);
    val ch_b: codegen_mir.MirOperand = cv_gp(cv);
    val ch:   codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_AND, ch_a, mhi, om, 4, 4);
    cv3(cv, codegen_mir.MIR_AND, ch_b, uh, nom, 4, 4);
    cv3(cv, codegen_mir.MIR_OR, ch, ch_a, ch_b, 4, 4);
    val cl_a: codegen_mir.MirOperand = cv_gp(cv);
    val cl_b: codegen_mir.MirOperand = cv_gp(cv);
    val cl:   codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_AND, cl_a, mlo, om, 4, 4);
    cv3(cv, codegen_mir.MIR_AND, cl_b, ul, nom, 4, 4);
    cv3(cv, codegen_mir.MIR_OR, cl, cl_a, cl_b, 4, 4);

    val th: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_XOR, th, ch, nm, 4, 4);
    val tl: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_XOR, tl, cl, nm, 4, 4);
    cv3(cv, codegen_mir.MIR_ADD, dlo, tl, neg, 4, 4);
    val cy: codegen_mir.MirOperand = cv_gp(cv);
    cv3(cv, codegen_mir.MIR_CMP_LT_U, cy, dlo, neg, 4, 4);
    cv3(cv, codegen_mir.MIR_ADD, dhi, th, cy, 4, 4);
}

fun is_int_fp_conv(op: codegen_mir.MirOpcode) bool {
    ret codegen_mir.has(op, codegen_mir.MIRF_INT_FP_CONV);
}

fun conv_float_operand(op: codegen_mir.MirOpcode) i32 {
    if (codegen_mir.has(op, codegen_mir.MIRF_CONV_TO_FLOAT))   { ret 0; }
    if (codegen_mir.has(op, codegen_mir.MIRF_CONV_FROM_FLOAT)) { ret 1; }
    ret -1;
}

fun conv_int_width(mi: *codegen_mir.MirInstr) u8 {
    if (mi.opcode == codegen_mir.MIR_SI_TO_FP || mi.opcode == codegen_mir.MIR_UI_TO_FP) { ret mi.src_width; }
    ret mi.width;
}

# a lane-wise vector conversion rides the vector bank at its lane widths
fun conv_is_wide(mach: *Machine, mi: *codegen_mir.MirInstr) bool {
    if (!is_int_fp_conv(mi.opcode))                  { ret false; }
    if (codegen_mir.vec_lane_is_vector(mi.vec_lane)) { ret false; }
    if (mi.operand_count < 2)                        { ret false; }
    if (mach.fp_class == FP_CLASS_NONE)              { ret false; }
    ret conv_int_width(mi) > mach.lane_width;
}

fun conv_prepare(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32, out: *ConvEmit) err[fail.Fail] {
    if (plan.lane_width != 4 || conv_int_width(mi) != 8) {
        ret err[fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
    }
    val ii: u32 = 1 - (conv_float_operand(mi.opcode)::u32);
    if (mi.opcode == codegen_mir.MIR_FP_TO_SI || mi.opcode == codegen_mir.MIR_FP_TO_UI) {
        val d: *codegen_mir.MirOperand = ?mi.operands[0];
        if (d.kind != codegen_mir.MIR_OP_VREG || plan.lane_base[d.vreg.n] == LANE_NONE) {
            ret err[fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
        }
    }
    or {
        if (!operand_is_lane_ready(plan, ?mi.operands[ii], 2)) {
            ret err[fail.Fail].err{unsupported(alloc, plan, mi, mi.opcode)};
        }
    }
    out.alloc  = alloc;
    out.f      = f;
    out.src    = mi;
    out.dst    = dst;
    out.cursor = cursor;
    out.fp_cls = plan.mach.fp_class;
    out.fail   = false;
    ret err[fail.Fail].ok{};
}

fun conv_run(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr,
    dst: *codegen_mir.MirInstr, cursor: *u32) err[fail.Fail] {
    var cv: ConvEmit;
    val pr: err[fail.Fail] = conv_prepare(alloc, plan, f, mi, dst, cursor, ?cv);
    if (sel pr.err) { ret pr; }
    if (mi.opcode == codegen_mir.MIR_SI_TO_FP || mi.opcode == codegen_mir.MIR_UI_TO_FP) {
        cv_int_to_fp(?cv, plan, mi);
    }
    or {
        cv_fp_to_int(?cv, plan, mi);
    }
    if (cv.fail) { ret err[fail.Fail].err{fail.message("legalize: out of memory expanding a wide float conversion")}; }
    ret err[fail.Fail].ok{};
}

fun conv_piece_count(alloc: *std_allocator.Allocator, plan: *LanePlan, f: *codegen_mir.MirFunction,
    mi: *codegen_mir.MirInstr) res[u32, fail.Fail] {
    var n: u32            = 0;
    val r: err[fail.Fail] = conv_run(alloc, plan, f, mi, nil, ?n);
    if (sel r.err) { ret res[u32, fail.Fail].err{r.err}; }
    ret res[u32, fail.Fail].ok{n};
}

fun emit_bin(alloc: *std_allocator.Allocator, dst: *codegen_mir.MirInstr, cursor: *u32, src: *codegen_mir.MirInstr,
    opcode: codegen_mir.MirOpcode, d: codegen_mir.MirOperand, a: codegen_mir.MirOperand, b: codegen_mir.MirOperand, w: u8) err[fail.Fail] {
    var ops: [3]codegen_mir.MirOperand;
    ops[0] = d;
    ops[1] = a;
    ops[2] = b;
    ret emit_piece(alloc, dst, cursor, src, opcode, ?ops[0], 3, w);
}

# a refusal of an operand width the target cannot legalize: an error located
# at the instruction on the module's diagnostic store
fun unsupported(alloc: *std_allocator.Allocator, plan: *LanePlan, mi: *codegen_mir.MirInstr, op: codegen_mir.MirOpcode) fail.Fail {
    val family: str                              = unsupported_family(op);
    val rj:     res[str, std_format.FormatError] =
        std_format.sprint(alloc, "{} ({}, {} bytes wide)", family, codegen_mir.opcode_name(op), mi.width);
    if (sel rj.err) { ret fail.format_refused(rj.err); }
    ret codegen_mir.reject_instr_at(plan.diags, diagnostic_kind.TARGET_UNSUPPORTED_OP, plan.f, mi, rj.ok);
}

fun unsupported_family(op: codegen_mir.MirOpcode) str {
    if (codegen_mir.has(op, codegen_mir.MIRF_DIVIDE))    { ret "wide divide is unsupported on this target"; }
    if (codegen_mir.has(op, codegen_mir.MIRF_REMAINDER)) { ret "wide remainder is unsupported on this target"; }
    if (is_shift(op)) {
        ret "shift through an unsupported operand shape on this target";
    }
    if (codegen_mir.has(op, codegen_mir.MIRF_MEMORY)) {
        ret "wide memory access through an unsupported operand shape on this target";
    }
    if (codegen_mir.is_cmp_opcode(op)) {
        ret "wide comparison through an unsupported operand shape on this target";
    }
    if (codegen_mir.has(op, codegen_mir.MIRF_ADDRESS_PRODUCER)) {
        ret "materializing an address wider than one register is not yet legalized on this target";
    }
    if (is_int_fp_conv(op)) {
        ret "converting between a float and an integer wider than one register needs a float register bank this target does not have";
    }
    ret "operation wider than the target ALU is unsupported";
}

#[testing]
fun t_mach(maw: u8, ptr: u8) Machine {
    var m: Machine;
    m.lane_width = maw;
    m.ptr_width  = ptr;
    m.var_shift  = false;
    m.has_mul    = true;
    m.mul_hi     = 0;
    m.mul_form   = isa.MULW_NONE;
    m.pair_lo    = -1;
    m.pair_hi    = -1;
    m.stage_lo   = 6;
    m.stage_hi   = 7;
    m.fp_class   = FP_CLASS_NONE;
    ret m;
}

#[testing]
fun t_vregs(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, n: u32) {
    val r: res[*codegen_mir.MirVReg, std_allocator.Error] = std_allocator.allocate[codegen_mir.MirVReg](alloc, n::usize);
    if (sel r.err) { ret; }
    f.vregs      = r.ok;
    f.vreg_count = n;
    f.vreg_cap   = n;
    var i: u32 = 0;
    for (i < n) {
        f.vregs[i].id         = i;
        f.vregs[i].class      = codegen_mir.REG_CLASS_GP;
        f.vregs[i].spill_slot = -1;
        f.vregs[i].assigned   = codegen_mir.MIR_PREG_NIL;
        f.vregs[i].vec_bytes  = 0;
        i                     = i + 1;
    }
}

#[testing]
fun t_block(alloc: *std_allocator.Allocator, b: *codegen_mir.MirBlock, n: u32) {
    val r: res[*codegen_mir.MirInstr, std_allocator.Error] = std_allocator.zallocate[codegen_mir.MirInstr](alloc, n::usize);
    if (sel r.err) { ret; }
    b.instrs      = r.ok;
    b.instr_count = n;
    b.instr_cap   = n;
    b.id          = 0;
}

#[testing]
fun t_instr(alloc: *std_allocator.Allocator, b: *codegen_mir.MirBlock, ix: u32, opcode: codegen_mir.MirOpcode,
    ops: *codegen_mir.MirOperand, nops: u32, width: u8) {
    val r: res[*codegen_mir.MirOperand, std_allocator.Error] = std_allocator.allocate[codegen_mir.MirOperand](alloc, nops::usize);
    if (sel r.err) { ret; }
    val arr: *codegen_mir.MirOperand = r.ok;
    var j:   u32                     = 0;
    for (j < nops) {
        arr[j] = ops[j];
        j      = j + 1;
    }
    b.instrs[ix].opcode        = opcode;
    b.instrs[ix].operands      = arr;
    b.instrs[ix].operand_count = nops;
    b.instrs[ix].width         = width;
    b.instrs[ix].src_width     = width;
    b.instrs[ix].vec_lane      = codegen_mir.VEC_LANE_NONE;
}

test emit_piece__refuses_to_drop_a_vector_lane_source {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var dst: codegen_mir.MirBlock;
    t_block(?alloc, ?dst, 1);
    var cursor: u32 = 0;

    var src: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_ADD, nil, 0, 4, 4);
    src.vec_lane = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4);

    val r: err[fail.Fail] = emit_piece(?alloc, dst.instrs, ?cursor, ?src, codegen_mir.MIR_ADD, nil, 0, 4);
    if (sel r.err == false) { ret 1; }
    ret 0;
}

# at a native lane width nothing is split: an add, a value-based load and a wide conversion
test legalize_function__inert_at_native_width {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(8, 8);
    mach.fp_class = codegen_mir.REG_CLASS_GP + 1;

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 2);
    var ops: [3]codegen_mir.MirOperand;
    ops[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    ops[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    ops[2] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_ADD, ?ops[0], 3, 8);
    var ld: [2]codegen_mir.MirOperand;
    ld[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    ld[1] = codegen_mir.op_mem_value(codegen_mir.vreg_id(0), 0);
    t_instr(?alloc, ?b, 1, codegen_mir.MIR_LOAD, ?ld[0], 2, 8);
    f.blocks      = ?b;
    f.block_count = 1;

    val before_ptr: *codegen_mir.MirInstr = b.instrs;
    val r:          err[fail.Fail]        = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel r.err)              { ret 1; }
    if (b.instrs != before_ptr) { ret 2; }
    if (b.instr_count != 2)     { ret 3; }
    if (f.vreg_count != 3)      { ret 4; }

    var g:  codegen_mir.MirFunction;
    var gb: codegen_mir.MirBlock;
    t_conv_fn(?alloc, ?g, ?gb, codegen_mir.MIR_SI_TO_FP, codegen_mir.REG_CLASS_GP + 1, 8, 8);
    val conv_ptr: *codegen_mir.MirInstr = gb.instrs;
    val rc:       err[fail.Fail]        = legalize_function(?alloc, ?mach, ?g, nil);
    if (sel rc.err)            { ret 5; }
    if (gb.instrs != conv_ptr) { ret 6; }
    if (gb.instr_count != 2)   { ret 7; }
    if (g.vreg_count != 3)     { ret 8; }
    ret 0;
}

# a 128-bit immediate splits into the lanes of its two limbs, and a 64-bit
# immediate reads above its width as its sign fill (#3511)
test imm_lane__splits_both_limbs {
    val hi:   u64                    = 0x99AABBCCDDEEFF00;
    val wide: codegen_mir.MirOperand = codegen_mir.op_imm_wide(0x1122334455667788, hi:~i64);
    if (imm_lane(?wide, 0, 8) != 0x1122334455667788)                        { ret 1; }
    if (imm_lane(?wide, 1, 8):~u64 != hi)                                   { ret 2; }
    if (imm_lane(?wide, 0, 4) != 0x55667788)                                { ret 3; }
    if (imm_lane(?wide, 1, 4) != 0x11223344)                                { ret 4; }
    if (imm_lane(?wide, 2, 4) != 0xDDEEFF00)                                { ret 5; }
    if (imm_lane(?wide, 3, 4) != 0x99AABBCC)                                { ret 6; }
    if (imm_lane(?wide, 0, 1) != 0x88 || imm_lane(?wide, 15, 1) != 0x99)    { ret 7; }
    if (imm_lane(?wide, 4, 2) != 0xFF00 || imm_lane(?wide, 7, 2) != 0x99AA) { ret 8; }

    val neg: codegen_mir.MirOperand = codegen_mir.op_imm(-1);
    if (imm_lane(?neg, 0, 8) != -1 || imm_lane(?neg, 1, 8) != -1)                 { ret 9; }
    if (imm_lane(?neg, 2, 4) != 0xFFFFFFFF || imm_lane(?neg, 3, 4) != 0xFFFFFFFF) { ret 10; }
    val one: codegen_mir.MirOperand = codegen_mir.op_imm(1);
    if (imm_lane(?one, 0, 8) != 1 || imm_lane(?one, 1, 8) != 0) { ret 11; }
    if (imm_lane(?one, 0, 4) != 1 || imm_lane(?one, 2, 4) != 0) { ret 12; }
    ret 0;
}

# an IR constant with a high limb lowers to one 128-bit immediate and
# legalizes at an 8-byte lane into two lane moves carrying the limbs (#3511)
test expand_wide__ir_constant_becomes_lane_immediates {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    val c:       value.Value                            = value.const_int_wide(wide.make(0x0FEDCBA987654321, 0x123456789ABCDEF0), 0);
    var ctx:     mir_context.LowerCtx;
    val lowered: res[codegen_mir.MirOperand, fail.Fail] = mir_context.lower_value(?ctx, c);
    if (sel lowered.err)                                                                 { ret 1; }
    if (lowered.ok.kind != codegen_mir.MIR_OP_IMM)                                       { ret 2; }
    if (lowered.ok.imm != 0x0FEDCBA987654321 || lowered.ok.imm_hi != 0x123456789ABCDEF0) { ret 3; }

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 1);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var mv: [2]codegen_mir.MirOperand;
    mv[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    mv[1] = lowered.ok;
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_MOV, ?mv[0], 2, 16);
    f.blocks      = ?b;
    f.block_count = 1;

    var mach: Machine        = t_mach(8, 8);
    val r:    err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel r.err)          { ret 4; }
    if (b.instr_count != 2) { ret 5; }
    var i: u32 = 0;
    for (i < 2) {
        if (b.instrs[i].opcode != codegen_mir.MIR_MOV || b.instrs[i].width != 8) { ret 6; }
        if (b.instrs[i].operands[1].kind != codegen_mir.MIR_OP_IMM)              { ret 7; }
        i = i + 1;
    }
    if (b.instrs[0].operands[1].imm != 0x0FEDCBA987654321) { ret 8; }
    if (b.instrs[1].operands[1].imm != 0x123456789ABCDEF0) { ret 9; }
    ret 0;
}

test expand_wide__add_carry_chain {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 3);
    var m1: [2]codegen_mir.MirOperand;
    m1[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    m1[1] = codegen_mir.op_imm(0x0102);
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_MOV, ?m1[0], 2, 2);
    var m2: [2]codegen_mir.MirOperand;
    m2[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    m2[1] = codegen_mir.op_imm(0x0304);
    t_instr(?alloc, ?b, 1, codegen_mir.MIR_MOV, ?m2[0], 2, 2);
    var ad: [3]codegen_mir.MirOperand;
    ad[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    ad[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    ad[2] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    t_instr(?alloc, ?b, 2, codegen_mir.MIR_ADD, ?ad[0], 3, 2);
    f.blocks      = ?b;
    f.block_count = 1;

    var mach: Machine        = t_mach(1, 2);
    val r:    err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel r.err) { ret 1; }

    if (f.vreg_count != 11) { ret 1; }

    if (b.instr_count != 8) { ret 1; }

    if (b.instrs[4].opcode != codegen_mir.MIR_ADD)      { ret 1; }
    if (b.instrs[4].width != 1)                         { ret 1; }
    if (b.instrs[4].operands[0].vreg.n != 7)            { ret 1; }
    if (b.instrs[5].opcode != codegen_mir.MIR_CMP_LT_U) { ret 1; }
    if (b.instrs[6].opcode != codegen_mir.MIR_ADD)      { ret 1; }
    if (b.instrs[7].opcode != codegen_mir.MIR_ADD)      { ret 1; }
    if (b.instrs[7].operands[0].vreg.n != 8)            { ret 1; }
    ret 0;
}

#[testing]
fun t_bind(alloc: *std_allocator.Allocator, mi: *codegen_mir.MirInstr, iid: u32, vreg: u32) bool {
    val r: err[fail.Fail] = codegen_mir.instr_attach_dbg(alloc, mi, iid, vreg);
    ret sel r.ok;
}

#[testing]
fun t_lane_binding(b: *codegen_mir.MirDbgBinding, vreg: u32, lane: u8, lanes: u8, bytes: u8) bool {
    ret b.vreg == vreg && b.cmp_op == 0 && b.lane == lane && b.lanes == lanes && b.lane_bytes == bytes;
}

test lane_bindings__name_the_lanes_of_a_wide_value {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 4);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 4);
    var m1: [2]codegen_mir.MirOperand;
    m1[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    m1[1] = codegen_mir.op_imm(0x0102);
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_MOV, ?m1[0], 2, 2);
    var m2: [2]codegen_mir.MirOperand;
    m2[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    m2[1] = codegen_mir.op_imm(0x0304);
    t_instr(?alloc, ?b, 1, codegen_mir.MIR_MOV, ?m2[0], 2, 2);
    var ad: [3]codegen_mir.MirOperand;
    ad[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    ad[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    ad[2] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    t_instr(?alloc, ?b, 2, codegen_mir.MIR_ADD, ?ad[0], 3, 2);
    var nm: [2]codegen_mir.MirOperand;
    nm[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(3));
    nm[1] = codegen_mir.op_imm(5);
    t_instr(?alloc, ?b, 3, codegen_mir.MIR_MOV, ?nm[0], 2, 1);
    f.blocks      = ?b;
    f.block_count = 1;

    if (!t_bind(?alloc, ?b.instrs[0], 10, 1)) { ret 1; }
    if (!t_bind(?alloc, ?b.instrs[0], 11, 1)) { ret 1; }
    b.instrs[0].dbg_bindings[1].cmp_op     = codegen_mir.MIR_SEL_CBR_NE;
    b.instrs[0].dbg_bindings[1].rhs_is_imm = true;
    if (!t_bind(?alloc, ?b.instrs[2], 12, 0)) { ret 1; }
    val bound_end: err[fail.Fail] = codegen_mir.instr_attach_dbg_end(?alloc, ?b.instrs[2], 15, 0);
    if (sel bound_end.err)                    { ret 1; }
    if (!t_bind(?alloc, ?b.instrs[3], 13, 0)) { ret 1; }
    if (!t_bind(?alloc, ?b.instrs[3], 14, 3)) { ret 1; }

    var mach: Machine        = t_mach(1, 2);
    val r:    err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel r.err)          { ret 1; }
    if (b.instr_count != 9) { ret 2; }

    # the comparison over a wide value is dropped, the value itself is its lanes
    val mv: *codegen_mir.MirInstr = ?b.instrs[0];
    if (mv.dbg_binding_count != 2) { ret 3; }
    val v1: u32 = mv.operands[0].vreg.n;
    if (mv.dbg_bindings[0].iid != 10 || mv.dbg_bindings[1].iid != 10) { ret 3; }
    if (!t_lane_binding(?mv.dbg_bindings[0], v1, 0, 2, 1))            { ret 3; }
    if (!t_lane_binding(?mv.dbg_bindings[1], v1 + 1, 1, 2, 1))        { ret 3; }
    if (b.instrs[1].dbg_binding_count != 0)                           { ret 3; }

    # an expanded instruction hands its start bindings to its first piece and
    # its end bindings to its last, where the whole value exists
    val add: *codegen_mir.MirInstr = ?b.instrs[4];
    if (add.dbg_binding_count != 2)                               { ret 4; }
    if (!t_lane_binding(?add.dbg_bindings[0], 8, 0, 2, 1))        { ret 4; }
    if (!t_lane_binding(?add.dbg_bindings[1], 9, 1, 2, 1))        { ret 4; }
    if (add.dbg_bindings[0].at_end || add.dbg_bindings[1].at_end) { ret 4; }
    var k: u32 = 5;
    for (k < 7) {
        if (b.instrs[k].dbg_binding_count != 0) { ret 4; }
        k = k + 1;
    }
    val add_end: *codegen_mir.MirInstr = ?b.instrs[7];
    if (add_end.dbg_binding_count != 2)                                         { ret 6; }
    if (add_end.dbg_bindings[0].iid != 15 || add_end.dbg_bindings[1].iid != 15) { ret 6; }
    if (!t_lane_binding(?add_end.dbg_bindings[0], 8, 0, 2, 1))                  { ret 6; }
    if (!t_lane_binding(?add_end.dbg_bindings[1], 9, 1, 2, 1))                  { ret 6; }
    if (!add_end.dbg_bindings[0].at_end || !add_end.dbg_bindings[1].at_end)     { ret 6; }

    # a native instruction keeps a narrow binding and relanes a wide one
    val nw: *codegen_mir.MirInstr = ?b.instrs[8];
    if (nw.dbg_binding_count != 3)                                                        { ret 5; }
    if (!t_lane_binding(?nw.dbg_bindings[0], 8, 0, 2, 1) || nw.dbg_bindings[0].iid != 13) { ret 5; }
    if (!t_lane_binding(?nw.dbg_bindings[1], 9, 1, 2, 1) || nw.dbg_bindings[1].iid != 13) { ret 5; }
    if (!t_lane_binding(?nw.dbg_bindings[2], 3, 0, 0, 0) || nw.dbg_bindings[2].iid != 14) { ret 5; }
    ret 0;
}

# v0 (8 bytes) <- widen v1 (sw bytes), on a 4-byte lane machine
#[testing]
fun t_ext_fn(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, b: *codegen_mir.MirBlock,
    opcode: codegen_mir.MirOpcode, sw: u8) {
    t_vregs(alloc, f, 2);
    t_block(alloc, b, 2);
    var mv: [2]codegen_mir.MirOperand;
    mv[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    mv[1] = codegen_mir.op_imm(0x1f8);
    t_instr(alloc, b, 0, codegen_mir.MIR_MOV, ?mv[0], 2, sw);
    var cv: [2]codegen_mir.MirOperand;
    cv[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    cv[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    t_instr(alloc, b, 1, opcode, ?cv[0], 2, 8);
    b.instrs[1].src_width = sw;
    f.blocks              = b;
    f.block_count         = 1;
}

# the low lane of a widened sub-word value is the lane-wide convert of the
# source, never a move of the register it sits in (#3616)
#[testing]
fun t_low_lane_converts(opcode: codegen_mir.MirOpcode, sw: u8) i32 {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(4, 4);
    var f:    codegen_mir.MirFunction;
    var b:    codegen_mir.MirBlock;
    t_ext_fn(?alloc, ?f, ?b, opcode, sw);
    val r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel r.err) { ret 1; }

    val lo: *codegen_mir.MirInstr = ?b.instrs[1];
    if (lo.opcode != opcode)                            { ret 1; }
    if (lo.width != 4 || lo.src_width != sw)            { ret 1; }
    if (lo.operands[1].kind != codegen_mir.MIR_OP_VREG) { ret 1; }
    if (lo.operands[1].vreg.n != 1)                     { ret 1; }
    val lane0: u32 = lo.operands[0].vreg.n;

    if (opcode == codegen_mir.MIR_ZEXT) {
        if (b.instr_count != 3)                                     { ret 1; }
        if (b.instrs[2].opcode != codegen_mir.MIR_MOV)              { ret 1; }
        if (b.instrs[2].operands[1].kind != codegen_mir.MIR_OP_IMM) { ret 1; }
        if (b.instrs[2].operands[1].imm != 0)                       { ret 1; }
        ret 0;
    }
    if (b.instr_count != 4) { ret 1; }
    val fill: *codegen_mir.MirInstr = ?b.instrs[2];
    if (fill.opcode != codegen_mir.MIR_SHR_S)                      { ret 1; }
    if (fill.operands[1].vreg.n != lane0)                          { ret 1; }
    if (fill.operands[2].imm != 31)                                { ret 1; }
    if (b.instrs[3].opcode != codegen_mir.MIR_MOV)                 { ret 1; }
    if (b.instrs[3].operands[1].vreg.n != fill.operands[0].vreg.n) { ret 1; }
    ret 0;
}

# a signed widen of an immediate folds: every lane is a move of the value's
# lane as the lane-wide pattern imm_lane gives, the high ones its sign, and no
# runtime fill appears (#3700)
#[testing]
fun t_sext_immediate_folds(lw: u8, dst_w: u8, sw: u8, imm: i64, want_lo: i64, want_hi: i64) i32 {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(lw, lw);
    var f:    codegen_mir.MirFunction;
    var b:    codegen_mir.MirBlock;
    t_vregs(?alloc, ?f, 1);
    t_block(?alloc, ?b, 1);
    var cv: [2]codegen_mir.MirOperand;
    cv[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    cv[1] = codegen_mir.op_imm(imm);
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_SEXT, ?cv[0], 2, dst_w);
    b.instrs[0].src_width = sw;
    f.blocks              = ?b;
    f.block_count         = 1;
    val r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel r.err)          { ret 1; }
    if (b.instr_count != 2) { ret 2; }
    var i: u32 = 0;
    for (i < 2) {
        val p: *codegen_mir.MirInstr = ?b.instrs[i];
        if (p.opcode != codegen_mir.MIR_MOV)              { ret 3; }
        if (p.width != lw)                                { ret 4; }
        if (p.operands[1].kind != codegen_mir.MIR_OP_IMM) { ret 5; }
        i = i + 1;
    }
    if (b.instrs[0].operands[1].imm != want_lo) { ret 6; }
    if (b.instrs[1].operands[1].imm != want_hi) { ret 7; }
    ret 0;
}

test expand_sext__immediate_folds_to_lane_immediates {
    if (t_sext_immediate_folds(4, 8, 1, 0xf8, 0xfffffff8, 0xffffffff) != 0)       { ret 1; }
    if (t_sext_immediate_folds(4, 8, 2, 0xfff0, 0xfffffff0, 0xffffffff) != 0)     { ret 2; }
    if (t_sext_immediate_folds(4, 8, 4, 0xffffff00, 0xffffff00, 0xffffffff) != 0) { ret 3; }
    if (t_sext_immediate_folds(4, 8, 1, 0x7f, 127, 0) != 0)                       { ret 4; }
    if (t_sext_immediate_folds(8, 16, 8, -2, -2, -1) != 0)                        { ret 5; }
    ret 0;
}

test expand_ext__low_lane_converts_the_source {
    if (t_low_lane_converts(codegen_mir.MIR_ZEXT, 1) != 0) { ret 1; }
    if (t_low_lane_converts(codegen_mir.MIR_ZEXT, 2) != 0) { ret 2; }
    if (t_low_lane_converts(codegen_mir.MIR_SEXT, 1) != 0) { ret 3; }
    if (t_low_lane_converts(codegen_mir.MIR_SEXT, 2) != 0) { ret 4; }
    ret 0;
}

# a lane-wide source has nothing above its width: its lane is a move, and a
# signed widen fills from the source lane itself
test expand_ext__lane_wide_source_widens_by_a_move {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(4, 4);

    var fz: codegen_mir.MirFunction;
    var bz: codegen_mir.MirBlock;
    t_ext_fn(?alloc, ?fz, ?bz, codegen_mir.MIR_ZEXT, 4);
    val rz: err[fail.Fail] = legalize_function(?alloc, ?mach, ?fz, nil);
    if (sel rz.err)                                             { ret 1; }
    if (bz.instr_count != 3)                                    { ret 1; }
    if (bz.instrs[1].opcode != codegen_mir.MIR_MOV)             { ret 1; }
    if (bz.instrs[1].width != 4 || bz.instrs[1].src_width != 4) { ret 1; }
    if (bz.instrs[1].operands[1].vreg.n != 1)                   { ret 1; }

    var fs: codegen_mir.MirFunction;
    var bs: codegen_mir.MirBlock;
    t_ext_fn(?alloc, ?fs, ?bs, codegen_mir.MIR_SEXT, 4);
    val rs: err[fail.Fail] = legalize_function(?alloc, ?mach, ?fs, nil);
    if (sel rs.err)                                                         { ret 1; }
    if (bs.instr_count != 4)                                                { ret 1; }
    if (bs.instrs[1].opcode != codegen_mir.MIR_MOV)                         { ret 1; }
    if (bs.instrs[2].opcode != codegen_mir.MIR_SHR_S)                       { ret 1; }
    if (bs.instrs[2].operands[1].vreg.n != bs.instrs[1].operands[0].vreg.n) { ret 1; }
    ret 0;
}

#[testing]
fun t_divmod_fn(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, b: *codegen_mir.MirBlock,
    op: codegen_mir.MirOpcode, width: u8, a: i64, bv: i64) {
    t_vregs(alloc, f, 3);
    t_block(alloc, b, 3);
    var ma: [2]codegen_mir.MirOperand;
    ma[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    ma[1] = codegen_mir.op_imm(a);
    t_instr(alloc, b, 0, codegen_mir.MIR_MOV, ?ma[0], 2, width);
    var mb: [2]codegen_mir.MirOperand;
    mb[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    mb[1] = codegen_mir.op_imm(bv);
    t_instr(alloc, b, 1, codegen_mir.MIR_MOV, ?mb[0], 2, width);
    var dv: [3]codegen_mir.MirOperand;
    dv[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    dv[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    dv[2] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    t_instr(alloc, b, 2, op, ?dv[0], 3, width);
    f.blocks      = b;
    f.block_count = 1;
}

test expand_divmod__is_branch_free {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(1, 2);

    var f: codegen_mir.MirFunction;
    var b: codegen_mir.MirBlock;
    t_divmod_fn(?alloc, ?f, ?b, codegen_mir.MIR_DIV_U, 2, 1000, 7);

    var plan:         LanePlan;
    val plan_lanes_r: err[fail.Fail] = plan_lanes(?alloc, ?mach, ?f, ?plan);
    if (sel plan_lanes_r.err) { ret 1; }
    val rc: res[u32, fail.Fail] = divmod_piece_count(?alloc, ?plan, ?b.instrs[2]);
    if (sel rc.err) { ret 1; }
    val want: u32 = rc.ok;
    free_plan(?alloc, ?plan);

    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel legalize_function_r.err) { ret 1; }
    if (b.instr_count != 4 + want)   { ret 1; }
    var i:        u32 = 0;
    var probes:   u32 = 0;
    var probe_at: u32 = 0;
    for (i < b.instr_count) {
        if (b.instrs[i].width != 1)                                                                                                                    { ret 1; }
        if (b.instrs[i].opcode == codegen_mir.MIR_BR)                                                                                                  { ret 1; }
        if (b.instrs[i].opcode == codegen_mir.MIR_CBR)                                                                                                 { ret 1; }
        if (b.instrs[i].opcode == codegen_mir.MIR_DIV_S || b.instrs[i].opcode == codegen_mir.MIR_REM_U || b.instrs[i].opcode == codegen_mir.MIR_REM_S) { ret 1; }
        if (b.instrs[i].opcode == codegen_mir.MIR_DIV_U) {
            if (b.instrs[i].operand_count != 3 || b.instrs[i].operands[1].kind != codegen_mir.MIR_OP_IMM
                || b.instrs[i].operands[1].imm != 1 || b.instrs[i].operands[2].kind != codegen_mir.MIR_OP_VREG) { ret 1; }
            probes   = probes + 1;
            probe_at = i;
        }
        i = i + 1;
    }
    if (f.block_count != 1) { ret 1; }
    if (probes != 1)        { ret 1; }

    val last: u32 = b.instr_count - 1;
    if (b.instrs[last].opcode != codegen_mir.MIR_OR)                { ret 1; }
    if (b.instrs[last].operands[0].kind != codegen_mir.MIR_OP_VREG) { ret 1; }
    if (probe_at >= last)                                           { ret 1; }
    i = 0;
    for (i < b.instr_count) {
        if (b.instrs[i].opcode == codegen_mir.MIR_XOR && b.instrs[i].operand_count == 3
            && b.instrs[i].operands[2].kind == codegen_mir.MIR_OP_IMM && b.instrs[i].operands[2].imm == -1) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test divmod_piece_count__matches_emission {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(1, 2);

    var ops: [4]codegen_mir.MirOpcode;
    ops[0] = codegen_mir.MIR_DIV_U;
    ops[1] = codegen_mir.MIR_DIV_S;
    ops[2] = codegen_mir.MIR_REM_U;
    ops[3] = codegen_mir.MIR_REM_S;
    var k: u32 = 0;
    for (k < 4) {
        var f: codegen_mir.MirFunction;
        var b: codegen_mir.MirBlock;
        t_divmod_fn(?alloc, ?f, ?b, ops[k], 2, 1000, 7);
        var plan:         LanePlan;
        val plan_lanes_r: err[fail.Fail] = plan_lanes(?alloc, ?mach, ?f, ?plan);
        if (sel plan_lanes_r.err) { ret 1; }
        val rc: res[u32, fail.Fail] = divmod_piece_count(?alloc, ?plan, ?b.instrs[2]);
        if (sel rc.err) { ret 1; }
        val n: u32 = rc.ok;
        free_plan(?alloc, ?plan);
        val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
        if (sel legalize_function_r.err) { ret 1; }
        if (b.instr_count != 4 + n)      { ret 1; }
        k = k + 1;
    }
    ret 0;
}

test mul_piece_count__matches_emission {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var widths: [3]u8;
    widths[0] = 2;
    widths[1] = 4;
    widths[2] = 8;
    var native: u32 = 0;
    for (native < 2) {
        var mach: Machine = t_mach(1, 2);
        if (native == 1) {
            mach.mul_hi   = 1;
            mach.mul_form = isa.MULW_THREE_ADDRESS;
        }

        var k: u32 = 0;
        for (k < 3) {
            var f: codegen_mir.MirFunction;
            var b: codegen_mir.MirBlock;
            t_divmod_fn(?alloc, ?f, ?b, codegen_mir.MIR_MUL, widths[k], 1000, 7);
            var plan:         LanePlan;
            val plan_lanes_r: err[fail.Fail] = plan_lanes(?alloc, ?mach, ?f, ?plan);
            if (sel plan_lanes_r.err) { ret 1; }
            val rc: res[u32, fail.Fail] = mul_piece_count(?alloc, ?plan, ?b.instrs[2]);
            if (sel rc.err) { ret 1; }
            val n: u32 = rc.ok;
            free_plan(?alloc, ?plan);
            val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
            if (sel legalize_function_r.err)             { ret 1; }
            if (b.instr_count != 2 * widths[k]::u32 + n) { ret 1; }
            k = k + 1;
        }
        native = native + 1;
    }
    ret 0;
}

test expand_mul__declared_widening_form_selects_the_native_leaf {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    var b: codegen_mir.MirBlock;
    t_divmod_fn(?alloc, ?f, ?b, codegen_mir.MIR_MUL, 8, 1000, 7);

    var mach: Machine = t_mach(4, 4);
    mach.mul_hi   = 4;
    mach.mul_form = isa.MULW_THREE_ADDRESS;
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel legalize_function_r.err) { ret 1; }

    if (b.instr_count != 4 + 8) { ret 2; }

    var muls:   u32 = 0;
    var highs:  u32 = 0;
    var shifts: u32 = 0;
    var i:      u32 = 4;
    for (i < b.instr_count) {
        val op: codegen_mir.MirOpcode = b.instrs[i].opcode;
        if (op == codegen_mir.MIR_MUL)                                { muls = muls + 1; }
        if (op == codegen_mir.MIR_MUL_HI_U)                           { highs = highs + 1; }
        if (op == codegen_mir.MIR_SHL || op == codegen_mir.MIR_SHR_U) { shifts = shifts + 1; }
        i = i + 1;
    }
    if (muls != 3)   { ret 3; }
    if (highs != 1)  { ret 4; }
    if (shifts != 0) { ret 5; }

    var f2: codegen_mir.MirFunction;
    var b2: codegen_mir.MirBlock;
    t_divmod_fn(?alloc, ?f2, ?b2, codegen_mir.MIR_MUL, 8, 1000, 7);
    var m2:                   Machine        = t_mach(4, 4);
    val legalize_function_r2: err[fail.Fail] = legalize_function(?alloc, ?m2, ?f2, nil);
    if (sel legalize_function_r2.err) { ret 6; }
    # no widening form: the one full product is double-and-add, the two
    # cross products whose high halves are discarded stay the plain multiply
    var muls2:   u32 = 0;
    var highs2:  u32 = 0;
    var shifts2: u32 = 0;
    i = 4;
    for (i < b2.instr_count) {
        val op: codegen_mir.MirOpcode = b2.instrs[i].opcode;
        if (op == codegen_mir.MIR_MUL)                                { muls2 = muls2 + 1; }
        if (op == codegen_mir.MIR_MUL_HI_U)                           { highs2 = highs2 + 1; }
        if (op == codegen_mir.MIR_SHL || op == codegen_mir.MIR_SHR_U) { shifts2 = shifts2 + 1; }
        i = i + 1;
    }
    if (muls2 != 2 || highs2 != 0) { ret 7; }
    if (shifts2 == 0)              { ret 8; }
    ret 0;
}

test expand_mul__refuses_an_unmodelled_widening_form {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    var b: codegen_mir.MirBlock;
    t_divmod_fn(?alloc, ?f, ?b, codegen_mir.MIR_MUL, 4, 1000, 7);
    var m1: Machine = t_mach(1, 2);
    m1.mul_hi   = 4;
    m1.mul_form = isa.MULW_THREE_ADDRESS;
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?m1, ?f, nil);
    if (!sel legalize_function_r.err) { ret 1; }

    var f2: codegen_mir.MirFunction;
    var b2: codegen_mir.MirBlock;
    t_divmod_fn(?alloc, ?f2, ?b2, codegen_mir.MIR_MUL, 4, 1000, 7);
    var m2: Machine = t_mach(1, 2);
    m2.mul_hi   = 1;
    m2.mul_form = isa.MULW_THREE_ADDRESS;
    m2.has_mul  = false;
    val legalize_function_r2: err[fail.Fail] = legalize_function(?alloc, ?m2, ?f2, nil);
    if (!sel legalize_function_r2.err) { ret 1; }

    var f3: codegen_mir.MirFunction;
    var b3: codegen_mir.MirBlock;
    t_divmod_fn(?alloc, ?f3, ?b3, codegen_mir.MIR_MUL, 4, 1000, 7);
    var m3: Machine = t_mach(1, 2);
    m3.mul_hi   = 1;
    m3.mul_form = isa.MULW_THREE_ADDRESS;
    val legalize_function_r3: err[fail.Fail] = legalize_function(?alloc, ?m3, ?f3, nil);
    if (sel legalize_function_r3.err) { ret 1; }
    ret 0;
}

test expand_access__fixed_base {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 1);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var ld: [2]codegen_mir.MirOperand;
    ld[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    ld[1] = codegen_mir.op_mem_preg(codegen_mir.preg_id(0), 0);
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_MOV, ?ld[0], 2, 4);
    f.blocks      = ?b;
    f.block_count = 1;

    var mach: Machine        = t_mach(1, 2);
    val r:    err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel r.err)          { ret 1; }
    if (b.instr_count != 4) { ret 1; }

    var i: u32 = 0;
    for (i < 4) {
        if (b.instrs[i].opcode != codegen_mir.MIR_LOAD)             { ret 1; }
        if (b.instrs[i].width != 1)                                 { ret 1; }
        if (b.instrs[i].operands[0].vreg.n != 1 + i)                { ret 1; }
        if (b.instrs[i].operands[1].kind != codegen_mir.MIR_OP_MEM) { ret 1; }
        if (b.instrs[i].operands[1].preg.n != 0)                    { ret 1; }
        if (b.instrs[i].operands[1].imm != i::i64)                  { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test expand_access__symbol_keeps_volatile {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 1);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var ld: [2]codegen_mir.MirOperand;
    ld[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    ld[1] = codegen_mir.op_sym(7, 0);
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_LOAD, ?ld[0], 2, 4);
    f.blocks      = ?b;
    f.block_count = 1;
    fin { codegen_mir.dnit_function(?alloc, ?f); }
    b.instrs[0].memory_flags = codegen_mir.MEMORY_VOLATILE;

    var mach: Machine        = t_mach(2, 2);
    val r:    err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel r.err)          { ret 1; }
    if (b.instr_count != 2) { ret 1; }

    var i: u32 = 0;
    for (i < 2) {
        if (b.instrs[i].opcode != codegen_mir.MIR_LOAD)              { ret 1; }
        if (b.instrs[i].memory_flags != codegen_mir.MEMORY_VOLATILE) { ret 2; }
        if (b.instrs[i].width != 2)                                  { ret 1; }
        if (b.instrs[i].operands[0].vreg.n != 1 + i)                 { ret 1; }
        if (b.instrs[i].operands[1].kind != codegen_mir.MIR_OP_SYM)  { ret 1; }
        if (b.instrs[i].operands[1].sym != 7)                        { ret 1; }
        if (b.instrs[i].operands[1].sym_off != (i * 2)::i64)         { ret 1; }
        i = i + 1;
    }
    ret 0;
}

# a narrow access indexed by a wide value is refused: once the value's lanes
# replace it, the index would name a register nothing defines (#3615)
test expand_access__refuses_a_wide_index {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 2);
    var def: [2]codegen_mir.MirOperand;
    def[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    def[1] = codegen_mir.op_imm(0x0102);
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_MOV, ?def[0], 2, 2);
    var ld: [2]codegen_mir.MirOperand;
    ld[0]       = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    ld[1]       = codegen_mir.op_mem_value(codegen_mir.vreg_id(1), 0);
    ld[1].index = codegen_mir.index_vreg(codegen_mir.vreg_id(0));
    ld[1].scale = 1;
    t_instr(?alloc, ?b, 1, codegen_mir.MIR_LOAD, ?ld[0], 2, 1);
    f.blocks      = ?b;
    f.block_count = 1;

    var mach: Machine        = t_mach(1, 1);
    val r:    err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (!sel r.err) { ret 1; }

    # the same access indexed by a narrow value is legalized as before
    var g: codegen_mir.MirFunction;
    t_vregs(?alloc, ?g, 3);
    var gb: codegen_mir.MirBlock;
    t_block(?alloc, ?gb, 2);
    t_instr(?alloc, ?gb, 0, codegen_mir.MIR_MOV, ?def[0], 2, 2);
    var ld2: [2]codegen_mir.MirOperand;
    ld2[0]       = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    ld2[1]       = codegen_mir.op_mem_value(codegen_mir.vreg_id(1), 0);
    ld2[1].index = codegen_mir.index_vreg(codegen_mir.vreg_id(1));
    ld2[1].scale = 1;
    t_instr(?alloc, ?gb, 1, codegen_mir.MIR_LOAD, ?ld2[0], 2, 1);
    g.blocks      = ?gb;
    g.block_count = 1;
    val r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?g, nil);
    if (sel r2.err) { ret 2; }
    ret 0;
}

test expand_access__refuses_a_missing_address {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 2);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var ld: [2]codegen_mir.MirOperand;
    ld[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    ld[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_LOAD, ?ld[0], 2, 4);
    f.blocks      = ?b;
    f.block_count = 1;

    var mach: Machine        = t_mach(2, 2);
    val r:    err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (!sel r.err) { ret 1; }
    ret 0;
}

# a wide move from one physical register used to take lane i as register id
# + i, which is right only where an ABI happens to hand out consecutive ids.
# the pieces are stated by a lane op now, and the guess is refused (#3602)
test expand_wide__refuses_a_physical_register_operand {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 1);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var mv: [2]codegen_mir.MirOperand;
    mv[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    mv[1] = codegen_mir.op_preg(codegen_mir.preg_id(7));
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_MOV, ?mv[0], 2, 2);
    f.blocks      = ?b;
    f.block_count = 1;

    var mach: Machine        = t_mach(1, 2);
    val r:    err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (!sel r.err)         { ret 1; }
    if (b.instr_count != 1) { ret 1; }

    # the other direction, a wide value into a register, is the same guess
    var g: codegen_mir.MirFunction;
    t_vregs(?alloc, ?g, 1);
    var gb: codegen_mir.MirBlock;
    t_block(?alloc, ?gb, 2);
    var def: [2]codegen_mir.MirOperand;
    def[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    def[1] = codegen_mir.op_imm(0x0102);
    t_instr(?alloc, ?gb, 0, codegen_mir.MIR_MOV, ?def[0], 2, 2);
    var out: [2]codegen_mir.MirOperand;
    out[0] = codegen_mir.op_preg(codegen_mir.preg_id(7));
    out[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    t_instr(?alloc, ?gb, 1, codegen_mir.MIR_MOV, ?out[0], 2, 2);
    g.blocks      = ?gb;
    g.block_count = 1;
    val r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?g, nil);
    if (!sel r2.err) { ret 1; }
    ret 0;
}

# SysV-shaped: the first two argument registers are rdi = 7 and rsi = 6, so
# lane 1 is not register id + 1. the join names the pieces and legalize moves
# each into its lane, in the order the pieces were stated
test lane_join__takes_lanes_from_the_pieces_named {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 2);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 2);
    var jn: [3]codegen_mir.MirOperand;
    jn[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    jn[1] = codegen_mir.op_preg(codegen_mir.preg_id(7));
    jn[2] = codegen_mir.op_preg(codegen_mir.preg_id(6));
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_LANE_JOIN, ?jn[0], 3, 2);
    b.instrs[0].src_width = 1;
    var use: [3]codegen_mir.MirOperand;
    use[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    use[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    use[2] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    t_instr(?alloc, ?b, 1, codegen_mir.MIR_XOR, ?use[0], 3, 2);
    f.blocks      = ?b;
    f.block_count = 1;

    var mach: Machine        = t_mach(1, 2);
    val r:    err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel r.err)          { ret 1; }
    if (b.instr_count != 4) { ret 2; }
    val lo: u32 = b.instrs[0].operands[0].vreg.n;
    val hi: u32 = b.instrs[1].operands[0].vreg.n;
    if (b.instrs[0].opcode != codegen_mir.MIR_MOV || b.instrs[0].width != 1)                            { ret 3; }
    if (b.instrs[1].opcode != codegen_mir.MIR_MOV || b.instrs[1].width != 1)                            { ret 3; }
    if (hi != lo + 1)                                                                                   { ret 4; }
    if (b.instrs[0].operands[1].kind != codegen_mir.MIR_OP_PREG || b.instrs[0].operands[1].preg.n != 7) { ret 5; }
    if (b.instrs[1].operands[1].kind != codegen_mir.MIR_OP_PREG || b.instrs[1].operands[1].preg.n != 6) { ret 6; }
    # the use of the joined value reads the same lanes
    if (b.instrs[2].operands[1].vreg.n != lo || b.instrs[3].operands[1].vreg.n != hi) { ret 7; }
    ret 0;
}

# a register-plus-stack split: lane 1 is a stack word, loaded into its lane
test lane_join__loads_a_stack_piece {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 1);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var jn: [3]codegen_mir.MirOperand;
    jn[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    jn[1] = codegen_mir.op_preg(codegen_mir.preg_id(17));
    jn[2] = codegen_mir.op_mem_preg(codegen_mir.preg_id(8), 16);
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_LANE_JOIN, ?jn[0], 3, 2);
    b.instrs[0].src_width = 1;
    f.blocks              = ?b;
    f.block_count         = 1;

    var mach: Machine        = t_mach(1, 2);
    val r:    err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel r.err)                                                                         { ret 1; }
    if (b.instr_count != 2)                                                                { ret 2; }
    if (b.instrs[0].opcode != codegen_mir.MIR_MOV || b.instrs[0].operands[1].preg.n != 17) { ret 3; }
    if (b.instrs[1].opcode != codegen_mir.MIR_LOAD || b.instrs[1].width != 1)              { ret 4; }
    val m: *codegen_mir.MirOperand = ?b.instrs[1].operands[1];
    if (m.kind != codegen_mir.MIR_OP_MEM || m.preg.n != 8 || m.imm != 16)     { ret 5; }
    if (b.instrs[1].operands[0].vreg.n != b.instrs[0].operands[0].vreg.n + 1) { ret 6; }
    ret 0;
}

# a pick names the lane it wants: lane 1 into register 6, lane 0 into a stack
# word, and the wide value's register is never consulted for either
test lane_pick__moves_the_lane_it_names {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 1);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 3);
    var def: [2]codegen_mir.MirOperand;
    def[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    def[1] = codegen_mir.op_imm(0x0102);
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_MOV, ?def[0], 2, 2);
    var p1: [3]codegen_mir.MirOperand;
    p1[0] = codegen_mir.op_preg(codegen_mir.preg_id(6));
    p1[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    p1[2] = codegen_mir.op_imm(1);
    t_instr(?alloc, ?b, 1, codegen_mir.MIR_LANE_PICK, ?p1[0], 3, 1);
    b.instrs[1].src_width = 2;
    var p0: [3]codegen_mir.MirOperand;
    p0[0] = codegen_mir.op_mem_preg(codegen_mir.preg_id(2), 4);
    p0[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    p0[2] = codegen_mir.op_imm(0);
    t_instr(?alloc, ?b, 2, codegen_mir.MIR_LANE_PICK, ?p0[0], 3, 1);
    b.instrs[2].src_width = 2;
    f.blocks              = ?b;
    f.block_count         = 1;

    var mach: Machine        = t_mach(1, 2);
    val r:    err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel r.err)          { ret 1; }
    if (b.instr_count != 4) { ret 2; }
    val lo: u32 = b.instrs[0].operands[0].vreg.n;
    val hi: u32 = b.instrs[1].operands[0].vreg.n;
    if (b.instrs[0].operands[1].imm != 2 || b.instrs[1].operands[1].imm != 1) { ret 3; }
    val mv: *codegen_mir.MirInstr = ?b.instrs[2];
    if (mv.opcode != codegen_mir.MIR_MOV || mv.width != 1)                            { ret 4; }
    if (mv.operands[0].kind != codegen_mir.MIR_OP_PREG || mv.operands[0].preg.n != 6) { ret 5; }
    if (mv.operands[1].vreg.n != hi)                                                  { ret 6; }
    val st: *codegen_mir.MirInstr = ?b.instrs[3];
    if (st.opcode != codegen_mir.MIR_STORE || st.width != 1)                                                    { ret 7; }
    if (st.operands[0].kind != codegen_mir.MIR_OP_MEM || st.operands[0].preg.n != 2 || st.operands[0].imm != 4) { ret 8; }
    if (st.operands[1].vreg.n != lo)                                                                            { ret 9; }
    ret 0;
}

# a pick from an immediate slices it, a pick from memory loads the word k
# lanes in: the value never has to pass through a register first
test lane_pick__reads_an_immediate_or_memory_source {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 0);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 2);
    var pi: [3]codegen_mir.MirOperand;
    pi[0] = codegen_mir.op_preg(codegen_mir.preg_id(6));
    pi[1] = codegen_mir.op_imm(0x0102);
    pi[2] = codegen_mir.op_imm(1);
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_LANE_PICK, ?pi[0], 3, 1);
    b.instrs[0].src_width = 2;
    var pm: [3]codegen_mir.MirOperand;
    pm[0] = codegen_mir.op_preg(codegen_mir.preg_id(7));
    pm[1] = codegen_mir.op_mem_preg(codegen_mir.preg_id(8), 16);
    pm[2] = codegen_mir.op_imm(1);
    t_instr(?alloc, ?b, 1, codegen_mir.MIR_LANE_PICK, ?pm[0], 3, 1);
    b.instrs[1].src_width = 2;
    f.blocks              = ?b;
    f.block_count         = 1;

    var mach: Machine        = t_mach(1, 2);
    val r:    err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel r.err)                                                                                  { ret 1; }
    if (b.instr_count != 2)                                                                         { ret 2; }
    if (b.instrs[0].opcode != codegen_mir.MIR_MOV || b.instrs[0].operands[0].preg.n != 6)           { ret 3; }
    if (b.instrs[0].operands[1].kind != codegen_mir.MIR_OP_IMM || b.instrs[0].operands[1].imm != 1) { ret 4; }
    if (b.instrs[1].opcode != codegen_mir.MIR_LOAD || b.instrs[1].operands[0].preg.n != 7)          { ret 5; }
    val m: *codegen_mir.MirOperand = ?b.instrs[1].operands[1];
    if (m.kind != codegen_mir.MIR_OP_MEM || m.preg.n != 8 || m.imm != 17) { ret 6; }
    ret 0;
}

# a lane op whose pieces do not match its value is an internal error, not a
# partial expansion
test lane_ops__refuse_a_malformed_shape {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var mach: Machine = t_mach(1, 2);

    # one piece for a two-lane value
    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 1);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var jn: [2]codegen_mir.MirOperand;
    jn[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    jn[1] = codegen_mir.op_preg(codegen_mir.preg_id(7));
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_LANE_JOIN, ?jn[0], 2, 2);
    b.instrs[0].src_width = 1;
    f.blocks              = ?b;
    f.block_count         = 1;
    val r1: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (!sel r1.err) { ret 1; }

    # a pick past the last lane
    var g: codegen_mir.MirFunction;
    t_vregs(?alloc, ?g, 1);
    var gb: codegen_mir.MirBlock;
    t_block(?alloc, ?gb, 2);
    var def: [2]codegen_mir.MirOperand;
    def[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    def[1] = codegen_mir.op_imm(0x0102);
    t_instr(?alloc, ?gb, 0, codegen_mir.MIR_MOV, ?def[0], 2, 2);
    var pk: [3]codegen_mir.MirOperand;
    pk[0] = codegen_mir.op_preg(codegen_mir.preg_id(6));
    pk[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    pk[2] = codegen_mir.op_imm(2);
    t_instr(?alloc, ?gb, 1, codegen_mir.MIR_LANE_PICK, ?pk[0], 3, 1);
    gb.instrs[1].src_width = 2;
    g.blocks               = ?gb;
    g.block_count          = 1;
    val r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?g, nil);
    if (!sel r2.err) { ret 2; }
    ret 0;
}

test secret_lanes__stay_secret {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 2);
    f.vregs[0].secret = true;
    f.vregs[1].secret = false;
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 2);
    var seed: [2]codegen_mir.MirOperand;
    seed[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    seed[1] = codegen_mir.op_imm(0x0102);
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_MOV, ?seed[0], 2, 2);
    var mv: [2]codegen_mir.MirOperand;
    mv[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    mv[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    t_instr(?alloc, ?b, 1, codegen_mir.MIR_MOV, ?mv[0], 2, 2);
    f.blocks      = ?b;
    f.block_count = 1;

    var mach:                Machine        = t_mach(1, 2);
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel legalize_function_r.err)             { ret 1; }
    if (b.instr_count != 4 || f.vreg_count != 6) { ret 2; }
    var i: u32 = 2;
    for (i < 4) {
        val dst: u32 = b.instrs[i].operands[0].vreg.n;
        val src: u32 = b.instrs[i].operands[1].vreg.n;
        if (dst < 2 || src < 2)   { ret 3; }
        if (!f.vregs[src].secret) { ret 4; }
        if (f.vregs[dst].secret)  { ret 5; }
        i = i + 1;
    }

    # control: a public wide value legalizes into public lanes
    var g: codegen_mir.MirFunction;
    t_vregs(?alloc, ?g, 2);
    g.vregs[0].secret = false;
    g.vregs[1].secret = false;
    var gb: codegen_mir.MirBlock;
    t_block(?alloc, ?gb, 2);
    t_instr(?alloc, ?gb, 0, codegen_mir.MIR_MOV, ?seed[0], 2, 2);
    t_instr(?alloc, ?gb, 1, codegen_mir.MIR_MOV, ?mv[0], 2, 2);
    g.blocks      = ?gb;
    g.block_count = 1;
    val legalize_function_r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?g, nil);
    if (sel legalize_function_r2.err) { ret 6; }
    i = 0;
    for (i < g.vreg_count) {
        if (g.vregs[i].secret) { ret 7; }
        i = i + 1;
    }
    ret 0;
}

test declassify__keeps_its_barrier_per_lane {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 2);
    f.vregs[0].secret = true;
    f.vregs[1].secret = false;
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 2);
    var seed: [2]codegen_mir.MirOperand;
    seed[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    seed[1] = codegen_mir.op_imm(0x0102);
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_MOV, ?seed[0], 2, 2);
    var dc: [2]codegen_mir.MirOperand;
    dc[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    dc[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    t_instr(?alloc, ?b, 1, codegen_mir.MIR_DECLASSIFY, ?dc[0], 2, 2);
    f.blocks      = ?b;
    f.block_count = 1;

    var mach:                Machine        = t_mach(1, 2);
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel legalize_function_r.err)                                                            { ret 1; }
    if (b.instr_count != 4)                                                                     { ret 2; }
    if (b.instrs[0].opcode != codegen_mir.MIR_MOV || b.instrs[1].opcode != codegen_mir.MIR_MOV) { ret 7; }
    var i: u32 = 2;
    for (i < 4) {
        if (b.instrs[i].opcode != codegen_mir.MIR_DECLASSIFY) { ret 3; }
        if (b.instrs[i].width != 1)                           { ret 4; }
        i = i + 1;
    }

    # control: a plain wide move stays a move
    var g: codegen_mir.MirFunction;
    t_vregs(?alloc, ?g, 2);
    var gb: codegen_mir.MirBlock;
    t_block(?alloc, ?gb, 2);
    t_instr(?alloc, ?gb, 0, codegen_mir.MIR_MOV, ?seed[0], 2, 2);
    t_instr(?alloc, ?gb, 1, codegen_mir.MIR_MOV, ?dc[0], 2, 2);
    g.blocks      = ?gb;
    g.block_count = 1;
    val legalize_function_r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?g, nil);
    if (sel legalize_function_r2.err)                                                             { ret 5; }
    if (gb.instrs[2].opcode != codegen_mir.MIR_MOV || gb.instrs[3].opcode != codegen_mir.MIR_MOV) { ret 6; }
    ret 0;
}

test expand_access__stages_a_runtime_pointer_into_the_address_pair {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 4);
    # the pointer arrives in two registers, stated as its lanes
    var p: [3]codegen_mir.MirOperand;
    p[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    p[1] = codegen_mir.op_preg(codegen_mir.preg_id(4));
    p[2] = codegen_mir.op_preg(codegen_mir.preg_id(5));
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_LANE_JOIN, ?p[0], 3, 2);
    b.instrs[0].src_width = 1;
    var v: [2]codegen_mir.MirOperand;
    v[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    v[1] = codegen_mir.op_imm(0x01020304);
    t_instr(?alloc, ?b, 1, codegen_mir.MIR_MOV, ?v[0], 2, 4);
    var stv: [2]codegen_mir.MirOperand;
    stv[0] = codegen_mir.op_mem_value(codegen_mir.vreg_id(0), 0);
    stv[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    t_instr(?alloc, ?b, 2, codegen_mir.MIR_STORE, ?stv[0], 2, 4);
    var ldv: [2]codegen_mir.MirOperand;
    ldv[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    ldv[1] = codegen_mir.op_mem_value(codegen_mir.vreg_id(0), 3);
    t_instr(?alloc, ?b, 3, codegen_mir.MIR_LOAD, ?ldv[0], 2, 1);
    f.blocks      = ?b;
    f.block_count = 1;

    var mach: Machine        = t_mach(1, 2);
    val r:    err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel r.err)           { ret 1; }
    if (b.instr_count != 15) { ret 1; }

    if (b.instrs[6].operands[0].preg.n != 6) { ret 1; }
    if (b.instrs[7].operands[0].preg.n != 7) { ret 1; }
    var i: u32 = 0;
    for (i < 4) {
        val st: *codegen_mir.MirInstr = ?b.instrs[8 + i];
        if (st.opcode != codegen_mir.MIR_STORE)            { ret 1; }
        if (st.width != 1)                                 { ret 1; }
        if (st.operands[0].kind != codegen_mir.MIR_OP_MEM) { ret 1; }
        if (!codegen_mir.vreg_is_nil(st.operands[0].vreg)) { ret 1; }
        if (st.operands[0].preg.n != 6)                    { ret 1; }
        if (st.operands[0].imm != i::i64)                  { ret 1; }
        i = i + 1;
    }
    if (b.instrs[12].operands[0].preg.n != 6)        { ret 1; }
    if (b.instrs[13].operands[0].preg.n != 7)        { ret 1; }
    if (b.instrs[14].opcode != codegen_mir.MIR_LOAD) { ret 1; }
    if (b.instrs[14].operands[1].preg.n != 6)        { ret 1; }
    if (b.instrs[14].operands[1].imm != 3)           { ret 1; }
    ret 0;
}

#[testing]
fun t_shift_fn(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, b: *codegen_mir.MirBlock,
    op: codegen_mir.MirOpcode, width: u8, count: codegen_mir.MirOperand) {
    t_vregs(alloc, f, 3);
    t_block(alloc, b, 3);
    var mv: [2]codegen_mir.MirOperand;
    mv[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    mv[1] = codegen_mir.op_imm(0x01020304);
    t_instr(alloc, b, 0, codegen_mir.MIR_MOV, ?mv[0], 2, width);
    var mn: [2]codegen_mir.MirOperand;
    mn[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    mn[1] = codegen_mir.op_imm(3);
    t_instr(alloc, b, 1, codegen_mir.MIR_MOV, ?mn[0], 2, 1);
    var sh: [3]codegen_mir.MirOperand;
    sh[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    sh[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    sh[2] = count;
    t_instr(alloc, b, 2, op, ?sh[0], 3, width);
    f.blocks      = b;
    f.block_count = 1;
}

test expand_shift__constant_count_as_a_template {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    var b: codegen_mir.MirBlock;
    t_shift_fn(?alloc, ?f, ?b, codegen_mir.MIR_SHL, 4, codegen_mir.op_imm(3));

    var mach: Machine        = t_mach(1, 2);
    val r:    err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel r.err) { ret 1; }

    if (b.instr_count != 15)                         { ret 1; }
    if (b.instrs[5].opcode != codegen_mir.MIR_SHL)   { ret 1; }
    if (b.instrs[6].opcode != codegen_mir.MIR_SHR_U) { ret 1; }
    if (b.instrs[7].opcode != codegen_mir.MIR_OR)    { ret 1; }
    if (b.instrs[7].operands[0].vreg.n != 10)        { ret 1; }
    if (b.instrs[14].opcode != codegen_mir.MIR_SHL)  { ret 1; }
    if (b.instrs[14].operands[0].vreg.n != 7)        { ret 1; }
    if (b.instrs[14].operands[1].vreg.n != 3)        { ret 1; }
    if (b.instrs[14].operands[2].imm != 3)           { ret 1; }
    var i: u32 = 5;
    for (i < 15) {
        if (b.instrs[i].width != 1)                    { ret 1; }
        if (b.instrs[i].opcode == codegen_mir.MIR_BR)  { ret 1; }
        if (b.instrs[i].opcode == codegen_mir.MIR_CBR) { ret 1; }
        i = i + 1;
    }
    if (f.block_count != 1) { ret 1; }

    var f1: codegen_mir.MirFunction;
    var b1: codegen_mir.MirBlock;
    t_shift_fn(?alloc, ?f1, ?b1, codegen_mir.MIR_SHR_S, 1, codegen_mir.op_imm(3));
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f1, nil);
    if (sel legalize_function_r.err)                  { ret 1; }
    if (b1.instr_count != 3)                          { ret 1; }
    if (b1.instrs[2].opcode != codegen_mir.MIR_SHR_S) { ret 1; }

    var f2: codegen_mir.MirFunction;
    var b2: codegen_mir.MirBlock;
    t_shift_fn(?alloc, ?f2, ?b2, codegen_mir.MIR_SHR_S, 2, codegen_mir.op_imm(3));
    val legalize_function_r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f2, nil);
    if (sel legalize_function_r2.err) { ret 1; }
    if (b2.instr_count != 7)          { ret 1; }

    var f3: codegen_mir.MirFunction;
    var b3: codegen_mir.MirBlock;
    t_shift_fn(?alloc, ?f3, ?b3, codegen_mir.MIR_SHR_S, 2, codegen_mir.op_imm(8));
    val legalize_function_r3: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f3, nil);
    if (sel legalize_function_r3.err)                 { ret 1; }
    if (b3.instr_count != 6)                          { ret 1; }
    if (b3.instrs[3].opcode != codegen_mir.MIR_SHR_S) { ret 1; }
    ret 0;
}

test expand_shift__runtime_count_is_branch_free {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(1, 2);

    var ops: [2]codegen_mir.MirOpcode;
    ops[0] = codegen_mir.MIR_SHL;
    ops[1] = codegen_mir.MIR_SHR_S;
    var k: u32 = 0;
    for (k < 2) {
        var f: codegen_mir.MirFunction;
        var b: codegen_mir.MirBlock;
        t_shift_fn(?alloc, ?f, ?b, ops[k], 4, codegen_mir.op_vreg(codegen_mir.vreg_id(2)));
        val r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
        if (sel r.err)          { ret 1; }
        if (f.block_count != 1) { ret 2; }
        var i: u32 = 0;
        for (i < b.instr_count) {
            if (b.instrs[i].width != 1)                                                                { ret 3; }
            if (b.instrs[i].opcode == codegen_mir.MIR_BR || b.instrs[i].opcode == codegen_mir.MIR_CBR) { ret 4; }
            i = i + 1;
        }
        k = k + 1;
    }
    ret 0;
}

test expand_shift__normalizes_an_out_of_range_count {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(1, 2);

    var f3: codegen_mir.MirFunction;
    var b3: codegen_mir.MirBlock;
    t_shift_fn(?alloc, ?f3, ?b3, codegen_mir.MIR_SHL, 2, codegen_mir.op_imm(3));
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f3, nil);
    if (sel legalize_function_r.err) { ret 1; }

    var f19: codegen_mir.MirFunction;
    var b19: codegen_mir.MirBlock;
    t_shift_fn(?alloc, ?f19, ?b19, codegen_mir.MIR_SHL, 2, codegen_mir.op_imm(19));
    val legalize_function_r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f19, nil);
    if (sel legalize_function_r2.err) { ret 1; }

    if (b19.instr_count != b3.instr_count) { ret 1; }
    var i: u32 = 0;
    for (i < b3.instr_count) {
        if (b19.instrs[i].opcode != b3.instrs[i].opcode)               { ret 1; }
        if (b19.instrs[i].operand_count != b3.instrs[i].operand_count) { ret 1; }
        var k: u32 = 0;
        for (k < b3.instrs[i].operand_count) {
            if (b19.instrs[i].operands[k].kind != b3.instrs[i].operands[k].kind)                       { ret 1; }
            if (b19.instrs[i].operands[k].imm != b3.instrs[i].operands[k].imm)                         { ret 1; }
            if (!codegen_mir.vreg_same(b19.instrs[i].operands[k].vreg, b3.instrs[i].operands[k].vreg)) { ret 1; }
            k = k + 1;
        }
        i = i + 1;
    }
    var f16: codegen_mir.MirFunction;
    var b16: codegen_mir.MirBlock;
    t_shift_fn(?alloc, ?f16, ?b16, codegen_mir.MIR_SHL, 2, codegen_mir.op_imm(16));
    val legalize_function_r3: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f16, nil);
    if (sel legalize_function_r3.err)                { ret 1; }
    if (b16.instr_count != 5)                        { ret 1; }
    if (b16.instrs[3].opcode != codegen_mir.MIR_MOV) { ret 1; }
    if (b16.instrs[4].opcode != codegen_mir.MIR_MOV) { ret 1; }
    ret 0;
}

test expand_shift__inert_on_a_variable_shift_machine {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var sh: [3]codegen_mir.MirOperand;
    sh[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    sh[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    sh[2] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_SHL, ?sh[0], 3, 8);
    f.blocks      = ?b;
    f.block_count = 1;

    val before_ptr:   *codegen_mir.MirInstr = b.instrs;
    val before_vregs: u32                   = f.vreg_count;

    var mach: Machine = t_mach(8, 8);
    mach.var_shift = true;
    val r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel r.err)                    { ret 1; }
    if (b.instrs != before_ptr)       { ret 1; }
    if (b.instr_count != 1)           { ret 1; }
    if (f.vreg_count != before_vregs) { ret 1; }

    mach.var_shift = false;
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel legalize_function_r.err) { ret 1; }
    if (b.instrs == before_ptr)      { ret 1; }
    ret 0;
}

#[testing]
fun t_cmp_fn(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, b: *codegen_mir.MirBlock,
    op: codegen_mir.MirOpcode, width: u8) {
    t_vregs(alloc, f, 3);
    t_block(alloc, b, 3);
    var m1: [2]codegen_mir.MirOperand;
    m1[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    m1[1] = codegen_mir.op_imm(0x0102030405060708);
    t_instr(alloc, b, 0, codegen_mir.MIR_MOV, ?m1[0], 2, width);
    var m2: [2]codegen_mir.MirOperand;
    m2[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    m2[1] = codegen_mir.op_imm(0x1122334455667788);
    t_instr(alloc, b, 1, codegen_mir.MIR_MOV, ?m2[0], 2, width);
    var cm: [3]codegen_mir.MirOperand;
    cm[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    cm[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    cm[2] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    t_instr(alloc, b, 2, op, ?cm[0], 3, width);
    f.blocks      = b;
    f.block_count = 1;
}

test expand_compare__equality_lane_wise {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(1, 2);

    var f: codegen_mir.MirFunction;
    var b: codegen_mir.MirBlock;
    t_cmp_fn(?alloc, ?f, ?b, codegen_mir.MIR_CMP_EQ, 2);
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel legalize_function_r.err) { ret 1; }

    if (b.instr_count != 7)                           { ret 1; }
    if (b.instrs[4].opcode != codegen_mir.MIR_CMP_EQ) { ret 1; }
    if (b.instrs[4].operands[1].vreg.n != 3)          { ret 1; }
    if (b.instrs[4].operands[2].vreg.n != 5)          { ret 1; }
    if (b.instrs[5].opcode != codegen_mir.MIR_CMP_EQ) { ret 1; }
    if (b.instrs[5].operands[1].vreg.n != 4)          { ret 1; }
    if (b.instrs[5].operands[2].vreg.n != 6)          { ret 1; }
    if (b.instrs[6].opcode != codegen_mir.MIR_AND)    { ret 1; }
    if (b.instrs[6].operands[0].vreg.n != 0)          { ret 1; }

    var f2: codegen_mir.MirFunction;
    var b2: codegen_mir.MirBlock;
    t_cmp_fn(?alloc, ?f2, ?b2, codegen_mir.MIR_CMP_NE, 2);
    val legalize_function_r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f2, nil);
    if (sel legalize_function_r2.err)                  { ret 1; }
    if (b2.instr_count != 7)                           { ret 1; }
    if (b2.instrs[4].opcode != codegen_mir.MIR_CMP_NE) { ret 1; }
    if (b2.instrs[5].opcode != codegen_mir.MIR_CMP_NE) { ret 1; }
    if (b2.instrs[6].opcode != codegen_mir.MIR_OR)     { ret 1; }
    if (b2.instrs[6].operands[0].vreg.n != 0)          { ret 1; }

    var i: u32 = 4;
    for (i < 7) {
        if (b.instrs[i].width != 1)                    { ret 1; }
        if (b.instrs[i].opcode == codegen_mir.MIR_BR)  { ret 1; }
        if (b.instrs[i].opcode == codegen_mir.MIR_CBR) { ret 1; }
        i = i + 1;
    }
    if (f.block_count != 1) { ret 1; }
    ret 0;
}

test expand_compare__ordered_as_a_lexicographic_walk {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(1, 2);

    var f: codegen_mir.MirFunction;
    var b: codegen_mir.MirBlock;
    t_cmp_fn(?alloc, ?f, ?b, codegen_mir.MIR_CMP_LT_U, 2);
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel legalize_function_r.err) { ret 1; }

    if (b.instr_count != 9) { ret 1; }

    if (b.instrs[4].opcode != codegen_mir.MIR_CMP_LT_U)                                     { ret 1; }
    if (b.instrs[4].operands[1].vreg.n != 3)                                                { ret 1; }
    if (b.instrs[4].operands[2].vreg.n != 5)                                                { ret 1; }
    if (b.instrs[5].opcode != codegen_mir.MIR_CMP_LT_U)                                     { ret 1; }
    if (b.instrs[5].operands[1].vreg.n != 4)                                                { ret 1; }
    if (b.instrs[6].opcode != codegen_mir.MIR_CMP_EQ)                                       { ret 1; }
    if (b.instrs[6].operands[1].vreg.n != 4)                                                { ret 1; }
    if (b.instrs[7].opcode != codegen_mir.MIR_AND)                                          { ret 1; }
    if (!codegen_mir.vreg_same(b.instrs[7].operands[1].vreg, b.instrs[6].operands[0].vreg)) { ret 1; }
    if (!codegen_mir.vreg_same(b.instrs[7].operands[2].vreg, b.instrs[4].operands[0].vreg)) { ret 1; }
    if (b.instrs[8].opcode != codegen_mir.MIR_OR)                                           { ret 1; }
    if (!codegen_mir.vreg_same(b.instrs[8].operands[1].vreg, b.instrs[5].operands[0].vreg)) { ret 1; }
    if (b.instrs[8].operands[0].vreg.n != 0)                                                { ret 1; }

    var fs: codegen_mir.MirFunction;
    var bs: codegen_mir.MirBlock;
    t_cmp_fn(?alloc, ?fs, ?bs, codegen_mir.MIR_CMP_LT_S, 2);
    val legalize_function_r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?fs, nil);
    if (sel legalize_function_r2.err)                    { ret 1; }
    if (bs.instr_count != 11)                            { ret 1; }
    if (bs.instrs[4].opcode != codegen_mir.MIR_CMP_LT_U) { ret 1; }
    if (bs.instrs[4].operands[1].vreg.n != 3)            { ret 1; }
    if (bs.instrs[5].opcode != codegen_mir.MIR_XOR)      { ret 1; }
    if (bs.instrs[5].operands[1].vreg.n != 4)            { ret 1; }
    if (bs.instrs[5].operands[2].imm != 0x80)            { ret 1; }
    if (bs.instrs[6].opcode != codegen_mir.MIR_XOR)      { ret 1; }
    if (bs.instrs[6].operands[2].imm != 0x80)            { ret 1; }
    if (bs.instrs[7].opcode != codegen_mir.MIR_CMP_LT_U) { ret 1; }
    if (bs.instrs[10].operands[0].vreg.n != 0)           { ret 1; }
    var i: u32 = 0;
    for (i < bs.instr_count) {
        if (bs.instrs[i].opcode == codegen_mir.MIR_CMP_LT_S) { ret 1; }
        if (bs.instrs[i].opcode == codegen_mir.MIR_CMP_LE_S) { ret 1; }
        if (bs.instrs[i].opcode == codegen_mir.MIR_CMP_LE_U) { ret 1; }
        if (bs.instrs[i].opcode == codegen_mir.MIR_BR)       { ret 1; }
        if (bs.instrs[i].opcode == codegen_mir.MIR_CBR)      { ret 1; }
        i = i + 1;
    }

    var fl: codegen_mir.MirFunction;
    var bl: codegen_mir.MirBlock;
    t_cmp_fn(?alloc, ?fl, ?bl, codegen_mir.MIR_CMP_LE_U, 2);
    val legalize_function_r3: err[fail.Fail] = legalize_function(?alloc, ?mach, ?fl, nil);
    if (sel legalize_function_r3.err)                    { ret 1; }
    if (bl.instr_count != 10)                            { ret 1; }
    if (bl.instrs[4].opcode != codegen_mir.MIR_CMP_LT_U) { ret 1; }
    if (bl.instrs[4].operands[1].vreg.n != 5)            { ret 1; }
    if (bl.instrs[4].operands[2].vreg.n != 3)            { ret 1; }
    if (bl.instrs[5].opcode != codegen_mir.MIR_XOR)      { ret 1; }
    if (bl.instrs[5].operands[2].imm != 1)               { ret 1; }
    if (bl.instrs[9].operands[0].vreg.n != 0)            { ret 1; }
    ret 0;
}

test expand_compare__destination_stays_unsplit {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(1, 2);

    var f: codegen_mir.MirFunction;
    var b: codegen_mir.MirBlock;
    t_cmp_fn(?alloc, ?f, ?b, codegen_mir.MIR_CMP_EQ, 8);
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel legalize_function_r.err) { ret 1; }

    var writes_v0: u32 = 0;
    var i:         u32 = 0;
    for (i < b.instr_count) {
        if (b.instrs[i].operands[0].kind == codegen_mir.MIR_OP_VREG &&
            b.instrs[i].operands[0].vreg.n == 0) { writes_v0 = writes_v0 + 1; }
        i = i + 1;
    }
    if (writes_v0 != 1)                                      { ret 1; }
    if (b.instrs[b.instr_count - 1].operands[0].vreg.n != 0) { ret 1; }
    if (b.instrs[b.instr_count - 1].width != 1)              { ret 1; }

    i = 16;
    for (i < b.instr_count) {
        if (b.instrs[i].width != 1) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test expand_compare__refuses_a_physical_destination {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    var mach: Machine = t_mach(1, 2);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 3);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 3);
    var m1: [2]codegen_mir.MirOperand;
    m1[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    m1[1] = codegen_mir.op_imm(0x0102);
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_MOV, ?m1[0], 2, 2);
    var m2: [2]codegen_mir.MirOperand;
    m2[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    m2[1] = codegen_mir.op_imm(0x0304);
    t_instr(?alloc, ?b, 1, codegen_mir.MIR_MOV, ?m2[0], 2, 2);
    var cm: [3]codegen_mir.MirOperand;
    cm[0] = codegen_mir.op_preg(codegen_mir.preg_id(4));
    cm[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    cm[2] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    t_instr(?alloc, ?b, 2, codegen_mir.MIR_CMP_LT_U, ?cm[0], 3, 2);
    f.blocks      = ?b;
    f.block_count = 1;

    val before:              *codegen_mir.MirInstr = b.instrs;
    val legalize_function_r: err[fail.Fail]        = legalize_function(?alloc, ?mach, ?f, nil);
    if (!sel legalize_function_r.err) { ret 1; }
    if (b.instrs != before)           { ret 1; }
    if (b.instr_count != 3)           { ret 1; }
    ret 0;
}

test expand_shift__refuses_a_non_power_of_two_width {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    var b: codegen_mir.MirBlock;
    t_shift_fn(?alloc, ?f, ?b, codegen_mir.MIR_SHL, 3, codegen_mir.op_vreg(codegen_mir.vreg_id(2)));
    var mach:                Machine        = t_mach(1, 2);
    val legalize_function_r: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (!sel legalize_function_r.err) { ret 1; }
    ret 0;
}

test plan_lanes__float_is_not_split {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 2);
    f.vregs[0].class = codegen_mir.REG_CLASS_GP + 1;
    f.vregs[1].class = codegen_mir.REG_CLASS_GP + 1;
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var mv: [2]codegen_mir.MirOperand;
    mv[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    mv[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_MOV, ?mv[0], 2, 8);
    f.blocks      = ?b;
    f.block_count = 1;

    val before_ptr:   *codegen_mir.MirInstr = b.instrs;
    val before_count: u32                   = b.instr_count;
    val before_vregs: u32                   = f.vreg_count;

    var mach: Machine        = t_mach(4, 4);
    val r:    err[fail.Fail] = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel r.err)                     { ret 1; }
    if (b.instrs != before_ptr)        { ret 1; }
    if (b.instr_count != before_count) { ret 1; }
    if (f.vreg_count != before_vregs)  { ret 1; }

    var gf: codegen_mir.MirFunction;
    t_vregs(?alloc, ?gf, 2);
    var gb: codegen_mir.MirBlock;
    t_block(?alloc, ?gb, 1);
    var gi: [2]codegen_mir.MirOperand;
    gi[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    gi[1] = codegen_mir.op_imm(0x0102030405060708);
    t_instr(?alloc, ?gb, 0, codegen_mir.MIR_MOV, ?gi[0], 2, 8);
    gf.blocks      = ?gb;
    gf.block_count = 1;

    val gr: err[fail.Fail] = legalize_function(?alloc, ?mach, ?gf, nil);
    if (sel gr.err)          { ret 1; }
    if (gb.instr_count != 2) { ret 1; }
    if (gf.vreg_count <= 2)  { ret 1; }

    var sf: codegen_mir.MirFunction;
    t_vregs(?alloc, ?sf, 2);
    var sb: codegen_mir.MirBlock;
    t_block(?alloc, ?sb, 1);
    t_instr(?alloc, ?sb, 0, codegen_mir.MIR_MOV, ?gi[0], 2, 8);
    sf.blocks      = ?sb;
    sf.block_count = 1;

    var m8: Machine        = t_mach(1, 2);
    val sr: err[fail.Fail] = legalize_function(?alloc, ?m8, ?sf, nil);
    if (sel sr.err)          { ret 1; }
    if (sb.instr_count != 8) { ret 1; }
    if (sf.vreg_count <= 2)  { ret 1; }
    ret 0;
}

# a double constant bound for a float argument register names no vreg at all,
# so the bank is only visible through the register: it stays one move, never
# two integer halves into fa0 and fa1 (the guess of #3602 on the float bank)
test plan_lanes__float_register_operand_stays_whole {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var f: codegen_mir.MirFunction;
    t_vregs(?alloc, ?f, 0);
    var b: codegen_mir.MirBlock;
    t_block(?alloc, ?b, 1);
    var mv: [2]codegen_mir.MirOperand;
    mv[0] = codegen_mir.op_preg(codegen_mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 10)));
    mv[1] = codegen_mir.op_imm(0x3FC4000000000000);
    t_instr(?alloc, ?b, 0, codegen_mir.MIR_MOV, ?mv[0], 2, 8);
    f.blocks      = ?b;
    f.block_count = 1;

    val before_ptr: *codegen_mir.MirInstr = b.instrs;
    var mach:       Machine               = t_mach(4, 4);
    val r:          err[fail.Fail]        = legalize_function(?alloc, ?mach, ?f, nil);
    if (sel r.err)              { ret 1; }
    if (b.instrs != before_ptr) { ret 2; }
    if (b.instr_count != 1)     { ret 3; }
    if (b.instrs[0].width != 8) { ret 4; }
    ret 0;
}

#[testing]
fun t_has_wide_conv(b: *codegen_mir.MirBlock, lw: u8) bool {
    var i: u32 = 0;
    for (i < b.instr_count) {
        val mi: *codegen_mir.MirInstr = ?b.instrs[i];
        if (is_int_fp_conv(mi.opcode) && conv_int_width(mi) > lw) { ret true; }
        i = i + 1;
    }
    ret false;
}

#[testing]
fun t_conv_fn(alloc: *std_allocator.Allocator, f: *codegen_mir.MirFunction, b: *codegen_mir.MirBlock,
    opcode: codegen_mir.MirOpcode, fp_cls: u32, dw: u8, sw: u8) {
    t_vregs(alloc, f, 3);
    val fp_is_dst: bool = opcode == codegen_mir.MIR_SI_TO_FP || opcode == codegen_mir.MIR_UI_TO_FP;
    if (fp_is_dst) { f.vregs[0].class = fp_cls; }
    or             { f.vregs[1].class = fp_cls; }
    t_block(alloc, b, 2);
    var mv: [2]codegen_mir.MirOperand;
    mv[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    mv[1] = codegen_mir.op_imm(0x0102030405060708);
    t_instr(alloc, b, 0, codegen_mir.MIR_MOV, ?mv[0], 2, 8);
    var cv: [2]codegen_mir.MirOperand;
    cv[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    cv[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    if (fp_is_dst) { cv[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(2)); }
    or             { cv[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2)); }
    t_instr(alloc, b, 1, opcode, ?cv[0], 2, dw);
    b.instrs[1].src_width = sw;
    f.blocks              = b;
    f.block_count         = 1;
}

test expand_conv__open_codes_a_wide_int_float_conversion {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    val fp:   u32     = codegen_mir.REG_CLASS_GP + 1;
    var mach: Machine = t_mach(4, 4);
    mach.fp_class = fp;

    var f1: codegen_mir.MirFunction;
    var b1: codegen_mir.MirBlock;
    t_conv_fn(?alloc, ?f1, ?b1, codegen_mir.MIR_SI_TO_FP, fp, 8, 8);
    val r1: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f1, nil);
    if (sel r1.err)              { ret 1; }
    if (t_has_wide_conv(?b1, 4)) { ret 1; }
    if (f1.vregs[0].class != fp) { ret 1; }

    var f2: codegen_mir.MirFunction;
    var b2: codegen_mir.MirBlock;
    t_conv_fn(?alloc, ?f2, ?b2, codegen_mir.MIR_FP_TO_UI, fp, 8, 8);
    val r2: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f2, nil);
    if (sel r2.err)              { ret 1; }
    if (t_has_wide_conv(?b2, 4)) { ret 1; }

    var f3: codegen_mir.MirFunction;
    var b3: codegen_mir.MirBlock;
    t_conv_fn(?alloc, ?f3, ?b3, codegen_mir.MIR_FP_TO_SI, fp, 8, 8);
    val r3: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f3, nil);
    if (sel r3.err)              { ret 1; }
    if (t_has_wide_conv(?b3, 4)) { ret 1; }

    var f4: codegen_mir.MirFunction;
    var b4: codegen_mir.MirBlock;
    t_conv_fn(?alloc, ?f4, ?b4, codegen_mir.MIR_SI_TO_FP, fp, 4, 8);
    val r4: err[fail.Fail] = legalize_function(?alloc, ?mach, ?f4, nil);
    if (sel r4.err)              { ret 1; }
    if (t_has_wide_conv(?b4, 4)) { ret 1; }

    var f5: codegen_mir.MirFunction;
    var b5: codegen_mir.MirBlock;
    t_conv_fn(?alloc, ?f5, ?b5, codegen_mir.MIR_SI_TO_FP, codegen_mir.REG_CLASS_GP, 8, 8);
    var m8: Machine        = t_mach(1, 2);
    val r5: err[fail.Fail] = legalize_function(?alloc, ?m8, ?f5, nil);
    if (sel r5.ok) { ret 1; }
    ret 0;
}
