use mach.lang.driver.tests.testing.ut_target_sel;

fun ut_manifest_riscv_pair() str {
    ret "[project]\nmach = \">=5\"\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.rv32]\nisa = \"rv32imafdc\"\nos = \"freestanding\"\nabi = \"ilp32d\"\nof = \"elf\"\n\n[target.rv64]\nisa = \"riscv64\"\nos = \"freestanding\"\nabi = \"lp64d\"\nof = \"elf\"\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/uniontest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

fun ut_debug_abs_width(image: *of.ObjectImage, itn: *intern.Interner, section: str) u32 {
    var sec: i32 = -1;
    var s:   u32 = 0;
    for (s < image.section_count) {
        val lo: opt[str] = intern.lookup(itn, image.sections[s].name);
        if (sel lo.some && str_equals(lo.some, section)) { sec = s::i32; }
        s = s + 1;
    }
    if (sec < 0) { ret 0; }

    var widest: u32 = 0;
    var r:      u32 = 0;
    for (r < image.reloc_count) {
        if (of.section_index(image.relocations[r].section) == sec::u32) {
            if (image.relocations[r].kind == of.RK_ABS64)                { widest = 8; }
            or (image.relocations[r].kind == of.RK_ABS32 && widest == 0) { widest = 4; }
        }
        r = r + 1;
    }
    ret widest;
}

fun ut_dwarf_addr_reloc_width(target_name: str, section: str) u32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 0; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 0; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun helper(x: i32) i32 { ret x + 1; }\n#[symbol(\"_start\")]\npub fun start() { val a: i32 = helper(41); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_riscv_pair(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 0;
    }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 0;
    }
    var tsel_16211: manifest.Selection                 = ut_target_sel(target_name);
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_16211);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 0;
    }
    var p: project.Project = pr.ok;

    var width:            u32               = 0;
    val run_sema_pass_r:  err[outcome.Fail] = driver.run_sema_pass(?p);
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel run_sema_pass_r.ok
        && sel run_lower_pass_r.ok) {
        val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        if (mid != session.MODULE_NIL) {
            val me: *project.ModuleEntry = project.module_at(?p, mid::u32);
            if (me.ir_module != nil) {
                var dbg: codegen.DebugInfo;
                dbg.emit = true;
                val pd: res[intern.StrId, A.Error] = intern.intern(?s.interner, "mach test");
                val cd: res[intern.StrId, A.Error] = intern.intern(?s.interner, root);
                if (sel pd.ok) {
                    if (sel cd.ok) {
                        dbg.producer = pd.ok;
                        dbg.comp_dir = cd.ok;
                        val prep: err[fail.Fail] = codegen.prepare_debug(?s);
                        var cg:   res[of.ObjectImage, fail.Fail];
                        if (sel prep.ok) {
                            cg = codegen.codegen_unit(?s, ?p.target, me.ir_module, unit.ir_set_empty(), nil, codegen.PLACEMENT_POLICY_VERSION, dbg, ?s.diags);
                        }
                        if (sel prep.err) { cg = res[of.ObjectImage, fail.Fail].err{prep.err}; }
                        if (sel cg.ok) {
                            var image: of.ObjectImage = cg.ok;
                            width = ut_debug_abs_width(?image, ?s.interner, section);
                            obj.dnit(?image);
                        }
                    }
                }
            }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret width;
}

test produce__address_reloc_matches_pointer_width {
    var bad: bool = false;

    if (ut_dwarf_addr_reloc_width("rv64", ".debug_line") != 8) { bad = true; }
    if (ut_dwarf_addr_reloc_width("rv64", ".debug_info") != 8) { bad = true; }
    if (ut_dwarf_addr_reloc_width("rv32", ".debug_line") != 4) { bad = true; }
    if (ut_dwarf_addr_reloc_width("rv32", ".debug_info") != 4) { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

fun ut_dwarf_nested_inline_debug_build() bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun leaf(x: i32) i32 { ret x + 1; }\nfun a1(x: i32) i32 { ret leaf(x) + leaf(x+1); }\nfun a2(x: i32) i32 { ret leaf(x) + leaf(x+1); }\nfun a3(x: i32) i32 { ret leaf(x) + leaf(x+1); }\nfun a4(x: i32) i32 { ret leaf(x) + leaf(x+1); }\nfun mid(x: i32) i32 { ret a1(x) + a2(x) + a3(x) + a4(x); }\nfun outer(x: i32) i32 { ret mid(x) + mid(x+1) + mid(x+2); }\nfun top(x: i32) i32 { ret outer(x) + outer(x+1) + outer(x+2) + outer(x+3); }\n#[symbol(\"_start\")]\npub fun start() { val a: i32 = top(41) + top(1) + top(2); if (a == 0) { ret; } }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_x64_linux(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret false;
    }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret false;
    }
    var tsel_16282: manifest.Selection                 = ut_target_sel("lx64");
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_16282);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret false;
    }
    var p: project.Project = pr.ok;

    var ok:               bool              = false;
    val run_sema_pass_r:  err[outcome.Fail] = driver.run_sema_pass(?p);
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel run_sema_pass_r.ok
        && sel run_lower_pass_r.ok) {
        val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        if (mid != session.MODULE_NIL) {
            val me: *project.ModuleEntry = project.module_at(?p, mid::u32);
            if (me.ir_module != nil) {
                var preq: pipeline.PipelineRequest;
                preq.module            = me.ir_module;
                preq.target            = ?p.target;
                preq.level             = pipeline.OPT_RELEASE;
                preq.vectorize_enabled = pipeline.VectorizeEnabledOption{v: false};
                preq.simd_require      = pipeline.SimdRequireOption{v: false};
                preq.float_reassoc     = pipeline.FloatReassocOption{v: false};
                preq.interner          = ?s.interner;
                preq.source_map        = ?s.sources;
                preq.diags             = ?s.diags;
                val rp: res[bool, fail.Fail] = pipeline.run(?preq);
                if (sel rp.ok) {
                    var tot_sites: u32 = 0;
                    var fi:        u32 = 0;
                    for (fi < me.ir_module.function_len) {
                        tot_sites = tot_sites + (?me.ir_module.functions[fi]).inline_site_len;
                        fi        = fi + 1;
                    }
                    if (tot_sites > 1) {
                        var dbg: codegen.DebugInfo;
                        dbg.emit = true;
                        val pd: res[intern.StrId, A.Error] = intern.intern(?s.interner, "mach test");
                        val cd: res[intern.StrId, A.Error] = intern.intern(?s.interner, root);
                        if (sel pd.ok) {
                            if (sel cd.ok) {
                                dbg.producer = pd.ok;
                                dbg.comp_dir = cd.ok;
                                val prep: err[fail.Fail] = codegen.prepare_debug(?s);
                                var cg:   res[of.ObjectImage, fail.Fail];
                                if (sel prep.ok) {
                                    cg = codegen.codegen_unit(?s, ?p.target, me.ir_module, unit.ir_set_empty(), nil, codegen.PLACEMENT_POLICY_VERSION, dbg, ?s.diags);
                                }
                                if (sel prep.err) { cg = res[of.ObjectImage, fail.Fail].err{prep.err}; }
                                if (sel cg.ok) {
                                    var image: of.ObjectImage = cg.ok;
                                    ok = image.section_count > 0;
                                    obj.dnit(?image);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret ok;
}

test produce__nested_inline_debug_build_survives_real_inlining {
    if (!ut_dwarf_nested_inline_debug_build()) { ret 1; }
    ret 0;
}

fun ut_fn_symbol_size(image: *of.ObjectImage, itn: *intern.Interner, want: str) u32 {
    var i: u32 = 0;
    for (i < image.symbol_count) {
        val sym: *of.Symbol = ?image.symbols[i];
        if ((sym.flags & of.SYM_OBJ_FLAG_FUNCTION) == 0) {
            i = i + 1;
            cnt;
        }
        val lo: opt[str] = intern.lookup(itn, sym.name);
        if (sel lo.some && str_contains(lo.some, want)) { ret sym.size; }
        i = i + 1;
    }
    ret 0;
}

test pack_symbols__emitted_function_symbol_carries_its_real_length {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun small_a(x: i32) i32 { ret x + 1; }\nfun small_b(x: i32) i32 { ret x + 2; }\n#[symbol(\"_start\")]\npub fun start() { val a: i32 = small_a(1) + small_b(2); if (a == 0) { ret; } }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_x64_linux(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var tsel_16374: manifest.Selection                 = ut_target_sel("lx64");
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(?s, root, ?tsel_16374);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:              i32               = 1;
    val run_sema_pass_r:  err[outcome.Fail] = driver.run_sema_pass(?p);
    val run_lower_pass_r: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel run_sema_pass_r.ok
        && sel run_lower_pass_r.ok) {
        val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        if (mid != session.MODULE_NIL) {
            val me: *project.ModuleEntry = project.module_at(?p, mid::u32);
            if (me.ir_module != nil) {
                var dbg: codegen.DebugInfo;
                dbg.emit = false;
                val cg: res[of.ObjectImage, fail.Fail] = codegen.codegen_unit(?s, ?p.target, me.ir_module, unit.ir_set_empty(), nil, codegen.PLACEMENT_POLICY_VERSION, dbg, ?s.diags);
                if (sel cg.ok) {
                    var image: of.ObjectImage = cg.ok;
                    val sa:    u32            = ut_fn_symbol_size(?image, ?s.interner, "small_a");
                    val sb:    u32            = ut_fn_symbol_size(?image, ?s.interner, "small_b");
                    if (sa > 0 && sa < 64 && sb > 0 && sb < 64) { bad = 0; }
                    obj.dnit(?image);
                }
            }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}
