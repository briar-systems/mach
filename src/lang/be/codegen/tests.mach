#[testing]
fun ut_manifest_riscv_pair() str {
    ret "[project]\nmach = \">=5\"\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.rv32]\nisa = \"rv32imafdc\"\nos = \"freestanding\"\nabi = \"ilp32d\"\nof = \"elf\"\n\n[target.rv64]\nisa = \"riscv64\"\nos = \"freestanding\"\nabi = \"lp64d\"\nof = \"elf\"\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/uniontest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
}

#[testing]
fun ut_debug_abs_width(image: *target_of.ObjectImage, itn: *intern.Interner, section: str) u32 {
    var sec: i32 = -1;
    var s:   u32 = 0;
    for (s < image.section_count) {
        val lo: opt[str] = intern.get(itn, image.sections[s].name);
        if (sel lo.some && str_equals(lo.some, section)) { sec = s::i32; }
        s = s + 1;
    }
    if (sec < 0) { ret 0; }

    var widest: u32 = 0;
    var r:      u32 = 0;
    for (r < image.reloc_count) {
        if (target_of.section_index(image.relocations[r].section) == sec::u32) {
            if (image.relocations[r].kind == target_of.RK_ABS64)                { widest = 8; }
            or (image.relocations[r].kind == target_of.RK_ABS32 && widest == 0) { widest = 4; }
        }
        r = r + 1;
    }
    ret widest;
}

#[testing]
fun ut_dwarf_addr_reloc_width(target_name: str, section: str) u32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 0; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 0; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun helper(x: i32) i32 { ret x + 1; }\n#[symbol(\"_start\")]\npub fun start() { val a: i32 = helper(41); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_riscv_pair(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 0;
    }
    val root:       str                             = root_r.ok;
    var tsel_16211: manifest.Selectors              = ut_target_sel(target_name);
    val pr:         res[project.Project, fail.Fail] = driver.build_project(?s, root, ?tsel_16211);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 0;
    }
    var p: project.Project = pr.ok;

    var width:            u32            = 0;
    val run_sema_pass_r:  err[fail.Fail] = driver.run_sema_pass(?p);
    val run_lower_pass_r: err[fail.Fail] = driver.run_lower_pass(?p);
    if (sel run_sema_pass_r.ok
        && sel run_lower_pass_r.ok) {
        val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        if (!module.is_nil(mid)) {
            val me: *project.ModuleEntry = project.module_at(?p, mid::u32);
            if (me.ir_module != nil) {
                var dbg: codegen.DebugInfo;
                dbg.emit = true;
                val pd: res[intern.StrId, A.Error] = intern.add(?s.interner, "mach test");
                val cd: res[intern.StrId, A.Error] = intern.add(?s.interner, root);
                if (sel pd.ok) {
                    if (sel cd.ok) {
                        dbg.producer = pd.ok;
                        dbg.comp_dir = cd.ok;
                        val cg: res[target_of.ObjectImage, fail.Fail] = codegen.codegen_unit(?s, ?p.target, me.ir_module, mir_unit.ir_set_empty(), nil, dbg, ?s.diags);
                        if (sel cg.ok) {
                            var image: target_of.ObjectImage = cg.ok;
                            width = ut_debug_abs_width(?image, ?s.interner, section);
                            target_of.object_image_dnit(?image);
                        }
                    }
                }
            }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret width;
}

test produce__address_reloc_matches_pointer_width {
    var bad: bool = false;

    if (ut_dwarf_addr_reloc_width("rv64", ".debug_line") != 8) { bad = true; }
    if (ut_dwarf_addr_reloc_width("rv64", ".debug_info") != 8) { bad = true; }
    if (ut_dwarf_addr_reloc_width("rv32", ".debug_line") != 4) { bad = true; }
    if (ut_dwarf_addr_reloc_width("rv32", ".debug_info") != 4) { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

#[testing]
fun ut_fn_symbol_size(image: *target_of.ObjectImage, itn: *intern.Interner, want: str) u32 {
    var i: u32 = 0;
    for (i < image.symbol_count) {
        val sym: *target_of.Symbol = ?image.symbols[i];
        if ((sym.flags & target_of.SYM_OBJ_FLAG_FUNCTION) == 0) {
            i = i + 1;
            cnt;
        }
        val lo: opt[str] = intern.get(itn, sym.name);
        if (sel lo.some && str_contains(lo.some, want)) { ret sym.size; }
        i = i + 1;
    }
    ret 0;
}

test pack_symbols__function_symbol_carries_its_length {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun small_a(x: i32) i32 { ret x + 1; }\nfun small_b(x: i32) i32 { ret x + 2; }\n#[symbol(\"_start\")]\npub fun start() { val a: i32 = small_a(1) + small_b(2); if (a == 0) { ret; } }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_x64_linux(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:       str                             = root_r.ok;
    var tsel_16374: manifest.Selectors              = ut_target_sel("lx64");
    val pr:         res[project.Project, fail.Fail] = driver.build_project(?s, root, ?tsel_16374);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:              i32            = 1;
    val run_sema_pass_r:  err[fail.Fail] = driver.run_sema_pass(?p);
    val run_lower_pass_r: err[fail.Fail] = driver.run_lower_pass(?p);
    if (sel run_sema_pass_r.ok
        && sel run_lower_pass_r.ok) {
        val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        if (!module.is_nil(mid)) {
            val me: *project.ModuleEntry = project.module_at(?p, mid::u32);
            if (me.ir_module != nil) {
                var dbg: codegen.DebugInfo;
                dbg.emit = false;
                val cg: res[target_of.ObjectImage, fail.Fail] = codegen.codegen_unit(?s, ?p.target, me.ir_module, mir_unit.ir_set_empty(), nil, dbg, ?s.diags);
                if (sel cg.ok) {
                    var image: target_of.ObjectImage = cg.ok;
                    val sa:    u32                   = ut_fn_symbol_size(?image, ?s.interner, "small_a");
                    val sb:    u32                   = ut_fn_symbol_size(?image, ?s.interner, "small_b");
                    if (sa > 0 && sa < 64 && sb > 0 && sb < 64) { bad = 0; }
                    target_of.object_image_dnit(?image);
                }
            }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# every tag and pointer the program's debug types describe, rendered as its type die
#[testing]
fun ut_tag_dies(alloc: *A.Allocator, s: *session.Session, irmod: *me_ir.Module, found: *u32, want: *str, n: u32) i32 {
    val table: *ir_debug.Table = ?irmod.debug_types;
    var i:     u32             = 0;
    for (i < table.len) {
        val kind: ir_debug.Kind = table.types[i].kind;
        if (kind == ir_debug.KIND_TAG || kind == ir_debug.KIND_POINTER) {
            val shown: res[str, fail.Fail] = dwarf.t_type_render(s, irmod, ir_debug.id(i));
            if (sel shown.err) { ret 2; }
            var j: u32 = 0;
            for (j < n) {
                if (str_equals(shown.ok, want[j])) { found[j] = found[j] + 1; }
                j = j + 1;
            }
            A.deallocate[u8](alloc, shown.ok::*u8, str_len(shown.ok) + 1);
        }
        i = i + 1;
    }
    ret 0;
}

test produce__describes_a_generic_and_a_plain_tag {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "tag Box[T]: u8 { empty; full: T; }\ntag Reply: u16 { none; value: i64; small: u8; }\n#[symbol(\"_start\")]\npub fun start() {\n    var b: Box[i64] = Box[i64].full{7};\n    var r: Reply = Reply.value{9};\n    val p: *Reply = ?r;\n}\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, ut_manifest_x64_linux(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    var tsel: manifest.Selectors              = ut_target_sel("lx64");
    val pr:   res[project.Project, fail.Fail] = driver.build_project(?s, root_r.ok, ?tsel);
    fs.remove_all(?alloc, root_r.ok);
    if (sel pr.err) { ret 1; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    p.req.debug = true;

    val sema:  err[fail.Fail] = driver.run_sema_pass(?p);
    val lower: err[fail.Fail] = driver.run_lower_pass(?p);
    if (sel sema.err)  { ret 2; }
    if (sel lower.err) { ret 3; }
    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (module.is_nil(mid)) { ret 4; }
    val me: *project.ModuleEntry = project.module_at(?p, mid::u32);
    if (me.ir_module == nil) { ret 5; }

    var want: [3]str;
    want[0] = " 16 {tag@0:enum 1 {empty=0 full=1} full@8:i64}";
    want[1] = "Reply 16 {tag@0:enum 2 {none=0 value=1 small=2} value@8:i64 small@8:u8}";
    want[2] = "*Reply";
    var found: [3]u32;
    found[0] = 0;
    found[1] = 0;
    found[2] = 0;
    val rendered: i32 = ut_tag_dies(?alloc, ?s, me.ir_module, ?found[0], ?want[0], 3);
    if (rendered != 0) { ret 10 + rendered; }
    if (found[0] != 1) { ret 20; }
    if (found[1] != 1) { ret 21; }
    if (found[2] != 1) { ret 22; }
    ret 0;
}
