use p: std.print;
use std.types.size.usize;

# a packed record puts its wider fields at offsets no access width divides
#[packed]
rec Skewed {
    tag:  u8;
    wide: u64;
    mid:  u32;
    half: u16;
}

fun mix(h: u64, v: u64) u64 {
    ret (h ^ v) * 1099511628211;
}

# every local sits below the frame pointer's one-word reach once the pad is laid out
#[noinline]
fun deep_slots(seed: u64) u64 {
    var pad:  [96]u64;
    var a:    u64 = seed + 1;
    var b:    u32 = (seed + 2)::u32;
    var c:    u16 = (seed + 3)::u16;
    var d:    u8  = (seed + 4)::u8;
    var e:    f64 = 1.5;
    var g:    f32 = 2.25;
    var s:    Skewed;
    var tail: [3]u8;
    pad[0]  = a;
    pad[95] = seed;
    s.tag   = d;
    s.wide  = a * 3;
    s.mid   = b + 7;
    s.half  = c + 9;
    tail[0] = d + 1;
    tail[2] = d + 2;

    var i: usize = 1;
    for (i < 95) {
        pad[i] = pad[i - 1] + i::u64;
        i      = i + 1;
    }
    a = a + pad[94];
    b = b + s.mid;
    c = c + s.half;
    e = e + g::f64;

    var h: u64 = 14695981039346656037;
    h = mix(h, a);
    h = mix(h, b::u64);
    h = mix(h, c::u64);
    h = mix(h, d::u64);
    h = mix(h, e::u64);
    h = mix(h, s.tag::u64);
    h = mix(h, s.wide);
    h = mix(h, s.mid::u64);
    h = mix(h, s.half::u64);
    h = mix(h, tail[0]::u64 + tail[2]::u64);
    h = mix(h, pad[95]);
    ret h;
}

# the same fold computed without a deep frame
fun expected(seed: u64) u64 {
    val a0:  u64 = seed + 1;
    var p94: u64 = a0;
    var i:   u64 = 1;
    for (i < 95) {
        p94 = p94 + i;
        i   = i + 1;
    }
    val d:  u8  = (seed + 4)::u8;
    val b0: u32 = (seed + 2)::u32;
    val c0: u16 = (seed + 3)::u16;
    var h:  u64 = 14695981039346656037;
    h = mix(h, a0 + p94);
    h = mix(h, (b0 + b0 + 7)::u64);
    h = mix(h, (c0 + c0 + 9)::u64);
    h = mix(h, d::u64);
    h = mix(h, 3);
    h = mix(h, d::u64);
    h = mix(h, a0 * 3);
    h = mix(h, (b0 + 7)::u64);
    h = mix(h, (c0 + 9)::u64);
    h = mix(h, (d + 1)::u64 + (d + 2)::u64);
    h = mix(h, seed);
    ret h;
}

$if ($mach.build.arch == $mach.arch.aarch64) {
    # the block leaves sp lower until the epilogue, which is legal and makes
    # sp-relative slot addressing after it wrong: the frame must not declare sp fixed
    #[noinline]
    fun deep_slots_after_sp_move(seed: u64) u64 {
        var pad: [64]u64;
        var a:   u64 = seed + 0x1111;
        var b:   u64 = seed + 0x2222;
        var c:   u32 = (seed + 0x3333)::u32;
        var d:   u64 = seed + 0x4444;
        pad[0]  = a;
        pad[63] = b;
        # the block overwrites every allocatable register, so the scalars live
        # across it are spilled to slots below the pad
        asm aarch64 {
            sub sp, sp, 64
            mov x0, 0
            mov x1, 0
            mov x2, 0
            mov x3, 0
            mov x4, 0
            mov x5, 0
            mov x6, 0
            mov x7, 0
            mov x8, 0
            mov x9, 0
            mov x10, 0
            mov x11, 0
            mov x12, 0
            mov x13, 0
            mov x14, 0
            mov x15, 0
            mov x19, 0
            mov x20, 0
            mov x21, 0
            mov x22, 0
            mov x23, 0
            mov x24, 0
            mov x25, 0
            mov x26, 0
            mov x27, 0
            mov x28, 0
        }
        # every scalar was stored before the block and is read after it
        ret a + b + c::u64 + d + pad[0] + pad[63];
    }
}

test deep_slots__round_trip {
    var seed: u64 = 0;
    for (seed < 4) {
        if (deep_slots(seed * 1000003) != expected(seed * 1000003)) { ret 1 + seed::i32; }
        seed = seed + 1;
    }
    ret 0;
}

test deep_slots_after_sp_move__keeps_frame_pointer_addressing {
    $if ($mach.build.arch != $mach.arch.aarch64) {
        p.println("declined: the sp-moving body is written in aarch64 asm");
        ret 0;
    }
    $or {
        if (deep_slots_after_sp_move(10) != 6 * 10 + 0x1111 * 2 + 0x2222 * 2 + 0x3333 + 0x4444) { ret 1; }
        ret 0;
    }
}
