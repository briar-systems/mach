use codegen_mir: mach.lang.be.codegen.mir;
use mach.lang.be.codegen.structure;
use me_ir: mach.lang.me.ir;

pub rec UnitModule {
    ir:  *me_ir.Module;
    mir: *codegen_mir.MirModule;
    # the control-flow structure of each MIR function, in function order, on a
    # target that declares structured_control_flow, nil on any other
    shapes: *structure.Structure;
}

pub rec Unit {
    mods: *UnitModule;
    len:  u32;
    root: u32;
}
