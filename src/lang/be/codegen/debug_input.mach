use std.types.bool.bool;
use std.collections.map;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.be.codegen.mir;
use mach.lang.intern;
use mach.lang.layout;
use mach.lang.me.ir;
use mach.lang.source;
use mach.lang.target.arch;
use semtype: mach.lang.type;

pub def DwarfRegFn: arch.DwarfRegFn;

pub rec DebugTarget {
    arch_id:   u32;
    os_id:     u32;
    abi_id:    u32;
    of_id:     u32;
    dwarf_reg: arch.DwarfRegFn;
    cv_reg:    arch.CvRegFn;
}

pub rec DebugProgram {
    alloc:        *A.Allocator;
    interner:     *intern.Interner;
    types:        *semtype.TypeInterner;
    sources:      *source.SourceMap;
    type_aligns:  *map.Map[u32, u32];
    type_packed:  *map.Map[u32, u32];
    field_epoch:  u32;
    ir_module:    *ir.Module;
    mir_module:   *mir.MirModule;
    layout:       layout.Machine;
    pointer_width: u32;
    dwarf_reg:    DwarfRegFn;
    frame_ptr_reg: i32;
    stack_ptr_reg: i32;
}

pub rec LineRow {
    text_offset: u32;
    sec:         u32;
    loc:         source.SrcLoc;
}

pub rec InlinePc {
    text_offset: u32;
    sec:         u32;
    inline_site: u32;
}

pub rec VarLoc {
    text_offset: u32;
    sec:         u32;
    iid:         u32;
    kind:        u8;
    reg:         i32;
    off:         i64;
    off_storage: bool;
    end_offset:  u32;
    sub_lhs:     u8;
    sub_rhs:     u8;
    reg2:        i32;
    off2:        i64;
    cmp_rel:     u8;
    cmp_signed:  bool;
    cmp_width:   u8;
}
