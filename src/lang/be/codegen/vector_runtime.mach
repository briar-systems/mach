# each lane shifts as the scalar operator does, by a uniform constant, a
# uniform count at run time and a count per lane, including counts at and
# past the lane width, which saturate: 0, or the sign fill for a signed `>>`
test shift__u16x8 {
    val v: u16x8 = u16x8{1, 0x8000, 0x7FFF, 0xA55A, 0xFFFF, 3, 0x4000, 0x8001};
    val k: u16x8 = v << u16x8{5, 5, 5, 5, 5, 5, 5, 5};
    if (!agrees_u16x8(k, v, 5, 1)) { ret 1; }
    val h: u16x8 = v >> u16x8{15, 15, 15, 15, 15, 15, 15, 15};
    if (!agrees_u16x8(h, v, 15, 0)) { ret 2; }
    val counts: [8]u16 = [8]u16{0, 1, 15, 16, 17, 33, 257, 65535};
    var i:      u32    = 0;
    for (i < 8) {
        if (!agrees_u16x8(shift_left_u16x8(v, counts[i]), v, counts[i], 1))  { ret 3; }
        if (!agrees_u16x8(shift_right_u16x8(v, counts[i]), v, counts[i], 0)) { ret 4; }
        i = i + 1;
    }
    val c: u16x8 = u16x8{0, 1, 15, 16, 3, 300, 5, 17};
    if (!agrees_lanes_u16x8(shift_left_lanes_u16x8(v, c), v, c, 1))  { ret 5; }
    if (!agrees_lanes_u16x8(shift_right_lanes_u16x8(v, c), v, c, 0)) { ret 6; }
    ret 0;
}

