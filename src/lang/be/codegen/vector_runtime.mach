        if (!agrees_i64x2(shift_right_i64x2(v, counts[i]), v, counts[i], 0)) { ret 4; }
        i = i + 1;
    }
    val c: i64x2 = i64x2{1, -64};
    if (!agrees_lanes_i64x2(shift_left_lanes_i64x2(v, c), v, c, 1))  { ret 5; }
    if (!agrees_lanes_i64x2(shift_right_lanes_i64x2(v, c), v, c, 0)) { ret 6; }
