# every lane of `r` is the scalar shift of `v`'s lane by `c`
#[testing]
fun agrees_i16x8(r: i16x8, v: i16x8, c: i16, left: u8) u8 {
    if (left != 0) { ret r[0] == shift_left_i16(v[0], c) && r[1] == shift_left_i16(v[1], c) && r[2] == shift_left_i16(v[2], c) && r[3] == shift_left_i16(v[3], c) && r[4] == shift_left_i16(v[4], c) && r[5] == shift_left_i16(v[5], c) && r[6] == shift_left_i16(v[6], c) && r[7] == shift_left_i16(v[7], c); }
    ret r[0] == shift_right_i16(v[0], c) && r[1] == shift_right_i16(v[1], c) && r[2] == shift_right_i16(v[2], c) && r[3] == shift_right_i16(v[3], c) && r[4] == shift_right_i16(v[4], c) && r[5] == shift_right_i16(v[5], c) && r[6] == shift_right_i16(v[6], c) && r[7] == shift_right_i16(v[7], c);
}

# every lane of `r` is the scalar shift of `v`'s lane by `c`'s
#[testing]
fun agrees_lanes_i16x8(r: i16x8, v: i16x8, c: i16x8, left: u8) u8 {
    if (left != 0) { ret r[0] == shift_left_i16(v[0], c[0]) && r[1] == shift_left_i16(v[1], c[1]) && r[2] == shift_left_i16(v[2], c[2]) && r[3] == shift_left_i16(v[3], c[3]) && r[4] == shift_left_i16(v[4], c[4]) && r[5] == shift_left_i16(v[5], c[5]) && r[6] == shift_left_i16(v[6], c[6]) && r[7] == shift_left_i16(v[7], c[7]); }
    ret r[0] == shift_right_i16(v[0], c[0]) && r[1] == shift_right_i16(v[1], c[1]) && r[2] == shift_right_i16(v[2], c[2]) && r[3] == shift_right_i16(v[3], c[3]) && r[4] == shift_right_i16(v[4], c[4]) && r[5] == shift_right_i16(v[5], c[5]) && r[6] == shift_right_i16(v[6], c[6]) && r[7] == shift_right_i16(v[7], c[7]);
}

# each lane shifts as the scalar operator does, by a uniform constant, a
# uniform count at run time and a count per lane, including counts at and
# past the lane width, which saturate: 0, or the sign fill for a signed `>>`
test shift__i16x8 {
    val v: i16x8 = i16x8{1, -32768, 32767, -23206, -1, 3, 16384, -32767};
    val k: i16x8 = v << i16x8{5, 5, 5, 5, 5, 5, 5, 5};
    if (!agrees_i16x8(k, v, 5, 1)) { ret 1; }
    val h: i16x8 = v >> i16x8{15, 15, 15, 15, 15, 15, 15, 15};
    if (!agrees_i16x8(h, v, 15, 0)) { ret 2; }
    val counts: [9]i16 = [9]i16{0, 1, 15, 16, 17, 33, 257, -1, -32768};
    var i:      u32    = 0;
    for (i < 9) {
        if (!agrees_i16x8(shift_left_i16x8(v, counts[i]), v, counts[i], 1))  { ret 3; }
        if (!agrees_i16x8(shift_right_i16x8(v, counts[i]), v, counts[i], 0)) { ret 4; }
        i = i + 1;
    }
    val c: i16x8 = i16x8{0, 1, 15, 16, 3, -1, 5, 17};
    if (!agrees_lanes_i16x8(shift_left_lanes_i16x8(v, c), v, c, 1))  { ret 5; }
    if (!agrees_lanes_i16x8(shift_right_lanes_i16x8(v, c), v, c, 0)) { ret 6; }
    ret 0;
}

