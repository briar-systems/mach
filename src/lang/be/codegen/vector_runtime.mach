    if (b[0] != 300 || b[7] != -300 || b[3] != 3) { ret 2; }
    var c: i32x4 = i32x4{ 0, 1, 2, 3 };
    c[1] = 70000;  c[3] = -70000;
    if (c[0] != 0 || c[1] != 70000 || c[3] != -70000) { ret 3; }
    var d: i64x2 = i64x2{ 0, 1 };
    d[0] = 4294967296;
    if (d[0] != 4294967296 || d[1] != 1) { ret 4; }
    ret 0;
}

