    var le: u16x8 = a <= b;
    if (le[0] != 0 || le[1] != 0 || le[2] != M16 || le[3] != M16) { ret 5; }
    var ge: u16x8 = a >= b;
    if (ge[0] != M16 || ge[1] != M16 || ge[2] != M16 || ge[3] != 0) { ret 6; }
    ret 0;
}

