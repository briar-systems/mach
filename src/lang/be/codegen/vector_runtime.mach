# the (multiply, int, 8) row: packed on arm64, the declared scalar expansion on x64
test arith__integer_multiply_8_bit_lanes {
    val s: i8x16 = multiply_i8x16(
        i8x16{100, -128, -7, 127, -1, 0, 64, -64, 11, -11, 3, 127, -128, 50, -50, 1},
        i8x16{3, -1, 9, 127, -1, 55, 2, 2, 11, -11, -3, -1, 1, 5, 5, 1});
    if (s[0] != 44 || s[1] != -128 || s[2] != -63 || s[3] != 1)     { ret 1; }
    if (s[4] != 1 || s[5] != 0 || s[6] != -128 || s[7] != -128)     { ret 1; }
    if (s[8] != 121 || s[9] != 121 || s[10] != -9 || s[11] != -127) { ret 1; }
    if (s[12] != -128 || s[13] != -6 || s[14] != 6 || s[15] != 1)   { ret 1; }
    val u: u8x16 = multiply_u8x16(
        u8x16{200, 255, 16, 1, 3, 255, 128, 100, 7, 9, 10, 11, 12, 13, 14, 15},
        u8x16{2, 255, 16, 0, 3, 1, 2, 3, 7, 9, 10, 11, 12, 13, 14, 15});
    if (u[0] != 144 || u[1] != 1 || u[2] != 0 || u[3] != 0)           { ret 2; }
    if (u[4] != 9 || u[5] != 255 || u[6] != 0 || u[7] != 44)          { ret 2; }
    if (u[8] != 49 || u[9] != 81 || u[10] != 100 || u[11] != 121)     { ret 2; }
    if (u[12] != 144 || u[13] != 169 || u[14] != 196 || u[15] != 225) { ret 2; }
    ret 0;
}

# the (multiply, int, 32) row: packed on arm64, the declared scalar expansion on x64
test arith__integer_multiply_32_bit_lanes {
    val s: i32x4 = multiply_i32x4(i32x4{100000, -4, 65536, -2147483648}, i32x4{100000, 6, 65536, -1});
    if (s[0] != 1410065408 || s[1] != -24 || s[2] != 0 || s[3] != -2147483648) { ret 1; }
    val u: u32x4 = multiply_u32x4(u32x4{100000, 4294967295, 65536, 3}, u32x4{100000, 4294967295, 65536, 7});
    if (u[0] != 1410065408 || u[1] != 1 || u[2] != 0 || u[3] != 21) { ret 2; }
    ret 0;
}

# the (multiply, int, 64) row: the declared scalar expansion on x64 and arm64
test arith__integer_multiply_64_bit_lanes {
    val s: i64x2 = multiply_i64x2(i64x2{4294967296, 3037000500}, i64x2{4294967296, 3037000500});
    if (s[0] != 0 || s[1] != -9223372036709301616) { ret 1; }
    val t: i64x2 = multiply_i64x2(i64x2{-9223372036854775807, 123456789}, i64x2{-1, -987654321});
    if (t[0] != 9223372036854775807 || t[1] != -121932631112635269) { ret 2; }
    val u: u64x2 = multiply_u64x2(u64x2{18446744073709551615, 4294967296}, u64x2{2, 4294967297});
    if (u[0] != 18446744073709551614 || u[1] != 4294967296) { ret 3; }
    ret 0;
}

# widen-then-multiply (#3462): the fused shapes lower to the target's packed
# widening multiply where its catalog declares one, and every other shape keeps
# the extend-then-multiply path. each lane must match the scalar product of the
# widened lanes, through every lane type's extremes
#[testing]
