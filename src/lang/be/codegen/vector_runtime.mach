fun abi_add_f32x4(a: f32x4, b: f32x4) f32x4 {
    ret a + b;
}

#[testing]
fun abi_add_i32x4(a: i32x4, b: i32x4) i32x4 {
    ret a + b;
}

#[testing]
fun abi_pick(flag: i32, a: i32x4, b: i32x4) i32x4 {
    if (flag != 0) { ret a; }
    ret b;
}

#[testing]
fun abi_sum4(a: i32x4, b: i32x4, c: i32x4, d: i32x4) i32x4 {
    ret ((a + b) + c) + d;
}

test abi__vector_arguments_and_returns {
    var a: f32x4 = f32x4{1.0, 2.0, 3.0, 4.0};
    var b: f32x4 = f32x4{10.0, 20.0, 30.0, 40.0};
    var s: f32x4 = abi_add_f32x4(a, b);
    if (s[0] != 11.0 || s[1] != 22.0 || s[2] != 33.0 || s[3] != 44.0) { ret 1; }

    var ia:   i32x4 = i32x4{65535, 1, 2, 3};
    var ib:   i32x4 = i32x4{1, 1, 1, 1};
    var isum: i32x4 = abi_add_i32x4(ia, ib);
    if (isum[0] != 65536 || isum[1] != 2) { ret 2; }

    var c:  i32x4 = i32x4{5, 6, 7, 8};
    var p0: i32x4 = abi_pick(0, ia, c);
    if (p0[0] != 5 || p0[3] != 8) { ret 3; }
    var q: i32x4 = abi_sum4(ia, ib, c, i32x4{1000, 2000, 3000, 4000});
    if (q[0] != 66541 || q[1] != 2008 || q[2] != 3010 || q[3] != 4012) { ret 4; }
    ret 0;
}

test spill__tree_16_live {
    var v0:  i32x4 = i32x4{65535, 1, 0, 0};
    var v1:  i32x4 = i32x4{1, 2, 0, 0};
    var v2:  i32x4 = i32x4{2, 3, 0, 0};
    var v3:  i32x4 = i32x4{3, 4, 0, 0};
    var v4:  i32x4 = i32x4{4, 5, 0, 0};
    var v5:  i32x4 = i32x4{5, 6, 0, 0};
    var v6:  i32x4 = i32x4{6, 7, 0, 0};
    var v7:  i32x4 = i32x4{7, 8, 0, 0};
    var v8:  i32x4 = i32x4{8, 9, 0, 0};
    var v9:  i32x4 = i32x4{9, 10, 0, 0};
    var v10: i32x4 = i32x4{10, 11, 0, 0};
    var v11: i32x4 = i32x4{11, 12, 0, 0};
    var v12: i32x4 = i32x4{12, 13, 0, 0};
    var v13: i32x4 = i32x4{13, 14, 0, 0};
    var v14: i32x4 = i32x4{14, 15, 0, 0};
    var v15: i32x4 = i32x4{15, 16, 0, 0};
    var fwd: i32x4 = ((((((((((((((v0 + v1) + v2) + v3) + v4) + v5) + v6) + v7) + v8) + v9) + v10) + v11) + v12) + v13) + v14) + v15;
    var rev: i32x4 = ((((((((((((((v15 + v14) + v13) + v12) + v11) + v10) + v9) + v8) + v7) + v6) + v5) + v4) + v3) + v2) + v1) + v0;
    if (fwd[0] != 65655 || fwd[1] != 136)                                             { ret 1; }
    if (rev[0] != 65655 || rev[1] != 136)                                             { ret 2; }
    if (fwd[0] != rev[0] || fwd[1] != rev[1] || fwd[2] != rev[2] || fwd[3] != rev[3]) { ret 3; }
    ret 0;
}

test reinterpret__float_bits_roundtrip {
    var f: f32x4 = f32x4{1.0, -2.0, 3.5, -8.0};
    var u: u32x4 = f:~u32x4;
    if (u[0] != 0x3F800000 || u[1] != 0xC0000000 || u[2] != 0x40600000 || u[3] != 0xC1000000) { ret 1; }
    var g: f32x4 = u:~f32x4;
    if (g[0] != 1.0 || g[1] != -2.0 || g[2] != 3.5 || g[3] != -8.0) { ret 2; }
    var d: f64x2 = f64x2{1.5, -0.5};
    var w: u64x2 = d:~u64x2;
    if (w[0] != 0x3FF8000000000000 || w[1] != 0xBFE0000000000000) { ret 3; }
    var e: f64x2 = w:~f64x2;
    if (e[0] != 1.5 || e[1] != -0.5) { ret 4; }
    ret 0;
}

test reinterpret__f32x4_select_via_mask {
    var a:    f32x4 = f32x4{1.0, -2.0, 3.0, -4.0};
    var b:    f32x4 = f32x4{10.0, 20.0, -30.0, 40.0};
    var mask: u32x4 = u32x4{M32, 0, M32, 0};
    var au:   u32x4 = a:~u32x4;
    var bu:   u32x4 = b:~u32x4;
    var pick: u32x4 = (au & mask) | (bu & ~mask);
    var r:    f32x4 = pick:~f32x4;
    if (r[0] != 1.0 || r[1] != 20.0 || r[2] != 3.0 || r[3] != 40.0) { ret 1; }
    ret 0;
}

#[testing]
fun xc_leaf() f32 {
    ret 1.0;
}

#[testing]
fun xc_clobber(a: f32x4) f32 {
    val s: f32 = a[0] + a[1] + a[2] + a[3];
    val t: f32 = xc_leaf();
    ret s + t;
}

#[testing]
fun xc_survive(v: i32x4, f: f32x4) i32x4 {
    val junk: f32 = xc_clobber(f);
    ret v + i32x4{1, 1, 1, 1};
}

test call__vector_live_across_call {
    var v: i32x4 = i32x4{0x0A0B0C0C, 0x11223343, 0x55667787, 0x7FEEDDCB};
    var f: f32x4 = f32x4{1.0, 2.0, 4.0, 8.0};
    var r: i32x4 = xc_survive(v, f);
    if (r[0] != 0x0A0B0C0D || r[1] != 0x11223344) { ret 1; }
    if (r[2] != 0x55667788 || r[3] != 0x7FEEDDCC) { ret 2; }
    ret 0;
}

