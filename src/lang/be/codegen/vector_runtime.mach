# each lane shifts as the scalar operator does, by a uniform constant, a
# uniform count at run time and a count per lane, including counts at and
# past the lane width, which saturate: 0, or the sign fill for a signed `>>`
test shift__i8x16 {
    val v: i8x16 = i8x16{1, -128, 127, -91, -1, 3, 64, -127, 1, -128, 127, -91, -1, 3, 64, -127};
    val k: i8x16 = v << i8x16{2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2};
    if (!agrees_i8x16(k, v, 2, 1)) { ret 1; }
    val h: i8x16 = v >> i8x16{7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7};
    if (!agrees_i8x16(h, v, 7, 0)) { ret 2; }
    val counts: [10]i8 = [10]i8{0, 1, 7, 8, 9, 16, 33, 127, -1, -128};
    var i:      u32    = 0;
    for (i < 10) {
        if (!agrees_i8x16(shift_left_i8x16(v, counts[i]), v, counts[i], 1))  { ret 3; }
        if (!agrees_i8x16(shift_right_i8x16(v, counts[i]), v, counts[i], 0)) { ret 4; }
        i = i + 1;
    }
    val c: i8x16 = i8x16{0, 1, 7, 8, 3, -1, 5, 9, 0, 1, 7, 8, 3, -1, 5, 9};
    if (!agrees_lanes_i8x16(shift_left_lanes_i8x16(v, c), v, c, 1))  { ret 5; }
    if (!agrees_lanes_i8x16(shift_right_lanes_i8x16(v, c), v, c, 0)) { ret 6; }
    ret 0;
}

