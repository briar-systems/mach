test arith__widening_multiply_8_bit_lanes {
    val a: i8x16  = i8x16{-128, -128, 127, 127, -128, -1, 0, 1, -127, 126, 7, -7, 100, -100, 1, -1};
    val b: i8x16  = i8x16{-128, 127, 127, -128, -1, -128, -128, 127, 3, -5, -128, 127, 2, 100, 0, -1};
    val w: i16x16 = widen_mul_i8x16(a, b);
    if (w[0] != a[0]::i16 * b[0]::i16)    { ret 1; }
    if (w[1] != a[1]::i16 * b[1]::i16)    { ret 1; }
    if (w[2] != a[2]::i16 * b[2]::i16)    { ret 1; }
    if (w[3] != a[3]::i16 * b[3]::i16)    { ret 1; }
    if (w[4] != a[4]::i16 * b[4]::i16)    { ret 1; }
    if (w[5] != a[5]::i16 * b[5]::i16)    { ret 1; }
    if (w[6] != a[6]::i16 * b[6]::i16)    { ret 1; }
    if (w[7] != a[7]::i16 * b[7]::i16)    { ret 1; }
    if (w[8] != a[8]::i16 * b[8]::i16)    { ret 1; }
    if (w[9] != a[9]::i16 * b[9]::i16)    { ret 1; }
    if (w[10] != a[10]::i16 * b[10]::i16) { ret 1; }
    if (w[11] != a[11]::i16 * b[11]::i16) { ret 1; }
    if (w[12] != a[12]::i16 * b[12]::i16) { ret 1; }
    if (w[13] != a[13]::i16 * b[13]::i16) { ret 1; }
    if (w[14] != a[14]::i16 * b[14]::i16) { ret 1; }
    if (w[15] != a[15]::i16 * b[15]::i16) { ret 1; }
    val lo: i16x8 = widen_mul_i8x8(i8x8{a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7]},
        i8x8{b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]});
    val hi: i16x8 = widen_mul_i8x8(i8x8{a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15]},
        i8x8{b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15]});
    if (lo[0] != w[0] || hi[0] != w[8])                   { ret 2; }
    if (lo[1] != w[1] || hi[1] != w[9])                   { ret 2; }
    if (lo[2] != w[2] || hi[2] != w[10])                  { ret 2; }
    if (lo[3] != w[3] || hi[3] != w[11])                  { ret 2; }
    if (lo[4] != w[4] || hi[4] != w[12])                  { ret 2; }
    if (lo[5] != w[5] || hi[5] != w[13])                  { ret 2; }
    if (lo[6] != w[6] || hi[6] != w[14])                  { ret 2; }
    if (lo[7] != w[7] || hi[7] != w[15])                  { ret 2; }
    if (w[0] != 16384 || w[1] != -16256 || w[2] != 16129) { ret 3; }
    val ua: u8x8  = u8x8{255, 255, 0, 255, 128, 1, 200, 17};
    val ub: u8x8  = u8x8{255, 0, 255, 1, 128, 255, 200, 15};
    val u:  u16x8 = widen_mul_u8x8(ua, ub);
    if (u[0] != ua[0]::u16 * ub[0]::u16)                 { ret 4; }
    if (u[1] != ua[1]::u16 * ub[1]::u16)                 { ret 4; }
    if (u[2] != ua[2]::u16 * ub[2]::u16)                 { ret 4; }
    if (u[3] != ua[3]::u16 * ub[3]::u16)                 { ret 4; }
    if (u[4] != ua[4]::u16 * ub[4]::u16)                 { ret 4; }
    if (u[5] != ua[5]::u16 * ub[5]::u16)                 { ret 4; }
    if (u[6] != ua[6]::u16 * ub[6]::u16)                 { ret 4; }
    if (u[7] != ua[7]::u16 * ub[7]::u16)                 { ret 4; }
    if (u[0] != 65025 || u[4] != 16384 || u[6] != 40000) { ret 5; }
    ret 0;
}

test arith__widening_multiply_16_bit_lanes {
    val a: i16x8 = i16x8{-32768, -32768, 32767, -32768, -1, 32767, 300, -3};
    val b: i16x8 = i16x8{-32768, 32767, 32767, -1, -32768, -1, -300, 32767};
    val w: i32x8 = widen_mul_i16x8(a, b);
    if (w[0] != a[0]::i32 * b[0]::i32)                                   { ret 1; }
    if (w[1] != a[1]::i32 * b[1]::i32)                                   { ret 1; }
    if (w[2] != a[2]::i32 * b[2]::i32)                                   { ret 1; }
    if (w[3] != a[3]::i32 * b[3]::i32)                                   { ret 1; }
    if (w[4] != a[4]::i32 * b[4]::i32)                                   { ret 1; }
    if (w[5] != a[5]::i32 * b[5]::i32)                                   { ret 1; }
    if (w[6] != a[6]::i32 * b[6]::i32)                                   { ret 1; }
    if (w[7] != a[7]::i32 * b[7]::i32)                                   { ret 1; }
    if (w[0] != 1073741824 || w[1] != -1073709056 || w[2] != 1073676289) { ret 2; }
    val lo: i32x4 = widen_mul_i16x4(i16x4{a[0], a[1], a[2], a[3]}, i16x4{b[0], b[1], b[2], b[3]});
    val hi: i32x4 = widen_mul_i16x4(i16x4{a[4], a[5], a[6], a[7]}, i16x4{b[4], b[5], b[6], b[7]});
    if (lo[0] != w[0] || hi[0] != w[4]) { ret 3; }
    if (lo[1] != w[1] || hi[1] != w[5]) { ret 3; }
    if (lo[2] != w[2] || hi[2] != w[6]) { ret 3; }
    if (lo[3] != w[3] || hi[3] != w[7]) { ret 3; }
    val ua: u16x8 = u16x8{65535, 65535, 0, 65535, 32768, 1, 40000, 257};
    val ub: u16x8 = u16x8{65535, 0, 65535, 1, 32768, 65535, 40000, 255};
    val u:  u32x8 = widen_mul_u16x8(ua, ub);
    if (u[0] != ua[0]::u32 * ub[0]::u32)                                { ret 4; }
    if (u[1] != ua[1]::u32 * ub[1]::u32)                                { ret 4; }
    if (u[2] != ua[2]::u32 * ub[2]::u32)                                { ret 4; }
    if (u[3] != ua[3]::u32 * ub[3]::u32)                                { ret 4; }
    if (u[4] != ua[4]::u32 * ub[4]::u32)                                { ret 4; }
    if (u[5] != ua[5]::u32 * ub[5]::u32)                                { ret 4; }
    if (u[6] != ua[6]::u32 * ub[6]::u32)                                { ret 4; }
    if (u[7] != ua[7]::u32 * ub[7]::u32)                                { ret 4; }
    if (u[0] != 4294836225 || u[4] != 1073741824 || u[6] != 1600000000) { ret 5; }
    val ul: u32x4 = widen_mul_u16x4(u16x4{ua[0], ua[1], ua[2], ua[3]}, u16x4{ub[0], ub[1], ub[2], ub[3]});
    val uh: u32x4 = widen_mul_u16x4(u16x4{ua[4], ua[5], ua[6], ua[7]}, u16x4{ub[4], ub[5], ub[6], ub[7]});
    if (ul[0] != u[0] || uh[0] != u[4]) { ret 6; }
    if (ul[1] != u[1] || uh[1] != u[5]) { ret 6; }
    if (ul[2] != u[2] || uh[2] != u[6]) { ret 6; }
    if (ul[3] != u[3] || uh[3] != u[7]) { ret 6; }
    # a mixed pair is never fused, and still multiplies the lanes as widened
    val mx: i32x4 = widen_mul_mixed(i16x4{-32768, 32767, -1, 5}, u16x4{65535, 65535, 65535, 0});
    if (mx[0] != -2147450880 || mx[1] != 2147385345 || mx[2] != -65535 || mx[3] != 0) { ret 7; }
    ret 0;
}

test arith__widening_multiply_32_bit_lanes {
    val a: i32x2 = i32x2{-2147483648, -2147483648};
    val b: i32x2 = i32x2{-2147483648, 2147483647};
    val s: i64x2 = widen_mul_i32x2(a, b);
    if (s[0] != a[0]::i64 * b[0]::i64)                               { ret 1; }
    if (s[1] != a[1]::i64 * b[1]::i64)                               { ret 1; }
    if (s[0] != 4611686018427387904 || s[1] != -4611686016279904256) { ret 2; }
    val c: i32x2 = i32x2{2147483647, 123456789};
    val d: i32x2 = i32x2{-1, -987654321};
    val t: i64x2 = widen_mul_i32x2(c, d);
    if (t[0] != c[0]::i64 * d[0]::i64) { ret 3; }
    if (t[1] != c[1]::i64 * d[1]::i64) { ret 3; }
    val ua: u32x2 = u32x2{4294967295, 4294967295};
    val ub: u32x2 = u32x2{4294967295, 2};
    val u:  u64x2 = widen_mul_u32x2(ua, ub);
    if (u[0] != ua[0]::u64 * ub[0]::u64)                    { ret 4; }
    if (u[1] != ua[1]::u64 * ub[1]::u64)                    { ret 4; }
    if (u[0] != 18446744065119617025 || u[1] != 8589934590) { ret 5; }
    val v: u64x2 = widen_mul_u32x2(u32x2{2147483648, 0}, u32x2{2147483648, 4294967295});
    if (v[0] != 4611686018427387904 || v[1] != 0) { ret 6; }
    ret 0;
}

