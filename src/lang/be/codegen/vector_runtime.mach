# every lane of `r` is the scalar shift of `v`'s lane by `c`
#[testing]
fun agrees_u8x16(r: u8x16, v: u8x16, c: u8, left: u8) u8 {
    if (left != 0) { ret r[0] == shift_left_u8(v[0], c) && r[1] == shift_left_u8(v[1], c) && r[2] == shift_left_u8(v[2], c) && r[3] == shift_left_u8(v[3], c) && r[4] == shift_left_u8(v[4], c) && r[5] == shift_left_u8(v[5], c) && r[6] == shift_left_u8(v[6], c) && r[7] == shift_left_u8(v[7], c) && r[8] == shift_left_u8(v[8], c) && r[9] == shift_left_u8(v[9], c) && r[10] == shift_left_u8(v[10], c) && r[11] == shift_left_u8(v[11], c) && r[12] == shift_left_u8(v[12], c) && r[13] == shift_left_u8(v[13], c) && r[14] == shift_left_u8(v[14], c) && r[15] == shift_left_u8(v[15], c); }
    ret r[0] == shift_right_u8(v[0], c) && r[1] == shift_right_u8(v[1], c) && r[2] == shift_right_u8(v[2], c) && r[3] == shift_right_u8(v[3], c) && r[4] == shift_right_u8(v[4], c) && r[5] == shift_right_u8(v[5], c) && r[6] == shift_right_u8(v[6], c) && r[7] == shift_right_u8(v[7], c) && r[8] == shift_right_u8(v[8], c) && r[9] == shift_right_u8(v[9], c) && r[10] == shift_right_u8(v[10], c) && r[11] == shift_right_u8(v[11], c) && r[12] == shift_right_u8(v[12], c) && r[13] == shift_right_u8(v[13], c) && r[14] == shift_right_u8(v[14], c) && r[15] == shift_right_u8(v[15], c);
}

# every lane of `r` is the scalar shift of `v`'s lane by `c`'s
#[testing]
fun agrees_lanes_u8x16(r: u8x16, v: u8x16, c: u8x16, left: u8) u8 {
    if (left != 0) { ret r[0] == shift_left_u8(v[0], c[0]) && r[1] == shift_left_u8(v[1], c[1]) && r[2] == shift_left_u8(v[2], c[2]) && r[3] == shift_left_u8(v[3], c[3]) && r[4] == shift_left_u8(v[4], c[4]) && r[5] == shift_left_u8(v[5], c[5]) && r[6] == shift_left_u8(v[6], c[6]) && r[7] == shift_left_u8(v[7], c[7]) && r[8] == shift_left_u8(v[8], c[8]) && r[9] == shift_left_u8(v[9], c[9]) && r[10] == shift_left_u8(v[10], c[10]) && r[11] == shift_left_u8(v[11], c[11]) && r[12] == shift_left_u8(v[12], c[12]) && r[13] == shift_left_u8(v[13], c[13]) && r[14] == shift_left_u8(v[14], c[14]) && r[15] == shift_left_u8(v[15], c[15]); }
    ret r[0] == shift_right_u8(v[0], c[0]) && r[1] == shift_right_u8(v[1], c[1]) && r[2] == shift_right_u8(v[2], c[2]) && r[3] == shift_right_u8(v[3], c[3]) && r[4] == shift_right_u8(v[4], c[4]) && r[5] == shift_right_u8(v[5], c[5]) && r[6] == shift_right_u8(v[6], c[6]) && r[7] == shift_right_u8(v[7], c[7]) && r[8] == shift_right_u8(v[8], c[8]) && r[9] == shift_right_u8(v[9], c[9]) && r[10] == shift_right_u8(v[10], c[10]) && r[11] == shift_right_u8(v[11], c[11]) && r[12] == shift_right_u8(v[12], c[12]) && r[13] == shift_right_u8(v[13], c[13]) && r[14] == shift_right_u8(v[14], c[14]) && r[15] == shift_right_u8(v[15], c[15]);
}

# each lane shifts as the scalar operator does, by a uniform constant, a
# uniform count at run time and a count per lane, including counts at and
# past the lane width, which saturate: 0, or the sign fill for a signed `>>`
test shift__u8x16 {
    val v: u8x16 = u8x16{1, 0x80, 0x7F, 0xA5, 0xFF, 3, 0x40, 0x81, 1, 0x80, 0x7F, 0xA5, 0xFF, 3, 0x40, 0x81};
    val k: u8x16 = v << u8x16{2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2};
    if (!agrees_u8x16(k, v, 2, 1)) { ret 1; }
    val h: u8x16 = v >> u8x16{7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7};
    if (!agrees_u8x16(h, v, 7, 0)) { ret 2; }
    val counts: [8]u8 = [8]u8{0, 1, 7, 8, 9, 16, 33, 255};
    var i:      u32   = 0;
    for (i < 8) {
        if (!agrees_u8x16(shift_left_u8x16(v, counts[i]), v, counts[i], 1))  { ret 3; }
        if (!agrees_u8x16(shift_right_u8x16(v, counts[i]), v, counts[i], 0)) { ret 4; }
        i = i + 1;
    }
    val c: u8x16 = u8x16{0, 1, 7, 8, 3, 200, 5, 9, 0, 1, 7, 8, 3, 200, 5, 9};
    if (!agrees_lanes_u8x16(shift_left_lanes_u8x16(v, c), v, c, 1))  { ret 5; }
    if (!agrees_lanes_u8x16(shift_right_lanes_u8x16(v, c), v, c, 0)) { ret 6; }
    ret 0;
}

