test "mach.lang.be.codegen.dwarf.emit_var_location:reg_frame_salvage" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var code: i32 = 0;

    var vr: DwVar; vr.loc_kind = VLOC_REG; vr.reg = 5; vr.offset = 0; vr.net = 0; vr.byref = false;
    var b: enc.ByteBuf = enc.buf_init(?alloc);
    emit_var_location(?b, ?vr);
    var e1: [2]u8; e1[0] = 0x01; e1[1] = 0x55;
    if (!buf_eq(?b, ?e1[0], 2)) { code = 1; }
    enc.buf_dnit(?b);

    var vf: DwVar; vf.loc_kind = VLOC_FRAME; vf.reg = 0; vf.offset = -8; vf.net = 0; vf.byref = false;
    var c: enc.ByteBuf = enc.buf_init(?alloc);
    emit_var_location(?c, ?vf);
    var e2: [3]u8; e2[0] = 0x02; e2[1] = 0x91; e2[2] = 0x78;
    if (!buf_eq(?c, ?e2[0], 3)) { code = 1; }
    enc.buf_dnit(?c);

    var vs: DwVar; vs.loc_kind = VLOC_REG; vs.reg = 5; vs.offset = 0; vs.net = 4; vs.byref = false;
    var d: enc.ByteBuf = enc.buf_init(?alloc);
    emit_var_location(?d, ?vs);
    var e3: [4]u8; e3[0] = 0x03; e3[1] = 0x75; e3[2] = 0x04; e3[3] = 0x9F;
    if (!buf_eq(?d, ?e3[0], 4)) { code = 1; }
    enc.buf_dnit(?d);

    var vk: DwVar; vk.loc_kind = VLOC_CONST; vk.reg = 0; vk.offset = 40; vk.net = 2; vk.byref = false;
    var g: enc.ByteBuf = enc.buf_init(?alloc);
    emit_var_location(?g, ?vk);
    var e4: [4]u8; e4[0] = 0x03; e4[1] = 0x11; e4[2] = 0x2A; e4[3] = 0x9F;
    if (!buf_eq(?g, ?e4[0], 4)) { code = 1; }
    enc.buf_dnit(?g);

    var vm: DwVar; vm.loc_kind = VLOC_FRAME; vm.reg = 0; vm.offset = -8; vm.net = 0; vm.byref = true; vm.storage = false;
    var k: enc.ByteBuf = enc.buf_init(?alloc);
    emit_var_location(?k, ?vm);
    var e6: [4]u8; e6[0] = 0x03; e6[1] = 0x91; e6[2] = 0x78; e6[3] = 0x06;
    if (!buf_eq(?k, ?e6[0], 4)) { code = 1; }
    enc.buf_dnit(?k);

    var vn: DwVar; vn.loc_kind = VLOC_FRAME; vn.reg = 0; vn.offset = -8; vn.net = 16; vn.byref = true; vn.storage = false;
    var m: enc.ByteBuf = enc.buf_init(?alloc);
    emit_var_location(?m, ?vn);
    var e7: [6]u8; e7[0] = 0x05; e7[1] = 0x91; e7[2] = 0x78; e7[3] = 0x06; e7[4] = 0x23; e7[5] = 0x10;
    if (!buf_eq(?m, ?e7[0], 6)) { code = 1; }
    enc.buf_dnit(?m);

    var vp: DwVar; vp.loc_kind = VLOC_FRAME; vp.reg = 0; vp.offset = -8; vp.net = 0; vp.byref = true; vp.storage = true;
    var q: enc.ByteBuf = enc.buf_init(?alloc);
    emit_var_location(?q, ?vp);
    var e8: [3]u8; e8[0] = 0x02; e8[1] = 0x91; e8[2] = 0x78;
    if (!buf_eq(?q, ?e8[0], 3)) { code = 1; }
    enc.buf_dnit(?q);
    ret code;
}

test "mach.lang.be.codegen.dwarf.home_eq:agreement" {
    var code: i32 = 0;
    if (!home_eq(VLOC_REG, 5, 0, 0, VLOC_REG, 5, 0, 0)) { code = 1; }
    if (home_eq(VLOC_REG, 5, 0, 0, VLOC_REG, 6, 0, 0))  { code = 1; }
    if (home_eq(VLOC_REG, 5, 0, 0, VLOC_FRAME, 0, -8, 0)) { code = 1; }
    if (home_eq(VLOC_REG, 5, 0, 0, VLOC_REG, 5, 0, 4))  { code = 1; }
    if (!home_eq(VLOC_FRAME, 0, -16, 0, VLOC_FRAME, 0, -16, 0)) { code = 1; }
    if (home_eq(VLOC_FRAME, 0, -16, 0, VLOC_FRAME, 0, -24, 0))  { code = 1; }
    if (!home_eq(VLOC_CONST, 0, 42, 0, VLOC_CONST, 0, 40, 2)) { code = 1; }
    if (home_eq(VLOC_CONST, 0, 42, 0, VLOC_CONST, 0, 7, 0))   { code = 1; }
    if (home_eq(VLOC_CONST, 0, 42, 0, VLOC_REG, 5, 0, 0))     { code = 1; }
    ret code;
}

test "mach.lang.be.codegen.dwarf.classify_var:tiers" {
    var code: i32 = 0;
    var ranges: [8]LocRange;

    ranges[0].start=0; ranges[0].end=4; ranges[0].kind=VLOC_REG; ranges[0].reg=5; ranges[0].off=0; ranges[0].net=0;
    ranges[1].start=4; ranges[1].end=8; ranges[1].kind=VLOC_REG; ranges[1].reg=5; ranges[1].off=0; ranges[1].net=0;
    var v1: DwVar; v1.range_start=0; v1.range_count=2;
    classify_var(?v1, ?ranges[0]);
    if (v1.loc_kind != VLOC_REG || v1.reg != 5 || v1.range_count != 0) { code = 1; }

    ranges[2].start=0; ranges[2].end=4; ranges[2].kind=VLOC_REG; ranges[2].reg=5; ranges[2].off=0; ranges[2].net=0;
    ranges[3].start=4; ranges[3].end=8; ranges[3].kind=VLOC_REG; ranges[3].reg=6; ranges[3].off=0; ranges[3].net=0;
    var v2: DwVar; v2.range_start=2; v2.range_count=2;
    classify_var(?v2, ?ranges[0]);
    if (v2.loc_kind != VLOC_LOCLIST || v2.range_count != 2) { code = 1; }

    ranges[4].start=0; ranges[4].end=4; ranges[4].kind=VLOC_NONE; ranges[4].reg=0; ranges[4].off=0; ranges[4].net=0;
    ranges[5].start=4; ranges[5].end=8; ranges[5].kind=VLOC_NONE; ranges[5].reg=0; ranges[5].off=0; ranges[5].net=0;
    var v3: DwVar; v3.range_start=4; v3.range_count=2;
    classify_var(?v3, ?ranges[0]);
    if (v3.loc_kind != VLOC_NONE || v3.range_count != 0) { code = 1; }

    ranges[6].start=0; ranges[6].end=4; ranges[6].kind=VLOC_FRAME; ranges[6].reg=0; ranges[6].off=-8; ranges[6].net=0;
    ranges[7].start=4; ranges[7].end=8; ranges[7].kind=VLOC_NONE;  ranges[7].reg=0; ranges[7].off=0;  ranges[7].net=0;
    var v4: DwVar; v4.range_start=6; v4.range_count=2;
    classify_var(?v4, ?ranges[0]);
    if (v4.loc_kind != VLOC_FRAME || v4.offset != -8 || v4.range_count != 0) { code = 1; }

    ranges[0].reused = true;
    var v5: DwVar; v5.range_start=0; v5.range_count=1;
    classify_var(?v5, ?ranges[0]);
    if (v5.loc_kind != VLOC_LOCLIST) { code = 1; }
    ranges[0].reused = false;
    ret code;
}

test "mach.lang.be.codegen.dwarf.bound_storage_reuse:same_site_truncates_cross_site_does_not" {
    var code: i32 = 0;
    var vars: [2]DwVar;
    var ranges: [2]LocRange;

    vars[0].inline_site = 0;
    vars[0].byref = false;
    vars[0].range_start = 0; vars[0].range_count = 0;
    vars[1].inline_site = 0;
    vars[1].byref = false;
    vars[1].range_start = 1; vars[1].range_count = 1;
    ranges[1].start=8; ranges[1].end=20; ranges[1].kind=VLOC_REG; ranges[1].reg=5; ranges[1].off=0; ranges[1].net=0; ranges[1].reused=false;
    var rg: LocRange;
    rg.start=0; rg.end=100; rg.kind=VLOC_REG; rg.reg=5; rg.off=0; rg.net=0; rg.reused=false;
    bound_storage_reuse(?vars[0], ?ranges[0], 0, 2, 0, ?rg);
    if (rg.end != 8 || !rg.reused) { code = 1; }

    vars[1].inline_site = 1;
    var rg2: LocRange;
    rg2.start=0; rg2.end=100; rg2.kind=VLOC_REG; rg2.reg=5; rg2.off=0; rg2.net=0; rg2.reused=false;
    bound_storage_reuse(?vars[0], ?ranges[0], 0, 2, 0, ?rg2);
    if (rg2.end != 100 || rg2.reused) { code = 1; }
    ret code;
}

