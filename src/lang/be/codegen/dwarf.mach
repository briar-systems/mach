    var nrel: u32 = 0;
    var b: enc.ByteBuf = enc.buf_init(?alloc);
    build_loclists(?b, ?funcs[0], 1, ?vars[0], ?ranges[0], 8, ?relocs[0], ?nrel, 4);

    var e: [32]u8;
    e[0]=0x1C; e[1]=0x00; e[2]=0x00; e[3]=0x00;
    e[4]=0x05; e[5]=0x00;
    e[6]=0x08; e[7]=0x00;
    e[8]=0x00; e[9]=0x00; e[10]=0x00; e[11]=0x00;
    e[12]=0x06;
    e[13]=0x00; e[14]=0x00; e[15]=0x00; e[16]=0x00; e[17]=0x00; e[18]=0x00; e[19]=0x00; e[20]=0x00;
    e[21]=0x04; e[22]=0x00; e[23]=0x04; e[24]=0x01; e[25]=0x55;
    e[26]=0x04; e[27]=0x04; e[28]=0x08; e[29]=0x01; e[30]=0x56;
    e[31]=0x00;
    val ok: bool = buf_eq(?b, ?e[0], 32);
    enc.buf_dnit(?b);
    if (!ok) { code = 1; }
    if (nrel != 1) { code = 1; }
    if (relocs[0].off != 13) { code = 1; }
    if (vars[0].loclist_off != 12) { code = 1; }
    ret code;
}

test "mach.lang.be.codegen.dwarf.build_rnglists:ranges" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var code: i32 = 0;

    var funcs: [1]DwFunc;
