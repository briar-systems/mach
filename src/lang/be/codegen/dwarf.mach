fun home_eq(k1: u8, r1: i32, o1: i64, n1: i64, k2: u8, r2: i32, o2: i64, n2: i64) bool {
    if (k1 != k2) { ret false; }
    if (k1 == VLOC_CMP || k2 == VLOC_CMP) { ret false; }
    if (k1 == VLOC_REG)   { ret r1 == r2 && n1 == n2; }
    if (k1 == VLOC_FRAME) { ret o1 == o2 && n1 == n2; }
    if (k1 == VLOC_CONST) { ret o1 + n1 == o2 + n2; }
    ret true;
}

val TK_BASE:    u8 = 0;
val TK_STRUCT:  u8 = 1;
val TK_UNION:   u8 = 2;
val TK_ARRAY:   u8 = 3;
val TK_POINTER: u8 = 4;
val TK_VECTOR:  u8 = 5;

rec TypeDie {
    kind:       u8;
    off:        u32;
    sem:        semtype.TypeId;
    name:       str;
    name_off:   u32;
    encoding:   u8;
    byte_size:  u32;
    elem:       i32;
    count:      u32;
    memb_start: u32;
    memb_count: u32;
}

rec TypeMember {
    name_off: u32;
    type_ix:  u32;
    offset:   u32;
}

rec TypeFixup {
    pos:    u32;
    target: u32;
}

rec TypeCtx {
    alloc:    *A.Allocator;
    types:    *TypeDie;
    ntypes:   u32;
    type_cap: u32;
    membs:    *TypeMember;
    nmemb:    u32;
    memb_cap: u32;
}

fun type_ctx_init(alloc: *A.Allocator) TypeCtx {
    var tc: TypeCtx;
    tc.alloc    = alloc;
    tc.types    = nil;
    tc.ntypes   = 0;
    tc.type_cap = 0;
    tc.membs    = nil;
    tc.nmemb    = 0;
    tc.memb_cap = 0;
    ret tc;
}

fun type_ctx_dnit(tc: *TypeCtx) {
    if (tc.types != nil) { A.deallocate[TypeDie](tc.alloc, tc.types, tc.type_cap::usize); tc.types = nil; }
    if (tc.membs != nil) { A.deallocate[TypeMember](tc.alloc, tc.membs, tc.memb_cap::usize); tc.membs = nil; }
}

fun type_reserve(tc: *TypeCtx) bool {
    if (tc.ntypes < tc.type_cap) { ret true; }
    if (tc.type_cap == 0) {
        val ra: R.Result[*TypeDie, str] = A.allocate[TypeDie](tc.alloc, 8::usize);
        if (R.is_err[*TypeDie, str](ra)) { ret false; }
        tc.types    = R.unwrap_ok[*TypeDie, str](ra);
        tc.type_cap = 8;
        ret true;
    }
    val doubled: R.Result[layout.CheckedCount[TypeDie], layout.CheckCause] =
        layout.count_mul[TypeDie](layout.count[TypeDie](tc.type_cap::usize), 2::usize);
    if (R.is_err[layout.CheckedCount[TypeDie], layout.CheckCause](doubled)) { ret false; }
    val fits: R.Result[u32, layout.CheckCause] =
        layout.usize_to_u32(R.unwrap_ok[layout.CheckedCount[TypeDie], layout.CheckCause](doubled).value);
    if (R.is_err[u32, layout.CheckCause](fits)) { ret false; }
    val new_cap: u32 = R.unwrap_ok[u32, layout.CheckCause](fits);
    val rr: R.Result[*TypeDie, str] = A.reallocate[TypeDie](tc.alloc, tc.types, tc.type_cap::usize, new_cap::usize);
    if (R.is_err[*TypeDie, str](rr)) { ret false; }
    tc.types    = R.unwrap_ok[*TypeDie, str](rr);
    tc.type_cap = new_cap;
    ret true;
}

fun memb_reserve(tc: *TypeCtx) bool {
    if (tc.nmemb < tc.memb_cap) { ret true; }
    if (tc.memb_cap == 0) {
        val ra: R.Result[*TypeMember, str] = A.allocate[TypeMember](tc.alloc, 16::usize);
        if (R.is_err[*TypeMember, str](ra)) { ret false; }
        tc.membs    = R.unwrap_ok[*TypeMember, str](ra);
        tc.memb_cap = 16;
        ret true;
    }
    val doubled: R.Result[layout.CheckedCount[TypeMember], layout.CheckCause] =
        layout.count_mul[TypeMember](layout.count[TypeMember](tc.memb_cap::usize), 2::usize);
    if (R.is_err[layout.CheckedCount[TypeMember], layout.CheckCause](doubled)) { ret false; }
    val fits: R.Result[u32, layout.CheckCause] =
        layout.usize_to_u32(R.unwrap_ok[layout.CheckedCount[TypeMember], layout.CheckCause](doubled).value);
    if (R.is_err[u32, layout.CheckCause](fits)) { ret false; }
    val new_cap: u32 = R.unwrap_ok[u32, layout.CheckCause](fits);
    val rr: R.Result[*TypeMember, str] = A.reallocate[TypeMember](tc.alloc, tc.membs, tc.memb_cap::usize, new_cap::usize);
    if (R.is_err[*TypeMember, str](rr)) { ret false; }
    tc.membs    = R.unwrap_ok[*TypeMember, str](rr);
    tc.memb_cap = new_cap;
    ret true;
}

rec StrTab {
    buf: enc.ByteBuf;
}

fun str_off(st: *StrTab, s: str) u32 {
    var i: usize = 0;
    for (i < st.buf.len) {
        val start: usize = i;
        for (i < st.buf.len && st.buf.data[i] != 0) { i = i + 1; }
        if (bytes_eq_str(?st.buf, start, i, s)) { ret start::u32; }
        i = i + 1;
    }
    val off: u32 = st.buf.len::u32;
    emit_cstr(?st.buf, s);
    ret off;
}

fun bytes_eq_str(b: *enc.ByteBuf, start: usize, end: usize, s: str) bool {
    val n: usize = str_len(s);
    if (end - start != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (b.data[start + i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

val IRLT_SYM:     u8 = 0;
val IRLT_STR:     u8 = 1;
val IRLT_LOCLIST: u8 = 2;
val IRLT_RNGLIST: u8 = 3;

rec InfoReloc {
    off:    u32;
    kind:   of.RelocKind;
    target: u8;
    sym:    intern.StrId;
    addend: i64;
}

fun push_info_reloc(list: *InfoReloc, count: *u32, cap: u32, off: u32, kind: of.RelocKind,
                    target: u8, sym: intern.StrId, addend: i64) {
    if (@count >= cap) { panic("dwarf: info relocation capacity exceeded\n"); }
    list[@count].off    = off;
    list[@count].kind   = kind;
    list[@count].target = target;
    list[@count].sym    = sym;
    list[@count].addend = addend;
    @count = @count + 1;
}

rec LocReloc {
    off: u32;
    sym: intern.StrId;
}

fun push_loc_reloc(list: *LocReloc, count: *u32, cap: u32, off: u32, sym: intern.StrId) {
    if (@count >= cap) { panic("dwarf: location relocation capacity exceeded\n"); }
    list[@count].off = off;
    list[@count].sym = sym;
    @count = @count + 1;
}

rec RngReloc {
    off: u32;
    sym: intern.StrId;
}

fun push_rng_reloc(list: *RngReloc, count: *u32, cap: u32, off: u32, sym: intern.StrId) {
    if (@count >= cap) { panic("dwarf: range relocation capacity exceeded\n"); }
    list[@count].off = off;
    list[@count].sym = sym;
    @count = @count + 1;
}

fun debug_type_align(s: *debug_input.DebugProgram, tid: u32) O.Option[u32] {
    if (s.type_aligns == nil) { ret O.none[u32](); }
    val res: R.Result[*u32, str] = map.get[u32, u32](s.type_aligns, ?tid);
    if (R.is_err[*u32, str](res)) { ret O.none[u32](); }
    ret O.some[u32](@R.unwrap_ok[*u32, str](res));
}

fun debug_type_is_packed(s: *debug_input.DebugProgram, tid: u32) bool {
    if (s.type_packed == nil) { ret false; }
    ret R.is_ok[*u32, str](map.get[u32, u32](s.type_packed, ?tid));
}

fun sem_base_type(s: *debug_input.DebugProgram, tid: semtype.TypeId, address_size: u8) O.Option[TypeDie] {
    if (tid == semtype.TYPE_NIL || tid == semtype.TYPE_ERROR) { ret O.none[TypeDie](); }
    val to: O.Option[*semtype.Type] = semtype.get(s.types, semtype.strip_secret(s.types, tid));
    if (O.is_none[*semtype.Type](to)) { ret O.none[TypeDie](); }
    ret base_die_of_kind(O.unwrap[*semtype.Type](to).kind, address_size);
}

fun base_die_of_kind(kind: semtype.TypeKind, address_size: u8) O.Option[TypeDie] {
    val d: semtype.PrimDesc = semtype.prim_desc(kind);
    if (d.class == semtype.PRIM_CLASS_NONE) { ret O.none[TypeDie](); }

    var bt: TypeDie;
    bt.kind       = TK_BASE;
    bt.name       = semtype.prim_name(kind);
    bt.sem        = semtype.TYPE_NIL;
    bt.off        = 0;
    bt.name_off   = 0;
    bt.elem       = -1;
    bt.count      = 0;
    bt.memb_start = 0;
    bt.memb_count = 0;
    if (d.class == semtype.PRIM_CLASS_FLOAT) {
        bt.encoding  = DW_ATE_float;
        bt.byte_size = (d.bits / 8)::u32;
    } or (d.class == semtype.PRIM_CLASS_PTR) {
        bt.encoding  = DW_ATE_address;
        bt.byte_size = address_size::u32;
    } or {
        if (d.signed) { bt.encoding = DW_ATE_signed; } or { bt.encoding = DW_ATE_unsigned; }
        bt.byte_size = (d.bits / 8)::u32;
    }
    ret O.some[TypeDie](bt);
}

fun sem_to_ir(s: *debug_input.DebugProgram, dtypes: *ir_type.IrTypeTable, sem: semtype.TypeId) R.Result[ir_type.IrTypeId, str] {
    if (sem == semtype.TYPE_NIL) { ret ir_type.intern_void(dtypes); }
    val to: O.Option[*semtype.Type] = semtype.get(s.types, sem);
    if (O.is_none[*semtype.Type](to)) { ret ir_type.intern_void(dtypes); }
    val t: *semtype.Type = O.unwrap[*semtype.Type](to);
    val k: semtype.TypeKind = t.kind;

    if (k == semtype.TYPE_SECRET) { ret sem_to_ir(s, dtypes, t.data.secret.base); }

    val d: semtype.PrimDesc = semtype.prim_desc(k);
    if (d.class == semtype.PRIM_CLASS_INT)   { ret ir_type.intern_int(dtypes, d.bits); }
    if (d.class == semtype.PRIM_CLASS_FLOAT) { ret ir_type.intern_float(dtypes, d.bits); }
    if (d.class == semtype.PRIM_CLASS_PTR)   { ret ir_type.intern_ptr(dtypes); }
    if (k == semtype.TYPE_POINTER)           { ret ir_type.intern_ptr(dtypes); }

    if (k == semtype.TYPE_ARRAY) {
        val ebase: semtype.TypeId = t.data.array.base;
        val ecount: u32 = t.data.array.count;
        val rb: R.Result[ir_type.IrTypeId, str] = sem_to_ir(s, dtypes, ebase);
        if (R.is_err[ir_type.IrTypeId, str](rb)) { ret rb; }
        ret ir_type.intern_array(dtypes, R.unwrap_ok[ir_type.IrTypeId, str](rb), ecount);
    }

    if (k == semtype.TYPE_VECTOR) {
        val ed: semtype.PrimDesc = semtype.prim_desc(t.data.vector.element);
        val lanes: u32 = t.data.vector.lanes;
        var res_elem: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(dtypes, ed.bits);
        if (ed.class == semtype.PRIM_CLASS_FLOAT) { res_elem = ir_type.intern_float(dtypes, ed.bits); }
        if (R.is_err[ir_type.IrTypeId, str](res_elem)) { ret res_elem; }
        ret ir_type.intern_vector(dtypes, R.unwrap_ok[ir_type.IrTypeId, str](res_elem), lanes);
    }

    if (k == semtype.TYPE_REC || k == semtype.TYPE_UNI || k == semtype.TYPE_INSTANCE) {
        ret sem_to_ir_nominal(s, dtypes, sem, semtype.is_union(s.types, sem));
    }

    ret ir_type.intern_ptr(dtypes);
}

fun sem_to_ir_nominal(s: *debug_input.DebugProgram, dtypes: *ir_type.IrTypeTable, tid: semtype.TypeId, is_union: bool) R.Result[ir_type.IrTypeId, str] {
    val t: O.Option[*semtype.Type] = semtype.get(s.types, tid);
    if (O.is_some[*semtype.Type](t) && O.unwrap[*semtype.Type](t).kind == semtype.TYPE_INSTANCE) {
        val ft: O.Option[*semtype.FieldTable] = semtype.field_table_for(s.types, tid);
        if (O.is_none[*semtype.FieldTable](ft)
            || O.unwrap[*semtype.FieldTable](ft).epoch != s.field_epoch) {
            ret R.err[ir_type.IrTypeId, str]("dwarf.sem_to_ir: instance field table was not finalized for debug production");
        }
    }
    var nom_align: u32 = 0;
    val ta: O.Option[u32] = debug_type_align(s, tid::u32);
    val nom_packed: bool = debug_type_is_packed(s, tid::u32);
    if (O.is_some[u32](ta)) { nom_align = O.unwrap[u32](ta); }

    val fields_len: u32 = semtype.field_count(s.types, tid);
    if (fields_len == 0) {
        if (is_union) { ret ir_type.intern_union(dtypes, nil, 0, nom_align, nom_packed); }
        ret ir_type.intern_struct(dtypes, nil, 0, nom_align, nom_packed);
    }

    val rbuf: R.Result[*ir_type.IrTypeId, str] = A.allocate[ir_type.IrTypeId](s.alloc, fields_len::usize);
    if (R.is_err[*ir_type.IrTypeId, str](rbuf)) { ret R.err[ir_type.IrTypeId, str](R.unwrap_err[*ir_type.IrTypeId, str](rbuf)); }
    val buf: *ir_type.IrTypeId = R.unwrap_ok[*ir_type.IrTypeId, str](rbuf);

    var i: u32 = 0;
    for (i < fields_len) {
        val fe: O.Option[*semtype.FieldEntry] = semtype.field_at(s.types, tid, i);
        if (O.is_none[*semtype.FieldEntry](fe)) {
            A.deallocate[ir_type.IrTypeId](s.alloc, buf, fields_len::usize);
            ret R.err[ir_type.IrTypeId, str]("dwarf.sem_to_ir: corrupt field table");
        }
        val rf: R.Result[ir_type.IrTypeId, str] = sem_to_ir(s, dtypes, O.unwrap[*semtype.FieldEntry](fe).ty);
        if (R.is_err[ir_type.IrTypeId, str](rf)) {
            A.deallocate[ir_type.IrTypeId](s.alloc, buf, fields_len::usize);
            ret rf;
        }
        buf[i] = R.unwrap_ok[ir_type.IrTypeId, str](rf);
        i = i + 1;
    }

    var res: R.Result[ir_type.IrTypeId, str];
    if (is_union) { res = ir_type.intern_union(dtypes, buf, fields_len, nom_align, nom_packed); }
    or            { res = ir_type.intern_struct(dtypes, buf, fields_len, nom_align, nom_packed); }
    A.deallocate[ir_type.IrTypeId](s.alloc, buf, fields_len::usize);
    ret res;
}

fun frame_base_reg(tgt: *debug_input.DebugProgram) i32 {
    val f: debug_input.DwarfRegFn = tgt.dwarf_reg;
    if (f == nil) { ret -1; }
    ret f(tgt.frame_ptr_reg);
}

fun frame_base_omit_reg(tgt: *debug_input.DebugProgram) i32 {
    val f: debug_input.DwarfRegFn = tgt.dwarf_reg;
    if (f == nil) { ret -1; }
    ret f(tgt.stack_ptr_reg);
}

val MAX_FILES: u32 = 256;

rec FileTable {
    ids:   [256]source.FileId;
    count: u32;
}

fun file_index(ft: *FileTable, id: source.FileId) i32 {
    val hit: i32 = file_slot(ft, id);
    if (hit >= 0) { ret hit; }
    if (ft.count >= MAX_FILES) { ret -1; }
    ft.ids[ft.count] = id;
    ft.count = ft.count + 1;
    ret ft.count::i32;
}

fun file_slot(ft: *FileTable, id: source.FileId) i32 {
    var i: u32 = 0;
    for (i < ft.count) {
        if (ft.ids[i] == id) { ret (i + 1)::i32; }
        i = i + 1;
    }
    ret -1;
}

fun copy_exact(alloc: *A.Allocator, b: *enc.ByteBuf) R.Result[*u8, str] {
    if (b.len == 0) { ret R.ok[*u8, str](nil); }
    val r: R.Result[*u8, str] = A.allocate[u8](alloc, b.len);
    if (R.is_err[*u8, str](r)) { ret r; }
    val out: *u8 = R.unwrap_ok[*u8, str](r);
    var i: usize = 0;
    for (i < b.len) { out[i] = b.data[i]; i = i + 1; }
    ret R.ok[*u8, str](out);
}

fun add_debug_section(image: *of.ObjectImage, name: intern.StrId, b: *enc.ByteBuf) R.Result[u32, str] {
    val rb: R.Result[*u8, str] = copy_exact(image.alloc, b);
    if (R.is_err[*u8, str](rb)) { ret R.err[u32, str](R.unwrap_err[*u8, str](rb)); }
    var sec: of.Section;
    sec.name  = name;
    sec.kind  = of.SK_DEBUG;
    sec.bytes = R.unwrap_ok[*u8, str](rb);
    sec.len   = b.len::u32;
    sec.align = 1;
    sec.flags = 0;
    val added: R.Result[u32, str] = obj.install_section(image, ?sec);
    ret added;
}

fun emit_attr(b: *enc.ByteBuf, at: u8, form: u8) {
    uleb(b, at::u64);
    uleb(b, form::u64);
}

fun build_abbrev(b: *enc.ByteBuf) {
    uleb(b, ABBREV_CU::u64);
    uleb(b, DW_TAG_compile_unit::u64);
    enc.emit_byte(b, DW_CHILDREN_yes);
    emit_attr(b, DW_AT_producer, DW_FORM_string);
    emit_attr(b, DW_AT_name,     DW_FORM_string);
    emit_attr(b, DW_AT_comp_dir, DW_FORM_string);
    emit_attr(b, DW_AT_language, DW_FORM_data2);
    emit_attr(b, DW_AT_ranges,   DW_FORM_sec_offset);
    emit_attr(b, DW_AT_stmt_list, DW_FORM_sec_offset);
    uleb(b, 0); uleb(b, 0);

    uleb(b, ABBREV_BASE_TYPE::u64);
    uleb(b, DW_TAG_base_type::u64);
    enc.emit_byte(b, DW_CHILDREN_no);
    emit_attr(b, DW_AT_name,      DW_FORM_strp);
    emit_attr(b, DW_AT_encoding,  DW_FORM_data1);
    emit_attr(b, DW_AT_byte_size, DW_FORM_data1);
    uleb(b, 0); uleb(b, 0);

    build_subprogram_abbrev(b, ABBREV_SUBPROGRAM, true, true, true);
    build_subprogram_abbrev(b, ABBREV_SUBPROGRAM_VOID, false, true, true);

    build_var_abbrev(b, ABBREV_VARIABLE,       DW_TAG_variable,         true);
    build_var_abbrev(b, ABBREV_VARIABLE_NOLOC, DW_TAG_variable,         false);
    build_var_abbrev(b, ABBREV_PARAM,          DW_TAG_formal_parameter, true);
    build_var_abbrev(b, ABBREV_PARAM_NOLOC,    DW_TAG_formal_parameter, false);

    build_var_loclist_abbrev(b, ABBREV_VARIABLE_LOCLIST, DW_TAG_variable);
    build_var_loclist_abbrev(b, ABBREV_PARAM_LOCLIST,    DW_TAG_formal_parameter);

    uleb(b, ABBREV_SUBPROGRAM_ABSTRACT::u64);
    uleb(b, DW_TAG_subprogram::u64);
    enc.emit_byte(b, DW_CHILDREN_no);
    emit_attr(b, DW_AT_name,   DW_FORM_strp);
    emit_attr(b, DW_AT_inline, DW_FORM_data1);
    uleb(b, 0); uleb(b, 0);

    build_inlined_abbrev(b, ABBREV_INLINED,             false, false);
    build_inlined_abbrev(b, ABBREV_INLINED_RANGES,      true,  false);
    build_inlined_abbrev(b, ABBREV_INLINED_KIDS,        false, true);
    build_inlined_abbrev(b, ABBREV_INLINED_RANGES_KIDS, true,  true);

    build_subprogram_abbrev(b, ABBREV_SUBPROGRAM_LEAF,      true,  false, true);
    build_subprogram_abbrev(b, ABBREV_SUBPROGRAM_VOID_LEAF, false, false, true);

    build_subprogram_abbrev(b, ABBREV_SUBPROGRAM_NOFB,           true,  true,  false);
    build_subprogram_abbrev(b, ABBREV_SUBPROGRAM_VOID_NOFB,      false, true,  false);
    build_subprogram_abbrev(b, ABBREV_SUBPROGRAM_LEAF_NOFB,      true,  false, false);
    build_subprogram_abbrev(b, ABBREV_SUBPROGRAM_VOID_LEAF_NOFB, false, false, false);

    uleb(b, ABBREV_STRUCT::u64);
    uleb(b, DW_TAG_structure_type::u64);
    enc.emit_byte(b, DW_CHILDREN_yes);
    emit_attr(b, DW_AT_name,      DW_FORM_strp);
    emit_attr(b, DW_AT_byte_size, DW_FORM_udata);
    uleb(b, 0); uleb(b, 0);

    uleb(b, ABBREV_UNION::u64);
    uleb(b, DW_TAG_union_type::u64);
    enc.emit_byte(b, DW_CHILDREN_yes);
    emit_attr(b, DW_AT_name,      DW_FORM_strp);
    emit_attr(b, DW_AT_byte_size, DW_FORM_udata);
    uleb(b, 0); uleb(b, 0);

    uleb(b, ABBREV_MEMBER::u64);
    uleb(b, DW_TAG_member::u64);
    enc.emit_byte(b, DW_CHILDREN_no);
    emit_attr(b, DW_AT_name,                 DW_FORM_strp);
    emit_attr(b, DW_AT_type,                 DW_FORM_ref4);
    emit_attr(b, DW_AT_data_member_location, DW_FORM_udata);
    uleb(b, 0); uleb(b, 0);

    uleb(b, ABBREV_ARRAY::u64);
    uleb(b, DW_TAG_array_type::u64);
    enc.emit_byte(b, DW_CHILDREN_yes);
    emit_attr(b, DW_AT_type, DW_FORM_ref4);
    uleb(b, 0); uleb(b, 0);

    uleb(b, ABBREV_SUBRANGE::u64);
    uleb(b, DW_TAG_subrange_type::u64);
    enc.emit_byte(b, DW_CHILDREN_no);
    emit_attr(b, DW_AT_count, DW_FORM_udata);
    uleb(b, 0); uleb(b, 0);

    uleb(b, ABBREV_POINTER::u64);
    uleb(b, DW_TAG_pointer_type::u64);
    enc.emit_byte(b, DW_CHILDREN_no);
    emit_attr(b, DW_AT_type,      DW_FORM_ref4);
    emit_attr(b, DW_AT_byte_size, DW_FORM_udata);
    uleb(b, 0); uleb(b, 0);

    uleb(b, ABBREV_STRUCT_LEAF::u64);
    uleb(b, DW_TAG_structure_type::u64);
    enc.emit_byte(b, DW_CHILDREN_no);
    emit_attr(b, DW_AT_name,      DW_FORM_strp);
    emit_attr(b, DW_AT_byte_size, DW_FORM_udata);
    uleb(b, 0); uleb(b, 0);

    uleb(b, ABBREV_UNION_LEAF::u64);
    uleb(b, DW_TAG_union_type::u64);
    enc.emit_byte(b, DW_CHILDREN_no);
    emit_attr(b, DW_AT_name,      DW_FORM_strp);
    emit_attr(b, DW_AT_byte_size, DW_FORM_udata);
    uleb(b, 0); uleb(b, 0);

    uleb(b, ABBREV_STRUCT_ANON::u64);
    uleb(b, DW_TAG_structure_type::u64);
    enc.emit_byte(b, DW_CHILDREN_yes);
    emit_attr(b, DW_AT_byte_size, DW_FORM_udata);
    uleb(b, 0); uleb(b, 0);

    uleb(b, ABBREV_STRUCT_LEAF_ANON::u64);
    uleb(b, DW_TAG_structure_type::u64);
    enc.emit_byte(b, DW_CHILDREN_no);
    emit_attr(b, DW_AT_byte_size, DW_FORM_udata);
    uleb(b, 0); uleb(b, 0);

    uleb(b, ABBREV_UNION_ANON::u64);
    uleb(b, DW_TAG_union_type::u64);
    enc.emit_byte(b, DW_CHILDREN_yes);
    emit_attr(b, DW_AT_byte_size, DW_FORM_udata);
    uleb(b, 0); uleb(b, 0);

    uleb(b, ABBREV_UNION_LEAF_ANON::u64);
    uleb(b, DW_TAG_union_type::u64);
    enc.emit_byte(b, DW_CHILDREN_no);
    emit_attr(b, DW_AT_byte_size, DW_FORM_udata);
    uleb(b, 0); uleb(b, 0);

    uleb(b, ABBREV_MEMBER_ANON::u64);
    uleb(b, DW_TAG_member::u64);
    enc.emit_byte(b, DW_CHILDREN_no);
    emit_attr(b, DW_AT_type,                 DW_FORM_ref4);
    emit_attr(b, DW_AT_data_member_location, DW_FORM_udata);
    uleb(b, 0); uleb(b, 0);

    uleb(b, ABBREV_VECTOR_ARRAY::u64);
    uleb(b, DW_TAG_array_type::u64);
    enc.emit_byte(b, DW_CHILDREN_yes);
    emit_attr(b, DW_AT_type, DW_FORM_ref4);
    uleb(b, DW_AT_GNU_vector::u64);
    uleb(b, DW_FORM_flag_present::u64);
    uleb(b, 0); uleb(b, 0);

    uleb(b, 0);
}

fun build_inlined_abbrev(b: *enc.ByteBuf, code: u8, ranges: bool, kids: bool) {
    uleb(b, code::u64);
    uleb(b, DW_TAG_inlined_subroutine::u64);
    if (kids) { enc.emit_byte(b, DW_CHILDREN_yes); }
    or        { enc.emit_byte(b, DW_CHILDREN_no); }
    emit_attr(b, DW_AT_abstract_origin, DW_FORM_ref4);
    if (ranges) {
        emit_attr(b, DW_AT_ranges,  DW_FORM_sec_offset);
    }
    or {
        emit_attr(b, DW_AT_low_pc,  DW_FORM_addr);
        emit_attr(b, DW_AT_high_pc, DW_FORM_data8);
    }
    emit_attr(b, DW_AT_call_file, DW_FORM_udata);
    emit_attr(b, DW_AT_call_line, DW_FORM_udata);
    uleb(b, 0); uleb(b, 0);
}

fun subprogram_abbrev(has_type: bool, kids: bool, naked: bool) u8 {
    if (naked) {
        if (has_type) {
            if (kids) { ret ABBREV_SUBPROGRAM_NOFB; }
            ret ABBREV_SUBPROGRAM_LEAF_NOFB;
        }
        if (kids) { ret ABBREV_SUBPROGRAM_VOID_NOFB; }
        ret ABBREV_SUBPROGRAM_VOID_LEAF_NOFB;
    }
    if (has_type) {
        if (kids) { ret ABBREV_SUBPROGRAM; }
        ret ABBREV_SUBPROGRAM_LEAF;
    }
    if (kids) { ret ABBREV_SUBPROGRAM_VOID; }
    ret ABBREV_SUBPROGRAM_VOID_LEAF;
}

fun build_subprogram_abbrev(b: *enc.ByteBuf, code: u8, has_type: bool, kids: bool, has_fb: bool) {
    uleb(b, code::u64);
    uleb(b, DW_TAG_subprogram::u64);
    if (kids) { enc.emit_byte(b, DW_CHILDREN_yes); } or { enc.emit_byte(b, DW_CHILDREN_no); }
    emit_attr(b, DW_AT_name,       DW_FORM_strp);
    emit_attr(b, DW_AT_low_pc,     DW_FORM_addr);
    emit_attr(b, DW_AT_high_pc,    DW_FORM_data8);
    emit_attr(b, DW_AT_external,   DW_FORM_flag);
    emit_attr(b, DW_AT_decl_file,  DW_FORM_udata);
    emit_attr(b, DW_AT_decl_line,  DW_FORM_udata);
    if (has_fb) { emit_attr(b, DW_AT_frame_base, DW_FORM_exprloc); }
    if (has_type) { emit_attr(b, DW_AT_type, DW_FORM_ref4); }
    uleb(b, 0); uleb(b, 0);
}

fun build_var_abbrev(b: *enc.ByteBuf, code: u8, tag: u8, has_loc: bool) {
    uleb(b, code::u64);
    uleb(b, tag::u64);
    enc.emit_byte(b, DW_CHILDREN_no);
    emit_attr(b, DW_AT_name, DW_FORM_strp);
    emit_attr(b, DW_AT_type, DW_FORM_ref4);
    if (has_loc) { emit_attr(b, DW_AT_location, DW_FORM_exprloc); }
    uleb(b, 0); uleb(b, 0);
}

fun build_var_loclist_abbrev(b: *enc.ByteBuf, code: u8, tag: u8) {
    uleb(b, code::u64);
    uleb(b, tag::u64);
    enc.emit_byte(b, DW_CHILDREN_no);
    emit_attr(b, DW_AT_name, DW_FORM_strp);
    emit_attr(b, DW_AT_type, DW_FORM_ref4);
    emit_attr(b, DW_AT_location, DW_FORM_sec_offset);
    uleb(b, 0); uleb(b, 0);
}

fun inline_present(inlines: *DwInline, ninl: u32, f: u32, site: u32) bool {
    var i: u32 = 0;
    for (i < ninl) {
        if (inlines[i].func_idx == f && inlines[i].site_id == site) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun subprogram_has_children(f: u32, fn: *DwFunc, vars: *DwVar, inlines: *DwInline, ninl: u32) bool {
    var vi: u32 = 0;
    for (vi < fn.var_count) {
        val dvr: *DwVar = ?vars[fn.var_start + vi];
        if (dvr.inline_site == 0 || !inline_present(inlines, ninl, f, dvr.inline_site)) { ret true; }
        vi = vi + 1;
    }
    var xi: u32 = 0;
    for (xi < ninl) {
        if (inlines[xi].func_idx == f && inlines[xi].parent == 0) { ret true; }
        xi = xi + 1;
    }
    ret false;
}

fun emit_inlines(b: *enc.ByteBuf, f: u32, parent_site: u32, inlines: *DwInline, ninl: u32,
                 iranges: *DwInlineRange, relocs: *InfoReloc, reloc_count: *u32, reloc_cap: u32, fn: *DwFunc,
                 address_size: u8, addr_kind: of.RelocKind,
                 vars: *DwVar, tc: *TypeCtx) {
    var xi: u32 = 0;
    for (xi < ninl) {
        if (inlines[xi].func_idx != f || inlines[xi].parent != parent_site) { xi = xi + 1; cnt; }
        val di: *DwInline = ?inlines[xi];
        var kids: bool = false;
        var ck: u32 = 0;
        for (ck < ninl) { if (inlines[ck].func_idx == f && inlines[ck].parent == di.site_id) { kids = true; } ck = ck + 1; }
        var cv: u32 = 0;
        for (cv < fn.var_count) { if (vars[fn.var_start + cv].inline_site == di.site_id) { kids = true; } cv = cv + 1; }

        if (di.range_count == 1) {
            if (kids) { enc.emit_byte(b, ABBREV_INLINED_KIDS); } or { enc.emit_byte(b, ABBREV_INLINED); }
            enc.emit_u32(b, di.origin_off);
            val rg: *DwInlineRange = ?iranges[di.range_start];
            push_info_reloc(relocs, reloc_count, reloc_cap, b.len::u32, addr_kind, IRLT_SYM, fn.name, (rg.start - fn.offset)::i64);
            emit_addr(b, address_size);
            enc.emit_u64(b, (rg.end - rg.start)::u64);
        }
        or {
            if (kids) { enc.emit_byte(b, ABBREV_INLINED_RANGES_KIDS); } or { enc.emit_byte(b, ABBREV_INLINED_RANGES); }
            enc.emit_u32(b, di.origin_off);
            push_info_reloc(relocs, reloc_count, reloc_cap, b.len::u32, of.RK_ABS32, IRLT_RNGLIST, intern.STR_NIL, di.rnglist_off::i64);
            enc.emit_u32(b, 0);
        }
        uleb(b, di.call_file::u64);
        uleb(b, di.call_line::u64);

        if (kids) {
            var vv: u32 = 0;
            for (vv < fn.var_count) {
                if (vars[fn.var_start + vv].inline_site == di.site_id) { emit_variable(b, ?vars[fn.var_start + vv], tc, relocs, reloc_count, reloc_cap); }
                vv = vv + 1;
            }
            emit_inlines(b, f, di.site_id, inlines, ninl, iranges, relocs, reloc_count, reloc_cap, fn,
                         address_size, addr_kind, vars, tc);
            enc.emit_byte(b, 0);
        }
        xi = xi + 1;
    }
}

fun emit_type_dies(b: *enc.ByteBuf, tc: *TypeCtx, len_pos: usize, relocs: *InfoReloc, reloc_count: *u32, reloc_cap: u32,
                   fixups: *TypeFixup, nfix: *u32, nfix_cap: u32) {
    var t: u32 = 0;
    for (t < tc.ntypes) {
        val td: *TypeDie = ?tc.types[t];
        td.off = (b.len - len_pos)::u32;
        if (td.kind == TK_BASE) {
            enc.emit_byte(b, ABBREV_BASE_TYPE);
            push_info_reloc(relocs, reloc_count, reloc_cap, b.len::u32, of.RK_ABS32, IRLT_STR, intern.STR_NIL, td.name_off::i64);
            enc.emit_u32(b, 0);
            enc.emit_byte(b, td.encoding);
            enc.emit_byte(b, td.byte_size::u8);
        }
        or (td.kind == TK_POINTER) {
            enc.emit_byte(b, ABBREV_POINTER);
            push_type_fixup(fixups, nfix, nfix_cap, b.len::u32, td.elem::u32);
            enc.emit_u32(b, 0);
            uleb(b, td.byte_size::u64);
        }
        or (td.kind == TK_ARRAY) {
            enc.emit_byte(b, ABBREV_ARRAY);
            push_type_fixup(fixups, nfix, nfix_cap, b.len::u32, td.elem::u32);
            enc.emit_u32(b, 0);
            enc.emit_byte(b, ABBREV_SUBRANGE);
            uleb(b, td.count::u64);
            enc.emit_byte(b, 0);
        }
        or (td.kind == TK_VECTOR) {
            enc.emit_byte(b, ABBREV_VECTOR_ARRAY);
            push_type_fixup(fixups, nfix, nfix_cap, b.len::u32, td.elem::u32);
            enc.emit_u32(b, 0);
            enc.emit_byte(b, ABBREV_SUBRANGE);
            uleb(b, td.count::u64);
            enc.emit_byte(b, 0);
        }
        or {
            val kids: bool = td.memb_count > 0;
            val anon: bool = td.name_off == NAME_OMIT;
            var ab: u8 = ABBREV_STRUCT;
            if (td.kind == TK_UNION) {
                if (kids) { ab = ABBREV_UNION;      if (anon) { ab = ABBREV_UNION_ANON; } }
                or        { ab = ABBREV_UNION_LEAF; if (anon) { ab = ABBREV_UNION_LEAF_ANON; } }
            } or {
                if (kids) { ab = ABBREV_STRUCT;      if (anon) { ab = ABBREV_STRUCT_ANON; } }
                or        { ab = ABBREV_STRUCT_LEAF; if (anon) { ab = ABBREV_STRUCT_LEAF_ANON; } }
            }
            enc.emit_byte(b, ab);
            if (!anon) {
                push_info_reloc(relocs, reloc_count, reloc_cap, b.len::u32, of.RK_ABS32, IRLT_STR, intern.STR_NIL, td.name_off::i64);
                enc.emit_u32(b, 0);
            }
            uleb(b, td.byte_size::u64);
            var m: u32 = td.memb_start;
            val mend: u32 = td.memb_start + td.memb_count;
            for (m < mend) {
                val mb: *TypeMember = ?tc.membs[m];
                if (mb.name_off == NAME_OMIT) {
                    enc.emit_byte(b, ABBREV_MEMBER_ANON);
                } or {
                    enc.emit_byte(b, ABBREV_MEMBER);
                    push_info_reloc(relocs, reloc_count, reloc_cap, b.len::u32, of.RK_ABS32, IRLT_STR, intern.STR_NIL, mb.name_off::i64);
                    enc.emit_u32(b, 0);
                }
                push_type_fixup(fixups, nfix, nfix_cap, b.len::u32, mb.type_ix);
                enc.emit_u32(b, 0);
                uleb(b, mb.offset::u64);
                m = m + 1;
            }
            if (kids) { enc.emit_byte(b, 0); }
        }
        t = t + 1;
    }
    resolve_type_fixups(b, tc, fixups, nfix);
}

fun push_type_fixup(fixups: *TypeFixup, nfix: *u32, cap: u32, pos: u32, target: u32) {
    if (@nfix >= cap) { panic("dwarf: type fixup capacity exceeded\n"); }
    fixups[@nfix].pos    = pos;
    fixups[@nfix].target = target;
    @nfix = @nfix + 1;
}

fun resolve_type_fixups(b: *enc.ByteBuf, tc: *TypeCtx, fixups: *TypeFixup, nfix: *u32) {
    var i: u32 = 0;
    for (i < @nfix) {
        bin.write_u32_le(b.data, fixups[i].pos::usize, tc.types[fixups[i].target].off);
        i = i + 1;
    }
}

fun build_info(b: *enc.ByteBuf, address_size: u8, addr_kind: of.RelocKind, producer: str, name: str, comp_dir: str,
               cu_rnglist_off: u32, fb_reg: i32, fb_omit_reg: i32, funcs: *DwFunc, nfuncs: u32, tc: *TypeCtx,
               vars: *DwVar, relocs: *InfoReloc, reloc_count: *u32, reloc_cap: u32, stmt_off: *u32,
               s: *debug_input.DebugProgram, irmod: *ir.Module, strtab: *StrTab,
               inlines: *DwInline, ninl: u32, iranges: *DwInlineRange, fixups: *TypeFixup, nfix_cap: u32) {
    val len_pos: usize = b.len;
    enc.emit_u32(b, 0);
    val body_start: usize = b.len;
    enc.emit_u16(b, 5);
    enc.emit_byte(b, DW_UT_compile);
    enc.emit_byte(b, address_size);
    enc.emit_u32(b, 0);

    uleb(b, ABBREV_CU::u64);
    emit_cstr(b, producer);
    emit_cstr(b, name);
    emit_cstr(b, comp_dir);
    enc.emit_u16(b, DW_LANG_C);
    push_info_reloc(relocs, reloc_count, reloc_cap, b.len::u32, of.RK_ABS32, IRLT_RNGLIST,
                    intern.STR_NIL, cu_rnglist_off::i64);
    enc.emit_u32(b, 0);
    @stmt_off = b.len::u32;
    enc.emit_u32(b, 0);

    var nfix: u32 = 0;
    emit_type_dies(b, tc, len_pos, relocs, reloc_count, reloc_cap, fixups, ?nfix, nfix_cap);

    var ai: u32 = 0;
    for (ai < ninl) {
        var dup: bool = false;
        var pj: u32 = 0;
        for (pj < ai) {
            if (inlines[pj].callee == inlines[ai].callee) { inlines[ai].origin_off = inlines[pj].origin_off; dup = true; brk; }
            pj = pj + 1;
        }
        if (dup) { ai = ai + 1; cnt; }

        var cnm: str = resolve(s.interner, inlines[ai].callee);
        val oi: O.Option[u32] = ir.function_lookup(irmod, inlines[ai].callee);
        if (O.is_some[u32](oi)) {
            val cf: *ir.Function = ?irmod.functions[O.unwrap[u32](oi)];
            if (cf.disp != intern.STR_NIL) { cnm = resolve(s.interner, cf.disp); }
        }
        inlines[ai].origin_off = (b.len - len_pos)::u32;
        enc.emit_byte(b, ABBREV_SUBPROGRAM_ABSTRACT);
        push_info_reloc(relocs, reloc_count, reloc_cap, b.len::u32, of.RK_ABS32, IRLT_STR, intern.STR_NIL, str_off(strtab, cnm)::i64);
        enc.emit_u32(b, 0);
        enc.emit_byte(b, DW_INL_inlined);
        ai = ai + 1;
    }

    var f: u32 = 0;
    for (f < nfuncs) {
        val fn: *DwFunc = ?funcs[f];
        val has_kids: bool = subprogram_has_children(f, fn, vars, inlines, ninl);
        enc.emit_byte(b, subprogram_abbrev(fn.ret_ty >= 0, has_kids, fn.naked));
        push_info_reloc(relocs, reloc_count, reloc_cap, b.len::u32, of.RK_ABS32, IRLT_STR, intern.STR_NIL, fn.disp_off::i64);
        enc.emit_u32(b, 0);
        push_info_reloc(relocs, reloc_count, reloc_cap, b.len::u32, addr_kind, IRLT_SYM, fn.name, 0);
        emit_addr(b, address_size);
        enc.emit_u64(b, fn.size::u64);
        if (fn.external) { enc.emit_byte(b, 1); } or { enc.emit_byte(b, 0); }
        uleb(b, fn.decl_file::u64);
        uleb(b, fn.decl_line::u64);
        if (!fn.naked) {
            if (fn.omit || fn.realign) { emit_frame_base(b, fb_omit_reg); }
            or { emit_frame_base(b, fb_reg); }
        }
        if (fn.ret_ty >= 0) { enc.emit_u32(b, tc.types[fn.ret_ty::u32].off); }

        var vi: u32 = 0;
        for (vi < fn.var_count) {
            val dvr: *DwVar = ?vars[fn.var_start + vi];
            if (dvr.inline_site == 0 || !inline_present(inlines, ninl, f, dvr.inline_site)) { emit_variable(b, dvr, tc, relocs, reloc_count, reloc_cap); }
            vi = vi + 1;
        }

        emit_inlines(b, f, 0, inlines, ninl, iranges, relocs, reloc_count, reloc_cap, fn,
                     address_size, addr_kind, vars, tc);

        if (has_kids) { enc.emit_byte(b, 0); }
        f = f + 1;
    }

    enc.emit_byte(b, 0);

    bin.write_u32_le(b.data, len_pos, (b.len - body_start)::u32);
}

fun emit_variable(b: *enc.ByteBuf, v: *DwVar, tc: *TypeCtx, relocs: *InfoReloc, reloc_count: *u32, reloc_cap: u32) {
    if (v.loc_kind == VLOC_LOCLIST) {
        if (v.is_param) { enc.emit_byte(b, ABBREV_PARAM_LOCLIST); } or { enc.emit_byte(b, ABBREV_VARIABLE_LOCLIST); }
        push_info_reloc(relocs, reloc_count, reloc_cap, b.len::u32, of.RK_ABS32, IRLT_STR, intern.STR_NIL, v.name_off::i64);
        enc.emit_u32(b, 0);
        enc.emit_u32(b, tc.types[v.ty::u32].off);
        push_info_reloc(relocs, reloc_count, reloc_cap, b.len::u32, of.RK_ABS32, IRLT_LOCLIST, intern.STR_NIL, v.loclist_off::i64);
        enc.emit_u32(b, 0);
        ret;
    }
    val located: bool = v.loc_kind != VLOC_NONE;
    if (v.is_param) {
        if (located) { enc.emit_byte(b, ABBREV_PARAM); } or { enc.emit_byte(b, ABBREV_PARAM_NOLOC); }
    } or {
        if (located) { enc.emit_byte(b, ABBREV_VARIABLE); } or { enc.emit_byte(b, ABBREV_VARIABLE_NOLOC); }
    }
    push_info_reloc(relocs, reloc_count, reloc_cap, b.len::u32, of.RK_ABS32, IRLT_STR, intern.STR_NIL, v.name_off::i64);
    enc.emit_u32(b, 0);
    enc.emit_u32(b, tc.types[v.ty::u32].off);
    if (located) { emit_var_location(b, v); }
}

fun emit_frame_base(b: *enc.ByteBuf, fb_reg: i32) {
    if (fb_reg < 32) {
        enc.emit_byte(b, 1);
        enc.emit_byte(b, (DW_OP_reg0::i32 + fb_reg)::u8);
    } or {
        var tmp: enc.ByteBuf = enc.buf_init(b.alloc);
        enc.emit_byte(?tmp, DW_OP_regx);
        uleb(?tmp, fb_reg::u64);
        uleb(b, tmp.len::u64);
        var i: usize = 0;
        for (i < tmp.len) { enc.emit_byte(b, tmp.data[i]); i = i + 1; }
        enc.buf_dnit(?tmp);
    }
}

fun varloc_home(tgt: *debug_input.DebugProgram, vl: *enc.VarLoc, out_kind: *u8, out_reg: *i32, out_off: *i64, out_storage: *bool) {
    @out_kind    = VLOC_NONE;
    @out_reg     = 0;
    @out_off     = 0;
    @out_storage = false;
    if (vl.kind == enc.VARLOC_REG) {
        val f: debug_input.DwarfRegFn = tgt.dwarf_reg;
        val d: i32 = f(vl.reg);
        if (d >= 0) { @out_kind = VLOC_REG; @out_reg = d; }
    } or (vl.kind == enc.VARLOC_FRAME) {
        @out_kind    = VLOC_FRAME;
        @out_off     = vl.off;
        @out_storage = vl.off_storage;
    }
}

fun dbg_expr_net(irfn: *ir.Function, iid: id.InstructionId) i64 {
    val eid: ir.DbgExprId = ir.dbg_expr_id(irfn, iid);
    val o: O.Option[*ir.DbgExpr] = ir.dbg_expr_get(irfn, eid);
    if (O.is_none[*ir.DbgExpr](o)) { ret 0; }
    val dex: *ir.DbgExpr = O.unwrap[*ir.DbgExpr](o);
    var net: i64 = 0;
    var i: u32 = 0;
    for (i < dex.op_count) {
        if (dex.ops[i].op == ir.DBG_OP_PLUS_CONST)  { net = net + dex.ops[i].arg::i64; }
        or (dex.ops[i].op == ir.DBG_OP_MINUS_CONST) { net = net - dex.ops[i].arg::i64; }
        i = i + 1;
    }
    ret net;
}

fun type_is_aggregate(tc: *TypeCtx, ty: i32) bool {
    if (ty < 0) { ret false; }
    val k: u8 = tc.types[ty::u32].kind;
    ret k == TK_STRUCT || k == TK_UNION || k == TK_ARRAY;
}

fun build_loc_ops(e: *enc.ByteBuf, kind: u8, reg: i32, off: i64, net: i64, byref: bool, storage: bool) {
    if (kind == VLOC_CONST) {
        enc.emit_byte(e, DW_OP_consts);
        sleb(e, off + net);
        enc.emit_byte(e, DW_OP_stack_value);
        ret;
    }
    if (byref) {
        enc.emit_byte(e, DW_OP_fbreg);
        sleb(e, off);
        if (!storage) { enc.emit_byte(e, DW_OP_deref); }
        if (net != 0) { emit_net_const(e, net); }
        ret;
    }
    if (kind == VLOC_REG) {
        if (net == 0) {
            emit_reg_op(e, DW_OP_reg0, DW_OP_regx, reg);
        } or {
            emit_reg_op(e, DW_OP_breg0, DW_OP_bregx, reg);
            sleb(e, net);
            enc.emit_byte(e, DW_OP_stack_value);
        }
    } or {
        enc.emit_byte(e, DW_OP_fbreg);
        sleb(e, off);
        if (net != 0) {
            enc.emit_byte(e, DW_OP_deref);
            emit_net_const(e, net);
            enc.emit_byte(e, DW_OP_stack_value);
        }
    }
}

fun emit_counted_loc(b: *enc.ByteBuf, kind: u8, reg: i32, off: i64, net: i64, byref: bool, storage: bool) {
    var e: enc.ByteBuf = enc.buf_init(b.alloc);
    build_loc_ops(?e, kind, reg, off, net, byref, storage);
    uleb(b, e.len::u64);
    var i: usize = 0;
    for (i < e.len) { enc.emit_byte(b, e.data[i]); i = i + 1; }
    enc.buf_dnit(?e);
}

fun cmp_rel_op(rel: u8) u8 {
    if (rel == enc.CMPREL_EQ) { ret DW_OP_eq; }
    if (rel == enc.CMPREL_NE) { ret DW_OP_ne; }
    if (rel == enc.CMPREL_LT) { ret DW_OP_lt; }
    ret DW_OP_le;
}

fun cmp_const_value(bits: i64, width: u8, signed: bool, bias: bool) i64 {
    if (width == 1) {
        var v: i64 = bits & 0xFF;
        if (signed && (v & 0x80) != 0) { v = v - 0x100; }
        ret v;
    }
    if (width == 2) {
        var v: i64 = bits & 0xFFFF;
        if (signed && (v & 0x8000) != 0) { v = v - 0x10000; }
        ret v;
    }
    if (width == 4) {
        var v: i64 = bits & 0xFFFFFFFF;
        if (signed && (v & 0x80000000) != 0) { v = v - 0x100000000; }
        ret v;
    }
    if (bias) {
        val minv: i64 = -9223372036854775807 - 1;
        ret bits ^ minv;
    }
    ret bits;
}

fun build_cmp_operand(e: *enc.ByteBuf, kind: u8, reg: i32, off: i64, width: u8, signed: bool, bias: bool) {
    if (kind == VLOC_CONST) {
        enc.emit_byte(e, DW_OP_consts);
        sleb(e, cmp_const_value(off, width, signed, bias));
        ret;
    }
    if (kind == VLOC_REG) {
        emit_reg_op(e, DW_OP_breg0, DW_OP_bregx, reg);
        sleb(e, 0);
    }
    or {
        enc.emit_byte(e, DW_OP_fbreg);
        sleb(e, off);
        enc.emit_byte(e, DW_OP_deref);
    }
    if (width == 1 || width == 2 || width == 4) {
        val sh: u8 = 64 - (width * 8);
        if (signed) {
            enc.emit_byte(e, DW_OP_const1u);
            enc.emit_byte(e, sh);
            enc.emit_byte(e, DW_OP_shl);
            enc.emit_byte(e, DW_OP_const1u);
            enc.emit_byte(e, sh);
            enc.emit_byte(e, DW_OP_shra);
        }
        or {
            var mask: u64 = 0xFF;
            if (width == 2) { mask = 0xFFFF; }
            if (width == 4) { mask = 0xFFFFFFFF; }
            enc.emit_byte(e, DW_OP_constu);
            uleb(e, mask);
            enc.emit_byte(e, DW_OP_and);
        }
        ret;
    }
    if (bias) {
        enc.emit_byte(e, DW_OP_constu);
        uleb(e, 9223372036854775808);
        enc.emit_byte(e, DW_OP_plus);
    }
}

fun build_cmp_ops(e: *enc.ByteBuf, rg: *LocRange) {
    var w: u8 = rg.cmp_width;
    if (w == 0) { w = 8; }
    val bias: bool = w == 8 && !rg.cmp_signed &&
                     (rg.cmp_rel == enc.CMPREL_LT || rg.cmp_rel == enc.CMPREL_LE);
    build_cmp_operand(e, rg.kind1, rg.reg, rg.off, w, rg.cmp_signed, bias);
    build_cmp_operand(e, rg.kind2, rg.reg2, rg.off2, w, rg.cmp_signed, bias);
    enc.emit_byte(e, cmp_rel_op(rg.cmp_rel));
    enc.emit_byte(e, DW_OP_stack_value);
}

fun emit_counted_cmp_loc(b: *enc.ByteBuf, rg: *LocRange) {
    var e: enc.ByteBuf = enc.buf_init(b.alloc);
    build_cmp_ops(?e, rg);
    uleb(b, e.len::u64);
    var i: usize = 0;
    for (i < e.len) { enc.emit_byte(b, e.data[i]); i = i + 1; }
    enc.buf_dnit(?e);
}

fun emit_var_location(b: *enc.ByteBuf, v: *DwVar) {
    emit_counted_loc(b, v.loc_kind, v.reg, v.offset, v.net, v.byref, v.storage);
}

fun build_loclists(b: *enc.ByteBuf, funcs: *DwFunc, nfuncs: u32, vars: *DwVar, ranges: *LocRange,
                   address_size: u8, loc_relocs: *LocReloc, loc_reloc_count: *u32, loc_reloc_cap: u32) {
    val len_pos: usize = b.len;
    enc.emit_u32(b, 0);
    val body: usize = b.len;
    enc.emit_u16(b, 5);
    enc.emit_byte(b, address_size);
    enc.emit_byte(b, 0);
    enc.emit_u32(b, 0);

    var f: u32 = 0;
    for (f < nfuncs) {
        val fn: *DwFunc = ?funcs[f];
        var vi: u32 = 0;
        for (vi < fn.var_count) {
            val v: *DwVar = ?vars[fn.var_start + vi];
            if (v.loc_kind != VLOC_LOCLIST) { vi = vi + 1; cnt; }
            v.loclist_off = b.len::u32;
            enc.emit_byte(b, DW_LLE_base_address);
            push_loc_reloc(loc_relocs, loc_reloc_count, loc_reloc_cap, b.len::u32, fn.name);
            emit_addr(b, address_size);
            var r: u32 = v.range_start;
            val rend: u32 = v.range_start + v.range_count;
            for (r < rend) {
                val rg: *LocRange = ?ranges[r];
                if (range_real_home(v, rg)) {
                    enc.emit_byte(b, DW_LLE_offset_pair);
                    uleb(b, (rg.start - fn.offset)::u64);
                    uleb(b, (rg.end - fn.offset)::u64);
                    if (rg.kind == VLOC_CMP) { emit_counted_cmp_loc(b, rg); }
                    or                       { emit_counted_loc(b, rg.kind, rg.reg, rg.off, rg.net, v.byref, rg.storage); }
                }
                r = r + 1;
            }
            enc.emit_byte(b, DW_LLE_end_of_list);
            vi = vi + 1;
        }
        f = f + 1;
    }

    bin.write_u32_le(b.data, len_pos, (b.len - body)::u32);
}

fun build_rnglists(b: *enc.ByteBuf, funcs: *DwFunc, nfuncs: u32, inlines: *DwInline, ninl: u32,
                   iranges: *DwInlineRange, address_size: u8, rng_relocs: *RngReloc,
                   rng_reloc_count: *u32, rng_reloc_cap: u32, cu_rnglist_off: *u32) {
    val len_pos: usize = b.len;
    enc.emit_u32(b, 0);
    val body: usize = b.len;
    enc.emit_u16(b, 5);
    enc.emit_byte(b, address_size);
    enc.emit_byte(b, 0);
    enc.emit_u32(b, 0);

    @cu_rnglist_off = b.len::u32;
    var fi: u32 = 0;
    for (fi < nfuncs) {
        enc.emit_byte(b, DW_RLE_start_length);
        push_rng_reloc(rng_relocs, rng_reloc_count, rng_reloc_cap, b.len::u32, funcs[fi].name);
        emit_addr(b, address_size);
        uleb(b, funcs[fi].size::u64);
        fi = fi + 1;
    }
    enc.emit_byte(b, DW_RLE_end_of_list);

    var i: u32 = 0;
    for (i < ninl) {
        val di: *DwInline = ?inlines[i];
        if (di.range_count <= 1) { i = i + 1; cnt; }
        val fn: *DwFunc = ?funcs[di.func_idx];
        di.rnglist_off = b.len::u32;
        enc.emit_byte(b, DW_RLE_base_address);
        push_rng_reloc(rng_relocs, rng_reloc_count, rng_reloc_cap, b.len::u32, fn.name);
        emit_addr(b, address_size);
        var r: u32 = di.range_start;
        val rend: u32 = di.range_start + di.range_count;
        for (r < rend) {
            val rg: *DwInlineRange = ?iranges[r];
            enc.emit_byte(b, DW_RLE_offset_pair);
            uleb(b, (rg.start - fn.offset)::u64);
            uleb(b, (rg.end - fn.offset)::u64);
            r = r + 1;
        }
        enc.emit_byte(b, DW_RLE_end_of_list);
        i = i + 1;
    }
    bin.write_u32_le(b.data, len_pos, (b.len - body)::u32);
}

fun emit_reg_op(e: *enc.ByteBuf, base0: u8, opx: u8, n: i32) {
    if (n < 32) {
        enc.emit_byte(e, (base0::i32 + n)::u8);
    } or (opx != 0) {
        enc.emit_byte(e, opx);
        uleb(e, n::u64);
    } or {
        enc.emit_byte(e, (base0::i32 + 31)::u8);
    }
}

fun emit_net_const(e: *enc.ByteBuf, net: i64) {
    if (net >= 0) {
        enc.emit_byte(e, DW_OP_plus_uconst);
        uleb(e, net::u64);
    } or {
        enc.emit_byte(e, DW_OP_constu);
        uleb(e, (0 - net)::u64);
        enc.emit_byte(e, DW_OP_minus);
    }
}

fun emit_row(b: *enc.ByteBuf, addr_delta: u32, line_delta: i32) {
    if (line_delta >= LINE_BASE && line_delta < LINE_BASE + LINE_RANGE) {
        val op: i64 = (line_delta - LINE_BASE)::i64 + (LINE_RANGE::i64 * addr_delta::i64) + OPCODE_BASE::i64;
        if (op <= 255) {
            enc.emit_byte(b, op::u8);
            ret;
        }
    }
    if (line_delta != 0) { enc.emit_byte(b, DW_LNS_advance_line); sleb(b, line_delta::i64); }
    if (addr_delta != 0) { enc.emit_byte(b, DW_LNS_advance_pc);   uleb(b, addr_delta::u64); }
    enc.emit_byte(b, DW_LNS_copy);
}

fun build_line(s: *debug_input.DebugProgram, funcs: *DwFunc, nfuncs: u32, rows: *enc.LineRow, row_count: u32,
               text_sec: u32, address_size: u8, comp_dir: str, name: str, ft: *FileTable,
               b: *enc.ByteBuf, addr_off: *u32) {
    val len_pos: usize = b.len;
    enc.emit_u32(b, 0);
    val ul_end: usize = b.len;
    enc.emit_u16(b, 5);
    enc.emit_byte(b, address_size);
    enc.emit_byte(b, 0);
    val hl_pos: usize = b.len;
    enc.emit_u32(b, 0);
    val hdr_start: usize = b.len;

    enc.emit_byte(b, 1);
    enc.emit_byte(b, 1);
    enc.emit_byte(b, 1);
    enc.emit_byte(b, (LINE_BASE & 0xFF)::u8);
    enc.emit_byte(b, LINE_RANGE::u8);
    enc.emit_byte(b, OPCODE_BASE);
    enc.emit_byte(b, 0); enc.emit_byte(b, 1); enc.emit_byte(b, 1); enc.emit_byte(b, 1);
    enc.emit_byte(b, 1); enc.emit_byte(b, 0); enc.emit_byte(b, 0); enc.emit_byte(b, 0);
    enc.emit_byte(b, 1); enc.emit_byte(b, 0); enc.emit_byte(b, 0); enc.emit_byte(b, 1);

    enc.emit_byte(b, 1);
    uleb(b, DW_LNCT_path::u64); uleb(b, DW_FORM_string::u64);
    uleb(b, 1);
    emit_cstr(b, comp_dir);

    enc.emit_byte(b, 2);
    uleb(b, DW_LNCT_path::u64);            uleb(b, DW_FORM_string::u64);
    uleb(b, DW_LNCT_directory_index::u64); uleb(b, 0x0F::u64);
    uleb(b, (ft.count + 1)::u64);
    emit_cstr(b, name);
    uleb(b, 0);
    var fi: u32 = 0;
    for (fi < ft.count) {
        emit_cstr(b, file_path(s, ft.ids[fi]));
        uleb(b, 0);
        fi = fi + 1;
    }

    bin.write_u32_le(b.data, hl_pos, (b.len - hdr_start)::u32);

    var f: u32 = 0;
    for (f < nfuncs) {
        val fn: *DwFunc = ?funcs[f];
        enc.emit_byte(b, 0);
        uleb(b, (1 + address_size)::u64);
        enc.emit_byte(b, DW_LNE_set_address);
        addr_off[f] = b.len::u32;
        emit_addr(b, address_size);

        var cur_off:  u32 = fn.offset;
        var cur_line: i32 = 1;
        var cur_file: i64 = -1;
        var first_row: bool = true;

        var r: u32 = 0;
        for (r < row_count) {
            val row: *enc.LineRow = ?rows[r];
            if (row.sec == text_sec && row.text_offset >= fn.offset && row.text_offset < fn.offset + fn.size) {
                val pl: PosLine = pos_of(s, row.loc, ft);
                if (pl.file::i64 != cur_file) {
                    enc.emit_byte(b, DW_LNS_set_file);
                    uleb(b, pl.file::u64);
                    cur_file = pl.file::i64;
                }
                if (first_row) {
                    if (row.text_offset > fn.offset) {
                        emit_row(b, 0, pl.line - cur_line);
                        cur_line = pl.line;
                    }
                    enc.emit_byte(b, DW_LNS_set_prologue_end);
                    first_row = false;
                }
                val addr_delta: u32 = row.text_offset - cur_off;
                emit_row(b, addr_delta, pl.line - cur_line);
                cur_off  = row.text_offset;
                cur_line = pl.line;
            }
            r = r + 1;
        }

        val end_delta: u32 = (fn.offset + fn.size) - cur_off;
        if (end_delta != 0) { enc.emit_byte(b, DW_LNS_advance_pc); uleb(b, end_delta::u64); }
        enc.emit_byte(b, 0);
        uleb(b, 1);
        enc.emit_byte(b, DW_LNE_end_sequence);
        f = f + 1;
    }

    bin.write_u32_le(b.data, len_pos, (b.len - ul_end)::u32);
}

rec PosLine {
    file: u32;
    line: i32;
}

fun pos_of(s: *debug_input.DebugProgram, loc: source.SrcLoc, ft: *FileTable) PosLine {
    var out: PosLine;
    out.file = 0;
    out.line = 1;
    val fx: i32 = file_slot(ft, loc.file);
    if (fx >= 0) { out.file = fx::u32; }
    val fo: O.Option[*source.SourceFile] = source.get(s.sources, loc.file);
    if (O.is_some[*source.SourceFile](fo)) {
        val p: source.Position = source.position(O.unwrap[*source.SourceFile](fo), loc.offset);
        out.line = p.line::i32;
    }
    ret out;
}

fun file_path(s: *debug_input.DebugProgram, id: source.FileId) str {
    val fo: O.Option[*source.SourceFile] = source.get(s.sources, id);
    if (O.is_some[*source.SourceFile](fo)) { ret O.unwrap[*source.SourceFile](fo).path; }
    ret "?";
}

fun emit_addr(b: *enc.ByteBuf, address_size: u8) {
    if (address_size == 8)      { enc.emit_u64(b, 0); }
    or (address_size == 2)      { enc.emit_u16(b, 0); }
    or                          { enc.emit_u32(b, 0); }
}

fun count_funcs(image: *of.ObjectImage, text_sec: u32) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < image.symbol_count) {
        val sym: *of.Symbol = ?image.symbols[i];
        if ((sym.flags & of.SYM_OBJ_FLAG_FUNCTION) != 0 && sym.section == text_sec) {
            n = n + 1;
        }
        i = i + 1;
    }
    ret n;
}

fun mir_omits_frame(mirmod: *mir.MirModule, name: intern.StrId) bool {
    if (mirmod == nil) { ret false; }
    var i: u32 = 0;
    for (i < mirmod.function_len) {
        if (mirmod.functions[i].name == name) { ret mirmod.functions[i].frame.omit; }
        i = i + 1;
    }
    ret false;
}

fun mir_realigns_frame(mirmod: *mir.MirModule, name: intern.StrId) bool {
    if (mirmod == nil) { ret false; }
    var i: u32 = 0;
    for (i < mirmod.function_len) {
        if (mirmod.functions[i].name == name) { ret mirmod.functions[i].frame.realign != 0; }
        i = i + 1;
    }
    ret false;
}

fun mir_is_naked(mirmod: *mir.MirModule, name: intern.StrId) bool {
    if (mirmod == nil) { ret false; }
    var i: u32 = 0;
    for (i < mirmod.function_len) {
        if (mirmod.functions[i].name == name) { ret mirmod.functions[i].naked; }
        i = i + 1;
    }
    ret false;
}

fun gather_funcs(image: *of.ObjectImage, mirmod: *mir.MirModule, text_sec: u32, out: *DwFunc) {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < image.symbol_count) {
        val sym: *of.Symbol = ?image.symbols[i];
        if ((sym.flags & of.SYM_OBJ_FLAG_FUNCTION) != 0 && sym.section == text_sec) {
            out[n].name     = sym.name;
            out[n].offset   = sym.offset;
            out[n].external = (sym.flags & of.SYM_OBJ_FLAG_GLOBAL) != 0;
            out[n].weak     = (sym.flags & of.SYM_OBJ_FLAG_WEAK) != 0;
            out[n].omit     = mir_omits_frame(mirmod, sym.name);
            out[n].realign  = mir_realigns_frame(mirmod, sym.name);
            out[n].naked    = mir_is_naked(mirmod, sym.name);
            n = n + 1;
        }
        i = i + 1;
    }
    var a: u32 = 1;
    for (a < n) {
        val key: DwFunc = out[a];
        var b: i64 = a::i64 - 1;
        for (b >= 0 && out[b::u32].offset > key.offset) {
            out[(b + 1)::u32] = out[b::u32];
            b = b - 1;
        }
        out[(b + 1)::u32] = key;
        a = a + 1;
    }
}

fun intern_anchor(itn: *intern.Interner, base: str, suffix: str) R.Result[intern.StrId, str] {
    val lb: usize = str_len(base);
    val ls: usize = str_len(suffix);
    val rb: R.Result[*u8, str] = A.allocate[u8](itn.a, lb + ls + 1);
    if (R.is_err[*u8, str](rb)) { ret R.err[intern.StrId, str](R.unwrap_err[*u8, str](rb)); }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);
    var w: usize = 0;
    var i: usize = 0;
    for (i < lb) { buf[w] = base[i]; w = w + 1; i = i + 1; }
    i = 0;
    for (i < ls) { buf[w] = suffix[i]; w = w + 1; i = i + 1; }
    buf[w] = 0;
    val ri: R.Result[intern.StrId, str] = intern.intern(itn, buf::str);
    A.deallocate[u8](itn.a, buf, lb + ls + 1);
    ret ri;
}

fun add_reloc(image: *of.ObjectImage, sec: u32, offset: u32, kind: of.RelocKind, sym: intern.StrId) R.Result[R.Void, str] {
    ret add_reloc_addend(image, sec, offset, kind, sym, 0);
}

fun add_reloc_addend(image: *of.ObjectImage, sec: u32, offset: u32, kind: of.RelocKind,
                     sym: intern.StrId, addend: i64) R.Result[R.Void, str] {
    val sym_ix: u32 = obj.symbol_index(image, sym);
    if (sym_ix == of.SYMBOL_NONE) {
        ret R.err[R.Void, str]("dwarf: relocation target absent from the image symbol table");
    }

    var rel: of.Relocation;
    rel.section = sec;
    rel.offset  = offset;
    rel.kind    = kind;
    rel.sym     = sym_ix;
    rel.addend  = addend;
    rel.sym2    = of.SYMBOL_NONE;
    ret obj.add_relocation(image, rel);
}

fun ir_function_at(image: *of.ObjectImage, irmod: *ir.Module, sec: u32, pc: u32) *ir.Function {
    var best: *of.Symbol = nil;
    var end: u32 = image.sections[sec].len;
    var i: u32 = 0;
    for (i < image.symbol_count) {
        val sym: *of.Symbol = ?image.symbols[i];
        if ((sym.flags & of.SYM_OBJ_FLAG_FUNCTION) != 0 && sym.section == sec
            && sym.offset <= pc && (best == nil || sym.offset > best.offset)) { best = sym; }
        i = i + 1;
    }
    if (best == nil) { ret nil; }
    i = 0;
    for (i < image.symbol_count) {
        val next: *of.Symbol = ?image.symbols[i];
        if ((next.flags & of.SYM_OBJ_FLAG_FUNCTION) != 0 && next.section == sec
            && next.offset > best.offset && next.offset < end) { end = next.offset; }
        i = i + 1;
    }
    if (pc >= end) { ret nil; }
    val found: O.Option[u32] = ir.function_lookup(irmod, best.name);
    if (O.is_none[u32](found)) { ret nil; }
    ret ?irmod.functions[O.unwrap[u32](found)];
}

fun inline_tree_valid(fn: *ir.Function) bool {
    if (fn == nil || (fn.inline_site_len > 0 && fn.inline_sites == nil)) { ret false; }
    var i: u32 = 0;
    for (i < fn.inline_site_len) {
        if (fn.inline_sites[i].parent > i) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun validate_request(req: *of.DebugProduceRequest) R.Result[R.Void, str] {
    if (req == nil) { ret R.err[R.Void, str]("dwarf.produce: nil request"); }
    if (req.image == nil) { ret R.err[R.Void, str]("dwarf.produce: nil object image"); }
    val s: *debug_input.DebugProgram = ?req.program;
    val image: *of.ObjectImage = req.image;
    if (s.alloc == nil || s.interner == nil || s.types == nil || s.sources == nil
        || s.type_aligns == nil || s.type_packed == nil
        || s.ir_module == nil || s.mir_module == nil || s.pointer_width == 0
        || s.dwarf_reg == nil) {
        ret R.err[R.Void, str]("dwarf.produce: incomplete debug program view");
    }
    if (s.field_epoch != semtype.field_epoch(s.types)) {
        ret R.err[R.Void, str]("dwarf.produce: debug type view is stale");
    }
    if (s.layout.ptr_width != s.pointer_width) {
        ret R.err[R.Void, str]("dwarf.produce: debug layout does not match the target pointer width");
    }
    if (image.interner != s.interner) {
        ret R.err[R.Void, str]("dwarf.produce: object image does not share the debug program interner");
    }
    val image_valid: R.Result[R.Void, str] = of.validate_owned_object(image);
    if (R.is_err[R.Void, str](image_valid)) {
        ret image_valid;
    }
    if (((req.row_count == 0) != (req.rows == nil))
        || ((req.varloc_count == 0) != (req.varlocs == nil))
        || ((req.inline_pc_count == 0) != (req.inline_pcs == nil))) {
        ret R.err[R.Void, str]("dwarf.produce: debug input has a noncanonical span shape");
    }
    if (req.text_section >= image.section_count
        || image.sections[req.text_section].kind != of.SK_TEXT) {
        ret R.err[R.Void, str]("dwarf.produce: text section is absent or has the wrong section kind");
    }
    val text_len: u32 = image.sections[req.text_section].len;
    var sym_i: u32 = 0;
    for (sym_i < image.symbol_count) {
        val sym: *of.Symbol = ?image.symbols[sym_i];
        if ((sym.flags & of.SYM_OBJ_FLAG_FUNCTION) != 0 && sym.section == req.text_section
            && (sym.offset > text_len || sym.size > text_len - sym.offset)) {
            ret R.err[R.Void, str]("dwarf.produce: function symbol lies outside the text section");
        }
        sym_i = sym_i + 1;
    }
    var row_i: u32 = 0;
    for (row_i < req.row_count) {
        val row: *enc.LineRow = ?req.rows[row_i];
        if (row.sec != req.text_section || row.text_offset > text_len) {
            ret R.err[R.Void, str]("dwarf.produce: line row lies outside the selected text section");
        }
        var row_j: u32 = 0;
        for (row_j < row_i) {
            if (req.rows[row_j].sec == row.sec
                && req.rows[row_j].text_offset > row.text_offset) {
                ret R.err[R.Void, str]("dwarf.produce: line rows are not monotonic within a section");
            }
            row_j = row_j + 1;
        }
        row_i = row_i + 1;
    }
    var inline_i: u32 = 0;
    for (inline_i < req.inline_pc_count) {
        val pc: *enc.InlinePc = ?req.inline_pcs[inline_i];
        if (pc.sec != req.text_section || pc.text_offset >= text_len) {
            ret R.err[R.Void, str]("dwarf.produce: inline PC lies outside the selected text section");
        }
        var inline_j: u32 = 0;
        for (inline_j < inline_i) {
            if (req.inline_pcs[inline_j].sec == pc.sec
                && req.inline_pcs[inline_j].text_offset > pc.text_offset) {
                ret R.err[R.Void, str]("dwarf.produce: inline PCs are not monotonic within a section");
            }
            inline_j = inline_j + 1;
        }
        val fn: *ir.Function = ir_function_at(image, s.ir_module, pc.sec, pc.text_offset);
        if (!inline_tree_valid(fn) || (pc.inline_site != 0 && pc.inline_site > fn.inline_site_len)) {
            ret R.err[R.Void, str]("dwarf.produce: inline PC refers to an invalid inline site");
        }
        inline_i = inline_i + 1;
    }
    var var_i: u32 = 0;
    for (var_i < req.varloc_count) {
        val loc: *enc.VarLoc = ?req.varlocs[var_i];
        if (loc.sec != req.text_section || loc.text_offset >= text_len
            || (loc.end_offset != 0
                && (loc.end_offset < loc.text_offset || loc.end_offset > text_len))) {
            ret R.err[R.Void, str]("dwarf.produce: variable location range lies outside the selected text section");
        }
        val fn: *ir.Function = ir_function_at(image, s.ir_module, loc.sec, loc.text_offset);
        if (fn == nil || loc.iid >= fn.instr_len) {
            ret R.err[R.Void, str]("dwarf.produce: variable location refers to an invalid instruction");
        }
        if (loc.end_offset != 0) {
            val end_fn: *ir.Function = ir_function_at(image, s.ir_module, loc.sec, loc.end_offset - 1);
            if (end_fn != fn) {
                ret R.err[R.Void, str]("dwarf.produce: variable location crosses a function boundary");
            }
        }
        var_i = var_i + 1;
    }
    ret R.ok_void[str]();
}

pub fun produce(req: *of.DebugProduceRequest) R.Result[R.Void, str] {
    val valid: R.Result[R.Void, str] = validate_request(req);
    if (R.is_err[R.Void, str](valid)) { ret valid; }
    val s: *debug_input.DebugProgram = ?req.program;
    val image: *of.ObjectImage = req.image;
    val irmod: *ir.Module = s.ir_module;
    val mirmod: *mir.MirModule = s.mir_module;
    val rows: *enc.LineRow = req.rows;
    val row_count: u32 = req.row_count;
    val varlocs: *enc.VarLoc = req.varlocs;
    val varloc_count: u32 = req.varloc_count;
    val inline_pcs: *enc.InlinePc = req.inline_pcs;
    val inline_pc_count: u32 = req.inline_pc_count;
    val producer_id: intern.StrId = req.producer;
    val comp_dir_id: intern.StrId = req.comp_dir;
    val text_sec: u32 = req.text_section;
    val nfuncs: u32 = count_funcs(image, text_sec);
    if (nfuncs == 0) { ret R.ok_void[str](); }

    val fb_reg:      i32 = frame_base_reg(s);
    val fb_omit_reg: i32 = frame_base_omit_reg(s);
    if (fb_reg < 0 || fb_omit_reg < 0) {
        ret R.err[R.Void, str]("dwarf.produce: target has no DWARF register mapping for its frame or stack pointer register");
    }

    val address_size: u8 = s.pointer_width::u8;
    val ak_r: R.Result[of.RelocKind, str] = of.abs_kind_for_pointer_width(s.pointer_width);
    if (R.is_err[of.RelocKind, str](ak_r)) { ret R.err[R.Void, str](R.unwrap_err[of.RelocKind, str](ak_r)); }
    val addr_kind: of.RelocKind = R.unwrap_ok[of.RelocKind, str](ak_r);
    val itn: *intern.Interner = image.interner;
    val producer: str = resolve(itn, producer_id);
    val comp_dir: str = resolve(itn, comp_dir_id);

    val rf: R.Result[*DwFunc, str] = A.allocate[DwFunc](s.alloc, nfuncs::usize);
    if (R.is_err[*DwFunc, str](rf)) { ret R.err[R.Void, str](R.unwrap_err[*DwFunc, str](rf)); }
    val funcs: *DwFunc = R.unwrap_ok[*DwFunc, str](rf);
    gather_funcs(image, mirmod, text_sec, funcs);

    val text_len: u32 = image.sections[text_sec].len;
    var fi0: u32 = 0;
    for (fi0 < nfuncs) {
        var end: u32 = text_len;
        if (fi0 + 1 < nfuncs) { end = funcs[fi0 + 1].offset; }
        funcs[fi0].size = end - funcs[fi0].offset;
        fi0 = fi0 + 1;
    }

    var ft: FileTable;
    ft.count = 0;
    var r: u32 = 0;
    for (r < row_count) {
        if (rows[r].sec == text_sec && source.loc_is_valid(rows[r].loc)) {
            file_index(?ft, rows[r].loc.file);
        }
        r = r + 1;
    }

    var name: str = comp_dir;
    if (ft.count > 0) { name = file_path(s, ft.ids[0]); }

    val rs2: R.Result[*DwFunc, str] = A.allocate[DwFunc](s.alloc, nfuncs::usize);
    if (R.is_err[*DwFunc, str](rs2)) { A.deallocate[DwFunc](s.alloc, funcs, nfuncs::usize); ret R.err[R.Void, str](R.unwrap_err[*DwFunc, str](rs2)); }
    val subs: *DwFunc = R.unwrap_ok[*DwFunc, str](rs2);
    var nsub: u32 = 0;
    var si: u32 = 0;
    for (si < nfuncs) {
        subs[nsub] = funcs[si]; nsub = nsub + 1;
        si = si + 1;
    }

    var tot_sites: u32 = 0;
    var max_depth: u32 = 1;
    inline_caps(irmod, subs, nsub, ?tot_sites, ?max_depth);

    var var_cap: u32 = varloc_count;
    if (var_cap == 0) { var_cap = 1; }
    val rv: R.Result[*DwVar, str] = A.allocate[DwVar](s.alloc, var_cap::usize);
    if (R.is_err[*DwVar, str](rv)) { A.deallocate[DwFunc](s.alloc, subs, nfuncs::usize); A.deallocate[DwFunc](s.alloc, funcs, nfuncs::usize); ret R.err[R.Void, str](R.unwrap_err[*DwVar, str](rv)); }
    val vars: *DwVar = R.unwrap_ok[*DwVar, str](rv);

    val range_cap: u32 = var_cap;
    val rgr: R.Result[*LocRange, str] = A.allocate[LocRange](s.alloc, range_cap::usize);
    if (R.is_err[*LocRange, str](rgr)) {
        A.deallocate[DwVar](s.alloc, vars, var_cap::usize); A.deallocate[DwFunc](s.alloc, subs, nfuncs::usize); A.deallocate[DwFunc](s.alloc, funcs, nfuncs::usize);
        ret R.err[R.Void, str](R.unwrap_err[*LocRange, str](rgr));
    }
    val ranges: *LocRange = R.unwrap_ok[*LocRange, str](rgr);

    var tc: TypeCtx = type_ctx_init(s.alloc);
    var strtab: StrTab;
    strtab.buf = enc.buf_init(s.alloc);
    var var_count: u32 = 0;
    var range_count: u32 = 0;

    var dtypes: ir_type.IrTypeTable;
    val rdt: O.Option[str] = ir_type.init(?dtypes, s.alloc);
    if (O.is_some[str](rdt)) {
        enc.buf_dnit(?strtab.buf); type_ctx_dnit(?tc);
        A.deallocate[LocRange](s.alloc, ranges, range_cap::usize); A.deallocate[DwVar](s.alloc, vars, var_cap::usize);
        A.deallocate[DwFunc](s.alloc, subs, nfuncs::usize); A.deallocate[DwFunc](s.alloc, funcs, nfuncs::usize);
        ret R.err[R.Void, str](O.unwrap[str](rdt));
    }
    gather_subprograms(s, irmod, subs, nsub, rows, row_count, varlocs, varloc_count, text_sec, ?ft, address_size,
                       ?tc, ?strtab, ?dtypes, vars, ?var_count, var_cap, ranges, ?range_count, range_cap);
    ir_type.dnit(?dtypes);

    var has_loclists: bool = false;
    var lv: u32 = 0;
    for (lv < var_count) { if (vars[lv].loc_kind == VLOC_LOCLIST) { has_loclists = true; } lv = lv + 1; }

    val ra: R.Result[*u32, str] = A.allocate[u32](s.alloc, nfuncs::usize);
    if (R.is_err[*u32, str](ra)) {
        enc.buf_dnit(?strtab.buf); type_ctx_dnit(?tc);
        A.deallocate[LocRange](s.alloc, ranges, range_cap::usize); A.deallocate[DwVar](s.alloc, vars, var_cap::usize);
        A.deallocate[DwFunc](s.alloc, subs, nfuncs::usize); A.deallocate[DwFunc](s.alloc, funcs, nfuncs::usize);
        ret R.err[R.Void, str](R.unwrap_err[*u32, str](ra));
    }
    val addr_off: *u32 = R.unwrap_ok[*u32, str](ra);

    val reloc_cap: u32 = 2 + 2 * nsub + tc.ntypes + tc.nmemb + 2 * var_count + 2 * tot_sites;
    val rr2: R.Result[*InfoReloc, str] = A.allocate[InfoReloc](s.alloc, reloc_cap::usize);
    if (R.is_err[*InfoReloc, str](rr2)) {
        A.deallocate[u32](s.alloc, addr_off, nfuncs::usize); enc.buf_dnit(?strtab.buf);
        type_ctx_dnit(?tc);
        A.deallocate[LocRange](s.alloc, ranges, range_cap::usize); A.deallocate[DwVar](s.alloc, vars, var_cap::usize);
        A.deallocate[DwFunc](s.alloc, subs, nfuncs::usize); A.deallocate[DwFunc](s.alloc, funcs, nfuncs::usize);
        ret R.err[R.Void, str](R.unwrap_err[*InfoReloc, str](rr2));
    }
    val info_relocs: *InfoReloc = R.unwrap_ok[*InfoReloc, str](rr2);
    var info_reloc_count: u32 = 0;

    val loc_reloc_cap: u32 = var_count + 1;
    val rlr: R.Result[*LocReloc, str] = A.allocate[LocReloc](s.alloc, loc_reloc_cap::usize);
    if (R.is_err[*LocReloc, str](rlr)) {
        A.deallocate[InfoReloc](s.alloc, info_relocs, reloc_cap::usize);
        A.deallocate[u32](s.alloc, addr_off, nfuncs::usize); enc.buf_dnit(?strtab.buf);
        type_ctx_dnit(?tc);
        A.deallocate[LocRange](s.alloc, ranges, range_cap::usize); A.deallocate[DwVar](s.alloc, vars, var_cap::usize);
        A.deallocate[DwFunc](s.alloc, subs, nfuncs::usize); A.deallocate[DwFunc](s.alloc, funcs, nfuncs::usize);
        ret R.err[R.Void, str](R.unwrap_err[*LocReloc, str](rlr));
    }
    val loc_relocs: *LocReloc = R.unwrap_ok[*LocReloc, str](rlr);
    var loc_reloc_count: u32 = 0;

    var b_abbrev:   enc.ByteBuf = enc.buf_init(s.alloc);
    var b_line:     enc.ByteBuf = enc.buf_init(s.alloc);
    var b_info:     enc.ByteBuf = enc.buf_init(s.alloc);
    var b_loclists: enc.ByteBuf = enc.buf_init(s.alloc);
    var b_rnglists: enc.ByteBuf = enc.buf_init(s.alloc);

    var inl_cap: u32 = tot_sites;
    if (inl_cap == 0) { inl_cap = 1; }
    var ir_cap: u32 = inline_pc_count * max_depth;
    if (ir_cap == 0) { ir_cap = 1; }
    val rinl: R.Result[*DwInline, str] = A.allocate[DwInline](s.alloc, inl_cap::usize);
    if (R.is_err[*DwInline, str](rinl)) {
        enc.buf_dnit(?b_rnglists); enc.buf_dnit(?b_loclists); enc.buf_dnit(?b_info); enc.buf_dnit(?b_line); enc.buf_dnit(?b_abbrev); enc.buf_dnit(?strtab.buf);
        A.deallocate[LocReloc](s.alloc, loc_relocs, loc_reloc_cap::usize); A.deallocate[InfoReloc](s.alloc, info_relocs, reloc_cap::usize);
        A.deallocate[u32](s.alloc, addr_off, nfuncs::usize); type_ctx_dnit(?tc);
        A.deallocate[LocRange](s.alloc, ranges, range_cap::usize); A.deallocate[DwVar](s.alloc, vars, var_cap::usize);
        A.deallocate[DwFunc](s.alloc, subs, nfuncs::usize); A.deallocate[DwFunc](s.alloc, funcs, nfuncs::usize);
        ret R.err[R.Void, str](R.unwrap_err[*DwInline, str](rinl));
    }
    val inlines: *DwInline = R.unwrap_ok[*DwInline, str](rinl);
    val rirng: R.Result[*DwInlineRange, str] = A.allocate[DwInlineRange](s.alloc, ir_cap::usize);
    if (R.is_err[*DwInlineRange, str](rirng)) {
        A.deallocate[DwInline](s.alloc, inlines, inl_cap::usize);
        enc.buf_dnit(?b_rnglists); enc.buf_dnit(?b_loclists); enc.buf_dnit(?b_info); enc.buf_dnit(?b_line); enc.buf_dnit(?b_abbrev); enc.buf_dnit(?strtab.buf);
        A.deallocate[LocReloc](s.alloc, loc_relocs, loc_reloc_cap::usize); A.deallocate[InfoReloc](s.alloc, info_relocs, reloc_cap::usize);
        A.deallocate[u32](s.alloc, addr_off, nfuncs::usize); type_ctx_dnit(?tc);
        A.deallocate[LocRange](s.alloc, ranges, range_cap::usize); A.deallocate[DwVar](s.alloc, vars, var_cap::usize);
        A.deallocate[DwFunc](s.alloc, subs, nfuncs::usize); A.deallocate[DwFunc](s.alloc, funcs, nfuncs::usize);
        ret R.err[R.Void, str](R.unwrap_err[*DwInlineRange, str](rirng));
    }
    val iranges: *DwInlineRange = R.unwrap_ok[*DwInlineRange, str](rirng);
    var ninl: u32 = 0;
    var nir:  u32 = 0;
    val rgi: R.Result[R.Void, str] = gather_inlines(s, irmod, subs, nsub, inline_pcs, inline_pc_count, text_sec, ?ft, inlines, ?ninl, inl_cap, iranges, ?nir, ir_cap);
    if (R.is_err[R.Void, str](rgi)) {
        A.deallocate[DwInlineRange](s.alloc, iranges, ir_cap::usize); A.deallocate[DwInline](s.alloc, inlines, inl_cap::usize);
        enc.buf_dnit(?b_rnglists); enc.buf_dnit(?b_loclists); enc.buf_dnit(?b_info); enc.buf_dnit(?b_line); enc.buf_dnit(?b_abbrev); enc.buf_dnit(?strtab.buf);
        A.deallocate[LocReloc](s.alloc, loc_relocs, loc_reloc_cap::usize); A.deallocate[InfoReloc](s.alloc, info_relocs, reloc_cap::usize);
        A.deallocate[u32](s.alloc, addr_off, nfuncs::usize); type_ctx_dnit(?tc);
        A.deallocate[LocRange](s.alloc, ranges, range_cap::usize); A.deallocate[DwVar](s.alloc, vars, var_cap::usize);
        A.deallocate[DwFunc](s.alloc, subs, nfuncs::usize); A.deallocate[DwFunc](s.alloc, funcs, nfuncs::usize);
        ret rgi;
    }

    val has_rnglists: bool = true;
    val rng_reloc_cap: u32 = nsub + inl_cap + 1;
    val rrr: R.Result[*RngReloc, str] = A.allocate[RngReloc](s.alloc, rng_reloc_cap::usize);
    if (R.is_err[*RngReloc, str](rrr)) {
        A.deallocate[DwInlineRange](s.alloc, iranges, ir_cap::usize); A.deallocate[DwInline](s.alloc, inlines, inl_cap::usize);
        enc.buf_dnit(?b_rnglists); enc.buf_dnit(?b_loclists); enc.buf_dnit(?b_info); enc.buf_dnit(?b_line); enc.buf_dnit(?b_abbrev); enc.buf_dnit(?strtab.buf);
        A.deallocate[LocReloc](s.alloc, loc_relocs, loc_reloc_cap::usize); A.deallocate[InfoReloc](s.alloc, info_relocs, reloc_cap::usize);
        A.deallocate[u32](s.alloc, addr_off, nfuncs::usize); type_ctx_dnit(?tc);
        A.deallocate[LocRange](s.alloc, ranges, range_cap::usize); A.deallocate[DwVar](s.alloc, vars, var_cap::usize);
        A.deallocate[DwFunc](s.alloc, subs, nfuncs::usize); A.deallocate[DwFunc](s.alloc, funcs, nfuncs::usize);
        ret R.err[R.Void, str](R.unwrap_err[*RngReloc, str](rrr));
    }
    val rng_relocs: *RngReloc = R.unwrap_ok[*RngReloc, str](rrr);
    var rng_reloc_count: u32 = 0;

    val fixup_cap: u32 = tc.ntypes + tc.nmemb + 1;
    val rfx: R.Result[*TypeFixup, str] = A.allocate[TypeFixup](s.alloc, fixup_cap::usize);
    if (R.is_err[*TypeFixup, str](rfx)) {
        A.deallocate[RngReloc](s.alloc, rng_relocs, rng_reloc_cap::usize);
        A.deallocate[DwInlineRange](s.alloc, iranges, ir_cap::usize); A.deallocate[DwInline](s.alloc, inlines, inl_cap::usize);
        enc.buf_dnit(?b_rnglists); enc.buf_dnit(?b_loclists); enc.buf_dnit(?b_info); enc.buf_dnit(?b_line); enc.buf_dnit(?b_abbrev); enc.buf_dnit(?strtab.buf);
        A.deallocate[LocReloc](s.alloc, loc_relocs, loc_reloc_cap::usize); A.deallocate[InfoReloc](s.alloc, info_relocs, reloc_cap::usize);
        A.deallocate[u32](s.alloc, addr_off, nfuncs::usize); type_ctx_dnit(?tc);
        A.deallocate[LocRange](s.alloc, ranges, range_cap::usize); A.deallocate[DwVar](s.alloc, vars, var_cap::usize);
        A.deallocate[DwFunc](s.alloc, subs, nfuncs::usize); A.deallocate[DwFunc](s.alloc, funcs, nfuncs::usize);
        ret R.err[R.Void, str](R.unwrap_err[*TypeFixup, str](rfx));
    }
    val type_fixups: *TypeFixup = R.unwrap_ok[*TypeFixup, str](rfx);

    build_abbrev(?b_abbrev);
    build_line(s, funcs, nfuncs, rows, row_count, text_sec, address_size, comp_dir, name, ?ft, ?b_line, addr_off);
    if (has_loclists) {
        build_loclists(?b_loclists, subs, nsub, vars, ranges, address_size, loc_relocs, ?loc_reloc_count, loc_reloc_cap);
    }
    var cu_rnglist_off: u32 = 0;
    build_rnglists(?b_rnglists, subs, nsub, inlines, ninl, iranges, address_size,
                   rng_relocs, ?rng_reloc_count, rng_reloc_cap, ?cu_rnglist_off);
    var stmt_off: u32 = 0;
    build_info(?b_info, address_size, addr_kind, producer, name, comp_dir, cu_rnglist_off,
               fb_reg, fb_omit_reg,
               subs, nsub, ?tc, vars, info_relocs, ?info_reloc_count, reloc_cap, ?stmt_off,
               s, irmod, ?strtab, inlines, ninl, iranges, type_fixups, fixup_cap);

    val pr: R.Result[R.Void, str] = install(s, image, itn, funcs, nfuncs,
                                          ?b_abbrev, ?b_line, ?b_info, ?strtab.buf, ?b_loclists, has_loclists,
                                          ?b_rnglists, has_rnglists, addr_off, addr_kind, stmt_off, info_relocs, info_reloc_count,
                                          loc_relocs, loc_reloc_count, rng_relocs, rng_reloc_count);

    enc.buf_dnit(?b_abbrev);
    enc.buf_dnit(?b_line);
    enc.buf_dnit(?b_info);
    enc.buf_dnit(?b_loclists);
    enc.buf_dnit(?b_rnglists);
    enc.buf_dnit(?strtab.buf);
    A.deallocate[TypeFixup](s.alloc, type_fixups, fixup_cap::usize);
    A.deallocate[DwInlineRange](s.alloc, iranges, ir_cap::usize);
    A.deallocate[DwInline](s.alloc, inlines, inl_cap::usize);
    A.deallocate[RngReloc](s.alloc, rng_relocs, rng_reloc_cap::usize);
    A.deallocate[LocReloc](s.alloc, loc_relocs, loc_reloc_cap::usize);
    A.deallocate[InfoReloc](s.alloc, info_relocs, reloc_cap::usize);
    A.deallocate[u32](s.alloc, addr_off, nfuncs::usize);
    type_ctx_dnit(?tc);
    A.deallocate[LocRange](s.alloc, ranges, range_cap::usize);
    A.deallocate[DwVar](s.alloc, vars, var_cap::usize);
    A.deallocate[DwFunc](s.alloc, subs, nfuncs::usize);
    A.deallocate[DwFunc](s.alloc, funcs, nfuncs::usize);
    if (R.is_err[R.Void, str](pr)) { ret pr; }
    ret R.ok_void[str]();
}


fun supports(tgt: *debug_input.DebugTarget) bool {
    ret tgt != nil && tgt.dwarf_reg != nil;
}

pub fun debug_descriptor() of.DebugVTable {
    var descriptor: of.DebugVTable;
    descriptor.id       = of.DBG_DWARF;
    descriptor.name     = "dwarf";
    descriptor.produce  = produce;
    descriptor.supports = supports;
    ret descriptor;
}

fun gather_subprograms(s: *debug_input.DebugProgram, irmod: *ir.Module,
                       funcs: *DwFunc, nfuncs: u32, rows: *enc.LineRow, row_count: u32,
                       varlocs: *enc.VarLoc, varloc_count: u32, text_sec: u32,
                       ft: *FileTable, address_size: u8, tc: *TypeCtx, strtab: *StrTab,
                       dtypes: *ir_type.IrTypeTable,
                       vars: *DwVar, var_count: *u32, var_cap: u32,
                       ranges: *LocRange, range_count: *u32, range_cap: u32) {
    var i: u32 = 0;
    for (i < nfuncs) {
        val fn: *DwFunc = ?funcs[i];
        fn.decl_file = 0;
        fn.decl_line = 0;
        fn.disp      = intern.STR_NIL;
        fn.ret_ty    = -1;
        fn.var_start = @var_count;
        fn.var_count = 0;

        var ret_sem: semtype.TypeId = semtype.TYPE_NIL;
        var irfn: *ir.Function = nil;
        val opt_idx: O.Option[u32] = ir.function_lookup(irmod, fn.name);
        if (O.is_some[u32](opt_idx)) {
            irfn = ?irmod.functions[O.unwrap[u32](opt_idx)];
            fn.disp = irfn.disp;
            ret_sem = irfn.ret_sem;
        }

        var nm: str = resolve(s.interner, fn.disp);
        if (fn.disp == intern.STR_NIL) { nm = resolve(s.interner, fn.name); }
        fn.disp_off = str_off(strtab, nm);

        val first: O.Option[source.SrcLoc] = first_row_loc(rows, row_count, text_sec, fn.offset, fn.offset + fn.size);
        if (O.is_some[source.SrcLoc](first)) {
            val pl: PosLine = pos_of(s, O.unwrap[source.SrcLoc](first), ft);
            fn.decl_file = pl.file;
            fn.decl_line = pl.line::u32;
        }

        fn.ret_ty = type_intern(s, dtypes, tc, strtab, ret_sem, address_size);

        if (irfn != nil) {
            gather_vars(s, irmod, dtypes, irfn, fn.offset, fn.offset + fn.size, varlocs, varloc_count, text_sec,
                        address_size, tc, strtab, vars, var_count, var_cap, ranges, range_count, range_cap);
            fn.var_count = @var_count - fn.var_start;
        }
        i = i + 1;
    }
}

fun inline_ancestor_or_self(irfn: *ir.Function, k: u32, s: u32) bool {
    var cur: u32 = s;
    for (cur != 0) {
        if (cur == k) { ret true; }
        val ps: *ir.InlineSite = ?irfn.inline_sites[cur - 1];
        cur = ps.parent;
    }
    ret false;
}

fun inline_caps(irmod: *ir.Module, funcs: *DwFunc, nfuncs: u32, total: *u32, max_depth: *u32) {
    @total = 0;
    @max_depth = 1;
    var i: u32 = 0;
    for (i < nfuncs) {
        val oi: O.Option[u32] = ir.function_lookup(irmod, funcs[i].name);
        if (O.is_none[u32](oi)) { i = i + 1; cnt; }
        val irfn: *ir.Function = ?irmod.functions[O.unwrap[u32](oi)];
        @total = @total + irfn.inline_site_len;
        var k: u32 = 1;
        for (k <= irfn.inline_site_len) {
            var d: u32 = 0;
            var cur: u32 = k;
            for (cur != 0) { d = d + 1; val ps: *ir.InlineSite = ?irfn.inline_sites[cur - 1]; cur = ps.parent; }
            if (d > @max_depth) { @max_depth = d; }
            k = k + 1;
        }
        i = i + 1;
    }
}

fun gather_inlines(s: *debug_input.DebugProgram, irmod: *ir.Module, funcs: *DwFunc, nfuncs: u32,
                   inline_pcs: *enc.InlinePc, inline_pc_count: u32, text_sec: u32, ft: *FileTable,
                   out: *DwInline, ninl: *u32, inl_cap: u32,
                   iranges: *DwInlineRange, nir: *u32, ir_cap: u32) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < nfuncs) {
        val opt_idx: O.Option[u32] = ir.function_lookup(irmod, funcs[i].name);
        if (O.is_none[u32](opt_idx)) { i = i + 1; cnt; }
        val irfn: *ir.Function = ?irmod.functions[O.unwrap[u32](opt_idx)];
        if (irfn.inline_site_len == 0) { i = i + 1; cnt; }
        val lo: u32 = funcs[i].offset;
        val hi: u32 = funcs[i].offset + funcs[i].size;

        var k: u32 = 1;
        for (k <= irfn.inline_site_len) {
            if (@ninl >= inl_cap) { ret R.err[R.Void, str]("dwarf.gather_inlines: inline-instance capacity exceeded"); }
            val site: *ir.InlineSite = ?irfn.inline_sites[k - 1];
            val di: *DwInline = ?out[@ninl];
            di.func_idx    = i;
            di.callee      = site.callee;
            di.origin_off  = 0;
            di.parent      = site.parent;
            di.site_id     = k;
            di.range_start = @nir;
            di.range_count = 0;
            di.rnglist_off = 0;
            if (source.loc_is_valid(site.call_loc)) {
                file_index(ft, site.call_loc.file);
                val pl: PosLine = pos_of(s, site.call_loc, ft);
                di.call_file = pl.file;
                di.call_line = pl.line::u32;
            }
            or {
                di.call_file = funcs[i].decl_file;
                di.call_line = funcs[i].decl_line;
            }

            var j: u32 = 0;
            for (j < inline_pc_count) {
                val o: u32 = inline_pcs[j].text_offset;
                if (inline_pcs[j].sec == text_sec && o >= lo && o < hi && inline_ancestor_or_self(irfn, k, inline_pcs[j].inline_site)) {
                    var seg_end: u32 = hi;
                    var jn: u32 = j + 1;
                    for (jn < inline_pc_count && inline_pcs[jn].sec != text_sec) { jn = jn + 1; }
                    if (jn < inline_pc_count && inline_pcs[jn].text_offset < hi) { seg_end = inline_pcs[jn].text_offset; }
                    if (o < seg_end) {
                        if (@nir >= ir_cap) { ret R.err[R.Void, str]("dwarf.gather_inlines: inline-range capacity exceeded"); }
                        iranges[@nir].start = o;
                        iranges[@nir].end   = seg_end;
                        @nir = @nir + 1;
                        di.range_count = di.range_count + 1;
                    }
                }
                j = j + 1;
            }

            if (di.range_count > 0) { @ninl = @ninl + 1; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun gather_vars(s: *debug_input.DebugProgram, irmod: *ir.Module, dtypes: *ir_type.IrTypeTable, irfn: *ir.Function, lo: u32, hi: u32,
                varlocs: *enc.VarLoc, varloc_count: u32, text_sec: u32, address_size: u8,
                tc: *TypeCtx, strtab: *StrTab, vars: *DwVar, var_count: *u32, var_cap: u32,
                ranges: *LocRange, range_count: *u32, range_cap: u32) {
    val fn_var_start: u32 = @var_count;

    var i: u32 = 0;
    for (i < varloc_count) {
        val vl: *enc.VarLoc = ?varlocs[i];
        if (vl.sec != text_sec || vl.text_offset < lo || vl.text_offset >= hi) { i = i + 1; cnt; }
        val obt: O.Option[u32] = varloc_ident(s, irmod, dtypes, irfn, vl, address_size, tc, strtab);
        if (O.is_none[u32](obt)) { i = i + 1; cnt; }
        val name_off: u32 = O.unwrap[u32](obt);
        val vsite: u32 = ir.instr_inline_site_of(irfn, vl.iid::id.InstructionId);

        var found: bool = false;
        var j: u32 = fn_var_start;
        for (j < @var_count) { if (vars[j].name_off == name_off && vars[j].inline_site == vsite) { found = true; } j = j + 1; }
        if (!found && @var_count < var_cap) {
            val dv: *ir.DbgVar = O.unwrap[*ir.DbgVar](ir.dbg_var_get(irfn, vl.iid::id.InstructionId));
            val ty: i32 = type_intern(s, dtypes, tc, strtab, dv.ty_sem, address_size);
            vars[@var_count].name_off    = name_off;
            vars[@var_count].ty          = ty;
            vars[@var_count].is_param    = dv.is_param;
            vars[@var_count].loc_kind    = VLOC_NONE;
            vars[@var_count].reg         = 0;
            vars[@var_count].offset      = 0;
            vars[@var_count].net         = 0;
            vars[@var_count].range_start = 0;
            vars[@var_count].range_count = 0;
            vars[@var_count].loclist_off = 0;
            vars[@var_count].inline_site = vsite;
            vars[@var_count].byref       = type_is_aggregate(tc, ty);
            vars[@var_count].storage     = false;
            @var_count = @var_count + 1;
        }
        i = i + 1;
    }

    var vi: u32 = fn_var_start;
    for (vi < @var_count) {
        val v: *DwVar = ?vars[vi];
        v.range_start = @range_count;
        var k: u32 = 0;
        for (k < varloc_count) {
            val vl: *enc.VarLoc = ?varlocs[k];
            if (vl.sec != text_sec || vl.text_offset < lo || vl.text_offset >= hi) { k = k + 1; cnt; }
            if (@range_count >= range_cap) { k = k + 1; cnt; }
            val oid: O.Option[u32] = varloc_ident(s, irmod, dtypes, irfn, vl, address_size, tc, strtab);
            if (O.is_none[u32](oid)) { k = k + 1; cnt; }
            if (O.unwrap[u32](oid) != v.name_off) { k = k + 1; cnt; }

            var kind: u8 = VLOC_NONE;
            var reg:  i32 = 0;
            var off:  i64 = 0;
            var storage: bool = false;
            var end: u32 = hi;
            var kind1: u8 = VLOC_NONE; var kind2: u8 = VLOC_NONE;
            var reg2: i32 = 0; var off2: i64 = 0;
            var cmp_rel: u8 = 0; var cmp_signed: bool = false; var cmp_width: u8 = 0;
            varloc_home(s, vl, ?kind, ?reg, ?off, ?storage);
            if (kind == VLOC_NONE) {
                val oc: O.Option[i64] = ir.dbg_value_const(irfn, vl.iid::id.InstructionId);
                if (O.is_some[i64](oc)) { kind = VLOC_CONST; off = O.unwrap[i64](oc); }
            }
            if (vl.kind == enc.VARLOC_CMP) {
                kind1 = cmp_sub_home(s, vl.sub_lhs, vl.reg, vl.off, ?reg, ?off);
                kind2 = cmp_sub_home(s, vl.sub_rhs, vl.reg2, vl.off2, ?reg2, ?off2);
                if (kind1 == VLOC_NONE || kind2 == VLOC_NONE) {
                    kind = VLOC_NONE;
                }
                or {
                    kind       = VLOC_CMP;
                    cmp_rel    = vl.cmp_rel;
                    cmp_signed = vl.cmp_signed;
                    cmp_width  = vl.cmp_width;
                    if (vl.end_offset != 0) { end = vl.end_offset; }
                }
            }
            ranges[@range_count].start   = vl.text_offset;
            ranges[@range_count].end     = end;
            ranges[@range_count].kind    = kind;
            ranges[@range_count].reg     = reg;
            ranges[@range_count].off     = off;
            ranges[@range_count].net     = dbg_expr_net(irfn, vl.iid::id.InstructionId);
            ranges[@range_count].storage = storage;
            ranges[@range_count].kind1      = kind1;
            ranges[@range_count].kind2      = kind2;
            ranges[@range_count].reg2       = reg2;
            ranges[@range_count].off2       = off2;
            ranges[@range_count].cmp_rel    = cmp_rel;
            ranges[@range_count].cmp_signed = cmp_signed;
            ranges[@range_count].cmp_width  = cmp_width;
            ranges[@range_count].reused     = false;
            @range_count = @range_count + 1;
            k = k + 1;
        }
        v.range_count = @range_count - v.range_start;

        sort_ranges(ranges, v.range_start, @range_count);
        var r: u32 = v.range_start;
        for (r + 1 < @range_count) {
            if (ranges[r].kind != VLOC_CMP) { ranges[r].end = ranges[r + 1].start; }
            r = r + 1;
        }

        vi = vi + 1;
    }

    var vi2: u32 = fn_var_start;
    for (vi2 < @var_count) {
        val v2: *DwVar = ?vars[vi2];
        var r2: u32 = v2.range_start;
        val vend2: u32 = v2.range_start + v2.range_count;
        for (r2 < vend2) {
            val rg2: *LocRange = ?ranges[r2];
            if (range_real_home(v2, rg2)) {
                bound_storage_reuse(vars, ranges, fn_var_start, @var_count, vi2, rg2);
            }
            r2 = r2 + 1;
        }
        vi2 = vi2 + 1;
    }

    var vi3: u32 = fn_var_start;
    for (vi3 < @var_count) {
        classify_var(?vars[vi3], ranges);
        vi3 = vi3 + 1;
    }
}

fun bound_storage_reuse(vars: *DwVar, ranges: *LocRange, fn_var_start: u32, var_count: u32, vi: u32, rg: *LocRange) {
    val site: u32 = vars[vi].inline_site;
    var vj: u32 = fn_var_start;
    for (vj < var_count) {
        if (vj == vi || vars[vj].inline_site != site) { vj = vj + 1; cnt; }
        val other: *DwVar = ?vars[vj];
        var rk: u32 = other.range_start;
        val oend: u32 = other.range_start + other.range_count;
        for (rk < oend) {
            val og: *LocRange = ?ranges[rk];
            if (range_real_home(other, og) && og.start > rg.start && og.start < rg.end
                && home_eq(rg.kind, rg.reg, rg.off, rg.net, og.kind, og.reg, og.off, og.net)) {
                rg.end    = og.start;
                rg.reused = true;
            }
            rk = rk + 1;
        }
        vj = vj + 1;
    }
}

fun cmp_sub_home(tgt: *debug_input.DebugProgram, sub: u8, raw_reg: i32, raw_off: i64, out_reg: *i32, out_off: *i64) u8 {
    @out_reg = 0;
    @out_off = 0;
    if (sub == enc.VARLOC_REG) {
        val f: debug_input.DwarfRegFn = tgt.dwarf_reg;
        val d: i32 = f(raw_reg);
        if (d < 0) { ret VLOC_NONE; }
        @out_reg = d;
        ret VLOC_REG;
    }
    if (sub == enc.VARLOC_FRAME) {
        @out_off = raw_off;
        ret VLOC_FRAME;
    }
    if (sub == enc.VARLOC_IMM) {
        @out_off = raw_off;
        ret VLOC_CONST;
    }
    ret VLOC_NONE;
}

fun varloc_ident(s: *debug_input.DebugProgram, irmod: *ir.Module, dtypes: *ir_type.IrTypeTable, irfn: *ir.Function,
                 vl: *enc.VarLoc, address_size: u8, tc: *TypeCtx, strtab: *StrTab) O.Option[u32] {
    val odv: O.Option[*ir.DbgVar] = ir.dbg_var_get(irfn, vl.iid::id.InstructionId);
    if (O.is_none[*ir.DbgVar](odv)) { ret O.none[u32](); }
    val dv: *ir.DbgVar = O.unwrap[*ir.DbgVar](odv);
    if (dv.name == intern.STR_NIL) { ret O.none[u32](); }
    if (type_intern(s, dtypes, tc, strtab, dv.ty_sem, address_size) < 0) { ret O.none[u32](); }
    ret O.some[u32](str_off(strtab, resolve(s.interner, dv.name)));
}

fun sort_ranges(ranges: *LocRange, start: u32, end: u32) {
    var a: u32 = start + 1;
    for (a < end) {
        val key: LocRange = ranges[a];
        var b: i64 = a::i64 - 1;
        for (b >= start::i64 && ranges[b::u32].start > key.start) {
            ranges[(b + 1)::u32] = ranges[b::u32];
            b = b - 1;
        }
        ranges[(b + 1)::u32] = key;
        a = a + 1;
    }
}

fun range_real_home(v: *DwVar, rg: *LocRange) bool {
    if (rg.kind == VLOC_NONE) { ret false; }
    if (v.byref && rg.kind == VLOC_REG) { ret false; }
    ret true;
}

fun classify_var(v: *DwVar, ranges: *LocRange) {
    var first: i32 = -1;
    var multi: bool = false;
    var reused: bool = false;
    var r: u32 = v.range_start;
    val end: u32 = v.range_start + v.range_count;
    for (r < end) {
        if (range_real_home(v, ?ranges[r])) {
            if (first < 0) {
                first = r::i32;
            } or (!home_eq(ranges[first::u32].kind, ranges[first::u32].reg, ranges[first::u32].off, ranges[first::u32].net,
                           ranges[r].kind, ranges[r].reg, ranges[r].off, ranges[r].net)) {
                multi = true;
            }
            if (ranges[r].reused) { reused = true; }
        }
        r = r + 1;
    }
    if (first < 0)   { v.loc_kind = VLOC_NONE; v.range_count = 0; ret; }
    if (multi)       { v.loc_kind = VLOC_LOCLIST; ret; }
    if (reused)      { v.loc_kind = VLOC_LOCLIST; ret; }
    if (ranges[first::u32].kind == VLOC_CMP) { v.loc_kind = VLOC_LOCLIST; ret; }
    v.loc_kind    = ranges[first::u32].kind;
    v.reg         = ranges[first::u32].reg;
    v.offset      = ranges[first::u32].off;
    v.net         = ranges[first::u32].net;
    v.storage     = ranges[first::u32].storage;
    v.range_count = 0;
}

fun base_intern(tc: *TypeCtx, strtab: *StrTab, bt: TypeDie) i32 {
    var i: u32 = 0;
    for (i < tc.ntypes) {
        if (tc.types[i].kind == TK_BASE && str_equals(tc.types[i].name, bt.name)) { ret i::i32; }
        i = i + 1;
    }
    if (!type_reserve(tc)) { ret -1; }
    var e: TypeDie = bt;
    e.name_off = str_off(strtab, bt.name);
    e.off      = 0;
    tc.types[tc.ntypes] = e;
    tc.ntypes = tc.ntypes + 1;
    ret (tc.ntypes - 1)::i32;
}

fun comp_find(tc: *TypeCtx, sem: semtype.TypeId) i32 {
    var i: u32 = 0;
    for (i < tc.ntypes) {
        if (tc.types[i].kind != TK_BASE && tc.types[i].sem == sem) { ret i::i32; }
        i = i + 1;
    }
    ret -1;
}

fun comp_reserve(tc: *TypeCtx, kind: u8, sem: semtype.TypeId) i32 {
    if (!type_reserve(tc)) { ret -1; }
    val ix: u32 = tc.ntypes;
    tc.types[ix].kind       = kind;
    tc.types[ix].sem        = sem;
    tc.types[ix].off        = 0;
    tc.types[ix].name       = "";
    tc.types[ix].name_off   = 0;
    tc.types[ix].encoding   = 0;
    tc.types[ix].byte_size  = 0;
    tc.types[ix].elem       = -1;
    tc.types[ix].count      = 0;
    tc.types[ix].memb_start = 0;
    tc.types[ix].memb_count = 0;
    tc.ntypes = tc.ntypes + 1;
    ret ix::i32;
}

fun comp_name(s: *debug_input.DebugProgram, t: *semtype.Type) str {
    if (t.kind == semtype.TYPE_REC || t.kind == semtype.TYPE_UNI) { ret resolve(s.interner, t.data.nominal.name); }
    ret "";
}

fun type_intern(s: *debug_input.DebugProgram, dtypes: *ir_type.IrTypeTable, tc: *TypeCtx,
                strtab: *StrTab, sem: semtype.TypeId, address_size: u8) i32 {
    if (sem == semtype.TYPE_NIL || sem == semtype.TYPE_ERROR) { ret -1; }
    val to: O.Option[*semtype.Type] = semtype.get(s.types, sem);
    if (O.is_none[*semtype.Type](to)) { ret -1; }
    val t: *semtype.Type = O.unwrap[*semtype.Type](to);
    val kind: semtype.TypeKind = t.kind;

    if (kind == semtype.TYPE_SECRET) { ret type_intern(s, dtypes, tc, strtab, t.data.secret.base, address_size); }

    val obt: O.Option[TypeDie] = sem_base_type(s, sem, address_size);
    if (O.is_some[TypeDie](obt)) { ret base_intern(tc, strtab, O.unwrap[TypeDie](obt)); }

    val found: i32 = comp_find(tc, sem);
    if (found >= 0) { ret found; }

    if (kind == semtype.TYPE_POINTER) {
        val ptee: semtype.TypeId = t.data.pointer.base;
        val pe: i32 = type_intern(s, dtypes, tc, strtab, ptee, address_size);
        val f2: i32 = comp_find(tc, sem);
        if (f2 >= 0) { ret f2; }
        if (pe < 0) { ret base_intern(tc, strtab, ptr_base_type(address_size)); }
        val ix: i32 = comp_reserve(tc, TK_POINTER, sem);
        if (ix < 0) { ret -1; }
        tc.types[ix::u32].elem      = pe;
        tc.types[ix::u32].byte_size = address_size::u32;
        ret ix;
    }

    if (kind == semtype.TYPE_ARRAY) {
        val ebase: semtype.TypeId = t.data.array.base;
        val ecount: u32 = t.data.array.count;
        val el: i32 = type_intern(s, dtypes, tc, strtab, ebase, address_size);
        if (el < 0) { ret -1; }
        val f2: i32 = comp_find(tc, sem);
        if (f2 >= 0) { ret f2; }
        val ix: i32 = comp_reserve(tc, TK_ARRAY, sem);
        if (ix < 0) { ret -1; }
        tc.types[ix::u32].elem  = el;
        tc.types[ix::u32].count = ecount;
        ret ix;
    }

    if (kind == semtype.TYPE_VECTOR) {
        val ekind: semtype.TypeKind = t.data.vector.element;
        val lanes: u32              = t.data.vector.lanes;
        val obk: O.Option[TypeDie] = base_die_of_kind(ekind, address_size);
        if (O.is_none[TypeDie](obk)) { ret -1; }
        val el: i32 = base_intern(tc, strtab, O.unwrap[TypeDie](obk));
        if (el < 0) { ret -1; }
        val ix: i32 = comp_reserve(tc, TK_VECTOR, sem);
        if (ix < 0) { ret -1; }
        tc.types[ix::u32].elem  = el;
        tc.types[ix::u32].count = lanes;
        ret ix;
    }

    if (kind == semtype.TYPE_REC || kind == semtype.TYPE_UNI || kind == semtype.TYPE_INSTANCE) {
        ret struct_intern(s, dtypes, tc, strtab, sem, address_size);
    }

    ret -1;
}

fun struct_intern(s: *debug_input.DebugProgram, dtypes: *ir_type.IrTypeTable, tc: *TypeCtx,
                  strtab: *StrTab, sem: semtype.TypeId, address_size: u8) i32 {
    val rir: R.Result[ir_type.IrTypeId, str] = sem_to_ir(s, dtypes, sem);
    if (R.is_err[ir_type.IrTypeId, str](rir)) { ret -1; }
    val ir_ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rir);

    val to: O.Option[*semtype.Type] = semtype.get(s.types, sem);
    if (O.is_none[*semtype.Type](to)) { ret -1; }
    val t: *semtype.Type = O.unwrap[*semtype.Type](to);

    var tk: u8 = TK_STRUCT;
    if (semtype.is_union(s.types, sem)) { tk = TK_UNION; }
    val cnm: str = comp_name(s, t);
    var name_off: u32 = NAME_OMIT;
    if (str_len(cnm) > 0) { name_off = str_off(strtab, cnm); }
    val bsize: u32 = ir_type.byte_size_for_machine(dtypes, ir_ty, s.layout);

    val ix: i32 = comp_reserve(tc, tk, sem);
    if (ix < 0) { ret -1; }
    tc.types[ix::u32].name_off  = name_off;
    tc.types[ix::u32].byte_size = bsize;

    val nfields: u32 = semtype.field_count(s.types, sem);

    var i: u32 = 0;
    for (i < nfields) {
        val fe: O.Option[*semtype.FieldEntry] = semtype.field_at(s.types, sem, i);
        if (O.is_some[*semtype.FieldEntry](fe)) {
            val fty_sem: semtype.TypeId = O.unwrap[*semtype.FieldEntry](fe).ty;
            type_intern(s, dtypes, tc, strtab, fty_sem, address_size);
        }
        i = i + 1;
    }

    val memb_start: u32 = tc.nmemb;
    var count: u32 = 0;
    var j: u32 = 0;
    for (j < nfields) {
        val fe: O.Option[*semtype.FieldEntry] = semtype.field_at(s.types, sem, j);
        if (O.is_none[*semtype.FieldEntry](fe)) { j = j + 1; cnt; }
        val f_ty:   semtype.TypeId = O.unwrap[*semtype.FieldEntry](fe).ty;
        val f_name: intern.StrId   = O.unwrap[*semtype.FieldEntry](fe).name;
        val fty: i32 = type_intern(s, dtypes, tc, strtab, f_ty, address_size);
        if (fty < 0) { j = j + 1; cnt; }
        if (!memb_reserve(tc)) { j = j + 1; cnt; }
        var mno: u32 = NAME_OMIT;
        if (f_name != intern.STR_NIL) {
            val mnm: str = resolve(s.interner, f_name);
            if (str_len(mnm) > 0) { mno = str_off(strtab, mnm); }
        }
        tc.membs[tc.nmemb].name_off = mno;
        tc.membs[tc.nmemb].type_ix  = fty::u32;
        tc.membs[tc.nmemb].offset   = ir_type.byte_offset_for_machine(dtypes, ir_ty, j, s.layout);
        tc.nmemb = tc.nmemb + 1;
        count = count + 1;
        j = j + 1;
    }
    tc.types[ix::u32].memb_start = memb_start;
    tc.types[ix::u32].memb_count = count;
    ret ix;
}

fun ptr_base_type(address_size: u8) TypeDie {
    var bt: TypeDie;
    bt.kind       = TK_BASE;
    bt.name       = "ptr";
    bt.sem        = semtype.TYPE_NIL;
    bt.off        = 0;
    bt.name_off   = 0;
    bt.encoding   = DW_ATE_address;
    bt.byte_size  = address_size::u32;
    bt.elem       = -1;
    bt.count      = 0;
    bt.memb_start = 0;
    bt.memb_count = 0;
    ret bt;
}

fun first_row_loc(rows: *enc.LineRow, row_count: u32, text_sec: u32, start: u32, end: u32) O.Option[source.SrcLoc] {
    var found: bool = false;
    var best_off: u32 = 0;
    var best_loc: source.SrcLoc;
    var r: u32 = 0;
    for (r < row_count) {
        val row: *enc.LineRow = ?rows[r];
        if (row.sec == text_sec && row.text_offset >= start && row.text_offset < end && source.loc_is_valid(row.loc)) {
            if (!found || row.text_offset < best_off) {
                found = true; best_off = row.text_offset; best_loc = row.loc;
            }
        }
        r = r + 1;
    }
    if (found) { ret O.some[source.SrcLoc](best_loc); }
    ret O.none[source.SrcLoc]();
}

fun install_into(s: *debug_input.DebugProgram, image: *of.ObjectImage, itn: *intern.Interner,
            funcs: *DwFunc, nfuncs: u32, b_abbrev: *enc.ByteBuf, b_line: *enc.ByteBuf,
            b_info: *enc.ByteBuf, b_str: *enc.ByteBuf, b_loclists: *enc.ByteBuf, has_loclists: bool,
            b_rnglists: *enc.ByteBuf, has_rnglists: bool,
            addr_off: *u32, addr_kind: of.RelocKind, stmt_off: u32,
            info_relocs: *InfoReloc, info_reloc_count: u32,
            loc_relocs: *LocReloc, loc_reloc_count: u32,
            rng_relocs: *RngReloc, rng_reloc_count: u32) R.Result[R.Void, str] {
    val n_abbrev: R.Result[intern.StrId, str] = intern.intern(itn, ".debug_abbrev");
    if (R.is_err[intern.StrId, str](n_abbrev)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](n_abbrev)); }
    val n_line: R.Result[intern.StrId, str] = intern.intern(itn, ".debug_line");
    if (R.is_err[intern.StrId, str](n_line)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](n_line)); }
    val n_info: R.Result[intern.StrId, str] = intern.intern(itn, ".debug_info");
    if (R.is_err[intern.StrId, str](n_info)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](n_info)); }
    val n_str: R.Result[intern.StrId, str] = intern.intern(itn, ".debug_str");
    if (R.is_err[intern.StrId, str](n_str)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](n_str)); }

    val ra: R.Result[u32, str] = add_debug_section(image, R.unwrap_ok[intern.StrId, str](n_abbrev), b_abbrev);
    if (R.is_err[u32, str](ra)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](ra)); }
    val rl: R.Result[u32, str] = add_debug_section(image, R.unwrap_ok[intern.StrId, str](n_line), b_line);
    if (R.is_err[u32, str](rl)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](rl)); }
    val line_sec: u32 = R.unwrap_ok[u32, str](rl);
    val ri: R.Result[u32, str] = add_debug_section(image, R.unwrap_ok[intern.StrId, str](n_info), b_info);
    if (R.is_err[u32, str](ri)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](ri)); }
    val info_sec: u32 = R.unwrap_ok[u32, str](ri);
    val rs: R.Result[u32, str] = add_debug_section(image, R.unwrap_ok[intern.StrId, str](n_str), b_str);
    if (R.is_err[u32, str](rs)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](rs)); }
    val str_sec: u32 = R.unwrap_ok[u32, str](rs);

    val anchor_r: R.Result[intern.StrId, str] = intern_anchor(itn, resolve(itn, image.name), ".debug_line");
    if (R.is_err[intern.StrId, str](anchor_r)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](anchor_r)); }
    val anchor: intern.StrId = R.unwrap_ok[intern.StrId, str](anchor_r);
    val sr: R.Result[u32, str] = add_anchor(image, anchor, line_sec);
    if (R.is_err[u32, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](sr)); }

    val sanchor_r: R.Result[intern.StrId, str] = intern_anchor(itn, resolve(itn, image.name), ".debug_str");
    if (R.is_err[intern.StrId, str](sanchor_r)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](sanchor_r)); }
    val str_anchor: intern.StrId = R.unwrap_ok[intern.StrId, str](sanchor_r);
    val sar: R.Result[u32, str] = add_anchor(image, str_anchor, str_sec);
    if (R.is_err[u32, str](sar)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](sar)); }

    var loclists_sec: u32 = 0;
    var loclists_anchor: intern.StrId = intern.STR_NIL;
    if (has_loclists) {
        val n_ll: R.Result[intern.StrId, str] = intern.intern(itn, ".debug_loclists");
        if (R.is_err[intern.StrId, str](n_ll)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](n_ll)); }
        val rll: R.Result[u32, str] = add_debug_section(image, R.unwrap_ok[intern.StrId, str](n_ll), b_loclists);
        if (R.is_err[u32, str](rll)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](rll)); }
        loclists_sec = R.unwrap_ok[u32, str](rll);
        val llanchor_r: R.Result[intern.StrId, str] = intern_anchor(itn, resolve(itn, image.name), ".debug_loclists");
        if (R.is_err[intern.StrId, str](llanchor_r)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](llanchor_r)); }
        loclists_anchor = R.unwrap_ok[intern.StrId, str](llanchor_r);
        val llar: R.Result[u32, str] = add_anchor(image, loclists_anchor, loclists_sec);
        if (R.is_err[u32, str](llar)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](llar)); }
    }

    var rnglists_sec: u32 = 0;
    var rnglists_anchor: intern.StrId = intern.STR_NIL;
    if (has_rnglists) {
        val n_rl: R.Result[intern.StrId, str] = intern.intern(itn, ".debug_rnglists");
        if (R.is_err[intern.StrId, str](n_rl)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](n_rl)); }
        val rrl: R.Result[u32, str] = add_debug_section(image, R.unwrap_ok[intern.StrId, str](n_rl), b_rnglists);
        if (R.is_err[u32, str](rrl)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](rrl)); }
        rnglists_sec = R.unwrap_ok[u32, str](rrl);
        val rlanchor_r: R.Result[intern.StrId, str] = intern_anchor(itn, resolve(itn, image.name), ".debug_rnglists");
        if (R.is_err[intern.StrId, str](rlanchor_r)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](rlanchor_r)); }
        rnglists_anchor = R.unwrap_ok[intern.StrId, str](rlanchor_r);
        val rlar: R.Result[u32, str] = add_anchor(image, rnglists_anchor, rnglists_sec);
        if (R.is_err[u32, str](rlar)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](rlar)); }
    }

    val r2: R.Result[R.Void, str] = add_reloc(image, info_sec, stmt_off, of.RK_ABS32, anchor);
    if (R.is_err[R.Void, str](r2)) { ret r2; }

    var k: u32 = 0;
    for (k < info_reloc_count) {
        val ir2: *InfoReloc = ?info_relocs[k];
        var sym: intern.StrId = ir2.sym;
        if (ir2.target == IRLT_STR)     { sym = str_anchor; }
        or (ir2.target == IRLT_LOCLIST) { sym = loclists_anchor; }
        or (ir2.target == IRLT_RNGLIST) { sym = rnglists_anchor; }
        val rk: R.Result[R.Void, str] = add_reloc_addend(image, info_sec, ir2.off, ir2.kind, sym, ir2.addend);
        if (R.is_err[R.Void, str](rk)) { ret rk; }
        k = k + 1;
    }

    var li: u32 = 0;
    for (li < loc_reloc_count) {
        val lr: *LocReloc = ?loc_relocs[li];
        val rlrx: R.Result[R.Void, str] = add_reloc(image, loclists_sec, lr.off, addr_kind, lr.sym);
        if (R.is_err[R.Void, str](rlrx)) { ret rlrx; }
        li = li + 1;
    }

    var ri3: u32 = 0;
    for (ri3 < rng_reloc_count) {
        val rr3: *RngReloc = ?rng_relocs[ri3];
        val rrx: R.Result[R.Void, str] = add_reloc(image, rnglists_sec, rr3.off, addr_kind, rr3.sym);
        if (R.is_err[R.Void, str](rrx)) { ret rrx; }
        ri3 = ri3 + 1;
    }

    var i: u32 = 0;
    for (i < nfuncs) {
        val rr: R.Result[R.Void, str] = add_reloc(image, line_sec, addr_off[i], addr_kind, funcs[i].name);
        if (R.is_err[R.Void, str](rr)) { ret rr; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun install(s: *debug_input.DebugProgram, image: *of.ObjectImage, itn: *intern.Interner,
            funcs: *DwFunc, nfuncs: u32, b_abbrev: *enc.ByteBuf, b_line: *enc.ByteBuf,
            b_info: *enc.ByteBuf, b_str: *enc.ByteBuf, b_loclists: *enc.ByteBuf, has_loclists: bool,
            b_rnglists: *enc.ByteBuf, has_rnglists: bool,
            addr_off: *u32, addr_kind: of.RelocKind, stmt_off: u32,
            info_relocs: *InfoReloc, info_reloc_count: u32,
            loc_relocs: *LocReloc, loc_reloc_count: u32,
            rng_relocs: *RngReloc, rng_reloc_count: u32) R.Result[R.Void, str] {
    var sections: *of.Section = nil;
    var symbols: *of.Symbol = nil;
    var relocations: *of.Relocation = nil;
    if (image.section_count > 0) {
        val sr: R.Result[*of.Section, str] = A.allocate[of.Section](image.alloc, image.section_count::usize);
        if (R.is_err[*of.Section, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[*of.Section, str](sr)); }
        sections = R.unwrap_ok[*of.Section, str](sr);
        var i: u32 = 0;
        for (i < image.section_count) { sections[i] = image.sections[i]; i = i + 1; }
    }
    if (image.symbol_count > 0) {
        val yr: R.Result[*of.Symbol, str] = A.allocate[of.Symbol](image.alloc, image.symbol_count::usize);
        if (R.is_err[*of.Symbol, str](yr)) {
            if (sections != nil) { A.deallocate[of.Section](image.alloc, sections, image.section_count::usize); }
            ret R.err[R.Void, str](R.unwrap_err[*of.Symbol, str](yr));
        }
        symbols = R.unwrap_ok[*of.Symbol, str](yr);
        var i: u32 = 0;
        for (i < image.symbol_count) { symbols[i] = image.symbols[i]; i = i + 1; }
    }
    if (image.reloc_count > 0) {
        val rr: R.Result[*of.Relocation, str] = A.allocate[of.Relocation](image.alloc, image.reloc_count::usize);
        if (R.is_err[*of.Relocation, str](rr)) {
            if (sections != nil) { A.deallocate[of.Section](image.alloc, sections, image.section_count::usize); }
            if (symbols != nil) { A.deallocate[of.Symbol](image.alloc, symbols, image.symbol_count::usize); }
            ret R.err[R.Void, str](R.unwrap_err[*of.Relocation, str](rr));
        }
        relocations = R.unwrap_ok[*of.Relocation, str](rr);
        var i: u32 = 0;
        for (i < image.reloc_count) { relocations[i] = image.relocations[i]; i = i + 1; }
    }

    val old_section_count: u32 = image.section_count;
    var work: of.ObjectImage = @image;
    work.sections = sections;
    work.section_cap = image.section_count;
    work.symbols = symbols;
    work.symbol_cap = image.symbol_count;
    work.relocations = relocations;
    work.reloc_cap = image.reloc_count;
    val installed: R.Result[R.Void, str] = install_into(s, ?work, itn, funcs, nfuncs,
        b_abbrev, b_line, b_info, b_str, b_loclists, has_loclists, b_rnglists, has_rnglists,
        addr_off, addr_kind, stmt_off, info_relocs, info_reloc_count,
        loc_relocs, loc_reloc_count, rng_relocs, rng_reloc_count);
    if (R.is_err[R.Void, str](installed)) {
        var si: u32 = old_section_count;
        for (si < work.section_count) {
            if (work.sections[si].bytes != nil) {
                A.deallocate[u8](image.alloc, work.sections[si].bytes, work.sections[si].len::usize);
            }
            si = si + 1;
        }
        if (work.sections != nil && work.section_cap > 0) { A.deallocate[of.Section](image.alloc, work.sections, work.section_cap::usize); }
        if (work.symbols != nil && work.symbol_cap > 0) { A.deallocate[of.Symbol](image.alloc, work.symbols, work.symbol_cap::usize); }
        if (work.relocations != nil && work.reloc_cap > 0) { A.deallocate[of.Relocation](image.alloc, work.relocations, work.reloc_cap::usize); }
        ret installed;
    }

    if (image.sections != nil && image.section_cap > 0) { A.deallocate[of.Section](image.alloc, image.sections, image.section_cap::usize); }
    if (image.symbols != nil && image.symbol_cap > 0) { A.deallocate[of.Symbol](image.alloc, image.symbols, image.symbol_cap::usize); }
    if (image.relocations != nil && image.reloc_cap > 0) { A.deallocate[of.Relocation](image.alloc, image.relocations, image.reloc_cap::usize); }
    image.sections = work.sections;
    image.section_count = work.section_count;
    image.section_cap = work.section_cap;
    image.symbols = work.symbols;
    image.symbol_count = work.symbol_count;
    image.symbol_cap = work.symbol_cap;
    image.relocations = work.relocations;
    image.reloc_count = work.reloc_count;
    image.reloc_cap = work.reloc_cap;
    ret installed;
}

fun t_debug_program(s: *session.Session) debug_input.DebugProgram {
    var p: debug_input.DebugProgram;
    p.alloc         = s.alloc;
    p.interner      = ?s.interner;
    p.types         = ?s.types;
    p.sources       = ?s.sources;
    p.type_aligns   = ?s.type_aligns;
    p.type_packed   = ?s.type_packed;
    p.field_epoch   = semtype.field_epoch(?s.types);
    p.layout        = layout.machine(8, 128);
    p.pointer_width = 8;
    p.dwarf_reg     = nil;
    p.frame_ptr_reg = -1;
    p.stack_ptr_reg = -1;
    ret p;
}

fun t_debug_reg(reg: i32) i32 {
    ret reg;
}

fun t_request_rejected(req: *of.DebugProduceRequest) bool {
    ret R.is_err[R.Void, str](validate_request(req));
}

test "mach.lang.be.codegen.dwarf.validate_request:rejects_malformed_program_image_and_streams" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val name_r: R.Result[intern.StrId, str] = intern.intern(?s.interner, "validate_request");
    if (R.is_err[intern.StrId, str](name_r)) { session.dnit(?s); ret 1; }
    val name: intern.StrId = R.unwrap_ok[intern.StrId, str](name_r);
    val module_r: R.Result[ir.Module, str] = ir.init(?alloc, name);
    if (R.is_err[ir.Module, str](module_r)) { session.dnit(?s); ret 1; }
    var irmod: ir.Module = R.unwrap_ok[ir.Module, str](module_r);
    val fn_r: R.Result[u32, str] = ir.function_add(?irmod, name, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](fn_r)) { ir.dnit(?irmod); session.dnit(?s); ret 1; }
    val fn_index: u32 = R.unwrap_ok[u32, str](fn_r);
    if (R.is_err[R.Void, str](ir.function_register(?irmod, name, fn_index))) {
        ir.dnit(?irmod); session.dnit(?s); ret 1;
    }

    var mirmod: mir.MirModule;
    mirmod.alloc = ?alloc;
    mirmod.interner = ?s.interner;
    mirmod.srcmap = ?s.sources;
    mirmod.functions = nil;
    mirmod.function_len = 0;
    mirmod.function_cap = 0;

    val image_r: R.Result[of.ObjectImage, str] = obj.init(?alloc, ?s.interner, name);
    if (R.is_err[of.ObjectImage, str](image_r)) { ir.dnit(?irmod); session.dnit(?s); ret 1; }
    var image: of.ObjectImage = R.unwrap_ok[of.ObjectImage, str](image_r);
    val bytes_r: R.Result[*u8, str] = A.allocate[u8](?alloc, 8::usize);
    if (R.is_err[*u8, str](bytes_r)) { obj.dnit(?image); ir.dnit(?irmod); session.dnit(?s); ret 1; }
    val bytes: *u8 = R.unwrap_ok[*u8, str](bytes_r);
    var bi: u32 = 0;
    for (bi < 8) { bytes[bi] = 0; bi = bi + 1; }
    var text: of.Section;
    text.name = name;
    text.kind = of.SK_TEXT;
    text.bytes = bytes;
    text.len = 8;
    text.align = 1;
    text.flags = 0;
    if (R.is_err[u32, str](obj.install_section(?image, ?text))) {
        obj.dnit(?image); ir.dnit(?irmod); session.dnit(?s); ret 1;
    }
    var bss: of.Section;
    bss.name = name;
    bss.kind = of.SK_BSS;
    bss.bytes = nil;
    bss.len = 8;
    bss.align = 1;
    bss.flags = 0;
    if (R.is_err[u32, str](obj.install_section(?image, ?bss))) {
        obj.dnit(?image); ir.dnit(?irmod); session.dnit(?s); ret 1;
    }
    var sym: of.Symbol;
    sym.name = name;
    sym.section = 0;
    sym.offset = 0;
    sym.size = 8;
    sym.flags = of.SYM_OBJ_FLAG_FUNCTION;
    sym.fallback = of.SYMBOL_NONE;
    sym.align = 1;
    if (R.is_err[u32, str](obj.add_symbol(?image, sym))) {
        obj.dnit(?image); ir.dnit(?irmod); session.dnit(?s); ret 1;
    }

    var req: of.DebugProduceRequest;
    req.program = t_debug_program(?s);
    req.program.ir_module = ?irmod;
    req.program.mir_module = ?mirmod;
    req.program.dwarf_reg = t_debug_reg;
    req.image = ?image;
    req.rows = nil;
    req.row_count = 0;
    req.varlocs = nil;
    req.varloc_count = 0;
    req.inline_pcs = nil;
    req.inline_pc_count = 0;
    req.producer = name;
    req.comp_dir = name;
    req.text_section = 0;

    var bad: i32 = 0;
    if (t_request_rejected(?req)) { bad = 1; }

    val saved_image: *of.ObjectImage = req.image;
    req.image = nil;
    if (!t_request_rejected(?req)) { bad = 1; }
    req.image = saved_image;

    val saved_aligns: *map.Map[u32, u32] = req.program.type_aligns;
    req.program.type_aligns = nil;
    if (!t_request_rejected(?req)) { bad = 1; }
    req.program.type_aligns = saved_aligns;

    req.program.field_epoch = req.program.field_epoch + 1;
    if (!t_request_rejected(?req)) { bad = 1; }
    req.program.field_epoch = semtype.field_epoch(req.program.types);

    req.program.layout = layout.machine(4, 128);
    if (!t_request_rejected(?req)) { bad = 1; }
    req.program.layout = layout.machine(8, 128);

    var other: intern.Interner = intern.init(?alloc);
    image.interner = ?other;
    if (!t_request_rejected(?req)) { bad = 1; }
    image.interner = ?s.interner;
    intern.dnit(?other);

    var bad_image: of.ObjectImage = image;
    bad_image.sections = nil;
    req.image = ?bad_image;
    if (!t_request_rejected(?req)) { bad = 1; }
    bad_image = image;
    bad_image.section_count = 0;
    req.image = ?bad_image;
    if (!t_request_rejected(?req)) { bad = 1; }
    bad_image = image;
    bad_image.attributes = bytes;
    bad_image.attributes_len = 0;
    req.image = ?bad_image;
    if (!t_request_rejected(?req)) { bad = 1; }
    bad_image = image;
    bad_image.attributes = nil;
    bad_image.attributes_len = 1;
    req.image = ?bad_image;
    if (!t_request_rejected(?req)) { bad = 1; }
    req.image = ?image;

    image.sections[0].kind = of.SK_DATA;
    if (!t_request_rejected(?req)) { bad = 1; }
    image.sections[0].kind = of.SK_TEXT;
    image.sections[0].bytes = nil;
    if (!t_request_rejected(?req)) { bad = 1; }
    image.sections[0].bytes = bytes;
    image.sections[1].bytes = bytes;
    if (!t_request_rejected(?req)) { bad = 1; }
    image.sections[1].bytes = nil;

    image.symbols[0].offset = 7;
    image.symbols[0].size = 2;
    if (!t_request_rejected(?req)) { bad = 1; }
    image.symbols[0].offset = 0;
    image.symbols[0].size = 8;

    req.row_count = 1;
    if (!t_request_rejected(?req)) { bad = 1; }
    req.row_count = 0;
    var rows: [2]debug_input.LineRow;
    rows[0].sec = 1; rows[0].text_offset = 0; rows[0].loc = source.loc_nil();
    req.rows = ?rows[0]; req.row_count = 1;
    if (!t_request_rejected(?req)) { bad = 1; }
    rows[0].sec = 0; rows[0].text_offset = 4; rows[0].loc = source.loc_nil();
    rows[1].sec = 0; rows[1].text_offset = 2; rows[1].loc = source.loc_nil();
    req.rows = ?rows[0]; req.row_count = 2;
    if (!t_request_rejected(?req)) { bad = 1; }
    req.rows = nil; req.row_count = 0;

    var inline_pc: debug_input.InlinePc;
    inline_pc.sec = 1; inline_pc.text_offset = 0; inline_pc.inline_site = 0;
    req.inline_pcs = ?inline_pc; req.inline_pc_count = 1;
    if (!t_request_rejected(?req)) { bad = 1; }
    inline_pc.sec = 0; inline_pc.text_offset = 1; inline_pc.inline_site = 1;
    req.inline_pcs = ?inline_pc; req.inline_pc_count = 1;
    if (!t_request_rejected(?req)) { bad = 1; }
    req.inline_pcs = nil; req.inline_pc_count = 0;

    var varloc: debug_input.VarLoc;
    varloc.sec = 1; varloc.text_offset = 0; varloc.end_offset = 0; varloc.iid = 0;
    req.varlocs = ?varloc; req.varloc_count = 1;
    if (!t_request_rejected(?req)) { bad = 1; }
    varloc.sec = 0; varloc.text_offset = 4; varloc.end_offset = 3; varloc.iid = 0;
    req.varlocs = ?varloc; req.varloc_count = 1;
    if (!t_request_rejected(?req)) { bad = 1; }

    obj.dnit(?image);
    ir.dnit(?irmod);
    session.dnit(?s);
    ret bad;
}

rec DwarfInstallProbe {
    backing: A.Allocator;
    calls:   u32;
    live:    u32;
    fail_at: u32;
}

fun dwarf_install_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val p: *DwarfInstallProbe = ctx::*DwarfInstallProbe;
    p.calls = p.calls + 1;
    if (p.calls == p.fail_at) { ret O.none[ptr](); }
    val item: O.Option[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (O.is_some[ptr](item)) { p.live = p.live + 1; }
    ret item;
}

fun dwarf_install_reallocate(ctx: ptr, item: ptr, old_size: usize,
                             new_size: usize, align: usize) O.Option[ptr] {
    val p: *DwarfInstallProbe = ctx::*DwarfInstallProbe;
    p.calls = p.calls + 1;
    if (p.calls == p.fail_at) { ret O.none[ptr](); }
    val grown: O.Option[ptr] = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (item == nil && O.is_some[ptr](grown)) { p.live = p.live + 1; }
    ret grown;
}

fun dwarf_install_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *DwarfInstallProbe = ctx::*DwarfInstallProbe;
    if (item != nil && p.live > 0) { p.live = p.live - 1; }
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun dwarf_install_allocator(p: *DwarfInstallProbe) A.Allocator {
    var alloc: A.Allocator;
    alloc.ctx = p::ptr;
    alloc.fn_allocate = dwarf_install_allocate;
    alloc.fn_reallocate = dwarf_install_reallocate;
    alloc.fn_deallocate = dwarf_install_deallocate;
    ret alloc;
}

test "mach.lang.be.codegen.dwarf.install:failure_leaves_the_original_image_unchanged" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }
    var probe: DwarfInstallProbe;
    probe.backing = backing;
    probe.calls = 0;
    probe.live = 0;
    probe.fail_at = 0;
    var image_alloc: A.Allocator = dwarf_install_allocator(?probe);
    var itn: intern.Interner = intern.init(?backing);
    val name_r: R.Result[intern.StrId, str] = intern.intern(?itn, "rollback");
    if (R.is_err[intern.StrId, str](name_r)) { intern.dnit(?itn); ret 1; }
    val image_r: R.Result[of.ObjectImage, str] = obj.init(?image_alloc, ?itn,
        R.unwrap_ok[intern.StrId, str](name_r));
    if (R.is_err[of.ObjectImage, str](image_r)) { intern.dnit(?itn); ret 1; }
    var image: of.ObjectImage = R.unwrap_ok[of.ObjectImage, str](image_r);
    var bytes: enc.ByteBuf = enc.buf_init(?backing);
    enc.emit_byte(?bytes, 0);
    if (bytes.len != 1) { enc.buf_dnit(?bytes); obj.dnit(?image); intern.dnit(?itn); ret 1; }
    var program: debug_input.DebugProgram;
    program.alloc = ?backing;

    probe.fail_at = probe.calls + 3;
    val installed: R.Result[R.Void, str] = install(?program, ?image, ?itn, nil, 0,
        ?bytes, ?bytes, ?bytes, ?bytes, ?bytes, false, ?bytes, false,
        nil, of.RK_ABS64, 0, nil, 0, nil, 0, nil, 0);
    var bad: i32 = 0;
    if (R.is_ok[R.Void, str](installed)) { bad = 1; }
    if (image.sections != nil || image.section_count != 0
        || image.symbols != nil || image.symbol_count != 0
        || image.relocations != nil || image.reloc_count != 0) { bad = 1; }
    if (probe.live != 0) { bad = 1; }

    enc.buf_dnit(?bytes);
    obj.dnit(?image);
    intern.dnit(?itn);
    ret bad;
}

fun add_anchor(image: *of.ObjectImage, name: intern.StrId, sec: u32) R.Result[u32, str] {
    var asym: of.Symbol;
    asym.name    = name;
    asym.section = sec;
    asym.offset  = 0;
    asym.size    = 0;
    asym.flags   = of.SYM_OBJ_FLAG_GLOBAL;
    asym.fallback = of.SYMBOL_NONE;
    asym.align    = 1;
    ret obj.add_symbol(image, asym);
}

fun buf_eq(b: *enc.ByteBuf, expect: *u8, n: usize) bool {
    if (b.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (b.data[i] != expect[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun t_cmp_range(k1: u8, reg: i32, off: i64, k2: u8, reg2: i32, off2: i64,
                rel: u8, signed: bool, width: u8) LocRange {
    var rg: LocRange;
    rg.start = 0; rg.end = 0;
    rg.kind = VLOC_CMP; rg.net = 0; rg.storage = false;
    rg.kind1 = k1; rg.reg  = reg;  rg.off  = off;
    rg.kind2 = k2; rg.reg2 = reg2; rg.off2 = off2;
    rg.cmp_rel = rel; rg.cmp_signed = signed; rg.cmp_width = width;
    ret rg;
}

fun t_cmp_bytes(e: *enc.ByteBuf, want: *u8, n: usize) i32 {
    if (e.len != n) { ret 1; }
    var i: usize = 0;
    for (i < n) {
        if (e.data[i] != want[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.be.codegen.dwarf.build_cmp_ops:expression_pins" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var code: i32 = 0;

    var e: enc.ByteBuf = enc.buf_init(?alloc);
    var rg: LocRange = t_cmp_range(VLOC_REG, 5, 0, VLOC_REG, 6, 0, enc.CMPREL_LT, true, 4);
    build_cmp_ops(?e, ?rg);
    var w1: [18]u8;
    w1[0]=0x75; w1[1]=0x00; w1[2]=0x08; w1[3]=0x20; w1[4]=0x24; w1[5]=0x08; w1[6]=0x20; w1[7]=0x26;
    w1[8]=0x76; w1[9]=0x00; w1[10]=0x08; w1[11]=0x20; w1[12]=0x24; w1[13]=0x08; w1[14]=0x20; w1[15]=0x26;
    w1[16]=0x2D; w1[17]=0x9F;
    if (t_cmp_bytes(?e, ?w1[0], 18) != 0) { code = 1; }
    enc.buf_dnit(?e);

    e = enc.buf_init(?alloc);
    rg = t_cmp_range(VLOC_REG, 5, 0, VLOC_CONST, 0, 40000, enc.CMPREL_LE, false, 2);
    build_cmp_ops(?e, ?rg);
    var w2: [13]u8;
    w2[0]=0x75; w2[1]=0x00; w2[2]=0x10; w2[3]=0xFF; w2[4]=0xFF; w2[5]=0x03; w2[6]=0x1A;
    w2[7]=0x11; w2[8]=0xC0; w2[9]=0xB8; w2[10]=0x02; w2[11]=0x2C; w2[12]=0x9F;
    if (t_cmp_bytes(?e, ?w2[0], 13) != 0) { code = 2; }
    enc.buf_dnit(?e);

    e = enc.buf_init(?alloc);
    rg = t_cmp_range(VLOC_REG, 0, 0, VLOC_REG, 1, 0, enc.CMPREL_EQ, false, 8);
    build_cmp_ops(?e, ?rg);
    var w3: [6]u8;
    w3[0]=0x70; w3[1]=0x00; w3[2]=0x71; w3[3]=0x00; w3[4]=0x29; w3[5]=0x9F;
    if (t_cmp_bytes(?e, ?w3[0], 6) != 0) { code = 3; }
    enc.buf_dnit(?e);

    e = enc.buf_init(?alloc);
    rg = t_cmp_range(VLOC_REG, 0, 0, VLOC_REG, 1, 0, enc.CMPREL_LT, false, 8);
    build_cmp_ops(?e, ?rg);
    var w4: [28]u8;
    w4[0]=0x70; w4[1]=0x00; w4[2]=0x10;
    w4[3]=0x80; w4[4]=0x80; w4[5]=0x80; w4[6]=0x80; w4[7]=0x80; w4[8]=0x80; w4[9]=0x80; w4[10]=0x80; w4[11]=0x80; w4[12]=0x01;
    w4[13]=0x22;
    w4[14]=0x71; w4[15]=0x00; w4[16]=0x10;
    w4[17]=0x80; w4[18]=0x80; w4[19]=0x80; w4[20]=0x80; w4[21]=0x80; w4[22]=0x80; w4[23]=0x80; w4[24]=0x80; w4[25]=0x80; w4[26]=0x01;
    w4[27]=0x22;
    if (e.len != 30) { code = 4; }
    or {
        if (t_cmp_bytes_prefix(?e, ?w4[0], 28) != 0) { code = 4; }
        if ((e.data[28] != 0x2D || e.data[29] != 0x9F) && code == 0) { code = 4; }
    }
    enc.buf_dnit(?e);

    e = enc.buf_init(?alloc);
    rg = t_cmp_range(VLOC_FRAME, 0, -16, VLOC_CONST, 0, 255, enc.CMPREL_NE, false, 1);
    build_cmp_ops(?e, ?rg);
    var w5: [12]u8;
    w5[0]=0x91; w5[1]=0x70; w5[2]=0x06; w5[3]=0x10; w5[4]=0xFF; w5[5]=0x01; w5[6]=0x1A;
    w5[7]=0x11; w5[8]=0xFF; w5[9]=0x01; w5[10]=0x2E; w5[11]=0x9F;
    if (t_cmp_bytes(?e, ?w5[0], 12) != 0) { code = 5; }
    enc.buf_dnit(?e);

    e = enc.buf_init(?alloc);
    rg = t_cmp_range(VLOC_REG, 3, 0, VLOC_CONST, 0, 200, enc.CMPREL_LT, true, 1);
    build_cmp_ops(?e, ?rg);
    var w6: [12]u8;
    w6[0]=0x73; w6[1]=0x00; w6[2]=0x08; w6[3]=0x38; w6[4]=0x24; w6[5]=0x08; w6[6]=0x38; w6[7]=0x26;
    w6[8]=0x11; w6[9]=0x48; w6[10]=0x2D; w6[11]=0x9F;
    if (t_cmp_bytes(?e, ?w6[0], 12) != 0) { code = 6; }
    enc.buf_dnit(?e);

    e = enc.buf_init(?alloc);
    rg = t_cmp_range(VLOC_REG, 0, 0, VLOC_REG, 1, 0, enc.CMPREL_EQ, false, 8);
    emit_counted_cmp_loc(?e, ?rg);
    var w7: [7]u8;
    w7[0]=0x06; w7[1]=0x70; w7[2]=0x00; w7[3]=0x71; w7[4]=0x00; w7[5]=0x29; w7[6]=0x9F;
    if (t_cmp_bytes(?e, ?w7[0], 7) != 0) { code = 7; }
    enc.buf_dnit(?e);

    ret code;
}

fun t_cmp_bytes_prefix(e: *enc.ByteBuf, want: *u8, n: usize) i32 {
    if (e.len < n) { ret 1; }
    var i: usize = 0;
    for (i < n) {
        if (e.data[i] != want[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.be.codegen.dwarf.uleb_sleb:canonical" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var code: i32 = 0;

    var b: enc.ByteBuf = enc.buf_init(?alloc);
    uleb(?b, 0);   uleb(?b, 127); uleb(?b, 128); uleb(?b, 300);
    var e1: [6]u8; e1[0] = 0x00; e1[1] = 0x7F; e1[2] = 0x80; e1[3] = 0x01; e1[4] = 0xAC; e1[5] = 0x02;
    if (!buf_eq(?b, ?e1[0], 6)) { code = 1; }
    enc.buf_dnit(?b);

    var c: enc.ByteBuf = enc.buf_init(?alloc);
    sleb(?c, 0); sleb(?c, -1); sleb(?c, 2); sleb(?c, -128);
    var e2: [5]u8; e2[0] = 0x00; e2[1] = 0x7F; e2[2] = 0x02; e2[3] = 0x80; e2[4] = 0x7F;
    if (!buf_eq(?c, ?e2[0], 5)) { code = 1; }
    enc.buf_dnit(?c);
    ret code;
}

