    build_rnglists(?b, ?funcs[0], 1, ?inls[0], 1, ?irng[0], 8, ?relocs[0], ?nrel, 4, ?cu_off);

    var e: [39]u8;
    e[0]=0x23; e[1]=0x00; e[2]=0x00; e[3]=0x00;
    e[4]=0x05; e[5]=0x00;
    e[6]=0x08; e[7]=0x00;
    e[8]=0x00; e[9]=0x00; e[10]=0x00; e[11]=0x00;
    e[12]=0x07;
    e[13]=0x00; e[14]=0x00; e[15]=0x00; e[16]=0x00; e[17]=0x00; e[18]=0x00; e[19]=0x00; e[20]=0x00;
    e[21]=0x0C; e[22]=0x00;
    e[23]=0x05;
    e[24]=0x00; e[25]=0x00; e[26]=0x00; e[27]=0x00; e[28]=0x00; e[29]=0x00; e[30]=0x00; e[31]=0x00;
    e[32]=0x04; e[33]=0x00; e[34]=0x04;
    e[35]=0x04; e[36]=0x08; e[37]=0x0C;
    e[38]=0x00;
    val ok: bool = buf_eq(?b, ?e[0], 39);
    enc.buf_dnit(?b);
    if (!ok) { code = 1; }
    if (nrel != 2) { code = 1; }
    if (relocs[0].off != 13 || relocs[1].off != 24) { code = 1; }
    if (cu_off != 12 || inls[0].rnglist_off != 23) { code = 1; }
    ret code;
}

rec DwarfGrowthProbe {
    reallocate_calls: u32;
}

fun dwarf_growth_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    ret O.none[ptr]();
}

fun dwarf_growth_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    val g: *DwarfGrowthProbe = ctx::*DwarfGrowthProbe;
    g.reallocate_calls = g.reallocate_calls + 1;
    ret O.none[ptr]();
}

fun dwarf_growth_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.be.codegen.dwarf.type_reserve:refuses_capacity_overflow_before_reallocating" {
    var probe: DwarfGrowthProbe;
    probe.reallocate_calls = 0;
    var pp: *DwarfGrowthProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = dwarf_growth_probe_allocate;
    alloc.fn_reallocate = dwarf_growth_probe_reallocate;
    alloc.fn_deallocate = dwarf_growth_probe_deallocate;

    var tc: TypeCtx = type_ctx_init(?alloc);
    var dummy: TypeDie;
    tc.types    = ?dummy;
    tc.type_cap = 0x80000000;
    tc.ntypes   = 0x80000000;

    val ok: bool = type_reserve(?tc);

    var bad: i32 = 0;
    if (ok)                          { bad = 1; }
    if (probe.reallocate_calls != 0) { bad = 2; }
    if (tc.type_cap != 0x80000000)   { bad = 3; }
    ret bad;
}

test "mach.lang.be.codegen.dwarf.memb_reserve:refuses_capacity_overflow_before_reallocating" {
    var probe: DwarfGrowthProbe;
    probe.reallocate_calls = 0;
    var pp: *DwarfGrowthProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = dwarf_growth_probe_allocate;
    alloc.fn_reallocate = dwarf_growth_probe_reallocate;
    alloc.fn_deallocate = dwarf_growth_probe_deallocate;

    var tc: TypeCtx = type_ctx_init(?alloc);
    var dummy: TypeMember;
    tc.membs    = ?dummy;
    tc.memb_cap = 0x80000000;
    tc.nmemb    = 0x80000000;

    val ok: bool = memb_reserve(?tc);

    var bad: i32 = 0;
    if (ok)                          { bad = 1; }
    if (probe.reallocate_calls != 0) { bad = 2; }
    if (tc.memb_cap != 0x80000000)   { bad = 3; }
    ret bad;
}

test "mach.lang.be.codegen.dwarf.sem_base_type:agrees_with_prim_catalog" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    var program: debug_input.DebugProgram = t_debug_program(?s);

    var code: i32 = 0;
    var k: u32 = 0;
    for (k < semtype.PRIM_COUNT) {
        val opt_die: O.Option[TypeDie] = sem_base_type(?program, k::semtype.TypeId, 8);
        if (O.is_none[TypeDie](opt_die)) { code = 1; }
        or {
            val die: TypeDie = O.unwrap[TypeDie](opt_die);
            if (!str_equals(die.name, semtype.prim_name(k::semtype.TypeKind))) { code = 1; }
        }
        val secret_r: R.Result[semtype.TypeId, str] = semtype.intern_secret(?s.types, k::semtype.TypeId);
        if (R.is_ok[semtype.TypeId, str](secret_r)) {
            val sdie: O.Option[TypeDie] = sem_base_type(?program, R.unwrap_ok[semtype.TypeId, str](secret_r), 8);
            if (O.is_none[TypeDie](sdie)) { code = 1; }
            or (!str_equals(O.unwrap[TypeDie](sdie).name, semtype.prim_name(k::semtype.TypeKind))) { code = 1; }
        }
        k = k + 1;
    }
    session.dnit(?s);
    ret code;
}

test "mach.lang.be.codegen.dwarf.emit_reg_op:breg_extended_form_above_31" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var code: i32 = 0;

    var b: enc.ByteBuf = enc.buf_init(?alloc);
    emit_reg_op(?b, DW_OP_breg0, DW_OP_bregx, 6);
    var e1: [1]u8; e1[0] = 0x76;
    if (!buf_eq(?b, ?e1[0], 1)) { code = 1; }
    enc.buf_dnit(?b);

    var c: enc.ByteBuf = enc.buf_init(?alloc);
    emit_reg_op(?c, DW_OP_breg0, DW_OP_bregx, 40);
    var e2: [2]u8; e2[0] = 0x92; e2[1] = 0x28;
    if (!buf_eq(?c, ?e2[0], 2)) { code = 1; }
    enc.buf_dnit(?c);

    var d: enc.ByteBuf = enc.buf_init(?alloc);
    build_loc_ops(?d, VLOC_REG, 40, 0, 3, false, false);
    var e3: [4]u8; e3[0] = 0x92; e3[1] = 0x28; e3[2] = 0x03; e3[3] = DW_OP_stack_value;
    if (!buf_eq(?d, ?e3[0], 4)) { code = 1; }
    enc.buf_dnit(?d);

    ret code;
}

test "mach.lang.be.codegen.dwarf.emit_addr:two_byte_target_writes_two_bytes" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var code: i32 = 0;

    var b: enc.ByteBuf = enc.buf_init(?alloc);
    emit_addr(?b, 2);
    var e1: [2]u8; e1[0] = 0; e1[1] = 0;
    if (b.len != 2)              { code = 1; }
    if (!buf_eq(?b, ?e1[0], 2))  { code = 1; }
    enc.buf_dnit(?b);

    var c: enc.ByteBuf = enc.buf_init(?alloc);
    emit_addr(?c, 4);
    if (c.len != 4) { code = 1; }
    enc.buf_dnit(?c);

    var d: enc.ByteBuf = enc.buf_init(?alloc);
    emit_addr(?d, 8);
    if (d.len != 8) { code = 1; }
    enc.buf_dnit(?d);

    ret code;
}

test "mach.lang.be.codegen.dwarf.frame_base_reg:absent_mapping_returns_negative_not_nil_call" {
    var program: debug_input.DebugProgram;
    program.dwarf_reg = nil;
    program.frame_ptr_reg = 5;
    program.stack_ptr_reg = 7;

    var bad: i32 = 0;
    if (frame_base_reg(?program) >= 0)      { bad = 1; }
    if (frame_base_omit_reg(?program) >= 0) { bad = 1; }
    ret bad;
}

test "mach.lang.be.codegen.dwarf.inline_caps:reflects_nested_depth" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    val im: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](im)) { session.dnit(?s); ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](im);

    val nr: R.Result[intern.StrId, str] = intern.intern(?s.interner, "outer");
    if (R.is_err[intern.StrId, str](nr)) { ir.dnit(?m); session.dnit(?s); ret 1; }
    val fname: intern.StrId = R.unwrap_ok[intern.StrId, str](nr);

    val fr: R.Result[u32, str] = ir.function_add(?m, fname, 0::ir_type.IrTypeId, 0);
    if (R.is_err[u32, str](fr)) { ir.dnit(?m); session.dnit(?s); ret 1; }
    val fidx: u32 = R.unwrap_ok[u32, str](fr);
    val rreg: R.Result[R.Void, str] = ir.function_register(?m, fname, fidx);
    if (R.is_err[R.Void, str](rreg)) { ir.dnit(?m); session.dnit(?s); ret 1; }
    val irfn: *ir.Function = ?m.functions[fidx];

    var loc: source.SrcLoc;
    val s1: R.Result[u32, str] = ir.inline_site_add(?m, irfn, fname, loc, 0);
    if (R.is_err[u32, str](s1)) { ir.dnit(?m); session.dnit(?s); ret 1; }
    val s2: R.Result[u32, str] = ir.inline_site_add(?m, irfn, fname, loc, R.unwrap_ok[u32, str](s1));
    if (R.is_err[u32, str](s2)) { ir.dnit(?m); session.dnit(?s); ret 1; }
    val s3: R.Result[u32, str] = ir.inline_site_add(?m, irfn, fname, loc, R.unwrap_ok[u32, str](s2));
    if (R.is_err[u32, str](s3)) { ir.dnit(?m); session.dnit(?s); ret 1; }

    var funcs: [1]DwFunc;
    funcs[0].name = fname;

    var total: u32 = 0;
    var max_depth: u32 = 1;
    inline_caps(?m, ?funcs[0], 1, ?total, ?max_depth);

    var bad: i32 = 0;
    if (total != 3)     { bad = 1; }
    if (max_depth != 3) { bad = 1; }

    ir.dnit(?m);
    session.dnit(?s);
    ret bad;
}
