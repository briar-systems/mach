    t_br(?instrs[1], ?b1[0], 3);
    t_br(?instrs[2], ?b2[0], 7);
    t_br(?instrs[3], ?b3[0], 4);
    t_cbr(?instrs[4], ?o4[0], 5, 6);
    t_br(?instrs[5], ?b5[0], 7);
    t_br(?instrs[6], ?b6[0], 3);
    t_ret(?instrs[7]);
    var blocks: [8]lang_mir.MirBlock;
    var i:      u32 = 0;
    for (i < 8) {
        t_block(?blocks[i], i, ?instrs[i]);
        i = i + 1;
    }
    var f: lang_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 8;
    f.vreg_count  = 1;

    val r: res[structure.Structure, fail.Fail] = analyze(?f, ?alloc);
    if (sel r.err) { ret 1; }
    var st: structure.Structure = r.ok;
    var rc: i32                 = 0;
    if (st.status != structure.CFG_OK)         { rc = 2; }
    if (st.nodes[0].merge != 7)                { rc = 3; }
    if (st.nodes[3].kind != structure.CK_LOOP) { rc = 4; }
    if (st.nodes[3].merge != 5)                { rc = 5; }
    if (structure.succ(?st, 5, 0) != 7)        { rc = 6; }
