    var b0:     [1]lang_mir.MirOperand;
    var b3:     [1]lang_mir.MirOperand;
    var b4:     [1]lang_mir.MirOperand;
    var instrs: [6]lang_mir.MirInstr;
    t_br(?instrs[0], ?b0[0], 1);
    t_cbr(?instrs[1], ?o1[0], 2, 5);
    t_cbr(?instrs[2], ?o2[0], 3, 4);
    t_br(?instrs[3], ?b3[0], 5);
    t_br(?instrs[4], ?b4[0], 1);
    t_ret(?instrs[5]);
    var blocks: [6]lang_mir.MirBlock;
    var i:      u32 = 0;
    for (i < 6) {
        t_block(?blocks[i], i, ?instrs[i]);
        i = i + 1;
    }
    var f: lang_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 6;
    f.vreg_count  = 1;

    val r: res[structure.Structure, fail.Fail] = analyze(?f, ?alloc);
    if (sel r.err) { ret 1; }
    var st: structure.Structure = r.ok;
    var rc: i32                 = 0;
    if (st.status != structure.CFG_OK) { rc = 2; }
    if (st.nodes[1].merge != 5)        { rc = 3; }
    val m2: u32 = st.nodes[2].merge;
    if (m2 < st.real)                                               { rc = 4; }
    if (rc == 0 && st.nodes[m2].role != structure.ROLE_UNREACHABLE) { rc = 5; }
    if (rc == 0 && structure.succ(?st, 3, 0) != 5)                  { rc = 6; }
    if (rc == 0 && structure.succ(?st, 4, 0) != st.nodes[1].cont)   { rc = 7; }
    structure.dnit(?st);
    ret rc;
}

# a loop whose only exit is a break inside a selection, itself inside an outer selection:
# the code after the loop is dominated by the inner header but lies outside the loop, so
# it belongs to the outer selection and its branch to the outer merge is not a crossing
test analyze__code_after_a_break_only_loop_is_outside_the_inner_selection {
    var alloc:  A.Allocator;
