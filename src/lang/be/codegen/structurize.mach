use mach.lang.fail;
use mach.lang.growth;
use std.allocator.page;
use std_format: std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;

use A: std.allocator;
use T: std.allocator.testing;

use lang_mir: mach.lang.mir;
use mach.lang.mir.flow;
use mach.lang.mir.structure;

fun set_succ(st: *structure.Structure, x: u32, k: u32, v: u32) {
    st.succs[st.nodes[x].edge + k] = v;
}

pub fun analyze(mf: *lang_mir.MirFunction, alloc: *A.Allocator) res[structure.Structure, fail.Fail] {
    var st: structure.Structure;
    st.alloc    = alloc;
    st.nodes    = nil;
    st.order    = nil;
    st.succs    = nil;
    st.count    = 0;
    st.real     = mf.block_count;
    st.cap      = 0;
    st.succ_len = 0;
    st.succ_cap = 0;
    st.status   = structure.CFG_OK;
    st.at       = structure.NO_BLOCK;
    st.to       = structure.NO_BLOCK;

    val cap: u32                           = mf.block_count * 4 + 2;
    val rn:  res[*structure.Node, A.Error] = A.allocate[structure.Node](alloc, cap::usize);
    if (sel rn.err) { ret res[structure.Structure, fail.Fail].err{fail.refused(rn.err)}; }
    st.nodes = rn.ok;
    st.cap   = cap;
    val ecap: u32                = cap * 2;
    val re:   res[*u32, A.Error] = A.allocate[u32](alloc, ecap::usize);
    if (sel re.err) {
        structure.dnit(?st);
        ret res[structure.Structure, fail.Fail].err{fail.refused(re.err)};
    }
    st.succs    = re.ok;
    st.succ_cap = ecap;

    val rb: err[fail.Fail] = build_nodes(?st, mf);
    if (sel rb.err) {
        structure.dnit(?st);
        ret res[structure.Structure, fail.Fail].err{rb.err};
    }
    if (st.status != structure.CFG_OK) { ret res[structure.Structure, fail.Fail].ok{st}; }

    # the real nodes are the blocks, so their order and dominators are the graph's
    val rg: res[flow.Graph, fail.Fail] = flow.init(alloc, mf);
    if (sel rg.err) {
        structure.dnit(?st);
        ret res[structure.Structure, fail.Fail].err{rg.err};
    }
    var g: flow.Graph = rg.ok;
    fin { flow.dnit(?g); }
    rpo_take(?st, ?g);
    if (st.status != structure.CFG_OK) { ret res[structure.Structure, fail.Fail].ok{st}; }

    val rd: err[fail.Fail] = flow.dominators_build(?g);
    if (sel rd.err) {
        structure.dnit(?st);
        ret res[structure.Structure, fail.Fail].err{rd.err};
    }
    var b: u32 = 0;
    for (b < st.real) {
        st.nodes[b].idom = g.idom[b];
        b                = b + 1;
    }

    val rl: err[fail.Fail] = find_loops(?st, ?g);
    if (sel rl.err) {
        structure.dnit(?st);
        ret res[structure.Structure, fail.Fail].err{rl.err};
    }
    if (st.status != structure.CFG_OK) { ret res[structure.Structure, fail.Fail].ok{st}; }

    val rm: err[fail.Fail] = assign_merges(?st);
    if (sel rm.err) {
        structure.dnit(?st);
        ret res[structure.Structure, fail.Fail].err{rm.err};
    }

    val bo: err[fail.Fail] = build_order(?st);
    if (sel bo.err) {
        structure.dnit(?st);
        ret res[structure.Structure, fail.Fail].err{bo.err};
    }
    verify(?st);
    ret res[structure.Structure, fail.Fail].ok{st};
}

# the structure of every function of a MIR module, in function order. a
# function the target cannot structure carries its refusal in its status, which
# the emitter reports where it emits that function
pub fun analyze_module(m: *lang_mir.MirModule, alloc: *A.Allocator) res[*structure.Structure, fail.Fail] {
    if (m.function_len == 0) { ret res[*structure.Structure, fail.Fail].ok{nil}; }
    val ra: res[*structure.Structure, A.Error] = A.allocate[structure.Structure](alloc, m.function_len::usize);
    if (sel ra.err) { ret res[*structure.Structure, fail.Fail].err{fail.refused(ra.err)}; }
    val out: *structure.Structure = ra.ok;
    var i:   u32                  = 0;
    for (i < m.function_len) {
        val r: res[structure.Structure, fail.Fail] = analyze(?m.functions[i], alloc);
        if (sel r.err) {
            structure.dnit_module(out, i, alloc);
            ret res[*structure.Structure, fail.Fail].err{r.err};
        }
        out[i] = r.ok;
        i      = i + 1;
    }
    ret res[*structure.Structure, fail.Fail].ok{out};
}

fun build_nodes(st: *structure.Structure, mf: *lang_mir.MirFunction) err[fail.Fail] {
    var i: u32 = 0;
    for (i < mf.block_count) {
        val blk: *lang_mir.MirBlock = ?mf.blocks[i];
        var n:   structure.Node     = blank_node(structure.ROLE_REAL);
        n.id        = blk.id;
        n.block     = i;
        st.nodes[i] = n;
        i           = i + 1;
    }
    st.count = mf.block_count;

    i = 0;
    for (i < mf.block_count) {
        val blk: *lang_mir.MirBlock = ?mf.blocks[i];
        if (blk.instr_count == 0) {
            st.status = structure.CFG_NO_TERMINATOR;
            st.at     = blk.id;
            ret err[fail.Fail].ok{};
        }
        val term:  *lang_mir.MirInstr = ?blk.instrs[blk.instr_count - 1];
        var first: u32                = 0;
        var n:     u32                = 0;
        if (term.opcode == lang_mir.MIR_BR) {
            if (term.operand_count < 1 || term.operands[0].kind != lang_mir.MIR_OP_BLOCK) {
                st.status = structure.CFG_NO_TERMINATOR;
                st.at     = blk.id;
                ret err[fail.Fail].ok{};
            }
            first = 0;
            n     = 1;
        }
        or (term.opcode == lang_mir.MIR_CBR) {
            if (term.operand_count < 3 || term.operands[1].kind != lang_mir.MIR_OP_BLOCK
                || term.operands[2].kind != lang_mir.MIR_OP_BLOCK) {
                st.status = structure.CFG_NO_TERMINATOR;
                st.at     = blk.id;
                ret err[fail.Fail].ok{};
            }
            first = 1;
            n     = 2;
        }
        or (term.opcode == lang_mir.MIR_RET || term.opcode == lang_mir.MIR_UNREACHABLE) { n = 0; }
        or {
            # a terminator outside these with block operands is a multi-way branch,
            # which MIR does not produce yet
            if (instr_has_block_operand(term)) { st.status = structure.CFG_MULTIWAY; }
            or                                 { st.status = structure.CFG_NO_TERMINATOR; }
            st.at = blk.id;
            ret err[fail.Fail].ok{};
        }
        val edges: res[u32, fail.Fail] = push_edges(st, n);
        if (sel edges.err) { ret err[fail.Fail].err{edges.err}; }
        val e: u32 = edges.ok;
        st.nodes[i].edge  = e;
        st.nodes[i].nsucc = n;
        var k: u32 = 0;
        for (k < n) {
            val s: u32 = node_of_id(st, term.operands[first + k].imm::u32);
            if (s == structure.NO_BLOCK) {
                st.status = structure.CFG_NO_TERMINATOR;
                st.at     = blk.id;
                ret err[fail.Fail].ok{};
            }
            set_succ(st, i, k, s);
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun blank_node(role: u8) structure.Node {
    var n: structure.Node;
    n.id       = structure.NO_BLOCK;
    n.block    = structure.NO_BLOCK;
    n.edge     = 0;
    n.nsucc    = 0;
    n.idom     = structure.NO_BLOCK;
    n.rpo      = structure.NO_BLOCK;
    n.kind     = structure.CK_PLAIN;
    n.merge    = structure.NO_BLOCK;
    n.cont     = structure.NO_BLOCK;
    n.loop_hdr = structure.NO_BLOCK;
    n.split    = structure.NO_BLOCK;
    n.role     = role;
    n.dispatch = structure.NO_BLOCK;
    n.case     = 0;
    ret n;
}

fun instr_has_block_operand(mi: *lang_mir.MirInstr) bool {
    var i: u32 = 0;
    for (i < mi.operand_count) {
        if (mi.operands[i].kind == lang_mir.MIR_OP_BLOCK) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun node_of_id(st: *structure.Structure, id: u32) u32 {
    var i: u32 = 0;
    for (i < st.real) {
        if (st.nodes[i].id == id) { ret i; }
        i = i + 1;
    }
    ret structure.NO_BLOCK;
}

# reserves n successor slots, answering the first
fun push_edges(st: *structure.Structure, n: u32) res[u32, fail.Fail] {
    val need:  usize        = st.succ_len::usize + n::usize;
    val grown: err[A.Error] = growth.reserve[u32](st.alloc, ?st.succs, ?st.succ_cap, need);
    if (sel grown.err) { ret res[u32, fail.Fail].err{fail.refused(grown.err)}; }
    val at: u32 = st.succ_len;
    var i:  u32 = 0;
    for (i < n) {
        st.succs[at + i] = structure.NO_BLOCK;
        i                = i + 1;
    }
    st.succ_len = need::u32;
    ret res[u32, fail.Fail].ok{at};
}

# each real node's reverse postorder number, and the refusal of a block the
# entry does not reach
fun rpo_take(st: *structure.Structure, g: *flow.Graph) {
    var i: u32 = 0;
    for (i < st.real) {
        st.nodes[i].rpo = g.rpo_num[i];
        i               = i + 1;
    }
    if (g.reached == st.real) { ret; }
    st.status = structure.CFG_UNREACHABLE;
    i         = 0;
    for (i < st.real) {
        if (!flow.block_is_reached(g, i)) {
            st.at = st.nodes[i].id;
            ret;
        }
        i = i + 1;
    }
}

fun has_succ(st: *structure.Structure, p: u32, b: u32) bool {
    var k: u32 = 0;
    for (k < st.nodes[p].nsucc) {
        if (structure.succ(st, p, k) == b) { ret true; }
        k = k + 1;
    }
    ret false;
}

fun intersect(st: *structure.Structure, a: u32, b: u32) u32 {
    var x: u32 = a;
    var y: u32 = b;
    for (x != y) {
        for (st.nodes[x].rpo > st.nodes[y].rpo) { x = st.nodes[x].idom; }
        for (st.nodes[y].rpo > st.nodes[x].rpo) { y = st.nodes[y].idom; }
    }
    ret x;
}

# the nearest common dominator of a and b, either of which may be synthetic,
# or the other one when one is NO_BLOCK
fun common_dom(st: *structure.Structure, a: u32, b: u32) u32 {
    if (a == structure.NO_BLOCK) { ret b; }
    if (b == structure.NO_BLOCK) { ret a; }
    var x:  u32 = a;
    var y:  u32 = b;
    var dx: u32 = depth(st, x);
    var dy: u32 = depth(st, y);
    for (dx > dy) {
        x  = st.nodes[x].idom;
        dx = dx - 1;
    }
    for (dy > dx) {
        y  = st.nodes[y].idom;
        dy = dy - 1;
    }
    for (x != y) {
        x = st.nodes[x].idom;
        y = st.nodes[y].idom;
    }
    ret x;
}

pub fun dominates(st: *structure.Structure, a: u32, b: u32) bool {
    if (a == structure.NO_BLOCK || b == structure.NO_BLOCK) { ret false; }
    var x: u32 = b;
    for (x != structure.NO_BLOCK) {
        if (x == a) { ret true; }
        x = st.nodes[x].idom;
    }
    ret false;
}

fun find_loops(st: *structure.Structure, g: *flow.Graph) err[fail.Fail] {
    val n: u32 = st.real;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    var i: u32 = 0;
    for (i < n) {
        if (st.nodes[i].rpo != structure.NO_BLOCK) {
            var k: u32 = 0;
            for (k < st.nodes[i].nsucc) {
                val s: u32 = structure.succ(st, i, k);
                if (st.nodes[s].rpo <= st.nodes[i].rpo) {
                    if (!dominates(st, s, i)) {
                        st.status = structure.CFG_IRREDUCIBLE;
                        st.at     = st.nodes[s].id;
                        ret err[fail.Fail].ok{};
                    }
                    st.nodes[s].kind = structure.CK_LOOP;
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }

    val rs: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    val stack: *u32                = rs.ok;
    val rq:    res[*bool, A.Error] = A.allocate[bool](st.alloc, n::usize);
    if (sel rq.err) {
        A.deallocate[u32](st.alloc, stack, n::usize);
        ret err[fail.Fail].err{fail.refused(rq.err)};
    }
    val entered: *bool = rq.ok;

    var pos: u32 = n;
    for (pos > 0) {
        pos = pos - 1;
        var h: u32 = structure.NO_BLOCK;
        i = 0;
        for (i < n) {
            if (st.nodes[i].rpo == pos && st.nodes[i].kind == structure.CK_LOOP) { h = i; }
            i = i + 1;
        }
        if (h == structure.NO_BLOCK) { cnt; }

        if (st.nodes[h].loop_hdr == structure.NO_BLOCK) { st.nodes[h].loop_hdr = h; }
        i = 0;
        for (i < n) {
            entered[i] = false;
            i          = i + 1;
        }
        var sp: u32 = 0;
        var e:  u32 = g.pred_start[h];
        for (e < g.pred_start[h + 1]) {
            val latch: u32 = g.pred[e];
            if (pred_is_first(g, h, e) && dominates(st, h, latch)) { sp = enter_body(st, h, latch, stack, sp, entered); }
            e = e + 1;
        }
        for (sp > 0) {
            sp = sp - 1;
            val b:  u32 = stack[sp];
            var pe: u32 = g.pred_start[b];
            for (pe < g.pred_start[b + 1]) {
                val p: u32 = g.pred[pe];
                if (pred_is_first(g, b, pe) && p != h) { sp = enter_body(st, h, p, stack, sp, entered); }
                pe = pe + 1;
            }
        }
    }

    A.deallocate[u32](st.alloc, stack, n::usize);
    A.deallocate[bool](st.alloc, entered, n::usize);
    ret err[fail.Fail].ok{};
}

# whether predecessor edge e of b is the first from its source: a branch
# naming b from both arms counts once
fun pred_is_first(g: *flow.Graph, b: u32, e: u32) bool {
    ret e == g.pred_start[b] || g.pred[e - 1] != g.pred[e];
}

# adds block p to the body of the loop at h, or, when p already lies in a loop
# nested in it, the outermost loop around p that has no enclosing loop yet, so
# the walk goes on from that loop's header. answers the new stack depth
fun enter_body(st: *structure.Structure, h: u32, p: u32, stack: *u32, sp: u32, entered: *bool) u32 {
    if (st.nodes[p].loop_hdr == structure.NO_BLOCK) {
        st.nodes[p].loop_hdr = h;
        stack[sp]            = p;
        ret sp + 1;
    }
    val t: u32 = top_loop(st, st.nodes[p].loop_hdr);
    if (t == h || entered[t]) { ret sp; }
    entered[t] = true;
    stack[sp]  = t;
    ret sp + 1;
}

fun top_loop(st: *structure.Structure, h: u32) u32 {
    var t: u32 = h;
    for (outer_loop(st, t) != structure.NO_BLOCK) { t = outer_loop(st, t); }
    ret t;
}

fun outer_loop(st: *structure.Structure, h: u32) u32 {
    val d: u32 = st.nodes[h].idom;
    if (d == structure.NO_BLOCK) { ret structure.NO_BLOCK; }
    ret st.nodes[d].loop_hdr;
}

fun in_loop(st: *structure.Structure, h: u32, b: u32) bool {
    var l: u32 = st.nodes[b].loop_hdr;
    for (l != structure.NO_BLOCK) {
        if (l == h) { ret true; }
        l = outer_loop(st, l);
    }
    ret false;
}

rec Scratch {
    a:     *bool;
    b:     *bool;
    seen:  *bool;
    score: *u32;
    stack: *u32;
    n:     u32;
}

fun scratch_alloc(st: *structure.Structure, sc: *Scratch, n: u32) err[fail.Fail] {
    sc.n     = 0;
    sc.a     = nil;
    sc.b     = nil;
    sc.seen  = nil;
    sc.score = nil;
    sc.stack = nil;
    val ra: res[*bool, A.Error] = A.allocate[bool](st.alloc, n::usize);
    if (sel ra.err) { ret err[fail.Fail].err{fail.refused(ra.err)}; }
    sc.a = ra.ok;
    val rb: res[*bool, A.Error] = A.allocate[bool](st.alloc, n::usize);
    if (sel rb.err) {
        scratch_free(st, sc, n);
        ret err[fail.Fail].err{fail.refused(rb.err)};
    }
    sc.b = rb.ok;
    val rk: res[*bool, A.Error] = A.allocate[bool](st.alloc, n::usize);
    if (sel rk.err) {
        scratch_free(st, sc, n);
        ret err[fail.Fail].err{fail.refused(rk.err)};
    }
    sc.seen = rk.ok;
    val rc: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel rc.err) {
        scratch_free(st, sc, n);
        ret err[fail.Fail].err{fail.refused(rc.err)};
    }
    sc.score = rc.ok;
    val rs: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel rs.err) {
        scratch_free(st, sc, n);
        ret err[fail.Fail].err{fail.refused(rs.err)};
    }
    sc.stack = rs.ok;
    sc.n     = n;
    ret err[fail.Fail].ok{};
}

fun scratch_free(st: *structure.Structure, sc: *Scratch, n: u32) {
    if (sc.a != nil)     { A.deallocate[bool](st.alloc, sc.a, n::usize); }
    if (sc.b != nil)     { A.deallocate[bool](st.alloc, sc.b, n::usize); }
    if (sc.seen != nil)  { A.deallocate[bool](st.alloc, sc.seen, n::usize); }
    if (sc.score != nil) { A.deallocate[u32](st.alloc, sc.score, n::usize); }
    if (sc.stack != nil) { A.deallocate[u32](st.alloc, sc.stack, n::usize); }
    sc.a     = nil;
    sc.b     = nil;
    sc.seen  = nil;
    sc.score = nil;
    sc.stack = nil;
    sc.n     = 0;
}

# the scratch arrays cover every node, after synthetic ones were added
fun scratch_fit(st: *structure.Structure, sc: *Scratch) err[fail.Fail] {
    if (sc.n >= st.count) { ret err[fail.Fail].ok{}; }
    scratch_free(st, sc, sc.n);
    ret scratch_alloc(st, sc, st.cap);
}

fun assign_merges(st: *structure.Structure) err[fail.Fail] {
    var sc:   Scratch;
    val made: err[fail.Fail] = scratch_alloc(st, ?sc, st.cap);
    if (sel made.err) { ret made; }
    val r: err[fail.Fail] = assign_with(st, ?sc);
    scratch_free(st, ?sc, sc.n);
    ret r;
}

fun assign_with(st: *structure.Structure, sc: *Scratch) err[fail.Fail] {
    var d: u32 = max_depth(st) + 1;
    for (d > 0) {
        d = d - 1;
        var h: u32 = 0;
        for (h < st.count) {
            if (st.nodes[h].kind != structure.CK_LOOP || depth(st, h) != d) {
                h = h + 1;
                cnt;
            }

            val cont: res[u32, fail.Fail] = push_node(st, structure.ROLE_CONTINUE, h);
            if (sel cont.err) { ret err[fail.Fail].err{cont.err}; }
            val c: u32 = cont.ok;
            st.nodes[h].cont = c;
            var cdom: u32 = structure.NO_BLOCK;
            var i:    u32 = 0;
            for (i < st.count) {
                if (i != c && in_loop(st, h, i)) {
                    var hit: bool = false;
                    var k:   u32  = 0;
                    for (k < st.nodes[i].nsucc) {
                        if (structure.succ(st, i, k) == h) {
                            set_succ(st, i, k, c);
                            hit = true;
                        }
                        k = k + 1;
                    }
                    if (hit) {
                        if (cdom == structure.NO_BLOCK) { cdom = i; }
                        or                              { cdom = intersect(st, i, cdom); }
                    }
                }
                i = i + 1;
            }
            if (cdom != structure.NO_BLOCK) { st.nodes[c].idom = cdom; }

            val mb: res[u32, fail.Fail] = loop_merge(st, sc, h);
            if (sel mb.err) { ret err[fail.Fail].err{mb.err}; }
            st.nodes[h].merge = mb.ok;

            val split: err[fail.Fail] = split_header(st, h);
            if (sel split.err) { ret split; }
            h = h + 1;
        }
    }

    val c1: err[fail.Fail] = check_claims(st);
    if (sel c1.err) { ret c1; }

    val top: u32 = max_depth(st);
    d = 0;
    for (d <= top) {
        var s: u32 = 0;
        for (s < st.count) {
            if (st.nodes[s].kind == structure.CK_LOOP || depth(st, s) != d) {
                s = s + 1;
                cnt;
            }
            var mb: res[u32, fail.Fail];
            if (st.nodes[s].role == structure.ROLE_DISPATCH || st.nodes[s].nsucc > 2) {
                st.nodes[s].kind = structure.CK_SWITCH;
                mb               = switch_merge(st, sc, s);
            }
            or (st.nodes[s].nsucc == 2) {
                st.nodes[s].kind = structure.CK_SELECTION;
                mb               = sel_merge(st, sc, s);
            }
            or {
                s = s + 1;
                cnt;
            }
            if (sel mb.err) { ret err[fail.Fail].err{mb.err}; }
            st.nodes[s].merge = mb.ok;
            s                 = s + 1;
        }
        d = d + 1;
    }

    ret check_claims(st);
}

fun depth(st: *structure.Structure, x: u32) u32 {
    var d: u32 = 0;
    var c: u32 = st.nodes[x].idom;
    for (c != structure.NO_BLOCK) {
        d = d + 1;
        c = st.nodes[c].idom;
    }
    ret d;
}

fun max_depth(st: *structure.Structure) u32 {
    var m: u32 = 0;
    var i: u32 = 0;
    for (i < st.count) {
        val d: u32 = depth(st, i);
        if (d > m) { m = d; }
        i = i + 1;
    }
    ret m;
}

fun split_header(st: *structure.Structure, h: u32) err[fail.Fail] {
    if (st.nodes[h].nsucc != 2) { ret err[fail.Fail].ok{}; }
    val m: u32 = st.nodes[h].merge;
    val c: u32 = st.nodes[h].cont;
    if (has_succ(st, h, m) || has_succ(st, h, c)) { ret err[fail.Fail].ok{}; }

    val made: res[u32, fail.Fail] = push_node(st, structure.ROLE_SPLIT, structure.NO_BLOCK);
    if (sel made.err) { ret err[fail.Fail].err{made.err}; }
    val sp: u32 = made.ok;
    st.nodes[sp].edge     = st.nodes[h].edge;
    st.nodes[sp].nsucc    = 2;
    st.nodes[sp].idom     = h;
    st.nodes[sp].loop_hdr = h;
    st.nodes[sp].block    = st.nodes[h].block;
    var i: u32 = 0;
    for (i < st.count) {
        if (i != sp && st.nodes[i].idom == h) { st.nodes[i].idom = sp; }
        i = i + 1;
    }
    val edges: res[u32, fail.Fail] = push_edges(st, 1);
    if (sel edges.err) { ret err[fail.Fail].err{edges.err}; }
    val e: u32 = edges.ok;
    st.nodes[h].edge  = e;
    st.nodes[h].nsucc = 1;
    set_succ(st, h, 0, sp);
    st.nodes[h].split = sp;
    ret err[fail.Fail].ok{};
}

fun forward_merge(st: *structure.Structure, h: u32, m: u32) res[u32, fail.Fail] {
    val made: res[u32, fail.Fail] = push_node(st, structure.ROLE_FORWARD, m);
    if (sel made.err) { ret made; }
    val f: u32 = made.ok;
    st.nodes[f].nsucc    = 1;
    st.nodes[f].idom     = h;
    st.nodes[f].loop_hdr = st.nodes[h].loop_hdr;
    if (st.nodes[h].kind == structure.CK_LOOP) { st.nodes[f].loop_hdr = outer_loop(st, h); }

    var i: u32 = 0;
    for (i < st.count) {
        if (i != f && i != m && dominates(st, h, i)) {
            var k: u32 = 0;
            for (k < st.nodes[i].nsucc) {
                if (structure.succ(st, i, k) == m) { set_succ(st, i, k, f); }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    ret made;
}

# the merge of the loop at h: the block its exits reconverge on, a forward to it
# when another construct merges there, or an exit dispatch when its exits leave
# its construct along more than one way
fun loop_merge(st: *structure.Structure, sc: *Scratch, h: u32) res[u32, fail.Fail] {
    val fit: err[fail.Fail] = scratch_fit(st, sc);
    if (sel fit.err) { ret res[u32, fail.Fail].err{fit.err}; }
    var i: u32 = 0;
    for (i < sc.n) {
        sc.seen[i]  = false;
        sc.score[i] = 0;
        i           = i + 1;
    }

    var exits:    u32 = 0;
    var one_exit: u32 = structure.NO_BLOCK;
    var b:        u32 = 0;
    for (b < st.count) {
        if (in_loop(st, h, b)) {
            var k: u32 = 0;
            for (k < st.nodes[b].nsucc) {
                val t: u32 = structure.succ(st, b, k);
                if (!in_loop(st, h, t) && !sc.seen[t]) {
                    sc.seen[t] = true;
                    exits      = exits + 1;
                    one_exit   = t;
                    reach_from(st, sc, t, h, sc.a);
                    i = 0;
                    for (i < sc.n) {
                        if (sc.a[i]) { sc.score[i] = sc.score[i] + 1; }
                        i = i + 1;
                    }
                }
                k = k + 1;
            }
        }
        b = b + 1;
    }

    if (exits == 0) { ret push_node(st, structure.ROLE_UNREACHABLE, structure.NO_BLOCK); }

    var merge: u32 = structure.NO_BLOCK;
    i = 0;
    for (i < st.count) {
        if (sc.score[i] > 0 && i != h && !in_loop(st, h, i) && dominates(st, h, i)
            && !merge_reenters(st, h, i)) {
            if (merge == structure.NO_BLOCK || sc.score[i] > sc.score[merge]
                || (sc.score[i] == sc.score[merge] && rpo_before(st, i, merge))) {
                merge = i;
            }
        }
        i = i + 1;
    }
    if (merge != structure.NO_BLOCK && !exits_stray(st, sc, h, merge)) {
        if (is_claimed(st, merge)) { ret forward_merge(st, h, merge); }
        ret res[u32, fail.Fail].ok{merge};
    }
    if (merge == structure.NO_BLOCK && exits == 1 && !merge_reenters(st, h, one_exit)) { ret forward_merge(st, h, one_exit); }
    ret dispatch_exits(st, sc, h);
}

# whether an exit of the loop at h other than its merge m leaves the loop's
# construct along an edge the construct cannot take: one into a block the loop
# does not dominate, except a branch to the loop around it or out of that loop.
# sc.seen marks the exits
fun exits_stray(st: *structure.Structure, sc: *Scratch, h: u32, m: u32) bool {
    var t: u32 = 0;
    for (t < st.count) {
        if (sc.seen[t] && t != m) {
            if (!dominates(st, h, t)) {
                if (!leaves_to_enclosing(st, h, t)) { ret true; }
            }
            or (region_strays(st, sc, h, m, t)) { ret true; }
        }
        t = t + 1;
    }
    ret false;
}

# a branch out of the loop at h to v, a block it does not dominate, that the
# loop around it takes as a continue or a break
fun leaves_to_enclosing(st: *structure.Structure, h: u32, v: u32) bool {
    val l: u32 = outer_loop(st, h);
    if (l == structure.NO_BLOCK) { ret false; }
    if (v == l)                  { ret true; }
    ret !in_loop(st, l, v);
}

# whether the blocks the exit t of the loop at h leads to, short of its merge m,
# branch anywhere leaves_to_enclosing does not admit
fun region_strays(st: *structure.Structure, sc: *Scratch, h: u32, m: u32, t: u32) bool {
    var i: u32 = 0;
    for (i < sc.n) {
        sc.b[i] = false;
        i       = i + 1;
    }
    sc.b[t]     = true;
    sc.stack[0] = t;
    var sp: u32 = 1;
    for (sp > 0) {
        sp = sp - 1;
        val x: u32 = sc.stack[sp];
        var k: u32 = 0;
        for (k < st.nodes[x].nsucc) {
            val v: u32 = structure.succ(st, x, k);
            if (!dominates(st, h, v)) {
                if (!leaves_to_enclosing(st, h, v)) { ret true; }
            }
            or (v != m && !sc.b[v]) {
                sc.b[v]      = true;
                sc.stack[sp] = v;
                sp           = sp + 1;
            }
            k = k + 1;
        }
    }
    ret false;
}

# gives the loop at h one merge its exits all reach: each exit target t_k is
# entered from the loop through an exit node that selects case k and branches to
# a dispatch node, the merge, which branches on to t_k. an exit
# leaves_to_enclosing admits keeps its edge
fun dispatch_exits(st: *structure.Structure, sc: *Scratch, h: u32) res[u32, fail.Fail] {
    val first: u32 = st.count;
    var n:     u32 = 0;
    var t:     u32 = 0;
    for (t < first) {
        if (sc.seen[t] && (dominates(st, h, t) || !leaves_to_enclosing(st, h, t))) {
            sc.stack[n] = t;
            n           = n + 1;
        }
        t = t + 1;
    }
    if (n == 1) { ret forward_merge(st, h, sc.stack[0]); }

    # the loop the dispatched code lies in: the nearest loop around h that one
    # of the targets is still inside
    var lh: u32 = outer_loop(st, h);
    for (lh != structure.NO_BLOCK) {
        var inside: bool = false;
        var k:      u32  = 0;
        for (k < n) {
            if (in_loop(st, lh, sc.stack[k])) { inside = true; }
            k = k + 1;
        }
        if (inside) { brk; }
        lh = outer_loop(st, lh);
    }

    # every block outside the loop that it dominated is now reached through the
    # dispatch: mark them before any dominator changes
    var x: u32 = 0;
    for (x < first) {
        sc.a[x] = x != h && !in_loop(st, h, x) && dominates(st, h, x)
            && (st.nodes[x].idom == h || in_loop(st, h, st.nodes[x].idom));
        x = x + 1;
    }

    val made: res[u32, fail.Fail] = push_node(st, structure.ROLE_DISPATCH, structure.NO_BLOCK);
    if (sel made.err) { ret made; }
    val d:     u32                 = made.ok;
    val edges: res[u32, fail.Fail] = push_edges(st, n);
    if (sel edges.err) { ret edges; }
    val e: u32 = edges.ok;
    st.nodes[d].edge     = e;
    st.nodes[d].nsucc    = n;
    st.nodes[d].kind     = structure.CK_SWITCH;
    st.nodes[d].loop_hdr = lh;

    var ddom: u32 = structure.NO_BLOCK;
    var k:    u32 = 0;
    for (k < n) {
        val tk:   u32                 = sc.stack[k];
        val exit: res[u32, fail.Fail] = push_node(st, structure.ROLE_EXIT, d);
        if (sel exit.err) { ret exit; }
        val xk: u32 = exit.ok;
        st.nodes[xk].dispatch = d;
        st.nodes[xk].case     = k;
        st.nodes[xk].loop_hdr = lh;
        var xdom: u32 = structure.NO_BLOCK;
        var b:    u32 = 0;
        for (b < first) {
            if (in_loop(st, h, b)) {
                var j: u32 = 0;
                for (j < st.nodes[b].nsucc) {
                    if (structure.succ(st, b, j) == tk) {
                        set_succ(st, b, j, xk);
                        xdom = common_dom(st, xdom, b);
                    }
                    j = j + 1;
                }
            }
            b = b + 1;
        }
        st.nodes[xk].idom = xdom;
        ddom              = common_dom(st, ddom, xdom);
        if (dominates(st, h, tk)) { set_succ(st, d, k, tk); }
        or {
            val forward: res[u32, fail.Fail] = push_node(st, structure.ROLE_FORWARD, tk);
            if (sel forward.err) { ret forward; }
            val f: u32 = forward.ok;
            st.nodes[f].nsucc    = 1;
            st.nodes[f].idom     = d;
            st.nodes[f].loop_hdr = lh;
            set_succ(st, d, k, f);
        }
        k = k + 1;
    }
    st.nodes[d].idom = ddom;

    x = 0;
    for (x < first) {
        if (sc.a[x]) { st.nodes[x].idom = d; }
        x = x + 1;
    }
    ret made;
}

fun merge_reenters(st: *structure.Structure, h: u32, m: u32) bool {
    var x: u32 = 0;
    for (x < st.count) {
        if (dominates(st, m, x)) {
            var k: u32 = 0;
            for (k < st.nodes[x].nsucc) {
                val v: u32 = structure.succ(st, x, k);
                if (v != m && dominates(st, h, v) && !dominates(st, m, v)) { ret true; }
                k = k + 1;
            }
        }
        x = x + 1;
    }
    ret false;
}

fun sel_merge(st: *structure.Structure, sc: *Scratch, s: u32) res[u32, fail.Fail] {
    val fit: err[fail.Fail] = scratch_fit(st, sc);
    if (sel fit.err) { ret res[u32, fail.Fail].err{fit.err}; }
    val s0: u32 = structure.succ(st, s, 0);
    val s1: u32 = structure.succ(st, s, 1);
    reach_from(st, sc, s0, s, sc.a);
    reach_from(st, sc, s1, s, sc.b);

    var merge: u32 = structure.NO_BLOCK;
    var i:     u32 = 0;
    for (i < st.count) {
        if (sc.a[i] && sc.b[i] && i != s && dominates(st, s, i) && in_enclosing(st, s, i)) {
            if (merge == structure.NO_BLOCK || rpo_before(st, i, merge)) { merge = i; }
        }
        i = i + 1;
    }
    if (merge == structure.NO_BLOCK) {
        val e0: bool = arm_escapes(st, s, s0);
        val e1: bool = arm_escapes(st, s, s1);
        if (e0 && !e1 && in_enclosing(st, s, s0)) { merge = s0; }
        or (e1 && !e0 && in_enclosing(st, s, s1)) { merge = s1; }
    }
    if (merge == structure.NO_BLOCK) {
        # the arms leave through one block the header does not dominate (an inlined callee's
        # returns all joining at the caller's continuation): that block is the merge of an
        # enclosing construct, and this selection reaches it through a merge of its own
        val exit: u32 = sole_exit(st, s);
        if (exit != structure.NO_BLOCK) { ret forward_merge(st, s, exit); }
    }
    if (merge == structure.NO_BLOCK) { ret push_node(st, structure.ROLE_UNREACHABLE, structure.NO_BLOCK); }
    if (is_claimed(st, merge))       { ret forward_merge(st, s, merge); }
    ret res[u32, fail.Fail].ok{merge};
}

# the merge of the switch at s: the first block every arm reaches, or a forward
# to the one block its arms leave it through, as for a selection
fun switch_merge(st: *structure.Structure, sc: *Scratch, s: u32) res[u32, fail.Fail] {
    val fit: err[fail.Fail] = scratch_fit(st, sc);
    if (sel fit.err) { ret res[u32, fail.Fail].err{fit.err}; }
    val n: u32 = st.nodes[s].nsucc;
    var i: u32 = 0;
    for (i < sc.n) {
        sc.score[i] = 0;
        i           = i + 1;
    }
    var k: u32 = 0;
    for (k < n) {
        reach_from(st, sc, structure.succ(st, s, k), s, sc.a);
        i = 0;
        for (i < sc.n) {
            if (sc.a[i]) { sc.score[i] = sc.score[i] + 1; }
            i = i + 1;
        }
        k = k + 1;
    }

    var merge: u32 = structure.NO_BLOCK;
    i = 0;
    for (i < st.count) {
        if (sc.score[i] == n && i != s && dominates(st, s, i) && in_enclosing(st, s, i)) {
            if (merge == structure.NO_BLOCK || rpo_before(st, i, merge)) { merge = i; }
        }
        i = i + 1;
    }
    if (merge == structure.NO_BLOCK) {
        val exit: u32 = sole_exit(st, s);
        if (exit != structure.NO_BLOCK) { ret forward_merge(st, s, exit); }
        ret push_node(st, structure.ROLE_UNREACHABLE, structure.NO_BLOCK);
    }
    if (is_claimed(st, merge)) { ret forward_merge(st, s, merge); }
    ret res[u32, fail.Fail].ok{merge};
}

# the one block outside the selection at s that its body branches to, break and continue
# edges aside, or NO_BLOCK when the body has no such exit or more than one
fun sole_exit(st: *structure.Structure, s: u32) u32 {
    var exit: u32 = structure.NO_BLOCK;
    var x:    u32 = 0;
    for (x < st.count) {
        if (dominates(st, s, x) && in_enclosing(st, s, x)) {
            var k: u32 = 0;
            for (k < st.nodes[x].nsucc) {
                val v: u32 = structure.succ(st, x, k);
                if (!dominates(st, s, v) && in_enclosing(st, s, v)) {
                    if (exit == structure.NO_BLOCK) { exit = v; }
                    or (exit != v)                  { ret structure.NO_BLOCK; }
                }
                k = k + 1;
            }
        }
        x = x + 1;
    }
    ret exit;
}

fun in_enclosing(st: *structure.Structure, s: u32, m: u32) bool {
    var l: u32 = st.nodes[s].loop_hdr;
    for (l != structure.NO_BLOCK) {
        if (dominates(st, st.nodes[l].merge, m)) { ret false; }
        if (m == st.nodes[l].cont)               { ret false; }
        l = outer_loop(st, l);
    }
    ret true;
}

fun arm_escapes(st: *structure.Structure, s: u32, arm: u32) bool {
    var x: u32 = 0;
    for (x < st.count) {
        if (dominates(st, arm, x)) {
            var k: u32 = 0;
            for (k < st.nodes[x].nsucc) {
                if (!dominates(st, s, structure.succ(st, x, k))) { ret true; }
                k = k + 1;
            }
        }
        x = x + 1;
    }
    ret false;
}

fun rpo_before(st: *structure.Structure, a: u32, b: u32) bool {
    if (st.nodes[a].rpo == structure.NO_BLOCK) { ret false; }
    if (st.nodes[b].rpo == structure.NO_BLOCK) { ret true; }
    ret st.nodes[a].rpo < st.nodes[b].rpo;
}

fun reach_from(st: *structure.Structure, sc: *Scratch, from: u32, avoid: u32, out: *bool) {
    var i: u32 = 0;
    for (i < sc.n) {
        out[i] = false;
        i      = i + 1;
    }
    if (from == structure.NO_BLOCK || from == avoid) { ret; }
    out[from] = true;
    var sp: u32 = 0;
    sc.stack[0] = from;
    sp          = 1;
    for (sp > 0) {
        sp = sp - 1;
        val cur: u32 = sc.stack[sp];
        var k:   u32 = 0;
        for (k < st.nodes[cur].nsucc) {
            val v: u32 = structure.succ(st, cur, k);
            if (v != avoid && !out[v]) {
                out[v]       = true;
                sc.stack[sp] = v;
                sp           = sp + 1;
            }
            k = k + 1;
        }
    }
}

fun is_claimed(st: *structure.Structure, b: u32) bool {
    var i: u32 = 0;
    for (i < st.count) {
        if (st.nodes[i].merge == b) { ret true; }
        if (st.nodes[i].cont == b)  { ret true; }
        i = i + 1;
    }
    ret false;
}

# every construct merges on a block of its own: a block two of them reconverge
# on was given one forward merge per construct, so a shared one is a defect here
fun check_claims(st: *structure.Structure) err[fail.Fail] {
    var i: u32 = 0;
    for (i < st.count) {
        val m: u32 = st.nodes[i].merge;
        if (m != structure.NO_BLOCK) {
            var j: u32 = i + 1;
            for (j < st.count) {
                if (st.nodes[j].merge == m || st.nodes[j].cont == m) {
                    ret err[fail.Fail].err{fail.message("structure: two constructs merge on one block")};
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun push_node(st: *structure.Structure, role: u8, target: u32) res[u32, fail.Fail] {
    val grown: err[A.Error] = growth.reserve[structure.Node](st.alloc, ?st.nodes, ?st.cap, st.count::usize + 1);
    if (sel grown.err) { ret res[u32, fail.Fail].err{fail.refused(grown.err)}; }
    val edges: res[u32, fail.Fail] = push_edges(st, 1);
    if (sel edges.err) { ret edges; }
    val e: u32            = edges.ok;
    var n: structure.Node = blank_node(role);
    n.edge      = e;
    st.succs[e] = target;
    if (role == structure.ROLE_CONTINUE) {
        n.nsucc    = 1;
        n.idom     = target;
        n.loop_hdr = target;
    }
    if (role == structure.ROLE_EXIT) { n.nsucc = 1; }
    val ix: u32 = st.count;
    st.nodes[ix] = n;
    st.count     = ix + 1;
    ret res[u32, fail.Fail].ok{ix};
}

fun build_order(st: *structure.Structure) err[fail.Fail] {
    val ro: res[*u32, A.Error] = A.allocate[u32](st.alloc, st.cap::usize);
    if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
    st.order = ro.ok;
    val rp: res[*bool, A.Error] = A.allocate[bool](st.alloc, st.cap::usize);
    if (sel rp.err) { ret err[fail.Fail].err{fail.refused(rp.err)}; }
    val placed: *bool = rp.ok;
    var i:      u32   = 0;
    for (i < st.cap) {
        placed[i] = false;
        i         = i + 1;
    }

    var k:   u32 = 0;
    var pos: u32 = 0;
    for (pos < st.real) {
        i = 0;
        for (i < st.real) {
            if (st.nodes[i].rpo == pos) {
                k           = place_feeders(st, i, placed, k);
                st.order[k] = i;
                k           = k + 1;
                placed[i]   = true;
                val sp: u32 = st.nodes[i].split;
                if (sp != structure.NO_BLOCK) {
                    st.order[k] = sp;
                    k           = k + 1;
                    placed[sp]  = true;
                }
            }
            i = i + 1;
        }
        pos = pos + 1;
    }

    i = st.real;
    for (i < st.count) {
        if (!placed[i]) {
            k           = place_feeders(st, i, placed, k);
            st.order[k] = i;
            k           = k + 1;
            placed[i]   = true;
        }
        i = i + 1;
    }

    A.deallocate[bool](st.alloc, placed, st.cap::usize);
    ret err[fail.Fail].ok{};
}

# places, ahead of target, the forward and dispatch nodes that branch to it,
# each behind its own such feeders, so every node follows its dominator
fun place_feeders(st: *structure.Structure, target: u32, placed: *bool, k: u32) u32 {
    var out: u32 = k;
    var j:   u32 = st.real;
    for (j < st.count) {
        if (!placed[j] && feeds(st, j, target)) {
            placed[j]     = true;
            out           = place_feeders(st, j, placed, out);
            st.order[out] = j;
            out           = out + 1;
        }
        j = j + 1;
    }
    ret out;
}

fun feeds(st: *structure.Structure, j: u32, target: u32) bool {
    if (st.nodes[j].role == structure.ROLE_FORWARD)  { ret structure.succ(st, j, 0) == target; }
    if (st.nodes[j].role == structure.ROLE_DISPATCH) { ret has_succ(st, j, target); }
    ret false;
}

fun construct_of(st: *structure.Structure, b: u32) u32 {
    if (st.nodes[b].kind != structure.CK_PLAIN) { ret b; }
    var x: u32 = b;
    for (x != structure.NO_BLOCK) {
        if (st.nodes[x].kind != structure.CK_PLAIN && in_construct(st, x, b)) { ret x; }
        x = st.nodes[x].idom;
    }
    ret structure.NO_BLOCK;
}

fun in_construct(st: *structure.Structure, h: u32, b: u32) bool {
    if (!dominates(st, h, b))                { ret false; }
    if (b == st.nodes[h].cont)               { ret false; }
    if (dominates(st, st.nodes[h].merge, b)) { ret false; }
    # a construct ends where the loop enclosing it ends, even when its own merge is
    # unreachable and so dominates nothing
    ret in_enclosing(st, h, b);
}

fun verify(st: *structure.Structure) {
    var b: u32 = 0;
    for (b < st.count) {
        var k: u32 = 0;
        for (k < st.nodes[b].nsucc) {
            val s: u32 = structure.succ(st, b, k);
            if (!edge_legal(st, b, s)) {
                st.status = structure.CFG_CROSSING_EDGE;
                st.at     = st.nodes[b].id;
                st.to     = s;
                ret;
            }
            k = k + 1;
        }
        b = b + 1;
    }
}

fun edge_legal(st: *structure.Structure, u: u32, v: u32) bool {
    if (st.nodes[u].role == structure.ROLE_CONTINUE) { ret v == structure.succ(st, u, 0); }

    val k: u32 = construct_of(st, u);
    if (k == structure.NO_BLOCK) { ret true; }
    if (in_construct(st, k, v))  { ret true; }
    if (v == st.nodes[k].merge)  { ret true; }

    var l: u32 = k;
    if (st.nodes[l].kind != structure.CK_LOOP) { l = st.nodes[l].loop_hdr; }
    for (l != structure.NO_BLOCK) {
        if (v == st.nodes[l].merge || v == st.nodes[l].cont) { ret true; }
        l = outer_loop(st, l);
    }
    ret false;
}

#[testing]
fun t_block(b: *lang_mir.MirBlock, id: u32, mi: *lang_mir.MirInstr) {
    b.id          = id;
    b.instrs      = mi;
    b.instr_count = 1;
    b.instr_cap   = 1;
}

#[testing]
fun t_br(mi: *lang_mir.MirInstr, ops: *lang_mir.MirOperand, target: u32) {
    ops[0]           = lang_mir.op_block(target);
    mi.opcode        = lang_mir.MIR_BR;
    mi.operands      = ops;
    mi.operand_count = 1;
}

#[testing]
fun t_cbr(mi: *lang_mir.MirInstr, ops: *lang_mir.MirOperand, t0: u32, t1: u32) {
    ops[0]           = lang_mir.op_vreg(lang_mir.vreg_id(0));
    ops[1]           = lang_mir.op_block(t0);
    ops[2]           = lang_mir.op_block(t1);
    mi.opcode        = lang_mir.MIR_CBR;
    mi.operands      = ops;
    mi.operand_count = 3;
}

#[testing]
fun t_ret(mi: *lang_mir.MirInstr) {
    mi.opcode        = lang_mir.MIR_RET;
    mi.operands      = nil;
    mi.operand_count = 0;
}

test analyze__selection_merge {
    var alloc:  A.Allocator;
    val r_1039: err[A.Error] = page.make(?alloc);
    if (sel r_1039.err) { ret 1; }

    var ops:    [3]lang_mir.MirOperand;
    var b1:     [1]lang_mir.MirOperand;
    var b2:     [1]lang_mir.MirOperand;
    var instrs: [4]lang_mir.MirInstr;
    t_cbr(?instrs[0], ?ops[0], 1, 2);
    t_br(?instrs[1], ?b1[0], 3);
    t_br(?instrs[2], ?b2[0], 3);
    t_ret(?instrs[3]);
    var blocks: [4]lang_mir.MirBlock;
    var i:      u32 = 0;
    for (i < 4) {
        t_block(?blocks[i], i, ?instrs[i]);
        i = i + 1;
    }
    var f: lang_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 4;
    f.vreg_count  = 1;

    val r: res[structure.Structure, fail.Fail] = analyze(?f, ?alloc);
    if (sel r.err) { ret 1; }
    var st: structure.Structure = r.ok;
    var rc: i32                 = 0;
    if (st.status != structure.CFG_OK)              { rc = 2; }
    if (st.nodes[0].kind != structure.CK_SELECTION) { rc = 3; }
    if (st.nodes[0].merge != 3)                     { rc = 4; }
    if (st.count != 4)                              { rc = 5; }
    structure.dnit(?st);
    ret rc;
}

test analyze__loop_continue_and_merge {
    var alloc:  A.Allocator;
    val r_1069: err[A.Error] = page.make(?alloc);
    if (sel r_1069.err) { ret 1; }

    var e0:     [1]lang_mir.MirOperand;
    var ops:    [3]lang_mir.MirOperand;
    var b2:     [1]lang_mir.MirOperand;
    var instrs: [4]lang_mir.MirInstr;
    t_br(?instrs[0], ?e0[0], 1);
    t_cbr(?instrs[1], ?ops[0], 2, 3);
    t_br(?instrs[2], ?b2[0], 1);
    t_ret(?instrs[3]);
    var blocks: [4]lang_mir.MirBlock;
    var i:      u32 = 0;
    for (i < 4) {
        t_block(?blocks[i], i, ?instrs[i]);
        i = i + 1;
    }
    var f: lang_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 4;
    f.vreg_count  = 1;

    val r: res[structure.Structure, fail.Fail] = analyze(?f, ?alloc);
    if (sel r.err) { ret 1; }
    var st: structure.Structure = r.ok;
    var rc: i32                 = 0;
    if (st.status != structure.CFG_OK)         { rc = 2; }
    if (st.nodes[1].kind != structure.CK_LOOP) { rc = 3; }
    if (st.nodes[1].merge != 3)                { rc = 4; }
    val c: u32 = st.nodes[1].cont;
    if (c < st.real)                                            { rc = 5; }
    if (rc == 0 && st.nodes[c].role != structure.ROLE_CONTINUE) { rc = 6; }
    if (rc == 0 && structure.succ(?st, c, 0) != 1)              { rc = 7; }
    if (rc == 0 && structure.succ(?st, 2, 0) != c)              { rc = 8; }
    structure.dnit(?st);
    ret rc;
}

test analyze__irreducible_is_refused {
    var alloc:  A.Allocator;
    val r_1103: err[A.Error] = page.make(?alloc);
    if (sel r_1103.err) { ret 1; }

    var ops:    [3]lang_mir.MirOperand;
    var b1:     [1]lang_mir.MirOperand;
    var b2:     [1]lang_mir.MirOperand;
    var instrs: [3]lang_mir.MirInstr;
    t_cbr(?instrs[0], ?ops[0], 1, 2);
    t_br(?instrs[1], ?b1[0], 2);
    t_br(?instrs[2], ?b2[0], 1);
    var blocks: [3]lang_mir.MirBlock;
    var i:      u32 = 0;
    for (i < 3) {
        t_block(?blocks[i], i, ?instrs[i]);
        i = i + 1;
    }
    var f: lang_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 3;
    f.vreg_count  = 1;

    val r: res[structure.Structure, fail.Fail] = analyze(?f, ?alloc);
    if (sel r.err) { ret 1; }
    var st: structure.Structure = r.ok;
    var rc: i32                 = 0;
    if (st.status != structure.CFG_IRREDUCIBLE) { rc = 2; }
    val text: res[str, std_format.FormatError] = structure.refusal_text(?alloc, "f", st.status, "wasm32");
    if (sel text.err) { rc = 3; }
    if (sel text.ok) {
        if (!str_contains(text.ok, "the wasm32 target requires structured control flow")) { rc = 4; }
    }
    structure.dnit(?st);
    ret rc;
}

