        t_block(?blocks[i], i, ?instrs[i]);
        i = i + 1;
    }
    var f: lang_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 6;
    f.vreg_count  = 1;

    val r: res[structure.Structure, fail.Fail] = analyze(?f, ?alloc);
    if (sel r.err) { ret 1; }
    var st: structure.Structure = r.ok;
    var rc: i32                 = 0;
    if (st.status != structure.CFG_OK)         { rc = 2; }
    if (st.nodes[1].kind != structure.CK_LOOP) { rc = 3; }
    if (st.nodes[3].kind != structure.CK_LOOP) { rc = 4; }
    if (st.nodes[2].loop_hdr != 1)             { rc = 5; }
    if (outer_loop(?st, 3) != 1)               { rc = 6; }
    structure.dnit(?st);
    ret rc;
}

# a loop inside one arm of a selection, left through two exits that only meet at
# the selection's merge (an inlined early return): the exits enter a dispatch,
# the loop's merge, which switches on to each of them
test analyze__loop_exits_that_do_not_reconverge_dispatch {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }

    var o0:     [3]lang_mir.MirOperand;
    var b1:     [1]lang_mir.MirOperand;
    var b2:     [1]lang_mir.MirOperand;
    var o3:     [3]lang_mir.MirOperand;
    var o4:     [3]lang_mir.MirOperand;
    var b5:     [1]lang_mir.MirOperand;
    var b6:     [1]lang_mir.MirOperand;
    var b7:     [1]lang_mir.MirOperand;
    var instrs: [9]lang_mir.MirInstr;
    t_cbr(?instrs[0], ?o0[0], 1, 2);
    t_br(?instrs[1], ?b1[0], 8);
    t_br(?instrs[2], ?b2[0], 3);
    t_cbr(?instrs[3], ?o3[0], 4, 7);
    t_cbr(?instrs[4], ?o4[0], 6, 5);
    t_br(?instrs[5], ?b5[0], 3);
    t_br(?instrs[6], ?b6[0], 8);
    t_br(?instrs[7], ?b7[0], 8);
    t_ret(?instrs[8]);
    var blocks: [9]lang_mir.MirBlock;
    var i:      u32 = 0;
    for (i < 9) {
        t_block(?blocks[i], i, ?instrs[i]);
        i = i + 1;
    }
    var f: lang_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 9;
    f.vreg_count  = 1;

    val r: res[structure.Structure, fail.Fail] = analyze(?f, ?alloc);
    if (sel r.err) { ret 1; }
    var st: structure.Structure = r.ok;
    var rc: i32                 = 0;
    if (st.status != structure.CFG_OK)         { rc = 2; }
    if (st.nodes[3].kind != structure.CK_LOOP) { rc = 3; }
    val d: u32 = st.nodes[3].merge;
    if (rc == 0 && st.nodes[d].role != structure.ROLE_DISPATCH)                        { rc = 4; }
    if (rc == 0 && st.nodes[d].kind != structure.CK_SWITCH)                            { rc = 5; }
    if (rc == 0 && st.nodes[d].nsucc != 2)                                             { rc = 6; }
    if (rc == 0 && (structure.succ(?st, d, 0) != 6 || structure.succ(?st, d, 1) != 7)) { rc = 7; }
    val x: u32 = structure.succ(?st, 4, 0);
    if (rc == 0 && st.nodes[x].role != structure.ROLE_EXIT)              { rc = 8; }
    if (rc == 0 && (st.nodes[x].dispatch != d || st.nodes[x].case != 0)) { rc = 9; }
    if (rc == 0 && st.nodes[6].idom != d)                                { rc = 10; }
    val m: u32 = st.nodes[d].merge;
    if (rc == 0 && (st.nodes[m].role != structure.ROLE_FORWARD || structure.succ(?st, m, 0) != 8)) { rc = 11; }
    if (rc == 0 && st.nodes[0].merge != 8)                                                         { rc = 12; }
    structure.dnit(?st);
    ret rc;
}

test push_node__a_refused_growth_is_the_refusal {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 4; }
    fin { T.dnit(?t); }
    T.fail_from_ordinal(?t, 1);
    var st: structure.Structure;
    st.alloc = T.allocator_of(?t);
    val pushed: res[u32, fail.Fail] = push_node(?st, structure.ROLE_SPLIT, structure.NO_BLOCK);
    if (!sel pushed.err)                                           { ret 1; }
    if (!str_contains(fail.describe(pushed.err), "out of memory")) { ret 2; }
    if (st.count != 0)                                             { ret 3; }
    ret 0;
}
