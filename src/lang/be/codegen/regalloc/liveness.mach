# instruction positions, live ranges and their segments: a value's lifetime
# is the runs where it is live, with holes where it is dead, weighted by the
# loop depth of its uses
use mach.lang.fail;
use mach.lang.growth;
use lang_mir: mach.lang.mir;
use mach.lang.mir.flow;
use isa_inst: mach.lang.target.isa.inst;
use A:        std.allocator;
use std.allocator.page;
use T: std.allocator.testing;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use regalloc_context: mach.lang.be.codegen.regalloc.context;

pub fun flatten(ctx: *regalloc_context.Context) err[fail.Fail] {
    val f:     *lang_mir.MirFunction = ctx.f;
    var total: u32                   = 0;
    var bi:    u32                   = 0;
    for (bi < f.block_count) {
        total = total + regalloc_context.block_at(ctx, bi).instr_count;
        bi    = bi + 1;
    }
    ctx.live.flat_count = total;
    if (total == 0) {
        ctx.live.flat = nil;
        ret err[fail.Fail].ok{};
    }

    val rf: res[*regalloc_context.FlatInstr, A.Error] = A.allocate[regalloc_context.FlatInstr](ctx.alloc, total::usize);
    if (sel rf.err) {
        ctx.live.flat       = nil;
        ctx.live.flat_count = 0;
        ret err[fail.Fail].err{fail.refused(rf.err)};
    }
    ctx.live.flat = rf.ok;

    var p: u32 = 0;
    bi = 0;
    for (bi < f.block_count) {
        val blk: *lang_mir.MirBlock = regalloc_context.block_at(ctx, bi);
        var ii:  u32                = 0;
        for (ii < blk.instr_count) {
            ctx.live.flat[p].block   = bi;
            ctx.live.flat[p].instr   = ii;
            ctx.live.flat[p].is_call = blk.instrs[ii].opcode == lang_mir.MIR_CALL
                || blk.instrs[ii].asm_block != nil;
            p  = p + 1;
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

# a use inside a loop is worth eight times one at the depth outside it, so a
# value live across a loop and read inside it outranks the short temporaries
# the loop's guard needs when a register has to be given up
val LOOP_WEIGHT_SHIFT: u32 = 3;
val LOOP_DEPTH_MAX:    u32 = 8;

pub fun use_weight_at(ctx: *regalloc_context.Context, pos: u32) i64 {
    if (ctx.live.block_depth == nil) { ret 1; }
    var depth: u32 = ctx.live.block_depth[ctx.live.flat[pos].block];
    if (depth > LOOP_DEPTH_MAX) { depth = LOOP_DEPTH_MAX; }
    ret (1::i64) << (depth * LOOP_WEIGHT_SHIFT);
}

fun touch(ctx: *regalloc_context.Context, v: lang_mir.VRegId, pos: u32) {
    if (v.n >= ctx.f.vreg_count) {
        regalloc_context.defect_note(ctx, "regalloc: out-of-range vreg id in a MIR operand");
        ret;
    }
    val lr: *regalloc_context.LiveRange = ?ctx.live.ranges[v.n];
    if (pos::i64 < lr.start)   { lr.start = pos::i64; }
    if (pos::i64 > lr.end_pos) { lr.end_pos = pos::i64; }
    lr.use_count  = lr.use_count + 1;
    lr.use_weight = lr.use_weight + use_weight_at(ctx, pos);
}

# a use's weight by its block's span depth over the scan order, which is the
# reverse postorder: an edge from a block at or after its target in the scan
# closes a loop, and every block the scan places from the target through that
# source counts it, so a block laid out between a loop's header and its latch
# weighs as inside the loop whether it lies in the loop or not. this is the
# allocator's own weight, not the loop nesting mir.flow derives
pub fun build_loop_depth(ctx: *regalloc_context.Context) err[fail.Fail] {
    val f: *lang_mir.MirFunction = ctx.f;
    val n: u32                   = f.block_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val r: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, n::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    ctx.live.block_depth = r.ok;

    var i: u32 = 0;
    for (i < n) {
        ctx.live.block_depth[i] = 0;
        i                       = i + 1;
    }
    val g: *flow.Graph = ?ctx.graph;
    var b: u32         = 0;
    for (b < n) {
        var e: u32 = g.pred_start[b];
        for (e < g.pred_start[b + 1]) {
            val p: u32 = g.pred[e];
            if (p >= b) {
                var k: u32 = b;
                for (k <= p) {
                    ctx.live.block_depth[k] = ctx.live.block_depth[k] + 1;
                    k                       = k + 1;
                }
            }
            e = e + 1;
        }
        b = b + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun build_ranges(ctx: *regalloc_context.Context) err[fail.Fail] {
    var pos: u32 = 0;
    for (pos < ctx.live.flat_count) {
        val mi: *lang_mir.MirInstr = regalloc_context.flat_instr(ctx, pos);
        var k:  u32                = 0;
        for (k < mi.operand_count) {
            val op: *lang_mir.MirOperand = ?mi.operands[k];
            if (op.kind == lang_mir.MIR_OP_VREG) {
                touch(ctx, op.vreg, pos);
            }
            or (op.kind == lang_mir.MIR_OP_MEM && !lang_mir.vreg_is_nil(op.vreg)) {
                touch(ctx, op.vreg, pos);
            }
            if (sel op.index.vreg) {
                touch(ctx, op.index.vreg, pos);
            }
            k = k + 1;
        }
        pos = pos + 1;
    }
    ret regalloc_context.defect_check(ctx);
}

pub fun instr_reads_vreg(mi: *lang_mir.MirInstr, v: lang_mir.VRegId) bool {
    val has_def: bool = instr_defines(mi);
    var k:       u32  = 0;
    for (k < mi.operand_count) {
        val op: *lang_mir.MirOperand = ?mi.operands[k];
        if (op.kind == lang_mir.MIR_OP_VREG) {
            val is_dst: bool = has_def && k == 0;
            if (!is_dst && lang_mir.vreg_same(op.vreg, v)) { ret true; }
        }
        if (op.kind == lang_mir.MIR_OP_MEM) {
            if (!lang_mir.vreg_is_nil(op.vreg) && lang_mir.vreg_same(op.vreg, v)) { ret true; }
            if (sel op.index.vreg) {
                if (lang_mir.vreg_same(op.index.vreg, v)) { ret true; }
            }
        }
        k = k + 1;
    }
    ret false;
}

pub fun is_two_address_op(op: lang_mir.MirOpcode) bool {
    ret lang_mir.has(op, lang_mir.MIRF_TWO_ADDRESS);
}

# whether `mi` defines `d` and, sharing d's register with `y`, would read y
# after writing d: a two-address op runs as `d = l; d op= r`, so a right
# operand or an address register is read after the write; a commutative op
# is swapped onto its right operand instead and reads it first
pub fun defines_by_clobbering(mi: *lang_mir.MirInstr, d: u32, y: u32) bool {
    if (!instr_defines(mi) || mi.operands[0].vreg.n != d) { ret false; }
    if (!is_two_address_op(mi.opcode))                    { ret false; }
    var k: u32 = 1;
    for (k < mi.operand_count) {
        val op: *lang_mir.MirOperand = ?mi.operands[k];
        if (op.kind == lang_mir.MIR_OP_VREG && op.vreg.n == y) {
            if (k == 1) { ret false; }
            if (lang_mir.has(mi.opcode, lang_mir.MIRF_COMMUTATIVE)) {
                val l: *lang_mir.MirOperand = ?mi.operands[1];
                if (!(l.kind == lang_mir.MIR_OP_VREG && l.vreg.n == y)) { ret false; }
            }
            ret true;
        }
        if (op.kind == lang_mir.MIR_OP_MEM && !lang_mir.vreg_is_nil(op.vreg) && op.vreg.n == y) { ret true; }
        if (sel op.index.vreg) {
            if (op.index.vreg.n == y) { ret true; }
        }
        k = k + 1;
    }
    ret false;
}

# liveness scratch: per-register use and definition blocks grouped as offset
# ranges, so the propagation touches only the blocks a register reaches
# instead of a block-by-register matrix; predecessors come from the graph
rec LiveScratch {
    alloc:      *A.Allocator;
    nb:         u32;
    nv:         u32;
    use_start:  *u32;
    def_start:  *u32;
    use_mark:   *u32;
    def_mark:   *u32;
    def_of:     *u32;
    visited:    *u32;
    pending:    *u32;
    use_count:  u32;
    def_count:  u32;
    use_blocks: *u32;
    def_blocks: *u32;
    fill:       bool;
    out_mark:   *u32;
    live_in:    PairList;
    live_out:   PairList;
}

# a (block, register) pair the propagation discovers
rec Pair {
    block: u32;
    reg:   u32;
}

# the pairs the propagation discovers, appended as it goes
rec PairList {
    pairs: *Pair;
    count: u32;
    cap:   u32;
}

fun pair_list_init(l: *PairList) {
    l.pairs = nil;
    l.count = 0;
    l.cap   = 0;
}

fun pair_list_dnit(alloc: *A.Allocator, l: *PairList) {
    if (l.pairs != nil && l.cap > 0) { A.deallocate[Pair](alloc, l.pairs, l.cap::usize); }
    pair_list_init(l);
}

fun pair_push(alloc: *A.Allocator, l: *PairList, block: u32, reg: u32) err[fail.Fail] {
    val grown: err[A.Error] = growth.reserve[Pair](alloc, ?l.pairs, ?l.cap, l.count::usize + 1);
    if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    l.pairs[l.count].block = block;
    l.pairs[l.count].reg   = reg;
    l.count                = l.count + 1;
    ret err[fail.Fail].ok{};
}

fun live_scratch_array(l: *LiveScratch, out: **u32, n: u32, value: u32) err[fail.Fail] {
    if (n == 0) {
        @out = nil;
        ret err[fail.Fail].ok{};
    }
    val r: res[*u32, A.Error] = A.allocate[u32](l.alloc, n::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    @out = r.ok;
    var i: u32 = 0;
    for (i < n) {
        r.ok[i] = value;
        i       = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun live_scratch_release(l: *LiveScratch, arr: **u32, n: u32) {
    if (@arr != nil && n > 0) { A.deallocate[u32](l.alloc, @arr, n::usize); }
    @arr = nil;
}

fun live_scratch_dnit(l: *LiveScratch) {
    pair_list_dnit(l.alloc, ?l.live_in);
    pair_list_dnit(l.alloc, ?l.live_out);
    live_scratch_release(l, ?l.out_mark, l.nb);
    live_scratch_release(l, ?l.def_blocks, l.def_count);
    live_scratch_release(l, ?l.use_blocks, l.use_count);
    live_scratch_release(l, ?l.pending, l.nb);
    live_scratch_release(l, ?l.visited, l.nb);
    live_scratch_release(l, ?l.def_of, l.nb);
    live_scratch_release(l, ?l.def_mark, l.nv);
    live_scratch_release(l, ?l.use_mark, l.nv);
    live_scratch_release(l, ?l.def_start, l.nv + 1);
    live_scratch_release(l, ?l.use_start, l.nv + 1);
}

fun live_scratch_init(l: *LiveScratch, alloc: *A.Allocator, nb: u32, nv: u32) err[fail.Fail] {
    l.alloc      = alloc;
    l.nb         = nb;
    l.nv         = nv;
    l.use_start  = nil;
    l.def_start  = nil;
    l.use_mark   = nil;
    l.def_mark   = nil;
    l.def_of     = nil;
    l.visited    = nil;
    l.pending    = nil;
    l.use_count  = 0;
    l.def_count  = 0;
    l.use_blocks = nil;
    l.def_blocks = nil;
    l.fill       = false;
    l.out_mark   = nil;
    pair_list_init(?l.live_in);
    pair_list_init(?l.live_out);
    val r0: err[fail.Fail] = live_scratch_array(l, ?l.use_start, nv + 1, 0);
    if (sel r0.err) { ret r0; }
    val r8: err[fail.Fail] = live_scratch_array(l, ?l.out_mark, nb, regalloc_context.RANGE_NIL);
    if (sel r8.err) {
        live_scratch_dnit(l);
        ret r8;
    }
    val r1: err[fail.Fail] = live_scratch_array(l, ?l.def_start, nv + 1, 0);
    if (sel r1.err) {
        live_scratch_dnit(l);
        ret r1;
    }
    val r3: err[fail.Fail] = live_scratch_array(l, ?l.use_mark, nv, regalloc_context.RANGE_NIL);
    if (sel r3.err) {
        live_scratch_dnit(l);
        ret r3;
    }
    val r4: err[fail.Fail] = live_scratch_array(l, ?l.def_mark, nv, regalloc_context.RANGE_NIL);
    if (sel r4.err) {
        live_scratch_dnit(l);
        ret r4;
    }
    val r5: err[fail.Fail] = live_scratch_array(l, ?l.def_of, nb, regalloc_context.RANGE_NIL);
    if (sel r5.err) {
        live_scratch_dnit(l);
        ret r5;
    }
    val r6: err[fail.Fail] = live_scratch_array(l, ?l.visited, nb, regalloc_context.RANGE_NIL);
    if (sel r6.err) {
        live_scratch_dnit(l);
        ret r6;
    }
    val r7: err[fail.Fail] = live_scratch_array(l, ?l.pending, nb, regalloc_context.RANGE_NIL);
    if (sel r7.err) {
        live_scratch_dnit(l);
        ret r7;
    }
    ret err[fail.Fail].ok{};
}

# a use counts once per block and only before the block's first definition
fun note_use(l: *LiveScratch, reg: u32, block: u32) {
    if (reg >= l.nv || l.def_mark[reg] == block || l.use_mark[reg] == block) { ret; }
    l.use_mark[reg] = block;
    if (l.fill) {
        l.use_blocks[l.use_start[reg]] = block;
        l.use_start[reg]               = l.use_start[reg] + 1;
    }
    or { l.use_start[reg + 1] = l.use_start[reg + 1] + 1; }
}

fun note_def(l: *LiveScratch, reg: u32, block: u32) {
    if (reg >= l.nv || l.def_mark[reg] == block) { ret; }
    l.def_mark[reg] = block;
    if (l.fill) {
        l.def_blocks[l.def_start[reg]] = block;
        l.def_start[reg]               = l.def_start[reg] + 1;
    }
    or { l.def_start[reg + 1] = l.def_start[reg + 1] + 1; }
}

# the same walk counts on the first pass and fills on the second; the start
# arrays hold counts per index + 1 after the first pass, prefix sums after
# exclusive_offsets, and each fill advances its own start, which
# restore_offsets shifts back
fun collect_references(ctx: *regalloc_context.Context, l: *LiveScratch) {
    val f: *lang_mir.MirFunction = ctx.f;
    var i: u32                   = 0;
    for (i < l.nv) {
        l.use_mark[i] = regalloc_context.RANGE_NIL;
        l.def_mark[i] = regalloc_context.RANGE_NIL;
        i             = i + 1;
    }
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *lang_mir.MirBlock = regalloc_context.block_at(ctx, bi);
        var ii:  u32                = 0;
        for (ii < blk.instr_count) {
            val mi:      *lang_mir.MirInstr = ?blk.instrs[ii];
            val has_def: bool               = instr_defines(mi);
            var k:       u32                = 0;
            for (k < mi.operand_count) {
                val op: *lang_mir.MirOperand = ?mi.operands[k];
                if (op.kind == lang_mir.MIR_OP_VREG || op.kind == lang_mir.MIR_OP_MEM) {
                    val is_dst: bool = has_def && k == 0 && op.kind == lang_mir.MIR_OP_VREG;
                    if (!is_dst) { note_use(l, op.vreg.n, bi); }
                }
                if (sel op.index.vreg) { note_use(l, op.index.vreg.n, bi); }
                k = k + 1;
            }
            if (has_def) { note_def(l, mi.operands[0].vreg.n, bi); }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun exclusive_offsets(start: *u32, n: u32) u32 {
    var i: u32 = 0;
    for (i < n) {
        start[i + 1] = start[i + 1] + start[i];
        i            = i + 1;
    }
    ret start[n];
}

fun restore_offsets(start: *u32, n: u32) {
    var i: u32 = n;
    for (i > 0) {
        start[i] = start[i - 1];
        i        = i - 1;
    }
    start[0] = 0;
}

pub fun extend(ctx: *regalloc_context.Context) err[fail.Fail] {
    val nb: u32 = ctx.f.block_count;
    val nv: u32 = ctx.f.vreg_count;
    if (nb == 0 || nv == 0) { ret err[fail.Fail].ok{}; }
    var l:  LiveScratch;
    val li: err[fail.Fail] = live_scratch_init(?l, ctx.alloc, nb, nv);
    if (sel li.err) { ret li; }
    fin { live_scratch_dnit(?l); }

    collect_references(ctx, ?l);
    l.use_count = exclusive_offsets(l.use_start, nv);
    l.def_count = exclusive_offsets(l.def_start, nv);
    val ru: err[fail.Fail] = live_scratch_array(?l, ?l.use_blocks, l.use_count, regalloc_context.RANGE_NIL);
    if (sel ru.err) { ret ru; }
    val rd: err[fail.Fail] = live_scratch_array(?l, ?l.def_blocks, l.def_count, regalloc_context.RANGE_NIL);
    if (sel rd.err) { ret rd; }
    l.fill = true;
    collect_references(ctx, ?l);
    restore_offsets(l.use_start, nv);
    restore_offsets(l.def_start, nv);

    val pl: err[fail.Fail] = propagate_liveness(ctx, ?l);
    if (sel pl.err) {
        reset_ranges(ctx);
        ret pl;
    }
    val bs: err[fail.Fail] = build_segments(ctx, ?l);
    if (sel bs.err) { reset_ranges(ctx); }
    ret bs;
}

# a refused liveness leaves the ranges as it found them
fun reset_ranges(ctx: *regalloc_context.Context) {
    if (ctx.live.segs != nil && ctx.live.seg_count > 0) {
        A.deallocate[regalloc_context.Segment](ctx.alloc, ctx.live.segs, ctx.live.seg_count::usize);
    }
    ctx.live.segs      = nil;
    ctx.live.seg_count = 0;
    var i: u32 = 0;
    for (i < ctx.f.vreg_count) {
        ctx.live.ranges[i].start     = regalloc_context.POS_MAX;
        ctx.live.ranges[i].end_pos   = -1;
        ctx.live.ranges[i].seg_start = 0;
        ctx.live.ranges[i].seg_count = 0;
        ctx.live.ranges[i].live_len  = 0;
        i                            = i + 1;
    }
}

# backward reachability per register: every block with an upward-exposed use
# is live-in, every predecessor of a live-in block is live-out, and a
# predecessor without a definition of the register is live-in in turn
fun propagate_liveness(ctx: *regalloc_context.Context, l: *LiveScratch) err[fail.Fail] {
    var reg: u32 = 0;
    for (reg < l.nv) {
        val lr: *regalloc_context.LiveRange = ?ctx.live.ranges[reg];
        var d:  u32                         = l.def_start[reg];
        for (d < l.def_start[reg + 1]) {
            l.def_of[l.def_blocks[d]] = reg;
            d                         = d + 1;
        }
        var count: u32 = 0;
        var u:     u32 = l.use_start[reg];
        for (u < l.use_start[reg + 1]) {
            val b: u32 = l.use_blocks[u];
            if (l.visited[b] != reg) {
                l.visited[b]     = reg;
                l.pending[count] = b;
                count            = count + 1;
                extend_range_for_block(lr, ctx.live.block_spans[b], true, false);
                val pi: err[fail.Fail] = pair_push(l.alloc, ?l.live_in, b, reg);
                if (sel pi.err) { ret pi; }
            }
            u = u + 1;
        }
        for (count > 0) {
            count = count - 1;
            val b: u32 = l.pending[count];
            var e: u32 = ctx.graph.pred_start[b];
            for (e < ctx.graph.pred_start[b + 1]) {
                val p: u32 = ctx.graph.pred[e];
                extend_range_for_block(lr, ctx.live.block_spans[p], false, true);
                if (l.out_mark[p] != reg) {
                    l.out_mark[p] = reg;
                    val po: err[fail.Fail] = pair_push(l.alloc, ?l.live_out, p, reg);
                    if (sel po.err) { ret po; }
                }
                if (l.def_of[p] != reg && l.visited[p] != reg) {
                    l.visited[p]     = reg;
                    l.pending[count] = p;
                    count            = count + 1;
                    extend_range_for_block(lr, ctx.live.block_spans[p], true, false);
                    val pi: err[fail.Fail] = pair_push(l.alloc, ?l.live_in, p, reg);
                    if (sel pi.err) { ret pi; }
                }
                e = e + 1;
            }
        }
        reg = reg + 1;
    }
    ret err[fail.Fail].ok{};
}

# the segment walk: blocks in reverse layout, instructions backward, so each
# value's segments come out in descending position and are stored from the
# end of its slice; the same walk counts on the first pass and fills on the
# second, and a segment that meets the one after it (a value read and
# redefined by one instruction, or live across adjacent blocks) is merged
rec SegBuild {
    fill:      bool;
    count:     *u32;
    last_from: *i64;
    cursor:    *u32;
    end:       *u32;
    cur_end:   *i64;
}

# segments are emitted from the last position backwards; one that meets the
# segment after it joins it when the value flows across the boundary (a
# block's live-in meeting the previous block's live-out), never when the
# later segment begins at a write that does not read the value, since a
# value read at one instruction and rewritten at the next is dead between
# them and that gap is where the rotation copies of a loop hand a register
# over. a POS_MAX last_from records a segment nothing may join
fun seg_emit(ctx: *regalloc_context.Context, sb: *SegBuild, v: u32, from: i64, to: i64, joins: bool) {
    var next: i64 = regalloc_context.POS_MAX;
    if (joins) { next = from; }
    if (!sb.fill) {
        if (sb.last_from[v] != regalloc_context.POS_MAX && to + 1 >= sb.last_from[v]) {
            sb.last_from[v] = next;
            ret;
        }
        sb.count[v + 1] = sb.count[v + 1] + 1;
        sb.last_from[v] = next;
        ret;
    }
    if (sb.last_from[v] != regalloc_context.POS_MAX && sb.cursor[v] < sb.end[v] && to + 1 >= ctx.live.segs[sb.cursor[v]].from) {
        ctx.live.segs[sb.cursor[v]].from = from;
        sb.last_from[v]                  = next;
        ret;
    }
    sb.cursor[v]                     = sb.cursor[v] - 1;
    ctx.live.segs[sb.cursor[v]].from = from;
    ctx.live.segs[sb.cursor[v]].to   = to;
    sb.last_from[v]                  = next;
}

fun seg_read(ctx: *regalloc_context.Context, sb: *SegBuild, v: u32, pos: i64) {
    if (v >= ctx.f.vreg_count) { ret; }
    if (sb.cur_end[v] < 0)     { sb.cur_end[v] = pos; }
}

fun seg_walk(ctx: *regalloc_context.Context, sb: *SegBuild, in_start: *u32, in_regs: *u32, out_start: *u32, out_regs: *u32) {
    val f:  *lang_mir.MirFunction = ctx.f;
    val nv: u32                   = f.vreg_count;
    var i:  u32                   = 0;
    for (i < nv) {
        sb.cur_end[i] = -1;
        i             = i + 1;
    }
    var bi: u32 = f.block_count;
    for (bi > 0) {
        bi = bi - 1;
        val blk:  *lang_mir.MirBlock         = regalloc_context.block_at(ctx, bi);
        val span: regalloc_context.BlockSpan = ctx.live.block_spans[bi];
        if (blk.instr_count == 0 || span.start < 0) { cnt; }
        var o: u32 = out_start[bi];
        for (o < out_start[bi + 1]) {
            val v: u32 = out_regs[o];
            if (sb.cur_end[v] < 0) { sb.cur_end[v] = span.end; }
            o = o + 1;
        }
        var ii: u32 = blk.instr_count;
        for (ii > 0) {
            ii = ii - 1;
            val pos:     i64                = span.start + ii::i64;
            val mi:      *lang_mir.MirInstr = ?blk.instrs[ii];
            val has_def: bool               = instr_defines(mi);
            if (has_def) {
                val d: u32 = mi.operands[0].vreg.n;
                if (d < nv) {
                    # a definition nothing reads still holds its register
                    # for the instruction that writes it
                    if (sb.cur_end[d] < 0) { sb.cur_end[d] = pos; }
                    seg_emit(ctx, sb, d, pos, sb.cur_end[d], instr_reads_vreg(mi, lang_mir.vreg_id(d)));
                    sb.cur_end[d] = -1;
                }
            }
            var k: u32 = 0;
            for (k < mi.operand_count) {
                val op: *lang_mir.MirOperand = ?mi.operands[k];
                if (op.kind == lang_mir.MIR_OP_VREG) {
                    if (!(has_def && k == 0)) { seg_read(ctx, sb, op.vreg.n, pos); }
                }
                or (op.kind == lang_mir.MIR_OP_MEM && !lang_mir.vreg_is_nil(op.vreg)) {
                    seg_read(ctx, sb, op.vreg.n, pos);
                }
                if (sel op.index.vreg) { seg_read(ctx, sb, op.index.vreg.n, pos); }
                k = k + 1;
            }
        }
        var n: u32 = in_start[bi];
        for (n < in_start[bi + 1]) {
            val v: u32 = in_regs[n];
            if (sb.cur_end[v] >= 0) {
                seg_emit(ctx, sb, v, span.start, sb.cur_end[v], true);
                sb.cur_end[v] = -1;
            }
            n = n + 1;
        }
    }
}

# the pairs bucketed per block, as offsets into one register array
fun bucket_pairs(ctx: *regalloc_context.Context, l: *PairList, nb: u32, start: **u32, regs: **u32) err[fail.Fail] {
    val rs: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, (nb + 1)::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    val st: *u32 = rs.ok;
    @start = st;
    var i: u32 = 0;
    for (i <= nb) {
        st[i] = 0;
        i     = i + 1;
    }
    var p: u32 = 0;
    for (p < l.count) {
        st[l.pairs[p].block + 1] = st[l.pairs[p].block + 1] + 1;
        p                        = p + 1;
    }
    exclusive_offsets(st, nb);
    @regs = nil;
    if (l.count == 0) { ret err[fail.Fail].ok{}; }
    val rr: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, l.count::usize);
    if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
    val rg: *u32 = rr.ok;
    @regs = rg;
    p     = 0;
    for (p < l.count) {
        val b: u32 = l.pairs[p].block;
        rg[st[b]] = l.pairs[p].reg;
        st[b]     = st[b] + 1;
        p         = p + 1;
    }
    restore_offsets(st, nb);
    ret err[fail.Fail].ok{};
}

fun build_segments(ctx: *regalloc_context.Context, l: *LiveScratch) err[fail.Fail] {
    val nb: u32 = ctx.f.block_count;
    val nv: u32 = ctx.f.vreg_count;

    var in_start:  *u32 = nil;
    var in_regs:   *u32 = nil;
    var out_start: *u32 = nil;
    var out_regs:  *u32 = nil;
    fin {
        if (in_start != nil)  { A.deallocate[u32](ctx.alloc, in_start, (nb + 1)::usize); }
        if (in_regs != nil)   { A.deallocate[u32](ctx.alloc, in_regs, l.live_in.count::usize); }
        if (out_start != nil) { A.deallocate[u32](ctx.alloc, out_start, (nb + 1)::usize); }
        if (out_regs != nil)  { A.deallocate[u32](ctx.alloc, out_regs, l.live_out.count::usize); }
    }
    val bi: err[fail.Fail] = bucket_pairs(ctx, ?l.live_in, nb, ?in_start, ?in_regs);
    if (sel bi.err) { ret bi; }
    val bo: err[fail.Fail] = bucket_pairs(ctx, ?l.live_out, nb, ?out_start, ?out_regs);
    if (sel bo.err) { ret bo; }

    var sb: SegBuild;
    sb.fill      = false;
    sb.count     = nil;
    sb.last_from = nil;
    sb.cursor    = nil;
    sb.end       = nil;
    sb.cur_end   = nil;
    fin {
        if (sb.count != nil)     { A.deallocate[u32](ctx.alloc, sb.count, (nv + 1)::usize); }
        if (sb.last_from != nil) { A.deallocate[i64](ctx.alloc, sb.last_from, nv::usize); }
        if (sb.cursor != nil)    { A.deallocate[u32](ctx.alloc, sb.cursor, nv::usize); }
        if (sb.end != nil)       { A.deallocate[u32](ctx.alloc, sb.end, nv::usize); }
        if (sb.cur_end != nil)   { A.deallocate[i64](ctx.alloc, sb.cur_end, nv::usize); }
    }
    val rc: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, (nv + 1)::usize);
    if (sel rc.err) { ret err[fail.Fail].err{fail.refused(rc.err)}; }
    sb.count = rc.ok;
    val rl: res[*i64, A.Error] = A.allocate[i64](ctx.alloc, nv::usize);
    if (sel rl.err) { ret err[fail.Fail].err{fail.refused(rl.err)}; }
    sb.last_from = rl.ok;
    val ru: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, nv::usize);
    if (sel ru.err) { ret err[fail.Fail].err{fail.refused(ru.err)}; }
    sb.cursor = ru.ok;
    val re: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, nv::usize);
    if (sel re.err) { ret err[fail.Fail].err{fail.refused(re.err)}; }
    sb.end = re.ok;
    val rce: res[*i64, A.Error] = A.allocate[i64](ctx.alloc, nv::usize);
    if (sel rce.err) { ret err[fail.Fail].err{fail.refused(rce.err)}; }
    sb.cur_end = rce.ok;

    var i: u32 = 0;
    for (i <= nv) {
        sb.count[i] = 0;
        i           = i + 1;
    }
    i = 0;
    for (i < nv) {
        sb.last_from[i] = regalloc_context.POS_MAX;
        i               = i + 1;
    }
    seg_walk(ctx, ?sb, in_start, in_regs, out_start, out_regs);
    val total: u32 = exclusive_offsets(sb.count, nv);
    if (total == 0) { ret err[fail.Fail].ok{}; }
    val rs: res[*regalloc_context.Segment, A.Error] = A.allocate[regalloc_context.Segment](ctx.alloc, total::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    ctx.live.segs      = rs.ok;
    ctx.live.seg_count = total;
    i                  = 0;
    for (i < nv) {
        sb.cursor[i]    = sb.count[i + 1];
        sb.end[i]       = sb.count[i + 1];
        sb.last_from[i] = regalloc_context.POS_MAX;
        i               = i + 1;
    }
    sb.fill = true;
    seg_walk(ctx, ?sb, in_start, in_regs, out_start, out_regs);

    i = 0;
    for (i < nv) {
        val lr: *regalloc_context.LiveRange = ?ctx.live.ranges[i];
        if (sb.cursor[i] != sb.count[i]) {
            ret err[fail.Fail].err{fail.message("regalloc: the segment fill did not match its count (internal compiler error)")};
        }
        lr.seg_start = sb.count[i];
        lr.seg_count = sb.count[i + 1] - sb.count[i];
        lr.live_len  = 0;
        var k: u32 = 0;
        for (k < lr.seg_count) {
            val sg: *regalloc_context.Segment = ?ctx.live.segs[lr.seg_start + k];
            lr.live_len = lr.live_len + (sg.to - sg.from + 1);
            k           = k + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun covers(ctx: *regalloc_context.Context, lr: *regalloc_context.LiveRange, pos: i64) bool {
    var k: u32 = 0;
    for (k < lr.seg_count) {
        val sg: *regalloc_context.Segment = ?ctx.live.segs[lr.seg_start + k];
        if (sg.from <= pos && pos <= sg.to) { ret true; }
        k = k + 1;
    }
    ret false;
}

# the value v holds is not needed after pos: a segment ends there
pub fun dies_at(ctx: *regalloc_context.Context, v: u32, pos: i64) bool {
    if (v >= ctx.f.vreg_count) { ret false; }
    val lr: *regalloc_context.LiveRange = ?ctx.live.ranges[v];
    var k:  u32                         = 0;
    for (k < lr.seg_count) {
        if (ctx.live.segs[lr.seg_start + k].to == pos) { ret true; }
        k = k + 1;
    }
    ret false;
}

pub fun seg_from_ending_at(ctx: *regalloc_context.Context, v: u32, pos: i64) i64 {
    val lr: *regalloc_context.LiveRange = ?ctx.live.ranges[v];
    var k:  u32                         = 0;
    for (k < lr.seg_count) {
        if (ctx.live.segs[lr.seg_start + k].to == pos) { ret ctx.live.segs[lr.seg_start + k].from; }
        k = k + 1;
    }
    ret -1;
}

# a segment of `ending` may meet a segment of `starting` at pos and share its
# register when the instruction there defines `starting` and reads `ending`
# before it writes
fun handoff_ok(ctx: *regalloc_context.Context, ending: u32, starting: u32, pos: i64) bool {
    if (pos < 0 || pos::u32 >= ctx.live.flat_count) { ret false; }
    val mi: *lang_mir.MirInstr = regalloc_context.flat_instr(ctx, pos::u32);
    if (!instr_defines(mi))                          { ret false; }
    if (mi.operands[0].vreg.n != starting)           { ret false; }
    if (defines_by_clobbering(mi, starting, ending)) { ret false; }
    ret true;
}

pub fun intersects(ctx: *regalloc_context.Context, a: *regalloc_context.LiveRange, b: *regalloc_context.LiveRange) bool {
    var i: u32 = 0;
    var j: u32 = 0;
    for (i < a.seg_count && j < b.seg_count) {
        val sa: *regalloc_context.Segment = ?ctx.live.segs[a.seg_start + i];
        val sb: *regalloc_context.Segment = ?ctx.live.segs[b.seg_start + j];
        if (sa.to < sb.from) {
            i = i + 1;
            cnt;
        }
        if (sb.to < sa.from) {
            j = j + 1;
            cnt;
        }
        if (sa.to == sb.from && sa.from < sa.to) {
            if (!handoff_ok(ctx, a.vreg, b.vreg, sa.to)) { ret true; }
            i = i + 1;
            cnt;
        }
        if (sb.to == sa.from && sb.from < sb.to) {
            if (!handoff_ok(ctx, b.vreg, a.vreg, sb.to)) { ret true; }
            j = j + 1;
            cnt;
        }
        ret true;
    }
    ret false;
}

fun extend_range_for_block(lr: *regalloc_context.LiveRange, span: regalloc_context.BlockSpan, live_in: bool, live_out: bool) {
    if (live_in && span.start >= 0 && span.start < lr.start) { lr.start = span.start; }
    if (live_out && span.end > lr.end_pos)                   { lr.end_pos = span.end; }
}

pub fun build_block_spans(ctx: *regalloc_context.Context) err[fail.Fail] {
    val f: *lang_mir.MirFunction = ctx.f;
    val n: u32                   = f.block_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val r: res[*regalloc_context.BlockSpan, A.Error] = A.allocate[regalloc_context.BlockSpan](ctx.alloc, n::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    ctx.live.block_spans = r.ok;

    var i: u32 = 0;
    for (i < n) {
        ctx.live.block_spans[i].start = -1;
        ctx.live.block_spans[i].end   = -1;
        i                             = i + 1;
    }
    var pos: u32 = 0;
    for (pos < ctx.live.flat_count) {
        val b: u32 = ctx.live.flat[pos].block;
        if (ctx.live.block_spans[b].start < 0) { ctx.live.block_spans[b].start = pos::i64; }
        ctx.live.block_spans[b].end = pos::i64;
        pos                         = pos + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun instr_defines(mi: *lang_mir.MirInstr) bool {
    if (!lang_mir.instr_defines_shape(mi)) { ret false; }
    ret mi.operands[0].kind == lang_mir.MIR_OP_VREG;
}

pub fun mark_call_crossing(ctx: *regalloc_context.Context) err[fail.Fail] {
    val n: u32 = ctx.live.flat_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val r: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, (n + 1)::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val prefix: *u32 = r.ok;
    prefix[0] = 0;
    var p: u32 = 0;
    for (p < n) {
        var inc: u32 = 0;
        if (ctx.live.flat[p].is_call) { inc = 1; }
        prefix[p + 1] = prefix[p] + inc;
        p             = p + 1;
    }

    var v: u32 = 0;
    for (v < ctx.f.vreg_count) {
        val lr: *regalloc_context.LiveRange = ?ctx.live.ranges[v];
        var k:  u32                         = 0;
        for (k < lr.seg_count) {
            val sg: *regalloc_context.Segment = ?ctx.live.segs[lr.seg_start + k];
            if (prefix[(sg.to + 1)::u32] - prefix[sg.from::u32] > 0)                    { lr.crosses_call = true; }
            if (sg.to > sg.from && prefix[sg.to::u32] - prefix[(sg.from + 1)::u32] > 0) { lr.call_inside = true; }
            k = k + 1;
        }
        v = v + 1;
    }

    A.deallocate[u32](ctx.alloc, prefix, (n + 1)::usize);
    ret err[fail.Fail].ok{};
}

pub fun seg_interior(ctx: *regalloc_context.Context, lr: *regalloc_context.LiveRange, pos: i64) bool {
    var k: u32 = 0;
    for (k < lr.seg_count) {
        val sg: *regalloc_context.Segment = ?ctx.live.segs[lr.seg_start + k];
        if (sg.from < pos && pos < sg.to) { ret true; }
        k = k + 1;
    }
    ret false;
}

# a lane write runs as `d = vec; d.lane = scalar` on aarch64, so the scalar
# is read after the write and may not share d's register; the vector may
test defines_by_clobbering__a_lane_write_clobbers_its_scalar_only {
    var ops: [4]lang_mir.MirOperand;
    ops[0] = lang_mir.op_vreg(lang_mir.vreg_id(3));
    ops[1] = lang_mir.op_vreg(lang_mir.vreg_id(1));
    ops[2] = lang_mir.op_imm(0);
    ops[3] = lang_mir.op_vreg(lang_mir.vreg_id(2));
    var mi: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_VEC_INSERT, ?ops[0], 4, 16, 4);
    mi.vec_lane = lang_mir.vec_lane_make(lang_mir.VEC_LANE_FLOAT, 4, 4);
    if (!defines_by_clobbering(?mi, 3, 2)) { ret 1; }
    if (defines_by_clobbering(?mi, 3, 1))  { ret 2; }
    ret 0;
}

# the dense block-by-register equations, kept only as the oracle the sparse
# propagation is checked against on small graphs
# cov, when given, receives one bool per (position, register): the value is
# read or written there, or is live across it
#[testing]
fun t_dense_liveness(ctx: *regalloc_context.Context, cov: *bool) err[fail.Fail] {
    val f:  *lang_mir.MirFunction = ctx.f;
    val nb: u32                   = f.block_count;
    val nv: u32                   = f.vreg_count;
    if (nb == 0 || nv == 0) { ret err[fail.Fail].ok{}; }
    val total: usize               = (nb::usize) * (nv::usize) * 4;
    val cells: res[*bool, A.Error] = A.allocate[bool](ctx.alloc, total);
    if (sel cells.err) { ret err[fail.Fail].err{fail.refused(cells.err)}; }
    fin { A.deallocate[bool](ctx.alloc, cells.ok, total); }
    val stride:   usize = (nb::usize) * (nv::usize);
    val uses:     *bool = cells.ok;
    val defs:     *bool = ?cells.ok[stride];
    val live_in:  *bool = ?cells.ok[stride * 2];
    val live_out: *bool = ?cells.ok[stride * 3];
    var z:        usize = 0;
    for (z < total) {
        cells.ok[z] = false;
        z           = z + 1;
    }

    var bi: u32 = 0;
    for (bi < nb) {
        val blk:  *lang_mir.MirBlock = regalloc_context.block_at(ctx, bi);
        val base: usize              = (bi::usize) * (nv::usize);
        var ii:   u32                = 0;
        for (ii < blk.instr_count) {
            val mi:      *lang_mir.MirInstr = ?blk.instrs[ii];
            val has_def: bool               = instr_defines(mi);
            var k:       u32                = 0;
            for (k < mi.operand_count) {
                val op: *lang_mir.MirOperand = ?mi.operands[k];
                var v:  u32                  = lang_mir.MIR_VREG_NIL.n;
                if (op.kind == lang_mir.MIR_OP_VREG || op.kind == lang_mir.MIR_OP_MEM) { v = op.vreg.n; }
                if (v < nv && !(has_def && k == 0 && op.kind == lang_mir.MIR_OP_VREG) && !defs[base + v::usize]) {
                    uses[base + v::usize] = true;
                }
                if (sel op.index.vreg) {
                    if (op.index.vreg.n < nv && !defs[base + op.index.vreg.n::usize]) { uses[base + op.index.vreg.n::usize] = true; }
                }
                k = k + 1;
            }
            if (has_def && mi.operands[0].vreg.n < nv) { defs[base + mi.operands[0].vreg.n::usize] = true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    var changed: bool = true;
    for (changed) {
        changed = false;
        var ri: i64 = nb::i64 - 1;
        for (ri >= 0) {
            val b:    u32   = ri::u32;
            val base: usize = (b::usize) * (nv::usize);
            var v:    u32   = 0;
            for (v < nv) {
                live_out[base + v::usize] = false;
                v                         = v + 1;
            }
            val blk: *lang_mir.MirBlock = regalloc_context.block_at(ctx, b);
            if (blk.instr_count > 0) {
                val term: *lang_mir.MirInstr = ?blk.instrs[blk.instr_count - 1];
                var k:    u32                = 0;
                for (k < term.operand_count) {
                    if (term.operands[k].kind == lang_mir.MIR_OP_BLOCK) {
                        val si: u32 = flow.position_of(?ctx.graph.index, term.operands[k].imm);
                        if (si != regalloc_context.RANGE_NIL) { regalloc_context.t_or_row(live_out, base, live_in, (si::usize) * (nv::usize), nv); }
                    }
                    k = k + 1;
                }
            }
            v = 0;
            for (v < nv) {
                val idx: usize = base + v::usize;
                if ((uses[idx] || (live_out[idx] && !defs[idx])) && !live_in[idx]) {
                    live_in[idx] = true;
                    changed      = true;
                }
                v = v + 1;
            }
            ri = ri - 1;
        }
    }

    bi = 0;
    for (bi < nb) {
        val base: usize = (bi::usize) * (nv::usize);
        var v:    u32   = 0;
        for (v < nv) {
            extend_range_for_block(?ctx.live.ranges[v], ctx.live.block_spans[bi], live_in[base + v::usize], live_out[base + v::usize]);
            v = v + 1;
        }
        bi = bi + 1;
    }
    if (cov == nil) { ret err[fail.Fail].ok{}; }

    val rl: res[*bool, A.Error] = A.allocate[bool](ctx.alloc, nv::usize);
    if (sel rl.err) { ret err[fail.Fail].err{fail.refused(rl.err)}; }
    val live: *bool = rl.ok;
    fin { A.deallocate[bool](ctx.alloc, live, nv::usize); }
    bi = 0;
    for (bi < nb) {
        val blk:  *lang_mir.MirBlock = regalloc_context.block_at(ctx, bi);
        val base: usize              = (bi::usize) * (nv::usize);
        var v:    u32                = 0;
        for (v < nv) {
            live[v] = live_out[base + v::usize];
            v       = v + 1;
        }
        var ii: u32 = blk.instr_count;
        for (ii > 0) {
            ii = ii - 1;
            val pos:     usize              = (ctx.live.block_spans[bi].start + ii::i64)::usize;
            val mi:      *lang_mir.MirInstr = ?blk.instrs[ii];
            val has_def: bool               = instr_defines(mi);
            var d:       u32                = lang_mir.MIR_VREG_NIL.n;
            if (has_def) { d = mi.operands[0].vreg.n; }
            v = 0;
            for (v < nv) {
                cov[pos * (nv::usize) + v::usize] = live[v] || v == d;
                v                                 = v + 1;
            }
            if (d < nv) { live[d] = false; }
            var k: u32 = 0;
            for (k < mi.operand_count) {
                val op: *lang_mir.MirOperand = ?mi.operands[k];
                var u:  u32                  = lang_mir.MIR_VREG_NIL.n;
                if ((op.kind == lang_mir.MIR_OP_VREG && !(has_def && k == 0)) || op.kind == lang_mir.MIR_OP_MEM) { u = op.vreg.n; }
                if (u < nv) {
                    live[u]                           = true;
                    cov[pos * (nv::usize) + u::usize] = true;
                }
                if (sel op.index.vreg) {
                    if (op.index.vreg.n < nv) {
                        live[op.index.vreg.n]                           = true;
                        cov[pos * (nv::usize) + op.index.vreg.n::usize] = true;
                    }
                }
                k = k + 1;
            }
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

# eight blocks of four instructions whose uses, definitions, memory operands,
# self loops and an empty block vary with the sample bits
#[testing]
fun t_sparse_liveness_case(sample: u32, ordinal: usize, attempts: *usize) i32 {
    var track: T.Testing;
    val made:  err[A.Error] = T.make(?track);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?track); }
    var alloc: A.Allocator;
    val paged: err[A.Error] = page.make(?alloc);
    if (sel paged.err) { ret 2; }
    var blocks:   [8]lang_mir.MirBlock;
    var instrs:   [8][4]lang_mir.MirInstr;
    var operands: [8][4][3]lang_mir.MirOperand;
    var spans:    [8]regalloc_context.BlockSpan;
    var sparse:   [8]regalloc_context.LiveRange;
    var dense:    [8]regalloc_context.LiveRange;
    var bi:       u32 = 0;
    for (bi < 8) {
        blocks[bi].id          = 40 - bi * 3;
        blocks[bi].instrs      = ?instrs[bi][0];
        blocks[bi].instr_count = 4;
        var definition: u32 = 0;
        var use_index:  u32 = 1;
        if ((sample & 2) != 0) {
            definition = 1;
            use_index  = 0;
        }
        operands[bi][definition][0] = lang_mir.op_vreg(lang_mir.vreg_id(bi));
        operands[bi][definition][1] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
        instrs[bi][definition]      = lang_mir.instr(lang_mir.MIR_MOV, ?operands[bi][definition][0], 2, 8, 8);
        operands[bi][use_index][0]  = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
        operands[bi][use_index][1]  = lang_mir.op_vreg(lang_mir.vreg_id((bi + sample) % 8));
        instrs[bi][use_index]       = lang_mir.instr(lang_mir.MIR_MOV, ?operands[bi][use_index][0], 2, 8, 8);
        var destination: u32 = (bi + 1) % 8;
        if ((sample & 4) != 0) { destination = bi; }
        if ((sample & 3) == 3) { destination = (bi + 2) % 8; }
        operands[bi][2][0] = lang_mir.op_vreg(lang_mir.vreg_id(destination));
        operands[bi][2][1] = lang_mir.op_mem_value(lang_mir.vreg_id((bi + 2) % 8), 0);
        if ((sample & 1) != 0) { operands[bi][2][1].index = lang_mir.index_preg(lang_mir.preg_id(((bi + 3) % 8)::i32)); }
        or                     { operands[bi][2][1].index = lang_mir.index_vreg(lang_mir.vreg_id((bi + 3) % 8)); }
        instrs[bi][2]      = lang_mir.instr(lang_mir.MIR_LOAD, ?operands[bi][2][0], 2, 8, 8);
        operands[bi][3][0] = lang_mir.op_vreg(lang_mir.vreg_id((bi + 4) % 8));
        operands[bi][3][1] = lang_mir.op_block(40 - ((bi + 1) % 8) * 3);
        operands[bi][3][2] = lang_mir.op_block(40 - ((bi + sample + 6) % 8) * 3);
        instrs[bi][3]      = lang_mir.instr(lang_mir.MIR_CBR, ?operands[bi][3][0], 3, 8, 8);
        spans[bi].start    = (bi * 4)::i64;
        spans[bi].end      = (bi * 4 + 3)::i64;
        if (bi == 5 && (sample & 8) != 0) {
            blocks[bi].instr_count = 0;
            spans[bi].start        = -1;
            spans[bi].end          = -1;
        }
        sparse[bi].vreg    = bi;
        sparse[bi].start   = regalloc_context.POS_MAX;
        sparse[bi].end_pos = -1;
        dense[bi]          = sparse[bi];
        bi                 = bi + 1;
    }
    var f: lang_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 8;
    f.vreg_count  = 8;
    val rg: res[flow.Graph, fail.Fail] = flow.init(?alloc, ?f);
    if (sel rg.err) { ret 2; }
    var order: [8]u32;
    regalloc_context.order_identity(?order[0], 8);
    var ctx: regalloc_context.Context;
    ctx.graph       = rg.ok;
    ctx.graph_built = true;
    fin { flow.dnit(?ctx.graph); }
    ctx.alloc            = T.allocator_of(?track);
    ctx.f                = ?f;
    ctx.order            = ?order[0];
    ctx.live.block_spans = ?spans[0];
    ctx.live.ranges      = ?sparse[0];
    T.fail_at_ordinal(?track, ordinal);
    val result: err[fail.Fail] = extend(?ctx);
    @attempts = T.attempt_count(?track);
    var segs:      [64]regalloc_context.Segment;
    var seg_count: u32 = 0;
    if (ctx.live.segs != nil && ctx.live.seg_count > 0) {
        seg_count = ctx.live.seg_count;
        if (seg_count > 64) { ret 3; }
        var si: u32 = 0;
        for (si < seg_count) {
            segs[si] = ctx.live.segs[si];
            si       = si + 1;
        }
        A.deallocate[regalloc_context.Segment](ctx.alloc, ctx.live.segs, ctx.live.seg_count::usize);
        ctx.live.segs = ?segs[0];
    }
    if (T.leaked(?track) || T.double_free_count(?track) != 0 || T.tracking_exhausted(?track)) { ret 3; }
    if (ordinal != 0) {
        if (sel result.ok) { ret 4; }
        bi = 0;
        for (bi < 8) {
            if (sparse[bi].start != regalloc_context.POS_MAX || sparse[bi].end_pos != -1 || sparse[bi].seg_count != 0) { ret 5; }
            bi = bi + 1;
        }
        if (seg_count != 0) { ret 5; }
        ret 0;
    }
    if (sel result.err) { ret 6; }
    ctx.alloc       = ?alloc;
    ctx.live.ranges = ?dense[0];
    var cov: [256]bool;
    var ci:  u32 = 0;
    for (ci < 256) {
        cov[ci] = false;
        ci      = ci + 1;
    }
    val oracle: err[fail.Fail] = t_dense_liveness(?ctx, ?cov[0]);
    if (sel oracle.err) { ret 7; }
    bi = 0;
    for (bi < 8) {
        if (sparse[bi].start != dense[bi].start || sparse[bi].end_pos != dense[bi].end_pos) { ret 8; }
        # the segments are the exact positions the value is read, written
        # or live across, in order and never overlapping
        val lr:  *regalloc_context.LiveRange = ?sparse[bi];
        var pos: u32                         = 0;
        for (pos < 32) {
            var in_seg: bool = false;
            var k:      u32  = 0;
            for (k < lr.seg_count) {
                val sg: *regalloc_context.Segment = ?segs[lr.seg_start + k];
                if (sg.from <= pos::i64 && pos::i64 <= sg.to)          { in_seg = true; }
                if (k > 0 && sg.from <= segs[lr.seg_start + k - 1].to) { ret 9; }
                k = k + 1;
            }
            if (in_seg != cov[pos * 8 + bi]) { ret 10; }
            pos = pos + 1;
        }
        bi = bi + 1;
    }
    ret 0;
}

# the sparse propagation matches the dense oracle over loops, definitions and
# memory uses, and a refused allocation at any point leaves the ranges
# untouched and releases its scratch
test extend__sparse_matches_the_dense_oracle {
    var sample: u32 = 0;
    for (sample < 16) {
        var attempts: usize = 0;
        val result:   i32   = t_sparse_liveness_case(sample, 0, ?attempts);
        if (result != 0) { ret result; }
        sample = sample + 1;
    }
    var attempts: usize = 0;
    val baseline: i32   = t_sparse_liveness_case(9, 0, ?attempts);
    if (baseline != 0 || attempts == 0) { ret 20; }
    var ordinal: usize = 1;
    for (ordinal <= attempts) {
        var refused_attempts: usize = 0;
        val result:           i32   = t_sparse_liveness_case(9, ordinal, ?refused_attempts);
        if (result != 0) { ret 20 + result; }
        ordinal = ordinal + 1;
    }
    ret 0;
}
