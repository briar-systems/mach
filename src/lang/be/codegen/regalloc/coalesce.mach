# copy elimination before the scan and the hints the scan follows: dead
# moves are swept, single-assignment copy webs and dying copies are merged,
# and copies, ties and sinks become register preferences
use mach.lang.fail;
use lang_mir:    mach.lang.mir;
use lang_target: mach.lang.target;
use mach.lang.target.abi;
use mach.lang.target.binding;
use mach.lang.target.isa;
use isa_inst:  mach.lang.target.isa.inst;
use isa_riscv: mach.lang.target.isa.riscv;
use A:         std.allocator;
use std.allocator.page;
use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use regalloc_context: mach.lang.be.codegen.regalloc.context;
use mach.lang.be.codegen.regalloc.liveness;
use regalloc_order: mach.lang.be.codegen.regalloc.order;

fun isa_is_reg_move(tgt: *lang_target.Binding, opcode: u32) bool {
    ret tgt.arch.is_reg_move(opcode);
}

pub fun instr_is_reg_copy(tgt: *lang_target.Binding, mi: *lang_mir.MirInstr) bool {
    if (mi.operand_count != 2)            { ret false; }
    if (mi.asm_block != nil)              { ret false; }
    if (mi.width != mi.src_width)         { ret false; }
    if (!isa_is_reg_move(tgt, mi.opcode)) { ret false; }
    val d: *lang_mir.MirOperand = ?mi.operands[0];
    val s: *lang_mir.MirOperand = ?mi.operands[1];
    if (d.kind != lang_mir.MIR_OP_VREG && d.kind != lang_mir.MIR_OP_PREG)                                  { ret false; }
    if (s.kind != lang_mir.MIR_OP_VREG && s.kind != lang_mir.MIR_OP_PREG && s.kind != lang_mir.MIR_OP_IMM) { ret false; }
    ret true;
}

fun tally_reads(ctx: *regalloc_context.Context, reads: *u32, nv: u32) {
    val f:  *lang_mir.MirFunction = ctx.f;
    var bi: u32                   = 0;
    for (bi < f.block_count) {
        val blk: *lang_mir.MirBlock = regalloc_context.block_at(ctx, bi);
        var ii:  u32                = 0;
        for (ii < blk.instr_count) {
            val mi:      *lang_mir.MirInstr = ?blk.instrs[ii];
            val has_def: bool               = liveness.instr_defines(mi);
            var k:       u32                = 0;
            for (k < mi.operand_count) {
                val op: *lang_mir.MirOperand = ?mi.operands[k];
                if (op.kind == lang_mir.MIR_OP_VREG) {
                    val is_dst: bool = has_def && k == 0;
                    if (!is_dst && op.vreg.n < nv) { reads[op.vreg.n] = reads[op.vreg.n] + 1; }
                }
                or (op.kind == lang_mir.MIR_OP_MEM && !lang_mir.vreg_is_nil(op.vreg) && op.vreg.n < nv) {
                    reads[op.vreg.n] = reads[op.vreg.n] + 1;
                }
                if (sel op.index.vreg) {
                    if (op.index.vreg.n < nv) { reads[op.index.vreg.n] = reads[op.index.vreg.n] + 1; }
                }
                k = k + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun is_dead_mov(tgt: *lang_target.Binding, ctx: *regalloc_context.Context, mi: *lang_mir.MirInstr, reads: *u32, nv: u32) bool {
    if (!instr_is_reg_copy(tgt, mi)) { ret false; }
    val d: *lang_mir.MirOperand = ?mi.operands[0];
    if (d.kind != lang_mir.MIR_OP_VREG)              { ret false; }
    if (d.vreg.n >= nv)                              { ret false; }
    if (regalloc_context.vreg_has_slot(ctx, d.vreg)) { ret false; }
    ret reads[d.vreg.n] == 0;
}

# a deleted instruction emits nothing, so the instruction after it is the same
# program point and takes its bindings; a block ends in a terminator, which is
# never a copy, so there always is one
fun pass_dbg_on(ctx: *regalloc_context.Context, blk: *lang_mir.MirBlock, at: u32) err[fail.Fail] {
    val mi: *lang_mir.MirInstr = ?blk.instrs[at];
    if (mi.dbg_binding_count == 0) { ret err[fail.Fail].ok{}; }
    if (at + 1 >= blk.instr_count) {
        ret err[fail.Fail].err{fail.message("regalloc: a deleted copy ends its block and has no instruction to pass its debug bindings to (internal compiler error)")};
    }
    ret lang_mir.instr_pass_dbg(ctx.alloc, mi, ?blk.instrs[at + 1]);
}

pub fun sweep_dead_movs(tgt: *lang_target.Binding, ctx: *regalloc_context.Context) err[fail.Fail] {
    val f:  *lang_mir.MirFunction = ctx.f;
    val nv: u32                   = f.vreg_count;
    if (nv == 0)                     { ret err[fail.Fail].ok{}; }
    if (tgt.arch.is_reg_move == nil) { ret err[fail.Fail].ok{}; }

    val rr: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, nv::usize);
    if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
    val reads: *u32 = rr.ok;

    var changed: bool = true;
    for (changed) {
        changed = false;
        var i: u32 = 0;
        for (i < nv) {
            reads[i] = 0;
            i        = i + 1;
        }
        tally_reads(ctx, reads, nv);

        var bi: u32 = 0;
        for (bi < f.block_count) {
            val blk:   *lang_mir.MirBlock = regalloc_context.block_at(ctx, bi);
            var write: u32                = 0;
            var read:  u32                = 0;
            for (read < blk.instr_count) {
                val mi: *lang_mir.MirInstr = ?blk.instrs[read];
                if (is_dead_mov(tgt, ctx, mi, reads, nv)) {
                    if (mi.operands != nil && mi.operand_count > 0) {
                        A.deallocate[lang_mir.MirOperand](ctx.alloc, mi.operands, mi.operand_count::usize);
                    }
                    val rd: err[fail.Fail] = pass_dbg_on(ctx, blk, read);
                    if (sel rd.err) {
                        A.deallocate[u32](ctx.alloc, reads, nv::usize);
                        ret rd;
                    }
                    changed = true;
                }
                or {
                    if (write != read) { blk.instrs[write] = blk.instrs[read]; }
                    write = write + 1;
                }
                read = read + 1;
            }
            blk.instr_count = write;
            bi              = bi + 1;
        }
    }

    A.deallocate[u32](ctx.alloc, reads, nv::usize);
    ret err[fail.Fail].ok{};
}

fun web_find(parent: *u32, v: u32) u32 {
    var r: u32 = v;
    for (parent[r] != r) { r = parent[r]; }
    var c: u32 = v;
    for (parent[c] != r) {
        val n: u32 = parent[c];
        parent[c] = r;
        c         = n;
    }
    ret r;
}

fun tally_defs(ctx: *regalloc_context.Context, defs: *u32, nv: u32) {
    val f:  *lang_mir.MirFunction = ctx.f;
    var bi: u32                   = 0;
    for (bi < f.block_count) {
        val blk: *lang_mir.MirBlock = regalloc_context.block_at(ctx, bi);
        var ii:  u32                = 0;
        for (ii < blk.instr_count) {
            val mi: *lang_mir.MirInstr = ?blk.instrs[ii];
            if (liveness.instr_defines(mi)) {
                val d: *lang_mir.MirOperand = ?mi.operands[0];
                if (d.vreg.n < nv) { defs[d.vreg.n] = defs[d.vreg.n] + 1; }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun try_coalesce(tgt: *lang_target.Binding, ctx: *regalloc_context.Context, mi: *lang_mir.MirInstr,
    parent: *u32, web_defs: *u32, nv: u32) bool {
    if (!instr_is_reg_copy(tgt, mi)) { ret false; }
    if (mi.width < ctx.spill_width)  { ret false; }
    val dop: *lang_mir.MirOperand = ?mi.operands[0];
    val sop: *lang_mir.MirOperand = ?mi.operands[1];
    if (dop.kind != lang_mir.MIR_OP_VREG || sop.kind != lang_mir.MIR_OP_VREG) { ret false; }
    val d: u32 = dop.vreg.n;
    val s: u32 = sop.vreg.n;
    if (d >= nv || s >= nv || d == s)                                                                   { ret false; }
    if (regalloc_context.vreg_has_slot(ctx, dop.vreg) || regalloc_context.vreg_has_slot(ctx, sop.vreg)) { ret false; }

    val dv: *lang_mir.MirVReg = ?ctx.f.vregs[d];
    val sv: *lang_mir.MirVReg = ?ctx.f.vregs[s];
    if (dv.class != sv.class)         { ret false; }
    if (dv.secret != sv.secret)       { ret false; }
    if (dv.vec_bytes != sv.vec_bytes) { ret false; }

    val rd: u32 = web_find(parent, d);
    val rs: u32 = web_find(parent, s);
    if (rd == rs)          { ret false; }
    if (web_defs[rd] != 1) { ret false; }
    if (web_defs[rs] != 1) { ret false; }

    parent[rd] = rs;
    ret true;
}

fun rename_vregs(ctx: *regalloc_context.Context, parent: *u32, nv: u32) {
    val f:  *lang_mir.MirFunction = ctx.f;
    var bi: u32                   = 0;
    for (bi < f.block_count) {
        val blk: *lang_mir.MirBlock = regalloc_context.block_at(ctx, bi);
        var ii:  u32                = 0;
        for (ii < blk.instr_count) {
            val mi: *lang_mir.MirInstr = ?blk.instrs[ii];
            var k:  u32                = 0;
            for (k < mi.operand_count) {
                val op: *lang_mir.MirOperand = ?mi.operands[k];
                if (op.kind == lang_mir.MIR_OP_VREG && op.vreg.n < nv) {
                    op.vreg = lang_mir.vreg_id(web_find(parent, op.vreg.n));
                }
                or (op.kind == lang_mir.MIR_OP_MEM) {
                    if (!lang_mir.vreg_is_nil(op.vreg) && op.vreg.n < nv) {
                        op.vreg = lang_mir.vreg_id(web_find(parent, op.vreg.n));
                    }
                    var ix: u32 = nv;
                    if (sel op.index.vreg) { ix = op.index.vreg.n; }
                    if (ix < nv)           { op.index = lang_mir.index_vreg(lang_mir.vreg_id(web_find(parent, ix))); }
                }
                k = k + 1;
            }
            var b: u32 = 0;
            for (b < mi.dbg_binding_count) {
                val db: *lang_mir.MirDbgBinding = ?mi.dbg_bindings[b];
                if (db.vreg != lang_mir.MIR_VREG_NIL.n && db.vreg < nv)   { db.vreg = web_find(parent, db.vreg); }
                if (db.vreg2 != lang_mir.MIR_VREG_NIL.n && db.vreg2 < nv) { db.vreg2 = web_find(parent, db.vreg2); }
                b = b + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

# a copy of a register onto itself goes, operands of `kind` alone: virtual
# ones before allocation, physical ones after the rewrite. a declassifying one
# leaves its marker
pub fun drop_self_copies(tgt: *lang_target.Binding, ctx: *regalloc_context.Context, kind: lang_mir.MirOperandKind) err[fail.Fail] {
    val f:  *lang_mir.MirFunction = ctx.f;
    var bi: u32                   = 0;
    for (bi < f.block_count) {
        val blk:   *lang_mir.MirBlock = regalloc_context.block_at(ctx, bi);
        var write: u32                = 0;
        var read:  u32                = 0;
        for (read < blk.instr_count) {
            val mi:   *lang_mir.MirInstr = ?blk.instrs[read];
            var drop: bool               = false;
            if (instr_is_reg_copy(tgt, mi)) {
                drop = mi.operands[0].kind == kind && lang_mir.operand_same(?mi.operands[0], ?mi.operands[1]);
            }
            if (drop && lang_mir.instr_declassifies(mi)) {
                val marker: lang_mir.MirInstr = lang_mir.declassify_marker(mi, mi.operands[0].vreg);
                A.deallocate[lang_mir.MirOperand](ctx.alloc, mi.operands, mi.operand_count::usize);
                blk.instrs[write] = marker;
                write             = write + 1;
            }
            or (drop) {
                if (mi.operands != nil && mi.operand_count > 0) {
                    A.deallocate[lang_mir.MirOperand](ctx.alloc, mi.operands, mi.operand_count::usize);
                }
                val rd: err[fail.Fail] = pass_dbg_on(ctx, blk, read);
                if (sel rd.err) { ret rd; }
            }
            or {
                if (write != read) { blk.instrs[write] = blk.instrs[read]; }
                write = write + 1;
            }
            read = read + 1;
        }
        blk.instr_count = write;
        bi              = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun copies(tgt: *lang_target.Binding, ctx: *regalloc_context.Context) err[fail.Fail] {
    val f:  *lang_mir.MirFunction = ctx.f;
    val nv: u32                   = f.vreg_count;
    if (nv == 0)                     { ret err[fail.Fail].ok{}; }
    if (tgt.arch.is_reg_move == nil) { ret err[fail.Fail].ok{}; }

    val rp: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, nv::usize);
    if (sel rp.err) { ret err[fail.Fail].err{fail.refused(rp.err)}; }
    val parent: *u32               = rp.ok;
    val rw:     res[*u32, A.Error] = A.allocate[u32](ctx.alloc, nv::usize);
    if (sel rw.err) {
        A.deallocate[u32](ctx.alloc, parent, nv::usize);
        ret err[fail.Fail].err{fail.refused(rw.err)};
    }
    val web_defs: *u32 = rw.ok;

    var i: u32 = 0;
    for (i < nv) {
        parent[i]   = i;
        web_defs[i] = 0;
        i           = i + 1;
    }
    tally_defs(ctx, web_defs, nv);

    var merged: bool = false;
    var bi:     u32  = 0;
    for (bi < f.block_count) {
        val blk: *lang_mir.MirBlock = regalloc_context.block_at(ctx, bi);
        var ii:  u32                = 0;
        for (ii < blk.instr_count) {
            if (try_coalesce(tgt, ctx, ?blk.instrs[ii], parent, web_defs, nv)) { merged = true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    if (merged) {
        rename_vregs(ctx, parent, nv);
        val rd: err[fail.Fail] = drop_self_copies(tgt, ctx, lang_mir.MIR_OP_VREG);
        if (sel rd.err) {
            A.deallocate[u32](ctx.alloc, web_defs, nv::usize);
            A.deallocate[u32](ctx.alloc, parent, nv::usize);
            ret rd;
        }
    }

    A.deallocate[u32](ctx.alloc, web_defs, nv::usize);
    A.deallocate[u32](ctx.alloc, parent, nv::usize);
    ret err[fail.Fail].ok{};
}

# a copy the dying-copy pass may merge away, the hottest first
rec DyingCopy {
    cold: i64;
    pos:  u32;
}

# a copy `d = s` whose source dies at it: d and s become one value when no
# position holds both, so every definition of either writes one register and
# the copy is a self-copy that vanishes. unlike copies, either side
# may have many definitions, which is the shape of a loop-carried variable
# and the value its back edge copies into it. the test is exact liveness:
# two values that never meet may share a register soundly. a position where
# one side's last read meets the other's definition is shared only when the
# instruction reads before it writes, the rule the scan's hand-off applies,
# so a merge never makes a two-address op clobber its own operand. one web's
# hull must lie inside the other's, so the merged value spans nothing new,
# and a value copied from or into a physical register keeps its own hint:
# without either, merges lengthen the hot loops. the constraints a register
# must meet (calls, argument windows, definitions, pins and the reload
# guarantee) apply to the merged value as the rounds place it. the copies are
# taken hottest first, so a loop's copy is not lost to a colder one that
# would merge a value it meets
pub fun dying_copies(tgt: *lang_target.Binding, ctx: *regalloc_context.Context) err[fail.Fail] {
    val nv: u32 = ctx.f.vreg_count;
    if (nv == 0 || tgt.arch.is_reg_move == nil) { ret err[fail.Fail].ok{}; }
    if (!has_mergeable_copy(tgt, ctx))          { ret err[fail.Fail].ok{}; }

    val rt: err[fail.Fail] = regalloc_context.round_tables_init(ctx);
    if (sel rt.err) { ret rt; }
    fin { regalloc_context.round_tables_dnit(ctx); }
    val fl: err[fail.Fail] = liveness.flatten(ctx);
    if (sel fl.err) { ret fl; }
    val bs: err[fail.Fail] = liveness.build_block_spans(ctx);
    if (sel bs.err) { ret bs; }
    val bd: err[fail.Fail] = liveness.build_loop_depth(ctx);
    if (sel bd.err) { ret bd; }
    val br: err[fail.Fail] = liveness.build_ranges(ctx);
    if (sel br.err) { ret br; }
    val lv: err[fail.Fail] = liveness.extend(ctx);
    if (sel lv.err) { ret lv; }

    var count: u32 = 0;
    var pos:   u32 = 0;
    for (pos < ctx.live.flat_count) {
        if (dying_copy(tgt, ctx, pos)) { count = count + 1; }
        pos = pos + 1;
    }
    if (count == 0) { ret err[fail.Fail].ok{}; }
    val rc: res[*DyingCopy, A.Error] = A.allocate[DyingCopy](ctx.alloc, count::usize);
    if (sel rc.err) { ret err[fail.Fail].err{fail.refused(rc.err)}; }
    val copies: *DyingCopy = rc.ok;
    fin { A.deallocate[DyingCopy](ctx.alloc, copies, count::usize); }
    var n: u32 = 0;
    pos = 0;
    for (pos < ctx.live.flat_count) {
        if (dying_copy(tgt, ctx, pos)) {
            copies[n].cold = -liveness.use_weight_at(ctx, pos);
            copies[n].pos  = pos;
            n              = n + 1;
        }
        pos = pos + 1;
    }
    sort.sort[DyingCopy](copies, count::usize);

    val rp: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, nv::usize);
    if (sel rp.err) { ret err[fail.Fail].err{fail.refused(rp.err)}; }
    val parent: *u32 = rp.ok;
    fin { A.deallocate[u32](ctx.alloc, parent, nv::usize); }
    val rn: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, nv::usize);
    if (sel rn.err) { ret err[fail.Fail].err{fail.refused(rn.err)}; }
    val next: *u32 = rn.ok;
    fin { A.deallocate[u32](ctx.alloc, next, nv::usize); }
    val rb: res[*bool, A.Error] = A.allocate[bool](ctx.alloc, nv::usize);
    if (sel rb.err) { ret err[fail.Fail].err{fail.refused(rb.err)}; }
    val pinned: *bool = rb.ok;
    fin { A.deallocate[bool](ctx.alloc, pinned, nv::usize); }
    var i: u32 = 0;
    for (i < nv) {
        parent[i] = i;
        next[i]   = i;
        pinned[i] = false;
        i         = i + 1;
    }
    mark_register_copies(tgt, ctx, pinned);

    var merged: bool = false;
    var c:      u32  = 0;
    for (c < count) {
        val mi: *lang_mir.MirInstr = regalloc_context.flat_instr(ctx, copies[c].pos);
        val rd: u32                = web_find(parent, mi.operands[0].vreg.n);
        val rs: u32                = web_find(parent, mi.operands[1].vreg.n);
        if (rd != rs && !web_any(next, pinned, rd) && !web_any(next, pinned, rs) && hulls_nest(ctx, next, rd, rs)
            && !webs_meet(ctx, next, rd, rs)) {
            parent[rd] = rs;
            # splice the two member rings into one
            val t: u32 = next[rd];
            next[rd] = next[rs];
            next[rs] = t;
            merged   = true;
        }
        c = c + 1;
    }
    if (!merged) { ret err[fail.Fail].ok{}; }
    rename_vregs(ctx, parent, nv);
    ret drop_self_copies(tgt, ctx, lang_mir.MIR_OP_VREG);
}

# a full-width copy between two values that could share a register, whose
# source's segment ends at it
fun dying_copy(tgt: *lang_target.Binding, ctx: *regalloc_context.Context, pos: u32) bool {
    val mi: *lang_mir.MirInstr = regalloc_context.flat_instr(ctx, pos);
    if (!mergeable_copy(tgt, ctx, mi)) { ret false; }
    ret liveness.dies_at(ctx, mi.operands[1].vreg.n, pos::i64);
}

fun has_mergeable_copy(tgt: *lang_target.Binding, ctx: *regalloc_context.Context) bool {
    val f:  *lang_mir.MirFunction = ctx.f;
    var bi: u32                   = 0;
    for (bi < f.block_count) {
        val blk: *lang_mir.MirBlock = regalloc_context.block_at(ctx, bi);
        var ii:  u32                = 0;
        for (ii < blk.instr_count) {
            if (mergeable_copy(tgt, ctx, ?blk.instrs[ii])) { ret true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

fun mergeable_copy(tgt: *lang_target.Binding, ctx: *regalloc_context.Context, mi: *lang_mir.MirInstr) bool {
    if (!instr_is_reg_copy(tgt, mi)) { ret false; }
    if (mi.width < ctx.spill_width)  { ret false; }
    val dop: *lang_mir.MirOperand = ?mi.operands[0];
    val sop: *lang_mir.MirOperand = ?mi.operands[1];
    if (dop.kind != lang_mir.MIR_OP_VREG || sop.kind != lang_mir.MIR_OP_VREG) { ret false; }
    val d: u32 = dop.vreg.n;
    val s: u32 = sop.vreg.n;
    if (d >= ctx.f.vreg_count || s >= ctx.f.vreg_count || d == s)                                       { ret false; }
    if (regalloc_context.vreg_has_slot(ctx, dop.vreg) || regalloc_context.vreg_has_slot(ctx, sop.vreg)) { ret false; }
    val dv: *lang_mir.MirVReg = ?ctx.f.vregs[d];
    val sv: *lang_mir.MirVReg = ?ctx.f.vregs[s];
    ret dv.class == sv.class && dv.secret == sv.secret && dv.vec_bytes == sv.vec_bytes;
}

# the values copied from or into a physical register
fun mark_register_copies(tgt: *lang_target.Binding, ctx: *regalloc_context.Context, pinned: *bool) {
    var pos: u32 = 0;
    for (pos < ctx.live.flat_count) {
        val mi: *lang_mir.MirInstr = regalloc_context.flat_instr(ctx, pos);
        if (instr_is_reg_copy(tgt, mi)) {
            val d: *lang_mir.MirOperand = ?mi.operands[0];
            val s: *lang_mir.MirOperand = ?mi.operands[1];
            if (d.kind == lang_mir.MIR_OP_VREG && s.kind == lang_mir.MIR_OP_PREG && d.vreg.n < ctx.f.vreg_count) { pinned[d.vreg.n] = true; }
            if (d.kind == lang_mir.MIR_OP_PREG && s.kind == lang_mir.MIR_OP_VREG && s.vreg.n < ctx.f.vreg_count) { pinned[s.vreg.n] = true; }
        }
        pos = pos + 1;
    }
}

fun web_any(next: *u32, flag: *bool, a: u32) bool {
    var x: u32 = a;
    for (true) {
        if (flag[x]) { ret true; }
        x = next[x];
        if (x == a) { brk; }
    }
    ret false;
}

fun web_hull(ctx: *regalloc_context.Context, next: *u32, a: u32, lo: *i64, hi: *i64) {
    @lo = regalloc_context.POS_MAX;
    @hi = -1;
    var x: u32 = a;
    for (true) {
        if (ctx.live.ranges[x].start < @lo)   { @lo = ctx.live.ranges[x].start; }
        if (ctx.live.ranges[x].end_pos > @hi) { @hi = ctx.live.ranges[x].end_pos; }
        x = next[x];
        if (x == a) { brk; }
    }
}

# whether one web's hull lies inside the other's, so the merged value spans
# no position that one of them did not already span
fun hulls_nest(ctx: *regalloc_context.Context, next: *u32, a: u32, b: u32) bool {
    var alo: i64 = 0;
    var ahi: i64 = 0;
    var blo: i64 = 0;
    var bhi: i64 = 0;
    web_hull(ctx, next, a, ?alo, ?ahi);
    web_hull(ctx, next, b, ?blo, ?bhi);
    ret (alo <= blo && bhi <= ahi) || (blo <= alo && ahi <= bhi);
}

# whether any value of one web meets any value of the other; each value's
# segments are its own, so the webs' union is tested member by member
fun webs_meet(ctx: *regalloc_context.Context, next: *u32, a: u32, b: u32) bool {
    var x: u32 = a;
    for (true) {
        var y: u32 = b;
        for (true) {
            if (liveness.intersects(ctx, ?ctx.live.ranges[x], ?ctx.live.ranges[y])) { ret true; }
            y = next[y];
            if (y == b) { brk; }
        }
        x = next[x];
        if (x == a) { brk; }
    }
    ret false;
}

fun reads_in_window(ctx: *regalloc_context.Context, d: u32, from: i64, to: i64) bool {
    var p: i64 = from + 1;
    for (p < to) {
        if (liveness.instr_reads_vreg(regalloc_context.flat_instr(ctx, p::u32), lang_mir.vreg_id(d))) { ret true; }
        p = p + 1;
    }
    ret false;
}

pub fun build_hints(tgt: *lang_target.Binding, ctx: *regalloc_context.Context) {
    if (tgt.arch.is_reg_move == nil) { ret; }
    val nv:  u32 = ctx.f.vreg_count;
    var pos: u32 = 0;
    for (pos < ctx.live.flat_count) {
        val mi: *lang_mir.MirInstr = regalloc_context.flat_instr(ctx, pos);
        if (instr_is_reg_copy(tgt, mi)) {
            val d: *lang_mir.MirOperand = ?mi.operands[0];
            if (d.kind == lang_mir.MIR_OP_VREG && d.vreg.n < nv
                && ctx.scan.hints[d.vreg.n].src_vreg == lang_mir.MIR_VREG_NIL.n
                && ctx.scan.hints[d.vreg.n].src_preg < 0) {
                val s: *lang_mir.MirOperand = ?mi.operands[1];
                if (s.kind == lang_mir.MIR_OP_VREG && !lang_mir.vreg_same(s.vreg, d.vreg)) {
                    ctx.scan.hints[d.vreg.n].src_vreg = s.vreg.n;
                    ctx.scan.hints[d.vreg.n].copy_pos = pos::i64;
                }
                or (s.kind == lang_mir.MIR_OP_PREG) {
                    ctx.scan.hints[d.vreg.n].src_preg = lang_mir.preg_regid(s.preg);
                    ctx.scan.hints[d.vreg.n].copy_pos = pos::i64;
                }
            }
            maybe_sink_hint(ctx, mi, pos, nv);
            maybe_reverse_hint(ctx, mi, pos, nv);
        }
        or {
            maybe_tie_hint(ctx, mi, pos, nv);
        }
        pos = pos + 1;
    }
}

# a two-address result prefers the register of an operand that dies at the
# op, so the op runs in place; a commutative op may take either operand
fun maybe_tie_hint(ctx: *regalloc_context.Context, mi: *lang_mir.MirInstr, pos: u32, nv: u32) {
    if (!liveness.is_two_address_op(mi.opcode)) { ret; }
    if (mi.operand_count < 2)                   { ret; }
    val d: *lang_mir.MirOperand = ?mi.operands[0];
    if (d.kind != lang_mir.MIR_OP_VREG || d.vreg.n >= nv) { ret; }
    if (ctx.scan.hints[d.vreg.n].src_vreg != lang_mir.MIR_VREG_NIL.n
        || ctx.scan.hints[d.vreg.n].src_preg >= 0) { ret; }
    if (ctx.live.ranges[d.vreg.n].start != pos::i64) { ret; }
    var tie: u32 = tie_operand(ctx, d, ?mi.operands[1], pos, nv);
    if (tie == regalloc_context.RANGE_NIL && mi.operand_count >= 3 && lang_mir.has(mi.opcode, lang_mir.MIRF_COMMUTATIVE)) {
        tie = tie_operand(ctx, d, ?mi.operands[2], pos, nv);
    }
    if (tie == regalloc_context.RANGE_NIL) { ret; }
    ctx.scan.hints[d.vreg.n].src_vreg = tie;
    ctx.scan.hints[d.vreg.n].copy_pos = pos::i64;
}

fun tie_operand(ctx: *regalloc_context.Context, d: *lang_mir.MirOperand, op: *lang_mir.MirOperand, pos: u32, nv: u32) u32 {
    if (op.kind != lang_mir.MIR_OP_VREG)                        { ret regalloc_context.RANGE_NIL; }
    if (op.vreg.n >= nv || lang_mir.vreg_same(d.vreg, op.vreg)) { ret regalloc_context.RANGE_NIL; }
    if (!liveness.dies_at(ctx, op.vreg.n, pos::i64))            { ret regalloc_context.RANGE_NIL; }
    ret op.vreg.n;
}

fun maybe_sink_hint(ctx: *regalloc_context.Context, mi: *lang_mir.MirInstr, pos: u32, nv: u32) {
    val d: *lang_mir.MirOperand = ?mi.operands[0];
    val s: *lang_mir.MirOperand = ?mi.operands[1];
    if (d.kind != lang_mir.MIR_OP_PREG || s.kind != lang_mir.MIR_OP_VREG) { ret; }
    if (s.vreg.n >= nv)                                                   { ret; }
    if (mi.width < ctx.spill_width)                                       { ret; }
    val sv: u32 = s.vreg.n;
    if (ctx.scan.hints[sv].sink_preg >= 0)    { ret; }
    if (!liveness.dies_at(ctx, sv, pos::i64)) { ret; }
    ctx.scan.hints[sv].sink_preg = lang_mir.preg_regid(d.preg);
}

# a copy `d = s` where s dies and d is dead from s's birth to the copy: s
# takes d's register and the copy vanishes. d may still be read by the
# instruction that defines s, so that instruction must read d before it
# writes s, which a two-address op does only for its left operand
fun maybe_reverse_hint(ctx: *regalloc_context.Context, mi: *lang_mir.MirInstr, pos: u32, nv: u32) {
    val d: *lang_mir.MirOperand = ?mi.operands[0];
    val s: *lang_mir.MirOperand = ?mi.operands[1];
    if (d.kind != lang_mir.MIR_OP_VREG || s.kind != lang_mir.MIR_OP_VREG)       { ret; }
    if (d.vreg.n >= nv || s.vreg.n >= nv || lang_mir.vreg_same(d.vreg, s.vreg)) { ret; }
    val dv: u32 = d.vreg.n;
    val sv: u32 = s.vreg.n;
    if (ctx.scan.hints[sv].dst_vreg != lang_mir.MIR_VREG_NIL.n) { ret; }

    val p:  i64                         = pos::i64;
    val dr: *regalloc_context.LiveRange = ?ctx.live.ranges[dv];

    if (dr.start >= p || dr.end_pos < p) { ret; }
    val q: i64 = liveness.seg_from_ending_at(ctx, sv, p);
    if (q < 0 || q >= p)                                                                  { ret; }
    if (ctx.live.flat[q::u32].block != ctx.live.flat[pos].block)                          { ret; }
    if (reads_in_window(ctx, dv, q, p))                                                   { ret; }
    if (liveness.defines_by_clobbering(regalloc_context.flat_instr(ctx, q::u32), sv, dv)) { ret; }

    ctx.scan.hints[sv].dst_vreg     = dv;
    ctx.scan.hints[sv].dst_copy_pos = p;
}

test is_dead_mov__guards {
    val ts: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    if (sel ts.err) { ret 1; }
    var t: lang_target.Binding = ts.ok;

    var f: lang_mir.MirFunction;
    f.vreg_count = 3;
    var slot: [3]bool;
    slot[0] = false;
    slot[1] = false;
    slot[2] = true;

    var ctx: regalloc_context.Context;
    ctx.f              = ?f;
    ctx.vreg_slot_flag = ?slot[0];

    var reads: [3]u32;
    reads[0] = 0;
    reads[1] = 1;
    reads[2] = 0;

    var ops: [2]lang_mir.MirOperand;
    ops[0] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    ops[1] = lang_mir.op_vreg(lang_mir.vreg_id(1));
    var mv: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_MOV, ?ops[0], 2, 8, 8);
    mv.asm_block = nil;

    if (!is_dead_mov(?t, ?ctx, ?mv, ?reads[0], 3)) { ret 1; }

    ops[0] = lang_mir.op_vreg(lang_mir.vreg_id(1));
    if (is_dead_mov(?t, ?ctx, ?mv, ?reads[0], 3)) { ret 1; }

    ops[0] = lang_mir.op_vreg(lang_mir.vreg_id(2));
    if (is_dead_mov(?t, ?ctx, ?mv, ?reads[0], 3)) { ret 1; }

    ops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    if (is_dead_mov(?t, ?ctx, ?mv, ?reads[0], 3)) { ret 1; }

    ops[0]       = lang_mir.op_vreg(lang_mir.vreg_id(0));
    mv.src_width = 4;
    if (is_dead_mov(?t, ?ctx, ?mv, ?reads[0], 3)) { ret 1; }

    ret 0;
}

test sweep_dead_movs__retallies_to_a_fixpoint {
    var t: lang_target.Binding;
    if (!regalloc_context.t_target(?t)) { ret 1; }
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: lang_mir.MirFunction;
    lang_mir.vregs_gp(?alloc, ?f, 3);
    var b: lang_mir.MirBlock;
    lang_mir.instrs_blank(?alloc, ?b, 4);
    regalloc_context.t_mov(?alloc, ?b, 0, lang_mir.op_vreg(lang_mir.vreg_id(0)), lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 3))));
    regalloc_context.t_mov(?alloc, ?b, 1, lang_mir.op_vreg(lang_mir.vreg_id(1)), lang_mir.op_vreg(lang_mir.vreg_id(0)));
    regalloc_context.t_mov(?alloc, ?b, 2, lang_mir.op_vreg(lang_mir.vreg_id(2)), lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 5))));
    regalloc_context.t_mov(?alloc, ?b, 3, lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 6))), lang_mir.op_vreg(lang_mir.vreg_id(2)));
    f.blocks      = ?b;
    f.block_count = 1;
    f.block_cap   = 1;

    var slots: [3]bool;
    slots[0] = false;
    slots[1] = false;
    slots[2] = false;
    var ctx: regalloc_context.Context;
    regalloc_context.t_ctx(?ctx, ?alloc, ?f, ?slots[0]);

    val sweep_dead_movs_r: err[fail.Fail] = sweep_dead_movs(?t, ?ctx);
    if (sel sweep_dead_movs_r.err) { ret 1; }

    if (b.instr_count != 2)                                                                      { ret 1; }
    if (b.instrs[0].operands[0].kind != lang_mir.MIR_OP_VREG)                                    { ret 1; }
    if (b.instrs[0].operands[0].vreg.n != 2)                                                     { ret 1; }
    if (b.instrs[1].operands[0].kind != lang_mir.MIR_OP_PREG)                                    { ret 1; }
    if (b.instrs[1].operands[0].preg.n != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 6)::u32) { ret 1; }

    ret 0;
}

# `v0 = p3; v1 = v0; p4 = v1` merges v1 into v0, unless the two differ in
# secrecy, the copy narrows, v1 has a slot, or v1 is defined twice
test copies__a_single_assignment_web {
    var t: lang_target.Binding;
    if (!regalloc_context.t_target(?t)) { ret 1; }
    var alloc: A.Allocator;
    page.make(?alloc);
    if (t_web(?t, ?alloc, false, false, 8, false, false) != 2) { ret 2; }
    if (t_web(?t, ?alloc, true, false, 8, false, false) != 3)  { ret 3; }
    if (t_web(?t, ?alloc, true, true, 8, false, false) != 2)   { ret 4; }
    if (t_web(?t, ?alloc, false, false, 4, false, false) != 3) { ret 5; }
    if (t_web(?t, ?alloc, false, false, 8, true, false) != 3)  { ret 6; }
    if (t_web(?t, ?alloc, false, false, 8, false, true) != 4)  { ret 7; }
    ret 0;
}

# the instruction count the web coalesces to; 0 when the merge is malformed
#[testing]
fun t_web(t: *lang_target.Binding, alloc: *A.Allocator, secret0: bool, secret1: bool, width: u8, slot1: bool, redefine: bool) u32 {
    var f: lang_mir.MirFunction;
    lang_mir.vregs_gp(alloc, ?f, 2);
    f.vregs[0].secret = secret0;
    f.vregs[1].secret = secret1;
    var b: lang_mir.MirBlock;
    var n: u32 = 3;
    if (redefine) { n = 4; }
    lang_mir.instrs_blank(alloc, ?b, n);
    regalloc_context.t_mov(alloc, ?b, 0, lang_mir.op_vreg(lang_mir.vreg_id(0)), lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 3))));
    regalloc_context.t_mov(alloc, ?b, 1, lang_mir.op_vreg(lang_mir.vreg_id(1)), lang_mir.op_vreg(lang_mir.vreg_id(0)));
    b.instrs[1].width     = width;
    b.instrs[1].src_width = width;
    if (redefine) { regalloc_context.t_mov(alloc, ?b, 2, lang_mir.op_vreg(lang_mir.vreg_id(1)), lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 5)))); }
    regalloc_context.t_mov(alloc, ?b, n - 1, lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 4))), lang_mir.op_vreg(lang_mir.vreg_id(1)));
    f.blocks      = ?b;
    f.block_count = 1;
    f.block_cap   = 1;
    var slots: [2]bool = [2]bool{false, slot1};
    var ctx:   regalloc_context.Context;
    regalloc_context.t_ctx(?ctx, alloc, ?f, ?slots[0]);
    val r: err[fail.Fail] = copies(t, ?ctx);
    if (sel r.err) { ret 0; }
    if (b.instr_count == 2) {
        if (b.instrs[0].operands[0].vreg.n != 0 || b.instrs[1].operands[1].kind != lang_mir.MIR_OP_VREG || b.instrs[1].operands[1].vreg.n != 0) { ret 0; }
    }
    ret b.instr_count;
}

#[testing]
fun t_selected_copy(t: *lang_target.Binding, opcode: u32, copied: bool) bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    var f: lang_mir.MirFunction;
    var b: lang_mir.MirBlock;
    f.blocks      = ?b;
    f.block_count = 1;
    fin { lang_mir.dnit_function(?alloc, ?f); }
    lang_mir.vregs_gp(?alloc, ?f, 2);
    lang_mir.instrs_blank(?alloc, ?b, 3);
    regalloc_context.t_mov(?alloc, ?b, 0, lang_mir.op_vreg(lang_mir.vreg_id(0)), lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 10))));
    regalloc_context.t_mov(?alloc, ?b, 1, lang_mir.op_vreg(lang_mir.vreg_id(1)), lang_mir.op_vreg(lang_mir.vreg_id(0)));
    regalloc_context.t_mov(?alloc, ?b, 2, lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 11))), lang_mir.op_vreg(lang_mir.vreg_id(1)));
    var i: u32 = 0;
    for (i < 3) {
        b.instrs[i].width     = t.target.model.gpr_width::u8;
        b.instrs[i].src_width = t.target.model.gpr_width::u8;
        i                     = i + 1;
    }
    b.instrs[1].opcode    = opcode;
    b.instrs[1].width     = 4;
    b.instrs[1].src_width = 4;
    var backend:    isa.BackendTarget = binding.backend_target(t);
    val selected_r: err[fail.Fail]    = t.arch.select(?alloc, ?backend, ?f);
    if (sel selected_r.err) { ret false; }
    var selected: u32 = opcode;
    if (copied)                         { selected = isa_riscv.MOV::u32; }
    if (b.instrs[1].opcode != selected) { ret false; }

    var slots: [2]bool;
    var ctx:   regalloc_context.Context;
    regalloc_context.t_ctx(?ctx, ?alloc, ?f, ?slots[0]);
    ctx.spill_width = t.target.model.spill_width::u8;
    val coalesce_copies_r: err[fail.Fail] = copies(t, ?ctx);
    if (sel coalesce_copies_r.err) { ret false; }
    if (!copied)                   { ret b.instr_count == 3 && b.instrs[1].opcode == opcode; }
    ret b.instr_count == 2 && b.instrs[1].operands[1].kind == lang_mir.MIR_OP_VREG &&
        b.instrs[1].operands[1].vreg.n == 0;
}

test copies__a_narrow_copy_merges_only_where_the_machine_selected_a_move {
    val s32: res[lang_target.Binding, fail.Fail] = lang_target.t_select("rv32imafdc", "freestanding", "ilp32d");
    if (sel s32.err) { ret 2; }
    var rv32: lang_target.Binding                 = s32.ok;
    val s64:  res[lang_target.Binding, fail.Fail] = lang_target.t_select("riscv64", "linux", "lp64d");
    if (sel s64.err) { ret 3; }
    var rv64: lang_target.Binding = s64.ok;
    if (rv32.target.model.gpr_width != 4 || rv64.target.model.gpr_width != 8) { ret 4; }
    var pass: u32 = 0;
    for (pass < 3) {
        var current: *lang_target.Binding = ?rv32;
        if (pass == 1)                                                  { current = ?rv64; }
        if (!t_selected_copy(current, lang_mir.MIR_BITCAST, pass != 1)) { ret 5; }
        if (!t_selected_copy(current, lang_mir.MIR_SEXT, pass != 1))    { ret 6; }
        pass = pass + 1;
    }
    ret 0;
}

test maybe_sink_hint__only_a_dying_full_width_placement {
    var ctx:    regalloc_context.Context;
    var ranges: [2]regalloc_context.LiveRange;
    var hints:  [2]regalloc_context.CopyHint;
    var segs:   [2]regalloc_context.Segment;
    var f:      lang_mir.MirFunction;
    f.vreg_count    = 2;
    ctx.f           = ?f;
    ctx.live.ranges = ?ranges[0];
    ctx.live.segs   = ?segs[0];
    ctx.scan.hints  = ?hints[0];
    ctx.spill_width = 8;
    var i: u32 = 0;
    for (i < 2) {
        hints[i].src_vreg     = lang_mir.MIR_VREG_NIL.n;
        hints[i].src_preg     = -1;
        hints[i].copy_pos     = -1;
        hints[i].dst_vreg     = lang_mir.MIR_VREG_NIL.n;
        hints[i].dst_copy_pos = -1;
        hints[i].sink_preg    = -1;
        i                     = i + 1;
    }

    var ops: [2]lang_mir.MirOperand;
    ops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 7)));
    ops[1] = lang_mir.op_vreg(lang_mir.vreg_id(1));
    var mv: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_MOV, ?ops[0], 2, 8, 8);

    ranges[1].end_pos = 10;
    regalloc_context.t_hull_segs(?ctx, 2);
    maybe_sink_hint(?ctx, ?mv, 10, 2);
    if (hints[1].sink_preg != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 7)) { ret 1; }

    ops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 6)));
    maybe_sink_hint(?ctx, ?mv, 10, 2);
    if (hints[1].sink_preg != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 7)) { ret 1; }

    hints[1].sink_preg = -1;
    ranges[1].end_pos  = 14;
    regalloc_context.t_hull_segs(?ctx, 2);
    ops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 7)));
    maybe_sink_hint(?ctx, ?mv, 10, 2);
    if (hints[1].sink_preg != -1) { ret 1; }

    ranges[1].end_pos = 10;
    regalloc_context.t_hull_segs(?ctx, 2);
    mv.width     = 4;
    mv.src_width = 4;
    maybe_sink_hint(?ctx, ?mv, 10, 2);
    if (hints[1].sink_preg != -1) { ret 1; }

    mv.width     = 8;
    mv.src_width = 8;
    ops[0]       = lang_mir.op_vreg(lang_mir.vreg_id(0));
    maybe_sink_hint(?ctx, ?mv, 10, 2);
    if (hints[1].sink_preg != -1) { ret 1; }

    ret 0;
}

# `s = f(d, ...)` then `d = s`: s may take d's register only when the op reads
# d before writing s, which rules out a non-commutative two-address right
# operand and an address register
test maybe_reverse_hint__refuses_an_operand_the_op_would_clobber {
    var alloc: A.Allocator;
    page.make(?alloc);
    var f: lang_mir.MirFunction;
    lang_mir.vregs_gp(?alloc, ?f, 3);
    var b: lang_mir.MirBlock;
    lang_mir.instrs_blank(?alloc, ?b, 2);
    val ro: res[*lang_mir.MirOperand, A.Error] = A.allocate[lang_mir.MirOperand](?alloc, 3::usize);
    if (sel ro.err) { ret 1; }
    val ops: *lang_mir.MirOperand = ro.ok;
    ops[0]      = lang_mir.op_vreg(lang_mir.vreg_id(1));
    ops[1]      = lang_mir.op_vreg(lang_mir.vreg_id(2));
    ops[2]      = lang_mir.op_vreg(lang_mir.vreg_id(0));
    b.instrs[0] = lang_mir.instr(lang_mir.MIR_SEL_SUB, ops, 3, 8, 8);
    regalloc_context.t_mov(?alloc, ?b, 1, lang_mir.op_vreg(lang_mir.vreg_id(0)), lang_mir.op_vreg(lang_mir.vreg_id(1)));
    f.blocks      = ?b;
    f.block_count = 1;
    f.block_cap   = 1;

    var flat: [2]regalloc_context.FlatInstr;
    flat[0].block   = 0;
    flat[0].instr   = 0;
    flat[0].is_call = false;
    flat[1].block   = 0;
    flat[1].instr   = 1;
    flat[1].is_call = false;
    var ranges: [3]regalloc_context.LiveRange;
    var hints:  [3]regalloc_context.CopyHint;
    var segs:   [3]regalloc_context.Segment;
    var slots:  [3]bool;
    var ctx:    regalloc_context.Context;
    regalloc_context.t_ctx(?ctx, ?alloc, ?f, ?slots[0]);
    ctx.live.flat       = ?flat[0];
    ctx.live.flat_count = 2;
    ctx.live.ranges     = ?ranges[0];
    ctx.live.segs       = ?segs[0];
    ctx.scan.hints      = ?hints[0];
    var i: u32 = 0;
    for (i < 3) {
        hints[i].src_vreg     = lang_mir.MIR_VREG_NIL.n;
        hints[i].src_preg     = -1;
        hints[i].copy_pos     = -1;
        hints[i].dst_vreg     = lang_mir.MIR_VREG_NIL.n;
        hints[i].dst_copy_pos = -1;
        hints[i].sink_preg    = -1;
        ranges[i].start       = 0;
        ranges[i].end_pos     = 1;
        i                     = i + 1;
    }
    ranges[0].end_pos = 5;
    ranges[1].start   = 0;
    ranges[1].end_pos = 1;
    val copy: *lang_mir.MirInstr = ?b.instrs[1];

    # d is the right operand of a sub: refused
    ranges[0].start = -1;
    regalloc_context.t_hull_segs(?ctx, 3);
    maybe_reverse_hint(?ctx, copy, 1, 3);
    if (hints[1].dst_vreg != lang_mir.MIR_VREG_NIL.n) { ret 2; }

    # the same op with d on the left is read first: hinted
    ops[1] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    ops[2] = lang_mir.op_vreg(lang_mir.vreg_id(2));
    maybe_reverse_hint(?ctx, copy, 1, 3);
    if (hints[1].dst_vreg != 0)     { ret 3; }
    if (hints[1].dst_copy_pos != 1) { ret 3; }

    # a commutative op is swapped onto its right operand: hinted
    hints[1].dst_vreg     = lang_mir.MIR_VREG_NIL.n;
    hints[1].dst_copy_pos = -1;
    ops[1]                = lang_mir.op_vreg(lang_mir.vreg_id(2));
    ops[2]                = lang_mir.op_vreg(lang_mir.vreg_id(0));
    b.instrs[0].opcode    = lang_mir.MIR_SEL_ADD;
    maybe_reverse_hint(?ctx, copy, 1, 3);
    if (hints[1].dst_vreg != 0) { ret 4; }

    # an address register of the right operand is read after the copy: refused
    hints[1].dst_vreg     = lang_mir.MIR_VREG_NIL.n;
    hints[1].dst_copy_pos = -1;
    ops[2]                = lang_mir.op_mem_value(lang_mir.vreg_id(0), 8);
    maybe_reverse_hint(?ctx, copy, 1, 3);
    if (hints[1].dst_vreg != lang_mir.MIR_VREG_NIL.n) { ret 5; }

    # a single instruction reads every operand before it writes: hinted
    ops[2]             = lang_mir.op_vreg(lang_mir.vreg_id(0));
    b.instrs[0].opcode = lang_mir.MIR_MOV;
    maybe_reverse_hint(?ctx, copy, 1, 3);
    if (hints[1].dst_vreg != 0) { ret 6; }
    ret 0;
}

test maybe_tie_hint__a_dying_left_operand {
    var ctx:    regalloc_context.Context;
    var ranges: [3]regalloc_context.LiveRange;
    var hints:  [3]regalloc_context.CopyHint;
    var segs:   [3]regalloc_context.Segment;
    var f:      lang_mir.MirFunction;
    f.vreg_count    = 3;
    ctx.f           = ?f;
    ctx.live.ranges = ?ranges[0];
    ctx.live.segs   = ?segs[0];
    ctx.scan.hints  = ?hints[0];
    var i: u32 = 0;
    for (i < 3) {
        hints[i].src_vreg     = lang_mir.MIR_VREG_NIL.n;
        hints[i].src_preg     = -1;
        hints[i].copy_pos     = -1;
        hints[i].dst_vreg     = lang_mir.MIR_VREG_NIL.n;
        hints[i].dst_copy_pos = -1;
        hints[i].sink_preg    = -1;
        i                     = i + 1;
    }

    var ops: [3]lang_mir.MirOperand;
    ops[0] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    ops[1] = lang_mir.op_vreg(lang_mir.vreg_id(1));
    ops[2] = lang_mir.op_vreg(lang_mir.vreg_id(2));
    var op: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_SEL_MUL, ?ops[0], 3, 0, 0);

    ranges[1].end_pos = 20;
    ranges[0].start   = 20;
    regalloc_context.t_hull_segs(?ctx, 3);
    maybe_tie_hint(?ctx, ?op, 20, 3);
    if (hints[0].src_vreg != 1)  { ret 1; }
    if (hints[0].copy_pos != 20) { ret 1; }

    hints[0].src_vreg = lang_mir.MIR_VREG_NIL.n;
    hints[0].copy_pos = -1;
    ranges[1].end_pos = 24;
    regalloc_context.t_hull_segs(?ctx, 3);
    maybe_tie_hint(?ctx, ?op, 20, 3);
    if (hints[0].src_vreg != lang_mir.MIR_VREG_NIL.n) { ret 1; }

    ranges[1].end_pos = 20;
    ranges[0].start   = 12;
    regalloc_context.t_hull_segs(?ctx, 3);
    maybe_tie_hint(?ctx, ?op, 20, 3);
    if (hints[0].src_vreg != lang_mir.MIR_VREG_NIL.n) { ret 1; }

    ranges[0].start = 20;
    op.opcode       = lang_mir.MIR_SEL_CMP_EQ;
    maybe_tie_hint(?ctx, ?op, 20, 3);
    if (hints[0].src_vreg != lang_mir.MIR_VREG_NIL.n) { ret 1; }

    if (!liveness.is_two_address_op(lang_mir.MIR_SEL_ADD))   { ret 1; }
    if (!liveness.is_two_address_op(lang_mir.MIR_SEL_SHR_S)) { ret 1; }
    if (liveness.is_two_address_op(lang_mir.MIR_SEL_DIV_S))  { ret 1; }
    if (liveness.is_two_address_op(lang_mir.MIR_MOV))        { ret 1; }

    ret 0;
}

# a loop around one value: v0 enters the loop, the body computes the next
# value into v1 by `op`, reads v0 again when late_read says so, and the back
# edge copies v1 into v0, which the exit reads. v2 is a value live through
# the loop. the result is the loop block's instruction count after the
# dying-copy pass, or a failure below 100 for a broken setup
#[testing]
fun t_dying_loop_case(isa_name: str, abi_name: str, op: lang_mir.MirOpcode, left: u32, right: u32, late_read: bool) i32 {
    val ts: res[lang_target.Binding, fail.Fail] = lang_target.t_select(isa_name, "linux", abi_name);
    if (sel ts.err) { ret 2; }
    var tgt:   lang_target.Binding = ts.ok;
    var alloc: A.Allocator;
    val made:  err[A.Error]        = page.make(?alloc);
    if (sel made.err) { ret 3; }

    var f: lang_mir.MirFunction;
    lang_mir.vregs_gp(?alloc, ?f, 3);
    var blocks: [3]lang_mir.MirBlock;
    lang_mir.instrs_blank(?alloc, ?blocks[0], 3);
    blocks[0].id = 0;
    regalloc_context.t_mov(?alloc, ?blocks[0], 0, lang_mir.op_vreg(lang_mir.vreg_id(0)), lang_mir.op_imm(3));
    regalloc_context.t_mov(?alloc, ?blocks[0], 1, lang_mir.op_vreg(lang_mir.vreg_id(2)), lang_mir.op_imm(4));
    regalloc_context.t_op(?alloc, ?blocks[0], 2, lang_mir.MIR_BR, lang_mir.op_block(1), lang_mir.op_imm(0), lang_mir.op_imm(0), 1);
    var body: u32 = 3;
    if (late_read) { body = 4; }
    lang_mir.instrs_blank(?alloc, ?blocks[1], body);
    blocks[1].id = 1;
    regalloc_context.t_op(?alloc, ?blocks[1], 0, op, lang_mir.op_vreg(lang_mir.vreg_id(1)), lang_mir.op_vreg(lang_mir.vreg_id(left)), lang_mir.op_vreg(lang_mir.vreg_id(right)), 3);
    var at: u32 = 1;
    if (late_read) {
        regalloc_context.t_op(?alloc, ?blocks[1], 1, lang_mir.MIR_STORE, lang_mir.op_mem_value(lang_mir.vreg_id(2), 0), lang_mir.op_vreg(lang_mir.vreg_id(0)), lang_mir.op_imm(0), 2);
        at = 2;
    }
    regalloc_context.t_mov(?alloc, ?blocks[1], at, lang_mir.op_vreg(lang_mir.vreg_id(0)), lang_mir.op_vreg(lang_mir.vreg_id(1)));
    regalloc_context.t_op(?alloc, ?blocks[1], at + 1, lang_mir.MIR_CBR, lang_mir.op_vreg(lang_mir.vreg_id(0)), lang_mir.op_block(1), lang_mir.op_block(2), 3);
    lang_mir.instrs_blank(?alloc, ?blocks[2], 3);
    blocks[2].id = 2;
    regalloc_context.t_op(?alloc, ?blocks[2], 0, lang_mir.MIR_SEL_ADD, lang_mir.op_vreg(lang_mir.vreg_id(2)), lang_mir.op_vreg(lang_mir.vreg_id(2)), lang_mir.op_vreg(lang_mir.vreg_id(0)), 3);
    regalloc_context.t_op(?alloc, ?blocks[2], 1, lang_mir.MIR_STORE, lang_mir.op_mem_value(lang_mir.vreg_id(2), 0), lang_mir.op_imm(0), lang_mir.op_imm(0), 2);
    regalloc_context.t_op(?alloc, ?blocks[2], 2, lang_mir.MIR_RET, lang_mir.op_imm(0), lang_mir.op_imm(0), lang_mir.op_imm(0), 0);
    f.blocks           = ?blocks[0];
    f.block_count      = 3;
    f.block_cap        = 3;
    f.frame.slot_count = 0;

    var m: lang_mir.MirModule;
    m.alloc    = ?alloc;
    m.interner = nil;
    var ctx: regalloc_context.Context;
    val ci:  err[fail.Fail] = regalloc_context.init(?ctx, ?tgt, ?m, ?f);
    fin { regalloc_context.dnit(?ctx); }
    if (sel ci.err) { ret 4; }
    val vs: err[fail.Fail] = regalloc_context.build_vreg_slot_flags(?ctx);
    if (sel vs.err) { ret 5; }
    ctx.round_count = f.vreg_count;
    val bo: err[fail.Fail] = regalloc_order.build(?ctx);
    if (sel bo.err)                                 { ret 6; }
    if (regalloc_context.block_at(?ctx, 1).id != 1) { ret 8; }
    val cd: err[fail.Fail] = dying_copies(?tgt, ?ctx);
    if (sel cd.err) { ret 9; }
    ret (100 + f.blocks[1].instr_count)::i32;
}

# the back-edge copy of a loop-carried value merges on every ISA: the
# value's last read in the body is where its next value is written, and the
# two never meet, so the add runs in place and the copy is gone
test dying_copies__a_loop_carried_value_takes_its_back_edge_copy {
    if (t_dying_loop_case("x86_64", "sysv64", lang_mir.MIR_SEL_ADD, 0, 2, false) != 102)   { ret 1; }
    if (t_dying_loop_case("aarch64", "aapcs64", lang_mir.MIR_SEL_ADD, 0, 2, false) != 102) { ret 2; }
    if (t_dying_loop_case("riscv64", "lp64d", lang_mir.MIR_SEL_ADD, 0, 2, false) != 102)   { ret 3; }
    # a commutative op reads its right operand first once it is swapped
    if (t_dying_loop_case("x86_64", "sysv64", lang_mir.MIR_SEL_ADD, 2, 0, false) != 102) { ret 4; }
    ret 0;
}

test dying_copies__refuses_values_that_meet {
    # the loop value is read after its next value is written: both are live
    if (t_dying_loop_case("x86_64", "sysv64", lang_mir.MIR_SEL_ADD, 0, 2, true) != 104)   { ret 1; }
    if (t_dying_loop_case("aarch64", "aapcs64", lang_mir.MIR_SEL_ADD, 0, 2, true) != 104) { ret 2; }
    # a two-address sub writes its result before it reads its right operand
    if (t_dying_loop_case("x86_64", "sysv64", lang_mir.MIR_SEL_SUB, 2, 0, false) != 103) { ret 3; }
    # the same sub with the loop value on the left runs in place
    if (t_dying_loop_case("x86_64", "sysv64", lang_mir.MIR_SEL_SUB, 0, 2, false) != 102) { ret 4; }
    ret 0;
}

#[testing]
fun t_self_copy_is_dropped(t: *lang_target.Binding, width: u8) bool {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: lang_mir.MirFunction;
    lang_mir.vregs_gp(?alloc, ?f, 3);
    var b: lang_mir.MirBlock;
    lang_mir.instrs_blank(?alloc, ?b, 2);
    regalloc_context.t_mov(?alloc, ?b, 0, lang_mir.op_vreg(lang_mir.vreg_id(1)), lang_mir.op_vreg(lang_mir.vreg_id(1)));
    regalloc_context.t_mov(?alloc, ?b, 1, lang_mir.op_vreg(lang_mir.vreg_id(2)), lang_mir.op_vreg(lang_mir.vreg_id(0)));
    b.instrs[0].width     = width;
    b.instrs[0].src_width = width;
    b.instrs[1].width     = width;
    b.instrs[1].src_width = width;
    f.blocks              = ?b;
    f.block_count         = 1;
    f.block_cap           = 1;

    var slots: [3]bool;
    slots[0] = false;
    slots[1] = false;
    slots[2] = false;
    var ctx: regalloc_context.Context;
    regalloc_context.t_ctx(?ctx, ?alloc, ?f, ?slots[0]);

    val rd: err[fail.Fail] = drop_self_copies(t, ?ctx, lang_mir.MIR_OP_VREG);
    if (sel rd.err) { ret false; }

    if (b.instr_count != 1) { ret false; }
    val kept: *lang_mir.MirOperand = b.instrs[0].operands;
    ret kept[0].kind == lang_mir.MIR_OP_VREG && kept[0].vreg.n == 2 &&
        kept[1].kind == lang_mir.MIR_OP_VREG && kept[1].vreg.n == 0;
}

test drop_self_copies__at_every_width_and_machine {
    var isa: [3]str;
    var abi: [3]str;
    isa[0] = "x86_64";
    abi[0] = "sysv64";
    isa[1] = "aarch64";
    abi[1] = "aapcs64";
    isa[2] = "riscv64";
    abi[2] = "lp64d";

    var i: usize = 0;
    for (i < 3) {
        val tr: res[lang_target.Binding, fail.Fail] = lang_target.t_select(isa[i], "linux", abi[i]);
        if (sel tr.err) { ret 1; }
        var t: lang_target.Binding = tr.ok;

        var w:      usize = 0;
        var widths: [4]u8;
        widths[0] = 1;
        widths[1] = 2;
        widths[2] = 4;
        widths[3] = 8;
        for (w < 4) {
            if (!t_self_copy_is_dropped(?t, widths[w])) { ret 1; }
            w = w + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test drop_self_copies__passes_bindings_on {
    var t: lang_target.Binding;
    if (!regalloc_context.t_target(?t)) { ret 1; }
    var alloc: A.Allocator;
    page.make(?alloc);

    # self copy (bound), self copy (bound), a kept copy that already has a binding
    var f: lang_mir.MirFunction;
    lang_mir.vregs_gp(?alloc, ?f, 3);
    var b: lang_mir.MirBlock;
    lang_mir.instrs_blank(?alloc, ?b, 3);
    regalloc_context.t_mov(?alloc, ?b, 0, lang_mir.op_vreg(lang_mir.vreg_id(1)), lang_mir.op_vreg(lang_mir.vreg_id(1)));
    regalloc_context.t_mov(?alloc, ?b, 1, lang_mir.op_vreg(lang_mir.vreg_id(1)), lang_mir.op_vreg(lang_mir.vreg_id(1)));
    regalloc_context.t_mov(?alloc, ?b, 2, lang_mir.op_vreg(lang_mir.vreg_id(2)), lang_mir.op_vreg(lang_mir.vreg_id(0)));
    f.blocks      = ?b;
    f.block_count = 1;
    f.block_cap   = 1;
    if (!regalloc_context.t_dbg(?alloc, ?b.instrs[0], 10, 1)) { ret 1; }
    if (!regalloc_context.t_dbg(?alloc, ?b.instrs[1], 11, 1)) { ret 1; }
    if (!regalloc_context.t_dbg(?alloc, ?b.instrs[2], 12, 2)) { ret 1; }

    var slots: [3]bool;
    slots[0] = false;
    slots[1] = false;
    slots[2] = false;
    var ctx: regalloc_context.Context;
    regalloc_context.t_ctx(?ctx, ?alloc, ?f, ?slots[0]);
    val rd: err[fail.Fail] = drop_self_copies(?t, ?ctx, lang_mir.MIR_OP_VREG);
    if (sel rd.err)         { ret 2; }
    if (b.instr_count != 1) { ret 3; }
    val kept: *lang_mir.MirInstr = ?b.instrs[0];
    if (kept.dbg_binding_count != 3)    { ret 4; }
    if (kept.dbg_bindings[0].iid != 10) { ret 5; }
    if (kept.dbg_bindings[1].iid != 11) { ret 5; }
    if (kept.dbg_bindings[2].iid != 12) { ret 5; }
    if (kept.dbg_bindings[0].vreg != 1) { ret 6; }

    # a self copy that ends its block has nowhere to pass a binding, and says so
    var b2: lang_mir.MirBlock;
    lang_mir.instrs_blank(?alloc, ?b2, 1);
    regalloc_context.t_mov(?alloc, ?b2, 0, lang_mir.op_vreg(lang_mir.vreg_id(1)), lang_mir.op_vreg(lang_mir.vreg_id(1)));
    if (!regalloc_context.t_dbg(?alloc, ?b2.instrs[0], 13, 1)) { ret 1; }
    f.blocks = ?b2;
    val rd2: err[fail.Fail] = drop_self_copies(?t, ?ctx, lang_mir.MIR_OP_VREG);
    if (sel rd2.ok) { ret 7; }
    ret 0;
}

test sweep_dead_movs__passes_bindings_on {
    var t: lang_target.Binding;
    if (!regalloc_context.t_target(?t)) { ret 1; }
    var alloc: A.Allocator;
    page.make(?alloc);

    # v1 is written and never read, so its copy is dead; v2 is read by the last copy
    var f: lang_mir.MirFunction;
    lang_mir.vregs_gp(?alloc, ?f, 3);
    var b: lang_mir.MirBlock;
    lang_mir.instrs_blank(?alloc, ?b, 3);
    regalloc_context.t_mov(?alloc, ?b, 0, lang_mir.op_vreg(lang_mir.vreg_id(1)), lang_mir.op_vreg(lang_mir.vreg_id(0)));
    regalloc_context.t_mov(?alloc, ?b, 1, lang_mir.op_vreg(lang_mir.vreg_id(2)), lang_mir.op_vreg(lang_mir.vreg_id(0)));
    regalloc_context.t_mov(?alloc, ?b, 2, lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0))), lang_mir.op_vreg(lang_mir.vreg_id(2)));
    f.blocks      = ?b;
    f.block_count = 1;
    f.block_cap   = 1;
    if (!regalloc_context.t_dbg(?alloc, ?b.instrs[0], 20, 0)) { ret 1; }

    var slots: [3]bool;
    slots[0] = false;
    slots[1] = false;
    slots[2] = false;
    var ctx: regalloc_context.Context;
    regalloc_context.t_ctx(?ctx, ?alloc, ?f, ?slots[0]);
    val rs: err[fail.Fail] = sweep_dead_movs(?t, ?ctx);
    if (sel rs.err)                            { ret 2; }
    if (b.instr_count != 2)                    { ret 3; }
    if (b.instrs[0].operands[0].vreg.n != 2)   { ret 3; }
    if (b.instrs[0].dbg_binding_count != 1)    { ret 4; }
    if (b.instrs[0].dbg_bindings[0].iid != 20) { ret 5; }
    if (b.instrs[1].dbg_binding_count != 0)    { ret 6; }
    ret 0;
}

test drop_self_copies__physical_only_the_same_register {
    var t: lang_target.Binding;
    if (!regalloc_context.t_target(?t)) { ret 1; }
    var alloc: A.Allocator;
    page.make(?alloc);

    var f: lang_mir.MirFunction;
    lang_mir.vregs_gp(?alloc, ?f, 1);
    var b: lang_mir.MirBlock;
    lang_mir.instrs_blank(?alloc, ?b, 3);
    regalloc_context.t_mov(?alloc, ?b, 0, lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 3))), lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 3))));
    regalloc_context.t_mov(?alloc, ?b, 1, lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 4))), lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 5))));
    regalloc_context.t_mov(?alloc, ?b, 2, lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 6))), lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 6))));
    f.blocks      = ?b;
    f.block_count = 1;
    f.block_cap   = 1;

    var slots: [1]bool;
    slots[0] = false;
    var ctx: regalloc_context.Context;
    regalloc_context.t_ctx(?ctx, ?alloc, ?f, ?slots[0]);

    val rd: err[fail.Fail] = drop_self_copies(?t, ?ctx, lang_mir.MIR_OP_PREG);
    if (sel rd.err) { ret 1; }

    if (b.instr_count != 1) { ret 1; }
    val kept: *lang_mir.MirOperand = b.instrs[0].operands;
    if (kept[0].kind != lang_mir.MIR_OP_PREG || kept[0].preg.n != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 4)::u32) { ret 1; }
    if (kept[1].kind != lang_mir.MIR_OP_PREG || kept[1].preg.n != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 5)::u32) { ret 1; }
    ret 0;
}

# the result of a commutative op is hinted onto a right operand dying there
# when the left one lives on, and a non-commutative op takes no such hint
test maybe_tie_hint__a_dying_right_operand_of_a_commutative_op {
    var t: regalloc_context.TRewrite;
    if (!regalloc_context.t_rewrite_init(?t)) { ret 1; }
    fin { regalloc_context.t_rewrite_dnit(?t); }
    t.ranges[2].end_pos = 0;
    regalloc_context.t_hull_segs(?t.ctx, 4);
    var add: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_MOV, nil, 0, 8, 8);
    if (!regalloc_context.t_instr(?t, lang_mir.MIR_SEL_ADD, regalloc_context.t_v(0), regalloc_context.t_v(1), regalloc_context.t_v(2), 3, ?add)) { ret 2; }
    maybe_tie_hint(?t.ctx, ?add, 0, 4);
    if (t.hints[0].src_vreg != 2 || t.hints[0].copy_pos != 0) { ret 3; }

    t.hints[0].src_vreg = lang_mir.MIR_VREG_NIL.n;
    t.hints[0].copy_pos = -1;
    var sub: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_MOV, nil, 0, 8, 8);
    if (!regalloc_context.t_instr(?t, lang_mir.MIR_SEL_SUB, regalloc_context.t_v(0), regalloc_context.t_v(1), regalloc_context.t_v(2), 3, ?sub)) { ret 4; }
    maybe_tie_hint(?t.ctx, ?sub, 0, 4);
    if (t.hints[0].src_vreg != lang_mir.MIR_VREG_NIL.n) { ret 5; }

    t.ranges[1].end_pos = 0;
    regalloc_context.t_hull_segs(?t.ctx, 4);
    maybe_tie_hint(?t.ctx, ?add, 0, 4);
    if (t.hints[0].src_vreg != 1) { ret 6; }
    ret 0;
}
