# the allocation's own contracts, checked after the scan and the rewrite: no
# two values on one register meet, every assigned register is a usable one of
# its value's bank, and every rewritten operand names a register of its bank
use mach.lang.fail;
use mach.lang.intern;
use lang_mir:       mach.lang.mir;
use lang_target:    mach.lang.target;
use isa_inst:       mach.lang.target.isa.inst;
use isa_rules:      mach.lang.target.isa.rules;
use target_testing: mach.lang.target.testing;
use A:              std.allocator;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use regalloc_context: mach.lang.be.codegen.regalloc.context;
use mach.lang.be.codegen.regalloc.liveness;
use mach.lang.be.codegen.regalloc.rewrite;
use regalloc_scan: mach.lang.be.codegen.regalloc.scan;

fun rewritten_preg_ok(tgt: *lang_target.Binding, preg: lang_mir.PRegId) bool {
    val rid:    i32 = lang_mir.preg_regid(preg);
    val rclass: i32 = isa_inst.regid_class(rid);
    val ridx:   i32 = isa_inst.regid_index(rid);
    if (ridx < 0) { ret false; }
    if (rclass == isa_inst.REG_CLASS_ID_GP) {
        if (ridx::u32 < regalloc_context.bank_count(tgt, regalloc_context.REG_CLASS_GP)) { ret true; }
        ret special_gp_register(tgt, rid);
    }
    if (rclass == isa_inst.REG_CLASS_ID_FP) { ret ridx::u32 < regalloc_context.bank_count(tgt, regalloc_context.fp_class_index(tgt)); }
    ret false;
}

# a general register outside the allocatable bank that a rewritten operand may
# still name: the stack and frame pointers and the reserved registers
fun special_gp_register(tgt: *lang_target.Binding, rid: i32) bool {
    if (rid == tgt.arch.stack_ptr_reg || rid == tgt.arch.frame_ptr_reg) { ret true; }
    if (rid < 0 || rid >= 32)                                           { ret false; }
    ret (tgt.reserved_gp & (1::u32 << rid::u32)) != 0;
}

pub fun rewritten_operands(tgt: *lang_target.Binding, f: *lang_mir.MirFunction) err[fail.Fail] {
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *lang_mir.MirBlock = ?f.blocks[bi];
        var ii:  u32                = 0;
        for (ii < blk.instr_count) {
            val mi: *lang_mir.MirInstr = ?blk.instrs[ii];
            var k:  u32                = 0;
            for (k < mi.operand_count) {
                val op: *lang_mir.MirOperand = ?mi.operands[k];
                if (op.kind == lang_mir.MIR_OP_VREG) {
                    ret err[fail.Fail].err{fail.message("regalloc: a virtual register survived rewriting")};
                }
                if (op.kind == lang_mir.MIR_OP_PREG && !rewritten_preg_ok(tgt, op.preg)) {
                    ret err[fail.Fail].err{fail.message("regalloc: a rewritten operand names a physical register outside every register class")};
                }
                if (op.kind == lang_mir.MIR_OP_PREG && !rewrite.operand_bank_matches(op)) {
                    ret err[fail.Fail].err{fail.message("regalloc: a rewritten register operand violates its selected bank constraint")};
                }
                if (op.kind == lang_mir.MIR_OP_MEM) {
                    if (lang_mir.vreg_is_nil(op.vreg)
                        && (!rewritten_preg_ok(tgt, op.preg) || isa_inst.regid_class(lang_mir.preg_regid(op.preg)) != isa_inst.REG_CLASS_ID_GP)) {
                        ret err[fail.Fail].err{fail.message("regalloc: a rewritten memory base is not a valid general-bank register")};
                    }
                    if (sel op.index.preg
                        && (!rewritten_preg_ok(tgt, op.index.preg) || isa_inst.regid_class(lang_mir.preg_regid(op.index.preg)) != isa_inst.REG_CLASS_ID_GP)) {
                        ret err[fail.Fail].err{fail.message("regalloc: a rewritten memory index is not a valid general-bank register")};
                    }
                }
                k = k + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

# two values assigned one register never meet: the allocation's own
# contract, checked after every scan so a wrong assignment is a refusal and
# not a miscompile. intervals are sorted by start and each is compared with
# the earlier ones on its register whose hull still reaches it
pub fun interference(ctx: *regalloc_context.Context) err[fail.Fail] {
    val nv: u32 = ctx.f.vreg_count;
    if (nv == 0) { ret err[fail.Fail].ok{}; }
    val ro: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, nv::usize);
    if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
    val order: *u32 = ro.ok;
    fin { A.deallocate[u32](ctx.alloc, order, nv::usize); }
    var i: u32 = 0;
    for (i < nv) {
        order[i] = i;
        i        = i + 1;
    }
    val sb: err[fail.Fail] = regalloc_scan.sort_by_start(ctx, order, nv);
    if (sel sb.err) { ret sb; }

    val ropen: res[*u32, A.Error] = A.allocate[u32](ctx.alloc, nv::usize);
    if (sel ropen.err) { ret err[fail.Fail].err{fail.refused(ropen.err)}; }
    val open:       *u32 = ropen.ok;
    var open_count: u32  = 0;
    fin { A.deallocate[u32](ctx.alloc, open, nv::usize); }

    i = 0;
    for (i < nv) {
        val v:  u32                         = order[i];
        val lr: *regalloc_context.LiveRange = ?ctx.ranges[v];
        val a:  lang_mir.PRegId             = ctx.f.vregs[v].assigned;
        if (lr.end_pos < 0 || lang_mir.preg_is_nil(a) || ctx.spilled[v]) {
            i = i + 1;
            cnt;
        }
        var write: u32 = 0;
        var read:  u32 = 0;
        for (read < open_count) {
            val y:  u32                         = open[read];
            val yr: *regalloc_context.LiveRange = ?ctx.ranges[y];
            if (yr.end_pos >= lr.start) {
                open[write] = y;
                write       = write + 1;
                if (yr.reg_class == lr.reg_class && lang_mir.preg_same(ctx.f.vregs[y].assigned, a) && liveness.intersects(ctx, lr, yr)) {
                    ret err[fail.Fail].err{regalloc_context.fail_for(ctx, "regalloc: two live values were assigned one register in '", "' (internal compiler error)", "regalloc: two live values were assigned one register (internal compiler error)")};
                }
            }
            read = read + 1;
        }
        open_count       = write;
        open[open_count] = v;
        open_count       = open_count + 1;
        i                = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun allocation(tgt: *lang_target.Binding, ctx: *regalloc_context.Context) err[fail.Fail] {
    var v: u32 = 0;
    for (v < ctx.f.vreg_count) {
        val mv: *lang_mir.MirVReg = ?ctx.f.vregs[v];
        if (lang_mir.preg_is_nil(mv.assigned)) {
            v = v + 1;
            cnt;
        }
        val lr: *regalloc_context.LiveRange = ?ctx.ranges[v];

        val rid:    i32 = lang_mir.preg_regid(mv.assigned);
        val rclass: i32 = isa_inst.regid_class(rid);
        val ridx:   i32 = isa_inst.regid_index(rid);

        if (lr.reg_class == regalloc_context.REG_CLASS_GP) {
            if (rclass != isa_inst.REG_CLASS_ID_GP || ridx < 0 || ridx::u32 >= ctx.gp_count) {
                ret err[fail.Fail].err{regalloc_context.fail_for(ctx, "regalloc: invalid GP register id assigned in '", "'", "regalloc: invalid GP register id assigned")};
            }
            if (ctx.reserved[ridx::u32]) {
                ret err[fail.Fail].err{regalloc_context.fail_for(ctx, "regalloc: a reserved register was assigned in '", "'", "regalloc: a reserved register was assigned")};
            }
        }
        or {
            if (rclass != isa_inst.REG_CLASS_ID_FP || ridx < 0 || ridx::u32 >= ctx.fp_count) {
                ret err[fail.Fail].err{regalloc_context.fail_for(ctx, "regalloc: invalid FP register id assigned in '", "'", "regalloc: invalid FP register id assigned")};
            }
        }
        v = v + 1;
    }
    ret err[fail.Fail].ok{};
}

test allocation__class_and_reservation {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var reg:        lang_target.TargetRegistry = lang_target.registry_init();
    val registered: err[fail.Fail]             = lang_target.register_all(?reg, ?target_testing.DEBUG);
    if (sel registered.err) { ret 1; }
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: lang_target.Binding = tr.ok;

    var vregs: [2]lang_mir.MirVReg;
    vregs[0]          = lang_mir.vreg(0, regalloc_context.REG_CLASS_GP, 0, false);
    vregs[0].assigned = lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 2));
    vregs[1]          = lang_mir.vreg(1, 1, 0, false);
    vregs[1].assigned = lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 0));
    var f: lang_mir.MirFunction;
    f.name       = intern.STR_NIL;
    f.vregs      = ?vregs[0];
    f.vreg_count = 2;
    var ranges: [2]regalloc_context.LiveRange;
    ranges[0].reg_class = regalloc_context.REG_CLASS_GP;
    ranges[1].reg_class = 1;
    var reserved: [4]bool         = [4]bool{false, false, false, false};
    var itn:      intern.Interner = intern.init(?alloc);
    var ctx:      regalloc_context.Context;
    ctx.alloc    = ?alloc;
    ctx.interner = ?itn;
    ctx.f        = ?f;
    ctx.ranges   = ?ranges[0];
    ctx.gp_count = 4;
    ctx.fp_count = 4;
    ctx.reserved = ?reserved[0];

    val ok: err[fail.Fail] = allocation(?tgt, ?ctx);
    if (sel ok.err) { ret 2; }
    reserved[2] = true;
    val held: err[fail.Fail] = allocation(?tgt, ?ctx);
    if (sel held.ok) { ret 3; }
    reserved[2]       = false;
    vregs[0].assigned = lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 0));
    val crossed: err[fail.Fail] = allocation(?tgt, ?ctx);
    if (sel crossed.ok) { ret 4; }
    ret 0;
}

test rewritten_operands__register_ranges_and_classes {
    var reg:    lang_target.TargetRegistry = lang_target.registry_init();
    val r_3929: err[fail.Fail]             = lang_target.register_all(?reg, ?target_testing.DEBUG);
    if (sel r_3929.err) { ret 1; }
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt: lang_target.Binding = tr.ok;
    val gp:  u32                 = regalloc_context.bank_count(?tgt, regalloc_context.REG_CLASS_GP);

    var ops: [2]lang_mir.MirOperand;
    ops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1)));
    ops[1] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 3)));
    var ins: [1]lang_mir.MirInstr;
    ins[0] = lang_mir.instr(lang_mir.MIR_MOV, ?ops[0], 2, 8, 8);
    var blk: [1]lang_mir.MirBlock;
    blk[0].instrs      = ?ins[0];
    blk[0].instr_count = 1;
    var f: lang_mir.MirFunction;
    f.blocks      = ?blk[0];
    f.block_count = 1;

    val capture_operand_banks_r: err[fail.Fail] = isa_rules.capture_operand_banks(?f, ?ins[0]);
    if (sel capture_operand_banks_r.err) { ret 1; }
    val verify_rewritten_operands_r: err[fail.Fail] = rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r.err) { ret 1; }
    ops[1] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, (gp + 40)::i32)));
    val verify_rewritten_operands_r2: err[fail.Fail] = rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r2.ok) { ret 2; }
    ops[1] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(7, 0)));
    val verify_rewritten_operands_r3: err[fail.Fail] = rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r3.ok) { ret 3; }
    ops[1] = lang_mir.op_vreg(lang_mir.vreg_id(0));
    val verify_rewritten_operands_r4: err[fail.Fail] = rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r4.ok) { ret 4; }
    ops[1] = lang_mir.op_mem_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, (gp + 40)::i32)), 0);
    val verify_rewritten_operands_r5: err[fail.Fail] = rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r5.ok) { ret 5; }
    ops[1] = lang_mir.op_mem_preg(lang_mir.preg_id(tgt.arch.stack_ptr_reg), 0);
    val verify_rewritten_operands_r6: err[fail.Fail] = rewritten_operands(?tgt, ?f);
    if (sel verify_rewritten_operands_r6.err) { ret 6; }
    ret 0;
}

#[testing]
pub fun t_verify_bank_slots(tgt: *lang_target.Binding, opcode: lang_mir.MirOpcode, bank0: lang_mir.OperandBank,
    bank1: lang_mir.OperandBank, bank2: lang_mir.OperandBank, count: u32, vector: bool) i32 {
    var expected: [3]lang_mir.OperandBank;
    expected[0] = bank0;
    expected[1] = bank1;
    expected[2] = bank2;
    var ops: [3]lang_mir.MirOperand;
    var k:   u32 = 0;
    for (k < count) {
        var class: i32 = isa_inst.REG_CLASS_ID_GP;
        if (expected[k] == lang_mir.BANK_FP) { class = isa_inst.REG_CLASS_ID_FP; }
        ops[k] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(class, 1 + k::i32)));
        k      = k + 1;
    }
    var mi: lang_mir.MirInstr = lang_mir.instr(opcode, ?ops[0], count, 8, 8);
    if (vector) { mi.vec_lane = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 4, 4); }
    var blk: lang_mir.MirBlock;
    blk.instrs      = ?mi;
    blk.instr_count = 1;
    var f: lang_mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    val capture_operand_banks_r: err[fail.Fail] = isa_rules.capture_operand_banks(?f, ?mi);
    if (sel capture_operand_banks_r.err) { ret 1; }
    val verify_rewritten_operands_r: err[fail.Fail] = rewritten_operands(tgt, ?f);
    if (sel verify_rewritten_operands_r.err) { ret 2; }
    k = 0;
    for (k < count) {
        val original: lang_mir.PRegId = ops[k].preg;
        var wrong:    i32             = isa_inst.REG_CLASS_ID_FP;
        if (expected[k] == lang_mir.BANK_FP) { wrong = isa_inst.REG_CLASS_ID_GP; }
        ops[k].preg = lang_mir.preg_id(isa_inst.regid_make(wrong, 1 + k::i32));
        val verify_rewritten_operands_r2: err[fail.Fail] = rewritten_operands(tgt, ?f);
        if (sel verify_rewritten_operands_r2.ok) { ret 3; }
        ops[k].preg = original;
        k           = k + 1;
    }
    ops[0].required_bank = lang_mir.BANK_UNKNOWN;
    val verify_rewritten_operands_r3: err[fail.Fail] = rewritten_operands(tgt, ?f);
    if (sel verify_rewritten_operands_r3.ok) { ret 4; }
    ret 0;
}
