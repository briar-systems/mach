# the scan order: the blocks are permuted into the order the scan walks and
# put back in their original order once the rewrite is done
use mach.lang.fail;
use lang_mir: mach.lang.mir;
use mach.lang.mir.flow;
use A: std.allocator;
use std.allocator.page;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use regalloc_context: mach.lang.be.codegen.regalloc.context;

# the scan order is the reverse postorder from the entry, then the blocks it
# does not reach in their own order
pub fun build(ctx: *regalloc_context.Context) err[fail.Fail] {
    val rg: err[fail.Fail] = graph_rebuild(ctx);
    if (sel rg.err) { ret rg; }
    flow.scan_order_fill(?ctx.graph, ctx.order);
    ret err[fail.Fail].ok{};
}

fun graph_rebuild(ctx: *regalloc_context.Context) err[fail.Fail] {
    if (ctx.graph_built) {
        flow.dnit(?ctx.graph);
        ctx.graph_built = false;
    }
    val rg: res[flow.Graph, fail.Fail] = flow.init(ctx.alloc, ctx.f);
    if (sel rg.err) { ret err[fail.Fail].err{rg.err}; }
    ctx.graph       = rg.ok;
    ctx.graph_built = true;
    ret err[fail.Fail].ok{};
}

pub fun apply(ctx: *regalloc_context.Context) err[fail.Fail] {
    val f: *lang_mir.MirFunction = ctx.f;
    val n: u32                   = f.block_count;
    if (n <= 1) { ret err[fail.Fail].ok{}; }

    val rt: res[*lang_mir.MirBlock, A.Error] = A.allocate[lang_mir.MirBlock](ctx.alloc, n::usize);
    if (sel rt.err) { ret err[fail.Fail].err{fail.refused(rt.err)}; }
    val tmp: *lang_mir.MirBlock = rt.ok;

    var i: u32 = 0;
    for (i < n) {
        tmp[i] = f.blocks[ctx.order[i]];
        i      = i + 1;
    }
    i = 0;
    for (i < n) {
        f.blocks[i] = tmp[i];
        i           = i + 1;
    }
    A.deallocate[lang_mir.MirBlock](ctx.alloc, tmp, n::usize);

    ret graph_rebuild(ctx);
}

pub fun restore(ctx: *regalloc_context.Context) err[fail.Fail] {
    val f: *lang_mir.MirFunction = ctx.f;
    val n: u32                   = f.block_count;
    if (n <= 1) { ret err[fail.Fail].ok{}; }

    val rt: res[*lang_mir.MirBlock, A.Error] = A.allocate[lang_mir.MirBlock](ctx.alloc, n::usize);
    if (sel rt.err) { ret err[fail.Fail].err{fail.refused(rt.err)}; }
    val tmp: *lang_mir.MirBlock = rt.ok;

    var i: u32 = 0;
    for (i < n) {
        tmp[ctx.order[i]] = f.blocks[i];
        i                 = i + 1;
    }
    i = 0;
    for (i < n) {
        f.blocks[i] = tmp[i];
        i           = i + 1;
    }
    A.deallocate[lang_mir.MirBlock](ctx.alloc, tmp, n::usize);

    ret err[fail.Fail].ok{};
}

test block_order__round_trips {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f:  lang_mir.MirFunction;
    val rb: res[*lang_mir.MirBlock, A.Error] = A.zallocate[lang_mir.MirBlock](?alloc, 4::usize);
    if (sel rb.err) { ret 1; }
    f.blocks      = rb.ok;
    f.block_count = 4;

    val ro0: res[*lang_mir.MirOperand, A.Error] = A.allocate[lang_mir.MirOperand](?alloc, 2::usize);
    if (sel ro0.err) { ret 1; }
    val ops0: *lang_mir.MirOperand = ro0.ok;
    ops0[0] = lang_mir.op_block(1);
    ops0[1] = lang_mir.op_block(3);

    val ri0: res[*lang_mir.MirInstr, A.Error] = A.zallocate[lang_mir.MirInstr](?alloc, 1::usize);
    if (sel ri0.err) { ret 1; }
    val instrs0: *lang_mir.MirInstr = ri0.ok;
    instrs0[0] = lang_mir.instr(lang_mir.MIR_CBR, ops0, 2, 0, 0);

    val ro1: res[*lang_mir.MirOperand, A.Error] = A.allocate[lang_mir.MirOperand](?alloc, 1::usize);
    if (sel ro1.err) { ret 1; }
    val ops1: *lang_mir.MirOperand = ro1.ok;
    ops1[0] = lang_mir.op_block(2);

    val ri1: res[*lang_mir.MirInstr, A.Error] = A.zallocate[lang_mir.MirInstr](?alloc, 1::usize);
    if (sel ri1.err) { ret 1; }
    val instrs1: *lang_mir.MirInstr = ri1.ok;
    instrs1[0] = lang_mir.instr(lang_mir.MIR_BR, ops1, 1, 0, 0);

    f.blocks[0].id          = 0;
    f.blocks[0].instrs      = instrs0;
    f.blocks[0].instr_count = 1;
    f.blocks[1].id          = 1;
    f.blocks[1].instrs      = instrs1;
    f.blocks[1].instr_count = 1;
    f.blocks[2].id          = 2;
    f.blocks[2].instr_count = 0;
    f.blocks[3].id          = 3;
    f.blocks[3].instr_count = 0;

    val ord_r: res[*u32, A.Error] = A.allocate[u32](?alloc, 4::usize);
    if (sel ord_r.err) { ret 1; }

    var ctx: regalloc_context.Context;
    ctx.alloc = ?alloc;
    ctx.f     = ?f;
    ctx.order = ord_r.ok;

    val build_order_r: err[fail.Fail] = build(?ctx);
    if (sel build_order_r.err)                                                            { ret 1; }
    if (ctx.order[0] != 0 || ctx.order[1] != 3 || ctx.order[2] != 1 || ctx.order[3] != 2) { ret 1; }

    val apply_order_r: err[fail.Fail] = apply(?ctx);
    if (sel apply_order_r.err)                                                                    { ret 1; }
    if (f.blocks[0].id != 0 || f.blocks[1].id != 3 || f.blocks[2].id != 1 || f.blocks[3].id != 2) { ret 1; }

    val restore_order_r: err[fail.Fail] = restore(?ctx);
    if (sel restore_order_r.err)                                                                  { ret 1; }
    if (f.blocks[0].id != 0 || f.blocks[1].id != 1 || f.blocks[2].id != 2 || f.blocks[3].id != 3) { ret 1; }

    ret 0;
}
