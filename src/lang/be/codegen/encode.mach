use std.format;
use std.io.writer;
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.allocator.page;
use std.collections.map;
use std.memory;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.be.codegen.mir;
use mach.lang.be.codegen.encoding;
use mach.lang.intern;
use mach.lang.layout;
use mach.lang.source;
use mach.lang.target.isa;
use mach.lang.target.of;
use target: mach.lang.target.resolved;

pub def EncoderOutput: encoding.EncoderOutput;
pub def LineRow:       encoding.LineRow;
pub def InlinePc:      encoding.InlinePc;
pub def VarLoc:        encoding.VarLoc;

pub val VARLOC_NONE:  u8 = encoding.VARLOC_NONE;
pub val VARLOC_REG:   u8 = encoding.VARLOC_REG;
pub val VARLOC_FRAME: u8 = encoding.VARLOC_FRAME;

fun varloc_slot_off(fn: *mir.MirFunction, si: u32) i64 {
    if (fn.frame.realign != 0) {
        ret fn.frame.base_dist::i64 + fn.frame.slots[si].offset;
    }
    ret fn.frame.slots[si].offset - fn.frame.fp_dist::i64;
}
pub val VARLOC_CMP:   u8 = encoding.VARLOC_CMP;
pub val VARLOC_IMM:   u8 = encoding.VARLOC_IMM;

pub val CMPREL_EQ: u8 = encoding.CMPREL_EQ;
pub val CMPREL_NE: u8 = encoding.CMPREL_NE;
pub val CMPREL_LT: u8 = encoding.CMPREL_LT;
pub val CMPREL_LE: u8 = encoding.CMPREL_LE;

pub def PendingReloc: encoding.PendingReloc;
pub def SymbolMark:   encoding.SymbolMark;

pub val CONST_F32: u8 = encoding.CONST_F32;
pub val CONST_F64: u8 = encoding.CONST_F64;
pub val CONST_VEC: u8 = encoding.CONST_VEC;

pub def ConstEntry: encoding.ConstEntry;

pub fun run(tgt: *target.Target, m: *mir.MirModule,
            asm_out: *writer.Writer) R.Result[EncoderOutput, str] {
    if (tgt == nil) { ret R.err[EncoderOutput, str]("encode: nil target"); }
    if (m == nil)   { ret R.err[EncoderOutput, str]("encode: nil mir module"); }
    if (tgt.arch == nil) {
        ret R.err[EncoderOutput, str]("encode: target has no ISA vtable");
    }
    if (tgt.arch.encode == nil) {
        ret R.err[EncoderOutput, str]("encode: ISA registered no encoder");
    }

    if (asm_out != nil) {
        if (!tgt.arch.has_assembly) {
            ret R.err[EncoderOutput, str]("--emit-asm: the target architecture registered no assembly printer");
        }
        var backend_target: isa.BackendTarget = target.backend_target(tgt);
        ret tgt.arch.assembly.emit(m.alloc, ?backend_target, m, asm_out);
    }

    var backend_target: isa.BackendTarget = target.backend_target(tgt);
    ret tgt.arch.encode(m.alloc, ?backend_target, m);
}

val BYTEBUF_INIT_CAP: usize = 256;

pub rec ByteBuf {
    data:  *u8;
    len:   usize;
    cap:   usize;
    alloc: *A.Allocator;
    asm:   *AsmSink;
}

pub rec AsmSink {
    out:        *writer.Writer;
    accounted:  usize;
    failed:     bool;
    err:        str;
    mi:         *mir.MirInstr;
    interner:   *intern.Interner;
    notes:      *AsmNote;
    note_count: u32;
    note_cap:   u32;
    note_insts: u32;
    claims:     u32;
    refused:    u32;
}

pub val ASM_NOTE_INST:  u8 = 0;
pub val ASM_NOTE_FUNC:  u8 = 1;
pub val ASM_NOTE_BLOCK: u8 = 2;
pub val ASM_NOTE_BYTES: u8 = 3;

pub val ASM_NOTE_BYTES_WIDTH: usize = 4;

pub rec AsmNote {
    kind:  u8;
    off:   u32;
    inst:  isa.Inst;
    name:  intern.StrId;
    id:    u32;
    bytes: [ASM_NOTE_BYTES_WIDTH]u8;
}

val ASM_NOTE_INIT_CAP: u32 = 64;

pub fun sink_init(out: *writer.Writer, interner: *intern.Interner) AsmSink {
    var s: AsmSink;
    s.out        = out;
    s.accounted  = 0;
    s.failed     = false;
    s.err        = "";
    s.mi         = nil;
    s.interner   = interner;
    s.notes      = nil;
    s.note_count = 0;
    s.note_cap   = 0;
    s.note_insts = 0;
    s.claims     = 0;
    s.refused    = 0;
    ret s;
}

pub fun note_blank() AsmNote {
    var n: AsmNote;
    n.kind = ASM_NOTE_INST;
    n.off  = 0;
    n.inst = isa.inst_blank();
    n.name = intern.STR_NIL;
    n.id   = 0;
    ret n;
}

pub fun note_push(buf: *ByteBuf, n: *AsmNote) R.Result[R.Void, str] {
    if (!sink_active(buf)) { ret R.ok_void[str](); }
    val s: *AsmSink = buf.asm;
    if (s.note_count >= s.note_cap) {
        val res_grow: R.Result[R.Void, str] = grow_notes(s, buf.alloc);
        if (R.is_err[R.Void, str](res_grow)) { ret res_grow; }
    }
    s.notes[s.note_count] = @n;
    s.note_count = s.note_count + 1;
    if (n.kind == ASM_NOTE_INST || n.kind == ASM_NOTE_BYTES) {
        s.note_insts = s.note_insts + 1;
        sink_claim(buf, n.off::usize);
    }
    ret R.ok_void[str]();
}

pub fun note_insert_after(buf: *ByteBuf, idx: u32, n: *AsmNote, nbytes: u32) R.Result[R.Void, str] {
    if (!sink_active(buf)) { ret R.ok_void[str](); }
    val s: *AsmSink = buf.asm;
    if (idx >= s.note_count) {
        ret R.err[R.Void, str]("--emit-asm: an instruction notification was inserted after an unknown one");
    }
    if (n.kind == ASM_NOTE_INST && s.accounted + nbytes::usize != buf.len) {
        ret R.err[R.Void, str]("--emit-asm: an inserted instruction notification does not cover the text gap that was opened for it");
    }
    if (s.note_count >= s.note_cap) {
        val res_grow: R.Result[R.Void, str] = grow_notes(s, buf.alloc);
        if (R.is_err[R.Void, str](res_grow)) { ret res_grow; }
    }
    var i: u32 = s.note_count;
    val at: u32 = idx + 1;
    for (i > at) {
        s.notes[i] = s.notes[i - 1];
        i = i - 1;
    }
    s.notes[at] = @n;
    s.note_count = s.note_count + 1;
    if (n.kind == ASM_NOTE_INST) {
        s.note_insts = s.note_insts + 1;
        s.claims     = s.claims + 1;
        s.accounted  = buf.len;
    }
    ret R.ok_void[str]();
}

pub fun note_count(buf: *ByteBuf) u32 {
    if (!sink_active(buf)) { ret 0; }
    ret buf.asm.note_count;
}

pub fun note_at(buf: *ByteBuf, idx: u32) *AsmNote {
    if (!sink_active(buf)) { ret nil; }
    if (idx >= buf.asm.note_count) { ret nil; }
    ret ?buf.asm.notes[idx];
}

pub fun note_index_at(buf: *ByteBuf, off: u32) i32 {
    if (!sink_active(buf)) { ret -1; }
    val s: *AsmSink = buf.asm;
    var i: u32 = 0;
    for (i < s.note_count) {
        if (s.notes[i].kind == ASM_NOTE_INST && s.notes[i].off == off) { ret i::i32; }
        i = i + 1;
    }
    ret -1;
}

pub fun notes_reset(buf: *ByteBuf) {
    if (buf == nil || buf.asm == nil) { ret; }
    buf.asm.note_count = 0;
    buf.asm.note_insts = 0;
}

pub fun note_inst_count(buf: *ByteBuf) u32 {
    if (!sink_active(buf)) { ret 0; }
    ret buf.asm.note_insts;
}

pub fun notes_free(buf: *ByteBuf) {
    if (buf == nil || buf.asm == nil) { ret; }
    val s: *AsmSink = buf.asm;
    if (s.notes == nil || s.note_cap == 0) { ret; }
    A.deallocate[AsmNote](buf.alloc, s.notes, s.note_cap::usize);
    s.notes      = nil;
    s.note_count = 0;
    s.note_cap   = 0;
    s.note_insts = 0;
}

fun grow_cap[T](alloc: *A.Allocator, data: **T, cap: *u32, init_cap: u32) R.Result[R.Void, str] {
    if (@data == nil) {
        val res_alloc: R.Result[*T, str] = A.allocate[T](alloc, init_cap::usize);
        if (R.is_err[*T, str](res_alloc)) { ret R.err[R.Void, str](R.unwrap_err[*T, str](res_alloc)); }
        @data = R.unwrap_ok[*T, str](res_alloc);
        @cap  = init_cap;
        ret R.ok_void[str]();
    }
    val current: layout.CheckedCount[T] = layout.count[T]((@cap)::usize);
    val required_r: R.Result[layout.CheckedCount[T], layout.CheckCause] =
        layout.count_add[T](current, layout.count[T](1::usize));
    if (R.is_err[layout.CheckedCount[T], layout.CheckCause](required_r)) {
        ret R.err[R.Void, str]("encode: growth count overflow");
    }
    val required: layout.CheckedCount[T] = R.unwrap_ok[layout.CheckedCount[T], layout.CheckCause](required_r);
    val grown_r: R.Result[layout.CheckedCount[T], layout.CheckCause] = layout.count_grow[T](current, required);
    if (R.is_err[layout.CheckedCount[T], layout.CheckCause](grown_r)) {
        ret R.err[R.Void, str]("encode: growth count overflow");
    }
    val new_cap_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
        R.unwrap_ok[layout.CheckedCount[T], layout.CheckCause](grown_r).value);
    if (R.is_err[u32, layout.CheckCause](new_cap_fits)) {
        ret R.err[R.Void, str]("encode: growth capacity exceeds the u32 limit");
    }
    val new_cap: u32 = R.unwrap_ok[u32, layout.CheckCause](new_cap_fits);
    val res_realloc: R.Result[*T, str] = A.reallocate[T](alloc, @data, (@cap)::usize, new_cap::usize);
    if (R.is_err[*T, str](res_realloc)) { ret R.err[R.Void, str](R.unwrap_err[*T, str](res_realloc)); }
    @data = R.unwrap_ok[*T, str](res_realloc);
    @cap  = new_cap;
    ret R.ok_void[str]();
}

fun grow_notes(s: *AsmSink, alloc: *A.Allocator) R.Result[R.Void, str] {
    ret grow_cap[AsmNote](alloc, ?s.notes, ?s.note_cap, ASM_NOTE_INIT_CAP);
}

pub fun sink_fail(buf: *ByteBuf, msg: str) {
    if (buf == nil || buf.asm == nil) { ret; }
    if (buf.asm.failed) { ret; }
    buf.asm.failed = true;
    buf.asm.err    = msg;
}

pub fun sink_active(buf: *ByteBuf) bool {
    if (buf == nil || buf.asm == nil) { ret false; }
    ret !buf.asm.failed;
}

pub fun sink_claim(buf: *ByteBuf, start: usize) {
    if (buf == nil || buf.asm == nil) { ret; }
    val s: *AsmSink = buf.asm;
    if (start != s.accounted || buf.len <= start) {
        s.refused = s.refused + 1;
        ret;
    }
    s.accounted = buf.len;
    s.claims    = s.claims + 1;
}

pub fun render_bytes_text(out: *writer.Writer, bytes: *u8, n: usize) R.Result[R.Void, str] {
    val ri: R.Result[usize, str] = format.write_str(out, "  .byte ");
    if (R.is_err[usize, str](ri)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](ri)); }
    var i: usize = 0;
    for (i < n) {
        if (i > 0) {
            val rc: R.Result[usize, str] = format.write_str(out, ", ");
            if (R.is_err[usize, str](rc)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](rc)); }
        }
        val rb: R.Result[usize, str] = format.write_str(out, "0x");
        if (R.is_err[usize, str](rb)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](rb)); }
        var hex: [3]u8;
        hex[0] = hex_digit((bytes[i] >> 4) & 0xF);
        hex[1] = hex_digit(bytes[i] & 0xF);
        hex[2] = 0;
        val rh: R.Result[usize, str] = format.write_str(out, (?hex[0])::str);
        if (R.is_err[usize, str](rh)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](rh)); }
        i = i + 1;
    }
    val rn: R.Result[usize, str] = format.write_str(out, "\n");
    if (R.is_err[usize, str](rn)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](rn)); }
    ret R.ok_void[str]();
}

pub fun render_bytes_directive(buf: *ByteBuf, bytes: *u8, n: usize, start: usize) R.Result[R.Void, str] {
    if (!sink_active(buf)) { ret R.ok_void[str](); }
    val res: R.Result[R.Void, str] = render_bytes_text(buf.asm.out, bytes, n);
    if (R.is_err[R.Void, str](res)) { ret res; }
    sink_claim(buf, start);
    ret R.ok_void[str]();
}

fun hex_digit(v: u8) u8 {
    if (v < 10) { ret 48 + v; }
    ret 87 + v;
}

pub fun sink_claims(buf: *ByteBuf) u32 {
    if (!sink_active(buf)) { ret 0; }
    ret buf.asm.claims;
}

pub fun sink_unaccounted(buf: *ByteBuf) usize {
    if (!sink_active(buf)) { ret 0; }
    if (buf.len <= buf.asm.accounted) { ret 0; }
    ret buf.len - buf.asm.accounted;
}

pub fun sink_set_mir(buf: *ByteBuf, mi: *mir.MirInstr) {
    if (buf == nil || buf.asm == nil) { ret; }
    buf.asm.mi = mi;
}

pub fun buf_init(alloc: *A.Allocator) ByteBuf {
    var buf: ByteBuf;
    buf.data  = nil;
    buf.len   = 0;
    buf.cap   = 0;
    buf.alloc = alloc;
    buf.asm   = nil;
    ret buf;
}

pub fun buf_dnit(buf: *ByteBuf) {
    if (buf == nil) { ret; }
    if (buf.data != nil && buf.cap > 0) {
        A.deallocate[u8](buf.alloc, buf.data, buf.cap);
        buf.data = nil;
    }
    buf.len = 0;
    buf.cap = 0;
}

pub fun emit_byte(buf: *ByteBuf, byte: u8) {
    if (buf.len >= buf.cap) {
        var new_cap: usize = BYTEBUF_INIT_CAP;
        if (buf.cap > 0) {
            val doubled: R.Result[layout.CheckedCount[layout.ByteUnit], layout.CheckCause] =
                layout.count_mul[layout.ByteUnit](layout.count[layout.ByteUnit](buf.cap), 2::usize);
            if (R.is_err[layout.CheckedCount[layout.ByteUnit], layout.CheckCause](doubled)) {
                panic("encode: byte buffer capacity overflow\n");
            }
            new_cap = R.unwrap_ok[layout.CheckedCount[layout.ByteUnit], layout.CheckCause](doubled).value;
        }
        val res_realloc: R.Result[*u8, str] = A.reallocate[u8](buf.alloc, buf.data, buf.cap, new_cap);
        if (R.is_err[*u8, str](res_realloc)) {
            panic("encode: byte buffer realloc failed\n");
        }
        buf.data = R.unwrap_ok[*u8, str](res_realloc);
        buf.cap  = new_cap;
    }
    buf.data[buf.len] = byte;
    buf.len = buf.len + 1;
}

pub fun emit_u16(buf: *ByteBuf, value: u16) {
    emit_byte(buf, (value & 0xFF)::u8);
    emit_byte(buf, ((value >> 8) & 0xFF)::u8);
}

pub fun emit_u32(buf: *ByteBuf, value: u32) {
    emit_byte(buf, (value & 0xFF)::u8);
    emit_byte(buf, ((value >> 8) & 0xFF)::u8);
    emit_byte(buf, ((value >> 16) & 0xFF)::u8);
    emit_byte(buf, ((value >> 24) & 0xFF)::u8);
}

pub fun emit_u64(buf: *ByteBuf, value: u64) {
    emit_u32(buf, (value & 0xFFFFFFFF)::u32);
    emit_u32(buf, ((value >> 32) & 0xFFFFFFFF)::u32);
}

val DRIVER_INIT_CAP: u32 = 16;

pub rec BranchFixup {
    patch_pos:    u32;
    next_ip:      u32;
    target_block: u32;
    fn_text_base: u32;
}

rec BlockOffset {
    fn_text_base: u32;
    block_id:     u32;
    offset:       u32;
}

pub rec RelocPairSite {
    reloc_index: u32;
    label:       intern.StrId;
}

pub rec EncodeState {
    alloc:       *A.Allocator;
    buf:         ByteBuf;
    syms:        *SymbolMark;
    sym_count:   u32;
    sym_cap:     u32;
    pcrel_label_count: u32;
    relocs:      *PendingReloc;
    reloc_count: u32;
    reloc_cap:   u32;
    reloc_pair_sites: map.Map[u64, RelocPairSite];
    fixups:      *BranchFixup;
    fixup_count: u32;
    fixup_cap:   u32;
    blocks:      *BlockOffset;
    block_count: u32;
    block_cap:   u32;
    rows:        *LineRow;
    row_count:   u32;
    row_cap:     u32;
    varlocs:     *VarLoc;
    varloc_count: u32;
    varloc_cap:  u32;
    inline_pcs:  *InlinePc;
    inline_pc_count: u32;
    inline_pc_cap:   u32;
    consts:      *ConstEntry;
    const_count: u32;
    const_cap:   u32;
    frames:      *of.FrameUnwind;
    frame_count: u32;
    frame_cap:   u32;
    last_inline_site: u32;
    next_block_id:  u32;
    has_next_block: bool;
    interner:    *intern.Interner;
    srcmap:      *source.SourceMap;
    model:       *isa.MachineModel;
    callee_saved: isa.RegFileFn;
    base_addr:    u64;
    page_size:    u64;
    stack_probe:  bool;
}

pub def EncodeFunctionFn: fun(*EncodeState, *mir.MirFunction) R.Result[R.Void, str];

pub def PatchBranchFn: fun(*EncodeState, *BranchFixup, u32) R.Result[R.Void, str];

pub rec EncodeHooks {
    encode_function: EncodeFunctionFn;
    patch_branch:    PatchBranchFn;
}

pub fun encode_driver(alloc: *A.Allocator, tgt: *isa.BackendTarget, m: *mir.MirModule, hooks: *EncodeHooks) R.Result[EncoderOutput, str] {
    ret encode_driver_asm(alloc, tgt, m, hooks, nil);
}

fun apply_emission_order_module(alloc: *A.Allocator, m: *mir.MirModule) R.Result[R.Void, str] {
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val ao: R.Result[R.Void, str] = apply_emission_order(alloc, ?m.functions[fi]);
        if (R.is_err[R.Void, str](ao)) { ret ao; }
        fi = fi + 1;
    }
    ret R.ok_void[str]();
}

fun apply_emission_order(alloc: *A.Allocator, f: *mir.MirFunction) R.Result[R.Void, str] {
    val n: u32 = f.block_count;
    if (n <= 1 || f.emit_order == nil) { ret R.ok_void[str](); }

    val rt: R.Result[*mir.MirBlock, str] = A.allocate[mir.MirBlock](alloc, n::usize);
    if (R.is_err[*mir.MirBlock, str](rt)) { ret R.err[R.Void, str](R.unwrap_err[*mir.MirBlock, str](rt)); }
    val tmp: *mir.MirBlock = R.unwrap_ok[*mir.MirBlock, str](rt);

    var i: u32 = 0;
    for (i < n) {
        tmp[i] = f.blocks[f.emit_order[i]];
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        f.blocks[i] = tmp[i];
        i = i + 1;
    }
    A.deallocate[mir.MirBlock](alloc, tmp, n::usize);

    i = 0;
    for (i < n) { f.emit_order[i] = i; i = i + 1; }

    ret R.ok_void[str]();
}

pub fun encode_driver_asm(alloc: *A.Allocator, tgt: *isa.BackendTarget, m: *mir.MirModule,
                          hooks: *EncodeHooks, asm_out: *writer.Writer) R.Result[EncoderOutput, str] {
    if (tgt == nil)   { ret R.err[EncoderOutput, str]("encode: nil target"); }
    if (m == nil)     { ret R.err[EncoderOutput, str]("encode: nil mir module"); }
    if (hooks == nil) { ret R.err[EncoderOutput, str]("encode: nil encode hooks"); }
    if (hooks.encode_function == nil) {
        ret R.err[EncoderOutput, str]("encode: ISA supplied no per-function encode hook");
    }
    if (hooks.patch_branch == nil) {
        ret R.err[EncoderOutput, str]("encode: ISA supplied no per-branch patch hook");
    }

    val res_layout: R.Result[R.Void, str] = apply_emission_order_module(alloc, m);
    if (R.is_err[R.Void, str](res_layout)) { ret R.err[EncoderOutput, str](R.unwrap_err[R.Void, str](res_layout)); }

    var st: EncodeState;
    state_init(?st, alloc, m, tgt);

    var sink: AsmSink = sink_init(asm_out, m.interner);
    if (asm_out != nil) { st.buf.asm = ?sink; }

    var fi: u32 = 0;
    for (fi < m.function_len) {
        st.last_inline_site = 0;
        val pre_sym_count: u32 = st.sym_count;
        val res_encode: R.Result[R.Void, str] = hooks.encode_function(?st, ?m.functions[fi]);
        if (R.is_err[R.Void, str](res_encode)) {
            notes_free(?st.buf);
            state_dnit(?st);
            ret R.err[EncoderOutput, str](R.unwrap_err[R.Void, str](res_encode));
        }
        if (st.sym_count > pre_sym_count) {
            st.syms[pre_sym_count].size = st.buf.len::u32 - st.syms[pre_sym_count].offset;
        }
        fi = fi + 1;
    }

    if (sink.failed) {
        notes_free(?st.buf);
        state_dnit(?st);
        ret R.err[EncoderOutput, str](sink.err);
    }
    if (sink.refused > 0) {
        notes_free(?st.buf);
        state_dnit(?st);
        ret R.err[EncoderOutput, str](
            "--emit-asm: an instruction notification claimed a byte range that does not begin where the previous one ended");
    }
    notes_free(?st.buf);

    map.dnit[u64, RelocPairSite](?st.reloc_pair_sites);
    val res_patch: R.Result[R.Void, str] = patch_branches(?st, hooks);
    if (R.is_err[R.Void, str](res_patch)) {
        state_dnit(?st);
        ret R.err[EncoderOutput, str](R.unwrap_err[R.Void, str](res_patch));
    }

    val res_shrink: R.Result[R.Void, str] = shrink_text(?st);
    if (R.is_err[R.Void, str](res_shrink)) {
        state_dnit(?st);
        ret R.err[EncoderOutput, str](R.unwrap_err[R.Void, str](res_shrink));
    }

    val res_pool: R.Result[R.Void, str] = shrink_consts(?st);
    if (R.is_err[R.Void, str](res_pool)) {
        state_dnit(?st);
        ret R.err[EncoderOutput, str](R.unwrap_err[R.Void, str](res_pool));
    }

    val res_syms: R.Result[R.Void, str] = shrink_syms(?st);
    if (R.is_err[R.Void, str](res_syms)) {
        state_dnit(?st);
        ret R.err[EncoderOutput, str](R.unwrap_err[R.Void, str](res_syms));
    }

    val res_relocs: R.Result[R.Void, str] = shrink_relocs(?st);
    if (R.is_err[R.Void, str](res_relocs)) {
        state_dnit(?st);
        ret R.err[EncoderOutput, str](R.unwrap_err[R.Void, str](res_relocs));
    }

    val res_rows: R.Result[R.Void, str] = shrink_rows(?st);
    if (R.is_err[R.Void, str](res_rows)) {
        state_dnit(?st);
        ret R.err[EncoderOutput, str](R.unwrap_err[R.Void, str](res_rows));
    }

    val res_varlocs: R.Result[R.Void, str] = shrink_varlocs(?st);
    if (R.is_err[R.Void, str](res_varlocs)) {
        state_dnit(?st);
        ret R.err[EncoderOutput, str](R.unwrap_err[R.Void, str](res_varlocs));
    }

    val res_inline_pcs: R.Result[R.Void, str] = shrink_inline_pcs(?st);
    if (R.is_err[R.Void, str](res_inline_pcs)) {
        state_dnit(?st);
        ret R.err[EncoderOutput, str](R.unwrap_err[R.Void, str](res_inline_pcs));
    }

    val res_frames: R.Result[R.Void, str] = shrink_frames(?st);
    if (R.is_err[R.Void, str](res_frames)) {
        state_dnit(?st);
        ret R.err[EncoderOutput, str](R.unwrap_err[R.Void, str](res_frames));
    }

    var out: EncoderOutput;
    out.text         = st.buf.data;
    out.text_len     = st.buf.len::u32;
    out.relocations  = st.relocs;
    out.reloc_count  = st.reloc_count;
    out.symbols      = st.syms;
    out.symbol_count = st.sym_count;
    out.rows         = st.rows;
    out.row_count    = st.row_count;
    out.inline_pcs   = st.inline_pcs;
    out.inline_pc_count = st.inline_pc_count;
    out.varlocs      = st.varlocs;
    out.varloc_count = st.varloc_count;
    out.consts       = st.consts;
    out.const_count  = st.const_count;
    out.frames       = st.frames;
    out.frame_count  = st.frame_count;

    scratch_release(?st);
    ret R.ok[EncoderOutput, str](out);
}

pub fun classify_refs(mi: *mir.MirInstr, target_block: *u32, has_block: *bool,
                      sym: *intern.StrId, has_sym: *bool, sym_addend: *i32) {
    @has_block    = false;
    @has_sym      = false;
    @target_block = 0;
    @sym          = intern.STR_NIL;
    @sym_addend   = 0;

    var found_block: bool = false;
    var found_sym:   bool = false;
    var i:           u32  = 0;
    for (i < mi.operand_count) {
        val op: *mir.MirOperand = ?mi.operands[i];
        if (op.kind == mir.MIR_OP_BLOCK && found_block == false) {
            found_block   = true;
            @has_block    = true;
            @target_block = op.imm::u32;
        }
        if (op.kind == mir.MIR_OP_SYM && found_sym == false) {
            found_sym   = true;
            @has_sym    = true;
            @sym        = op.sym;
            @sym_addend = op.sym_off;
        }
        if (found_block && found_sym) { brk; }
        i = i + 1;
    }
}

pub fun push_symbol(st: *EncodeState, name: intern.StrId, offset: u32, flags: u32) R.Result[R.Void, str] {
    if (st.sym_count >= st.sym_cap) {
        val res_grow: R.Result[R.Void, str] = grow_symbols(st);
        if (R.is_err[R.Void, str](res_grow)) { ret res_grow; }
    }
    st.syms[st.sym_count].name   = name;
    st.syms[st.sym_count].offset = offset;
    st.syms[st.sym_count].size   = 0;
    st.syms[st.sym_count].flags  = flags;
    st.sym_count = st.sym_count + 1;
    ret R.ok_void[str]();
}

pub fun push_frame(st: *EncodeState, offset: u32) R.Result[R.Void, str] {
    if (st.frame_count >= st.frame_cap) {
        val res_grow: R.Result[R.Void, str] = grow_frames(st);
        if (R.is_err[R.Void, str](res_grow)) { ret res_grow; }
    }
    st.frames[st.frame_count].section    = 0;
    st.frames[st.frame_count].offset     = offset;
    st.frames[st.frame_count].step_count = 0;
    st.frame_count = st.frame_count + 1;
    ret R.ok_void[str]();
}

pub fun push_frame_step(st: *EncodeState, kind: u8, reg: u8, end_off: u32, value: u64) R.Result[R.Void, str] {
    if (st.frame_count == 0) {
        ret R.err[R.Void, str]("encode: frame step recorded with no open frame record");
    }
    val fr: *of.FrameUnwind = ?st.frames[st.frame_count - 1];
    if (fr.step_count >= of.FRAME_STEP_CAP) {
        ret R.err[R.Void, str]("encode: frame record step capacity exceeded");
    }
    fr.steps[fr.step_count].kind    = kind;
    fr.steps[fr.step_count].reg     = reg;
    fr.steps[fr.step_count].end_off = end_off;
    fr.steps[fr.step_count].value   = value;
    fr.step_count = fr.step_count + 1;
    ret R.ok_void[str]();
}

fun grow_frames(st: *EncodeState) R.Result[R.Void, str] {
    ret grow_cap[of.FrameUnwind](st.alloc, ?st.frames, ?st.frame_cap, DRIVER_INIT_CAP);
}

pub fun push_reloc(st: *EncodeState, offset: u32, kind: of.RelocKind, sym: intern.StrId, addend: i32) R.Result[R.Void, str] {
    if (st.reloc_count >= st.reloc_cap) {
        val res_grow: R.Result[R.Void, str] = grow_relocs(st);
        if (R.is_err[R.Void, str](res_grow)) { ret res_grow; }
    }
    st.relocs[st.reloc_count].offset = offset;
    st.relocs[st.reloc_count].kind   = kind;
    st.relocs[st.reloc_count].sym    = sym;
    st.relocs[st.reloc_count].addend = addend;
    st.relocs[st.reloc_count].pair   = 0;
    st.reloc_count = st.reloc_count + 1;
    ret R.ok_void[str]();
}

pub fun bind_reloc_pair(st: *EncodeState, low_index: u32, high_index: u32) R.Result[R.Void, str] {
    if (low_index >= st.reloc_count || high_index >= st.reloc_count) {
        ret R.err[R.Void, str]("encode: relocation pair index is out of range");
    }
    if (low_index == high_index) {
        ret R.err[R.Void, str]("encode: a relocation cannot pair with itself");
    }
    st.relocs[low_index].pair = high_index + 1;
    ret R.ok_void[str]();
}

fun reloc_pair_key(high_kind: of.RelocKind, sym: intern.StrId) u64 {
    ret (high_kind::u64 << 32) | sym::u64;
}

pub fun bind_reloc_pair_site(st: *EncodeState, high_kind: of.RelocKind,
                             sym: intern.StrId, reloc_index: u32) R.Result[R.Void, str] {
    if (sym == intern.STR_NIL) {
        ret R.err[R.Void, str]("encode: relocation pair has no target symbol");
    }
    if (reloc_index >= st.reloc_count
        || st.relocs[reloc_index].kind != high_kind
        || st.relocs[reloc_index].sym != sym) {
        ret R.err[R.Void, str]("encode: relocation pair site does not identify its high relocation");
    }
    val key: u64 = reloc_pair_key(high_kind, sym);
    var site: RelocPairSite;
    site.reloc_index = reloc_index;
    site.label       = intern.STR_NIL;
    val inserted: R.Result[bool, str] =
        map.insert[u64, RelocPairSite](?st.reloc_pair_sites, key, site);
    if (R.is_err[bool, str](inserted)) {
        ret R.err[R.Void, str](R.unwrap_err[bool, str](inserted));
    }
    ret R.ok_void[str]();
}

pub fun reloc_pair_site(st: *EncodeState, high_kind: of.RelocKind,
                        sym: intern.StrId) R.Result[*RelocPairSite, str] {
    val key: u64 = reloc_pair_key(high_kind, sym);
    val found: R.Result[*RelocPairSite, str] =
        map.get[u64, RelocPairSite](?st.reloc_pair_sites, ?key);
    if (R.is_err[*RelocPairSite, str](found)) { ret found; }
    val site: *RelocPairSite = R.unwrap_ok[*RelocPairSite, str](found);
    if (site.reloc_index >= st.reloc_count
        || st.relocs[site.reloc_index].kind != high_kind
        || st.relocs[site.reloc_index].sym != sym) {
        ret R.err[*RelocPairSite, str]("encode: relocation pair site no longer identifies its high relocation");
    }
    ret found;
}

pub fun const_align(kind: u8, len: u32) u32 {
    if (kind == CONST_F32) { ret 4; }
    if (kind == CONST_F64) { ret 8; }
    var a: u32 = 1;
    for (a < len) { a = a * 2; }
    ret a;
}

pub fun intern_const(st: *EncodeState, bytes: *u8, len: u32, kind: u8) R.Result[intern.StrId, str] {
    if (len == 0) { ret R.err[intern.StrId, str]("encode: a constant-pool entry has no bytes"); }
    if (st.interner == nil) {
        ret R.err[intern.StrId, str]("encode: the constant pool needs an interner to name its entries");
    }
    val align: u32 = const_align(kind, len);

    var i: u32 = 0;
    for (i < st.const_count) {
        val e: *ConstEntry = ?st.consts[i];
        if (e.kind == kind && e.len == len && e.align == align &&
            memory.raw_equal(e.bytes::ptr, bytes::ptr, len::usize)) {
            ret R.ok[intern.StrId, str](e.sym);
        }
        i = i + 1;
    }

    if (st.const_count >= st.const_cap) {
        val res_grow: R.Result[R.Void, str] = grow_consts(st);
        if (R.is_err[R.Void, str](res_grow)) { ret R.err[intern.StrId, str](R.unwrap_err[R.Void, str](res_grow)); }
    }

    var name: [32]u8;
    val prefix: str = ".Lconst.";
    var k: usize = 0;
    for (k < 8) { name[k] = prefix[k]::u8; k = k + 1; }
    k = put_decimal(?name[0], k, st.const_count::usize);
    name[k] = 0;
    val res_sym: R.Result[intern.StrId, str] = intern.intern(st.interner, (?name[0])::str);
    if (R.is_err[intern.StrId, str](res_sym)) { ret res_sym; }

    val res_copy: R.Result[*u8, str] = A.allocate[u8](st.alloc, len::usize);
    if (R.is_err[*u8, str](res_copy)) { ret R.err[intern.StrId, str](R.unwrap_err[*u8, str](res_copy)); }
    val buf: *u8 = R.unwrap_ok[*u8, str](res_copy);
    memory.raw_copy(buf::ptr, bytes::ptr, len::usize);

    st.consts[st.const_count].bytes = buf;
    st.consts[st.const_count].len   = len;
    st.consts[st.const_count].align = align;
    st.consts[st.const_count].kind  = kind;
    st.consts[st.const_count].sym   = R.unwrap_ok[intern.StrId, str](res_sym);
    st.const_count = st.const_count + 1;
    ret R.ok[intern.StrId, str](st.consts[st.const_count - 1].sym);
}

pub fun intern_local_label(st: *EncodeState, prefix: str, ordinal: u32) R.Result[intern.StrId, str] {
    var name: [64]u8;
    val plen: usize = str_len(prefix);
    if (plen + 24 >= 64) {
        ret R.err[intern.StrId, str]("encode: local label prefix is too long to spell");
    }
    var k: usize = 0;
    for (k < plen) { name[k] = prefix[k]::u8; k = k + 1; }
    k = put_decimal(?name[0], k, ordinal::usize);
    name[k] = 0;
    ret intern.intern(st.interner, (?name[0])::str);
}

pub fun intern_float_const(st: *EncodeState, bits: u64, width: u8) R.Result[intern.StrId, str] {
    var img: [8]u8;
    var i: u32 = 0;
    for (i < width::u32) {
        img[i] = (bits >> (i::u64 * 8::u64))::u8;
        i = i + 1;
    }
    var kind: u8 = CONST_F64;
    if (width == 4) { kind = CONST_F32; }
    ret intern_const(st, ?img[0], width::u32, kind);
}

fun grow_consts(st: *EncodeState) R.Result[R.Void, str] {
    ret grow_cap[ConstEntry](st.alloc, ?st.consts, ?st.const_cap, DRIVER_INIT_CAP);
}

pub fun push_fixup(st: *EncodeState, patch_pos: u32, next_ip: u32, target_block: u32, fn_text_base: u32) R.Result[R.Void, str] {
    if (st.fixup_count >= st.fixup_cap) {
        val res_grow: R.Result[R.Void, str] = grow_fixups(st);
        if (R.is_err[R.Void, str](res_grow)) { ret res_grow; }
    }
    st.fixups[st.fixup_count].patch_pos    = patch_pos;
    st.fixups[st.fixup_count].next_ip      = next_ip;
    st.fixups[st.fixup_count].target_block = target_block;
    st.fixups[st.fixup_count].fn_text_base = fn_text_base;
    st.fixup_count = st.fixup_count + 1;
    ret R.ok_void[str]();
}

pub fun push_block(st: *EncodeState, fn_text_base: u32, block_id: u32, offset: u32) R.Result[R.Void, str] {
    if (st.block_count >= st.block_cap) {
        val res_grow: R.Result[R.Void, str] = grow_blocks(st);
        if (R.is_err[R.Void, str](res_grow)) { ret res_grow; }
    }
    st.blocks[st.block_count].fn_text_base = fn_text_base;
    st.blocks[st.block_count].block_id     = block_id;
    st.blocks[st.block_count].offset       = offset;
    st.block_count = st.block_count + 1;
    ret R.ok_void[str]();
}

pub fun set_fallthrough(st: *EncodeState, f: *mir.MirFunction, bi: u32) {
    if (bi + 1 < f.block_count) {
        st.has_next_block = true;
        st.next_block_id  = f.blocks[bi + 1].id;
    } or {
        st.has_next_block = false;
        st.next_block_id  = 0;
    }
}

pub fun branch_falls_through(st: *EncodeState, target_block: u32) bool {
    ret st.has_next_block && st.next_block_id == target_block;
}

pub fun push_row(st: *EncodeState, text_offset: u32, loc: source.SrcLoc) R.Result[R.Void, str] {
    if (!source.loc_is_valid(loc)) { ret R.ok_void[str](); }
    if (st.row_count >= st.row_cap) {
        val res_grow: R.Result[R.Void, str] = grow_rows(st);
        if (R.is_err[R.Void, str](res_grow)) { ret res_grow; }
    }
    st.rows[st.row_count].text_offset = text_offset;
    st.rows[st.row_count].sec         = 0;
    st.rows[st.row_count].loc         = loc;
    st.row_count = st.row_count + 1;
    ret R.ok_void[str]();
}

pub fun push_varloc(st: *EncodeState, text_offset: u32, fn: *mir.MirFunction, vreg: u32, iid: u32) R.Result[R.Void, str] {
    var kind: u8  = VARLOC_NONE;
    var reg:  i32 = 0;
    var off:  i64 = 0;
    var storage: bool = false;
    if (vreg != mir.MIR_VREG_NIL && vreg < fn.vreg_count) {
        val vr: *mir.MirVReg = ?fn.vregs[vreg];
        if (vr.assigned != mir.MIR_VREG_NIL) {
            kind = VARLOC_REG;
            reg  = vr.assigned::i32;
        }
        or (vr.spill_slot >= 0) {
            var si: u32 = 0;
            for (si < fn.frame.slot_count) {
                if (fn.frame.slots[si].value == vreg) { kind = VARLOC_FRAME; off = varloc_slot_off(fn, si); }
                si = si + 1;
            }
        }
        or {
            var si: u32 = 0;
            for (si < fn.frame.slot_count) {
                if (fn.frame.slots[si].value == vreg && fn.frame.slots[si].kind == mir.SLOT_SPILL) {
                    kind = VARLOC_FRAME; off = varloc_slot_off(fn, si); storage = true;
                }
                si = si + 1;
            }
        }
    }

    if (st.varloc_count >= st.varloc_cap) {
        val res_grow: R.Result[R.Void, str] = grow_varlocs(st);
        if (R.is_err[R.Void, str](res_grow)) { ret res_grow; }
    }
    st.varlocs[st.varloc_count].text_offset = text_offset;
    st.varlocs[st.varloc_count].sec         = 0;
    st.varlocs[st.varloc_count].iid         = iid;
    st.varlocs[st.varloc_count].kind        = kind;
    st.varlocs[st.varloc_count].reg         = reg;
    st.varlocs[st.varloc_count].off         = off;
    st.varlocs[st.varloc_count].off_storage = storage;
    varloc_clear_cmp(?st.varlocs[st.varloc_count]);
    st.varloc_count = st.varloc_count + 1;
    ret R.ok_void[str]();
}

fun varloc_clear_cmp(vl: *VarLoc) {
    vl.end_offset = 0;
    vl.sub_lhs    = VARLOC_NONE;
    vl.sub_rhs    = VARLOC_NONE;
    vl.reg2       = 0;
    vl.off2       = 0;
    vl.cmp_rel    = 0;
    vl.cmp_signed = false;
    vl.cmp_width  = 0;
}

fun cmp_operand_home(fn: *mir.MirFunction, is_imm: bool, vreg: u32, imm: i64,
                     out_kind: *u8, out_reg: *i32, out_off: *i64) {
    @out_kind = VARLOC_NONE;
    @out_reg  = 0;
    @out_off  = 0;
    if (is_imm) {
        @out_kind = VARLOC_IMM;
        @out_off  = imm;
        ret;
    }
    if (vreg >= fn.vreg_count) { ret; }
    val vr: *mir.MirVReg = ?fn.vregs[vreg];
    if (vr.assigned != mir.MIR_VREG_NIL) {
        @out_kind = VARLOC_REG;
        @out_reg  = vr.assigned::i32;
        ret;
    }
    if (vr.spill_slot >= 0) {
        var si: u32 = 0;
        for (si < fn.frame.slot_count) {
            if (fn.frame.slots[si].value == vreg) {
                @out_kind = VARLOC_FRAME;
                @out_off  = varloc_slot_off(fn, si);
            }
            si = si + 1;
        }
    }
}

pub fun push_cmp_varloc(st: *EncodeState, text_offset: u32, fn: *mir.MirFunction, bind: *mir.MirDbgBinding) R.Result[R.Void, str] {
    var lk: u8 = VARLOC_NONE; var lr: i32 = 0; var lo: i64 = 0;
    var rk: u8 = VARLOC_NONE; var rr: i32 = 0; var ro: i64 = 0;
    cmp_operand_home(fn, bind.lhs_is_imm, bind.vreg, bind.imm, ?lk, ?lr, ?lo);
    cmp_operand_home(fn, bind.rhs_is_imm, bind.vreg2, bind.imm2, ?rk, ?rr, ?ro);
    if (lk == VARLOC_NONE || rk == VARLOC_NONE) {
        ret push_varloc(st, text_offset, fn, mir.MIR_VREG_NIL, bind.iid);
    }

    var rel: u8 = CMPREL_EQ;
    if (bind.cmp_op == mir.MIR_SEL_CBR_NE)                                            { rel = CMPREL_NE; }
    or (bind.cmp_op == mir.MIR_SEL_CBR_LT_S || bind.cmp_op == mir.MIR_SEL_CBR_LT_U)   { rel = CMPREL_LT; }
    or (bind.cmp_op == mir.MIR_SEL_CBR_LE_S || bind.cmp_op == mir.MIR_SEL_CBR_LE_U)   { rel = CMPREL_LE; }

    if (st.varloc_count >= st.varloc_cap) {
        val res_grow: R.Result[R.Void, str] = grow_varlocs(st);
        if (R.is_err[R.Void, str](res_grow)) { ret res_grow; }
    }
    val vl: *VarLoc = ?st.varlocs[st.varloc_count];
    vl.text_offset = text_offset;
    vl.sec         = 0;
    vl.iid         = bind.iid;
    vl.kind        = VARLOC_CMP;
    vl.reg         = lr;
    vl.off         = lo;
    vl.off_storage = false;
    vl.end_offset  = 0;
    vl.sub_lhs     = lk;
    vl.sub_rhs     = rk;
    vl.reg2        = rr;
    vl.off2        = ro;
    vl.cmp_rel     = rel;
    vl.cmp_signed  = mir.is_signed_cmp(bind.cmp_op);
    vl.cmp_width   = bind.cmp_width;
    st.varloc_count = st.varloc_count + 1;
    ret R.ok_void[str]();
}

pub fun close_cmp_varlocs(st: *EncodeState, instr_start: u32, instr_end: u32) {
    var i: u32 = st.varloc_count;
    for (i > 0) {
        i = i - 1;
        val vl: *VarLoc = ?st.varlocs[i];
        if (vl.text_offset != instr_start) { ret; }
        if (vl.kind == VARLOC_CMP && vl.end_offset == 0) { vl.end_offset = instr_end; }
    }
}

pub fun emit_var_bindings(st: *EncodeState, fn: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.dbg_binding_count == 0) { ret R.ok_void[str](); }
    val at: u32 = st.buf.len::u32;
    var i: u32 = 0;
    for (i < mi.dbg_binding_count) {
        val bind: *mir.MirDbgBinding = ?mi.dbg_bindings[i];
        var r: R.Result[R.Void, str] = R.ok_void[str]();
        if (bind.cmp_op != 0) { r = push_cmp_varloc(st, at, fn, bind); }
        or                    { r = push_varloc(st, at, fn, bind.vreg, bind.iid); }
        if (R.is_err[R.Void, str](r)) { ret r; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun grow_varlocs(st: *EncodeState) R.Result[R.Void, str] {
    ret grow_cap[VarLoc](st.alloc, ?st.varlocs, ?st.varloc_cap, DRIVER_INIT_CAP);
}

fun state_init(st: *EncodeState, alloc: *A.Allocator, m: *mir.MirModule, tgt: *isa.BackendTarget) {
    state_blank(st, alloc, ?tgt.model);
    st.interner    = m.interner;
    st.srcmap      = m.srcmap;
    st.callee_saved = tgt.abi.callee_saved;
    st.base_addr    = tgt.os.image_base;
    st.page_size    = tgt.os.page_size;
    st.stack_probe  = tgt.os.stack_probe;
}

pub fun state_blank(st: *EncodeState, alloc: *A.Allocator, model: *isa.MachineModel) {
    st.model       = model;
    st.callee_saved = nil;
    st.base_addr    = 0;
    st.page_size    = 0;
    st.stack_probe  = false;
    st.alloc       = alloc;
    st.buf         = buf_init(alloc);
    st.syms        = nil;
    st.sym_count   = 0;
    st.pcrel_label_count = 0;
    st.sym_cap     = 0;
    st.relocs      = nil;
    st.reloc_count = 0;
    st.reloc_cap   = 0;
    st.reloc_pair_sites = map.init[u64, RelocPairSite](alloc, map.hash_u64, map.eq_u64);
    st.fixups      = nil;
    st.fixup_count = 0;
    st.fixup_cap   = 0;
    st.blocks      = nil;
    st.block_count = 0;
    st.block_cap   = 0;
    st.rows        = nil;
    st.row_count   = 0;
    st.row_cap     = 0;
    st.varlocs     = nil;
    st.varloc_count = 0;
    st.varloc_cap  = 0;
    st.inline_pcs  = nil;
    st.inline_pc_count = 0;
    st.inline_pc_cap   = 0;
    st.consts      = nil;
    st.const_count = 0;
    st.const_cap   = 0;
    st.frames      = nil;
    st.frame_count = 0;
    st.frame_cap   = 0;
    st.last_inline_site = 0;
    st.next_block_id  = 0;
    st.has_next_block = false;
    st.interner    = nil;
    st.srcmap      = nil;
}

fun state_dnit(st: *EncodeState) {
    buf_dnit(?st.buf);
    if (st.syms != nil && st.sym_cap > 0) {
        A.deallocate[SymbolMark](st.alloc, st.syms, st.sym_cap::usize);
    }
    st.syms      = nil;
    st.sym_count = 0;
    st.pcrel_label_count = 0;
    st.sym_cap   = 0;
    if (st.relocs != nil && st.reloc_cap > 0) {
        A.deallocate[PendingReloc](st.alloc, st.relocs, st.reloc_cap::usize);
    }
    st.relocs      = nil;
    st.reloc_count = 0;
    st.reloc_cap   = 0;
    if (st.rows != nil && st.row_cap > 0) {
        A.deallocate[LineRow](st.alloc, st.rows, st.row_cap::usize);
    }
    st.rows      = nil;
    st.row_count = 0;
    st.row_cap   = 0;
    if (st.varlocs != nil && st.varloc_cap > 0) {
        A.deallocate[VarLoc](st.alloc, st.varlocs, st.varloc_cap::usize);
    }
    st.varlocs      = nil;
    st.varloc_count = 0;
    st.varloc_cap   = 0;
    if (st.inline_pcs != nil && st.inline_pc_cap > 0) {
        A.deallocate[InlinePc](st.alloc, st.inline_pcs, st.inline_pc_cap::usize);
    }
    st.inline_pcs      = nil;
    st.inline_pc_count = 0;
    st.inline_pc_cap   = 0;
    consts_free(st.alloc, st.consts, st.const_count, st.const_cap);
    st.consts      = nil;
    st.const_count = 0;
    st.const_cap   = 0;
    if (st.frames != nil && st.frame_cap > 0) {
        A.deallocate[of.FrameUnwind](st.alloc, st.frames, st.frame_cap::usize);
    }
    st.frames      = nil;
    st.frame_count = 0;
    st.frame_cap   = 0;
    scratch_release(st);
}

pub fun consts_free(alloc: *A.Allocator, c: *ConstEntry, count: u32, cap: u32) {
    if (c == nil) { ret; }
    var i: u32 = 0;
    for (i < count) {
        if (c[i].bytes != nil && c[i].len > 0) {
            A.deallocate[u8](alloc, c[i].bytes, c[i].len::usize);
        }
        i = i + 1;
    }
    if (cap > 0) { A.deallocate[ConstEntry](alloc, c, cap::usize); }
}

fun scratch_release(st: *EncodeState) {
    map.dnit[u64, RelocPairSite](?st.reloc_pair_sites);
    if (st.fixups != nil && st.fixup_cap > 0) {
        A.deallocate[BranchFixup](st.alloc, st.fixups, st.fixup_cap::usize);
    }
    st.fixups      = nil;
    st.fixup_count = 0;
    st.fixup_cap   = 0;
    if (st.blocks != nil && st.block_cap > 0) {
        A.deallocate[BlockOffset](st.alloc, st.blocks, st.block_cap::usize);
    }
    st.blocks      = nil;
    st.block_count = 0;
    st.block_cap   = 0;
}

fun shrink_text(st: *EncodeState) R.Result[R.Void, str] {
    if (st.buf.data == nil) { ret R.ok_void[str](); }
    if (st.buf.len == 0) {
        A.deallocate[u8](st.alloc, st.buf.data, st.buf.cap);
        st.buf.data = nil;
        st.buf.cap  = 0;
        ret R.ok_void[str]();
    }
    if (st.buf.cap == st.buf.len) { ret R.ok_void[str](); }
    val res_shrink: R.Result[*u8, str] = A.reallocate[u8](st.alloc, st.buf.data, st.buf.cap, st.buf.len);
    if (R.is_err[*u8, str](res_shrink)) { ret R.err[R.Void, str](R.unwrap_err[*u8, str](res_shrink)); }
    st.buf.data = R.unwrap_ok[*u8, str](res_shrink);
    st.buf.cap  = st.buf.len;
    ret R.ok_void[str]();
}

fun shrink_consts(st: *EncodeState) R.Result[R.Void, str] {
    if (st.consts == nil) { ret R.ok_void[str](); }
