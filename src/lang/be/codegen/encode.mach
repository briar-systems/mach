test "mach.lang.be.codegen.encode.shrink_arrays:cap_equals_count_after_shrink" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var st: EncodeState;
    t_row_state(?alloc, ?st);

    val rsym: res[*SymbolMark, A.Error] = A.allocate[SymbolMark](?alloc, 8::usize);
    if (sel rsym.err) { ret 1; }
    st.syms = rsym.ok;
    st.sym_cap = 8;
    st.sym_count = 3;

    val rrel: res[*PendingReloc, A.Error] = A.allocate[PendingReloc](?alloc, 8::usize);
    if (sel rrel.err) { ret 1; }
    st.relocs = rrel.ok;
    st.reloc_cap = 8;
    st.reloc_count = 2;

    val rrow: res[*LineRow, A.Error] = A.allocate[LineRow](?alloc, 8::usize);
    if (sel rrow.err) { ret 1; }
    st.rows = rrow.ok;
    st.row_cap = 8;
    st.row_count = 4;

    val rvl: res[*VarLoc, A.Error] = A.allocate[VarLoc](?alloc, 8::usize);
    if (sel rvl.err) { ret 1; }
    st.varlocs = rvl.ok;
    st.varloc_cap = 8;
    st.varloc_count = 1;

    val rip: res[*InlinePc, A.Error] = A.allocate[InlinePc](?alloc, 8::usize);
    if (sel rip.err) { ret 1; }
    st.inline_pcs = rip.ok;
    st.inline_pc_cap = 8;
    st.inline_pc_count = 0;

    val rfr: res[*of.FrameUnwind, A.Error] = A.allocate[of.FrameUnwind](?alloc, 8::usize);
    if (sel rfr.err) { ret 1; }
    st.frames = rfr.ok;
    st.frame_cap = 8;
    st.frame_count = 5;

    val shrink_syms_r: err[fail.Fail] = shrink_syms(?st);
    if (sel shrink_syms_r.err)       { state_dnit(?st); ret 1; }
    val shrink_relocs_r: err[fail.Fail] = shrink_relocs(?st);
    if (sel shrink_relocs_r.err)     { state_dnit(?st); ret 1; }
    val shrink_rows_r: err[fail.Fail] = shrink_rows(?st);
    if (sel shrink_rows_r.err)       { state_dnit(?st); ret 1; }
    val shrink_varlocs_r: err[fail.Fail] = shrink_varlocs(?st);
    if (sel shrink_varlocs_r.err)    { state_dnit(?st); ret 1; }
    val shrink_inline_pcs_r: err[fail.Fail] = shrink_inline_pcs(?st);
    if (sel shrink_inline_pcs_r.err) { state_dnit(?st); ret 1; }
    val shrink_frames_r: err[fail.Fail] = shrink_frames(?st);
    if (sel shrink_frames_r.err)     { state_dnit(?st); ret 1; }

    if (st.sym_cap != st.sym_count)                    { state_dnit(?st); ret 1; }
    if (st.reloc_cap != st.reloc_count)                { state_dnit(?st); ret 1; }
    if (st.row_cap != st.row_count)                    { state_dnit(?st); ret 1; }
    if (st.varloc_cap != st.varloc_count)              { state_dnit(?st); ret 1; }
    if (st.inline_pc_cap != 0 || st.inline_pcs != nil) { state_dnit(?st); ret 1; }
    if (st.frame_cap != st.frame_count)                { state_dnit(?st); ret 1; }

    state_dnit(?st);
    ret 0;
}

fun patch_branches(st: *EncodeState, hooks: *EncodeHooks) err[fail.Fail] {
    if (st.buf.data == nil) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < st.fixup_count) {
        val fx: *BranchFixup = ?st.fixups[i];
        val res_off: res[u32, fail.Fail] = block_offset(st, fx.fn_text_base, fx.target_block);
        if (sel res_off.err) { ret err[fail.Fail].err{res_off.err}; }
        val target_off: u32 = res_off.ok;
        val res_patch: err[fail.Fail] = hooks.patch_branch(st, fx, target_off);
        if (sel res_patch.err) { ret res_patch; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun block_offset(st: *EncodeState, fn_base: u32, block_id: u32) res[u32, fail.Fail] {
    val key: u64 = block_key(fn_base, block_id);
    val found: opt[*u32] = map.get[u64, u32](?st.block_index, ?key);
    if (sel found.some) { ret res[u32, fail.Fail].ok{st.blocks[@found.some].offset}; }
    ret res[u32, fail.Fail].err{fail.message("encode: branch target block was never recorded")};
}

pub fun insert_text(st: *EncodeState, pos: u32, nbytes: u32) err[fail.Fail] {
    if (nbytes == 0) { ret err[fail.Fail].ok{}; }
    val p: usize = pos::usize;
    val n: usize = nbytes::usize;
    if (p > st.buf.len) {
        ret err[fail.Fail].err{fail.message("encode: text-gap offset is past the end of the buffer")};
    }

    val need_r: res[layout.CheckedCount[layout.ByteUnit], layout.CheckCause] =
        layout.count_add[layout.ByteUnit](layout.count[layout.ByteUnit](st.buf.len), layout.count[layout.ByteUnit](n));
    if (sel need_r.err) {
        ret err[fail.Fail].err{fail.message("encode: text-gap size overflow")};
    }
    val need: usize = need_r.ok.value;
    if (need > st.buf.cap) {
        var new_cap_c: layout.CheckedCount[layout.ByteUnit] = layout.count[layout.ByteUnit](BYTEBUF_INIT_CAP);
        if (st.buf.cap > 0) { new_cap_c = layout.count[layout.ByteUnit](st.buf.cap); }
        for (new_cap_c.value < need) {
            val doubled_r: res[layout.CheckedCount[layout.ByteUnit], layout.CheckCause] =
                layout.count_mul[layout.ByteUnit](new_cap_c, 2::usize);
            if (sel doubled_r.err) {
                ret err[fail.Fail].err{fail.message("encode: text buffer growth capacity overflow")};
            }
            new_cap_c = doubled_r.ok;
        }
        val new_cap: usize = new_cap_c.value;
        val res_realloc: res[*u8, A.Error] = A.reallocate[u8](st.buf.alloc, st.buf.data, st.buf.cap, new_cap);
        if (sel res_realloc.err) { ret err[fail.Fail].err{fail.refused(res_realloc.err)}; }
        st.buf.data = res_realloc.ok;
        st.buf.cap  = new_cap;
    }

    var i: usize = st.buf.len;
    for (i > p) {
        i = i - 1;
        st.buf.data[i + n] = st.buf.data[i];
    }
    var z: usize = p;
    for (z < p + n) {
        st.buf.data[z] = 0;
        z = z + 1;
    }
    st.buf.len = need;

    var bi: u32 = 0;
    var bases_moved: bool = false;
    for (bi < st.block_count) {
        if (st.blocks[bi].offset >= pos)       { st.blocks[bi].offset = st.blocks[bi].offset + nbytes; }
        if (st.blocks[bi].fn_text_base >= pos) { st.blocks[bi].fn_text_base = st.blocks[bi].fn_text_base + nbytes; bases_moved = true; }
        bi = bi + 1;
    }
    if (bases_moved) {
        val reindexed: err[fail.Fail] = reindex_blocks(st);
        if (sel reindexed.err) { ret reindexed; }
    }
    var fi: u32 = 0;
    for (fi < st.fixup_count) {
        if (st.fixups[fi].patch_pos >= pos)    { st.fixups[fi].patch_pos = st.fixups[fi].patch_pos + nbytes; }
        if (st.fixups[fi].next_ip >= pos)      { st.fixups[fi].next_ip = st.fixups[fi].next_ip + nbytes; }
        if (st.fixups[fi].fn_text_base >= pos) { st.fixups[fi].fn_text_base = st.fixups[fi].fn_text_base + nbytes; }
        fi = fi + 1;
    }
    var si: u32 = 0;
    for (si < st.sym_count) {
        if (st.syms[si].offset >= pos) { st.syms[si].offset = st.syms[si].offset + nbytes; }
        si = si + 1;
    }
    var ri: u32 = 0;
    for (ri < st.reloc_count) {
        if (st.relocs[ri].offset >= pos) { st.relocs[ri].offset = st.relocs[ri].offset + nbytes; }
        ri = ri + 1;
    }
    var fri: u32 = 0;
    for (fri < st.frame_count) {
        if (st.frames[fri].offset >= pos) { st.frames[fri].offset = st.frames[fri].offset + nbytes; }
        fri = fri + 1;
    }
    var wi: u32 = 0;
    for (wi < st.row_count) {
        if (st.rows[wi].text_offset >= pos) { st.rows[wi].text_offset = st.rows[wi].text_offset + nbytes; }
        wi = wi + 1;
    }
    var vli: u32 = 0;
    for (vli < st.varloc_count) {
        if (st.varlocs[vli].text_offset >= pos) { st.varlocs[vli].text_offset = st.varlocs[vli].text_offset + nbytes; }
        if (st.varlocs[vli].end_offset != 0 && st.varlocs[vli].end_offset >= pos) {
            st.varlocs[vli].end_offset = st.varlocs[vli].end_offset + nbytes;
        }
        vli = vli + 1;
    }
    var ipi: u32 = 0;
    for (ipi < st.inline_pc_count) {
        if (st.inline_pcs[ipi].text_offset >= pos) { st.inline_pcs[ipi].text_offset = st.inline_pcs[ipi].text_offset + nbytes; }
        ipi = ipi + 1;
    }
    if (st.buf.asm != nil) {
        var ni: u32 = 0;
        for (ni < st.buf.asm.note_count) {
            if (st.buf.asm.notes[ni].off >= pos) { st.buf.asm.notes[ni].off = st.buf.asm.notes[ni].off + nbytes; }
            ni = ni + 1;
        }
    }
    ret err[fail.Fail].ok{};
}

fun grow_symbols(st: *EncodeState) err[fail.Fail] {
    ret grow_cap[SymbolMark](st.alloc, ?st.syms, ?st.sym_cap, DRIVER_INIT_CAP);
}

fun grow_relocs(st: *EncodeState) err[fail.Fail] {
    ret grow_cap[PendingReloc](st.alloc, ?st.relocs, ?st.reloc_cap, DRIVER_INIT_CAP);
}

fun grow_fixups(st: *EncodeState) err[fail.Fail] {
    ret grow_cap[BranchFixup](st.alloc, ?st.fixups, ?st.fixup_cap, DRIVER_INIT_CAP);
}

fun grow_blocks(st: *EncodeState) err[fail.Fail] {
    ret grow_cap[BlockOffset](st.alloc, ?st.blocks, ?st.block_cap, DRIVER_INIT_CAP);
}

fun grow_rows(st: *EncodeState) err[fail.Fail] {
    ret grow_cap[LineRow](st.alloc, ?st.rows, ?st.row_cap, DRIVER_INIT_CAP);
}

fun grow_inline_pcs(st: *EncodeState) err[fail.Fail] {
    ret grow_cap[InlinePc](st.alloc, ?st.inline_pcs, ?st.inline_pc_cap, DRIVER_INIT_CAP);
}

pub fun push_inline_pc(st: *EncodeState, text_offset: u32, inline_site: u32) err[fail.Fail] {
    if (inline_site == st.last_inline_site) { ret err[fail.Fail].ok{}; }
    if (st.inline_pc_count >= st.inline_pc_cap) {
        val res_grow: err[fail.Fail] = grow_inline_pcs(st);
        if (sel res_grow.err) { ret res_grow; }
    }
    st.inline_pcs[st.inline_pc_count].text_offset = text_offset;
    st.inline_pcs[st.inline_pc_count].sec         = 0;
    st.inline_pcs[st.inline_pc_count].inline_site = inline_site;
    st.inline_pc_count  = st.inline_pc_count + 1;
    st.last_inline_site = inline_site;
    ret err[fail.Fail].ok{};
}

fun put_decimal(buf: *u8, at: usize, n: usize) usize {
    var digits: [20]u8;
    var d: usize = 0;
    var v: usize = n;
    if (v == 0) { digits[0] = '0'::u8; d = 1; }
    for (v > 0) {
        digits[d] = (v % 10)::u8 + '0'::u8;
        v = v / 10;
        d = d + 1;
    }
    var k: usize = at;
    for (d > 0) {
        d = d - 1;
        buf[k] = digits[d];
        k = k + 1;
    }
    ret k;
}

# an opcode no encoder arm names is a member the selector produced outside the
# native catalog: internal, named with the function it was found in
pub fun opcode_failure(st: *EncodeState, f: *mir.MirFunction, architecture: str, opcode: u32) err[fail.Fail] {
    if (st.interner == nil) { ret err[fail.Fail].err{fail.message("encode: opcode failure has no diagnostic owner")}; }
    var name: str = "<unknown>";
    val found_name: opt[str] = intern.lookup(st.interner, f.name);
    if (sel found_name.some) { name = found_name.some; }
    val catalog: res[str, format.FormatError] = format.sprint(st.alloc, "{}.Opcode", architecture);
    if (sel catalog.err) { ret err[fail.Fail].err{fail.format_refused(catalog.err)}; }
    val catalog_name: str = catalog.ok;
    fin { A.deallocate[u8](st.alloc, catalog_name, str_len(catalog_name) + 1); }
    val where: res[str, format.FormatError] = format.sprint(st.alloc, "'{}'", name);
    if (sel where.err) { ret err[fail.Fail].err{fail.format_refused(where.err)}; }
    val where_text: str = where.ok;
    fin { A.deallocate[u8](st.alloc, where_text, str_len(where_text) + 1); }
    val member: fail.Catalog = fail.unknown_member_in(catalog_name, opcode, where_text);
    ret err[fail.Fail].err{fail.message(fail.catalog_message(st.interner, st.alloc, member))};
}

pub fun asm_located_message(st: *EncodeState, loc: source.SrcLoc, msg: str) str {
    if (st.srcmap == nil || st.interner == nil) { ret msg; }
    if (!source.loc_is_valid(loc)) { ret msg; }
    val fo: opt[*source.SourceFile] = source.get(st.srcmap, loc.file);
    if (sel fo.none) { ret msg; }
    val file: *source.SourceFile = fo.some;
    val pos: source.Position = source.position(file, loc.offset);

    val lp: usize = str_len(file.path);
    val lm: usize = str_len(msg);
    val total_cap: usize = lp + 1 + 20 + 1 + 20 + 2 + lm + 1;
    val rb: res[*u8, A.Error] = A.allocate[u8](st.alloc, total_cap);
    if (sel rb.err) { ret msg; }
    val buf: *u8 = rb.ok;

    var k: usize = 0;
    var j: usize = 0;
    for (j < lp) { buf[k] = file.path[j]::u8; k = k + 1; j = j + 1; }
    buf[k] = ':'::u8; k = k + 1;
    k = put_decimal(buf, k, pos.line);
    buf[k] = ':'::u8; k = k + 1;
    k = put_decimal(buf, k, pos.col);
    buf[k] = ':'::u8; k = k + 1;
    buf[k] = ' '::u8; k = k + 1;
    j = 0;
    for (j < lm) { buf[k] = msg[j]::u8; k = k + 1; j = j + 1; }
    buf[k] = 0;

    val ir: res[intern.StrId, A.Error] = intern.intern(st.interner, buf::str);
    A.deallocate[u8](st.alloc, buf, total_cap);
    if (sel ir.err) { ret msg; }
    val nm: opt[str] = intern.lookup(st.interner, ir.ok);
    if (sel nm.some) { ret nm.some; }
    ret msg;
}

var t_model: isa.MachineModel;
fun t_machine() *isa.MachineModel {
    t_model.pointer_width = 8;
    t_model.gpr_width     = 8;
    t_model.max_alu_width = 8;
    t_model.alu_min_width = 4;
    t_model.spill_width   = 8;
    t_model.flen_bits     = 64;
    ret ?t_model;
}

fun t_row_state(alloc: *A.Allocator, st: *EncodeState) {
    state_blank(st, alloc, t_machine());
}

test "mach.lang.be.codegen.encode.insert_text:shifts_line_rows" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var st: EncodeState;
    t_row_state(?alloc, ?st);

    var i: u32 = 0;
    for (i < 12) { emit_byte(?st.buf, 0x90); i = i + 1; }

    val r0: err[fail.Fail] = push_row(?st, 0, source.loc(1, 100));
    if (sel r0.err) { ret 1; }
    val r1: err[fail.Fail] = push_row(?st, 4, source.loc(1, 200));
    if (sel r1.err) { ret 1; }
    val rn: err[fail.Fail] = push_row(?st, 4, source.loc_nil());
    if (sel rn.err) { ret 1; }
    val r2: err[fail.Fail] = push_row(?st, 8, source.loc(1, 300));
    if (sel r2.err) { ret 1; }
    if (st.row_count != 3) { buf_dnit(?st.buf); ret 1; }

    val it: err[fail.Fail] = insert_text(?st, 4, 4);
    if (sel it.err) { buf_dnit(?st.buf); ret 1; }

    var code: i32 = 0;
    if (st.rows[0].text_offset != 0)  { code = 1; }
    if (st.rows[1].text_offset != 8)  { code = 1; }
    if (st.rows[2].text_offset != 12) { code = 1; }
    if (st.rows[1].loc.offset != 200) { code = 1; }

    buf_dnit(?st.buf);
    if (st.rows != nil && st.row_cap > 0) { A.deallocate[LineRow](?alloc, st.rows, st.row_cap::usize); }
    ret code;
}

test "mach.lang.be.codegen.encode.push_varloc:reg_frame_dead" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var code: i32 = 0;

    var st: EncodeState;
    t_row_state(?alloc, ?st);

    var vregs: [3]mir.MirVReg;
    vregs[0].id = 0; vregs[0].class = 0; vregs[0].spill_slot = -1; vregs[0].assigned = 7;
    vregs[1].id = 1; vregs[1].class = 0; vregs[1].spill_slot = 0;  vregs[1].assigned = mir.MIR_VREG_NIL;
    vregs[2].id = 2; vregs[2].class = 0; vregs[2].spill_slot = -1; vregs[2].assigned = mir.MIR_VREG_NIL;

    var slots: [1]mir.MirSlot;
    slots[0].value = 1; slots[0].kind = mir.SLOT_SPILL; slots[0].offset = -16; slots[0].size = 8; slots[0].align = 8;

    var fn: mir.MirFunction;
    fn.vregs = ?vregs[0]; fn.vreg_count = 3;
    fn.frame.slots = ?slots[0]; fn.frame.slot_count = 1; fn.frame.slot_cap = 1;
    fn.frame.size = 0; fn.frame.align = 0; fn.frame.outgoing_size = 0;

    val ra: err[fail.Fail] = push_varloc(?st, 0, ?fn, 0, 100);
    if (sel ra.err) { code = 1; }
    val rb: err[fail.Fail] = push_varloc(?st, 4, ?fn, 1, 101);
    if (sel rb.err) { code = 1; }
    val rc: err[fail.Fail] = push_varloc(?st, 8, ?fn, 2, 102);
    if (sel rc.err) { code = 1; }

    if (st.varloc_count != 3) { code = 1; }
    if (st.varlocs[0].kind != VARLOC_REG || st.varlocs[0].reg != 7 || st.varlocs[0].iid != 100) { code = 1; }
    if (st.varlocs[1].kind != VARLOC_FRAME || st.varlocs[1].off != -16 || st.varlocs[1].iid != 101) { code = 1; }
    if (st.varlocs[2].kind != VARLOC_NONE || st.varlocs[2].iid != 102) { code = 1; }

    if (st.varlocs != nil && st.varloc_cap > 0) { A.deallocate[VarLoc](?alloc, st.varlocs, st.varloc_cap::usize); }
    buf_dnit(?st.buf);
    ret code;
}

test "mach.lang.be.codegen.encode.push_cmp_varloc:homes_digest_and_close" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var code: i32 = 0;

    var st: EncodeState;
    t_row_state(?alloc, ?st);

    var vregs: [3]mir.MirVReg;
    vregs[0].id = 0; vregs[0].class = 0; vregs[0].spill_slot = -1; vregs[0].assigned = 7;
    vregs[1].id = 1; vregs[1].class = 0; vregs[1].spill_slot = 0;  vregs[1].assigned = mir.MIR_VREG_NIL;
    vregs[2].id = 2; vregs[2].class = 0; vregs[2].spill_slot = -1; vregs[2].assigned = mir.MIR_VREG_NIL;

    var slots: [1]mir.MirSlot;
    slots[0].value = 1; slots[0].kind = mir.SLOT_SPILL; slots[0].offset = -16; slots[0].size = 8; slots[0].align = 8;

    var fn: mir.MirFunction;
    fn.vregs = ?vregs[0]; fn.vreg_count = 3;
    fn.frame.slots = ?slots[0]; fn.frame.slot_count = 1; fn.frame.slot_cap = 1;
    fn.frame.size = 0; fn.frame.align = 0; fn.frame.outgoing_size = 0;

    var bind: mir.MirDbgBinding;
    bind.iid = 100; bind.cmp_op = mir.MIR_SEL_CBR_LT_U; bind.cmp_width = 2;
    bind.lhs_is_imm = false; bind.vreg = 0; bind.imm = 0;
    bind.rhs_is_imm = true;  bind.vreg2 = mir.MIR_VREG_NIL; bind.imm2 = 40000;
    val ra: err[fail.Fail] = push_cmp_varloc(?st, 12, ?fn, ?bind);
    if (sel ra.err) { code = 1; }

    bind.iid = 101; bind.cmp_op = mir.MIR_SEL_CBR_LE_S; bind.cmp_width = 8;
    bind.lhs_is_imm = false; bind.vreg = 1;
    bind.rhs_is_imm = false; bind.vreg2 = 0;
    val rb: err[fail.Fail] = push_cmp_varloc(?st, 12, ?fn, ?bind);
    if (sel rb.err) { code = 1; }

    val rp: err[fail.Fail] = push_varloc(?st, 12, ?fn, 0, 102);
    if (sel rp.err) { code = 1; }

    bind.iid = 103; bind.cmp_op = mir.MIR_SEL_CBR_EQ; bind.cmp_width = 4;
    bind.lhs_is_imm = false; bind.vreg = 2;
    bind.rhs_is_imm = true;  bind.imm2 = 0;
    val rd: err[fail.Fail] = push_cmp_varloc(?st, 12, ?fn, ?bind);
    if (sel rd.err) { code = 1; }

    close_cmp_varlocs(?st, 12, 20);

    if (st.varloc_count != 4) { code = 1; }
    val a: *VarLoc = ?st.varlocs[0];
    if (a.kind != VARLOC_CMP)                     { code = 1; }
    if (a.sub_lhs != VARLOC_REG || a.reg != 7)    { code = 1; }
    if (a.sub_rhs != VARLOC_IMM || a.off2 != 40000) { code = 1; }
    if (a.cmp_rel != CMPREL_LT || a.cmp_signed)   { code = 1; }
    if (a.cmp_width != 2)                         { code = 1; }
    if (a.end_offset != 20)                       { code = 1; }
    val b: *VarLoc = ?st.varlocs[1];
    if (b.kind != VARLOC_CMP)                       { code = 1; }
    if (b.sub_lhs != VARLOC_FRAME || b.off != -16)  { code = 1; }
    if (b.sub_rhs != VARLOC_REG || b.reg2 != 7)     { code = 1; }
    if (b.cmp_rel != CMPREL_LE || !b.cmp_signed)    { code = 1; }
    if (b.end_offset != 20)                         { code = 1; }
    val c: *VarLoc = ?st.varlocs[2];
    if (c.kind != VARLOC_REG || c.end_offset != 0)  { code = 1; }
    val d: *VarLoc = ?st.varlocs[3];
    if (d.kind != VARLOC_NONE || d.iid != 103)      { code = 1; }

    if (st.varlocs != nil && st.varloc_cap > 0) { A.deallocate[VarLoc](?alloc, st.varlocs, st.varloc_cap::usize); }
    buf_dnit(?st.buf);
    ret code;
}

test "mach.lang.be.codegen.encode.push_varloc:slot_spill_owner_is_direct_frame" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var code: i32 = 0;

    var st: EncodeState;
    t_row_state(?alloc, ?st);

    var vregs: [1]mir.MirVReg;
    vregs[0].id = 0; vregs[0].class = 0; vregs[0].spill_slot = -1; vregs[0].assigned = mir.MIR_VREG_NIL;

    var slots: [1]mir.MirSlot;
    slots[0].value = 0; slots[0].kind = mir.SLOT_SPILL; slots[0].offset = -32; slots[0].size = 16; slots[0].align = 8;

    var fn: mir.MirFunction;
    fn.vregs = ?vregs[0]; fn.vreg_count = 1;
    fn.frame.slots = ?slots[0]; fn.frame.slot_count = 1; fn.frame.slot_cap = 1;
    fn.frame.size = 0; fn.frame.align = 0; fn.frame.outgoing_size = 0;

    val r: err[fail.Fail] = push_varloc(?st, 0, ?fn, 0, 200);
    if (sel r.err) { code = 1; }

    if (st.varloc_count != 1) { code = 1; }
    if (st.varlocs[0].kind != VARLOC_FRAME || st.varlocs[0].off != -32 || !st.varlocs[0].off_storage) { code = 1; }

    if (st.varlocs != nil && st.varloc_cap > 0) { A.deallocate[VarLoc](?alloc, st.varlocs, st.varloc_cap::usize); }
    buf_dnit(?st.buf);
    ret code;
}

test "mach.lang.be.codegen.encode.sink_unaccounted:tracks_unrendered_bytes" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: ByteBuf = buf_init(?alloc);

    var sink: AsmSink = sink_init(nil, nil);
    buf.asm = ?sink;

    var bad: i32 = 0;

    if (sink_unaccounted(?buf) != 0) { bad = 1; }

    emit_byte(?buf, 0x90);
    emit_byte(?buf, 0x90);
    emit_byte(?buf, 0x90);
    if (sink_unaccounted(?buf) != 3) { bad = 1; }

    sink_claim(?buf, 0);
    if (sink_unaccounted(?buf) != 0) { bad = 1; }

    emit_byte(?buf, 0xCC);
    emit_byte(?buf, 0xCC);
    if (sink_unaccounted(?buf) != 2) { bad = 1; }

    var plain: ByteBuf = buf_init(?alloc);
    emit_byte(?plain, 0x90);
    if (sink_unaccounted(?plain) != 0) { bad = 1; }

    buf_dnit(?plain);
    buf_dnit(?buf);
    ret bad;
}

test "mach.lang.be.codegen.encode.sink_claim:refuses_a_claim_that_skips_bytes" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: ByteBuf = buf_init(?alloc);

    var sink: AsmSink = sink_init(nil, nil);
    buf.asm = ?sink;

    var bad: i32 = 0;

    emit_u32(?buf, 0xD503201F);
    emit_u32(?buf, 0xD503201F);
    sink_claim(?buf, 4);

    if (sink_unaccounted(?buf) != 8) { bad = 1; }
    if (sink_claims(?buf) != 0)      { bad = 1; }
    if (sink.refused != 1)           { bad = 1; }

    var ok_buf: ByteBuf = buf_init(?alloc);
    var ok_sink: AsmSink = sink_init(nil, nil);
    ok_buf.asm = ?ok_sink;

    emit_u32(?ok_buf, 0xD503201F);
    sink_claim(?ok_buf, 0);
    emit_u32(?ok_buf, 0xD503201F);
    sink_claim(?ok_buf, 4);
    if (sink_unaccounted(?ok_buf) != 0) { bad = 1; }
    if (sink_claims(?ok_buf) != 2)      { bad = 1; }
    if (ok_sink.refused != 0)           { bad = 1; }

    sink_claim(?ok_buf, 8);
    if (sink_claims(?ok_buf) != 2) { bad = 1; }
    if (ok_sink.refused != 1)      { bad = 1; }

    buf_dnit(?ok_buf);
    buf_dnit(?buf);
    ret bad;
}

test "mach.lang.be.codegen.encode.intern_const:key_is_the_whole_identity" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var st: EncodeState;
    state_blank(?st, ?alloc, t_machine());
    st.interner = ?itn;

    var code: i32 = 0;

    var a: [8]u8;
    var b: [8]u8;
    var k: u32 = 0;
    for (k < 8) { a[k] = (0x11 * (k + 1))::u8; b[k] = (0x11 * (k + 1))::u8; k = k + 1; }

    val s0: res[intern.StrId, fail.Fail] = intern_const(?st, ?a[0], 8, CONST_F64);
    val s1: res[intern.StrId, fail.Fail] = intern_const(?st, ?b[0], 8, CONST_F64);
    if (sel s0.err) { ret 99; }
    if (sel s1.ok) {
        if (s0.ok != s1.ok) { code = 1; }
        if (st.const_count != 1) { code = 1; }
    }

    var c: [8]u8;
    k = 0;
    for (k < 8) { c[k] = a[k]; k = k + 1; }
    c[7] = c[7] ^ 0x01;
    val s2: res[intern.StrId, fail.Fail] = intern_const(?st, ?c[0], 8, CONST_F64);
    if (sel s2.ok) {
        if (s2.ok == s0.ok) { code = 1; }
        if (st.const_count != 2) { code = 1; }
    }

    val s3: res[intern.StrId, fail.Fail] = intern_const(?st, ?a[0], 8, CONST_VEC);
    if (sel s3.ok) {
        if (s3.ok == s0.ok) { code = 1; }
        if (st.const_count != 3) { code = 1; }
    }

    a[0] = 0xFF;
    if (st.consts[0].bytes[0] != 0x11) { code = 1; }
    if (st.consts[0].len != 8 || st.consts[0].kind != CONST_F64) { code = 1; }
    if (st.consts[2].kind != CONST_VEC) { code = 1; }

    val intern_const_r: res[intern.StrId, fail.Fail] = intern_const(?st, ?a[0], 0, CONST_F64);
    if (sel intern_const_r.ok) { code = 1; }

    consts_free(?alloc, st.consts, st.const_count, st.const_cap);
    buf_dnit(?st.buf);
    intern.dnit(?itn);
    ret code;
}

test "mach.lang.be.codegen.encode.intern_float_const:width_and_bit_pattern" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var st: EncodeState;
    state_blank(?st, ?alloc, t_machine());
    st.interner = ?itn;

    var code: i32 = 0;

    val f32r: res[intern.StrId, fail.Fail] = intern_float_const(?st, 0x3FC00000, 4);
    if (sel f32r.err) { code = 1; }
    if (sel f32r.ok) {
        if (st.const_count != 1)          { code = 1; }
        if (st.consts[0].len != 4)        { code = 1; }
        if (st.consts[0].align != 4)      { code = 1; }
        if (st.consts[0].kind != CONST_F32) { code = 1; }
        if (st.consts[0].bytes[0] != 0x00) { code = 1; }
        if (st.consts[0].bytes[1] != 0x00) { code = 1; }
        if (st.consts[0].bytes[2] != 0xC0) { code = 1; }
        if (st.consts[0].bytes[3] != 0x3F) { code = 1; }
    }

    val f64r: res[intern.StrId, fail.Fail] = intern_float_const(?st, 0x3FC0000000000000, 8);
    if (sel f64r.err) { code = 1; }
    if (sel f64r.ok) {
        if (st.const_count != 2)     { code = 1; }
        if (st.consts[1].len != 8)   { code = 1; }
        if (st.consts[1].align != 8) { code = 1; }
        if (st.consts[1].bytes[7] != 0x3F) { code = 1; }
        if (st.consts[1].bytes[0] != 0x00) { code = 1; }
    }

    val negz: res[intern.StrId, fail.Fail] = intern_float_const(?st, 0x8000000000000000, 8);
    val posz: res[intern.StrId, fail.Fail] = intern_float_const(?st, 0, 8);
    if (sel negz.err) { ret 99; }
    if (sel posz.ok) {
        if (negz.ok == posz.ok) { code = 1; }
        if (st.const_count != 4) { code = 1; }
        if (st.consts[2].bytes[7] != 0x80) { code = 1; }
        if (st.consts[3].bytes[7] != 0x00) { code = 1; }
    }

    consts_free(?alloc, st.consts, st.const_count, st.const_cap);
    buf_dnit(?st.buf);
    intern.dnit(?itn);
    ret code;
}

test "mach.lang.be.codegen.encode.const_align:one_rule_including_over_width" {
    var code: i32 = 0;
    if (const_align(CONST_F32, 4)  != 4)  { code = 1; }
    if (const_align(CONST_F64, 8)  != 8)  { code = 1; }
    if (const_align(CONST_VEC, 16) != 16) { code = 1; }
    if (const_align(CONST_VEC, 8)  != 8)  { code = 1; }
    if (const_align(CONST_VEC, 32) != 32) { code = 1; }
    if (const_align(CONST_VEC, 64) != 64) { code = 1; }
    if (const_align(CONST_VEC, 12) != 16) { code = 1; }
    ret code;
}

rec EncodeGrowthProbe {
    reallocate_calls: u32;
    allocate_calls:   u32;
}

fun encode_growth_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val g: *EncodeGrowthProbe = ctx::*EncodeGrowthProbe;
    g.allocate_calls = g.allocate_calls + 1;
    ret opt[ptr].none{};
}

fun encode_growth_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val g: *EncodeGrowthProbe = ctx::*EncodeGrowthProbe;
    g.reallocate_calls = g.reallocate_calls + 1;
    ret opt[ptr].none{};
}

fun encode_growth_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.be.codegen.encode.grow_cap:refuses_u32_capacity_overflow_before_reallocating" {
    var probe: EncodeGrowthProbe;
    probe.reallocate_calls = 0;
    probe.allocate_calls   = 0;
    var pp: *EncodeGrowthProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = encode_growth_probe_allocate;
    alloc.fn_reallocate = encode_growth_probe_reallocate;
    alloc.fn_deallocate = encode_growth_probe_deallocate;

    var dummy: SymbolMark;
    var data: *SymbolMark = ?dummy;
    var cap: u32 = 0xFFFFFFFF;

    val r: err[fail.Fail] = grow_cap[SymbolMark](?alloc, ?data, ?cap, DRIVER_INIT_CAP);

    var bad: i32 = 0;
    if (!sel r.err)      { bad = 1; }
    if (probe.reallocate_calls != 0)  { bad = 2; }
    if (probe.allocate_calls != 0)    { bad = 3; }
    if (cap != 0xFFFFFFFF)            { bad = 4; }
    ret bad;
}

test "mach.lang.be.codegen.encode.grow_cap:allocates_the_seed_capacity_when_empty" {
    var probe: EncodeGrowthProbe;
    probe.reallocate_calls = 0;
    probe.allocate_calls   = 0;
    var pp: *EncodeGrowthProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = encode_growth_probe_allocate;
    alloc.fn_reallocate = encode_growth_probe_reallocate;
    alloc.fn_deallocate = encode_growth_probe_deallocate;

    var data: *SymbolMark = nil;
    var cap: u32 = 0;

    val r: err[fail.Fail] = grow_cap[SymbolMark](?alloc, ?data, ?cap, DRIVER_INIT_CAP);

    var bad: i32 = 0;
    if (!sel r.err)      { bad = 1; }
    if (probe.allocate_calls != 1)    { bad = 2; }
    if (probe.reallocate_calls != 0)  { bad = 3; }
    ret bad;
}

test "mach.lang.be.codegen.encode.insert_text:refuses_growth_capacity_overflow_before_reallocating" {
    var probe: EncodeGrowthProbe;
    probe.reallocate_calls = 0;
    probe.allocate_calls   = 0;
    var pp: *EncodeGrowthProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = encode_growth_probe_allocate;
    alloc.fn_reallocate = encode_growth_probe_reallocate;
    alloc.fn_deallocate = encode_growth_probe_deallocate;

    var st: EncodeState;
    t_row_state(?alloc, ?st);

    val huge: usize = (~(0::usize) / 2) + 1;
    st.buf.cap = huge;
    st.buf.len = huge;

    val r: err[fail.Fail] = insert_text(?st, 0, 1);

    var bad: i32 = 0;
    if (sel r.ok)      { bad = 1; }
    if (probe.reallocate_calls != 0)  { bad = 2; }
    if (probe.allocate_calls != 0)    { bad = 3; }
    ret bad;
}

test "mach.lang.be.codegen.encode.emit_byte:doubling_is_still_exact_at_ordinary_scale" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var buf: ByteBuf = buf_init(?alloc);
    var i: usize = 0;
    for (i < (BYTEBUF_INIT_CAP * 3)) { emit_byte(?buf, 0xAB); i = i + 1; }

    var bad: i32 = 0;
    if (buf.len != BYTEBUF_INIT_CAP * 3) { bad = 1; }
    var j: usize = 0;
    for (j < buf.len) {
        if (buf.data[j] != 0xAB) { bad = 2; }
        j = j + 1;
    }
    buf_dnit(?buf);
    ret bad;
}

# the seed reader: a load declared writes_secret seeds its destination, a
# frame-slot operand seeds by its slot key, a precolored register and an
# immediate carry no origin, and a note with no MirInstr carries nothing

fun t_no_stream_encode(st: *EncodeState, f: *mir.MirFunction) err[fail.Fail] {
    ret err[fail.Fail].ok{};
}

fun t_no_stream_patch(st: *EncodeState, fx: *BranchFixup, target_off: u32) err[fail.Fail] {
    ret err[fail.Fail].ok{};
}

# an ISA that declares no notification stream cannot validate an oblivious
# function's final instructions and refuses the module, like the
# whole-module emitter does; without the contract the same module encodes
test "mach.lang.be.codegen.encode.encode_driver:an_isa_without_a_stream_refuses_an_oblivious_function" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var interner: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?interner); }
    var m: mir.MirModule = mir.MirModule{alloc: ?alloc, interner: ?interner};
    fin { mir.dnit_module(?m); }
    var f: mir.MirFunction;
    f.name      = intern.STR_NIL;
    f.oblivious = true;
    f.blocks    = nil;
    f.block_count = 0;
    f.vregs     = nil;
    f.vreg_count = 0;
    val push_function_r: err[fail.Fail] = mir.push_function(?m, f);
    if (sel push_function_r.err) { ret 2; }
    var bt: isa.BackendTarget;
    bt.model = @t_machine();
    bt.identity.arch_name = "silent";
    bt.abi.callee_saved = nil;
    var hooks: EncodeHooks = hooks_blank();
    hooks.encode_function = t_no_stream_encode;
    hooks.patch_branch    = t_no_stream_patch;
    hooks.stream          = false;
    val r: res[EncoderOutput, fail.Fail] = encode_module(?alloc, ?bt, ?m, ?hooks);
    if (sel r.ok) { ret 3; }
    if (!str_contains(fail.describe(r.err), "notifies no instruction stream")) { ret 4; }
    if (!str_contains(fail.describe(r.err), "silent")) { ret 5; }

    m.functions[0].oblivious = false;
    val ok: res[EncoderOutput, fail.Fail] = encode_module(?alloc, ?bt, ?m, ?hooks);
    if (sel ok.err) { ret 6; }
    val out: EncoderOutput = ok.ok;
    if (out.text_len != 0 || out.notified != 0) { ret 7; }
    ret 0;
}
