pub def EncoderOutput: encoding.EncoderOutput;
pub def LineRow:       encoding.LineRow;
pub def InlinePc:      encoding.InlinePc;
pub def VarLoc:        encoding.VarLoc;

pub val VARLOC_NONE:  u8 = encoding.VARLOC_NONE;
pub val VARLOC_REG:   u8 = encoding.VARLOC_REG;
pub val VARLOC_FRAME: u8 = encoding.VARLOC_FRAME;

fun varloc_slot_off(fn: *codegen_mir.MirFunction, si: u32) i64 {
    if (frame.slots_from_sp(?fn.frame)) {
        ret fn.frame.base_dist::i64 + fn.frame.slots[si].offset;
    }
    ret fn.frame.slots[si].offset - fn.frame.fp_dist::i64;
}

pub val VARLOC_CMP: u8 = encoding.VARLOC_CMP;
pub val VARLOC_IMM: u8 = encoding.VARLOC_IMM;

pub val CMPREL_EQ: u8 = encoding.CMPREL_EQ;
pub val CMPREL_NE: u8 = encoding.CMPREL_NE;
pub val CMPREL_LT: u8 = encoding.CMPREL_LT;
pub val CMPREL_LE: u8 = encoding.CMPREL_LE;

pub def PendingReloc: encoding.PendingReloc;
pub def SymbolMark:   encoding.SymbolMark;

pub val CONST_F32: u8 = encoding.CONST_F32;
val     CONST_F64: u8 = encoding.CONST_F64;
pub val CONST_VEC: u8 = encoding.CONST_VEC;

pub def ConstEntry: encoding.ConstEntry;

pub fun run(tgt: *binding.Binding, m: *codegen_mir.MirModule,
    asm_out: *io_writer.Writer) res[EncoderOutput, fail.Fail] {
    if (tgt == nil) { ret res[EncoderOutput, fail.Fail].err{fail.message("encode: nil target")}; }
    if (m == nil)   { ret res[EncoderOutput, fail.Fail].err{fail.message("encode: nil mir module")}; }
    val borrow: err[fail.Fail] = binding.live(tgt);
    if (sel borrow.err) { ret res[EncoderOutput, fail.Fail].err{borrow.err}; }
    if (tgt.arch == nil) {
        ret res[EncoderOutput, fail.Fail].err{fail.message("encode: target has no ISA vtable")};
    }
    if (tgt.arch.encode == nil) {
        ret res[EncoderOutput, fail.Fail].err{fail.message("encode: ISA registered no encoder")};
    }

    if (asm_out != nil) {
        if (!tgt.arch.has_assembly) {
            ret res[EncoderOutput, fail.Fail].err{fail.message("encode: the target architecture registered no assembly printer")};
        }
        val printed_r: res[isa.BackendTarget, fail.Fail] = binding.backend_target(tgt);
        if (sel printed_r.err) { ret res[EncoderOutput, fail.Fail].err{printed_r.err}; }
        var printed: isa.BackendTarget = printed_r.ok;
        ret tgt.arch.assembly.emit(m.alloc, ?printed, m, asm_out);
    }

    val backend_r: res[isa.BackendTarget, fail.Fail] = binding.backend_target(tgt);
    if (sel backend_r.err) { ret res[EncoderOutput, fail.Fail].err{backend_r.err}; }
    var backend_target: isa.BackendTarget = backend_r.ok;
    ret tgt.arch.encode(m.alloc, ?backend_target, m);
}

pub rec ByteBuf {
    data:  *u8;
    len:   usize;
    cap:   usize;
    alloc: *A.Allocator;
    asm:   *AsmSink;
    # a growth refusal is sticky: `emit_*` are void so a call site cannot meet
    # it, so the buffer records it and the encode boundary renders it as the
    # typed outcome. a failed buffer stops appending and stays releasable
    failed:   bool;
    fail_err: A.Error;
    # an encoder's own refusal of an instruction it cannot assemble, recorded
    # the same way and reported at the boundary; nil when none
    refusal: str;
    # the encoding variant the target writes its instructions in, which its
    # emitters read: 0 for the baseline encoding (x86-64's vex forms of its
    # sse instructions under avx)
    variant: u8;
}

pub rec AsmSink {
    out:        *io_writer.Writer;
    accounted:  usize;
    failed:     bool;
    err:        str;
    mi:         *codegen_mir.MirInstr;
    interner:   *intern.Interner;
    notes:      *AsmNote;
    note_count: u32;
    note_cap:   u32;
    note_insts: u32;
    claims:     u32;
    refused:    u32;
    # the functions noted so far, which keeps each one's block labels apart
    functions: u32;
}

# the stream records live in notes.mach so the walk that consumes them can
# sit beside the driver instead of inside it; the names stay reachable here
pub def AsmNote:   notes.AsmNote;
#[testing]
pub def NoteSeeds: notes.NoteSeeds;

pub val ASM_NOTE_INST:    u8 = notes.ASM_NOTE_INST;
pub val ASM_NOTE_FUNC:    u8 = notes.ASM_NOTE_FUNC;
pub val ASM_NOTE_BLOCK:   u8 = notes.ASM_NOTE_BLOCK;
pub val ASM_NOTE_BYTES:   u8 = notes.ASM_NOTE_BYTES;
pub val ASM_NOTE_BARRIER: u8 = notes.ASM_NOTE_BARRIER;
pub val ASM_NOTE_LABEL:   u8 = notes.ASM_NOTE_LABEL;

pub val ASM_NOTE_BYTES_WIDTH: usize = notes.ASM_NOTE_BYTES_WIDTH;

pub val NOTE_NO_LANDING: u32 = notes.NOTE_NO_LANDING;

pub fun sink_init(out: *io_writer.Writer, interner: *intern.Interner) AsmSink {
    var s: AsmSink;
    s.out        = out;
    s.accounted  = 0;
    s.failed     = false;
    s.err        = "";
    s.mi         = nil;
    s.interner   = interner;
    s.notes      = nil;
    s.note_count = 0;
    s.note_cap   = 0;
    s.note_insts = 0;
    s.claims     = 0;
    s.refused    = 0;
    s.functions  = 0;
    ret s;
}

pub fun note_blank() AsmNote {
    ret notes.note_blank();
}

pub fun note_push(buf: *ByteBuf, n: *AsmNote) err[fail.Fail] {
    if (!sink_active(buf)) { ret err[fail.Fail].ok{}; }
    val s: *AsmSink = buf.asm;
    if (s.note_count >= s.note_cap) {
        val res_grow: err[A.Error] = growth.reserve[AsmNote](buf.alloc, ?s.notes, ?s.note_cap, s.note_count::usize + 1);
        if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
    }
    s.notes[s.note_count] = @n;
    if (s.mi != nil) {
        s.notes[s.note_count].loc         = s.mi.loc;
        s.notes[s.note_count].inline_site = s.mi.inline_site;
        s.notes[s.note_count].mi          = s.mi;
    }
    if (n.kind == ASM_NOTE_INST || n.kind == ASM_NOTE_BYTES) {
        if (buf.len < n.off::usize || buf.len - n.off::usize > 0xFFFFFFFF::usize) {
            ret err[fail.Fail].err{fail.message("encode: instruction notification extent is outside the text range")};
        }
        s.notes[s.note_count].byte_len = (buf.len - n.off::usize)::u32;
    }
    s.note_count = s.note_count + 1;
    if (n.kind == ASM_NOTE_INST || n.kind == ASM_NOTE_BYTES) {
        s.note_insts = s.note_insts + 1;
        sink_claim(buf, n.off::usize);
    }
    ret err[fail.Fail].ok{};
}

# the barrier reaches the stream whether or not the move it selected to emitted
# bytes (a coalesced self-copy emits none); it follows the instruction's bytes
pub fun note_barrier(buf: *ByteBuf, mi: *codegen_mir.MirInstr) err[fail.Fail] {
    if (!sink_active(buf))                   { ret err[fail.Fail].ok{}; }
    if (!codegen_mir.instr_declassifies(mi)) { ret err[fail.Fail].ok{}; }
    var n: AsmNote = note_blank();
    n.kind = ASM_NOTE_BARRIER;
    n.off  = buf.len::u32;
    n.mi   = mi;
    ret note_push(buf, ?n);
}

pub fun note_insert_after(buf: *ByteBuf, idx: u32, n: *AsmNote, nbytes: u32) err[fail.Fail] {
    if (!sink_active(buf)) { ret err[fail.Fail].ok{}; }
    val s: *AsmSink = buf.asm;
    if (idx >= s.note_count) {
        ret err[fail.Fail].err{fail.message("encode: an instruction notification was inserted after an unknown one")};
    }
    if (n.kind == ASM_NOTE_INST && s.accounted + nbytes::usize != buf.len) {
        ret err[fail.Fail].err{fail.message("encode: an inserted instruction notification does not cover the text gap that was opened for it")};
    }
    if (s.note_count >= s.note_cap) {
        val res_grow: err[A.Error] = growth.reserve[AsmNote](buf.alloc, ?s.notes, ?s.note_cap, s.note_count::usize + 1);
        if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
    }
    var i:  u32 = s.note_count;
    val at: u32 = idx + 1;
    for (i > at) {
        s.notes[i] = s.notes[i - 1];
        i          = i - 1;
    }
    s.notes[at] = @n;
    if (n.kind == ASM_NOTE_INST) { s.notes[at].byte_len = nbytes; }
    s.note_count = s.note_count + 1;
    if (n.kind == ASM_NOTE_INST) {
        s.note_insts = s.note_insts + 1;
        s.claims     = s.claims + 1;
        s.accounted  = buf.len;
    }
    ret err[fail.Fail].ok{};
}

pub fun note_count(buf: *ByteBuf) u32 {
    if (!sink_active(buf)) { ret 0; }
    ret buf.asm.note_count;
}

pub fun note_at(buf: *ByteBuf, idx: u32) *AsmNote {
    if (!sink_active(buf))         { ret nil; }
    if (idx >= buf.asm.note_count) { ret nil; }
    ret ?buf.asm.notes[idx];
}

pub fun note_index_at(buf: *ByteBuf, off: u32) i32 {
    if (!sink_active(buf)) { ret -1; }
    val s: *AsmSink = buf.asm;
    var i: u32      = 0;
    for (i < s.note_count) {
        if (s.notes[i].kind == ASM_NOTE_INST && s.notes[i].off == off) { ret i::i32; }
        i = i + 1;
    }
    ret -1;
}

# the instruction note from `first` on whose bytes hold `pos` lands on the
# text offset `target`
pub fun note_set_landing(buf: *ByteBuf, first: u32, pos: u32, target: u32) {
    if (!sink_active(buf)) { ret; }
    val s: *AsmSink = buf.asm;
    var i: u32      = first;
    for (i < s.note_count) {
        val n: *AsmNote = ?s.notes[i];
        if (n.kind == ASM_NOTE_INST && n.off <= pos && pos - n.off < n.byte_len) {
            n.landing = target;
            ret;
        }
        i = i + 1;
    }
}

pub fun notes_reset(buf: *ByteBuf) {
    if (buf == nil || buf.asm == nil) { ret; }
    buf.asm.note_count = 0;
    buf.asm.note_insts = 0;
}

pub fun note_inst_count(buf: *ByteBuf) u32 {
    if (!sink_active(buf)) { ret 0; }
    ret buf.asm.note_insts;
}

pub fun notes_free(buf: *ByteBuf) {
    if (buf == nil || buf.asm == nil) { ret; }
    val s: *AsmSink = buf.asm;
    if (s.notes == nil || s.note_cap == 0) { ret; }
    A.deallocate[AsmNote](buf.alloc, s.notes, s.note_cap::usize);
    s.notes      = nil;
    s.note_count = 0;
    s.note_cap   = 0;
    s.note_insts = 0;
}

pub fun sink_fail(buf: *ByteBuf, msg: str) {
    if (buf == nil || buf.asm == nil) { ret; }
    if (buf.asm.failed)               { ret; }
    buf.asm.failed = true;
    buf.asm.err    = msg;
}

pub fun sink_active(buf: *ByteBuf) bool {
    if (buf == nil || buf.asm == nil) { ret false; }
    ret !buf.asm.failed;
}

# rendering is gated on a writer; notification and byte accounting are not
pub fun sink_renders(buf: *ByteBuf) bool {
    if (!sink_active(buf)) { ret false; }
    ret buf.asm.out != nil;
}

pub fun sink_claim(buf: *ByteBuf, start: usize) {
    if (buf == nil || buf.asm == nil) { ret; }
    val s: *AsmSink = buf.asm;
    if (start != s.accounted || buf.len <= start) {
        s.refused = s.refused + 1;
        ret;
    }
    s.accounted = buf.len;
    s.claims    = s.claims + 1;
}

pub fun render_bytes_text(out: *io_writer.Writer, bytes: *u8, n: usize) err[fail.Fail] {
    val ri: res[usize, io_writer.WriteError] = std_format.write_str(out, "  .byte ");
    if (sel ri.err) { ret err[fail.Fail].err{fail.write_refused(ri.err)}; }
    var i: usize = 0;
    for (i < n) {
        if (i > 0) {
            val rc: res[usize, io_writer.WriteError] = std_format.write_str(out, ", ");
            if (sel rc.err) { ret err[fail.Fail].err{fail.write_refused(rc.err)}; }
        }
        val rb: res[usize, io_writer.WriteError] = std_format.write_str(out, "0x");
        if (sel rb.err) { ret err[fail.Fail].err{fail.write_refused(rb.err)}; }
        var digits: [3]u8;
        encoding_hex.encode(?bytes[i], 1, ?digits[0], 3);
        val rh: res[usize, io_writer.WriteError] = std_format.write_str(out, (?digits[0])::str);
        if (sel rh.err) { ret err[fail.Fail].err{fail.write_refused(rh.err)}; }
        i = i + 1;
    }
    val rn: res[usize, io_writer.WriteError] = std_format.write_str(out, "\n");
    if (sel rn.err) { ret err[fail.Fail].err{fail.write_refused(rn.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun render_bytes_directive(buf: *ByteBuf, bytes: *u8, n: usize, start: usize) err[fail.Fail] {
    if (!sink_active(buf)) { ret err[fail.Fail].ok{}; }
    var note: AsmNote = note_blank();
    note.kind = ASM_NOTE_BYTES;
    note.off  = start::u32;
    val kept: err[fail.Fail] = note_push(buf, ?note);
    if (sel kept.err)       { ret kept; }
    if (!sink_renders(buf)) { ret err[fail.Fail].ok{}; }
    ret render_bytes_text(buf.asm.out, bytes, n);
}

pub fun sink_claims(buf: *ByteBuf) u32 {
    if (!sink_active(buf)) { ret 0; }
    ret buf.asm.claims;
}

pub fun sink_unaccounted(buf: *ByteBuf) usize {
    if (!sink_active(buf))            { ret 0; }
    if (buf.len <= buf.asm.accounted) { ret 0; }
    ret buf.len - buf.asm.accounted;
}

#[testing]
pub fun note_seeds(f: *codegen_mir.MirFunction, n: *AsmNote, out: *NoteSeeds) {
    notes.note_seeds(f, n, out);
}

pub fun sink_set_mir(buf: *ByteBuf, mi: *codegen_mir.MirInstr) {
    if (buf == nil || buf.asm == nil) { ret; }
    buf.asm.mi = mi;
}

pub fun buf_init(alloc: *A.Allocator) ByteBuf {
    var buf: ByteBuf;
    buf.data     = nil;
    buf.len      = 0;
    buf.cap      = 0;
    buf.alloc    = alloc;
    buf.asm      = nil;
    buf.failed   = false;
    buf.fail_err = A.Error.exhausted{};
    buf.refusal  = nil;
    buf.variant  = 0;
    ret buf;
}

# an encoder records that an instruction had no encoding for its operands;
# the first refusal is kept and the emission is reported failed at the
# function boundary, so the bytes a partial expansion left never ship
pub fun buf_refuse(buf: *ByteBuf, msg: str) {
    if (buf == nil || buf.refusal != nil) { ret; }
    buf.refusal = msg;
}

pub fun buf_dnit(buf: *ByteBuf) {
    if (buf == nil) { ret; }
    if (buf.data != nil && buf.cap > 0) {
        A.deallocate[u8](buf.alloc, buf.data, buf.cap);
        buf.data = nil;
    }
    buf.len = 0;
    buf.cap = 0;
}

pub fun emit_byte(buf: *ByteBuf, byte: u8) {
    if (buf.failed) { ret; }
    if (buf.len >= buf.cap) {
        val grown: err[A.Error] = growth.reserve_usize[u8](buf.alloc, ?buf.data, ?buf.cap, buf.len + 1);
        if (sel grown.err) {
            buf.failed   = true;
            buf.fail_err = grown.err;
            ret;
        }
    }
    buf.data[buf.len] = byte;
    buf.len           = buf.len + 1;
}

pub fun emit_u16(buf: *ByteBuf, value: u16) {
    emit_byte(buf, (value & 0xFF)::u8);
    emit_byte(buf, ((value >> 8) & 0xFF)::u8);
}

pub fun emit_u32(buf: *ByteBuf, value: u32) {
    emit_byte(buf, (value & 0xFF)::u8);
    emit_byte(buf, ((value >> 8) & 0xFF)::u8);
    emit_byte(buf, ((value >> 16) & 0xFF)::u8);
    emit_byte(buf, ((value >> 24) & 0xFF)::u8);
}

pub fun emit_u64(buf: *ByteBuf, value: u64) {
    emit_u32(buf, (value & 0xFFFFFFFF)::u32);
    emit_u32(buf, ((value >> 32) & 0xFFFFFFFF)::u32);
}

# the most registers an ABI register-file callback fills, as regalloc bounds it
val MAX_REG_FILE: i32 = 32;

pub rec BranchFixup {
    patch_pos:    u32;
    next_ip:      u32;
    target_block: u32;
    fn_text_base: u32;
}

rec BlockOffset {
    fn_text_base: u32;
    block_id:     u32;
    offset:       u32;
}

pub rec RelocPairSite {
    reloc_index: u32;
    label:       intern.StrId;
}

# the step a probed frame allocation touches the stack at: the smallest page any
# target has, so no guard a target keeps is narrower than it
pub val STACK_PROBE_INTERVAL: u64 = 4096;

pub rec EncodeState {
    alloc:             *A.Allocator;
    buf:               ByteBuf;
    syms:              *SymbolMark;
    sym_count:         u32;
    sym_cap:           u32;
    pcrel_label_count: u32;
    relocs:            *PendingReloc;
    reloc_count:       u32;
    reloc_cap:         u32;
    reloc_pair_sites:  map.Map[u64, RelocPairSite];
    fixups:            *BranchFixup;
    fixup_count:       u32;
    fixup_cap:         u32;
    blocks:            *BlockOffset;
    block_count:       u32;
    block_cap:         u32;
    block_index:       map.Map[u64, u32];
    rows:              *LineRow;
    row_count:         u32;
    row_cap:           u32;
    varlocs:           *VarLoc;
    varloc_count:      u32;
    varloc_cap:        u32;
    inline_pcs:        *InlinePc;
    inline_pc_count:   u32;
    inline_pc_cap:     u32;
    consts:            *ConstEntry;
    const_count:       u32;
    const_cap:         u32;
    frames:            *target_of.FrameUnwind;
    frame_count:       u32;
    frame_cap:         u32;
    last_inline_site:  u32;
    next_block_id:     u32;
    has_next_block:    bool;
    # the register locations published in this function and not yet ended
    open_regs:      *OpenReg;
    open_reg_count: u32;
    open_reg_cap:   u32;
    # the registers the previous instruction defined, one or (for a call or an
    # asm block) every caller-saved one: the clobber ends open locations at
    # the next instruction's start, where the offset is known
    pending_def:      bool;
    pending_def_call: bool;
    pending_def_reg:  i32;
    pending_def_at:   u32;
    # the previous instruction when it carries bindings published at its end:
    # they open at the next instruction's start, after its def's clobber
    pending_end: *codegen_mir.MirInstr;
    interner:    *intern.Interner;
    srcmap:      *lang_source.SourceMap;
    # the module's diagnostic store: where a refusal of the program lands
    diags:        *diagnostic.DiagnosticStore;
    model:        *target_model.Machine;
    callee_saved: isa.RegFileFn;
    base_addr:    u64;
    page_size:    u64;
    stack_probe:  bool;
    # an inline-asm block is being encoded: its relocations are the user's
    in_asm: bool;
}

# a variable location published as a register: the binding it describes and
# the instruction start it was published at
rec OpenReg {
    iid: u32;
    reg: i32;
    at:  u32;
}

def EncodeFunctionFn: fun(*EncodeState, *codegen_mir.MirFunction) err[fail.Fail];

def PatchBranchFn: fun(*EncodeState, *BranchFixup, u32) err[fail.Fail];

pub rec EncodeHooks {
    encode_function: EncodeFunctionFn;
    patch_branch:    PatchBranchFn;
    # declared: every emitted byte reaches the sink through one instruction notification
    stream: bool;
    # the per-instruction effect description the post-expansion walk reads
    effects: ctwalk.IsaEffects;
}

pub fun hooks_blank() EncodeHooks {
    var h: EncodeHooks;
    h.encode_function = nil;
    h.patch_branch    = nil;
    h.stream          = false;
    h.effects         = ctwalk.isa_effects_none();
    ret h;
}

fun module_has_oblivious(m: *codegen_mir.MirModule) bool {
    var fi: u32 = 0;
    for (fi < m.function_len) {
        if (m.functions[fi].oblivious) { ret true; }
        fi = fi + 1;
    }
    ret false;
}

pub fun encode_module(alloc: *A.Allocator, tgt: *isa.BackendTarget, m: *codegen_mir.MirModule, hooks: *EncodeHooks) res[EncoderOutput, fail.Fail] {
    ret encode_module_asm(alloc, tgt, m, hooks, nil);
}

# the refusal of the first oblivious function of a module whose encoder
# notifies no instruction stream, located at that function's declaration
fun no_stream_refusal(m: *codegen_mir.MirModule, tgt: *isa.BackendTarget) fail.Fail {
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val f: *codegen_mir.MirFunction = ?m.functions[fi];
        if (f.oblivious) {
            var r: res[str, fail.Fail] = res[str, fail.Fail].err{fail.reported()};
            if (m.interner == nil || intern.str_is_nil(f.name)) {
                r = fail.format(m.alloc, "an #[oblivious] function cannot be compiled for the `{}` target: its encoder notifies no instruction stream, so the emitted instructions cannot be validated constant-time",
                    tgt.identity.arch_name);
            }
            or {
                r = fail.format_intern(m.interner, m.alloc,
                    "#[oblivious] function `{}` cannot be compiled for the `{}` target: its encoder notifies no instruction stream, so the emitted instructions cannot be validated constant-time",
                    intern.text(m.interner, f.name), tgt.identity.arch_name);
            }
            if (sel r.err) { ret r.err; }
            ret codegen_mir.reject_function(m, diagnostic_kind.SECRET_TARGET_UNVERIFIABLE, f, r.ok);
        }
        fi = fi + 1;
    }
    ret fail.message(NO_STREAM_DETAIL);
}

val NO_STREAM_DETAIL: str = "an #[oblivious] function cannot be compiled for a target whose encoder notifies no instruction stream; the emitted instructions cannot be validated constant-time";

# the post-expansion walk over one function's notifications; a refusal is an
# error located at the refused instruction's source position, naming the
# function, on the module's diagnostic store
fun walk_function(st: *EncodeState, tgt: *isa.BackendTarget, hooks: *EncodeHooks, f: *codegen_mir.MirFunction) err[fail.Fail] {
    if (!sink_active(?st.buf)) {
        ret err[fail.Fail].err{fail.message("codegen: an #[oblivious] function reached the encoder with no instruction stream to validate")};
    }
    val s:  *AsmSink            = st.buf.asm;
    val wr: err[ctwalk.Refusal] = ctwalk.walk(f, s.notes, s.note_count, ?hooks.effects, tgt, st.alloc);
    if (sel wr.ok) { ret err[fail.Fail].ok{}; }
    var refusal: ctwalk.Refusal = wr.err;
    fin { ctwalk.refusal_free(st.alloc, ?refusal); }
    var loc: lang_source.Location = f.decl_loc;
    if (refusal.index < s.note_count && lang_source.location_is_valid(s.notes[refusal.index].loc)) { loc = s.notes[refusal.index].loc; }
    if (st.interner == nil || refusal.detail == nil || intern.str_is_nil(f.name)) {
        ret err[fail.Fail].err{codegen_mir.reject(st.diags, refusal.kind, loc, WALK_REFUSED_DETAIL)};
    }
    val rf: res[str, std_format.FormatError] = std_format.sprint(st.alloc, "#[oblivious] function `{}` {}",
        intern.text(st.interner, f.name), refusal.detail);
    if (sel rf.err) { ret err[fail.Fail].err{fail.format_refused(rf.err)}; }
    val body:    str       = rf.ok;
    val refused: fail.Fail = codegen_mir.reject(st.diags, refusal.kind, loc, body);
    # the store copied the text; a message failure keeps the scratch copy
    if (sel refused.reported) { A.deallocate[u8](st.alloc, body, str_len(body) + 1); }
    ret err[fail.Fail].err{refused};
}

val WALK_REFUSED_DETAIL: str = "an #[oblivious] function was refused by the post-expansion constant-time walk";

fun apply_emission_order_module(alloc: *A.Allocator, m: *codegen_mir.MirModule) err[fail.Fail] {
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val ao: err[fail.Fail] = apply_emission_order(alloc, ?m.functions[fi]);
        if (sel ao.err) { ret ao; }
        fi = fi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun apply_emission_order(alloc: *A.Allocator, f: *codegen_mir.MirFunction) err[fail.Fail] {
    val n: u32 = f.block_count;
    if (n <= 1 || f.emit_order == nil) { ret err[fail.Fail].ok{}; }

    val rt: res[*codegen_mir.MirBlock, A.Error] = A.allocate[codegen_mir.MirBlock](alloc, n::usize);
    if (sel rt.err) { ret err[fail.Fail].err{fail.refused(rt.err)}; }
    val tmp: *codegen_mir.MirBlock = rt.ok;

    var i: u32 = 0;
    for (i < n) {
        tmp[i] = f.blocks[f.emit_order[i]];
        i      = i + 1;
    }
    i = 0;
    for (i < n) {
        f.blocks[i] = tmp[i];
        i           = i + 1;
    }
    A.deallocate[codegen_mir.MirBlock](alloc, tmp, n::usize);

    i = 0;
    for (i < n) {
        f.emit_order[i] = i;
        i               = i + 1;
    }

    ret err[fail.Fail].ok{};
}

pub fun encode_module_asm(alloc: *A.Allocator, tgt: *isa.BackendTarget, m: *codegen_mir.MirModule,
    hooks: *EncodeHooks, asm_out: *io_writer.Writer) res[EncoderOutput, fail.Fail] {
    if (tgt == nil)                   { ret res[EncoderOutput, fail.Fail].err{fail.message("encode: nil target")}; }
    if (m == nil)                     { ret res[EncoderOutput, fail.Fail].err{fail.message("encode: nil mir module")}; }
    if (hooks == nil)                 { ret res[EncoderOutput, fail.Fail].err{fail.message("encode: nil encode hooks")}; }
    if (hooks.encode_function == nil) { ret res[EncoderOutput, fail.Fail].err{fail.message("encode: ISA supplied no per-function encode hook")}; }
    if (hooks.patch_branch == nil)    { ret res[EncoderOutput, fail.Fail].err{fail.message("encode: ISA supplied no per-branch patch hook")}; }

    val res_layout: err[fail.Fail] = apply_emission_order_module(alloc, m);
    if (sel res_layout.err) { ret res[EncoderOutput, fail.Fail].err{res_layout.err}; }

    var st: EncodeState;
    state_init(?st, alloc, m, tgt);
    var handed: bool = false;
    fin {
        if (!handed) { state_dnit(?st); }
    }

    # the stream exists under --emit-asm and on every build of a module with an
    # oblivious function; a nil writer notifies and claims without rendering.
    # an ISA without a stream cannot validate an oblivious function's final
    # instructions and refuses it, like the whole-module emitter does
    val oblivious: bool = module_has_oblivious(m);
    if (oblivious && !hooks.stream) { ret res[EncoderOutput, fail.Fail].err{no_stream_refusal(m, tgt)}; }
    var sink: AsmSink = sink_init(asm_out, m.interner);
    if (asm_out != nil || (hooks.stream && oblivious)) { st.buf.asm = ?sink; }
    fin { notes_free(?st.buf); }

    var notified: u32 = 0;
    var fi:       u32 = 0;
    for (fi < m.function_len) {
        st.last_inline_site = 0;
        begin_function_locations(?st);
        if (m.functions[fi].block_count > 0) {
            val padded: err[fail.Fail] = pad_entry(?st, entry_align(st.model, m.functions[fi].align));
            if (sel padded.err) { ret res[EncoderOutput, fail.Fail].err{padded.err}; }
        }
        val pre_sym_count: u32            = st.sym_count;
        val res_encode:    err[fail.Fail] = hooks.encode_function(?st, ?m.functions[fi]);
        if (sel res_encode.err)    { ret res[EncoderOutput, fail.Fail].err{res_encode.err}; }
        if (st.buf.failed)         { ret res[EncoderOutput, fail.Fail].err{fail.refused(st.buf.fail_err)}; }
        if (st.buf.refusal != nil) { ret res[EncoderOutput, fail.Fail].err{fail.message(st.buf.refusal)}; }
        if (st.sym_count > pre_sym_count) {
            st.syms[pre_sym_count].size = st.buf.len::u32 - st.syms[pre_sym_count].offset;
        }
        if (sink.failed) { brk; }
        # one function's notifications are complete here: the post-expansion
        # walk validates an oblivious function before the reset
        if (m.functions[fi].oblivious) {
            val vr: err[fail.Fail] = walk_function(?st, tgt, hooks, ?m.functions[fi]);
            if (sel vr.err) { ret res[EncoderOutput, fail.Fail].err{vr.err}; }
        }
        notified = notified + note_inst_count(?st.buf);
        notes_reset(?st.buf);
        fi = fi + 1;
    }

    if (sink.failed) { ret res[EncoderOutput, fail.Fail].err{fail.message(sink.err)}; }
    if (sink.refused > 0) {
        ret res[EncoderOutput, fail.Fail].err{fail.message("encode: an instruction notification claimed a byte range that does not begin where the previous one ended")};
    }
    if (sink_unaccounted(?st.buf) > 0) {
        ret res[EncoderOutput, fail.Fail].err{fail.message("encode: the encoder emitted bytes that no instruction notification claimed")};
    }
    notes_free(?st.buf);
    map.dnit[u64, RelocPairSite](?st.reloc_pair_sites);
    val res_patch: err[fail.Fail] = patch_branches(?st, hooks);
    if (sel res_patch.err) { ret res[EncoderOutput, fail.Fail].err{res_patch.err}; }

    val res_fit: err[A.Error] = tables_fit(?st);
    if (sel res_fit.err) { ret res[EncoderOutput, fail.Fail].err{fail.refused(res_fit.err)}; }

    var out: EncoderOutput;
    out.text            = st.buf.data;
    out.text_len        = st.buf.len::u32;
    out.relocations     = st.relocs;
    out.reloc_count     = st.reloc_count;
    out.symbols         = st.syms;
    out.symbol_count    = st.sym_count;
    out.rows            = st.rows;
    out.row_count       = st.row_count;
    out.inline_pcs      = st.inline_pcs;
    out.inline_pc_count = st.inline_pc_count;
    out.varlocs         = st.varlocs;
    out.varloc_count    = st.varloc_count;
    out.consts          = st.consts;
    out.const_count     = st.const_count;
    out.frames          = st.frames;
    out.frame_count     = st.frame_count;
    out.notified        = notified;

    handed = true;
    scratch_release(?st);
    ret res[EncoderOutput, fail.Fail].ok{out};
}

# a function's entry alignment: its own `#[align]` or the target's rule,
# whichever is larger
pub fun entry_align(model: *target_model.Machine, explicit: u32) u32 {
    var a: u32 = 1;
    if (model != nil && model.function_align > a) { a = model.function_align; }
    if (explicit > a)                             { a = explicit; }
    ret a;
}

# fills the text up to the next multiple of `align` with the target's fill
# byte. the padding is no instruction, so it reaches the sink as a claimed
# extent and an alignment directive, never as a note an instruction walk reads
fun pad_entry(st: *EncodeState, align: u32) err[fail.Fail] {
    val start: usize = st.buf.len;
    val n:     usize = (align::usize - start % align::usize) % align::usize;
    if (n == 0) { ret err[fail.Fail].ok{}; }
    var fill: u8 = 0;
    if (st.model != nil) { fill = st.model.code_fill; }
    var i: usize = 0;
    for (i < n) {
        emit_byte(?st.buf, fill);
        i = i + 1;
    }
    if (st.buf.failed || !sink_active(?st.buf)) { ret err[fail.Fail].ok{}; }
    if (sink_renders(?st.buf)) {
        val rr: res[usize, std_format.FormatError] = std_format.format(st.buf.asm.out, "  .balign {}, 0x{:x}\n", align::u64, fill::u64);
        if (sel rr.err) { ret err[fail.Fail].err{fail.format_refused(rr.err)}; }
    }
    sink_claim(?st.buf, start);
    ret err[fail.Fail].ok{};
}

pub fun classify_refs(mi: *codegen_mir.MirInstr, target_block: *u32, has_block: *bool,
    sym: *intern.StrId, has_sym: *bool, sym_addend: *i64) {
    @has_block    = false;
    @has_sym      = false;
    @target_block = 0;
    @sym          = intern.STR_NIL;
    @sym_addend   = 0;

    var found_block: bool = false;
    var found_sym:   bool = false;
    var i:           u32  = 0;
    for (i < mi.operand_count) {
        val op: *codegen_mir.MirOperand = ?mi.operands[i];
        if (op.kind == codegen_mir.MIR_OP_BLOCK && found_block == false) {
            found_block   = true;
            @has_block    = true;
            @target_block = op.imm::u32;
        }
        if (op.kind == codegen_mir.MIR_OP_SYM && found_sym == false) {
            found_sym   = true;
            @has_sym    = true;
            @sym        = op.sym;
            @sym_addend = op.sym_off;
        }
        if (found_block && found_sym) { brk; }
        i = i + 1;
    }
}

pub fun push_symbol(st: *EncodeState, name: intern.StrId, offset: u32, flags: u32) err[fail.Fail] {
    if (st.sym_count >= st.sym_cap) {
        val res_grow: err[A.Error] = growth.reserve[SymbolMark](st.alloc, ?st.syms, ?st.sym_cap, st.sym_count::usize + 1);
        if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
    }
    st.syms[st.sym_count].name   = name;
    st.syms[st.sym_count].offset = offset;
    st.syms[st.sym_count].size   = 0;
    st.syms[st.sym_count].flags  = flags;
    st.sym_count                 = st.sym_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun push_frame(st: *EncodeState, offset: u32) err[fail.Fail] {
    if (st.frame_count >= st.frame_cap) {
        val res_grow: err[A.Error] = growth.reserve[target_of.FrameUnwind](st.alloc, ?st.frames, ?st.frame_cap, st.frame_count::usize + 1);
        if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
    }
    st.frames[st.frame_count].section    = target_of.section_id(0);
    st.frames[st.frame_count].offset     = offset;
    st.frames[st.frame_count].step_count = 0;
    st.frame_count                       = st.frame_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun push_frame_step(st: *EncodeState, kind: u8, reg: u8, end_off: u32, value: u64) err[fail.Fail] {
    if (st.frame_count == 0) {
        ret err[fail.Fail].err{fail.message("encode: frame step recorded with no open frame record")};
    }
    val fr: *target_of.FrameUnwind = ?st.frames[st.frame_count - 1];
    if (fr.step_count >= target_of.FRAME_STEP_CAP) {
        ret err[fail.Fail].err{fail.message("encode: frame record step capacity exceeded")};
    }
    fr.steps[fr.step_count].kind    = kind;
    fr.steps[fr.step_count].reg     = reg;
    fr.steps[fr.step_count].end_off = end_off;
    fr.steps[fr.step_count].value   = value;
    fr.step_count                   = fr.step_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun push_reloc(st: *EncodeState, offset: u32, kind: target_of.RelocKind, sym: intern.StrId, addend: i64) err[fail.Fail] {
    ret push_inst_reloc(st, offset, kind, sym, addend, 0);
}

# a relocation whose field starts inst_end bytes before its instruction ends
pub fun push_inst_reloc(st: *EncodeState, offset: u32, kind: target_of.RelocKind, sym: intern.StrId, addend: i64,
    inst_end: u8) err[fail.Fail] {
    if (st.reloc_count >= st.reloc_cap) {
        val res_grow: err[A.Error] = growth.reserve[PendingReloc](st.alloc, ?st.relocs, ?st.reloc_cap, st.reloc_count::usize + 1);
        if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
    }
    st.relocs[st.reloc_count].offset   = offset;
    st.relocs[st.reloc_count].kind     = kind;
    st.relocs[st.reloc_count].sym      = sym;
    st.relocs[st.reloc_count].addend   = addend;
    st.relocs[st.reloc_count].pair     = 0;
    st.relocs[st.reloc_count].inst_end = inst_end;
    st.relocs[st.reloc_count].origin   = target_of.RELOC_CODEGEN;
    if (st.in_asm) { st.relocs[st.reloc_count].origin = target_of.RELOC_ASM; }
    st.reloc_count = st.reloc_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun bind_reloc_pair(st: *EncodeState, low_index: u32, high_index: u32) err[fail.Fail] {
    if (low_index >= st.reloc_count || high_index >= st.reloc_count) {
        ret err[fail.Fail].err{fail.message("encode: relocation pair index is out of range")};
    }
    if (low_index == high_index) {
        ret err[fail.Fail].err{fail.message("encode: a relocation cannot pair with itself")};
    }
    st.relocs[low_index].pair = high_index + 1;
    ret err[fail.Fail].ok{};
}

fun reloc_pair_key(high_kind: target_of.RelocKind, sym: intern.StrId) u64 {
    ret (high_kind::u64 << 32) | intern.str_index(sym)::u64;
}

pub fun bind_reloc_pair_site(st: *EncodeState, high_kind: target_of.RelocKind,
    sym: intern.StrId, reloc_index: u32) err[fail.Fail] {
    if (intern.str_is_nil(sym)) {
        ret err[fail.Fail].err{fail.message("encode: relocation pair has no target symbol")};
    }
    if (reloc_index >= st.reloc_count
        || st.relocs[reloc_index].kind != high_kind
        || !intern.str_same(st.relocs[reloc_index].sym, sym)) {
        ret err[fail.Fail].err{fail.message("encode: relocation pair site does not identify its high relocation")};
    }
    val key:  u64 = reloc_pair_key(high_kind, sym);
    var site: RelocPairSite;
    site.reloc_index = reloc_index;
    site.label       = intern.STR_NIL;
    val inserted: res[bool, A.Error] =
        map.insert[u64, RelocPairSite](?st.reloc_pair_sites, key, site);
    if (sel inserted.err) {
        ret err[fail.Fail].err{fail.refused(inserted.err)};
    }
    ret err[fail.Fail].ok{};
}

pub fun reloc_pair_site(st: *EncodeState, high_kind: target_of.RelocKind,
    sym: intern.StrId) res[*RelocPairSite, fail.Fail] {
    val key:   u64                 = reloc_pair_key(high_kind, sym);
    val found: opt[*RelocPairSite] =
        map.get[u64, RelocPairSite](?st.reloc_pair_sites, ?key);
    if (sel found.none) { ret res[*RelocPairSite, fail.Fail].err{fail.message("encode: relocation pair site is absent")}; }
    val site: *RelocPairSite = found.some;
    if (site.reloc_index >= st.reloc_count
        || st.relocs[site.reloc_index].kind != high_kind
        || !intern.str_same(st.relocs[site.reloc_index].sym, sym)) {
        ret res[*RelocPairSite, fail.Fail].err{fail.message("encode: relocation pair site no longer identifies its high relocation")};
    }
    ret res[*RelocPairSite, fail.Fail].ok{site};
}

fun const_align(kind: u8, len: u32) u32 {
    if (kind == CONST_F32) { ret 4; }
    if (kind == CONST_F64) { ret 8; }
    var a: u32 = 1;
    for (a < len) { a = a * 2; }
    ret a;
}

pub fun intern_const(st: *EncodeState, bytes: *u8, len: u32, kind: u8) res[intern.StrId, fail.Fail] {
    if (len == 0) { ret res[intern.StrId, fail.Fail].err{fail.message("encode: a constant-pool entry has no bytes")}; }
    if (st.interner == nil) {
        ret res[intern.StrId, fail.Fail].err{fail.message("encode: the constant pool needs an interner to name its entries")};
    }
    val align: u32 = const_align(kind, len);

    var i: u32 = 0;
    for (i < st.const_count) {
        val e: *ConstEntry = ?st.consts[i];
        if (e.kind == kind && e.len == len && e.align == align &&
            memory.raw_equal(e.bytes::ptr, bytes::ptr, len::usize)) {
            ret res[intern.StrId, fail.Fail].ok{e.sym};
        }
        i = i + 1;
    }

    if (st.const_count >= st.const_cap) {
        val res_grow: err[A.Error] = growth.reserve[ConstEntry](st.alloc, ?st.consts, ?st.const_cap, st.const_count::usize + 1);
        if (sel res_grow.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(res_grow.err)}; }
    }

    var name:   [32]u8;
    val prefix: str   = ".Lconst.";
    var k:      usize = 0;
    for (k < 8) {
        name[k] = prefix[k]::u8;
        k       = k + 1;
    }
    k       = put_decimal(?name[0], k, st.const_count::usize);
    name[k] = 0;
    val res_sym: res[intern.StrId, A.Error] = intern.add(st.interner, (?name[0])::str);
    if (sel res_sym.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(res_sym.err)}; }

    val res_copy: res[*u8, A.Error] = A.allocate[u8](st.alloc, len::usize);
    if (sel res_copy.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(res_copy.err)}; }
    val buf: *u8 = res_copy.ok;
    memory.raw_copy(buf::ptr, bytes::ptr, len::usize);

    st.consts[st.const_count].bytes = buf;
    st.consts[st.const_count].len   = len;
    st.consts[st.const_count].align = align;
    st.consts[st.const_count].kind  = kind;
    st.consts[st.const_count].sym   = res_sym.ok;
    st.const_count                  = st.const_count + 1;
    ret res[intern.StrId, fail.Fail].ok{st.consts[st.const_count - 1].sym};
}

pub fun intern_local_label(st: *EncodeState, prefix: str, ordinal: u32) res[intern.StrId, fail.Fail] {
    var name: [64]u8;
    val plen: usize = str_len(prefix);
    if (plen + 24 >= 64) {
        ret res[intern.StrId, fail.Fail].err{fail.message("encode: local label prefix is too long to spell")};
    }
    var k: usize = 0;
    for (k < plen) {
        name[k] = prefix[k]::u8;
        k       = k + 1;
    }
    k       = put_decimal(?name[0], k, ordinal::usize);
    name[k] = 0;
    val intern_r: res[intern.StrId, A.Error] = intern.add(st.interner, (?name[0])::str);
    if (sel intern_r.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(intern_r.err)}; }
    ret res[intern.StrId, fail.Fail].ok{intern_r.ok};
}

pub fun intern_float_const(st: *EncodeState, bits: u64, width: u8) res[intern.StrId, fail.Fail] {
    var img: [8]u8;
    var i:   u32 = 0;
    for (i < width::u32) {
        img[i] = (bits >> (i::u64 * 8::u64))::u8;
        i      = i + 1;
    }
    var kind: u8 = CONST_F64;
    if (width == 4) { kind = CONST_F32; }
    ret intern_const(st, ?img[0], width::u32, kind);
}

pub fun push_fixup(st: *EncodeState, patch_pos: u32, next_ip: u32, target_block: u32, fn_text_base: u32) err[fail.Fail] {
    if (st.fixup_count >= st.fixup_cap) {
        val res_grow: err[A.Error] = growth.reserve[BranchFixup](st.alloc, ?st.fixups, ?st.fixup_cap, st.fixup_count::usize + 1);
        if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
    }
    st.fixups[st.fixup_count].patch_pos    = patch_pos;
    st.fixups[st.fixup_count].next_ip      = next_ip;
    st.fixups[st.fixup_count].target_block = target_block;
    st.fixups[st.fixup_count].fn_text_base = fn_text_base;
    st.fixup_count                         = st.fixup_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun push_block(st: *EncodeState, fn_text_base: u32, block_id: u32, offset: u32) err[fail.Fail] {
    if (st.block_count >= st.block_cap) {
        val res_grow: err[A.Error] = growth.reserve[BlockOffset](st.alloc, ?st.blocks, ?st.block_cap, st.block_count::usize + 1);
        if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
    }
    st.blocks[st.block_count].fn_text_base = fn_text_base;
    st.blocks[st.block_count].block_id     = block_id;
    st.blocks[st.block_count].offset       = offset;
    st.block_count                         = st.block_count + 1;
    ret index_block(st, st.block_count - 1);
}

fun block_key(fn_text_base: u32, block_id: u32) u64 {
    ret ((fn_text_base::u64) << 32) | (block_id::u64);
}

# the first record of a (function base, block id) pair is the one a lookup
# finds, as the scan it replaces did
fun index_block(st: *EncodeState, bi: u32) err[fail.Fail] {
    val key: u64 = block_key(st.blocks[bi].fn_text_base, st.blocks[bi].block_id);
    if (map.contains[u64, u32](?st.block_index, ?key)) { ret err[fail.Fail].ok{}; }
    val inserted: res[bool, A.Error] = map.insert[u64, u32](?st.block_index, key, bi);
    if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
    ret err[fail.Fail].ok{};
}

# a text gap moves function bases, which are part of the key
fun reindex_blocks(st: *EncodeState) err[fail.Fail] {
    map.clear[u64, u32](?st.block_index);
    var bi: u32 = 0;
    for (bi < st.block_count) {
        val r: err[fail.Fail] = index_block(st, bi);
        if (sel r.err) { ret r; }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun set_fallthrough(st: *EncodeState, f: *codegen_mir.MirFunction, bi: u32) {
    if (bi + 1 < f.block_count) {
        st.has_next_block = true;
        st.next_block_id  = f.blocks[bi + 1].id;
    }
    or {
        st.has_next_block = false;
        st.next_block_id  = 0;
    }
}

pub fun branch_falls_through(st: *EncodeState, target_block: u32) bool {
    ret st.has_next_block && st.next_block_id == target_block;
}

# a conditional branch whose then arm is the next block and whose else arm is
# not jumps to the else arm on the inverse condition and falls into the then arm
pub fun cbr_inverts(st: *EncodeState, then_block: u32, else_block: u32) bool {
    ret branch_falls_through(st, then_block) && !branch_falls_through(st, else_block);
}

pub fun push_row(st: *EncodeState, text_offset: u32, loc: lang_source.Location) err[fail.Fail] {
    if (!lang_source.location_is_valid(loc)) { ret err[fail.Fail].ok{}; }
    if (st.row_count >= st.row_cap) {
        val res_grow: err[A.Error] = growth.reserve[LineRow](st.alloc, ?st.rows, ?st.row_cap, st.row_count::usize + 1);
        if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
    }
    st.rows[st.row_count].text_offset = text_offset;
    st.rows[st.row_count].sec         = 0;
    st.rows[st.row_count].loc         = loc;
    st.row_count                      = st.row_count + 1;
    ret err[fail.Fail].ok{};
}

fun push_varloc(st: *EncodeState, text_offset: u32, fn: *codegen_mir.MirFunction, vreg: u32, iid: u32) err[fail.Fail] {
    var kind:    u8   = VARLOC_NONE;
    var reg:     i32  = 0;
    var off:     i64  = 0;
    var storage: bool = false;
    if (vreg != codegen_mir.MIR_VREG_NIL.n && vreg < fn.vreg_count) {
        val vr: *codegen_mir.MirVReg = ?fn.vregs[vreg];
        # a vreg that addresses a frame slot describes the slot: the storage outlives
        # the register that reaches it, and an aggregate does not fit in one anyway
        if (vr.home_key != codegen_mir.MIR_VREG_NIL.n) {
            var hi: u32 = 0;
            for (hi < fn.frame.slot_count) {
                if (fn.frame.slots[hi].value == vr.home_key) {
                    kind    = VARLOC_FRAME;
                    off     = varloc_slot_off(fn, hi);
                    storage = true;
                }
                hi = hi + 1;
            }
        }
        or (!codegen_mir.preg_is_nil(vr.assigned)) {
            kind = VARLOC_REG;
            reg  = codegen_mir.preg_regid(vr.assigned);
        }
        or (vr.spill_slot >= 0) {
            var si: u32 = 0;
            for (si < fn.frame.slot_count) {
                if (fn.frame.slots[si].value == vreg) {
                    kind = VARLOC_FRAME;
                    off  = varloc_slot_off(fn, si);
                }
                si = si + 1;
            }
        }
        or {
            var si: u32 = 0;
            for (si < fn.frame.slot_count) {
                if (fn.frame.slots[si].value == vreg && fn.frame.slots[si].kind == codegen_mir.SLOT_SPILL) {
                    kind    = VARLOC_FRAME;
                    off     = varloc_slot_off(fn, si);
                    storage = true;
                }
                si = si + 1;
            }
        }
    }

    ret append_varloc(st, text_offset, iid, kind, reg, off, storage);
}

# a variable whose value is the constant `value` from here, held in no storage
fun push_const_varloc(st: *EncodeState, text_offset: u32, value: i64, iid: u32) err[fail.Fail] {
    ret append_varloc(st, text_offset, iid, VARLOC_IMM, 0, value, false);
}

fun append_varloc(st: *EncodeState, text_offset: u32, iid: u32, kind: u8, reg: i32, off: i64, storage: bool) err[fail.Fail] {
    if (st.varloc_count >= st.varloc_cap) {
        val res_grow: err[A.Error] = growth.reserve[VarLoc](st.alloc, ?st.varlocs, ?st.varloc_cap, st.varloc_count::usize + 1);
        if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
    }
    st.varlocs[st.varloc_count].text_offset = text_offset;
    st.varlocs[st.varloc_count].sec         = 0;
    st.varlocs[st.varloc_count].iid         = iid;
    st.varlocs[st.varloc_count].kind        = kind;
    st.varlocs[st.varloc_count].reg         = reg;
    st.varlocs[st.varloc_count].off         = off;
    st.varlocs[st.varloc_count].off_storage = storage;
    varloc_clear_cmp(?st.varlocs[st.varloc_count]);
    st.varloc_count = st.varloc_count + 1;
    ret err[fail.Fail].ok{};
}

fun varloc_clear_cmp(vl: *VarLoc) {
    vl.end_offset       = 0;
    vl.piece            = 0;
    vl.pieces           = 0;
    vl.piece_bytes      = 0;
    vl.piece_last_bytes = 0;
    vl.sub_lhs          = VARLOC_NONE;
    vl.sub_rhs          = VARLOC_NONE;
    vl.reg2             = 0;
    vl.off2             = 0;
    vl.cmp_rel          = 0;
    vl.cmp_signed       = false;
    vl.cmp_width        = 0;
}

fun cmp_operand_home(fn: *codegen_mir.MirFunction, is_imm: bool, vreg: u32, imm: i64,
    out_kind: *u8, out_reg: *i32, out_off: *i64) {
    @out_kind = VARLOC_NONE;
    @out_reg  = 0;
    @out_off  = 0;
    if (is_imm) {
        @out_kind = VARLOC_IMM;
        @out_off  = imm;
        ret;
    }
    if (vreg >= fn.vreg_count) { ret; }
    val vr: *codegen_mir.MirVReg = ?fn.vregs[vreg];
    if (!codegen_mir.preg_is_nil(vr.assigned)) {
        @out_kind = VARLOC_REG;
        @out_reg  = codegen_mir.preg_regid(vr.assigned);
        ret;
    }
    if (vr.spill_slot >= 0) {
        var si: u32 = 0;
        for (si < fn.frame.slot_count) {
            if (fn.frame.slots[si].value == vreg) {
                @out_kind = VARLOC_FRAME;
                @out_off  = varloc_slot_off(fn, si);
            }
            si = si + 1;
        }
    }
}

fun push_cmp_varloc(st: *EncodeState, text_offset: u32, fn: *codegen_mir.MirFunction, bind: *codegen_mir.MirDbgBinding) err[fail.Fail] {
    var lk: u8  = VARLOC_NONE;
    var lr: i32 = 0;
    var lo: i64 = 0;
    var rk: u8  = VARLOC_NONE;
    var rr: i32 = 0;
    var ro: i64 = 0;
    cmp_operand_home(fn, bind.lhs_is_imm, bind.vreg, bind.imm, ?lk, ?lr, ?lo);
    cmp_operand_home(fn, bind.rhs_is_imm, bind.vreg2, bind.imm2, ?rk, ?rr, ?ro);
    if (lk == VARLOC_NONE || rk == VARLOC_NONE) {
        ret push_varloc(st, text_offset, fn, codegen_mir.MIR_VREG_NIL.n, bind.iid);
    }

    var rel: u8 = CMPREL_EQ;
    if (bind.cmp_op == codegen_mir.MIR_SEL_CBR_NE)                                                  { rel = CMPREL_NE; }
    or (bind.cmp_op == codegen_mir.MIR_SEL_CBR_LT_S || bind.cmp_op == codegen_mir.MIR_SEL_CBR_LT_U) { rel = CMPREL_LT; }
    or (bind.cmp_op == codegen_mir.MIR_SEL_CBR_LE_S || bind.cmp_op == codegen_mir.MIR_SEL_CBR_LE_U) { rel = CMPREL_LE; }

    if (st.varloc_count >= st.varloc_cap) {
        val res_grow: err[A.Error] = growth.reserve[VarLoc](st.alloc, ?st.varlocs, ?st.varloc_cap, st.varloc_count::usize + 1);
        if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
    }
    val vl: *VarLoc = ?st.varlocs[st.varloc_count];
    vl.text_offset      = text_offset;
    vl.sec              = 0;
    vl.iid              = bind.iid;
    vl.kind             = VARLOC_CMP;
    vl.reg              = lr;
    vl.off              = lo;
    vl.off_storage      = false;
    vl.end_offset       = 0;
    vl.sub_lhs          = lk;
    vl.sub_rhs          = rk;
    vl.reg2             = rr;
    vl.off2             = ro;
    vl.cmp_rel          = rel;
    vl.cmp_signed       = codegen_mir.is_signed_cmp(bind.cmp_op);
    vl.cmp_width        = bind.cmp_width;
    vl.piece            = 0;
    vl.pieces           = 0;
    vl.piece_bytes      = 0;
    vl.piece_last_bytes = 0;
    st.varloc_count     = st.varloc_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun close_cmp_varlocs(st: *EncodeState, instr_start: u32, instr_end: u32) {
    var i: u32 = st.varloc_count;
    for (i > 0) {
        i = i - 1;
        val vl: *VarLoc = ?st.varlocs[i];
        if (vl.text_offset != instr_start)               { ret; }
        if (vl.kind == VARLOC_CMP && vl.end_offset == 0) { vl.end_offset = instr_end; }
    }
}

# a function's locations start closed and with no def outstanding
fun begin_function_locations(st: *EncodeState) {
    st.open_reg_count = 0;
    st.pending_def    = false;
    st.pending_end    = nil;
}

fun open_reg_push(st: *EncodeState, iid: u32, reg: i32, at: u32) err[fail.Fail] {
    if (st.open_reg_count >= st.open_reg_cap) {
        val grown: err[A.Error] = growth.reserve[OpenReg](st.alloc, ?st.open_regs, ?st.open_reg_cap, st.open_reg_count::usize + 1);
        if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    }
    st.open_regs[st.open_reg_count].iid = iid;
    st.open_regs[st.open_reg_count].reg = reg;
    st.open_regs[st.open_reg_count].at  = at;
    st.open_reg_count                   = st.open_reg_count + 1;
    ret err[fail.Fail].ok{};
}

# drop every open location of a binding published before `at`; the lanes of one
# binding are published together at one instruction and stay together
fun open_reg_drop(st: *EncodeState, iid: u32, at: u32) {
    var i: u32 = 0;
    for (i < st.open_reg_count) {
        if (st.open_regs[i].iid == iid && st.open_regs[i].at != at) {
            st.open_regs[i]   = st.open_regs[st.open_reg_count - 1];
            st.open_reg_count = st.open_reg_count - 1;
        }
        or { i = i + 1; }
    }
}

# the register the instruction defines, in the allocator's convention: the
# first operand of a shaped instruction when it is a register
fun instr_def_reg(mi: *codegen_mir.MirInstr, out_reg: *i32) bool {
    if (!codegen_mir.instr_defines_shape(mi))           { ret false; }
    if (mi.operands[0].kind != codegen_mir.MIR_OP_PREG) { ret false; }
    if (codegen_mir.preg_is_nil(mi.operands[0].preg))   { ret false; }
    @out_reg = codegen_mir.preg_regid(mi.operands[0].preg);
    ret true;
}

# whether the ABI keeps the register across a call; with no declared set every
# register is the callee's to clobber
fun reg_is_callee_saved(st: *EncodeState, reg: i32) bool {
    if (st.callee_saved == nil) { ret false; }
    var regs: [MAX_REG_FILE]target_model.Register;
    val n:    i32 = st.callee_saved(?regs[0]);
    var i:    i32 = 0;
    for (i < n && i < MAX_REG_FILE) {
        if (regs[i].id == reg) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the previous instruction's def reaches the register: its one
# destination, or every caller-saved register when it was a call or an asm
# block, the set the allocator treats a call as clobbering
fun pending_def_clobbers(st: *EncodeState, reg: i32) bool {
    if (st.pending_def_call) { ret !reg_is_callee_saved(st, reg); }
    ret reg == st.pending_def_reg;
}

# the previous instruction's def has clobbered the register: every location
# published on it by an earlier instruction is lost from here, and says so
# with a homeless record. a location the defining instruction itself carried
# describes that def and stands
fun end_clobbered_locations(st: *EncodeState, fn: *codegen_mir.MirFunction, at: u32) err[fail.Fail] {
    if (!st.pending_def) { ret err[fail.Fail].ok{}; }
    st.pending_def = false;
    var i: u32 = 0;
    for (i < st.open_reg_count) {
        val o: *OpenReg = ?st.open_regs[i];
        if (pending_def_clobbers(st, o.reg) && o.at != st.pending_def_at) {
            val iid:  u32            = o.iid;
            val lost: err[fail.Fail] = push_varloc(st, at, fn, codegen_mir.MIR_VREG_NIL.n, iid);
            if (sel lost.err) { ret lost; }
            open_reg_drop(st, iid, at);
            i = 0;
        }
        or { i = i + 1; }
    }
    ret err[fail.Fail].ok{};
}

# the bindings of an instruction open at its start, and the ones it publishes
# at its end open at the next instruction's start, the same offset, once the
# locations its def clobbered are ended
pub fun emit_var_bindings(st: *EncodeState, fn: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr) err[fail.Fail] {
    val at:    u32            = st.buf.len::u32;
    val ended: err[fail.Fail] = end_clobbered_locations(st, fn, at);
    if (sel ended.err) { ret ended; }
    if (st.pending_end != nil) {
        val prev: *codegen_mir.MirInstr = st.pending_end;
        st.pending_end = nil;
        val closed: err[fail.Fail] = publish_bindings(st, fn, prev, true, at);
        if (sel closed.err) { ret closed; }
    }
    var def_reg: i32 = 0;
    if (mi.opcode == codegen_mir.MIR_CALL || mi.asm_block != nil) {
        st.pending_def      = true;
        st.pending_def_call = true;
        st.pending_def_at   = at;
    }
    or (instr_def_reg(mi, ?def_reg)) {
        st.pending_def      = true;
        st.pending_def_call = false;
        st.pending_def_reg  = def_reg;
        st.pending_def_at   = at;
    }
    var i: u32 = 0;
    for (i < mi.dbg_binding_count) {
        if (mi.dbg_bindings[i].at_end) { st.pending_end = mi; }
        i = i + 1;
    }
    ret publish_bindings(st, fn, mi, false, at);
}

# publish the bindings of `mi` that open at its end, or the ones at its start
fun publish_bindings(st: *EncodeState, fn: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr, at_end: bool, at: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < mi.dbg_binding_count) {
        val bind: *codegen_mir.MirDbgBinding = ?mi.dbg_bindings[i];
        if (bind.at_end != at_end) {
            i = i + 1;
            cnt;
        }
        var r: err[fail.Fail] = err[fail.Fail].ok{};
        if (bind.cmp_op != 0) { r = push_cmp_varloc(st, at, fn, bind); }
        or (bind.lhs_is_imm)  { r = push_const_varloc(st, at, bind.imm, bind.iid); }
        or                    { r = push_varloc(st, at, fn, bind.vreg, bind.iid); }
        if (sel r.err)        { ret r; }
        val vl: *VarLoc = ?st.varlocs[st.varloc_count - 1];
        if (bind.cmp_op == 0 && bind.lanes != 0) {
            vl.piece            = bind.lane;
            vl.pieces           = bind.lanes;
            vl.piece_bytes      = bind.lane_bytes;
            vl.piece_last_bytes = bind.last_bytes;
        }
        # the binding's earlier register locations are superseded by this one
        open_reg_drop(st, bind.iid, at);
        if (vl.kind == VARLOC_REG) {
            val opened: err[fail.Fail] = open_reg_push(st, bind.iid, vl.reg, at);
            if (sel opened.err) { ret opened; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun state_init(st: *EncodeState, alloc: *A.Allocator, m: *codegen_mir.MirModule, tgt: *isa.BackendTarget) {
    state_blank(st, alloc, ?tgt.model);
    st.interner     = m.interner;
    st.srcmap       = m.srcmap;
    st.diags        = m.diags;
    st.callee_saved = tgt.abi.callee_saved;
    st.base_addr    = tgt.os.image_base;
    st.page_size    = tgt.os.page_size;
    st.stack_probe  = tgt.os.stack_probe;
}

pub fun state_blank(st: *EncodeState, alloc: *A.Allocator, model: *target_model.Machine) {
    st.model             = model;
    st.callee_saved      = nil;
    st.base_addr         = 0;
    st.page_size         = 0;
    st.stack_probe       = false;
    st.in_asm            = false;
    st.alloc             = alloc;
    st.buf               = buf_init(alloc);
    st.syms              = nil;
    st.sym_count         = 0;
    st.pcrel_label_count = 0;
    st.sym_cap           = 0;
    st.relocs            = nil;
    st.reloc_count       = 0;
    st.reloc_cap         = 0;
    st.reloc_pair_sites  = map.init[u64, RelocPairSite](alloc);
    st.fixups            = nil;
    st.fixup_count       = 0;
    st.fixup_cap         = 0;
    st.blocks            = nil;
    st.block_count       = 0;
    st.block_cap         = 0;
    st.block_index       = map.init[u64, u32](alloc);
    st.rows              = nil;
    st.row_count         = 0;
    st.row_cap           = 0;
    st.varlocs           = nil;
    st.varloc_count      = 0;
    st.varloc_cap        = 0;
    st.inline_pcs        = nil;
    st.inline_pc_count   = 0;
    st.inline_pc_cap     = 0;
    st.consts            = nil;
    st.const_count       = 0;
    st.const_cap         = 0;
    st.frames            = nil;
    st.frame_count       = 0;
    st.frame_cap         = 0;
    st.last_inline_site  = 0;
    st.next_block_id     = 0;
    st.has_next_block    = false;
    st.open_regs         = nil;
    st.open_reg_count    = 0;
    st.open_reg_cap      = 0;
    st.pending_def       = false;
    st.pending_def_call  = false;
    st.pending_def_reg   = 0;
    st.pending_def_at    = 0;
    st.pending_end       = nil;
    st.interner          = nil;
    st.srcmap            = nil;
    st.diags             = nil;
}

fun state_dnit(st: *EncodeState) {
    buf_dnit(?st.buf);
    if (st.syms != nil && st.sym_cap > 0) {
        A.deallocate[SymbolMark](st.alloc, st.syms, st.sym_cap::usize);
    }
    st.syms              = nil;
    st.sym_count         = 0;
    st.pcrel_label_count = 0;
    st.sym_cap           = 0;
    if (st.relocs != nil && st.reloc_cap > 0) {
        A.deallocate[PendingReloc](st.alloc, st.relocs, st.reloc_cap::usize);
    }
    st.relocs      = nil;
    st.reloc_count = 0;
    st.reloc_cap   = 0;
    if (st.rows != nil && st.row_cap > 0) {
        A.deallocate[LineRow](st.alloc, st.rows, st.row_cap::usize);
    }
    st.rows      = nil;
    st.row_count = 0;
    st.row_cap   = 0;
    if (st.varlocs != nil && st.varloc_cap > 0) {
        A.deallocate[VarLoc](st.alloc, st.varlocs, st.varloc_cap::usize);
    }
    st.varlocs      = nil;
    st.varloc_count = 0;
    st.varloc_cap   = 0;
    if (st.inline_pcs != nil && st.inline_pc_cap > 0) {
        A.deallocate[InlinePc](st.alloc, st.inline_pcs, st.inline_pc_cap::usize);
    }
    st.inline_pcs      = nil;
    st.inline_pc_count = 0;
    st.inline_pc_cap   = 0;
    if (st.open_regs != nil && st.open_reg_cap > 0) {
        A.deallocate[OpenReg](st.alloc, st.open_regs, st.open_reg_cap::usize);
    }
    st.open_regs      = nil;
    st.open_reg_count = 0;
    st.open_reg_cap   = 0;
    consts_free(st.alloc, st.consts, st.const_count, st.const_cap);
    st.consts      = nil;
    st.const_count = 0;
    st.const_cap   = 0;
    if (st.frames != nil && st.frame_cap > 0) {
        A.deallocate[target_of.FrameUnwind](st.alloc, st.frames, st.frame_cap::usize);
    }
    st.frames      = nil;
    st.frame_count = 0;
    st.frame_cap   = 0;
    scratch_release(st);
}

pub fun consts_free(alloc: *A.Allocator, c: *ConstEntry, count: u32, cap: u32) {
    if (c == nil) { ret; }
    var i: u32 = 0;
    for (i < count) {
        if (c[i].bytes != nil && c[i].len > 0) {
            A.deallocate[u8](alloc, c[i].bytes, c[i].len::usize);
        }
        i = i + 1;
    }
    if (cap > 0) { A.deallocate[ConstEntry](alloc, c, cap::usize); }
}

fun scratch_release(st: *EncodeState) {
    map.dnit[u64, RelocPairSite](?st.reloc_pair_sites);
    if (st.fixups != nil && st.fixup_cap > 0) {
        A.deallocate[BranchFixup](st.alloc, st.fixups, st.fixup_cap::usize);
    }
    st.fixups      = nil;
    st.fixup_count = 0;
    st.fixup_cap   = 0;
    if (st.blocks != nil && st.block_cap > 0) {
        A.deallocate[BlockOffset](st.alloc, st.blocks, st.block_cap::usize);
    }
    st.blocks      = nil;
    st.block_count = 0;
    st.block_cap   = 0;
    map.dnit[u64, u32](?st.block_index);
}

# give each table the encoder hands off exactly its count
fun tables_fit(st: *EncodeState) err[A.Error] {
    val r1: err[A.Error] = growth.resize_usize[u8](st.alloc, ?st.buf.data, ?st.buf.cap, st.buf.len);
    if (sel r1.err) { ret r1; }
    val r2: err[A.Error] = growth.resize[ConstEntry](st.alloc, ?st.consts, ?st.const_cap, st.const_count::usize);
    if (sel r2.err) { ret r2; }
    val r3: err[A.Error] = growth.resize[SymbolMark](st.alloc, ?st.syms, ?st.sym_cap, st.sym_count::usize);
    if (sel r3.err) { ret r3; }
    val r4: err[A.Error] = growth.resize[PendingReloc](st.alloc, ?st.relocs, ?st.reloc_cap, st.reloc_count::usize);
    if (sel r4.err) { ret r4; }
    val r5: err[A.Error] = growth.resize[LineRow](st.alloc, ?st.rows, ?st.row_cap, st.row_count::usize);
    if (sel r5.err) { ret r5; }
    val r6: err[A.Error] = growth.resize[VarLoc](st.alloc, ?st.varlocs, ?st.varloc_cap, st.varloc_count::usize);
    if (sel r6.err) { ret r6; }
    val r7: err[A.Error] = growth.resize[InlinePc](st.alloc, ?st.inline_pcs, ?st.inline_pc_cap, st.inline_pc_count::usize);
    if (sel r7.err) { ret r7; }
    ret growth.resize[target_of.FrameUnwind](st.alloc, ?st.frames, ?st.frame_cap, st.frame_count::usize);
}

fun patch_branches(st: *EncodeState, hooks: *EncodeHooks) err[fail.Fail] {
    if (st.buf.data == nil) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < st.fixup_count) {
        val fx:      *BranchFixup        = ?st.fixups[i];
        val res_off: res[u32, fail.Fail] = block_offset(st, fx.fn_text_base, fx.target_block);
        if (sel res_off.err) { ret err[fail.Fail].err{res_off.err}; }
        val target_off: u32            = res_off.ok;
        val res_patch:  err[fail.Fail] = hooks.patch_branch(st, fx, target_off);
        if (sel res_patch.err) { ret res_patch; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun block_offset(st: *EncodeState, fn_base: u32, block_id: u32) res[u32, fail.Fail] {
    val key:   u64       = block_key(fn_base, block_id);
    val found: opt[*u32] = map.get[u64, u32](?st.block_index, ?key);
    if (sel found.some) { ret res[u32, fail.Fail].ok{st.blocks[@found.some].offset}; }
    ret res[u32, fail.Fail].err{fail.message("encode: branch target block was never recorded")};
}

pub fun insert_text(st: *EncodeState, pos: u32, nbytes: u32) err[fail.Fail] {
    if (nbytes == 0) { ret err[fail.Fail].ok{}; }
    val p: usize = pos::usize;
    val n: usize = nbytes::usize;
    if (p > st.buf.len) {
        ret err[fail.Fail].err{fail.message("encode: text-gap offset is past the end of the buffer")};
    }

    val need_r: res[lang_checked.Count[lang_checked.ByteUnit], lang_checked.Cause] =
        lang_checked.count_add[lang_checked.ByteUnit](lang_checked.count[lang_checked.ByteUnit](st.buf.len), lang_checked.count[lang_checked.ByteUnit](n));
    if (sel need_r.err) {
        ret err[fail.Fail].err{fail.message("encode: text-gap size overflow")};
    }
    val need:  usize        = need_r.ok.value;
    val grown: err[A.Error] = growth.reserve_usize[u8](st.buf.alloc, ?st.buf.data, ?st.buf.cap, need);
    if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }

    var i: usize = st.buf.len;
    for (i > p) {
        i                  = i - 1;
        st.buf.data[i + n] = st.buf.data[i];
    }
    var z: usize = p;
    for (z < p + n) {
        st.buf.data[z] = 0;
        z              = z + 1;
    }
    st.buf.len = need;

    var bi:          u32  = 0;
    var bases_moved: bool = false;
    for (bi < st.block_count) {
        if (st.blocks[bi].offset >= pos) { st.blocks[bi].offset = st.blocks[bi].offset + nbytes; }
        if (st.blocks[bi].fn_text_base >= pos) {
            st.blocks[bi].fn_text_base = st.blocks[bi].fn_text_base + nbytes;
            bases_moved                = true;
        }
        bi = bi + 1;
    }
    if (bases_moved) {
        val reindexed: err[fail.Fail] = reindex_blocks(st);
        if (sel reindexed.err) { ret reindexed; }
    }
    var fi: u32 = 0;
    for (fi < st.fixup_count) {
        if (st.fixups[fi].patch_pos >= pos)    { st.fixups[fi].patch_pos = st.fixups[fi].patch_pos + nbytes; }
        if (st.fixups[fi].next_ip >= pos)      { st.fixups[fi].next_ip = st.fixups[fi].next_ip + nbytes; }
        if (st.fixups[fi].fn_text_base >= pos) { st.fixups[fi].fn_text_base = st.fixups[fi].fn_text_base + nbytes; }
        fi = fi + 1;
    }
    var si: u32 = 0;
    for (si < st.sym_count) {
        if (st.syms[si].offset >= pos) { st.syms[si].offset = st.syms[si].offset + nbytes; }
        si = si + 1;
    }
    var ri: u32 = 0;
    for (ri < st.reloc_count) {
        if (st.relocs[ri].offset >= pos) { st.relocs[ri].offset = st.relocs[ri].offset + nbytes; }
        ri = ri + 1;
    }
    var fri: u32 = 0;
    for (fri < st.frame_count) {
        if (st.frames[fri].offset >= pos) { st.frames[fri].offset = st.frames[fri].offset + nbytes; }
        fri = fri + 1;
    }
    var wi: u32 = 0;
    for (wi < st.row_count) {
        if (st.rows[wi].text_offset >= pos) { st.rows[wi].text_offset = st.rows[wi].text_offset + nbytes; }
        wi = wi + 1;
    }
    var vli: u32 = 0;
    for (vli < st.varloc_count) {
        if (st.varlocs[vli].text_offset >= pos) { st.varlocs[vli].text_offset = st.varlocs[vli].text_offset + nbytes; }
        if (st.varlocs[vli].end_offset != 0 && st.varlocs[vli].end_offset >= pos) {
            st.varlocs[vli].end_offset = st.varlocs[vli].end_offset + nbytes;
        }
        vli = vli + 1;
    }
    var ipi: u32 = 0;
    for (ipi < st.inline_pc_count) {
        if (st.inline_pcs[ipi].text_offset >= pos) { st.inline_pcs[ipi].text_offset = st.inline_pcs[ipi].text_offset + nbytes; }
        ipi = ipi + 1;
    }
    if (st.buf.asm != nil) {
        var ni: u32 = 0;
        for (ni < st.buf.asm.note_count) {
            if (st.buf.asm.notes[ni].off >= pos) { st.buf.asm.notes[ni].off = st.buf.asm.notes[ni].off + nbytes; }
            val land: u32 = st.buf.asm.notes[ni].landing;
            if (land != NOTE_NO_LANDING && land >= pos) { st.buf.asm.notes[ni].landing = land + nbytes; }
            ni = ni + 1;
        }
    }
    ret err[fail.Fail].ok{};
}

pub fun push_inline_pc(st: *EncodeState, text_offset: u32, inline_site: u32) err[fail.Fail] {
    if (inline_site == st.last_inline_site) { ret err[fail.Fail].ok{}; }
    if (st.inline_pc_count >= st.inline_pc_cap) {
        val res_grow: err[A.Error] = growth.reserve[InlinePc](st.alloc, ?st.inline_pcs, ?st.inline_pc_cap, st.inline_pc_count::usize + 1);
        if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
    }
    st.inline_pcs[st.inline_pc_count].text_offset = text_offset;
    st.inline_pcs[st.inline_pc_count].sec         = 0;
    st.inline_pcs[st.inline_pc_count].inline_site = inline_site;
    st.inline_pc_count                            = st.inline_pc_count + 1;
    st.last_inline_site                           = inline_site;
    ret err[fail.Fail].ok{};
}

fun put_decimal(buf: *u8, at: usize, n: usize) usize {
    ret at + std_format.put_u64(?buf[at], n::u64);
}

# an opcode no encoder arm names is a member the selector produced outside the
# native catalog: internal, named with the function it was found in
pub fun opcode_failure(st: *EncodeState, f: *codegen_mir.MirFunction, architecture: str, opcode: u32) err[fail.Fail] {
    if (st.interner == nil) { ret err[fail.Fail].err{fail.message("encode: opcode failure has no diagnostic owner")}; }
    val catalog: res[str, fail.Fail] = fail.format_intern(st.interner, st.alloc, "{}.Opcode", architecture);
    if (sel catalog.err) { ret err[fail.Fail].err{catalog.err}; }
    var where: str = "";
    if (!intern.str_is_nil(f.name)) {
        val quoted: res[str, fail.Fail] = fail.format_intern(st.interner, st.alloc, "'{}'", intern.text(st.interner, f.name));
        if (sel quoted.err) { ret err[fail.Fail].err{quoted.err}; }
        where = quoted.ok;
    }
    val member: fail.Catalog = fail.unknown_member_in(catalog.ok, opcode, where);
    ret err[fail.Fail].err{fail.message_of(fail.catalog_interned(st.interner, st.alloc, member))};
}

# `msg` prefixed with the file, line and column of `loc`, interned; `msg` as
# it is where the state carries no source map or `loc` names no place
pub fun asm_located_message(st: *EncodeState, loc: lang_source.Location, msg: str) res[str, fail.Fail] {
    if (st.srcmap == nil || st.interner == nil) { ret res[str, fail.Fail].ok{msg}; }
    if (!lang_source.location_is_valid(loc))    { ret res[str, fail.Fail].ok{msg}; }
    val fo: opt[*lang_source.SourceFile] = lang_source.get(st.srcmap, loc.file);
    if (sel fo.none) { ret res[str, fail.Fail].ok{msg}; }
    val file: *lang_source.SourceFile = fo.some;
    val pos:  lang_source.Position    = lang_source.position(file, loc.span.offset);
    ret fail.format_intern(st.interner, st.alloc, "{}:{}:{}: {}", file.path, pos.line::u64, pos.col::u64, msg);
}

#[testing]
var t_model: target_model.Machine;

#[testing]
fun t_machine() *target_model.Machine {
    t_model.pointer_width = 8;
    t_model.gpr_width     = 8;
    target_model.declare_alu_widths(?t_model, target_model.ALU_WIDTHS_4_8);
    t_model.spill_width = 8;
    t_model.flen_bits   = 64;
    ret ?t_model;
}

#[testing]
fun t_row_state(alloc: *A.Allocator, st: *EncodeState) {
    state_blank(st, alloc, t_machine());
}

test insert_text__shifts_line_rows {
    var alloc: A.Allocator;
    page.make(?alloc);

    var st: EncodeState;
    t_row_state(?alloc, ?st);

    var i: u32 = 0;
    for (i < 12) {
        emit_byte(?st.buf, 0x90);
        i = i + 1;
    }

    val r0: err[fail.Fail] = push_row(?st, 0, lang_source.location(lang_source.file_id(1), lang_source.span(100, 1)));
    if (sel r0.err) { ret 1; }
    val r1: err[fail.Fail] = push_row(?st, 4, lang_source.location(lang_source.file_id(1), lang_source.span(200, 1)));
    if (sel r1.err) { ret 1; }
    val rn: err[fail.Fail] = push_row(?st, 4, lang_source.location_nil());
    if (sel rn.err) { ret 1; }
    val r2: err[fail.Fail] = push_row(?st, 8, lang_source.location(lang_source.file_id(1), lang_source.span(300, 1)));
    if (sel r2.err) { ret 1; }
    if (st.row_count != 3) {
        buf_dnit(?st.buf);
        ret 1;
    }

    val it: err[fail.Fail] = insert_text(?st, 4, 4);
    if (sel it.err) {
        buf_dnit(?st.buf);
        ret 1;
    }

    var code: i32 = 0;
    if (st.rows[0].text_offset != 0)       { code = 1; }
    if (st.rows[1].text_offset != 8)       { code = 1; }
    if (st.rows[2].text_offset != 12)      { code = 1; }
    if (st.rows[1].loc.span.offset != 200) { code = 1; }

    buf_dnit(?st.buf);
    if (st.rows != nil && st.row_cap > 0) { A.deallocate[LineRow](?alloc, st.rows, st.row_cap::usize); }
    ret code;
}

test push_varloc__homes_by_assignment {
    var alloc: A.Allocator;
    page.make(?alloc);
    var code: i32 = 0;

    var st: EncodeState;
    t_row_state(?alloc, ?st);

    var vregs: [4]codegen_mir.MirVReg;
    vregs[0].id         = 0;
    vregs[0].class      = 0;
    vregs[0].spill_slot = -1;
    vregs[0].home_key   = codegen_mir.MIR_VREG_NIL.n;
    vregs[0].assigned   = codegen_mir.preg_id(7);
    vregs[1].id         = 1;
    vregs[1].class      = 0;
    vregs[1].spill_slot = 0;
    vregs[1].home_key   = codegen_mir.MIR_VREG_NIL.n;
    vregs[1].assigned   = codegen_mir.MIR_PREG_NIL;
    vregs[2].id         = 2;
    vregs[2].class      = 0;
    vregs[2].spill_slot = -1;
    vregs[2].home_key   = codegen_mir.MIR_VREG_NIL.n;
    vregs[2].assigned   = codegen_mir.MIR_PREG_NIL;
    # a slot the vreg owns directly, with no spill index, is a storage home
    vregs[3].id         = 3;
    vregs[3].class      = 0;
    vregs[3].spill_slot = -1;
    vregs[3].home_key   = codegen_mir.MIR_VREG_NIL.n;
    vregs[3].assigned   = codegen_mir.MIR_PREG_NIL;

    var slots: [2]codegen_mir.MirSlot;
    slots[0].value  = 1;
    slots[0].kind   = codegen_mir.SLOT_SPILL;
    slots[0].offset = -16;
    slots[0].size   = 8;
    slots[0].align  = 8;
    slots[1].value  = 3;
    slots[1].kind   = codegen_mir.SLOT_SPILL;
    slots[1].offset = -32;
    slots[1].size   = 16;
    slots[1].align  = 8;

    var fn: codegen_mir.MirFunction;
    fn.vregs               = ?vregs[0];
    fn.vreg_count          = 4;
    fn.frame.slots         = ?slots[0];
    fn.frame.slot_count    = 2;
    fn.frame.slot_cap      = 2;
    fn.frame.size          = 0;
    fn.frame.align         = 0;
    fn.frame.outgoing_size = 0;

    val ra: err[fail.Fail] = push_varloc(?st, 0, ?fn, 0, 100);
    if (sel ra.err) { code = 1; }
    val rb: err[fail.Fail] = push_varloc(?st, 4, ?fn, 1, 101);
    if (sel rb.err) { code = 1; }
    val rc: err[fail.Fail] = push_varloc(?st, 8, ?fn, 2, 102);
    if (sel rc.err) { code = 1; }
    val rd: err[fail.Fail] = push_varloc(?st, 12, ?fn, 3, 103);
    if (sel rd.err) { code = 1; }

    if (st.varloc_count != 4)                                                                         { code = 1; }
    if (st.varlocs[0].kind != VARLOC_REG || st.varlocs[0].reg != 7 || st.varlocs[0].iid != 100)       { code = 1; }
    if (st.varlocs[1].kind != VARLOC_FRAME || st.varlocs[1].off != -16 || st.varlocs[1].iid != 101)   { code = 1; }
    if (st.varlocs[2].kind != VARLOC_NONE || st.varlocs[2].iid != 102)                                { code = 1; }
    if (st.varlocs[3].kind != VARLOC_FRAME || st.varlocs[3].off != -32 || !st.varlocs[3].off_storage) { code = 2; }

    if (st.varlocs != nil && st.varloc_cap > 0) { A.deallocate[VarLoc](?alloc, st.varlocs, st.varloc_cap::usize); }
    buf_dnit(?st.buf);
    ret code;
}

test push_cmp_varloc__homes_digest_and_close {
    var alloc: A.Allocator;
    page.make(?alloc);
    var code: i32 = 0;

    var st: EncodeState;
    t_row_state(?alloc, ?st);

    var vregs: [3]codegen_mir.MirVReg;
    vregs[0].id         = 0;
    vregs[0].class      = 0;
    vregs[0].spill_slot = -1;
    vregs[0].home_key   = codegen_mir.MIR_VREG_NIL.n;
    vregs[0].assigned   = codegen_mir.preg_id(7);
    vregs[1].id         = 1;
    vregs[1].class      = 0;
    vregs[1].spill_slot = 0;
    vregs[1].home_key   = codegen_mir.MIR_VREG_NIL.n;
    vregs[1].assigned   = codegen_mir.MIR_PREG_NIL;
    vregs[2].id         = 2;
    vregs[2].class      = 0;
    vregs[2].spill_slot = -1;
    vregs[2].home_key   = codegen_mir.MIR_VREG_NIL.n;
    vregs[2].assigned   = codegen_mir.MIR_PREG_NIL;

    var slots: [1]codegen_mir.MirSlot;
    slots[0].value  = 1;
    slots[0].kind   = codegen_mir.SLOT_SPILL;
    slots[0].offset = -16;
    slots[0].size   = 8;
    slots[0].align  = 8;

    var fn: codegen_mir.MirFunction;
    fn.vregs               = ?vregs[0];
    fn.vreg_count          = 3;
    fn.frame.slots         = ?slots[0];
    fn.frame.slot_count    = 1;
    fn.frame.slot_cap      = 1;
    fn.frame.size          = 0;
    fn.frame.align         = 0;
    fn.frame.outgoing_size = 0;

    var bind: codegen_mir.MirDbgBinding;
    bind.iid        = 100;
    bind.cmp_op     = codegen_mir.MIR_SEL_CBR_LT_U;
    bind.cmp_width  = 2;
    bind.lhs_is_imm = false;
    bind.vreg       = 0;
    bind.imm        = 0;
    bind.rhs_is_imm = true;
    bind.vreg2      = codegen_mir.MIR_VREG_NIL.n;
    bind.imm2       = 40000;
    val ra: err[fail.Fail] = push_cmp_varloc(?st, 12, ?fn, ?bind);
    if (sel ra.err) { code = 1; }

    bind.iid        = 101;
    bind.cmp_op     = codegen_mir.MIR_SEL_CBR_LE_S;
    bind.cmp_width  = 8;
    bind.lhs_is_imm = false;
    bind.vreg       = 1;
    bind.rhs_is_imm = false;
    bind.vreg2      = 0;
    val rb: err[fail.Fail] = push_cmp_varloc(?st, 12, ?fn, ?bind);
    if (sel rb.err) { code = 1; }

    val rp: err[fail.Fail] = push_varloc(?st, 12, ?fn, 0, 102);
    if (sel rp.err) { code = 1; }

    bind.iid        = 103;
    bind.cmp_op     = codegen_mir.MIR_SEL_CBR_EQ;
    bind.cmp_width  = 4;
    bind.lhs_is_imm = false;
    bind.vreg       = 2;
    bind.rhs_is_imm = true;
    bind.imm2       = 0;
    val rd: err[fail.Fail] = push_cmp_varloc(?st, 12, ?fn, ?bind);
    if (sel rd.err) { code = 1; }

    close_cmp_varlocs(?st, 12, 20);

    if (st.varloc_count != 4) { code = 1; }
    val a: *VarLoc = ?st.varlocs[0];
    if (a.kind != VARLOC_CMP)                       { code = 1; }
    if (a.sub_lhs != VARLOC_REG || a.reg != 7)      { code = 1; }
    if (a.sub_rhs != VARLOC_IMM || a.off2 != 40000) { code = 1; }
    if (a.cmp_rel != CMPREL_LT || a.cmp_signed)     { code = 1; }
    if (a.cmp_width != 2)                           { code = 1; }
    if (a.end_offset != 20)                         { code = 1; }
    val b: *VarLoc = ?st.varlocs[1];
    if (b.kind != VARLOC_CMP)                      { code = 1; }
    if (b.sub_lhs != VARLOC_FRAME || b.off != -16) { code = 1; }
    if (b.sub_rhs != VARLOC_REG || b.reg2 != 7)    { code = 1; }
    if (b.cmp_rel != CMPREL_LE || !b.cmp_signed)   { code = 1; }
    if (b.end_offset != 20)                        { code = 1; }
    val c: *VarLoc = ?st.varlocs[2];
    if (c.kind != VARLOC_REG || c.end_offset != 0) { code = 1; }
    val d: *VarLoc = ?st.varlocs[3];
    if (d.kind != VARLOC_NONE || d.iid != 103) { code = 1; }

    if (st.varlocs != nil && st.varloc_cap > 0) { A.deallocate[VarLoc](?alloc, st.varlocs, st.varloc_cap::usize); }
    buf_dnit(?st.buf);
    ret code;
}

test sink_claim__refuses_a_claim_that_skips_bytes {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: ByteBuf = buf_init(?alloc);

    var sink: AsmSink = sink_init(nil, nil);
    buf.asm = ?sink;

    var bad: i32 = 0;

    emit_u32(?buf, 0xD503201F);
    emit_u32(?buf, 0xD503201F);
    sink_claim(?buf, 4);

    if (sink_unaccounted(?buf) != 8) { bad = 1; }
    if (sink_claims(?buf) != 0)      { bad = 1; }
    if (sink.refused != 1)           { bad = 1; }

    var ok_buf:  ByteBuf = buf_init(?alloc);
    var ok_sink: AsmSink = sink_init(nil, nil);
    ok_buf.asm = ?ok_sink;

    emit_u32(?ok_buf, 0xD503201F);
    sink_claim(?ok_buf, 0);
    emit_u32(?ok_buf, 0xD503201F);
    sink_claim(?ok_buf, 4);
    if (sink_unaccounted(?ok_buf) != 0) { bad = 1; }
    if (sink_claims(?ok_buf) != 2)      { bad = 1; }
    if (ok_sink.refused != 0)           { bad = 1; }

    sink_claim(?ok_buf, 8);
    if (sink_claims(?ok_buf) != 2) { bad = 1; }
    if (ok_sink.refused != 1)      { bad = 1; }

    buf_dnit(?ok_buf);
    buf_dnit(?buf);
    ret bad;
}

test intern_const__key_is_the_whole_identity {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var st: EncodeState;
    state_blank(?st, ?alloc, t_machine());
    st.interner = ?itn;

    var code: i32 = 0;

    var a: [8]u8;
    var b: [8]u8;
    var k: u32 = 0;
    for (k < 8) {
        a[k] = (0x11 * (k + 1))::u8;
        b[k] = (0x11 * (k + 1))::u8;
        k    = k + 1;
    }

    val s0: res[intern.StrId, fail.Fail] = intern_const(?st, ?a[0], 8, CONST_F64);
    val s1: res[intern.StrId, fail.Fail] = intern_const(?st, ?b[0], 8, CONST_F64);
    if (sel s0.err) { ret 99; }
    if (sel s1.ok) {
        if (!intern.str_same(s0.ok, s1.ok)) { code = 1; }
        if (st.const_count != 1)            { code = 1; }
    }

    var c: [8]u8;
    k = 0;
    for (k < 8) {
        c[k] = a[k];
        k    = k + 1;
    }
    c[7] = c[7] ^ 0x01;
    val s2: res[intern.StrId, fail.Fail] = intern_const(?st, ?c[0], 8, CONST_F64);
    if (sel s2.ok) {
        if (intern.str_same(s2.ok, s0.ok)) { code = 1; }
        if (st.const_count != 2)           { code = 1; }
    }

    val s3: res[intern.StrId, fail.Fail] = intern_const(?st, ?a[0], 8, CONST_VEC);
    if (sel s3.ok) {
        if (intern.str_same(s3.ok, s0.ok)) { code = 1; }
        if (st.const_count != 3)           { code = 1; }
    }

    a[0] = 0xFF;
    if (st.consts[0].bytes[0] != 0x11)                           { code = 1; }
    if (st.consts[0].len != 8 || st.consts[0].kind != CONST_F64) { code = 1; }
    if (st.consts[2].kind != CONST_VEC)                          { code = 1; }

    val intern_const_r: res[intern.StrId, fail.Fail] = intern_const(?st, ?a[0], 0, CONST_F64);
    if (sel intern_const_r.ok) { code = 1; }

    consts_free(?alloc, st.consts, st.const_count, st.const_cap);
    buf_dnit(?st.buf);
    intern.dnit(?itn);
    ret code;
}

test intern_float_const__width_and_bit_pattern {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var st: EncodeState;
    state_blank(?st, ?alloc, t_machine());
    st.interner = ?itn;

    var code: i32 = 0;

    val f32r: res[intern.StrId, fail.Fail] = intern_float_const(?st, 0x3FC00000, 4);
    if (sel f32r.err) { code = 1; }
    if (sel f32r.ok) {
        if (st.const_count != 1)            { code = 1; }
        if (st.consts[0].len != 4)          { code = 1; }
        if (st.consts[0].align != 4)        { code = 1; }
        if (st.consts[0].kind != CONST_F32) { code = 1; }
        if (st.consts[0].bytes[0] != 0x00)  { code = 1; }
        if (st.consts[0].bytes[1] != 0x00)  { code = 1; }
        if (st.consts[0].bytes[2] != 0xC0)  { code = 1; }
        if (st.consts[0].bytes[3] != 0x3F)  { code = 1; }
    }

    val f64r: res[intern.StrId, fail.Fail] = intern_float_const(?st, 0x3FC0000000000000, 8);
    if (sel f64r.err) { code = 1; }
    if (sel f64r.ok) {
        if (st.const_count != 2)           { code = 1; }
        if (st.consts[1].len != 8)         { code = 1; }
        if (st.consts[1].align != 8)       { code = 1; }
        if (st.consts[1].bytes[7] != 0x3F) { code = 1; }
        if (st.consts[1].bytes[0] != 0x00) { code = 1; }
    }

    val negz: res[intern.StrId, fail.Fail] = intern_float_const(?st, 0x8000000000000000, 8);
    val posz: res[intern.StrId, fail.Fail] = intern_float_const(?st, 0, 8);
    if (sel negz.err) { ret 99; }
    if (sel posz.ok) {
        if (intern.str_same(negz.ok, posz.ok)) { code = 1; }
        if (st.const_count != 4)               { code = 1; }
        if (st.consts[2].bytes[7] != 0x80)     { code = 1; }
        if (st.consts[3].bytes[7] != 0x00)     { code = 1; }
    }

    consts_free(?alloc, st.consts, st.const_count, st.const_cap);
    buf_dnit(?st.buf);
    intern.dnit(?itn);
    ret code;
}

test insert_text__refuses_a_size_overflow_before_reallocating {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?t); }
    T.fail_from_ordinal(?t, 1);

    var st: EncodeState;
    t_row_state(T.allocator_of(?t), ?st);

    val huge: usize = ~(0::usize);
    st.buf.cap = huge;
    st.buf.len = huge;

    val r: err[fail.Fail] = insert_text(?st, 0, 1);

    var bad: i32 = 0;
    if (sel r.ok)                 { bad = 2; }
    if (T.attempt_count(?t) != 0) { bad = 3; }
    ret bad;
}

#[testing]
fun t_no_stream_encode(st: *EncodeState, f: *codegen_mir.MirFunction) err[fail.Fail] {
    ret err[fail.Fail].ok{};
}

#[testing]
fun t_no_stream_patch(st: *EncodeState, fx: *BranchFixup, target_off: u32) err[fail.Fail] {
    ret err[fail.Fail].ok{};
}

# an ISA that declares no notification stream cannot validate an oblivious
# function's final instructions and refuses the module, like the
# whole-module emitter does; without the contract the same module encodes
test encode_driver__an_isa_without_a_stream_refuses_an_oblivious_function {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var interner: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?interner); }
    var m: codegen_mir.MirModule = codegen_mir.MirModule{alloc: ?alloc, interner: ?interner};
    fin { codegen_mir.dnit_module(?m); }
    var f: codegen_mir.MirFunction;
    f.name        = intern.STR_NIL;
    f.oblivious   = true;
    f.blocks      = nil;
    f.block_count = 0;
    f.vregs       = nil;
    f.vreg_count  = 0;
    val push_function_r: err[fail.Fail] = codegen_mir.push_function(?m, f);
    if (sel push_function_r.err) { ret 2; }
    var bt: isa.BackendTarget;
    bt.model              = @t_machine();
    bt.identity.arch_name = "silent";
    bt.abi.callee_saved   = nil;
    var hooks: EncodeHooks = hooks_blank();
    hooks.encode_function = t_no_stream_encode;
    hooks.patch_branch    = t_no_stream_patch;
    hooks.stream          = false;
    val r: res[EncoderOutput, fail.Fail] = encode_module(?alloc, ?bt, ?m, ?hooks);
    if (sel r.ok)                                                              { ret 3; }
    if (!str_contains(fail.describe(r.err), "notifies no instruction stream")) { ret 4; }
    if (!str_contains(fail.describe(r.err), "silent"))                         { ret 5; }

    m.functions[0].oblivious = false;
    val ok: res[EncoderOutput, fail.Fail] = encode_module(?alloc, ?bt, ?m, ?hooks);
    if (sel ok.err) { ret 6; }
    val out: EncoderOutput = ok.ok;
    if (out.text_len != 0 || out.notified != 0) { ret 7; }
    ret 0;
}
