test "mach.lang.be.codegen.encode.shrink_arrays:cap_equals_count_after_shrink" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var st: EncodeState;
    t_row_state(?alloc, ?st);

    val rsym: R.Result[*SymbolMark, str] = A.allocate[SymbolMark](?alloc, 8::usize);
    if (R.is_err[*SymbolMark, str](rsym)) { ret 1; }
    st.syms = R.unwrap_ok[*SymbolMark, str](rsym);
    st.sym_cap = 8;
    st.sym_count = 3;

    val rrel: R.Result[*PendingReloc, str] = A.allocate[PendingReloc](?alloc, 8::usize);
    if (R.is_err[*PendingReloc, str](rrel)) { ret 1; }
    st.relocs = R.unwrap_ok[*PendingReloc, str](rrel);
    st.reloc_cap = 8;
    st.reloc_count = 2;

    val rrow: R.Result[*LineRow, str] = A.allocate[LineRow](?alloc, 8::usize);
    if (R.is_err[*LineRow, str](rrow)) { ret 1; }
    st.rows = R.unwrap_ok[*LineRow, str](rrow);
    st.row_cap = 8;
    st.row_count = 4;

    val rvl: R.Result[*VarLoc, str] = A.allocate[VarLoc](?alloc, 8::usize);
    if (R.is_err[*VarLoc, str](rvl)) { ret 1; }
    st.varlocs = R.unwrap_ok[*VarLoc, str](rvl);
    st.varloc_cap = 8;
    st.varloc_count = 1;

    val rip: R.Result[*InlinePc, str] = A.allocate[InlinePc](?alloc, 8::usize);
    if (R.is_err[*InlinePc, str](rip)) { ret 1; }
    st.inline_pcs = R.unwrap_ok[*InlinePc, str](rip);
    st.inline_pc_cap = 8;
    st.inline_pc_count = 0;

    val rfr: R.Result[*of.FrameUnwind, str] = A.allocate[of.FrameUnwind](?alloc, 8::usize);
    if (R.is_err[*of.FrameUnwind, str](rfr)) { ret 1; }
    st.frames = R.unwrap_ok[*of.FrameUnwind, str](rfr);
    st.frame_cap = 8;
    st.frame_count = 5;

    if (R.is_err[R.Void, str](shrink_syms(?st)))       { state_dnit(?st); ret 1; }
    if (R.is_err[R.Void, str](shrink_relocs(?st)))     { state_dnit(?st); ret 1; }
    if (R.is_err[R.Void, str](shrink_rows(?st)))       { state_dnit(?st); ret 1; }
    if (R.is_err[R.Void, str](shrink_varlocs(?st)))    { state_dnit(?st); ret 1; }
    if (R.is_err[R.Void, str](shrink_inline_pcs(?st))) { state_dnit(?st); ret 1; }
    if (R.is_err[R.Void, str](shrink_frames(?st)))     { state_dnit(?st); ret 1; }

    if (st.sym_cap != st.sym_count)                    { state_dnit(?st); ret 1; }
    if (st.reloc_cap != st.reloc_count)                { state_dnit(?st); ret 1; }
    if (st.row_cap != st.row_count)                    { state_dnit(?st); ret 1; }
    if (st.varloc_cap != st.varloc_count)              { state_dnit(?st); ret 1; }
    if (st.inline_pc_cap != 0 || st.inline_pcs != nil) { state_dnit(?st); ret 1; }
    if (st.frame_cap != st.frame_count)                { state_dnit(?st); ret 1; }

    state_dnit(?st);
    ret 0;
}

fun patch_branches(st: *EncodeState, hooks: *EncodeHooks) R.Result[R.Void, str] {
    if (st.buf.data == nil) { ret R.ok_void[str](); }
    var i: u32 = 0;
    for (i < st.fixup_count) {
        val fx: *BranchFixup = ?st.fixups[i];
        val res_off: R.Result[u32, str] = block_offset(st, fx.fn_text_base, fx.target_block);
        if (R.is_err[u32, str](res_off)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](res_off)); }
        val target_off: u32 = R.unwrap_ok[u32, str](res_off);
        val res_patch: R.Result[R.Void, str] = hooks.patch_branch(st, fx, target_off);
        if (R.is_err[R.Void, str](res_patch)) { ret res_patch; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

pub fun block_offset(st: *EncodeState, fn_base: u32, block_id: u32) R.Result[u32, str] {
    var i: u32 = 0;
    for (i < st.block_count) {
        if (st.blocks[i].fn_text_base == fn_base && st.blocks[i].block_id == block_id) {
            ret R.ok[u32, str](st.blocks[i].offset);
        }
        i = i + 1;
    }
    ret R.err[u32, str]("encode: branch target block was never recorded");
}

pub fun insert_text(st: *EncodeState, pos: u32, nbytes: u32) R.Result[R.Void, str] {
    if (nbytes == 0) { ret R.ok_void[str](); }
    val p: usize = pos::usize;
    val n: usize = nbytes::usize;
    if (p > st.buf.len) {
        ret R.err[R.Void, str]("encode: text-gap offset is past the end of the buffer");
    }

    val need_r: R.Result[layout.CheckedCount[layout.ByteUnit], layout.CheckCause] =
        layout.count_add[layout.ByteUnit](layout.count[layout.ByteUnit](st.buf.len), layout.count[layout.ByteUnit](n));
    if (R.is_err[layout.CheckedCount[layout.ByteUnit], layout.CheckCause](need_r)) {
        ret R.err[R.Void, str]("encode: text-gap size overflow");
    }
    val need: usize = R.unwrap_ok[layout.CheckedCount[layout.ByteUnit], layout.CheckCause](need_r).value;
    if (need > st.buf.cap) {
        var new_cap_c: layout.CheckedCount[layout.ByteUnit] = layout.count[layout.ByteUnit](BYTEBUF_INIT_CAP);
        if (st.buf.cap > 0) { new_cap_c = layout.count[layout.ByteUnit](st.buf.cap); }
        for (new_cap_c.value < need) {
            val doubled_r: R.Result[layout.CheckedCount[layout.ByteUnit], layout.CheckCause] =
                layout.count_mul[layout.ByteUnit](new_cap_c, 2::usize);
            if (R.is_err[layout.CheckedCount[layout.ByteUnit], layout.CheckCause](doubled_r)) {
                ret R.err[R.Void, str]("encode: text buffer growth capacity overflow");
            }
            new_cap_c = R.unwrap_ok[layout.CheckedCount[layout.ByteUnit], layout.CheckCause](doubled_r);
        }
        val new_cap: usize = new_cap_c.value;
        val res_realloc: R.Result[*u8, str] = A.reallocate[u8](st.buf.alloc, st.buf.data, st.buf.cap, new_cap);
        if (R.is_err[*u8, str](res_realloc)) { ret R.err[R.Void, str](R.unwrap_err[*u8, str](res_realloc)); }
        st.buf.data = R.unwrap_ok[*u8, str](res_realloc);
        st.buf.cap  = new_cap;
    }

    var i: usize = st.buf.len;
    for (i > p) {
        i = i - 1;
        st.buf.data[i + n] = st.buf.data[i];
    }
    var z: usize = p;
    for (z < p + n) {
        st.buf.data[z] = 0;
        z = z + 1;
    }
    st.buf.len = need;

    var bi: u32 = 0;
    for (bi < st.block_count) {
        if (st.blocks[bi].offset >= pos)       { st.blocks[bi].offset = st.blocks[bi].offset + nbytes; }
        if (st.blocks[bi].fn_text_base >= pos) { st.blocks[bi].fn_text_base = st.blocks[bi].fn_text_base + nbytes; }
        bi = bi + 1;
    }
    var fi: u32 = 0;
    for (fi < st.fixup_count) {
        if (st.fixups[fi].patch_pos >= pos)    { st.fixups[fi].patch_pos = st.fixups[fi].patch_pos + nbytes; }
        if (st.fixups[fi].next_ip >= pos)      { st.fixups[fi].next_ip = st.fixups[fi].next_ip + nbytes; }
        if (st.fixups[fi].fn_text_base >= pos) { st.fixups[fi].fn_text_base = st.fixups[fi].fn_text_base + nbytes; }
        fi = fi + 1;
    }
    var si: u32 = 0;
    for (si < st.sym_count) {
        if (st.syms[si].offset >= pos) { st.syms[si].offset = st.syms[si].offset + nbytes; }
        si = si + 1;
    }
    var ri: u32 = 0;
    for (ri < st.reloc_count) {
        if (st.relocs[ri].offset >= pos) { st.relocs[ri].offset = st.relocs[ri].offset + nbytes; }
        ri = ri + 1;
    }
    var fri: u32 = 0;
    for (fri < st.frame_count) {
        if (st.frames[fri].offset >= pos) { st.frames[fri].offset = st.frames[fri].offset + nbytes; }
        fri = fri + 1;
    }
    var wi: u32 = 0;
    for (wi < st.row_count) {
        if (st.rows[wi].text_offset >= pos) { st.rows[wi].text_offset = st.rows[wi].text_offset + nbytes; }
        wi = wi + 1;
    }
    var vli: u32 = 0;
    for (vli < st.varloc_count) {
        if (st.varlocs[vli].text_offset >= pos) { st.varlocs[vli].text_offset = st.varlocs[vli].text_offset + nbytes; }
        if (st.varlocs[vli].end_offset != 0 && st.varlocs[vli].end_offset >= pos) {
            st.varlocs[vli].end_offset = st.varlocs[vli].end_offset + nbytes;
        }
        vli = vli + 1;
    }
    var ipi: u32 = 0;
    for (ipi < st.inline_pc_count) {
        if (st.inline_pcs[ipi].text_offset >= pos) { st.inline_pcs[ipi].text_offset = st.inline_pcs[ipi].text_offset + nbytes; }
        ipi = ipi + 1;
    }
    if (st.buf.asm != nil) {
        var ni: u32 = 0;
        for (ni < st.buf.asm.note_count) {
            if (st.buf.asm.notes[ni].off >= pos) { st.buf.asm.notes[ni].off = st.buf.asm.notes[ni].off + nbytes; }
            ni = ni + 1;
        }
    }
    ret R.ok_void[str]();
}

fun grow_symbols(st: *EncodeState) R.Result[R.Void, str] {
    ret grow_cap[SymbolMark](st.alloc, ?st.syms, ?st.sym_cap, DRIVER_INIT_CAP);
}

fun grow_relocs(st: *EncodeState) R.Result[R.Void, str] {
    ret grow_cap[PendingReloc](st.alloc, ?st.relocs, ?st.reloc_cap, DRIVER_INIT_CAP);
}

fun grow_fixups(st: *EncodeState) R.Result[R.Void, str] {
    ret grow_cap[BranchFixup](st.alloc, ?st.fixups, ?st.fixup_cap, DRIVER_INIT_CAP);
}

fun grow_blocks(st: *EncodeState) R.Result[R.Void, str] {
    ret grow_cap[BlockOffset](st.alloc, ?st.blocks, ?st.block_cap, DRIVER_INIT_CAP);
}

fun grow_rows(st: *EncodeState) R.Result[R.Void, str] {
    ret grow_cap[LineRow](st.alloc, ?st.rows, ?st.row_cap, DRIVER_INIT_CAP);
}

fun grow_inline_pcs(st: *EncodeState) R.Result[R.Void, str] {
    ret grow_cap[InlinePc](st.alloc, ?st.inline_pcs, ?st.inline_pc_cap, DRIVER_INIT_CAP);
}

pub fun push_inline_pc(st: *EncodeState, text_offset: u32, inline_site: u32) R.Result[R.Void, str] {
    if (inline_site == st.last_inline_site) { ret R.ok_void[str](); }
    if (st.inline_pc_count >= st.inline_pc_cap) {
        val res_grow: R.Result[R.Void, str] = grow_inline_pcs(st);
        if (R.is_err[R.Void, str](res_grow)) { ret res_grow; }
    }
    st.inline_pcs[st.inline_pc_count].text_offset = text_offset;
    st.inline_pcs[st.inline_pc_count].sec         = 0;
    st.inline_pcs[st.inline_pc_count].inline_site = inline_site;
    st.inline_pc_count  = st.inline_pc_count + 1;
    st.last_inline_site = inline_site;
    ret R.ok_void[str]();
}

fun put_decimal(buf: *u8, at: usize, n: usize) usize {
    var digits: [20]u8;
    var d: usize = 0;
    var v: usize = n;
    if (v == 0) { digits[0] = '0'::u8; d = 1; }
    for (v > 0) {
        digits[d] = (v % 10)::u8 + '0'::u8;
        v = v / 10;
        d = d + 1;
    }
    var k: usize = at;
    for (d > 0) {
        d = d - 1;
        buf[k] = digits[d];
        k = k + 1;
    }
    ret k;
}

pub fun asm_located_message(st: *EncodeState, loc: source.SrcLoc, msg: str) str {
    if (st.srcmap == nil || st.interner == nil) { ret msg; }
    if (!source.loc_is_valid(loc)) { ret msg; }
    val fo: O.Option[*source.SourceFile] = source.get(st.srcmap, loc.file);
    if (!O.is_some[*source.SourceFile](fo)) { ret msg; }
    val file: *source.SourceFile = O.unwrap[*source.SourceFile](fo);
    val pos: source.Position = source.position(file, loc.offset);

    val lp: usize = str_len(file.path);
    val lm: usize = str_len(msg);
    val total_cap: usize = lp + 1 + 20 + 1 + 20 + 2 + lm + 1;
    val rb: R.Result[*u8, str] = A.allocate[u8](st.alloc, total_cap);
    if (R.is_err[*u8, str](rb)) { ret msg; }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);

    var k: usize = 0;
    var j: usize = 0;
    for (j < lp) { buf[k] = file.path[j]::u8; k = k + 1; j = j + 1; }
    buf[k] = ':'::u8; k = k + 1;
    k = put_decimal(buf, k, pos.line);
    buf[k] = ':'::u8; k = k + 1;
    k = put_decimal(buf, k, pos.col);
    buf[k] = ':'::u8; k = k + 1;
    buf[k] = ' '::u8; k = k + 1;
    j = 0;
    for (j < lm) { buf[k] = msg[j]::u8; k = k + 1; j = j + 1; }
    buf[k] = 0;

    val ir: R.Result[intern.StrId, str] = intern.intern(st.interner, buf::str);
    A.deallocate[u8](st.alloc, buf, total_cap);
    if (R.is_err[intern.StrId, str](ir)) { ret msg; }
    val nm: O.Option[str] = intern.lookup(st.interner, R.unwrap_ok[intern.StrId, str](ir));
    if (O.is_some[str](nm)) { ret O.unwrap[str](nm); }
    ret msg;
}

var t_model: isa.MachineModel;
fun t_machine() *isa.MachineModel {
    t_model.pointer_width = 8;
    t_model.gpr_width     = 8;
    t_model.max_alu_width = 8;
    t_model.alu_min_width = 4;
    t_model.spill_width   = 8;
    t_model.flen_bits     = 64;
    ret ?t_model;
}

fun t_row_state(alloc: *A.Allocator, st: *EncodeState) {
    state_blank(st, alloc, t_machine());
}

test "mach.lang.be.codegen.encode.insert_text:shifts_line_rows" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var st: EncodeState;
    t_row_state(?alloc, ?st);

    var i: u32 = 0;
    for (i < 12) { emit_byte(?st.buf, 0x90); i = i + 1; }

    val r0: R.Result[R.Void, str] = push_row(?st, 0, source.loc(1, 100)); if (R.is_err[R.Void, str](r0)) { ret 1; }
    val r1: R.Result[R.Void, str] = push_row(?st, 4, source.loc(1, 200)); if (R.is_err[R.Void, str](r1)) { ret 1; }
    val rn: R.Result[R.Void, str] = push_row(?st, 4, source.loc_nil());   if (R.is_err[R.Void, str](rn)) { ret 1; }
    val r2: R.Result[R.Void, str] = push_row(?st, 8, source.loc(1, 300)); if (R.is_err[R.Void, str](r2)) { ret 1; }
    if (st.row_count != 3) { buf_dnit(?st.buf); ret 1; }

    val it: R.Result[R.Void, str] = insert_text(?st, 4, 4);
    if (R.is_err[R.Void, str](it)) { buf_dnit(?st.buf); ret 1; }

    var code: i32 = 0;
    if (st.rows[0].text_offset != 0)  { code = 1; }
    if (st.rows[1].text_offset != 8)  { code = 1; }
    if (st.rows[2].text_offset != 12) { code = 1; }
    if (st.rows[1].loc.offset != 200) { code = 1; }

    buf_dnit(?st.buf);
    if (st.rows != nil && st.row_cap > 0) { A.deallocate[LineRow](?alloc, st.rows, st.row_cap::usize); }
    ret code;
}

test "mach.lang.be.codegen.encode.push_varloc:reg_frame_dead" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var code: i32 = 0;

    var st: EncodeState;
    t_row_state(?alloc, ?st);

    var vregs: [3]mir.MirVReg;
    vregs[0].id = 0; vregs[0].class = 0; vregs[0].spill_slot = -1; vregs[0].assigned = 7;
    vregs[1].id = 1; vregs[1].class = 0; vregs[1].spill_slot = 0;  vregs[1].assigned = mir.MIR_VREG_NIL;
    vregs[2].id = 2; vregs[2].class = 0; vregs[2].spill_slot = -1; vregs[2].assigned = mir.MIR_VREG_NIL;

    var slots: [1]mir.MirSlot;
    slots[0].value = 1; slots[0].kind = mir.SLOT_SPILL; slots[0].offset = -16; slots[0].size = 8; slots[0].align = 8;

    var fn: mir.MirFunction;
    fn.vregs = ?vregs[0]; fn.vreg_count = 3;
    fn.frame.slots = ?slots[0]; fn.frame.slot_count = 1; fn.frame.slot_cap = 1;
    fn.frame.size = 0; fn.frame.align = 0; fn.frame.outgoing_size = 0;

    val ra: R.Result[R.Void, str] = push_varloc(?st, 0, ?fn, 0, 100); if (R.is_err[R.Void, str](ra)) { code = 1; }
    val rb: R.Result[R.Void, str] = push_varloc(?st, 4, ?fn, 1, 101); if (R.is_err[R.Void, str](rb)) { code = 1; }
    val rc: R.Result[R.Void, str] = push_varloc(?st, 8, ?fn, 2, 102); if (R.is_err[R.Void, str](rc)) { code = 1; }

    if (st.varloc_count != 3) { code = 1; }
    if (st.varlocs[0].kind != VARLOC_REG || st.varlocs[0].reg != 7 || st.varlocs[0].iid != 100) { code = 1; }
    if (st.varlocs[1].kind != VARLOC_FRAME || st.varlocs[1].off != -16 || st.varlocs[1].iid != 101) { code = 1; }
    if (st.varlocs[2].kind != VARLOC_NONE || st.varlocs[2].iid != 102) { code = 1; }

    if (st.varlocs != nil && st.varloc_cap > 0) { A.deallocate[VarLoc](?alloc, st.varlocs, st.varloc_cap::usize); }
    buf_dnit(?st.buf);
    ret code;
}

test "mach.lang.be.codegen.encode.push_cmp_varloc:homes_digest_and_close" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var code: i32 = 0;

    var st: EncodeState;
    t_row_state(?alloc, ?st);

    var vregs: [3]mir.MirVReg;
    vregs[0].id = 0; vregs[0].class = 0; vregs[0].spill_slot = -1; vregs[0].assigned = 7;
    vregs[1].id = 1; vregs[1].class = 0; vregs[1].spill_slot = 0;  vregs[1].assigned = mir.MIR_VREG_NIL;
    vregs[2].id = 2; vregs[2].class = 0; vregs[2].spill_slot = -1; vregs[2].assigned = mir.MIR_VREG_NIL;

    var slots: [1]mir.MirSlot;
    slots[0].value = 1; slots[0].kind = mir.SLOT_SPILL; slots[0].offset = -16; slots[0].size = 8; slots[0].align = 8;

    var fn: mir.MirFunction;
    fn.vregs = ?vregs[0]; fn.vreg_count = 3;
    fn.frame.slots = ?slots[0]; fn.frame.slot_count = 1; fn.frame.slot_cap = 1;
    fn.frame.size = 0; fn.frame.align = 0; fn.frame.outgoing_size = 0;

    var bind: mir.MirDbgBinding;
    bind.iid = 100; bind.cmp_op = mir.MIR_SEL_CBR_LT_U; bind.cmp_width = 2;
    bind.lhs_is_imm = false; bind.vreg = 0; bind.imm = 0;
    bind.rhs_is_imm = true;  bind.vreg2 = mir.MIR_VREG_NIL; bind.imm2 = 40000;
    val ra: R.Result[R.Void, str] = push_cmp_varloc(?st, 12, ?fn, ?bind);
    if (R.is_err[R.Void, str](ra)) { code = 1; }

    bind.iid = 101; bind.cmp_op = mir.MIR_SEL_CBR_LE_S; bind.cmp_width = 8;
    bind.lhs_is_imm = false; bind.vreg = 1;
    bind.rhs_is_imm = false; bind.vreg2 = 0;
    val rb: R.Result[R.Void, str] = push_cmp_varloc(?st, 12, ?fn, ?bind);
    if (R.is_err[R.Void, str](rb)) { code = 1; }

    val rp: R.Result[R.Void, str] = push_varloc(?st, 12, ?fn, 0, 102);
    if (R.is_err[R.Void, str](rp)) { code = 1; }

    bind.iid = 103; bind.cmp_op = mir.MIR_SEL_CBR_EQ; bind.cmp_width = 4;
    bind.lhs_is_imm = false; bind.vreg = 2;
    bind.rhs_is_imm = true;  bind.imm2 = 0;
    val rd: R.Result[R.Void, str] = push_cmp_varloc(?st, 12, ?fn, ?bind);
    if (R.is_err[R.Void, str](rd)) { code = 1; }

    close_cmp_varlocs(?st, 12, 20);

    if (st.varloc_count != 4) { code = 1; }
    val a: *VarLoc = ?st.varlocs[0];
    if (a.kind != VARLOC_CMP)                     { code = 1; }
    if (a.sub_lhs != VARLOC_REG || a.reg != 7)    { code = 1; }
    if (a.sub_rhs != VARLOC_IMM || a.off2 != 40000) { code = 1; }
    if (a.cmp_rel != CMPREL_LT || a.cmp_signed)   { code = 1; }
    if (a.cmp_width != 2)                         { code = 1; }
    if (a.end_offset != 20)                       { code = 1; }
    val b: *VarLoc = ?st.varlocs[1];
    if (b.kind != VARLOC_CMP)                       { code = 1; }
    if (b.sub_lhs != VARLOC_FRAME || b.off != -16)  { code = 1; }
    if (b.sub_rhs != VARLOC_REG || b.reg2 != 7)     { code = 1; }
    if (b.cmp_rel != CMPREL_LE || !b.cmp_signed)    { code = 1; }
    if (b.end_offset != 20)                         { code = 1; }
    val c: *VarLoc = ?st.varlocs[2];
    if (c.kind != VARLOC_REG || c.end_offset != 0)  { code = 1; }
    val d: *VarLoc = ?st.varlocs[3];
    if (d.kind != VARLOC_NONE || d.iid != 103)      { code = 1; }

    if (st.varlocs != nil && st.varloc_cap > 0) { A.deallocate[VarLoc](?alloc, st.varlocs, st.varloc_cap::usize); }
    buf_dnit(?st.buf);
    ret code;
}

test "mach.lang.be.codegen.encode.push_varloc:slot_spill_owner_is_direct_frame" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var code: i32 = 0;

