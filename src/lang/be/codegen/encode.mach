    fn.frame.slots = ?slots[0]; fn.frame.slot_count = 1; fn.frame.slot_cap = 1;
    fn.frame.size = 0; fn.frame.align = 0; fn.frame.outgoing_size = 0;

    val r: R.Result[R.Void, str] = push_varloc(?st, 0, ?fn, 0, 200); if (R.is_err[R.Void, str](r)) { code = 1; }

    if (st.varloc_count != 1) { code = 1; }
    if (st.varlocs[0].kind != VARLOC_FRAME || st.varlocs[0].off != -32 || !st.varlocs[0].off_storage) { code = 1; }

    if (st.varlocs != nil && st.varloc_cap > 0) { A.deallocate[VarLoc](?alloc, st.varlocs, st.varloc_cap::usize); }
    buf_dnit(?st.buf);
    ret code;
}

test "mach.lang.be.codegen.encode.sink_unaccounted:tracks_unrendered_bytes" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: ByteBuf = buf_init(?alloc);

    var sink: AsmSink = sink_init(nil, nil);
    buf.asm = ?sink;

    var bad: i32 = 0;

    if (sink_unaccounted(?buf) != 0) { bad = 1; }

    emit_byte(?buf, 0x90);
    emit_byte(?buf, 0x90);
    emit_byte(?buf, 0x90);
    if (sink_unaccounted(?buf) != 3) { bad = 1; }

    sink_claim(?buf, 0);
    if (sink_unaccounted(?buf) != 0) { bad = 1; }

    emit_byte(?buf, 0xCC);
    emit_byte(?buf, 0xCC);
    if (sink_unaccounted(?buf) != 2) { bad = 1; }

    var plain: ByteBuf = buf_init(?alloc);
    emit_byte(?plain, 0x90);
    if (sink_unaccounted(?plain) != 0) { bad = 1; }

    buf_dnit(?plain);
    buf_dnit(?buf);
    ret bad;
}

test "mach.lang.be.codegen.encode.sink_claim:refuses_a_claim_that_skips_bytes" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: ByteBuf = buf_init(?alloc);

    var sink: AsmSink = sink_init(nil, nil);
    buf.asm = ?sink;

    var bad: i32 = 0;

    emit_u32(?buf, 0xD503201F);
    emit_u32(?buf, 0xD503201F);
    sink_claim(?buf, 4);

    if (sink_unaccounted(?buf) != 8) { bad = 1; }
    if (sink_claims(?buf) != 0)      { bad = 1; }
    if (sink.refused != 1)           { bad = 1; }

    var ok_buf: ByteBuf = buf_init(?alloc);
    var ok_sink: AsmSink = sink_init(nil, nil);
    ok_buf.asm = ?ok_sink;

    emit_u32(?ok_buf, 0xD503201F);
    sink_claim(?ok_buf, 0);
    emit_u32(?ok_buf, 0xD503201F);
    sink_claim(?ok_buf, 4);
    if (sink_unaccounted(?ok_buf) != 0) { bad = 1; }
    if (sink_claims(?ok_buf) != 2)      { bad = 1; }
    if (ok_sink.refused != 0)           { bad = 1; }

    sink_claim(?ok_buf, 8);
    if (sink_claims(?ok_buf) != 2) { bad = 1; }
    if (ok_sink.refused != 1)      { bad = 1; }

    buf_dnit(?ok_buf);
    buf_dnit(?buf);
    ret bad;
}

test "mach.lang.be.codegen.encode.intern_const:key_is_the_whole_identity" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var st: EncodeState;
    state_blank(?st, ?alloc, t_machine());
    st.interner = ?itn;

    var code: i32 = 0;

    var a: [8]u8;
    var b: [8]u8;
    var k: u32 = 0;
    for (k < 8) { a[k] = (0x11 * (k + 1))::u8; b[k] = (0x11 * (k + 1))::u8; k = k + 1; }

    val s0: R.Result[intern.StrId, str] = intern_const(?st, ?a[0], 8, CONST_F64);
    val s1: R.Result[intern.StrId, str] = intern_const(?st, ?b[0], 8, CONST_F64);
    if (R.is_err[intern.StrId, str](s0) || R.is_err[intern.StrId, str](s1)) { code = 1; }
    or {
        if (R.unwrap_ok[intern.StrId, str](s0) != R.unwrap_ok[intern.StrId, str](s1)) { code = 1; }
        if (st.const_count != 1) { code = 1; }
    }

    var c: [8]u8;
    k = 0;
    for (k < 8) { c[k] = a[k]; k = k + 1; }
    c[7] = c[7] ^ 0x01;
    val s2: R.Result[intern.StrId, str] = intern_const(?st, ?c[0], 8, CONST_F64);
    if (R.is_err[intern.StrId, str](s2)) { code = 1; }
    or {
        if (R.unwrap_ok[intern.StrId, str](s2) == R.unwrap_ok[intern.StrId, str](s0)) { code = 1; }
        if (st.const_count != 2) { code = 1; }
    }

    val s3: R.Result[intern.StrId, str] = intern_const(?st, ?a[0], 8, CONST_VEC);
    if (R.is_err[intern.StrId, str](s3)) { code = 1; }
    or {
        if (R.unwrap_ok[intern.StrId, str](s3) == R.unwrap_ok[intern.StrId, str](s0)) { code = 1; }
        if (st.const_count != 3) { code = 1; }
    }

    a[0] = 0xFF;
    if (st.consts[0].bytes[0] != 0x11) { code = 1; }
    if (st.consts[0].len != 8 || st.consts[0].kind != CONST_F64) { code = 1; }
    if (st.consts[2].kind != CONST_VEC) { code = 1; }

    if (!R.is_err[intern.StrId, str](intern_const(?st, ?a[0], 0, CONST_F64))) { code = 1; }

    consts_free(?alloc, st.consts, st.const_count, st.const_cap);
    buf_dnit(?st.buf);
    intern.dnit(?itn);
    ret code;
}

test "mach.lang.be.codegen.encode.intern_float_const:width_and_bit_pattern" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var st: EncodeState;
    state_blank(?st, ?alloc, t_machine());
    st.interner = ?itn;

    var code: i32 = 0;

    val f32r: R.Result[intern.StrId, str] = intern_float_const(?st, 0x3FC00000, 4);
    if (R.is_err[intern.StrId, str](f32r)) { code = 1; }
    or {
        if (st.const_count != 1)          { code = 1; }
        if (st.consts[0].len != 4)        { code = 1; }
        if (st.consts[0].align != 4)      { code = 1; }
        if (st.consts[0].kind != CONST_F32) { code = 1; }
        if (st.consts[0].bytes[0] != 0x00) { code = 1; }
        if (st.consts[0].bytes[1] != 0x00) { code = 1; }
        if (st.consts[0].bytes[2] != 0xC0) { code = 1; }
        if (st.consts[0].bytes[3] != 0x3F) { code = 1; }
    }

    val f64r: R.Result[intern.StrId, str] = intern_float_const(?st, 0x3FC0000000000000, 8);
    if (R.is_err[intern.StrId, str](f64r)) { code = 1; }
    or {
        if (st.const_count != 2)     { code = 1; }
        if (st.consts[1].len != 8)   { code = 1; }
        if (st.consts[1].align != 8) { code = 1; }
        if (st.consts[1].bytes[7] != 0x3F) { code = 1; }
        if (st.consts[1].bytes[0] != 0x00) { code = 1; }
    }

    val negz: R.Result[intern.StrId, str] = intern_float_const(?st, 0x8000000000000000, 8);
    val posz: R.Result[intern.StrId, str] = intern_float_const(?st, 0, 8);
    if (R.is_err[intern.StrId, str](negz) || R.is_err[intern.StrId, str](posz)) { code = 1; }
    or {
        if (R.unwrap_ok[intern.StrId, str](negz) == R.unwrap_ok[intern.StrId, str](posz)) { code = 1; }
        if (st.const_count != 4) { code = 1; }
        if (st.consts[2].bytes[7] != 0x80) { code = 1; }
        if (st.consts[3].bytes[7] != 0x00) { code = 1; }
    }

    consts_free(?alloc, st.consts, st.const_count, st.const_cap);
    buf_dnit(?st.buf);
    intern.dnit(?itn);
    ret code;
}

test "mach.lang.be.codegen.encode.const_align:one_rule_including_over_width" {
    var code: i32 = 0;
    if (const_align(CONST_F32, 4)  != 4)  { code = 1; }
    if (const_align(CONST_F64, 8)  != 8)  { code = 1; }
    if (const_align(CONST_VEC, 16) != 16) { code = 1; }
    if (const_align(CONST_VEC, 8)  != 8)  { code = 1; }
    if (const_align(CONST_VEC, 32) != 32) { code = 1; }
    if (const_align(CONST_VEC, 64) != 64) { code = 1; }
    if (const_align(CONST_VEC, 12) != 16) { code = 1; }
    ret code;
}

rec EncodeGrowthProbe {
    reallocate_calls: u32;
    allocate_calls:   u32;
}

fun encode_growth_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val g: *EncodeGrowthProbe = ctx::*EncodeGrowthProbe;
    g.allocate_calls = g.allocate_calls + 1;
    ret O.none[ptr]();
}

fun encode_growth_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    val g: *EncodeGrowthProbe = ctx::*EncodeGrowthProbe;
    g.reallocate_calls = g.reallocate_calls + 1;
    ret O.none[ptr]();
}

fun encode_growth_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.be.codegen.encode.grow_cap:refuses_u32_capacity_overflow_before_reallocating" {
    var probe: EncodeGrowthProbe;
    probe.reallocate_calls = 0;
    probe.allocate_calls   = 0;
    var pp: *EncodeGrowthProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = encode_growth_probe_allocate;
    alloc.fn_reallocate = encode_growth_probe_reallocate;
    alloc.fn_deallocate = encode_growth_probe_deallocate;

    var dummy: SymbolMark;
    var data: *SymbolMark = ?dummy;
    var cap: u32 = 0xFFFFFFFF;

    val r: R.Result[R.Void, str] = grow_cap[SymbolMark](?alloc, ?data, ?cap, DRIVER_INIT_CAP);

    var bad: i32 = 0;
    if (!R.is_err[R.Void, str](r))      { bad = 1; }
    if (probe.reallocate_calls != 0)  { bad = 2; }
    if (probe.allocate_calls != 0)    { bad = 3; }
    if (cap != 0xFFFFFFFF)            { bad = 4; }
    ret bad;
}

test "mach.lang.be.codegen.encode.grow_cap:allocates_the_seed_capacity_when_empty" {
    var probe: EncodeGrowthProbe;
    probe.reallocate_calls = 0;
    probe.allocate_calls   = 0;
    var pp: *EncodeGrowthProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = encode_growth_probe_allocate;
    alloc.fn_reallocate = encode_growth_probe_reallocate;
    alloc.fn_deallocate = encode_growth_probe_deallocate;

    var data: *SymbolMark = nil;
    var cap: u32 = 0;

    val r: R.Result[R.Void, str] = grow_cap[SymbolMark](?alloc, ?data, ?cap, DRIVER_INIT_CAP);

    var bad: i32 = 0;
    if (!R.is_err[R.Void, str](r))      { bad = 1; }
    if (probe.allocate_calls != 1)    { bad = 2; }
    if (probe.reallocate_calls != 0)  { bad = 3; }
    ret bad;
}

test "mach.lang.be.codegen.encode.insert_text:refuses_growth_capacity_overflow_before_reallocating" {
    var probe: EncodeGrowthProbe;
    probe.reallocate_calls = 0;
    probe.allocate_calls   = 0;
    var pp: *EncodeGrowthProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = encode_growth_probe_allocate;
    alloc.fn_reallocate = encode_growth_probe_reallocate;
    alloc.fn_deallocate = encode_growth_probe_deallocate;

    var st: EncodeState;
    t_row_state(?alloc, ?st);

    val huge: usize = (~(0::usize) / 2) + 1;
    st.buf.cap = huge;
    st.buf.len = huge;

    val r: R.Result[R.Void, str] = insert_text(?st, 0, 1);

    var bad: i32 = 0;
    if (!R.is_err[R.Void, str](r))      { bad = 1; }
    if (probe.reallocate_calls != 0)  { bad = 2; }
    if (probe.allocate_calls != 0)    { bad = 3; }
    ret bad;
}

test "mach.lang.be.codegen.encode.emit_byte:doubling_is_still_exact_at_ordinary_scale" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var buf: ByteBuf = buf_init(?alloc);
    var i: usize = 0;
    for (i < (BYTEBUF_INIT_CAP * 3)) { emit_byte(?buf, 0xAB); i = i + 1; }

    var bad: i32 = 0;
    if (buf.len != BYTEBUF_INIT_CAP * 3) { bad = 1; }
    var j: usize = 0;
    for (j < buf.len) {
        if (buf.data[j] != 0xAB) { bad = 2; }
        j = j + 1;
    }
    buf_dnit(?buf);
    ret bad;
}
