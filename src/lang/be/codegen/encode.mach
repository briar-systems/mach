use std_format: std.format;
use io_writer:  std.io.writer;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_len;

use std.allocator.page;
use std.collections.map;
use encoding_hex: std.encoding.hex;
use std.memory;

use A: std.allocator;
use T: std.allocator.testing;

use mach.lang.be.codegen.ctwalk;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.intern;
use lang_mir:    mach.lang.mir;
use lang_source: mach.lang.source;
use mach.lang.target.binding;
use mach.lang.target.isa;
use isa_encode:   mach.lang.target.isa.encode;
use target_model: mach.lang.target.model;

pub fun run(tgt: *binding.Binding, m: *lang_mir.MirModule,
    asm_out: *io_writer.Writer) res[isa_encode.EncoderOutput, fail.Fail] {
    if (tgt == nil) { ret res[isa_encode.EncoderOutput, fail.Fail].err{fail.message("encode: nil target")}; }
    if (m == nil)   { ret res[isa_encode.EncoderOutput, fail.Fail].err{fail.message("encode: nil mir module")}; }
    if (tgt.arch == nil) {
        ret res[isa_encode.EncoderOutput, fail.Fail].err{fail.message("encode: target has no ISA vtable")};
    }
    if (asm_out != nil && !tgt.arch.has_assembly) {
        ret res[isa_encode.EncoderOutput, fail.Fail].err{fail.message("encode: the target architecture registered no assembly printer")};
    }

    var backend_target: isa.BackendTarget = binding.backend_target(tgt);
    if (asm_out != nil && tgt.arch.assembly.header != nil) {
        val header: err[fail.Fail] = tgt.arch.assembly.header(asm_out);
        if (sel header.err) { ret res[isa_encode.EncoderOutput, fail.Fail].err{header.err}; }
    }
    ret emit(m.alloc, ?backend_target, m, tgt.arch, asm_out);
}

fun module_has_oblivious(m: *lang_mir.MirModule) bool {
    var fi: u32 = 0;
    for (fi < m.function_len) {
        if (m.functions[fi].oblivious) { ret true; }
        fi = fi + 1;
    }
    ret false;
}

# the refusal of the first oblivious function of a module whose encoder
# notifies no instruction stream, located at that function's declaration
fun no_stream_refusal(m: *lang_mir.MirModule, tgt: *isa.BackendTarget) fail.Fail {
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val f: *lang_mir.MirFunction = ?m.functions[fi];
        if (f.oblivious) {
            var r: res[str, fail.Fail] = res[str, fail.Fail].err{fail.reported()};
            if (m.interner == nil || intern.str_is_nil(f.name)) {
                r = fail.format(m.alloc, "an #[oblivious] function cannot be compiled for the `{}` target: its encoder notifies no instruction stream, so the emitted instructions cannot be validated constant-time",
                    tgt.identity.arch_name);
            }
            or {
                r = fail.format_intern(m.interner, m.alloc,
                    "#[oblivious] function `{}` cannot be compiled for the `{}` target: its encoder notifies no instruction stream, so the emitted instructions cannot be validated constant-time",
                    intern.text(m.interner, f.name), tgt.identity.arch_name);
            }
            if (sel r.err) { ret r.err; }
            ret lang_mir.reject_function(m, diagnostic_kind.SECRET_TARGET_UNVERIFIABLE, f, r.ok);
        }
        fi = fi + 1;
    }
    ret fail.message(NO_STREAM_DETAIL);
}

val NO_STREAM_DETAIL: str = "an #[oblivious] function cannot be compiled for a target whose encoder notifies no instruction stream; the emitted instructions cannot be validated constant-time";

# the post-expansion walk over one function's notifications; a refusal is an
# error located at the refused instruction's source position, naming the
# function, on the module's diagnostic store
fun walk_function(st: *isa_encode.EncodeState, tgt: *isa.BackendTarget, arch: *isa.RegMachine, f: *lang_mir.MirFunction) err[fail.Fail] {
    if (!isa_encode.sink_active(?st.buf)) {
        ret err[fail.Fail].err{fail.message("codegen: an #[oblivious] function reached the encoder with no instruction stream to validate")};
    }
    val s:  *isa_encode.AsmSink = st.buf.asm;
    val wr: err[ctwalk.Refusal] = ctwalk.walk(f, s.notes, s.note_count, arch, tgt, st.alloc);
    if (sel wr.ok) { ret err[fail.Fail].ok{}; }
    var refusal: ctwalk.Refusal = wr.err;
    fin { ctwalk.refusal_free(st.alloc, ?refusal); }
    var loc: lang_source.Location = f.decl_loc;
    if (refusal.index < s.note_count && lang_source.location_is_valid(s.notes[refusal.index].loc)) { loc = s.notes[refusal.index].loc; }
    if (st.interner == nil || refusal.detail == nil || intern.str_is_nil(f.name)) {
        ret err[fail.Fail].err{lang_mir.reject(st.diags, refusal.kind, loc, WALK_REFUSED_DETAIL)};
    }
    val rf: res[str, std_format.FormatError] = std_format.sprint(st.alloc, "#[oblivious] function `{}` {}",
        intern.text(st.interner, f.name), refusal.detail);
    if (sel rf.err) { ret err[fail.Fail].err{fail.format_refused(rf.err)}; }
    val body:    str       = rf.ok;
    val refused: fail.Fail = lang_mir.reject(st.diags, refusal.kind, loc, body);
    # the store copied the text; a message failure keeps the scratch copy
    if (sel refused.reported) { A.deallocate[u8](st.alloc, body, str_len(body) + 1); }
    ret err[fail.Fail].err{refused};
}

val WALK_REFUSED_DETAIL: str = "an #[oblivious] function was refused by the post-expansion constant-time walk";

fun apply_emission_order_module(alloc: *A.Allocator, m: *lang_mir.MirModule) err[fail.Fail] {
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val ao: err[fail.Fail] = apply_emission_order(alloc, ?m.functions[fi]);
        if (sel ao.err) { ret ao; }
        fi = fi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun apply_emission_order(alloc: *A.Allocator, f: *lang_mir.MirFunction) err[fail.Fail] {
    val n: u32 = f.block_count;
    if (n <= 1 || f.emit_order == nil) { ret err[fail.Fail].ok{}; }

    val rt: res[*lang_mir.MirBlock, A.Error] = A.allocate[lang_mir.MirBlock](alloc, n::usize);
    if (sel rt.err) { ret err[fail.Fail].err{fail.refused(rt.err)}; }
    val tmp: *lang_mir.MirBlock = rt.ok;

    var i: u32 = 0;
    for (i < n) {
        tmp[i] = f.blocks[f.emit_order[i]];
        i      = i + 1;
    }
    i = 0;
    for (i < n) {
        f.blocks[i] = tmp[i];
        i           = i + 1;
    }
    A.deallocate[lang_mir.MirBlock](alloc, tmp, n::usize);

    i = 0;
    for (i < n) {
        f.emit_order[i] = i;
        i               = i + 1;
    }

    ret err[fail.Fail].ok{};
}

fun emit(alloc: *A.Allocator, tgt: *isa.BackendTarget, m: *lang_mir.MirModule,
    arch: *isa.RegMachine, asm_out: *io_writer.Writer) res[isa_encode.EncoderOutput, fail.Fail] {
    if (tgt == nil)                        { ret res[isa_encode.EncoderOutput, fail.Fail].err{fail.message("encode: nil target")}; }
    if (m == nil)                          { ret res[isa_encode.EncoderOutput, fail.Fail].err{fail.message("encode: nil mir module")}; }
    if (arch == nil || arch.encode == nil) { ret res[isa_encode.EncoderOutput, fail.Fail].err{fail.message("encode: nil encode hooks")}; }
    val hooks: *isa_encode.EncodeHooks = arch.encode;
    if (hooks.encode_function == nil) { ret res[isa_encode.EncoderOutput, fail.Fail].err{fail.message("encode: ISA supplied no per-function encode hook")}; }
    if (hooks.patch_branch == nil)    { ret res[isa_encode.EncoderOutput, fail.Fail].err{fail.message("encode: ISA supplied no per-branch patch hook")}; }

    val res_layout: err[fail.Fail] = apply_emission_order_module(alloc, m);
    if (sel res_layout.err) { ret res[isa_encode.EncoderOutput, fail.Fail].err{res_layout.err}; }

    var st: isa_encode.EncodeState;
    state_init(?st, alloc, m, tgt);
    var handed: bool = false;
    fin {
        if (!handed) { isa_encode.state_dnit(?st); }
    }

    # the stream exists under --emit-asm and on every build of a module with an
    # oblivious function; a nil writer notifies and claims without rendering.
    # an ISA without a stream cannot validate an oblivious function's final
    # instructions and refuses it, like the whole-module emitter does
    val oblivious: bool = module_has_oblivious(m);
    if (oblivious && !hooks.stream) { ret res[isa_encode.EncoderOutput, fail.Fail].err{no_stream_refusal(m, tgt)}; }
    var sink: isa_encode.AsmSink = isa_encode.sink_init(asm_out, m.interner);
    if (asm_out != nil || (hooks.stream && oblivious)) { st.buf.asm = ?sink; }
    fin { isa_encode.notes_free(?st.buf); }

    var notified: u32 = 0;
    var fi:       u32 = 0;
    for (fi < m.function_len) {
        st.last_inline_site = 0;
        isa_encode.begin_function_locations(?st);
        if (m.functions[fi].block_count > 0) {
            val padded: err[fail.Fail] = isa_encode.pad_entry(?st, isa_encode.entry_align(st.model, m.functions[fi].align));
            if (sel padded.err) { ret res[isa_encode.EncoderOutput, fail.Fail].err{padded.err}; }
        }
        val pre_sym_count: u32            = st.sym_count;
        val res_encode:    err[fail.Fail] = hooks.encode_function(?st, ?m.functions[fi]);
        if (sel res_encode.err)    { ret res[isa_encode.EncoderOutput, fail.Fail].err{res_encode.err}; }
        if (st.buf.failed)         { ret res[isa_encode.EncoderOutput, fail.Fail].err{fail.refused(st.buf.fail_err)}; }
        if (st.buf.refusal != nil) { ret res[isa_encode.EncoderOutput, fail.Fail].err{fail.message(st.buf.refusal)}; }
        if (st.sym_count > pre_sym_count) {
            st.syms[pre_sym_count].size = st.buf.len::u32 - st.syms[pre_sym_count].offset;
        }
        if (sink.failed) { brk; }
        # one function's notifications are complete here: the post-expansion
        # walk validates an oblivious function before the reset
        if (m.functions[fi].oblivious) {
            val vr: err[fail.Fail] = walk_function(?st, tgt, arch, ?m.functions[fi]);
            if (sel vr.err) { ret res[isa_encode.EncoderOutput, fail.Fail].err{vr.err}; }
        }
        notified = notified + isa_encode.note_inst_count(?st.buf);
        isa_encode.notes_reset(?st.buf);
        fi = fi + 1;
    }

    if (sink.failed) { ret res[isa_encode.EncoderOutput, fail.Fail].err{fail.message(sink.err)}; }
    if (sink.refused > 0) {
        ret res[isa_encode.EncoderOutput, fail.Fail].err{fail.message("encode: an instruction notification claimed a byte range that does not begin where the previous one ended")};
    }
    if (isa_encode.sink_unaccounted(?st.buf) > 0) {
        ret res[isa_encode.EncoderOutput, fail.Fail].err{fail.message("encode: the encoder emitted bytes that no instruction notification claimed")};
    }
    isa_encode.notes_free(?st.buf);
    map.dnit[u64, isa_encode.RelocPairSite](?st.reloc_pair_sites);
    val res_patch: err[fail.Fail] = isa_encode.patch_branches(?st, hooks);
    if (sel res_patch.err) { ret res[isa_encode.EncoderOutput, fail.Fail].err{res_patch.err}; }

    val res_fit: err[A.Error] = isa_encode.tables_fit(?st);
    if (sel res_fit.err) { ret res[isa_encode.EncoderOutput, fail.Fail].err{fail.refused(res_fit.err)}; }

    var out: isa_encode.EncoderOutput;
    out.text            = st.buf.data;
    out.text_len        = st.buf.len::u32;
    out.relocations     = st.relocs;
    out.reloc_count     = st.reloc_count;
    out.symbols         = st.syms;
    out.symbol_count    = st.sym_count;
    out.rows            = st.rows;
    out.row_count       = st.row_count;
    out.inline_pcs      = st.inline_pcs;
    out.inline_pc_count = st.inline_pc_count;
    out.varlocs         = st.varlocs;
    out.varloc_count    = st.varloc_count;
    out.consts          = st.consts;
    out.const_count     = st.const_count;
    out.frames          = st.frames;
    out.frame_count     = st.frame_count;
    out.notified        = notified;

    handed = true;
    isa_encode.scratch_release(?st);
    ret res[isa_encode.EncoderOutput, fail.Fail].ok{out};
}

fun state_init(st: *isa_encode.EncodeState, alloc: *A.Allocator, m: *lang_mir.MirModule, tgt: *isa.BackendTarget) {
    isa_encode.state_blank(st, alloc, ?tgt.model);
    st.interner     = m.interner;
    st.srcmap       = m.srcmap;
    st.diags        = m.diags;
    st.callee_saved = tgt.abi.callee_saved;
    st.base_addr    = tgt.os.image_base;
    st.page_size    = tgt.os.page_size;
    st.stack_probe  = tgt.os.stack_probe;
}

#[testing]
var t_model: target_model.Machine;

#[testing]
fun t_machine() *target_model.Machine {
    t_model.pointer_width = 8;
    t_model.gpr_width     = 8;
    target_model.declare_alu_widths(?t_model, target_model.ALU_WIDTHS_4_8);
    t_model.spill_width = 8;
    t_model.flen_bits   = 64;
    ret ?t_model;
}

#[testing]
fun t_no_stream_encode(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction) err[fail.Fail] {
    ret err[fail.Fail].ok{};
}

#[testing]
fun t_no_stream_patch(st: *isa_encode.EncodeState, fx: *isa_encode.BranchFixup, target_off: u32) err[fail.Fail] {
    ret err[fail.Fail].ok{};
}

# an ISA that declares no notification stream cannot validate an oblivious
# function's final instructions and refuses the module, like the
# whole-module emitter does; without the contract the same module encodes
test encode_driver__an_isa_without_a_stream_refuses_an_oblivious_function {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var interner: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?interner); }
    var m: lang_mir.MirModule = lang_mir.MirModule{alloc: ?alloc, interner: ?interner};
    fin { lang_mir.dnit_module(?m); }
    var f: lang_mir.MirFunction;
    f.name        = intern.STR_NIL;
    f.oblivious   = true;
    f.blocks      = nil;
    f.block_count = 0;
    f.vregs       = nil;
    f.vreg_count  = 0;
    val push_function_r: err[fail.Fail] = lang_mir.push_function(?m, f);
    if (sel push_function_r.err) { ret 2; }
    var bt: isa.BackendTarget;
    bt.model              = @t_machine();
    bt.identity.arch_name = "silent";
    bt.abi.callee_saved   = nil;
    var hooks: isa_encode.EncodeHooks = isa_encode.hooks_blank();
    hooks.encode_function = t_no_stream_encode;
    hooks.patch_branch    = t_no_stream_patch;
    hooks.stream          = false;
    var arch: isa.RegMachine;
    arch.encode = ?hooks;
    val r: res[isa_encode.EncoderOutput, fail.Fail] = emit(?alloc, ?bt, ?m, ?arch, nil);
    if (sel r.ok)                                                              { ret 3; }
    if (!str_contains(fail.describe(r.err), "notifies no instruction stream")) { ret 4; }
    if (!str_contains(fail.describe(r.err), "silent"))                         { ret 5; }

    m.functions[0].oblivious = false;
    val ok: res[isa_encode.EncoderOutput, fail.Fail] = emit(?alloc, ?bt, ?m, ?arch, nil);
    if (sel ok.err) { ret 6; }
    val out: isa_encode.EncoderOutput = ok.ok;
    if (out.text_len != 0 || out.notified != 0) { ret 7; }
    ret 0;
}
