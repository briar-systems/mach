use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use diagnostic_kind: mach.lang.diagnostic.kind;
use target_of:       mach.lang.target.of;
use A:               std.allocator;
use std.allocator.page;
use std_format: std.format;
use std.types.string.str_contains;

use codegen_mir: mach.lang.be.codegen.mir;
use mach.lang.ct;
use mach.lang.intern;
use mach.lang.layout;
use mach.lang.target.abi;
use mach.lang.target.isa;
use mach.lang.target.isa.x64;
use mach.lang.target.resolved;

pub val DEFAULT_STACK_ALIGN: u32 = 16;

rec FrameByteUnit {}

pub fun run(tgt: *resolved.Target, m: *codegen_mir.MirModule) err[fail.Fail] {
    if (m == nil) { ret err[fail.Fail].err{fail.message("frame.run: nil mir module")}; }
    if (tgt == nil || tgt.abi == nil) {
        ret err[fail.Fail].err{fail.message("frame.run: target has no ABI")};
    }

    val align: u32 = stack_align(tgt);

    val reserve: u64 = target_of.effective_stack_reserve(tgt.of, tgt.stack_reserve);

    var fi: u32 = 0;
    for (fi < m.function_len) {
        val func:     *codegen_mir.MirFunction = ?m.functions[fi];
        val laid_out: err[fail.Fail]           = layout_function(func, align);
        if (sel laid_out.err) { ret laid_out; }
        val fp: codegen_mir.PRegId = codegen_mir.preg_id(tgt.model.frame_ptr_reg);
        val sp: codegen_mir.PRegId = codegen_mir.preg_id(tgt.model.stack_ptr_reg);
        func.frame.omit = omits_frame(func, fp, sp);
        val writes_sp: bool = body_writes_sp(tgt.arch, func, sp);
        func.frame.opaque   = writes_sp || body_runs_asm(func);
        func.frame.sp_frame = !func.frame.omit && !func.frame.opaque && frames_from_sp(func, fp, sp);
        func.frame.sp_fixed = !func.frame.omit && !func.frame.sp_frame && !writes_sp;
        val distd: err[fail.Fail] = set_frame_dist(tgt, func);
        if (sel distd.err) { ret distd; }

        val over: err[fail.Fail] = check_frame_fits(m, func, reserve);
        if (sel over.err) { ret over; }
        fi = fi + 1;
    }

    ret err[fail.Fail].ok{};
}

# before selection, a frame slot address no instruction reads is dropped and a
# slot nothing names any more leaves the frame, so a dead address costs
# neither an instruction nor stack (#4121). an address or slot a debug binding
# or an asm block names stays, since the debugger or the block reads it
pub fun prune(m: *codegen_mir.MirModule) err[fail.Fail] {
    if (m == nil) { ret err[fail.Fail].err{fail.message("frame.prune: nil mir module")}; }
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val func: *codegen_mir.MirFunction = ?m.functions[fi];
        if (func.vreg_count > 0 && func.frame.slot_count > 0) {
            val r: err[fail.Fail] = prune_function(m.alloc, func);
            if (sel r.err) { ret r; }
        }
        fi = fi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun prune_function(alloc: *A.Allocator, func: *codegen_mir.MirFunction) err[fail.Fail] {
    val nv: u32                 = func.vreg_count;
    val rr: res[*bool, A.Error] = A.allocate[bool](alloc, nv::usize);
    if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
    val read: *bool = rr.ok;
    fin { A.deallocate[bool](alloc, read, nv::usize); }
    mark_reads(func, read);

    var bi: u32 = 0;
    for (bi < func.block_count) {
        val blk: *codegen_mir.MirBlock = ?func.blocks[bi];
        var w:   u32                   = 0;
        var r:   u32                   = 0;
        for (r < blk.instr_count) {
            val mi: *codegen_mir.MirInstr = ?blk.instrs[r];
            if (dead_slot_address(func, mi, read)) {
                A.deallocate[codegen_mir.MirOperand](alloc, mi.operands, mi.operand_count::usize);
            }
            or {
                if (w != r) { blk.instrs[w] = blk.instrs[r]; }
                w = w + 1;
            }
            r = r + 1;
        }
        blk.instr_count = w;
        bi              = bi + 1;
    }

    # a slot is named by its key, and by any value that is its address
    mark_reads(func, read);
    var v: u32 = 0;
    for (v < nv) {
        val home: u32 = func.vregs[v].home_key;
        if (read[v] && home < nv) { read[home] = true; }
        v = v + 1;
    }
    val frame: *codegen_mir.MirFrame = ?func.frame;
    var w:     u32                   = 0;
    var si:    u32                   = 0;
    for (si < frame.slot_count) {
        val key: u32 = frame.slots[si].value;
        if (key >= nv || read[key]) {
            if (w != si) { frame.slots[w] = frame.slots[si]; }
            w = w + 1;
        }
        si = si + 1;
    }
    frame.slot_count = w;
    ret err[fail.Fail].ok{};
}

# every value an instruction reads, a debug binding describes or an asm block
# binds; a slot key counts as read where a memory operand names it
fun mark_reads(func: *codegen_mir.MirFunction, read: *bool) {
    val nv: u32 = func.vreg_count;
    var i:  u32 = 0;
    for (i < nv) {
        read[i] = false;
        i       = i + 1;
    }
    var bi: u32 = 0;
    for (bi < func.block_count) {
        val blk: *codegen_mir.MirBlock = ?func.blocks[bi];
        var ii:  u32                   = 0;
        for (ii < blk.instr_count) {
            val mi:  *codegen_mir.MirInstr = ?blk.instrs[ii];
            val def: bool                  = codegen_mir.instr_defines_shape(mi) && mi.operands[0].kind == codegen_mir.MIR_OP_VREG;
            var k:   u32                   = 0;
            for (k < mi.operand_count) {
                val op: *codegen_mir.MirOperand = ?mi.operands[k];
                if (op.kind == codegen_mir.MIR_OP_VREG && !(def && k == 0))                 { mark(read, nv, op.vreg.n); }
                or (op.kind == codegen_mir.MIR_OP_MEM && !codegen_mir.vreg_is_nil(op.vreg)) { mark(read, nv, op.vreg.n); }
                if (sel op.index.vreg)                                                      { mark(read, nv, op.index.vreg.n); }
                k = k + 1;
            }
            var b: u32 = 0;
            for (b < mi.dbg_binding_count) {
                mark(read, nv, mi.dbg_bindings[b].vreg);
                mark(read, nv, mi.dbg_bindings[b].vreg2);
                b = b + 1;
            }
            if (mi.asm_block != nil) {
                var j: u32 = 0;
                for (j < mi.asm_block.bind_count) {
                    mark(read, nv, mi.asm_block.binds[j].slot_vreg);
                    j = j + 1;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun mark(read: *bool, nv: u32, v: u32) {
    if (v < nv) { read[v] = true; }
}

# `d = &slot` whose result nothing reads
fun dead_slot_address(func: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr, read: *bool) bool {
    if (mi.opcode != codegen_mir.MIR_ALLOCA || mi.operand_count != 2) { ret false; }
    val d: *codegen_mir.MirOperand = ?mi.operands[0];
    if (d.kind != codegen_mir.MIR_OP_VREG || d.vreg.n >= func.vreg_count) { ret false; }
    if (mi.dbg_binding_count > 0)                                         { ret false; }
    ret !read[d.vreg.n];
}

fun check_frame_fits(m: *codegen_mir.MirModule, func: *codegen_mir.MirFunction, reserve: u64) err[fail.Fail] {
    if (reserve == 0)                   { ret err[fail.Fail].ok{}; }
    if (func.frame.size::u64 < reserve) { ret err[fail.Fail].ok{}; }

    var name: str = "<unknown>";
    if (m.interner != nil) {
        val o: opt[str] = intern.lookup(m.interner, func.name);
        if (sel o.some) { name = o.some; }
    }

    val r: res[str, std_format.FormatError] = std_format.sprint(m.alloc,
        "`{}` needs a {}-byte stack frame, which its target's {}-byte stack reserve cannot hold; raise `stack_reserve` on the target, or move the large locals off the stack",
        name, func.frame.size::u64, reserve);
    if (sel r.err) { ret err[fail.Fail].err{fail.format_refused(r.err)}; }
    ret err[fail.Fail].err{codegen_mir.reject_function(m, diagnostic_kind.STACK_RESERVE_EXCEEDED, func, r.ok)};
}

fun set_frame_dist(tgt: *resolved.Target, func: *codegen_mir.MirFunction) err[fail.Fail] {
    if (tgt.arch == nil || tgt.arch.frame_dist == nil) {
        ret err[fail.Fail].err{fail.message("frame: target declares no frame-distance model; an instruction set that reaches frame insertion must declare one")};
    }
    var base_dist: u32 = 0;
    var fp_dist:   u32 = 0;
    tgt.arch.frame_dist(?tgt.model, func, ?base_dist, ?fp_dist);
    func.frame.base_dist = base_dist;
    func.frame.fp_dist   = fp_dist;
    ret err[fail.Fail].ok{};
}

pub fun omits_frame(func: *codegen_mir.MirFunction, fp: codegen_mir.PRegId, sp: codegen_mir.PRegId) bool {
    if (func.naked) { ret true; }

    if (func.frame.size != 0)          { ret false; }
    if (func.callee_mask != 0)         { ret false; }
    if (func.callee_mask_fp != 0)      { ret false; }
    if (func.frame.outgoing_size != 0) { ret false; }

    ret is_plain_leaf(func, fp, sp);
}

# a leaf whose frame the stack pointer can address alone: its prologue sets
# no frame pointer, sp holds one place across the body, and nothing reads the
# caller's frame. a realigned frame needs fp to find what sits above it
fun frames_from_sp(func: *codegen_mir.MirFunction, fp: codegen_mir.PRegId, sp: codegen_mir.PRegId) bool {
    if (func.naked)                    { ret false; }
    if (func.frame.realign != 0)       { ret false; }
    if (func.frame.outgoing_size != 0) { ret false; }
    ret is_plain_leaf(func, fp, sp);
}

# no call but a tail call, and no operand addresses memory from the frame or
# stack pointer
fun is_plain_leaf(func: *codegen_mir.MirFunction, fp: codegen_mir.PRegId, sp: codegen_mir.PRegId) bool {
    var bi: u32 = 0;
    for (bi < func.block_count) {
        val blk: *codegen_mir.MirBlock = ?func.blocks[bi];
        var ii:  u32                   = 0;
        for (ii < blk.instr_count) {
            val mi: *codegen_mir.MirInstr = ?blk.instrs[ii];
            # a tail call leaves with the frame torn down, as a return does
            if (mi.opcode == codegen_mir.MIR_CALL && !mi.tail) { ret false; }
            var oi: u32 = 0;
            for (oi < mi.operand_count) {
                if (operand_is_frame_relative(?mi.operands[oi], fp, sp)) { ret false; }
                oi = oi + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret true;
}

fun operand_is_frame_relative(o: *codegen_mir.MirOperand, fp: codegen_mir.PRegId, sp: codegen_mir.PRegId) bool {
    if (o.kind != codegen_mir.MIR_OP_MEM)                                                                            { ret false; }
    if (codegen_mir.vreg_is_nil(o.vreg) && (codegen_mir.preg_same(o.preg, fp) || codegen_mir.preg_same(o.preg, sp))) { ret true; }
    if (sel o.index.preg) {
        if (codegen_mir.preg_same(o.index.preg, fp) || codegen_mir.preg_same(o.index.preg, sp)) { ret true; }
    }
    ret false;
}

# whether the body may move the stack pointer. the encoders write sp only in
# the prologue and epilogue, outgoing arguments live in the fixed frame, and no
# instruction set allocates stack dynamically, so the writers are an inline-asm
# block that writes sp and an instruction naming sp as a register operand
pub fun body_writes_sp(m: *isa.RegMachine, func: *codegen_mir.MirFunction, sp: codegen_mir.PRegId) bool {
    var bi: u32 = 0;
    for (bi < func.block_count) {
        val blk: *codegen_mir.MirBlock = ?func.blocks[bi];
        var ii:  u32                   = 0;
        for (ii < blk.instr_count) {
            val mi: *codegen_mir.MirInstr = ?blk.instrs[ii];
            if (codegen_mir.runs_asm(mi)) {
                if (m == nil || !m.has_assembly)             { ret true; }
                if (m.assembly.writes_sp(mi.asm_block.body)) { ret true; }
            }
            var oi: u32 = 0;
            for (oi < mi.operand_count) {
                val o: *codegen_mir.MirOperand = ?mi.operands[oi];
                if (o.kind == codegen_mir.MIR_OP_PREG && codegen_mir.preg_same(o.preg, sp)) { ret true; }
                oi = oi + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

fun body_runs_asm(func: *codegen_mir.MirFunction) bool {
    var bi: u32 = 0;
    for (bi < func.block_count) {
        val blk: *codegen_mir.MirBlock = ?func.blocks[bi];
        var ii:  u32                   = 0;
        for (ii < blk.instr_count) {
            if (codegen_mir.runs_asm(?blk.instrs[ii])) { ret true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

# the declared frame property: sp == fp - base_dist for the whole body
pub fun sp_fixed(frame: *codegen_mir.MirFrame) bool {
    ret frame.sp_fixed;
}

pub fun slot_offset(frame: *codegen_mir.MirFrame, v: u32) opt[i64] {
    val opt_slot: opt[*codegen_mir.MirSlot] = slot_find(frame, v);
    if (sel opt_slot.none) { ret opt[i64].none{}; }
    ret opt[i64].some{opt_slot.some.offset - frame.fp_dist::i64};
}

pub fun slot_sp_offset(frame: *codegen_mir.MirFrame, v: u32) opt[i64] {
    val opt_slot: opt[*codegen_mir.MirSlot] = slot_find(frame, v);
    if (sel opt_slot.none) { ret opt[i64].none{}; }
    ret opt[i64].some{frame.base_dist::i64 + opt_slot.some.offset};
}

pub fun slots_from_sp(frame: *codegen_mir.MirFrame) bool {
    ret frame.realign != 0 || frame.sp_frame;
}

# the byte extent an encoder addresses a slot at: the displacement from the
# slot base register (the stack pointer when slots_from_sp, else the frame
# pointer) and the slot's size. false when v owns no slot
pub fun slot_extent(frame: *codegen_mir.MirFrame, v: u32, disp: *i64, size: *u32) bool {
    val opt_slot: opt[*codegen_mir.MirSlot] = slot_find(frame, v);
    if (!sel opt_slot.some) { ret false; }
    val slot: *codegen_mir.MirSlot = opt_slot.some;
    if (slots_from_sp(frame)) { @disp = frame.base_dist::i64 + slot.offset; }
    or                        { @disp = slot.offset - frame.fp_dist::i64; }
    @size = slot.size;
    ret true;
}

#[testing]
pub fun is_slot(frame: *codegen_mir.MirFrame, v: u32) bool {
    val found: opt[*codegen_mir.MirSlot] = slot_find(frame, v);
    ret sel found.some;
}

#[testing]
pub fun is_alloca_slot(frame: *codegen_mir.MirFrame, v: u32) bool {
    val opt_slot: opt[*codegen_mir.MirSlot] = slot_find(frame, v);
    if (!sel opt_slot.some) { ret false; }
    ret opt_slot.some.kind == codegen_mir.SLOT_ALLOCA;
}

fun stack_align(tgt: *resolved.Target) u32 {
    if (tgt.abi.stack_align == 0) { ret DEFAULT_STACK_ALIGN; }
    ret tgt.abi.stack_align;
}

fun layout_function(func: *codegen_mir.MirFunction, align: u32) err[fail.Fail] {
    val frame: *codegen_mir.MirFrame = ?func.frame;
    frame.align   = align;
    frame.realign = over_alignment(frame, align);

    val align_r: res[layout.CheckedAlignment[FrameByteUnit], layout.CheckCause] =
        layout.alignment[FrameByteUnit](align::usize);
    if (sel align_r.err) {
        ret err[fail.Fail].err{fail.message("frame: stack alignment is invalid")};
    }
    val frame_align: layout.CheckedAlignment[FrameByteUnit] = align_r.ok;

    var offset: i64 = 0;

    var si: u32 = 0;
    for (si < frame.slot_count) {
        if (!slot_is_asm_bound(func, frame.slots[si].value)) {
            offset = place_slot(?frame.slots[si], offset);
        }
        si = si + 1;
    }
    si = 0;
    for (si < frame.slot_count) {
        if (slot_is_asm_bound(func, frame.slots[si].value)) {
            offset = place_slot(?frame.slots[si], offset);
        }
        si = si + 1;
    }

    var size: usize = 0;
    if (offset < 0) {
        val aligned_r: res[layout.CheckedOffset[FrameByteUnit], layout.CheckCause] =
            layout.align_offset_up[FrameByteUnit](layout.offset[FrameByteUnit]((-offset)::usize), frame_align);
        if (sel aligned_r.err) {
            ret err[fail.Fail].err{fail.message("frame: stack frame size overflows while rounding up to the stack alignment")};
        }
        size = aligned_r.ok.value;
    }
    val size_fits: res[u32, layout.CheckCause] = layout.usize_to_u32(size);
    if (sel size_fits.err) {
        ret err[fail.Fail].err{fail.message("frame: stack frame size exceeds the u32 limit")};
    }
    frame.size = size_fits.ok;

    if (frame.outgoing_size > 0) {
        val outgoing_r: res[layout.CheckedOffset[FrameByteUnit], layout.CheckCause] =
            layout.align_offset_up[FrameByteUnit](layout.offset[FrameByteUnit](frame.outgoing_size::usize), frame_align);
        if (sel outgoing_r.err) {
            ret err[fail.Fail].err{fail.message("frame: outgoing argument area overflows while rounding up to the stack alignment")};
        }
        val outgoing_fits: res[u32, layout.CheckCause] = layout.usize_to_u32(
            outgoing_r.ok.value);
        if (sel outgoing_fits.err) {
            ret err[fail.Fail].err{fail.message("frame: outgoing argument area exceeds the u32 limit")};
        }
        frame.outgoing_size = outgoing_fits.ok;
    }
    ret err[fail.Fail].ok{};
}

fun over_alignment(frame: *codegen_mir.MirFrame, align: u32) u32 {
    var most: u32 = align;
    # a call placing an argument above the stack alignment needs the stack
    # pointer, where the outgoing area starts, aligned to it
    if (frame.outgoing_size > 0 && frame.outgoing_align > most) { most = frame.outgoing_align; }
    if (frame.slots == nil) {
        if (most <= align) { ret 0; }
        ret most;
    }
    var i: u32 = 0;
    for (i < frame.slot_count) {
        if (frame.slots[i].align > most) { most = frame.slots[i].align; }
        i = i + 1;
    }
    if (most <= align) { ret 0; }
    ret most;
}

fun place_slot(slot: *codegen_mir.MirSlot, offset: i64) i64 {
    var slot_align: i64 = 1;
    if (slot.align > 0) { slot_align = slot.align::i64; }

    var next: i64 = offset - slot.size::i64;
    if (slot_align > 1) {
        val mask: i64 = slot_align - 1;
        next = next & ~mask;
    }

    slot.offset = next;
    ret next;
}

fun slot_is_asm_bound(func: *codegen_mir.MirFunction, v: u32) bool {
    var bi: u32 = 0;
    for (bi < func.block_count) {
        val blk: *codegen_mir.MirBlock = ?func.blocks[bi];
        var ii:  u32                   = 0;
        for (ii < blk.instr_count) {
            val mi: *codegen_mir.MirInstr = ?blk.instrs[ii];
            if (codegen_mir.runs_asm(mi)) {
                var k: u32 = 0;
                for (k < mi.asm_block.bind_count) {
                    if (mi.asm_block.binds[k].slot_vreg == v) { ret true; }
                    k = k + 1;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

fun slot_find(frame: *codegen_mir.MirFrame, v: u32) opt[*codegen_mir.MirSlot] {
    if (frame == nil)       { ret opt[*codegen_mir.MirSlot].none{}; }
    if (frame.slots == nil) { ret opt[*codegen_mir.MirSlot].none{}; }

    var i: u32 = 0;
    for (i < frame.slot_count) {
        if (frame.slots[i].value == v) {
            ret opt[*codegen_mir.MirSlot].some{?frame.slots[i]};
        }
        i = i + 1;
    }
    ret opt[*codegen_mir.MirSlot].none{};
}

test slot_offset__fp_and_sp_relative_lookup {
    var slots: [2]codegen_mir.MirSlot;
    slots[0].value  = 10;
    slots[0].kind   = codegen_mir.SLOT_ALLOCA;
    slots[0].offset = -16;
    slots[0].size   = 16;
    slots[0].align  = 16;

    slots[1].value  = 20;
    slots[1].kind   = codegen_mir.SLOT_SPILL;
    slots[1].offset = -24;
    slots[1].size   = 8;
    slots[1].align  = 8;

    var frame: codegen_mir.MirFrame;
    frame.slots         = ?slots[0];
    frame.slot_count    = 2;
    frame.slot_cap      = 2;
    frame.size          = 0;
    frame.align         = 0;
    frame.outgoing_size = 0;
    frame.realign       = 0;
    frame.base_dist     = 0;
    frame.fp_dist       = 0;

    val opt_off10: opt[i64] = slot_offset(?frame, 10);
    if (sel opt_off10.none)    { ret 1; }
    if (opt_off10.some != -16) { ret 1; }

    val opt_off20: opt[i64] = slot_offset(?frame, 20);
    if (sel opt_off20.none)    { ret 1; }
    if (opt_off20.some != -24) { ret 1; }

    val opt_off99: opt[i64] = slot_offset(?frame, 99);
    if (sel opt_off99.some) { ret 1; }

    frame.fp_dist = 32;
    val biased10: opt[i64] = slot_offset(?frame, 10);
    if (sel biased10.none)    { ret 1; }
    if (biased10.some != -48) { ret 1; }
    val biased20: opt[i64] = slot_offset(?frame, 20);
    if (sel biased20.none)    { ret 1; }
    if (biased20.some != -56) { ret 1; }
    frame.fp_dist = 0;

    if (!is_alloca_slot(?frame, 10)) { ret 1; }
    if (is_alloca_slot(?frame, 20))  { ret 1; }
    if (!is_slot(?frame, 10))        { ret 1; }

    # sp-relative adds the stamped base distance to the slot offset
    frame.base_dist = 96;
    val sp10: opt[i64] = slot_sp_offset(?frame, 10);
    if (sel sp10.none)   { ret 2; }
    if (sp10.some != 80) { ret 2; }
    val sp20: opt[i64] = slot_sp_offset(?frame, 20);
    if (sel sp20.none)   { ret 3; }
    if (sp20.some != 72) { ret 3; }
    val sp99: opt[i64] = slot_sp_offset(?frame, 99);
    if (sel sp99.some) { ret 4; }
    ret 0;
}

test layout_function__asm_bound_slots_are_nearest_the_stack_pointer {
    var instrs: [1]codegen_mir.MirInstr;
    mk_instr(?instrs[0], codegen_mir.MIR_ASM);

    var binds: [1]codegen_mir.MirAsmBind;
    binds[0] = codegen_mir.asm_bind(0::intern.StrId, 7, ct.bind_public());
    var payload: codegen_mir.MirAsm;
    payload.isa         = "x86_64";
    payload.body        = "nop";
    payload.binds       = ?binds[0];
    payload.bind_count  = 1;
    instrs[0].asm_block = ?payload;

    var blk:  codegen_mir.MirBlock;
    var func: codegen_mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 1);

    var slots: [5]codegen_mir.MirSlot;
    slots[0].value  = 7;
    slots[0].kind   = codegen_mir.SLOT_ALLOCA;
    slots[0].offset = 0;
    slots[0].size   = 8;
    slots[0].align  = 8;
    var i: u32 = 1;
    for (i < 5) {
        slots[i::usize].value  = i;
        slots[i::usize].kind   = codegen_mir.SLOT_ALLOCA;
        slots[i::usize].offset = 0;
        slots[i::usize].size   = 256;
        slots[i::usize].align  = 8;
        i                      = i + 1;
    }

    func.frame.slots      = ?slots[0];
    func.frame.slot_count = 5;
    func.frame.slot_cap   = 5;

    layout_function(?func, 16);

    if (func.frame.size::i64 + slots[0].offset > 8) { ret 21; }

    var j: usize = 1;
    for (j < 5) {
        if (slots[j].offset <= slots[0].offset) { ret 22; }
        j = j + 1;
    }
    if (func.frame.size < 1032) { ret 23; }

    if (!slot_is_asm_bound(?func, 7)) { ret 24; }
    if (slot_is_asm_bound(?func, 1))  { ret 25; }
    if (slot_is_asm_bound(?func, 4))  { ret 26; }
    ret 0;
}

test layout_function__packs_slots_at_their_alignment {
    var instrs: [1]codegen_mir.MirInstr;
    mk_instr(?instrs[0], codegen_mir.MIR_MOV);

    var blk:  codegen_mir.MirBlock;
    var func: codegen_mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 1);

    var sizes:  [6]u32;
    var aligns: [6]u32;
    sizes[0]  = 1;
    aligns[0] = 1;
    sizes[1]  = 2;
    aligns[1] = 2;
    sizes[2]  = 4;
    aligns[2] = 4;
    sizes[3]  = 8;
    aligns[3] = 8;
    sizes[4]  = 16;
    aligns[4] = 16;
    sizes[5]  = 32;
    aligns[5] = 32;

    var slots: [6]codegen_mir.MirSlot;
    var i:     usize = 0;
    for (i < 6) {
        slots[i].value  = i::u32;
        slots[i].kind   = codegen_mir.SLOT_ALLOCA;
        slots[i].offset = 0;
        slots[i].size   = sizes[i];
        slots[i].align  = aligns[i];
        i               = i + 1;
    }

    func.frame.slots      = ?slots[0];
    func.frame.slot_count = 6;
    func.frame.slot_cap   = 6;

    layout_function(?func, 16);

    if (slots[0].offset != -1)  { ret 31; }
    if (slots[1].offset != -4)  { ret 32; }
    if (slots[2].offset != -8)  { ret 33; }
    if (slots[3].offset != -16) { ret 34; }
    if (slots[4].offset != -32) { ret 35; }
    if (slots[5].offset != -64) { ret 36; }
    if (func.frame.size != 64)  { ret 37; }

    var j: usize = 0;
    for (j < 6) {
        if ((slots[j].offset & (aligns[j]::i64 - 1)) != 0) { ret 38; }
        j = j + 1;
    }

    var k: usize = 0;
    for (k < 6) {
        var n: usize = 0;
        for (n < 6) {
            if (n != k) {
                val a_lo: i64 = slots[k].offset;
                val a_hi: i64 = a_lo + slots[k].size::i64;
                val b_lo: i64 = slots[n].offset;
                val b_hi: i64 = b_lo + slots[n].size::i64;
                if (a_lo < b_hi && b_lo < a_hi) { ret 39; }
            }
            n = n + 1;
        }
        if (slots[k].offset + func.frame.size::i64 < 0) { ret 40; }
        if (slots[k].offset + slots[k].size::i64 > 0)   { ret 41; }
        k = k + 1;
    }
    ret 0;
}

test layout_function__records_the_largest_over_alignment {
    var instrs: [1]codegen_mir.MirInstr;
    mk_instr(?instrs[0], codegen_mir.MIR_MOV);

    var blk:  codegen_mir.MirBlock;
    var func: codegen_mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 1);

    var aligns: [4]u32;
    aligns[0] = 8;
    aligns[1] = 128;
    aligns[2] = 32;
    aligns[3] = 8;

    var slots: [4]codegen_mir.MirSlot;
    var i:     usize = 0;
    for (i < 4) {
        slots[i].value  = i::u32;
        slots[i].kind   = codegen_mir.SLOT_ALLOCA;
        slots[i].offset = 0;
        slots[i].size   = aligns[i];
        slots[i].align  = aligns[i];
        i               = i + 1;
    }

    func.frame.slots      = ?slots[0];
    func.frame.slot_count = 4;
    func.frame.slot_cap   = 4;

    layout_function(?func, 16);
    if (func.frame.realign != 128)   { ret 51; }
    if (!slots_from_sp(?func.frame)) { ret 52; }

    var plain: [3]codegen_mir.MirSlot;
    var j:     usize = 0;
    for (j < 3) {
        plain[j].value  = j::u32;
        plain[j].kind   = codegen_mir.SLOT_ALLOCA;
        plain[j].offset = 0;
        plain[j].size   = 16;
        plain[j].align  = 16;
        j               = j + 1;
    }
    mk_func(?blk, ?func, ?instrs[0], 1);
    func.frame.slots      = ?plain[0];
    func.frame.slot_count = 3;
    func.frame.slot_cap   = 3;
    layout_function(?func, 16);
    if (func.frame.realign != 0)    { ret 53; }
    if (slots_from_sp(?func.frame)) { ret 54; }
    ret 0;
}

#[testing]
val TEST_FP:    codegen_mir.PRegId = codegen_mir.PRegId{n: 5};
#[testing]
val TEST_SP:    codegen_mir.PRegId = codegen_mir.PRegId{n: 4};
#[testing]
val TEST_OTHER: codegen_mir.PRegId = codegen_mir.PRegId{n: 9};

#[testing]
fun mk_func(blk: *codegen_mir.MirBlock, func: *codegen_mir.MirFunction, instrs: *codegen_mir.MirInstr, n: u32) {
    blk.id          = 0;
    blk.instrs      = instrs;
    blk.instr_count = n;
    blk.instr_cap   = n;
    blk.preds       = nil;
    blk.pred_count  = 0;
    blk.pred_cap    = 0;

    func.blocks      = blk;
    func.block_count = 1;
    func.block_cap   = 1;
    func.vregs       = nil;
    func.vreg_count  = 0;
    func.vreg_cap    = 0;

    func.frame.slots         = nil;
    func.frame.slot_count    = 0;
    func.frame.slot_cap      = 0;
    func.frame.size          = 0;
    func.frame.align         = 16;
    func.frame.outgoing_size = 0;
    func.frame.realign       = 0;
    func.frame.base_dist     = 0;
    func.frame.omit          = false;
    func.frame.sp_frame      = false;
    func.frame.sp_fixed      = false;
    func.frame.opaque        = false;
    func.callee_mask         = 0;
    func.callee_mask_fp      = 0;
    func.naked               = false;
}

#[testing]
fun mk_instr(mi: *codegen_mir.MirInstr, op: codegen_mir.MirOpcode) {
    mi.opcode            = op;
    mi.operands          = nil;
    mi.operand_count     = 0;
    mi.width             = 8;
    mi.src_width         = 8;
    mi.asm_block         = nil;
    mi.dbg_bindings      = nil;
    mi.dbg_binding_count = 0;
    mi.inline_site       = 0;
    mi.vec_lane          = 0;
}

test omits_frame__an_allocated_frame_keeps_it {
    var instrs: [1]codegen_mir.MirInstr;
    mk_instr(?instrs[0], codegen_mir.MIR_RET);

    var blk:  codegen_mir.MirBlock;
    var func: codegen_mir.MirFunction;

    mk_func(?blk, ?func, ?instrs[0], 1);
    func.frame.size = 16;
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    mk_func(?blk, ?func, ?instrs[0], 1);
    func.callee_mask = 1 << 3;
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    mk_func(?blk, ?func, ?instrs[0], 1);
    func.callee_mask_fp = 1 << 6;
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    mk_func(?blk, ?func, ?instrs[0], 1);
    func.frame.outgoing_size = 32;
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    ret 0;
}

test omits_frame__frame_relative_operand_keeps_the_frame {
    var blk:  codegen_mir.MirBlock;
    var func: codegen_mir.MirFunction;

    var fp_ops: [1]codegen_mir.MirOperand;
    fp_ops[0] = codegen_mir.op_mem_preg(TEST_FP, 16);
    var fp_instrs: [1]codegen_mir.MirInstr;
    mk_instr(?fp_instrs[0], codegen_mir.MIR_LOAD);
    fp_instrs[0].operands      = ?fp_ops[0];
    fp_instrs[0].operand_count = 1;
    mk_func(?blk, ?func, ?fp_instrs[0], 1);
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    var sp_ops: [1]codegen_mir.MirOperand;
    sp_ops[0] = codegen_mir.op_mem_preg(TEST_SP, 8);
    var sp_instrs: [1]codegen_mir.MirInstr;
    mk_instr(?sp_instrs[0], codegen_mir.MIR_STORE);
    sp_instrs[0].operands      = ?sp_ops[0];
    sp_instrs[0].operand_count = 1;
    mk_func(?blk, ?func, ?sp_instrs[0], 1);
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    var ix_ops: [1]codegen_mir.MirOperand;
    ix_ops[0]       = codegen_mir.op_mem_preg(TEST_OTHER, 0);
    ix_ops[0].index = codegen_mir.index_preg(TEST_FP);
    var ix_instrs: [1]codegen_mir.MirInstr;
    mk_instr(?ix_instrs[0], codegen_mir.MIR_LOAD);
    ix_instrs[0].operands      = ?ix_ops[0];
    ix_instrs[0].operand_count = 1;
    mk_func(?blk, ?func, ?ix_instrs[0], 1);
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    var ok_ops: [1]codegen_mir.MirOperand;
    ok_ops[0] = codegen_mir.op_mem_preg(TEST_OTHER, 0);
    var ok_instrs: [1]codegen_mir.MirInstr;
    mk_instr(?ok_instrs[0], codegen_mir.MIR_LOAD);
    ok_instrs[0].operands      = ?ok_ops[0];
    ok_instrs[0].operand_count = 1;
    mk_func(?blk, ?func, ?ok_instrs[0], 1);
    if (!omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    ret 0;
}

test omits_frame__asm_alone_omits_asm_with_a_call_does_not {
    var payload: codegen_mir.MirAsm;

    var leaf: [2]codegen_mir.MirInstr;
    mk_instr(?leaf[0], codegen_mir.MIR_ASM);
    leaf[0].asm_block = ?payload;
    mk_instr(?leaf[1], codegen_mir.MIR_RET);

    var blk:  codegen_mir.MirBlock;
    var func: codegen_mir.MirFunction;
    mk_func(?blk, ?func, ?leaf[0], 2);
    if (!omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    var calling: [2]codegen_mir.MirInstr;
    mk_instr(?calling[0], codegen_mir.MIR_ASM);
    calling[0].asm_block = ?payload;
    mk_instr(?calling[1], codegen_mir.MIR_CALL);
    mk_func(?blk, ?func, ?calling[0], 2);
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    mk_func(?blk, ?func, ?leaf[0], 2);
    func.frame.size = 8;
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    ret 0;
}

test omits_frame__naked_omits_unconditionally {
    var ops: [1]codegen_mir.MirOperand;
    ops[0] = codegen_mir.op_mem_preg(TEST_FP, 16);

    var instrs: [2]codegen_mir.MirInstr;
    mk_instr(?instrs[0], codegen_mir.MIR_CALL);
    mk_instr(?instrs[1], codegen_mir.MIR_LOAD);
    instrs[1].operands      = ?ops[0];
    instrs[1].operand_count = 1;

    var blk:  codegen_mir.MirBlock;
    var func: codegen_mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 2);
    func.frame.size          = 32;
    func.callee_mask         = 1 << 3;
    func.callee_mask_fp      = 1 << 6;
    func.frame.outgoing_size = 16;

    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }
    func.naked = true;
    if (!omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }
    ret 0;
}

#[testing]
fun t_frame_dist(model: *isa.MachineModel, func: *codegen_mir.MirFunction, base_dist: *u32, fp_dist: *u32) {
    @base_dist = 96;
    @fp_dist   = 32;
}

#[testing]
fun t_is_reg_move(opcode: u32) bool {
    ret false;
}

#[testing]
fun t_is_trap_terminator(opcode: u32) bool {
    ret false;
}

#[testing]
fun t_frame_machine() isa.RegMachine {
    var m: isa.RegMachine = isa.reg_machine(nil, nil, t_is_reg_move, t_is_trap_terminator,
        nil, 0, nil, 0,
        -1, -1,
        -1, -1, 0,
        -1, -1, -1);
    isa.with_frame_dist(?m, t_frame_dist);
    ret m;
}

test run__stamps_the_omission_decision {
    var leaf_instrs: [1]codegen_mir.MirInstr;
    mk_instr(?leaf_instrs[0], codegen_mir.MIR_RET);

    var call_instrs: [1]codegen_mir.MirInstr;
    mk_instr(?call_instrs[0], codegen_mir.MIR_CALL);

    var blocks: [2]codegen_mir.MirBlock;
    var funcs:  [2]codegen_mir.MirFunction;
    mk_func(?blocks[0], ?funcs[0], ?leaf_instrs[0], 1);
    mk_func(?blocks[1], ?funcs[1], ?call_instrs[0], 1);

    var m: codegen_mir.MirModule;
    m.alloc        = nil;
    m.interner     = nil;
    m.srcmap       = nil;
    m.functions    = ?funcs[0];
    m.function_len = 2;
    m.function_cap = 2;

    var abi_vt: abi.AbiVTable = abi.abi_vtable(
        0, "", 0,
        nil, nil,
        nil, nil,
        16, 0, 0,
        -1, false,
        false, 8,
        0, 8,
        nil);

    var machine: isa.RegMachine = t_frame_machine();

    var tgt: resolved.Target;
    tgt.abi                 = ?abi_vt;
    tgt.model.frame_ptr_reg = TEST_FP::i32;
    tgt.model.stack_ptr_reg = TEST_SP::i32;

    val undeclared: err[fail.Fail] = run(?tgt, ?m);
    if (!sel undeclared.err) { ret 1; }

    tgt.arch = ?machine;
    val r: err[fail.Fail] = run(?tgt, ?m);
    if (sel r.err) { ret 1; }

    if (!funcs[0].frame.omit)           { ret 1; }
    if (funcs[1].frame.omit)            { ret 1; }
    if (funcs[0].frame.base_dist != 96) { ret 1; }
    if (funcs[0].frame.fp_dist != 32)   { ret 1; }
    # an omitted frame has no prologue to fix sp; a kept one whose body writes no sp does
    if (sp_fixed(?funcs[0].frame))  { ret 2; }
    if (!sp_fixed(?funcs[1].frame)) { ret 3; }

    # a register operand naming sp clears it
    var ops: [1]codegen_mir.MirOperand;
    ops[0]                       = codegen_mir.op_preg(TEST_SP);
    call_instrs[0].operands      = ?ops[0];
    call_instrs[0].operand_count = 1;
    val r2: err[fail.Fail] = run(?tgt, ?m);
    if (sel r2.err)                { ret 4; }
    if (sp_fixed(?funcs[1].frame)) { ret 5; }

    # after selection the asm payload marks the block, never the opcode number:
    # a selected opcode sharing MIR_ASM's runs no asm, a retagged block still does
    call_instrs[0].operands      = nil;
    call_instrs[0].operand_count = 0;
    call_instrs[0].opcode        = codegen_mir.MIR_ASM;
    funcs[1].callee_mask         = 1;
    val r3: err[fail.Fail] = run(?tgt, ?m);
    if (sel r3.err) { ret 6; }
    # with no call left it is a leaf, and running no asm lets it frame from sp
    if (funcs[1].frame.opaque || !funcs[1].frame.sp_frame) { ret 7; }
    var payload: codegen_mir.MirAsm;
    payload.body             = "mov rsp, rbp";
    call_instrs[0].opcode    = x64.ASM_BLOCK::u32;
    call_instrs[0].asm_block = ?payload;
    val r4: err[fail.Fail] = run(?tgt, ?m);
    if (sel r4.err)                                          { ret 8; }
    if (sp_fixed(?funcs[1].frame) || !funcs[1].frame.opaque) { ret 9; }

    # a leaf with a register to save frames from sp, which a call rules out
    funcs[0].callee_mask = 1 << 3;
    val r5: err[fail.Fail] = run(?tgt, ?m);
    if (sel r5.err)                                                   { ret 10; }
    if (funcs[0].frame.omit || !funcs[0].frame.sp_frame)              { ret 11; }
    if (sp_fixed(?funcs[0].frame) || !slots_from_sp(?funcs[0].frame)) { ret 12; }
    if (funcs[1].frame.sp_frame)                                      { ret 13; }
    ret 0;
}

test check_frame_fits__boundary_is_exact {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var m: codegen_mir.MirModule;
    m.alloc        = ?alloc;
    m.interner     = ?i;
    m.srcmap       = nil;
    m.functions    = nil;
    m.function_len = 0;
    m.function_cap = 0;

    val nr: res[intern.StrId, A.Error] = intern.intern(?i, "fat");
    if (sel nr.err) { ret 1; }

    var f: codegen_mir.MirFunction;
    f.name = nr.ok;

    var bad: i32 = 0;

    f.frame.size = 1048575;
    val check_frame_fits_r: err[fail.Fail] = check_frame_fits(?m, ?f, 1048576);
    if (sel check_frame_fits_r.err && bad == 0) { bad = 2; }

    f.frame.size = 1048576;
    val check_frame_fits_r2: err[fail.Fail] = check_frame_fits(?m, ?f, 1048576);
    if (sel check_frame_fits_r2.ok && bad == 0) { bad = 3; }

    f.frame.size = 1107824;
    val over: err[fail.Fail] = check_frame_fits(?m, ?f, 1048576);
    if (sel over.err) {
        val msg: str = fail.describe(over.err);
        if (!str_contains(msg, "fat") && bad == 0)     { bad = 5; }
        if (!str_contains(msg, "1107824") && bad == 0) { bad = 6; }
        if (!str_contains(msg, "1048576") && bad == 0) { bad = 7; }
    }
    if (sel over.ok) { bad = 4; }

    f.frame.size = 999999999;
    val check_frame_fits_r3: err[fail.Fail] = check_frame_fits(?m, ?f, 0);
    if (sel check_frame_fits_r3.err && bad == 0) { bad = 8; }

    ret bad;
}

test layout_function__refuses_sizes_past_the_u32_limit {
    var instrs: [1]codegen_mir.MirInstr;
    mk_instr(?instrs[0], codegen_mir.MIR_MOV);

    var blk:  codegen_mir.MirBlock;
    var func: codegen_mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 1);

    var slots: [1]codegen_mir.MirSlot;
    slots[0].value  = 0;
    slots[0].kind   = codegen_mir.SLOT_ALLOCA;
    slots[0].offset = 0;
    slots[0].size   = 32;
    slots[0].align  = 16;

    func.frame.slots         = ?slots[0];
    func.frame.slot_count    = 1;
    func.frame.slot_cap      = 1;
    func.frame.outgoing_size = 24;
    val ordinary: err[fail.Fail] = layout_function(?func, 16);
    if (sel ordinary.err)               { ret 1; }
    if (func.frame.size != 32)          { ret 2; }
    if (func.frame.outgoing_size != 32) { ret 3; }

    func.frame.outgoing_size = 0xFFFFFFFF;
    val outgoing: err[fail.Fail] = layout_function(?func, 16);
    if (!sel outgoing.err) { ret 4; }

    func.frame.outgoing_size = 0;
    slots[0].size            = 0xFFFFFFFF;
    slots[0].align           = 1;
    val sized: err[fail.Fail] = layout_function(?func, 16);
    if (!sel sized.err) { ret 5; }
    ret 0;
}

# three slot addresses: one a store reads, one nothing reads and one a debug
# binding describes. the unread one goes with its slot, the others stay
test prune__drops_an_unread_slot_address_and_its_slot {
    var alloc: A.Allocator;
    page.make(?alloc);

    var ops: [11]codegen_mir.MirOperand;
    ops[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    ops[1] = codegen_mir.op_mem_slot(codegen_mir.vreg_id(3), 0);
    ops[2] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    ops[3] = codegen_mir.op_mem_slot(codegen_mir.vreg_id(4), 0);
    ops[4] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    ops[5] = codegen_mir.op_mem_slot(codegen_mir.vreg_id(5), 0);
    ops[6] = codegen_mir.op_mem_value(codegen_mir.vreg_id(0), 0);
    ops[7] = codegen_mir.op_imm(0);
    var owned: [4]*codegen_mir.MirOperand;
    var n:     u32 = 0;
    for (n < 4) {
        val r: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](?alloc, 2::usize);
        if (sel r.err) { ret 1; }
        owned[n]    = r.ok;
        owned[n][0] = ops[2 * n];
        owned[n][1] = ops[2 * n + 1];
        n           = n + 1;
    }
    var instrs: [5]codegen_mir.MirInstr;
    mk_instr(?instrs[0], codegen_mir.MIR_ALLOCA);
    mk_instr(?instrs[1], codegen_mir.MIR_ALLOCA);
    mk_instr(?instrs[2], codegen_mir.MIR_ALLOCA);
    mk_instr(?instrs[3], codegen_mir.MIR_STORE);
    mk_instr(?instrs[4], codegen_mir.MIR_RET);
    n = 0;
    for (n < 4) {
        instrs[n].operands      = owned[n];
        instrs[n].operand_count = 2;
        n                       = n + 1;
    }
    val bound: err[fail.Fail] = codegen_mir.instr_attach_dbg(?alloc, ?instrs[3], 9, 2);
    if (sel bound.err) { ret 1; }

    var vregs: [6]codegen_mir.MirVReg;
    n = 0;
    for (n < 6) {
        vregs[n]          = codegen_mir.vreg(n, codegen_mir.REG_CLASS_GP, 0, false);
        vregs[n].home_key = codegen_mir.MIR_VREG_NIL.n;
        n                 = n + 1;
    }
    var slots: [3]codegen_mir.MirSlot;
    n = 0;
    for (n < 3) {
        slots[n].value = n + 3;
        slots[n].kind  = codegen_mir.SLOT_ALLOCA;
        slots[n].size  = 8;
        slots[n].align = 8;
        n              = n + 1;
    }

    var blk:  codegen_mir.MirBlock;
    var func: codegen_mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 5);
    func.vregs            = ?vregs[0];
    func.vreg_count       = 6;
    func.frame.slots      = ?slots[0];
    func.frame.slot_count = 3;
    val pr: err[fail.Fail] = prune_function(?alloc, ?func);
    if (sel pr.err) { ret 2; }

    if (blk.instr_count != 4)                       { ret 3; }
    if (blk.instrs[0].operands[0].vreg.n != 0)      { ret 4; }
    if (blk.instrs[1].operands[0].vreg.n != 2)      { ret 5; }
    if (func.frame.slot_count != 2)                 { ret 6; }
    if (slots[0].value != 3 || slots[1].value != 5) { ret 7; }
    ret 0;
}
