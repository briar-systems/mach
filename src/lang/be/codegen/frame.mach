use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use O: std.types.option;
use R: std.types.result;
use std.allocator.page;
use std.types.string.str_contains;
use A: std.allocator;
use std.format;
use mach.lang.target.of;

use mach.lang.be.codegen.mir;
use mach.lang.intern;
use mach.lang.layout;
use mach.lang.target.abi;
use mach.lang.target.isa;
use target: mach.lang.target.resolved;

pub val DEFAULT_STACK_ALIGN: u32 = 16;

rec FrameByteUnit {
}

pub fun run(tgt: *target.Target, m: *mir.MirModule) R.Result[R.Void, str] {
    if (m == nil) { ret R.err[R.Void, str]("frame.run: nil mir module"); }
    if (tgt == nil || tgt.abi == nil) {
        ret R.err[R.Void, str]("frame.run: target has no ABI");
    }

    val align: u32 = stack_align(tgt);

    val reserve: u64 = of.effective_stack_reserve(tgt.of, tgt.stack_reserve);

    var fi: u32 = 0;
    for (fi < m.function_len) {
        val func: *mir.MirFunction = ?m.functions[fi];
        val laid_out: R.Result[R.Void, str] = layout_function(func, align);
        if (R.is_err[R.Void, str](laid_out)) { ret laid_out; }
        func.frame.omit = omits_frame(func, tgt.model.frame_ptr_reg::u32,
                                      tgt.model.stack_ptr_reg::u32);
        val distd: R.Result[R.Void, str] = set_frame_dist(tgt, func);
        if (R.is_err[R.Void, str](distd)) { ret distd; }

        val over: R.Result[R.Void, str] = check_frame_fits(m, func, reserve);
        if (R.is_err[R.Void, str](over)) { ret over; }
        fi = fi + 1;
    }

    ret R.ok_void[str]();
}

fun check_frame_fits(m: *mir.MirModule, func: *mir.MirFunction, reserve: u64) R.Result[R.Void, str] {
    if (reserve == 0) { ret R.ok_void[str](); }
    if (func.frame.size::u64 < reserve) { ret R.ok_void[str](); }

    var name: str = "<unknown>";
    if (m.interner != nil) {
        val o: O.Option[str] = intern.lookup(m.interner, func.name);
        if (O.is_some[str](o)) { name = O.unwrap[str](o); }
    }

    val r: R.Result[str, str] = format.sprint(m.alloc,
        "frame: `{}` needs a {}-byte stack frame, which its target's {}-byte stack reserve cannot hold; raise `stack_reserve` on the target, or move the large locals off the stack",
        name, func.frame.size::u64, reserve);
    if (R.is_err[str, str](r)) {
        ret R.err[R.Void, str]("frame: a function's stack frame exceeds the target's stack reserve");
    }
    ret R.err[R.Void, str](R.unwrap_ok[str, str](r));
}

fun set_frame_dist(tgt: *target.Target, func: *mir.MirFunction) R.Result[R.Void, str] {
    if (tgt.arch == nil || tgt.arch.frame_dist == nil) {
        ret R.err[R.Void, str]("frame: target declares no frame-distance model; an instruction set that reaches frame insertion must declare one");
    }
    var base_dist: u32 = 0;
    var fp_dist:   u32 = 0;
    tgt.arch.frame_dist(?tgt.model, func, ?base_dist, ?fp_dist);
    func.frame.base_dist = base_dist;
    func.frame.fp_dist   = fp_dist;
    ret R.ok_void[str]();
}

pub fun omits_frame(func: *mir.MirFunction, fp: u32, sp: u32) bool {
    if (func.naked) { ret true; }

    if (func.frame.size != 0)          { ret false; }
    if (func.callee_mask != 0)         { ret false; }
    if (func.callee_mask_fp != 0)      { ret false; }
    if (func.frame.outgoing_size != 0) { ret false; }

    var calls: bool = false;
    var frame_ref: bool = false;

    var bi: u32 = 0;
    for (bi < func.block_count) {
        val blk: *mir.MirBlock = ?func.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mi.opcode == mir.MIR_CALL) { calls = true; }
            var oi: u32 = 0;
            for (oi < mi.operand_count) {
                if (operand_is_frame_relative(?mi.operands[oi], fp, sp)) { frame_ref = true; }
                oi = oi + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    ret !calls && !frame_ref;
}

fun operand_is_frame_relative(o: *mir.MirOperand, fp: u32, sp: u32) bool {
    if (o.kind != mir.MIR_OP_MEM) { ret false; }
    if (o.vreg == mir.MIR_VREG_NIL && (o.preg == fp || o.preg == sp)) { ret true; }
    if (o.index_is_preg && (o.index == fp || o.index == sp))          { ret true; }
    ret false;
}

pub fun slot_offset(frame: *mir.MirFrame, v: u32) O.Option[i64] {
    val opt_slot: O.Option[*mir.MirSlot] = slot_find(frame, v);
    if (!O.is_some[*mir.MirSlot](opt_slot)) { ret O.none[i64](); }
    ret O.some[i64](O.unwrap[*mir.MirSlot](opt_slot).offset - frame.fp_dist::i64);
}

pub fun slot_sp_offset(frame: *mir.MirFrame, v: u32) O.Option[i64] {
    val opt_slot: O.Option[*mir.MirSlot] = slot_find(frame, v);
    if (!O.is_some[*mir.MirSlot](opt_slot)) { ret O.none[i64](); }
    ret O.some[i64](frame.base_dist::i64 + O.unwrap[*mir.MirSlot](opt_slot).offset);
}

pub fun slots_from_sp(frame: *mir.MirFrame) bool {
    ret frame.realign != 0;
}

pub fun is_slot(frame: *mir.MirFrame, v: u32) bool {
    ret O.is_some[*mir.MirSlot](slot_find(frame, v));
}

pub fun is_alloca_slot(frame: *mir.MirFrame, v: u32) bool {
    val opt_slot: O.Option[*mir.MirSlot] = slot_find(frame, v);
    if (!O.is_some[*mir.MirSlot](opt_slot)) { ret false; }
    ret O.unwrap[*mir.MirSlot](opt_slot).kind == mir.SLOT_ALLOCA;
}

fun stack_align(tgt: *target.Target) u32 {
    if (tgt.abi.stack_align == 0) { ret DEFAULT_STACK_ALIGN; }
    ret tgt.abi.stack_align;
}

fun layout_function(func: *mir.MirFunction, align: u32) R.Result[R.Void, str] {
    val frame: *mir.MirFrame = ?func.frame;
    frame.align = align;
    frame.realign = over_alignment(frame, align);

    val align_r: R.Result[layout.CheckedAlignment[FrameByteUnit], layout.CheckCause] =
        layout.alignment[FrameByteUnit](align::usize);
    if (R.is_err[layout.CheckedAlignment[FrameByteUnit], layout.CheckCause](align_r)) {
        ret R.err[R.Void, str]("frame: stack alignment is invalid");
    }
    val frame_align: layout.CheckedAlignment[FrameByteUnit] =
        R.unwrap_ok[layout.CheckedAlignment[FrameByteUnit], layout.CheckCause](align_r);

    var offset: i64 = 0;

    var si: u32 = 0;
    for (si < frame.slot_count) {
        if (!slot_is_asm_bound(func, frame.slots[si].value)) {
            offset = place_slot(?frame.slots[si], offset);
        }
        si = si + 1;
    }
    si = 0;
    for (si < frame.slot_count) {
        if (slot_is_asm_bound(func, frame.slots[si].value)) {
            offset = place_slot(?frame.slots[si], offset);
        }
        si = si + 1;
    }

    var size: usize = 0;
    if (offset < 0) {
        val aligned_r: R.Result[layout.CheckedOffset[FrameByteUnit], layout.CheckCause] =
            layout.align_offset_up[FrameByteUnit](layout.offset[FrameByteUnit]((-offset)::usize), frame_align);
        if (R.is_err[layout.CheckedOffset[FrameByteUnit], layout.CheckCause](aligned_r)) {
            ret R.err[R.Void, str]("frame: stack frame size overflows while rounding up to the stack alignment");
        }
        size = R.unwrap_ok[layout.CheckedOffset[FrameByteUnit], layout.CheckCause](aligned_r).value;
    }
    val size_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(size);
    if (R.is_err[u32, layout.CheckCause](size_fits)) {
        ret R.err[R.Void, str]("frame: stack frame size exceeds the u32 limit");
    }
    frame.size = R.unwrap_ok[u32, layout.CheckCause](size_fits);

    if (frame.outgoing_size > 0) {
        val outgoing_r: R.Result[layout.CheckedOffset[FrameByteUnit], layout.CheckCause] =
            layout.align_offset_up[FrameByteUnit](layout.offset[FrameByteUnit](frame.outgoing_size::usize), frame_align);
        if (R.is_err[layout.CheckedOffset[FrameByteUnit], layout.CheckCause](outgoing_r)) {
            ret R.err[R.Void, str]("frame: outgoing argument area overflows while rounding up to the stack alignment");
        }
        val outgoing_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
            R.unwrap_ok[layout.CheckedOffset[FrameByteUnit], layout.CheckCause](outgoing_r).value);
        if (R.is_err[u32, layout.CheckCause](outgoing_fits)) {
            ret R.err[R.Void, str]("frame: outgoing argument area exceeds the u32 limit");
        }
        frame.outgoing_size = R.unwrap_ok[u32, layout.CheckCause](outgoing_fits);
    }
    ret R.ok_void[str]();
}

fun over_alignment(frame: *mir.MirFrame, align: u32) u32 {
    if (frame.slots == nil) { ret 0; }
    var most: u32 = align;
    var i: u32 = 0;
    for (i < frame.slot_count) {
        if (frame.slots[i].align > most) { most = frame.slots[i].align; }
        i = i + 1;
    }
    if (most <= align) { ret 0; }
    ret most;
}

fun place_slot(slot: *mir.MirSlot, offset: i64) i64 {
    var slot_align: i64 = 1;
    if (slot.align > 0) { slot_align = slot.align::i64; }

    var next: i64 = offset - slot.size::i64;
    if (slot_align > 1) {
        val mask: i64 = slot_align - 1;
        next = next & ~mask;
    }

    slot.offset = next;
    ret next;
}

fun slot_is_asm_bound(func: *mir.MirFunction, v: u32) bool {
    var bi: u32 = 0;
    for (bi < func.block_count) {
        val blk: *mir.MirBlock = ?func.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mi.opcode == mir.MIR_ASM && mi.asm_block != nil) {
                var k: u32 = 0;
                for (k < mi.asm_block.bind_count) {
                    if (mi.asm_block.binds[k].slot_vreg == v) { ret true; }
                    k = k + 1;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

fun slot_find(frame: *mir.MirFrame, v: u32) O.Option[*mir.MirSlot] {
    if (frame == nil)       { ret O.none[*mir.MirSlot](); }
    if (frame.slots == nil) { ret O.none[*mir.MirSlot](); }

    var i: u32 = 0;
    for (i < frame.slot_count) {
        if (frame.slots[i].value == v) {
            ret O.some[*mir.MirSlot](?frame.slots[i]);
        }
        i = i + 1;
    }
    ret O.none[*mir.MirSlot]();
}

test "mach.lang.be.codegen.frame.slot_offset:alloca_and_spill_lookup" {
    var slots: [2]mir.MirSlot;
    slots[0].value  = 10;
    slots[0].kind   = mir.SLOT_ALLOCA;
    slots[0].offset = -16;
    slots[0].size   = 16;
    slots[0].align  = 16;

    slots[1].value  = 20;
    slots[1].kind   = mir.SLOT_SPILL;
    slots[1].offset = -24;
    slots[1].size   = 8;
    slots[1].align  = 8;

    var frame: mir.MirFrame;
    frame.slots         = ?slots[0];
    frame.slot_count    = 2;
    frame.slot_cap      = 2;
    frame.size          = 0;
    frame.align         = 0;
    frame.outgoing_size = 0;
    frame.realign       = 0;
    frame.base_dist     = 0;
    frame.fp_dist       = 0;

    val opt_off10: O.Option[i64] = slot_offset(?frame, 10);
    if (!O.is_some[i64](opt_off10))      { ret 1; }
    if (O.unwrap[i64](opt_off10) != -16) { ret 1; }

    val opt_off20: O.Option[i64] = slot_offset(?frame, 20);
    if (!O.is_some[i64](opt_off20))      { ret 1; }
    if (O.unwrap[i64](opt_off20) != -24) { ret 1; }

    val opt_off99: O.Option[i64] = slot_offset(?frame, 99);
    if (O.is_some[i64](opt_off99))       { ret 1; }

    frame.fp_dist = 32;
    val biased10: O.Option[i64] = slot_offset(?frame, 10);
    if (!O.is_some[i64](biased10))      { ret 1; }
    if (O.unwrap[i64](biased10) != -48) { ret 1; }
    val biased20: O.Option[i64] = slot_offset(?frame, 20);
    if (!O.is_some[i64](biased20))      { ret 1; }
    if (O.unwrap[i64](biased20) != -56) { ret 1; }
    frame.fp_dist = 0;

    if (!is_alloca_slot(?frame, 10)) { ret 1; }
    if (is_alloca_slot(?frame, 20))  { ret 1; }
    if (!is_slot(?frame, 10))        { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.frame.layout_function:asm_bound_slots_are_nearest_the_stack_pointer" {
    var instrs: [1]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_ASM);

    var binds: [1]mir.MirAsmBind;
    binds[0] = mir.asm_bind(0::intern.StrId, 7, false);
    var payload: mir.MirAsm;
    payload.isa        = "x86_64";
    payload.body       = "nop";
    payload.binds      = ?binds[0];
    payload.bind_count = 1;
    instrs[0].asm_block = ?payload;

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 1);

    var slots: [5]mir.MirSlot;
    slots[0].value  = 7;
    slots[0].kind   = mir.SLOT_ALLOCA;
    slots[0].offset = 0;
    slots[0].size   = 8;
    slots[0].align  = 8;
    var i: u32 = 1;
    for (i < 5) {
        slots[i::usize].value  = i;
        slots[i::usize].kind   = mir.SLOT_ALLOCA;
        slots[i::usize].offset = 0;
        slots[i::usize].size   = 256;
        slots[i::usize].align  = 8;
        i = i + 1;
    }

    func.frame.slots      = ?slots[0];
    func.frame.slot_count = 5;
    func.frame.slot_cap   = 5;

    layout_function(?func, 16);

    if (func.frame.size::i64 + slots[0].offset > 8) { ret 21; }

    var j: usize = 1;
    for (j < 5) {
        if (slots[j].offset <= slots[0].offset) { ret 22; }
        j = j + 1;
    }
    if (func.frame.size < 1032) { ret 23; }

    if (!slot_is_asm_bound(?func, 7)) { ret 24; }
    if (slot_is_asm_bound(?func, 1))  { ret 25; }
    if (slot_is_asm_bound(?func, 4))  { ret 26; }
    ret 0;
}

test "mach.lang.be.codegen.frame.layout_function:no_asm_keeps_slot_order" {
    var instrs: [1]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_MOV);

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 1);

    var slots: [3]mir.MirSlot;
    var i: usize = 0;
    for (i < 3) {
        slots[i].value  = i::u32;
        slots[i].kind   = mir.SLOT_ALLOCA;
        slots[i].offset = 0;
        slots[i].size   = 8;
        slots[i].align  = 8;
        i = i + 1;
    }

    func.frame.slots      = ?slots[0];
    func.frame.slot_count = 3;
    func.frame.slot_cap   = 3;

    layout_function(?func, 16);

    if (slots[0].offset >= 0)                 { ret 11; }
    if (slots[1].offset >= slots[0].offset)   { ret 12; }
    if (slots[2].offset >= slots[1].offset)   { ret 13; }

    if (slots[0].offset != -8)                { ret 14; }
    if (slots[1].offset != -16)               { ret 15; }
    if (slots[2].offset != -24)               { ret 16; }
    if (func.frame.size != 32)                { ret 17; }
    ret 0;
}

test "mach.lang.be.codegen.frame.place_slot:rounds_down_without_dropping_a_unit" {
    var instrs: [1]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_MOV);

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 1);

    var sizes:  [6]u32;
    var aligns: [6]u32;
    sizes[0] = 1;  aligns[0] = 1;
    sizes[1] = 2;  aligns[1] = 2;
    sizes[2] = 4;  aligns[2] = 4;
    sizes[3] = 8;  aligns[3] = 8;
    sizes[4] = 16; aligns[4] = 16;
    sizes[5] = 32; aligns[5] = 32;

    var slots: [6]mir.MirSlot;
    var i: usize = 0;
    for (i < 6) {
        slots[i].value  = i::u32;
        slots[i].kind   = mir.SLOT_ALLOCA;
        slots[i].offset = 0;
        slots[i].size   = sizes[i];
        slots[i].align  = aligns[i];
        i = i + 1;
    }

    func.frame.slots      = ?slots[0];
    func.frame.slot_count = 6;
    func.frame.slot_cap   = 6;

    layout_function(?func, 16);

    if (slots[0].offset != -1)   { ret 31; }
    if (slots[1].offset != -4)   { ret 32; }
    if (slots[2].offset != -8)   { ret 33; }
    if (slots[3].offset != -16)  { ret 34; }
    if (slots[4].offset != -32)  { ret 35; }
    if (slots[5].offset != -64)  { ret 36; }
    if (func.frame.size != 64)   { ret 37; }

    var j: usize = 0;
    for (j < 6) {
        if ((slots[j].offset & (aligns[j]::i64 - 1)) != 0) { ret 38; }
        j = j + 1;
    }

    var k: usize = 0;
    for (k < 6) {
        var n: usize = 0;
        for (n < 6) {
            if (n != k) {
                val a_lo: i64 = slots[k].offset;
                val a_hi: i64 = a_lo + slots[k].size::i64;
                val b_lo: i64 = slots[n].offset;
                val b_hi: i64 = b_lo + slots[n].size::i64;
                if (a_lo < b_hi && b_lo < a_hi) { ret 39; }
            }
            n = n + 1;
        }
        if (slots[k].offset + func.frame.size::i64 < 0) { ret 40; }
        if (slots[k].offset + slots[k].size::i64 > 0)   { ret 41; }
        k = k + 1;
    }
    ret 0;
}

test "mach.lang.be.codegen.frame.layout_function:records_the_largest_over_alignment" {
    var instrs: [1]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_MOV);

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 1);

    var aligns: [4]u32;
    aligns[0] = 8; aligns[1] = 128; aligns[2] = 32; aligns[3] = 8;

    var slots: [4]mir.MirSlot;
    var i: usize = 0;
    for (i < 4) {
        slots[i].value  = i::u32;
        slots[i].kind   = mir.SLOT_ALLOCA;
        slots[i].offset = 0;
        slots[i].size   = aligns[i];
        slots[i].align  = aligns[i];
        i = i + 1;
    }

    func.frame.slots      = ?slots[0];
    func.frame.slot_count = 4;
    func.frame.slot_cap   = 4;

    layout_function(?func, 16);
    if (func.frame.realign != 128) { ret 51; }
    if (!slots_from_sp(?func.frame)) { ret 52; }

    var plain: [3]mir.MirSlot;
    var j: usize = 0;
    for (j < 3) {
        plain[j].value  = j::u32;
        plain[j].kind   = mir.SLOT_ALLOCA;
        plain[j].offset = 0;
        plain[j].size   = 16;
        plain[j].align  = 16;
        j = j + 1;
    }
    mk_func(?blk, ?func, ?instrs[0], 1);
    func.frame.slots      = ?plain[0];
    func.frame.slot_count = 3;
    func.frame.slot_cap   = 3;
    layout_function(?func, 16);
    if (func.frame.realign != 0)    { ret 53; }
    if (slots_from_sp(?func.frame)) { ret 54; }
    ret 0;
}

test "mach.lang.be.codegen.frame.slot_sp_offset:adds_the_stamped_base_distance" {
    var slots: [2]mir.MirSlot;
    slots[0].value  = 10;
    slots[0].kind   = mir.SLOT_ALLOCA;
    slots[0].offset = -32;
    slots[0].size   = 32;
    slots[0].align  = 32;

    slots[1].value  = 20;
    slots[1].kind   = mir.SLOT_SPILL;
    slots[1].offset = -40;
    slots[1].size   = 8;
    slots[1].align  = 8;

    var frame: mir.MirFrame;
    frame.slots         = ?slots[0];
    frame.slot_count    = 2;
    frame.slot_cap      = 2;
    frame.size          = 64;
    frame.align         = 16;
    frame.outgoing_size = 0;
    frame.realign       = 32;
    frame.base_dist     = 96;
    frame.omit          = false;

    val a: O.Option[i64] = slot_sp_offset(?frame, 10);
    if (!O.is_some[i64](a))     { ret 61; }
    if (O.unwrap[i64](a) != 64) { ret 62; }

    val b: O.Option[i64] = slot_sp_offset(?frame, 20);
    if (!O.is_some[i64](b))     { ret 63; }
    if (O.unwrap[i64](b) != 56) { ret 64; }

    if (O.is_some[i64](slot_sp_offset(?frame, 99))) { ret 65; }
    ret 0;
}

val TEST_FP:    u32 = 5;
val TEST_SP:    u32 = 4;
val TEST_OTHER: u32 = 9;

fun mk_func(blk: *mir.MirBlock, func: *mir.MirFunction, instrs: *mir.MirInstr, n: u32) {
    blk.id          = 0;
    blk.instrs      = instrs;
    blk.instr_count = n;
    blk.instr_cap   = n;
    blk.preds       = nil;
    blk.pred_count  = 0;
    blk.pred_cap    = 0;

    func.blocks      = blk;
    func.block_count = 1;
    func.block_cap   = 1;
    func.vregs       = nil;
    func.vreg_count  = 0;
    func.vreg_cap    = 0;

    func.frame.slots         = nil;
    func.frame.slot_count    = 0;
    func.frame.slot_cap      = 0;
    func.frame.size          = 0;
    func.frame.align         = 16;
    func.frame.outgoing_size = 0;
    func.frame.realign       = 0;
    func.frame.base_dist     = 0;
    func.frame.omit          = false;
    func.callee_mask         = 0;
    func.callee_mask_fp      = 0;
    func.naked               = false;
}

fun mk_instr(mi: *mir.MirInstr, op: mir.MirOpcode) {
    mi.opcode            = op;
    mi.operands          = nil;
    mi.operand_count     = 0;
    mi.width             = 8;
    mi.src_width         = 8;
    mi.asm_block         = nil;
    mi.dbg_bindings      = nil;
    mi.dbg_binding_count = 0;
    mi.inline_site       = 0;
    mi.vec_lane          = 0;
}

test "mach.lang.be.codegen.frame.omits_frame:bare_leaf_omits" {
    var instrs: [2]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_ADD);
    mk_instr(?instrs[1], mir.MIR_RET);

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 2);

    if (!omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.frame.omits_frame:allocated_frame_keeps_it" {
    var instrs: [1]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_RET);

    var blk: mir.MirBlock;
    var func: mir.MirFunction;

    mk_func(?blk, ?func, ?instrs[0], 1);
    func.frame.size = 16;
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    mk_func(?blk, ?func, ?instrs[0], 1);
    func.callee_mask = 1 << 3;
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    mk_func(?blk, ?func, ?instrs[0], 1);
    func.callee_mask_fp = 1 << 6;
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    mk_func(?blk, ?func, ?instrs[0], 1);
    func.frame.outgoing_size = 32;
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    ret 0;
}

test "mach.lang.be.codegen.frame.omits_frame:a_call_keeps_the_frame" {
    var instrs: [2]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_CALL);
    mk_instr(?instrs[1], mir.MIR_RET);

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 2);

    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.frame.omits_frame:frame_relative_operand_keeps_the_frame" {
    var blk: mir.MirBlock;
    var func: mir.MirFunction;

    var fp_ops: [1]mir.MirOperand;
    fp_ops[0] = mir.op_mem_preg(TEST_FP, 16);
    var fp_instrs: [1]mir.MirInstr;
    mk_instr(?fp_instrs[0], mir.MIR_LOAD);
    fp_instrs[0].operands      = ?fp_ops[0];
    fp_instrs[0].operand_count = 1;
    mk_func(?blk, ?func, ?fp_instrs[0], 1);
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    var sp_ops: [1]mir.MirOperand;
    sp_ops[0] = mir.op_mem_preg(TEST_SP, 8);
    var sp_instrs: [1]mir.MirInstr;
    mk_instr(?sp_instrs[0], mir.MIR_STORE);
    sp_instrs[0].operands      = ?sp_ops[0];
    sp_instrs[0].operand_count = 1;
    mk_func(?blk, ?func, ?sp_instrs[0], 1);
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    var ix_ops: [1]mir.MirOperand;
    ix_ops[0] = mir.op_mem_preg(TEST_OTHER, 0);
    ix_ops[0].index         = TEST_FP;
    ix_ops[0].index_is_preg = true;
    var ix_instrs: [1]mir.MirInstr;
    mk_instr(?ix_instrs[0], mir.MIR_LOAD);
    ix_instrs[0].operands      = ?ix_ops[0];
    ix_instrs[0].operand_count = 1;
    mk_func(?blk, ?func, ?ix_instrs[0], 1);
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    var ok_ops: [1]mir.MirOperand;
    ok_ops[0] = mir.op_mem_preg(TEST_OTHER, 0);
    var ok_instrs: [1]mir.MirInstr;
    mk_instr(?ok_instrs[0], mir.MIR_LOAD);
    ok_instrs[0].operands      = ?ok_ops[0];
    ok_instrs[0].operand_count = 1;
    mk_func(?blk, ?func, ?ok_instrs[0], 1);
    if (!omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    ret 0;
}

test "mach.lang.be.codegen.frame.omits_frame:asm_alone_omits_asm_with_a_call_does_not" {
    var payload: mir.MirAsm;

    var leaf: [2]mir.MirInstr;
    mk_instr(?leaf[0], mir.MIR_ASM);
    leaf[0].asm_block = ?payload;
    mk_instr(?leaf[1], mir.MIR_RET);

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?leaf[0], 2);
    if (!omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    var calling: [2]mir.MirInstr;
    mk_instr(?calling[0], mir.MIR_ASM);
    calling[0].asm_block = ?payload;
    mk_instr(?calling[1], mir.MIR_CALL);
    mk_func(?blk, ?func, ?calling[0], 2);
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    mk_func(?blk, ?func, ?leaf[0], 2);
    func.frame.size = 8;
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    ret 0;
}

test "mach.lang.be.codegen.frame.omits_frame:naked_omits_unconditionally" {
    var ops: [1]mir.MirOperand;
    ops[0] = mir.op_mem_preg(TEST_FP, 16);

    var instrs: [2]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_CALL);
    mk_instr(?instrs[1], mir.MIR_LOAD);
    instrs[1].operands      = ?ops[0];
    instrs[1].operand_count = 1;

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 2);
    func.frame.size          = 32;
    func.callee_mask         = 1 << 3;
    func.callee_mask_fp      = 1 << 6;
    func.frame.outgoing_size = 16;

    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }
    func.naked = true;
    if (!omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }
    ret 0;
}

fun t_frame_dist(model: *isa.MachineModel, func: *mir.MirFunction, base_dist: *u32, fp_dist: *u32) {
    @base_dist = 96;
    @fp_dist   = 32;
}

fun t_is_reg_move(opcode: u32) bool { ret false; }

fun t_is_trap_terminator(opcode: u32) bool { ret false; }

fun t_frame_machine() isa.RegMachine {
    var m: isa.RegMachine = isa.reg_machine(nil, nil, t_is_reg_move, t_is_trap_terminator,
                                            nil, 0, nil, 0,
                                            -1, -1,
                                            -1, -1, 0,
                                            -1, -1, -1);
    isa.with_frame_dist(?m, t_frame_dist);
    ret m;
}

test "mach.lang.be.codegen.frame.run:stamps_the_omission_decision" {
    var leaf_instrs: [1]mir.MirInstr;
    mk_instr(?leaf_instrs[0], mir.MIR_RET);

    var call_instrs: [1]mir.MirInstr;
    mk_instr(?call_instrs[0], mir.MIR_CALL);

    var blocks: [2]mir.MirBlock;
    var funcs: [2]mir.MirFunction;
    mk_func(?blocks[0], ?funcs[0], ?leaf_instrs[0], 1);
    mk_func(?blocks[1], ?funcs[1], ?call_instrs[0], 1);

    var m: mir.MirModule;
    m.alloc        = nil;
    m.interner     = nil;
    m.srcmap       = nil;
    m.functions    = ?funcs[0];
    m.function_len = 2;
    m.function_cap = 2;

    var abi_vt: abi.AbiVTable = abi.abi_vtable(
        0, "", 0,
nil, nil,
        nil, nil,
        16, 0, 0,
        -1, false,
        false, false,
        0, 8,
        nil
    );

    var machine: isa.RegMachine = t_frame_machine();

    var tgt: target.Target;
    tgt.abi                = ?abi_vt;
    tgt.model.frame_ptr_reg = TEST_FP::i32;
    tgt.model.stack_ptr_reg = TEST_SP::i32;

    val undeclared: R.Result[R.Void, str] = run(?tgt, ?m);
    if (!R.is_err[R.Void, str](undeclared)) { ret 1; }

    tgt.arch = ?machine;
    val r: R.Result[R.Void, str] = run(?tgt, ?m);
    if (R.is_err[R.Void, str](r)) { ret 1; }

    if (!funcs[0].frame.omit) { ret 1; }
    if (funcs[1].frame.omit)  { ret 1; }
    if (funcs[0].frame.base_dist != 96) { ret 1; }
    if (funcs[0].frame.fp_dist   != 32) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.frame.check_frame_fits:boundary_is_exact" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var m: mir.MirModule;
    m.alloc        = ?alloc;
    m.interner     = ?i;
    m.srcmap       = nil;
    m.functions    = nil;
    m.function_len = 0;
    m.function_cap = 0;

    val nr: R.Result[intern.StrId, str] = intern.intern(?i, "fat");
    if (R.is_err[intern.StrId, str](nr)) { ret 1; }

    var f: mir.MirFunction;
    f.name = R.unwrap_ok[intern.StrId, str](nr);

    var bad: i32 = 0;

    f.frame.size = 1048575;
    if (R.is_err[R.Void, str](check_frame_fits(?m, ?f, 1048576)) && bad == 0) { bad = 2; }

    f.frame.size = 1048576;
    if (R.is_ok[R.Void, str](check_frame_fits(?m, ?f, 1048576)) && bad == 0) { bad = 3; }

    f.frame.size = 1107824;
    val over: R.Result[R.Void, str] = check_frame_fits(?m, ?f, 1048576);
    if (R.is_ok[R.Void, str](over)) { bad = 4; }
    or {
        val msg: str = R.unwrap_err[R.Void, str](over);
        if (!str_contains(msg, "fat")     && bad == 0) { bad = 5; }
        if (!str_contains(msg, "1107824") && bad == 0) { bad = 6; }
        if (!str_contains(msg, "1048576") && bad == 0) { bad = 7; }
    }

    f.frame.size = 999999999;
    if (R.is_err[R.Void, str](check_frame_fits(?m, ?f, 0)) && bad == 0) { bad = 8; }

    ret bad;
}

test "mach.lang.be.codegen.frame.effective_stack_reserve:stated_beats_default" {
    var pe: of.OfVTable;
    pe.carries_stack_size    = true;
    pe.default_stack_reserve = 0x100000;

    var elf_vt: of.OfVTable;
    elf_vt.carries_stack_size    = false;
    elf_vt.default_stack_reserve = 0;

    var bad: i32 = 0;
    if (of.effective_stack_reserve(?pe, 0x800000) != 0x800000)   { bad = 1; }
    if (of.effective_stack_reserve(?pe, 0) != 0x100000          && bad == 0) { bad = 2; }
    if (of.effective_stack_reserve(?elf_vt, 0) != 0             && bad == 0) { bad = 3; }
    if (of.effective_stack_reserve(?elf_vt, 0x800000) != 0x800000 && bad == 0) { bad = 4; }
    ret bad;
}

test "mach.lang.be.codegen.frame.layout_function:refuses_a_frame_size_past_the_u32_limit" {
    var instrs: [1]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_MOV);

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 1);

    var slots: [1]mir.MirSlot;
    slots[0].value  = 0;
    slots[0].kind   = mir.SLOT_ALLOCA;
    slots[0].offset = 0;
    slots[0].size   = 0xFFFFFFFF;
    slots[0].align  = 1;

    func.frame.slots      = ?slots[0];
    func.frame.slot_count = 1;
    func.frame.slot_cap   = 1;

    val r: R.Result[R.Void, str] = layout_function(?func, 16);
    if (!R.is_err[R.Void, str](r)) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.frame.layout_function:refuses_an_outgoing_area_past_the_u32_limit" {
    var instrs: [1]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_MOV);

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 1);

    func.frame.outgoing_size = 0xFFFFFFFF;

    val r: R.Result[R.Void, str] = layout_function(?func, 16);
    if (!R.is_err[R.Void, str](r)) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.frame.layout_function:ordinary_frame_still_succeeds" {
    var instrs: [1]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_MOV);

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 1);

    var slots: [1]mir.MirSlot;
    slots[0].value  = 0;
    slots[0].kind   = mir.SLOT_ALLOCA;
    slots[0].offset = 0;
    slots[0].size   = 32;
    slots[0].align  = 16;

    func.frame.slots      = ?slots[0];
    func.frame.slot_count = 1;
    func.frame.slot_cap   = 1;
    func.frame.outgoing_size = 24;

    val r: R.Result[R.Void, str] = layout_function(?func, 16);
    if (R.is_err[R.Void, str](r))         { ret 1; }
    if (func.frame.size != 32)          { ret 2; }
    if (func.frame.outgoing_size != 32) { ret 3; }
    ret 0;
}
