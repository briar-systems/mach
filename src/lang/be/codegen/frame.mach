# assign each MIR frame slot an offset from the slot region's base, size the frame,
# and decide whether the function needs a frame at all - and what base it gets
#
# Assigns each MIR frame slot a negative offset from the slot region's base, sizes
# the frame to the ABI stack alignment, and rounds the outgoing-argument region
# to the call-boundary alignment. The slots themselves - allocas plus the
# small-aggregate param, aggregate-load, and aggregate-return spill slots - are
# materialized into `mir.MirFrame` during instruction selection; this pass only
# computes their final offsets and the total frame size.
#
# WHAT THE BASE IS, AND WHAT IT IS ALIGNED TO. Normally the base is the frame pointer,
# and the only alignment that reaches the frame pointer is the ABI's 16-byte call
# boundary - so a slot offset being a multiple of 32 said nothing about the address
# until #2735. `MirFrame.realign` records, per function, the largest slot alignment
# above the ABI's; a function that has one gets a prologue that masks the STACK pointer
# down to it and addresses its slot region from there instead. The frame pointer keeps
# the caller's business - incoming stack arguments and the frame record - because after
# a mask only one of the two pointers is still a fixed distance from the caller's stack.
#
# It also records, in `MirFrame.omit`, whether the function needs a compiler-
# generated prologue and epilogue at all (#1940). Both are single decision
# points across every target: each encoder reads the field instead of re-deriving
# the answer from its own copy of the rule.
#
# Target-agnostic but for three reads through the target - the ABI stack
# alignment, and the frame- and stack-pointer register ids the frame-reference
# scan recognizes. The resulting offsets are consumed by the encoder when it
# forms `[rbp + disp]` (or, in a realigned frame, `[rsp + disp]`) memory operands.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use O: std.types.option;
use R: std.types.result;

use mach.lang.be.codegen.mir;
use mach.lang.intern;
use mach.lang.target.abi;
use target: mach.lang.target.resolved;

# frame alignment used when no ABI override applies; the 16-byte call-boundary minimum
pub val DEFAULT_STACK_ALIGN: u32 = 16;

# compute stack-frame offsets and size for every function in a MIR module
# ---
# tgt: resolved target; the ABI vtable supplies the stack alignment
# m:   MIR module whose functions are laid out in place
# ret: true on success, or an error string on a malformed frame
pub fun run(tgt: *target.Target, m: *mir.MirModule) R.Result[bool, str] {
    if (m == nil) { ret R.err[bool, str]("frame.run: nil mir module"); }
    if (tgt == nil || tgt.abi == nil) {
        ret R.err[bool, str]("frame.run: target has no ABI");
    }

    val align: u32 = stack_align(tgt);

    var fi: u32 = 0;
    for (fi < m.function_len) {
        val func: *mir.MirFunction = ?m.functions[fi];
        layout_function(func, align);
        # the frame facts are final only now, so the omission decision follows the
        # layout rather than racing it.
        func.frame.omit = omits_frame(func, tgt.model.frame_ptr_reg::u32,
                                      tgt.model.stack_ptr_reg::u32);
        fi = fi + 1;
    }

    ret R.ok[bool, str](true);
}

# report whether a function needs no compiler-generated prologue or epilogue
#
# Two disjoint reasons suppress the frame.
#
#   1. `#[naked]` (#2198). The author declared that this function's prologue,
#      epilogue, stack alignment, link register and return are theirs. Nothing is
#      derived and nothing is checked here - a declaration is not a proof
#      obligation. Sema restricts a naked body to inline `asm`, so the compiler
#      allocates nothing under it and the shapes the guards below reject cannot
#      arise anyway.
#
#   2. The frame is provably unused (#1940). A function that allocated no frame of
#      its own - no slots (`frame.size`), no callee-saved GP or vector registers,
#      no outgoing-argument region - and that calls nothing and addresses nothing
#      through the frame or stack pointer cannot observe the difference between
#      having a frame record and not having one, so the `push rbp; mov rbp, rsp` /
#      `mov rsp, rbp; pop rbp` pair is pure cost.
#
# The leaf requirement in reason 2 is load-bearing rather than conservative, and
# for a different reason on each ISA. On x86-64 entry RSP is 8 mod 16 and the
# frame-pointer push is what restores the 16-byte call boundary the ABI demands,
# so a frameless function that made a call would hand its callee a stack SysV
# forbids. On aarch64 and riscv64 `bl` / `jalr` write the link register instead of
# pushing, so alignment survives - but the prologue is also the only thing that
# saves that register, and a frameless function that made a call would have its
# own return address overwritten by the call and `ret` back into itself, forever.
# Making no call, a function reaches neither failure.
#
# An inline-asm body used to be a third reason, standing on its own and tolerating
# a call (#2283). It does not: the two failures above are exactly what
# `std.system.os.linux.shared.terminate` was compiled into on `dev`, and it
# survived only because `exit_group` never returns. A function that merely
# CONTAINS asm is not asking to own its frame; one that says `#[naked]` is. An
# asm-only leaf still omits its frame, now through reason 2 - an asm payload
# contributes no MIR operand, so such a function satisfies the scan on its own.
#
# The frame-reference scan is what excludes an incoming stack parameter: those
# are lowered to `[fp + incoming_arg_base + off]` (`mir.abi.emit_param_slot`) and
# stay addressable only while the frame pointer is live.
#
# Nothing here can read the debug flag, and `-g` adds no MIR instruction and no
# frame slot (its bindings ride on existing instructions as metadata), so the
# decision is identical with and without `-g` and `.text` stays byte-identical -
# the #1944 additivity invariant.
# ---
# func: the laid-out function to judge
# fp:   the target's frame-pointer register id
# sp:   the target's stack-pointer register id
# ret:  true when the encoder must emit neither prologue nor epilogue
pub fun omits_frame(func: *mir.MirFunction, fp: u32, sp: u32) bool {
    if (func.naked) { ret true; }

    if (func.frame.size != 0)          { ret false; }
    if (func.callee_mask != 0)         { ret false; }
    if (func.callee_mask_fp != 0)      { ret false; }
    if (func.frame.outgoing_size != 0) { ret false; }

    var calls: bool = false;
    var frame_ref: bool = false;

    var bi: u32 = 0;
    for (bi < func.block_count) {
        val blk: *mir.MirBlock = ?func.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mi.opcode == mir.MIR_CALL) { calls = true; }
            var oi: u32 = 0;
            for (oi < mi.operand_count) {
                if (operand_is_frame_relative(?mi.operands[oi], fp, sp)) { frame_ref = true; }
                oi = oi + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    ret !calls && !frame_ref;
}

# report whether a MIR operand addresses memory through the frame or stack pointer
#
# A frame-slot memory operand carries a slot key in `vreg` and is resolved against
# the layout, so it is not the shape this looks for; the physical-register base
# form (`mir.op_mem_preg`) is. Both register fields count - a base and, when the
# index is a physical register, the index - since either keeps the pointer live.
# ---
# o:   the operand to test
# fp:  the target's frame-pointer register id
# sp:  the target's stack-pointer register id
# ret: true when the operand reads or writes relative to fp or sp
fun operand_is_frame_relative(o: *mir.MirOperand, fp: u32, sp: u32) bool {
    if (o.kind != mir.MIR_OP_MEM) { ret false; }
    if (o.vreg == mir.MIR_VREG_NIL && (o.preg == fp || o.preg == sp)) { ret true; }
    if (o.index_is_preg && (o.index == fp || o.index == sp))          { ret true; }
    ret false;
}

# look up the frame-pointer offset assigned to a MIR value's slot
#
# The frame phase lays slots out relative to a frame pointer that sits immediately
# above the locals; a target whose prologue reserves space between the two must
# subtract that reservation or the offsets alias what the prologue saved. That
# reservation is `MirFrame.fp_dist`, stamped once by the target's own encoder, so it
# is read here rather than passed in - a caller-supplied bias is a second derivation,
# and a reader that forgot to apply it is #2759. x86-64 and aarch64 stamp 0; riscv64
# pins `s0` at the frame top and stamps its ra/s0-plus-callee-saved reservation.
# An inline-asm `{name}` is addressed from the STACK pointer instead
# (`isa.asm.SlotFn`), which is `slot_sp_offset` and reads `base_dist`, the twin.
#
# measured over an identical corpus, one record per lookup (#2291): the reservation
# is 0 on every one of 12 969 x86-64 and 7 291 aarch64 lookups, and nonzero on all
# 3 865 riscv64 ones, ranging 16..200 bytes. it is not an occasional correction.
# ---
# frame: the laid-out frame to search, with `fp_dist` already stamped
# v:     the MIR value id whose slot offset is requested
# ret:   the offset, or none if `v` owns no frame slot
pub fun slot_offset(frame: *mir.MirFrame, v: u32) O.Option[i64] {
    val opt_slot: O.Option[*mir.MirSlot] = slot_find(frame, v);
    if (!O.is_some[*mir.MirSlot](opt_slot)) { ret O.none[i64](); }
    ret O.some[i64](O.unwrap[*mir.MirSlot](opt_slot).offset - frame.fp_dist::i64);
}

# look up the STACK-pointer displacement of a MIR value's slot
#
# The twin of `slot_offset` on the other base. A slot offset is measured from the slot
# region's base and is negative; `MirFrame.base_dist` is how far that base sits above
# the stack pointer, so their sum is the positive displacement from it. There is no
# per-target bias here because `base_dist` already is the per-target part - which is the
# point of stamping it: the two targets that address an inline-asm `{name}` from the
# stack pointer each carried their own copy of this sum (#2689), and a realigned frame
# needs the same number for every access, not just an asm-bound one.
#
# The stack pointer is fixed from prologue to epilogue - a variable-length alloca is
# refused at lowering, the outgoing-argument region is preallocated, and an asm body that
# writes it is refused whenever it binds a `{name}` - so this displacement is as constant
# as the frame-pointer one.
# ---
# frame: the laid-out frame to search, with `base_dist` already stamped
# v:     the MIR value id whose slot displacement is requested
# ret:   the displacement, or none if `v` owns no frame slot
pub fun slot_sp_offset(frame: *mir.MirFrame, v: u32) O.Option[i64] {
    val opt_slot: O.Option[*mir.MirSlot] = slot_find(frame, v);
    if (!O.is_some[*mir.MirSlot](opt_slot)) { ret O.none[i64](); }
    ret O.some[i64](frame.base_dist::i64 + O.unwrap[*mir.MirSlot](opt_slot).offset);
}

# report whether the slot region is addressed from the stack pointer rather than the
# frame pointer
#
# True exactly when the frame was realigned. Realigning masks the stack pointer down to
# a boundary the caller did not promise, which makes the distance between the two
# pointers a run-time quantity: after it, only one of them can still be a statically
# known distance from the caller's stack. It has to be the frame pointer, because
# incoming stack arguments and the frame record are addressed from it and both belong
# to the caller. So the slot region moves to the stack pointer, which is the register
# that was masked and therefore the one that carries the alignment.
# ---
# frame: the laid-out frame
# ret:   true when slots, spills and the callee-save area are stack-pointer relative
pub fun slots_from_sp(frame: *mir.MirFrame) bool {
    ret frame.realign != 0;
}

# report whether a MIR value owns a frame slot
# ---
# frame: the laid-out frame to search
# v:     the MIR value id to test
# ret:   true if `v` has an assigned stack slot
pub fun is_slot(frame: *mir.MirFrame, v: u32) bool {
    ret O.is_some[*mir.MirSlot](slot_find(frame, v));
}

# report whether a MIR value's slot is an addressed alloca rather than an aggregate spill
# ---
# frame: the laid-out frame to search
# v:     the MIR value id to test
# ret:   true if `v`'s slot is an alloca; false if it is an aggregate spill or
#        `v` owns no slot
pub fun is_alloca_slot(frame: *mir.MirFrame, v: u32) bool {
    val opt_slot: O.Option[*mir.MirSlot] = slot_find(frame, v);
    if (!O.is_some[*mir.MirSlot](opt_slot)) { ret false; }
    ret O.unwrap[*mir.MirSlot](opt_slot).kind == mir.SLOT_ALLOCA;
}

# read the ABI stack alignment
#
# The caller (`run`) has already verified the target and its ABI are present; an
# ABI that left `stack_align` unset (0) takes the 16-byte call-boundary default.
# ---
# tgt: resolved target with a non-nil ABI (guaranteed by `run`)
# ret: the stack alignment in bytes
fun stack_align(tgt: *target.Target) u32 {
    if (tgt.abi.stack_align == 0) { ret DEFAULT_STACK_ALIGN; }
    ret tgt.abi.stack_align;
}

# lay out one function's frame: assign each slot an offset from the slot region's
# base, size the frame, and round the outgoing-argument region to the stack alignment
#
# The frame grows downward from the slot region's base:
#
#   [base - ..]                   locals, spills, two-register-param copies (the slots)
#   ---- the slot region, rounded up to `align`, is `frame.size` ----
#   [base - (frame.size + 8) ..]  callee-saved registers (reserved by the encoder)
#   [rsp .. rsp + outgoing_size)  outgoing call-argument region (lowest)
#
# The encoder reserves the callee-save and outgoing regions below `frame.size`
# when it subtracts RSP, placing the outgoing region at the very bottom so a
# caller's `[rsp + off]` store lands in it. Rounding `outgoing_size` up to the
# stack alignment keeps the encoder's RSP subtraction 16-byte aligned at every
# call site: `frame.size` plus the callee region is aligned on its own, and a
# 16-aligned outgoing region added below preserves the call-boundary invariant.
#
# WHAT THE SLOT OFFSETS ARE ALIGNED RELATIVE TO. Each offset is a multiple of its own
# slot's alignment, which is a statement about the BASE plus the offset only if the
# base carries that alignment too. The base is normally the frame pointer, and the only
# alignment that reaches the frame pointer is the ABI's call-boundary minimum - 16 on
# every target here. So a slot asking for more than 16 got an offset that was a correct
# multiple of nothing (#2735): the address was a multiple of 32 exactly when the process
# stack happened to start on one, which varies with the environment block and therefore
# from run to run of the same binary.
#
# `frame.realign` is what closes that. When some slot needs more than the ABI gives, the
# largest such alignment is recorded there and the function's prologue masks the STACK
# pointer down to it, making `sp + <the target's slot-base distance>` the base every
# offset is measured from. The stack pointer is the one that can move: it is provably
# fixed from prologue to epilogue (a variable-length alloca is refused at lowering, an
# asm body that writes it is refused whenever it binds a `{name}`), whereas the frame
# pointer must stay where the ABI put it because incoming stack arguments and the frame
# record are addressed from it. Only one of the two can sit a statically known distance
# from the caller's stack once a mask has been applied, and it has to be the frame
# pointer.
#
# The DECISION lives here and only here. Each encoder reads `frame.realign` and applies
# it; none re-derives it from the slots, which would be a second copy of a layout policy
# agreeing with this one by accident - the shape #2715 and #2725 both came from.
# ---
# func:  function to lay out; its `frame` is filled in place
# align: stack alignment to round the frame size up to
fun layout_function(func: *mir.MirFunction, align: u32) {
    val frame: *mir.MirFrame = ?func.frame;
    frame.align = align;
    frame.realign = over_alignment(frame, align);

    var offset: i64 = 0;

    # INLINE-ASM `{name}` SLOTS ARE PLACED LAST, at the BOTTOM of the slot region,
    # which is the end nearest the stack pointer.
    #
    # Every other slot is reached by a COMPILER-emitted load or store, which each
    # target legalizes when the offset outgrows its immediate form - materializing the
    # address through a register the back end reserves. A `{name}` slot is reached by
    # an AUTHOR-written one, and there is no register the compiler may borrow inside
    # someone else's asm body: aarch64 taking IP0 for exactly that was a silent
    # miscompile (#2667), and riscv64 refuses rather than take t0.
    #
    # So the one slot kind that cannot be legalized is the one placed where it never
    # needs to be - ADJACENT TO THE REGISTER IT IS ADDRESSED FROM. On the two targets
    # whose immediate range is a real constraint that register is the stack pointer
    # (`isa.asm.SlotFn`), because a slot sits below the frame pointer and an fp-relative
    # displacement is therefore negative, which aarch64's unsigned scaled form cannot
    # encode at all. Measured from the stack pointer the displacement is positive, and
    # the bottom of the slot region is the near end. x86-64 reaches either end of any
    # frame with a disp32 and is indifferent to where this puts it.
    #
    # What is left between a `{name}` slot and the stack pointer is the callee-save and
    # outgoing-argument areas, both bounded by the ABI rather than by the function. That
    # is the difference that matters: ordering the slots by the constraint made the reach
    # a function of the frame's SIZE (#2674), and this makes it independent of it. A
    # caller that inlines a syscall wrapper into a large frame is exactly the case that
    # broke (#2689), and inlining is precisely what grows a frame under someone else's
    # `{name}` (#2231).
    #
    # `{name}` slots are few - a handful per asm statement - and every other slot is
    # indifferent to where it lands, so nothing is traded away.
    var si: u32 = 0;
    for (si < frame.slot_count) {
        if (!slot_is_asm_bound(func, frame.slots[si].value)) {
            offset = place_slot(?frame.slots[si], offset);
        }
        si = si + 1;
    }
    si = 0;
    for (si < frame.slot_count) {
        if (slot_is_asm_bound(func, frame.slots[si].value)) {
            offset = place_slot(?frame.slots[si], offset);
        }
        si = si + 1;
    }

    var size: usize = 0;
    if (offset < 0) {
        val align_mask: usize = align::usize - 1;
        size = ((-offset)::usize + align_mask) & ~align_mask;
    }
    frame.size = size::u32;

    if (frame.outgoing_size > 0) {
        val align_mask: u32 = align - 1;
        frame.outgoing_size = (frame.outgoing_size + align_mask) & ~align_mask;
    }
}

# the alignment the slot region's base must be given, or 0 when `align` already covers
# every slot
#
# The largest slot alignment in the function, reported only when it exceeds what the ABI
# guarantees the frame pointer. Read as a whole rather than per slot: the base is one
# address, so the strongest request in the frame is what it has to satisfy, and every
# weaker one is satisfied by the same mask because alignments are powers of two.
#
# A spill slot asks with the same voice as a declared local. That is deliberate and is
# the member this is designed against: an over-width vector spilled to the stack (#2727)
# wants a 32-byte base for a machine reason, and it never appears in source at all.
# ---
# frame: the frame whose slots have been recorded (offsets need not be assigned yet)
# align: the ABI stack alignment the frame pointer already carries
# ret:   the required base alignment, or 0 when none exceeds `align`
fun over_alignment(frame: *mir.MirFrame, align: u32) u32 {
    if (frame.slots == nil) { ret 0; }
    var most: u32 = align;
    var i: u32 = 0;
    for (i < frame.slot_count) {
        if (frame.slots[i].align > most) { most = frame.slots[i].align; }
        i = i + 1;
    }
    if (most <= align) { ret 0; }
    ret most;
}

# assign `slot` the next address below `offset`, returning the new watermark
#
# The layout step itself, split out so the two ordering passes above run one
# implementation rather than two copies that could round differently.
#
# THE ROUNDING HERE IS DOWNWARD, AND DOWNWARD IS NOT THE UPWARD RULE WITH A SIGN
# FLIPPED. This walk descends: `offset` is the watermark, the lowest address already
# spoken for, and the slot must end at or below it. Its base is therefore `offset -
# size` at the highest, and rounding that base DOWN to a multiple of the alignment is
# `base & ~mask` on its own. Two's complement `&` clears low bits, which moves a
# negative number away from zero, which is downward - so a base that is already
# aligned is already the answer and nothing is subtracted from it.
#
# The upward rule `(x + mask) & ~mask` adds a full alignment unit's worth of slack
# FIRST because clearing the low bits would otherwise move an ascending cursor
# BACKWARD, into the previous allocation. Descending, clearing the low bits already
# moves away from the previous allocation, so the slack has nothing to correct.
# Carrying it over sign-flipped as `(base - mask) & ~mask` (#2725) subtracts a whole
# alignment unit from every slot whose base is already aligned, which is most of
# them: an 8-byte 8-aligned local occupied 16 bytes, and every frame on every target
# was up to twice the size it needed to be. It was invisible to correctness - nothing
# overlapped and every offset stayed aligned - so only a measurement finds it.
#
# The two properties this must hold are `next + size <= offset` (no overlap with what
# is above) and `next % align == 0`. Rounding down satisfies both: `base <= offset -
# size` before rounding and rounding only lowers it, and the mask is what makes it
# aligned.
fun place_slot(slot: *mir.MirSlot, offset: i64) i64 {
    var slot_align: i64 = 1;
    if (slot.align > 0) { slot_align = slot.align::i64; }

    var next: i64 = offset - slot.size::i64;
    if (slot_align > 1) {
        val mask: i64 = slot_align - 1;
        next = next & ~mask;
    }

    slot.offset = next;
    ret next;
}

# true when any inline-asm body in `func` binds `{name}` to the slot vreg `v`
#
# Read off the MIR_ASM payloads rather than tracked on the slot, because the binding
# is a property of the asm statement and the slot is shared machinery: a flag on
# `MirSlot` would be a second place for the same fact to be recorded, and the one
# that could go stale. The scan is over instructions carrying an asm payload only,
# which is zero for almost every function.
fun slot_is_asm_bound(func: *mir.MirFunction, v: u32) bool {
    var bi: u32 = 0;
    for (bi < func.block_count) {
        val blk: *mir.MirBlock = ?func.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mi.opcode == mir.MIR_ASM && mi.asm_block != nil) {
                var k: u32 = 0;
                for (k < mi.asm_block.bind_count) {
                    if (mi.asm_block.binds[k].slot_vreg == v) { ret true; }
                    k = k + 1;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

# find the slot owned by a MIR value id
# ---
# frame: the laid-out frame to search
# v:     the MIR value id to look up
# ret:   a pointer to `v`'s slot, or none if `v` owns no frame slot
fun slot_find(frame: *mir.MirFrame, v: u32) O.Option[*mir.MirSlot] {
    if (frame == nil)       { ret O.none[*mir.MirSlot](); }
    if (frame.slots == nil) { ret O.none[*mir.MirSlot](); }

    var i: u32 = 0;
    for (i < frame.slot_count) {
        if (frame.slots[i].value == v) {
            ret O.some[*mir.MirSlot](?frame.slots[i]);
        }
        i = i + 1;
    }
    ret O.none[*mir.MirSlot]();
}

# slot_offset, is_slot, and is_alloca_slot distinguish an alloca slot from a
# spill slot and report a missing value id as owning no slot
test "mach.lang.be.codegen.frame.slot_offset:alloca_and_spill_lookup" {
    # build two manual slots without an allocator: offsets are set directly, so
    # no `run` pass is needed.
    var slots: [2]mir.MirSlot;
    slots[0].value  = 10;
    slots[0].kind   = mir.SLOT_ALLOCA;
    slots[0].offset = -16;
    slots[0].size   = 16;
    slots[0].align  = 16;

    slots[1].value  = 20;
    slots[1].kind   = mir.SLOT_SPILL;
    slots[1].offset = -24;
    slots[1].size   = 8;
    slots[1].align  = 8;

    var frame: mir.MirFrame;
    frame.slots         = ?slots[0];
    frame.slot_count    = 2;
    frame.slot_cap      = 2;
    frame.size          = 0;
    frame.align         = 0;
    frame.outgoing_size = 0;
    frame.realign       = 0;
    frame.base_dist     = 0;
    frame.fp_dist       = 0;

    val opt_off10: O.Option[i64] = slot_offset(?frame, 10);
    if (!O.is_some[i64](opt_off10))      { ret 1; }
    if (O.unwrap[i64](opt_off10) != -16) { ret 1; }

    val opt_off20: O.Option[i64] = slot_offset(?frame, 20);
    if (!O.is_some[i64](opt_off20))      { ret 1; }
    if (O.unwrap[i64](opt_off20) != -24) { ret 1; }

    val opt_off99: O.Option[i64] = slot_offset(?frame, 99);
    if (O.is_some[i64](opt_off99))       { ret 1; }

    # a target that reserves space between the frame pointer and the slot region stamps
    # it as `fp_dist`, and every offset this returns is measured past it. reading the raw
    # slot offset instead is right only where the reservation is 0 (#2759).
    frame.fp_dist = 32;
    val biased10: O.Option[i64] = slot_offset(?frame, 10);
    if (!O.is_some[i64](biased10))      { ret 1; }
    if (O.unwrap[i64](biased10) != -48) { ret 1; }
    val biased20: O.Option[i64] = slot_offset(?frame, 20);
    if (!O.is_some[i64](biased20))      { ret 1; }
    if (O.unwrap[i64](biased20) != -56) { ret 1; }
    frame.fp_dist = 0;

    if (!is_alloca_slot(?frame, 10)) { ret 1; }
    if (is_alloca_slot(?frame, 20))  { ret 1; }
    if (!is_slot(?frame, 10))        { ret 1; }
    ret 0;
}

# an inline-asm `{name}` slot is laid out at the bottom of the slot region - the end
# nearest the stack pointer - whatever order it was recorded in (#2689)
#
# THE ONE SLOT KIND THAT CANNOT BE LEGALIZED IS THE ONE PLACED WHERE IT NEVER NEEDS TO
# BE. Every other slot is reached by a compiler-emitted access, which each target
# rewrites through a reserved register when the offset outgrows its immediate form. A
# `{name}` slot is reached by an author-written one, and there is no register the
# compiler may borrow inside someone else's asm body - aarch64 taking IP0 for exactly
# that was a silent miscompile (#2667), and riscv64 refuses rather than take t0.
#
# So it is placed adjacent to the register it is addressed from, which is the stack
# pointer (`isa.asm.SlotFn`). The invariant asserted is the ARCHITECTURAL one - the
# bound slot's distance from the bottom of the slot region is independent of how large
# the ordinary slots are - rather than an exact offset, which would only restate the
# rounding rule. That independence is the whole fix: laying the bound slot nearest the
# FRAME pointer instead (#2674) made its reach a function of the frame's size, and a
# caller inlining a syscall wrapper into a large frame exceeded it.
test "mach.lang.be.codegen.frame.layout_function:asm_bound_slots_are_nearest_the_stack_pointer" {
    var instrs: [1]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_ASM);

    # the asm statement binds `{name}` to vreg 7, which is recorded FIRST among the
    # slots: without the ordering it would land furthest from the stack pointer.
    var binds: [1]mir.MirAsmBind;
    binds[0] = mir.asm_bind(0::intern.StrId, 7, false);
    var payload: mir.MirAsm;
    payload.isa        = "x86_64";
    payload.body       = "nop";
    payload.binds      = ?binds[0];
    payload.bind_count = 1;
    instrs[0].asm_block = ?payload;

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 1);

    # the bound slot recorded first, then four ordinary slots each big enough that the
    # bound one would sit well past every immediate window if it were laid out in order.
    var slots: [5]mir.MirSlot;
    slots[0].value  = 7;
    slots[0].kind   = mir.SLOT_ALLOCA;
    slots[0].offset = 0;
    slots[0].size   = 8;
    slots[0].align  = 8;
    var i: u32 = 1;
    for (i < 5) {
        slots[i::usize].value  = i;
        slots[i::usize].kind   = mir.SLOT_ALLOCA;
        slots[i::usize].offset = 0;
        slots[i::usize].size   = 256;
        slots[i::usize].align  = 8;
        i = i + 1;
    }

    func.frame.slots      = ?slots[0];
    func.frame.slot_count = 5;
    func.frame.slot_cap   = 5;

    layout_function(?func, 16);

    # THE BOUND SLOT IS AT THE BOTTOM. Slot offsets are negative and grow downward, so
    # "nearest the stack pointer" is "most negative", and its distance from the frame's
    # low edge is its own size alone - not the 1024 bytes of ordinary locals above it.
    if (func.frame.size::i64 + slots[0].offset > 8) { ret 21; }

    # every ordinary slot is strictly above it, so nothing overlaps and the ordering
    # really put the bound one last.
    var j: usize = 1;
    for (j < 5) {
        if (slots[j].offset <= slots[0].offset) { ret 22; }
        j = j + 1;
    }
    # the frame still covers every slot: four 256-byte locals plus the bound 8.
    if (func.frame.size < 1032) { ret 23; }

    # a slot no asm body binds is ordinary, so the predicate is not answering true
    # for everything - which would place them all last and assert nothing.
    if (!slot_is_asm_bound(?func, 7)) { ret 24; }
    if (slot_is_asm_bound(?func, 1))  { ret 25; }
    if (slot_is_asm_bound(?func, 4))  { ret 26; }
    ret 0;
}

# a function with no inline asm lays out exactly as it did before, in slot order
#
# The no-regression half: the ordering must be invisible to every function that has no
# `{name}` to protect, which is almost all of them.
test "mach.lang.be.codegen.frame.layout_function:no_asm_keeps_slot_order" {
    var instrs: [1]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_MOV);

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 1);

    var slots: [3]mir.MirSlot;
    var i: usize = 0;
    for (i < 3) {
        slots[i].value  = i::u32;
        slots[i].kind   = mir.SLOT_ALLOCA;
        slots[i].offset = 0;
        slots[i].size   = 8;
        slots[i].align  = 8;
        i = i + 1;
    }

    func.frame.slots      = ?slots[0];
    func.frame.slot_count = 3;
    func.frame.slot_cap   = 3;

    layout_function(?func, 16);

    # descending in declaration order, each below the last, with nothing reordered.
    if (slots[0].offset >= 0)                 { ret 11; }
    if (slots[1].offset >= slots[0].offset)   { ret 12; }
    if (slots[2].offset >= slots[1].offset)   { ret 13; }

    # EXACT offsets, not an ordering. three 8-byte 8-aligned slots pack into 24 bytes,
    # which the 16-byte stack alignment rounds to 32. an ordering assertion passes just
    # as happily on the 16-apart layout #2725 was, so it is the numbers that pin this.
    if (slots[0].offset != -8)                { ret 14; }
    if (slots[1].offset != -16)               { ret 15; }
    if (slots[2].offset != -24)               { ret 16; }
    if (func.frame.size != 32)                { ret 17; }
    ret 0;
}

# a slot is placed at the FIRST address below the watermark that satisfies its own
# alignment, and an already-aligned address satisfies it (#2725)
#
# The descending walk rounds down, so an aligned base is left where it is. Rounding a
# descending cursor with the ASCENDING idiom `(base - mask) & ~mask` drops a full
# alignment unit from every slot that needed no adjustment at all, which is most of
# them, and doubles the frame.
#
# The two properties asserted are the ones that actually constrain the rule -
# no overlap and each offset a multiple of its own alignment - plus the exact offsets,
# because both properties hold under the old rule too. A frame of uniform `i64` cannot
# tell a correct rule from several wrong ones either, so the alignments here run
# 1/2/4/8/16/32: a byte, a half, a word, a double, a vector, and an over-aligned
# record. The 1-aligned slot is what forces the following ones to actually round.
test "mach.lang.be.codegen.frame.place_slot:rounds_down_without_dropping_a_unit" {
    var instrs: [1]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_MOV);

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 1);

    var sizes:  [6]u32;
    var aligns: [6]u32;
    sizes[0] = 1;  aligns[0] = 1;
    sizes[1] = 2;  aligns[1] = 2;
    sizes[2] = 4;  aligns[2] = 4;
    sizes[3] = 8;  aligns[3] = 8;
    sizes[4] = 16; aligns[4] = 16;
    sizes[5] = 32; aligns[5] = 32;

    var slots: [6]mir.MirSlot;
    var i: usize = 0;
    for (i < 6) {
        slots[i].value  = i::u32;
        slots[i].kind   = mir.SLOT_ALLOCA;
        slots[i].offset = 0;
        slots[i].size   = sizes[i];
        slots[i].align  = aligns[i];
        i = i + 1;
    }

    func.frame.slots      = ?slots[0];
    func.frame.slot_count = 6;
    func.frame.slot_cap   = 6;

    layout_function(?func, 16);

    # derived by hand from the watermark, which starts at 0 and only descends:
    #   1@1  -> base -1,  already fine       -> -1
    #   2@2  -> base -3,  down to a multiple -> -4
    #   4@4  -> base -8,  already a multiple -> -8
    #   8@8  -> base -16, already a multiple -> -16
    #  16@16 -> base -32, already a multiple -> -32
    #  32@32 -> base -64, already a multiple -> -64
    # so 63 bytes of slot occupy 64, and the frame is 64. The old rule produced
    # -1/-4/-12/-32/-64/-128 and a 128-byte frame for the same six slots.
    if (slots[0].offset != -1)   { ret 31; }
    if (slots[1].offset != -4)   { ret 32; }
    if (slots[2].offset != -8)   { ret 33; }
    if (slots[3].offset != -16)  { ret 34; }
    if (slots[4].offset != -32)  { ret 35; }
    if (slots[5].offset != -64)  { ret 36; }
    if (func.frame.size != 64)   { ret 37; }

    # each offset is a multiple of its own alignment. an off-by-one in the other
    # direction - rounding UP instead of down - would still pack tightly and still
    # not overlap, and this is the half that catches it.
    var j: usize = 0;
    for (j < 6) {
        if ((slots[j].offset & (aligns[j]::i64 - 1)) != 0) { ret 38; }
        j = j + 1;
    }

    # no slot runs into the one above it, and every slot is inside the frame.
    var k: usize = 0;
    for (k < 6) {
        var n: usize = 0;
        for (n < 6) {
            if (n != k) {
                val a_lo: i64 = slots[k].offset;
                val a_hi: i64 = a_lo + slots[k].size::i64;
                val b_lo: i64 = slots[n].offset;
                val b_hi: i64 = b_lo + slots[n].size::i64;
                if (a_lo < b_hi && b_lo < a_hi) { ret 39; }
            }
            n = n + 1;
        }
        if (slots[k].offset + func.frame.size::i64 < 0) { ret 40; }
        if (slots[k].offset + slots[k].size::i64 > 0)   { ret 41; }
        k = k + 1;
    }
    ret 0;
}

# the realignment decision is the LARGEST slot alignment above the ABI's, recorded on
# the frame, and 0 when nothing asks for more (#2735)
#
# THE OFFSETS ALONE CANNOT SHOW THIS. Every offset here is a multiple of its own
# alignment with or without the decision - they were on the bug too. What the decision
# changes is the BASE those offsets are measured from, which is a fact about the
# prologue, so the assertion has to be on the recorded number rather than on the layout.
#
# The 128 is deliberately not the last slot recorded: taking the largest means taking it
# whatever order the slots arrive in, and a rule that read the final slot, or the first
# over-aligned one, would pass a frame ordered the convenient way.
test "mach.lang.be.codegen.frame.layout_function:records_the_largest_over_alignment" {
    var instrs: [1]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_MOV);

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 1);

    var aligns: [4]u32;
    aligns[0] = 8; aligns[1] = 128; aligns[2] = 32; aligns[3] = 8;

    var slots: [4]mir.MirSlot;
    var i: usize = 0;
    for (i < 4) {
        slots[i].value  = i::u32;
        slots[i].kind   = mir.SLOT_ALLOCA;
        slots[i].offset = 0;
        slots[i].size   = aligns[i];
        slots[i].align  = aligns[i];
        i = i + 1;
    }

    func.frame.slots      = ?slots[0];
    func.frame.slot_count = 4;
    func.frame.slot_cap   = 4;

    layout_function(?func, 16);
    if (func.frame.realign != 128) { ret 51; }
    if (!slots_from_sp(?func.frame)) { ret 52; }

    # a frame nothing over-aligns records 0 and stays frame-pointer based, so an ordinary
    # function emits the prologue it always did.
    var plain: [3]mir.MirSlot;
    var j: usize = 0;
    for (j < 3) {
        plain[j].value  = j::u32;
        plain[j].kind   = mir.SLOT_ALLOCA;
        plain[j].offset = 0;
        plain[j].size   = 16;
        plain[j].align  = 16;
        j = j + 1;
    }
    mk_func(?blk, ?func, ?instrs[0], 1);
    func.frame.slots      = ?plain[0];
    func.frame.slot_count = 3;
    func.frame.slot_cap   = 3;
    layout_function(?func, 16);
    if (func.frame.realign != 0)    { ret 53; }
    if (slots_from_sp(?func.frame)) { ret 54; }
    ret 0;
}

# a slot's stack-pointer displacement is its offset from the slot region's base plus the
# distance the encoder stamped between that base and the stack pointer
#
# The two halves have to be added by one function, because a caller that took the offset
# from here and the distance from its own arithmetic is the second copy the whole
# `base_dist` field exists to prevent - aarch64 and riscv64 each had one (#2689).
test "mach.lang.be.codegen.frame.slot_sp_offset:adds_the_stamped_base_distance" {
    var slots: [2]mir.MirSlot;
    slots[0].value  = 10;
    slots[0].kind   = mir.SLOT_ALLOCA;
    slots[0].offset = -32;
    slots[0].size   = 32;
    slots[0].align  = 32;

    slots[1].value  = 20;
    slots[1].kind   = mir.SLOT_SPILL;
    slots[1].offset = -40;
    slots[1].size   = 8;
    slots[1].align  = 8;

    var frame: mir.MirFrame;
    frame.slots         = ?slots[0];
    frame.slot_count    = 2;
    frame.slot_cap      = 2;
    frame.size          = 64;
    frame.align         = 16;
    frame.outgoing_size = 0;
    frame.realign       = 32;
    frame.base_dist     = 96;
    frame.omit          = false;

    val a: O.Option[i64] = slot_sp_offset(?frame, 10);
    if (!O.is_some[i64](a))     { ret 61; }
    if (O.unwrap[i64](a) != 64) { ret 62; }

    val b: O.Option[i64] = slot_sp_offset(?frame, 20);
    if (!O.is_some[i64](b))     { ret 63; }
    if (O.unwrap[i64](b) != 56) { ret 64; }

    # a value that owns no slot answers none rather than the base distance, which would
    # be a plausible-looking address into the frame.
    if (O.is_some[i64](slot_sp_offset(?frame, 99))) { ret 65; }
    ret 0;
}

# the frame-pointer and stack-pointer register ids the omission tests use. arbitrary
# distinct values: `omits_frame` compares operand register fields against whatever it
# is handed, so the numbering matters only in being distinguishable from a third id
# the tests use for an ordinary register.
val TEST_FP:    u32 = 5;
val TEST_SP:    u32 = 4;
val TEST_OTHER: u32 = 9;

# build a one-block function around `instrs`, with an otherwise empty frame
# ---
# blk:    caller-owned block storage
# func:   caller-owned function storage, filled in
# instrs: the block's instruction array
# n:      number of instructions
fun mk_func(blk: *mir.MirBlock, func: *mir.MirFunction, instrs: *mir.MirInstr, n: u32) {
    blk.id          = 0;
    blk.instrs      = instrs;
    blk.instr_count = n;
    blk.instr_cap   = n;
    blk.preds       = nil;
    blk.pred_count  = 0;
    blk.pred_cap    = 0;

    func.blocks      = blk;
    func.block_count = 1;
    func.block_cap   = 1;
    func.vregs       = nil;
    func.vreg_count  = 0;
    func.vreg_cap    = 0;

    func.frame.slots         = nil;
    func.frame.slot_count    = 0;
    func.frame.slot_cap      = 0;
    func.frame.size          = 0;
    func.frame.align         = 16;
    func.frame.outgoing_size = 0;
    func.frame.realign       = 0;
    func.frame.base_dist     = 0;
    func.frame.omit          = false;
    func.callee_mask         = 0;
    func.callee_mask_fp      = 0;
    func.naked               = false;
}

# fill `mi` as an instruction with no operands
# ---
# mi: the instruction to fill
# op: its opcode
fun mk_instr(mi: *mir.MirInstr, op: mir.MirOpcode) {
    mi.opcode            = op;
    mi.operands          = nil;
    mi.operand_count     = 0;
    mi.width             = 8;
    mi.src_width         = 8;
    mi.asm_block         = nil;
    mi.dbg_bindings      = nil;
    mi.dbg_binding_count = 0;
    mi.inline_site       = 0;
    mi.vec_lane          = 0;
}

# a leaf that allocates nothing and touches neither pointer omits its frame - the
# shape #1940 exists for. mutating `omits_frame` to answer false unconditionally
# fails here, and mutating it to answer true unconditionally fails every disqualifier
# test below
test "mach.lang.be.codegen.frame.omits_frame:bare_leaf_omits" {
    var instrs: [2]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_ADD);
    mk_instr(?instrs[1], mir.MIR_RET);

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 2);

    if (!omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }
    ret 0;
}

# each frame fact the compiler itself allocated keeps the frame: a slot, a callee-saved
# GP register, a callee-saved vector register, or an outgoing-argument region. deleting
# any one of the four guards in `omits_frame` fails this test
test "mach.lang.be.codegen.frame.omits_frame:allocated_frame_keeps_it" {
    var instrs: [1]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_RET);

    var blk: mir.MirBlock;
    var func: mir.MirFunction;

    mk_func(?blk, ?func, ?instrs[0], 1);
    func.frame.size = 16;
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    mk_func(?blk, ?func, ?instrs[0], 1);
    func.callee_mask = 1 << 3;
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    mk_func(?blk, ?func, ?instrs[0], 1);
    func.callee_mask_fp = 1 << 6;
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    mk_func(?blk, ?func, ?instrs[0], 1);
    func.frame.outgoing_size = 32;
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    ret 0;
}

# a call keeps the frame. entry RSP is 8 mod 16 and the frame-pointer push is what
# restores the 16-byte call boundary, so a frame-omitting function that called
# anything would hand its callee a misaligned stack. deleting the MIR_CALL scan fails
# here
test "mach.lang.be.codegen.frame.omits_frame:a_call_keeps_the_frame" {
    var instrs: [2]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_CALL);
    mk_instr(?instrs[1], mir.MIR_RET);

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 2);

    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }
    ret 0;
}

# a memory operand based on the frame or stack pointer keeps the frame: an incoming
# stack parameter is lowered to `[fp + incoming_arg_base + off]` and stays addressable
# only while the frame pointer is live. eliding such a function is a miscompile that
# still returns the right answer for a small enough argument list, so this is the
# guard worth mutating. an ordinary physical-register base, and a frame-slot base
# (which carries a slot key rather than a register), both stay elidable
test "mach.lang.be.codegen.frame.omits_frame:frame_relative_operand_keeps_the_frame" {
    var blk: mir.MirBlock;
    var func: mir.MirFunction;

    var fp_ops: [1]mir.MirOperand;
    fp_ops[0] = mir.op_mem_preg(TEST_FP, 16);
    var fp_instrs: [1]mir.MirInstr;
    mk_instr(?fp_instrs[0], mir.MIR_LOAD);
    fp_instrs[0].operands      = ?fp_ops[0];
    fp_instrs[0].operand_count = 1;
    mk_func(?blk, ?func, ?fp_instrs[0], 1);
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    var sp_ops: [1]mir.MirOperand;
    sp_ops[0] = mir.op_mem_preg(TEST_SP, 8);
    var sp_instrs: [1]mir.MirInstr;
    mk_instr(?sp_instrs[0], mir.MIR_STORE);
    sp_instrs[0].operands      = ?sp_ops[0];
    sp_instrs[0].operand_count = 1;
    mk_func(?blk, ?func, ?sp_instrs[0], 1);
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    var ix_ops: [1]mir.MirOperand;
    ix_ops[0] = mir.op_mem_preg(TEST_OTHER, 0);
    ix_ops[0].index         = TEST_FP;
    ix_ops[0].index_is_preg = true;
    var ix_instrs: [1]mir.MirInstr;
    mk_instr(?ix_instrs[0], mir.MIR_LOAD);
    ix_instrs[0].operands      = ?ix_ops[0];
    ix_instrs[0].operand_count = 1;
    mk_func(?blk, ?func, ?ix_instrs[0], 1);
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    var ok_ops: [1]mir.MirOperand;
    ok_ops[0] = mir.op_mem_preg(TEST_OTHER, 0);
    var ok_instrs: [1]mir.MirInstr;
    mk_instr(?ok_instrs[0], mir.MIR_LOAD);
    ok_instrs[0].operands      = ?ok_ops[0];
    ok_instrs[0].operand_count = 1;
    mk_func(?blk, ?func, ?ok_instrs[0], 1);
    if (!omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    ret 0;
}

# an inline-asm body carries no weight of its own (#2283). an asm-only leaf still
# omits its frame - through the leaf rule, since an asm payload contributes no MIR
# operand - but an asm body that also makes a call is framed like any other caller.
# restoring the old `if (mi.asm_block != nil) { ret true; }` arm fails the second
# half here, and it is a hang on aarch64 / riscv64 rather than a lost optimization:
# the call overwrites the link register the omitted prologue never saved
test "mach.lang.be.codegen.frame.omits_frame:asm_alone_omits_asm_with_a_call_does_not" {
    var payload: mir.MirAsm;

    var leaf: [2]mir.MirInstr;
    mk_instr(?leaf[0], mir.MIR_ASM);
    leaf[0].asm_block = ?payload;
    mk_instr(?leaf[1], mir.MIR_RET);

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?leaf[0], 2);
    if (!omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    var calling: [2]mir.MirInstr;
    mk_instr(?calling[0], mir.MIR_ASM);
    calling[0].asm_block = ?payload;
    mk_instr(?calling[1], mir.MIR_CALL);
    mk_func(?blk, ?func, ?calling[0], 2);
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    # an asm body still needs the frame the compiler allocated under it
    mk_func(?blk, ?func, ?leaf[0], 2);
    func.frame.size = 8;
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }

    ret 0;
}

# `#[naked]` omits the frame by declaration, so it answers true through every
# disqualifier the derived reason rejects: allocated slots, callee-saved registers,
# an outgoing-argument region, a call, and a frame-pointer-relative operand. deleting
# the `func.naked` arm fails this and leaves the decorator emitting a prologue the
# author forbade
test "mach.lang.be.codegen.frame.omits_frame:naked_omits_unconditionally" {
    var ops: [1]mir.MirOperand;
    ops[0] = mir.op_mem_preg(TEST_FP, 16);

    var instrs: [2]mir.MirInstr;
    mk_instr(?instrs[0], mir.MIR_CALL);
    mk_instr(?instrs[1], mir.MIR_LOAD);
    instrs[1].operands      = ?ops[0];
    instrs[1].operand_count = 1;

    var blk: mir.MirBlock;
    var func: mir.MirFunction;
    mk_func(?blk, ?func, ?instrs[0], 2);
    func.frame.size          = 32;
    func.callee_mask         = 1 << 3;
    func.callee_mask_fp      = 1 << 6;
    func.frame.outgoing_size = 16;

    # every guard above says "keep the frame" ...
    if (omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }
    # ... and the declaration overrides all of them.
    func.naked = true;
    if (!omits_frame(?func, TEST_FP, TEST_SP)) { ret 1; }
    ret 0;
}

# `run` writes the decision onto every function's frame, so the encoders read a fact
# rather than re-deriving it. reverting `run` to leave `omit` untouched fails here
test "mach.lang.be.codegen.frame.run:stamps_the_omission_decision" {
    var leaf_instrs: [1]mir.MirInstr;
    mk_instr(?leaf_instrs[0], mir.MIR_RET);

    var call_instrs: [1]mir.MirInstr;
    mk_instr(?call_instrs[0], mir.MIR_CALL);

    var blocks: [2]mir.MirBlock;
    var funcs: [2]mir.MirFunction;
    mk_func(?blocks[0], ?funcs[0], ?leaf_instrs[0], 1);
    mk_func(?blocks[1], ?funcs[1], ?call_instrs[0], 1);

    var m: mir.MirModule;
    m.alloc        = nil;
    m.interner     = nil;
    m.srcmap       = nil;
    m.functions    = ?funcs[0];
    m.function_len = 2;
    m.function_cap = 2;

    # only the field `run` reads is set to a real value, the ABI's stack alignment;
    # the rest are placeholders `abi.abi_vtable` requires but this test does not
    # exercise (the other read `run` makes is the frame- / stack-pointer register
    # ids on `tgt.model`, set below).
    var abi_vt: abi.AbiVTable = abi.abi_vtable(
        0, "", 0,
        nil, nil, nil,
        nil, nil,
        16, 0, 0,
        -1, false,
        false, false,
        0, 8,
        nil
    );

    var tgt: target.Target;
    tgt.abi                = ?abi_vt;
    tgt.model.frame_ptr_reg = TEST_FP::i32;
    tgt.model.stack_ptr_reg = TEST_SP::i32;

    val r: R.Result[bool, str] = run(?tgt, ?m);
    if (R.is_err[bool, str](r)) { ret 1; }

    if (!funcs[0].frame.omit) { ret 1; }
    if (funcs[1].frame.omit)  { ret 1; }
    ret 0;
}
