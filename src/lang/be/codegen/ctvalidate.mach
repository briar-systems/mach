    var vregs: [2]codegen_mir.MirVReg;
    vregs[0] = t_vreg(0, false);
    vregs[1] = t_vreg(1, false);

    var ops: [2]codegen_mir.MirOperand;
    ops[0]      = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    ops[1]      = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    ops[1].kind = 200::codegen_mir.MirOperandKind;
    var ins: [2]codegen_mir.MirInstr;
    ins[0] = t_instr(codegen_mir.MIR_MOV, ?ops[0], 2);
    ins[1] = t_instr(codegen_mir.MIR_RET, nil, 0);
    var blocks: [1]codegen_mir.MirBlock;
    blocks[0] = t_block(0, ?ins[0], 2);
    var f: codegen_mir.MirFunction = t_fn(true, ?blocks[0], 1, ?vregs[0], 2);
    val r: err[fail.Fail]          = t_validate_function(?t, ?f, ?alloc);
    if (!sel r.err)                                                                 { ret 1; }
    if (!str_contains(fail.describe(r.err), "outside the machine-operand catalog")) { ret 1; }

    ops[1].kind = codegen_mir.MIR_OP_VREG;
    var pf:                  codegen_mir.MirFunction = t_fn(true, ?blocks[0], 1, ?vregs[0], 2);
    val validate_function_r: err[fail.Fail]          = t_validate_function(?t, ?pf, ?alloc);
    if (!sel validate_function_r.ok) { ret 1; }
    ret 0;
}
