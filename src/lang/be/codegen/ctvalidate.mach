    vregs[2] = t_vreg(2, false);
    var add: [3]codegen_mir.MirOperand;
    add[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    add[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    add[2] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    var b0i: [2]codegen_mir.MirInstr;
    b0i[0] = t_instr(codegen_mir.MIR_ADD, ?add[0], 3);
    b0i[1] = t_instr(codegen_mir.MIR_RET, nil, 0);
    var blocks: [1]codegen_mir.MirBlock;
    blocks[0] = t_block(0, ?b0i[0], 2);

    var funcs_on: [1]codegen_mir.MirFunction;
    funcs_on[0] = t_fn(true, ?blocks[0], 1, ?vregs[0], 3);
