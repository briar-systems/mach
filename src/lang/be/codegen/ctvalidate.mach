    vregs[3] = t_vreg(3, false);

    var add: [3]codegen_mir.MirOperand;
    add[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(3));
    add[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    add[2] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
