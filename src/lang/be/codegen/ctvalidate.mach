test clean__valid_oblivious_no_false_positive {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    var t: resolved.Target = t_target(false, true);

    var vregs: [4]codegen_mir.MirVReg;
    vregs[0] = t_vreg(0, true);
    vregs[1] = t_vreg(1, false);
    vregs[2] = t_vreg(2, false);
    vregs[3] = t_vreg(3, false);

    var mov: [2]codegen_mir.MirOperand;
    mov[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    mov[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    var st: [2]codegen_mir.MirOperand;
    st[0] = codegen_mir.op_mem_value(codegen_mir.vreg_id(1), 0);
    st[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    var shl: [3]codegen_mir.MirOperand;
    shl[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(3));
    shl[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    shl[2] = codegen_mir.op_imm(5);
    var b0i: [4]codegen_mir.MirInstr;
    b0i[0] = t_instr(codegen_mir.MIR_MOV, ?mov[0], 2);
    b0i[1] = t_instr(codegen_mir.MIR_STORE, ?st[0], 2);
    b0i[2] = t_instr(codegen_mir.MIR_SHL, ?shl[0], 3);
    b0i[3] = t_instr(codegen_mir.MIR_RET, nil, 0);
    var blocks: [1]codegen_mir.MirBlock;
    blocks[0] = t_block(0, ?b0i[0], 4);
    var f:                   codegen_mir.MirFunction = t_fn(true, ?blocks[0], 1, ?vregs[0], 4);
    val validate_function_r: err[fail.Fail]          = t_validate_function(?t, ?f, ?alloc);
    if (!sel validate_function_r.ok) { ret 1; }
    ret 0;
}

test scope__non_oblivious_unaffected {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    var t:  resolved.Target = t_target(false, true);
    var vt: isa.IsaVTable   = t_isa("machine", false);
    t.isa = ?vt;

    var vregs: [1]codegen_mir.MirVReg;
    vregs[0] = t_vreg(0, true);

    var cbr: [3]codegen_mir.MirOperand;
    cbr[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    cbr[1] = codegen_mir.op_block(0);
    cbr[2] = codegen_mir.op_block(0);
    var b0i: [1]codegen_mir.MirInstr;
    b0i[0] = t_instr(codegen_mir.MIR_CBR, ?cbr[0], 3);
    var blocks: [1]codegen_mir.MirBlock;
    blocks[0] = t_block(0, ?b0i[0], 1);

    var funcs_off: [1]codegen_mir.MirFunction;
    funcs_off[0] = t_fn(false, ?blocks[0], 1, ?vregs[0], 1);
    var mm_off: codegen_mir.MirModule;
    mm_off.alloc        = ?alloc;
    mm_off.interner     = nil;
    mm_off.functions    = ?funcs_off[0];
    mm_off.function_len = 1;
    val run_r: err[fail.Fail] = validate(?t, ?mm_off);
    if (sel run_r.err) { ret 1; }

    var funcs_on: [1]codegen_mir.MirFunction;
    funcs_on[0] = t_fn(true, ?blocks[0], 1, ?vregs[0], 1);
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    fin { diagnostic.store_dnit(?diags); }
    var mm_on: codegen_mir.MirModule;
    mm_on.alloc        = ?alloc;
    mm_on.interner     = nil;
    mm_on.diags        = ?diags;
    mm_on.functions    = ?funcs_on[0];
    mm_on.function_len = 1;
    val run_r2: err[fail.Fail] = validate(?t, ?mm_on);
    if (sel run_r2.ok)                       { ret 1; }
    if (!fail.is_reported(run_r2.err))       { ret 2; }
    if (diagnostic.error_count(?diags) != 1) { ret 3; }
    val d: opt[*diagnostic.Diagnostic] = diagnostic.get(?diags, 0);
    if (sel d.none)                                                    { ret 4; }
    if (d.some.severity != diagnostic.SEVERITY_ERROR)                  { ret 5; }
    if (!str_contains(d.some.message, "conditional-branch condition")) { ret 6; }
    ret 0;
}

