    ret 0;
}

test barrier__declassify_stops_taint {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    var t: resolved.Target = t_target(false, true);

    var vregs: [4]codegen_mir.MirVReg;
    vregs[0] = t_vreg(0, true);
    vregs[1] = t_vreg(1, false);
    vregs[2] = t_vreg(2, false);
    vregs[3] = t_vreg(3, false);

    var dcl: [2]codegen_mir.MirOperand;
    dcl[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    dcl[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    var mul: [3]codegen_mir.MirOperand;
    mul[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    mul[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    mul[2] = codegen_mir.op_vreg(codegen_mir.vreg_id(3));
    var cbr: [3]codegen_mir.MirOperand;
    cbr[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    cbr[1] = codegen_mir.op_block(0);
    cbr[2] = codegen_mir.op_block(0);
    var st: [2]codegen_mir.MirOperand;
    st[0] = codegen_mir.op_mem_value(codegen_mir.vreg_id(1), 0);
    st[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(3));
    var b0i: [4]codegen_mir.MirInstr;
    b0i[0] = t_instr(codegen_mir.MIR_DECLASSIFY, ?dcl[0], 2);
    b0i[1] = t_instr(codegen_mir.MIR_MUL, ?mul[0], 3);
    b0i[2] = t_instr(codegen_mir.MIR_CBR, ?cbr[0], 3);
    b0i[3] = t_instr(codegen_mir.MIR_STORE, ?st[0], 2);

    var blocks: [1]codegen_mir.MirBlock;
    blocks[0] = t_block(0, ?b0i[0], 4);
    var f: codegen_mir.MirFunction = t_fn(true, ?blocks[0], 1, ?vregs[0], 4);
    val r: err[fail.Fail]          = t_validate_function(?t, ?f, ?alloc);
    if (!sel r.ok) { ret 1; }
    ret 0;
}

test varlat__secret_multiply_capability {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var vregs: [3]codegen_mir.MirVReg;
    vregs[0] = t_vreg(0, true);
    vregs[1] = t_vreg(1, false);
    vregs[2] = t_vreg(2, false);

    var mul: [3]codegen_mir.MirOperand;
    mul[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    mul[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    mul[2] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    var b0i: [1]codegen_mir.MirInstr;
    b0i[0] = t_instr(codegen_mir.MIR_MUL, ?mul[0], 3);
    var blocks: [1]codegen_mir.MirBlock;
    blocks[0] = t_block(0, ?b0i[0], 1);
    var f: codegen_mir.MirFunction = t_fn(true, ?blocks[0], 1, ?vregs[0], 3);

    var t_no:                resolved.Target = t_target(false, true);
    val validate_function_r: err[fail.Fail]  = t_validate_function(?t_no, ?f, ?alloc);
    if (!sel validate_function_r.err) { ret 1; }
    var t_yes:                resolved.Target = t_target(true, true);
    val validate_function_r2: err[fail.Fail]  = t_validate_function(?t_yes, ?f, ?alloc);
    if (!sel validate_function_r2.ok) { ret 1; }

    # the gate asks for the exact cell: the high half is not the declared low half
    b0i[0].opcode = codegen_mir.MIR_MUL_HI_U;
    val validate_function_r3: err[fail.Fail] = t_validate_function(?t_yes, ?f, ?alloc);
    if (!sel validate_function_r3.err) { ret 2; }
    b0i[0].opcode   = codegen_mir.MIR_MUL;
    b0i[0].vec_lane = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 8, 2);
    val validate_function_r4: err[fail.Fail] = t_validate_function(?t_yes, ?f, ?alloc);
    if (!sel validate_function_r4.err) { ret 3; }
    ret 0;
}

#[testing]
var t_dit_rows: [1]ct.CtMulForm = [1]ct.CtMulForm{
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 64, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0}
};

#[testing]
fun t_os_declares_dit(arch_id: u32) bool {
    ret true;
}

# runs the validator over one function with a fresh store: 0 when the function
# was admitted with nothing recorded, 1 when its single error is reported
# through the store at the instruction's location and contains `want`, else
# the step that failed; the store owns the text, so the needle is checked here
#[testing]
fun t_dit_refusal(t: *resolved.Target, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr, alloc: *std_allocator.Allocator, want: str) i32 {
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(alloc);
    fin { diagnostic.store_dnit(?diags); }
    var m: codegen_mir.MirModule;
    m.alloc        = alloc;
    m.interner     = nil;
    m.srcmap       = nil;
    m.diags        = ?diags;
    m.functions    = f;
    m.function_len = 1;
    m.function_cap = 1;
    val r: err[fail.Fail] = validate_function(t, ?m, f);
    if (sel r.ok) {
        if (diagnostic.len(?diags) != 0) { ret 10; }
        ret 0;
    }
    if (!fail.is_reported(r.err))            { ret 11; }
    if (diagnostic.error_count(?diags) != 1) { ret 12; }
    val d: opt[*diagnostic.Diagnostic] = diagnostic.get(?diags, 0);
    if (sel d.none)                                                                   { ret 13; }
    if (d.some.severity != diagnostic.SEVERITY_ERROR)                                 { ret 14; }
    if (d.some.loc.file_id != mi.loc.file || d.some.loc.span.offset != mi.loc.offset) { ret 15; }
    if (!str_contains(d.some.message, want))                                          { ret 16; }
    ret 1;
}

# a DIT_MODE row is admitted exactly where the os declares the mode
# guaranteed, and the refusal elsewhere is a located diagnostic naming the
# mode rather than the generic undeclared multiply (#3508)
test varlat__dit_row_follows_the_os_declaration {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var vregs: [3]codegen_mir.MirVReg;
    vregs[0] = t_vreg(0, true);
    vregs[1] = t_vreg(1, false);
    vregs[2] = t_vreg(2, false);
    var mul: [3]codegen_mir.MirOperand;
    mul[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    mul[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    mul[2] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    var b0i: [1]codegen_mir.MirInstr;
    b0i[0]     = t_instr(codegen_mir.MIR_MUL, ?mul[0], 3);
    b0i[0].loc = lang_source.loc(7::lang_source.FileId, 42);
    var blocks: [1]codegen_mir.MirBlock;
    blocks[0] = t_block(0, ?b0i[0], 1);
    var f: codegen_mir.MirFunction = t_fn(true, ?blocks[0], 1, ?vregs[0], 3);

    var t: resolved.Target = t_target(false, true);
    t.model.ct_mul_forms    = ?t_dit_rows[0];
    t.model.ct_mul_form_len = 1;
    t.os                    = nil;
    val dit: str = "data-independent only under PSTATE.DIT";
    if (t_dit_refusal(?t, ?f, ?b0i[0], ?alloc, dit) != 1) { ret 1; }

    var declaring: lang_target_os.OsVTable;
    declaring.dit_guaranteed = nil;
    t.os                     = ?declaring;
    if (t_dit_refusal(?t, ?f, ?b0i[0], ?alloc, dit) != 1) { ret 2; }
    declaring.dit_guaranteed = t_os_declares_dit;
    if (t_dit_refusal(?t, ?f, ?b0i[0], ?alloc, dit) != 0) { ret 3; }

    # the generic message stays for a cell no row declares at all
    b0i[0].opcode = codegen_mir.MIR_MUL_HI_U;
    if (t_dit_refusal(?t, ?f, ?b0i[0], ?alloc, "documents no data-independent multiply timing") != 1) { ret 4; }
    if (t_dit_refusal(?t, ?f, ?b0i[0], ?alloc, "PSTATE.DIT") != 16)                                   { ret 5; }
    ret 0;
}

test varlat__secret_shift_count_only {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    var vregs: [3]codegen_mir.MirVReg;
    vregs[0] = t_vreg(0, true);
    vregs[1] = t_vreg(1, false);
    vregs[2] = t_vreg(2, false);

    var shl: [3]codegen_mir.MirOperand;
    shl[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    shl[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    shl[2] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    var b0i: [1]codegen_mir.MirInstr;
    b0i[0] = t_instr(codegen_mir.MIR_SHL, ?shl[0], 3);
    var blocks: [1]codegen_mir.MirBlock;
    blocks[0] = t_block(0, ?b0i[0], 1);
    var f: codegen_mir.MirFunction = t_fn(true, ?blocks[0], 1, ?vregs[0], 3);

    var t_no:                resolved.Target = t_target(false, false);
    val validate_function_r: err[fail.Fail]  = t_validate_function(?t_no, ?f, ?alloc);
    if (!sel validate_function_r.err) { ret 1; }
    var t_yes:                resolved.Target = t_target(false, true);
    val validate_function_r2: err[fail.Fail]  = t_validate_function(?t_yes, ?f, ?alloc);
    if (!sel validate_function_r2.ok) { ret 1; }

    var shl2: [3]codegen_mir.MirOperand;
    shl2[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    shl2[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    shl2[2] = codegen_mir.op_imm(3);
    var b0i2: [1]codegen_mir.MirInstr;
    b0i2[0] = t_instr(codegen_mir.MIR_SHL, ?shl2[0], 3);
    var blocks2: [1]codegen_mir.MirBlock;
    blocks2[0] = t_block(0, ?b0i2[0], 1);
    var f2:                   codegen_mir.MirFunction = t_fn(true, ?blocks2[0], 1, ?vregs[0], 3);
    val validate_function_r3: err[fail.Fail]          = t_validate_function(?t_no, ?f2, ?alloc);
    if (!sel validate_function_r3.ok) { ret 1; }
    ret 0;
}

