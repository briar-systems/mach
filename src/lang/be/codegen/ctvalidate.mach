# the early constant-time walk over mir, run before legalization on every
# oblivious function. the leakage model has three channels a secret may not
# reach: the control-flow trace (a conditional branch, a branch-implemented
# select, an indirect target), the memory-address trace (a load or store base
# or index), and operand-dependent latency (divide, remainder and every float
# operation always; a multiply unless the machine model declares a
# constant-time row for its exact cell, and a register-count shift unless it
# declares `ct_trust_var_shift`). taint is a two-point lattice per value
# re-derived as a monotone fixpoint; `MIR_DECLASSIFY` is the
# only downgrade; an opcode, operand kind or register outside the catalog is
# refused, never treated as public. `ctwalk` repeats the same check over the
# emitted instruction stream after every late expansion
use std_format: std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_len;

use std.allocator.page;

use std_allocator: std.allocator;

use mach.lang.be.codegen.debug_input;
use codegen_mir: mach.lang.be.codegen.mir;
use mach.lang.be.codegen.unit_input;
use mach.lang.ct;
use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.intern;
use lang_source: mach.lang.source;
use mach.lang.target.isa;
use target_of:      mach.lang.target.of;
use lang_target_os: mach.lang.target.os;
use mach.lang.target.resolved;

pub fun validate(tgt: *resolved.Target, m: *codegen_mir.MirModule) err[fail.Fail] {
    if (tgt == nil)     { ret err[fail.Fail].err{fail.message("ctvalidate: nil target")}; }
    if (tgt.isa == nil) { ret err[fail.Fail].err{fail.message("ctvalidate: target has no instruction set")}; }
    if (m == nil)       { ret err[fail.Fail].err{fail.message("ctvalidate: nil mir module")}; }

    val unverifiable: bool = isa.emits_whole_module(tgt.isa);

    var i: u32 = 0;
    for (i < m.function_len) {
        val f: *codegen_mir.MirFunction = ?m.functions[i];
        if (f.oblivious) {
            if (unverifiable) {
                ret err[fail.Fail].err{codegen_mir.reject_function(m, diagnostic_kind.SECRET_TARGET_UNVERIFIABLE, f, unverifiable_msg(m.alloc, m.interner, f.name, tgt.isa.name))};
            }
            val result: err[fail.Fail] = validate_function(tgt, m, f);
            if (sel result.err) { ret result; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun validate_function(tgt: *resolved.Target, m: *codegen_mir.MirModule, f: *codegen_mir.MirFunction) err[fail.Fail] {
    if (f.block_count == 0) { ret err[fail.Fail].ok{}; }
    val interner: *intern.Interner         = m.interner;
    val alloc:    *std_allocator.Allocator = m.alloc;

    val nv: u32 = f.vreg_count;
    val mp: u32 = max_preg(f);
    var np: u32 = 0;
    if (mp != NO_PREG) { np = mp + 1; }

    val shape: err[fail.Fail] = validate_operand_ranges(f, nv, np, interner, alloc);
    if (sel shape.err) { ret shape; }

    if (nv == 0 && np == 0) { ret err[fail.Fail].ok{}; }

    var vt: *bool = nil;
    if (nv > 0) {
        val rv: res[*bool, std_allocator.Error] = std_allocator.allocate[bool](alloc, nv::usize);
        if (sel rv.err) { ret err[fail.Fail].err{fail.refused(rv.err)}; }
        vt = rv.ok;
        var i: u32 = 0;
        for (i < nv) {
            vt[i] = f.vregs[i].secret;
            i     = i + 1;
        }
    }

    var pt: *bool = nil;
    if (np > 0) {
        val rp: res[*bool, std_allocator.Error] = std_allocator.allocate[bool](alloc, np::usize);
        if (sel rp.err) {
            free_taint(alloc, vt, nv, pt, np);
            ret err[fail.Fail].err{fail.refused(rp.err)};
        }
        pt = rp.ok;
    }

    fixpoint(f, vt, pt, np);

    var bj: u32 = 0;
    for (bj < f.block_count) {
        val blk: *codegen_mir.MirBlock = ?f.blocks[bj];
        clear_pregs(pt, np);
        var ij: u32 = 0;
        for (ij < blk.instr_count) {
            val mi:  *codegen_mir.MirInstr = ?blk.instrs[ij];
            val chk: err[fail.Fail]        = check_instr(tgt, m, f, mi, vt, pt);
            if (sel chk.err) {
                free_taint(alloc, vt, nv, pt, np);
                ret chk;
            }
            if (apply_instr(mi, vt, pt, np)) {}
            ij = ij + 1;
        }
        bj = bj + 1;
    }

    free_taint(alloc, vt, nv, pt, np);
    ret err[fail.Fail].ok{};
}

fun fixpoint(f: *codegen_mir.MirFunction, vt: *bool, pt: *bool, np: u32) {
    var changed: bool = true;
    for (changed) {
        changed = false;
        var bi: u32 = 0;
        for (bi < f.block_count) {
            val blk: *codegen_mir.MirBlock = ?f.blocks[bi];
            clear_pregs(pt, np);
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                if (apply_instr(?blk.instrs[ii], vt, pt, np)) { changed = true; }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }
}

# the per-vreg fixpoint the early walk reaches, seeded from MirVReg.secret:
# what a post-allocation consumer compares its physical seeds against. one
# bool per vreg, the caller frees vreg_count entries; nil for no vregs.
#[testing]
pub fun derive_secret_vregs(f: *codegen_mir.MirFunction, alloc: *std_allocator.Allocator) res[*bool, fail.Fail] {
    val nv: u32 = f.vreg_count;
    if (nv == 0) { ret res[*bool, fail.Fail].ok{nil}; }
    val rv: res[*bool, std_allocator.Error] = std_allocator.allocate[bool](alloc, nv::usize);
    if (sel rv.err) { ret res[*bool, fail.Fail].err{fail.refused(rv.err)}; }
    val vt: *bool = rv.ok;
    var i:  u32   = 0;
    for (i < nv) {
        vt[i] = f.vregs[i].secret;
        i     = i + 1;
    }

    val mp: u32 = max_preg(f);
    var np: u32 = 0;
    if (mp != NO_PREG) { np = mp + 1; }
    var pt: *bool = nil;
    if (np > 0) {
        val rp: res[*bool, std_allocator.Error] = std_allocator.allocate[bool](alloc, np::usize);
        if (sel rp.err) {
            std_allocator.deallocate[bool](alloc, vt, nv::usize);
            ret res[*bool, fail.Fail].err{fail.refused(rp.err)};
        }
        pt = rp.ok;
    }
    fixpoint(f, vt, pt, np);
    if (pt != nil) { std_allocator.deallocate[bool](alloc, pt, np::usize); }
    ret res[*bool, fail.Fail].ok{vt};
}

fun free_taint(alloc: *std_allocator.Allocator, vt: *bool, nv: u32, pt: *bool, np: u32) {
    if (vt != nil && nv > 0) { std_allocator.deallocate[bool](alloc, vt, nv::usize); }
    if (pt != nil && np > 0) { std_allocator.deallocate[bool](alloc, pt, np::usize); }
}

val NO_PREG: u32 = 0xFFFFFFFF;

fun max_preg(f: *codegen_mir.MirFunction) u32 {
    var best: u32 = NO_PREG;
    var bi:   u32 = 0;
    for (bi < f.block_count) {
        val blk: *codegen_mir.MirBlock = ?f.blocks[bi];
        var ii:  u32                   = 0;
        for (ii < blk.instr_count) {
            val mi: *codegen_mir.MirInstr = ?blk.instrs[ii];
            var k:  u32                   = 0;
            for (k < mi.operand_count) {
                val op: *codegen_mir.MirOperand = ?mi.operands[k];
                if (op.kind == codegen_mir.MIR_OP_PREG) {
                    if (best == NO_PREG || op.preg.n > best) { best = op.preg.n; }
                }
                if (op.kind == codegen_mir.MIR_OP_MEM) {
                    if (codegen_mir.vreg_is_nil(op.vreg)) {
                        if (best == NO_PREG || op.preg.n > best) { best = op.preg.n; }
                    }
                    if (sel op.index.preg) {
                        if (best == NO_PREG || op.index.preg.n > best) { best = op.index.preg.n; }
                    }
                }
                k = k + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret best;
}

fun clear_pregs(pt: *bool, np: u32) {
    if (pt == nil) { ret; }
    var i: u32 = 0;
    for (i < np) {
        pt[i] = false;
        i     = i + 1;
    }
}

fun validate_operand_ranges(f: *codegen_mir.MirFunction, nv: u32, np: u32, interner: *intern.Interner, alloc: *std_allocator.Allocator) err[fail.Fail] {
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *codegen_mir.MirBlock = ?f.blocks[bi];
        var ii:  u32                   = 0;
        for (ii < blk.instr_count) {
            val mi: *codegen_mir.MirInstr = ?blk.instrs[ii];
            var k:  u32                   = 0;
            for (k < mi.operand_count) {
                val op: *codegen_mir.MirOperand = ?mi.operands[k];
                if (!operand_kind_known(op.kind)) {
                    ret err[fail.Fail].err{fail.message(malformed_msg(alloc, interner, f.name, RANGE_OPERAND_KIND_DETAIL))};
                }
                if (op.kind == codegen_mir.MIR_OP_VREG && op.vreg.n >= nv) {
                    ret err[fail.Fail].err{fail.message(malformed_msg(alloc, interner, f.name, RANGE_VREG_DETAIL))};
                }
                if (op.kind == codegen_mir.MIR_OP_PREG && op.preg.n >= np) {
                    ret err[fail.Fail].err{fail.message(malformed_msg(alloc, interner, f.name, RANGE_PREG_DETAIL))};
                }
                if (op.kind == codegen_mir.MIR_OP_MEM) {
                    if (codegen_mir.vreg_is_nil(op.vreg) && op.preg.n >= np) {
                        ret err[fail.Fail].err{fail.message(malformed_msg(alloc, interner, f.name, RANGE_MEM_BASE_DETAIL))};
                    }
                    if (!codegen_mir.vreg_is_nil(op.vreg) && op.vreg.n >= nv) {
                        ret err[fail.Fail].err{fail.message(malformed_msg(alloc, interner, f.name, RANGE_MEM_BASE_DETAIL))};
                    }
                    if (sel op.index.preg) {
                        if (op.index.preg.n >= np) {
                            ret err[fail.Fail].err{fail.message(malformed_msg(alloc, interner, f.name, RANGE_MEM_INDEX_DETAIL))};
                        }
                    }
                    if (sel op.index.vreg) {
                        if (op.index.vreg.n >= nv) {
                            ret err[fail.Fail].err{fail.message(malformed_msg(alloc, interner, f.name, RANGE_MEM_INDEX_DETAIL))};
                        }
                    }
                }
                k = k + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun mem_base_secret(op: *codegen_mir.MirOperand, vt: *bool, pt: *bool) bool {
    if (codegen_mir.vreg_is_nil(op.vreg)) { ret pt[op.preg.n]; }
    ret vt[op.vreg.n];
}

fun mem_index_secret(op: *codegen_mir.MirOperand, vt: *bool, pt: *bool) bool {
    if (sel op.index.preg) { ret pt[op.index.preg.n]; }
    if (sel op.index.vreg) { ret vt[op.index.vreg.n]; }
    ret false;
}

fun operand_secret(op: *codegen_mir.MirOperand, vt: *bool, pt: *bool) bool {
    if (op.kind == codegen_mir.MIR_OP_VREG) { ret vt[op.vreg.n]; }
    if (op.kind == codegen_mir.MIR_OP_PREG) { ret pt[op.preg.n]; }
    if (op.kind == codegen_mir.MIR_OP_MEM) {
        ret mem_base_secret(op, vt, pt) || mem_index_secret(op, vt, pt);
    }
    if (op.kind == codegen_mir.MIR_OP_IMM || op.kind == codegen_mir.MIR_OP_SYM || op.kind == codegen_mir.MIR_OP_BLOCK) { ret false; }
    ret true;
}

fun operand_kind_known(kind: codegen_mir.MirOperandKind) bool {
    ret kind == codegen_mir.MIR_OP_VREG || kind == codegen_mir.MIR_OP_PREG || kind == codegen_mir.MIR_OP_IMM
        || kind == codegen_mir.MIR_OP_MEM || kind == codegen_mir.MIR_OP_SYM || kind == codegen_mir.MIR_OP_BLOCK;
}

fun apply_instr(mi: *codegen_mir.MirInstr, vt: *bool, pt: *bool, np: u32) bool {
    if (mi.opcode == codegen_mir.MIR_CALL) {
        clear_pregs(pt, np);
        ret false;
    }
    if (mi.opcode == codegen_mir.MIR_DECLASSIFY) { ret false; }
    if (mi.operand_count == 0)                   { ret false; }

    var s: bool = false;
    var k: u32  = 0;
    for (k < mi.operand_count) {
        if (operand_secret(?mi.operands[k], vt, pt)) { s = true; }
        k = k + 1;
    }

    if (!codegen_mir.instr_defines_shape(mi)) { ret false; }
    val d: *codegen_mir.MirOperand = ?mi.operands[0];
    if (d.kind == codegen_mir.MIR_OP_VREG) {
        if (s && !vt[d.vreg.n]) {
            vt[d.vreg.n] = true;
            ret true;
        }
        ret false;
    }
    if (d.kind == codegen_mir.MIR_OP_PREG) { pt[d.preg.n] = s; }
    ret false;
}

fun check_instr(tgt: *resolved.Target, m: *codegen_mir.MirModule, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr, vt: *bool, pt: *bool) err[fail.Fail] {
    val interner: *intern.Interner         = m.interner;
    val alloc:    *std_allocator.Allocator = m.alloc;
    if (mi.opcode == codegen_mir.MIR_ASM) {
        ret check_asm(tgt, m, f, mi);
    }
    if (mi.opcode == codegen_mir.MIR_CBR) {
        if (mi.operand_count >= 1 && operand_secret(?mi.operands[0], vt, pt)) {
            ret err[fail.Fail].err{codegen_mir.reject_instr(m, diagnostic_kind.SECRET_BRANCH, f, mi, leak_msg(alloc, interner, f.name,
                "uses a secret value as a conditional-branch condition; the branch decides the taken path, so its timing reveals the secret. select branch-free (a masked select) over public data, or `:>T`-declassify the value when disclosure is intended"))};
        }
    }
    if (mi.opcode == codegen_mir.MIR_CALL) {
        if (mi.operand_count >= 1 && operand_secret(?mi.operands[0], vt, pt)) {
            ret err[fail.Fail].err{codegen_mir.reject_instr(m, diagnostic_kind.SECRET_BRANCH, f, mi, leak_msg(alloc, interner, f.name,
                "calls through a secret function pointer; the branch target, hence the taken path and its timing, depends on the secret. dispatch on public data, or `:>T`-declassify the pointer when disclosure is intended"))};
        }
    }
    if (codegen_mir.is_fused_cbr(mi.opcode)) {
        if (mi.operand_count >= 1 && operand_secret(?mi.operands[0], vt, pt)) {
            ret err[fail.Fail].err{codegen_mir.reject_instr(m, diagnostic_kind.SECRET_BRANCH, f, mi, leak_msg(alloc, interner, f.name,
                "compares a secret value in a conditional branch; the branch's taken path reveals the secret. select branch-free over public data, or `:>T`-declassify when disclosure is intended"))};
        }
        if (mi.operand_count >= 2 && operand_secret(?mi.operands[1], vt, pt)) {
            ret err[fail.Fail].err{codegen_mir.reject_instr(m, diagnostic_kind.SECRET_BRANCH, f, mi, leak_msg(alloc, interner, f.name,
                "compares a secret value in a conditional branch; the branch's taken path reveals the secret. select branch-free over public data, or `:>T`-declassify when disclosure is intended"))};
        }
    }
    var k: u32 = 0;
    for (k < mi.operand_count) {
        val op: *codegen_mir.MirOperand = ?mi.operands[k];
        if (op.kind == codegen_mir.MIR_OP_MEM) {
            if (mem_base_secret(op, vt, pt)) {
                ret err[fail.Fail].err{codegen_mir.reject_instr(m, diagnostic_kind.SECRET_ADDRESS, f, mi, leak_msg(alloc, interner, f.name,
                    "uses a secret value as a memory address; a secret-dependent load or store address leaks the secret through the memory-access pattern. index at a public offset, or `:>T`-declassify the pointer when disclosure is intended"))};
            }
            if (mem_index_secret(op, vt, pt)) {
                ret err[fail.Fail].err{codegen_mir.reject_instr(m, diagnostic_kind.SECRET_ADDRESS, f, mi, leak_msg(alloc, interner, f.name,
                    "uses a secret value as a memory index; a secret-dependent load or store address leaks the secret through the memory-access pattern. index at a public offset, or `:>T`-declassify the index when disclosure is intended"))};
            }
        }
        k = k + 1;
    }
    val cr: res[ct.CtOp, fail.Fail] = codegen_mir.ct_op(mi.opcode);
    if (sel cr.err) {
        ret err[fail.Fail].err{fail.message(malformed_msg(alloc, interner, f.name, fail.describe(cr.err)))};
    }
    val cop: ct.CtOp = cr.ok;
    if (cop != ct.CT_OP_NONE) {
        val declared: opt[ct.CtCap] = ct.ct_cap(cop);
        if (sel declared.none) {
            ret err[fail.Fail].err{fail.message(malformed_msg(alloc, interner, f.name,
                fail.catalog_message_or(interner, alloc, fail.unknown_member("CtOp", cop::u32), "unknown CtOp tag")))};
        }
        val cap:  ct.CtCap     = declared.some;
        val cell: ct.CtMulCell = codegen_mir.ct_mul_cell(mi);
        if (!ct.target_provides(resolved.ct_mul_admitted(tgt), cell, tgt.model.ct_trust_var_shift, cap)) {
            if (ct_secret_operand(mi, cop, vt, pt)) {
                val detail: opt[str] = ct_op_detail(cop);
                if (sel detail.none) {
                    ret err[fail.Fail].err{fail.message(malformed_msg(alloc, interner, f.name,
                        fail.catalog_message_or(interner, alloc, fail.unknown_member("CtOp", cop::u32), "unknown CtOp tag")))};
                }
                if (cop == ct.CT_OP_INT_MUL && ct.mul_mask_has(resolved.ct_mul_dit_cells(tgt), cell)) {
                    ret err[fail.Fail].err{codegen_mir.reject_instr(m, diagnostic_kind.SECRET_VARIABLE_LATENCY, f, mi, leak_msg(alloc, interner, f.name, mul_dit_unguaranteed_detail(tgt, alloc, interner)))};
                }
                ret err[fail.Fail].err{codegen_mir.reject_instr(m, diagnostic_kind.SECRET_VARIABLE_LATENCY, f, mi, leak_msg(alloc, interner, f.name, detail.some))};
            }
        }
    }
    ret err[fail.Fail].ok{};
}

fun check_asm(tgt: *resolved.Target, m: *codegen_mir.MirModule, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr) err[fail.Fail] {
    val interner: *intern.Interner         = m.interner;
    val alloc:    *std_allocator.Allocator = m.alloc;
    if (tgt.arch == nil || !tgt.arch.has_assembly || mi.asm_block == nil) {
        ret err[fail.Fail].err{codegen_mir.reject_instr(m, diagnostic_kind.SECRET_UNVERIFIABLE, f, mi, leak_msg(alloc, interner, f.name,
            "contains inline assembly, which cannot be verified constant-time and is not permitted in a #[oblivious] function; express the operation with the constant-time primitives, or move it to a non-oblivious function and `:>T`-declassify at the boundary"))};
    }
    val blk: *codegen_mir.MirAsm = mi.asm_block;

    var secrets: *ct.AsmSecret = nil;
    var n:       u32           = 0;
    if (blk.bind_count > 0) {
        val rn: res[*ct.AsmSecret, std_allocator.Error] = std_allocator.allocate[ct.AsmSecret](alloc, blk.bind_count::usize);
        if (sel rn.err) { ret err[fail.Fail].err{fail.refused(rn.err)}; }
        secrets = rn.ok;
        var i: u32 = 0;
        for (i < blk.bind_count) {
            val b: *codegen_mir.MirAsmBind = ?blk.binds[i];
            if (ct.bind_tracked(b.secrecy)) {
                val nm: opt[str] = intern.lookup(interner, b.name);
                if (sel nm.some) {
                    secrets[n] = ct.asm_secret(nm.some, b.secrecy);
                    n          = n + 1;
                }
            }
            i = i + 1;
        }
    }

    val scan: isa.AsmCtScanFn    = tgt.arch.assembly.ct_scan;
    val r:    err[ct.AsmRefusal] = scan(blk.body, secrets, n, resolved.ct_mul_admitted(tgt), tgt.model.ct_trust_var_shift, alloc);

    if (secrets != nil) { std_allocator.deallocate[ct.AsmSecret](alloc, secrets, blk.bind_count::usize); }

    if (sel r.err) {
        ret err[fail.Fail].err{codegen_mir.reject_instr(m, r.err.kind, f, mi, leak_msg(alloc, interner, f.name, r.err.message))};
    }
    ret err[fail.Fail].ok{};
}

fun ct_secret_operand(mi: *codegen_mir.MirInstr, cop: ct.CtOp, vt: *bool, pt: *bool) bool {
    if (ct.ct_op_gates_count_only(cop)) {
        if (mi.operand_count < 2) { ret false; }
        ret operand_secret(?mi.operands[mi.operand_count - 1], vt, pt);
    }
    val skip_def: bool = codegen_mir.instr_defines_shape(mi)
        && mi.operand_count > 0 && mi.operands[0].kind == codegen_mir.MIR_OP_VREG;
    var k: u32 = 0;
    for (k < mi.operand_count) {
        if (!(k == 0 && skip_def)) {
            if (operand_secret(?mi.operands[k], vt, pt)) { ret true; }
        }
        k = k + 1;
    }
    ret false;
}

# the leak detail of an operation whose capability the target does not
# provide; absent for a tag outside the catalog
fun ct_op_detail(cop: ct.CtOp) opt[str] {
    if (cop == ct.CT_OP_VAR_SHIFT) {
        ret opt[str].some{"uses a secret value as a variable shift count on a target without a barrel shifter; the shift's cycle count leaks the secret amount. shift by a public count, or run on a target whose variable shift is constant-time"};
    }
    if (cop == ct.CT_OP_FLOAT) {
        ret opt[str].some{"uses a secret value in a variable-latency floating-point operation; the FP unit's timing can depend on the secret operand. compute on public data, or `:>T`-declassify when disclosure is intended"};
    }
    if (cop == ct.CT_OP_INT_DIVMOD) {
        ret opt[str].some{"uses a secret value in an integer divide or remainder; the division unit's latency is data-dependent, so it leaks the secret operand. compute branch-free over public data"};
    }
    if (cop == ct.CT_OP_INT_MUL) {
        ret opt[str].some{"uses a secret value in a variable-latency integer multiply; this target documents no data-independent multiply timing, so the product's latency can leak the secret operand. compute branch-free over public data, or run on a target whose DIT/DOITM mode is trusted"};
    }
    ret opt[str].none{};
}

val MUL_DIT_UNGUARANTEED_DETAIL: str = "uses a secret value in an integer multiply whose timing is data-independent only under PSTATE.DIT, and this operating system declares no guarantee that a process can set and hold that mode (#3508). compute branch-free over public data, or build for an operating system that declares the guarantee";

# the leak detail of a secret multiply in a cell the instruction set declares
# only under PSTATE.DIT on an os that declares no guarantee for the mode
fun mul_dit_unguaranteed_detail(tgt: *resolved.Target, alloc: *std_allocator.Allocator, interner: *intern.Interner) str {
    if (interner == nil) { ret MUL_DIT_UNGUARANTEED_DETAIL; }
    val result: res[str, std_format.FormatError] = std_format.sprint(alloc,
        "uses a secret value in an integer multiply whose timing is data-independent only under PSTATE.DIT; the `{}` instruction set declares the multiply under that mode and the `{}` operating system declares no guarantee that a process can set and hold it (#3508). compute branch-free over public data, or build for an operating system that declares the guarantee",
        tgt.isa.name, tgt.os.name);
    if (sel result.err) { ret MUL_DIT_UNGUARANTEED_DETAIL; }
    ret stable(alloc, interner, result.ok, MUL_DIT_UNGUARANTEED_DETAIL);
}

fun leak_msg(alloc: *std_allocator.Allocator, interner: *intern.Interner, name_id: intern.StrId, detail: str) str {
    if (interner == nil) { ret detail; }
    val name:   str                              = fn_name(interner, name_id);
    val result: res[str, std_format.FormatError] = std_format.sprint(alloc, "#[oblivious] function `{}` {}", name, detail);
    if (sel result.err) { ret detail; }
    ret stable(alloc, interner, result.ok, detail);
}

fun malformed_msg(alloc: *std_allocator.Allocator, interner: *intern.Interner, name_id: intern.StrId, detail: str) str {
    if (interner == nil) { ret detail; }
    val name:   str                              = fn_name(interner, name_id);
    val result: res[str, std_format.FormatError] = std_format.sprint(alloc,
        "#[oblivious] function `{}` cannot be validated constant-time: {}", name, detail);
    if (sel result.err) { ret detail; }
    ret stable(alloc, interner, result.ok, detail);
}

val RANGE_OPERAND_KIND_DETAIL: str = "an instruction operand has a kind outside the machine-operand catalog, so its secrecy cannot be decided; the machine program is malformed";
val RANGE_VREG_DETAIL:         str = "an instruction operand names a virtual register outside the function's declared virtual-register range, so its secrecy cannot be decided; the machine program is malformed";
val RANGE_PREG_DETAIL:         str = "an instruction operand names a physical register outside the range the function's operands span, so its secrecy cannot be decided; the machine program is malformed";
val RANGE_MEM_BASE_DETAIL:     str = "a memory operand's base register lies outside the function's declared virtual-register range, so the address's secrecy cannot be decided; the machine program is malformed";
val RANGE_MEM_INDEX_DETAIL:    str = "a memory operand's index register lies outside the register range the function spans, so the address's secrecy cannot be decided; the machine program is malformed";

fun unverifiable_msg(alloc: *std_allocator.Allocator, interner: *intern.Interner, name_id: intern.StrId, arch: str) str {
    if (interner == nil) { ret UNVERIFIABLE_DETAIL; }
    val name:   str                              = fn_name(interner, name_id);
    val result: res[str, std_format.FormatError] = std_format.sprint(alloc,
        "#[oblivious] function `{}` cannot be compiled for the `{}` target: its back half emits a module for a downstream compiler to translate rather than the instructions that execute, and neither that translation nor the device's timing behaviour is covered by mach's leakage model, so the constant-time contract can be neither validated nor upheld. compile the oblivious function for a machine target and pass this one only public data",
        name, arch);
    if (sel result.err) { ret UNVERIFIABLE_DETAIL; }
    ret stable(alloc, interner, result.ok, UNVERIFIABLE_DETAIL);
}

val UNVERIFIABLE_DETAIL: str = "a #[oblivious] function cannot be compiled for a target whose back half emits a module for a downstream compiler to translate rather than the instructions that execute; the constant-time contract can be neither validated nor upheld there. compile the oblivious function for a machine target and pass this one only public data";

fun stable(alloc: *std_allocator.Allocator, interner: *intern.Interner, buf: str, fallback: str) str {
    val ir: res[intern.StrId, std_allocator.Error] = intern.intern(interner, buf);
    std_allocator.deallocate[u8](alloc, buf, str_len(buf) + 1);
    if (sel ir.err) { ret fallback; }
    val lo: opt[str] = intern.lookup(interner, ir.ok);
    if (sel lo.some) { ret lo.some; }
    ret fallback;
}

fun fn_name(interner: *intern.Interner, id: intern.StrId) str {
    val o: opt[str] = intern.lookup(interner, id);
    if (sel o.some) { ret o.some; }
    ret "<unknown>";
}

# the per-function walk over a module that owns no interner and no store: a
# refusal then keeps its text as a message failure
#[testing]
fun t_validate_function(t: *resolved.Target, f: *codegen_mir.MirFunction, alloc: *std_allocator.Allocator) err[fail.Fail] {
    var m: codegen_mir.MirModule;
    m.alloc        = alloc;
    m.interner     = nil;
    m.srcmap       = nil;
    m.diags        = nil;
    m.functions    = f;
    m.function_len = 1;
    m.function_cap = 1;
    ret validate_function(t, ?m, f);
}

#[testing]
fun t_vreg(id: u32, secret: bool) codegen_mir.MirVReg {
    ret codegen_mir.vreg(id, codegen_mir.REG_CLASS_GP, 0, secret);
}

#[testing]
fun t_instr(op: codegen_mir.MirOpcode, ops: *codegen_mir.MirOperand, n: u32) codegen_mir.MirInstr {
    var mi: codegen_mir.MirInstr = codegen_mir.instr(op, ops, n, 8, 8);
    ret mi;
}

#[testing]
fun t_block(id: u32, instrs: *codegen_mir.MirInstr, n: u32) codegen_mir.MirBlock {
    var b: codegen_mir.MirBlock;
    b.id          = id;
    b.instrs      = instrs;
    b.instr_count = n;
    b.instr_cap   = n;
    b.preds       = nil;
    b.pred_count  = 0;
    b.pred_cap    = 0;
    ret b;
}

#[testing]
fun t_fn(oblivious: bool, blocks: *codegen_mir.MirBlock, nb: u32, vregs: *codegen_mir.MirVReg, nv: u32) codegen_mir.MirFunction {
    var f: codegen_mir.MirFunction;
    f.name        = intern.STR_NIL;
    f.blocks      = blocks;
    f.block_count = nb;
    f.vregs       = vregs;
    f.vreg_count  = nv;
    f.oblivious   = oblivious;
    ret f;
}

#[testing]
var t_low_rows: [4]ct.CtMulForm = [4]ct.CtMulForm{
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0}
};

# a trusted multiply declares the low half at every scalar width, nothing else
#[testing]
fun t_target(trust_mul: bool, trust_var_shift: bool) resolved.Target {
    var t: resolved.Target;
    t.model.has_mul            = true;
    t.model.ct_mul_forms       = nil;
    t.model.ct_mul_form_len    = 0;
    t.model.ct_trust_var_shift = trust_var_shift;
    if (trust_mul) {
        t.model.ct_mul_forms    = ?t_low_rows[0];
        t.model.ct_mul_form_len = 4;
    }
    ret t;
}

#[testing]
rec TEmitterHolder {
    emitter: isa.ModuleEmitter;
}

#[testing]
var t_emitter_holder: TEmitterHolder;

#[testing]
fun t_emit_module(alloc: *std_allocator.Allocator, tgt: *isa.BackendTarget, unit: *unit_input.Unit, dbg: *debug_input.ModuleDebug,
    image: *target_of.ObjectImage) err[fail.Fail] {
    ret err[fail.Fail].ok{};
}

#[testing]
fun t_isa(name: str, whole_module: bool) isa.IsaVTable {
    if (whole_module) {
        t_emitter_holder.emitter = isa.module_emitter(t_emit_module, false);
        ret isa.emitter_isa(isa.ARCH_UNKNOWN, name, 8, nil, ?t_emitter_holder.emitter);
    }
    ret isa.machine_isa(isa.ARCH_UNKNOWN, name, 0, 8, nil, nil, nil);
}

test rederive__phi_join_branch {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    var t: resolved.Target = t_target(false, true);

    var vregs: [3]codegen_mir.MirVReg;
    vregs[0] = t_vreg(0, true);
    vregs[1] = t_vreg(1, false);
    vregs[2] = t_vreg(2, false);

    var b0_mov: [2]codegen_mir.MirOperand;
    b0_mov[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    b0_mov[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    var b0_br: [1]codegen_mir.MirOperand;
    b0_br[0] = codegen_mir.op_block(2);
    var b0i: [2]codegen_mir.MirInstr;
    b0i[0] = t_instr(codegen_mir.MIR_MOV, ?b0_mov[0], 2);
    b0i[1] = t_instr(codegen_mir.MIR_BR, ?b0_br[0], 1);

    var b1_mov: [2]codegen_mir.MirOperand;
    b1_mov[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    b1_mov[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    var b1_br: [1]codegen_mir.MirOperand;
    b1_br[0] = codegen_mir.op_block(2);
    var b1i: [2]codegen_mir.MirInstr;
    b1i[0] = t_instr(codegen_mir.MIR_MOV, ?b1_mov[0], 2);
    b1i[1] = t_instr(codegen_mir.MIR_BR, ?b1_br[0], 1);

    var b2_cbr: [3]codegen_mir.MirOperand;
    b2_cbr[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    b2_cbr[1] = codegen_mir.op_block(0);
    b2_cbr[2] = codegen_mir.op_block(1);
    var b2i: [1]codegen_mir.MirInstr;
    b2i[0] = t_instr(codegen_mir.MIR_CBR, ?b2_cbr[0], 3);

    var blocks: [3]codegen_mir.MirBlock;
    blocks[0] = t_block(0, ?b0i[0], 2);
    blocks[1] = t_block(1, ?b1i[0], 2);
    blocks[2] = t_block(2, ?b2i[0], 1);

    var f: codegen_mir.MirFunction = t_fn(true, ?blocks[0], 3, ?vregs[0], 3);
    val r: err[fail.Fail]          = t_validate_function(?t, ?f, ?alloc);
    if (!sel r.err) { ret 1; }
    ret 0;
}

test rederive__inlined_return_address {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);
    var t: resolved.Target = t_target(false, true);

    var vregs: [4]codegen_mir.MirVReg;
    vregs[0] = t_vreg(0, true);
    vregs[1] = t_vreg(1, false);
    vregs[2] = t_vreg(2, false);
    vregs[3] = t_vreg(3, false);

    var mov1: [2]codegen_mir.MirOperand;
    mov1[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    mov1[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    var mov2: [2]codegen_mir.MirOperand;
    mov2[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(2));
    mov2[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));
    var load: [2]codegen_mir.MirOperand;
    load[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(3));
    load[1] = codegen_mir.op_mem_value(codegen_mir.vreg_id(2), 0);
    var b0i: [3]codegen_mir.MirInstr;
    b0i[0] = t_instr(codegen_mir.MIR_MOV, ?mov1[0], 2);
    b0i[1] = t_instr(codegen_mir.MIR_MOV, ?mov2[0], 2);
    b0i[2] = t_instr(codegen_mir.MIR_LOAD, ?load[0], 2);

    var blocks: [1]codegen_mir.MirBlock;
    blocks[0] = t_block(0, ?b0i[0], 3);
    var f: codegen_mir.MirFunction = t_fn(true, ?blocks[0], 1, ?vregs[0], 4);
    val r: err[fail.Fail]          = t_validate_function(?t, ?f, ?alloc);
    if (!sel r.err) { ret 1; }
    ret 0;
}

