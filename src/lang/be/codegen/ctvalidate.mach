    mm_on.interner     = nil;
    mm_on.diags        = ?diags;
    mm_on.functions    = ?funcs_on[0];
    mm_on.function_len = 1;

    var mvt: isa.IsaVTable = t_isa("machine", false);
    t.isa = ?mvt;
    val run_r: err[fail.Fail] = validate(?t, ?mm_on);
