    if (sel run_r2.ok)                       { ret 1; }
    if (!fail.is_reported(run_r2.err))       { ret 2; }
    if (diagnostic.error_count(?diags) != 1) { ret 3; }

    var funcs_off: [1]codegen_mir.MirFunction;
    funcs_off[0] = t_fn(false, ?blocks[0], 1, ?vregs[0], 3);
    var mm_off: codegen_mir.MirModule;
    mm_off.alloc        = ?alloc;
    mm_off.interner     = nil;
    mm_off.functions    = ?funcs_off[0];
    mm_off.function_len = 1;
    val run_r3: err[fail.Fail] = validate(?t, ?mm_off);
    if (sel run_r3.err) { ret 1; }
    t.isa = ?mvt;
    val run_r4: err[fail.Fail] = validate(?t, ?mm_off);
    if (sel run_r4.err) { ret 1; }
    ret 0;
}

#[testing]
fun t_ct(op: codegen_mir.MirOpcode) ct.CtOp {
    val r: res[ct.CtOp, fail.Fail] = codegen_mir.ct_op(op);
    if (sel r.err) { ret 0xFF; }
    ret r.ok;
}

test classify__mir_ct_op_table {
    if (t_ct(codegen_mir.MIR_MUL) != ct.CT_OP_INT_MUL)       { ret 1; }
    if (t_ct(codegen_mir.MIR_DIV_S) != ct.CT_OP_INT_DIVMOD)  { ret 1; }
    if (t_ct(codegen_mir.MIR_REM_U) != ct.CT_OP_INT_DIVMOD)  { ret 1; }
    if (t_ct(codegen_mir.MIR_SHL) != ct.CT_OP_VAR_SHIFT)     { ret 1; }
    if (t_ct(codegen_mir.MIR_SHR_S) != ct.CT_OP_VAR_SHIFT)   { ret 1; }
    if (t_ct(codegen_mir.MIR_FADD) != ct.CT_OP_FLOAT)        { ret 1; }
    if (t_ct(codegen_mir.MIR_FCMP) != ct.CT_OP_FLOAT)        { ret 1; }
    if (t_ct(codegen_mir.MIR_FP_TO_SI) != ct.CT_OP_FLOAT)    { ret 1; }
    if (t_ct(codegen_mir.MIR_ADD) != ct.CT_OP_NONE)          { ret 1; }
    if (t_ct(codegen_mir.MIR_LOAD) != ct.CT_OP_NONE)         { ret 1; }
    if (t_ct(codegen_mir.MIR_SEL_MUL) != ct.CT_OP_INT_MUL)   { ret 1; }
    if (t_ct(codegen_mir.MIR_MUL_HI_U) != ct.CT_OP_INT_MUL)  { ret 1; }
    if (t_ct(codegen_mir.MIR_SEL_SHL) != ct.CT_OP_VAR_SHIFT) { ret 1; }
    ret 0;
}

