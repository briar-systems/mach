#[testing]
#[volatile]
rec BarePageStorage {
    first: u8;
    rest:  [4031]u8;
}

#[testing]
#[volatile]
rec MultiplePageStorage {
    first: u8;
    rest:  [8127]u8;
}

#[testing]
#[noinline]
fun bare_page_recurse(n: i32) i32 {
    if (n == -1234567) {
        var cold: BarePageStorage;
        cold.first = 1;
        ret cold.first::i32;
    }
    if (n <= 0) { ret 7; }
    val x: i32 = bare_page_recurse(n - 1);
    ret x + 1;
}

#[testing]
#[noinline]
fun page_multiple_recurse(n: i32) i32 {
    if (n == -1234567) {
        var cold: MultiplePageStorage;
        cold.first = 1;
        ret cold.first::i32;
    }
    if (n <= 0) { ret 11; }
    val x: i32 = page_multiple_recurse(n - 1);
    ret x + 1;
}

#[testing]
#[noinline]
fun deep_wide_recurse(n: i32, seed: u8) u8 {
    var buf: [24576]u8;
    buf[24575] = seed;
    buf[0]     = n::u8;
    if (n <= 0) { ret buf[0] + buf[24575]; }
    val r: u8 = deep_wide_recurse(n - 1, seed + 1);
    ret r + buf[0];
}

#[testing]
rec Desc {
    a: i64;
    b: i32;
}

#[testing]
#[noinline]
fun make_desc() Desc {
    var d: Desc;
    d.a = 77;
    d.b = 3;
    ret d;
}

#[testing]
#[noinline]
fun saved_frame_recurse(n: i32, acc: i64) i64 {
    var buf: [8100]u8;
    buf[8099] = n::u8;
    val d: Desc = make_desc();
    if (n <= 0) { ret acc + d.a + buf[8099]::i64; }
    val r: i64 = saved_frame_recurse(n - 1, acc + d.b::i64);
    ret r + buf[8099]::i64;
}

test bare_page_recurse__swept_alignment {
    if (bare_page_recurse(300) != 307) { ret 1; }
    ret 0;
}

test page_multiple_recurse__swept_alignment {
    if (page_multiple_recurse(300) != 311) { ret 1; }
    ret 0;
}

test deep_wide_recurse__page_walk_at_depth {
    if (deep_wide_recurse(64, 1) != 97) { ret 1; }
    ret 0;
}

test saved_frame_recurse__sret_at_swept_alignment {
    if (saved_frame_recurse(300, 0) != 34607) { ret 1; }
    ret 0;
}
