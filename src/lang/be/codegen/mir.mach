val UNKNOWN_MIR_DESCRIPTOR: MirOpDescriptor = MirOpDescriptor{
    op: MIR_OP_NONE, name: "<unknown MIR opcode>", class: SEL_CLASS_NONE,
    flags: MIRF_NONE, ct_class: MCT_NONE, reg_operands: 0, fused_cbr: MIR_OP_NONE,
};

pub fun describe(op: MirOpcode) R.Result[*MirOpDescriptor, str] {
    var i: u32 = 0;
    for (i < SELECTION_CATALOG_COUNT) {
        if (SELECTION_CATALOG[i].op == op) { ret R.ok[*MirOpDescriptor, str](?SELECTION_CATALOG[i]); }
        i = i + 1;
    }
    ret R.err[*MirOpDescriptor, str]("mir: machine opcode has no catalog entry");
}

pub fun desc(op: MirOpcode) *MirOpDescriptor {
    var i: u32 = 0;
    for (i < SELECTION_CATALOG_COUNT) {
        if (SELECTION_CATALOG[i].op == op) { ret ?SELECTION_CATALOG[i]; }
        i = i + 1;
    }
    ret ?UNKNOWN_MIR_DESCRIPTOR;
}

pub fun has(op: MirOpcode, mask: MirFlags) bool {
    ret (desc(op).flags & mask) != 0;
}

pub fun ct_class(op: MirOpcode) MirCtClass {
    ret desc(op).ct_class;
}

pub fun ct_op(op: MirOpcode) R.Result[ct.CtOp, str] {
    val dr: R.Result[*MirOpDescriptor, str] = describe(op);
    if (R.is_err[*MirOpDescriptor, str](dr)) {
        ret R.err[ct.CtOp, str]("mir: opcode is not in the selection catalog, so its constant-time class is undeclared");
    }
    val c: MirCtClass = R.unwrap_ok[*MirOpDescriptor, str](dr).ct_class;
    if (c == MCT_INT_MUL)    { ret R.ok[ct.CtOp, str](ct.CT_OP_INT_MUL); }
    if (c == MCT_INT_DIVMOD) { ret R.ok[ct.CtOp, str](ct.CT_OP_INT_DIVMOD); }
    if (c == MCT_VAR_SHIFT)  { ret R.ok[ct.CtOp, str](ct.CT_OP_VAR_SHIFT); }
    if (c == MCT_FLOAT)      { ret R.ok[ct.CtOp, str](ct.CT_OP_FLOAT); }
    if (c == MCT_NONE)       { ret R.ok[ct.CtOp, str](ct.CT_OP_NONE); }
    ret R.err[ct.CtOp, str]("mir: catalog constant-time class has no validator mapping");
}

pub fun is_terminator(op: MirOpcode) bool {
    ret has(op, MIRF_TERMINATOR);
}


fun selection_class(op: MirOpcode) SelectionClass {
    ret desc(op).class;
}

fun selection_class_out(class: SelectionClass, out: *u32) {
    var i: u32 = 0;
    var n: u32 = 0;
    for (i < SELECTION_CATALOG_COUNT) {
        if (SELECTION_CATALOG[i].class == class) { out[n] = SELECTION_CATALOG[i].op; n = n + 1; }
        i = i + 1;
    }
}

pub val SELECTION_REACHABLE_COUNT:       u32 = 46;
pub val SELECTION_REACHABLE_FLOAT_COUNT: u32 = 6;
pub val SELECTION_ELIMINATED_COUNT:      u32 = 5;
pub val SELECTION_FUSED_COUNT:           u32 = 6;
pub val SELECTION_LANE_COUNT:            u32 = 2;
pub val SELECTION_WIDENING_MUL_COUNT:    u32 = 1;

pub fun selection_reachable(out: *u32) {
    selection_class_out(SEL_CLASS_REACHABLE, out);
}

pub fun selection_reachable_float(out: *u32) {
    selection_class_out(SEL_CLASS_REACHABLE_FLOAT, out);
}

pub fun selection_eliminated(out: *u32) {
    selection_class_out(SEL_CLASS_ELIMINATED, out);
}

pub fun selection_lane(out: *u32) {
    selection_class_out(SEL_CLASS_LANE, out);
}

pub fun selection_widening_mul(out: *u32) {
    selection_class_out(SEL_CLASS_WIDENING_MUL, out);
}

pub fun selection_fused(out: *u32) {
    selection_class_out(SEL_CLASS_FUSED, out);
}

