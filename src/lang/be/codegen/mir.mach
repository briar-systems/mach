pub val INITIAL_SLOT_CAP:  u32 = 8;

pub fun emits_instr(f: *MirFunction, mi: *MirInstr) bool {
    if (!f.naked) { ret true; }
    ret mi.asm_block != nil;
}

pub fun op_vreg(vreg: u32) MirOperand {
    var o: MirOperand;
    o.kind          = MIR_OP_VREG;
    o.vreg          = vreg;
    o.preg          = 0;
    o.imm           = 0;
    o.sym           = intern.STR_NIL;
    o.sym_off       = 0;
    o.index         = MIR_VREG_NIL;
    o.scale         = 0;
    o.index_is_preg = false;
    o.sym_got       = false;
    ret o;
}

pub fun op_preg(preg: u32) MirOperand {
    var o: MirOperand;
    o.kind          = MIR_OP_PREG;
    o.vreg          = MIR_VREG_NIL;
    o.preg          = preg;
    o.imm           = 0;
    o.sym           = intern.STR_NIL;
    o.sym_off       = 0;
    o.index         = MIR_VREG_NIL;
    o.scale         = 0;
    o.index_is_preg = false;
    o.sym_got       = false;
    ret o;
}

pub fun op_imm(imm: i64) MirOperand {
    var o: MirOperand;
    o.kind          = MIR_OP_IMM;
    o.vreg          = MIR_VREG_NIL;
    o.preg          = 0;
    o.imm           = imm;
    o.sym           = intern.STR_NIL;
    o.sym_off       = 0;
    o.index         = MIR_VREG_NIL;
    o.scale         = 0;
    o.index_is_preg = false;
    o.sym_got       = false;
    ret o;
}

pub fun op_mem_slot(slotkey: u32, disp: i64) MirOperand {
    var o: MirOperand;
    o.kind          = MIR_OP_MEM;
    o.vreg          = slotkey;
    o.preg          = 0;
    o.imm           = disp;
    o.sym           = intern.STR_NIL;
    o.sym_off       = 0;
    o.index         = MIR_VREG_NIL;
    o.scale         = 0;
    o.index_is_preg = false;
    o.sym_got       = false;
    ret o;
}

pub fun op_mem_preg(preg: u32, disp: i64) MirOperand {
    var o: MirOperand;
    o.kind          = MIR_OP_MEM;
    o.vreg          = MIR_VREG_NIL;
    o.preg          = preg;
    o.imm           = disp;
    o.sym           = intern.STR_NIL;
    o.sym_off       = 0;
    o.index         = MIR_VREG_NIL;
    o.scale         = 0;
    o.index_is_preg = false;
    o.sym_got       = false;
    ret o;
}

pub fun op_mem_value(base: u32, disp: i64) MirOperand {
    var o: MirOperand;
    o.kind          = MIR_OP_MEM;
    o.vreg          = base;
    o.preg          = 0;
    o.imm           = disp;
    o.sym           = intern.STR_NIL;
    o.sym_off       = 0;
    o.index         = MIR_VREG_NIL;
    o.scale         = 0;
    o.index_is_preg = false;
    o.sym_got       = false;
    ret o;
}

pub fun op_sym(sym: intern.StrId, sym_off: i32) MirOperand {
    var o: MirOperand;
    o.kind          = MIR_OP_SYM;
    o.vreg          = MIR_VREG_NIL;
    o.preg          = 0;
    o.imm           = 0;
    o.sym           = sym;
    o.sym_off       = sym_off;
    o.index         = MIR_VREG_NIL;
    o.scale         = 0;
    o.index_is_preg = false;
    o.sym_got       = false;
    ret o;
}

pub fun op_block(block: u32) MirOperand {
    var o: MirOperand;
    o.kind          = MIR_OP_BLOCK;
    o.vreg          = MIR_VREG_NIL;
    o.preg          = 0;
    o.imm           = block::i64;
    o.sym           = intern.STR_NIL;
    o.sym_off       = 0;
    o.index         = MIR_VREG_NIL;
    o.scale         = 0;
    o.index_is_preg = false;
    o.sym_got       = false;
    ret o;
}

pub fun vreg_is_fp(fn: *MirFunction, vreg: u32) bool {
    if (vreg >= fn.vreg_count) { ret false; }
    ret fn.vregs[vreg].class != REG_CLASS_GP;
}

pub fun push_function(mm: *MirModule, mf: MirFunction) R.Result[R.Void, str] {
    if (mm.function_len == mm.function_cap) {
        var new_cap: u32 = mm.function_cap * 2;

        if (new_cap == 0) { new_cap = INITIAL_FN_CAP; }

        if (mm.functions == nil) {
            val res_alloc: R.Result[*MirFunction, str] = A.allocate[MirFunction](mm.alloc, new_cap::usize);
            if (R.is_err[*MirFunction, str](res_alloc)) {
                ret R.err[R.Void, str](R.unwrap_err[*MirFunction, str](res_alloc));
            }
            mm.functions = R.unwrap_ok[*MirFunction, str](res_alloc);
        }
        or {
            val res_realloc: R.Result[*MirFunction, str] = A.reallocate[MirFunction](mm.alloc, mm.functions, mm.function_cap::usize, new_cap::usize);
            if (R.is_err[*MirFunction, str](res_realloc)) {
                ret R.err[R.Void, str](R.unwrap_err[*MirFunction, str](res_realloc));
            }
            mm.functions = R.unwrap_ok[*MirFunction, str](res_realloc);
        }

        mm.function_cap = new_cap;
    }

    mm.functions[mm.function_len] = mf;
    mm.function_len = mm.function_len + 1;
    ret R.ok_void[str]();
}

pub fun instr_attach_dbg(a: *A.Allocator, mi: *MirInstr, iid: u32, vreg: u32) R.Result[R.Void, str] {
    val n: u32 = mi.dbg_binding_count;
    if (mi.dbg_bindings == nil) {
        val ra: R.Result[*MirDbgBinding, str] = A.allocate[MirDbgBinding](a, 1::usize);
        if (R.is_err[*MirDbgBinding, str](ra)) { ret R.err[R.Void, str](R.unwrap_err[*MirDbgBinding, str](ra)); }
        mi.dbg_bindings = R.unwrap_ok[*MirDbgBinding, str](ra);
    }
    or {
        val rr: R.Result[*MirDbgBinding, str] = A.reallocate[MirDbgBinding](a, mi.dbg_bindings, n::usize, (n + 1)::usize);
        if (R.is_err[*MirDbgBinding, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[*MirDbgBinding, str](rr)); }
        mi.dbg_bindings = R.unwrap_ok[*MirDbgBinding, str](rr);
    }
    mi.dbg_bindings[n].iid  = iid;
    mi.dbg_bindings[n].vreg = vreg;
    mi.dbg_bindings[n].cmp_op     = 0;
    mi.dbg_bindings[n].cmp_width  = 0;
    mi.dbg_bindings[n].lhs_is_imm = false;
    mi.dbg_bindings[n].rhs_is_imm = false;
    mi.dbg_bindings[n].vreg2      = MIR_VREG_NIL;
    mi.dbg_bindings[n].imm        = 0;
    mi.dbg_bindings[n].imm2       = 0;
    mi.dbg_binding_count = n + 1;
    ret R.ok_void[str]();
}

pub fun dnit_module(mm: *MirModule) {
    if (mm == nil) { ret; }

    var i: u32 = 0;
    for (i < mm.function_len) {
        dnit_function(mm.alloc, ?mm.functions[i]);
        i = i + 1;
    }
    if (mm.functions != nil && mm.function_cap > 0) {
        A.deallocate[MirFunction](mm.alloc, mm.functions, mm.function_cap::usize);
    }

    mm.functions    = nil;
    mm.function_len = 0;
    mm.function_cap = 0;
}

pub fun dnit_function(a: *A.Allocator, mf: *MirFunction) {
    var i: u32 = 0;
    for (i < mf.block_count) {
        dnit_block(a, ?mf.blocks[i]);
        i = i + 1;
    }
    if (mf.blocks != nil && mf.block_cap > 0) {
        A.deallocate[MirBlock](a, mf.blocks, mf.block_cap::usize);
    }
    if (mf.emit_order != nil) {
        A.deallocate[u32](a, mf.emit_order, mf.block_count::usize);
    }
    if (mf.vregs != nil && mf.vreg_cap > 0) {
        A.deallocate[MirVReg](a, mf.vregs, mf.vreg_cap::usize);
    }
    if (mf.frame.slots != nil && mf.frame.slot_cap > 0) {
        A.deallocate[MirSlot](a, mf.frame.slots, mf.frame.slot_cap::usize);
    }

    mf.blocks        = nil;
    mf.block_count   = 0;
    mf.block_cap     = 0;
    mf.emit_order    = nil;
    mf.vregs         = nil;
    mf.vreg_count    = 0;
    mf.vreg_cap      = 0;
}

pub fun dnit_block(a: *A.Allocator, mb: *MirBlock) {
    var i: u32 = 0;
    for (i < mb.instr_count) {
        val mi: *MirInstr = ?mb.instrs[i];
        if (mi.operands != nil && mi.operand_count > 0) {
            A.deallocate[MirOperand](a, mi.operands, mi.operand_count::usize);
        }
        if (mi.dbg_bindings != nil && mi.dbg_binding_count > 0) {
            A.deallocate[MirDbgBinding](a, mi.dbg_bindings, mi.dbg_binding_count::usize);
        }
        if (mi.opcode == MIR_ASM && mi.asm_block != nil) {
            if (mi.asm_block.binds != nil && mi.asm_block.bind_count > 0) {
                A.deallocate[MirAsmBind](a, mi.asm_block.binds, mi.asm_block.bind_count::usize);
            }
            A.deallocate[MirAsm](a, mi.asm_block, 1::usize);
        }
        i = i + 1;
    }
    if (mb.instrs != nil && mb.instr_cap > 0) {
        A.deallocate[MirInstr](a, mb.instrs, mb.instr_cap::usize);
    }
    if (mb.preds != nil && mb.pred_cap > 0) {
        A.deallocate[u32](a, mb.preds, mb.pred_cap::usize);
    }
}

test "mach.lang.be.codegen.mir.fused_cbr:mapping" {
    if (fused_cbr_opcode(MIR_CMP_EQ)   != MIR_SEL_CBR_EQ)   { ret 1; }
    if (fused_cbr_opcode(MIR_CMP_NE)   != MIR_SEL_CBR_NE)   { ret 1; }
    if (fused_cbr_opcode(MIR_CMP_LT_S) != MIR_SEL_CBR_LT_S) { ret 1; }
    if (fused_cbr_opcode(MIR_CMP_LT_U) != MIR_SEL_CBR_LT_U) { ret 1; }
    if (fused_cbr_opcode(MIR_CMP_LE_S) != MIR_SEL_CBR_LE_S) { ret 1; }
    if (fused_cbr_opcode(MIR_CMP_LE_U) != MIR_SEL_CBR_LE_U) { ret 1; }

    if (!is_cmp_opcode(MIR_CMP_EQ))   { ret 1; }
    if (!is_cmp_opcode(MIR_CMP_LE_U)) { ret 1; }
    if (is_cmp_opcode(MIR_NOT))       { ret 1; }
    if (is_cmp_opcode(MIR_TRUNC))     { ret 1; }

    if (!is_fused_cbr(MIR_SEL_CBR_EQ))   { ret 1; }
    if (!is_fused_cbr(MIR_SEL_CBR_LE_U)) { ret 1; }
    if (is_fused_cbr(MIR_SEL_CBR))       { ret 1; }
    if (is_fused_cbr(0x111F))            { ret 1; }
    if (is_fused_cbr(0x1126))            { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.mir.vec_lane:pack_unpack" {
    if (vec_lane_is_vector(VEC_LANE_NONE))  { ret 1; }
    if (vec_lane_count(VEC_LANE_NONE) != 0) { ret 1; }

    val f4: u32 = vec_lane_make(VEC_LANE_FLOAT, 4, 4);
    if (!vec_lane_is_vector(f4))             { ret 1; }
    if (vec_lane_kind(f4) != VEC_LANE_FLOAT) { ret 1; }
    if (vec_lane_elem_bytes(f4) != 4)        { ret 1; }
    if (vec_lane_count(f4) != 4)             { ret 1; }

    val f3: u32 = vec_lane_make(VEC_LANE_FLOAT, 4, 3);
    if (vec_lane_kind(f3) != VEC_LANE_FLOAT) { ret 1; }
    if (vec_lane_elem_bytes(f3) != 4)        { ret 1; }
    if (vec_lane_count(f3) != 3)             { ret 1; }
    if (vec_lane_count(vec_lane_make(VEC_LANE_FLOAT, 4, 2)) != 2) { ret 1; }
    if (f3 == f4)                            { ret 1; }

    if (vec_lane_count(vec_lane_make(VEC_LANE_FLOAT, 8, 2)) != 2)  { ret 1; }
    if (vec_lane_count(vec_lane_make(VEC_LANE_INT, 1, 16)) != 16) { ret 1; }
    if (vec_lane_count(vec_lane_make(VEC_LANE_INT, 2, 8))  != 8)  { ret 1; }
    if (vec_lane_count(vec_lane_make(VEC_LANE_INT, 4, 4))  != 4)  { ret 1; }
    if (vec_lane_count(vec_lane_make(VEC_LANE_INT, 8, 2))  != 2)  { ret 1; }

    val f32x1024: u32 = vec_lane_make(VEC_LANE_FLOAT, 4, 1024);
    if (vec_lane_count(f32x1024) != 1024)          { ret 1; }
    if (vec_lane_elem_bytes(f32x1024) != 4)        { ret 1; }
    if (vec_lane_kind(f32x1024) != VEC_LANE_FLOAT) { ret 1; }
    if (vec_lane_count(vec_lane_make(VEC_LANE_INT, 8, VEC_LANE_MAX_LANES)) != VEC_LANE_MAX_LANES) { ret 1; }

    val i2: u32 = vec_lane_make(VEC_LANE_INT, 2, 5);
    if (vec_lane_kind(i2) != VEC_LANE_INT) { ret 1; }
    if (vec_lane_elem_bytes(i2) != 2)      { ret 1; }
    if (vec_lane_count(i2) != 5)           { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.mir.instr:clears_the_metadata" {
    var ops: [2]MirOperand;
    val mi: MirInstr = instr(MIR_MOV, ?ops[0], 2, 8, 4);

    if (mi.opcode != MIR_MOV)      { ret 1; }
    if (mi.operands != ?ops[0])    { ret 1; }
    if (mi.operand_count != 2)     { ret 1; }
    if (mi.width != 8)             { ret 1; }
    if (mi.src_width != 4)         { ret 1; }

    if (mi.asm_block != nil)         { ret 1; }
    if (mi.dbg_bindings != nil)      { ret 1; }
    if (mi.dbg_binding_count != 0)   { ret 1; }
    if (mi.inline_site != 0)         { ret 1; }
    if (mi.vec_lane != VEC_LANE_NONE) { ret 1; }
    if (mi.writes_secret)            { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.mir.instr_like:carries_every_field" {
    var src: MirInstr = instr(MIR_ADD, nil, 0, 0, 0);
    var out: MirInstr = instr(MIR_ADD, nil, 0, 0, 0);
    memory.raw_fill((?src)::ptr, 0xA5, $size_of(MirInstr));
    memory.raw_fill((?out)::ptr, 0xA5, $size_of(MirInstr));

    out = instr_like(?src, src.operands, src.operand_count);
    if (!memory.equal[MirInstr](?out, ?src, 1)) { ret 1; }

    var ops: [3]MirOperand;
    val moved: MirInstr = instr_like(?src, ?ops[0], 3);
    if (moved.operands != ?ops[0]) { ret 1; }
    if (moved.operand_count != 3)  { ret 1; }
    if (moved.opcode != src.opcode)     { ret 1; }
    if (moved.vec_lane != src.vec_lane) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.mir.opcode_name:total_and_distinct" {
    var ops: [89]MirOpcode;
    ops[0]  = MIR_ADD;         ops[1]  = MIR_SUB;         ops[2]  = MIR_MUL;
    ops[3]  = MIR_DIV_S;       ops[4]  = MIR_DIV_U;       ops[5]  = MIR_REM_S;
    ops[6]  = MIR_REM_U;       ops[7]  = MIR_NEG;         ops[8]  = MIR_AND;
    ops[9]  = MIR_OR;          ops[10] = MIR_XOR;         ops[11] = MIR_SHL;
    ops[12] = MIR_SHR_S;       ops[13] = MIR_SHR_U;       ops[14] = MIR_NOT;
    ops[15] = MIR_CMP_EQ;      ops[16] = MIR_CMP_NE;      ops[17] = MIR_CMP_LT_S;
    ops[18] = MIR_CMP_LT_U;    ops[19] = MIR_CMP_LE_S;    ops[20] = MIR_CMP_LE_U;
    ops[21] = MIR_TRUNC;       ops[22] = MIR_SEXT;        ops[23] = MIR_ZEXT;
    ops[24] = MIR_FP_TRUNC;    ops[25] = MIR_FP_EXT;      ops[26] = MIR_FP_TO_SI;
    ops[27] = MIR_FP_TO_UI;    ops[28] = MIR_SI_TO_FP;    ops[29] = MIR_UI_TO_FP;
    ops[30] = MIR_BITCAST;     ops[31] = MIR_ALLOCA;      ops[32] = MIR_LOAD;
    ops[33] = MIR_STORE;       ops[34] = MIR_GEP;         ops[35] = MIR_EXTRACT;
    ops[36] = MIR_INSERT;      ops[37] = MIR_PHI;         ops[38] = MIR_CALL_IR;
    ops[39] = MIR_BR;          ops[40] = MIR_CBR;         ops[41] = MIR_RET;
    ops[42] = MIR_UNREACHABLE; ops[43] = MIR_ASM;         ops[44] = MIR_MOV;
    ops[45] = MIR_ARG;         ops[46] = MIR_CALL;        ops[47] = MIR_CALL_RES;
    ops[48] = MIR_DECLASSIFY;  ops[49] = MIR_VEC_EXTRACT; ops[50] = MIR_VEC_INSERT;
    ops[51] = MIR_SEL_ADD;     ops[52] = MIR_SEL_SUB;     ops[53] = MIR_SEL_MUL;
    ops[54] = MIR_SEL_AND;     ops[55] = MIR_SEL_OR;      ops[56] = MIR_SEL_XOR;
    ops[57] = MIR_SEL_SHL;     ops[58] = MIR_SEL_SHR_U;   ops[59] = MIR_SEL_SHR_S;
    ops[60] = MIR_SEL_DIV_S;   ops[61] = MIR_SEL_DIV_U;   ops[62] = MIR_SEL_REM_S;
    ops[63] = MIR_SEL_REM_U;   ops[64] = MIR_SEL_CMP_EQ;  ops[65] = MIR_SEL_CMP_NE;
    ops[66] = MIR_SEL_CMP_LT_S; ops[67] = MIR_SEL_CMP_LT_U; ops[68] = MIR_SEL_CMP_LE_S;
    ops[69] = MIR_SEL_CMP_LE_U; ops[70] = MIR_SEL_CBR;    ops[71] = MIR_SEL_CBR_EQ;
    ops[72] = MIR_SEL_CBR_NE;  ops[73] = MIR_SEL_CBR_LT_S; ops[74] = MIR_SEL_CBR_LT_U;
    ops[75] = MIR_SEL_CBR_LE_S; ops[76] = MIR_SEL_CBR_LE_U; ops[77] = MIR_FADD;
    ops[78] = MIR_FSUB;        ops[79] = MIR_FMUL;        ops[80] = MIR_FDIV;
    ops[81] = MIR_FCMP;        ops[82] = MIR_FNEG;
    ops[83] = MIR_VEC_BUILD;   ops[84] = MIR_MUL_HI_U;
    ops[85] = MIR_MEMZERO;     ops[86] = MIR_MEMCPY;
    ops[87] = MIR_AGG_LOAD;    ops[88] = MIR_AGG_STORE;

    var i: usize = 0;
    for (i < 89) {
        val n: str = opcode_name(ops[i]);
        if (str_equals(n, "<unknown MIR opcode>")) { ret 1; }
        var j: usize = 0;
        for (j < i) {
            if (str_equals(opcode_name(ops[j]), n)) { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }

    if (!str_equals(opcode_name(MIR_DIV_S), "MIR_DIV_S")) { ret 1; }
    if (!str_equals(opcode_name(MIR_VEC_INSERT), "MIR_VEC_INSERT")) { ret 1; }

    if (!str_equals(opcode_name(0xDEAD::MirOpcode), "<unknown MIR opcode>")) { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.mir.selection_class:partition_is_disjoint_and_exhaustive" {
    if (SELECTION_CATALOG_COUNT != 89) { ret 1; }

    var i: u32 = 0;
    for (i < SELECTION_CATALOG_COUNT) {
        val op: MirOpcode = SELECTION_CATALOG[i].op;
        if (str_equals(opcode_name(op), "<unknown MIR opcode>")) { ret 1; }
        if (selection_class(op) != SELECTION_CATALOG[i].class)   { ret 1; }
        if (is_fused_cbr(op) != (SELECTION_CATALOG[i].class == SEL_CLASS_FUSED)) { ret 1; }

        var j: u32 = 0;
        for (j < i) {
            if (SELECTION_CATALOG[j].op == op) { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }

    if (selection_class(0xDEAD::MirOpcode) != SEL_CLASS_NONE) { ret 1; }

    var reachable_count:       u32 = 0;
    var reachable_float_count: u32 = 0;
    var eliminated_count:      u32 = 0;
    var lane_count:            u32 = 0;
    var widening_mul_count:    u32 = 0;
    var fused_count:           u32 = 0;
    var sel_output_count:      u32 = 0;
    var spirv_only_count:      u32 = 0;

    i = 0;
    for (i < SELECTION_CATALOG_COUNT) {
        val class: SelectionClass = SELECTION_CATALOG[i].class;
        if (class == SEL_CLASS_REACHABLE)       { reachable_count       = reachable_count + 1; }
        or (class == SEL_CLASS_REACHABLE_FLOAT) { reachable_float_count = reachable_float_count + 1; }
        or (class == SEL_CLASS_ELIMINATED)      { eliminated_count      = eliminated_count + 1; }
        or (class == SEL_CLASS_LANE)            { lane_count            = lane_count + 1; }
        or (class == SEL_CLASS_WIDENING_MUL)    { widening_mul_count    = widening_mul_count + 1; }
        or (class == SEL_CLASS_FUSED)           { fused_count           = fused_count + 1; }
        or (class == SEL_CLASS_SEL_OUTPUT)      { sel_output_count      = sel_output_count + 1; }
        or (class == SEL_CLASS_SPIRV_ONLY)      { spirv_only_count      = spirv_only_count + 1; }
        or { ret 1; }
        i = i + 1;
    }

    if (reachable_count       != SELECTION_REACHABLE_COUNT)       { ret 1; }
    if (reachable_float_count != SELECTION_REACHABLE_FLOAT_COUNT) { ret 1; }
    if (eliminated_count      != SELECTION_ELIMINATED_COUNT)      { ret 1; }
    if (lane_count            != SELECTION_LANE_COUNT)            { ret 1; }
    if (widening_mul_count    != SELECTION_WIDENING_MUL_COUNT)    { ret 1; }
    if (fused_count           != SELECTION_FUSED_COUNT)           { ret 1; }

    val total: u32 = reachable_count + reachable_float_count + eliminated_count +
                     lane_count + widening_mul_count + fused_count +
                     sel_output_count + spirv_only_count;
    if (total != SELECTION_CATALOG_COUNT) { ret 1; }

    var buf: [46]u32;
    selection_reachable(?buf[0]);
    i = 0;
    for (i < SELECTION_REACHABLE_COUNT) {
        if (selection_class(buf[i]) != SEL_CLASS_REACHABLE) { ret 1; }
        i = i + 1;
    }

    selection_reachable_float(?buf[0]);
    i = 0;
    for (i < SELECTION_REACHABLE_FLOAT_COUNT) {
        if (selection_class(buf[i]) != SEL_CLASS_REACHABLE_FLOAT) { ret 1; }
        i = i + 1;
    }

    selection_eliminated(?buf[0]);
    i = 0;
    for (i < SELECTION_ELIMINATED_COUNT) {
        if (selection_class(buf[i]) != SEL_CLASS_ELIMINATED) { ret 1; }
        i = i + 1;
    }

    selection_lane(?buf[0]);
    i = 0;
    for (i < SELECTION_LANE_COUNT) {
        if (selection_class(buf[i]) != SEL_CLASS_LANE) { ret 1; }
        i = i + 1;
    }

    selection_widening_mul(?buf[0]);
    i = 0;
    for (i < SELECTION_WIDENING_MUL_COUNT) {
        if (selection_class(buf[i]) != SEL_CLASS_WIDENING_MUL) { ret 1; }
        i = i + 1;
    }

    selection_fused(?buf[0]);
    i = 0;
    for (i < SELECTION_FUSED_COUNT) {
        if (selection_class(buf[i]) != SEL_CLASS_FUSED) { ret 1; }
        i = i + 1;
    }

    ret 0;
}

test "mach.lang.be.codegen.mir.instr_refusal:names_opcode_and_function" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var mi: MirInstr = instr(MIR_ALLOCA, nil, 0, 0, 0);
    val msg: str = instr_refusal(?alloc, nil::*source.SourceMap, "sum_pair", ?mi,
                                 "addressed memory is not yet supported");
    if (!str_contains(msg, "addressed memory is not yet supported")) { ret 1; }
    if (!str_contains(msg, "MIR_ALLOCA"))  { ret 1; }
    if (!str_contains(msg, "sum_pair"))    { ret 1; }
    if (!str_contains(msg, "no source location on this instruction")) { ret 1; }

    val fn_only: str = instr_refusal(?alloc, nil::*source.SourceMap, "sum_pair",
                                     nil::*MirInstr, "more than 16 parameters");
    if (!str_contains(fn_only, "more than 16 parameters")) { ret 1; }
    if (!str_contains(fn_only, "sum_pair"))                { ret 1; }
    if (str_contains(fn_only, "MIR_"))                     { ret 1; }
    ret 0;
}

test "mach.lang.be.codegen.mir:catalog_flags_are_internally_consistent" {
    var i: u32 = 0;
    for (i < SELECTION_CATALOG_COUNT) {
        val d: *MirOpDescriptor = ?SELECTION_CATALOG[i];
        val f: MirFlags = d.flags;
        i = i + 1;

        if ((f & MIRF_CMP_EQUALITY) != 0 && (f & MIRF_COMPARE) == 0) { ret 1; }
        if ((f & MIRF_CMP_SIGNED) != 0   && (f & MIRF_COMPARE) == 0) { ret 1; }
        if ((f & MIRF_CMP_LE) != 0       && (f & MIRF_COMPARE) == 0) { ret 1; }
        if ((f & MIRF_DIV_SIGNED) != 0
            && (f & (MIRF_DIVIDE | MIRF_REMAINDER)) == 0)            { ret 1; }
        if ((f & MIRF_CONV_TO_FLOAT) != 0   && (f & MIRF_INT_FP_CONV) == 0) { ret 1; }
        if ((f & MIRF_CONV_FROM_FLOAT) != 0 && (f & MIRF_INT_FP_CONV) == 0) { ret 1; }
        if ((f & MIRF_CONV_TO_FLOAT) != 0 && (f & MIRF_CONV_FROM_FLOAT) != 0) { ret 1; }
        if ((f & MIRF_INT_FP_CONV) != 0
            && (f & (MIRF_CONV_TO_FLOAT | MIRF_CONV_FROM_FLOAT)) == 0) { ret 1; }
        if ((f & (MIRF_SHIFT | MIRF_SEL_SHIFT)) != 0 && d.ct_class != MCT_VAR_SHIFT) { ret 1; }
        if (d.ct_class == MCT_VAR_SHIFT && (f & (MIRF_SHIFT | MIRF_SEL_SHIFT)) == 0)  { ret 1; }
        if ((f & (MIRF_DIVIDE | MIRF_REMAINDER | MIRF_SEL_DIVIDE)) != 0
            && d.ct_class != MCT_INT_DIVMOD)                                            { ret 1; }
        if (d.ct_class == MCT_INT_DIVMOD
            && (f & (MIRF_DIVIDE | MIRF_REMAINDER | MIRF_SEL_DIVIDE)) == 0)            { ret 1; }
        if (d.reg_operands != 0 && (f & MIRF_CONV_TO_FLOAT) == 0)     { ret 1; }
        if ((f & MIRF_FUSED_CBR) != 0 && d.class != SEL_CLASS_FUSED)  { ret 1; }

        if ((f & MIRF_COMPARE) != 0) {
            if (d.fused_cbr == MIR_OP_NONE)         { ret 1; }
            if (!has(d.fused_cbr, MIRF_FUSED_CBR))  { ret 1; }
        }
        or {
            if (d.fused_cbr != MIR_OP_NONE) { ret 1; }
        }
    }
    ret 0;
}

test "mach.lang.be.codegen.mir:catalog_pins_the_predicates_it_absorbed" {
    if (!is_terminator(MIR_BR) || !is_terminator(MIR_CBR))          { ret 1; }
    if (!is_terminator(MIR_RET) || !is_terminator(MIR_UNREACHABLE)) { ret 1; }
    if (is_terminator(MIR_ADD) || is_terminator(MIR_SEL_CBR))       { ret 1; }
    if (is_terminator(0xDEAD::MirOpcode))                           { ret 1; }

    if (!has(MIR_ADD, MIRF_CLONABLE) || !has(MIR_BITCAST, MIRF_CLONABLE)) { ret 1; }
    if (!has(MIR_LOAD, MIRF_CLONABLE) || !has(MIR_GEP, MIRF_CLONABLE))    { ret 1; }
    if (!has(MIR_MOV, MIRF_CLONABLE))                                     { ret 1; }
    if (has(MIR_ALLOCA, MIRF_CLONABLE) || has(MIR_STORE, MIRF_CLONABLE))  { ret 1; }
    if (has(MIR_CALL, MIRF_CLONABLE) || has(MIR_PHI, MIRF_CLONABLE))      { ret 1; }

    if (!has(MIR_SEL_ADD, MIRF_TWO_ADDRESS) || !has(MIR_SEL_SHR_S, MIRF_TWO_ADDRESS)) { ret 1; }
    if (has(MIR_SEL_DIV_S, MIRF_TWO_ADDRESS) || has(MIR_ADD, MIRF_TWO_ADDRESS))       { ret 1; }

    if (!operand_requires_reg(MIR_SI_TO_FP, 1) || !operand_requires_reg(MIR_UI_TO_FP, 1)) { ret 1; }
    if (operand_requires_reg(MIR_SI_TO_FP, 0) || operand_requires_reg(MIR_ADD, 1))        { ret 1; }

    if (ct_class(MIR_MUL) != MCT_INT_MUL)       { ret 1; }
    if (ct_class(MIR_REM_U) != MCT_INT_DIVMOD)  { ret 1; }
    if (ct_class(MIR_SHR_S) != MCT_VAR_SHIFT)   { ret 1; }
    if (ct_class(MIR_FCMP) != MCT_FLOAT)        { ret 1; }
    if (ct_class(MIR_FP_EXT) != MCT_FLOAT)      { ret 1; }
    if (ct_class(MIR_ADD) != MCT_NONE)          { ret 1; }
    if (ct_class(0xDEAD::MirOpcode) != MCT_NONE) { ret 1; }

    if (R.is_err[*MirOpDescriptor, str](describe(MIR_ADD)))         { ret 1; }
    if (R.is_ok[*MirOpDescriptor, str](describe(0xDEAD::MirOpcode))) { ret 1; }
    ret 0;
}
