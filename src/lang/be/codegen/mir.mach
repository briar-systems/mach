}

pub rec MirVReg {
    id:         u32;
    class:      u32;
    spill_slot: i32;
    assigned:   u32;
    ty:         u32;
    vector:     bool;
    secret:     bool;
}

pub val VREG_TY_NIL: u32 = 0xFFFFFFFF;

pub fun vreg(id: u32, class: u32, vector: bool, secret: bool) MirVReg {
    var v: MirVReg;
    v.id         = id;
    v.class      = class;
    v.spill_slot = -1;
    v.assigned   = MIR_VREG_NIL;
    v.ty         = VREG_TY_NIL;
    v.vector     = vector;
    v.secret     = secret;
    ret v;
}

test "mach.lang.be.codegen.mir.vreg:sets_every_field" {
    val v: MirVReg = vreg(7, 3, true, true);
    if (v.id != 7)                  { ret 1; }
    if (v.class != 3)               { ret 1; }
    if (v.spill_slot != -1)         { ret 1; }
    if (v.assigned != MIR_VREG_NIL) { ret 1; }
    if (v.ty != VREG_TY_NIL)        { ret 1; }
    if (!v.vector)                  { ret 1; }
    if (!v.secret)                  { ret 1; }

    val v2: MirVReg = vreg(0, 0, false, false);
    if (v2.vector) { ret 1; }
    if (v2.secret) { ret 1; }
    ret 0;
}

pub def MirSlotKind: u8;

pub val SLOT_ALLOCA: MirSlotKind = 0;
pub val SLOT_SPILL:  MirSlotKind = 1;

