pub rec MirInstr {
    opcode:            MirOpcode;
    operands:          *MirOperand;
    operand_count:     u32;
    width:             u8;
    src_width:         u8;
    asm_block:         *MirAsm;
    loc:               source.SrcLoc;
    dbg_bindings:      *MirDbgBinding;
    dbg_binding_count: u32;
    inline_site:       u32;

    vec_lane:          u32;

    writes_secret:     bool;
    memory_flags:      u8;
}

pub fun instr(opcode: MirOpcode, operands: *MirOperand, operand_count: u32,
              width: u8, src_width: u8) MirInstr {
    var mi: MirInstr;
    mi.opcode        = opcode;
    mi.operands      = operands;
    mi.operand_count = operand_count;
    mi.width         = width;
    mi.src_width     = src_width;
    ret mi;
}

pub fun instr_like(src: *MirInstr, operands: *MirOperand, operand_count: u32) MirInstr {
    var mi: MirInstr = @src;
    mi.operands      = operands;
    mi.operand_count = operand_count;
    ret mi;
}

pub val VEC_LANE_NONE:  u32 = 0;
pub val VEC_LANE_FLOAT: u8  = 1;
pub val VEC_LANE_INT:   u8  = 2;

pub val VEC_LANE_MAX_LANES: u32 = 0xFFFF;

pub fun vec_lane_make(kind: u8, elem_bytes: u8, lanes: u32) u32 {
    ret ((kind & 0xF)::u32 << 24)
      | ((elem_bytes)::u32 << 16)
      | (lanes & VEC_LANE_MAX_LANES);
}

pub fun vec_lane_kind(v: u32) u8 { ret ((v >> 24) & 0xF)::u8; }

pub fun vec_lane_elem_bytes(v: u32) u8 { ret ((v >> 16) & 0xFF)::u8; }

pub fun vec_lane_is_vector(v: u32) bool { ret v != 0; }

pub fun vec_lane_count(v: u32) u32 { ret v & VEC_LANE_MAX_LANES; }

