# the MIR data model shared across the back end
#
# Machine IR (MIR) sits between the target-independent SSA IR
# (`mach.lang.me.ir`) and encoded machine bytes. A MIR instruction carries a
# generic, target-shaped opcode and operates on virtual registers; later
# codegen passes (isel, regalloc, frame, encode) rewrite generic opcodes into
# concrete per-arch forms and resolve virtual registers into physical
# registers and stack slots.
#
# This module is the data model: the operand / instruction / block / vreg /
# slot / frame records, the generic and pseudo opcode space, the `op_*`
# operand constructors, and the module life-cycle (`push_function`,
# `dnit_module`). The IR-to-MIR translation that populates these records lives
# in `mir.lower` (with the ABI and variadic lowering in `mir.abi` / `mir.va`
# and the shared lowering context in `mir.context`).
#
# Generic MIR opcodes mirror the IR `OP_*` values one-for-one (so an IR add
# becomes a generic MIR add with the same number) and add a small block of
# pseudo-opcodes for the lowering-only constructs. Instruction selection
# (`isel`) replaces these generic opcodes with the concrete encoder opcodes
# owned by the active ISA.

use std.allocator.page;
use std.format;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.intern;
use mach.lang.source;

# discriminant selecting which fields of a MirOperand are live
pub def MirOperandKind: u8;

# a virtual register reference; `vreg` indexes `MirFunction.vregs`, resolved by regalloc
pub val MIR_OP_VREG:  MirOperandKind = 0;
# a physical register reference; `preg` is a register id within its RegClass
pub val MIR_OP_PREG:  MirOperandKind = 1;
# an immediate integer constant carried in `imm`
pub val MIR_OP_IMM:   MirOperandKind = 2;
# a memory reference `[base + index*scale + imm]`. the base is disambiguated by
# `vreg`: when `vreg != MIR_VREG_NIL` it is a frame-slot key (a slot-owning vreg
# id the encoder resolves to `[rbp + slot.offset + imm]`); when
# `vreg == MIR_VREG_NIL` it is a physical register base in `preg` (the encoder
# forms `[preg + imm]`). a pre-regalloc value-pointer base rides as a value vreg
# in `vreg` and regalloc rewrites it to the physical-register form
#
# the optional scaled index is the GEP address-folding component: `index` names a
# value vreg (pre-regalloc) or physical register id (`index_is_preg` set, after
# regalloc) holding a runtime index, scaled by `scale` (one of 1/2/4/8 - x86 SIB).
# when `index == MIR_VREG_NIL` there is no index and the form is the plain
# `[base + imm]`. regalloc treats the index like the base: a value vreg is
# rewritten to its physical register (setting `index_is_preg`) and reloaded if
# spilled. an index may ride any base - a physical register, a value-pointer
# base, or a frame-slot-key base (a GEP into an alloca with a runtime index folds
# the scaled index alongside the slot offset, and the encoder forms
# `[rbp + slot.offset + index*scale + imm]` via SIB).
pub val MIR_OP_MEM:   MirOperandKind = 3;
# a symbol reference for a relocation; interned name in `sym`, addend `sym_off`
pub val MIR_OP_SYM:   MirOperandKind = 4;
# a branch-target block reference; target `MirBlock.id` carried in `imm`
pub val MIR_OP_BLOCK: MirOperandKind = 5;

# the generic MIR opcode emitted by `lower_ir` before isel, mirroring IR `OP_*` numbering one-for-one
pub def MirOpcode: u32;

pub val MIR_ADD:         MirOpcode = 0;    # integer / pointer addition
pub val MIR_SUB:         MirOpcode = 1;    # integer / pointer subtraction
pub val MIR_MUL:         MirOpcode = 2;    # integer multiplication
pub val MIR_DIV_S:       MirOpcode = 3;    # signed integer division
pub val MIR_DIV_U:       MirOpcode = 4;    # unsigned integer division
pub val MIR_REM_S:       MirOpcode = 5;    # signed integer remainder
pub val MIR_REM_U:       MirOpcode = 6;    # unsigned integer remainder
pub val MIR_NEG:         MirOpcode = 7;    # integer negation
pub val MIR_AND:         MirOpcode = 8;    # bitwise and
pub val MIR_OR:          MirOpcode = 9;    # bitwise or
pub val MIR_XOR:         MirOpcode = 10;   # bitwise exclusive or
pub val MIR_SHL:         MirOpcode = 11;   # left shift
pub val MIR_SHR_S:       MirOpcode = 12;   # arithmetic (sign-filling) right shift
pub val MIR_SHR_U:       MirOpcode = 13;   # logical (zero-filling) right shift
pub val MIR_NOT:         MirOpcode = 14;   # bitwise complement
pub val MIR_CMP_EQ:      MirOpcode = 15;   # equality comparison
pub val MIR_CMP_NE:      MirOpcode = 16;   # inequality comparison
pub val MIR_CMP_LT_S:    MirOpcode = 17;   # signed less-than comparison
pub val MIR_CMP_LT_U:    MirOpcode = 18;   # unsigned less-than comparison
pub val MIR_CMP_LE_S:    MirOpcode = 19;   # signed less-or-equal comparison
pub val MIR_CMP_LE_U:    MirOpcode = 20;   # unsigned less-or-equal comparison
pub val MIR_TRUNC:       MirOpcode = 21;   # integer truncation to a narrower width
pub val MIR_SEXT:        MirOpcode = 22;   # sign-extension to a wider width
pub val MIR_ZEXT:        MirOpcode = 23;   # zero-extension to a wider width
pub val MIR_FP_TRUNC:    MirOpcode = 24;   # float truncation to a narrower precision
pub val MIR_FP_EXT:      MirOpcode = 25;   # float extension to a wider precision
pub val MIR_FP_TO_SI:    MirOpcode = 26;   # float-to-signed-integer conversion
pub val MIR_FP_TO_UI:    MirOpcode = 27;   # float-to-unsigned-integer conversion
pub val MIR_SI_TO_FP:    MirOpcode = 28;   # signed-integer-to-float conversion
pub val MIR_UI_TO_FP:    MirOpcode = 29;   # unsigned-integer-to-float conversion
pub val MIR_BITCAST:     MirOpcode = 30;   # reinterpret a value's bits as a same-width type
pub val MIR_ALLOCA:      MirOpcode = 31;   # reserve a stack slot and yield its address
pub val MIR_LOAD:        MirOpcode = 32;   # load a value from a memory operand
pub val MIR_STORE:       MirOpcode = 33;   # store a value to a memory operand
pub val MIR_GEP:         MirOpcode = 34;   # compute an element / field address (selects to LEA)
pub val MIR_EXTRACT:     MirOpcode = 35;   # extract a field value from an aggregate
pub val MIR_INSERT:      MirOpcode = 36;   # insert a field value into an aggregate
# an SSA phi; never emitted - `lower_phis` eliminates phis into predecessor-end
# MIR_MOVs, and the encoder rejects any stray MIR_PHI loudly
pub val MIR_PHI:         MirOpcode = 37;
# the IR OP_CALL placeholder; never emitted directly - `lower_ir` expands calls
# into the argument pre-coloring, MIR_CALL, and MIR_CALL_RES
pub val MIR_CALL_IR:     MirOpcode = 38;
pub val MIR_BR:          MirOpcode = 39;   # an unconditional branch to a target block
pub val MIR_CBR:         MirOpcode = 40;   # a conditional branch to one of two target blocks
pub val MIR_RET:         MirOpcode = 41;   # return from the function
pub val MIR_UNREACHABLE: MirOpcode = 42;   # an unreachable terminator
pub val MIR_ASM:         MirOpcode = 43;   # an inline-assembly block

# a register-to-register move pseudo; operands [dst, src]
#
# `lower_ir` emits MIR_MOV both for ordinary vreg copies and for ABI
# pre-coloring: the dst or src is a MIR_OP_PREG naming a physical argument /
# return / hidden-pointer register, and the other operand is the vreg (or an
# immediate, e.g. the fp-arg-count move into AL before a varargs call). isel
# rewrites MIR_MOV to the concrete machine move; regalloc treats a MIR_OP_PREG
# operand as a fixed pre-color it must honor.
pub val MIR_MOV:      MirOpcode = 0x1000;
# a vestigial outgoing-argument marker
#
# `lower_ir` performs SysV classification inline and emits the argument-register
# MIR_MOV pre-coloring (or stack store) directly, so no MIR_ARG instructions are
# produced anymore; the opcode is retained only so isel's pass-through arm stays
# total.
pub val MIR_ARG:      MirOpcode = 0x1001;
# a call pseudo; operand 0 is the SYM-or-VREG callee. side effects only - the
# result is bound by the MIR_CALL_RES move and arguments arrive via the
# argument-register MIR_MOV pre-coloring `lower_ir` emits before it
#
# CLOBBER CONVENTION (regalloc + encode must agree): a MIR_CALL implicitly
# clobbers EVERY caller-saved register of the active ABI - both the GP and FP
# files. There is no per-instruction clobber operand; the opcode itself IS the
# clobber barrier. regalloc derives the caller-saved set as "every allocatable
# physical register in a class that is NOT in `tgt.abi`'s callee_saved set" and,
# at each MIR_CALL, must spill/save any vreg whose assigned register is
# caller-saved (or FP) and reload it after, and must never satisfy a reload temp
# from a caller-saved register across the call. The fixed argument / return
# pre-coloring registers (RDI, RSI, RDX, RCX, R8, R9, RAX, XMM0..7, AL) are part
# of that caller-saved set, so the pre-coloring MIR_MOVs that bracket the call
# are consistent with this barrier. encode emits no extra bytes for the barrier;
# it relies on regalloc having already inserted the saves/reloads.
pub val MIR_CALL:     MirOpcode = 0x1002;
# a call-result-binding pseudo; operand 0 is the dst vreg. for a value-returning
# call `lower_ir` emits the return-register MIR_MOV (`dst <- RAX|XMM0`, or the
# RAX:RDX / sret pair) immediately after MIR_CALL and leaves this pseudo only as
# a liveness marker for the result vreg
pub val MIR_CALL_RES: MirOpcode = 0x1003;
# a constant-time declassify barrier pseudo; operands [dst, src] (#1646). the lowering
# of `:^` / OP_DECLASSIFY: a register copy that is DISTINGUISHABLE from an ordinary
# MIR_MOV, so the #1648 re-derive (which runs over the lowered, target-independent MIR
# where the secret-source seeds and this barrier both live) stops propagating secrecy
# here - the declassified result is public even though the source is secret. isel
# retags it to the concrete machine move (identical bytes to MIR_MOV), so at runtime it
# is a plain register copy the CPU elides; the distinction exists only for the taint
# analysis on the pre-selection MIR
pub val MIR_DECLASSIFY: MirOpcode = 0x1004;

# a vector lane read; operands [dst, vector, lane index] (#2236). `vec_lane`
# describes the SOURCE vector's arrangement and `width` the lane element's byte
# width, so the encoder reads the element size from `width` and the lane position
# from the immediate. the destination is a scalar of the lane's bank
pub val MIR_VEC_EXTRACT: MirOpcode = 0x1005;
# a vector lane write; operands [dst, vector, lane index, value] (#2236). functional
# like its IR opcode: the destination is a new vector, not an in-place mutation, and
# isel ties it to the source vector where the machine form is two-address. `vec_lane`
# describes the destination vector and `src_width` the written lane's byte width
pub val MIR_VEC_INSERT:  MirOpcode = 0x1006;
# build a whole vector from its lanes; operands [dst, lane0, lane1, ...] (#2640).
# `vec_lane` describes the destination vector and `width` its byte width. reachable
# only on a target whose `MachineModel.has_vec_build` is set - every other target
# never forms the IR opcode at all, since `me.lower.expr.lower_vector_lit` assembles
# a literal through storage there instead. deliberately NOT in `selection_lane`:
# that pack is what arm64 admits, and arm64 has lane access without a whole-vector
# build form
pub val MIR_VEC_BUILD:   MirOpcode = 0x1007;

# selection-output sentinels for the generic opcodes that survive instruction
# selection because they need a multi-instruction byte sequence the encoder
# materializes. isel rewrites each surviving generic opcode to a high sentinel
# (0x1100+) so it cannot collide with a concrete encoder opcode in the shared
# 0..74 value space
pub val MIR_SEL_ADD:      MirOpcode = 0x1100;  # add with no single-instruction form
pub val MIR_SEL_SUB:      MirOpcode = 0x1101;  # two-address subtract
pub val MIR_SEL_MUL:      MirOpcode = 0x1102;  # two-address multiply
pub val MIR_SEL_AND:      MirOpcode = 0x1103;  # two-address bitwise and
pub val MIR_SEL_OR:       MirOpcode = 0x1104;  # two-address bitwise or
pub val MIR_SEL_XOR:      MirOpcode = 0x1105;  # two-address bitwise xor
pub val MIR_SEL_SHL:      MirOpcode = 0x1106;  # two-address left shift
pub val MIR_SEL_SHR_U:    MirOpcode = 0x1107;  # two-address logical right shift
pub val MIR_SEL_SHR_S:    MirOpcode = 0x1108;  # two-address arithmetic right shift
pub val MIR_SEL_DIV_S:    MirOpcode = 0x1109;  # signed divide (high-half setup + IDIV)
pub val MIR_SEL_DIV_U:    MirOpcode = 0x110A;  # unsigned divide (high-half setup + DIV)
pub val MIR_SEL_REM_S:    MirOpcode = 0x110B;  # signed remainder
pub val MIR_SEL_REM_U:    MirOpcode = 0x110C;  # unsigned remainder
pub val MIR_SEL_CMP_EQ:   MirOpcode = 0x110D;  # equality compare (CMP;SETcc;MOVZX)
pub val MIR_SEL_CMP_NE:   MirOpcode = 0x110E;  # inequality compare
pub val MIR_SEL_CMP_LT_S: MirOpcode = 0x110F;  # signed less-than compare
pub val MIR_SEL_CMP_LT_U: MirOpcode = 0x1110;  # unsigned less-than compare
pub val MIR_SEL_CMP_LE_S: MirOpcode = 0x1111;  # signed less-or-equal compare
pub val MIR_SEL_CMP_LE_U: MirOpcode = 0x1112;  # unsigned less-or-equal compare
pub val MIR_SEL_CBR:      MirOpcode = 0x1113;  # conditional branch (TEST;JNE;JMP)

# the fused compare-and-branch terminators: a scalar integer comparison and the
# conditional branch consuming its result, combined into ONE terminator per
# condition code by the shared rules-layer fusion (`rules.select` runs the
# combine ahead of per-instruction selection for every pack that declares the
# condition in its `fused_cbr_ccs`). operand shape `[lhs, rhs, then_block,
# else_block]`: TWO value uses (register or immediate) plus the two successor
# edges, and NO def - the register allocator classifies by operand shape, so a
# block-operand-bearing instruction defines nothing and both value operands read
# as uses. the COMPARE width rides `mi.width` (the branch consumes the relation
# directly; there is no boolean result to size). the encoder materializes the
# fused byte sequence: x86-64 `CMP ; Jcc then ; JMP else`, arm64 `SUBS XZR ;
# B.cc then ; B else`, riscv64 the native `beq/bne/blt/bltu/bge/bgeu then ; j
# else` conditional branches
pub val MIR_SEL_CBR_EQ:   MirOpcode = 0x1120;  # branch when lhs == rhs
pub val MIR_SEL_CBR_NE:   MirOpcode = 0x1121;  # branch when lhs != rhs
pub val MIR_SEL_CBR_LT_S: MirOpcode = 0x1122;  # branch when lhs < rhs, signed
pub val MIR_SEL_CBR_LT_U: MirOpcode = 0x1123;  # branch when lhs < rhs, unsigned
pub val MIR_SEL_CBR_LE_S: MirOpcode = 0x1124;  # branch when lhs <= rhs, signed
pub val MIR_SEL_CBR_LE_U: MirOpcode = 0x1125;  # branch when lhs <= rhs, unsigned

# whether a generic opcode is one of the six scalar integer comparisons
# (MIR_CMP_EQ .. MIR_CMP_LE_U, a contiguous block mirroring the IR numbering)
pub fun is_cmp_opcode(op: MirOpcode) bool {
    ret op >= MIR_CMP_EQ && op <= MIR_CMP_LE_U;
}

# whether a post-selection opcode is one of the six fused compare-and-branch
# terminators (MIR_SEL_CBR_EQ .. MIR_SEL_CBR_LE_U, a contiguous block)
pub fun is_fused_cbr(op: MirOpcode) bool {
    ret op >= MIR_SEL_CBR_EQ && op <= MIR_SEL_CBR_LE_U;
}

# the fused compare-and-branch terminator realizing a generic comparison's
# relation. both families are contiguous in the same EQ / NE / LT_S / LT_U /
# LE_S / LE_U order, so the mapping is arithmetic. call only with a comparison
# opcode (`is_cmp_opcode`)
pub fun fused_cbr_opcode(cmp: MirOpcode) MirOpcode {
    ret MIR_SEL_CBR_EQ + (cmp - MIR_CMP_EQ);
}

# THE SELECTION ALPHABET - a property of `mir.lower_ir`, shared by every pack's
# coverage test so the three tables cannot drift apart per arch. `reachable` is
# every generic opcode lowering can hand selection (the IR-mirroring block 0..43
# minus the eliminated ones, plus the lowering pseudos); `eliminated` the
# opcodes no producer emits (MIR_CALL_IR expands in lower_ir; aggregate access
# lowers to moves, so MIR_EXTRACT / MIR_INSERT never reach a selector) that a
# table must keep default-deny; `fused` the compare-and-branch survivors the
# engine's combine produces, which a fusing pack's table must admit.
#
# `reachable` is UNCONDITIONAL: every pack must model each of its opcodes, and that
# is enforced statically by each pack's `generic_opcode_coverage` test probing
# `find_rule`. The test never runs the pipeline, so "a pass removes it first" does
# not excuse a pack from covering a reachable opcode - a capability-gated opcode
# therefore cannot live in this list. `fused` and `lane` are the two CAPABILITY-
# GATED lists: an opcode only reaches selection on a target that opted into
# producing it, so only that target's coverage test consults the list and every
# other pack keeps it default-deny.
pub val SELECTION_REACHABLE_COUNT:  u32 = 46;
pub val SELECTION_ELIMINATED_COUNT: u32 = 3;
pub val SELECTION_FUSED_COUNT:      u32 = 6;
pub val SELECTION_LANE_COUNT:       u32 = 2;

# fill `out` (SELECTION_REACHABLE_COUNT wide) with the reachable alphabet
pub fun selection_reachable(out: *u32) {
    out[0]  = MIR_ADD;
    out[1]  = MIR_SUB;
    out[2]  = MIR_MUL;
    out[3]  = MIR_DIV_S;
    out[4]  = MIR_DIV_U;
    out[5]  = MIR_REM_S;
    out[6]  = MIR_REM_U;
    out[7]  = MIR_NEG;
    out[8]  = MIR_AND;
    out[9]  = MIR_OR;
    out[10] = MIR_XOR;
    out[11] = MIR_SHL;
    out[12] = MIR_SHR_S;
    out[13] = MIR_SHR_U;
    out[14] = MIR_NOT;
    out[15] = MIR_CMP_EQ;
    out[16] = MIR_CMP_NE;
    out[17] = MIR_CMP_LT_S;
    out[18] = MIR_CMP_LT_U;
    out[19] = MIR_CMP_LE_S;
    out[20] = MIR_CMP_LE_U;
    out[21] = MIR_TRUNC;
    out[22] = MIR_SEXT;
    out[23] = MIR_ZEXT;
    out[24] = MIR_FP_TRUNC;
    out[25] = MIR_FP_EXT;
    out[26] = MIR_FP_TO_SI;
    out[27] = MIR_FP_TO_UI;
    out[28] = MIR_SI_TO_FP;
    out[29] = MIR_UI_TO_FP;
    out[30] = MIR_BITCAST;
    out[31] = MIR_ALLOCA;
    out[32] = MIR_LOAD;
    out[33] = MIR_STORE;
    out[34] = MIR_GEP;
    out[35] = MIR_PHI;
    out[36] = MIR_BR;
    out[37] = MIR_CBR;
    out[38] = MIR_RET;
    out[39] = MIR_UNREACHABLE;
    out[40] = MIR_ASM;
    out[41] = MIR_MOV;
    out[42] = MIR_ARG;
    out[43] = MIR_CALL;
    out[44] = MIR_CALL_RES;
    out[45] = MIR_DECLASSIFY;
}

# fill `out` (SELECTION_ELIMINATED_COUNT wide) with the eliminated opcodes
pub fun selection_eliminated(out: *u32) {
    out[0]  = MIR_CALL_IR;
    out[1]  = MIR_EXTRACT;
    out[2]  = MIR_INSERT;
}

# fill `out` (SELECTION_LANE_COUNT wide) with the vector lane-access opcodes
#
# Reachable only on a target whose `MachineModel.has_lane_ops` is set; every other
# target has `me.pass.scalarize.expand_lane_ops` rewrite them to the vector's memory
# image before selection, so their packs keep these default-deny.
pub fun selection_lane(out: *u32) {
    out[0] = MIR_VEC_EXTRACT;
    out[1] = MIR_VEC_INSERT;
}

# fill `out` (SELECTION_FUSED_COUNT wide) with the fused survivors
pub fun selection_fused(out: *u32) {
    out[0]  = MIR_SEL_CBR_EQ;
    out[1]  = MIR_SEL_CBR_NE;
    out[2]  = MIR_SEL_CBR_LT_S;
    out[3]  = MIR_SEL_CBR_LT_U;
    out[4]  = MIR_SEL_CBR_LE_S;
    out[5]  = MIR_SEL_CBR_LE_U;
}

# whether an instruction's operand 0 is a WRITTEN DESTINATION, by operand shape
#
# The one def/use-shape classification the register allocator and the rule
# engine share. It keys on shape, never on the terminator / store opcodes -
# instruction selection rewrites those to concrete per-arch opcodes, so an
# opcode test would silently misread them. A block-operand-bearing instruction
# is a branch (its operand 0 is a condition or a compare operand, and a fused
# compare-and-branch's two value operands are both uses); MIR_CALL is the
# value-less call barrier; MIR_CALL_RES is a liveness marker whose operand 0 is
# a live use, never a destination. Everything else writes whatever operand 0
# names - callers test its kind (a value vreg, a precolored physical register,
# or a memory destination) for their own question.
# ---
# mi:  the instruction to classify
# ret: true when operand 0 is a written destination
pub fun instr_defines_shape(mi: *MirInstr) bool {
    if (mi.operand_count == 0)     { ret false; }
    if (mi.opcode == MIR_CALL)     { ret false; }
    if (mi.opcode == MIR_CALL_RES) { ret false; }
    var k: u32 = 0;
    for (k < mi.operand_count) {
        if (mi.operands[k].kind == MIR_OP_BLOCK) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether a surviving comparison or fused compare-and-branch opcode is a SIGNED
# relation (the LT_S / LE_S members of either family). the encoders read it to
# pick sign- versus zero-extension when re-narrowing sub-word operands and to
# interpret width-masked immediates
pub fun is_signed_cmp(op: MirOpcode) bool {
    ret op == MIR_SEL_CMP_LT_S || op == MIR_SEL_CMP_LE_S ||
        op == MIR_SEL_CBR_LT_S || op == MIR_SEL_CBR_LE_S;
}

# the scalar floating-point arithmetic / comparison ops. the shared IR integer
# opcodes (OP_ADD / OP_SUB / OP_MUL / OP_DIV_* / OP_CMP_*) cover both int and
# float operands; `lower_ir` dispatches on operand/result float type and emits one
# of these dedicated opcodes for a float instead of the integer ALU form, which
# would mis-encode an XMM-classed value. like the compare / divide families they
# survive instruction selection unchanged and the encoder materializes the SSE
# byte sequence (operands loaded `[rbp+off]`/reg -> XMM scratch, the SSE op, the
# result stored back). the operation width (4 for f32, 8 for f64) rides on
# `mi.width` so the encoder selects the SS vs SD form. they occupy the high
# selection-output space so the encoder never confuses one with a concrete x86-64
# opcode of the same low value
pub val MIR_FADD: MirOpcode = 0x1114;  # scalar float addition (ADDSS / ADDSD)
pub val MIR_FSUB: MirOpcode = 0x1115;  # scalar float subtraction (SUBSS / SUBSD)
pub val MIR_FMUL: MirOpcode = 0x1116;  # scalar float multiplication (MULSS / MULSD)
pub val MIR_FDIV: MirOpcode = 0x1117;  # scalar float division (DIVSS / DIVSD)
# scalar float comparison (UCOMISS / UCOMISD + unsigned SETcc + MOVZX). the
# condition code (one of FCC_*) rides on the instruction's `src_width` carrier
# set by lowering
pub val MIR_FCMP: MirOpcode = 0x1118;

# a scalar float register copy is a plain MIR_MOV: with disjoint GP / XMM register
# id spaces (a physical register id carries its class) the encoder dispatches the
# move family on operand register CLASS - an XMM-bank operand selects MOVSS / MOVSD,
# a GP<->XMM pair MOVD / MOVQ - so a float copy needs no dedicated opcode and can
# never mis-select to a move of the GP register that aliases an XMM index. the float
# width (4 / 8) rides on the move so the encoder picks the single- vs double-
# precision form.

# scalar float negation, operands [dst, src]. a float negate flips the IEEE-754
# sign bit, which an integer MIR_NEG (two's-complement of the whole bit pattern)
# would not produce; this dedicated opcode survives selection and the encoder
# materializes the sign-bit XOR on the XMM value (XORPS with a sign mask). the
# width (4 for f32, 8 for f64) selects the f32 vs f64 sign-bit mask
pub val MIR_FNEG: MirOpcode = 0x111B;

# zero an entire object at a memory operand; operands [dst_mem, size_imm] (#2669).
#
# A whole-object operation rather than the byte-chunked store run it used to lower
# to. A flat-addressing target never sees one - `lower_memzero` still expands it
# into sized stores there, exactly as before - so this reaches only a target that
# declares storage structurally, where a run of byte stores spanning object
# boundaries is not expressible at all. Recovering the whole-object intent from
# such a run would mean pattern-matching a chunking strategy, which breaks silently
# on partial zeroing, interleaved stores, or a change of chunk widths.
pub val MIR_MEMZERO: MirOpcode = 0x111C;

# a bit reinterpret (`:~`) BETWEEN TWO VALUES is a plain MIR_BITCAST. a same-bank
# reinterpret (GP<->GP or XMM<->XMM) is a register copy; a `:~` between a float and
# an equal-size integer crosses the GP and XMM banks. both select to a plain MOV:
# the encoder dispatches the move family on operand register CLASS - a same-bank XMM
# pair emits MOVSS / MOVSD, a register-register GP<->XMM pair emits MOVD / MOVQ, and
# a spilled side is moved through memory at byte width - so no dedicated cross opcode
# is needed and the bank can never be lost across register allocation.
#
# The bank reasoning above only classifies VALUES, so it says nothing about a `:~`
# whose other side is an AGGREGATE: a struct / union / array is carried by its
# storage ADDRESS, not in a register of either bank. Such a cast changes
# representation rather than bank, and no MOV expresses it. This comment used to
# claim a bitcast was a plain MIR_BITCAST "in every direction", which asserted the
# property that does not hold and is presumably why the gap survived: reaching MIR
# at all, the aggregate side was read as a pointer, so `[8]u8 :~ i64` produced the
# array's stack address and `i64 :~ [8]u8` copied from the integer's bytes as if
# they were one (#2670).
#
# The crossing is therefore materialized in `me/lower/expr.mach`'s `lower_reinterpret`
# - a load out of the aggregate, or an alloca plus a store into it - so a bitcast
# reaching here has values on both sides by construction. `VC_BITCAST_CLASS` in the
# IR verifier holds that invariant, always on.

# float-comparison condition codes carried on a MIR_FCMP. a UCOMISD sets CF/ZF/PF
# (an UNORDERED result sets all three), so the float compare maps to UNSIGNED
# SETcc - distinct from the integer compare family's signed conditions
pub val FCC_EQ: u8 = 0;  # equal (SETE)
pub val FCC_NE: u8 = 1;  # not equal (SETNE)
pub val FCC_LT: u8 = 2;  # less than (SETB - CF set when below)
pub val FCC_LE: u8 = 3;  # less or equal (SETBE)
pub val FCC_GT: u8 = 4;  # greater than (SETA)
pub val FCC_GE: u8 = 5;  # greater or equal (SETAE)

# sentinel "no virtual register"; never a valid vreg id, never a default
pub val MIR_VREG_NIL: u32 = 0xFFFFFFFF;

# canonical general-purpose register-class index used by `lower_ir`. by
# convention the general-purpose bank is the first declared class; the lowering
# locates the general and float banks by their RC_GENERAL / RC_FLOAT kind, so no
# arch-specific class name is hardcoded
pub val REG_CLASS_GP: u32 = 0;

# the minimum byte width an integer ALU / shift result is computed at. a register
# that holds a value narrower than this is still saved and reloaded at the full
# machine-word width, so a sub-word ALU op (which leaves the upper register bits
# undefined) would persist garbage into the spill slot and corrupt any later
# full-width use (an index in a LEA address, a word-width move). running the op at
# >= 4 bytes keeps the live portion of the register defined up through the width an
# ISA's narrow-write clears (the 32-bit GP write that zero-extends to 64 on
# x86-64), so the spilled word is clean. logical sub-word truncation is unaffected:
# every consumer that needs the narrow value re-narrows it
pub val ALU_MIN_WIDTH: u8 = 4;

# a single MIR operand whose live fields depend on `kind`
# ---
# kind:          operand discriminant (one of MIR_OP_*)
# vreg:          virtual register id for VREG, or a MEM frame-slot-key base; for a
#                MEM physical-register base it is MIR_VREG_NIL (the base lives in
#                `preg`)
# preg:          physical register id for PREG, or a MEM physical-register base
#                (when the MEM operand's `vreg` is MIR_VREG_NIL); else 0
# imm:           immediate / displacement / block id, per kind
# sym:           interned symbol name for SYM (else intern.STR_NIL)
# sym_off:       addend applied to the symbol for SYM
# index:         MEM scaled-index register: a value vreg (pre-regalloc) or physical
#                register id (`index_is_preg` set). MIR_VREG_NIL when no index.
# scale:         MEM index scale (1, 2, 4, or 8); 0 when no index
# index_is_preg: true when `index` is a physical register id (set by regalloc);
#                false when it is a value vreg awaiting allocation
pub rec MirOperand {
    kind:          MirOperandKind;
    vreg:          u32;
    preg:          u32;
    imm:           i64;
    sym:           intern.StrId;
    sym_off:       i32;
    index:         u32;
    scale:         u8;
    index_is_preg: bool;
    # marks a MIR_OP_SYM whose address must be loaded GOT-indirect rather than
    # materialized absolute (a preemptible / imported reference). arm64 encode reads
    # it to select the adrp :got: + ldr :got_lo12: sequence. the GOT-indirect
    # foundation ships dormant: nothing sets it yet, since routing imported data
    # through the GOT awaits RFC #2026 (see mir.context.lower_value). always false
    # today, so every reference keeps the position-independent adrp+add form
    sym_got:       bool;
}

# one resolved `{name}` binding for an inline-asm block
#
# Pairs the source name with the slot-owning vreg the alloca's result mapped to.
# The encoder resolves the vreg to a frame offset and substitutes `[rbp+off]` for
# `{name}` when it expands the body.
# ---
# name:      interned source local name (the text inside `{ }`)
# slot_vreg: slot-owning vreg id of the local's alloca storage
pub rec MirAsmBind {
    name:      intern.StrId;
    slot_vreg: u32;
    secret:    bool;
}

# build one `{name}` binding, every field supplied
#
# THIS IS THE ONLY PLACE A `MirAsmBind` IS BUILT. The array it lands in comes from a
# non-zeroing `A.allocate`, so a field a site forgets carries the previous
# allocation's residue - the hazard that dropped `vec_lane` from a rebuilt MirInstr
# (#2032, #2335). `secret` makes that hazard a SECURITY one: a binding whose secrecy
# is residue is a constant-time guarantee issued over an unknown (#2230).
# ---
# name:      interned source local name (the text inside `{ }`)
# slot_vreg: slot-owning vreg id of the local's alloca storage
# secret:    true when the local's declared type carries `^` on its by-value spine
# ret:       the binding
pub fun asm_bind(name: intern.StrId, slot_vreg: u32, secret: bool) MirAsmBind {
    var b: MirAsmBind;
    b.name      = name;
    b.slot_vreg = slot_vreg;
    b.secret    = secret;
    ret b;
}

# the inline-asm payload carried by a MIR_ASM instruction
#
# The body text is resolved from the interner at lower time; the `{name}`
# bindings carry the slot-owning vreg ids the encoder turns into `[rbp+off]` once
# the frame is laid out. Owned by the MIR_ASM instruction and freed in
# `dnit_block`.
# ---
# isa:        the target ISA tag the body was written for (e.g. "x86_64")
# body:       raw inline-asm body text (borrowed from the interner; stable)
# binds:      `{name}` -> slot-vreg bindings referenced by the body (owned)
# bind_count: number of bindings
pub rec MirAsm {
    isa:        str;
    body:       str;
    binds:      *MirAsmBind;
    bind_count: u32;
}

# one MIR instruction - a generic-or-concrete opcode plus a flat operand list (dst at operand 0)
# ---
# opcode:        generic MIR opcode (pre-isel) or concrete encoder opcode (post-isel)
# operands:      pointer to a contiguous array of operands (owned)
# operand_count: number of operands
# width:         operation width in bytes (1, 2, 4, or 8) of the destination /
#                result the instruction drives - the byte width the encoder uses
#                to size MOV / ALU / CMP / LOAD / STORE / conversion ops (REX.W
#                only for 8, the 0x66 prefix only for 2). populated in `lower_ir`
#                from the IR result type (or, for void-result ops like store and
#                compare, the operated-on operand type). 0 means "unset", which
#                the encoder treats as the machine-word width so a pseudo with no
#                natural width (call / ret / branch / asm) still encodes its
#                address-sized fields correctly.
#
#                BITS ABOVE `width` ARE UNDEFINED. Width is a property of the
#                OPERATION, not of the value - a `MirVReg` carries no width at
#                all - so an instruction states how many bytes it operates on and
#                says nothing about the rest of the register. A consumer that
#                wants a value at a wider width must go through an explicit
#                conversion op (TRUNC / SEXT / ZEXT); none may read above the
#                width its producer declared.
#
#                This is settled, not assumed (#2395). The three register targets
#                already disagree about those bits and all three are correct:
#                x86-64's 4-byte move zero-extends into the 64-bit register,
#                aarch64's every sub-word move does, and riscv64's is `addi
#                rd,rs,0` at the machine width and extends nothing. riscv64
#                self-hosts and passes CI on the same MIR, which is the witness -
#                if a width-4 move were specified to define bits 32..63, riscv64
#                would be miscompiling every one of them. Regalloc relied on the
#                opposite reading to keep same-register copies alive on x86-64 and
#                aarch64; that premise was false and the copies are now dropped.
# src_width:     source operand width in bytes for the width-changing conversions
#                (TRUNC / SEXT / ZEXT and the integer-side CVT forms), where the
#                source is narrower or wider than the destination. for every other
#                opcode it equals `width`. the encoder sizes source operands by
#                this field so MOVZX / MOVSX select the byte-vs-word source form.
#                EXCEPTION: a MIR_FCMP carries its float-comparison condition code
#                (one of FCC_*) here, since a float comparison has no narrower /
#                wider source form - both operands ride at `width` (4 for f32, 8
#                for f64) and the single MIR_FCMP opcode selects the UNSIGNED SETcc
#                from this condition, mirroring how the integer compare family
#                encodes its condition in the opcode itself.
# asm_block:     inline-asm payload for a MIR_ASM instruction (owned), else nil.
#                carries the raw body text plus `{name}` -> slot-vreg bindings the
#                encoder expands into machine instructions.
# loc:           source location (file + byte offset) this instruction lowered from,
#                forwarded from the IR instruction; source.loc_nil() for a
#                compiler-synthesized instruction with no source origin. the encoder
#                retains it as a PC<->source row for debug line tables; it never
#                affects the emitted bytes.
# dbg_bindings:  `-g`-only source-variable bindings that become live at this
#                instruction's PC (owned, ordered, nil when none). each entry names an
#                OP_DBG_VALUE identity and the vreg holding its value; the encoder
#                records a VarLoc at this instruction's start offset for each. pure
#                debug metadata attached to a real instruction (never a standalone
#                marker) so it rides through isel / regalloc / frame like `loc` and
#                cannot perturb allocation - the instruction stream is identical with
#                and without -g.
# dbg_binding_count: number of dbg bindings (0 for the common no-binding case).
# inline_site:   the 1-based inline instance this instruction belongs to (0 = the
#                function's own body), forwarded from the IR instruction's inline-site
#                map. lets the encoder group an inlined expansion's PC ranges for the
#                DWARF inlined_subroutine producer (#1707). pure metadata that rides
#                like `loc`; never affects the emitted bytes.
pub rec MirInstr {
    opcode:            MirOpcode;
    operands:          *MirOperand;
    operand_count:     u32;
    width:             u8;
    src_width:         u8;
    asm_block:         *MirAsm;
    loc:               source.SrcLoc;
    dbg_bindings:      *MirDbgBinding;
    dbg_binding_count: u32;
    inline_site:       u32;

    # the 128-bit vector lane descriptor for a vector-typed op (#1965), or 0 for a
    # non-vector instruction. `width` alone is 16 for every vector, so it cannot
    # distinguish the ten shapes; this carries the lane element kind + byte-width the
    # backend selectors need to pick a NEON arrangement / SSE packed form. built in
    # the shared MIR lowering from the operand's IRT_VECTOR type (`vec_lane_make`),
    # read target-locally by each backend's isel. stamped at the push_instr
    # chokepoint like `loc`, so non-vector code is unaffected.
    vec_lane:          u8;

    # constant-time SEED: true when this is a store / memzero writing SECRET storage
    # (#1646), forwarded once at lowering from the IR store's destination secrecy. The
    # value seed (MirVReg.secret) covers a store of a secret VALUE; this covers the
    # zeroizing case a value seed misses - a public zero wiped into a `^` buffer. The
    # #1648 re-derive (over the lowered MIR) reads it ONLY on a store / memzero opcode to
    # mark the memory secret and keep the wipe from a future dead-store elimination.
    # false on every non-store instruction, stamped from ctx.cur_writes_secret at the
    # push_instr chokepoint like vec_lane, so non-secret code is unaffected.
    writes_secret:     bool;
}

# build a fresh MIR instruction, every caller-owned field supplied
#
# THIS IS THE ONLY PLACE A `MirInstr` IS BUILT. `var` zero-fills a bare declaration,
# so every metadata field below already comes back at its zero default without being
# named - but that is exactly the hazard, not the absence of one: a field whose
# meaningful default is not zero would be silently wrong here with nothing to catch
# it, the way `vec_lane` read as element 0 - a plausible arrangement, not a crash -
# after `regalloc.rewrite_instr` rebuilt a `MirInstr` without it (#2032, #2321).
# Naming this as the one construction site means a field added later is a decision
# made once, here, rather than a silent zero at every caller.
#
# The five fields a caller genuinely chooses are positional parameters, so omitting
# one is an arity error at build time rather than a garbage operation width reaching
# the encoder. Everything else is METADATA the caller does not author: `asm_block`
# belongs to MIR_ASM alone, `loc` / `inline_site` / `vec_lane` / `writes_secret` are
# stamped from the lowering context at `mir.context.push_instr`, and the dbg-binding
# list is attached there too - all zero-valued by default, which is what an
# instruction built outside that chokepoint would otherwise leave undefined.
# ---
# opcode:        the MIR opcode
# operands:      the operand array (borrowed or owned per the caller's convention)
# operand_count: number of operands
# width:         operation width in bytes
# src_width:     source width in bytes, for a widening / narrowing op
# ret:           the instruction, with every metadata field at its zero default
pub fun instr(opcode: MirOpcode, operands: *MirOperand, operand_count: u32,
              width: u8, src_width: u8) MirInstr {
    var mi: MirInstr;
    mi.opcode        = opcode;
    mi.operands      = operands;
    mi.operand_count = operand_count;
    mi.width         = width;
    mi.src_width     = src_width;
    ret mi;
}

# derive an instruction from an existing one, replacing its operand list
#
# The rewrite/clone constructor, and the one #2032 needed. A pass that rebuilds an
# instruction with new operands - register assignment rewriting vregs to physical
# registers, loop rotation cloning a block - must carry every field it is not
# deliberately changing, and doing that field by field is how `vec_lane` was
# dropped. Deciding carry-or-reset ONCE, here, means a field added to `MirInstr`
# later flows through both callers with no visit to either.
#
# EVERY field is carried, including `asm_block` and the dbg-binding list. A caller
# that must not duplicate one of those - a CLONE aliases an owned list rather than
# taking it over - clears it explicitly afterwards, which is a semantic decision
# visible at the site rather than a field silently missed here.
# ---
# src:           the instruction to derive from
# operands:      the replacement operand array
# operand_count: number of replacement operands
# ret:           the derived instruction
pub fun instr_like(src: *MirInstr, operands: *MirOperand, operand_count: u32) MirInstr {
    var mi: MirInstr = @src;
    mi.operands      = operands;
    mi.operand_count = operand_count;
    ret mi;
}

# the vector-lane element kinds packed into `MirInstr.vec_lane`'s high nibble.
# VEC_LANE_NONE (0) means the instruction is not vector-typed. signedness is NOT a
# lane-descriptor field: it rides the consuming opcode (a signed vs unsigned
# compare, an SMOV vs UMOV lane read), consistent with IRT_INT holding no
# signedness of its own
pub val VEC_LANE_NONE:  u8 = 0;
pub val VEC_LANE_FLOAT: u8 = 1;  # float lanes  (f32x4 / f64x2)
pub val VEC_LANE_INT:   u8 = 2;  # integer lanes (i*/u*; the opcode carries signedness)

# pack a lane descriptor: the element kind in the high nibble, the element
# byte-width (1/2/4/8) in the low nibble. the lane count is implied - every seeded
# vector is 128-bit, so it is 16 / element-bytes
pub fun vec_lane_make(kind: u8, elem_bytes: u8) u8 {
    ret ((kind & 0xF) << 4) | (elem_bytes & 0xF);
}

# the element kind of a lane descriptor (VEC_LANE_NONE / FLOAT / INT)
pub fun vec_lane_kind(v: u8) u8 { ret (v >> 4) & 0xF; }

# the element byte-width of a lane descriptor (1/2/4/8), or 0 for a non-vector
pub fun vec_lane_elem_bytes(v: u8) u8 { ret v & 0xF; }

# whether a lane descriptor names a vector (any nonzero descriptor)
pub fun vec_lane_is_vector(v: u8) bool { ret v != 0; }

# the lane count of a vector descriptor (16 / element-bytes), or 0 for a non-vector
pub fun vec_lane_count(v: u8) u32 {
    val eb: u8 = vec_lane_elem_bytes(v);
    if (eb == 0) { ret 0; }
    ret 16 / eb::u32;
}

# one `-g` source-variable binding attached to a MirInstr: the OP_DBG_VALUE identity
# `iid` (joining the IR dbg-var / dbg-expr side tables) and the MIR `vreg` holding the
# variable's value (MIR_VREG_NIL for a constant / optimized-out binding). The variable
# becomes live at the owning instruction's PC; the encoder emits a VarLoc there
# ---
# iid:  the IR OP_DBG_VALUE instruction id
# vreg: the operand's MIR vreg, or MIR_VREG_NIL for no register/frame home
# fields past `vreg` are the FUSED-CONDITION COMPARE PAYLOAD, read only when
# `cmp_op` is nonzero: compare-and-branch fusion deletes the instruction that
# defined a bound condition vreg, so the combine rewrites each binding naming it
# into "the relation `cc(lhs, rhs)` computed at the fused terminator's PC" - the
# debug producer renders that as a DWARF computed-value expression instead of an
# optimized-out gap. `cmp_op` holds the fused MIR_SEL_CBR_* terminator opcode
# (0 = a plain binding; the payload fields are then dead and may be garbage);
# `vreg` / `imm` carry the lhs and `vreg2` / `imm2` the rhs (each a vreg or,
# with its `*_is_imm` flag, an immediate), and `cmp_width` the compare width.
# pure debug metadata: the combine writes it after every fusion decision is
# made, so -g and non--g builds still select identically
pub rec MirDbgBinding {
    iid:  u32;
    vreg: u32;
    cmp_op:     u32;
    cmp_width:  u8;
    lhs_is_imm: bool;
    rhs_is_imm: bool;
    vreg2:      u32;
    imm:        i64;
    imm2:       i64;
}

# a MIR basic block - an ordered instruction list plus predecessor ids, sharing the source IR `Block.id`
# ---
# id:          block id, identical to the source IR block id
# instrs:      ordered MIR instructions (owned)
# instr_count: number of instructions
# instr_cap:   allocated capacity for instrs
# preds:       predecessor block ids (owned)
# pred_count:  number of predecessors
# pred_cap:    allocated capacity for preds
pub rec MirBlock {
    id:          u32;

    instrs:      *MirInstr;
    instr_count: u32;
    instr_cap:   u32;

    preds:       *u32;
    pred_count:  u32;
    pred_cap:    u32;
}

# a virtual register and its register-allocation state
# ---
# id:         the vreg's own index into MirFunction.vregs
# class:      index into `tgt.model.reg_classes` selecting the register bank
# spill_slot: stack-frame slot index when spilled (-1 while unspilled)
# assigned:   physical register id assigned by regalloc (MIR_VREG_NIL until then)
# vector:     true when the vreg holds a 128-bit SIMD vector; distinguishes a vector
#             from a scalar float within the shared FP bank so regalloc 16-byte-aligns
#             its spill slot (MOVAPS reloads require it) while scalar-float slots stay
#             at align 8 (#2014)
# secret:     the constant-time SEED marker (#1646): true when this vreg is defined by a
#             secret SOURCE - a secret parameter, a load through welded `*^T` storage, a
#             secret global, or a call returning a secret. NOT a propagated result taint:
#             a derived value (an add of two secrets) is left false here and its secrecy
#             is re-derived by the #1648 validator, which seeds its dataflow fixpoint from
#             these markers and propagates any-secret-operand->secret-result with `:^`
#             (MIR_DECLASSIFY) as a barrier. set once when the vreg is created (the vreg
#             table persists through isel/regalloc), so no transform can launder it. pure
#             metadata; a secret-free function is byte-identical
pub rec MirVReg {
    id:         u32;
    class:      u32;
    spill_slot: i32;
    assigned:   u32;
    vector:     bool;
    secret:     bool;
}

# build a fresh MIR virtual register, unspilled and unassigned
#
# THIS IS THE ONLY PLACE A `MirVReg` IS BUILT. Every caller grows `MirFunction.vregs`
# with a non-zeroing `A.reallocate` before writing into the new slot, so an unnamed
# field here would carry the previous allocation's residue rather than a defined
# value - the same hazard `mir.instr` guards for `MirInstr` (#2032, #2335). `id` is
# always the slot's own index and `spill_slot` / `assigned` always start at their
# unspilled / unassigned sentinels at every call site, so those three are not
# parameters: a caller cannot pass an inconsistent one, and a new caller cannot
# forget to set them to anything but the one correct start state.
# ---
# id:     the vreg's own index into MirFunction.vregs (its slot, by construction)
# class:  register-class index the new vreg belongs to
# vector: whether the vreg holds a 128-bit SIMD vector (#2014)
# secret: the constant-time SEED marker (#1646): true when defined by a secret source
# ret:    the vreg, unspilled and unassigned
pub fun vreg(id: u32, class: u32, vector: bool, secret: bool) MirVReg {
    var v: MirVReg;
    v.id         = id;
    v.class      = class;
    v.spill_slot = -1;
    v.assigned   = MIR_VREG_NIL;
    v.vector     = vector;
    v.secret     = secret;
    ret v;
}

# `mir.vreg` SETS EVERY FIELD OF A FRESH VIRTUAL REGISTER.
#
# The guard the three vreg-table growth sites need: each grows `MirFunction.vregs`
# with a non-zeroing `A.reallocate` and then calls this constructor into the new
# slot, so a field this left unset would read the previous allocation's residue
# rather than a defined value (#2335, the same hazard #2032 shipped for `MirInstr`).
#
# Every field below is asserted against a value that DIFFERS from the field's own
# zero default (`id` / `class` nonzero, `vector` / `secret` true), because `var`
# zero-fills a forgotten field - so a check against the zero value itself would
# pass whether or not the assignment that produces it is still there. `spill_slot`
# / `assigned` are not parameters (every call site starts a vreg unspilled and
# unassigned), so their fixed sentinels are checked directly.
# ---
# To see it fail, drop a field from `vreg`'s assignment list.
test "mach.lang.be.codegen.mir.vreg:sets_every_field" {
    val v: MirVReg = vreg(7, 3, true, true);
    if (v.id != 7)                  { ret 1; }
    if (v.class != 3)               { ret 1; }
    if (v.spill_slot != -1)         { ret 1; }
    if (v.assigned != MIR_VREG_NIL) { ret 1; }
    if (!v.vector)                  { ret 1; }
    if (!v.secret)                  { ret 1; }

    # and the flags genuinely echo the parameter rather than being hard-coded true.
    val v2: MirVReg = vreg(0, 0, false, false);
    if (v2.vector) { ret 1; }
    if (v2.secret) { ret 1; }
    ret 0;
}

# discriminant distinguishing an addressed alloca slot from a by-value spill slot
pub def MirSlotKind: u8;

# a slot whose address is the alloca pointer; the slot is the pointed-to storage
pub val SLOT_ALLOCA: MirSlotKind = 0;
# a slot holding a by-value copy of a small-aggregate param, aggregate load, or aggregate return
pub val SLOT_SPILL:  MirSlotKind = 1;

# one stack-frame slot - a sized, aligned region for an alloca or a small-aggregate spill
# ---
# value:  MIR value id that owns this slot; keys frame.run's offset lookup
# kind:   SLOT_ALLOCA (addressed) or SLOT_SPILL (by-value copy)
# offset: negative byte offset from the frame pointer (assigned by frame.run)
# size:   slot size in bytes
# align:  slot alignment in bytes
# ty:     the IR type id the slot was allocated AT, or IR_TYPE_NIL when unknown
#         (#2673). `size` and `align` are measured FROM this type and answer every
#         flat-addressing question, so this is inert on a machine target. A
#         logical-addressing target cannot use them at all: it declares storage as a
#         typed `OpVariable`, and a byte count does not name a type. Keeping the id
#         the measurement came from is what makes a base's pointee type recoverable
#         at the consumer, which is the contract `lower_gep_structural` states.
#         Stored as a raw id rather than the `ir_type.IrTypeId` alias so the backend
#         MIR record takes no dependency on the middle end's type module.
pub rec MirSlot {
    value:  u32;
    kind:   MirSlotKind;
    offset: i64;
    size:   u32;
    align:  u32;
    ty:     u32;
}

# the `MirSlot.ty` sentinel for a slot whose allocated type is not known: a spill
# slot, or an alloca lowered before the type was carried. Mirrors ir_type.IRT_NIL
# without importing it
pub val SLOT_TY_NIL: u32 = 0xFFFFFFFF;

# a function's stack layout, populated by frame.run after register allocation
# ---
# slots:         stack slots (owned)
# slot_count:    number of slots
# slot_cap:      allocated capacity for slots
# size:          total frame size in bytes
# align:         frame alignment in bytes
# outgoing_size: bytes reserved at the bottom of the frame for stack-passed
#                outgoing call arguments - the maximum over every call this
#                function makes (16-byte aligned). `lower_ir` records it as it
#                lowers each call (see `lower_call`); frame.run reserves it as the
#                lowest region of the frame so a caller's `[rsp + off]` store
#                (`0 <= off < outgoing_size`) lands there without overlapping
#                locals, spills, or the callee-saved save area, and the call-site
#                RSP stays 16-byte aligned. zero when the function makes no call
#                with stack-passed arguments.
# omit:          this function gets NO compiler-generated prologue or epilogue -
#                no frame-pointer record, no stack allocation, no callee-save
#                stores. decided once by `frame.run` (`frame.omits_frame`) from
#                the laid-out frame facts and read by every target's encoder, so
#                one predicate governs all three ISAs. two disjoint reasons set
#                it: a `#[naked]` declaration, and a leaf that provably never
#                touches the frame. `-g` cannot influence either, so `.text` stays
#                byte-identical with and without it.
pub rec MirFrame {
    slots:         *MirSlot;
    slot_count:    u32;
    slot_cap:      u32;
    size:          u32;
    align:         u32;
    outgoing_size: u32;
    omit:          bool;
}

# a function in MIR form - blocks, the virtual-register table, and frame layout
# ---
# name:           interned function symbol name
# blocks:         MIR blocks; blocks[0] is the entry block (owned)
# block_count:    number of blocks
# block_cap:      allocated capacity for blocks
# vregs:          virtual-register table indexed by vreg id (owned)
# vreg_count:     number of virtual registers
# vreg_cap:       allocated capacity for vregs
# frame:          stack-frame layout (filled in by frame.run)
# callee_mask:    bitmask of callee-saved physical GP registers this function
#                 actually assigns, written by regalloc and read by frame.run /
#                 encode.run to emit the prologue save / epilogue restore. bit `n`
#                 set means physical GP register id `n` is live in the function and
#                 must be preserved. `lower_ir` initializes it to 0 (no
#                 callee-saved register used until regalloc proves otherwise).
# callee_mask_fp: the FP-bank twin of `callee_mask` - a bitmask of callee-saved
#                 vector (XMM) register INDICES this function must preserve, written
#                 by regalloc. bit `n` set means XMM register `n` must be saved in
#                 the prologue and restored in the epilogue. only conventions with
#                 callee-saved vector registers (win64's XMM6-15) ever set bits
#                 here; under SysV, where every XMM is caller-saved, it stays 0.
# oblivious:      the `#[oblivious]` constant-time SEED for #1648 (mirrors the IR
#                 function's FN_FLAG_OBLIVIOUS), stamped once at lowering so the MIR
#                 is self-describing for the constant-time validator: the leakage
#                 checks run only in a function marked here. pure metadata (like the
#                 vreg / store secret seeds); a non-oblivious function is byte-identical.
# naked:          the `#[naked]` declaration (#2198), mirroring the IR function's
#                 FN_FLAG_NAKED and stamped at lowering the same way `oblivious` is.
#                 `frame.omits_frame` reads it as the one omission reason that needs
#                 no proof: the author asked for no frame and owns the alignment, the
#                 link register and the return. a declaration rather than a derived
#                 fact, so it belongs to the function, not to the laid-out `frame`.
pub rec MirFunction {
    name:        intern.StrId;

    blocks:      *MirBlock;
    block_count: u32;
    block_cap:   u32;

    vregs:       *MirVReg;
    vreg_count:  u32;
    vreg_cap:    u32;

    frame:          MirFrame;
    callee_mask:    u32;
    callee_mask_fp: u32;
    oblivious:      bool;
    naked:          bool;
}

# the source spelling of a MIR opcode, for a diagnostic that has to say WHICH
# instruction it is about
#
# Returns the constant's own name rather than a lowercase mnemonic, deliberately.
# The reader of a backend refusal is usually the person about to implement the
# missing arm, and `MIR_DIV_S` is the token they grep the compiler for; a mnemonic
# reads marginally better in prose and is useless for that.
#
# Total over the opcode space, with a fallback for a value outside it, so no caller
# has to guard. A new opcode that forgets to add its arm therefore degrades to the
# fallback rather than reading as some other instruction.
# ---
# op:  the opcode
# ret: the opcode's source spelling, or "<unknown MIR opcode>"
pub fun opcode_name(op: MirOpcode) str {
    if (op == MIR_ADD)          { ret "MIR_ADD"; }
    if (op == MIR_SUB)          { ret "MIR_SUB"; }
    if (op == MIR_MUL)          { ret "MIR_MUL"; }
    if (op == MIR_DIV_S)        { ret "MIR_DIV_S"; }
    if (op == MIR_DIV_U)        { ret "MIR_DIV_U"; }
    if (op == MIR_REM_S)        { ret "MIR_REM_S"; }
    if (op == MIR_REM_U)        { ret "MIR_REM_U"; }
    if (op == MIR_NEG)          { ret "MIR_NEG"; }
    if (op == MIR_AND)          { ret "MIR_AND"; }
    if (op == MIR_OR)           { ret "MIR_OR"; }
    if (op == MIR_XOR)          { ret "MIR_XOR"; }
    if (op == MIR_SHL)          { ret "MIR_SHL"; }
    if (op == MIR_SHR_S)        { ret "MIR_SHR_S"; }
    if (op == MIR_SHR_U)        { ret "MIR_SHR_U"; }
    if (op == MIR_NOT)          { ret "MIR_NOT"; }
    if (op == MIR_CMP_EQ)       { ret "MIR_CMP_EQ"; }
    if (op == MIR_CMP_NE)       { ret "MIR_CMP_NE"; }
    if (op == MIR_CMP_LT_S)     { ret "MIR_CMP_LT_S"; }
    if (op == MIR_CMP_LT_U)     { ret "MIR_CMP_LT_U"; }
    if (op == MIR_CMP_LE_S)     { ret "MIR_CMP_LE_S"; }
    if (op == MIR_CMP_LE_U)     { ret "MIR_CMP_LE_U"; }
    if (op == MIR_TRUNC)        { ret "MIR_TRUNC"; }
    if (op == MIR_SEXT)         { ret "MIR_SEXT"; }
    if (op == MIR_ZEXT)         { ret "MIR_ZEXT"; }
    if (op == MIR_FP_TRUNC)     { ret "MIR_FP_TRUNC"; }
    if (op == MIR_FP_EXT)       { ret "MIR_FP_EXT"; }
    if (op == MIR_FP_TO_SI)     { ret "MIR_FP_TO_SI"; }
    if (op == MIR_FP_TO_UI)     { ret "MIR_FP_TO_UI"; }
    if (op == MIR_SI_TO_FP)     { ret "MIR_SI_TO_FP"; }
    if (op == MIR_UI_TO_FP)     { ret "MIR_UI_TO_FP"; }
    if (op == MIR_BITCAST)      { ret "MIR_BITCAST"; }
    if (op == MIR_ALLOCA)       { ret "MIR_ALLOCA"; }
    if (op == MIR_LOAD)         { ret "MIR_LOAD"; }
    if (op == MIR_STORE)        { ret "MIR_STORE"; }
    if (op == MIR_GEP)          { ret "MIR_GEP"; }
    if (op == MIR_EXTRACT)      { ret "MIR_EXTRACT"; }
    if (op == MIR_INSERT)       { ret "MIR_INSERT"; }
    if (op == MIR_PHI)          { ret "MIR_PHI"; }
    if (op == MIR_CALL_IR)      { ret "MIR_CALL_IR"; }
    if (op == MIR_BR)           { ret "MIR_BR"; }
    if (op == MIR_CBR)          { ret "MIR_CBR"; }
    if (op == MIR_RET)          { ret "MIR_RET"; }
    if (op == MIR_UNREACHABLE)  { ret "MIR_UNREACHABLE"; }
    if (op == MIR_ASM)          { ret "MIR_ASM"; }
    if (op == MIR_MOV)          { ret "MIR_MOV"; }
    if (op == MIR_ARG)          { ret "MIR_ARG"; }
    if (op == MIR_CALL)         { ret "MIR_CALL"; }
    if (op == MIR_CALL_RES)     { ret "MIR_CALL_RES"; }
    if (op == MIR_DECLASSIFY)   { ret "MIR_DECLASSIFY"; }
    if (op == MIR_VEC_EXTRACT)  { ret "MIR_VEC_EXTRACT"; }
    if (op == MIR_VEC_INSERT)   { ret "MIR_VEC_INSERT"; }
    if (op == MIR_SEL_ADD)      { ret "MIR_SEL_ADD"; }
    if (op == MIR_SEL_SUB)      { ret "MIR_SEL_SUB"; }
    if (op == MIR_SEL_MUL)      { ret "MIR_SEL_MUL"; }
    if (op == MIR_SEL_AND)      { ret "MIR_SEL_AND"; }
    if (op == MIR_SEL_OR)       { ret "MIR_SEL_OR"; }
    if (op == MIR_SEL_XOR)      { ret "MIR_SEL_XOR"; }
    if (op == MIR_SEL_SHL)      { ret "MIR_SEL_SHL"; }
    if (op == MIR_SEL_SHR_U)    { ret "MIR_SEL_SHR_U"; }
    if (op == MIR_SEL_SHR_S)    { ret "MIR_SEL_SHR_S"; }
    if (op == MIR_SEL_DIV_S)    { ret "MIR_SEL_DIV_S"; }
    if (op == MIR_SEL_DIV_U)    { ret "MIR_SEL_DIV_U"; }
    if (op == MIR_SEL_REM_S)    { ret "MIR_SEL_REM_S"; }
    if (op == MIR_SEL_REM_U)    { ret "MIR_SEL_REM_U"; }
    if (op == MIR_SEL_CMP_EQ)   { ret "MIR_SEL_CMP_EQ"; }
    if (op == MIR_SEL_CMP_NE)   { ret "MIR_SEL_CMP_NE"; }
    if (op == MIR_SEL_CMP_LT_S) { ret "MIR_SEL_CMP_LT_S"; }
    if (op == MIR_SEL_CMP_LT_U) { ret "MIR_SEL_CMP_LT_U"; }
    if (op == MIR_SEL_CMP_LE_S) { ret "MIR_SEL_CMP_LE_S"; }
    if (op == MIR_SEL_CMP_LE_U) { ret "MIR_SEL_CMP_LE_U"; }
    if (op == MIR_SEL_CBR)      { ret "MIR_SEL_CBR"; }
    if (op == MIR_SEL_CBR_EQ)   { ret "MIR_SEL_CBR_EQ"; }
    if (op == MIR_SEL_CBR_NE)   { ret "MIR_SEL_CBR_NE"; }
    if (op == MIR_SEL_CBR_LT_S) { ret "MIR_SEL_CBR_LT_S"; }
    if (op == MIR_SEL_CBR_LT_U) { ret "MIR_SEL_CBR_LT_U"; }
    if (op == MIR_SEL_CBR_LE_S) { ret "MIR_SEL_CBR_LE_S"; }
    if (op == MIR_SEL_CBR_LE_U) { ret "MIR_SEL_CBR_LE_U"; }
    if (op == MIR_FADD)         { ret "MIR_FADD"; }
    if (op == MIR_FSUB)         { ret "MIR_FSUB"; }
    if (op == MIR_FMUL)         { ret "MIR_FMUL"; }
    if (op == MIR_FDIV)         { ret "MIR_FDIV"; }
    if (op == MIR_FCMP)         { ret "MIR_FCMP"; }
    if (op == MIR_FNEG)         { ret "MIR_FNEG"; }
    ret "<unknown MIR opcode>";
}

# compose a backend's refusal of one instruction into a located, greppable message
#
# The shared spelling of a refusal, so a backend that cannot lower something says
# which instruction, in which function, at which source position, rather than the
# bare sentence that made localizing a bisection (#2656). The shape follows the one
# #2538 settled on for the IR verifier: `<what> (<opcode> in <function>, at
# <path>:<line>:<col>)`.
#
# The function is passed already resolved rather than as a `MirFunction`, because
# what a function should be CALLED is the caller's knowledge: a MIR function
# carries only its mangled link name, and a backend holding the IR beside it can
# name the readable one. MIR owns the opcode and the location; it does not own the
# vocabulary.
#
# A location is not always available - compiler-synthesized MIR carries no source
# origin, and a caller may have no source map. That case says so rather than
# silently dropping the clause, which is the outcome #2538 ruled out: a message
# that quietly omits the position reads as though the position was never plumbed.
# ---
# alloc:   allocator the returned message is built on
# srcmap:  source map resolving the instruction's SrcLoc, or nil when unavailable
# fn_name: what to call the enclosing function
# mi:      the instruction refused, or nil when the refusal names no instruction
# what:    the backend's own sentence, used verbatim as the message head
# ret:     the composed message (on `alloc`), or `what` unchanged on format failure
pub fun instr_refusal(alloc: *A.Allocator, srcmap: *source.SourceMap,
                      fn_name: str, mi: *MirInstr, what: str) str {
    if (mi == nil) {
        val fj: R.Result[str, str] = format.sprint(alloc, "{} (in {})", what, fn_name);
        if (R.is_err[str, str](fj)) { ret what; }
        ret R.unwrap_ok[str, str](fj);
    }

    val opc: str = opcode_name(mi.opcode);
    val where: O.Option[str] = refusal_where(mi.loc, srcmap, alloc);

    var rj: R.Result[str, str];
    if (O.is_some[str](where)) {
        rj = format.sprint(alloc, "{} ({} in {}, at {})", what, opc, fn_name,
                           O.unwrap[str](where));
    }
    or {
        rj = format.sprint(alloc, "{} ({} in {}; no source location on this instruction)",
                           what, opc, fn_name);
    }
    if (R.is_err[str, str](rj)) { ret what; }
    ret R.unwrap_ok[str, str](rj);
}

# render a SrcLoc as `path:line:col`, or none when it cannot be resolved
fun refusal_where(l: source.SrcLoc, srcmap: *source.SourceMap,
                  alloc: *A.Allocator) O.Option[str] {
    if (!source.loc_is_valid(l)) { ret O.none[str](); }
    if (srcmap == nil)           { ret O.none[str](); }
    val of: O.Option[*source.SourceFile] = source.get(srcmap, l.file);
    if (O.is_none[*source.SourceFile](of)) { ret O.none[str](); }
    val f: *source.SourceFile = O.unwrap[*source.SourceFile](of);

    val p: source.Position = source.position(f, l.offset);
    val rj: R.Result[str, str] = format.sprint(alloc, "{}:{}:{}", f.path, p.line, p.col);
    if (R.is_err[str, str](rj)) { ret O.none[str](); }
    ret O.some[str](R.unwrap_ok[str, str](rj));
}

# the per-source-module unit produced by `lower_ir`
# ---
# alloc:        allocator backing every owned array (mirrors the IR module's)
# interner:     the session interner, threaded through so the encoder can resolve
#               interned strings (inline-asm bodies) and intern new symbol names
#               referenced from inline asm into relocations
# srcmap:       the session source map, borrowed read-only so the encoder can
#               resolve an instruction's SrcLoc to "path:line:col" in a
#               diagnostic (#2153); nil in unit-test states, degrading the
#               location prefix away
# functions:    MIR functions, parallel to the source IR module's functions (owned)
# function_len: number of functions
# function_cap: allocated capacity for functions
pub rec MirModule {
    alloc:        *A.Allocator;
    interner:     *intern.Interner;
    srcmap:       *source.SourceMap;
    functions:    *MirFunction;
    function_len: u32;
    function_cap: u32;
}

# initial capacities for the MIR module's growable backing arrays
pub val INITIAL_FN_CAP:    u32 = 8;
pub val INITIAL_VREG_CAP:  u32 = 32;
pub val INITIAL_INSTR_CAP: u32 = 16;
pub val INITIAL_SLOT_CAP:  u32 = 8;

# report whether the encoder emits instruction `mi` of function `f`
#
# The whole of `#[naked]`'s "body as written" contract, in one predicate every
# target's encoder reads rather than three copies of the rule (#2198). A naked
# function emits its inline asm and NOTHING else: not the prologue and epilogue
# (`frame.omit` already suppresses those), not the argument moves - the body owns
# the ABI registers as they arrive - and not the terminator, whose `ret` would
# return through a stack or link register only the author's asm understands. That
# last one is the `ret`-instead-of-`iret` bug an interrupt handler exists to avoid,
# and the return-value materialization ahead of it is compiler-written code in a
# body that declared it would have none.
#
# Sema restricts a naked body to `asm` statements, so what this drops is only ever
# code the compiler synthesized around them.
# ---
# f:   the function being encoded
# mi:  the instruction to judge
# ret: true when the encoder must emit it
pub fun emits_instr(f: *MirFunction, mi: *MirInstr) bool {
    if (!f.naked) { ret true; }
    # an inline-asm block survives selection under a per-target opcode (x86-64 retags
    # it to ASM_BLOCK), but its payload pointer is set on every target - so the
    # payload, not the opcode, identifies it.
    ret mi.asm_block != nil;
}

# build a virtual-register operand
# ---
# vreg: virtual register id
# ret:  a MIR_OP_VREG operand
pub fun op_vreg(vreg: u32) MirOperand {
    var o: MirOperand;
    o.kind          = MIR_OP_VREG;
    o.vreg          = vreg;
    o.preg          = 0;
    o.imm           = 0;
    o.sym           = intern.STR_NIL;
    o.sym_off       = 0;
    o.index         = MIR_VREG_NIL;
    o.scale         = 0;
    o.index_is_preg = false;
    o.sym_got       = false;
    ret o;
}

# build a physical-register operand
# ---
# preg: physical register id within its class
# ret:  a MIR_OP_PREG operand
pub fun op_preg(preg: u32) MirOperand {
    var o: MirOperand;
    o.kind          = MIR_OP_PREG;
    o.vreg          = MIR_VREG_NIL;
    o.preg          = preg;
    o.imm           = 0;
    o.sym           = intern.STR_NIL;
    o.sym_off       = 0;
    o.index         = MIR_VREG_NIL;
    o.scale         = 0;
    o.index_is_preg = false;
    o.sym_got       = false;
    ret o;
}

# build an immediate operand
# ---
# imm: immediate value
# ret: a MIR_OP_IMM operand
pub fun op_imm(imm: i64) MirOperand {
    var o: MirOperand;
    o.kind          = MIR_OP_IMM;
    o.vreg          = MIR_VREG_NIL;
    o.preg          = 0;
    o.imm           = imm;
    o.sym           = intern.STR_NIL;
    o.sym_off       = 0;
    o.index         = MIR_VREG_NIL;
    o.scale         = 0;
    o.index_is_preg = false;
    o.sym_got       = false;
    ret o;
}

# build a memory operand whose base is a frame-slot key
#
# `slotkey` is a slot-owning vreg id; the encoder resolves it to
# `[rbp + slot.offset + disp]` via the frame layout. regalloc never
# register-allocates a slot-owning vreg, so this base survives unchanged into
# encode.
# ---
# slotkey: slot-owning vreg id (alloca pointer, two-register param spill, or
#          register-allocator spill slot)
# disp:    displacement in bytes
# ret:     a MIR_OP_MEM operand with a frame-slot-key base
pub fun op_mem_slot(slotkey: u32, disp: i64) MirOperand {
    var o: MirOperand;
    o.kind          = MIR_OP_MEM;
    o.vreg          = slotkey;
    o.preg          = 0;
    o.imm           = disp;
    o.sym           = intern.STR_NIL;
    o.sym_off       = 0;
    o.index         = MIR_VREG_NIL;
    o.scale         = 0;
    o.index_is_preg = false;
    o.sym_got       = false;
    ret o;
}

# build a memory operand whose base is a physical register
#
# Used for direct RBP/RSP bases (stack-parameter loads, outgoing stack-argument
# stores) and for value-pointer bases regalloc has resolved to a physical
# register. The encoder forms `[preg + disp]`.
# ---
# preg: physical register id of the base
# disp: displacement in bytes
# ret:  a MIR_OP_MEM operand with a physical-register base
pub fun op_mem_preg(preg: u32, disp: i64) MirOperand {
    var o: MirOperand;
    o.kind          = MIR_OP_MEM;
    o.vreg          = MIR_VREG_NIL;
    o.preg          = preg;
    o.imm           = disp;
    o.sym           = intern.STR_NIL;
    o.sym_off       = 0;
    o.index         = MIR_VREG_NIL;
    o.scale         = 0;
    o.index_is_preg = false;
    o.sym_got       = false;
    ret o;
}

# build a memory operand whose base is a value vreg holding a runtime pointer
#
# Pre-regalloc only; regalloc rewrites this base to its assigned physical
# register (the `op_mem_preg` form). A value vreg in a MEM base must not survive
# register allocation.
# ---
# base: value virtual register id holding the pointer
# disp: displacement in bytes
# ret:  a MIR_OP_MEM operand with a value-vreg base
pub fun op_mem_value(base: u32, disp: i64) MirOperand {
    var o: MirOperand;
    o.kind          = MIR_OP_MEM;
    o.vreg          = base;
    o.preg          = 0;
    o.imm           = disp;
    o.sym           = intern.STR_NIL;
    o.sym_off       = 0;
    o.index         = MIR_VREG_NIL;
    o.scale         = 0;
    o.index_is_preg = false;
    o.sym_got       = false;
    ret o;
}

# build a symbol-reference operand
# ---
# sym:     interned symbol name
# sym_off: addend applied to the symbol
# ret:     a MIR_OP_SYM operand
pub fun op_sym(sym: intern.StrId, sym_off: i32) MirOperand {
    var o: MirOperand;
    o.kind          = MIR_OP_SYM;
    o.vreg          = MIR_VREG_NIL;
    o.preg          = 0;
    o.imm           = 0;
    o.sym           = sym;
    o.sym_off       = sym_off;
    o.index         = MIR_VREG_NIL;
    o.scale         = 0;
    o.index_is_preg = false;
    o.sym_got       = false;
    ret o;
}

# build a branch-target block operand
# ---
# block: target block id
# ret:   a MIR_OP_BLOCK operand
pub fun op_block(block: u32) MirOperand {
    var o: MirOperand;
    o.kind          = MIR_OP_BLOCK;
    o.vreg          = MIR_VREG_NIL;
    o.preg          = 0;
    o.imm           = block::i64;
    o.sym           = intern.STR_NIL;
    o.sym_off       = 0;
    o.index         = MIR_VREG_NIL;
    o.scale         = 0;
    o.index_is_preg = false;
    o.sym_got       = false;
    ret o;
}

# whether a vreg id names a float/vector-bank value (a non-GP register class)
#
# Exposed so instruction selection can identify a float register copy from the
# function's recorded vreg classes without hardcoding the GP class convention. An
# out-of-range vreg id is not an FP value.
# ---
# fn:   the MIR function owning the vreg table
# vreg: the vreg id to test
# ret:  true when the vreg's class is the float/vector bank
pub fun vreg_is_fp(fn: *MirFunction, vreg: u32) bool {
    if (vreg >= fn.vreg_count) { ret false; }
    ret fn.vregs[vreg].class != REG_CLASS_GP;
}

# append a lowered function to the MIR module, growing the function array
# ---
# mm:  the module to append to
# mf:  the lowered function to append (copied into the array)
# ret: true on success, or an allocation error
pub fun push_function(mm: *MirModule, mf: MirFunction) R.Result[bool, str] {
    if (mm.function_len == mm.function_cap) {
        var new_cap: u32 = mm.function_cap * 2;

        if (new_cap == 0) { new_cap = INITIAL_FN_CAP; }

        if (mm.functions == nil) {
            val res_alloc: R.Result[*MirFunction, str] = A.allocate[MirFunction](mm.alloc, new_cap::usize);
            if (R.is_err[*MirFunction, str](res_alloc)) {
                ret R.err[bool, str](R.unwrap_err[*MirFunction, str](res_alloc));
            }
            mm.functions = R.unwrap_ok[*MirFunction, str](res_alloc);
        }
        or {
            val res_realloc: R.Result[*MirFunction, str] = A.reallocate[MirFunction](mm.alloc, mm.functions, mm.function_cap::usize, new_cap::usize);
            if (R.is_err[*MirFunction, str](res_realloc)) {
                ret R.err[bool, str](R.unwrap_err[*MirFunction, str](res_realloc));
            }
            mm.functions = R.unwrap_ok[*MirFunction, str](res_realloc);
        }

        mm.function_cap = new_cap;
    }

    mm.functions[mm.function_len] = mf;
    mm.function_len = mm.function_len + 1;
    ret R.ok[bool, str](true);
}

# append one `-g` source-variable binding (`iid` -> `vreg`) to a MirInstr's ordered
# binding list, growing it by one. -g only; called at lowering to attach a pending
# OP_DBG_VALUE binding to the instruction at whose PC the variable becomes live
# ---
# a:    the allocator backing the list
# mi:   the instruction to attach to
# iid:  the IR OP_DBG_VALUE instruction id
# vreg: the operand's MIR vreg, or MIR_VREG_NIL for no home
# ret:  true on success, or an allocation error
pub fun instr_attach_dbg(a: *A.Allocator, mi: *MirInstr, iid: u32, vreg: u32) R.Result[bool, str] {
    val n: u32 = mi.dbg_binding_count;
    if (mi.dbg_bindings == nil) {
        val ra: R.Result[*MirDbgBinding, str] = A.allocate[MirDbgBinding](a, 1::usize);
        if (R.is_err[*MirDbgBinding, str](ra)) { ret R.err[bool, str](R.unwrap_err[*MirDbgBinding, str](ra)); }
        mi.dbg_bindings = R.unwrap_ok[*MirDbgBinding, str](ra);
    }
    or {
        val rr: R.Result[*MirDbgBinding, str] = A.reallocate[MirDbgBinding](a, mi.dbg_bindings, n::usize, (n + 1)::usize);
        if (R.is_err[*MirDbgBinding, str](rr)) { ret R.err[bool, str](R.unwrap_err[*MirDbgBinding, str](rr)); }
        mi.dbg_bindings = R.unwrap_ok[*MirDbgBinding, str](rr);
    }
    mi.dbg_bindings[n].iid  = iid;
    mi.dbg_bindings[n].vreg = vreg;
    # a lowering-attached binding is always plain; the compare payload is only
    # ever written by the rules-layer fusion.
    mi.dbg_bindings[n].cmp_op     = 0;
    mi.dbg_bindings[n].cmp_width  = 0;
    mi.dbg_bindings[n].lhs_is_imm = false;
    mi.dbg_bindings[n].rhs_is_imm = false;
    mi.dbg_bindings[n].vreg2      = MIR_VREG_NIL;
    mi.dbg_bindings[n].imm        = 0;
    mi.dbg_bindings[n].imm2       = 0;
    mi.dbg_binding_count = n + 1;
    ret R.ok[bool, str](true);
}

# release every owned array in a MIR module, safe on a partially built module and on nil
# ---
# mm: the module to tear down; all owned storage is freed and fields zeroed
pub fun dnit_module(mm: *MirModule) {
    if (mm == nil) { ret; }

    var i: u32 = 0;
    for (i < mm.function_len) {
        dnit_function(mm.alloc, ?mm.functions[i]);
        i = i + 1;
    }
    if (mm.functions != nil && mm.function_cap > 0) {
        A.deallocate[MirFunction](mm.alloc, mm.functions, mm.function_cap::usize);
    }

    mm.functions    = nil;
    mm.function_len = 0;
    mm.function_cap = 0;
}

# release one MIR function's owned storage: its blocks (and their nested
# instruction / operand / pred storage), the vreg table, and the frame slots
# ---
# a:  allocator the function's storage was allocated from
# mf: the function to tear down; owned storage is freed and counts zeroed
pub fun dnit_function(a: *A.Allocator, mf: *MirFunction) {
    var i: u32 = 0;
    for (i < mf.block_count) {
        dnit_block(a, ?mf.blocks[i]);
        i = i + 1;
    }
    if (mf.blocks != nil && mf.block_cap > 0) {
        A.deallocate[MirBlock](a, mf.blocks, mf.block_cap::usize);
    }
    if (mf.vregs != nil && mf.vreg_cap > 0) {
        A.deallocate[MirVReg](a, mf.vregs, mf.vreg_cap::usize);
    }
    if (mf.frame.slots != nil && mf.frame.slot_cap > 0) {
        A.deallocate[MirSlot](a, mf.frame.slots, mf.frame.slot_cap::usize);
    }

    mf.blocks        = nil;
    mf.block_count   = 0;
    mf.block_cap     = 0;
    mf.vregs         = nil;
    mf.vreg_count    = 0;
    mf.vreg_cap      = 0;
}

# release one MIR block's owned storage: every instruction's operand array (and
# any inline-asm payload), the block's instruction list, and its predecessor list
# ---
# a:  allocator the block's storage was allocated from
# mb: the block to tear down; owned storage is freed
fun dnit_block(a: *A.Allocator, mb: *MirBlock) {
    var i: u32 = 0;
    for (i < mb.instr_count) {
        val mi: *MirInstr = ?mb.instrs[i];
        if (mi.operands != nil && mi.operand_count > 0) {
            A.deallocate[MirOperand](a, mi.operands, mi.operand_count::usize);
        }
        if (mi.dbg_bindings != nil && mi.dbg_binding_count > 0) {
            A.deallocate[MirDbgBinding](a, mi.dbg_bindings, mi.dbg_binding_count::usize);
        }
        if (mi.opcode == MIR_ASM && mi.asm_block != nil) {
            if (mi.asm_block.binds != nil && mi.asm_block.bind_count > 0) {
                A.deallocate[MirAsmBind](a, mi.asm_block.binds, mi.asm_block.bind_count::usize);
            }
            A.deallocate[MirAsm](a, mi.asm_block, 1::usize);
        }
        i = i + 1;
    }
    if (mb.instrs != nil && mb.instr_cap > 0) {
        A.deallocate[MirInstr](a, mb.instrs, mb.instr_cap::usize);
    }
    if (mb.preds != nil && mb.pred_cap > 0) {
        A.deallocate[u32](a, mb.preds, mb.pred_cap::usize);
    }
}

# the comparison family and the fused compare-and-branch family are contiguous in
# the same relation order, so `fused_cbr_opcode` is a total arithmetic map over
# the opcodes `is_cmp_opcode` admits, and `is_fused_cbr` recognizes exactly its
# image and nothing adjacent to it
test "mach.lang.be.codegen.mir.fused_cbr:mapping" {
    if (fused_cbr_opcode(MIR_CMP_EQ)   != MIR_SEL_CBR_EQ)   { ret 1; }
    if (fused_cbr_opcode(MIR_CMP_NE)   != MIR_SEL_CBR_NE)   { ret 1; }
    if (fused_cbr_opcode(MIR_CMP_LT_S) != MIR_SEL_CBR_LT_S) { ret 1; }
    if (fused_cbr_opcode(MIR_CMP_LT_U) != MIR_SEL_CBR_LT_U) { ret 1; }
    if (fused_cbr_opcode(MIR_CMP_LE_S) != MIR_SEL_CBR_LE_S) { ret 1; }
    if (fused_cbr_opcode(MIR_CMP_LE_U) != MIR_SEL_CBR_LE_U) { ret 1; }

    if (!is_cmp_opcode(MIR_CMP_EQ))   { ret 1; }
    if (!is_cmp_opcode(MIR_CMP_LE_U)) { ret 1; }
    if (is_cmp_opcode(MIR_NOT))       { ret 1; }  # 14, adjacent below
    if (is_cmp_opcode(MIR_TRUNC))     { ret 1; }  # 21, adjacent above

    if (!is_fused_cbr(MIR_SEL_CBR_EQ))   { ret 1; }
    if (!is_fused_cbr(MIR_SEL_CBR_LE_U)) { ret 1; }
    if (is_fused_cbr(MIR_SEL_CBR))       { ret 1; }
    if (is_fused_cbr(0x111F))            { ret 1; }  # adjacent below
    if (is_fused_cbr(0x1126))            { ret 1; }  # adjacent above
    ret 0;
}

# the vec_lane descriptor packs the element kind (high nibble) and byte-width (low
# nibble), with 0 the non-vector sentinel and the lane count implied by 16 / bytes.
test "mach.lang.be.codegen.mir.vec_lane:pack_unpack" {
    # the non-vector sentinel.
    if (vec_lane_is_vector(VEC_LANE_NONE))  { ret 1; }
    if (vec_lane_count(VEC_LANE_NONE) != 0) { ret 1; }

    # f32x4: float lanes, 4-byte element, 4 lanes.
    val f4: u8 = vec_lane_make(VEC_LANE_FLOAT, 4);
    if (!vec_lane_is_vector(f4))             { ret 1; }
    if (vec_lane_kind(f4) != VEC_LANE_FLOAT) { ret 1; }
    if (vec_lane_elem_bytes(f4) != 4)        { ret 1; }
    if (vec_lane_count(f4) != 4)             { ret 1; }

    # f64x2: float lanes, 8-byte element, 2 lanes.
    val f8: u8 = vec_lane_make(VEC_LANE_FLOAT, 8);
    if (vec_lane_kind(f8) != VEC_LANE_FLOAT) { ret 1; }
    if (vec_lane_count(f8) != 2)             { ret 1; }

    # every integer element width recovers its lane count (i8x16 / i16x8 / i32x4 / i64x2).
    if (vec_lane_count(vec_lane_make(VEC_LANE_INT, 1)) != 16) { ret 1; }
    if (vec_lane_count(vec_lane_make(VEC_LANE_INT, 2)) != 8)  { ret 1; }
    if (vec_lane_count(vec_lane_make(VEC_LANE_INT, 4)) != 4)  { ret 1; }
    if (vec_lane_count(vec_lane_make(VEC_LANE_INT, 8)) != 2)  { ret 1; }

    # kind and byte-width are independent nibbles.
    val i2: u8 = vec_lane_make(VEC_LANE_INT, 2);
    if (vec_lane_kind(i2) != VEC_LANE_INT) { ret 1; }
    if (vec_lane_elem_bytes(i2) != 2)      { ret 1; }
    ret 0;
}

# `instr` CLEARS EVERY FIELD IT DOES NOT TAKE.
#
# The five parameters land where they are named and the seven metadata fields come
# back neutral, so an instruction built outside the `push_instr` chokepoint carries
# defined metadata rather than the caller's stack.
test "mach.lang.be.codegen.mir.instr:clears_the_metadata" {
    var ops: [2]MirOperand;
    val mi: MirInstr = instr(MIR_MOV, ?ops[0], 2, 8, 4);

    if (mi.opcode != MIR_MOV)      { ret 1; }
    if (mi.operands != ?ops[0])    { ret 1; }
    if (mi.operand_count != 2)     { ret 1; }
    if (mi.width != 8)             { ret 1; }
    if (mi.src_width != 4)         { ret 1; }

    if (mi.asm_block != nil)         { ret 1; }
    if (mi.dbg_bindings != nil)      { ret 1; }
    if (mi.dbg_binding_count != 0)   { ret 1; }
    if (mi.inline_site != 0)         { ret 1; }
    if (mi.vec_lane != VEC_LANE_NONE) { ret 1; }
    if (mi.writes_secret)            { ret 1; }
    ret 0;
}

# `instr_like` CARRIES EVERY FIELD, INCLUDING ONES THAT DO NOT EXIST YET.
#
# The guard #2032 needed. A rewrite that rebuilds an instruction field by field
# drops whatever field it was not taught about - there, `vec_lane`, which left every
# rewritten vector op reading as element bytes 0 and collapsed the NEON arrangement
# to `.16b` after register assignment. Asserting the fields one by one would repeat
# that mistake in the test, so this compares the WHOLE RECORD: derive with the same
# operand list the source already carries, and the result must be byte-identical to
# it. A field added to `MirInstr` that the derive forgets fails this with no edit.
#
# Both records are pattern-filled first, so any padding the layout holds agrees
# whether a whole-record assignment lowers to a memcpy or to field-wise moves.
#
# To see it fail, replace the whole-record copy in `instr_like` with a field-by-field
# rebuild that omits one field.
test "mach.lang.be.codegen.mir.instr_like:carries_every_field" {
    var src: MirInstr = instr(MIR_ADD, nil, 0, 0, 0);
    var out: MirInstr = instr(MIR_ADD, nil, 0, 0, 0);
    memory.raw_fill((?src)::ptr, 0xA5, $size_of(MirInstr));
    memory.raw_fill((?out)::ptr, 0xA5, $size_of(MirInstr));

    out = instr_like(?src, src.operands, src.operand_count);
    if (!memory.equal[MirInstr](?out, ?src, 1)) { ret 1; }

    # and the operand list really is the one passed, not the source's
    var ops: [3]MirOperand;
    val moved: MirInstr = instr_like(?src, ?ops[0], 3);
    if (moved.operands != ?ops[0]) { ret 1; }
    if (moved.operand_count != 3)  { ret 1; }
    if (moved.opcode != src.opcode)     { ret 1; }
    if (moved.vec_lane != src.vec_lane) { ret 1; }
    ret 0;
}

# every opcode names itself, and the table is TOTAL over the opcode space
#
# A backend refusal that names the wrong instruction is worse than one that names
# none, so the property under test is not "some names come back" but that no two
# opcodes share a name and none falls through to the unknown fallback. A new
# opcode added without an arm here is exactly the regression that produces a
# refusal pointing at the wrong thing, and the sweep below is what catches it.
#
# The sweep walks the declared opcode VALUES rather than a dense range: the space
# is deliberately sparse (the selected forms start at 0x1000), so a dense walk
# would spend most of its time on values that are not opcodes at all.
test "mach.lang.be.codegen.mir.opcode_name:total_and_distinct" {
    var ops: [83]MirOpcode;
    ops[0]  = MIR_ADD;         ops[1]  = MIR_SUB;         ops[2]  = MIR_MUL;
    ops[3]  = MIR_DIV_S;       ops[4]  = MIR_DIV_U;       ops[5]  = MIR_REM_S;
    ops[6]  = MIR_REM_U;       ops[7]  = MIR_NEG;         ops[8]  = MIR_AND;
    ops[9]  = MIR_OR;          ops[10] = MIR_XOR;         ops[11] = MIR_SHL;
    ops[12] = MIR_SHR_S;       ops[13] = MIR_SHR_U;       ops[14] = MIR_NOT;
    ops[15] = MIR_CMP_EQ;      ops[16] = MIR_CMP_NE;      ops[17] = MIR_CMP_LT_S;
    ops[18] = MIR_CMP_LT_U;    ops[19] = MIR_CMP_LE_S;    ops[20] = MIR_CMP_LE_U;
    ops[21] = MIR_TRUNC;       ops[22] = MIR_SEXT;        ops[23] = MIR_ZEXT;
    ops[24] = MIR_FP_TRUNC;    ops[25] = MIR_FP_EXT;      ops[26] = MIR_FP_TO_SI;
    ops[27] = MIR_FP_TO_UI;    ops[28] = MIR_SI_TO_FP;    ops[29] = MIR_UI_TO_FP;
    ops[30] = MIR_BITCAST;     ops[31] = MIR_ALLOCA;      ops[32] = MIR_LOAD;
    ops[33] = MIR_STORE;       ops[34] = MIR_GEP;         ops[35] = MIR_EXTRACT;
    ops[36] = MIR_INSERT;      ops[37] = MIR_PHI;         ops[38] = MIR_CALL_IR;
    ops[39] = MIR_BR;          ops[40] = MIR_CBR;         ops[41] = MIR_RET;
    ops[42] = MIR_UNREACHABLE; ops[43] = MIR_ASM;         ops[44] = MIR_MOV;
    ops[45] = MIR_ARG;         ops[46] = MIR_CALL;        ops[47] = MIR_CALL_RES;
    ops[48] = MIR_DECLASSIFY;  ops[49] = MIR_VEC_EXTRACT; ops[50] = MIR_VEC_INSERT;
    ops[51] = MIR_SEL_ADD;     ops[52] = MIR_SEL_SUB;     ops[53] = MIR_SEL_MUL;
    ops[54] = MIR_SEL_AND;     ops[55] = MIR_SEL_OR;      ops[56] = MIR_SEL_XOR;
    ops[57] = MIR_SEL_SHL;     ops[58] = MIR_SEL_SHR_U;   ops[59] = MIR_SEL_SHR_S;
    ops[60] = MIR_SEL_DIV_S;   ops[61] = MIR_SEL_DIV_U;   ops[62] = MIR_SEL_REM_S;
    ops[63] = MIR_SEL_REM_U;   ops[64] = MIR_SEL_CMP_EQ;  ops[65] = MIR_SEL_CMP_NE;
    ops[66] = MIR_SEL_CMP_LT_S; ops[67] = MIR_SEL_CMP_LT_U; ops[68] = MIR_SEL_CMP_LE_S;
    ops[69] = MIR_SEL_CMP_LE_U; ops[70] = MIR_SEL_CBR;    ops[71] = MIR_SEL_CBR_EQ;
    ops[72] = MIR_SEL_CBR_NE;  ops[73] = MIR_SEL_CBR_LT_S; ops[74] = MIR_SEL_CBR_LT_U;
    ops[75] = MIR_SEL_CBR_LE_S; ops[76] = MIR_SEL_CBR_LE_U; ops[77] = MIR_FADD;
    ops[78] = MIR_FSUB;        ops[79] = MIR_FMUL;        ops[80] = MIR_FDIV;
    ops[81] = MIR_FCMP;        ops[82] = MIR_FNEG;

    var i: usize = 0;
    for (i < 83) {
        val n: str = opcode_name(ops[i]);
        # total: no declared opcode reaches the fallback
        if (str_equals(n, "<unknown MIR opcode>")) { ret 1; }
        # distinct: no two opcodes answer with the same name
        var j: usize = 0;
        for (j < i) {
            if (str_equals(opcode_name(ops[j]), n)) { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }

    # a spot check that the name is the SOURCE spelling, which is what makes it
    # greppable - a mnemonic would satisfy total-and-distinct just as well
    if (!str_equals(opcode_name(MIR_DIV_S), "MIR_DIV_S")) { ret 1; }
    if (!str_equals(opcode_name(MIR_VEC_INSERT), "MIR_VEC_INSERT")) { ret 1; }

    # and a value outside the space degrades rather than reading as an opcode
    if (!str_equals(opcode_name(0xDEAD::MirOpcode), "<unknown MIR opcode>")) { ret 1; }
    ret 0;
}

# a refusal names the opcode and the function, and says so explicitly when the
# instruction carries no source origin
#
# The located form needs a source map to exercise, which a unit test has no
# cheap way to build; the SPIR-V surface case covers that half end to end. What
# is pinned here is the half a unit test can own: that the opcode and function
# reach the message at all, and that a locationless instruction produces the
# stated degradation rather than a message that silently drops the clause.
test "mach.lang.be.codegen.mir.instr_refusal:names_opcode_and_function" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var mi: MirInstr = instr(MIR_ALLOCA, nil, 0, 0, 0);
    val msg: str = instr_refusal(?alloc, nil::*source.SourceMap, "sum_pair", ?mi,
                                 "addressed memory is not yet supported");
    if (!str_contains(msg, "addressed memory is not yet supported")) { ret 1; }
    if (!str_contains(msg, "MIR_ALLOCA"))  { ret 1; }
    if (!str_contains(msg, "sum_pair"))    { ret 1; }
    # a missing location is stated, not omitted
    if (!str_contains(msg, "no source location on this instruction")) { ret 1; }

    # with no instruction the refusal still names its function and claims no opcode
    val fn_only: str = instr_refusal(?alloc, nil::*source.SourceMap, "sum_pair",
                                     nil::*MirInstr, "more than 16 parameters");
    if (!str_contains(fn_only, "more than 16 parameters")) { ret 1; }
    if (!str_contains(fn_only, "sum_pair"))                { ret 1; }
    if (str_contains(fn_only, "MIR_"))                     { ret 1; }
    ret 0;
}
