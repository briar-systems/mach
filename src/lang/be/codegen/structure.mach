}

# three tested arms: each inner selection forwards to the merge of the one outside it,
# never straight to the outermost join
test analyze__selection_chain_forwards_through_each_level {
    var alloc:  std_allocator.Allocator;
    val r_1284: err[std_allocator.Error] = page.make(?alloc);
    if (sel r_1284.err) { ret 1; }

    var o0:     [3]codegen_mir.MirOperand;
    var o2:     [3]codegen_mir.MirOperand;
    var o4:     [3]codegen_mir.MirOperand;
    var b1:     [1]codegen_mir.MirOperand;
    var b3:     [1]codegen_mir.MirOperand;
    var b5:     [1]codegen_mir.MirOperand;
    var b6:     [1]codegen_mir.MirOperand;
    var instrs: [8]codegen_mir.MirInstr;
    t_cbr(?instrs[0], ?o0[0], 1, 2);
    t_br(?instrs[1], ?b1[0], 7);
    t_cbr(?instrs[2], ?o2[0], 3, 4);
    t_br(?instrs[3], ?b3[0], 7);
    t_cbr(?instrs[4], ?o4[0], 5, 6);
    t_br(?instrs[5], ?b5[0], 7);
    t_br(?instrs[6], ?b6[0], 7);
    t_ret(?instrs[7]);
    var blocks: [8]codegen_mir.MirBlock;
    var i:      u32 = 0;
    for (i < 8) {
        t_block(?blocks[i], i, ?instrs[i]);
        i = i + 1;
    }
    var f: codegen_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 8;
    f.vreg_count  = 1;

    val r: res[Structure, fail.Fail] = analyze(?f, ?alloc);
    if (sel r.err) { ret 1; }
    var st: Structure = r.ok;
    var rc: i32       = 0;
    if (st.status != CFG_OK)    { rc = 2; }
    if (st.nodes[0].merge != 7) { rc = 3; }
    val m2: u32 = st.nodes[2].merge;
    val m4: u32 = st.nodes[4].merge;
    if (m2 < st.real || m4 < st.real || m2 == m4) { rc = 4; }
    if (rc == 0 && succ(?st, m2, 0) != 7)         { rc = 5; }
    if (rc == 0 && succ(?st, m4, 0) != m2)        { rc = 6; }
    if (rc == 0 && succ(?st, 3, 0) != m2)         { rc = 7; }
    if (rc == 0 && succ(?st, 5, 0) != m4)         { rc = 8; }
    if (rc == 0 && succ(?st, 6, 0) != m4)         { rc = 9; }
    if (rc == 0 && st.count != 10)                { rc = 10; }
    dnit(?st);
    ret rc;
}

# the same chain inside a loop body: the forward merge stays inside the loop, and a
# selection whose arms are a break and a continue still gets no merge of its own
test analyze__nested_selection_in_a_loop_forwards_inside_it {
