use mach.lang.fail;
use std.allocator.page;
use std_format: std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;

use std_allocator: std.allocator;

use codegen_mir: mach.lang.be.codegen.mir;

# the control-flow structure of one MIR function for a target that declares
# `structured_control_flow`: every construct with its header, merge and
# continue, and the synthetic blocks that make the function's branches enter and
# leave each construct only through those edges. nodes [0, real) are the MIR
# blocks in block order, and the nodes from `real` on are synthetic and hold no
# MIR block. an emitter writes the nodes in `order` and reads each node's
# successors through `succ`

pub val NO_BLOCK: u32 = 0xFFFFFFFF;

# the construct a node heads: a two-way selection, a loop, or a switch, which
# branches to one of any number of successors and merges like a selection
pub val CK_PLAIN:     u8 = 0;
pub val CK_SELECTION: u8 = 1;
pub val CK_LOOP:      u8 = 2;
pub val CK_SWITCH:    u8 = 3;

# what a node executes. a real node is its MIR block, whose terminator's block
# operands are its successors in operand order. a split node carries the
# terminator of the loop header it was split from, below the header's merge.
# continue and forward nodes branch to their one successor. an exit node stores
# its `case` into the selector of its `dispatch` node and branches to it, and a
# dispatch node branches to the successor its stored case names. nothing reaches
# an unreachable node
pub val ROLE_REAL:        u8 = 0;
pub val ROLE_CONTINUE:    u8 = 1;
pub val ROLE_UNREACHABLE: u8 = 2;
pub val ROLE_SPLIT:       u8 = 3;
pub val ROLE_FORWARD:     u8 = 4;
pub val ROLE_EXIT:        u8 = 5;
pub val ROLE_DISPATCH:    u8 = 6;

pub val CFG_OK:            u8 = 0;
pub val CFG_IRREDUCIBLE:   u8 = 1;
pub val CFG_UNREACHABLE:   u8 = 2;
pub val CFG_MULTIWAY:      u8 = 3;
pub val CFG_CROSSING_EDGE: u8 = 6;
pub val CFG_NO_TERMINATOR: u8 = 7;

pub rec Node {
    id:       u32;
    block:    u32;
    edge:     u32;
    nsucc:    u32;
    idom:     u32;
    rpo:      u32;
    kind:     u8;
    merge:    u32;
    cont:     u32;
    loop_hdr: u32;
    split:    u32;
    role:     u8;
    dispatch: u32;
    case:     u32;
}

pub rec Structure {
    alloc:    *std_allocator.Allocator;
    nodes:    *Node;
    count:    u32;
    real:     u32;
    cap:      u32;
    succs:    *u32;
    succ_len: u32;
    succ_cap: u32;
    order:    *u32;
    status:   u8;
    at:       u32;
    to:       u32;
}

# successor k of node x, for k below its nsucc
pub fun succ(st: *Structure, x: u32, k: u32) u32 {
    ret st.succs[st.nodes[x].edge + k];
}

fun set_succ(st: *Structure, x: u32, k: u32, v: u32) {
    st.succs[st.nodes[x].edge + k] = v;
}

pub fun analyze(mf: *codegen_mir.MirFunction, alloc: *std_allocator.Allocator) res[Structure, fail.Fail] {
    var st: Structure;
    st.alloc    = alloc;
    st.nodes    = nil;
    st.order    = nil;
    st.succs    = nil;
    st.count    = 0;
    st.real     = mf.block_count;
    st.cap      = 0;
    st.succ_len = 0;
    st.succ_cap = 0;
    st.status   = CFG_OK;
    st.at       = NO_BLOCK;
    st.to       = NO_BLOCK;

    val cap: u32                             = mf.block_count * 4 + 2;
    val rn:  res[*Node, std_allocator.Error] = std_allocator.allocate[Node](alloc, cap::usize);
    if (sel rn.err) { ret res[Structure, fail.Fail].err{fail.refused(rn.err)}; }
    st.nodes = rn.ok;
    st.cap   = cap;
    val ecap: u32                            = cap * 2;
    val re:   res[*u32, std_allocator.Error] = std_allocator.allocate[u32](alloc, ecap::usize);
    if (sel re.err) {
        dnit(?st);
        ret res[Structure, fail.Fail].err{fail.refused(re.err)};
    }
    st.succs    = re.ok;
    st.succ_cap = ecap;

    val rb: err[fail.Fail] = build_nodes(?st, mf);
    if (sel rb.err) {
        dnit(?st);
        ret res[Structure, fail.Fail].err{rb.err};
    }
    if (st.status != CFG_OK) { ret res[Structure, fail.Fail].ok{st}; }

    val rr: err[fail.Fail] = compute_rpo(?st);
    if (sel rr.err) {
        dnit(?st);
        ret res[Structure, fail.Fail].err{rr.err};
    }
    if (st.status != CFG_OK) { ret res[Structure, fail.Fail].ok{st}; }

    val rd: err[fail.Fail] = compute_idom(?st);
    if (sel rd.err) {
        dnit(?st);
        ret res[Structure, fail.Fail].err{rd.err};
    }

    val rl: err[fail.Fail] = find_loops(?st);
    if (sel rl.err) {
        dnit(?st);
        ret res[Structure, fail.Fail].err{rl.err};
    }
    if (st.status != CFG_OK) { ret res[Structure, fail.Fail].ok{st}; }

    val rm: err[fail.Fail] = assign_merges(?st);
    if (sel rm.err) {
        dnit(?st);
        ret res[Structure, fail.Fail].err{rm.err};
    }

    val bo: err[fail.Fail] = build_order(?st);
    if (sel bo.err) {
        dnit(?st);
        ret res[Structure, fail.Fail].err{bo.err};
    }
    verify(?st);
    ret res[Structure, fail.Fail].ok{st};
}

pub fun dnit(st: *Structure) {
    if (st.nodes != nil) {
        std_allocator.deallocate[Node](st.alloc, st.nodes, st.cap::usize);
        st.nodes = nil;
    }
    if (st.order != nil) {
        std_allocator.deallocate[u32](st.alloc, st.order, st.cap::usize);
        st.order = nil;
    }
    if (st.succs != nil) {
        std_allocator.deallocate[u32](st.alloc, st.succs, st.succ_cap::usize);
        st.succs = nil;
    }
    st.count    = 0;
    st.cap      = 0;
    st.succ_len = 0;
    st.succ_cap = 0;
}

# the structure of every function of a MIR module, in function order. a
# function the target cannot structure carries its refusal in its status, which
# the emitter reports where it emits that function
pub fun analyze_module(m: *codegen_mir.MirModule, alloc: *std_allocator.Allocator) res[*Structure, fail.Fail] {
    if (m.function_len == 0) { ret res[*Structure, fail.Fail].ok{nil}; }
    val ra: res[*Structure, std_allocator.Error] = std_allocator.allocate[Structure](alloc, m.function_len::usize);
    if (sel ra.err) { ret res[*Structure, fail.Fail].err{fail.refused(ra.err)}; }
    val out: *Structure = ra.ok;
    var i:   u32        = 0;
    for (i < m.function_len) {
        val r: res[Structure, fail.Fail] = analyze(?m.functions[i], alloc);
        if (sel r.err) {
            dnit_module(out, i, alloc);
            ret res[*Structure, fail.Fail].err{r.err};
        }
        out[i] = r.ok;
        i      = i + 1;
    }
    ret res[*Structure, fail.Fail].ok{out};
}

# releases the first n structures of an analyze_module result and the array
pub fun dnit_module(shapes: *Structure, n: u32, alloc: *std_allocator.Allocator) {
    if (shapes == nil) { ret; }
    var i: u32 = 0;
    for (i < n) {
        dnit(?shapes[i]);
        i = i + 1;
    }
    std_allocator.deallocate[Structure](alloc, shapes, n::usize);
}

# the refusal a function with this status is rejected by, prefixed with its name
pub fun refusal_text(alloc: *std_allocator.Allocator, name: str, status: u8, target: str) res[str, std_format.FormatError] {
    if (status == CFG_IRREDUCIBLE) {
        ret std_format.sprint(alloc, "{}: an irreducible loop (a loop entered at more than one block) is not expressible: the {} target requires structured control flow", name, target);
    }
    if (status == CFG_UNREACHABLE) {
        ret std_format.sprint(alloc, "{}: a block unreachable from the function entry is not expressible: the {} target requires structured control flow", name, target);
    }
    if (status == CFG_MULTIWAY) {
        ret std_format.sprint(alloc, "{}: a multi-way branch terminator is not yet structured for the {} target", name, target);
    }
    if (status == CFG_CROSSING_EDGE) {
        ret std_format.sprint(alloc, "{}: a branch that leaves a control-flow construct other than through its merge, break, or continue edge is not expressible: the {} target requires structured control flow", name, target);
    }
    ret std_format.sprint(alloc, "{}: a block with no terminator reached the {} target", name, target);
}

fun build_nodes(st: *Structure, mf: *codegen_mir.MirFunction) err[fail.Fail] {
    var i: u32 = 0;
    for (i < mf.block_count) {
        val blk: *codegen_mir.MirBlock = ?mf.blocks[i];
        var n:   Node                  = blank_node(ROLE_REAL);
        n.id        = blk.id;
        n.block     = i;
        st.nodes[i] = n;
        i           = i + 1;
    }
    st.count = mf.block_count;

    i = 0;
    for (i < mf.block_count) {
        val blk: *codegen_mir.MirBlock = ?mf.blocks[i];
        if (blk.instr_count == 0) {
            st.status = CFG_NO_TERMINATOR;
            st.at     = blk.id;
            ret err[fail.Fail].ok{};
        }
        val term:  *codegen_mir.MirInstr = ?blk.instrs[blk.instr_count - 1];
        var first: u32                   = 0;
        var n:     u32                   = 0;
        if (term.opcode == codegen_mir.MIR_BR) {
            if (term.operand_count < 1 || term.operands[0].kind != codegen_mir.MIR_OP_BLOCK) {
                st.status = CFG_NO_TERMINATOR;
                st.at     = blk.id;
                ret err[fail.Fail].ok{};
            }
            first = 0;
            n     = 1;
        }
        or (term.opcode == codegen_mir.MIR_CBR) {
            if (term.operand_count < 3 || term.operands[1].kind != codegen_mir.MIR_OP_BLOCK
                || term.operands[2].kind != codegen_mir.MIR_OP_BLOCK) {
                st.status = CFG_NO_TERMINATOR;
                st.at     = blk.id;
                ret err[fail.Fail].ok{};
            }
            first = 1;
            n     = 2;
        }
        or (term.opcode == codegen_mir.MIR_RET || term.opcode == codegen_mir.MIR_UNREACHABLE) { n = 0; }
        or {
            # a terminator outside these with block operands is a multi-way branch,
            # which MIR does not produce yet (#4376)
            if (instr_has_block_operand(term)) { st.status = CFG_MULTIWAY; }
            or                                 { st.status = CFG_NO_TERMINATOR; }
            st.at = blk.id;
            ret err[fail.Fail].ok{};
        }
        val e: u32 = push_edges(st, n);
        if (e == NO_BLOCK) { ret err[fail.Fail].err{fail.message("structure: successor allocation failed")}; }
        st.nodes[i].edge  = e;
        st.nodes[i].nsucc = n;
        var k: u32 = 0;
        for (k < n) {
            val s: u32 = node_of_id(st, term.operands[first + k].imm::u32);
            if (s == NO_BLOCK) {
                st.status = CFG_NO_TERMINATOR;
                st.at     = blk.id;
                ret err[fail.Fail].ok{};
            }
            set_succ(st, i, k, s);
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun blank_node(role: u8) Node {
    var n: Node;
    n.id       = NO_BLOCK;
    n.block    = NO_BLOCK;
    n.edge     = 0;
    n.nsucc    = 0;
    n.idom     = NO_BLOCK;
    n.rpo      = NO_BLOCK;
    n.kind     = CK_PLAIN;
    n.merge    = NO_BLOCK;
    n.cont     = NO_BLOCK;
    n.loop_hdr = NO_BLOCK;
    n.split    = NO_BLOCK;
    n.role     = role;
    n.dispatch = NO_BLOCK;
    n.case     = 0;
    ret n;
}

fun instr_has_block_operand(mi: *codegen_mir.MirInstr) bool {
    var i: u32 = 0;
    for (i < mi.operand_count) {
        if (mi.operands[i].kind == codegen_mir.MIR_OP_BLOCK) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun node_of_id(st: *Structure, id: u32) u32 {
    var i: u32 = 0;
    for (i < st.real) {
        if (st.nodes[i].id == id) { ret i; }
        i = i + 1;
    }
    ret NO_BLOCK;
}

# reserves n successor slots, answering the first or NO_BLOCK when the pool
# cannot grow
fun push_edges(st: *Structure, n: u32) u32 {
    val need: u32 = st.succ_len + n;
    if (need > st.succ_cap) {
        var cap: u32 = st.succ_cap * 2;
        if (cap < need) { cap = need; }
        val rg: res[*u32, std_allocator.Error] = std_allocator.allocate[u32](st.alloc, cap::usize);
        if (sel rg.err) { ret NO_BLOCK; }
        val grown: *u32 = rg.ok;
        var i:     u32  = 0;
        for (i < st.succ_len) {
            grown[i] = st.succs[i];
            i        = i + 1;
        }
        std_allocator.deallocate[u32](st.alloc, st.succs, st.succ_cap::usize);
        st.succs    = grown;
        st.succ_cap = cap;
    }
    val at: u32 = st.succ_len;
    var i:  u32 = 0;
    for (i < n) {
        st.succs[at + i] = NO_BLOCK;
        i                = i + 1;
    }
    st.succ_len = need;
    ret at;
}

fun compute_rpo(st: *Structure) err[fail.Fail] {
    val n: u32 = st.real;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val rs: res[*u32, std_allocator.Error] = std_allocator.allocate[u32](st.alloc, n::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    val stack: *u32                           = rs.ok;
    val ri:    res[*u32, std_allocator.Error] = std_allocator.allocate[u32](st.alloc, n::usize);
    if (sel ri.err) {
        std_allocator.deallocate[u32](st.alloc, stack, n::usize);
        ret err[fail.Fail].err{fail.refused(ri.err)};
    }
    val next: *u32                           = ri.ok;
    val rp:   res[*u32, std_allocator.Error] = std_allocator.allocate[u32](st.alloc, n::usize);
    if (sel rp.err) {
        std_allocator.deallocate[u32](st.alloc, stack, n::usize);
        std_allocator.deallocate[u32](st.alloc, next, n::usize);
        ret err[fail.Fail].err{fail.refused(rp.err)};
    }
    val post: *u32 = rp.ok;

    var i: u32 = 0;
    for (i < n) {
        next[i] = 0;
        i       = i + 1;
    }

    var sp:    u32 = 0;
    var count: u32 = 0;
    stack[0]        = 0;
    sp              = 1;
    st.nodes[0].rpo = 0;
    for (sp > 0) {
        val cur: u32 = stack[sp - 1];
        val k:   u32 = next[cur];
        if (k >= st.nodes[cur].nsucc) {
            post[count] = cur;
            count       = count + 1;
            sp          = sp - 1;
            cnt;
        }
        next[cur] = k + 1;
        val s: u32 = succ(st, cur, k);
        if (st.nodes[s].rpo == NO_BLOCK) {
            st.nodes[s].rpo = 0;
            stack[sp]       = s;
            sp              = sp + 1;
        }
    }

    i = 0;
    for (i < count) {
        st.nodes[post[count - 1 - i]].rpo = i;
        i                                 = i + 1;
    }

    std_allocator.deallocate[u32](st.alloc, stack, n::usize);
    std_allocator.deallocate[u32](st.alloc, next, n::usize);
    std_allocator.deallocate[u32](st.alloc, post, n::usize);

    if (count != n) {
        st.status = CFG_UNREACHABLE;
        i         = 0;
        for (i < n) {
            if (st.nodes[i].rpo == NO_BLOCK) {
                st.at = st.nodes[i].id;
                i     = n;
                cnt;
            }
            i = i + 1;
        }
    }
    ret err[fail.Fail].ok{};
}

fun compute_idom(st: *Structure) err[fail.Fail] {
    val n: u32 = st.real;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val rr: res[*u32, std_allocator.Error] = std_allocator.allocate[u32](st.alloc, n::usize);
    if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
    val rpo_node: *u32 = rr.ok;
    var i:        u32  = 0;
    for (i < n) {
        if (st.nodes[i].rpo != NO_BLOCK) { rpo_node[st.nodes[i].rpo] = i; }
        i = i + 1;
    }

    st.nodes[0].idom = 0;
    var changed: bool = true;
    for (changed) {
        changed = false;
        var k: u32 = 1;
        for (k < n) {
            val b:        u32 = rpo_node[k];
            var new_idom: u32 = NO_BLOCK;
            var p:        u32 = 0;
            for (p < n) {
                if (is_pred(st, p, b) && st.nodes[p].idom != NO_BLOCK) {
                    if (new_idom == NO_BLOCK) { new_idom = p; }
                    or                        { new_idom = intersect(st, p, new_idom); }
                }
                p = p + 1;
            }
            if (new_idom != NO_BLOCK && st.nodes[b].idom != new_idom) {
                st.nodes[b].idom = new_idom;
                changed          = true;
            }
            k = k + 1;
        }
    }
    st.nodes[0].idom = NO_BLOCK;

    std_allocator.deallocate[u32](st.alloc, rpo_node, n::usize);
    ret err[fail.Fail].ok{};
}

fun has_succ(st: *Structure, p: u32, b: u32) bool {
    var k: u32 = 0;
    for (k < st.nodes[p].nsucc) {
        if (succ(st, p, k) == b) { ret true; }
        k = k + 1;
    }
    ret false;
}

fun is_pred(st: *Structure, p: u32, b: u32) bool {
    if (st.nodes[p].rpo == NO_BLOCK) { ret false; }
    ret has_succ(st, p, b);
}

fun intersect(st: *Structure, a: u32, b: u32) u32 {
    var x: u32 = a;
    var y: u32 = b;
    for (x != y) {
        for (st.nodes[x].rpo > st.nodes[y].rpo) { x = st.nodes[x].idom; }
        for (st.nodes[y].rpo > st.nodes[x].rpo) { y = st.nodes[y].idom; }
    }
    ret x;
}

# the nearest common dominator of a and b, either of which may be synthetic,
# or the other one when one is NO_BLOCK
fun common_dom(st: *Structure, a: u32, b: u32) u32 {
    if (a == NO_BLOCK) { ret b; }
    if (b == NO_BLOCK) { ret a; }
    var x:  u32 = a;
    var y:  u32 = b;
    var dx: u32 = depth(st, x);
    var dy: u32 = depth(st, y);
    for (dx > dy) {
        x  = st.nodes[x].idom;
        dx = dx - 1;
    }
    for (dy > dx) {
        y  = st.nodes[y].idom;
        dy = dy - 1;
    }
    for (x != y) {
        x = st.nodes[x].idom;
        y = st.nodes[y].idom;
    }
    ret x;
}

pub fun dominates(st: *Structure, a: u32, b: u32) bool {
    if (a == NO_BLOCK || b == NO_BLOCK) { ret false; }
    var x: u32 = b;
    for (x != NO_BLOCK) {
        if (x == a) { ret true; }
        x = st.nodes[x].idom;
    }
    ret false;
}

fun find_loops(st: *Structure) err[fail.Fail] {
    val n: u32 = st.real;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    var i: u32 = 0;
    for (i < n) {
        if (st.nodes[i].rpo != NO_BLOCK) {
            var k: u32 = 0;
            for (k < st.nodes[i].nsucc) {
                val s: u32 = succ(st, i, k);
                if (st.nodes[s].rpo <= st.nodes[i].rpo) {
                    if (!dominates(st, s, i)) {
                        st.status = CFG_IRREDUCIBLE;
                        st.at     = st.nodes[s].id;
                        ret err[fail.Fail].ok{};
                    }
                    st.nodes[s].kind = CK_LOOP;
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }

    val rs: res[*u32, std_allocator.Error] = std_allocator.allocate[u32](st.alloc, n::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    val stack: *u32                            = rs.ok;
    val rq:    res[*bool, std_allocator.Error] = std_allocator.allocate[bool](st.alloc, n::usize);
    if (sel rq.err) {
        std_allocator.deallocate[u32](st.alloc, stack, n::usize);
        ret err[fail.Fail].err{fail.refused(rq.err)};
    }
    val entered: *bool = rq.ok;

    var pos: u32 = n;
    for (pos > 0) {
        pos = pos - 1;
        var h: u32 = NO_BLOCK;
        i = 0;
        for (i < n) {
            if (st.nodes[i].rpo == pos && st.nodes[i].kind == CK_LOOP) { h = i; }
            i = i + 1;
        }
        if (h == NO_BLOCK) { cnt; }

        if (st.nodes[h].loop_hdr == NO_BLOCK) { st.nodes[h].loop_hdr = h; }
        i = 0;
        for (i < n) {
            entered[i] = false;
            i          = i + 1;
        }
        var sp: u32 = 0;
        i = 0;
        for (i < n) {
            if (is_pred(st, i, h) && dominates(st, h, i)) { sp = enter_body(st, h, i, stack, sp, entered); }
            i = i + 1;
        }
        for (sp > 0) {
            sp = sp - 1;
            val b: u32 = stack[sp];
            var p: u32 = 0;
            for (p < n) {
                if (is_pred(st, p, b) && p != h) { sp = enter_body(st, h, p, stack, sp, entered); }
                p = p + 1;
            }
        }
    }

    std_allocator.deallocate[u32](st.alloc, stack, n::usize);
    std_allocator.deallocate[bool](st.alloc, entered, n::usize);
    ret err[fail.Fail].ok{};
}

# adds block p to the body of the loop at h, or, when p already lies in a loop
# nested in it, the outermost loop around p that has no enclosing loop yet, so
# the walk goes on from that loop's header. answers the new stack depth
fun enter_body(st: *Structure, h: u32, p: u32, stack: *u32, sp: u32, entered: *bool) u32 {
    if (st.nodes[p].loop_hdr == NO_BLOCK) {
        st.nodes[p].loop_hdr = h;
        stack[sp]            = p;
        ret sp + 1;
    }
    val t: u32 = top_loop(st, st.nodes[p].loop_hdr);
    if (t == h || entered[t]) { ret sp; }
    entered[t] = true;
    stack[sp]  = t;
    ret sp + 1;
}

fun top_loop(st: *Structure, h: u32) u32 {
    var t: u32 = h;
    for (outer_loop(st, t) != NO_BLOCK) { t = outer_loop(st, t); }
    ret t;
}

fun outer_loop(st: *Structure, h: u32) u32 {
    val d: u32 = st.nodes[h].idom;
    if (d == NO_BLOCK) { ret NO_BLOCK; }
    ret st.nodes[d].loop_hdr;
}

fun in_loop(st: *Structure, h: u32, b: u32) bool {
    var l: u32 = st.nodes[b].loop_hdr;
    for (l != NO_BLOCK) {
        if (l == h) { ret true; }
        l = outer_loop(st, l);
    }
    ret false;
}

rec Scratch {
    a:     *bool;
    b:     *bool;
    seen:  *bool;
    score: *u32;
    stack: *u32;
    n:     u32;
}

fun scratch_alloc(st: *Structure, sc: *Scratch, n: u32) bool {
    sc.n     = 0;
    sc.a     = nil;
    sc.b     = nil;
    sc.seen  = nil;
    sc.score = nil;
    sc.stack = nil;
    val ra: res[*bool, std_allocator.Error] = std_allocator.allocate[bool](st.alloc, n::usize);
    if (sel ra.err) { ret false; }
    sc.a = ra.ok;
    val rb: res[*bool, std_allocator.Error] = std_allocator.allocate[bool](st.alloc, n::usize);
    if (sel rb.err) {
        scratch_free(st, sc, n);
        ret false;
    }
    sc.b = rb.ok;
    val rk: res[*bool, std_allocator.Error] = std_allocator.allocate[bool](st.alloc, n::usize);
    if (sel rk.err) {
        scratch_free(st, sc, n);
        ret false;
    }
    sc.seen = rk.ok;
    val rc: res[*u32, std_allocator.Error] = std_allocator.allocate[u32](st.alloc, n::usize);
    if (sel rc.err) {
        scratch_free(st, sc, n);
        ret false;
    }
    sc.score = rc.ok;
    val rs: res[*u32, std_allocator.Error] = std_allocator.allocate[u32](st.alloc, n::usize);
    if (sel rs.err) {
        scratch_free(st, sc, n);
        ret false;
    }
    sc.stack = rs.ok;
    sc.n     = n;
    ret true;
}

fun scratch_free(st: *Structure, sc: *Scratch, n: u32) {
    if (sc.a != nil)     { std_allocator.deallocate[bool](st.alloc, sc.a, n::usize); }
    if (sc.b != nil)     { std_allocator.deallocate[bool](st.alloc, sc.b, n::usize); }
    if (sc.seen != nil)  { std_allocator.deallocate[bool](st.alloc, sc.seen, n::usize); }
    if (sc.score != nil) { std_allocator.deallocate[u32](st.alloc, sc.score, n::usize); }
    if (sc.stack != nil) { std_allocator.deallocate[u32](st.alloc, sc.stack, n::usize); }
    sc.a     = nil;
    sc.b     = nil;
    sc.seen  = nil;
    sc.score = nil;
    sc.stack = nil;
    sc.n     = 0;
}

# the scratch arrays cover every node, after synthetic ones were added
fun scratch_fit(st: *Structure, sc: *Scratch) bool {
    if (sc.n >= st.count) { ret true; }
    scratch_free(st, sc, sc.n);
    ret scratch_alloc(st, sc, st.cap);
}

fun assign_merges(st: *Structure) err[fail.Fail] {
    var sc: Scratch;
    if (!scratch_alloc(st, ?sc, st.cap)) { ret err[fail.Fail].err{fail.message("structure: scratch allocation failed")}; }
    val r: err[fail.Fail] = assign_with(st, ?sc);
    scratch_free(st, ?sc, sc.n);
    ret r;
}

fun assign_with(st: *Structure, sc: *Scratch) err[fail.Fail] {
    var d: u32 = max_depth(st) + 1;
    for (d > 0) {
        d = d - 1;
        var h: u32 = 0;
        for (h < st.count) {
            if (st.nodes[h].kind != CK_LOOP || depth(st, h) != d) {
                h = h + 1;
                cnt;
            }

            val c: u32 = push_node(st, ROLE_CONTINUE, h);
            if (c == NO_BLOCK) { ret err[fail.Fail].err{fail.message("structure: node allocation failed")}; }
            st.nodes[h].cont = c;
            var cdom: u32 = NO_BLOCK;
            var i:    u32 = 0;
            for (i < st.count) {
                if (i != c && in_loop(st, h, i)) {
                    var hit: bool = false;
                    var k:   u32  = 0;
                    for (k < st.nodes[i].nsucc) {
                        if (succ(st, i, k) == h) {
                            set_succ(st, i, k, c);
                            hit = true;
                        }
                        k = k + 1;
                    }
                    if (hit) {
                        if (cdom == NO_BLOCK) { cdom = i; }
                        or                    { cdom = intersect(st, i, cdom); }
                    }
                }
                i = i + 1;
            }
            if (cdom != NO_BLOCK) { st.nodes[c].idom = cdom; }

            val mb: u32 = loop_merge(st, sc, h);
            if (mb == NO_BLOCK) { ret err[fail.Fail].err{fail.message("structure: node allocation failed")}; }
            st.nodes[h].merge = mb;

            if (!split_header(st, h)) { ret err[fail.Fail].err{fail.message("structure: node allocation failed")}; }
            h = h + 1;
        }
    }

    val c1: err[fail.Fail] = check_claims(st);
    if (sel c1.err) { ret c1; }

    val top: u32 = max_depth(st);
    d = 0;
    for (d <= top) {
        var s: u32 = 0;
        for (s < st.count) {
            if (st.nodes[s].kind == CK_LOOP || depth(st, s) != d) {
                s = s + 1;
                cnt;
            }
            var mb: u32 = NO_BLOCK;
            if (st.nodes[s].role == ROLE_DISPATCH || st.nodes[s].nsucc > 2) {
                st.nodes[s].kind = CK_SWITCH;
                mb               = switch_merge(st, sc, s);
            }
            or (st.nodes[s].nsucc == 2) {
                st.nodes[s].kind = CK_SELECTION;
                mb               = sel_merge(st, sc, s);
            }
            or {
                s = s + 1;
                cnt;
            }
            if (mb == NO_BLOCK) { ret err[fail.Fail].err{fail.message("structure: node allocation failed")}; }
            st.nodes[s].merge = mb;
            s                 = s + 1;
        }
        d = d + 1;
    }

    ret check_claims(st);
}

fun depth(st: *Structure, x: u32) u32 {
    var d: u32 = 0;
    var c: u32 = st.nodes[x].idom;
    for (c != NO_BLOCK) {
        d = d + 1;
        c = st.nodes[c].idom;
    }
    ret d;
}

fun max_depth(st: *Structure) u32 {
    var m: u32 = 0;
    var i: u32 = 0;
    for (i < st.count) {
        val d: u32 = depth(st, i);
        if (d > m) { m = d; }
        i = i + 1;
    }
    ret m;
}

fun split_header(st: *Structure, h: u32) bool {
    if (st.nodes[h].nsucc != 2) { ret true; }
    val m: u32 = st.nodes[h].merge;
    val c: u32 = st.nodes[h].cont;
    if (has_succ(st, h, m) || has_succ(st, h, c)) { ret true; }

    val sp: u32 = push_node(st, ROLE_SPLIT, NO_BLOCK);
    if (sp == NO_BLOCK) { ret false; }
    st.nodes[sp].edge     = st.nodes[h].edge;
    st.nodes[sp].nsucc    = 2;
    st.nodes[sp].idom     = h;
    st.nodes[sp].loop_hdr = h;
    st.nodes[sp].block    = st.nodes[h].block;
    var i: u32 = 0;
    for (i < st.count) {
        if (i != sp && st.nodes[i].idom == h) { st.nodes[i].idom = sp; }
        i = i + 1;
    }
    val e: u32 = push_edges(st, 1);
    if (e == NO_BLOCK) { ret false; }
    st.nodes[h].edge  = e;
    st.nodes[h].nsucc = 1;
    set_succ(st, h, 0, sp);
    st.nodes[h].split = sp;
    ret true;
}

fun forward_merge(st: *Structure, h: u32, m: u32) u32 {
    val f: u32 = push_node(st, ROLE_FORWARD, m);
    if (f == NO_BLOCK) { ret NO_BLOCK; }
    st.nodes[f].nsucc    = 1;
    st.nodes[f].idom     = h;
    st.nodes[f].loop_hdr = st.nodes[h].loop_hdr;
    if (st.nodes[h].kind == CK_LOOP) { st.nodes[f].loop_hdr = outer_loop(st, h); }

    var i: u32 = 0;
    for (i < st.count) {
        if (i != f && i != m && dominates(st, h, i)) {
            var k: u32 = 0;
            for (k < st.nodes[i].nsucc) {
                if (succ(st, i, k) == m) { set_succ(st, i, k, f); }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    ret f;
}

# the merge of the loop at h: the block its exits reconverge on, a forward to it
# when another construct merges there, or an exit dispatch when its exits leave
# its construct along more than one way. NO_BLOCK only when allocation failed
fun loop_merge(st: *Structure, sc: *Scratch, h: u32) u32 {
    if (!scratch_fit(st, sc)) { ret NO_BLOCK; }
    var i: u32 = 0;
    for (i < sc.n) {
        sc.seen[i]  = false;
        sc.score[i] = 0;
        i           = i + 1;
    }

    var exits:    u32 = 0;
    var one_exit: u32 = NO_BLOCK;
    var b:        u32 = 0;
    for (b < st.count) {
        if (in_loop(st, h, b)) {
            var k: u32 = 0;
            for (k < st.nodes[b].nsucc) {
                val t: u32 = succ(st, b, k);
                if (!in_loop(st, h, t) && !sc.seen[t]) {
                    sc.seen[t] = true;
                    exits      = exits + 1;
                    one_exit   = t;
                    reach_from(st, sc, t, h, sc.a);
                    i = 0;
                    for (i < sc.n) {
                        if (sc.a[i]) { sc.score[i] = sc.score[i] + 1; }
                        i = i + 1;
                    }
                }
                k = k + 1;
            }
        }
        b = b + 1;
    }

    if (exits == 0) { ret push_node(st, ROLE_UNREACHABLE, NO_BLOCK); }

    var merge: u32 = NO_BLOCK;
    i = 0;
    for (i < st.count) {
        if (sc.score[i] > 0 && i != h && !in_loop(st, h, i) && dominates(st, h, i)
            && !merge_reenters(st, h, i)) {
            if (merge == NO_BLOCK || sc.score[i] > sc.score[merge]
                || (sc.score[i] == sc.score[merge] && rpo_before(st, i, merge))) {
                merge = i;
            }
        }
        i = i + 1;
    }
    if (merge != NO_BLOCK && !exits_stray(st, sc, h, merge)) {
        if (is_claimed(st, merge)) { ret forward_merge(st, h, merge); }
        ret merge;
    }
    if (merge == NO_BLOCK && exits == 1 && !merge_reenters(st, h, one_exit)) { ret forward_merge(st, h, one_exit); }
    ret dispatch_exits(st, sc, h);
}

# whether an exit of the loop at h other than its merge m leaves the loop's
# construct along an edge the construct cannot take: one into a block the loop
# does not dominate, except a branch to the loop around it or out of that loop.
# sc.seen marks the exits
fun exits_stray(st: *Structure, sc: *Scratch, h: u32, m: u32) bool {
    var t: u32 = 0;
    for (t < st.count) {
        if (sc.seen[t] && t != m) {
            if (!dominates(st, h, t)) {
                if (!leaves_to_enclosing(st, h, t)) { ret true; }
            }
            or (region_strays(st, sc, h, m, t)) { ret true; }
        }
        t = t + 1;
    }
    ret false;
}

# a branch out of the loop at h to v, a block it does not dominate, that the
# loop around it takes as a continue or a break
fun leaves_to_enclosing(st: *Structure, h: u32, v: u32) bool {
    val l: u32 = outer_loop(st, h);
    if (l == NO_BLOCK) { ret false; }
    if (v == l)        { ret true; }
    ret !in_loop(st, l, v);
}

# whether the blocks the exit t of the loop at h leads to, short of its merge m,
# branch anywhere leaves_to_enclosing does not admit
fun region_strays(st: *Structure, sc: *Scratch, h: u32, m: u32, t: u32) bool {
    var i: u32 = 0;
    for (i < sc.n) {
        sc.b[i] = false;
        i       = i + 1;
    }
    sc.b[t]     = true;
    sc.stack[0] = t;
    var sp: u32 = 1;
    for (sp > 0) {
        sp = sp - 1;
        val x: u32 = sc.stack[sp];
        var k: u32 = 0;
        for (k < st.nodes[x].nsucc) {
            val v: u32 = succ(st, x, k);
            if (!dominates(st, h, v)) {
                if (!leaves_to_enclosing(st, h, v)) { ret true; }
            }
            or (v != m && !sc.b[v]) {
                sc.b[v]      = true;
                sc.stack[sp] = v;
                sp           = sp + 1;
            }
            k = k + 1;
        }
    }
    ret false;
}

# gives the loop at h one merge its exits all reach: each exit target t_k is
# entered from the loop through an exit node that selects case k and branches to
# a dispatch node, the merge, which branches on to t_k. an exit
# leaves_to_enclosing admits keeps its edge
fun dispatch_exits(st: *Structure, sc: *Scratch, h: u32) u32 {
    val first: u32 = st.count;
    var n:     u32 = 0;
    var t:     u32 = 0;
    for (t < first) {
        if (sc.seen[t] && (dominates(st, h, t) || !leaves_to_enclosing(st, h, t))) {
            sc.stack[n] = t;
            n           = n + 1;
        }
        t = t + 1;
    }
    if (n == 1) { ret forward_merge(st, h, sc.stack[0]); }

    # the loop the dispatched code lies in: the nearest loop around h that one
    # of the targets is still inside
    var lh: u32 = outer_loop(st, h);
    for (lh != NO_BLOCK) {
        var inside: bool = false;
        var k:      u32  = 0;
        for (k < n) {
            if (in_loop(st, lh, sc.stack[k])) { inside = true; }
            k = k + 1;
        }
        if (inside) { brk; }
        lh = outer_loop(st, lh);
    }

    # every block outside the loop that it dominated is now reached through the
    # dispatch: mark them before any dominator changes
    var x: u32 = 0;
    for (x < first) {
        sc.a[x] = x != h && !in_loop(st, h, x) && dominates(st, h, x)
            && (st.nodes[x].idom == h || in_loop(st, h, st.nodes[x].idom));
        x = x + 1;
    }

    val d: u32 = push_node(st, ROLE_DISPATCH, NO_BLOCK);
    if (d == NO_BLOCK) { ret NO_BLOCK; }
    val e: u32 = push_edges(st, n);
    if (e == NO_BLOCK) { ret NO_BLOCK; }
    st.nodes[d].edge     = e;
    st.nodes[d].nsucc    = n;
    st.nodes[d].kind     = CK_SWITCH;
    st.nodes[d].loop_hdr = lh;

    var ddom: u32 = NO_BLOCK;
    var k:    u32 = 0;
    for (k < n) {
        val tk: u32 = sc.stack[k];
        val xk: u32 = push_node(st, ROLE_EXIT, d);
        if (xk == NO_BLOCK) { ret NO_BLOCK; }
        st.nodes[xk].dispatch = d;
        st.nodes[xk].case     = k;
        st.nodes[xk].loop_hdr = lh;
        var xdom: u32 = NO_BLOCK;
        var b:    u32 = 0;
        for (b < first) {
            if (in_loop(st, h, b)) {
                var j: u32 = 0;
                for (j < st.nodes[b].nsucc) {
                    if (succ(st, b, j) == tk) {
                        set_succ(st, b, j, xk);
                        xdom = common_dom(st, xdom, b);
                    }
                    j = j + 1;
                }
            }
            b = b + 1;
        }
        st.nodes[xk].idom = xdom;
        ddom              = common_dom(st, ddom, xdom);
        if (dominates(st, h, tk)) { set_succ(st, d, k, tk); }
        or {
            val f: u32 = push_node(st, ROLE_FORWARD, tk);
            if (f == NO_BLOCK) { ret NO_BLOCK; }
            st.nodes[f].nsucc    = 1;
            st.nodes[f].idom     = d;
            st.nodes[f].loop_hdr = lh;
            set_succ(st, d, k, f);
        }
        k = k + 1;
    }
    st.nodes[d].idom = ddom;

    x = 0;
    for (x < first) {
        if (sc.a[x]) { st.nodes[x].idom = d; }
        x = x + 1;
    }
    ret d;
}

fun merge_reenters(st: *Structure, h: u32, m: u32) bool {
    var x: u32 = 0;
    for (x < st.count) {
        if (dominates(st, m, x)) {
            var k: u32 = 0;
            for (k < st.nodes[x].nsucc) {
                val v: u32 = succ(st, x, k);
                if (v != m && dominates(st, h, v) && !dominates(st, m, v)) { ret true; }
                k = k + 1;
            }
        }
        x = x + 1;
    }
    ret false;
}

fun sel_merge(st: *Structure, sc: *Scratch, s: u32) u32 {
    if (!scratch_fit(st, sc)) { ret NO_BLOCK; }
    val s0: u32 = succ(st, s, 0);
    val s1: u32 = succ(st, s, 1);
    reach_from(st, sc, s0, s, sc.a);
    reach_from(st, sc, s1, s, sc.b);

    var merge: u32 = NO_BLOCK;
    var i:     u32 = 0;
    for (i < st.count) {
        if (sc.a[i] && sc.b[i] && i != s && dominates(st, s, i) && in_enclosing(st, s, i)) {
            if (merge == NO_BLOCK || rpo_before(st, i, merge)) { merge = i; }
        }
        i = i + 1;
    }
    if (merge == NO_BLOCK) {
        val e0: bool = arm_escapes(st, s, s0);
        val e1: bool = arm_escapes(st, s, s1);
        if (e0 && !e1 && in_enclosing(st, s, s0)) { merge = s0; }
        or (e1 && !e0 && in_enclosing(st, s, s1)) { merge = s1; }
    }
    if (merge == NO_BLOCK) {
        # the arms leave through one block the header does not dominate (an inlined callee's
        # returns all joining at the caller's continuation): that block is the merge of an
        # enclosing construct, and this selection reaches it through a merge of its own
        val exit: u32 = sole_exit(st, s);
        if (exit != NO_BLOCK) { ret forward_merge(st, s, exit); }
    }
    if (merge == NO_BLOCK)     { ret push_node(st, ROLE_UNREACHABLE, NO_BLOCK); }
    if (is_claimed(st, merge)) { ret forward_merge(st, s, merge); }
    ret merge;
}

# the merge of the switch at s: the first block every arm reaches, or a forward
# to the one block its arms leave it through, as for a selection
fun switch_merge(st: *Structure, sc: *Scratch, s: u32) u32 {
    if (!scratch_fit(st, sc)) { ret NO_BLOCK; }
    val n: u32 = st.nodes[s].nsucc;
    var i: u32 = 0;
    for (i < sc.n) {
        sc.score[i] = 0;
        i           = i + 1;
    }
    var k: u32 = 0;
    for (k < n) {
        reach_from(st, sc, succ(st, s, k), s, sc.a);
        i = 0;
        for (i < sc.n) {
            if (sc.a[i]) { sc.score[i] = sc.score[i] + 1; }
            i = i + 1;
        }
        k = k + 1;
    }

    var merge: u32 = NO_BLOCK;
    i = 0;
    for (i < st.count) {
        if (sc.score[i] == n && i != s && dominates(st, s, i) && in_enclosing(st, s, i)) {
            if (merge == NO_BLOCK || rpo_before(st, i, merge)) { merge = i; }
        }
        i = i + 1;
    }
    if (merge == NO_BLOCK) {
        val exit: u32 = sole_exit(st, s);
        if (exit != NO_BLOCK) { ret forward_merge(st, s, exit); }
        ret push_node(st, ROLE_UNREACHABLE, NO_BLOCK);
    }
    if (is_claimed(st, merge)) { ret forward_merge(st, s, merge); }
    ret merge;
}

# the one block outside the selection at s that its body branches to, break and continue
# edges aside, or NO_BLOCK when the body has no such exit or more than one
fun sole_exit(st: *Structure, s: u32) u32 {
    var exit: u32 = NO_BLOCK;
    var x:    u32 = 0;
    for (x < st.count) {
        if (dominates(st, s, x) && in_enclosing(st, s, x)) {
            var k: u32 = 0;
            for (k < st.nodes[x].nsucc) {
                val v: u32 = succ(st, x, k);
                if (!dominates(st, s, v) && in_enclosing(st, s, v)) {
                    if (exit == NO_BLOCK) { exit = v; }
                    or (exit != v)        { ret NO_BLOCK; }
                }
                k = k + 1;
            }
        }
        x = x + 1;
    }
    ret exit;
}

fun in_enclosing(st: *Structure, s: u32, m: u32) bool {
    var l: u32 = st.nodes[s].loop_hdr;
    for (l != NO_BLOCK) {
        if (dominates(st, st.nodes[l].merge, m)) { ret false; }
        if (m == st.nodes[l].cont)               { ret false; }
        l = outer_loop(st, l);
    }
    ret true;
}

fun arm_escapes(st: *Structure, s: u32, arm: u32) bool {
    var x: u32 = 0;
    for (x < st.count) {
        if (dominates(st, arm, x)) {
            var k: u32 = 0;
            for (k < st.nodes[x].nsucc) {
                if (!dominates(st, s, succ(st, x, k))) { ret true; }
                k = k + 1;
            }
        }
        x = x + 1;
    }
    ret false;
}

fun rpo_before(st: *Structure, a: u32, b: u32) bool {
    if (st.nodes[a].rpo == NO_BLOCK) { ret false; }
    if (st.nodes[b].rpo == NO_BLOCK) { ret true; }
    ret st.nodes[a].rpo < st.nodes[b].rpo;
}

fun reach_from(st: *Structure, sc: *Scratch, from: u32, avoid: u32, out: *bool) {
    var i: u32 = 0;
    for (i < sc.n) {
        out[i] = false;
        i      = i + 1;
    }
    if (from == NO_BLOCK || from == avoid) { ret; }
    out[from] = true;
    var sp: u32 = 0;
    sc.stack[0] = from;
    sp          = 1;
    for (sp > 0) {
        sp = sp - 1;
        val cur: u32 = sc.stack[sp];
        var k:   u32 = 0;
        for (k < st.nodes[cur].nsucc) {
            val v: u32 = succ(st, cur, k);
            if (v != avoid && !out[v]) {
                out[v]       = true;
                sc.stack[sp] = v;
                sp           = sp + 1;
            }
            k = k + 1;
        }
    }
}

fun is_claimed(st: *Structure, b: u32) bool {
    var i: u32 = 0;
    for (i < st.count) {
        if (st.nodes[i].merge == b) { ret true; }
        if (st.nodes[i].cont == b)  { ret true; }
        i = i + 1;
    }
    ret false;
}

# every construct merges on a block of its own: a block two of them reconverge
# on was given one forward merge per construct, so a shared one is a defect here
fun check_claims(st: *Structure) err[fail.Fail] {
    var i: u32 = 0;
    for (i < st.count) {
        val m: u32 = st.nodes[i].merge;
        if (m != NO_BLOCK) {
            var j: u32 = i + 1;
            for (j < st.count) {
                if (st.nodes[j].merge == m || st.nodes[j].cont == m) {
                    ret err[fail.Fail].err{fail.message("structure: two constructs merge on one block")};
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun push_node(st: *Structure, role: u8, target: u32) u32 {
    if (st.count >= st.cap) {
        val cap: u32                             = st.cap * 2;
        val rg:  res[*Node, std_allocator.Error] = std_allocator.allocate[Node](st.alloc, cap::usize);
        if (sel rg.err) { ret NO_BLOCK; }
        val grown: *Node = rg.ok;
        var i:     u32   = 0;
        for (i < st.count) {
            grown[i] = st.nodes[i];
            i        = i + 1;
        }
        std_allocator.deallocate[Node](st.alloc, st.nodes, st.cap::usize);
        st.nodes = grown;
        st.cap   = cap;
    }
    val e: u32 = push_edges(st, 1);
    if (e == NO_BLOCK) { ret NO_BLOCK; }
    var n: Node = blank_node(role);
    n.edge      = e;
    st.succs[e] = target;
    if (role == ROLE_CONTINUE) {
        n.nsucc    = 1;
        n.idom     = target;
        n.loop_hdr = target;
    }
    if (role == ROLE_EXIT) { n.nsucc = 1; }
    val ix: u32 = st.count;
    st.nodes[ix] = n;
    st.count     = ix + 1;
    ret ix;
}

fun build_order(st: *Structure) err[fail.Fail] {
    val ro: res[*u32, std_allocator.Error] = std_allocator.allocate[u32](st.alloc, st.cap::usize);
    if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
    st.order = ro.ok;
    val rp: res[*bool, std_allocator.Error] = std_allocator.allocate[bool](st.alloc, st.cap::usize);
    if (sel rp.err) { ret err[fail.Fail].err{fail.refused(rp.err)}; }
    val placed: *bool = rp.ok;
    var i:      u32   = 0;
    for (i < st.cap) {
        placed[i] = false;
        i         = i + 1;
    }

    var k:   u32 = 0;
    var pos: u32 = 0;
    for (pos < st.real) {
        i = 0;
        for (i < st.real) {
            if (st.nodes[i].rpo == pos) {
                k           = place_feeders(st, i, placed, k);
                st.order[k] = i;
                k           = k + 1;
                placed[i]   = true;
                val sp: u32 = st.nodes[i].split;
                if (sp != NO_BLOCK) {
                    st.order[k] = sp;
                    k           = k + 1;
                    placed[sp]  = true;
                }
            }
            i = i + 1;
        }
        pos = pos + 1;
    }

    i = st.real;
    for (i < st.count) {
        if (!placed[i]) {
            k           = place_feeders(st, i, placed, k);
            st.order[k] = i;
            k           = k + 1;
            placed[i]   = true;
        }
        i = i + 1;
    }

    std_allocator.deallocate[bool](st.alloc, placed, st.cap::usize);
    ret err[fail.Fail].ok{};
}

# places, ahead of target, the forward and dispatch nodes that branch to it,
# each behind its own such feeders, so every node follows its dominator
fun place_feeders(st: *Structure, target: u32, placed: *bool, k: u32) u32 {
    var out: u32 = k;
    var j:   u32 = st.real;
    for (j < st.count) {
        if (!placed[j] && feeds(st, j, target)) {
            placed[j]     = true;
            out           = place_feeders(st, j, placed, out);
            st.order[out] = j;
            out           = out + 1;
        }
        j = j + 1;
    }
    ret out;
}

fun feeds(st: *Structure, j: u32, target: u32) bool {
    if (st.nodes[j].role == ROLE_FORWARD)  { ret succ(st, j, 0) == target; }
    if (st.nodes[j].role == ROLE_DISPATCH) { ret has_succ(st, j, target); }
    ret false;
}

fun construct_of(st: *Structure, b: u32) u32 {
    if (st.nodes[b].kind != CK_PLAIN) { ret b; }
    var x: u32 = b;
    for (x != NO_BLOCK) {
        if (st.nodes[x].kind != CK_PLAIN && in_construct(st, x, b)) { ret x; }
        x = st.nodes[x].idom;
    }
    ret NO_BLOCK;
}

fun in_construct(st: *Structure, h: u32, b: u32) bool {
    if (!dominates(st, h, b))                { ret false; }
    if (b == st.nodes[h].cont)               { ret false; }
    if (dominates(st, st.nodes[h].merge, b)) { ret false; }
    # a construct ends where the loop enclosing it ends, even when its own merge is
    # unreachable and so dominates nothing
    ret in_enclosing(st, h, b);
}

fun verify(st: *Structure) {
    var b: u32 = 0;
    for (b < st.count) {
        var k: u32 = 0;
        for (k < st.nodes[b].nsucc) {
            val s: u32 = succ(st, b, k);
            if (!edge_legal(st, b, s)) {
                st.status = CFG_CROSSING_EDGE;
                st.at     = st.nodes[b].id;
                st.to     = s;
                ret;
            }
            k = k + 1;
        }
        b = b + 1;
    }
}

fun edge_legal(st: *Structure, u: u32, v: u32) bool {
    if (st.nodes[u].role == ROLE_CONTINUE) { ret v == succ(st, u, 0); }

    val k: u32 = construct_of(st, u);
    if (k == NO_BLOCK)          { ret true; }
    if (in_construct(st, k, v)) { ret true; }
    if (v == st.nodes[k].merge) { ret true; }

    var l: u32 = k;
    if (st.nodes[l].kind != CK_LOOP) { l = st.nodes[l].loop_hdr; }
    for (l != NO_BLOCK) {
        if (v == st.nodes[l].merge || v == st.nodes[l].cont) { ret true; }
        l = outer_loop(st, l);
    }
    ret false;
}

#[testing]
fun t_block(b: *codegen_mir.MirBlock, id: u32, mi: *codegen_mir.MirInstr) {
    b.id          = id;
    b.instrs      = mi;
    b.instr_count = 1;
    b.instr_cap   = 1;
    b.preds       = nil;
    b.pred_count  = 0;
    b.pred_cap    = 0;
}

#[testing]
fun t_br(mi: *codegen_mir.MirInstr, ops: *codegen_mir.MirOperand, target: u32) {
    ops[0]           = codegen_mir.op_block(target);
    mi.opcode        = codegen_mir.MIR_BR;
    mi.operands      = ops;
    mi.operand_count = 1;
}

#[testing]
fun t_cbr(mi: *codegen_mir.MirInstr, ops: *codegen_mir.MirOperand, t0: u32, t1: u32) {
    ops[0]           = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    ops[1]           = codegen_mir.op_block(t0);
    ops[2]           = codegen_mir.op_block(t1);
    mi.opcode        = codegen_mir.MIR_CBR;
    mi.operands      = ops;
    mi.operand_count = 3;
}

#[testing]
fun t_ret(mi: *codegen_mir.MirInstr) {
    mi.opcode        = codegen_mir.MIR_RET;
    mi.operands      = nil;
    mi.operand_count = 0;
}

test analyze__selection_merge {
    var alloc:  std_allocator.Allocator;
    val r_1039: err[std_allocator.Error] = page.make(?alloc);
    if (sel r_1039.err) { ret 1; }

    var ops:    [3]codegen_mir.MirOperand;
    var b1:     [1]codegen_mir.MirOperand;
    var b2:     [1]codegen_mir.MirOperand;
    var instrs: [4]codegen_mir.MirInstr;
    t_cbr(?instrs[0], ?ops[0], 1, 2);
    t_br(?instrs[1], ?b1[0], 3);
    t_br(?instrs[2], ?b2[0], 3);
    t_ret(?instrs[3]);
    var blocks: [4]codegen_mir.MirBlock;
    var i:      u32 = 0;
    for (i < 4) {
        t_block(?blocks[i], i, ?instrs[i]);
        i = i + 1;
    }
    var f: codegen_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 4;
    f.vreg_count  = 1;

    val r: res[Structure, fail.Fail] = analyze(?f, ?alloc);
    if (sel r.err) { ret 1; }
    var st: Structure = r.ok;
    var rc: i32       = 0;
    if (st.status != CFG_OK)              { rc = 2; }
    if (st.nodes[0].kind != CK_SELECTION) { rc = 3; }
    if (st.nodes[0].merge != 3)           { rc = 4; }
    if (st.count != 4)                    { rc = 5; }
    dnit(?st);
    ret rc;
}

test analyze__loop_continue_and_merge {
    var alloc:  std_allocator.Allocator;
