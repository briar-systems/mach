test analyze__sibling_loops_share_one_exit {
    var alloc:  std_allocator.Allocator;
    val r_1153: err[std_allocator.Error] = page.make(?alloc);
    if (sel r_1153.err) { ret 1; }

    var o0:     [3]codegen_mir.MirOperand;
    var o1:     [3]codegen_mir.MirOperand;
    var o3:     [3]codegen_mir.MirOperand;
    var b2:     [1]codegen_mir.MirOperand;
    var b4:     [1]codegen_mir.MirOperand;
    var instrs: [6]codegen_mir.MirInstr;
    t_cbr(?instrs[0], ?o0[0], 1, 3);
    t_cbr(?instrs[1], ?o1[0], 2, 5);
    t_br(?instrs[2], ?b2[0], 1);
    t_cbr(?instrs[3], ?o3[0], 4, 5);
    t_br(?instrs[4], ?b4[0], 3);
    t_ret(?instrs[5]);
    var blocks: [6]codegen_mir.MirBlock;
    var i:      u32 = 0;
    for (i < 6) {
        t_block(?blocks[i], i, ?instrs[i]);
        i = i + 1;
    }
    var f: codegen_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 6;
    f.vreg_count  = 1;

    val r: res[Structure, fail.Fail] = analyze(?f, ?alloc);
    if (sel r.err) { ret 1; }
    var st: Structure = r.ok;
    var rc: i32       = 0;
    if (st.status != CFG_OK)         { rc = 2; }
    if (st.nodes[1].kind != CK_LOOP) { rc = 3; }
    if (st.nodes[3].kind != CK_LOOP) { rc = 4; }
    val ma: u32 = st.nodes[1].merge;
    val mb: u32 = st.nodes[3].merge;
    if (ma < st.real || mb < st.real)                 { rc = 5; }
    if (rc == 0 && st.nodes[ma].role != ROLE_FORWARD) { rc = 6; }
    if (rc == 0 && st.nodes[mb].role != ROLE_FORWARD) { rc = 7; }
    if (rc == 0 && ma == mb)                          { rc = 8; }
    if (rc == 0 && succ(?st, ma, 0) != 5)             { rc = 9; }
    if (rc == 0 && succ(?st, mb, 0) != 5)             { rc = 10; }
    if (rc == 0 && succ(?st, 1, 1) != ma)             { rc = 11; }
    if (rc == 0 && succ(?st, 3, 1) != mb)             { rc = 12; }
    if (rc == 0 && st.nodes[0].merge != 5)            { rc = 13; }
    dnit(?st);
    ret rc;
}

