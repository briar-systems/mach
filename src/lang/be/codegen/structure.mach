    var b5:     [1]codegen_mir.MirOperand;
    var b6:     [1]codegen_mir.MirOperand;
    var b7:     [1]codegen_mir.MirOperand;
    var instrs: [9]codegen_mir.MirInstr;
    t_br(?instrs[0], ?b0[0], 1);
    t_cbr(?instrs[1], ?o1[0], 2, 8);
    t_cbr(?instrs[2], ?o2[0], 3, 4);
    t_br(?instrs[3], ?b3[0], 7);
    t_cbr(?instrs[4], ?o4[0], 5, 6);
    t_br(?instrs[5], ?b5[0], 7);
    t_br(?instrs[6], ?b6[0], 7);
    t_br(?instrs[7], ?b7[0], 1);
    t_ret(?instrs[8]);
    var blocks: [9]codegen_mir.MirBlock;
    var i:      u32 = 0;
    for (i < 9) {
        t_block(?blocks[i], i, ?instrs[i]);
        i = i + 1;
    }
    var f: codegen_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 9;
    f.vreg_count  = 1;

    val r: res[Structure, fail.Fail] = analyze(?f, ?alloc);
    if (sel r.err) { ret 1; }
    var st: Structure = r.ok;
    var rc: i32       = 0;
    if (st.status != CFG_OK)         { rc = 2; }
    if (st.nodes[1].kind != CK_LOOP) { rc = 3; }
    if (st.nodes[1].merge != 8)      { rc = 4; }
    if (st.nodes[2].merge != 7)      { rc = 5; }
    val m4: u32 = st.nodes[4].merge;
    if (m4 < st.real)                                   { rc = 6; }
    if (rc == 0 && st.nodes[m4].role != ROLE_FORWARD)   { rc = 7; }
    if (rc == 0 && succ(?st, m4, 0) != 7)               { rc = 8; }
    if (rc == 0 && st.nodes[m4].loop_hdr != 1)          { rc = 9; }
    if (rc == 0 && succ(?st, 7, 0) != st.nodes[1].cont) { rc = 10; }
    dnit(?st);
    ret rc;
}

# a break arm beside a continue arm leaves through the loop's own edges: no forward
# merge is invented for it
test analyze__break_and_continue_arms_keep_an_unreachable_merge {
    var alloc:  std_allocator.Allocator;
    val r_1379: err[std_allocator.Error] = page.make(?alloc);
    if (sel r_1379.err) { ret 1; }

    var o1:     [3]codegen_mir.MirOperand;
    var o2:     [3]codegen_mir.MirOperand;
    var b0:     [1]codegen_mir.MirOperand;
    var b3:     [1]codegen_mir.MirOperand;
    var b4:     [1]codegen_mir.MirOperand;
    var instrs: [6]codegen_mir.MirInstr;
    t_br(?instrs[0], ?b0[0], 1);
    t_cbr(?instrs[1], ?o1[0], 2, 5);
    t_cbr(?instrs[2], ?o2[0], 3, 4);
    t_br(?instrs[3], ?b3[0], 5);
    t_br(?instrs[4], ?b4[0], 1);
    t_ret(?instrs[5]);
    var blocks: [6]codegen_mir.MirBlock;
    var i:      u32 = 0;
    for (i < 6) {
        t_block(?blocks[i], i, ?instrs[i]);
        i = i + 1;
    }
    var f: codegen_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 6;
    f.vreg_count  = 1;

    val r: res[Structure, fail.Fail] = analyze(?f, ?alloc);
    if (sel r.err) { ret 1; }
    var st: Structure = r.ok;
    var rc: i32       = 0;
    if (st.status != CFG_OK)    { rc = 2; }
    if (st.nodes[1].merge != 5) { rc = 3; }
    val m2: u32 = st.nodes[2].merge;
    if (m2 < st.real)                                     { rc = 4; }
    if (rc == 0 && st.nodes[m2].role != ROLE_UNREACHABLE) { rc = 5; }
    if (rc == 0 && succ(?st, 3, 0) != 5)                  { rc = 6; }
    if (rc == 0 && succ(?st, 4, 0) != st.nodes[1].cont)   { rc = 7; }
    dnit(?st);
    ret rc;
}

# a loop whose only exit is a break inside a selection, itself inside an outer selection:
# the code after the loop is dominated by the inner header but lies outside the loop, so
# it belongs to the outer selection and its branch to the outer merge is not a crossing
test analyze__code_after_a_break_only_loop_is_outside_the_inner_selection {
    var alloc:  std_allocator.Allocator;
    val r_1419: err[std_allocator.Error] = page.make(?alloc);
    if (sel r_1419.err) { ret 1; }

    var o0:     [3]codegen_mir.MirOperand;
    var o4:     [3]codegen_mir.MirOperand;
    var b1:     [1]codegen_mir.MirOperand;
    var b2:     [1]codegen_mir.MirOperand;
    var b3:     [1]codegen_mir.MirOperand;
    var b5:     [1]codegen_mir.MirOperand;
    var b6:     [1]codegen_mir.MirOperand;
    var instrs: [8]codegen_mir.MirInstr;
    t_cbr(?instrs[0], ?o0[0], 1, 2);
    t_br(?instrs[1], ?b1[0], 3);
    t_br(?instrs[2], ?b2[0], 7);
    t_br(?instrs[3], ?b3[0], 4);
    t_cbr(?instrs[4], ?o4[0], 5, 6);
    t_br(?instrs[5], ?b5[0], 7);
    t_br(?instrs[6], ?b6[0], 3);
    t_ret(?instrs[7]);
    var blocks: [8]codegen_mir.MirBlock;
    var i:      u32 = 0;
    for (i < 8) {
        t_block(?blocks[i], i, ?instrs[i]);
        i = i + 1;
    }
    var f: codegen_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 8;
    f.vreg_count  = 1;

    val r: res[Structure, fail.Fail] = analyze(?f, ?alloc);
    if (sel r.err) { ret 1; }
    var st: Structure = r.ok;
    var rc: i32       = 0;
    if (st.status != CFG_OK)         { rc = 2; }
    if (st.nodes[0].merge != 7)      { rc = 3; }
    if (st.nodes[3].kind != CK_LOOP) { rc = 4; }
    if (st.nodes[3].merge != 5)      { rc = 5; }
    if (succ(?st, 5, 0) != 7)        { rc = 6; }
    dnit(?st);
    ret rc;
}

# a loop nested at the start of an outer loop's body: the block before the inner
# header is reached from the outer latch only through the inner loop, and still
# belongs to the outer loop
test analyze__outer_body_continues_through_a_nested_loop {
    var alloc: std_allocator.Allocator;
    val made:  err[std_allocator.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }

    var b0:     [1]codegen_mir.MirOperand;
    var o1:     [3]codegen_mir.MirOperand;
    var b2:     [1]codegen_mir.MirOperand;
    var o3:     [3]codegen_mir.MirOperand;
    var b4:     [1]codegen_mir.MirOperand;
    var instrs: [6]codegen_mir.MirInstr;
    t_br(?instrs[0], ?b0[0], 1);
    t_cbr(?instrs[1], ?o1[0], 2, 5);
    t_br(?instrs[2], ?b2[0], 3);
    t_cbr(?instrs[3], ?o3[0], 4, 1);
    t_br(?instrs[4], ?b4[0], 3);
    t_ret(?instrs[5]);
    var blocks: [6]codegen_mir.MirBlock;
    var i:      u32 = 0;
    for (i < 6) {
        t_block(?blocks[i], i, ?instrs[i]);
        i = i + 1;
    }
    var f: codegen_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 6;
    f.vreg_count  = 1;

    val r: res[Structure, fail.Fail] = analyze(?f, ?alloc);
    if (sel r.err) { ret 1; }
    var st: Structure = r.ok;
    var rc: i32       = 0;
    if (st.status != CFG_OK)         { rc = 2; }
    if (st.nodes[1].kind != CK_LOOP) { rc = 3; }
    if (st.nodes[3].kind != CK_LOOP) { rc = 4; }
    if (st.nodes[2].loop_hdr != 1)   { rc = 5; }
    if (outer_loop(?st, 3) != 1)     { rc = 6; }
    dnit(?st);
    ret rc;
}

# a loop inside one arm of a selection, left through two exits that only meet at
# the selection's merge (an inlined early return): the exits enter a dispatch,
# the loop's merge, which switches on to each of them
test analyze__loop_exits_that_do_not_reconverge_dispatch {
    var alloc: std_allocator.Allocator;
    val made:  err[std_allocator.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }

    var o0:     [3]codegen_mir.MirOperand;
    var b1:     [1]codegen_mir.MirOperand;
    var b2:     [1]codegen_mir.MirOperand;
    var o3:     [3]codegen_mir.MirOperand;
    var o4:     [3]codegen_mir.MirOperand;
    var b5:     [1]codegen_mir.MirOperand;
    var b6:     [1]codegen_mir.MirOperand;
    var b7:     [1]codegen_mir.MirOperand;
    var instrs: [9]codegen_mir.MirInstr;
    t_cbr(?instrs[0], ?o0[0], 1, 2);
    t_br(?instrs[1], ?b1[0], 8);
    t_br(?instrs[2], ?b2[0], 3);
    t_cbr(?instrs[3], ?o3[0], 4, 7);
    t_cbr(?instrs[4], ?o4[0], 6, 5);
    t_br(?instrs[5], ?b5[0], 3);
    t_br(?instrs[6], ?b6[0], 8);
    t_br(?instrs[7], ?b7[0], 8);
    t_ret(?instrs[8]);
    var blocks: [9]codegen_mir.MirBlock;
    var i:      u32 = 0;
    for (i < 9) {
        t_block(?blocks[i], i, ?instrs[i]);
        i = i + 1;
    }
    var f: codegen_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 9;
    f.vreg_count  = 1;

    val r: res[Structure, fail.Fail] = analyze(?f, ?alloc);
    if (sel r.err) { ret 1; }
    var st: Structure = r.ok;
    var rc: i32       = 0;
    if (st.status != CFG_OK)         { rc = 2; }
    if (st.nodes[3].kind != CK_LOOP) { rc = 3; }
    val d: u32 = st.nodes[3].merge;
    if (rc == 0 && st.nodes[d].role != ROLE_DISPATCH)              { rc = 4; }
    if (rc == 0 && st.nodes[d].kind != CK_SWITCH)                  { rc = 5; }
    if (rc == 0 && st.nodes[d].nsucc != 2)                         { rc = 6; }
    if (rc == 0 && (succ(?st, d, 0) != 6 || succ(?st, d, 1) != 7)) { rc = 7; }
    val x: u32 = succ(?st, 4, 0);
    if (rc == 0 && st.nodes[x].role != ROLE_EXIT)                        { rc = 8; }
    if (rc == 0 && (st.nodes[x].dispatch != d || st.nodes[x].case != 0)) { rc = 9; }
    if (rc == 0 && st.nodes[6].idom != d)                                { rc = 10; }
    val m: u32 = st.nodes[d].merge;
    if (rc == 0 && (st.nodes[m].role != ROLE_FORWARD || succ(?st, m, 0) != 8)) { rc = 11; }
    if (rc == 0 && st.nodes[0].merge != 8)                                     { rc = 12; }
    dnit(?st);
    ret rc;
}
