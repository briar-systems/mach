    if (sel r_1069.err) { ret 1; }

    var e0:     [1]codegen_mir.MirOperand;
    var ops:    [3]codegen_mir.MirOperand;
    var b2:     [1]codegen_mir.MirOperand;
    var instrs: [4]codegen_mir.MirInstr;
    t_br(?instrs[0], ?e0[0], 1);
    t_cbr(?instrs[1], ?ops[0], 2, 3);
    t_br(?instrs[2], ?b2[0], 1);
    t_ret(?instrs[3]);
    var blocks: [4]codegen_mir.MirBlock;
    var i:      u32 = 0;
    for (i < 4) {
        t_block(?blocks[i], i, ?instrs[i]);
        i = i + 1;
    }
    var f: codegen_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 4;
    f.vreg_count  = 1;

    val r: res[Structure, fail.Fail] = analyze(?f, ?alloc);
    if (sel r.err) { ret 1; }
    var st: Structure = r.ok;
    var rc: i32       = 0;
    if (st.status != CFG_OK)         { rc = 2; }
    if (st.nodes[1].kind != CK_LOOP) { rc = 3; }
    if (st.nodes[1].merge != 3)      { rc = 4; }
    val c: u32 = st.nodes[1].cont;
    if (c < st.real)                                  { rc = 5; }
    if (rc == 0 && st.nodes[c].role != ROLE_CONTINUE) { rc = 6; }
    if (rc == 0 && succ(?st, c, 0) != 1)              { rc = 7; }
    if (rc == 0 && succ(?st, 2, 0) != c)              { rc = 8; }
    dnit(?st);
    ret rc;
}

test analyze__irreducible_is_refused {
    var alloc:  std_allocator.Allocator;
    val r_1103: err[std_allocator.Error] = page.make(?alloc);
    if (sel r_1103.err) { ret 1; }

    var ops:    [3]codegen_mir.MirOperand;
    var b1:     [1]codegen_mir.MirOperand;
    var b2:     [1]codegen_mir.MirOperand;
    var instrs: [3]codegen_mir.MirInstr;
    t_cbr(?instrs[0], ?ops[0], 1, 2);
    t_br(?instrs[1], ?b1[0], 2);
    t_br(?instrs[2], ?b2[0], 1);
    var blocks: [3]codegen_mir.MirBlock;
    var i:      u32 = 0;
    for (i < 3) {
        t_block(?blocks[i], i, ?instrs[i]);
        i = i + 1;
    }
    var f: codegen_mir.MirFunction;
    f.blocks      = ?blocks[0];
    f.block_count = 3;
    f.vreg_count  = 1;

    val r: res[Structure, fail.Fail] = analyze(?f, ?alloc);
    if (sel r.err) { ret 1; }
    var st: Structure = r.ok;
    var rc: i32       = 0;
    if (st.status != CFG_IRREDUCIBLE) { rc = 2; }
    val text: res[str, std_format.FormatError] = refusal_text(?alloc, "f", st.status, "wasm32");
    if (sel text.err) { rc = 3; }
    if (sel text.ok) {
        if (!str_contains(text.ok, "the wasm32 target requires structured control flow")) { rc = 4; }
    }
    dnit(?st);
    ret rc;
}

