# the layout a link resolves, as the phases that patch, thunk and unwind the
# image read it: the inputs, where each of their sections landed, the merged
# sections and the image built from them, the symbols and the dynamic imports.
# the link fills it phase by phase and releases what it holds with one dnit
use std.collections.map;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.intern;
use mach.lang.target.isa;
use target_of: mach.lang.target.of;

use mach.lang.be.linker.atoms.AtomPlan;
use mach.lang.be.linker.atoms.free_atom_plan;
use mach.lang.be.linker.atoms.init_atom_plan;
use mach.lang.be.linker.debug.StrMerge;
use mach.lang.be.linker.debug.free_str_merge;
use mach.lang.be.linker.dynamic.DynState;
use mach.lang.be.linker.dynamic.free_dynstate;
use mach.lang.be.linker.dynamic.init_dynstate;
use mach.lang.be.linker.merge.MergedSection;
use mach.lang.be.linker.merge.Placement;
use mach.lang.be.linker.merge.SectionGroups;
use mach.lang.be.linker.merge.free_placements;
use mach.lang.be.linker.merge.free_section_groups;
use mach.lang.be.linker.merge.init_section_groups;
use mach.lang.be.linker.resolve.SymbolLoc;

# modules and module_count are borrowed from the link's inputs, and format and
# arch from its target; everything else the record owns
pub rec Resolution {
    modules:       *target_of.ObjectImage;
    module_count:  u32;
    format:        *target_of.OfVTable;
    arch:          *isa.IsaVTable;
    image_base:    u64;
    sec_base:      *u32;
    sec_total:     u32;
    placements:    *Placement;
    merged:        *MergedSection;
    merged_count:  u32;
    merged_to_out: *u32;
    groups:        SectionGroups;
    atoms:         AtomPlan;
    strm:          StrMerge;
    sym_locs:      map.Map[intern.StrId, SymbolLoc];
    dyn:           DynState;
    out_img:       target_of.ObjectImage;
}

pub fun resolution_init(r: *Resolution, alloc: *A.Allocator, itn: *intern.Interner,
    format: *target_of.OfVTable, arch: *isa.IsaVTable, image_base: u64) {
    r.modules       = nil;
    r.module_count  = 0;
    r.format        = format;
    r.arch          = arch;
    r.image_base    = image_base;
    r.sec_base      = nil;
    r.sec_total     = 0;
    r.placements    = nil;
    r.merged        = nil;
    r.merged_count  = 0;
    r.merged_to_out = nil;
    init_section_groups(?r.groups);
    init_atom_plan(?r.atoms);
    r.strm     = StrMerge{};
    r.sym_locs = map.init[intern.StrId, SymbolLoc](alloc);
    init_dynstate(?r.dyn);
    r.out_img = target_of.object_image_init(alloc, itn, intern.STR_NIL);
}

pub fun resolution_dnit(r: *Resolution, alloc: *A.Allocator) {
    target_of.object_image_dnit(?r.out_img);
    free_dynstate(alloc, ?r.dyn);
    map.dnit[intern.StrId, SymbolLoc](?r.sym_locs);
    free_str_merge(?r.strm);
    free_atom_plan(alloc, ?r.atoms);
    free_section_groups(alloc, ?r.groups);
    if (r.merged_to_out != nil && r.merged_count > 0) { A.deallocate[u32](alloc, r.merged_to_out, r.merged_count::usize); }
    if (r.merged != nil && r.merged_count > 0)        { A.deallocate[MergedSection](alloc, r.merged, r.merged_count::usize); }
    free_placements(alloc, r.placements, r.sec_total);
    if (r.sec_base != nil && r.module_count > 0) { A.deallocate[u32](alloc, r.sec_base, r.module_count::usize); }
    r.sec_base      = nil;
    r.placements    = nil;
    r.merged        = nil;
    r.merged_to_out = nil;
}
