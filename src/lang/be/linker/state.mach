# the working state of one link: its inputs, the layout its phases resolve,
# the tables they reserve and the image they build, owned by one record and
# released by one dnit
use std.collections.map;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.intern;
use mach.lang.session;
use lang_target:      mach.lang.target;
use catalog_artifact: mach.lang.target.catalog.artifact;
use target_of:        mach.lang.target.of;

use mach.lang.be.linker.common.ExportSurface;
use mach.lang.be.linker.common.export_surface_free;
use mach.lang.be.linker.gc.LinkRoots;
use mach.lang.be.linker.input.InputSet;
use mach.lang.be.linker.input.LinkContext;
use mach.lang.be.linker.input.input_set_borrow;
use mach.lang.be.linker.input.input_set_dnit;
use mach.lang.be.linker.input.link_context;
use mach.lang.be.linker.input.link_context_dnit;
use mach.lang.be.linker.merge.assign_section_vaddrs;
use mach.lang.be.linker.merge.finalize_placement_vaddrs;
use mach.lang.be.linker.merge.os_base_addr;
use mach.lang.be.linker.reloc.LocalGotPlan;
use mach.lang.be.linker.reloc.finalize_local_got_vaddrs;
use mach.lang.be.linker.reloc.free_local_got_plan;
use mach.lang.be.linker.reloc.init_local_got_plan;
use mach.lang.be.linker.resolution.Resolution;
use mach.lang.be.linker.resolution.resolution_dnit;
use mach.lang.be.linker.resolution.resolution_init;
use mach.lang.be.linker.resolve.SymbolLoc;
use mach.lang.be.linker.resolve.collect_symbols;
use mach.lang.be.linker.thunk.ThunkPlan;
use mach.lang.be.linker.thunk.free_thunk_plan;
use mach.lang.be.linker.thunk.init_thunk_plan;
use mach.lang.be.linker.unwind.UnwindPlan;
use mach.lang.be.linker.unwind.free_unwind_plan;
use mach.lang.be.linker.unwind.init_unwind_plan;

# roots.surface points at surface and synth.roots at roots, so a LinkState
# stays where link_state_init put it
pub rec LinkState {
    s:       *session.Session;
    tgt:     *lang_target.Binding;
    mode:    catalog_artifact.Kind;
    inputs:  InputSet;
    surface: ExportSurface;
    roots:   LinkRoots;
    synth:   LinkContext;
    # the writer's options, with the machine flags and attributes the inputs
    # settle, whose attributes the state owns
    opts: target_of.ImageOptions;
    # a position-independent executable, and one the loader binds imports into
    pie:     bool;
    dynamic: bool;

    debug_names:    *intern.StrId;
    debug_count:    u32;
    sym_base:       *u32;
    sym_out:        *u32;
    sym_total:      u32;
    header_reserve: u64;

    resolution:      Resolution;
    local_got:       LocalGotPlan;
    thunks:          ThunkPlan;
    unwind:          UnwindPlan;
    unwind_reserved: bool;
    natives:         *target_of.NativeUnwind;
    native_count:    u32;
}

pub fun link_state_init(st: *LinkState, s: *session.Session, tgt: *lang_target.Binding, mode: catalog_artifact.Kind,
    modules: *target_of.ObjectImage, module_count: u32, image_options: target_of.ImageOptions) {
    st.s                   = s;
    st.tgt                 = tgt;
    st.mode                = mode;
    st.inputs              = input_set_borrow(modules, module_count);
    st.surface             = ExportSurface{requested: map.init[intern.StrId, u32](s.alloc), count: 0};
    st.roots               = LinkRoots{};
    st.roots.entry         = intern.STR_NIL;
    st.roots.surface       = ?st.surface;
    st.synth               = link_context(s, tgt, mode, ?st.roots);
    st.opts                = image_options;
    st.opts.attributes     = nil;
    st.opts.attributes_len = 0;
    st.pie                 = false;
    st.dynamic             = false;
    st.debug_names         = nil;
    st.debug_count         = 0;
    st.sym_base            = nil;
    st.sym_out             = nil;
    st.sym_total           = 0;
    st.header_reserve      = 0;
    resolution_init(?st.resolution, s.alloc, ?s.interner, tgt.of, tgt.isa, os_base_addr(tgt));
    init_local_got_plan(?st.local_got);
    init_thunk_plan(?st.thunks);
    init_unwind_plan(?st.unwind);
    st.unwind_reserved = false;
    st.natives         = nil;
    st.native_count    = 0;
}

pub fun link_state_dnit(st: *LinkState) {
    val alloc: *A.Allocator = st.s.alloc;
    if (st.natives != nil && st.native_count > 0) { A.deallocate[target_of.NativeUnwind](alloc, st.natives, st.native_count::usize); }
    free_unwind_plan(alloc, ?st.unwind);
    free_thunk_plan(alloc, ?st.thunks);
    free_local_got_plan(alloc, ?st.local_got);
    resolution_dnit(?st.resolution, alloc);
    if (st.sym_out != nil && st.sym_total > 0)       { A.deallocate[u32](alloc, st.sym_out, st.sym_total::usize); }
    if (st.sym_base != nil && st.inputs.count > 0)   { A.deallocate[u32](alloc, st.sym_base, st.inputs.count::usize); }
    if (st.debug_names != nil && st.debug_count > 0) { A.deallocate[intern.StrId](alloc, st.debug_names, st.debug_count::usize); }
    if (st.opts.attributes != nil && st.opts.attributes_len > 0) {
        A.deallocate[u8](alloc, st.opts.attributes, st.opts.attributes_len::usize);
    }
    link_context_dnit(?st.synth);
    export_surface_free(?st.surface);
    input_set_dnit(alloc, ?st.inputs);
    st.natives      = nil;
    st.native_count = 0;
    st.sym_out      = nil;
    st.sym_base     = nil;
    st.debug_names  = nil;
}

# lays the merged sections out again under the current header reserve and
# reads every address the layout gives back out of it afresh
pub fun relayout(st: *LinkState) err[fail.Fail] {
    val rs:     *Resolution    = ?st.resolution;
    val placed: err[fail.Fail] = assign_section_vaddrs(st.tgt, rs.merged, st.header_reserve);
    if (sel placed.err) { ret placed; }
    finalize_placement_vaddrs(rs.merged, rs.placements, rs.sec_total);
    if (st.local_got.count > 0) { finalize_local_got_vaddrs(rs.merged, ?st.local_got); }
    map.dnit[intern.StrId, SymbolLoc](?rs.sym_locs);
    rs.sym_locs = map.init[intern.StrId, SymbolLoc](st.s.alloc);
    ret collect_symbols(st.s, rs.modules, rs.module_count, rs.placements, rs.sec_base, ?rs.sym_locs, true, ?rs.atoms);
}
