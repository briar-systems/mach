use std.collections.sort;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use lang_checked:    mach.lang.checked;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.growth;
use mach.lang.intern;
use mach.lang.session;
use lang_target: mach.lang.target;
use target_of:   mach.lang.target.of;

use mach.lang.be.linker.atoms.ATOM_OWNS;
use mach.lang.be.linker.atoms.AtomPlan;
use mach.lang.be.linker.atoms.atom_live_len;
use mach.lang.be.linker.atoms.atom_live_offset;
use mach.lang.be.linker.atoms.atom_offset_dead;
use mach.lang.be.linker.atoms.copy_live_section;
use mach.lang.be.linker.atoms.plan_atom_coalescing;
use mach.lang.be.linker.common.add_u32_counts;
use mach.lang.be.linker.common.fill_section_bases;
use mach.lang.be.linker.common.is_loadable_kind;
use mach.lang.be.linker.common.name_intern;
use mach.lang.be.linker.common.name_text;
use mach.lang.be.linker.common.total_sections;
use mach.lang.be.linker.debug.StrMerge;
use mach.lang.be.linker.debug.debug_abbrev_tables_equal;
use mach.lang.be.linker.debug.module_debug_is_linkable;

pub val MERGED_KIND_COUNT: u32 = target_of.SK_COUNT;

rec MergedSectionCountUnit {}

rec FrameCountUnit {}

pub rec Placement {
    merged_index: u32;
    offset:       u32;
    vaddr:        u64;
    extent:       u32;
    # who places the section: the merge (PLACE_MERGED), or the unwind tables,
    # which carry an object's frame descriptions into theirs and read its
    # unwind index without placing it
    claim: u8;
}

val     PLACE_MERGED:        u8 = 0;
pub val PLACE_UNWIND_FRAMES: u8 = 1;
pub val PLACE_UNWIND_INDEX:  u8 = 2;

pub rec MergedSection {
    kind:  target_of.SectionKind;
    name:  intern.StrId;
    align: u32;
    len:   u32;
    vaddr: u64;
    used:  bool;
}

rec SectionGroup {
    name:   intern.StrId;
    slot:   u32;
    flags:  u32;
    align:  u32;
    len:    u32;
    base:   u32;
    cursor: u32;
}

pub rec SectionGroups {
    items: *SectionGroup;
    count: u32;
    cap:   u32;
}

pub fun init_section_groups(g: *SectionGroups) {
    g.items = nil;
    g.count = 0;
    g.cap   = 0;
}

pub fun free_section_groups(alloc: *A.Allocator, g: *SectionGroups) {
    if (g.items != nil && g.cap > 0) { A.deallocate[SectionGroup](alloc, g.items, g.cap::usize); }
    init_section_groups(g);
}

pub fun section_group_index(g: *SectionGroups, slot: u32, name: intern.StrId, flags: u32) u32 {
    var i: u32 = 0;
    for (i < g.count) {
        if (g.items[i].slot == slot && intern.str_same(g.items[i].name, name)
            && g.items[i].flags == flags) { ret i; }
        i = i + 1;
    }
    ret 0xFFFFFFFF;
}

pub fun section_group_add(alloc: *A.Allocator, g: *SectionGroups, slot: u32,
    name: intern.StrId, flags: u32) res[u32, fail.Fail] {
    if (g.count == g.cap) {
        val grown: err[A.Error] = growth.reserve[SectionGroup](alloc, ?g.items, ?g.cap, g.count::usize + 1);
        if (sel grown.err) { ret res[u32, fail.Fail].err{fail.refused(grown.err)}; }
    }
    val i: u32 = g.count;
    g.items[i].name   = name;
    g.items[i].slot   = slot;
    g.items[i].flags  = flags;
    g.items[i].align  = 1;
    g.items[i].len    = 0;
    g.items[i].base   = 0;
    g.items[i].cursor = 0;
    g.count           = i + 1;
    ret res[u32, fail.Fail].ok{i};
}

fun plan_section_groups(alloc: *A.Allocator, modules: *target_of.ObjectImage, module_count: u32,
    merged: *MergedSection, atoms: *AtomPlan, sec_base: *u32, placements: *Placement,
    dup: *u32, groups: *SectionGroups) err[fail.Fail] {
    var m: u32 = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val sec: *target_of.Section = ?modules[m].sections[sc];
            if (sec.kind::u32 >= MERGED_KIND_COUNT) {
                sc = sc + 1;
                cnt;
            }
            if (!is_loadable_kind(sec.kind)) {
                sc = sc + 1;
                cnt;
            }
            if (dup != nil && dup[sec_base[m] + sc] != ATOM_OWNS) {
                sc = sc + 1;
                cnt;
            }
            if (placements[sec_base[m] + sc].claim != PLACE_MERGED) {
                sc = sc + 1;
                cnt;
            }

            val slot: u32 = sec.kind::u32;
            var gi:   u32 = section_group_index(groups, slot, sec.name, sec.flags & target_of.SEC_FLAG_IMAGE_MASK);
            if (gi == 0xFFFFFFFF) {
                val ar: res[u32, fail.Fail] = section_group_add(alloc, groups, slot, sec.name, sec.flags & target_of.SEC_FLAG_IMAGE_MASK);
                if (sel ar.err) { ret err[fail.Fail].err{ar.err}; }
                gi = ar.ok;
            }
            var a: u32 = sec.align;
            if (a == 0)                     { a = 1; }
            if (a > groups.items[gi].align) { groups.items[gi].align = a; }
            val off_r: res[u64, fail.Fail] = align_up_u64_checked(groups.items[gi].len::u64, a::u64);
            if (sel off_r.err) { ret err[fail.Fail].err{off_r.err}; }
            val off64: u64 = off_r.ok;
            val end:   u64 = off64 + atom_live_len(atoms, sec_base[m] + sc, sec.len)::u64;
            if (end > 0xFFFFFFFF) {
                ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "merged section group exceeds the 4 GiB u32 limit")};
            }
            groups.items[gi].len = end::u32;
            sc                   = sc + 1;
        }
        m = m + 1;
    }

    var slot: u32 = 0;
    for (slot < MERGED_KIND_COUNT) {
        if (!is_loadable_kind(slot::u8)) {
            slot = slot + 1;
            cnt;
        }
        var run: u64 = 0;
        var i:   u32 = 0;
        for (i < groups.count) {
            if (groups.items[i].slot == slot) {
                val run_r: res[u64, fail.Fail] = align_up_u64_checked(run, groups.items[i].align::u64);
                if (sel run_r.err) { ret err[fail.Fail].err{run_r.err}; }
                run = run_r.ok;
                if (run + groups.items[i].len::u64 > 0xFFFFFFFF) {
                    ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "merged section exceeds the 4 GiB u32 limit")};
                }
                groups.items[i].base   = run::u32;
                groups.items[i].cursor = run::u32;
                run                    = run + groups.items[i].len::u64;
            }
            i = i + 1;
        }
        slot = slot + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun init_merged(merged: *MergedSection, debug_names: *intern.StrId, debug_count: u32) {
    var i: u32 = 0;
    for (i < MERGED_KIND_COUNT) {
        merged[i].kind  = i::u8;
        merged[i].name  = intern.STR_NIL;
        merged[i].align = 1;
        merged[i].len   = 0;
        merged[i].vaddr = 0;
        merged[i].used  = false;
        i               = i + 1;
    }
    var d: u32 = 0;
    for (d < debug_count) {
        val slot: u32 = MERGED_KIND_COUNT + d;
        merged[slot].kind  = target_of.SK_DEBUG;
        merged[slot].name  = debug_names[d];
        merged[slot].align = 1;
        merged[slot].len   = 0;
        merged[slot].vaddr = 0;
        merged[slot].used  = false;
        d                  = d + 1;
    }
}

pub fun merged_section_count(debug_count: u32) res[u32, fail.Fail] {
    val total_r: res[u32, lang_checked.Cause] = add_u32_counts[MergedSectionCountUnit](MERGED_KIND_COUNT, debug_count);
    if (sel total_r.err) {
        ret res[u32, fail.Fail].err{fail.message("merged section count overflow")};
    }
    ret res[u32, fail.Fail].ok{total_r.ok};
}

fun total_frames(modules: *target_of.ObjectImage, module_count: u32) res[u32, fail.Fail] {
    var total: lang_checked.Count[FrameCountUnit] =
        lang_checked.count[FrameCountUnit](0::usize);
    var module_index: u32 = 0;
    for (module_index < module_count) {
        val added_r: res[lang_checked.Count[FrameCountUnit], lang_checked.Cause] =
            lang_checked.count_add[FrameCountUnit](total,
            lang_checked.count[FrameCountUnit](modules[module_index].frame_count::usize));
        if (sel added_r.err) {
            ret res[u32, fail.Fail].err{fail.message("total input frame count overflow")};
        }
        total        = added_r.ok;
        module_index = module_index + 1;
    }
    val total32_r: res[u32, lang_checked.Cause] = lang_checked.usize_to_u32(total.value);
    if (sel total32_r.err) {
        ret res[u32, fail.Fail].err{fail.message("total input frame count exceeds the u32 limit")};
    }
    ret res[u32, fail.Fail].ok{total32_r.ok};
}

pub fun accumulate_sections(s: *session.Session, modules: *target_of.ObjectImage, module_count: u32,
    merged: *MergedSection, debug_names: *intern.StrId, debug_count: u32,
    placements: *Placement, sec_base: *u32, strm: *StrMerge,
    atoms: *AtomPlan, groups: *SectionGroups) err[fail.Fail] {
    val fsb_r: err[fail.Fail] = fill_section_bases(modules, module_count, sec_base);
    if (sel fsb_r.err) { ret fsb_r; }
    val sec_total_r: res[u32, fail.Fail] = total_sections(modules, module_count);
    if (sel sec_total_r.err) { ret err[fail.Fail].err{sec_total_r.err}; }
    val sec_total: u32                  = sec_total_r.ok;
    val dr:        res[*u32, fail.Fail] =
        plan_atom_coalescing(s.alloc, modules, module_count, sec_base, sec_total, atoms);
    if (sel dr.err) { ret err[fail.Fail].err{dr.err}; }
    val dup: *u32 = dr.ok;
    fin {
        if (dup != nil && sec_total > 0) { A.deallocate[u32](s.alloc, dup, sec_total::usize); }
    }
    val gp: err[fail.Fail] =
        plan_section_groups(s.alloc, modules, module_count, merged, atoms, sec_base, placements, dup, groups);
    if (sel gp.err) { ret gp; }

    val an_r: res[intern.StrId, A.Error] = intern.add(?s.interner, ".debug_abbrev");
    if (sel an_r.err) { ret err[fail.Fail].err{fail.refused(an_r.err)}; }
    val abbrev_name:           intern.StrId       = an_r.ok;
    var abbrev_representative: *target_of.Section = nil;

    var flat: u32 = 0;
    var m:    u32 = 0;
    for (m < module_count) {
        val debug_linkable: bool = module_debug_is_linkable(modules, m);
        var sc:             u32  = 0;
        for (sc < modules[m].section_count) {
            val sec: *target_of.Section = ?modules[m].sections[sc];
            if (sec.kind::u32 >= MERGED_KIND_COUNT) {
                ret err[fail.Fail].err{fail.user_of(diagnostic_kind.OBJECT_MALFORMED, malformed_input_member(s, "SectionKind", sec.kind::u32, modules[m].name))};
            }
            if (placements[flat].claim != PLACE_MERGED) {
                flat = flat + 1;
                sc   = sc + 1;
                cnt;
            }
            var ki:       u32  = sec.kind::u32;
            var dedup:    bool = false;
            var str_slot: bool = false;
            if (sec.kind == target_of.SK_DEBUG) {
                var found: bool = false;
                var di:    u32  = 0;
                for (di < debug_count) {
                    if (intern.str_same(debug_names[di], sec.name)) {
                        ki    = MERGED_KIND_COUNT + di;
                        found = true;
                    }
                    di = di + 1;
                }
                if (!found) { ret err[fail.Fail].err{fail.message("debug section name not registered in the merge")}; }
                if (intern.str_same(sec.name, abbrev_name)
                    && debug_abbrev_tables_equal(abbrev_representative, sec)) {
                    dedup = true;
                }
                if (strm.active && intern.str_same(sec.name, strm.name)) { str_slot = true; }
            }

            if (sec.kind == target_of.SK_DEBUG && !debug_linkable) {
                placements[flat].merged_index = ki;
                placements[flat].offset       = 0;
                placements[flat].vaddr        = 0;
                placements[flat].extent       = 0;
                flat                          = flat + 1;
                sc                            = sc + 1;
                cnt;
            }

            if (sec.kind == target_of.SK_DEBUG && intern.str_same(sec.name, abbrev_name) && sec.len > 0
                && abbrev_representative == nil) {
                abbrev_representative = sec;
            }

            if (str_slot) {
                var a: u32 = sec.align;
                if (a == 0)               { a = 1; }
                if (a > merged[ki].align) { merged[ki].align = a; }
                merged[ki].len                = strm.buf.bytes.len::u32;
                merged[ki].used               = true;
                placements[flat].merged_index = ki;
                placements[flat].offset       = 0;
                placements[flat].vaddr        = 0;
                placements[flat].extent       = 0;
            }
            or (dedup) {
                var a: u32 = sec.align;
                if (a == 0)               { a = 1; }
                if (a > merged[ki].align) { merged[ki].align = a; }
                placements[flat].merged_index = ki;
                placements[flat].offset       = 0;
                placements[flat].vaddr        = 0;
                placements[flat].extent       = 0;
            }
            or (dup != nil && dup[flat] != ATOM_OWNS) {
                placements[flat]        = placements[dup[flat]];
                placements[flat].extent = 0;
            }
            or {
                var a: u32 = sec.align;
                if (sec.kind == target_of.SK_EXCEPTION) { a = 4; }
                if (a == 0)                             { a = 1; }
                if (a > merged[ki].align)               { merged[ki].align = a; }

                var cursor: u64 = merged[ki].len::u64;
                var gi:     u32 = 0xFFFFFFFF;
                if (is_loadable_kind(sec.kind)) {
                    gi = section_group_index(groups, ki, sec.name, sec.flags & target_of.SEC_FLAG_IMAGE_MASK);
                    if (gi == 0xFFFFFFFF) { ret err[fail.Fail].err{fail.message("section group not registered in the merge")}; }
                    cursor = groups.items[gi].cursor::u64;
                }
                val off_r: res[u64, fail.Fail] = align_up_u64_checked(cursor, a::u64);
                if (sel off_r.err) { ret err[fail.Fail].err{off_r.err}; }
                val off64:            u64 = off_r.ok;
                val contribution_len: u32 = atom_live_len(atoms, flat, sec.len);
                val newlen:           u64 = off64 + contribution_len::u64;
                if (newlen > 0xFFFFFFFF) {
                    val kind_name: res[str, fail.Fail] = merged_section_text(s, sec.kind);
                    if (sel kind_name.err) { ret err[fail.Fail].err{kind_name.err}; }
                    ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_SIZE_LIMIT, fail.format_intern(?s.interner, s.alloc, "merged section '{}' exceeds the 4 GiB u32 limit", kind_name.ok))};
                }

                placements[flat].merged_index = ki;
                placements[flat].offset       = off64::u32;
                placements[flat].vaddr        = 0;
                placements[flat].extent       = contribution_len;

                if (gi != 0xFFFFFFFF) {
                    groups.items[gi].cursor = newlen::u32;
                    if (newlen::u32 > merged[ki].len) { merged[ki].len = newlen::u32; }
                }
                or { merged[ki].len = newlen::u32; }
                merged[ki].used = true;
                if (sec.kind == target_of.SK_EXCEPTION && intern.str_is_nil(merged[ki].name)) {
                    merged[ki].name = sec.name;
                }
            }

            flat = flat + 1;
            sc   = sc + 1;
        }
        m = m + 1;
    }
    ret err[fail.Fail].ok{};
}

rec Contribution {
    merged_index: u32;
    offset:       u32;
    extent:       u32;
    flat:         u32;
}

fun contribution_order(a: *Contribution, b: *Contribution) i64 {
    if (a.merged_index < b.merged_index) { ret -1; }
    if (a.merged_index > b.merged_index) { ret 1; }
    if (a.offset < b.offset)             { ret -1; }
    if (a.offset > b.offset)             { ret 1; }
    if (a.flat < b.flat)                 { ret -1; }
    if (a.flat > b.flat)                 { ret 1; }
    ret 0;
}

fun contribution_name(s: *session.Session, modules: *target_of.ObjectImage, module_count: u32,
    sec_base: *u32, flat: u32) res[str, fail.Fail] {
    var m: u32 = 0;
    for (m < module_count) {
        val base: u32 = sec_base[m];
        if (flat >= base && flat < base + modules[m].section_count) {
            ret fail.format_intern(?s.interner, s.alloc, "{}:{}", name_text(s, modules[m].name, "?"),
                name_text(s, modules[m].sections[flat - base].name, "?"));
        }
        m = m + 1;
    }
    ret res[str, fail.Fail].err{fail.message("a section contribution lies outside every input")};
}

fun overlap_fail(s: *session.Session, modules: *target_of.ObjectImage, module_count: u32,
    sec_base: *u32, a: *Contribution, b: *Contribution) fail.Fail {
    val an: res[str, fail.Fail] = contribution_name(s, modules, module_count, sec_base, a.flat);
    if (sel an.err) { ret an.err; }
    val bn: res[str, fail.Fail] = contribution_name(s, modules, module_count, sec_base, b.flat);
    if (sel bn.err) { ret bn.err; }
    ret fail.message_of(fail.format_intern(?s.interner, s.alloc,
        "'{}' claims bytes {} through {} of a merged output section and '{}' claims bytes {} through {}; two contributions cannot occupy the same output range",
        an.ok, a.offset::u64, a.offset::u64 + a.extent::u64,
        bn.ok, b.offset::u64, b.offset::u64 + b.extent::u64));
}

pub fun validate_no_contribution_overlap(s: *session.Session, modules: *target_of.ObjectImage,
    module_count: u32, sec_base: *u32,
    placements: *Placement, sec_total: u32) err[fail.Fail] {
    if (sec_total < 2) { ret err[fail.Fail].ok{}; }

    val ar: res[*Contribution, A.Error] = A.allocate[Contribution](s.alloc, sec_total::usize);
    if (sel ar.err) {
        ret err[fail.Fail].err{fail.refused(ar.err)};
    }
    val items: *Contribution = ar.ok;
    fin { A.deallocate[Contribution](s.alloc, items, sec_total::usize); }

    var n:    usize = 0;
    var flat: u32   = 0;
    for (flat < sec_total) {
        if (placements[flat].extent != 0) {
            items[n].merged_index = placements[flat].merged_index;
            items[n].offset       = placements[flat].offset;
            items[n].extent       = placements[flat].extent;
            items[n].flat         = flat;
            n                     = n + 1;
        }
        flat = flat + 1;
    }
    if (n < 2) { ret err[fail.Fail].ok{}; }

    sort.sort_by[Contribution](items, n, contribution_order);

    var i: usize = 1;
    for (i < n) {
        val prev: *Contribution = ?items[i - 1];
        val cur:  *Contribution = ?items[i];
        if (prev.merged_index == cur.merged_index
            && prev.offset::u64 + prev.extent::u64 > cur.offset::u64) {
            ret err[fail.Fail].err{overlap_fail(s, modules, module_count, sec_base, prev, cur)};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# one alignment for the whole linker, over the same primitive the object
# writers' file plan uses
pub fun align_up_u64_checked(value: u64, alignment: u64) res[u64, fail.Fail] {
    val aligned: res[u64, lang_checked.Cause] = lang_checked.align_u64_up(value, alignment);
    if (sel aligned.err) {
        if (aligned.err == lang_checked.ADD_OVERFLOW) {
            ret res[u64, fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "layout alignment overflows the address space")};
        }
        ret res[u64, fail.Fail].err{fail.message("layout alignment is not a nonzero power of two")};
    }
    ret res[u64, fail.Fail].ok{aligned.ok};
}

pub fun reorder_flat_entry_first(modules: *target_of.ObjectImage, module_count: u32,
    merged: *MergedSection, placements: *Placement, sec_base: *u32,
    atoms: *AtomPlan, entry_name: intern.StrId) err[fail.Fail] {
    var entry_flat: u32 = 0xFFFFFFFF;
    var m:          u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *target_of.Symbol = ?modules[m].symbols[sy];
            if (intern.str_same(sym.name, entry_name) && !target_of.section_is_external(sym.section)
                && target_of.section_index(sym.section) < modules[m].section_count
                && modules[m].sections[target_of.section_index(sym.section)].kind == target_of.SK_TEXT) {
                entry_flat = sec_base[m] + target_of.section_index(sym.section);
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    if (entry_flat == 0xFFFFFFFF) { ret err[fail.Fail].ok{}; }

    val text_slot: u32 = target_of.SK_TEXT::u32;

    var run:  u64 = 0;
    var pass: u32 = 0;
    for (pass < 2) {
        m = 0;
        for (m < module_count) {
            var sc: u32 = 0;
            for (sc < modules[m].section_count) {
                val flat: u32 = sec_base[m] + sc;
                if (placements[flat].merged_index == text_slot) {
                    val is_entry: bool = flat == entry_flat;
                    if ((pass == 0 && is_entry) || (pass == 1 && !is_entry)) {
                        var a: u32 = modules[m].sections[sc].align;
                        if (a == 0) { a = 1; }
                        val aligned_r: res[u64, fail.Fail] = align_up_u64_checked(run, a::u64);
                        if (sel aligned_r.err) {
                            ret err[fail.Fail].err{aligned_r.err};
                        }
                        val aligned:      u64 = aligned_r.ok;
                        val contribution: u64 =
                            atom_live_len(atoms, flat, modules[m].sections[sc].len)::u64;
                        if (aligned > 0xFFFFFFFFFFFFFFFF - contribution) {
                            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "entry-first text layout overflows the address space")};
                        }
                        val next: u64 = aligned + contribution;
                        if (next > 0xFFFFFFFF) {
                            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "entry-first text layout exceeds the 4 GiB u32 limit")};
                        }
                        placements[flat].offset = aligned::u32;
                        run                     = next;
                    }
                }
                sc = sc + 1;
            }
            m = m + 1;
        }
        pass = pass + 1;
    }

    merged[text_slot].len = run::u32;
    ret err[fail.Fail].ok{};
}

pub fun assign_section_vaddrs(tgt: *lang_target.Binding, merged: *MergedSection,
    reserve: u64) err[fail.Fail] {
    val base: u64 = os_base_addr(tgt);
    val page: u64 = os_page_size(tgt);
    if (page == 0 || (page & (page - 1)) != 0) {
        ret err[fail.Fail].err{fail.message("target page size is not a nonzero power of two")};
    }
    if (base > 0xFFFFFFFFFFFFFFFF - reserve) {
        ret err[fail.Fail].err{fail.message("image base and header reserve overflow the address space")};
    }

    var va: u64 = base + reserve;
    var i:  u32 = 0;
    for (i < MERGED_KIND_COUNT) {
        if (merged[i].used && is_loadable_kind(merged[i].kind)) {
            var seg_align: u64 = merged[i].align::u64;
            if (seg_align < page) { seg_align = page; }
            val aligned_r: res[u64, fail.Fail] = align_up_u64_checked(va, seg_align);
            if (sel aligned_r.err) {
                ret err[fail.Fail].err{aligned_r.err};
            }
            val aligned: u64 = aligned_r.ok;
            if (aligned > 0xFFFFFFFFFFFFFFFF - merged[i].len::u64) {
                ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "section virtual address range overflows the address space")};
            }
            merged[i].vaddr = aligned;
            va              = aligned + merged[i].len::u64;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun finalize_placement_vaddrs(merged: *MergedSection, placements: *Placement, sec_total: u32) {
    var i: u32 = 0;
    for (i < sec_total) {
        val ki: u32 = placements[i].merged_index;
        placements[i].vaddr = merged[ki].vaddr + placements[i].offset::u64;
        i                   = i + 1;
    }
}

pub fun build_merged_image(s: *session.Session, out_img: *target_of.ObjectImage,
    modules: *target_of.ObjectImage, module_count: u32,
    merged: *MergedSection, merged_count: u32, placements: *Placement, sec_base: *u32,
    merged_to_out: *u32, sym_base: *u32, sym_out: *u32, strm: *StrMerge,
    atoms: *AtomPlan) err[fail.Fail] {
    val alloc:         *A.Allocator        = s.alloc;
    val frame_total_r: res[u32, fail.Fail] = total_frames(modules, module_count);
    if (sel frame_total_r.err) {
        ret err[fail.Fail].err{frame_total_r.err};
    }
    val frame_total: u32 = frame_total_r.ok;

    var k: u32 = 0;
    for (k < merged_count) {
        merged_to_out[k] = 0xFFFFFFFF;
        k                = k + 1;
    }

    k = 0;
    for (k < merged_count) {
        if (!merged[k].used || merged[k].len == 0) {
            k = k + 1;
            cnt;
        }

        var bytes: *u8 = nil;
        if (merged[k].kind != target_of.SK_BSS) {
            val zr: res[*u8, A.Error] = A.zallocate[u8](alloc, merged[k].len::usize);
            if (sel zr.err) { ret err[fail.Fail].err{fail.refused(zr.err)}; }
            bytes = zr.ok;

            if (strm.active && merged[k].kind == target_of.SK_DEBUG && intern.str_same(merged[k].name, strm.name)
                && strm.buf.bytes.len > 0) {
                memory.copy[u8](bytes, strm.buf.bytes.data, strm.buf.bytes.len);
            }
        }

        var sec: target_of.Section;
        sec.name = merged[k].name;
        if (intern.str_is_nil(sec.name)) {
            val text: res[str, fail.Fail] = merged_section_text(s, merged[k].kind);
            if (sel text.err) { ret err[fail.Fail].err{text.err}; }
            val named: res[intern.StrId, fail.Fail] = name_intern(s, text.ok);
            if (sel named.err) { ret err[fail.Fail].err{named.err}; }
            sec.name = named.ok;
        }
        sec.kind  = merged[k].kind;
        sec.bytes = bytes;
        sec.len   = merged[k].len;
        sec.align = merged[k].align;
        sec.flags = 0;

        val add_r: res[u32, fail.Fail] = target_of.section_install(out_img, ?sec);
        if (sel add_r.err) {
            ret err[fail.Fail].err{add_r.err};
        }
        merged_to_out[k] = add_r.ok;
        k                = k + 1;
    }

    var m: u32 = 0;
    for (m < module_count) {
        val debug_linkable: bool = module_debug_is_linkable(modules, m);
        var sc:             u32  = 0;
        for (sc < modules[m].section_count) {
            val src: *target_of.Section = ?modules[m].sections[sc];
            if (src.kind == target_of.SK_BSS || src.bytes == nil || src.len == 0) {
                sc = sc + 1;
                cnt;
            }
            if (strm.active && src.kind == target_of.SK_DEBUG && intern.str_same(src.name, strm.name)) {
                sc = sc + 1;
                cnt;
            }
            if (src.kind == target_of.SK_DEBUG && !debug_linkable) {
                sc = sc + 1;
                cnt;
            }

            val flat:   u32 = sec_base[m] + sc;
            val ki:     u32 = placements[flat].merged_index;
            val out_ix: u32 = merged_to_out[ki];
            if (out_ix == 0xFFFFFFFF || placements[flat].claim == PLACE_UNWIND_INDEX) {
                sc = sc + 1;
                cnt;
            }

            val dst: *u8 = out_img.sections[out_ix].bytes;
            val off: u32 = placements[flat].offset;
            if (atom_live_len(atoms, flat, src.len) > 0) {
                copy_live_section(?dst[off], src.bytes, src.len, atoms, flat);
            }

            sc = sc + 1;
        }
        m = m + 1;
    }

    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            if (sym_out != nil) { sym_out[sym_base[m] + sy] = target_of.SYMBOL_NONE; }
            val isym: *target_of.Symbol = ?modules[m].symbols[sy];
            if (target_of.section_is_absolute(isym.section)) {
                val added: res[u32, fail.Fail] = target_of.symbol_add(out_img, @isym);
                if (sel added.err)  { ret err[fail.Fail].err{added.err}; }
                if (sym_out != nil) { sym_out[sym_base[m] + sy] = added.ok; }
                sy = sy + 1;
                cnt;
            }
            if (target_of.section_is_external(isym.section) || target_of.section_index(isym.section) >= modules[m].section_count) {
                sy = sy + 1;
                cnt;
            }

            val flat: u32 = sec_base[m] + target_of.section_index(isym.section);
            if (atom_offset_dead(atoms, flat, isym.offset) || placements[flat].claim == PLACE_UNWIND_INDEX) {
                sy = sy + 1;
                cnt;
            }
            val ki:     u32 = placements[flat].merged_index;
            val out_ix: u32 = merged_to_out[ki];
            if (out_ix == 0xFFFFFFFF) {
                sy = sy + 1;
                cnt;
            }

            var osym: target_of.Symbol = @isym;
            osym.section = target_of.section_id(out_ix);
            osym.offset  = placements[flat].offset
                + atom_live_offset(atoms, flat, isym.offset);

            val sa: res[u32, fail.Fail] = target_of.symbol_add(out_img, osym);
            if (sel sa.err) { ret err[fail.Fail].err{sa.err}; }
            if (sym_out != nil) {
                sym_out[sym_base[m] + sy] = sa.ok;
            }

            sy = sy + 1;
        }
        m = m + 1;
    }

    if (frame_total > 0) {
        val fa: res[*target_of.FrameUnwind, A.Error] = A.allocate[target_of.FrameUnwind](out_img.alloc, frame_total::usize);
        if (sel fa.err) { ret err[fail.Fail].err{fail.refused(fa.err)}; }
        var out_frames: *target_of.FrameUnwind = fa.ok;
        var fn:         u32                    = 0;
        m = 0;
        for (m < module_count) {
            var fi: u32 = 0;
            for (fi < modules[m].frame_count) {
                val ifr: *target_of.FrameUnwind = ?modules[m].frames[fi];
                if (target_of.section_index(ifr.section) >= modules[m].section_count) {
                    fi = fi + 1;
                    cnt;
                }
                val flat: u32 = sec_base[m] + target_of.section_index(ifr.section);
                if (atom_offset_dead(atoms, flat, ifr.offset)) {
                    fi = fi + 1;
                    cnt;
                }
                val ki:     u32 = placements[flat].merged_index;
                val out_ix: u32 = merged_to_out[ki];
                if (out_ix == 0xFFFFFFFF) {
                    fi = fi + 1;
                    cnt;
                }

                out_frames[fn]         = @ifr;
                out_frames[fn].section = target_of.section_id(out_ix);
                out_frames[fn].offset  = placements[flat].offset
                    + atom_live_offset(atoms, flat, ifr.offset);
                fn = fn + 1;
                fi = fi + 1;
            }
            m = m + 1;
        }
        if (fn == 0) {
            A.deallocate[target_of.FrameUnwind](out_img.alloc, out_frames, frame_total::usize);
        }
        or {
            var frame_cap: u32          = frame_total;
            val fitted:    err[A.Error] = growth.resize[target_of.FrameUnwind](out_img.alloc, ?out_frames, ?frame_cap, fn::usize);
            if (sel fitted.err) {
                A.deallocate[target_of.FrameUnwind](out_img.alloc, out_frames, frame_total::usize);
                ret err[fail.Fail].err{fail.refused(fitted.err)};
            }
            out_img.frames      = out_frames;
            out_img.frame_count = fn;
            out_img.frame_cap   = fn;
        }
    }

    ret err[fail.Fail].ok{};
}

pub fun segment_index_for(out_img: *target_of.ObjectImage, out_ix: u32) u32 {
    var seg: u32 = 0;
    var i:   u32 = 0;
    for (i < out_ix && i < out_img.section_count) {
        if (is_loadable_kind(out_img.sections[i].kind)) { seg = seg + 1; }
        i = i + 1;
    }
    ret seg;
}

pub fun final_section_location_for(format: *target_of.OfVTable, image_base: u64,
    out_img: *target_of.ObjectImage, out_ix: u32,
    content_vaddr: u64) target_of.ExecutableSectionLocation {
    var loc: target_of.ExecutableSectionLocation;
    loc.vaddr   = content_vaddr;
    loc.ordinal = 0;
    if (out_ix >= out_img.section_count || !is_loadable_kind(out_img.sections[out_ix].kind)) {
        ret loc;
    }

    val seg_index: u32 = segment_index_for(out_img, out_ix);
    loc.ordinal = seg_index + 1;
    if (format != nil && format.executable_section_location != nil) {
        ret format.executable_section_location(image_base, content_vaddr, seg_index);
    }
    ret loc;
}

# the name a merged section of `kind` takes when no input names it, which is
# the catalog's
fun merged_section_text(s: *session.Session, kind: target_of.SectionKind) res[str, fail.Fail] {
    val name: opt[str] = target_of.canonical_section_name(kind);
    if (sel name.none) { ret res[str, fail.Fail].err{fail.message_of(target_of.section_kind_rejection(?s.interner, s.alloc, kind))}; }
    ret res[str, fail.Fail].ok{name.some};
}

pub fun os_base_addr(tgt: *lang_target.Binding) u64 {
    if (tgt.target.base != 0) { ret tgt.target.base; }
    ret tgt.os.base_addr;
}

pub fun os_page_size(tgt: *lang_target.Binding) u64 {
    ret tgt.target.page_size;
}

# a catalog member an input object carries that its catalog does not declare:
# malformed input, named with the object it came from
fun malformed_input_member(s: *session.Session, catalog: str, tag: u32, object_name: intern.StrId) res[str, fail.Fail] {
    ret fail.catalog_interned(?s.interner, s.alloc, fail.malformed_member_in(catalog, tag, name_text(s, object_name, "")));
}

pub fun free_placements(alloc: *A.Allocator, placements: *Placement, sec_total: u32) {
    if (placements != nil && sec_total > 0) {
        A.deallocate[Placement](alloc, placements, sec_total::usize);
    }
}
