    if (direct == intern.STR_NIL)          { ret 1; }
    if (indirect == intern.STR_NIL)        { ret 1; }
    if (library == intern.STR_NIL)         { ret 1; }
    if (sel register_import_library_r.err) { ret 1; }

    var syms: [2]of.Symbol;
    syms[0].name    = indirect;
    syms[0].section = of.external_section();
    syms[0].offset  = 0;
    syms[0].size    = 0;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN
        | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = direct;
    syms[1].section = of.external_section();
    syms[1].offset  = 0;
    syms[1].size    = 0;
    syms[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN
        | of.SYM_OBJ_FLAG_FUNCTION;
    var module: of.ObjectImage = lt_image(
        ?s, lt_name(?s, "dllimport-user"), nil::*of.Section, 0,
        ?syms[0], 2, nil::*of.Relocation, 0);
    var dep: of.DynLib;
    dep.name   = library;
    dep.soname = library;
    dep.rpath  = intern.STR_NIL;
    var locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    var dyn: DynState;
    init_dynstate(?dyn);

    val built: err[fail.Fail] = build_dynamic_info(
        ?s, ?tgt, ?dyn, ?module, 1, ?locs, ?dep, 1,
        nil::*u32, nil::*AtomPlan);
    val direct_idx:   res[u32, fail.Fail] = dynstate_import_index(?dyn, direct);
    val indirect_idx: res[u32, fail.Fail] = dynstate_import_index(?dyn, indirect);
    if (sel built.err)                        { ret 1; }
    if (dyn.info.import_count != 1)           { ret 1; }
    if (dyn.info.imports[0].symbol != direct) { ret 1; }
    if (dyn.info.imports[0].lib_index != 0)   { ret 1; }
    if (!dyn.info.imports[0].is_func)         { ret 1; }
    if (sel direct_idx.err)                   { ret 1; }
    if (sel indirect_idx.err)                 { ret 1; }
    if (direct_idx.ok != 0)                   { ret 1; }
    if (indirect_idx.ok != 0)                 { ret 1; }

    free_dynstate(?alloc, ?dyn);
    map.dnit[intern.StrId, SymbolLoc](?locs);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.synthesize_local_imports:defined_local_import" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val x:           intern.StrId = lt_name(?s, "local_x");
    val y:           intern.StrId = lt_name(?s, "weak_y");
    val z:           intern.StrId = lt_name(?s, "defined_z");
    val missing:     intern.StrId = lt_name(?s, "missing");
    val imp_x:       intern.StrId = lt_name(?s, "__imp_local_x");
    val imp_y:       intern.StrId = lt_name(?s, "__imp_weak_y");
    val imp_z:       intern.StrId = lt_name(?s, "__imp_defined_z");
    val imp_missing: intern.StrId = lt_name(?s, "__imp_missing");
    if (x == intern.STR_NIL || y == intern.STR_NIL || z == intern.STR_NIL
        || missing == intern.STR_NIL || imp_x == intern.STR_NIL
        || imp_y == intern.STR_NIL || imp_z == intern.STR_NIL
        || imp_missing == intern.STR_NIL) { ret 1; }

    var code: [1]u8;
    code[0] = 0xC3;
    var text: of.Section;
    text.name  = lt_name(?s, ".text");
    text.kind  = of.SK_TEXT;
    text.bytes = ?code[0];
    text.len   = 1;
    text.align = 1;
    val global:   u32 = of.SYM_OBJ_FLAG_GLOBAL;
    val external: u32 = global | of.SYM_OBJ_FLAG_EXTERN;

    var defs: [4]of.Symbol;
    defs[0].name    = x;
    defs[0].section = of.section_id(0);
    defs[0].offset  = 0;
    defs[0].size    = 1;
    defs[0].flags   = global | of.SYM_OBJ_FLAG_FUNCTION;
    defs[1].name    = y;
    defs[1].section = of.section_id(0);
    defs[1].offset  = 0;
    defs[1].size    = 1;
    defs[1].flags   = global | of.SYM_OBJ_FLAG_WEAK;
    defs[2].name    = z;
    defs[2].section = of.section_id(0);
    defs[2].offset  = 0;
    defs[2].size    = 1;
    defs[2].flags   = global;
    defs[3].name    = imp_z;
    defs[3].section = of.section_id(0);
    defs[3].offset  = 0;
    defs[3].size    = 1;
    defs[3].flags   = global;

    var refs: [6]of.Symbol;
    refs[0].name     = imp_x;
    refs[0].section  = of.external_section();
    refs[0].flags    = external | of.SYM_OBJ_FLAG_FUNCTION;
    refs[1]          = refs[0];
    refs[2].name     = imp_y;
    refs[2].section  = of.external_section();
    refs[2].flags    = external;
    refs[3].name     = imp_z;
    refs[3].section  = of.external_section();
    refs[3].flags    = external;
    refs[4].name     = imp_missing;
    refs[4].section  = of.external_section();
    refs[4].flags    = external;
    refs[5].name     = imp_x;
    refs[5].section  = of.external_section();
    refs[5].flags    = external | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FALLBACK;
    refs[5].fallback = 4;

    var ref_code: [4]u8;
    var ref_text: of.Section;
    ref_text.name  = lt_name(?s, ".text");
    ref_text.kind  = of.SK_TEXT;
    ref_text.bytes = ?ref_code[0];
    ref_text.len   = 4;
    ref_text.align = 1;
    var ref_reloc: of.Relocation;
    ref_reloc.section = of.section_id(0);
    ref_reloc.offset  = 0;
    ref_reloc.kind    = of.RK_PC32;
    ref_reloc.sym     = 0;
    ref_reloc.addend  = 0;

    var modules: [2]of.ObjectImage;
    modules[0] = lt_image(?s, lt_name(?s, "local-defs"), ?text, 1,
        ?defs[0], 4, nil::*of.Relocation, 0);
    modules[1] = lt_image(?s, lt_name(?s, "local-refs"), ?ref_text, 1,
        ?refs[0], 6, ?ref_reloc, 1);

    var synth: of.ObjectImage;
    val made:  res[bool, fail.Fail] = synthesize_local_imports(
        ?s, "__imp_", ?modules[0], 2, LINK_EXE,
        nil::*u32, nil::*AtomPlan, ?synth);
    var made_wrong: bool = sel made.err;
    if (sel made.ok && !made.ok) { made_wrong = true; }
    if (made_wrong
        || synth.section_count != 1 || synth.sections[0].kind != of.SK_RELRO
        || synth.sections[0].len != 8 || synth.sections[0].align != 8
        || synth.symbol_count != 2 || synth.reloc_count != 1
        || synth.symbols[0].name != imp_x || of.section_index(synth.symbols[0].section) != 0
        || synth.symbols[0].offset != 0 || synth.symbols[0].size != 8
        || synth.symbols[0].flags != global
        || synth.symbols[1].name != x
        || !of.section_is_external(synth.symbols[1].section)
        || of.section_index(synth.relocations[0].section) != 0 || synth.relocations[0].offset != 0
        || synth.relocations[0].kind != of.RK_ABS64
        || synth.relocations[0].sym != 1 || synth.relocations[0].addend != 0) {
        if (sel made.ok && made.ok) { obj.dnit(?synth); }
        session.dnit(?s);
        ret 1;
    }
    obj.dnit(?synth);

    var untouched:   of.ObjectImage;
    val relocatable: res[bool, fail.Fail] = synthesize_local_imports(
        ?s, "__imp_", ?modules[0], 2, LINK_RELOCATABLE,
        nil::*u32, nil::*AtomPlan, ?untouched);
    var relocatable_wrong: bool = sel relocatable.err;
    if (sel relocatable.ok && relocatable.ok) { relocatable_wrong = true; }
    if (relocatable_wrong) {
        session.dnit(?s);
        ret 1;
    }

    var corrupt_def: of.Symbol = defs[0];
    corrupt_def.section = of.section_id(1);
    var corrupt_modules: [2]of.ObjectImage;
    corrupt_modules[0] = lt_image(?s, lt_name(?s, "corrupt-local-def"), ?text, 1,
        ?corrupt_def, 1, nil::*of.Relocation, 0);
    corrupt_modules[1] = modules[1];
    val malformed: res[bool, fail.Fail] = synthesize_local_imports(
        ?s, "__imp_", ?corrupt_modules[0], 2, LINK_EXE,
        nil::*u32, nil::*AtomPlan, ?untouched);
    var corrupt_locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    val diagnosed: err[fail.Fail] = collect_symbols(
        ?s, ?corrupt_modules[0], 2, nil::*Placement, nil::*u32,
        ?corrupt_locs, false, nil::*AtomPlan);
    map.dnit[intern.StrId, SymbolLoc](?corrupt_locs);
    val max_size: res[u32, fail.Fail] = local_import_storage_size(0x1FFFFFFF);
    val overflow: res[u32, fail.Fail] = local_import_storage_size(0x20000000);
    session.dnit(?s);
    if (sel malformed.err)         { ret 1; }
    if (malformed.ok)              { ret 1; }
    if (!sel diagnosed.err)        { ret 1; }
    if (sel max_size.err)          { ret 1; }
    if (max_size.ok != 0xFFFFFFF8) { ret 1; }
    if (!sel overflow.err)         { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.synthesize_local_imports:dead_weak_comdat" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:   session.Session       = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_9920: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_9920.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "windows", "win64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    val choice: intern.StrId = lt_name(?s, "qz_select_any");
    val local:  intern.StrId = lt_name(?s, "dead_local");
    val alias:  intern.StrId = lt_name(?s, "__imp_dead_local");
    if (choice == intern.STR_NIL || local == intern.STR_NIL
        || alias == intern.STR_NIL) { ret 1; }

    var winner_bytes:   [4]u8;
    var loser_bytes:    [8]u8;
    var provider_bytes: [1]u8;
    var sections:       [3]of.Section;
    sections[0].name  = lt_name(?s, ".text$winner");
    sections[0].kind  = of.SK_TEXT;
    sections[0].bytes = ?winner_bytes[0];
    sections[0].len   = 4;
    sections[0].align = 1;
    sections[1].name  = lt_name(?s, ".text$loser");
    sections[1].kind  = of.SK_TEXT;
    sections[1].bytes = ?loser_bytes[0];
    sections[1].len   = 8;
    sections[1].align = 1;
    sections[2].name  = lt_name(?s, ".text");
    sections[2].kind  = of.SK_TEXT;
    sections[2].bytes = ?provider_bytes[0];
    sections[2].len   = 1;
    sections[2].align = 1;

    val weak_fn: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK
        | of.SYM_OBJ_FLAG_FUNCTION;
    var winner: of.Symbol;
    winner.name    = choice;
    winner.section = of.section_id(0);
    winner.offset  = 0;
    winner.size    = 4;
    winner.flags   = weak_fn;
    var loser_syms: [2]of.Symbol;
    loser_syms[0].name    = choice;
    loser_syms[0].section = of.section_id(0);
    loser_syms[0].offset  = 0;
    loser_syms[0].size    = 8;
    loser_syms[0].flags   = weak_fn;
    loser_syms[1].name    = alias;
    loser_syms[1].section = of.external_section();
    loser_syms[1].offset  = 0;
    loser_syms[1].size    = 0;
    loser_syms[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN
        | of.SYM_OBJ_FLAG_OBJECT;
    var provider: of.Symbol;
    provider.name    = local;
    provider.section = of.section_id(0);
    provider.offset  = 0;
    provider.size    = 1;
    provider.flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var loser_reloc: of.Relocation;
    loser_reloc.section = of.section_id(0);
    loser_reloc.offset  = 0;
    loser_reloc.kind    = of.RK_PC32;
    loser_reloc.sym     = 1;
    loser_reloc.addend  = 0;

    var modules: [3]of.ObjectImage;
    modules[0] = lt_image(?s, lt_name(?s, "winner"), ?sections[0], 1,
        ?winner, 1, nil::*of.Relocation, 0);
    modules[1] = lt_image(?s, lt_name(?s, "loser"), ?sections[1], 1,
        ?loser_syms[0], 2, ?loser_reloc, 1);
    modules[2] = lt_image(?s, lt_name(?s, "provider"), ?sections[2], 1,
        ?provider, 1, nil::*of.Relocation, 0);

    var sec_base: [3]u32;
    var atoms:    AtomPlan;
    init_atom_plan(?atoms);
    val planned: err[fail.Fail] = build_atom_plan(
        ?s, ?modules[0], 3, 0, ?sec_base[0], 3, true, tgt.isa, ?atoms);
    var synth: of.ObjectImage;
    val dead:  res[bool, fail.Fail] = synthesize_local_imports(
        ?s, "__imp_", ?modules[0], 3, LINK_EXE,
        ?sec_base[0], ?atoms, ?synth);
    var control: of.ObjectImage;
    val inert:   res[bool, fail.Fail] = synthesize_local_imports(
        ?s, "__imp_", ?modules[0], 3, LINK_EXE,
        nil::*u32, nil::*AtomPlan, ?control);
    if (sel inert.ok && inert.ok) {
        obj.dnit(?control);
    }
    val discarded: bool = atoms.active;
    free_atom_plan(?alloc, ?atoms);
    session.dnit(?s);
    if (sel planned.err) { ret 1; }
    if (!discarded)      { ret 1; }
    if (sel dead.err)    { ret 1; }
    if (dead.ok)         { ret 1; }
    if (sel inert.err)   { ret 1; }
    if (!inert.ok)       { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.build_dynamic_info:partial_import_cleanup" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:   session.Session       = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_10012: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_10012.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] =
        target.select(?reg, "x86_64", "windows", "win64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    var sym: of.Symbol;
    sym.name    = lt_name(?s, "NoLibrary");
    sym.section = of.external_section();
    sym.offset  = 0;
    sym.size    = 0;
    sym.flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN
        | of.SYM_OBJ_FLAG_FUNCTION;
    var module: of.ObjectImage = lt_image(
        ?s, lt_name(?s, "unattributed-user"), nil::*of.Section, 0,
        ?sym, 1, nil::*of.Relocation, 0);
    var locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    var dyn: DynState;
    init_dynstate(?dyn);

    val built: err[fail.Fail] = build_dynamic_info(
        ?s, ?tgt, ?dyn, ?module, 1, ?locs,
        nil::*of.DynLib, 0, nil::*u32, nil::*AtomPlan);
    if (!sel built.err)             { ret 1; }
    if (dyn.info.imports == nil)    { ret 1; }
    if (dyn.info.import_count != 0) { ret 1; }
    if (dyn.import_cap != 1)        { ret 1; }
    free_dynstate(?alloc, ?dyn);
    if (dyn.info.imports != nil || dyn.import_cap != 0) { ret 1; }

    map.dnit[intern.StrId, SymbolLoc](?locs);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.build_dynamic_info:implicit_platform_identity" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:   session.Session       = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_10054: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_10054.err) { ret 1; }
    val tr: res[target.Target, fail.Fail] =
        target.select(?reg, "aarch64", "darwin", "aapcs64");
    if (sel tr.err) { ret 1; }
    var tgt: target.Target = tr.ok;

    val platform: intern.StrId = lt_name(?s, "/usr/lib/libSystem.B.dylib");
    val other:    intern.StrId = lt_name(?s, "@rpath/libother.dylib");
    val symbol:   intern.StrId = lt_name(?s, "_platform_call");
    if (platform == intern.STR_NIL || other == intern.STR_NIL
        || symbol == intern.STR_NIL) { ret 1; }

    var locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);
    var explicit: [1]of.DynLib;
    explicit[0].name   = platform;
    explicit[0].soname = other;
    explicit[0].rpath  = intern.STR_NIL;
    var collision_dyn: DynState;
    init_dynstate(?collision_dyn);
    collision_dyn.info.pie = true;
    val collision: err[fail.Fail] =
        build_dynamic_info(?s, ?tgt, ?collision_dyn, nil::*of.ObjectImage, 0,
        ?locs, ?explicit[0], 1, nil::*u32, nil::*AtomPlan);
    if (!sel collision.err) { ret 1; }
    free_dynstate(?alloc, ?collision_dyn);

    var sym: of.Symbol;
    sym.name    = symbol;
    sym.section = of.external_section();
    sym.offset  = 0;
    sym.size    = 0;
    sym.flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN
        | of.SYM_OBJ_FLAG_FUNCTION;
    var module: of.ObjectImage =
        lt_image(?s, lt_name(?s, "platform-user"), nil::*of.Section, 0,
        ?sym, 1, nil::*of.Relocation, 0);
    val register_import_library_r: err[fail.Fail] = session.register_import_library(?s, symbol, platform);
    if (sel register_import_library_r.err) {
        ret 1;
    }
    var dyn: DynState;
    init_dynstate(?dyn);
    dyn.info.pie = true;
    val built: err[fail.Fail] =
        build_dynamic_info(?s, ?tgt, ?dyn, ?module, 1, ?locs,
        nil::*of.DynLib, 0, nil::*u32, nil::*AtomPlan);
    if (sel built.err) { ret 1; }
    if (dyn.info.lib_count != 1 || dyn.info.libs[0].name != platform
        || dyn.info.libs[0].soname != platform || dyn.info.import_count != 1
        || dyn.info.imports[0].lib_index != 0) { ret 1; }

    free_dynstate(?alloc, ?dyn);
    map.dnit[intern.StrId, SymbolLoc](?locs);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.dynstate_add_import_addr_fixup:preserves_addend" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:   session.Session = sr.ok;
    var dyn: DynState;
    init_dynstate(?dyn);

    val added: err[fail.Fail] = dynstate_add_import_addr_fixup(
        ?s, ?dyn, 2, 8, 3, 0x1234, of.RK_PC32, -4);
    if (sel added.err)                                        { ret 1; }
    if (dyn.info.import_addr_fixup_count != 1)                { ret 1; }
    if (dyn.info.import_addr_fixups[0].seg_index != 2)        { ret 1; }
    if (dyn.info.import_addr_fixups[0].seg_offset != 8)       { ret 1; }
    if (dyn.info.import_addr_fixups[0].import_index != 3)     { ret 1; }
    if (dyn.info.import_addr_fixups[0].patch_vaddr != 0x1234) { ret 1; }
    if (dyn.info.import_addr_fixups[0].kind != of.RK_PC32)    { ret 1; }
    if (dyn.info.import_addr_fixups[0].addend != -4)          { ret 1; }

    free_dynstate(?alloc, ?dyn);
    session.dnit(?s);
    ret 0;
}
