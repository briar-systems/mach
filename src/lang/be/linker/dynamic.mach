pub rec DynState {
    # the build's import pins and offered libraries
    linkage:               *linkage.Linkage;
    info:                  target_of.DynamicInfo;
    import_map:            map.Map[intern.StrId, u32];
    call_fixup_cap:        u32;
    lib_cap:               u32;
    import_cap:            u32;
    base_reloc_cap:        u32;
    import_addr_fixup_cap: u32;
    active:                bool;
    # where the reserved call-stub table and import GOT lie, which every later
    # relayout moves with the section they end
    stubs_at: table.At;
    got_at:   table.At;
}

pub fun init_dynstate(dyn: *DynState, l: *linkage.Linkage) {
    dyn.linkage                      = l;
    dyn.info.libs                    = nil;
    dyn.info.lib_count               = 0;
    dyn.info.imports                 = nil;
    dyn.info.import_count            = 0;
    dyn.info.interp                  = intern.STR_NIL;
    dyn.info.base_relocs             = nil;
    dyn.info.base_reloc_count        = 0;
    dyn.info.pie                     = false;
    dyn.info.call_fixups             = nil;
    dyn.info.call_fixup_count        = 0;
    dyn.info.import_addr_fixups      = nil;
    dyn.info.import_addr_fixup_count = 0;
    dyn.info.stubs.vaddr             = 0;
    dyn.info.stubs.size              = 0;
    dyn.stubs_at                     = table.At{};
    dyn.info.got.vaddr               = 0;
    dyn.info.got.size                = 0;
    dyn.got_at                       = table.At{};
    dyn.call_fixup_cap               = 0;
    dyn.lib_cap                      = 0;
    dyn.import_cap                   = 0;
    dyn.base_reloc_cap               = 0;
    dyn.import_addr_fixup_cap        = 0;
    dyn.active                       = false;
}

pub fun free_dynstate(alloc: *A.Allocator, dyn: *DynState) {
    if (dyn.info.libs != nil && dyn.lib_cap > 0) {
        A.deallocate[target_of.DynLib](alloc, dyn.info.libs, dyn.lib_cap::usize);
    }
    if (dyn.info.imports != nil && dyn.import_cap > 0) {
        A.deallocate[target_of.DynImport](alloc, dyn.info.imports, dyn.import_cap::usize);
    }
    if (dyn.info.call_fixups != nil && dyn.call_fixup_cap > 0) {
        A.deallocate[target_of.ImportFixup](alloc, dyn.info.call_fixups, dyn.call_fixup_cap::usize);
    }
    if (dyn.info.base_relocs != nil && dyn.base_reloc_cap > 0) {
        A.deallocate[target_of.BaseReloc](alloc, dyn.info.base_relocs, dyn.base_reloc_cap::usize);
    }
    if (dyn.info.import_addr_fixups != nil && dyn.import_addr_fixup_cap > 0) {
        A.deallocate[target_of.ImportFixup](alloc, dyn.info.import_addr_fixups,
            dyn.import_addr_fixup_cap::usize);
    }
    if (dyn.active) {
        map.dnit[intern.StrId, u32](?dyn.import_map);
    }
    init_dynstate(dyn, dyn.linkage);
}

# reserves the tables the format declares for the imports of a dynamic link,
# each where its shape places it and before anything is given an address: the
# call stubs, so a call site and its stub are never separated by the image's
# data however large it is, and the GOT the loader binds; place_import_tables
# reads their addresses back once the layout is final
pub fun reserve_import_tables(s: *session.Session, tgt: *lang_target.Binding, dyn: *DynState,
    merged: *MergedSection, groups: *SectionGroups) err[fail.Fail] {
    if (tgt.of == nil) { ret err[fail.Fail].ok{}; }
    val count: u32 = target_of.func_import_count(?dyn.info);
    if (tgt.of.stub_shape != nil && count > 0) {
        val shape_r: res[target_of.TableShape, fail.Fail] = tgt.of.stub_shape(tgt.object.arch_id, count);
        if (sel shape_r.err) { ret err[fail.Fail].err{shape_r.err}; }
        var shape: target_of.TableShape = shape_r.ok;
        if (shape.size == 0 || shape.align == 0) {
            ret err[fail.Fail].err{fail.message("the format declared an empty call-stub table")};
        }
        val at: res[table.At, fail.Fail] = table.reserve(s, merged, groups, ?shape, 0,
            "the call-stub table takes the code past the maximum section size");
        if (sel at.err) { ret err[fail.Fail].err{at.err}; }
        dyn.stubs_at        = at.ok;
        dyn.info.stubs.size = shape.size;
    }
    if (tgt.of.got_shape != nil) {
        val shape_r: res[target_of.TableShape, fail.Fail] = tgt.of.got_shape(tgt.object.arch_id, ?dyn.info);
        if (sel shape_r.err) { ret err[fail.Fail].err{shape_r.err}; }
        var shape: target_of.TableShape = shape_r.ok;
        if (shape.size == 0) { ret err[fail.Fail].ok{}; }
        if (shape.align == 0) {
            ret err[fail.Fail].err{fail.message("the format declared an unaligned import GOT")};
        }
        val at: res[table.At, fail.Fail] = table.reserve(s, merged, groups, ?shape, 0,
            "the import GOT takes the read-only data past the maximum section size");
        if (sel at.err) { ret err[fail.Fail].err{at.err}; }
        dyn.got_at        = at.ok;
        dyn.info.got.size = shape.size;
    }
    ret err[fail.Fail].ok{};
}

pub fun place_import_tables(dyn: *DynState, merged: *MergedSection) {
    if (dyn.info.stubs.size > 0) { dyn.info.stubs.vaddr = table.vaddr_of(dyn.stubs_at, merged); }
    if (dyn.info.got.size > 0)   { dyn.info.got.vaddr = table.vaddr_of(dyn.got_at, merged); }
}

# a GOT-kind relocation reaches the import under any of the names it is known by
fun import_got_referenced(modules: *target_of.ObjectImage, module_count: u32, local: intern.StrId,
    canonical: intern.StrId, effective: intern.StrId, sec_base: *u32, atoms: *AtomPlan) bool {
    ret has_got_reloc(modules, module_count, local, sec_base, atoms)
        || (!intern.str_same(canonical, local) && has_got_reloc(modules, module_count, canonical, sec_base, atoms))
        || (!intern.str_same(effective, local) && !intern.str_same(effective, canonical)
        && has_got_reloc(modules, module_count, effective, sec_base, atoms));
}

pub fun build_dynamic_info(s: *session.Session, tgt: *lang_target.Binding, dyn: *DynState,
    modules: *target_of.ObjectImage, module_count: u32,
    sym_locs: *map.Map[intern.StrId, SymbolLoc],
    dynlibs: *target_of.DynLib, dynlib_count: u32,
    sec_base: *u32, atoms: *AtomPlan) err[fail.Fail] {
    val alloc: *A.Allocator = s.alloc;

    dyn.info.interp = intern.STR_NIL;
    if (!str_empty(tgt.target.fs_policy.dynamic_interpreter)) {
        val dr: res[intern.StrId, A.Error] = intern.add(?s.interner, tgt.target.fs_policy.dynamic_interpreter);
        if (sel dr.err) { ret err[fail.Fail].err{fail.refused(dr.err)}; }
        dyn.info.interp = dr.ok;
    }

    var implicit:        u32          = 0;
    var implicit_soname: intern.StrId = intern.STR_NIL;
    if (dyn.info.pie && !str_empty(tgt.target.fs_policy.platform_lib)) {
        val pr: res[intern.StrId, A.Error] = intern.add(?s.interner, tgt.target.fs_policy.platform_lib);
        if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
        implicit_soname = pr.ok;
        implicit        = 1;
    }

    if (implicit == 1 && dynlib_soname_present(dynlibs, dynlib_count, implicit_soname)) {
        implicit = 0;
    }
    var implicit_lib: target_of.DynLib;
    var implicit_ptr: *target_of.DynLib = nil::*target_of.DynLib;
    if (implicit == 1) {
        implicit_lib.name   = implicit_soname;
        implicit_lib.soname = implicit_soname;
        implicit_lib.rpath  = intern.STR_NIL;
        implicit_ptr        = ?implicit_lib;
    }
    var collision_first:    intern.StrId = intern.STR_NIL;
    var collision_second:   intern.StrId = intern.STR_NIL;
    var collision_identity: intern.StrId = intern.STR_NIL;
    if (dynlib_identity_collision(dynlibs, dynlib_count, implicit_ptr,
        ?collision_first, ?collision_second,
        ?collision_identity)) {
        ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_LOADER_NAME_CONFLICT, dynlib_identity_conflict_message(
            s, collision_identity, collision_first, collision_second))};
    }

    # the library list in one pass: the explicit entries, the platform library,
    # then each library a live import names, every one once
    var i: u32 = 0;
    for (i < dynlib_count) {
        if (!dynlibs[i].include_referenced
            && !dynlib_soname_seen_before(dynlibs, i, dynlibs[i].soname)) {
            var lib: target_of.DynLib = dynlibs[i];
            if (intern.str_is_nil(lib.rpath)) {
                var j: u32 = i + 1;
                for (j < dynlib_count) {
                    if (intern.str_same(dynlibs[j].soname, dynlibs[i].soname)
                        && !intern.str_is_nil(dynlibs[j].rpath)) {
                        lib.rpath = dynlibs[j].rpath;
                        brk;
                    }
                    j = j + 1;
                }
            }
            val added: err[fail.Fail] = dynstate_add_lib(alloc, dyn, lib);
            if (sel added.err) { ret added; }
        }
        i = i + 1;
    }
    val explicit_libs: u32 = dyn.info.lib_count;
    if (implicit == 1) {
        val added: err[fail.Fail] = dynstate_add_lib(alloc, dyn, implicit_lib);
        if (sel added.err) { ret added; }
    }
    var dm: u32 = 0;
    for (dm < module_count) {
        var di: u32 = 0;
        for (di < modules[dm].import_count) {
            val decl:       *target_of.ImportDecl = ?modules[dm].imports[di];
            val unresolved: res[bool, fail.Fail]  = declared_import_unresolved(decl, sym_locs);
            if (sel unresolved.err) { ret err[fail.Fail].err{unresolved.err}; }
            if (!unresolved.ok
                || !declared_import_referenced(s, modules, module_count, decl.symbol,
                tgt.of.import_address_prefix, sec_base, atoms)) {
                di = di + 1;
                cnt;
            }
            val lib: intern.StrId = decl.library;
            if (!dynlib_name_present(dynlibs, dynlib_count, implicit_ptr, lib)
                && !emitted_lib_present(dyn.info.libs, dyn.info.lib_count, lib)) {
                var entry: target_of.DynLib = target_of.DynLib{};
                entry.name   = lib;
                entry.soname = lib;
                entry.rpath  = intern.STR_NIL;
                val added: err[fail.Fail] = dynstate_add_lib(alloc, dyn, entry);
                if (sel added.err) { ret added; }
            }
            di = di + 1;
        }
        dm = dm + 1;
    }
    var atm: u32 = 0;
    for (atm < module_count) {
        var atsy: u32 = 0;
        for (atsy < modules[atm].symbol_count) {
            val cand_r: res[opt[target_of.DynLib], fail.Fail] = attributed_import_candidate(
                dyn.linkage, s, modules, module_count, atm, atsy, tgt.of.import_address_prefix,
                dynlibs, dynlib_count, implicit_ptr, sym_locs, sec_base, atoms);
            if (sel cand_r.err) { ret err[fail.Fail].err{cand_r.err}; }
            val cand: opt[target_of.DynLib] = cand_r.ok;
            if (sel cand.some) {
                var entry: target_of.DynLib = cand.some;
                if (!emitted_lib_present(dyn.info.libs, dyn.info.lib_count, entry.soname)) {
                    entry.include_referenced = false;
                    val added: err[fail.Fail] = dynstate_add_lib(alloc, dyn, entry);
                    if (sel added.err) { ret added; }
                }
            }
            atsy = atsy + 1;
        }
        atm = atm + 1;
    }

    var am: u32 = 0;
    for (am < module_count) {
        var ai: u32 = 0;
        for (ai < modules[am].import_count) {
            val d:          *target_of.ImportDecl = ?modules[am].imports[ai];
            val unresolved: res[bool, fail.Fail]  = declared_import_unresolved(d, sym_locs);
            if (sel unresolved.err) { ret err[fail.Fail].err{unresolved.err}; }
            if (!unresolved.ok) {
                ai = ai + 1;
                cnt;
            }
            val prev: intern.StrId = linkage.import_library(dyn.linkage, d.symbol);
            if (!intern.str_is_nil(prev)) {
                val loader_key: intern.StrId = loader_named_key(dynlibs, dynlib_count, prev);
                if (!intern.str_is_nil(loader_key)) {
                    ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_IMPORT_LIBRARY, loader_attribution_message(
                        s, d.symbol, prev, loader_key))};
                }
                val provider: opt[linkage.Provider] = linkage.provider(dyn.linkage, prev);
                var archived: bool                  = false;
                if (sel provider.some) { archived = provider.some.is_static; }
                if (!archived && intern.str_same(prev, d.library)) {
                    ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_IMPORT_LIBRARY, declared_loader_attribution_message(
                        s, d.symbol, prev))};
                }
                if (!archived && !declared_attribution_matches(dynlibs, dynlib_count, implicit_ptr,
                    prev, d.library)) {
                    ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_SYMBOL_CLAIM_CONFLICT, declared_conflict_message(
                        s, d.symbol, prev, d.library))};
                }
            }
            ai = ai + 1;
        }
        am = am + 1;
    }

    dyn.import_map = map.init[intern.StrId, u32](alloc);
    dyn.active     = true;

    var seen: map.Map[intern.StrId, u32] =
        map.init[intern.StrId, u32](alloc);
    fin { map.dnit[intern.StrId, u32](?seen); }
    var n_imports: u32 = 0;
    var m:         u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *target_of.Symbol = ?modules[m].symbols[sy];
            if (!is_undefined_extern(sym)) {
                sy = sy + 1;
                cnt;
            }
            val rr: res[intern.StrId, fail.Fail] = resolved_symbol_name(sym_locs, sym.name);
            if (sel rr.err) {
                ret err[fail.Fail].err{rr.err};
            }
            val effective: intern.StrId    = rr.ok;
            val get_r:     opt[*SymbolLoc] = map.get[intern.StrId, SymbolLoc](sym_locs, ?effective);
            if (sel get_r.some) {
                sy = sy + 1;
                cnt;
            }
            if (!import_needed(modules, module_count, sym, sec_base, atoms)) {
                sy = sy + 1;
                cnt;
            }
            val cn_r: res[ImportName, fail.Fail] =
                canonical_import_name(s, tgt.of.import_address_prefix, effective);
            if (sel cn_r.err) {
                ret err[fail.Fail].err{cn_r.err};
            }
            val cn:     ImportName = cn_r.ok;
            val get_r2: opt[*u32]  = map.get[intern.StrId, u32](?seen, ?cn.canonical);
            if (sel get_r2.some) {
                sy = sy + 1;
                cnt;
            }
            val ins: res[bool, A.Error] =
                map.insert[intern.StrId, u32](?seen, cn.canonical, n_imports);
            if (sel ins.err) {
                ret err[fail.Fail].err{fail.refused(ins.err)};
            }
            n_imports = n_imports + 1;
            sy        = sy + 1;
        }
        m = m + 1;
    }

    if (n_imports == 0) { ret err[fail.Fail].ok{}; }

    val ir: res[*target_of.DynImport, A.Error] = A.zallocate[target_of.DynImport](alloc, n_imports::usize);
    if (sel ir.err) { ret err[fail.Fail].err{fail.refused(ir.err)}; }
    dyn.info.imports = ir.ok;
    dyn.import_cap   = n_imports;

    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *target_of.Symbol = ?modules[m].symbols[sy];
            if (!is_undefined_extern(sym)) {
                sy = sy + 1;
                cnt;
            }
            val rr: res[intern.StrId, fail.Fail] = resolved_symbol_name(sym_locs, sym.name);
            if (sel rr.err) {
                ret err[fail.Fail].err{rr.err};
            }
            val effective: intern.StrId    = rr.ok;
            val get_r3:    opt[*SymbolLoc] = map.get[intern.StrId, SymbolLoc](sym_locs, ?effective);
            if (sel get_r3.some) {
                sy = sy + 1;
                cnt;
            }
            if (!import_needed(modules, module_count, sym, sec_base, atoms)) {
                sy = sy + 1;
                cnt;
            }

            val cn_r: res[ImportName, fail.Fail] =
                canonical_import_name(s, tgt.of.import_address_prefix, effective);
            if (sel cn_r.err) {
                ret err[fail.Fail].err{cn_r.err};
            }
            val cn:       ImportName = cn_r.ok;
            val existing: opt[*u32]  =
                map.get[intern.StrId, u32](?dyn.import_map, ?cn.canonical);
            if (sel existing.some) {
                val existing_idx: u32       = @existing.some;
                val get_r4:       opt[*u32] = map.get[intern.StrId, u32](?dyn.import_map, ?sym.name);
                if (sel get_r4.none) {
                    val alias_r: res[bool, A.Error] =
                        map.insert[intern.StrId, u32](?dyn.import_map, sym.name, existing_idx);
                    if (sel alias_r.err) {
                        ret err[fail.Fail].err{fail.refused(alias_r.err)};
                    }
                }
                val get_r5: opt[*u32] = map.get[intern.StrId, u32](?dyn.import_map, ?effective);
                if (sel get_r5.none) {
                    val effective_r: res[bool, A.Error] =
                        map.insert[intern.StrId, u32](?dyn.import_map, effective, existing_idx);
                    if (sel effective_r.err) {
                        ret err[fail.Fail].err{fail.refused(effective_r.err)};
                    }
                }
                if (!cn.indirect
                    && (((sym.flags & target_of.SYM_OBJ_FLAG_FUNCTION) != 0)
                    || has_function_branch_reloc(modules, module_count, cn.canonical,
                    sec_base, atoms)
                    || has_function_branch_reloc(modules, module_count, effective,
                    sec_base, atoms))) {
                    dyn.info.imports[existing_idx].is_func = true;
                }
                if (import_got_referenced(modules, module_count, sym.name, cn.canonical,
                    effective, sec_base, atoms)) {
                    dyn.info.imports[existing_idx].got_ref = true;
                }
                sy = sy + 1;
                cnt;
            }

            val idx: u32 = dyn.info.import_count;
            dyn.info.imports[idx].symbol = cn.canonical;
            val decl_r: res[*target_of.ImportDecl, fail.Fail] =
                declared_import_for(modules, module_count, cn.canonical, sym_locs);
            if (sel decl_r.err) { ret err[fail.Fail].err{decl_r.err}; }
            val decl:    *target_of.ImportDecl = decl_r.ok;
            var lib_opt: intern.StrId          = linkage.import_library(dyn.linkage, cn.canonical);
            if (decl != nil) { lib_opt = decl.library; }
            if (!intern.str_is_nil(lib_opt)) {
                val want:   intern.StrId = lib_opt;
                var li_opt: opt[u32]     = opt[u32].none{};
                if (decl != nil) {
                    li_opt = dynlib_index_of(dynlibs, dynlib_count, implicit_ptr, want);
                }
                or {
                    val loader_key: intern.StrId = loader_named_key(dynlibs, dynlib_count, want);
                    if (!intern.str_is_nil(loader_key)) {
                        ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_IMPORT_LIBRARY, loader_attribution_message(
                            s, cn.canonical, want, loader_key))};
                    }
                    li_opt = dynlib_key_index(dynlibs, dynlib_count, implicit_ptr, want);
                }
                val li_opt_none: bool = sel li_opt.none;
                if (li_opt_none) {
                    li_opt = emitted_lib_index(dyn.info.libs, explicit_libs + implicit,
                        dyn.info.lib_count, want);
                }
                if (!sel li_opt.some) {
                    ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_UNDEFINED_SYMBOL, pinned_attribution_message(dyn.linkage, s, cn.canonical, want))};
                }
                dyn.info.imports[idx].lib_index = li_opt.some;
            }
            or (tgt.of.two_level_namespace) {
                ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_IMPORT_UNATTRIBUTED, unattributed_import_message(
                    s, cn.canonical, tgt.os.c_symbol_prefix, dynlibs, dynlib_count))};
            }
            or {
                dyn.info.imports[idx].lib_index = target_of.DYNLIB_ANY;
            }
            dyn.info.imports[idx].is_func = !cn.indirect
                && (((sym.flags & target_of.SYM_OBJ_FLAG_FUNCTION) != 0)
                || has_function_branch_reloc(modules, module_count, cn.canonical,
                sec_base, atoms)
                || has_function_branch_reloc(modules, module_count, effective,
                sec_base, atoms));
            dyn.info.imports[idx].got_ref = import_got_referenced(modules, module_count,
                sym.name, cn.canonical, effective, sec_base, atoms);
            dyn.info.imports[idx].ordinal    = 0;
            dyn.info.imports[idx].by_ordinal = false;
            if (decl != nil) {
                dyn.info.imports[idx].symbol     = decl.import_name;
                dyn.info.imports[idx].ordinal    = decl.ordinal;
                dyn.info.imports[idx].by_ordinal = !decl.by_name;
            }
            if (!str_empty(tgt.of.import_address_prefix)
                && is_import_address_alias(s, dyn.info.imports[idx].symbol,
                tgt.of.import_address_prefix)) {
                ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_IMPORT_ALIAS, import_alias_message(
                    s, dyn.info.imports[idx].symbol, tgt.of.import_address_prefix))};
            }
            val ins: res[bool, A.Error] =
                map.insert[intern.StrId, u32](?dyn.import_map, cn.canonical, idx);
            if (sel ins.err) {
                ret err[fail.Fail].err{fail.refused(ins.err)};
            }
            if (!intern.str_same(sym.name, cn.canonical)) {
                val alias_r: res[bool, A.Error] =
                    map.insert[intern.StrId, u32](?dyn.import_map, sym.name, idx);
                if (sel alias_r.err) {
                    ret err[fail.Fail].err{fail.refused(alias_r.err)};
                }
            }
            if (!intern.str_same(effective, cn.canonical) && !intern.str_same(effective, sym.name)) {
                val effective_r: res[bool, A.Error] =
                    map.insert[intern.StrId, u32](?dyn.import_map, effective, idx);
                if (sel effective_r.err) {
                    ret err[fail.Fail].err{fail.refused(effective_r.err)};
                }
            }
            dyn.info.import_count = idx + 1;

            sy = sy + 1;
        }
        m = m + 1;
    }
    ret err[fail.Fail].ok{};
}

# the emitted index of the library a declared import names by its loader name
# or by an entry's key
fun dynlib_index_of(dynlibs: *target_of.DynLib, dynlib_count: u32,
    implicit: *target_of.DynLib, lib: intern.StrId) opt[u32] {
    var i: u32 = 0;
    for (i < dynlib_count) {
        if (!dynlibs[i].include_referenced
            && (intern.str_same(dynlibs[i].name, lib) || intern.str_same(dynlibs[i].soname, lib))) {
            ret dynlib_slot(dynlibs, dynlib_count, i);
        }
        i = i + 1;
    }
    if (implicit != nil && (intern.str_same(implicit.name, lib) || intern.str_same(implicit.soname, lib))) {
        ret opt[u32].some{unique_dynlib_count(dynlibs, dynlib_count)};
    }
    ret opt[u32].none{};
}

# the emitted index of the library an attribution names, which binds only by key
fun dynlib_key_index(dynlibs: *target_of.DynLib, dynlib_count: u32,
    implicit: *target_of.DynLib, key: intern.StrId) opt[u32] {
    var i: u32 = 0;
    for (i < dynlib_count) {
        if (!dynlibs[i].include_referenced && intern.str_same(dynlibs[i].name, key)) {
            ret dynlib_slot(dynlibs, dynlib_count, i);
        }
        i = i + 1;
    }
    if (implicit != nil && intern.str_same(implicit.name, key)) {
        ret opt[u32].some{unique_dynlib_count(dynlibs, dynlib_count)};
    }
    ret opt[u32].none{};
}

# the emitted index of `dynlibs[i]`, counting each loader name once
fun dynlib_slot(dynlibs: *target_of.DynLib, dynlib_count: u32, i: u32) opt[u32] {
    var index: u32 = 0;
    var j:     u32 = 0;
    for (j < dynlib_count) {
        if (!dynlibs[j].include_referenced
            && !dynlib_soname_seen_before(dynlibs, j, dynlibs[j].soname)) {
            if (intern.str_same(dynlibs[j].soname, dynlibs[i].soname)) {
                ret opt[u32].some{index};
            }
            index = index + 1;
        }
        j = j + 1;
    }
    ret opt[u32].none{};
}

# the key of the entry whose loader name an attribution spells instead of a
# key, STR_NIL when it spells none or a key also answers to it
fun loader_named_key(dynlibs: *target_of.DynLib, dynlib_count: u32,
    attributed: intern.StrId) intern.StrId {
    var i: u32 = 0;
    for (i < dynlib_count) {
        if (intern.str_same(dynlibs[i].name, attributed)) { ret intern.STR_NIL; }
        i = i + 1;
    }
    i = 0;
    for (i < dynlib_count) {
        if (intern.str_same(dynlibs[i].soname, attributed)) { ret dynlibs[i].name; }
        i = i + 1;
    }
    ret intern.STR_NIL;
}

fun loader_attribution_message(s: *session.Session, sym: intern.StrId,
    attributed: intern.StrId, key: intern.StrId) res[str, fail.Fail] {
    ret fail.format_intern(?s.interner, s.alloc,
        "import '{}' is attributed to '{}', the loader name of link entry '{}'; #[library] names a link entry by its table key, so write #[library(\"{}\")]",
        intern.text(?s.interner, sym), intern.text(?s.interner, attributed),
        intern.text(?s.interner, key), intern.text(?s.interner, key));
}

fun declared_loader_attribution_message(s: *session.Session, sym: intern.StrId,
    attributed: intern.StrId) res[str, fail.Fail] {
    ret fail.format_intern(?s.interner, s.alloc,
        "import '{}' is attributed to '{}', the loader name an import library declares it in; #[library] names a link entry by its table key, so name the entry that links the import library",
        intern.text(?s.interner, sym), intern.text(?s.interner, attributed));
}

fun dynlib_identity_pair(a: *target_of.DynLib, b: *target_of.DynLib,
    identity: *intern.StrId) bool {
    if (intern.str_same(a.soname, b.soname)) { ret false; }
    if (intern.str_same(a.name, b.name) || intern.str_same(a.name, b.soname)) {
        @identity = a.name;
        ret true;
    }
    if (intern.str_same(a.soname, b.name)) {
        @identity = a.soname;
        ret true;
    }
    ret false;
}

fun dynlib_identity_collision(dynlibs: *target_of.DynLib, count: u32,
    implicit: *target_of.DynLib,
    first: *intern.StrId, second: *intern.StrId,
    identity: *intern.StrId) bool {
    var i: u32 = 0;
    for (i < count) {
        var j: u32 = i + 1;
        for (j < count) {
            if (dynlib_identity_pair(?dynlibs[i], ?dynlibs[j], identity)) {
                @first  = dynlibs[i].soname;
                @second = dynlibs[j].soname;
                ret true;
            }
            j = j + 1;
        }
        if (implicit != nil && dynlib_identity_pair(?dynlibs[i], implicit, identity)) {
            @first  = dynlibs[i].soname;
            @second = implicit.soname;
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun dynlib_identity_conflict_message(s: *session.Session, identity: intern.StrId,
    first: intern.StrId, second: intern.StrId) res[str, fail.Fail] {
    if (intern.str_is_nil(identity) || intern.str_is_nil(first) || intern.str_is_nil(second)) {
        ret res[str, fail.Fail].ok{"one link library identity names multiple loader dependencies"};
    }
    ret fail.format_intern(?s.interner, s.alloc, "link library identity '{}' names both loader dependencies '{}' and '{}'",
        intern.text(?s.interner, identity), intern.text(?s.interner, first), intern.text(?s.interner, second));
}

fun dynlib_soname_seen_before(dynlibs: *target_of.DynLib, end: u32,
    soname: intern.StrId) bool {
    var i: u32 = 0;
    for (i < end) {
        if (!dynlibs[i].include_referenced && intern.str_same(dynlibs[i].soname, soname)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun dynlib_soname_present(dynlibs: *target_of.DynLib, count: u32,
    soname: intern.StrId) bool {
    var i: u32 = 0;
    for (i < count) {
        if (intern.str_same(dynlibs[i].soname, soname)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun symbol_strongly_resolved(sym_locs: *map.Map[intern.StrId, SymbolLoc],
    name: intern.StrId) res[bool, fail.Fail] {
    val rr: res[intern.StrId, fail.Fail] = resolved_symbol_name(sym_locs, name);
    if (sel rr.err) { ret res[bool, fail.Fail].err{rr.err}; }
    val effective: intern.StrId    = rr.ok;
    val lr:        opt[*SymbolLoc] =
        map.get[intern.StrId, SymbolLoc](sym_locs, ?effective);
    if (sel lr.none) { ret res[bool, fail.Fail].ok{false}; }
    ret res[bool, fail.Fail].ok{!lr.some.weak};
}

fun declared_import_unresolved(d: *target_of.ImportDecl,
    sym_locs: *map.Map[intern.StrId, SymbolLoc]) res[bool, fail.Fail] {
    val strong: res[bool, fail.Fail] = symbol_strongly_resolved(sym_locs, d.symbol);
    if (sel strong.err) { ret strong; }
    ret res[bool, fail.Fail].ok{!strong.ok};
}

# whether a declared import the image still references resolves nowhere in it
pub fun has_unresolved_declared_imports(
    modules: *target_of.ObjectImage, module_count: u32,
    sym_locs: *map.Map[intern.StrId, SymbolLoc],
    sec_base: *u32, atoms: *AtomPlan) res[bool, fail.Fail] {
    var m: u32 = 0;
    for (m < module_count) {
        var i: u32 = 0;
        for (i < modules[m].import_count) {
            val unresolved: res[bool, fail.Fail] = declared_import_unresolved(?modules[m].imports[i], sym_locs);
            if (sel unresolved.err) { ret unresolved; }
            if (unresolved.ok
                && import_symbol_live(modules, module_count, modules[m].imports[i].symbol, sec_base, atoms)) {
                ret res[bool, fail.Fail].ok{true};
            }
            i = i + 1;
        }
        m = m + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

fun declared_import_for(modules: *target_of.ObjectImage, module_count: u32,
    symbol: intern.StrId,
    sym_locs: *map.Map[intern.StrId, SymbolLoc]) res[*target_of.ImportDecl, fail.Fail] {
    var m: u32 = 0;
    for (m < module_count) {
        var i: u32 = 0;
        for (i < modules[m].import_count) {
            if (intern.str_same(modules[m].imports[i].symbol, symbol)) {
                val unresolved: res[bool, fail.Fail] = declared_import_unresolved(?modules[m].imports[i], sym_locs);
                if (sel unresolved.err) { ret res[*target_of.ImportDecl, fail.Fail].err{unresolved.err}; }
                if (unresolved.ok)      { ret res[*target_of.ImportDecl, fail.Fail].ok{?modules[m].imports[i]}; }
            }
            i = i + 1;
        }
        m = m + 1;
    }
    ret res[*target_of.ImportDecl, fail.Fail].ok{nil};
}

# whether the entry an attribution names by key loads as the library an import
# library declares the symbol in
fun declared_attribution_matches(dynlibs: *target_of.DynLib, count: u32,
    implicit: *target_of.DynLib,
    attributed: intern.StrId, loader: intern.StrId) bool {
    var i: u32 = 0;
    for (i < count) {
        if (intern.str_same(dynlibs[i].name, attributed) && intern.str_same(dynlibs[i].soname, loader)) { ret true; }
        i = i + 1;
    }
    ret implicit != nil && intern.str_same(implicit.name, attributed) && intern.str_same(implicit.soname, loader);
}

# whether an entry answers to `key`, ignoring one included only when referenced
fun dynlib_key_present(dynlibs: *target_of.DynLib, count: u32,
    implicit: *target_of.DynLib, key: intern.StrId) bool {
    var i: u32 = 0;
    for (i < count) {
        if (!dynlibs[i].include_referenced && intern.str_same(dynlibs[i].name, key)) { ret true; }
        i = i + 1;
    }
    ret implicit != nil && intern.str_same(implicit.name, key);
}

fun dynlib_name_present(dynlibs: *target_of.DynLib, count: u32,
    implicit: *target_of.DynLib, name: intern.StrId) bool {
    var i: u32 = 0;
    for (i < count) {
        if (!dynlibs[i].include_referenced
            && (intern.str_same(dynlibs[i].name, name) || intern.str_same(dynlibs[i].soname, name))) { ret true; }
        i = i + 1;
    }
    if (implicit != nil && (intern.str_same(implicit.name, name) || intern.str_same(implicit.soname, name))) { ret true; }
    ret false;
}

fun find_referenced_dynlib(dynlibs: *target_of.DynLib, count: u32, name: intern.StrId) opt[target_of.DynLib] {
    var i: u32 = 0;
    for (i < count) {
        if (dynlibs[i].include_referenced && intern.str_same(dynlibs[i].name, name)) {
            ret opt[target_of.DynLib].some{dynlibs[i]};
        }
        i = i + 1;
    }
    ret opt[target_of.DynLib].none{};
}

fun emitted_lib_present(libs: *target_of.DynLib, count: u32, name: intern.StrId) bool {
    var i: u32 = 0;
    for (i < count) {
        if (intern.str_same(libs[i].soname, name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun emitted_lib_index(libs: *target_of.DynLib, start: u32, count: u32,
    name: intern.StrId) opt[u32] {
    if (libs == nil) { ret opt[u32].none{}; }
    var i: u32 = start;
    for (i < count) {
        if (intern.str_same(libs[i].name, name) || intern.str_same(libs[i].soname, name)) { ret opt[u32].some{i}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

fun attributed_import_candidate(l: *linkage.Linkage, s: *session.Session, modules: *target_of.ObjectImage, module_count: u32,
    m: u32, sy: u32, prefix: str,
    dynlibs: *target_of.DynLib, dynlib_count: u32, implicit: *target_of.DynLib,
    sym_locs: *map.Map[intern.StrId, SymbolLoc],
    sec_base: *u32, atoms: *AtomPlan) res[opt[target_of.DynLib], fail.Fail] {
    val none: opt[target_of.DynLib] = opt[target_of.DynLib].none{};
    val sym:  *target_of.Symbol     = ?modules[m].symbols[sy];
    if (!is_undefined_extern(sym)) { ret res[opt[target_of.DynLib], fail.Fail].ok{none}; }
    val rr: res[intern.StrId, fail.Fail] = resolved_symbol_name(sym_locs, sym.name);
    if (sel rr.err) {
        ret res[opt[target_of.DynLib], fail.Fail].err{rr.err};
    }
    val effective: intern.StrId    = rr.ok;
    val get_r:     opt[*SymbolLoc] = map.get[intern.StrId, SymbolLoc](sym_locs, ?effective);
    if (sel get_r.some) {
        ret res[opt[target_of.DynLib], fail.Fail].ok{none};
    }
    val cn_r: res[ImportName, fail.Fail] = canonical_import_name(s, prefix, effective);
    if (sel cn_r.err) {
        ret res[opt[target_of.DynLib], fail.Fail].err{cn_r.err};
    }
    val canonical: intern.StrId                          = cn_r.ok.canonical;
    val decl:      res[*target_of.ImportDecl, fail.Fail] = declared_import_for(modules, module_count, canonical, sym_locs);
    if (sel decl.err) { ret res[opt[target_of.DynLib], fail.Fail].err{decl.err}; }
    if (decl.ok != nil) {
        ret res[opt[target_of.DynLib], fail.Fail].ok{none};
    }
    val lib_opt: intern.StrId = linkage.import_library(l, canonical);
    if (intern.str_is_nil(lib_opt)) {
        ret res[opt[target_of.DynLib], fail.Fail].ok{none};
    }
    val lib: intern.StrId = lib_opt;
    if (dynlib_key_present(dynlibs, dynlib_count, implicit, lib)) {
        ret res[opt[target_of.DynLib], fail.Fail].ok{none};
    }
    val provider: opt[linkage.Provider] = linkage.provider(l, lib);
    if (sel provider.some
        && provider.some.is_static) {
        ret res[opt[target_of.DynLib], fail.Fail].ok{none};
    }
    val referenced_entry: opt[target_of.DynLib] = find_referenced_dynlib(dynlibs, dynlib_count, lib);
    if (!sel referenced_entry.some) {
        ret res[opt[target_of.DynLib], fail.Fail].ok{none};
    }
    if (!declared_import_referenced(s, modules, module_count, canonical, prefix, sec_base, atoms)) {
        ret res[opt[target_of.DynLib], fail.Fail].ok{none};
    }
    ret res[opt[target_of.DynLib], fail.Fail].ok{referenced_entry};
}

pub fun has_unresolved_attributed_imports(l: *linkage.Linkage, s: *session.Session, modules: *target_of.ObjectImage,
    module_count: u32, dynlibs: *target_of.DynLib, dynlib_count: u32,
    sym_locs: *map.Map[intern.StrId, SymbolLoc], prefix: str,
    sec_base: *u32, atoms: *AtomPlan) res[bool, fail.Fail] {
    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val cand_r: res[opt[target_of.DynLib], fail.Fail] = attributed_import_candidate(
                l, s, modules, module_count, m, sy, prefix, dynlibs, dynlib_count, nil::*target_of.DynLib,
                sym_locs, sec_base, atoms);
            if (sel cand_r.err) {
                ret res[bool, fail.Fail].err{cand_r.err};
            }
            val cand: opt[target_of.DynLib] = cand_r.ok;
            if (sel cand.some) {
                ret res[bool, fail.Fail].ok{true};
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

fun declared_conflict_message(s: *session.Session, sym: intern.StrId,
    had: intern.StrId, decl: intern.StrId) res[str, fail.Fail] {
    if (intern.str_is_nil(sym) || intern.str_is_nil(had) || intern.str_is_nil(decl)) {
        ret res[str, fail.Fail].ok{"an import library contradicts an existing library attribution"};
    }
    ret fail.format_intern(?s.interner, s.alloc, "import '{}' is attributed to library '{}' but an import library declares it in '{}'",
        intern.text(?s.interner, sym), intern.text(?s.interner, had), intern.text(?s.interner, decl));
}

fun unique_dynlib_count(dynlibs: *target_of.DynLib, count: u32) u32 {
    var unique: u32 = 0;
    var i:      u32 = 0;
    for (i < count) {
        if (!dynlibs[i].include_referenced
            && !dynlib_soname_seen_before(dynlibs, i, dynlibs[i].soname)) {
            unique = unique + 1;
        }
        i = i + 1;
    }
    ret unique;
}

pub rec ImportName {
    canonical: intern.StrId;
    indirect:  bool;
}

pub fun canonical_import_name(s: *session.Session, prefix: str,
    name: intern.StrId) res[ImportName, fail.Fail] {
    var out: ImportName;
    out.canonical = name;
    out.indirect  = false;
    if (str_empty(prefix)) { ret res[ImportName, fail.Fail].ok{out}; }

    val text_o: opt[str] = intern.get(?s.interner, name);
    if (sel text_o.none) { ret res[ImportName, fail.Fail].ok{out}; }
    val text:       str   = text_o.some;
    val prefix_len: usize = str_len(prefix);
    if (!str_starts_with(text, prefix) || str_len(text) <= prefix_len) {
        ret res[ImportName, fail.Fail].ok{out};
    }

    val cr: res[intern.StrId, A.Error] = intern.add(?s.interner, (text::usize + prefix_len)::str);
    if (sel cr.err) {
        ret res[ImportName, fail.Fail].err{fail.refused(cr.err)};
    }
    out.canonical = cr.ok;
    out.indirect  = true;
    ret res[ImportName, fail.Fail].ok{out};
}

# an undefined symbol imports when a live relocation names it, or nothing
# relocates it at all; a COFF weak external only when referenced, since
# unreferenced its fallback stands for it and the fallback went unreached
fun import_needed(modules: *target_of.ObjectImage, module_count: u32, sym: *target_of.Symbol,
    sec_base: *u32, atoms: *AtomPlan) bool {
    if ((sym.flags & target_of.SYM_OBJ_FLAG_FALLBACK) != 0) {
        ret symbol_reference_live(modules, module_count, sym.name, sec_base, atoms);
    }
    ret import_symbol_live(modules, module_count, sym.name, sec_base, atoms);
}

fun local_import_candidate(s: *session.Session, prefix: str, sym: *target_of.Symbol,
    strong: *map.Map[intern.StrId, u32],
    defined: *map.Map[intern.StrId, u32]) res[ImportName, fail.Fail] {
    var none: ImportName;
    none.canonical = sym.name;
    none.indirect  = false;
    if (!is_undefined_extern(sym)
        || (sym.flags & target_of.SYM_OBJ_FLAG_FALLBACK) != 0) {
        ret res[ImportName, fail.Fail].ok{none};
    }

    val cn_r: res[ImportName, fail.Fail] =
        canonical_import_name(s, prefix, sym.name);
    if (sel cn_r.err) {
        ret res[ImportName, fail.Fail].err{cn_r.err};
    }
    val cn: ImportName = cn_r.ok;
    if (!cn.indirect
        || !map.contains[intern.StrId, u32](strong, ?cn.canonical)
        || map.contains[intern.StrId, u32](defined, ?sym.name)) {
        ret res[ImportName, fail.Fail].ok{none};
    }
    ret res[ImportName, fail.Fail].ok{cn};
}

fun local_import_storage_size(count: u32) res[u32, fail.Fail] {
    if (count > 0x1FFFFFFF) {
        ret res[u32, fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "local import pointer section exceeds 32 bits")};
    }
    ret res[u32, fail.Fail].ok{count * 8};
}

fun local_import_referenced(modules: *target_of.ObjectImage, module_count: u32,
    alias: intern.StrId, sec_base: *u32,
    atoms: *AtomPlan) bool {
    var m: u32 = 0;
    for (m < module_count) {
        var ri: u32 = 0;
        for (ri < modules[m].reloc_count) {
            val r: *target_of.Relocation = ?modules[m].relocations[ri];
            if (r.sym < modules[m].symbol_count) {
                val target: *target_of.Symbol = ?modules[m].symbols[r.sym];
                if (intern.str_same(target.name, alias) && is_undefined_extern(target)
                    && (target.flags & target_of.SYM_OBJ_FLAG_FALLBACK) == 0
                    && reloc_source_live(modules, m, r, sec_base, atoms)) {
                    ret true;
                }
            }
            ri = ri + 1;
        }
        m = m + 1;
    }
    ret false;
}

fun relocation_target_is_alias_of(s: *session.Session, target: *target_of.Symbol,
    prefix: str, canonical_text: str) bool {
    if (str_empty(prefix)) { ret false; }
    val target_text_o: opt[str] = intern.get(?s.interner, target.name);
    if (sel target_text_o.none) { ret false; }
    val target_text: str   = target_text_o.some;
    val prefix_len:  usize = str_len(prefix);
    if (!str_starts_with(target_text, prefix) || str_len(target_text) <= prefix_len) {
        ret false;
    }
    ret str_equals((target_text::usize + prefix_len)::str, canonical_text);
}

fun declared_import_referenced(s: *session.Session, modules: *target_of.ObjectImage,
    module_count: u32, symbol: intern.StrId,
    prefix: str, sec_base: *u32,
    atoms: *AtomPlan) bool {
    if (local_import_referenced(modules, module_count, symbol, sec_base, atoms)) {
        ret true;
    }
    if (str_empty(prefix)) { ret false; }
    val symbol_text_o: opt[str] = intern.get(?s.interner, symbol);
    if (sel symbol_text_o.none) { ret false; }
    val symbol_text: str = symbol_text_o.some;
    var m:           u32 = 0;
    for (m < module_count) {
        var ri: u32 = 0;
        for (ri < modules[m].reloc_count) {
            val r: *target_of.Relocation = ?modules[m].relocations[ri];
            if (r.sym < modules[m].symbol_count) {
                val target: *target_of.Symbol = ?modules[m].symbols[r.sym];
                if (is_undefined_extern(target)
                    && (target.flags & target_of.SYM_OBJ_FLAG_FALLBACK) == 0
                    && relocation_target_is_alias_of(s, target, prefix, symbol_text)
                    && reloc_source_live(modules, m, r, sec_base, atoms)) {
                    ret true;
                }
            }
            ri = ri + 1;
        }
        m = m + 1;
    }
    ret false;
}

# the pointer cells a COFF link synthesizes for the `__imp_` aliases its own
# definitions answer, so an import-address reference to a local definition
# reads its address, declined where the format names no import-address prefix
pub fun synthesize_local_imports(ctx: *LinkContext, inputs: *InputSet, out: *target_of.ObjectImage) res[bool, fail.Fail] {
    val prefix: str = ctx.tgt.of.import_address_prefix;
    if (!local_imports_apply(prefix, ctx.mode, inputs.images, inputs.count)) { ret res[bool, fail.Fail].ok{false}; }
    val atoms_r: res[*InputAtoms, fail.Fail] = context_atoms(ctx, inputs);
    if (sel atoms_r.err) { ret res[bool, fail.Fail].err{atoms_r.err}; }
    ret local_import_pointers(ctx.s, prefix, inputs.images, inputs.count, ctx.mode,
        atoms_r.ok.sec_base, ?atoms_r.ok.plan, out);
}

fun local_imports_apply(prefix: str, mode: catalog_artifact.Kind, modules: *target_of.ObjectImage, module_count: u32) bool {
    ret !str_empty(prefix) && mode != catalog_artifact.OBJECTS && modules != nil && module_count > 0;
}

fun local_import_pointers(s: *session.Session, prefix: str,
    modules: *target_of.ObjectImage, module_count: u32,
    mode: catalog_artifact.Kind, sec_base: *u32, atoms: *AtomPlan,
    out: *target_of.ObjectImage) res[bool, fail.Fail] {
    if (!local_imports_apply(prefix, mode, modules, module_count)) { ret res[bool, fail.Fail].ok{false}; }

    val alloc:   *A.Allocator               = s.alloc;
    var strong:  map.Map[intern.StrId, u32] = map.init[intern.StrId, u32](alloc);
    var defined: map.Map[intern.StrId, u32] = map.init[intern.StrId, u32](alloc);
    var seen:    map.Map[intern.StrId, u32] = map.init[intern.StrId, u32](alloc);
    fin {
        map.dnit[intern.StrId, u32](?seen);
        map.dnit[intern.StrId, u32](?defined);
        map.dnit[intern.StrId, u32](?strong);
    }

    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *target_of.Symbol = ?modules[m].symbols[sy];
            if (!target_of.section_is_external(sym.section)
                && target_of.section_index(sym.section) < modules[m].section_count
                && (sym.flags & target_of.SYM_OBJ_FLAG_GLOBAL) != 0
                && is_loadable_kind(modules[m].sections[target_of.section_index(sym.section)].kind)) {
                val get_r: opt[*u32] = map.get[intern.StrId, u32](?defined, ?sym.name);
                if (sel get_r.none) {
                    val di: res[bool, A.Error] =
                        map.insert[intern.StrId, u32](?defined, sym.name, 0);
                    if (sel di.err) { ret res[bool, fail.Fail].err{fail.refused(di.err)}; }
                }
                if ((sym.flags & target_of.SYM_OBJ_FLAG_WEAK) == 0
                    && !map.contains[intern.StrId, u32](?strong, ?sym.name)) {
                    val si: res[bool, A.Error] =
                        map.insert[intern.StrId, u32](?strong, sym.name, 0);
                    if (sel si.err) { ret res[bool, fail.Fail].err{fail.refused(si.err)}; }
                }
            }
            sy = sy + 1;
        }
        m = m + 1;
    }

    var count: u32 = 0;
    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym:  *target_of.Symbol          = ?modules[m].symbols[sy];
            val cn_r: res[ImportName, fail.Fail] =
                local_import_candidate(s, prefix, sym, ?strong, ?defined);
            if (sel cn_r.err) { ret res[bool, fail.Fail].err{cn_r.err}; }
            val cn: ImportName = cn_r.ok;
            if (cn.indirect
                && local_import_referenced(
                modules, module_count, sym.name, sec_base, atoms)
                && !map.contains[intern.StrId, u32](?seen, ?sym.name)) {
                if (count == 0x1FFFFFFF) {
                    ret res[bool, fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "local import pointer section exceeds 32 bits")};
                }
                val ins: res[bool, A.Error] =
                    map.insert[intern.StrId, u32](?seen, sym.name, count);
                if (sel ins.err) { ret res[bool, fail.Fail].err{fail.refused(ins.err)}; }
                count = count + 1;
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    if (count == 0) { ret res[bool, fail.Fail].ok{false}; }

    val image_name_r: res[intern.StrId, fail.Fail] = name_intern(s, "<local-import-pointers>");
    if (sel image_name_r.err) { ret res[bool, fail.Fail].err{image_name_r.err}; }
    val section_name_r: res[intern.StrId, fail.Fail] = name_intern(s, ".data.rel.ro");
    if (sel section_name_r.err) { ret res[bool, fail.Fail].err{section_name_r.err}; }
    @out = target_of.object_image_init(alloc, ?s.interner, image_name_r.ok);
    var complete: bool = false;
    fin {
        if (!complete) { target_of.object_image_dnit(out); }
    }

    val size_r: res[u32, fail.Fail] = local_import_storage_size(count);
    if (sel size_r.err) { ret res[bool, fail.Fail].err{size_r.err}; }
    val byte_count: u32               = size_r.ok;
    val bytes_r:    res[*u8, A.Error] = A.zallocate[u8](alloc, byte_count::usize);
    if (sel bytes_r.err) { ret res[bool, fail.Fail].err{fail.refused(bytes_r.err)}; }
    var sec: target_of.Section;
    sec.name  = section_name_r.ok;
    sec.kind  = target_of.SK_RELRO;
    sec.bytes = bytes_r.ok;
    sec.len   = byte_count;
    sec.align = 8;
    sec.flags = 0;
    val sec_r: res[u32, fail.Fail] = target_of.section_install(out, ?sec);
    if (sel sec_r.err) {
        A.deallocate[u8](alloc, bytes_r.ok, byte_count::usize);
        ret res[bool, fail.Fail].err{sec_r.err};
    }

    val symbols_r: res[*target_of.Symbol, A.Error] =
        A.zallocate[target_of.Symbol](alloc, (count * 2)::usize);
    if (sel symbols_r.err) { ret res[bool, fail.Fail].err{fail.refused(symbols_r.err)}; }
    out.symbols      = symbols_r.ok;
    out.symbol_count = count * 2;
    out.symbol_cap   = count * 2;

    val relocs_r: res[*target_of.Relocation, A.Error] =
        A.zallocate[target_of.Relocation](alloc, count::usize);
    if (sel relocs_r.err) { ret res[bool, fail.Fail].err{fail.refused(relocs_r.err)}; }
    out.relocations = relocs_r.ok;
    out.reloc_count = count;
    out.reloc_cap   = count;

    map.clear[intern.StrId, u32](?seen);
    var w: u32 = 0;
    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym:  *target_of.Symbol          = ?modules[m].symbols[sy];
            val cn_r: res[ImportName, fail.Fail] =
                local_import_candidate(s, prefix, sym, ?strong, ?defined);
            if (sel cn_r.err) { ret res[bool, fail.Fail].err{cn_r.err}; }
            val cn: ImportName = cn_r.ok;
            if (!cn.indirect
                || !local_import_referenced(
                modules, module_count, sym.name, sec_base, atoms)
                || map.contains[intern.StrId, u32](?seen, ?sym.name)) {
                sy = sy + 1;
                cnt;
            }
            val ins: res[bool, A.Error] =
                map.insert[intern.StrId, u32](?seen, sym.name, w);
            if (sel ins.err) { ret res[bool, fail.Fail].err{fail.refused(ins.err)}; }

            val alias_ix:  u32 = w * 2;
            val target_ix: u32 = alias_ix + 1;
            out.symbols[alias_ix].name      = sym.name;
            out.symbols[alias_ix].section   = target_of.section_id(0);
            out.symbols[alias_ix].offset    = w * 8;
            out.symbols[alias_ix].size      = 8;
            out.symbols[alias_ix].flags     = target_of.SYM_OBJ_FLAG_GLOBAL;
            out.symbols[alias_ix].fallback  = target_of.SYMBOL_NONE;
            out.symbols[alias_ix].align     = 8;
            out.symbols[target_ix].name     = cn.canonical;
            out.symbols[target_ix].section  = target_of.external_section();
            out.symbols[target_ix].offset   = 0;
            out.symbols[target_ix].size     = 0;
            out.symbols[target_ix].flags    = target_of.SYM_OBJ_FLAG_GLOBAL;
            out.symbols[target_ix].fallback = target_of.SYMBOL_NONE;
            out.symbols[target_ix].align    = 1;

            out.relocations[w].section = target_of.section_id(0);
            out.relocations[w].offset  = w * 8;
            out.relocations[w].kind    = target_of.RK_ABS64;
            out.relocations[w].sym     = target_ix;
            out.relocations[w].addend  = 0;
            out.relocations[w].sym2    = target_of.SYMBOL_NONE;
            w                          = w + 1;
            sy                         = sy + 1;
        }
        m = m + 1;
    }
    if (w != count) {
        ret res[bool, fail.Fail].err{fail.message("local import pointer synthesis changed between passes")};
    }
    val valid: err[fail.Fail] = target_of.validate_owned_object(out);
    if (sel valid.err) { ret res[bool, fail.Fail].err{valid.err}; }
    complete = true;
    ret res[bool, fail.Fail].ok{true};
}

fun dynstate_add_lib(alloc: *A.Allocator, dyn: *DynState, lib: target_of.DynLib) err[fail.Fail] {
    val grown: err[A.Error] = growth.reserve[target_of.DynLib](alloc, ?dyn.info.libs, ?dyn.lib_cap, dyn.info.lib_count::usize + 1);
    if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    dyn.info.libs[dyn.info.lib_count] = lib;
    dyn.info.lib_count                = dyn.info.lib_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun dynstate_import_index(dyn: *DynState, name: intern.StrId) res[u32, fail.Fail] {
    if (!dyn.active) { ret res[u32, fail.Fail].err{fail.message("not dynamic")}; }
    val g: opt[*u32] = map.get[intern.StrId, u32](?dyn.import_map, ?name);
    if (sel g.none) { ret res[u32, fail.Fail].err{fail.message("not an import")}; }
    ret res[u32, fail.Fail].ok{@g.some};
}

pub fun dynstate_import_is_func(dyn: *DynState, idx: u32) bool {
    if (idx >= dyn.info.import_count) { ret false; }
    ret dyn.info.imports[idx].is_func;
}

pub fun dynstate_add_fixup(s: *session.Session, dyn: *DynState, seg_index: u32, seg_offset: u32,
    import_index: u32, patch_vaddr: u64, kind: target_of.RelocKind, addend: i64) err[fail.Fail] {
    val alloc: *A.Allocator = s.alloc;
    if (dyn.info.call_fixup_count == dyn.call_fixup_cap) {
        val grown: err[A.Error] = growth.reserve[target_of.ImportFixup](alloc, ?dyn.info.call_fixups, ?dyn.call_fixup_cap,
            dyn.info.call_fixup_count::usize + 1);
        if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    }
    val ix: u32 = dyn.info.call_fixup_count;
    dyn.info.call_fixups[ix] = target_of.ImportFixup{seg_index: seg_index, seg_offset: seg_offset, import_index: import_index,
        patch_vaddr: patch_vaddr, kind: kind, addend: addend};
    dyn.info.call_fixup_count = ix + 1;
    ret err[fail.Fail].ok{};
}

pub fun dynstate_add_import_addr_fixup(s: *session.Session, dyn: *DynState,
    seg_index: u32, seg_offset: u32,
    import_index: u32, patch_vaddr: u64,
    kind: target_of.RelocKind, addend: i64, origin: target_of.RelocOrigin) err[fail.Fail] {
    val alloc: *A.Allocator = s.alloc;
    if (dyn.info.import_addr_fixup_count == dyn.import_addr_fixup_cap) {
        val grown: err[A.Error] = growth.reserve[target_of.ImportFixup](alloc, ?dyn.info.import_addr_fixups, ?dyn.import_addr_fixup_cap, dyn.info.import_addr_fixup_count::usize + 1);
        if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    }
    val ix: u32 = dyn.info.import_addr_fixup_count;
    dyn.info.import_addr_fixups[ix].seg_index    = seg_index;
    dyn.info.import_addr_fixups[ix].seg_offset   = seg_offset;
    dyn.info.import_addr_fixups[ix].import_index = import_index;
    dyn.info.import_addr_fixups[ix].patch_vaddr  = patch_vaddr;
    dyn.info.import_addr_fixups[ix].kind         = kind;
    dyn.info.import_addr_fixups[ix].addend       = addend;
    dyn.info.import_addr_fixups[ix].origin       = origin;
    dyn.info.import_addr_fixup_count             = ix + 1;
    ret err[fail.Fail].ok{};
}

pub fun dynstate_add_base_reloc(s: *session.Session, dyn: *DynState, seg_index: u32,
    seg_offset: u32, target: u64) err[fail.Fail] {
    val alloc: *A.Allocator = s.alloc;
    if (dyn.info.base_reloc_count == dyn.base_reloc_cap) {
        val grown: err[A.Error] = growth.reserve[target_of.BaseReloc](alloc, ?dyn.info.base_relocs, ?dyn.base_reloc_cap, dyn.info.base_reloc_count::usize + 1);
        if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    }
    val ix: u32 = dyn.info.base_reloc_count;
    dyn.info.base_relocs[ix].seg_index  = seg_index;
    dyn.info.base_relocs[ix].seg_offset = seg_offset;
    dyn.info.base_relocs[ix].target     = target;
    dyn.info.base_reloc_count           = ix + 1;
    ret err[fail.Fail].ok{};
}

pub fun target_requires_pie(tgt: *lang_target.Binding) bool {
    ret tgt.target.pie_default;
}

# refused when the link needs a loader and the os maps none
pub fun loader_check(s: *session.Session, tgt: *lang_target.Binding, mode: catalog_artifact.Kind,
    pie: bool, dynamic: bool) err[fail.Fail] {
    if (tgt.os.mapped_by_loader) { ret err[fail.Fail].ok{}; }
    val shared: opt[bool] = catalog_artifact.is_loaded(mode);
    if (sel shared.none) { ret err[fail.Fail].err{fail.unknown_catalog(s.alloc, "artifact kind", mode::u32)}; }
    if (pie) {
        ret err[fail.Fail].err{loader_missing(s, tgt.os.name,
            "a position-independent executable needs a loader to relocate it")};
    }
    if (shared.some) {
        ret err[fail.Fail].err{loader_missing(s, tgt.os.name,
            "a shared library needs a loader to map it")};
    }
    if (dynamic) {
        ret err[fail.Fail].err{loader_missing(s, tgt.os.name,
            "a dynamically-linked executable needs a loader to resolve it")};
    }
    ret err[fail.Fail].ok{};
}

fun loader_missing(s: *session.Session, os_name: str, need: str) fail.Fail {
    ret fail.user_of(diagnostic_kind.LINK_NO_LOADER,
        fail.format_intern(?s.interner, s.alloc, "{}, and sys = \"{}\" has none", need, os_name));
}

pub fun pinned_attribution_message(l: *linkage.Linkage, s: *session.Session, sym_name: intern.StrId,
    lib: intern.StrId) res[str, fail.Fail] {
    val provider: opt[linkage.Provider] = linkage.provider(l, lib);
    if (sel provider.some
        && provider.some.is_static) {
        ret static_provider_message(s, sym_name, lib);
    }
    ret pinned_lib_message(l, s, sym_name, lib);
}

fun static_provider_message(s: *session.Session, sym_name: intern.StrId,
    lib: intern.StrId) res[str, fail.Fail] {
    if (intern.str_is_nil(sym_name) || intern.str_is_nil(lib)) {
        ret res[str, fail.Fail].ok{"import pinned to a library this link provides as a static input, which defines symbols rather than importing them; the symbol is undefined"};
    }
    ret fail.format_intern(?s.interner, s.alloc,
        "import '{}' is pinned to library '{}', which this link provides as a static input. a static input defines symbols rather than importing them, so nothing binds the import: the symbol is not defined by any object or archive in the link. check the declaration's spelling against the library's own symbols, or that the archive was built with it",
        intern.text(?s.interner, sym_name), intern.text(?s.interner, lib));
}

fun pinned_lib_message(l: *linkage.Linkage, s: *session.Session, sym_name: intern.StrId, lib: intern.StrId) res[str, fail.Fail] {
    if (intern.str_is_nil(sym_name) || intern.str_is_nil(lib)) {
        ret res[str, fail.Fail].ok{"import pinned to a library not among the link's dependencies"};
    }
    val head: res[str, fail.Fail] = fail.format_intern(?s.interner, s.alloc,
        "import '{}' pinned to library '{}' not among the link's dependencies",
        intern.text(?s.interner, sym_name), intern.text(?s.interner, lib));
    if (sel head.err) { ret head; }
    val provided: res[str, fail.Fail] = link_providers_text(l, s);
    if (sel provided.err)          { ret provided; }
    if (str_len(provided.ok) == 0) { ret head; }
    ret fail.format_intern(?s.interner, s.alloc, "{}; this link provides: {}", head.ok, provided.ok);
}

# `acc` and `piece` joined by `, `, or `piece` alone when `acc` is empty
fun list_join(s: *session.Session, acc: str, piece: str) res[str, fail.Fail] {
    if (str_len(acc) == 0) { ret res[str, fail.Fail].ok{piece}; }
    ret fail.format_intern(?s.interner, s.alloc, "{}, {}", acc, piece);
}

fun link_providers_text(l: *linkage.Linkage, s: *session.Session) res[str, fail.Fail] {
    val provs: *linkage.Provider = l.providers.data;
    val n:     usize             = l.providers.len;
    var acc:   str               = "";
    var i:     usize             = 0;
    for (i < n) {
        if (intern.str_is_nil(provs[i].name)) {
            i = i + 1;
            cnt;
        }
        var piece: str = intern.text(?s.interner, provs[i].name);
        if (provs[i].is_static) {
            val marked: res[str, fail.Fail] = fail.format_intern(?s.interner, s.alloc, "{} (static)", piece);
            if (sel marked.err) { ret marked; }
            piece = marked.ok;
        }
        val joined: res[str, fail.Fail] = list_join(s, acc, piece);
        if (sel joined.err) { ret joined; }
        acc = joined.ok;
        i   = i + 1;
    }
    ret res[str, fail.Fail].ok{acc};
}

fun unattributed_import_message(s: *session.Session, sym_name: intern.StrId,
    c_symbol_prefix: str,
    dynlibs: *target_of.DynLib, dynlib_count: u32) res[str, fail.Fail] {
    if (intern.str_is_nil(sym_name)) {
        ret res[str, fail.Fail].ok{"dynamic import has no #[library] attribution; a two-level-namespace target requires every import to name its providing library - annotate the declaration with #[library(\"...\")], or, when the symbol arrives from a static archive member and has no declaration to annotate, claim it with symbols = [...] on the [link.<entry>] naming its library"};
    }
    val name:  str                 = intern.text(?s.interner, sym_name);
    val claim: res[str, fail.Fail] = fail.format_intern(?s.interner, s.alloc,
        "dynamic import '{}' has no #[library] attribution; a two-level-namespace target requires every import to name its providing library - annotate the declaration with #[library(\"...\")], or, when the symbol arrives from a static archive member and has no declaration to annotate, claim it with symbols = [\"{}\"] on the [link.<entry>] naming its library",
        name, source_spelling(name, c_symbol_prefix));
    if (sel claim.err) { ret claim; }
    val cands: res[str, fail.Fail] = dynlibs_text(s, dynlibs, dynlib_count);
    if (sel cands.err)          { ret cands; }
    if (str_len(cands.ok) == 0) { ret claim; }
    ret fail.format_intern(?s.interner, s.alloc, "{}; candidate libraries: {}", claim.ok, cands.ok);
}

fun source_spelling(name: str, prefix: str) str {
    if (str_empty(prefix) || !str_starts_with(name, prefix)
        || str_len(name) <= str_len(prefix)) {
        ret name;
    }
    ret (name::usize + str_len(prefix))::str;
}

fun is_import_address_alias(s: *session.Session, name: intern.StrId, prefix: str) bool {
    if (intern.str_is_nil(name)) { ret false; }
    val text: str = intern.text(?s.interner, name);
    ret str_starts_with(text, prefix) && str_len(text) > str_len(prefix);
}

fun import_alias_message(s: *session.Session, name: intern.StrId, prefix: str) res[str, fail.Fail] {
    val text:   str = intern.text(?s.interner, name);
    val export: str = (text::usize + str_len(prefix))::str;
    ret fail.format_intern(?s.interner, s.alloc,
        "dynamic import '{}' names the import-address alias of '{}' rather than an export: '{}' is the convention for the address cell the import table itself synthesizes, so no library exports a symbol under that name and the image would fail to load. import '{}' instead - the linker emits that import and resolves every alias reference to its address cell",
        text, export, prefix, export);
}

fun dynlibs_text(s: *session.Session, dynlibs: *target_of.DynLib, dynlib_count: u32) res[str, fail.Fail] {
    var acc: str = "";
    var i:   u32 = 0;
    for (i < dynlib_count) {
        if (intern.str_is_nil(dynlibs[i].name)) {
            i = i + 1;
            cnt;
        }
        var piece: str = intern.text(?s.interner, dynlibs[i].name);
        if (!intern.str_same(dynlibs[i].soname, dynlibs[i].name) && !intern.str_is_nil(dynlibs[i].soname)) {
            val named: res[str, fail.Fail] = fail.format_intern(?s.interner, s.alloc, "{} ({})", piece,
                intern.text(?s.interner, dynlibs[i].soname));
            if (sel named.err) { ret named; }
            piece = named.ok;
        }
        val joined: res[str, fail.Fail] = list_join(s, acc, piece);
        if (sel joined.err) { ret joined; }
        acc = joined.ok;
        i   = i + 1;
    }
    ret res[str, fail.Fail].ok{acc};
}
