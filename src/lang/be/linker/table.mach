# table: the tables a format asks the linker to reserve before anything is
# given an address, at the end of the code or at the end of the read-only data
# the loader writes once. the format writes the table's bytes, and reads back
# where it lies from the span the link hands it
use std.types.bool.true;
use std.types.result.res;
use std.types.string.str;

use A: std.allocator;
use std.allocator.page;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.session;
use target_of: mach.lang.target.of;

use mach.lang.be.linker.merge.MERGED_KIND_COUNT;
use mach.lang.be.linker.merge.MergedSection;
use mach.lang.be.linker.merge.SectionGroups;
use mach.lang.be.linker.merge.align_up_u64_checked;
use mach.lang.be.linker.merge.free_section_groups;
use mach.lang.be.linker.merge.init_merged;
use mach.lang.be.linker.merge.init_section_groups;
use mach.lang.be.linker.merge.section_group_add;

# where a reserved table lies: an offset into the merged section its placement
# ends
pub rec At {
    placement: target_of.TablePlacement;
    offset:    u32;
}

# reserves the table `shape` declares where it places it, its one section named
# by the shape and flagged `flag`. a table at the end of the read-only data
# extends a section of the same name that already ends it, as a GOT the link
# synthesized for defined symbols does
# ---
# overflow: why a table that takes its section past the maximum size is refused
pub fun reserve(s: *session.Session, merged: *MergedSection, groups: *SectionGroups,
    shape: *target_of.TableShape, flag: u32, overflow: str) res[At, fail.Fail] {
    if (shape.placement != target_of.TABLE_CODE_END && shape.placement != target_of.TABLE_RELRO_END) {
        ret res[At, fail.Fail].err{fail.message("a table the layout moves around is reserved at the end of the code or of the read-only data")};
    }
    val name_r: res[intern.StrId, A.Error] = intern.add(?s.interner, shape.name);
    if (sel name_r.err) { ret res[At, fail.Fail].err{fail.refused(name_r.err)}; }
    val name: intern.StrId = name_r.ok;

    var slot: u32 = target_of.SK_TEXT::u32;
    if (shape.placement == target_of.TABLE_RELRO_END) { slot = target_of.SK_RELRO::u32; }
    val start_r: res[u64, fail.Fail] = align_up_u64_checked(merged[slot].len::u64, shape.align::u64);
    if (sel start_r.err) { ret res[At, fail.Fail].err{start_r.err}; }
    val start: u64 = start_r.ok;
    if (shape.size::u64 > 0xFFFFFFFF - start) {
        ret res[At, fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, overflow)};
    }
    val end: u64 = start + shape.size::u64;

    var gi: u32 = 0xFFFFFFFF;
    if (shape.placement == target_of.TABLE_RELRO_END) {
        var i: u32 = 0;
        for (i < groups.count) {
            if (groups.items[i].slot == slot && intern.str_same(groups.items[i].name, name)
                && groups.items[i].base::u64 + groups.items[i].len::u64 == merged[slot].len::u64) {
                gi = i;
            }
            i = i + 1;
        }
    }
    if (gi == 0xFFFFFFFF) {
        val ga: res[u32, fail.Fail] = section_group_add(s.alloc, groups, slot, name, flag);
        if (sel ga.err) { ret res[At, fail.Fail].err{ga.err}; }
        gi                     = ga.ok;
        groups.items[gi].base  = start::u32;
        groups.items[gi].align = shape.align;
    }
    if (groups.items[gi].align < shape.align) { groups.items[gi].align = shape.align; }
    groups.items[gi].cursor = end::u32;
    groups.items[gi].len    = (end - groups.items[gi].base::u64)::u32;

    merged[slot].used = true;
    if (merged[slot].align < shape.align) { merged[slot].align = shape.align; }
    merged[slot].len = end::u32;
    ret res[At, fail.Fail].ok{At{placement: shape.placement, offset: start::u32}};
}

# the address a reserved table starts at, once the layout is final
pub fun vaddr_of(at: At, merged: *MergedSection) u64 {
    if (at.placement == target_of.TABLE_RELRO_END) { ret merged[target_of.SK_RELRO::u32].vaddr + at.offset::u64; }
    ret merged[target_of.SK_TEXT::u32].vaddr + at.offset::u64;
}

test reserve__places_at_the_end_of_its_section_and_refuses_an_own_segment {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:      session.Session = sr.ok;
    var merged: [MERGED_KIND_COUNT]MergedSection;
    init_merged(?merged[0], nil, 0);
    merged[target_of.SK_TEXT::u32].len = 0x13;
    var groups: SectionGroups;
    init_section_groups(?groups);
    fin { free_section_groups(?alloc, ?groups); }

    var code: target_of.TableShape = target_of.TableShape{name: ".plt", size: 0x20, align: 16, placement: target_of.TABLE_CODE_END};
    val at:   res[At, fail.Fail]   = reserve(?s, ?merged[0], ?groups, ?code, 0, "too large");
    if (sel at.err)                                 { ret 2; }
    if (at.ok.offset != 0x20)                       { ret 3; }
    if (merged[target_of.SK_TEXT::u32].len != 0x40) { ret 4; }

    var own:     target_of.TableShape = target_of.TableShape{name: ".idata", size: 8, align: 8, placement: target_of.TABLE_OWN_SEGMENT};
    val refused: res[At, fail.Fail]   = reserve(?s, ?merged[0], ?groups, ?own, 0, "too large");
    if (!sel refused.err) { ret 5; }
    ret 0;
}
