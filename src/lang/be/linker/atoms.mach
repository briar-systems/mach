rec AtomDropCountUnit {}

rec AtomDrop {
    section: u32;
    start:   u32;
    end:     u32;
    resume:  u32;
}

rec AtomSection {
    first:    u32;
    count:    u32;
    live_len: u32;
}

pub rec AtomPlan {
    drops:         *AtomDrop;
    drop_count:    u32;
    drop_cap:      u32;
    sections:      *AtomSection;
    section_count: u32;
    removed_bytes: u64;
    active:        bool;
}

rec AtomCandidate {
    module: u32;
    symbol: u32;
}

pub val ATOM_OWNS: u32 = 0xFFFFFFFF;

fun mergeable_atom_eligible(modules: *of.ObjectImage, m: u32, sc: u32,
    atoms: *AtomPlan, flat: u32) bool {
    val sec: *of.Section = ?modules[m].sections[sc];
    if ((sec.flags & of.SEC_FLAG_MERGEABLE) == 0)       { ret false; }
    if (!is_loadable_kind(sec.kind))                    { ret false; }
    if (atom_live_len(atoms, flat, sec.len) != sec.len) { ret false; }
    var ri: u32 = 0;
    for (ri < modules[m].reloc_count) {
        if (of.section_index(modules[m].relocations[ri].section) == sc) { ret false; }
        ri = ri + 1;
    }
    ret true;
}

fun mergeable_atoms_match(a: *of.Section, b: *of.Section) bool {
    if (a.name != b.name || a.kind != b.kind) { ret false; }
    if (a.len != b.len || a.align != b.align) { ret false; }
    if (a.len == 0)                           { ret true; }
    if (a.bytes == nil || b.bytes == nil)     { ret false; }
    ret memory.raw_equal(a.bytes::ptr, b.bytes::ptr, a.len::usize);
}

pub fun plan_atom_coalescing(alloc: *A.Allocator, modules: *of.ObjectImage, module_count: u32,
    sec_base: *u32, sec_total: u32,
    atoms: *AtomPlan) res[*u32, fail.Fail] {
    if (sec_total == 0) { ret res[*u32, fail.Fail].ok{nil}; }
    val ar: res[*u32, A.Error] = A.allocate[u32](alloc, sec_total::usize);
    if (sel ar.err) { ret res[*u32, fail.Fail].err{fail.refused(ar.err)}; }
    val dup: *u32 = ar.ok;
    var i:   u32  = 0;
    for (i < sec_total) {
        dup[i] = ATOM_OWNS;
        i      = i + 1;
    }

    var m: u32 = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val flat: u32 = sec_base[m] + sc;
            if (!mergeable_atom_eligible(modules, m, sc, atoms, flat)) {
                sc = sc + 1;
                cnt;
            }
            val sec: *of.Section = ?modules[m].sections[sc];

            var wm: u32 = 0;
            for (wm <= m && dup[flat] == ATOM_OWNS) {
                var wc: u32 = 0;
                for (wc < modules[wm].section_count && dup[flat] == ATOM_OWNS) {
                    val wflat: u32 = sec_base[wm] + wc;
                    if (wflat >= flat) {
                        wc = wc + 1;
                        cnt;
                    }
                    if (dup[wflat] != ATOM_OWNS) {
                        wc = wc + 1;
                        cnt;
                    }
                    if (!mergeable_atom_eligible(modules, wm, wc, atoms, wflat)) {
                        wc = wc + 1;
                        cnt;
                    }
                    if (mergeable_atoms_match(?modules[wm].sections[wc], sec)) { dup[flat] = wflat; }
                    wc = wc + 1;
                }
                wm = wm + 1;
            }
            sc = sc + 1;
        }
        m = m + 1;
    }
    ret res[*u32, fail.Fail].ok{dup};
}

pub fun init_atom_plan(plan: *AtomPlan) {
    plan.drops         = nil;
    plan.drop_count    = 0;
    plan.drop_cap      = 0;
    plan.sections      = nil;
    plan.section_count = 0;
    plan.removed_bytes = 0;
    plan.active        = false;
}

pub fun free_atom_plan(alloc: *A.Allocator, plan: *AtomPlan) {
    if (plan == nil) { ret; }
    if (plan.drops != nil && plan.drop_cap > 0) {
        A.deallocate[AtomDrop](alloc, plan.drops, plan.drop_cap::usize);
    }
    if (plan.sections != nil && plan.section_count > 0) {
        A.deallocate[AtomSection](alloc, plan.sections, plan.section_count::usize);
    }
    init_atom_plan(plan);
}

fun atom_drop_cmp(a: *AtomDrop, b: *AtomDrop) i64 {
    if (a.section < b.section) { ret -1; }
    if (a.section > b.section) { ret 1; }
    if (a.start < b.start)     { ret -1; }
    if (a.start > b.start)     { ret 1; }
    if (a.end < b.end)         { ret -1; }
    if (a.end > b.end)         { ret 1; }
    ret 0;
}

fun atom_resume_offset(dst: u32, end: u32, section_align: u32) u32 {
    if (end <= dst) { ret dst; }
    var a: u32 = section_align;
    if (a == 0) { a = 1; }
    ret dst + (end - dst) % a;
}

fun unreferenced_local(m: *of.ObjectImage, sy: u32) bool {
    if (sy >= m.symbol_count) { ret false; }
    val sym: *of.Symbol = ?m.symbols[sy];
    if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) != 0) { ret false; }
    if (of.section_is_external(sym.section))       { ret false; }
    var ri: u32 = 0;
    for (ri < m.reloc_count) {
        val r: *of.Relocation = ?m.relocations[ri];
        if ((r.sym == sy || (of.is_difference(r.kind) && r.sym2 == sy))
            && !(of.section_index(r.section) < m.section_count && m.sections[of.section_index(r.section)].kind == of.SK_DEBUG)) {
            ret false;
        }
        ri = ri + 1;
    }
    ret true;
}

fun atom_is_carrier_anchor(m: *of.ObjectImage, owner: *of.Symbol,
    other: *of.Symbol, start: u32, end: u32) bool {
    if (start != 0 || owner.offset != 0)                                                                              { ret false; }
    if (of.section_index(owner.section) >= m.section_count || end != m.sections[of.section_index(owner.section)].len) { ret false; }
    if (!of.section_same(other.section, owner.section) || other.offset != 0 || other.size != 0)                       { ret false; }
    if (other.flags != 0 || other.name != m.sections[of.section_index(owner.section)].name)                           { ret false; }
    ret true;
}

fun atom_reloc_crosses_candidate(modules: *of.ObjectImage, reference: *AtomRelocRef,
    r: *of.Relocation,
    candidate_module: u32, candidate_section: u32,
    start: u32, end: u32) bool {
    val source_module: u32 = reference.source_module;
    val width:         u64 = reference.width::u64;
    if (source_module == candidate_module && of.section_index(r.section) == candidate_section
        && r.offset::u64 >= start::u64
        && r.offset::u64 + width <= end::u64) {
        ret false;
    }

    val target_module: u32 = reference.target_module;
    val target_symbol: u32 = reference.target_symbol;

    val target: *of.Symbol = ?modules[target_module].symbols[target_symbol];
    if (target_module != candidate_module || of.section_index(target.section) != candidate_section) { ret false; }
    if (target.offset > modules[candidate_module].sections[candidate_section].len)                  { ret false; }

    if (target.offset >= start && target.offset < end)     { ret true; }
    if (reference.addend_mode == rel.RELOC_ADDEND_IGNORED) { ret false; }

    var bias_min: i64 = 0;
    var bias_max: i64 = 0;
    if (reference.addend_mode == rel.RELOC_ADDEND_FIELD_BIAS
        && of.section_index(r.section) < modules[source_module].section_count
        && modules[source_module].sections[of.section_index(r.section)].kind == of.SK_TEXT) {
        bias_min = reference.text_bias_min::i64;
        bias_max = reference.text_bias_max::i64;
    }
    if ((bias_min > 0 && r.addend > 9223372036854775807 - bias_min)
        || (bias_min < 0 && r.addend < (-9223372036854775807 - 1) - bias_min)
        || (bias_max > 0 && r.addend > 9223372036854775807 - bias_max)
        || (bias_max < 0 && r.addend < (-9223372036854775807 - 1) - bias_max)) {
        ret true;
    }

    var effective_min: u32 = 0;
    var effective_max: u32 = 0;
    if (!atom_effective_offset(target.offset, r.addend + bias_min, ?effective_min)
        || !atom_effective_offset(target.offset, r.addend + bias_max, ?effective_max)) {
        ret true;
    }
    if (target.offset < start && effective_max >= start) { ret true; }
    if (target.offset >= end && effective_min < end)     { ret true; }
    ret false;
}

pub fun atom_offset_dead(plan: *AtomPlan, section: u32, off: u32) bool {
    if (plan == nil || !plan.active || section >= plan.section_count) { ret false; }
    val meta: *AtomSection = ?plan.sections[section];
    var i:    u32          = meta.first;
    val end:  u32          = meta.first + meta.count;
    for (i < end) {
        val drop: *AtomDrop = ?plan.drops[i];
        if (off < drop.start) { ret false; }
        if (off < drop.end)   { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun atom_live_offset(plan: *AtomPlan, section: u32, off: u32) u32 {
    if (plan == nil || !plan.active || section >= plan.section_count) { ret off; }
    val meta:       *AtomSection = ?plan.sections[section];
    var src_cursor: u32          = 0;
    var dst_cursor: u32          = 0;
    var i:          u32          = meta.first;
    val end:        u32          = meta.first + meta.count;
    for (i < end) {
        val drop: *AtomDrop = ?plan.drops[i];
        if (off < drop.start) { ret dst_cursor + (off - src_cursor); }
        if (off < drop.end)   { ret drop.resume; }
        src_cursor = drop.end;
        dst_cursor = drop.resume;
        i          = i + 1;
    }
    ret dst_cursor + (off - src_cursor);
}

pub fun atom_live_len(plan: *AtomPlan, section: u32, original_len: u32) u32 {
    if (plan == nil || !plan.active || section >= plan.section_count) { ret original_len; }
    ret plan.sections[section].live_len;
}

pub fun copy_live_section(dst: *u8, src: *u8, src_len: u32, plan: *AtomPlan, section: u32) {
    if (plan == nil || !plan.active || section >= plan.section_count
        || plan.sections[section].count == 0) {
        memory.copy[u8](dst, src, src_len::usize);
        ret;
    }

    val meta:       *AtomSection = ?plan.sections[section];
    var src_cursor: u32          = 0;
    var dst_cursor: u32          = 0;
    var i:          u32          = meta.first;
    val end:        u32          = meta.first + meta.count;
    for (i < end) {
        val drop: *AtomDrop = ?plan.drops[i];
        val n:    u32       = drop.start - src_cursor;
        if (n > 0) {
            memory.copy[u8](?dst[dst_cursor], ?src[src_cursor], n::usize);
            dst_cursor = dst_cursor + n;
        }
        src_cursor = drop.end;
        dst_cursor = drop.resume;
        i          = i + 1;
    }
    if (src_cursor < src_len) {
        memory.copy[u8](?dst[dst_cursor], ?src[src_cursor], (src_len - src_cursor)::usize);
    }
}

# the atom plan of a final image: losing weak duplicates and every range no
# root reaches become drops
pub fun build_atom_plan(s: *session.Session, modules: *of.ObjectImage, module_count: u32,
    codegen_count: u32, sec_base: *u32, sec_total: u32, enabled: bool,
    roots: *LinkRoots, arch: *isa.IsaVTable, plan: *AtomPlan) err[fail.Fail] {
    if (codegen_count > module_count) {
        ret err[fail.Fail].err{fail.message("linker: codegen image count exceeds module count")};
    }
    val fsb_r: err[fail.Fail] = fill_section_bases(modules, module_count, sec_base);
    if (sel fsb_r.err) { ret fsb_r; }
    if (!enabled)      { ret err[fail.Fail].ok{}; }
    if (roots == nil)  { ret err[fail.Fail].err{fail.message("linker: a final image has no roots")}; }

    val symbol_total_r: res[u32, fail.Fail] = total_symbols(modules, module_count);
    if (sel symbol_total_r.err) { ret err[fail.Fail].err{symbol_total_r.err}; }
    val symbol_total: u32 = symbol_total_r.ok;
    var m:            u32 = 0;

    var candidates: *AtomCandidate = nil;
    if (symbol_total > 0) {
        val cr: res[*AtomCandidate, A.Error] =
            A.zallocate[AtomCandidate](s.alloc, symbol_total::usize);
        if (sel cr.err) {
            ret err[fail.Fail].err{fail.refused(cr.err)};
        }
        candidates = cr.ok;
    }
    fin {
        if (candidates != nil) { A.deallocate[AtomCandidate](s.alloc, candidates, symbol_total::usize); }
    }

    var winners: map.Map[intern.StrId, AtomWinner] =
        map.init[intern.StrId, AtomWinner](s.alloc, map.hash_u32, map.eq_u32);
    fin { map.dnit[intern.StrId, AtomWinner](?winners); }
    var candidate_count: u32 = 0;
    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if (of.section_is_external(sym.section) || of.section_is_absolute(sym.section)) {
                sy = sy + 1;
                cnt;
            }
            if (of.section_index(sym.section) >= modules[m].section_count) {
                ret err[fail.Fail].err{fail.message(oor_section_message(s, sym.name, modules[m].name))};
            }
            if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0) {
                sy = sy + 1;
                cnt;
            }

            val weak:     bool             = (sym.flags & of.SYM_OBJ_FLAG_WEAK) != 0;
            val existing: opt[*AtomWinner] =
                map.get[intern.StrId, AtomWinner](?winners, ?sym.name);
            if (sel existing.some) {
                val cur: *AtomWinner = existing.some;
                if (weak) {
                    candidates[candidate_count].module = m;
                    candidates[candidate_count].symbol = sy;
                    candidate_count                    = candidate_count + 1;
                    sy                                 = sy + 1;
                    cnt;
                }
                if (!cur.weak) {
                    ret err[fail.Fail].err{fail.message(dup_message(s, sym.name))};
                }
                candidates[candidate_count].module = cur.module;
                candidates[candidate_count].symbol = cur.symbol;
                candidate_count                    = candidate_count + 1;
                cur.module                         = m;
                cur.symbol                         = sy;
                cur.weak                           = false;
                sy                                 = sy + 1;
                cnt;
            }

            var winner: AtomWinner;
            winner.module = m;
            winner.symbol = sy;
            winner.weak   = weak;
            val ins: res[bool, A.Error] =
                map.insert[intern.StrId, AtomWinner](?winners, sym.name, winner);
            if (sel ins.err) {
                ret err[fail.Fail].err{fail.refused(ins.err)};
            }
            sy = sy + 1;
        }
        m = m + 1;
    }

    var ref_total: u32                           = 0;
    val refs_r:    res[*AtomRelocRef, fail.Fail] = build_reloc_refs(s, modules, module_count,
        codegen_count, sec_base, ?winners, arch, ?ref_total);
    if (sel refs_r.err) { ret err[fail.Fail].err{refs_r.err}; }
    val refs: *AtomRelocRef = refs_r.ok;
    fin {
        if (refs != nil) { A.deallocate[AtomRelocRef](s.alloc, refs, ref_total::usize); }
    }

    var dead_count: u32                        = 0;
    val dead_r:     res[*DeadRange, fail.Fail] = collect_dead_atoms(s, modules, module_count,
        codegen_count, sec_base, sec_total, ?winners, refs, ref_total, arch, roots, ?dead_count);
    if (sel dead_r.err) { ret err[fail.Fail].err{dead_r.err}; }
    val dead: *DeadRange = dead_r.ok;
    fin {
        if (dead != nil) { A.deallocate[DeadRange](s.alloc, dead, dead_count::usize); }
    }

    val drop_cap_r: res[u32, layout.CheckCause] = add_u32_counts[AtomDropCountUnit](candidate_count, dead_count);
    if (sel drop_cap_r.err) { ret err[fail.Fail].err{fail.message("linker: atom drop count exceeds the u32 limit")}; }
    val drop_cap: u32 = drop_cap_r.ok;
    if (drop_cap == 0) { ret err[fail.Fail].ok{}; }
    val dr: res[*AtomDrop, A.Error] = A.zallocate[AtomDrop](s.alloc, drop_cap::usize);
    if (sel dr.err) { ret err[fail.Fail].err{fail.refused(dr.err)}; }
    val drops:      *AtomDrop = dr.ok;
    var drop_count: u32       = 0;

    var ci: u32 = 0;
    for (ci < candidate_count) {
        val cm:   u32         = candidates[ci].module;
        val cy:   u32         = candidates[ci].symbol;
        val sym:  *of.Symbol  = ?modules[cm].symbols[cy];
        val sec:  *of.Section = ?modules[cm].sections[of.section_index(sym.section)];
        val need: u32         = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
        if ((sym.flags & need) != need || sec.kind != of.SK_TEXT || sec.bytes == nil
            || sym.offset >= sec.len) {
            ci = ci + 1;
            cnt;
        }

        val start: u32 = sym.offset;
        var end:   u32 = 0;
        if (sym.size > 0) {
            val sized_end: u64 = start::u64 + sym.size::u64;
            if (sized_end > sec.len::u64) {
                ci = ci + 1;
                cnt;
            }
            end = sized_end::u32;
        }
        or {
            end = sec.len;
            var nsy: u32 = 0;
            for (nsy < modules[cm].symbol_count) {
                val other: *of.Symbol = ?modules[cm].symbols[nsy];
                if (of.section_same(other.section, sym.section)
                    && (other.flags & (of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION))
                    == (of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION)
                    && other.offset > start && other.offset < end) {
                    end = other.offset;
                }
                nsy = nsy + 1;
            }
        }
        if (end <= start) {
            ci = ci + 1;
            cnt;
        }

        var safe: bool = true;
        var sy:   u32  = 0;
        for (sy < modules[cm].symbol_count) {
            if (sy != cy) {
                val other: *of.Symbol = ?modules[cm].symbols[sy];
                if (of.section_same(other.section, sym.section)
                    && !atom_is_carrier_anchor(?modules[cm], sym, other, start, end)
                    && !unreferenced_local(?modules[cm], sy)) {
                    if (other.offset >= start && other.offset < end) { safe = false; }
                    if (other.size > 0) {
                        val other_end: u64 = other.offset::u64 + other.size::u64;
                        if (other.offset < end && other_end > start::u64) {
                            safe = false;
                        }
                    }
                }
            }
            sy = sy + 1;
        }

        var ri: u32 = 0;
        for (safe && ri < modules[cm].reloc_count) {
            val r: *of.Relocation = ?modules[cm].relocations[ri];
            if (of.section_same(r.section, sym.section)) {
                val safety_traits: res[rel.RelocTraits, rel.RelocError] = atom_reloc_traits(
                    r, ?modules[cm].sections[of.section_index(r.section)], arch, cm < codegen_count);
                if (sel safety_traits.err) {
                    safe = false;
                }
                if (sel safety_traits.ok) {
                    val rstart: u64 = r.offset::u64;
                    val rend:   u64 = rstart
                        + safety_traits.ok.field_width::u64;
                    if (rstart < end::u64 && rend > start::u64
                        && (rstart < start::u64 || rend > end::u64)) {
                        safe = false;
                    }
                }
            }
            ri = ri + 1;
        }

        val candidate_flat: u32 = sec_base[cm] + of.section_index(sym.section);
        var ref_i:          u32 = reloc_ref_lower(refs, ref_total, candidate_flat);
        for (safe && ref_i < ref_total
            && refs[ref_i].target_section == candidate_flat) {
            val rm: u32 = refs[ref_i].source_module;
            val rx: u32 = refs[ref_i].reloc;
            if (atom_reloc_crosses_candidate(modules, ?refs[ref_i],
                ?modules[rm].relocations[rx], cm, of.section_index(sym.section), start, end)) {
                safe = false;
            }
            ref_i = ref_i + 1;
        }
        if (safe) {
            drops[drop_count].section = sec_base[cm] + of.section_index(sym.section);
            drops[drop_count].start   = start;
            drops[drop_count].end     = end;
            drops[drop_count].resume  = 0;
            drop_count                = drop_count + 1;
        }
        ci = ci + 1;
    }

    var di: u32 = 0;
    for (di < dead_count) {
        drops[drop_count].section = dead[di].section;
        drops[drop_count].start   = dead[di].start;
        drops[drop_count].end     = dead[di].end;
        drops[drop_count].resume  = 0;
        drop_count                = drop_count + 1;
        di                        = di + 1;
    }

    if (drop_count == 0) {
        A.deallocate[AtomDrop](s.alloc, drops, drop_cap::usize);
        ret err[fail.Fail].ok{};
    }

    sort.sort[AtomDrop](drops, drop_count::usize, atom_drop_cmp);

    var merged_count: u32 = 0;
    di = 0;
    for (di < drop_count) {
        if (merged_count > 0
            && drops[merged_count - 1].section == drops[di].section
            && drops[di].start <= drops[merged_count - 1].end) {
            if (drops[di].end > drops[merged_count - 1].end) {
                drops[merged_count - 1].end = drops[di].end;
            }
        }
        or {
            drops[merged_count] = drops[di];
            merged_count        = merged_count + 1;
        }
        di = di + 1;
    }

    val sr: res[*AtomSection, A.Error] =
        A.zallocate[AtomSection](s.alloc, sec_total::usize);
    if (sel sr.err) {
        A.deallocate[AtomDrop](s.alloc, drops, drop_cap::usize);
        ret err[fail.Fail].err{fail.refused(sr.err)};
    }
    val sections: *AtomSection = sr.ok;

    di = 0;
    var flat: u32 = 0;
    m = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val sec:  *of.Section  = ?modules[m].sections[sc];
            val meta: *AtomSection = ?sections[flat];
            meta.first = di;
            var src_cursor: u32 = 0;
            var dst_cursor: u32 = 0;
            for (di < merged_count && drops[di].section == flat) {
                dst_cursor = dst_cursor + (drops[di].start - src_cursor);
                if (drops[di].end < sec.len) {
                    dst_cursor =
                        atom_resume_offset(dst_cursor, drops[di].end, sec.align);
                }
                drops[di].resume = dst_cursor;
                src_cursor       = drops[di].end;
                di               = di + 1;
            }
            meta.count    = di - meta.first;
            meta.live_len = dst_cursor + (sec.len - src_cursor);
            flat          = flat + 1;
            sc            = sc + 1;
        }
        m = m + 1;
    }

    plan.drops         = drops;
    plan.drop_count    = merged_count;
    plan.drop_cap      = drop_cap;
    plan.sections      = sections;
    plan.section_count = sec_total;
    plan.removed_bytes = 0;
    flat               = 0;
    m                  = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            plan.removed_bytes = plan.removed_bytes
                + (modules[m].sections[sc].len - sections[flat].live_len)::u64;
            flat = flat + 1;
            sc   = sc + 1;
        }
        m = m + 1;
    }
    plan.active = true;
    ret err[fail.Fail].ok{};
}

fun module_definition_ref_is_dead(modules: *of.ObjectImage, m: u32, name: intern.StrId,
    addend: i64, sec_base: *u32, atoms: *AtomPlan) bool {
    ret definition_ref_is_dead(modules, m, first_defined_symbol(modules, m, name), addend, sec_base, atoms);
}

pub fun symbol_is_defined(modules: *of.ObjectImage, m: u32, sy: u32) bool {
    val sym: *of.Symbol = ?modules[m].symbols[sy];
    ret !of.section_is_external(sym.section) && of.section_index(sym.section) < modules[m].section_count;
}

fun first_defined_symbol(modules: *of.ObjectImage, m: u32, name: intern.StrId) u32 {
    var sy: u32 = 0;
    for (sy < modules[m].symbol_count) {
        if (modules[m].symbols[sy].name == name && symbol_is_defined(modules, m, sy)) { ret sy; }
        sy = sy + 1;
    }
    ret of.SYMBOL_NONE;
}

# whether the bytes a reference to definition sy of module m plus addend
# addresses were dropped from the image
pub fun definition_ref_is_dead(modules: *of.ObjectImage, m: u32, sy: u32,
    addend: i64, sec_base: *u32, atoms: *AtomPlan) bool {
    if (sy == of.SYMBOL_NONE || !symbol_is_defined(modules, m, sy)) { ret false; }
    val sym: *of.Symbol = ?modules[m].symbols[sy];
    val eff: i64        = sym.offset::i64 + addend;
    if (eff < 0 || eff > 0xFFFFFFFF) { ret false; }
    ret atom_offset_dead(atoms, sec_base[m] + of.section_index(sym.section), eff::u32);
}

pub fun reloc_source_live(modules: *of.ObjectImage, m: u32, r: *of.Relocation,
    sec_base: *u32, atoms: *AtomPlan) bool {
    if (atoms == nil || !atoms.active)                           { ret true; }
    if (of.section_index(r.section) >= modules[m].section_count) { ret true; }
    ret !atom_offset_dead(atoms, sec_base[m] + of.section_index(r.section), r.offset);
}

# whether a live relocation still names symbol_name; a reference from debug
# information describes code rather than needing the symbol, so it never counts
pub fun import_symbol_live(modules: *of.ObjectImage, module_count: u32,
    symbol_name: intern.StrId, sec_base: *u32,
    atoms: *AtomPlan) bool {
    if (atoms == nil || !atoms.active) { ret true; }
    var saw: bool = false;
    var m:   u32  = 0;
    for (m < module_count) {
        var ri: u32 = 0;
        for (ri < modules[m].reloc_count) {
            val r: *of.Relocation = ?modules[m].relocations[ri];
            if (of.reloc_symbol_name(?modules[m], r) == symbol_name) {
                saw = true;
                val from_debug: bool = of.section_index(r.section) < modules[m].section_count
                    && modules[m].sections[of.section_index(r.section)].kind == of.SK_DEBUG;
                if (!from_debug && reloc_source_live(modules, m, r, sec_base, atoms)) { ret true; }
            }
            ri = ri + 1;
        }
        m = m + 1;
    }
    ret !saw;
}

pub fun has_function_branch_reloc(modules: *of.ObjectImage, module_count: u32,
    symbol_name: intern.StrId, sec_base: *u32,
    atoms: *AtomPlan) bool {
    var m: u32 = 0;
    for (m < module_count) {
        var ri: u32 = 0;
        for (ri < modules[m].reloc_count) {
            val r: *of.Relocation = ?modules[m].relocations[ri];
            if (of.reloc_symbol_name(?modules[m], r) == symbol_name && is_function_branch_kind(r.kind)
                && reloc_source_live(modules, m, r, sec_base, atoms)) {
                ret true;
            }
            ri = ri + 1;
        }
        m = m + 1;
    }
    ret false;
}

pub fun lt_isa(reg: *target.TargetRegistry, name: str) *isa.IsaVTable {
    val found: opt[*isa.IsaVTable] = isa.lookup(?reg.isa, name);
    if (!sel found.some) { ret nil; }
    ret found.some;
}

fun lt_embed_sec(sec: *of.Section, name: intern.StrId, kind: of.SectionKind,
    bytes: *u8, len: u32, align: u32, embed: bool) {
    sec.name  = name;
    sec.kind  = kind;
    sec.bytes = bytes;
    sec.len   = len;
    sec.align = align;
    sec.flags = 0;
    if (embed) { sec.flags = of.SEC_FLAG_MERGEABLE; }
}

test "mach.lang.be.linker.plan_atom_coalescing:only_matching_embed_atoms" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val rodata: intern.StrId = lt_name(?s, ".rodata");
    val other:  intern.StrId = lt_name(?s, ".rodata.assets");
    if (rodata == intern.STR_NIL || other == intern.STR_NIL) { ret 1; }

    var abc: [4]u8;
    var xyz: [4]u8;
    var i:   u32 = 0;
    for (i < 4) {
        abc[i] = 0xA0 + i::u8;
        xyz[i] = 0xF0 + i::u8;
        i      = i + 1;
    }

    var secs0: [1]of.Section;
    lt_embed_sec(?secs0[0], rodata, of.SK_RODATA, ?abc[0], 4, 8, true);

    var secs1: [6]of.Section;
    lt_embed_sec(?secs1[0], rodata, of.SK_RODATA, ?abc[0], 4, 8, true);
    lt_embed_sec(?secs1[1], rodata, of.SK_RODATA, ?abc[0], 4, 8, false);
    lt_embed_sec(?secs1[2], rodata, of.SK_RODATA, ?xyz[0], 4, 8, true);
    lt_embed_sec(?secs1[3], rodata, of.SK_RODATA, ?abc[0], 4, 64, true);
    lt_embed_sec(?secs1[4], other, of.SK_RODATA, ?abc[0], 4, 8, true);
    lt_embed_sec(?secs1[5], rodata, of.SK_DATA, ?abc[0], 4, 8, true);

    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "m0"), ?secs0[0], 1, nil::*of.Symbol, 0, nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "m1"), ?secs1[0], 6, nil::*of.Symbol, 0, nil::*of.Relocation, 0);

    var sec_base: [2]u32;
    sec_base[0] = 0;
    sec_base[1] = 1;

    val dr: res[*u32, fail.Fail] =
        plan_atom_coalescing(?alloc, ?mods[0], 2, ?sec_base[0], 7, nil::*AtomPlan);
    if (sel dr.err) { ret 1; }
    val dup: *u32 = dr.ok;

    if (dup[0] != ATOM_OWNS) { ret 1; }
    if (dup[1] != 0)         { ret 1; }
    i = 2;
    for (i < 7) {
        if (dup[i] != ATOM_OWNS) { ret 1; }
        i = i + 1;
    }
    A.deallocate[u32](?alloc, dup, 7::usize);

    var secs2: [1]of.Section;
    lt_embed_sec(?secs2[0], rodata, of.SK_RODATA, ?abc[0], 4, 8, true);
    var mods3: [3]of.ObjectImage;
    mods3[0] = mods[0];
    mods3[1] = mods[1];
    mods3[2] = lt_image(?s, lt_name(?s, "m2"), ?secs2[0], 1, nil::*of.Symbol, 0, nil::*of.Relocation, 0);
    var base3: [3]u32;
    base3[0] = 0;
    base3[1] = 1;
    base3[2] = 7;
    val dr3: res[*u32, fail.Fail] =
        plan_atom_coalescing(?alloc, ?mods3[0], 3, ?base3[0], 8, nil::*AtomPlan);
    if (sel dr3.err) { ret 1; }
    val dup3: *u32 = dr3.ok;
    if (dup3[7] != 0) { ret 1; }
    A.deallocate[u32](?alloc, dup3, 8::usize);

    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_ABS64;
    relocs[0].sym     = of.SYMBOL_NONE;
    relocs[0].addend  = 0;
    var mods_r: [2]of.ObjectImage;
    mods_r[0] = mods[0];
    mods_r[1] = lt_image(?s, lt_name(?s, "m1r"), ?secs1[0], 1, nil::*of.Symbol, 0, ?relocs[0], 1);
    var base_r: [2]u32;
    base_r[0] = 0;
    base_r[1] = 1;
    val drr: res[*u32, fail.Fail] =
        plan_atom_coalescing(?alloc, ?mods_r[0], 2, ?base_r[0], 2, nil::*AtomPlan);
    if (sel drr.err) { ret 1; }
    val dupr: *u32 = drr.ok;
    if (dupr[1] != ATOM_OWNS) { ret 1; }
    A.deallocate[u32](?alloc, dupr, 2::usize);

    session.dnit(?s);
    ret 0;
}

test "mach.lang.be.linker.atom_plan:resolution_and_inert_gate" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val dup:   intern.StrId = lt_name(?s, "dup$u64");
    val other: intern.StrId = lt_name(?s, "other$u64");
    val text:  intern.StrId = lt_name(?s, ".text");
    if (dup == intern.STR_NIL || other == intern.STR_NIL || text == intern.STR_NIL) { ret 1; }

    var bytes0: [8]u8;
    var bytes1: [8]u8;
    var i:      u32 = 0;
    for (i < 8) {
        bytes0[i] = (0x10 + i)::u8;
        bytes1[i] = (0x80 + i)::u8;
        i         = i + 1;
    }
    var secs0: [1]of.Section;
    var secs1: [1]of.Section;
    secs0[0].name  = text;
    secs0[0].kind  = of.SK_TEXT;
    secs0[0].bytes = ?bytes0[0];
    secs0[0].len   = 8;
    secs0[0].align = 1;
    secs1[0].name  = text;
    secs1[0].kind  = of.SK_TEXT;
    secs1[0].bytes = ?bytes1[0];
    secs1[0].len   = 8;
    secs1[0].align = 1;

    val weak_flags: u32 =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    val strong_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var syms0:        [1]of.Symbol;
    var syms1:        [1]of.Symbol;
    syms0[0].name    = dup;
    syms0[0].section = of.section_id(0);
    syms0[0].offset  = 0;
    syms0[0].size    = 0;
    syms0[0].flags   = weak_flags;
    syms1[0].name    = dup;
    syms1[0].section = of.section_id(0);
    syms1[0].offset  = 0;
    syms1[0].size    = 0;
    syms1[0].flags   = weak_flags;

    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "m0"), ?secs0[0], 1, ?syms0[0], 1,
        nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "m1"), ?secs1[0], 1, ?syms1[0], 1,
        nil::*of.Relocation, 0);
    var bases: [2]u32;
    var roots: LinkRoots;

    var plan: AtomPlan;
    init_atom_plan(?plan);
    val disabled: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, false, ?roots, nil::*isa.IsaVTable, ?plan);
    if (sel disabled.err) { ret 1; }
    if (plan.active)      { ret 1; }

    val ww: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, ?roots, nil::*isa.IsaVTable, ?plan);
    if (sel ww.err)           { ret 1; }
    if (!plan.active)         { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    if (plan.drops[0].section != 1 || plan.drops[0].start != 0
        || plan.drops[0].end != 8 || plan.removed_bytes != 8) { ret 1; }
    if (module_definition_ref_is_dead(?mods[0], 0, dup, 0, ?bases[0], ?plan)
        || !module_definition_ref_is_dead(?mods[0], 1, dup, 0, ?bases[0], ?plan)) { ret 1; }
    free_atom_plan(?alloc, ?plan);

    syms1[0].flags = strong_flags;
    val ws: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, ?roots, nil::*isa.IsaVTable, ?plan);
    if (sel ws.err)                 { ret 1; }
    if (!plan.active)               { ret 1; }
    if (plan.drops[0].section != 0) { ret 1; }
    if (!module_definition_ref_is_dead(?mods[0], 0, dup, 0, ?bases[0], ?plan)
        || module_definition_ref_is_dead(?mods[0], 1, dup, 0, ?bases[0], ?plan)) { ret 1; }
    free_atom_plan(?alloc, ?plan);

    syms0[0].flags = strong_flags;
    syms1[0].flags = weak_flags;
    val sw: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, ?roots, nil::*isa.IsaVTable, ?plan);
    if (sel sw.err)                 { ret 1; }
    if (!plan.active)               { ret 1; }
    if (plan.drops[0].section != 1) { ret 1; }
    if (module_definition_ref_is_dead(?mods[0], 0, dup, 0, ?bases[0], ?plan)
        || !module_definition_ref_is_dead(?mods[0], 1, dup, 0, ?bases[0], ?plan)) { ret 1; }
    free_atom_plan(?alloc, ?plan);

    syms1[0].flags = strong_flags;
    val ss: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, ?roots, nil::*isa.IsaVTable, ?plan);
    if (!sel ss.err) { ret 1; }

    syms0[0].flags = weak_flags;
    syms1[0].flags = weak_flags;
    syms1[0].name  = other;
    val unique: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, ?roots, nil::*isa.IsaVTable, ?plan);
    if (sel unique.err) { ret 1; }
    if (plan.active)    { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.atom_plan:copy_remap_and_reloc_liveness" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:   session.Session       = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_11105: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_11105.err) { ret 1; }
    val x64: *isa.IsaVTable = lt_isa(?reg, "x86_64");
    if (x64 == nil) { ret 1; }

    val wa:       intern.StrId = lt_name(?s, "wa$u64");
    val wb:       intern.StrId = lt_name(?s, "wb$u64");
    val head:     intern.StrId = lt_name(?s, "head");
    val tail:     intern.StrId = lt_name(?s, "tail");
    val dead_ext: intern.StrId = lt_name(?s, "dead_ext");
    val live_ext: intern.StrId = lt_name(?s, "live_ext");
    val text:     intern.StrId = lt_name(?s, ".text");
    if (wa == intern.STR_NIL || wb == intern.STR_NIL || head == intern.STR_NIL
        || tail == intern.STR_NIL || dead_ext == intern.STR_NIL
        || live_ext == intern.STR_NIL || text == intern.STR_NIL) { ret 1; }

    var win_bytes:  [16]u8;
    var lose_bytes: [32]u8;
    var i:          u32 = 0;
    for (i < 16) {
        win_bytes[i] = (0x20 + i)::u8;
        i            = i + 1;
    }
    i = 0;
    for (i < 32) {
        lose_bytes[i] = (0x80 + i)::u8;
        i             = i + 1;
    }

    var win_sec:  [1]of.Section;
    var lose_sec: [1]of.Section;
    win_sec[0].name   = text;
    win_sec[0].kind   = of.SK_TEXT;
    win_sec[0].bytes  = ?win_bytes[0];
    win_sec[0].len    = 16;
    win_sec[0].align  = 8;
    lose_sec[0].name  = text;
    lose_sec[0].kind  = of.SK_TEXT;
    lose_sec[0].bytes = ?lose_bytes[0];
    lose_sec[0].len   = 32;
    lose_sec[0].align = 8;

    val weak_flags: u32 =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    val strong_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var win_syms:     [2]of.Symbol;
    win_syms[0].name    = wa;
    win_syms[0].section = of.section_id(0);
    win_syms[0].offset  = 0;
    win_syms[0].size    = 0;
    win_syms[0].flags   = weak_flags;
    win_syms[1].name    = wb;
    win_syms[1].section = of.section_id(0);
    win_syms[1].offset  = 8;
    win_syms[1].size    = 0;
    win_syms[1].flags   = weak_flags;

    var lose_syms: [6]of.Symbol;
    lose_syms[0].name    = head;
    lose_syms[0].section = of.section_id(0);
    lose_syms[0].offset  = 0;
    lose_syms[0].size    = 0;
    lose_syms[0].flags   = strong_flags;
    lose_syms[1].name    = wa;
    lose_syms[1].section = of.section_id(0);
    lose_syms[1].offset  = 8;
    lose_syms[1].size    = 0;
    lose_syms[1].flags   = weak_flags;
    lose_syms[2].name    = wb;
    lose_syms[2].section = of.section_id(0);
    lose_syms[2].offset  = 16;
    lose_syms[2].size    = 0;
    lose_syms[2].flags   = weak_flags;
    lose_syms[3].name    = tail;
    lose_syms[3].section = of.section_id(0);
    lose_syms[3].offset  = 24;
    lose_syms[3].size    = 0;
    lose_syms[3].flags   = strong_flags;
    lose_syms[4].name    = dead_ext;
    lose_syms[4].section = of.external_section();
    lose_syms[4].offset  = 0;
    lose_syms[4].size    = 0;
    lose_syms[4].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_FUNCTION;
    lose_syms[5].name    = live_ext;
    lose_syms[5].section = of.external_section();
    lose_syms[5].offset  = 0;
    lose_syms[5].size    = 0;
    lose_syms[5].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [2]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 10;
    relocs[0].kind    = of.RK_PC32;
    relocs[0].sym     = 4;
    relocs[0].addend  = -4;
    relocs[1].section = of.section_id(0);
    relocs[1].offset  = 26;
    relocs[1].kind    = of.RK_PC32;
    relocs[1].sym     = 5;
    relocs[1].addend  = -4;

    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "winners"), ?win_sec[0], 1,
        ?win_syms[0], 2, nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "losers"), ?lose_sec[0], 1,
        ?lose_syms[0], 6, ?relocs[0], 2);
    var bases: [2]u32;
    var roots: LinkRoots;
    var plan:  AtomPlan;
    init_atom_plan(?plan);
    val pr: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, ?roots, x64, ?plan);
    if (sel pr.err)           { ret 1; }
    if (!plan.active)         { ret 1; }
    if (plan.drop_count != 1) { ret 1; }

    if (plan.drops[0].section != 1 || plan.drops[0].start != 8
        || plan.drops[0].end != 24 || plan.drops[0].resume != 8
        || plan.sections[1].live_len != 16 || plan.removed_bytes != 16) { ret 1; }
    if (!atom_offset_dead(?plan, 1, 10) || !atom_offset_dead(?plan, 1, 20))    { ret 1; }
    if (atom_offset_dead(?plan, 1, 24) || atom_live_offset(?plan, 1, 24) != 8) { ret 1; }

    var copied: [16]u8;
    copy_live_section(?copied[0], ?lose_bytes[0], 32, ?plan, 1);
    i = 0;
    for (i < 8) {
        if (copied[i] != lose_bytes[i])          { ret 1; }
        if (copied[8 + i] != lose_bytes[24 + i]) { ret 1; }
        i = i + 1;
    }

    if (import_symbol_live(?mods[0], 2, dead_ext, ?bases[0], ?plan))         { ret 1; }
    if (has_function_branch_reloc(?mods[0], 2, dead_ext, ?bases[0], ?plan))  { ret 1; }
    if (!import_symbol_live(?mods[0], 2, live_ext, ?bases[0], ?plan))        { ret 1; }
    if (!has_function_branch_reloc(?mods[0], 2, live_ext, ?bases[0], ?plan)) { ret 1; }
    free_atom_plan(?alloc, ?plan);
    ret 0;
}

test "mach.lang.be.linker.atom_plan:shared_symbol_retains_loser" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:   session.Session       = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_11210: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_11210.err) { ret 1; }
    val x64: *isa.IsaVTable = lt_isa(?reg, "x86_64");
    if (x64 == nil) { ret 1; }

    val dup:     intern.StrId = lt_name(?s, "dup$u64");
    val local:   intern.StrId = lt_name(?s, "inside_label");
    val text:    intern.StrId = lt_name(?s, ".text");
    var a_bytes: [8]u8;
    var b_bytes: [8]u8;
    var a_sec:   [1]of.Section;
    var b_sec:   [1]of.Section;
    a_sec[0].name  = text;
    a_sec[0].kind  = of.SK_TEXT;
    a_sec[0].bytes = ?a_bytes[0];
    a_sec[0].len   = 8;
    a_sec[0].align = 1;
    b_sec[0].name  = text;
    b_sec[0].kind  = of.SK_TEXT;
    b_sec[0].bytes = ?b_bytes[0];
    b_sec[0].len   = 8;
    b_sec[0].align = 1;

    val weak_flags: u32 =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    var a_syms: [1]of.Symbol;
    var b_syms: [2]of.Symbol;
    a_syms[0].name    = dup;
    a_syms[0].section = of.section_id(0);
    a_syms[0].offset  = 0;
    a_syms[0].size    = 0;
    a_syms[0].flags   = weak_flags;
    b_syms[0].name    = dup;
    b_syms[0].section = of.section_id(0);
    b_syms[0].offset  = 0;
    b_syms[0].size    = 0;
    b_syms[0].flags   = weak_flags;
    b_syms[1].name    = local;
    b_syms[1].section = of.section_id(0);
    b_syms[1].offset  = 4;
    b_syms[1].size    = 0;
    b_syms[1].flags   = 0;

    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_PC32;
    relocs[0].sym     = 1;
    relocs[0].addend  = 0;

    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "a"), ?a_sec[0], 1, ?a_syms[0], 1,
        nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "b"), ?b_sec[0], 1, ?b_syms[0], 2,
        ?relocs[0], 1);
    var bases: [2]u32;
    var roots: LinkRoots;
    var plan:  AtomPlan;
    init_atom_plan(?plan);
    val pr: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, ?roots, x64, ?plan);
    if (sel pr.err)           { ret 1; }
    if (plan.active)          { ret 1; }
    if (plan.drop_count != 0) { ret 1; }
    free_atom_plan(?alloc, ?plan);

    init_atom_plan(?plan);
    mods[1] = lt_image(?s, lt_name(?s, "b"), ?b_sec[0], 1, ?b_syms[0], 2,
        nil::*of.Relocation, 0);
    val ur: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, ?roots, x64, ?plan);
    if (sel ur.err)           { ret 1; }
    if (!plan.active)         { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    free_atom_plan(?alloc, ?plan);
    ret 0;
}

test "mach.lang.be.linker.atom_plan:undescribed_kind_is_rejected_not_defaulted" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_11277: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_11277.err) { ret 2; }
    val x64: *isa.IsaVTable = lt_isa(?reg, "x86_64");
    if (x64 == nil) { ret 3; }

    val dup:        intern.StrId = lt_name(?s, "atomdup$u64");
    val text:       intern.StrId = lt_name(?s, ".text");
    val weak_flags: u32          =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;

    var winner_bytes: [8]u8;
    var loser_bytes:  [8]u8;
    var winner_sec:   [1]of.Section;
    var loser_sec:    [1]of.Section;
    winner_sec[0].name  = text;
    winner_sec[0].kind  = of.SK_TEXT;
    winner_sec[0].bytes = ?winner_bytes[0];
    winner_sec[0].len   = 8;
    winner_sec[0].align = 1;
    loser_sec[0].name   = text;
    loser_sec[0].kind   = of.SK_TEXT;
    loser_sec[0].bytes  = ?loser_bytes[0];
    loser_sec[0].len    = 8;
    loser_sec[0].align  = 1;

    var winner_sym: [1]of.Symbol;
    var loser_syms: [1]of.Symbol;
    winner_sym[0].name    = dup;
    winner_sym[0].section = of.section_id(0);
    winner_sym[0].offset  = 0;
    winner_sym[0].size    = 8;
    winner_sym[0].flags   = weak_flags;
    loser_syms[0].name    = dup;
    loser_syms[0].section = of.section_id(0);
    loser_syms[0].offset  = 0;
    loser_syms[0].size    = 8;
    loser_syms[0].flags   = weak_flags;

    var relocation: [1]of.Relocation;
    relocation[0].section = of.section_id(0);
    relocation[0].offset  = 0;
    relocation[0].kind    = of.RK_ABS64;
    relocation[0].sym     = 0;
    relocation[0].addend  = 0;
    relocation[0].sym2    = of.SYMBOL_NONE;
    relocation[0].pair    = 0;

    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "atomwinner"), ?winner_sec[0], 1,
        ?winner_sym[0], 1, nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "atomloser"), ?loser_sec[0], 1,
        ?loser_syms[0], 1, ?relocation[0], 1);

    var bases: [2]u32;
    var roots: LinkRoots;
    var plan:  AtomPlan;
    init_atom_plan(?plan);
    val described: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, ?roots, x64, ?plan);
    if (sel described.err) { ret 4; }
    free_atom_plan(?alloc, ?plan);

    relocation[0].kind = of.RK_PAGE21;
    init_atom_plan(?plan);
    val undescribed: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, ?roots, x64, ?plan);
    if (!sel undescribed.err)                                                       { ret 5; }
    if (!str_contains(fail.describe(undescribed.err), "catalog does not describe")) { ret 6; }
    free_atom_plan(?alloc, ?plan);

    relocation[0].kind    = of.RK_ABS64;
    relocation[0].section = of.section_id(9);
    init_atom_plan(?plan);
    val stray: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, ?roots, x64, ?plan);
    if (!sel stray.err)                                            { ret 7; }
    if (!str_contains(fail.describe(stray.err), "does not carry")) { ret 8; }
    free_atom_plan(?alloc, ?plan);
    ret 0;
}

test "mach.lang.be.linker.atom_plan:difference_subtrahend_retains_loser" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:   session.Session       = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_11348: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_11348.err) { ret 1; }
    val x64: *isa.IsaVTable = lt_isa(?reg, "x86_64");
    if (x64 == nil) { ret 1; }

    val dup:        intern.StrId = lt_name(?s, "difference$u64");
    val text:       intern.StrId = lt_name(?s, ".text");
    val data:       intern.StrId = lt_name(?s, ".data");
    val data_base:  intern.StrId = lt_name(?s, "data_base");
    val weak_flags: u32          =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    var winner_bytes: [8]u8;
    var loser_text:   [8]u8;
    var loser_data:   [4]u8;
    var winner_sec:   [1]of.Section;
    var loser_secs:   [2]of.Section;
    winner_sec[0].name  = text;
    winner_sec[0].kind  = of.SK_TEXT;
    winner_sec[0].bytes = ?winner_bytes[0];
    winner_sec[0].len   = 8;
    winner_sec[0].align = 1;
    loser_secs[0].name  = text;
    loser_secs[0].kind  = of.SK_TEXT;
    loser_secs[0].bytes = ?loser_text[0];
    loser_secs[0].len   = 8;
    loser_secs[0].align = 1;
    loser_secs[1].name  = data;
    loser_secs[1].kind  = of.SK_DATA;
    loser_secs[1].bytes = ?loser_data[0];
    loser_secs[1].len   = 4;
    loser_secs[1].align = 4;

    var winner_sym: [1]of.Symbol;
    var loser_syms: [3]of.Symbol;
    winner_sym[0].name    = dup;
    winner_sym[0].section = of.section_id(0);
    winner_sym[0].offset  = 0;
    winner_sym[0].size    = 8;
    winner_sym[0].flags   = weak_flags;
    loser_syms[0].name    = dup;
    loser_syms[0].section = of.section_id(0);
    loser_syms[0].offset  = 0;
    loser_syms[0].size    = 8;
    loser_syms[0].flags   = weak_flags;
    loser_syms[1].name    = text;
    loser_syms[1].section = of.section_id(0);
    loser_syms[1].offset  = 0;
    loser_syms[1].size    = 0;
    loser_syms[1].flags   = 0;
    loser_syms[2].name    = data_base;
    loser_syms[2].section = of.section_id(1);
    loser_syms[2].offset  = 0;
    loser_syms[2].size    = 0;
    loser_syms[2].flags   = 0;

    var relocation: [1]of.Relocation;
    relocation[0].section = of.section_id(1);
    relocation[0].offset  = 0;
    relocation[0].kind    = of.RK_DIFF32;
    relocation[0].sym     = 2;
    relocation[0].addend  = 0;
    relocation[0].sym2    = 1;
    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "winner"), ?winner_sec[0], 1,
        ?winner_sym[0], 1, nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "loser"), ?loser_secs[0], 2,
        ?loser_syms[0], 3, ?relocation[0], 1);
    if (unreferenced_local(?mods[1], 1)) { ret 1; }

    var bases: [2]u32;
    var roots: LinkRoots;
    var plan:  AtomPlan;
    init_atom_plan(?plan);
    val difference: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 3, true, ?roots, x64, ?plan);
    if (sel difference.err) { ret 1; }
    if (plan.active)        { ret 1; }

    relocation[0].kind = of.RK_ABS32;
    if (!unreferenced_local(?mods[1], 1)) { ret 1; }
    val ordinary: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 3, true, ?roots, x64, ?plan);
    if (sel ordinary.err)     { ret 1; }
    if (!plan.active)         { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    if (plan.drops[0].section != 1 || plan.drops[0].start != 0
        || plan.drops[0].end != 8) { ret 1; }
    free_atom_plan(?alloc, ?plan);
    ret 0;
}

test "mach.lang.be.linker.atom_plan:sized_extent_and_covering_symbol" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_11421: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_11421.err) { ret 1; }
    val x64: *isa.IsaVTable = lt_isa(?reg, "x86_64");
    if (x64 == nil) { ret 1; }

    val dup:        intern.StrId = lt_name(?s, "sized$u64");
    val cover:      intern.StrId = lt_name(?s, "cover");
    val text:       intern.StrId = lt_name(?s, ".text");
    val weak_flags: u32          =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;

    var a_bytes: [8]u8;
    var b_bytes: [16]u8;
    var i:       u32 = 0;
    for (i < 16) {
        b_bytes[i] = (0x50 + i)::u8;
        i          = i + 1;
    }
    var a_sec: [1]of.Section;
    var b_sec: [1]of.Section;
    a_sec[0].name  = text;
    a_sec[0].kind  = of.SK_TEXT;
    a_sec[0].bytes = ?a_bytes[0];
    a_sec[0].len   = 8;
    a_sec[0].align = 1;
    b_sec[0].name  = text;
    b_sec[0].kind  = of.SK_TEXT;
    b_sec[0].bytes = ?b_bytes[0];
    b_sec[0].len   = 16;
    b_sec[0].align = 1;

    var a_syms: [1]of.Symbol;
    var b_syms: [2]of.Symbol;
    a_syms[0].name    = dup;
    a_syms[0].section = of.section_id(0);
    a_syms[0].offset  = 0;
    a_syms[0].size    = 8;
    a_syms[0].flags   = weak_flags;
    b_syms[0].name    = dup;
    b_syms[0].section = of.section_id(0);
    b_syms[0].offset  = 0;
    b_syms[0].size    = 8;
    b_syms[0].flags   = weak_flags;
    b_syms[1].name    = cover;
    b_syms[1].section = of.section_id(0);
    b_syms[1].offset  = 16;
    b_syms[1].size    = 0;
    b_syms[1].flags   = 0;

    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_PC32;
    relocs[0].sym     = 1;
    relocs[0].addend  = 0;

    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "a"), ?a_sec[0], 1, ?a_syms[0], 1,
        nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "b"), ?b_sec[0], 1, ?b_syms[0], 2,
        ?relocs[0], 1);
    var bases: [2]u32;
    var roots: LinkRoots;
    var plan:  AtomPlan;
    init_atom_plan(?plan);
    val sized: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, ?roots, x64, ?plan);
    if (sel sized.err)        { ret 1; }
    if (!plan.active)         { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    if (plan.drops[0].start != 0 || plan.drops[0].end != 8
        || plan.sections[1].live_len != 8) { ret 1; }
    var copied: [8]u8;
    copy_live_section(?copied[0], ?b_bytes[0], 16, ?plan, 1);
    i = 0;
    for (i < 8) {
        if (copied[i] != b_bytes[8 + i]) { ret 1; }
        i = i + 1;
    }
    free_atom_plan(?alloc, ?plan);

    b_syms[0].offset = 8;
    b_syms[0].size   = 8;
    b_syms[1].offset = 0;
    b_syms[1].size   = 16;
    val covered: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, ?roots, x64, ?plan);
    if (sel covered.err) { ret 1; }
    if (plan.active)     { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.atom_plan:suffix_alignment_grid" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val dup:        intern.StrId = lt_name(?s, "aligned$u64");
    val head:       intern.StrId = lt_name(?s, "aligned_head");
    val tail:       intern.StrId = lt_name(?s, "aligned_tail");
    val text:       intern.StrId = lt_name(?s, ".text");
    val weak_flags: u32          =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    val strong_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var winner_bytes: [21]u8;
    var loser_bytes:  [64]u8;
    var winner_sec:   [1]of.Section;
    var loser_sec:    [1]of.Section;
    winner_sec[0].name  = text;
    winner_sec[0].kind  = of.SK_TEXT;
    winner_sec[0].bytes = ?winner_bytes[0];
    winner_sec[0].len   = 21;
    winner_sec[0].align = 16;
    loser_sec[0].name   = text;
    loser_sec[0].kind   = of.SK_TEXT;
    loser_sec[0].bytes  = ?loser_bytes[0];
    loser_sec[0].len    = 64;
    loser_sec[0].align  = 16;

    var winner_syms: [1]of.Symbol;
    var loser_syms:  [3]of.Symbol;
    winner_syms[0].name    = dup;
    winner_syms[0].section = of.section_id(0);
    winner_syms[0].offset  = 0;
    winner_syms[0].size    = 21;
    winner_syms[0].flags   = weak_flags;
    loser_syms[0].name     = head;
    loser_syms[0].section  = of.section_id(0);
    loser_syms[0].offset   = 0;
    loser_syms[0].size     = 16;
    loser_syms[0].flags    = strong_flags;
    loser_syms[1].name     = dup;
    loser_syms[1].section  = of.section_id(0);
    loser_syms[1].offset   = 16;
    loser_syms[1].size     = 21;
    loser_syms[1].flags    = weak_flags;
    loser_syms[2].name     = tail;
    loser_syms[2].section  = of.section_id(0);
    loser_syms[2].offset   = 48;
    loser_syms[2].size     = 16;
    loser_syms[2].flags    = strong_flags;

    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "winner"), ?winner_sec[0], 1,
        ?winner_syms[0], 1, nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "loser"), ?loser_sec[0], 1,
        ?loser_syms[0], 3, nil::*of.Relocation, 0);
    var bases: [2]u32;
    var roots: LinkRoots;
    var plan:  AtomPlan;
    init_atom_plan(?plan);
    val pr: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, ?roots, nil::*isa.IsaVTable, ?plan);
    if (sel pr.err)           { ret 1; }
    if (!plan.active)         { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    if (plan.drops[0].start != 16 || plan.drops[0].end != 37
        || plan.drops[0].resume != 21 || plan.sections[1].live_len != 48
        || plan.removed_bytes != 16) { ret 1; }
    if (atom_live_offset(?plan, 1, 48) != 32
        || (atom_live_offset(?plan, 1, 48) & 15) != 0) { ret 1; }
    free_atom_plan(?alloc, ?plan);
    ret 0;
}

