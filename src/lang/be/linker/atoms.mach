    b_secs[0].name  = text;
    b_secs[0].kind  = of.SK_TEXT;
    b_secs[0].bytes = ?b_text[0];
    b_secs[0].len   = 8;
    b_secs[0].align = 1;
    b_secs[1].name  = data;
    b_secs[1].kind  = of.SK_DATA;
    b_secs[1].bytes = ?b_data[0];
    b_secs[1].len   = 8;
    b_secs[1].align = 8;

    var a_syms: [1]of.Symbol;
    var b_syms: [2]of.Symbol;
    a_syms[0].name    = dup;
    a_syms[0].section = of.section_id(0);
    a_syms[0].offset  = 0;
    a_syms[0].size    = 0;
    a_syms[0].flags   = weak_flags;
    b_syms[0].name    = text;
    b_syms[0].section = of.section_id(0);
    b_syms[0].offset  = 0;
    b_syms[0].size    = 0;
    b_syms[0].flags   = 0;
    b_syms[1].name    = dup;
    b_syms[1].section = of.section_id(0);
    b_syms[1].offset  = 0;
    b_syms[1].size    = 0;
    b_syms[1].flags   = weak_flags;

    var refs: [1]of.Relocation;
    refs[0].section = of.section_id(1);
    refs[0].offset  = 0;
    refs[0].kind    = of.RK_ABS64;
    refs[0].sym     = 0;
    refs[0].addend  = 0;
    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "winner"), ?a_sec[0], 1, ?a_syms[0], 1,
        nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "carrier"), ?b_secs[0], 2, ?b_syms[0], 2,
        ?refs[0], 0);
    var bases: [2]u32;
    var roots: LinkRoots;
    var plan:  AtomPlan;
    init_atom_plan(?plan);
    val inert_anchor: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 3, true, ?roots, x64, ?plan);
    if (sel inert_anchor.err) { ret 1; }
    if (!plan.active)         { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    if (plan.drops[0].section != 1 || plan.drops[0].start != 0
        || plan.drops[0].end != 8) { ret 1; }
    free_atom_plan(?alloc, ?plan);

    mods[1].reloc_count = 1;
    val referenced_anchor: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 3, true, ?roots, x64, ?plan);
    if (sel referenced_anchor.err) { ret 1; }
    if (plan.active)               { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.atom_plan:debug_crossing_does_not_retain_loser" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:   session.Session       = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_11640: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_11640.err) { ret 1; }
    val x64: *isa.IsaVTable = lt_isa(?reg, "x86_64");
    if (x64 == nil) { ret 1; }

    val dup:        intern.StrId = lt_name(?s, "cross$u64");
    val base:       intern.StrId = lt_name(?s, "section_base");
    val tail:       intern.StrId = lt_name(?s, "tail");
    val text:       intern.StrId = lt_name(?s, ".text");
    val info:       intern.StrId = lt_name(?s, ".debug_info");
    val weak_flags: u32          =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    val strong_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var a_bytes:      [8]u8;
    var b_bytes:      [24]u8;
    var b_info:       [8]u8;
    var a_sec:        [1]of.Section;
    var b_secs:       [2]of.Section;
    a_sec[0].name   = text;
    a_sec[0].kind   = of.SK_TEXT;
    a_sec[0].bytes  = ?a_bytes[0];
    a_sec[0].len    = 8;
    a_sec[0].align  = 1;
    b_secs[0].name  = text;
    b_secs[0].kind  = of.SK_TEXT;
    b_secs[0].bytes = ?b_bytes[0];
    b_secs[0].len   = 24;
    b_secs[0].align = 1;
    b_secs[1].name  = info;
    b_secs[1].kind  = of.SK_DEBUG;
    b_secs[1].bytes = ?b_info[0];
    b_secs[1].len   = 8;
    b_secs[1].align = 1;

    var a_syms: [1]of.Symbol;
    var b_syms: [3]of.Symbol;
    a_syms[0].name    = dup;
    a_syms[0].section = of.section_id(0);
    a_syms[0].offset  = 0;
    a_syms[0].size    = 8;
    a_syms[0].flags   = weak_flags;
    b_syms[0].name    = base;
    b_syms[0].section = of.section_id(0);
    b_syms[0].offset  = 0;
    b_syms[0].size    = 0;
    b_syms[0].flags   = 0;
    b_syms[1].name    = dup;
    b_syms[1].section = of.section_id(0);
    b_syms[1].offset  = 8;
    b_syms[1].size    = 8;
    b_syms[1].flags   = weak_flags;
    b_syms[2].name    = tail;
    b_syms[2].section = of.section_id(0);
    b_syms[2].offset  = 16;
    b_syms[2].size    = 8;
    b_syms[2].flags   = strong_flags;

    var reloc: [1]of.Relocation;
    reloc[0].section = of.section_id(1);
    reloc[0].offset  = 0;
    reloc[0].kind    = of.RK_ABS64;
    reloc[0].sym     = 0;
    reloc[0].addend  = 16;
    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "winner"), ?a_sec[0], 1, ?a_syms[0], 1,
        nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "loser"), ?b_secs[0], 2, ?b_syms[0], 3,
        ?reloc[0], 1);
    var bases: [2]u32;
    var roots: LinkRoots;
    var plan:  AtomPlan;
    init_atom_plan(?plan);
    val from_debug: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 3, true, ?roots, x64, ?plan);
    if (sel from_debug.err)   { ret 1; }
    if (!plan.active)         { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    free_atom_plan(?alloc, ?plan);

    b_secs[1].kind = of.SK_TEXT;
    val from_text: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 3, true, ?roots, x64, ?plan);
    if (sel from_text.err) { ret 1; }
    if (plan.active)       { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.atom_plan:anchor_addend_crossing_retains_loser" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:   session.Session       = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_11709: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_11709.err) { ret 1; }
    val x64:   *isa.IsaVTable = lt_isa(?reg, "x86_64");
    val arm64: *isa.IsaVTable = lt_isa(?reg, "aarch64");
    if (x64 == nil || arm64 == nil) { ret 1; }

    val dup:        intern.StrId = lt_name(?s, "cross$u64");
    val base:       intern.StrId = lt_name(?s, "section_base");
    val tail:       intern.StrId = lt_name(?s, "tail");
    val text:       intern.StrId = lt_name(?s, ".text");
    val data:       intern.StrId = lt_name(?s, ".data");
    val carrier:    intern.StrId = lt_name(?s, "carrier");
    val weak_flags: u32          =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    val strong_flags: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var a_bytes:      [8]u8;
    var b_bytes:      [24]u8;
    var b_data:       [4]u8;
    var a_sec:        [1]of.Section;
    var b_secs:       [2]of.Section;
    a_sec[0].name   = text;
    a_sec[0].kind   = of.SK_TEXT;
    a_sec[0].bytes  = ?a_bytes[0];
    a_sec[0].len    = 8;
    a_sec[0].align  = 1;
    b_secs[0].name  = text;
    b_secs[0].kind  = of.SK_TEXT;
    b_secs[0].bytes = ?b_bytes[0];
    b_secs[0].len   = 24;
    b_secs[0].align = 1;
    b_secs[1].name  = data;
    b_secs[1].kind  = of.SK_DATA;
    b_secs[1].bytes = ?b_data[0];
    b_secs[1].len   = 4;
    b_secs[1].align = 4;

    var a_syms: [1]of.Symbol;
    var b_syms: [4]of.Symbol;
    a_syms[0].name    = dup;
    a_syms[0].section = of.section_id(0);
    a_syms[0].offset  = 0;
    a_syms[0].size    = 8;
    a_syms[0].flags   = weak_flags;
    b_syms[0].name    = base;
    b_syms[0].section = of.section_id(0);
    b_syms[0].offset  = 0;
    b_syms[0].size    = 0;
    b_syms[0].flags   = 0;
    b_syms[1].name    = dup;
    b_syms[1].section = of.section_id(0);
    b_syms[1].offset  = 8;
    b_syms[1].size    = 8;
    b_syms[1].flags   = weak_flags;
    b_syms[2].name    = tail;
    b_syms[2].section = of.section_id(0);
    b_syms[2].offset  = 16;
    b_syms[2].size    = 8;
    b_syms[2].flags   = strong_flags;
    b_syms[3].name    = carrier;
    b_syms[3].section = of.section_id(1);
    b_syms[3].offset  = 0;
    b_syms[3].size    = 4;
    b_syms[3].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var reloc: [1]of.Relocation;
    reloc[0].section = of.section_id(0);
    reloc[0].offset  = 0;
    reloc[0].kind    = of.RK_ABS64;
    reloc[0].sym     = 0;
    reloc[0].addend  = 16;
    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "winner"), ?a_sec[0], 1, ?a_syms[0], 1,
        nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "loser"), ?b_secs[0], 2, ?b_syms[0], 4,
        ?reloc[0], 1);
    var bases: [2]u32;
    var roots: LinkRoots;
    roots.exports = true;
    var plan: AtomPlan;
    init_atom_plan(?plan);
    val crossing: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 3, true, ?roots, x64, ?plan);
    if (sel crossing.err) { ret 1; }
    if (plan.active)      { ret 1; }

    reloc[0].addend = 4;
    val same_side: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 3, true, ?roots, x64, ?plan);
    if (sel same_side.err)    { ret 1; }
    if (!plan.active)         { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    free_atom_plan(?alloc, ?plan);

    b_bytes[3]      = 0xE8;
    reloc[0].offset = 4;
    reloc[0].kind   = of.RK_PC32;
    reloc[0].addend = -4;
    val pc_local: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 3, true, ?roots, x64, ?plan);
    if (sel pc_local.err) { ret 1; }
    if (plan.active)      { ret 1; }
    reloc[0].sym  = 2;
    reloc[0].kind = of.RK_PLT32;

    val parsed_plt_data: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 1, ?bases[0], 3, true, ?roots, x64, ?plan);
    if (sel parsed_plt_data.err) { ret 1; }
    if (plan.active)             { ret 1; }

    reloc[0].sym    = 0;
    reloc[0].addend = 3;
    val parsed_plt_trailing: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 1, ?bases[0], 3, true, ?roots, x64, ?plan);
    if (sel parsed_plt_trailing.err) { ret 1; }
    if (plan.active)                 { ret 1; }

    reloc[0].sym    = 2;
    reloc[0].addend = -4;
    reloc[0].kind   = of.RK_PC32;
    val codegen_pc: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 2, ?bases[0], 3, true, ?roots, x64, ?plan);
    if (sel codegen_pc.err)   { ret 1; }
    if (!plan.active)         { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    free_atom_plan(?alloc, ?plan);

    val arm_global: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 2, ?bases[0], 3, true, ?roots, arm64, ?plan);
    if (sel arm_global.err) { ret 1; }
    if (plan.active)        { ret 1; }

    reloc[0].section = of.section_id(1);
    reloc[0].offset  = 0;
    reloc[0].kind    = of.RK_PC32;
    val data_pc: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 2, ?bases[0], 3, true, ?roots, x64, ?plan);
    if (sel data_pc.err) { ret 1; }
    if (plan.active)     { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.atom_plan:rv64_plt_pair_boundary" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:   session.Session       = sr.ok;
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_11825: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_11825.err) { ret 1; }
    val x64:   *isa.IsaVTable = lt_isa(?reg, "x86_64");
    val arm64: *isa.IsaVTable = lt_isa(?reg, "aarch64");
    val rv64:  *isa.IsaVTable = lt_isa(?reg, "riscv64");
    if (x64 == nil || arm64 == nil || rv64 == nil) { ret 1; }

    val dup:        intern.StrId = lt_name(?s, "rvpair$u64");
    val ext:        intern.StrId = lt_name(?s, "callee");
    val text:       intern.StrId = lt_name(?s, ".text");
    val weak_flags: u32          =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;
    var a_bytes: [8]u8;
    var b_bytes: [16]u8;
    var a_sec:   [1]of.Section;
    var b_sec:   [1]of.Section;
    a_sec[0].name  = text;
    a_sec[0].kind  = of.SK_TEXT;
    a_sec[0].bytes = ?a_bytes[0];
    a_sec[0].len   = 8;
    a_sec[0].align = 1;
    b_sec[0].name  = text;
    b_sec[0].kind  = of.SK_TEXT;
    b_sec[0].bytes = ?b_bytes[0];
    b_sec[0].len   = 16;
    b_sec[0].align = 1;

    var a_syms: [1]of.Symbol;
    var b_syms: [2]of.Symbol;
    a_syms[0].name    = dup;
    a_syms[0].section = of.section_id(0);
    a_syms[0].offset  = 0;
    a_syms[0].size    = 8;
    a_syms[0].flags   = weak_flags;
    b_syms[0].name    = dup;
    b_syms[0].section = of.section_id(0);
    b_syms[0].offset  = 8;
    b_syms[0].size    = 8;
    b_syms[0].flags   = weak_flags;
    b_syms[1].name    = ext;
    b_syms[1].section = of.external_section();
    b_syms[1].offset  = 0;
    b_syms[1].size    = 0;
    b_syms[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_FUNCTION;

    var reloc: [1]of.Relocation;
    reloc[0].section = of.section_id(0);
    reloc[0].offset  = 4;
    reloc[0].kind    = of.RK_PLT32;
    reloc[0].sym     = 1;
    reloc[0].addend  = 0;
    var mods: [2]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "winner"), ?a_sec[0], 1, ?a_syms[0], 1,
        nil::*of.Relocation, 0);
    mods[1] = lt_image(?s, lt_name(?s, "loser"), ?b_sec[0], 1, ?b_syms[0], 2,
        ?reloc[0], 1);
    var bases: [2]u32;
    var roots: LinkRoots;
    var plan:  AtomPlan;
    init_atom_plan(?plan);

    val x: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, ?roots, x64, ?plan);
    if (sel x.err)            { ret 1; }
    if (!plan.active)         { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    free_atom_plan(?alloc, ?plan);

    val arm: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, ?roots, arm64, ?plan);
    if (sel arm.err)          { ret 1; }
    if (!plan.active)         { ret 1; }
    if (plan.drop_count != 1) { ret 1; }
    free_atom_plan(?alloc, ?plan);

    val rv: err[fail.Fail] =
        build_atom_plan(?s, ?mods[0], 2, 0, ?bases[0], 2, true, ?roots, rv64, ?plan);
    if (sel rv.err)  { ret 1; }
    if (plan.active) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.import_symbol_live:debug_references_do_not_count" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val registered: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel registered.err) { ret 1; }
    val x64: *isa.IsaVTable = lt_isa(?reg, "x86_64");
    if (x64 == nil) { ret 1; }

    val entry: intern.StrId = lt_name(?s, "_start");
    val ext:   intern.StrId = lt_name(?s, "described_only");
    var text:  [16]u8;
    var info:  [8]u8;
    var secs:  [2]of.Section;
    secs[0].name  = lt_name(?s, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text[0];
    secs[0].len   = 16;
    secs[0].align = 1;
    secs[1].name  = lt_name(?s, ".debug_info");
    secs[1].kind  = of.SK_DEBUG;
    secs[1].bytes = ?info[0];
    secs[1].len   = 8;
    secs[1].align = 1;
    var syms: [3]of.Symbol;
    syms[0].name    = entry;
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 8;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = lt_name(?s, "unreached");
    syms[1].section = of.section_id(0);
    syms[1].offset  = 8;
    syms[1].size    = 8;
    syms[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[2].name    = ext;
    syms[2].section = of.external_section();
    syms[2].offset  = 0;
    syms[2].size    = 0;
    syms[2].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_FUNCTION;
    var relocs: [2]of.Relocation;
    relocs[0].section = of.section_id(1);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_ABS64;
    relocs[0].sym     = 2;
    relocs[0].addend  = 0;
    relocs[0].sym2    = of.SYMBOL_NONE;
    relocs[1].section = of.section_id(0);
    relocs[1].offset  = 8;
    relocs[1].kind    = of.RK_ABS64;
    relocs[1].sym     = 2;
    relocs[1].addend  = 0;
    relocs[1].sym2    = of.SYMBOL_NONE;
    var mods: [1]of.ObjectImage;
    mods[0] = lt_image(?s, lt_name(?s, "m"), ?secs[0], 2, ?syms[0], 3, ?relocs[0], 2);

    var roots: LinkRoots;
    roots.entry = entry;
    var bases: [1]u32;
    var plan:  AtomPlan;
    init_atom_plan(?plan);
    val dead_text: err[fail.Fail] = build_atom_plan(?s, ?mods[0], 1, 1, ?bases[0], 2, true, ?roots, x64, ?plan);
    if (sel dead_text.err)                                      { ret 2; }
    if (!plan.active)                                           { ret 3; }
    if (import_symbol_live(?mods[0], 1, ext, ?bases[0], ?plan)) { ret 4; }
    free_atom_plan(?alloc, ?plan);

    relocs[1].offset = 0;
    val live_text: err[fail.Fail] = build_atom_plan(?s, ?mods[0], 1, 1, ?bases[0], 2, true, ?roots, x64, ?plan);
    if (sel live_text.err)                                       { ret 5; }
    if (!import_symbol_live(?mods[0], 1, ext, ?bases[0], ?plan)) { ret 6; }
    free_atom_plan(?alloc, ?plan);
    ret 0;
}
