# the linker's tests that build a project through the driver
use A: std.allocator;
use std.allocator.page;
use std.collections.vector.Vector;
use fs: std.filesystem;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mach.lang.driver;
use mach.lang.driver.project;
use mach.lang.fail;
use mach.lang.manifest;
use output_testing: mach.lang.output.testing;
use mach.lang.session;
use catalog_artifact:  mach.lang.target.catalog.artifact;
use catalog_subsystem: mach.lang.target.catalog.subsystem;
use target_of:         mach.lang.target.of;
use mach.lang.target.of.bin;
use mach.lang.toolchain;

use mach.lang.driver.tests.testing.ut_planned_link_images;
use mach.lang.driver.tests.testing.ut_run_codegen_ok;
use mach.lang.driver.tests.testing.ut_scaffold_m;
use mach.lang.driver.tests.testing.ut_target_sel;

#[testing]
fun t_manifest_stack_pe() str {
    ret "[project]\nmach = \">=5\"\nid = \"stk\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.win]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\nstack_reserve = 8388608\nstack_commit = 8192\n\n[profile.debug]\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.stk]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.out}/bin/stk.exe\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

test stack_reserve__reaches_the_linked_pe {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[symbol(\"mainCRTStartup\")]\nfun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, t_manifest_stack_pe(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val root: str = root_r.ok;

    var bad:        i32                             = 0;
    var tsel_18542: manifest.Selectors              = ut_target_sel("win");
    val pr:         res[project.Project, fail.Fail] = driver.build_project(?s, root, ?tsel_18542);
    if (sel pr.err) { bad = 4; }
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        if (ut_run_codegen_ok(?p) != 0) { bad = 5; }
        or {
            if (p.target.target.stack_reserve != 8388608) { bad = 6; }
            or (p.target.target.stack_commit != 8192)     { bad = 7; }
            or {
                var outcome_r: u64 = 0;
                var com:       u64 = 0;
                if (!t_pe_stack_of(?p, ?outcome_r, ?com)) { bad = 8; }
                or (outcome_r != 8388608)                 { bad = 9; }
                or (com != 8192)                          { bad = 10; }
            }
        }
        project.dnit_project(?p);
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

#[testing]
fun t_pe_stack_of(p: *project.Project, outcome_r: *u64, com: *u64) bool {
    val alloc: *A.Allocator = p.alloc;
    if (p.emit_len == 0) { ret false; }

    val ir: res[*target_of.ObjectImage, A.Error] = A.allocate[target_of.ObjectImage](alloc, p.emit_len::usize);
    if (sel ir.err) { ret false; }
    val images:  *target_of.ObjectImage = ir.ok;
    var missing: bool                   = false;
    var i:       u32                    = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, (p.topo[i])::u32);
        if (m.object_image == nil) { missing = true; }
        or                         { images[i] = @m.object_image; }
        i = i + 1;
    }

    val tf_r: res[output_testing.Output, fail.Fail] = output_testing.create(alloc, "stk_pe");
    if (sel tf_r.err) {
        A.deallocate[target_of.ObjectImage](alloc, images, p.emit_len::usize);
        ret false;
    }
    var tf: output_testing.Output = tf_r.ok;
    fin { output_testing.dnit(?tf); }

    var linked: bool = false;
    if (!missing) {
        val lr: err[fail.Fail] = ut_planned_link_images(p.s, ?p.target, images,
            p.emit_len, nil::*target_of.DynLib, 0, output_testing.path(?tf)::*u8, "stkprobe"::*u8,
            catalog_artifact.EXECUTABLE, false, target_of.image_options_default(catalog_subsystem.CONSOLE));
        linked = sel lr.ok;
    }
    A.deallocate[target_of.ObjectImage](alloc, images, p.emit_len::usize);
    if (!linked) { ret false; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, output_testing.path(?tf));

    if (sel rb.err) { ret false; }
    val img: Vector[u8] = rb.ok;

    var ok: bool = false;
    if (img.len > 0x100) {
        val pe_off: usize = bin.read_u32_le(img.data, 0x3C)::usize;
        val oh:     usize = pe_off + 24;
        if (oh + 96 + 8 <= img.len) {
            @outcome_r = bin.read_u64_le(img.data, oh + 72);
            @com       = bin.read_u64_le(img.data, oh + 80);
            ok         = true;
        }
    }
    ret ok;
}
