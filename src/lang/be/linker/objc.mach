# objc_msgSend selector stubs (#4256). clang on arm64 compiles a message send to
# a call of `_objc_msgSend$<selector>`, a stub the linker is expected to make:
# it loads the selector reference from __objc_selrefs and jumps to objc_msgSend.
# the link appends one synthetic input that defines a stub for every such name
# the inputs leave undefined, beside a selector reference and a method name
# string for each distinct selector, so the reference resolves and dead-strips
# like any definition. the stub reaches objc_msgSend through its GOT slot, so the
# import is attributed the way a plain `objc_msgSend` call is
use std.collections.map;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;

use mach.lang.be.obj;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.session;
use lang_target: mach.lang.target;
use mach.lang.target.isa;
use target_of: mach.lang.target.of;
use mach.lang.target.of.bin;

use mach.lang.be.linker.common.join2;
use mach.lang.be.linker.mode.LINK_RELOCATABLE;
use mach.lang.be.linker.mode.LinkMode;
use mach.lang.be.linker.resolve.is_undefined_extern;

val STUB_ARM64_SIZE: u32 = 32;
val STUB_X64_SIZE:   u32 = 16;

# the section carrying the stubs, the selector references and the method names
val STUBS_SECTION:    str = "__objc_stubs";
val SELREFS_SECTION:  str = "__objc_selrefs";
val METHNAME_SECTION: str = "__objc_methname";

val ARM64_ADRP_X1:     u32 = 0x90000001;
val ARM64_LDR_X1_X1:   u32 = 0xF9400021;
val ARM64_ADRP_X16:    u32 = 0x90000010;
val ARM64_LDR_X16_X16: u32 = 0xF9400210;
val ARM64_BR_X16:      u32 = 0xD61F0200;
val ARM64_BRK_1:       u32 = 0xD4200020;

# whether this link makes selector stubs at all: a Mach-O executable or shared
# image for an instruction set the stubs are written for
fun makes_objc_stubs(tgt: *lang_target.Target, mode: LinkMode) bool {
    if (mode == LINK_RELOCATABLE)                         { ret false; }
    if (tgt.of == nil || tgt.of.id != target_of.OF_MACHO) { ret false; }
    ret tgt.arch_id == isa.ARCH_AARCH64 || tgt.arch_id == isa.ARCH_X86_64;
}

fun stub_size(tgt: *lang_target.Target) u32 {
    if (tgt.arch_id == isa.ARCH_AARCH64) { ret STUB_ARM64_SIZE; }
    ret STUB_X64_SIZE;
}

# the distinct selector stubs the inputs leave undefined, in first-use order.
# `names` is filled only when it is not nil, so one walk counts and the next fills
fun collect_stub_names(s: *session.Session, modules: *target_of.ObjectImage, module_count: u32,
    stub_prefix: str, names: *intern.StrId, count: *u32) err[fail.Fail] {
    var seen: map.Map[intern.StrId, u32] = map.init[intern.StrId, u32](s.alloc);
    fin { map.dnit[intern.StrId, u32](?seen); }
    var n: u32 = 0;
    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *target_of.Symbol = ?modules[m].symbols[sy];
            sy = sy + 1;
            if (!is_undefined_extern(sym)) { cnt; }
            val text: str = bin.resolve_name(?s.interner, sym.name);
            if (text == nil || !str_starts_with(text, stub_prefix)) { cnt; }
            if (str_len(text) == str_len(stub_prefix))              { cnt; }
            if (map.contains[intern.StrId, u32](?seen, ?sym.name))  { cnt; }
            val ins: res[bool, A.Error] = map.insert[intern.StrId, u32](?seen, sym.name, n);
            if (sel ins.err)  { ret err[fail.Fail].err{fail.refused(ins.err)}; }
            if (names != nil) { names[n] = sym.name; }
            n = n + 1;
        }
        m = m + 1;
    }
    @count = n;
    ret err[fail.Fail].ok{};
}

fun stub_code(tgt: *lang_target.Target, code: *u8, at: u32) {
    if (tgt.arch_id == isa.ARCH_AARCH64) {
        bin.write_u32_le(code, (at + 0)::usize, ARM64_ADRP_X1);
        bin.write_u32_le(code, (at + 4)::usize, ARM64_LDR_X1_X1);
        bin.write_u32_le(code, (at + 8)::usize, ARM64_ADRP_X16);
        bin.write_u32_le(code, (at + 12)::usize, ARM64_LDR_X16_X16);
        bin.write_u32_le(code, (at + 16)::usize, ARM64_BR_X16);
        bin.write_u32_le(code, (at + 20)::usize, ARM64_BRK_1);
        bin.write_u32_le(code, (at + 24)::usize, ARM64_BRK_1);
        bin.write_u32_le(code, (at + 28)::usize, ARM64_BRK_1);
        ret;
    }
    # mov rsi, [rip + selref]; jmp [rip + objc_msgSend@GOT]; int3
    code[at + 0]  = 0x48;
    code[at + 1]  = 0x8B;
    code[at + 2]  = 0x35;
    code[at + 7]  = 0xFF;
    code[at + 8]  = 0x25;
    code[at + 13] = 0xCC;
    code[at + 14] = 0xCC;
    code[at + 15] = 0xCC;
}

fun stub_relocations(tgt: *lang_target.Target, out: *target_of.ObjectImage, at: u32, selref: u32,
    selrefs_sym: u32, msgsend_sym: u32) err[fail.Fail] {
    val text:   target_of.SectionId = target_of.section_id(0);
    val addend: i64                 = selref::i64 * 8;
    if (tgt.arch_id == isa.ARCH_AARCH64) {
        val a: err[fail.Fail] = target_of.add_relocation(out, target_of.Relocation{section: text, offset: at,
            kind: target_of.RK_PAGE21, sym: selrefs_sym, addend: addend});
        if (sel a.err) { ret a; }
        val b: err[fail.Fail] = target_of.add_relocation(out, target_of.Relocation{section: text, offset: at + 4,
            kind: target_of.RK_LDST64_LO12, sym: selrefs_sym, addend: addend});
        if (sel b.err) { ret b; }
        val c: err[fail.Fail] = target_of.add_relocation(out, target_of.Relocation{section: text, offset: at + 8,
            kind: target_of.RK_GOT_PAGE21, sym: msgsend_sym});
        if (sel c.err) { ret c; }
        ret target_of.add_relocation(out, target_of.Relocation{section: text, offset: at + 12,
            kind: target_of.RK_GOT_LO12, sym: msgsend_sym});
    }
    val d: err[fail.Fail] = target_of.add_relocation(out, target_of.Relocation{section: text, offset: at + 3,
        kind: target_of.RK_PC32, sym: selrefs_sym, addend: addend - 4, inst_end: 4});
    if (sel d.err) { ret d; }
    ret target_of.add_relocation(out, target_of.Relocation{section: text, offset: at + 9,
        kind: target_of.RK_GOTPCREL, sym: msgsend_sym, addend: -4, inst_end: 4});
}

fun install_section(s: *session.Session, out: *target_of.ObjectImage, name: str, kind: target_of.SectionKind,
    bytes: *u8, len: u32, align: u32) res[u32, fail.Fail] {
    var sec: target_of.Section;
    sec.name  = intern_name(s, name);
    sec.kind  = kind;
    sec.bytes = bytes;
    sec.len   = len;
    sec.align = align;
    sec.flags = 0;
    ret target_of.section_install(out, ?sec);
}

fun intern_name(s: *session.Session, name: str) intern.StrId {
    val r: res[intern.StrId, A.Error] = intern.intern(?s.interner, name);
    if (sel r.err) { ret intern.STR_NIL; }
    ret r.ok;
}

fun build_stub_image(s: *session.Session, tgt: *lang_target.Target, out: *target_of.ObjectImage,
    names: *intern.StrId, count: u32, stub_prefix: str, msgsend: intern.StrId) err[fail.Fail] {
    val alloc:  *A.Allocator = s.alloc;
    val size:   u32          = stub_size(tgt);
    val prefix: usize        = str_len(stub_prefix);

    var strings: u32 = 0;
    var i:       u32 = 0;
    for (i < count) {
        val text: str = bin.resolve_name(?s.interner, names[i]);
        strings = strings + (str_len(text) - prefix)::u32 + 1;
        i       = i + 1;
    }

    val code_r: res[*u8, A.Error] = A.zallocate[u8](alloc, (count * size)::usize);
    if (sel code_r.err) { ret err[fail.Fail].err{fail.refused(code_r.err)}; }
    val code:   *u8               = code_r.ok;
    val refs_r: res[*u8, A.Error] = A.zallocate[u8](alloc, (count * 8)::usize);
    if (sel refs_r.err) {
        A.deallocate[u8](alloc, code, (count * size)::usize);
        ret err[fail.Fail].err{fail.refused(refs_r.err)};
    }
    val refs:    *u8               = refs_r.ok;
    val chars_r: res[*u8, A.Error] = A.zallocate[u8](alloc, strings::usize);
    if (sel chars_r.err) {
        A.deallocate[u8](alloc, code, (count * size)::usize);
        A.deallocate[u8](alloc, refs, (count * 8)::usize);
        ret err[fail.Fail].err{fail.refused(chars_r.err)};
    }
    val chars: *u8 = chars_r.ok;

    var code_align: u32 = 4;
    if (tgt.arch_id != isa.ARCH_AARCH64) { code_align = 16; }
    val text_r: res[u32, fail.Fail] = install_section(s, out, STUBS_SECTION, target_of.SK_TEXT,
        code, count * size, code_align);
    if (sel text_r.err) {
        A.deallocate[u8](alloc, refs, (count * 8)::usize);
        A.deallocate[u8](alloc, chars, strings::usize);
        ret err[fail.Fail].err{text_r.err};
    }
    val refs_sec_r: res[u32, fail.Fail] = install_section(s, out, SELREFS_SECTION, target_of.SK_DATA,
        refs, count * 8, 8);
    if (sel refs_sec_r.err) {
        A.deallocate[u8](alloc, chars, strings::usize);
        ret err[fail.Fail].err{refs_sec_r.err};
    }
    val chars_sec_r: res[u32, fail.Fail] = install_section(s, out, METHNAME_SECTION, target_of.SK_RODATA,
        chars, strings, 1);
    if (sel chars_sec_r.err) { ret err[fail.Fail].err{chars_sec_r.err}; }

    # the selector references and the method names are reached through one
    # symbol each, by offset, so the object carries three symbols beside the stubs
    var sym: target_of.Symbol;
    i = 0;
    for (i < count) {
        sym          = target_of.Symbol{};
        sym.name     = names[i];
        sym.section  = target_of.section_id(text_r.ok);
        sym.offset   = i * size;
        sym.size     = size;
        sym.flags    = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION | target_of.SYM_OBJ_FLAG_HIDDEN;
        sym.fallback = target_of.SYMBOL_NONE;
        sym.align    = code_align;
        val added: res[u32, fail.Fail] = target_of.symbol_add(out, sym);
        if (sel added.err) { ret err[fail.Fail].err{added.err}; }
        i = i + 1;
    }
    val refs_sym:  u32 = count;
    val chars_sym: u32 = count + 1;
    val send_sym:  u32 = count + 2;
    sym          = target_of.Symbol{};
    sym.name     = intern_name(s, "<objc-selector-references>");
    sym.section  = target_of.section_id(refs_sec_r.ok);
    sym.size     = count * 8;
    sym.flags    = target_of.SYM_OBJ_FLAG_OBJECT;
    sym.fallback = target_of.SYMBOL_NONE;
    sym.align    = 8;
    val refs_added: res[u32, fail.Fail] = target_of.symbol_add(out, sym);
    if (sel refs_added.err) { ret err[fail.Fail].err{refs_added.err}; }
    sym          = target_of.Symbol{};
    sym.name     = intern_name(s, "<objc-method-names>");
    sym.section  = target_of.section_id(chars_sec_r.ok);
    sym.size     = strings;
    sym.flags    = target_of.SYM_OBJ_FLAG_OBJECT;
    sym.fallback = target_of.SYMBOL_NONE;
    sym.align    = 1;
    val chars_added: res[u32, fail.Fail] = target_of.symbol_add(out, sym);
    if (sel chars_added.err) { ret err[fail.Fail].err{chars_added.err}; }
    sym          = target_of.Symbol{};
    sym.name     = msgsend;
    sym.section  = target_of.external_section();
    sym.flags    = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_EXTERN;
    sym.fallback = target_of.SYMBOL_NONE;
    sym.align    = 1;
    val send_added: res[u32, fail.Fail] = target_of.symbol_add(out, sym);
    if (sel send_added.err) { ret err[fail.Fail].err{send_added.err}; }

    var at: u32 = 0;
    i = 0;
    for (i < count) {
        val text: str = bin.resolve_name(?s.interner, names[i]);
        val len:  u32 = (str_len(text) - prefix)::u32;
        var k:    u32 = 0;
        for (k < len) {
            chars[at + k] = text[prefix + k::usize];
            k             = k + 1;
        }
        stub_code(tgt, out.sections[text_r.ok].bytes, i * size);
        val stub: err[fail.Fail] = stub_relocations(tgt, out, i * size, i, refs_sym, send_sym);
        if (sel stub.err) { ret stub; }
        val pointed: err[fail.Fail] = target_of.add_relocation(out, target_of.Relocation{section: target_of.section_id(refs_sec_r.ok),
            offset: i * 8, kind: target_of.RK_ABS64, sym: chars_sym, addend: at::i64});
        if (sel pointed.err) { ret pointed; }
        at = at + len + 1;
        i  = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the synthetic input carrying the stubs; false when the inputs leave none undefined
pub fun synthesize_objc_stubs(s: *session.Session, tgt: *lang_target.Target,
    modules: *target_of.ObjectImage, module_count: u32, mode: LinkMode,
    out: *target_of.ObjectImage) res[bool, fail.Fail] {
    if (!makes_objc_stubs(tgt, mode) || modules == nil) { ret res[bool, fail.Fail].ok{false}; }
    val stub_prefix: str = join2(s, tgt.os.c_symbol_prefix, "objc_msgSend$", "");
    if (str_len(stub_prefix) == 0) {
        ret res[bool, fail.Fail].err{fail.message("link: could not form the objc selector stub prefix")};
    }
    var count:   u32            = 0;
    val counted: err[fail.Fail] = collect_stub_names(s, modules, module_count, stub_prefix, nil, ?count);
    if (sel counted.err) { ret res[bool, fail.Fail].err{counted.err}; }
    if (count == 0)      { ret res[bool, fail.Fail].ok{false}; }

    val names_r: res[*intern.StrId, A.Error] = A.zallocate[intern.StrId](s.alloc, count::usize);
    if (sel names_r.err) { ret res[bool, fail.Fail].err{fail.refused(names_r.err)}; }
    val names: *intern.StrId = names_r.ok;
    fin { A.deallocate[intern.StrId](s.alloc, names, count::usize); }
    var again:  u32            = 0;
    val filled: err[fail.Fail] = collect_stub_names(s, modules, module_count, stub_prefix, names, ?again);
    if (sel filled.err) { ret res[bool, fail.Fail].err{filled.err}; }
    if (again != count) {
        ret res[bool, fail.Fail].err{fail.message("link: objc selector stubs changed between passes")};
    }

    val msgsend: str                                   = join2(s, tgt.os.c_symbol_prefix, "objc_msgSend", "");
    val image_r: res[target_of.ObjectImage, fail.Fail] = obj.image_init(s.alloc, ?s.interner,
        intern_name(s, "<objc-selector-stubs>"));
    if (sel image_r.err) { ret res[bool, fail.Fail].err{image_r.err}; }
    @out = image_r.ok;
    val built: err[fail.Fail] = build_stub_image(s, tgt, out, names, count, stub_prefix,
        intern_name(s, msgsend));
    if (sel built.err) {
        obj.dnit(out);
        ret res[bool, fail.Fail].err{built.err};
    }
    val valid: err[fail.Fail] = target_of.validate_owned_object_or_dnit(out);
    if (sel valid.err) { ret res[bool, fail.Fail].err{valid.err}; }
    ret res[bool, fail.Fail].ok{true};
}
