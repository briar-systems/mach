rec SectionCountUnit {}

rec SymbolCountUnit {}

#[testing]
pub rec GmTrackEntry {
    p:    ptr;
    size: usize;
    live: bool;
}

#[testing]
pub rec GmTracker {
    entries:  *GmTrackEntry;
    cap:      u32;
    count:    u32;
    live:     u32;
    mismatch: bool;
}

#[testing]
fun gm_track_record(t: *GmTracker, p: ptr, size: usize) {
    if (t.count >= t.cap) { ret; }
    t.entries[t.count].p    = p;
    t.entries[t.count].size = size;
    t.entries[t.count].live = true;
    t.count                 = t.count + 1;
    t.live                  = t.live + 1;
}

#[testing]
fun gm_track_find(t: *GmTracker, p: ptr) i64 {
    var i: u32 = 0;
    for (i < t.count) {
        if (t.entries[i].live && t.entries[i].p == p) { ret i::i64; }
        i = i + 1;
    }
    ret 0 - 1;
}

#[testing]
pub fun gm_track_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val t: *GmTracker = ctx::*GmTracker;
    val p: ptr        = os.allocate(size);
    if (p == nil) { ret opt[ptr].none{}; }
    memory.raw_fill(p, 0xAA, size);
    gm_track_record(t, p, size);
    ret opt[ptr].some{p};
}

#[testing]
pub fun gm_track_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    if (p == nil || size == 0) { ret 0; }
    val t:   *GmTracker = ctx::*GmTracker;
    val idx: i64        = gm_track_find(t, p);
    if (idx < 0) {
        t.mismatch = true;
        ret 0;
    }
    if (t.entries[idx::u32].size != size) { t.mismatch = true; }
    t.entries[idx::u32].live = false;
    t.live                   = t.live - 1;
    ret os.deallocate(p, size);
}

#[testing]
pub fun gm_track_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    if (p == nil) { ret gm_track_allocate(ctx, new_size, align); }
    val t:   *GmTracker = ctx::*GmTracker;
    val idx: i64        = gm_track_find(t, p);
    if (idx < 0) { t.mismatch = true; }
    or {
        if (t.entries[idx::u32].size != old_size) { t.mismatch = true; }
    }
    val np: ptr = os.reallocate(p, old_size, new_size);
    if (np == nil)           { ret opt[ptr].none{}; }
    if (new_size > old_size) { memory.raw_fill((np::usize + old_size)::ptr, 0xAA, new_size - old_size); }
    if (idx < 0)             { gm_track_record(t, np, new_size); }
    or {
        t.entries[idx::u32].p    = np;
        t.entries[idx::u32].size = new_size;
    }
    ret opt[ptr].some{np};
}

pub fun grow_cap[T](alloc: *A.Allocator, data: **T, cap: *u32, initial: u32) err[fail.Fail] {
    if (@data == nil) {
        val res_alloc: res[*T, A.Error] = A.allocate[T](alloc, initial::usize);
        if (sel res_alloc.err) { ret err[fail.Fail].err{fail.refused(res_alloc.err)}; }
        @data = res_alloc.ok;
        @cap  = initial;
        ret err[fail.Fail].ok{};
    }
    val current:    layout.CheckedCount[T]                         = layout.count[T]((@cap)::usize);
    val required_r: res[layout.CheckedCount[T], layout.CheckCause] =
        layout.count_add[T](current, layout.count[T](1::usize));
    if (sel required_r.err) {
        ret err[fail.Fail].err{fail.message("linker: growth count overflow")};
    }
    val required: layout.CheckedCount[T]                         = required_r.ok;
    val grown_r:  res[layout.CheckedCount[T], layout.CheckCause] = layout.count_grow[T](current, required);
    if (sel grown_r.err) {
        ret err[fail.Fail].err{fail.message("linker: growth count overflow")};
    }
    val new_cap_fits: res[u32, layout.CheckCause] = layout.usize_to_u32(
        grown_r.ok.value);
    if (sel new_cap_fits.err) {
        ret err[fail.Fail].err{fail.message("linker: growth capacity exceeds the u32 limit")};
    }
    val new_cap:     u32              = new_cap_fits.ok;
    val res_realloc: res[*T, A.Error] = A.reallocate[T](alloc, @data, (@cap)::usize, new_cap::usize);
    if (sel res_realloc.err) { ret err[fail.Fail].err{fail.refused(res_realloc.err)}; }
    @data = res_realloc.ok;
    @cap  = new_cap;
    ret err[fail.Fail].ok{};
}

# a kind outside the catalog is never loadable; every image here was validated
# at entry, so such a kind never reaches this predicate
pub fun is_loadable_kind(kind: of.SectionKind) bool {
    val desc: opt[*of.SectionKindDesc] = of.section_desc(kind);
    ret sel desc.some && desc.some.loadable;
}

pub fun fill_section_bases(modules: *of.ObjectImage, module_count: u32, sec_base: *u32) err[fail.Fail] {
    var flat: layout.CheckedCount[SectionCountUnit] = layout.count[SectionCountUnit](0::usize);
    var m:    u32                                   = 0;
    for (m < module_count) {
        val flat32: res[u32, layout.CheckCause] = layout.usize_to_u32(flat.value);
        if (sel flat32.err) {
            ret err[fail.Fail].err{fail.message("linker: flattened section index exceeds the u32 limit")};
        }
        sec_base[m] = flat32.ok;
        val added: res[layout.CheckedCount[SectionCountUnit], layout.CheckCause] =
            layout.count_add[SectionCountUnit](flat, layout.count[SectionCountUnit](modules[m].section_count::usize));
        if (sel added.err) {
            ret err[fail.Fail].err{fail.message("linker: total input section count overflow")};
        }
        flat = added.ok;
        m    = m + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun add_u32_counts[Unit](left: u32, right: u32) res[u32, layout.CheckCause] {
    val added_r: res[layout.CheckedCount[Unit], layout.CheckCause] =
        layout.count_add[Unit](layout.count[Unit](left::usize),
        layout.count[Unit](right::usize));
    if (sel added_r.err) {
        ret res[u32, layout.CheckCause].err{added_r.err};
    }
    val lower_of_r: res[u32, layout.CheckCause] = layout.usize_to_u32(
        added_r.ok.value);
    if (sel lower_of_r.err) { ret res[u32, layout.CheckCause].err{lower_of_r.err}; }
    ret res[u32, layout.CheckCause].ok{lower_of_r.ok};
}

pub fun total_sections(modules: *of.ObjectImage, module_count: u32) res[u32, fail.Fail] {
    var total: layout.CheckedCount[SectionCountUnit] = layout.count[SectionCountUnit](0::usize);
    var m:     u32                                   = 0;
    for (m < module_count) {
        val added: res[layout.CheckedCount[SectionCountUnit], layout.CheckCause] =
            layout.count_add[SectionCountUnit](total, layout.count[SectionCountUnit](modules[m].section_count::usize));
        if (sel added.err) {
            ret res[u32, fail.Fail].err{fail.message("linker: total input section count overflow")};
        }
        total = added.ok;
        m     = m + 1;
    }
    val fits: res[u32, layout.CheckCause] = layout.usize_to_u32(total.value);
    if (sel fits.err) {
        ret res[u32, fail.Fail].err{fail.message("linker: total input section count exceeds the u32 limit")};
    }
    ret res[u32, fail.Fail].ok{fits.ok};
}

pub fun total_symbols(modules: *of.ObjectImage, module_count: u32) res[u32, fail.Fail] {
    var total: layout.CheckedCount[SymbolCountUnit] = layout.count[SymbolCountUnit](0::usize);
    var m:     u32                                  = 0;
    for (m < module_count) {
        val added: res[layout.CheckedCount[SymbolCountUnit], layout.CheckCause] =
            layout.count_add[SymbolCountUnit](total, layout.count[SymbolCountUnit](modules[m].symbol_count::usize));
        if (sel added.err) {
            ret res[u32, fail.Fail].err{fail.message("linker: total input symbol count overflow")};
        }
        total = added.ok;
        m     = m + 1;
    }
    val fits: res[u32, layout.CheckCause] = layout.usize_to_u32(total.value);
    if (sel fits.err) {
        ret res[u32, fail.Fail].err{fail.message("linker: total input symbol count exceeds the u32 limit")};
    }
    ret res[u32, fail.Fail].ok{fits.ok};
}

pub fun fill_symbol_bases(modules: *of.ObjectImage, module_count: u32, sym_base: *u32) err[fail.Fail] {
    var base: layout.CheckedCount[SymbolCountUnit] = layout.count[SymbolCountUnit](0::usize);
    var m:    u32                                  = 0;
    for (m < module_count) {
        val base32: res[u32, layout.CheckCause] = layout.usize_to_u32(base.value);
        if (sel base32.err) {
            ret err[fail.Fail].err{fail.message("linker: flattened symbol index exceeds the u32 limit")};
        }
        sym_base[m] = base32.ok;
        val added: res[layout.CheckedCount[SymbolCountUnit], layout.CheckCause] =
            layout.count_add[SymbolCountUnit](base, layout.count[SymbolCountUnit](modules[m].symbol_count::usize));
        if (sel added.err) {
            ret err[fail.Fail].err{fail.message("linker: total input symbol count overflow")};
        }
        base = added.ok;
        m    = m + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun atom_reloc_traits(r: *of.Relocation, section: *of.Section,
    arch: *isa.IsaVTable,
    codegen_image: bool) res[rel.RelocTraits, rel.RelocError] {
    var kind: of.RelocKind = r.kind;
    if (of.is_difference(kind)) {
        val applied: opt[of.RelocKind] = of.difference_apply_kind(kind);
        if (sel applied.none) { ret res[rel.RelocTraits, rel.RelocError].err{rel.RELOC_UNSUPPORTED}; }
        kind = applied.some;
    }
    ret arch.reloc.traits(kind, section.kind, codegen_image);
}

# the bias between a field-bias operand's addend and the address it reaches:
# the exact distance to the instruction's end when the encoder recorded it,
# otherwise the target's bound for a field in text, and none outside text
pub fun atom_field_bias(r: *of.Relocation, mode: rel.RelocAddendMode, text_bias_min: i32,
    text_bias_max: i32, source_text: bool, lo: *i64, hi: *i64) {
    @lo = 0;
    @hi = 0;
    if (mode != rel.RELOC_ADDEND_FIELD_BIAS || !source_text) { ret; }
    if (r.inst_end != 0) {
        @lo = r.inst_end::i64;
        @hi = r.inst_end::i64;
        ret;
    }
    @lo = text_bias_min::i64;
    @hi = text_bias_max::i64;
}

pub fun atom_effective_offset(base: u32, addend: i64, out: *u32) bool {
    if (addend >= 0) {
        val plus: u64 = addend::u64;
        if (plus > 0xFFFFFFFF - base::u64) { ret false; }
        @out = base + plus::u32;
        ret true;
    }
    if (addend < -(base::i64)) { ret false; }
    @out = (base::i64 + addend)::u32;
    ret true;
}

# the names the link's objects asked it to export whoever defines them: the
# union of every module's `fwd` re-exports. a hidden definition under one of
# these names is on the surface after all
pub rec ExportSurface {
    requested: map.Map[intern.StrId, u32];
    count:     u32;
}

pub fun export_surface_build(s: *session.Session, modules: *of.ObjectImage,
    module_count: u32) res[ExportSurface, fail.Fail] {
    var surface: ExportSurface = ExportSurface{
        requested: map.init[intern.StrId, u32](s.alloc), count: 0
    };
    var m: u32 = 0;
    for (m < module_count) {
        var i: u32 = 0;
        for (i < modules[m].export_request_count) {
            val name: intern.StrId = modules[m].export_requests[i];
            if (map.contains[intern.StrId, u32](?surface.requested, ?name)) {
                i = i + 1;
                cnt;
            }
            val inserted: res[bool, A.Error] = map.insert[intern.StrId, u32](?surface.requested, name, 1);
            if (sel inserted.err) {
                map.dnit[intern.StrId, u32](?surface.requested);
                ret res[ExportSurface, fail.Fail].err{fail.refused(inserted.err)};
            }
            surface.count = surface.count + 1;
            i             = i + 1;
        }
        m = m + 1;
    }
    ret res[ExportSurface, fail.Fail].ok{surface};
}

pub fun export_surface_free(surface: *ExportSurface) {
    map.dnit[intern.StrId, u32](?surface.requested);
    surface.count = 0;
}

pub fun export_surface_requests(surface: *ExportSurface, name: intern.StrId) bool {
    if (surface == nil || surface.count == 0) { ret false; }
    var key: intern.StrId = name;
    ret map.contains[intern.StrId, u32](?surface.requested, ?key);
}

pub fun is_exported_symbol(m: *of.ObjectImage, sym: *of.Symbol, surface: *ExportSurface) bool {
    if (of.section_is_external(sym.section))                                                                              { ret false; }
    if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0)                                                                        { ret false; }
    if ((sym.flags & of.SYM_OBJ_FLAG_HIDDEN) != 0 && !export_surface_requests(surface, sym.name))                         { ret false; }
    if (of.section_index(sym.section) < m.section_count && m.sections[of.section_index(sym.section)].kind == of.SK_DEBUG) { ret false; }
    ret true;
}

pub fun any_exported_symbol(modules: *of.ObjectImage, module_count: u32,
    surface: *ExportSurface) bool {
    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            if (is_exported_symbol(?modules[m], ?modules[m].symbols[sy], surface)) { ret true; }
            sy = sy + 1;
        }
        m = m + 1;
    }
    ret false;
}

pub fun is_function_branch_kind(kind: of.RelocKind) bool {
    ret kind == of.RK_PC32 || kind == of.RK_PLT32 || kind == of.RK_JUMP26 || kind == of.RK_JAL20;
}

pub fun is_got_kind(kind: of.RelocKind) bool {
    ret kind == of.RK_GOT_PAGE21 || kind == of.RK_GOT_LO12 || kind == of.RK_GOT_PCREL_HI20
        || kind == of.RK_GOTPCREL || kind == of.RK_GOTPCREL_NORELAX
        || kind == of.RK_GOTPCREL64_NORELAX;
}

pub fun named_message(s: *session.Session, prefix: str, name_id: intern.StrId, suffix: str, fallback: str) str {
    val nm: opt[str] = intern.lookup(?s.interner, name_id);
    if (sel nm.some) { ret join3(s, prefix, nm.some, suffix, fallback); }
    ret fallback;
}

pub fun oor_section_message(s: *session.Session, sym_name: intern.StrId, obj_name: intern.StrId) str {
    val sn: opt[str] = intern.lookup(?s.interner, sym_name);
    val on: opt[str] = intern.lookup(?s.interner, obj_name);
    if (sel sn.some) {
        if (sel on.some) {
            val pre: str = join3(s, "linker: symbol '", sn.some, "' in object '", "linker: symbol names an out-of-range section");
            ret join3(s, pre, on.some, "' names an out-of-range section", "linker: symbol names an out-of-range section");
        }
    }
    if (sel sn.some) { ret join3(s, "linker: symbol '", sn.some, "' names an out-of-range section", "linker: symbol names an out-of-range section"); }
    ret "linker: symbol names an out-of-range section";
}

pub fun dup_message(s: *session.Session, name: intern.StrId) str {
    val nm: opt[str] = intern.lookup(?s.interner, name);
    if (sel nm.some) { ret join3(s, "multiple definition of '", nm.some, "'", "multiple definition of symbol"); }
    ret "multiple definition of symbol";
}

pub fun join2(s: *session.Session, a: str, b: str, prefix: str) str {
    val la:    usize = str_len(a);
    val lb:    usize = str_len(b);
    val total: usize = la + lb;

    val r: res[*u8, A.Error] = A.allocate[u8](s.alloc, total + 1);
    if (sel r.err) { ret prefix; }
    val buf: *u8 = r.ok;

    copy_bytes(buf, 0, a, la);
    copy_bytes(buf, la, b, lb);
    buf[total] = 0;

    val ir: res[intern.StrId, A.Error] = intern.intern(?s.interner, buf::str);
    A.deallocate[u8](s.alloc, buf, total + 1);
    if (sel ir.err) { ret prefix; }

    val nm: opt[str] = intern.lookup(?s.interner, ir.ok);
    if (sel nm.some) { ret nm.some; }
    ret prefix;
}

pub fun join3(s: *session.Session, a: str, b: str, c: str, prefix: str) str {
    val la:    usize = str_len(a);
    val lb:    usize = str_len(b);
    val lc:    usize = str_len(c);
    val total: usize = la + lb + lc;

    val r: res[*u8, A.Error] = A.allocate[u8](s.alloc, total + 1);
    if (sel r.err) { ret prefix; }
    val buf: *u8 = r.ok;

    copy_bytes(buf, 0, a, la);
    copy_bytes(buf, la, b, lb);
    copy_bytes(buf, la + lb, c, lc);
    buf[total] = 0;

    val ir: res[intern.StrId, A.Error] = intern.intern(?s.interner, buf::str);
    A.deallocate[u8](s.alloc, buf, total + 1);
    if (sel ir.err) { ret prefix; }

    val nm: opt[str] = intern.lookup(?s.interner, ir.ok);
    if (sel nm.some) { ret nm.some; }
    ret prefix;
}

fun copy_bytes(dst: *u8, at: usize, src: str, len: usize) {
    memory.raw_copy((dst::usize + at)::ptr, src::ptr, len);
}

pub fun lt_name(s: *session.Session, name: str) intern.StrId {
    val r: res[intern.StrId, A.Error] = intern.intern(?s.interner, name);
    if (sel r.err) { ret intern.STR_NIL; }
    ret r.ok;
}

#[testing]
pub fun lt_image(s: *session.Session, name: intern.StrId,
    sections: *of.Section, section_count: u32,
    symbols: *of.Symbol, symbol_count: u32,
    relocations: *of.Relocation, reloc_count: u32) of.ObjectImage {
    var img: of.ObjectImage = of.object_image_init(s.alloc, ?s.interner, name);
    img.sections      = sections;
    img.section_count = section_count;
    img.symbols       = symbols;
    img.symbol_count  = symbol_count;
    img.relocations   = relocations;
    img.reloc_count   = reloc_count;
    ret img;
}

test is_exported_symbol__hidden_needs_an_export_request {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var sections: [1]of.Section = [1]of.Section{of.Section{name: lt_name(?s, ".text"), kind: of.SK_TEXT, len: 8, align: 4}};
    var symbols:  [2]of.Symbol;
    symbols[0] = of.Symbol{name: lt_name(?s, "open"), section: of.section_id(0), offset: 0, size: 4,
        flags: of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION, align: 1};
    symbols[1] = of.Symbol{name: lt_name(?s, "shut"), section: of.section_id(0), offset: 4, size: 4,
        flags: of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION | of.SYM_OBJ_FLAG_HIDDEN, align: 1};
    var image: of.ObjectImage = lt_image(?s, lt_name(?s, "probe"), ?sections[0], 1, ?symbols[0], 2,
        nil::*of.Relocation, 0);

    var bad: i32 = 0;
    # with no surface at all, a hidden definition is not an export and a plain one is
    if (!is_exported_symbol(?image, ?symbols[0], nil::*ExportSurface)) { bad = 1; }
    if (is_exported_symbol(?image, ?symbols[1], nil::*ExportSurface))  { bad = 2; }

    val empty_r: res[ExportSurface, fail.Fail] = export_surface_build(?s, ?image, 1);
    if (sel empty_r.err) { ret 3; }
    var empty: ExportSurface = empty_r.ok;
    if (empty.count != 0)                                { bad = 4; }
    if (is_exported_symbol(?image, ?symbols[1], ?empty)) { bad = 5; }
    export_surface_free(?empty);

    # a module that re-exports the hidden name puts it back on the surface, and
    # only that name
    var requests: [1]intern.StrId = [1]intern.StrId{lt_name(?s, "shut")};
    image.export_requests      = ?requests[0];
    image.export_request_count = 1;
    image.export_request_cap   = 1;
    val asked_r: res[ExportSurface, fail.Fail] = export_surface_build(?s, ?image, 1);
    if (sel asked_r.err) { ret 6; }
    var asked: ExportSurface = asked_r.ok;
    if (asked.count != 1)                                      { bad = 7; }
    if (!is_exported_symbol(?image, ?symbols[1], ?asked))      { bad = 8; }
    if (!export_surface_requests(?asked, lt_name(?s, "shut"))) { bad = 9; }
    if (export_surface_requests(?asked, lt_name(?s, "open")))  { bad = 10; }
    export_surface_free(?asked);
    image.export_requests      = nil;
    image.export_request_count = 0;
    image.export_request_cap   = 0;
    ret bad;
}

test flattened_counts__refuse_u32_overflow {
    var mods: [3]of.ObjectImage;
    mods[0].section_count = 0xFFFFFFFF;
    mods[1].section_count = 1;
    mods[2].section_count = 0;
    mods[0].symbol_count  = 0xFFFFFFFF;
    mods[1].symbol_count  = 1;
    mods[2].symbol_count  = 0;
    val sections: res[u32, fail.Fail] = total_sections(?mods[0], 2);
    val symbols:  res[u32, fail.Fail] = total_symbols(?mods[0], 2);
    if (sel sections.ok) { ret 1; }
    if (sel symbols.ok)  { ret 2; }
    # a base past the u32 range is refused, never wrapped into a smaller index
    var sec_base: [3]u32;
    var sym_base: [3]u32;
    val sec_r:    err[fail.Fail] = fill_section_bases(?mods[0], 3, ?sec_base[0]);
    val sym_r:    err[fail.Fail] = fill_symbol_bases(?mods[0], 3, ?sym_base[0]);
    if (sel sec_r.ok || sec_base[1] != 0xFFFFFFFF) { ret 3; }
    if (sel sym_r.ok || sym_base[1] != 0xFFFFFFFF) { ret 4; }
    ret 0;
}

#[testing]
pub rec GrowProbe {
    reallocate_calls: u32;
}

#[testing]
pub fun grow_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    ret opt[ptr].none{};
}

#[testing]
pub fun grow_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val g: *GrowProbe = ctx::*GrowProbe;
    g.reallocate_calls = g.reallocate_calls + 1;
    ret opt[ptr].none{};
}

#[testing]
pub fun grow_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test grow_cap__refuses_u32_overflow_before_reallocating {
    var probe: GrowProbe;
    probe.reallocate_calls = 0;
    var pp: *GrowProbe = ?probe;
    var a:  A.Allocator;
    a.ctx           = pp::ptr;
    a.fn_allocate   = grow_probe_allocate;
    a.fn_reallocate = grow_probe_reallocate;
    a.fn_deallocate = grow_probe_deallocate;

    var dummy:  u8;
    var data:   *u8            = ?dummy;
    var cap:    u32            = 0xFFFFFFFF;
    val result: err[fail.Fail] = grow_cap[u8](?a, ?data, ?cap, 16);

    var bad: i32 = 0;
    if (!sel result.err)             { bad = 1; }
    if (probe.reallocate_calls != 0) { bad = 2; }
    if (cap != 0xFFFFFFFF)           { bad = 3; }
    ret bad;
}
