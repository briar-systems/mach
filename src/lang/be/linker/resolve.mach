use std.allocator.page;
use std.collections.map;
use std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.be.obj;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.layout;
use mach.lang.session;
use mach.lang.target.of;

use mach.lang.be.linker.atoms.AtomPlan;
use mach.lang.be.linker.atoms.atom_live_offset;
use mach.lang.be.linker.atoms.atom_offset_dead;
use mach.lang.be.linker.common.dup_message;
use mach.lang.be.linker.common.lt_image;
use mach.lang.be.linker.common.lt_name;
use mach.lang.be.linker.common.oor_section_message;
use mach.lang.be.linker.merge.Placement;
use mach.lang.be.linker.mode.LINK_EXE;
use mach.lang.be.linker.mode.LINK_RELOCATABLE;
use mach.lang.be.linker.mode.LinkMode;
use mach.lang.be.linker.mode.mode_allocates_commons;
use mach.lang.be.linker.mode.unknown_link_mode;

rec CommonStorageUnit {}

pub rec SymbolLoc {
    vaddr:         u64;
    section_vaddr: u64;
    merged_index:  u32;
    weak:          bool;
    fallback:      intern.StrId;
}

pub fun synthesize_common_storage(s: *session.Session, modules: *of.ObjectImage,
    module_count: u32, mode: LinkMode,
    out: *of.ObjectImage) res[bool, fail.Fail] {
    val allocates: opt[bool] = mode_allocates_commons(mode);
    if (sel allocates.none) { ret res[bool, fail.Fail].err{fail.message(unknown_link_mode(s, mode))}; }
    if (!allocates.some || modules == nil || module_count == 0) {
        ret res[bool, fail.Fail].ok{false};
    }
    val alloc: *A.Allocator = s.alloc;

    var defined: map.Map[intern.StrId, u32] =
        map.init[intern.StrId, u32](alloc, map.hash_u32, map.eq_u32);
    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if (of.section_is_absolute(sym.section)
                || (!of.section_is_external(sym.section) && of.section_index(sym.section) < modules[m].section_count)) {
                val get_r: opt[*u32] = map.get[intern.StrId, u32](?defined, ?sym.name);
                if (sel get_r.none) {
                    val di: res[bool, A.Error] = map.insert[intern.StrId, u32](?defined, sym.name, 0);
                    if (sel di.err) {
                        map.dnit[intern.StrId, u32](?defined);
                        ret res[bool, fail.Fail].err{fail.refused(di.err)};
                    }
                }
            }
            sy = sy + 1;
        }
        m = m + 1;
    }

    var slot: map.Map[intern.StrId, u32] =
        map.init[intern.StrId, u32](alloc, map.hash_u32, map.eq_u32);
    var names:  Vector[intern.StrId] = vector.init[intern.StrId](alloc);
    var sizes:  Vector[u32]          = vector.init[u32](alloc);
    var aligns: Vector[u32]          = vector.init[u32](alloc);

    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if ((sym.flags & of.SYM_OBJ_FLAG_COMMON) == 0) {
                sy = sy + 1;
                cnt;
            }
            val get_r2: opt[*u32] = map.get[intern.StrId, u32](?defined, ?sym.name);
            if (sel get_r2.some) {
                sy = sy + 1;
                cnt;
            }

            var al: u32 = sym.align;
            if (al == 0) { al = 1; }
            val ex: opt[*u32] = map.get[intern.StrId, u32](?slot, ?sym.name);
            if (sel ex.some) {
                val at: u32 = @ex.some;
                if (sym.size > sizes.data[at]) { sizes.data[at] = sym.size; }
                if (al > aligns.data[at])      { aligns.data[at] = al; }
                sy = sy + 1;
                cnt;
            }
            val ins: res[bool, A.Error] = map.insert[intern.StrId, u32](?slot, sym.name, names.len::u32);
            if (sel ins.err) {
                map.dnit[intern.StrId, u32](?slot);
                map.dnit[intern.StrId, u32](?defined);
                vector.dnit[intern.StrId](?names);
                vector.dnit[u32](?sizes);
                vector.dnit[u32](?aligns);
                ret res[bool, fail.Fail].err{fail.refused(ins.err)};
            }
            val push_n: res[usize, A.Error] = vector.push[intern.StrId](?names, sym.name);
            if (sel push_n.err) {
                map.dnit[intern.StrId, u32](?slot);
                map.dnit[intern.StrId, u32](?defined);
                vector.dnit[intern.StrId](?names);
                vector.dnit[u32](?sizes);
                vector.dnit[u32](?aligns);
                ret res[bool, fail.Fail].err{fail.refused(push_n.err)};
            }
            val push_s: res[usize, A.Error] = vector.push[u32](?sizes, sym.size);
            if (sel push_s.err) {
                map.dnit[intern.StrId, u32](?slot);
                map.dnit[intern.StrId, u32](?defined);
                vector.dnit[intern.StrId](?names);
                vector.dnit[u32](?sizes);
                vector.dnit[u32](?aligns);
                ret res[bool, fail.Fail].err{fail.refused(push_s.err)};
            }
            val push_a: res[usize, A.Error] = vector.push[u32](?aligns, al);
            if (sel push_a.err) {
                map.dnit[intern.StrId, u32](?slot);
                map.dnit[intern.StrId, u32](?defined);
                vector.dnit[intern.StrId](?names);
                vector.dnit[u32](?sizes);
                vector.dnit[u32](?aligns);
                ret res[bool, fail.Fail].err{fail.refused(push_a.err)};
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    map.dnit[intern.StrId, u32](?slot);
    map.dnit[intern.StrId, u32](?defined);

    if (names.len == 0) {
        vector.dnit[intern.StrId](?names);
        vector.dnit[u32](?sizes);
        vector.dnit[u32](?aligns);
        ret res[bool, fail.Fail].ok{false};
    }

    var total:     layout.CheckedOffset[CommonStorageUnit] = layout.offset[CommonStorageUnit](0::usize);
    var sec_align: u32                                     = 1;
    var offs:      Vector[u32]                             = vector.init[u32](alloc);
    var n:         usize                                   = 0;
    for (n < names.len) {
        if (aligns.data[n] > sec_align) { sec_align = aligns.data[n]; }
        val align_r: res[layout.CheckedAlignment[CommonStorageUnit], layout.CheckCause] =
            layout.alignment[CommonStorageUnit](aligns.data[n]::usize);
        if (sel align_r.err) {
            vector.dnit[u32](?offs);
            vector.dnit[intern.StrId](?names);
            vector.dnit[u32](?sizes);
            vector.dnit[u32](?aligns);
            ret res[bool, fail.Fail].err{fail.message("link: common storage member has invalid alignment")};
        }
        val aligned_r: res[layout.CheckedOffset[CommonStorageUnit], layout.CheckCause] =
            layout.align_offset_up[CommonStorageUnit](total,
            align_r.ok);
        if (sel aligned_r.err) {
            vector.dnit[u32](?offs);
            vector.dnit[intern.StrId](?names);
            vector.dnit[u32](?sizes);
            vector.dnit[u32](?aligns);
            ret res[bool, fail.Fail].err{fail.message("link: common storage layout overflow")};
        }
        total = aligned_r.ok;
        if (total.value > 0x7FFFFFFF) {
            vector.dnit[u32](?offs);
            vector.dnit[intern.StrId](?names);
            vector.dnit[u32](?sizes);
            vector.dnit[u32](?aligns);
            ret res[bool, fail.Fail].err{fail.message("link: common storage exceeds 2 GiB")};
        }
        val push_o: res[usize, A.Error] = vector.push[u32](?offs, total.value::u32);
        if (sel push_o.err) {
            vector.dnit[u32](?offs);
            vector.dnit[intern.StrId](?names);
            vector.dnit[u32](?sizes);
            vector.dnit[u32](?aligns);
            ret res[bool, fail.Fail].err{fail.refused(push_o.err)};
        }
        val grown_r: res[layout.CheckedOffset[CommonStorageUnit], layout.CheckCause] =
            layout.offset_add[CommonStorageUnit](total, layout.count[CommonStorageUnit](sizes.data[n]::usize));
        if (sel grown_r.err) {
            vector.dnit[u32](?offs);
            vector.dnit[intern.StrId](?names);
            vector.dnit[u32](?sizes);
            vector.dnit[u32](?aligns);
            ret res[bool, fail.Fail].err{fail.message("link: common storage layout overflow")};
        }
        total = grown_r.ok;
        n     = n + 1;
    }

    val image_name_r:   res[intern.StrId, A.Error] = intern.intern(?s.interner, "<common-storage>");
    val section_name_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, ".bss");
    if (sel image_name_r.err) {
        vector.dnit[u32](?offs);
        vector.dnit[intern.StrId](?names);
        vector.dnit[u32](?sizes);
        vector.dnit[u32](?aligns);
        ret res[bool, fail.Fail].err{fail.message("link: could not intern the common storage names")};
    }
    if (sel section_name_r.err) {
        vector.dnit[u32](?offs);
        vector.dnit[intern.StrId](?names);
        vector.dnit[u32](?sizes);
        vector.dnit[u32](?aligns);
        ret res[bool, fail.Fail].err{fail.message("link: could not intern the common storage names")};
    }
    val image_r: res[of.ObjectImage, fail.Fail] = obj.image_init(alloc, ?s.interner, image_name_r.ok);
    if (sel image_r.err) {
        vector.dnit[u32](?offs);
        vector.dnit[intern.StrId](?names);
        vector.dnit[u32](?sizes);
        vector.dnit[u32](?aligns);
        ret res[bool, fail.Fail].err{image_r.err};
    }
    @out = image_r.ok;

    var sec: of.Section;
    sec.name  = section_name_r.ok;
    sec.kind  = of.SK_BSS;
    sec.bytes = nil;
    sec.len   = total.value::u32;
    sec.align = sec_align;
    sec.flags = 0;
    val sec_r: res[u32, fail.Fail] = obj.section_install(out, ?sec);
    if (sel sec_r.err) {
        vector.dnit[u32](?offs);
        vector.dnit[intern.StrId](?names);
        vector.dnit[u32](?sizes);
        vector.dnit[u32](?aligns);
        obj.dnit(out);
        ret res[bool, fail.Fail].err{sec_r.err};
    }
    val sec_ix: u32 = sec_r.ok;

    n = 0;
    for (n < names.len) {
        var osym: of.Symbol;
        osym.name     = names.data[n];
        osym.section  = of.section_id(sec_ix);
        osym.offset   = offs.data[n];
        osym.size     = sizes.data[n];
        osym.flags    = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
        osym.fallback = of.SYMBOL_NONE;
        osym.align    = aligns.data[n];
        val sa: res[u32, fail.Fail] = obj.symbol_add(out, osym);
        if (sel sa.err) {
            vector.dnit[u32](?offs);
            vector.dnit[intern.StrId](?names);
            vector.dnit[u32](?sizes);
            vector.dnit[u32](?aligns);
            obj.dnit(out);
            ret res[bool, fail.Fail].err{sa.err};
        }
        n = n + 1;
    }

    vector.dnit[u32](?offs);
    vector.dnit[intern.StrId](?names);
    vector.dnit[u32](?sizes);
    vector.dnit[u32](?aligns);
    val valid: err[fail.Fail] = of.validate_owned_object_or_dnit(out);
    if (sel valid.err) {
        ret res[bool, fail.Fail].err{valid.err};
    }
    ret res[bool, fail.Fail].ok{true};
}

pub fun weak_fallback_name(img: *of.ObjectImage,
    sym: *of.Symbol) res[intern.StrId, fail.Fail] {
    if ((sym.flags & of.SYM_OBJ_FLAG_FALLBACK) == 0) {
        ret res[intern.StrId, fail.Fail].err{fail.message("link: symbol has no weak fallback")};
    }
    if (sym.fallback >= img.symbol_count || sym.fallback == of.SYMBOL_NONE) {
        ret res[intern.StrId, fail.Fail].err{fail.message("link: weak fallback index is out of range")};
    }
    ret res[intern.StrId, fail.Fail].ok{img.symbols[sym.fallback].name};
}

pub fun resolved_symbol_name(sym_locs: *map.Map[intern.StrId, SymbolLoc],
    name: intern.StrId) res[intern.StrId, fail.Fail] {
    var cur:  intern.StrId = name;
    var hops: usize        = 0;
    for (hops <= sym_locs.len) {
        val lr: opt[*SymbolLoc] =
            map.get[intern.StrId, SymbolLoc](sym_locs, ?cur);
        if (sel lr.none) {
            ret res[intern.StrId, fail.Fail].ok{cur};
        }
        val loc: *SymbolLoc = lr.some;
        if (loc.fallback == intern.STR_NIL) {
            ret res[intern.StrId, fail.Fail].ok{cur};
        }
        cur  = loc.fallback;
        hops = hops + 1;
    }
    ret res[intern.StrId, fail.Fail].err{fail.message("link: weak fallback cycle")};
}

pub fun collect_symbols(s: *session.Session, modules: *of.ObjectImage, module_count: u32,
    placements: *Placement, sec_base: *u32,
    sym_locs: *map.Map[intern.StrId, SymbolLoc], have_vaddrs: bool,
    atoms: *AtomPlan) err[fail.Fail] {
    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if (of.section_is_external(sym.section)) {
                sy = sy + 1;
                cnt;
            }
            if (!of.section_is_absolute(sym.section) && of.section_index(sym.section) >= modules[m].section_count) {
                ret err[fail.Fail].err{fail.message(oor_section_message(s, sym.name, modules[m].name))};
            }
            if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0) {
                sy = sy + 1;
                cnt;
            }

            val is_weak:       bool = (sym.flags & of.SYM_OBJ_FLAG_WEAK) != 0;
            var vaddr:         u64  = sym.absolute_value;
            var section_vaddr: u64  = 0;
            var merged_index:  u32  = of.SECTION_ABSOLUTE;
            if (!of.section_is_absolute(sym.section)) {
                val flat: u32 = sec_base[m] + of.section_index(sym.section);
                if (atom_offset_dead(atoms, flat, sym.offset)) {
                    sy = sy + 1;
                    cnt;
                }
                val pl: *Placement = ?placements[flat];
                merged_index = pl.merged_index;
                vaddr        = 0;
                if (have_vaddrs) {
                    vaddr         = pl.vaddr + atom_live_offset(atoms, flat, sym.offset)::u64;
                    section_vaddr = pl.vaddr - pl.offset::u64;
                }
            }

            val existing: opt[*SymbolLoc] =
                map.get[intern.StrId, SymbolLoc](sym_locs, ?sym.name);
            if (sel existing.some) {
                val cur: *SymbolLoc = existing.some;
                if (is_weak) {
                    sy = sy + 1;
                    cnt;
                }
                if (!cur.weak) { ret err[fail.Fail].err{fail.message(dup_message(s, sym.name))}; }
                cur.vaddr         = vaddr;
                cur.section_vaddr = section_vaddr;
                cur.merged_index  = merged_index;
                cur.weak          = false;
                cur.fallback      = intern.STR_NIL;
                sy                = sy + 1;
                cnt;
            }

            var loc: SymbolLoc;
            loc.vaddr         = vaddr;
            loc.section_vaddr = section_vaddr;
            loc.merged_index  = merged_index;
            loc.weak          = is_weak;
            loc.fallback      = intern.STR_NIL;

            val ins: res[bool, A.Error] =
                map.insert[intern.StrId, SymbolLoc](sym_locs, sym.name, loc);
            if (sel ins.err) {
                ret err[fail.Fail].err{fail.refused(ins.err)};
            }

            sy = sy + 1;
        }
        m = m + 1;
    }

    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if (!is_undefined_extern(sym)
                || (sym.flags & of.SYM_OBJ_FLAG_FALLBACK) == 0) {
                sy = sy + 1;
                cnt;
            }
            val fr: res[intern.StrId, fail.Fail] = weak_fallback_name(?modules[m], sym);
            if (sel fr.err) {
                ret err[fail.Fail].err{fr.err};
            }
            val fallback: intern.StrId = fr.ok;
            if (fallback == intern.STR_NIL) {
                ret err[fail.Fail].err{fail.message("link: weak fallback has no symbol name")};
            }
            val existing: opt[*SymbolLoc] =
                map.get[intern.StrId, SymbolLoc](sym_locs, ?sym.name);
            if (sel existing.some) {
                val cur: *SymbolLoc = existing.some;
                if (cur.fallback != intern.STR_NIL && cur.fallback != fallback) {
                    ret err[fail.Fail].err{fail.message("link: conflicting weak fallback targets")};
                }
            }
            if (sel existing.none) {
                var loc: SymbolLoc;
                loc.vaddr         = 0;
                loc.section_vaddr = 0;
                loc.merged_index  = 0;
                loc.weak          = true;
                loc.fallback      = fallback;
                val ir: res[bool, A.Error] =
                    map.insert[intern.StrId, SymbolLoc](sym_locs, sym.name, loc);
                if (sel ir.err) {
                    ret err[fail.Fail].err{fail.refused(ir.err)};
                }
            }
            sy = sy + 1;
        }
        m = m + 1;
    }

    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if ((sym.flags & of.SYM_OBJ_FLAG_FALLBACK) != 0) {
                val rr: res[intern.StrId, fail.Fail] =
                    resolved_symbol_name(sym_locs, sym.name);
                if (sel rr.err) {
                    ret err[fail.Fail].err{rr.err};
                }
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun is_undefined_extern(sym: *of.Symbol) bool {
    if (!of.section_is_external(sym.section))      { ret false; }
    if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0) { ret false; }
    ret true;
}

fun lt_link(s: *session.Session, name: intern.StrId, a: *of.Symbol, b: *of.Symbol) res[u64, fail.Fail] {
    var placements: [2]Placement;
    placements[0].vaddr        = 0x1000;
    placements[0].offset       = 0;
    placements[0].merged_index = 0;
    placements[1].vaddr        = 0x2000;
    placements[1].offset       = 0;
    placements[1].merged_index = 0;
    var sec_base: [2]u32;
    sec_base[0] = 0;
    sec_base[1] = 1;

    var mods: [2]of.ObjectImage;
    mods[0].alloc         = s.alloc;
    mods[0].symbols       = a;
    mods[0].symbol_count  = 1;
    mods[0].sections      = nil;
    mods[0].section_count = 1;
    mods[0].relocations   = nil;
    mods[0].reloc_count   = 0;
    mods[1].alloc         = s.alloc;
    mods[1].symbols       = b;
    mods[1].symbol_count  = 1;
    mods[1].sections      = nil;
    mods[1].section_count = 1;
    mods[1].relocations   = nil;
    mods[1].reloc_count   = 0;

    var locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](s.alloc, map.hash_u32, map.eq_u32);
    val cr: err[fail.Fail] =
        collect_symbols(s, ?mods[0], 2, ?placements[0], ?sec_base[0],
        ?locs, true, nil::*AtomPlan);
    if (sel cr.err) {
        map.dnit[intern.StrId, SymbolLoc](?locs);
        ret res[u64, fail.Fail].err{cr.err};
    }
    val g: opt[*SymbolLoc] = map.get[intern.StrId, SymbolLoc](?locs, ?name);
    if (sel g.none) {
        map.dnit[intern.StrId, SymbolLoc](?locs);
        ret res[u64, fail.Fail].err{fail.message("missing")};
    }
    val v: u64 = g.some.vaddr;
    map.dnit[intern.StrId, SymbolLoc](?locs);
    ret res[u64, fail.Fail].ok{v};
}

test "mach.lang.be.linker.collect_symbols:weak_strong_order_independent" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val ri: res[intern.StrId, A.Error] = intern.intern(?s.interner, "dup");
    if (sel ri.err) { ret 1; }
    val nm: intern.StrId = ri.ok;

    var weak: of.Symbol;
    weak.name    = nm;
    weak.section = of.section_id(0);
    weak.offset  = 0;
    weak.size    = 0;
    weak.flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK;
    var strong: of.Symbol;
    strong.name    = nm;
    strong.section = of.section_id(0);
    strong.offset  = 0;
    strong.size    = 0;
    strong.flags   = of.SYM_OBJ_FLAG_GLOBAL;
    var strong2: of.Symbol;
    strong2.name    = nm;
    strong2.section = of.section_id(0);
    strong2.offset  = 0;
    strong2.size    = 0;
    strong2.flags   = of.SYM_OBJ_FLAG_GLOBAL;

    val r1: res[u64, fail.Fail] = lt_link(?s, nm, ?weak, ?strong);
    if (sel r1.err)      { ret 1; }
    if (r1.ok != 0x2000) { ret 1; }

    val r2: res[u64, fail.Fail] = lt_link(?s, nm, ?strong, ?weak);
    if (sel r2.err)      { ret 1; }
    if (r2.ok != 0x1000) { ret 1; }

    val r3: res[u64, fail.Fail] = lt_link(?s, nm, ?strong, ?strong2);
    if (!sel r3.err) { ret 1; }
    ret 0;
}

test "mach.lang.be.linker.collect_symbols:winning_section_metadata" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:    session.Session = sr.ok;
    val name: intern.StrId    = lt_name(?s, "section_winner");

    var weak: of.Symbol;
    weak.name    = name;
    weak.section = of.section_id(0);
    weak.offset  = 0x20;
    weak.size    = 0;
    weak.flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK;
    var strong: of.Symbol;
    strong.name    = name;
    strong.section = of.section_id(0);
    strong.offset  = 0x30;
    strong.size    = 0;
    strong.flags   = of.SYM_OBJ_FLAG_GLOBAL;

    var modules: [2]of.ObjectImage;
    modules[0] = lt_image(?s, lt_name(?s, "weak"), nil::*of.Section, 1,
        ?weak, 1, nil::*of.Relocation, 0);
    modules[1] = lt_image(?s, lt_name(?s, "strong"), nil::*of.Section, 1,
        ?strong, 1, nil::*of.Relocation, 0);
    var placements: [2]Placement;
    placements[0].vaddr        = 0x1100;
    placements[0].offset       = 0x100;
    placements[0].merged_index = 0;
    placements[1].vaddr        = 0x2400;
    placements[1].offset       = 0x400;
    placements[1].merged_index = 1;
    var sec_base: [2]u32;
    sec_base[0] = 0;
    sec_base[1] = 1;
    var locs: map.Map[intern.StrId, SymbolLoc] =
        map.init[intern.StrId, SymbolLoc](?alloc, map.hash_u32, map.eq_u32);

    val cr: err[fail.Fail] = collect_symbols(?s, ?modules[0], 2,
        ?placements[0], ?sec_base[0], ?locs, true, nil::*AtomPlan);
    if (sel cr.err) {
        map.dnit[intern.StrId, SymbolLoc](?locs);
        ret 1;
    }
    val lr: opt[*SymbolLoc] = map.get[intern.StrId, SymbolLoc](?locs, ?name);
    if (sel lr.none) {
        map.dnit[intern.StrId, SymbolLoc](?locs);
        ret 1;
    }
    val loc: *SymbolLoc = lr.some;
    if (loc.vaddr != 0x2430 || loc.section_vaddr != 0x2000
        || loc.merged_index != 1 || loc.weak) {
        map.dnit[intern.StrId, SymbolLoc](?locs);
        ret 1;
    }
    map.dnit[intern.StrId, SymbolLoc](?locs);
    ret 0;
}

fun lt_common_module(s: *session.Session, mod_name: str, name: str, size: u32, align: u32) of.ObjectImage {
    val alloc: *A.Allocator               = s.alloc;
    val mn:    res[intern.StrId, A.Error] = intern.intern(?s.interner, mod_name);
    val sn:    res[intern.StrId, A.Error] = intern.intern(?s.interner, name);
    var img:   of.ObjectImage;
    if (sel mn.err) { ret img; }
    if (sel sn.err) { ret img; }
    val img_r: res[of.ObjectImage, fail.Fail] = obj.image_init(alloc, ?s.interner, mn.ok);
    if (sel img_r.ok) { img = img_r.ok; }
    var sym: of.Symbol;
    sym.name    = sn.ok;
    sym.section = of.external_section();
    sym.offset  = 0;
    sym.size    = size;
    sym.align   = align;
    sym.flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_COMMON;
    obj.symbol_add(?img, sym);
    ret img;
}

test "mach.lang.be.linker.synthesize_common_storage:coalesces_to_the_largest_request" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var mods: [2]of.ObjectImage;
    mods[0] = lt_common_module(?s, "a.o", "_shared", 8, 4);
    mods[1] = lt_common_module(?s, "b.o", "_shared", 40, 16);

    var bad: i32                  = 0;
    var out: of.ObjectImage;
    val cr:  res[bool, fail.Fail] = synthesize_common_storage(?s, ?mods[0], 2, LINK_EXE, ?out);
    if (sel cr.err)          { bad = 2; }
    or (sel cr.ok && !cr.ok) { bad = 3; }
    or {
        if (out.symbol_count != 1 && bad == 0)  { bad = 4; }
        or (out.section_count != 1 && bad == 0) { bad = 5; }
        or {
            if (out.symbols[0].size != 40 && bad == 0)                            { bad = 6; }
            if (out.sections[0].len != 40 && bad == 0)                            { bad = 7; }
            if (out.sections[0].align != 16 && bad == 0)                          { bad = 8; }
            if (out.sections[0].kind != of.SK_BSS && bad == 0)                    { bad = 9; }
            if (out.sections[0].bytes != nil && bad == 0)                         { bad = 10; }
            if ((out.symbols[0].flags & of.SYM_OBJ_FLAG_GLOBAL) == 0 && bad == 0) { bad = 11; }
            if ((out.symbols[0].flags & of.SYM_OBJ_FLAG_EXTERN) != 0 && bad == 0) { bad = 12; }
        }
        obj.dnit(?out);
    }

    obj.dnit(?mods[0]);
    obj.dnit(?mods[1]);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.be.linker.synthesize_common_storage:a_real_definition_wins" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var mods: [2]of.ObjectImage;
    mods[0] = lt_common_module(?s, "a.o", "_shared", 40, 16);

    val mn: res[intern.StrId, A.Error] = intern.intern(?s.interner, "b.o");
    val dn: res[intern.StrId, A.Error] = intern.intern(?s.interner, ".data");
    val sn: res[intern.StrId, A.Error] = intern.intern(?s.interner, "_shared");
    if (sel mn.err) { ret 1; }
    if (sel dn.err) { ret 1; }
    if (sel sn.err) { ret 1; }
    val mod_r: res[of.ObjectImage, fail.Fail] = obj.image_init(?alloc, ?s.interner, mn.ok);
    if (sel mod_r.err) { ret 1; }
    mods[1] = mod_r.ok;
    val bytes_r: res[*u8, A.Error] = A.zallocate[u8](?alloc, 8::usize);
    if (sel bytes_r.err) { ret 1; }
    var sec: of.Section;
    sec.name  = dn.ok;
    sec.kind  = of.SK_DATA;
    sec.bytes = bytes_r.ok;
    sec.len   = 8;
    sec.align = 8;
    sec.flags = 0;
    val si: res[u32, fail.Fail] = obj.section_install(?mods[1], ?sec);
    if (sel si.err) { ret 1; }
    var dsym: of.Symbol;
    dsym.name     = sn.ok;
    dsym.section  = of.section_id(si.ok);
    dsym.offset   = 0;
    dsym.size     = 8;
    dsym.flags    = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    dsym.fallback = of.SYMBOL_NONE;
    dsym.align    = 8;
    obj.symbol_add(?mods[1], dsym);

    var bad: i32                  = 0;
    var out: of.ObjectImage;
    val cr:  res[bool, fail.Fail] = synthesize_common_storage(?s, ?mods[0], 2, LINK_EXE, ?out);
    if (sel cr.ok && cr.ok) {
        bad = 3;
        obj.dnit(?out);
    }

    if (bad == 0) {
        var out2: of.ObjectImage;
        val rr:   res[bool, fail.Fail] = synthesize_common_storage(?s, ?mods[0], 1, LINK_RELOCATABLE, ?out2);
        if (sel rr.err) { bad = 4; }
        or (sel rr.ok && rr.ok) {
            bad = 5;
            obj.dnit(?out2);
        }
    }

    obj.dnit(?mods[0]);
    obj.dnit(?mods[1]);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.be.linker.synthesize_common_storage:refuses_layout_exceeding_2gib" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var mods: [2]of.ObjectImage;
    mods[0] = lt_common_module(?s, "a.o", "_first", 0x80000000, 1);
    mods[1] = lt_common_module(?s, "b.o", "_second", 1, 1);

    var out: of.ObjectImage;
    val cr:  res[bool, fail.Fail] = synthesize_common_storage(?s, ?mods[0], 2, LINK_EXE, ?out);
    var bad: i32                  = 0;
    if (sel cr.ok) {
        bad = 1;
        obj.dnit(?out);
    }

    obj.dnit(?mods[0]);
    obj.dnit(?mods[1]);
    session.dnit(?s);
    ret bad;
}
