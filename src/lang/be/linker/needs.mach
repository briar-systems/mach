# the runtime needs a linked executable records for its start code (#3508).
# codegen marks a module that multiplies a secret in a cell admitted only under
# PSTATE.DIT with the local absolute symbol `ct.DIT_NEED_MARKER`; the link
# unions the marks and, on a target whose os declares the mode guaranteed,
# appends one synthetic input defining `ct.DIT_REQUIRED_CELL`: a hidden
# one-byte read-only object the std start code reads, 1 when any input carries
# the mark and 0 otherwise. the cell is an ordinary input, so resolution and
# dead-stripping treat it like any other definition: a start code that never
# reads it leaves nothing in the image. a target whose os declares nothing gets
# no cell, and its DIT rows are refused before any mark can exist
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.be.obj;
use mach.lang.ct;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.session;
use mach.lang.target;
use mach.lang.target.of;
use target_testing: mach.lang.target.testing;

use mach.lang.be.linker.common.lt_image;
use mach.lang.be.linker.common.lt_name;
use mach.lang.be.linker.mode.LINK_EXE;
use mach.lang.be.linker.mode.LINK_RELOCATABLE;
use mach.lang.be.linker.mode.LINK_SHARED;
use mach.lang.be.linker.mode.LinkMode;

# whether any input carries the DIT mark: the per-module fact, unioned
pub fun inputs_need_dit(s: *session.Session, modules: *of.ObjectImage, module_count: u32) bool {
    if (modules == nil) { ret false; }
    val marker: intern.StrId = lt_name(s, ct.DIT_NEED_MARKER);
    if (marker == intern.STR_NIL) { ret false; }
    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *of.Symbol = ?modules[m].symbols[sy];
            if (sym.name == marker && of.section_is_absolute(sym.section)
                && sym.absolute_value == ct.DIT_NEED_VALUE) { ret true; }
            sy = sy + 1;
        }
        m = m + 1;
    }
    ret false;
}

# whether a link of this mode on this target defines the cell: an executable on
# an os that declares the DIT guarantee for the instruction set. a shared
# library runs no start code of its own and records nothing
pub fun defines_dit_cell(tgt: *target.Target, mode: LinkMode) bool {
    if (mode != LINK_EXE) { ret false; }
    ret target.dit_mode_guaranteed(tgt);
}

# the synthetic input carrying the cell; false when this link defines none
pub fun synthesize_runtime_needs(s: *session.Session, tgt: *target.Target,
    modules: *of.ObjectImage, module_count: u32, mode: LinkMode,
    out: *of.ObjectImage) res[bool, fail.Fail] {
    if (!defines_dit_cell(tgt, mode)) { ret res[bool, fail.Fail].ok{false}; }
    val alloc: *A.Allocator = s.alloc;

    var value: u8 = 0;
    if (inputs_need_dit(s, modules, module_count)) { value = 1; }

    val image_name_r:   res[intern.StrId, A.Error] = intern.intern(?s.interner, "<runtime-needs>");
    val section_name_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, ".rodata");
    val cell_name_r:    res[intern.StrId, A.Error] = intern.intern(?s.interner, ct.DIT_REQUIRED_CELL);
    if (sel image_name_r.err)   { ret res[bool, fail.Fail].err{fail.message("link: could not intern the runtime-needs names")}; }
    if (sel section_name_r.err) { ret res[bool, fail.Fail].err{fail.message("link: could not intern the runtime-needs names")}; }
    if (sel cell_name_r.err)    { ret res[bool, fail.Fail].err{fail.message("link: could not intern the runtime-needs names")}; }
    val image_name:   intern.StrId                   = image_name_r.ok;
    val section_name: intern.StrId                   = section_name_r.ok;
    val cell_name:    intern.StrId                   = cell_name_r.ok;
    val image_r:      res[of.ObjectImage, fail.Fail] = obj.image_init(alloc, ?s.interner, image_name);
    if (sel image_r.err) { ret res[bool, fail.Fail].err{image_r.err}; }
    @out = image_r.ok;

    val bytes_r: res[*u8, A.Error] = A.allocate[u8](alloc, 1::usize);
    if (sel bytes_r.err) {
        obj.dnit(out);
        ret res[bool, fail.Fail].err{fail.refused(bytes_r.err)};
    }
    val bytes: *u8 = bytes_r.ok;
    bytes[0] = value;

    var sec: of.Section;
    sec.name  = section_name;
    sec.kind  = of.SK_RODATA;
    sec.bytes = bytes;
    sec.len   = 1;
    sec.align = 1;
    sec.flags = 0;
    val sec_r: res[u32, fail.Fail] = of.section_install(out, ?sec);
    if (sel sec_r.err) {
        A.deallocate[u8](alloc, bytes, 1::usize);
        obj.dnit(out);
        ret res[bool, fail.Fail].err{sec_r.err};
    }

    var sym: of.Symbol;
    sym.name           = cell_name;
    sym.section        = of.section_id(sec_r.ok);
    sym.offset         = 0;
    sym.size           = 1;
    sym.flags          = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT | of.SYM_OBJ_FLAG_HIDDEN;
    sym.fallback       = of.SYMBOL_NONE;
    sym.align          = 1;
    sym.absolute_value = 0;
    val sym_r: res[u32, fail.Fail] = of.symbol_add(out, sym);
    if (sel sym_r.err) {
        obj.dnit(out);
        ret res[bool, fail.Fail].err{sym_r.err};
    }
    val valid: err[fail.Fail] = of.validate_owned_object_or_dnit(out);
    if (sel valid.err) { ret res[bool, fail.Fail].err{valid.err}; }
    ret res[bool, fail.Fail].ok{true};
}

fun nt_marker(s: *session.Session, value: u64) of.Symbol {
    var sym: of.Symbol;
    sym.name           = lt_name(s, ct.DIT_NEED_MARKER);
    sym.section        = of.absolute_section();
    sym.offset         = 0;
    sym.size           = 0;
    sym.flags          = of.SYM_OBJ_FLAG_OBJECT;
    sym.fallback       = of.SYMBOL_NONE;
    sym.align          = 1;
    sym.absolute_value = value;
    ret sym;
}

fun nt_select(reg: *target.TargetRegistry, isa: str, os: str, abi: str) opt[target.Target] {
    val tr: res[target.Target, fail.Fail] = target.select(reg, isa, os, abi);
    if (sel tr.err) { ret opt[target.Target].none{}; }
    ret opt[target.Target].some{tr.ok};
}

fun nt_cell_value(img: *of.ObjectImage) i32 {
    if (img.section_count != 1 || img.symbol_count != 1) { ret -1; }
    val sym: *of.Symbol = ?img.symbols[0];
    if (sym.size != 1 || of.section_index(sym.section) != 0)                                    { ret -2; }
    if ((sym.flags & of.SYM_OBJ_FLAG_HIDDEN) == 0 || (sym.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0) { ret -3; }
    if (img.sections[0].kind != of.SK_RODATA || img.sections[0].len != 1)                       { ret -4; }
    ret img.sections[0].bytes[0]::i32;
}

# the cell exists exactly on an executable link for a target whose os declares
# the guarantee, and reads the union of the input marks
test synthesize_runtime_needs__cell_follows_the_declaration_and_the_marks {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_reg: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_reg.err) { ret 1; }

    var plain_syms: [1]of.Symbol;
    plain_syms[0]      = nt_marker(?s, 0);
    plain_syms[0].name = lt_name(?s, "unrelated_absolute");
    var marked_syms: [1]of.Symbol;
    marked_syms[0] = nt_marker(?s, ct.DIT_NEED_VALUE);
    var stale_syms: [1]of.Symbol;
    stale_syms[0] = nt_marker(?s, 0);

    var inputs: [2]of.ObjectImage;
    inputs[0] = lt_image(?s, lt_name(?s, "plain"), nil, 0, ?plain_syms[0], 1, nil, 0);
    inputs[1] = lt_image(?s, lt_name(?s, "marked"), nil, 0, ?marked_syms[0], 1, nil, 0);
    var stale: [1]of.ObjectImage;
    stale[0] = lt_image(?s, lt_name(?s, "stale"), nil, 0, ?stale_syms[0], 1, nil, 0);

    if (!inputs_need_dit(?s, ?inputs[0], 2)) { ret 2; }
    if (inputs_need_dit(?s, ?inputs[0], 1))  { ret 3; }
    if (inputs_need_dit(?s, ?stale[0], 1))   { ret 4; }
    if (inputs_need_dit(?s, nil, 0))         { ret 5; }

    val a64_linux:   opt[target.Target] = nt_select(?reg, "aarch64", "linux", "aapcs64");
    val a64_darwin:  opt[target.Target] = nt_select(?reg, "aarch64", "darwin", "aapcs64");
    val a64_windows: opt[target.Target] = nt_select(?reg, "aarch64", "windows", "aapcs64");
    val x64_linux:   opt[target.Target] = nt_select(?reg, "x86_64", "linux", "sysv64");
    if (sel a64_linux.none)  { ret 6; }
    if (sel a64_darwin.none) { ret 6; }
    if (sel x64_linux.none)  { ret 6; }
    var linux_tgt:  target.Target = a64_linux.some;
    var darwin_tgt: target.Target = a64_darwin.some;
    var x64_tgt:    target.Target = x64_linux.some;

    if (!defines_dit_cell(?linux_tgt, LINK_EXE))        { ret 7; }
    if (!defines_dit_cell(?darwin_tgt, LINK_EXE))       { ret 8; }
    if (defines_dit_cell(?linux_tgt, LINK_SHARED))      { ret 9; }
    if (defines_dit_cell(?linux_tgt, LINK_RELOCATABLE)) { ret 10; }
    if (defines_dit_cell(?x64_tgt, LINK_EXE))           { ret 11; }
    if (sel a64_windows.some) {
        var windows_tgt: target.Target = a64_windows.some;
        if (defines_dit_cell(?windows_tgt, LINK_EXE)) { ret 12; }
    }

    var cell:  of.ObjectImage;
    val set_r: res[bool, fail.Fail] = synthesize_runtime_needs(?s, ?linux_tgt, ?inputs[0], 2, LINK_EXE, ?cell);
    if (sel set_r.err) { ret 13; }
    if (!set_r.ok)     { ret 13; }
    val set_value: i32 = nt_cell_value(?cell);
    obj.dnit(?cell);
    if (set_value != 1) { ret 14; }

    val clear_r: res[bool, fail.Fail] = synthesize_runtime_needs(?s, ?darwin_tgt, ?inputs[0], 1, LINK_EXE, ?cell);
    if (sel clear_r.err) { ret 15; }
    if (!clear_r.ok)     { ret 15; }
    val clear_value: i32 = nt_cell_value(?cell);
    obj.dnit(?cell);
    if (clear_value != 0) { ret 16; }

    val none_r: res[bool, fail.Fail] = synthesize_runtime_needs(?s, ?x64_tgt, ?inputs[0], 2, LINK_EXE, ?cell);
    if (sel none_r.err) { ret 17; }
    if (none_r.ok)      { ret 17; }
    val shared_r: res[bool, fail.Fail] = synthesize_runtime_needs(?s, ?linux_tgt, ?inputs[0], 2, LINK_SHARED, ?cell);
    if (sel shared_r.err) { ret 18; }
    if (shared_r.ok)      { ret 18; }
    ret 0;
}
