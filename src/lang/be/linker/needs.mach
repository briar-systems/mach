# the runtime needs a linked executable records for its start code.
# codegen marks a module that multiplies a secret in a cell admitted only under
# PSTATE.DIT with the local absolute symbol `ct.DIT_NEED_MARKER`; the link
# unions the marks and, on a target whose os declares the mode guaranteed,
# appends one synthetic input defining `ct.DIT_REQUIRED_CELL`: a hidden
# one-byte read-only object the std start code reads, 1 when any input carries
# the mark and 0 otherwise. the cell is an ordinary input, so resolution and
# dead-stripping treat it like any other definition: a start code that never
# reads it leaves nothing in the image. a target whose os declares nothing gets
# no cell, and its DIT rows are refused before any mark can exist
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.be.obj;
use mach.lang.ct;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.session;
use lang_target:      mach.lang.target;
use catalog_artifact: mach.lang.target.catalog.artifact;
use target_of:        mach.lang.target.of;
use target_testing:   mach.lang.target.testing;

use mach.lang.be.linker.common.lt_image;
use mach.lang.be.linker.common.lt_name;
use mach.lang.be.linker.common.name_intern;

# whether any input carries the DIT mark: the per-module fact, unioned
fun inputs_need_dit(s: *session.Session, modules: *target_of.ObjectImage, module_count: u32) res[bool, fail.Fail] {
    if (modules == nil) { ret res[bool, fail.Fail].ok{false}; }
    val marker_r: res[intern.StrId, fail.Fail] = name_intern(s, ct.DIT_NEED_MARKER);
    if (sel marker_r.err) { ret res[bool, fail.Fail].err{marker_r.err}; }
    val marker: intern.StrId = marker_r.ok;
    var m:      u32          = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *target_of.Symbol = ?modules[m].symbols[sy];
            if (intern.str_same(sym.name, marker) && target_of.section_is_absolute(sym.section)
                && sym.absolute_value == ct.DIT_NEED_VALUE) { ret res[bool, fail.Fail].ok{true}; }
            sy = sy + 1;
        }
        m = m + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

# whether a link of this mode on this target defines the cell: an executable on
# an os that declares the DIT guarantee for the instruction set. a shared
# library runs no start code of its own and records nothing
fun defines_dit_cell(tgt: *lang_target.Binding, mode: catalog_artifact.Kind) bool {
    if (mode != catalog_artifact.EXECUTABLE) { ret false; }
    ret lang_target.dit_mode_guaranteed(?tgt.target);
}

# the synthetic input carrying the cell; false when this link defines none
pub fun synthesize_runtime_needs(s: *session.Session, tgt: *lang_target.Binding,
    modules: *target_of.ObjectImage, module_count: u32, mode: catalog_artifact.Kind,
    out: *target_of.ObjectImage) res[bool, fail.Fail] {
    if (!defines_dit_cell(tgt, mode)) { ret res[bool, fail.Fail].ok{false}; }
    val alloc: *A.Allocator = s.alloc;

    val needed: res[bool, fail.Fail] = inputs_need_dit(s, modules, module_count);
    if (sel needed.err) { ret needed; }
    var value: u8 = 0;
    if (needed.ok) { value = 1; }

    val image_name_r: res[intern.StrId, fail.Fail] = name_intern(s, "<runtime-needs>");
    if (sel image_name_r.err) { ret res[bool, fail.Fail].err{image_name_r.err}; }
    val section_name_r: res[intern.StrId, fail.Fail] = name_intern(s, ".rodata");
    if (sel section_name_r.err) { ret res[bool, fail.Fail].err{section_name_r.err}; }
    val cell_name_r: res[intern.StrId, fail.Fail] = name_intern(s, ct.DIT_REQUIRED_CELL);
    if (sel cell_name_r.err) { ret res[bool, fail.Fail].err{cell_name_r.err}; }
    val image_name:   intern.StrId                          = image_name_r.ok;
    val section_name: intern.StrId                          = section_name_r.ok;
    val cell_name:    intern.StrId                          = cell_name_r.ok;
    val image_r:      res[target_of.ObjectImage, fail.Fail] = obj.image_init(alloc, ?s.interner, image_name);
    if (sel image_r.err) { ret res[bool, fail.Fail].err{image_r.err}; }
    @out = image_r.ok;

    val bytes_r: res[*u8, A.Error] = A.allocate[u8](alloc, 1::usize);
    if (sel bytes_r.err) {
        obj.dnit(out);
        ret res[bool, fail.Fail].err{fail.refused(bytes_r.err)};
    }
    val bytes: *u8 = bytes_r.ok;
    bytes[0] = value;

    var sec: target_of.Section;
    sec.name  = section_name;
    sec.kind  = target_of.SK_RODATA;
    sec.bytes = bytes;
    sec.len   = 1;
    sec.align = 1;
    sec.flags = 0;
    val sec_r: res[u32, fail.Fail] = target_of.section_install(out, ?sec);
    if (sel sec_r.err) {
        A.deallocate[u8](alloc, bytes, 1::usize);
        obj.dnit(out);
        ret res[bool, fail.Fail].err{sec_r.err};
    }

    var sym: target_of.Symbol;
    sym.name           = cell_name;
    sym.section        = target_of.section_id(sec_r.ok);
    sym.offset         = 0;
    sym.size           = 1;
    sym.flags          = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_OBJECT | target_of.SYM_OBJ_FLAG_HIDDEN;
    sym.fallback       = target_of.SYMBOL_NONE;
    sym.align          = 1;
    sym.absolute_value = 0;
    val sym_r: res[u32, fail.Fail] = target_of.symbol_add(out, sym);
    if (sel sym_r.err) {
        obj.dnit(out);
        ret res[bool, fail.Fail].err{sym_r.err};
    }
    val valid: err[fail.Fail] = target_of.validate_owned_object_or_dnit(out);
    if (sel valid.err) { ret res[bool, fail.Fail].err{valid.err}; }
    ret res[bool, fail.Fail].ok{true};
}

#[testing]
fun nt_marker(s: *session.Session, value: u64) target_of.Symbol {
    var sym: target_of.Symbol;
    sym.name           = lt_name(s, ct.DIT_NEED_MARKER);
    sym.section        = target_of.absolute_section();
    sym.offset         = 0;
    sym.size           = 0;
    sym.flags          = target_of.SYM_OBJ_FLAG_OBJECT;
    sym.fallback       = target_of.SYMBOL_NONE;
    sym.align          = 1;
    sym.absolute_value = value;
    ret sym;
}

#[testing]
fun nt_select(reg: *lang_target.TargetRegistry, isa: str, os: str, abi: str) opt[lang_target.Binding] {
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.select(reg, isa, os, abi);
    if (sel tr.err) { ret opt[lang_target.Binding].none{}; }
    ret opt[lang_target.Binding].some{tr.ok};
}

#[testing]
fun nt_cell_value(img: *target_of.ObjectImage) i32 {
    if (img.section_count != 1 || img.symbol_count != 1) { ret -1; }
    val sym: *target_of.Symbol = ?img.symbols[0];
    if (sym.size != 1 || target_of.section_index(sym.section) != 0)                                           { ret -2; }
    if ((sym.flags & target_of.SYM_OBJ_FLAG_HIDDEN) == 0 || (sym.flags & target_of.SYM_OBJ_FLAG_GLOBAL) == 0) { ret -3; }
    if (img.sections[0].kind != target_of.SK_RODATA || img.sections[0].len != 1)                              { ret -4; }
    ret img.sections[0].bytes[0]::i32;
}

# the cell exists exactly on an executable link for a target whose os declares
# the guarantee, and reads the union of the input marks
test synthesize_runtime_needs__cell_follows_the_declaration_and_the_marks {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var plain_syms: [1]target_of.Symbol;
    plain_syms[0]      = nt_marker(?s, 0);
    plain_syms[0].name = lt_name(?s, "unrelated_absolute");
    var marked_syms: [1]target_of.Symbol;
    marked_syms[0] = nt_marker(?s, ct.DIT_NEED_VALUE);
    var stale_syms: [1]target_of.Symbol;
    stale_syms[0] = nt_marker(?s, 0);

    var inputs: [2]target_of.ObjectImage;
    inputs[0] = lt_image(?s, lt_name(?s, "plain"), nil, 0, ?plain_syms[0], 1, nil, 0);
    inputs[1] = lt_image(?s, lt_name(?s, "marked"), nil, 0, ?marked_syms[0], 1, nil, 0);
    var stale: [1]target_of.ObjectImage;
    stale[0] = lt_image(?s, lt_name(?s, "stale"), nil, 0, ?stale_syms[0], 1, nil, 0);

    val both:  res[bool, fail.Fail] = inputs_need_dit(?s, ?inputs[0], 2);
    val plain: res[bool, fail.Fail] = inputs_need_dit(?s, ?inputs[0], 1);
    val old:   res[bool, fail.Fail] = inputs_need_dit(?s, ?stale[0], 1);
    val empty: res[bool, fail.Fail] = inputs_need_dit(?s, nil, 0);
    if (!(sel both.ok && both.ok))    { ret 2; }
    if (!(sel plain.ok && !plain.ok)) { ret 3; }
    if (!(sel old.ok && !old.ok))     { ret 4; }
    if (!(sel empty.ok && !empty.ok)) { ret 5; }

    val a64_linux:  opt[lang_target.Binding] = nt_select(lang_target.t_registry(), "aarch64", "linux", "aapcs64");
    val a64_darwin: opt[lang_target.Binding] = nt_select(lang_target.t_registry(), "aarch64", "darwin", "aapcs64");
    val x64_linux:  opt[lang_target.Binding] = nt_select(lang_target.t_registry(), "x86_64", "linux", "sysv64");
    if (sel a64_linux.none)  { ret 6; }
    if (sel a64_darwin.none) { ret 6; }
    if (sel x64_linux.none)  { ret 6; }
    var linux_tgt:  lang_target.Binding = a64_linux.some;
    var darwin_tgt: lang_target.Binding = a64_darwin.some;
    var x64_tgt:    lang_target.Binding = x64_linux.some;

    var cell:  target_of.ObjectImage;
    val set_r: res[bool, fail.Fail] = synthesize_runtime_needs(?s, ?linux_tgt, ?inputs[0], 2, catalog_artifact.EXECUTABLE, ?cell);
    if (sel set_r.err) { ret 13; }
    if (!set_r.ok)     { ret 13; }
    val set_value: i32 = nt_cell_value(?cell);
    obj.dnit(?cell);
    if (set_value != 1) { ret 14; }

    val clear_r: res[bool, fail.Fail] = synthesize_runtime_needs(?s, ?darwin_tgt, ?inputs[0], 1, catalog_artifact.EXECUTABLE, ?cell);
    if (sel clear_r.err) { ret 15; }
    if (!clear_r.ok)     { ret 15; }
    val clear_value: i32 = nt_cell_value(?cell);
    obj.dnit(?cell);
    if (clear_value != 0) { ret 16; }

    val none_r: res[bool, fail.Fail] = synthesize_runtime_needs(?s, ?x64_tgt, ?inputs[0], 2, catalog_artifact.EXECUTABLE, ?cell);
    if (sel none_r.err) { ret 17; }
    if (none_r.ok)      { ret 17; }
    val shared_r: res[bool, fail.Fail] = synthesize_runtime_needs(?s, ?linux_tgt, ?inputs[0], 2, catalog_artifact.SHARED, ?cell);
    if (sel shared_r.err) { ret 18; }
    if (shared_r.ok)      { ret 18; }
    ret 0;
}
