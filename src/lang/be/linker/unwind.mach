# an unwind index entry: its function start, personality and lsda are the
# relocations of their fields, SYMBOL_NONE for a field the entry leaves empty
rec NativeInput {
    module:      u32;
    reloc:       u32;
    size:        u32;
    encoding:    u32;
    personality: u32;
    lsda:        u32;
}

# what the unwind tables take from the link's foreign objects, gathered when
# the tables are reserved and resolved once the layout is final
pub rec UnwindPlan {
    natives:      *NativeInput;
    native_count: u32;
    native_cap:   u32;
}

pub fun init_unwind_plan(plan: *UnwindPlan) {
    plan.natives      = nil;
    plan.native_count = 0;
    plan.native_cap   = 0;
}

pub fun free_unwind_plan(alloc: *A.Allocator, plan: *UnwindPlan) {
    if (plan.natives != nil && plan.native_cap > 0) {
        A.deallocate[NativeInput](alloc, plan.natives, plan.native_cap::usize);
    }
    init_unwind_plan(plan);
}

# an image whose format builds unwind tables takes each foreign object's own
# unwind input into them: its frame descriptions are placed in the frames
# table, and its unwind index is read rather than placed. any other link
# places those sections as the merge would
pub fun claim_unwind_inputs(tgt: *lang_target.Target, builds_tables: bool, modules: *target_of.ObjectImage, module_count: u32,
    sec_base: *u32, placements: *Placement) {
    if (!builds_tables || tgt.of == nil || tgt.of.unwind_shape == nil) { ret; }
    var m: u32 = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val flags: u32 = modules[m].sections[sc].flags;
            if ((flags & target_of.SEC_FLAG_UNWIND_FRAMES) != 0) { placements[sec_base[m] + sc].claim = PLACE_UNWIND_FRAMES; }
            or ((flags & target_of.SEC_FLAG_UNWIND_INDEX) != 0)  { placements[sec_base[m] + sc].claim = PLACE_UNWIND_INDEX; }
            sc = sc + 1;
        }
        m = m + 1;
    }
}

# reserves the format's unwind tables at the end of the merged code, before
# anything is given an address: their size follows from the frame records of
# the functions the link keeps and from what its foreign objects bring, and the
# writer fills them once the layout is final. the foreign frame descriptions
# are placed at the start of the frames table here, so the link relocates them
# where they end up. true when a table was reserved, which moves everything
# after the code
pub fun reserve_unwind_tables(s: *session.Session, tgt: *lang_target.Target,
    modules: *target_of.ObjectImage, module_count: u32, sec_base: *u32, atoms: *AtomPlan,
    merged: *MergedSection, groups: *SectionGroups, placements: *Placement, plan: *UnwindPlan) res[bool, fail.Fail] {
    if (tgt.of == nil || tgt.of.unwind_shape == nil) { ret res[bool, fail.Fail].ok{false}; }

    var foreign:  target_of.ForeignUnwind = target_of.ForeignUnwind{frames_len: 0, fde_count: 0, native_count: 0};
    val measured: err[fail.Fail]          = measure_foreign(s, modules, module_count, sec_base, atoms, placements, plan, ?foreign);
    if (sel measured.err) { ret res[bool, fail.Fail].err{measured.err}; }

    var count: u32 = 0;
    var m:     u32 = 0;
    for (m < module_count) {
        var fi: u32 = 0;
        for (fi < modules[m].frame_count) {
            if (frame_kept(modules, m, sec_base, atoms, fi)) { count = count + 1; }
            fi = fi + 1;
        }
        m = m + 1;
    }
    if (count == 0 && foreign.frames_len == 0 && foreign.native_count == 0) { ret res[bool, fail.Fail].ok{false}; }

    var kept: *target_of.FrameUnwind = nil;
    if (count > 0) {
        val ar: res[*target_of.FrameUnwind, A.Error] = A.allocate[target_of.FrameUnwind](s.alloc, count::usize);
        if (sel ar.err) { ret res[bool, fail.Fail].err{fail.refused(ar.err)}; }
        kept = ar.ok;
    }
    var n: u32 = 0;
    m = 0;
    for (m < module_count) {
        var fi: u32 = 0;
        for (fi < modules[m].frame_count) {
            if (frame_kept(modules, m, sec_base, atoms, fi)) {
                kept[n] = modules[m].frames[fi];
                n       = n + 1;
            }
            fi = fi + 1;
        }
        m = m + 1;
    }
    val shape_r: res[target_of.UnwindShape, fail.Fail] = tgt.of.unwind_shape(tgt.object.arch_id, kept, count, ?foreign);
    if (kept != nil)     { A.deallocate[target_of.FrameUnwind](s.alloc, kept, count::usize); }
    if (sel shape_r.err) { ret res[bool, fail.Fail].err{shape_r.err}; }
    var shape: target_of.UnwindShape = shape_r.ok;
    if (foreign.frames_len > shape.frames.size) {
        ret res[bool, fail.Fail].err{fail.message("linker: the format reserved no room for the foreign objects' frame descriptions")};
    }

    var start: u32                  = 0;
    val ri:    res[bool, fail.Fail] = reserve_table(s, merged, groups, ?shape.index, target_of.SEC_FLAG_UNWIND_INDEX, ?start);
    if (sel ri.err) { ret ri; }
    val rf: res[bool, fail.Fail] = reserve_table(s, merged, groups, ?shape.frames, target_of.SEC_FLAG_UNWIND_FRAMES, ?start);
    if (sel rf.err) { ret rf; }
    if (rf.ok)      { place_foreign_frames(modules, module_count, sec_base, atoms, placements, start); }
    ret res[bool, fail.Fail].ok{ri.ok || rf.ok};
}

# a frame record whose function the link keeps
fun frame_kept(modules: *target_of.ObjectImage, m: u32, sec_base: *u32, atoms: *AtomPlan, fi: u32) bool {
    val fr:  *target_of.FrameUnwind = ?modules[m].frames[fi];
    val sec: u32                    = target_of.section_index(fr.section);
    if (sec >= modules[m].section_count || modules[m].sections[sec].kind != target_of.SK_TEXT) { ret false; }
    ret !atom_offset_dead(atoms, sec_base[m] + sec, fr.offset);
}

fun object_name(s: *session.Session, img: *target_of.ObjectImage) str {
    val nm: opt[str] = intern.lookup(?s.interner, img.name);
    if (sel nm.some) { ret nm.some; }
    ret "<input>";
}

fun foreign_refusal(s: *session.Session, img: *target_of.ObjectImage, k: diagnostic_kind.Kind, what: str) fail.Fail {
    ret fail.user(k, join3(s, "link: object '", object_name(s, img), what, "link: an input object's unwind input is malformed"));
}

# the foreign unwind input the link keeps: the live bytes of each object's
# frame descriptions and the fdes among them, and each entry of its unwind
# index, which `plan` keeps for the writer
fun measure_foreign(s: *session.Session, modules: *target_of.ObjectImage, module_count: u32, sec_base: *u32,
    atoms: *AtomPlan, placements: *Placement, plan: *UnwindPlan, foreign: *target_of.ForeignUnwind) err[fail.Fail] {
    var m: u32 = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val flat: u32 = sec_base[m] + sc;
            if (placements[flat].claim == PLACE_UNWIND_FRAMES) {
                val mr: err[fail.Fail] = measure_frames(s, modules, m, sc, flat, atoms, foreign);
                if (sel mr.err) { ret mr; }
            }
            or (placements[flat].claim == PLACE_UNWIND_INDEX) {
                val ir: err[fail.Fail] = read_index(s, modules, m, sc, plan);
                if (sel ir.err) { ret ir; }
            }
            sc = sc + 1;
        }
        m = m + 1;
    }
    foreign.native_count = plan.native_count;
    ret err[fail.Fail].ok{};
}

# one object's frame descriptions: they are carried whole, so they end where
# the section does, and each live fde's cie pointer is rebased across what the
# link dropped between the two
fun measure_frames(s: *session.Session, modules: *target_of.ObjectImage, m: u32, sc: u32, flat: u32,
    atoms: *AtomPlan, foreign: *target_of.ForeignUnwind) err[fail.Fail] {
    val sec:  *target_of.Section = ?modules[m].sections[sc];
    val live: u32                = atom_live_len(atoms, flat, sec.len);
    if (live == 0) { ret err[fail.Fail].ok{}; }
    if (sec.bytes == nil || live % 4 != 0) {
        ret err[fail.Fail].err{foreign_refusal(s, ?modules[m], diagnostic_kind.OBJECT_MALFORMED, "' has frame descriptions that are not whole four-byte entries")};
    }
    val rebase: bool  = live != sec.len;
    var off:    usize = 0;
    for (off < sec.len::usize) {
        val er: res[opt[cfi.EhEntry], fail.Fail] = cfi.eh_entry(sec.bytes, sec.len::usize, off);
        if (sel er.err) { ret err[fail.Fail].err{er.err}; }
        if (sel er.ok.none) {
            ret err[fail.Fail].err{foreign_refusal(s, ?modules[m], diagnostic_kind.OBJECT_UNSUPPORTED, "' ends its frame descriptions before its section does; a terminator belongs to the image, not to an object")};
        }
        val e: cfi.EhEntry = er.ok.some;
        if (!e.cie && !atom_offset_dead(atoms, flat, e.off::u32)) {
            foreign.fde_count = foreign.fde_count + 1;
            if (rebase) {
                if (atom_offset_dead(atoms, flat, e.cie_off::u32)) {
                    ret err[fail.Fail].err{foreign_refusal(s, ?modules[m], diagnostic_kind.OBJECT_MALFORMED, "' keeps a frame description whose cie the link dropped")};
                }
                val field: u32 = atom_live_offset(atoms, flat, (e.off + 4)::u32);
                val cie:   u32 = atom_live_offset(atoms, flat, e.cie_off::u32);
                bin.write_u32_le(sec.bytes, e.off + 4, field - cie);
            }
        }
        off = off + e.size;
    }
    foreign.frames_len = foreign.frames_len + live::usize;
    ret err[fail.Fail].ok{};
}

# one object's unwind index: an entry per function, its start, personality and
# lsda the relocations of their fields
fun read_index(s: *session.Session, modules: *target_of.ObjectImage, m: u32, sc: u32, plan: *UnwindPlan) err[fail.Fail] {
    val img: *target_of.ObjectImage = ?modules[m];
    val sec: *target_of.Section     = ?img.sections[sc];
    if (sec.len == 0) { ret err[fail.Fail].ok{}; }
    if (sec.bytes == nil || sec.len % COMPACT_ENTRY_SIZE != 0) {
        ret err[fail.Fail].err{foreign_refusal(s, img, diagnostic_kind.OBJECT_MALFORMED, "' has a compact unwind section that is not whole entries")};
    }
    val entries: u32 = sec.len / COMPACT_ENTRY_SIZE;
    val first:   u32 = plan.native_count;
    var k:       u32 = 0;
    for (k < entries) {
        val base: usize = (k * COMPACT_ENTRY_SIZE)::usize;
        if (plan.native_count == plan.native_cap) {
            val grown: err[fail.Fail] = grow_cap[NativeInput](s.alloc, ?plan.natives, ?plan.native_cap, 16);
            if (sel grown.err) { ret grown; }
        }
        plan.natives[plan.native_count] = NativeInput{module: m, reloc: target_of.SYMBOL_NONE,
            size:        bin.read_u32_le(sec.bytes, base + 8), encoding: bin.read_u32_le(sec.bytes, base + 12),
            personality: target_of.SYMBOL_NONE, lsda: target_of.SYMBOL_NONE};
        plan.native_count = plan.native_count + 1;
        k                 = k + 1;
    }
    var ri: u32 = 0;
    for (ri < img.reloc_count) {
        val r: *target_of.Relocation = ?img.relocations[ri];
        if (target_of.section_index(r.section) == sc && r.offset < sec.len) {
            val entry: *NativeInput = ?plan.natives[first + r.offset / COMPACT_ENTRY_SIZE];
            val at:    u32          = r.offset % COMPACT_ENTRY_SIZE;
            if (at == 0)                   { entry.reloc = ri; }
            or (at == COMPACT_PERSONALITY) { entry.personality = ri; }
            or (at == COMPACT_LSDA)        { entry.lsda = ri; }
        }
        ri = ri + 1;
    }
    k = 0;
    for (k < entries) {
        val base:  usize        = (k * COMPACT_ENTRY_SIZE)::usize;
        val entry: *NativeInput = ?plan.natives[first + k];
        if (entry.reloc == target_of.SYMBOL_NONE) {
            ret err[fail.Fail].err{foreign_refusal(s, img, diagnostic_kind.OBJECT_MALFORMED, "' has a compact unwind entry that names no function")};
        }
        if ((entry.personality == target_of.SYMBOL_NONE && bin.read_u64_le(sec.bytes, base + COMPACT_PERSONALITY::usize) != 0)
            || (entry.lsda == target_of.SYMBOL_NONE && bin.read_u64_le(sec.bytes, base + COMPACT_LSDA::usize) != 0)) {
            ret err[fail.Fail].err{foreign_refusal(s, img, diagnostic_kind.OBJECT_MALFORMED, "' has a compact unwind entry that names a personality or an lsda without relocating it")};
        }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

# the foreign frame descriptions, in link order from the start of the frames
# table, back to back: an entry needs only four-byte alignment, and a gap would
# read as the table's end
fun place_foreign_frames(modules: *target_of.ObjectImage, module_count: u32, sec_base: *u32, atoms: *AtomPlan,
    placements: *Placement, start: u32) {
    var cursor: u32 = start;
    var m:      u32 = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val flat: u32 = sec_base[m] + sc;
            if (placements[flat].claim == PLACE_UNWIND_FRAMES) {
                val live: u32 = atom_live_len(atoms, flat, modules[m].sections[sc].len);
                placements[flat].merged_index = target_of.SK_TEXT::u32;
                placements[flat].offset       = cursor;
                placements[flat].vaddr        = 0;
                placements[flat].extent       = live;
                cursor                        = cursor + live;
            }
            sc = sc + 1;
        }
        m = m + 1;
    }
}

# `start` receives where the table begins in the code
fun reserve_table(s: *session.Session, merged: *MergedSection, groups: *SectionGroups,
    shape: *target_of.TableShape, flag: u32, start: *u32) res[bool, fail.Fail] {
    if (shape.size == 0) { ret res[bool, fail.Fail].ok{false}; }
    if (shape.align == 0) {
        ret res[bool, fail.Fail].err{fail.message("linker: the format declared an unaligned unwind table")};
    }
    val text:    u32                 = target_of.SK_TEXT::u32;
    val start_r: res[u64, fail.Fail] = align_up_u64_checked(merged[text].len::u64, shape.align::u64);
    if (sel start_r.err) { ret res[bool, fail.Fail].err{start_r.err}; }
    val at: u64 = start_r.ok;
    if (shape.size::u64 > 0xFFFFFFFF - at) {
        ret res[bool, fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "linker: the unwind tables take the code past the maximum section size")};
    }
    val end: u64 = at + shape.size::u64;
    merged[text].used = true;
    if (merged[text].align < shape.align) { merged[text].align = shape.align; }
    merged[text].len = end::u32;

    val name_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, shape.name);
    if (sel name_r.err) { ret res[bool, fail.Fail].err{fail.refused(name_r.err)}; }
    val ga: res[u32, fail.Fail] = section_group_add(s.alloc, groups, text, name_r.ok, flag);
    if (sel ga.err) { ret res[bool, fail.Fail].err{ga.err}; }
    val gi: u32 = ga.ok;
    groups.items[gi].align  = shape.align;
    groups.items[gi].base   = at::u32;
    groups.items[gi].cursor = end::u32;
    groups.items[gi].len    = shape.size::u32;
    @start                  = at::u32;
    ret res[bool, fail.Fail].ok{true};
}

# the functions the foreign unwind indexes describe, at their final addresses,
# once the layout is final, with the slot each one's personality is read
# through and the address of its lsda; an entry whose function the link
# collected is dropped. `count` entries the caller frees
pub fun resolve_native_unwind(s: *session.Session, plan: *UnwindPlan, modules: *target_of.ObjectImage,
    placements: *Placement, sec_base: *u32, merged_to_out: *u32, out_img: *target_of.ObjectImage,
    sym_locs: *map.Map[intern.StrId, SymbolLoc], dyn: *DynState, local_got: *LocalGotPlan,
    format: *target_of.OfVTable, arch: *isa.IsaVTable, image_base: u64, atoms: *AtomPlan, count: *u32) res[*target_of.NativeUnwind, fail.Fail] {
    @count = 0;
    if (plan.native_count == 0) { ret res[*target_of.NativeUnwind, fail.Fail].ok{nil}; }
    val ar: res[*target_of.NativeUnwind, A.Error] = A.allocate[target_of.NativeUnwind](s.alloc, plan.native_count::usize);
    if (sel ar.err) { ret res[*target_of.NativeUnwind, fail.Fail].err{fail.refused(ar.err)}; }
    val out: *target_of.NativeUnwind = ar.ok;
    var w:   u32                     = 0;
    var i:   u32                     = 0;
    for (i < plan.native_count) {
        val ni: *NativeInput             = ?plan.natives[i];
        val at: res[opt[u64], fail.Fail] = relocation_target_vaddr(s, modules, ni.module, ni.reloc,
            placements, sec_base, merged_to_out, out_img, sym_locs, format, arch, image_base, atoms);
        if (sel at.err) {
            A.deallocate[target_of.NativeUnwind](s.alloc, out, plan.native_count::usize);
            ret res[*target_of.NativeUnwind, fail.Fail].err{at.err};
        }
        if (sel at.ok.some) {
            if (ni.size > 0) {
                val handler: res[target_of.NativeUnwind, fail.Fail] = resolve_handler(s, ni, modules, placements, sec_base,
                    merged_to_out, out_img, sym_locs, dyn, local_got, format, arch, image_base, atoms);
                if (sel handler.err) {
                    A.deallocate[target_of.NativeUnwind](s.alloc, out, plan.native_count::usize);
                    ret res[*target_of.NativeUnwind, fail.Fail].err{handler.err};
                }
                out[w]          = handler.ok;
                out[w].vaddr    = at.ok.some;
                out[w].size     = ni.size;
                out[w].encoding = ni.encoding;
                w               = w + 1;
            }
        }
        i = i + 1;
    }
    if (w < plan.native_count) {
        if (w == 0) {
            A.deallocate[target_of.NativeUnwind](s.alloc, out, plan.native_count::usize);
            ret res[*target_of.NativeUnwind, fail.Fail].ok{nil};
        }
        val rr: res[*target_of.NativeUnwind, A.Error] = A.reallocate[target_of.NativeUnwind](s.alloc, out, plan.native_count::usize, w::usize);
        if (sel rr.err) {
            A.deallocate[target_of.NativeUnwind](s.alloc, out, plan.native_count::usize);
            ret res[*target_of.NativeUnwind, fail.Fail].err{fail.refused(rr.err)};
        }
        @count = w;
        ret res[*target_of.NativeUnwind, fail.Fail].ok{rr.ok};
    }
    @count = w;
    ret res[*target_of.NativeUnwind, fail.Fail].ok{out};
}

# the personality and lsda an unwind index entry names, none for a field it
# leaves empty
fun resolve_handler(s: *session.Session, ni: *NativeInput, modules: *target_of.ObjectImage,
    placements: *Placement, sec_base: *u32, merged_to_out: *u32, out_img: *target_of.ObjectImage,
    sym_locs: *map.Map[intern.StrId, SymbolLoc], dyn: *DynState, local_got: *LocalGotPlan,
    format: *target_of.OfVTable, arch: *isa.IsaVTable, image_base: u64, atoms: *AtomPlan) res[target_of.NativeUnwind, fail.Fail] {
    var nv: target_of.NativeUnwind = target_of.NativeUnwind{vaddr: 0, size: 0, encoding: 0, personality: target_of.no_personality(), lsda: 0};
    if (ni.personality != target_of.SYMBOL_NONE) {
        val p: res[target_of.UnwindPersonality, fail.Fail] = personality_slot(s, modules, ni.module, ni.personality,
            placements, sec_base, merged_to_out, out_img, sym_locs, dyn, local_got, format, arch, image_base, atoms);
        if (sel p.err) { ret res[target_of.NativeUnwind, fail.Fail].err{p.err}; }
        nv.personality = p.ok;
    }
    if (ni.lsda != target_of.SYMBOL_NONE) {
        val l: res[opt[u64], fail.Fail] = relocation_target_vaddr(s, modules, ni.module, ni.lsda,
            placements, sec_base, merged_to_out, out_img, sym_locs, format, arch, image_base, atoms);
        if (sel l.err) { ret res[target_of.NativeUnwind, fail.Fail].err{l.err}; }
        if (sel l.ok.none) {
            ret res[target_of.NativeUnwind, fail.Fail].err{foreign_refusal(s, ?modules[ni.module], diagnostic_kind.OBJECT_MALFORMED, "' has a compact unwind entry whose lsda the link does not keep")};
        }
        nv.lsda = l.ok.some;
    }
    ret res[target_of.NativeUnwind, fail.Fail].ok{nv};
}
