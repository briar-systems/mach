use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.intern;
use mach.lang.session;
use mach.lang.target;
use mach.lang.target.of;

use mach.lang.be.linker.atoms.AtomPlan;
use mach.lang.be.linker.atoms.atom_offset_dead;
use mach.lang.be.linker.merge.MergedSection;
use mach.lang.be.linker.merge.SectionGroups;
use mach.lang.be.linker.merge.align_up_u64_checked;
use mach.lang.be.linker.merge.section_group_add;

# reserves the format's unwind tables at the end of the merged code, before
# anything is given an address: their size follows from the frame records of
# the functions the link keeps, and the writer fills them once the layout is
# final. true when a table was reserved, which moves everything after the code
pub fun reserve_unwind_tables(s: *session.Session, tgt: *target.Target,
    modules: *of.ObjectImage, module_count: u32, sec_base: *u32, atoms: *AtomPlan,
    merged: *MergedSection, groups: *SectionGroups) res[bool, fail.Fail] {
    if (tgt.of == nil || tgt.of.unwind_shape == nil) { ret res[bool, fail.Fail].ok{false}; }

    var count: u32 = 0;
    var m:     u32 = 0;
    for (m < module_count) {
        var fi: u32 = 0;
        for (fi < modules[m].frame_count) {
            if (frame_kept(modules, m, sec_base, atoms, fi)) { count = count + 1; }
            fi = fi + 1;
        }
        m = m + 1;
    }
    if (count == 0) { ret res[bool, fail.Fail].ok{false}; }

    val ar: res[*of.FrameUnwind, A.Error] = A.allocate[of.FrameUnwind](s.alloc, count::usize);
    if (sel ar.err) { ret res[bool, fail.Fail].err{fail.refused(ar.err)}; }
    val kept: *of.FrameUnwind = ar.ok;
    var n:    u32             = 0;
    m = 0;
    for (m < module_count) {
        var fi: u32 = 0;
        for (fi < modules[m].frame_count) {
            if (frame_kept(modules, m, sec_base, atoms, fi)) {
                kept[n] = modules[m].frames[fi];
                n       = n + 1;
            }
            fi = fi + 1;
        }
        m = m + 1;
    }
    val shape_r: res[of.UnwindShape, fail.Fail] = tgt.of.unwind_shape(tgt.object.arch_id, kept, count);
    A.deallocate[of.FrameUnwind](s.alloc, kept, count::usize);
    if (sel shape_r.err) { ret res[bool, fail.Fail].err{shape_r.err}; }
    var shape: of.UnwindShape = shape_r.ok;

    val ri: res[bool, fail.Fail] = reserve_table(s, merged, groups, ?shape.index, of.SEC_FLAG_UNWIND_INDEX);
    if (sel ri.err) { ret ri; }
    val rf: res[bool, fail.Fail] = reserve_table(s, merged, groups, ?shape.frames, of.SEC_FLAG_UNWIND_FRAMES);
    if (sel rf.err) { ret rf; }
    ret res[bool, fail.Fail].ok{ri.ok || rf.ok};
}

# a frame record whose function the link keeps
fun frame_kept(modules: *of.ObjectImage, m: u32, sec_base: *u32, atoms: *AtomPlan, fi: u32) bool {
    val fr:  *of.FrameUnwind = ?modules[m].frames[fi];
    val sec: u32             = of.section_index(fr.section);
    if (sec >= modules[m].section_count || modules[m].sections[sec].kind != of.SK_TEXT) { ret false; }
    ret !atom_offset_dead(atoms, sec_base[m] + sec, fr.offset);
}

fun reserve_table(s: *session.Session, merged: *MergedSection, groups: *SectionGroups,
    shape: *of.TableShape, flag: u32) res[bool, fail.Fail] {
    if (shape.size == 0) { ret res[bool, fail.Fail].ok{false}; }
    if (shape.align == 0) {
        ret res[bool, fail.Fail].err{fail.message("linker: the format declared an unaligned unwind table")};
    }
    val text:    u32                 = of.SK_TEXT::u32;
    val start_r: res[u64, fail.Fail] = align_up_u64_checked(merged[text].len::u64, shape.align::u64);
    if (sel start_r.err) { ret res[bool, fail.Fail].err{start_r.err}; }
    val start: u64 = start_r.ok;
    if (shape.size::u64 > 0xFFFFFFFF - start) {
        ret res[bool, fail.Fail].err{fail.message("linker: the unwind tables take the code past the maximum section size")};
    }
    val end: u64 = start + shape.size::u64;
    merged[text].used = true;
    if (merged[text].align < shape.align) { merged[text].align = shape.align; }
    merged[text].len = end::u32;

    val name_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, shape.name);
    if (sel name_r.err) { ret res[bool, fail.Fail].err{fail.refused(name_r.err)}; }
    val ga: res[u32, fail.Fail] = section_group_add(s.alloc, groups, text, name_r.ok, flag);
    if (sel ga.err) { ret res[bool, fail.Fail].err{ga.err}; }
    val gi: u32 = ga.ok;
    groups.items[gi].align  = shape.align;
    groups.items[gi].base   = start::u32;
    groups.items[gi].cursor = end::u32;
    groups.items[gi].len    = shape.size::u32;
    ret res[bool, fail.Fail].ok{true};
}
