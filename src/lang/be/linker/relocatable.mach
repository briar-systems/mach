use A: std.allocator;
use R: std.types.result;
use O: std.types.option;
use std.allocator.page;
use fs: std.filesystem;
use txn: std.filesystem.transaction;
use std.collections.vector.Vector;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use mach.lang.intern;
use mach.lang.target.of;
use mach.lang.target.of.bin;
use mach.lang.target;
use target_testing: mach.lang.target.testing;
use mach.lang.publication;
use output: mach.lang.publication.testing;

pub fun combine(alloc: *A.Allocator, itn: *intern.Interner,
                inputs: *of.ObjectImage, count: u32, machine_flags: u32,
                attributes: *u8, attributes_len: u32) R.Result[of.ObjectImage, str] {
    if (alloc == nil || itn == nil || inputs == nil || count == 0
        || (attributes_len != 0 && attributes == nil)) {
        ret R.err[of.ObjectImage, str]("relocatable: incomplete input ownership");
    }
    var sections: u32 = 0;
    var symbols: u32 = 0;
    var relocations: u32 = 0;
    var frames: u32 = 0;
    var imports: u32 = 0;
    var indirects: u32 = 0;
    var i: u32 = 0;
    for (i < count) {
        val input: *of.ObjectImage = ?inputs[i];
        val valid: R.Result[R.Void, str] = of.validate_object_view(input);
        if (R.is_err[R.Void, str](valid)) { ret R.err[of.ObjectImage, str](R.unwrap_err[R.Void, str](valid)); }
        if (input.interner != itn) { ret R.err[of.ObjectImage, str]("relocatable: input names have a different owner"); }
        if (input.section_count > 0xFFFFFFFF - sections
            || input.symbol_count > 0xFFFFFFFF - symbols
            || input.reloc_count > 0xFFFFFFFF - relocations
            || input.frame_count > 0xFFFFFFFF - frames
            || input.import_count > 0xFFFFFFFF - imports
            || input.indirect_count > 0xFFFFFFFF - indirects) {
            ret R.err[of.ObjectImage, str]("relocatable: combined table exceeds its index range");
        }
        sections = sections + input.section_count;
        symbols = symbols + input.symbol_count;
        relocations = relocations + input.reloc_count;
        frames = frames + input.frame_count;
        imports = imports + input.import_count;
        indirects = indirects + input.indirect_count;
        i = i + 1;
    }
    var output: of.ObjectImage = of.object_image_init(alloc, itn, inputs[0].name);
    var complete: bool = false;
    fin { if (!complete) { of.object_image_dnit(?output); } }
    if (sections > 0) {
        val storage: R.Result[*of.Section, str] = A.allocate[of.Section](alloc, sections::usize);
        if (R.is_err[*of.Section, str](storage)) { ret R.err[of.ObjectImage, str](R.unwrap_err[*of.Section, str](storage)); }
        output.sections = R.unwrap_ok[*of.Section, str](storage);
        output.section_cap = sections;
    }
    if (symbols > 0) {
        val storage: R.Result[*of.Symbol, str] = A.allocate[of.Symbol](alloc, symbols::usize);
        if (R.is_err[*of.Symbol, str](storage)) { ret R.err[of.ObjectImage, str](R.unwrap_err[*of.Symbol, str](storage)); }
        output.symbols = R.unwrap_ok[*of.Symbol, str](storage);
        output.symbol_cap = symbols;
    }
    if (relocations > 0) {
        val storage: R.Result[*of.Relocation, str] = A.allocate[of.Relocation](alloc, relocations::usize);
        if (R.is_err[*of.Relocation, str](storage)) { ret R.err[of.ObjectImage, str](R.unwrap_err[*of.Relocation, str](storage)); }
        output.relocations = R.unwrap_ok[*of.Relocation, str](storage);
        output.reloc_cap = relocations;
    }
    if (frames > 0) {
        val storage: R.Result[*of.FrameUnwind, str] = A.allocate[of.FrameUnwind](alloc, frames::usize);
        if (R.is_err[*of.FrameUnwind, str](storage)) { ret R.err[of.ObjectImage, str](R.unwrap_err[*of.FrameUnwind, str](storage)); }
        output.frames = R.unwrap_ok[*of.FrameUnwind, str](storage);
        output.frame_cap = frames;
    }
    if (imports > 0) {
        val storage: R.Result[*of.ImportDecl, str] = A.allocate[of.ImportDecl](alloc, imports::usize);
        if (R.is_err[*of.ImportDecl, str](storage)) { ret R.err[of.ObjectImage, str](R.unwrap_err[*of.ImportDecl, str](storage)); }
        output.imports = R.unwrap_ok[*of.ImportDecl, str](storage);
        output.import_cap = imports;
    }
    if (indirects > 0) {
        val storage: R.Result[*of.NativeIndirect, str] = A.allocate[of.NativeIndirect](alloc, indirects::usize);
        if (R.is_err[*of.NativeIndirect, str](storage)) { ret R.err[of.ObjectImage, str](R.unwrap_err[*of.NativeIndirect, str](storage)); }
        output.indirects = R.unwrap_ok[*of.NativeIndirect, str](storage);
        output.indirect_cap = indirects;
    }
    if (attributes_len > 0) {
        val storage: R.Result[*u8, str] = A.allocate[u8](alloc, attributes_len::usize);
        if (R.is_err[*u8, str](storage)) { ret R.err[of.ObjectImage, str](R.unwrap_err[*u8, str](storage)); }
        output.attributes = R.unwrap_ok[*u8, str](storage);
        output.attributes_len = attributes_len;
        memory.copy[u8](output.attributes, attributes, attributes_len::usize);
    }
    output.machine_flags = machine_flags;
    i = 0;
    for (i < count) {
        val input: *of.ObjectImage = ?inputs[i];
        val section_base: u32 = output.section_count;
        val symbol_base: u32 = output.symbol_count;
        val relocation_base: u32 = output.reloc_count;
        var j: u32 = 0;
        for (j < input.section_count) {
            var section: of.Section = input.sections[j];
            section.bytes = nil;
            if (section.kind != of.SK_BSS && section.len > 0) {
                val storage: R.Result[*u8, str] = A.allocate[u8](alloc, section.len::usize);
                if (R.is_err[*u8, str](storage)) { ret R.err[of.ObjectImage, str](R.unwrap_err[*u8, str](storage)); }
                section.bytes = R.unwrap_ok[*u8, str](storage);
                memory.copy[u8](section.bytes, input.sections[j].bytes, section.len::usize);
            }
            if (section.native.link_section != 0) { section.native.link_section = section_base + section.native.link_section; }
            if (section.native.link_symbol != 0) { section.native.link_symbol = symbol_base + section.native.link_symbol; }
            if (section.native.format == of.OF_ELF && section.native.kind == of.NATIVE_GROUP) {
                var at: usize = 4;
                for (at < section.len::usize) {
                    bin.write_u32_le(section.bytes, at, bin.read_u32_le(section.bytes, at) + section_base);
                    at = at + 4;
                }
            }
            output.sections[output.section_count] = section;
            output.section_count = output.section_count + 1;
            j = j + 1;
        }
        j = 0;
        for (j < input.symbol_count) {
            var symbol: of.Symbol = input.symbols[j];
            if (symbol.section != of.SECTION_EXTERNAL && symbol.section != of.SECTION_ABSOLUTE) { symbol.section = section_base + symbol.section; }
            if ((symbol.flags & of.SYM_OBJ_FLAG_FALLBACK) != 0) { symbol.fallback = symbol_base + symbol.fallback; }
            output.symbols[output.symbol_count] = symbol;
            output.symbol_count = output.symbol_count + 1;
            j = j + 1;
        }
        j = 0;
        for (j < input.reloc_count) {
            var relocation: of.Relocation = input.relocations[j];
            relocation.section = section_base + relocation.section;
            relocation.sym = symbol_base + relocation.sym;
            if (of.is_difference(relocation.kind)) { relocation.sym2 = symbol_base + relocation.sym2; }
            if (relocation.pair != 0) { relocation.pair = relocation_base + relocation.pair; }
            output.relocations[output.reloc_count] = relocation;
            output.reloc_count = output.reloc_count + 1;
            j = j + 1;
        }
        j = 0;
        for (j < input.frame_count) {
            var frame: of.FrameUnwind = input.frames[j];
            frame.section = section_base + frame.section;
            output.frames[output.frame_count] = frame;
            output.frame_count = output.frame_count + 1;
            j = j + 1;
        }
        j = 0;
        for (j < input.indirect_count) {
            var entry: of.NativeIndirect = input.indirects[j];
            entry.section = section_base + entry.section;
            if (entry.flags == 0) { entry.symbol = symbol_base + entry.symbol; }
            output.indirects[output.indirect_count] = entry;
            output.indirect_count = output.indirect_count + 1;
            j = j + 1;
        }
        j = 0;
        for (j < input.import_count) {
            output.imports[output.import_count] = input.imports[j];
            output.import_count = output.import_count + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    val valid: R.Result[R.Void, str] = of.validate_owned_object(?output);
    if (R.is_err[R.Void, str](valid)) { ret R.err[of.ObjectImage, str](R.unwrap_err[R.Void, str](valid)); }
    complete = true;
    ret R.ok[of.ObjectImage, str](output);
}

test "mach.lang.be.linker.relocatable:combined_native_elf_preserves_group_and_relocation_targets" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    val names: [6]str = [6]str{".combined.first", ".combined.second", ".group",
        "combined_first", "combined_second", "combined_external"};
    var ids: [6]intern.StrId;
    var i: usize = 0;
    for (i < 6) {
        val named: R.Result[intern.StrId, str] = intern.intern(?itn, names[i]);
        if (R.is_err[intern.StrId, str](named)) { ret 1; }
        ids[i] = R.unwrap_ok[intern.StrId, str](named);
        i = i + 1;
    }
    var first_bytes: [8]u8;
    first_bytes[0] = 0xA5;
    var second_bytes: [16]u8;
    var group: [12]u8;
    bin.write_u32_le(?group[0], 0, 1);
    bin.write_u32_le(?group[0], 4, 1);
    bin.write_u32_le(?group[0], 8, of.NATIVE_GROUP_RELOC | 1);
    var first_section: of.Section = of.Section{name: ids[0], kind: of.SK_RODATA,
        bytes: ?first_bytes[0], len: 8, align: 8,
        native: of.NativeSection{format: of.OF_ELF, kind: 1, flags: 2}};
    var second_sections: [2]of.Section;
    second_sections[0] = of.Section{name: ids[1], kind: of.SK_RODATA,
        bytes: ?second_bytes[0], len: 16, align: 8,
        native: of.NativeSection{format: of.OF_ELF, kind: 1, flags: 0x202}};
    second_sections[1] = of.Section{name: ids[2], kind: of.SK_DEBUG,
        bytes: ?group[0], len: 12, align: 4,
        native: of.NativeSection{format: of.OF_ELF, kind: of.NATIVE_GROUP, entry_size: 4, link_symbol: 1}};
    var first_symbol: of.Symbol = of.Symbol{name: ids[3], section: 0, size: 8,
        flags: of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT};
    var second_symbols: [2]of.Symbol;
    second_symbols[0] = of.Symbol{name: ids[4], section: 0, size: 16,
        flags: of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT};
    second_symbols[1] = of.Symbol{name: ids[5], section: of.SECTION_EXTERNAL,
        flags: of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN};
    var relocations: [2]of.Relocation;
    relocations[0] = of.Relocation{section: 0, offset: 0, kind: of.RK_ABS64, sym: 0, addend: 11};
    relocations[1] = of.Relocation{section: 0, offset: 8, kind: of.RK_ABS64, sym: 1, addend: 17};
    var inputs: [2]of.ObjectImage;
    inputs[0] = of.object_image_init(?alloc, ?itn, ids[0]);
    inputs[0].sections = ?first_section; inputs[0].section_count = 1;
    inputs[0].symbols = ?first_symbol; inputs[0].symbol_count = 1;
    inputs[1] = of.object_image_init(?alloc, ?itn, ids[1]);
    inputs[1].sections = ?second_sections[0]; inputs[1].section_count = 2;
    inputs[1].symbols = ?second_symbols[0]; inputs[1].symbol_count = 2;
    inputs[1].relocations = ?relocations[0]; inputs[1].reloc_count = 2;
    val combined: R.Result[of.ObjectImage, str] = combine(?alloc, ?itn, ?inputs[0], 2, 0, nil, 0);
    if (R.is_err[of.ObjectImage, str](combined)) { ret 2; }
    var image: of.ObjectImage = R.unwrap_ok[of.ObjectImage, str](combined);
    fin { of.object_image_dnit(?image); }
    if (image.section_count != 3 || image.symbol_count != 3 || image.reloc_count != 2
        || image.sections[2].native.link_symbol != 2 || bin.read_u32_le(image.sections[2].bytes, 4) != 2
        || bin.read_u32_le(image.sections[2].bytes, 8) != (of.NATIVE_GROUP_RELOC | 2)
        || image.relocations[0].section != 1 || image.relocations[0].sym != 1
        || image.relocations[1].section != 1 || image.relocations[1].sym != 2) { ret 3; }
    var registry: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?registry); }
    if (R.is_err[R.Void, str](target.register_all(?registry, target_testing.debug_descriptor))) { ret 4; }
    val selected: R.Result[target.Target, str] = target.select(?registry, "x86_64", "linux", "sysv64");
    if (R.is_err[target.Target, str](selected)) { ret 4; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](selected);
    val created: R.Result[output.Output, str] = output.create(?alloc, "combined_native_elf");
    if (R.is_err[output.Output, str](created)) { ret 5; }
    var file: output.Output = R.unwrap_ok[output.Output, str](created);
    fin { output.dnit(?file); }
    var operation: publication.Plan;
    val initialized: O.Option[txn.Error] = publication.plan_init(?operation, ?alloc);
    if (O.is_some[txn.Error](initialized)) { ret 6; }
    var closed: bool = false;
    fin { if (!closed) { publication.plan_dnit(?operation); } }
    val destination: R.Result[*publication.Destination, str] = publication.plan_add(?operation, output.path(?file), false);
    if (R.is_err[*publication.Destination, str](destination)) { ret 6; }
    if (O.is_some[txn.Error](publication.plan_seal(?operation))) { ret 6; }
    val emitted: R.Result[R.Void, str] = tgt.of.emit_object(?tgt.object, ?image,
        R.unwrap_ok[*publication.Destination, str](destination));
    if (R.is_err[R.Void, str](emitted)) { ret 7; }
    closed = true;
    if (O.is_some[txn.Error](publication.plan_dnit(?operation))) { ret 7; }
    val read: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, output.path(?file));
    if (R.is_err[Vector[u8], str](read)) { ret 8; }
    var bytes: Vector[u8] = R.unwrap_ok[Vector[u8], str](read);
    fin { if (bytes.data != nil) { A.deallocate[u8](?alloc, bytes.data, bytes.cap); } }
    var parsed: of.ObjectImage;
    if (R.is_err[R.Void, str](tgt.of.parse_object(?alloc, ?itn, bytes.data, bytes.len, ?parsed))) { ret 9; }
    fin { of.object_image_dnit(?parsed); }
    if (parsed.section_count != 3 || parsed.sections[0].name != ids[0] || parsed.sections[1].name != ids[1]
        || parsed.sections[0].bytes[0] != 0xA5 || parsed.sections[2].native.link_symbol != 2
        || bin.read_u32_le(parsed.sections[2].bytes, 4) != 2
        || bin.read_u32_le(parsed.sections[2].bytes, 8) != (of.NATIVE_GROUP_RELOC | 2)
        || parsed.reloc_count != 2 || parsed.relocations[0].section != 1 || parsed.relocations[1].section != 1
        || parsed.symbols[parsed.relocations[0].sym].name != ids[4] || parsed.relocations[0].addend != 11
        || parsed.symbols[parsed.relocations[1].sym].name != ids[5] || parsed.relocations[1].addend != 17
        || parsed.symbols[parsed.relocations[1].sym].section != of.SECTION_EXTERNAL) { ret 10; }
    if (R.is_err[R.Void, str](output.retain_bytes(?alloc, "elf-combined.o", bytes.data, bytes.len))) { ret 11; }
    ret 0;
}
