use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use mach.lang.fail;
use page: std.allocator.page;
use T: std.allocator.testing;
use map: std.collections.map;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use std.memory;

use mach.lang.intern;
pub def FileId: u32;

pub val FILE_NIL: FileId = 0;

pub rec SrcLoc {
    file:   FileId;
    offset: usize;
}

pub fun loc(file: FileId, offset: usize) SrcLoc {
    var l: SrcLoc;
    l.file   = file;
    l.offset = offset;
    ret l;
}

pub fun loc_nil() SrcLoc {
    ret loc(FILE_NIL, 0);
}

pub fun loc_is_valid(l: SrcLoc) bool {
    ret l.file != FILE_NIL;
}

pub rec Position {
    line: usize;
    col:  usize;
}

pub rec LineSpan {
    start: usize;
    end:   usize;
}

pub rec SourceFile {
    present:     bool;
    revision:    u64;
    path:        str;
    text:        str;
    line_starts: *usize;
    line_len:    usize;
}

pub rec SourceMap {
    a:       *A.Allocator;
    files:   *SourceFile;
    len:     usize;
    cap:     usize;
    by_path: map.Map[intern.StrId, FileId];
}

val INITIAL_FILE_CAP: usize = 8;

pub fun init(a: *A.Allocator) SourceMap {
    var m: SourceMap;
    m.a       = a;
    m.files   = nil;
    m.len     = 0;
    m.cap     = 0;
    m.by_path = map.init[intern.StrId, FileId](a, map.hash_u32, map.eq_u32);
    ret m;
}

pub fun dnit(m: *SourceMap) {
    if (m == nil) { ret; }

    var i: usize = 1;
    for (i < m.len) {
        val file: *SourceFile = ?m.files[i];
        str_free(m.a, file.path);
        str_free(m.a, file.text);
        line_index_free(m.a, file.line_starts, file.line_len);
        i = i + 1;
    }

    if (m.files != nil && m.cap > 0) {
        A.deallocate[SourceFile](m.a, m.files, m.cap);
    }
    map.dnit[intern.StrId, FileId](?m.by_path);

    m.files = nil;
    m.len   = 0;
    m.cap   = 0;
}

pub fun add(m: *SourceMap, path: str, text: str) res[FileId, fail.Fail] {
    if (m.len::u64 > 0xFFFFFFFF || m.len == ~(0::usize)) {
        ret res[FileId, fail.Fail].err{fail.message("source file identities are exhausted")};
    }
    if (m.len == 0) {
        val res_sentinel: err[fail.Fail] = files_reserve(m);
        if (sel res_sentinel.err) { ret res[FileId, fail.Fail].err{res_sentinel.err}; }
        m.len = 1;
    }
    var line_len: usize = 0;
    val res_starts: res[*usize, fail.Fail] = line_index_build(m.a, text, ?line_len);
    if (sel res_starts.err) {
        ret res[FileId, fail.Fail].err{res_starts.err};
    }
    val starts: *usize = res_starts.ok;

    val res_path: res[str, A.Error] = str_dup(m.a, path);
    if (sel res_path.err) {
        line_index_free(m.a, starts, line_len);
        ret res[FileId, fail.Fail].err{fail.refused(res_path.err)};
    }
    val path_copy: str = res_path.ok;

    val res_text: res[str, A.Error] = str_dup(m.a, text);
    if (sel res_text.err) {
        str_free(m.a, path_copy);
        line_index_free(m.a, starts, line_len);
        ret res[FileId, fail.Fail].err{fail.refused(res_text.err)};
    }
    val text_copy: str = res_text.ok;

    val res_reserve: err[fail.Fail] = files_reserve(m);
    if (sel res_reserve.err) {
        str_free(m.a, text_copy);
        str_free(m.a, path_copy);
        line_index_free(m.a, starts, line_len);
        ret res[FileId, fail.Fail].err{res_reserve.err};
    }

    var file: SourceFile;
    file.present = true;
    file.revision = 1;
    file.path        = path_copy;
    file.text        = text_copy;
    file.line_starts = starts;
    file.line_len    = line_len;

    val id: FileId = m.len::u32;
    m.files[m.len] = file;
    m.len = m.len + 1;

    ret res[FileId, fail.Fail].ok{id};
}

pub fun update(m: *SourceMap, id: FileId, text: str) res[bool, fail.Fail] {
    if (id == FILE_NIL || id::usize >= m.len) { ret res[bool, fail.Fail].ok{false}; }

    val file: *SourceFile = ?m.files[id];

    if (file.present && str_equals(file.text, text)) { ret res[bool, fail.Fail].ok{false}; }
    if (file.revision == ~(0::u64)) { ret res[bool, fail.Fail].err{fail.message("source revision exhausted")}; }

    var line_len: usize = 0;
    val res_starts: res[*usize, fail.Fail] = line_index_build(m.a, text, ?line_len);
    if (sel res_starts.err) {
        ret res[bool, fail.Fail].err{res_starts.err};
    }
    val starts: *usize = res_starts.ok;

    val res_text: res[str, A.Error] = str_dup(m.a, text);
    if (sel res_text.err) {
        line_index_free(m.a, starts, line_len);
        ret res[bool, fail.Fail].err{fail.refused(res_text.err)};
    }
    val text_copy: str = res_text.ok;

    str_free(m.a, file.text);
    line_index_free(m.a, file.line_starts, file.line_len);

    file.text        = text_copy;
    file.line_starts = starts;
    file.line_len    = line_len;
    file.present = true;
    file.revision = file.revision + 1;

    ret res[bool, fail.Fail].ok{true};
}

pub rec PreparedLoad {
    owner: *SourceMap;
    id: FileId;
    key: intern.StrId;
    file: SourceFile;
    changed: bool;
    new_entry: bool;
}

# the caller exclusively borrows the map until commit or discard
pub fun prepare_load(m: *SourceMap, interner: *intern.Interner, path: str, text: str) res[PreparedLoad, fail.Fail] {
    val interned: res[intern.StrId, A.Error] = intern.intern(interner, path);
    if (sel interned.err) { ret res[PreparedLoad, fail.Fail].err{fail.refused(interned.err)}; }
    val key: intern.StrId = interned.ok;
    var prepared: PreparedLoad = PreparedLoad{ owner: m, key: key };
    val existing: opt[*FileId] = map.get[intern.StrId, FileId](?m.by_path, ?key);
    if (sel existing.some) {
        prepared.id = @existing.some;
        val current: opt[*SourceFile] = get(m, prepared.id);
        if (sel current.none) { ret res[PreparedLoad, fail.Fail].err{fail.message("source path index has no file owner")}; }
        val file: *SourceFile = current.some;
        if (file.present && str_equals(file.text, text)) { ret res[PreparedLoad, fail.Fail].ok{prepared}; }
        if (file.revision == ~(0::u64)) { ret res[PreparedLoad, fail.Fail].err{fail.message("source revision exhausted")}; }
        prepared.file.path = file.path;
        prepared.file.revision = file.revision + 1;
    }
    or (sel existing.none) {
        if (m.len::u64 > 0xFFFFFFFF || m.len == ~(0::usize)) { ret res[PreparedLoad, fail.Fail].err{fail.message("source file identities are exhausted")}; }
        prepared.id = m.len::FileId;
        if (m.len == 0) { prepared.id = 1; }
        val reserved: err[fail.Fail] = files_reserve(m);
        if (sel reserved.err) { ret res[PreparedLoad, fail.Fail].err{reserved.err}; }
        val copied_path: res[str, A.Error] = str_dup(m.a, path);
        if (sel copied_path.err) { ret res[PreparedLoad, fail.Fail].err{fail.refused(copied_path.err)}; }
        prepared.file.path = copied_path.ok;
        prepared.new_entry = true;
        prepared.file.revision = 1;
    }
    prepared.file.present = true;
    var transferred: bool = false;
    fin {
        if (!transferred) {
            if (prepared.new_entry) { str_free(m.a, prepared.file.path); }
            str_free(m.a, prepared.file.text);
            line_index_free(m.a, prepared.file.line_starts, prepared.file.line_len);
        }
    }
    val lines: res[*usize, fail.Fail] = line_index_build(m.a, text, ?prepared.file.line_len);
    if (sel lines.err) { ret res[PreparedLoad, fail.Fail].err{lines.err}; }
    prepared.file.line_starts = lines.ok;
    val copied: res[str, A.Error] = str_dup(m.a, text);
    if (sel copied.err) { ret res[PreparedLoad, fail.Fail].err{fail.refused(copied.err)}; }
    prepared.file.text = copied.ok;
    if (prepared.new_entry) {
        val indexed: res[bool, A.Error] = map.insert[intern.StrId, FileId](?m.by_path, key, prepared.id);
        if (sel indexed.err) { ret res[PreparedLoad, fail.Fail].err{fail.refused(indexed.err)}; }
    }
    prepared.changed = true;
    transferred = true;
    ret res[PreparedLoad, fail.Fail].ok{prepared};
}

pub fun discard_load(prepared: *PreparedLoad) {
    if (prepared.owner == nil) { ret; }
    val m: *SourceMap = prepared.owner;
    if (prepared.changed) {
        if (prepared.new_entry) {
            map.remove[intern.StrId, FileId](?m.by_path, ?prepared.key);
            str_free(m.a, prepared.file.path);
        }
        str_free(m.a, prepared.file.text);
        line_index_free(m.a, prepared.file.line_starts, prepared.file.line_len);
    }
    prepared.owner = nil;
    prepared.file = SourceFile{};
}

pub fun commit_load(prepared: *PreparedLoad) FileId {
    val m: *SourceMap = prepared.owner;
    val id: FileId = prepared.id;
    if (prepared.changed) {
        if (!prepared.new_entry) {
            str_free(m.a, m.files[id].text);
            line_index_free(m.a, m.files[id].line_starts, m.files[id].line_len);
        }
        if (m.len == 0) { m.files[0] = SourceFile{}; }
        m.files[id] = prepared.file;
        if (prepared.new_entry) { m.len = id::usize + 1; }
    }
    prepared.owner = nil;
    prepared.file = SourceFile{};
    ret id;
}

pub fun load(m: *SourceMap, interner: *intern.Interner, path: str, text: str) res[FileId, fail.Fail] {
    val staged: res[PreparedLoad, fail.Fail] = prepare_load(m, interner, path, text);
    if (sel staged.err) { ret res[FileId, fail.Fail].err{staged.err}; }
    var prepared: PreparedLoad = staged.ok;
    ret res[FileId, fail.Fail].ok{commit_load(?prepared)};
}

# preflight completes before query and editor owners are retired
pub fun prepare_release(m: *SourceMap, id: FileId) err[fail.Fail] {
    if (id == FILE_NIL || id::usize >= m.len) { ret err[fail.Fail].err{fail.message("source identity is absent")}; }
    if (m.files[id].present && m.files[id].revision == ~(0::u64)) { ret err[fail.Fail].err{fail.message("source revision exhausted")}; }
    ret err[fail.Fail].ok{};
}

pub fun release_payload(m: *SourceMap, id: FileId) {
    val file: *SourceFile = ?m.files[id];
    if (!file.present) { ret; }
    str_free(m.a, file.text);
    line_index_free(m.a, file.line_starts, file.line_len);
    file.text = nil;
    file.line_starts = nil;
    file.line_len = 0;
    file.present = false;
    file.revision = file.revision + 1;
}

pub fun get(m: *SourceMap, id: FileId) opt[*SourceFile] {
    if (id == FILE_NIL || id::usize >= m.len) { ret opt[*SourceFile].none{}; }
    ret opt[*SourceFile].some{?m.files[id]};
}

fun snapshot_path_index(src: *SourceMap, dst: *SourceMap) err[fail.Fail] {
    val cap: usize = src.by_path.cap;
    if (cap == 0) { ret err[fail.Fail].ok{}; }

    val keys_r: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](dst.a, cap);
    if (sel keys_r.err) { ret err[fail.Fail].err{fail.refused(keys_r.err)}; }
    val keys: *intern.StrId = keys_r.ok;

    val values_r: res[*FileId, A.Error] = A.allocate[FileId](dst.a, cap);
    if (sel values_r.err) {
        A.deallocate[intern.StrId](dst.a, keys, cap);
        ret err[fail.Fail].err{fail.refused(values_r.err)};
    }
    val values: *FileId = values_r.ok;

    val states_r: res[*u8, A.Error] = A.allocate[u8](dst.a, cap);
    if (sel states_r.err) {
        A.deallocate[FileId](dst.a, values, cap);
        A.deallocate[intern.StrId](dst.a, keys, cap);
        ret err[fail.Fail].err{fail.refused(states_r.err)};
    }
    val states: *u8 = states_r.ok;

    memory.raw_copy(keys::ptr, src.by_path.keys::ptr, cap * $size_of(intern.StrId));
    memory.raw_copy(values::ptr, src.by_path.values::ptr, cap * $size_of(FileId));
    memory.raw_copy(states::ptr, src.by_path.states::ptr, cap);
    dst.by_path.keys       = keys;
    dst.by_path.values     = values;
    dst.by_path.states     = states;
    dst.by_path.len        = src.by_path.len;
    dst.by_path.tombstones = src.by_path.tombstones;
    dst.by_path.cap        = cap;
    ret err[fail.Fail].ok{};
}

pub fun copy_file(file: *SourceFile, a: *A.Allocator) res[SourceFile, fail.Fail] {
    var copied: SourceFile = SourceFile{ present: file.present, revision: file.revision };
    var complete: bool = false;
    fin { if (!complete) { dnit_file(?copied, a); } }
    val path: res[str, A.Error] = str_dup(a, file.path);
    if (sel path.err) { ret res[SourceFile, fail.Fail].err{fail.refused(path.err)}; }
    copied.path = path.ok;
    if (file.present) {
        val text: res[str, A.Error] = str_dup(a, file.text);
        if (sel text.err) { ret res[SourceFile, fail.Fail].err{fail.refused(text.err)}; }
        copied.text = text.ok;
        val lines: res[*usize, fail.Fail] = line_index_build(a, copied.text, ?copied.line_len);
        if (sel lines.err) { ret res[SourceFile, fail.Fail].err{lines.err}; }
        copied.line_starts = lines.ok;
    }
    complete = true;
    ret res[SourceFile, fail.Fail].ok{copied};
}

pub fun dnit_file(file: *SourceFile, a: *A.Allocator) {
    str_free(a, file.path);
    str_free(a, file.text);
    line_index_free(a, file.line_starts, file.line_len);
    @file = SourceFile{};
}

pub fun snapshot_from(src: *SourceMap, a: *A.Allocator) res[*SourceMap, fail.Fail] {
    if (src == nil || a == nil) { ret res[*SourceMap, fail.Fail].err{fail.message("source snapshot requires a map and allocator")}; }

    val map_r: res[*SourceMap, A.Error] = A.allocate[SourceMap](a, 1);
    if (sel map_r.err) { ret res[*SourceMap, fail.Fail].err{fail.refused(map_r.err)}; }
    val snap: *SourceMap = map_r.ok;
    @snap = init(a);

    val index_r: err[fail.Fail] = snapshot_path_index(src, snap);
    if (sel index_r.err) {
        dnit(snap);
        A.deallocate[SourceMap](a, snap, 1);
        ret res[*SourceMap, fail.Fail].err{index_r.err};
    }

    if (src.len == 0) { ret res[*SourceMap, fail.Fail].ok{snap}; }

    val files_r: res[*SourceFile, A.Error] = A.allocate[SourceFile](a, src.len);
    if (sel files_r.err) {
        dnit(snap);
        A.deallocate[SourceMap](a, snap, 1);
        ret res[*SourceMap, fail.Fail].err{fail.refused(files_r.err)};
    }
    snap.files = files_r.ok;
    snap.cap   = src.len;
    snap.len   = 1;

    snap.files[0] = SourceFile{};
    var i: usize = 1;
    for (i < src.len) {
        val copied: res[SourceFile, fail.Fail] = copy_file(?src.files[i], a);
        if (sel copied.err) {
            dnit(snap);
            A.deallocate[SourceMap](a, snap, 1);
            ret res[*SourceMap, fail.Fail].err{copied.err};
        }
        snap.files[i] = copied.ok;
        snap.len = i + 1;
        i = i + 1;
    }

    ret res[*SourceMap, fail.Fail].ok{snap};
}

pub fun position(file: *SourceFile, offset: usize) Position {
    var lo: usize = 0;
    var hi: usize = file.line_len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (file.line_starts[mid] <= offset) {
            lo = mid + 1;
        }
        or {
            hi = mid;
        }
    }

    var p: Position;
    p.line = lo;
    p.col  = offset - file.line_starts[lo - 1] + 1;
    ret p;
}

pub fun line_start(file: *SourceFile, line: usize) opt[usize] {
    if (line == 0 || line > file.line_len) { ret opt[usize].none{}; }
    ret opt[usize].some{file.line_starts[line - 1]};
}

pub fun line_bounds(file: *SourceFile, line: usize) opt[LineSpan] {
    if (line == 0 || line > file.line_len) { ret opt[LineSpan].none{}; }

    val start:    usize = file.line_starts[line - 1];
    val text_len: usize = str_len(file.text);

    var end: usize = text_len;
    if (line < file.line_len) { end = file.line_starts[line]; }

    for (end > start && (file.text[end - 1] == '\n' || file.text[end - 1] == '\r')) {
        end = end - 1;
    }

    var ls: LineSpan;
    ls.start = start;
    ls.end   = end;
    ret opt[LineSpan].some{ls};
}

fun line_index_build(a: *A.Allocator, text: str, out_len: *usize) res[*usize, fail.Fail] {
    val text_len: usize = str_len(text);

    var line_len: usize = 1;
    var i:        usize = 0;
    for (i < text_len) {
        if (text[i] == '\n') { line_len = line_len + 1; }
        i = i + 1;
    }

    val res_starts: res[*usize, A.Error] = A.allocate[usize](a, line_len);
    if (sel res_starts.err) {
        ret res[*usize, fail.Fail].err{fail.refused(res_starts.err)};
    }
    val starts: *usize = res_starts.ok;

    starts[0] = 0;
    var idx: usize = 1;
    i = 0;
    for (i < text_len) {
        if (text[i] == '\n') {
            starts[idx] = i + 1;
            idx = idx + 1;
        }
        i = i + 1;
    }

    @out_len = line_len;
    ret res[*usize, fail.Fail].ok{starts};
}

fun line_index_free(a: *A.Allocator, starts: *usize, len: usize) {
    if (starts != nil && len > 0) {
        A.deallocate[usize](a, starts, len);
    }
}

fun files_reserve(m: *SourceMap) err[fail.Fail] {
    if (m.len < m.cap) { ret err[fail.Fail].ok{}; }

    var new_cap: usize = m.cap * 2;
    if (new_cap == 0) { new_cap = INITIAL_FILE_CAP; }

    var res_files: res[*SourceFile, A.Error];
    if (m.files == nil) {
        res_files = A.allocate[SourceFile](m.a, new_cap);
    }
    or {
        res_files = A.reallocate[SourceFile](m.a, m.files, m.cap, new_cap);
    }
    if (sel res_files.err) {
        ret err[fail.Fail].err{fail.refused(res_files.err)};
    }

    m.files = res_files.ok;
    m.cap   = new_cap;
    ret err[fail.Fail].ok{};
}

test "mach.lang.source.load:dedup_by_path" {
    var a: A.Allocator;
    page.make(?a);

    var ix: intern.Interner = intern.init(?a);
    var m:  SourceMap       = init(?a);

    val res1: res[FileId, fail.Fail] = load(?m, ?ix, "p1.mach", "a");
    if (sel res1.err) { ret 1; }
    val fid1: FileId = res1.ok;

    val res2: res[FileId, fail.Fail] = load(?m, ?ix, "p1.mach", "b");
    if (sel res2.err) { ret 1; }
    val fid2: FileId = res2.ok;

    if (fid1 != fid2)       { ret 1; }
    if (m.by_path.len != 1) { ret 1; }
    if (m.len != 2)         { ret 1; }

    val file1: *SourceFile = ?m.files[fid1::usize];
    if (str_len(file1.text) != 1) { ret 1; }
    if (file1.text[0] != 'b')     { ret 1; }

    val res3: res[FileId, fail.Fail] = load(?m, ?ix, "p2.mach", "c");
    if (sel res3.err) { ret 1; }
    val fid3: FileId = res3.ok;
    if (fid3 == fid1)       { ret 1; }
    if (m.by_path.len != 2) { ret 1; }
    if (m.len != 3)         { ret 1; }

    dnit(?m);
    intern.dnit(?ix);
    ret 0;
}

test "mach.lang.source.update:identical_text_preserves_storage" {
    var a: A.Allocator;
    page.make(?a);

    var ix: intern.Interner = intern.init(?a);
    var m:  SourceMap       = init(?a);

    val res1: res[FileId, fail.Fail] = load(?m, ?ix, "p.mach", "hello\nworld");
    if (sel res1.err) { ret 1; }
    val fid: FileId = res1.ok;
    val text0: str = (?m.files[fid::usize]).text;
    val lines0: *usize = (?m.files[fid::usize]).line_starts;
    val revision: u64 = m.files[fid].revision;
    val identical: res[bool, fail.Fail] = update(?m, fid, "hello\nworld");
    if (sel identical.err) { ret 2; }
    if (identical.ok) { ret 2; }
    if (m.files[fid].revision != revision) { ret 3; }

    val res2: res[FileId, fail.Fail] = load(?m, ?ix, "p.mach", "hello\nworld");
    if (sel res2.err) { ret 1; }
    if ((?m.files[fid::usize]).text != text0) { ret 1; }
    if ((?m.files[fid::usize]).line_starts != lines0) { ret 1; }

    val res3: res[FileId, fail.Fail] = load(?m, ?ix, "p.mach", "hello\nthere");
    if (sel res3.err) { ret 1; }
    if ((?m.files[fid::usize]).text[6] != 't') { ret 1; }

    dnit(?m);
    intern.dnit(?ix);
    ret 0;
}

test "mach.lang.source.snapshot_from:owns_paths_text_and_line_indexes" {
    var a: A.Allocator;
    page.make(?a);

    var m: SourceMap = init(?a);
    var ix: intern.Interner = intern.init(?a);

    val file_r: res[FileId, fail.Fail] = load(?m, ?ix, "p.mach", "one\ntwo");
    if (sel file_r.err) { intern.dnit(?ix); dnit(?m); ret 1; }
    val fid: FileId = file_r.ok;

    val snap_r: res[*SourceMap, fail.Fail] = snapshot_from(?m, ?a);
    if (sel snap_r.err) { intern.dnit(?ix); dnit(?m); ret 1; }
    val snap: *SourceMap = snap_r.ok;

    val update_r: res[bool, fail.Fail] = update(?m, fid, "changed");
    if (sel update_r.err) {
        dnit(snap); A.deallocate[SourceMap](?a, snap, 1); intern.dnit(?ix); dnit(?m); ret 1;
    }

    val file_o: opt[*SourceFile] = get(snap, fid);
    var bad: i32 = 0;
    if (sel file_o.none) { bad = 1; }
    or (sel file_o.some) {
        val file: *SourceFile = file_o.some;
        if (!str_equals(file.path, "p.mach")) { bad = 1; }
        if (!str_equals(file.text, "one\ntwo")) { bad = 1; }
        if (file.line_len != 2 || file.line_starts[1] != 4) { bad = 1; }
        if (snap.by_path.len != 1) { bad = 1; }
    }

    dnit(snap);
    A.deallocate[SourceMap](?a, snap, 1);
    intern.dnit(?ix);
    dnit(?m);
    ret bad;
}

test "mach.lang.source.srcloc:offset_roundtrips_to_line_col" {
    var a: A.Allocator;
    page.make(?a);

    var m:  SourceMap     = init(?a);

    val res_fid: res[FileId, fail.Fail] = add(?m, "p.mach", "ab\ncde\nf");
    if (sel res_fid.err) { ret 1; }
    val fid: FileId = res_fid.ok;

    val l: SrcLoc = loc(fid, 4);
    if (!loc_is_valid(l))        { ret 1; }
    if (l.file != fid)           { ret 1; }
    if (l.offset != 4)           { ret 1; }
    if (loc_is_valid(loc_nil())) { ret 1; }

    val file: *SourceFile = ?m.files[fid::usize];
    val p: Position = position(file, l.offset);
    if (p.line != 2) { ret 1; }
    if (p.col != 2)  { ret 1; }

    dnit(?m);
    ret 0;
}

test "mach.lang.source.add:identity_exhaustion_precedes_allocation_or_publication" {
    var tracked: T.Testing;
    val make_r: err[A.Error] = T.make(?tracked);
    if (sel make_r.err) { ret 1; }
    fin { T.dnit(?tracked); }
    var m: SourceMap = init(T.allocator_of(?tracked));
    var limit: usize = ~(0::usize);
    $if ($mach.build.pointer_width == 8) { limit = 0x100000000::usize; }
    m.len = limit;
    T.fail_at_ordinal(?tracked, 1);
    val refused: res[FileId, fail.Fail] = add(?m, "full.mach", "");
    var bad: i32 = 0;
    if (sel refused.ok) { bad = 2; }
    or (sel refused.err && !str_equals(fail.describe(refused.err), "source file identities are exhausted")) { bad = 3; }
    if (m.len != limit || T.attempt_count(?tracked) != 0) { bad = 4; }
    m.len = 0;
    dnit(?m);
    if (T.leaked(?tracked) || T.double_free_count(?tracked) != 0) { bad = 5; }
    ret bad;
}
