use std.allocator.page;
use T: std.allocator.testing;
use std.collections.map;
use std.system.panic.panic;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;

use lang_alloc: mach.lang.alloc;
use mach.lang.handle;
use mach.lang.intern;

# a file's slot in the source map
pub rec FileId {
    index: u32;
}

# no source: an unlocated diagnostic, or a node the build synthesized
pub val FILE_NIL: FileId = FileId{index: 0};

pub fun file_id(index: u32) FileId {
    var f: FileId;
    f.index = index;
    ret f;
}

pub fun file_index(f: FileId) u32 {
    ret f.index;
}

pub fun file_same(left: FileId, right: FileId) bool {
    ret left.index == right.index;
}

pub fun file_is_nil(f: FileId) bool {
    ret f.index == FILE_NIL.index;
}

# the bytes [offset, offset + len) of one text
pub rec Span {
    offset: usize;
    len:    usize;
}

# where in the compilation something is: a span of the file `file`, or
# nowhere when `file` is FILE_NIL
pub rec Location {
    file: FileId;
    span: Span;
}

pub fun span(offset: usize, len: usize) Span {
    ret Span{offset: offset, len: len};
}

# the bytes [offset, end) as a span; an end before the offset is empty
pub fun span_between(offset: usize, end: usize) Span {
    if (end < offset) { ret Span{offset: offset, len: 0}; }
    ret Span{offset: offset, len: end - offset};
}

# the offset just past the span's last byte
pub fun span_end(s: Span) usize {
    ret s.offset + s.len;
}

pub fun location(file: FileId, s: Span) Location {
    ret Location{file: file, span: s};
}

pub fun location_nil() Location {
    ret location(FILE_NIL, span(0, 0));
}

pub fun location_is_valid(l: Location) bool {
    ret !file_is_nil(l.file);
}

pub fun location_equals(x: Location, y: Location) bool {
    ret file_same(x.file, y.file) && x.span.offset == y.span.offset && x.span.len == y.span.len;
}

# a line and a column, each from 1, the column counted in UTF-8 bytes
pub rec Position {
    line: usize;
    col:  usize;
}

# the line index of one text: where each line starts, for mapping an offset
# to its line and column in time logarithmic in the text's lines. a line ends
# at a newline byte
# ---
# starts: the offset of each line's first byte, the first line's 0
# len:    how many lines, at least 1 once built
# n:      the text's length in bytes
pub rec Lines {
    starts: *usize;
    len:    usize;
    n:      usize;
}

# a refusal of the source map: the allocator's or the file store's, every
# file identity issued, a file revised as often as its revision counts, an
# identity the map never issued, a path indexed without its file, or a
# snapshot asked of no map or allocator
pub tag Error: u8 {
    alloc: A.Error;
    store: handle.Error;
    exhausted;
    revision;
    absent;
    unindexed;
    unsupplied;
}

pub fun text(e: Error) str {
    if (sel e.alloc)     { ret lang_alloc.text(e.alloc); }
    or (sel e.store)     { ret handle.text(e.store); }
    or (sel e.exhausted) { ret "source file identities are exhausted"; }
    or (sel e.revision)  { ret "source revision exhausted"; }
    or (sel e.absent)    { ret "source identity is absent"; }
    or (sel e.unindexed) { ret "source path index has no file owner"; }
    ret "source snapshot requires a map and allocator";
}

pub rec SourceFile {
    present:  bool;
    revision: u64;
    path:     str;
    text:     str;
    lines:    Lines;
}

# the files of one compilation, addressed by FileId
#
# the store is a handle.StableChunks: a SourceFile is written once into a
# fixed chunk and never moves or is reused, so a `*SourceFile` taken from
# `get` stays valid until `dnit`. slot 0 is the FILE_NIL sentinel. growing
# the map, updating a file's text or releasing its payload mutates the file
# in place and bumps its `revision`; a slot is never handed to a second file
# without a generation check on that revision
pub rec SourceMap {
    a:       *A.Allocator;
    files:   handle.StableChunks[SourceFile];
    by_path: map.Map[intern.StrId, FileId];
}

pub fun init(a: *A.Allocator) SourceMap {
    var m: SourceMap;
    m.a       = a;
    m.files   = handle.chunk_init[SourceFile](a);
    m.by_path = map.init[intern.StrId, FileId](a);
    ret m;
}

pub fun dnit(m: *SourceMap) {
    if (m == nil) { ret; }

    var i: usize = 1;
    for (i < count(m)) {
        val file_o: opt[*SourceFile] = handle.chunk_at[SourceFile](?m.files, i);
        if (sel file_o.some) {
            val file: *SourceFile = file_o.some;
            str_free(m.a, file.path);
            str_free(m.a, file.text);
            lines_dnit(m.a, ?file.lines);
        }
        i = i + 1;
    }

    handle.chunk_dnit[SourceFile](?m.files);
    map.dnit[intern.StrId, FileId](?m.by_path);
}

# the slot count including the FILE_NIL sentinel; the next FileId to be issued
pub fun count(m: *SourceMap) usize {
    ret handle.chunk_count[SourceFile](?m.files);
}

fun identities_exhausted(m: *SourceMap) bool {
    val len: usize = count(m);
    ret len::u64 > 0xFFFFFFFF || len == ~(0::usize);
}

# the slots a publication needs: the file and, on an empty map, the sentinel first
fun slots_needed(m: *SourceMap) usize {
    if (count(m) == 0) { ret 2; }
    ret 1;
}

# publish a file into reserved capacity; the caller holds the editor and has
# grown the store by slots_needed, so the append cannot allocate or contend
fun publish(e: *handle.ChunkEditor[SourceFile], file: SourceFile) *SourceFile {
    if (handle.chunk_count[SourceFile](e.store) == 0) {
        val sentinel: res[*SourceFile, handle.Error] = handle.chunk_append[SourceFile](e, SourceFile{});
        if (sel sentinel.err) { panic("source: reserved sentinel slot refused the append\n"); }
    }
    val placed: res[*SourceFile, handle.Error] = handle.chunk_append[SourceFile](e, file);
    if (sel placed.err) {
        panic("source: reserved file slot refused the append\n");
        ret nil;
    }
    ret placed.ok;
}

pub fun add(m: *SourceMap, path: str, text: str) res[FileId, Error] {
    if (identities_exhausted(m)) {
        ret res[FileId, Error].err{Error.exhausted{}};
    }
    val editor_r: res[handle.ChunkEditor[SourceFile], handle.Error] = handle.chunk_editor[SourceFile](?m.files);
    if (sel editor_r.err) { ret res[FileId, Error].err{Error.store{editor_r.err}}; }
    var editor: handle.ChunkEditor[SourceFile] = editor_r.ok;
    fin { handle.chunk_editor_finish[SourceFile](?editor); }
    val reserved: err[handle.Error] = handle.chunk_grow[SourceFile](?editor, slots_needed(m));
    if (sel reserved.err) { ret res[FileId, Error].err{Error.store{reserved.err}}; }
    val lines_r: res[Lines, A.Error] = lines_init(m.a, text::*u8, str_len(text));
    if (sel lines_r.err) { ret res[FileId, Error].err{Error.alloc{lines_r.err}}; }
    var lines: Lines = lines_r.ok;

    val res_path: res[str, A.Error] = str_dup(m.a, path);
    if (sel res_path.err) {
        lines_dnit(m.a, ?lines);
        ret res[FileId, Error].err{Error.alloc{res_path.err}};
    }
    val path_copy: str = res_path.ok;

    val res_text: res[str, A.Error] = str_dup(m.a, text);
    if (sel res_text.err) {
        str_free(m.a, path_copy);
        lines_dnit(m.a, ?lines);
        ret res[FileId, Error].err{Error.alloc{res_text.err}};
    }
    val text_copy: str = res_text.ok;

    var file: SourceFile;
    file.present  = true;
    file.revision = 1;
    file.path     = path_copy;
    file.text     = text_copy;
    file.lines    = lines;

    var id: FileId = file_id(count(m)::u32);
    if (count(m) == 0) { id = file_id(1); }
    publish(?editor, file);

    ret res[FileId, Error].ok{id};
}

#[testing]
pub fun update(m: *SourceMap, id: FileId, text: str) res[bool, Error] {
    val file_o: opt[*SourceFile] = get(m, id);
    if (sel file_o.none) { ret res[bool, Error].ok{false}; }
    val file: *SourceFile = file_o.some;

    if (file.present && str_equals(file.text, text)) { ret res[bool, Error].ok{false}; }
    if (file.revision == ~(0::u64))                  { ret res[bool, Error].err{Error.revision{}}; }

    val lines_r: res[Lines, A.Error] = lines_init(m.a, text::*u8, str_len(text));
    if (sel lines_r.err) { ret res[bool, Error].err{Error.alloc{lines_r.err}}; }
    var lines: Lines = lines_r.ok;

    val res_text: res[str, A.Error] = str_dup(m.a, text);
    if (sel res_text.err) {
        lines_dnit(m.a, ?lines);
        ret res[bool, Error].err{Error.alloc{res_text.err}};
    }
    val text_copy: str = res_text.ok;

    str_free(m.a, file.text);
    lines_dnit(m.a, ?file.lines);

    file.text     = text_copy;
    file.lines    = lines;
    file.present  = true;
    file.revision = file.revision + 1;

    ret res[bool, Error].ok{true};
}

# a staged publication; `editor` holds the store's exclusive editor over the
# reserved slot of a new entry until commit or discard
pub rec PreparedLoad {
    owner:     *SourceMap;
    id:        FileId;
    key:       intern.StrId;
    file:      SourceFile;
    changed:   bool;
    new_entry: bool;
    editor:    handle.ChunkEditor[SourceFile];
}

# the caller exclusively borrows the map until commit or discard; a new entry
# reserves its slot here so commit_load cannot fail
pub fun prepare_load(m: *SourceMap, interner: *intern.Interner, path: str, text: str) res[PreparedLoad, Error] {
    val interned: res[intern.StrId, A.Error] = intern.add(interner, path);
    if (sel interned.err) { ret res[PreparedLoad, Error].err{Error.alloc{interned.err}}; }
    val key:      intern.StrId = interned.ok;
    var prepared: PreparedLoad = PreparedLoad{owner: m, key: key};
    val existing: opt[*FileId] = map.get[intern.StrId, FileId](?m.by_path, ?key);
    if (sel existing.some) {
        prepared.id = @existing.some;
        val current: opt[*SourceFile] = get(m, prepared.id);
        if (sel current.none) { ret res[PreparedLoad, Error].err{Error.unindexed{}}; }
        val file: *SourceFile = current.some;
        if (file.present && str_equals(file.text, text)) { ret res[PreparedLoad, Error].ok{prepared}; }
        if (file.revision == ~(0::u64))                  { ret res[PreparedLoad, Error].err{Error.revision{}}; }
        prepared.file.path     = file.path;
        prepared.file.revision = file.revision + 1;
    }
    or (sel existing.none) {
        if (identities_exhausted(m)) { ret res[PreparedLoad, Error].err{Error.exhausted{}}; }
        prepared.id = file_id(count(m)::u32);
        if (count(m) == 0) { prepared.id = file_id(1); }
        val editor_r: res[handle.ChunkEditor[SourceFile], handle.Error] = handle.chunk_editor[SourceFile](?m.files);
        if (sel editor_r.err) { ret res[PreparedLoad, Error].err{Error.store{editor_r.err}}; }
        prepared.editor        = editor_r.ok;
        prepared.new_entry     = true;
        prepared.file.revision = 1;
    }
    prepared.file.present = true;
    var transferred: bool = false;
    fin {
        if (!transferred) {
            if (prepared.new_entry) { str_free(m.a, prepared.file.path); }
            str_free(m.a, prepared.file.text);
            lines_dnit(m.a, ?prepared.file.lines);
            handle.chunk_editor_finish[SourceFile](?prepared.editor);
        }
    }
    if (prepared.new_entry) {
        val reserved: err[handle.Error] = handle.chunk_grow[SourceFile](?prepared.editor, slots_needed(m));
        if (sel reserved.err) { ret res[PreparedLoad, Error].err{Error.store{reserved.err}}; }
        val copied_path: res[str, A.Error] = str_dup(m.a, path);
        if (sel copied_path.err) { ret res[PreparedLoad, Error].err{Error.alloc{copied_path.err}}; }
        prepared.file.path = copied_path.ok;
    }
    val lines: res[Lines, A.Error] = lines_init(m.a, text::*u8, str_len(text));
    if (sel lines.err) { ret res[PreparedLoad, Error].err{Error.alloc{lines.err}}; }
    prepared.file.lines = lines.ok;
    val copied: res[str, A.Error] = str_dup(m.a, text);
    if (sel copied.err) { ret res[PreparedLoad, Error].err{Error.alloc{copied.err}}; }
    prepared.file.text = copied.ok;
    if (prepared.new_entry) {
        val indexed: res[bool, A.Error] = map.insert[intern.StrId, FileId](?m.by_path, key, prepared.id);
        if (sel indexed.err) { ret res[PreparedLoad, Error].err{Error.alloc{indexed.err}}; }
    }
    prepared.changed = true;
    transferred      = true;
    ret res[PreparedLoad, Error].ok{prepared};
}

pub fun discard_load(prepared: *PreparedLoad) {
    if (prepared.owner == nil) { ret; }
    val m: *SourceMap = prepared.owner;
    if (prepared.changed) {
        if (prepared.new_entry) {
            map.remove[intern.StrId, FileId](?m.by_path, ?prepared.key);
            str_free(m.a, prepared.file.path);
        }
        str_free(m.a, prepared.file.text);
        lines_dnit(m.a, ?prepared.file.lines);
    }
    handle.chunk_editor_finish[SourceFile](?prepared.editor);
    prepared.owner = nil;
    prepared.file  = SourceFile{};
}

# an existing file takes the staged payload in place; a new one lands in the
# slot prepare_load reserved. neither moves any other file
pub fun commit_load(prepared: *PreparedLoad) FileId {
    val m:  *SourceMap = prepared.owner;
    val id: FileId     = prepared.id;
    if (prepared.changed) {
        if (prepared.new_entry) {
            publish(?prepared.editor, prepared.file);
        }
        or {
            val file_o: opt[*SourceFile] = get(m, id);
            if (sel file_o.none) { panic("source: a staged update lost its file\n"); }
            or (sel file_o.some) {
                val file: *SourceFile = file_o.some;
                str_free(m.a, file.text);
                lines_dnit(m.a, ?file.lines);
                @file = prepared.file;
            }
        }
    }
    handle.chunk_editor_finish[SourceFile](?prepared.editor);
    prepared.owner = nil;
    prepared.file  = SourceFile{};
    ret id;
}

#[testing]
pub fun load(m: *SourceMap, interner: *intern.Interner, path: str, text: str) res[FileId, Error] {
    val staged: res[PreparedLoad, Error] = prepare_load(m, interner, path, text);
    if (sel staged.err) { ret res[FileId, Error].err{staged.err}; }
    var prepared: PreparedLoad = staged.ok;
    ret res[FileId, Error].ok{commit_load(?prepared)};
}

# preflight completes before query and editor owners are retired
pub fun prepare_release(m: *SourceMap, id: FileId) err[Error] {
    val file_o: opt[*SourceFile] = get(m, id);
    if (sel file_o.none) { ret err[Error].err{Error.absent{}}; }
    val file: *SourceFile = file_o.some;
    if (file.present && file.revision == ~(0::u64)) { ret err[Error].err{Error.revision{}}; }
    ret err[Error].ok{};
}

# free a file's text and line index in place and bump its revision. the slot
# keeps its path and identity: it is never moved, compacted or reissued to
# another file, so a `*SourceFile` held across the release stays valid and
# reads `present == false`. a future reuse of released slots must check the
# revision as a generation before trusting a stored FileId
pub fun release_payload(m: *SourceMap, id: FileId) {
    val file_o: opt[*SourceFile] = get(m, id);
    if (sel file_o.none) { ret; }
    val file: *SourceFile = file_o.some;
    if (!file.present) { ret; }
    str_free(m.a, file.text);
    lines_dnit(m.a, ?file.lines);
    file.text     = nil;
    file.lines    = Lines{};
    file.present  = false;
    file.revision = file.revision + 1;
}

# the file behind an id; none for FILE_NIL or an id the map never issued
#
# the returned `*SourceFile` is stable until `dnit`: the store never moves a
# file when the map grows, and a released slot keeps its address. the pointer
# may be held across later loads; `present` and `revision` tell the holder
# whether the payload behind it changed
pub fun get(m: *SourceMap, id: FileId) opt[*SourceFile] {
    if (file_is_nil(id)) { ret opt[*SourceFile].none{}; }
    ret handle.chunk_at[SourceFile](?m.files, file_index(id)::usize);
}

pub fun copy_file(file: *SourceFile, a: *A.Allocator) res[SourceFile, Error] {
    var copied:   SourceFile = SourceFile{present: file.present, revision: file.revision};
    var complete: bool       = false;
    fin {
        if (!complete) { dnit_file(?copied, a); }
    }
    val path: res[str, A.Error] = str_dup(a, file.path);
    if (sel path.err) { ret res[SourceFile, Error].err{Error.alloc{path.err}}; }
    copied.path = path.ok;
    if (file.present) {
        val text: res[str, A.Error] = str_dup(a, file.text);
        if (sel text.err) { ret res[SourceFile, Error].err{Error.alloc{text.err}}; }
        copied.text = text.ok;
        val lines: res[Lines, A.Error] = lines_init(a, copied.text::*u8, str_len(copied.text));
        if (sel lines.err) { ret res[SourceFile, Error].err{Error.alloc{lines.err}}; }
        copied.lines = lines.ok;
    }
    complete = true;
    ret res[SourceFile, Error].ok{copied};
}

pub fun dnit_file(file: *SourceFile, a: *A.Allocator) {
    str_free(a, file.path);
    str_free(a, file.text);
    lines_dnit(a, ?file.lines);
    @file = SourceFile{};
}

pub fun snapshot_from(src: *SourceMap, a: *A.Allocator) res[*SourceMap, Error] {
    if (src == nil || a == nil) { ret res[*SourceMap, Error].err{Error.unsupplied{}}; }

    val map_r: res[*SourceMap, A.Error] = A.allocate[SourceMap](a, 1);
    if (sel map_r.err) { ret res[*SourceMap, Error].err{Error.alloc{map_r.err}}; }
    val snap: *SourceMap = map_r.ok;
    @snap = init(a);

    # the path index is the same table on the snapshot's allocator: a clone
    # answers every lookup the original does without rehashing
    val index_r: res[map.Map[intern.StrId, FileId], A.Error] = map.clone[intern.StrId, FileId](?src.by_path, a);
    if (sel index_r.err) {
        dnit(snap);
        A.deallocate[SourceMap](a, snap, 1);
        ret res[*SourceMap, Error].err{Error.alloc{index_r.err}};
    }
    snap.by_path = index_r.ok;

    val src_len: usize = count(src);
    if (src_len == 0) { ret res[*SourceMap, Error].ok{snap}; }

    val editor_r: res[handle.ChunkEditor[SourceFile], handle.Error] = handle.chunk_editor[SourceFile](?snap.files);
    if (sel editor_r.err) {
        dnit(snap);
        A.deallocate[SourceMap](a, snap, 1);
        ret res[*SourceMap, Error].err{Error.store{editor_r.err}};
    }
    var editor: handle.ChunkEditor[SourceFile] = editor_r.ok;
    fin { handle.chunk_editor_finish[SourceFile](?editor); }
    val reserved: err[handle.Error] = handle.chunk_grow[SourceFile](?editor, src_len);
    if (sel reserved.err) {
        dnit(snap);
        A.deallocate[SourceMap](a, snap, 1);
        ret res[*SourceMap, Error].err{Error.store{reserved.err}};
    }

    var i: usize = 1;
    for (i < src_len) {
        val original:    opt[*SourceFile] = handle.chunk_at[SourceFile](?src.files, i);
        var source_file: *SourceFile      = nil;
        if (sel original.some)  { source_file = original.some; }
        if (source_file == nil) { panic("source: a snapshot source lost a counted file\n"); }
        val copied: res[SourceFile, Error] = copy_file(source_file, a);
        if (sel copied.err) {
            dnit(snap);
            A.deallocate[SourceMap](a, snap, 1);
            ret res[*SourceMap, Error].err{copied.err};
        }
        publish(?editor, copied.ok);
        i = i + 1;
    }

    ret res[*SourceMap, Error].ok{snap};
}

# the line and column of `offset` in the file; an offset past the end is
# placed at the end
pub fun position(file: *SourceFile, offset: usize) Position {
    ret lines_position(?file.lines, offset);
}

# the offset line `line` (from 1) starts at; reached only by mach-lsp
pub fun line_start(file: *SourceFile, line: usize) opt[usize] {
    if (line == 0 || line > file.lines.len) { ret opt[usize].none{}; }
    ret opt[usize].some{file.lines.starts[line - 1]};
}

# the bytes of line `line` (from 1) without its line ending
pub fun line_bounds(file: *SourceFile, line: usize) opt[Span] {
    if (line == 0 || line > file.lines.len) { ret opt[Span].none{}; }

    val start: usize = file.lines.starts[line - 1];
    var end:   usize = str_len(file.text);
    if (line < file.lines.len) { end = file.lines.starts[line]; }

    for (end > start && (file.text[end - 1] == '\n' || file.text[end - 1] == '\r')) {
        end = end - 1;
    }
    ret opt[Span].some{span_between(start, end)};
}

# the line index of the `n` bytes at `data`; released with `lines_dnit`
pub fun lines_init(a: *A.Allocator, data: *u8, n: usize) res[Lines, A.Error] {
    var count: usize = 1;
    var i:     usize = 0;
    for (i < n) {
        if (data[i] == '\n') { count = count + 1; }
        i = i + 1;
    }

    val starts_r: res[*usize, A.Error] = A.allocate[usize](a, count);
    if (sel starts_r.err) { ret res[Lines, A.Error].err{starts_r.err}; }
    val starts: *usize = starts_r.ok;

    starts[0] = 0;
    var at: usize = 1;
    i = 0;
    for (i < n) {
        if (data[i] == '\n') {
            starts[at] = i + 1;
            at         = at + 1;
        }
        i = i + 1;
    }
    ret res[Lines, A.Error].ok{Lines{starts: starts, len: count, n: n}};
}

pub fun lines_dnit(a: *A.Allocator, l: *Lines) {
    if (l.starts != nil && l.len > 0) { A.deallocate[usize](a, l.starts, l.len); }
    @l = Lines{};
}

# the line and column of `offset`, clamped to the text's end
pub fun lines_position(l: *Lines, offset: usize) Position {
    var at: usize = offset;
    if (at > l.n)   { at = l.n; }
    if (l.len == 0) { ret Position{line: 1, col: 1}; }
    var lo: usize = 0;
    var hi: usize = l.len;
    for (hi - lo > 1) {
        val mid: usize = lo + (hi - lo) / 2;
        if (l.starts[mid] <= at) { lo = mid; }
        or                       { hi = mid; }
    }
    ret Position{line: lo + 1, col: at - l.starts[lo] + 1};
}

test load__dedup_by_path {
    var a: A.Allocator;
    page.make(?a);

    var ix: intern.Interner = intern.init(?a);
    var m:  SourceMap       = init(?a);

    val res1: res[FileId, Error] = load(?m, ?ix, "p1.mach", "a");
    if (sel res1.err) { ret 1; }
    val fid1: FileId = res1.ok;

    val res2: res[FileId, Error] = load(?m, ?ix, "p1.mach", "b");
    if (sel res2.err) { ret 1; }
    val fid2: FileId = res2.ok;

    if (!file_same(fid1, fid2)) { ret 1; }
    if (m.by_path.len != 1)     { ret 1; }
    if (count(?m) != 2)         { ret 1; }

    val file1_o: opt[*SourceFile] = get(?m, fid1);
    if (sel file1_o.none) { ret 1; }
    val file1: *SourceFile = file1_o.some;
    if (str_len(file1.text) != 1) { ret 1; }
    if (file1.text[0] != 'b')     { ret 1; }

    val res3: res[FileId, Error] = load(?m, ?ix, "p2.mach", "c");
    if (sel res3.err) { ret 1; }
    val fid3: FileId = res3.ok;
    if (file_same(fid3, fid1)) { ret 1; }
    if (m.by_path.len != 2)    { ret 1; }
    if (count(?m) != 3)        { ret 1; }

    dnit(?m);
    intern.dnit(?ix);
    ret 0;
}

test get__pointer_stays_valid_across_growth {
    var a: A.Allocator;
    page.make(?a);

    var m: SourceMap = init(?a);
    fin { dnit(?m); }

    val first_r: res[FileId, Error] = add(?m, "first.mach", "alpha\nbeta");
    if (sel first_r.err) { ret 1; }
    val fid:    FileId           = first_r.ok;
    val held_o: opt[*SourceFile] = get(?m, fid);
    if (sel held_o.none) { ret 1; }
    val held: *SourceFile = held_o.some;

    # grow past 8, 16, 32, 64 and 128 files; the held pointer must not move at any boundary
    var i: usize = 0;
    for (i < 200) {
        val filler: res[FileId, Error] = add(?m, "filler.mach", "x");
        if (sel filler.err) { ret 1; }
        val again: opt[*SourceFile] = get(?m, fid);
        if (sel again.none)     { ret 1; }
        if (again.some != held) { ret 2; }
        i = i + 1;
    }

    if (!held.present)                                    { ret 3; }
    if (!str_equals(held.path, "first.mach"))             { ret 3; }
    if (!str_equals(held.text, "alpha\nbeta"))            { ret 3; }
    if (held.lines.len != 2 || held.lines.starts[1] != 6) { ret 3; }
    val fresh: opt[*SourceFile] = get(?m, fid);
    if (sel fresh.none)                          { ret 1; }
    if (fresh.some != held)                      { ret 2; }
    if (!str_equals(fresh.some.text, held.text)) { ret 3; }
    ret 0;
}

test update__identical_text_preserves_storage {
    var a: A.Allocator;
    page.make(?a);

    var ix: intern.Interner = intern.init(?a);
    var m:  SourceMap       = init(?a);

    val res1: res[FileId, Error] = load(?m, ?ix, "p.mach", "hello\nworld");
    if (sel res1.err) { ret 1; }
    val fid:    FileId           = res1.ok;
    val file_o: opt[*SourceFile] = get(?m, fid);
    if (sel file_o.none) { ret 1; }
    val file:      *SourceFile      = file_o.some;
    val text0:     str              = file.text;
    val lines0:    *usize           = file.lines.starts;
    val revision:  u64              = file.revision;
    val identical: res[bool, Error] = update(?m, fid, "hello\nworld");
    if (sel identical.err)         { ret 2; }
    if (identical.ok)              { ret 2; }
    if (file.revision != revision) { ret 3; }

    val res2: res[FileId, Error] = load(?m, ?ix, "p.mach", "hello\nworld");
    if (sel res2.err)                { ret 1; }
    if (file.text != text0)          { ret 1; }
    if (file.lines.starts != lines0) { ret 1; }

    val res3: res[FileId, Error] = load(?m, ?ix, "p.mach", "hello\nthere");
    if (sel res3.err)        { ret 1; }
    if (file.text[6] != 't') { ret 1; }

    dnit(?m);
    intern.dnit(?ix);
    ret 0;
}

test snapshot_from__owns_paths_text_and_line_indexes {
    var a: A.Allocator;
    page.make(?a);

    var m:  SourceMap       = init(?a);
    var ix: intern.Interner = intern.init(?a);

    val file_r: res[FileId, Error] = load(?m, ?ix, "p.mach", "one\ntwo");
    if (sel file_r.err) {
        intern.dnit(?ix);
        dnit(?m);
        ret 1;
    }
    val fid: FileId = file_r.ok;

    val snap_r: res[*SourceMap, Error] = snapshot_from(?m, ?a);
    if (sel snap_r.err) {
        intern.dnit(?ix);
        dnit(?m);
        ret 1;
    }
    val snap: *SourceMap = snap_r.ok;

    val update_r: res[bool, Error] = update(?m, fid, "changed");
    if (sel update_r.err) {
        dnit(snap);
        A.deallocate[SourceMap](?a, snap, 1);
        intern.dnit(?ix);
        dnit(?m);
        ret 1;
    }

    val file_o: opt[*SourceFile] = get(snap, fid);
    var bad:    i32              = 0;
    if (sel file_o.none) { bad = 1; }
    or (sel file_o.some) {
        val file: *SourceFile = file_o.some;
        if (!str_equals(file.path, "p.mach"))                 { bad = 1; }
        if (!str_equals(file.text, "one\ntwo"))               { bad = 1; }
        if (file.lines.len != 2 || file.lines.starts[1] != 4) { bad = 1; }
        if (snap.by_path.len != 1)                            { bad = 1; }
    }

    dnit(snap);
    A.deallocate[SourceMap](?a, snap, 1);
    intern.dnit(?ix);
    dnit(?m);
    ret bad;
}

test position__maps_an_offset_to_its_line_and_column {
    var a: A.Allocator;
    page.make(?a);

    var m: SourceMap = init(?a);

    val res_fid: res[FileId, Error] = add(?m, "p.mach", "ab\ncde\nf");
    if (sel res_fid.err) { ret 1; }
    val fid: FileId = res_fid.ok;

    val l: Location = location(fid, span(4, 2));
    if (!location_is_valid(l))             { ret 1; }
    if (!file_same(l.file, fid))           { ret 1; }
    if (location_is_valid(location_nil())) { ret 1; }

    val file_o: opt[*SourceFile] = get(?m, fid);
    if (sel file_o.none) { ret 1; }
    val p: Position = position(file_o.some, l.span.offset);
    if (p.line != 2 || p.col != 2) { ret 1; }
    val past: Position = position(file_o.some, 99);
    if (past.line != 3 || past.col != 2) { ret 2; }
    val bounds: opt[Span] = line_bounds(file_o.some, 2);
    if (sel bounds.none)                                 { ret 3; }
    if (bounds.some.offset != 3 || bounds.some.len != 3) { ret 3; }

    dnit(?m);
    ret 0;
}

test add__identity_exhaustion_precedes_allocation_or_publication {
    var tracked: T.Testing;
    val make_r:  err[A.Error] = T.make(?tracked);
    if (sel make_r.err) { ret 1; }
    fin { T.dnit(?tracked); }
    var m:     SourceMap = init(T.allocator_of(?tracked));
    var limit: usize     = ~(0::usize);
    $if ($mach.build.pointer_width == 8) { limit = 0x100000000::usize; }
    m.files.len = limit;
    T.fail_at_ordinal(?tracked, 1);
    val refused: res[FileId, Error] = add(?m, "full.mach", "");
    var bad:     i32                = 0;
    if (sel refused.ok)                                                                            { bad = 2; }
    or (sel refused.err && !str_equals(text(refused.err), "source file identities are exhausted")) { bad = 3; }
    if (count(?m) != limit || T.attempt_count(?tracked) != 0)                                      { bad = 4; }
    m.files.len = 0;
    dnit(?m);
    if (T.leaked(?tracked) || T.double_free_count(?tracked) != 0) { bad = 5; }
    ret bad;
}
