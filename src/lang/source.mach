use std.allocator.page;
use std.collections.map;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use std.memory;

use mach.lang.intern;
pub def FileId: u32;

pub val FILE_NIL: FileId = 0;

pub rec SrcLoc {
    file:   FileId;
    offset: usize;
}

pub fun loc(file: FileId, offset: usize) SrcLoc {
    var l: SrcLoc;
    l.file   = file;
    l.offset = offset;
    ret l;
}

pub fun loc_nil() SrcLoc {
    ret loc(FILE_NIL, 0);
}

pub fun loc_is_valid(l: SrcLoc) bool {
    ret l.file != FILE_NIL;
}

pub rec Position {
    line: usize;
    col:  usize;
}

pub rec LineSpan {
    start: usize;
    end:   usize;
}

pub rec SourceFile {
    path:        str;
    text:        str;
    line_starts: *usize;
    line_len:    usize;
}

pub rec SourceMap {
    a:       *A.Allocator;
    files:   *SourceFile;
    len:     usize;
    cap:     usize;
    by_path: map.Map[intern.StrId, FileId];
}

val INITIAL_FILE_CAP: usize = 8;

pub fun init(a: *A.Allocator) SourceMap {
    var m: SourceMap;
    m.a       = a;
    m.files   = nil;
    m.len     = 0;
    m.cap     = 0;
    m.by_path = map.init[intern.StrId, FileId](a, map.hash_u32, map.eq_u32);
    ret m;
}

pub fun dnit(m: *SourceMap) {
    if (m == nil) { ret; }

    var i: usize = 1;
    for (i < m.len) {
        val file: *SourceFile = ?m.files[i];
        str_free(m.a, file.path);
        str_free(m.a, file.text);
        line_index_free(m.a, file.line_starts, file.line_len);
        i = i + 1;
    }

    if (m.files != nil && m.cap > 0) {
        A.deallocate[SourceFile](m.a, m.files, m.cap);
    }
    map.dnit[intern.StrId, FileId](?m.by_path);

    m.files = nil;
    m.len   = 0;
    m.cap   = 0;
}

pub fun add(m: *SourceMap, path: str, text: str) R.Result[FileId, str] {
    if (m.len == 0) {
        val res_sentinel: R.Result[R.Void, str] = files_reserve(m);
        if (R.is_err[R.Void, str](res_sentinel)) { ret R.err[FileId, str](R.unwrap_err[R.Void, str](res_sentinel)); }
        m.len = 1;
    }
    var line_len: usize = 0;
    val res_starts: R.Result[*usize, str] = line_index_build(m.a, text, ?line_len);
    if (R.is_err[*usize, str](res_starts)) {
        ret R.err[FileId, str](R.unwrap_err[*usize, str](res_starts));
    }
    val starts: *usize = R.unwrap_ok[*usize, str](res_starts);

    val res_path: R.Result[str, str] = str_dup(m.a, path);
    if (R.is_err[str, str](res_path)) {
        line_index_free(m.a, starts, line_len);
        ret R.err[FileId, str](R.unwrap_err[str, str](res_path));
    }
    val path_copy: str = R.unwrap_ok[str, str](res_path);

    val res_text: R.Result[str, str] = str_dup(m.a, text);
    if (R.is_err[str, str](res_text)) {
        str_free(m.a, path_copy);
        line_index_free(m.a, starts, line_len);
        ret R.err[FileId, str](R.unwrap_err[str, str](res_text));
    }
    val text_copy: str = R.unwrap_ok[str, str](res_text);

    val res_reserve: R.Result[R.Void, str] = files_reserve(m);
    if (R.is_err[R.Void, str](res_reserve)) {
        str_free(m.a, text_copy);
        str_free(m.a, path_copy);
        line_index_free(m.a, starts, line_len);
        ret R.err[FileId, str](R.unwrap_err[R.Void, str](res_reserve));
    }

    var file: SourceFile;
    file.path        = path_copy;
    file.text        = text_copy;
    file.line_starts = starts;
    file.line_len    = line_len;

    val id: FileId = m.len::u32;
    m.files[m.len] = file;
    m.len = m.len + 1;

    ret R.ok[FileId, str](id);
}

pub fun update(m: *SourceMap, id: FileId, text: str) R.Result[bool, str] {
    if (id::usize >= m.len) { ret R.ok[bool, str](false); }

    val file: *SourceFile = ?m.files[id];

    if (str_equals(file.text, text)) { ret R.ok[bool, str](true); }

    var line_len: usize = 0;
    val res_starts: R.Result[*usize, str] = line_index_build(m.a, text, ?line_len);
    if (R.is_err[*usize, str](res_starts)) {
        ret R.err[bool, str](R.unwrap_err[*usize, str](res_starts));
    }
    val starts: *usize = R.unwrap_ok[*usize, str](res_starts);

    val res_text: R.Result[str, str] = str_dup(m.a, text);
    if (R.is_err[str, str](res_text)) {
        line_index_free(m.a, starts, line_len);
        ret R.err[bool, str](R.unwrap_err[str, str](res_text));
    }
    val text_copy: str = R.unwrap_ok[str, str](res_text);

    str_free(m.a, file.text);
    line_index_free(m.a, file.line_starts, file.line_len);

    file.text        = text_copy;
    file.line_starts = starts;
    file.line_len    = line_len;

    ret R.ok[bool, str](true);
}

pub fun load(m: *SourceMap, interner: *intern.Interner, path: str, text: str) R.Result[FileId, str] {
    val res_pid: R.Result[intern.StrId, str] = intern.intern(interner, path);
    if (R.is_err[intern.StrId, str](res_pid)) {
        ret R.err[FileId, str](R.unwrap_err[intern.StrId, str](res_pid));
    }
    val pid: intern.StrId = R.unwrap_ok[intern.StrId, str](res_pid);

    val res_existing: R.Result[*FileId, str] = map.get[intern.StrId, FileId](?m.by_path, ?pid);
    if (R.is_ok[*FileId, str](res_existing)) {
        val fid: FileId = @R.unwrap_ok[*FileId, str](res_existing);
        val changed_r: R.Result[bool, str] = update(m, fid, text);
        if (R.is_err[bool, str](changed_r)) {
            ret R.err[FileId, str](R.unwrap_err[bool, str](changed_r));
        }
        ret R.ok[FileId, str](fid);
    }

    val res_add: R.Result[FileId, str] = add(m, path, text);
    if (R.is_err[FileId, str](res_add)) { ret res_add; }
    val fid: FileId = R.unwrap_ok[FileId, str](res_add);

    val res_insert: R.Result[bool, str] = map.insert[intern.StrId, FileId](?m.by_path, pid, fid);
    if (R.is_err[bool, str](res_insert)) {
        ret R.err[FileId, str](R.unwrap_err[bool, str](res_insert));
    }
    ret R.ok[FileId, str](fid);
}

pub fun get(m: *SourceMap, id: FileId) O.Option[*SourceFile] {
    if (id == FILE_NIL || id::usize >= m.len) { ret O.none[*SourceFile](); }
    ret O.some[*SourceFile](?m.files[id]);
}

fun snapshot_path_index(src: *SourceMap, dst: *SourceMap) R.Result[R.Void, str] {
    val cap: usize = src.by_path.cap;
    if (cap == 0) { ret R.ok_void[str](); }

    val keys_r: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](dst.a, cap);
    if (R.is_err[*intern.StrId, str](keys_r)) { ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](keys_r)); }
    val keys: *intern.StrId = R.unwrap_ok[*intern.StrId, str](keys_r);

    val values_r: R.Result[*FileId, str] = A.allocate[FileId](dst.a, cap);
    if (R.is_err[*FileId, str](values_r)) {
        A.deallocate[intern.StrId](dst.a, keys, cap);
        ret R.err[R.Void, str](R.unwrap_err[*FileId, str](values_r));
    }
    val values: *FileId = R.unwrap_ok[*FileId, str](values_r);

    val states_r: R.Result[*u8, str] = A.allocate[u8](dst.a, cap);
    if (R.is_err[*u8, str](states_r)) {
        A.deallocate[FileId](dst.a, values, cap);
        A.deallocate[intern.StrId](dst.a, keys, cap);
        ret R.err[R.Void, str](R.unwrap_err[*u8, str](states_r));
    }
    val states: *u8 = R.unwrap_ok[*u8, str](states_r);

    memory.raw_copy(keys::ptr, src.by_path.keys::ptr, cap * $size_of(intern.StrId));
    memory.raw_copy(values::ptr, src.by_path.values::ptr, cap * $size_of(FileId));
    memory.raw_copy(states::ptr, src.by_path.states::ptr, cap);
    dst.by_path.keys       = keys;
    dst.by_path.values     = values;
    dst.by_path.states     = states;
    dst.by_path.len        = src.by_path.len;
    dst.by_path.tombstones = src.by_path.tombstones;
    dst.by_path.cap        = cap;
    ret R.ok_void[str]();
}

pub fun snapshot_from(src: *SourceMap, a: *A.Allocator) R.Result[*SourceMap, str] {
    if (src == nil || a == nil) { ret R.err[*SourceMap, str]("source snapshot requires a map and allocator"); }

    val map_r: R.Result[*SourceMap, str] = A.allocate[SourceMap](a, 1);
    if (R.is_err[*SourceMap, str](map_r)) { ret map_r; }
    val snap: *SourceMap = R.unwrap_ok[*SourceMap, str](map_r);
    @snap = init(a);

    val index_r: R.Result[R.Void, str] = snapshot_path_index(src, snap);
    if (R.is_err[R.Void, str](index_r)) {
        dnit(snap);
        A.deallocate[SourceMap](a, snap, 1);
        ret R.err[*SourceMap, str](R.unwrap_err[R.Void, str](index_r));
    }

    if (src.len == 0) { ret R.ok[*SourceMap, str](snap); }

    val files_r: R.Result[*SourceFile, str] = A.allocate[SourceFile](a, src.len);
    if (R.is_err[*SourceFile, str](files_r)) {
        dnit(snap);
        A.deallocate[SourceMap](a, snap, 1);
        ret R.err[*SourceMap, str](R.unwrap_err[*SourceFile, str](files_r));
    }
    snap.files = R.unwrap_ok[*SourceFile, str](files_r);
    snap.cap   = src.len;
    snap.len   = 1;

    var i: usize = 1;
    for (i < src.len) {
        val file: *SourceFile = ?src.files[i];

        val path_r: R.Result[str, str] = str_dup(a, file.path);
        if (R.is_err[str, str](path_r)) {
            dnit(snap);
            A.deallocate[SourceMap](a, snap, 1);
            ret R.err[*SourceMap, str](R.unwrap_err[str, str](path_r));
        }
        val path_copy: str = R.unwrap_ok[str, str](path_r);

        val text_r: R.Result[str, str] = str_dup(a, file.text);
        if (R.is_err[str, str](text_r)) {
            str_free(a, path_copy);
            dnit(snap);
            A.deallocate[SourceMap](a, snap, 1);
            ret R.err[*SourceMap, str](R.unwrap_err[str, str](text_r));
        }
        val text_copy: str = R.unwrap_ok[str, str](text_r);

        var line_len: usize = 0;
        val lines_r: R.Result[*usize, str] = line_index_build(a, text_copy, ?line_len);
        if (R.is_err[*usize, str](lines_r)) {
            str_free(a, text_copy);
            str_free(a, path_copy);
            dnit(snap);
            A.deallocate[SourceMap](a, snap, 1);
            ret R.err[*SourceMap, str](R.unwrap_err[*usize, str](lines_r));
        }

        var copy: SourceFile;
        copy.path        = path_copy;
        copy.text        = text_copy;
        copy.line_starts = R.unwrap_ok[*usize, str](lines_r);
        copy.line_len    = line_len;
        snap.files[i]    = copy;
        snap.len         = i + 1;
        i = i + 1;
    }

    ret R.ok[*SourceMap, str](snap);
}

pub fun position(file: *SourceFile, offset: usize) Position {
    var lo: usize = 0;
    var hi: usize = file.line_len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (file.line_starts[mid] <= offset) {
            lo = mid + 1;
        }
        or {
            hi = mid;
        }
    }

    var p: Position;
    p.line = lo;
    p.col  = offset - file.line_starts[lo - 1] + 1;
    ret p;
}

pub fun line_start(file: *SourceFile, line: usize) O.Option[usize] {
    if (line == 0 || line > file.line_len) { ret O.none[usize](); }
    ret O.some[usize](file.line_starts[line - 1]);
}

pub fun line_bounds(file: *SourceFile, line: usize) O.Option[LineSpan] {
    if (line == 0 || line > file.line_len) { ret O.none[LineSpan](); }

    val start:    usize = file.line_starts[line - 1];
    val text_len: usize = str_len(file.text);

    var end: usize = text_len;
    if (line < file.line_len) { end = file.line_starts[line]; }

    for (end > start && (file.text[end - 1] == '\n' || file.text[end - 1] == '\r')) {
        end = end - 1;
    }

    var ls: LineSpan;
    ls.start = start;
    ls.end   = end;
    ret O.some[LineSpan](ls);
}

fun line_index_build(a: *A.Allocator, text: str, out_len: *usize) R.Result[*usize, str] {
    val text_len: usize = str_len(text);

    var line_len: usize = 1;
    var i:        usize = 0;
    for (i < text_len) {
        if (text[i] == '\n') { line_len = line_len + 1; }
        i = i + 1;
    }

    val res_starts: R.Result[*usize, str] = A.allocate[usize](a, line_len);
    if (R.is_err[*usize, str](res_starts)) {
        ret R.err[*usize, str](R.unwrap_err[*usize, str](res_starts));
    }
    val starts: *usize = R.unwrap_ok[*usize, str](res_starts);

    starts[0] = 0;
    var idx: usize = 1;
    i = 0;
    for (i < text_len) {
        if (text[i] == '\n') {
            starts[idx] = i + 1;
            idx = idx + 1;
        }
        i = i + 1;
    }

    @out_len = line_len;
    ret R.ok[*usize, str](starts);
}

fun line_index_free(a: *A.Allocator, starts: *usize, len: usize) {
    if (starts != nil && len > 0) {
        A.deallocate[usize](a, starts, len);
    }
}

fun files_reserve(m: *SourceMap) R.Result[R.Void, str] {
    if (m.len < m.cap) { ret R.ok_void[str](); }

    var new_cap: usize = m.cap * 2;
    if (new_cap == 0) { new_cap = INITIAL_FILE_CAP; }

    var res_files: R.Result[*SourceFile, str];
    if (m.files == nil) {
        res_files = A.allocate[SourceFile](m.a, new_cap);
    }
    or {
        res_files = A.reallocate[SourceFile](m.a, m.files, m.cap, new_cap);
    }
    if (R.is_err[*SourceFile, str](res_files)) {
        ret R.err[R.Void, str](R.unwrap_err[*SourceFile, str](res_files));
    }

    m.files = R.unwrap_ok[*SourceFile, str](res_files);
    m.cap   = new_cap;
    ret R.ok_void[str]();
}

test "mach.lang.source.load:dedup_by_path" {
    var a: A.Allocator;
    page.make(?a);

    var ix: intern.Interner = intern.init(?a);
    var m:  SourceMap       = init(?a);

    val res1: R.Result[FileId, str] = load(?m, ?ix, "p1.mach", "a");
    if (R.is_err[FileId, str](res1)) { ret 1; }
    val fid1: FileId = R.unwrap_ok[FileId, str](res1);

    val res2: R.Result[FileId, str] = load(?m, ?ix, "p1.mach", "b");
    if (R.is_err[FileId, str](res2)) { ret 1; }
    val fid2: FileId = R.unwrap_ok[FileId, str](res2);

    if (fid1 != fid2)       { ret 1; }
    if (m.by_path.len != 1) { ret 1; }
    if (m.len != 2)         { ret 1; }

    val file1: *SourceFile = ?m.files[fid1::usize];
    if (str_len(file1.text) != 1) { ret 1; }
    if (file1.text[0] != 'b')     { ret 1; }

    val res3: R.Result[FileId, str] = load(?m, ?ix, "p2.mach", "c");
    if (R.is_err[FileId, str](res3)) { ret 1; }
    val fid3: FileId = R.unwrap_ok[FileId, str](res3);
    if (fid3 == fid1)       { ret 1; }
    if (m.by_path.len != 2) { ret 1; }
    if (m.len != 3)         { ret 1; }

    dnit(?m);
    intern.dnit(?ix);
    ret 0;
}

test "mach.lang.source.update:identical_text_preserves_storage" {
    var a: A.Allocator;
    page.make(?a);

    var ix: intern.Interner = intern.init(?a);
    var m:  SourceMap       = init(?a);

    val res1: R.Result[FileId, str] = load(?m, ?ix, "p.mach", "hello\nworld");
    if (R.is_err[FileId, str](res1)) { ret 1; }
    val fid: FileId = R.unwrap_ok[FileId, str](res1);
    val text0: str = (?m.files[fid::usize]).text;
    val lines0: *usize = (?m.files[fid::usize]).line_starts;

    val res2: R.Result[FileId, str] = load(?m, ?ix, "p.mach", "hello\nworld");
    if (R.is_err[FileId, str](res2)) { ret 1; }
    if ((?m.files[fid::usize]).text != text0) { ret 1; }
    if ((?m.files[fid::usize]).line_starts != lines0) { ret 1; }

    val res3: R.Result[FileId, str] = load(?m, ?ix, "p.mach", "hello\nthere");
    if (R.is_err[FileId, str](res3)) { ret 1; }
    if ((?m.files[fid::usize]).text[6] != 't') { ret 1; }

    dnit(?m);
    intern.dnit(?ix);
    ret 0;
}

test "mach.lang.source.snapshot_from:owns_paths_text_and_line_indexes" {
    var a: A.Allocator;
    page.make(?a);

    var m: SourceMap = init(?a);
    var ix: intern.Interner = intern.init(?a);

    val file_r: R.Result[FileId, str] = load(?m, ?ix, "p.mach", "one\ntwo");
    if (R.is_err[FileId, str](file_r)) { intern.dnit(?ix); dnit(?m); ret 1; }
    val fid: FileId = R.unwrap_ok[FileId, str](file_r);

    val snap_r: R.Result[*SourceMap, str] = snapshot_from(?m, ?a);
    if (R.is_err[*SourceMap, str](snap_r)) { intern.dnit(?ix); dnit(?m); ret 1; }
    val snap: *SourceMap = R.unwrap_ok[*SourceMap, str](snap_r);

    if (R.is_err[bool, str](update(?m, fid, "changed"))) {
        dnit(snap); A.deallocate[SourceMap](?a, snap, 1); intern.dnit(?ix); dnit(?m); ret 1;
    }

    val file_o: O.Option[*SourceFile] = get(snap, fid);
    var bad: i32 = 0;
    if (O.is_none[*SourceFile](file_o)) { bad = 1; }
    or {
        val file: *SourceFile = O.unwrap[*SourceFile](file_o);
        if (!str_equals(file.path, "p.mach")) { bad = 1; }
        if (!str_equals(file.text, "one\ntwo")) { bad = 1; }
        if (file.line_len != 2 || file.line_starts[1] != 4) { bad = 1; }
        if (snap.by_path.len != 1) { bad = 1; }
    }

    dnit(snap);
    A.deallocate[SourceMap](?a, snap, 1);
    intern.dnit(?ix);
    dnit(?m);
    ret bad;
}

test "mach.lang.source.srcloc:offset_roundtrips_to_line_col" {
    var a: A.Allocator;
    page.make(?a);

    var m:  SourceMap     = init(?a);

    val res_fid: R.Result[FileId, str] = add(?m, "p.mach", "ab\ncde\nf");
    if (R.is_err[FileId, str](res_fid)) { ret 1; }
    val fid: FileId = R.unwrap_ok[FileId, str](res_fid);

    val l: SrcLoc = loc(fid, 4);
    if (!loc_is_valid(l))        { ret 1; }
    if (l.file != fid)           { ret 1; }
    if (l.offset != 4)           { ret 1; }
    if (loc_is_valid(loc_nil())) { ret 1; }

    val file: *SourceFile = ?m.files[fid::usize];
    val p: Position = position(file, l.offset);
    if (p.line != 2) { ret 1; }
    if (p.col != 2)  { ret 1; }

    dnit(?m);
    ret 0;
}
