# the stack the compiler's recursive readers run on
#
# a reader whose depth follows its input asks exhausted() on each step and
# refuses with its located diagnostic once less than MARGIN is left, so no fixed
# nesting bound or linker reserve has to be sized for the deepest input. where
# the host has threads the driver runs on a thread whose stack it sizes itself
# (run), so how deep an input may nest does not follow the platform's main-thread
# reserve or ulimit -s. a threadless host runs on the calling thread and the
# margin alone holds the bound.

use std.system.capability;
use system_os: std.system.os;
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.size.usize;

$if (capability.HAS_THREADS) {
    use sync_thread: std.sync.thread;
}

# the stack a reader keeps in hand when it refuses. it covers the deepest
# frames a reader's refusal and its diagnostic still need
val MARGIN: usize = 262144;

# the stack run gives its thread. it is address space, committed only as used
pub val WORKER_RESERVE: usize = 67108864;

# the limit of a thread whose stack std cannot bound, below every frame's address
val UNBOUNDED: usize = 1;

# the address under which less than MARGIN is left on the calling thread's stack. a
# thread's stack bounds never change, so each thread reads them on its first ask; 0 is unread
#[thread]
var limit: usize;

# whether less than MARGIN is left below the caller's frame. a thread whose
# stack std cannot bound answers false, and the reader's fixed bound holds
pub fun exhausted() bool {
    var here: u8 = 0;
    if (limit == 0) { limit = limit_read(); }
    ret (?here)::usize < limit;
}

fun limit_read() usize {
    var low:  usize = 0;
    var high: usize = 0;
    if (!system_os.stack_bounds(?low, ?high)) { ret UNBOUNDED; }
    ret low + MARGIN;
}

# run f(arg) to completion on a thread with a WORKER_RESERVE stack
pub fun run(f: fun(*u8), arg: *u8) {
    run_reserved(f, arg, WORKER_RESERVE);
}

# run f(arg) to completion on a thread with reserve bytes of stack, or on the
# calling thread where the host has no threads or refuses one. total: a thread
# it spawned is always joinable, so a refused join stops the compiler
pub fun run_reserved(f: fun(*u8), arg: *u8, reserve: usize) {
    $if (capability.HAS_THREADS) {
        var c: sync_thread.Config;
        sync_thread.config_default(?c);
        c.stack_reserve = reserve;
        var t:       sync_thread.Thread;
        val spawned: sync_thread.Operation = sync_thread.spawn_with_config(f, arg, ?c, ?t);
        if (sel spawned.ok) {
            val joined: sync_thread.Operation = sync_thread.join(?t);
            if (sel joined.err) { panic("mach: the worker thread could not be joined\n"); }
            ret;
        }
    }
    f(arg);
}
