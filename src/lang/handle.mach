use std.allocator.page;
use std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

val CHUNK_CAPACITY: usize = 64;

pub rec StableChunks[T] {
    a:       *A.Allocator;
    chunks:  Vector[*T];
    len:     usize;
    editing: bool;
}

pub rec ChunkEditor[T] {
    store: *StableChunks[T];
}

pub fun chunk_init[T](a: *A.Allocator) StableChunks[T] {
    var s: StableChunks[T];
    s.a       = a;
    s.chunks  = vector.init[*T](a);
    s.len     = 0;
    s.editing = false;
    ret s;
}

pub fun chunk_dnit[T](s: *StableChunks[T]) {
    if (s == nil) { ret; }
    var i: usize = 0;
    for (i < s.chunks.len) {
        A.deallocate[T](s.a, s.chunks.data[i], CHUNK_CAPACITY);
        i = i + 1;
    }
    vector.dnit[*T](?s.chunks);
    s.len     = 0;
    s.editing = false;
}

pub fun chunk_count[T](s: *StableChunks[T]) usize {
    if (s == nil) { ret 0; }
    ret s.len;
}

pub fun chunk_get[T](s: *StableChunks[T], index: usize) R.Result[*T, str] {
    if (s == nil)       { ret R.err[*T, str]("store is nil"); }
    if (index >= s.len) { ret R.err[*T, str]("index out of bounds"); }
    val chunk_idx: usize = index / CHUNK_CAPACITY;
    val offset:    usize = index % CHUNK_CAPACITY;
    val chunk: *T = s.chunks.data[chunk_idx];
    ret R.ok[*T, str](?chunk[offset]);
}

pub fun chunk_edit[T](s: *StableChunks[T]) R.Result[ChunkEditor[T], str] {
    if (s == nil)  { ret R.err[ChunkEditor[T], str]("store is nil"); }
    if (s.editing) { ret R.err[ChunkEditor[T], str]("store already has an exclusive editor"); }
    s.editing = true;
    var e: ChunkEditor[T];
    e.store = s;
    ret R.ok[ChunkEditor[T], str](e);
}

pub fun chunk_editor_finish[T](e: *ChunkEditor[T]) {
    if (e == nil || e.store == nil) { ret; }
    e.store.editing = false;
    e.store = nil;
}

fun chunk_grow_one[T](s: *StableChunks[T]) R.Result[R.Void, str] {
    val alloc_r: R.Result[*T, str] = A.zallocate[T](s.a, CHUNK_CAPACITY);
    if (R.is_err[*T, str](alloc_r)) { ret R.err[R.Void, str](R.unwrap_err[*T, str](alloc_r)); }
    val new_chunk: *T = R.unwrap_ok[*T, str](alloc_r);

    val push_r: R.Result[usize, str] = vector.push[*T](?s.chunks, new_chunk);
    if (R.is_err[usize, str](push_r)) {
        A.deallocate[T](s.a, new_chunk, CHUNK_CAPACITY);
        ret R.err[R.Void, str](R.unwrap_err[usize, str](push_r));
    }
    ret R.ok_void[str]();
}

pub fun chunk_reserve[T](e: *ChunkEditor[T], additional: usize) R.Result[R.Void, str] {
    if (e == nil || e.store == nil) { ret R.err[R.Void, str]("editor is not live"); }
    val s: *StableChunks[T] = e.store;

    val needed: usize = s.len + additional;
    var capacity: usize = s.chunks.len * CHUNK_CAPACITY;
    var grown: usize = 0;

    for (capacity < needed) {
        val grow_r: R.Result[R.Void, str] = chunk_grow_one[T](s);
        if (R.is_err[R.Void, str](grow_r)) {
            var u: usize = 0;
            for (u < grown) {
                val pop_r: R.Result[*T, str] = vector.pop[*T](?s.chunks);
                if (R.is_ok[*T, str](pop_r)) {
                    A.deallocate[T](s.a, R.unwrap_ok[*T, str](pop_r), CHUNK_CAPACITY);
                }
                u = u + 1;
            }
            ret grow_r;
        }
        grown    = grown + 1;
        capacity = capacity + CHUNK_CAPACITY;
    }

    ret R.ok_void[str]();
}

pub fun chunk_push[T](e: *ChunkEditor[T], value: T) R.Result[*T, str] {
    if (e == nil || e.store == nil) { ret R.err[*T, str]("editor is not live"); }
    val s: *StableChunks[T] = e.store;
    val capacity: usize = s.chunks.len * CHUNK_CAPACITY;

    if (s.len == capacity) {
        val grow_r: R.Result[R.Void, str] = chunk_grow_one[T](s);
        if (R.is_err[R.Void, str](grow_r)) { ret R.err[*T, str](R.unwrap_err[R.Void, str](grow_r)); }
    }

    val chunk_idx: usize = s.len / CHUNK_CAPACITY;
    val offset:    usize = s.len % CHUNK_CAPACITY;
    val chunk: *T = s.chunks.data[chunk_idx];
    chunk[offset] = value;
    s.len = s.len + 1;
    ret R.ok[*T, str](?chunk[offset]);
}

pub rec HandleSlot[T] {
    value:      T;
    generation: u32;
}

pub rec HandleId[Domain] {
    index:        usize;
    generation:   u32;
    instance_tag: usize;
}

pub rec HandleTable[T, Domain] {
    a:           *A.Allocator;
    slots:       StableChunks[HandleSlot[T]];
    free_list:   Vector[usize];
    store_epoch: u64;
    identity:    *u8;
    editing:     bool;
}

pub rec HandleView[T, Domain] {
    table:        *HandleTable[T, Domain];
    epoch:        u64;
    instance_tag: usize;
}

pub rec HandleEditor[T, Domain] {
    table: *HandleTable[T, Domain];
}

pub fun table_init[T, Domain](a: *A.Allocator) R.Result[HandleTable[T, Domain], str] {
    val id_r: R.Result[*u8, str] = A.allocate[u8](a, 1);
    if (R.is_err[*u8, str](id_r)) {
        ret R.err[HandleTable[T, Domain], str](R.unwrap_err[*u8, str](id_r));
    }
    var t: HandleTable[T, Domain];
    t.a           = a;
    t.slots       = chunk_init[HandleSlot[T]](a);
    t.free_list   = vector.init[usize](a);
    t.store_epoch = 0;
    t.identity    = R.unwrap_ok[*u8, str](id_r);
    t.editing     = false;
    ret R.ok[HandleTable[T, Domain], str](t);
}

pub fun table_dnit[T, Domain](t: *HandleTable[T, Domain]) {
    if (t == nil) { ret; }
    chunk_dnit[HandleSlot[T]](?t.slots);
    vector.dnit[usize](?t.free_list);
    if (t.identity != nil) {
        A.deallocate[u8](t.a, t.identity, 1);
        t.identity = nil;
    }
    t.store_epoch = 0;
    t.editing     = false;
}

pub fun table_count[T, Domain](t: *HandleTable[T, Domain]) usize {
    if (t == nil) { ret 0; }
    ret chunk_count[HandleSlot[T]](?t.slots) - t.free_list.len;
}

fun resolve[T, Domain](t: *HandleTable[T, Domain], id: HandleId[Domain]) R.Result[*HandleSlot[T], str] {
    if (t == nil) { ret R.err[*HandleSlot[T], str]("store is nil"); }
    if (id.instance_tag != t.identity::usize) {
        ret R.err[*HandleSlot[T], str]("identifier belongs to a different store");
    }
    val slot_r: R.Result[*HandleSlot[T], str] = chunk_get[HandleSlot[T]](?t.slots, id.index);
    if (R.is_err[*HandleSlot[T], str](slot_r)) {
        ret R.err[*HandleSlot[T], str]("identifier index is out of range");
    }
    val slot: *HandleSlot[T] = R.unwrap_ok[*HandleSlot[T], str](slot_r);
    if (slot.generation != id.generation) {
        ret R.err[*HandleSlot[T], str]("identifier generation is stale");
    }
    ret R.ok[*HandleSlot[T], str](slot);
}

pub fun get[T, Domain](t: *HandleTable[T, Domain], id: HandleId[Domain]) R.Result[*T, str] {
    val slot_r: R.Result[*HandleSlot[T], str] = resolve[T, Domain](t, id);
    if (R.is_err[*HandleSlot[T], str](slot_r)) {
        ret R.err[*T, str](R.unwrap_err[*HandleSlot[T], str](slot_r));
    }
    ret R.ok[*T, str](?R.unwrap_ok[*HandleSlot[T], str](slot_r).value);
}

pub fun contains[T, Domain](t: *HandleTable[T, Domain], id: HandleId[Domain]) bool {
    ret R.is_ok[*T, str](get[T, Domain](t, id));
}

pub fun view[T, Domain](t: *HandleTable[T, Domain]) HandleView[T, Domain] {
    var v: HandleView[T, Domain];
    v.table = t;
    if (t == nil) {
        v.epoch        = 0;
        v.instance_tag = 0;
    } or {
        v.epoch        = t.store_epoch;
        v.instance_tag = t.identity::usize;
    }
    ret v;
}

pub fun view_valid[T, Domain](v: *HandleView[T, Domain]) bool {
    if (v.table == nil) { ret false; }
    ret v.epoch == v.table.store_epoch && v.instance_tag == v.table.identity::usize;
}

pub fun view_get[T, Domain](v: *HandleView[T, Domain], id: HandleId[Domain]) R.Result[*T, str] {
    if (!view_valid[T, Domain](v)) { ret R.err[*T, str]("view is invalidated by a store mutation"); }
    ret get[T, Domain](v.table, id);
}

pub fun edit[T, Domain](t: *HandleTable[T, Domain]) R.Result[HandleEditor[T, Domain], str] {
    if (t == nil)    { ret R.err[HandleEditor[T, Domain], str]("store is nil"); }
    if (t.editing)   { ret R.err[HandleEditor[T, Domain], str]("store already has an exclusive editor"); }
    t.editing     = true;
    t.store_epoch = t.store_epoch + 1;
    var e: HandleEditor[T, Domain];
    e.table = t;
    ret R.ok[HandleEditor[T, Domain], str](e);
}

pub fun editor_finish[T, Domain](e: *HandleEditor[T, Domain]) {
    if (e == nil || e.table == nil) { ret; }
    e.table.editing = false;
    e.table = nil;
}

pub fun editor_insert[T, Domain](e: *HandleEditor[T, Domain], value: T) R.Result[HandleId[Domain], str] {
    if (e == nil || e.table == nil) { ret R.err[HandleId[Domain], str]("editor is not live"); }
    val t: *HandleTable[T, Domain] = e.table;

    if (t.free_list.len > 0) {
        val pop_r: R.Result[usize, str] = vector.pop[usize](?t.free_list);
        if (R.is_err[usize, str](pop_r)) { ret R.err[HandleId[Domain], str](R.unwrap_err[usize, str](pop_r)); }
        val idx: usize = R.unwrap_ok[usize, str](pop_r);
        val slot_r: R.Result[*HandleSlot[T], str] = chunk_get[HandleSlot[T]](?t.slots, idx);
        if (R.is_err[*HandleSlot[T], str](slot_r)) {
            ret R.err[HandleId[Domain], str](R.unwrap_err[*HandleSlot[T], str](slot_r));
        }
        val slot: *HandleSlot[T] = R.unwrap_ok[*HandleSlot[T], str](slot_r);
        slot.value = value;

        var id: HandleId[Domain];
        id.index        = idx;
        id.generation   = slot.generation;
        id.instance_tag = t.identity::usize;
        ret R.ok[HandleId[Domain], str](id);
    }

    val idx: usize = chunk_count[HandleSlot[T]](?t.slots);

    val ce_r: R.Result[ChunkEditor[HandleSlot[T]], str] = chunk_edit[HandleSlot[T]](?t.slots);
    if (R.is_err[ChunkEditor[HandleSlot[T]], str](ce_r)) {
        ret R.err[HandleId[Domain], str](R.unwrap_err[ChunkEditor[HandleSlot[T]], str](ce_r));
    }
    var ce: ChunkEditor[HandleSlot[T]] = R.unwrap_ok[ChunkEditor[HandleSlot[T]], str](ce_r);

    var fresh: HandleSlot[T];
    fresh.value      = value;
    fresh.generation = 0;
    val push_r: R.Result[*HandleSlot[T], str] = chunk_push[HandleSlot[T]](?ce, fresh);
    chunk_editor_finish[HandleSlot[T]](?ce);
    if (R.is_err[*HandleSlot[T], str](push_r)) {
        ret R.err[HandleId[Domain], str](R.unwrap_err[*HandleSlot[T], str](push_r));
    }

    var id: HandleId[Domain];
    id.index        = idx;
    id.generation    = 0;
    id.instance_tag  = t.identity::usize;
    ret R.ok[HandleId[Domain], str](id);
}

pub fun editor_remove[T, Domain](e: *HandleEditor[T, Domain], id: HandleId[Domain]) R.Result[T, str] {
    if (e == nil || e.table == nil) { ret R.err[T, str]("editor is not live"); }
    val t: *HandleTable[T, Domain] = e.table;
    val slot_r: R.Result[*HandleSlot[T], str] = resolve[T, Domain](t, id);
    if (R.is_err[*HandleSlot[T], str](slot_r)) { ret R.err[T, str](R.unwrap_err[*HandleSlot[T], str](slot_r)); }
    val slot: *HandleSlot[T] = R.unwrap_ok[*HandleSlot[T], str](slot_r);

    val value: T = slot.value;
    slot.generation = slot.generation + 1;

    val push_r: R.Result[usize, str] = vector.push[usize](?t.free_list, id.index);
    if (R.is_err[usize, str](push_r)) {
        slot.generation = slot.generation - 1;
        ret R.err[T, str](R.unwrap_err[usize, str](push_r));
    }

    ret R.ok[T, str](value);
}

val PROBE_SLOTS: usize = 16;

rec AllocProbe {
    backing:  A.Allocator;
    calls:    u32;
    fail_at:  u32;
    live:     i64;
    ptrs:     [PROBE_SLOTS]ptr;
    sizes:    [PROBE_SLOTS]usize;
    mismatch: bool;
}

fun probe_note_alloc(p: *AllocProbe, item: ptr, size: usize) {
    var i: usize = 0;
    for (i < PROBE_SLOTS && p.ptrs[i] != nil) { i = i + 1; }
    if (i == PROBE_SLOTS) { p.mismatch = true; ret; }
    p.ptrs[i]  = item;
    p.sizes[i] = size;
    p.live     = p.live + size::i64;
}

fun probe_note_free(p: *AllocProbe, item: ptr, size: usize) {
    var i: usize = 0;
    for (i < PROBE_SLOTS && p.ptrs[i] != item) { i = i + 1; }
    if (i == PROBE_SLOTS) { p.mismatch = true; ret; }
    if (p.sizes[i] != size) { p.mismatch = true; }
    p.live     = p.live - p.sizes[i]::i64;
    p.ptrs[i]  = nil;
    p.sizes[i] = 0;
}

fun probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val p: *AllocProbe = ctx::*AllocProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls >= p.fail_at) { ret O.none[ptr](); }
    val r: O.Option[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (O.is_none[ptr](r)) { ret r; }
    probe_note_alloc(p, O.unwrap[ptr](r), size);
    ret r;
}

fun probe_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    val p: *AllocProbe = ctx::*AllocProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls >= p.fail_at) { ret O.none[ptr](); }
    val r: O.Option[ptr] = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (O.is_none[ptr](r)) { ret r; }
    if (item != nil) { probe_note_free(p, item, old_size); }
    probe_note_alloc(p, O.unwrap[ptr](r), new_size);
    ret r;
}

fun probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *AllocProbe = ctx::*AllocProbe;
    probe_note_free(p, item, size);
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun probe_make(p: *AllocProbe, alloc: *A.Allocator, fail_at: u32) bool {
    if (O.is_some[str](page.make(?p.backing))) { ret false; }
    p.calls    = 0;
    p.fail_at  = fail_at;
    p.live     = 0;
    p.mismatch = false;
    var i: usize = 0;
    for (i < PROBE_SLOTS) { p.ptrs[i] = nil; p.sizes[i] = 0; i = i + 1; }
    val self_ptr: *AllocProbe = p;
    alloc.ctx           = self_ptr::ptr;
    alloc.fn_allocate   = probe_allocate;
    alloc.fn_reallocate = probe_reallocate;
    alloc.fn_deallocate = probe_deallocate;
    ret true;
}

rec HDom {}

test "mach.lang.handle.chunk_push:borrow_survives_growth_and_writes_through" {
    var a: A.Allocator;
    page.make(?a);
    var s: StableChunks[u64] = chunk_init[u64](?a);

    val edit_r: R.Result[ChunkEditor[u64], str] = chunk_edit[u64](?s);
    if (R.is_err[ChunkEditor[u64], str](edit_r)) { chunk_dnit[u64](?s); ret 1; }
    var e: ChunkEditor[u64] = R.unwrap_ok[ChunkEditor[u64], str](edit_r);

    var borrow: *u64 = nil;
    var i: usize = 0;
    for (i < 600) {
        val push_r: R.Result[*u64, str] = chunk_push[u64](?e, i);
        if (R.is_err[*u64, str](push_r)) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }
        if (i == 3) { borrow = R.unwrap_ok[*u64, str](push_r); }
        i = i + 1;
    }
    chunk_editor_finish[u64](?e);

    if (borrow == nil || @borrow != 3)   { chunk_dnit[u64](?s); ret 1; }
    if (chunk_count[u64](?s) != 600)     { chunk_dnit[u64](?s); ret 1; }

    @borrow = 999999;
    val get_r: R.Result[*u64, str] = chunk_get[u64](?s, 3);
    if (R.is_err[*u64, str](get_r))            { chunk_dnit[u64](?s); ret 1; }
    if (@R.unwrap_ok[*u64, str](get_r) != 999999) { chunk_dnit[u64](?s); ret 1; }

    chunk_dnit[u64](?s);
    ret 0;
}

test "mach.lang.handle.chunk_edit:exclusive_access_is_enforced" {
    var a: A.Allocator;
    page.make(?a);
    var s: StableChunks[u64] = chunk_init[u64](?a);

    val e1_r: R.Result[ChunkEditor[u64], str] = chunk_edit[u64](?s);
    if (R.is_err[ChunkEditor[u64], str](e1_r)) { chunk_dnit[u64](?s); ret 1; }
    var e1: ChunkEditor[u64] = R.unwrap_ok[ChunkEditor[u64], str](e1_r);

    if (R.is_ok[ChunkEditor[u64], str](chunk_edit[u64](?s))) {
        chunk_editor_finish[u64](?e1); chunk_dnit[u64](?s); ret 1;
    }

    chunk_editor_finish[u64](?e1);

    val e2_r: R.Result[ChunkEditor[u64], str] = chunk_edit[u64](?s);
    if (R.is_err[ChunkEditor[u64], str](e2_r)) { chunk_dnit[u64](?s); ret 1; }
    var e2: ChunkEditor[u64] = R.unwrap_ok[ChunkEditor[u64], str](e2_r);
    chunk_editor_finish[u64](?e2);

    chunk_dnit[u64](?s);
    ret 0;
}

test "mach.lang.handle.chunk_push:allocation_failure_leaves_store_unchanged" {
    var fail_at: u32 = 1;
    for (fail_at <= 3) {
        var probe: AllocProbe; var pa: A.Allocator;
        if (!probe_make(?probe, ?pa, fail_at)) { ret 1; }
        var s: StableChunks[u64] = chunk_init[u64](?pa);

        val edit_r: R.Result[ChunkEditor[u64], str] = chunk_edit[u64](?s);
        if (R.is_err[ChunkEditor[u64], str](edit_r)) { chunk_dnit[u64](?s); ret 1; }
        var e: ChunkEditor[u64] = R.unwrap_ok[ChunkEditor[u64], str](edit_r);

        var failed: bool = false;
        var pushed: usize = 0;
        var i: usize = 0;
        for (i < CHUNK_CAPACITY + 1) {
            val push_r: R.Result[*u64, str] = chunk_push[u64](?e, i::u64 + 1);
            if (R.is_err[*u64, str](push_r)) { failed = true; brk; }
            pushed = pushed + 1;
            i = i + 1;
        }
        if (!failed) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }

        var expect: usize = 0;
        if (fail_at == 3) { expect = CHUNK_CAPACITY; }
        if (pushed != expect || s.len != expect) {
            chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1;
        }

        var bad: bool = false;
        var k: usize = 0;
        for (k < pushed) {
            val got: R.Result[*u64, str] = chunk_get[u64](?s, k);
            if (R.is_err[*u64, str](got) || @R.unwrap_ok[*u64, str](got) != k::u64 + 1) { bad = true; }
            k = k + 1;
        }
        if (bad) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }

        chunk_editor_finish[u64](?e);
        chunk_dnit[u64](?s);
        if (probe.live != 0 || probe.mismatch) { ret 1; }

        fail_at = fail_at + 1;
    }
    ret 0;
}

test "mach.lang.handle.chunk_reserve:allocation_failure_leaves_store_unchanged" {
    var fail_at: u32 = 3;
    for (fail_at <= 5) {
        var probe: AllocProbe; var pa: A.Allocator;
        if (!probe_make(?probe, ?pa, fail_at)) { ret 1; }
        var s: StableChunks[u64] = chunk_init[u64](?pa);

        val edit_r: R.Result[ChunkEditor[u64], str] = chunk_edit[u64](?s);
        if (R.is_err[ChunkEditor[u64], str](edit_r)) { chunk_dnit[u64](?s); ret 1; }
        var e: ChunkEditor[u64] = R.unwrap_ok[ChunkEditor[u64], str](edit_r);

        var i: usize = 0;
        for (i < CHUNK_CAPACITY) {
            val push_r: R.Result[*u64, str] = chunk_push[u64](?e, i::u64 + 1);
            if (R.is_err[*u64, str](push_r)) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }
            i = i + 1;
        }

        val len_before:    usize = s.len;
        val chunks_before: usize = s.chunks.len;

        val reserve_r: R.Result[R.Void, str] = chunk_reserve[u64](?e, CHUNK_CAPACITY * 3);
        if (R.is_ok[R.Void, str](reserve_r)) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }

        if (s.len != len_before || s.chunks.len != chunks_before) {
            chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1;
        }

        var bad: bool = false;
        var k: usize = 0;
        for (k < CHUNK_CAPACITY) {
            val got: R.Result[*u64, str] = chunk_get[u64](?s, k);
            if (R.is_err[*u64, str](got) || @R.unwrap_ok[*u64, str](got) != k::u64 + 1) { bad = true; }
            k = k + 1;
        }
        if (bad) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }

        chunk_editor_finish[u64](?e);
        chunk_dnit[u64](?s);
        if (probe.live != 0 || probe.mismatch) { ret 1; }

        fail_at = fail_at + 1;
    }
    ret 0;
}

test "mach.lang.handle.chunk_reserve:secures_capacity_for_a_batch_that_survives_exhaustion" {
    var probe: AllocProbe; var pa: A.Allocator;
    if (!probe_make(?probe, ?pa, 0)) { ret 1; }
    var s: StableChunks[u64] = chunk_init[u64](?pa);

    val edit_r: R.Result[ChunkEditor[u64], str] = chunk_edit[u64](?s);
    if (R.is_err[ChunkEditor[u64], str](edit_r)) { chunk_dnit[u64](?s); ret 1; }
    var e: ChunkEditor[u64] = R.unwrap_ok[ChunkEditor[u64], str](edit_r);

    val batch: usize = CHUNK_CAPACITY * 3;
    val reserve_r: R.Result[R.Void, str] = chunk_reserve[u64](?e, batch);
    if (R.is_err[R.Void, str](reserve_r)) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }

    probe.fail_at = probe.calls + 1;

    var ok_count: usize = 0;
    var i: usize = 0;
    for (i < batch) {
        val push_r: R.Result[*u64, str] = chunk_push[u64](?e, i::u64);
        if (R.is_err[*u64, str](push_r)) { brk; }
        ok_count = ok_count + 1;
        i = i + 1;
    }
    if (ok_count != batch) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }

    var bad: bool = false;
    var k: usize = 0;
    for (k < batch) {
        val got: R.Result[*u64, str] = chunk_get[u64](?s, k);
        if (R.is_err[*u64, str](got) || @R.unwrap_ok[*u64, str](got) != k::u64) { bad = true; }
        k = k + 1;
    }
    if (bad) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }

    var b: usize = 0;
    for (b < 3) {
        val beyond_r: R.Result[*u64, str] = chunk_push[u64](?e, 999999);
        if (R.is_ok[*u64, str](beyond_r)) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }
        b = b + 1;
    }

    chunk_editor_finish[u64](?e);
    chunk_dnit[u64](?s);
    if (probe.live != 0 || probe.mismatch) { ret 1; }
    ret 0;
}

test "mach.lang.handle.editor_remove:stale_identifier_rejected_after_reuse" {
    var a: A.Allocator;
    page.make(?a);
    val table_r: R.Result[HandleTable[u64, HDom], str] = table_init[u64, HDom](?a);
    if (R.is_err[HandleTable[u64, HDom], str](table_r)) { ret 1; }
    var t: HandleTable[u64, HDom] = R.unwrap_ok[HandleTable[u64, HDom], str](table_r);

    val edit_r: R.Result[HandleEditor[u64, HDom], str] = edit[u64, HDom](?t);
    if (R.is_err[HandleEditor[u64, HDom], str](edit_r)) { table_dnit[u64, HDom](?t); ret 1; }
    var e: HandleEditor[u64, HDom] = R.unwrap_ok[HandleEditor[u64, HDom], str](edit_r);

    var ids: [5]HandleId[HDom];
    var i: usize = 0;
    for (i < 5) {
        val ins_r: R.Result[HandleId[HDom], str] = editor_insert[u64, HDom](?e, i::u64 * 10);
        if (R.is_err[HandleId[HDom], str](ins_r)) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
        ids[i] = R.unwrap_ok[HandleId[HDom], str](ins_r);
        i = i + 1;
    }

    val stale: HandleId[HDom] = ids[2];
    val rm_r: R.Result[u64, str] = editor_remove[u64, HDom](?e, stale);
    if (R.is_err[u64, str](rm_r)) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }

    val reins_r: R.Result[HandleId[HDom], str] = editor_insert[u64, HDom](?e, 999);
    if (R.is_err[HandleId[HDom], str](reins_r)) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
    val fresh: HandleId[HDom] = R.unwrap_ok[HandleId[HDom], str](reins_r);

    editor_finish[u64, HDom](?e);

    if (fresh.index != stale.index)           { table_dnit[u64, HDom](?t); ret 1; }
    if (fresh.generation == stale.generation) { table_dnit[u64, HDom](?t); ret 1; }
    if (R.is_ok[*u64, str](get[u64, HDom](?t, stale))) { table_dnit[u64, HDom](?t); ret 1; }

    val fresh_r: R.Result[*u64, str] = get[u64, HDom](?t, fresh);
    if (R.is_err[*u64, str](fresh_r) || @R.unwrap_ok[*u64, str](fresh_r) != 999) { table_dnit[u64, HDom](?t); ret 1; }

    table_dnit[u64, HDom](?t);
    ret 0;
}

test "mach.lang.handle.get:borrow_survives_further_inserts_and_writes_through" {
    var a: A.Allocator;
    page.make(?a);
    val table_r: R.Result[HandleTable[u64, HDom], str] = table_init[u64, HDom](?a);
    if (R.is_err[HandleTable[u64, HDom], str](table_r)) { ret 1; }
    var t: HandleTable[u64, HDom] = R.unwrap_ok[HandleTable[u64, HDom], str](table_r);

    val edit_r: R.Result[HandleEditor[u64, HDom], str] = edit[u64, HDom](?t);
    if (R.is_err[HandleEditor[u64, HDom], str](edit_r)) { table_dnit[u64, HDom](?t); ret 1; }
    var e: HandleEditor[u64, HDom] = R.unwrap_ok[HandleEditor[u64, HDom], str](edit_r);

    val first_r: R.Result[HandleId[HDom], str] = editor_insert[u64, HDom](?e, 7);
    if (R.is_err[HandleId[HDom], str](first_r)) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
    val first: HandleId[HDom] = R.unwrap_ok[HandleId[HDom], str](first_r);

    val borrow_r: R.Result[*u64, str] = get[u64, HDom](?t, first);
    if (R.is_err[*u64, str](borrow_r)) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
    val borrow: *u64 = R.unwrap_ok[*u64, str](borrow_r);

    var i: usize = 0;
    for (i < 600) {
        val ins_r: R.Result[HandleId[HDom], str] = editor_insert[u64, HDom](?e, i::u64);
        if (R.is_err[HandleId[HDom], str](ins_r)) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
        i = i + 1;
    }
    editor_finish[u64, HDom](?e);

    if (@borrow != 7) { table_dnit[u64, HDom](?t); ret 1; }
    @borrow = 999999;
    val reget_r: R.Result[*u64, str] = get[u64, HDom](?t, first);
    if (R.is_err[*u64, str](reget_r) || @R.unwrap_ok[*u64, str](reget_r) != 999999) {
        table_dnit[u64, HDom](?t); ret 1;
    }

    table_dnit[u64, HDom](?t);
    ret 0;
}

test "mach.lang.handle.get:freed_slot_rejected_before_reuse" {
    var a: A.Allocator;
    page.make(?a);
    val table_r: R.Result[HandleTable[u64, HDom], str] = table_init[u64, HDom](?a);
    if (R.is_err[HandleTable[u64, HDom], str](table_r)) { ret 1; }
    var t: HandleTable[u64, HDom] = R.unwrap_ok[HandleTable[u64, HDom], str](table_r);

    val edit_r: R.Result[HandleEditor[u64, HDom], str] = edit[u64, HDom](?t);
    if (R.is_err[HandleEditor[u64, HDom], str](edit_r)) { table_dnit[u64, HDom](?t); ret 1; }
    var e: HandleEditor[u64, HDom] = R.unwrap_ok[HandleEditor[u64, HDom], str](edit_r);

    var ids: [3]HandleId[HDom];
    var i: usize = 0;
    for (i < 3) {
        val ins_r: R.Result[HandleId[HDom], str] = editor_insert[u64, HDom](?e, i::u64);
        if (R.is_err[HandleId[HDom], str](ins_r)) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
        ids[i] = R.unwrap_ok[HandleId[HDom], str](ins_r);
        i = i + 1;
    }

    val target: HandleId[HDom] = ids[1];
    if (!contains[u64, HDom](?t, target)) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }

    val rm_r: R.Result[u64, str] = editor_remove[u64, HDom](?e, target);
    if (R.is_err[u64, str](rm_r) || R.unwrap_ok[u64, str](rm_r) != 1) {
        editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1;
    }

    if (contains[u64, HDom](?t, target)) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
    if (R.is_ok[*u64, str](get[u64, HDom](?t, target))) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
    if (R.is_ok[u64, str](editor_remove[u64, HDom](?e, target))) {
        editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1;
    }

    editor_finish[u64, HDom](?e);
    table_dnit[u64, HDom](?t);
    ret 0;
}

test "mach.lang.handle.get:index_out_of_range_rejected" {
    var a: A.Allocator;
    page.make(?a);
    val table_r: R.Result[HandleTable[u64, HDom], str] = table_init[u64, HDom](?a);
    if (R.is_err[HandleTable[u64, HDom], str](table_r)) { ret 1; }
    var t: HandleTable[u64, HDom] = R.unwrap_ok[HandleTable[u64, HDom], str](table_r);

    val edit_r: R.Result[HandleEditor[u64, HDom], str] = edit[u64, HDom](?t);
    if (R.is_err[HandleEditor[u64, HDom], str](edit_r)) { table_dnit[u64, HDom](?t); ret 1; }
    var e: HandleEditor[u64, HDom] = R.unwrap_ok[HandleEditor[u64, HDom], str](edit_r);
    val ins_r: R.Result[HandleId[HDom], str] = editor_insert[u64, HDom](?e, 42);
    if (R.is_err[HandleId[HDom], str](ins_r)) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
    val real: HandleId[HDom] = R.unwrap_ok[HandleId[HDom], str](ins_r);
    editor_finish[u64, HDom](?e);

    var bogus: HandleId[HDom] = real;
    bogus.index = real.index + 1000;

    if (R.is_ok[*u64, str](get[u64, HDom](?t, bogus))) { table_dnit[u64, HDom](?t); ret 1; }
    val real_r: R.Result[*u64, str] = get[u64, HDom](?t, real);
    if (R.is_err[*u64, str](real_r) || @R.unwrap_ok[*u64, str](real_r) != 42) { table_dnit[u64, HDom](?t); ret 1; }

    table_dnit[u64, HDom](?t);
    ret 0;
}

test "mach.lang.handle.edit:exclusive_access_is_enforced" {
    var a: A.Allocator;
    page.make(?a);
    val table_r: R.Result[HandleTable[u64, HDom], str] = table_init[u64, HDom](?a);
    if (R.is_err[HandleTable[u64, HDom], str](table_r)) { ret 1; }
    var t: HandleTable[u64, HDom] = R.unwrap_ok[HandleTable[u64, HDom], str](table_r);

    val e1_r: R.Result[HandleEditor[u64, HDom], str] = edit[u64, HDom](?t);
    if (R.is_err[HandleEditor[u64, HDom], str](e1_r)) { table_dnit[u64, HDom](?t); ret 1; }
    var e1: HandleEditor[u64, HDom] = R.unwrap_ok[HandleEditor[u64, HDom], str](e1_r);

    if (R.is_ok[HandleEditor[u64, HDom], str](edit[u64, HDom](?t))) {
        editor_finish[u64, HDom](?e1); table_dnit[u64, HDom](?t); ret 1;
    }

    editor_finish[u64, HDom](?e1);

    val e2_r: R.Result[HandleEditor[u64, HDom], str] = edit[u64, HDom](?t);
    if (R.is_err[HandleEditor[u64, HDom], str](e2_r)) { table_dnit[u64, HDom](?t); ret 1; }
    var e2: HandleEditor[u64, HDom] = R.unwrap_ok[HandleEditor[u64, HDom], str](e2_r);
    editor_finish[u64, HDom](?e2);

    table_dnit[u64, HDom](?t);
    ret 0;
}

test "mach.lang.handle.view:invalidated_by_edit" {
    var a: A.Allocator;
    page.make(?a);
    val table_r: R.Result[HandleTable[u64, HDom], str] = table_init[u64, HDom](?a);
    if (R.is_err[HandleTable[u64, HDom], str](table_r)) { ret 1; }
    var t: HandleTable[u64, HDom] = R.unwrap_ok[HandleTable[u64, HDom], str](table_r);

    val edit1_r: R.Result[HandleEditor[u64, HDom], str] = edit[u64, HDom](?t);
    if (R.is_err[HandleEditor[u64, HDom], str](edit1_r)) { table_dnit[u64, HDom](?t); ret 1; }
    var e1: HandleEditor[u64, HDom] = R.unwrap_ok[HandleEditor[u64, HDom], str](edit1_r);
    val ins_r: R.Result[HandleId[HDom], str] = editor_insert[u64, HDom](?e1, 42);
    if (R.is_err[HandleId[HDom], str](ins_r)) { editor_finish[u64, HDom](?e1); table_dnit[u64, HDom](?t); ret 1; }
    val id: HandleId[HDom] = R.unwrap_ok[HandleId[HDom], str](ins_r);
    editor_finish[u64, HDom](?e1);

    var v: HandleView[u64, HDom] = view[u64, HDom](?t);
    if (!view_valid[u64, HDom](?v)) { table_dnit[u64, HDom](?t); ret 1; }
    val before_r: R.Result[*u64, str] = view_get[u64, HDom](?v, id);
    if (R.is_err[*u64, str](before_r) || @R.unwrap_ok[*u64, str](before_r) != 42) { table_dnit[u64, HDom](?t); ret 1; }

    val edit2_r: R.Result[HandleEditor[u64, HDom], str] = edit[u64, HDom](?t);
    if (R.is_err[HandleEditor[u64, HDom], str](edit2_r)) { table_dnit[u64, HDom](?t); ret 1; }
    var e2: HandleEditor[u64, HDom] = R.unwrap_ok[HandleEditor[u64, HDom], str](edit2_r);
    editor_insert[u64, HDom](?e2, 7);
    editor_finish[u64, HDom](?e2);

    if (view_valid[u64, HDom](?v)) { table_dnit[u64, HDom](?t); ret 1; }
    if (R.is_ok[*u64, str](view_get[u64, HDom](?v, id))) { table_dnit[u64, HDom](?t); ret 1; }

    var v2: HandleView[u64, HDom] = view[u64, HDom](?t);
    val after_r: R.Result[*u64, str] = view_get[u64, HDom](?v2, id);
    if (R.is_err[*u64, str](after_r) || @R.unwrap_ok[*u64, str](after_r) != 42) { table_dnit[u64, HDom](?t); ret 1; }

    table_dnit[u64, HDom](?t);
    ret 0;
}

test "mach.lang.handle.get:cross_store_identifier_confusion_rejected" {
    var a: A.Allocator;
    page.make(?a);

    val ta_r: R.Result[HandleTable[u64, HDom], str] = table_init[u64, HDom](?a);
    if (R.is_err[HandleTable[u64, HDom], str](ta_r)) { ret 1; }
    var ta: HandleTable[u64, HDom] = R.unwrap_ok[HandleTable[u64, HDom], str](ta_r);

    val tb_r: R.Result[HandleTable[u64, HDom], str] = table_init[u64, HDom](?a);
    if (R.is_err[HandleTable[u64, HDom], str](tb_r)) { table_dnit[u64, HDom](?ta); ret 1; }
    var tb: HandleTable[u64, HDom] = R.unwrap_ok[HandleTable[u64, HDom], str](tb_r);

    val ea_r: R.Result[HandleEditor[u64, HDom], str] = edit[u64, HDom](?ta);
    if (R.is_err[HandleEditor[u64, HDom], str](ea_r)) { table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1; }
    var ea: HandleEditor[u64, HDom] = R.unwrap_ok[HandleEditor[u64, HDom], str](ea_r);
    val ida_r: R.Result[HandleId[HDom], str] = editor_insert[u64, HDom](?ea, 111);
    if (R.is_err[HandleId[HDom], str](ida_r)) {
        editor_finish[u64, HDom](?ea); table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1;
    }
    val ida: HandleId[HDom] = R.unwrap_ok[HandleId[HDom], str](ida_r);
    editor_finish[u64, HDom](?ea);

    val eb_r: R.Result[HandleEditor[u64, HDom], str] = edit[u64, HDom](?tb);
    if (R.is_err[HandleEditor[u64, HDom], str](eb_r)) { table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1; }
    var eb: HandleEditor[u64, HDom] = R.unwrap_ok[HandleEditor[u64, HDom], str](eb_r);
    val idb_r: R.Result[HandleId[HDom], str] = editor_insert[u64, HDom](?eb, 222);
    if (R.is_err[HandleId[HDom], str](idb_r)) {
        editor_finish[u64, HDom](?eb); table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1;
    }
    val idb: HandleId[HDom] = R.unwrap_ok[HandleId[HDom], str](idb_r);
    editor_finish[u64, HDom](?eb);

    if (ida.index != idb.index || ida.generation != idb.generation) {
        table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1;
    }
    if (ida.instance_tag == idb.instance_tag) {
        table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1;
    }

    val own_a: R.Result[*u64, str] = get[u64, HDom](?ta, ida);
    if (R.is_err[*u64, str](own_a) || @R.unwrap_ok[*u64, str](own_a) != 111) {
        table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1;
    }

    if (R.is_ok[*u64, str](get[u64, HDom](?ta, idb))) { table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1; }
    if (R.is_ok[*u64, str](get[u64, HDom](?tb, ida))) { table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1; }

    table_dnit[u64, HDom](?ta);
    table_dnit[u64, HDom](?tb);
    ret 0;
}

test "mach.lang.handle.table:allocation_failure_at_each_fallible_step_leaves_store_unchanged" {
    var fail_at: u32 = 1;
    for (fail_at <= 5) {
        var probe: AllocProbe; var pa: A.Allocator;
        if (!probe_make(?probe, ?pa, fail_at)) { ret 1; }

        val table_r: R.Result[HandleTable[u64, HDom], str] = table_init[u64, HDom](?pa);
        if (fail_at == 1) {
            if (R.is_ok[HandleTable[u64, HDom], str](table_r)) { ret 1; }
            if (probe.live != 0 || probe.mismatch) { ret 1; }
            fail_at = fail_at + 1;
            cnt;
        }
        if (R.is_err[HandleTable[u64, HDom], str](table_r)) { ret 1; }
        var t: HandleTable[u64, HDom] = R.unwrap_ok[HandleTable[u64, HDom], str](table_r);

        val edit_r: R.Result[HandleEditor[u64, HDom], str] = edit[u64, HDom](?t);
        if (R.is_err[HandleEditor[u64, HDom], str](edit_r)) { table_dnit[u64, HDom](?t); ret 1; }
        var e: HandleEditor[u64, HDom] = R.unwrap_ok[HandleEditor[u64, HDom], str](edit_r);

        var ids: [70]HandleId[HDom];
        var inserted: usize = 0;
        var insert_failed: bool = false;
        var i: usize = 0;
        for (i < 70) {
            val ins_r: R.Result[HandleId[HDom], str] = editor_insert[u64, HDom](?e, (i::u64 + 1) * 100);
            if (R.is_err[HandleId[HDom], str](ins_r)) { insert_failed = true; brk; }
            ids[i]   = R.unwrap_ok[HandleId[HDom], str](ins_r);
            inserted = inserted + 1;
            i = i + 1;
        }

        var expect: usize = 70;
        if (fail_at == 2 || fail_at == 3) { expect = 0; }
        if (fail_at == 4) { expect = CHUNK_CAPACITY; }
        val expect_insert_failed: bool = fail_at == 2 || fail_at == 3 || fail_at == 4;
        if (insert_failed != expect_insert_failed || inserted != expect) {
            editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1;
        }

        var bad: bool = false;
        var k: usize = 0;
        for (k < inserted) {
            val got: R.Result[*u64, str] = get[u64, HDom](?t, ids[k]);
            if (R.is_err[*u64, str](got) || @R.unwrap_ok[*u64, str](got) != (k::u64 + 1) * 100) { bad = true; }
            k = k + 1;
        }
        if (bad) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }

        if (fail_at == 5) {
            val rm_r: R.Result[u64, str] = editor_remove[u64, HDom](?e, ids[0]);
            if (R.is_ok[u64, str](rm_r)) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
            val still: R.Result[*u64, str] = get[u64, HDom](?t, ids[0]);
            if (R.is_err[*u64, str](still) || @R.unwrap_ok[*u64, str](still) != 100) {
                editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1;
            }
        }

        editor_finish[u64, HDom](?e);
        table_dnit[u64, HDom](?t);
        if (probe.live != 0 || probe.mismatch) { ret 1; }

        fail_at = fail_at + 1;
    }
    ret 0;
}
