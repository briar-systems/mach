use std.types.canonical.opt;
use std.types.canonical.res;
use std.types.canonical.err;
use page: std.allocator.page;
use vector: std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.alloc;

val CHUNK_CAPACITY: usize = 64;

# a store's refusal: the allocator's, a store or editor that is not live, an
# identifier that belongs to another store, one whose slot was reused since
# it was issued, a view outdated by a mutation, or a second exclusive editor
pub tag Error: u8 {
    alloc:   A.Error;
    absent;
    foreign;
    stale;
    outdated;
    busy;
}

pub fun text(e: Error) str {
    if (sel e.alloc)    { ret alloc.text(e.alloc); }
    or (sel e.absent)   { ret "store is not live"; }
    or (sel e.foreign)  { ret "identifier belongs to a different store"; }
    or (sel e.stale)    { ret "identifier is stale"; }
    or (sel e.outdated) { ret "view is invalidated by a store mutation"; }
    ret "store already has an exclusive editor";
}

pub rec StableChunks[T] {
    a:       *A.Allocator;
    chunks:  Vector[*T];
    len:     usize;
    editing: bool;
}

pub rec ChunkEditor[T] {
    store: *StableChunks[T];
}

pub fun chunk_init[T](a: *A.Allocator) StableChunks[T] {
    var s: StableChunks[T];
    s.a       = a;
    s.chunks  = vector.init[*T](a);
    s.len     = 0;
    s.editing = false;
    ret s;
}

pub fun chunk_dnit[T](s: *StableChunks[T]) {
    if (s == nil) { ret; }
    var i: usize = 0;
    for (i < s.chunks.len) {
        A.deallocate[T](s.a, s.chunks.data[i], CHUNK_CAPACITY);
        i = i + 1;
    }
    vector.dnit[*T](?s.chunks);
    s.len     = 0;
    s.editing = false;
}

pub fun chunk_count[T](s: *StableChunks[T]) usize {
    if (s == nil) { ret 0; }
    ret s.len;
}

# the element at `index`, absent past the end or on a nil store
pub fun chunk_at[T](s: *StableChunks[T], index: usize) opt[*T] {
    if (s == nil)       { ret opt[*T].none{}; }
    if (index >= s.len) { ret opt[*T].none{}; }
    val chunk_idx: usize = index / CHUNK_CAPACITY;
    val offset:    usize = index % CHUNK_CAPACITY;
    val chunk: *T = s.chunks.data[chunk_idx];
    ret opt[*T].some{?chunk[offset]};
}

pub fun chunk_editor[T](s: *StableChunks[T]) res[ChunkEditor[T], Error] {
    if (s == nil)  { ret res[ChunkEditor[T], Error].err{Error.absent{}}; }
    if (s.editing) { ret res[ChunkEditor[T], Error].err{Error.busy{}}; }
    s.editing = true;
    var e: ChunkEditor[T];
    e.store = s;
    ret res[ChunkEditor[T], Error].ok{e};
}

pub fun chunk_editor_finish[T](e: *ChunkEditor[T]) {
    if (e == nil || e.store == nil) { ret; }
    e.store.editing = false;
    e.store = nil;
}

fun chunk_grow_one[T](s: *StableChunks[T]) err[Error] {
    val alloc_r: res[*T, A.Error] = A.zallocate[T](s.a, CHUNK_CAPACITY);
    if (sel alloc_r.err) { ret err[Error].err{Error.alloc{alloc_r.err}}; }
    val new_chunk: *T = alloc_r.ok;

    val push_r: res[usize, A.Error] = vector.push[*T](?s.chunks, new_chunk);
    if (sel push_r.err) {
        A.deallocate[T](s.a, new_chunk, CHUNK_CAPACITY);
        ret err[Error].err{Error.alloc{push_r.err}};
    }
    ret err[Error].ok{};
}

pub fun chunk_grow[T](e: *ChunkEditor[T], additional: usize) err[Error] {
    if (e == nil || e.store == nil) { ret err[Error].err{Error.absent{}}; }
    val s: *StableChunks[T] = e.store;

    val needed: usize = s.len + additional;
    var capacity: usize = s.chunks.len * CHUNK_CAPACITY;
    var grown: usize = 0;

    for (capacity < needed) {
        val grow_r: err[Error] = chunk_grow_one[T](s);
        if (sel grow_r.err) {
            var u: usize = 0;
            for (u < grown) {
                val popped: opt[*T] = vector.pop[*T](?s.chunks);
                if (sel popped.some) {
                    A.deallocate[T](s.a, popped.some, CHUNK_CAPACITY);
                }
                u = u + 1;
            }
            ret grow_r;
        }
        grown    = grown + 1;
        capacity = capacity + CHUNK_CAPACITY;
    }

    ret err[Error].ok{};
}

pub fun chunk_append[T](e: *ChunkEditor[T], value: T) res[*T, Error] {
    if (e == nil || e.store == nil) { ret res[*T, Error].err{Error.absent{}}; }
    val s: *StableChunks[T] = e.store;
    val capacity: usize = s.chunks.len * CHUNK_CAPACITY;

    if (s.len == capacity) {
        val grow_r: err[Error] = chunk_grow_one[T](s);
        if (sel grow_r.err) { ret res[*T, Error].err{grow_r.err}; }
    }

    val chunk_idx: usize = s.len / CHUNK_CAPACITY;
    val offset:    usize = s.len % CHUNK_CAPACITY;
    val chunk: *T = s.chunks.data[chunk_idx];
    chunk[offset] = value;
    s.len = s.len + 1;
    ret res[*T, Error].ok{?chunk[offset]};
}

# translation shims (#3226): the chunk store in its legacy carriers for the
# type table, which reads them until its own lane lands; removed with it
pub fun chunk_get[T](s: *StableChunks[T], index: usize) R.Result[*T, str] {
    if (s == nil) { ret R.err[*T, str]("store is nil"); }
    val at: opt[*T] = chunk_at[T](s, index);
    if (sel at.some) { ret R.ok[*T, str](at.some); }
    ret R.err[*T, str]("index out of bounds");
}

pub fun chunk_edit[T](s: *StableChunks[T]) R.Result[ChunkEditor[T], str] {
    val r: res[ChunkEditor[T], Error] = chunk_editor[T](s);
    if (sel r.err) { ret R.err[ChunkEditor[T], str](text(r.err)); }
    ret R.ok[ChunkEditor[T], str](r.ok);
}

pub fun chunk_reserve[T](e: *ChunkEditor[T], additional: usize) R.Result[R.Void, str] {
    val r: err[Error] = chunk_grow[T](e, additional);
    if (sel r.err) { ret R.err[R.Void, str](text(r.err)); }
    ret R.ok_void[str]();
}

pub fun chunk_push[T](e: *ChunkEditor[T], value: T) R.Result[*T, str] {
    val r: res[*T, Error] = chunk_append[T](e, value);
    if (sel r.err) { ret R.err[*T, str](text(r.err)); }
    ret R.ok[*T, str](r.ok);
}

pub rec HandleSlot[T] {
    value:      T;
    generation: u32;
}

pub rec HandleId[Domain] {
    index:        usize;
    generation:   u32;
    instance_tag: usize;
}

pub rec HandleTable[T, Domain] {
    a:           *A.Allocator;
    slots:       StableChunks[HandleSlot[T]];
    free_list:   Vector[usize];
    store_epoch: u64;
    identity:    *u8;
    editing:     bool;
}

pub rec HandleView[T, Domain] {
    table:        *HandleTable[T, Domain];
    epoch:        u64;
    instance_tag: usize;
}

pub rec HandleEditor[T, Domain] {
    table: *HandleTable[T, Domain];
}

pub fun table_init[T, Domain](a: *A.Allocator) res[HandleTable[T, Domain], Error] {
    val id_r: res[*u8, A.Error] = A.allocate[u8](a, 1);
    if (sel id_r.err) { ret res[HandleTable[T, Domain], Error].err{Error.alloc{id_r.err}}; }
    var t: HandleTable[T, Domain];
    t.a           = a;
    t.slots       = chunk_init[HandleSlot[T]](a);
    t.free_list   = vector.init[usize](a);
    t.store_epoch = 0;
    t.identity    = id_r.ok;
    t.editing     = false;
    ret res[HandleTable[T, Domain], Error].ok{t};
}

pub fun table_dnit[T, Domain](t: *HandleTable[T, Domain]) {
    if (t == nil) { ret; }
    chunk_dnit[HandleSlot[T]](?t.slots);
    vector.dnit[usize](?t.free_list);
    if (t.identity != nil) {
        A.deallocate[u8](t.a, t.identity, 1);
        t.identity = nil;
    }
    t.store_epoch = 0;
    t.editing     = false;
}

pub fun table_count[T, Domain](t: *HandleTable[T, Domain]) usize {
    if (t == nil) { ret 0; }
    ret chunk_count[HandleSlot[T]](?t.slots) - t.free_list.len;
}

fun resolve[T, Domain](t: *HandleTable[T, Domain], id: HandleId[Domain]) res[*HandleSlot[T], Error] {
    if (t == nil) { ret res[*HandleSlot[T], Error].err{Error.absent{}}; }
    if (id.instance_tag != t.identity::usize) {
        ret res[*HandleSlot[T], Error].err{Error.foreign{}};
    }
    val slot_r: opt[*HandleSlot[T]] = chunk_at[HandleSlot[T]](?t.slots, id.index);
    if (sel slot_r.none) { ret res[*HandleSlot[T], Error].err{Error.stale{}}; }
    val slot: *HandleSlot[T] = slot_r.some;
    if (slot.generation != id.generation) {
        ret res[*HandleSlot[T], Error].err{Error.stale{}};
    }
    ret res[*HandleSlot[T], Error].ok{slot};
}

pub fun get[T, Domain](t: *HandleTable[T, Domain], id: HandleId[Domain]) res[*T, Error] {
    val slot_r: res[*HandleSlot[T], Error] = resolve[T, Domain](t, id);
    if (sel slot_r.err) { ret res[*T, Error].err{slot_r.err}; }
    ret res[*T, Error].ok{?slot_r.ok.value};
}

pub fun contains[T, Domain](t: *HandleTable[T, Domain], id: HandleId[Domain]) bool {
    val got: res[*T, Error] = get[T, Domain](t, id);
    ret sel got.ok;
}

pub fun view[T, Domain](t: *HandleTable[T, Domain]) HandleView[T, Domain] {
    var v: HandleView[T, Domain];
    v.table = t;
    if (t == nil) {
        v.epoch        = 0;
        v.instance_tag = 0;
    } or {
        v.epoch        = t.store_epoch;
        v.instance_tag = t.identity::usize;
    }
    ret v;
}

pub fun view_valid[T, Domain](v: *HandleView[T, Domain]) bool {
    if (v.table == nil) { ret false; }
    ret v.epoch == v.table.store_epoch && v.instance_tag == v.table.identity::usize;
}

pub fun view_get[T, Domain](v: *HandleView[T, Domain], id: HandleId[Domain]) res[*T, Error] {
    if (!view_valid[T, Domain](v)) { ret res[*T, Error].err{Error.outdated{}}; }
    ret get[T, Domain](v.table, id);
}

pub fun edit[T, Domain](t: *HandleTable[T, Domain]) res[HandleEditor[T, Domain], Error] {
    if (t == nil)    { ret res[HandleEditor[T, Domain], Error].err{Error.absent{}}; }
    if (t.editing)   { ret res[HandleEditor[T, Domain], Error].err{Error.busy{}}; }
    t.editing     = true;
    t.store_epoch = t.store_epoch + 1;
    var e: HandleEditor[T, Domain];
    e.table = t;
    ret res[HandleEditor[T, Domain], Error].ok{e};
}

pub fun editor_finish[T, Domain](e: *HandleEditor[T, Domain]) {
    if (e == nil || e.table == nil) { ret; }
    e.table.editing = false;
    e.table = nil;
}

pub fun editor_insert[T, Domain](e: *HandleEditor[T, Domain], value: T) res[HandleId[Domain], Error] {
    if (e == nil || e.table == nil) { ret res[HandleId[Domain], Error].err{Error.absent{}}; }
    val t: *HandleTable[T, Domain] = e.table;

    if (t.free_list.len > 0) {
        val popped: opt[usize] = vector.pop[usize](?t.free_list);
        if (sel popped.none) { ret res[HandleId[Domain], Error].err{Error.absent{}}; }
        val idx: usize = popped.some;
        val slot_r: opt[*HandleSlot[T]] = chunk_at[HandleSlot[T]](?t.slots, idx);
        if (sel slot_r.none) { ret res[HandleId[Domain], Error].err{Error.stale{}}; }
        val slot: *HandleSlot[T] = slot_r.some;
        slot.value = value;

        var id: HandleId[Domain];
        id.index        = idx;
        id.generation   = slot.generation;
        id.instance_tag = t.identity::usize;
        ret res[HandleId[Domain], Error].ok{id};
    }

    val idx: usize = chunk_count[HandleSlot[T]](?t.slots);

    val ce_r: res[ChunkEditor[HandleSlot[T]], Error] = chunk_editor[HandleSlot[T]](?t.slots);
    if (sel ce_r.err) { ret res[HandleId[Domain], Error].err{ce_r.err}; }
    var ce: ChunkEditor[HandleSlot[T]] = ce_r.ok;

    var fresh: HandleSlot[T];
    fresh.value      = value;
    fresh.generation = 0;
    val push_r: res[*HandleSlot[T], Error] = chunk_append[HandleSlot[T]](?ce, fresh);
    chunk_editor_finish[HandleSlot[T]](?ce);
    if (sel push_r.err) { ret res[HandleId[Domain], Error].err{push_r.err}; }

    var id: HandleId[Domain];
    id.index        = idx;
    id.generation    = 0;
    id.instance_tag  = t.identity::usize;
    ret res[HandleId[Domain], Error].ok{id};
}

pub fun editor_remove[T, Domain](e: *HandleEditor[T, Domain], id: HandleId[Domain]) res[T, Error] {
    if (e == nil || e.table == nil) { ret res[T, Error].err{Error.absent{}}; }
    val t: *HandleTable[T, Domain] = e.table;
    val slot_r: res[*HandleSlot[T], Error] = resolve[T, Domain](t, id);
    if (sel slot_r.err) { ret res[T, Error].err{slot_r.err}; }
    val slot: *HandleSlot[T] = slot_r.ok;

    val value: T = slot.value;
    slot.generation = slot.generation + 1;

    val push_r: res[usize, A.Error] = vector.push[usize](?t.free_list, id.index);
    if (sel push_r.err) {
        slot.generation = slot.generation - 1;
        ret res[T, Error].err{Error.alloc{push_r.err}};
    }

    ret res[T, Error].ok{value};
}

val PROBE_SLOTS: usize = 16;

rec AllocProbe {
    backing:  A.Allocator;
    calls:    u32;
    fail_at:  u32;
    live:     i64;
    ptrs:     [PROBE_SLOTS]ptr;
    sizes:    [PROBE_SLOTS]usize;
    mismatch: bool;
}

fun probe_note_alloc(p: *AllocProbe, item: ptr, size: usize) {
    var i: usize = 0;
    for (i < PROBE_SLOTS && p.ptrs[i] != nil) { i = i + 1; }
    if (i == PROBE_SLOTS) { p.mismatch = true; ret; }
    p.ptrs[i]  = item;
    p.sizes[i] = size;
    p.live     = p.live + size::i64;
}

fun probe_note_free(p: *AllocProbe, item: ptr, size: usize) {
    var i: usize = 0;
    for (i < PROBE_SLOTS && p.ptrs[i] != item) { i = i + 1; }
    if (i == PROBE_SLOTS) { p.mismatch = true; ret; }
    if (p.sizes[i] != size) { p.mismatch = true; }
    p.live     = p.live - p.sizes[i]::i64;
    p.ptrs[i]  = nil;
    p.sizes[i] = 0;
}

fun probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *AllocProbe = ctx::*AllocProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls >= p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (sel r.none) { ret r; }
    probe_note_alloc(p, r.some, size);
    ret r;
}

fun probe_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val p: *AllocProbe = ctx::*AllocProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls >= p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (sel r.none) { ret r; }
    if (item != nil) { probe_note_free(p, item, old_size); }
    probe_note_alloc(p, r.some, new_size);
    ret r;
}

fun probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *AllocProbe = ctx::*AllocProbe;
    probe_note_free(p, item, size);
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun probe_make(p: *AllocProbe, alloc: *A.Allocator, fail_at: u32) bool {
    val make_r: err[A.Error] = page.make(?p.backing);
    if (sel make_r.err) { ret false; }
    p.calls    = 0;
    p.fail_at  = fail_at;
    p.live     = 0;
    p.mismatch = false;
    var i: usize = 0;
    for (i < PROBE_SLOTS) { p.ptrs[i] = nil; p.sizes[i] = 0; i = i + 1; }
    val self_ptr: *AllocProbe = p;
    alloc.ctx           = self_ptr::ptr;
    alloc.fn_allocate   = probe_allocate;
    alloc.fn_reallocate = probe_reallocate;
    alloc.fn_deallocate = probe_deallocate;
    ret true;
}

rec HDom {}

test "mach.lang.handle.chunk_push:borrow_survives_growth_and_writes_through" {
    var a: A.Allocator;
    page.make(?a);
    var s: StableChunks[u64] = chunk_init[u64](?a);

    val edit_r: res[ChunkEditor[u64], Error] = chunk_editor[u64](?s);
    if (sel edit_r.err) { chunk_dnit[u64](?s); ret 1; }
    var e: ChunkEditor[u64] = edit_r.ok;

    var borrow: *u64 = nil;
    var i: usize = 0;
    for (i < 600) {
        val push_r: res[*u64, Error] = chunk_append[u64](?e, i);
        if (sel push_r.err) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }
        if (i == 3) { borrow = push_r.ok; }
        i = i + 1;
    }
    chunk_editor_finish[u64](?e);

    if (borrow == nil || @borrow != 3)   { chunk_dnit[u64](?s); ret 1; }
    if (chunk_count[u64](?s) != 600)     { chunk_dnit[u64](?s); ret 1; }

    @borrow = 999999;
    val get_r: opt[*u64] = chunk_at[u64](?s, 3);
    if (sel get_r.none)            { chunk_dnit[u64](?s); ret 1; }
    if (@get_r.some != 999999) { chunk_dnit[u64](?s); ret 1; }

    chunk_dnit[u64](?s);
    ret 0;
}

test "mach.lang.handle.chunk_edit:exclusive_access_is_enforced" {
    var a: A.Allocator;
    page.make(?a);
    var s: StableChunks[u64] = chunk_init[u64](?a);

    val e1_r: res[ChunkEditor[u64], Error] = chunk_editor[u64](?s);
    if (sel e1_r.err) { chunk_dnit[u64](?s); ret 1; }
    var e1: ChunkEditor[u64] = e1_r.ok;

    val chunk_editor_r: res[ChunkEditor[u64], Error] = chunk_editor[u64](?s);
    if (sel chunk_editor_r.ok) {
        chunk_editor_finish[u64](?e1); chunk_dnit[u64](?s); ret 1;
    }

    chunk_editor_finish[u64](?e1);

    val e2_r: res[ChunkEditor[u64], Error] = chunk_editor[u64](?s);
    if (sel e2_r.err) { chunk_dnit[u64](?s); ret 1; }
    var e2: ChunkEditor[u64] = e2_r.ok;
    chunk_editor_finish[u64](?e2);

    chunk_dnit[u64](?s);
    ret 0;
}

test "mach.lang.handle.chunk_push:allocation_failure_leaves_store_unchanged" {
    var fail_at: u32 = 1;
    for (fail_at <= 3) {
        var probe: AllocProbe;
        var pa: A.Allocator;
        if (!probe_make(?probe, ?pa, fail_at)) { ret 1; }
        var s: StableChunks[u64] = chunk_init[u64](?pa);

        val edit_r: res[ChunkEditor[u64], Error] = chunk_editor[u64](?s);
        if (sel edit_r.err) { chunk_dnit[u64](?s); ret 1; }
        var e: ChunkEditor[u64] = edit_r.ok;

        var failed: bool = false;
        var pushed: usize = 0;
        var i: usize = 0;
        for (i < CHUNK_CAPACITY + 1) {
            val push_r: res[*u64, Error] = chunk_append[u64](?e, i::u64 + 1);
            if (sel push_r.err) { failed = true; brk; }
            pushed = pushed + 1;
            i = i + 1;
        }
        if (!failed) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }

        var expect: usize = 0;
        if (fail_at == 3) { expect = CHUNK_CAPACITY; }
        if (pushed != expect || s.len != expect) {
            chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1;
        }

        var bad: bool = false;
        var k: usize = 0;
        for (k < pushed) {
            val got: opt[*u64] = chunk_at[u64](?s, k);
            if (!(sel got.some && @got.some == k::u64 + 1)) { bad = true; }
            k = k + 1;
        }
        if (bad) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }

        chunk_editor_finish[u64](?e);
        chunk_dnit[u64](?s);
        if (probe.live != 0 || probe.mismatch) { ret 1; }

        fail_at = fail_at + 1;
    }
    ret 0;
}

test "mach.lang.handle.chunk_reserve:allocation_failure_leaves_store_unchanged" {
    var fail_at: u32 = 3;
    for (fail_at <= 5) {
        var probe: AllocProbe;
        var pa: A.Allocator;
        if (!probe_make(?probe, ?pa, fail_at)) { ret 1; }
        var s: StableChunks[u64] = chunk_init[u64](?pa);

        val edit_r: res[ChunkEditor[u64], Error] = chunk_editor[u64](?s);
        if (sel edit_r.err) { chunk_dnit[u64](?s); ret 1; }
        var e: ChunkEditor[u64] = edit_r.ok;

        var i: usize = 0;
        for (i < CHUNK_CAPACITY) {
            val push_r: res[*u64, Error] = chunk_append[u64](?e, i::u64 + 1);
            if (sel push_r.err) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }
            i = i + 1;
        }

        val len_before:    usize = s.len;
        val chunks_before: usize = s.chunks.len;

        val reserve_r: err[Error] = chunk_grow[u64](?e, CHUNK_CAPACITY * 3);
        if (sel reserve_r.ok) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }

        if (s.len != len_before || s.chunks.len != chunks_before) {
            chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1;
        }

        var bad: bool = false;
        var k: usize = 0;
        for (k < CHUNK_CAPACITY) {
            val got: opt[*u64] = chunk_at[u64](?s, k);
            if (!(sel got.some && @got.some == k::u64 + 1)) { bad = true; }
            k = k + 1;
        }
        if (bad) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }

        chunk_editor_finish[u64](?e);
        chunk_dnit[u64](?s);
        if (probe.live != 0 || probe.mismatch) { ret 1; }

        fail_at = fail_at + 1;
    }
    ret 0;
}

test "mach.lang.handle.chunk_reserve:secures_capacity_for_a_batch_that_survives_exhaustion" {
    var probe: AllocProbe;
    var pa: A.Allocator;
    if (!probe_make(?probe, ?pa, 0)) { ret 1; }
    var s: StableChunks[u64] = chunk_init[u64](?pa);

    val edit_r: res[ChunkEditor[u64], Error] = chunk_editor[u64](?s);
    if (sel edit_r.err) { chunk_dnit[u64](?s); ret 1; }
    var e: ChunkEditor[u64] = edit_r.ok;

    val batch: usize = CHUNK_CAPACITY * 3;
    val reserve_r: err[Error] = chunk_grow[u64](?e, batch);
    if (sel reserve_r.err) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }

    probe.fail_at = probe.calls + 1;

    var ok_count: usize = 0;
    var i: usize = 0;
    for (i < batch) {
        val push_r: res[*u64, Error] = chunk_append[u64](?e, i::u64);
        if (sel push_r.err) { brk; }
        ok_count = ok_count + 1;
        i = i + 1;
    }
    if (ok_count != batch) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }

    var bad: bool = false;
    var k: usize = 0;
    for (k < batch) {
        val got: opt[*u64] = chunk_at[u64](?s, k);
        if (!(sel got.some && @got.some == k::u64)) { bad = true; }
        k = k + 1;
    }
    if (bad) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }

    var b: usize = 0;
    for (b < 3) {
        val beyond_r: res[*u64, Error] = chunk_append[u64](?e, 999999);
        if (sel beyond_r.ok) { chunk_editor_finish[u64](?e); chunk_dnit[u64](?s); ret 1; }
        b = b + 1;
    }

    chunk_editor_finish[u64](?e);
    chunk_dnit[u64](?s);
    if (probe.live != 0 || probe.mismatch) { ret 1; }
    ret 0;
}

test "mach.lang.handle.editor_remove:stale_identifier_rejected_after_reuse" {
    var a: A.Allocator;
    page.make(?a);
    val table_r: res[HandleTable[u64, HDom], Error] = table_init[u64, HDom](?a);
    if (sel table_r.err) { ret 1; }
    var t: HandleTable[u64, HDom] = table_r.ok;

    val edit_r: res[HandleEditor[u64, HDom], Error] = edit[u64, HDom](?t);
    if (sel edit_r.err) { table_dnit[u64, HDom](?t); ret 1; }
    var e: HandleEditor[u64, HDom] = edit_r.ok;

    var ids: [5]HandleId[HDom];
    var i: usize = 0;
    for (i < 5) {
        val ins_r: res[HandleId[HDom], Error] = editor_insert[u64, HDom](?e, i::u64 * 10);
        if (sel ins_r.err) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
        ids[i] = ins_r.ok;
        i = i + 1;
    }

    val stale: HandleId[HDom] = ids[2];
    val rm_r: res[u64, Error] = editor_remove[u64, HDom](?e, stale);
    if (sel rm_r.err) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }

    val reins_r: res[HandleId[HDom], Error] = editor_insert[u64, HDom](?e, 999);
    if (sel reins_r.err) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
    val fresh: HandleId[HDom] = reins_r.ok;

    editor_finish[u64, HDom](?e);

    if (fresh.index != stale.index)           { table_dnit[u64, HDom](?t); ret 1; }
    if (fresh.generation == stale.generation) { table_dnit[u64, HDom](?t); ret 1; }
    val get_r: res[*u64, Error] = get[u64, HDom](?t, stale);
    if (sel get_r.ok) { table_dnit[u64, HDom](?t); ret 1; }

    val fresh_r: res[*u64, Error] = get[u64, HDom](?t, fresh);
    if (sel fresh_r.err) { ret 99; }
    if (!(sel fresh_r.ok && @fresh_r.ok == 999)) { table_dnit[u64, HDom](?t); ret 1; }

    table_dnit[u64, HDom](?t);
    ret 0;
}

test "mach.lang.handle.get:borrow_survives_further_inserts_and_writes_through" {
    var a: A.Allocator;
    page.make(?a);
    val table_r: res[HandleTable[u64, HDom], Error] = table_init[u64, HDom](?a);
    if (sel table_r.err) { ret 1; }
    var t: HandleTable[u64, HDom] = table_r.ok;

    val edit_r: res[HandleEditor[u64, HDom], Error] = edit[u64, HDom](?t);
    if (sel edit_r.err) { table_dnit[u64, HDom](?t); ret 1; }
    var e: HandleEditor[u64, HDom] = edit_r.ok;

    val first_r: res[HandleId[HDom], Error] = editor_insert[u64, HDom](?e, 7);
    if (sel first_r.err) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
    val first: HandleId[HDom] = first_r.ok;

    val borrow_r: res[*u64, Error] = get[u64, HDom](?t, first);
    if (sel borrow_r.err) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
    val borrow: *u64 = borrow_r.ok;

    var i: usize = 0;
    for (i < 600) {
        val ins_r: res[HandleId[HDom], Error] = editor_insert[u64, HDom](?e, i::u64);
        if (sel ins_r.err) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
        i = i + 1;
    }
    editor_finish[u64, HDom](?e);

    if (@borrow != 7) { table_dnit[u64, HDom](?t); ret 1; }
    @borrow = 999999;
    val reget_r: res[*u64, Error] = get[u64, HDom](?t, first);
    if (sel reget_r.err) { ret 99; }
    if (sel reget_r.err) {
        table_dnit[u64, HDom](?t); ret 1;
    }
    if (@reget_r.ok != 999999) {
        table_dnit[u64, HDom](?t); ret 1;
    }

    table_dnit[u64, HDom](?t);
    ret 0;
}

test "mach.lang.handle.get:freed_slot_rejected_before_reuse" {
    var a: A.Allocator;
    page.make(?a);
    val table_r: res[HandleTable[u64, HDom], Error] = table_init[u64, HDom](?a);
    if (sel table_r.err) { ret 1; }
    var t: HandleTable[u64, HDom] = table_r.ok;

    val edit_r: res[HandleEditor[u64, HDom], Error] = edit[u64, HDom](?t);
    if (sel edit_r.err) { table_dnit[u64, HDom](?t); ret 1; }
    var e: HandleEditor[u64, HDom] = edit_r.ok;

    var ids: [3]HandleId[HDom];
    var i: usize = 0;
    for (i < 3) {
        val ins_r: res[HandleId[HDom], Error] = editor_insert[u64, HDom](?e, i::u64);
        if (sel ins_r.err) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
        ids[i] = ins_r.ok;
        i = i + 1;
    }

    val target: HandleId[HDom] = ids[1];
    if (!contains[u64, HDom](?t, target)) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }

    val rm_r: res[u64, Error] = editor_remove[u64, HDom](?e, target);
    if (sel rm_r.err) { ret 99; }
    if (sel rm_r.err) {
        editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1;
    }
    if (rm_r.ok != 1) {
        editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1;
    }

    if (contains[u64, HDom](?t, target)) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
    val get_r: res[*u64, Error] = get[u64, HDom](?t, target);
    if (sel get_r.ok) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
    val editor_remove_r: res[u64, Error] = editor_remove[u64, HDom](?e, target);
    if (sel editor_remove_r.ok) {
        editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1;
    }

    editor_finish[u64, HDom](?e);
    table_dnit[u64, HDom](?t);
    ret 0;
}

test "mach.lang.handle.get:index_out_of_range_rejected" {
    var a: A.Allocator;
    page.make(?a);
    val table_r: res[HandleTable[u64, HDom], Error] = table_init[u64, HDom](?a);
    if (sel table_r.err) { ret 1; }
    var t: HandleTable[u64, HDom] = table_r.ok;

    val edit_r: res[HandleEditor[u64, HDom], Error] = edit[u64, HDom](?t);
    if (sel edit_r.err) { table_dnit[u64, HDom](?t); ret 1; }
    var e: HandleEditor[u64, HDom] = edit_r.ok;
    val ins_r: res[HandleId[HDom], Error] = editor_insert[u64, HDom](?e, 42);
    if (sel ins_r.err) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
    val real: HandleId[HDom] = ins_r.ok;
    editor_finish[u64, HDom](?e);

    var bogus: HandleId[HDom] = real;
    bogus.index = real.index + 1000;

    val get_r: res[*u64, Error] = get[u64, HDom](?t, bogus);
    if (sel get_r.ok) { table_dnit[u64, HDom](?t); ret 1; }
    val real_r: res[*u64, Error] = get[u64, HDom](?t, real);
    if (sel real_r.err) { ret 99; }
    if (!(sel real_r.ok && @real_r.ok == 42)) { table_dnit[u64, HDom](?t); ret 1; }

    table_dnit[u64, HDom](?t);
    ret 0;
}

test "mach.lang.handle.edit:exclusive_access_is_enforced" {
    var a: A.Allocator;
    page.make(?a);
    val table_r: res[HandleTable[u64, HDom], Error] = table_init[u64, HDom](?a);
    if (sel table_r.err) { ret 1; }
    var t: HandleTable[u64, HDom] = table_r.ok;

    val e1_r: res[HandleEditor[u64, HDom], Error] = edit[u64, HDom](?t);
    if (sel e1_r.err) { table_dnit[u64, HDom](?t); ret 1; }
    var e1: HandleEditor[u64, HDom] = e1_r.ok;

    val edit_r: res[HandleEditor[u64, HDom], Error] = edit[u64, HDom](?t);
    if (sel edit_r.ok) {
        editor_finish[u64, HDom](?e1); table_dnit[u64, HDom](?t); ret 1;
    }

    editor_finish[u64, HDom](?e1);

    val e2_r: res[HandleEditor[u64, HDom], Error] = edit[u64, HDom](?t);
    if (sel e2_r.err) { table_dnit[u64, HDom](?t); ret 1; }
    var e2: HandleEditor[u64, HDom] = e2_r.ok;
    editor_finish[u64, HDom](?e2);

    table_dnit[u64, HDom](?t);
    ret 0;
}

test "mach.lang.handle.view:invalidated_by_edit" {
    var a: A.Allocator;
    page.make(?a);
    val table_r: res[HandleTable[u64, HDom], Error] = table_init[u64, HDom](?a);
    if (sel table_r.err) { ret 1; }
    var t: HandleTable[u64, HDom] = table_r.ok;

    val edit1_r: res[HandleEditor[u64, HDom], Error] = edit[u64, HDom](?t);
    if (sel edit1_r.err) { table_dnit[u64, HDom](?t); ret 1; }
    var e1: HandleEditor[u64, HDom] = edit1_r.ok;
    val ins_r: res[HandleId[HDom], Error] = editor_insert[u64, HDom](?e1, 42);
    if (sel ins_r.err) { editor_finish[u64, HDom](?e1); table_dnit[u64, HDom](?t); ret 1; }
    val id: HandleId[HDom] = ins_r.ok;
    editor_finish[u64, HDom](?e1);

    var v: HandleView[u64, HDom] = view[u64, HDom](?t);
    if (!view_valid[u64, HDom](?v)) { table_dnit[u64, HDom](?t); ret 1; }
    val before_r: res[*u64, Error] = view_get[u64, HDom](?v, id);
    if (sel before_r.err) { ret 99; }
    if (!(sel before_r.ok && @before_r.ok == 42)) { table_dnit[u64, HDom](?t); ret 1; }

    val edit2_r: res[HandleEditor[u64, HDom], Error] = edit[u64, HDom](?t);
    if (sel edit2_r.err) { table_dnit[u64, HDom](?t); ret 1; }
    var e2: HandleEditor[u64, HDom] = edit2_r.ok;
    editor_insert[u64, HDom](?e2, 7);
    editor_finish[u64, HDom](?e2);

    if (view_valid[u64, HDom](?v)) { table_dnit[u64, HDom](?t); ret 1; }
    val view_get_r: res[*u64, Error] = view_get[u64, HDom](?v, id);
    if (sel view_get_r.ok) { table_dnit[u64, HDom](?t); ret 1; }

    var v2: HandleView[u64, HDom] = view[u64, HDom](?t);
    val after_r: res[*u64, Error] = view_get[u64, HDom](?v2, id);
    if (sel after_r.err) { ret 99; }
    if (!(sel after_r.ok && @after_r.ok == 42)) { table_dnit[u64, HDom](?t); ret 1; }

    table_dnit[u64, HDom](?t);
    ret 0;
}

test "mach.lang.handle.get:cross_store_identifier_confusion_rejected" {
    var a: A.Allocator;
    page.make(?a);

    val ta_r: res[HandleTable[u64, HDom], Error] = table_init[u64, HDom](?a);
    if (sel ta_r.err) { ret 1; }
    var ta: HandleTable[u64, HDom] = ta_r.ok;

    val tb_r: res[HandleTable[u64, HDom], Error] = table_init[u64, HDom](?a);
    if (sel tb_r.err) { table_dnit[u64, HDom](?ta); ret 1; }
    var tb: HandleTable[u64, HDom] = tb_r.ok;

    val ea_r: res[HandleEditor[u64, HDom], Error] = edit[u64, HDom](?ta);
    if (sel ea_r.err) { table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1; }
    var ea: HandleEditor[u64, HDom] = ea_r.ok;
    val ida_r: res[HandleId[HDom], Error] = editor_insert[u64, HDom](?ea, 111);
    if (sel ida_r.err) {
        editor_finish[u64, HDom](?ea); table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1;
    }
    val ida: HandleId[HDom] = ida_r.ok;
    editor_finish[u64, HDom](?ea);

    val eb_r: res[HandleEditor[u64, HDom], Error] = edit[u64, HDom](?tb);
    if (sel eb_r.err) { table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1; }
    var eb: HandleEditor[u64, HDom] = eb_r.ok;
    val idb_r: res[HandleId[HDom], Error] = editor_insert[u64, HDom](?eb, 222);
    if (sel idb_r.err) {
        editor_finish[u64, HDom](?eb); table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1;
    }
    val idb: HandleId[HDom] = idb_r.ok;
    editor_finish[u64, HDom](?eb);

    if (ida.index != idb.index || ida.generation != idb.generation) {
        table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1;
    }
    if (ida.instance_tag == idb.instance_tag) {
        table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1;
    }

    val own_a: res[*u64, Error] = get[u64, HDom](?ta, ida);
    if (sel own_a.err) {
        table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1;
    }
    if (@own_a.ok != 111) {
        table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1;
    }

    val get_r: res[*u64, Error] = get[u64, HDom](?ta, idb);
    if (sel get_r.ok) { table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1; }
    val get_r2: res[*u64, Error] = get[u64, HDom](?tb, ida);
    if (sel get_r2.ok) { table_dnit[u64, HDom](?ta); table_dnit[u64, HDom](?tb); ret 1; }

    table_dnit[u64, HDom](?ta);
    table_dnit[u64, HDom](?tb);
    ret 0;
}

test "mach.lang.handle.table:allocation_failure_at_each_fallible_step_leaves_store_unchanged" {
    var fail_at: u32 = 1;
    for (fail_at <= 5) {
        var probe: AllocProbe;
        var pa: A.Allocator;
        if (!probe_make(?probe, ?pa, fail_at)) { ret 1; }

        val table_r: res[HandleTable[u64, HDom], Error] = table_init[u64, HDom](?pa);
        if (fail_at == 1) {
            if (sel table_r.ok) { ret 1; }
            if (probe.live != 0 || probe.mismatch) { ret 1; }
            fail_at = fail_at + 1;
            cnt;
        }
        if (sel table_r.err) { ret 1; }
        var t: HandleTable[u64, HDom] = table_r.ok;

        val edit_r: res[HandleEditor[u64, HDom], Error] = edit[u64, HDom](?t);
        if (sel edit_r.err) { table_dnit[u64, HDom](?t); ret 1; }
        var e: HandleEditor[u64, HDom] = edit_r.ok;

        var ids: [70]HandleId[HDom];
        var inserted: usize = 0;
        var insert_failed: bool = false;
        var i: usize = 0;
        for (i < 70) {
            val ins_r: res[HandleId[HDom], Error] = editor_insert[u64, HDom](?e, (i::u64 + 1) * 100);
            if (sel ins_r.err) { insert_failed = true; brk; }
            ids[i]   = ins_r.ok;
            inserted = inserted + 1;
            i = i + 1;
        }

        var expect: usize = 70;
        if (fail_at == 2 || fail_at == 3) { expect = 0; }
        if (fail_at == 4) { expect = CHUNK_CAPACITY; }
        val expect_insert_failed: bool = fail_at == 2 || fail_at == 3 || fail_at == 4;
        if (insert_failed != expect_insert_failed || inserted != expect) {
            editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1;
        }

        var bad: bool = false;
        var k: usize = 0;
        for (k < inserted) {
            val got: res[*u64, Error] = get[u64, HDom](?t, ids[k]);
            if (!(sel got.ok && @got.ok == (k::u64 + 1) * 100)) { bad = true; }
            k = k + 1;
        }
        if (bad) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }

        if (fail_at == 5) {
            val rm_r: res[u64, Error] = editor_remove[u64, HDom](?e, ids[0]);
            if (sel rm_r.ok) { editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1; }
            val still: res[*u64, Error] = get[u64, HDom](?t, ids[0]);
            if (sel still.err) {
                editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1;
            }
            if (@still.ok != 100) {
                editor_finish[u64, HDom](?e); table_dnit[u64, HDom](?t); ret 1;
            }
        }

        editor_finish[u64, HDom](?e);
        table_dnit[u64, HDom](?t);
        if (probe.live != 0 || probe.mismatch) { ret 1; }

        fail_at = fail_at + 1;
    }
    ret 0;
}
