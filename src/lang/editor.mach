    var es: EditorSession = init(?s);

    val res_fid: res[source.FileId, fail.Fail] = open(?es, "ctrl.mach", "fun main() i64 { ret 0; }\n\x0B\n");
    if (sel res_fid.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val fid: source.FileId = res_fid.ok;

    val res_tokens: res[lexer.TokenStream, fail.Fail] = tokenize_inner(?es, fid);
    if (sel res_tokens.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    var stream: lexer.TokenStream = res_tokens.ok;

    val hit: bool = diag_has(?es.s.diags, "stray control character in source");
    lexer.dnit(?stream, es.alloc);
    if (!hit) { t_dnit(?es); session.dnit(?s); ret 1; }

    t_dnit(?es);
    session.dnit(?s);
    ret 0;
}

