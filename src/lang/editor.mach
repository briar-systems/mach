test "mach.lang.editor.comptime_if:declaration_free_gate_sees_types" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);

    val res_ok: res[source.FileId, fail.Fail] = open(?es, "gateok.mach",
        "rec H { a: i64; b: i64; }\nval LIMIT: i64 = 16;\n$if ($size_of(H) != 16) { $error(\"size wrong\"); }\n$if ($size_of(H) > LIMIT) { $error(\"too large\"); }\n$if (!$is_record(H)) { $error(\"not a record\"); }\n$if ($type_of(LIMIT) != i64) { $error(\"limit not i64\"); }\nfun main() i64 { ret 0; }\n");
    if (sel res_ok.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val fid_ok: source.FileId = res_ok.ok;

    val res_rok: res[*resolve.ResolveResult, fail.Fail] = resolve_buffer(?es, fid_ok);
    if (sel res_rok.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    if (diagnostic.has_errors(?es.s.diags))         { t_dnit(?es); session.dnit(?s); ret 1; }

    val res_dok: res[*diagnostic.DiagnosticStore, fail.Fail] = t_run_sema(?es, fid_ok, 8);
    if (sel res_dok.err)                                     { t_dnit(?es); session.dnit(?s); ret 1; }
    if (diagnostic.has_errors(res_dok.ok))           { t_dnit(?es); session.dnit(?s); ret 1; }

    val res_bad: res[source.FileId, fail.Fail] = open(?es, "gatebad.mach",
        "rec H { a: i64; b: i64; }\n$if ($size_of(H) == 16) { $error(\"H measures 16\"); }\nfun main() i64 { ret 0; }\n");
    if (sel res_bad.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val fid_bad: source.FileId = res_bad.ok;

    val res_rbad: res[*resolve.ResolveResult, fail.Fail] = resolve_buffer(?es, fid_bad);
    if (sel res_rbad.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    if (diagnostic.has_errors(?es.s.diags))          { t_dnit(?es); session.dnit(?s); ret 1; }

    val res_dbad: res[*diagnostic.DiagnosticStore, fail.Fail] = t_run_sema(?es, fid_bad, 8);
    if (sel res_dbad.err)                                { t_dnit(?es); session.dnit(?s); ret 1; }
    if (!diag_has(res_dbad.ok, "H measures 16")) { t_dnit(?es); session.dnit(?s); ret 1; }

    t_dnit(?es);
    session.dnit(?s);
    ret 0;
}

