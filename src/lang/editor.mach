    var s: session.Session = R.unwrap_ok[session.Session, str](res_session);
    var es: EditorSession = init(?s);

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/nonexistent/mach-editor-build-test";

    val prior_build: *A.Allocator = s.build_alloc;
    val r: R.Result[outcome.BuildOutcome, outcome.Fail] = build(?es, ?rq);
    var bad: i32 = 0;
    if (!R.is_err[outcome.BuildOutcome, outcome.Fail](r)) { bad = 1; }
    or {
        var f: outcome.Fail = R.unwrap_err[outcome.BuildOutcome, outcome.Fail](r);
        if (sel f.internal) { bad = 1; }
        fail_dnit(?es, ?f);
    }
    if (s.build_alloc != prior_build) { bad = 1; }

    t_dnit(?es);
    session.dnit(?s);
    ret bad;
}

rec CountingAllocator {
    allocator: A.Allocator;
    backing:   *A.Allocator;
    live:      i64;
    calls:     usize;
    fail_at:   usize;
    last_size: usize;
}

fun counting_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val c: *CountingAllocator = ctx::*CountingAllocator;
    c.calls = c.calls + 1;
    c.last_size = size;
    if (c.fail_at != 0 && c.calls == c.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = c.backing.fn_allocate(c.backing.ctx, size, align);
    if (sel r.some) { c.live = c.live + 1; }
    ret r;
}

fun counting_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val c: *CountingAllocator = ctx::*CountingAllocator;
    c.calls = c.calls + 1;
    c.last_size = new_size;
    if (c.fail_at != 0 && c.calls == c.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = c.backing.fn_reallocate(c.backing.ctx, p, old_size, new_size, align);
    if (sel r.some) {
        if (p == nil && new_size > 0)      { c.live = c.live + 1; }
        or (p != nil && new_size == 0)     { c.live = c.live - 1; }
    }
    ret r;
}

fun counting_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    val c: *CountingAllocator = ctx::*CountingAllocator;
    val r: i64 = c.backing.fn_deallocate(c.backing.ctx, p, size, align);
    if (r == 0) { c.live = c.live - 1; }
    ret r;
}

fun counting_init(c: *CountingAllocator, backing: *A.Allocator) {
    c.backing                 = backing;
    c.live                    = 0;
    c.calls                   = 0;
    c.fail_at                 = 0;
    c.last_size               = 0;
    c.allocator.ctx           = c::ptr;
    c.allocator.fn_allocate   = counting_allocate;
    c.allocator.fn_reallocate = counting_reallocate;
    c.allocator.fn_deallocate = counting_deallocate;
}

test "mach.lang.editor.fail_dnit:repeated_failed_builds_leave_no_owned_message_outstanding" {
    var backing: A.Allocator;
    page.make(?backing);
    var cnt: CountingAllocator;
    counting_init(?cnt, ?backing);

    val res_session: R.Result[session.Session, str] = session.init(?cnt.allocator);
    if (R.is_err[session.Session, str](res_session)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](res_session);
    var es: EditorSession = init(?s);

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = "/nonexistent/mach-editor-fail-dnit-test";

    var bad: i32 = 0;
    var i: i32 = 0;
    for (i < 3) {
        val r: R.Result[outcome.BuildOutcome, outcome.Fail] = build(?es, ?rq);
        if (!R.is_err[outcome.BuildOutcome, outcome.Fail](r)) { bad = 1; }
        or {
            var f: outcome.Fail = R.unwrap_err[outcome.BuildOutcome, outcome.Fail](r);
            fail_dnit(?es, ?f);
            if (outcome.describe(f) != nil) { bad = 1; }
        }
        i = i + 1;
    }

    t_dnit(?es);
    session.dnit(?s);

    if (cnt.live != 0) { bad = 1; }
    ret bad;
}

fun t_first_fix(list: *diagnostic.DiagnosticStore) *diagnostic.Fix {
    var i: usize = 0;
    for (i < diagnostic.len(list)) {
        if (list.items.data[i].fixes.len > 0) { ret ?list.items.data[i].fixes.data[0]; }
        i = i + 1;
    }
    ret nil;
}

fun t_any_fix(list: *diagnostic.DiagnosticStore) bool {
    ret t_first_fix(list) != nil;
}

fun t_apply_fix(a: *A.Allocator, src: str, fx: *diagnostic.Fix) str {
    val cr: R.Result[str, str] = str_copy(a, src);
    if (R.is_err[str, str](cr)) { ret nil; }
    var cur: str = R.unwrap_ok[str, str](cr);

    var limit: usize = str_len(src) + 1;
    var n: usize = 0;
    for (n < fx.edits.len) {
        var best:     usize = fx.edits.len;
        var best_off: usize = 0;
        var i: usize = 0;
        for (i < fx.edits.len) {
            val off: usize = fx.edits.data[i].loc.span.offset;
            if (off < limit && (best == fx.edits.len || off > best_off)) {
                best     = i;
                best_off = off;
            }
            i = i + 1;
        }
        if (best == fx.edits.len) { brk; }
        limit = best_off;

        val tail_start: usize = best_off + fx.edits.data[best].loc.span.len;
        val cur_len:    usize = str_len(cur);
        if (tail_start > cur_len) { ret cur; }

        val hr: R.Result[str, str] = str_copy_slice(a, cur, 0, best_off);
        if (R.is_err[str, str](hr)) { ret cur; }
        val tr: R.Result[str, str] = str_copy_slice(a, cur, tail_start, cur_len - tail_start);
        if (R.is_err[str, str](tr)) { ret cur; }
        val head: str = R.unwrap_ok[str, str](hr);
        val tail: str = R.unwrap_ok[str, str](tr);

        val jr: R.Result[str, str] = str_join(a, head, fx.edits.data[best].replacement, tail);
        if (R.is_ok[str, str](jr)) { cur = R.unwrap_ok[str, str](jr); }
        n = n + 1;
    }
    ret cur;
}

fun t_analyzes_clean(alloc: *A.Allocator, name: str, src: str) bool {
    val res_session: R.Result[session.Session, str] = t_session(alloc);
    if (R.is_err[session.Session, str](res_session)) { ret false; }
    var s: session.Session = R.unwrap_ok[session.Session, str](res_session);
    var es: EditorSession = init(?s);

    val res_fid: R.Result[source.FileId, str] = open(?es, name, src);
    if (R.is_err[source.FileId, str](res_fid)) { t_dnit(?es); session.dnit(?s); ret false; }
    val fid: source.FileId = R.unwrap_ok[source.FileId, str](res_fid);

    val res_diags: R.Result[*diagnostic.DiagnosticStore, str] = t_run_sema(?es, fid, 8);
    if (R.is_err[*diagnostic.DiagnosticStore, str](res_diags)) { t_dnit(?es); session.dnit(?s); ret false; }
    val clean: bool = !diagnostic.has_errors(R.unwrap_ok[*diagnostic.DiagnosticStore, str](res_diags));

    t_dnit(?es);
    session.dnit(?s);
    ret clean;
}

test "mach.lang.editor.fix:a_spelling_correction_is_a_mechanical_edit" {
    var alloc: A.Allocator;
    val res_session: R.Result[session.Session, str] = t_session(?alloc);
    if (R.is_err[session.Session, str](res_session)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](res_session);
    var es: EditorSession = init(?s);

    val src: str = "fun helper() i64 { ret 0; }\nfun main() i64 { ret helpr(); }\n";
    val res_fid: R.Result[source.FileId, str] = open(?es, "ident.mach", src);
    if (R.is_err[source.FileId, str](res_fid)) { t_dnit(?es); session.dnit(?s); ret 1; }
    val fid: source.FileId = R.unwrap_ok[source.FileId, str](res_fid);

    val res_resolve: R.Result[*res.ResolveResult, str] = resolve_buffer(?es, fid);
    if (R.is_err[*res.ResolveResult, str](res_resolve)) { t_dnit(?es); session.dnit(?s); ret 1; }

    var bad: i32 = 0;
    val list: *diagnostic.DiagnosticStore = ?es.s.diags;

    if (!diag_help_has(list, "did you mean `helper`?") && bad == 0) { bad = 1; }

    val fx: *diagnostic.Fix = t_first_fix(list);
    if (fx == nil) { t_dnit(?es); session.dnit(?s); ret 2; }

    if (fx.edits.len != 1                                              && bad == 0) { bad = 3; }
    if (!str_equals(fx.label, "replace with `helper`")                && bad == 0) { bad = 4; }
    if (!str_equals(fx.edits.data[0].replacement, "helper")                && bad == 0) { bad = 5; }
    if (!str_region_equals(src, fx.edits.data[0].loc.span.offset, fx.edits.data[0].loc.span.len, "helpr") && bad == 0) { bad = 6; }

    val fixed: str = t_apply_fix(?alloc, src, fx);
    if (fixed == nil) { t_dnit(?es); session.dnit(?s); ret 7; }
    if (!t_analyzes_clean(?alloc, "ident.mach", fixed) && bad == 0) { bad = 8; }

    t_dnit(?es);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.editor.fix:a_cast_fix_parenthesizes_only_when_it_must" {
    var alloc: A.Allocator;
    var bad: i32 = 0;

    val src_a: str = "fun main() i64 { val a: i32 = 1; val b: i64 = a; ret b; }\n";
    val res_sa: R.Result[session.Session, str] = t_session(?alloc);
    if (R.is_err[session.Session, str](res_sa)) { ret 1; }
    var sa: session.Session = R.unwrap_ok[session.Session, str](res_sa);
    var ea: EditorSession = init(?sa);
    val fa_r: R.Result[source.FileId, str] = open(?ea, "atom.mach", src_a);
    if (R.is_err[source.FileId, str](fa_r)) { dnit(?ea); session.dnit(?sa); ret 1; }
    val da_r: R.Result[*diagnostic.DiagnosticStore, str] = t_run_sema(?ea, R.unwrap_ok[source.FileId, str](fa_r), 8);
    if (R.is_err[*diagnostic.DiagnosticStore, str](da_r)) { dnit(?ea); session.dnit(?sa); ret 1; }
    val fxa: *diagnostic.Fix = t_first_fix(R.unwrap_ok[*diagnostic.DiagnosticStore, str](da_r));
    if (fxa == nil) { dnit(?ea); session.dnit(?sa); ret 2; }

    if (fxa.edits.len != 1                                    && bad == 0) { bad = 3; }
    if (!str_equals(fxa.label, "cast the value to `i64`")    && bad == 0) { bad = 4; }
    if (!str_equals(fxa.edits.data[0].replacement, "::i64")       && bad == 0) { bad = 5; }
    if (fxa.edits.data[0].loc.span.len != 0                       && bad == 0) { bad = 6; }
    val fixed_a: str = t_apply_fix(?alloc, src_a, fxa);
    if (fixed_a == nil)                                                   { dnit(?ea); session.dnit(?sa); ret 7; }
    if (!str_contains(fixed_a, "val b: i64 = a::i64;")       && bad == 0) { bad = 8; }
    if (!t_analyzes_clean(?alloc, "atom.mach", fixed_a)      && bad == 0) { bad = 9; }
    dnit(?ea);
    session.dnit(?sa);

    val src_c: str = "fun main() i64 { val a: i32 = 1; val b: i64 = a + a; ret b; }\n";
    val res_sc: R.Result[session.Session, str] = t_session(?alloc);
    if (R.is_err[session.Session, str](res_sc)) { ret 10; }
    var sc2: session.Session = R.unwrap_ok[session.Session, str](res_sc);
    var ec: EditorSession = init(?sc2);
    val fc_r: R.Result[source.FileId, str] = open(?ec, "compound.mach", src_c);
    if (R.is_err[source.FileId, str](fc_r)) { dnit(?ec); session.dnit(?sc2); ret 10; }
    val dc_r: R.Result[*diagnostic.DiagnosticStore, str] = t_run_sema(?ec, R.unwrap_ok[source.FileId, str](fc_r), 8);
    if (R.is_err[*diagnostic.DiagnosticStore, str](dc_r)) { dnit(?ec); session.dnit(?sc2); ret 10; }
    val fxc: *diagnostic.Fix = t_first_fix(R.unwrap_ok[*diagnostic.DiagnosticStore, str](dc_r));
    if (fxc == nil) { dnit(?ec); session.dnit(?sc2); ret 11; }

    if (fxc.edits.len != 2                                    && bad == 0) { bad = 12; }
    val fixed_c: str = t_apply_fix(?alloc, src_c, fxc);
    if (fixed_c == nil)                                                   { dnit(?ec); session.dnit(?sc2); ret 13; }
    if (!str_contains(fixed_c, "val b: i64 = (a + a)::i64;") && bad == 0) { bad = 14; }
    if (!t_analyzes_clean(?alloc, "compound.mach", fixed_c)  && bad == 0) { bad = 15; }
    dnit(?ec);
    session.dnit(?sc2);

    ret bad;
}

