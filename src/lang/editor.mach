# one reusable slot for a currently open file
rec Buffer {
    file_id:       lang_source.FileId;
    in_use:        bool;
    owned:         bool;
    a:             *ast.Ast;
    parse_status:  fail.PhaseStatus;
    context_ready: bool;
    rr:            *resolve.ResolveResult;
    sr:            *fe_sema.SemaResult;
    # the buffer's own load scope: a standalone buffer has no load, so it records its decorators here
    ctx: comptime.ComptimeCtx;
    # the scope a typed definition of the buffer is read in, over its own and resolve's and sema's
    view: comptime.ComptimeCtx;
}

# the selection a loaded project's request was composed from. the strings are owned copies,
# which the loaded project's request borrows: an AnalysisRequest's strings are borrowed only
# for the duration of one call
rec ProjKey {
    valid:    bool;
    target:   str;
    profile:  str;
    artifact: str;
}

# the retainer a project root's modules are held under while an open buffer belongs to the root
rec RootRetainer {
    root: str;
    id:   retention.RetainerId;
}

# one serial facade over a borrowed session, with compact open-buffer slots
pub rec EditorSession {
    s:                 *session.Session;
    alloc:             *A.Allocator;
    buffers:           *Buffer;
    buf_len:           u32;
    view_generation:   u64;
    active_request:    *AnalysisRequest;
    operation_failure: opt[fail.Fail];

    proj_arena:      arena.Arena;
    proj_alloc:      A.Allocator;
    proj_loaded:     bool;
    proj:            project.Project;
    proj_root:       str;
    proj_dirty:      bool; # the closure itself is stale: a reload is due
    proj_edited:     collections_vector.Vector[lang_source.FileId]; # buffers whose text changed since the project loaded
    proj_loads:      u64; # closure loads performed, so a caller can see a reload happen
    proj_refreshes:  u64; # in-place refreshes performed, so a caller can see an edit stay cheap
    proj_phase:      driver.FrontendPhase;
    proj_key:        ProjKey;
    proj_roots:      *intern.StrId;
    proj_root_count: u32;
    proj_root_cap:   u32;

    root_retainers: Vector[RootRetainer];
}

# reached only by mach-lsp
pub def AnalysisPhase: driver.FrontendPhase;
pub val PHASE_PARSE: AnalysisPhase = driver.FRONTEND_PARSE;
# reached only by mach-lsp
pub val PHASE_RESOLVE: AnalysisPhase = driver.FRONTEND_RESOLVE;
# reached only by mach-lsp
pub val PHASE_SEMA: AnalysisPhase = driver.FRONTEND_SEMA;

# what one analyze call asks for
# ---
# file:              an open buffer's FileId, the root of the analysis
# phase:             how far the frontend runs, PHASE_PARSE, PHASE_RESOLVE or PHASE_SEMA
# selection:         the overrides of mach's selection for a file under a project's src, empty for
#                    none; its request is composed from the manifest as a project snapshot's is
# standalone_target: for a file under no manifest, a borrowed resolved target whose
#                    registry-owned definitions outlive the Session; nil selects the registered host target.
#                    a project's target selection is never replaced by it
# standalone_build:  for a file under no manifest, the options it is analyzed with, since no profile
#                    composes them; a project's are never taken from it
pub rec AnalysisRequest {
    file:              lang_source.FileId;
    phase:             AnalysisPhase;
    selection:         ProjectSelection;
    standalone_target: *lang_target.Binding;
    standalone_build:  request.BuildRequest;
}

rec AnalysisTarget {
    os:            u32;
    arch:          u32;
    abi:           u32;
    mode:          u32;
    pie:           u32;
    pointer_width: u32;
    vector_bits:   u32;
    register_bits: u32;
    has_float:     bool;
    va_list_size:  u32;
    va_list_align: u32;
}

rec AnalysisSource {
    id:   lang_source.FileId;
    file: lang_source.SourceFile;
}

# the owned envelope analyze returns: every diagnostic and source version it refers to,
# copied, so it outlives buffer edits, later analyses and the Session; the raw products
# (ast_of, resolve_of, sema_of) are not owned and borrow the serial view the result was
# taken in. release exactly once with analysis_dnit, never copy it as a second owner
# ---
# alloc:            owns every field below; must outlive the result
# status:           the phase's standing, accepted, rejected or internal; diagnostic counts never decide it
# failure:          an operational project failure with its fail.Fail category, absent when the
#                   frontend ran
# target:           the target metadata the analysis ran under, read only when target_available
# target_available: false when the requested target context was not acquired; host
#                   metadata is never substituted
# diagnostics:      the owned store, with related locations, fix edits and lost-diagnostic evidence
# sources:          the owned source versions every diagnostic location refers to; analysis_source
#                   finds one by FileId
# tree:             the owned tree of a parse_text result; nil for an analysis of a buffer
pub rec AnalysisResult {
    alloc:              *A.Allocator;
    editor:             *EditorSession;
    session:            *session.Session;
    view_generation:    u64;
    session_generation: u64;
    query_operation:    u64;
    query_revision:     query.Revision;
    file:               lang_source.FileId;
    source_revision:    u64;
    phase:              AnalysisPhase;
    status:             fail.PhaseStatus;
    failure:            opt[fail.Fail];
    target:             AnalysisTarget;
    target_available:   bool;
    configuration:      query.QueryOutput;
    project_root:       str;
    profile:            str;
    message:            str;
    diagnostics:        *diagnostic.DiagnosticStore;
    sources:            Vector[AnalysisSource];
    tree:               *ast.Ast;
}

# a request for one buffer at one phase on mach's own selection
pub fun analysis_request(file: lang_source.FileId, phase: AnalysisPhase) AnalysisRequest {
    ret AnalysisRequest{file: file, phase: phase, selection: ProjectSelection{artifact: "", target: "", profile: ""},
        standalone_build: request.defaults()};
}

# release an analysis result and everything it owns; a zero result is a no-op. this
# also ends the lifetime of every raw product borrowed from it, and a token stream from
# tokenize must be freed before it because its bytes borrow the result's source
# ---
# result: the envelope; zeroed on return so a second call is a no-op
pub fun analysis_dnit(result: *AnalysisResult) {
    if (result.alloc == nil) { ret; }
    envelope_dnit(result.alloc, result.diagnostics, ?result.sources);
    if (result.configuration.bytes != nil) { A.deallocate[u8](result.alloc, result.configuration.bytes, result.configuration.len::usize); }
    str_free(result.alloc, result.project_root);
    str_free(result.alloc, result.profile);
    str_free(result.alloc, result.message);
    if (sel result.failure.some) { fail.places_dnit(result.alloc, result.failure.some); }
    if (result.tree != nil) {
        ast.dnit(result.tree);
        A.deallocate[ast.Ast](result.alloc, result.tree, 1);
    }
    @result = AnalysisResult{};
}

# the owned source version a diagnostic location refers to; use source.position on it
# rather than the Session's current text, which may have moved on
# ---
# result: the envelope
# file:   the FileId from a diagnostic location
# ret:    the owned SourceFile, valid until analysis_dnit; none when the result carries no
#         version of that file
fun analysis_source(result: *AnalysisResult, file: lang_source.FileId) opt[*lang_source.SourceFile] {
    ret sources_find(?result.sources, file);
}

fun sources_find(sources: *Vector[AnalysisSource], file: lang_source.FileId) opt[*lang_source.SourceFile] {
    var i: usize = 0;
    for (i < sources.len) {
        if (lang_source.file_same(sources.data[i].id, file)) { ret opt[*lang_source.SourceFile].some{?sources.data[i].file}; }
        i = i + 1;
    }
    ret opt[*lang_source.SourceFile].none{};
}

# release what an envelope owns: its diagnostic store and the source versions it refers to
fun envelope_dnit(alloc: *A.Allocator, diagnostics: *diagnostic.DiagnosticStore, sources: *Vector[AnalysisSource]) {
    if (diagnostics != nil) {
        diagnostic.store_dnit(diagnostics);
        A.deallocate[diagnostic.DiagnosticStore](alloc, diagnostics, 1);
    }
    var i: usize = 0;
    for (i < sources.len) {
        lang_source.dnit_file(?sources.data[i].file, alloc);
        i = i + 1;
    }
    collections_vector.dnit[AnalysisSource](sources);
}

fun result_buffer(result: *AnalysisResult) res[*Buffer, fail.Fail] {
    val es: *EditorSession = result.editor;
    if (result.alloc == nil || es == nil || result.session != es.s
        || result.view_generation != es.view_generation || result.session_generation != es.s.view_generation
        || result.session_generation == ~(0::u64) || result.query_operation != es.s.queries.operation_sequence
        || result.query_revision != es.s.queries.revision) { ret res[*Buffer, fail.Fail].err{fail.message("editor analysis view has expired")}; }
    val b: *Buffer = slot_live(es, result.file);
    if (b == nil) { ret res[*Buffer, fail.Fail].err{fail.message("editor analysis buffer has retired")}; }
    val file: opt[*lang_source.SourceFile] = lang_source.get(?es.s.sources, result.file);
    if (sel file.none)                                { ret res[*Buffer, fail.Fail].err{fail.message("editor analysis source has changed")}; }
    if (!file.some.present)                           { ret res[*Buffer, fail.Fail].err{fail.message("editor analysis source has changed")}; }
    if (file.some.revision != result.source_revision) { ret res[*Buffer, fail.Fail].err{fail.message("editor analysis source has changed")}; }
    ret res[*Buffer, fail.Fail].ok{b};
}

# the AST of the analyzed buffer. raw products borrow the current serial view: a later
# open, update, close, dnit, analyze, build or query operation expires the view, after
# which every checked accessor answers a Fail and a pointer already obtained must not be
# dereferenced. a rejected parse can still expose a partial AST; a fatal acquisition
# exposes nil. a parse_text result owns its tree, which stays valid until analysis_dnit
# reached only by mach-lsp
# ---
# result: the envelope, whose EditorSession and Session must both still exist unless
#         parse_text made it
# ret:    the borrowed AST, or the expiry failure
pub fun ast_of(result: *AnalysisResult) res[*ast.Ast, fail.Fail] {
    if (result.tree != nil) { ret res[*ast.Ast, fail.Fail].ok{result.tree}; }
    val buffer: res[*Buffer, fail.Fail] = result_buffer(result);
    if (sel buffer.err) { ret res[*ast.Ast, fail.Fail].err{buffer.err}; }
    ret res[*ast.Ast, fail.Fail].ok{buffer.ok.a};
}

# the resolve product, under ast_of's view rules; the phase must be at least
# PHASE_RESOLVE. symbols may be SYMBOL_NIL or SYMBOL_REJECTED and must be checked before
# indexing the symbol array
# reached only by mach-lsp
# ---
# ret: the borrowed product, or the expiry or phase failure
pub fun resolve_of(result: *AnalysisResult) res[*resolve.ResolveResult, fail.Fail] {
    if (result.tree != nil) { ret res[*resolve.ResolveResult, fail.Fail].err{fail.message("analysis did not request resolution")}; }
    val buffer: res[*Buffer, fail.Fail] = result_buffer(result);
    if (sel buffer.err)               { ret res[*resolve.ResolveResult, fail.Fail].err{buffer.err}; }
    if (result.phase < PHASE_RESOLVE) { ret res[*resolve.ResolveResult, fail.Fail].err{fail.message("analysis did not request resolution")}; }
    ret res[*resolve.ResolveResult, fail.Fail].ok{buffer.ok.rr};
}

# the sema product, under ast_of's view rules; the phase must be PHASE_SEMA
# reached only by mach-lsp
# ---
# ret: the borrowed product, or the expiry or phase failure
pub fun sema_of(result: *AnalysisResult) res[*fe_sema.SemaResult, fail.Fail] {
    if (result.tree != nil) { ret res[*fe_sema.SemaResult, fail.Fail].err{fail.message("analysis did not request type checking")}; }
    val buffer: res[*Buffer, fail.Fail] = result_buffer(result);
    if (sel buffer.err)             { ret res[*fe_sema.SemaResult, fail.Fail].err{buffer.err}; }
    if (result.phase != PHASE_SEMA) { ret res[*fe_sema.SemaResult, fail.Fail].err{fail.message("analysis did not request type checking")}; }
    ret res[*fe_sema.SemaResult, fail.Fail].ok{buffer.ok.sr};
}

fun snapshot_source(alloc: *A.Allocator, sources: *Vector[AnalysisSource], s: *session.Session, file: lang_source.FileId) err[fail.Fail] {
    val analysis_source_r: opt[*lang_source.SourceFile] = sources_find(sources, file);
    if (lang_source.file_is_nil(file)) { ret err[fail.Fail].ok{}; }
    if (sel analysis_source_r.some)    { ret err[fail.Fail].ok{}; }
    val current: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, file);
    if (sel current.none) {
        ret err[fail.Fail].err{fail.message("analysis diagnostic refers to an unavailable source version")};
    }
    if (!current.some.present) {
        ret err[fail.Fail].err{fail.message("analysis diagnostic refers to an unavailable source version")};
    }
    val copied: res[lang_source.SourceFile, lang_source.Error] = lang_source.copy_file(current.some, alloc);
    if (sel copied.err) { ret err[fail.Fail].err{fail.source_refused(copied.err)}; }
    var entry: AnalysisSource      = AnalysisSource{id: file, file: copied.ok};
    val added: res[usize, A.Error] = collections_vector.push[AnalysisSource](sources, entry);
    if (sel added.err) {
        lang_source.dnit_file(?entry.file, alloc);
        ret err[fail.Fail].err{fail.refused(added.err)};
    }
    ret err[fail.Fail].ok{};
}

# the session's diagnostics copied into an owned store at `out`, and every source version a
# location, related location or fix edit of theirs refers to copied into `sources`. `out` is set
# before any source is copied, so a failure leaves both for envelope_dnit
fun snapshot_diagnostics(alloc: *A.Allocator, s: *session.Session, out: **diagnostic.DiagnosticStore,
    sources: *Vector[AnalysisSource]) err[fail.Fail] {
    val diagnostics: res[*diagnostic.DiagnosticStore, fail.Fail] = diagnostic.snapshot_from(?s.diags, 0, alloc);
    if (sel diagnostics.err) { ret err[fail.Fail].err{diagnostics.err}; }
    @out = diagnostics.ok;
    var i: usize = 0;
    for (i < diagnostic.len(diagnostics.ok)) {
        val d:    *diagnostic.Diagnostic = ?diagnostics.ok.items.data[i];
        val main: err[fail.Fail]         = snapshot_source(alloc, sources, s, d.loc.file);
        if (sel main.err) { ret main; }
        var j: usize = 0;
        for (j < d.related.len) {
            val related: err[fail.Fail] = snapshot_source(alloc, sources, s, d.related.data[j].loc.file);
            if (sel related.err) { ret related; }
            j = j + 1;
        }
        j = 0;
        for (j < d.fixes.len) {
            var k: usize = 0;
            for (k < d.fixes.data[j].edits.len) {
                val edit: err[fail.Fail] = snapshot_source(alloc, sources, s, d.fixes.data[j].edits.data[k].loc.file);
                if (sel edit.err) { ret edit; }
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# an envelope's owned message and failure: the failure's text, else the internal standing's, is
# copied into `message`, an internal standing then reads that copy, and the failure's places are
# copied beside it. envelope_dnit's caller releases `message` with str_free and `kept` with
# fail.places_dnit
fun snapshot_failure(alloc: *A.Allocator, status: *fail.PhaseStatus, failure: opt[fail.Fail], message: *str,
    kept: *opt[fail.Fail]) err[fail.Fail] {
    var text:        str      = "";
    val status_text: opt[str] = fail.internal_text(@status);
    if (sel status_text.some) { text = status_text.some; }
    if (sel failure.some) {
        val failure_text: opt[str] = fail.text(failure.some);
        if (sel failure_text.some) { text = failure_text.some; }
    }
    val owned_message: res[str, types_string.StrError] = str_copy(alloc, text);
    if (sel owned_message.err) { ret err[fail.Fail].err{fail.str_refused(owned_message.err)}; }
    @message = owned_message.ok;
    if (sel status_text.some) { status.kind = fail.PhaseKind.internal{@message}; }
    if (sel failure.some) {
        val owned: res[fail.Fail, A.Error] = fail.places_retain(alloc, fail.with_text(failure.some, @message));
        if (sel owned.err) { ret err[fail.Fail].err{fail.refused(owned.err)}; }
        @kept = opt[fail.Fail].some{owned.ok};
    }
    ret err[fail.Fail].ok{};
}

fun target_snapshot(env: *comptime.ComptimeEnv) AnalysisTarget {
    ret AnalysisTarget{
        os:           env.target.os_id, arch: env.target.arch_id, abi: env.target.abi_id,
        mode:         env.build.mode_id, pie: env.build.pie, pointer_width: env.target.pointer_width,
        vector_bits:  env.target.vector_bits, register_bits: env.target.register_bits, has_float: env.target.has_float,
        va_list_size: env.target.va_list_size, va_list_align: env.target.va_list_align
    };
}

fun snapshot_analysis(es: *EditorSession, req: *AnalysisRequest, status: fail.PhaseStatus,
    failure: opt[fail.Fail]) res[AnalysisResult, fail.Fail] {
    var result: AnalysisResult = AnalysisResult{
        alloc:  es.alloc, editor: es, session: es.s, file: req.file, phase: req.phase,
        status: status, failure: failure, sources: collections_vector.init[AnalysisSource](es.alloc)
    };
    var complete: bool = false;
    fin {
        if (!complete) { analysis_dnit(?result); }
    }
    val copied: err[fail.Fail] = snapshot_source(es.alloc, ?result.sources, es.s, req.file);
    if (sel copied.err) { ret res[AnalysisResult, fail.Fail].err{copied.err}; }
    val diagnosed: err[fail.Fail] = snapshot_diagnostics(es.alloc, es.s, ?result.diagnostics, ?result.sources);
    if (sel diagnosed.err) { ret res[AnalysisResult, fail.Fail].err{diagnosed.err}; }
    val b: *Buffer = slot_live(es, req.file);
    if (b.context_ready) {
        result.target           = target_snapshot(?b.ctx.env);
        result.target_available = true;
    }
    if (es.proj_loaded) {
        val config: res[query.QueryOutput, fail.Fail] = context.capture_build_config(?es.proj, es.alloc);
        if (sel config.err) { ret res[AnalysisResult, fail.Fail].err{config.err}; }
        result.configuration = config.ok;
        val root: res[str, types_string.StrError] = str_copy(es.alloc, es.proj_root);
        if (sel root.err) { ret res[AnalysisResult, fail.Fail].err{fail.str_refused(root.err)}; }
        result.project_root = root.ok;
        var mid: u32 = 0;
        for (mid < project.module_count(?es.proj)) {
            if (lang_source.file_same(project.module_at(?es.proj, mid).file_id, req.file)) {
                result.target           = target_snapshot(?project.module_at(?es.proj, mid).load.ctx.env);
                result.target_available = true;
                brk;
            }
            mid = mid + 1;
        }
    }
    var profile_name: str = "";
    if (es.proj_loaded) {
        val name: opt[str] = intern.get(?es.s.interner, es.proj.config.profile);
        if (sel name.none) { ret res[AnalysisResult, fail.Fail].err{fail.message("analysis profile has no stable spelling")}; }
        profile_name = name.some;
    }
    val profile: res[str, types_string.StrError] = str_copy(es.alloc, profile_name);
    if (sel profile.err) { ret res[AnalysisResult, fail.Fail].err{fail.str_refused(profile.err)}; }
    result.profile = profile.ok;
    val failed: err[fail.Fail] = snapshot_failure(es.alloc, ?result.status, failure, ?result.message, ?result.failure);
    if (sel failed.err) { ret res[AnalysisResult, fail.Fail].err{failed.err}; }
    val analysis_source_r: opt[*lang_source.SourceFile] = analysis_source(?result, req.file);
    if (sel analysis_source_r.none) { ret res[AnalysisResult, fail.Fail].err{fail.message("an element is absent where the snapshot analysis expected it")}; }
    result.source_revision    = analysis_source_r.some.revision;
    result.view_generation    = es.view_generation;
    result.session_generation = es.s.view_generation;
    result.query_operation    = es.s.queries.operation_sequence;
    result.query_revision     = es.s.queries.revision;
    complete                  = true;
    ret res[AnalysisResult, fail.Fail].ok{result};
}

# run the frontend over an open buffer to the requested phase. ok means the owned envelope
# was produced; read result.status for the phase's standing and result.failure for an
# operational project failure. the diagnostics own their source versions; the raw
# products borrow this serial session view. request strings and vectors are borrowed only
# during the call. an envelope that cannot be allocated is an operational failure owned
# by the editor session, released with fail_dnit
# ---
# es:  the editor session
# req: the request; its file must be open and its phase at most PHASE_SEMA
# ret: the owned result, released with analysis_dnit, or the operational failure
pub fun analyze(es: *EditorSession, req: *AnalysisRequest) res[AnalysisResult, fail.Fail] {
    if (req == nil || req.phase > PHASE_SEMA || slot_live(es, req.file) == nil) {
        ret res[AnalysisResult, fail.Fail].err{fail_owned(es, fail.user(diagnostic_kind.EDITOR_NO_BUFFER, "analysis requires an open buffer and a valid phase"))};
    }
    if (es.active_request != nil || es.s.queries.operation_active || es.s.queries.presentation_pending) {
        ret res[AnalysisResult, fail.Fail].err{fail_owned(es, fail.message("editor analysis cannot nest active query use"))};
    }
    if (es.view_generation == ~(0::u64) || es.s.view_generation == ~(0::u64)) {
        ret res[AnalysisResult, fail.Fail].err{fail_owned(es, fail.message("editor view generation exhausted"))};
    }
    es.view_generation = es.view_generation + 1;
    views_drop(es);
    es.active_request    = req;
    es.operation_failure = opt[fail.Fail].none{};
    fin {
        es.active_request    = nil;
        es.operation_failure = opt[fail.Fail].none{};
    }
    var work: err[fail.Fail] = err[fail.Fail].ok{};
    if (req.phase == PHASE_PARSE) {
        val parsed: res[*ast.Ast, fail.Fail] = parse_buffer(es, req.file);
        if (sel parsed.err) { work = err[fail.Fail].err{parsed.err}; }
    }
    or (req.phase == PHASE_RESOLVE) {
        val resolved: res[*resolve.ResolveResult, fail.Fail] = resolve_buffer(es, req.file);
        if (sel resolved.err) { work = err[fail.Fail].err{resolved.err}; }
    }
    or {
        val analyzed: res[*fe_sema.SemaResult, fail.Fail] = analyze_buffer(es, req.file);
        if (sel analyzed.err) { work = err[fail.Fail].err{analyzed.err}; }
    }
    val b: *Buffer = slot_live(es, req.file);
    if (b.owned && req.phase == PHASE_PARSE) {
        val seeded:  err[fail.Fail] = ctx_seed(es, b);
        val work_ok: bool           = sel work.ok;
        if (work_ok) { work = seeded; }
    }
    var status: fail.PhaseStatus = b.parse_status;
    if (req.phase >= PHASE_RESOLVE && b.rr != nil) { fail.merge(?status, b.rr.status); }
    if (req.phase == PHASE_SEMA && b.sr != nil)    { fail.merge(?status, b.sr.status); }
    # a buffer the project analyzed stands with its project: the tolerant load
    # keeps a rejected project, so its standing is read here, not from a load failure
    if (!b.owned && es.proj_loaded) { fail.merge(?status, frontend.frontend_status(?es.proj)); }
    var failure: opt[fail.Fail] = es.operation_failure;
    if (sel work.err) {
        val failure_none: bool = sel failure.none;
        if (failure_none) { failure = opt[fail.Fail].some{work.err}; }
        if (sel failure.some) {
            val f: fail.Fail = failure.some;
            if (sel f.reported || sel f.user) { fail.reject(?status); }
            or                                { fail.internal(?status, fail.describe(f)); }
        }
    }
    if (es.s.view_generation == ~(0::u64)) {
        ret res[AnalysisResult, fail.Fail].err{fail_owned(es, fail.message("editor view generation exhausted"))};
    }
    val result: res[AnalysisResult, fail.Fail] = snapshot_analysis(es, req, status, failure);
    if (sel result.err) {
        ret res[AnalysisResult, fail.Fail].err{fail_owned(es, result.err)};
    }
    ret res[AnalysisResult, fail.Fail].ok{result.ok};
}

# the build selection a project snapshot is analyzed under, over mach's own for the root; an
# empty field takes mach's choice for its axis, as the command line does when it names none
# reached only by mach-lsp
# ---
# artifact: the declared artifact name, or ""
# target:   the declared target name, or ""
# profile:  the declared profile name, or ""
pub rec ProjectSelection {
    artifact: str;
    target:   str;
    profile:  str;
}

# an open buffer's text, which a snapshot reads in place of the file at `path`
# reached only by mach-lsp
pub rec ProjectBuffer {
    path: str;
    text: str;
}

# what one project_open call asks for; every string and the buffer array are borrowed only
# during the call
# reached only by mach-lsp
# ---
# root:         the project's directory, the one holding its mach.toml
# phase:        how far the frontend runs, PHASE_PARSE, PHASE_RESOLVE or PHASE_SEMA
# selection:    the overrides of mach's selection, empty for none
# buffers:      the open buffers, nil with buffer_count 0
# buffer_count: how many buffers
pub rec ProjectRequest {
    root:         str;
    phase:        AnalysisPhase;
    selection:    ProjectSelection;
    buffers:      *ProjectBuffer;
    buffer_count: u32;
}

# the whole project at a root analyzed for a tool, every artifact's closure with the open
# buffers' modules beside it. the envelope fields are owned as AnalysisResult's are; the module
# products borrow the Session the snapshot was opened in and expire with its next query
# operation. release exactly once with project_dnit, never copy it as a second owner
# reached only by mach-lsp
# ---
# alloc:       the Session's allocator, which owns every field below
# session:     the Session the snapshot was opened in and whose overlays it holds
# phase:       the phase it was opened to
# loaded:      whether `project` holds a project; false when the project could not be loaded
# status:      the frontend's standing over every module, accepted, rejected or internal
# failure:     the operational failure that kept the project from loading, absent when it loaded
# message:     the failure's text, or the internal standing's, "" for neither
# diagnostics: the owned store, with related locations, fix edits and lost-diagnostic evidence
# sources:     the owned source versions every diagnostic location refers to
# root:        the owned copy of the request's root, which the loaded project's request borrows
# key:         the owned copies of the request's selection strings, which the loaded project borrows
pub rec ProjectSnapshot {
    alloc:           *A.Allocator;
    session:         *session.Session;
    phase:           AnalysisPhase;
    loaded:          bool;
    project:         project.Project;
    overlays:        Vector[str];
    query_operation: u64;
    query_revision:  query.Revision;
    status:          fail.PhaseStatus;
    failure:         opt[fail.Fail];
    message:         str;
    diagnostics:     *diagnostic.DiagnosticStore;
    sources:         Vector[AnalysisSource];
    root:            str;
    key:             ProjKey;
}

# a request for the project at `root` to `phase`, on mach's own selection and with no buffers
# reached only by mach-lsp
pub fun project_request(root: str, phase: AnalysisPhase) ProjectRequest {
    ret ProjectRequest{root: root, phase: phase, selection: ProjectSelection{artifact: "", target: "", profile: ""}};
}

# analyze the project at a root on the cell mach selects for it, over the union of its artifacts,
# with each open buffer's text read in place of its file. the request is composed from the
# manifest and the selection as `mach check` composes it, so a tool never restates a build. the
# Session is any the caller owns, not one an EditorSession serves, so a snapshot can be opened
# off the thread that serves open buffers; it holds one snapshot at a time. ok means the owned
# envelope was produced: read status for the standing and failure for a project that could not
# load. the buffers' overlays stay set on the Session until project_dnit
# reached only by mach-lsp
# ---
# s:   the Session; it must outlive the snapshot
# req: the request
# ret: the snapshot, released with project_dnit, or the operational failure, owned through the
#      Session's allocator and released with fail.dnit
pub fun project_open(s: *session.Session, req: *ProjectRequest) res[ProjectSnapshot, fail.Fail] {
    if (req == nil || req.phase > PHASE_SEMA || str_len(req.root) == 0 || (req.buffer_count > 0 && req.buffers == nil)) {
        ret res[ProjectSnapshot, fail.Fail].err{fail.message("project analysis requires a root, a valid phase and its buffers")};
    }
    if (s.queries.operation_active || s.queries.presentation_pending) {
        ret res[ProjectSnapshot, fail.Fail].err{fail.message("project analysis cannot nest active query use")};
    }
    var snap: ProjectSnapshot = ProjectSnapshot{
        alloc:    s.alloc, session: s, phase: req.phase, status: fail.accepted(),
        overlays: collections_vector.init[str](s.alloc), sources: collections_vector.init[AnalysisSource](s.alloc)
    };
    var complete: bool = false;
    fin {
        # a release refused on top of a refused open leaves the overlays to the Session's teardown
        if (!complete) { project_dnit(?snap); }
    }
    var i: u32 = 0;
    for (i < req.buffer_count) {
        val held: err[fail.Fail] = snapshot_overlay(?snap, req.buffers[i].path, req.buffers[i].text);
        if (sel held.err) { ret res[ProjectSnapshot, fail.Fail].err{snapshot_fail(s, held.err)}; }
        i = i + 1;
    }
    val rooted: res[str, types_string.StrError] = str_copy(s.alloc, req.root);
    if (sel rooted.err) { ret res[ProjectSnapshot, fail.Fail].err{fail.str_refused(rooted.err)}; }
    snap.root = rooted.ok;
    val captured: err[fail.Fail] = proj_key_capture(s.alloc, ?req.selection, ?snap.key);
    if (sel captured.err) { ret res[ProjectSnapshot, fail.Fail].err{snapshot_fail(s, captured.err)}; }
    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(s.alloc);

    var failure: opt[fail.Fail] = opt[fail.Fail].none{};
    val work:    err[fail.Fail] = snapshot_load(?snap, req);
    if (sel work.err) {
        val f: fail.Fail = work.err;
        failure = opt[fail.Fail].some{f};
        if (sel f.reported || sel f.user) { fail.reject(?snap.status); }
        or                                { fail.internal(?snap.status, fail.describe(f)); }
    }
    if (snap.loaded) { fail.merge(?snap.status, frontend.frontend_status(?snap.project)); }
    val diagnosed: err[fail.Fail] = snapshot_diagnostics(s.alloc, s, ?snap.diagnostics, ?snap.sources);
    if (sel diagnosed.err) { ret res[ProjectSnapshot, fail.Fail].err{snapshot_fail(s, diagnosed.err)}; }
    val failed: err[fail.Fail] = snapshot_failure(s.alloc, ?snap.status, failure, ?snap.message, ?snap.failure);
    if (sel failed.err) { ret res[ProjectSnapshot, fail.Fail].err{snapshot_fail(s, failed.err)}; }
    snap.query_operation = s.queries.operation_sequence;
    snap.query_revision  = s.queries.revision;
    complete             = true;
    ret res[ProjectSnapshot, fail.Fail].ok{snap};
}

fun snapshot_fail(s: *session.Session, f: fail.Fail) fail.Fail {
    val kept: res[fail.Fail, A.Error] = fail.retain(s.alloc, f);
    if (sel kept.err) { ret fail.message(OOM_FAIL_MESSAGE); }
    ret kept.ok;
}

# set a buffer's overlay and record its path for project_dnit; a path given twice keeps the later text
fun snapshot_overlay(snap: *ProjectSnapshot, path: str, text: str) err[fail.Fail] {
    val cleaned: res[str, A.Error] = types_path.clean(snap.alloc, path);
    if (sel cleaned.err) { ret err[fail.Fail].err{fail.refused(cleaned.err)}; }
    var recorded: bool  = false;
    var i:        usize = 0;
    for (i < snap.overlays.len && !recorded) {
        recorded = str_equals(snap.overlays.data[i], cleaned.ok);
        i        = i + 1;
    }
    if (recorded) { str_free(snap.alloc, cleaned.ok); }
    or {
        val added: res[usize, A.Error] = collections_vector.push[str](?snap.overlays, cleaned.ok);
        if (sel added.err) {
            str_free(snap.alloc, cleaned.ok);
            ret err[fail.Fail].err{fail.refused(added.err)};
        }
    }
    ret session.set_overlay(snap.session, path, text);
}

# load the manifest, compose the request as `mach check` does and analyze the root's union
fun snapshot_load(snap: *ProjectSnapshot, req: *ProjectRequest) err[fail.Fail] {
    val s:    *session.Session                  = snap.session;
    val read: res[manifest.Manifest, fail.Fail] = driver.load_manifest(s, snap.root);
    if (sel read.err) { ret err[fail.Fail].err{read.err}; }
    var m:              manifest.Manifest = read.ok;
    val manifest_alloc: *A.Allocator      = s.build_alloc;
    fin { manifest.dnit(?m, manifest_alloc); }

    var owned:    ProjectSelection                     = ProjectSelection{artifact: snap.key.artifact, target: snap.key.target, profile: snap.key.profile};
    val composed: res[request.BuildRequest, fail.Fail] = project_build(s, ?m, snap.root, ?owned);
    if (sel composed.err) { ret err[fail.Fail].err{composed.err}; }
    var build: request.BuildRequest = composed.ok;
    fin { project_build_dnit(?build); }

    val id_text:  opt[str] = intern.get(?s.interner, m.id);
    val src_text: opt[str] = intern.get(?s.interner, m.src);
    if (sel id_text.none)  { ret err[fail.Fail].err{fail.message("editor: manifest project id or src dir not interned")}; }
    if (sel src_text.none) { ret err[fail.Fail].err{fail.message("editor: manifest project id or src dir not interned")}; }
    var roots: *intern.StrId = nil;
    if (req.buffer_count > 0) {
        val allocated: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](s.alloc, req.buffer_count::usize);
        if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
        roots = allocated.ok;
    }
    fin {
        if (roots != nil) { A.deallocate[intern.StrId](s.alloc, roots, req.buffer_count::usize); }
    }
    var count: u32 = 0;
    var i:     u32 = 0;
    for (i < req.buffer_count) {
        val name: res[opt[intern.StrId], fail.Fail] = buffer_root_fqn(s.alloc, ?s.interner, req.buffers[i].path, req.root,
            id_text.some, src_text.some);
        if (sel name.err) { ret err[fail.Fail].err{name.err}; }
        if (sel name.ok.some) {
            roots[count] = name.ok.some;
            count        = count + 1;
        }
        i = i + 1;
    }

    val analyzed: res[project.Project, fail.Fail] = root_analyze(s, ?m, snap.root, ?build, roots, count, snap.phase);
    if (sel analyzed.err) { ret err[fail.Fail].err{analyzed.err}; }
    snap.project = analyzed.ok;
    snap.loaded  = true;
    ret err[fail.Fail].ok{};
}

# the request a project is analyzed under in the editor, composed from its manifest and a selection
# as `mach check` composes it; the one composition an open buffer and a snapshot share. the
# selection's strings are borrowed by the request. release it with project_build_dnit
fun project_build(s: *session.Session, m: *manifest.Manifest, root: str, chosen: *ProjectSelection) res[request.BuildRequest, fail.Fail] {
    var overrides: request.Overrides                    = request.overrides_init(s.alloc);
    val composed:  res[request.BuildRequest, fail.Fail] = request.compose(s.alloc, ?s.interner, m, ?overrides, root,
        request.GOAL_CHECK, chosen.profile);
    if (sel composed.err) { ret composed; }
    var build: request.BuildRequest = composed.ok;
    build.artifact = chosen.artifact;
    build.target   = chosen.target;
    ret res[request.BuildRequest, fail.Fail].ok{build};
}

fun project_build_dnit(build: *request.BuildRequest) {
    collections_vector.dnit[request.LinkToken](?build.link_tokens);
    collections_vector.dnit[str](?build.lib_dirs);
}

# release a snapshot: its project, the overlays it set on its Session and everything it owns. a
# zero snapshot is a no-op. check the result: a failure leaves the snapshot intact for a retry
# reached only by mach-lsp
# ---
# snap: the snapshot; zeroed on success so a second call is a no-op
pub fun project_dnit(snap: *ProjectSnapshot) err[fail.Fail] {
    if (snap.alloc == nil) { ret err[fail.Fail].ok{}; }
    var removals: Vector[session.PreparedOverlay] = collections_vector.init[session.PreparedOverlay](snap.alloc);
    fin {
        var j: usize = 0;
        for (j < removals.len) {
            session.discard_overlay(?removals.data[j]);
            j = j + 1;
        }
        collections_vector.dnit[session.PreparedOverlay](?removals);
    }
    var i: usize = 0;
    for (i < snap.overlays.len) {
        val prepared: res[session.PreparedOverlay, fail.Fail] = session.prepare_overlay(snap.session, snap.overlays.data[i], nil, true);
        if (sel prepared.err) { ret err[fail.Fail].err{prepared.err}; }
        var overlay: session.PreparedOverlay = prepared.ok;
        val added:   res[usize, A.Error]     = collections_vector.push[session.PreparedOverlay](?removals, overlay);
        if (sel added.err) {
            session.discard_overlay(?overlay);
            ret err[fail.Fail].err{fail.refused(added.err)};
        }
        i = i + 1;
    }
    if (snap.loaded) { project.dnit_project(?snap.project); }
    proj_key_free(snap.alloc, ?snap.key);
    str_free(snap.alloc, snap.root);
    # a removal moves the last overlay into its place, so the highest index goes first
    sort.sort_by[session.PreparedOverlay](removals.data, removals.len, removal_order);
    i = 0;
    for (i < removals.len) {
        session.commit_overlay(?removals.data[i]);
        i = i + 1;
    }
    i = 0;
    for (i < snap.overlays.len) {
        str_free(snap.alloc, snap.overlays.data[i]);
        i = i + 1;
    }
    collections_vector.dnit[str](?snap.overlays);
    envelope_dnit(snap.alloc, snap.diagnostics, ?snap.sources);
    str_free(snap.alloc, snap.message);
    if (sel snap.failure.some) { fail.places_dnit(snap.alloc, snap.failure.some); }
    @snap = ProjectSnapshot{};
    ret err[fail.Fail].ok{};
}

# how many modules the snapshot loaded; module indices run from 0 below it
# reached only by mach-lsp
pub fun project_module_count(snap: *ProjectSnapshot) u32 {
    if (snap.alloc == nil || !snap.loaded) { ret 0; }
    ret project.module_count(?snap.project);
}

# the module the snapshot loaded from the file at `path`, none when it loaded none
# reached only by mach-lsp
pub fun project_module_by_path(snap: *ProjectSnapshot, path: str) opt[u32] {
    if (snap.alloc == nil || !snap.loaded) { ret opt[u32].none{}; }
    val cleaned: res[str, A.Error] = types_path.clean(snap.alloc, path);
    if (sel cleaned.err) { ret opt[u32].none{}; }
    fin { str_free(snap.alloc, cleaned.ok); }
    var i: u32 = 0;
    for (i < project.module_count(?snap.project)) {
        val file: opt[*lang_source.SourceFile] = lang_source.get(?snap.session.sources, project.module_at(?snap.project, i).file_id);
        if (sel file.some) {
            if (str_equals(file.some.path, cleaned.ok)) { ret opt[u32].some{i}; }
        }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# the module the snapshot loaded under the fully qualified name `fqn`, none when it loaded none
# reached only by mach-lsp
pub fun project_module_by_fqn(snap: *ProjectSnapshot, fqn: str) opt[u32] {
    if (snap.alloc == nil || !snap.loaded) { ret opt[u32].none{}; }
    val mid: session.ModuleId = project.module_named(?snap.project, fqn);
    if (module.is_nil(mid)) { ret opt[u32].none{}; }
    ret opt[u32].some{mid::u32};
}

fun snapshot_module(snap: *ProjectSnapshot, index: u32) res[*project.ModuleEntry, fail.Fail] {
    if (snap.alloc == nil || !snap.loaded) { ret res[*project.ModuleEntry, fail.Fail].err{fail.message("project snapshot holds no project")}; }
    if (index >= project.module_count(?snap.project)) {
        ret res[*project.ModuleEntry, fail.Fail].err{fail.message("project snapshot has no module at that index")};
    }
    ret res[*project.ModuleEntry, fail.Fail].ok{project.module_at(?snap.project, index)};
}

# a module's fully qualified name, borrowed from the snapshot's Session
# reached only by mach-lsp
pub fun project_module_fqn(snap: *ProjectSnapshot, index: u32) res[str, fail.Fail] {
    val m: res[*project.ModuleEntry, fail.Fail] = snapshot_module(snap, index);
    if (sel m.err) { ret res[str, fail.Fail].err{m.err}; }
    ret res[str, fail.Fail].ok{intern.text(?snap.session.interner, m.ok.fqn)};
}

# the source file a module was read from, whose version the snapshot analyzed
# reached only by mach-lsp
pub fun project_module_file(snap: *ProjectSnapshot, index: u32) res[lang_source.FileId, fail.Fail] {
    val m: res[*project.ModuleEntry, fail.Fail] = snapshot_module(snap, index);
    if (sel m.err) { ret res[lang_source.FileId, fail.Fail].err{m.err}; }
    ret res[lang_source.FileId, fail.Fail].ok{m.ok.file_id};
}

# a module whose products are still the ones the snapshot's analysis published
fun snapshot_view(snap: *ProjectSnapshot, index: u32) res[*project.ModuleEntry, fail.Fail] {
    val m: res[*project.ModuleEntry, fail.Fail] = snapshot_module(snap, index);
    if (sel m.err) { ret m; }
    if (snap.query_operation != snap.session.queries.operation_sequence || snap.query_revision != snap.session.queries.revision) {
        ret res[*project.ModuleEntry, fail.Fail].err{fail.message("project snapshot view has expired")};
    }
    ret m;
}

# a module's AST, under ast_of's rules over the snapshot's Session; nil when the module has none
# reached only by mach-lsp
pub fun project_ast_of(snap: *ProjectSnapshot, index: u32) res[*ast.Ast, fail.Fail] {
    val m: res[*project.ModuleEntry, fail.Fail] = snapshot_view(snap, index);
    if (sel m.err) { ret res[*ast.Ast, fail.Fail].err{m.err}; }
    val shown: opt[frontend.ParsedModule] = frontend.parsed(?snap.project, m.ok);
    if (sel shown.none) { ret res[*ast.Ast, fail.Fail].ok{nil}; }
    ret res[*ast.Ast, fail.Fail].ok{shown.some.a};
}

# a module's resolve product, under resolve_of's rules; nil when the module did not reach resolution
# reached only by mach-lsp
pub fun project_resolve_of(snap: *ProjectSnapshot, index: u32) res[*resolve.ResolveResult, fail.Fail] {
    val m: res[*project.ModuleEntry, fail.Fail] = snapshot_view(snap, index);
    if (sel m.err)                  { ret res[*resolve.ResolveResult, fail.Fail].err{m.err}; }
    if (snap.phase < PHASE_RESOLVE) { ret res[*resolve.ResolveResult, fail.Fail].err{fail.message("analysis did not request resolution")}; }
    ret res[*resolve.ResolveResult, fail.Fail].ok{frontend.resolved(?snap.project, m.ok)};
}

# a module's sema product, under sema_of's rules; nil when the module was not type checked
# reached only by mach-lsp
pub fun project_sema_of(snap: *ProjectSnapshot, index: u32) res[*fe_sema.SemaResult, fail.Fail] {
    val m: res[*project.ModuleEntry, fail.Fail] = snapshot_view(snap, index);
    if (sel m.err)                { ret res[*fe_sema.SemaResult, fail.Fail].err{m.err}; }
    if (snap.phase != PHASE_SEMA) { ret res[*fe_sema.SemaResult, fail.Fail].err{fail.message("analysis did not request type checking")}; }
    ret res[*fe_sema.SemaResult, fail.Fail].ok{frontend.typed(?snap.project, m.ok)};
}

# a module's own phase standing, as the snapshot's analysis left it
# reached only by mach-lsp
pub fun project_module_status(snap: *ProjectSnapshot, index: u32) res[fail.PhaseStatus, fail.Fail] {
    val m: res[*project.ModuleEntry, fail.Fail] = snapshot_view(snap, index);
    if (sel m.err) { ret res[fail.PhaseStatus, fail.Fail].err{m.err}; }
    ret res[fail.PhaseStatus, fail.Fail].ok{frontend.module_status(?snap.project, m.ok)};
}

# whether a module belongs to the project the snapshot was opened for, not to one of its dependencies
# reached only by mach-lsp
pub fun project_module_is_root(snap: *ProjectSnapshot, index: u32) res[bool, fail.Fail] {
    val m: res[*project.ModuleEntry, fail.Fail] = snapshot_module(snap, index);
    if (sel m.err) { ret res[bool, fail.Fail].err{m.err}; }
    ret res[bool, fail.Fail].ok{m.ok.load.home.root};
}

# an editor facade over a caller-owned Session, borrowed for serial use; neither may move
# while the other holds its address, and there is no concurrent request support. tear
# down with dnit before the Session
# ---
# s: the Session and its allocator, both owned by the caller
pub fun init(s: *session.Session) EditorSession {
    var es: EditorSession;
    es.s                 = s;
    es.alloc             = s.alloc;
    es.buffers           = nil;
    es.buf_len           = 0;
    es.view_generation   = 1;
    es.active_request    = nil;
    es.operation_failure = opt[fail.Fail].none{};

    es.proj_loaded       = false;
    es.proj_root         = nil;
    es.proj_dirty        = false;
    es.proj_edited       = collections_vector.init[lang_source.FileId](s.alloc);
    es.proj_loads        = 0;
    es.proj_refreshes    = 0;
    es.proj_phase        = driver.FRONTEND_SEMA;
    es.proj_key.valid    = false;
    es.proj_key.target   = nil;
    es.proj_key.profile  = nil;
    es.proj_key.artifact = nil;
    es.proj_roots        = nil;
    es.proj_root_count   = 0;
    es.proj_root_cap     = 0;
    es.root_retainers    = collections_vector.init[RootRetainer](s.alloc);
    ret es;
}

# release an editor session and every buffer it holds; a nil session holds nothing
fun destroy(es: *EditorSession) {
    if (es == nil) { ret; }
    collections_vector.dnit[lang_source.FileId](?es.proj_edited);
    if (es.buffers != nil && es.buf_len > 0) {
        var i: u32 = 0;
        for (i < es.buf_len) {
            buffer_free(es, ?es.buffers[i]);
            i = i + 1;
        }
        A.deallocate[Buffer](es.alloc, es.buffers, es.buf_len::usize);
    }
    es.buffers = nil;
    es.buf_len = 0;

    proj_teardown(es);
    if (es.proj_root != nil) {
        str_free(es.alloc, es.proj_root);
        es.proj_root = nil;
    }
    if (es.proj_roots != nil && es.proj_root_cap > 0) {
        A.deallocate[intern.StrId](es.alloc, es.proj_roots, es.proj_root_cap::usize);
    }
    es.proj_roots      = nil;
    es.proj_root_count = 0;
    es.proj_root_cap   = 0;
    var i: usize = 0;
    for (i < es.root_retainers.len) {
        str_free(es.alloc, es.root_retainers.data[i].root);
        i = i + 1;
    }
    collections_vector.dnit[RootRetainer](?es.root_retainers);
}

# register a buffer's text under a path and return its FileId
# the text is loaded into the session SourceMap and set as the overlay for path, so a
# project load reads the buffer instead of the file on disk; marks the project dirty
# ---
# es:   the editor session
# path: the buffer's path; used to find the enclosing project and as the overlay key
# text: the buffer's full text
# ret:  the FileId every other entry takes, or the SourceMap, slot, or overlay error
pub fun open(es: *EditorSession, path: str, text: str) res[lang_source.FileId, fail.Fail] {
    if (es.s.queries.operation_active || es.s.queries.presentation_pending) {
        ret res[lang_source.FileId, fail.Fail].err{fail.message("cannot change an editor buffer during query use")};
    }
    if (es.view_generation == ~(0::u64))   { ret res[lang_source.FileId, fail.Fail].err{fail.message("editor view generation exhausted")}; }
    if (str_len(text) > 0xFFFFFFFF::usize) { ret res[lang_source.FileId, fail.Fail].err{fail.message("source input exceeds the query byte extent")}; }
    val overlay_r: res[session.PreparedOverlay, fail.Fail] = session.prepare_overlay(es.s, path, text, false);
    if (sel overlay_r.err) {
        ret res[lang_source.FileId, fail.Fail].err{overlay_r.err};
    }
    var overlay: session.PreparedOverlay = overlay_r.ok;
    fin { session.discard_overlay(?overlay); }
    val source_r: res[lang_source.PreparedLoad, lang_source.Error] = lang_source.prepare_load(?es.s.sources, ?es.s.interner, overlay.key, text);
    if (sel source_r.err) {
        ret res[lang_source.FileId, fail.Fail].err{fail.source_refused(source_r.err)};
    }
    var prepared: lang_source.PreparedLoad = source_r.ok;
    fin { lang_source.discard_load(?prepared); }
    val reserved: res[u32, fail.Fail] = slot_reserve(es, prepared.id);
    if (sel reserved.err) { ret res[lang_source.FileId, fail.Fail].err{reserved.err}; }
    val index:   u32  = reserved.ok;
    val fresh:   bool = !es.buffers[index].in_use;
    val changed: bool = prepared.changed || overlay.changed || fresh;
    if (changed && !fresh) {
        val room: res[usize, A.Error] = collections_vector.reserve[lang_source.FileId](?es.proj_edited, 1);
        if (sel room.err) { ret res[lang_source.FileId, fail.Fail].err{fail.refused(room.err)}; }
    }
    val input: err[fail.Fail] = query.set_input(?es.s.queries, ?session.FILE_TEXT, lang_source.file_index(prepared.id)::u64, text::*u8, str_len(text)::u32);
    if (sel input.err) { ret res[lang_source.FileId, fail.Fail].err{input.err}; }
    if (changed) {
        # a new buffer is a new analysis root, which the closure must be loaded with; a text
        # change to a held one is that module's alone until the load walk says otherwise, so
        # the closure stays and the next analysis refreshes the module in place
        if (fresh) { es.proj_dirty = true; }
        or         { collections_vector.push[lang_source.FileId](?es.proj_edited, prepared.id); }
        views_drop(es);
    }
    val fid: lang_source.FileId = lang_source.commit_load(?prepared);
    session.commit_overlay(?overlay);
    val b: *Buffer = ?es.buffers[index];
    if (!b.in_use) {
        @b = Buffer{file_id: fid, in_use: true, owned: true, parse_status: fail.accepted()};
    }
    if (changed) { es.view_generation = es.view_generation + 1; }
    ret res[lang_source.FileId, fail.Fail].ok{fid};
}

# replace an open buffer's text and drop its cached analysis
# ---
# es:   the editor session
# fid:  the buffer's FileId from open
# text: the new full text
# ret:  ok(true) when the text changed; ok(false) when the buffer is not open or the text
#       is identical, in which case nothing is dropped; or the SourceMap or overlay error
pub fun update(es: *EditorSession, fid: lang_source.FileId, text: str) res[bool, fail.Fail] {
    if (slot_live(es, fid) == nil) { ret res[bool, fail.Fail].ok{false}; }
    val file: opt[*lang_source.SourceFile] = lang_source.get(?es.s.sources, fid);
    if (sel file.none) { ret res[bool, fail.Fail].err{fail.message("open editor buffer has no source identity")}; }
    val generation: u64                                = es.view_generation;
    val updated:    res[lang_source.FileId, fail.Fail] = open(es, file.some.path, text);
    if (sel updated.err) { ret res[bool, fail.Fail].err{updated.err}; }
    ret res[bool, fail.Fail].ok{es.view_generation != generation};
}

fun removal_order(a: *session.PreparedOverlay, b: *session.PreparedOverlay) i64 {
    if (a.index > b.index) { ret -1; }
    if (a.index < b.index) { ret 1; }
    ret 0;
}

fun retire_buffers(es: *EditorSession, fid: lang_source.FileId, all: bool) err[fail.Fail] {
    if (es.view_generation == ~(0::u64)) { ret err[fail.Fail].err{fail.message("editor view generation exhausted")}; }
    var roots: Vector[query.QueryKey] = collections_vector.init[query.QueryKey](es.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    var overlays: Vector[session.PreparedOverlay] = collections_vector.init[session.PreparedOverlay](es.alloc);
    fin {
        var j: usize = 0;
        for (j < overlays.len) {
            session.discard_overlay(?overlays.data[j]);
            j = j + 1;
        }
        collections_vector.dnit[session.PreparedOverlay](?overlays);
    }
    var i: u32 = 0;
    for (i < es.buf_len) {
        val b: *Buffer = ?es.buffers[i];
        if (b.in_use && (all || lang_source.file_same(b.file_id, fid))) {
            val checked: err[lang_source.Error] = lang_source.prepare_release(?es.s.sources, b.file_id);
            if (sel checked.err) { ret err[fail.Fail].err{fail.source_refused(checked.err)}; }
            val get_r: opt[*lang_source.SourceFile] = lang_source.get(?es.s.sources, b.file_id);
            if (sel get_r.none) { ret err[fail.Fail].err{fail.message("an element is absent where the retire buffers expected it")}; }
            val file:      *lang_source.SourceFile                 = get_r.some;
            val overlay_r: res[session.PreparedOverlay, fail.Fail] = session.prepare_overlay(es.s, file.path, nil, true);
            if (sel overlay_r.err) { ret err[fail.Fail].err{overlay_r.err}; }
            var overlay: session.PreparedOverlay = overlay_r.ok;
            val added:   res[usize, A.Error]     = collections_vector.push[session.PreparedOverlay](?overlays, overlay);
            if (sel added.err) {
                session.discard_overlay(?overlay);
                ret err[fail.Fail].err{fail.refused(added.err)};
            }
            val rooted: res[usize, A.Error] = collections_vector.push[query.QueryKey](?roots,
                query.QueryKey{kind: ?session.FILE_TEXT, key: lang_source.file_index(b.file_id)::u64});
            if (sel rooted.err) { ret err[fail.Fail].err{fail.refused(rooted.err)}; }
        }
        i = i + 1;
    }
    if (roots.len == 0) {
        if (es.s.queries.operation_active || es.s.queries.presentation_pending) {
            ret err[fail.Fail].err{fail.message("cannot retire editor state during query use")};
        }
        views_drop(es);
        es.view_generation = es.view_generation + 1;
        ret err[fail.Fail].ok{};
    }
    sort.sort_by[session.PreparedOverlay](overlays.data, overlays.len, removal_order);
    val retired_r: res[query.PreparedRetirement, fail.Fail] = query.prepare_retirement(?es.s.queries, roots.data, roots.len);
    if (sel retired_r.err) { ret err[fail.Fail].err{retired_r.err}; }
    var retired: query.PreparedRetirement = retired_r.ok;
    fin { query.discard_retirement(?retired); }
    val valid: err[fail.Fail] = query.validate_retirement(?retired);
    if (sel valid.err) { ret valid; }
    es.proj_dirty = true;
    views_drop(es);
    val commit_retirement_r: err[fail.Fail] = query.commit_retirement(?retired);
    var j:                   usize          = 0;
    for (j < roots.len) {
        session.commit_overlay(?overlays.data[j]);
        val closed: lang_source.FileId = lang_source.file_id((roots.data[j].key)::u32);
        lang_source.release_payload(?es.s.sources, closed);
        @slot_live(es, closed) = Buffer{};
        j                      = j + 1;
    }
    es.proj_root_count = 0;
    es.view_generation = es.view_generation + 1;
    if (sel commit_retirement_r.err) { ret commit_retirement_r; }
    ret release_roots(es, false);
}

# retire every editor-owned input together and free the editor's structural state.
# check the result: a failure leaves the editor and the Session intact for a retry, and
# success leaves unrelated Session cache entries and stable source identities in place.
# destroy the Session only after this succeeds; there is no separate close-all
# ---
# es: the editor session; nil is a no-op
pub fun dnit(es: *EditorSession) err[fail.Fail] {
    if (es == nil) { ret err[fail.Fail].ok{}; }
    val retired: err[fail.Fail] = retire_buffers(es, lang_source.FILE_NIL, true);
    if (sel retired.err) { ret retired; }
    proj_teardown(es);
    val released: err[fail.Fail] = release_roots(es, true);
    if (sel released.err) { ret released; }
    destroy(es);
    ret err[fail.Fail].ok{};
}

# parse a text on its own, with no buffer, project or session: the text is copied into the
# result as its source under FILE_NIL, and lexical and syntax errors become the result's
# diagnostics. ok means the owned envelope was produced; read result.status for the parse's
# standing and result.failure for a fatal parse, whose tree is left empty. the tree is
# read with ast_of and lives until analysis_dnit, which releases the result exactly once.
# resolve_of and sema_of answer a phase failure
# reached only by mach-lsp
# ---
# alloc: owns the result; must outlive it
# text:  the source, borrowed only during the call
# ret:   the owned result, or the allocation failure
pub fun parse_text(alloc: *A.Allocator, text: str) res[AnalysisResult, fail.Fail] {
    var result: AnalysisResult = AnalysisResult{
        alloc:   alloc, file: lang_source.FILE_NIL, phase: PHASE_PARSE,
        sources: collections_vector.init[AnalysisSource](alloc)
    };
    var complete: bool = false;
    fin {
        if (!complete) { analysis_dnit(?result); }
    }
    val store: res[*diagnostic.DiagnosticStore, A.Error] = A.allocate[diagnostic.DiagnosticStore](alloc, 1);
    if (sel store.err) { ret res[AnalysisResult, fail.Fail].err{fail.refused(store.err)}; }
    result.diagnostics  = store.ok;
    @result.diagnostics = diagnostic.store_init(alloc);

    var borrowed: lang_source.SourceFile                         = lang_source.SourceFile{present: true, path: "", text: text};
    val copied:   res[lang_source.SourceFile, lang_source.Error] = lang_source.copy_file(?borrowed, alloc);
    if (sel copied.err) { ret res[AnalysisResult, fail.Fail].err{fail.source_refused(copied.err)}; }
    var entry: AnalysisSource      = AnalysisSource{id: lang_source.FILE_NIL, file: copied.ok};
    val added: res[usize, A.Error] = collections_vector.push[AnalysisSource](?result.sources, entry);
    if (sel added.err) {
        lang_source.dnit_file(?entry.file, alloc);
        ret res[AnalysisResult, fail.Fail].err{fail.refused(added.err)};
    }

    val tree: res[*ast.Ast, A.Error] = A.allocate[ast.Ast](alloc, 1);
    if (sel tree.err) { ret res[AnalysisResult, fail.Fail].err{fail.refused(tree.err)}; }
    result.tree  = tree.ok;
    @result.tree = ast.init(alloc, lang_source.FILE_NIL);

    val lexed: res[fe_lexer.TokenStream, fail.Fail] = lex_text(result.sources.data[0].file.text, alloc, lang_source.FILE_NIL, result.diagnostics);
    if (sel lexed.err) { ret res[AnalysisResult, fail.Fail].err{lexed.err}; }
    var stream: fe_lexer.TokenStream = lexed.ok;
    fin { fe_lexer.dnit(?stream, alloc); }

    val fatal:       opt[state.ParseFail] = parse_tokens(?stream, result.tree, result.diagnostics, ?result.status);
    var message:     str                  = "";
    val status_text: opt[str]             = fail.internal_text(result.status);
    if (sel status_text.some) { message = status_text.some; }
    if (sel fatal.some)       { message = fatal.some.message; }
    val owned_message: res[str, types_string.StrError] = str_copy(alloc, message);
    if (sel owned_message.err) { ret res[AnalysisResult, fail.Fail].err{fail.str_refused(owned_message.err)}; }
    result.message = owned_message.ok;
    if (sel status_text.some) { result.status.kind = fail.PhaseKind.internal{result.message}; }
    if (sel fatal.some) {
        val owned: res[fail.Fail, A.Error] = fail.places_retain(alloc, fail.with_text(state.failure(fatal.some), result.message));
        if (sel owned.err) { ret res[AnalysisResult, fail.Fail].err{fail.refused(owned.err)}; }
        result.failure = opt[fail.Fail].some{owned.ok};
    }
    complete = true;
    ret res[AnalysisResult, fail.Fail].ok{result};
}

# whether two results' trees have the same shape, as ast.same_shape compares them
# reached only by mach-lsp
# ---
# x, y: the results, each read through ast_of under its rules
# ret: whether the shapes match, or either tree's expiry failure
pub fun same_shape(x: *AnalysisResult, y: *AnalysisResult) res[bool, fail.Fail] {
    val xr: res[*ast.Ast, fail.Fail] = ast_of(x);
    if (sel xr.err) { ret res[bool, fail.Fail].err{xr.err}; }
    val yr: res[*ast.Ast, fail.Fail] = ast_of(y);
    if (sel yr.err) { ret res[bool, fail.Fail].err{yr.err}; }
    val a: *ast.Ast = xr.ok;
    val b: *ast.Ast = yr.ok;
    if (a == nil || b == nil) { ret res[bool, fail.Fail].err{fail.message("analysis has no tree")}; }
    ret res[bool, fail.Fail].ok{ast.same_shape(a, b)};
}

# whether a text is exactly one identifier token, as the lexer reads it standalone
# reached only by mach-lsp
# ---
# alloc: scratch for the lex, freed before return
# text:  the candidate, borrowed only during the call
# ret:   whether it is one identifier token, or the failure that stopped the lex
pub fun is_identifier(alloc: *A.Allocator, text: str) res[bool, fail.Fail] {
    if (text == nil) { ret res[bool, fail.Fail].ok{false}; }
    val n: usize = str_len(text);
    if (n == 0) { ret res[bool, fail.Fail].ok{false}; }
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(alloc);
    fin { diagnostic.store_dnit(?diags); }
    val lexed: res[fe_lexer.TokenStream, fail.Fail] = lex_text(text, alloc, lang_source.FILE_NIL, ?diags);
    if (sel lexed.err) { ret res[bool, fail.Fail].err{lexed.err}; }
    var stream: fe_lexer.TokenStream = lexed.ok;
    fin { fe_lexer.dnit(?stream, alloc); }
    if (stream.error_len != 0 || stream.len == 0) { ret res[bool, fail.Fail].ok{false}; }
    val first: token.Token = stream.tokens[0];
    if (first.kind != token.KIND_IDENT || first.span.offset != 0 || first.span.len != n) { ret res[bool, fail.Fail].ok{false}; }
    ret res[bool, fail.Fail].ok{stream.len == 1 || stream.tokens[1].kind == token.KIND_EOF};
}

# a project module without the requested product: the tolerant load kept the
# project, so the frontend's own standing says whether a phase was rejected
# or failed internally; only a product missing from an accepted frontend is
# the editor's failure
fun project_product_missing(es: *EditorSession, text: str) fail.Fail {
    val status: fail.PhaseStatus = frontend.frontend_status(?es.proj);
    if (sel status.kind.rejected) { ret fail.reported(); }
    if (sel status.kind.internal) { ret fail.message(status.kind.internal); }
    ret fail.message(text);
}

# parse an open buffer, best effort: syntax errors become diagnostics and the tree is still
# returned. resets the session diagnostics first. a parse never consults the project: one
# buffer's tree needs no import closure, so a syntax-only consumer pays no closure cost and
# depends on no closure state, in or out of a project
# ---
# es:  the editor session
# fid: the buffer's FileId
# ret: the tree, owned by the session, or the buffer-not-open or fatal-parse error
fun parse_buffer(es: *EditorSession, fid: lang_source.FileId) res[*ast.Ast, fail.Fail] {
    diags_reset(es);

    val b: *Buffer = slot_live(es, fid);
    if (b == nil) { ret res[*ast.Ast, fail.Fail].err{fail.message("editor: buffer not open")}; }

    ret parse_inner(es, fid);
}

# resolve names in an open buffer, best effort: unresolved names become diagnostics and
# SYMBOL_REJECTED expression slots. resets the session diagnostics first. a buffer inside a project returns
# the project's resolve result for that module; a standalone buffer is parsed if needed and
# resolved with no dependencies, so every `use` binds to SYMBOL_NIL
# ---
# es:  the editor session
# fid: the buffer's FileId
# ret: the side tables, cached until the next update, or the buffer-not-open, parse, or
#      resolve error
fun resolve_buffer(es: *EditorSession, fid: lang_source.FileId) res[*resolve.ResolveResult, fail.Fail] {
    diags_reset(es);

    val b: *Buffer = slot_live(es, fid);
    if (b == nil) { ret res[*resolve.ResolveResult, fail.Fail].err{fail.message("editor: buffer not open")}; }

    val pe_r: res[opt[*project.ModuleEntry], fail.Fail] = proj_ensure(es, fid);
    if (sel pe_r.err) {
        ret res[*resolve.ResolveResult, fail.Fail].err{pe_r.err};
    }
    val pe: opt[*project.ModuleEntry] = pe_r.ok;
    if (sel pe.some) {
        val m:     *project.ModuleEntry       = pe.some;
        val shown: opt[frontend.ParsedModule] = frontend.parsed(?es.proj, m);
        val rr:    *resolve.ResolveResult     = frontend.resolved(?es.proj, m);
        if (sel shown.none) { ret res[*resolve.ResolveResult, fail.Fail].err{project_product_missing(es, "editor: project module has no resolve result")}; }
        if (rr == nil)      { ret res[*resolve.ResolveResult, fail.Fail].err{project_product_missing(es, "editor: project module has no resolve result")}; }
        analysis_drop(es, b);
        b.owned        = false;
        b.a            = shown.some.a;
        b.parse_status = shown.some.status;
        b.rr           = rr;
        ret res[*resolve.ResolveResult, fail.Fail].ok{b.rr};
    }

    if (b.a == nil || !b.owned) {
        val res_parse: res[*ast.Ast, fail.Fail] = parse_inner(es, fid);
        if (sel res_parse.err) {
            ret res[*resolve.ResolveResult, fail.Fail].err{res_parse.err};
        }
    }

    var deps: resolve.ResolveDeps;
    deps.entries = nil;
    deps.count   = 0;
    ret buffer_resolve(es, b, ?deps);
}

# resolve, then type-check an open buffer
# a buffer inside a project returns the project's sema result for that module; a standalone
# buffer is registered as its own module and checked with no dependencies
# ---
# es:  the editor session
# fid: the buffer's FileId
# ret: the sema result, cached until the next update, or the resolve, registration, sema,
#      or allocation error
fun analyze_buffer(es: *EditorSession, fid: lang_source.FileId) res[*fe_sema.SemaResult, fail.Fail] {
    val res_resolve: res[*resolve.ResolveResult, fail.Fail] = resolve_buffer(es, fid);
    if (sel res_resolve.err) {
        ret res[*fe_sema.SemaResult, fail.Fail].err{res_resolve.err};
    }
    val rr: *resolve.ResolveResult = res_resolve.ok;

    val b: *Buffer = slot_live(es, fid);
    if (b == nil) { ret res[*fe_sema.SemaResult, fail.Fail].err{fail.message("editor: buffer not open")}; }

    if (!b.owned) {
        val pe_r: res[opt[*project.ModuleEntry], fail.Fail] = proj_ensure(es, fid);
        if (sel pe_r.err) {
            ret res[*fe_sema.SemaResult, fail.Fail].err{pe_r.err};
        }
        val pe: opt[*project.ModuleEntry] = pe_r.ok;
        if (sel pe.none) { ret res[*fe_sema.SemaResult, fail.Fail].err{fail.message("editor: project module no longer available")}; }
        val m:  *project.ModuleEntry = pe.some;
        val sr: *fe_sema.SemaResult  = frontend.typed(?es.proj, m);
        if (sr == nil) { ret res[*fe_sema.SemaResult, fail.Fail].err{project_product_missing(es, "editor: project module has no sema result")}; }
        b.sr = sr;
        ret res[*fe_sema.SemaResult, fail.Fail].ok{b.sr};
    }

    sema_drop(es, b);

    var deps: fe_sema.SemaDeps = fe_sema.SemaDeps{};
    deps.definitions = fe_sema.reader_init(es::ptr, buffer_definition, es.alloc);
    fin { fe_sema.reader_dnit(?deps.definitions); }
    deps.entries = nil;
    deps.count   = 0;

    val mid: res[session.ModuleId, fail.Fail] = buffer_module(b);
    if (sel mid.err) { ret res[*fe_sema.SemaResult, fail.Fail].err{mid.err}; }
    val res_sema: res[fe_sema.SemaResult, fail.Fail] = fe_sema.sema(es.s, b.a, rr, ?deps, ?b.ctx, mid.ok, ?es.s.diags);
    if (sel res_sema.err) {
        es.operation_failure = opt[fail.Fail].some{res_sema.err};
        ret res[*fe_sema.SemaResult, fail.Fail].err{res_sema.err};
    }

    val sr_slot: res[*fe_sema.SemaResult, A.Error] = A.allocate[fe_sema.SemaResult](es.alloc, 1);
    if (sel sr_slot.err) {
        var sr_owned: fe_sema.SemaResult = res_sema.ok;
        fe_sema.result_dnit(?sr_owned);
        if (sel sr_slot.err) { ret res[*fe_sema.SemaResult, fail.Fail].err{fail.refused(sr_slot.err)}; }
        ret res[*fe_sema.SemaResult, fail.Fail].ok{sr_slot.ok};
    }
    val sr: *fe_sema.SemaResult = sr_slot.ok;
    @sr  = res_sema.ok;
    b.sr = sr;
    ret res[*fe_sema.SemaResult, fail.Fail].ok{sr};
}

val OOM_FAIL_MESSAGE: str = "out of memory";

# a copy of `f` owning its text and its places through the session's allocator,
# released with fail_dnit; a refused copy is the borrowed out-of-memory message
fun fail_owned(es: *EditorSession, f: fail.Fail) fail.Fail {
    val kept: res[fail.Fail, A.Error] = fail.retain(es.alloc, f);
    if (sel kept.err) { ret fail.message(OOM_FAIL_MESSAGE); }
    ret kept.ok;
}

# release an operational failure returned by analyze or build
# ---
# es: the editor session that returned the Fail
# f:  the Fail; nil is a no-op, and borrowed text (the out-of-memory message) is left alone
pub fun fail_dnit(es: *EditorSession, f: *fail.Fail) {
    if (f == nil) { ret; }
    fail.dnit(es.alloc, @f);
    @f = fail.without_places(fail.with_text(@f, nil));
}

fun diags_reset(es: *EditorSession) {
    diagnostic.store_dnit(?es.s.diags);
    es.s.diags = diagnostic.store_init(es.alloc);
}

fun discover_project_root(alloc: *A.Allocator, file_path: str) res[opt[str], fail.Fail] {
    val start_r: res[str, A.Error] = types_path.parent(alloc, file_path);
    if (sel start_r.err) { ret res[opt[str], fail.Fail].err{fail.refused(start_r.err)}; }
    var dir: str = start_r.ok;
    fin { str_free(alloc, dir); }
    for (true) {
        val mf_r: res[str, fail.Fail] = driver_load.join_path(alloc, dir, manifest.MANIFEST_FILE);
        if (sel mf_r.err) { ret res[opt[str], fail.Fail].err{mf_r.err}; }
        val mf:     str                          = mf_r.ok;
        val opened: res[fs.File, io_error.Error] = fs.open(mf);
        str_free(alloc, mf);
        if (sel opened.ok) {
            var file:     fs.File                          = opened.ok;
            val metadata: res[fs.Metadata, io_error.Error] = fs.stat_of(file);
            val closed:   err[io_error.Error]              = fs.close(?file);
            # a manifest opened read-only loses nothing to a refused close, so the failure going out stands alone
            if (sel metadata.err) {
                ret res[opt[str], fail.Fail].err{fail.message(system_os.message(metadata.err))};
            }
            if (sel closed.err) { ret res[opt[str], fail.Fail].err{fail.message(system_os.message(closed.err))}; }
            if (metadata.ok.kind != fs.KIND_FILE) {
                ret res[opt[str], fail.Fail].err{fail.message("project manifest is not a regular file")};
            }
            val found: str = dir;
            dir = nil;
            ret res[opt[str], fail.Fail].ok{opt[str].some{found}};
        }
        if (system_os.error_kind(opened.err.code) != io_error.NOT_FOUND) {
            ret res[opt[str], fail.Fail].err{fail.message(system_os.message(opened.err))};
        }
        val parent_r: res[str, A.Error] = types_path.parent(alloc, dir);
        if (sel parent_r.err) { ret res[opt[str], fail.Fail].err{fail.refused(parent_r.err)}; }
        val next: str = parent_r.ok;
        if (str_equals(next, dir)) {
            str_free(alloc, next);
            ret res[opt[str], fail.Fail].ok{opt[str].none{}};
        }
        str_free(alloc, dir);
        dir = next;
    }
    ret res[opt[str], fail.Fail].ok{opt[str].none{}};
}

fun relative_under(alloc: *A.Allocator, file_path: str, root: str, src_text: str) res[opt[str], fail.Fail] {
    val prefix_r: res[str, fail.Fail] = driver_load.join_path(alloc, root, src_text);
    if (sel prefix_r.err) { ret res[opt[str], fail.Fail].err{prefix_r.err}; }
    val prefix: str = prefix_r.ok;
    fin { str_free(alloc, prefix); }
    val plen: usize = str_len(prefix);
    val flen: usize = str_len(file_path);
    if (flen <= plen || !types_path.is_separator(file_path[plen])) {
        ret res[opt[str], fail.Fail].ok{opt[str].none{}};
    }
    var i: usize = 0;
    for (i < plen) {
        if (file_path[i] != prefix[i] && !(types_path.is_separator(file_path[i]) && types_path.is_separator(prefix[i]))) {
            ret res[opt[str], fail.Fail].ok{opt[str].none{}};
        }
        i = i + 1;
    }
    val rel_r: res[str, types_string.StrError] = str_copy_slice(alloc, file_path, plen + 1, flen - plen - 1);
    if (sel rel_r.err) { ret res[opt[str], fail.Fail].err{fail.str_refused(rel_r.err)}; }
    ret res[opt[str], fail.Fail].ok{opt[str].some{rel_r.ok}};
}

fun proj_roots_has(es: *EditorSession, fqn: intern.StrId) bool {
    var i: u32 = 0;
    for (i < es.proj_root_count) {
        if (intern.str_same(es.proj_roots[i], fqn)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the module an open buffer at `path` is loaded as beside the project at `root`: none when the
# buffer belongs to another project or lies outside the source directory
# ---
# id_text:  the project id, the module path's first segment
# src_text: the manifest's source directory, relative to `root`
fun buffer_root_fqn(alloc: *A.Allocator, itn: *intern.Interner, path: str, root: str, id_text: str,
    src_text: str) res[opt[intern.StrId], fail.Fail] {
    val owner_r: res[opt[str], fail.Fail] = discover_project_root(alloc, path);
    if (sel owner_r.err) { ret res[opt[intern.StrId], fail.Fail].err{owner_r.err}; }
    val owner: opt[str] = owner_r.ok;
    if (sel owner.none) { ret res[opt[intern.StrId], fail.Fail].ok{opt[intern.StrId].none{}}; }
    val same: bool = str_equals(owner.some, root);
    str_free(alloc, owner.some);
    if (!same) { ret res[opt[intern.StrId], fail.Fail].ok{opt[intern.StrId].none{}}; }
    val relative: res[opt[str], fail.Fail] = relative_under(alloc, path, root, src_text);
    if (sel relative.err)     { ret res[opt[intern.StrId], fail.Fail].err{relative.err}; }
    if (sel relative.ok.none) { ret res[opt[intern.StrId], fail.Fail].ok{opt[intern.StrId].none{}}; }
    val rel:  str                          = relative.ok.some;
    val name: res[intern.StrId, fail.Fail] = module.compose_fqn(alloc, itn, id_text, rel);
    str_free(alloc, rel);
    if (sel name.err) { ret res[opt[intern.StrId], fail.Fail].err{name.err}; }
    ret res[opt[intern.StrId], fail.Fail].ok{opt[intern.StrId].some{name.ok}};
}

# the project at `root` as an editor holds it: the union of every artifact, since an open buffer
# belongs to whichever artifact reaches it, so every entry loads and each module's
# `{artifact.<id>.out}` resolves in the requirements of the artifact that needs it. the extra
# roots are the open buffers' modules, loaded beside the entries; the project comes back
# whatever its phases decided
fun root_analyze(s: *session.Session, m: *manifest.Manifest, root: str, req: *request.BuildRequest,
    extra_roots: *intern.StrId, extra_root_count: u32, phase: driver.FrontendPhase) res[project.Project, fail.Fail] {
    var rooted: request.BuildRequest = @req;
    rooted.project_root = root;
    ret driver.analyze_project_tolerant(s, m, ?rooted, project.ROOT_UNION, extra_roots, extra_root_count, phase);
}

fun proj_roots_rebuild(es: *EditorSession, root: str, id_text: str, src_text: str) err[fail.Fail] {
    val allocated: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](es.alloc, es.buf_len::usize);
    if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
    val roots:    *intern.StrId = allocated.ok;
    var complete: bool          = false;
    fin {
        if (!complete) { A.deallocate[intern.StrId](es.alloc, roots, es.buf_len::usize); }
    }
    var count: u32 = 0;
    var i:     u32 = 0;
    for (i < es.buf_len) {
        if (es.buffers[i].in_use) {
            val file: opt[*lang_source.SourceFile] = lang_source.get(?es.s.sources, es.buffers[i].file_id);
            if (sel file.none) { ret err[fail.Fail].err{fail.message("open editor buffer has no source identity")}; }
            val name: res[opt[intern.StrId], fail.Fail] = buffer_root_fqn(es.alloc, ?es.s.interner, file.some.path, root, id_text, src_text);
            if (sel name.err) { ret err[fail.Fail].err{name.err}; }
            if (sel name.ok.some) {
                roots[count] = name.ok.some;
                count        = count + 1;
            }
        }
        i = i + 1;
    }
    if (es.proj_roots != nil) { A.deallocate[intern.StrId](es.alloc, es.proj_roots, es.proj_root_cap::usize); }
    es.proj_roots      = roots;
    es.proj_root_count = count;
    es.proj_root_cap   = es.buf_len;
    complete           = true;
    ret err[fail.Fail].ok{};
}

fun views_drop(es: *EditorSession) {
    var i: u32 = 0;
    for (i < es.buf_len) {
        if (es.buffers[i].in_use) { analysis_drop(es, ?es.buffers[i]); }
        i = i + 1;
    }
    val had_project: bool = es.proj_loaded;
    if (es.proj_dirty) { proj_teardown(es); }
    # a torn-down project resets the registry itself; a kept one still owns its entries
    if (!es.proj_loaded && !had_project) { session.reset_module_registry(es.s); }
    if (es.s.query_presentation != nil) {
        query.presentation_dnit(es.s.query_presentation);
        es.s.query_presentation = nil;
    }
    session.drop_query_failure(es.s);
    diags_reset(es);
}

fun proj_key_free(alloc: *A.Allocator, k: *ProjKey) {
    if (!k.valid)          { ret; }
    if (k.target != nil)   { str_free(alloc, k.target); }
    if (k.profile != nil)  { str_free(alloc, k.profile); }
    if (k.artifact != nil) { str_free(alloc, k.artifact); }
    k.valid    = false;
    k.target   = nil;
    k.profile  = nil;
    k.artifact = nil;
}

fun proj_key_capture(alloc: *A.Allocator, chosen: *ProjectSelection, out: *ProjKey) err[fail.Fail] {
    var k: ProjKey;
    k.valid    = true;
    k.target   = nil;
    k.profile  = nil;
    k.artifact = nil;
    var complete: bool = false;
    fin {
        if (!complete) { proj_key_free(alloc, ?k); }
    }
    val target: res[str, types_string.StrError] = str_copy(alloc, chosen.target);
    if (sel target.err) { ret err[fail.Fail].err{fail.str_refused(target.err)}; }
    k.target = target.ok;
    val profile: res[str, types_string.StrError] = str_copy(alloc, chosen.profile);
    if (sel profile.err) { ret err[fail.Fail].err{fail.str_refused(profile.err)}; }
    k.profile = profile.ok;
    val artifact: res[str, types_string.StrError] = str_copy(alloc, chosen.artifact);
    if (sel artifact.err) { ret err[fail.Fail].err{fail.str_refused(artifact.err)}; }
    k.artifact = artifact.ok;
    complete   = true;
    @out       = k;
    ret err[fail.Fail].ok{};
}

fun proj_key_matches(k: *ProjKey, chosen: *ProjectSelection) bool {
    if (!k.valid)                                 { ret false; }
    if (!str_equals(k.target, chosen.target))     { ret false; }
    if (!str_equals(k.profile, chosen.profile))   { ret false; }
    if (!str_equals(k.artifact, chosen.artifact)) { ret false; }
    ret true;
}

# re-derive the loaded project for the buffers edited since it loaded, module by module
# and in place, so an edit inside one module costs that module and its dependents rather
# than the closure. an edited file the project does not hold, or an edit that changed a
# module's load surface, cannot be refreshed and reports false: the caller reloads
# ---
# es:  the editor session, with a loaded project
# ret: true when every edit was refreshed in place; false when a reload is due
fun proj_refresh_edited(es: *EditorSession) res[bool, fail.Fail] {
    var refreshed: bool  = true;
    var i:         usize = 0;
    for (i < es.proj_edited.len && refreshed) {
        val fid: lang_source.FileId    = es.proj_edited.data[i];
        val mod: opt[session.ModuleId] = project.module_by_file(?es.proj, fid);
        if (sel mod.none) { refreshed = false; }
        if (sel mod.some) {
            val mid:         session.ModuleId = mod.some;
            val prior_build: *A.Allocator     = es.s.build_alloc;
            es.s.build_alloc = ?es.proj_alloc;
            val holder: res[retention.RetainerId, fail.Fail] = root_retainer(es, es.proj_root);
            if (sel holder.err) {
                es.s.build_alloc = prior_build;
                ret res[bool, fail.Fail].err{holder.err};
            }
            val prior_retainer: retention.RetainerId = es.s.retention.active;
            es.s.retention.active = holder.ok;
            val r: res[bool, fail.Fail] = driver.refresh_frontend(?es.proj, mid, es.proj_phase);
            es.s.build_alloc      = prior_build;
            es.s.retention.active = prior_retainer;
            # a failed refresh leaves the project half re-derived: reload it whole
            if (sel r.err) { refreshed = false; }
            if (sel r.ok)  { refreshed = r.ok; }
        }
        i = i + 1;
    }
    if (refreshed) {
        collections_vector.clear[lang_source.FileId](?es.proj_edited);
        es.proj_refreshes = es.proj_refreshes + 1;
    }
    ret res[bool, fail.Fail].ok{refreshed};
}

fun proj_teardown(es: *EditorSession) {
    proj_key_free(es.alloc, ?es.proj_key);
    if (!es.proj_loaded) { ret; }
    project.dnit_project(?es.proj);
    arena.dnit(?es.proj_arena);
    es.proj_loaded = false;
}

# the retainer a root's analyses record under, opened the first time the root loads
fun root_retainer(es: *EditorSession, root: str) res[retention.RetainerId, fail.Fail] {
    var i: usize = 0;
    for (i < es.root_retainers.len) {
        if (str_equals(es.root_retainers.data[i].root, root)) { ret res[retention.RetainerId, fail.Fail].ok{es.root_retainers.data[i].id}; }
        i = i + 1;
    }
    val reserved: res[usize, A.Error] = collections_vector.reserve[RootRetainer](?es.root_retainers, 1);
    if (sel reserved.err) { ret res[retention.RetainerId, fail.Fail].err{fail.refused(reserved.err)}; }
    val owned: res[str, types_string.StrError] = str_copy(es.alloc, root);
    if (sel owned.err) { ret res[retention.RetainerId, fail.Fail].err{fail.str_refused(owned.err)}; }
    var stored: bool = false;
    fin {
        if (!stored) { str_free(es.alloc, owned.ok); }
    }
    val opened: res[retention.RetainerId, fail.Fail] = retention.open(?es.s.retention);
    if (sel opened.err) { ret opened; }
    val added: res[usize, A.Error] = collections_vector.push[RootRetainer](?es.root_retainers, RootRetainer{root: owned.ok, id: opened.ok});
    if (sel added.err) { ret res[retention.RetainerId, fail.Fail].err{fail.refused(added.err)}; }
    stored = true;
    ret opened;
}

fun root_has_buffer(es: *EditorSession, root: str) res[bool, fail.Fail] {
    var i: u32 = 0;
    for (i < es.buf_len) {
        if (es.buffers[i].in_use) {
            val file: opt[*lang_source.SourceFile] = lang_source.get(?es.s.sources, es.buffers[i].file_id);
            if (sel file.none) { ret res[bool, fail.Fail].err{fail.message("editor: an open buffer names no source file")}; }
            val owner: res[opt[str], fail.Fail] = discover_project_root(es.alloc, file.some.path);
            if (sel owner.err) { ret res[bool, fail.Fail].err{owner.err}; }
            if (sel owner.ok.some) {
                val same: bool = str_equals(owner.ok.some, root);
                str_free(es.alloc, owner.ok.some);
                if (same) { ret res[bool, fail.Fail].ok{true}; }
            }
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

# the session stops holding the modules of every root no open buffer belongs to, or of every root and
# the editor's builds when the editor goes away, and retires what nothing else holds
fun release_roots(es: *EditorSession, all: bool) err[fail.Fail] {
    var i: usize = 0;
    for (i < es.root_retainers.len) {
        val entry: RootRetainer = es.root_retainers.data[i];
        if (!all) {
            val held: res[bool, fail.Fail] = root_has_buffer(es, entry.root);
            if (sel held.err) { ret err[fail.Fail].err{held.err}; }
            if (held.ok) {
                i = i + 1;
                cnt;
            }
        }
        val released: err[fail.Fail] = retention.release(?es.s.retention, entry.id);
        if (sel released.err) { ret released; }
        str_free(es.alloc, entry.root);
        es.root_retainers.data[i] = es.root_retainers.data[es.root_retainers.len - 1];
        collections_vector.truncate[RootRetainer](?es.root_retainers, es.root_retainers.len - 1);
    }
    ret retention.retire(?es.s.retention, ?es.s.queries);
}

# the buffer's project could not be loaded before its frontend ran (an
# unreadable manifest, a refused load): the failure is recorded for the
# analysis envelope and the buffer is analyzed standalone, as one outside
# any project is. a project its own frontend rejected is not this case, the
# tolerant load keeps it
fun proj_unavailable(es: *EditorSession, root: str, failure: fail.Fail) res[opt[*project.ModuleEntry], fail.Fail] {
    proj_teardown(es);
    str_free(es.alloc, root);
    es.operation_failure = opt[fail.Fail].some{failure};
    ret res[opt[*project.ModuleEntry], fail.Fail].ok{opt[*project.ModuleEntry].none{}};
}

fun proj_ensure(es: *EditorSession, fid: lang_source.FileId) res[opt[*project.ModuleEntry], fail.Fail] {
    val file_opt: opt[*lang_source.SourceFile] = lang_source.get(?es.s.sources, fid);
    if (sel file_opt.none) { ret res[opt[*project.ModuleEntry], fail.Fail].ok{opt[*project.ModuleEntry].none{}}; }
    val file_path: str = file_opt.some.path;

    val discovered: res[opt[str], fail.Fail] = discover_project_root(es.alloc, file_path);
    if (sel discovered.err) { ret res[opt[*project.ModuleEntry], fail.Fail].err{discovered.err}; }
    val root_opt: opt[str] = discovered.ok;
    if (sel root_opt.none) { ret res[opt[*project.ModuleEntry], fail.Fail].ok{opt[*project.ModuleEntry].none{}}; }
    val root:        str  = root_opt.some;
    var root_handed: bool = false;
    fin {
        if (!root_handed) { str_free(es.alloc, root); }
    }

    val root_changed: bool = es.proj_root == nil || !str_equals(es.proj_root, root);
    if (root_changed) {
        proj_teardown(es);
        if (es.proj_root != nil) {
            str_free(es.alloc, es.proj_root);
            es.proj_root = nil;
        }
        es.proj_root_count = 0;
    }

    val need_manifest:  bool         = root_changed || !es.proj_loaded;
    var id_text:        str          = nil;
    var src_text:       str          = nil;
    var m:              manifest.Manifest;
    var have_manifest:  bool         = false;
    val manifest_alloc: *A.Allocator = es.s.build_alloc;
    fin {
        if (have_manifest) { manifest.dnit(?m, manifest_alloc); }
    }

    if (need_manifest) {
        val m_r: res[manifest.Manifest, fail.Fail] = driver.load_manifest(es.s, root);
        if (sel m_r.err) {
            root_handed = true;
            ret proj_unavailable(es, root, m_r.err);
        }
        m             = m_r.ok;
        have_manifest = true;
        val id_opt:  opt[str] = intern.get(?es.s.interner, m.id);
        val src_opt: opt[str] = intern.get(?es.s.interner, m.src);
        if (sel id_opt.none) {
            ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.message("editor: manifest project id or src dir not interned")};
        }
        if (sel src_opt.none) {
            ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.message("editor: manifest project id or src dir not interned")};
        }
        id_text  = id_opt.some;
        src_text = src_opt.some;
    }
    or {
        val id_opt:  opt[str] = intern.get(?es.s.interner, es.proj.config.id);
        val src_opt: opt[str] = intern.get(?es.s.interner, es.proj.config.dir_src);
        if (sel id_opt.none) {
            ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.message("editor: cached project id or src dir not interned")};
        }
        if (sel src_opt.none) {
            ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.message("editor: cached project id or src dir not interned")};
        }
        id_text  = id_opt.some;
        src_text = src_opt.some;
    }

    val relative: res[opt[str], fail.Fail] = relative_under(es.alloc, file_path, root, src_text);
    if (sel relative.err) {
        ret res[opt[*project.ModuleEntry], fail.Fail].err{relative.err};
    }
    val rel_opt: opt[str] = relative.ok;
    if (sel rel_opt.none) {
        ret res[opt[*project.ModuleEntry], fail.Fail].ok{opt[*project.ModuleEntry].none{}};
    }
    val rel: str = rel_opt.some;
    fin { str_free(es.alloc, rel); }
    if (es.active_request != nil && es.active_request.standalone_target != nil) {
        es.operation_failure = opt[fail.Fail].some{fail.user(diagnostic_kind.EDITOR_TARGET_SELECTION, "project analysis selects its target through the build request")};
        ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.message("project analysis selects its target through the build request")};
    }

    val fqn_r: res[intern.StrId, fail.Fail] = module.compose_fqn(es.alloc, ?es.s.interner, id_text, rel);
    if (sel fqn_r.err) {
        ret res[opt[*project.ModuleEntry], fail.Fail].err{fqn_r.err};
    }
    val fqn: intern.StrId = fqn_r.ok;

    var want_selection: ProjectSelection     = ProjectSelection{artifact: "", target: "", profile: ""};
    var want_phase:     driver.FrontendPhase = driver.FRONTEND_SEMA;
    if (es.active_request != nil) {
        want_selection = es.active_request.selection;
        want_phase     = es.active_request.phase;
    }

    # a loaded project answers only for the phase it was loaded to and the selection its request
    # was composed from: a deeper phase has no products and a different request has other ones
    val has_root:    bool = proj_roots_has(es, fqn);
    var need_reload: bool = root_changed || es.proj_dirty || !es.proj_loaded || !has_root
        || want_phase > es.proj_phase || !proj_key_matches(?es.proj_key, ?want_selection);

    if (!need_reload && es.proj_edited.len > 0) {
        val refreshed: res[bool, fail.Fail] = proj_refresh_edited(es);
        if (sel refreshed.err) {
            ret res[opt[*project.ModuleEntry], fail.Fail].err{refreshed.err};
        }
        need_reload = !refreshed.ok;
    }

    if (!need_reload) {
        ret res[opt[*project.ModuleEntry], fail.Fail].ok{project.module_by_fqn(?es.proj, fqn)};
    }

    var key:      ProjKey        = ProjKey{valid: false, target: nil, profile: nil, artifact: nil};
    val captured: err[fail.Fail] = proj_key_capture(es.alloc, ?want_selection, ?key);
    if (sel captured.err) {
        ret res[opt[*project.ModuleEntry], fail.Fail].err{captured.err};
    }
    var key_committed: bool = false;
    fin {
        if (!key_committed) { proj_key_free(es.alloc, ?key); }
    }

    val rebuilt: err[fail.Fail] = proj_roots_rebuild(es, root, id_text, src_text);
    if (sel rebuilt.err) {
        ret res[opt[*project.ModuleEntry], fail.Fail].err{rebuilt.err};
    }

    if (!have_manifest) {
        val m_r: res[manifest.Manifest, fail.Fail] = driver.load_manifest(es.s, root);
        if (sel m_r.err) {
            root_handed = true;
            ret proj_unavailable(es, root, m_r.err);
        }
        m             = m_r.ok;
        have_manifest = true;
    }

    # the request borrows the key's strings, which the editor owns for as long as the project
    var owned:    ProjectSelection                     = ProjectSelection{artifact: key.artifact, target: key.target, profile: key.profile};
    val composed: res[request.BuildRequest, fail.Fail] = project_build(es.s, ?m, root, ?owned);
    if (sel composed.err) {
        root_handed = true;
        ret proj_unavailable(es, root, composed.err);
    }
    var want_req: request.BuildRequest = composed.ok;
    fin { project_build_dnit(?want_req); }

    val holder: res[retention.RetainerId, fail.Fail] = root_retainer(es, root);
    if (sel holder.err) {
        ret res[opt[*project.ModuleEntry], fail.Fail].err{holder.err};
    }

    proj_teardown(es);

    val init_r: err[A.Error] = arena.init(?es.proj_arena, es.s.backing, 0);
    if (sel init_r.err) {
        ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.refused(init_r.err)};
    }
    var arena_handed: bool = false;
    fin {
        if (!arena_handed) { arena.dnit(?es.proj_arena); }
    }
    val make_r2: err[A.Error] = arena.make(?es.proj_alloc, ?es.proj_arena);
    if (sel make_r2.err) {
        ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.refused(make_r2.err)};
    }

    val prior_build: *A.Allocator = es.s.build_alloc;
    es.s.build_alloc = ?es.proj_alloc;

    val prior_retainer: retention.RetainerId = es.s.retention.active;
    es.s.retention.active = holder.ok;
    val ap_r: res[project.Project, fail.Fail] = root_analyze(es.s, ?m, root, ?want_req, es.proj_roots, es.proj_root_count, want_phase);
    es.s.build_alloc      = prior_build;
    es.s.retention.active = prior_retainer;

    if (sel ap_r.err) {
        root_handed = true;
        ret proj_unavailable(es, root, ap_r.err);
    }

    es.proj_loaded = true;
    es.proj        = ap_r.ok;
    if (es.proj_root != nil) { str_free(es.alloc, es.proj_root); }
    es.proj_root  = root;
    root_handed   = true;
    arena_handed  = true;
    es.proj_dirty = false;
    collections_vector.clear[lang_source.FileId](?es.proj_edited);
    es.proj_phase = want_phase;
    es.proj_loads = es.proj_loads + 1;
    proj_key_free(es.alloc, ?es.proj_key);
    es.proj_key   = key;
    key_committed = true;

    ret res[opt[*project.ModuleEntry], fail.Fail].ok{project.module_by_fqn(?es.proj, fqn)};
}

fun tokenize_inner(es: *EditorSession, fid: lang_source.FileId) res[fe_lexer.TokenStream, fail.Fail] {
    val opt_file: opt[*lang_source.SourceFile] = lang_source.get(?es.s.sources, fid);
    if (sel opt_file.none) {
        ret res[fe_lexer.TokenStream, fail.Fail].err{fail.message("editor: buffer not open")};
    }
    ret lex_text(opt_file.some.text, es.alloc, fid, ?es.s.diags);
}

# lex a text, its lexical errors recorded as diagnostics; the caller frees the stream
fun lex_text(text: str, alloc: *A.Allocator, fid: lang_source.FileId, diags: *diagnostic.DiagnosticStore) res[fe_lexer.TokenStream, fail.Fail] {
    val res_tokens: res[fe_lexer.TokenStream, fail.Fail] = fe_lexer.tokenize(text, alloc, fid);
    if (sel res_tokens.err) { ret res_tokens; }
    var stream: fe_lexer.TokenStream = res_tokens.ok;

    val res_emit: err[fail.Fail] = fe_lexer.emit_diagnostics(?stream, diags);
    if (sel res_emit.err) {
        fe_lexer.dnit(?stream, alloc);
        ret res[fe_lexer.TokenStream, fail.Fail].err{res_emit.err};
    }
    ret res[fe_lexer.TokenStream, fail.Fail].ok{stream};
}

# parse a token stream into an initialized tree, writing the parse's standing to status;
# a fatal parse rejects at the depth limit, fails internally otherwise, and is returned
fun parse_tokens(stream: *fe_lexer.TokenStream, a: *ast.Ast, diags: *diagnostic.DiagnosticStore, status: *fail.PhaseStatus) opt[state.ParseFail] {
    val parse_r: res[fail.PhaseStatus, state.ParseFail] = fe_parser.parse(stream, a, diags);
    if (sel parse_r.err) {
        val f: state.ParseFail = parse_r.err;
        if (f.kind == state.PARSE_FAIL_DEPTH) { fail.reject(status); }
        or                                    { fail.internal(status, f.message); }
        ret opt[state.ParseFail].some{f};
    }
    @status = parse_r.ok;
    ret opt[state.ParseFail].none{};
}

fun parse_inner(es: *EditorSession, fid: lang_source.FileId) res[*ast.Ast, fail.Fail] {
    val b: *Buffer = slot_live(es, fid);
    if (b == nil) { ret res[*ast.Ast, fail.Fail].err{fail.message("editor: buffer not open")}; }

    val res_tokens: res[fe_lexer.TokenStream, fail.Fail] = tokenize_inner(es, fid);
    if (sel res_tokens.err) {
        ret res[*ast.Ast, fail.Fail].err{res_tokens.err};
    }
    var stream: fe_lexer.TokenStream = res_tokens.ok;
    fin { fe_lexer.dnit(?stream, es.alloc); }

    analysis_drop(es, b);

    val res_ast: res[*ast.Ast, fail.Fail] = ast_alloc(es, fid);
    if (sel res_ast.err) { ret res_ast; }
    val a: *ast.Ast = res_ast.ok;

    b.a = a;
    val fatal: opt[state.ParseFail] = parse_tokens(?stream, a, ?es.s.diags, ?b.parse_status);
    if (sel fatal.some) {
        es.operation_failure = opt[fail.Fail].some{state.failure(fatal.some)};
        ret res[*ast.Ast, fail.Fail].err{fail.message(fatal.some.message)};
    }
    ret res[*ast.Ast, fail.Fail].ok{a};
}

fun buffer_definition(raw: ptr, origin: session.ModuleId, phase: fe_sema.DefinitionPhase) res[fe_sema.Definition, fail.Fail] {
    val es: *EditorSession = raw::*EditorSession;
    if (es == nil) {
        ret res[fe_sema.Definition, fail.Fail].err{fail.message("current definition is not an open editor buffer")};
    }
    val file: opt[u32] = module.buffer_file(origin);
    if (sel file.none) {
        ret res[fe_sema.Definition, fail.Fail].err{fail.message("editor definition names a module that is not a standalone buffer")};
    }
    val b: *Buffer = slot_live(es, lang_source.file_id(file.some));
    if (b == nil || !b.owned || b.a == nil) {
        ret res[fe_sema.Definition, fail.Fail].err{fail.message("editor definition has no current standalone parsed owner")};
    }
    var result: fe_sema.Definition = fe_sema.Definition{
        parsed: resolve.ParsedDefinition{a: b.a, owner: resolve.type_owner(es.s, origin, b.file_id), incarnation: b.a.incarnation},
        origin: origin, decorators: ?b.ctx
    };
    if (phase >= fe_sema.DEFINITION_RESOLVED) { result.rr = b.rr; }
    if (phase == fe_sema.DEFINITION_TYPED) {
        result.sr = b.sr;
        comptime.dnit(?b.view);
        b.view = comptime.stage_init(?b.ctx, comptime.STAGE_LOWER, es.alloc);
        if (b.rr != nil) { comptime.layer_set(?b.view, comptime.STAGE_RESOLVE, ?b.rr.constants); }
        if (b.sr != nil) { comptime.layer_set(?b.view, comptime.STAGE_SEMA, ?b.sr.constants); }
        result.ctx = ?b.view;
    }
    ret res[fe_sema.Definition, fail.Fail].ok{result};
}

# the module of a standalone buffer, from the buffer range no project's module takes
fun buffer_module(b: *Buffer) res[session.ModuleId, fail.Fail] {
    val mid: opt[session.ModuleId] = module.buffer_id(lang_source.file_index(b.file_id));
    if (sel mid.none) { ret res[session.ModuleId, fail.Fail].err{fail.message("editor: the buffer's file is past the last standalone module id")}; }
    ret res[session.ModuleId, fail.Fail].ok{mid.some};
}

# a standalone buffer is a module of its own, which its path names: its module id, the name
# readers of that id see, and the stable identity its symbols carry
fun buffer_identity(es: *EditorSession, b: *Buffer) res[session.StableModuleId, fail.Fail] {
    val file: opt[*lang_source.SourceFile] = lang_source.get(?es.s.sources, b.file_id);
    if (sel file.none) { ret res[session.StableModuleId, fail.Fail].err{fail.message("editor: buffer has no source")}; }
    val mid: res[session.ModuleId, fail.Fail] = buffer_module(b);
    if (sel mid.err) { ret res[session.StableModuleId, fail.Fail].err{mid.err}; }
    val named: res[intern.StrId, A.Error] = intern.add(?es.s.interner, file.some.path);
    if (sel named.err) { ret res[session.StableModuleId, fail.Fail].err{fail.refused(named.err)}; }
    val stable: res[session.StableModuleId, fail.Fail] = session.stable_module_id(es.s, named.ok);
    if (sel stable.err) { ret stable; }
    val registered: err[fail.Fail] = session.register_module_identity(es.s, mid.ok, named.ok, stable.ok);
    if (sel registered.err) { ret res[session.StableModuleId, fail.Fail].err{registered.err}; }
    ret stable;
}

fun buffer_resolve(es: *EditorSession, b: *Buffer, deps: *resolve.ResolveDeps) res[*resolve.ResolveResult, fail.Fail] {
    rr_drop(es, b);
    val seeded: err[fail.Fail] = ctx_seed(es, b);
    if (sel seeded.err) { ret res[*resolve.ResolveResult, fail.Fail].err{seeded.err}; }

    val identity: res[session.StableModuleId, fail.Fail] = buffer_identity(es, b);
    if (sel identity.err) { ret res[*resolve.ResolveResult, fail.Fail].err{identity.err}; }

    val mid: res[session.ModuleId, fail.Fail] = buffer_module(b);
    if (sel mid.err) { ret res[*resolve.ResolveResult, fail.Fail].err{mid.err}; }

    comptime.decorators_clear(?b.ctx);
    val res_resolve: res[resolve.ResolveResult, fail.Fail] = resolve.resolve(es.s, b.a, deps, ?b.ctx, mid.ok, identity.ok, ?es.s.diags);
    if (sel res_resolve.err) {
        es.operation_failure = opt[fail.Fail].some{res_resolve.err};
        ret res[*resolve.ResolveResult, fail.Fail].err{res_resolve.err};
    }
    var resolved: resolve.ResolveResult = res_resolve.ok;
    var handed:   bool                  = false;
    fin {
        if (!handed) { resolve.result_dnit(?resolved); }
    }
    # a standalone buffer has no load: its decorator strings read the constants resolution bound
    val recorded: err[fail.Fail] = decorators_record(es, b, ?resolved);
    if (sel recorded.err) { ret res[*resolve.ResolveResult, fail.Fail].err{recorded.err}; }

    val res_slot: res[*resolve.ResolveResult, A.Error] = A.allocate[resolve.ResolveResult](es.alloc, 1);
    if (sel res_slot.err) { ret res[*resolve.ResolveResult, fail.Fail].err{fail.refused(res_slot.err)}; }
    val rr: *resolve.ResolveResult = res_slot.ok;
    @rr    = resolved;
    handed = true;
    b.rr   = rr;
    ret res[*resolve.ResolveResult, fail.Fail].ok{rr};
}

# the buffer's decorator strings, read over the constants resolution bound, and what its `embed`
# arguments name, recorded in its own load scope
fun decorators_record(es: *EditorSession, b: *Buffer, rr: *resolve.ResolveResult) err[fail.Fail] {
    val text: opt[*lang_source.SourceFile] = lang_source.get(?es.s.sources, b.file_id);
    if (sel text.none) { ret err[fail.Fail].ok{}; }
    var read: comptime.ComptimeCtx = comptime.stage_init(?b.ctx, comptime.STAGE_SEMA, es.alloc);
    fin { comptime.dnit(?read); }
    comptime.layer_set(?read, comptime.STAGE_RESOLVE, ?rr.constants);
    val strings: err[fail.Fail] = decorator.strings_record[comptime.NoCapabilityContext](?es.s.interner, ?b.ctx, b.a,
        text.some.text, ?read, nil, comptime.no_capabilities(), nil);
    if (sel strings.err) { ret strings; }
    val mid: res[session.ModuleId, fail.Fail] = buffer_module(b);
    if (sel mid.err) { ret err[fail.Fail].err{mid.err}; }
    ret fe_load.embeds_record(es.s, ?b.ctx, b.a, session.module_fqn(es.s, mid.ok), nil);
}

fun slot_get(es: *EditorSession, fid: lang_source.FileId) *Buffer {
    var i: u32 = 0;
    for (i < es.buf_len) {
        if (es.buffers[i].in_use && lang_source.file_same(es.buffers[i].file_id, fid)) { ret ?es.buffers[i]; }
        i = i + 1;
    }
    ret nil;
}

fun slot_live(es: *EditorSession, fid: lang_source.FileId) *Buffer {
    ret slot_get(es, fid);
}

fun slot_reserve(es: *EditorSession, fid: lang_source.FileId) res[u32, fail.Fail] {
    var i:      u32 = 0;
    var vacant: u32 = ~(0::u32);
    for (i < es.buf_len) {
        if (es.buffers[i].in_use && lang_source.file_same(es.buffers[i].file_id, fid)) { ret res[u32, fail.Fail].ok{i}; }
        if (!es.buffers[i].in_use && vacant == ~(0::u32))                              { vacant = i; }
        i = i + 1;
    }
    if (vacant != ~(0::u32)) { ret res[u32, fail.Fail].ok{vacant}; }
    # every slot up to buf_len exists, so the slot count is the capacity
    val index: u32          = es.buf_len;
    val grown: err[A.Error] = growth.reserve[Buffer](es.alloc, ?es.buffers, ?es.buf_len, index::usize + 1);
    if (sel grown.err) { ret res[u32, fail.Fail].err{fail.refused(grown.err)}; }
    i = index;
    for (i < es.buf_len) {
        es.buffers[i] = Buffer{};
        i             = i + 1;
    }
    ret res[u32, fail.Fail].ok{index};
}

fun ast_alloc(es: *EditorSession, fid: lang_source.FileId) res[*ast.Ast, fail.Fail] {
    val res_alloc: res[*ast.Ast, A.Error] = A.allocate[ast.Ast](es.alloc, 1);
    if (sel res_alloc.err) { ret res[*ast.Ast, fail.Fail].err{fail.refused(res_alloc.err)}; }
    val a: *ast.Ast = res_alloc.ok;
    @a = ast.init(es.alloc, fid);
    val incarnation: res[u64, fail.Fail] = session.next_parse_incarnation(es.s);
    if (sel incarnation.err) {
        A.deallocate[ast.Ast](es.alloc, a, 1);
        ret res[*ast.Ast, fail.Fail].err{incarnation.err};
    }
    a.incarnation = incarnation.ok;
    ret res[*ast.Ast, fail.Fail].ok{a};
}

# seed a standalone buffer's comptime context from the target its analysis selects:
# the request's, or with no request the one a default request selects, so every
# target-dependent fact is the build's whether or not a request is active
fun ctx_seed(es: *EditorSession, b: *Buffer) err[fail.Fail] {
    var defaults: AnalysisRequest  = analysis_request(b.file_id, PHASE_SEMA);
    var req:      *AnalysisRequest = es.active_request;
    if (req == nil) { req = ?defaults; }
    if (str_len(req.selection.target) != 0) {
        # a refused project load already recorded the cause, and this buffer is standalone only because of it
        val caused: bool = sel es.operation_failure.some;
        if (!caused) { es.operation_failure = opt[fail.Fail].some{fail.user(diagnostic_kind.EDITOR_TARGET_SELECTION, "a standalone buffer requires a resolved target, not a project target name")}; }
        ret err[fail.Fail].err{fail.message("a standalone buffer requires a resolved target, not a project target name")};
    }
    val registry: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel registry.err) { ret err[fail.Fail].err{registry.err}; }
    var host_request: lang_target.TargetRequest = lang_target.host_request();
    var host:         lang_target.Binding;
    var selected:     *lang_target.Binding      = req.standalone_target;
    if (selected == nil) {
        val resolved: res[lang_target.Binding, fail.Fail] = lang_target.resolve(registry.ok, ?host_request);
        if (sel resolved.err) { ret err[fail.Fail].err{resolved.err}; }
        host     = resolved.ok;
        selected = ?host;
    }
    if (selected.isa == nil) { ret err[fail.Fail].err{fail.message("standalone analysis requires a resolved target with an instruction set")}; }
    comptime.dnit(?b.ctx);
    b.ctx           = driver_load.target_context(es.alloc, selected, ?req.standalone_build, intern.STR_NIL, intern.STR_NIL);
    b.context_ready = true;
    ret err[fail.Fail].ok{};
}

# release a buffer's semantic result, when it holds one and owns it
fun sema_drop(es: *EditorSession, b: *Buffer) {
    if (b.sr == nil) { ret; }
    if (b.owned) {
        fe_sema.result_dnit(b.sr);
        A.deallocate[fe_sema.SemaResult](es.alloc, b.sr, 1);
    }
    b.sr = nil;
}

# release a buffer's resolution and semantic results, when it holds them and owns them
fun rr_drop(es: *EditorSession, b: *Buffer) {
    sema_drop(es, b);
    if (b.rr == nil) { ret; }
    if (b.owned) {
        resolve.result_dnit(b.rr);
        A.deallocate[resolve.ResolveResult](es.alloc, b.rr, 1);
    }
    b.rr = nil;
}

fun analysis_drop(es: *EditorSession, b: *Buffer) {
    rr_drop(es, b);
    if (b.a != nil) {
        if (b.owned) {
            ast.dnit(b.a);
            A.deallocate[ast.Ast](es.alloc, b.a, 1);
        }
        b.a = nil;
    }
    comptime.dnit(?b.ctx);
    comptime.dnit(?b.view);
    b.parse_status  = fail.accepted();
    b.context_ready = false;
    b.owned         = true;
}

fun buffer_free(es: *EditorSession, b: *Buffer) {
    if (!b.in_use) { ret; }
    analysis_drop(es, b);
    b.in_use = false;
}
