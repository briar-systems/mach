    if (sel res_fid.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val fid: source.FileId = res_fid.ok;

    val res_resolve_1: res[*resolve.ResolveResult, fail.Fail] = resolve_buffer(?es, fid);
    if (sel res_resolve_1.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val len_1: usize = diagnostic.len(?es.s.diags);
    if (len_1 == 0) { t_dnit(?es); session.dnit(?s); ret 1; }

    val res_resolve_2: res[*resolve.ResolveResult, fail.Fail] = resolve_buffer(?es, fid);
    if (sel res_resolve_2.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val len_2: usize = diagnostic.len(?es.s.diags);

    if (len_2 != len_1) { t_dnit(?es); session.dnit(?s); ret 1; }

    t_dnit(?es);
    session.dnit(?s);
    ret 0;
}

