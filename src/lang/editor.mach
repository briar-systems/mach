# one reusable slot for a currently open file
pub rec Buffer {
    file_id: source.FileId;
    in_use:  bool;
    owned:   bool;
    a:       *ast.Ast;
    parse_status: fail.PhaseStatus;
    context_ready: bool;
    rr:      *resolve.ResolveResult;
    sr:      *context.SemaResult;
    ctx:     comptime.ComptimeCtx;
}

# one serial facade over a borrowed session, with compact open-buffer slots
pub rec EditorSession {
    s:       *session.Session;
    alloc:   *A.Allocator;
    buffers: *Buffer;
    buf_len: u32;
    view_generation: u64;
    active_request: *AnalysisRequest;
    operation_failure: opt[outcome.Fail];

    proj_backing:    A.Allocator;
    proj_arena:      arena.Arena;
    proj_alloc:      A.Allocator;
    proj_loaded:     bool;
    proj:            project.Project;
    proj_root:       str;
    proj_dirty:      bool;
    proj_roots:      *intern.StrId;
    proj_root_count: u32;
    proj_root_cap:   u32;
}

pub def AnalysisPhase: driver.FrontendPhase;
pub val PHASE_PARSE: AnalysisPhase = driver.FRONTEND_PARSE;
pub val PHASE_RESOLVE: AnalysisPhase = driver.FRONTEND_RESOLVE;
pub val PHASE_SEMA: AnalysisPhase = driver.FRONTEND_SEMA;

pub rec AnalysisRequest {
    file: source.FileId;
    phase: AnalysisPhase;
    build: request.BuildRequest;
    standalone_target: *target.Target;
}

pub rec AnalysisTarget {
    os: u32;
    arch: u32;
    abi: u32;
    mode: u32;
    pie: u32;
    pointer_width: u32;
    vector_bits: u32;
    has_float: bool;
    va_list_size: u32;
    va_list_align: u32;
}

pub rec AnalysisSource {
    id: source.FileId;
    file: source.SourceFile;
}

pub rec AnalysisResult {
    alloc: *A.Allocator;
    editor: *EditorSession;
    session: *session.Session;
    view_generation: u64;
    session_generation: u64;
    query_operation: u64;
    query_revision: query.Revision;
    file: source.FileId;
    source_revision: u64;
    phase: AnalysisPhase;
    status: fail.PhaseStatus;
    failure: opt[outcome.Fail];
    target: AnalysisTarget;
    target_available: bool;
    configuration: query.QueryOutput;
    project_root: str;
    profile: str;
    message: str;
    diagnostics: *diagnostic.DiagnosticStore;
    sources: Vector[AnalysisSource];
}

pub fun analysis_request(file: source.FileId, phase: AnalysisPhase) AnalysisRequest {
    ret AnalysisRequest{ file: file, phase: phase, build: request.defaults() };
}

pub fun analysis_dnit(result: *AnalysisResult) {
    if (result.alloc == nil) { ret; }
    if (result.diagnostics != nil) {
        diagnostic.store_dnit(result.diagnostics);
        A.deallocate[diagnostic.DiagnosticStore](result.alloc, result.diagnostics, 1);
    }
    var i: usize = 0;
    for (i < result.sources.len) {
        source.dnit_file(?result.sources.data[i].file, result.alloc);
        i = i + 1;
    }
    vector.dnit[AnalysisSource](?result.sources);
    if (result.configuration.bytes != nil) { A.deallocate[u8](result.alloc, result.configuration.bytes, result.configuration.len::usize); }
    str_free(result.alloc, result.project_root);
    str_free(result.alloc, result.profile);
    str_free(result.alloc, result.message);
    @result = AnalysisResult{};
}

pub fun analysis_source(result: *AnalysisResult, file: source.FileId) opt[*source.SourceFile] {
    var i: usize = 0;
    for (i < result.sources.len) {
        if (result.sources.data[i].id == file) { ret opt[*source.SourceFile].some{?result.sources.data[i].file}; }
        i = i + 1;
    }
    ret opt[*source.SourceFile].none{};
}

fun result_buffer(result: *AnalysisResult) res[*Buffer, fail.Fail] {
    val es: *EditorSession = result.editor;
    if (result.alloc == nil || es == nil || result.session != es.s
        || result.view_generation != es.view_generation || result.session_generation != es.s.view_generation
        || result.session_generation == ~(0::u64) || result.query_operation != es.s.queries.operation_sequence
        || result.query_revision != es.s.queries.revision) { ret res[*Buffer, fail.Fail].err{fail.message("editor analysis view has expired")}; }
    val b: *Buffer = slot_live(es, result.file);
    if (b == nil) { ret res[*Buffer, fail.Fail].err{fail.message("editor analysis buffer has retired")}; }
    val file: opt[*source.SourceFile] = source.get(?es.s.sources, result.file);
    if (sel file.none) { ret res[*Buffer, fail.Fail].err{fail.message("editor analysis source has changed")}; }
    if (!file.some.present) { ret res[*Buffer, fail.Fail].err{fail.message("editor analysis source has changed")}; }
    if (file.some.revision != result.source_revision) { ret res[*Buffer, fail.Fail].err{fail.message("editor analysis source has changed")}; }
    ret res[*Buffer, fail.Fail].ok{b};
}

# raw products borrow the current serial view until the next mutation-capable session call
pub fun ast_of(result: *AnalysisResult) res[*ast.Ast, fail.Fail] {
    val buffer: res[*Buffer, fail.Fail] = result_buffer(result);
    if (sel buffer.err) { ret res[*ast.Ast, fail.Fail].err{buffer.err}; }
    ret res[*ast.Ast, fail.Fail].ok{buffer.ok.a};
}

pub fun resolve_of(result: *AnalysisResult) res[*resolve.ResolveResult, fail.Fail] {
    val buffer: res[*Buffer, fail.Fail] = result_buffer(result);
    if (sel buffer.err) { ret res[*resolve.ResolveResult, fail.Fail].err{buffer.err}; }
    if (result.phase < PHASE_RESOLVE) { ret res[*resolve.ResolveResult, fail.Fail].err{fail.message("analysis did not request resolution")}; }
    ret res[*resolve.ResolveResult, fail.Fail].ok{buffer.ok.rr};
}

pub fun sema_of(result: *AnalysisResult) res[*context.SemaResult, fail.Fail] {
    val buffer: res[*Buffer, fail.Fail] = result_buffer(result);
    if (sel buffer.err) { ret res[*context.SemaResult, fail.Fail].err{buffer.err}; }
    if (result.phase != PHASE_SEMA) { ret res[*context.SemaResult, fail.Fail].err{fail.message("analysis did not request type checking")}; }
    ret res[*context.SemaResult, fail.Fail].ok{buffer.ok.sr};
}

fun snapshot_source(result: *AnalysisResult, s: *session.Session, file: source.FileId) err[fail.Fail] {
    val analysis_source_r: opt[*source.SourceFile] = analysis_source(result, file);
    if (file == source.FILE_NIL) { ret err[fail.Fail].ok{}; }
    if (sel analysis_source_r.some) { ret err[fail.Fail].ok{}; }
    val current: opt[*source.SourceFile] = source.get(?s.sources, file);
    if (sel current.none) {
        ret err[fail.Fail].err{fail.message("analysis diagnostic refers to an unavailable source version")};
    }
    if (!current.some.present) {
        ret err[fail.Fail].err{fail.message("analysis diagnostic refers to an unavailable source version")};
    }
    val copied: res[source.SourceFile, fail.Fail] = source.copy_file(current.some, result.alloc);
    if (sel copied.err) { ret err[fail.Fail].err{copied.err}; }
    var entry: AnalysisSource = AnalysisSource{ id: file, file: copied.ok };
    val added: res[usize, A.Error] = vector.push[AnalysisSource](?result.sources, entry);
    if (sel added.err) {
        source.dnit_file(?entry.file, result.alloc);
        ret err[fail.Fail].err{fail.refused(added.err)};
    }
    ret err[fail.Fail].ok{};
}

fun target_snapshot(env: *comptime.ComptimeEnv) AnalysisTarget {
    ret AnalysisTarget{
        os: env.target_os_id, arch: env.target_arch_id, abi: env.target_abi_id,
        mode: env.build_mode_id, pie: env.build_pie, pointer_width: env.pointer_width,
        vector_bits: env.vector_bits, has_float: env.has_float,
        va_list_size: env.va_list_size, va_list_align: env.va_list_align
    };
}

fun snapshot_analysis(es: *EditorSession, req: *AnalysisRequest, status: fail.PhaseStatus,
                      failure: opt[outcome.Fail]) res[AnalysisResult, fail.Fail] {
    var result: AnalysisResult = AnalysisResult{
        alloc: es.alloc, editor: es, session: es.s, file: req.file, phase: req.phase,
        status: status, failure: failure, sources: vector.init[AnalysisSource](es.alloc)
    };
    var complete: bool = false;
    fin { if (!complete) { analysis_dnit(?result); } }
    val diagnostics: res[*diagnostic.DiagnosticStore, fail.Fail] = diagnostic.snapshot_from(?es.s.diags, 0, es.alloc);
    if (sel diagnostics.err) { ret res[AnalysisResult, fail.Fail].err{diagnostics.err}; }
    result.diagnostics = diagnostics.ok;
    val copied: err[fail.Fail] = snapshot_source(?result, es.s, req.file);
    if (sel copied.err) { ret res[AnalysisResult, fail.Fail].err{copied.err}; }
    var i: usize = 0;
    for (i < diagnostic.len(result.diagnostics)) {
        val d: *diagnostic.Diagnostic = ?result.diagnostics.items.data[i];
        val main: err[fail.Fail] = snapshot_source(?result, es.s, d.loc.file_id);
        if (sel main.err) { ret res[AnalysisResult, fail.Fail].err{main.err}; }
        var j: usize = 0;
        for (j < d.related.len) {
            val related: err[fail.Fail] = snapshot_source(?result, es.s, d.related.data[j].loc.file_id);
            if (sel related.err) { ret res[AnalysisResult, fail.Fail].err{related.err}; }
            j = j + 1;
        }
        j = 0;
        for (j < d.fixes.len) {
            var k: usize = 0;
            for (k < d.fixes.data[j].edits.len) {
                val edit: err[fail.Fail] = snapshot_source(?result, es.s, d.fixes.data[j].edits.data[k].loc.file_id);
                if (sel edit.err) { ret res[AnalysisResult, fail.Fail].err{edit.err}; }
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    val b: *Buffer = slot_live(es, req.file);
    if (b.context_ready) { result.target = target_snapshot(?b.ctx.env); result.target_available = true; }
    if (es.proj_loaded) {
        val config: res[query.QueryOutput, fail.Fail] = passes.capture_build_config(?es.proj, es.alloc);
        if (sel config.err) { ret res[AnalysisResult, fail.Fail].err{config.err}; }
        result.configuration = config.ok;
        val root: res[str, string.StrError] = str_copy(es.alloc, es.proj_root);
        if (sel root.err) { ret res[AnalysisResult, fail.Fail].err{fail.str_refused(root.err)}; }
        result.project_root = root.ok;
        var mid: u32 = 0;
        for (mid < es.proj.module_len) {
            if (es.proj.modules[mid].file_id == req.file) {
                result.target = target_snapshot(?es.proj.modules[mid].ctx.env);
                result.target_available = true;
                brk;
            }
            mid = mid + 1;
        }
    }
    var profile_name: str = req.build.profile;
    if (es.proj_loaded) {
        val name: opt[str] = intern.lookup(?es.s.interner, es.proj.config.profile);
        if (sel name.none) { ret res[AnalysisResult, fail.Fail].err{fail.message("analysis profile has no stable spelling")}; }
        profile_name = name.some;
    }
    val profile: res[str, string.StrError] = str_copy(es.alloc, profile_name);
    if (sel profile.err) { ret res[AnalysisResult, fail.Fail].err{fail.str_refused(profile.err)}; }
    result.profile = profile.ok;
    var message: str = "";
    val status_text: opt[str] = fail.internal_text(status);
    if (sel status_text.some) { message = status_text.some; }
    if (sel failure.some) {
        val failure_text: opt[str] = outcome.text(failure.some);
        if (sel failure_text.some) { message = failure_text.some; }
    }
    val owned_message: res[str, string.StrError] = str_copy(es.alloc, message);
    if (sel owned_message.err) { ret res[AnalysisResult, fail.Fail].err{fail.str_refused(owned_message.err)}; }
    result.message = owned_message.ok;
    if (sel status_text.some) { result.status.kind = fail.PhaseKind.internal{result.message}; }
    if (sel failure.some) {
        result.failure = opt[outcome.Fail].some{outcome.with_text(failure.some, result.message)};
    }
    val analysis_source_r: opt[*source.SourceFile] = analysis_source(?result, req.file);
    if (sel analysis_source_r.none) { ret res[AnalysisResult, fail.Fail].err{fail.message("an element is absent where the snapshot analysis expected it")}; }
    result.source_revision = analysis_source_r.some.revision;
    result.view_generation = es.view_generation;
    result.session_generation = es.s.view_generation;
    result.query_operation = es.s.queries.operation_sequence;
    result.query_revision = es.s.queries.revision;
    complete = true;
    ret res[AnalysisResult, fail.Fail].ok{result};
}

# returned diagnostics own their source versions; raw products borrow this serial session view
pub fun analyze(es: *EditorSession, req: *AnalysisRequest) res[AnalysisResult, outcome.Fail] {
    if (req == nil || req.phase > PHASE_SEMA || slot_live(es, req.file) == nil) {
        ret res[AnalysisResult, outcome.Fail].err{fail_owned(es, outcome.user("analysis requires an open buffer and a valid phase"))};
    }
    if (es.active_request != nil || es.s.queries.operation_active || es.s.queries.presentation_pending) {
        ret res[AnalysisResult, outcome.Fail].err{fail_owned(es, outcome.internal("editor analysis cannot nest active query use"))};
    }
    if (es.view_generation == ~(0::u64) || es.s.view_generation == ~(0::u64)) {
        ret res[AnalysisResult, outcome.Fail].err{fail_owned(es, outcome.internal("editor view generation exhausted"))};
    }
    es.view_generation = es.view_generation + 1;
    views_drop(es);
    es.proj_dirty = true;
    es.active_request = req;
    es.operation_failure = opt[outcome.Fail].none{};
    fin {
        es.active_request = nil;
        es.operation_failure = opt[outcome.Fail].none{};
        if (es.proj_loaded) { es.proj.req = request.defaults(); }
    }
    var work: err[fail.Fail] = err[fail.Fail].ok{};
    if (req.phase == PHASE_PARSE) {
        val parsed: res[*ast.Ast, fail.Fail] = parse_buffer(es, req.file);
        if (sel parsed.err) { work = err[fail.Fail].err{parsed.err}; }
    }
    or (req.phase == PHASE_RESOLVE) {
        val resolved: res[*resolve.ResolveResult, fail.Fail] = resolve_buffer(es, req.file);
        if (sel resolved.err) { work = err[fail.Fail].err{resolved.err}; }
    }
    or {
        val analyzed: res[*context.SemaResult, fail.Fail] = analyze_buffer(es, req.file);
        if (sel analyzed.err) { work = err[fail.Fail].err{analyzed.err}; }
    }
    val b: *Buffer = slot_live(es, req.file);
    if (b.owned && req.phase == PHASE_PARSE) {
        val seeded: err[fail.Fail] = ctx_seed(es, b);
        val work_ok: bool = sel work.ok;
        if (work_ok) { work = seeded; }
    }
    var status: fail.PhaseStatus = b.parse_status;
    if (req.phase >= PHASE_RESOLVE && b.rr != nil) { fail.merge(?status, b.rr.status); }
    if (req.phase == PHASE_SEMA && b.sr != nil) { fail.merge(?status, b.sr.status); }
    var failure: opt[outcome.Fail] = es.operation_failure;
    if (sel work.err) {
        val failure_none: bool = sel failure.none;
        if (failure_none) { failure = opt[outcome.Fail].some{outcome.from_fail(work.err)}; }
        if (sel failure.some) {
            val f: outcome.Fail = failure.some;
            if (sel f.reported || sel f.user) { fail.reject(?status); }
            or { fail.internal(?status, outcome.describe(f)); }
        }
    }
    if (es.s.view_generation == ~(0::u64)) {
        ret res[AnalysisResult, outcome.Fail].err{fail_owned(es, outcome.internal("editor view generation exhausted"))};
    }
    val result: res[AnalysisResult, fail.Fail] = snapshot_analysis(es, req, status, failure);
    if (sel result.err) {
        ret res[AnalysisResult, outcome.Fail].err{fail_owned(es, outcome.from_fail(result.err))};
    }
    ret res[AnalysisResult, outcome.Fail].ok{result.ok};
}

pub fun expr_type_of(result: *AnalysisResult, eid: id.ExprId) res[type.TypeId, fail.Fail] {
    val checked: res[*context.SemaResult, fail.Fail] = sema_of(result);
    if (sel checked.err) { ret res[type.TypeId, fail.Fail].err{checked.err}; }
    ret res[type.TypeId, fail.Fail].ok{buffer_expr_type(result.editor, result.file, eid)};
}

pub fun decl_type_of(result: *AnalysisResult, did: id.DeclId) res[type.TypeId, fail.Fail] {
    val checked: res[*context.SemaResult, fail.Fail] = sema_of(result);
    if (sel checked.err) { ret res[type.TypeId, fail.Fail].err{checked.err}; }
    ret res[type.TypeId, fail.Fail].ok{buffer_decl_type(result.editor, result.file, did)};
}

pub fun resolved_type_of(result: *AnalysisResult, tid: id.TypeId) res[type.TypeId, fail.Fail] {
    val checked: res[*context.SemaResult, fail.Fail] = sema_of(result);
    if (sel checked.err) { ret res[type.TypeId, fail.Fail].err{checked.err}; }
    ret res[type.TypeId, fail.Fail].ok{buffer_resolved_type(result.editor, result.file, tid)};
}

val BUFFERS_SEED: u32 = 8;

pub fun init(s: *session.Session) EditorSession {
    var es: EditorSession;
    es.s       = s;
    es.alloc   = s.alloc;
    es.buffers = nil;
    es.buf_len = 0;
    es.view_generation = 1;
    es.active_request = nil;
    es.operation_failure = opt[outcome.Fail].none{};

    es.proj_loaded     = false;
    es.proj_root        = nil;
    es.proj_dirty        = false;
    es.proj_roots        = nil;
    es.proj_root_count   = 0;
    es.proj_root_cap     = 0;
    ret es;
}

fun destroy(es: *EditorSession) {
    if (es == nil) { ret; }
    if (es.buffers != nil && es.buf_len > 0) {
        var i: u32 = 0;
        for (i < es.buf_len) {
            buffer_free(es, ?es.buffers[i]);
            i = i + 1;
        }
        A.deallocate[Buffer](es.alloc, es.buffers, es.buf_len::usize);
    }
    es.buffers = nil;
    es.buf_len = 0;

    proj_teardown(es);
    if (es.proj_root != nil) { str_free(es.alloc, es.proj_root); es.proj_root = nil; }
    if (es.proj_roots != nil && es.proj_root_cap > 0) {
        A.deallocate[intern.StrId](es.alloc, es.proj_roots, es.proj_root_cap::usize);
    }
    es.proj_roots      = nil;
    es.proj_root_count = 0;
    es.proj_root_cap   = 0;
}

# register a buffer's text under a path and return its FileId
# the text is loaded into the session SourceMap and set as the overlay for path, so a
# project load reads the buffer instead of the file on disk; marks the project dirty
# ---
# es: the editor session
# path: the buffer's path; used to find the enclosing project and as the overlay key
# text: the buffer's full text
# ret: the FileId every other entry takes, or the SourceMap, slot, or overlay error
pub fun open(es: *EditorSession, path: str, text: str) res[source.FileId, fail.Fail] {
    if (es.s.queries.operation_active || es.s.queries.presentation_pending) {
        ret res[source.FileId, fail.Fail].err{fail.message("cannot change an editor buffer during query use")};
    }
    if (es.view_generation == ~(0::u64)) { ret res[source.FileId, fail.Fail].err{fail.message("editor view generation exhausted")}; }
    if (str_len(text) > 0xFFFFFFFF::usize) { ret res[source.FileId, fail.Fail].err{fail.message("source input exceeds the query byte extent")}; }
    val overlay_r: res[session.PreparedOverlay, fail.Fail] = session.prepare_overlay(es.s, path, text, false);
    if (sel overlay_r.err) {
        ret res[source.FileId, fail.Fail].err{overlay_r.err};
    }
    var overlay: session.PreparedOverlay = overlay_r.ok;
    fin { session.discard_overlay(?overlay); }
    val source_r: res[source.PreparedLoad, fail.Fail] = source.prepare_load(?es.s.sources, ?es.s.interner, overlay.key, text);
    if (sel source_r.err) {
        ret res[source.FileId, fail.Fail].err{source_r.err};
    }
    var prepared: source.PreparedLoad = source_r.ok;
    fin { source.discard_load(?prepared); }
    val reserved: res[u32, fail.Fail] = slot_reserve(es, prepared.id);
    if (sel reserved.err) { ret res[source.FileId, fail.Fail].err{reserved.err}; }
    val index: u32 = reserved.ok;
    val changed: bool = prepared.changed || overlay.changed || !es.buffers[index].in_use;
    val input: err[fail.Fail] = query.set_input(?es.s.queries, query.Q_FILE_TEXT, prepared.id::u64, text::*u8, str_len(text)::u32);
    if (sel input.err) { ret res[source.FileId, fail.Fail].err{input.err}; }
    if (changed) { views_drop(es); }
    val fid: source.FileId = source.commit_load(?prepared);
    session.commit_overlay(?overlay);
    val b: *Buffer = ?es.buffers[index];
    if (!b.in_use) {
        @b = Buffer{ file_id: fid, in_use: true, owned: true, parse_status: fail.accepted() };
        b.ctx = host_ctx(es);
    }
    if (changed) {
        es.view_generation = es.view_generation + 1;
        es.proj_dirty = true;
    }
    ret res[source.FileId, fail.Fail].ok{fid};
}

# replace an open buffer's text and drop its cached analysis
# ---
# es: the editor session
# fid: the buffer's FileId from open
# text: the new full text
# ret: ok(true) when the text changed; ok(false) when the buffer is not open or the text
#  is identical, in which case nothing is dropped; or the SourceMap or overlay error
pub fun update(es: *EditorSession, fid: source.FileId, text: str) res[bool, fail.Fail] {
    if (slot_live(es, fid) == nil) { ret res[bool, fail.Fail].ok{false}; }
    val file: opt[*source.SourceFile] = source.get(?es.s.sources, fid);
    if (sel file.none) { ret res[bool, fail.Fail].err{fail.message("open editor buffer has no source identity")}; }
    val generation: u64 = es.view_generation;
    val updated: res[source.FileId, fail.Fail] = open(es, file.some.path, text);
    if (sel updated.err) { ret res[bool, fail.Fail].err{updated.err}; }
    ret res[bool, fail.Fail].ok{es.view_generation != generation};
}

fun removal_order(a: *session.PreparedOverlay, b: *session.PreparedOverlay) i64 {
    if (a.index > b.index) { ret -1; }
    if (a.index < b.index) { ret 1; }
    ret 0;
}

fun retire_buffers(es: *EditorSession, fid: source.FileId, all: bool) err[fail.Fail] {
    if (es.view_generation == ~(0::u64)) { ret err[fail.Fail].err{fail.message("editor view generation exhausted")}; }
    var roots: Vector[query.QueryKey] = vector.init[query.QueryKey](es.alloc);
    fin { vector.dnit[query.QueryKey](?roots); }
    var overlays: Vector[session.PreparedOverlay] = vector.init[session.PreparedOverlay](es.alloc);
    fin {
        var j: usize = 0;
        for (j < overlays.len) { session.discard_overlay(?overlays.data[j]); j = j + 1; }
        vector.dnit[session.PreparedOverlay](?overlays);
    }
    var i: u32 = 0;
    for (i < es.buf_len) {
        val b: *Buffer = ?es.buffers[i];
        if (b.in_use && (all || b.file_id == fid)) {
            val checked: err[fail.Fail] = source.prepare_release(?es.s.sources, b.file_id);
            if (sel checked.err) { ret checked; }
            val get_r: opt[*source.SourceFile] = source.get(?es.s.sources, b.file_id);
            if (sel get_r.none) { ret err[fail.Fail].err{fail.message("an element is absent where the retire buffers expected it")}; }
            val file: *source.SourceFile = get_r.some;
            val overlay_r: res[session.PreparedOverlay, fail.Fail] = session.prepare_overlay(es.s, file.path, nil, true);
            if (sel overlay_r.err) { ret err[fail.Fail].err{overlay_r.err}; }
            var overlay: session.PreparedOverlay = overlay_r.ok;
            val added: res[usize, A.Error] = vector.push[session.PreparedOverlay](?overlays, overlay);
            if (sel added.err) {
                session.discard_overlay(?overlay);
                ret err[fail.Fail].err{fail.refused(added.err)};
            }
            val rooted: res[usize, A.Error] = vector.push[query.QueryKey](?roots,
                query.QueryKey{ kind: query.Q_FILE_TEXT, key: b.file_id::u64 });
            if (sel rooted.err) { ret err[fail.Fail].err{fail.refused(rooted.err)}; }
        }
        i = i + 1;
    }
    if (roots.len == 0) {
        if (es.s.queries.operation_active || es.s.queries.presentation_pending) {
            ret err[fail.Fail].err{fail.message("cannot retire editor state during query use")};
        }
        views_drop(es);
        es.view_generation = es.view_generation + 1;
        ret err[fail.Fail].ok{};
    }
    sort.sort[session.PreparedOverlay](overlays.data, overlays.len, removal_order);
    val retired_r: res[query.PreparedRetirement, fail.Fail] = query.prepare_retirement(?es.s.queries, roots.data, roots.len);
    if (sel retired_r.err) { ret err[fail.Fail].err{retired_r.err}; }
    var retired: query.PreparedRetirement = retired_r.ok;
    fin { query.discard_retirement(?retired); }
    val valid: err[fail.Fail] = query.validate_retirement(?retired);
    if (sel valid.err) { ret valid; }
    views_drop(es);
    val commit_retirement_r: err[fail.Fail] = query.commit_retirement(?retired);
    var j: usize = 0;
    for (j < roots.len) {
        session.commit_overlay(?overlays.data[j]);
        val closed: source.FileId = roots.data[j].key::source.FileId;
        source.release_payload(?es.s.sources, closed);
        @slot_live(es, closed) = Buffer{};
        j = j + 1;
    }
    es.proj_root_count = 0;
    es.proj_dirty = true;
    es.view_generation = es.view_generation + 1;
    ret err[fail.Fail].ok{};
}

pub fun close(es: *EditorSession, fid: source.FileId) res[bool, fail.Fail] {
    if (slot_live(es, fid) == nil) { ret res[bool, fail.Fail].ok{false}; }
    val retired: err[fail.Fail] = retire_buffers(es, fid, false);
    if (sel retired.err) { ret res[bool, fail.Fail].err{retired.err}; }
    ret res[bool, fail.Fail].ok{true};
}

pub fun dnit(es: *EditorSession) err[fail.Fail] {
    if (es == nil) { ret err[fail.Fail].ok{}; }
    val retired: err[fail.Fail] = retire_buffers(es, source.FILE_NIL, true);
    if (sel retired.err) { ret retired; }
    destroy(es);
    ret err[fail.Fail].ok{};
}

# token storage is caller-owned; source bytes borrow the owned analysis result
pub fun tokenize(result: *AnalysisResult) res[lexer.TokenStream, fail.Fail] {
    val file: opt[*source.SourceFile] = analysis_source(result, result.file);
    if (sel file.none) { ret res[lexer.TokenStream, fail.Fail].err{fail.message("analysis has no owned source version")}; }
    ret lexer.tokenize(file.some.text, result.alloc, result.file);
}

# parse an open buffer, best effort: syntax errors become diagnostics and the tree is still
# returned. resets the session diagnostics first. a buffer under the src directory of a
# project whose mach.toml lies above it is analyzed as part of that project (loaded, or
# reloaded when dirty) and the project's own tree for that module is returned
# ---
# es: the editor session
# fid: the buffer's FileId
# ret: the tree, owned by the session or by the loaded project, or the buffer-not-open,
#  project-load, or fatal-parse error
fun parse_buffer(es: *EditorSession, fid: source.FileId) res[*ast.Ast, fail.Fail] {
    diags_reset(es);

    val b: *Buffer = slot_live(es, fid);
    if (b == nil) { ret res[*ast.Ast, fail.Fail].err{fail.message("editor: buffer not open")}; }

    val pe_r: res[opt[*project.ModuleEntry], fail.Fail] = proj_ensure(es, fid);
    if (sel pe_r.err) {
        ret res[*ast.Ast, fail.Fail].err{pe_r.err};
    }
    val pe: opt[*project.ModuleEntry] = pe_r.ok;
    if (sel pe.some) {
        val m: *project.ModuleEntry = pe.some;
        if (m.a == nil) { ret res[*ast.Ast, fail.Fail].err{fail.message("editor: project module has no parsed AST")}; }
        analysis_drop(es, b);
        b.owned = false;
        b.a     = m.a;
        b.parse_status = m.parse_status;
        ret res[*ast.Ast, fail.Fail].ok{b.a};
    }

    ret parse_inner(es, fid);
}

# resolve names in an open buffer, best effort: unresolved names become diagnostics and
# SYMBOL_REJECTED expression slots. resets the session diagnostics first. a buffer inside a project returns
# the project's resolve result for that module; a standalone buffer is parsed if needed and
# resolved with no dependencies, so every `use` binds to SYMBOL_NIL
# ---
# es: the editor session
# fid: the buffer's FileId
# ret: the side tables, cached until the next update, or the buffer-not-open, project-load,
#  parse, or resolve error
fun resolve_buffer(es: *EditorSession, fid: source.FileId) res[*resolve.ResolveResult, fail.Fail] {
    diags_reset(es);

    val b: *Buffer = slot_live(es, fid);
    if (b == nil) { ret res[*resolve.ResolveResult, fail.Fail].err{fail.message("editor: buffer not open")}; }

    val pe_r: res[opt[*project.ModuleEntry], fail.Fail] = proj_ensure(es, fid);
    if (sel pe_r.err) {
        ret res[*resolve.ResolveResult, fail.Fail].err{pe_r.err};
    }
    val pe: opt[*project.ModuleEntry] = pe_r.ok;
    if (sel pe.some) {
        val m: *project.ModuleEntry = pe.some;
        if (m.a == nil || m.resolve_result == nil) { ret res[*resolve.ResolveResult, fail.Fail].err{fail.message("editor: project module has no resolve result")}; }
        analysis_drop(es, b);
        b.owned = false;
        b.a     = m.a;
        b.parse_status = m.parse_status;
        b.rr    = m.resolve_result;
        ret res[*resolve.ResolveResult, fail.Fail].ok{b.rr};
    }

    if (b.a == nil || !b.owned) {
        val res_parse: res[*ast.Ast, fail.Fail] = parse_inner(es, fid);
        if (sel res_parse.err) {
            ret res[*resolve.ResolveResult, fail.Fail].err{res_parse.err};
        }
    }

    var deps: resolve.ResolveDeps;
    deps.entries = nil;
    deps.count   = 0;
    ret buffer_resolve(es, b, ?deps);
}

# reset the session diagnostics, lex and parse the buffer standalone, and return the
# syntactic diagnostics. never consults the project, so resolve-stage help and related
# entries are absent
# ---
# es: the editor session
# fid: the buffer's FileId
# ret: the session's diagnostic store, borrowed, or the buffer-not-open or fatal-parse error
fun diagnostics_buffer(es: *EditorSession, fid: source.FileId) res[*diagnostic.DiagnosticStore, fail.Fail] {
    diags_reset(es);

    val res_parse: res[*ast.Ast, fail.Fail] = parse_inner(es, fid);
    if (sel res_parse.err) {
        ret res[*diagnostic.DiagnosticStore, fail.Fail].err{res_parse.err};
    }
    ret res[*diagnostic.DiagnosticStore, fail.Fail].ok{?es.s.diags};
}

# the cached tree of an open buffer
# ---
# es: the editor session
# fid: the buffer's FileId
# ret: the tree from the last parse or resolve, or nil when the buffer is not open or not yet parsed
fun buffer_ast(es: *EditorSession, fid: source.FileId) *ast.Ast {
    val b: *Buffer = slot_live(es, fid);
    if (b == nil) { ret nil; }
    ret b.a;
}

# the cached resolve result of an open buffer
# ---
# es: the editor session
# fid: the buffer's FileId
# ret: the side tables from the last resolve, or nil when the buffer is not open or not yet resolved
fun buffer_resolve_of(es: *EditorSession, fid: source.FileId) *resolve.ResolveResult {
    val b: *Buffer = slot_live(es, fid);
    if (b == nil) { ret nil; }
    ret b.rr;
}

# resolve, then type-check an open buffer
# a buffer inside a project returns the project's sema result for that module; a standalone
# buffer is registered as its own module and checked with no dependencies
# ---
# es: the editor session
# fid: the buffer's FileId
# ret: the sema result, cached until the next update, or the resolve, registration, sema,
#  or allocation error
fun analyze_buffer(es: *EditorSession, fid: source.FileId) res[*context.SemaResult, fail.Fail] {
    val res_resolve: res[*resolve.ResolveResult, fail.Fail] = resolve_buffer(es, fid);
    if (sel res_resolve.err) {
        ret res[*context.SemaResult, fail.Fail].err{res_resolve.err};
    }
    val rr: *resolve.ResolveResult = res_resolve.ok;

    val b: *Buffer = slot_live(es, fid);
    if (b == nil) { ret res[*context.SemaResult, fail.Fail].err{fail.message("editor: buffer not open")}; }

    if (!b.owned) {
        val pe_r: res[opt[*project.ModuleEntry], fail.Fail] = proj_ensure(es, fid);
        if (sel pe_r.err) {
            ret res[*context.SemaResult, fail.Fail].err{pe_r.err};
        }
        val pe: opt[*project.ModuleEntry] = pe_r.ok;
        if (sel pe.none) { ret res[*context.SemaResult, fail.Fail].err{fail.message("editor: project module no longer available")}; }
        val m: *project.ModuleEntry = pe.some;
        if (m.sema_result == nil) { ret res[*context.SemaResult, fail.Fail].err{fail.message("editor: project module has no sema result")}; }
        b.sr = m.sema_result;
        ret res[*context.SemaResult, fail.Fail].ok{b.sr};
    }

    sema_drop(es, b);
    val res_register: err[fail.Fail] = session.register_module_ast(es.s, fid::session.ModuleId, b.a);
    if (sel res_register.err) {
        ret res[*context.SemaResult, fail.Fail].err{res_register.err};
    }

    var deps: context.SemaDeps = context.SemaDeps{};
    deps.definitions = context.reader_init(es::ptr, buffer_definition, es.alloc);
    fin { context.reader_dnit(?deps.definitions); }
    deps.entries = nil;
    deps.count   = 0;

    val res_sema: res[context.SemaResult, fail.Fail] = sema.sema(es.s, b.a, rr, ?deps, ?b.ctx, fid::session.ModuleId, ?es.s.diags);
    if (sel res_sema.err) {
        es.operation_failure = opt[outcome.Fail].some{outcome.from_fail(res_sema.err)};
        ret res[*context.SemaResult, fail.Fail].err{res_sema.err};
    }

    val sr_slot: res[*context.SemaResult, A.Error] = A.allocate[context.SemaResult](es.alloc, 1);
    if (sel sr_slot.err) {
        var sr_owned: context.SemaResult = res_sema.ok;
        sema.dnit_result(?sr_owned);
        if (sel sr_slot.err) { ret res[*context.SemaResult, fail.Fail].err{fail.refused(sr_slot.err)}; }
        ret res[*context.SemaResult, fail.Fail].ok{sr_slot.ok};
    }
    val sr: *context.SemaResult = sr_slot.ok;
    @sr = res_sema.ok;
    b.sr = sr;
    ret res[*context.SemaResult, fail.Fail].ok{sr};
}

# the cached sema result of an open buffer
# ---
# es: the editor session
# fid: the buffer's FileId
# ret: the result from the last analyze, or nil when the buffer is not open or not yet analyzed
fun buffer_sema(es: *EditorSession, fid: source.FileId) *context.SemaResult {
    val b: *Buffer = slot_live(es, fid);
    if (b == nil) { ret nil; }
    ret b.sr;
}

# the type sema assigned to an expression of an analyzed buffer
# ---
# es: the editor session
# fid: the buffer's FileId
# eid: an expression id of the buffer's tree
# ret: the TypeId; TYPE_NIL for EXPR_NIL; TYPE_ERROR when the buffer is not open, not
#  analyzed, or eid is out of range
fun buffer_expr_type(es: *EditorSession, fid: source.FileId, eid: id.ExprId) type.TypeId {
    if (eid == id.EXPR_NIL) { ret type.TYPE_NIL; }
    val b: *Buffer = slot_live(es, fid);
    if (b == nil || b.sr == nil || b.sr.expr_type == nil) { ret type.TYPE_ERROR; }
    if (eid >= b.sr.expr_count) { ret type.TYPE_ERROR; }
    ret b.sr.expr_type[eid];
}

# the type sema assigned to a declaration of an analyzed buffer
# ---
# es: the editor session
# fid: the buffer's FileId
# did: a declaration id of the buffer's tree
# ret: the TypeId; TYPE_NIL for DECL_NIL; TYPE_ERROR when the buffer is not open, not
#  analyzed, or did is out of range
fun buffer_decl_type(es: *EditorSession, fid: source.FileId, did: id.DeclId) type.TypeId {
    if (did == id.DECL_NIL) { ret type.TYPE_NIL; }
    val b: *Buffer = slot_live(es, fid);
    if (b == nil || b.sr == nil || b.sr.decl_type == nil) { ret type.TYPE_ERROR; }
    if (did >= b.sr.decl_count) { ret type.TYPE_ERROR; }
    ret b.sr.decl_type[did];
}

# the TypeId a type expression of an analyzed buffer resolved to
# ---
# es: the editor session
# fid: the buffer's FileId
# tid: a type node id of the buffer's tree
# ret: the TypeId; TYPE_NIL for the TYPE_NIL node id; TYPE_ERROR when the buffer is not open,
#  not analyzed, or tid is out of range
fun buffer_resolved_type(es: *EditorSession, fid: source.FileId, tid: id.TypeId) type.TypeId {
    if (tid == id.TYPE_NIL) { ret type.TYPE_NIL; }
    val b: *Buffer = slot_live(es, fid);
    if (b == nil || b.sr == nil || b.sr.type_resolved_ty == nil) { ret type.TYPE_ERROR; }
    if (tid >= b.sr.type_count) { ret type.TYPE_ERROR; }
    ret b.sr.type_resolved_ty[tid];
}

val OOM_FAIL_MESSAGE: str = "out of memory";

# run a full build of a project through the warm engine, reading open buffers through the
# session's overlays. the manifest is loaded fresh on every call
# ---
# es: the editor session
# req: the build request; project_root must name the project directory
# ret: the build outcome, or a Fail whose message is a copy owned by the editor session;
#  release it with fail_dnit
pub fun build(es: *EditorSession, req: *request.BuildRequest) res[outcome.BuildOutcome, outcome.Fail] {
    if (es.active_request != nil || es.s.queries.operation_active || es.s.queries.presentation_pending) {
        ret res[outcome.BuildOutcome, outcome.Fail].err{fail_owned(es, outcome.internal("editor build cannot nest active query use"))};
    }
    if (es.view_generation == ~(0::u64)) {
        ret res[outcome.BuildOutcome, outcome.Fail].err{fail_owned(es, outcome.internal("editor view generation exhausted"))};
    }
    es.view_generation = es.view_generation + 1;
    views_drop(es);
    es.proj_dirty = true;
    val s: *session.Session = es.s;

    val reg_r: err[outcome.Fail] = driver.setup_registry(?s.registry);
    if (sel reg_r.err) {
        val f: outcome.Fail = fail_owned(es, reg_r.err);
        ret res[outcome.BuildOutcome, outcome.Fail].err{f};
    }

    var backing: A.Allocator;
    val make_r: err[A.Error] = page.make(?backing);
    if (sel make_r.err) {
        val f: outcome.Fail = fail_owned(es, outcome.internal("failed to initialise allocator"));
        ret res[outcome.BuildOutcome, outcome.Fail].err{f};
    }
    var ar: arena.Arena;
    val init_r: err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel init_r.err) {
        val f: outcome.Fail = fail_owned(es, outcome.internal("failed to initialise allocator"));
        ret res[outcome.BuildOutcome, outcome.Fail].err{f};
    }
    var al: A.Allocator;
    val make_r2: err[A.Error] = arena.make(?al, ?ar);
    if (sel make_r2.err) {
        arena.dnit(?ar);
        val f: outcome.Fail = fail_owned(es, outcome.internal("failed to initialise allocator"));
        ret res[outcome.BuildOutcome, outcome.Fail].err{f};
    }
    val prior_build: *A.Allocator = s.build_alloc;
    s.build_alloc = ?al;
    fin {
        s.build_alloc = prior_build;
        arena.dnit(?ar);
    }

    val m_r: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(s, req.project_root);
    if (sel m_r.err) {
        val f: outcome.Fail = fail_owned(es, m_r.err);
        ret res[outcome.BuildOutcome, outcome.Fail].err{f};
    }
    var m: manifest.Manifest = m_r.ok;

    val p_r: res[plan.BuildPlan, outcome.Fail] = plan.plan(?al, ?s.interner, ?s.registry, ?m, @req);
    if (sel p_r.err) {
        val f: outcome.Fail = fail_owned(es, p_r.err);
        ret res[outcome.BuildOutcome, outcome.Fail].err{f};
    }
    var bp: plan.BuildPlan = p_r.ok;

    val out_r: res[outcome.BuildOutcome, outcome.Fail] = engine.execute_warm_all(?bp, s, es.alloc, nil);
    if (sel out_r.err) {
        val f: outcome.Fail = fail_owned(es, out_r.err);
        ret res[outcome.BuildOutcome, outcome.Fail].err{f};
    }
    ret out_r;
}

# a kind outside the FailKind catalog is an internal failure naming the
# catalog; its message is of unknown provenance and is not carried
fun fail_owned(es: *EditorSession, f: outcome.Fail) outcome.Fail {
    val carried: opt[str] = outcome.text(f);
    if (sel carried.none) { ret f; }
    if (carried.some == nil || str_len(carried.some) == 0) { ret f; }
    val dup_r: res[str, string.StrError] = str_copy(es.alloc, carried.some);
    if (sel dup_r.err) { ret outcome.internal(OOM_FAIL_MESSAGE); }
    ret outcome.with_text(f, dup_r.ok);
}

# release an operational failure returned by analyze or build
# ---
# es: the editor session that returned the Fail
# f: the Fail; nil, a reported Fail, an empty message, and the out-of-memory message are no-ops
pub fun fail_dnit(es: *EditorSession, f: *outcome.Fail) {
    if (f == nil) { ret; }
    val carried: opt[str] = outcome.text(@f);
    if (sel carried.none) { ret; }
    val text: str = carried.some;
    if (text == nil)                { ret; }
    if (text == OOM_FAIL_MESSAGE)   { ret; }
    if (str_len(text) == 0)         { ret; }
    str_free(es.alloc, text);
    @f = outcome.with_text(@f, nil);
}

fun diags_reset(es: *EditorSession) {
    diagnostic.store_dnit(?es.s.diags);
    es.s.diags = diagnostic.store_init(es.alloc);
}

fun discover_project_root(alloc: *A.Allocator, file_path: str) res[opt[str], fail.Fail] {
    val start_r: res[str, A.Error] = path.parent(alloc, file_path);
    if (sel start_r.err) { ret res[opt[str], fail.Fail].err{fail.refused(start_r.err)}; }
    var dir: str = start_r.ok;
    fin { str_free(alloc, dir); }
    for (true) {
        val mf_r: res[str, fail.Fail] = load.join_path(alloc, dir, manifest.MANIFEST_FILE);
        if (sel mf_r.err) { ret res[opt[str], fail.Fail].err{mf_r.err}; }
        val mf: str = mf_r.ok;
        val opened: res[fs.File, io_error.Error] = fs.open(mf);
        str_free(alloc, mf);
        if (sel opened.ok) {
            var file: fs.File = opened.ok;
            val metadata: res[fs.Metadata, io_error.Error] = fs.stat_of(file);
            val closed: err[io_error.Error] = fs.close(?file);
            if (sel metadata.err) {
                ret res[opt[str], fail.Fail].err{fail.message(io_error.message(metadata.err))};
            }
            if (sel closed.err) { ret res[opt[str], fail.Fail].err{fail.message(io_error.message(closed.err))}; }
            if (metadata.ok.kind != fs.KIND_FILE) {
                ret res[opt[str], fail.Fail].err{fail.message("project manifest is not a regular file")};
            }
            val found: str = dir;
            dir = nil;
            ret res[opt[str], fail.Fail].ok{opt[str].some{found}};
        }
        if (opened.err.code != host_os.ENOENT) {
            ret res[opt[str], fail.Fail].err{fail.message(io_error.message(opened.err))};
        }
        val parent_r: res[str, A.Error] = path.parent(alloc, dir);
        if (sel parent_r.err) { ret res[opt[str], fail.Fail].err{fail.refused(parent_r.err)}; }
        val next: str = parent_r.ok;
        if (str_equals(next, dir)) { str_free(alloc, next); ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
        str_free(alloc, dir);
        dir = next;
    }
    ret res[opt[str], fail.Fail].ok{opt[str].none{}};
}

fun relative_under(alloc: *A.Allocator, file_path: str, root: str, src_text: str) res[opt[str], fail.Fail] {
    val prefix_r: res[str, fail.Fail] = load.join_path(alloc, root, src_text);
    if (sel prefix_r.err) { ret res[opt[str], fail.Fail].err{prefix_r.err}; }
    val prefix: str = prefix_r.ok;
    val plen: usize = str_len(prefix);
    val flen: usize = str_len(file_path);
    if (flen <= plen || !path.is_separator(file_path[plen])) {
        str_free(alloc, prefix);
        ret res[opt[str], fail.Fail].ok{opt[str].none{}};
    }
    var i: usize = 0;
    for (i < plen) {
        if (file_path[i] != prefix[i] && !(path.is_separator(file_path[i]) && path.is_separator(prefix[i]))) {
            str_free(alloc, prefix);
            ret res[opt[str], fail.Fail].ok{opt[str].none{}};
        }
        i = i + 1;
    }
    str_free(alloc, prefix);
    val rel_r: res[str, string.StrError] = str_copy_slice(alloc, file_path, plen + 1, flen - plen - 1);
    if (sel rel_r.err) { ret res[opt[str], fail.Fail].err{fail.str_refused(rel_r.err)}; }
    ret res[opt[str], fail.Fail].ok{opt[str].some{rel_r.ok}};
}

fun proj_roots_has(es: *EditorSession, fqn: intern.StrId) bool {
    var i: u32 = 0;
    for (i < es.proj_root_count) {
        if (es.proj_roots[i] == fqn) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun proj_roots_rebuild(es: *EditorSession, root: str, id_text: str, src_text: str) err[fail.Fail] {
    val allocated: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](es.alloc, es.buf_len::usize);
    if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
    val roots: *intern.StrId = allocated.ok;
    var complete: bool = false;
    fin { if (!complete) { A.deallocate[intern.StrId](es.alloc, roots, es.buf_len::usize); } }
    var count: u32 = 0;
    var i: u32 = 0;
    for (i < es.buf_len) {
        if (es.buffers[i].in_use) {
            val file: opt[*source.SourceFile] = source.get(?es.s.sources, es.buffers[i].file_id);
            if (sel file.none) { ret err[fail.Fail].err{fail.message("open editor buffer has no source identity")}; }
            val owner_r: res[opt[str], fail.Fail] = discover_project_root(es.alloc, file.some.path);
            if (sel owner_r.err) { ret err[fail.Fail].err{owner_r.err}; }
            val owner: opt[str] = owner_r.ok;
            if (sel owner.none) { i = i + 1; cnt; }
            val same: bool = str_equals(owner.some, root);
            str_free(es.alloc, owner.some);
            if (!same) { i = i + 1; cnt; }
            val relative: res[opt[str], fail.Fail] = relative_under(es.alloc,
                file.some.path, root, src_text);
            if (sel relative.err) { ret err[fail.Fail].err{relative.err}; }
            if (sel relative.ok.some) {
                val rel: str = relative.ok.some;
                val name: res[intern.StrId, fail.Fail] = load.compose_module_fqn(es.alloc, ?es.s.interner, id_text, rel);
                str_free(es.alloc, rel);
                if (sel name.err) { ret err[fail.Fail].err{name.err}; }
                roots[count] = name.ok;
                count = count + 1;
            }
        }
        i = i + 1;
    }
    if (es.proj_roots != nil) { A.deallocate[intern.StrId](es.alloc, es.proj_roots, es.proj_root_cap::usize); }
    es.proj_roots = roots;
    es.proj_root_count = count;
    es.proj_root_cap = es.buf_len;
    complete = true;
    ret err[fail.Fail].ok{};
}

fun views_drop(es: *EditorSession) {
    var i: u32 = 0;
    for (i < es.buf_len) {
        if (es.buffers[i].in_use) { analysis_drop(es, ?es.buffers[i]); }
        i = i + 1;
    }
    val had_project: bool = es.proj_loaded;
    proj_teardown(es);
    if (!had_project) { session.reset_module_registry(es.s); }
    if (es.s.query_presentation != nil) {
        query.presentation_dnit(es.s.query_presentation);
        es.s.query_presentation = nil;
    }
    if (es.s.query_failure_message != nil) {
        str_free(es.s.queries.a, es.s.query_failure_message);
        es.s.query_failure_message = nil;
    }
    diags_reset(es);
}

fun proj_teardown(es: *EditorSession) {
    if (!es.proj_loaded) { ret; }
    project.dnit_project(?es.proj);
    arena.dnit(?es.proj_arena);
    es.proj_loaded = false;
}

fun proj_ensure(es: *EditorSession, fid: source.FileId) res[opt[*project.ModuleEntry], fail.Fail] {
    val file_opt: opt[*source.SourceFile] = source.get(?es.s.sources, fid);
    if (sel file_opt.none) { ret res[opt[*project.ModuleEntry], fail.Fail].ok{opt[*project.ModuleEntry].none{}}; }
    val file_path: str = file_opt.some.path;

    val discovered: res[opt[str], fail.Fail] = discover_project_root(es.alloc, file_path);
    if (sel discovered.err) { ret res[opt[*project.ModuleEntry], fail.Fail].err{discovered.err}; }
    val root_opt: opt[str] = discovered.ok;
    if (sel root_opt.none) { ret res[opt[*project.ModuleEntry], fail.Fail].ok{opt[*project.ModuleEntry].none{}}; }
    val root: str = root_opt.some;

    val root_changed: bool = es.proj_root == nil || !str_equals(es.proj_root, root);
    if (root_changed) {
        proj_teardown(es);
        if (es.proj_root != nil) { str_free(es.alloc, es.proj_root); es.proj_root = nil; }
        es.proj_root_count = 0;
    }

    val need_manifest: bool = root_changed || !es.proj_loaded;
    var id_text:      str = nil;
    var src_text:     str = nil;
    var m:            manifest.Manifest;
    var have_manifest: bool = false;
    val manifest_alloc: *A.Allocator = es.s.build_alloc;
    fin { if (have_manifest) { manifest.dnit(?m, manifest_alloc); } }

    if (need_manifest) {
        val m_r: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(es.s, root);
        if (sel m_r.err) {
            str_free(es.alloc, root);
            ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.message(outcome.describe(m_r.err))};
        }
        m = m_r.ok;
        have_manifest = true;
        val id_opt: opt[str] = intern.lookup(?es.s.interner, m.id);
        val src_opt: opt[str] = intern.lookup(?es.s.interner, m.src);
        if (sel id_opt.none) {
            str_free(es.alloc, root);
            ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.message("editor: manifest project id or src dir not interned")};
        }
        if (sel src_opt.none) {
            str_free(es.alloc, root);
            ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.message("editor: manifest project id or src dir not interned")};
        }
        id_text  = id_opt.some;
        src_text = src_opt.some;
    }
    or {
        val id_opt: opt[str] = intern.lookup(?es.s.interner, es.proj.config.id);
        val src_opt: opt[str] = intern.lookup(?es.s.interner, es.proj.config.dir_src);
        if (sel id_opt.none) {
            str_free(es.alloc, root);
            ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.message("editor: cached project id or src dir not interned")};
        }
        if (sel src_opt.none) {
            str_free(es.alloc, root);
            ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.message("editor: cached project id or src dir not interned")};
        }
        id_text  = id_opt.some;
        src_text = src_opt.some;
    }

    val relative: res[opt[str], fail.Fail] = relative_under(es.alloc, file_path, root, src_text);
    if (sel relative.err) { str_free(es.alloc, root); ret res[opt[*project.ModuleEntry], fail.Fail].err{relative.err}; }
    val rel_opt: opt[str] = relative.ok;
    if (sel rel_opt.none) {
        str_free(es.alloc, root);
        ret res[opt[*project.ModuleEntry], fail.Fail].ok{opt[*project.ModuleEntry].none{}};
    }
    val rel: str = rel_opt.some;
    if (es.active_request != nil && es.active_request.standalone_target != nil) {
        str_free(es.alloc, rel);
        str_free(es.alloc, root);
        es.operation_failure = opt[outcome.Fail].some{outcome.user("project analysis selects its target through the build request")};
        ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.message("project analysis selects its target through the build request")};
    }

    val fqn_r: res[intern.StrId, fail.Fail] = load.compose_module_fqn(es.alloc, ?es.s.interner, id_text, rel);
    str_free(es.alloc, rel);
    if (sel fqn_r.err) {
        str_free(es.alloc, root);
        ret res[opt[*project.ModuleEntry], fail.Fail].err{fqn_r.err};
    }
    val fqn: intern.StrId = fqn_r.ok;

    val has_root: bool = proj_roots_has(es, fqn);
    val need_reload: bool = root_changed || es.proj_dirty || !es.proj_loaded || !has_root;

    if (!need_reload) {
        str_free(es.alloc, root);
        ret res[opt[*project.ModuleEntry], fail.Fail].ok{project.module_by_fqn(?es.proj, fqn)};
    }

    val rebuilt: err[fail.Fail] = proj_roots_rebuild(es, root, id_text, src_text);
    if (sel rebuilt.err) {
        str_free(es.alloc, root);
        ret res[opt[*project.ModuleEntry], fail.Fail].err{rebuilt.err};
    }

    if (!have_manifest) {
        val m_r: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(es.s, root);
        if (sel m_r.err) {
            str_free(es.alloc, root);
            ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.message(outcome.describe(m_r.err))};
        }
        m = m_r.ok;
        have_manifest = true;
    }

    proj_teardown(es);

    val make_r: err[A.Error] = page.make(?es.proj_backing);
    if (sel make_r.err) {
        str_free(es.alloc, root);
        ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.message("out of memory")};
    }
    val init_r: err[A.Error] = arena.init(?es.proj_arena, ?es.proj_backing, 0);
    if (sel init_r.err) {
        str_free(es.alloc, root);
        ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.message("out of memory")};
    }
    val make_r2: err[A.Error] = arena.make(?es.proj_alloc, ?es.proj_arena);
    if (sel make_r2.err) {
        arena.dnit(?es.proj_arena);
        str_free(es.alloc, root);
        ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.message("out of memory")};
    }

    val prior_build: *A.Allocator = es.s.build_alloc;
    es.s.build_alloc = ?es.proj_alloc;

    var req: request.BuildRequest = request.defaults();
    if (es.active_request != nil) { req = es.active_request.build; }
    req.project_root = root;

    var phase: driver.FrontendPhase = driver.FRONTEND_SEMA;
    if (es.active_request != nil) { phase = es.active_request.phase; }
    val ap_r: res[project.Project, outcome.Fail] = driver.analyze_project_until(es.s, ?m, ?req, es.proj_roots, es.proj_root_count, phase);
    es.s.build_alloc = prior_build;

    if (sel ap_r.err) {
        val f: outcome.Fail = ap_r.err;
        es.operation_failure = opt[outcome.Fail].some{f};
        var emsg: str = "editor: failed to load project";
        if (outcome.describe(f) != nil && str_len(outcome.describe(f)) > 0) { emsg = outcome.describe(f); }
        arena.dnit(?es.proj_arena);
        str_free(es.alloc, root);
        ret res[opt[*project.ModuleEntry], fail.Fail].err{fail.message(emsg)};
    }

    es.proj_loaded  = true;
    es.proj         = ap_r.ok;
    if (es.proj_root != nil) { str_free(es.alloc, es.proj_root); }
    es.proj_root    = root;
    es.proj_dirty   = false;

    ret res[opt[*project.ModuleEntry], fail.Fail].ok{project.module_by_fqn(?es.proj, fqn)};
}

fun tokenize_inner(es: *EditorSession, fid: source.FileId) res[lexer.TokenStream, fail.Fail] {
    val opt_file: opt[*source.SourceFile] = source.get(?es.s.sources, fid);
    if (sel opt_file.none) {
        ret res[lexer.TokenStream, fail.Fail].err{fail.message("editor: buffer not open")};
    }
    val file: *source.SourceFile = opt_file.some;

    val res_tokens: res[lexer.TokenStream, fail.Fail] = lexer.tokenize(file.text, es.alloc, fid);
    if (sel res_tokens.err) { ret res_tokens; }
    var stream: lexer.TokenStream = res_tokens.ok;

    val res_emit: err[fail.Fail] = lexer.emit_diagnostics(?stream, ?es.s.diags);
    if (sel res_emit.err) {
        lexer.dnit(?stream, es.alloc);
        ret res[lexer.TokenStream, fail.Fail].err{res_emit.err};
    }
    ret res[lexer.TokenStream, fail.Fail].ok{stream};
}

fun parse_inner(es: *EditorSession, fid: source.FileId) res[*ast.Ast, fail.Fail] {
    val b: *Buffer = slot_live(es, fid);
    if (b == nil) { ret res[*ast.Ast, fail.Fail].err{fail.message("editor: buffer not open")}; }

    val res_tokens: res[lexer.TokenStream, fail.Fail] = tokenize_inner(es, fid);
    if (sel res_tokens.err) {
        ret res[*ast.Ast, fail.Fail].err{res_tokens.err};
    }
    var stream: lexer.TokenStream = res_tokens.ok;

    analysis_drop(es, b);

    val res_ast: res[*ast.Ast, fail.Fail] = ast_alloc(es, fid);
    if (sel res_ast.err) {
        lexer.dnit(?stream, es.alloc);
        ret res_ast;
    }
    val a: *ast.Ast = res_ast.ok;

    val parse_r: res[fail.PhaseStatus, state.ParseFail] = parser.parse(?stream, a, ?es.s.diags);
    lexer.dnit(?stream, es.alloc);

    if (sel parse_r.err) {
        val f: state.ParseFail = parse_r.err;
        b.a = a;
        es.operation_failure = opt[outcome.Fail].some{outcome.from_fail(state.failure(f))};
        if (f.kind == state.PARSE_FAIL_DEPTH) { fail.reject(?b.parse_status); }
        or { fail.internal(?b.parse_status, f.message); }
        ret res[*ast.Ast, fail.Fail].err{fail.message(f.message)};
    }

    b.a = a;
    b.parse_status = parse_r.ok;
    ret res[*ast.Ast, fail.Fail].ok{a};
}

fun buffer_definition(raw: ptr, origin: session.ModuleId, phase: context.DefinitionPhase) res[context.Definition, fail.Fail] {
    val es: *EditorSession = raw::*EditorSession;
    if (es == nil) {
        ret res[context.Definition, fail.Fail].err{fail.message("current definition is not an open editor buffer")};
    }
    val b: *Buffer = slot_live(es, origin::source.FileId);
    if (b == nil || !b.owned || b.a == nil) {
        ret res[context.Definition, fail.Fail].err{fail.message("editor definition has no current standalone parsed owner")};
    }
    var result: context.Definition = context.Definition{
        parsed: resolve.ParsedDefinition{ a: b.a, owner: resolve.type_owner(es.s, origin, b.file_id), incarnation: b.a.incarnation },
        origin: origin
    };
    if (phase >= context.DEFINITION_RESOLVED) { result.rr = b.rr; }
    if (phase == context.DEFINITION_TYPED) { result.sr = b.sr; result.ctx = ?b.ctx; }
    ret res[context.Definition, fail.Fail].ok{result};
}

fun buffer_resolve(es: *EditorSession, b: *Buffer, deps: *resolve.ResolveDeps) res[*resolve.ResolveResult, fail.Fail] {
    rr_drop(es, b);
    val seeded: err[fail.Fail] = ctx_seed(es, b);
    if (sel seeded.err) { ret res[*resolve.ResolveResult, fail.Fail].err{seeded.err}; }

    val res_resolve: res[resolve.ResolveResult, fail.Fail] = resolve.resolve(es.s, b.a, deps, ?b.ctx, b.file_id::session.ModuleId, true, ?es.s.diags);
    if (sel res_resolve.err) {
        es.operation_failure = opt[outcome.Fail].some{outcome.from_fail(res_resolve.err)};
        ret res[*resolve.ResolveResult, fail.Fail].err{res_resolve.err};
    }

    val res_slot: res[*resolve.ResolveResult, A.Error] = A.allocate[resolve.ResolveResult](es.alloc, 1);
    if (sel res_slot.err) {
        var rr_owned: resolve.ResolveResult = res_resolve.ok;
        resolve.dnit_result(?rr_owned);
        if (sel res_slot.err) { ret res[*resolve.ResolveResult, fail.Fail].err{fail.refused(res_slot.err)}; }
        ret res[*resolve.ResolveResult, fail.Fail].ok{res_slot.ok};
    }
    val rr: *resolve.ResolveResult = res_slot.ok;
    @rr = res_resolve.ok;
    b.rr = rr;
    ret res[*resolve.ResolveResult, fail.Fail].ok{rr};
}

fun slot_get(es: *EditorSession, fid: source.FileId) *Buffer {
    var i: u32 = 0;
    for (i < es.buf_len) {
        if (es.buffers[i].in_use && es.buffers[i].file_id == fid) { ret ?es.buffers[i]; }
        i = i + 1;
    }
    ret nil;
}

fun slot_live(es: *EditorSession, fid: source.FileId) *Buffer {
    ret slot_get(es, fid);
}

fun slot_reserve(es: *EditorSession, fid: source.FileId) res[u32, fail.Fail] {
    var i: u32 = 0;
    var vacant: u32 = ~(0::u32);
    for (i < es.buf_len) {
        if (es.buffers[i].in_use && es.buffers[i].file_id == fid) { ret res[u32, fail.Fail].ok{i}; }
        if (!es.buffers[i].in_use && vacant == ~(0::u32)) { vacant = i; }
        i = i + 1;
    }
    if (vacant != ~(0::u32)) { ret res[u32, fail.Fail].ok{vacant}; }
    if (es.buf_len > (~(0::u32)) / 2) { ret res[u32, fail.Fail].err{fail.message("editor buffer capacity exhausted")}; }
    var new_len: u32 = es.buf_len * 2;
    if (new_len == 0) { new_len = BUFFERS_SEED; }
    var grown: res[*Buffer, A.Error];
    if (es.buffers == nil) { grown = A.allocate[Buffer](es.alloc, new_len::usize); }
    or { grown = A.reallocate[Buffer](es.alloc, es.buffers, es.buf_len::usize, new_len::usize); }
    if (sel grown.err) { ret res[u32, fail.Fail].err{fail.refused(grown.err)}; }
    es.buffers = grown.ok;
    i = es.buf_len;
    for (i < new_len) {
        es.buffers[i] = Buffer{};
        i = i + 1;
    }
    val index: u32 = es.buf_len;
    es.buf_len = new_len;
    ret res[u32, fail.Fail].ok{index};
}

fun ast_alloc(es: *EditorSession, fid: source.FileId) res[*ast.Ast, fail.Fail] {
    val res_alloc: res[*ast.Ast, A.Error] = A.allocate[ast.Ast](es.alloc, 1);
    if (sel res_alloc.err) { ret res[*ast.Ast, fail.Fail].err{fail.refused(res_alloc.err)}; }
    val a: *ast.Ast = res_alloc.ok;
    @a = ast.init(es.alloc, fid);
    val incarnation: res[u64, fail.Fail] = session.next_parse_incarnation(es.s);
    if (sel incarnation.err) {
        A.deallocate[ast.Ast](es.alloc, a, 1);
        ret res[*ast.Ast, fail.Fail].err{incarnation.err};
    }
    a.incarnation = incarnation.ok;
    ret res[*ast.Ast, fail.Fail].ok{a};
}

fun host_ctx(es: *EditorSession) comptime.ComptimeCtx {
    var c: comptime.ComptimeCtx = comptime.init(
        es.alloc,
        target.host_os_id(),
        target.host_arch_id(),
        target.host_abi_id(),
        comptime.MODE_DEBUG,
        0,
        target.host_pointer_width(),
        isa.VECTOR_BITS_128,
        true,
        intern.STR_NIL,
        intern.STR_NIL
    );
    val vl: opt[os.VaList] = target.host_va_list();
    if (sel vl.some) {
        comptime.set_va_list(?c, vl.some.size, vl.some.align);
    }
    ret c;
}

fun ctx_seed(es: *EditorSession, b: *Buffer) err[fail.Fail] {
    if (es.active_request == nil) {
        comptime.dnit(?b.ctx);
        b.ctx = host_ctx(es);
        b.context_ready = true;
        ret err[fail.Fail].ok{};
    }
    val req: *AnalysisRequest = es.active_request;
    if (str_len(req.build.target) != 0) {
        es.operation_failure = opt[outcome.Fail].some{outcome.user("a standalone buffer requires a resolved target, not a project target name")};
        ret err[fail.Fail].err{fail.message("a standalone buffer requires a resolved target, not a project target name")};
    }
    val registry: err[outcome.Fail] = driver.setup_registry(?es.s.registry);
    if (sel registry.err) { ret err[fail.Fail].err{fail.message(outcome.describe(registry.err))}; }
    var host_request: target.TargetRequest = target.target_request(
        isa.arch_name_for(target.host_arch_id()), os.os_name_for(target.host_os_id()), abi.abi_name_for(target.host_abi_id()));
    var host: target.Target;
    var selected: *target.Target = req.standalone_target;
    if (selected == nil) {
        val resolved: res[target.Target, fail.Fail] = target.resolve(?es.s.registry, ?host_request);
        if (sel resolved.err) { ret err[fail.Fail].err{resolved.err}; }
        host = resolved.ok;
        selected = ?host;
    }
    if (selected.isa == nil) { ret err[fail.Fail].err{fail.message("standalone analysis requires a resolved target with an instruction set")}; }
    var mode: u32 = comptime.MODE_DEBUG;
    if (request.release(?req.build)) { mode = comptime.MODE_RELEASE; }
    var pie: u32 = 0;
    if (req.build.pie) { pie = 1; }
    comptime.dnit(?b.ctx);
    b.ctx = comptime.init(es.alloc, selected.os_id, selected.arch_id, selected.abi_id,
        mode, pie, selected.isa.pointer_width, selected.model.vector_bits, selected.model.has_float,
        intern.STR_NIL, intern.STR_NIL);
    comptime.set_target_defs(?b.ctx, selected.isa.defs);
    comptime.set_va_list(?b.ctx, selected.va_list_size, selected.va_list_align);
    b.context_ready = true;
    ret err[fail.Fail].ok{};
}

fun sema_drop(es: *EditorSession, b: *Buffer) {
    if (b.sr == nil) { ret; }
    if (b.owned) {
        sema.dnit_result(b.sr);
        A.deallocate[context.SemaResult](es.alloc, b.sr, 1);
    }
    b.sr = nil;
}

fun rr_drop(es: *EditorSession, b: *Buffer) {
    sema_drop(es, b);
    if (b.rr == nil) { ret; }
    if (b.owned) {
        resolve.dnit_result(b.rr);
        A.deallocate[resolve.ResolveResult](es.alloc, b.rr, 1);
    }
    b.rr = nil;
}

fun analysis_drop(es: *EditorSession, b: *Buffer) {
    rr_drop(es, b);
    if (b.a != nil) {
        if (b.owned) {
            ast.dnit(b.a);
            A.deallocate[ast.Ast](es.alloc, b.a, 1);
        }
        b.a = nil;
    }
    comptime.dnit(?b.ctx);
    b.parse_status = fail.accepted();
    b.context_ready = false;
    b.owned = true;
}

fun buffer_free(es: *EditorSession, b: *Buffer) {
    if (!b.in_use) { ret; }
    analysis_drop(es, b);
    b.in_use = false;
}

fun t_dnit(es: *EditorSession) {
    val dnit_r: err[fail.Fail] = dnit(es);
}

fun t_session(a: *A.Allocator) res[session.Session, fail.Fail] {
    page.make(a);
    ret session.init(a);
}

fun diag_has(list: *diagnostic.DiagnosticStore, sub: str) bool {
    var i: usize = 0;
    for (i < diagnostic.len(list)) {
        if (str_contains(list.items.data[i].message, sub)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun diag_child_has(list: *diagnostic.DiagnosticStore, kind: diagnostic.ChildKind, sub: str) bool {
    var i: usize = 0;
    for (i < diagnostic.len(list)) {
        val d: *diagnostic.Diagnostic = ?list.items.data[i];
        var c: usize = 0;
        for (c < d.children.len) {
            if (d.children.data[c].kind == kind && str_contains(d.children.data[c].text, sub)) { ret true; }
            c = c + 1;
        }
        i = i + 1;
    }
    ret false;
}

fun diag_note_has(list: *diagnostic.DiagnosticStore, sub: str) bool {
    ret diag_child_has(list, diagnostic.CHILD_NOTE, sub);
}

fun diag_help_has(list: *diagnostic.DiagnosticStore, sub: str) bool {
    ret diag_child_has(list, diagnostic.CHILD_HELP, sub);
}

fun diag_related_has(list: *diagnostic.DiagnosticStore, sub: str) bool {
    var i: usize = 0;
    for (i < diagnostic.len(list)) {
        var r: usize = 0;
        for (r < list.items.data[i].related.len) {
            val rel: *diagnostic.Related = ?list.items.data[i].related.data[r];
            if (rel.label != nil && str_contains(rel.label, sub)) { ret true; }
            r = r + 1;
        }
        i = i + 1;
    }
    ret false;
}

fun diag_count(list: *diagnostic.DiagnosticStore, sub: str) u32 {
    var hits: u32   = 0;
    var i:    usize = 0;
    for (i < diagnostic.len(list)) {
        if (str_contains(list.items.data[i].message, sub)) { hits = hits + 1; }
        i = i + 1;
    }
    ret hits;
}

fun t_run_sema(es: *EditorSession, fid: source.FileId, pw: u32) res[*diagnostic.DiagnosticStore, fail.Fail] {
    val res_resolve: res[*resolve.ResolveResult, fail.Fail] = resolve_buffer(es, fid);
    if (sel res_resolve.err) {
        ret res[*diagnostic.DiagnosticStore, fail.Fail].err{res_resolve.err};
    }
    val rr: *resolve.ResolveResult = res_resolve.ok;

    val b: *Buffer = slot_live(es, fid);
    if (b == nil) { ret res[*diagnostic.DiagnosticStore, fail.Fail].err{fail.message("editor: buffer not open")}; }
    b.ctx.env.pointer_width = pw;

    val res_register: err[fail.Fail] = session.register_module_ast(es.s, fid::session.ModuleId, b.a);
    if (sel res_register.err) {
        ret res[*diagnostic.DiagnosticStore, fail.Fail].err{res_register.err};
    }

    diags_reset(es);

    var deps: context.SemaDeps = context.SemaDeps{};
    deps.definitions = context.reader_init(es::ptr, buffer_definition, es.alloc);
    fin { context.reader_dnit(?deps.definitions); }
    deps.entries = nil;
    deps.count   = 0;

    val res_sema: res[context.SemaResult, fail.Fail] = sema.sema(es.s, b.a, rr, ?deps, ?b.ctx, fid::session.ModuleId, ?es.s.diags);
    if (sel res_sema.err) {
        ret res[*diagnostic.DiagnosticStore, fail.Fail].err{res_sema.err};
    }
    var sema_result: context.SemaResult = res_sema.ok;
    sema.dnit_result(?sema_result);

    ret res[*diagnostic.DiagnosticStore, fail.Fail].ok{?es.s.diags};
}

fun t_resolve_deps(es: *EditorSession, fid: source.FileId, deps: *resolve.ResolveDeps) res[*resolve.ResolveResult, fail.Fail] {
    val b: *Buffer = slot_live(es, fid);
    if (b == nil) { ret res[*resolve.ResolveResult, fail.Fail].err{fail.message("editor: buffer not open")}; }
    if (b.a == nil) {
        val res_parse: res[*ast.Ast, fail.Fail] = parse_buffer(es, fid);
        if (sel res_parse.err) {
            ret res[*resolve.ResolveResult, fail.Fail].err{res_parse.err};
        }
    }
    ret buffer_resolve(es, b, deps);
}

fun t_exports(es: *EditorSession, fid: source.FileId, fqn: str) res[resolve.ModuleExports, fail.Fail] {
    val b: *Buffer = slot_get(es, fid);
    if (b == nil || b.rr == nil) { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("editor: buffer not resolved")}; }

    val res_fqn: res[intern.StrId, A.Error] = intern.intern(?es.s.interner, fqn);
    if (sel res_fqn.err) {
        ret res[resolve.ModuleExports, fail.Fail].err{fail.refused(res_fqn.err)};
    }

    var mx: resolve.ModuleExports;
    mx.path    = res_fqn.ok;
    mx.module  = fid::session.ModuleId;
    mx.symbols = nil;
    mx.count   = 0;

    val pub_len: u32 = b.rr.pub_count;
    if (pub_len == 0) { ret res[resolve.ModuleExports, fail.Fail].ok{mx}; }

    val res_syms: res[*resolve.PublicSymbol, A.Error] = A.allocate[resolve.PublicSymbol](es.alloc, pub_len::usize);
    if (sel res_syms.err) {
        ret res[resolve.ModuleExports, fail.Fail].err{fail.refused(res_syms.err)};
    }
    val syms: *resolve.PublicSymbol = res_syms.ok;

    var i: u32 = 0;
    for (i < pub_len) {
        val sym: *resolve.Symbol = ?b.rr.symbols[i];
        var ps: resolve.PublicSymbol;
        ps.kind   = sym.definition_kind;
        ps.name   = sym.name;
        ps.canon  = sym.canon;
        ps.file = sym.definition_file;
        ps.generic_arity = sym.generic_arity;
        ps.has_comptime_params = sym.has_comptime_params;
        ps.has_pack_param = sym.has_pack_param;
        ps.deprecation = sym.deprecation;
        ps.slot   = sym.slot;
        ps.origin = sym.origin;
        syms[i] = ps;
        i = i + 1;
    }
    mx.symbols = syms;
    mx.count   = pub_len;
    ret res[resolve.ModuleExports, fail.Fail].ok{mx};
}

test "mach.lang.editor.parse:clean_buffer" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);

    val res_fid: res[source.FileId, fail.Fail] = open(?es, "buf.mach", "fun f(a: i64) i64 { ret a; }\n");
    if (sel res_fid.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val fid: source.FileId = res_fid.ok;

    val res_ast: res[*ast.Ast, fail.Fail] = parse_buffer(?es, fid);
    if (sel res_ast.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val a: *ast.Ast = res_ast.ok;
    if (a.decl_len == 0) { t_dnit(?es); session.dnit(?s); ret 1; }

    val res_diags: res[*diagnostic.DiagnosticStore, fail.Fail] = diagnostics_buffer(?es, fid);
    if (sel res_diags.err)                           { t_dnit(?es); session.dnit(?s); ret 1; }
    if (diagnostic.has_errors(res_diags.ok)) { t_dnit(?es); session.dnit(?s); ret 1; }

    t_dnit(?es);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.editor.diagnostics:partial_on_broken_buffer" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);

    val res_fid: res[source.FileId, fail.Fail] = open(?es, "broken.mach", "fun g(a: i64 { ret a ` ; }\n");
    if (sel res_fid.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val fid: source.FileId = res_fid.ok;

    val res_diags: res[*diagnostic.DiagnosticStore, fail.Fail] = diagnostics_buffer(?es, fid);
    if (sel res_diags.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val list: *diagnostic.DiagnosticStore = res_diags.ok;
    if (!diagnostic.has_errors(list)) { t_dnit(?es); session.dnit(?s); ret 1; }

    val a: *ast.Ast = buffer_ast(?es, fid);
    if (a == nil)        { t_dnit(?es); session.dnit(?s); ret 1; }
    if (a.decl_len == 0) { t_dnit(?es); session.dnit(?s); ret 1; }

    if (ast.offset_to_decl(a, 2) == id.DECL_NIL) { t_dnit(?es); session.dnit(?s); ret 1; }

    val res_resolve: res[*resolve.ResolveResult, fail.Fail] = resolve_buffer(?es, fid);
    if (sel res_resolve.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val rrp: *resolve.ResolveResult = res_resolve.ok;
    if (rrp.decl_count != a.decl_len::u32) { t_dnit(?es); session.dnit(?s); ret 1; }

    t_dnit(?es);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.editor.update:drops_cached_analysis" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);

    val res_fid: res[source.FileId, fail.Fail] = open(?es, "buf.mach", "fun a() {}\n");
    if (sel res_fid.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val fid: source.FileId = res_fid.ok;

    val res_parse_1: res[*ast.Ast, fail.Fail] = parse_buffer(?es, fid);
    if (sel res_parse_1.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val decls_1: usize = res_parse_1.ok.decl_len;

    val res_update: res[bool, fail.Fail] = update(?es, fid, "fun a() {}\nfun b() {}\n");
    if (sel res_update.err)     { t_dnit(?es); session.dnit(?s); ret 1; }
    if (!res_update.ok) { t_dnit(?es); session.dnit(?s); ret 1; }
    if (buffer_ast(?es, fid) != nil) { t_dnit(?es); session.dnit(?s); ret 1; }

    val res_parse_2: res[*ast.Ast, fail.Fail] = parse_buffer(?es, fid);
    if (sel res_parse_2.err)                        { t_dnit(?es); session.dnit(?s); ret 1; }
    if (res_parse_2.ok.decl_len <= decls_1) { t_dnit(?es); session.dnit(?s); ret 1; }

    t_dnit(?es);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.editor.resolve:reexported_module_alias" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);

    val res_inner: res[source.FileId, fail.Fail] = open(?es, "inner.mach", "pub rec Thing { x: i64; }\n");
    if (sel res_inner.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val inner: source.FileId = res_inner.ok;

    var empty: resolve.ResolveDeps;
    empty.entries = nil;
    empty.count   = 0;
    val t_resolve_deps_r: res[*resolve.ResolveResult, fail.Fail] = t_resolve_deps(?es, inner, ?empty);
    if (sel t_resolve_deps_r.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val res_ex_inner: res[resolve.ModuleExports, fail.Fail] = t_exports(?es, inner, "t.inner");
    if (sel res_ex_inner.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    var ex_inner: resolve.ModuleExports = res_ex_inner.ok;

    val res_surface: res[source.FileId, fail.Fail] = open(?es, "surface.mach", "fwd al: t.inner;\n");
    if (sel res_surface.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val surface: source.FileId = res_surface.ok;

    var sdeps: resolve.ResolveDeps;
    sdeps.entries = ?ex_inner;
    sdeps.count   = 1;
    val t_resolve_deps_r2: res[*resolve.ResolveResult, fail.Fail] = t_resolve_deps(?es, surface, ?sdeps);
    if (sel t_resolve_deps_r2.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val res_ex_surface: res[resolve.ModuleExports, fail.Fail] = t_exports(?es, surface, "t.surface");
    if (sel res_ex_surface.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    var ex_surface: resolve.ModuleExports = res_ex_surface.ok;

    val res_consumer: res[source.FileId, fail.Fail] = open(?es, "consumer.mach",
        "use al: t.surface.al;\nfun take(p: al.Thing) i64 { ret p.x; }\n");
    if (sel res_consumer.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val consumer: source.FileId = res_consumer.ok;

    var cdeps_arr: [2]resolve.ModuleExports;
    cdeps_arr[0] = ex_surface;
    cdeps_arr[1] = ex_inner;
    var cdeps: resolve.ResolveDeps;
    cdeps.entries = ?cdeps_arr[0];
    cdeps.count   = 2;

    diags_reset(?es);
    val t_resolve_deps_r3: res[*resolve.ResolveResult, fail.Fail] = t_resolve_deps(?es, consumer, ?cdeps);
    if (sel t_resolve_deps_r3.err) { t_dnit(?es); session.dnit(?s); ret 1; }

    val is_clean: bool = !diagnostic.has_errors(?es.s.diags);
    A.deallocate[resolve.PublicSymbol](es.alloc, ex_inner.symbols, ex_inner.count::usize);
    A.deallocate[resolve.PublicSymbol](es.alloc, ex_surface.symbols, ex_surface.count::usize);
    if (!is_clean) { t_dnit(?es); session.dnit(?s); ret 1; }

    t_dnit(?es);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.editor.analyze:expr_type_bridges_to_field_table" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);

    val src: str = "rec P { x: i64; y: i64; }\nfun f(p: P) i64 { ret p.x; }\n";
    val res_fid: res[source.FileId, fail.Fail] = open(?es, "p.mach", src);
    if (sel res_fid.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val fid: source.FileId = res_fid.ok;

    val res_an: res[*context.SemaResult, fail.Fail] = analyze_buffer(?es, fid);
    if (sel res_an.err) { t_dnit(?es); session.dnit(?s); ret 1; }

    val a: *ast.Ast = buffer_ast(?es, fid);
    if (a == nil) { t_dnit(?es); session.dnit(?s); ret 1; }

    val res_idx: opt[usize] = str_index_of(src, "p.x");
    if (sel res_idx.none) { t_dnit(?es); session.dnit(?s); ret 1; }
    val off_p: usize = res_idx.some;

    val eid_p: id.ExprId = ast.offset_to_expr(a, off_p);
    if (eid_p == id.EXPR_NIL) { t_dnit(?es); session.dnit(?s); ret 1; }
    val ty_p: type.TypeId = buffer_expr_type(?es, fid, eid_p);
    if (ty_p == type.TYPE_ERROR || ty_p == type.TYPE_NIL) { t_dnit(?es); session.dnit(?s); ret 1; }

    val field_table_for_r: opt[*type.FieldTable] = type.field_table_for(?s.types, ty_p);
    if (sel field_table_for_r.none) { t_dnit(?es); session.dnit(?s); ret 1; }
    if (type.field_count(?s.types, ty_p) != 2)                             { t_dnit(?es); session.dnit(?s); ret 1; }

    val i64_opt: opt[type.TypeId] = type.prim(?s.types, type.TYPE_I64);
    if (sel i64_opt.none) { t_dnit(?es); session.dnit(?s); ret 1; }
    val i64_id: type.TypeId = i64_opt.some;

    val f0_opt: opt[*type.FieldEntry] = type.field_at(?s.types, ty_p, 0);
    if (sel f0_opt.none) { t_dnit(?es); session.dnit(?s); ret 1; }
    val f0: *type.FieldEntry = f0_opt.some;
    if (f0.ty != i64_id) { t_dnit(?es); session.dnit(?s); ret 1; }

    val eid_px: id.ExprId = ast.offset_to_expr(a, off_p + 2);
    if (eid_px == id.EXPR_NIL)                  { t_dnit(?es); session.dnit(?s); ret 1; }
    if (buffer_expr_type(?es, fid, eid_px) != i64_id) { t_dnit(?es); session.dnit(?s); ret 1; }

    val res_up: res[bool, fail.Fail] = update(?es, fid, "fun g() i64 { ret 0; }\n");
    if (sel res_up.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    if (buffer_sema(?es, fid) != nil)    { t_dnit(?es); session.dnit(?s); ret 1; }

    t_dnit(?es);
    session.dnit(?s);
    ret 0;
}

