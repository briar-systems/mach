test "mach.lang.editor.resolve:duplicate_definition_secondary_span" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);

    val res_fid: res[source.FileId, fail.Fail] = open(?es, "dup.mach",
        "fun foo() i64 { ret 0; }\nfun foo() i64 { ret 1; }\n");
    if (sel res_fid.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val fid: source.FileId = res_fid.ok;

    val res_resolve: res[*resolve.ResolveResult, fail.Fail] = resolve_buffer(?es, fid);
    if (sel res_resolve.err) { t_dnit(?es); session.dnit(?s); ret 1; }

    val list: *diagnostic.DiagnosticStore = ?es.s.diags;
    if (!diag_has(list, "duplicate definition: `foo`"))     { t_dnit(?es); session.dnit(?s); ret 1; }
    if (!diag_related_has(list, "previous definition here")) { t_dnit(?es); session.dnit(?s); ret 1; }

    var found: bool = false;
    var i: usize = 0;
    for (i < diagnostic.len(list)) {
        var r: usize = 0;
        for (r < list.items.data[i].related.len) {
            val rel: *diagnostic.Related = ?list.items.data[i].related.data[r];
            if (rel.label != nil && rel.loc.span.offset == 4) { found = true; }
            r = r + 1;
        }
        i = i + 1;
    }
    if (!found) { t_dnit(?es); session.dnit(?s); ret 1; }

    t_dnit(?es);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.editor.tokenize:stray_control_char" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
