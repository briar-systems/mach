    if (!diag_has(?es.s.diags, "declares something"))     { t_dnit(?es); session.dnit(?s); ret 1; }

    t_dnit(?es);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.editor.comptime_if:conditional_use_selected_at_resolve" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);

    val res_inner: res[source.FileId, fail.Fail] = open(?es, "tag.mach", "pub val TAG: i64 = 7;\n");
    if (sel res_inner.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val inner: source.FileId = res_inner.ok;

    var empty: resolve.ResolveDeps;
    empty.entries = nil;
    empty.count   = 0;
    val t_resolve_deps_r: res[*resolve.ResolveResult, fail.Fail] = t_resolve_deps(?es, inner, ?empty);
    if (sel t_resolve_deps_r.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val res_ex: res[resolve.ModuleExports, fail.Fail] = t_exports(?es, inner, "t.tag");
    if (sel res_ex.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    var ex: resolve.ModuleExports = res_ex.ok;

    var deps: resolve.ResolveDeps;
    deps.entries = ?ex;
    deps.count   = 1;

    val res_take: res[source.FileId, fail.Fail] = open(?es, "take.mach",
        "$if (1 == 1) { use al: t.tag; }\n$or { $error(\"tag unavailable\"); }\nfun main() i64 { ret al.TAG; }\n");
    if (sel res_take.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val take: source.FileId = res_take.ok;

    diags_reset(?es);
    val t_resolve_deps_r2: res[*resolve.ResolveResult, fail.Fail] = t_resolve_deps(?es, take, ?deps);
    if (sel t_resolve_deps_r2.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val took_clean: bool = !diagnostic.has_errors(?es.s.diags);

    val res_skip: res[source.FileId, fail.Fail] = open(?es, "skip.mach",
        "$if (1 == 0) { use al: t.tag; }\n$or { }\nfun main() i64 { ret al.TAG; }\n");
    if (sel res_skip.err) {
        A.deallocate[resolve.PublicSymbol](es.alloc, ex.symbols, ex.count::usize);
        t_dnit(?es); session.dnit(?s); ret 1;
    }
    val skip: source.FileId = res_skip.ok;

    diags_reset(?es);
    val res_rskip: res[*resolve.ResolveResult, fail.Fail] = t_resolve_deps(?es, skip, ?deps);
    val skipped: bool = sel res_rskip.ok && diagnostic.has_errors(?es.s.diags);

    A.deallocate[resolve.PublicSymbol](es.alloc, ex.symbols, ex.count::usize);
    if (!took_clean) { t_dnit(?es); session.dnit(?s); ret 1; }
    if (!skipped)    { t_dnit(?es); session.dnit(?s); ret 1; }

    t_dnit(?es);
    session.dnit(?s);
    ret 0;
}

test "mach.lang.editor.sema:nil_coerces_to_fun" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);

    val res_fid: res[source.FileId, fail.Fail] = open(?es, "nilfun.mach",
        "def F: fun(u32);\npub var gq: fun(u32) = nil;\npub var gr: F = nil::F;\nrec T { cb: fun(); k: F; }\nfun take(c: fun(u32)) u8 { if (c == nil) { ret 1; } ret 0; }\nfun give() fun(u32) { ret nil; }\nfun givec() F { ret nil::F; }\nfun main() i64 { var lq: fun(u32) = nil; var lr: F = nil::F; var t: T = T{ cb: nil, k: nil::F }; if (gq != nil) { ret 1; } if (lr != nil) { ret 2; } if (t.k != nil) { ret 3; } ret take(lq)::i64; }\n");
    if (sel res_fid.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val fid: source.FileId = res_fid.ok;

    val res_diags: res[*diagnostic.DiagnosticStore, fail.Fail] = t_run_sema(?es, fid, 8);
    if (sel res_diags.err)                               { t_dnit(?es); session.dnit(?s); ret 1; }
    if (diag_has(res_diags.ok, "type mismatch")) { t_dnit(?es); session.dnit(?s); ret 1; }

    t_dnit(?es);
    session.dnit(?s);
    ret 0;
}

