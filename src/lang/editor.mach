fun t_scaffold(alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[str, fail.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, "mach_editor_build");
    if (sel tf_r.err) { ret res[str, fail.Fail].err{fail.fs_refused(tf_r.err)}; }
    var tf: fs.TempFile = tf_r.ok;
    val dup_r: res[str, string.StrError] = str_join(alloc, fs.temp_path(?tf), "");
    fs.temp_close_and_remove(?tf);
    if (sel dup_r.err) { ret res[str, fail.Fail].err{fail.str_refused(dup_r.err)}; }
    val root: str = dup_r.ok;

    val src_r: res[str, string.StrError] = str_join(alloc, root, "/src");
    if (sel src_r.err) { ret res[str, fail.Fail].err{fail.str_refused(src_r.err)}; }
    val src_dir: str = src_r.ok;
    val d: err[fs.FsError] = fs.create_dir_all(alloc, src_dir, 493);
    if (sel d.err) { ret res[str, fail.Fail].err{fail.fs_refused(d.err)}; }

    val mtext: str = "[project]\nid = \"edbuild\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.edbuild]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/edbuild\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    val mf_r: res[str, string.StrError] = str_join(alloc, root, "/", manifest.MANIFEST_FILE);
    if (sel mf_r.err) { ret res[str, fail.Fail].err{fail.str_refused(mf_r.err)}; }
    val w0: err[fs.FsError] = fs.write_bytes(mf_r.ok, mtext, str_len(mtext), 420);
    if (sel w0.err) { ret res[str, fail.Fail].err{fail.fs_refused(w0.err)}; }

    var i: u32 = 0;
    for (i < n) {
        val fp_r: res[str, string.StrError] = str_join(alloc, src_dir, "/", names[i]);
        if (sel fp_r.err) { ret res[str, fail.Fail].err{fail.str_refused(fp_r.err)}; }
        val w: err[fs.FsError] = fs.write_bytes(fp_r.ok, texts[i], str_len(texts[i]), 420);
        if (sel w.err) { ret res[str, fail.Fail].err{fail.fs_refused(w.err)}; }
        i = i + 1;
    }
    ret res[str, fail.Fail].ok{root};
}

fun t_stable_of(s: *session.Session, fqn: str) session.StableModuleId {
    val idr: res[intern.StrId, A.Error] = intern.intern(?s.interner, fqn);
    if (sel idr.err) { ret session.STABLE_MODULE_NIL; }
    ret session.stable_module_id_lookup(s, idr.ok);
}

test "mach.lang.editor.relative_under:host_separators_preserve_component_boundaries" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var files: [9]str = [9]str{
        "/work/project/src/main.mach", "/work/project/srcx/main.mach",
        "/work/project/src", "/work/project/src/nested/main.mach",
        "/work/project/src\\main.mach", "/work/project\\src/main.mach",
        "/work/project/src/nested\\main.mach", "/work/project/SRC/main.mach",
        "/work/project/src2\\main.mach"
    };
    var roots: [9]str;
    var expected: [9]str = [9]str{"main.mach", nil, nil, "nested/main.mach", nil, nil, "nested\\main.mach", nil, nil};
    var i: usize = 0;
    for (i < 9) { roots[i] = "/work/project"; i = i + 1; }
    $if ($mach.build.os == $mach.os.windows) {
        files[0] = "C:\\work\\project\\src\\main.mach";
        roots[0] = "C:\\work\\project";
        expected[4] = "main.mach";
        expected[5] = "main.mach";
        files[6] = "C:/work\\project/src\\nested/main.mach";
        roots[6] = "C:\\work/project";
        expected[6] = "nested/main.mach";
    }
    i = 0;
    for (i < 9) {
        val relative: res[opt[str], fail.Fail] = relative_under(?alloc, files[i], roots[i], "src");
        if (sel relative.err) { ret 8; }
        val found: opt[str] = relative.ok;
        if (sel found.some) {
            val rel: str = found.some;
            val good: bool = expected[i] != nil && str_equals(rel, expected[i]);
            str_free(?alloc, rel);
            if (!good) { ret 10 + i::i32; }
        }
        or (expected[i] != nil) { ret 20 + i::i32; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.editor.resolve:cross_module_import_resolves_with_real_project" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);

    var names: [2]str;
    names[0] = "main.mach"; names[1] = "helper.mach";
    var texts: [2]str;
    texts[0] = "use edbuild.helper.square;\nfun main() i32 { ret square(3); }\n";
    texts[1] = "pub fun square(x: i32) i32 { ret x * x; }\n";
    val root_r: res[str, fail.Fail] = t_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val root: str = root_r.ok;

    val mp_r: res[str, string.StrError] = str_join(?alloc, root, "/src/main.mach");
    if (sel mp_r.err) { fs.remove_all(?alloc, root); t_dnit(?es); session.dnit(?s); ret 1; }
    val res_fid: res[source.FileId, fail.Fail] = open(?es, mp_r.ok, texts[0]);
    if (sel res_fid.err) { fs.remove_all(?alloc, root); t_dnit(?es); session.dnit(?s); ret 1; }
    val fid: source.FileId = res_fid.ok;

    var bad: i32 = 0;

    val rr_res: res[*resolve.ResolveResult, fail.Fail] = resolve_buffer(?es, fid);
    if (sel rr_res.err) { bad = 1; }
    or (diag_has(?s.diags, "undeclared") || diag_has(?s.diags, "unresolved")) { bad = 1; }

    val sr_res: res[*context.SemaResult, fail.Fail] = analyze_buffer(?es, fid);
    if (sel sr_res.err) { bad = 1; }
    or (diag_has(?s.diags, "undeclared") || diag_has(?s.diags, "unresolved") || diagnostic.error_count(?s.diags) != 0) { bad = 1; }

    fs.remove_all(?alloc, root);
    t_dnit(?es);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.editor.resolve:reload_reflects_edited_dependency" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);

    var names: [2]str;
    names[0] = "main.mach"; names[1] = "helper.mach";
    var texts: [2]str;
    texts[0] = "use edbuild.helper.square;\nfun main() i32 { ret square(3); }\n";
    texts[1] = "pub fun square(x: i32) i32 { ret x * x; }\n";
    val root_r: res[str, fail.Fail] = t_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val root: str = root_r.ok;

    val mp_r: res[str, string.StrError] = str_join(?alloc, root, "/src/main.mach");
    if (sel mp_r.err) { fs.remove_all(?alloc, root); t_dnit(?es); session.dnit(?s); ret 1; }
    val main_path: str = mp_r.ok;
    val res_fid: res[source.FileId, fail.Fail] = open(?es, main_path, texts[0]);
    if (sel res_fid.err) { fs.remove_all(?alloc, root); t_dnit(?es); session.dnit(?s); ret 1; }
    val fid: source.FileId = res_fid.ok;

    var bad: i32 = 0;

    var req: AnalysisRequest = analysis_request(fid, PHASE_RESOLVE);
    val r1: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel r1.err) { bad = 1; }
    if (sel r1.ok) {
        var first: AnalysisResult = r1.ok;
        fin { analysis_dnit(?first); }
        if (!sel first.status.kind.accepted || diagnostic.len(first.diagnostics) != 0) { bad = 2; }
        val resolved: res[*resolve.ResolveResult, fail.Fail] = resolve_of(?first);
        if (!(sel resolved.ok && resolved.ok != nil)) { bad = 3; }
    }

    val res_up: res[bool, fail.Fail] = update(?es, fid, "use edbuild.helper.cube;\nfun main() i32 { ret cube(2); }\n");
    if (sel res_up.err) { fs.remove_all(?alloc, root); t_dnit(?es); session.dnit(?s); ret 1; }

    val r2: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel r2.err) { bad = 4; }
    if (sel r2.ok) {
        var edited: AnalysisResult = r2.ok;
        fin { analysis_dnit(?edited); }
        if (!sel edited.status.kind.rejected || !diag_has(edited.diagnostics, "cube")) { bad = 5; }
        val version: opt[*source.SourceFile] = analysis_source(?edited, fid);
        if (!(sel version.some && str_equals(version.some.text,
                "use edbuild.helper.cube;\nfun main() i32 { ret cube(2); }\n"))) { bad = 6; }
    }

    fs.remove_all(?alloc, root);
    t_dnit(?es);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.editor.resolve:bracket_value_resolution_preserves_the_parsed_owner" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);

    val res_fid: res[source.FileId, fail.Fail] = open(?es, "buf.mach",
        "var Foo: [8]i32;\nvar Marker: i32 = 5;\nfun main() i32 { val r: i32 = Foo[Marker]; ret r; }\n");
    if (sel res_fid.err) { t_dnit(?es); session.dnit(?s); ret 50; }
    val fid: source.FileId = res_fid.ok;

    val res_parse: res[*ast.Ast, fail.Fail] = parse_buffer(?es, fid);
    if (sel res_parse.err) { t_dnit(?es); session.dnit(?s); ret 52; }
    val a: *ast.Ast = buffer_ast(?es, fid);
    if (a == nil) { t_dnit(?es); session.dnit(?s); ret 51; }

    var target: id.ExprId = id.EXPR_NIL;
    var ei: usize = 0;
    for (ei < a.expr_len) {
        if (a.exprs[ei].kind == expr.EXPR_KIND_GENERIC_INSTANCE) { target = ei::id.ExprId; }
        ei = ei + 1;
    }
    if (target == id.EXPR_NIL) { t_dnit(?es); session.dnit(?s); ret 2; }

    val pre_kind: expr.ExprKind = a.exprs[target].kind;

    val r1: res[*resolve.ResolveResult, fail.Fail] = resolve_buffer(?es, fid);
    if (sel r1.err) { t_dnit(?es); session.dnit(?s); ret 3; }
    val rr: *resolve.ResolveResult = buffer_resolve_of(?es, fid);
    if (rr == nil) { t_dnit(?es); session.dnit(?s); ret 4; }

    val live_kind_after_resolve: expr.ExprKind = a.exprs[target].kind;

    val interpreted: res[expr.Expr, fail.Fail] = resolve.expression(rr, a, target);
    if (sel interpreted.err) { t_dnit(?es); session.dnit(?s); ret 5; }
    val resolved_kind: expr.ExprKind = interpreted.ok.kind;

    var bad: i32 = 0;
    if (live_kind_after_resolve != pre_kind) { bad = 6; }
    or (resolved_kind != expr.EXPR_KIND_INDEX) { bad = 7; }

    t_dnit(?es);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.editor.resolve:generic_call_resolution_preserves_the_parsed_owner" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);

    val res_fid: res[source.FileId, fail.Fail] = open(?es, "buf.mach",
        "fun foo[T](x: T) T { ret x; }\nvar Marker: i32 = 5;\nfun main() i32 { ret foo[Marker](5); }\n");
    if (sel res_fid.err) { t_dnit(?es); session.dnit(?s); ret 50; }
    val fid: source.FileId = res_fid.ok;

    val res_parse: res[*ast.Ast, fail.Fail] = parse_buffer(?es, fid);
    if (sel res_parse.err) { t_dnit(?es); session.dnit(?s); ret 52; }
    val a: *ast.Ast = buffer_ast(?es, fid);
    if (a == nil) { t_dnit(?es); session.dnit(?s); ret 51; }

    var target: id.ExprId = id.EXPR_NIL;
    var ei: usize = 0;
    for (ei < a.expr_len) {
        if (a.exprs[ei].kind == expr.EXPR_KIND_CALL && a.exprs[ei].data.call.index_callee != id.EXPR_NIL) {
            target = ei::id.ExprId;
        }
        ei = ei + 1;
    }
    if (target == id.EXPR_NIL) { t_dnit(?es); session.dnit(?s); ret 2; }

    val pre_index_callee: id.ExprId = a.exprs[target].data.call.index_callee;

    val r1: res[*resolve.ResolveResult, fail.Fail] = resolve_buffer(?es, fid);
    if (sel r1.err) { t_dnit(?es); session.dnit(?s); ret 3; }
    val rr: *resolve.ResolveResult = buffer_resolve_of(?es, fid);
    if (rr == nil) { t_dnit(?es); session.dnit(?s); ret 4; }

    val live_index_callee_after_resolve: id.ExprId = a.exprs[target].data.call.index_callee;

    val interpreted: res[expr.Expr, fail.Fail] = resolve.expression(rr, a, target);
    if (sel interpreted.err) { t_dnit(?es); session.dnit(?s); ret 5; }
    val resolved_index_callee: id.ExprId = interpreted.ok.data.call.index_callee;

    var bad: i32 = 0;
    if (live_index_callee_after_resolve != pre_index_callee) { bad = 6; }
    or (resolved_index_callee != id.EXPR_NIL) { bad = 7; }

    t_dnit(?es);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.editor.resolve:indexed_call_resolution_preserves_the_parsed_owner" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);

    val res_fid: res[source.FileId, fail.Fail] = open(?es, "buf.mach",
        "var arr: [8]i32;\nvar Marker: i32 = 5;\nfun main() i32 { ret arr[Marker](5); }\n");
    if (sel res_fid.err) { t_dnit(?es); session.dnit(?s); ret 50; }
    val fid: source.FileId = res_fid.ok;

    val res_parse: res[*ast.Ast, fail.Fail] = parse_buffer(?es, fid);
    if (sel res_parse.err) { t_dnit(?es); session.dnit(?s); ret 52; }
    val a: *ast.Ast = buffer_ast(?es, fid);
    if (a == nil) { t_dnit(?es); session.dnit(?s); ret 51; }

    var target: id.ExprId = id.EXPR_NIL;
    var ei: usize = 0;
    for (ei < a.expr_len) {
        if (a.exprs[ei].kind == expr.EXPR_KIND_CALL && a.exprs[ei].data.call.index_callee != id.EXPR_NIL) {
            target = ei::id.ExprId;
        }
        ei = ei + 1;
    }
    if (target == id.EXPR_NIL) { t_dnit(?es); session.dnit(?s); ret 2; }

    val pre_callee:       id.ExprId = a.exprs[target].data.call.callee;
    val pre_index_callee: id.ExprId = a.exprs[target].data.call.index_callee;

    val r1: res[*resolve.ResolveResult, fail.Fail] = resolve_buffer(?es, fid);
    if (sel r1.err) { t_dnit(?es); session.dnit(?s); ret 3; }
    val rr: *resolve.ResolveResult = buffer_resolve_of(?es, fid);
    if (rr == nil) { t_dnit(?es); session.dnit(?s); ret 4; }

    val live_callee_after_resolve: id.ExprId = a.exprs[target].data.call.callee;

    val interpreted: res[expr.Expr, fail.Fail] = resolve.expression(rr, a, target);
    if (sel interpreted.err) { t_dnit(?es); session.dnit(?s); ret 5; }
    val resolved_callee: id.ExprId = interpreted.ok.data.call.callee;

    var bad: i32 = 0;
    if (live_callee_after_resolve != pre_callee) { bad = 6; }
    or (resolved_callee != pre_index_callee) { bad = 7; }
    or (a.exprs[target].data.call.index_callee != pre_index_callee) { bad = 8; }

    t_dnit(?es);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.editor.resolve:orphan_module_unreachable_from_entry_still_loads" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);

    var names: [2]str;
    names[0] = "main.mach"; names[1] = "orphan.mach";
    var texts: [2]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    texts[1] = "pub fun triple(x: i32) i32 { ret x * 3; }\n";
    val root_r: res[str, fail.Fail] = t_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val root: str = root_r.ok;

    val op_r: res[str, string.StrError] = str_join(?alloc, root, "/src/orphan.mach");
    if (sel op_r.err) { fs.remove_all(?alloc, root); t_dnit(?es); session.dnit(?s); ret 1; }
    val res_fid: res[source.FileId, fail.Fail] = open(?es, op_r.ok, texts[1]);
    if (sel res_fid.err) { fs.remove_all(?alloc, root); t_dnit(?es); session.dnit(?s); ret 1; }
    val fid: source.FileId = res_fid.ok;

    var bad: i32 = 0;

    val rr_res: res[*resolve.ResolveResult, fail.Fail] = resolve_buffer(?es, fid);
    if (sel rr_res.err) { bad = 1; }
    or (diag_has(?s.diags, "undeclared") || diag_has(?s.diags, "unresolved")) { bad = 1; }
    or (buffer_ast(?es, fid) == nil) { bad = 1; }

    fs.remove_all(?alloc, root);
    t_dnit(?es);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.editor.build:warm_rebuild_over_unsaved_buffer" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);

    var names: [3]str;
    names[0] = "main.mach"; names[1] = "a.mach"; names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "use edbuild.a.fa;\nuse edbuild.b.fb;\n#[symbol(\"_start\")]\nfun start() i32 { ret fa() + fb(); }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";
    val root_r: res[str, fail.Fail] = t_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val root: str = root_r.ok;

    val ap_r: res[str, string.StrError] = str_join(?alloc, root, "/src/a.mach");
    if (sel ap_r.err) { fs.remove_all(?alloc, root); t_dnit(?es); session.dnit(?s); ret 1; }
    val res_fid: res[source.FileId, fail.Fail] = open(?es, ap_r.ok, texts[1]);
    if (sel res_fid.err) { fs.remove_all(?alloc, root); t_dnit(?es); session.dnit(?s); ret 1; }
    val fid_a: source.FileId = res_fid.ok;

    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;

    var bad: i32 = 0;

    val r1: res[outcome.BuildOutcome, outcome.Fail] = build(?es, ?rq);
    if (sel r1.err) { fs.remove_all(?alloc, root); t_dnit(?es); session.dnit(?s); ret 1; }
    val bo1: outcome.BuildOutcome = r1.ok;
    if (bo1.severity != outcome.BUILD_OK)                { bad = 1; }
    if (bo1.artifacts.len != 1) { bad = 1; }
    or {
        val is_file_r: res[bool, io_error.Error] = fs.is_file(bo1.artifacts.data[0].path);
        if (sel is_file_r.err) { ret 99; }
        if (!(sel is_file_r.ok && is_file_r.ok)) { bad = 1; }
    }

    val st_a: session.StableModuleId = t_stable_of(?s, "edbuild.a");
    val st_b: session.StableModuleId = t_stable_of(?s, "edbuild.b");
    if (st_a == session.STABLE_MODULE_NIL || st_b == session.STABLE_MODULE_NIL) { bad = 1; }

    val sema_a_1: query.Revision = query.peek_revision(?s.queries, query.Q_SEMA,    st_a::u64);
    val cg_a_1:   query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64);
    val cg_b_1:   query.Revision = query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64);
    val lk_1:     query.Revision = query.peek_revision(?s.queries, query.Q_LINK, 0);
    if (sema_a_1 == 0 || cg_a_1 == 0 || cg_b_1 == 0 || lk_1 == 0) { bad = 1; }

    val r2: res[outcome.BuildOutcome, outcome.Fail] = build(?es, ?rq);
    if (sel r2.err) { fs.remove_all(?alloc, root); t_dnit(?es); session.dnit(?s); ret 1; }
    if (r2.ok.severity != outcome.BUILD_OK) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_SEMA,    st_a::u64) != sema_a_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64) != cg_a_1)   { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64) != cg_b_1)   { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LINK, 0)            != lk_1)     { bad = 1; }

    val res_up: res[bool, fail.Fail] = update(?es, fid_a, "pub fun fa() i32 { val t: i32 = 1; ret t; }\n");
    if (sel res_up.err)     { fs.remove_all(?alloc, root); t_dnit(?es); session.dnit(?s); ret 1; }
    if (!res_up.ok) { bad = 1; }

    val r3: res[outcome.BuildOutcome, outcome.Fail] = build(?es, ?rq);
    if (sel r3.err) { fs.remove_all(?alloc, root); t_dnit(?es); session.dnit(?s); ret 1; }
    val bo3: outcome.BuildOutcome = r3.ok;
    if (bo3.severity != outcome.BUILD_OK)                { bad = 1; }
    if (bo3.artifacts.len != 1) { bad = 1; }
    or {
        val is_file_r2: res[bool, io_error.Error] = fs.is_file(bo3.artifacts.data[0].path);
        if (sel is_file_r2.err) { ret 99; }
        if (!(sel is_file_r2.ok && is_file_r2.ok)) { bad = 1; }
    }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_a::u64) == cg_a_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_CODEGEN, st_b::u64) != cg_b_1) { bad = 1; }
    if (query.peek_revision(?s.queries, query.Q_LINK, 0)            == lk_1)   { bad = 1; }

    fs.remove_all(?alloc, root);
    t_dnit(?es);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.editor.build:missing_manifest_fails_user" {
    var alloc: A.Allocator;
