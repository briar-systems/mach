test "mach.lang.editor.type:a_leading_variadic_marker_is_refused_in_a_type" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);

    val res_fid: res[source.FileId, fail.Fail] = open(?es, "lead.mach",
        "def Bad: fun(...) i32;\nfun main() i32 { ret 0; }\n");
    if (sel res_fid.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val fid: source.FileId = res_fid.ok;

    val res_parse: res[*ast.Ast, fail.Fail] = parse_buffer(?es, fid);
    if (sel res_parse.err) { t_dnit(?es); session.dnit(?s); ret 1; }

    var bad: i32 = 0;
    val list: *diagnostic.DiagnosticStore = ?es.s.diags;
    if (!diag_has(list, "a C-variadic function type needs at least one fixed parameter before `...`") && bad == 0) { bad = 2; }
    if (diag_has(list, "was removed in v2.0.0")                                                       && bad == 0) { bad = 3; }

    t_dnit(?es);
    session.dnit(?s);
    ret bad;
}

fun t_deep_source(alloc: *A.Allocator, opens: usize) opt[str] {
    val head: str = "fun main() i32 { ret ";
    val tail: str = "; }\n";
    val n: usize = str_len(head) + opens * 2 + 1 + str_len(tail) + 1;
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, n);
    if (sel rb.err) { ret opt[str].none{}; }
    val buf: *u8 = rb.ok;
    var at: usize = 0;
    var i: usize = 0;
    for (i < str_len(head)) { buf[at] = head[i]::u8; at = at + 1; i = i + 1; }
    i = 0;
    for (i < opens) { buf[at] = '('::u8; at = at + 1; i = i + 1; }
    buf[at] = '1'::u8; at = at + 1;
    i = 0;
    for (i < opens) { buf[at] = ')'::u8; at = at + 1; i = i + 1; }
    i = 0;
    for (i < str_len(tail)) { buf[at] = tail[i]::u8; at = at + 1; i = i + 1; }
    buf[at] = 0;
    ret opt[str].some{buf::str};
}

fun t_driver_parse_outcome(alloc: *A.Allocator, root: str, diags_out: *diagnostic.DiagnosticStore) opt[outcome.Fail] {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret opt[outcome.Fail].some{outcome.internal("session")}; }
    var s: session.Session = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(?s.registry);
    if (sel setup_registry_r.err) { session.dnit(?s); ret opt[outcome.Fail].some{outcome.internal("registry")}; }
    var pick: manifest.Selection;
    pick.target = ""; pick.profile = ""; pick.artifact = ""; pick.want_lib = false; pick.has_artifact = false;
    val pr: res[project.Project, outcome.Fail] = driver.build_project_sel(?s, root, ?pick);
    var failure: opt[outcome.Fail] = opt[outcome.Fail].none{};
    if (sel pr.err) {
        var f: outcome.Fail = pr.err;
        val carried: opt[str] = outcome.text(f);
        if (sel carried.some) {
            if (carried.some != nil && str_len(carried.some) > 0) {
                val dup: res[str, string.StrError] = str_copy(alloc, carried.some);
                if (sel dup.ok) { f = outcome.with_text(f, dup.ok); }
                if (sel dup.err) { f = outcome.internal(outcome.str_text(dup.err)); }
            }
        }
        failure = opt[outcome.Fail].some{f};
    }
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
    }
    var i: usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d_r: opt[*diagnostic.Diagnostic] = diagnostic.get(?s.diags, i);
        if (sel d_r.some) {
            val d: *diagnostic.Diagnostic = d_r.some;
            diagnostic.record_error(diags_out, d.loc.file_id, d.loc.span, d.message);
        }
        i = i + 1;
    }
    session.dnit(?s);
    ret failure;
}

test "mach.lang.editor.parse:driver_and_editor_share_one_parse_outcome" {
    var alloc: A.Allocator;
    val res_session: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel res_session.err) { ret 1; }
    var s: session.Session = res_session.ok;
    var es: EditorSession = init(?s);
    var bad: i32 = 0;

    var names: [1]str; names[0] = "main.mach";
    var texts: [1]str; texts[0] = "val s: str = \"abc\nfun g(a: i64 { ret a ` ; }\nfun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = t_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val root: str = root_r.ok;

    var drv: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    fin { diagnostic.store_dnit(?drv); }
    val drv_fail: opt[outcome.Fail] = t_driver_parse_outcome(?alloc, root, ?drv);
    if (sel drv_fail.some && !outcome.is_reported(drv_fail.some)) { bad = 1; }

    val mp_r: res[str, string.StrError] = str_join(?alloc, root, "/src/main.mach");
    if (sel mp_r.err) { fs.remove_all(?alloc, root); t_dnit(?es); session.dnit(?s); ret 1; }
    val res_fid: res[source.FileId, fail.Fail] = open(?es, mp_r.ok, texts[0]);
    if (sel res_fid.err) { fs.remove_all(?alloc, root); t_dnit(?es); session.dnit(?s); ret 1; }
    val fid: source.FileId = res_fid.ok;
    var req: AnalysisRequest = analysis_request(fid, PHASE_PARSE);
    val parsed: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel parsed.err) { bad = 1; }
    if (sel parsed.ok) {
        var result: AnalysisResult = parsed.ok;
        fin { analysis_dnit(?result); }
        val res_ast: res[*ast.Ast, fail.Fail] = ast_of(?result);
        if (!sel result.status.kind.rejected || !(sel res_ast.ok && (res_ast.ok != nil && res_ast.ok.decl_len != 0))) { bad = 1; }
        val ed: *diagnostic.DiagnosticStore = result.diagnostics;
        val get_r: opt[*diagnostic.Diagnostic] = diagnostic.get(ed, 0);
        if (diagnostic.len(ed) < 2 || diagnostic.len(?drv) < diagnostic.len(ed) || sel get_r.none) { bad = 1; }
        or (sel get_r.some && !str_contains(get_r.some.message, "unterminated string")) { bad = 1; }
        or {
            var i: usize = 0;
            for (i < diagnostic.len(ed)) {
                val e_r: opt[*diagnostic.Diagnostic] = diagnostic.get(ed, i);
                val d_r: opt[*diagnostic.Diagnostic] = diagnostic.get(?drv, i);
                if (sel e_r.none) { ret 99; }
                if (sel d_r.none) { ret 99; }
                if (!str_equals(e_r.some.message,
                                d_r.some.message)) { bad = 1; }
                i = i + 1;
            }
        }
    }
    fs.remove_all(?alloc, root);

    val deep_o: opt[str] = t_deep_source(?alloc, 2100);
    if (sel deep_o.none) { t_dnit(?es); session.dnit(?s); ret 1; }
    var deep_names: [1]str; deep_names[0] = "main.mach";
    var deep_texts: [1]str; deep_texts[0] = deep_o.some;
    val root2_r: res[str, fail.Fail] = t_scaffold(?alloc, ?deep_names[0], ?deep_texts[0], 1);
    if (sel root2_r.err) { t_dnit(?es); session.dnit(?s); ret 1; }
    val root2: str = root2_r.ok;

    var drv2: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    fin { diagnostic.store_dnit(?drv2); }
    val drv2_fail: opt[outcome.Fail] = t_driver_parse_outcome(?alloc, root2, ?drv2);
    if (sel drv2_fail.none) { ret 99; }
    if (!outcome.is_reported(drv2_fail.some)) { bad = 3; }

    val mp2_r: res[str, string.StrError] = str_join(?alloc, root2, "/src/main.mach");
    if (sel mp2_r.err) { fs.remove_all(?alloc, root2); t_dnit(?es); session.dnit(?s); ret 1; }
    val res_fid2: res[source.FileId, fail.Fail] = open(?es, mp2_r.ok, deep_texts[0]);
    if (sel res_fid2.err) { fs.remove_all(?alloc, root2); t_dnit(?es); session.dnit(?s); ret 1; }
    req.file = res_fid2.ok;
    val parsed2: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel parsed2.err) { bad = 4; }
    if (sel parsed2.ok) {
        var result: AnalysisResult = parsed2.ok;
        fin { analysis_dnit(?result); }
        val res_ast2: res[*ast.Ast, fail.Fail] = ast_of(?result);
        if (!sel result.status.kind.rejected) { bad = 4; }
        if (!(sel result.failure.some && outcome.is_reported(result.failure.some))) { bad = 4; }
        if (!(sel res_ast2.ok && res_ast2.ok == nil)) { bad = 4; }
        if (diagnostic.len(?drv2) != 1 || diagnostic.len(result.diagnostics) != 1) { bad = 5; }
        or {
            val dd: *diagnostic.Diagnostic = ?drv2.items.data[0];
            val ed: *diagnostic.Diagnostic = ?result.diagnostics.items.data[0];
            if (dd.severity != diagnostic.SEVERITY_ERROR || ed.severity != diagnostic.SEVERITY_ERROR
                || !str_contains(dd.message, "input nests deeper than this parser descends")
                || !str_equals(dd.message, ed.message)) { bad = 6; }
            if (ed.loc.file_id != req.file
                || dd.loc.span.offset != ed.loc.span.offset || dd.loc.span.len != ed.loc.span.len
                || ed.loc.span.len == 0) { bad = 7; }
        }
    }

    fs.remove_all(?alloc, root2);
    t_dnit(?es);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.editor.analyze:owned_rejection_snapshot_preserves_allocation_refusal" {
    var backing: A.Allocator;
    val make_r: err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    val text: opt[str] = t_deep_source(?backing, state.MAX_NEST_DEPTH + 1);
    if (sel text.none) { ret 2; }
    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = text.some;
    val root_r: res[str, fail.Fail] = t_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 3; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?backing, root); }
    val path_r: res[str, string.StrError] = str_join(?backing, root, "/src/main.mach");
    if (sel path_r.err) { ret 4; }
    var total: usize = 0;
    var pass: u8 = 0;
    for (pass < 2) {
        val sr: res[session.Session, fail.Fail] = session.init(?backing);
        if (sel sr.err) { ret 5; }
        var s: session.Session = sr.ok;
        fin { session.dnit(?s); }
        var cnt: CountingAllocator;
        counting_init(?cnt, ?backing);
        var es: EditorSession = init(?s);
        es.alloc = ?cnt.allocator;
        fin { t_dnit(?es); }
        val opened: res[source.FileId, fail.Fail] = open(?es, path_r.ok, texts[0]);
        if (sel opened.err) { ret 6; }
        cnt.calls = 0;
        if (pass == 1) { cnt.fail_at = total; }
        var req: AnalysisRequest = analysis_request(opened.ok, PHASE_PARSE);
        val r: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
        if (pass == 0) {
            if (sel r.err) { ret 7; }
            var result: AnalysisResult = r.ok;
            fin { analysis_dnit(?result); }
            total = cnt.calls;
            if (total == 0) { ret 8; }
            if (cnt.last_size != 1) { ret 8; }
            if (!sel result.status.kind.rejected) { ret 8; }
            if (sel result.failure.none) { ret 8; }
            if (!outcome.is_reported(result.failure.some)) { ret 8; }
            if (!diag_has(result.diagnostics, "input nests deeper than this parser descends")) { ret 8; }
        } or {
            if (sel r.ok) {
                var result: AnalysisResult = r.ok;
                analysis_dnit(?result);
                ret 9;
            }
            var f: outcome.Fail = r.err;
            fin { fail_dnit(?es, ?f); }
            if (!sel f.internal) { ret 10; }
            if (!str_equals(outcome.describe(f), "out of memory")) { ret 10; }
            if (cnt.calls != total + 1) { ret 11; }
        }
        pass = pass + 1;
    }
    ret 0;
}

test "mach.lang.editor.close:reuses_slots_and_reopens_the_same_source_identity" {
    var alloc: A.Allocator;
    val t_session_r: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel t_session_r.err) { ret 99; }
    var s: session.Session = t_session_r.ok;
    fin { session.dnit(?s); }
    var es: EditorSession = init(?s);
    fin { t_dnit(?es); }
    val open_r: res[source.FileId, fail.Fail] = open(?es, "/mach-editor-retirement/kept.mach", "val kept: i32 = 1;");
    if (sel open_r.err) { ret 99; }
    val kept: source.FileId = open_r.ok;
    val open_r2: res[source.FileId, fail.Fail] = open(?es, "/mach-editor-retirement/first.mach", "val old: i32 = 2;");
    if (sel open_r2.err) { ret 99; }
    val first: source.FileId = open_r2.ok;
    val get_r: opt[*source.SourceFile] = source.get(?s.sources, first);
    if (sel get_r.none) { ret 99; }
    val revision: u64 = get_r.some.revision;
    val close_r: res[bool, fail.Fail] = close(?es, first);
    if (sel close_r.err) { ret 99; }
    if (!close_r.ok) { ret 1; }
    val get_r2: opt[*source.SourceFile] = source.get(?s.sources, first);
    if (sel get_r2.none) { ret 99; }
    if (get_r2.some.present) { ret 2; }
    var i: u32 = 0;
    for (i < 40) {
        val sprint_r: res[str, format.FormatError] = format.sprint(?alloc, "/mach-editor-retirement/file{}.mach", i);
        if (sel sprint_r.err) { ret 99; }
        val name: str = sprint_r.ok;
        fin { str_free(?alloc, name); }
        val open_r3: res[source.FileId, fail.Fail] = open(?es, name, "val value: i32 = 3;");
        if (sel open_r3.err) { ret 99; }
        val fid: source.FileId = open_r3.ok;
        val close_r2: res[bool, fail.Fail] = close(?es, fid);
        if (sel close_r2.err) { ret 99; }
        if (!close_r2.ok) { ret 3; }
        if (es.buf_len != BUFFERS_SEED || slot_live(?es, kept) == nil) { ret 4; }
        i = i + 1;
    }
    val open_r4: res[source.FileId, fail.Fail] = open(?es, "/mach-editor-retirement/first.mach", "val new: i32 = 4;");
    if (sel open_r4.err) { ret 99; }
    val reopened: source.FileId = open_r4.ok;
    val get_r3: opt[*source.SourceFile] = source.get(?s.sources, first);
    if (sel get_r3.none) { ret 99; }
    if (reopened != first || get_r3.some.revision <= revision) { ret 5; }
    val get_r4: opt[*source.SourceFile] = source.get(?s.sources, first);
    if (sel get_r4.none) { ret 99; }
    if (!str_equals(get_r4.some.text, "val new: i32 = 4;")) { ret 6; }
    val close_r3: res[bool, fail.Fail] = close(?es, 0xFFFFFFFE::source.FileId);
    if (sel close_r3.err) { ret 99; }
    if (close_r3.ok) { ret 7; }
    ret 0;
}

test "mach.lang.editor.analyze:owned_diagnostics_survive_retirement_and_raw_views_expire" {
    var alloc: A.Allocator;
    val t_session_r: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel t_session_r.err) { ret 99; }
    var s: session.Session = t_session_r.ok;
    var es: EditorSession = init(?s);
    val text: str = "fun f(a: i64 { ret a; }";
    val open_r: res[source.FileId, fail.Fail] = open(?es, "/mach-editor-owned-result/file.mach", text);
    if (sel open_r.err) { ret 99; }
    val fid: source.FileId = open_r.ok;
    var req: AnalysisRequest = analysis_request(fid, PHASE_PARSE);
    val analyze_r: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel analyze_r.err) { ret 99; }
    var result: AnalysisResult = analyze_r.ok;
    fin { analysis_dnit(?result); }
    if (!sel result.status.kind.rejected) { ret 1; }
    if (diagnostic.len(result.diagnostics) == 0) { ret 1; }
    if (result.sources.len != 1) { ret 1; }
    val before: res[*ast.Ast, fail.Fail] = ast_of(?result);
    if (sel before.err) { ret 2; }
    if (before.ok == nil) { ret 2; }
    val update_r: res[bool, fail.Fail] = update(?es, fid, "fun f() i64 { ret 1; }");
    if (sel update_r.err) { ret 99; }
    if (!update_r.ok) { ret 3; }
    val ast_of_r: res[*ast.Ast, fail.Fail] = ast_of(?result);
    if (sel ast_of_r.ok) { ret 4; }
    val close_r: res[bool, fail.Fail] = close(?es, fid);
    if (sel close_r.err) { ret 99; }
    if (!close_r.ok) { ret 5; }
    t_dnit(?es);
    session.dnit(?s);
    val analysis_source_r: opt[*source.SourceFile] = analysis_source(?result, fid);
    if (sel analysis_source_r.none) { ret 99; }
    val saved: *source.SourceFile = analysis_source_r.some;
    if (!str_equals(saved.text, text) || diagnostic.len(result.diagnostics) == 0) { ret 6; }
    val tokenize_r: res[lexer.TokenStream, fail.Fail] = tokenize(?result);
    if (sel tokenize_r.err) { ret 99; }
    var tokens: lexer.TokenStream = tokenize_r.ok;
    lexer.dnit(?tokens, result.alloc);
    ret 0;
}

test "mach.lang.editor.analyze:explicit_target_changes_context_and_expires_previous_view" {
    var alloc: A.Allocator;
    val t_session_r: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel t_session_r.err) { ret 99; }
    var s: session.Session = t_session_r.ok;
    fin { session.dnit(?s); }
    var es: EditorSession = init(?s);
    fin { t_dnit(?es); }
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(?s.registry);
    if (sel setup_registry_r.err) { ret 99; }
    var tr32: target.TargetRequest = target.target_request("rv32imafdc", "freestanding", "ilp32d");
    var tr64: target.TargetRequest = target.target_request("riscv64", "linux", "lp64d");
    val selected32: res[target.Target, fail.Fail] = target.resolve(?s.registry, ?tr32);
    if (sel selected32.err) { ret 6; }
    val selected64: res[target.Target, fail.Fail] = target.resolve(?s.registry, ?tr64);
    if (sel selected64.err) { ret 7; }
    var t32: target.Target = selected32.ok;
    var t64: target.Target = selected64.ok;
    val open_r: res[source.FileId, fail.Fail] = open(?es, "/mach-editor-target/file.mach",
        "$if ($mach.build.pointer_width == 4) { val selected: i32 = 32; } $or { val selected: i32 = 64; }");
    if (sel open_r.err) { ret 99; }
    val fid: source.FileId = open_r.ok;
    var req: AnalysisRequest = analysis_request(fid, PHASE_RESOLVE);
    req.standalone_target = ?t32;
    val analyze_r: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel analyze_r.err) { ret 99; }
    var first: AnalysisResult = analyze_r.ok;
    fin { analysis_dnit(?first); }
    if (!sel first.status.kind.accepted) { ret 1; }
    if (!first.target_available) { ret 1; }
    if (first.target.pointer_width != 4) { ret 1; }
    val resolve_of_r: res[*resolve.ResolveResult, fail.Fail] = resolve_of(?first);
    if (sel resolve_of_r.err) { ret 2; }
    req.standalone_target = ?t64;
    req.build.opt = pipeline.OPT_RELEASE;
    val analyze_r2: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel analyze_r2.err) { ret 99; }
    var second: AnalysisResult = analyze_r2.ok;
    fin { analysis_dnit(?second); }
    if (!sel second.status.kind.accepted) { ret 3; }
    if (second.target.pointer_width != 8) { ret 3; }
    if (second.target.mode != comptime.MODE_RELEASE) { ret 3; }
    val resolve_of_r2: res[*resolve.ResolveResult, fail.Fail] = resolve_of(?first);
    if (sel resolve_of_r2.ok) { ret 4; }
    if (first.target.pointer_width != 4 || first.target.mode != comptime.MODE_DEBUG) { ret 5; }
    ret 0;
}

fun t_atomic_buffer_action(es: *EditorSession, fid: source.FileId, action: u8) err[fail.Fail] {
    if (action == 0) {
        val open_r: res[source.FileId, fail.Fail] = open(es, "/mach-editor-atomic/new.mach", "val fresh: i32 = 8;");
        if (sel open_r.err) { ret err[fail.Fail].err{open_r.err}; }
        ret err[fail.Fail].ok{};
    }
    if (action == 1) {
        val update_r: res[bool, fail.Fail] = update(es, fid, "val replaced: i32 = 9;");
        if (sel update_r.err) { ret err[fail.Fail].err{update_r.err}; }
        ret err[fail.Fail].ok{};
    }
    if (action == 2) {
        val close_r: res[bool, fail.Fail] = close(es, fid);
        if (sel close_r.err) { ret err[fail.Fail].err{close_r.err}; }
        ret err[fail.Fail].ok{};
    }
    ret dnit(es);
}

test "mach.lang.editor.lifecycle:allocation_refusal_preserves_open_buffers_and_retry" {
    var backing: A.Allocator;
    val make_r: err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var action: u8 = 0;
    for (action < 4) {
        var total: usize = 0;
        var refusal: usize = 0;
        for (refusal == 0 || refusal <= total) {
            var cnt: CountingAllocator;
            counting_init(?cnt, ?backing);
            val session_r: res[session.Session, fail.Fail] = session.init(?cnt.allocator);
            if (sel session_r.err) { ret 99; }
            var s: session.Session = session_r.ok;
            var es: EditorSession = init(?s);
            val path: str = "/mach-editor-atomic/old.mach";
            val text: str = "val retained: i32 = 7;";
            val open_r: res[source.FileId, fail.Fail] = open(?es, path, text);
            if (sel open_r.err) { ret 99; }
            val fid: source.FileId = open_r.ok;
            val open_r2: res[source.FileId, fail.Fail] = open(?es, "/mach-editor-atomic/other.mach", "val other: i32 = 6;");
            if (sel open_r2.err) { ret 99; }
            val other: source.FileId = open_r2.ok;
            var req: AnalysisRequest = analysis_request(fid, PHASE_PARSE);
            val analyze_r: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
            if (sel analyze_r.err) { ret 99; }
            var result: AnalysisResult = analyze_r.ok;
            val get_r: opt[*source.SourceFile] = source.get(?s.sources, fid);
            if (sel get_r.none) { ret 99; }
            val revision: u64 = get_r.some.revision;
            val generation: u64 = es.view_generation;
            cnt.calls = 0;
            cnt.fail_at = refusal;
            val applied: err[fail.Fail] = t_atomic_buffer_action(?es, fid, action);
            cnt.fail_at = 0;
            if (refusal == 0) {
                if (sel applied.err) { ret 2; }
                total = cnt.calls;
                if (total == 0) { ret 3; }
            }
            or {
                if (sel applied.ok) { ret 4; }
                if (es.view_generation != generation || slot_live(?es, other) == nil || slot_live(?es, fid) == nil) { ret 5; }
                val get_r2: opt[*source.SourceFile] = source.get(?s.sources, fid);
                if (sel get_r2.none) { ret 99; }
                val current: *source.SourceFile = get_r2.some;
                if (current.revision != revision || !current.present || !str_equals(current.text, text)) { ret 6; }
                val overlay: opt[str] = session.overlay_get(?s, path);
                if (sel overlay.none) { ret 7; }
                if (!str_equals(overlay.some, text)) { ret 7; }
                val ast_of_r: res[*ast.Ast, fail.Fail] = ast_of(?result);
                if (sel ast_of_r.err) { ret 8; }
                val t_atomic_buffer_action_r: err[fail.Fail] = t_atomic_buffer_action(?es, fid, action);
                if (sel t_atomic_buffer_action_r.err) { ret 9; }
            }
            analysis_dnit(?result);
            if (action != 3) { t_dnit(?es); }
            if (s.overlay_len != 0) { ret 10; }
            session.dnit(?s);
            if (cnt.live != 0) { ret 11; }
            refusal = refusal + 1;
        }
        action = action + 1;
    }
    ret 0;
}

test "mach.lang.editor.close:removes_extra_roots_and_reloads_closed_dependencies_from_disk" {
    var alloc: A.Allocator;
    val t_session_r: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel t_session_r.err) { ret 99; }
    var s: session.Session = t_session_r.ok;
    fin { session.dnit(?s); }
    var es: EditorSession = init(?s);
    fin { t_dnit(?es); }
    var names: [3]str = [3]str{ "main.mach", "helper.mach", "orphan.mach" };
    var texts: [3]str = [3]str{
        "use edbuild.helper; fun main() i32 { ret helper.square(3); }",
        "pub fun square(x: i32) i32 { ret x * x; }",
        "fun orphan() i32 { ret 1; }"
    };
    val t_scaffold_r: res[str, fail.Fail] = t_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel t_scaffold_r.err) { ret 99; }
    val root: str = t_scaffold_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val str_join_r: res[str, string.StrError] = str_join(?alloc, root, "/src/main.mach");
    if (sel str_join_r.err) { ret 99; }
    val main_path: str = str_join_r.ok;
    fin { str_free(?alloc, main_path); }
    val str_join_r2: res[str, string.StrError] = str_join(?alloc, root, "/src/helper.mach");
    if (sel str_join_r2.err) { ret 99; }
    val dep_path: str = str_join_r2.ok;
    fin { str_free(?alloc, dep_path); }
    val str_join_r3: res[str, string.StrError] = str_join(?alloc, root, "/src/orphan.mach");
    if (sel str_join_r3.err) { ret 99; }
    val orphan_path: str = str_join_r3.ok;
    fin { str_free(?alloc, orphan_path); }
    val open_r: res[source.FileId, fail.Fail] = open(?es, main_path,
        "use edbuild.helper; fun main() i32 { ret helper.cube(3); }");
    if (sel open_r.err) { ret 99; }
    val main: source.FileId = open_r.ok;
    val open_r2: res[source.FileId, fail.Fail] = open(?es, dep_path,
        "pub fun cube(x: i32) i32 { ret x * x * x; }");
    if (sel open_r2.err) { ret 99; }
    val dep: source.FileId = open_r2.ok;
    val open_r3: res[source.FileId, fail.Fail] = open(?es, orphan_path,
        "fun orphan() i32 { ret missing; }");
    if (sel open_r3.err) { ret 99; }
    val orphan: source.FileId = open_r3.ok;
    var req: AnalysisRequest = analysis_request(main, PHASE_SEMA);
    req.build.target = "linux";
    val analyze_r: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel analyze_r.err) { ret 99; }
    var bad: AnalysisResult = analyze_r.ok;
    if (!sel bad.status.kind.rejected) { ret 1; }
    if (!diag_has(bad.diagnostics, "missing")) { ret 1; }
    analysis_dnit(?bad);
    val close_r: res[bool, fail.Fail] = close(?es, orphan);
    if (sel close_r.err) { ret 99; }
    if (slot_live(?es, main) == nil || slot_live(?es, dep) == nil || slot_live(?es, orphan) != nil) { ret 2; }
    val analyze_r2: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel analyze_r2.err) { ret 99; }
    var valid: AnalysisResult = analyze_r2.ok;
    if (!sel valid.status.kind.accepted) { ret 3; }
    if (valid.configuration.len == 0) { ret 3; }
    if (es.proj_root_count != 2) { ret 3; }
    analysis_dnit(?valid);
    val close_r2: res[bool, fail.Fail] = close(?es, dep);
    if (sel close_r2.err) { ret 99; }
    val analyze_r3: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel analyze_r3.err) { ret 99; }
    var disk: AnalysisResult = analyze_r3.ok;
    if (!sel disk.status.kind.rejected) { ret 4; }
    if (!diag_has(disk.diagnostics, "cube")) { ret 4; }
    analysis_dnit(?disk);
    val get_r: opt[*source.SourceFile] = source.get(?s.sources, dep);
    if (sel get_r.none) { ret 99; }
    if (!str_equals(get_r.some.text, texts[1])) { ret 5; }
    val update_r: res[bool, fail.Fail] = update(?es, main, texts[0]);
    if (sel update_r.err) { ret 99; }
    val analyze_r4: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel analyze_r4.err) { ret 99; }
    var restored: AnalysisResult = analyze_r4.ok;
    if (!sel restored.status.kind.accepted) { ret 6; }
    if (es.proj_root_count != 1) { ret 6; }
    analysis_dnit(?restored);
    val open_r4: res[source.FileId, fail.Fail] = open(?es, dep_path,
        "pub fun square(x: i32) i32 { ret x + x; }");
    if (sel open_r4.err) { ret 99; }
    val reopened: source.FileId = open_r4.ok;
    if (reopened != dep) { ret 7; }
    val analyze_r5: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel analyze_r5.err) { ret 99; }
    var fresh: AnalysisResult = analyze_r5.ok;
    if (!sel fresh.status.kind.accepted) { ret 8; }
    if (es.proj_root_count != 2) { ret 8; }
    analysis_dnit(?fresh);
    ret 0;
}

test "mach.lang.editor.analyze:project_phase_does_not_run_later_frontend_work" {
    var alloc: A.Allocator;
    val t_session_r: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel t_session_r.err) { ret 99; }
    var s: session.Session = t_session_r.ok;
    fin { session.dnit(?s); }
    var es: EditorSession = init(?s);
    fin { t_dnit(?es); }
    var names: [1]str = [1]str{ "main.mach" };
    var texts: [1]str = [1]str{ "use edbuild.absent; fun main() i32 { ret missing; }" };
    val t_scaffold_r: res[str, fail.Fail] = t_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel t_scaffold_r.err) { ret 99; }
    val root: str = t_scaffold_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val str_join_r: res[str, string.StrError] = str_join(?alloc, root, "/src/main.mach");
    if (sel str_join_r.err) { ret 99; }
    val path: str = str_join_r.ok;
    fin { str_free(?alloc, path); }
    val open_r: res[source.FileId, fail.Fail] = open(?es, path, texts[0]);
    if (sel open_r.err) { ret 99; }
    val fid: source.FileId = open_r.ok;
    var req: AnalysisRequest = analysis_request(fid, PHASE_PARSE);
    req.build.target = "linux";
    val analyze_r: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel analyze_r.err) { ret 99; }
    var parsed: AnalysisResult = analyze_r.ok;
    if (!sel parsed.status.kind.accepted) { ret 1; }
    if (diagnostic.has_errors(parsed.diagnostics)) { ret 1; }
    if (es.proj.module_len != 1) { ret 1; }
    if (query.shard_len(?s.queries, query.Q_RESOLVE) != 0) { ret 1; }
    if (query.shard_len(?s.queries, query.Q_SEMA) != 0) { ret 1; }
    val resolve_of_r: res[*resolve.ResolveResult, fail.Fail] = resolve_of(?parsed);
    if (sel resolve_of_r.ok) { ret 2; }
    analysis_dnit(?parsed);
    val update_r: res[bool, fail.Fail] = update(?es, fid, "fun main() i32 { ret \"wrong\"; }");
    if (sel update_r.err) { ret 99; }
    req.phase = PHASE_RESOLVE;
    val analyze_r2: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel analyze_r2.err) { ret 99; }
    var resolved: AnalysisResult = analyze_r2.ok;
    if (!sel resolved.status.kind.accepted) { ret 3; }
    if (diagnostic.has_errors(resolved.diagnostics)) { ret 3; }
    if (query.shard_len(?s.queries, query.Q_SEMA) != 0) { ret 3; }
    val sema_of_r: res[*context.SemaResult, fail.Fail] = sema_of(?resolved);
    if (sel sema_of_r.ok) { ret 4; }
    analysis_dnit(?resolved);
    req.phase = PHASE_SEMA;
    val analyze_r3: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel analyze_r3.err) { ret 99; }
    var typed: AnalysisResult = analyze_r3.ok;
    if (!sel typed.status.kind.rejected) { ret 5; }
    if (!diag_has(typed.diagnostics, "type mismatch")) { ret 5; }
    analysis_dnit(?typed);
    ret 0;
}

test "mach.lang.editor.close:refuses_during_an_outstanding_query_and_keeps_every_buffer" {
    var alloc: A.Allocator;
    val t_session_r: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel t_session_r.err) { ret 99; }
    var s: session.Session = t_session_r.ok;
    fin { session.dnit(?s); }
    var es: EditorSession = init(?s);
    fin { t_dnit(?es); }
    val open_r: res[source.FileId, fail.Fail] = open(?es, "/mach-editor-outstanding/kept.mach", "val kept: i32 = 1;");
    if (sel open_r.err) { ret 99; }
    val kept: source.FileId = open_r.ok;
    val open_r2: res[source.FileId, fail.Fail] = open(?es, "/mach-editor-outstanding/target.mach", "val gone: i32 = 2;");
    if (sel open_r2.err) { ret 99; }
    val target: source.FileId = open_r2.ok;
    var req: AnalysisRequest = analysis_request(target, PHASE_PARSE);
    val analyze_r: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel analyze_r.err) { ret 99; }
    var result: AnalysisResult = analyze_r.ok;
    fin { analysis_dnit(?result); }
    val get_r: opt[*source.SourceFile] = source.get(?s.sources, target);
    if (sel get_r.none) { ret 99; }
    val revision: u64 = get_r.some.revision;
    val opened: res[query.Operation, fail.Fail] = query.begin(?s.queries);
    if (sel opened.err) { ret 1; }
    val operation: query.Operation = opened.ok;
    val refused: res[bool, fail.Fail] = close(?es, target);
    if (sel refused.ok) { query.end(?s.queries, operation); query.discard(?s.queries, operation); ret 2; }
    if (slot_live(?es, target) == nil || slot_live(?es, kept) == nil) { query.end(?s.queries, operation); query.discard(?s.queries, operation); ret 3; }
    val get_r2: opt[*source.SourceFile] = source.get(?s.sources, target);
    if (sel get_r2.none) { ret 99; }
    val current: *source.SourceFile = get_r2.some;
    val overlay_get_r: opt[str] = session.overlay_get(?s, "/mach-editor-outstanding/target.mach");
    if (!current.present) {
        query.end(?s.queries, operation); query.discard(?s.queries, operation); ret 4;
    }
    if (current.revision != revision) {
        query.end(?s.queries, operation); query.discard(?s.queries, operation); ret 4;
    }
    if (sel overlay_get_r.none) {
        query.end(?s.queries, operation); query.discard(?s.queries, operation); ret 4;
    }
    val end_r: err[fail.Fail] = query.end(?s.queries, operation);
    if (sel end_r.err) { ret 5; }
    val discard_r: err[fail.Fail] = query.discard(?s.queries, operation);
    if (sel discard_r.err) { ret 6; }
    val closed: res[bool, fail.Fail] = close(?es, target);
    if (sel closed.err) { ret 7; }
    if (!closed.ok) { ret 7; }
    if (slot_live(?es, target) != nil || slot_live(?es, kept) == nil) { ret 8; }
    val get_r3: opt[*source.SourceFile] = source.get(?s.sources, target);
    if (sel get_r3.none) { ret 99; }
    if (get_r3.some.present) { ret 9; }
    val overlay_get_r2: opt[str] = session.overlay_get(?s, "/mach-editor-outstanding/target.mach");
    if (sel overlay_get_r2.some) { ret 10; }
    val ast_of_r: res[*ast.Ast, fail.Fail] = ast_of(?result);
    if (sel ast_of_r.ok) { ret 11; }
    val analysis_source_r: opt[*source.SourceFile] = analysis_source(?result, target);
    if (diagnostic.len(result.diagnostics) != 0) { ret 11; }
    if (sel analysis_source_r.none) { ret 11; }
    ret 0;
}

test "mach.lang.editor.close:repeated_open_update_close_leaves_unrelated_products_and_identities_valid" {
    var alloc: A.Allocator;
    val t_session_r: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel t_session_r.err) { ret 99; }
    var s: session.Session = t_session_r.ok;
    fin { session.dnit(?s); }
    var es: EditorSession = init(?s);
    fin { t_dnit(?es); }
    val open_r: res[source.FileId, fail.Fail] = open(?es, "/mach-editor-unrelated/kept.mach", "val kept: i32 = 1;");
    if (sel open_r.err) { ret 99; }
    val kept: source.FileId = open_r.ok;
    val kept_input: query.Revision = query.peek_revision(?s.queries, query.Q_FILE_TEXT, kept::u64);
    val get_r: opt[*source.SourceFile] = source.get(?s.sources, kept);
    if (sel get_r.none) { ret 99; }
    val kept_source: u64 = get_r.some.revision;
    if (kept_input == 0) { ret 1; }
    var first: source.FileId = source.FILE_NIL;
    var turn: u32 = 0;
    for (turn < 3) {
        val open_r2: res[source.FileId, fail.Fail] = open(?es, "/mach-editor-unrelated/churn.mach", "val churn: i32 = 2;");
        if (sel open_r2.err) { ret 99; }
        val fid: source.FileId = open_r2.ok;
        if (turn == 0) { first = fid; }
        or (fid != first) { ret 2; }
        if (query.peek_revision(?s.queries, query.Q_FILE_TEXT, fid::u64) == 0) { ret 3; }
        val update_r: res[bool, fail.Fail] = update(?es, fid, "val churn: i32 = 3;");
        if (sel update_r.err) { ret 99; }
        if (!update_r.ok) { ret 4; }
        var req: AnalysisRequest = analysis_request(fid, PHASE_PARSE);
        val analyze_r: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
        if (sel analyze_r.err) { ret 99; }
        var result: AnalysisResult = analyze_r.ok;
        if (!sel result.status.kind.accepted) { analysis_dnit(?result); ret 5; }
        analysis_dnit(?result);
        val close_r: res[bool, fail.Fail] = close(?es, fid);
        if (sel close_r.err) { ret 99; }
        if (!close_r.ok) { ret 6; }
        if (query.peek_revision(?s.queries, query.Q_FILE_TEXT, fid::u64) != 0 || query.shard_len(?s.queries, query.Q_FILE_TEXT) != 1) { ret 7; }
        val get_r2: opt[*source.SourceFile] = source.get(?s.sources, fid);
        if (sel get_r2.none) { ret 99; }
        if (get_r2.some.present) { ret 8; }
        if (query.peek_revision(?s.queries, query.Q_FILE_TEXT, kept::u64) != kept_input) { ret 9; }
        val get_r3: opt[*source.SourceFile] = source.get(?s.sources, kept);
        if (sel get_r3.none) { ret 99; }
        if (get_r3.some.revision != kept_source || slot_live(?es, kept) == nil) { ret 10; }
        if (es.buf_len != BUFFERS_SEED) { ret 11; }
        turn = turn + 1;
    }
    val overlay_get_r: opt[str] = session.overlay_get(?s, "/mach-editor-unrelated/kept.mach");
    if (sel overlay_get_r.none) { ret 12; }
    if (s.overlay_len != 1) { ret 12; }
    ret 0;
}

# the tightest expression at the byte offset of a needle in the buffer text, or EXPR_NIL
fun t_expr_at(a: *ast.Ast, text: str, needle: str, skip: usize) id.ExprId {
    val found: opt[usize] = str_index_of(text, needle);
    if (sel found.none) { ret id.EXPR_NIL; }
    ret ast.offset_to_expr(a, found.some + skip);
}

fun t_offset_of(text: str, needle: str) usize {
    val found: opt[usize] = str_index_of(text, needle);
    if (sel found.none) { ret 0xFFFFFFFF; }
    ret found.some;
}

fun t_case_name_is(s: *session.Session, entry: *type.FieldEntry, name: str) bool {
    val found: opt[str] = intern.lookup(?s.interner, entry.name);
    ret sel found.some && str_equals(found.some, name);
}

test "mach.lang.editor.tag:hover_data_covers_the_tag_its_cases_sel_and_the_discriminator" {
    var alloc: A.Allocator;
    val t_session_r: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel t_session_r.err) { ret 99; }
    var s: session.Session = t_session_r.ok;
    fin { session.dnit(?s); }
    var es: EditorSession = init(?s);
    fin { t_dnit(?es); }
    val src: str = "tag Reply: u16 { empty; value: i64; }\nfun f(r: Reply) i64 { val t: u8 = sel r.value; if (sel r.value) { ret r.value; } ret 0; }\n";
    val open_r: res[source.FileId, fail.Fail] = open(?es, "hover.mach", src);
    if (sel open_r.err) { ret 99; }
    val fid: source.FileId = open_r.ok;
    var req: AnalysisRequest = analysis_request(fid, PHASE_SEMA);
    val analyze_r: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel analyze_r.err) { ret 99; }
    var result: AnalysisResult = analyze_r.ok;
    fin { analysis_dnit(?result); }
    if (!sel result.status.kind.accepted) { ret 1; }
    if (diagnostic.len(result.diagnostics) != 0) { ret 1; }
    val ast_of_r: res[*ast.Ast, fail.Fail] = ast_of(?result);
    if (sel ast_of_r.err) { ret 99; }
    val a: *ast.Ast = ast_of_r.ok;

    # the place of a `sel` is the tag; its case table is the hover data for the cases
    val eid_r: id.ExprId = t_expr_at(a, src, "sel r.value;", 4);
    val expr_type_of_r: res[type.TypeId, fail.Fail] = expr_type_of(?result, eid_r);
    if (sel expr_type_of_r.err) { ret 99; }
    val ty_r: type.TypeId = expr_type_of_r.ok;
    if (eid_r == id.EXPR_NIL || !type.is_tag(?s.types, ty_r)) { ret 2; }
    if (type.field_count(?s.types, ty_r) != 2) { ret 3; }
    val empty: opt[*type.FieldEntry] = type.field_at(?s.types, ty_r, 0);
    val value: opt[*type.FieldEntry] = type.field_at(?s.types, ty_r, 1);
    if (sel empty.none) { ret 4; }
    if (sel value.none) { ret 4; }
    if (!t_case_name_is(?s, empty.some, "empty") || empty.some.ty != type.TYPE_NIL) { ret 5; }
    val prim_r: opt[type.TypeId] = type.prim(?s.types, type.TYPE_I64);
    if (sel prim_r.none) { ret 99; }
    val i64_id: type.TypeId = prim_r.some;
    if (!t_case_name_is(?s, value.some, "value") || value.some.ty != i64_id) { ret 6; }

    # the `sel` expression itself is a bool, the binding it initializes agrees
    val eid_sel: id.ExprId = t_expr_at(a, src, "sel r.value;", 0);
    val expr_type_of_r2: res[type.TypeId, fail.Fail] = expr_type_of(?result, eid_sel);
    if (sel expr_type_of_r2.err) { ret 99; }
    val ty_sel: type.TypeId = expr_type_of_r2.ok;
    if (eid_sel == id.EXPR_NIL) { ret 7; }
    if (ty_sel == type.TYPE_ERROR) { ret 7; }
    if (ty_sel == type.TYPE_NIL) { ret 7; }
    val prim_r2: opt[type.TypeId] = type.prim(?s.types, type.TYPE_U8);
    if (sel prim_r2.none) { ret 99; }
    if (ty_sel != prim_r2.some) { ret 8; }

    # a payload place under its guard has the payload type
    val eid_payload: id.ExprId = t_expr_at(a, src, "ret r.value;", 6);
    val expr_type_of_r3: res[type.TypeId, fail.Fail] = expr_type_of(?result, eid_payload);
    if (sel expr_type_of_r3.err) { ret 99; }
    if (eid_payload == id.EXPR_NIL || expr_type_of_r3.ok != i64_id) { ret 10; }

    # the declared discriminator width
    if (type.tag_discriminator_bytes(?s.types, ty_r) != 2) { ret 11; }
    val disc: type.TypeId = type.tag_discriminator(?s.types, ty_r);
    val prim_r3: opt[type.TypeId] = type.prim(?s.types, type.TYPE_U16);
    if (sel prim_r3.none) { ret 99; }
    if (disc != prim_r3.some) { ret 12; }
    ret 0;
}

test "mach.lang.editor.tag:case_completion_after_a_dangling_type_dot_still_lists_the_cases" {
    var alloc: A.Allocator;
    val t_session_r: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel t_session_r.err) { ret 99; }
    var s: session.Session = t_session_r.ok;
    fin { session.dnit(?s); }
    var es: EditorSession = init(?s);
    fin { t_dnit(?es); }
    val src: str = "tag Reply: u8 { empty; value: i64; }\nfun f() Reply { ret Reply.\n}\nfun ok() i64 { ret 7; }\n";
    val open_r: res[source.FileId, fail.Fail] = open(?es, "complete.mach", src);
    if (sel open_r.err) { ret 99; }
    val fid: source.FileId = open_r.ok;
    var req: AnalysisRequest = analysis_request(fid, PHASE_SEMA);
    val analyze_r: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel analyze_r.err) { ret 99; }
    var result: AnalysisResult = analyze_r.ok;
    fin { analysis_dnit(?result); }
    if (!sel result.status.kind.rejected) { ret 1; }
    if (diagnostic.len(result.diagnostics) == 0) { ret 1; }
    val ast_of_r: res[*ast.Ast, fail.Fail] = ast_of(?result);
    if (sel ast_of_r.err) { ret 99; }
    val a: *ast.Ast = ast_of_r.ok;
    val resolve_of_r: res[*resolve.ResolveResult, fail.Fail] = resolve_of(?result);
    if (sel resolve_of_r.err) { ret 99; }
    val rr: *resolve.ResolveResult = resolve_of_r.ok;
    # the head before the dangling dot still resolves to the tag declaration
    # the dangling `Reply.` parses as a member whose object is the head identifier; the
    # identifier resolves to the tag, which is the completion anchor
    var eid_head: id.ExprId = t_expr_at(a, src, "Reply.\n", 0);
    if (eid_head == id.EXPR_NIL || eid_head >= rr.expr_count) { ret 2; }
    if (a.exprs[eid_head].kind == expr.EXPR_KIND_MEMBER) { eid_head = a.exprs[eid_head].data.member.object; }
    if (eid_head == id.EXPR_NIL || eid_head >= rr.expr_count) { ret 31; }
    val sid: resolve.SymbolId = rr.expr_resolved[eid_head];
    if (sid == resolve.SYMBOL_NIL || sid >= rr.symbol_count) { ret 32; }
    if (rr.symbols[sid].kind != resolve.SYM_TAG) { ret 33; }
    val did: id.DeclId = rr.symbols[sid].decl;
    val decl_type_of_r: res[type.TypeId, fail.Fail] = decl_type_of(?result, did);
    if (sel decl_type_of_r.err) { ret 99; }
    val tag_ty: type.TypeId = decl_type_of_r.ok;
    if (!type.is_tag(?s.types, tag_ty) || type.field_count(?s.types, tag_ty) != 2) { ret 4; }
    val value: opt[*type.FieldEntry] = type.field_at(?s.types, tag_ty, 1);
    if (sel value.none) { ret 5; }
    if (!t_case_name_is(?s, value.some, "value")) { ret 5; }
    # the rest of the buffer still has editor data
    val eid_seven: id.ExprId = t_expr_at(a, src, "ret 7", 4);
    val expr_type_of_r: res[type.TypeId, fail.Fail] = expr_type_of(?result, eid_seven);
    if (sel expr_type_of_r.err) { ret 99; }
    val prim_r: opt[type.TypeId] = type.prim(?s.types, type.TYPE_I64);
    if (sel prim_r.none) { ret 99; }
    if (eid_seven == id.EXPR_NIL || expr_type_of_r.ok != prim_r.some) { ret 6; }
    ret 0;
}

test "mach.lang.editor.tag:go_to_definition_maps_a_case_use_to_its_declaring_case_span" {
    var alloc: A.Allocator;
    val t_session_r: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel t_session_r.err) { ret 99; }
    var s: session.Session = t_session_r.ok;
    fin { session.dnit(?s); }
    var es: EditorSession = init(?s);
    fin { t_dnit(?es); }
    val src: str = "tag Reply: u8 { empty; value: i64; }\nfun f(r: Reply) Reply { if (sel r.value) { ret Reply.value{r.value}; } ret Reply.empty{}; }\n";
    val open_r: res[source.FileId, fail.Fail] = open(?es, "goto.mach", src);
    if (sel open_r.err) { ret 99; }
    val fid: source.FileId = open_r.ok;
    var req: AnalysisRequest = analysis_request(fid, PHASE_SEMA);
    val analyze_r: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel analyze_r.err) { ret 99; }
    var result: AnalysisResult = analyze_r.ok;
    fin { analysis_dnit(?result); }
    if (!sel result.status.kind.accepted) { ret 1; }
    val ast_of_r: res[*ast.Ast, fail.Fail] = ast_of(?result);
    if (sel ast_of_r.err) { ret 99; }
    val a: *ast.Ast = ast_of_r.ok;
    val resolve_of_r: res[*resolve.ResolveResult, fail.Fail] = resolve_of(?result);
    if (sel resolve_of_r.err) { ret 99; }
    val rr: *resolve.ResolveResult = resolve_of_r.ok;
    val declared_value: usize = t_offset_of(src, "value: i64");

    # construction: the literal head names the case; the head's type reference resolves to the declaration
    val head_off: usize = t_offset_of(src, "Reply.value{");
    val tid: id.TypeId = ast.offset_to_type(a, head_off);
    if (tid == id.TYPE_NIL || tid >= rr.type_count) { ret 2; }
    val head: *atype.Type = ?a.types[tid];
    if (head.kind != atype.TYPE_KIND_NAMED || head.data.named.case_name.offset != head_off + 6) { ret 3; }
    val resolved_type_of_r: res[type.TypeId, fail.Fail] = resolved_type_of(?result, tid);
    if (sel resolved_type_of_r.err) { ret 99; }
    val tag_ty: type.TypeId = resolved_type_of_r.ok;
    if (!type.is_tag(?s.types, tag_ty)) { ret 4; }
    var case_index: u32 = 0xFFFFFFFF;
    var i: u32 = 0;
    for (i < type.field_count(?s.types, tag_ty)) {
        val field_at_r: opt[*type.FieldEntry] = type.field_at(?s.types, tag_ty, i);
        if (sel field_at_r.none) { ret 99; }
        if (t_case_name_is(?s, field_at_r.some, "value")) { case_index = i; }
        i = i + 1;
    }
    if (case_index != 1) { ret 5; }
    val sid: resolve.SymbolId = rr.type_resolved[tid];
    if (sid == resolve.SYMBOL_NIL || sid >= rr.symbol_count || rr.symbols[sid].kind != resolve.SYM_TAG) { ret 6; }
    val did: id.DeclId = rr.symbols[sid].decl;
    if (did == id.DECL_NIL || did >= a.decl_len::u32 || a.decls[did].kind != decl.DECL_KIND_TAG) { ret 7; }
    val case_span_offset: usize = a.tag_cases[a.decls[did].data.tag_.cases_start + case_index].name.offset;
    if (case_span_offset != declared_value) { ret 8; }

    # a `sel` names the case on its place; the place's tag is the same declaration
    val eid_sel: id.ExprId = t_expr_at(a, src, "sel r.value", 0);
    if (eid_sel == id.EXPR_NIL) { ret 9; }
    if (a.exprs[eid_sel].kind != expr.EXPR_KIND_SEL) { ret 9; }
    val sel_case: usize = a.exprs[eid_sel].data.sel.case_name.offset;
    if (sel_case != t_offset_of(src, "sel r.value") + 6) { ret 10; }
    val expr_type_of_r: res[type.TypeId, fail.Fail] = expr_type_of(?result, a.exprs[eid_sel].data.sel.place);
    if (sel expr_type_of_r.err) { ret 99; }
    val place_ty: type.TypeId = expr_type_of_r.ok;
    if (type.aggregate_nominal(?s.types, place_ty) != tag_ty) { ret 11; }
    val owner: opt[*type.Type] = type.get(?s.types, tag_ty);
    if (sel owner.none) { ret 12; }
    if (owner.some.data.nominal.owner.file != fid) { ret 12; }
    ret 0;
}

# a malformed buffer analyzed at PHASE_SEMA is rejected (never internal), reports at least one
# located diagnostic in the file, and a well-formed function (before the break, since an
# unclosed brace legitimately absorbs everything after it) still yields typed editor data
fun t_recovery(src: str, survivor: str) i32 {
    var alloc: A.Allocator;
    val t_session_r: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel t_session_r.err) { ret 99; }
    var s: session.Session = t_session_r.ok;
    fin { session.dnit(?s); }
    var es: EditorSession = init(?s);
    fin { t_dnit(?es); }
    val open_r: res[source.FileId, fail.Fail] = open(?es, "recover.mach", src);
    if (sel open_r.err) { ret 99; }
    val fid: source.FileId = open_r.ok;
    var req: AnalysisRequest = analysis_request(fid, PHASE_SEMA);
    val analyzed: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel analyzed.err) { ret 1; }
    var result: AnalysisResult = analyzed.ok;
    fin { analysis_dnit(?result); }
    if (!sel result.status.kind.rejected) { ret 2; }
    var located: bool = false;
    var i: usize = 0;
    for (i < diagnostic.len(result.diagnostics)) {
        val d: *diagnostic.Diagnostic = ?result.diagnostics.items.data[i];
        # anchored in this file: an end-of-buffer diagnostic legitimately has zero length
        if (d.loc.file_id == fid) { located = true; }
        i = i + 1;
    }
    if (!located) { ret 3; }
    if (str_len(survivor) == 0) { ret 0; }
    val ast_of_r: res[*ast.Ast, fail.Fail] = ast_of(?result);
    if (sel ast_of_r.err) { ret 99; }
    val a: *ast.Ast = ast_of_r.ok;
    val eid: id.ExprId = t_expr_at(a, src, survivor, 4);
    if (eid == id.EXPR_NIL) { ret 4; }
    val ty: res[type.TypeId, fail.Fail] = expr_type_of(?result, eid);
    if (sel ty.err) { ret 5; }
    val prim_r: opt[type.TypeId] = type.prim(?s.types, type.TYPE_I64);
    if (sel prim_r.none) { ret 5; }
    if (ty.ok != prim_r.some) { ret 5; }
    ret 0;
}

test "mach.lang.editor.recovery:unterminated_tag_body_reports_and_keeps_the_rest_of_the_buffer" {
    val alone: i32 = t_recovery("tag Reply: u8 {", "");
    if (alone != 0) { ret alone; }
    # a declaration keyword ends the unterminated body, so the following function survives
    val one_case: i32 = t_recovery("tag Reply: u8 { empty;\nfun ok() i64 { ret 7; }\n", "ret 7");
    if (one_case != 0) { ret 10 + one_case; }
    ret 0;
}

test "mach.lang.editor.recovery:case_literal_missing_brace_reports_and_keeps_the_rest_of_the_buffer" {
    ret t_recovery("fun ok() i64 { ret 7; }\ntag Reply: u8 { empty; value: i64; }\nfun f() Reply { ret Reply.value{42; }\n", "ret 7");
}

test "mach.lang.editor.recovery:sel_without_a_place_reports_and_keeps_the_rest_of_the_buffer" {
    val bare: i32 = t_recovery("tag Reply: u8 { empty; value: i64; }\nfun f(r: Reply) i64 { if (sel) { ret 1; } ret 0; }\nfun ok() i64 { ret 7; }\n", "ret 7");
    if (bare != 0) { ret bare; }
    val dangling: i32 = t_recovery("tag Reply: u8 { empty; value: i64; }\nfun f(r: Reply) i64 { if (sel r.) { ret 1; } ret 0; }\nfun ok() i64 { ret 7; }\n", "ret 7");
    if (dangling != 0) { ret 10 + dangling; }
    ret 0;
}

test "mach.lang.editor.recovery:unbalanced_guard_block_reports_and_keeps_the_rest_of_the_buffer" {
    ret t_recovery("fun ok() i64 { ret 7; }\ntag Reply: u8 { empty; value: i64; }\nfun f(r: Reply) i64 { if (sel r.value) { ret r.value;\n", "ret 7");
}

fun t_open_scaffolded(es: *EditorSession, alloc: *A.Allocator, root: str, name: str, text: str) res[source.FileId, fail.Fail] {
    val path_r: res[str, string.StrError] = str_join(alloc, root, "/src/", name);
    if (sel path_r.err) { ret res[source.FileId, fail.Fail].err{fail.str_refused(path_r.err)}; }
    ret open(es, path_r.ok, text);
}

test "mach.lang.editor.deprecation:external_use_warns_in_the_analysis_snapshot_and_the_declaring_buffer_is_silent" {
    var alloc: A.Allocator;
    val t_session_r: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel t_session_r.err) { ret 99; }
    var s: session.Session = t_session_r.ok;
    fin { session.dnit(?s); }
    var es: EditorSession = init(?s);
    fin { t_dnit(?es); }
    var names: [2]str = [2]str{"main.mach", "api.mach"};
    var texts: [2]str;
    texts[0] = "use edbuild.api;\nfun main() i32 { var r: api.Reply = api.Reply.value{1}; if (sel r.value) { ret api.old() + r.value::i32; } ret 0; }\n";
    texts[1] = "#[deprecated(\"use fresh\")]\npub fun old() i32 { ret 0; }\npub tag Reply: u8 { empty; #[deprecated(\"case gone\")] value: i64; }\nfun own() i32 { var r: Reply = Reply.value{1}; if (sel r.value) { ret old() + r.value::i32; } ret 0; }\n";
    val t_scaffold_r: res[str, fail.Fail] = t_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel t_scaffold_r.err) { ret 99; }
    val root: str = t_scaffold_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val t_open_scaffolded_r: res[source.FileId, fail.Fail] = t_open_scaffolded(?es, ?alloc, root, "main.mach", texts[0]);
    if (sel t_open_scaffolded_r.err) { ret 99; }
    val main_fid: source.FileId = t_open_scaffolded_r.ok;
    val t_open_scaffolded_r2: res[source.FileId, fail.Fail] = t_open_scaffolded(?es, ?alloc, root, "api.mach", texts[1]);
    if (sel t_open_scaffolded_r2.err) { ret 99; }
    val api_fid: source.FileId = t_open_scaffolded_r2.ok;
    var req: AnalysisRequest = analysis_request(main_fid, PHASE_SEMA);
    val analyze_r: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
    if (sel analyze_r.err) { ret 99; }
    var main_result: AnalysisResult = analyze_r.ok;
    fin { analysis_dnit(?main_result); }
    if (!sel main_result.status.kind.accepted) { ret 1; }
    if (!diag_has(main_result.diagnostics, "`old` is deprecated: use fresh")) { ret 2; }
    if (!diag_has(main_result.diagnostics, "tag case `value` is deprecated: case gone")) { ret 3; }
    var api_req: AnalysisRequest = analysis_request(api_fid, PHASE_SEMA);
    val analyze_r2: res[AnalysisResult, outcome.Fail] = analyze(?es, ?api_req);
    if (sel analyze_r2.err) { ret 99; }
    var api_result: AnalysisResult = analyze_r2.ok;
    fin { analysis_dnit(?api_result); }
    if (!sel api_result.status.kind.accepted) { ret 4; }
    var i: usize = 0;
    for (i < diagnostic.len(api_result.diagnostics)) {
        val d: *diagnostic.Diagnostic = ?api_result.diagnostics.items.data[i];
        if (d.loc.file_id == api_fid && str_contains(d.message, "is deprecated")) { ret 5; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.editor.tag:dependency_case_list_edit_and_revert_replay_without_stale_cases" {
    var alloc: A.Allocator;
    val t_session_r: res[session.Session, fail.Fail] = t_session(?alloc);
    if (sel t_session_r.err) { ret 99; }
    var s: session.Session = t_session_r.ok;
    fin { session.dnit(?s); }
    var es: EditorSession = init(?s);
    fin { t_dnit(?es); }
    var names: [2]str = [2]str{"main.mach", "api.mach"};
    var texts: [2]str;
    texts[0] = "use edbuild.api;\nvar g: api.T;\nfun main() i32 { g = api.T.b{4}; if (sel g.b) { ret g.b::i32; } ret 0; }\n";
    texts[1] = "pub tag T: u8 { a; b: i64; }\n";
    val t_scaffold_r: res[str, fail.Fail] = t_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel t_scaffold_r.err) { ret 99; }
    val root: str = t_scaffold_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val t_open_scaffolded_r: res[source.FileId, fail.Fail] = t_open_scaffolded(?es, ?alloc, root, "main.mach", texts[0]);
    if (sel t_open_scaffolded_r.err) { ret 99; }
    val main_fid: source.FileId = t_open_scaffolded_r.ok;
    val t_open_scaffolded_r2: res[source.FileId, fail.Fail] = t_open_scaffolded(?es, ?alloc, root, "api.mach", texts[1]);
    if (sel t_open_scaffolded_r2.err) { ret 99; }
    val api_fid: source.FileId = t_open_scaffolded_r2.ok;
    var req: AnalysisRequest = analysis_request(main_fid, PHASE_SEMA);
    var counts: [3]u32;
    var widths: [3]u32;
    var turn: u32 = 0;
    for (turn < 3) {
        if (turn == 1) {
            val update_r: res[bool, fail.Fail] = update(?es, api_fid, "pub tag T: u16 { a; b: i64; c; }\n");
            if (sel update_r.err) { ret 99; }
            if (!update_r.ok) { ret 1; }
        }
        if (turn == 2) {
            val update_r2: res[bool, fail.Fail] = update(?es, api_fid, texts[1]);
            if (sel update_r2.err) { ret 99; }
            if (!update_r2.ok) { ret 2; }
        }
        val analyzed: res[AnalysisResult, outcome.Fail] = analyze(?es, ?req);
        if (sel analyzed.err) { ret 3; }
        var result: AnalysisResult = analyzed.ok;
        fin { analysis_dnit(?result); }
        if (!sel result.status.kind.accepted) { ret 4; }
        val sema_of_r: res[*context.SemaResult, fail.Fail] = sema_of(?result);
        if (sel sema_of_r.err) { ret 99; }
        val sr: *context.SemaResult = sema_of_r.ok;
        if (sr.decl_count < 2) { ret 5; }
        val tag_ty: type.TypeId = sr.decl_type[1];
        if (!type.is_tag(?s.types, tag_ty)) { ret 6; }
        counts[turn] = type.field_count(?s.types, tag_ty);
        widths[turn] = type.tag_discriminator_bytes(?s.types, tag_ty);
        turn = turn + 1;
    }
    if (counts[0] != 2 || counts[1] != 3 || counts[2] != 2) { ret 7; }
    if (widths[0] != 1 || widths[1] != 2 || widths[2] != 1) { ret 8; }
    ret 0;
}
