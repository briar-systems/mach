    ret t_roundtrip("fun f(){(callback)(x);factory()();vector.push[u8](?out, 1);}",
        "fun f() {\n    (callback)(x);\n    factory()();\n    vector.push[u8](?out, 1);\n}\n");
}

test "mach.lang.format:a_trailing_comma_keeps_the_closing_delimiter_on_its_own_line" {
    ret t_roundtrip("pub fun spawn(\n  f: fun(*u8), arg: *u8,\n      name: *u8,\n) i64 {\n  ret call(f,\n    arg, name,\n  );\n}\n",
        "pub fun spawn(\n    f: fun(*u8), arg: *u8,\n    name: *u8,\n) i64 {\n    ret call(f,\n        arg, name,\n    );\n}\n");
}

test "mach.lang.format:a_single_statement_body_written_inline_stays_inline_and_every_other_body_expands" {
    ret t_roundtrip("fun f(x: i32) i32 {\n    if (x) { ret 1; }\n    for (x < 1) { x = x + 1; }\n    fin { g(); }\n    if (x) { a = 1; b = 2; }\n    if (x) { if (y) { ret 2; } }\n    if (x) {\n        ret 3; }\n    if (x) {}\n    ret 0;\n}\nrec R { a: i32; }\nrec S {\n    a: i32; }\nfun g() { ret; }\ntest \"t\" { ret 0; }\n",
        "fun f(x: i32) i32 {\n    if (x) { ret 1; }\n    for (x < 1) { x = x + 1; }\n    fin { g(); }\n    if (x) {\n        a = 1;\n        b = 2;\n    }\n    if (x) {\n        if (y) { ret 2; }\n    }\n    if (x) {\n        ret 3;\n    }\n    if (x) {}\n    ret 0;\n}\n\nrec R { a: i32; }\n\nrec S {\n    a: i32;\n}\n\nfun g() {\n    ret;\n}\n\ntest \"t\" {\n    ret 0;\n}\n");
}

test "mach.lang.format:or_starts_its_own_line_in_expanded_and_inline_chains" {
    ret t_roundtrip("fun f() {\n    if (a) {\n        x = 1; y = 2;\n    } or (b) { z = 1; w = 2; } or {\n        q = 1;\n    }\n    if (a) { x = 1; } or (bb) { y = 2; } or { z = 3; }\n    $if (a) { x = 1; } $or { y = 2; }\n}\n",
        "fun f() {\n    if (a) {\n        x = 1;\n        y = 2;\n    }\n    or (b) {\n        z = 1;\n        w = 2;\n    }\n    or {\n        q = 1;\n    }\n    if (a)  { x = 1; }\n    or (bb) { y = 2; }\n    or      { z = 3; }\n    $if (a) { x = 1; }\n    $or     { y = 2; }\n}\n");
}

test "mach.lang.format:alignment_runs_end_at_a_blank_line_a_comment_a_shape_change_and_an_indentation_change" {
    ret t_roundtrip("val A: i32 = 1;\npub val LONGER: u64 = 2;\n\nval B: i32 = 3;\n# a comment ends a run\nval CC: i32 = 4;\ndef T: u32;\nval D: i32 = 5;\nfun f() {\n    x = 1;\n    frame.place = 2;\n    if (a) { y = 1; }\n    frame.prev = 3;\n    if (a) {\n        inner = 1;\n        inner_long = 2;\n    }\n    val r: R = R{\n        bam: 4,\n        kapow: g(),\n    };\n    var p: P;\n}\n",
        "val     A:      i32 = 1;\npub val LONGER: u64 = 2;\n\nval B: i32 = 3;\n# a comment ends a run\nval CC: i32 = 4;\ndef T: u32;\nval D: i32 = 5;\n\nfun f() {\n    x           = 1;\n    frame.place = 2;\n    if (a) { y = 1; }\n    frame.prev = 3;\n    if (a) {\n        inner      = 1;\n        inner_long = 2;\n    }\n    val r: R = R{\n        bam:   4,\n        kapow: g(),\n    };\n    var p: P;\n}\n");
}

test "mach.lang.format:every_line_shape_aligns_its_columns_within_its_run" {
    ret t_roundtrip("use cdur: std.chrono.duration;\nuse A: std.allocator;\nuse std.types.bool.bool;\nfwd io_runtime: std.io.runtime;\nfwd fs: std.filesystem;\npub def MY_VAL: foobar.Wow;\ndef test: u32;\npub tag res[T, E]: u8 { err: E; ok: T; }\npub tag opt[T]: u8 { none; some: T; }\nrec Pair { a: i32; b: i32; }\npub rec Allocator {\n    ctx: ptr;\n    fn_allocate: fun(ptr, usize, usize) opt[ptr];\n    data: uni { a: A; b: B; };\n}\npub tag Fail: u8 {\n    reported;\n    user: str;\n    other: i32;\n}\n",
        "use A:    std.allocator;\nuse cdur: std.chrono.duration;\nuse std.types.bool.bool;\nfwd io_runtime: std.io.runtime;\nfwd fs:         std.filesystem;\npub def MY_VAL: foobar.Wow;\ndef     test:   u32;\npub tag res[T, E]: u8 { err: E; ok: T; }\npub tag opt[T]:    u8 { none; some: T; }\nrec     Pair          { a: i32; b: i32; }\n\npub rec Allocator {\n    ctx:         ptr;\n    fn_allocate: fun(ptr, usize, usize) opt[ptr];\n    data:        uni { a: A; b: B; };\n}\n\npub tag Fail: u8 {\n    reported;\n    user:  str;\n    other: i32;\n}\n");
}

test "mach.lang.format:doc_comment_descriptions_align_with_their_continuations_and_other_comments_are_verbatim" {
    ret t_roundtrip("# the allocator interface\n# ---\n# ctx:   opaque context\n# fn_allocate: allocate (ctx, size, align) -> some(ptr), or none when refused.\n#     continued here\n# release: the backend reported\n# see https://example.org/x\n# ret: the result\nfun f() {\n    # a: one\n    # bb: two\n\n    # ccc: three\n    ret;\n}\n",
        "# the allocator interface\n# ---\n# ctx:         opaque context\n# fn_allocate: allocate (ctx, size, align) -> some(ptr), or none when refused.\n#              continued here\n# release:     the backend reported\n# see https://example.org/x\n# ret: the result\nfun f() {\n    # a:  one\n    # bb: two\n\n    # ccc: three\n    ret;\n}\n");
}

