use std.collections.vector.Vector;
use sort: std.collections.sort;
use arena: std.allocator.arena;
use page: std.allocator.page;
use print: std.print;
use fs: std.filesystem;
use io_error: std.io.error;
use path: std.types.path;
use std.types.string.str_ends_with;
use std.types.string.str_copy_slice;
use std.types.string.StrError;

use A: std.allocator;
use T: std.allocator.testing;

use mach.lang.diagnostic;
use mach.lang.fail;
use mach.lang.source;
use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.expr;
use mach.lang.fe.ast.stmt;
use atype: mach.lang.fe.ast.type;
use mach.lang.fe.ast.id;
use mach.lang.fe.lexer;
use mach.lang.fe.parser;
use mach.lang.fe.parser.state;
use mach.lang.fe.token;

# the formatter renders one canonical layout from the token stream and the
# parsed tree of a source file. layout is decided by the tokens and the tree,
# with four author choices consulted: a blank line where one is emitted anyway,
# a line break inside an expression, a line break after a literal's `{`, and a
# single-statement body written on one line. comments and inline assembly
# bodies are carried verbatim as atoms of their own; a doc comment of the
# `# name: description` form has its description column aligned. the rendered
# lines are then aligned in runs, `use` blocks are sorted, and a `use` alias
# that repeats the last path segment is dropped

# an atom kind for a comment, distinct from every token kind
val COMMENT: token.Kind = 250;
# an atom kind for an inline assembly body, `{` through `}`, carried verbatim
val RAW_ASM: token.Kind = 251;

# no space after this atom (a prefix operator, a pointer or secret type marker)
val TIGHT_AFTER:  u16 = 1;
# no space before this atom (a literal's `{`, an array type's element)
val TIGHT_BEFORE: u16 = 2;
# a space before this atom even where a `[` would otherwise be joined (an array type)
val SPACE_BEFORE: u16 = 4;
# the first atom of a declaration, its doc comment when it has one
val DECLARATION:  u16 = 8;
# the declaration has a body: a function, record, union, tag, test or comptime branch
val BLOCK:        u16 = 16;
# the `{` of a struct, array or vector literal
val LITERAL:      u16 = 32;
# the `{` opens a multi-line group; set while rendering
val EXPANDED:     u16 = 64;
# the `{` of a function or test body; never inline
val DECL_BODY:    u16 = 128;
# the `{` of a record, union or tag body, or an inline record type; inline when the author wrote it so
val TYPE_BODY:    u16 = 256;
# the `{` and `}` of a body kept on one line; set while rendering
val INLINE:       u16 = 512;
# a redundant `use` alias and its `:`; never emitted
val SKIP:         u16 = 1024;
# the atom that starts the first, second or third aligned column of its line's shape
val COL_0:        u16 = 2048;
val COL_1:        u16 = 4096;
val COL_2:        u16 = 8192;

# the shape of a line, decided by its first atom; lines of one shape at one
# indentation form an alignment run
val SHAPE_NONE:     u8 = 0;
# `use alias: path;` (the alias column, the path column)
val SHAPE_USE:      u8 = 1;
# `fwd alias: path;` (the alias column, the path column)
val SHAPE_FWD:      u8 = 2;
# `[pub] def NAME: Type;` (the name column, the type column)
val SHAPE_DEF:      u8 = 3;
# `[pub] val|var NAME: Type [= init];` (the name column, the type column, the `=` column)
val SHAPE_BIND:     u8 = 4;
# a record or union field, or a tag case with a payload: `name: Type;` (the type column)
val SHAPE_FIELD:    u8 = 5;
# an assignment statement `place = value;` (the `=` column)
val SHAPE_ASSIGN:   u8 = 6;
# a named entry of an expanded literal, `name: value,` (the value column)
val SHAPE_ENTRY:    u8 = 7;
# an `if`, `or`, `$if` or `$or` arm whose body is inline (the `{` column)
val SHAPE_ARM:      u8 = 8;
# a doc comment `# name: description` (the description column)
val SHAPE_DOC:      u8 = 9;
# a continuation of a doc comment, `#` and indented text, aligned to the description column
val SHAPE_DOC_CONT: u8 = 10;
# a record, union or tag declaration on one line (the name column, a tag's discriminator column, the `{` column)
val SHAPE_TYPE:     u8 = 11;

val NO_ATOM: usize = ~(0::usize);

rec Atom {
    span:     token.Span;
    kind:     token.Kind;
    flags:    u16;
    shape:    u8;
    pair:     usize;
    # newlines in the source between the previous atom and this one, capped at 2
    lines:    u8;
    # a comment that shares its line with the code before it
    trailing: bool;
}

rec Parsed {
    stream: lexer.TokenStream;
    tree:   ast.Ast;
}

fun parsed_dnit(a: *A.Allocator, p: *Parsed) {
    ast.dnit(?p.tree);
    lexer.dnit(?p.stream, a);
}

# lex and parse `text`; a lexical or syntactic rejection is recorded on `diags`
# and reported, so the caller has the located diagnostics and no output
fun parse_text(a: *A.Allocator, text: str, file_id: source.FileId, diags: *diagnostic.DiagnosticStore) res[Parsed, fail.Fail] {
    val lexed: res[lexer.TokenStream, fail.Fail] = lexer.tokenize(text, a, file_id);
    if (sel lexed.err) { ret res[Parsed, fail.Fail].err{lexed.err}; }
    var p: Parsed;
    p.stream = lexed.ok;
    val emitted: err[fail.Fail] = lexer.emit_diagnostics(?p.stream, diags);
    if (sel emitted.err) { lexer.dnit(?p.stream, a); ret res[Parsed, fail.Fail].err{emitted.err}; }
    if (p.stream.error_len != 0) { lexer.dnit(?p.stream, a); ret res[Parsed, fail.Fail].err{fail.reported()}; }
    p.tree = ast.init(a, file_id);
    val checked: res[fail.PhaseStatus, state.ParseFail] = parser.parse(?p.stream, ?p.tree, diags);
    if (sel checked.err) {
        val failure: fail.Fail = state.failure(checked.err);
        parsed_dnit(a, ?p);
        ret res[Parsed, fail.Fail].err{failure};
    }
    if (!fail.is_accepted(checked.ok)) {
        val failure: fail.Fail = fail.phase_failure(checked.ok);
        parsed_dnit(a, ?p);
        ret res[Parsed, fail.Fail].err{failure};
    }
    ret res[Parsed, fail.Fail].ok{p};
}

# format one source file. success transfers one nul-terminated string to the
# caller's allocator. a file that does not parse is rejected through `diags`
# with a reported failure and produces no output; the output is verified to
# mean what the input means before it is returned, so a formatter defect
# surfaces as an internal failure and never as a rewritten file
pub fun format_source(a: *A.Allocator, text: str, file_id: source.FileId, diags: *diagnostic.DiagnosticStore) res[str, fail.Fail] {
    if (a == nil || text == nil || diags == nil) {
        ret res[str, fail.Fail].err{fail.message("formatter requires an allocator, source, and diagnostic store")};
    }
    val parsed: res[Parsed, fail.Fail] = parse_text(a, text, file_id, diags);
    if (sel parsed.err) { ret res[str, fail.Fail].err{parsed.err}; }
    var p: Parsed = parsed.ok;
    fin { parsed_dnit(a, ?p); }
    val rendered: res[str, fail.Fail] = format_parsed(a, ?p.stream, ?p.tree);
    if (sel rendered.err) { ret rendered; }
    val output: str = rendered.ok;
    val kept: res[bool, fail.Fail] = same_meaning(a, text, output);
    if (sel kept.err) { str_free(a, output); ret res[str, fail.Fail].err{kept.err}; }
    if (!kept.ok) {
        str_free(a, output);
        ret res[str, fail.Fail].err{fail.message("formatter output does not mean what its input means; nothing written")};
    }
    ret res[str, fail.Fail].ok{output};
}

fun span_compare(a: *token.Span, b: *token.Span) i64 {
    if (a.offset < b.offset) { ret -1; }
    if (a.offset > b.offset) { ret 1; }
    ret 0;
}

# the index of the first token at or after `offset`
fun token_at(stream: *lexer.TokenStream, offset: usize) usize {
    var lo: usize = 0;
    var hi: usize = stream.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (stream.tokens[mid].span.offset < offset) { lo = mid + 1; }
        or { hi = mid; }
    }
    ret lo;
}

# the verbatim regions: each inline assembly body from its `{` through its `}`.
# the lexer read the body as ordinary source, so a `#` immediate opens a
# comment that may run past the closing brace and a quote may open a string
# that does; the region grows to cover whatever the lexer swallowed
fun raw_regions(stream: *lexer.TokenStream, tree: *ast.Ast, spans: *Vector[token.Span]) err[fail.Fail] {
    var i: usize = 0;
    for (i < tree.stmt_len) {
        val node: *stmt.Stmt = ?tree.stmts[i];
        if (node.kind == stmt.STMT_KIND_ASM && node.data.asm_.body.offset != 0) {
            val body: token.Span = node.data.asm_.body;
            val span: token.Span = token.Span{offset: body.offset - 1, len: body.len + 2};
            val pushed: res[usize, A.Error] = vector.push[token.Span](spans, span);
            if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        }
        i = i + 1;
    }
    sort.sort[token.Span](spans.data, spans.len, span_compare);
    var comment: usize = 0;
    i = 0;
    for (i < spans.len) {
        val span: *token.Span = ?spans.data[i];
        val close: usize = span.offset + span.len - 1;
        for (comment < stream.comment_len && stream.comments[comment].span.offset + stream.comments[comment].span.len <= close) {
            comment = comment + 1;
        }
        if (comment < stream.comment_len && stream.comments[comment].span.offset <= close) {
            var end: usize = close + 1;
            for (stream.source[end] != 0 && stream.source[end] != '\n' && stream.source[end] != '\r') { end = end + 1; }
            span.len = end - span.offset;
        }
        val after: usize = token_at(stream, close + 1);
        if (after > 0) {
            val covered: token.Span = stream.tokens[after - 1].span;
            if (covered.offset + covered.len > span.offset + span.len) { span.len = covered.offset + covered.len - span.offset; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun line_start(text: str, offset: usize) bool {
    var i: usize = offset;
    for (i > 0) {
        i = i - 1;
        if (text[i] == '\n' || text[i] == '\r') { ret true; }
        if (text[i] != ' ' && text[i] != '\t') { ret false; }
    }
    ret true;
}

fun gap_lines(text: str, start: usize, end: usize) u8 {
    var lines: u8 = 0;
    var i: usize = start;
    for (i < end) {
        if (text[i] == '\r' || text[i] == '\n') {
            lines = lines + 1;
            if (lines == 2) { ret 2; }
            if (text[i] == '\r' && i + 1 < end && text[i + 1] == '\n') { i = i + 1; }
        }
        i = i + 1;
    }
    ret lines;
}

fun append_atom(atoms: *Vector[Atom], text: str, span: token.Span, kind: token.Kind) err[fail.Fail] {
    var previous: usize = 0;
    if (atoms.len != 0) { previous = atoms.data[atoms.len - 1].span.offset + atoms.data[atoms.len - 1].span.len; }
    val atom: Atom = Atom{span: span, kind: kind, flags: 0, shape: SHAPE_NONE, pair: NO_ATOM,
        lines: gap_lines(text, previous, span.offset), trailing: kind == COMMENT && !line_start(text, span.offset)};
    val pushed: res[usize, A.Error] = vector.push[Atom](atoms, atom);
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# the comments between two tokens; trailing whitespace inside a comment is dropped
fun trivia(atoms: *Vector[Atom], text: str, start: usize, end: usize) err[fail.Fail] {
    var i: usize = start;
    for (i < end) {
        val byte: u8 = text[i];
        if (byte == ' ' || byte == '\t' || byte == '\r' || byte == '\n') { i = i + 1; cnt; }
        if (byte != '#') { ret err[fail.Fail].err{fail.message("formatter encountered source outside a parsed token or assembly body")}; }
        val begin: usize = i;
        for (i < end && text[i] != '\r' && text[i] != '\n') { i = i + 1; }
        var stop: usize = i;
        for (stop > begin + 1 && (text[stop - 1] == ' ' || text[stop - 1] == '\t')) { stop = stop - 1; }
        val added: err[fail.Fail] = append_atom(atoms, text, token.Span{offset: begin, len: stop - begin}, COMMENT);
        if (sel added.err) { ret added; }
    }
    ret err[fail.Fail].ok{};
}

fun collect_atoms(a: *A.Allocator, stream: *lexer.TokenStream, tree: *ast.Ast, atoms: *Vector[Atom]) err[fail.Fail] {
    var raw: Vector[token.Span] = vector.init[token.Span](a);
    fin { vector.dnit[token.Span](?raw); }
    val regions: err[fail.Fail] = raw_regions(stream, tree, ?raw);
    if (sel regions.err) { ret regions; }
    var region: usize = 0;
    var ti: usize = 0;
    var position: usize = 0;
    for (ti < stream.len) {
        val tok: token.Token = stream.tokens[ti];
        val gap: err[fail.Fail] = trivia(atoms, stream.source, position, tok.span.offset);
        if (sel gap.err) { ret gap; }
        if (tok.kind == token.KIND_EOF) { brk; }
        if (region < raw.len && raw.data[region].offset == tok.span.offset) {
            val span: token.Span = raw.data[region];
            val added: err[fail.Fail] = append_atom(atoms, stream.source, span, RAW_ASM);
            if (sel added.err) { ret added; }
            position = span.offset + span.len;
            for (ti < stream.len && stream.tokens[ti].span.offset < position) { ti = ti + 1; }
            region = region + 1;
        }
        or {
            val added: err[fail.Fail] = append_atom(atoms, stream.source, tok.span, tok.kind);
            if (sel added.err) { ret added; }
            position = tok.span.offset + tok.span.len;
            ti = ti + 1;
        }
    }
    ret err[fail.Fail].ok{};
}

# the index of the first atom at or after `offset`
fun atom_at(atoms: *Vector[Atom], offset: usize) usize {
    var lo: usize = 0;
    var hi: usize = atoms.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (atoms.data[mid].span.offset < offset) { lo = mid + 1; }
        or { hi = mid; }
    }
    ret lo;
}

fun find_atom(atoms: *Vector[Atom], offset: usize) usize {
    val lo: usize = atom_at(atoms, offset);
    if (lo < atoms.len && atoms.data[lo].span.offset == offset) { ret lo; }
    ret NO_ATOM;
}

fun mark(atoms: *Vector[Atom], offset: usize, flags: u16) {
    val index: usize = find_atom(atoms, offset);
    if (index != NO_ATOM) { atoms.data[index].flags = atoms.data[index].flags | flags; }
}

fun opener(kind: token.Kind) bool {
    ret kind == token.KIND_LPAREN || kind == token.KIND_LBRACKET || kind == token.KIND_ATTR_OPEN || kind == token.KIND_LBRACE;
}

fun closer(kind: token.Kind) bool {
    ret kind == token.KIND_RPAREN || kind == token.KIND_RBRACKET || kind == token.KIND_RBRACE;
}

fun pair_delimiters(a: *A.Allocator, atoms: *Vector[Atom]) err[fail.Fail] {
    var stack: Vector[usize] = vector.init[usize](a);
    fin { vector.dnit[usize](?stack); }
    var i: usize = 0;
    for (i < atoms.len) {
        val kind: token.Kind = atoms.data[i].kind;
        if (opener(kind)) {
            val pushed: res[usize, A.Error] = vector.push[usize](?stack, i);
            if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        }
        or (closer(kind)) {
            if (stack.len == 0) { ret err[fail.Fail].err{fail.message("formatter parsed delimiters are unbalanced")}; }
            stack.len = stack.len - 1;
            val open: usize = stack.data[stack.len];
            atoms.data[open].pair = i;
            atoms.data[i].pair = open;
        }
        i = i + 1;
    }
    if (stack.len != 0) { ret err[fail.Fail].err{fail.message("formatter parsed delimiters are unbalanced")}; }
    ret err[fail.Fail].ok{};
}

# the `{` paired with the `}` that ends the span, or NO_ATOM
fun body_of(atoms: *Vector[Atom], span: token.Span) usize {
    if (span.len == 0) { ret NO_ATOM; }
    val close: usize = find_atom(atoms, span.offset + span.len - 1);
    if (close == NO_ATOM || atoms.data[close].kind != token.KIND_RBRACE) { ret NO_ATOM; }
    ret atoms.data[close].pair;
}

# the first atom of a declaration's own line: past its decorators, each of which ends a line
fun decl_start(atoms: *Vector[Atom], offset: usize) usize {
    var i: usize = find_atom(atoms, offset);
    for (i != NO_ATOM && i < atoms.len && atoms.data[i].kind == token.KIND_ATTR_OPEN && atoms.data[i].pair != NO_ATOM) {
        i = atoms.data[i].pair + 1;
    }
    if (i != NO_ATOM && i >= atoms.len) { ret NO_ATOM; }
    ret i;
}

fun set_shape(atoms: *Vector[Atom], index: usize, shape: u8) {
    if (index != NO_ATOM) { atoms.data[index].shape = shape; }
}

fun set_flags(atoms: *Vector[Atom], index: usize, flags: u16) {
    if (index != NO_ATOM) { atoms.data[index].flags = atoms.data[index].flags | flags; }
}

# the `=` that follows `offset`, or NO_ATOM
fun eq_after(atoms: *Vector[Atom], offset: usize) usize {
    val i: usize = atom_at(atoms, offset);
    if (i < atoms.len && atoms.data[i].kind == token.KIND_EQ) { ret i; }
    ret NO_ATOM;
}

fun type_start(atoms: *Vector[Atom], tree: *ast.Ast, ty: id.TypeId) usize {
    if (ty == id.TYPE_NIL) { ret NO_ATOM; }
    val t: opt[*atype.Type] = ast.get_type(tree, ty);
    if (!sel t.some) { ret NO_ATOM; }
    ret find_atom(atoms, t.some.span.offset);
}

fun type_end(tree: *ast.Ast, ty: id.TypeId) usize {
    val t: opt[*atype.Type] = ast.get_type(tree, ty);
    if (!sel t.some) { ret 0; }
    ret t.some.span.offset + t.some.span.len;
}

# the byte length of the last dotted segment of `path`
fun last_segment_len(text: str, path: token.Span) usize {
    var i: usize = path.offset + path.len;
    for (i > path.offset && text[i - 1] != '.') { i = i - 1; }
    ret path.offset + path.len - i;
}

# a `use` alias that repeats the last segment of its path binds the same name
# the path alone would; the alias is redundant
fun redundant_alias(text: str, alias: token.Span, path: token.Span) bool {
    if (alias.len == 0 || path.len == 0) { ret false; }
    val tail: usize = last_segment_len(text, path);
    if (tail != alias.len) { ret false; }
    var i: usize = 0;
    for (i < tail) {
        if (text[alias.offset + i] != text[path.offset + path.len - tail + i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the atoms of a body, `{` through `}`, sit on one source line and hold no
# comment, decorator, assembly body or nested block; `semis` counts its `;`
fun one_line_body(atoms: *Vector[Atom], open: usize, semis: *usize) bool {
    val brace: *Atom = ?atoms.data[open];
    if (brace.pair == NO_ATOM || brace.pair == open + 1) { ret false; }
    @semis = 0;
    var k: usize = open + 1;
    for (k <= brace.pair) {
        val at: *Atom = ?atoms.data[k];
        if (at.lines != 0) { ret false; }
        if (at.kind == COMMENT || at.kind == RAW_ASM || at.kind == token.KIND_ATTR_OPEN) { ret false; }
        if (at.kind == token.KIND_LBRACE && (at.flags & LITERAL) == 0) { ret false; }
        if (at.kind == token.KIND_SEMI) { @semis = @semis + 1; }
        k = k + 1;
    }
    ret true;
}

# a statement body the author wrote on one line that holds exactly one
# statement stays on one line
fun inline_body(atoms: *Vector[Atom], open: usize) bool {
    if ((atoms.data[open].flags & (LITERAL | DECL_BODY | TYPE_BODY)) != 0) { ret false; }
    var semis: usize = 0;
    ret one_line_body(atoms, open, ?semis) && semis == 1;
}

# a record, union or tag body the author wrote on one line stays on one line
fun inline_type_body(atoms: *Vector[Atom], open: usize) bool {
    var semis: usize = 0;
    ret one_line_body(atoms, open, ?semis);
}

# the tree's contribution: which tokens are prefix operators, type markers,
# literal braces, declaration starts and bodies, and the shapes and aligned
# columns of statement lines. everything else is decided by kind
fun mark_syntax(text: str, atoms: *Vector[Atom], tree: *ast.Ast) {
    var i: usize = 0;
    for (i < tree.expr_len) {
        val e: *expr.Expr = ?tree.exprs[i];
        if (e.kind == expr.EXPR_KIND_UNARY) { mark(atoms, e.span.offset, TIGHT_AFTER); }
        if (e.kind == expr.EXPR_KIND_STRUCT_LIT || e.kind == expr.EXPR_KIND_ARRAY_LIT || e.kind == expr.EXPR_KIND_VECTOR_LIT) {
            val open: usize = body_of(atoms, e.span);
            if (open != NO_ATOM) { atoms.data[open].flags = atoms.data[open].flags | TIGHT_BEFORE | LITERAL; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < tree.type_len) {
        val t: *atype.Type = ?tree.types[i];
        if (t.kind == atype.TYPE_KIND_PTR || t.kind == atype.TYPE_KIND_SECRET) { mark(atoms, t.span.offset, TIGHT_AFTER); }
        if (t.kind == atype.TYPE_KIND_ARRAY) {
            mark(atoms, t.span.offset, SPACE_BEFORE);
            val element: opt[*atype.Type] = ast.get_type(tree, t.data.array.element);
            if (sel element.some) { mark(atoms, element.some.span.offset, TIGHT_BEFORE); }
        }
        if (t.kind == atype.TYPE_KIND_REC || t.kind == atype.TYPE_KIND_UNI) { set_flags(atoms, body_of(atoms, t.span), TYPE_BODY); }
        i = i + 1;
    }
    i = 0;
    for (i < tree.stmt_len) {
        val s: *stmt.Stmt = ?tree.stmts[i];
        if (s.kind == stmt.STMT_KIND_EXPR) {
            val e: opt[*expr.Expr] = ast.get_expr(tree, s.data.expr.expr);
            if (sel e.some) {
                val node: *expr.Expr = e.some;
                if (node.kind == expr.EXPR_KIND_BINARY && node.data.binary.op == expr.BIN_ASSIGN) {
                    val lhs: opt[*expr.Expr] = ast.get_expr(tree, node.data.binary.lhs);
                    if (sel lhs.some) {
                        set_shape(atoms, find_atom(atoms, s.span.offset), SHAPE_ASSIGN);
                        set_flags(atoms, eq_after(atoms, lhs.some.span.offset + lhs.some.span.len), COL_0);
                    }
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < tree.field_init_len) {
        val f: *expr.FieldInit = ?tree.field_inits[i];
        if (f.form == expr.INIT_NAMED) {
            val value: opt[*expr.Expr] = ast.get_expr(tree, f.value);
            if (sel value.some) {
                set_shape(atoms, find_atom(atoms, f.name.offset), SHAPE_ENTRY);
                set_flags(atoms, find_atom(atoms, value.some.span.offset), COL_0);
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < tree.decl_len) {
        val d: *decl.Decl = ?tree.decls[i];
        val first: usize = decl_start(atoms, d.span.offset);
        var block: bool = d.kind == decl.DECL_KIND_TEST || d.kind == decl.DECL_KIND_COMPTIME_IF
            || (d.kind == decl.DECL_KIND_FUN && (d.flags & decl.DECL_FLAG_EXT) == 0);
        if (d.kind == decl.DECL_KIND_FUN && (d.flags & decl.DECL_FLAG_EXT) == 0) {
            val body: opt[*stmt.Stmt] = ast.get_stmt(tree, d.data.fun_.body);
            if (sel body.some) { set_flags(atoms, find_atom(atoms, body.some.span.offset), DECL_BODY); }
        }
        or (d.kind == decl.DECL_KIND_TEST) {
            val body: opt[*stmt.Stmt] = ast.get_stmt(tree, d.data.test_.body);
            if (sel body.some) { set_flags(atoms, find_atom(atoms, body.some.span.offset), DECL_BODY); }
        }
        or (d.kind == decl.DECL_KIND_REC || d.kind == decl.DECL_KIND_UNI || d.kind == decl.DECL_KIND_TAG) {
            val body: usize = body_of(atoms, d.span);
            set_flags(atoms, body, TYPE_BODY);
            block = body == NO_ATOM || !inline_type_body(atoms, body);
            var name: token.Span = d.data.rec_.name;
            var start: u32 = d.data.rec_.fields_start;
            var len: u32 = d.data.rec_.fields_len;
            if (d.kind == decl.DECL_KIND_UNI) { name = d.data.uni_.name; start = d.data.uni_.fields_start; len = d.data.uni_.fields_len; }
            if (d.kind == decl.DECL_KIND_TAG) { name = d.data.tag_.name; len = 0; }
            if (!block) {
                set_shape(atoms, first, SHAPE_TYPE);
                set_flags(atoms, find_atom(atoms, name.offset), COL_0);
                if (d.kind == decl.DECL_KIND_TAG) { set_flags(atoms, type_start(atoms, tree, d.data.tag_.disc), COL_1); }
                set_flags(atoms, body, COL_2);
            }
            var f: u32 = 0;
            for (f < len) {
                val field: *decl.TypedName = ?tree.typed_names[start + f];
                val ty: usize = type_start(atoms, tree, field.ty);
                if (ty != NO_ATOM) {
                    set_shape(atoms, find_atom(atoms, field.name.offset), SHAPE_FIELD);
                    set_flags(atoms, ty, COL_0);
                }
                f = f + 1;
            }
            var c: u32 = 0;
            if (d.kind != decl.DECL_KIND_TAG) { c = d.data.tag_.cases_len; }
            for (c < d.data.tag_.cases_len) {
                val case_: *decl.TagCase = ?tree.tag_cases[d.data.tag_.cases_start + c];
                val ty: usize = type_start(atoms, tree, case_.payload);
                if (ty != NO_ATOM) {
                    set_shape(atoms, find_atom(atoms, case_.name.offset), SHAPE_FIELD);
                    set_flags(atoms, ty, COL_0);
                }
                c = c + 1;
            }
        }
        or (d.kind == decl.DECL_KIND_VAL || d.kind == decl.DECL_KIND_VAR) {
            val ty: usize = type_start(atoms, tree, d.data.bind.ty);
            if (ty != NO_ATOM) {
                set_shape(atoms, first, SHAPE_BIND);
                set_flags(atoms, find_atom(atoms, d.data.bind.name.offset), COL_0);
                set_flags(atoms, ty, COL_1);
                if (d.data.bind.init != id.EXPR_NIL) { set_flags(atoms, eq_after(atoms, type_end(tree, d.data.bind.ty)), COL_2); }
            }
        }
        or (d.kind == decl.DECL_KIND_DEF) {
            val ty: usize = type_start(atoms, tree, d.data.def_.ty);
            if (ty != NO_ATOM) {
                set_shape(atoms, first, SHAPE_DEF);
                set_flags(atoms, find_atom(atoms, d.data.def_.name.offset), COL_0);
                set_flags(atoms, ty, COL_1);
            }
        }
        or (d.kind == decl.DECL_KIND_USE) {
            val u: decl.DeclUse = d.data.use_;
            if (redundant_alias(text, u.alias, u.path)) {
                val alias: usize = find_atom(atoms, u.alias.offset);
                if (alias != NO_ATOM && alias + 1 < atoms.len && atoms.data[alias + 1].kind == token.KIND_COLON) {
                    atoms.data[alias].flags = atoms.data[alias].flags | SKIP;
                    atoms.data[alias + 1].flags = atoms.data[alias + 1].flags | SKIP;
                }
            }
            or (u.alias.len != 0 && u.path.len != 0) {
                set_shape(atoms, first, SHAPE_USE);
                set_flags(atoms, find_atom(atoms, u.alias.offset), COL_0);
                set_flags(atoms, find_atom(atoms, u.path.offset), COL_1);
            }
        }
        or (d.kind == decl.DECL_KIND_FWD) {
            val f: decl.DeclFwd = d.data.fwd_;
            if (f.alias.len != 0 && f.path.len != 0) {
                set_shape(atoms, first, SHAPE_FWD);
                set_flags(atoms, find_atom(atoms, f.alias.offset), COL_0);
                set_flags(atoms, find_atom(atoms, f.path.offset), COL_1);
            }
        }
        var offset: usize = d.span.offset;
        if (d.doc.len != 0) { offset = d.doc.offset; }
        var flags: u16 = DECLARATION;
        if (block) { flags = flags | BLOCK; }
        mark(atoms, offset, flags);
        i = i + 1;
    }
}

# one `use` declaration as a unit of its block: its line, with a trailing
# comment when it has one. an item under a doc comment is pinned: it ends the
# block above it and is not sorted, so a comment never moves
rec UseItem {
    first:    usize;
    last:     usize;
    key:      *u8;
    key_len:  usize;
    position: usize;
    block:    usize;
    pinned:   bool;
}

fun item_position_compare(a: *UseItem, b: *UseItem) i64 {
    if (a.first < b.first) { ret -1; }
    if (a.first > b.first) { ret 1; }
    ret 0;
}

# by the path text in byte order, then by source position: a stable order
fun item_key_compare(a: *UseItem, b: *UseItem) i64 {
    var i: usize = 0;
    for (i < a.key_len && i < b.key_len) {
        if (a.key[i] < b.key[i]) { ret -1; }
        if (a.key[i] > b.key[i]) { ret 1; }
        i = i + 1;
    }
    if (a.key_len < b.key_len) { ret -1; }
    if (a.key_len > b.key_len) { ret 1; }
    if (a.position < b.position) { ret -1; }
    if (a.position > b.position) { ret 1; }
    ret 0;
}

# the `use` declarations of the tree in source order, grouped into blocks: a
# block is a run of `use` lines with nothing between them, no blank line and
# no comment line
fun use_items(text: str, atoms: *Vector[Atom], tree: *ast.Ast, items: *Vector[UseItem]) err[fail.Fail] {
    var i: usize = 0;
    for (i < tree.decl_len) {
        val d: *decl.Decl = ?tree.decls[i];
        if (d.kind == decl.DECL_KIND_USE && d.span.len != 0) {
            val first: usize = find_atom(atoms, d.span.offset);
            var last: usize = find_atom(atoms, d.span.offset + d.span.len - 1);
            if (first == NO_ATOM || last == NO_ATOM || last < first) { ret err[fail.Fail].err{fail.message("formatter cannot locate a use declaration in its atoms")}; }
            if (last + 1 < atoms.len && atoms.data[last + 1].kind == COMMENT && atoms.data[last + 1].trailing) { last = last + 1; }
            val u: decl.DeclUse = d.data.use_;
            val item: UseItem = UseItem{first: first, last: last, key: ?text[u.path.offset], key_len: u.path.len,
                position: 0, block: 0, pinned: d.doc.len != 0};
            val pushed: res[usize, A.Error] = vector.push[UseItem](items, item);
            if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        }
        i = i + 1;
    }
    sort.sort[UseItem](items.data, items.len, item_position_compare);
    var block: usize = 0;
    i = 0;
    for (i < items.len) {
        val item: *UseItem = ?items.data[i];
        item.position = i;
        if (i != 0) {
            val previous: *UseItem = ?items.data[i - 1];
            if (item.pinned || previous.pinned || previous.last + 1 != item.first || atoms.data[item.first].lines > 1) { block = block + 1; }
        }
        item.block = block;
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the emission order of the atoms: source order with each `use` block sorted
# by path and the redundant alias atoms left out
fun emission_order(a: *A.Allocator, atoms: *Vector[Atom], items: *Vector[UseItem], order: *Vector[usize]) err[fail.Fail] {
    val room: res[usize, A.Error] = vector.reserve[usize](order, atoms.len);
    if (sel room.err) { ret err[fail.Fail].err{fail.refused(room.err)}; }
    var i: usize = 0;
    for (i < atoms.len) { order.data[i] = i; i = i + 1; }
    order.len = atoms.len;
    var sorted: Vector[UseItem] = vector.init[UseItem](a);
    fin { vector.dnit[UseItem](?sorted); }
    var start: usize = 0;
    for (start < items.len) {
        var end: usize = start + 1;
        for (end < items.len && items.data[end].block == items.data[start].block) { end = end + 1; }
        if (end - start > 1) {
            sorted.len = 0;
            i = start;
            for (i < end) {
                val pushed: res[usize, A.Error] = vector.push[UseItem](?sorted, items.data[i]);
                if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
                i = i + 1;
            }
            sort.sort[UseItem](sorted.data, sorted.len, item_key_compare);
            val lead: u8 = atoms.data[items.data[start].first].lines;
            var at: usize = items.data[start].first;
            i = 0;
            for (i < sorted.len) {
                val item: *UseItem = ?sorted.data[i];
                var k: usize = item.first;
                for (k <= item.last) { order.data[at] = k; at = at + 1; k = k + 1; }
                atoms.data[item.first].lines = 1;
                if (i == 0) { atoms.data[item.first].lines = lead; }
                i = i + 1;
            }
        }
        start = end;
    }
    var kept: usize = 0;
    i = 0;
    for (i < order.len) {
        if ((atoms.data[order.data[i]].flags & SKIP) == 0) { order.data[kept] = order.data[i]; kept = kept + 1; }
        i = i + 1;
    }
    order.len = kept;
    ret err[fail.Fail].ok{};
}

fun word(text: str, atom: *Atom, name: str) bool {
    ret atom.kind == token.KIND_IDENT && str_region_equals(text, atom.span.offset, atom.span.len, name);
}

# atoms that never take a space before them
fun joined_before(kind: token.Kind) bool {
    ret kind == token.KIND_RPAREN || kind == token.KIND_RBRACKET || kind == token.KIND_COMMA
        || kind == token.KIND_SEMI || kind == token.KIND_DOT || kind == token.KIND_COLON
        || kind == token.KIND_COLON_COLON || kind == token.KIND_COLON_TILDE || kind == token.KIND_COLON_GT;
}

# whether a space separates two atoms that share a line
fun separated(text: str, previous: *Atom, current: *Atom) bool {
    if (current.kind == token.KIND_RBRACE) { ret (current.flags & INLINE) != 0; }
    if (joined_before(current.kind)) { ret false; }
    if (current.kind == token.KIND_DOT_DOT_DOT && (previous.kind == token.KIND_IDENT
        || previous.kind == token.KIND_RPAREN || previous.kind == token.KIND_RBRACKET)) { ret false; }
    if (previous.kind == token.KIND_LPAREN || previous.kind == token.KIND_LBRACKET || previous.kind == token.KIND_ATTR_OPEN
        || previous.kind == token.KIND_DOT || previous.kind == token.KIND_DOLLAR
        || previous.kind == token.KIND_COLON_COLON || previous.kind == token.KIND_COLON_TILDE || previous.kind == token.KIND_COLON_GT
        || (previous.flags & TIGHT_AFTER) != 0 || (current.flags & TIGHT_BEFORE) != 0) { ret false; }
    if (previous.kind == token.KIND_LBRACE && (previous.flags & LITERAL) != 0) { ret false; }
    if ((current.flags & SPACE_BEFORE) != 0) { ret true; }
    if (current.kind == token.KIND_LPAREN) {
        if (previous.kind == token.KIND_RBRACKET || previous.kind == token.KIND_RPAREN) { ret false; }
        if (previous.kind == token.KIND_IDENT) {
            ret word(text, previous, "if") || word(text, previous, "or") || word(text, previous, "for") || word(text, previous, "ret");
        }
        ret true;
    }
    if (current.kind == token.KIND_LBRACKET) { ret false; }
    ret true;
}

fun append_bytes(out: *Vector[u8], text: str, offset: usize, len: usize) err[fail.Fail] {
    val room: res[usize, A.Error] = vector.reserve[u8](out, len);
    if (sel room.err) { ret err[fail.Fail].err{fail.refused(room.err)}; }
    var i: usize = 0;
    for (i < len) { out.data[out.len + i] = text[offset + i]; i = i + 1; }
    out.len = out.len + len;
    ret err[fail.Fail].ok{};
}

fun fill(out: *Vector[u8], byte: u8, count: usize) err[fail.Fail] {
    val room: res[usize, A.Error] = vector.reserve[u8](out, count);
    if (sel room.err) { ret err[fail.Fail].err{fail.refused(room.err)}; }
    var i: usize = 0;
    for (i < count) { out.data[out.len + i] = byte; i = i + 1; }
    out.len = out.len + count;
    ret err[fail.Fail].ok{};
}

# the whitespace before an atom: `lines` newlines then the indentation, or one
# space, or nothing. nothing precedes the first atom of the file
fun whitespace(out: *Vector[u8], lines: u8, indent: usize, space: bool) err[fail.Fail] {
    if (out.len == 0) { ret err[fail.Fail].ok{}; }
    if (lines != 0) {
        val broken: err[fail.Fail] = fill(out, '\n', lines::usize);
        if (sel broken.err) { ret broken; }
        ret fill(out, ' ', indent * 4);
    }
    if (space) { ret fill(out, ' ', 1); }
    ret err[fail.Fail].ok{};
}

fun ident_byte(b: u8) bool {
    ret (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '_';
}

fun blank_byte(b: u8) bool {
    ret b == ' ' || b == '\t';
}

# the length of `# name:` when the comment has the doc form `# name: description`, else 0
fun comment_key_len(text: str, span: token.Span) usize {
    val end: usize = span.offset + span.len;
    var i: usize = span.offset;
    if (i + 2 >= end || text[i] != '#' || text[i + 1] != ' ') { ret 0; }
    i = i + 2;
    val name: usize = i;
    for (i < end && ident_byte(text[i])) { i = i + 1; }
    if (i == name || i + 1 >= end || text[i] != ':' || !blank_byte(text[i + 1])) { ret 0; }
    val key: usize = i + 1 - span.offset;
    i = i + 1;
    for (i < end && blank_byte(text[i])) { i = i + 1; }
    if (i == end) { ret 0; }
    ret key;
}

# a comment of `#`, two or more blanks, then text: the continuation of a doc description
fun comment_continues(text: str, span: token.Span) bool {
    val end: usize = span.offset + span.len;
    var i: usize = span.offset + 1;
    if (i >= end || text[span.offset] != '#') { ret false; }
    for (i < end && blank_byte(text[i])) { i = i + 1; }
    ret i >= span.offset + 3 && i < end;
}

fun skip_blanks(text: str, from: usize, end: usize) usize {
    var i: usize = from;
    for (i < end && blank_byte(text[i])) { i = i + 1; }
    ret i;
}

rec Line {
    # the offset in the output where the line's content begins, past its indentation
    text:   usize;
    indent: usize;
    # the open delimiters enclosing the line's first atom
    depth:  usize;
    shape:  u8;
    # a blank line precedes this line
    blank:  bool;
    # the output offsets where the aligned columns begin; 0 where the line has none
    col:    [3]usize;
    # the padding each column receives; decided by the alignment pass
    pad:    [3]usize;
}

rec Render {
    out:             Vector[u8];
    # atom indices of the open delimiters enclosing the cursor
    stack:           Vector[usize];
    lines:           Vector[Line];
    indent:          usize;
    # the previous atom ended its line
    pending:         bool;
    # the previous top-level declaration has a body
    previous_block:  bool;
}

fun top_is(r: *Render, atoms: *Vector[Atom], kind: token.Kind, flags: u16) bool {
    if (r.stack.len == 0) { ret false; }
    val open: *Atom = ?atoms.data[r.stack.data[r.stack.len - 1]];
    ret open.kind == kind && (open.flags & flags) == flags;
}

# the cursor sits inside an expression group: parentheses, brackets, a
# decorator, a literal kept on one line, or an inline body
fun in_expression(r: *Render, atoms: *Vector[Atom]) bool {
    if (r.stack.len == 0) { ret false; }
    ret !top_is(r, atoms, token.KIND_LBRACE, EXPANDED);
}

fun current_line(r: *Render) *Line {
    ret ?r.lines.data[r.lines.len - 1];
}

# the shape a line takes from its first atom
fun line_shape(r: *Render, text: str, atoms: *Vector[Atom], order: *Vector[usize], k: usize, lines: u8, indent: usize) u8 {
    val current: *Atom = ?atoms.data[order.data[k]];
    if (current.kind == COMMENT) {
        if (current.trailing) { ret SHAPE_NONE; }
        if (comment_key_len(text, current.span) != 0) { ret SHAPE_DOC; }
        if (comment_continues(text, current.span) && r.lines.len != 0 && lines < 2) {
            val previous: *Line = current_line(r);
            if ((previous.shape == SHAPE_DOC || previous.shape == SHAPE_DOC_CONT) && previous.indent == indent) { ret SHAPE_DOC_CONT; }
        }
        ret SHAPE_NONE;
    }
    if (word(text, current, "if") || word(text, current, "or")) { ret SHAPE_ARM; }
    if (current.kind == token.KIND_DOLLAR && k + 1 < order.len) {
        val next: *Atom = ?atoms.data[order.data[k + 1]];
        if (word(text, next, "if") || word(text, next, "or")) { ret SHAPE_ARM; }
    }
    ret current.shape;
}

# a comment with a description column: `# name:` or `#`, one space, the description
fun render_doc(r: *Render, text: str, atom: *Atom, shape: u8) err[fail.Fail] {
    var key: usize = 1;
    if (shape == SHAPE_DOC) { key = comment_key_len(text, atom.span); }
    val head: err[fail.Fail] = append_bytes(?r.out, text, atom.span.offset, key);
    if (sel head.err) { ret head; }
    val gap: err[fail.Fail] = fill(?r.out, ' ', 1);
    if (sel gap.err) { ret gap; }
    current_line(r).col[0] = r.out.len;
    val end: usize = atom.span.offset + atom.span.len;
    val body: usize = skip_blanks(text, atom.span.offset + key, end);
    ret append_bytes(?r.out, text, body, end - body);
}

fun render_atom(r: *Render, text: str, atoms: *Vector[Atom], order: *Vector[usize], k: usize) err[fail.Fail] {
    val i: usize = order.data[k];
    val current: *Atom = ?atoms.data[i];
    var lines: u8 = 0;
    if (r.pending) { lines = 1; }
    var space: bool = false;
    var joined: bool = false;
    var author_break: bool = false;
    # a `)` or `]` the author placed on its own line after a trailing comma
    var closes_list: bool = false;
    # a break between the elements of an expanded literal
    val element: bool = k != 0 && atoms.data[order.data[k - 1]].kind == token.KIND_COMMA && top_is(r, atoms, token.KIND_LBRACE, LITERAL | EXPANDED);
    if (current.kind == token.KIND_RBRACE) {
        if (current.pair == NO_ATOM) { ret err[fail.Fail].err{fail.message("formatter parsed delimiters are unbalanced")}; }
        if ((atoms.data[current.pair].flags & EXPANDED) != 0) {
            if (r.indent == 0) { ret err[fail.Fail].err{fail.message("formatter block indentation is unbalanced")}; }
            r.indent = r.indent - 1;
            lines = 1;
        }
        or { lines = 0; }
    }
    if (k != 0) {
        val previous: *Atom = ?atoms.data[order.data[k - 1]];
        space = separated(text, previous, current);
        if (previous.kind == COMMENT) { lines = 1; }
        or (current.kind == COMMENT && current.trailing) { lines = 0; space = true; }
        or (current.kind == COMMENT) { lines = 1; }
        if (previous.kind == token.KIND_RBRACE || previous.kind == RAW_ASM) {
            if (joined_before(current.kind) || token.infix_precedence(current.kind) != 0) {
                lines = 0;
                joined = true;
            }
        }
        if (lines == 0 && !joined && current.lines != 0 && current.kind != COMMENT
            && current.kind != token.KIND_LBRACE && current.kind != token.KIND_RBRACE && !joined_before(current.kind)) {
            lines = 1;
            author_break = true;
        }
        if (lines == 0 && current.lines != 0 && previous.kind == token.KIND_COMMA
            && (current.kind == token.KIND_RPAREN || current.kind == token.KIND_RBRACKET)) {
            lines = 1;
            closes_list = true;
        }
        val after_open: bool = previous.kind == token.KIND_LBRACE && (previous.flags & EXPANDED) != 0;
        if (lines == 1 && (!author_break || element) && current.lines > 1 && !after_open && current.kind != token.KIND_RBRACE) { lines = 2; }
    }
    if ((current.flags & DECLARATION) != 0 && r.indent == 0 && r.stack.len == 0) {
        val block: bool = (current.flags & BLOCK) != 0;
        if (k != 0 && (block || r.previous_block)) { lines = 2; }
        r.previous_block = block;
    }
    var continuation: bool = false;
    if (lines != 0 && !closes_list) {
        if (in_expression(r, atoms)) { continuation = true; }
        or (author_break) { continuation = !element; }
    }
    var indent: usize = r.indent;
    if (continuation) { indent = indent + 1; }
    val begins: bool = lines != 0 || r.out.len == 0;
    val gap: err[fail.Fail] = whitespace(?r.out, lines, indent, space);
    if (sel gap.err) { ret gap; }
    if (begins) {
        val shape: u8 = line_shape(r, text, atoms, order, k, lines, indent);
        val line: Line = Line{text: r.out.len, indent: indent, depth: r.stack.len, shape: shape, blank: lines == 2,
            col: [3]usize{0, 0, 0}, pad: [3]usize{0, 0, 0}};
        val pushed: res[usize, A.Error] = vector.push[Line](?r.lines, line);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    }
    val line: *Line = current_line(r);
    val here: usize = r.out.len;
    if (current.kind == COMMENT && begins && (line.shape == SHAPE_DOC || line.shape == SHAPE_DOC_CONT)) {
        val doc: err[fail.Fail] = render_doc(r, text, current, line.shape);
        if (sel doc.err) { ret doc; }
    }
    or {
        val written: err[fail.Fail] = append_bytes(?r.out, text, current.span.offset, current.span.len);
        if (sel written.err) { ret written; }
    }
    if (r.stack.len == line.depth && line.shape != SHAPE_NONE && line.shape != SHAPE_ARM
        && line.shape != SHAPE_DOC && line.shape != SHAPE_DOC_CONT) {
        if ((current.flags & COL_0) != 0 && line.col[0] == 0) { line.col[0] = here; }
        if ((current.flags & COL_1) != 0 && line.col[1] == 0) { line.col[1] = here; }
        if ((current.flags & COL_2) != 0 && line.col[2] == 0) { line.col[2] = here; }
    }
    r.pending = false;
    if (current.kind == token.KIND_LBRACE) {
        var expanded: bool = k + 1 < order.len && current.pair != order.data[k + 1];
        if (expanded && (current.flags & LITERAL) != 0) {
            val next: *Atom = ?atoms.data[order.data[k + 1]];
            expanded = next.lines != 0 || next.kind == COMMENT;
        }
        or (expanded && (current.flags & TYPE_BODY) != 0) { expanded = !inline_type_body(atoms, i); }
        or (expanded) { expanded = !inline_body(atoms, i); }
        if (!expanded && current.pair != i + 1 && (current.flags & LITERAL) == 0) {
            current.flags = current.flags | INLINE;
            atoms.data[current.pair].flags = atoms.data[current.pair].flags | INLINE;
        }
        if ((current.flags & LITERAL) == 0 && line.shape == SHAPE_ARM && r.stack.len == line.depth) {
            if (expanded) { line.shape = SHAPE_NONE; }
            or (line.col[0] == 0) { line.col[0] = here; }
        }
        if (expanded) {
            current.flags = current.flags | EXPANDED;
            r.indent = r.indent + 1;
            r.pending = true;
        }
    }
    if (current.kind == token.KIND_SEMI && !in_expression(r, atoms)) { r.pending = true; }
    if (current.kind == token.KIND_RBRACE && (atoms.data[current.pair].flags & LITERAL) == 0) { r.pending = true; }
    if (current.kind == COMMENT || current.kind == RAW_ASM) { r.pending = true; }
    if (current.kind == token.KIND_RBRACKET && current.pair != NO_ATOM && atoms.data[current.pair].kind == token.KIND_ATTR_OPEN) { r.pending = true; }
    if (opener(current.kind)) {
        val pushed: res[usize, A.Error] = vector.push[usize](?r.stack, i);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    }
    or (closer(current.kind)) {
        if (r.stack.len == 0) { ret err[fail.Fail].err{fail.message("formatter parsed delimiters are unbalanced")}; }
        r.stack.len = r.stack.len - 1;
    }
    ret err[fail.Fail].ok{};
}

# the display width of the output between two offsets: code points, not bytes
fun width(out: *Vector[u8], from: usize, to: usize) usize {
    var n: usize = 0;
    var i: usize = from;
    for (i < to) {
        if ((out.data[i] & 0xC0) != 0x80) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# the width of a line up to column `c`, with the padding of its earlier columns
fun column_width(out: *Vector[u8], line: *Line, c: usize) usize {
    var w: usize = width(out, line.text, line.col[c]);
    var e: usize = 0;
    for (e < c) { w = w + line.pad[e]; e = e + 1; }
    ret w;
}

rec Pad {
    at:    usize;
    count: usize;
}

fun push_pad(pads: *Vector[Pad], at: usize, count: usize) err[fail.Fail] {
    if (count == 0) { ret err[fail.Fail].ok{}; }
    val pushed: res[usize, A.Error] = vector.push[Pad](pads, Pad{at: at, count: count});
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

fun joins_run(run: u8, shape: u8) bool {
    ret shape == run || (run == SHAPE_DOC && shape == SHAPE_DOC_CONT);
}

# the padding that aligns each run: consecutive lines of one shape at one
# indentation with no blank line between, each column padded to the longest
# key in the run plus one space
fun alignment(r: *Render, pads: *Vector[Pad]) err[fail.Fail] {
    var i: usize = 0;
    for (i < r.lines.len) {
        val head: *Line = ?r.lines.data[i];
        if (head.shape == SHAPE_NONE || head.shape == SHAPE_DOC_CONT || head.col[0] == 0) { i = i + 1; cnt; }
        var end: usize = i + 1;
        for (end < r.lines.len) {
            val line: *Line = ?r.lines.data[end];
            if (!joins_run(head.shape, line.shape) || line.indent != head.indent || line.blank || line.col[0] == 0) { brk; }
            end = end + 1;
        }
        var c: usize = 0;
        for (c < 3) {
            var max: usize = 0;
            var j: usize = i;
            for (j < end) {
                val line: *Line = ?r.lines.data[j];
                if (line.col[c] != 0) {
                    val w: usize = column_width(?r.out, line, c);
                    if (w > max) { max = w; }
                }
                j = j + 1;
            }
            j = i;
            for (j < end) {
                val line: *Line = ?r.lines.data[j];
                if (line.col[c] != 0) { line.pad[c] = max - column_width(?r.out, line, c); }
                j = j + 1;
            }
            c = c + 1;
        }
        var j: usize = i;
        for (j < end) {
            val line: *Line = ?r.lines.data[j];
            c = 0;
            for (c < 3) {
                if (line.col[c] != 0) {
                    val pushed: err[fail.Fail] = push_pad(pads, line.col[c], line.pad[c]);
                    if (sel pushed.err) { ret pushed; }
                }
                c = c + 1;
            }
            j = j + 1;
        }
        i = end;
    }
    ret err[fail.Fail].ok{};
}

# the output with its alignment padding inserted and one final newline
fun assemble(a: *A.Allocator, r: *Render, pads: *Vector[Pad]) res[str, fail.Fail] {
    var out: Vector[u8] = vector.init[u8](a);
    fin { vector.dnit[u8](?out); }
    var from: usize = 0;
    var p: usize = 0;
    for (p < pads.len) {
        val pad: *Pad = ?pads.data[p];
        val copied: err[fail.Fail] = append_bytes(?out, r.out.data::str, from, pad.at - from);
        if (sel copied.err) { ret res[str, fail.Fail].err{copied.err}; }
        val filled: err[fail.Fail] = fill(?out, ' ', pad.count);
        if (sel filled.err) { ret res[str, fail.Fail].err{filled.err}; }
        from = pad.at;
        p = p + 1;
    }
    val rest: err[fail.Fail] = append_bytes(?out, r.out.data::str, from, r.out.len - from);
    if (sel rest.err) { ret res[str, fail.Fail].err{rest.err}; }
    if (out.len != 0) {
        val newline: err[fail.Fail] = fill(?out, '\n', 1);
        if (sel newline.err) { ret res[str, fail.Fail].err{newline.err}; }
    }
    val copied: res[str, A.Error] = str_dup_range(a, out.data::str, 0, out.len);
    if (sel copied.err) { ret res[str, fail.Fail].err{fail.refused(copied.err)}; }
    ret res[str, fail.Fail].ok{copied.ok};
}

fun render(a: *A.Allocator, text: str, atoms: *Vector[Atom], order: *Vector[usize]) res[str, fail.Fail] {
    var r: Render;
    r.out = vector.init[u8](a);
    r.stack = vector.init[usize](a);
    r.lines = vector.init[Line](a);
    r.indent = 0;
    r.pending = false;
    r.previous_block = false;
    fin { vector.dnit[u8](?r.out); vector.dnit[usize](?r.stack); vector.dnit[Line](?r.lines); }
    var k: usize = 0;
    for (k < order.len) {
        val step: err[fail.Fail] = render_atom(?r, text, atoms, order, k);
        if (sel step.err) { ret res[str, fail.Fail].err{step.err}; }
        k = k + 1;
    }
    var pads: Vector[Pad] = vector.init[Pad](a);
    fin { vector.dnit[Pad](?pads); }
    val aligned: err[fail.Fail] = alignment(?r, ?pads);
    if (sel aligned.err) { ret res[str, fail.Fail].err{aligned.err}; }
    ret assemble(a, ?r, ?pads);
}

fun format_parsed(a: *A.Allocator, stream: *lexer.TokenStream, tree: *ast.Ast) res[str, fail.Fail] {
    var atoms: Vector[Atom] = vector.init[Atom](a);
    fin { vector.dnit[Atom](?atoms); }
    val collected: err[fail.Fail] = collect_atoms(a, stream, tree, ?atoms);
    if (sel collected.err) { ret res[str, fail.Fail].err{collected.err}; }
    val paired: err[fail.Fail] = pair_delimiters(a, ?atoms);
    if (sel paired.err) { ret res[str, fail.Fail].err{paired.err}; }
    mark_syntax(stream.source, ?atoms, tree);
    var items: Vector[UseItem] = vector.init[UseItem](a);
    fin { vector.dnit[UseItem](?items); }
    val grouped: err[fail.Fail] = use_items(stream.source, ?atoms, tree, ?items);
    if (sel grouped.err) { ret res[str, fail.Fail].err{grouped.err}; }
    var order: Vector[usize] = vector.init[usize](a);
    fin { vector.dnit[usize](?order); }
    val ordered: err[fail.Fail] = emission_order(a, ?atoms, ?items, ?order);
    if (sel ordered.err) { ret res[str, fail.Fail].err{ordered.err}; }
    ret render(a, stream.source, ?atoms, ?order);
}

# the atom index a doc run ends on, or NO_ATOM without a doc
fun doc_end(atoms: *Vector[Atom], span: token.Span) usize {
    if (span.len == 0) { ret NO_ATOM; }
    var i: usize = find_atom(atoms, span.offset);
    if (i == NO_ATOM) { ret NO_ATOM; }
    var end: usize = i;
    for (i < atoms.len && atoms.data[i].span.offset < span.offset + span.len) { end = i; i = i + 1; }
    ret end;
}

fun bytes_equal(before: str, from: usize, after: str, to: usize, len: usize) bool {
    var b: usize = 0;
    for (b < len) {
        if (before[from + b] != after[to + b]) { ret false; }
        b = b + 1;
    }
    ret true;
}

# two comments carry the same text: byte for byte, except that a doc comment
# compares by its key and its description, and a continuation by its text,
# since the formatter owns the blanks between them
fun comment_equals(before: str, l: *Atom, after: str, r: *Atom) bool {
    val lk: usize = comment_key_len(before, l.span);
    val rk: usize = comment_key_len(after, r.span);
    var lb: usize = l.span.offset;
    var rb: usize = r.span.offset;
    if (lk != 0 || rk != 0) {
        if (lk != rk || !bytes_equal(before, lb, after, rb, lk)) { ret false; }
        lb = lb + lk;
        rb = rb + rk;
    }
    or (comment_continues(before, l.span) && comment_continues(after, r.span)) {
        lb = lb + 1;
        rb = rb + 1;
    }
    or {
        ret l.span.len == r.span.len && bytes_equal(before, l.span.offset, after, r.span.offset, l.span.len);
    }
    val le: usize = l.span.offset + l.span.len;
    val re: usize = r.span.offset + r.span.len;
    lb = skip_blanks(before, lb, le);
    rb = skip_blanks(after, rb, re);
    ret le - lb == re - rb && bytes_equal(before, lb, after, rb, le - lb);
}

fun atom_equals(before: str, l: *Atom, after: str, r: *Atom) bool {
    if (l.kind != r.kind) { ret false; }
    if (l.kind == COMMENT) { ret comment_equals(before, l, after, r); }
    ret l.span.len == r.span.len && bytes_equal(before, l.span.offset, after, r.span.offset, l.span.len);
}

# the same `use` item: the same atoms once redundant aliases are left out, and
# a doc comment on both or neither
fun same_item(before: str, after: str, latoms: *Vector[Atom], ratoms: *Vector[Atom], l: *UseItem, r: *UseItem) bool {
    if (l.pinned != r.pinned) { ret false; }
    var li: usize = l.first;
    var ri: usize = r.first;
    for (true) {
        for (li <= l.last && (latoms.data[li].flags & SKIP) != 0) { li = li + 1; }
        for (ri <= r.last && (ratoms.data[ri].flags & SKIP) != 0) { ri = ri + 1; }
        if (li > l.last || ri > r.last) { ret li > l.last && ri > r.last; }
        if (!atom_equals(before, ?latoms.data[li], after, ?ratoms.data[ri])) { ret false; }
        li = li + 1;
        ri = ri + 1;
    }
    ret false;
}

# two `use` blocks bind the same names to the same paths: the same items in any order
fun same_block(a: *A.Allocator, before: str, after: str, latoms: *Vector[Atom], ratoms: *Vector[Atom],
    litems: *Vector[UseItem], ritems: *Vector[UseItem], lb: usize, le: usize, rb: usize) res[bool, fail.Fail] {
    var used: Vector[bool] = vector.init[bool](a);
    fin { vector.dnit[bool](?used); }
    val room: res[usize, A.Error] = vector.reserve[bool](?used, le - lb);
    if (sel room.err) { ret res[bool, fail.Fail].err{fail.refused(room.err)}; }
    used.len = le - lb;
    var i: usize = 0;
    for (i < used.len) { used.data[i] = false; i = i + 1; }
    i = lb;
    for (i < le) {
        var found: bool = false;
        var j: usize = 0;
        for (j < used.len && !found) {
            if (!used.data[j] && same_item(before, after, latoms, ratoms, ?litems.data[i], ?ritems.data[rb + j])) {
                used.data[j] = true;
                found = true;
            }
            j = j + 1;
        }
        if (!found) { ret res[bool, fail.Fail].ok{false}; }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{true};
}

fun block_end(items: *Vector[UseItem], start: usize) usize {
    var end: usize = start + 1;
    for (end < items.len && items.data[end].block == items.data[start].block) { end = end + 1; }
    ret end;
}

# the same atoms in the same order, with each `use` block compared as a set
# of items and redundant alias atoms left out of both sides
fun same_atoms(a: *A.Allocator, before: str, after: str, latoms: *Vector[Atom], ratoms: *Vector[Atom],
    litems: *Vector[UseItem], ritems: *Vector[UseItem]) res[bool, fail.Fail] {
    var li: usize = 0;
    var ri: usize = 0;
    var lb: usize = 0;
    var rb: usize = 0;
    for (true) {
        for (li < latoms.len && (latoms.data[li].flags & SKIP) != 0) { li = li + 1; }
        for (ri < ratoms.len && (ratoms.data[ri].flags & SKIP) != 0) { ri = ri + 1; }
        if (li == latoms.len || ri == ratoms.len) { ret res[bool, fail.Fail].ok{li == latoms.len && ri == ratoms.len}; }
        val lblock: bool = lb < litems.len && litems.data[lb].first == li;
        val rblock: bool = rb < ritems.len && ritems.data[rb].first == ri;
        if (lblock != rblock) { ret res[bool, fail.Fail].ok{false}; }
        if (lblock) {
            val le: usize = block_end(litems, lb);
            val re: usize = block_end(ritems, rb);
            if (le - lb != re - rb) { ret res[bool, fail.Fail].ok{false}; }
            val same: res[bool, fail.Fail] = same_block(a, before, after, latoms, ratoms, litems, ritems, lb, le, rb);
            if (sel same.err) { ret same; }
            if (!same.ok) { ret same; }
            li = litems.data[le - 1].last + 1;
            ri = ritems.data[re - 1].last + 1;
            lb = le;
            rb = re;
            cnt;
        }
        if (!atom_equals(before, ?latoms.data[li], after, ?ratoms.data[ri])) { ret res[bool, fail.Fail].ok{false}; }
        li = li + 1;
        ri = ri + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

# the position of an atom among the atoms that are emitted, so that positions
# agree across a dropped alias
fun emitted_index(atoms: *Vector[Atom], index: usize) usize {
    if (index == NO_ATOM) { ret NO_ATOM; }
    var n: usize = 0;
    var i: usize = 0;
    for (i < index) {
        if ((atoms.data[i].flags & SKIP) == 0) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# the structural comparison of two trees: the same node kinds at the same
# indices in every pool, and every declaration carrying the same doc run. a
# `use` declaration is compared by its block instead, since its block may
# have been reordered
fun same_tree(la: *ast.Ast, ra: *ast.Ast, latoms: *Vector[Atom], ratoms: *Vector[Atom]) bool {
    if (la.decl_len != ra.decl_len || la.stmt_len != ra.stmt_len || la.expr_len != ra.expr_len
        || la.type_len != ra.type_len || la.module_len != ra.module_len) { ret false; }
    if (la.typed_name_len != ra.typed_name_len || la.tag_case_len != ra.tag_case_len
        || la.field_init_len != ra.field_init_len || la.generic_name_len != ra.generic_name_len
        || la.comptime_branch_len != ra.comptime_branch_len || la.decorator_len != ra.decorator_len) { ret false; }
    var i: usize = 0;
    for (i < la.expr_len) {
        if (la.exprs[i].kind != ra.exprs[i].kind) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < la.stmt_len) {
        if (la.stmts[i].kind != ra.stmts[i].kind) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < la.type_len) {
        if (la.types[i].kind != ra.types[i].kind) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < la.decl_len) {
        val l: *decl.Decl = ?la.decls[i];
        val r: *decl.Decl = ?ra.decls[i];
        if (l.kind != r.kind) { ret false; }
        if (l.kind == decl.DECL_KIND_USE) { i = i + 1; cnt; }
        if (l.flags != r.flags || l.decorators_len != r.decorators_len) { ret false; }
        if ((l.doc.len == 0) != (r.doc.len == 0)) { ret false; }
        if (l.doc.len != 0 && (emitted_index(latoms, find_atom(latoms, l.doc.offset)) != emitted_index(ratoms, find_atom(ratoms, r.doc.offset))
            || emitted_index(latoms, doc_end(latoms, l.doc)) != emitted_index(ratoms, doc_end(ratoms, r.doc)))) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether `after` means what `before` means: both parse, to the same atoms in
# the same order (a `use` block as a set of its lines, a redundant alias as
# no alias, a doc comment by its key and description), the same tree shape,
# and the same doc runs on the same declarations. the parser is a function
# of its tokens, so equal atoms and equal shape leave no room for a
# difference in meaning. a parse failure of either text is a difference
pub fun same_meaning(a: *A.Allocator, before: str, after: str) res[bool, fail.Fail] {
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(a);
    fin { diagnostic.store_dnit(?diags); }
    val lp: res[Parsed, fail.Fail] = parse_text(a, before, 0, ?diags);
    if (sel lp.err) {
        if (fail.is_reported(lp.err)) { ret res[bool, fail.Fail].ok{false}; }
        ret res[bool, fail.Fail].err{lp.err};
    }
    var left: Parsed = lp.ok;
    fin { parsed_dnit(a, ?left); }
    val rp: res[Parsed, fail.Fail] = parse_text(a, after, 0, ?diags);
    if (sel rp.err) {
        if (fail.is_reported(rp.err)) { ret res[bool, fail.Fail].ok{false}; }
        ret res[bool, fail.Fail].err{rp.err};
    }
    var right: Parsed = rp.ok;
    fin { parsed_dnit(a, ?right); }
    var latoms: Vector[Atom] = vector.init[Atom](a);
    var ratoms: Vector[Atom] = vector.init[Atom](a);
    fin { vector.dnit[Atom](?latoms); vector.dnit[Atom](?ratoms); }
    val lc: err[fail.Fail] = collect_atoms(a, ?left.stream, ?left.tree, ?latoms);
    if (sel lc.err) { ret res[bool, fail.Fail].err{lc.err}; }
    val rc: err[fail.Fail] = collect_atoms(a, ?right.stream, ?right.tree, ?ratoms);
    if (sel rc.err) { ret res[bool, fail.Fail].err{rc.err}; }
    val lpaired: err[fail.Fail] = pair_delimiters(a, ?latoms);
    if (sel lpaired.err) { ret res[bool, fail.Fail].err{lpaired.err}; }
    val rpaired: err[fail.Fail] = pair_delimiters(a, ?ratoms);
    if (sel rpaired.err) { ret res[bool, fail.Fail].err{rpaired.err}; }
    mark_syntax(before, ?latoms, ?left.tree);
    mark_syntax(after, ?ratoms, ?right.tree);
    var litems: Vector[UseItem] = vector.init[UseItem](a);
    var ritems: Vector[UseItem] = vector.init[UseItem](a);
    fin { vector.dnit[UseItem](?litems); vector.dnit[UseItem](?ritems); }
    val lg: err[fail.Fail] = use_items(before, ?latoms, ?left.tree, ?litems);
    if (sel lg.err) { ret res[bool, fail.Fail].err{lg.err}; }
    val rg: err[fail.Fail] = use_items(after, ?ratoms, ?right.tree, ?ritems);
    if (sel rg.err) { ret res[bool, fail.Fail].err{rg.err}; }
    val atoms_same: res[bool, fail.Fail] = same_atoms(a, before, after, ?latoms, ?ratoms, ?litems, ?ritems);
    if (sel atoms_same.err) { ret atoms_same; }
    if (!atoms_same.ok) { ret atoms_same; }
    ret res[bool, fail.Fail].ok{same_tree(?left.tree, ?right.tree, ?latoms, ?ratoms)};
}
fun t_report_failure(stage: str, error: fail.Fail, diags: *diagnostic.DiagnosticStore) {
    print.eprintlnf("formatter {} failed: {}", stage, fail.describe(error));
    var i: usize = 0;
    for (i < diagnostic.len(diags)) {
        val d: *diagnostic.Diagnostic = ?diags.items.data[i];
        print.eprintlnf("diagnostic at {}+{}: {}", d.loc.span.offset, d.loc.span.len, d.message);
        i = i + 1;
    }
}

# format `text`, require `expected` when given, then require the fixed point
# and the meaning check independently of the guard inside format_source
fun t_roundtrip(text: str, expected: str) i32 {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(?a);
    fin { diagnostic.store_dnit(?diags); }
    val first: res[str, fail.Fail] = format_source(?a, text, 0, ?diags);
    if (sel first.err) { t_report_failure("first pass", first.err, ?diags); ret 2; }
    val formatted: str = first.ok;
    fin { str_free(?a, formatted); }
    if (expected != nil && !str_equals(expected, formatted)) {
        print.eprintlnf("formatter policy mismatch\nexpected:\n{}actual:\n{}", expected, formatted);
        ret 3;
    }
    val second: res[str, fail.Fail] = format_source(?a, formatted, 0, ?diags);
    if (sel second.err) { t_report_failure("second pass", second.err, ?diags); ret 4; }
    val repeated: str = second.ok;
    fin { str_free(?a, repeated); }
    if (!str_equals(formatted, repeated)) {
        print.eprintlnf("formatter idempotence mismatch\nfirst:\n{}second:\n{}", formatted, repeated);
        ret 5;
    }
    val kept: res[bool, fail.Fail] = same_meaning(?a, text, formatted);
    if (sel kept.err) { t_report_failure("meaning check", kept.err, ?diags); ret 6; }
    if (!kept.ok) {
        print.eprintlnf("formatter changed tokens or syntax ownership\nsource:\n{}formatted:\n{}", text, formatted);
        ret 6;
    }
    ret 0;
}

test "mach.lang.format:one_policy_is_idempotent" {
    ret t_roundtrip("use a.b;use x:c.d;\n\n\nval A:i32=1;val B:i32=2;\n\nval C:i32=3;#[inline]pub fun f(x:* ^i32,y:i32)i32{val n:i32=y*2;if(n>0){ret n;}or{ret 0;}}ext fun g(x:i32)i32;def H:i32;",
        "use a.b;\nuse x: c.d;\n\nval A: i32 = 1;\nval B: i32 = 2;\n\nval C: i32 = 3;\n\n#[inline]\npub fun f(x: *^i32, y: i32) i32 {\n    val n: i32 = y * 2;\n    if (n > 0) { ret n; }\n    or         { ret 0; }\n}\n\next fun g(x: i32) i32;\ndef H: i32;\n");
}

test "mach.lang.format:retained_types_expressions_and_comptime_keep_their_tokens" {
    ret t_roundtrip("pub rec Pair[T]{a:T;b:T;} pub uni Cell{word:i64;bytes:[8]u8;} def Fn:fun(i64,...)i64; ext fun foreign(x:i64,...)i64; fun f(x: ^i64,p:*Pair[i64],va:...)i64{var a:[2]i64=[2]i64{1,2};val v:i32x4=i32x4{1,2,3,4};val r:Pair[i64]=Pair[i64]{a:a[0],b:a[1]};fin{a[0]=0;}$if($type_of(x)==i64){$error(\"unexpected public value\");}$or{$each arg in va{a[0]=arg::i64;}}for(a[0]<3){a[0]=a[0]+1;if(a[0]==2){cnt;}brk;}ret (x:>i64)+@?r.a+(v[0]::i64);}", nil);
}

test "mach.lang.format:tags_cases_projections_and_declassification_take_the_canonical_spacing" {
    ret t_roundtrip("pub tag Fail:u8{reported;#[deprecated(\"gone\")]user:str;}pub fun make(m:str,s: ^u32)res[Fail,str]{var f:Fail=Fail.user{m};if(sel f.user){ret res[Fail,str].ok{f};}val n:u32=s:>u32;$each c in $cases(Fail){if(sel f.[c]){ret res[Fail,str].err{\"x\"};}}ret res[Fail,str].err{\"none\"};}",
        "pub tag Fail: u8 {\n    reported;\n    #[deprecated(\"gone\")]\n    user: str;\n}\n\npub fun make(m: str, s: ^u32) res[Fail, str] {\n    var f: Fail = Fail.user{m};\n    if (sel f.user) { ret res[Fail, str].ok{f}; }\n    val n: u32 = s:>u32;\n    $each c in $cases(Fail) {\n        if (sel f.[c]) { ret res[Fail, str].err{\"x\"}; }\n    }\n    ret res[Fail, str].err{\"none\"};\n}\n");
}

test "mach.lang.format:literal_braces_follow_the_author_across_lines_and_blank_lines_survive_once" {
    ret t_roundtrip("val ROWS: [2]Row = [2]Row{\n  Row{ a: 1,   b: 2 },\n\n\n  Row{a:3,b:4},\n};\nfun f() {\n    val x: Row = Row{a: 1, b: g(1,\n        2)};\n\n\n    val y: i32 = 1\n        + 2;\n}\n",
        "val ROWS: [2]Row = [2]Row{\n    Row{a: 1, b: 2},\n\n    Row{a: 3, b: 4},\n};\n\nfun f() {\n    val x: Row = Row{a: 1, b: g(1,\n        2)};\n\n    val y: i32 = 1\n        + 2;\n}\n");
}

test "mach.lang.format:comments_docstrings_and_raw_assembly_keep_their_owners" {
    val comments: i32 = t_roundtrip("# banner\r\n\r\nuse a.b; # import\r\n# standalone\r\n\r\n# function summary\r\n#[inline] pub fun f() {val x:i32=1; # first\r\nval y:i32=2; # second\r\nret;} # end\r\n",
        "# banner\n\nuse a.b; # import\n# standalone\n\n# function summary\n#[inline]\npub fun f() {\n    val x: i32 = 1; # first\n    val y: i32 = 2; # second\n    ret;\n} # end\n");
    if (comments != 0) { ret comments; }
    val plain: i32 = t_roundtrip("fun f(){asm x86_64 { mov rax, 7 } val x:i32=1;ret;}",
        "fun f() {\n    asm x86_64 { mov rax, 7 }\n    val x: i32 = 1;\n    ret;\n}\n");
    if (plain != 0) { ret plain; }
    ret t_roundtrip("fun f(){asm aarch64 {\r\n\tmov x0, #5\r\n  } asm aarch64 { mov x0, #7 } # trailing raw line\r\nret;}\r\n", nil);
}

