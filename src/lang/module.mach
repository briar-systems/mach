use std.types.bool.bool;
use std.types.bool.false;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_ends_with;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;

use A: std.allocator;
use std.collections.map;

use mach.lang.fail;
use mach.lang.intern;

# a module's index in the session's module table
pub def ModuleId: u32;

pub val MODULE_NIL: ModuleId = 0xFFFFFFFF;

# a module's identity across sessions, keyed by its fully qualified name
pub def StableModuleId: u32;

pub val STABLE_MODULE_NIL: StableModuleId = 0xFFFFFFFF;

# a project numbers its modules from 0 below BUFFER_BASE, and a standalone
# editor buffer's module is BUFFER_BASE past its file's index, so no project
# module takes a buffer's id and a table keyed by module serves both
pub val BUFFER_BASE: u32 = 0x80000000;

# the module of the standalone buffer over the file with index `file`, none
# past the last id the buffer range holds
pub fun buffer_id(file: u32) opt[ModuleId] {
    if (file >= MODULE_NIL - BUFFER_BASE) { ret opt[ModuleId].none{}; }
    ret opt[ModuleId].some{id(BUFFER_BASE + file)};
}

# the index of the file whose standalone buffer is the module `m`, none when
# `m` is a project's module or nil
pub fun buffer_file(m: ModuleId) opt[u32] {
    if (m < BUFFER_BASE || is_nil(m)) { ret opt[u32].none{}; }
    ret opt[u32].some{m - BUFFER_BASE};
}

pub fun id(index: u32) ModuleId {
    var m: ModuleId;
    m = index;
    ret m;
}

pub fun index(m: ModuleId) u32 {
    ret m;
}

pub fun same(left: ModuleId, right: ModuleId) bool {
    ret left == right;
}

pub fun is_nil(m: ModuleId) bool {
    ret m == MODULE_NIL;
}

pub fun stable_id(index: u32) StableModuleId {
    var m: StableModuleId;
    m = index;
    ret m;
}

pub fun stable_index(m: StableModuleId) u32 {
    ret m;
}

pub fun stable_same(left: StableModuleId, right: StableModuleId) bool {
    ret left == right;
}

pub fun stable_is_nil(m: StableModuleId) bool {
    ret m == STABLE_MODULE_NIL;
}

# the module name of a source path under a package: the id, then the path without its suffix, its separators dotted
pub fun compose_fqn(alloc: *A.Allocator, itn: *intern.Interner, id_text: str, rel_text: str) res[intern.StrId, fail.Fail] {
    val rel_stripped: View = strip_mach_suffix(rel_text);

    val id_len: usize             = str_len(id_text);
    val total:  usize             = id_len + 1 + rel_stripped.len;
    val r_buf:  res[*u8, A.Error] = A.allocate[u8](alloc, total);
    if (sel r_buf.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r_buf.err)}; }
    val buf: *u8 = r_buf.ok;

    var k: usize = 0;
    var j: usize = 0;
    for (j < id_len) {
        buf[k] = id_text[j];
        k      = k + 1;
        j      = j + 1;
    }
    buf[k] = '.';
    k      = k + 1;
    j      = 0;
    for (j < rel_stripped.len) {
        val c: u8 = rel_stripped.data[j];
        if (c == '/' || c == '\\') { buf[k] = '.'; }
        or                         { buf[k] = c; }
        k = k + 1;
        j = j + 1;
    }

    val r: res[intern.StrId, A.Error] = intern.bytes_add(itn, buf::str, k);
    A.deallocate[u8](alloc, buf, total);
    if (sel r.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r.ok};
}

fun strip_mach_suffix(s: str) View {
    val suffix: str   = ".mach";
    val s_len:  usize = str_len(s);
    if (!str_ends_with(s, suffix)) { ret view(s::*char, s_len); }
    ret view(s::*char, s_len - str_len(suffix));
}

# the identities of the modules a session loaded: each module's name, whether it
# belongs to the root project, and the stable identity of each name, which
# outlives the loads that reuse it
# ---
# count:         one past the highest project module id held; below BUFFER_BASE, so it
#                never wraps
# fqns:          each module's fully qualified name
# root_project:  which modules belong to the root project rather than a dependency,
#                declared by the loader as it gives the module its id; a shared
#                library's export surface is drawn from these alone
# stable_ids:    the stable identity of each name
# stable_next:   the next stable identity to issue
# stable_to_mid: the module each stable identity is loaded as
pub rec Registry {
    count:         u32;
    fqns:          map.Map[ModuleId, intern.StrId];
    root_project:  map.Map[ModuleId, bool];
    stable_ids:    map.Map[intern.StrId, StableModuleId];
    stable_next:   StableModuleId;
    stable_to_mid: map.Map[StableModuleId, ModuleId];
}

pub fun registry_init(a: *A.Allocator) Registry {
    ret Registry{
        count:         0,
        fqns:          map.init[ModuleId, intern.StrId](a),
        root_project:  map.init[ModuleId, bool](a),
        stable_ids:    map.init[intern.StrId, StableModuleId](a),
        stable_next:   stable_id(0),
        stable_to_mid: map.init[StableModuleId, ModuleId](a)
    };
}

pub fun registry_dnit(r: *Registry) {
    r.count = 0;
    map.dnit[ModuleId, intern.StrId](?r.fqns);
    map.dnit[ModuleId, bool](?r.root_project);
    map.dnit[intern.StrId, StableModuleId](?r.stable_ids);
    map.dnit[StableModuleId, ModuleId](?r.stable_to_mid);
}

# forget every project module identity, keeping the stable identities, which outlive a load
pub fun reset_module_registry(r: *Registry) {
    r.count = 0;

    map.clear[ModuleId, intern.StrId](?r.fqns);
    map.clear[ModuleId, bool](?r.root_project);

    map.clear[StableModuleId, ModuleId](?r.stable_to_mid);
}

# one past the highest project module id the registry holds an identity for
pub fun module_count(r: *Registry) u32 {
    ret r.count;
}

fun register_module_fqn(r: *Registry, mid: ModuleId, fqn: intern.StrId) err[fail.Fail] {
    val insert_r: res[bool, A.Error] = map.insert[ModuleId, intern.StrId](?r.fqns, mid, fqn);
    if (sel insert_r.err) { ret err[fail.Fail].err{fail.refused(insert_r.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun register_module_root_project(r: *Registry, mid: ModuleId, root: bool) err[fail.Fail] {
    val insert_r: res[bool, A.Error] = map.insert[ModuleId, bool](?r.root_project, mid, root);
    if (sel insert_r.err) { ret err[fail.Fail].err{fail.refused(insert_r.err)}; }
    ret err[fail.Fail].ok{};
}

# a module the loader never declared is not the root project's: a dependency's
# module, or one loaded outside a project, exports nothing of its own
pub fun module_is_root_project(r: *Registry, mid: ModuleId) bool {
    if (is_nil(mid)) { ret false; }
    val res_get: opt[*bool] = map.get[ModuleId, bool](?r.root_project, ?mid);
    if (sel res_get.some) { ret @res_get.some; }
    ret false;
}

pub fun module_fqn(r: *Registry, mid: ModuleId) intern.StrId {
    if (is_nil(mid)) { ret intern.STR_NIL; }
    val res_get: opt[*intern.StrId] = map.get[ModuleId, intern.StrId](?r.fqns, ?mid);
    if (sel res_get.some) {
        ret @res_get.some;
    }
    ret intern.STR_NIL;
}

pub fun stable_module_id(r: *Registry, fqn: intern.StrId) res[StableModuleId, fail.Fail] {
    val res_get: opt[*StableModuleId] = map.get[intern.StrId, StableModuleId](?r.stable_ids, ?fqn);
    if (sel res_get.some) {
        ret res[StableModuleId, fail.Fail].ok{@res_get.some};
    }

    if (stable_is_nil(r.stable_next)) {
        ret res[StableModuleId, fail.Fail].err{fail.message("stable module identities are exhausted")};
    }
    val issued:     StableModuleId     = r.stable_next;
    val res_insert: res[bool, A.Error] = map.insert[intern.StrId, StableModuleId](?r.stable_ids, fqn, issued);
    if (sel res_insert.err) {
        ret res[StableModuleId, fail.Fail].err{fail.refused(res_insert.err)};
    }
    r.stable_next = stable_id(stable_index(r.stable_next) + 1);
    ret res[StableModuleId, fail.Fail].ok{issued};
}

pub fun stable_module_id_lookup(r: *Registry, fqn: intern.StrId) StableModuleId {
    val res_get: opt[*StableModuleId] = map.get[intern.StrId, StableModuleId](?r.stable_ids, ?fqn);
    if (sel res_get.some) {
        ret @res_get.some;
    }
    ret STABLE_MODULE_NIL;
}

pub fun register_stable_mid(r: *Registry, stable: StableModuleId, mid: ModuleId) err[fail.Fail] {
    val insert_r: res[bool, A.Error] = map.insert[StableModuleId, ModuleId](?r.stable_to_mid, stable, mid);
    if (sel insert_r.err) { ret err[fail.Fail].err{fail.refused(insert_r.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun module_id_for_stable(r: *Registry, stable: StableModuleId) ModuleId {
    if (stable_is_nil(stable)) { ret MODULE_NIL; }
    val res_get: opt[*ModuleId] = map.get[StableModuleId, ModuleId](?r.stable_to_mid, ?stable);
    if (sel res_get.some) {
        ret @res_get.some;
    }
    ret MODULE_NIL;
}

# give the module `mid` its name and stable identity; a project's module also
# counts toward module_count, a standalone buffer's does not
pub fun register_module_identity(r: *Registry, mid: ModuleId, fqn: intern.StrId, stable: StableModuleId) err[fail.Fail] {
    if (is_nil(mid)) { ret err[fail.Fail].err{fail.message("a module identity needs a module id")}; }
    var key: ModuleId       = mid;
    val rf:  err[fail.Fail] = register_module_fqn(r, mid, fqn);
    if (sel rf.err) { ret rf; }
    val rm: err[fail.Fail] = register_stable_mid(r, stable, mid);
    if (sel rm.err) {
        map.remove[ModuleId, intern.StrId](?r.fqns, ?key);
        ret rm;
    }
    val buffer: opt[u32] = buffer_file(mid);
    if (sel buffer.none && index(mid) >= r.count) { r.count = index(mid) + 1; }
    ret err[fail.Fail].ok{};
}

pub fun unregister_module_identity(r: *Registry, mid: ModuleId, stable: StableModuleId) {
    var key:  ModuleId       = mid;
    var skey: StableModuleId = stable;
    map.remove[ModuleId, intern.StrId](?r.fqns, ?key);
    map.remove[ModuleId, bool](?r.root_project, ?key);
    map.remove[StableModuleId, ModuleId](?r.stable_to_mid, ?skey);
}
