# placement: a module global `#[at(offset)]` places, as its object carries it to the link
#
# a placed global is a section of its own, named for its offset, so the link plan that
# places it reads the offset back from the object and needs no other record of it. the
# lowering writes the name and the link reads it, and nothing else spells it
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;

use mach.lang.intern;

# what every placed section's name begins with, its offset in hex following
val PREFIX: str = ".at.0x";

val DIGITS: str = "0123456789abcdef";

# the name of the section a global placed at `offset` is, held by `itn`
pub fun section_name(itn: *intern.Interner, offset: u64) opt[str] {
    var text: [22]u8;
    var n:    usize = 0;
    for (PREFIX[n] != 0) {
        text[n] = PREFIX[n];
        n       = n + 1;
    }
    var digits: [16]u8;
    var count:  usize = 0;
    var rest:   u64   = offset;
    for (count == 0 || rest != 0) {
        digits[count] = DIGITS[(rest & 0xf)::usize];
        rest          = rest >> 4;
        count         = count + 1;
    }
    for (count > 0) {
        count   = count - 1;
        text[n] = digits[count];
        n       = n + 1;
    }
    val held: res[intern.StrId, A.Error] = intern.range_add(itn, (?text[0])::str, 0, n);
    if (sel held.err) { ret opt[str].none{}; }
    ret opt[str].some{intern.text(itn, held.ok)};
}

# the offset the section named `name` places its global at, none for a section no
# `#[at]` names
pub fun offset_of(name: View) opt[u64] {
    var lead: usize = 0;
    for (PREFIX[lead] != 0) {
        if (lead >= name.len || name.data[lead] != PREFIX[lead]) { ret opt[u64].none{}; }
        lead = lead + 1;
    }
    if (name.len == lead || name.len - lead > 16) { ret opt[u64].none{}; }
    var value: u64   = 0;
    var i:     usize = lead;
    for (i < name.len) {
        val c: u8  = name.data[i];
        var d: u64 = 0;
        if (c >= '0' && c <= '9') { d = (c - '0')::u64; }
        or (c >= 'a' && c <= 'f') { d = (c - 'a')::u64 + 10; }
        or                        { ret opt[u64].none{}; }
        value = (value << 4) | d;
        i     = i + 1;
    }
    ret opt[u64].some{value};
}
