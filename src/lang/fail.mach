use std.allocator.page;
use std.format;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.text.string.str_free;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use T: std.allocator.testing;

use mach.lang.intern;

pub def Kind: u8;

pub val REPORTED: Kind = 0;
pub val MESSAGE:  Kind = 1;

pub rec Fail {
    kind:    Kind;
    message: str;
}

pub fun reported() Fail {
    var f: Fail;
    f.kind    = REPORTED;
    f.message = "";
    ret f;
}

pub fun message(text: str) Fail {
    var f: Fail;
    f.kind    = MESSAGE;
    f.message = text;
    ret f;
}

pub fun lift[T](r: R.Result[T, str]) R.Result[T, Fail] {
    if (R.is_err[T, str](r)) { ret R.err[T, Fail](message(R.unwrap_err[T, str](r))); }
    ret R.ok[T, Fail](R.unwrap_ok[T, str](r));
}

# phase status is independent of diagnostic storage and rendering.
pub def PhaseKind: u8;
pub val ACCEPTED: PhaseKind = 0;
pub val REJECTED: PhaseKind = 1;
pub val INTERNAL: PhaseKind = 2;

pub rec PhaseStatus {
    kind: PhaseKind;
    message: str;
    rejections: u64;
}

pub fun accepted() PhaseStatus {
    var s: PhaseStatus;
    s.kind = ACCEPTED;
    s.message = "";
    s.rejections = 0;
    ret s;
}

pub fun reject(s: *PhaseStatus) {
    s.rejections = s.rejections + 1;
    if (s.kind == ACCEPTED) { s.kind = REJECTED; }
}

pub fun internal(s: *PhaseStatus, text: str) {
    if (s.kind == INTERNAL) { ret; }
    s.kind = INTERNAL;
    s.message = text;
}

pub fun phase_failure(s: PhaseStatus) Fail {
    if (s.kind == REJECTED) { ret reported(); }
    if (s.kind == INTERNAL) { ret message(s.message); }
    ret message("internal: an accepted phase has no failure");
}

pub fun merge(into: *PhaseStatus, from: PhaseStatus) {
    into.rejections = into.rejections + from.rejections;
    if (from.kind == INTERNAL) { internal(into, from.message); }
    or (from.kind == REJECTED && into.kind == ACCEPTED) { into.kind = REJECTED; }
}

# closed catalogs. a dispatch over a finite catalog that reaches a member no
# arm names rejects through one of these, so one message shape names the
# catalog and the member and one class says where the fault lies: the member
# arrived from input or a cross-module product, the member is valid but the
# target or phase declares it cannot honor it, or the compiler produced a
# member its own catalog lacks. no site answers an unknown member with a
# default.
pub def CatalogClass: u8;
pub val CATALOG_MALFORMED:   CatalogClass = 0;
pub val CATALOG_UNSUPPORTED: CatalogClass = 1;
pub val CATALOG_INTERNAL:    CatalogClass = 2;

pub rec Catalog {
    class:   CatalogClass;
    catalog: str;
    member:  str;
    tag:     u32;
    where:   str;
}

# a member read from input that the catalog does not declare
pub fun malformed_member(catalog: str, tag: u32) Catalog {
    ret catalog_member(CATALOG_MALFORMED, catalog, "", tag, "");
}

# a declared member that `by` (a target, format or phase) does not honor
pub fun unsupported_member(catalog: str, member: str, by: str) Catalog {
    ret catalog_member(CATALOG_UNSUPPORTED, catalog, member, 0, by);
}

# a member the compiler produced that its own catalog does not declare
pub fun unknown_member(catalog: str, tag: u32) Catalog {
    ret catalog_member(CATALOG_INTERNAL, catalog, "", tag, "");
}

pub fun catalog_member(class: CatalogClass, catalog: str, member: str, tag: u32, where: str) Catalog {
    var c: Catalog;
    c.class   = class;
    c.catalog = catalog;
    c.member  = member;
    c.tag     = tag;
    c.where   = where;
    ret c;
}

# the message, owned by the caller's allocator; the error is the allocator's text
pub fun catalog_text(a: *A.Allocator, c: Catalog) R.Result[str, str] {
    if (c.class == CATALOG_UNSUPPORTED) {
        if (str_len(c.where) == 0) { ret format.sprint(a, "{} {} is unsupported", c.catalog, c.member); }
        ret format.sprint(a, "{} {} is unsupported by {}", c.catalog, c.member, c.where);
    }
    var lead: str = "unknown";
    if (c.class == CATALOG_MALFORMED) { lead = "malformed"; }
    if (str_len(c.where) == 0) { ret format.sprint(a, "{} {} tag {}", lead, c.catalog, c.tag); }
    ret format.sprint(a, "{} {} tag {} in {}", lead, c.catalog, c.tag, c.where);
}

# the message, owned by the interner so it outlives temporary phase storage
pub fun catalog_interned(itn: *intern.Interner, a: *A.Allocator, c: Catalog) R.Result[str, str] {
    if (itn == nil || a == nil) { ret R.err[str, str]("catalog diagnostic has no owner"); }
    val formatted: R.Result[str, str] = catalog_text(a, c);
    if (R.is_err[str, str](formatted)) { ret formatted; }
    val text: str = R.unwrap_ok[str, str](formatted);
    fin { str_free(a, text); }
    val saved: R.Result[intern.StrId, str] = intern.intern(itn, text);
    if (R.is_err[intern.StrId, str](saved)) { ret R.err[str, str](R.unwrap_err[intern.StrId, str](saved)); }
    val found: O.Option[str] = intern.lookup(itn, R.unwrap_ok[intern.StrId, str](saved));
    if (O.is_none[str](found)) { ret R.err[str, str]("catalog diagnostic is absent from its interner"); }
    ret R.ok[str, str](O.unwrap[str](found));
}

# the interned message as plain text: an allocation refusal yields its own text,
# which is still a failure message and never a valid-looking member
pub fun catalog_message(itn: *intern.Interner, a: *A.Allocator, c: Catalog) str {
    val r: R.Result[str, str] = catalog_interned(itn, a, c);
    if (R.is_err[str, str](r)) { ret R.unwrap_err[str, str](r); }
    ret R.unwrap_ok[str, str](r);
}

# the phase status a class lands on: input and capability faults are rejections
# the caller reports as a diagnostic, an internal member is an internal failure
pub fun catalog_status(s: *PhaseStatus, c: Catalog, message: str) {
    if (c.class == CATALOG_INTERNAL) { internal(s, message); ret; }
    reject(s);
}

test "mach.lang.fail.catalog:each_class_names_the_catalog_and_the_member" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    var itn: intern.Interner = intern.init(?a);
    fin { intern.dnit(?itn); }
    val internal_text: R.Result[str, str] = catalog_text(?a, unknown_member("PhaseKind", 255));
    if (R.is_err[str, str](internal_text)) { ret 2; }
    val internal_msg: str = R.unwrap_ok[str, str](internal_text);
    fin { str_free(?a, internal_msg); }
    if (!str_equals(internal_msg, "unknown PhaseKind tag 255")) { ret 3; }
    val malformed_text: R.Result[str, str] = catalog_text(?a, malformed_member("SectionKind", 9));
    if (R.is_err[str, str](malformed_text)) { ret 4; }
    val malformed_msg: str = R.unwrap_ok[str, str](malformed_text);
    fin { str_free(?a, malformed_msg); }
    if (!str_equals(malformed_msg, "malformed SectionKind tag 9")) { ret 5; }
    val unsupported_text: R.Result[str, str] = catalog_text(?a, unsupported_member("Subsystem", "gui", "x86_64-linux"));
    if (R.is_err[str, str](unsupported_text)) { ret 6; }
    val unsupported_msg: str = R.unwrap_ok[str, str](unsupported_text);
    fin { str_free(?a, unsupported_msg); }
    if (!str_equals(unsupported_msg, "Subsystem gui is unsupported by x86_64-linux")) { ret 7; }
    val located: Catalog = catalog_member(CATALOG_INTERNAL, "arm64.Opcode", "", 65530, "'probe'");
    val located_msg: str = catalog_message(?itn, ?a, located);
    if (!str_equals(located_msg, "unknown arm64.Opcode tag 65530 in 'probe'")) { ret 8; }
    if (!str_equals(catalog_message(?itn, ?a, located), located_msg)) { ret 9; }
    var status: PhaseStatus = accepted();
    catalog_status(?status, malformed_member("SectionKind", 9), malformed_msg);
    if (status.kind != REJECTED || status.rejections != 1) { ret 10; }
    catalog_status(?status, unsupported_member("Subsystem", "gui", ""), unsupported_msg);
    if (status.kind != REJECTED || status.rejections != 2) { ret 11; }
    catalog_status(?status, unknown_member("PhaseKind", 255), internal_msg);
    if (status.kind != INTERNAL || !str_equals(status.message, internal_msg) || status.rejections != 2) { ret 12; }
    ret 0;
}

fun t_catalog_attempt(ordinal: usize, attempts: *usize) i32 {
    var t: T.Testing;
    if (O.is_some[str](T.make(?t))) { ret 1; }
    fin { T.dnit(?t); }
    val a: *A.Allocator = T.allocator_of(?t);
    var itn: intern.Interner = intern.init(a);
    T.fail_at_ordinal(?t, ordinal);
    val r: R.Result[str, str] = catalog_interned(?itn, a, unknown_member("ExprKind", 200));
    @attempts = T.attempt_count(?t);
    var bad: i32 = 0;
    if (ordinal == 0 && (R.is_err[str, str](r) || !str_equals(R.unwrap_ok[str, str](r), "unknown ExprKind tag 200"))) { bad = 2; }
    if (ordinal != 0 && (R.is_ok[str, str](r) || !str_equals(R.unwrap_err[str, str](r), "out of memory"))) { bad = 3; }
    intern.dnit(?itn);
    if (T.leaked(?t) || T.double_free_count(?t) != 0 || T.tracking_exhausted(?t)) { bad = 4; }
    ret bad;
}

test "mach.lang.fail.catalog:allocation_refusal_keeps_its_owner" {
    var attempts: usize = 0;
    val baseline: i32 = t_catalog_attempt(0, ?attempts);
    if (baseline != 0 || attempts == 0) { ret 1; }
    var ordinal: usize = 1;
    for (ordinal <= attempts) {
        var refused: usize = 0;
        val code: i32 = t_catalog_attempt(ordinal, ?refused);
        if (code != 0) { ret code + 1; }
        ordinal = ordinal + 1;
    }
    ret 0;
}
