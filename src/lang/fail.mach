use std.types.string.str;
use R: std.types.result;

pub def Kind: u8;

pub val REPORTED: Kind = 0;
pub val MESSAGE:  Kind = 1;

pub rec Fail {
    kind:    Kind;
    message: str;
}

pub fun reported() Fail {
    var f: Fail;
    f.kind    = REPORTED;
    f.message = "";
    ret f;
}

pub fun message(text: str) Fail {
    var f: Fail;
    f.kind    = MESSAGE;
    f.message = text;
    ret f;
}

pub fun lift[T](r: R.Result[T, str]) R.Result[T, Fail] {
    if (R.is_err[T, str](r)) { ret R.err[T, Fail](message(R.unwrap_err[T, str](r))); }
    ret R.ok[T, Fail](R.unwrap_ok[T, str](r));
}

# phase status is independent of diagnostic storage and rendering.
pub def PhaseKind: u8;
pub val ACCEPTED: PhaseKind = 0;
pub val REJECTED: PhaseKind = 1;
pub val INTERNAL: PhaseKind = 2;

pub rec PhaseStatus {
    kind: PhaseKind;
    message: str;
    rejections: u64;
}

pub fun accepted() PhaseStatus {
    var s: PhaseStatus;
    s.kind = ACCEPTED;
    s.message = "";
    s.rejections = 0;
    ret s;
}

pub fun reject(s: *PhaseStatus) {
    s.rejections = s.rejections + 1;
    if (s.kind == ACCEPTED) { s.kind = REJECTED; }
}

pub fun internal(s: *PhaseStatus, text: str) {
    if (s.kind == INTERNAL) { ret; }
    s.kind = INTERNAL;
    s.message = text;
}

pub fun phase_failure(s: PhaseStatus) Fail {
    if (s.kind == REJECTED) { ret reported(); }
    if (s.kind == INTERNAL) { ret message(s.message); }
    ret message("internal: an accepted phase has no failure");
}

pub fun merge(into: *PhaseStatus, from: PhaseStatus) {
    into.rejections = into.rejections + from.rejections;
    if (from.kind == INTERNAL) { internal(into, from.message); }
    or (from.kind == REJECTED && into.kind == ACCEPTED) { into.kind = REJECTED; }
}
