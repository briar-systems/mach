use std.types.size.usize;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use std.text.string.str_free;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use T: std.allocator.testing;
use format: std.format;
use page: std.allocator.page;

use mach.lang.alloc;
use mach.lang.intern;

# the language layer's failure: the phase already recorded it as a diagnostic
# on the session and there is nothing further to say, or an internal failure
# whose text must be preserved. `reported` is declared first so a zero
# outcome is a failure that reports nothing new, never one that invents text.
# an allocation refusal is an internal failure; the compiler recovers from
# none of them at the site that met them
pub tag Fail: u8 {
    reported;
    message: str;
}

pub fun reported() Fail { ret Fail.reported{}; }

pub fun message(text: str) Fail { ret Fail.message{text}; }

pub fun refused(e: A.Error) Fail { ret Fail.message{alloc.text(e)}; }

# a refused literal format: the only failure it meets is the allocator's,
# any other case is an internal fault in the format string itself
pub fun format_failed(e: format.FormatError) Fail {
    if (sel e.alloc) { ret refused(e.alloc); }
    ret Fail.message{"internal: a literal format could not be rendered"};
}

pub fun is_reported(f: Fail) bool { ret sel f.reported; }
pub fun is_message(f: Fail) bool  { ret sel f.message; }

# the text a failure carries, absent for a reported one
pub fun text(f: Fail) opt[str] {
    if (sel f.message) { ret opt[str].some{f.message}; }
    ret opt[str].none{};
}

# the failure as one line of presentation text; a reported failure has no
# text of its own and is named as such, never as an empty message
pub val REPORTED_TEXT: str = "failure was reported through diagnostics";

pub fun describe(f: Fail) str {
    if (sel f.message) { ret f.message; }
    ret REPORTED_TEXT;
}

# translation shim (#3226): a legacy message result lifted into the failure
# domain. removed by C5 once no R.Result[T, str] producer remains
pub fun lift[T](r: R.Result[T, str]) R.Result[T, Fail] {
    if (R.is_err[T, str](r)) { ret R.err[T, Fail](message(R.unwrap_err[T, str](r))); }
    ret R.ok[T, Fail](R.unwrap_ok[T, str](r));
}

# phase status is independent of diagnostic storage and rendering: accepted,
# rejected through recorded diagnostics, or internally failed with the text
# of the first internal failure
pub tag PhaseKind: u8 {
    accepted;
    rejected;
    internal: str;
}

pub rec PhaseStatus {
    kind:       PhaseKind;
    rejections: u64;
}

pub fun accepted() PhaseStatus {
    var s: PhaseStatus;
    s.kind = PhaseKind.accepted{};
    s.rejections = 0;
    ret s;
}

pub fun reject(s: *PhaseStatus) {
    s.rejections = s.rejections + 1;
    val was_accepted: bool = sel s.kind.accepted;
    if (was_accepted) { s.kind = PhaseKind.rejected{}; }
}

pub fun internal(s: *PhaseStatus, text: str) {
    val already: bool = sel s.kind.internal;
    if (already) { ret; }
    s.kind = PhaseKind.internal{text};
}

pub fun is_accepted(s: PhaseStatus) bool { ret sel s.kind.accepted; }
pub fun is_rejected(s: PhaseStatus) bool { ret sel s.kind.rejected; }
pub fun is_internal(s: PhaseStatus) bool { ret sel s.kind.internal; }

# the internal failure's text, absent unless the phase failed internally
pub fun internal_text(s: PhaseStatus) opt[str] {
    if (sel s.kind.internal) { ret opt[str].some{s.kind.internal}; }
    ret opt[str].none{};
}

# the same as presentation text: a phase that did not fail internally has
# nothing to say
pub fun status_text(s: PhaseStatus) str {
    if (sel s.kind.internal) { ret s.kind.internal; }
    ret "";
}

pub fun phase_failure(s: PhaseStatus) Fail {
    if (sel s.kind.rejected) { ret reported(); }
    or (sel s.kind.internal) { ret message(s.kind.internal); }
    ret message("internal: an accepted phase has no failure");
}

pub fun merge(into: *PhaseStatus, from: PhaseStatus) {
    into.rejections = into.rejections + from.rejections;
    if (sel from.kind.internal) { internal(into, from.kind.internal); }
    or (sel from.kind.rejected) {
        val was_accepted: bool = sel into.kind.accepted;
        if (was_accepted) { into.kind = PhaseKind.rejected{}; }
    }
}

# closed catalogs. a dispatch over a finite catalog that reaches a member no
# arm names rejects through one of these, so one message shape names the
# catalog and the member and one class says where the fault lies: the member
# arrived from input or a cross-module product, the member is valid but the
# target or phase declares it cannot honor it, or the compiler produced a
# member its own catalog lacks. no site answers an unknown member with a
# default.
pub rec Member {
    catalog: str;
    tag:     u32;
    where:   str;
}

pub rec Unsupported {
    catalog: str;
    member:  str;
    by:      str;
}

pub tag Catalog: u8 {
    malformed:   Member;
    unsupported: Unsupported;
    internal:    Member;
}

# a member read from input that the catalog does not declare
pub fun malformed_member(catalog: str, tag: u32) Catalog {
    ret Catalog.malformed{Member{catalog: catalog, tag: tag, where: ""}};
}

# the same, named with where the input came from
pub fun malformed_member_in(catalog: str, tag: u32, where: str) Catalog {
    ret Catalog.malformed{Member{catalog: catalog, tag: tag, where: where}};
}

# a declared member that `by` (a target, format or phase) does not honor
pub fun unsupported_member(catalog: str, member: str, by: str) Catalog {
    ret Catalog.unsupported{Unsupported{catalog: catalog, member: member, by: by}};
}

# a member the compiler produced that its own catalog does not declare
pub fun unknown_member(catalog: str, tag: u32) Catalog {
    ret Catalog.internal{Member{catalog: catalog, tag: tag, where: ""}};
}

# the same, named with the site that produced it
pub fun unknown_member_in(catalog: str, tag: u32, where: str) Catalog {
    ret Catalog.internal{Member{catalog: catalog, tag: tag, where: where}};
}

pub fun is_internal_member(c: Catalog) bool { ret sel c.internal; }

fun member_text(a: *A.Allocator, lead: str, m: Member) res[str, format.FormatError] {
    if (str_len(m.where) == 0) { ret format.sprint(a, "{} {} tag {}", lead, m.catalog, m.tag); }
    ret format.sprint(a, "{} {} tag {} in {}", lead, m.catalog, m.tag, m.where);
}

# the message, owned by the caller's allocator (extent str_len + 1, released
# with str_free); the only failure a literal format can meet is the allocator's
pub fun catalog_text(a: *A.Allocator, c: Catalog) res[str, format.FormatError] {
    if (sel c.unsupported) {
        if (str_len(c.unsupported.by) == 0) { ret format.sprint(a, "{} {} is unsupported", c.unsupported.catalog, c.unsupported.member); }
        ret format.sprint(a, "{} {} is unsupported by {}", c.unsupported.catalog, c.unsupported.member, c.unsupported.by);
    }
    or (sel c.malformed) { ret member_text(a, "malformed", c.malformed); }
    ret member_text(a, "unknown", c.internal);
}

# the message, owned by the interner so it outlives temporary phase storage
pub fun catalog_interned(itn: *intern.Interner, a: *A.Allocator, c: Catalog) res[str, Fail] {
    if (itn == nil || a == nil) { ret res[str, Fail].err{message("catalog diagnostic has no owner")}; }
    val formatted: res[str, format.FormatError] = catalog_text(a, c);
    if (sel formatted.err) {
        if (sel formatted.err.alloc) { ret res[str, Fail].err{refused(formatted.err.alloc)}; }
        ret res[str, Fail].err{message("catalog diagnostic could not be formatted")};
    }
    val text: str = formatted.ok;
    fin { str_free(a, text); }
    val saved: R.Result[intern.StrId, str] = intern.intern(itn, text);
    if (R.is_err[intern.StrId, str](saved)) { ret res[str, Fail].err{message(R.unwrap_err[intern.StrId, str](saved))}; }
    val found: O.Option[str] = intern.lookup(itn, R.unwrap_ok[intern.StrId, str](saved));
    if (O.is_none[str](found)) { ret res[str, Fail].err{message("catalog diagnostic is absent from its interner")}; }
    ret res[str, Fail].ok{O.unwrap[str](found)};
}

# the interned message as plain text: an allocation refusal yields its own text,
# which is still a failure message and never a valid-looking member
pub fun catalog_message(itn: *intern.Interner, a: *A.Allocator, c: Catalog) str {
    val r: res[str, Fail] = catalog_interned(itn, a, c);
    if (sel r.ok) { ret r.ok; }
    if (sel r.err.message) { ret r.err.message; }
    ret "catalog diagnostic was reported";
}

# the interned message when the site owns an interner and an allocator, else
# `generic`: a static text the caller writes to still name the catalog. a
# borrowed view or a test fixture has no owner and still refuses the member
pub fun catalog_message_or(itn: *intern.Interner, a: *A.Allocator, c: Catalog, generic: str) str {
    if (itn == nil || a == nil) { ret generic; }
    ret catalog_message(itn, a, c);
}

# the phase status a class lands on: input and capability faults are rejections
# the caller reports as a diagnostic, an internal member is an internal failure
pub fun catalog_status(s: *PhaseStatus, c: Catalog, message: str) {
    if (sel c.internal) { internal(s, message); ret; }
    reject(s);
}

test "mach.lang.fail:failure_cases_and_text" {
    val r: Fail = reported();
    if (!sel r.reported) { ret 1; }
    val t: opt[str] = text(r);
    if (!sel t.none) { ret 2; }
    val m: Fail = message("lower: expression id out of range");
    if (!sel m.message) { ret 3; }
    if (!str_equals(m.message, "lower: expression id out of range")) { ret 3; }
    val mt: opt[str] = text(m);
    if (!sel mt.some) { ret 4; }
    if (!str_equals(mt.some, "lower: expression id out of range")) { ret 4; }
    val e: Fail = refused(A.Error.exhausted{});
    if (!sel e.message) { ret 5; }
    if (!str_equals(e.message, "out of memory")) { ret 5; }
    var zero: Fail;
    if (!sel zero.reported) { ret 6; }
    val lifted: R.Result[u32, Fail] = lift[u32](R.err[u32, str]("late"));
    if (!R.is_err[u32, Fail](lifted)) { ret 7; }
    val lf: Fail = R.unwrap_err[u32, Fail](lifted);
    if (!sel lf.message) { ret 8; }
    if (!str_equals(lf.message, "late")) { ret 8; }
    val kept: R.Result[u32, Fail] = lift[u32](R.ok[u32, str](7));
    if (!R.is_ok[u32, Fail](kept) || R.unwrap_ok[u32, Fail](kept) != 7) { ret 9; }
    ret 0;
}

test "mach.lang.fail:phase_status_transitions" {
    var s: PhaseStatus = accepted();
    if (!is_accepted(s) || s.rejections != 0) { ret 1; }
    reject(?s);
    reject(?s);
    if (!sel s.kind.rejected || s.rejections != 2) { ret 2; }
    val rf: Fail = phase_failure(s);
    if (!sel rf.reported) { ret 3; }
    internal(?s, "first");
    internal(?s, "second");
    if (!is_internal(s)) { ret 4; }
    val it: opt[str] = internal_text(s);
    if (!sel it.some) { ret 5; }
    if (!str_equals(it.some, "first")) { ret 5; }
    val inf: Fail = phase_failure(s);
    if (!sel inf.message) { ret 6; }
    if (!str_equals(inf.message, "first")) { ret 6; }
    var target: PhaseStatus = accepted();
    var rejected: PhaseStatus = accepted();
    reject(?rejected);
    merge(?target, rejected);
    if (!sel target.kind.rejected || target.rejections != 1) { ret 7; }
    merge(?target, s);
    if (!sel target.kind.internal || target.rejections != 3) { ret 8; }
    val none: opt[str] = internal_text(accepted());
    if (!sel none.none) { ret 9; }
    val af: Fail = phase_failure(accepted());
    if (!sel af.message) { ret 10; }
    var zero: PhaseStatus;
    if (!is_accepted(zero)) { ret 11; }
    ret 0;
}

test "mach.lang.fail.catalog:each_class_names_the_catalog_and_the_member" {
    var a: A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var itn: intern.Interner = intern.init(?a);
    fin { intern.dnit(?itn); }
    val internal_text: res[str, format.FormatError] = catalog_text(?a, unknown_member("PhaseKind", 255));
    if (sel internal_text.err) { ret 2; }
    val internal_msg: str = internal_text.ok;
    fin { str_free(?a, internal_msg); }
    if (!str_equals(internal_msg, "unknown PhaseKind tag 255")) { ret 3; }
    val malformed_text: res[str, format.FormatError] = catalog_text(?a, malformed_member("SectionKind", 9));
    if (sel malformed_text.err) { ret 4; }
    val malformed_msg: str = malformed_text.ok;
    fin { str_free(?a, malformed_msg); }
    if (!str_equals(malformed_msg, "malformed SectionKind tag 9")) { ret 5; }
    val unsupported_text: res[str, format.FormatError] = catalog_text(?a, unsupported_member("Subsystem", "gui", "x86_64-linux"));
    if (sel unsupported_text.err) { ret 6; }
    val unsupported_msg: str = unsupported_text.ok;
    fin { str_free(?a, unsupported_msg); }
    if (!str_equals(unsupported_msg, "Subsystem gui is unsupported by x86_64-linux")) { ret 7; }
    val located: Catalog = unknown_member_in("arm64.Opcode", 65530, "'probe'");
    val located_msg: str = catalog_message(?itn, ?a, located);
    if (!str_equals(located_msg, "unknown arm64.Opcode tag 65530 in 'probe'")) { ret 8; }
    if (!str_equals(catalog_message(?itn, ?a, located), located_msg)) { ret 9; }
    val placed: Catalog = malformed_member_in("SectionKind", 9, "'lib.o'");
    if (!str_equals(catalog_message(?itn, ?a, placed), "malformed SectionKind tag 9 in 'lib.o'")) { ret 10; }
    var status: PhaseStatus = accepted();
    catalog_status(?status, malformed_member("SectionKind", 9), malformed_msg);
    if (!sel status.kind.rejected || status.rejections != 1) { ret 11; }
    catalog_status(?status, unsupported_member("Subsystem", "gui", ""), unsupported_msg);
    if (!sel status.kind.rejected || status.rejections != 2) { ret 12; }
    catalog_status(?status, unknown_member("PhaseKind", 255), internal_msg);
    if (!sel status.kind.internal) { ret 13; }
    if (!str_equals(status.kind.internal, internal_msg) || status.rejections != 2) { ret 13; }
    ret 0;
}

test "mach.lang.fail.format_failed:renders_the_allocator_refusal_and_names_any_other_fault" {
    val refused_text: Fail = format_failed(format.FormatError.alloc{A.Error.exhausted{}});
    if (!sel refused_text.message) { ret 1; }
    if (!str_equals(refused_text.message, "out of memory")) { ret 1; }
    val fault: Fail = format_failed(format.FormatError.few_holes{1});
    if (!sel fault.message) { ret 2; }
    if (!str_equals(fault.message, "internal: a literal format could not be rendered")) { ret 2; }
    ret 0;
}

fun t_interned_is(r: res[str, Fail], want: str) bool {
    if (!sel r.ok) { ret false; }
    ret str_equals(r.ok, want);
}

fun t_refused_with(r: res[str, Fail], want: str) bool {
    if (!sel r.err) { ret false; }
    if (!sel r.err.message) { ret false; }
    ret str_equals(r.err.message, want);
}

fun t_catalog_attempt(ordinal: usize, attempts: *usize) i32 {
    var t: T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?t); }
    val a: *A.Allocator = T.allocator_of(?t);
    var itn: intern.Interner = intern.init(a);
    T.fail_at_ordinal(?t, ordinal);
    val r: res[str, Fail] = catalog_interned(?itn, a, unknown_member("ExprKind", 200));
    @attempts = T.attempt_count(?t);
    var bad: i32 = 0;
    if (ordinal == 0 && !t_interned_is(r, "unknown ExprKind tag 200")) { bad = 2; }
    if (ordinal != 0 && !t_refused_with(r, "out of memory")) { bad = 3; }
    intern.dnit(?itn);
    if (T.leaked(?t) || T.double_free_count(?t) != 0 || T.tracking_exhausted(?t)) { bad = 4; }
    ret bad;
}

test "mach.lang.fail.catalog:allocation_refusal_keeps_its_owner" {
    var attempts: usize = 0;
    val baseline: i32 = t_catalog_attempt(0, ?attempts);
    if (baseline != 0 || attempts == 0) { ret 1; }
    var ordinal: usize = 1;
    for (ordinal <= attempts) {
        var refused_count: usize = 0;
        val code: i32 = t_catalog_attempt(ordinal, ?refused_count);
        if (code != 0) { ret code + 1; }
        ordinal = ordinal + 1;
    }
    ret 0;
}
