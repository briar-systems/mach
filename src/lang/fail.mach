use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use std.allocator.page;
use T: std.allocator.testing;
use std.data.toml;
use fs: std.filesystem;
use std.filesystem.removal;
use std_format: std.format;
use io_error:   std.io.error;
use std.io.reader;
use io_writer: std.io.writer;
use std.process.env;
use system_os: std.system.os;

use lang_alloc:      mach.lang.alloc;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.intern;
use lang_source: mach.lang.source;

# the compiler's failure, one type for every pass, the linker, the query
# engine, the session and the build. the phase already recorded it as a
# diagnostic and there is nothing further to say; an invariant the compiler
# owns was broken, whose text must be preserved; the input was wrong or
# unsupported; or the machine refused rather than the input (a file that could
# not be read or written, a tool that could not be spawned). a user or
# environment failure names the diagnostic kind it is reported as and may
# point at a place; an internal one is always `compiler.internal`. the exit
# code derives from the case: 1 for user, 2 for internal, 3 where a command
# distinguishes the environment. `reported` is declared first so a zero
# failure is one that invents no text. an allocation refusal is internal; the
# compiler recovers from none of them at the site that met them
pub tag Fail: u8 {
    reported;
    message:     str;
    user:        Keyed;
    environment: Keyed;
}

# kind: the row of the diagnostic kind table the failure is reported as
# text: the message
# at:   where in the file that caused it the failure points, the zero place
#       when it points nowhere
# also: the other places the failure names, none when it names no other
rec Keyed {
    kind: diagnostic_kind.Kind;
    text: str;
    at:   Place;
    also: Related;
}

# the other places a failure names, in order, each in its own file: the other
# edges of a cycle, the other claims a collision is between. the array and
# each resolved place's path share the failure's lifetime as `at`'s path does
# ---
# items: the places, nil when there are none
# count: how many
pub rec Related {
    items: *Place;
    count: usize;
}

# where a failure points: a span of the file at `path`, and the line and
# column its first byte and the byte just past it fall on. a place whose span
# is known before its file is `spanned` with a nil path until `placed` names
# the file. the path shares the message's lifetime: a copy of the failure that
# outlives its message copies both
# ---
# path:    the file, nil until the place is resolved
# spanned: whether a span is known; false with a nil path is no place
# span:    the bytes the failure points at
# start:   the position of the span's first byte
# end:     the position just past the span's last byte
pub rec Place {
    path:    str;
    spanned: bool;
    span:    lang_source.Span;
    start:   lang_source.Position;
    end:     lang_source.Position;
}

pub fun reported() Fail {
    ret Fail.reported{};
}

# an internal failure: a compiler defect, reported as `compiler.internal`.
# this is the one channel for a defect: a function that meets a broken
# invariant returns it as a message failure, never as a placeholder, a default
# answer or an abort. panic is left to a function documented as total, which
# has no failure to return, when its caller breaks the precondition it states
pub fun message(text: str) Fail {
    ret Fail.message{text};
}

# the input is wrong or unsupported. a failure names a live row of the
# registry: one that names none, or a retired one, is a compiler defect and
# becomes an internal failure
pub fun user(k: diagnostic_kind.Kind, text: str) Fail {
    if (!diagnostic_kind.live(k)) { ret Fail.message{text}; }
    ret Fail.user{Keyed{kind: k, text: text}};
}

# the machine refused: a file could not be read or written, a tool could not
# be spawned
pub fun environment(k: diagnostic_kind.Kind, text: str) Fail {
    if (!diagnostic_kind.live(k)) { ret Fail.message{text}; }
    ret Fail.environment{Keyed{kind: k, text: text}};
}

# a failure the user caused met by a phase that cannot classify it (target
# selection, source loading, import libraries): an internal text becomes the
# user class under `k`, a keyed failure keeps its own class and kind, a
# reported failure stays reported
pub fun as_user(k: diagnostic_kind.Kind, f: Fail) Fail {
    if (sel f.message) { ret user(k, f.message); }
    ret f;
}

# a failure met on input the compiler produced itself (an object it wrote, a
# module it emitted): whatever the check says of the input, it is the
# compiler's defect, an internal failure keeping the text. a reported failure
# stays reported
pub fun as_internal(f: Fail) Fail {
    if (sel f.reported) { ret f; }
    ret Fail.message{describe(f)};
}

# the same failure pointing at the span `s` of the file that caused it, which
# `placed` names. a failure that already points somewhere keeps its place, the
# innermost site knowing best, and one with no kind points nowhere
pub fun spanned(f: Fail, s: lang_source.Span) Fail {
    var out: Fail = f;
    if (sel out.user) {
        if (!out.user.at.spanned) { out.user.at = span_only(s); }
    }
    or (sel out.environment) {
        if (!out.environment.at.spanned) { out.environment.at = span_only(s); }
    }
    ret out;
}

# a place whose span is known and whose file is not yet
pub fun span_only(s: lang_source.Span) Place {
    ret Place{spanned: true, span: s};
}

# the same failure with its ranges resolved in `text`, the file at `path`, as
# `located` places them: its own and each related one still without a file. a
# failure without a range, or one already resolved, is returned as it is
pub fun placed(a: *A.Allocator, f: Fail, path: str, text: str) Fail {
    ret placed_bytes(a, f, path, text::*u8, str_len(text));
}

# `placed` over the `n` bytes at `data`, for a file that may hold a NUL
pub fun placed_bytes(a: *A.Allocator, f: Fail, path: str, data: *u8, n: usize) Fail {
    val k_o: opt[Keyed] = keyed(f);
    if (sel k_o.none) { ret f; }
    val k:          Keyed = k_o.some;
    var unresolved: bool  = k.at.spanned && k.at.path == nil;
    var i:          usize = 0;
    for (i < k.also.count) {
        if (k.also.items[i].spanned && k.also.items[i].path == nil) { unresolved = true; }
        i = i + 1;
    }
    if (!unresolved) { ret f; }
    val lines_r: res[lang_source.Lines, A.Error] = lang_source.lines_init(a, data, n);
    if (sel lines_r.err) { ret refused(lines_r.err); }
    var lines: lang_source.Lines = lines_r.ok;
    fin { lang_source.lines_dnit(a, ?lines); }
    i = 0;
    for (i < k.also.count) {
        val r: *Place = ?k.also.items[i];
        if (r.spanned && r.path == nil) {
            val path_r: res[str, A.Error] = str_dup(a, path);
            if (sel path_r.err) { ret refused(path_r.err); }
            @r = place(path_r.ok, ?lines, r.span);
        }
        i = i + 1;
    }
    if (!k.at.spanned || k.at.path != nil) { ret f; }
    ret located(a, f, place(path, ?lines, k.at.span));
}

# the same failure pointing at `p`, a place a model recorded: one without a
# file is a range `placed` resolves, one with a file is copied as `located`
# copies it. a failure that already points somewhere keeps its place
pub fun at(a: *A.Allocator, f: Fail, p: Place) Fail {
    val k_o: opt[Keyed] = keyed(f);
    if (sel k_o.none)        { ret f; }
    if (k_o.some.at.spanned) { ret f; }
    if (!p.spanned)          { ret f; }
    if (p.path == nil)       { ret spanned(f, p.span); }
    ret located(a, f, p);
}

# the same failure naming the `n` places at `ps` as its related places, in
# order, each copied through `a` as `at` copies a place; an unspanned place is
# skipped. a failure that already names related places keeps them, and one
# whose copy is refused is that refusal
pub fun with_related(a: *A.Allocator, f: Fail, ps: *Place, n: usize) Fail {
    val k_o: opt[Keyed] = keyed(f);
    if (sel k_o.none)             { ret f; }
    if (k_o.some.also.count != 0) { ret f; }
    var count: usize = 0;
    var i:     usize = 0;
    for (i < n) {
        if (ps[i].spanned) { count = count + 1; }
        i = i + 1;
    }
    if (count == 0) { ret f; }
    val items_r: res[*Place, A.Error] = A.allocate[Place](a, count);
    if (sel items_r.err) { ret refused(items_r.err); }
    var also: Related = Related{items: items_r.ok, count: 0};
    i = 0;
    for (i < n) {
        if (ps[i].spanned) {
            var p: Place = ps[i];
            if (p.path != nil) {
                val path_r: res[str, A.Error] = str_dup(a, p.path);
                if (sel path_r.err) {
                    related_dnit(a, also, count);
                    ret refused(path_r.err);
                }
                p.path = path_r.ok;
            }
            also.items[also.count] = p;
            also.count             = also.count + 1;
        }
        i = i + 1;
    }
    var k: Keyed = k_o.some;
    k.also = also;
    ret rekeyed(f, k);
}

# the related places a failure names, none for one that names no other
pub fun related_of(f: Fail) Related {
    val k_o: opt[Keyed] = keyed(f);
    if (sel k_o.some) { ret k_o.some.also; }
    ret Related{items: nil, count: 0};
}

fun keyed(f: Fail) opt[Keyed] {
    if (sel f.user)        { ret opt[Keyed].some{f.user}; }
    or (sel f.environment) { ret opt[Keyed].some{f.environment}; }
    ret opt[Keyed].none{};
}

fun rekeyed(f: Fail, k: Keyed) Fail {
    if (sel f.user)        { ret Fail.user{k}; }
    or (sel f.environment) { ret Fail.environment{k}; }
    ret f;
}

# free the paths of `also`'s places and its array, allocated `cap` places long
fun related_dnit(a: *A.Allocator, also: Related, cap: usize) {
    if (also.items == nil) { ret; }
    var i: usize = 0;
    for (i < also.count) {
        if (also.items[i].path != nil) { str_free(a, also.items[i].path); }
        i = i + 1;
    }
    A.deallocate[Place](a, also.items, cap);
}

# the same failure pointing at `at`, its path copied through `a` so the failure
# owns it as it owns its text. a failure with no kind points nowhere, and one
# whose copy is refused is that refusal
pub fun located(a: *A.Allocator, f: Fail, at: Place) Fail {
    if (!sel f.user && !sel f.environment) { ret f; }
    if (at.path == nil)                    { ret f; }
    val path_r: res[str, A.Error] = str_dup(a, at.path);
    if (sel path_r.err) { ret refused(path_r.err); }
    var owned: Place = at;
    owned.path = path_r.ok;
    var out: Fail = f;
    if (sel out.user)        { out.user.at = owned; }
    or (sel out.environment) { out.environment.at = owned; }
    ret out;
}

# the span `s` of the file at `path` whose line index is `lines`, as a place;
# a span past the end is clamped to it
pub fun place(path: str, lines: *lang_source.Lines, s: lang_source.Span) Place {
    var start: usize = s.offset;
    if (start > lines.n) { start = lines.n; }
    var end: usize = lang_source.span_end(s);
    if (end > lines.n) { end = lines.n; }
    val clamped: lang_source.Span = lang_source.span_between(start, end);
    ret Place{
        path:    path,
        spanned: true,
        span:    clamped,
        start:   lang_source.lines_position(lines, clamped.offset),
        end:     lang_source.lines_position(lines, lang_source.span_end(clamped)),
    };
}

# where the failure points, when it points at a file
pub fun place_of(f: Fail) opt[Place] {
    var at: Place;
    if (sel f.user)        { at = f.user.at; }
    or (sel f.environment) { at = f.environment.at; }
    or                     { ret opt[Place].none{}; }
    if (at.path == nil)    { ret opt[Place].none{}; }
    ret opt[Place].some{at};
}

# the kind the failure is reported as, NONE for a reported one, whose
# diagnostics carry their own
pub fun kind_of(f: Fail) diagnostic_kind.Kind {
    if (sel f.user)        { ret f.user.kind; }
    or (sel f.environment) { ret f.environment.kind; }
    or (sel f.message)     { ret diagnostic_kind.COMPILER_INTERNAL; }
    ret diagnostic_kind.NONE;
}

pub fun is_reported(f: Fail) bool {
    ret sel f.reported;
}

#[testing]
pub fun is_user(f: Fail) bool {
    ret sel f.user;
}

pub fun is_message(f: Fail) bool {
    ret sel f.message;
}

# the text a failure carries, absent for a reported one
pub fun text(f: Fail) opt[str] {
    if (sel f.message)     { ret opt[str].some{f.message}; }
    or (sel f.user)        { ret opt[str].some{f.user.text}; }
    or (sel f.environment) { ret opt[str].some{f.environment.text}; }
    ret opt[str].none{};
}

# the failure as one line of presentation text; a reported failure has no
# text of its own and is named as such, never as an empty message
pub val REPORTED_TEXT: str = "failure was reported through diagnostics";

pub fun describe(f: Fail) str {
    if (sel f.message)     { ret f.message; }
    or (sel f.user)        { ret f.user.text; }
    or (sel f.environment) { ret f.environment.text; }
    ret REPORTED_TEXT;
}

# the same failure carrying `text` instead: the class, the kind and the places
# are kept (a caller that copies the message into storage it owns)
pub fun with_text(f: Fail, text: str) Fail {
    var out: Fail = f;
    if (sel out.user)        { out.user.text = text; }
    or (sel out.message)     { ret Fail.message{text}; }
    or (sel out.environment) { out.environment.text = text; }
    or                       { ret Fail.reported{}; }
    ret out;
}

# release the text a failure owns through `a`; a reported failure owns nothing
fun text_free(a: *A.Allocator, f: Fail) {
    val carried: opt[str] = text(f);
    if (sel carried.some) {
        if (carried.some != nil) { str_free(a, carried.some); }
    }
}

# a copy of the failure that owns its text and its places through `a`, for a
# failure that outlives the storage its message was made in; released with
# `dnit`
pub fun retain(a: *A.Allocator, f: Fail) res[Fail, A.Error] {
    var out:     Fail     = f;
    val carried: opt[str] = text(f);
    if (sel carried.some) {
        if (carried.some != nil) {
            val dup_r: res[str, A.Error] = str_dup(a, carried.some);
            if (sel dup_r.err) { ret res[Fail, A.Error].err{dup_r.err}; }
            out = with_text(out, dup_r.ok);
        }
    }
    val placed_r: res[Fail, A.Error] = places_retain(a, out);
    if (sel placed_r.err) { text_free(a, out); }
    ret placed_r;
}

# release what a retained failure owns through `a`: its text and its places
pub fun dnit(a: *A.Allocator, f: Fail) {
    text_free(a, f);
    places_dnit(a, f);
}

# a copy of the failure whose places, its own path and every related place,
# are owned through `a`, its text left as it is; for a holder that keeps the
# text apart. released with `places_dnit`
pub fun places_retain(a: *A.Allocator, f: Fail) res[Fail, A.Error] {
    val k_o: opt[Keyed] = keyed(f);
    if (sel k_o.none) { ret res[Fail, A.Error].ok{f}; }
    var k: Keyed = k_o.some;
    if (k.at.path != nil) {
        val path_r: res[str, A.Error] = str_dup(a, k.at.path);
        if (sel path_r.err) { ret res[Fail, A.Error].err{path_r.err}; }
        k.at.path = path_r.ok;
    }
    if (k.also.count > 0) {
        val items_r: res[*Place, A.Error] = A.allocate[Place](a, k.also.count);
        if (sel items_r.err) {
            if (k.at.path != nil) { str_free(a, k.at.path); }
            ret res[Fail, A.Error].err{items_r.err};
        }
        var also: Related = Related{items: items_r.ok, count: 0};
        var i:    usize   = 0;
        for (i < k.also.count) {
            var p: Place = k.also.items[i];
            if (p.path != nil) {
                val path_r: res[str, A.Error] = str_dup(a, p.path);
                if (sel path_r.err) {
                    related_dnit(a, also, k.also.count);
                    if (k.at.path != nil) { str_free(a, k.at.path); }
                    ret res[Fail, A.Error].err{path_r.err};
                }
                p.path = path_r.ok;
            }
            also.items[i] = p;
            also.count    = i + 1;
            i             = i + 1;
        }
        k.also = also;
    }
    ret res[Fail, A.Error].ok{rekeyed(f, k)};
}

# release the places a failure owns through `a`, as `places_retain` made them
pub fun places_dnit(a: *A.Allocator, f: Fail) {
    val k_o: opt[Keyed] = keyed(f);
    if (sel k_o.none)            { ret; }
    if (k_o.some.at.path != nil) { str_free(a, k_o.some.at.path); }
    related_dnit(a, k_o.some.also, k_o.some.also.count);
}

# the same failure pointing nowhere and naming no related place, for a holder
# whose places were released or never copied
pub fun without_places(f: Fail) Fail {
    val k_o: opt[Keyed] = keyed(f);
    if (sel k_o.none) { ret f; }
    var k: Keyed = k_o.some;
    k.at   = Place{};
    k.also = Related{items: nil, count: 0};
    ret rekeyed(f, k);
}

# whether two failures hold the same places: the same path storage and the
# same related array, as a holder that copied them once sees its own copy
pub fun same_places(x: Fail, y: Fail) bool {
    val kx: opt[Keyed] = keyed(x);
    val ky: opt[Keyed] = keyed(y);
    if (sel kx.none) { ret sel ky.none; }
    if (sel ky.none) { ret false; }
    ret kx.some.at.path == ky.some.at.path && kx.some.also.items == ky.some.also.items;
}

# the unit outcome of an operation whose value is not needed
pub fun unit[V](r: res[V, Fail]) err[Fail] {
    if (sel r.err) { ret err[Fail].err{r.err}; }
    ret err[Fail].ok{};
}

# the text each std refusal renders as, one copy each. an operation that meets
# one keeps its own classification (user, internal, environment) and names the
# cause once through these; the allocator's is `alloc.text`
pub fun io_text(e: io_error.Error) str {
    ret system_os.message(e);
}

fun read_text(e: reader.ReadError) str {
    if (sel e.eof)         { ret "unexpected end of input"; }
    or (sel e.would_block) { ret "read would block"; }
    or (sel e.native)      { ret system_os.message(e.native.error); }
    ret lang_alloc.text(e.alloc);
}

pub fun write_text(e: io_writer.WriteError) str {
    if (sel e.stalled)     { ret "short write"; }
    or (sel e.would_block) { ret "write would block"; }
    ret system_os.message(e.native.error);
}

pub fun fs_text(e: fs.FsError) str {
    if (sel e.io)        { ret system_os.message(e.io); }
    or (sel e.alloc)     { ret lang_alloc.text(e.alloc); }
    or (sel e.read)      { ret read_text(e.read); }
    or (sel e.write)     { ret write_text(e.write); }
    or (sel e.removal)   { ret removal.message(e.removal); }
    or (sel e.exhausted) { ret "temp file: max attempts exceeded"; }
    ret system_os.message(e.published);
}

pub fun str_text(e: StrError) str {
    if (sel e.alloc) { ret lang_alloc.text(e.alloc); }
    ret "string slice out of bounds";
}

pub fun format_text(e: std_format.FormatError) str {
    if (sel e.syntax)     { ret "format: malformed format string"; }
    or (sel e.few_holes)  { ret "format: too few arguments"; }
    or (sel e.many_holes) { ret "format: too many arguments"; }
    or (sel e.write)      { ret write_text(e.write); }
    ret lang_alloc.text(e.alloc);
}

pub fun toml_text(e: toml.TomlError) str {
    if (sel e.syntax)   { ret "toml: syntax error"; }
    or (sel e.overflow) { ret "toml: integer overflow"; }
    or (sel e.depth)    { ret "toml: nesting too deep"; }
    or (sel e.conflict) { ret "toml: key conflicts with an existing value"; }
    ret lang_alloc.text(e.alloc);
}

pub fun env_text(e: env.EnvError) str {
    if (sel e.native) { ret system_os.error_message(e.native); }
    or (sel e.alloc)  { ret lang_alloc.text(e.alloc); }
    ret "environment changed during the read";
}

# `fmt` formatted with `va` into `a`, which owns the text; a refusal to format
# is the failure instead
pub fun format(a: *A.Allocator, fmt: str, va: ...) res[str, Fail] {
    val r: res[str, std_format.FormatError] = std_format.sprint(a, fmt, va...);
    if (sel r.err) { ret res[str, Fail].err{format_refused(r.err)}; }
    ret res[str, Fail].ok{r.ok};
}

# an internal failure whose text is `fmt` formatted with `va` into `a`, which
# owns the text; a refusal to format is the failure instead
pub fun formatted(a: *A.Allocator, fmt: str, va: ...) Fail {
    ret message_of(format(a, fmt, va...));
}

# a user failure under `k` whose text is `fmt` formatted with `va` into `a`,
# which owns the text; a refusal to format is the failure instead
pub fun formatted_user(a: *A.Allocator, k: diagnostic_kind.Kind, fmt: str, va: ...) Fail {
    ret user_of(k, format(a, fmt, va...));
}

# the internal failure carrying a made text, or the failure that refused to
# make it
pub fun message_of(made: res[str, Fail]) Fail {
    if (sel made.err) { ret made.err; }
    ret message(made.ok);
}

# the user failure under `k` carrying a made text, or the failure that refused
# to make it
pub fun user_of(k: diagnostic_kind.Kind, made: res[str, Fail]) Fail {
    if (sel made.err) { ret made.err; }
    ret user(k, made.ok);
}

# the interner's copy of a borrowed `text`, which outlives the storage `text`
# came from
pub fun text_retain(itn: *intern.Interner, text: str) res[str, Fail] {
    val saved: res[intern.StrId, A.Error] = intern.add(itn, text);
    if (sel saved.err) { ret res[str, Fail].err{refused(saved.err)}; }
    val found: opt[str] = intern.get(itn, saved.ok);
    if (sel found.none) { ret res[str, Fail].err{message("an interned text is absent from its interner")}; }
    ret res[str, Fail].ok{found.some};
}

# `text`, owned by `a`, moved into the interner: the interned copy outlives
# `a`'s storage, and `text` is released either way
pub fun text_intern(itn: *intern.Interner, a: *A.Allocator, text: str) res[str, Fail] {
    val kept: res[str, Fail] = text_retain(itn, text);
    str_free(a, text);
    ret kept;
}

# `fmt` formatted with `va` through `a` as scratch and interned, so the text
# outlives `a`'s storage
pub fun format_intern(itn: *intern.Interner, a: *A.Allocator, fmt: str, va: ...) res[str, Fail] {
    val r: res[str, std_format.FormatError] = std_format.sprint(a, fmt, va...);
    if (sel r.err) { ret res[str, Fail].err{format_refused(r.err)}; }
    ret text_intern(itn, a, r.ok);
}

# the refusals the compiler recovers from at no site, each an internal failure
# carrying its text: the allocator's, a write to a sink of its own, a string
# operation, a filesystem step and a format
pub fun refused(e: A.Error) Fail {
    ret Fail.message{lang_alloc.text(e)};
}

pub fun write_refused(e: io_writer.WriteError) Fail {
    ret Fail.message{write_text(e)};
}

pub fun str_refused(e: StrError) Fail {
    ret Fail.message{str_text(e)};
}

pub fun fs_refused(e: fs.FsError) Fail {
    ret Fail.message{fs_text(e)};
}

pub fun format_refused(e: std_format.FormatError) Fail {
    ret Fail.message{format_text(e)};
}

pub fun source_refused(e: lang_source.Error) Fail {
    ret Fail.message{lang_source.text(e)};
}

# a filesystem operation on a file the build was handed (an object, an
# archive, a library) that the machine refused: the environment's under `k`,
# save an allocation refusal, which stays internal
pub fun fs_environment(k: diagnostic_kind.Kind, e: fs.FsError) Fail {
    if (sel e.alloc) { ret refused(e.alloc); }
    ret environment(k, fs_text(e));
}

# a document that does not parse is the user's, pointing at the byte the parser
# refused; one the allocator refused is internal
pub fun toml_refused(e: toml.TomlError) Fail {
    if (sel e.alloc) { ret refused(e.alloc); }
    var at: usize = 0;
    if (sel e.syntax)   { at = e.syntax; }
    or (sel e.overflow) { at = e.overflow; }
    or (sel e.depth)    { at = e.depth; }
    or (sel e.conflict) { at = e.conflict; }
    ret spanned(user(diagnostic_kind.TOML_MALFORMED, toml_text(e)), lang_source.span(at, 0));
}

# phase status is independent of diagnostic storage and rendering: accepted,
# rejected through recorded diagnostics, or internally failed with the text
# of the first internal failure
pub tag PhaseKind: u8 {
    accepted;
    rejected;
    internal: str;
}

pub rec PhaseStatus {
    kind:       PhaseKind;
    rejections: u64;
}

pub fun accepted() PhaseStatus {
    var s: PhaseStatus;
    s.kind       = PhaseKind.accepted{};
    s.rejections = 0;
    ret s;
}

pub fun reject(s: *PhaseStatus) {
    s.rejections = s.rejections + 1;
    val was_accepted: bool = sel s.kind.accepted;
    if (was_accepted) { s.kind = PhaseKind.rejected{}; }
}

pub fun internal(s: *PhaseStatus, text: str) {
    val already: bool = sel s.kind.internal;
    if (already) { ret; }
    s.kind = PhaseKind.internal{text};
}

pub fun is_accepted(s: PhaseStatus) bool {
    ret sel s.kind.accepted;
}

#[testing]
pub fun is_rejected(s: PhaseStatus) bool {
    ret sel s.kind.rejected;
}

#[testing]
pub fun is_internal(s: PhaseStatus) bool {
    ret sel s.kind.internal;
}

# the internal failure's text, absent unless the phase failed internally
pub fun internal_text(s: PhaseStatus) opt[str] {
    if (sel s.kind.internal) { ret opt[str].some{s.kind.internal}; }
    ret opt[str].none{};
}

# the same as presentation text: a phase that did not fail internally has
# nothing to say
pub fun status_text(s: PhaseStatus) str {
    if (sel s.kind.internal) { ret s.kind.internal; }
    ret "";
}

pub fun phase_failure(s: PhaseStatus) Fail {
    if (sel s.kind.rejected) { ret reported(); }
    or (sel s.kind.internal) { ret message(s.kind.internal); }
    ret message("internal: an accepted phase has no failure");
}

pub fun merge(into: *PhaseStatus, from: PhaseStatus) {
    into.rejections = into.rejections + from.rejections;
    if (sel from.kind.internal) { internal(into, from.kind.internal); }
    or (sel from.kind.rejected) {
        val was_accepted: bool = sel into.kind.accepted;
        if (was_accepted) { into.kind = PhaseKind.rejected{}; }
    }
}

# closed catalogs. a dispatch over a finite catalog that reaches a member no
# arm names rejects through one of these, so one message shape names the
# catalog and the member and one class says where the fault lies: the member
# arrived from input or a cross-module product, the member is valid but the
# target or phase declares it cannot honor it, or the compiler produced a
# member its own catalog lacks. no site answers an unknown member with a
# default.
rec Member {
    catalog: str;
    tag:     u32;
    where:   str;
}

rec Unsupported {
    catalog: str;
    member:  str;
    by:      str;
}

pub tag Catalog: u8 {
    malformed:   Member;
    unsupported: Unsupported;
    internal:    Member;
}

# a member read from input that the catalog does not declare
pub fun malformed_member(catalog: str, tag: u32) Catalog {
    ret Catalog.malformed{Member{catalog: catalog, tag: tag, where: ""}};
}

# the same, named with where the input came from
pub fun malformed_member_in(catalog: str, tag: u32, where: str) Catalog {
    ret Catalog.malformed{Member{catalog: catalog, tag: tag, where: where}};
}

# a declared member that `by` (a target, format or phase) does not honor
pub fun unsupported_member(catalog: str, member: str, by: str) Catalog {
    ret Catalog.unsupported{Unsupported{catalog: catalog, member: member, by: by}};
}

# a member the compiler produced that its own catalog does not declare
pub fun unknown_member(catalog: str, tag: u32) Catalog {
    ret Catalog.internal{Member{catalog: catalog, tag: tag, where: ""}};
}

# the same, named with the site that produced it
pub fun unknown_member_in(catalog: str, tag: u32, where: str) Catalog {
    ret Catalog.internal{Member{catalog: catalog, tag: tag, where: where}};
}

pub fun is_internal_member(c: Catalog) bool {
    ret sel c.internal;
}

fun member_text(a: *A.Allocator, lead: str, m: Member) res[str, std_format.FormatError] {
    if (str_len(m.where) == 0) { ret std_format.sprint(a, "{} {} tag {}", lead, m.catalog, m.tag); }
    ret std_format.sprint(a, "{} {} tag {} in {}", lead, m.catalog, m.tag, m.where);
}

# the message, owned by the caller's allocator (extent str_len + 1, released
# with str_free); the only failure a literal format can meet is the allocator's
pub fun catalog_text(a: *A.Allocator, c: Catalog) res[str, std_format.FormatError] {
    if (sel c.unsupported) {
        if (str_len(c.unsupported.by) == 0) { ret std_format.sprint(a, "{} {} is unsupported", c.unsupported.catalog, c.unsupported.member); }
        ret std_format.sprint(a, "{} {} is unsupported by {}", c.unsupported.catalog, c.unsupported.member, c.unsupported.by);
    }
    or (sel c.malformed) { ret member_text(a, "malformed", c.malformed); }
    ret member_text(a, "unknown", c.internal);
}

# the message, owned by the interner so it outlives temporary phase storage,
# with `a` as scratch
pub fun catalog_interned(itn: *intern.Interner, a: *A.Allocator, c: Catalog) res[str, Fail] {
    val formatted: res[str, std_format.FormatError] = catalog_text(a, c);
    if (sel formatted.err) { ret res[str, Fail].err{format_refused(formatted.err)}; }
    ret text_intern(itn, a, formatted.ok);
}

# the phase status a class lands on: input and capability faults are rejections
# the caller reports as a diagnostic, an internal member is an internal failure
#[testing]
fun catalog_status(s: *PhaseStatus, c: Catalog, message: str) {
    if (sel c.internal) {
        internal(s, message);
        ret;
    }
    reject(s);
}

# the closed-catalog policy as a failure: an input or capability fault is the
# user's, a compiler-produced member is internal. the message belongs to the
# caller's allocator
pub fun catalog(a: *A.Allocator, c: Catalog) Fail {
    val formatted: res[str, std_format.FormatError] = catalog_text(a, c);
    if (sel formatted.err) { ret format_refused(formatted.err); }
    if (sel c.internal)    { ret message(formatted.ok); }
    if (sel c.unsupported) { ret user(diagnostic_kind.CATALOG_UNSUPPORTED, formatted.ok); }
    ret user(diagnostic_kind.CATALOG_MALFORMED, formatted.ok);
}

pub fun unknown_catalog(a: *A.Allocator, catalog_name: str, tag: u32) Fail {
    ret catalog(a, unknown_member(catalog_name, tag));
}

test fail__cases_text_and_the_zero_value {
    val r: Fail = reported();
    if (!sel r.reported) { ret 1; }
    val t: opt[str] = text(r);
    if (!sel t.none) { ret 2; }
    val m: Fail = message("lower: expression id out of range");
    if (!sel m.message)                                              { ret 3; }
    if (!str_equals(m.message, "lower: expression id out of range")) { ret 3; }
    val mt: opt[str] = text(m);
    if (!sel mt.some)                                              { ret 4; }
    if (!str_equals(mt.some, "lower: expression id out of range")) { ret 4; }
    val e: Fail = refused(A.Error.exhausted{});
    if (!sel e.message)                          { ret 5; }
    if (!str_equals(e.message, "out of memory")) { ret 5; }
    var zero: Fail;
    if (!sel zero.reported)                                            { ret 6; }
    if (!str_equals(describe(zero), REPORTED_TEXT))                    { ret 7; }
    if (!str_equals(describe(m), "lower: expression id out of range")) { ret 8; }
    ret 0;
}

# a keyed failure keeps its class and kind through a new text, and one that
# names no live kind is the compiler defect it is
test fail__keyed_classes_keep_their_kind {
    val u: Fail = user(diagnostic_kind.TOML_MALFORMED, "bad object");
    if (!sel u.user || kind_of(u) != diagnostic_kind.TOML_MALFORMED) { ret 1; }
    val moved: Fail = with_text(u, "retained");
    if (!sel moved.user || kind_of(moved) != diagnostic_kind.TOML_MALFORMED || !str_equals(describe(moved), "retained")) { ret 2; }
    val e: Fail = environment(diagnostic_kind.FS_READ, "cannot read");
    if (!sel e.environment || kind_of(e) != diagnostic_kind.FS_READ) { ret 3; }
    val unkeyed: Fail = user(diagnostic_kind.NONE, "no kind");
    if (!sel unkeyed.message || kind_of(unkeyed) != diagnostic_kind.COMPILER_INTERNAL) { ret 4; }
    if (kind_of(reported()) != diagnostic_kind.NONE)                                   { ret 5; }
    ret 0;
}

# the three closed-catalog classes land on distinct failures: a member from
# input or a cross-module product and a declared member a target cannot honor
# are the user's (exit 1), a member the compiler produced is internal (exit
# 2); each message names the catalog and the member
#[testing]
fun t_user_with(f: Fail, want: str) bool {
    if (!sel f.user) { ret false; }
    ret str_equals(f.user.text, want);
}

#[testing]
fun t_message_with(f: Fail, want: str) bool {
    if (!sel f.message) { ret false; }
    ret str_equals(f.message, want);
}

#[testing]
fun t_text_free(a: *A.Allocator, f: Fail) {
    val carried: opt[str] = text(f);
    if (sel carried.some) { str_free(a, carried.some); }
}

test catalog__three_classes_land_on_distinct_kinds_naming_the_member {
    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    val malformed: Fail = catalog(?a, malformed_member("SectionKind", 200));
    fin { t_text_free(?a, malformed); }
    if (!t_user_with(malformed, "malformed SectionKind tag 200")) { ret 2; }
    val unsupported: Fail = catalog(?a, unsupported_member("Subsystem", "gui", "x86_64-linux"));
    fin { t_text_free(?a, unsupported); }
    if (!t_user_with(unsupported, "Subsystem gui is unsupported by x86_64-linux")) { ret 3; }
    val internal_fail: Fail = unknown_catalog(?a, "PhaseKind", 255);
    fin { t_text_free(?a, internal_fail); }
    if (!t_message_with(internal_fail, "unknown PhaseKind tag 255")) { ret 4; }
    if (sel malformed.message || sel unsupported.message)            { ret 5; }
    ret 0;
}

# a range resolves to the line and column of each end, a related range with
# it, and the places survive a text swap and a retained copy, which owns its
# own paths
test place__a_located_failure_keeps_its_places_through_copies {
    var tracking: T.Testing;
    val made:     err[A.Error] = T.make(?tracking);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?tracking); }
    val a:     *A.Allocator = T.allocator_of(?tracking);
    val text:  str          = "[project]\nmach = \"^x\"\n";
    var also:  Place        = span_only(lang_source.span(0, 9));
    val keyed: Fail         = with_related(a, spanned(user(diagnostic_kind.VERSION_INVALID_RANGE, "bad range"), lang_source.span(17, 4)), ?also, 1);
    val f:     Fail         = placed(a, keyed, "mach.toml", text);
    val at:    opt[Place]   = place_of(f);
    if (sel at.none) { ret 2; }
    val p: Place = at.some;
    if (!str_equals(p.path, "mach.toml") || p.span.offset != 17 || p.span.len != 4)  { ret 3; }
    if (p.start.line != 2 || p.start.col != 8 || p.end.line != 2 || p.end.col != 12) { ret 4; }
    val rel: Related = related_of(f);
    if (rel.count != 1 || !str_equals(rel.items[0].path, "mach.toml"))                                                           { ret 9; }
    if (rel.items[0].start.line != 1 || rel.items[0].start.col != 1 || rel.items[0].end.line != 1 || rel.items[0].end.col != 10) { ret 9; }
    val renamed: opt[Place] = place_of(with_text(f, "renamed"));
    if (sel renamed.none)            { ret 5; }
    if (renamed.some.path != p.path) { ret 5; }

    val kept_r: res[Fail, A.Error] = retain(a, f);
    if (sel kept_r.err) { ret 6; }
    val kept:      opt[Place] = place_of(kept_r.ok);
    val kept_also: Related    = related_of(kept_r.ok);
    var bad:       i32        = 0;
    if (sel kept.some) {
        if (kept.some.path == p.path || !str_equals(kept.some.path, "mach.toml") || kept.some.span.offset != 17) { bad = 7; }
    }
    or { bad = 7; }
    if (kept_also.count != 1 || kept_also.items == rel.items || kept_also.items[0].path == rel.items[0].path
        || kept_also.items[0].span.len != 9) { bad = 10; }
    dnit(a, kept_r.ok);
    places_dnit(a, f);
    if (bad != 0)                                                                                      { ret bad; }
    if (T.tracking_exhausted(?tracking) || T.leaked(?tracking) || T.double_free_count(?tracking) != 0) { ret 8; }
    ret 0;
}

test phase_status__transitions_and_merge {
    var s: PhaseStatus = accepted();
    if (!is_accepted(s) || s.rejections != 0) { ret 1; }
    reject(?s);
    reject(?s);
    if (!sel s.kind.rejected || s.rejections != 2) { ret 2; }
    val rf: Fail = phase_failure(s);
    if (!sel rf.reported) { ret 3; }
    internal(?s, "first");
    internal(?s, "second");
    if (!is_internal(s)) { ret 4; }
    val it: opt[str] = internal_text(s);
    if (!sel it.some)                  { ret 5; }
    if (!str_equals(it.some, "first")) { ret 5; }
    val inf: Fail = phase_failure(s);
    if (!sel inf.message)                  { ret 6; }
    if (!str_equals(inf.message, "first")) { ret 6; }
    var target:   PhaseStatus = accepted();
    var rejected: PhaseStatus = accepted();
    reject(?rejected);
    merge(?target, rejected);
    if (!sel target.kind.rejected || target.rejections != 1) { ret 7; }
    merge(?target, s);
    if (!sel target.kind.internal || target.rejections != 3) { ret 8; }
    val none: opt[str] = internal_text(accepted());
    if (!sel none.none) { ret 9; }
    val af: Fail = phase_failure(accepted());
    if (!sel af.message) { ret 10; }
    var zero: PhaseStatus;
    if (!is_accepted(zero)) { ret 11; }
    ret 0;
}

test catalog__each_class_names_the_catalog_and_the_member {
    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var itn: intern.Interner = intern.init(?a);
    fin { intern.dnit(?itn); }
    val internal_text: res[str, std_format.FormatError] = catalog_text(?a, unknown_member("PhaseKind", 255));
    if (sel internal_text.err) { ret 2; }
    val internal_msg: str = internal_text.ok;
    fin { str_free(?a, internal_msg); }
    if (!str_equals(internal_msg, "unknown PhaseKind tag 255")) { ret 3; }
    val malformed_text: res[str, std_format.FormatError] = catalog_text(?a, malformed_member("SectionKind", 9));
    if (sel malformed_text.err) { ret 4; }
    val malformed_msg: str = malformed_text.ok;
    fin { str_free(?a, malformed_msg); }
    if (!str_equals(malformed_msg, "malformed SectionKind tag 9")) { ret 5; }
    val unsupported_text: res[str, std_format.FormatError] = catalog_text(?a, unsupported_member("Subsystem", "gui", "x86_64-linux"));
    if (sel unsupported_text.err) { ret 6; }
    val unsupported_msg: str = unsupported_text.ok;
    fin { str_free(?a, unsupported_msg); }
    if (!str_equals(unsupported_msg, "Subsystem gui is unsupported by x86_64-linux")) { ret 7; }
    val located:     Catalog        = unknown_member_in("arm64.Opcode", 65530, "'probe'");
    val located_msg: res[str, Fail] = catalog_interned(?itn, ?a, located);
    if (sel located_msg.err)                                                      { ret 8; }
    if (!str_equals(located_msg.ok, "unknown arm64.Opcode tag 65530 in 'probe'")) { ret 8; }
    val again: res[str, Fail] = catalog_interned(?itn, ?a, located);
    if (sel again.err)                         { ret 9; }
    if (!str_equals(again.ok, located_msg.ok)) { ret 9; }
    val placed:     Catalog        = malformed_member_in("SectionKind", 9, "'lib.o'");
    val placed_msg: res[str, Fail] = catalog_interned(?itn, ?a, placed);
    if (sel placed_msg.err)                                                   { ret 10; }
    if (!str_equals(placed_msg.ok, "malformed SectionKind tag 9 in 'lib.o'")) { ret 10; }
    var status: PhaseStatus = accepted();
    catalog_status(?status, malformed_member("SectionKind", 9), malformed_msg);
    if (!sel status.kind.rejected || status.rejections != 1) { ret 11; }
    catalog_status(?status, unsupported_member("Subsystem", "gui", ""), unsupported_msg);
    if (!sel status.kind.rejected || status.rejections != 2) { ret 12; }
    catalog_status(?status, unknown_member("PhaseKind", 255), internal_msg);
    if (!sel status.kind.internal)                                                 { ret 13; }
    if (!str_equals(status.kind.internal, internal_msg) || status.rejections != 2) { ret 13; }
    ret 0;
}

#[testing]
fun t_interned_is(r: res[str, Fail], want: str) bool {
    if (!sel r.ok) { ret false; }
    ret str_equals(r.ok, want);
}

#[testing]
fun t_refused_with(r: res[str, Fail], want: str) bool {
    if (!sel r.err)         { ret false; }
    if (!sel r.err.message) { ret false; }
    ret str_equals(r.err.message, want);
}

#[testing]
fun t_catalog_attempt(ordinal: usize, attempts: *usize) i32 {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?t); }
    val a:   *A.Allocator    = T.allocator_of(?t);
    var itn: intern.Interner = intern.init(a);
    T.fail_at_ordinal(?t, ordinal);
    val r: res[str, Fail] = catalog_interned(?itn, a, unknown_member("ExprKind", 200));
    @attempts = T.attempt_count(?t);
    var bad: i32 = 0;
    if (ordinal == 0 && !t_interned_is(r, "unknown ExprKind tag 200")) { bad = 2; }
    if (ordinal != 0 && !t_refused_with(r, "out of memory"))           { bad = 3; }
    intern.dnit(?itn);
    if (T.leaked(?t) || T.double_free_count(?t) != 0 || T.tracking_exhausted(?t)) { bad = 4; }
    ret bad;
}

test catalog__allocation_refusal_keeps_its_owner {
    var attempts: usize = 0;
    val baseline: i32   = t_catalog_attempt(0, ?attempts);
    if (baseline != 0 || attempts == 0) { ret 1; }
    var ordinal: usize = 1;
    for (ordinal <= attempts) {
        var refused_count: usize = 0;
        val code:          i32   = t_catalog_attempt(ordinal, ?refused_count);
        if (code != 0) { ret code + 1; }
        ordinal = ordinal + 1;
    }
    ret 0;
}

# a made text becomes the failure of its class, and a refusal to make it is
# that refusal, never a failure of the requested class with stand-in text
test formatted_user__a_refused_text_stays_the_refusal {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?t); }
    val a: *A.Allocator = T.allocator_of(?t);
    val f: Fail         = formatted_user(a, diagnostic_kind.CATALOG_MALFORMED, "bad {}", "tag");
    if (!sel f.user)                         { ret 2; }
    if (!str_equals(f.user.text, "bad tag")) { ret 3; }
    dnit(a, f);
    T.fail_at_ordinal(?t, T.attempt_count(?t) + 1);
    val r: Fail = formatted_user(a, diagnostic_kind.CATALOG_MALFORMED, "bad {}", "tag");
    if (!sel r.message)                          { ret 4; }
    if (!str_equals(r.message, "out of memory")) { ret 5; }
    T.clear_failure(?t);
    if (T.leaked(?t) || T.double_free_count(?t) != 0) { ret 6; }
    ret 0;
}
