use mach.lang.fail;
use mach.lang.intern;
use mach.lang.wire;
use std.crypto.hash.sha256;
use fs:        std.filesystem;
use io_error:  std.io.error;
use system_os: std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

pub def Domain: u16;

pub val DOMAIN_SUBSYSTEM:  Domain = 1;
pub val DOMAIN_BUILD_GOAL: Domain = 2;
pub val DOMAIN_ARCH:       Domain = 3;
pub val DOMAIN_ABI:        Domain = 4;
pub val DOMAIN_OS:         Domain = 5;
pub val DOMAIN_BUILD_STEP: Domain = 6;

pub val DOMAIN_OF:           Domain = 7;
pub val DOMAIN_DEBUG:        Domain = 8;
pub val DOMAIN_TARGET_MODEL: Domain = 9;
pub val DOMAIN_BACKEND:      Domain = 10;
pub val DOMAIN_IMAGE:        Domain = 11;
pub val DOMAIN_FS_POLICY:    Domain = 12;

val FILE_DIGEST_CHUNK: usize = 8192;

pub fun file_sha256(path: str, digest: *u8) err[fail.Fail] {
    if (path == nil || digest == nil) { ret err[fail.Fail].err{fail.message("file digest input or output is missing")}; }
    val open_r: res[fs.File, io_error.Error] = fs.open(path);
    if (sel open_r.err) {
        ret err[fail.Fail].err{fail.message(system_os.message(open_r.err))};
    }
    var f:      fs.File = open_r.ok;
    var opened: bool    = true;
    fin {
        # a file opened read-only loses nothing to a refused close, so the failure going out stands alone
        if (opened) { fs.close(?f); }
    }
    val before_r: res[fs.Metadata, io_error.Error] = fs.stat_of(f);
    if (sel before_r.err) {
        ret err[fail.Fail].err{fail.message(fail.io_text(before_r.err))};
    }
    val before: fs.Metadata = before_r.ok;
    if (!fs.meta_is_file(?before)) { ret err[fail.Fail].err{fail.message("cannot digest a non-file path")}; }
    val identity_r: res[fs.Identity, io_error.Error] = fs.identity_of(f);
    if (sel identity_r.err) {
        ret err[fail.Fail].err{fail.message(system_os.message(identity_r.err))};
    }
    val identity: fs.Identity = identity_r.ok;

    var computed: [32]u8;
    val hashed:   err[fail.Fail] = held_file_sha256(f, ?computed[0]);
    if (sel hashed.err) { ret hashed; }
    val validated: err[fail.Fail] = validate_digest_input(path, f, before, identity);
    if (sel validated.err) { ret validated; }
    val closed: err[io_error.Error] = fs.close(?f);
    opened = false;
    if (sel closed.err) {
        ret err[fail.Fail].err{fail.message(system_os.message(closed.err))};
    }
    var i: usize = 0;
    for (i < 32) {
        digest[i] = computed[i];
        i         = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# borrows the file and exclusive seek/read access, rewinds first and leaves it at eof
# failure does not publish a digest, the caller retains close ownership
pub fun held_file_sha256(f: fs.File, digest: *u8) err[fail.Fail] {
    if (digest == nil) { ret err[fail.Fail].err{fail.message("file digest output is missing")}; }
    val before_r: res[fs.Metadata, io_error.Error] = fs.stat_of(f);
    if (sel before_r.err) { ret err[fail.Fail].err{fail.message(fail.io_text(before_r.err))}; }
    val before: fs.Metadata = before_r.ok;
    if (!fs.meta_is_file(?before)) { ret err[fail.Fail].err{fail.message("cannot digest a non-file handle")}; }
    val rewound: res[i64, io_error.Error] = fs.seek(f, 0, fs.SEEK_SET);
    if (sel rewound.err) {
        ret err[fail.Fail].err{fail.message(system_os.message(rewound.err))};
    }
    if (rewound.ok != 0) { ret err[fail.Fail].err{fail.message("file digest could not rewind its input")}; }
    var st:    sha256.State = sha256.init();
    var total: usize        = 0;
    var buf:   [8192]u8;
    for {
        val rr: res[usize, io_error.Error] = fs.read(f, ?buf[0], FILE_DIGEST_CHUNK);
        if (sel rr.err) {
            ret err[fail.Fail].err{fail.message(system_os.message(rr.err))};
        }
        val n: usize = rr.ok;
        if (n == 0)                  { brk; }
        if (n > before.size - total) { ret err[fail.Fail].err{fail.message("file grew while computing its digest")}; }
        total = total + n;
        sha256.update(?st, ?buf[0], n);
    }
    if (total != before.size) { ret err[fail.Fail].err{fail.message("file shrank while computing its digest")}; }
    val stable: err[fail.Fail] = validate_held_digest_input(f, before);
    if (sel stable.err) { ret stable; }
    sha256.final(?st, digest);
    ret err[fail.Fail].ok{};
}

fun validate_digest_input(path: str, held: fs.File, before: fs.Metadata, identity: fs.Identity) err[fail.Fail] {
    # follow the same path semantics while keeping the hashed object retained
    val opened: res[fs.File, io_error.Error] = fs.open(path);
    if (sel opened.err) {
        ret err[fail.Fail].err{fail.message(system_os.message(opened.err))};
    }
    var current:  fs.File                          = opened.ok;
    val observed: res[fs.Identity, io_error.Error] = fs.identity_of(current);
    val closed:   err[io_error.Error]              = fs.close(?current);
    # a file opened read-only loses nothing to a refused close, so the failure going out stands alone
    if (sel observed.err) {
        ret err[fail.Fail].err{fail.message(system_os.message(observed.err))};
    }
    if (sel closed.err) {
        ret err[fail.Fail].err{fail.message(system_os.message(closed.err))};
    }
    if (!fs.identity_equal(identity, observed.ok)) {
        ret err[fail.Fail].err{fail.message("file changed while computing its digest")};
    }
    ret validate_held_digest_input(held, before);
}

fun validate_held_digest_input(held: fs.File, before: fs.Metadata) err[fail.Fail] {
    val after_r: res[fs.Metadata, io_error.Error] = fs.stat_of(held);
    if (sel after_r.err) { ret err[fail.Fail].err{fail.message(fail.io_text(after_r.err))}; }
    val after: fs.Metadata = after_r.ok;
    if (!fs.meta_is_file(?after) || before.size != after.size
        || before.modified.sec != after.modified.sec
        || before.modified.nsec != after.modified.nsec) {
        ret err[fail.Fail].err{fail.message("file changed while computing its digest")};
    }
    ret err[fail.Fail].ok{};
}

# a domain-separated value: its domain, its schema version, then the value,
# so two fingerprints that differ in any of the three never share bytes
fun put_domain(s: *wire.Sink, domain: Domain, schema_version: u8) {
    wire.put_u16(s, domain);
    wire.put_u8(s, schema_version);
}

pub fun put_domain_u8(s: *wire.Sink, domain: Domain, schema_version: u8, value: u8) {
    put_domain(s, domain, schema_version);
    wire.put_u8(s, value);
}

pub fun put_domain_u32(s: *wire.Sink, domain: Domain, schema_version: u8, value: u32) {
    put_domain(s, domain, schema_version);
    wire.put_u32(s, value);
}

pub fun put_domain_u64(s: *wire.Sink, domain: Domain, schema_version: u8, value: u64) {
    put_domain(s, domain, schema_version);
    wire.put_u64(s, value);
}

pub fun put_domain_bytes(s: *wire.Sink, domain: Domain, schema_version: u8, p: *u8, len: usize) {
    put_domain(s, domain, schema_version);
    wire.put_sized(s, p, len);
}

pub fun put_domain_str(s: *wire.Sink, domain: Domain, schema_version: u8, text: str) {
    put_domain_bytes(s, domain, schema_version, text::*u8, str_len(text));
}

# a text as its u32 length then its bytes; nil and empty both put the length 0
pub fun put_text(s: *wire.Sink, text: str) {
    if (text == nil) {
        wire.put_u32(s, 0);
        ret;
    }
    wire.put_sized(s, text::*u8, str_len(text));
}

# an interned name by its spelling, so fingerprints agree across interners:
# a u8 1 then its text, or a u8 0 for no name
pub fun put_name(s: *wire.Sink, itn: *intern.Interner, name: intern.StrId) {
    if (intern.str_is_nil(name)) {
        wire.put_u8(s, 0);
        ret;
    }
    val text: opt[str] = intern.get(itn, name);
    if (sel text.none) {
        wire.refuse(s, fail.message("fingerprint name is absent from its interner"));
        ret;
    }
    wire.put_u8(s, 1);
    put_text(s, text.some);
}

fun put_digest(s: *wire.Sink, digest: *u8) {
    wire.put_u32(s, sha256.DIGEST_SIZE::u32);
    wire.put_bytes(s, digest, sha256.DIGEST_SIZE);
}

# bytes by their sha-256 digest, a u32 32 then the digest, or the u32 0 when
# there are none
pub fun put_content(s: *wire.Sink, bytes: *u8, len: usize) {
    if (bytes == nil) {
        wire.put_u32(s, 0);
        ret;
    }
    var digest: [32]u8;
    sha256.hash(bytes, len, ?digest[0]);
    put_digest(s, ?digest[0]);
}

# a file by the digest of its contents, as put_content puts bytes
pub fun put_file(s: *wire.Sink, path: str) {
    if (path == nil) {
        wire.put_u32(s, 0);
        ret;
    }
    var digest: [32]u8;
    val hashed: err[fail.Fail] = file_sha256(path, ?digest[0]);
    if (sel hashed.err) {
        wire.refuse(s, hashed.err);
        ret;
    }
    put_digest(s, ?digest[0]);
}
