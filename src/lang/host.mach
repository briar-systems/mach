# the host the compiler runs on: every primitive whose spelling differs by the
# operating system the compiler itself was built for. a compiler module calls
# these and holds no host conditional of its own. the target a build produces
# is the target module's concern, not this one's
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.path.Path;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_contains_char;
use std.types.string.str_copy;
use std.types.string.str_copy_slice;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;
use std.allocator.page;
use fs: std.filesystem;
use std.filesystem.native;
use io_error: std.io.error;
use std.memory;
use std.process.env;
use std.runtime.native.view.NativeName;
use std.runtime.native.view.Unit;
use std.system.file_identity;
use system_os: std.system.os;

use lang_alloc:        mach.lang.alloc;
use build_fingerprint: mach.lang.build.fingerprint;
use diagnostic_kind:   mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.target.of.bin;
use mach.lang.target.of.buildid;

$if ($mach.build.os == $mach.os.linux) {
    use native_os: std.system.os.linux;
}
$or ($mach.build.os == $mach.os.darwin) {
    use native_os: std.system.os.darwin;
}

# the open flag that refuses a symlink at the leaf, and the one that keeps an
# open from blocking on a fifo; 0 where the host's open has neither
$if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) {
    pub val OPEN_NOFOLLOW: i32 = native_os.O_NOFOLLOW;
    pub val OPEN_NONBLOCK: i32 = native_os.O_NONBLOCK;
}
$or {
    pub val OPEN_NOFOLLOW: i32 = 0;
    pub val OPEN_NONBLOCK: i32 = 0;
}

# whether the host keeps posix permission bits on a file
$if ($mach.build.os == $mach.os.windows) {
    pub val PERMISSIONS: bool = false;
}
$or {
    pub val PERMISSIONS: bool = true;
}

# the program that ends a process the host cannot signal directly, and its
# arguments for the process named by pid, written to argv and ended by nil
# ---
# pid:  the process id as decimal text
# argv: room for four entries
# ret:  the program's path, which argv[0] also names
pub fun terminate_command(pid: *u8, argv: **u8) *u8 {
    $if ($mach.build.os == $mach.os.windows) {
        argv[0] = "taskkill.exe";
        argv[1] = "/PID";
    }
    $or {
        argv[0] = "/bin/kill";
        argv[1] = "-TERM";
    }
    argv[2] = pid;
    argv[3] = nil;
    ret argv[0];
}

$if ($mach.build.os == $mach.os.darwin) {
    #[library("libsystem")]
    #[symbol("_sysctl")]
    ext fun sysctl(name: *i32, name_len: u32, old: ptr, old_len: *usize, new: ptr, new_len: usize) i32;
}

val PROC_STAT_CAP: usize = 512;

# whether a process with this id is still running, for a test that waits on one;
# a zombie, ended but not yet reaped by its parent, counts as gone, and so does
# a host with no way to ask
#[testing]
pub fun process_running(pid: i64) bool {
    if (pid <= 0) { ret false; }
    $if ($mach.build.os == $mach.os.linux) {
        var path: [32]u8;
        var rev:  [20]u8;
        var n:    usize = 0;
        var rest: i64   = pid;
        for (rest > 0) {
            rev[n] = '0'::u8 + (rest % 10)::u8;
            rest   = rest / 10;
            n      = n + 1;
        }
        val head: str   = "/proc/";
        val tail: str   = "/stat";
        var at:   usize = 0;
        var i:    usize = 0;
        for (i < 6) {
            path[at] = head[i];
            at       = at + 1;
            i        = i + 1;
        }
        for (n > 0) {
            n        = n - 1;
            path[at] = rev[n];
            at       = at + 1;
        }
        i = 0;
        for (i < 5) {
            path[at] = tail[i];
            at       = at + 1;
            i        = i + 1;
        }
        path[at] = 0;

        var fd:     usize = system_os.INVALID_HANDLE;
        val opened: i64   = system_os.open(system_os.working_dir(), ?path[0], system_os.O_RDONLY, 0, ?fd);
        if (opened < 0) { ret false; }
        var buf: [PROC_STAT_CAP]u8;
        val got: i64 = system_os.read(fd, ?buf[0], PROC_STAT_CAP);
        system_os.close(fd);
        if (got <= 0) { ret false; }
        # the state letter follows the last ')' and a space, since the command name may hold either
        var close_at: usize = 0;
        var k:        usize = 0;
        for (k < got::usize) {
            if (buf[k] == ')'::u8) { close_at = k; }
            k = k + 1;
        }
        if (close_at == 0 || close_at + 2 >= got::usize) { ret false; }
        val state: u8 = buf[close_at + 2];
        ret state != 'Z'::u8 && state != 'X'::u8;
    }
    $or ($mach.build.os == $mach.os.darwin) {
        # sysctl kern.proc.pid.<pid> fills a kinfo_proc, whose p_stat is at offset 36
        var mib: [4]i32;
        mib[0] = 1;
        mib[1] = 14;
        mib[2] = 1;
        mib[3] = pid::i32;
        var info: [648]u8;
        var size: usize = 648;
        if (sysctl(?mib[0], 4, (?info[0])::ptr, ?size, nil, 0) != 0) { ret false; }
        if (size < 40)                                               { ret false; }
        ret info[36] != 5;
    }
    $or { ret false; }
}

val EXEC_CAND_MAX: usize = 16;

# whether the host would run the file at p; windows runs any file, and decides by its extension
fun path_is_executable(p: str) bool {
    $if ($mach.build.os == $mach.os.windows) {
        ret true;
    }
    $or {
        ret system_os.access(system_os.working_dir(), p, 1, 0) >= 0;
    }
}

# why text could not be put in native units
# ---
# native: the conversion refused it, malformed UTF-8 on windows; the native code
# alloc:  the owned copy could not be acquired
pub tag NativeTextError: u8 {
    native: i64;
    alloc:  A.Error;
}

# `text` in std.runtime.native units, owned and terminated: converted from
# UTF-8 once on windows, the bytes as they are elsewhere
# ---
# a:    allocator for the units, which native_text_free releases
# text: the UTF-8 text, nil read as empty
# ret:  the units and their length, or the refusal
pub fun native_text(a: *A.Allocator, text: str) res[NativeName, NativeTextError] {
    if (text == nil || str_empty(text)) {
        val er: res[*Unit, A.Error] = A.allocate[Unit](a, 1);
        if (sel er.err) { ret res[NativeName, NativeTextError].err{NativeTextError.alloc{er.err}}; }
        er.ok[0] = 0;
        ret res[NativeName, NativeTextError].ok{NativeName{units: er.ok, length: 0}};
    }
    var converted: system_os.NativePath;
    val made:      i64 = system_os.native_path(text::*u8, ?converted);
    if (made < 0) { ret res[NativeName, NativeTextError].err{NativeTextError.native{made}}; }
    var length: usize = 0;
    for (converted.units[length] != 0) { length = length + 1; }
    val ur: res[*Unit, A.Error] = A.allocate[Unit](a, length + 1);
    if (sel ur.err) {
        system_os.native_path_release(?converted);
        ret res[NativeName, NativeTextError].err{NativeTextError.alloc{ur.err}};
    }
    val units: *Unit = ur.ok;
    var i:     usize = 0;
    for (i <= length) {
        units[i] = converted.units[i];
        i        = i + 1;
    }
    system_os.native_path_release(?converted);
    ret res[NativeName, NativeTextError].ok{NativeName{units: units, length: length}};
}

pub fun native_text_free(a: *A.Allocator, name: *NativeName) {
    if (name.units == nil) { ret; }
    A.deallocate[Unit](a, name.units, name.length + 1);
    name.units  = nil;
    name.length = 0;
}

# the refusal of a native text conversion as text
pub fun native_text_message(error: NativeTextError) str {
    if (sel error.native) { ret system_os.error_message(error.native); }
    ret lang_alloc.text(error.alloc);
}

# compare two environment variable names in native units by the host's
# identity, returning -1, 0 or 1, as std.process.env.compare_names_native
# orders them: ordinal case-insensitive UTF-16 order on windows, byte order
# elsewhere
# ---
# ret: the order, or the refusal of a name past the platform's length limit
pub fun compare_env_names(left: *Unit, left_length: usize, right: *Unit, right_length: usize) res[i32, fail.Fail] {
    val order: res[i32, env.EnvError] = env.compare_names_native(left, left_length, right, right_length);
    if (sel order.err) { ret res[i32, fail.Fail].err{fail.environment(diagnostic_kind.ENV_READ, fail.env_text(order.err))}; }
    ret res[i32, fail.Fail].ok{order.ok};
}

fun program_direct(a: *A.Allocator, name: str) res[str, fail.Fail] {
    val is_file_r: res[bool, io_error.Error] = fs.is_file(name);
    if (!(sel is_file_r.ok && is_file_r.ok)) { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.PROCESS_NOT_FOUND, "direct command path does not exist or is not a regular file")}; }
    if (!path_is_executable(name))           { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.PROCESS_NOT_EXECUTABLE, "direct command path is not executable")}; }
    val str_copy_r: res[str, types_string.StrError] = str_copy(a, name);
    if (sel str_copy_r.err) { ret res[str, fail.Fail].err{fail.message(fail.str_text(str_copy_r.err))}; }
    ret res[str, fail.Fail].ok{str_copy_r.ok};
}

# locate an executable the way a shell would: a name with a path separator is used directly
# and must be an existing executable file; any other name is searched on PATH
# ---
# a:    allocator for the returned path
# name: the program name or path
# ret:  the resolved path, owned by the caller; "PATH unset", "not found on PATH", or the
#       direct-path error
pub fun program_resolve(a: *A.Allocator, name: str) res[str, fail.Fail] {
    if (types_path.has_separator(name)) { ret program_direct(a, name); }

    val paths_r: res[opt[types_string.OwnedString], env.EnvError] = env.value(a, "PATH");
    if (sel paths_r.err)     { ret res[str, fail.Fail].err{fail.environment(diagnostic_kind.PROCESS_PATH_ENV, fail.env_text(paths_r.err))}; }
    if (sel paths_r.ok.none) { ret res[str, fail.Fail].err{fail.environment(diagnostic_kind.PROCESS_PATH_ENV, "PATH unset")}; }
    var paths: types_string.OwnedString = paths_r.ok.some;
    val out:   res[str, fail.Fail]      = program_resolve_in(a, name, paths.data);
    types_string.owned_release(?paths);
    ret out;
}

# locate an executable through an explicit search list
# on windows the list separator is ';' and a name without a '.' is tried with each PATHEXT
# extension (default .COM;.EXE;.BAT;.CMD); elsewhere the separator is ':' and the name is
# tried as given. a name with a path separator is used directly, as in program_resolve
# ---
# a:      allocator for the returned path
# name:   the program name or path
# search: the separator-joined directories; empty segments are skipped
# ret:    the first existing executable candidate, owned by the caller; "empty program name",
#         "not found on PATH", or the direct-path error
fun program_resolve_in(a: *A.Allocator, name: str, search: str) res[str, fail.Fail] {
    if (str_empty(name))                { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.PROCESS_NAME_EMPTY, "empty program name")}; }
    if (types_path.has_separator(name)) { ret program_direct(a, name); }

    var list_sep: u8 = ':';
    $if ($mach.build.os == $mach.os.windows) {
        list_sep = ';';
    }

    var cand:  [EXEC_CAND_MAX]str;
    var ncand: usize = 1;
    cand[0] = name;
    var owned_cands: bool = false;

    $if ($mach.build.os == $mach.os.windows) {
        if (!str_contains_char(name, '.')) {
            var exts:     str                                              = "";
            var own_exts: bool                                             = false;
            var from_env: opt[types_string.OwnedString]                    = opt[types_string.OwnedString].none{};
            val exts_r:   res[opt[types_string.OwnedString], env.EnvError] = env.value(a, "PATHEXT");
            if (sel exts_r.ok) {
                if (sel exts_r.ok.some) {
                    from_env = exts_r.ok;
                    exts     = exts_r.ok.some.data;
                }
            }
            if (str_empty(exts)) {
                val unused: opt[types_string.OwnedString] = from_env;
                from_env = opt[types_string.OwnedString].none{};
                if (sel unused.some) {
                    var released: types_string.OwnedString = unused.some;
                    types_string.owned_release(?released);
                }
                val d_r: res[str, types_string.StrError] = str_copy(a, ".COM;.EXE;.BAT;.CMD");
                if (sel d_r.err) { ret res[str, fail.Fail].err{fail.message("out of memory")}; }
                exts     = d_r.ok;
                own_exts = true;
            }
            val elen: usize = str_len(exts);
            ncand       = 0;
            owned_cands = true;
            var e: usize = 0;
            for (e < elen && ncand < EXEC_CAND_MAX) {
                val estart: usize = e;
                for (e < elen && exts[e] != ';') { e = e + 1; }
                val eseg: usize = e - estart;
                if (e < elen) { exts[e] = 0; }
                e = e + 1;
                if (eseg == 0) { cnt; }
                val j_r: res[str, types_string.StrError] = str_join(a, name, (?exts[estart])::str);
                if (sel j_r.ok) {
                    cand[ncand] = j_r.ok;
                    ncand       = ncand + 1;
                }
            }
            if (own_exts)          { A.deallocate[u8](a, exts, elen + 1); }
            if (sel from_env.some) { types_string.owned_release(?from_env.some); }
        }
    }

    val slen:  usize = str_len(search);
    var found: str   = "";
    var i:     usize = 0;
    for (i < slen && str_empty(found)) {
        val start: usize = i;
        for (i < slen && search[i] != list_sep) { i = i + 1; }
        val seg_len: usize = i - start;
        i = i + 1;
        if (seg_len == 0) { cnt; }

        val dir_r: res[str, types_string.StrError] = str_copy_slice(a, search, start, seg_len);
        if (sel dir_r.err) { cnt; }
        val dir: str = dir_r.ok;

        var c: usize = 0;
        for (c < ncand) {
            val cand_r: res[Path, A.Error] = types_path.join(a, dir, cand[c]);
            if (sel cand_r.ok) {
                val full:      str                       = cand_r.ok;
                val is_file_r: res[bool, io_error.Error] = fs.is_file(full);
                if ((sel is_file_r.ok && is_file_r.ok) && path_is_executable(full)) {
                    found = full;
                    brk;
                }
                A.deallocate[u8](a, full, str_len(full) + 1);
            }
            c = c + 1;
        }
        A.deallocate[u8](a, dir, seg_len + 1);
    }

    if (owned_cands) {
        var k: usize = 0;
        for (k < ncand) {
            A.deallocate[u8](a, cand[k], str_len(cand[k]) + 1);
            k = k + 1;
        }
    }

    if (str_empty(found)) { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.PROCESS_NOT_FOUND, "not found on PATH")}; }
    ret res[str, fail.Fail].ok{found};
}

test program_resolve__a_direct_path_must_be_an_executable_file_and_the_result_is_owned {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?backing, "mach_program_resolve_exec");
    if (sel tf_r.err) { ret 1; }
    var tf: fs.TempFile = tf_r.ok;
    val p:  str         = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    var bad:           i32             = 0;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(p, "#!/bin/sh\n"::*u8, 10::usize, 0o644);
    if (sel write_bytes_r.err) { bad = 1; }

    val missing_r: res[str, fail.Fail] = program_resolve(?backing, "./definitely/not/a/real-cmd");
    if (sel missing_r.ok) { bad = 2; }

    val dir_r: res[Path, A.Error] = types_path.parent(?backing, p);
    if (sel dir_r.err) { ret 99; }
    val as_dir_r: res[str, fail.Fail] = program_resolve(?backing, dir_r.ok);
    if (sel as_dir_r.ok) { bad = 3; }

    val noexec_r: res[str, fail.Fail] = program_resolve(?backing, p);
    if (sel noexec_r.ok)                                                   { bad = 4; }
    if (system_os.set_mode_at(system_os.working_dir(), p::*u8, 0o755) < 0) { bad = 5; }

    val r: res[str, fail.Fail] = program_resolve(?backing, p);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        val out: str = r.ok;
        if (!str_equals(out, p))    { bad = 1; }
        if (out::usize == p::usize) { bad = 1; }
    }

    fs.remove_file(p);
    ret bad;
}

test program_resolve_in__a_nonexecutable_earlier_directory_does_not_shadow_a_later_executable_one {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?backing, "mach_program_resolve_shadow");
    if (sel tf_r.err) { ret 1; }
    var tf:     fs.TempFile                     = tf_r.ok;
    val root_r: res[str, types_string.StrError] = str_copy(?backing, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    var bad:  i32 = 0;

    val dir1_r: res[Path, A.Error] = types_path.join(?backing, root, "d1");
    val dir2_r: res[Path, A.Error] = types_path.join(?backing, root, "d2");
    if (sel dir1_r.err) { ret 1; }
    if (sel dir2_r.err) { ret 1; }
    val dir1:              str             = dir1_r.ok;
    val dir2:              str             = dir2_r.ok;
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?backing, dir1, 0o755);
    val create_dir_all_r:  err[fs.FsError] = fs.create_dir_all(?backing, dir2, 0o755);
    if (sel create_dir_all_r2.err
        || sel create_dir_all_r.err) { bad = 1; }

    val bad_tool_r:  res[Path, A.Error] = types_path.join(?backing, dir1, "tool");
    val good_tool_r: res[Path, A.Error] = types_path.join(?backing, dir2, "tool");
    if (sel bad_tool_r.err)  { ret 99; }
    if (sel good_tool_r.err) { ret 99; }
    val bad_tool:      str             = bad_tool_r.ok;
    val good_tool:     str             = good_tool_r.ok;
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(bad_tool, "x"::*u8, 1::usize, 0o644);
    if (sel write_bytes_r.err) { bad = 1; }
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(good_tool, "#!/bin/sh\n"::*u8, 10::usize, 0o755);
    if (sel write_bytes_r2.err) { bad = 1; }

    val search_r: res[str, types_string.StrError] = str_join(?backing, dir1, ":"::str, dir2);
    if (sel search_r.err) { bad = 1; }
    if (sel search_r.ok) {
        val r: res[str, fail.Fail] = program_resolve_in(?backing, "tool"::str, search_r.ok);
        if (!(sel r.ok && str_equals(r.ok, good_tool))) { bad = 1; }
    }

    fs.remove_all(?backing, root);
    ret bad;
}

# what a component is, read without following it
pub def ProbeKind: u8;

pub val PROBE_ABSENT: ProbeKind = 0;
pub val PROBE_FAILED: ProbeKind = 1;
pub val PROBE_LINK:   ProbeKind = 2;
pub val PROBE_DIR:    ProbeKind = 3;
pub val PROBE_FILE:   ProbeKind = 4;
pub val PROBE_OTHER:  ProbeKind = 5;

pub rec Probe {
    kind:   ProbeKind;
    detail: str;
}

# a contained walk's hold on a path: on posix a descriptor for the directory the next
# component is read beneath, opened one component at a time; windows reads
# each prefix by path, beneath the same root
pub rec Cursor {
    alloc: *A.Allocator;
    root:  str;
    fd:    usize;
}

fun walk_fail(f: fail.Fail) err[fail.Fail] {
    ret err[fail.Fail].err{f};
}

pub fun cursor_open(c: *Cursor, alloc: *A.Allocator, root: str, label: str) err[fail.Fail] {
    c.alloc = alloc;
    c.root  = root;
    c.fd    = system_os.INVALID_HANDLE;
    $if ($mach.build.os != $mach.os.windows) {
        val opened: i64 = system_os.open(system_os.working_dir(), root, system_os.O_RDONLY | system_os.O_DIRECTORY, 0, ?c.fd);
        if (opened < 0) { ret walk_fail(fail.formatted_user(alloc, diagnostic_kind.PATH_INACCESSIBLE, "{} root '{}' cannot be opened: {}", label, root, system_os.error_message(opened))); }
    }
    ret err[fail.Fail].ok{};
}

pub fun cursor_close(c: *Cursor) err[fail.Fail] {
    if (c.fd == system_os.INVALID_HANDLE) { ret err[fail.Fail].ok{}; }
    val closed: i64 = system_os.close(c.fd);
    c.fd = system_os.INVALID_HANDLE;
    if (closed < 0) { ret walk_fail(fail.user(diagnostic_kind.PATH_INACCESSIBLE, system_os.error_message(closed))); }
    ret err[fail.Fail].ok{};
}

fun probe_mode(mode: u32) ProbeKind {
    val kind: u32 = mode & system_os.S_IFMT;
    if (kind == system_os.S_IFLNK) { ret PROBE_LINK; }
    if (kind == system_os.S_IFDIR) { ret PROBE_DIR; }
    if (kind == system_os.S_IFREG) { ret PROBE_FILE; }
    ret PROBE_OTHER;
}

fun probe_meta(c: *Cursor, path: str) Probe {
    val meta_r: res[fs.Metadata, io_error.Error] = fs.metadata_link(path);
    if (sel meta_r.err) {
        var kind: ProbeKind = PROBE_FAILED;
        if (meta_r.err.kind == io_error.NOT_FOUND) { kind = PROBE_ABSENT; }
        ret Probe{kind: kind, detail: fail.io_text(meta_r.err)};
    }
    val meta: fs.Metadata = meta_r.ok;
    if (fs.meta_is_symlink(?meta)) { ret Probe{kind: PROBE_LINK, detail: ""}; }
    if (fs.meta_is_dir(?meta))     { ret Probe{kind: PROBE_DIR, detail: ""}; }
    if (fs.meta_is_file(?meta))    { ret Probe{kind: PROBE_FILE, detail: ""}; }
    ret Probe{kind: PROBE_OTHER, detail: ""};
}

# the component's kind; windows resolves the prefix against the root
pub fun cursor_probe(c: *Cursor, component: str, prefix: str) res[Probe, fail.Fail] {
    $if ($mach.build.os == $mach.os.windows) {
        val abs_r: res[str, A.Error] = types_path.resolve(c.alloc, c.root, prefix);
        if (sel abs_r.err) { ret res[Probe, fail.Fail].err{fail.refused(abs_r.err)}; }
        val probed: Probe = probe_meta(c, abs_r.ok);
        str_free(c.alloc, abs_r.ok);
        ret res[Probe, fail.Fail].ok{probed};
    }
    $or {
        var st:     system_os.stat_t;
        val stated: i64 = system_os.stat_path(c.fd, component, ?st, system_os.AT_SYMLINK_NOFOLLOW);
        if (stated < 0) {
            var kind: ProbeKind = PROBE_FAILED;
            if (system_os.error_kind(stated) == io_error.NOT_FOUND) { kind = PROBE_ABSENT; }
            ret res[Probe, fail.Fail].ok{Probe{kind: kind, detail: system_os.error_message(stated)}};
        }
        ret res[Probe, fail.Fail].ok{Probe{kind: probe_mode(native.stat_mode(?st)), detail: ""}};
    }
}

# a directory for a missing component; one a concurrent writer made first is as good
pub fun cursor_make(c: *Cursor, component: str, prefix: str) opt[str] {
    $if ($mach.build.os == $mach.os.windows) {
        val abs_r: res[str, A.Error] = types_path.resolve(c.alloc, c.root, prefix);
        if (sel abs_r.err) { ret opt[str].some{lang_alloc.text(abs_r.err)}; }
        val made: err[io_error.Error] = fs.create_dir(abs_r.ok, 0o755);
        str_free(c.alloc, abs_r.ok);
        if (sel made.err) {
            if (made.err.kind != io_error.EXISTS) { ret opt[str].some{fail.io_text(made.err)}; }
        }
        ret opt[str].none{};
    }
    $or {
        val made: i64 = system_os.make_dir(c.fd, component, 0o755);
        if (made < 0 && system_os.error_kind(made) != io_error.EXISTS) { ret opt[str].some{system_os.error_message(made)}; }
        ret opt[str].none{};
    }
}

# remove a stale non-directory component, never following it
pub fun cursor_unlink(c: *Cursor, component: str, prefix: str) opt[str] {
    $if ($mach.build.os == $mach.os.windows) {
        val abs_r: res[str, A.Error] = types_path.resolve(c.alloc, c.root, prefix);
        if (sel abs_r.err) { ret opt[str].some{lang_alloc.text(abs_r.err)}; }
        val removed: err[io_error.Error] = fs.remove_file(abs_r.ok);
        str_free(c.alloc, abs_r.ok);
        if (sel removed.err) { ret opt[str].some{fail.io_text(removed.err)}; }
        ret opt[str].none{};
    }
    $or {
        val removed: i64 = system_os.unlink(c.fd, component, 0);
        if (removed < 0) { ret opt[str].some{system_os.error_message(removed)}; }
        ret opt[str].none{};
    }
}

# step beneath a component already read as a real directory, checking that
# what was opened is still one
# enter:   the refusal of a component that cannot be opened, formatted with label, rel, prefix and the native detail
# invalid: the refusal of one that opened as something else, formatted with label, rel and prefix
pub fun cursor_enter(c: *Cursor, enter: str, invalid: str, label: str, rel: str, component: str, prefix: str) err[fail.Fail] {
    $if ($mach.build.os == $mach.os.windows) { ret err[fail.Fail].ok{}; }
    $or {
        var next:   usize = system_os.INVALID_HANDLE;
        val opened: i64   = system_os.open(c.fd, component, system_os.O_RDONLY | system_os.O_DIRECTORY, 0, ?next);
        if (opened < 0) { ret walk_fail(fail.formatted_user(c.alloc, diagnostic_kind.PATH_INACCESSIBLE, enter, label, rel, prefix, system_os.error_message(opened))); }
        var st:     system_os.stat_t;
        val stated: i64 = system_os.stat(next, ?st);
        if (stated < 0 || probe_mode(native.stat_mode(?st)) != PROBE_DIR) {
            system_os.close(next);
            ret walk_fail(fail.formatted_user(c.alloc, diagnostic_kind.PATH_ENTRY_TYPE, invalid, label, rel, prefix));
        }
        val closed: i64 = system_os.close(c.fd);
        c.fd = next;
        if (closed < 0) { ret walk_fail(fail.user(diagnostic_kind.PATH_INACCESSIBLE, system_os.error_message(closed))); }
        ret err[fail.Fail].ok{};
    }
}

# the root itself, which posix opened as a directory; windows reads it by path,
# so a symlinked root is refused there as any component is
pub fun cursor_root(c: *Cursor) Probe {
    $if ($mach.build.os == $mach.os.windows) { ret probe_meta(c, c.root); }
    $or                                      { ret Probe{kind: PROBE_DIR, detail: ""}; }
}

# why the running image's identity could not be read: unavailable on this host
# or in this process, or an internal fault of the reader
pub val FAULT_UNAVAILABLE: u8 = 1;
pub val FAULT_INTERNAL:    u8 = 2;
pub rec Fault { kind: u8; message: str; }

fun unavailable(message: str) Fault {
    ret Fault{kind: FAULT_UNAVAILABLE, message: message};
}

fun internal(message: str) Fault {
    ret Fault{kind: FAULT_INTERNAL, message: message};
}

fun io_failure(error: io_error.Error) Fault {
    if (error.kind == io_error.RESOURCE_EXHAUSTED || error.kind == io_error.INVALID || error.kind == io_error.CLOSED) {
        ret internal(system_os.message(error));
    }
    ret unavailable(system_os.message(error));
}

fun hash_held(held: fs.File, out: *u8) err[Fault] {
    val hashed: err[fail.Fail] = build_fingerprint.held_file_sha256(held, out);
    if (sel hashed.err) { ret err[Fault].err{internal(fail.describe(hashed.err))}; }
    ret err[Fault].ok{};
}

fun finish_owned(held: *fs.File, out: *u8) err[Fault] {
    var computed: [32]u8;
    val hashed:   err[Fault]          = hash_held(@held, ?computed[0]);
    val closed:   err[io_error.Error] = fs.close(held);
    if (sel hashed.err) { ret hashed; }
    if (sel closed.err) { ret err[Fault].err{internal(system_os.message(closed.err))}; }
    memory.raw_copy(out::ptr, (?computed[0])::ptr, 32);
    ret err[Fault].ok{};
}

fun identified_digest(path: str, expected: fs.Identity, out: *u8) err[Fault] {
    val opened: res[fs.File, io_error.Error] = fs.open(path);
    if (sel opened.err) { ret err[Fault].err{io_failure(opened.err)}; }
    var held:     fs.File                          = opened.ok;
    val observed: res[fs.Identity, io_error.Error] = fs.identity_of(held);
    if (sel observed.err) {
        val closed: err[io_error.Error] = fs.close(?held);
        if (sel closed.err) { ret err[Fault].err{internal("compiler identity query and file cleanup both failed")}; }
        ret err[Fault].err{io_failure(observed.err)};
    }
    if (!fs.identity_equal(expected, observed.ok)) {
        val closed: err[io_error.Error] = fs.close(?held);
        if (sel closed.err) { ret err[Fault].err{internal("compiler identity changed and file cleanup failed")}; }
        ret err[Fault].err{unavailable("compiler path no longer names the running image")};
    }
    ret finish_owned(?held, out);
}

$if ($mach.build.os == $mach.os.linux) {
    val AT_PHDR:     u64 = 3;
    val AT_PHENT:    u64 = 4;
    val AT_PHNUM:    u64 = 5;
    val PT_LOAD:     u32 = 1;
    val PT_NOTE:     u32 = 4;
    val PT_PHDR:     u32 = 6;
    val PHDR64_SIZE: u64 = 56;

    # the auxiliary vector sits past the terminator of the environment block
    # the runtime captured; type/value pairs ended by AT_NULL
    fun auxval(kind: u64) u64 {
        val envp: **u8 = system_os.environ_native();
        if (envp == nil) { ret 0; }
        val slots: *u64  = envp::ptr::*u64;
        var i:     usize = 0;
        for (slots[i] != 0) { i = i + 1; }
        i = i + 1;
        for (slots[i] != 0) {
            if (slots[i] == kind) { ret slots[i + 1]; }
            i = i + 2;
        }
        ret 0;
    }

    # the note the linker placed in the header page, read through the program
    # header table the kernel mapped: PT_PHDR gives the load bias (zero for an
    # ET_EXEC without one), PT_NOTE the note, and a PT_LOAD must map its whole
    # extent before a byte of it is touched. 0 when the image carries none
    fun mapped_build_id(out: *u8) usize {
        val phdr:  u64 = auxval(AT_PHDR);
        val phnum: u64 = auxval(AT_PHNUM);
        if (phdr == 0 || phnum == 0 || phnum > 0xFFFF || auxval(AT_PHENT) != PHDR64_SIZE) { ret 0; }
        val table:      *u8   = phdr::usize::ptr::*u8;
        var bias:       u64   = 0;
        var note_vaddr: u64   = 0;
        var note_size:  u64   = 0;
        var i:          usize = 0;
        for (i < phnum::usize) {
            val ph:   usize = i * PHDR64_SIZE::usize;
            val kind: u32   = bin.read_u32_le(table, ph);
            if (kind == PT_PHDR) { bias = phdr - bin.read_u64_le(table, ph + 16); }
            if (kind == PT_NOTE && note_size == 0) {
                note_vaddr = bin.read_u64_le(table, ph + 16);
                note_size  = bin.read_u64_le(table, ph + 32);
            }
            i = i + 1;
        }
        if (note_size < buildid.ELF_NOTE_SIZE::u64) { ret 0; }
        val note:   u64  = note_vaddr + bias;
        var mapped: bool = false;
        i = 0;
        for (i < phnum::usize) {
            val ph: usize = i * PHDR64_SIZE::usize;
            if (bin.read_u32_le(table, ph) == PT_LOAD) {
                val lo:     u64 = bin.read_u64_le(table, ph + 16) + bias;
                val filesz: u64 = bin.read_u64_le(table, ph + 32);
                if (note >= lo && filesz >= buildid.ELF_NOTE_SIZE::u64 && note - lo <= filesz - buildid.ELF_NOTE_SIZE::u64) { mapped = true; }
            }
            i = i + 1;
        }
        if (!mapped) { ret 0; }
        val bytes: *u8 = note::usize::ptr::*u8;
        if (!buildid.elf_note_header_valid(bytes)) { ret 0; }
        memory.raw_copy(out::ptr, (bytes::usize + buildid.ELF_NOTE_HEADER)::ptr, buildid.DIGEST_LEN);
        ret buildid.DIGEST_LEN;
    }

    test auxiliary_vector_names_the_program_headers {
        val phdr: u64 = auxval(AT_PHDR);
        if (phdr == 0 || auxval(AT_PHNUM) == 0 || auxval(AT_PHENT) != PHDR64_SIZE) { ret 1; }
        if (auxval(6) == 0)                                                        { ret 2; }
        if (auxval(0x7fffffff) != 0)                                               { ret 3; }
        ret 0;
    }
}

$if ($mach.build.os == $mach.os.darwin) {
    use std.system.os.darwin.libsystem;

    val MH_MAGIC_64:   u32 = 0xFEEDFACF;
    val LC_UUID:       u32 = 0x1B;
    val UUID_CMD_SIZE: u32 = 24;

    #[library("libsystem")]
    #[symbol("__dyld_get_image_header")]
    ext fun dyld_get_image_header(index: u32) ptr;

    # LC_UUID from the main executable's mapped header
    fun mapped_build_id(out: *u8) usize {
        val base: ptr = dyld_get_image_header(0);
        if (base == nil) { ret 0; }
        val header: *u8 = base::*u8;
        if (bin.read_u32_le(header, 0) != MH_MAGIC_64) { ret 0; }
        val ncmds:      u32   = bin.read_u32_le(header, 16);
        val sizeofcmds: usize = bin.read_u32_le(header, 20)::usize;
        var off:        usize = 32;
        var c:          u32   = 0;
        for (c < ncmds) {
            if (off + 8 > 32 + sizeofcmds) { ret 0; }
            val cmd:     u32 = bin.read_u32_le(header, off);
            val cmdsize: u32 = bin.read_u32_le(header, off + 4);
            if (cmdsize < 8 || off + cmdsize::usize > 32 + sizeofcmds) { ret 0; }
            if (cmd == LC_UUID && cmdsize == UUID_CMD_SIZE) {
                memory.raw_copy(out::ptr, (header::usize + off + 8)::ptr, buildid.UUID_LEN);
                ret buildid.UUID_LEN;
            }
            off = off + cmdsize::usize;
            c   = c + 1;
        }
        ret 0;
    }

    #[library("libsystem")]
    #[symbol("_proc_pidinfo")]
    ext fun proc_pidinfo(pid: i32, flavor: i32, argument: u64, buffer: ptr, size: i32) i32;

    rec Region {
        protection:               u32;
        maximum_protection:       u32;
        inheritance:              u32;
        flags:                    u32;
        offset:                   u64;
        behavior:                 u32;
        user_wired_count:         u32;
        user_tag:                 u32;
        pages_resident:           u32;
        pages_shared_now_private: u32;
        pages_swapped_out:        u32;
        pages_dirtied:            u32;
        ref_count:                u32;
        shadow_depth:             u32;
        share_mode:               u32;
        private_pages_resident:   u32;
        shared_pages_resident:    u32;
        object_id:                u32;
        depth:                    u32;
        address:                  u64;
        size:                     u64;
    }
    rec VnodeStat {
        device:               u32;
        mode:                 u16;
        links:                u16;
        inode:                u64;
        uid:                  u32;
        gid:                  u32;
        access_seconds:       i64;
        access_nanoseconds:   i64;
        modified_seconds:     i64;
        modified_nanoseconds: i64;
        changed_seconds:      i64;
        changed_nanoseconds:  i64;
        birth_seconds:        i64;
        birth_nanoseconds:    i64;
        size:                 i64;
        blocks:               i64;
        block_size:           i32;
        flags:                u32;
        generation:           u32;
        raw_device:           u32;
        reserved:             [2]i64;
    }
    rec Vnode {
        stat:       VnodeStat;
        kind:       i32;
        padding:    i32;
        filesystem: [2]i32;
    }
    rec RegionPath {
        region: Region;
        vnode:  Vnode;
        path:   [1024]u8;
    }

    #[noinline]
    fun darwin_digest(out: *u8) err[Fault] {
        val address: u64 = darwin_digest::u64;
        var mapped:  RegionPath;
        val count:   i32 = proc_pidinfo(system_os.getpid()::i32, 8, address, (?mapped)::ptr, $size_of(RegionPath)::i32);
        if (count <= 0)                         { ret err[Fault].err{io_failure(system_os.error(0 - libsystem.errno()::i64, io_error.OP_OPTION))}; }
        if (count != $size_of(RegionPath)::i32) { ret err[Fault].err{internal("running compiler vnode response has the wrong size")}; }
        if (!mapped_region_valid(?mapped, address)) {
            ret err[Fault].err{unavailable("running compiler mapping has no complete file identity")};
        }
        val expected: fs.Identity = file_identity.native(file_identity.DARWIN_LOCAL,
            (mapped.vnode.stat.device:~i32)::u64, mapped.vnode.stat.inode);
        ret identified_digest((?mapped.path[0])::str, expected, out);
    }

    fun mapped_region_valid(mapped: *RegionPath, address: u64) bool {
        if (address < mapped.region.address || address - mapped.region.address >= mapped.region.size
            || mapped.vnode.kind != 1 || (mapped.vnode.stat.mode & 0xf000) != 0x8000
            || mapped.path[0] != '/') { ret false; }
        var i: usize = 1;
        for (i < 1024) {
            if (mapped.path[i] == 0) { ret true; }
            i = i + 1;
        }
        ret false;
    }

    test darwin_mapping_layout_and_bounds {
        if ($size_of(Region) != 96 || $size_of(VnodeStat) != 136 || $size_of(Vnode) != 152
            || $size_of(RegionPath) != 1272 || $offset_of(Region, address) != 80
            || $offset_of(RegionPath, vnode) != 96 || $offset_of(RegionPath, path) != 248
            || $offset_of(VnodeStat, inode) != 8) { ret 1; }
        var mapped: RegionPath;
        mapped.region.address  = 100;
        mapped.region.size     = 20;
        mapped.vnode.kind      = 1;
        mapped.vnode.stat.mode = 0x8000;
        mapped.path[0]         = '/';
        mapped.path[1]         = 'x';
        mapped.path[2]         = 0;
        if (!mapped_region_valid(?mapped, 100) || !mapped_region_valid(?mapped, 119)
            || mapped_region_valid(?mapped, 99) || mapped_region_valid(?mapped, 120)) { ret 2; }
        mapped.vnode.kind = 0;
        if (mapped_region_valid(?mapped, 100)) { ret 3; }
        val address: u64 = darwin_digest::u64;
        val count:   i32 = proc_pidinfo(system_os.getpid()::i32, 8, address, (?mapped)::ptr, $size_of(RegionPath)::i32);
        if (count != $size_of(RegionPath)::i32)     { ret 4; }
        if (!mapped_region_valid(?mapped, address)) { ret 5; }
        ret 0;
    }
}

$if ($mach.build.os == $mach.os.windows) {
    use std.types.size.isize;

    #[library("kernel32")]
    ext fun GetModuleHandleW(name: *u16) ptr;
    #[library("kernel32")]
    ext fun GetModuleFileNameW(module: ptr, path: *u16, capacity: u32) u32;
    #[library("kernel32")]
    ext fun K32GetMappedFileNameW(process: isize, address: ptr, path: *u16, capacity: u32) u32;
    #[library("kernel32")]
    ext fun GetFinalPathNameByHandleW(handle: isize, path: *u16, capacity: u32, flags: u32) u32;
    #[library("kernel32")]
    ext fun CreateFileW(path: *u16, access: u32, sharing: u32, security: ptr, disposition: u32, flags: u32, template_file: isize) isize;
    #[library("kernel32")]
    ext fun CloseHandle(handle: isize) i32;
    #[library("kernel32")]
    ext fun GetLastError() u32;
    #[library("kernel32")]
    ext fun GetFileInformationByHandleEx(handle: isize, kind: u32, info: ptr, size: u32) i32;
    #[library("kernel32")]
    ext fun WideCharToMultiByte(codepage: u32, flags: u32, wide: *u16, units: i32, text: *u8, bytes: i32, replacement: *u8, replaced: *i32) i32;

    rec WidePath { data: *u16; capacity: u32; len: u32; }
    rec FileId   { volume: u64; file: [16]u8; }

    val PE32PLUS_MAGIC:              u16   = 0x20B;
    val IMAGE_DIRECTORY_ENTRY_DEBUG: usize = 6;

    # the codeview guid from the running image's mapped headers: dos header,
    # pe signature, the pe32+ optional header's debug data directory, the
    # first codeview entry and the RSDS record it names, every step bounded
    # by SizeOfImage
    fun mapped_build_id(out: *u8) usize {
        val base: ptr = GetModuleHandleW(nil);
        if (base == nil) { ret 0; }
        val image: *u8 = base::*u8;
        if (image[0] != 'M' || image[1] != 'Z') { ret 0; }
        val pe: usize = bin.read_u32_le(image, 0x3C)::usize;
        if (pe < 0x40 || pe > 0x1000)                                                             { ret 0; }
        if (image[pe] != 'P' || image[pe + 1] != 'E' || image[pe + 2] != 0 || image[pe + 3] != 0) { ret 0; }
        val oh: usize = pe + 4 + 20;
        if (bin.read_u16_le(image, oh) != PE32PLUS_MAGIC) { ret 0; }
        val size_of_image: usize = bin.read_u32_le(image, oh + 56)::usize;
        if (bin.read_u32_le(image, oh + 108)::usize <= IMAGE_DIRECTORY_ENTRY_DEBUG) { ret 0; }
        val dd:       usize = oh + 112 + IMAGE_DIRECTORY_ENTRY_DEBUG * 8;
        val dir_rva:  usize = bin.read_u32_le(image, dd)::usize;
        val dir_size: usize = bin.read_u32_le(image, dd + 4)::usize;
        if (dir_rva == 0 || dir_size < buildid.PE_DEBUG_DIR_SIZE || dir_rva > size_of_image || dir_size > size_of_image - dir_rva) { ret 0; }
        var entry: usize = dir_rva;
        val end:   usize = dir_rva + dir_size;
        for (entry + buildid.PE_DEBUG_DIR_SIZE <= end) {
            if (bin.read_u32_le(image, entry + 12) == buildid.PE_DEBUG_TYPE_CODEVIEW) {
                val record_size: usize = bin.read_u32_le(image, entry + 16)::usize;
                val record:      usize = bin.read_u32_le(image, entry + 20)::usize;
                if (record != 0 && record_size >= buildid.PE_CODEVIEW_SIZE && record < size_of_image
                    && record_size <= size_of_image - record
                    && buildid.pe_codeview_valid((image::usize + record)::*u8)) {
                    memory.raw_copy(out::ptr, (image::usize + record + buildid.PE_CODEVIEW_GUID)::ptr, buildid.UUID_LEN);
                    ret buildid.UUID_LEN;
                }
            }
            entry = entry + buildid.PE_DEBUG_DIR_SIZE;
        }
        ret 0;
    }

    fun windows_failure(message: str) Fault {
        val code: u32 = GetLastError();
        if (code == 8 || code == 14 || code == 1450 || code == 1455 || code == 1816 || code == 6 || code == 87) { ret internal(message); }
        ret unavailable(message);
    }

    # kind selects the loader path, mapped nt path, or held file's normalized nt path
    fun windows_path(a: *A.Allocator, kind: u8, image: ptr, held: isize) res[WidePath, Fault] {
        var capacity: u32 = 256;
        for {
            val allocated: res[*u16, A.Error] = A.allocate[u16](a, capacity::usize);
            if (sel allocated.err) { ret res[WidePath, Fault].err{internal(lang_alloc.text(allocated.err))}; }
            val data: *u16 = allocated.ok;
            var len:  u32  = 0;
            if (kind == 0) { len = GetModuleFileNameW(nil, data, capacity); }
            or (kind == 1) { len = K32GetMappedFileNameW(0 - 1, image, data, capacity); }
            or             { len = GetFinalPathNameByHandleW(held, data, capacity, 2); }
            if (len == 0) {
                val failure: Fault = windows_failure("cannot obtain the running compiler file path");
                A.deallocate[u16](a, data, capacity::usize);
                ret res[WidePath, Fault].err{failure};
            }
            if (len < capacity) {
                if (data[len::usize] != 0) {
                    A.deallocate[u16](a, data, capacity::usize);
                    ret res[WidePath, Fault].err{internal("compiler path response has no terminator")};
                }
                ret res[WidePath, Fault].ok{WidePath{data: data, capacity: capacity, len: len}};
            }
            A.deallocate[u16](a, data, capacity::usize);
            if (capacity > 0x3fffffff) { ret res[WidePath, Fault].err{unavailable("compiler path exceeds the native conversion range")}; }
            capacity = capacity * 2;
        }
        ret res[WidePath, Fault].err{internal("compiler path discovery did not finish")};
    }

    fun windows_digest(a: *A.Allocator, out: *u8) err[Fault] {
        val image: ptr = GetModuleHandleW(nil);
        if (image == nil) { ret err[Fault].err{windows_failure("cannot locate the running compiler image")}; }
        val named: res[WidePath, Fault] = windows_path(a, 0, image, 0);
        if (sel named.err) { ret err[Fault].err{named.err}; }
        val path: WidePath = named.ok;
        fin { A.deallocate[u16](a, path.data, path.capacity::usize); }
        # deny write/delete sharing while verifying mapping association and hashing
        val guard: isize = CreateFileW(path.data, 0x80000000, 1, nil, 3, 0x80, 0);
        if (guard == (0 - 1)) { ret err[Fault].err{windows_failure("cannot retain the running compiler file")}; }
        var computed: [32]u8;
        val hashed:   err[Fault] = windows_guarded_digest(a, image, guard, path, ?computed[0]);
        val close_ok: i32        = CloseHandle(guard);
        if (close_ok == 0)  { ret err[Fault].err{internal("cannot close the compiler identity guard")}; }
        if (sel hashed.err) { ret hashed; }
        memory.raw_copy(out::ptr, (?computed[0])::ptr, 32);
        ret err[Fault].ok{};
    }

    fun windows_guarded_digest(a: *A.Allocator, image: ptr, guard: isize, path: WidePath, out: *u8) err[Fault] {
        val mapped_r: res[WidePath, Fault] = windows_path(a, 1, image, guard);
        if (sel mapped_r.err) { ret err[Fault].err{mapped_r.err}; }
        val mapped: WidePath = mapped_r.ok;
        fin { A.deallocate[u16](a, mapped.data, mapped.capacity::usize); }
        val final_r: res[WidePath, Fault] = windows_path(a, 2, image, guard);
        if (sel final_r.err) { ret err[Fault].err{final_r.err}; }
        val final_path: WidePath = final_r.ok;
        fin { A.deallocate[u16](a, final_path.data, final_path.capacity::usize); }
        if (mapped.len != final_path.len || !memory.raw_equal(mapped.data::ptr, final_path.data::ptr, mapped.len::usize * 2)) {
            ret err[Fault].err{unavailable("compiler path no longer names the running image")};
        }
        var native_id: FileId;
        if (GetFileInformationByHandleEx(guard, 18, (?native_id)::ptr, $size_of(FileId)::u32) == 0) {
            ret err[Fault].err{windows_failure("cannot identify the retained compiler file")};
        }
        var expected: fs.Identity = file_identity.native(file_identity.WINDOWS_LOCAL, native_id.volume, 0);
        var i:        usize       = 0;
        for (i < 16) {
            expected.representation[25 + i] = native_id.file[i];
            i                               = i + 1;
        }
        val bytes: i32 = WideCharToMultiByte(65001, 0x80, path.data, path.len::i32, nil, 0, nil, nil);
        if (bytes <= 0) { ret err[Fault].err{windows_failure("cannot encode the compiler path as utf-8")}; }
        val allocated: res[*u8, A.Error] = A.allocate[u8](a, bytes::usize + 1);
        if (sel allocated.err) { ret err[Fault].err{internal(lang_alloc.text(allocated.err))}; }
        val text: *u8 = allocated.ok;
        fin { A.deallocate[u8](a, text, bytes::usize + 1); }
        if (WideCharToMultiByte(65001, 0x80, path.data, path.len::i32, text, bytes, nil, nil) != bytes) {
            ret err[Fault].err{windows_failure("compiler path conversion failed")};
        }
        text[bytes::usize] = 0;
        ret identified_digest(text::str, expected, out);
    }
}

# the sha-256 of the running image's file, read through a handle checked to be
# the file the process maps
pub fun image_digest(alloc: *A.Allocator, out: *u8) err[Fault] {
    $if ($mach.build.os == $mach.os.linux) {
        val opened: res[fs.File, io_error.Error] = fs.open("/proc/self/exe");
        if (sel opened.err) { ret err[Fault].err{io_failure(opened.err)}; }
        var held: fs.File = opened.ok;
        ret finish_owned(?held, out);
    }
    $or ($mach.build.os == $mach.os.darwin)  { ret darwin_digest(out); }
    $or ($mach.build.os == $mach.os.windows) { ret windows_digest(alloc, out); }
    $or                                      { ret err[Fault].err{unavailable("running compiler identity is unavailable on this host")}; }
}

# the build id the linker wrote into the running image, read from its mapped
# headers; 0 when the image carries none (a compiler linked by a seed that
# predates the note) or the host has no reader
pub fun image_build_id(out: *u8) usize {
    $if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin || $mach.build.os == $mach.os.windows) {
        ret mapped_build_id(out);
    }
    $or { ret 0; }
}
