use mach.lang.driver.tests.testing.ut_entry_symbol;
use mach.lang.driver.tests.testing.ut_scaffold;

fun ut_ro_mod_text() str {
    ret "pub fun f0(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 1; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f1(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 2; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f2(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 3; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f3(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 4; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f4(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 5; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f5(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 6; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f6(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 7; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f7(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 8; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f8(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 9; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f9(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 10; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f10(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 11; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f11(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 12; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f12(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 13; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f13(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 14; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f14(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 15; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f15(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 16; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f16(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 17; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f17(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 18; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f18(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 19; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\npub fun f19(x: i32) i32 { var a: i32 = x; var i: i32 = 0; for (i < 12) { a = a * 3 + i * 20; if (a > 1000) { a = a - 997; } i = i + 1; } ret a; }\n";
}

fun ut_ro_main_text(alloc: *A.Allocator) str {
    ret ut_cc3(alloc, "use uniontest.rm0;\nuse uniontest.rm1;\nuse uniontest.rm2;\nuse uniontest.rm3;\nuse uniontest.rm4;\nuse uniontest.rm5;\nuse uniontest.rm6;\nuse uniontest.rm7;\nuse uniontest.rm8;\nuse uniontest.rm9;\nuse uniontest.rm10;\nuse uniontest.rm11;\nuse uniontest.rm12;\nuse uniontest.rm13;\nuse uniontest.rm14;\nuse uniontest.rm15;\n\n#[symbol(\"", ut_entry_symbol(), "\")]\nfun start() i32 {\n    var t: i32 = 1;\n    t = t + rm0.f0(t + 0);\n    t = t + rm1.f1(t + 1);\n    t = t + rm2.f2(t + 2);\n    t = t + rm3.f3(t + 3);\n    t = t + rm4.f4(t + 4);\n    t = t + rm5.f5(t + 5);\n    t = t + rm6.f6(t + 6);\n    t = t + rm7.f7(t + 7);\n    t = t + rm8.f8(t + 8);\n    t = t + rm9.f9(t + 9);\n    t = t + rm10.f10(t + 10);\n    t = t + rm11.f11(t + 11);\n    t = t + rm12.f12(t + 12);\n    t = t + rm13.f13(t + 13);\n    t = t + rm14.f14(t + 14);\n    t = t + rm15.f15(t + 15);\n    ret t;\n}\n");
}

fun ut_ro_files(alloc: *A.Allocator, names: *str, texts: *str) {
    names[0] = "main.mach";
    texts[0] = ut_ro_main_text(alloc);
    val body: str = ut_ro_mod_text();
    names[1]  = "rm0.mach";
    texts[1]  = body;
    names[2]  = "rm1.mach";
    texts[2]  = body;
    names[3]  = "rm2.mach";
    texts[3]  = body;
    names[4]  = "rm3.mach";
    texts[4]  = body;
    names[5]  = "rm4.mach";
    texts[5]  = body;
    names[6]  = "rm5.mach";
    texts[6]  = body;
    names[7]  = "rm6.mach";
    texts[7]  = body;
    names[8]  = "rm7.mach";
    texts[8]  = body;
    names[9]  = "rm8.mach";
    texts[9]  = body;
    names[10] = "rm9.mach";
    texts[10] = body;
    names[11] = "rm10.mach";
    texts[11] = body;
    names[12] = "rm11.mach";
    texts[12] = body;
    names[13] = "rm12.mach";
    texts[13] = body;
    names[14] = "rm13.mach";
    texts[14] = body;
    names[15] = "rm14.mach";
    texts[15] = body;
    names[16] = "rm15.mach";
    texts[16] = body;
}

fun ut_readout_rows_case(jobs: u32) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:                session.Session   = sr.ok;
    val setup_registry_r: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel setup_registry_r.err) {
        session.dnit(?s);
        ret 1;
    }

    var names: [17]str;
    var texts: [17]str;
    ut_ro_files(?alloc, ?names[0], ?texts[0]);

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 17);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.jobs         = jobs;
    val pr_r: res[bplan.BuildPlan, outcome.Fail] = bplan.plan(?alloc, ?s.interner, s.registry, ?m, rq);
    if (sel pr_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var bp: bplan.BuildPlan = pr_r.ok;

    var ev: readout.Progress;
    readout.init(?ev, ?alloc, readout.LEVEL_PHASES);

    val t0: readout.Instant = readout.sample();
    readout.unit_begin(?ev);
    val r:    res[outcome.BuildOutcome, outcome.Fail] = bengine.execute_warm(?bp, 0, ?s, ?alloc, ?ev);
    val wall: cdur.Duration                           = readout.elapsed(t0);

    var bad: i32 = 0;
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        val bo: outcome.BuildOutcome = r.ok;
        if (bo.severity != outcome.BUILD_OK) { bad = 1; }
        if (bo.artifacts.len != 1)           { bad = 1; }
    }

    var phs: [8]u8;
    phs[0] = readout.PH_LOAD;
    phs[1] = readout.PH_RESOLVE;
    phs[2] = readout.PH_SEMA;
    phs[3] = readout.PH_LOWER;
    phs[4] = readout.PH_OPTIMIZE;
    phs[5] = readout.PH_CODEGEN;
    phs[6] = readout.PH_EMIT;
    phs[7] = readout.PH_LINK;

    var sum: cdur.Duration = 0;
    var i:   u32           = 0;
    for (i < 8) {
        val ph: u32                   = phs[i]::u32;
        val pm: *readout.PhaseMetrics = ?ev.metrics[ph];
        if (pm.occurrences != 1)  { bad = 10 + i::i32; }
        if (pm.elapsed <= 0)      { bad = 20 + i::i32; }
        if (pm.item_count == 0)   { bad = 30 + i::i32; }
        if (pm.item_elapsed <= 0) { bad = 40 + i::i32; }
        if (pm.workers == 0)      { bad = 50 + i::i32; }

        if (pm.elapsed * pm.workers::cdur.Duration < pm.item_elapsed) { bad = 60 + i::i32; }

        sum = sum + pm.elapsed;
        i   = i + 1;
    }

    if (ev.other < 0) { bad = 1; }
    val acc: cdur.Duration = sum + ev.other;
    if (acc > wall)     { bad = 70; }
    if (acc * 2 < wall) { bad = 71; }

    readout.dnit(?ev);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.readout:serial_build_rows_are_one_per_phase_and_bound_their_work" {
    ret ut_readout_rows_case(0);
}

test "mach.lang.readout:pooled_build_rows_are_one_per_phase_and_bound_their_work" {
    ret ut_readout_rows_case(4);
}

test "mach.lang.readout:the_monotonic_clock_runs" {
    val t0: readout.Instant = readout.sample();
    if (sel t0.none)                           { ret 1; }
    if (t0.some.sec == 0 && t0.some.nsec == 0) { ret 1; }

    var acc: i64 = 1;
    var i:   i64 = 0;
    for (i < 1000000) {
        acc = (acc * 31 + i) % 1000003;
        i   = i + 1;
    }
    if (acc < 0) { ret 1; }

    if (readout.elapsed(t0) <= 0) { ret 1; }
    ret 0;
}
