# a contained path walk: each component of a path beneath a root is read
# without following a symlink, refused when it is not what the caller expects,
# and made when the caller's policy creates it

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.driver.project;
use mach.lang.fail;
use mach.lang.host;
use A: std.allocator;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_len;

pub val PHYSICAL_REGULAR:   u8 = 1;
pub val PHYSICAL_DIRECTORY: u8 = 2;
pub val PHYSICAL_ENTRY:     u8 = 3;

# what a component walk asks of each step: every component of a validated path
# exists and the last has the expected kind; a contained path may stop at a
# missing component, since nothing beyond it can escape; a created path makes
# each missing directory; an owned path is created in a tree the build owns,
# so a stale file where a directory belongs is removed first. no policy
# follows a symlink
def WalkPolicy: u8;

val WALK_VALIDATE:  WalkPolicy = 0;
val WALK_CONTAINED: WalkPolicy = 1;
val WALK_CREATE:    WalkPolicy = 2;
val WALK_OWNED:     WalkPolicy = 3;

# a policy's diagnostics: each names the label, the path and the component
# prefix, and inspect, enter and make add the native detail
rec WalkText {
    inspect: str;
    symlink: str;
    nondir:  str;
    enter:   str;
    invalid: str;
    make:    str;
    replace: str;
}

val WALK_TEXT: [4]WalkText = [4]WalkText{
    WalkText{
        inspect: "{} '{}' does not exist or cannot be inspected at '{}': {}",
        symlink: "{} '{}' cannot traverse symlink component '{}'",
        nondir:  "{} '{}' has non-directory intermediate component '{}'",
        enter:   "{} '{}' cannot open intermediate directory '{}': {}",
        invalid: "{} '{}' opened an invalid intermediate directory '{}'",
        make:    nil,
        replace: nil
    },
    WalkText{
        inspect: "{} '{}' cannot inspect ancestor '{}': {}",
        symlink: "{} '{}' cannot traverse non-directory ancestor '{}'",
        nondir:  "{} '{}' cannot traverse non-directory ancestor '{}'",
        enter:   "{} '{}' cannot open ancestor '{}': {}",
        invalid: "{} '{}' opened an invalid ancestor '{}'",
        make:    nil,
        replace: nil
    },
    WalkText{
        inspect: "{} '{}' cannot inspect directory '{}': {}",
        symlink: "{} '{}' cannot use non-directory or symlink component '{}'",
        nondir:  "{} '{}' cannot use non-directory or symlink component '{}'",
        enter:   "{} '{}' cannot open directory component '{}': {}",
        invalid: "{} '{}' opened an invalid directory component '{}'",
        make:    "{} '{}' cannot create directory '{}': {}",
        replace: nil
    },
    WalkText{
        inspect: "{} '{}' cannot inspect directory '{}': {}",
        symlink: "{} '{}' cannot use symlink component '{}'",
        nondir:  "{} '{}' cannot use non-directory component '{}'",
        enter:   "{} '{}' cannot open directory component '{}': {}",
        invalid: "{} '{}' opened an invalid directory component '{}'",
        make:    "{} '{}' cannot create directory '{}': {}",
        replace: "{} '{}' cannot replace stale file '{}': {}"
    },
};

fun walk_fail(f: fail.Fail) err[fail.Fail] {
    ret err[fail.Fail].err{f};
}

fun kind_expected(kind: host.ProbeKind, expected: u8) bool {
    if (expected == PHYSICAL_REGULAR)   { ret kind == host.PROBE_FILE; }
    if (expected == PHYSICAL_DIRECTORY) { ret kind == host.PROBE_DIR; }
    ret kind == host.PROBE_FILE || kind == host.PROBE_DIR;
}

# the path `.` names the root itself, as the host reads it
fun walk_root(c: *host.Cursor, text: *WalkText, policy: WalkPolicy, expected: u8, label: str, rel: str) err[fail.Fail] {
    val probed: host.Probe = host.cursor_root(c);
    if (probed.kind == host.PROBE_ABSENT || probed.kind == host.PROBE_FAILED) {
        ret walk_fail(fail.formatted_user(c.alloc, diagnostic_kind.PATH_INACCESSIBLE, text.inspect, label, rel, rel, probed.detail));
    }
    if (probed.kind == host.PROBE_LINK) { ret walk_fail(fail.formatted_user(c.alloc, diagnostic_kind.PATH_SYMLINK, text.symlink, label, rel, rel)); }
    val kind: host.ProbeKind = probed.kind;
    if (policy == WALK_VALIDATE && !kind_expected(kind, expected)) {
        ret walk_fail(fail.formatted_user(c.alloc, diagnostic_kind.PATH_ENTRY_TYPE, "{} '{}' has the wrong filesystem entry type", label, rel));
    }
    if (kind != host.PROBE_DIR) { ret walk_fail(fail.formatted_user(c.alloc, diagnostic_kind.PATH_ENTRY_TYPE, text.nondir, label, rel, rel)); }
    ret err[fail.Fail].ok{};
}

# the component as found, or as made when the policy creates a missing one
fun walk_probe(c: *host.Cursor, text: *WalkText, policy: WalkPolicy, label: str, rel: str,
    component: str, prefix: str) res[host.Probe, fail.Fail] {
    val found: res[host.Probe, fail.Fail] = host.cursor_probe(c, component, prefix);
    if (sel found.err) { ret found; }
    var kind: host.ProbeKind = found.ok.kind;
    if (policy == WALK_OWNED && (kind == host.PROBE_FILE || kind == host.PROBE_OTHER)) {
        val removed: opt[str] = host.cursor_unlink(c, component, prefix);
        if (sel removed.some) { ret res[host.Probe, fail.Fail].err{fail.formatted_user(c.alloc, diagnostic_kind.PATH_CREATE, text.replace, label, rel, prefix, removed.some)}; }
        kind = host.PROBE_ABSENT;
    }
    if (kind != host.PROBE_ABSENT || (policy != WALK_CREATE && policy != WALK_OWNED)) { ret found; }
    val made: opt[str] = host.cursor_make(c, component, prefix);
    if (sel made.some) { ret res[host.Probe, fail.Fail].err{fail.formatted_user(c.alloc, diagnostic_kind.PATH_CREATE, text.make, label, rel, prefix, made.some)}; }
    ret host.cursor_probe(c, component, prefix);
}

# one component under the policy; ok{false} ends a contained walk at a missing component
fun walk_step(c: *host.Cursor, policy: WalkPolicy, expected: u8, label: str, rel: str,
    component: str, prefix: str, last: bool) res[bool, fail.Fail] {
    val text:     *WalkText                  = ?WALK_TEXT[policy::usize];
    val probed_r: res[host.Probe, fail.Fail] = walk_probe(c, text, policy, label, rel, component, prefix);
    if (sel probed_r.err) { ret res[bool, fail.Fail].err{probed_r.err}; }
    val probed: host.Probe = probed_r.ok;
    if (probed.kind == host.PROBE_ABSENT && policy == WALK_CONTAINED) { ret res[bool, fail.Fail].ok{false}; }
    if (probed.kind == host.PROBE_ABSENT || probed.kind == host.PROBE_FAILED) {
        ret res[bool, fail.Fail].err{fail.formatted_user(c.alloc, diagnostic_kind.PATH_INACCESSIBLE, text.inspect, label, rel, prefix, probed.detail)};
    }
    if (probed.kind == host.PROBE_LINK) { ret res[bool, fail.Fail].err{fail.formatted_user(c.alloc, diagnostic_kind.PATH_SYMLINK, text.symlink, label, rel, prefix)}; }
    if (last && policy == WALK_VALIDATE) {
        if (!kind_expected(probed.kind, expected)) {
            ret res[bool, fail.Fail].err{fail.formatted_user(c.alloc, diagnostic_kind.PATH_ENTRY_TYPE, "{} '{}' has the wrong filesystem entry type at '{}'", label, rel, prefix)};
        }
        ret res[bool, fail.Fail].ok{true};
    }
    if (probed.kind != host.PROBE_DIR) { ret res[bool, fail.Fail].err{fail.formatted_user(c.alloc, diagnostic_kind.PATH_ENTRY_TYPE, text.nondir, label, rel, prefix)}; }
    val entered: err[fail.Fail] = host.cursor_enter(c, text.enter, text.invalid, label, rel, component, prefix);
    if (sel entered.err) { ret res[bool, fail.Fail].err{entered.err}; }
    ret res[bool, fail.Fail].ok{true};
}

# the one walk behind every physical-path check: `rel` beneath `root`, one
# component at a time, never following a symlink
fun walk_components(alloc: *A.Allocator, root: str, rel: str, policy: WalkPolicy, expected: u8, label: str) err[fail.Fail] {
    var c:      host.Cursor;
    val opened: err[fail.Fail] = host.cursor_open(?c, alloc, root, label);
    if (sel opened.err) { ret opened; }
    var result: err[fail.Fail] = err[fail.Fail].ok{};
    val n:      usize          = str_len(rel);
    if (str_equals(rel, "."))              { result = walk_root(?c, ?WALK_TEXT[policy::usize], policy, expected, label, rel); }
    or (n == 0 && policy == WALK_VALIDATE) { result = walk_fail(fail.formatted_user(alloc, diagnostic_kind.PATH_NOT_CANONICAL, "{} '{}' is empty", label, rel)); }
    var start: usize = 0;
    for (!str_equals(rel, ".") && start < n) {
        var end: usize = start;
        for (end < n && rel[end] != '/'::u8) { end = end + 1; }
        if (end == start) {
            result = walk_fail(fail.formatted_user(alloc, diagnostic_kind.PATH_NOT_CANONICAL, "{} '{}' is not a canonical project path", label, rel));
            brk;
        }
        val prefix_r: res[str, types_string.StrError] = str_copy_slice(alloc, rel, 0, end);
        if (sel prefix_r.err) {
            result = err[fail.Fail].err{fail.message(fail.str_text(prefix_r.err))};
            brk;
        }
        val prefix: str = prefix_r.ok;
        fin { str_free(alloc, prefix); }
        val component_r: res[str, types_string.StrError] = str_copy_slice(alloc, rel, start, end - start);
        if (sel component_r.err) {
            result = err[fail.Fail].err{fail.message(fail.str_text(component_r.err))};
            brk;
        }
        val component: str = component_r.ok;
        fin { str_free(alloc, component); }
        val stepped: res[bool, fail.Fail] = walk_step(?c, policy, expected, label, rel, component, prefix, end == n);
        if (sel stepped.err) {
            result = err[fail.Fail].err{stepped.err};
            brk;
        }
        if (!stepped.ok) { brk; }
        start = end + 1;
    }
    val closed: err[fail.Fail] = host.cursor_close(?c);
    if (sel result.err) { ret result; }
    ret closed;
}

pub fun path_check(alloc: *A.Allocator, root: str, rel: str, expected: u8, label: str) err[fail.Fail] {
    ret walk_components(alloc, root, rel, WALK_VALIDATE, expected, label);
}

pub fun ancestors_check(alloc: *A.Allocator, root: str, rel: str, label: str) err[fail.Fail] {
    if (str_empty(rel)) { ret err[fail.Fail].ok{}; }
    ret walk_components(alloc, root, rel, WALK_CONTAINED, PHYSICAL_DIRECTORY, label);
}

pub fun directory_ensure(alloc: *A.Allocator, root: str, rel: str, label: str) err[fail.Fail] {
    ret walk_components(alloc, root, rel, WALK_CREATE, PHYSICAL_DIRECTORY, label);
}

# as `directory_ensure`, in output layout the build owns
pub fun owned_directory_ensure(alloc: *A.Allocator, root: str, rel: str, label: str) err[fail.Fail] {
    ret walk_components(alloc, root, rel, WALK_OWNED, PHYSICAL_DIRECTORY, label);
}
