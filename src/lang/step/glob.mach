# the input patterns a build step names: a wildcard over one directory, or one
# recursive `**` segment, expanded beneath the project without following a link

use diagnostic_kind: mach.lang.diagnostic.kind;
use driver_load:     mach.lang.driver.load;
use mach.lang.fail;
use step_walk: mach.lang.step.walk;
use A:         std.allocator;
use std.allocator.page;
use collections_vector: std.collections.vector;
use fs:                 std.filesystem;
use io_error:           std.io.error;
use system_os:          std.system.os;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_copy_slice;
use std.types.string.str_empty;
use std.types.string.str_len;

pub fun wildcard_match(pat: str, name: str) bool {
    val pn:   usize = str_len(pat);
    val nn:   usize = str_len(name);
    var pi:   usize = 0;
    var ni:   usize = 0;
    var star: i64   = -1;
    var mark: usize = 0;
    for (ni < nn) {
        if (pi < pn && pat[pi] == '*'::u8) {
            star = pi::i64;
            mark = ni;
            pi   = pi + 1;
        }
        or (pi < pn && pat[pi] == name[ni]) {
            pi = pi + 1;
            ni = ni + 1;
        }
        or (star >= 0) {
            pi   = (star::usize) + 1;
            mark = mark + 1;
            ni   = mark;
        }
        or { ret false; }
    }
    for (pi < pn && pat[pi] == '*'::u8) { pi = pi + 1; }
    ret pi == pn;
}

fun visit(alloc: *A.Allocator, root: str, base_rel: str, name: str, pat: str, recursive: bool, out: *collections_vector.Vector[str]) err[fail.Fail] {
    val child_rel_r: res[str, fail.Fail] = driver_load.join_path(alloc, base_rel, name);
    if (sel child_rel_r.err) { ret err[fail.Fail].err{child_rel_r.err}; }
    val child_rel: str  = child_rel_r.ok;
    var kept:      bool = false;
    fin {
        if (!kept) { str_free(alloc, child_rel); }
    }

    val child_abs_r: res[str, A.Error] = types_path.resolve(alloc, root, child_rel);
    if (sel child_abs_r.err) { ret err[fail.Fail].err{fail.refused(child_abs_r.err)}; }
    val child_abs: str                              = child_abs_r.ok;
    val fi_r:      res[fs.Metadata, io_error.Error] = fs.metadata_link(child_abs);
    str_free(alloc, child_abs);
    if (sel fi_r.err) {
        val msg: fail.Fail = fail.formatted_user(alloc, diagnostic_kind.GLOB_INACCESSIBLE, "failed to inspect build step glob entry '{}': {}", child_rel, fail.io_text(fi_r.err));
        ret err[fail.Fail].err{msg};
    }
    val fi: fs.Metadata = fi_r.ok;

    if (fs.meta_is_symlink(?fi)) {
        val msg: fail.Fail = fail.formatted_user(alloc, diagnostic_kind.GLOB_SYMLINK, "build step input glob cannot traverse symlink '{}'", child_rel);
        ret err[fail.Fail].err{msg};
    }

    if (fs.meta_is_dir(?fi) && recursive && name[0] == '.'::u8)                                 { ret err[fail.Fail].ok{}; }
    or (fs.meta_is_dir(?fi) && recursive)                                                       { ret walk(alloc, root, child_rel, pat, recursive, out); }
    or (fs.meta_is_file(?fi) && name[0] == '.'::u8 && !(str_len(pat) > 0 && pat[0] == '.'::u8)) { ret err[fail.Fail].ok{}; }
    or (fs.meta_is_file(?fi) && wildcard_match(pat, name)) {
        val pr: res[usize, A.Error] = collections_vector.push[str](out, child_rel);
        if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
        kept = true;
        ret err[fail.Fail].ok{};
    }
    or (!fs.meta_is_dir(?fi) && !fs.meta_is_file(?fi)) {
        val msg: fail.Fail = fail.formatted_user(alloc, diagnostic_kind.GLOB_SPECIAL_ENTRY, "build step input glob cannot use special entry '{}'", child_rel);
        ret err[fail.Fail].err{msg};
    }
    ret err[fail.Fail].ok{};
}

fun dot_entry(name: *u8) bool {
    if (name[0] != '.'::u8) { ret false; }
    if (name[1] == 0)       { ret true; }
    ret name[1] == '.'::u8 && name[2] == 0;
}

fun walk(alloc: *A.Allocator, root: str, base_rel: str, pat: str, recursive: bool, out: *collections_vector.Vector[str]) err[fail.Fail] {
    val physical_r: err[fail.Fail] = step_walk.path_check(alloc, root, base_rel, step_walk.PHYSICAL_DIRECTORY, "build step input glob directory");
    if (sel physical_r.err) { ret err[fail.Fail].err{physical_r.err}; }
    val dir_abs_r: res[str, A.Error] = types_path.resolve(alloc, root, base_rel);
    if (sel dir_abs_r.err) { ret err[fail.Fail].err{fail.refused(dir_abs_r.err)}; }
    val dir_abs: str = dir_abs_r.ok;
    fin { str_free(alloc, dir_abs); }

    var fd:     usize = system_os.INVALID_HANDLE;
    val fd_raw: i64   = system_os.open(system_os.working_dir(), dir_abs, system_os.O_RDONLY | system_os.O_DIRECTORY, 0, ?fd);
    if (fd_raw < 0) {
        val msg: fail.Fail = fail.formatted_user(alloc, diagnostic_kind.GLOB_INACCESSIBLE, "failed to open build step glob directory '{}': {}", dir_abs, system_os.error_message(fd_raw));
        ret err[fail.Fail].err{msg};
    }

    var cursor: system_os.DirectoryCursor     = system_os.DirectoryCursor{};
    val opened: system_os.DirectoryInitResult = system_os.directory_init(?cursor, fd);
    if (opened.code < 0) {
        system_os.close(fd);
        ret err[fail.Fail].err{fail.user(diagnostic_kind.GLOB_INACCESSIBLE, system_os.error_message(opened.code))};
    }
    var result:  err[fail.Fail] = err[fail.Fail].ok{};
    var reading: bool           = true;
    for (reading) {
        var entry: system_os.DirectoryEntry;
        val nread: i64 = system_os.directory_next(?cursor, ?entry);
        if (nread < 0) {
            result  = err[fail.Fail].err{fail.user(diagnostic_kind.GLOB_INACCESSIBLE, system_os.error_message(nread))};
            reading = false;
        }
        or (nread == 0) { reading = false; }
        or (!dot_entry(entry.name::*u8)) {
            val rr: err[fail.Fail] = visit(alloc, root, base_rel, entry.name, pat, recursive, out);
            if (sel rr.err) {
                result  = rr;
                reading = false;
            }
        }
    }
    val cursor_r:  i64  = system_os.directory_close(?cursor);
    val result_ok: bool = sel result.ok && cursor_r < 0;
    if (result_ok) {
        result = err[fail.Fail].err{fail.user(diagnostic_kind.GLOB_INACCESSIBLE, system_os.error_message(cursor_r))};
    }
    val close_r:    i64  = system_os.close(fd);
    val result_ok2: bool = sel result.ok && close_r < 0;
    if (result_ok2) {
        result = err[fail.Fail].err{fail.user(diagnostic_kind.GLOB_INACCESSIBLE, system_os.error_message(close_r))};
    }
    ret result;
}

pub fun shape_ok(pattern: str) bool {
    val n:           usize = str_len(pattern);
    var final_start: usize = 0;
    var j:           usize = 0;
    for (j < n) {
        if (pattern[j] == '/'::u8) { final_start = j + 1; }
        j = j + 1;
    }

    var dstar: u32   = 0;
    var i:     usize = 0;
    for (i < final_start) {
        var seg_end: usize = i;
        for (seg_end < n && pattern[seg_end] != '/'::u8) { seg_end = seg_end + 1; }
        val slen: usize = seg_end - i;
        if (slen > 0) {
            if (slen == 2 && pattern[i] == '*'::u8 && pattern[i + 1] == '*'::u8) { dstar = dstar + 1; }
            or {
                var k: usize = i;
                for (k < seg_end) {
                    if (pattern[k] == '*'::u8) { ret false; }
                    k = k + 1;
                }
            }
        }
        i = seg_end + 1;
    }
    if (dstar > 1) { ret false; }

    var f:         usize = final_start;
    var prev_star: bool  = false;
    for (f < n) {
        if (pattern[f] == '*'::u8) {
            if (prev_star) { ret false; }
            prev_star = true;
        }
        or { prev_star = false; }
        f = f + 1;
    }
    ret true;
}

pub fun expand(alloc: *A.Allocator, project_root: str, pattern: str, out: *collections_vector.Vector[str]) err[fail.Fail] {
    val n:     usize = str_len(pattern);
    var star2: i64   = -1;
    var i:     usize = 0;
    for (i + 1 < n && star2 < 0) {
        if (pattern[i] == '*'::u8 && pattern[i + 1] == '*'::u8) { star2 = i::i64; }
        i = i + 1;
    }

    if (star2 >= 0) {
        val sp:       usize = star2::usize;
        var base_end: usize = sp;
        if (base_end > 0 && pattern[base_end - 1] == '/'::u8) { base_end = base_end - 1; }
        val base_r: res[str, types_string.StrError] = str_copy_slice(alloc, pattern, 0, base_end);
        if (sel base_r.err) { ret err[fail.Fail].err{fail.message(fail.str_text(base_r.err))}; }
        val base: str = base_r.ok;
        fin { str_free(alloc, base); }
        var pat_start: usize = sp + 2;
        if (pat_start < n && pattern[pat_start] == '/'::u8) { pat_start = pat_start + 1; }
        val pat_r: res[str, types_string.StrError] = str_copy_slice(alloc, pattern, pat_start, n - pat_start);
        if (sel pat_r.err) { ret err[fail.Fail].err{fail.message(fail.str_text(pat_r.err))}; }
        val pat: str = pat_r.ok;
        fin { str_free(alloc, pat); }
        var base_use: str = base;
        if (str_empty(base)) { base_use = "."; }
        ret walk(alloc, project_root, base_use, pat, true, out);
    }

    var last: i64 = -1;
    i = 0;
    for (i < n) {
        if (pattern[i] == '/'::u8) { last = i::i64; }
        i = i + 1;
    }
    if (last < 0) { ret walk(alloc, project_root, ".", pattern, false, out); }
    val dir_r: res[str, types_string.StrError] = str_copy_slice(alloc, pattern, 0, last::usize);
    if (sel dir_r.err) { ret err[fail.Fail].err{fail.message(fail.str_text(dir_r.err))}; }
    val dir: str = dir_r.ok;
    fin { str_free(alloc, dir); }
    val pat_r: res[str, types_string.StrError] = str_copy_slice(alloc, pattern, (last::usize) + 1, n - ((last::usize) + 1));
    if (sel pat_r.err) { ret err[fail.Fail].err{fail.message(fail.str_text(pat_r.err))}; }
    val pat: str = pat_r.ok;
    fin { str_free(alloc, pat); }
    ret walk(alloc, project_root, dir, pat, false, out);
}

test glob__dot_names_errors_and_symlinks {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach_step_glob");
    if (sel tf_r.err) { ret 1; }
    var tf:     fs.TempFile       = tf_r.ok;
    val root_r: res[str, A.Error] = str_dup(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { str_free(?alloc, root); }
    val create_dir_r: err[io_error.Error] = fs.create_dir(root, 0o700);
    if (sel create_dir_r.err) { ret 1; }
    fin { fs.remove_all(?alloc, root); }

    val hidden:         str             = step_walk.sfmt(?alloc, "{}/.hidden", root);
    val visible:        str             = step_walk.sfmt(?alloc, "{}/visible", root);
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(hidden, "h", 1, 0o600);
    val write_bytes_r:  err[fs.FsError] = fs.write_bytes(visible, "v", 1, 0o600);
    if (sel write_bytes_r2.err) { ret 1; }
    if (sel write_bytes_r.err)  { ret 1; }

    var matches: collections_vector.Vector[str] = collections_vector.init[str](?alloc);
    val dot_r:   err[fail.Fail]                 = expand(?alloc, root, ".*", ?matches);
    var bad:     bool                           = sel dot_r.err || matches.len != 1;
    if (!bad && !str_contains(matches.data[0], ".hidden")) { bad = true; }
    t_matches_free(?alloc, ?matches);

    var missing:   collections_vector.Vector[str] = collections_vector.init[str](?alloc);
    val missing_r: err[fail.Fail]                 = expand(?alloc, root, "missing/*.c", ?missing);
    if (!(sel missing_r.err && str_contains(fail.describe(missing_r.err), "does not exist"))) { bad = true; }
    t_matches_free(?alloc, ?missing);

    val link:      str                 = step_walk.sfmt(?alloc, "{}/link", root);
    val symlink_r: err[io_error.Error] = fs.symlink(hidden, link);
    if (sel symlink_r.err) { bad = true; }
    if (sel symlink_r.ok) {
        var linked:   collections_vector.Vector[str] = collections_vector.init[str](?alloc);
        val linked_r: err[fail.Fail]                 = expand(?alloc, root, "*", ?linked);
        if (!(sel linked_r.err && str_contains(fail.describe(linked_r.err), "symlink"))) { bad = true; }
        t_matches_free(?alloc, ?linked);
    }

    val real:           str                 = step_walk.sfmt(?alloc, "{}/real", root);
    val real_file:      str                 = step_walk.sfmt(?alloc, "{}/real/input.c", root);
    val jump:           str                 = step_walk.sfmt(?alloc, "{}/jump", root);
    val create_dir_r2:  err[io_error.Error] = fs.create_dir(real, 0o700);
    val write_bytes_r3: err[fs.FsError]     = fs.write_bytes(real_file, "c", 1, 0o600);
    val symlink_r2:     err[io_error.Error] = fs.symlink(real, jump);
    if (sel create_dir_r2.err || sel write_bytes_r3.err || sel symlink_r2.err) { bad = true; }
    or {
        var escaped:   collections_vector.Vector[str] = collections_vector.init[str](?alloc);
        val escaped_r: err[fail.Fail]                 = expand(?alloc, root, "jump/*.c", ?escaped);
        if (!(sel escaped_r.err && str_contains(fail.describe(escaped_r.err), "symlink component"))) { bad = true; }
        t_matches_free(?alloc, ?escaped);
    }

    val plain_ok: err[fail.Fail] = step_walk.path_check(?alloc, root, "visible", step_walk.PHYSICAL_REGULAR, "build step input");
    if (sel plain_ok.err) { bad = true; }
    val plain_dir: err[fail.Fail] = step_walk.path_check(?alloc, root, "real", step_walk.PHYSICAL_REGULAR, "build step input");
    if (sel plain_dir.ok) { bad = true; }

    str_free(?alloc, jump);
    str_free(?alloc, real_file);
    str_free(?alloc, real);
    str_free(?alloc, link);
    str_free(?alloc, hidden);
    str_free(?alloc, visible);
    if (bad) { ret 1; }
    ret 0;
}

test glob__implicit_pattern_skips_hidden_file_and_hidden_directory {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach_step_glob_implicit");
    if (sel tf_r.err) { ret 1; }
    var tf:     fs.TempFile       = tf_r.ok;
    val root_r: res[str, A.Error] = str_dup(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { str_free(?alloc, root); }
    val create_dir_r: err[io_error.Error] = fs.create_dir(root, 0o700);
    if (sel create_dir_r.err) { ret 1; }
    fin { fs.remove_all(?alloc, root); }

    val hidden_file:    str                 = step_walk.sfmt(?alloc, "{}/.hidden.c", root);
    val visible_file:   str                 = step_walk.sfmt(?alloc, "{}/visible.c", root);
    val hidden_dir:     str                 = step_walk.sfmt(?alloc, "{}/.hidden_dir", root);
    val nested_file:    str                 = step_walk.sfmt(?alloc, "{}/.hidden_dir/nested.c", root);
    var bad:            bool                = false;
    val write_bytes_r3: err[fs.FsError]     = fs.write_bytes(hidden_file, "h", 1, 0o600);
    val write_bytes_r2: err[fs.FsError]     = fs.write_bytes(visible_file, "v", 1, 0o600);
    val create_dir_r2:  err[io_error.Error] = fs.create_dir(hidden_dir, 0o700);
    val write_bytes_r:  err[fs.FsError]     = fs.write_bytes(nested_file, "n", 1, 0o600);
    if (sel write_bytes_r3.err
        || sel write_bytes_r2.err
        || sel create_dir_r2.err
        || sel write_bytes_r.err) { bad = true; }

    var top:   collections_vector.Vector[str] = collections_vector.init[str](?alloc);
    val top_r: err[fail.Fail]                 = expand(?alloc, root, "*.c", ?top);
    if (sel top_r.err || top.len != 1)                   { bad = true; }
    if (!bad && !str_contains(top.data[0], "visible.c")) { bad = true; }
    if (!bad && str_contains(top.data[0], "hidden"))     { bad = true; }
    t_matches_free(?alloc, ?top);

    var deep:   collections_vector.Vector[str] = collections_vector.init[str](?alloc);
    val deep_r: err[fail.Fail]                 = expand(?alloc, root, "**/*.c", ?deep);
    if (sel deep_r.err || deep.len != 1)                  { bad = true; }
    if (!bad && !str_contains(deep.data[0], "visible.c")) { bad = true; }
    t_matches_free(?alloc, ?deep);

    str_free(?alloc, nested_file);
    str_free(?alloc, hidden_dir);
    str_free(?alloc, visible_file);
    str_free(?alloc, hidden_file);
    if (bad) { ret 1; }
    ret 0;
}

#[testing]
fun t_matches_free(alloc: *A.Allocator, v: *collections_vector.Vector[str]) {
    var i: usize = 0;
    for (i < v.len) {
        str_free(alloc, v.data[i]);
        i = i + 1;
    }
    collections_vector.dnit[str](v);
}
