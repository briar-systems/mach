# the layout the front end computes agrees with the one lowering emits
use A: std.allocator;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use mach.lang.driver;
use mach.lang.driver.project;
use mach.lang.fail;
use mach.lang.intern;
use me_ir:   mach.lang.me.ir;
use ir_type: mach.lang.me.ir.type;
use mach.lang.module;
use mach.lang.session;
use lang_target: mach.lang.target;
use mach.lang.target.resolved;
use mach.lang.toolchain;

use mach.lang.driver.tests.testing.ut_build;
use mach.lang.driver.tests.testing.ut_mid;
use mach.lang.driver.tests.testing.ut_sema_extent_is;

#[testing]
fun t_ir_param_extent_is(
    s: *session.Session,
    m: *me_ir.Module,
    tgt: *lang_target.Binding,
    symbol: str,
    param: u32,
    size: u32,
    align: u32) bool {
    val nr: res[intern.StrId, A.Error] = intern.add(?s.interner, symbol);
    if (sel nr.err) { ret false; }
    val fi: opt[u32] = me_ir.function_lookup(m, nr.ok);
    if (sel fi.none) { ret false; }
    val f:  *me_ir.Function      = ?m.functions[fi.some];
    val st: opt[*ir_type.IrType] = ir_type.get(?m.types, f.sig);
    if (sel st.none) { ret false; }
    val sig: *ir_type.IrType = st.some;
    if (sig.kind != ir_type.IRT_FN || param >= sig.data.fn.param_count) { ret false; }
    val ty: ir_type.IrTypeId = sig.data.fn.params[param];
    ret ir_type.byte_size_for_machine(?m.types, ty, resolved.layout_machine(?tgt.target)) == size
        && ir_type.byte_align_for_machine(?m.types, ty, resolved.layout_machine(?tgt.target)) == align;
}

test layout__sema_extent_matches_lowering {
    var bad: i32 = 0;

    if (ut_sema_extent_is("rec R { a: u8; }\nfun main() i32 { ret 0; }\n", "R", 1, 1) != 0)                                  { bad = 1; }
    if (ut_sema_extent_is("rec R { a: u8; b: u32; }\nfun main() i32 { ret 0; }\n", "R", 8, 4) != 0)                          { bad = 1; }
    if (ut_sema_extent_is("rec R { a: u32; b: u8; }\nfun main() i32 { ret 0; }\n", "R", 8, 4) != 0)                          { bad = 1; }
    if (ut_sema_extent_is("rec R { a: u8; b: u64; }\nfun main() i32 { ret 0; }\n", "R", 16, 8) != 0)                         { bad = 1; }
    if (ut_sema_extent_is("rec I { a: u8; b: u32; }\nrec R { x: I; y: u8; }\nfun main() i32 { ret 0; }\n", "R", 12, 4) != 0) { bad = 1; }
    if (ut_sema_extent_is("rec R { a: [3]u16; b: u8; }\nfun main() i32 { ret 0; }\n", "R", 8, 2) != 0)                       { bad = 1; }
    if (ut_sema_extent_is("uni U { a: u8; b: u32; }\nfun main() i32 { ret 0; }\n", "U", 4, 4) != 0)                          { bad = 1; }
    if (ut_sema_extent_is("rec R { a: *u8; b: u8; }\nfun main() i32 { ret 0; }\n", "R", 16, 8) != 0)                         { bad = 1; }
    if (ut_sema_extent_is("#[align(16)]\nrec R { a: u32; }\nfun main() i32 { ret 0; }\n", "R", 16, 16) != 0)                 { bad = 1; }
    if (ut_sema_extent_is("rec R { a: ^u8; b: ^u32; }\nfun main() i32 { ret 0; }\n", "R", 8, 4) != 0)                        { bad = 1; }

    if (ut_sema_extent_is("uni G[T] { a: T; b: u8; }\nfun f(g: G[u64]) i32 { ret 0; }\nfun main() i32 { ret 0; }\n", "G", 8, 8) != 0)  { bad = 1; }
    if (ut_sema_extent_is("uni G[T] { a: T; b: T; }\nfun f(g: G[u32]) i32 { ret 0; }\nfun main() i32 { ret 0; }\n", "G", 4, 4) != 0)   { bad = 1; }
    if (ut_sema_extent_is("rec P[T] { a: T; b: u8; }\nfun f(p: P[u64]) i32 { ret 0; }\nfun main() i32 { ret 0; }\n", "P", 16, 8) != 0) { bad = 1; }

    val probe: str = "rec R1 { a: u8; }\nrec R2 { a: u8; b: u32; }\nrec R3 { a: u32; b: u8; }\nrec R4 { a: u8; b: u64; }\nrec I  { a: u8; b: u32; }\nrec R5 { x: I; y: u8; }\nrec R6 { a: [3]u16; b: u8; }\nuni U1 { a: u8; b: u32; }\nrec R7 { a: *u8; b: u8; }\n#[align(16)]\nrec R8 { a: u32; }\nrec R9 { a: ^u8; b: ^u32; }\nuni G1[T] { a: T; b: u8; }\nrec P1[T] { a: T; b: u8; }\n#[symbol(\"layout_probe\")]\nfun layout_probe(r1: R1, r2: R2, r3: R3, r4: R4, r5: R5, r6: R6, u1: U1, r7: R7, r8: R8, r9: R9, g64: G1[u64], g32: G1[u32], p64: P1[u64]) { }\nfun main() i32 { ret 0; }\n";

    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = probe;
    val pr: res[project.Project, fail.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p:                project.Project = pr.ok;
    val run_sema_pass_r:  err[fail.Fail]  = driver.run_sema_pass(?p);
    val run_lower_pass_r: err[fail.Fail]  = driver.run_lower_pass(?p);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    if (sel run_lower_pass_r.err) {
        project.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (module.is_nil(mid) || project.module_at(?p, mid::u32).ir_module == nil) { bad = 1; }
    or {
        val m: *me_ir.Module = project.module_at(?p, mid::u32).ir_module;
        if (!t_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 0, 1, 1))   { bad = 1; }
        if (!t_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 1, 8, 4))   { bad = 1; }
        if (!t_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 2, 8, 4))   { bad = 1; }
        if (!t_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 3, 16, 8))  { bad = 1; }
        if (!t_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 4, 12, 4))  { bad = 1; }
        if (!t_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 5, 8, 2))   { bad = 1; }
        if (!t_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 6, 4, 4))   { bad = 1; }
        if (!t_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 7, 16, 8))  { bad = 1; }
        if (!t_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 8, 16, 16)) { bad = 1; }
        if (!t_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 9, 8, 4))   { bad = 1; }
        if (!t_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 10, 8, 8))  { bad = 1; }
        if (!t_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 11, 4, 4))  { bad = 1; }
        if (!t_ir_param_extent_is(?s, m, ?p.target, "layout_probe", 12, 16, 8)) { bad = 1; }
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}
