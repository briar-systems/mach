# a project written for the previous major, rewritten into this one's spelling,
# which `mach migrate` applies
#
# every rule is data its owner already holds: a manifest key a major removed or
# retired is a row of the manifest schema with a rewrite, a template variable's
# previous name is a row of the template's renamed table, a comptime path's is a
# row of the comptime path registry's and a decorator's is a row of the
# decorator registry's. so a name a later major retires is migrated by the row
# that retires it, and this module names none of them
use std.collections.sort;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.data.toml;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_len;

use A: std.allocator;

use mach.lang.fail;
use comptime_path: mach.lang.fe.comptime.path;
use mach.lang.fe.decorator;
use mach.lang.fe.lexer;
use mach.lang.fe.token;
use mach.lang.manifest.schema;
use mach.lang.manifest.schema.Fix;
use mach.lang.manifest.template;
use lang_source: mach.lang.source;

# the deepest comptime path a source names that the rewrite reads
val MAX_SEGMENTS: usize = 16;

# a manifest's text in this major's spelling: each key the schema retires with
# a rewrite rewritten, and each template variable a previous major named
# renamed wherever a string writes it. a text that is not TOML is refused, and
# one already in this spelling comes back unchanged
# ---
# a:    owns the returned text
# text: the manifest's text
# ret:  the rewritten text, owned by `a`
pub fun manifest(a: *A.Allocator, text: str) res[str, fail.Fail] {
    val parsed: res[toml.Table, toml.TomlError] = toml.parse(a, text);
    if (sel parsed.err) { ret res[str, fail.Fail].err{fail.toml_refused(parsed.err)}; }
    var doc: toml.Table = parsed.ok;
    fin { toml.dnit(a, ?doc); }
    var fixes: Vector[Fix] = collections_vector.init[Fix](a);
    fin { collections_vector.dnit[Fix](?fixes); }
    val keyed: err[A.Error] = schema.rewrites(a, ?doc, ?fixes);
    if (sel keyed.err) { ret res[str, fail.Fail].err{fail.refused(keyed.err)}; }
    var k: usize = 0;
    for (k < fixes.len) {
        aligned(text, ?fixes.data[k]);
        k = k + 1;
    }
    val named: err[A.Error] = templates_in(text, ?doc, ?fixes);
    if (sel named.err) { ret res[str, fail.Fail].err{fail.refused(named.err)}; }
    var i: usize = 0;
    for (i < fixes.len) {
        whole_line(text, ?fixes.data[i]);
        i = i + 1;
    }
    ret splice(a, text, ?fixes);
}

# a renamed key keeps the column its `=` stood at when a line beside it aligns
# its `=` there, and the spacing it was written with when none does
fun aligned(text: str, fix: *Fix) {
    if (str_len(fix.text) == 0) { ret; }
    var spaces: usize = 0;
    for (text[fix.at + fix.len + spaces] == ' ') { spaces = spaces + 1; }
    if (text[fix.at + fix.len + spaces] != '=') { ret; }
    val column: usize = fix.len + spaces;
    val name:   usize = str_len(fix.text);
    val start:  usize = line_start(text, fix.at);
    val at:     usize = fix.at + column - start;
    fix.len = column;
    fix.pad = spaces;
    if (!beside_at(text, start, fix.at, at)) { ret; }
    fix.pad = 1;
    if (column > name) { fix.pad = column - name; }
}

# whether the line before or after the one from `start` holds its first `=` at
# column `at`, `within` being any byte of that line
fun beside_at(text: str, start: usize, within: usize, at: usize) bool {
    if (start > 0 && equals_at(text, line_start(text, start - 1)) == at) { ret true; }
    var end: usize = within;
    for (text[end] != 0 && text[end] != '\n') { end = end + 1; }
    if (text[end] == 0) { ret false; }
    ret equals_at(text, end + 1) == at;
}

# the offset of the line holding byte `at`
fun line_start(text: str, at: usize) usize {
    var start: usize = at;
    for (start > 0 && text[start - 1] != '\n') { start = start - 1; }
    ret start;
}

# the column of the first `=` on the line from `start`, or the line's length
# plus one when it writes none, which no key's column is
fun equals_at(text: str, start: usize) usize {
    var i: usize = start;
    for (text[i] != 0 && text[i] != '\n') {
        if (text[i] == '=') { ret i - start; }
        i = i + 1;
    }
    ret i - start + 1;
}

# a fix that removes all a line writes removes the line
fun whole_line(text: str, fix: *Fix) {
    if (str_len(fix.text) != 0) { ret; }
    var start: usize = fix.at;
    for (start > 0 && (text[start - 1] == ' ' || text[start - 1] == '\t')) { start = start - 1; }
    if (start > 0 && text[start - 1] != '\n') { ret; }
    var end: usize = fix.at + fix.len;
    for (text[end] == ' ' || text[end] == '\t' || text[end] == '\r') { end = end + 1; }
    if (text[end] != '\n') { ret; }
    fix.at  = start;
    fix.len = end + 1 - start;
}

# a source's text in this major's spelling: each comptime path whose leading
# segments a previous major named and each decorator it named renamed. only
# tokens are read, so a comment or a string that spells one is left as written
# ---
# a:    owns the returned text
# text: the source's text
# ret:  the rewritten text, owned by `a`, or the lexer's refusal
pub fun source(a: *A.Allocator, text: str) res[str, fail.Fail] {
    val lexed: res[lexer.TokenStream, fail.Fail] = lexer.tokenize(text, a, lang_source.file_id(1));
    if (sel lexed.err) { ret res[str, fail.Fail].err{lexed.err}; }
    var stream: lexer.TokenStream = lexed.ok;
    fin { lexer.dnit(?stream, a); }
    var fixes: Vector[Fix] = collections_vector.init[Fix](a);
    fin { collections_vector.dnit[Fix](?fixes); }
    var i: usize = 0;
    for (i < stream.len) {
        val t: *token.Token = ?stream.tokens[i];
        i = i + 1;
        if (t.kind == token.KIND_DOLLAR) {
            val moved: err[A.Error] = path_in(text, ?stream, i, ?fixes);
            if (sel moved.err) { ret res[str, fail.Fail].err{fail.refused(moved.err)}; }
            cnt;
        }
        if (t.kind != token.KIND_DECORATOR_OPEN || i >= stream.len) { cnt; }
        val name: *token.Token = ?stream.tokens[i];
        if (name.kind != token.KIND_IDENT) { cnt; }
        val to: str = decorator.renamed(text, name.span);
        if (to == nil) { cnt; }
        val pushed: res[usize, A.Error] = collections_vector.push[Fix](?fixes, Fix{at: name.span.offset, len: name.span.len, text: to, pad: 0});
        if (sel pushed.err) { ret res[str, fail.Fail].err{fail.refused(pushed.err)}; }
    }
    ret splice(a, text, ?fixes);
}

# the fix of the comptime path whose segments start at token `first`, when the
# registry renamed its leading segments
fun path_in(text: str, stream: *lexer.TokenStream, first: usize, fixes: *Vector[Fix]) err[A.Error] {
    var segments: [MAX_SEGMENTS]lang_source.Span;
    var n:        usize = 0;
    var j:        usize = first;
    for (j < stream.len && n < MAX_SEGMENTS && stream.tokens[j].kind == token.KIND_IDENT) {
        segments[n] = stream.tokens[j].span;
        n           = n + 1;
        j           = j + 1;
        if (j + 1 >= stream.len || stream.tokens[j].kind != token.KIND_DOT) { brk; }
        j = j + 1;
    }
    if (n == 0) { ret err[A.Error].ok{}; }
    # the registry reads a path innermost segment first
    var stack: [MAX_SEGMENTS]lang_source.Span;
    var k:     usize = 0;
    for (k < n) {
        stack[k] = segments[n - 1 - k];
        k        = k + 1;
    }
    val moved: *comptime_path.Renamed = comptime_path.renamed(text, ?stack[0], n::u32);
    if (moved == nil) { ret err[A.Error].ok{}; }
    val last:   lang_source.Span    = segments[comptime_path.renamed_depth(moved)::usize - 1];
    val at:     usize               = segments[0].offset;
    val pushed: res[usize, A.Error] = collections_vector.push[Fix](fixes, Fix{at: at, len: last.offset + last.len - at, text: moved.to, pad: 0});
    if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
    ret err[A.Error].ok{};
}

# the fixes of every template variable a previous major named, in each string
# the table `t` holds at any depth. the raw text of a string is searched, so an
# escape before a variable does not move it
fun templates_in(text: str, t: *toml.Table, fixes: *Vector[Fix]) err[A.Error] {
    var i: usize = 0;
    for (i < toml.table_len(t)) {
        val v: opt[*toml.Value] = toml.table_value(t, i);
        i = i + 1;
        if (sel v.none) { cnt; }
        val held: err[A.Error] = templates_of(text, v.some, fixes);
        if (sel held.err) { ret held; }
    }
    ret err[A.Error].ok{};
}

fun templates_of(text: str, v: *toml.Value, fixes: *Vector[Fix]) err[A.Error] {
    if (v.tag == toml.TYPE_TABLE) { ret templates_in(text, ?v.data.table, fixes); }
    if (v.tag == toml.TYPE_ARRAY) {
        var i: usize = 0;
        for (i < toml.array_len(?v.data.array)) {
            val e: opt[*toml.Value] = toml.array_get(?v.data.array, i);
            i = i + 1;
            if (sel e.none) { cnt; }
            val held: err[A.Error] = templates_of(text, e.some, fixes);
            if (sel held.err) { ret held; }
        }
        ret err[A.Error].ok{};
    }
    if (v.tag != toml.TYPE_STRING) { ret err[A.Error].ok{}; }
    var r: usize = 0;
    for {
        val row: *template.Renamed = template.renamed(r);
        if (row == nil) { brk; }
        r = r + 1;
        val placed: err[A.Error] = variables_in(text, v.span, row, fixes);
        if (sel placed.err) { ret placed; }
    }
    ret err[A.Error].ok{};
}

# a fix of each `{from}` the raw text at `span` writes
fun variables_in(text: str, span: toml.Span, row: *template.Renamed, fixes: *Vector[Fix]) err[A.Error] {
    val from: usize = str_len(row.from);
    var at:   usize = span.at;
    for (at + from + 2 <= span.at + span.len) {
        if (text[at] == '{' && text[at + from + 1] == '}' && spells(text, at + 1, row.from, from)) {
            val pushed: res[usize, A.Error] = collections_vector.push[Fix](fixes, Fix{at: at + 1, len: from, text: row.to, pad: 0});
            if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
            at = at + from + 2;
            cnt;
        }
        at = at + 1;
    }
    ret err[A.Error].ok{};
}

fun spells(text: str, at: usize, word: str, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (text[at + i] != word[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun by_offset(x: *Fix, y: *Fix) i64 {
    if (x.at < y.at) { ret -1; }
    if (x.at > y.at) { ret 1; }
    ret 0;
}

# `text` with each fix applied, in offset order. two fixes of one byte are the
# rules contradicting each other, which is refused
fun splice(a: *A.Allocator, text: str, fixes: *Vector[Fix]) res[str, fail.Fail] {
    sort.sort_by[Fix](fixes.data, fixes.len, by_offset);
    var out: Vector[u8] = collections_vector.init[u8](a);
    fin { collections_vector.dnit[u8](?out); }
    val len:  usize = str_len(text);
    var from: usize = 0;
    var i:    usize = 0;
    for (i <= fixes.len) {
        var to: usize = len;
        if (i < fixes.len) { to = fixes.data[i].at; }
        if (to < from)     { ret res[str, fail.Fail].err{fail.message("internal: two migration rules rewrite the same bytes")}; }
        val kept: err[A.Error] = append(?out, text, from, to - from);
        if (sel kept.err)   { ret res[str, fail.Fail].err{fail.refused(kept.err)}; }
        if (i == fixes.len) { brk; }
        val fix:  *Fix         = ?fixes.data[i];
        val made: err[A.Error] = append(?out, fix.text, 0, str_len(fix.text));
        if (sel made.err) { ret res[str, fail.Fail].err{fail.refused(made.err)}; }
        var p: usize = 0;
        for (p < fix.pad) {
            val padded: err[A.Error] = append(?out, " ", 0, 1);
            if (sel padded.err) { ret res[str, fail.Fail].err{fail.refused(padded.err)}; }
            p = p + 1;
        }
        from = fix.at + fix.len;
        i    = i + 1;
    }
    # the copy reads its source as a nul-terminated string
    val ended: res[usize, A.Error] = collections_vector.push[u8](?out, 0);
    if (sel ended.err) { ret res[str, fail.Fail].err{fail.refused(ended.err)}; }
    val copied: res[str, StrError] = str_copy_slice(a, out.data::str, 0, out.len - 1);
    if (sel copied.err) { ret res[str, fail.Fail].err{fail.message(fail.str_text(copied.err))}; }
    ret res[str, fail.Fail].ok{copied.ok};
}

fun append(out: *Vector[u8], text: str, at: usize, len: usize) err[A.Error] {
    val room: res[usize, A.Error] = collections_vector.reserve[u8](out, len + 1);
    if (sel room.err) { ret err[A.Error].err{room.err}; }
    var i: usize = 0;
    for (i < len) {
        out.data[out.len] = text[at + i];
        collections_vector.commit[u8](out, 1);
        i = i + 1;
    }
    ret err[A.Error].ok{};
}
