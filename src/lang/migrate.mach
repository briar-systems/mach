# a project written for the previous major, rewritten into this one's spelling,
# which `mach migrate` applies
#
# a renamed spelling is data its owner already holds: a manifest key a major
# removed or retired is a row of the manifest schema with a rewrite, a target
# value's retired spelling is a row of the target reader's, a template variable's
# previous name is a row of the template's renamed table, a comptime path's is a
# row of the comptime path registry's, a decorator's is a row of the decorator
# registry's, and an `asm` head's, a truth alias's and a step option's are rows
# of the transition table's. so a name a later major retires is migrated by the
# row that retires it, and no rule here spells one
#
# what changed meaning rather than spelling has no owner's row, so its rule here
# names what it reads: `[project].mach` for the range, a step's `argv` for which
# step runs mach, `[project].out` and each artifact's `out` for the output a
# previous major rooted, and a dependency's `[artifact.*]` `export`, `default`,
# `kind` and `entry` for the module a bare `use` bound
#
# the rules are rows themselves, each tagged with the major it migrates from. a
# release carries the rows of the major before it: 8.0.0 deletes every row tagged
# 6 and adds its own
use std.collections.sort;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.data.toml;
use std_format: std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_len;
use std.types.string.str_region_equals;
use std.types.string.str_starts_with;

use A: std.allocator;

use mach.lang.diagnostic;
use mach.lang.fail;
use comptime_path: mach.lang.fe.comptime.path;
use mach.lang.fe.decorator;
use mach.lang.fe.lexer;
use mach.lang.fe.token;
use mach.lang.fe.transition;
use mach.lang.lexis;
use manifest_load: mach.lang.manifest.load;
use mach.lang.manifest.schema;
use mach.lang.manifest.schema.Fix;
use manifest_target: mach.lang.manifest.target;
use mach.lang.manifest.template;
use lang_source: mach.lang.source;
use mach.lang.version;

# the deepest comptime path a source names that the rewrite reads
val MAX_SEGMENTS: usize = 16;

# the major this release migrates from
pub val FROM_MAJOR: u32 = 6;

# a dependency of the root project, as `mach migrate` reads it
# ---
# id:     its key under `[dep]`
# range:  its `[project].mach`, nil when dep/ holds no manifest for it
# module: the module its exported artifact's entry is, nil when it exports none
pub rec Dependency {
    id:     str;
    range:  str;
    module: str;
}

# one pass over a source, called with each token's index
# ---
# a:      owns the text a fix writes
# text:   the source
# stream: its tokens
# fixes:  the rewrites made so far
# deps:   the root project's dependencies
rec Walk {
    a:      *A.Allocator;
    text:   str;
    stream: *lexer.TokenStream;
    fixes:  *Vector[Fix];
    deps:   *Vector[Dependency];
}

# a rule over a source's tokens
# ---
# from:  the major it migrates from
# apply: what it does at a token
rec SourceRule {
    from:  u32;
    apply: fun(*Walk, usize) err[A.Error];
}

val SOURCE_RULE_COUNT: usize                         = 5;
val SOURCE_RULES:      [SOURCE_RULE_COUNT]SourceRule = [SOURCE_RULE_COUNT]SourceRule{
    SourceRule{from: 6, apply: rule_path},
    SourceRule{from: 6, apply: rule_decorator},
    SourceRule{from: 6, apply: rule_asm_head},
    SourceRule{from: 6, apply: rule_alias},
    SourceRule{from: 6, apply: rule_bare_use},
};

# a rule over a manifest
# ---
# from:  the major it migrates from
# apply: the fixes it makes of the document in `text`
rec ManifestRule {
    from:  u32;
    apply: fun(*A.Allocator, str, *toml.Table, *Vector[Fix]) err[fail.Fail];
}

val MANIFEST_RULE_COUNT: usize                             = 6;
val MANIFEST_RULES:      [MANIFEST_RULE_COUNT]ManifestRule = [MANIFEST_RULE_COUNT]ManifestRule{
    ManifestRule{from: 6, apply: rule_keys},
    ManifestRule{from: 6, apply: rule_targets},
    ManifestRule{from: 6, apply: rule_templates},
    ManifestRule{from: 6, apply: rule_range},
    ManifestRule{from: 6, apply: rule_step_flags},
    ManifestRule{from: 6, apply: rule_rooted_out},
};

# a manifest's text in this major's spelling: each key the schema retires with
# a rewrite rewritten, and each template variable a previous major named
# renamed wherever a string writes it. a text that is not TOML is refused, and
# one already in this spelling comes back unchanged
# ---
# a:    owns the returned text
# text: the manifest's text
# ret:  the rewritten text, owned by `a`
pub fun manifest(a: *A.Allocator, text: str) res[str, fail.Fail] {
    val parsed: res[toml.Table, toml.TomlError] = toml.parse(a, text);
    if (sel parsed.err) { ret res[str, fail.Fail].err{fail.toml_refused(parsed.err)}; }
    var doc: toml.Table = parsed.ok;
    fin { toml.dnit(a, ?doc); }
    var fixes: Vector[Fix] = collections_vector.init[Fix](a);
    fin { collections_vector.dnit[Fix](?fixes); }
    var r: usize = 0;
    for (r < MANIFEST_RULE_COUNT) {
        if (MANIFEST_RULES[r].from == FROM_MAJOR) {
            val applied: err[fail.Fail] = MANIFEST_RULES[r].apply(a, text, ?doc, ?fixes);
            if (sel applied.err) { ret res[str, fail.Fail].err{applied.err}; }
        }
        r = r + 1;
    }
    var i: usize = 0;
    for (i < fixes.len) {
        whole_line(text, ?fixes.data[i]);
        i = i + 1;
    }
    ret splice(a, text, ?fixes);
}

# each key the schema retires with a rewrite
fun rule_keys(a: *A.Allocator, text: str, doc: *toml.Table, fixes: *Vector[Fix]) err[fail.Fail] {
    val keyed: err[A.Error] = schema.rewrites(a, doc, fixes);
    if (sel keyed.err) { ret err[fail.Fail].err{fail.refused(keyed.err)}; }
    var k: usize = 0;
    for (k < fixes.len) {
        aligned(text, ?fixes.data[k]);
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

# each target spelling the previous major wrote that the target reader retires with a rewrite
fun rule_targets(a: *A.Allocator, text: str, doc: *toml.Table, fixes: *Vector[Fix]) err[fail.Fail] {
    ret manifest_target.rewrites(a, doc, fixes);
}

# each template variable a previous major named
fun rule_templates(a: *A.Allocator, text: str, doc: *toml.Table, fixes: *Vector[Fix]) err[fail.Fail] {
    val renamed: err[A.Error] = templates_in(text, doc, fixes);
    if (sel renamed.err) { ret err[fail.Fail].err{fail.refused(renamed.err)}; }
    ret err[fail.Fail].ok{};
}

# the major this compiler is, the leading digits of its version
fun running_major() u32 {
    var major: u32   = 0;
    var i:     usize = 0;
    for (version.MACH_VERSION[i] >= '0' && version.MACH_VERSION[i] <= '9') {
        major = major * 10 + (version.MACH_VERSION[i] - '0')::u32;
        i     = i + 1;
    }
    ret major;
}

# a `[project].mach` range's major in `text`, its digits at `at` for `len` bytes, the raw
# text of the value at `span`
fun range_digits(text: str, span: toml.Span, at: *usize, len: *usize) {
    var i: usize = span.at;
    for (i < span.at + span.len && (text[i] < '0' || text[i] > '9')) { i = i + 1; }
    @at = i;
    for (i < span.at + span.len && text[i] >= '0' && text[i] <= '9') { i = i + 1; }
    @len = i - @at;
}

# a `[project].mach` range on the major before the running compiler's, moved onto it
fun rule_range(a: *A.Allocator, text: str, doc: *toml.Table, fixes: *Vector[Fix]) err[fail.Fail] {
    val running: u32 = running_major();
    if (running <= FROM_MAJOR) { ret err[fail.Fail].ok{}; }
    val range: opt[*toml.Value] = toml.get(doc, "project.mach");
    if (sel range.none)                     { ret err[fail.Fail].ok{}; }
    if (range.some.tag != toml.TYPE_STRING) { ret err[fail.Fail].ok{}; }
    var at:  usize = 0;
    var len: usize = 0;
    range_digits(text, range.some.span, ?at, ?len);
    if (len == 0 || major_at(text, at, len) != FROM_MAJOR) { ret err[fail.Fail].ok{}; }
    val made: res[str, std_format.FormatError] = std_format.sprint(a, "{}", running::usize);
    if (sel made.err) { ret err[fail.Fail].err{fail.format_refused(made.err)}; }
    val pushed: res[usize, A.Error] = collections_vector.push[Fix](fixes, Fix{at: at, len: len, text: made.ok, pad: 0});
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

fun major_at(text: str, at: usize, len: usize) u32 {
    var major: u32   = 0;
    var i:     usize = 0;
    for (i < len) {
        major = major * 10 + (text[at + i] - '0')::u32;
        i     = i + 1;
    }
    ret major;
}

# whether a dependency's `[project].mach` range stands on the major this release migrates
pub fun on_previous_major(range: str) bool {
    var at: usize = 0;
    for (range[at] != 0 && (range[at] < '0' || range[at] > '9')) { at = at + 1; }
    var len: usize = 0;
    for (range[at + len] >= '0' && range[at + len] <= '9') { len = len + 1; }
    ret len != 0 && major_at(range, at, len) == FROM_MAJOR;
}

# each dependency of the manifest `text`, whose project is at `root`, as dep/ holds it
# ---
# a:       owns what `out` holds
# sources: receives the text of each dependency's manifest dep/ holds
# root:    the project's directory
# text:    its manifest's text
# out:     receives the dependencies
pub fun dependencies(a: *A.Allocator, sources: *lang_source.SourceMap, root: str, text: str, out: *Vector[Dependency]) err[fail.Fail] {
    val parsed: res[toml.Table, toml.TomlError] = toml.parse(a, text);
    if (sel parsed.err) { ret err[fail.Fail].err{fail.toml_refused(parsed.err)}; }
    var doc: toml.Table = parsed.ok;
    fin { toml.dnit(a, ?doc); }
    val deps: opt[*toml.Table] = toml.get_table(?doc, "dep");
    if (sel deps.none) { ret err[fail.Fail].ok{}; }
    var i: usize = 0;
    for (i < toml.table_len(deps.some)) {
        val key: opt[str] = toml.table_key(deps.some, i);
        i = i + 1;
        if (sel key.none) { cnt; }
        val copied: res[str, StrError] = str_copy_slice(a, key.some, 0, str_len(key.some));
        if (sel copied.err) { ret err[fail.Fail].err{fail.str_refused(copied.err)}; }
        var dep:  Dependency     = Dependency{id: copied.ok, range: nil, module: nil};
        val read: err[fail.Fail] = dependency_read(a, sources, root, ?dep);
        if (sel read.err) { ret read; }
        val pushed: res[usize, A.Error] = collections_vector.push[Dependency](out, dep);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

# what the manifest dep/ holds for `dep` says; a dependency dep/ does not hold keeps nil
fun dependency_read(a: *A.Allocator, sources: *lang_source.SourceMap, root: str, dep: *Dependency) err[fail.Fail] {
    val path: res[str, fail.Fail] = diagnostic.join(a, root, "/dep/", dep.id, "/mach.toml");
    if (sel path.err) { ret err[fail.Fail].err{path.err}; }
    val read: res[manifest_load.Doc, fail.Fail] = manifest_load.doc_read(a, sources, path.ok);
    if (sel read.err) { ret err[fail.Fail].ok{}; }
    var held: manifest_load.Doc = read.ok;
    fin { manifest_load.doc_dnit(a, ?held); }
    val range: opt[*toml.Value] = toml.get(?held.table, "project.mach");
    if (sel range.some) {
        if (range.some.tag == toml.TYPE_STRING) {
            val copied: res[str, StrError] = str_copy_slice(a, range.some.data.string, 0, str_len(range.some.data.string));
            if (sel copied.err) { ret err[fail.Fail].err{fail.str_refused(copied.err)}; }
            dep.range = copied.ok;
        }
    }
    val artifacts: opt[*toml.Table] = toml.get_table(?held.table, "artifact");
    if (sel artifacts.none) { ret err[fail.Fail].ok{}; }
    val entry: str = exported_entry(artifacts.some);
    if (entry == nil) { ret err[fail.Fail].ok{}; }
    val module: res[str, fail.Fail] = module_of(a, dep.id, entry);
    if (sel module.err) { ret err[fail.Fail].err{module.err}; }
    dep.module = module.ok;
    ret err[fail.Fail].ok{};
}

# the entry of the artifact a bare `use` of a project bound in a previous major: the
# one it marks `export`, else a default library
fun exported_entry(artifacts: *toml.Table) str {
    var fallback: str   = nil;
    var i:        usize = 0;
    for (i < toml.table_len(artifacts)) {
        val v: opt[*toml.Value] = toml.table_value(artifacts, i);
        i = i + 1;
        if (sel v.none)                    { cnt; }
        if (v.some.tag != toml.TYPE_TABLE) { cnt; }
        val row:   *toml.Table      = ?v.some.data.table;
        val entry: opt[*toml.Value] = toml.get(row, "entry");
        if (sel entry.none)                             { cnt; }
        if (entry.some.tag != toml.TYPE_STRING)         { cnt; }
        if (flag_of(row, "export"))                     { ret entry.some.data.string; }
        if (flag_of(row, "default") && library_of(row)) { fallback = entry.some.data.string; }
    }
    ret fallback;
}

fun flag_of(t: *toml.Table, key: str) bool {
    val v: opt[*toml.Value] = toml.get(t, key);
    if (sel v.none) { ret false; }
    ret v.some.tag == toml.TYPE_BOOL && v.some.data.boolean;
}

# whether the artifact `t` states a library kind, every one of which is spelled from `lib`
fun library_of(t: *toml.Table) bool {
    val kind: opt[*toml.Value] = toml.get(t, "kind");
    if (sel kind.none)                     { ret false; }
    if (kind.some.tag != toml.TYPE_STRING) { ret false; }
    ret str_region_equals(kind.some.data.string, 0, str_len(kind.some.data.string), "lib");
}

# the module path of `entry`, a file under the source directory of the project `id`
fun module_of(a: *A.Allocator, id: str, entry: str) res[str, fail.Fail] {
    val joined: res[str, fail.Fail] = diagnostic.join(a, id, ".", entry);
    if (sel joined.err) { ret joined; }
    val path: *u8   = joined.ok::*u8;
    val len:  usize = str_len(joined.ok);
    var i:    usize = 0;
    for (i < len) {
        if (path[i] == '/') { path[i] = '.'; }
        i = i + 1;
    }
    # the entry's `.mach` is no part of the module's path
    if (len > 5) { path[len - 5] = 0; }
    ret res[str, fail.Fail].ok{joined.ok};
}

# the offset of `word` standing as a word in `text` from `at` to `end`, `end` when it does
# not: after a quote, a space or a path's `/`, and before a quote, a space or an `=`
pub fun word_in(text: str, at: usize, end: usize, word: str) usize {
    val len: usize = str_len(word);
    var i:   usize = at;
    for (i + len <= end) {
        var before: u8 = ' ';
        if (i > at) { before = text[i - 1]; }
        val after:  u8   = text[i + len];
        val opens:  bool = before == '"' || before == '\'' || before == ' ' || before == '\t' || before == '/';
        val closes: bool = i + len == end || after == '"' || after == '\'' || after == ' ' || after == '\t' || after == '=' || after == '\r';
        if (opens && closes && spells(text, i, word, len)) { ret i; }
        i = i + 1;
    }
    ret end;
}

# each option a previous major spelled otherwise in a step's `argv`, in a step that runs
# mach: another program's `--jobs` is its own
fun rule_step_flags(a: *A.Allocator, text: str, doc: *toml.Table, fixes: *Vector[Fix]) err[fail.Fail] {
    val steps: opt[*toml.Table] = toml.get_table(doc, "step");
    if (sel steps.none) { ret err[fail.Fail].ok{}; }
    var i: usize = 0;
    for (i < toml.table_len(steps.some)) {
        val step: opt[*toml.Value] = toml.table_value(steps.some, i);
        i = i + 1;
        if (sel step.none)                    { cnt; }
        if (step.some.tag != toml.TYPE_TABLE) { cnt; }
        val argv: opt[*toml.Value] = toml.get(?step.some.data.table, "argv");
        if (sel argv.none)                    { cnt; }
        if (argv.some.tag != toml.TYPE_ARRAY) { cnt; }
        val args: *toml.Array = ?argv.some.data.array;
        if (!runs_mach(text, args)) { cnt; }
        var k: usize = 0;
        for (k < toml.array_len(args)) {
            val arg: opt[*toml.Value] = toml.array_get(args, k);
            k = k + 1;
            if (sel arg.none) { cnt; }
            var f: usize = 0;
            for (f < transition.FLAG_COUNT) {
                val row:  *transition.Flag = transition.flag_at(f);
                val end:  usize            = arg.some.span.at + arg.some.span.len;
                var from: usize            = arg.some.span.at;
                f = f + 1;
                for (from < end) {
                    val found: usize = word_in(text, from, end, row.from);
                    if (found == end) { brk; }
                    val pushed: res[usize, A.Error] = collections_vector.push[Fix](fixes, Fix{at: found, len: str_len(row.from), text: row.to, pad: 0});
                    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
                    from = found + str_len(row.from);
                }
            }
        }
    }
    ret err[fail.Fail].ok{};
}

# each artifact `out` of a manifest that writes the previous major's `[project].out`, which rooted
# every artifact `out` under it, written from `{project.work}` as this major's paths are. an `out`
# that names a `{project.` variable already, or that another rule rewrites, is left to it
fun rule_rooted_out(a: *A.Allocator, text: str, doc: *toml.Table, fixes: *Vector[Fix]) err[fail.Fail] {
    val root: opt[*toml.Value] = toml.get(doc, "project.out");
    if (sel root.none) { ret err[fail.Fail].ok{}; }
    val artifacts: opt[*toml.Table] = toml.get_table(doc, "artifact");
    if (sel artifacts.none) { ret err[fail.Fail].ok{}; }
    var i: usize = 0;
    for (i < toml.table_len(artifacts.some)) {
        val row: opt[*toml.Value] = toml.table_value(artifacts.some, i);
        i = i + 1;
        if (sel row.none)                    { cnt; }
        if (row.some.tag != toml.TYPE_TABLE) { cnt; }
        val out: opt[*toml.Value] = toml.get(?row.some.data.table, "out");
        if (sel out.none)                                          { cnt; }
        if (out.some.tag != toml.TYPE_STRING)                      { cnt; }
        if (str_starts_with(out.some.data.string, "{project."))    { cnt; }
        if (rewritten(fixes, out.some.span.at, out.some.span.len)) { cnt; }
        val pushed: res[usize, A.Error] = collections_vector.push[Fix](fixes, Fix{at: string_start(text, out.some.span), len: 0, text: "{project.work}/", pad: 0});
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

# whether a fix made so far rewrites a byte of the `len` bytes at `at`
fun rewritten(fixes: *Vector[Fix], at: usize, len: usize) bool {
    var i: usize = 0;
    for (i < fixes.len) {
        val f: *Fix = ?fixes.data[i];
        i = i + 1;
        if (f.at < at + len && at < f.at + f.len) { ret true; }
    }
    ret false;
}

# the offset of the first byte of the string literal at `span`: past its one quote, or past its
# three and the line break TOML trims after them
fun string_start(text: str, span: toml.Span) usize {
    val q: u8 = text[span.at];
    if (span.len < 6 || text[span.at + 1] != q || text[span.at + 2] != q) { ret span.at + 1; }
    var at: usize = span.at + 3;
    if (text[at] == '\r' && text[at + 1] == '\n') { ret at + 2; }
    if (text[at] == '\n')                         { ret at + 1; }
    ret at;
}

# whether a step's `argv`, its literals in `text`, runs mach
pub fun runs_mach(text: str, args: *toml.Array) bool {
    var i: usize = 0;
    for (i < toml.array_len(args)) {
        val arg: opt[*toml.Value] = toml.array_get(args, i);
        i = i + 1;
        if (sel arg.none) { cnt; }
        val end: usize = arg.some.span.at + arg.some.span.len;
        if (word_in(text, arg.some.span.at, end, "mach") != end) { ret true; }
    }
    ret false;
}

# a renamed key keeps the column its `=` stood at when a line beside it aligns
# its `=` there, and the spacing it was written with when none does
fun aligned(text: str, fix: *Fix) {
    if (str_len(fix.text) == 0) { ret; }
    var spaces: usize = 0;
    for (text[fix.at + fix.len + spaces] == ' ') { spaces = spaces + 1; }
    if (text[fix.at + fix.len + spaces] != '=') { ret; }
    val column: usize = fix.len + spaces;
    val name:   usize = str_len(fix.text);
    val start:  usize = line_start(text, fix.at);
    val at:     usize = fix.at + column - start;
    fix.len = column;
    fix.pad = spaces;
    if (!beside_at(text, start, fix.at, at)) { ret; }
    fix.pad = 1;
    if (column > name) { fix.pad = column - name; }
}

# whether the line before or after the one from `start` holds its first `=` at
# column `at`, `within` being any byte of that line
fun beside_at(text: str, start: usize, within: usize, at: usize) bool {
    if (start > 0 && equals_at(text, line_start(text, start - 1)) == at) { ret true; }
    var end: usize = within;
    for (text[end] != 0 && text[end] != '\n') { end = end + 1; }
    if (text[end] == 0) { ret false; }
    ret equals_at(text, end + 1) == at;
}

# the offset of the line holding byte `at`
fun line_start(text: str, at: usize) usize {
    var start: usize = at;
    for (start > 0 && text[start - 1] != '\n') { start = start - 1; }
    ret start;
}

# the column of the first `=` on the line from `start`, or the line's length
# plus one when it writes none, which no key's column is
fun equals_at(text: str, start: usize) usize {
    var i: usize = start;
    for (text[i] != 0 && text[i] != '\n') {
        if (text[i] == '=') { ret i - start; }
        i = i + 1;
    }
    ret i - start + 1;
}

# a fix that removes all a line writes removes the line
fun whole_line(text: str, fix: *Fix) {
    if (str_len(fix.text) != 0) { ret; }
    var start: usize = fix.at;
    for (start > 0 && (text[start - 1] == ' ' || text[start - 1] == '\t')) { start = start - 1; }
    if (start > 0 && text[start - 1] != '\n') { ret; }
    var end: usize = fix.at + fix.len;
    for (text[end] == ' ' || text[end] == '\t' || text[end] == '\r') { end = end + 1; }
    if (text[end] != '\n') { ret; }
    fix.at  = start;
    fix.len = end + 1 - start;
}

# a source's text in this major's spelling: each comptime path whose leading
# segments a previous major named, each decorator it named, each `asm` head, each
# truth alias over a width and each bare use of a project rewritten. only tokens
# are read, so a comment or a string that spells one is left as written
# ---
# a:    owns the returned text
# text: the source's text
# deps: the root project's dependencies
# ret:  the rewritten text, owned by `a`, or the lexer's refusal
pub fun source(a: *A.Allocator, text: str, deps: *Vector[Dependency]) res[str, fail.Fail] {
    val lexed: res[lexer.TokenStream, fail.Fail] = lexer.tokenize(text, a, lang_source.file_id(1));
    if (sel lexed.err) { ret res[str, fail.Fail].err{lexed.err}; }
    var stream: lexer.TokenStream = lexed.ok;
    fin { lexer.dnit(?stream, a); }
    var fixes: Vector[Fix] = collections_vector.init[Fix](a);
    fin { collections_vector.dnit[Fix](?fixes); }
    var walk: Walk  = Walk{a: a, text: text, stream: ?stream, fixes: ?fixes, deps: deps};
    var i:    usize = 0;
    for (i < stream.len) {
        var r: usize = 0;
        for (r < SOURCE_RULE_COUNT) {
            if (SOURCE_RULES[r].from == FROM_MAJOR) {
                val applied: err[A.Error] = SOURCE_RULES[r].apply(?walk, i);
                if (sel applied.err) { ret res[str, fail.Fail].err{fail.refused(applied.err)}; }
            }
            r = r + 1;
        }
        i = i + 1;
    }
    ret splice(a, text, ?fixes);
}

fun fix_of(w: *Walk, span: lang_source.Span, text: str) err[A.Error] {
    val pushed: res[usize, A.Error] = collections_vector.push[Fix](w.fixes, Fix{at: span.offset, len: span.len, text: text, pad: 0});
    if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
    ret err[A.Error].ok{};
}

fun token_at(w: *Walk, i: usize) *token.Token {
    if (i >= w.stream.len) { ret nil; }
    ret ?w.stream.tokens[i];
}

fun kind_at(w: *Walk, i: usize, kind: token.Kind) bool {
    val t: *token.Token = token_at(w, i);
    ret t != nil && t.kind == kind;
}

fun word_at(w: *Walk, i: usize, word: str) bool {
    if (!kind_at(w, i, token.KIND_IDENT)) { ret false; }
    val t: *token.Token = token_at(w, i);
    ret str_region_equals(w.text, t.span.offset, t.span.len, word);
}

fun rule_path(w: *Walk, i: usize) err[A.Error] {
    if (!kind_at(w, i, token.KIND_DOLLAR)) { ret err[A.Error].ok{}; }
    ret path_in(w.text, w.stream, i + 1, w.fixes);
}

# `#[name...]`: the name a previous major gave it, a flag's mode written as its argument
# and bare-word arguments written as strings
fun rule_decorator(w: *Walk, i: usize) err[A.Error] {
    if (!kind_at(w, i, token.KIND_DECORATOR_OPEN) || !kind_at(w, i + 1, token.KIND_IDENT)) { ret err[A.Error].ok{}; }
    val name: *token.Token = token_at(w, i + 1);
    val open: bool         = kind_at(w, i + 2, token.KIND_LPAREN);
    var args: u32          = 0;
    if (open) { args = 1; }
    val to: decorator.Rewrite = decorator.rewrite_of(w.text, name.span, args);
    if (to.name == nil) { ret err[A.Error].ok{}; }
    if (to.mode != nil) {
        val with: res[str, fail.Fail] = diagnostic.join(w.a, to.name, "(\"", to.mode, "\")");
        if (sel with.err) { ret err[A.Error].ok{}; }
        ret fix_of(w, name.span, with.ok);
    }
    val named: err[A.Error] = fix_of(w, name.span, to.name);
    if (sel named.err || !to.words || !open) { ret named; }
    var j: usize = i + 3;
    for (j < w.stream.len && !kind_at(w, j, token.KIND_RPAREN)) {
        val t: *token.Token = token_at(w, j);
        j = j + 1;
        if (t.kind != token.KIND_IDENT) { cnt; }
        val word: res[str, StrError] = str_copy_slice(w.a, w.text, t.span.offset, t.span.len);
        if (sel word.err) { cnt; }
        val quoted: res[str, fail.Fail] = diagnostic.join(w.a, "\"", word.ok, "\"");
        if (sel quoted.err) { cnt; }
        val placed: err[A.Error] = fix_of(w, t.span, quoted.ok);
        if (sel placed.err) { ret placed; }
    }
    ret err[A.Error].ok{};
}

# `asm <architecture> {`: the selection the transition table holds for the head
fun rule_asm_head(w: *Walk, i: usize) err[A.Error] {
    if (!word_at(w, i, lexis.KW_ASM) || !kind_at(w, i + 1, token.KIND_IDENT) || !kind_at(w, i + 2, token.KIND_LBRACE)) { ret err[A.Error].ok{}; }
    val head: *token.Token     = token_at(w, i + 1);
    val row:  *transition.Head = transition.head_of(w.text, head.span);
    if (row == nil) { ret err[A.Error].ok{}; }
    ret fix_of(w, head.span, row.to);
}

# `def name: over;`: a truth alias the transition table holds, onto `u1`
fun rule_alias(w: *Walk, i: usize) err[A.Error] {
    if (!word_at(w, i, lexis.KW_DEF) || !kind_at(w, i + 1, token.KIND_IDENT) || !kind_at(w, i + 2, token.KIND_COLON)
        || !kind_at(w, i + 3, token.KIND_IDENT) || !kind_at(w, i + 4, token.KIND_SEMI)) { ret err[A.Error].ok{}; }
    val over: *token.Token      = token_at(w, i + 3);
    val row:  *transition.Alias = transition.alias_of(w.text, token_at(w, i + 1).span, over.span);
    if (row == nil) { ret err[A.Error].ok{}; }
    ret fix_of(w, over.span, row.to);
}

# `use id;`, `use name: id;` or `fwd id;`: one segment names a project and no module since
# #4754, so it becomes the path of the module the old rule bound
fun rule_bare_use(w: *Walk, i: usize) err[A.Error] {
    if (!word_at(w, i, lexis.KW_USE) && !word_at(w, i, lexis.KW_FWD)) { ret err[A.Error].ok{}; }
    var at: usize = i + 1;
    if (kind_at(w, at + 1, token.KIND_COLON))                                      { at = at + 2; }
    if (!kind_at(w, at, token.KIND_IDENT) || !kind_at(w, at + 1, token.KIND_SEMI)) { ret err[A.Error].ok{}; }
    val id: *token.Token = token_at(w, at);
    var d:  usize        = 0;
    for (d < w.deps.len) {
        val dep: *Dependency = ?w.deps.data[d];
        d = d + 1;
        if (dep.module != nil && str_region_equals(w.text, id.span.offset, id.span.len, dep.id)) { ret fix_of(w, id.span, dep.module); }
    }
    ret err[A.Error].ok{};
}

# the fix of the comptime path whose segments start at token `first`, when the
# registry renamed its leading segments
fun path_in(text: str, stream: *lexer.TokenStream, first: usize, fixes: *Vector[Fix]) err[A.Error] {
    var segments: [MAX_SEGMENTS]lang_source.Span;
    var n:        usize = 0;
    var j:        usize = first;
    for (j < stream.len && n < MAX_SEGMENTS && stream.tokens[j].kind == token.KIND_IDENT) {
        segments[n] = stream.tokens[j].span;
        n           = n + 1;
        j           = j + 1;
        if (j + 1 >= stream.len || stream.tokens[j].kind != token.KIND_DOT) { brk; }
        j = j + 1;
    }
    if (n == 0) { ret err[A.Error].ok{}; }
    # the registry reads a path innermost segment first
    var stack: [MAX_SEGMENTS]lang_source.Span;
    var k:     usize = 0;
    for (k < n) {
        stack[k] = segments[n - 1 - k];
        k        = k + 1;
    }
    val moved: *comptime_path.Renamed = comptime_path.renamed(text, ?stack[0], n::u32);
    if (moved == nil) { ret err[A.Error].ok{}; }
    val last:   lang_source.Span    = segments[comptime_path.renamed_depth(moved)::usize - 1];
    val at:     usize               = segments[0].offset;
    val pushed: res[usize, A.Error] = collections_vector.push[Fix](fixes, Fix{at: at, len: last.offset + last.len - at, text: moved.to, pad: 0});
    if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
    ret err[A.Error].ok{};
}

# the fixes of every template variable a previous major named, in each string
# the table `t` holds at any depth. the raw text of a string is searched, so an
# escape before a variable does not move it
fun templates_in(text: str, t: *toml.Table, fixes: *Vector[Fix]) err[A.Error] {
    var i: usize = 0;
    for (i < toml.table_len(t)) {
        val v: opt[*toml.Value] = toml.table_value(t, i);
        i = i + 1;
        if (sel v.none) { cnt; }
        val held: err[A.Error] = templates_of(text, v.some, fixes);
        if (sel held.err) { ret held; }
    }
    ret err[A.Error].ok{};
}

fun templates_of(text: str, v: *toml.Value, fixes: *Vector[Fix]) err[A.Error] {
    if (v.tag == toml.TYPE_TABLE) { ret templates_in(text, ?v.data.table, fixes); }
    if (v.tag == toml.TYPE_ARRAY) {
        var i: usize = 0;
        for (i < toml.array_len(?v.data.array)) {
            val e: opt[*toml.Value] = toml.array_get(?v.data.array, i);
            i = i + 1;
            if (sel e.none) { cnt; }
            val held: err[A.Error] = templates_of(text, e.some, fixes);
            if (sel held.err) { ret held; }
        }
        ret err[A.Error].ok{};
    }
    if (v.tag != toml.TYPE_STRING) { ret err[A.Error].ok{}; }
    var r: usize = 0;
    for {
        val row: *template.Renamed = template.renamed(r);
        if (row == nil) { brk; }
        r = r + 1;
        val placed: err[A.Error] = variables_in(text, v.span, row, fixes);
        if (sel placed.err) { ret placed; }
    }
    ret err[A.Error].ok{};
}

# a fix of each `{from}` the raw text at `span` writes
fun variables_in(text: str, span: toml.Span, row: *template.Renamed, fixes: *Vector[Fix]) err[A.Error] {
    val from: usize = str_len(row.from);
    var at:   usize = span.at;
    for (at + from + 2 <= span.at + span.len) {
        if (text[at] == '{' && text[at + from + 1] == '}' && spells(text, at + 1, row.from, from)) {
            val pushed: res[usize, A.Error] = collections_vector.push[Fix](fixes, Fix{at: at + 1, len: from, text: row.to, pad: 0});
            if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
            at = at + from + 2;
            cnt;
        }
        at = at + 1;
    }
    ret err[A.Error].ok{};
}

fun spells(text: str, at: usize, word: str, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (text[at + i] != word[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun by_offset(x: *Fix, y: *Fix) i64 {
    if (x.at < y.at) { ret -1; }
    if (x.at > y.at) { ret 1; }
    ret 0;
}

# `text` with each fix applied, in offset order. two fixes of one byte are the
# rules contradicting each other, which is refused
fun splice(a: *A.Allocator, text: str, fixes: *Vector[Fix]) res[str, fail.Fail] {
    sort.sort_by[Fix](fixes.data, fixes.len, by_offset);
    var out: Vector[u8] = collections_vector.init[u8](a);
    fin { collections_vector.dnit[u8](?out); }
    val len:  usize = str_len(text);
    var from: usize = 0;
    var i:    usize = 0;
    for (i <= fixes.len) {
        var to: usize = len;
        if (i < fixes.len) { to = fixes.data[i].at; }
        if (to < from)     { ret res[str, fail.Fail].err{fail.message("internal: two migration rules rewrite the same bytes")}; }
        val kept: err[A.Error] = append(?out, text, from, to - from);
        if (sel kept.err)   { ret res[str, fail.Fail].err{fail.refused(kept.err)}; }
        if (i == fixes.len) { brk; }
        val fix:  *Fix         = ?fixes.data[i];
        val made: err[A.Error] = append(?out, fix.text, 0, str_len(fix.text));
        if (sel made.err) { ret res[str, fail.Fail].err{fail.refused(made.err)}; }
        var p: usize = 0;
        for (p < fix.pad) {
            val padded: err[A.Error] = append(?out, " ", 0, 1);
            if (sel padded.err) { ret res[str, fail.Fail].err{fail.refused(padded.err)}; }
            p = p + 1;
        }
        from = fix.at + fix.len;
        i    = i + 1;
    }
    # the copy reads its source as a nul-terminated string
    val ended: res[usize, A.Error] = collections_vector.push[u8](?out, 0);
    if (sel ended.err) { ret res[str, fail.Fail].err{fail.refused(ended.err)}; }
    val copied: res[str, StrError] = str_copy_slice(a, out.data::str, 0, out.len - 1);
    if (sel copied.err) { ret res[str, fail.Fail].err{fail.message(fail.str_text(copied.err))}; }
    ret res[str, fail.Fail].ok{copied.ok};
}

fun append(out: *Vector[u8], text: str, at: usize, len: usize) err[A.Error] {
    val room: res[usize, A.Error] = collections_vector.reserve[u8](out, len + 1);
    if (sel room.err) { ret err[A.Error].err{room.err}; }
    var i: usize = 0;
    for (i < len) {
        out.data[out.len] = text[at + i];
        collections_vector.commit[u8](out, 1);
        i = i + 1;
    }
    ret err[A.Error].ok{};
}
