use std.allocator.page;
use std.collections.map;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use P: std.types.path;
use O: std.types.option;
use R: std.types.result;

use mach.lang.diagnostic;
use mach.lang.embed;
use mach.lang.fe.ast;
use mach.lang.intern;
use mach.lang.module;
use mach.lang.query;
use mach.lang.source;
use mach.lang.target;
use mach.lang.type;

fwd module.ModuleId;
fwd module.MODULE_NIL;
fwd module.StableModuleId;
fwd module.STABLE_MODULE_NIL;

pub rec Overlay {
    path: str;
    text: str;
}

pub rec LinkProvider {
    name:      intern.StrId;
    is_static: bool;
}

pub rec LinkPublication {
    path:     str;
    revision: query.Revision;
    digest:   [32]u8;
}

pub rec Session {
    alloc:       *A.Allocator;
    build_alloc: *A.Allocator;
    sources:    source.SourceMap;
    diags:      diagnostic.DiagnosticStore;
    gate_diags: diagnostic.GateDiagLedger;
    interner:   intern.Interner;
    types:      type.TypeInterner;

    queries: query.QueryDb;

    module_asts:      **ast.Ast;
    module_ast_count: u32;
    module_ast_cap:   u32;

    module_fqns:      map.Map[module.ModuleId, intern.StrId];
    export_names:     map.Map[u64, intern.StrId];
    export_libraries: map.Map[u64, intern.StrId];
    type_aligns:      map.Map[u32, u32];
    type_packed:      map.Map[u32, u32];
    type_volatile:    map.Map[u32, u32];
    import_libraries: map.Map[intern.StrId, intern.StrId];

    link_providers:     *LinkProvider;
    link_provider_len:  u32;
    link_provider_cap:  u32;

    link_publications:     *LinkPublication;
    link_publication_len:  u32;
    link_publication_cap:  u32;

    module_sema:     map.Map[module.ModuleId, ptr];
    module_resolve:  map.Map[module.ModuleId, ptr];
    module_comptime: map.Map[module.ModuleId, ptr];

    stable_ids:     map.Map[intern.StrId, module.StableModuleId];
    stable_id_next: module.StableModuleId;

    stable_to_mid: map.Map[module.StableModuleId, module.ModuleId];

    registry: target.TargetRegistry;

    overlays:    *Overlay;
    overlay_len: u32;
    overlay_cap: u32;

    embeds: embed.EmbedCache;
}

val MODULE_AST_SEED_CAP: u32 = 16;

val OVERLAY_SEED_CAP: u32 = 4;

pub fun init(alloc: *A.Allocator) R.Result[Session, str] {
    var s: Session;
    s.alloc            = alloc;
    s.build_alloc      = alloc;
    s.sources          = source.init(alloc);
    s.diags            = diagnostic.store_init(alloc);
    s.gate_diags       = diagnostic.ledger_init(alloc);
    s.interner         = intern.init(alloc);
    s.module_asts      = nil;
    s.module_ast_count = 0;
    s.module_ast_cap   = 0;
    s.module_fqns      = map.init[module.ModuleId, intern.StrId](alloc, map.hash_u32, map.eq_u32);
    s.export_names     = map.init[u64, intern.StrId](alloc, map.hash_u64, map.eq_u64);
    s.export_libraries = map.init[u64, intern.StrId](alloc, map.hash_u64, map.eq_u64);
    s.type_aligns      = map.init[u32, u32](alloc, map.hash_u32, map.eq_u32);
    s.type_packed      = map.init[u32, u32](alloc, map.hash_u32, map.eq_u32);
    s.type_volatile    = map.init[u32, u32](alloc, map.hash_u32, map.eq_u32);
    s.import_libraries = map.init[intern.StrId, intern.StrId](alloc, map.hash_u32, map.eq_u32);
    s.link_providers     = nil;
    s.link_provider_len  = 0;
    s.link_provider_cap  = 0;
    s.link_publications     = nil;
    s.link_publication_len  = 0;
    s.link_publication_cap  = 0;
    s.module_sema      = map.init[module.ModuleId, ptr](alloc, map.hash_u32, map.eq_u32);
    s.module_resolve   = map.init[module.ModuleId, ptr](alloc, map.hash_u32, map.eq_u32);
    s.module_comptime  = map.init[module.ModuleId, ptr](alloc, map.hash_u32, map.eq_u32);
    s.stable_ids       = map.init[intern.StrId, module.StableModuleId](alloc, map.hash_u32, map.eq_u32);
    s.stable_id_next   = 0;
    s.stable_to_mid    = map.init[module.StableModuleId, module.ModuleId](alloc, map.hash_u32, map.eq_u32);
    s.registry         = target.registry_init();
    s.overlays         = nil;
    s.overlay_len      = 0;
    s.overlay_cap      = 0;
    s.embeds           = embed.init(alloc);

    val opt_types: O.Option[str] = type.init(?s.types, alloc);
    if (O.is_some[str](opt_types)) {
        intern.dnit(?s.interner);
        diagnostic.ledger_dnit(?s.gate_diags);
        diagnostic.store_dnit(?s.diags);
        source.dnit(?s.sources);
        ret R.err[Session, str](O.unwrap[str](opt_types));
    }

    val res_queries: R.Result[query.QueryDb, str] = query.init(alloc);
    if (R.is_err[query.QueryDb, str](res_queries)) {
        type.dnit(?s.types);
        intern.dnit(?s.interner);
        diagnostic.ledger_dnit(?s.gate_diags);
        diagnostic.store_dnit(?s.diags);
        source.dnit(?s.sources);
        ret R.err[Session, str](R.unwrap_err[query.QueryDb, str](res_queries));
    }
    s.queries = R.unwrap_ok[query.QueryDb, str](res_queries);

    val res_catalog: R.Result[R.Void, str] = register_catalog(?s.queries);
    if (R.is_err[R.Void, str](res_catalog)) {
        query.dnit(?s.queries);
        type.dnit(?s.types);
        intern.dnit(?s.interner);
        diagnostic.ledger_dnit(?s.gate_diags);
        diagnostic.store_dnit(?s.diags);
        source.dnit(?s.sources);
        ret R.err[Session, str](R.unwrap_err[R.Void, str](res_catalog));
    }

    ret R.ok[Session, str](s);
}

fun register_catalog(db: *query.QueryDb) R.Result[R.Void, str] {
    val res_root: R.Result[R.Void, str] = query.register_input(db, query.Q_PROJECT_ROOT);
    if (R.is_err[R.Void, str](res_root)) { ret res_root; }

    val res_target: R.Result[R.Void, str] = query.register_input(db, query.Q_TARGET);
    if (R.is_err[R.Void, str](res_target)) { ret res_target; }

    val res_text: R.Result[R.Void, str] = query.register_input(db, query.Q_FILE_TEXT);
    if (R.is_err[R.Void, str](res_text)) { ret res_text; }

    val res_number: R.Result[R.Void, str] = query.register_input(db, query.Q_MODULE_NUMBER);
    if (R.is_err[R.Void, str](res_number)) { ret res_number; }

    val res_link_cfg: R.Result[R.Void, str] = query.register_input(db, query.Q_LINK_CONFIG);
    if (R.is_err[R.Void, str](res_link_cfg)) { ret res_link_cfg; }


    val res_embed: R.Result[R.Void, str] = query.register_input(db, query.Q_EMBED_FILE);
    if (R.is_err[R.Void, str](res_embed)) { ret res_embed; }

    val res_codegen_flags: R.Result[R.Void, str] = query.register_input(db, query.Q_CODEGEN_FLAGS);
    if (R.is_err[R.Void, str](res_codegen_flags)) { ret res_codegen_flags; }

    val res_gate_terminal: R.Result[R.Void, str] = query.register_input(db, query.Q_GATE_TERMINAL);
    if (R.is_err[R.Void, str](res_gate_terminal)) { ret res_gate_terminal; }

    ret R.ok_void[str]();
}

pub fun dnit(s: *Session) {
    if (s == nil) { ret; }

    target.registry_dnit(?s.registry);

    if (s.overlays != nil && s.overlay_cap > 0) {
        var oi: u32 = 0;
        for (oi < s.overlay_len) {
            str_free(s.alloc, s.overlays[oi].path);
            str_free(s.alloc, s.overlays[oi].text);
            oi = oi + 1;
        }
        A.deallocate[Overlay](s.alloc, s.overlays, s.overlay_cap::usize);
        s.overlays    = nil;
        s.overlay_len = 0;
        s.overlay_cap = 0;
    }

    if (s.module_asts != nil && s.module_ast_cap > 0) {
        A.deallocate[*ast.Ast](s.alloc, s.module_asts, s.module_ast_cap::usize);
        s.module_asts      = nil;
        s.module_ast_count = 0;
        s.module_ast_cap   = 0;
    }

    map.dnit[module.ModuleId, intern.StrId](?s.module_fqns);
    map.dnit[u64, intern.StrId](?s.export_names);
    map.dnit[u64, intern.StrId](?s.export_libraries);
    map.dnit[u32, u32](?s.type_aligns);
    map.dnit[u32, u32](?s.type_packed);
    map.dnit[u32, u32](?s.type_volatile);
    map.dnit[intern.StrId, intern.StrId](?s.import_libraries);
    reset_link_providers(s);
    reset_link_publications(s);
    map.dnit[module.ModuleId, ptr](?s.module_sema);
    map.dnit[module.ModuleId, ptr](?s.module_resolve);
    map.dnit[module.ModuleId, ptr](?s.module_comptime);
    map.dnit[intern.StrId, module.StableModuleId](?s.stable_ids);
    map.dnit[module.StableModuleId, module.ModuleId](?s.stable_to_mid);

    query.dnit(?s.queries);
    embed.dnit(?s.embeds);
    type.dnit(?s.types);
    intern.dnit(?s.interner);
    diagnostic.ledger_dnit(?s.gate_diags);
    diagnostic.store_dnit(?s.diags);
    source.dnit(?s.sources);
}

pub fun reset_module_registry(s: *Session) {
    if (s == nil) { ret; }

    if (s.module_asts != nil && s.module_ast_cap > 0) {
        A.deallocate[*ast.Ast](s.alloc, s.module_asts, s.module_ast_cap::usize);
    }
    s.module_asts      = nil;
    s.module_ast_count = 0;
    s.module_ast_cap   = 0;

    map.clear[module.ModuleId, intern.StrId](?s.module_fqns);
    map.clear[u64, intern.StrId](?s.export_names);
    map.clear[u64, intern.StrId](?s.export_libraries);
    map.clear[u32, u32](?s.type_aligns);
    map.clear[u32, u32](?s.type_packed);
    map.clear[u32, u32](?s.type_volatile);
    map.clear[intern.StrId, intern.StrId](?s.import_libraries);
    reset_link_providers(s);
    map.clear[module.ModuleId, ptr](?s.module_sema);
    map.clear[module.ModuleId, ptr](?s.module_resolve);
    map.clear[module.ModuleId, ptr](?s.module_comptime);

    map.clear[module.StableModuleId, module.ModuleId](?s.stable_to_mid);
}

pub fun register_module_ast(s: *Session, mid: module.ModuleId, a: *ast.Ast) R.Result[R.Void, str] {
    val needed: u32 = mid::u32 + 1;
    if (needed > s.module_ast_cap) {
        var new_cap: u32 = s.module_ast_cap;
        if (new_cap == 0) { new_cap = MODULE_AST_SEED_CAP; }
        for (new_cap < needed) { new_cap = new_cap * 2; }

        if (s.module_asts == nil) {
            val res_alloc: R.Result[**ast.Ast, str] = A.allocate[*ast.Ast](s.alloc, new_cap::usize);
            if (R.is_err[**ast.Ast, str](res_alloc)) {
                ret R.err[R.Void, str](R.unwrap_err[**ast.Ast, str](res_alloc));
            }
            s.module_asts = R.unwrap_ok[**ast.Ast, str](res_alloc);
        } or {
            val res_realloc: R.Result[**ast.Ast, str] = A.reallocate[*ast.Ast](s.alloc, s.module_asts, s.module_ast_cap::usize, new_cap::usize);
            if (R.is_err[**ast.Ast, str](res_realloc)) {
                ret R.err[R.Void, str](R.unwrap_err[**ast.Ast, str](res_realloc));
            }
            s.module_asts = R.unwrap_ok[**ast.Ast, str](res_realloc);
        }

        var i: u32 = s.module_ast_cap;
        for (i < new_cap) {
            s.module_asts[i] = nil;
            i = i + 1;
        }
        s.module_ast_cap = new_cap;
    }

    s.module_asts[mid::u32] = a;
    if (needed > s.module_ast_count) { s.module_ast_count = needed; }
    ret R.ok_void[str]();
}

pub fun module_ast(s: *Session, mid: module.ModuleId) *ast.Ast {
    if (mid == module.MODULE_NIL)                               { ret nil; }
    if (s.module_asts == nil || mid::u32 >= s.module_ast_count) { ret nil; }
    ret s.module_asts[mid::u32];
}

pub fun module_count(s: *Session) u32 {
    ret s.module_ast_count;
}

pub fun register_module_fqn(s: *Session, mid: module.ModuleId, fqn: intern.StrId) R.Result[R.Void, str] {
    ret R.void_of[bool, str](map.insert[module.ModuleId, intern.StrId](?s.module_fqns, mid, fqn));
}

pub fun module_fqn(s: *Session, mid: module.ModuleId) intern.StrId {
    if (mid == module.MODULE_NIL) { ret intern.STR_NIL; }
    val res_get: R.Result[*intern.StrId, str] = map.get[module.ModuleId, intern.StrId](?s.module_fqns, ?mid);
    if (R.is_ok[*intern.StrId, str](res_get)) {
        ret @R.unwrap_ok[*intern.StrId, str](res_get);
    }
    ret intern.STR_NIL;
}

pub fun stable_module_id(s: *Session, fqn: intern.StrId) R.Result[module.StableModuleId, str] {
    val res_get: R.Result[*module.StableModuleId, str] = map.get[intern.StrId, module.StableModuleId](?s.stable_ids, ?fqn);
    if (R.is_ok[*module.StableModuleId, str](res_get)) {
        ret R.ok[module.StableModuleId, str](@R.unwrap_ok[*module.StableModuleId, str](res_get));
    }

    val id: module.StableModuleId = s.stable_id_next;
    val res_insert: R.Result[bool, str] = map.insert[intern.StrId, module.StableModuleId](?s.stable_ids, fqn, id);
    if (R.is_err[bool, str](res_insert)) {
        ret R.err[module.StableModuleId, str](R.unwrap_err[bool, str](res_insert));
    }
    s.stable_id_next = s.stable_id_next + 1;
    ret R.ok[module.StableModuleId, str](id);
}

pub fun stable_module_id_lookup(s: *Session, fqn: intern.StrId) module.StableModuleId {
    val res_get: R.Result[*module.StableModuleId, str] = map.get[intern.StrId, module.StableModuleId](?s.stable_ids, ?fqn);
    if (R.is_ok[*module.StableModuleId, str](res_get)) {
        ret @R.unwrap_ok[*module.StableModuleId, str](res_get);
    }
    ret module.STABLE_MODULE_NIL;
}

pub fun register_stable_mid(s: *Session, stable: module.StableModuleId, mid: module.ModuleId) R.Result[R.Void, str] {
    ret R.void_of[bool, str](map.insert[module.StableModuleId, module.ModuleId](?s.stable_to_mid, stable, mid));
}

pub fun module_id_for_stable(s: *Session, stable: module.StableModuleId) module.ModuleId {
    if (stable == module.STABLE_MODULE_NIL) { ret module.MODULE_NIL; }
    val res_get: R.Result[*module.ModuleId, str] = map.get[module.StableModuleId, module.ModuleId](?s.stable_to_mid, ?stable);
    if (R.is_ok[*module.ModuleId, str](res_get)) {
        ret @R.unwrap_ok[*module.ModuleId, str](res_get);
    }
    ret module.MODULE_NIL;
}

pub fun register_export_name(s: *Session, mid: module.ModuleId, did: u32, name: intern.StrId) R.Result[R.Void, str] {
    val key: u64 = (mid::u64 << 32) | did::u64;
    ret R.void_of[bool, str](map.insert[u64, intern.StrId](?s.export_names, key, name));
}

pub fun export_name(s: *Session, mid: module.ModuleId, did: u32) O.Option[intern.StrId] {
    var key: u64 = (mid::u64 << 32) | did::u64;
    val res_get: R.Result[*intern.StrId, str] = map.get[u64, intern.StrId](?s.export_names, ?key);
    if (R.is_ok[*intern.StrId, str](res_get)) {
        ret O.some[intern.StrId](@R.unwrap_ok[*intern.StrId, str](res_get));
    }
    ret O.none[intern.StrId]();
}

pub fun register_export_library(s: *Session, mid: module.ModuleId, did: u32, lib: intern.StrId) R.Result[R.Void, str] {
    val key: u64 = (mid::u64 << 32) | did::u64;
    ret R.void_of[bool, str](map.insert[u64, intern.StrId](?s.export_libraries, key, lib));
}

pub fun export_library(s: *Session, mid: module.ModuleId, did: u32) O.Option[intern.StrId] {
    var key: u64 = (mid::u64 << 32) | did::u64;
    val res_get: R.Result[*intern.StrId, str] = map.get[u64, intern.StrId](?s.export_libraries, ?key);
    if (R.is_ok[*intern.StrId, str](res_get)) {
        ret O.some[intern.StrId](@R.unwrap_ok[*intern.StrId, str](res_get));
    }
    ret O.none[intern.StrId]();
}

pub fun register_type_align(s: *Session, tid: u32, align: u32) R.Result[R.Void, str] {
    ret R.void_of[bool, str](map.insert[u32, u32](?s.type_aligns, tid, align));
}

pub fun register_type_packed(s: *Session, tid: u32) R.Result[R.Void, str] {
    ret R.void_of[bool, str](map.insert[u32, u32](?s.type_packed, tid, 1));
}

pub fun type_is_packed(s: *Session, tid: u32) bool {
    ret R.is_ok[*u32, str](map.get[u32, u32](?s.type_packed, ?tid));
}

pub fun register_type_volatile(s: *Session, tid: u32) R.Result[R.Void, str] {
    ret R.void_of[bool, str](map.insert[u32, u32](?s.type_volatile, tid, 1));
}

pub fun type_is_volatile(s: *Session, tid: u32) bool {
    ret R.is_ok[*u32, str](map.get[u32, u32](?s.type_volatile, ?tid));
}

pub fun type_align(s: *Session, tid: u32) O.Option[u32] {
    val res_get: R.Result[*u32, str] = map.get[u32, u32](?s.type_aligns, ?tid);
    if (R.is_ok[*u32, str](res_get)) {
        ret O.some[u32](@R.unwrap_ok[*u32, str](res_get));
    }
    ret O.none[u32]();
}

pub fun register_import_library(s: *Session, name: intern.StrId, lib: intern.StrId) R.Result[R.Void, str] {
    ret R.void_of[bool, str](map.insert[intern.StrId, intern.StrId](?s.import_libraries, name, lib));
}

pub fun import_library(s: *Session, name: intern.StrId) O.Option[intern.StrId] {
    val res_get: R.Result[*intern.StrId, str] = map.get[intern.StrId, intern.StrId](?s.import_libraries, ?name);
    if (R.is_ok[*intern.StrId, str](res_get)) {
        ret O.some[intern.StrId](@R.unwrap_ok[*intern.StrId, str](res_get));
    }
    ret O.none[intern.StrId]();
}

val LINK_PROVIDER_SEED_CAP: u32 = 8;

val LINK_PUBLICATION_SEED_CAP: u32 = 4;

pub fun register_link_provider(s: *Session, name: intern.StrId, is_static: bool) R.Result[R.Void, str] {
    if (name == intern.STR_NIL) { ret R.ok_void[str](); }

    var i: u32 = 0;
    for (i < s.link_provider_len) {
        if (s.link_providers[i].name == name) {
            if (!is_static) { s.link_providers[i].is_static = false; }
            ret R.ok_void[str]();
        }
        i = i + 1;
    }

    if (s.link_provider_len == s.link_provider_cap) {
        var next: u32 = LINK_PROVIDER_SEED_CAP;
        if (s.link_provider_cap > 0) { next = s.link_provider_cap * 2; }
        if (s.link_providers == nil) {
            val ar: R.Result[*LinkProvider, str] = A.allocate[LinkProvider](s.alloc, next::usize);
            if (R.is_err[*LinkProvider, str](ar)) {
                ret R.err[R.Void, str](R.unwrap_err[*LinkProvider, str](ar));
            }
            s.link_providers = R.unwrap_ok[*LinkProvider, str](ar);
        }
        or {
            val gr: R.Result[*LinkProvider, str] = A.reallocate[LinkProvider](
                s.alloc, s.link_providers, s.link_provider_cap::usize, next::usize);
            if (R.is_err[*LinkProvider, str](gr)) {
                ret R.err[R.Void, str](R.unwrap_err[*LinkProvider, str](gr));
            }
            s.link_providers = R.unwrap_ok[*LinkProvider, str](gr);
        }
        s.link_provider_cap = next;
    }

    s.link_providers[s.link_provider_len].name      = name;
    s.link_providers[s.link_provider_len].is_static = is_static;
    s.link_provider_len = s.link_provider_len + 1;
    ret R.ok_void[str]();
}

pub fun link_provider(s: *Session, name: intern.StrId) O.Option[LinkProvider] {
    var i: u32 = 0;
    for (i < s.link_provider_len) {
        if (s.link_providers[i].name == name) {
            ret O.some[LinkProvider](s.link_providers[i]);
        }
        i = i + 1;
    }
    ret O.none[LinkProvider]();
}

pub fun link_providers(s: *Session) *LinkProvider { ret s.link_providers; }

pub fun link_provider_count(s: *Session) u32 { ret s.link_provider_len; }

pub fun reset_link_providers(s: *Session) {
    if (s.link_providers != nil && s.link_provider_cap > 0) {
        A.deallocate[LinkProvider](s.alloc, s.link_providers, s.link_provider_cap::usize);
    }
    s.link_providers    = nil;
    s.link_provider_len = 0;
    s.link_provider_cap = 0;
}

pub fun record_link_publication(s: *Session, path: str, revision: query.Revision, digest: *[32]u8) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < s.link_publication_len) {
        if (str_equals(s.link_publications[i].path, path)) {
            s.link_publications[i].revision = revision;
            s.link_publications[i].digest   = @digest;
            ret R.ok_void[str]();
        }
        i = i + 1;
    }

    val dup_r: R.Result[str, str] = str_dup(s.alloc, path);
    if (R.is_err[str, str](dup_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](dup_r)); }
    val dup: str = R.unwrap_ok[str, str](dup_r);

    if (s.link_publication_len == s.link_publication_cap) {
        var next: u32 = LINK_PUBLICATION_SEED_CAP;
        if (s.link_publication_cap > 0) { next = s.link_publication_cap * 2; }
        if (s.link_publications == nil) {
            val ar: R.Result[*LinkPublication, str] = A.allocate[LinkPublication](s.alloc, next::usize);
            if (R.is_err[*LinkPublication, str](ar)) {
                str_free(s.alloc, dup);
                ret R.err[R.Void, str](R.unwrap_err[*LinkPublication, str](ar));
            }
            s.link_publications = R.unwrap_ok[*LinkPublication, str](ar);
        }
        or {
            val gr: R.Result[*LinkPublication, str] = A.reallocate[LinkPublication](
                s.alloc, s.link_publications, s.link_publication_cap::usize, next::usize);
            if (R.is_err[*LinkPublication, str](gr)) {
                str_free(s.alloc, dup);
                ret R.err[R.Void, str](R.unwrap_err[*LinkPublication, str](gr));
            }
            s.link_publications = R.unwrap_ok[*LinkPublication, str](gr);
        }
        s.link_publication_cap = next;
    }

    s.link_publications[s.link_publication_len].path     = dup;
    s.link_publications[s.link_publication_len].revision = revision;
    s.link_publications[s.link_publication_len].digest   = @digest;
    s.link_publication_len = s.link_publication_len + 1;
    ret R.ok_void[str]();
}

pub fun lookup_link_publication(s: *Session, path: str, revision: query.Revision, out: *[32]u8) bool {
    var i: u32 = 0;
    for (i < s.link_publication_len) {
        if (str_equals(s.link_publications[i].path, path)) {
            if (s.link_publications[i].revision != revision) { ret false; }
            @out = s.link_publications[i].digest;
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

pub fun reset_link_publications(s: *Session) {
    if (s.link_publications != nil && s.link_publication_cap > 0) {
        var i: u32 = 0;
        for (i < s.link_publication_len) {
            str_free(s.alloc, s.link_publications[i].path);
            i = i + 1;
        }
        A.deallocate[LinkPublication](s.alloc, s.link_publications, s.link_publication_cap::usize);
    }
    s.link_publications    = nil;
    s.link_publication_len = 0;
    s.link_publication_cap = 0;
}

pub fun register_module_sema(s: *Session, mid: module.ModuleId, p: ptr) R.Result[R.Void, str] {
    ret R.void_of[bool, str](map.insert[module.ModuleId, ptr](?s.module_sema, mid, p));
}

pub fun module_sema_ptr(s: *Session, mid: module.ModuleId) ptr {
    val res_get: R.Result[*ptr, str] = map.get[module.ModuleId, ptr](?s.module_sema, ?mid);
    if (R.is_ok[*ptr, str](res_get)) {
        ret @R.unwrap_ok[*ptr, str](res_get);
    }
    ret nil;
}

pub fun register_module_resolve(s: *Session, mid: module.ModuleId, p: ptr) R.Result[R.Void, str] {
    ret R.void_of[bool, str](map.insert[module.ModuleId, ptr](?s.module_resolve, mid, p));
}

pub fun module_resolve_ptr(s: *Session, mid: module.ModuleId) ptr {
    val res_get: R.Result[*ptr, str] = map.get[module.ModuleId, ptr](?s.module_resolve, ?mid);
    if (R.is_ok[*ptr, str](res_get)) {
        ret @R.unwrap_ok[*ptr, str](res_get);
    }
    ret nil;
}

pub fun register_module_comptime(s: *Session, mid: module.ModuleId, p: ptr) R.Result[R.Void, str] {
    ret R.void_of[bool, str](map.insert[module.ModuleId, ptr](?s.module_comptime, mid, p));
}

pub fun register_module_phase(s: *Session, mid: module.ModuleId, sema: ptr, resolve: ptr,
                              comptime_ctx: ptr) R.Result[R.Void, str] {
    var key: module.ModuleId = mid;
    val rs: R.Result[R.Void, str] = register_module_sema(s, mid, sema);
    if (R.is_err[R.Void, str](rs)) { ret rs; }
    val rr: R.Result[R.Void, str] = register_module_resolve(s, mid, resolve);
    if (R.is_err[R.Void, str](rr)) {
        map.remove[module.ModuleId, ptr](?s.module_sema, ?key);
        ret rr;
    }
    val rc: R.Result[R.Void, str] = register_module_comptime(s, mid, comptime_ctx);
    if (R.is_err[R.Void, str](rc)) {
        map.remove[module.ModuleId, ptr](?s.module_sema, ?key);
        map.remove[module.ModuleId, ptr](?s.module_resolve, ?key);
        ret rc;
    }
    ret R.ok_void[str]();
}

pub fun register_module_identity(s: *Session, mid: module.ModuleId, a: *ast.Ast,
                                 fqn: intern.StrId, stable: module.StableModuleId) R.Result[R.Void, str] {
    val prior_count: u32 = s.module_ast_count;
    var key: module.ModuleId = mid;
    var skey: module.StableModuleId = stable;

    val ra: R.Result[R.Void, str] = register_module_ast(s, mid, a);
    if (R.is_err[R.Void, str](ra)) { ret ra; }
    val rf: R.Result[R.Void, str] = register_module_fqn(s, mid, fqn);
    if (R.is_err[R.Void, str](rf)) {
        s.module_asts[mid::u32] = nil;
        s.module_ast_count      = prior_count;
        ret rf;
    }
    val rm: R.Result[R.Void, str] = register_stable_mid(s, stable, mid);
    if (R.is_err[R.Void, str](rm)) {
        s.module_asts[mid::u32] = nil;
        s.module_ast_count      = prior_count;
        map.remove[module.ModuleId, intern.StrId](?s.module_fqns, ?key);
        ret rm;
    }
    ret R.ok_void[str]();
}

pub fun unregister_module_identity(s: *Session, mid: module.ModuleId, stable: module.StableModuleId) {
    var key: module.ModuleId = mid;
    var skey: module.StableModuleId = stable;
    if (s.module_asts != nil && mid::u32 < s.module_ast_cap) { s.module_asts[mid::u32] = nil; }
    map.remove[module.ModuleId, intern.StrId](?s.module_fqns, ?key);
    map.remove[module.StableModuleId, module.ModuleId](?s.stable_to_mid, ?skey);
}

pub fun module_comptime_ptr(s: *Session, mid: module.ModuleId) ptr {
    val res_get: R.Result[*ptr, str] = map.get[module.ModuleId, ptr](?s.module_comptime, ?mid);
    if (R.is_ok[*ptr, str](res_get)) {
        ret @R.unwrap_ok[*ptr, str](res_get);
    }
    ret nil;
}

pub fun load_source(s: *Session, path: str, text: str) R.Result[source.FileId, str] {
    val res_fid: R.Result[source.FileId, str] = source.load(?s.sources, ?s.interner, path, text);
    if (R.is_err[source.FileId, str](res_fid)) {
        ret res_fid;
    }
    val fid: source.FileId = R.unwrap_ok[source.FileId, str](res_fid);

    val res_input: R.Result[R.Void, str] = query.set_input(?s.queries, query.Q_FILE_TEXT, fid::u64, text::*u8, str_len(text)::u32);
    if (R.is_err[R.Void, str](res_input)) {
        ret R.err[source.FileId, str](R.unwrap_err[R.Void, str](res_input));
    }
    ret R.ok[source.FileId, str](fid);
}

pub fun set_overlay(s: *Session, path: str, text: str) R.Result[R.Void, str] {
    val key_r: R.Result[str, str] = overlay_key(s, path);
    if (R.is_err[str, str](key_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](key_r)); }
    val key: str = R.unwrap_ok[str, str](key_r);

    val dup_text_r: R.Result[str, str] = str_dup(s.alloc, text);
    if (R.is_err[str, str](dup_text_r)) {
        str_free(s.alloc, key);
        ret R.err[R.Void, str](R.unwrap_err[str, str](dup_text_r));
    }
    val dup_text: str = R.unwrap_ok[str, str](dup_text_r);

    var i: u32 = 0;
    for (i < s.overlay_len) {
        if (str_equals(s.overlays[i].path, key)) {
            str_free(s.alloc, s.overlays[i].text);
            s.overlays[i].text = dup_text;
            str_free(s.alloc, key);
            ret R.ok_void[str]();
        }
        i = i + 1;
    }

    val res_grow: R.Result[R.Void, str] = overlays_reserve(s, s.overlay_len + 1);
    if (R.is_err[R.Void, str](res_grow)) {
        str_free(s.alloc, dup_text);
        str_free(s.alloc, key);
        ret res_grow;
    }
    s.overlays[s.overlay_len].path = key;
    s.overlays[s.overlay_len].text = dup_text;
    s.overlay_len = s.overlay_len + 1;
    ret R.ok_void[str]();
}

pub fun clear_overlay(s: *Session, path: str) bool {
    val key_r: R.Result[str, str] = overlay_key(s, path);
    if (R.is_err[str, str](key_r)) { ret false; }
    val key: str = R.unwrap_ok[str, str](key_r);

    var i: u32 = 0;
    for (i < s.overlay_len) {
        if (str_equals(s.overlays[i].path, key)) {
            str_free(s.alloc, key);
            str_free(s.alloc, s.overlays[i].path);
            str_free(s.alloc, s.overlays[i].text);
            val last: u32 = s.overlay_len - 1;
            if (i != last) { s.overlays[i] = s.overlays[last]; }
            s.overlay_len = last;
            ret true;
        }
        i = i + 1;
    }
    str_free(s.alloc, key);
    ret false;
}

pub fun overlay_get(s: *Session, path: str) O.Option[str] {
    val key_r: R.Result[str, str] = overlay_key(s, path);
    if (R.is_err[str, str](key_r)) { ret O.none[str](); }
    val key: str = R.unwrap_ok[str, str](key_r);

    var i: u32 = 0;
    for (i < s.overlay_len) {
        if (str_equals(s.overlays[i].path, key)) {
            str_free(s.alloc, key);
            ret O.some[str](s.overlays[i].text);
        }
        i = i + 1;
    }
    str_free(s.alloc, key);
    ret O.none[str]();
}

fun overlay_key(s: *Session, path: str) R.Result[str, str] {
    ret P.clean(s.alloc, path);
}

fun overlays_reserve(s: *Session, need: u32) R.Result[R.Void, str] {
    if (need <= s.overlay_cap) { ret R.ok_void[str](); }

    var new_cap: u32 = s.overlay_cap;
    if (new_cap == 0) { new_cap = OVERLAY_SEED_CAP; }
    for (new_cap < need) { new_cap = new_cap * 2; }

    if (s.overlays == nil) {
        val res_alloc: R.Result[*Overlay, str] = A.allocate[Overlay](s.alloc, new_cap::usize);
        if (R.is_err[*Overlay, str](res_alloc)) { ret R.err[R.Void, str](R.unwrap_err[*Overlay, str](res_alloc)); }
        s.overlays = R.unwrap_ok[*Overlay, str](res_alloc);
    }
    or {
        val res_realloc: R.Result[*Overlay, str] = A.reallocate[Overlay](s.alloc, s.overlays, s.overlay_cap::usize, new_cap::usize);
        if (R.is_err[*Overlay, str](res_realloc)) { ret R.err[R.Void, str](R.unwrap_err[*Overlay, str](res_realloc)); }
        s.overlays = R.unwrap_ok[*Overlay, str](res_realloc);
    }
    s.overlay_cap = new_cap;
    ret R.ok_void[str]();
}

test "mach.lang.session.overlay:set_get_replace_clear" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[Session, str] = init(?alloc);
    if (R.is_err[Session, str](sr)) { ret 1; }
    var s: Session = R.unwrap_ok[Session, str](sr);

    var bad: i32 = 0;

    if (O.is_some[str](overlay_get(?s, "/x/a.mach"))) { bad = 1; }
    if (clear_overlay(?s, "/x/a.mach"))               { bad = 1; }

    if (R.is_err[R.Void, str](set_overlay(?s, "/x/a.mach", "AAA"))) { dnit(?s); ret 1; }
    if (R.is_err[R.Void, str](set_overlay(?s, "/x/b.mach", "BBB"))) { dnit(?s); ret 1; }
    if (s.overlay_len != 2) { bad = 1; }
    val ga: O.Option[str] = overlay_get(?s, "/x/a.mach");
    val gb: O.Option[str] = overlay_get(?s, "/x/b.mach");
    if (O.is_none[str](ga) || !str_equals(O.unwrap[str](ga), "AAA")) { bad = 1; }
    if (O.is_none[str](gb) || !str_equals(O.unwrap[str](gb), "BBB")) { bad = 1; }

    if (R.is_err[R.Void, str](set_overlay(?s, "/x/a.mach", "A2"))) { dnit(?s); ret 1; }
    if (s.overlay_len != 2) { bad = 1; }
    val ga2: O.Option[str] = overlay_get(?s, "/x/a.mach");
    if (O.is_none[str](ga2) || !str_equals(O.unwrap[str](ga2), "A2")) { bad = 1; }

    if (!clear_overlay(?s, "/x/a.mach"))              { bad = 1; }
    if (s.overlay_len != 1)                           { bad = 1; }
    if (O.is_some[str](overlay_get(?s, "/x/a.mach"))) { bad = 1; }
    val gb2: O.Option[str] = overlay_get(?s, "/x/b.mach");
    if (O.is_none[str](gb2) || !str_equals(O.unwrap[str](gb2), "BBB")) { bad = 1; }

    dnit(?s);
    ret bad;
}

test "mach.lang.session.overlay:one_file_is_one_entry_however_it_is_spelled" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[Session, str] = init(?alloc);
    if (R.is_err[Session, str](sr)) { ret 1; }
    var s: Session = R.unwrap_ok[Session, str](sr);

    var bad: i32 = 0;

    if (R.is_err[R.Void, str](set_overlay(?s, "/x/src/a.mach", "LIVE"))) { dnit(?s); ret 1; }

    if (!ut_overlay_is(?s, "/x/./src/a.mach", "LIVE")      && bad == 0) { bad = 1; }
    if (!ut_overlay_is(?s, "/x//src/a.mach", "LIVE")       && bad == 0) { bad = 2; }
    if (!ut_overlay_is(?s, "/x/src/./a.mach", "LIVE")      && bad == 0) { bad = 3; }
    if (!ut_overlay_is(?s, "/x/lib/../src/a.mach", "LIVE") && bad == 0) { bad = 4; }

    if (R.is_err[R.Void, str](set_overlay(?s, "/x/./src/a.mach", "NEWER"))) { dnit(?s); ret 1; }
    if (s.overlay_len != 1                            && bad == 0) { bad = 5; }
    if (!ut_overlay_is(?s, "/x/src/a.mach", "NEWER")  && bad == 0) { bad = 6; }

    if (O.is_some[str](overlay_get(?s, "/x/src/b.mach")) && bad == 0) { bad = 7; }
    if (O.is_some[str](overlay_get(?s, "/src/a.mach"))   && bad == 0) { bad = 8; }

    if (!clear_overlay(?s, "/x//src/a.mach") && bad == 0) { bad = 9; }
    if (s.overlay_len != 0                   && bad == 0) { bad = 10; }

    dnit(?s);
    ret bad;
}

fun ut_overlay_is(s: *Session, path: str, want: str) bool {
    val g: O.Option[str] = overlay_get(s, path);
    if (O.is_none[str](g)) { ret false; }
    ret str_equals(O.unwrap[str](g), want);
}

test "mach.lang.session.link_provider:order_dedup_upgrade_reset" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[Session, str] = init(?alloc);
    if (R.is_err[Session, str](sr)) { ret 1; }
    var s: Session = R.unwrap_ok[Session, str](sr);

    var bad: i32 = 0;

    val a_r: R.Result[intern.StrId, str] = intern.intern(?s.interner, "alpha");
    val b_r: R.Result[intern.StrId, str] = intern.intern(?s.interner, "beta");
    val c_r: R.Result[intern.StrId, str] = intern.intern(?s.interner, "gamma");
    if (R.is_err[intern.StrId, str](a_r) || R.is_err[intern.StrId, str](b_r)
        || R.is_err[intern.StrId, str](c_r)) { dnit(?s); ret 1; }
    val a: intern.StrId = R.unwrap_ok[intern.StrId, str](a_r);
    val b: intern.StrId = R.unwrap_ok[intern.StrId, str](b_r);
    val c: intern.StrId = R.unwrap_ok[intern.StrId, str](c_r);

    if (link_provider_count(?s) != 0)               { bad = 1; }
    if (O.is_some[LinkProvider](link_provider(?s, a))) { bad = 1; }

    if (R.is_err[R.Void, str](register_link_provider(?s, intern.STR_NIL, true))) { dnit(?s); ret 1; }
    if (link_provider_count(?s) != 0) { bad = 1; }

    if (R.is_err[R.Void, str](register_link_provider(?s, a, true)))  { dnit(?s); ret 1; }
    if (R.is_err[R.Void, str](register_link_provider(?s, b, false))) { dnit(?s); ret 1; }
    if (link_provider_count(?s) != 2) { bad = 1; }
    if (link_providers(?s)[0].name != a || !link_providers(?s)[0].is_static) { bad = 1; }
    if (link_providers(?s)[1].name != b ||  link_providers(?s)[1].is_static) { bad = 1; }

    if (R.is_err[R.Void, str](register_link_provider(?s, b, true))) { dnit(?s); ret 1; }
    if (link_provider_count(?s) != 2) { bad = 1; }
    if (link_providers(?s)[1].is_static) { bad = 1; }

    if (R.is_err[R.Void, str](register_link_provider(?s, a, false))) { dnit(?s); ret 1; }
    if (link_provider_count(?s) != 2) { bad = 1; }
    val pa: O.Option[LinkProvider] = link_provider(?s, a);
    if (O.is_none[LinkProvider](pa) || O.unwrap[LinkProvider](pa).is_static) { bad = 1; }

    if (O.is_some[LinkProvider](link_provider(?s, c))) { bad = 1; }

    if (R.is_err[R.Void, str](register_link_provider(?s, c, true)))     { dnit(?s); ret 1; }
    var fill: [3]u8;
    fill[0] = 'd';
    fill[2] = 0;
    var i: u32 = 0;
    for (i < 8) {
        fill[1] = ('0'::u32 + i)::u8;
        val nr: R.Result[intern.StrId, str] = intern.intern(?s.interner, (?fill[0])::str);
        if (R.is_err[intern.StrId, str](nr)) { dnit(?s); ret 1; }
        if (R.is_err[R.Void, str](register_link_provider(
                ?s, R.unwrap_ok[intern.StrId, str](nr), true))) { dnit(?s); ret 1; }
        i = i + 1;
    }
    if (link_provider_count(?s) != 11) { bad = 1; }
    if (link_providers(?s)[0].name != a) { bad = 1; }
    val pc: O.Option[LinkProvider] = link_provider(?s, c);
    if (O.is_none[LinkProvider](pc) || !O.unwrap[LinkProvider](pc).is_static) { bad = 1; }

    reset_link_providers(?s);
    if (link_provider_count(?s) != 0)                  { bad = 1; }
    if (O.is_some[LinkProvider](link_provider(?s, a))) { bad = 1; }

    if (R.is_err[R.Void, str](register_link_provider(?s, c, false))) { dnit(?s); ret 1; }
    if (link_provider_count(?s) != 1) { bad = 1; }

    dnit(?s);
    ret bad;
}
