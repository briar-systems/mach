fwd module.ModuleId;
fwd module.MODULE_NIL;
fwd module.StableModuleId;
fwd module.STABLE_MODULE_NIL;

pub rec Overlay {
    path: str;
    text: str;
}

pub rec LinkProvider {
    name:      intern.StrId;
    is_static: bool;
}

pub rec LinkPublication {
    path:     str;
    revision: query.Revision;
    digest:   [32]u8;
}

pub rec Session {
    view_generation: u64;
    alloc:       *A.Allocator;
    build_alloc: *A.Allocator;
    sources:    source.SourceMap;
    diags:      diagnostic.DiagnosticStore;
    interner:   intern.Interner;
    types:      type.TypeInterner;

    queries: query.QueryDb;
    query_presentation: *query.Presentation;
    query_failure_message: str;
    parse_sequence: u64;

    module_asts:      **ast.Ast;
    module_ast_count: u32;
    module_ast_cap:   u32;

    module_fqns:      map.Map[module.ModuleId, intern.StrId];
    export_names:     map.Map[u64, intern.StrId];
    export_libraries: map.Map[u64, intern.StrId];
    type_aligns:      map.Map[u32, u32];
    type_packed:      map.Map[u32, u32];
    type_volatile:    map.Map[u32, u32];
    import_libraries: map.Map[intern.StrId, intern.StrId];

    link_providers:     *LinkProvider;
    link_provider_len:  u32;
    link_provider_cap:  u32;

    link_publications:     *LinkPublication;
    link_publication_len:  u32;
    link_publication_cap:  u32;

    module_sema:     map.Map[module.ModuleId, ptr];
    module_resolve:  map.Map[module.ModuleId, ptr];
    module_comptime: map.Map[module.ModuleId, ptr];

    stable_ids:     map.Map[intern.StrId, module.StableModuleId];
    stable_id_next: module.StableModuleId;

    stable_to_mid: map.Map[module.StableModuleId, module.ModuleId];

    registry: target.TargetRegistry;

    overlays:    *Overlay;
    overlay_len: u32;
    overlay_cap: u32;

    embeds: embed.EmbedCache;
}

val MODULE_AST_SEED_CAP: u32 = 16;

val OVERLAY_SEED_CAP: u32 = 4;

pub fun init(alloc: *A.Allocator) res[Session, fail.Fail] {
    var s: Session;
    s.alloc            = alloc;
    s.parse_sequence   = 0;
    s.build_alloc      = alloc;
    s.view_generation = 1;
    s.sources          = source.init(alloc);
    s.diags            = diagnostic.store_init(alloc);
    s.query_presentation = nil;
    s.query_failure_message = nil;

    s.interner         = intern.init(alloc);
    s.module_asts      = nil;
    s.module_ast_count = 0;
    s.module_ast_cap   = 0;
    s.module_fqns      = map.init[module.ModuleId, intern.StrId](alloc, map.hash_u32, map.eq_u32);
    s.export_names     = map.init[u64, intern.StrId](alloc, map.hash_u64, map.eq_u64);
    s.export_libraries = map.init[u64, intern.StrId](alloc, map.hash_u64, map.eq_u64);
    s.type_aligns      = map.init[u32, u32](alloc, map.hash_u32, map.eq_u32);
    s.type_packed      = map.init[u32, u32](alloc, map.hash_u32, map.eq_u32);
    s.type_volatile    = map.init[u32, u32](alloc, map.hash_u32, map.eq_u32);
    s.import_libraries = map.init[intern.StrId, intern.StrId](alloc, map.hash_u32, map.eq_u32);
    s.link_providers     = nil;
    s.link_provider_len  = 0;
    s.link_provider_cap  = 0;
    s.link_publications     = nil;
    s.link_publication_len  = 0;
    s.link_publication_cap  = 0;
    s.module_sema      = map.init[module.ModuleId, ptr](alloc, map.hash_u32, map.eq_u32);
    s.module_resolve   = map.init[module.ModuleId, ptr](alloc, map.hash_u32, map.eq_u32);
    s.module_comptime  = map.init[module.ModuleId, ptr](alloc, map.hash_u32, map.eq_u32);
    s.stable_ids       = map.init[intern.StrId, module.StableModuleId](alloc, map.hash_u32, map.eq_u32);
    s.stable_id_next   = 0;
    s.stable_to_mid    = map.init[module.StableModuleId, module.ModuleId](alloc, map.hash_u32, map.eq_u32);
    s.registry         = target.registry_init();
    s.overlays         = nil;
    s.overlay_len      = 0;
    s.overlay_cap      = 0;
    s.embeds           = embed.init(alloc);

    val opt_types: err[fail.Fail] = type.init(?s.types, alloc);
    if (sel opt_types.err) {
        intern.dnit(?s.interner);

        diagnostic.store_dnit(?s.diags);
        source.dnit(?s.sources);
        ret res[Session, fail.Fail].err{opt_types.err};
    }

    val res_queries: res[query.QueryDb, fail.Fail] = query.init(alloc);
    if (sel res_queries.err) {
        type.dnit(?s.types);
        intern.dnit(?s.interner);

        diagnostic.store_dnit(?s.diags);
        source.dnit(?s.sources);
        ret res[Session, fail.Fail].err{res_queries.err};
    }
    s.queries = res_queries.ok;

    val res_catalog: err[fail.Fail] = register_catalog(?s.queries);
    if (sel res_catalog.err) {
        query.dnit(?s.queries);
        type.dnit(?s.types);
        intern.dnit(?s.interner);

        diagnostic.store_dnit(?s.diags);
        source.dnit(?s.sources);
        ret res[Session, fail.Fail].err{res_catalog.err};
    }

    ret res[Session, fail.Fail].ok{s};
}

fun register_catalog(db: *query.QueryDb) err[fail.Fail] {
    val res_root: err[fail.Fail] = query.register_input(db, query.Q_PROJECT_ROOT);
    if (sel res_root.err) { ret res_root; }

    val res_target: err[fail.Fail] = query.register_input(db, query.Q_TARGET);
    if (sel res_target.err) { ret res_target; }

    val res_text: err[fail.Fail] = query.register_input(db, query.Q_FILE_TEXT);
    if (sel res_text.err) { ret res_text; }

    val res_number: err[fail.Fail] = query.register_input(db, query.Q_MODULE_NUMBER);
    if (sel res_number.err) { ret res_number; }

    val res_link_cfg: err[fail.Fail] = query.register_input(db, query.Q_LINK_CONFIG);
    if (sel res_link_cfg.err) { ret res_link_cfg; }

    val res_embed: err[fail.Fail] = query.register_input(db, query.Q_EMBED_FILE);
    if (sel res_embed.err) { ret res_embed; }

    val res_codegen_flags: err[fail.Fail] = query.register_input(db, query.Q_CODEGEN_FLAGS);
    if (sel res_codegen_flags.err) { ret res_codegen_flags; }

    val res_gate_terminal: err[fail.Fail] = query.register_input(db, query.Q_GATE_TERMINAL);
    if (sel res_gate_terminal.err) { ret res_gate_terminal; }

    ret err[fail.Fail].ok{};
}

pub fun dnit(s: *Session) {
    if (s == nil) { ret; }

    target.registry_dnit(?s.registry);

    if (s.overlays != nil && s.overlay_cap > 0) {
        var oi: u32 = 0;
        for (oi < s.overlay_len) {
            str_free(s.alloc, s.overlays[oi].path);
            str_free(s.alloc, s.overlays[oi].text);
            oi = oi + 1;
        }
        A.deallocate[Overlay](s.alloc, s.overlays, s.overlay_cap::usize);
        s.overlays    = nil;
        s.overlay_len = 0;
        s.overlay_cap = 0;
    }

    if (s.module_asts != nil && s.module_ast_cap > 0) {
        A.deallocate[*ast.Ast](s.alloc, s.module_asts, s.module_ast_cap::usize);
        s.module_asts      = nil;
        s.module_ast_count = 0;
        s.module_ast_cap   = 0;
    }

    map.dnit[module.ModuleId, intern.StrId](?s.module_fqns);
    map.dnit[u64, intern.StrId](?s.export_names);
    map.dnit[u64, intern.StrId](?s.export_libraries);
    map.dnit[u32, u32](?s.type_aligns);
    map.dnit[u32, u32](?s.type_packed);
    map.dnit[u32, u32](?s.type_volatile);
    map.dnit[intern.StrId, intern.StrId](?s.import_libraries);
    reset_link_providers(s);
    reset_link_publications(s);
    map.dnit[module.ModuleId, ptr](?s.module_sema);
    map.dnit[module.ModuleId, ptr](?s.module_resolve);
    map.dnit[module.ModuleId, ptr](?s.module_comptime);
    map.dnit[intern.StrId, module.StableModuleId](?s.stable_ids);
    map.dnit[module.StableModuleId, module.ModuleId](?s.stable_to_mid);

    if (s.query_presentation != nil) {
        query.presentation_dnit(s.query_presentation);
        s.query_presentation = nil;
    }
    if (s.query_failure_message != nil) {
        str_free(s.queries.a, s.query_failure_message);
        s.query_failure_message = nil;
    }
    query.dnit(?s.queries);
    embed.dnit(?s.embeds);
    type.dnit(?s.types);
    intern.dnit(?s.interner);

    diagnostic.store_dnit(?s.diags);
    source.dnit(?s.sources);
}

# exhaustion permanently refuses new borrowed views while teardown remains infallible
pub fun expire_views(s: *Session) {
    if (s.view_generation != ~(0::u64)) { s.view_generation = s.view_generation + 1; }
}

pub fun reset_module_registry(s: *Session) {
    if (s == nil) { ret; }
    expire_views(s);

    if (s.module_asts != nil && s.module_ast_cap > 0) {
        A.deallocate[*ast.Ast](s.alloc, s.module_asts, s.module_ast_cap::usize);
    }
    s.module_asts      = nil;
    s.module_ast_count = 0;
    s.module_ast_cap   = 0;

    map.clear[module.ModuleId, intern.StrId](?s.module_fqns);
    map.clear[u64, intern.StrId](?s.export_names);
    map.clear[u64, intern.StrId](?s.export_libraries);
    map.clear[u32, u32](?s.type_aligns);
    map.clear[u32, u32](?s.type_packed);
    map.clear[u32, u32](?s.type_volatile);
    map.clear[intern.StrId, intern.StrId](?s.import_libraries);
    reset_link_providers(s);
    map.clear[module.ModuleId, ptr](?s.module_sema);
    map.clear[module.ModuleId, ptr](?s.module_resolve);
    map.clear[module.ModuleId, ptr](?s.module_comptime);

    map.clear[module.StableModuleId, module.ModuleId](?s.stable_to_mid);
}

pub fun register_module_ast(s: *Session, mid: module.ModuleId, a: *ast.Ast) err[fail.Fail] {
    expire_views(s);
    val needed: u32 = mid::u32 + 1;
    if (needed > s.module_ast_cap) {
        var new_cap: u32 = s.module_ast_cap;
        if (new_cap == 0) { new_cap = MODULE_AST_SEED_CAP; }
        for (new_cap < needed) { new_cap = new_cap * 2; }

        if (s.module_asts == nil) {
            val res_alloc: res[**ast.Ast, A.Error] = A.allocate[*ast.Ast](s.alloc, new_cap::usize);
            if (sel res_alloc.err) {
                ret err[fail.Fail].err{fail.refused(res_alloc.err)};
            }
            s.module_asts = res_alloc.ok;
        } or {
            val res_realloc: res[**ast.Ast, A.Error] = A.reallocate[*ast.Ast](s.alloc, s.module_asts, s.module_ast_cap::usize, new_cap::usize);
            if (sel res_realloc.err) {
                ret err[fail.Fail].err{fail.refused(res_realloc.err)};
            }
            s.module_asts = res_realloc.ok;
        }

        var i: u32 = s.module_ast_cap;
        for (i < new_cap) {
            s.module_asts[i] = nil;
            i = i + 1;
        }
        s.module_ast_cap = new_cap;
    }

    s.module_asts[mid::u32] = a;
    if (needed > s.module_ast_count) { s.module_ast_count = needed; }
    ret err[fail.Fail].ok{};
}

pub fun module_ast(s: *Session, mid: module.ModuleId) *ast.Ast {
    if (mid == module.MODULE_NIL)                               { ret nil; }
    if (s.module_asts == nil || mid::u32 >= s.module_ast_count) { ret nil; }
    ret s.module_asts[mid::u32];
}

pub fun module_count(s: *Session) u32 {
    ret s.module_ast_count;
}

pub fun register_module_fqn(s: *Session, mid: module.ModuleId, fqn: intern.StrId) err[fail.Fail] {
    val insert_r: res[bool, A.Error] = map.insert[module.ModuleId, intern.StrId](?s.module_fqns, mid, fqn);
    if (sel insert_r.err) { ret err[fail.Fail].err{fail.refused(insert_r.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun module_fqn(s: *Session, mid: module.ModuleId) intern.StrId {
    if (mid == module.MODULE_NIL) { ret intern.STR_NIL; }
    val res_get: opt[*intern.StrId] = map.get[module.ModuleId, intern.StrId](?s.module_fqns, ?mid);
    if (sel res_get.some) {
        ret @res_get.some;
    }
    ret intern.STR_NIL;
}

pub fun stable_module_id(s: *Session, fqn: intern.StrId) res[module.StableModuleId, fail.Fail] {
    val res_get: opt[*module.StableModuleId] = map.get[intern.StrId, module.StableModuleId](?s.stable_ids, ?fqn);
    if (sel res_get.some) {
        ret res[module.StableModuleId, fail.Fail].ok{@res_get.some};
    }

    if (s.stable_id_next == module.STABLE_MODULE_NIL) {
        ret res[module.StableModuleId, fail.Fail].err{fail.message("stable module identities are exhausted")};
    }
    val id: module.StableModuleId = s.stable_id_next;
    val res_insert: res[bool, A.Error] = map.insert[intern.StrId, module.StableModuleId](?s.stable_ids, fqn, id);
    if (sel res_insert.err) {
        ret res[module.StableModuleId, fail.Fail].err{fail.refused(res_insert.err)};
    }
    s.stable_id_next = s.stable_id_next + 1;
    ret res[module.StableModuleId, fail.Fail].ok{id};
}

pub fun stable_module_id_lookup(s: *Session, fqn: intern.StrId) module.StableModuleId {
    val res_get: opt[*module.StableModuleId] = map.get[intern.StrId, module.StableModuleId](?s.stable_ids, ?fqn);
    if (sel res_get.some) {
        ret @res_get.some;
    }
    ret module.STABLE_MODULE_NIL;
}

pub fun register_stable_mid(s: *Session, stable: module.StableModuleId, mid: module.ModuleId) err[fail.Fail] {
    val insert_r: res[bool, A.Error] = map.insert[module.StableModuleId, module.ModuleId](?s.stable_to_mid, stable, mid);
    if (sel insert_r.err) { ret err[fail.Fail].err{fail.refused(insert_r.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun module_id_for_stable(s: *Session, stable: module.StableModuleId) module.ModuleId {
    if (stable == module.STABLE_MODULE_NIL) { ret module.MODULE_NIL; }
    val res_get: opt[*module.ModuleId] = map.get[module.StableModuleId, module.ModuleId](?s.stable_to_mid, ?stable);
    if (sel res_get.some) {
        ret @res_get.some;
    }
    ret module.MODULE_NIL;
}

pub fun register_export_name(s: *Session, mid: module.ModuleId, did: u32, name: intern.StrId) err[fail.Fail] {
    val key: u64 = (mid::u64 << 32) | did::u64;
    val insert_r: res[bool, A.Error] = map.insert[u64, intern.StrId](?s.export_names, key, name);
    if (sel insert_r.err) { ret err[fail.Fail].err{fail.refused(insert_r.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun export_name(s: *Session, mid: module.ModuleId, did: u32) opt[intern.StrId] {
    var key: u64 = (mid::u64 << 32) | did::u64;
    val res_get: opt[*intern.StrId] = map.get[u64, intern.StrId](?s.export_names, ?key);
    if (sel res_get.some) {
        ret opt[intern.StrId].some{@res_get.some};
    }
    ret opt[intern.StrId].none{};
}

pub fun register_export_library(s: *Session, mid: module.ModuleId, did: u32, lib: intern.StrId) err[fail.Fail] {
    val key: u64 = (mid::u64 << 32) | did::u64;
    val insert_r: res[bool, A.Error] = map.insert[u64, intern.StrId](?s.export_libraries, key, lib);
    if (sel insert_r.err) { ret err[fail.Fail].err{fail.refused(insert_r.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun export_library(s: *Session, mid: module.ModuleId, did: u32) opt[intern.StrId] {
    var key: u64 = (mid::u64 << 32) | did::u64;
    val res_get: opt[*intern.StrId] = map.get[u64, intern.StrId](?s.export_libraries, ?key);
    if (sel res_get.some) {
        ret opt[intern.StrId].some{@res_get.some};
    }
    ret opt[intern.StrId].none{};
}

pub fun reset_type_projection(s: *Session) err[fail.Fail] {
    if (s.queries.operation_active || s.queries.presentation_pending) {
        ret err[fail.Fail].err{fail.message("cannot replace type projections while query products are borrowed")};
    }
    expire_views(s);
    type.field_projection_reset(?s.types);
    map.clear[u32, u32](?s.type_aligns);
    map.clear[u32, u32](?s.type_packed);
    map.clear[u32, u32](?s.type_volatile);
    ret err[fail.Fail].ok{};
}

pub fun register_type_align(s: *Session, tid: u32, align: u32) err[fail.Fail] {
    expire_views(s);
    val insert_r: res[bool, A.Error] = map.insert[u32, u32](?s.type_aligns, tid, align);
    if (sel insert_r.err) { ret err[fail.Fail].err{fail.refused(insert_r.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun register_type_packed(s: *Session, tid: u32) err[fail.Fail] {
    expire_views(s);
    val insert_r: res[bool, A.Error] = map.insert[u32, u32](?s.type_packed, tid, 1);
    if (sel insert_r.err) { ret err[fail.Fail].err{fail.refused(insert_r.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun type_is_packed(s: *Session, tid: u32) bool {
    val get_r: opt[*u32] = map.get[u32, u32](?s.type_packed, ?tid);
    ret sel get_r.some;
}

pub fun register_type_volatile(s: *Session, tid: u32) err[fail.Fail] {
    expire_views(s);
    val insert_r: res[bool, A.Error] = map.insert[u32, u32](?s.type_volatile, tid, 1);
    if (sel insert_r.err) { ret err[fail.Fail].err{fail.refused(insert_r.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun type_is_volatile(s: *Session, tid: u32) bool {
    val get_r: opt[*u32] = map.get[u32, u32](?s.type_volatile, ?tid);
    ret sel get_r.some;
}

pub fun type_align(s: *Session, tid: u32) opt[u32] {
    val res_get: opt[*u32] = map.get[u32, u32](?s.type_aligns, ?tid);
    if (sel res_get.some) {
        ret opt[u32].some{@res_get.some};
    }
    ret opt[u32].none{};
}

pub fun register_import_library(s: *Session, name: intern.StrId, lib: intern.StrId) err[fail.Fail] {
    val insert_r: res[bool, A.Error] = map.insert[intern.StrId, intern.StrId](?s.import_libraries, name, lib);
    if (sel insert_r.err) { ret err[fail.Fail].err{fail.refused(insert_r.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun import_library(s: *Session, name: intern.StrId) opt[intern.StrId] {
    val res_get: opt[*intern.StrId] = map.get[intern.StrId, intern.StrId](?s.import_libraries, ?name);
    if (sel res_get.some) {
        ret opt[intern.StrId].some{@res_get.some};
    }
    ret opt[intern.StrId].none{};
}

val LINK_PROVIDER_SEED_CAP: u32 = 8;

val LINK_PUBLICATION_SEED_CAP: u32 = 4;

pub fun register_link_provider(s: *Session, name: intern.StrId, is_static: bool) err[fail.Fail] {
    if (name == intern.STR_NIL) { ret err[fail.Fail].ok{}; }

    var i: u32 = 0;
    for (i < s.link_provider_len) {
        if (s.link_providers[i].name == name) {
            if (!is_static) { s.link_providers[i].is_static = false; }
            ret err[fail.Fail].ok{};
        }
        i = i + 1;
    }

    if (s.link_provider_len == s.link_provider_cap) {
        var next: u32 = LINK_PROVIDER_SEED_CAP;
        if (s.link_provider_cap > 0) { next = s.link_provider_cap * 2; }
        if (s.link_providers == nil) {
            val ar: res[*LinkProvider, A.Error] = A.allocate[LinkProvider](s.alloc, next::usize);
            if (sel ar.err) {
                ret err[fail.Fail].err{fail.refused(ar.err)};
            }
            s.link_providers = ar.ok;
        }
        or {
            val gr: res[*LinkProvider, A.Error] = A.reallocate[LinkProvider](
                s.alloc, s.link_providers, s.link_provider_cap::usize, next::usize);
            if (sel gr.err) {
                ret err[fail.Fail].err{fail.refused(gr.err)};
            }
            s.link_providers = gr.ok;
        }
        s.link_provider_cap = next;
    }

    s.link_providers[s.link_provider_len].name      = name;
    s.link_providers[s.link_provider_len].is_static = is_static;
    s.link_provider_len = s.link_provider_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun link_provider(s: *Session, name: intern.StrId) opt[LinkProvider] {
    var i: u32 = 0;
    for (i < s.link_provider_len) {
        if (s.link_providers[i].name == name) {
            ret opt[LinkProvider].some{s.link_providers[i]};
        }
        i = i + 1;
    }
    ret opt[LinkProvider].none{};
}

pub fun link_providers(s: *Session) *LinkProvider { ret s.link_providers; }

pub fun link_provider_count(s: *Session) u32 { ret s.link_provider_len; }

pub fun reset_link_providers(s: *Session) {
    if (s.link_providers != nil && s.link_provider_cap > 0) {
        A.deallocate[LinkProvider](s.alloc, s.link_providers, s.link_provider_cap::usize);
    }
    s.link_providers    = nil;
    s.link_provider_len = 0;
    s.link_provider_cap = 0;
}

pub fun record_link_publication(s: *Session, path: str, revision: query.Revision, digest: *[32]u8) err[fail.Fail] {
    var i: u32 = 0;
    for (i < s.link_publication_len) {
        if (str_equals(s.link_publications[i].path, path)) {
            s.link_publications[i].revision = revision;
            s.link_publications[i].digest   = @digest;
            ret err[fail.Fail].ok{};
        }
        i = i + 1;
    }

    val dup_r: res[str, A.Error] = str_dup(s.alloc, path);
    if (sel dup_r.err) { ret err[fail.Fail].err{fail.refused(dup_r.err)}; }
    val dup: str = dup_r.ok;

    if (s.link_publication_len == s.link_publication_cap) {
        var next: u32 = LINK_PUBLICATION_SEED_CAP;
        if (s.link_publication_cap > 0) { next = s.link_publication_cap * 2; }
        if (s.link_publications == nil) {
            val ar: res[*LinkPublication, A.Error] = A.allocate[LinkPublication](s.alloc, next::usize);
            if (sel ar.err) {
                str_free(s.alloc, dup);
                ret err[fail.Fail].err{fail.refused(ar.err)};
            }
            s.link_publications = ar.ok;
        }
        or {
            val gr: res[*LinkPublication, A.Error] = A.reallocate[LinkPublication](
                s.alloc, s.link_publications, s.link_publication_cap::usize, next::usize);
            if (sel gr.err) {
                str_free(s.alloc, dup);
                ret err[fail.Fail].err{fail.refused(gr.err)};
            }
            s.link_publications = gr.ok;
        }
        s.link_publication_cap = next;
    }

    s.link_publications[s.link_publication_len].path     = dup;
    s.link_publications[s.link_publication_len].revision = revision;
    s.link_publications[s.link_publication_len].digest   = @digest;
    s.link_publication_len = s.link_publication_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun lookup_link_publication(s: *Session, path: str, revision: query.Revision, out: *[32]u8) bool {
    var i: u32 = 0;
    for (i < s.link_publication_len) {
        if (str_equals(s.link_publications[i].path, path)) {
            if (s.link_publications[i].revision != revision) { ret false; }
            @out = s.link_publications[i].digest;
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

pub fun reset_link_publications(s: *Session) {
    if (s.link_publications != nil && s.link_publication_cap > 0) {
        var i: u32 = 0;
        for (i < s.link_publication_len) {
            str_free(s.alloc, s.link_publications[i].path);
            i = i + 1;
        }
        A.deallocate[LinkPublication](s.alloc, s.link_publications, s.link_publication_cap::usize);
    }
    s.link_publications    = nil;
    s.link_publication_len = 0;
    s.link_publication_cap = 0;
}

pub fun register_module_sema(s: *Session, mid: module.ModuleId, p: ptr) err[fail.Fail] {
    expire_views(s);
    val insert_r: res[bool, A.Error] = map.insert[module.ModuleId, ptr](?s.module_sema, mid, p);
    if (sel insert_r.err) { ret err[fail.Fail].err{fail.refused(insert_r.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun module_sema_ptr(s: *Session, mid: module.ModuleId) ptr {
    val res_get: opt[*ptr] = map.get[module.ModuleId, ptr](?s.module_sema, ?mid);
    if (sel res_get.some) {
        ret @res_get.some;
    }
    ret nil;
}

pub fun register_module_resolve(s: *Session, mid: module.ModuleId, p: ptr) err[fail.Fail] {
    expire_views(s);
    val insert_r: res[bool, A.Error] = map.insert[module.ModuleId, ptr](?s.module_resolve, mid, p);
    if (sel insert_r.err) { ret err[fail.Fail].err{fail.refused(insert_r.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun module_resolve_ptr(s: *Session, mid: module.ModuleId) ptr {
    val res_get: opt[*ptr] = map.get[module.ModuleId, ptr](?s.module_resolve, ?mid);
    if (sel res_get.some) {
        ret @res_get.some;
    }
    ret nil;
}

pub fun register_module_comptime(s: *Session, mid: module.ModuleId, p: ptr) err[fail.Fail] {
    expire_views(s);
    val insert_r: res[bool, A.Error] = map.insert[module.ModuleId, ptr](?s.module_comptime, mid, p);
    if (sel insert_r.err) { ret err[fail.Fail].err{fail.refused(insert_r.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun register_module_phase(s: *Session, mid: module.ModuleId, sema: ptr, resolve: ptr,
                              comptime_ctx: ptr) err[fail.Fail] {
    var key: module.ModuleId = mid;
    val rs: err[fail.Fail] = register_module_sema(s, mid, sema);
    if (sel rs.err) { ret rs; }
    val rr: err[fail.Fail] = register_module_resolve(s, mid, resolve);
    if (sel rr.err) {
        map.remove[module.ModuleId, ptr](?s.module_sema, ?key);
        ret rr;
    }
    val rc: err[fail.Fail] = register_module_comptime(s, mid, comptime_ctx);
    if (sel rc.err) {
        map.remove[module.ModuleId, ptr](?s.module_sema, ?key);
        map.remove[module.ModuleId, ptr](?s.module_resolve, ?key);
        ret rc;
    }
    ret err[fail.Fail].ok{};
}

pub fun register_module_identity(s: *Session, mid: module.ModuleId, a: *ast.Ast,
                                 fqn: intern.StrId, stable: module.StableModuleId) err[fail.Fail] {
    val prior_count: u32 = s.module_ast_count;
    var key: module.ModuleId = mid;
    var skey: module.StableModuleId = stable;

    val ra: err[fail.Fail] = register_module_ast(s, mid, a);
    if (sel ra.err) { ret ra; }
    val rf: err[fail.Fail] = register_module_fqn(s, mid, fqn);
    if (sel rf.err) {
        s.module_asts[mid::u32] = nil;
        s.module_ast_count      = prior_count;
        ret rf;
    }
    val rm: err[fail.Fail] = register_stable_mid(s, stable, mid);
    if (sel rm.err) {
        s.module_asts[mid::u32] = nil;
        s.module_ast_count      = prior_count;
        map.remove[module.ModuleId, intern.StrId](?s.module_fqns, ?key);
        ret rm;
    }
    ret err[fail.Fail].ok{};
}

pub fun unregister_module_identity(s: *Session, mid: module.ModuleId, stable: module.StableModuleId) {
    var key: module.ModuleId = mid;
    var skey: module.StableModuleId = stable;
    if (s.module_asts != nil && mid::u32 < s.module_ast_cap) { s.module_asts[mid::u32] = nil; }
    map.remove[module.ModuleId, intern.StrId](?s.module_fqns, ?key);
    map.remove[module.StableModuleId, module.ModuleId](?s.stable_to_mid, ?skey);
}

pub fun module_comptime_ptr(s: *Session, mid: module.ModuleId) ptr {
    val res_get: opt[*ptr] = map.get[module.ModuleId, ptr](?s.module_comptime, ?mid);
    if (sel res_get.some) {
        ret @res_get.some;
    }
    ret nil;
}

pub fun next_parse_incarnation(s: *Session) res[u64, fail.Fail] {
    if (s.parse_sequence == ~(0::u64)) { ret res[u64, fail.Fail].err{fail.message("parsed source incarnations are exhausted")}; }
    s.parse_sequence = s.parse_sequence + 1;
    ret res[u64, fail.Fail].ok{s.parse_sequence};
}

pub fun load_source(s: *Session, path: str, text: str) res[source.FileId, fail.Fail] {
    if (s.queries.operation_active || s.queries.presentation_pending) {
        ret res[source.FileId, fail.Fail].err{fail.message("cannot change source inputs before the operation is released")};
    }
    val key_r: res[str, fail.Fail] = source_key(s, path);
    if (sel key_r.err) { ret res[source.FileId, fail.Fail].err{key_r.err}; }
    val key: str = key_r.ok;
    fin { str_free(s.alloc, key); }
    if (str_len(text) > 0xFFFFFFFF::usize) { ret res[source.FileId, fail.Fail].err{fail.message("source input exceeds the query byte extent")}; }
    val staged: res[source.PreparedLoad, fail.Fail] = source.prepare_load(?s.sources, ?s.interner, key, text);
    if (sel staged.err) { ret res[source.FileId, fail.Fail].err{staged.err}; }
    var prepared: source.PreparedLoad = staged.ok;
    fin { source.discard_load(?prepared); }
    val input: err[fail.Fail] = query.set_input(?s.queries, query.Q_FILE_TEXT, prepared.id::u64, text::*u8, str_len(text)::u32);
    if (sel input.err) { ret res[source.FileId, fail.Fail].err{input.err}; }
    if (prepared.changed) { expire_views(s); }
    ret res[source.FileId, fail.Fail].ok{source.commit_load(?prepared)};
}

pub rec PreparedOverlay {
    owner: *Session;
    key: str;
    text: str;
    index: u32;
    remove: bool;
    changed: bool;
}

# the caller exclusively borrows overlay state through commit or discard
pub fun prepare_overlay(s: *Session, path: str, text: str, remove: bool) res[PreparedOverlay, fail.Fail] {
    val canonical: res[str, fail.Fail] = source_key(s, path);
    if (sel canonical.err) { ret res[PreparedOverlay, fail.Fail].err{canonical.err}; }
    var prepared: PreparedOverlay = PreparedOverlay{
        owner: s, key: canonical.ok, index: s.overlay_len, remove: remove
    };
    var complete: bool = false;
    fin { if (!complete) { discard_overlay(?prepared); } }
    var i: u32 = 0;
    for (i < s.overlay_len) {
        if (str_equals(s.overlays[i].path, prepared.key)) { prepared.index = i; brk; }
        i = i + 1;
    }
    if (remove) { prepared.changed = prepared.index < s.overlay_len; }
    or {
        prepared.changed = prepared.index == s.overlay_len || !str_equals(s.overlays[prepared.index].text, text);
        if (prepared.changed) {
            val copied: res[str, A.Error] = str_dup(s.alloc, text);
            if (sel copied.err) { ret res[PreparedOverlay, fail.Fail].err{fail.refused(copied.err)}; }
            prepared.text = copied.ok;
            if (prepared.index == s.overlay_len) {
                if (s.overlay_len == ~(0::u32)) { ret res[PreparedOverlay, fail.Fail].err{fail.message("overlay capacity exhausted")}; }
                val reserved: err[fail.Fail] = overlays_reserve(s, s.overlay_len + 1);
                if (sel reserved.err) { ret res[PreparedOverlay, fail.Fail].err{reserved.err}; }
            }
        }
    }
    complete = true;
    ret res[PreparedOverlay, fail.Fail].ok{prepared};
}

pub fun discard_overlay(prepared: *PreparedOverlay) {
    if (prepared.owner == nil) { ret; }
    str_free(prepared.owner.alloc, prepared.key);
    str_free(prepared.owner.alloc, prepared.text);
    prepared.owner = nil;
    prepared.key = nil;
    prepared.text = nil;
}

pub fun commit_overlay(prepared: *PreparedOverlay) bool {
    val s: *Session = prepared.owner;
    val changed: bool = prepared.changed;
    if (changed) {
        expire_views(s);
        val i: u32 = prepared.index;
        if (prepared.remove) {
            str_free(s.alloc, s.overlays[i].path);
            str_free(s.alloc, s.overlays[i].text);
            s.overlay_len = s.overlay_len - 1;
            if (i != s.overlay_len) { s.overlays[i] = s.overlays[s.overlay_len]; }
        }
        or {
            if (i == s.overlay_len) {
                s.overlays[i].path = prepared.key;
                prepared.key = nil;
                s.overlay_len = s.overlay_len + 1;
            }
            or { str_free(s.alloc, s.overlays[i].text); }
            s.overlays[i].text = prepared.text;
            prepared.text = nil;
        }
    }
    discard_overlay(prepared);
    ret changed;
}

pub fun set_overlay(s: *Session, path: str, text: str) err[fail.Fail] {
    val staged: res[PreparedOverlay, fail.Fail] = prepare_overlay(s, path, text, false);
    if (sel staged.err) { ret err[fail.Fail].err{staged.err}; }
    var prepared: PreparedOverlay = staged.ok;
    commit_overlay(?prepared);
    ret err[fail.Fail].ok{};
}

pub fun clear_overlay(s: *Session, path: str) res[bool, fail.Fail] {
    val staged: res[PreparedOverlay, fail.Fail] = prepare_overlay(s, path, nil, true);
    if (sel staged.err) { ret res[bool, fail.Fail].err{staged.err}; }
    var prepared: PreparedOverlay = staged.ok;
    ret res[bool, fail.Fail].ok{commit_overlay(?prepared)};
}

pub fun overlay_get(s: *Session, path: str) opt[str] {
    val key_r: res[str, fail.Fail] = source_key(s, path);
    if (sel key_r.err) { ret opt[str].none{}; }
    val key: str = key_r.ok;

    var i: u32 = 0;
    for (i < s.overlay_len) {
        if (str_equals(s.overlays[i].path, key)) {
            str_free(s.alloc, key);
            ret opt[str].some{s.overlays[i].text};
        }
        i = i + 1;
    }
    str_free(s.alloc, key);
    ret opt[str].none{};
}

fun source_key(s: *Session, path: str) res[str, fail.Fail] {
    val cleaned: res[str, A.Error] = P.clean(s.alloc, path);
    if (sel cleaned.err) { ret res[str, fail.Fail].err{fail.refused(cleaned.err)}; }
    ret res[str, fail.Fail].ok{cleaned.ok};
}

fun overlays_reserve(s: *Session, need: u32) err[fail.Fail] {
    if (need <= s.overlay_cap) { ret err[fail.Fail].ok{}; }

    var new_cap: u32 = s.overlay_cap;
    if (new_cap == 0) { new_cap = OVERLAY_SEED_CAP; }
    for (new_cap < need) {
        if (new_cap > (~(0::u32)) / 2) { new_cap = need; }
        or { new_cap = new_cap * 2; }
    }

    if (s.overlays == nil) {
        val res_alloc: res[*Overlay, A.Error] = A.allocate[Overlay](s.alloc, new_cap::usize);
        if (sel res_alloc.err) { ret err[fail.Fail].err{fail.refused(res_alloc.err)}; }
        s.overlays = res_alloc.ok;
    }
    or {
        val res_realloc: res[*Overlay, A.Error] = A.reallocate[Overlay](s.alloc, s.overlays, s.overlay_cap::usize, new_cap::usize);
        if (sel res_realloc.err) { ret err[fail.Fail].err{fail.refused(res_realloc.err)}; }
        s.overlays = res_realloc.ok;
    }
    s.overlay_cap = new_cap;
    ret err[fail.Fail].ok{};
}

test "mach.lang.session.overlay:set_get_replace_clear" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[Session, fail.Fail] = init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: Session = sr.ok;

    var bad: i32 = 0;

    val overlay_get_r: opt[str] = overlay_get(?s, "/x/a.mach");
    if (sel overlay_get_r.some) { bad = 1; }
    val absent: res[bool, fail.Fail] = clear_overlay(?s, "/x/a.mach");
    if (!(sel absent.ok && !(absent.ok))) { bad = 1; }

    val set_overlay_r: err[fail.Fail] = set_overlay(?s, "/x/a.mach", "AAA");
    if (sel set_overlay_r.err) { dnit(?s); ret 1; }
    val set_overlay_r2: err[fail.Fail] = set_overlay(?s, "/x/b.mach", "BBB");
    if (sel set_overlay_r2.err) { dnit(?s); ret 1; }
    if (s.overlay_len != 2) { bad = 1; }
    val ga: opt[str] = overlay_get(?s, "/x/a.mach");
    val gb: opt[str] = overlay_get(?s, "/x/b.mach");
    if (!(sel ga.some && str_equals(ga.some, "AAA"))) { bad = 1; }
    if (!(sel gb.some && str_equals(gb.some, "BBB"))) { bad = 1; }

    val set_overlay_r3: err[fail.Fail] = set_overlay(?s, "/x/a.mach", "A2");
    if (sel set_overlay_r3.err) { dnit(?s); ret 1; }
    if (s.overlay_len != 2) { bad = 1; }
    val ga2: opt[str] = overlay_get(?s, "/x/a.mach");
    if (!(sel ga2.some && str_equals(ga2.some, "A2"))) { bad = 1; }

    val cleared: res[bool, fail.Fail] = clear_overlay(?s, "/x/a.mach");
    if (!(sel cleared.ok && !(!cleared.ok))) { bad = 1; }
    if (s.overlay_len != 1)                           { bad = 1; }
    val overlay_get_r2: opt[str] = overlay_get(?s, "/x/a.mach");
    if (sel overlay_get_r2.some) { bad = 1; }
    val gb2: opt[str] = overlay_get(?s, "/x/b.mach");
    if (!(sel gb2.some && str_equals(gb2.some, "BBB"))) { bad = 1; }

    dnit(?s);
    ret bad;
}

test "mach.lang.session.overlay:one_file_is_one_entry_however_it_is_spelled" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[Session, fail.Fail] = init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: Session = sr.ok;

    var bad: i32 = 0;

    val set_overlay_r: err[fail.Fail] = set_overlay(?s, "/x/src/a.mach", "LIVE");
    if (sel set_overlay_r.err) { dnit(?s); ret 1; }

    if (!ut_overlay_is(?s, "/x/./src/a.mach", "LIVE")      && bad == 0) { bad = 1; }
    if (!ut_overlay_is(?s, "/x//src/a.mach", "LIVE")       && bad == 0) { bad = 2; }
    if (!ut_overlay_is(?s, "/x/src/./a.mach", "LIVE")      && bad == 0) { bad = 3; }
    if (!ut_overlay_is(?s, "/x/lib/../src/a.mach", "LIVE") && bad == 0) { bad = 4; }

    val set_overlay_r2: err[fail.Fail] = set_overlay(?s, "/x/./src/a.mach", "NEWER");
    if (sel set_overlay_r2.err) { dnit(?s); ret 1; }
    if (s.overlay_len != 1                            && bad == 0) { bad = 5; }
    if (!ut_overlay_is(?s, "/x/src/a.mach", "NEWER")  && bad == 0) { bad = 6; }

    val overlay_get_r: opt[str] = overlay_get(?s, "/x/src/b.mach");
    if (sel overlay_get_r.some && bad == 0) { bad = 7; }
    val overlay_get_r2: opt[str] = overlay_get(?s, "/src/a.mach");
    if (sel overlay_get_r2.some   && bad == 0) { bad = 8; }

    val cleared: res[bool, fail.Fail] = clear_overlay(?s, "/x//src/a.mach");
    if (!(sel cleared.ok && cleared.ok) && bad == 0) { bad = 9; }
    if (s.overlay_len != 0                   && bad == 0) { bad = 10; }

    dnit(?s);
    ret bad;
}

fun ut_overlay_is(s: *Session, path: str, want: str) bool {
    val g: opt[str] = overlay_get(s, path);
    if (sel g.none) { ret false; }
    ret str_equals(g.some, want);
}

test "mach.lang.session.link_provider:order_dedup_upgrade_reset" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[Session, fail.Fail] = init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: Session = sr.ok;

    var bad: i32 = 0;

    val a_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "alpha");
    val b_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "beta");
    val c_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "gamma");
    if (sel a_r.err) { dnit(?s); ret 1; }
    if (sel b_r.err) { dnit(?s); ret 1; }
    if (sel c_r.err) { dnit(?s); ret 1; }
    val a: intern.StrId = a_r.ok;
    val b: intern.StrId = b_r.ok;
    val c: intern.StrId = c_r.ok;

    if (link_provider_count(?s) != 0)               { bad = 1; }
    val link_provider_r: opt[LinkProvider] = link_provider(?s, a);
    if (sel link_provider_r.some) { bad = 1; }

    val register_link_provider_r: err[fail.Fail] = register_link_provider(?s, intern.STR_NIL, true);
    if (sel register_link_provider_r.err) { dnit(?s); ret 1; }
    if (link_provider_count(?s) != 0) { bad = 1; }

    val register_link_provider_r2: err[fail.Fail] = register_link_provider(?s, a, true);
    if (sel register_link_provider_r2.err)  { dnit(?s); ret 1; }
    val register_link_provider_r3: err[fail.Fail] = register_link_provider(?s, b, false);
    if (sel register_link_provider_r3.err) { dnit(?s); ret 1; }
    if (link_provider_count(?s) != 2) { bad = 1; }
    if (link_providers(?s)[0].name != a || !link_providers(?s)[0].is_static) { bad = 1; }
    if (link_providers(?s)[1].name != b ||  link_providers(?s)[1].is_static) { bad = 1; }

    val register_link_provider_r4: err[fail.Fail] = register_link_provider(?s, b, true);
    if (sel register_link_provider_r4.err) { dnit(?s); ret 1; }
    if (link_provider_count(?s) != 2) { bad = 1; }
    if (link_providers(?s)[1].is_static) { bad = 1; }

    val register_link_provider_r5: err[fail.Fail] = register_link_provider(?s, a, false);
    if (sel register_link_provider_r5.err) { dnit(?s); ret 1; }
    if (link_provider_count(?s) != 2) { bad = 1; }
    val pa: opt[LinkProvider] = link_provider(?s, a);
    if (!(sel pa.some && !(pa.some.is_static))) { bad = 1; }

    val link_provider_r2: opt[LinkProvider] = link_provider(?s, c);
    if (sel link_provider_r2.some) { bad = 1; }

    val register_link_provider_r6: err[fail.Fail] = register_link_provider(?s, c, true);
    if (sel register_link_provider_r6.err)     { dnit(?s); ret 1; }
    var fill: [3]u8;
    fill[0] = 'd';
    fill[2] = 0;
    var i: u32 = 0;
    for (i < 8) {
        fill[1] = ('0'::u32 + i)::u8;
        val nr: res[intern.StrId, A.Error] = intern.intern(?s.interner, (?fill[0])::str);
        if (sel nr.err) { dnit(?s); ret 1; }
        val register_link_provider_r7: err[fail.Fail] = register_link_provider(
                ?s, nr.ok, true);
        if (sel register_link_provider_r7.err) { dnit(?s); ret 1; }
        i = i + 1;
    }
    if (link_provider_count(?s) != 11) { bad = 1; }
    if (link_providers(?s)[0].name != a) { bad = 1; }
    val pc: opt[LinkProvider] = link_provider(?s, c);
    if (!(sel pc.some && !(!pc.some.is_static))) { bad = 1; }

    reset_link_providers(?s);
    if (link_provider_count(?s) != 0)                  { bad = 1; }
    val link_provider_r3: opt[LinkProvider] = link_provider(?s, a);
    if (sel link_provider_r3.some) { bad = 1; }

    val register_link_provider_r8: err[fail.Fail] = register_link_provider(?s, c, false);
    if (sel register_link_provider_r8.err) { dnit(?s); ret 1; }
    if (link_provider_count(?s) != 1) { bad = 1; }

    dnit(?s);
    ret bad;
}

test "mach.lang.session.load_source:source_and_overlay_keys_share_native_path_identity" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[Session, fail.Fail] = init(?alloc);
    if (sel sr.err) { ret 2; }
    var s: Session = sr.ok;
    fin { dnit(?s); }
    var first: str = "/x/./src/a.mach";
    var alias: str = "/x/src/a.mach";
    $if ($mach.build.os == $mach.os.windows) {
        first = "C:\\x/src/./a.mach";
        alias = "C:/x\\src\\a.mach";
    }
    val one: res[source.FileId, fail.Fail] = load_source(?s, first, "before");
    if (sel one.err) { ret 3; }
    val two: res[source.FileId, fail.Fail] = load_source(?s, alias, "after");
    if (sel two.err) { ret 4; }
    val fid: source.FileId = one.ok;
    if (fid != two.ok) { ret 5; }
    val file: opt[*source.SourceFile] = source.get(?s.sources, fid);
    if (sel file.none) { ret 6; }
    if (!str_equals(file.some.text, "after")) { ret 6; }
    val set_overlay_r: err[fail.Fail] = set_overlay(?s, first, "overlay");
    if (sel set_overlay_r.err) { ret 7; }
    if (!ut_overlay_is(?s, file.some.path, "overlay")) { ret 8; }
    $if ($mach.build.os != $mach.os.windows) {
        val literal: res[source.FileId, fail.Fail] = load_source(?s, "/x/src\\a.mach", "literal");
        if (sel literal.err) { ret 9; }
        if (literal.ok == fid) { ret 9; }
    }
    ret 0;
}

test "mach.lang.session.stable_module_id:registry_reorder_and_exhaustion_preserve_existing_identities" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val opened: res[Session, fail.Fail] = init(?alloc);
    if (sel opened.err) { ret 2; }
    var s: Session = opened.ok;
    fin { dnit(?s); }
    val a: res[module.StableModuleId, fail.Fail] = stable_module_id(?s, 1);
    val b: res[module.StableModuleId, fail.Fail] = stable_module_id(?s, 2);
    if (sel a.err) { ret 3; }
    if (sel b.err) { ret 3; }
    val aid: module.StableModuleId = a.ok;
    val bid: module.StableModuleId = b.ok;
    val register_stable_mid_r2: err[fail.Fail] = register_stable_mid(?s, aid, 0);
    if (sel register_stable_mid_r2.err) { ret 4; }
    val register_stable_mid_r: err[fail.Fail] = register_stable_mid(?s, bid, 1);
    if (sel register_stable_mid_r.err) { ret 4; }
    reset_module_registry(?s);
    val register_stable_mid_r4: err[fail.Fail] = register_stable_mid(?s, bid, 0);
    if (sel register_stable_mid_r4.err) { ret 5; }
    val register_stable_mid_r3: err[fail.Fail] = register_stable_mid(?s, aid, 1);
    if (sel register_stable_mid_r3.err) { ret 5; }
    if (stable_module_id_lookup(?s, 1) != aid || module_id_for_stable(?s, aid) != 1) { ret 6; }
    s.stable_id_next = module.STABLE_MODULE_NIL;
    val existing: res[module.StableModuleId, fail.Fail] = stable_module_id(?s, 1);
    if (sel existing.err) { ret 7; }
    if (existing.ok != aid) { ret 7; }
    val refused: res[module.StableModuleId, fail.Fail] = stable_module_id(?s, 3);
    if (sel refused.ok) { ret 8; }
    if (stable_module_id_lookup(?s, 3) != module.STABLE_MODULE_NIL || s.stable_ids.len != 2
        || s.stable_id_next != module.STABLE_MODULE_NIL) { ret 9; }
    ret 0;
}

fun t_source_input_compute(s: *Session, kind: query.QueryKind, key: u64, a: *A.Allocator,
                           diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    ret res[query.QueryOutput, fail.Fail].err{fail.message("source input unexpectedly required a derived computation")};
}

fun t_source_input(s: *Session, id: source.FileId, expected: str, stamp: *query.Revision) i32 {
    val runtime: res[query.QueryRuntime[Session], fail.Fail] = query.runtime[Session](?s.queries, t_source_input_compute);
    if (sel runtime.err) { ret 30; }
    var rt: query.QueryRuntime[Session] = runtime.ok;
    val opened: res[query.Operation, fail.Fail] = query.begin(?s.queries);
    if (sel opened.err) { ret 31; }
    val operation: query.Operation = opened.ok;
    val read: res[query.QueryView, fail.Fail] = query.get[Session](?rt, s, query.Q_FILE_TEXT, id::u64);
    var code: i32 = 0;
    if (sel read.err) { code = 32; }
    if (sel read.ok) {
        val view: query.QueryView = read.ok;
        if (view.value_len::usize != str_len(expected)
            || !memory.raw_equal(view.value::ptr, expected::ptr, str_len(expected))) { code = 33; }
        @stamp = view.last_changed;
    }
    val end_r: err[fail.Fail] = query.end(?s.queries, operation);
    if (sel end_r.err) { code = 34; }
    val discard_r: err[fail.Fail] = query.discard(?s.queries, operation);
    if (sel discard_r.err) { code = 35; }
    ret code;
}

fun t_source_publication_attempt(tracker: *T.Testing, existing: bool, ordinal: usize, finished: *bool) i32 {
    val opened: res[Session, fail.Fail] = init(T.allocator_of(tracker));
    if (sel opened.err) { ret 2; }
    var s: Session = opened.ok;
    fin { dnit(?s); }
    val path: str = "n4/source.mach";
    var id: source.FileId = 1;
    var old_text: str = nil;
    var old_lines: *usize = nil;
    var old_stamp: query.Revision = 0;
    if (existing) {
        val loaded: res[source.FileId, fail.Fail] = load_source(?s, path, "before\ntext");
        if (sel loaded.err) { ret 3; }
        id = loaded.ok;
        old_text = s.sources.files[id].text;
        old_lines = s.sources.files[id].line_starts;
        val code: i32 = t_source_input(?s, id, "before\ntext", ?old_stamp);
        if (code != 0) { ret code; }
    }
    val old_len: usize = s.sources.len;
    val old_paths: usize = s.sources.by_path.len;
    val old_revision: query.Revision = s.queries.revision;
    T.fail_at_ordinal(tracker, T.attempt_count(tracker) + ordinal);
    val attempted: res[source.FileId, fail.Fail] = load_source(?s, path, "after\ntwo\nlines");
    T.clear_failure(tracker);
    if (sel attempted.err) {
        if (s.sources.len != old_len || s.sources.by_path.len != old_paths || s.queries.revision != old_revision) { ret 4; }
        if (existing) {
            if (s.sources.files[id].text != old_text || s.sources.files[id].line_starts != old_lines
                || !str_equals(s.sources.files[id].text, "before\ntext")) { ret 5; }
            var stamp: query.Revision = 0;
            val code: i32 = t_source_input(?s, id, "before\ntext", ?stamp);
            if (code != 0) { ret code; }
            if (stamp != old_stamp) { ret 6; }
        }
    }
    if (sel attempted.ok) { @finished = true; }
    val retry: res[source.FileId, fail.Fail] = load_source(?s, path, "after\ntwo\nlines");
    if (sel retry.err) { ret 7; }
    if (retry.ok != id) { ret 7; }
    if (s.sources.len != 2 || s.sources.by_path.len != 1 || s.queries.revision != old_revision + 1) { ret 8; }
    val file: *source.SourceFile = ?s.sources.files[id];
    if (!str_equals(file.text, "after\ntwo\nlines") || file.line_len != 3
        || file.line_starts[1] != 6 || file.line_starts[2] != 10) { ret 9; }
    var new_stamp: query.Revision = 0;
    val code: i32 = t_source_input(?s, id, "after\ntwo\nlines", ?new_stamp);
    if (code != 0) { ret code; }
    if (new_stamp != old_revision + 1) { ret 10; }
    ret 0;
}

test "mach.lang.session.load_source:allocation_refusal_preserves_text_identity_and_query_stamp" {
    var mode: u32 = 0;
    for (mode < 2) {
        var ordinal: usize = 1;
        var finished: bool = false;
        for (ordinal <= 64 && !finished) {
            var tracker: T.Testing;
            val make_r: err[A.Error] = T.make(?tracker);
            if (sel make_r.err) { ret 1; }
            val code: i32 = t_source_publication_attempt(?tracker, mode != 0, ordinal, ?finished);
            val leaked: bool = T.leaked(?tracker) || T.double_free_count(?tracker) != 0 || T.tracking_exhausted(?tracker);
            T.dnit(?tracker);
            if (code != 0) { ret code; }
            if (leaked) { ret 11; }
            ordinal = ordinal + 1;
        }
        if (!finished || ordinal <= 2) { ret 12; }
        mode = mode + 1;
    }
    ret 0;
}

test "mach.lang.session.load_source:active_and_pending_operations_refuse_before_source_mutation" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val opened: res[Session, fail.Fail] = init(?alloc);
    if (sel opened.err) { ret 2; }
    var s: Session = opened.ok;
    fin { dnit(?s); }
    val loaded: res[source.FileId, fail.Fail] = load_source(?s, "n4/source.mach", "before");
    if (sel loaded.err) { ret 3; }
    val id: source.FileId = loaded.ok;
    val text: str = s.sources.files[id].text;
    val revision: query.Revision = s.queries.revision;
    val started: res[query.Operation, fail.Fail] = query.begin(?s.queries);
    if (sel started.err) { ret 4; }
    val operation: query.Operation = started.ok;
    val load_source_r: res[source.FileId, fail.Fail] = load_source(?s, "n4/source.mach", "after");
    if (sel load_source_r.ok) { ret 5; }
    val end_r: err[fail.Fail] = query.end(?s.queries, operation);
    if (sel end_r.err) { ret 6; }
    val load_source_r2: res[source.FileId, fail.Fail] = load_source(?s, "n4/new.mach", "new");
    if (sel load_source_r2.ok) { ret 7; }
    if (s.sources.len != 2 || s.sources.by_path.len != 1 || s.sources.files[id].text != text
        || !str_equals(text, "before") || s.queries.revision != revision) { ret 8; }
    val discard_r: err[fail.Fail] = query.discard(?s.queries, operation);
    if (sel discard_r.err) { ret 9; }
    val load_source_r3: res[source.FileId, fail.Fail] = load_source(?s, "n4/source.mach", "after");
    if (sel load_source_r3.err) { ret 10; }
    ret 0;
}
