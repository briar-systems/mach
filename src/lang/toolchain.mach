# the toolchain's composition root: the one place the target catalog is
# registered. the toolchain owns one composed registry for the life of the
# process (`registry`), which every session, the driver, the editor and the
# command line borrow; the session holds none. the registry holds static
# members by pointer, so one composition serves every caller. nothing below
# this module registers a target member, and nothing above it composes a
# registry by hand

use std.types.error.err;
use std.types.result.res;

use A: std.allocator;
use std.allocator.page;
use T: std.allocator.testing;
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;

use codegen_dwarf: mach.lang.be.codegen.dwarf;
use mach.lang.fail;
use mach.lang.session;
use lang_target: mach.lang.target;

var process_alloc:    A.Allocator;
var process_registry: lang_target.TargetRegistry;

# the toolchain's registry, composed on first use and published for the life of
# the process; the first use comes before any worker runs, since every target a
# build reads is resolved before it fans out
# ---
# ret: the registry; err when the catalog cannot be composed
pub fun registry() res[*lang_target.TargetRegistry, fail.Fail] {
    if (!process_registry.published) {
        val made: err[A.Error] = page.make(?process_alloc);
        if (sel made.err) { ret res[*lang_target.TargetRegistry, fail.Fail].err{fail.refused(made.err)}; }
        process_registry = lang_target.registry_init_with_allocator(?process_alloc);
        val composed: err[fail.Fail] = lang_target.register_all(?process_registry, ?codegen_dwarf.DEBUG);
        if (sel composed.err) { ret res[*lang_target.TargetRegistry, fail.Fail].err{composed.err}; }
    }
    ret res[*lang_target.TargetRegistry, fail.Fail].ok{?process_registry};
}

# the toolchain registry a test resolves against; a registry that cannot be
# composed fails the test outright
#[testing]
pub fun t_registry() *lang_target.TargetRegistry {
    val r: res[*lang_target.TargetRegistry, fail.Fail] = registry();
    if (sel r.ok) { ret r.ok; }
    panic("toolchain: the target registry failed to compose\n");
    ret nil;
}

# a session that builds, checks or analyses, with the toolchain registry
# composed for every target it resolves
# ---
# alloc: backs the session
# ret:   the session, released with `session.dnit`; err when the session or the catalog cannot be made
pub fun session_init(alloc: *A.Allocator) res[session.Session, fail.Fail] {
    val composed: res[*lang_target.TargetRegistry, fail.Fail] = registry();
    if (sel composed.err) { ret res[session.Session, fail.Fail].err{composed.err}; }
    ret session.init(alloc);
}

test session_init__publishes_the_catalog_and_leaks_nothing {
    var tracker: T.Testing;
    val make_r:  err[A.Error] = T.make(?tracker);
    if (sel make_r.err) { ret 10; }
    var published: bool                            = false;
    val made:      res[session.Session, fail.Fail] = session_init(T.allocator_of(?tracker));
    if (sel made.err) {
        T.dnit(?tracker);
        ret 1;
    }
    var s: session.Session = made.ok;
    published = lang_target.registry_published(t_registry());
    session.dnit(?s);
    val leaked: bool = T.leaked(?tracker) || T.double_free_count(?tracker) != 0;
    T.dnit(?tracker);
    if (!published) { ret 2; }
    if (leaked)     { ret 3; }
    ret 0;
}
