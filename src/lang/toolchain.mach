# the toolchain's composition root: the one place the target catalog is
# registered. the toolchain owns one composed registry for the life of the
# process (`registry`), which every session, the driver, the editor and the
# command line borrow; the session holds none. a caller that wants a registry
# of its own takes `registry_init`. nothing below this module registers a
# target member, and nothing above it composes a registry by hand

use std.types.error.err;
use std.types.result.res;

use A: std.allocator;
use std.allocator.page;
use T: std.allocator.testing;
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.size.usize;

use codegen_dwarf: mach.lang.be.codegen.dwarf;
use mach.lang.fail;
use mach.lang.session;
use lang_target: mach.lang.target;
use target_of:   mach.lang.target.of;

fun debug_descriptor() res[target_of.DebugVTable, fail.Fail] {
    ret res[target_of.DebugVTable, fail.Fail].ok{codegen_dwarf.debug_descriptor()};
}

fun registry_compose(reg: *lang_target.TargetRegistry) err[fail.Fail] {
    ret lang_target.register_all(reg, debug_descriptor);
}

var process_alloc:    A.Allocator;
var process_registry: *lang_target.TargetRegistry = nil;

# the toolchain's registry, composed on first use and published for the life of
# the process; the first use comes before any worker runs, since every target a
# build reads is resolved before it fans out
# ---
# ret: the registry, never released; err when the catalog cannot be composed
pub fun registry() res[*lang_target.TargetRegistry, fail.Fail] {
    if (process_registry == nil) {
        val made: err[A.Error] = page.make(?process_alloc);
        if (sel made.err) { ret res[*lang_target.TargetRegistry, fail.Fail].err{fail.refused(made.err)}; }
        val composed: res[*lang_target.TargetRegistry, fail.Fail] = registry_init(?process_alloc);
        if (sel composed.err) { ret composed; }
        process_registry = composed.ok;
    }
    ret res[*lang_target.TargetRegistry, fail.Fail].ok{process_registry};
}

# the toolchain registry a test resolves against; a registry that cannot be
# composed fails the test outright
#[testing]
pub fun t_registry() *lang_target.TargetRegistry {
    val r: res[*lang_target.TargetRegistry, fail.Fail] = registry();
    if (sel r.ok) { ret r.ok; }
    panic("toolchain: the target registry failed to compose\n");
    ret nil;
}

# a session that builds, checks or analyses, with the toolchain registry
# composed for every target it resolves
# ---
# alloc: backs the session
# ret:   the session, released with `session.dnit`; err when the session or the catalog cannot be made
pub fun session_init(alloc: *A.Allocator) res[session.Session, fail.Fail] {
    val composed: res[*lang_target.TargetRegistry, fail.Fail] = registry();
    if (sel composed.err) { ret res[session.Session, fail.Fail].err{composed.err}; }
    ret session.init(alloc);
}

# a target registry holding the whole catalog, for a caller that resolves targets without a session
# ---
# alloc: backs the registry and every entry
# ret:   the registry, released with `lang_target.registry_dnit`; err when it cannot be made
pub fun registry_init(alloc: *A.Allocator) res[*lang_target.TargetRegistry, fail.Fail] {
    val made: res[*lang_target.TargetRegistry, fail.Fail] = lang_target.registry_new(alloc);
    if (sel made.err) { ret made; }
    val reg:      *lang_target.TargetRegistry = made.ok;
    val composed: err[fail.Fail]              = registry_compose(reg);
    if (sel composed.err) {
        lang_target.registry_dnit(reg);
        ret res[*lang_target.TargetRegistry, fail.Fail].err{composed.err};
    }
    ret res[*lang_target.TargetRegistry, fail.Fail].ok{reg};
}

# a test fixture: a composed registry over a page allocator of its own, which
# the registry borrows and so lives in a block of its own pages
#[testing]
pub fun registry_fixture() res[*lang_target.TargetRegistry, fail.Fail] {
    var local: A.Allocator;
    val made:  err[A.Error] = page.make(?local);
    if (sel made.err) { ret res[*lang_target.TargetRegistry, fail.Fail].err{fail.refused(made.err)}; }
    val held: res[*A.Allocator, A.Error] = A.allocate[A.Allocator](?local, 1::usize);
    if (sel held.err) { ret res[*lang_target.TargetRegistry, fail.Fail].err{fail.refused(held.err)}; }
    @held.ok = local;
    ret registry_init(held.ok);
}

#[testing]
fun t_composed(tracker: *T.Testing, sessioned: bool) i32 {
    var published: bool = false;
    if (sessioned) {
        val made: res[session.Session, fail.Fail] = session_init(T.allocator_of(tracker));
        if (sel made.err) { ret 1; }
        var s: session.Session = made.ok;
        published = lang_target.registry_published(t_registry());
        session.dnit(?s);
    }
    or {
        val made: res[*lang_target.TargetRegistry, fail.Fail] = registry_init(T.allocator_of(tracker));
        if (sel made.err) { ret 1; }
        published = lang_target.registry_published(made.ok);
        lang_target.registry_dnit(made.ok);
    }
    if (!published) { ret 2; }
    ret 0;
}

test session_init__and_registry_init_publish_the_catalog_and_release_it {
    var mode: u32 = 0;
    for (mode < 2) {
        var tracker: T.Testing;
        val make_r:  err[A.Error] = T.make(?tracker);
        if (sel make_r.err) { ret 10; }
        val code:   i32  = t_composed(?tracker, mode == 0);
        val leaked: bool = T.leaked(?tracker) || T.double_free_count(?tracker) != 0;
        T.dnit(?tracker);
        if (code != 0) { ret code; }
        if (leaked)    { ret 3; }
        mode = mode + 1;
    }
    ret 0;
}
