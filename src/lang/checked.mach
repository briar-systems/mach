# checked arithmetic: counts, offsets, addresses, alignments and ids typed by
# their unit, and the narrowing conversions, each refusing overflow with a cause
use std.types.bool.bool;
use std.types.bool.false;
use std.types.result.res;
use std.types.size.usize;

pub def Cause: u8;

pub val ADD_OVERFLOW:        Cause = 1;
val     MUL_OVERFLOW:        Cause = 3;
val     INVALID_ALIGNMENT:   Cause = 4;
val     NON_POWER_ALIGNMENT: Cause = 5;
val     INVALID_RANGE:       Cause = 6;
val     NARROWING:           Cause = 7;
val     ID_RANGE:            Cause = 8;

pub rec ByteUnit {}

pub rec MemorySpace {}

pub rec Count[Unit] {
    value: usize;
}

pub rec Offset[Unit] {
    value: usize;
}

pub rec Address[Space] {
    value: usize;
}

rec Range[Unit] {
    start: Offset[Unit];
    end:   Offset[Unit];
}

pub rec Alignment[Unit] {
    value: usize;
}

pub rec PowerAlignment[Unit] {
    value: usize;
}

pub rec Id[Domain] {
    value: usize;
}

pub fun usize_add(left: usize, right: usize) res[usize, Cause] {
    val maximum: usize = ~(0::usize);
    if (right > maximum - left) { ret res[usize, Cause].err{ADD_OVERFLOW}; }
    ret res[usize, Cause].ok{left + right};
}

pub fun usize_mul(left: usize, right: usize) res[usize, Cause] {
    val maximum: usize = ~(0::usize);
    if (left != 0 && right > maximum / left) { ret res[usize, Cause].err{MUL_OVERFLOW}; }
    ret res[usize, Cause].ok{left * right};
}

pub fun count[Unit](value: usize) Count[Unit] {
    var out: Count[Unit];
    out.value = value;
    ret out;
}

pub fun offset[Unit](value: usize) Offset[Unit] {
    var out: Offset[Unit];
    out.value = value;
    ret out;
}

pub fun address[Space](value: usize) Address[Space] {
    var out: Address[Space];
    out.value = value;
    ret out;
}

pub fun count_add[Unit](left: Count[Unit], right: Count[Unit])
    res[Count[Unit], Cause] {
    val added: res[usize, Cause] = usize_add(left.value, right.value);
    if (sel added.err) {
        ret res[Count[Unit], Cause].err{added.err};
    }
    ret res[Count[Unit], Cause].ok{count[Unit](added.ok)};
}

pub fun count_mul[Unit](value: Count[Unit], factor: usize)
    res[Count[Unit], Cause] {
    val multiplied: res[usize, Cause] = usize_mul(value.value, factor);
    if (sel multiplied.err) {
        ret res[Count[Unit], Cause].err{multiplied.err};
    }
    ret res[Count[Unit], Cause].ok{count[Unit](multiplied.ok)};
}

pub fun offset_add[Unit](base: Offset[Unit], amount: Count[Unit])
    res[Offset[Unit], Cause] {
    val added: res[usize, Cause] = usize_add(base.value, amount.value);
    if (sel added.err) {
        ret res[Offset[Unit], Cause].err{added.err};
    }
    ret res[Offset[Unit], Cause].ok{offset[Unit](added.ok)};
}

pub fun address_add[Space](base: Address[Space], amount: Count[ByteUnit])
    res[Address[Space], Cause] {
    val added: res[usize, Cause] = usize_add(base.value, amount.value);
    if (sel added.err) {
        ret res[Address[Space], Cause].err{added.err};
    }
    ret res[Address[Space], Cause].ok{address[Space](added.ok)};
}

fun checked_range[Unit](start: Offset[Unit], end: Offset[Unit])
    res[Range[Unit], Cause] {
    if (end.value < start.value) {
        ret res[Range[Unit], Cause].err{INVALID_RANGE};
    }
    var out: Range[Unit];
    out.start = start;
    out.end   = end;
    ret res[Range[Unit], Cause].ok{out};
}

fun range_from_count[Unit](start: Offset[Unit], length: Count[Unit])
    res[Range[Unit], Cause] {
    val end: res[Offset[Unit], Cause] = offset_add[Unit](start, length);
    if (sel end.err) {
        ret res[Range[Unit], Cause].err{end.err};
    }
    ret checked_range[Unit](start, end.ok);
}

pub fun range_fits[Unit](available: Count[Unit], start: Offset[Unit],
    length: Count[Unit]) bool {
    val made: res[Range[Unit], Cause] = range_from_count[Unit](start, length);
    if (sel made.err) { ret false; }
    ret made.ok.end.value <= available.value;
}

pub fun alignment[Unit](value: usize) res[Alignment[Unit], Cause] {
    if (value == 0) { ret res[Alignment[Unit], Cause].err{INVALID_ALIGNMENT}; }
    var out: Alignment[Unit];
    out.value = value;
    ret res[Alignment[Unit], Cause].ok{out};
}

pub fun power_alignment[Unit](value: usize) res[PowerAlignment[Unit], Cause] {
    if (value == 0) {
        ret res[PowerAlignment[Unit], Cause].err{INVALID_ALIGNMENT};
    }
    if ((value & (value - 1)) != 0) {
        ret res[PowerAlignment[Unit], Cause].err{NON_POWER_ALIGNMENT};
    }
    var out: PowerAlignment[Unit];
    out.value = value;
    ret res[PowerAlignment[Unit], Cause].ok{out};
}

pub fun align_offset_up[Unit](value: Offset[Unit], align: Alignment[Unit])
    res[Offset[Unit], Cause] {
    if (align.value == 0) {
        ret res[Offset[Unit], Cause].err{INVALID_ALIGNMENT};
    }
    val remainder: usize = value.value % align.value;
    if (remainder == 0) { ret res[Offset[Unit], Cause].ok{value}; }
    ret offset_add[Unit](value, count[Unit](align.value - remainder));
}

# the address-space twin of align_offset_up: a u64 value rounded up to a
# power-of-two alignment, refusing an invalid alignment and an overflow
pub fun align_u64_up(value: u64, align: u64) res[u64, Cause] {
    if (align == 0)                 { ret res[u64, Cause].err{INVALID_ALIGNMENT}; }
    if ((align & (align - 1)) != 0) { ret res[u64, Cause].err{NON_POWER_ALIGNMENT}; }
    val remainder: u64 = value % align;
    if (remainder == 0) { ret res[u64, Cause].ok{value}; }
    val pad_by: u64 = align - remainder;
    if (pad_by > ~(0::u64) - value) { ret res[u64, Cause].err{ADD_OVERFLOW}; }
    ret res[u64, Cause].ok{value + pad_by};
}

pub fun id[Domain](value: usize) Id[Domain] {
    var out: Id[Domain];
    out.value = value;
    ret out;
}

pub fun id_below[Domain](value: usize, upper: Count[Domain])
    res[Id[Domain], Cause] {
    if (value >= upper.value) { ret res[Id[Domain], Cause].err{ID_RANGE}; }
    ret res[Id[Domain], Cause].ok{id[Domain](value)};
}

pub fun usize_to_u16(value: usize) res[u16, Cause] {
    if (value::u16::usize != value) { ret res[u16, Cause].err{NARROWING}; }
    ret res[u16, Cause].ok{value::u16};
}

pub fun usize_to_u32(value: usize) res[u32, Cause] {
    if (value::u32::usize != value) { ret res[u32, Cause].err{NARROWING}; }
    ret res[u32, Cause].ok{value::u32};
}

pub fun u64_to_u32(value: u64) res[u32, Cause] {
    if (value::u32::u64 != value) { ret res[u32, Cause].err{NARROWING}; }
    ret res[u32, Cause].ok{value::u32};
}

pub fun usize_to_i32(value: usize) res[i32, Cause] {
    if (value > 2147483647) { ret res[i32, Cause].err{NARROWING}; }
    ret res[i32, Cause].ok{value::i32};
}
