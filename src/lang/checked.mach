# checked arithmetic: counts, offsets, addresses, alignments and ids typed by
# their unit, and the narrowing conversions, each refusing overflow with a cause
use std.types.bool.bool;
use std.types.bool.false;
use std.types.result.res;
use std.types.size.usize;

pub def Cause: u8;

pub val ADD_OVERFLOW:        Cause = 1;
#[testing]
val     SUB_UNDERFLOW:       Cause = 2;
val     MUL_OVERFLOW:        Cause = 3;
val     INVALID_ALIGNMENT:   Cause = 4;
val     NON_POWER_ALIGNMENT: Cause = 5;
val     INVALID_RANGE:       Cause = 6;
val     NARROWING:           Cause = 7;
val     ID_RANGE:            Cause = 8;
#[testing]
val     NIL_POINTER:         Cause = 9;
#[testing]
val     ZERO_SIZED_ELEMENT:  Cause = 10;
#[testing]
val     POINTER_ALIGNMENT:   Cause = 11;
#[testing]
val     POINTER_OVERFLOW:    Cause = 12;

pub rec ByteUnit {}

pub rec MemorySpace {}

pub rec Count[Unit] {
    value: usize;
}

pub rec Offset[Unit] {
    value: usize;
}

pub rec Address[Space] {
    value: usize;
}

rec Range[Unit] {
    start: Offset[Unit];
    end:   Offset[Unit];
}

pub rec Alignment[Unit] {
    value: usize;
}

pub rec PowerAlignment[Unit] {
    value: usize;
}

pub rec Id[Domain] {
    value: usize;
}

#[testing]
rec Span[T] {
    data:  *T;
    count: usize;
    bytes: usize;
    begin: usize;
    end:   usize;
}

pub fun usize_add(left: usize, right: usize) res[usize, Cause] {
    val maximum: usize = ~(0::usize);
    if (right > maximum - left) { ret res[usize, Cause].err{ADD_OVERFLOW}; }
    ret res[usize, Cause].ok{left + right};
}

pub fun usize_mul(left: usize, right: usize) res[usize, Cause] {
    val maximum: usize = ~(0::usize);
    if (left != 0 && right > maximum / left) { ret res[usize, Cause].err{MUL_OVERFLOW}; }
    ret res[usize, Cause].ok{left * right};
}

pub fun count[Unit](value: usize) Count[Unit] {
    var out: Count[Unit];
    out.value = value;
    ret out;
}

pub fun offset[Unit](value: usize) Offset[Unit] {
    var out: Offset[Unit];
    out.value = value;
    ret out;
}

pub fun address[Space](value: usize) Address[Space] {
    var out: Address[Space];
    out.value = value;
    ret out;
}

pub fun count_add[Unit](left: Count[Unit], right: Count[Unit])
    res[Count[Unit], Cause] {
    val added: res[usize, Cause] = usize_add(left.value, right.value);
    if (sel added.err) {
        ret res[Count[Unit], Cause].err{added.err};
    }
    ret res[Count[Unit], Cause].ok{count[Unit](added.ok)};
}

#[testing]
fun count_sub[Unit](left: Count[Unit], right: Count[Unit])
    res[Count[Unit], Cause] {
    if (right.value > left.value) {
        ret res[Count[Unit], Cause].err{SUB_UNDERFLOW};
    }
    ret res[Count[Unit], Cause].ok{count[Unit](left.value - right.value)};
}

pub fun count_mul[Unit](value: Count[Unit], factor: usize)
    res[Count[Unit], Cause] {
    val multiplied: res[usize, Cause] = usize_mul(value.value, factor);
    if (sel multiplied.err) {
        ret res[Count[Unit], Cause].err{multiplied.err};
    }
    ret res[Count[Unit], Cause].ok{count[Unit](multiplied.ok)};
}

pub fun count_grow[Unit](current: Count[Unit], required: Count[Unit])
    res[Count[Unit], Cause] {
    if (required.value <= current.value) { ret res[Count[Unit], Cause].ok{current}; }
    if (current.value == 0) {
        var first: usize = 1;
        if (required.value > first) { first = required.value; }
        ret res[Count[Unit], Cause].ok{count[Unit](first)};
    }
    val doubled: res[usize, Cause] = usize_mul(current.value, 2);
    var next:    usize             = required.value;
    if (sel doubled.ok) {
        val candidate: usize = doubled.ok;
        if (candidate > next) { next = candidate; }
    }
    if (next <= current.value || next < required.value) {
        ret res[Count[Unit], Cause].err{ADD_OVERFLOW};
    }
    ret res[Count[Unit], Cause].ok{count[Unit](next)};
}

pub fun offset_add[Unit](base: Offset[Unit], amount: Count[Unit])
    res[Offset[Unit], Cause] {
    val added: res[usize, Cause] = usize_add(base.value, amount.value);
    if (sel added.err) {
        ret res[Offset[Unit], Cause].err{added.err};
    }
    ret res[Offset[Unit], Cause].ok{offset[Unit](added.ok)};
}

pub fun address_add[Space](base: Address[Space], amount: Count[ByteUnit])
    res[Address[Space], Cause] {
    val added: res[usize, Cause] = usize_add(base.value, amount.value);
    if (sel added.err) {
        ret res[Address[Space], Cause].err{added.err};
    }
    ret res[Address[Space], Cause].ok{address[Space](added.ok)};
}

fun checked_range[Unit](start: Offset[Unit], end: Offset[Unit])
    res[Range[Unit], Cause] {
    if (end.value < start.value) {
        ret res[Range[Unit], Cause].err{INVALID_RANGE};
    }
    var out: Range[Unit];
    out.start = start;
    out.end   = end;
    ret res[Range[Unit], Cause].ok{out};
}

fun range_from_count[Unit](start: Offset[Unit], length: Count[Unit])
    res[Range[Unit], Cause] {
    val end: res[Offset[Unit], Cause] = offset_add[Unit](start, length);
    if (sel end.err) {
        ret res[Range[Unit], Cause].err{end.err};
    }
    ret checked_range[Unit](start, end.ok);
}

#[testing]
pub fun range_count[Unit](value: Range[Unit]) res[Count[Unit], Cause] {
    if (value.end.value < value.start.value) {
        ret res[Count[Unit], Cause].err{INVALID_RANGE};
    }
    ret res[Count[Unit], Cause].ok{count[Unit](value.end.value - value.start.value)};
}

#[testing]
fun range_contains[Unit](value: Range[Unit], position: Offset[Unit]) bool {
    if (value.end.value < value.start.value) { ret false; }
    ret position.value >= value.start.value && position.value < value.end.value;
}

#[testing]
fun range_contains_range[Unit](outer: Range[Unit], inner: Range[Unit]) bool {
    if (outer.end.value < outer.start.value || inner.end.value < inner.start.value) { ret false; }
    ret inner.start.value >= outer.start.value && inner.end.value <= outer.end.value;
}

pub fun range_fits[Unit](available: Count[Unit], start: Offset[Unit],
    length: Count[Unit]) bool {
    val made: res[Range[Unit], Cause] = range_from_count[Unit](start, length);
    if (sel made.err) { ret false; }
    ret made.ok.end.value <= available.value;
}

pub fun alignment[Unit](value: usize) res[Alignment[Unit], Cause] {
    if (value == 0) { ret res[Alignment[Unit], Cause].err{INVALID_ALIGNMENT}; }
    var out: Alignment[Unit];
    out.value = value;
    ret res[Alignment[Unit], Cause].ok{out};
}

pub fun power_alignment[Unit](value: usize) res[PowerAlignment[Unit], Cause] {
    if (value == 0) {
        ret res[PowerAlignment[Unit], Cause].err{INVALID_ALIGNMENT};
    }
    if ((value & (value - 1)) != 0) {
        ret res[PowerAlignment[Unit], Cause].err{NON_POWER_ALIGNMENT};
    }
    var out: PowerAlignment[Unit];
    out.value = value;
    ret res[PowerAlignment[Unit], Cause].ok{out};
}

#[testing]
fun general_alignment[Unit](value: PowerAlignment[Unit])
    res[Alignment[Unit], Cause] {
    val checked: res[PowerAlignment[Unit], Cause] = power_alignment[Unit](value.value);
    if (sel checked.err) {
        ret res[Alignment[Unit], Cause].err{checked.err};
    }
    ret alignment[Unit](value.value);
}

pub fun align_offset_up[Unit](value: Offset[Unit], align: Alignment[Unit])
    res[Offset[Unit], Cause] {
    if (align.value == 0) {
        ret res[Offset[Unit], Cause].err{INVALID_ALIGNMENT};
    }
    val remainder: usize = value.value % align.value;
    if (remainder == 0) { ret res[Offset[Unit], Cause].ok{value}; }
    ret offset_add[Unit](value, count[Unit](align.value - remainder));
}

# the address-space twin of align_offset_up: a u64 value rounded up to a
# power-of-two alignment, refusing an invalid alignment and an overflow
pub fun align_u64_up(value: u64, align: u64) res[u64, Cause] {
    if (align == 0)                 { ret res[u64, Cause].err{INVALID_ALIGNMENT}; }
    if ((align & (align - 1)) != 0) { ret res[u64, Cause].err{NON_POWER_ALIGNMENT}; }
    val remainder: u64 = value % align;
    if (remainder == 0) { ret res[u64, Cause].ok{value}; }
    val pad_by: u64 = align - remainder;
    if (pad_by > ~(0::u64) - value) { ret res[u64, Cause].err{ADD_OVERFLOW}; }
    ret res[u64, Cause].ok{value + pad_by};
}

#[testing]
fun align_offset_down[Unit](value: Offset[Unit], align: Alignment[Unit])
    res[Offset[Unit], Cause] {
    if (align.value == 0) {
        ret res[Offset[Unit], Cause].err{INVALID_ALIGNMENT};
    }
    ret res[Offset[Unit], Cause].ok{offset[Unit](value.value - value.value % align.value)};
}

pub fun id[Domain](value: usize) Id[Domain] {
    var out: Id[Domain];
    out.value = value;
    ret out;
}

pub fun id_below[Domain](value: usize, upper: Count[Domain])
    res[Id[Domain], Cause] {
    if (value >= upper.value) { ret res[Id[Domain], Cause].err{ID_RANGE}; }
    ret res[Id[Domain], Cause].ok{id[Domain](value)};
}

#[testing]
pub fun usize_to_u8(value: usize) res[u8, Cause] {
    if (value::u8::usize != value) { ret res[u8, Cause].err{NARROWING}; }
    ret res[u8, Cause].ok{value::u8};
}

pub fun usize_to_u16(value: usize) res[u16, Cause] {
    if (value::u16::usize != value) { ret res[u16, Cause].err{NARROWING}; }
    ret res[u16, Cause].ok{value::u16};
}

pub fun usize_to_u32(value: usize) res[u32, Cause] {
    if (value::u32::usize != value) { ret res[u32, Cause].err{NARROWING}; }
    ret res[u32, Cause].ok{value::u32};
}

#[testing]
fun u64_to_usize(value: u64) res[usize, Cause] {
    if (value::usize::u64 != value) { ret res[usize, Cause].err{NARROWING}; }
    ret res[usize, Cause].ok{value::usize};
}

pub fun u64_to_u32(value: u64) res[u32, Cause] {
    if (value::u32::u64 != value) { ret res[u32, Cause].err{NARROWING}; }
    ret res[u32, Cause].ok{value::u32};
}

#[testing]
fun i64_to_i32(value: i64) res[i32, Cause] {
    if (value::i32::i64 != value) { ret res[i32, Cause].err{NARROWING}; }
    ret res[i32, Cause].ok{value::i32};
}

#[testing]
fun i64_to_u32(value: i64) res[u32, Cause] {
    if (value < 0 || value::u32::i64 != value) { ret res[u32, Cause].err{NARROWING}; }
    ret res[u32, Cause].ok{value::u32};
}

pub fun usize_to_i32(value: usize) res[i32, Cause] {
    if (value > 2147483647) { ret res[i32, Cause].err{NARROWING}; }
    ret res[i32, Cause].ok{value::i32};
}

#[testing]
fun pointer_count[T](data: *T, count: usize) res[Span[T], Cause] {
    if (count > 0 && data == nil) { ret res[Span[T], Cause].err{NIL_POINTER}; }
    if (count > 0 && $size_of(T) == 0) {
        ret res[Span[T], Cause].err{ZERO_SIZED_ELEMENT};
    }
    val multiplied: res[usize, Cause] = usize_mul(count, $size_of(T));
    if (sel multiplied.err) {
        ret res[Span[T], Cause].err{multiplied.err};
    }
    val bytes: usize = multiplied.ok;
    var begin: usize = 0;
    if (data != nil) {
        begin = data::usize;
        if (begin % $align_of(T) != 0) {
            ret res[Span[T], Cause].err{POINTER_ALIGNMENT};
        }
    }
    val added: res[usize, Cause] = usize_add(begin, bytes);
    if (sel added.err) {
        ret res[Span[T], Cause].err{POINTER_OVERFLOW};
    }
    var out: Span[T];
    out.data  = data;
    out.count = count;
    out.bytes = bytes;
    out.begin = begin;
    out.end   = added.ok;
    ret res[Span[T], Cause].ok{out};
}

#[testing]
fun span_valid[T](value: *Span[T]) bool {
    if (value == nil) { ret false; }
    val made: res[Span[T], Cause] = pointer_count[T](value.data, value.count);
    if (sel made.err) { ret false; }
    val expected: Span[T] = made.ok;
    ret value.data == expected.data && value.count == expected.count
        && value.bytes == expected.bytes && value.begin == expected.begin && value.end == expected.end;
}

#[testing]
rec TestUnit {}

#[testing]
rec ZeroSized {}

#[testing]
fun count_is_error(result: res[Count[TestUnit], Cause], cause: Cause) bool {
    if (!sel result.err) { ret false; }
    ret result.err == cause;
}

test count__add_sub_mul_boundaries {
    val maximum:  usize                       = ~(0::usize);
    val zero:     Count[TestUnit]             = count[TestUnit](0);
    val one:      Count[TestUnit]             = count[TestUnit](1);
    val largest:  Count[TestUnit]             = count[TestUnit](maximum);
    val zero_sum: res[Count[TestUnit], Cause] = count_add[TestUnit](zero, zero);
    if (sel zero_sum.err)       { ret 1; }
    if (zero_sum.ok.value != 0) { ret 1; }
    val maximum_sum: res[Count[TestUnit], Cause] = count_add[TestUnit](largest, zero);
    if (sel maximum_sum.err)                                              { ret 1; }
    if (maximum_sum.ok.value != maximum)                                  { ret 1; }
    if (!count_is_error(count_add[TestUnit](largest, one), ADD_OVERFLOW)) { ret 1; }
    if (!count_is_error(count_sub[TestUnit](zero, one), SUB_UNDERFLOW))   { ret 1; }
    val maximum_sub: res[Count[TestUnit], Cause] = count_sub[TestUnit](largest, largest);
    if (sel maximum_sub.err)       { ret 1; }
    if (maximum_sub.ok.value != 0) { ret 1; }
    val zero_product: res[Count[TestUnit], Cause] = count_mul[TestUnit](largest, 0);
    if (sel zero_product.err)       { ret 1; }
    if (zero_product.ok.value != 0) { ret 1; }
    val maximum_product: res[Count[TestUnit], Cause] = count_mul[TestUnit](largest, 1);
    if (sel maximum_product.err)                                        { ret 1; }
    if (maximum_product.ok.value != maximum)                            { ret 1; }
    if (!count_is_error(count_mul[TestUnit](largest, 2), MUL_OVERFLOW)) { ret 1; }
    ret 0;
}

#[testing]
fun grows_to(current: usize, required: usize, expect: usize) bool {
    val grown: res[Count[TestUnit], Cause] = count_grow[TestUnit](count[TestUnit](current), count[TestUnit](required));
    if (sel grown.err) { ret false; }
    ret grown.ok.value == expect;
}

test count_grow__meets_required_progress {
    val maximum: usize = ~(0::usize);
    if (!grows_to(5, 3, 5))                                             { ret 1; }
    if (!grows_to(0, 0, 0) || !grows_to(0, 1, 1) || !grows_to(0, 9, 9)) { ret 2; }
    if (!grows_to(4, 5, 8) || !grows_to(4, 20, 20))                     { ret 3; }
    if (!grows_to(maximum / 2 + 1, maximum / 2 + 2, maximum / 2 + 2))   { ret 4; }
    if (!grows_to(maximum - 1, maximum, maximum))                       { ret 5; }
    if (!grows_to(maximum, maximum, maximum))                           { ret 6; }
    ret 0;
}

test alignment__general_and_power_boundaries {
    val maximum: usize                           = ~(0::usize);
    val zero:    res[Alignment[TestUnit], Cause] = alignment[TestUnit](0);
    if (!sel zero.err)                 { ret 1; }
    if (zero.err != INVALID_ALIGNMENT) { ret 1; }
    val zero_power: res[PowerAlignment[TestUnit], Cause] = power_alignment[TestUnit](0);
    if (!sel zero_power.err) { ret 1; }
    if (zero_power.err != INVALID_ALIGNMENT) {
        ret 1;
    }
    val three_power: res[PowerAlignment[TestUnit], Cause] = power_alignment[TestUnit](3);
    if (!sel three_power.err)                   { ret 1; }
    if (three_power.err != NON_POWER_ALIGNMENT) { ret 1; }
    val general_three: res[Alignment[TestUnit], Cause] = alignment[TestUnit](3);
    if (sel general_three.err)       { ret 1; }
    if (general_three.ok.value != 3) { ret 1; }
    val six: res[Offset[TestUnit], Cause] = align_offset_up[TestUnit](
        offset[TestUnit](4), general_three.ok);
    if (sel six.err)       { ret 1; }
    if (six.ok.value != 6) { ret 1; }
    val kept: res[Offset[TestUnit], Cause] = align_offset_up[TestUnit](six.ok, general_three.ok);
    if (sel kept.err)       { ret 1; }
    if (kept.ok.value != 6) { ret 1; }
    val two_power_r: res[PowerAlignment[TestUnit], Cause] = power_alignment[TestUnit](2);
    if (sel two_power_r.err) { ret 1; }
    val two_power: PowerAlignment[TestUnit]        = two_power_r.ok;
    val two_made:  res[Alignment[TestUnit], Cause] = general_alignment[TestUnit](
        two_power);
    if (sel two_made.err) { ret 1; }
    val two:      Alignment[TestUnit]          = two_made.ok;
    val overflow: res[Offset[TestUnit], Cause] = align_offset_up[TestUnit](
        offset[TestUnit](maximum), two);
    if (!sel overflow.err)            { ret 1; }
    if (overflow.err != ADD_OVERFLOW) { ret 1; }
    val down: res[Offset[TestUnit], Cause] = align_offset_down[TestUnit](
        offset[TestUnit](maximum), two);
    if (sel down.err)                 { ret 1; }
    if (down.ok.value != maximum - 1) { ret 1; }

    var forged_zero:        PowerAlignment[TestUnit];
    val forged_zero_result: res[Alignment[TestUnit], Cause] = general_alignment[TestUnit](
        forged_zero);
    if (!sel forged_zero_result.err)                 { ret 1; }
    if (forged_zero_result.err != INVALID_ALIGNMENT) { ret 1; }
    var forged_three: PowerAlignment[TestUnit];
    forged_three.value = 3;
    val forged_three_result: res[Alignment[TestUnit], Cause] = general_alignment[TestUnit](
        forged_three);
    if (!sel forged_three_result.err)                   { ret 1; }
    if (forged_three_result.err != NON_POWER_ALIGNMENT) { ret 1; }
    ret 0;
}

test checked_range__is_half_open_and_overflow_safe {
    val maximum: usize                       = ~(0::usize);
    val made:    res[Range[TestUnit], Cause] = range_from_count[TestUnit](
        offset[TestUnit](5), count[TestUnit](3));
    if (sel made.err) { ret 1; }
    val value: Range[TestUnit] = made.ok;
    if (!range_contains[TestUnit](value, offset[TestUnit](5))) { ret 1; }
    if (!range_contains[TestUnit](value, offset[TestUnit](7))) { ret 1; }
    if (range_contains[TestUnit](value, offset[TestUnit](8)))  { ret 1; }
    val length: res[Count[TestUnit], Cause] = range_count[TestUnit](value);
    if (sel length.err)       { ret 1; }
    if (length.ok.value != 3) { ret 1; }
    val inner_r: res[Range[TestUnit], Cause] = checked_range[TestUnit](offset[TestUnit](6), offset[TestUnit](8));
    if (sel inner_r.err) { ret 1; }
    val inner: Range[TestUnit] = inner_r.ok;
    if (!range_contains_range[TestUnit](value, inner))                                      { ret 1; }
    if (!range_fits[TestUnit](count[TestUnit](8), offset[TestUnit](5), count[TestUnit](3))) { ret 1; }
    if (range_fits[TestUnit](count[TestUnit](7), offset[TestUnit](5), count[TestUnit](3)))  { ret 1; }
    if (range_fits[TestUnit](count[TestUnit](maximum), offset[TestUnit](maximum),
        count[TestUnit](1))) { ret 1; }
    val empty_r: res[Range[TestUnit], Cause] = checked_range[TestUnit](offset[TestUnit](maximum), offset[TestUnit](maximum));
    if (sel empty_r.err) { ret 1; }
    val empty: Range[TestUnit] = empty_r.ok;
    if (range_contains[TestUnit](empty, offset[TestUnit](maximum))) { ret 1; }
    if (!range_contains_range[TestUnit](empty, empty))              { ret 1; }
    val reversed: res[Range[TestUnit], Cause] = checked_range[TestUnit](
        offset[TestUnit](9), offset[TestUnit](8));
    if (!sel reversed.err)             { ret 1; }
    if (reversed.err != INVALID_RANGE) { ret 1; }
    val overflow: res[Range[TestUnit], Cause] = range_from_count[TestUnit](
        offset[TestUnit](maximum), count[TestUnit](1));
    if (!sel overflow.err)            { ret 1; }
    if (overflow.err != ADD_OVERFLOW) { ret 1; }
    var forged: Range[TestUnit];
    forged.start = offset[TestUnit](2);
    forged.end   = offset[TestUnit](1);
    if (range_contains[TestUnit](forged, offset[TestUnit](1))) { ret 1; }
    val r_591: res[Count[TestUnit], Cause] = range_count[TestUnit](forged);
    if (!sel r_591.err) { ret 1; }
    ret 0;
}

test narrowing__rejects_one_past_each_boundary {
    val usize_maximum: usize          = ~(0::usize);
    val r_662:         res[u8, Cause] = usize_to_u8(255);
    if (sel r_662.err) { ret 1; }
    val r_663: res[u8, Cause] = usize_to_u8(256);
    if (!sel r_663.err) { ret 1; }
    if (usize_maximum <= 65535) {
        val r_665: res[u16, Cause] = usize_to_u16(usize_maximum);
        if (sel r_665.err) { ret 1; }
    }
    or {
        val r_668: res[u16, Cause] = usize_to_u16(usize_maximum);
        if (!sel r_668.err) { ret 1; }
    }
    if (usize_maximum > 65535) {
        val r_671: res[u16, Cause] = usize_to_u16(65535);
        if (sel r_671.err) { ret 1; }
        val r_672: res[u16, Cause] = usize_to_u16(65536);
        if (!sel r_672.err) { ret 1; }
    }
    if (usize_maximum <= 4294967295) {
        val r_675: res[u32, Cause] = usize_to_u32(usize_maximum);
        if (sel r_675.err) { ret 1; }
    }
    or {
        val r_678: res[u32, Cause] = usize_to_u32(4294967295);
        if (sel r_678.err) { ret 1; }
        val r_679: res[u32, Cause] = usize_to_u32(4294967296::usize);
        if (!sel r_679.err) { ret 1; }
    }
    val r_681: res[u32, Cause] = u64_to_u32(4294967295);
    if (sel r_681.err) { ret 1; }
    val r_682: res[u32, Cause] = u64_to_u32(4294967296);
    if (!sel r_682.err) { ret 1; }
    val r_683: res[i32, Cause] = i64_to_i32(-2147483648);
    if (sel r_683.err) { ret 1; }
    val r_684: res[i32, Cause] = i64_to_i32(2147483647);
    if (sel r_684.err) { ret 1; }
    val r_685: res[i32, Cause] = i64_to_i32(-2147483649);
    if (!sel r_685.err) { ret 1; }
    val r_686: res[i32, Cause] = i64_to_i32(2147483648);
    if (!sel r_686.err) { ret 1; }
    val r_687: res[u32, Cause] = i64_to_u32(0);
    if (sel r_687.err) { ret 1; }
    val r_688: res[u32, Cause] = i64_to_u32(-1);
    if (!sel r_688.err) { ret 1; }
    val r_689: res[u32, Cause] = i64_to_u32(4294967296);
    if (!sel r_689.err) { ret 1; }
    if (usize_maximum <= 2147483647) {
        val r_691: res[i32, Cause] = usize_to_i32(usize_maximum);
        if (sel r_691.err) { ret 1; }
    }
    or {
        val r_694: res[i32, Cause] = usize_to_i32(2147483647);
        if (sel r_694.err) { ret 1; }
        val r_695: res[i32, Cause] = usize_to_i32(2147483648);
        if (!sel r_695.err) { ret 1; }
    }
    val portable: u64               = usize_maximum::u64;
    val r_698:    res[usize, Cause] = u64_to_usize(portable);
    if (sel r_698.err) { ret 1; }
    val r_699: res[usize, Cause] = u64_to_usize(portable);
    if (sel r_699.err)             { ret 1; }
    if (r_699.ok != usize_maximum) { ret 1; }
    if ($size_of(usize) < $size_of(u64)) {
        val r_701: res[usize, Cause] = u64_to_usize(portable + 1);
        if (!sel r_701.err) { ret 1; }
    }
    ret 0;
}

test pointer_count__validates_shape_extent_and_alignment {
    val empty: res[Span[u32], Cause] = pointer_count[u32](nil, 0);
    if (sel empty.err) { ret 1; }
    val empty_span: Span[u32] = empty.ok;
    if (empty_span.data != nil || empty_span.count != 0 || empty_span.bytes != 0) { ret 1; }
    val nil_nonempty: res[Span[u32], Cause] = pointer_count[u32](nil, 1);
    if (!sel nil_nonempty.err)           { ret 1; }
    if (nil_nonempty.err != NIL_POINTER) { ret 1; }
    var storage: [3]u32;
    val valid:   res[Span[u32], Cause] = pointer_count[u32](?storage[0], 3);
    if (sel valid.err) { ret 1; }
    val span: Span[u32] = valid.ok;
    if (span.count != 3 || span.bytes != 12 || span.begin != (?storage[0])::usize) { ret 1; }
    if (span.end != span.begin + 12)                                               { ret 1; }
    if (!span_valid[u32](?span))                                                   { ret 1; }
    var forged: Span[u32] = span;
    forged.bytes = 11;
    if (span_valid[u32](?forged)) { ret 1; }
    val zero_nonnull: res[Span[u32], Cause] = pointer_count[u32](?storage[0], 0);
    if (sel zero_nonnull.err) { ret 1; }
    val misaligned:    *u32                  = ((?storage[0])::usize + 1)::*u32;
    val bad_alignment: res[Span[u32], Cause] = pointer_count[u32](misaligned, 1);
    if (!sel bad_alignment.err)                 { ret 1; }
    if (bad_alignment.err != POINTER_ALIGNMENT) { ret 1; }
    val maximum:          usize                 = ~(0::usize);
    val near_end:         *u32                  = (maximum - 3)::*u32;
    val pointer_overflow: res[Span[u32], Cause] = pointer_count[u32](near_end, 1);
    if (!sel pointer_overflow.err)                { ret 1; }
    if (pointer_overflow.err != POINTER_OVERFLOW) { ret 1; }
    val count_overflow: res[Span[u32], Cause] = pointer_count[u32](?storage[0], maximum);
    if (!sel count_overflow.err)            { ret 1; }
    if (count_overflow.err != MUL_OVERFLOW) { ret 1; }
    var zero_value: ZeroSized;
    val zero_sized: res[Span[ZeroSized], Cause] = pointer_count[ZeroSized](
        ?zero_value, 1);
    if (!sel zero_sized.err)                  { ret 1; }
    if (zero_sized.err != ZERO_SIZED_ELEMENT) { ret 1; }
    ret 0;
}
