use std.types.string.str;

pub val MACH_VERSION: str = "4.26.5";

test "mach.lang.version:matches_project_release" {
    $if ($project.id == "mach") {
        $if (MACH_VERSION != $project.version) { ret 1; }
    }
    $if ($project.id == "mach-version-vendor-test") {
        $if (MACH_VERSION == $project.version) { ret 1; }
    }
    ret 0;
}
