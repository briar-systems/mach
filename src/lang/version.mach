use std.types.string.str;

pub val MACH_VERSION: str = "5.13.0";

test matches_project_release {
    $if ($project.id == "mach") {
        $if (MACH_VERSION != $project.version) { ret 1; }
    }
    $if ($project.id == "mach-version-vendor-test") {
        $if (MACH_VERSION == $project.version) { ret 1; }
    }
    ret 0;
}
