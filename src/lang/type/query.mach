# questions about the types in the store whose answers derive from the field tables:
# substitution, the deep properties, extent, secrecy agreement, containment and
# expansiveness, each a module under this one. the facts worth keeping are cached in one
# record that only this module reads or writes, stamped with the projection generation
# they were derived under
use std.collections.map;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;

use A: std.allocator;

use lang_alloc: mach.lang.alloc;
use mach.lang.fail;
use mach.lang.type;

# the cached facts: whether each decided generic is expansive, and whether each nominal's
# fields mention a type parameter. a lookup under a later generation drops them first
pub rec Facts {
    generation: u64;
    expansive:  map.Map[type.TypeId, bool];
    mentions:   map.Map[type.TypeId, bool];
}

pub fun facts_init(a: *A.Allocator) Facts {
    ret Facts{generation: 0, expansive: map.init[type.TypeId, bool](a), mentions: map.init[type.TypeId, bool](a)};
}

pub fun facts_dnit(f: *Facts) {
    map.dnit[type.TypeId, bool](?f.expansive);
    map.dnit[type.TypeId, bool](?f.mentions);
}

# one question put to the store: what it reads, the facts it may consult and record, and
# where an internal failure lands
pub rec Query {
    types:  *type.TypeInterner;
    facts:  *Facts;
    status: *fail.PhaseStatus;
}

# a query's answer, or the internal failure it met
pub fun answer[T](q: *Query, value: T) res[T, fail.Fail] {
    if (sel q.status.kind.internal) { ret res[T, fail.Fail].err{fail.message(q.status.kind.internal)}; }
    ret res[T, fail.Fail].ok{value};
}

# a query that answers nothing but whether it met an internal failure
pub fun settled(q: *Query) err[fail.Fail] {
    if (sel q.status.kind.internal) { ret err[fail.Fail].err{fail.message(q.status.kind.internal)}; }
    ret err[fail.Fail].ok{};
}

pub fun refused(q: *Query, e: A.Error) {
    fail.internal(q.status, lang_alloc.text(e));
}

pub fun failed(q: *Query, f: fail.Fail) {
    fail.internal(q.status, fail.describe(f));
}

# opens `scan` over the store; false, with the failure recorded, when it cannot
pub fun scan_begin(q: *Query, scan: *type.TypeScan) bool {
    val opened: err[fail.Fail] = type.type_scan_begin(q.types, scan);
    if (sel opened.err) {
        failed(q, opened.err);
        ret false;
    }
    ret true;
}

pub fun scan_end(q: *Query, scan: *type.TypeScan) {
    type.type_scan_end(q.types, scan);
}

# whether `scan` meets `tid` for the first time; a mark that cannot be recorded is a
# failure and reads as already seen, so no walk descends past it
pub fun scan_fresh(q: *Query, scan: *type.TypeScan, tid: type.TypeId) bool {
    val mark: res[type.VisitMark, fail.Fail] = type.type_scan_mark(q.types, scan, tid);
    if (sel mark.err) {
        failed(q, mark.err);
        ret false;
    }
    ret mark.ok == type.VISIT_FRESH;
}

fun facts_follow(q: *Query) {
    val now: u64 = q.types.projection_generation;
    if (q.facts.generation == now) { ret; }
    map.clear[type.TypeId, bool](?q.facts.expansive);
    map.clear[type.TypeId, bool](?q.facts.mentions);
    q.facts.generation = now;
}

fun fact_get(m: *map.Map[type.TypeId, bool], tid: type.TypeId) opt[bool] {
    val hit: opt[*bool] = map.get[type.TypeId, bool](m, ?tid);
    if (sel hit.some) { ret opt[bool].some{@hit.some}; }
    ret opt[bool].none{};
}

fun fact_set(q: *Query, m: *map.Map[type.TypeId, bool], tid: type.TypeId, value: bool) {
    val put: res[bool, A.Error] = map.insert[type.TypeId, bool](m, tid, value);
    if (sel put.err) { refused(q, put.err); }
}

# the recorded verdict on whether generic nominal `nominal` is expansive, none while undecided
pub fun expansive_get(q: *Query, nominal: type.TypeId) opt[bool] {
    facts_follow(q);
    ret fact_get(?q.facts.expansive, nominal);
}

# records a verdict once; a nominal already decided keeps its first
pub fun expansive_set(q: *Query, nominal: type.TypeId, expansive: bool) {
    facts_follow(q);
    val prior: opt[bool] = fact_get(?q.facts.expansive, nominal);
    if (sel prior.some) { ret; }
    fact_set(q, ?q.facts.expansive, nominal, expansive);
}

# the recorded answer to whether `nominal`'s fields mention a type parameter
pub fun mentions_get(q: *Query, nominal: type.TypeId) opt[bool] {
    facts_follow(q);
    ret fact_get(?q.facts.mentions, nominal);
}

pub fun mentions_set(q: *Query, nominal: type.TypeId, mentions: bool) {
    facts_follow(q);
    fact_set(q, ?q.facts.mentions, nominal, mentions);
}
