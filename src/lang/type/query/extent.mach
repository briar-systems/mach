# the size, alignment and field offsets of a type, from the same checked layout the
# backend lays it out by
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;

use mach.lang.fail;
use mach.lang.layout;
use mach.lang.session;
use mach.lang.type;
use type_query: mach.lang.type.query;
use mach.lang.type.query.subst;

# a layout walk's view of the store: the query it answers within, and the session that
# records each type's declared alignment and packing
pub rec Measure {
    q: *type_query.Query;
    s: *session.Session;
}

pub fun describe(mz: *Measure, id: u32) layout.Node {
    if (id == type.index(type.TYPE_NIL)) { ret layout.node(layout.NODE_ZERO); }
    val base: type.TypeId = type.strip_secret(mz.q.types, id::type.TypeId);

    val opt_type: opt[*type.Type] = type.get(mz.q.types, base);
    if (!sel opt_type.some) { ret layout.node(layout.NODE_UNKNOWN); }
    val t: *type.Type = opt_type.some;

    val d: type.PrimDesc = type.prim_desc(t.kind);
    if (d.class == type.PRIM_CLASS_INT || d.class == type.PRIM_CLASS_FLOAT) {
        var n: layout.Node = layout.node(layout.NODE_SCALAR);
        n.bytes = d.bits / 8;
        ret n;
    }
    if (d.class == type.PRIM_CLASS_PTR || t.kind == type.TYPE_POINTER || t.kind == type.TYPE_FUN
        || t.kind == type.TYPE_HANDLE) {
        ret layout.node(layout.NODE_POINTER);
    }
    if (t.kind == type.TYPE_ABI) {
        var n: layout.Node = layout.node(layout.NODE_OPAQUE);
        n.bytes      = t.data.abi.size;
        n.decl_align = t.data.abi.align;
        ret n;
    }
    if (t.kind == type.TYPE_VECTOR) {
        var n: layout.Node = layout.node(layout.NODE_VECTOR);
        n.bytes = type.prim_desc(t.data.vector.element).bits / 8;
        n.count = t.data.vector.lanes;
        ret n;
    }

    if (t.kind == type.TYPE_ARRAY) {
        var n: layout.Node = layout.node(layout.NODE_ARRAY);
        n.child = t.data.array.base::u32;
        n.count = t.data.array.count;
        ret n;
    }

    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_TAG || t.kind == type.TYPE_INSTANCE) {
        if (t.kind == type.TYPE_INSTANCE) { subst.ensure(mz.q, base); }

        val ov:     opt[bool] = overlays(mz, base);
        val tagged: bool      = type.is_tag(mz.q.types, base);
        if (!tagged && !sel ov.some) { ret layout.node(layout.NODE_UNKNOWN); }
        val opt_tab: opt[*type.FieldTable] = type.field_table_for(mz.q.types, base);
        if (!sel opt_tab.some) { ret layout.node(layout.NODE_UNKNOWN); }

        var n: layout.Node = layout.node(layout.NODE_AGGREGATE);
        n.field_count = opt_tab.some.fields_len;
        if (tagged) {
            n.kind  = layout.NODE_TAG;
            n.bytes = type.tag_discriminator_bytes(mz.q.types, base);
        }
        or (sel ov.some) { n.overlays = ov.some; }
        val ta: opt[u32] = session.type_align(mz.s, base::u32);
        if (sel ta.some) { n.decl_align = ta.some; }
        n.packed = session.type_is_packed(mz.s, base::u32);
        ret n;
    }

    ret layout.node(layout.NODE_UNKNOWN);
}

pub fun field(mz: *Measure, id: u32, index: u32) u32 {
    val base: type.TypeId           = type.strip_secret(mz.q.types, id::type.TypeId);
    val fe:   opt[*type.FieldEntry] = type.field_at(mz.q.types, base, index);
    if (!sel fe.some) { ret type.index(type.TYPE_ERROR); }
    ret fe.some.ty::u32;
}

# how deep a layout walk descends before it gives up
pub val MAX_DEPTH: u32 = 64;

pub fun size(mz: *Measure, m: layout.Machine, tid: type.TypeId) layout.Extent {
    ret layout.extent_of[Measure](mz, describe, field, tid::u32, m, MAX_DEPTH);
}

fun overlays(mz: *Measure, tid: type.TypeId) opt[bool] {
    val nom: type.TypeId = type.aggregate_nominal(mz.q.types, tid);
    if (type.is_error(nom)) { ret opt[bool].none{}; }
    val opt_nom: opt[*type.Type] = type.get(mz.q.types, nom);
    if (!sel opt_nom.some) { ret opt[bool].none{}; }
    val k: type.TypeKind = opt_nom.some.kind;
    if (k == type.TYPE_UNI) { ret opt[bool].some{true}; }
    if (k == type.TYPE_REC) { ret opt[bool].some{false}; }
    ret opt[bool].none{};
}

pub fun of(s: *session.Session, m: layout.Machine, tid: type.TypeId) res[layout.Extent, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var q:      type_query.Query = type_query.Query{types: ?s.types, facts: ?s.type_facts, status: ?status};
    var mz:     Measure          = Measure{q: ?q, s: s};
    ret type_query.answer[layout.Extent](?q, size(?mz, m, tid));
}

# the byte offset of a record field or tag payload from the same checked layout that sizes
# the type; `size` carries the offset when `ok`
pub fun field_offset(s: *session.Session, m: layout.Machine, tid: type.TypeId, field_ix: u32) res[layout.Extent, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var q:      type_query.Query = type_query.Query{types: ?s.types, facts: ?s.type_facts, status: ?status};
    var mz:     Measure          = Measure{q: ?q, s: s};
    val base:   type.TypeId      = type.strip_secret(?s.types, tid);
    ret type_query.answer[layout.Extent](?q, layout.field_offset_of[Measure](?mz, describe, field, base::u32, field_ix, m, MAX_DEPTH));
}
