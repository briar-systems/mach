# whether two types laid over one storage keep every byte's secrecy class: a cast or
# retype from one to the other, or two union variants
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use mach.lang.fail;
use mach.lang.session;
use mach.lang.type;
use type_query: mach.lang.type.query;
use mach.lang.type.query.deep;
use mach.lang.type.query.expansive;
use mach.lang.type.query.extent;
use mach.lang.type.query.placement;

# one run of bytes of the same secrecy class, as offsets into the type's storage;
# a pointer run carries the stripped pointer type whose target it reaches
rec Run {
    start:    u32;
    end:      u32;
    ptr:      bool;
    secret:   bool;
    conflict: bool;
    leaf:     type.TypeId;
    # an instance of a generic whose argument grows through a pointer, met and not entered:
    # each of its pointers reaches a fresh instance, so below a pointer it is compared with
    # an instance of the same generic by its arguments and never walked. with `conflict` it
    # is a union variant, whose class at the byte is unknown until it is entered
    inst: type.TypeId;
    # the innermost named field holding the run, which names a disagreement
    owner: type.TypeId;
    field: u32;
}

rec Comparison {
    mz:   *extent.Measure;
    scan: *type.PairScan;
    # the walk met storage it cannot compare, which no answer can settle
    unbounded: bool;
    # the walk stands at the two types compared, above every pointer, where an instance
    # that grows is entered byte by byte; below a pointer it never is, which bounds the walk
    open: bool;
    # the parameter places of the generics compared by their arguments, opened on first use
    places: placement.Places;
    placed: bool;
    # the first field the answer turned on, TYPE_NIL while none is known
    owner: type.TypeId;
    field: u32;
}

# how two storages compare on secrecy: they agree, they disagree, or the comparison
# reaches an instance of a generic that grows through a pointer where it cannot be lined
# up with the other side, so it cannot be decided and is refused
def Agreement: u8;

pub val AGREE:       Agreement = 0;
pub val DISAGREE:    Agreement = 1;
pub val UNDECIDABLE: Agreement = 2;

# an answer and the field it turned on. for a disagreement, `owner` is the aggregate whose
# field `field` holds the first byte whose class differs; for an undecidable comparison it
# is the instance that grows, with `field` the field whose laid arguments differ in size or
# alignment between the sides, or NO_FIELD when the other side holds storage of another
# shape. `owner` is TYPE_NIL when no field is known
pub rec Verdict {
    agreement: Agreement;
    owner:     type.TypeId;
    field:     u32;
}

pub val NO_FIELD: u32 = 0xFFFFFFFF;

fun agreement_of(agree: bool, unbounded: bool) Agreement {
    if (agree)     { ret AGREE; }
    if (unbounded) { ret UNDECIDABLE; }
    ret DISAGREE;
}

fun comparison(mz: *extent.Measure, scan: *type.PairScan) Comparison {
    var w: Comparison;
    w.mz        = mz;
    w.scan      = scan;
    w.unbounded = false;
    w.open      = true;
    w.placed    = false;
    w.owner     = type.TYPE_NIL;
    w.field     = NO_FIELD;
    ret w;
}

fun comparison_end(w: *Comparison) {
    if (w.placed) { placement.dnit(?w.places); }
}

fun verdict(w: *Comparison, agree: bool) Verdict {
    if (agree) { ret Verdict{agreement: AGREE, owner: type.TYPE_NIL, field: NO_FIELD}; }
    ret Verdict{agreement: agreement_of(false, w.unbounded), owner: w.owner, field: w.field};
}

# records the field the answer turns on; the first one stands, which is the deepest, since
# a walk fails from the inside out
fun witness(w: *Comparison, owner: type.TypeId, field: u32) {
    if (!type.is_nil(w.owner)) { ret; }
    w.owner = owner;
    w.field = field;
}

fun witness_runs(w: *Comparison, a: Run, b: Run) {
    if (!type.is_nil(a.owner)) { witness(w, a.owner, a.field); }
    or (!type.is_nil(b.owner)) { witness(w, b.owner, b.field); }
}

fun run(start: u32, end: u32) Run {
    ret Run{start: start, end: end, ptr: false, secret: false, conflict: false, leaf: type.TYPE_NIL,
        inst: type.TYPE_NIL, owner: type.TYPE_NIL, field: NO_FIELD};
}

fun data_run(start: u32, end: u32, secret: bool) Run {
    var out: Run = run(start, end);
    out.secret = secret;
    ret out;
}

# a byte the walk cannot classify; it agrees with nothing
fun conflict_run(off: u32) Run {
    var out: Run = run(off, off + 1);
    out.conflict = true;
    ret out;
}

fun shift_run(r: Run, by: u32) Run {
    var out: Run = r;
    out.start = r.start + by;
    out.end   = r.end + by;
    ret out;
}

# names the field holding a run that no field inside it claimed
fun held_by(r: Run, owner: type.TypeId, field: u32) Run {
    if (!type.is_nil(r.owner)) { ret r; }
    var out: Run = r;
    out.owner = owner;
    out.field = field;
    ret out;
}

fun grows(w: *Comparison, base: type.TypeId) bool {
    val t: opt[*type.Type] = type.get(w.mz.q.types, base);
    if (!sel t.some)                       { ret false; }
    if (t.some.kind != type.TYPE_INSTANCE) { ret false; }
    ret expansive.nominal(w.mz.q, t.some.data.instance.nominal);
}

# the run of `tid` that holds byte `off`; padding is public, and an array of one
# data class is a single run. an instance that grows is entered only when `open`, and
# stands as one run otherwise. the walk recurses as deep as the type nests, so it asks for
# stack before it descends, and a type nested deeper refuses the query and reads as a
# conflict
fun secrecy_run_at(w: *Comparison, tid: type.TypeId, inherited: bool, off: u32, open: bool) Run {
    if (!type_query.descend(w.mz.q)) { ret conflict_run(off); }
    val secret: bool          = inherited || type.is_secret(w.mz.q.types, tid);
    val base:   type.TypeId   = type.strip_secret(w.mz.q.types, tid);
    val e:      extent.Extent = extent.size(w.mz, base);
    if (!e.ok || off >= e.size) { ret conflict_run(off); }
    val n: extent.Node = extent.describe(w.mz, base::u32);

    if (n.kind == extent.NODE_SCALAR || n.kind == extent.NODE_VECTOR || n.kind == extent.NODE_OPAQUE) {
        ret data_run(0, e.size, secret);
    }
    if (n.kind == extent.NODE_POINTER) {
        var out: Run = data_run(0, e.size, secret);
        out.ptr  = true;
        out.leaf = base;
        ret out;
    }

    if (!open && (n.kind == extent.NODE_AGGREGATE || n.kind == extent.NODE_TAG) && grows(w, base)) {
        var out: Run = data_run(0, e.size, secret);
        out.inst = base;
        ret out;
    }

    if (n.kind == extent.NODE_ARRAY) {
        val child: type.TypeId   = n.child::type.TypeId;
        val ce:    extent.Extent = extent.size(w.mz, type.strip_secret(w.mz.q.types, child));
        if (!ce.ok || ce.size == 0) { ret conflict_run(off); }
        val at:    u32 = (off / ce.size) * ce.size;
        val inner: Run = secrecy_run_at(w, child, secret, off - at, open);
        if (!inner.ptr && !inner.conflict && type.is_nil(inner.inst) && inner.start == 0 && inner.end == ce.size) {
            ret held_by(data_run(at, e.size, inner.secret), inner.owner, inner.field);
        }
        ret shift_run(inner, at);
    }

    if (n.kind == extent.NODE_TAG) {
        val disc: u32 = n.bytes;
        if (off < disc) { ret data_run(0, disc, false); }
        val pe: extent.Extent = extent.offset(w.mz, base, 0);
        if (!pe.ok)        { ret conflict_run(off); }
        if (off < pe.size) { ret data_run(disc, pe.size, false); }
        ret overlay_run_at(w, base, n.field_count, pe.size, e.size, secret, off, open);
    }

    if (n.kind == extent.NODE_AGGREGATE && n.overlays) {
        ret overlay_run_at(w, base, n.field_count, 0, e.size, secret, off, open);
    }

    if (n.kind == extent.NODE_AGGREGATE) {
        var prev_end: u32 = 0;
        var i:        u32 = 0;
        for (i < n.field_count) {
            val fty: type.TypeId   = extent.field(w.mz, base::u32, i)::type.TypeId;
            val fe:  extent.Extent = extent.size(w.mz, type.strip_secret(w.mz.q.types, fty));
            if (!fe.ok) { ret conflict_run(off); }
            val placed: extent.Extent = extent.offset(w.mz, base, i);
            if (!placed.ok) { ret conflict_run(off); }
            val offset: u32 = placed.size;
            if (off < offset) { ret data_run(prev_end, offset, false); }
            if (off < offset + fe.size) {
                ret held_by(shift_run(secrecy_run_at(w, fty, secret, off - offset, open), offset), base, i);
            }
            prev_end = offset + fe.size;
            i        = i + 1;
        }
        ret data_run(prev_end, e.size, false);
    }

    ret conflict_run(off);
}

# the variants of a union or tag payload overlay one storage from `at`; a byte
# takes the class every variant covering it agrees on, and a conflict otherwise
fun overlay_run_at(w: *Comparison, base: type.TypeId, count: u32, at: u32, size: u32, secret: bool,
    off: u32, open: bool) Run {
    var covered:   bool = false;
    var out:       Run  = data_run(at, size, false);
    var uncovered: u32  = at;
    var i:         u32  = 0;
    for (i < count) {
        val vty: type.TypeId   = extent.field(w.mz, base::u32, i)::type.TypeId;
        val ve:  extent.Extent = extent.size(w.mz, type.strip_secret(w.mz.q.types, vty));
        if (!ve.ok) { ret conflict_run(off); }
        if (off < at + ve.size) {
            val r: Run = held_by(shift_run(secrecy_run_at(w, vty, secret, off - at, open), at), base, i);
            if (!covered) {
                out     = r;
                covered = true;
            }
            or {
                out = merge_overlay_runs(w, out, r);
            }
        }
        or (at + ve.size > uncovered) { uncovered = at + ve.size; }
        i = i + 1;
    }
    if (!covered) { ret data_run(uncovered, size, false); }
    ret out;
}

fun merge_overlay_runs(w: *Comparison, a: Run, b: Run) Run {
    var out: Run = a;
    if (b.start > out.start) { out.start = b.start; }
    if (b.end < out.end)     { out.end = b.end; }
    # a variant that grows has no class at the byte until it is entered
    if (!type.is_nil(a.inst) || !type.is_nil(b.inst)) {
        out.conflict = true;
        if (type.is_nil(out.inst)) { out.inst = b.inst; }
        ret out;
    }
    if (a.conflict || b.conflict || a.ptr != b.ptr || a.secret != b.secret) {
        out.conflict = true;
        ret out;
    }
    if (a.ptr && (a.start != b.start || a.end != b.end || !pointer_leaves_equal(w, a.leaf, b.leaf))) {
        out.conflict = true;
    }
    ret out;
}

# a run that holds no secret and reaches none
fun run_is_public(w: *Comparison, r: Run) bool {
    if (r.conflict || r.secret) { ret false; }
    if (!r.ptr)                 { ret true; }
    ret !deep.secret(w.mz.q, r.leaf);
}

# a byte keeps its class, or with `add` may turn from public to secret
fun class_agrees(a: bool, b: bool, add: bool) bool {
    ret a == b || (add && !a && b);
}

fun runs_agree(w: *Comparison, a: Run, b: Run, add: bool) bool {
    if (a.conflict || b.conflict) { ret false; }
    if (!a.ptr && !b.ptr)         { ret class_agrees(a.secret, b.secret, add); }
    if (a.ptr && b.ptr && a.start == b.start && a.end == b.end) {
        ret class_agrees(a.secret, b.secret, add) && pointer_leaves_equal(w, a.leaf, b.leaf);
    }
    ret run_is_public(w, a) && run_is_public(w, b);
}

# beneath a pointer the target is shared storage, so the two targets must match
# both ways: equal extent and the same class at every byte
fun pointer_leaves_equal(w: *Comparison, a: type.TypeId, b: type.TypeId) bool {
    if (!deep.secret(w.mz.q, a) && !deep.secret(w.mz.q, b)) { ret true; }

    val oa: opt[*type.Type] = type.get(w.mz.q.types, a);
    val ob: opt[*type.Type] = type.get(w.mz.q.types, b);
    if (!sel oa.some) { ret false; }
    if (!sel ob.some) { ret false; }
    val ta: *type.Type = oa.some;
    val tb: *type.Type = ob.some;

    if (ta.kind == type.TYPE_POINTER && tb.kind == type.TYPE_POINTER) {
        ret storage_equal(w, ta.data.pointer.base, tb.data.pointer.base);
    }
    if (ta.kind == type.TYPE_FUN && tb.kind == type.TYPE_FUN) {
        if (ta.data.fn.params_len != tb.data.fn.params_len)              { ret false; }
        if (!storage_equal(w, ta.data.fn.ret_type, tb.data.fn.ret_type)) { ret false; }
        var pi: u32 = 0;
        for (pi < ta.data.fn.params_len) {
            val pa: opt[type.TypeId] = type.get_param(w.mz.q.types, ta.data.fn.params_start + pi);
            val pb: opt[type.TypeId] = type.get_param(w.mz.q.types, tb.data.fn.params_start + pi);
            if (!sel pa.some)                        { ret false; }
            if (!sel pb.some)                        { ret false; }
            if (!storage_equal(w, pa.some, pb.some)) { ret false; }
            pi = pi + 1;
        }
        ret true;
    }
    ret false;
}

fun storage_equal(w: *Comparison, a: type.TypeId, b: type.TypeId) bool {
    if (type.is_nil(a) || type.is_nil(b))                   { ret type.same(a, b); }
    if (type.same(a, b))                                    { ret true; }
    if (!deep.secret(w.mz.q, a) && !deep.secret(w.mz.q, b)) { ret true; }

    val mark_r: res[type.VisitMark, fail.Fail] = type.pair_scan_mark(w.mz.q.types, w.scan, a, b);
    if (sel mark_r.err) {
        type_query.failed(w.mz.q, mark_r.err);
        ret false;
    }
    if (mark_r.ok == type.VISIT_SEEN) { ret true; }

    val ea: extent.Extent = extent.size(w.mz, type.strip_secret(w.mz.q.types, a));
    val eb: extent.Extent = extent.size(w.mz, type.strip_secret(w.mz.q.types, b));
    if (!ea.ok || !eb.ok || ea.size != eb.size) { ret false; }
    val open: bool = w.open;
    w.open = false;
    val agree: bool = agree_below(w, a, b, ea.size, false, false);
    w.open = open;
    ret agree;
}

# two runs of instances of one generic that grows, at one span with one class
fun paired(w: *Comparison, a: Run, b: Run) bool {
    if (type.is_nil(a.inst) || type.is_nil(b.inst))       { ret false; }
    if (a.conflict || b.conflict || a.secret != b.secret) { ret false; }
    if (a.start != b.start || a.end != b.end)             { ret false; }
    val ta: opt[*type.Type] = type.get(w.mz.q.types, a.inst);
    val tb: opt[*type.Type] = type.get(w.mz.q.types, b.inst);
    if (!sel ta.some) { ret false; }
    if (!sel tb.some) { ret false; }
    ret type.same(ta.some.data.instance.nominal, tb.some.data.instance.nominal)
        && ta.some.data.instance.args_len == tb.some.data.instance.args_len;
}

fun laid(held: u8) placement.Place {
    if ((held & placement.LAID::u8) != 0) { ret placement.LAID; }
    ret placement.LAID_SECRET;
}

# two instances of one generic that grows, compared by their arguments, never walked: each
# argument is checked by the relation its parameter's places ask, and one that sits nowhere
# is not checked at all. that is sound by congruence, since every byte of either instance
# and of everything below it is an argument's byte at a place the relation covers, or the
# same declared byte on both sides. it is exact once every laid argument has one size and
# alignment on both sides, which lines the two layouts up; where they differ, padding can
# make them agree at one depth and differ at the next, so the answer is undecidable
fun instances_agree(w: *Comparison, a: Run, b: Run) bool {
    val oa: opt[*type.Type] = type.get(w.mz.q.types, a.inst);
    val ob: opt[*type.Type] = type.get(w.mz.q.types, b.inst);
    if (!sel oa.some) { ret unpaired(w); }
    if (!sel ob.some) { ret unpaired(w); }
    val ta:      *type.Type  = oa.some;
    val tb:      *type.Type  = ob.some;
    val generic: type.TypeId = ta.data.instance.nominal;
    if (!w.placed) {
        w.places = placement.init(w.mz.q);
        w.placed = true;
    }
    if (!placement.settle(?w.places, generic)) {
        w.unbounded = true;
        witness(w, a.inst, NO_FIELD);
        ret false;
    }
    val count: u32 = ta.data.instance.args_len;
    var j:     u32 = 0;
    for (j < count) {
        val held: u8 = placement.bits(?w.places, generic, j);
        if ((held & (placement.LAID::u8 | placement.LAID_SECRET::u8)) != 0) {
            val ea: extent.Extent = arg_extent(w, ta, j);
            val eb: extent.Extent = arg_extent(w, tb, j);
            if (!ea.ok || !eb.ok) { ret false; }
            if (ea.size != eb.size || ea.align != eb.align) {
                w.unbounded = true;
                witness(w, a.inst, placement.via(?w.places, generic, j, laid(held)));
                ret false;
            }
        }
        j = j + 1;
    }
    j = 0;
    for (j < count) {
        val held: u8          = placement.bits(?w.places, generic, j);
        val x:    type.TypeId = arg_at(w, ta, j);
        val y:    type.TypeId = arg_at(w, tb, j);
        var k:    u32         = 0;
        for (k < placement.PLACE_COUNT) {
            val at: placement.Place = placement.place_at(k);
            if ((held & at::u8) != 0 && !args_agree(w, x, y, at, a.secret)) {
                witness(w, a.inst, placement.via(?w.places, generic, j, at));
                ret false;
            }
            k = k + 1;
        }
        j = j + 1;
    }
    ret true;
}

# a pair `paired` admitted whose instance the store does not hold
fun unpaired(w: *Comparison) bool {
    fail.internal(w.mz.q.status, "secrecy: a paired instance is not in the store");
    ret false;
}

fun arg_at(w: *Comparison, t: *type.Type, j: u32) type.TypeId {
    val arg: opt[type.TypeId] = type.get_param(w.mz.q.types, t.data.instance.args_start + j);
    if (!sel arg.some) {
        fail.internal(w.mz.q.status, "secrecy: an argument list runs past the store");
        ret type.TYPE_ERROR;
    }
    ret arg.some;
}

fun arg_extent(w: *Comparison, t: *type.Type, j: u32) extent.Extent {
    ret extent.size(w.mz, type.strip_secret(w.mz.q.types, arg_at(w, t, j)));
}

# two arguments at one place: a laid pair, whose layouts already agree, keeps the class of
# every byte, under `^` when the place or the instance holding it is secret; a pointee pair
# is shared storage, compared both ways
fun args_agree(w: *Comparison, x: type.TypeId, y: type.TypeId, at: placement.Place, secret: bool) bool {
    if (at == placement.POINTEE) { ret storage_equal(w, x, y); }
    val ex: extent.Extent = extent.size(w.mz, type.strip_secret(w.mz.q.types, x));
    val ey: extent.Extent = extent.size(w.mz, type.strip_secret(w.mz.q.types, y));
    if (!ex.ok || !ey.ok || ex.size != ey.size) { ret false; }
    ret agree_below(w, x, y, ex.size, false, secret || at != placement.LAID);
}

# every byte below `limit`, which both types cover, has one class on both sides, or with
# `add` is public in `a` where `b` makes it secret; with `inherited` every byte is secret on
# both, so only the shape of the runs and the targets of the pointers are compared
fun agree_below(w: *Comparison, a: type.TypeId, b: type.TypeId, limit: u32, add: bool, inherited: bool) bool {
    var pos: u32 = 0;
    for (pos < limit) {
        var ra: Run = secrecy_run_at(w, a, inherited, pos, false);
        var rb: Run = secrecy_run_at(w, b, inherited, pos, false);
        if (sel w.mz.q.status.kind.internal || w.mz.q.nested) { ret false; }
        if (!type.is_nil(ra.inst) || !type.is_nil(rb.inst)) {
            if (!w.open && paired(w, ra, rb)) {
                if (!instances_agree(w, ra, rb)) { ret false; }
                pos = ra.end;
                cnt;
            }
            if (!w.open) {
                w.unbounded = true;
                if (!type.is_nil(ra.inst)) { witness(w, ra.inst, NO_FIELD); }
                or                         { witness(w, rb.inst, NO_FIELD); }
                ret false;
            }
            ra = secrecy_run_at(w, a, inherited, pos, true);
            rb = secrecy_run_at(w, b, inherited, pos, true);
            if (sel w.mz.q.status.kind.internal || w.mz.q.nested) { ret false; }
        }
        if (!runs_agree(w, ra, rb, add)) {
            witness_runs(w, ra, rb);
            ret false;
        }
        var next: u32 = ra.end;
        if (rb.end < next) { next = rb.end; }
        pos = next;
    }
    ret true;
}

# the one data class that holds every byte of the type; none for a type with no
# bytes, a pointer or a byte of mixed class
fun single_class(w: *Comparison, tid: type.TypeId, size: u32) opt[bool] {
    if (size == 0) { ret opt[bool].none{}; }
    val first: Run = secrecy_run_at(w, tid, false, 0, true);
    if (first.ptr || first.conflict) { ret opt[bool].none{}; }
    var pos: u32 = first.end;
    for (pos < size) {
        val r: Run = secrecy_run_at(w, tid, false, pos, true);
        if (r.ptr || r.conflict || r.secret != first.secret) { ret opt[bool].none{}; }
        pos = r.end;
    }
    ret opt[bool].some{first.secret};
}

# a `*S` retyped as `*T`: the target is shared storage, so the bytes both cover
# keep their class exactly, a narrowing is accepted, and a widening only when `S`
# and `T` are one and the same class throughout
fun retype_allowed(w: *Comparison, from: type.TypeId, to: type.TypeId) bool {
    val ef: extent.Extent = extent.size(w.mz, type.strip_secret(w.mz.q.types, from));
    val et: extent.Extent = extent.size(w.mz, type.strip_secret(w.mz.q.types, to));
    if (!ef.ok || !et.ok) { ret false; }

    var common: u32 = ef.size;
    if (et.size < common)                                { common = et.size; }
    if (!agree_below(w, from, to, common, false, false)) { ret false; }
    if (et.size <= ef.size)                              { ret true; }

    val cf: opt[bool] = single_class(w, from, ef.size);
    val ct: opt[bool] = single_class(w, to, et.size);
    if (!sel cf.some) { ret false; }
    if (!sel ct.some) { ret false; }
    ret cf.some == ct.some;
}

fun is_data_leaf(mz: *extent.Measure, tid: type.TypeId) bool {
    val n: extent.Node = extent.describe(mz, type.strip_secret(mz.q.types, tid)::u32);
    ret n.kind == extent.NODE_SCALAR || n.kind == extent.NODE_VECTOR;
}

fun cast_walk(mz: *extent.Measure, from: type.TypeId, to: type.TypeId) Verdict {
    if (!deep.secret(mz.q, from) && !deep.secret(mz.q, to)) { ret Verdict{agreement: AGREE, owner: type.TYPE_NIL, field: NO_FIELD}; }

    var scan:   type.PairScan;
    val opened: err[fail.Fail] = type.pair_scan_begin(mz.q.types, ?scan);
    if (sel opened.err) {
        type_query.failed(mz.q, opened.err);
        ret Verdict{agreement: DISAGREE, owner: type.TYPE_NIL, field: NO_FIELD};
    }
    var w: Comparison = comparison(mz, ?scan);

    val sf:      type.TypeId     = type.strip_secret(mz.q.types, from);
    val st:      type.TypeId     = type.strip_secret(mz.q.types, to);
    val of:      opt[*type.Type] = type.get(mz.q.types, sf);
    val ot:      opt[*type.Type] = type.get(mz.q.types, st);
    var allowed: bool            = false;
    if (sel of.some) {
        if (sel ot.some) {
            val same: bool = class_agrees(type.is_secret(mz.q.types, from), type.is_secret(mz.q.types, to), true);
            if (of.some.kind == type.TYPE_POINTER && ot.some.kind == type.TYPE_POINTER) {
                allowed = same && retype_allowed(?w, of.some.data.pointer.base, ot.some.data.pointer.base);
            }
            or (is_data_leaf(mz, from) && is_data_leaf(mz, to)) {
                allowed = same;
            }
            or {
                allowed = overlay_agrees_walk(?w, from, to, true);
            }
        }
    }
    val out: Verdict = verdict(?w, allowed);
    comparison_end(?w);
    type.pair_scan_end(mz.q.types, ?scan);
    ret out;
}

fun overlay_agrees_walk(w: *Comparison, a: type.TypeId, b: type.TypeId, add: bool) bool {
    val ea: extent.Extent = extent.size(w.mz, type.strip_secret(w.mz.q.types, a));
    val eb: extent.Extent = extent.size(w.mz, type.strip_secret(w.mz.q.types, b));
    if (!ea.ok || !eb.ok) { ret false; }
    var common: u32 = ea.size;
    if (eb.size < common) { common = eb.size; }
    ret agree_below(w, a, b, common, add, false);
}

# two types laid over one storage from offset 0, as union variants are: every
# byte both cover has one class on both sides
fun overlay_walk(mz: *extent.Measure, a: type.TypeId, b: type.TypeId) Verdict {
    if (!deep.secret(mz.q, a) && !deep.secret(mz.q, b)) { ret Verdict{agreement: AGREE, owner: type.TYPE_NIL, field: NO_FIELD}; }

    var scan:   type.PairScan;
    val opened: err[fail.Fail] = type.pair_scan_begin(mz.q.types, ?scan);
    if (sel opened.err) {
        type_query.failed(mz.q, opened.err);
        ret Verdict{agreement: DISAGREE, owner: type.TYPE_NIL, field: NO_FIELD};
    }
    var w:     Comparison = comparison(mz, ?scan);
    val agree: bool       = overlay_agrees_walk(?w, a, b, false);
    val out:   Verdict    = verdict(?w, agree);
    comparison_end(?w);
    type.pair_scan_end(mz.q.types, ?scan);
    ret out;
}

pub val UNBOUNDED_VARIANTS_MSG: str = "union variants: cannot prove that overlapping fields agree on secrecy";
pub val UNBOUNDED_CAST_MSG:     str = "cannot prove that the two types agree on secrecy";

# whether a `::` or `:~` from `from` to `to` keeps every byte's secrecy class or only makes public bytes secret in a value
pub fun cast_allowed(s: *session.Session, laying: *extent.Laying, from: type.TypeId, to: type.TypeId) res[Verdict, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var q:      type_query.Query = type_query.Query{types: ?s.types, facts: ?s.type_facts, status: ?status};
    var mz:     extent.Measure   = extent.Measure{q: ?q, laying: laying};
    ret type_query.answer[Verdict](?q, cast_walk(?mz, from, to));
}

# whether two union variants overlaying one storage agree on every byte they share
pub fun overlay_agrees(s: *session.Session, laying: *extent.Laying, a: type.TypeId, b: type.TypeId) res[Verdict, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var q:      type_query.Query = type_query.Query{types: ?s.types, facts: ?s.type_facts, status: ?status};
    var mz:     extent.Measure   = extent.Measure{q: ?q, laying: laying};
    ret type_query.answer[Verdict](?q, overlay_walk(?mz, a, b));
}
