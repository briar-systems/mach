# how a tag's cases share bytes on the build's target: a byte of a tag is never public under
# one case and secret under another, so two cases share an area only where they agree on the
# class of every byte both cover, the comparison a union's variants must pass
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A:                  std.allocator;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;

use mach.lang.fail;
use mach.lang.type;
use type_field: mach.lang.type.field;
use type_kind:  mach.lang.type.kind;
use type_query: mach.lang.type.query;
use mach.lang.type.query.deep;
use mach.lang.type.query.extent;
use mach.lang.type.query.secrecy;
use mach.lang.type.query.subst;
use mach.lang.type.shape;

val NONE: u32 = 0xFFFFFFFF;

# where each case of the tag `tid` holds its payload, onto `out` in case order, and the count
# of its areas. cases are taken in declaration order and each joins the first area whose
# every case it agrees with, or opens a new one; the areas follow the discriminator in
# ascending order of alignment, ties in the order they were opened
pub fun place(mz: *extent.Measure, tid: type_kind.TypeId, out: *Vector[shape.Carried]) res[u32, fail.Fail] {
    val opt_tag: opt[*type.Type] = type.get(mz.q.types, tid);
    if (sel opt_tag.some) {
        if (opt_tag.some.kind == type_kind.TYPE_INSTANCE) { subst.ensure(mz.q, tid); }
    }
    val n: u32 = type.field_count(mz.q.types, tid);

    # the area each case opened or joined, in the order areas were opened; NONE for no payload
    var opened: Vector[u32] = collections_vector.init[u32](mz.q.types.a);
    fin { val err_opened: err[A.Error] = collections_vector.dnit[u32](?opened); }
    var payloads: u32 = 0;
    var i:        u32 = 0;
    for (i < n) {
        val res_pushed: res[usize, A.Error] = collections_vector.push[u32](?opened, NONE);
        if (sel res_pushed.err)                     { ret res[u32, fail.Fail].err{fail.refused(res_pushed.err)}; }
        if (!type_kind.is_nil(payload(mz, tid, i))) { payloads = payloads + 1; }
        i = i + 1;
    }

    # with no secret anywhere below it, every pair agrees and one area holds every payload
    val apart: bool = payloads > 1 && deep.secret(mz.q, tid);
    var areas: u32  = 0;
    i = 0;
    for (i < n) {
        val ty: type_kind.TypeId = payload(mz, tid, i);
        if (!type_kind.is_nil(ty)) {
            var joined: u32 = NONE;
            if (!apart && areas > 0) { joined = 0; }
            var k: u32 = 0;
            for (apart && joined == NONE && k < areas) {
                val res_agree: res[bool, fail.Fail] = agrees_with_area(mz, tid, ty, ?opened, i, k);
                if (sel res_agree.err) { ret res[u32, fail.Fail].err{res_agree.err}; }
                if (res_agree.ok)      { joined = k; }
                k = k + 1;
            }
            if (joined == NONE) {
                joined = areas;
                areas  = areas + 1;
            }
            opened.data[i] = joined;
        }
        i = i + 1;
    }

    # each area's rank among the areas laid out by ascending alignment
    var rank: Vector[u32] = collections_vector.init[u32](mz.q.types.a);
    fin { val err_rank: err[A.Error] = collections_vector.dnit[u32](?rank); }
    var align: Vector[u32] = collections_vector.init[u32](mz.q.types.a);
    fin { val err_align: err[A.Error] = collections_vector.dnit[u32](?align); }
    var k: u32 = 0;
    for (areas > 1 && k < areas) {
        val res_align: res[u32, fail.Fail] = area_align(mz, tid, ?opened, k);
        if (sel res_align.err) { ret res[u32, fail.Fail].err{res_align.err}; }
        val res_align_pushed: res[usize, A.Error] = collections_vector.push[u32](?align, res_align.ok);
        if (sel res_align_pushed.err) { ret res[u32, fail.Fail].err{fail.refused(res_align_pushed.err)}; }
        k = k + 1;
    }
    k = 0;
    for (k < areas) {
        var before: u32 = 0;
        var j:      u32 = 0;
        for (areas > 1 && j < areas) {
            if (align.data[j] < align.data[k] || (align.data[j] == align.data[k] && j < k)) { before = before + 1; }
            j = j + 1;
        }
        val res_rank_pushed: res[usize, A.Error] = collections_vector.push[u32](?rank, before);
        if (sel res_rank_pushed.err) { ret res[u32, fail.Fail].err{fail.refused(res_rank_pushed.err)}; }
        k = k + 1;
    }

    i = 0;
    for (i < n) {
        var held: shape.Carried = shape.Carried{area: shape.NO_AREA, member: 0};
        val at:   u32           = opened.data[i];
        if (at != NONE) {
            var member: u32 = 0;
            var c:      u32 = 0;
            for (c < i) {
                if (opened.data[c] == at) { member = member + 1; }
                c = c + 1;
            }
            held = shape.Carried{area: shape.TAG_AREA + rank.data[at], member: member};
        }
        val res_out: res[usize, A.Error] = collections_vector.push[shape.Carried](out, held);
        if (sel res_out.err) { ret res[u32, fail.Fail].err{fail.refused(res_out.err)}; }
        i = i + 1;
    }
    ret res[u32, fail.Fail].ok{areas};
}

# the payload type of case `i`, nil for a case with none
fun payload(mz: *extent.Measure, tid: type_kind.TypeId, i: u32) type_kind.TypeId {
    val opt_case: opt[*type_field.Entry] = type.field_at(mz.q.types, tid, i);
    if (sel opt_case.none) { ret type_kind.TYPE_NIL; }
    ret opt_case.some.ty;
}

# whether the payload `ty` of case `i` agrees with every case before it in area `k`. a pair
# whose agreement cannot be decided does not agree
fun agrees_with_area(mz: *extent.Measure, tid: type_kind.TypeId, ty: type_kind.TypeId, opened: *Vector[u32], i: u32, k: u32) res[bool, fail.Fail] {
    var c: u32 = 0;
    for (c < i) {
        if (opened.data[c] == k) {
            val v:       secrecy.Verdict = secrecy.overlay_walk(mz, payload(mz, tid, c), ty);
            val err_now: err[fail.Fail]  = type_query.settled(mz.q);
            if (sel err_now.err)              { ret res[bool, fail.Fail].err{err_now.err}; }
            if (v.agreement != secrecy.AGREE) { ret res[bool, fail.Fail].ok{false}; }
        }
        c = c + 1;
    }
    ret res[bool, fail.Fail].ok{true};
}

# the alignment of area `k`: its payloads' largest, or 1 in a packed tag
fun area_align(mz: *extent.Measure, tid: type_kind.TypeId, opened: *Vector[u32], k: u32) res[u32, fail.Fail] {
    if (type.decoration_of(mz.q.types, tid).packed) { ret res[u32, fail.Fail].ok{1}; }
    var most: u32 = 1;
    var c:    u32 = 0;
    for (c::usize < opened.len) {
        if (opened.data[c] == k) {
            val e: extent.Extent = extent.size(mz, type.strip_secret(mz.q.types, payload(mz, tid, c)));
            if (!e.ok) {
                val err_now: err[fail.Fail] = type_query.settled(mz.q);
                if (sel err_now.err) { ret res[u32, fail.Fail].err{err_now.err}; }
                ret res[u32, fail.Fail].err{fail.message("layout: a tag's payload has no extent on the target")};
            }
            if (e.align > most) { most = e.align; }
        }
        c = c + 1;
    }
    ret res[u32, fail.Fail].ok{most};
}
