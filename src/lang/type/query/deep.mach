# whether a type reaches a property anywhere, through pointers included, answered over
# the declarations so a generic that grows through a pointer still has a finite answer
use std.allocator.page;
use std.collections.map;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.session;
use mach.lang.type;
use type_query: mach.lang.type.query;
use mach.lang.type.query.mention;

# the kinds that carry no secret of their own; false for every other kind, which a
# walk descends (a partition, enumerated by its test)
pub fun public_leaf(k: type.TypeKind) bool {
    val pc: type.PrimClass = type.prim_desc(k).class;
    if (pc == type.PRIM_CLASS_INT || pc == type.PRIM_CLASS_FLOAT || pc == type.PRIM_CLASS_PTR) { ret true; }
    if (k == type.TYPE_VECTOR)                                                                 { ret true; }
    if (k == type.TYPE_HANDLE)                                                                 { ret true; }
    if (k == type.TYPE_ABI)                                                                    { ret true; }
    if (k == type.TYPE_GENERIC_PARAM)                                                          { ret true; }
    ret false;
}

# whether `tid` reaches a secret
pub fun secret(q: *type_query.Query, tid: type.TypeId) bool {
    ret query_run(q, DEEP_SECRET, tid);
}

# whether `tid` reaches a floating-point value, a lane of a vector included
pub fun float(q: *type_query.Query, tid: type.TypeId) bool {
    ret query_run(q, DEEP_FLOAT, tid);
}

pub fun contains_secret(s: *session.Session, tid: type.TypeId) res[bool, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var q:      type_query.Query = type_query.Query{types: ?s.types, facts: ?s.type_facts, status: ?status};
    ret type_query.answer[bool](?q, secret(?q, tid));
}

pub fun contains_float(s: *session.Session, tid: type.TypeId) res[bool, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var q:      type_query.Query = type_query.Query{types: ?s.types, facts: ?s.type_facts, status: ?status};
    ret type_query.answer[bool](?q, float(?q, tid));
}

# what a deep query looks for anywhere a type reaches, through pointers included
def DeepProp: u8;

val DEEP_SECRET: DeepProp = 0;
val DEEP_FLOAT:  DeepProp = 1;

val DEEP_NONE: u32 = 0xFFFFFFFF;

# one nominal's answer over the declaration graph, never the instance graph: a
# generic reached through a pointer can mint a fresh instance at every level
# (`rec L[T] { next: *L[*T]; }`), so the instances are unbounded but the
# declarations are not. `found` is the property reached by the fields on their
# own, and `reach` lists the owner's parameters the fields reach, so an instance
# answers `found`, or any reached parameter's argument answering
rec DeepEntry {
    nominal: type.TypeId;
    found:   bool;
    owned:   bool;
    owner:   type.GenericOwner;
    reach:   u32;
}

rec DeepReach {
    param: u32;
    next:  u32;
}

rec DeepQuery {
    q:       *type_query.Query;
    prop:    DeepProp;
    index:   map.Map[type.TypeId, u32];
    entries: Vector[DeepEntry];
    reach:   Vector[DeepReach];
    # a pass changed an answer or met a new nominal, so another pass is owed
    grew: bool;
}

# the summaries are a least fixpoint: every answer starts false and only turns
# true, so passes repeat until one changes nothing, and the root's answer from
# that pass is final
fun query_run(q: *type_query.Query, prop: DeepProp, tid: type.TypeId) bool {
    var dq: DeepQuery;
    dq.q       = q;
    dq.prop    = prop;
    dq.index   = map.init[type.TypeId, u32](q.types.a);
    dq.entries = collections_vector.init[DeepEntry](q.types.a);
    dq.reach   = collections_vector.init[DeepReach](q.types.a);
    dq.grew    = false;

    var found: bool                = true;
    val room:  res[usize, A.Error] = collections_vector.reserve[DeepEntry](?dq.entries, 8);
    if (sel room.err) { type_query.refused(q, room.err); }
    or {
        for (true) {
            dq.grew = false;
            if (deep_eval(?dq, tid, DEEP_NONE)) { brk; }
            var i: usize = 0;
            for (i < dq.entries.len) {
                deep_settle(?dq, i::u32);
                i = i + 1;
            }
            if (sel q.status.kind.internal) { brk; }
            if (!dq.grew) {
                found = false;
                brk;
            }
        }
    }

    map.dnit[type.TypeId, u32](?dq.index);
    collections_vector.dnit[DeepEntry](?dq.entries);
    collections_vector.dnit[DeepReach](?dq.reach);
    ret found;
}

# the summary slot of `nominal`, opened on first sight; DEEP_NONE when out of memory
fun deep_entry(dq: *DeepQuery, nominal: type.TypeId) u32 {
    val have: opt[*u32] = map.get[type.TypeId, u32](?dq.index, ?nominal);
    if (sel have.some) { ret @have.some; }

    var e: DeepEntry;
    e.nominal = nominal;
    e.found   = false;
    e.owned   = false;
    e.reach   = DEEP_NONE;
    # a nominal with no field table cannot be shown clear
    val table: opt[*type.FieldTable] = type.field_table_for(dq.q.types, nominal);
    if (!sel table.some) { e.found = true; }
    or {
        val of: opt[type.GenericOwner] = mention.owner(dq.q, nominal);
        if (sel of.some) {
            e.owned = true;
            e.owner = of.some;
        }
    }
    if (sel dq.q.status.kind.internal) { ret DEEP_NONE; }

    val ix:     u32                 = dq.entries.len::u32;
    val pushed: res[usize, A.Error] = collections_vector.push[DeepEntry](?dq.entries, e);
    if (sel pushed.err) {
        type_query.refused(dq.q, pushed.err);
        ret DEEP_NONE;
    }
    val indexed: res[bool, A.Error] = map.insert[type.TypeId, u32](?dq.index, nominal, ix);
    if (sel indexed.err) {
        type_query.refused(dq.q, indexed.err);
        ret DEEP_NONE;
    }
    dq.grew = true;
    ret ix;
}

fun deep_reaches(dq: *DeepQuery, ix: u32, param: u32) bool {
    var r: u32 = dq.entries.data[ix].reach;
    for (r != DEEP_NONE) {
        if (dq.reach.data[r].param == param) { ret true; }
        r = dq.reach.data[r].next;
    }
    ret false;
}

fun deep_add_reach(dq: *DeepQuery, ix: u32, param: u32) {
    if (deep_reaches(dq, ix, param)) { ret; }
    var link: DeepReach;
    link.param = param;
    link.next  = dq.entries.data[ix].reach;
    val at:     u32                 = dq.reach.len::u32;
    val pushed: res[usize, A.Error] = collections_vector.push[DeepReach](?dq.reach, link);
    if (sel pushed.err) {
        type_query.refused(dq.q, pushed.err);
        ret;
    }
    dq.entries.data[ix].reach = at;
    dq.grew                   = true;
}

fun deep_settle(dq: *DeepQuery, ix: u32) {
    if (dq.entries.data[ix].found) { ret; }
    val nominal: type.TypeId           = dq.entries.data[ix].nominal;
    val table:   opt[*type.FieldTable] = type.field_table_for(dq.q.types, nominal);
    if (!sel table.some) { ret; }
    val fields_len: u32 = table.some.fields_len;

    var f: u32 = 0;
    for (f < fields_len) {
        val entry: opt[*type.FieldEntry] = type.field_at(dq.q.types, nominal, f);
        if (sel entry.some && deep_eval(dq, entry.some.ty, ix)) {
            dq.entries.data[ix].found = true;
            dq.grew                   = true;
            ret;
        }
        f = f + 1;
    }
}

# whether `tid` reaches the property under the current summaries; inside the
# fields of entry `ctx`, a parameter of its owner is recorded as reached instead
fun deep_eval(dq: *DeepQuery, tid: type.TypeId, ctx: u32) bool {
    if (type.is_nil(tid) || type.is_error(tid)) { ret false; }
    if (sel dq.q.status.kind.internal)          { ret true; }

    val opt_type: opt[*type.Type] = type.get(dq.q.types, tid);
    if (!sel opt_type.some) {
        fail.internal(dq.q.status, "deep query: the store holds no such type id");
        ret true;
    }
    val t: *type.Type = opt_type.some;

    if (dq.prop == DEEP_SECRET) {
        if (t.kind == type.TYPE_SECRET) { ret true; }
    }
    or {
        if (type.prim_desc(t.kind).class == type.PRIM_CLASS_FLOAT) { ret true; }
        if (t.kind == type.TYPE_SECRET)                            { ret deep_eval(dq, t.data.secret.base, ctx); }
        if (t.kind == type.TYPE_VECTOR)                            { ret type.prim_desc(t.data.vector.element).class == type.PRIM_CLASS_FLOAT; }
    }
    if (t.kind == type.TYPE_POINTER) { ret deep_eval(dq, t.data.pointer.base, ctx); }
    if (t.kind == type.TYPE_ARRAY)   { ret deep_eval(dq, t.data.array.base, ctx); }

    if (t.kind == type.TYPE_FUN) {
        if (deep_eval(dq, t.data.fn.ret_type, ctx)) { ret true; }
        var pi: u32 = 0;
        for (pi < t.data.fn.params_len) {
            val pp: opt[type.TypeId] = type.get_param(dq.q.types, t.data.fn.params_start + pi);
            if (sel pp.some && deep_eval(dq, pp.some, ctx)) { ret true; }
            pi = pi + 1;
        }
        ret false;
    }

    if (t.kind == type.TYPE_GENERIC_PARAM) {
        if (ctx != DEEP_NONE && dq.entries.data[ctx].owned
            && type.param_owned_by(?t.data.generic_param, ?dq.entries.data[ctx].owner)) {
            deep_add_reach(dq, ctx, t.data.generic_param.index);
        }
        ret false;
    }

    if (t.kind == type.TYPE_INSTANCE) {
        val ix: u32 = deep_entry(dq, t.data.instance.nominal);
        if (ix == DEEP_NONE)           { ret true; }
        if (dq.entries.data[ix].found) { ret true; }
        val args_start: u32 = t.data.instance.args_start;
        val args_len:   u32 = t.data.instance.args_len;
        var r:          u32 = dq.entries.data[ix].reach;
        for (r != DEEP_NONE) {
            val param: u32 = dq.reach.data[r].param;
            r = dq.reach.data[r].next;
            if (param < args_len) {
                val arg: opt[type.TypeId] = type.get_param(dq.q.types, args_start + param);
                if (!sel arg.some) {
                    fail.internal(dq.q.status, "deep query: an argument list runs past the store");
                    ret true;
                }
                if (deep_eval(dq, arg.some, ctx)) { ret true; }
            }
        }
        ret false;
    }

    # a bare nominal mentioning parameters is an anonymous aggregate inside a
    # generic: its parameters are the enclosing declaration's, so what it
    # reaches is reached by the fields that hold it, under that same owner
    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_TAG) {
        val ix: u32 = deep_entry(dq, tid);
        if (ix == DEEP_NONE)           { ret true; }
        if (dq.entries.data[ix].found) { ret true; }
        if (ctx != DEEP_NONE && dq.entries.data[ix].owned && dq.entries.data[ctx].owned
            && type.generic_owner_equals(?dq.entries.data[ix].owner, ?dq.entries.data[ctx].owner)) {
            var r: u32 = dq.entries.data[ix].reach;
            for (r != DEEP_NONE) {
                val param: u32 = dq.reach.data[r].param;
                r = dq.reach.data[r].next;
                deep_add_reach(dq, ctx, param);
            }
        }
        ret false;
    }

    if (public_leaf(t.kind)) { ret false; }
    ret true;
}

# a type id the store does not hold is an internal failure, never an answer
test query__unresolvable_type_fails {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val bogus:    type.TypeId          = type.id(500000);
    val secret_r: res[bool, fail.Fail] = contains_secret(?s, bogus);
    if (sel secret_r.ok) { ret 2; }
    val float_r: res[bool, fail.Fail] = contains_float(?s, bogus);
    if (sel float_r.ok) { ret 3; }
    ret 0;
}

test public_leaf__partition_typekind {
    val leaves: [15]type.TypeKind = [15]type.TypeKind{type.TYPE_U8, type.TYPE_U16, type.TYPE_U32, type.TYPE_U64,
        type.TYPE_I8, type.TYPE_I16, type.TYPE_I32, type.TYPE_I64, type.TYPE_F32, type.TYPE_F64, type.TYPE_PTR,
        type.TYPE_VECTOR, type.TYPE_HANDLE, type.TYPE_ABI, type.TYPE_GENERIC_PARAM};
    val descended: [10]type.TypeKind = [10]type.TypeKind{type.TYPE_POINTER, type.TYPE_ARRAY, type.TYPE_FUN,
        type.TYPE_REC, type.TYPE_UNI, type.TYPE_INSTANCE, type.TYPE_PACK, type.TYPE_SECRET, type.TYPE_TAG,
        type.TYPE_CASE_SELECTOR};
    var i: usize = 0;
    for (i < 15) {
        if (!public_leaf(leaves[i])) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < 10) {
        if (public_leaf(descended[i])) { ret 2; }
        i = i + 1;
    }
    ret 0;
}

# whether an array of four `kind` elements contains a float, -1 when it cannot be asked
#[testing]
fun t_array_holds_float(s: *session.Session, kind: type.TypeKind) i32 {
    val elem: opt[type.TypeId] = type.prim(?s.types, kind);
    if (sel elem.none) { ret -1; }
    if (sel elem.some) {
        val arr: res[type.TypeId, fail.Fail] = type.intern_array(?s.types, elem.some, 4);
        if (sel arr.ok) {
            val found: res[bool, fail.Fail] = contains_float(s, arr.ok);
            if (sel found.ok) {
                if (found.ok) { ret 1; }
                ret 0;
            }
        }
    }
    ret -1;
}

# an array of floats contains a float, and one of integers does not
test contains_float__finds_a_float_through_an_array {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    if (t_array_holds_float(?s, type.TYPE_F32) != 1) { ret 2; }
    if (t_array_holds_float(?s, type.TYPE_U32) != 0) { ret 3; }
    ret 0;
}
