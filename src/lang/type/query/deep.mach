# whether a type reaches a property anywhere, through pointers included, answered over
# the declarations so a generic that grows through a pointer still has a finite answer
use std.collections.map;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;

use A: std.allocator;

use mach.lang.fail;
use lang_phase: mach.lang.phase;
use mach.lang.session;
use mach.lang.type;
use type_field: mach.lang.type.field;
use type_kind:  mach.lang.type.kind;
use type_prim:  mach.lang.type.prim;
use type_query: mach.lang.type.query;
use mach.lang.type.query.placement;

# the kinds that carry no secret of their own; false for every other kind, which a
# walk descends (a partition, enumerated by its test)
pub fun public_leaf(k: type_kind.TypeKind) bool {
    val pc: type_prim.PrimClass = type_prim.prim_desc(k).class;
    if (pc == type_prim.PRIM_CLASS_INT || pc == type_prim.PRIM_CLASS_FLOAT || pc == type_prim.PRIM_CLASS_PTR) { ret true; }
    if (k == type_kind.TYPE_VECTOR)                                                                           { ret true; }
    if (k == type_kind.TYPE_HANDLE)                                                                           { ret true; }
    if (k == type_kind.TYPE_ABI)                                                                              { ret true; }
    if (k == type_kind.TYPE_GENERIC_PARAM)                                                                    { ret true; }
    ret false;
}

# whether `tid` reaches a secret
pub fun secret(q: *type_query.Query, tid: type_kind.TypeId) bool {
    ret query_run(q, DEEP_SECRET, tid);
}

# whether `tid` reaches a floating-point value, a lane of a vector included
pub fun float(q: *type_query.Query, tid: type_kind.TypeId) bool {
    ret query_run(q, DEEP_FLOAT, tid);
}

pub fun contains_secret(s: *session.Session, tid: type_kind.TypeId) res[bool, fail.Fail] {
    var status: lang_phase.PhaseStatus = lang_phase.accepted();
    var q:      type_query.Query       = type_query.Query{types: ?s.types, facts: ?s.type_facts, status: ?status};
    ret type_query.answer[bool](?q, secret(?q, tid));
}

pub fun contains_float(s: *session.Session, tid: type_kind.TypeId) res[bool, fail.Fail] {
    var status: lang_phase.PhaseStatus = lang_phase.accepted();
    var q:      type_query.Query       = type_query.Query{types: ?s.types, facts: ?s.type_facts, status: ?status};
    ret type_query.answer[bool](?q, float(?q, tid));
}

# what a deep query looks for anywhere a type reaches, through pointers included
def DeepProp: u8;

val DEEP_SECRET: DeepProp = 0;
val DEEP_FLOAT:  DeepProp = 1;

# one walk over the declaration graph, never the instance graph: a generic reached through
# a pointer can mint a fresh instance at every level (`rec L[T] { next: *L[*T]; }`), so the
# instances are unbounded but the declarations are not. a nominal's own fields are walked
# once with its parameters reaching nothing, and an instance adds the arguments of the
# parameters its generic reaches anywhere, which the placement fixpoint settles. a nominal
# or instance met again adds nothing, so the walk is a plain reachability search
rec DeepQuery {
    q:      *type_query.Query;
    prop:   DeepProp;
    seen:   map.Map[type_kind.TypeId, bool];
    places: placement.Places;
}

fun query_run(q: *type_query.Query, prop: DeepProp, tid: type_kind.TypeId) bool {
    var dq: DeepQuery;
    dq.q      = q;
    dq.prop   = prop;
    dq.seen   = map.init[type_kind.TypeId, bool](q.types.a);
    dq.places = placement.init(q);
    val found: bool = deep_eval(?dq, tid);
    map.dnit[type_kind.TypeId, bool](?dq.seen);
    placement.dnit(?dq.places);
    ret found;
}

# whether the walk meets `tid` for the first time; a mark that cannot be recorded is a
# failure, recorded, and reads as already met
fun first_sight(dq: *DeepQuery, tid: type_kind.TypeId) bool {
    if (map.contains[type_kind.TypeId, bool](?dq.seen, ?tid)) { ret false; }
    val marked: res[bool, A.Error] = map.insert[type_kind.TypeId, bool](?dq.seen, tid, true);
    if (sel marked.err) {
        type_query.refused(dq.q, marked.err);
        ret false;
    }
    ret true;
}

# whether the fields of `nominal` reach the property, its own parameters reaching nothing; a
# nominal with no field table cannot be shown clear
fun fields_reach(dq: *DeepQuery, nominal: type_kind.TypeId) bool {
    val table: opt[*type_field.Table] = type.field_table_for(dq.q.types, nominal);
    if (!sel table.some) { ret true; }
    val fields_len: u32 = table.some.fields_len;
    var f:          u32 = 0;
    for (f < fields_len) {
        val entry: opt[*type_field.Entry] = type.field_at(dq.q.types, nominal, f);
        if (!sel entry.some) {
            lang_phase.internal(dq.q.status, "deep query: a field table runs past its fields");
            ret true;
        }
        if (deep_eval(dq, entry.some.ty)) { ret true; }
        f = f + 1;
    }
    ret false;
}

# whether `tid` reaches the property; a type parameter reaches nothing on its own, its
# argument being walked where an instance supplies it. once the query has failed every
# answer is true, so no walk goes on past the failure
fun deep_eval(dq: *DeepQuery, tid: type_kind.TypeId) bool {
    if (type_kind.is_nil(tid) || type_kind.is_error(tid)) { ret false; }
    if (sel dq.q.status.kind.internal)                    { ret true; }
    if (!type_query.descend(dq.q))                        { ret true; }

    val opt_type: opt[*type.Type] = type.get(dq.q.types, tid);
    if (!sel opt_type.some) {
        lang_phase.internal(dq.q.status, "deep query: the store holds no such type id");
        ret true;
    }
    val t: *type.Type = opt_type.some;

    if (dq.prop == DEEP_SECRET) {
        if (t.kind == type_kind.TYPE_SECRET) { ret true; }
    }
    or {
        if (type_prim.prim_desc(t.kind).class == type_prim.PRIM_CLASS_FLOAT) { ret true; }
        if (t.kind == type_kind.TYPE_SECRET)                                 { ret deep_eval(dq, t.data.secret.base); }
        if (t.kind == type_kind.TYPE_VECTOR)                                 { ret type_prim.prim_desc(t.data.vector.element).class == type_prim.PRIM_CLASS_FLOAT; }
    }
    if (t.kind == type_kind.TYPE_POINTER) { ret deep_eval(dq, t.data.pointer.base); }
    if (t.kind == type_kind.TYPE_ARRAY)   { ret deep_eval(dq, t.data.array.base); }

    if (t.kind == type_kind.TYPE_FUN) {
        if (deep_eval(dq, t.data.fn.ret_type)) { ret true; }
        var pi: u32 = 0;
        for (pi < t.data.fn.params_len) {
            val pp: opt[type_kind.TypeId] = type.get_param(dq.q.types, t.data.fn.params_start + pi);
            if (sel pp.some && deep_eval(dq, pp.some)) { ret true; }
            pi = pi + 1;
        }
        ret false;
    }

    if (t.kind == type_kind.TYPE_GENERIC_PARAM) { ret false; }

    if (t.kind == type_kind.TYPE_INSTANCE) {
        if (!first_sight(dq, tid)) { ret sel dq.q.status.kind.internal; }
        val generic: type_kind.TypeId = t.data.instance.nominal;
        if (first_sight(dq, generic) && fields_reach(dq, generic)) { ret true; }
        if (sel dq.q.status.kind.internal)                         { ret true; }
        # a generic whose places cannot be settled reaches a nominal with no field table,
        # which cannot be shown clear
        if (!placement.settle(?dq.places, generic)) { ret true; }
        val args_start: u32 = t.data.instance.args_start;
        val args_len:   u32 = t.data.instance.args_len;
        var j:          u32 = 0;
        for (j < args_len) {
            if (placement.reached(?dq.places, generic, j)) {
                val arg: opt[type_kind.TypeId] = type.get_param(dq.q.types, args_start + j);
                if (!sel arg.some) {
                    lang_phase.internal(dq.q.status, "deep query: an argument list runs past the store");
                    ret true;
                }
                if (deep_eval(dq, arg.some)) { ret true; }
            }
            j = j + 1;
        }
        ret false;
    }

    # a bare nominal, named or an anonymous aggregate inside a generic, whose parameters
    # are the enclosing declaration's and reach nothing here
    if (t.kind == type_kind.TYPE_REC || t.kind == type_kind.TYPE_UNI || t.kind == type_kind.TYPE_TAG) {
        if (!first_sight(dq, tid)) { ret sel dq.q.status.kind.internal; }
        ret fields_reach(dq, tid);
    }

    if (public_leaf(t.kind)) { ret false; }
    ret true;
}
