# a generic's body under type arguments: substitution, and the field table an instance reads
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.intern;
use lang_phase: mach.lang.phase;
use mach.lang.session;
use mach.lang.type;
use type_field: mach.lang.type.field;
use type_kind:  mach.lang.type.kind;
use type_query: mach.lang.type.query;
use mach.lang.type.query.mention;

# `body_type` with `who`'s parameters replaced by `args`. the walk recurses as deep as the type
# nests, so it asks for stack before it descends, and a type nested deeper refuses the query
# (`type_query.descend`) and reads as the error type
pub fun apply(q: *type_query.Query, body_type: type_kind.TypeId, who: *type.GenericOwner, args: *type_kind.TypeId, arg_count: u32) type_kind.TypeId {
    if (type_kind.is_nil(body_type) || type_kind.is_error(body_type)) { ret body_type; }
    if (!type_query.descend(q))                                       { ret type_kind.TYPE_ERROR; }

    val opt_type: opt[*type.Type] = type.get(q.types, body_type);
    if (!sel opt_type.some) { ret body_type; }
    val t: *type.Type = opt_type.some;

    if (t.kind == type_kind.TYPE_GENERIC_PARAM) {
        if (!type.param_owned_by(?t.data.generic_param, who)) { ret body_type; }
        val index: u32 = t.data.generic_param.index;
        if (index < arg_count) { ret args[index]; }
        ret type_kind.TYPE_ERROR;
    }

    if (t.kind == type_kind.TYPE_POINTER) {
        val original_base: type_kind.TypeId = t.data.pointer.base;
        val base:          type_kind.TypeId = apply(q, original_base, who, args, arg_count);
        if (q.nested)                            { ret type_kind.TYPE_ERROR; }
        if (type_kind.same(base, original_base)) { ret body_type; }
        ret interned(q, type.intern_pointer(q.types, base));
    }

    if (t.kind == type_kind.TYPE_ARRAY) {
        val original_base: type_kind.TypeId = t.data.array.base;
        val count:         u32              = t.data.array.count;
        val base:          type_kind.TypeId = apply(q, original_base, who, args, arg_count);
        if (q.nested)                            { ret type_kind.TYPE_ERROR; }
        if (type_kind.same(base, original_base)) { ret body_type; }
        ret interned(q, type.intern_array(q.types, base, count));
    }

    if (t.kind == type_kind.TYPE_SECRET) {
        val original_base: type_kind.TypeId = t.data.secret.base;
        val base:          type_kind.TypeId = apply(q, original_base, who, args, arg_count);
        if (q.nested)                            { ret type_kind.TYPE_ERROR; }
        if (type_kind.same(base, original_base)) { ret body_type; }
        ret interned(q, type.intern_secret(q.types, base));
    }

    if (t.kind == type_kind.TYPE_FUN)      { ret apply_fun(q, t, who, args, arg_count, body_type); }
    if (t.kind == type_kind.TYPE_INSTANCE) { ret apply_instance(q, t, who, args, arg_count, body_type); }

    # a bare nominal mentioning parameters is an anonymous aggregate declared
    # inside a generic (a named generic is spelled with its arguments or refused):
    # its parameters are the enclosing declaration's, so it is instantiated
    # with `who`'s arguments exactly when `who` is that declaration
    if (t.kind == type_kind.TYPE_REC || t.kind == type_kind.TYPE_UNI || t.kind == type_kind.TYPE_TAG) {
        if (!mention.has_param(q, body_type)) { ret body_type; }
        val of: opt[type.GenericOwner] = mention.owner(q, body_type);
        if (!sel of.some) { ret body_type; }
        var owner: type.GenericOwner = of.some;
        if (!type.generic_owner_equals(?owner, who)) { ret body_type; }
        ret apply_aggregate(q, args, arg_count, body_type);
    }

    if (t.kind == type_kind.TYPE_CASE_SELECTOR) {
        val original_tag: type_kind.TypeId = t.data.case_selector.tag_type;
        val new_tag:      type_kind.TypeId = apply(q, original_tag, who, args, arg_count);
        if (q.nested)                              { ret type_kind.TYPE_ERROR; }
        if (type_kind.same(new_tag, original_tag)) { ret body_type; }
        ret interned(q, type.intern_case_selector(q.types, new_tag, t.data.case_selector.case_name, t.data.case_selector.case_index));
    }
    ret body_type;
}

# builds the field table of instance `tid` for the current projection, once
pub fun ensure(q: *type_query.Query, tid: type_kind.TypeId) {
    val opt_existing: opt[*type_field.Table] = type.field_table_for(q.types, tid);
    if (sel opt_existing.some) { ret; }

    val opt_type: opt[*type.Type] = type.get(q.types, tid);
    if (!sel opt_type.some) { ret; }
    val t: *type.Type = opt_type.some;
    if (t.kind != type_kind.TYPE_INSTANCE) { ret; }

    val gnom: type_kind.TypeId = t.data.instance.nominal;
    if (type_kind.is_error(gnom)) { ret; }

    table_build(q, tid, gnom);
}

fun table_build(q: *type_query.Query, instance: type_kind.TypeId, gnom: type_kind.TypeId) {
    val opt_instance_table: opt[*type_field.Table] = type.field_table_for(q.types, instance);
    if (sel opt_instance_table.some) { ret; }

    val opt_generic_table: opt[*type_field.Table] = type.field_table_for(q.types, gnom);
    if (!sel opt_generic_table.some) { ret; }
    val fields_len: u32 = opt_generic_table.some.fields_len;
    # fields that mention no parameter (an unused one) copy over under no owner
    val who_opt: opt[type.GenericOwner] = mention.owner(q, gnom);
    var who:     type.GenericOwner;
    if (sel who_opt.some) { who = who_opt.some; }

    val opt_instance: opt[*type.Type] = type.get(q.types, instance);
    if (!sel opt_instance.some) { ret; }
    val instance_type: *type.Type = opt_instance.some;
    if (instance_type.kind != type_kind.TYPE_INSTANCE) { ret; }
    val args_start: u32 = instance_type.data.instance.args_start;
    val args_len:   u32 = instance_type.data.instance.args_len;

    var args: *type_kind.TypeId = nil;
    fin {
        if (args != nil) { A.deallocate[type_kind.TypeId](q.types.a, args, args_len::usize); }
    }
    if (args_len > 0) {
        val res_alloc_args: res[*type_kind.TypeId, A.Error] = A.allocate[type_kind.TypeId](q.types.a, args_len::usize);
        if (sel res_alloc_args.err) {
            type_query.refused(q, res_alloc_args.err);
            ret;
        }
        args = res_alloc_args.ok;

        var i: u32 = 0;
        for (i < args_len) {
            val opt_arg: opt[type_kind.TypeId] = type.get_param(q.types, args_start + i);
            if (!sel opt_arg.some) { ret; }
            args[i] = opt_arg.some;
            i       = i + 1;
        }
    }

    if (fields_len == 0) {
        val start_r: res[u32, fail.Fail] = type.field_table_stage(q.types, 0);
        if (sel start_r.err) { type_query.failed(q, start_r.err); }
        or (sel start_r.ok) {
            val published: err[fail.Fail] = type.field_table_publish(q.types, instance, start_r.ok, 0);
            if (sel published.err) { type_query.failed(q, published.err); }
        }
        ret;
    }

    val res_alloc_types: res[*type_kind.TypeId, A.Error] = A.allocate[type_kind.TypeId](q.types.a, fields_len::usize);
    if (sel res_alloc_types.err) {
        type_query.refused(q, res_alloc_types.err);
        ret;
    }
    val field_types: *type_kind.TypeId = res_alloc_types.ok;
    fin { A.deallocate[type_kind.TypeId](q.types.a, field_types, fields_len::usize); }

    val res_alloc_names: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](q.types.a, fields_len::usize);
    if (sel res_alloc_names.err) {
        type_query.refused(q, res_alloc_names.err);
        ret;
    }
    val field_names: *intern.StrId = res_alloc_names.ok;
    fin { A.deallocate[intern.StrId](q.types.a, field_names, fields_len::usize); }

    var i: u32 = 0;
    for (i < fields_len) {
        val opt_entry: opt[*type_field.Entry] = type.field_at(q.types, gnom, i);
        if (!sel opt_entry.some) {
            field_names[i] = intern.STR_NIL;
            field_types[i] = type_kind.TYPE_ERROR;
        }
        or (sel opt_entry.some) {
            val entry: *type_field.Entry = opt_entry.some;
            field_names[i] = entry.name;
            field_types[i] = apply(q, entry.ty, ?who, args, args_len);
        }
        i = i + 1;
    }

    val start_r: res[u32, fail.Fail] = type.field_table_stage(q.types, fields_len);
    if (sel start_r.err) { type_query.failed(q, start_r.err); }
    or (sel start_r.ok) {
        if (!sel q.status.kind.internal && !q.nested) {
            val start:  u32  = start_r.ok;
            var staged: bool = true;
            i = 0;
            for (i < fields_len) {
                val pushed: err[fail.Fail] = type.field_table_stage_push(q.types, field_names[i], field_types[i]);
                if (sel pushed.err) {
                    type_query.failed(q, pushed.err);
                    staged = false;
                    brk;
                }
                i = i + 1;
            }
            if (staged) {
                val published: err[fail.Fail] = type.field_table_publish(q.types, instance, start, fields_len);
                if (sel published.err) { type_query.failed(q, published.err); }
            }
        }
    }
}

fun apply_fun(q: *type_query.Query, t: *type.Type, who: *type.GenericOwner, args: *type_kind.TypeId, arg_count: u32, original: type_kind.TypeId) type_kind.TypeId {
    val original_ret: type_kind.TypeId = t.data.fn.ret_type;
    val params_start: u32              = t.data.fn.params_start;
    val params_len:   u32              = t.data.fn.params_len;

    var changed:   bool              = false;
    var param_buf: *type_kind.TypeId = nil;
    fin { A.deallocate[type_kind.TypeId](q.types.a, param_buf, params_len::usize); }
    if (params_len > 0) {
        val res_alloc_params: res[*type_kind.TypeId, A.Error] = A.allocate[type_kind.TypeId](q.types.a, params_len::usize);
        if (sel res_alloc_params.err) {
            type_query.refused(q, res_alloc_params.err);
            ret type_kind.TYPE_ERROR;
        }
        param_buf = res_alloc_params.ok;

        var i: u32 = 0;
        for (i < params_len) {
            val opt_param: opt[type_kind.TypeId] = type.get_param(q.types, params_start + i);
            if (!sel opt_param.some) { ret type_kind.TYPE_ERROR; }
            val original_param: type_kind.TypeId = opt_param.some;
            param_buf[i] = apply(q, original_param, who, args, arg_count);
            if (!type_kind.same(param_buf[i], original_param)) { changed = true; }
            i = i + 1;
        }
    }

    val new_ret: type_kind.TypeId = apply(q, original_ret, who, args, arg_count);
    if (!type_kind.same(new_ret, original_ret)) { changed = true; }

    if (q.nested) { ret type_kind.TYPE_ERROR; }
    if (!changed) { ret original; }

    val res_fun: res[type_kind.TypeId, fail.Fail] = type.intern_function(q.types, new_ret, param_buf, params_len, t.data.fn.c_variadic);
    ret interned(q, res_fun);
}

fun apply_instance(q: *type_query.Query, t: *type.Type, who: *type.GenericOwner, args: *type_kind.TypeId, arg_count: u32, original: type_kind.TypeId) type_kind.TypeId {
    val nominal:    type_kind.TypeId = t.data.instance.nominal;
    val args_start: u32              = t.data.instance.args_start;
    val args_len:   u32              = t.data.instance.args_len;

    if (args_len == 0) { ret original; }

    val res_alloc_args: res[*type_kind.TypeId, A.Error] = A.allocate[type_kind.TypeId](q.types.a, args_len::usize);
    if (sel res_alloc_args.err) {
        type_query.refused(q, res_alloc_args.err);
        ret type_kind.TYPE_ERROR;
    }
    val arg_buf: *type_kind.TypeId = res_alloc_args.ok;
    fin { A.deallocate[type_kind.TypeId](q.types.a, arg_buf, args_len::usize); }

    var changed: bool = false;
    var i:       u32  = 0;
    for (i < args_len) {
        val opt_arg: opt[type_kind.TypeId] = type.get_param(q.types, args_start + i);
        if (!sel opt_arg.some) { ret type_kind.TYPE_ERROR; }
        val original_arg: type_kind.TypeId = opt_arg.some;
        arg_buf[i] = apply(q, original_arg, who, args, arg_count);
        if (!type_kind.same(arg_buf[i], original_arg)) { changed = true; }
        i = i + 1;
    }

    if (q.nested) { ret type_kind.TYPE_ERROR; }
    if (!changed) { ret original; }

    val res_instance: res[type_kind.TypeId, fail.Fail] = type.intern_instance(q.types, nominal, arg_buf, args_len);
    ret interned(q, res_instance);
}

fun apply_aggregate(q: *type_query.Query, args: *type_kind.TypeId, arg_count: u32, original: type_kind.TypeId) type_kind.TypeId {
    val res_instance: res[type_kind.TypeId, fail.Fail] = type.intern_instance(q.types, original, args, arg_count);
    if (sel res_instance.err) {
        type_query.failed(q, res_instance.err);
        ret type_kind.TYPE_ERROR;
    }
    val instance: type_kind.TypeId = res_instance.ok;

    table_build(q, instance, original);
    ret instance;
}

fun interned(q: *type_query.Query, outcome: res[type_kind.TypeId, fail.Fail]) type_kind.TypeId {
    if (sel outcome.err) {
        type_query.failed(q, outcome.err);
        ret type_kind.TYPE_ERROR;
    }
    ret outcome.ok;
}

# `tid` under `who`'s arguments, or itself when there are none
pub fun apply_or_self(q: *type_query.Query, tid: type_kind.TypeId, who: *type.GenericOwner, args: *type_kind.TypeId, arg_len: u32) type_kind.TypeId {
    if (args == nil || arg_len == 0) { ret tid; }
    ret apply(q, tid, who, args, arg_len);
}

# replace `who`'s parameters in `body_type` with `args`, position for position;
# a parameter of any other declaration (an enclosing generic's, in an open
# instance) stays, so a substituted type reads as the identity under a second pass
pub fun substitute(s: *session.Session, body_type: type_kind.TypeId, who: *type.GenericOwner, args: *type_kind.TypeId, arg_count: u32) res[type_kind.TypeId, fail.Fail] {
    var status: lang_phase.PhaseStatus = lang_phase.accepted();
    var q:      type_query.Query       = type_query.Query{types: ?s.types, facts: ?s.type_facts, status: ?status};
    ret type_query.answer[type_kind.TypeId](?q, apply(?q, body_type, who, args, arg_count));
}

pub fun ensure_fields(s: *session.Session, tid: type_kind.TypeId) err[fail.Fail] {
    var status: lang_phase.PhaseStatus = lang_phase.accepted();
    var q:      type_query.Query       = type_query.Query{types: ?s.types, facts: ?s.type_facts, status: ?status};
    ensure(?q, tid);
    ret type_query.settled(?q);
}
