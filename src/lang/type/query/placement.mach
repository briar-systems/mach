# where each parameter of a generic sits in the storage its instances lay out, answered
# over the declarations so a generic that grows through a pointer still has a finite answer
#
# a parameter is laid when its argument's bytes sit inside an aggregate beside other
# storage, so its size and alignment shape the layout, and it is a pointee when its
# argument is the whole target of a pointer, through arrays only. either may sit under `^`.
# a parameter that only flows into parameters that sit nowhere reaches no byte at all, so
# two instances that differ only there lay out and classify the same storage. the places
# are a least fixpoint over the declaration graph: every set starts empty and only grows,
# so passes repeat until one adds nothing. beside its places, a parameter is reached when its
# argument appears anywhere an instance's fields lead, an empty array's element included,
# which is what a question about what a type contains reads
use std.collections.map;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use lang_phase: mach.lang.phase;
use mach.lang.type;
use type_field: mach.lang.type.field;
use type_kind:  mach.lang.type.kind;
use type_query: mach.lang.type.query;
use mach.lang.type.query.mention;

# one bit of a parameter's places
pub def Place: u8;

pub val LAID:           Place = 1;
pub val LAID_SECRET:    Place = 2;
pub val POINTEE:        Place = 4;
val     POINTEE_SECRET: Place = 8;

pub val PLACE_COUNT: u32 = 4;
val     NO_FIELD:    u32 = 0xFFFFFFFF;

val NO_ENTRY: u32 = 0xFFFFFFFF;

# the bit index of one place, for the field each was first found through
fun slot(p: Place) u32 {
    if (p == LAID)        { ret 0; }
    if (p == LAID_SECRET) { ret 1; }
    if (p == POINTEE)     { ret 2; }
    ret 3;
}

pub fun place_at(i: u32) Place {
    ret (1::u8 << i::u8)::Place;
}

fun secret_of(p: Place) Place {
    if (p == LAID)    { ret LAID_SECRET; }
    if (p == POINTEE) { ret POINTEE_SECRET; }
    ret p;
}

# the place of an argument that sits at place `inner` of a generic held at place `outer`: a
# pointer inside the generic starts afresh, and laid inside it stays laid, secret when
# either side is
fun compose(outer: Place, inner: Place) Place {
    if (inner == POINTEE || inner == POINTEE_SECRET)                             { ret inner; }
    if (inner == LAID_SECRET || outer == LAID_SECRET || outer == POINTEE_SECRET) { ret LAID_SECRET; }
    ret LAID;
}

rec Entry {
    nominal: type_kind.TypeId;
    owner:   type.GenericOwner;
    owned:   bool;
    first:   u32;
}

# one parameter's places, linked from its entry
rec Param {
    index:   u32;
    bits:    u8;
    reached: bool;
    via:     [4]u32;
    next:    u32;
}

pub rec Places {
    q:       *type_query.Query;
    index:   map.Map[type_kind.TypeId, u32];
    entries: Vector[Entry];
    params:  Vector[Param];
    # a generic met had no field table, so no answer is final
    incomplete: bool;
    grew:       bool;
}

pub fun init(q: *type_query.Query) Places {
    var p: Places;
    p.q          = q;
    p.index      = map.init[type_kind.TypeId, u32](q.types.a);
    p.entries    = collections_vector.init[Entry](q.types.a);
    p.params     = collections_vector.init[Param](q.types.a);
    p.incomplete = false;
    p.grew       = false;
    ret p;
}

pub fun dnit(p: *Places) {
    map.dnit[type_kind.TypeId, u32](?p.index);
    collections_vector.dnit[Entry](?p.entries);
    collections_vector.dnit[Param](?p.params);
}

# settles the places of `generic` and every generic it reaches; false when they cannot be
# known, because a generic it reaches has no fields yet or the walk failed
pub fun settle(p: *Places, generic: type_kind.TypeId) bool {
    if (entry_of(p, generic) == NO_ENTRY) { ret false; }
    for (p.grew) {
        p.grew = false;
        var i: usize = 0;
        for (i < p.entries.len) {
            entry_walk(p, i::u32);
            if (sel p.q.status.kind.internal || p.q.nested) { ret false; }
            i = i + 1;
        }
    }
    ret !p.incomplete;
}

# the places parameter `param` of a settled generic takes
pub fun bits(p: *Places, generic: type_kind.TypeId, param: u32) u8 {
    val at: u32 = param_at(p, generic, param);
    if (at == NO_ENTRY) { ret 0; }
    ret p.params.data[at].bits;
}

# whether parameter `param` of a settled generic is reached, through storage or not
pub fun reached(p: *Places, generic: type_kind.TypeId, param: u32) bool {
    val at: u32 = param_at(p, generic, param);
    if (at == NO_ENTRY) { ret false; }
    ret p.params.data[at].reached;
}

# the field of `generic` through which `param` first took place `place`, which it must take
pub fun via(p: *Places, generic: type_kind.TypeId, param: u32, place: Place) u32 {
    val at: u32 = param_at(p, generic, param);
    if (at == NO_ENTRY || (p.params.data[at].bits & place::u8) == 0) {
        lang_phase.internal(p.q.status, "placement: a field was asked of a place the parameter does not take");
        ret NO_FIELD;
    }
    ret p.params.data[at].via[slot(place)];
}

fun param_at(p: *Places, generic: type_kind.TypeId, param: u32) u32 {
    val have: opt[*u32] = map.get[type_kind.TypeId, u32](?p.index, ?generic);
    if (!sel have.some) { ret NO_ENTRY; }
    var r: u32 = p.entries.data[@have.some].first;
    for (r != NO_ENTRY) {
        if (p.params.data[r].index == param) { ret r; }
        r = p.params.data[r].next;
    }
    ret NO_ENTRY;
}

fun entry_of(p: *Places, nominal: type_kind.TypeId) u32 {
    val have: opt[*u32] = map.get[type_kind.TypeId, u32](?p.index, ?nominal);
    if (sel have.some) { ret @have.some; }

    var e: Entry;
    e.nominal = nominal;
    e.owned   = false;
    e.first   = NO_ENTRY;
    val table: opt[*type_field.Table] = type.field_table_for(p.q.types, nominal);
    if (!sel table.some) { p.incomplete = true; }
    or {
        val of: opt[type.GenericOwner] = mention.owner(p.q, nominal);
        if (sel of.some) {
            e.owned = true;
            e.owner = of.some;
        }
    }
    if (sel p.q.status.kind.internal) { ret NO_ENTRY; }

    val ix:     u32                 = p.entries.len::u32;
    val pushed: res[usize, A.Error] = collections_vector.push[Entry](?p.entries, e);
    if (sel pushed.err) {
        type_query.refused(p.q, pushed.err);
        ret NO_ENTRY;
    }
    val indexed: res[bool, A.Error] = map.insert[type_kind.TypeId, u32](?p.index, nominal, ix);
    if (sel indexed.err) {
        type_query.refused(p.q, indexed.err);
        ret NO_ENTRY;
    }
    p.grew = true;
    ret ix;
}

# the record of parameter `param` of entry `ix`, made on first sight; NO_ENTRY with the
# refusal recorded when it cannot be made
fun param_link(p: *Places, ix: u32, param: u32) u32 {
    val nominal: type_kind.TypeId = p.entries.data[ix].nominal;
    var at:      u32              = param_at(p, nominal, param);
    if (at == NO_ENTRY) {
        var link: Param;
        link.index   = param;
        link.bits    = 0;
        link.reached = false;
        link.next    = p.entries.data[ix].first;
        var k: u32 = 0;
        for (k < PLACE_COUNT) {
            link.via[k] = NO_FIELD;
            k           = k + 1;
        }
        at = p.params.len::u32;
        val pushed: res[usize, A.Error] = collections_vector.push[Param](?p.params, link);
        if (sel pushed.err) {
            type_query.refused(p.q, pushed.err);
            ret NO_ENTRY;
        }
        p.entries.data[ix].first = at;
    }
    ret at;
}

# parameter `param` of entry `ix` is reached
fun reach(p: *Places, ix: u32, param: u32) {
    val at: u32 = param_link(p, ix, param);
    if (at == NO_ENTRY || p.params.data[at].reached) { ret; }
    p.params.data[at].reached = true;
    p.grew                    = true;
}

# parameter `param` of entry `ix` takes `place`, first through `field`, and is reached
fun add(p: *Places, ix: u32, param: u32, place: Place, field: u32) {
    reach(p, ix, param);
    val at: u32 = param_link(p, ix, param);
    if (at == NO_ENTRY)                            { ret; }
    if ((p.params.data[at].bits & place::u8) != 0) { ret; }
    p.params.data[at].bits             = p.params.data[at].bits | place::u8;
    p.params.data[at].via[slot(place)] = field;
    p.grew                             = true;
}

fun entry_walk(p: *Places, ix: u32) {
    if (!p.entries.data[ix].owned) { ret; }
    val nominal: type_kind.TypeId       = p.entries.data[ix].nominal;
    val table:   opt[*type_field.Table] = type.field_table_for(p.q.types, nominal);
    if (!sel table.some) { ret; }
    val fields_len: u32 = table.some.fields_len;
    var f:          u32 = 0;
    for (f < fields_len) {
        val entry: opt[*type_field.Entry] = type.field_at(p.q.types, nominal, f);
        if (!sel entry.some) {
            lang_phase.internal(p.q.status, "placement: a field table runs past its fields");
            ret;
        }
        walk(p, ix, entry.some.ty, LAID, true, f);
        f = f + 1;
    }
}

# records where the parameters of entry `ix` that `tid` mentions sit, `tid` itself sitting
# at `place` inside field `field` of the entry; under an empty array, `stored` false, they
# are only reached
fun walk(p: *Places, ix: u32, tid: type_kind.TypeId, place: Place, stored: bool, field: u32) {
    if (type_kind.is_nil(tid) || type_kind.is_error(tid)) { ret; }
    if (!type_query.descend(p.q))                         { ret; }
    val opt_type: opt[*type.Type] = type.get(p.q.types, tid);
    if (!sel opt_type.some) {
        lang_phase.internal(p.q.status, "placement: the store holds no such type id");
        ret;
    }
    val t: *type.Type = opt_type.some;

    if (t.kind == type_kind.TYPE_SECRET) {
        walk(p, ix, t.data.secret.base, secret_of(place), stored, field);
        ret;
    }
    if (t.kind == type_kind.TYPE_ARRAY) {
        # an empty array holds no copy of its element, which it still reaches
        walk(p, ix, t.data.array.base, place, stored && t.data.array.count != 0, field);
        ret;
    }
    if (t.kind == type_kind.TYPE_POINTER) {
        walk(p, ix, t.data.pointer.base, POINTEE, stored, field);
        ret;
    }
    if (t.kind == type_kind.TYPE_FUN) {
        walk(p, ix, t.data.fn.ret_type, POINTEE, stored, field);
        var pi: u32 = 0;
        for (pi < t.data.fn.params_len) {
            val pp: opt[type_kind.TypeId] = type.get_param(p.q.types, t.data.fn.params_start + pi);
            if (!sel pp.some) {
                lang_phase.internal(p.q.status, "placement: a parameter list runs past the store");
                ret;
            }
            walk(p, ix, pp.some, POINTEE, stored, field);
            pi = pi + 1;
        }
        ret;
    }
    if (t.kind == type_kind.TYPE_GENERIC_PARAM) {
        if (type.param_owned_by(?t.data.generic_param, ?p.entries.data[ix].owner)) {
            if (stored) { add(p, ix, t.data.generic_param.index, place, field); }
            or          { reach(p, ix, t.data.generic_param.index); }
        }
        ret;
    }
    if (t.kind == type_kind.TYPE_INSTANCE) {
        val k: u32 = entry_of(p, t.data.instance.nominal);
        if (k == NO_ENTRY) { ret; }
        val target: type_kind.TypeId = t.data.instance.nominal;
        var j:      u32              = 0;
        for (j < t.data.instance.args_len) {
            val arg: opt[type_kind.TypeId] = type.get_param(p.q.types, t.data.instance.args_start + j);
            if (!sel arg.some) {
                lang_phase.internal(p.q.status, "placement: an argument list runs past the store");
                ret;
            }
            val held: u8  = bits(p, target, j);
            var b:    u32 = 0;
            for (b < PLACE_COUNT) {
                val at: Place = place_at(b);
                if ((held & at::u8) != 0) { walk(p, ix, arg.some, compose(place, at), stored, field); }
                b = b + 1;
            }
            if (held == 0 && reached(p, target, j)) { walk(p, ix, arg.some, place, false, field); }
            j = j + 1;
        }
        ret;
    }
    # an anonymous aggregate declared inside the generic holds its parameters as its own fields
    if (t.kind == type_kind.TYPE_REC || t.kind == type_kind.TYPE_UNI || t.kind == type_kind.TYPE_TAG) {
        val of: opt[type.GenericOwner] = mention.owner(p.q, tid);
        if (!sel of.some) { ret; }
        var who: type.GenericOwner = of.some;
        if (!type.generic_owner_equals(?who, ?p.entries.data[ix].owner)) { ret; }
        val inner: Place = compose(place, LAID);
        val n:     u32   = type.field_count(p.q.types, tid);
        var f:     u32   = 0;
        for (f < n) {
            val entry: opt[*type_field.Entry] = type.field_at(p.q.types, tid, f);
            if (!sel entry.some) {
                lang_phase.internal(p.q.status, "placement: a field table runs past its fields");
                ret;
            }
            walk(p, ix, entry.some.ty, inner, stored, field);
            f = f + 1;
        }
    }
}
