# which type parameters a type mentions, and the declaration that owns them
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;

use mach.lang.type;
use type_field: mach.lang.type.field;
use type_kind:  mach.lang.type.kind;
use type_query: mach.lang.type.query;
use type_scan:  mach.lang.type.scan;
use mach.lang.type.visit;

rec Mention {
    q: *type_query.Query;
    # false once a nominal met had no field table, so the answer is not final
    resolved: bool;
    # the declaration owning the first parameter the walk met
    owner: type.GenericOwner;
    owned: bool;
}

fun mention_leaf(m: *Mention, tid: type_kind.TypeId, t: *type.Type) visit.Verdict {
    if (t.kind == type_kind.TYPE_GENERIC_PARAM) {
        if (!m.owned) {
            m.owner = type.param_owner(?t.data.generic_param);
            m.owned = true;
        }
        ret visit.FOUND;
    }
    if (t.kind == type_kind.TYPE_REC || t.kind == type_kind.TYPE_UNI || t.kind == type_kind.TYPE_TAG) {
        val table: opt[*type_field.Table] = type.field_table_for(m.q.types, tid);
        if (!sel table.some) {
            m.resolved = false;
            ret visit.FOUND;
        }
        ret visit.DESCEND;
    }
    if (t.kind == type_kind.TYPE_POINTER || t.kind == type_kind.TYPE_SECRET || t.kind == type_kind.TYPE_ARRAY
        || t.kind == type_kind.TYPE_FUN || t.kind == type_kind.TYPE_INSTANCE) {
        ret visit.DESCEND;
    }
    ret visit.PRUNE;
}

# walks `tid` for a type parameter, through a nominal's fields
fun mention_walk(q: *type_query.Query, tid: type_kind.TypeId, m: *Mention) bool {
    m.q        = q;
    m.resolved = false;
    m.owned    = false;
    var scan: type_scan.Scan;
    if (!type_query.scan_begin(q, ?scan)) { ret true; }
    m.resolved = true;
    var w: visit.Walk[Mention] = visit.Walk[Mention]{types: q.types, status: q.status, scan: ?scan,
        edges: visit.EDGES_SPELLING | visit.EDGE_FIELD, ctx: m, leaf: mention_leaf};
    val found: bool = visit.reaches[Mention](?w, tid);
    type_query.scan_end(q, ?scan);
    ret found;
}

# whether `tid` mentions a type parameter anywhere it is spelled
pub fun mentioned(q: *type_query.Query, tid: type_kind.TypeId) bool {
    var m: Mention;
    ret mention_walk(q, tid, ?m);
}

# the declaration whose parameters a nominal's fields mention: the nominal itself for a
# named generic, the enclosing declaration for an anonymous aggregate declared inside one;
# none when the fields mention no parameter
pub fun owner(q: *type_query.Query, tid: type_kind.TypeId) opt[type.GenericOwner] {
    var m:         Mention;
    val mentioned: bool = mention_walk(q, tid, ?m);
    if (!mentioned || !m.owned || sel q.status.kind.internal) { ret opt[type.GenericOwner].none{}; }
    ret opt[type.GenericOwner].some{m.owner};
}

# whether a nominal's fields mention a type parameter, which a nominal with no field
# table cannot be shown not to
pub fun has_param(q: *type_query.Query, tid: type_kind.TypeId) bool {
    val known: opt[bool] = type_query.mentions_get(q, tid);
    if (sel known.some) { ret known.some; }

    var m:         Mention;
    val mentioned: bool = mention_walk(q, tid, ?m);
    if (m.resolved && !sel q.status.kind.internal) { type_query.mentions_set(q, tid, mentioned); }
    ret mentioned;
}
