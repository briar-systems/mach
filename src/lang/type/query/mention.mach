# which type parameters a type mentions, and the declaration that owns them
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.intern;
use mach.lang.module;
use lang_source: mach.lang.source;
use mach.lang.type;
use type_query: mach.lang.type.query;
use mach.lang.type.visit;

rec Mention {
    q: *type_query.Query;
    # false once a nominal met had no field table, so the answer is not final
    resolved: bool;
    # the declaration owning the first parameter the walk met
    owner: type.GenericOwner;
    owned: bool;
}

fun mention_leaf(m: *Mention, tid: type.TypeId, t: *type.Type) visit.Verdict {
    if (t.kind == type.TYPE_GENERIC_PARAM) {
        if (!m.owned) {
            m.owner = type.param_owner(?t.data.generic_param);
            m.owned = true;
        }
        ret visit.FOUND;
    }
    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_TAG) {
        val table: opt[*type.FieldTable] = type.field_table_for(m.q.types, tid);
        if (!sel table.some) {
            m.resolved = false;
            ret visit.FOUND;
        }
        ret visit.DESCEND;
    }
    if (t.kind == type.TYPE_POINTER || t.kind == type.TYPE_SECRET || t.kind == type.TYPE_ARRAY
        || t.kind == type.TYPE_FUN || t.kind == type.TYPE_INSTANCE) {
        ret visit.DESCEND;
    }
    ret visit.PRUNE;
}

# walks `tid` for a type parameter, through a nominal's fields
fun mention_walk(q: *type_query.Query, tid: type.TypeId, m: *Mention) bool {
    m.q        = q;
    m.resolved = false;
    m.owned    = false;
    var scan: type.TypeScan;
    if (!type_query.scan_begin(q, ?scan)) { ret true; }
    m.resolved = true;
    var w: visit.Walk[Mention] = visit.Walk[Mention]{types: q.types, status: q.status, scan: ?scan,
        edges: visit.EDGES_SPELLING | visit.EDGE_FIELD, ctx: m, leaf: mention_leaf};
    val found: bool = visit.reaches[Mention](?w, tid);
    type_query.scan_end(q, ?scan);
    ret found;
}

# whether `tid` mentions a type parameter anywhere it is spelled
pub fun mentioned(q: *type_query.Query, tid: type.TypeId) bool {
    var m: Mention;
    ret mention_walk(q, tid, ?m);
}

# the declaration whose parameters a nominal's fields mention: the nominal itself for a
# named generic, the enclosing declaration for an anonymous aggregate declared inside one;
# none when the fields mention no parameter
pub fun owner(q: *type_query.Query, tid: type.TypeId) opt[type.GenericOwner] {
    var m:         Mention;
    val mentioned: bool = mention_walk(q, tid, ?m);
    if (!mentioned || !m.owned || sel q.status.kind.internal) { ret opt[type.GenericOwner].none{}; }
    ret opt[type.GenericOwner].some{m.owner};
}

# whether a nominal's fields mention a type parameter, which a nominal with no field
# table cannot be shown not to
pub fun has_param(q: *type_query.Query, tid: type.TypeId) bool {
    val known: opt[bool] = type_query.mentions_get(q, tid);
    if (sel known.some) { ret known.some; }

    var m:         Mention;
    val mentioned: bool = mention_walk(q, tid, ?m);
    if (m.resolved && !sel q.status.kind.internal) { type_query.mentions_set(q, tid, mentioned); }
    ret mentioned;
}

test has_param__missing_field_table_fails_closed {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    var types:  type.TypeInterner;
    val opened: err[fail.Fail] = type.init(?types, ?alloc);
    if (sel opened.err) { ret 1; }
    var facts: type_query.Facts = type_query.facts_init(?alloc);
    fin {
        type_query.facts_dnit(?facts);
        type.dnit(?types);
    }

    val rn: res[type.TypeId, fail.Fail] = type.intern_nominal(?types, intern.STR_NIL, type.TypeOwner{module: module.stable_id(999), file: lang_source.file_id(1)}, type.TYPE_REC);
    if (sel rn.err) { ret 1; }

    var status: fail.PhaseStatus = fail.accepted();
    var q:      type_query.Query = type_query.Query{types: ?types, facts: ?facts, status: ?status};
    if (!has_param(?q, rn.ok))    { ret 2; }
    if (sel status.kind.internal) { ret 3; }
    ret 0;
}
