# the types a logical-addressing target can declare. such a target has no untyped pointer,
# so a pointer is a reference to the type it points at and every type is declared in full.
# a cycle closes only where a pointer member of a record or union points back at a record
# or union on the cycle, which names that record rather than spelling it again, and a
# reference into a generic whose argument grows through a pointer names a fresh type at every
# step, so it has no declaration
use collections_vector: std.collections.vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.type;
use type_query: mach.lang.type.query;
use mach.lang.type.query.expansive;
use mach.lang.type.query.subst;

pub def Refusal: u8;

val REFUSAL_NONE: Refusal = 0;
# a type reaches itself other than through a pointer that names a record on the cycle
pub val REFUSAL_RECURSIVE: Refusal = 1;
# a reference into a generic whose argument grows through a pointer
pub val REFUSAL_UNBOUNDED: Refusal = 2;

pub val RECURSIVE_MSG: str = "recursive reference types require pointer capabilities absent from the Logical Shader environment";
pub val UNBOUNDED_MSG: str = "a reference into a generic whose argument grows through a pointer has unboundedly many types, which the Logical Shader environment cannot declare";

# the types a declaration is being spelled through, innermost first
pub rec Path {
    ty:       type.TypeId;
    previous: *Path;
}

# the record or union a pointer to `ptr`'s base names instead of spelling it, when that
# base lies on a cycle with the record or union `path` is spelling it inside
pub fun pointer_names(q: *type_query.Query, path: *Path, ptr: type.TypeId) opt[type.TypeId] {
    val t: opt[*type.Type] = type.get(q.types, ptr);
    if (sel t.none)                       { ret opt[type.TypeId].none{}; }
    if (t.some.kind != type.TYPE_POINTER) { ret opt[type.TypeId].none{}; }
    val base: type.TypeId     = t.some.data.pointer.base;
    val bt:   opt[*type.Type] = type.get(q.types, base);
    if (sel bt.none) { ret opt[type.TypeId].none{}; }
    val bk: type.TypeKind = bt.some.kind;
    if (bk != type.TYPE_REC && bk != type.TYPE_UNI && bk != type.TYPE_INSTANCE) { ret opt[type.TypeId].none{}; }
    if (type.is_tag(q.types, base))                                             { ret opt[type.TypeId].none{}; }
    var at: *Path = path;
    for (at != nil) {
        if (aggregate_is(q, at.ty)) {
            if (reaches_from(q, base, at.ty)) { ret opt[type.TypeId].some{base}; }
            ret opt[type.TypeId].none{};
        }
        at = at.previous;
    }
    ret opt[type.TypeId].none{};
}

# whether record or union `tid` reaches itself through its members
pub fun on_cycle(q: *type_query.Query, tid: type.TypeId) bool {
    var seen: type.TypeScan;
    if (!type_query.scan_begin(q, ?seen)) { ret false; }
    fin { type_query.scan_end(q, ?seen); }
    if (!type_query.scan_fresh(q, ?seen, tid)) { ret false; }
    var work: collections_vector.Vector[type.TypeId] = collections_vector.init[type.TypeId](q.types.a);
    fin { collections_vector.dnit[type.TypeId](?work); }
    if (!members_push(q, tid, ?work)) { ret false; }
    ret reaches(q, tid, ?seen, ?work);
}

# why a logical-addressing target cannot declare `tid`, REFUSAL_NONE when it can
pub fun refusal(q: *type_query.Query, tid: type.TypeId) Refusal {
    ret refusal_in(q, nil, tid);
}

fun refusal_in(q: *type_query.Query, previous: *Path, tid: type.TypeId) Refusal {
    if (type.is_nil(tid) || type.is_error(tid)) { ret REFUSAL_NONE; }
    val named: opt[type.TypeId] = pointer_names(q, previous, tid);
    if (sel named.some) { ret REFUSAL_NONE; }
    var at: *Path = previous;
    for (at != nil) {
        if (type.same(at.ty, tid)) { ret REFUSAL_RECURSIVE; }
        at = at.previous;
    }
    var path: Path = Path{ty: tid, previous: previous};
    subst.ensure(q, tid);
    val t: opt[*type.Type] = type.get(q.types, tid);
    if (sel t.none) { ret REFUSAL_NONE; }
    val k: type.TypeKind = t.some.kind;
    if (k == type.TYPE_SECRET) { ret refusal_in(q, ?path, t.some.data.secret.base); }
    if (k == type.TYPE_ARRAY)  { ret refusal_in(q, ?path, t.some.data.array.base); }
    if (k == type.TYPE_POINTER) {
        if (expansive.holds(q, t.some.data.pointer.base)) { ret REFUSAL_UNBOUNDED; }
        ret refusal_in(q, ?path, t.some.data.pointer.base);
    }
    if (k == type.TYPE_FUN) {
        val r: Refusal = refusal_in(q, ?path, t.some.data.fn.ret_type);
        if (r != REFUSAL_NONE) { ret r; }
        var i: u32 = 0;
        for (i < t.some.data.fn.params_len) {
            val p: opt[type.TypeId] = type.get_param(q.types, t.some.data.fn.params_start + i);
            if (sel p.some) {
                val pr: Refusal = refusal_in(q, ?path, p.some);
                if (pr != REFUSAL_NONE) { ret pr; }
            }
            i = i + 1;
        }
        ret REFUSAL_NONE;
    }
    if (!aggregate_is(q, tid)) { ret REFUSAL_NONE; }
    var i: u32 = 0;
    for (i < type.field_count(q.types, tid)) {
        val f: opt[*type.FieldEntry] = type.field_at(q.types, tid, i);
        if (sel f.some) {
            val fr: Refusal = refusal_in(q, ?path, f.some.ty);
            if (fr != REFUSAL_NONE) { ret fr; }
        }
        i = i + 1;
    }
    ret REFUSAL_NONE;
}

fun aggregate_is(q: *type_query.Query, tid: type.TypeId) bool {
    val t: opt[*type.Type] = type.get(q.types, tid);
    if (sel t.none) { ret false; }
    val k: type.TypeKind = t.some.kind;
    ret k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_INSTANCE || k == type.TYPE_TAG;
}

fun reaches_from(q: *type_query.Query, from: type.TypeId, target: type.TypeId) bool {
    var seen: type.TypeScan;
    if (!type_query.scan_begin(q, ?seen)) { ret false; }
    fin { type_query.scan_end(q, ?seen); }
    var work: collections_vector.Vector[type.TypeId] = collections_vector.init[type.TypeId](q.types.a);
    fin { collections_vector.dnit[type.TypeId](?work); }
    if (!push(q, ?work, from)) { ret false; }
    ret reaches(q, target, ?seen, ?work);
}

# adds `tid` to `list`; false, with the failure recorded, when the list cannot grow
fun push(q: *type_query.Query, list: *collections_vector.Vector[type.TypeId], tid: type.TypeId) bool {
    val pushed: res[usize, A.Error] = collections_vector.push[type.TypeId](list, tid);
    if (sel pushed.err) {
        type_query.refused(q, pushed.err);
        ret false;
    }
    ret true;
}

# whether a type on `work` is `target` or holds it through a member, an element, a case or a
# pointee. `seen` holds the types the walk has entered, so a cycle is entered once, and `work`
# the types it has yet to visit, so a type nested deeper than any stack is still answered
fun reaches(q: *type_query.Query, target: type.TypeId, seen: *type.TypeScan, work: *collections_vector.Vector[type.TypeId]) bool {
    for {
        val next: opt[type.TypeId] = collections_vector.pop[type.TypeId](work);
        if (sel next.none) { ret false; }
        val from: type.TypeId = next.some;
        if (type.same(from, target)) { ret true; }
        # a tag case without a payload holds no type
        if (type.is_nil(from)) { cnt; }
        if (!type_query.scan_fresh(q, seen, from)) {
            if (sel q.status.kind.internal) { ret false; }
            cnt;
        }
        val t: opt[*type.Type] = type.get(q.types, from);
        if (sel t.none) { cnt; }
        val k:      type.TypeKind = t.some.kind;
        var queued: bool          = true;
        if (k == type.TYPE_POINTER) {
            # each instance a growing generic references is a fresh one, so the walk stops
            # there: such a reference is refused, and closes no cycle
            if (!expansive.holds(q, t.some.data.pointer.base)) { queued = push(q, work, t.some.data.pointer.base); }
        }
        or (k == type.TYPE_ARRAY)  { queued = push(q, work, t.some.data.array.base); }
        or (k == type.TYPE_SECRET) { queued = push(q, work, t.some.data.secret.base); }
        or                         { queued = members_push(q, from, work); }
        if (!queued)               { ret false; }
    }
}

# pushes the members of `from` onto `work` when it is a record, union, instance or tag
fun members_push(q: *type_query.Query, from: type.TypeId, work: *collections_vector.Vector[type.TypeId]) bool {
    if (!aggregate_is(q, from)) { ret true; }
    subst.ensure(q, from);
    var i: u32 = 0;
    for (i < type.field_count(q.types, from)) {
        val f: opt[*type.FieldEntry] = type.field_at(q.types, from, i);
        if (sel f.some) {
            if (!push(q, work, f.some.ty)) { ret false; }
        }
        i = i + 1;
    }
    ret true;
}
