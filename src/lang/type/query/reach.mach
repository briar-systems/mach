# what a type holds or reaches, each property a leaf predicate over the one type walk
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A:                  std.allocator;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;

use mach.lang.fail;
use lang_phase: mach.lang.phase;
use mach.lang.session;
use mach.lang.type;
use type_field: mach.lang.type.field;
use type_kind:  mach.lang.type.kind;
use type_query: mach.lang.type.query;
use mach.lang.type.query.deep;
use mach.lang.type.query.mention;
use mach.lang.type.query.subst;
use type_scan: mach.lang.type.scan;
use mach.lang.type.visit;

fun has_table(q: *type_query.Query, tid: type_kind.TypeId) bool {
    val table: opt[*type_field.Table] = type.field_table_for(q.types, tid);
    ret sel table.some;
}

fun query_walk(q: *type_query.Query, scan: *type_scan.Scan, edges: visit.Edges,
    leaf: fun(*type_query.Query, type_kind.TypeId, *type.Type) visit.Verdict) visit.Walk[type_query.Query] {
    ret visit.Walk[type_query.Query]{types: q.types, status: q.status, scan: scan, once: true, edges: edges, ctx: q, leaf: leaf};
}

# a secret anywhere a type is spelled, through the declaration an instance names; a
# nominal with no field table, or a kind no case covers, cannot be shown clear. a type whose
# answer the store settled is not walked again, and every type entered is kept, so a walk that
# finds no secret settles them all
rec Spelled {
    q:   *type_query.Query;
    met: Vector[type_kind.TypeId];
    # a nominal met had no field table yet, so a secret found is this moment's answer only
    unsettled: bool;
}

fun secret_leaf(sp: *Spelled, tid: type_kind.TypeId, t: *type.Type) visit.Verdict {
    val known: opt[bool] = type.projected_get(sp.q.types, tid, type.PROJECTED_SPELLS_SECRET);
    if (sel known.some) {
        if (known.some) { ret visit.FOUND; }
        ret visit.PRUNE;
    }
    val kept: res[usize, A.Error] = collections_vector.push[type_kind.TypeId](?sp.met, tid);
    if (sel kept.err) {
        type_query.refused(sp.q, kept.err);
        ret visit.FOUND;
    }
    val k: type_kind.TypeKind = t.kind;
    if (k == type_kind.TYPE_SECRET)                                                          { ret visit.FOUND; }
    if (k == type_kind.TYPE_POINTER || k == type_kind.TYPE_ARRAY || k == type_kind.TYPE_FUN) { ret visit.DESCEND; }
    if (k == type_kind.TYPE_INSTANCE) {
        if (type_kind.is_error(t.data.instance.nominal)) { ret visit.FOUND; }
        ret visit.DESCEND;
    }
    if (k == type_kind.TYPE_REC || k == type_kind.TYPE_UNI || k == type_kind.TYPE_TAG) {
        if (!has_table(sp.q, tid)) {
            sp.unsettled = true;
            ret visit.FOUND;
        }
        ret visit.DESCEND;
    }
    if (k == type_kind.TYPE_PACK || deep.public_leaf(k)) { ret visit.PRUNE; }
    ret visit.FOUND;
}

fun module_secret_in(q: *type_query.Query, resolved: *type_kind.TypeId, len: u32) bool {
    if (resolved == nil) { ret false; }
    var scan: type_scan.Scan;
    if (!type_query.scan_begin(q, ?scan)) { ret true; }
    fin { type_query.scan_end(q, ?scan); }
    var sp: Spelled = Spelled{q: q, met: collections_vector.init[type_kind.TypeId](q.types.a), unsettled: false};
    fin { collections_vector.dnit[type_kind.TypeId](?sp.met); }
    var w: visit.Walk[Spelled] = visit.Walk[Spelled]{types: q.types, status: q.status, scan: ?scan, once: true,
        edges: visit.EDGE_ELEMENT | visit.EDGE_POINTEE | visit.EDGE_SIGNATURE | visit.EDGE_ARGUMENT | visit.EDGE_DECLARATION | visit.EDGE_FIELD,
        ctx:   ?sp, leaf: secret_leaf};
    var i: u32 = 0;
    for (i < len) {
        if (visit.reaches[Spelled](?w, resolved[i])) {
            if (!sp.unsettled && !sel q.status.kind.internal) { spelled_set(q, resolved[i], true); }
            ret true;
        }
        i = i + 1;
    }
    if (sel q.status.kind.internal) { ret false; }
    var m: usize = 0;
    for (m < sp.met.len) {
        spelled_set(q, sp.met.data[m], false);
        m = m + 1;
    }
    ret false;
}

fun spelled_set(q: *type_query.Query, tid: type_kind.TypeId, secret: bool) {
    val kept: err[fail.Fail] = type.projected_set(q.types, tid, type.PROJECTED_SPELLS_SECRET, secret);
    if (sel kept.err) { type_query.failed(q, kept.err); }
}

# whether any of a module's `len` resolved types reaches a secret
pub fun module_secret(s: *session.Session, resolved: *type_kind.TypeId, len: u32) res[bool, fail.Fail] {
    var status: lang_phase.PhaseStatus = lang_phase.accepted();
    var q:      type_query.Query       = type_query.Query{types: ?s.types, facts: ?s.type_facts, status: ?status};
    ret type_query.answer[bool](?q, module_secret_in(?q, resolved, len));
}

fun tag_leaf(q: *type_query.Query, tid: type_kind.TypeId, t: *type.Type) visit.Verdict {
    if (type.is_tag(q.types, tid))                                         { ret visit.FOUND; }
    if (t.kind == type_kind.TYPE_SECRET || t.kind == type_kind.TYPE_ARRAY) { ret visit.DESCEND; }
    if (t.kind == type_kind.TYPE_REC || t.kind == type_kind.TYPE_UNI)      { ret visit.DESCEND; }
    if (t.kind == type_kind.TYPE_INSTANCE) {
        subst.ensure(q, tid);
        ret visit.DESCEND;
    }
    ret visit.PRUNE;
}

# whether `tid` holds a tag value in its own storage
pub fun tag_value(s: *session.Session, tid: type_kind.TypeId) res[bool, fail.Fail] {
    var status: lang_phase.PhaseStatus = lang_phase.accepted();
    var q:      type_query.Query       = type_query.Query{types: ?s.types, facts: ?s.type_facts, status: ?status};
    var scan:   type_scan.Scan;
    if (!type_query.scan_begin(?q, ?scan)) { ret type_query.answer[bool](?q, false); }
    fin { type_query.scan_end(?q, ?scan); }
    var w: visit.Walk[type_query.Query] = query_walk(?q, ?scan, visit.EDGES_VALUE, tag_leaf);
    ret type_query.answer[bool](?q, visit.reaches[type_query.Query](?w, tid));
}

fun vector_leaf(q: *type_query.Query, tid: type_kind.TypeId, t: *type.Type) visit.Verdict {
    if (type.is_vector(q.types, tid))                                      { ret visit.FOUND; }
    if (t.kind == type_kind.TYPE_SECRET || t.kind == type_kind.TYPE_ARRAY) { ret visit.DESCEND; }
    if (t.kind == type_kind.TYPE_REC || t.kind == type_kind.TYPE_UNI || t.kind == type_kind.TYPE_TAG || t.kind == type_kind.TYPE_INSTANCE) {
        if (!has_table(q, tid)) { ret visit.PRUNE; }
        ret visit.DESCEND;
    }
    ret visit.PRUNE;
}

# whether `tid` holds a vector in its own storage, with the field tables built so far
pub fun vector(q: *type_query.Query, tid: type_kind.TypeId) bool {
    var scan: type_scan.Scan;
    if (!type_query.scan_begin(q, ?scan)) { ret false; }
    fin { type_query.scan_end(q, ?scan); }
    var w: visit.Walk[type_query.Query] = query_walk(q, ?scan, visit.EDGES_VALUE, vector_leaf);
    ret visit.reaches[type_query.Query](?w, tid);
}

fun union_leaf(q: *type_query.Query, tid: type_kind.TypeId, t: *type.Type) visit.Verdict {
    val k: type_kind.TypeKind = t.kind;
    if (k == type_kind.TYPE_REC || k == type_kind.TYPE_UNI || k == type_kind.TYPE_TAG) {
        if (k == type_kind.TYPE_UNI && mention.has_param(q, tid)) { ret visit.FOUND; }
        if (!has_table(q, tid))                                   { ret visit.FOUND; }
        ret visit.DESCEND;
    }
    if (k == type_kind.TYPE_POINTER || k == type_kind.TYPE_ARRAY || k == type_kind.TYPE_SECRET || k == type_kind.TYPE_FUN
        || k == type_kind.TYPE_INSTANCE) {
        ret visit.DESCEND;
    }
    ret visit.PRUNE;
}

# whether a generic union is reachable from `nominal`, through any member, element,
# pointee, parameter, argument or declaration a mention names
pub fun generic_union(q: *type_query.Query, nominal: type_kind.TypeId) bool {
    var scan: type_scan.Scan;
    if (!type_query.scan_begin(q, ?scan)) { ret true; }
    fin { type_query.scan_end(q, ?scan); }
    var w: visit.Walk[type_query.Query] = query_walk(q, ?scan,
        visit.EDGES_SPELLING | visit.EDGE_DECLARATION | visit.EDGE_FIELD, union_leaf);
    ret visit.reaches[type_query.Query](?w, nominal);
}
