# what a type holds or reaches, each property a leaf predicate over the one type walk
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.session;
use mach.lang.type;
use type_query: mach.lang.type.query;
use mach.lang.type.query.deep;
use mach.lang.type.query.mention;
use mach.lang.type.query.subst;
use mach.lang.type.visit;

fun has_table(q: *type_query.Query, tid: type.TypeId) bool {
    val table: opt[*type.FieldTable] = type.field_table_for(q.types, tid);
    ret sel table.some;
}

fun query_walk(q: *type_query.Query, scan: *type.TypeScan, edges: visit.Edges,
    leaf: fun(*type_query.Query, type.TypeId, *type.Type) visit.Verdict) visit.Walk[type_query.Query] {
    ret visit.Walk[type_query.Query]{types: q.types, status: q.status, scan: scan, edges: edges, ctx: q, leaf: leaf};
}

# a secret anywhere a type is spelled, through the declaration an instance names; a
# nominal with no field table, or a kind no case covers, cannot be shown clear
fun secret_leaf(q: *type_query.Query, tid: type.TypeId, t: *type.Type) visit.Verdict {
    val k: type.TypeKind = t.kind;
    if (k == type.TYPE_SECRET)                                                { ret visit.FOUND; }
    if (k == type.TYPE_POINTER || k == type.TYPE_ARRAY || k == type.TYPE_FUN) { ret visit.DESCEND; }
    if (k == type.TYPE_INSTANCE) {
        if (type.is_error(t.data.instance.nominal)) { ret visit.FOUND; }
        ret visit.DESCEND;
    }
    if (k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_TAG) {
        if (!has_table(q, tid)) { ret visit.FOUND; }
        ret visit.DESCEND;
    }
    if (k == type.TYPE_PACK || deep.public_leaf(k)) { ret visit.PRUNE; }
    ret visit.FOUND;
}

fun module_secret_in(q: *type_query.Query, resolved: *type.TypeId, len: u32) bool {
    if (resolved == nil) { ret false; }
    var scan: type.TypeScan;
    if (!type_query.scan_begin(q, ?scan)) { ret true; }
    fin { type_query.scan_end(q, ?scan); }
    var w: visit.Walk[type_query.Query] = query_walk(q, ?scan,
        visit.EDGE_ELEMENT | visit.EDGE_POINTEE | visit.EDGE_SIGNATURE | visit.EDGE_ARGUMENT
        | visit.EDGE_DECLARATION | visit.EDGE_FIELD, secret_leaf);
    var i: u32 = 0;
    for (i < len) {
        if (visit.reaches[type_query.Query](?w, resolved[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether any of a module's `len` resolved types reaches a secret
pub fun module_secret(s: *session.Session, resolved: *type.TypeId, len: u32) res[bool, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var q:      type_query.Query = type_query.Query{types: ?s.types, facts: ?s.type_facts, status: ?status};
    ret type_query.answer[bool](?q, module_secret_in(?q, resolved, len));
}

fun tag_leaf(q: *type_query.Query, tid: type.TypeId, t: *type.Type) visit.Verdict {
    if (type.is_tag(q.types, tid))                               { ret visit.FOUND; }
    if (t.kind == type.TYPE_SECRET || t.kind == type.TYPE_ARRAY) { ret visit.DESCEND; }
    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI)      { ret visit.DESCEND; }
    if (t.kind == type.TYPE_INSTANCE) {
        subst.ensure(q, tid);
        ret visit.DESCEND;
    }
    ret visit.PRUNE;
}

# whether `tid` holds a tag value in its own storage
pub fun tag_value(s: *session.Session, tid: type.TypeId) res[bool, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var q:      type_query.Query = type_query.Query{types: ?s.types, facts: ?s.type_facts, status: ?status};
    var scan:   type.TypeScan;
    if (!type_query.scan_begin(?q, ?scan)) { ret type_query.answer[bool](?q, false); }
    fin { type_query.scan_end(?q, ?scan); }
    var w: visit.Walk[type_query.Query] = query_walk(?q, ?scan, visit.EDGES_VALUE, tag_leaf);
    ret type_query.answer[bool](?q, visit.reaches[type_query.Query](?w, tid));
}

fun vector_leaf(q: *type_query.Query, tid: type.TypeId, t: *type.Type) visit.Verdict {
    if (type.is_vector(q.types, tid))                            { ret visit.FOUND; }
    if (t.kind == type.TYPE_SECRET || t.kind == type.TYPE_ARRAY) { ret visit.DESCEND; }
    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_TAG || t.kind == type.TYPE_INSTANCE) {
        if (!has_table(q, tid)) { ret visit.PRUNE; }
        ret visit.DESCEND;
    }
    ret visit.PRUNE;
}

# whether `tid` holds a vector in its own storage, with the field tables built so far
pub fun vector(q: *type_query.Query, tid: type.TypeId) bool {
    var scan: type.TypeScan;
    if (!type_query.scan_begin(q, ?scan)) { ret false; }
    fin { type_query.scan_end(q, ?scan); }
    var w: visit.Walk[type_query.Query] = query_walk(q, ?scan, visit.EDGES_VALUE, vector_leaf);
    ret visit.reaches[type_query.Query](?w, tid);
}

fun union_leaf(q: *type_query.Query, tid: type.TypeId, t: *type.Type) visit.Verdict {
    val k: type.TypeKind = t.kind;
    if (k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_TAG) {
        if (k == type.TYPE_UNI && mention.has_param(q, tid)) { ret visit.FOUND; }
        if (!has_table(q, tid))                              { ret visit.FOUND; }
        ret visit.DESCEND;
    }
    if (k == type.TYPE_POINTER || k == type.TYPE_ARRAY || k == type.TYPE_SECRET || k == type.TYPE_FUN
        || k == type.TYPE_INSTANCE) {
        ret visit.DESCEND;
    }
    ret visit.PRUNE;
}

# whether a generic union is reachable from `nominal`, through any member, element,
# pointee, parameter, argument or declaration a mention names
pub fun generic_union(q: *type_query.Query, nominal: type.TypeId) bool {
    var scan: type.TypeScan;
    if (!type_query.scan_begin(q, ?scan)) { ret true; }
    fin { type_query.scan_end(q, ?scan); }
    var w: visit.Walk[type_query.Query] = query_walk(q, ?scan,
        visit.EDGES_SPELLING | visit.EDGE_DECLARATION | visit.EDGE_FIELD, union_leaf);
    ret visit.reaches[type_query.Query](?w, nominal);
}

# a type id the store does not hold is an internal failure, never an answer
test module_secret__unresolvable_type_fails {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var bogus: [1]type.TypeId;
    bogus[0] = type.id(500000);
    val reached: res[bool, fail.Fail] = module_secret(?s, ?bogus[0], 1);
    if (sel reached.ok) { ret 2; }
    ret 0;
}
