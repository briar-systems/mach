use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_region_equals;
use std.types.view.View;
use std.types.view.view_eq_str;

use mach.lang.float;
use mach.lang.type.kind.TYPE_F16;
use mach.lang.type.kind.TYPE_F32;
use mach.lang.type.kind.TYPE_F64;
use mach.lang.type.kind.TYPE_I128;
use mach.lang.type.kind.TYPE_I16;
use mach.lang.type.kind.TYPE_I256;
use mach.lang.type.kind.TYPE_I32;
use mach.lang.type.kind.TYPE_I512;
use mach.lang.type.kind.TYPE_I64;
use mach.lang.type.kind.TYPE_I8;
use mach.lang.type.kind.TYPE_PTR;
use mach.lang.type.kind.TYPE_U1;
use mach.lang.type.kind.TYPE_U128;
use mach.lang.type.kind.TYPE_U16;
use mach.lang.type.kind.TYPE_U256;
use mach.lang.type.kind.TYPE_U32;
use mach.lang.type.kind.TYPE_U512;
use mach.lang.type.kind.TYPE_U64;
use mach.lang.type.kind.TYPE_U8;
use mach.lang.type.kind.TypeKind;
use mach.lang.wide;

pub val PRIM_COUNT: u32 = 19;

pub def PrimClass: u8;

pub val PRIM_CLASS_NONE:  PrimClass = 0;
pub val PRIM_CLASS_INT:   PrimClass = 1;
pub val PRIM_CLASS_FLOAT: PrimClass = 2;
pub val PRIM_CLASS_PTR:   PrimClass = 3;

# bits:  what a value occupies, in memory and as an operand
# width: the bits that hold its value, the width of mirl's row of its layout. only `u1`
#        differs: a byte holding 0 or 1
pub rec PrimDesc {
    class:  PrimClass;
    signed: bool;
    bits:   u32;
    width:  u32;
}

rec PrimSpec {
    kind:     TypeKind;
    spelling: str;
    len:      usize;
    class:    PrimClass;
    signed:   bool;
    bits:     u32;
    width:    u32;
}

val PRIM_CATALOG: [PRIM_COUNT]PrimSpec = [PRIM_COUNT]PrimSpec{
    PrimSpec{kind: TYPE_U8, spelling: "u8", len: 2, class: PRIM_CLASS_INT, signed: false, bits: 8, width: 8},
    PrimSpec{kind: TYPE_U16, spelling: "u16", len: 3, class: PRIM_CLASS_INT, signed: false, bits: 16, width: 16},
    PrimSpec{kind: TYPE_U32, spelling: "u32", len: 3, class: PRIM_CLASS_INT, signed: false, bits: 32, width: 32},
    PrimSpec{kind: TYPE_U64, spelling: "u64", len: 3, class: PRIM_CLASS_INT, signed: false, bits: 64, width: 64},
    PrimSpec{kind: TYPE_I8, spelling: "i8", len: 2, class: PRIM_CLASS_INT, signed: true, bits: 8, width: 8},
    PrimSpec{kind: TYPE_I16, spelling: "i16", len: 3, class: PRIM_CLASS_INT, signed: true, bits: 16, width: 16},
    PrimSpec{kind: TYPE_I32, spelling: "i32", len: 3, class: PRIM_CLASS_INT, signed: true, bits: 32, width: 32},
    PrimSpec{kind: TYPE_I64, spelling: "i64", len: 3, class: PRIM_CLASS_INT, signed: true, bits: 64, width: 64},
    PrimSpec{kind: TYPE_F32, spelling: "f32", len: 3, class: PRIM_CLASS_FLOAT, signed: false, bits: 32, width: 32},
    PrimSpec{kind: TYPE_F64, spelling: "f64", len: 3, class: PRIM_CLASS_FLOAT, signed: false, bits: 64, width: 64},
    PrimSpec{kind: TYPE_PTR, spelling: "ptr", len: 3, class: PRIM_CLASS_PTR, signed: false, bits: 0, width: 0},
    PrimSpec{kind: TYPE_U128, spelling: "u128", len: 4, class: PRIM_CLASS_INT, signed: false, bits: 128, width: 128},
    PrimSpec{kind: TYPE_I128, spelling: "i128", len: 4, class: PRIM_CLASS_INT, signed: true, bits: 128, width: 128},
    PrimSpec{kind: TYPE_F16, spelling: "f16", len: 3, class: PRIM_CLASS_FLOAT, signed: false, bits: 16, width: 16},
    PrimSpec{kind: TYPE_U256, spelling: "u256", len: 4, class: PRIM_CLASS_INT, signed: false, bits: 256, width: 256},
    PrimSpec{kind: TYPE_I256, spelling: "i256", len: 4, class: PRIM_CLASS_INT, signed: true, bits: 256, width: 256},
    PrimSpec{kind: TYPE_U512, spelling: "u512", len: 4, class: PRIM_CLASS_INT, signed: false, bits: 512, width: 512},
    PrimSpec{kind: TYPE_I512, spelling: "i512", len: 4, class: PRIM_CLASS_INT, signed: true, bits: 512, width: 512},
    PrimSpec{kind: TYPE_U1, spelling: "u1", len: 2, class: PRIM_CLASS_INT, signed: false, bits: 8, width: 1},
};

fun prim_spec(kind: TypeKind) *PrimSpec {
    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        if (PRIM_CATALOG[i].kind == kind) { ret ?PRIM_CATALOG[i]; }
        i = i + 1;
    }
    ret nil;
}

# the primitive predicate: a kind is primitive exactly when the catalog names
# it, never because of where it sits in the TypeKind numbering
pub fun is_prim(kind: TypeKind) bool {
    ret prim_spec(kind) != nil;
}

# the catalog position of a primitive kind, the index of every table sized by
# PRIM_COUNT
pub fun prim_index(kind: TypeKind) opt[u32] {
    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        if (PRIM_CATALOG[i].kind == kind) { ret opt[u32].some{i}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# the kind at a catalog position, for walkers over 0..PRIM_COUNT
pub fun prim_kind_at(index: u32) TypeKind {
    ret PRIM_CATALOG[index].kind;
}

pub fun prim_desc(kind: TypeKind) PrimDesc {
    val spec: *PrimSpec = prim_spec(kind);
    var d:    PrimDesc;
    if (spec == nil) {
        d.class  = PRIM_CLASS_NONE;
        d.signed = false;
        d.bits   = 0;
        d.width  = 0;
        ret d;
    }
    d.class  = spec.class;
    d.signed = spec.signed;
    d.bits   = spec.bits;
    d.width  = spec.width;
    ret d;
}

# the vectors the type table seeds, by position below VEC_COUNT
pub val VEC_COUNT: u32 = 10;

pub rec VecShape {
    name:    str;
    element: TypeKind;
    lanes:   u32;
}

pub fun vec_shape(index: u32) VecShape {
    var s: VecShape;
    s.name    = nil;
    s.element = TYPE_U8;
    s.lanes   = 0;

    if (index == 0) {
        s.name    = "f32x4";
        s.element = TYPE_F32;
        s.lanes   = 4;
    }
    or (index == 1) {
        s.name    = "f64x2";
        s.element = TYPE_F64;
        s.lanes   = 2;
    }
    or (index == 2) {
        s.name    = "i8x16";
        s.element = TYPE_I8;
        s.lanes   = 16;
    }
    or (index == 3) {
        s.name    = "i16x8";
        s.element = TYPE_I16;
        s.lanes   = 8;
    }
    or (index == 4) {
        s.name    = "i32x4";
        s.element = TYPE_I32;
        s.lanes   = 4;
    }
    or (index == 5) {
        s.name    = "i64x2";
        s.element = TYPE_I64;
        s.lanes   = 2;
    }
    or (index == 6) {
        s.name    = "u8x16";
        s.element = TYPE_U8;
        s.lanes   = 16;
    }
    or (index == 7) {
        s.name    = "u16x8";
        s.element = TYPE_U16;
        s.lanes   = 8;
    }
    or (index == 8) {
        s.name    = "u32x4";
        s.element = TYPE_U32;
        s.lanes   = 4;
    }
    or (index == 9) {
        s.name    = "u64x2";
        s.element = TYPE_U64;
        s.lanes   = 2;
    }

    ret s;
}

pub fun prim_name(kind: TypeKind) str {
    val spec: *PrimSpec = prim_spec(kind);
    if (spec == nil) { ret nil; }
    ret spec.spelling;
}

pub fun prim_spelling_len(kind: TypeKind) usize {
    val spec: *PrimSpec = prim_spec(kind);
    if (spec == nil) { ret 0; }
    ret spec.len;
}

# the integer primitive of a width and signedness, absent when the catalog has
# no such row; the one lookup every width-driven typing goes through
pub fun int_kind_for(bits: u32, signed: bool) opt[TypeKind] {
    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        val spec: *PrimSpec = ?PRIM_CATALOG[i];
        if (spec.class == PRIM_CLASS_INT && spec.bits == bits && spec.signed == signed) {
            ret opt[TypeKind].some{spec.kind};
        }
        i = i + 1;
    }
    ret opt[TypeKind].none{};
}

pub fun prim_from_view(name: View) opt[TypeKind] {
    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        if (view_eq_str(name, PRIM_CATALOG[i].spelling)) { ret opt[TypeKind].some{PRIM_CATALOG[i].kind}; }
        i = i + 1;
    }
    ret opt[TypeKind].none{};
}

# the magnitudes an integer kind admits: min_mag is the largest negated value
# (the signed minimum), max_mag the largest positive one, both exact to 128 bits
pub rec IntRange {
    min_negated: bool;
    min_mag:     wide.Wide;
    max_mag:     wide.Wide;
}

pub fun int_range(kind: TypeKind) opt[IntRange] {
    val d: PrimDesc = prim_desc(kind);
    if (d.class != PRIM_CLASS_INT) { ret opt[IntRange].none{}; }

    var r: IntRange;
    # a constant of a kind wider than the 128-bit carrier reaches what an i128 holds, which
    # it extends to its width by its sign (mach#4803 widens the carrier)
    if (d.bits > 128) {
        r.min_negated = d.signed;
        r.min_mag     = wide.zero();
        if (d.signed) { r.min_mag = wide.shl(wide.from_u64(1), 127); }
        r.max_mag = wide.sub(wide.shl(wide.from_u64(1), 127), wide.from_u64(1));
        ret opt[IntRange].some{r};
    }
    if (d.signed) {
        r.min_negated = true;
        r.min_mag     = wide.shl(wide.from_u64(1), d.bits - 1);
        r.max_mag     = wide.sub(r.min_mag, wide.from_u64(1));
        ret opt[IntRange].some{r};
    }
    r.min_negated = false;
    r.min_mag     = wide.zero();
    r.max_mag     = wide.trunc(wide.max_u(), d.width);
    ret opt[IntRange].some{r};
}

pub fun int_fits(value: wide.Wide, negated: bool, r: IntRange) bool {
    if (negated) {
        if (!r.min_negated) { ret false; }
        ret !wide.lt_u(r.min_mag, value);
    }
    ret !wide.lt_u(r.max_mag, value);
}

pub fun int_fits_either_sign(value: wide.Wide, kind: TypeKind) bool {
    val found: opt[IntRange] = int_range(kind);
    if (!sel found.some) { ret true; }
    val r: IntRange = found.some;
    ret int_fits(value, false, r) || int_fits(value, true, r);
}

# the width of a float kind; FLOAT_W_NONE for every other kind
pub fun float_width_of(kind: TypeKind) float.FloatWidth {
    val d: PrimDesc = prim_desc(kind);
    if (d.class != PRIM_CLASS_FLOAT) { ret float.FLOAT_W_NONE; }
    ret float.width_of_bits(d.bits);
}

# the float kind of a width, f64 for FLOAT_W_NONE, the unsuffixed default
pub fun float_kind_of(w: float.FloatWidth) TypeKind {
    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        val spec: *PrimSpec = ?PRIM_CATALOG[i];
        if (spec.class == PRIM_CLASS_FLOAT && float.width_of_bits(spec.bits) == w) { ret spec.kind; }
        i = i + 1;
    }
    ret TYPE_F64;
}

def VecFormStatus: u8;

pub val MAX_VEC_LANES: u32 = 65535;

pub val VEC_FORM_NONE:      VecFormStatus = 0;
pub val VEC_FORM_OK:        VecFormStatus = 1;
pub val VEC_FORM_TOO_WIDE:  VecFormStatus = 2;
val     VEC_FORM_BAD_LANES: VecFormStatus = 3;
# the element is a primitive no vector packs: a lane is 8 to 64 bits wide
pub val VEC_FORM_BAD_ELEMENT: VecFormStatus = 4;

pub val VEC_LANE_MIN_BITS: u32 = 8;
pub val VEC_LANE_MAX_BITS: u32 = 64;

# whether a primitive is a legal vector lane: a declared set, never "every
# primitive but ptr". a 128-bit lane has no packed form on any ISA
fun vec_lane_kind_ok(kind: TypeKind) bool {
    val d: PrimDesc = prim_desc(kind);
    if (d.class != PRIM_CLASS_INT && d.class != PRIM_CLASS_FLOAT) { ret false; }
    ret d.bits >= VEC_LANE_MIN_BITS && d.bits <= VEC_LANE_MAX_BITS;
}

pub rec VecForm {
    status:  VecFormStatus;
    element: TypeKind;
    lanes:   u32;
    bits:    u32;
}

pub fun is_vector_spelling(name: str) bool {
    ret vector_form(name).status != VEC_FORM_NONE;
}

pub fun vector_form(name: str) VecForm {
    var f: VecForm;
    f.status  = VEC_FORM_NONE;
    f.element = TYPE_U8;
    f.lanes   = 0;
    f.bits    = 0;

    if (name == nil) { ret f; }
    val n: usize = str_len(name);
    if (n < 4) { ret f; }

    var split: usize = 0;
    for (split < n && name[split] != 'x') { split = split + 1; }
    if (split == 0)     { ret f; }
    if (split >= n - 1) { ret f; }

    var element: TypeKind = TYPE_U8;
    var found:   bool     = false;
    var k:       u32      = 0;
    for (k < PRIM_COUNT) {
        val kind: TypeKind = PRIM_CATALOG[k].kind;
        if (kind != TYPE_PTR && str_region_equals(name, 0, split, prim_name(kind))) {
            element = kind;
            found   = true;
        }
        k = k + 1;
    }
    if (!found) { ret f; }
    if (!vec_lane_kind_ok(element)) {
        f.element = element;
        f.status  = VEC_FORM_BAD_ELEMENT;
        ret f;
    }

    if (name[split + 1] == '0') { ret f; }
    var lanes: u64   = 0;
    var i:     usize = split + 1;
    for (i < n) {
        val c: u8 = name[i];
        if (c < '0' || c > '9') { ret f; }
        lanes = lanes * 10 + (c - '0')::u64;
        if (lanes > MAX_VEC_LANES::u64) { lanes = MAX_VEC_LANES::u64 + 1; }
        i = i + 1;
    }

    f.element = element;
    f.lanes   = lanes::u32;
    if (lanes > MAX_VEC_LANES::u64) { f.lanes = MAX_VEC_LANES + 1; }

    if (lanes < 2) {
        f.status = VEC_FORM_BAD_LANES;
        ret f;
    }
    if (lanes > MAX_VEC_LANES::u64) {
        f.status = VEC_FORM_TOO_WIDE;
        ret f;
    }

    f.bits   = (prim_desc(element).bits::u64 * lanes)::u32;
    f.status = VEC_FORM_OK;
    ret f;
}
