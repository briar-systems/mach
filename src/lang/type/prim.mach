use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;
use std.types.view.View;
use std.types.view.view_eq_str;

use std.allocator.page;
use std.print;

use A: std.allocator;

use mach.lang.float;
use mach.lang.reference;
use lang_source: mach.lang.source;
use mach.lang.type.kind.TYPE_F16;
use mach.lang.type.kind.TYPE_F32;
use mach.lang.type.kind.TYPE_F64;
use mach.lang.type.kind.TYPE_I128;
use mach.lang.type.kind.TYPE_I16;
use mach.lang.type.kind.TYPE_I32;
use mach.lang.type.kind.TYPE_I64;
use mach.lang.type.kind.TYPE_I8;
use mach.lang.type.kind.TYPE_POINTER;
use mach.lang.type.kind.TYPE_PTR;
use mach.lang.type.kind.TYPE_U128;
use mach.lang.type.kind.TYPE_U16;
use mach.lang.type.kind.TYPE_U32;
use mach.lang.type.kind.TYPE_U64;
use mach.lang.type.kind.TYPE_U8;
use mach.lang.type.kind.TYPE_VECTOR;
use mach.lang.type.kind.TypeKind;
use mach.lang.wide;

pub val PRIM_COUNT: u32 = 14;

pub def PrimClass: u8;

pub val PRIM_CLASS_NONE:  PrimClass = 0;
pub val PRIM_CLASS_INT:   PrimClass = 1;
pub val PRIM_CLASS_FLOAT: PrimClass = 2;
pub val PRIM_CLASS_PTR:   PrimClass = 3;

pub rec PrimDesc {
    class:  PrimClass;
    signed: bool;
    bits:   u32;
}

rec PrimSpec {
    kind:     TypeKind;
    spelling: str;
    len:      usize;
    class:    PrimClass;
    signed:   bool;
    bits:     u32;
}

val PRIM_CATALOG: [PRIM_COUNT]PrimSpec = [PRIM_COUNT]PrimSpec{
    PrimSpec{kind: TYPE_U8, spelling: "u8", len: 2, class: PRIM_CLASS_INT, signed: false, bits: 8},
    PrimSpec{kind: TYPE_U16, spelling: "u16", len: 3, class: PRIM_CLASS_INT, signed: false, bits: 16},
    PrimSpec{kind: TYPE_U32, spelling: "u32", len: 3, class: PRIM_CLASS_INT, signed: false, bits: 32},
    PrimSpec{kind: TYPE_U64, spelling: "u64", len: 3, class: PRIM_CLASS_INT, signed: false, bits: 64},
    PrimSpec{kind: TYPE_I8, spelling: "i8", len: 2, class: PRIM_CLASS_INT, signed: true, bits: 8},
    PrimSpec{kind: TYPE_I16, spelling: "i16", len: 3, class: PRIM_CLASS_INT, signed: true, bits: 16},
    PrimSpec{kind: TYPE_I32, spelling: "i32", len: 3, class: PRIM_CLASS_INT, signed: true, bits: 32},
    PrimSpec{kind: TYPE_I64, spelling: "i64", len: 3, class: PRIM_CLASS_INT, signed: true, bits: 64},
    PrimSpec{kind: TYPE_F32, spelling: "f32", len: 3, class: PRIM_CLASS_FLOAT, signed: false, bits: 32},
    PrimSpec{kind: TYPE_F64, spelling: "f64", len: 3, class: PRIM_CLASS_FLOAT, signed: false, bits: 64},
    PrimSpec{kind: TYPE_PTR, spelling: "ptr", len: 3, class: PRIM_CLASS_PTR, signed: false, bits: 0},
    PrimSpec{kind: TYPE_U128, spelling: "u128", len: 4, class: PRIM_CLASS_INT, signed: false, bits: 128},
    PrimSpec{kind: TYPE_I128, spelling: "i128", len: 4, class: PRIM_CLASS_INT, signed: true, bits: 128},
    PrimSpec{kind: TYPE_F16, spelling: "f16", len: 3, class: PRIM_CLASS_FLOAT, signed: false, bits: 16},
};

fun prim_spec(kind: TypeKind) *PrimSpec {
    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        if (PRIM_CATALOG[i].kind == kind) { ret ?PRIM_CATALOG[i]; }
        i = i + 1;
    }
    ret nil;
}

# the primitive predicate: a kind is primitive exactly when the catalog names
# it, never because of where it sits in the TypeKind numbering
pub fun is_prim(kind: TypeKind) bool {
    ret prim_spec(kind) != nil;
}

# the catalog position of a primitive kind, the index of every table sized by
# PRIM_COUNT
pub fun prim_index(kind: TypeKind) opt[u32] {
    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        if (PRIM_CATALOG[i].kind == kind) { ret opt[u32].some{i}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# the kind at a catalog position, for walkers over 0..PRIM_COUNT
pub fun prim_kind_at(index: u32) TypeKind {
    ret PRIM_CATALOG[index].kind;
}

pub fun prim_desc(kind: TypeKind) PrimDesc {
    val spec: *PrimSpec = prim_spec(kind);
    var d:    PrimDesc;
    if (spec == nil) {
        d.class  = PRIM_CLASS_NONE;
        d.signed = false;
        d.bits   = 0;
        ret d;
    }
    d.class  = spec.class;
    d.signed = spec.signed;
    d.bits   = spec.bits;
    ret d;
}

# the vectors the type table seeds, by position below VEC_COUNT
pub val VEC_COUNT: u32 = 10;

pub rec VecShape {
    name:    str;
    element: TypeKind;
    lanes:   u32;
}

pub fun vec_shape(index: u32) VecShape {
    var s: VecShape;
    s.name    = nil;
    s.element = TYPE_U8;
    s.lanes   = 0;

    if (index == 0) {
        s.name    = "f32x4";
        s.element = TYPE_F32;
        s.lanes   = 4;
    }
    or (index == 1) {
        s.name    = "f64x2";
        s.element = TYPE_F64;
        s.lanes   = 2;
    }
    or (index == 2) {
        s.name    = "i8x16";
        s.element = TYPE_I8;
        s.lanes   = 16;
    }
    or (index == 3) {
        s.name    = "i16x8";
        s.element = TYPE_I16;
        s.lanes   = 8;
    }
    or (index == 4) {
        s.name    = "i32x4";
        s.element = TYPE_I32;
        s.lanes   = 4;
    }
    or (index == 5) {
        s.name    = "i64x2";
        s.element = TYPE_I64;
        s.lanes   = 2;
    }
    or (index == 6) {
        s.name    = "u8x16";
        s.element = TYPE_U8;
        s.lanes   = 16;
    }
    or (index == 7) {
        s.name    = "u16x8";
        s.element = TYPE_U16;
        s.lanes   = 8;
    }
    or (index == 8) {
        s.name    = "u32x4";
        s.element = TYPE_U32;
        s.lanes   = 4;
    }
    or (index == 9) {
        s.name    = "u64x2";
        s.element = TYPE_U64;
        s.lanes   = 2;
    }

    ret s;
}

pub fun prim_name(kind: TypeKind) str {
    val spec: *PrimSpec = prim_spec(kind);
    if (spec == nil) { ret nil; }
    ret spec.spelling;
}

pub fun prim_spelling_len(kind: TypeKind) usize {
    val spec: *PrimSpec = prim_spec(kind);
    if (spec == nil) { ret 0; }
    ret spec.len;
}

#[testing]
fun prim_from_name(name: str) opt[TypeKind] {
    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        if (str_equals(PRIM_CATALOG[i].spelling, name)) { ret opt[TypeKind].some{PRIM_CATALOG[i].kind}; }
        i = i + 1;
    }
    ret opt[TypeKind].none{};
}

# the integer primitive of a width and signedness, absent when the catalog has
# no such row; the one lookup every width-driven typing goes through
pub fun int_kind_for(bits: u32, signed: bool) opt[TypeKind] {
    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        val spec: *PrimSpec = ?PRIM_CATALOG[i];
        if (spec.class == PRIM_CLASS_INT && spec.bits == bits && spec.signed == signed) {
            ret opt[TypeKind].some{spec.kind};
        }
        i = i + 1;
    }
    ret opt[TypeKind].none{};
}

pub fun prim_from_view(name: View) opt[TypeKind] {
    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        if (view_eq_str(name, PRIM_CATALOG[i].spelling)) { ret opt[TypeKind].some{PRIM_CATALOG[i].kind}; }
        i = i + 1;
    }
    ret opt[TypeKind].none{};
}

# the magnitudes an integer kind admits: min_mag is the largest negated value
# (the signed minimum), max_mag the largest positive one, both exact to 128 bits
pub rec IntRange {
    min_negated: bool;
    min_mag:     wide.Wide;
    max_mag:     wide.Wide;
}

pub fun int_range(kind: TypeKind) opt[IntRange] {
    val d: PrimDesc = prim_desc(kind);
    if (d.class != PRIM_CLASS_INT) { ret opt[IntRange].none{}; }

    var r: IntRange;
    if (d.signed) {
        r.min_negated = true;
        r.min_mag     = wide.shl(wide.from_u64(1), d.bits - 1);
        r.max_mag     = wide.sub(r.min_mag, wide.from_u64(1));
        ret opt[IntRange].some{r};
    }
    r.min_negated = false;
    r.min_mag     = wide.zero();
    r.max_mag     = wide.trunc(wide.max_u(), d.bits);
    ret opt[IntRange].some{r};
}

pub fun int_fits(value: wide.Wide, negated: bool, r: IntRange) bool {
    if (negated) {
        if (!r.min_negated) { ret false; }
        ret !wide.lt_u(r.min_mag, value);
    }
    ret !wide.lt_u(r.max_mag, value);
}

pub fun int_fits_either_sign(value: wide.Wide, kind: TypeKind) bool {
    val found: opt[IntRange] = int_range(kind);
    if (!sel found.some) { ret true; }
    val r: IntRange = found.some;
    ret int_fits(value, false, r) || int_fits(value, true, r);
}

# the width of a float kind; FLOAT_W_NONE for every other kind
pub fun float_width_of(kind: TypeKind) float.FloatWidth {
    val d: PrimDesc = prim_desc(kind);
    if (d.class != PRIM_CLASS_FLOAT) { ret float.FLOAT_W_NONE; }
    ret float.width_of_bits(d.bits);
}

# the float kind of a width, f64 for FLOAT_W_NONE, the unsuffixed default
pub fun float_kind_of(w: float.FloatWidth) TypeKind {
    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        val spec: *PrimSpec = ?PRIM_CATALOG[i];
        if (spec.class == PRIM_CLASS_FLOAT && float.width_of_bits(spec.bits) == w) { ret spec.kind; }
        i = i + 1;
    }
    ret TYPE_F64;
}

def VecFormStatus: u8;

pub val MAX_VEC_LANES: u32 = 65535;

pub val VEC_FORM_NONE:      VecFormStatus = 0;
pub val VEC_FORM_OK:        VecFormStatus = 1;
pub val VEC_FORM_TOO_WIDE:  VecFormStatus = 2;
val     VEC_FORM_BAD_LANES: VecFormStatus = 3;
# the element is a primitive no vector packs: a lane is 8 to 64 bits wide
pub val VEC_FORM_BAD_ELEMENT: VecFormStatus = 4;

pub val VEC_LANE_MIN_BITS: u32 = 8;
pub val VEC_LANE_MAX_BITS: u32 = 64;

# whether a primitive is a legal vector lane: a declared set, never "every
# primitive but ptr". a 128-bit lane has no packed form on any ISA
fun vec_lane_kind_ok(kind: TypeKind) bool {
    val d: PrimDesc = prim_desc(kind);
    if (d.class != PRIM_CLASS_INT && d.class != PRIM_CLASS_FLOAT) { ret false; }
    ret d.bits >= VEC_LANE_MIN_BITS && d.bits <= VEC_LANE_MAX_BITS;
}

pub rec VecForm {
    status:  VecFormStatus;
    element: TypeKind;
    lanes:   u32;
    bits:    u32;
}

pub fun is_vector_spelling(name: str) bool {
    ret vector_form(name).status != VEC_FORM_NONE;
}

pub fun vector_form(name: str) VecForm {
    var f: VecForm;
    f.status  = VEC_FORM_NONE;
    f.element = TYPE_U8;
    f.lanes   = 0;
    f.bits    = 0;

    if (name == nil) { ret f; }
    val n: usize = str_len(name);
    if (n < 4) { ret f; }

    var split: usize = 0;
    for (split < n && name[split] != 'x') { split = split + 1; }
    if (split == 0)     { ret f; }
    if (split >= n - 1) { ret f; }

    var element: TypeKind = TYPE_U8;
    var found:   bool     = false;
    var k:       u32      = 0;
    for (k < PRIM_COUNT) {
        val kind: TypeKind = PRIM_CATALOG[k].kind;
        if (kind != TYPE_PTR && str_region_equals(name, 0, split, prim_name(kind))) {
            element = kind;
            found   = true;
        }
        k = k + 1;
    }
    if (!found) { ret f; }
    if (!vec_lane_kind_ok(element)) {
        f.element = element;
        f.status  = VEC_FORM_BAD_ELEMENT;
        ret f;
    }

    if (name[split + 1] == '0') { ret f; }
    var lanes: u64   = 0;
    var i:     usize = split + 1;
    for (i < n) {
        val c: u8 = name[i];
        if (c < '0' || c > '9') { ret f; }
        lanes = lanes * 10 + (c - '0')::u64;
        if (lanes > MAX_VEC_LANES::u64) { lanes = MAX_VEC_LANES::u64 + 1; }
        i = i + 1;
    }

    f.element = element;
    f.lanes   = lanes::u32;
    if (lanes > MAX_VEC_LANES::u64) { f.lanes = MAX_VEC_LANES + 1; }

    if (lanes < 2) {
        f.status = VEC_FORM_BAD_LANES;
        ret f;
    }
    if (lanes > MAX_VEC_LANES::u64) {
        f.status = VEC_FORM_TOO_WIDE;
        ret f;
    }

    f.bits   = (prim_desc(element).bits::u64 * lanes)::u32;
    f.status = VEC_FORM_OK;
    ret f;
}

# every integer kind's range is exact to its width, and 2^127 no longer wraps
test int_range__exact_at_every_width_through_128 {
    val u8_r: opt[IntRange] = int_range(TYPE_U8);
    if (!sel u8_r.some)                                                           { ret 1; }
    if (u8_r.some.min_negated || !wide.eq(u8_r.some.max_mag, wide.from_u64(255))) { ret 2; }
    val i8_r: opt[IntRange] = int_range(TYPE_I8);
    if (!sel i8_r.some)                                                                                                               { ret 3; }
    if (!i8_r.some.min_negated || !wide.eq(i8_r.some.min_mag, wide.from_u64(128)) || !wide.eq(i8_r.some.max_mag, wide.from_u64(127))) { ret 4; }
    val u64_r: opt[IntRange] = int_range(TYPE_U64);
    if (!sel u64_r.some)                                                 { ret 5; }
    if (!wide.eq(u64_r.some.max_mag, wide.from_u64(0xFFFFFFFFFFFFFFFF))) { ret 6; }
    val i64_r: opt[IntRange] = int_range(TYPE_I64);
    if (!sel i64_r.some)                                                                                                                    { ret 7; }
    if (!wide.eq(i64_r.some.min_mag, wide.from_u64(0x8000000000000000)) || !wide.eq(i64_r.some.max_mag, wide.from_u64(0x7FFFFFFFFFFFFFFF))) { ret 8; }
    val u128_r: opt[IntRange] = int_range(TYPE_U128);
    if (!sel u128_r.some)                                                                                             { ret 9; }
    if (u128_r.some.min_negated || !wide.eq(u128_r.some.max_mag, wide.max_u()) || !wide.is_zero(u128_r.some.min_mag)) { ret 10; }
    val i128_r: opt[IntRange] = int_range(TYPE_I128);
    if (!sel i128_r.some)                                                                                                       { ret 11; }
    if (!i128_r.some.min_negated || !wide.eq(i128_r.some.min_mag, wide.min_s()) || !wide.eq(i128_r.some.max_mag, wide.max_s())) { ret 12; }
    val f64_r: opt[IntRange] = int_range(TYPE_F64);
    val ptr_r: opt[IntRange] = int_range(TYPE_PTR);
    val ptd_r: opt[IntRange] = int_range(TYPE_POINTER);
    if (sel f64_r.some || sel ptr_r.some || sel ptd_r.some) { ret 13; }

    val i128: IntRange = i128_r.some;
    val u128: IntRange = u128_r.some;
    if (!int_fits(wide.max_s(), false, i128))                                      { ret 14; }
    if (int_fits(wide.min_s(), false, i128))                                       { ret 15; }
    if (!int_fits(wide.min_s(), true, i128))                                       { ret 16; }
    if (int_fits(wide.add(wide.min_s(), wide.from_u64(1)), true, i128))            { ret 17; }
    if (!int_fits(wide.max_u(), false, u128))                                      { ret 18; }
    if (int_fits(wide.from_u64(1), true, u128))                                    { ret 19; }
    if (!int_fits_either_sign(wide.min_s(), TYPE_I128))                            { ret 20; }
    if (int_fits_either_sign(wide.add(wide.min_s(), wide.from_u64(1)), TYPE_I128)) { ret 21; }
    if (!int_fits_either_sign(wide.make(0, 1), TYPE_U128))                         { ret 22; }
    if (int_fits_either_sign(wide.make(0, 1), TYPE_U64))                           { ret 23; }
    if (!int_fits_either_sign(wide.from_u64(128), TYPE_I8))                        { ret 24; }
    if (int_fits_either_sign(wide.from_u64(129), TYPE_I8))                         { ret 25; }
    if (!int_fits_either_sign(wide.from_u64(7), TYPE_F32))                         { ret 26; }
    ret 0;
}

test vector_form__reads_the_form_at_every_width {
    var vi: u32 = 0;
    for (vi < VEC_COUNT) {
        val sh: VecShape = vec_shape(vi);
        val f:  VecForm  = vector_form(sh.name);
        if (f.status != VEC_FORM_OK) { ret 1; }
        if (f.element != sh.element) { ret 1; }
        if (f.lanes != sh.lanes)     { ret 1; }
        if (f.bits != 128)           { ret 1; }
        vi = vi + 1;
    }

    val v3: VecForm = vector_form("f32x3");
    if (v3.status != VEC_FORM_OK) { ret 1; }
    if (v3.element != TYPE_F32)   { ret 1; }
    if (v3.lanes != 3)            { ret 1; }
    if (v3.bits != 96)            { ret 1; }

    val u3: VecForm = vector_form("u32x3");
    if (u3.status != VEC_FORM_OK) { ret 1; }
    if (u3.element != TYPE_U32)   { ret 1; }
    if (u3.lanes != 3)            { ret 1; }

    val v2: VecForm = vector_form("f32x2");
    if (v2.status != VEC_FORM_OK) { ret 1; }
    if (v2.lanes != 2)            { ret 1; }
    if (v2.bits != 64)            { ret 1; }

    val w5: VecForm = vector_form("f32x5");
    if (w5.status != VEC_FORM_OK) { ret 1; }
    if (w5.element != TYPE_F32)   { ret 1; }
    if (w5.lanes != 5)            { ret 1; }
    if (w5.bits != 160)           { ret 1; }

    val w8: VecForm = vector_form("f32x8");
    if (w8.status != VEC_FORM_OK) { ret 1; }
    if (w8.lanes != 8)            { ret 1; }
    if (w8.bits != 256)           { ret 1; }

    if (vector_form("i8x17").status != VEC_FORM_OK) { ret 1; }
    if (vector_form("f64x3").status != VEC_FORM_OK) { ret 1; }
    if (vector_form("f32x16").bits != 512)          { ret 1; }
    if (vector_form("i16x7").bits != 112)           { ret 1; }

    if (vector_form("u8x65535").status != VEC_FORM_OK)       { ret 1; }
    if (vector_form("u8x65535").lanes != MAX_VEC_LANES)      { ret 1; }
    if (vector_form("u8x65536").status != VEC_FORM_TOO_WIDE) { ret 1; }

    if (vector_form("u64x4294967295").status != VEC_FORM_TOO_WIDE) { ret 1; }

    if (vector_form("f32x1").status != VEC_FORM_BAD_LANES) { ret 1; }

    if (vector_form(nil).status != VEC_FORM_NONE)                                                   { ret 1; }
    if (vector_form("").status != VEC_FORM_NONE)                                                    { ret 1; }
    if (vector_form("f32").status != VEC_FORM_NONE)                                                 { ret 1; }
    if (vector_form("f32x").status != VEC_FORM_NONE)                                                { ret 1; }
    if (vector_form("x4").status != VEC_FORM_NONE)                                                  { ret 1; }
    if (vector_form("f33x4").status != VEC_FORM_NONE)                                               { ret 1; }
    if (vector_form("f32x4y").status != VEC_FORM_NONE)                                              { ret 1; }
    if (vector_form("f32x04").status != VEC_FORM_NONE)                                              { ret 1; }
    if (vector_form("ptrx2").status != VEC_FORM_NONE)                                               { ret 1; }
    if (vector_form("u128x2").status != VEC_FORM_BAD_ELEMENT)                                       { ret 1; }
    if (vector_form("i128x4").status != VEC_FORM_BAD_ELEMENT)                                       { ret 1; }
    if (vector_form("u128x2").element != TYPE_U128)                                                 { ret 1; }
    if (vector_form("f16x8").status != VEC_FORM_OK || vector_form("f16x8").bits != 128)             { ret 1; }
    if (vec_lane_kind_ok(TYPE_PTR) || vec_lane_kind_ok(TYPE_U128) || vec_lane_kind_ok(TYPE_VECTOR)) { ret 1; }
    if (!vec_lane_kind_ok(TYPE_U8) || !vec_lane_kind_ok(TYPE_F64) || !vec_lane_kind_ok(TYPE_I64))   { ret 1; }
    if (vector_form("matrix4").status != VEC_FORM_NONE)                                             { ret 1; }

    ret 0;
}

test prim_catalog__complete_unique_ordered_roundtrip {
    var seen: [PRIM_COUNT]bool;
    var i:    u32 = 0;
    for (i < PRIM_COUNT) {
        seen[i] = false;
        i       = i + 1;
    }

    i = 0;
    for (i < PRIM_COUNT) {
        val spec: *PrimSpec = ?PRIM_CATALOG[i];
        if (!is_prim(spec.kind))          { ret 1; }
        if (prim_kind_at(i) != spec.kind) { ret 1; }
        val index: opt[u32] = prim_index(spec.kind);
        if (!sel index.some)                    { ret 1; }
        if (index.some != i)                    { ret 1; }
        if (seen[i])                            { ret 1; }
        if (str_equals(spec.spelling, ""))      { ret 1; }
        if (spec.len != str_len(spec.spelling)) { ret 1; }
        seen[i] = true;

        var j: u32 = 0;
        for (j < i) {
            val prior: *PrimSpec = ?PRIM_CATALOG[j];
            if (prior.kind == spec.kind)                   { ret 1; }
            if (str_equals(prior.spelling, spec.spelling)) { ret 1; }
            j = j + 1;
        }

        if (!str_equals(prim_name(spec.kind), spec.spelling)) { ret 1; }
        if (prim_spelling_len(spec.kind) != spec.len)         { ret 1; }
        val d: PrimDesc = prim_desc(spec.kind);
        if (d.class != spec.class)   { ret 1; }
        if (d.signed != spec.signed) { ret 1; }
        if (d.bits != spec.bits)     { ret 1; }

        val parsed: opt[TypeKind] = prim_from_name(spec.spelling);
        if (!sel parsed.some)         { ret 1; }
        if (parsed.some != spec.kind) { ret 1; }
        i = i + 1;
    }

    val prim_from_name_1: opt[TypeKind] = prim_from_name("");
    if (sel prim_from_name_1.some) { ret 1; }
    val prim_from_name_2: opt[TypeKind] = prim_from_name("bool");
    if (sel prim_from_name_2.some)           { ret 1; }
    if (prim_name(TYPE_VECTOR) != nil)       { ret 1; }
    if (prim_spelling_len(TYPE_VECTOR) != 0) { ret 1; }
    val nd: PrimDesc = prim_desc(TYPE_VECTOR);
    if (nd.class != PRIM_CLASS_NONE) { ret 1; }
    if (nd.signed)                   { ret 1; }
    if (nd.bits != 0)                { ret 1; }

    i = 0;
    for (i < PRIM_COUNT) {
        if (!seen[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

# is_prim is the catalog over the whole kind space: an appended kind is
# primitive because its row is, never because of where it sits
test is_prim__is_the_catalog_over_the_whole_kind_space {
    var k: u32 = 0;
    for (k < 256) {
        val kind:     TypeKind = k::TypeKind;
        val expected: bool     = prim_spec(kind) != nil;
        if (is_prim(kind) != expected) { ret 2; }
        val index: opt[u32] = prim_index(kind);
        if ((sel index.some) != expected)                           { ret 3; }
        if ((prim_name(kind) != nil) != expected)                   { ret 4; }
        if ((prim_desc(kind).class != PRIM_CLASS_NONE) != expected) { ret 5; }
        k = k + 1;
    }
    ret 0;
}

# the spelling of the `i`th primitive when it is of `class`, and signed as `signed`
# where the class is an integer one; nil otherwise
#[testing]
fun spelled_if(i: usize, class: PrimClass, signed: bool) str {
    val spec: *PrimSpec = ?PRIM_CATALOG[i];
    if (spec.class != class)                              { ret nil; }
    if (class == PRIM_CLASS_INT && spec.signed != signed) { ret nil; }
    ret spec.spelling;
}

#[testing]
fun unsigned_at(i: usize) str {
    ret spelled_if(i, PRIM_CLASS_INT, false);
}

#[testing]
fun signed_at(i: usize) str {
    ret spelled_if(i, PRIM_CLASS_INT, true);
}

#[testing]
fun integer_at(i: usize) str {
    val spec: *PrimSpec = ?PRIM_CATALOG[i];
    if (spec.class != PRIM_CLASS_INT) { ret nil; }
    ret spec.spelling;
}

#[testing]
fun float_at(i: usize) str {
    ret spelled_if(i, PRIM_CLASS_FLOAT, false);
}

#[testing]
fun pointer_at(i: usize) str {
    ret spelled_if(i, PRIM_CLASS_PTR, false);
}

# the row of the page's table, or the line, that lists one family of primitives
# holds exactly that family
#[testing]
fun family_agrees(alloc: *A.Allocator, what: str, text: str, within: opt[lang_source.Span], names: fun(usize) str) bool {
    if (sel within.none) {
        print.eprintlnf("{}: the page no longer has this list", what);
        ret false;
    }
    ret reference.agree(alloc, what, text, within.some, reference.WORDS_CODE, names, PRIM_COUNT::usize);
}

# the second cell of the row `first` of `rows`, none when there is no such row
#[testing]
fun members(text: str, rows: lang_source.Span, first: str) opt[lang_source.Span] {
    val row: opt[lang_source.Span] = reference.row_named(text, rows, first);
    if (sel row.none) { ret opt[lang_source.Span].none{}; }
    ret reference.cell(text, row.some, 1);
}

# the literal suffixes of grammar.md, the primitive table of types.md and the
# authoring skill's list of built-in types are the catalog, family by family
test reference__primitive_lists_are_the_catalog {
    var alloc: A.Allocator;
    page.make(?alloc);
    val grammar: opt[str] = reference.page_or_report(?alloc, "doc/language/grammar.md");
    if (sel grammar.none) { ret 1; }
    val int_suffix: opt[lang_source.Span] = reference.production(grammar.some, "int-suffix");
    if (sel int_suffix.none)                                                                                                                     { ret 2; }
    if (!reference.agree(?alloc, "grammar.md int-suffix", grammar.some, int_suffix.some, reference.WORDS_QUOTED, integer_at, PRIM_COUNT::usize)) { ret 3; }
    val float_suffix: opt[lang_source.Span] = reference.production(grammar.some, "float-suffix");
    if (sel float_suffix.none)                                                                                                                     { ret 4; }
    if (!reference.agree(?alloc, "grammar.md float-suffix", grammar.some, float_suffix.some, reference.WORDS_QUOTED, float_at, PRIM_COUNT::usize)) { ret 5; }

    val types: opt[str] = reference.page_or_report(?alloc, "doc/language/types.md");
    if (sel types.none) { ret 6; }
    val rows: opt[lang_source.Span] = reference.table(types.some, 0, "| Family | Members |");
    if (sel rows.none)                                                                                                                 { ret 7; }
    if (!family_agrees(?alloc, "types.md Unsigned int", types.some, members(types.some, rows.some, "Unsigned int"), unsigned_at))      { ret 8; }
    if (!family_agrees(?alloc, "types.md Signed int", types.some, members(types.some, rows.some, "Signed int"), signed_at))            { ret 8; }
    if (!family_agrees(?alloc, "types.md Float", types.some, members(types.some, rows.some, "Float"), float_at))                       { ret 8; }
    if (!family_agrees(?alloc, "types.md Untyped pointer", types.some, members(types.some, rows.some, "Untyped pointer"), pointer_at)) { ret 8; }

    val skill: opt[str] = reference.page_or_report(?alloc, "doc/skills/mach/SKILL.md");
    if (sel skill.none)                                                                                                                         { ret 9; }
    if (!family_agrees(?alloc, "SKILL.md Integers", skill.some, reference.line_after(skill.some, "- **Integers**:"), integer_at))               { ret 10; }
    if (!family_agrees(?alloc, "SKILL.md Floating point", skill.some, reference.line_after(skill.some, "- **Floating point**:"), float_at))     { ret 10; }
    if (!family_agrees(?alloc, "SKILL.md Untyped pointer", skill.some, reference.line_after(skill.some, "- **Untyped pointer**:"), pointer_at)) { ret 10; }
    ret 0;
}
