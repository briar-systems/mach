use std.collections.map;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.deprecation;
use mach.lang.fail;
use mach.lang.handle;
use mach.lang.intern;
use mach.lang.type.kind.TABLE_INDEX_TEXT;
use mach.lang.type.kind.TYPE_NIL;
use mach.lang.type.kind.TypeId;

pub rec Entry {
    name: intern.StrId;
    ty:   TypeId;
    # a tag case's deprecation notice; absent on every record and union field
    deprecation: deprecation.Deprecation;
}

# the layout decorations a nominal declares: its alignment, zero when it declares
# none, and whether it is packed or volatile
pub rec Decoration {
    align:     u32;
    packed:    bool;
    volatile_: bool;
}

pub rec Table {
    ty:           TypeId;
    fields_start: u32;
    fields_len:   u32;
    epoch:        u32;
}

# the field tables of every aggregate, the declared discriminator of every tag and
# the layout decorations of every nominal, for one type projection; a projection
# reset clears all of it
pub rec Projection {
    a: *A.Allocator;

    tables: handle.StableChunks[Table];
    index:  map.Map[TypeId, u32];
    pool:   handle.StableChunks[Entry];

    # the declared discriminator type per tag nominal, re-installed with the case table
    discriminators: map.Map[TypeId, TypeId];
    # the declared decorations per nominal, re-installed with its field table
    decorations: map.Map[TypeId, Decoration];

    epoch: u32;
}

pub fun projection_init(a: *A.Allocator) Projection {
    var p: Projection;
    p.a              = a;
    p.tables         = handle.chunk_init[Table](a);
    p.pool           = handle.chunk_init[Entry](a);
    p.index          = map.init[TypeId, u32](a);
    p.discriminators = map.init[TypeId, TypeId](a);
    p.decorations    = map.init[TypeId, Decoration](a);
    p.epoch          = 0;
    ret p;
}

pub fun projection_dnit(p: *Projection) {
    handle.chunk_dnit[Table](?p.tables);
    handle.chunk_dnit[Entry](?p.pool);
    map.dnit[TypeId, u32](?p.index);
    map.dnit[TypeId, TypeId](?p.discriminators);
    map.dnit[TypeId, Decoration](?p.decorations);
    p.epoch = 0;
}

pub fun projection_reset(p: *Projection) {
    handle.chunk_dnit[Table](?p.tables);
    handle.chunk_dnit[Entry](?p.pool);
    p.tables = handle.chunk_init[Table](p.a);
    p.pool   = handle.chunk_init[Entry](p.a);
    map.clear[TypeId, u32](?p.index);
    map.clear[TypeId, TypeId](?p.discriminators);
    map.clear[TypeId, Decoration](?p.decorations);
    p.epoch = 0;
}

pub fun epoch(p: *Projection) u32 {
    ret p.epoch;
}

#[testing]
pub fun epoch_bump(p: *Projection) {
    p.epoch = p.epoch + 1;
}

# reserves room for `additional` entries and answers where the next staged run starts
pub fun stage(p: *Projection, additional: u32) res[u32, fail.Fail] {
    val ce_r: res[handle.ChunkEditor[Entry], handle.Error] = handle.chunk_editor[Entry](?p.pool);
    if (sel ce_r.err) {
        ret res[u32, fail.Fail].err{fail.message(handle.text(ce_r.err))};
    }
    var ce:        handle.ChunkEditor[Entry] = ce_r.ok;
    val reserve_r: err[handle.Error]         = handle.chunk_grow[Entry](?ce, additional::usize);
    handle.chunk_editor_finish[Entry](?ce);
    if (sel reserve_r.err) {
        ret res[u32, fail.Fail].err{fail.message(handle.text(reserve_r.err))};
    }
    ret res[u32, fail.Fail].ok{handle.chunk_count[Entry](?p.pool)::u32};
}

pub fun entry_push(p: *Projection, fe: Entry) err[fail.Fail] {
    val ce_r: res[handle.ChunkEditor[Entry], handle.Error] = handle.chunk_editor[Entry](?p.pool);
    if (sel ce_r.err) {
        ret err[fail.Fail].err{fail.message(handle.text(ce_r.err))};
    }
    var ce:     handle.ChunkEditor[Entry] = ce_r.ok;
    val push_r: res[*Entry, handle.Error] = handle.chunk_append[Entry](?ce, fe);
    handle.chunk_editor_finish[Entry](?ce);
    if (sel push_r.err) {
        ret err[fail.Fail].err{fail.message(handle.text(push_r.err))};
    }
    ret err[fail.Fail].ok{};
}

pub fun publish(p: *Projection, ty: TypeId, fields_start: u32, fields_len: u32) err[fail.Fail] {
    val staged: u32 = handle.chunk_count[Entry](?p.pool)::u32;
    if (fields_start > staged || staged - fields_start < fields_len) {
        ret err[fail.Fail].err{fail.message("field table: staged run does not cover the published field count")};
    }

    val res_get: opt[*u32] = map.get[TypeId, u32](?p.index, ?ty);
    if (sel res_get.some) {
        val idx:    u32         = @res_get.some;
        val slot_r: opt[*Table] = handle.chunk_at[Table](?p.tables, idx::usize);
        if (sel slot_r.none) {
            ret err[fail.Fail].err{fail.message(TABLE_INDEX_TEXT)};
        }
        val slot: *Table = slot_r.some;
        slot.fields_start = fields_start;
        slot.fields_len   = fields_len;
        slot.epoch        = p.epoch;
        ret err[fail.Fail].ok{};
    }

    val ce_r: res[handle.ChunkEditor[Table], handle.Error] = handle.chunk_editor[Table](?p.tables);
    if (sel ce_r.err) {
        ret err[fail.Fail].err{fail.message(handle.text(ce_r.err))};
    }
    var ce: handle.ChunkEditor[Table] = ce_r.ok;

    var ft: Table;
    ft.ty           = ty;
    ft.fields_start = fields_start;
    ft.fields_len   = fields_len;
    ft.epoch        = p.epoch;
    val push_r: res[*Table, handle.Error] = handle.chunk_append[Table](?ce, ft);
    handle.chunk_editor_finish[Table](?ce);
    if (sel push_r.err) {
        ret err[fail.Fail].err{fail.message(handle.text(push_r.err))};
    }

    val idx:        u32                = handle.chunk_count[Table](?p.tables)::u32 - 1;
    val res_insert: res[bool, A.Error] = map.insert[TypeId, u32](?p.index, ty, idx);
    if (sel res_insert.err) {
        ret err[fail.Fail].err{fail.refused(res_insert.err)};
    }

    ret err[fail.Fail].ok{};
}

# the table published for `ty` under the current epoch
pub fun table_for(p: *Projection, ty: TypeId) opt[*Table] {
    val res_get: opt[*u32] = map.get[TypeId, u32](?p.index, ?ty);
    if (!sel res_get.some) {
        ret opt[*Table].none{};
    }
    val idx:    u32         = @res_get.some;
    val slot_r: opt[*Table] = handle.chunk_at[Table](?p.tables, idx::usize);
    if (sel slot_r.none) { ret opt[*Table].none{}; }
    val ft: *Table = slot_r.some;
    if (ft.epoch != p.epoch) { ret opt[*Table].none{}; }
    ret opt[*Table].some{ft};
}

pub fun entry_at(p: *Projection, ft: *Table, ix: u32) *Entry {
    val entry_r: opt[*Entry] = handle.chunk_at[Entry](?p.pool, (ft.fields_start + ix)::usize);
    if (sel entry_r.none) { ret nil; }
    ret entry_r.some;
}

# the declared discriminator of tag nominal `nom`, TYPE_NIL when it has none
pub fun discriminator_of(p: *Projection, nom: TypeId) TypeId {
    val found: opt[*TypeId] = map.get[TypeId, TypeId](?p.discriminators, ?nom);
    if (!sel found.some) { ret TYPE_NIL; }
    ret @found.some;
}

pub fun discriminator_set(p: *Projection, nom: TypeId, disc: TypeId) err[fail.Fail] {
    val inserted: res[bool, A.Error] = map.insert[TypeId, TypeId](?p.discriminators, nom, disc);
    if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun discriminator_del(p: *Projection, nom: TypeId) {
    map.remove[TypeId, TypeId](?p.discriminators, ?nom);
}

# the decorations `ty` declares; none when it declares none
pub fun decoration_of(p: *Projection, ty: TypeId) Decoration {
    val found: opt[*Decoration] = map.get[TypeId, Decoration](?p.decorations, ?ty);
    if (!sel found.some) { ret Decoration{align: 0, packed: false, volatile_: false}; }
    ret @found.some;
}

pub fun decoration_set(p: *Projection, ty: TypeId, d: Decoration) err[fail.Fail] {
    val inserted: res[bool, A.Error] = map.insert[TypeId, Decoration](?p.decorations, ty, d);
    if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
    ret err[fail.Fail].ok{};
}
