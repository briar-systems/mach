# one walk over the type graph: a property is a leaf predicate, and the walk follows
# the edges the property names from a type to the types it is built from. an aggregate is
# entered once per scan, and a type id the store does not hold is an internal failure
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A:                  std.allocator;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;

use lang_alloc: mach.lang.alloc;
use mach.lang.fail;
use mach.lang.type;

pub def Edges: u8;

# a secret's base
pub val EDGE_BASE: Edges = 1;
# an array's element
pub val EDGE_ELEMENT: Edges = 2;
pub val EDGE_POINTEE: Edges = 4;
# a function's return, then its parameters
pub val EDGE_SIGNATURE: Edges = 8;
# an instance's arguments
pub val EDGE_ARGUMENT: Edges = 16;
# the generic declaration an instance instantiates
pub val EDGE_DECLARATION: Edges = 32;
# a record's, union's or tag's declared fields
pub val EDGE_FIELD: Edges = 64;
# an instance's own fields, from the table built for it
val EDGE_INSTANCE_FIELD: Edges = 128;

# what a value holds in its own storage
pub val EDGES_VALUE: Edges = EDGE_BASE | EDGE_ELEMENT | EDGE_FIELD | EDGE_INSTANCE_FIELD;
# every type a type is spelled from, through pointers and signatures included
pub val EDGES_SPELLING: Edges = EDGE_BASE | EDGE_ELEMENT | EDGE_POINTEE | EDGE_SIGNATURE | EDGE_ARGUMENT;

# what a leaf predicate says of one type
pub def Verdict: u8;

# the property may lie below: follow the edges
pub val DESCEND: Verdict = 0;
# the property is not here and not below
pub val PRUNE: Verdict = 1;
# the property is here, which ends the walk
pub val FOUND: Verdict = 2;

pub rec Walk[C] {
    types:  *type.TypeInterner;
    status: *fail.PhaseStatus;
    # the aggregates already entered; nil enters each every time it is met
    scan: *type.TypeScan;
    # with a scan, every type is entered once, not only an aggregate: for a property whose
    # answer below a type does not depend on the path the walk took to it, so a scan shared
    # across many roots visits each type once in all
    once:  bool;
    edges: Edges;
    ctx:   *C;
    leaf:  fun(*C, type.TypeId, *type.Type) Verdict;
}

# whether the property holds at `tid` or below it; false once the walk has failed. the walk
# keeps what it has yet to visit on a worklist rather than the stack, in the order a recursive
# walk would visit it, so a type nested through flat defs deeper than any stack is still answered
pub fun reaches[C](w: *Walk[C], tid: type.TypeId) bool {
    var work: Vector[Pending] = collections_vector.init[Pending](w.types.a);
    fin { collections_vector.dnit[Pending](?work); }
    var next: Pending = Pending{kind: PENDING_TYPE, ty: tid};
    for {
        if (sel w.status.kind.internal) { ret false; }
        val at: opt[type.TypeId] = pending_type[C](w, ?work, next);
        if (sel at.some) {
            val found: bool = step[C](w, ?work, at.some);
            if (found) { ret true; }
        }
        val popped: opt[Pending] = collections_vector.pop[Pending](?work);
        if (sel popped.none) { ret false; }
        next = popped.some;
    }
}

# what the walk has yet to visit: a type, a parameter by its pool index, an aggregate's field
# table to open, or one of its fields by index. a parameter or field is read only when its turn
# comes, as a recursive walk would read it
def PendingKind: u8;

val PENDING_TYPE:   PendingKind = 0;
val PENDING_PARAM:  PendingKind = 1;
val PENDING_FIELDS: PendingKind = 2;
val PENDING_FIELD:  PendingKind = 3;

rec Pending {
    kind:  PendingKind;
    ty:    type.TypeId;
    index: u32;
}

# the type `p` names, none for a table opened onto the worklist or a failure recorded
fun pending_type[C](w: *Walk[C], work: *Vector[Pending], p: Pending) opt[type.TypeId] {
    if (p.kind == PENDING_TYPE) { ret opt[type.TypeId].some{p.ty}; }
    if (p.kind == PENDING_PARAM) {
        val param: opt[type.TypeId] = type.get_param(w.types, p.index);
        if (sel param.none) { fail.internal(w.status, "type walk: a parameter list runs past the store"); }
        ret param;
    }
    if (p.kind == PENDING_FIELDS) {
        val table: opt[*type.FieldTable] = type.field_table_for(w.types, p.ty);
        if (!sel table.some) {
            fail.internal(w.status, "type walk: an aggregate it entered has no field table");
            ret opt[type.TypeId].none{};
        }
        var f: u32 = table.some.fields_len;
        for (f > 0) {
            f = f - 1;
            if (!pend[C](w, work, Pending{kind: PENDING_FIELD, ty: p.ty, index: f})) { ret opt[type.TypeId].none{}; }
        }
        ret opt[type.TypeId].none{};
    }
    val entry: opt[*type.FieldEntry] = type.field_at(w.types, p.ty, p.index);
    if (!sel entry.some) {
        fail.internal(w.status, "type walk: a field table is shorter than it says");
        ret opt[type.TypeId].none{};
    }
    ret opt[type.TypeId].some{entry.some.ty};
}

fun pend[C](w: *Walk[C], work: *Vector[Pending], p: Pending) bool {
    val pushed: res[usize, A.Error] = collections_vector.push[Pending](work, p);
    if (sel pushed.err) {
        fail.internal(w.status, lang_alloc.text(pushed.err));
        ret false;
    }
    ret true;
}

# the parameters of the pool from `start`, pended so the first is visited first
fun pend_params[C](w: *Walk[C], work: *Vector[Pending], start: u32, len: u32) bool {
    var i: u32 = len;
    for (i > 0) {
        i = i - 1;
        if (!pend[C](w, work, Pending{kind: PENDING_PARAM, index: start + i})) { ret false; }
    }
    ret true;
}

# whether the property is at `tid`; when it may lie below, the edges the walk follows are
# pended so they are visited in order
fun step[C](w: *Walk[C], work: *Vector[Pending], tid: type.TypeId) bool {
    if (type.is_nil(tid) || type.is_error(tid)) { ret false; }
    val found: opt[*type.Type] = type.get(w.types, tid);
    if (!sel found.some) {
        fail.internal(w.status, "type walk: the store holds no such type id");
        ret false;
    }
    if (w.once && !entered[C](w, tid)) { ret false; }
    val t:       *type.Type = found.some;
    val verdict: Verdict    = w.leaf(w.ctx, tid, t);
    if (verdict == FOUND) { ret true; }
    if (verdict == PRUNE) { ret false; }
    pend_children[C](w, work, tid, t);
    ret false;
}

fun follows[C](w: *Walk[C], e: Edges) bool {
    ret (w.edges & e) != 0;
}

fun pend_children[C](w: *Walk[C], work: *Vector[Pending], tid: type.TypeId, t: *type.Type) {
    val k: type.TypeKind = t.kind;
    if (k == type.TYPE_SECRET && follows[C](w, EDGE_BASE))     { pend[C](w, work, Pending{kind: PENDING_TYPE, ty: t.data.secret.base}); }
    if (k == type.TYPE_ARRAY && follows[C](w, EDGE_ELEMENT))   { pend[C](w, work, Pending{kind: PENDING_TYPE, ty: t.data.array.base}); }
    if (k == type.TYPE_POINTER && follows[C](w, EDGE_POINTEE)) { pend[C](w, work, Pending{kind: PENDING_TYPE, ty: t.data.pointer.base}); }
    if (k == type.TYPE_FUN && follows[C](w, EDGE_SIGNATURE)) {
        if (!pend_params[C](w, work, t.data.fn.params_start, t.data.fn.params_len)) { ret; }
        pend[C](w, work, Pending{kind: PENDING_TYPE, ty: t.data.fn.ret_type});
    }
    if (k == type.TYPE_INSTANCE) {
        val by_args:   bool = follows[C](w, EDGE_ARGUMENT);
        val by_decl:   bool = follows[C](w, EDGE_DECLARATION);
        val by_fields: bool = follows[C](w, EDGE_INSTANCE_FIELD);
        if (!by_args && !by_decl && !by_fields)                                                     { ret; }
        if (!w.once && !entered[C](w, tid))                                                         { ret; }
        if (by_fields && !pend[C](w, work, Pending{kind: PENDING_FIELDS, ty: tid}))                 { ret; }
        if (by_decl && !pend[C](w, work, Pending{kind: PENDING_TYPE, ty: t.data.instance.nominal})) { ret; }
        if (by_args)                                                                                { pend_params[C](w, work, t.data.instance.args_start, t.data.instance.args_len); }
    }
    if ((k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_TAG) && follows[C](w, EDGE_FIELD)) {
        if (!w.once && !entered[C](w, tid)) { ret; }
        pend[C](w, work, Pending{kind: PENDING_FIELDS, ty: tid});
    }
}

# whether this is the first time the walk enters aggregate `tid`
fun entered[C](w: *Walk[C], tid: type.TypeId) bool {
    if (w.scan == nil) { ret true; }
    val mark: res[type.VisitMark, fail.Fail] = type.type_scan_mark(w.types, w.scan, tid);
    if (sel mark.err) {
        fail.internal(w.status, fail.describe(mark.err));
        ret false;
    }
    ret mark.ok == type.VISIT_FRESH;
}
