# one walk over the type graph: a property is a leaf predicate, and the walk follows
# the edges the property names from a type to the types it is built from. an aggregate is
# entered once per scan, and a type id the store does not hold is an internal failure
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;

use mach.lang.fail;
use mach.lang.type;

pub def Edges: u8;

# a secret's base
pub val EDGE_BASE: Edges = 1;
# an array's element
pub val EDGE_ELEMENT: Edges = 2;
pub val EDGE_POINTEE: Edges = 4;
# a function's return, then its parameters
pub val EDGE_SIGNATURE: Edges = 8;
# an instance's arguments
pub val EDGE_ARGUMENT: Edges = 16;
# the generic declaration an instance instantiates
pub val EDGE_DECLARATION: Edges = 32;
# a record's, union's or tag's declared fields
pub val EDGE_FIELD: Edges = 64;
# an instance's own fields, from the table built for it
val EDGE_INSTANCE_FIELD: Edges = 128;

# what a value holds in its own storage
pub val EDGES_VALUE: Edges = EDGE_BASE | EDGE_ELEMENT | EDGE_FIELD | EDGE_INSTANCE_FIELD;
# every type a type is spelled from, through pointers and signatures included
pub val EDGES_SPELLING: Edges = EDGE_BASE | EDGE_ELEMENT | EDGE_POINTEE | EDGE_SIGNATURE | EDGE_ARGUMENT;

# what a leaf predicate says of one type
pub def Verdict: u8;

# the property may lie below: follow the edges
pub val DESCEND: Verdict = 0;
# the property is not here and not below
pub val PRUNE: Verdict = 1;
# the property is here, which ends the walk
pub val FOUND: Verdict = 2;

pub rec Walk[C] {
    types:  *type.TypeInterner;
    status: *fail.PhaseStatus;
    # the aggregates already entered; nil enters each every time it is met
    scan:  *type.TypeScan;
    edges: Edges;
    ctx:   *C;
    leaf:  fun(*C, type.TypeId, *type.Type) Verdict;
}

# whether the property holds at `tid` or below it; false once the walk has failed
pub fun reaches[C](w: *Walk[C], tid: type.TypeId) bool {
    if (type.is_nil(tid) || type.is_error(tid)) { ret false; }
    if (sel w.status.kind.internal)             { ret false; }
    val found: opt[*type.Type] = type.get(w.types, tid);
    if (!sel found.some) {
        fail.internal(w.status, "type walk: the store holds no such type id");
        ret false;
    }
    val t:       *type.Type = found.some;
    val verdict: Verdict    = w.leaf(w.ctx, tid, t);
    if (verdict == FOUND) { ret true; }
    if (verdict == PRUNE) { ret false; }
    ret children_reach[C](w, tid, t);
}

fun follows[C](w: *Walk[C], e: Edges) bool {
    ret (w.edges & e) != 0;
}

fun children_reach[C](w: *Walk[C], tid: type.TypeId, t: *type.Type) bool {
    val k: type.TypeKind = t.kind;
    if (k == type.TYPE_SECRET && follows[C](w, EDGE_BASE))     { ret reaches[C](w, t.data.secret.base); }
    if (k == type.TYPE_ARRAY && follows[C](w, EDGE_ELEMENT))   { ret reaches[C](w, t.data.array.base); }
    if (k == type.TYPE_POINTER && follows[C](w, EDGE_POINTEE)) { ret reaches[C](w, t.data.pointer.base); }
    if (k == type.TYPE_FUN && follows[C](w, EDGE_SIGNATURE)) {
        if (reaches[C](w, t.data.fn.ret_type)) { ret true; }
        ret params_reach[C](w, t.data.fn.params_start, t.data.fn.params_len);
    }
    if (k == type.TYPE_INSTANCE) {
        val by_args:   bool = follows[C](w, EDGE_ARGUMENT);
        val by_decl:   bool = follows[C](w, EDGE_DECLARATION);
        val by_fields: bool = follows[C](w, EDGE_INSTANCE_FIELD);
        if (!by_args && !by_decl && !by_fields)                                                  { ret false; }
        if (!entered[C](w, tid))                                                                 { ret false; }
        if (by_args && params_reach[C](w, t.data.instance.args_start, t.data.instance.args_len)) { ret true; }
        if (by_decl && reaches[C](w, t.data.instance.nominal))                                   { ret true; }
        if (by_fields)                                                                           { ret fields_reach[C](w, tid); }
        ret false;
    }
    if ((k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_TAG) && follows[C](w, EDGE_FIELD)) {
        if (!entered[C](w, tid)) { ret false; }
        ret fields_reach[C](w, tid);
    }
    ret false;
}

# whether this is the first time the walk enters aggregate `tid`
fun entered[C](w: *Walk[C], tid: type.TypeId) bool {
    if (w.scan == nil) { ret true; }
    val mark: res[type.VisitMark, fail.Fail] = type.type_scan_mark(w.types, w.scan, tid);
    if (sel mark.err) {
        fail.internal(w.status, fail.describe(mark.err));
        ret false;
    }
    ret mark.ok == type.VISIT_FRESH;
}

fun params_reach[C](w: *Walk[C], start: u32, len: u32) bool {
    var i: u32 = 0;
    for (i < len) {
        val p: opt[type.TypeId] = type.get_param(w.types, start + i);
        if (!sel p.some) {
            fail.internal(w.status, "type walk: a parameter list runs past the store");
            ret false;
        }
        if (reaches[C](w, p.some)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun fields_reach[C](w: *Walk[C], tid: type.TypeId) bool {
    val table: opt[*type.FieldTable] = type.field_table_for(w.types, tid);
    if (!sel table.some) {
        fail.internal(w.status, "type walk: an aggregate it entered has no field table");
        ret false;
    }
    val n: u32 = table.some.fields_len;
    var f: u32 = 0;
    for (f < n) {
        val entry: opt[*type.FieldEntry] = type.field_at(w.types, tid, f);
        if (!sel entry.some) {
            fail.internal(w.status, "type walk: a field table is shorter than it says");
            ret false;
        }
        if (reaches[C](w, entry.some.ty)) { ret true; }
        f = f + 1;
    }
    ret false;
}
