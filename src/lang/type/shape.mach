# the mirl shape of a source type: the one place mach decides how a type is held in mirl's
# type table, which lowering interns into its module's table and sema into the table it lays
# types out over, so the size sema answers and the type codegen builds cannot disagree
#
# a record or union is its fields in order at the alignment and packing it declares, a tag
# its discriminator then the union of its cases' payloads, an opaque abi type a structure of
# its bytes at its alignment. what reaching a member type means, substitution, a memo, a
# cycle on the path, is the caller's, through `Reach`
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.collections.slice.Slice;

use types: mirl.ir.type;
use mirl.ir.type.Type;

use mach.lang.type;
use type_field: mach.lang.type.field;
use type_kind:  mach.lang.type.kind;
use type_prim:  mach.lang.type.prim;

# why a source type has no shape
# ---
# member:        reaching a member type refused it, the caller's reason held by its context
# unknown:       a kind that has no shape: a type parameter, a pack, an unresolved nominal
# empty_tag:     a tag with no cases
# discriminator: a tag with no discriminator type
# table:         mirl's type table refused a type
# alloc:         no storage for a member list
pub tag Unshaped: u8 {
    member;
    unknown;
    empty_tag;
    discriminator;
    table: types.Error;
    alloc: A.Error;
}

# how a caller reaches what the shape of a type is made of
# ---
# ctx:     the caller's context
# member:  the type of a member, element or payload, interned in the same table, none when
#          the caller refuses it with a reason it holds
# handle:  the type of a target handle
# pointer: the type a pointer is held in
pub rec Reach[T] {
    ctx:     *T;
    member:  fun(*T, type_kind.TypeId) opt[Type];
    handle:  fun(*T, *type.Type) opt[Type];
    pointer: Type;
}

fun interned(t: *types.Table, s: types.Shape) res[Type, Unshaped] {
    val r: res[Type, types.Error] = types.intern(t, s);
    if (sel r.err) { ret res[Type, Unshaped].err{Unshaped.table{r.err}}; }
    ret res[Type, Unshaped].ok{r.ok};
}

fun stated(align: u32) opt[u64] {
    if (align == 0) { ret opt[u64].none{}; }
    ret opt[u64].some{align::u64};
}

# a signless integer of `bits`, rounded up to a width mirl holds
pub fun integer(t: *types.Table, bits: u32) res[Type, Unshaped] {
    var w: u32 = 1;
    if (bits > 1) {
        w = 8;
        for (w < bits) { w = w * 2; }
    }
    ret interned(t, types.Shape.integer{types.Integer{width: w}});
}

# the format of a float of `bits`, none for a width mirl has no format for
pub fun format(bits: u32) opt[types.Format] {
    if (bits == 16) { ret opt[types.Format].some{types.BINARY16}; }
    if (bits == 32) { ret opt[types.Format].some{types.BINARY32}; }
    if (bits == 64) { ret opt[types.Format].some{types.BINARY64}; }
    ret opt[types.Format].none{};
}

# an integer or float primitive
pub fun scalar(t: *types.Table, d: type_prim.PrimDesc) res[Type, Unshaped] {
    if (d.class == type_prim.PRIM_CLASS_FLOAT) {
        val f: opt[types.Format] = format(d.bits);
        if (sel f.none) { ret res[Type, Unshaped].err{Unshaped.unknown{}}; }
        ret interned(t, types.Shape.float{types.Float{format: f.some}});
    }
    ret integer(t, d.bits);
}

# an opaque type of `size` bytes at the alignment `align`
pub fun opaque(t: *types.Table, size: u32, align: u32) res[Type, Unshaped] {
    val byte: res[Type, Unshaped] = integer(t, 8);
    if (sel byte.err) { ret byte; }
    val bytes: res[Type, Unshaped] = interned(t, types.Shape.array{types.Array{count: size::u64, element: byte.ok, stride: opt[u64].none{}}});
    if (sel bytes.err) { ret bytes; }
    var member: Type = bytes.ok;
    ret interned(t, types.Shape.structure{types.Structure{members: Slice[Type]{data: ?member, size: 1}, offsets: opt[Slice[u64]].none{}, align: stated(align), packed: false}});
}

# the shape of the source type `tid`, its secrecy and its substitution already the caller's.
# a nil type is an empty structure
pub fun of[T](t: *types.Table, ti: *type.TypeInterner, tid: type_kind.TypeId, r: *Reach[T]) res[Type, Unshaped] {
    if (type_kind.is_nil(tid)) { ret interned(t, types.Shape.structure{types.Structure{members: Slice[Type]{data: nil, size: 0}, offsets: opt[Slice[u64]].none{}, align: opt[u64].none{}, packed: false}}); }
    val got: opt[*type.Type] = type.get(ti, tid);
    if (sel got.none) { ret res[Type, Unshaped].err{Unshaped.unknown{}}; }
    val ty: *type.Type         = got.some;
    val k:  type_kind.TypeKind = ty.kind;

    if (k == type_kind.TYPE_SECRET) { ret reached[T](r, ty.data.secret.base); }
    val d: type_prim.PrimDesc = type_prim.prim_desc(k);
    if (d.class == type_prim.PRIM_CLASS_INT || d.class == type_prim.PRIM_CLASS_FLOAT)                  { ret scalar(t, d); }
    if (d.class == type_prim.PRIM_CLASS_PTR || k == type_kind.TYPE_POINTER || k == type_kind.TYPE_FUN) { ret res[Type, Unshaped].ok{r.pointer}; }
    if (k == type_kind.TYPE_ARRAY) {
        val element: res[Type, Unshaped] = reached[T](r, ty.data.array.base);
        if (sel element.err) { ret element; }
        ret interned(t, types.Shape.array{types.Array{count: ty.data.array.count::u64, element: element.ok, stride: opt[u64].none{}}});
    }
    if (k == type_kind.TYPE_VECTOR) {
        val lane: res[Type, Unshaped] = scalar(t, type_prim.prim_desc(ty.data.vector.element));
        if (sel lane.err) { ret lane; }
        ret interned(t, types.Shape.vector{types.Vector{lanes: ty.data.vector.lanes, element: lane.ok}});
    }
    if (k == type_kind.TYPE_HANDLE) {
        val handle: fun(*T, *type.Type) opt[Type] = r.handle;
        val made:   opt[Type]                     = handle(r.ctx, ty);
        if (sel made.none) { ret res[Type, Unshaped].err{Unshaped.member{}}; }
        ret res[Type, Unshaped].ok{made.some};
    }
    if (k == type_kind.TYPE_ABI) { ret opaque(t, ty.data.abi.size, ty.data.abi.align); }
    if (k == type_kind.TYPE_REC || k == type_kind.TYPE_UNI || k == type_kind.TYPE_TAG || k == type_kind.TYPE_INSTANCE) {
        val table: opt[*type_field.Table] = type.field_table_for(ti, tid);
        if (sel table.none)          { ret res[Type, Unshaped].err{Unshaped.unknown{}}; }
        if (type.is_tag(ti, tid))    { ret tagged[T](t, ti, tid, r); }
        if (type.is_union(ti, tid))  { ret nominal[T](t, ti, tid, r, true); }
        if (type.is_record(ti, tid)) { ret nominal[T](t, ti, tid, r, false); }
    }
    ret res[Type, Unshaped].err{Unshaped.unknown{}};
}

fun reached[T](r: *Reach[T], tid: type_kind.TypeId) res[Type, Unshaped] {
    val member: fun(*T, type_kind.TypeId) opt[Type] = r.member;
    val made:   opt[Type]                           = member(r.ctx, tid);
    if (sel made.none) { ret res[Type, Unshaped].err{Unshaped.member{}}; }
    ret res[Type, Unshaped].ok{made.some};
}

# the types of the fields of `tid` in order onto `out`, a tag's caseless cases skipped
fun members[T](ti: *type.TypeInterner, tid: type_kind.TypeId, r: *Reach[T], payloads: bool, out: *Type, len: *u32) err[Unshaped] {
    val n: u32 = type.field_count(ti, tid);
    var i: u32 = 0;
    for (i < n) {
        val fe: opt[*type_field.Entry] = type.field_at(ti, tid, i);
        i = i + 1;
        if (sel fe.none)                              { ret err[Unshaped].err{Unshaped.unknown{}}; }
        if (payloads && type_kind.is_nil(fe.some.ty)) { cnt; }
        val m: res[Type, Unshaped] = reached[T](r, fe.some.ty);
        if (sel m.err) { ret err[Unshaped].err{m.err}; }
        out[@len] = m.ok;
        @len      = @len + 1;
    }
    ret err[Unshaped].ok{};
}

# a record or union: its fields in order, at the alignment and packing it declares
fun nominal[T](t: *types.Table, ti: *type.TypeInterner, tid: type_kind.TypeId, r: *Reach[T], overlaid: bool) res[Type, Unshaped] {
    val dec:  type_field.Decoration = type.decoration_of(ti, tid);
    val n:    usize                 = type.field_count(ti, tid)::usize + 1;
    val held: res[*Type, A.Error]   = A.allocate[Type](ti.a, n);
    if (sel held.err) { ret res[Type, Unshaped].err{Unshaped.alloc{held.err}}; }
    val buf: *Type = held.ok;
    fin { A.deallocate[Type](ti.a, buf, n); }
    var len:    u32           = 0;
    val walked: err[Unshaped] = members[T](ti, tid, r, false, buf, ?len);
    if (sel walked.err) { ret res[Type, Unshaped].err{walked.err}; }
    val list: Slice[Type] = Slice[Type]{data: buf, size: len::usize};
    if (overlaid) { ret interned(t, types.Shape.union{types.Union{members: list, align: stated(dec.align), packed: dec.packed}}); }
    ret interned(t, types.Shape.structure{types.Structure{members: list, offsets: opt[Slice[u64]].none{}, align: stated(dec.align), packed: dec.packed}});
}

# a tag: its discriminator, then the union of its cases' payloads where any case holds one,
# at the alignment and packing it declares
fun tagged[T](t: *types.Table, ti: *type.TypeInterner, tid: type_kind.TypeId, r: *Reach[T]) res[Type, Unshaped] {
    val bytes: u32 = type.tag_discriminator_bytes(ti, tid);
    if (bytes == 0) { ret res[Type, Unshaped].err{Unshaped.discriminator{}}; }
    val cases: u32 = type.field_count(ti, tid);
    if (cases == 0) { ret res[Type, Unshaped].err{Unshaped.empty_tag{}}; }
    val disc: res[Type, Unshaped] = integer(t, bytes * 8);
    if (sel disc.err) { ret disc; }

    val held: res[*Type, A.Error] = A.allocate[Type](ti.a, cases::usize);
    if (sel held.err) { ret res[Type, Unshaped].err{Unshaped.alloc{held.err}}; }
    val buf: *Type = held.ok;
    fin { A.deallocate[Type](ti.a, buf, cases::usize); }
    var len:    u32           = 0;
    val walked: err[Unshaped] = members[T](ti, tid, r, true, buf, ?len);
    if (sel walked.err) { ret res[Type, Unshaped].err{walked.err}; }

    val dec:   type_field.Decoration = type.decoration_of(ti, tid);
    var parts: [2]Type;
    parts[0] = disc.ok;
    var count: usize = 1;
    if (len > 0) {
        val payload: res[Type, Unshaped] = interned(t, types.Shape.union{types.Union{members: Slice[Type]{data: buf, size: len::usize}, align: opt[u64].none{}, packed: dec.packed}});
        if (sel payload.err) { ret payload; }
        parts[1] = payload.ok;
        count    = 2;
    }
    ret interned(t, types.Shape.structure{types.Structure{members: Slice[Type]{data: ?parts[0], size: count}, offsets: opt[Slice[u64]].none{}, align: stated(dec.align), packed: dec.packed}});
}
