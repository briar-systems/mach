test "mach.lang.manifest.manifest_remove_dep_table:removes_the_table_keeps_the_preceding_comment_and_sibling_bytes" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val r: R.Result[str, str] = manifest_remove_dep_table(?alloc, ut_messy_manifest(), "other");
    if (R.is_err[str, str](r)) { code = 1; }
    or {
        val out: str = R.unwrap_ok[str, str](r);
        if (str_contains(out, "[dep.other]")) { code = 1; }
        if (str_contains(out, "git = \"https://example.com/other.git\"")) { code = 1; }
        if (!str_contains(out, "# a hand-written dependency, with its own comment above it")) { code = 1; }
        if (!str_contains(out, "# top of file comment, must survive")) { code = 1; }
        if (!str_contains(out, "[target.linux]")) { code = 1; }
        if (!str_contains(out, "isa = \"x86_64\"")) { code = 1; }

        val tbl_r: R.Result[toml.Table, str] = toml.parse(?alloc, out);
        if (R.is_err[toml.Table, str](tbl_r)) { code = 1; }
        or {
            var tbl: toml.Table = R.unwrap_ok[toml.Table, str](tbl_r);
            if (toml.get_table(?tbl, "dep") != nil && toml.table_len(toml.get_table(?tbl, "dep")) != 0) { code = 1; }
            toml.dnit(?alloc, ?tbl);
        }
    }

    arena.dnit(?ar);
    ret code;
}

