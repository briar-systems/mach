# the file name of a project manifest, looked up in a project root
pub val MANIFEST_FILE: str = "mach.toml";

# the public entry a bare `use <id>;` binds: the one `entry` shared by every
# library artifact marked `default = true`. a `bin` never publishes an entry
# ---
# m:   a parsed manifest
# ret: the shared entry id; STR_NIL when no library artifact is a default or two
#      default library artifacts name different entries
pub fun canonical_module(m: *Manifest) intern.StrId {
    var entry: intern.StrId = intern.STR_NIL;
    var i:     u32          = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        if (a.is_lib && a.is_default) {
            if (entry == intern.STR_NIL) { entry = a.entry; }
            or (a.entry != entry)        { ret intern.STR_NIL; }
        }
        i = i + 1;
    }
    ret entry;
}

test "mach.lang.manifest.canonical_module:binds_the_entry_shared_by_default_library_artifacts" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val head:   str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    var cases:  [8]str;
    var public: [8]bool;
    cases[0]  = "";
    public[0] = false;
    cases[1]  = "[artifact.a]\nkind=\"static\"\nentry=\"api.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    public[1] = false;
    cases[2]  = "[artifact.a]\nkind=\"bin\"\ndefault=true\nentry=\"api.mach\"\nout=\"bin/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    public[2] = false;
    cases[3]  = "[artifact.a]\nkind=\"static\"\ndefault=true\nentry=\"api.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[artifact.b]\nkind=\"bin\"\ndefault=true\nentry=\"main.mach\"\nout=\"bin/b\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    public[3] = true;
    cases[4]  = "[artifact.a]\nkind=\"shared\"\ndefault=true\nentry=\"api.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    public[4] = true;
    cases[5]  = "[artifact.a]\nkind=\"static\"\ndefault=true\nentry=\"api.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[artifact.b]\nkind=\"shared\"\ndefault=true\nentry=\"api.mach\"\nout=\"lib/b\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    public[5] = true;
    cases[6]  = "[artifact.a]\nkind=\"static\"\ndefault=true\nentry=\"api.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[artifact.b]\nkind=\"shared\"\ndefault=true\nentry=\"other.mach\"\nout=\"lib/b\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    public[6] = false;
    cases[7]  = "[artifact.z]\nkind=\"static\"\nentry=\"other.mach\"\nout=\"lib/z\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[artifact.a]\nkind=\"static\"\ndefault=true\nentry=\"api.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    public[7] = true;
    var i: usize = 0;
    for (i < 8) {
        val parsed: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}{}", head, cases[i]));
        if (sel parsed.err) { ret 2; }
        var m:     Manifest     = parsed.ok;
        val entry: intern.StrId = canonical_module(?m);
        if (!public[i]) {
            if (entry != intern.STR_NIL) { ret 3; }
        }
        or {
            val text: opt[str] = intern.lookup(?itn, entry);
            if (sel text.none)                      { ret 4; }
            if (!str_equals(text.some, "api.mach")) { ret 4; }
        }
        i = i + 1;
    }
    ret 0;
}
