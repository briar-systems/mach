    if (R.is_ok[Manifest, str](a) || !str_equals(R.unwrap_err[Manifest, str](a), "mach.toml: [target.native] is reserved; 'native' resolves to a declared target")) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:dep_conflict" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val a: R.Result[Manifest, str] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[dep.std]\nversion=\"1.0\"\n");
    if (R.is_ok[Manifest, str](a) || !str_equals(R.unwrap_err[Manifest, str](a), "mach.toml: [dep.std].version is reserved for the registry era")) { code = 1; }

    val b: R.Result[Manifest, str] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[dep.std]\ngit=\"u\"\npath=\"p\"\n");
    if (R.is_ok[Manifest, str](b) || !str_equals(R.unwrap_err[Manifest, str](b), "mach.toml: [dep.std] needs exactly one source key: 'git' or 'path'")) { code = 1; }

    val missing_ref: R.Result[Manifest, str] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\n");
    if (R.is_ok[Manifest, str](missing_ref) || !str_contains(R.unwrap_err[Manifest, str](missing_ref), "missing required key 'ref'")) { code = 1; }

    val path_ref: R.Result[Manifest, str] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\npath=\"../std\"\nref=\"branch/main\"\n");
    if (R.is_ok[Manifest, str](path_ref) || !str_contains(R.unwrap_err[Manifest, str](path_ref), "not allowed for path sources")) { code = 1; }

    val raw_ref: R.Result[Manifest, str] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"main\"\n");
    if (R.is_ok[Manifest, str](raw_ref) || !str_contains(R.unwrap_err[Manifest, str](raw_ref), "branch/<name>")) { code = 1; }

    val short_commit: R.Result[Manifest, str] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"commit/01234567\"\n");
    if (R.is_ok[Manifest, str](short_commit) || !str_contains(R.unwrap_err[Manifest, str](short_commit), "full-object-id")) { code = 1; }

    val hidden_ref: R.Result[Manifest, str] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"branch/.hidden\"\n");
    if (R.is_ok[Manifest, str](hidden_ref)) { code = 1; }

    val lock_ref: R.Result[Manifest, str] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"tag/release.lock\"\n");
    if (R.is_ok[Manifest, str](lock_ref)) { code = 1; }

    val uppercase_commit: R.Result[Manifest, str] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"commit/0123456789ABCDEF0123456789ABCDEF01234567\"\n");
    if (R.is_ok[Manifest, str](uppercase_commit)) { code = 1; }

    val prefixed: R.Result[Manifest, str] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"branch/main\"\n");
    if (R.is_err[Manifest, str](prefixed)) { code = 1; }

    val full_commit: R.Result[Manifest, str] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"commit/0123456789abcdef0123456789abcdef01234567\"\n");
    if (R.is_err[Manifest, str](full_commit)) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.canonical_module:requires_one_unambiguous_entry" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val different: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[artifact.z]\nkind=\"static\"\nentry=\"z.mach\"\nout=\"lib/z\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[artifact.a]\nkind=\"static\"\nentry=\"a.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n"));
    if (R.is_err[Manifest, str](different)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](different);
        if (canonical_module(?m) != intern.STR_NIL) { code = 1; }
    }

    val same: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[artifact.z]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/z\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[artifact.a]\nkind=\"shared\"\nentry=\"lib.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n"));
    if (R.is_err[Manifest, str](same)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](same);
        val module_opt: O.Option[str] = intern.lookup(?itn, canonical_module(?m));
        if (O.is_none[str](module_opt) || !str_equals(O.unwrap[str](module_opt), "lib.mach")) { code = 1; }
    }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:dependency_name_is_portable" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    val src: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[dep.\"../escape\"]\npath=\"../lib\"\n";
    val parsed: R.Result[Manifest, str] = tparse(?alloc, ?itn, src);
    val failed: bool = R.is_err[Manifest, str](parsed)
        && str_contains(R.unwrap_err[Manifest, str](parsed), "dependency name '../escape' must be a portable identifier");
    arena.dnit(?ar);
    if (!failed) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.parse:selection_names_are_portable" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val project: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";

    val target: R.Result[Manifest, str] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}[target.\"../escape\"]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n", project));
    if (R.is_ok[Manifest, str](target) || !str_contains(R.unwrap_err[Manifest, str](target), "target name '../escape' must be a portable identifier")) { code = 1; }

    val artifact: R.Result[Manifest, str] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}[artifact.\"../escape\"]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\n", project));
    if (R.is_ok[Manifest, str](artifact) || !str_contains(R.unwrap_err[Manifest, str](artifact), "artifact name '../escape' must be a portable identifier")) { code = 1; }

    val profile: R.Result[Manifest, str] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}[profile.\"../escape\"]\n", project));
    if (R.is_ok[Manifest, str](profile) || !str_contains(R.unwrap_err[Manifest, str](profile), "profile name '../escape' must be a portable identifier")) { code = 1; }

    val link: R.Result[Manifest, str] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}[link.\"../escape\"]\nsource=\"local\"\npath=\"obj/a.o\"\n", project));
    if (R.is_ok[Manifest, str](link) || !str_contains(R.unwrap_err[Manifest, str](link), "link name '../escape' must be a portable identifier")) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

