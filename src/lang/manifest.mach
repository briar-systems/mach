test "mach.lang.manifest.select_primary_artifact:several_candidates_need_exactly_one_default_and_order_is_meaningless" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n";
    val first: str = "[artifact.first]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/first\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\n";
    val second_default: str = "[artifact.second]\nkind=\"bin\"\nentry=\"b.mach\"\nout=\"bin/second\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\ndefault=true\n";
    val second_plain: str = "[artifact.second]\nkind=\"bin\"\nentry=\"b.mach\"\nout=\"bin/second\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\n";
    val first_default: str = "[artifact.first]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/first\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\ndefault=true\n";

    val dr: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, first, second_default));
    if (R.is_err[Manifest, str](dr)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](dr);
        var primary: Selection = mk_sel("linux", "", "", false, false);
        if (R.is_err[R.Void, str](select_primary_artifact(?alloc, ?itn, ?m, ?primary))
            || !primary.has_artifact || !str_equals(primary.artifact, "second")) { code = 1; }
        var sole: Selection = mk_sel("linux", "", "", false, false);
        if (R.is_err[R.Void, str](select_sole_target_artifact(?alloc, ?itn, ?m, ?sole))
            || !sole.has_artifact || !str_equals(sole.artifact, "second")) { code = 1; }
        var exe: Selection = mk_sel("linux", "", "", false, false);
        if (R.is_err[R.Void, str](select_sole_executable_artifact(?alloc, ?itn, ?m, ?exe))
            || !exe.has_artifact || !str_equals(exe.artifact, "second")) { code = 1; }
        var explicit: Selection = mk_sel("linux", "", "first", false, true);
        if (R.is_err[R.Void, str](select_primary_artifact(?alloc, ?itn, ?m, ?explicit))
            || !str_equals(explicit.artifact, "first")) { code = 1; }
    }

    val nr: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, first, second_plain));
    if (R.is_err[Manifest, str](nr)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](nr);
        var primary: Selection = mk_sel("linux", "", "", false, false);
        val pr: R.Result[R.Void, str] = select_primary_artifact(?alloc, ?itn, ?m, ?primary);
        if (R.is_err[R.Void, str](pr) || !primary.has_artifact
            || !str_equals(primary.artifact, "first") || !primary.legacy_default) { code = 1; }
        var sole: Selection = mk_sel("linux", "", "", false, false);
        if (R.is_err[R.Void, str](select_sole_target_artifact(?alloc, ?itn, ?m, ?sole)) || sole.has_artifact || sole.legacy_default) { code = 1; }
    }

    val tr: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, first_default, second_default));
    if (R.is_err[Manifest, str](tr)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](tr);
        var primary: Selection = mk_sel("linux", "", "", false, false);
        val pr: R.Result[R.Void, str] = select_primary_artifact(?alloc, ?itn, ?m, ?primary);
        if (R.is_ok[R.Void, str](pr) || primary.has_artifact
            || !str_contains(R.unwrap_err[R.Void, str](pr), "exactly one")) { code = 1; }
    }

    val br: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[artifact.bad]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/bad\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\ndefault=\"yes\"\n"));
    if (R.is_ok[Manifest, str](br) || !str_contains(R.unwrap_err[Manifest, str](br), "default must be a boolean")) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_target:native_without_a_host_match_uses_the_sole_or_default_declaration_never_table_order" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val art: str = "[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    var foreign_os: str = "windows";
    var foreign_abi: str = "win64";
    $if ($mach.build.os == $mach.os.windows) {
        foreign_os = "linux";
        foreign_abi = "sysv64";
    }
    val w1: str = sfmt(?alloc, "[target.w1]\nisa=\"x86_64\"\nos=\"{}\"\nabi=\"{}\"\n", foreign_os, foreign_abi);
    val w2: str = sfmt(?alloc, "[target.w2]\nisa=\"x86_64\"\nos=\"{}\"\nabi=\"{}\"\n", foreign_os, foreign_abi);
    val w2_default: str = sfmt(?alloc, "{}default=true\n", w2);
    val w1_default: str = sfmt(?alloc, "{}default=true\n", w1);
    val native: Selection = mk_sel("native", "", "", false, false);

    val sr: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, w1, art));
    if (R.is_err[Manifest, str](sr)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](sr);
        val u: R.Result[BuildUnit, str] = resolve_build_unit(?alloc, ?itn, ?m, native);
        if (R.is_err[BuildUnit, str](u)) { code = 1; }
        or {
            val bu: BuildUnit = R.unwrap_ok[BuildUnit, str](u);
            if (!bu.warned || bu.legacy_target_default || !str_equals(idstr(?itn, bu.target_name), "w1")) { code = 1; }
        }
    }

    val nr: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}{}", head, w1, w2, art));
    if (R.is_err[Manifest, str](nr)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](nr);
        val u: R.Result[BuildUnit, str] = resolve_build_unit(?alloc, ?itn, ?m, native);
        if (R.is_err[BuildUnit, str](u)) { code = 1; }
        or {
            val bu: BuildUnit = R.unwrap_ok[BuildUnit, str](u);
            if (!bu.warned || !bu.legacy_target_default || !str_equals(idstr(?itn, bu.target_name), "w1")) { code = 1; }
        }
    }

    val dr: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}{}", head, w1, w2_default, art));
    if (R.is_err[Manifest, str](dr)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](dr);
        val u: R.Result[BuildUnit, str] = resolve_build_unit(?alloc, ?itn, ?m, native);
        if (R.is_err[BuildUnit, str](u)) { code = 1; }
        or {
            val bu: BuildUnit = R.unwrap_ok[BuildUnit, str](u);
            if (!bu.warned || bu.legacy_target_default || !str_equals(idstr(?itn, bu.target_name), "w2")) { code = 1; }
        }
        val e: R.Result[BuildUnit, str] = resolve_build_unit(?alloc, ?itn, ?m, mk_sel("w1", "", "", false, false));
        if (R.is_err[BuildUnit, str](e) || !str_equals(idstr(?itn, R.unwrap_ok[BuildUnit, str](e).target_name), "w1")) { code = 1; }
    }

    val tr: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}{}", head, w1_default, w2_default, art));
    if (R.is_ok[Manifest, str](tr) || !str_contains(R.unwrap_err[Manifest, str](tr), "exactly one")) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:several_targets_or_profiles_marked_default_are_refused_naming_each_table" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val art: str = "[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    val lx: str = "[target.lx]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\ndefault=true\n";
    val mac: str = "[target.mac]\nisa=\"x86_64\"\nos=\"darwin\"\nabi=\"sysv64\"\ndefault=true\n";
    val win: str = "[target.win]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n";

    val two: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}{}{}", head, lx, win, mac, art));
    if (R.is_ok[Manifest, str](two)) { code = 1; }
    or {
        val msg: str = R.unwrap_err[Manifest, str](two);
        if (!str_contains(msg, "2 targets declare `default = true` ([target.lx], [target.mac])")
            || str_contains(msg, "[target.win]") || !str_contains(msg, "exactly one is allowed")) { code = 1; }
    }

    val one: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}{}", head, lx, win, art));
    if (R.is_err[Manifest, str](one)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](one);
        if (m.target_count != 2 || !m.targets[0].is_default || m.targets[1].is_default) { code = 1; }
    }

    val lenient: R.Result[Manifest, str] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}{}{}{}{}", head, lx, win, mac, art));
    if (R.is_err[Manifest, str](lenient)) { code = 1; }

    val pa: str = "[profile.fast]\ndefault=true\nopt=2\ndebug=false\nsimd=\"scalarize\"\n";
    val pb: str = "[profile.slow]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\n";
    val profiles: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}{}{}", head, lx, art, pa, pb));
    if (R.is_ok[Manifest, str](profiles)) { code = 1; }
    or {
        val msg: str = R.unwrap_err[Manifest, str](profiles);
        if (!str_contains(msg, "2 profiles declare `default = true` ([profile.fast], [profile.slow])")
            || !str_contains(msg, "exactly one is allowed")) { code = 1; }
    }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_profile:several_profiles_without_a_default_take_the_first_declared_and_say_so" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val two: str = "[profile.fast]\nopt=2\ndebug=false\nsimd=\"scalarize\"\n[profile.slow]\nopt=0\ndebug=true\nsimd=\"scalarize\"\n";
    val two_default: str = "[profile.fast]\nopt=2\ndebug=false\nsimd=\"scalarize\"\n[profile.slow]\nopt=0\ndebug=true\nsimd=\"scalarize\"\ndefault=true\n";
    val lr: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, two));
    if (R.is_err[Manifest, str](lr)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](lr);
        val pr: R.Result[ResolvedProfile, str] = resolve_profile(?alloc, ?itn, ?m, "");
        if (R.is_err[ResolvedProfile, str](pr)) { code = 1; }
        or {
            val rp: ResolvedProfile = R.unwrap_ok[ResolvedProfile, str](pr);
            if (!rp.legacy_default || !str_equals(idstr(?itn, rp.name), "fast")) { code = 1; }
        }
        val ex: R.Result[ResolvedProfile, str] = resolve_profile(?alloc, ?itn, ?m, "slow");
        if (R.is_err[ResolvedProfile, str](ex) || R.unwrap_ok[ResolvedProfile, str](ex).legacy_default) { code = 1; }
    }
    val dr: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, two_default));
    if (R.is_err[Manifest, str](dr)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](dr);
        val pr: R.Result[ResolvedProfile, str] = resolve_profile(?alloc, ?itn, ?m, "");
        if (R.is_err[ResolvedProfile, str](pr)) { code = 1; }
        or {
            val rp: ResolvedProfile = R.unwrap_ok[ResolvedProfile, str](pr);
            if (rp.legacy_default || !str_equals(idstr(?itn, rp.name), "slow")) { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:unknown_top_level_table_or_key_is_rejected" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n";
    val a: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[bogus_top_level_table]\nk = 1\n"));
    if (R.is_ok[Manifest, str](a) || !str_equals(R.unwrap_err[Manifest, str](a), "mach.toml: unknown table or key 'bogus_top_level_table' at the document root")) { code = 1; }
    val b: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", "stray = true\n", head));
    if (R.is_ok[Manifest, str](b) || !str_equals(R.unwrap_err[Manifest, str](b), "mach.toml: unknown table or key 'stray' at the document root")) { code = 1; }
    val c: R.Result[Manifest, str] = tparse(?alloc, ?itn, head);
    if (R.is_err[Manifest, str](c)) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:env_is_a_target_key_carried_verbatim" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val art: str = "[artifact.k]\nkind=\"bin\"\nentry=\"k.mach\"\nout=\"k.spv\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    val gpu: str = "[target.gpu]\nisa=\"spirv\"\nos=\"freestanding\"\nabi=\"spirv\"\nenv=\"vulkan1.2\"\n";
    val r: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, gpu, art));
    if (R.is_err[Manifest, str](r)) { code = 1; }
    or {
        val m: Manifest = R.unwrap_ok[Manifest, str](r);
        if (m.target_count != 1 || !str_equals(idstr(?itn, m.targets[0].env), "vulkan1.2")) { code = 1; }
    }
    val plain: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, "[target.gpu]\nisa=\"spirv\"\nos=\"freestanding\"\nabi=\"spirv\"\n", art));
    if (R.is_err[Manifest, str](plain) || R.unwrap_ok[Manifest, str](plain).targets[0].env != intern.STR_NIL) { code = 1; }
    val bad: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, "[target.gpu]\nisa=\"spirv\"\nos=\"freestanding\"\nabi=\"spirv\"\nenv=3\n", art));
    if (R.is_ok[Manifest, str](bad) || !str_contains(R.unwrap_err[Manifest, str](bad), "env must be a non-empty string")) { code = 1; }
    arena.dnit(?ar);
    ret code;
}


test "mach.lang.manifest.parse: Windows Unicode environment names cannot alias" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val source: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\n\"MACH_ÄΩ\"=\"first\"\n\"mach_äω\"=\"second\"\n";
    val parsed: R.Result[Manifest, str] = tparse(?alloc, ?itn, source);
    $if ($mach.build.os == $mach.os.windows) {
        if (R.is_ok[Manifest, str](parsed)) { ret 2; }
        if (!str_contains(R.unwrap_err[Manifest, str](parsed), "ambiguous keys")) { ret 3; }
    }
    $or {
        if (R.is_err[Manifest, str](parsed)) { ret 4; }
        val manifest: Manifest = R.unwrap_ok[Manifest, str](parsed);
        if (manifest.step_count != 1 || manifest.steps[0].env_count != 2) { ret 5; }
    }
    ret 0;
}


test "mach.lang.manifest: escaped TOML strings retain exact allocation ownership" {
    var large: [1025]u8;
    var i: usize = 0;
    for (i < 1024) { large[i] = 'x'; i = i + 1; }
    large[1024] = 0;
    var control: [3]u8;
    control[0] = 1;
    control[1] = 127;
    control[2] = 0;
    var inputs: [6]str;
    var expected: [6]str;
    inputs[0] = ""; expected[0] = "";
    inputs[1] = "x"; expected[1] = "x";
    inputs[2] = "\\\"\n\r\t\x08\x0c"; expected[2] = "\\\\\\\"\\n\\r\\t\\b\\f";
    inputs[3] = (?control[0])::str; expected[3] = "\\u0001\\u007f";
    inputs[4] = "ÄΩ"; expected[4] = "ÄΩ";
    inputs[5] = (?large[0])::str; expected[5] = (?large[0])::str;
    i = 0;
    for (i < 6) {
        var probe: PlanAllocProbe;
        var alloc: A.Allocator;
        if (!plan_probe_make(?probe, ?alloc, 0)) { ret 1; }
        val escaped: R.Result[str, str] = toml_escape_value(?alloc, inputs[i]);
        if (R.is_err[str, str](escaped)) { ret 2; }
        val text: str = R.unwrap_ok[str, str](escaped);
        val correct: bool = str_equals(text, expected[i]);
        str_free(?alloc, text);
        if (!correct || probe.live != 0 || probe.mismatch || probe.calls != 1) { ret 3; }
        if (!plan_probe_make(?probe, ?alloc, 1)) { ret 4; }
        val refused: R.Result[str, str] = toml_escape_value(?alloc, inputs[i]);
        if (R.is_ok[str, str](refused)) { str_free(?alloc, R.unwrap_ok[str, str](refused)); ret 5; }
        if (probe.live != 0 || probe.mismatch || probe.calls != 1) { ret 6; }
        i = i + 1;
    }
    ret 0;
}


test "mach.lang.manifest.native_owner:repeated_resolution_borrows_one_manifest_definition" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }
    var itn: intern.Interner = intern.init(?backing);
    fin { intern.dnit(?itn); }
    val table_r: R.Result[toml.Table, str] = toml.parse(?backing,
        "[project]\nid=\"owner\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n");
    if (R.is_err[toml.Table, str](table_r)) { ret 2; }
    var table: toml.Table = R.unwrap_ok[toml.Table, str](table_r);
    fin { toml.dnit(?backing, ?table); }
    var tracking: alloc_test.Testing;
    if (O.is_some[str](alloc_test.make(?tracking))) { ret 3; }
    fin { alloc_test.dnit(?tracking); }
    val parsed: R.Result[Manifest, str] = parse(?tracking.a, ?itn, ?table, true);
    if (R.is_err[Manifest, str](parsed)) { ret 4; }
    var m: Manifest = R.unwrap_ok[Manifest, str](parsed);
    fin { dnit(?m, ?tracking.a); }
    if (m.native_target == nil || m.targets != nil || m.target_count != 0) { ret 5; }
    val attempts: usize = tracking.attempts;
    tracking.fail_at = attempts + 1;
    var i: usize = 0;
    for (i < 32) {
        val resolved: R.Result[ResolvedTarget, str] = resolve_target(?tracking.a, ?itn, ?m, "native", nil);
        if (R.is_err[ResolvedTarget, str](resolved)) { ret 6; }
        val rt: ResolvedTarget = R.unwrap_ok[ResolvedTarget, str](resolved);
        if (rt.target != m.native_target || rt.warned || rt.legacy_default) { ret 7; }
        if (!target_matches_host(?itn, rt.target, tgt.host_os_id(), tgt.host_arch_id())) { ret 8; }
        i = i + 1;
    }
    if (tracking.attempts != attempts) { ret 9; }
    dnit(?m, ?tracking.a);
    dnit(?m, ?tracking.a);
    if (tracking.live != 0 || tracking.double_frees != 0 || tracking.exhausted != 0) { ret 10; }
    var ordinal: usize = 1;
    for (ordinal <= attempts) {
        tracking.attempts = 0;
        tracking.fail_at = ordinal;
        val failed: R.Result[Manifest, str] = parse(?tracking.a, ?itn, ?table, true);
        if (R.is_ok[Manifest, str](failed)) {
            var unexpected: Manifest = R.unwrap_ok[Manifest, str](failed);
            dnit(?unexpected, ?tracking.a);
            ret 11;
        }
        if (tracking.live != 0 || tracking.double_frees != 0 || tracking.exhausted != 0) { ret 12; }
        ordinal = ordinal + 1;
    }
    ret 0;
}

test "mach.lang.manifest.native_owner:interning_failure_never_publishes_a_partial_target" {
    var ordinal: usize = 0;
    var attempts: usize = 0;
    for (ordinal <= attempts) {
        var tracking: alloc_test.Testing;
        if (O.is_some[str](alloc_test.make(?tracking))) { ret 1; }
        var itn: intern.Interner = intern.init(?tracking.a);
        tracking.fail_at = ordinal;
        val result: R.Result[*TargetDef, str] = make_native_target(?tracking.a, ?itn);
        var valid: bool = ordinal == 0 && R.is_ok[*TargetDef, str](result);
        if (ordinal == 0) { attempts = tracking.attempts; }
        or { valid = R.is_err[*TargetDef, str](result); }
        if (R.is_ok[*TargetDef, str](result)) {
            A.deallocate[TargetDef](?tracking.a, R.unwrap_ok[*TargetDef, str](result), 1);
        }
        intern.dnit(?itn);
        val clean: bool = tracking.live == 0 && tracking.double_frees == 0 && tracking.exhausted == 0;
        alloc_test.dnit(?tracking);
        if (!valid) { ret 2; }
        if (!clean) { ret 3; }
        ordinal = ordinal + 1;
    }
    if (attempts < 5) { ret 4; }
    ret 0;
}

test "mach.lang.manifest.native_owner:early_parse_rejection_releases_recorded_keys" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }
    var itn: intern.Interner = intern.init(?backing);
    fin { intern.dnit(?itn); }
    val table_r: R.Result[toml.Table, str] = toml.parse(?backing, "[project]\nname=\"unused\"\n");
    if (R.is_err[toml.Table, str](table_r)) { ret 2; }
    var table: toml.Table = R.unwrap_ok[toml.Table, str](table_r);
    fin { toml.dnit(?backing, ?table); }
    var tracking: alloc_test.Testing;
    if (O.is_some[str](alloc_test.make(?tracking))) { ret 3; }
    fin { alloc_test.dnit(?tracking); }
    val parsed: R.Result[Manifest, str] = parse(?tracking.a, ?itn, ?table, true);
    if (R.is_ok[Manifest, str](parsed)) {
        var unexpected: Manifest = R.unwrap_ok[Manifest, str](parsed);
        dnit(?unexpected, ?tracking.a);
        ret 4;
    }
    if (!str_contains(R.unwrap_err[Manifest, str](parsed), "missing required key 'id'")) { ret 5; }
    if (tracking.total < 3 || tracking.live != 0 || tracking.double_frees != 0 || tracking.exhausted != 0) { ret 6; }
    ret 0;
}

test "mach.lang.manifest.expand_artifact_path:allocation_failure_is_internal_and_rejection_is_owned" {
    var t: alloc_test.Testing;
    if (O.is_some[str](alloc_test.make(?t))) { ret 1; }
    fin { alloc_test.dnit(?t); }
    val alloc: *A.Allocator = alloc_test.allocator_of(?t);
    var items: [1]ArtifactReq;
    items[0].name = "payload";
    items[0].out = "out/payload.bin";
    alloc_test.fail_at_ordinal(?t, alloc_test.attempt_count(?t) + 1);
    val valid: R.Result[str, TemplateError] = expand_artifact_path(alloc,
        "{artifact.payload.out}", ?items[0], 1, "embed");
    if (R.is_ok[str, TemplateError](valid)) { str_free(alloc, R.unwrap_ok[str, TemplateError](valid)); ret 2; }
    val valid_error: TemplateError = R.unwrap_err[str, TemplateError](valid);
    if (valid_error.kind != fail.INTERNAL) { template_error_dnit(alloc, valid_error); ret 3; }
    alloc_test.fail_at_ordinal(?t, alloc_test.attempt_count(?t) + 1);
    val refused: R.Result[str, TemplateError] = expand_artifact_path(alloc,
        "{artifact.absent.out}", ?items[0], 1, "embed");
    if (R.is_ok[str, TemplateError](refused)) { str_free(alloc, R.unwrap_ok[str, TemplateError](refused)); ret 4; }
    val refused_error: TemplateError = R.unwrap_err[str, TemplateError](refused);
    if (refused_error.kind != fail.INTERNAL) { template_error_dnit(alloc, refused_error); ret 5; }
    alloc_test.fail_at_ordinal(?t, 0);
    val rejected: R.Result[str, TemplateError] = expand_artifact_path(alloc,
        "{artifact.absent.out}", ?items[0], 1, "embed");
    if (R.is_ok[str, TemplateError](rejected)) { str_free(alloc, R.unwrap_ok[str, TemplateError](rejected)); ret 6; }
    val rejected_error: TemplateError = R.unwrap_err[str, TemplateError](rejected);
    val kind: fail.PhaseKind = rejected_error.kind;
    template_error_dnit(alloc, rejected_error);
    if (kind != fail.REJECTED) { ret 7; }
    if (alloc_test.leaked(?t) || alloc_test.double_free_count(?t) != 0) { ret 8; }
    ret 0;
}
