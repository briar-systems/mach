    val src: str = sfmt(?alloc, "{}{}{}{}", need_head(),
        need_artifact(?alloc, "twin", "twin", ""),
        "[step.twin]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"twin\"]\n");
    if (!need_err(?alloc, ?itn, src, "must use 'step.<name>' or 'artifact.<name>'")) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.validate_needs:rejects_an_empty_glob_an_unknown_id_and_self" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val empty_glob: str = sfmt(?alloc, "{}{}{}", need_head(),
        need_artifact(?alloc, "shader-a", "a", ""),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.nothing-*\"]\n");
    if (!need_err(?alloc, ?itn, empty_glob, "need entry 'artifact.nothing-*' matches no declaration in its category")) { code = 1; }

    val unknown: str = sfmt(?alloc, "{}{}", need_head(),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.ghost\"]\n");
    if (!need_err(?alloc, ?itn, unknown, "need entry 'artifact.ghost' matches no declaration in its category")) { code = 1; }

    val itself: str = sfmt(?alloc, "{}{}", need_head(),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.app\"]\n");
    if (!need_err(?alloc, ?itn, itself, "[artifact.app].need requires itself")) { code = 1; }

    val bad_char: str = sfmt(?alloc, "{}{}", need_head(),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"../step\"]\n");
    if (!need_err(?alloc, ?itn, bad_char, "must use 'step.<name>' or 'artifact.<name>'")) { code = 1; }

    val self_glob: str = sfmt(?alloc, "{}{}", need_head(),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.a*\"]\n");
    if (!need_err(?alloc, ?itn, self_glob, "need entry 'artifact.a*' matches no declaration in its category")) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.validate_needs:rejects_a_cycle_naming_the_chain" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val two: str = sfmt(?alloc, "{}{}{}", need_head(),
        need_artifact(?alloc, "a", "a", "\"artifact.b\""),
        need_artifact(?alloc, "b", "b", "\"artifact.a\""));
    if (!need_err(?alloc, ?itn, two, "artifact 'need' cycle: a -> b -> a")) { code = 1; }

    val three: str = sfmt(?alloc, "{}{}{}{}", need_head(),
        need_artifact(?alloc, "a", "a", "\"artifact.b\""),
        need_artifact(?alloc, "b", "b", "\"artifact.c\""),
        need_artifact(?alloc, "c", "c", "\"artifact.a\""));
    if (!need_err(?alloc, ?itn, three, "artifact 'need' cycle: a -> b -> c -> a")) { code = 1; }

    val glob_cycle: str = sfmt(?alloc, "{}{}{}", need_head(),
        need_artifact(?alloc, "pack-a", "pa", "\"artifact.pack-b\""),
        need_artifact(?alloc, "pack-b", "pb", "\"artifact.pack-*\""));
    if (!need_err(?alloc, ?itn, glob_cycle, "artifact 'need' cycle: pack-a -> pack-b -> pack-a")) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

fun need_two_target_head() str {
    ret "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}/{profile.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.alt]\nisa=\"aarch64\"\nos=\"linux\"\nabi=\"aapcs64\"\n[target.alt2]\nisa=\"riscv64\"\nos=\"linux\"\nabi=\"lp64d\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
}

test "mach.lang.manifest.resolve_artifact_reqs:resolves_the_required_output_on_its_own_target" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = sfmt(?alloc, "{}{}{}", need_two_target_head(),
        "[artifact.shader-a]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"lib/shader-a.a\"\ntargets=[\"alt\"]\nlink=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.shader-*\"]\n");
    val r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel r.err) { code = 1; }
    if (sel r.ok) {
        var m: Manifest = r.ok;
        val app: *ArtifactDef = find_artifact(?itn, ?m, "app");
        val host: *TargetDef  = find_target_by_name(?itn, ?m, "host");
        var items: *ArtifactReq = nil;
        var count: u32 = 0;
        val rr: err[outcome.Fail] = t_resolve_artifact_reqs(?alloc, ?itn, ?m, app, host, "debug", false, ?items, ?count);
        if (sel rr.err)                              { code = 1; }
        or {
            if (count != 1)                                       { code = 1; }
            or {
                if (!str_equals(items[0].name, "shader-a"))       { code = 1; }
                if (!str_equals(items[0].out, "out/alt/debug/lib/shader-a.a")) { code = 1; }
            }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_artifact_reqs:a_requirement_with_two_targets_has_no_single_output" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = sfmt(?alloc, "{}{}{}", need_two_target_head(),
        "[artifact.shader-a]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"lib/shader-a.a\"\ntargets=[\"alt\",\"alt2\"]\nlink=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.shader-a\"]\n");
    val r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel r.err) { code = 1; }
    if (sel r.ok) {
        var m: Manifest = r.ok;
        val app: *ArtifactDef = find_artifact(?itn, ?m, "app");
        val host: *TargetDef  = find_target_by_name(?itn, ?m, "host");
        var items: *ArtifactReq = nil;
        var count: u32 = 0;
        val rr: err[outcome.Fail] = t_resolve_artifact_reqs(?alloc, ?itn, ?m, app, host, "debug", false, ?items, ?count);
        if (sel rr.err)            { code = 1; }
        or {
            if (count != 1)                     { code = 1; }
            or {
                if (!str_empty(items[0].out))   { code = 1; }
                var v: TmplVars = tmpl_vars_of_reqs(items, count);
                val er: res[str, outcome.Fail] = expand(?alloc, "{artifact.shader-a.out}", "", ?v);
                if (!(sel er.err && str_contains(outcome.describe(er.err), "is ambiguous"))) { code = 1; }
            }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.expand_artifact_path:substitutes_only_the_artifact_vocabulary" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    var items: [1]ArtifactReq;
    items[0].name = "shader-a";
    items[0].out  = "out/alt/debug/lib/shader-a.a";

    val ok: res[str, TemplateError] = expand_artifact_path_typed(?alloc, "{artifact.shader-a.out}", ?items[0], 1, "an `embed` path");
    if (!(sel ok.ok && str_equals(ok.ok, "out/alt/debug/lib/shader-a.a"))) { code = 1; }

    val plain: res[str, TemplateError] = expand_artifact_path_typed(?alloc, "assets/logo.png", ?items[0], 1, "an `embed` path");
    if (!(sel plain.ok && str_equals(plain.ok, "assets/logo.png"))) { code = 1; }

    val other: res[str, TemplateError] = expand_artifact_path_typed(?alloc, "{target.name}/x", ?items[0], 1, "an `embed` path");
    if (!(sel other.err && str_contains(template_text(other.err), "only '{artifact.<id>.out}' may appear"))) { code = 1; }

    val missing: res[str, TemplateError] = expand_artifact_path_typed(?alloc, "{artifact.ghost.out}", ?items[0], 1, "an `embed` path");
    if (!(sel missing.err && str_contains(template_text(missing.err), "does not require"))) { code = 1; }

    val none_declared: res[str, TemplateError] = expand_artifact_path_typed(?alloc, "{artifact.shader-a.out}", nil, 0, "an `embed` path");
    if (!(sel none_declared.err && str_contains(template_text(none_declared.err), "does not require"))) { code = 1; }

    val unterminated: res[str, TemplateError] = expand_artifact_path_typed(?alloc, "{artifact.shader-a.out", ?items[0], 1, "an `embed` path");
    if (sel unterminated.ok) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:an_artifact_out_template_cannot_name_another_artifact" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = sfmt(?alloc, "{}{}{}", need_two_target_head(),
        "[artifact.shader-a]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"lib/shader-a.a\"\ntargets=[\"alt\"]\nlink=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/{artifact.shader-a.out}\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.shader-a\"]\n");
    val r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel r.err) { code = 1; }
    if (sel r.ok) {
        var m: Manifest = r.ok;
        val u: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("host", "", "app", false, true));
        if (!(sel u.err && str_contains(outcome.describe(u.err), "does not require"))) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:argv_step_contract" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";

    val valid: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=['\"quoted\"',\"'single'\",'semi;$|&<>*?[]','{\"x\":1}',\"{\\\"escaped\\\":true}\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\nVALUE='literal;$|&<>*?[]'\nJSON=\"{\\\"x\\\":1}\"\n"));
    if (sel valid.err) { code = 1; }
    if (sel valid.ok) {
        var m: Manifest = valid.ok;
        if (m.step_count != 1 || m.steps[0].argv_count != 5 || m.steps[0].env_count != 2) { code = 1; }
        or {
            if (!str_equals(idstr(?itn, m.steps[0].argv[0]), "\"quoted\"")) { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].argv[1]), "'single'")) { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].argv[2]), "semi;$|&<>*?[]")) { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].argv[3]), "{\"x\":1}")) { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].argv[4]), "{\"escaped\":true}")) { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].env_keys[0]), "JSON") || !str_equals(idstr(?itn, m.steps[0].env_values[0]), "{\"x\":1}")) { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].env_keys[1]), "VALUE") || !str_equals(idstr(?itn, m.steps[0].env_values[1]), "literal;$|&<>*?[]")) { code = 1; }
        }
    }

    val empty: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[]\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel empty.err && str_contains(outcome.describe(empty.err), ".argv must be nonempty"))) { code = 1; }

    val empty_program: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"\"]\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel empty_program.err && str_contains(outcome.describe(empty_program.err), "argv[0] must name an executable"))) { code = 1; }

    val cmd: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\ncmd=\"true\"\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel cmd.err && str_contains(outcome.describe(cmd.err), "uses removed key 'cmd'"))) { code = 1; }

    val shell: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nshell=true\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel shell.err && str_contains(outcome.describe(shell.err), "uses removed key 'shell'"))) { code = 1; }

    val env_type: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={VALUE=1}\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel env_type.err && str_contains(outcome.describe(env_type.err), ".env.VALUE must be a string"))) { code = 1; }

    val env_ambiguous: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={PATH=\"a\",Path=\"b\"}\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel env_ambiguous.err && str_contains(outcome.describe(env_ambiguous.err), "ambiguous keys"))) { code = 1; }

    val env_order_a: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={z=\"last\",B=\"middle\",a=\"first\"}\nin=[]\nout=[]\nneed=[]\n"));
    val env_order_b: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={a=\"first\",z=\"last\",B=\"middle\"}\nin=[]\nout=[]\nneed=[]\n"));
    if (sel env_order_a.ok) {
        if (sel env_order_b.ok) {
            val ma: Manifest = env_order_a.ok;
            val mb: Manifest = env_order_b.ok;
            var ei: u32 = 0;
            for (ei < ma.steps[0].env_count && ei < mb.steps[0].env_count) {
                if (ma.steps[0].env_keys[ei] != mb.steps[0].env_keys[ei]) { code = 1; }
                if (ma.steps[0].env_values[ei] != mb.steps[0].env_values[ei]) { code = 1; }
                ei = ei + 1;
            }
            if (!str_equals(idstr(?itn, ma.steps[0].env_keys[0]), "a")) { code = 1; }
            if (!str_equals(idstr(?itn, ma.steps[0].env_values[0]), "first")) { code = 1; }
            if (!str_equals(idstr(?itn, ma.steps[0].env_keys[1]), "B")) { code = 1; }
            if (!str_equals(idstr(?itn, ma.steps[0].env_values[1]), "middle")) { code = 1; }
            if (!str_equals(idstr(?itn, ma.steps[0].env_keys[2]), "z")) { code = 1; }
            if (!str_equals(idstr(?itn, ma.steps[0].env_values[2]), "last")) { code = 1; }
    }
        if (sel env_order_b.err) { code = 1; }
    }
    if (sel env_order_a.err) { code = 1; }

    val argv_nul: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"pre\\u0000post\"]\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel argv_nul.err && str_contains(outcome.describe(argv_nul.err), "cannot contain NUL"))) { code = 1; }

    val env_key_nul: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\n\"A\\u0000B\"=\"x\"\n"));
    if (!(sel env_key_nul.err && str_contains(outcome.describe(env_key_nul.err), "cannot contain NUL"))) { code = 1; }

    val env_value_nul: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\nVALUE=\"pre\\U00000000post\"\n"));
    if (!(sel env_value_nul.err && str_contains(outcome.describe(env_value_nul.err), "cannot contain NUL"))) { code = 1; }

    val literal_escape: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=['pre\\u0000post']\nin=[]\nout=[]\nneed=[]\n"));
    if (sel literal_escape.err) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:late_step_error_releases_owned_arrays" {
    var probe: StepParseLive;
    var alloc: A.Allocator;
    if (!step_parse_live_make(?probe, ?alloc)) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);
    val r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\",\"arg\"]\nenv={A=\"one\",B=\"two\"}\nin=[\"src\"]\nout=[\"../escape\"]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel r.ok) { intern.dnit(?itn); ret 1; }
    str_free(?alloc, outcome.describe(r.err));
    intern.dnit(?itn);
    if (probe.live != 0) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.parse:artifact_middle_entry_error_releases_owned_arrays" {
    var probe: StepParseLive;
    var alloc: A.Allocator;
    if (!step_parse_live_make(?probe, ?alloc)) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);
    val r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn,
        "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[artifact.a]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/a\"\ntargets=[\"t1\",\"t2\"]\nlink=[\"l1\"]\nneed=[]\n[artifact.b]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/b\"\ntargets=[\"t1\"]\nlink=[\"l1\",\"l2\"]\nneed=[\"artifact.a\"]\nicon=\"icon.ico\"\n[artifact.c]\nkind=\"bin\"\nentry=\"c.mach\"\nout=\"bin/c\"\ntargets=[\"t1\"]\nlink=[]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel r.ok) { intern.dnit(?itn); ret 1; }
    if (!str_contains(outcome.describe(r.err), "icon and .manifest apply only to kind = \"bin\"")) {
        str_free(?alloc, outcome.describe(r.err));
        intern.dnit(?itn);
        ret 1;
    }
    str_free(?alloc, outcome.describe(r.err));
    intern.dnit(?itn);
    if (probe.live != 0) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.parse:link_middle_entry_error_releases_owned_arrays" {
    var probe: StepParseLive;
    var alloc: A.Allocator;
    if (!step_parse_live_make(?probe, ?alloc)) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);
    val r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn,
        "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[link.a]\nsource=\"system\"\nname=\"foo\"\nsymbols=[\"sym1\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=true\n[link.b]\nsource=\"system\"\nname=\"bar\"\nsymbols=[\"sym2\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\n[link.c]\nsource=\"system\"\nname=\"baz\"\nsymbols=[\"sym3\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=true\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel r.ok) { intern.dnit(?itn); ret 1; }
    if (!str_contains(outcome.describe(r.err), "is missing required key 'export'")) {
        str_free(?alloc, outcome.describe(r.err));
        intern.dnit(?itn);
        ret 1;
    }
    str_free(?alloc, outcome.describe(r.err));
    intern.dnit(?itn);
    if (probe.live != 0) { ret 1; }
    ret 0;
}

fun step_intern_fail_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    ret opt[ptr].none{};
}

fun step_intern_fail_reallocate(ctx: ptr, item: ptr, old_size: usize,
                                new_size: usize, align: usize) opt[ptr] {
    ret opt[ptr].none{};
}

fun step_intern_fail_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.manifest.parse:env_intern_failure_aborts_step" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var base: intern.Interner = intern.init(?alloc);
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val seeded_r: res[Manifest, outcome.Fail] = tparse(?alloc, ?base, head);
    if (sel seeded_r.err) { intern.dnit(?base); ret 1; }
    var seeded: Manifest = seeded_r.ok;
    dnit(?seeded, ?alloc);

    val source: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\nUNSEEDED=\"value\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val table_r: res[toml.Table, toml.TomlError] = toml.parse(?alloc, source);
    if (sel table_r.err) { intern.dnit(?base); ret 1; }
    var table: toml.Table = table_r.ok;

    var fail_alloc: A.Allocator;
    fail_alloc.ctx = nil;
    fail_alloc.fn_allocate = step_intern_fail_allocate;
    fail_alloc.fn_reallocate = step_intern_fail_reallocate;
    fail_alloc.fn_deallocate = step_intern_fail_deallocate;
    var child: intern.Interner = intern.make_child(?base, ?fail_alloc);
    val parsed: res[Manifest, outcome.Fail] = parse(?alloc, ?child, ?table, true);
    toml.dnit(?alloc, ?table);
    val bad: bool = sel parsed.ok || child.len != 0;
    intern.dnit(?child);
    intern.dnit(?base);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.parse:simd_required_and_validated" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";

    val a: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (sel a.err) { code = 1; }
    if (sel a.ok) { if (a.ok.profiles[0].simd != SIMD_SCALARIZE) { code = 1; } }

    val b: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=0\ndebug=false\nsimd=\"require\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (sel b.err) { code = 1; }
    if (sel b.ok) { if (b.ok.profiles[0].simd != SIMD_REQUIRE) { code = 1; } }

    val c: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=0\ndebug=false\nvectorize=true\nfloat_reassoc=false\n"));
    if (!(sel c.err && str_contains(outcome.describe(c.err), "[profile.p] is missing required key 'simd'"))) { code = 1; }

    val d: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=0\ndebug=false\nsimd=\"bogus\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (!(sel d.err && str_contains(outcome.describe(d.err), "simd must be \"scalarize\" or \"require\""))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:float_reassoc_is_read_and_validated" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";

    val a: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (sel a.err) { code = 1; }
    if (sel a.ok) {
        var ma: Manifest = a.ok;
        if (ma.profiles[0].float_reassoc) { code = 1; }
        val ra: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?ma, "p");
        if (sel ra.err) { code = 1; }
        if (sel ra.ok) { if (ra.ok.float_reassoc) { code = 1; } }
    }

    val b: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nfloat_reassoc=true\nvectorize=true\n"));
    if (sel b.err) { code = 1; }
    if (sel b.ok) {
        var mb: Manifest = b.ok;
        if (!mb.profiles[0].float_reassoc) { code = 1; }
        val rb: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?mb, "p");
        if (sel rb.err) { code = 1; }
        if (sel rb.ok) { if (!rb.ok.float_reassoc) { code = 1; } }
    }

    val c: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nfloat_reassoc=false\nvectorize=true\n"));
    if (sel c.err) { code = 1; }
    if (sel c.ok) { if (c.ok.profiles[0].float_reassoc) { code = 1; } }

    val d: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nfloat_reassoc=\"yes\"\nvectorize=true\n"));
    if (!(sel d.err && str_contains(outcome.describe(d.err), "float_reassoc must be a boolean"))) { code = 1; }

    val e: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, head);
    if (sel e.err) { code = 1; }
    if (sel e.ok) {
        var me: Manifest = e.ok;
        val re: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?me, "");
        if (sel re.err) { code = 1; }
        if (sel re.ok) { if (re.ok.float_reassoc) { code = 1; } }
    }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:profile_selection_contract" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{profile.name}\"\n";

    val root_builtins: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, head);
    if (!(sel root_builtins.err && str_equals(outcome.describe(root_builtins.err), MISSING_PROFILE_MESSAGE))) { code = 1; }

    val builtins: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, head);
    if (sel builtins.err) { code = 1; }
    if (sel builtins.ok) {
        var m: Manifest = builtins.ok;
        if (m.profile_count != 2) { code = 1; }
        or {
            val debug: *ProfileDef = ?m.profiles[0];
            val release: *ProfileDef = ?m.profiles[1];
            if (!str_equals(idstr(?itn, debug.name), "debug") || !debug.is_default
                || debug.opt != MOPT_DEBUG
                || !debug.debug || debug.simd != SIMD_SCALARIZE || debug.vectorize
                || debug.float_reassoc) { code = 1; }
            if (!str_equals(idstr(?itn, release.name), "release") || release.is_default
                || release.opt != MOPT_RELEASE
                || release.debug || release.simd != SIMD_SCALARIZE || !release.vectorize
                || release.float_reassoc) { code = 1; }

            val omitted: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?m, "");
            val explicit: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?m, "release");
            if (sel omitted.ok) {
                if (sel explicit.ok) {
                    if (!str_equals(idstr(?itn, omitted.ok.name), "debug")) { code = 1; }
                    if (!str_equals(idstr(?itn, explicit.ok.name), "release")) { code = 1; }
            }
                if (sel explicit.err) { code = 1; }
            }
            if (sel omitted.err) { code = 1; }
        }
    }

    val sole: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.ship]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (sel sole.err) { code = 1; }
    if (sel sole.ok) {
        var m: Manifest = sole.ok;
        if (m.profile_count != 1 || m.profiles[0].is_default) { code = 1; }
        val omitted: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?m, "");
        val builtin: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?m, "debug");
        if (!(sel omitted.ok && str_equals(idstr(?itn, omitted.ok.name), "ship"))) { code = 1; }
        if (sel builtin.ok) { code = 1; }
    }

    val selected: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.first]\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[profile.chosen]\ndefault=true\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (sel selected.err) { code = 1; }
    if (sel selected.ok) {
        var m: Manifest = selected.ok;
        val omitted: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?m, "");
        val explicit: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?m, "first");
        if (sel omitted.ok) {
            if (sel explicit.ok) {
                if (!str_equals(idstr(?itn, omitted.ok.name), "chosen")) { code = 1; }
                if (!str_equals(idstr(?itn, explicit.ok.name), "first")) { code = 1; }
        }
            if (sel explicit.err) { code = 1; }
        }
        if (sel omitted.err) { code = 1; }
    }

    val missing: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.a]\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[profile.b]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (sel missing.err) { code = 1; }
    if (sel missing.ok) {
        var mm: Manifest = missing.ok;
        val omitted_sel: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?mm, "");
        if (!(sel omitted_sel.ok && (omitted_sel.ok.legacy_default && str_equals(idstr(?itn, omitted_sel.ok.name), idstr(?itn, mm.profiles[0].name))))) { code = 1; }
        val explicit_sel: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?mm, "a");
        if (sel explicit_sel.err) { code = 1; }
        if (sel explicit_sel.ok) {
            if (!str_equals(idstr(?itn, explicit_sel.ok.name), "a")) { code = 1; }
        }
    }

    val repeated: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.a]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[profile.b]\ndefault=true\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (!(sel repeated.err && str_contains(outcome.describe(repeated.err), "exactly one is allowed"))) { code = 1; }

    val typed: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.a]\ndefault=\"yes\"\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (!(sel typed.err && str_contains(outcome.describe(typed.err), "default must be a boolean"))) { code = 1; }

    val source: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.a]\nopt=0\nvectorize=true\nfloat_reassoc=false\n[profile.b]\nopt=2\nvectorize=true\nfloat_reassoc=false\n"));
    if (!(sel source.err && str_contains(outcome.describe(source.err), "[profile.a] is missing required key 'debug'"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:subsystem_optional_and_console" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val art:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";

    val a: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, art));
    if (sel a.err) { code = 1; }
    if (sel a.ok) { if (a.ok.artifacts[0].subsystem != of.SUBSYSTEM_CONSOLE) { code = 1; } }

    val b: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, art, "subsystem=\"gui\"\n"));
    if (sel b.err) { code = 1; }
    if (sel b.ok) { if (b.ok.artifacts[0].subsystem != of.SUBSYSTEM_GUI) { code = 1; } }

    val c: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, art, "subsystem=\"console\"\n"));
    if (sel c.err) { code = 1; }
    if (sel c.ok) { if (c.ok.artifacts[0].subsystem != of.SUBSYSTEM_CONSOLE) { code = 1; } }

    val d: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, art, "subsystem=\"windows\"\n"));
    if (!(sel d.err && str_contains(outcome.describe(d.err), "subsystem must be \"console\" or \"gui\""))) { code = 1; }

    val e: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, art, "subsystem=2\n"));
    if (!(sel e.err && str_contains(outcome.describe(e.err), "subsystem must be \"console\" or \"gui\""))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:artifact_resource_keys_validated" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val bin:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app.exe\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";

    val absent: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, bin));
    if (sel absent.err) { code = 1; }
    if (sel absent.ok) {
        val a: ArtifactDef = absent.ok.artifacts[0];
        if (a.icon != intern.STR_NIL || a.app_manifest != intern.STR_NIL) { code = 1; }
    }

    val valid: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn,
        sfmt(?alloc, "{}{}{}", head, bin, "icon=\"assets/app.ico\"\nmanifest=\"assets/app.manifest\"\n"));
    if (sel valid.err) { code = 1; }
    if (sel valid.ok) {
        val a: ArtifactDef = valid.ok.artifacts[0];
        val io: opt[str] = intern.lookup_typed(?itn, a.icon);
        val mo: opt[str] = intern.lookup_typed(?itn, a.app_manifest);
        if (!(sel io.some && str_equals(io.some, "assets/app.ico"))) { code = 1; }
        if (!(sel mo.some && str_equals(mo.some, "assets/app.manifest"))) { code = 1; }
    }

    val empty_icon: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn,
        sfmt(?alloc, "{}{}{}", head, bin, "icon=\"\"\n"));
    if (!(sel empty_icon.err && str_contains(outcome.describe(empty_icon.err), ".icon must not be empty"))) { code = 1; }

    val wrong_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn,
        sfmt(?alloc, "{}{}{}", head, bin, "manifest=42\n"));
    if (!(sel wrong_manifest.err && str_contains(outcome.describe(wrong_manifest.err), ".manifest must be a non-empty path string"))) { code = 1; }

    val backslash: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn,
        sfmt(?alloc, "{}{}{}", head, bin, "icon=\"assets\\\\app.ico\"\n"));
    if (!(sel backslash.err && str_contains(outcome.describe(backslash.err), "manifest paths use '/'"))) { code = 1; }

    val static_art: str = "[artifact.lib]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/x.a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\nicon=\"assets/app.ico\"\n";
    val irrelevant: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, static_art));
    if (!(sel irrelevant.err && str_contains(outcome.describe(irrelevant.err), "apply only to kind = \"bin\" artifacts"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:reserved_target_native" {
    var backing: A.Allocator;
