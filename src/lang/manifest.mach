}

test "mach.lang.manifest.parse:mach_key_is_deprecated_not_unknown" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val with_r: R.Result[Manifest, str] = tparse(?alloc, ?itn,
        "[project]\nid = \"p\"\nversion = \"0.1.0\"\nmach = \"4.14.0\"\nsrc = \"src\"\nout = \"o\"\n");
    if (R.is_err[Manifest, str](with_r)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](with_r);
        if (m.deprecated_count != 1 || !str_equals(m.deprecated[0].key, "mach")) { code = 1; }
        dnit(?m, ?alloc);
    }

    val other_r: R.Result[Manifest, str] = tparse(?alloc, ?itn,
        "[project]\nid = \"p\"\nversion = \"0.1.0\"\nmachine = \"4.14.0\"\nsrc = \"src\"\nout = \"o\"\n");
    if (R.is_ok[Manifest, str](other_r)) { code = 1; }
    or (!str_contains(R.unwrap_err[Manifest, str](other_r), "unknown key 'machine' in [project]")) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

fun ut_messy_manifest() str {
    ret "# top of file comment, must survive\n[project]\nid   =   \"messy\"   \nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"o\"\n\n# a hand-written dependency, with its own comment above it\n[dep.other]\ngit = \"https://example.com/other.git\"\nref = \"branch/main\"\n\n[target.linux]\nisa = \"x86_64\"\nos  = \"linux\"\nabi = \"sysv64\"\n";
}

test "mach.lang.manifest.manifest_add_dep_table:appends_and_leaves_the_messy_source_byte_identical" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val original: str = ut_messy_manifest();
    var spec: DepTableSpec;
    spec.name   = "newlib";
    spec.source = DEP_SOURCE_GIT;
    spec.value  = "https://example.com/newlib.git";
    spec.ref    = "branch/main";

    val r: R.Result[str, str] = manifest_add_dep_table(?alloc, original, ?spec);
    if (R.is_err[str, str](r)) { code = 1; }
    or {
        val out: str = R.unwrap_ok[str, str](r);
        if (!str_starts_with(out, original)) { code = 1; }
        if (!str_contains(out, "[dep.newlib]")) { code = 1; }
        if (!str_contains(out, "git = \"https://example.com/newlib.git\"")) { code = 1; }
        if (!str_contains(out, "ref = \"branch/main\"")) { code = 1; }

        val tbl_r: R.Result[toml.Table, str] = toml.parse(?alloc, out);
        if (R.is_err[toml.Table, str](tbl_r)) { code = 1; }
        or {
            var tbl: toml.Table = R.unwrap_ok[toml.Table, str](tbl_r);
            if (!str_equals(toml.get_str(?tbl, "dep.other.git"), "https://example.com/other.git")) { code = 1; }
            if (!str_equals(toml.get_str(?tbl, "dep.other.ref"), "branch/main")) { code = 1; }
            if (!str_equals(toml.get_str(?tbl, "dep.newlib.git"), "https://example.com/newlib.git")) { code = 1; }
            toml.dnit(?alloc, ?tbl);
        }
    }

    arena.dnit(?ar);
    ret code;
}

