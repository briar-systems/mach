    val bare_root: R.Result[Manifest, str] = tparse(?alloc, ?itn, dep_bare);
    if (R.is_ok[Manifest, str](bare_root) || !str_contains(R.unwrap_err[Manifest, str](bare_root), "is missing required key 'simd'")) { code = 1; }

