    val target: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}[target.\"../escape\"]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n", project));
