test "mach.lang.manifest.parse:operational_paths_are_project_relative" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val prefix: str = "[project]\nid=\"x\"\nversion=\"1\"\n";
    val suffix: str = "\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n";

    val parent: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}src=\"../src\"\nout=\"out\"{}", prefix, suffix));
    if (R.is_ok[Manifest, str](parent) || !str_contains(R.unwrap_err[Manifest, str](parent), "must not contain '.' or '..'")) { code = 1; }

    val absolute: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}src=\"src\"\nout=\"/tmp/out\"{}", prefix, suffix));
    if (R.is_ok[Manifest, str](absolute) || !str_contains(R.unwrap_err[Manifest, str](absolute), "must be relative to the project root")) { code = 1; }

    val repeated: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}src=\"src//lib\"\nout=\"out\"{}", prefix, suffix));
    if (R.is_ok[Manifest, str](repeated) || !str_contains(R.unwrap_err[Manifest, str](repeated), "empty path component")) { code = 1; }

    val drive: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}src=\"src\"\nout=\"C:/out\"{}", prefix, suffix));
    if (R.is_ok[Manifest, str](drive) || !str_contains(R.unwrap_err[Manifest, str](drive), "absolute drive path")) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:platform_and_base" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.bmos]\nisa=\"x86_64\"\nos=\"freestanding\"\nabi=\"sysv64\"\nplatform=\"bmos\"\nbase=0xFFFF800000000000\n[target.plain]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n";
    val res_manifest: R.Result[Manifest, str] = tparse(?alloc, ?itn, src);
    if (R.is_err[Manifest, str](res_manifest)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](res_manifest);
        val tb: *TargetDef = find_target_by_name(?itn, ?m, "bmos");
        val tp: *TargetDef = find_target_by_name(?itn, ?m, "plain");
        if (tb == nil || tp == nil) { code = 1; }
        or {
            if (!str_equals(idstr(?itn, tb.platform), "bmos")) { code = 1; }
            if (tb.base != 0xFFFF800000000000)                 { code = 1; }
            if (tp.platform != intern.STR_NIL)                 { code = 1; }
            if (tp.base != 0)                                  { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:native_resolution" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    var src: str = "[project]\nid = \"x\"\nversion = \"1\"\nsrc=\"src\"\nout=\"out\"\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val st:  str = host_target_stanza(?alloc, "foreign");
    src = sfmt(?alloc, "{}{}", src, st);

    val res_manifest: R.Result[Manifest, str] = tparse(?alloc, ?itn, src);
    if (R.is_err[Manifest, str](res_manifest)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](res_manifest);
        val u: R.Result[BuildUnit, str] = resolve_build_unit(?alloc, ?itn, ?m, mk_sel("native", "", "app", false, true));
        if (R.is_err[BuildUnit, str](u)) { code = 1; }
        or {
            val bu: BuildUnit = R.unwrap_ok[BuildUnit, str](u);
            if (bu.warned)                                 { code = 1; }
            if (!str_equals(idstr(?itn, bu.target_name), "foreign")) { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

