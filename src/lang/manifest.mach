    val link: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}[link.\"../escape\"]\nsource=\"local\"\npath=\"obj/a.o\"\n", project));
    if (!(sel link.err && str_contains(outcome.describe(link.err), "link name '../escape' must be a portable identifier"))) { code = 1; }

