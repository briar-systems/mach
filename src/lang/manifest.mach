pub rec Manifest {
    id:             intern.StrId;
    version:        intern.StrId;
    src:            intern.StrId;
    out_tmpl:       intern.StrId;
    default_target: intern.StrId;
    targets:        *TargetDef;
    target_count:   u32;
    native_target:  *TargetDef;
    artifacts:      *ArtifactDef;
    artifact_count: u32;
    profiles:       *ProfileDef;
    profile_count:  u32;
    deps:           *DepDef;
    dep_count:      u32;
    links:          *LinkDef;
    link_count:     u32;
    steps:          *StepDef;
    step_count:     u32;
}

pub fun empty() Manifest {
    var m: Manifest;
    m.id             = intern.STR_NIL;
    m.version        = intern.STR_NIL;
    m.src            = intern.STR_NIL;
    m.out_tmpl       = intern.STR_NIL;
    m.default_target = intern.STR_NIL;
    m.targets        = nil;
    m.target_count   = 0;
    m.native_target  = nil;
    m.artifacts      = nil;
    m.artifact_count = 0;
    m.profiles       = nil;
    m.profile_count  = 0;
    m.deps           = nil;
    m.dep_count      = 0;
    m.links          = nil;
    m.link_count     = 0;
    m.steps          = nil;
    m.step_count     = 0;
    ret m;
}

pub fun dnit(m: *Manifest, alloc: *A.Allocator) {
    if (m.native_target != nil) {
        A.deallocate[TargetDef](alloc, m.native_target, 1);
        m.native_target = nil;
    }
    if (m.targets != nil && m.target_count > 0) {
        A.deallocate[TargetDef](alloc, m.targets, m.target_count::usize);
        m.targets      = nil;
        m.target_count = 0;
    }
    if (m.artifacts != nil && m.artifact_count > 0) {
        var i: u32 = 0;
        for (i < m.artifact_count) {
            val a: *ArtifactDef = ?m.artifacts[i];
            mparse.free_strarr(alloc, a.targets, a.target_count);
            mparse.free_strarr(alloc, a.link, a.link_count);
            mparse.free_strarr(alloc, a.need, a.need_count);
            i = i + 1;
        }
        A.deallocate[ArtifactDef](alloc, m.artifacts, m.artifact_count::usize);
        m.artifacts      = nil;
        m.artifact_count = 0;
    }
    if (m.profiles != nil && m.profile_count > 0) {
        A.deallocate[ProfileDef](alloc, m.profiles, m.profile_count::usize);
        m.profiles      = nil;
        m.profile_count = 0;
    }
    if (m.deps != nil && m.dep_count > 0) {
        A.deallocate[DepDef](alloc, m.deps, m.dep_count::usize);
        m.deps      = nil;
        m.dep_count = 0;
    }
    if (m.links != nil && m.link_count > 0) {
        var i: u32 = 0;
        for (i < m.link_count) {
            val l: *LinkDef = ?m.links[i];
            mparse.free_strarr(alloc, l.symbols, l.symbol_count);
            mparse.free_strarr(alloc, l.os, l.os_count);
            mparse.free_strarr(alloc, l.isa, l.isa_count);
            mparse.free_strarr(alloc, l.abi, l.abi_count);
            i = i + 1;
        }
        A.deallocate[LinkDef](alloc, m.links, m.link_count::usize);
        m.links      = nil;
        m.link_count = 0;
    }
    if (m.steps != nil && m.step_count > 0) {
        var i: u32 = 0;
        for (i < m.step_count) {
            val s: *StepDef = ?m.steps[i];
            mparse.free_strarr(alloc, s.argv, s.argv_count);
            mparse.free_strarr(alloc, s.env_keys, s.env_count);
            mparse.free_strarr(alloc, s.env_values, s.env_count);
            mparse.free_strarr(alloc, s.in, s.in_count);
            mparse.free_strarr(alloc, s.out, s.out_count);
            mparse.free_strarr(alloc, s.need, s.need_count);
            i = i + 1;
        }
        A.deallocate[StepDef](alloc, m.steps, m.step_count::usize);
        m.steps      = nil;
        m.step_count = 0;
    }
}

pub fun canonical_module(m: *Manifest) intern.StrId {
    var entry: intern.StrId = intern.STR_NIL;
    var i:     u32          = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        if (a.is_lib && a.is_default) {
            if (entry == intern.STR_NIL) {
                entry = a.entry;
            }
            or (entry != a.entry) {
                ret intern.STR_NIL;
            }
        }
        i = i + 1;
    }
    ret entry;
}

fun need_cycle_chain(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    stack: *u32, depth: u32, from: u32, target: u32) str {
    var s: str = "";
    var i: u32 = from;
    for (i < depth) {
        if (str_empty(s)) { s = mparse.sfmt(alloc, "{}", mparse.idstr(itn, m.artifacts[stack[i]].name)); }
        or                { s = mparse.sfmt(alloc, "{} -> {}", s, mparse.idstr(itn, m.artifacts[stack[i]].name)); }
        i = i + 1;
    }
    ret mparse.sfmt(alloc, "{} -> {}", s, mparse.idstr(itn, m.artifacts[target].name));
}

fun need_cycle_visit(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, idx: u32,
    state: *u8, stack: *u32, depth: u32) err[outcome.Fail] {
    if (state[idx] == 2) { ret err[outcome.Fail].ok{}; }
    state[idx]   = 1;
    stack[depth] = idx;

    val a: *ArtifactDef = ?m.artifacts[idx];
    var j: u32          = 0;
    for (j < m.artifact_count) {
        if (artifact.artifact_needs_artifact(itn, a, ?m.artifacts[j])) {
            if (state[j] == 1) {
                var from: u32 = 0;
                for (from <= depth) {
                    if (stack[from] == j) { brk; }
                    from = from + 1;
                }
                if (from > depth) { from = 0; }
                ret err[outcome.Fail].err{outcome.user(mparse.sfmt(alloc, "mach.toml: artifact 'need' cycle: {}",
                    need_cycle_chain(alloc, itn, m, stack, depth + 1, from, j)))};
            }
            val vr: err[outcome.Fail] = need_cycle_visit(alloc, itn, m, j, state, stack, depth + 1);
            if (sel vr.err) { ret vr; }
        }
        j = j + 1;
    }
    state[idx] = 2;
    ret err[outcome.Fail].ok{};
}

fun validate_need_entry(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    owner: str, name: str, entry: str) err[outcome.Fail] {
    val step_pattern:     str = mparse.need_pattern(entry, "step");
    val artifact_pattern: str = mparse.need_pattern(entry, "artifact");
    if (step_pattern == nil && (artifact_pattern == nil || str_equals(owner, "step"))) {
        ret err[outcome.Fail].err{outcome.user(mparse.sfmt(alloc,
            "mach.toml: [{}.{}].need entry '{}' must use 'step.<name>' or 'artifact.<name>' with optional '*' wildcards; steps may require only steps",
            owner, name, entry))};
    }
    var hits: u32 = 0;
    var i:    u32 = 0;
    if (step_pattern != nil) {
        for (i < m.step_count) {
            val other: str = mparse.idstr(itn, m.steps[i].name);
            if (mparse.glob_matches(step_pattern, other)) {
                if (str_equals(owner, "step") && str_equals(name, other)) {
                    if (!mparse.is_glob(step_pattern)) { ret err[outcome.Fail].err{outcome.user(mparse.sfmt(alloc, "mach.toml: [{}.{}].need requires itself", owner, name))}; }
                }
                or { hits = hits + 1; }
            }
            i = i + 1;
        }
    }
    or {
        for (i < m.artifact_count) {
            val other: str = mparse.idstr(itn, m.artifacts[i].name);
            if (mparse.glob_matches(artifact_pattern, other)) {
                if (str_equals(name, other)) {
                    if (!mparse.is_glob(artifact_pattern)) { ret err[outcome.Fail].err{outcome.user(mparse.sfmt(alloc, "mach.toml: [artifact.{}].need requires itself", name))}; }
                }
                or { hits = hits + 1; }
            }
            i = i + 1;
        }
    }
    if (hits == 0) {
        ret err[outcome.Fail].err{outcome.user(mparse.sfmt(alloc, "mach.toml: [{}.{}].need entry '{}' matches no declaration in its category", owner, name, entry))};
    }
    ret err[outcome.Fail].ok{};
}

pub fun validate_need_cycles(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[outcome.Fail] {
    if (m.artifact_count == 0) { ret err[outcome.Fail].ok{}; }

    val sr: res[*u8, A.Error] = A.allocate[u8](alloc, m.artifact_count::usize);
    if (sel sr.err) { ret err[outcome.Fail].err{outcome.refused(sr.err)}; }
    val state: *u8                = sr.ok;
    val kr:    res[*u32, A.Error] = A.allocate[u32](alloc, m.artifact_count::usize);
    if (sel kr.err) {
        A.deallocate[u8](alloc, state, m.artifact_count::usize);
        ret err[outcome.Fail].err{outcome.refused(kr.err)};
    }
    val stack: *u32 = kr.ok;

    var i: u32 = 0;
    for (i < m.artifact_count) {
        state[i] = 0;
        i        = i + 1;
    }

    var result: err[outcome.Fail] = err[outcome.Fail].ok{};
    i = 0;
    for (i < m.artifact_count) {
        result = need_cycle_visit(alloc, itn, m, i, state, stack, 0);
        if (sel result.err) { brk; }
        i = i + 1;
    }
    A.deallocate[u8](alloc, state, m.artifact_count::usize);
    A.deallocate[u32](alloc, stack, m.artifact_count::usize);
    ret result;
}

pub fun validate_needs(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[outcome.Fail] {
    var ai: u32 = 0;
    for (ai < m.artifact_count) {
        val a:  *ArtifactDef = ?m.artifacts[ai];
        var ni: u32          = 0;
        for (ni < a.need_count) {
            val checked: err[outcome.Fail] = validate_need_entry(alloc, itn, m,
                "artifact", mparse.idstr(itn, a.name), mparse.idstr(itn, a.need[ni]));
            if (sel checked.err) { ret checked; }
            ni = ni + 1;
        }
        ai = ai + 1;
    }
    var si: u32 = 0;
    for (si < m.step_count) {
        val s:  *StepDef = ?m.steps[si];
        var ni: u32      = 0;
        for (ni < s.need_count) {
            val checked: err[outcome.Fail] = validate_need_entry(alloc, itn, m,
                "step", mparse.idstr(itn, s.name), mparse.idstr(itn, s.need[ni]));
            if (sel checked.err) { ret checked; }
            ni = ni + 1;
        }
        si = si + 1;
    }
    val artifacts: err[outcome.Fail] = validate_need_cycles(alloc, itn, m);
    if (sel artifacts.err) { ret artifacts; }
    if (m.step_count == 0) { ret err[outcome.Fail].ok{}; }
    val sr: res[*u8, A.Error] = A.allocate[u8](alloc, m.step_count::usize);
    if (sel sr.err) { ret err[outcome.Fail].err{outcome.refused(sr.err)}; }
    val state: *u8 = sr.ok;
    fin { A.deallocate[u8](alloc, state, m.step_count::usize); }
    val order_r: res[*u32, A.Error] = A.allocate[u32](alloc, m.step_count::usize);
    if (sel order_r.err) { ret err[outcome.Fail].err{outcome.refused(order_r.err)}; }
    val order: *u32 = order_r.ok;
    fin { A.deallocate[u32](alloc, order, m.step_count::usize); }
    si = 0;
    for (si < m.step_count) {
        state[si] = 0;
        si        = si + 1;
    }
    var count: u32 = 0;
    si = 0;
    for (si < m.step_count) {
        val checked: err[outcome.Fail] = plan.plan_visit(alloc, itn, m.steps, m.step_count, si, state, order, ?count);
        if (sel checked.err) { ret checked; }
        si = si + 1;
    }
    ret err[outcome.Fail].ok{};
}

pub fun link_table_names(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) str {
    ret link.link_table_names(alloc, itn, m.links, m.link_count);
}

pub fun validate_link_refs(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[outcome.Fail] {
    var ai: u32 = 0;
    for (ai < m.artifact_count) {
        val a:  *ArtifactDef = ?m.artifacts[ai];
        var li: u32          = 0;
        for (li < a.link_count) {
            if (find_link_by_name(m, a.link[li]) == nil) {
                var known: str = "no [link.*] table is declared";
                if (m.link_count > 0) { known = mparse.sfmt(alloc, "declared: {}", link_table_names(alloc, itn, m)); }
                ret err[outcome.Fail].err{outcome.user(mparse.sfmt(alloc, "mach.toml: [artifact.{}].link names no [link.*] table: '{}' ({})",
                    mparse.idstr(itn, a.name), mparse.idstr(itn, a.link[li]), known))};
            }
            li = li + 1;
        }
        ai = ai + 1;
    }
    ret err[outcome.Fail].ok{};
}

pub fun validate(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[outcome.Fail] {
    val res_needs: err[outcome.Fail] = validate_needs(alloc, itn, m);
    if (sel res_needs.err) { ret res_needs; }
    ret validate_link_refs(alloc, itn, m);
}

pub fun parse(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, as_root: bool) res[Manifest, outcome.Fail] {
    var m:           Manifest = empty();
    var transferred: bool     = false;
    fin {
        if (!transferred) { dnit(?m, alloc); }
    }

    val res_root_keys: err[outcome.Fail] = mparse.check_root_keys(alloc, t);
    if (sel res_root_keys.err) { ret res[Manifest, outcome.Fail].err{res_root_keys.err}; }

    val proj_o: opt[*toml.Table] = toml.get_table(t, "project");
    if (sel proj_o.none) { ret res[Manifest, outcome.Fail].err{outcome.user("mach.toml: missing [project] table")}; }
    val proj:             *toml.Table       = proj_o.some;
    val res_project_keys: err[outcome.Fail] = mparse.check_keys(alloc, proj, "[project]", mparse.TK_PROJECT, as_root);
    if (sel res_project_keys.err) { ret res[Manifest, outcome.Fail].err{res_project_keys.err}; }

    val id_str: str = mparse.key_text(proj, "id");
    if (str_empty(id_str)) { ret res[Manifest, outcome.Fail].err{outcome.user("mach.toml: [project] is missing required key 'id'")}; }
    val ver_str: str = mparse.key_text(proj, "version");
    if (str_empty(ver_str)) { ret res[Manifest, outcome.Fail].err{outcome.user("mach.toml: [project] is missing required key 'version'")}; }
    val src_str: str = mparse.key_text(proj, "src");
    if (str_empty(src_str)) { ret res[Manifest, outcome.Fail].err{outcome.user("mach.toml: [project] is missing required key 'src'")}; }
    val out_str: str = mparse.key_text(proj, "out");
    if (str_empty(out_str)) { ret res[Manifest, outcome.Fail].err{outcome.user("mach.toml: [project] is missing required key 'out'")}; }

    val res_check_src: err[outcome.Fail] = mparse.check_path(alloc, src_str, "[project].src");
    if (sel res_check_src.err) { ret res[Manifest, outcome.Fail].err{res_check_src.err}; }
    val res_check_out: err[outcome.Fail] = mparse.check_path(alloc, out_str, "[project].out");
    if (sel res_check_out.err) { ret res[Manifest, outcome.Fail].err{res_check_out.err}; }

    if (!mparse.is_valid_id(id_str)) { ret res[Manifest, outcome.Fail].err{outcome.user("mach.toml: [project].id must be an identifier (letters, digits, '_', '-')")}; }
    m.id             = mparse.intern_unwrap(itn, id_str);
    m.version        = mparse.intern_unwrap(itn, ver_str);
    m.src            = mparse.intern_unwrap(itn, src_str);
    m.out_tmpl       = mparse.intern_unwrap(itn, out_str);
    m.default_target = mparse.intern_unwrap(itn, "native");

    val res_targets: err[outcome.Fail] = project.parse_targets(alloc, itn, t, as_root, ?m.targets, ?m.target_count);
    if (sel res_targets.err) { ret res[Manifest, outcome.Fail].err{res_targets.err}; }

    val res_artifacts: err[outcome.Fail] = artifact.parse_artifacts(alloc, itn, t, as_root, ?m.artifacts, ?m.artifact_count);
    if (sel res_artifacts.err) { ret res[Manifest, outcome.Fail].err{res_artifacts.err}; }

    val res_profiles: err[outcome.Fail] = project.parse_profiles(alloc, itn, t, as_root, ?m.profiles, ?m.profile_count);
    if (sel res_profiles.err) { ret res[Manifest, outcome.Fail].err{res_profiles.err}; }

    val res_deps: err[outcome.Fail] = dep.parse_deps(alloc, itn, t, as_root, ?m.deps, ?m.dep_count);
    if (sel res_deps.err) { ret res[Manifest, outcome.Fail].err{res_deps.err}; }

    val res_links: err[outcome.Fail] = link.parse_links(alloc, itn, t, as_root, ?m.links, ?m.link_count);
    if (sel res_links.err) { ret res[Manifest, outcome.Fail].err{res_links.err}; }

    val res_steps: err[outcome.Fail] = step.parse_steps(alloc, itn, t, as_root, ?m.steps, ?m.step_count);
    if (sel res_steps.err) { ret res[Manifest, outcome.Fail].err{res_steps.err}; }

    val res_val: err[outcome.Fail] = validate(alloc, itn, ?m);
    if (sel res_val.err) { ret res[Manifest, outcome.Fail].err{res_val.err}; }

    if (m.target_count == 0) {
        val native: res[*TargetDef, outcome.Fail] = project.make_native_target(alloc, itn);
        if (sel native.err) { ret res[Manifest, outcome.Fail].err{native.err}; }
        m.native_target  = native.ok;
        m.default_target = m.native_target.name;
    }
    transferred = true;
    ret res[Manifest, outcome.Fail].ok{m};
}

pub fun find_artifact(itn: *intern.Interner, m: *Manifest, name: str) *ArtifactDef {
    val res_id: res[intern.StrId, A.Error] = intern.intern(itn, name);
    if (sel res_id.err) { ret nil; }
    ret find_artifact_by_name(m, res_id.ok);
}

pub fun find_artifact_by_name(m: *Manifest, name: intern.StrId) *ArtifactDef {
    ret artifact.find_artifact_by_name(m.artifacts, m.artifact_count, name);
}

pub fun find_target_by_name(itn: *intern.Interner, m: *Manifest, name: str) *TargetDef {
    ret project.find_target_by_name(itn, m.targets, m.target_count, name);
}

pub fun find_link_by_name(m: *Manifest, name: intern.StrId) *LinkDef {
    ret link.find_link_by_name(m.links, m.link_count, name);
}

pub fun find_link(itn: *intern.Interner, m: *Manifest, name: str) *LinkDef {
    ret link.find_link(itn, m.links, m.link_count, name);
}

pub fun find_step_index(m: *Manifest, name: intern.StrId) i64 {
    ret step.find_step_index(m.steps, m.step_count, name);
}

pub fun find_artifact_index(m: *Manifest, name: intern.StrId) i64 {
    ret artifact.find_artifact_index(m.artifacts, m.artifact_count, name);
}

pub fun artifact_pinned_target(itn: *intern.Interner, m: *Manifest, a: *ArtifactDef) *TargetDef {
    ret artifact.artifact_pinned_target(itn, m.targets, m.target_count, a);
}

pub fun artifact_target_names(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, a: *ArtifactDef) str {
