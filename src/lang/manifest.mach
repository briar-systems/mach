    ret code;
}

test "mach.lang.manifest.manifest_add_dep_table:matches_crlf_when_the_file_uses_it" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val crlf_source: str = "[project]\r\nid = \"p\"\r\nversion = \"0.1.0\"\r\nsrc = \"src\"\r\nout = \"o\"\r\n";
    var spec: DepTableSpec;
    spec.name   = "newlib";
    spec.source = DEP_SOURCE_PATH;
    spec.value  = "../newlib";
    spec.ref    = "";

    val r: R.Result[str, str] = manifest_add_dep_table(?alloc, crlf_source, ?spec);
    if (R.is_err[str, str](r)) { code = 1; }
    or {
        val out: str = R.unwrap_ok[str, str](r);
        if (!str_starts_with(out, crlf_source)) { code = 1; }
        val added_r: R.Result[str, str] = str_copy_slice(?alloc, out, str_len(crlf_source), str_len(out) - str_len(crlf_source));
        if (R.is_err[str, str](added_r)) { code = 1; }
        or {
            val added: str = R.unwrap_ok[str, str](added_r);
            var i: usize = 0;
            var n: usize = str_len(added);
            for (i < n) {
                if (added[i] == '\n'::u8 && (i == 0 || added[i - 1] != '\r'::u8)) { code = 1; }
                i = i + 1;
            }
            str_free(?alloc, added);
        }
    }

    arena.dnit(?ar);
    ret code;
}

