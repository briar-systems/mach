    ret code;
}

test "mach.lang.manifest.parse:dep_conflict" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val a: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[dep.std]\nversion=\"1.0\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (!(sel a.err && str_equals(outcome.describe(a.err), "mach.toml: [dep.std].version is reserved for the registry era"))) { code = 1; }

    val b: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[dep.std]\ngit=\"u\"\npath=\"p\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (!(sel b.err && str_equals(outcome.describe(b.err), "mach.toml: [dep.std] needs exactly one source key: 'git' or 'path'"))) { code = 1; }

    val missing_ref: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (!(sel missing_ref.err && str_contains(outcome.describe(missing_ref.err), "missing required key 'ref'"))) { code = 1; }

    val path_ref: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\npath=\"../std\"\nref=\"branch/main\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (!(sel path_ref.err && str_contains(outcome.describe(path_ref.err), "not allowed for path sources"))) { code = 1; }

    val raw_ref: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"main\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (!(sel raw_ref.err && str_contains(outcome.describe(raw_ref.err), "branch/<name>"))) { code = 1; }

    val short_commit: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"commit/01234567\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (!(sel short_commit.err && str_contains(outcome.describe(short_commit.err), "full-object-id"))) { code = 1; }

    val hidden_ref: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"branch/.hidden\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel hidden_ref.ok) { code = 1; }

    val lock_ref: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"tag/release.lock\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel lock_ref.ok) { code = 1; }

    val uppercase_commit: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"commit/0123456789ABCDEF0123456789ABCDEF01234567\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel uppercase_commit.ok) { code = 1; }

    val prefixed: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"branch/main\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel prefixed.err) { code = 1; }

    val full_commit: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"commit/0123456789abcdef0123456789abcdef01234567\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel full_commit.err) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.canonical_module:binds_the_entry_shared_by_default_library_artifacts" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    var cases: [8]str;
    var public: [8]bool;
    cases[0] = ""; public[0] = false;
    cases[1] = "[artifact.a]\nkind=\"static\"\nentry=\"api.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n"; public[1] = false;
    cases[2] = "[artifact.a]\nkind=\"bin\"\ndefault=true\nentry=\"api.mach\"\nout=\"bin/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n"; public[2] = false;
    cases[3] = "[artifact.a]\nkind=\"static\"\ndefault=true\nentry=\"api.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[artifact.b]\nkind=\"bin\"\ndefault=true\nentry=\"main.mach\"\nout=\"bin/b\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n"; public[3] = true;
    cases[4] = "[artifact.a]\nkind=\"shared\"\ndefault=true\nentry=\"api.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n"; public[4] = true;
    cases[5] = "[artifact.a]\nkind=\"static\"\ndefault=true\nentry=\"api.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[artifact.b]\nkind=\"shared\"\ndefault=true\nentry=\"api.mach\"\nout=\"lib/b\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n"; public[5] = true;
    cases[6] = "[artifact.a]\nkind=\"static\"\ndefault=true\nentry=\"api.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[artifact.b]\nkind=\"shared\"\ndefault=true\nentry=\"other.mach\"\nout=\"lib/b\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n"; public[6] = false;
    cases[7] = "[artifact.z]\nkind=\"static\"\nentry=\"other.mach\"\nout=\"lib/z\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[artifact.a]\nkind=\"static\"\ndefault=true\nentry=\"api.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n"; public[7] = true;
    var i: usize = 0;
    for (i < 8) {
        val parsed: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}{}", head, cases[i]));
        if (sel parsed.err) { ret 2; }
        var m: Manifest = parsed.ok;
        val entry: intern.StrId = canonical_module(?m);
        if (!public[i]) {
            if (entry != intern.STR_NIL) { ret 3; }
        } or {
            val text: opt[str] = intern.lookup_typed(?itn, entry);
            if (sel text.none) { ret 4; }
            if (!str_equals(text.some, "api.mach")) { ret 4; }
        }
        i = i + 1;
    }
    ret 0;
}
test "mach.lang.manifest.parse:dependency_name_is_portable" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
