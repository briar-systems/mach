    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.plan_steps" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[link.obj]\nsource=\"local\"\npath=\"{project.out}/o/a.o\"\nos=\"*\"\n[link.win]\nsource=\"local\"\npath=\"{project.out}/o/w.o\"\nos=\"windows\"\n[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[\"obj\",\"win\"]\nneed=[\"gen\"]\n[step.compile]\nargv=[\"cc\"]\nin=[\"a.c\"]\nout=[\"{project.out}/o/a.o\"]\n[step.winc]\nargv=[\"cc\"]\nin=[\"w.c\"]\nout=[\"{project.out}/o/w.o\"]\n[step.gen]\nargv=[\"g\"]\nin=[\"g.in\"]\nout=[\"{project.out}/g.h\"]\nneed=[\"dep\"]\n[step.dep]\nargv=[\"d\"]\nin=[\"d.in\"]\nout=[\"{project.out}/d.o\"]\n";
    val rm: R.Result[Manifest, str] = tparse_lenient(?alloc, ?itn, src);
    if (R.is_err[Manifest, str](rm)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](rm);
        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        if (tl == nil) { code = 1; }
        or {
            var names: [1]intern.StrId;
            names[0] = intern_unwrap(?itn, "app");
            var order: *u32 = nil;
            var count: u32 = 0;
            var v: TmplVars = tmpl_vars_of(?itn, tl, "debug");
            val r: R.Result[R.Void, str] = plan_steps(?alloc, ?itn, ?m, ?names[0], 1, tl, "out/linux", ?v, ?order, ?count);
            if (R.is_err[R.Void, str](r)) { code = 1; }
            or {
                var has_compile: bool = false; var has_gen: bool = false; var has_dep: bool = false; var has_winc: bool = false;
                var gen_pos: i64 = -1; var dep_pos: i64 = -1;
                var k: u32 = 0;
                for (k < count) {
                    val nm: str = idstr(?itn, m.steps[order[k]].name);
                    if (str_equals(nm, "compile")) { has_compile = true; }
                    if (str_equals(nm, "gen"))     { has_gen = true;  gen_pos = k::i64; }
                    if (str_equals(nm, "dep"))     { has_dep = true;  dep_pos = k::i64; }
                    if (str_equals(nm, "winc"))    { has_winc = true; }
                    k = k + 1;
                }
                if (count != 3)                              { code = 1; }
                if (!has_compile || !has_gen || !has_dep)    { code = 1; }
                if (has_winc)                                { code = 1; }
                if (dep_pos < 0 || gen_pos < 0 || dep_pos > gen_pos) { code = 1; }
            }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.plan_steps:cycle" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[\"a\"]\n[step.a]\nargv=[\"x\"]\nin=[\"i\"]\nout=[\"{project.out}/a.o\"]\nneed=[\"b\"]\n[step.b]\nargv=[\"y\"]\nin=[\"i\"]\nout=[\"{project.out}/b.o\"]\nneed=[\"a\"]\n";
    val rm: R.Result[Manifest, str] = tparse(?alloc, ?itn, src);
    if (R.is_err[Manifest, str](rm)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](rm);
        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        if (tl == nil) { code = 1; }
        or {
            var names: [1]intern.StrId;
            names[0] = intern_unwrap(?itn, "app");
            var order: *u32 = nil;
            var count: u32 = 0;
            var v: TmplVars = tmpl_vars_of(?itn, tl, "debug");
            val r: R.Result[R.Void, str] = plan_steps(?alloc, ?itn, ?m, ?names[0], 1, tl, "out/linux", ?v, ?order, ?count);
            if (R.is_ok[R.Void, str](r) || !str_equals(R.unwrap_err[R.Void, str](r), "mach.toml: build step 'a' is part of a 'need' cycle")) { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.plan_export_steps" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[link.exp]\nsource=\"local\"\npath=\"{project.out}/o/m.o\"\nos=\"*\"\nexport=true\n[link.noexp]\nsource=\"local\"\npath=\"{project.out}/o/n.o\"\nos=\"*\"\nexport=false\n[link.win]\nsource=\"local\"\npath=\"{project.out}/o/w.o\"\nos=\"windows\"\nexport=true\n[step.mk]\nargv=[\"cc\"]\nin=[\"m.c\"]\nout=[\"{project.out}/o/m.o\"]\n[step.no]\nargv=[\"cc\"]\nin=[\"n.c\"]\nout=[\"{project.out}/o/n.o\"]\n[step.winmk]\nargv=[\"cc\"]\nin=[\"w.c\"]\nout=[\"{project.out}/o/w.o\"]\n";
    val rm: R.Result[Manifest, str] = tparse_lenient(?alloc, ?itn, src);
    if (R.is_err[Manifest, str](rm)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](rm);
        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        if (tl == nil) { code = 1; }
        or {
            var order: *u32 = nil;
            var count: u32 = 0;
            var v: TmplVars = tmpl_vars_of(?itn, tl, "debug");
            val r: R.Result[R.Void, str] = plan_export_steps(?alloc, ?itn, ?m, tl, "out/linux", ?v, ?order, ?count);
            if (R.is_err[R.Void, str](r)) { code = 1; }
            or {
                if (count != 1) { code = 1; }
                or {
                    if (!str_equals(idstr(?itn, m.steps[order[0]].name), "mk")) { code = 1; }
                }
            }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.step_plans:exact_subset_extent_and_allocation_failure" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    val src: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[link.exp]\nsource=\"local\"\npath=\"{project.out}/pick.o\"\nos=\"*\"\nexport=true\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[\"pick\"]\n[step.pick]\nargv=[\"pick\"]\nin=[]\nout=[\"{project.out}/pick.o\"]\nneed=[]\n[step.extra_a]\nargv=[\"a\"]\nin=[]\nout=[\"{project.out}/a.o\"]\nneed=[]\n[step.extra_b]\nargv=[\"b\"]\nin=[]\nout=[\"{project.out}/b.o\"]\nneed=[]\n[step.extra_c]\nargv=[\"c\"]\nin=[]\nout=[\"{project.out}/c.o\"]\nneed=[]\n";
    val parsed_r: R.Result[Manifest, str] = tparse_lenient(?alloc, ?itn, src);
    if (R.is_err[Manifest, str](parsed_r)) { arena.dnit(?ar); ret 1; }
    var m: Manifest = R.unwrap_ok[Manifest, str](parsed_r);
    val target: *TargetDef = find_target_by_name(?itn, ?m, "linux");
    if (target == nil) { arena.dnit(?ar); ret 1; }
    var v: TmplVars = tmpl_vars_of(?itn, target, "debug");
    var names: [1]intern.StrId;
    names[0] = intern_unwrap(?itn, "app");
    var bad: bool = false;

    var success_probe: PlanAllocProbe; var success_alloc: A.Allocator;
    if (!plan_probe_make(?success_probe, ?success_alloc, 0)) { arena.dnit(?ar); ret 1; }
    var order: *u32 = nil; var count: u32 = 0;
    val planned: R.Result[R.Void, str] = plan_steps(?success_alloc, ?itn, ?m, ?names[0], 1, target, "out/linux", ?v, ?order, ?count);
    if (R.is_err[R.Void, str](planned) || count != 1 || order == nil) { bad = true; }
    if (order != nil) { A.deallocate[u32](?success_alloc, order, count::usize); }
    if (success_probe.live != 0 || success_probe.mismatch) { bad = true; }

    var export_probe: PlanAllocProbe; var export_alloc: A.Allocator;
    if (!plan_probe_make(?export_probe, ?export_alloc, 0)) { arena.dnit(?ar); ret 1; }
    order = nil; count = 0;
    val exported: R.Result[R.Void, str] = plan_export_steps(?export_alloc, ?itn, ?m, target, "out/linux", ?v, ?order, ?count);
    if (R.is_err[R.Void, str](exported) || count != 1 || order == nil) { bad = true; }
    if (order != nil) { A.deallocate[u32](?export_alloc, order, count::usize); }
    if (export_probe.live != 0 || export_probe.mismatch) { bad = true; }

    var fail_at: u32 = 1;
    for (fail_at <= 3) {
        var fail_probe: PlanAllocProbe; var fail_alloc: A.Allocator;
        if (!plan_probe_make(?fail_probe, ?fail_alloc, fail_at)) { arena.dnit(?ar); ret 1; }
        order = nil; count = 0;
        val failed: R.Result[R.Void, str] = plan_steps(?fail_alloc, ?itn, ?m, ?names[0], 1, target, "out/linux", ?v, ?order, ?count);
        if (R.is_ok[R.Void, str](failed) || order != nil || count != 0 || fail_probe.live != 0 || fail_probe.mismatch) { bad = true; }
        fail_at = fail_at + 1;
    }
    arena.dnit(?ar);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.parse:id_and_out_validation" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
