        or {
            var tbl: toml.Table = R.unwrap_ok[toml.Table, str](tbl_r);
            if (!str_equals(toml.get_str(?tbl, "dep.winlib.path"), spec.value)) { code = 1; }
            toml.dnit(?alloc, ?tbl);
