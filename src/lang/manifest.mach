# the file name of a project manifest, looked up in a project root
pub val MANIFEST_FILE: str = "mach.toml";

fun nul_escape_at(src: *u8, i: usize, n: usize) bool {
    if (i + 5 < n && src[i] == '\\' && src[i + 1] == 'u') {
        ret src[i + 2] == '0' && src[i + 3] == '0' && src[i + 4] == '0' && src[i + 5] == '0';
    }
    if (i + 9 < n && src[i] == '\\' && src[i + 1] == 'U') {
        var j: usize = i + 2;
        for (j < i + 10) {
            if (src[j] != '0') { ret false; }
            j = j + 1;
        }
        ret true;
    }
    ret false;
}

# reject manifest text that would carry a NUL byte into the TOML parser
# ---
# src: manifest bytes, not required to be NUL-terminated
# n: number of bytes to scan
# ret: ok when clean; err "mach.toml: source cannot contain NUL bytes" for a raw
#  0 byte anywhere, or "mach.toml: strings cannot contain NUL bytes" for a
#  `\u0000` or `\U00000000` escape inside a basic (double-quoted) string,
#  single-line or multi-line. comments and literal (single-quoted) strings are
#  skipped without escape checks
pub fun validate_source_bytes(src: *u8, n: usize) R.Result[R.Void, str] {
    var i: usize = 0;
    for (i < n) {
        if (src[i] == 0) { ret R.err[R.Void, str]("mach.toml: source cannot contain NUL bytes"); }
        i = i + 1;
    }
    i = 0;
    var mode: u8 = 0;
    var multiline: bool = false;
    for (i < n) {
        val c: u8 = src[i];
        if (mode == 0) {
            if (c == '#') {
                for (i < n && src[i] != '\n') { i = i + 1; }
                cnt;
            }
            if (c == '"') {
                mode = 1;
                multiline = i + 2 < n && src[i + 1] == '"' && src[i + 2] == '"';
                if (multiline) { i = i + 3; } or { i = i + 1; }
                cnt;
            }
            if (c == '\'') {
                mode = 2;
                multiline = i + 2 < n && src[i + 1] == '\'' && src[i + 2] == '\'';
                if (multiline) { i = i + 3; } or { i = i + 1; }
                cnt;
            }
            i = i + 1;
            cnt;
        }
        if (mode == 1) {
            if (c == '\\') {
                if (nul_escape_at(src, i, n)) { ret R.err[R.Void, str]("mach.toml: strings cannot contain NUL bytes"); }
                i = i + 2;
                cnt;
            }
            if (c == '"') {
                var quote_end: usize = i;
                for (multiline && quote_end < n && src[quote_end] == '"') { quote_end = quote_end + 1; }
                if (multiline && quote_end - i >= 3) {
                    mode = 0;
                    multiline = false;
                    i = quote_end;
                    cnt;
                }
                if (!multiline) {
                    mode = 0;
                    i = i + 1;
                    cnt;
                }
            }
            i = i + 1;
            cnt;
        }
        if (c == '\'' && multiline) {
            var quote_end: usize = i;
            for (quote_end < n && src[quote_end] == '\'') { quote_end = quote_end + 1; }
            if (quote_end - i >= 3) {
                mode = 0;
                multiline = false;
                i = quote_end;
                cnt;
            }
        }
        if (c == '\'' && !multiline) {
            mode = 0;
            i = i + 1;
            cnt;
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

# `validate_source_bytes` over a NUL-terminated string
# ---
# src: manifest text
# ret: as `validate_source_bytes`
pub fun validate_source_text(src: str) R.Result[R.Void, str] {
    ret validate_source_bytes(src::*u8, str_len(src));
}

# optimisation level of a profile, decoded from `[profile.<name>].opt`
pub def MOpt: u8;

# no `opt` key; produced only for a dependency manifest profile, never for the root
pub val MOPT_DEFAULT: MOpt = 0;
# `opt = 0`: the debug pipeline
pub val MOPT_DEBUG:   MOpt = 1;
# `opt = 1` or `opt = 2`: the release pipeline; both integers map here
pub val MOPT_RELEASE: MOpt = 2;

# what happens when a vector operator has no packed instruction on the target,
# decoded from `[profile.<name>].simd`
pub def SimdMode: u8;

# `simd = "scalarize"`: emit the scalar expansion; the default for a dependency profile
pub val SIMD_SCALARIZE: SimdMode = 0;
# `simd = "require"`: a missing packed instruction is a build error
pub val SIMD_REQUIRE:   SimdMode = 1;

# the library shape of a build unit, decoded from `[artifact.<name>].kind`
pub def LibKind: u8;

# `kind = "static"`; also the value a `bin` unit carries, so check `is_lib` first
pub val LIBKIND_STATIC: LibKind = 0;
# `kind = "shared"`
pub val LIBKIND_SHARED: LibKind = 1;

def TableKind: u8;

val TK_PROJECT:  TableKind = 0;
val TK_TARGET:   TableKind = 1;
val TK_ARTIFACT: TableKind = 2;
val TK_PROFILE:  TableKind = 3;
val TK_DEP:      TableKind = 4;
val TK_LINK:     TableKind = 5;
val TK_STEP:     TableKind = 6;

# one `[target.<name>]` table as parsed; the string fields hold interned copies of
# the manifest text, unvalidated against the target registry
# ---
# name: the table key; a portable identifier, never `native`
# is_default: `default = true`; false when the key is absent
# env: the `env` key, or STR_NIL when absent; parse checks only that it is a
#  non-empty string, the isa validates the value later
# isa: the required `isa` key
# os: the required `os` key
# abi: the required `abi` key
# of: the `of` object-format override, or STR_NIL when absent
# platform: the `platform` tag, or STR_NIL when absent
# base: the `base` load address, 0 when absent
# stack_reserve: the `stack_reserve` byte count, 0 when absent
# stack_commit: the `stack_commit` byte count, 0 when absent
pub rec TargetDef {
    name:     intern.StrId;
    is_default: bool;
    env:      intern.StrId;
    isa:      intern.StrId;
    os:       intern.StrId;
    abi:      intern.StrId;
    of:       intern.StrId;
    platform: intern.StrId;
    base:     u64;
    stack_reserve: u64;
    stack_commit:  u64;
}

# one `[artifact.<name>]` table as parsed. the three arrays are owned by the
# manifest and freed by `dnit`
# ---
# name: the table key; a portable identifier
# kind: the required `kind` key, one of "bin", "static", "shared"
# entry: the required `entry` key, a project-relative path under `[project].src`
# out: the required `out` key, an unexpanded path template relative to the
#  expanded `[project].out`
# targets: the required `targets` array of declared target names or "*"; nil when empty
# target_count: length of `targets`
# link: the `link` array of `[link.<name>]` names; required at the root (`[]` for
#  none), optional in a dependency; nil when empty
# link_count: length of `link`
# need: the `need` array of step and artifact names or globs; required at the root
#  (`[]` for none), optional in a dependency; nil when empty
# need_count: length of `need`
# is_lib: true unless `kind = "bin"`
# is_default: `default = true`; false when the key is absent
# subsystem: the `subsystem` key, console when absent; only "console" and "gui" parse
# icon: the `icon` path, or STR_NIL when absent; `bin` artifacts only
# app_manifest: the `manifest` path, or STR_NIL when absent; `bin` artifacts only
pub rec ArtifactDef {
    name:         intern.StrId;
    kind:         intern.StrId;
    entry:        intern.StrId;
    out:          intern.StrId;
    targets:      *intern.StrId;
    target_count: u32;
    link:         *intern.StrId;
    link_count:   u32;
    need:         *intern.StrId;
    need_count:   u32;
    is_lib:       bool;
    is_default:   bool;
    subsystem:    of.Subsystem;
    icon:         intern.StrId;
    app_manifest: intern.StrId;
}

# one `[profile.<name>]` table as parsed, or one of the two profiles synthesized
# when the manifest declares none: `debug` (opt 0, debug true, vectorize false,
# default) and `release` (opt 2, debug false, vectorize true)
# ---
# name: the table key; a portable identifier
# is_default: `default = true`; false when the key is absent. more than one
#  default across declared profiles is a parse error at the root
# opt: the `opt` key, required at the root; MOPT_DEFAULT when absent in a dependency
# debug: the `debug` key, required at the root; false when absent in a dependency
# simd: the `simd` key, required at the root; SIMD_SCALARIZE when absent in a dependency
# vectorize: the optional `vectorize` key, true when absent
# float_reassoc: the optional `float_reassoc` key, false when absent
pub rec ProfileDef {
    name:          intern.StrId;
    is_default:    bool;
    opt:           MOpt;
    debug:         bool;
    simd:          SimdMode;
    vectorize:     bool;
    float_reassoc: bool;
}

# one `[dep.<name>]` table as parsed. exactly one of `git` and `path` is set
# ---
# name: the table key; a portable identifier
# git: the `git` clone URL, or STR_NIL for a path dependency
# path: the `path` directory, or STR_NIL for a git dependency
# ref: the `ref` key, required with `git` and rejected with `path`; one of
#  `branch/<name>`, `tag/<name>`, `commit/<40 or 64 lowercase hex digits>`.
#  STR_NIL for a path dependency
pub rec DepDef {
    name: intern.StrId;
    git:  intern.StrId;
    path: intern.StrId;
    ref:  intern.StrId;
}

# where a `[link.<name>]` entry is resolved from, decoded from its `source` key
pub def LinkSource: u8;

# `source = "local"`: a file at a project-relative `path`
pub val LINK_LOCAL:     LinkSource = 0;

# `source = "system"`: a system library found by `name`
pub val LINK_SYSTEM:    LinkSource = 1;

# `source = "framework"`: a macOS framework found by `name`
pub val LINK_FRAMEWORK: LinkSource = 2;

# one `[link.<name>]` table as parsed. the four arrays are owned by the manifest
# and freed by `dnit`
# ---
# name: the table key; a portable identifier
# source: the required `source` key
# library: the `library` key; defaults to `name` when absent. an empty string is an error
# lib_name: the `name` key, required for system and framework sources and rejected
#  for local; STR_NIL for local
# path: the `path` key, required for a local source and rejected otherwise; a
#  project-relative path template, STR_NIL for non-local
# symbols: the `symbols` array; every entry non-empty and unique; nil when absent
# symbol_count: length of `symbols`
# os: the `os` filter axis: a string, an array of strings, or "*"; nil when absent or `[]`
# os_count: length of `os`
# os_present: whether the `os` key was written. absent matches every target, `[]`
#  matches none. required at the root, where every value must be canonical or "*"
# isa: the `isa` filter axis, as `os`
# isa_count: length of `isa`
# isa_present: as `os_present`
# abi: the `abi` filter axis, as `os`
# abi_count: length of `abi`
# abi_present: as `os_present`
# export: the `export` key, required at the root; false when absent in a dependency
# include_referenced: the `include` key: false for "always" (the default), true for "referenced"
pub rec LinkDef {
    name:        intern.StrId;
    source:      LinkSource;
    library:     intern.StrId;
    lib_name:    intern.StrId;
    path:        intern.StrId;
    symbols:      *intern.StrId;
    symbol_count: u32;
    os:          *intern.StrId;
    os_count:    u32;
    os_present:  bool;
    isa:         *intern.StrId;
    isa_count:   u32;
    isa_present: bool;
    abi:         *intern.StrId;
    abi_count:   u32;
    abi_present: bool;
    export:      bool;
    include_referenced: bool;
}

# a `[link.<name>]` entry resolved for one target, as the linker consumes it.
# the symbol array is owned; release it with `free_link_claims`
# ---
# source: copied from the link
# text: for a local source, the `path` expanded and interned; otherwise the link's `name`
# library: the link's logical `library` name
# symbols: an owned copy of the link's `symbols`, or nil when it has none
# symbol_count: length of `symbols`
# include_referenced: copied from the link
pub rec LinkRequirement {
    source:  LinkSource;
    text:    intern.StrId;
    library: intern.StrId;

    symbols:      *intern.StrId;
    symbol_count: u32;
    include_referenced: bool;
}

# one `[step.<name>]` table as parsed. the six arrays are owned by the manifest
# and freed by `dnit`. the removed keys `cmd` and `shell` are rejected by name
# ---
# name: the table key; an identifier
# argv: the required, non-empty `argv` array; `argv[0]` is non-empty
# argv_count: length of `argv`
# env_keys: keys of the `env` table, sorted case-insensitively then bytewise;
#  every key non-empty, free of '=', and unique ignoring case. nil when absent
# env_values: the string value of each key, parallel to `env_keys`
# env_count: length of both `env` arrays
# in: the required `in` array of project-relative paths
# in_count: length of `in`
# out: the required `out` array of project-relative paths; a '*' is rejected
# out_count: length of `out`
# need: the `need` array of step names; required at the root (`[]` for none),
#  optional in a dependency
# need_count: length of `need`
# timeout_seconds: the `timeout_seconds` key, an integer of at least 1; 0 when absent
pub rec StepDef {
    name:        intern.StrId;
    argv:        *intern.StrId;
    argv_count:  u32;
    env_keys:    *intern.StrId;
    env_values:  *intern.StrId;
    env_count:   u32;
    in:          *intern.StrId;
    in_count:    u32;
    out:         *intern.StrId;
    out_count:   u32;
    need:        *intern.StrId;
    need_count:  u32;
    timeout_seconds: i64;
}

# a parsed `mach.toml`. every string is an interned id; every array is owned and
# freed by `dnit`, so the counts are the allocation extents
# ---
# id: the required `[project].id`, a portable identifier
# version: the required `[project].version`, carried verbatim
# src: the required `[project].src`, a project-relative path
# out_tmpl: the required `[project].out`, an unexpanded path template
# default_target: always the interned string "native"
# native_target: the owned synthesized host definition when no targets are declared
# targets: the `[target.*]` tables, nil when none
# target_count: length of `targets`
# artifacts: the `[artifact.*]` tables, nil when none
# artifact_count: length of `artifacts`
# profiles: the `[profile.*]` tables, or the two synthesized ones when none are declared
# profile_count: length of `profiles`
# deps: the `[dep.*]` tables, nil when none
# dep_count: length of `deps`
# links: the `[link.*]` tables, nil when none
# link_count: length of `links`
# steps: the `[step.*]` tables, nil when none
# step_count: length of `steps`
pub rec Manifest {
    id:               intern.StrId;
    version:          intern.StrId;
    src:              intern.StrId;
    out_tmpl:         intern.StrId;
    default_target:   intern.StrId;
    targets:          *TargetDef;
    target_count:     u32;
    native_target:    *TargetDef;
    artifacts:        *ArtifactDef;
    artifact_count:   u32;
    profiles:         *ProfileDef;
    profile_count:    u32;
    deps:             *DepDef;
    dep_count:        u32;
    links:            *LinkDef;
    link_count:       u32;
    steps:            *StepDef;
    step_count:       u32;
    deprecated:       *DeprecatedKey;
    deprecated_count: u32;
}

# a key that 4.26.x accepted and never read: kept through 4.30.0 behind a warning, refused in 5.0.0
# ---
# table: the table label, `[project]` or `[profile.debug]`
# key: the key as written
pub rec DeprecatedKey {
    table: str;
    key:   str;
}

# the one `entry` every artifact of the manifest shares
# ---
# m: a parsed manifest
# ret: the shared entry id; STR_NIL when there are no artifacts or two artifacts
#  name different entries
pub fun canonical_module(m: *Manifest) intern.StrId {
    var entry: intern.StrId = intern.STR_NIL;
    var i: u32 = 0;
    for (i < m.artifact_count) {
        if (entry == intern.STR_NIL) { entry = m.artifacts[i].entry; }
        or (m.artifacts[i].entry != entry) { ret intern.STR_NIL; }
        i = i + 1;
    }
    ret entry;
}

# what the caller asked to build: a target, a profile, and optionally an
# artifact. empty strings mean "not selected"
# ---
# target: a declared target name, or "" to resolve `native` (or the artifact's pinned target)
# profile: a declared profile name, or "" for the default profile
# artifact: an artifact name, read only when `has_artifact`
# want_lib: with `has_artifact`, whether the named artifact must be a library
#  (true) or a `bin` (false); a name with the wrong shape does not match
# has_artifact: whether `artifact` and `want_lib` are set
# legacy_default: set by `select_primary_artifact` when it picked the first
#  declared candidate because none carried `default = true`
pub rec Selection {
    target:       str;
    profile:      str;
    artifact:     str;
    want_lib:     bool;
    has_artifact: bool;
    legacy_default: bool;
}

# one resolved build cell: a target, a profile, and an artifact with every path
# expanded. produced by `resolve_build_unit`; `libs` is owned by the unit
# ---
# target: the resolved target; points into the manifest, except for the host
#  target synthesized when the manifest declares no targets
# artifact: the resolved artifact, pointing into the manifest
# target_name: `target.name`
# profile_name: the resolved profile's name
# entry: the artifact's `entry`
# bin_path: the artifact's output: the expanded `[project].out` joined with the
#  expanded artifact `out`
# obj_root: `<expanded project out>/obj`
# ir_root: `<expanded project out>/ir`
# asm_root: `<expanded project out>/asm`
# test_root: `<expanded project out>/test/{name}`, with `{name}` left literal for
#  the test runner to fill
# opt: from the resolved profile
# debug: from the resolved profile
# simd: from the resolved profile
# vectorize: from the resolved profile
# float_reassoc: from the resolved profile
# is_lib: the artifact's `is_lib`
# kind: LIBKIND_SHARED for `kind = "shared"`, LIBKIND_STATIC otherwise, including for a `bin`
# libs: the artifact's `link` entries that match the target, resolved in `link`
#  order and sized exactly; a `link` name matching no `[link.*]` table is skipped
# lib_count: length of `libs`
# legacy_target_default: `native` fell back to the first declared target because none
#  carried `default = true`
# legacy_profile_default: the first declared profile was taken because none carried
#  `default = true`
# warned: `native` matched no declared target for the host and a declared target
#  was chosen anyway; the driver prints the warning
pub rec BuildUnit {
    target:       *TargetDef;
    artifact:     *ArtifactDef;
    target_name:  intern.StrId;
    profile_name: intern.StrId;
    entry:        intern.StrId;
    bin_path:     intern.StrId;
    obj_root:     intern.StrId;
    ir_root:      intern.StrId;
    asm_root:     intern.StrId;
    test_root:    intern.StrId;
    opt:          MOpt;
    debug:         bool;
    simd:          SimdMode;
    vectorize:     bool;
    float_reassoc: bool;
    is_lib:       bool;
    kind:         LibKind;
    libs:         *LinkRequirement;
    lib_count:    u32;
    legacy_target_default:   bool;
    legacy_profile_default:  bool;
    warned:       bool;
}

# the outcome of target resolution for a selection
# ---
# target: the chosen target; points into the manifest unless synthesized for a
#  manifest with no `[target.*]`, in which case it is allocated and never freed by `dnit`
# warned: `native` matched no host target and a declared target was chosen anyway
# legacy_default: the chosen target is the first declared one, taken because none
#  carried `default = true`
# target borrows its manifest-owned declaration until manifest destruction
pub rec ResolvedTarget {
    target: *TargetDef;
    warned: bool;
    legacy_default: bool;
}

# the profile a selection resolves to, copied out of its `ProfileDef`
# ---
# name: the profile's name
# opt: as `ProfileDef`
# debug: as `ProfileDef`
# simd: as `ProfileDef`
# vectorize: as `ProfileDef`
# float_reassoc: as `ProfileDef`
# legacy_default: the first declared profile was taken because several are declared
#  and none carries `default = true`
pub rec ResolvedProfile {
    name:          intern.StrId;
    opt:           MOpt;
    debug:         bool;
    simd:          SimdMode;
    vectorize:     bool;
    float_reassoc: bool;
    legacy_default: bool;
}

# the values a path template expands with; see `expand`
# ---
# target: `{target.name}`
# isa: `{target.isa}`
# os: `{target.os}`
# abi: `{target.abi}`
# profile: `{profile.name}`
# reqs: the artifacts this expansion may name as `{artifact.<id>.out}`; nil when none
# req_count: length of `reqs`
pub rec TmplVars {
    target:  str;
    isa:     str;
    os:      str;
    abi:     str;
    profile: str;
    reqs:      *ArtifactReq;
    req_count: u32;
}

# one artifact another artifact requires, as `{artifact.<id>.out}` resolves it
# ---
# name: the required artifact's name
# out: its final output path when it builds for exactly one target here, or ""
#  when it builds for several, which makes `{artifact.<id>.out}` an error
pub rec ArtifactReq {
    name: str;
    out:  str;
}

rec StrArr {
    items:   *intern.StrId;
    count:   u32;
    present: bool;
}

# an sfmt result is owned and freed by its receiver; a formatting oom has nothing owned to hand back
fun sfmt(alloc: *A.Allocator, fmt: str, va: ...) str {
    val r: R.Result[str, str] = format.sprint(alloc, fmt, va...);
    if (R.is_err[str, str](r)) { panic("mach.toml: out of memory while formatting a diagnostic\n"); }
    ret R.unwrap_ok[str, str](r);
}

fun host_isa_name() str {
    ret isa.arch_name_for(tgt.host_arch_id());
}

fun host_os_name() str {
    ret os.os_name_for(tgt.host_os_id());
}

# the host as "<isa>-<os>", e.g. "x86_64-linux"
# ---
# alloc: owns the returned string
# ret: the formatted tuple; on allocation failure the literal "out of memory",
#  which must not be freed
pub fun host_tuple(alloc: *A.Allocator) str {
    ret sfmt(alloc, "{}-{}", host_isa_name(), host_os_name());
}

# whether `s` is a portable identifier: non-empty, only ASCII letters, digits,
# '_' and '-'. the rule for project, target, artifact, profile, dependency,
# link and step names
# ---
# s: the candidate
# ret: true when every byte is allowed
pub fun is_valid_id(s: str) bool {
    if (str_empty(s)) { ret false; }
    val n: usize = str_len(s);
    var i: usize = 0;
    for (i < n) {
        val c: u8 = s[i];
        if (!((c >= 'A' && c <= 'Z')
           || (c >= 'a' && c <= 'z')
           || (c >= '0' && c <= '9')
           || c == '_' || c == '-')) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun intern_unwrap(itn: *intern.Interner, text: str) intern.StrId {
    val res_id: R.Result[intern.StrId, str] = intern.intern(itn, text);
    if (R.is_err[intern.StrId, str](res_id)) { ret intern.STR_NIL; }
    ret R.unwrap_ok[intern.StrId, str](res_id);
}

fun intern_opt_unwrap(itn: *intern.Interner, text: str) intern.StrId {
    if (str_empty(text)) { ret intern.STR_NIL; }
    ret intern_unwrap(itn, text);
}

fun parse_str_array(alloc: *A.Allocator, itn: *intern.Interner, arr: *toml.Array,
                    label: str, key: str, allow_scalar: bool) R.Result[StrArr, str] {
    var out: StrArr;
    out.items   = nil;
    out.count   = 0;
    out.present = arr != nil;
    if (arr == nil) { ret R.ok[StrArr, str](out); }

    val n: usize = toml.array_len(arr);
    if (n == 0) { ret R.ok[StrArr, str](out); }
    if (n > 0xFFFFFFFF::usize) {
        ret R.err[StrArr, str](sfmt(alloc, "mach.toml: {}.{} has too many entries", label, key));
    }

    val res_items: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](alloc, n);
    if (R.is_err[*intern.StrId, str](res_items)) { ret R.err[StrArr, str](R.unwrap_err[*intern.StrId, str](res_items)); }
    out.items = R.unwrap_ok[*intern.StrId, str](res_items);
    out.count = n::u32;

    var i: usize = 0;
    for (i < n) {
        val v: *toml.Value = toml.array_get(arr, i);
        if (v == nil || v.tag != toml.TYPE_STRING) {
            A.deallocate[intern.StrId](alloc, out.items, n);
            if (allow_scalar) {
                ret R.err[StrArr, str](sfmt(alloc,
                    "mach.toml: {}.{} must be a string or array of strings", label, key));
            }
            ret R.err[StrArr, str](sfmt(alloc,
                "mach.toml: {}.{} must be an array of strings", label, key));
        }
        val res_elem: R.Result[intern.StrId, str] = intern.intern(itn, v.data.string);
        if (R.is_err[intern.StrId, str](res_elem)) {
            A.deallocate[intern.StrId](alloc, out.items, n);
            ret R.err[StrArr, str](R.unwrap_err[intern.StrId, str](res_elem));
        }
        out.items[i] = R.unwrap_ok[intern.StrId, str](res_elem);
        i = i + 1;
    }
    ret R.ok[StrArr, str](out);
}

fun canonical_axis_value(key: str, value: str) bool {
    if (str_equals(value, "*")) { ret true; }
    if (str_equals(key, "os"))  { ret os.os_id_for(value) != os.OS_UNKNOWN; }
    if (str_equals(key, "isa")) { ret isa.arch_id_for(value) != isa.ARCH_UNKNOWN; }
    if (str_equals(key, "abi")) { ret abi.abi_id_for(value) != abi.ABI_UNKNOWN; }
    ret false;
}

fun parse_filter_axis(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml.Table, key: str, label: str, as_root: bool) R.Result[StrArr, str] {
    var out: StrArr;
    out.items   = nil;
    out.count   = 0;
    out.present = false;
    val v: *toml.Value = toml.get(sub, key);
    if (v == nil) { ret R.ok[StrArr, str](out); }
    out.present = true;

    if (v.tag == toml.TYPE_STRING) {
        if (str_empty(v.data.string)) {
            ret R.err[StrArr, str](sfmt(alloc, "mach.toml: {}.{} is empty; use a canonical value, \"*\", or [], or omit it", label, key));
        }
        val res_items: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](alloc, 1::usize);
        if (R.is_err[*intern.StrId, str](res_items)) { ret R.err[StrArr, str](R.unwrap_err[*intern.StrId, str](res_items)); }
        out.items = R.unwrap_ok[*intern.StrId, str](res_items);
        val res_elem: R.Result[intern.StrId, str] = intern.intern(itn, v.data.string);
        if (R.is_err[intern.StrId, str](res_elem)) {
            A.deallocate[intern.StrId](alloc, out.items, 1::usize);
            ret R.err[StrArr, str](R.unwrap_err[intern.StrId, str](res_elem));
        }
        out.items[0] = R.unwrap_ok[intern.StrId, str](res_elem);
        out.count = 1;
    }
    or (v.tag == toml.TYPE_ARRAY) {
        val res_arr: R.Result[StrArr, str] = parse_str_array(alloc, itn, ?v.data.array, label, key, true);
        if (R.is_err[StrArr, str](res_arr)) { ret res_arr; }
        val arr_v: StrArr = R.unwrap_ok[StrArr, str](res_arr);
        out.items = arr_v.items;
        out.count = arr_v.count;
    }
    or {
        ret R.err[StrArr, str](sfmt(alloc, "mach.toml: {}.{} must be a string or array of strings", label, key));
    }

    if (as_root) {
        var vi: u32 = 0;
        for (vi < out.count) {
            val vs: str = idstr(itn, out.items[vi]);
            if (!canonical_axis_value(key, vs)) {
                ret R.err[StrArr, str](sfmt(alloc, "mach.toml: {}.{} has non-canonical value '{}'; use a canonical value or \"*\"", label, key, vs));
            }
            vi = vi + 1;
        }
    }
    ret R.ok[StrArr, str](out);
}

fun parse_opt_level(alloc: *A.Allocator, name: str, sub: *toml.Table, as_root: bool) R.Result[MOpt, str] {
    val v: *toml.Value = toml.get(sub, "opt");
    if (v == nil && as_root)         { ret R.err[MOpt, str](sfmt(alloc, "mach.toml: [profile.{}] is missing required key 'opt'", name)); }
    if (v == nil)                   { ret R.ok[MOpt, str](MOPT_DEFAULT); }
    if (v.tag != toml.TYPE_INTEGER) { ret R.err[MOpt, str](opt_err(alloc, name, v)); }
    val n: i64 = v.data.integer;
    if (n == 0)           { ret R.ok[MOpt, str](MOPT_DEBUG); }
    if (n == 1 || n == 2) { ret R.ok[MOpt, str](MOPT_RELEASE); }
    ret R.err[MOpt, str](opt_err(alloc, name, v));
}

fun opt_err(alloc: *A.Allocator, name: str, v: *toml.Value) str {
    ret sfmt(alloc, "mach.toml: profile '{}': opt must be 0, 1, or 2 (got {})",
        name, opt_value_text(alloc, v));
}

fun opt_value_text(alloc: *A.Allocator, v: *toml.Value) str {
    if (v.tag == toml.TYPE_INTEGER) { ret int_to_str(alloc, v.data.integer); }
    if (v.tag == toml.TYPE_STRING)  { ret sfmt(alloc, "\"{}\"", v.data.string); }
    if (v.tag == toml.TYPE_BOOL) {
        if (v.data.boolean) { ret "true"; }
        ret "false";
    }
    if (v.tag == toml.TYPE_FLOAT) { ret "a float"; }
    if (v.tag == toml.TYPE_ARRAY) { ret "an array"; }
    if (v.tag == toml.TYPE_TABLE) { ret "a table"; }
    ret "a value";
}

fun parse_debug_flag(alloc: *A.Allocator, name: str, sub: *toml.Table, as_root: bool) R.Result[bool, str] {
    val v: *toml.Value = toml.get(sub, "debug");
    if (v == nil && as_root)      { ret R.err[bool, str](sfmt(alloc, "mach.toml: [profile.{}] is missing required key 'debug'", name)); }
    if (v == nil)                { ret R.ok[bool, str](false); }
    if (v.tag != toml.TYPE_BOOL) { ret R.err[bool, str](debug_err(alloc, name, v)); }
    ret R.ok[bool, str](v.data.boolean);
}

fun parse_profile_default(alloc: *A.Allocator, name: str, sub: *toml.Table) R.Result[bool, str] {
    ret parse_default_flag(alloc, "profile", name, sub);
}

fun parse_default_flag(alloc: *A.Allocator, table: str, name: str, sub: *toml.Table) R.Result[bool, str] {
    val v: *toml.Value = toml.get(sub, "default");
    if (v == nil)                { ret R.ok[bool, str](false); }
    if (v.tag != toml.TYPE_BOOL) { ret R.err[bool, str](sfmt(alloc, "mach.toml: {} '{}': default must be a boolean (got {})", table, name, opt_value_text(alloc, v))); }
    ret R.ok[bool, str](v.data.boolean);
}

rec DefaultTables {
    count: usize;
    names: str;
}

fun default_tables_init() DefaultTables {
    var d: DefaultTables;
    d.count = 0;
    d.names = "";
    ret d;
}

fun default_tables_note(alloc: *A.Allocator, d: *DefaultTables, label: str) {
    if (d.count == 0) { d.names = sfmt(alloc, "{}", label); }
    or { d.names = sfmt(alloc, "{}, {}", d.names, label); }
    d.count = d.count + 1;
}

fun duplicate_default_err(alloc: *A.Allocator, kind: str, d: *DefaultTables) str {
    ret sfmt(alloc, "mach.toml: {} {}s declare `default = true` ({}); exactly one is allowed",
        d.count, kind, d.names);
}

fun debug_err(alloc: *A.Allocator, name: str, v: *toml.Value) str {
    ret sfmt(alloc, "mach.toml: profile '{}': debug must be a boolean (got {})",
        name, opt_value_text(alloc, v));
}

fun parse_vectorize_flag(alloc: *A.Allocator, name: str, sub: *toml.Table) R.Result[bool, str] {
    val v: *toml.Value = toml.get(sub, "vectorize");
    if (v == nil)                { ret R.ok[bool, str](true); }
    if (v.tag != toml.TYPE_BOOL) { ret R.err[bool, str](sfmt(alloc, "mach.toml: profile '{}': vectorize must be a boolean (got {})", name, opt_value_text(alloc, v))); }
    ret R.ok[bool, str](v.data.boolean);
}

fun parse_float_reassoc_flag(alloc: *A.Allocator, name: str, sub: *toml.Table) R.Result[bool, str] {
    val v: *toml.Value = toml.get(sub, "float_reassoc");
    if (v == nil)                { ret R.ok[bool, str](false); }
    if (v.tag != toml.TYPE_BOOL) { ret R.err[bool, str](sfmt(alloc, "mach.toml: profile '{}': float_reassoc must be a boolean (got {})", name, opt_value_text(alloc, v))); }
    ret R.ok[bool, str](v.data.boolean);
}

fun parse_simd_mode(alloc: *A.Allocator, name: str, sub: *toml.Table, as_root: bool) R.Result[SimdMode, str] {
    val v: *toml.Value = toml.get(sub, "simd");
    if (v == nil && as_root)       { ret R.err[SimdMode, str](sfmt(alloc, "mach.toml: [profile.{}] is missing required key 'simd'", name)); }
    if (v == nil)                  { ret R.ok[SimdMode, str](SIMD_SCALARIZE); }
    if (v.tag != toml.TYPE_STRING) { ret R.err[SimdMode, str](simd_err(alloc, name, v)); }
    if (str_equals(v.data.string, "scalarize")) { ret R.ok[SimdMode, str](SIMD_SCALARIZE); }
    if (str_equals(v.data.string, "require"))   { ret R.ok[SimdMode, str](SIMD_REQUIRE); }
    ret R.err[SimdMode, str](simd_err(alloc, name, v));
}

fun parse_subsystem(alloc: *A.Allocator, label: str, sub: *toml.Table) R.Result[of.Subsystem, str] {
    val v: *toml.Value = toml.get(sub, "subsystem");
    if (v == nil)                  { ret R.ok[of.Subsystem, str](of.SUBSYSTEM_CONSOLE); }
    if (v.tag != toml.TYPE_STRING) { ret R.err[of.Subsystem, str](subsystem_err(alloc, label, v)); }
    val parsed: O.Option[of.Subsystem] = of.subsystem_from_name(v.data.string);
    if (O.is_some[of.Subsystem](parsed)) { ret R.ok[of.Subsystem, str](O.unwrap[of.Subsystem](parsed)); }
    ret R.err[of.Subsystem, str](subsystem_err(alloc, label, v));
}

fun subsystem_err(alloc: *A.Allocator, label: str, v: *toml.Value) str {
    ret sfmt(alloc, "mach.toml: {}.subsystem must be \"console\" or \"gui\" (got {})",
        label, opt_value_text(alloc, v));
}

fun parse_resource_path(alloc: *A.Allocator, itn: *intern.Interner, label: str,
                        sub: *toml.Table, key: str) R.Result[intern.StrId, str] {
    val v: *toml.Value = toml.get(sub, key);
    if (v == nil) { ret R.ok[intern.StrId, str](intern.STR_NIL); }
    if (v.tag != toml.TYPE_STRING) {
        ret R.err[intern.StrId, str](sfmt(alloc, "mach.toml: {}.{} must be a non-empty path string", label, key));
    }
    if (str_empty(v.data.string)) {
        ret R.err[intern.StrId, str](sfmt(alloc, "mach.toml: {}.{} must not be empty; omit it when unused", label, key));
    }
    val field: str = sfmt(alloc, "{}.{}", label, key);
    val checked: R.Result[R.Void, str] = check_path(alloc, v.data.string, field);
    str_free(alloc, field);
    if (R.is_err[R.Void, str](checked)) {
        ret R.err[intern.StrId, str](R.unwrap_err[R.Void, str](checked));
    }
    val interned: R.Result[intern.StrId, str] = intern.intern(itn, v.data.string);
    if (R.is_err[intern.StrId, str](interned)) {
        ret R.err[intern.StrId, str](R.unwrap_err[intern.StrId, str](interned));
    }
    ret interned;
}

fun simd_err(alloc: *A.Allocator, name: str, v: *toml.Value) str {
    ret sfmt(alloc, "mach.toml: profile '{}': simd must be \"scalarize\" or \"require\" (got {})",
        name, opt_value_text(alloc, v));
}

fun int_to_str(alloc: *A.Allocator, n: i64) str {
    if (n == 0) { ret "0"; }
    var neg: bool = false;
    var u: u64 = n::u64;
    if (n < 0) { neg = true; u = (0 - n)::u64; }

    var digits: [24]char;
    var len: usize = 0;
    for (u > 0) { digits[len] = (u % 10)::char + '0'; u = u / 10; len = len + 1; }

    var total: usize = len;
    if (neg) { total = total + 1; }
    val res_buf: R.Result[*u8, str] = A.allocate[u8](alloc, total + 1);
    if (R.is_err[*u8, str](res_buf)) { ret "?"; }
    val buf: *u8 = R.unwrap_ok[*u8, str](res_buf);
    var w: usize = 0;
    if (neg) { buf[0] = '-'; w = 1; }
    var i: usize = len;
    for (i > 0) { i = i - 1; buf[w] = digits[i]::u8; w = w + 1; }
    buf[w] = 0;
    ret buf::str;
}

fun unknown_key_msg(alloc: *A.Allocator, key: str, label: str) str {
    ret sfmt(alloc, "mach.toml: unknown key '{}' in {}", key, label);
}

fun root_key_known(k: str) bool {
    ret str_equals(k, "project") || str_equals(k, "target") || str_equals(k, "artifact")
        || str_equals(k, "profile") || str_equals(k, "dep") || str_equals(k, "link") || str_equals(k, "step");
}

fun check_root_keys(alloc: *A.Allocator, t: *toml.Table) R.Result[R.Void, str] {
    val n: usize = toml.table_len(t);
    var i: usize = 0;
    for (i < n) {
        val k: str = toml.table_key(t, i);
        if (!root_key_known(k)) {
            ret R.err[R.Void, str](sfmt(alloc, "mach.toml: unknown table or key '{}' at the document root", k));
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun key_known(kind: TableKind, k: str, as_root: bool) bool {
    if (kind == TK_PROJECT) {
        if (str_equals(k, "id") || str_equals(k, "version") || str_equals(k, "src") || str_equals(k, "out")) { ret true; }
        ret false;
    }
    if (kind == TK_TARGET) {
        ret str_equals(k, "isa") || str_equals(k, "os") || str_equals(k, "abi") || str_equals(k, "of")
            || str_equals(k, "platform") || str_equals(k, "base")
            || str_equals(k, "stack_reserve") || str_equals(k, "stack_commit")
            || str_equals(k, "default") || str_equals(k, "env");
    }
    if (kind == TK_ARTIFACT) {
        if (str_equals(k, "kind") || str_equals(k, "entry") || str_equals(k, "out")
            || str_equals(k, "targets") || str_equals(k, "link") || str_equals(k, "need")) { ret true; }
        if (str_equals(k, "default")) { ret true; }
        if (str_equals(k, "subsystem")) { ret true; }
        if (str_equals(k, "icon") || str_equals(k, "manifest")) { ret true; }
        ret false;
    }
    if (kind == TK_PROFILE) {
        if (str_equals(k, "default") || str_equals(k, "opt") || str_equals(k, "debug") || str_equals(k, "simd")) { ret true; }
        if (str_equals(k, "vectorize")) { ret true; }
        if (str_equals(k, "float_reassoc")) { ret true; }
        ret false;
    }
    if (kind == TK_DEP) {
        ret str_equals(k, "git") || str_equals(k, "path") || str_equals(k, "ref");
    }
    if (kind == TK_LINK) {
        ret str_equals(k, "source") || str_equals(k, "name") || str_equals(k, "path") || str_equals(k, "library")
            || str_equals(k, "symbols")
            || str_equals(k, "os") || str_equals(k, "isa") || str_equals(k, "abi") || str_equals(k, "export")
            || str_equals(k, "include");
    }
    if (kind == TK_STEP) {
        ret str_equals(k, "argv") || str_equals(k, "env") || str_equals(k, "in") || str_equals(k, "out")
            || str_equals(k, "need") || str_equals(k, "timeout_seconds");
    }
    ret false;
}

fun dep_ref_hex(ref: str, start: usize) bool {
    val n: usize = str_len(ref);
    val width: usize = n - start;
    if (width != 40 && width != 64) { ret false; }
    var i: usize = start;
    for (i < n) {
        val c: u8 = ref[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun dep_ref_component(ref: str, start: usize, end: usize) bool {
    if (start >= end || ref[start] == '.') { ret false; }
    if (end - start >= 5 && ref[end - 5] == '.' && ref[end - 4] == 'l'
        && ref[end - 3] == 'o' && ref[end - 2] == 'c' && ref[end - 1] == 'k') { ret false; }
    ret true;
}

fun dep_ref_name(ref: str, start: usize) bool {
    val n: usize = str_len(ref);
    if (start >= n || ref[start] == '/' || ref[n - 1] == '/' || ref[n - 1] == '.') { ret false; }
    var component_start: usize = start;
    var i: usize = start;
    for (i < n) {
        val c: u8 = ref[i];
        if (c <= ' ' || c == 127 || c == '\\' || c == '~' || c == '^' || c == ':'
            || c == '?' || c == '*' || c == '[') { ret false; }
        if (c == '.' && i + 1 < n && ref[i + 1] == '.') { ret false; }
        if (c == '/' && i + 1 < n && ref[i + 1] == '/') { ret false; }
        if (c == '@' && i + 1 < n && ref[i + 1] == '{') { ret false; }
        if (c == '/') {
            if (!dep_ref_component(ref, component_start, i)) { ret false; }
            component_start = i + 1;
        }
        i = i + 1;
    }
    ret dep_ref_component(ref, component_start, n);
}

fun dep_ref_valid(ref: str) bool {
    if (str_starts_with(ref, "branch/")) { ret dep_ref_name(ref, 7); }
    if (str_starts_with(ref, "tag/")) { ret dep_ref_name(ref, 4); }
    if (str_starts_with(ref, "commit/")) { ret dep_ref_hex(ref, 7); }
    ret false;
}

fun check_keys(alloc: *A.Allocator, tab: *toml.Table, label: str, kind: TableKind, as_root: bool, m: *Manifest) R.Result[R.Void, str] {
    val n: usize = toml.table_len(tab);
    var i: usize = 0;
    for (i < n) {
        val k: str = toml.table_key(tab, i);
        if (key_deprecated(kind, k)) {
            val rr: R.Result[R.Void, str] = record_deprecated(alloc, m, label, k);
            if (R.is_err[R.Void, str](rr)) { ret rr; }
        }
        or (!key_known(kind, k, as_root)) { ret R.err[R.Void, str](unknown_key_msg(alloc, k, label)); }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

# the keys 4.26.x accepted and never read; a deprecation window through 4.30.0, refused in 5.0.0
fun key_deprecated(kind: TableKind, k: str) bool {
    if (kind == TK_PROJECT) { ret str_equals(k, "name") || str_equals(k, "description") || str_equals(k, "mach"); }
    if (kind == TK_PROFILE) { ret str_equals(k, "emit_ir") || str_equals(k, "emit_asm"); }
    ret false;
}

fun record_deprecated(alloc: *A.Allocator, m: *Manifest, label: str, key: str) R.Result[R.Void, str] {
    val n: usize = m.deprecated_count::usize;
    val grown_r: R.Result[*DeprecatedKey, str] = A.allocate[DeprecatedKey](alloc, n + 1);
    if (R.is_err[*DeprecatedKey, str](grown_r)) { ret R.err[R.Void, str](R.unwrap_err[*DeprecatedKey, str](grown_r)); }
    val grown: *DeprecatedKey = R.unwrap_ok[*DeprecatedKey, str](grown_r);
    var i: usize = 0;
    for (i < n) { grown[i] = m.deprecated[i]; i = i + 1; }
    grown[n].table = sfmt(alloc, "{}", label);
    grown[n].key   = sfmt(alloc, "{}", key);
    if (m.deprecated != nil) { A.deallocate[DeprecatedKey](alloc, m.deprecated, n); }
    m.deprecated       = grown;
    m.deprecated_count = (n + 1)::u32;
    ret R.ok_void[str]();
}

fun free_deprecated(alloc: *A.Allocator, m: *Manifest) {
    if (m.deprecated == nil) { ret; }
    var i: u32 = 0;
    for (i < m.deprecated_count) {
        str_free(alloc, m.deprecated[i].table);
        str_free(alloc, m.deprecated[i].key);
        i = i + 1;
    }
    A.deallocate[DeprecatedKey](alloc, m.deprecated, m.deprecated_count::usize);
    m.deprecated       = nil;
    m.deprecated_count = 0;
}

# the warning for one deprecated key; `prefix` names the dependency for a dependency manifest, empty for the root
# ---
# alloc: allocator for the returned message
# prefix: `dep 'x' ` for a dependency manifest, empty for the root
# d: the recorded key
# ret: the message, owned by the caller
pub fun deprecated_key_warning(alloc: *A.Allocator, prefix: str, d: *DeprecatedKey) str {
    ret sfmt(alloc, "{}mach.toml: {} key '{}' is accepted and ignored; 5.0.0 refuses it: remove the key", prefix, d.table, d.key);
}

def ProjectPathViolation: u8;
val PPV_NONE:       ProjectPathViolation = 0;
val PPV_EMPTY:      ProjectPathViolation = 1;
val PPV_BACKSLASH:  ProjectPathViolation = 2;
val PPV_ABSOLUTE:   ProjectPathViolation = 3;
val PPV_DRIVE:      ProjectPathViolation = 4;
val PPV_COMPONENT:  ProjectPathViolation = 5;
val PPV_DOT:        ProjectPathViolation = 6;

fun project_path_violation(value: str) ProjectPathViolation {
    if (str_contains_char(value, '\\')) { ret PPV_BACKSLASH; }
    val n: usize = str_len(value);
    if (n == 0) { ret PPV_EMPTY; }
    if (value[0] == '/') { ret PPV_ABSOLUTE; }
    if (n >= 2 && ((value[0] >= 'A' && value[0] <= 'Z') || (value[0] >= 'a' && value[0] <= 'z')) && value[1] == ':') {
        ret PPV_DRIVE;
    }
    var start: usize = 0;
    var i: usize = 0;
    for (i <= n) {
        if (i == n || value[i] == '/') {
            val len: usize = i - start;
            if (len == 0) { ret PPV_COMPONENT; }
            if ((len == 1 && value[start] == '.')
                || (len == 2 && value[start] == '.' && value[start + 1] == '.')) {
                ret PPV_DOT;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    ret PPV_NONE;
}

# whether `value` is a canonical strict descendant of the project root: non-empty,
# '/'-separated, no '\', not absolute, no drive letter, no empty component, no
# '.' or '..' component
# ---
# value: the candidate path
# ret: true when every rule holds
pub fun is_project_path(value: str) bool {
    ret project_path_violation(value) == PPV_NONE;
}

fun check_path(alloc: *A.Allocator, value: str, field: str) R.Result[R.Void, str] {
    val violation: ProjectPathViolation = project_path_violation(value);
    if (violation == PPV_BACKSLASH) {
        ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {} contains a '\\\\'; manifest paths use '/'", field));
    }
    if (violation == PPV_EMPTY) {
        ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {} must be a non-empty project-relative path", field));
    }
    if (violation == PPV_ABSOLUTE) {
        ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {} must be relative to the project root", field));
    }
    if (violation == PPV_DRIVE) {
        ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {} must not use an absolute drive path", field));
    }
    if (violation == PPV_COMPONENT) {
        ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {} contains an empty path component", field));
    }
    if (violation == PPV_DOT) {
        ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {} must not contain '.' or '..' path components", field));
    }
    ret R.ok_void[str]();
}

# a manifest with every array nil and every count 0. the scalar ids are left
# unset, so only `dnit` is safe on the result
# ---
# ret: the empty manifest
pub fun empty() Manifest {
    var m: Manifest;
    m.native_target  = nil;
    m.targets        = nil;
    m.target_count   = 0;
    m.artifacts      = nil;
    m.artifact_count = 0;
    m.profiles       = nil;
    m.profile_count  = 0;
    m.deps           = nil;
    m.dep_count      = 0;
    m.links          = nil;
    m.link_count     = 0;
    m.steps          = nil;
    m.step_count     = 0;
    m.deprecated       = nil;
    m.deprecated_count = 0;
    ret m;
}

# build a `Manifest` from a parsed TOML document. accepted root tables are
# `[project]`, `[target.*]`, `[artifact.*]`, `[profile.*]`, `[dep.*]`,
# `[link.*]` and `[step.*]`; any other root key, and any key a table does not
# define, is an error naming it. on any error every array allocated so far is
# freed before returning
# ---
# alloc: owns the manifest's arrays
# itn: receives every string of the manifest
# t: the TOML document
# as_root: true for the project being built, false for a dependency's manifest.
#  the root form requires `[profile].opt`, `debug` and `simd`, `[artifact].link`
#  and `need`, `[link].os`, `isa`, `abi` and `export`, `[step].need`, requires
#  link filter values to be canonical or "*", and rejects more than one
#  `default = true` profile. the dependency form treats each of those keys as
#  optional. the key set is closed for both forms: a key is read or refused,
#  except the five 4.26.x keys never read (`[project].name`, `description`,
#  `mach`, `[profile].emit_ir`, `emit_asm`), which are recorded in `deprecated`
#  for the driver to warn about until 5.0.0 refuses them
# ret: the manifest, or the first error as a "mach.toml: ..." message. the
#  `[project]` table and its `id`, `version`, `src` and `out` are always
#  required; `src`, `out`, artifact `entry` and `out`, local link `path` and
#  step `in` and `out` entries must satisfy `is_project_path`; every table name
#  must satisfy `is_valid_id`; `[target.native]` and `[dep.<x>].version` are
#  reserved; a `[step]` with `cmd` or `shell` is rejected by name; `need`
#  entries are checked by `validate_needs`. `[profile.*]` absent or empty
#  synthesizes `debug` and `release`
pub fun parse(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, as_root: bool) R.Result[Manifest, str] {
    var m: Manifest = empty();
    var transferred: bool = false;
    fin { if (!transferred) { dnit(?m, alloc); } }

    val res_root_keys: R.Result[R.Void, str] = check_root_keys(alloc, t);
    if (R.is_err[R.Void, str](res_root_keys)) { ret R.err[Manifest, str](R.unwrap_err[R.Void, str](res_root_keys)); }

    val proj: *toml.Table = toml.get_table(t, "project");
    if (proj == nil) { ret R.err[Manifest, str]("mach.toml: missing [project] table"); }
    val res_project_keys: R.Result[R.Void, str] = check_keys(alloc, proj, "[project]", TK_PROJECT, as_root, ?m);
    if (R.is_err[R.Void, str](res_project_keys)) { ret R.err[Manifest, str](R.unwrap_err[R.Void, str](res_project_keys)); }

    val id_str: str = toml.get_str(proj, "id");
    if (str_empty(id_str)) { ret R.err[Manifest, str]("mach.toml: [project] is missing required key 'id'"); }
    val ver_str: str = toml.get_str(proj, "version");
    if (str_empty(ver_str)) { ret R.err[Manifest, str]("mach.toml: [project] is missing required key 'version'"); }
    val src_str: str = toml.get_str(proj, "src");
    if (str_empty(src_str)) { ret R.err[Manifest, str]("mach.toml: [project] is missing required key 'src'"); }
    val out_str: str = toml.get_str(proj, "out");
    if (str_empty(out_str)) { ret R.err[Manifest, str]("mach.toml: [project] is missing required key 'out'"); }

    val res_check_src: R.Result[R.Void, str] = check_path(alloc, src_str, "[project].src");
    if (R.is_err[R.Void, str](res_check_src)) { ret R.err[Manifest, str](R.unwrap_err[R.Void, str](res_check_src)); }
    val res_check_out: R.Result[R.Void, str] = check_path(alloc, out_str, "[project].out");
    if (R.is_err[R.Void, str](res_check_out)) { ret R.err[Manifest, str](R.unwrap_err[R.Void, str](res_check_out)); }

    if (!is_valid_id(id_str)) { ret R.err[Manifest, str]("mach.toml: [project].id must be an identifier (letters, digits, '_', '-')"); }
    m.id = intern_unwrap(itn, id_str);
    m.version = intern_unwrap(itn, ver_str);
    m.src = intern_unwrap(itn, src_str);
    m.out_tmpl = intern_unwrap(itn, out_str);
    m.default_target = intern_unwrap(itn, "native");

    val res_targets: R.Result[R.Void, str] = parse_targets(alloc, itn, t, ?m, as_root);
    if (R.is_err[R.Void, str](res_targets)) { ret R.err[Manifest, str](R.unwrap_err[R.Void, str](res_targets)); }

    val res_artifacts: R.Result[R.Void, str] = parse_artifacts(alloc, itn, t, ?m, as_root);
    if (R.is_err[R.Void, str](res_artifacts)) { ret R.err[Manifest, str](R.unwrap_err[R.Void, str](res_artifacts)); }

    val res_profiles: R.Result[R.Void, str] = parse_profiles(alloc, itn, t, ?m, as_root);
    if (R.is_err[R.Void, str](res_profiles)) { ret R.err[Manifest, str](R.unwrap_err[R.Void, str](res_profiles)); }

    val res_deps: R.Result[R.Void, str] = parse_deps(alloc, itn, t, ?m, as_root);
    if (R.is_err[R.Void, str](res_deps)) { ret R.err[Manifest, str](R.unwrap_err[R.Void, str](res_deps)); }

    val res_links: R.Result[R.Void, str] = parse_links(alloc, itn, t, ?m, as_root);
    if (R.is_err[R.Void, str](res_links)) { ret R.err[Manifest, str](R.unwrap_err[R.Void, str](res_links)); }

    val res_steps: R.Result[R.Void, str] = parse_steps(alloc, itn, t, ?m, as_root);
    if (R.is_err[R.Void, str](res_steps)) { ret R.err[Manifest, str](R.unwrap_err[R.Void, str](res_steps)); }

    val res_needs: R.Result[R.Void, str] = validate_needs(alloc, itn, ?m);
    if (R.is_err[R.Void, str](res_needs)) { ret R.err[Manifest, str](R.unwrap_err[R.Void, str](res_needs)); }

    val res_link_refs: R.Result[R.Void, str] = validate_link_refs(alloc, itn, ?m);
    if (R.is_err[R.Void, str](res_link_refs)) { ret R.err[Manifest, str](R.unwrap_err[R.Void, str](res_link_refs)); }

    if (m.target_count == 0) {
        val native: R.Result[*TargetDef, str] = make_native_target(alloc, itn);
        if (R.is_err[*TargetDef, str](native)) { ret R.err[Manifest, str](R.unwrap_err[*TargetDef, str](native)); }
        m.native_target = R.unwrap_ok[*TargetDef, str](native);
        m.default_target = m.native_target.name;
    }
    transferred = true;
    ret R.ok[Manifest, str](m);
}

fun parse_targets(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest, as_root: bool) R.Result[R.Void, str] {
    val tab: *toml.Table = toml.get_table(t, "target");
    if (tab == nil) { ret R.ok_void[str](); }
    val n: usize = toml.table_len(tab);
    if (n == 0) { ret R.ok_void[str](); }
    val res_targets: R.Result[*TargetDef, str] = A.allocate[TargetDef](alloc, n);
    if (R.is_err[*TargetDef, str](res_targets)) { ret R.err[R.Void, str](R.unwrap_err[*TargetDef, str](res_targets)); }
    m.targets      = R.unwrap_ok[*TargetDef, str](res_targets);
    m.target_count = n::u32;

    var i: usize = 0;
    var defaults: DefaultTables = default_tables_init();
    for (i < n) {
        val name: str = toml.table_key(tab, i);
        if (!is_valid_id(name)) {
            ret R.err[R.Void, str](sfmt(alloc, "mach.toml: target name '{}' must be a portable identifier (letters, digits, '_', '-')", name));
        }
        if (str_equals(name, "native")) {
            ret R.err[R.Void, str]("mach.toml: [target.native] is reserved; 'native' resolves to a declared target");
        }
        val v: *toml.Value = toml.table_value(tab, i);
        if (v == nil || v.tag != toml.TYPE_TABLE) {
            ret R.err[R.Void, str](sfmt(alloc, "mach.toml: [target.{}] must be a table", name));
        }
        val sub: *toml.Table = ?v.data.table;
        val label: str = sfmt(alloc, "[target.{}]", name);
        val res_keys: R.Result[R.Void, str] = check_keys(alloc, sub, label, TK_TARGET, as_root, m);
        if (R.is_err[R.Void, str](res_keys)) { ret res_keys; }

        var d: TargetDef;
        d.name = intern_unwrap(itn, name);
        val default_r: R.Result[bool, str] = parse_default_flag(alloc, "target", name, sub);
        if (R.is_err[bool, str](default_r)) { str_free(alloc, label); ret R.err[R.Void, str](R.unwrap_err[bool, str](default_r)); }
        d.is_default = R.unwrap_ok[bool, str](default_r);
        if (d.is_default) { default_tables_note(alloc, ?defaults, label); }

        val isa_s: str = toml.get_str(sub, "isa");
        if (str_empty(isa_s)) { ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {} is missing required key 'isa'", label)); }
        val os_s: str = toml.get_str(sub, "os");
        if (str_empty(os_s)) { ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {} is missing required key 'os'", label)); }
        val abi_s: str = toml.get_str(sub, "abi");
        if (str_empty(abi_s)) { ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {} is missing required key 'abi'", label)); }
        d.isa = intern_unwrap(itn, isa_s);
        d.os  = intern_unwrap(itn, os_s);
        d.abi = intern_unwrap(itn, abi_s);
        d.of  = intern_opt_unwrap(itn, toml.get_str(sub, "of"));

        d.platform = intern_opt_unwrap(itn, toml.get_str(sub, "platform"));
        val env_v: *toml.Value = toml.get(sub, "env");
        d.env = intern.STR_NIL;
        if (env_v != nil) {
            if (env_v.tag != toml.TYPE_STRING || str_empty(toml.get_str(sub, "env"))) {
                val env_msg: str = sfmt(alloc, "mach.toml: {} env must be a non-empty string naming an environment the target's isa defines", label);
                str_free(alloc, label);
                ret R.err[R.Void, str](env_msg);
            }
            d.env = intern_unwrap(itn, toml.get_str(sub, "env"));
        }
        d.base     = 0;
        val base_opt: O.Option[i64] = toml.get_int(sub, "base");
        if (O.is_some[i64](base_opt)) { d.base = O.unwrap[i64](base_opt)::u64; }

        d.stack_reserve = 0;
        d.stack_commit  = 0;
        val sres_opt: O.Option[i64] = toml.get_int(sub, "stack_reserve");
        if (O.is_some[i64](sres_opt)) { d.stack_reserve = O.unwrap[i64](sres_opt)::u64; }
        val scom_opt: O.Option[i64] = toml.get_int(sub, "stack_commit");
        if (O.is_some[i64](scom_opt)) { d.stack_commit = O.unwrap[i64](scom_opt)::u64; }

        m.targets[i] = d;
        str_free(alloc, label);
        i = i + 1;
    }
    if (as_root && n > 1 && defaults.count > 1) {
        ret R.err[R.Void, str](duplicate_default_err(alloc, "target", ?defaults));
    }
    ret R.ok_void[str]();
}

fun parse_artifacts(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest, as_root: bool) R.Result[R.Void, str] {
    val arts: *toml.Table = toml.get_table(t, "artifact");
    if (arts == nil) { ret R.ok_void[str](); }
    val n: usize = toml.table_len(arts);
    if (n == 0) { ret R.ok_void[str](); }

    val res_artifacts: R.Result[*ArtifactDef, str] = A.allocate[ArtifactDef](alloc, n);
    if (R.is_err[*ArtifactDef, str](res_artifacts)) { ret R.err[R.Void, str](R.unwrap_err[*ArtifactDef, str](res_artifacts)); }
    m.artifacts      = R.unwrap_ok[*ArtifactDef, str](res_artifacts);
    m.artifact_count = n::u32;

    var initialized: usize = 0;
    for (initialized < n) {
        val slot: *ArtifactDef = ?m.artifacts[initialized];
        slot.targets = nil;
        slot.target_count = 0;
        slot.link = nil;
        slot.link_count = 0;
        slot.need = nil;
        slot.need_count = 0;
        initialized = initialized + 1;
    }

    var i: usize = 0;
    for (i < n) {
        val res_artifact: R.Result[R.Void, str] = parse_one_artifact(alloc, itn, arts, i, as_root, ?m.artifacts[i], m);
        if (R.is_err[R.Void, str](res_artifact)) { ret res_artifact; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun parse_one_artifact(alloc: *A.Allocator, itn: *intern.Interner, tab: *toml.Table, k: usize, as_root: bool, d: *ArtifactDef, m: *Manifest) R.Result[R.Void, str] {
    val name: str = toml.table_key(tab, k);
    val v: *toml.Value = toml.table_value(tab, k);
    val label: str = sfmt(alloc, "[artifact.{}]", name);
    if (!is_valid_id(name)) {
        val name_msg: str = sfmt(alloc, "mach.toml: artifact name '{}' must be a portable identifier (letters, digits, '_', '-')", name);
        str_free(alloc, label);
        ret R.err[R.Void, str](name_msg);
    }
    if (v == nil || v.tag != toml.TYPE_TABLE) {
        val lbl_msg1: str = sfmt(alloc, "mach.toml: {} must be a table", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg1);
    }
    val sub: *toml.Table = ?v.data.table;

    val res_keys: R.Result[R.Void, str] = check_keys(alloc, sub, label, TK_ARTIFACT, as_root, m);
    if (R.is_err[R.Void, str](res_keys)) { ret res_keys; }

    d.icon         = intern.STR_NIL;
    d.app_manifest = intern.STR_NIL;
    d.name         = intern_unwrap(itn, name);
    val default_r: R.Result[bool, str] = parse_default_flag(alloc, "artifact", name, sub);
    if (R.is_err[bool, str](default_r)) { str_free(alloc, label); ret R.err[R.Void, str](R.unwrap_err[bool, str](default_r)); }
    d.is_default = R.unwrap_ok[bool, str](default_r);

    val kind_s: str = toml.get_str(sub, "kind");
    if (str_empty(kind_s) || !(str_equals(kind_s, "bin") || str_equals(kind_s, "static") || str_equals(kind_s, "shared"))) {
        val lbl_msg2: str = sfmt(alloc, "mach.toml: {}.kind must be \"bin\", \"static\", or \"shared\"", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg2);
    }
    d.kind = intern_unwrap(itn, kind_s);
    d.is_lib = !str_equals(kind_s, "bin");

    val entry_s: str = toml.get_str(sub, "entry");
    if (str_empty(entry_s)) { ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {} is missing required key 'entry'", label)); }
    val entry_field: str = sfmt(alloc, "{}.entry", label);
    val res_check_entry: R.Result[R.Void, str] = check_path(alloc, entry_s, entry_field);
    str_free(alloc, entry_field);
    if (R.is_err[R.Void, str](res_check_entry)) { ret res_check_entry; }
    d.entry = intern_unwrap(itn, entry_s);

    val out_s: str = toml.get_str(sub, "out");
    if (str_empty(out_s)) { ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {} is missing required key 'out'", label)); }
    val out_field: str = sfmt(alloc, "{}.out", label);
    val res_check_out: R.Result[R.Void, str] = check_path(alloc, out_s, out_field);
    str_free(alloc, out_field);
    if (R.is_err[R.Void, str](res_check_out)) { ret res_check_out; }
    d.out = intern_unwrap(itn, out_s);

    val targets_arr: *toml.Array = toml.get_array(sub, "targets");
    if (targets_arr == nil) {
        val lbl_msg3: str = sfmt(alloc, "mach.toml: {} is missing required key 'targets'", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg3);
    }
    val res_targets: R.Result[StrArr, str] = parse_str_array(alloc, itn, targets_arr, label, "targets", false);
    if (R.is_err[StrArr, str](res_targets)) { ret R.err[R.Void, str](R.unwrap_err[StrArr, str](res_targets)); }
    val targets_val: StrArr = R.unwrap_ok[StrArr, str](res_targets);
    d.targets      = targets_val.items;
    d.target_count = targets_val.count;

    val link_arr: *toml.Array = toml.get_array(sub, "link");
    if (link_arr == nil && as_root) {
        val lbl_msg4: str = sfmt(alloc, "mach.toml: {} is missing required key 'link' (use [] for none)", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg4);
    }
    if (link_arr != nil) {
        val res_link: R.Result[StrArr, str] = parse_str_array(alloc, itn, link_arr, label, "link", false);
        if (R.is_err[StrArr, str](res_link)) { ret R.err[R.Void, str](R.unwrap_err[StrArr, str](res_link)); }
        val link_val: StrArr = R.unwrap_ok[StrArr, str](res_link);
        d.link       = link_val.items;
        d.link_count = link_val.count;
    }

    val need_arr: *toml.Array = toml.get_array(sub, "need");
    if (need_arr == nil && as_root) {
        val lbl_msg5: str = sfmt(alloc, "mach.toml: {} is missing required key 'need' (use [] for none)", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg5);
    }
    if (need_arr != nil) {
        val res_need: R.Result[StrArr, str] = parse_str_array(alloc, itn, need_arr, label, "need", false);
        if (R.is_err[StrArr, str](res_need)) { ret R.err[R.Void, str](R.unwrap_err[StrArr, str](res_need)); }
        val need_val: StrArr = R.unwrap_ok[StrArr, str](res_need);
        d.need       = need_val.items;
        d.need_count = need_val.count;
    }

    val res_subsystem: R.Result[of.Subsystem, str] = parse_subsystem(alloc, label, sub);
    if (R.is_err[of.Subsystem, str](res_subsystem)) { ret R.err[R.Void, str](R.unwrap_err[of.Subsystem, str](res_subsystem)); }
    d.subsystem = R.unwrap_ok[of.Subsystem, str](res_subsystem);

    val res_icon: R.Result[intern.StrId, str] =
        parse_resource_path(alloc, itn, label, sub, "icon");
    if (R.is_err[intern.StrId, str](res_icon)) {
        str_free(alloc, label); ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](res_icon));
    }
    d.icon = R.unwrap_ok[intern.StrId, str](res_icon);

    val res_manifest: R.Result[intern.StrId, str] =
        parse_resource_path(alloc, itn, label, sub, "manifest");
    if (R.is_err[intern.StrId, str](res_manifest)) {
        str_free(alloc, label); ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](res_manifest));
    }
    d.app_manifest = R.unwrap_ok[intern.StrId, str](res_manifest);

    if (d.is_lib && (d.icon != intern.STR_NIL || d.app_manifest != intern.STR_NIL)) {
        val lbl_msg_icon: str = sfmt(alloc,
            "mach.toml: {}.icon and .manifest apply only to kind = \"bin\" artifacts", label);
        str_free(alloc, label); ret R.err[R.Void, str](lbl_msg_icon);
    }

    str_free(alloc, label); ret R.ok_void[str]();
}

fun parse_profiles(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest, as_root: bool) R.Result[R.Void, str] {
    val tab: *toml.Table = toml.get_table(t, "profile");
    if (tab == nil) { ret synthesize_profiles(alloc, itn, m); }
    val n: usize = toml.table_len(tab);
    if (n == 0) { ret synthesize_profiles(alloc, itn, m); }

    val res_profiles: R.Result[*ProfileDef, str] = A.allocate[ProfileDef](alloc, n);
    if (R.is_err[*ProfileDef, str](res_profiles)) { ret R.err[R.Void, str](R.unwrap_err[*ProfileDef, str](res_profiles)); }
    m.profiles      = R.unwrap_ok[*ProfileDef, str](res_profiles);
    m.profile_count = n::u32;

    var i: usize = 0;
    var defaults: DefaultTables = default_tables_init();
    for (i < n) {
        val name: str = toml.table_key(tab, i);
        val v: *toml.Value = toml.table_value(tab, i);
        val label: str = sfmt(alloc, "[profile.{}]", name);
        if (!is_valid_id(name)) {
            val name_msg: str = sfmt(alloc, "mach.toml: profile name '{}' must be a portable identifier (letters, digits, '_', '-')", name);
            str_free(alloc, label);
            ret R.err[R.Void, str](name_msg);
        }
        if (v == nil || v.tag != toml.TYPE_TABLE) {
            val lbl_msg6: str = sfmt(alloc, "mach.toml: {} must be a table", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg6);
        }
        val sub: *toml.Table = ?v.data.table;
        val res_keys: R.Result[R.Void, str] = check_keys(alloc, sub, label, TK_PROFILE, as_root, m);
        if (R.is_err[R.Void, str](res_keys)) { ret res_keys; }

        var pf: ProfileDef;
        pf.name = intern_unwrap(itn, name);
        val default_r: R.Result[bool, str] = parse_profile_default(alloc, name, sub);
        if (R.is_err[bool, str](default_r)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](default_r)); }
        pf.is_default = R.unwrap_ok[bool, str](default_r);
        if (pf.is_default) { default_tables_note(alloc, ?defaults, label); }
        val res_opt: R.Result[MOpt, str] = parse_opt_level(alloc, name, sub, as_root);
        if (R.is_err[MOpt, str](res_opt)) { ret R.err[R.Void, str](R.unwrap_err[MOpt, str](res_opt)); }
        pf.opt      = R.unwrap_ok[MOpt, str](res_opt);
        val debug_r: R.Result[bool, str] = parse_debug_flag(alloc, name, sub, as_root);
        if (R.is_err[bool, str](debug_r)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](debug_r)); }
        pf.debug    = R.unwrap_ok[bool, str](debug_r);
        val res_simd: R.Result[SimdMode, str] = parse_simd_mode(alloc, name, sub, as_root);
        if (R.is_err[SimdMode, str](res_simd)) { ret R.err[R.Void, str](R.unwrap_err[SimdMode, str](res_simd)); }
        pf.simd     = R.unwrap_ok[SimdMode, str](res_simd);
        val vectorize_r: R.Result[bool, str] = parse_vectorize_flag(alloc, name, sub);
        if (R.is_err[bool, str](vectorize_r)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](vectorize_r)); }
        pf.vectorize = R.unwrap_ok[bool, str](vectorize_r);
        val float_reassoc_r: R.Result[bool, str] = parse_float_reassoc_flag(alloc, name, sub);
        if (R.is_err[bool, str](float_reassoc_r)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](float_reassoc_r)); }
        pf.float_reassoc = R.unwrap_ok[bool, str](float_reassoc_r);

        m.profiles[i] = pf;
        str_free(alloc, label);
        i = i + 1;
    }
    if (as_root && n > 1 && defaults.count > 1) {
        ret R.err[R.Void, str](duplicate_default_err(alloc, "profile", ?defaults));
    }
    ret R.ok_void[str]();
}

fun builtin_profile(itn: *intern.Interner, name: str, opt: MOpt, debug: bool,
                    vectorize: bool, is_default: bool) ProfileDef {
    var pf: ProfileDef;
    pf.name          = intern_unwrap(itn, name);
    pf.is_default    = is_default;
    pf.opt           = opt;
    pf.debug         = debug;
    pf.simd          = SIMD_SCALARIZE;
    pf.vectorize     = vectorize;
    pf.float_reassoc = false;
    ret pf;
}

fun synthesize_profiles(alloc: *A.Allocator, itn: *intern.Interner,
                        m: *Manifest) R.Result[R.Void, str] {
    val res_profiles: R.Result[*ProfileDef, str] = A.allocate[ProfileDef](alloc, 2);
    if (R.is_err[*ProfileDef, str](res_profiles)) { ret R.err[R.Void, str](R.unwrap_err[*ProfileDef, str](res_profiles)); }
    m.profiles = R.unwrap_ok[*ProfileDef, str](res_profiles);
    m.profile_count = 2;
    m.profiles[0] = builtin_profile(itn, "debug", MOPT_DEBUG, true, false, true);
    m.profiles[1] = builtin_profile(itn, "release", MOPT_RELEASE, false, true, false);
    ret R.ok_void[str]();
}

fun parse_deps(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest, as_root: bool) R.Result[R.Void, str] {
    val tab: *toml.Table = toml.get_table(t, "dep");
    if (tab == nil) { ret R.ok_void[str](); }
    val n: usize = toml.table_len(tab);
    if (n == 0) { ret R.ok_void[str](); }

    val res_deps: R.Result[*DepDef, str] = A.allocate[DepDef](alloc, n);
    if (R.is_err[*DepDef, str](res_deps)) { ret R.err[R.Void, str](R.unwrap_err[*DepDef, str](res_deps)); }
    m.deps      = R.unwrap_ok[*DepDef, str](res_deps);
    m.dep_count = n::u32;

    var i: usize = 0;
    for (i < n) {
        val name: str = toml.table_key(tab, i);
        val v: *toml.Value = toml.table_value(tab, i);
        val label: str = sfmt(alloc, "[dep.{}]", name);
        if (!is_valid_id(name)) {
            val name_msg: str = sfmt(alloc, "mach.toml: dependency name '{}' must be a portable identifier (letters, digits, '_', '-')", name);
            str_free(alloc, label);
            ret R.err[R.Void, str](name_msg);
        }
        if (v == nil || v.tag != toml.TYPE_TABLE) {
            val lbl_msg7: str = sfmt(alloc, "mach.toml: {} must be a table", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg7);
        }
        val sub: *toml.Table = ?v.data.table;

        if (toml.get(sub, "version") != nil) {
            val lbl_msg8: str = sfmt(alloc, "mach.toml: {}.version is reserved for the registry era", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg8);
        }
        val res_keys: R.Result[R.Void, str] = check_keys(alloc, sub, label, TK_DEP, as_root, m);
        if (R.is_err[R.Void, str](res_keys)) { ret res_keys; }

        var d: DepDef;
        d.name = intern_unwrap(itn, name);
        val git_s:  str = toml.get_str(sub, "git");
        val path_s: str = toml.get_str(sub, "path");
        val has_git:  bool = !str_empty(git_s);
        val has_path: bool = !str_empty(path_s);
        if (has_git == has_path) {
            val lbl_msg9: str = sfmt(alloc, "mach.toml: {} needs exactly one source key: 'git' or 'path'", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg9);
        }
        val ref_s: str = toml.get_str(sub, "ref");
        if (has_git && str_empty(ref_s)) {
            val lbl_msg10: str = sfmt(alloc, "mach.toml: {} is missing required key 'ref' for git source", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg10);
        }
        if (has_path && !str_empty(ref_s)) {
            val lbl_msg11: str = sfmt(alloc, "mach.toml: {}.ref is not allowed for path sources", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg11);
        }
        if (has_git && !dep_ref_valid(ref_s)) {
            val lbl_msg12: str = sfmt(alloc, "mach.toml: {}.ref must be branch/<name>, tag/<name>, or commit/<full-object-id>", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg12);
        }
        d.git  = intern_opt_unwrap(itn, git_s);
        d.path = intern_opt_unwrap(itn, path_s);
        d.ref  = intern_opt_unwrap(itn, ref_s);

        m.deps[i] = d;
        str_free(alloc, label);
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun parse_links(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest, as_root: bool) R.Result[R.Void, str] {
    val tab: *toml.Table = toml.get_table(t, "link");
    if (tab == nil) { ret R.ok_void[str](); }
    val n: usize = toml.table_len(tab);
    if (n == 0) { ret R.ok_void[str](); }

    val res_links: R.Result[*LinkDef, str] = A.allocate[LinkDef](alloc, n);
    if (R.is_err[*LinkDef, str](res_links)) { ret R.err[R.Void, str](R.unwrap_err[*LinkDef, str](res_links)); }
    m.links      = R.unwrap_ok[*LinkDef, str](res_links);
    m.link_count = n::u32;

    var initialized: usize = 0;
    for (initialized < n) {
        val slot: *LinkDef = ?m.links[initialized];
        slot.symbols = nil;
        slot.symbol_count = 0;
        slot.os = nil;
        slot.os_count = 0;
        slot.isa = nil;
        slot.isa_count = 0;
        slot.abi = nil;
        slot.abi_count = 0;
        initialized = initialized + 1;
    }

    var i: usize = 0;
    for (i < n) {
        val name: str = toml.table_key(tab, i);
        val v: *toml.Value = toml.table_value(tab, i);
        val label: str = sfmt(alloc, "[link.{}]", name);
        if (!is_valid_id(name)) {
            val name_msg: str = sfmt(alloc, "mach.toml: link name '{}' must be a portable identifier (letters, digits, '_', '-')", name);
            str_free(alloc, label);
            ret R.err[R.Void, str](name_msg);
        }
        if (v == nil || v.tag != toml.TYPE_TABLE) {
            val lbl_msg12: str = sfmt(alloc, "mach.toml: {} must be a table", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg12);
        }
        val sub: *toml.Table = ?v.data.table;

        val res_keys: R.Result[R.Void, str] = check_keys(alloc, sub, label, TK_LINK, as_root, m);
        if (R.is_err[R.Void, str](res_keys)) { ret res_keys; }

        val d: *LinkDef = ?m.links[i];
        d.name = intern_unwrap(itn, name);

        val source_s: str = toml.get_str(sub, "source");
        if (str_empty(source_s)) { ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {} is missing required key 'source'", label)); }
        if (!str_equals(source_s, "system") && !str_equals(source_s, "framework") && !str_equals(source_s, "local")) {
            val lbl_msg13: str = sfmt(alloc, "mach.toml: {}.source must be \"system\", \"framework\", or \"local\"", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg13);
        }
        d.source = LINK_LOCAL;
        if (str_equals(source_s, "system"))    { d.source = LINK_SYSTEM; }
        if (str_equals(source_s, "framework")) { d.source = LINK_FRAMEWORK; }
        d.library = d.name;
        val library_v: *toml.Value = toml.get(sub, "library");
        if (library_v != nil) {
            if (library_v.tag != toml.TYPE_STRING) {
                val lbl_msg14: str = sfmt(alloc, "mach.toml: {}.library must be a non-empty string", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg14);
            }
            val library_s: str = library_v.data.string;
            if (str_empty(library_s)) {
                val lbl_msg15: str = sfmt(alloc, "mach.toml: {}.library must be a non-empty string", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg15);
            }
            d.library = intern_unwrap(itn, library_s);
        }

        d.symbols      = nil;
        d.symbol_count = 0;
        val symbols_v: *toml.Value = toml.get(sub, "symbols");
        if (symbols_v != nil) {
            if (symbols_v.tag != toml.TYPE_ARRAY) {
                val lbl_msg16: str = sfmt(alloc, "mach.toml: {}.symbols must be an array of strings", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg16);
            }
            val res_syms: R.Result[StrArr, str] = parse_str_array(alloc, itn, ?symbols_v.data.array, label, "symbols", false);
            if (R.is_err[StrArr, str](res_syms)) { ret R.err[R.Void, str](R.unwrap_err[StrArr, str](res_syms)); }
            val syms: StrArr = R.unwrap_ok[StrArr, str](res_syms);
            var si: u32 = 0;
            for (si < syms.count) {
                if (str_empty(idstr(itn, syms.items[si]))) {
                    val lbl_msg17: str = sfmt(alloc, "mach.toml: {}.symbols has an empty symbol name", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg17);
                }
                var sj: u32 = 0;
                for (sj < si) {
                    if (syms.items[sj] == syms.items[si]) {
                        ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {}.symbols lists '{}' twice",
                                                  label, idstr(itn, syms.items[si])));
                    }
                    sj = sj + 1;
                }
                si = si + 1;
            }
            d.symbols      = syms.items;
            d.symbol_count = syms.count;
        }

        val name_val: str = toml.get_str(sub, "name");
        val path_val: str = toml.get_str(sub, "path");

        if (str_equals(source_s, "local")) {
            if (!str_empty(name_val)) {
                val lbl_msg18: str = sfmt(alloc, "mach.toml: {}.name is not allowed for local sources", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg18);
            }
            if (str_empty(path_val)) {
                val lbl_msg19: str = sfmt(alloc, "mach.toml: {} is missing required key 'path' for local source", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg19);
            }
            val path_field: str = sfmt(alloc, "{}.path", label);
            val res_check_path: R.Result[R.Void, str] = check_path(alloc, path_val, path_field);
            str_free(alloc, path_field);
            if (R.is_err[R.Void, str](res_check_path)) { ret res_check_path; }
            d.path = intern_unwrap(itn, path_val);
            d.lib_name = intern.STR_NIL;
        }
        or {
            if (!str_empty(path_val)) {
                val lbl_msg20: str = sfmt(alloc, "mach.toml: {}.path is not allowed for non-local sources", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg20);
            }
            if (str_empty(name_val)) {
                val lbl_msg21: str = sfmt(alloc, "mach.toml: {} is missing required key 'name' for non-local source", label); str_free(alloc, label); ret R.err[R.Void, str](lbl_msg21);
            }
            d.lib_name = intern_unwrap(itn, name_val);
            d.path = intern.STR_NIL;
        }

        val res_os: R.Result[StrArr, str] = parse_filter_axis(alloc, itn, sub, "os", label, as_root);
        if (R.is_err[StrArr, str](res_os)) { ret R.err[R.Void, str](R.unwrap_err[StrArr, str](res_os)); }
        val os_v: StrArr = R.unwrap_ok[StrArr, str](res_os);
        if (!os_v.present && as_root) { ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {} is missing required key 'os' (use \"*\" for any)", label)); }
        d.os = os_v.items;
        d.os_count = os_v.count;
        d.os_present = os_v.present;

        val res_isa: R.Result[StrArr, str] = parse_filter_axis(alloc, itn, sub, "isa", label, as_root);
        if (R.is_err[StrArr, str](res_isa)) { ret R.err[R.Void, str](R.unwrap_err[StrArr, str](res_isa)); }
        val isa_v: StrArr = R.unwrap_ok[StrArr, str](res_isa);
        if (!isa_v.present && as_root) { ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {} is missing required key 'isa' (use \"*\" for any)", label)); }
        d.isa = isa_v.items;
        d.isa_count = isa_v.count;
        d.isa_present = isa_v.present;

        val res_abi: R.Result[StrArr, str] = parse_filter_axis(alloc, itn, sub, "abi", label, as_root);
        if (R.is_err[StrArr, str](res_abi)) { ret R.err[R.Void, str](R.unwrap_err[StrArr, str](res_abi)); }
        val abi_v: StrArr = R.unwrap_ok[StrArr, str](res_abi);
        if (!abi_v.present && as_root) { ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {} is missing required key 'abi' (use \"*\" for any)", label)); }
        d.abi = abi_v.items;
        d.abi_count = abi_v.count;
        d.abi_present = abi_v.present;

        val export_v: *toml.Value = toml.get(sub, "export");
        if (export_v == nil && as_root) {
            val lbl_msg_export: str = sfmt(alloc, "mach.toml: {} is missing required key 'export'", label);
            str_free(alloc, label); ret R.err[R.Void, str](lbl_msg_export);
        }
        if (export_v == nil) { d.export = false; }
        or (export_v.tag != toml.TYPE_BOOL) { ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {}.export must be a boolean", label)); }
        or { d.export = export_v.data.boolean; }

        val include_v: *toml.Value = toml.get(sub, "include");
        if (include_v == nil) { d.include_referenced = false; }
        or (include_v.tag != toml.TYPE_STRING) { ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {}.include must be \"always\" or \"referenced\"", label)); }
        or {
            val include_s: str = include_v.data.string;
            if (str_equals(include_s, "always")) { d.include_referenced = false; }
            or (str_equals(include_s, "referenced")) { d.include_referenced = true; }
            or { ret R.err[R.Void, str](sfmt(alloc, "mach.toml: {}.include must be \"always\" or \"referenced\"", label)); }
        }

        str_free(alloc, label);
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun step_parse_error(alloc: *A.Allocator, label: str, msg: str) R.Result[R.Void, str] {
    str_free(alloc, label);
    ret R.err[R.Void, str](msg);
}

fun env_key_compare(a: str, b: str) i64 {
    val an: usize = str_len(a);
    val bn: usize = str_len(b);
    var n: usize = an;
    if (bn < n) { n = bn; }
    var i: usize = 0;
    for (i < n) {
        val ac: char = char_to_lower(a[i]::char);
        val bc: char = char_to_lower(b[i]::char);
        if (ac < bc) { ret -1; }
        if (ac > bc) { ret 1; }
        i = i + 1;
    }
    if (an < bn) { ret -1; }
    if (an > bn) { ret 1; }
    ret str_compare(a, b);
}

fun env_keys_ambiguous(left: str, right: str) R.Result[bool, str] {
    val length: usize = str_len(left);
    if (length == str_len(right)) {
        var i: usize = 0;
        for (i < length && char_to_lower(left[i]::char) == char_to_lower(right[i]::char)) { i = i + 1; }
        if (i == length) { ret R.ok[bool, str](true); }
    }
    $if ($mach.build.os == $mach.os.windows) {
        val order: R.Result[i32, str] = process_env.compare_names(left, right);
        if (R.is_err[i32, str](order)) { ret R.err[bool, str](R.unwrap_err[i32, str](order)); }
        ret R.ok[bool, str](R.unwrap_ok[i32, str](order) == 0);
    }
    $or { ret R.ok[bool, str](false); }
}

fun parse_steps(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest, as_root: bool) R.Result[R.Void, str] {
    val tab: *toml.Table = toml.get_table(t, "step");
    if (tab == nil) { ret R.ok_void[str](); }
    val n: usize = toml.table_len(tab);
    if (n == 0) { ret R.ok_void[str](); }
    if (n > 0xFFFFFFFF::usize) { ret R.err[R.Void, str]("mach.toml: too many build steps"); }

    val res_steps: R.Result[*StepDef, str] = A.allocate[StepDef](alloc, n);
    if (R.is_err[*StepDef, str](res_steps)) { ret R.err[R.Void, str](R.unwrap_err[*StepDef, str](res_steps)); }
    m.steps      = R.unwrap_ok[*StepDef, str](res_steps);
    m.step_count = n::u32;

    var initialized: usize = 0;
    for (initialized < n) {
        val slot: *StepDef = ?m.steps[initialized];
        slot.argv = nil;
        slot.argv_count = 0;
        slot.env_keys = nil;
        slot.env_values = nil;
        slot.env_count = 0;
        slot.in = nil;
        slot.in_count = 0;
        slot.out = nil;
        slot.out_count = 0;
        slot.need = nil;
        slot.need_count = 0;
        slot.timeout_seconds = 0;
        initialized = initialized + 1;
    }

    var i: usize = 0;
    for (i < n) {
        val name: str = toml.table_key(tab, i);
        val v: *toml.Value = toml.table_value(tab, i);
        val label: str = sfmt(alloc, "[step.{}]", name);
        if (v == nil || v.tag != toml.TYPE_TABLE) {
            ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {} must be a table", label));
        }
        val sub: *toml.Table = ?v.data.table;

        if (toml.get(sub, "cmd") != nil) {
            ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {} uses removed key 'cmd'; use a nonempty 'argv' array", label));
        }
        if (toml.get(sub, "shell") != nil) {
            ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {} uses removed key 'shell'; put the shell executable and its arguments in 'argv'", label));
        }

        val res_keys: R.Result[R.Void, str] = check_keys(alloc, sub, label, TK_STEP, as_root, m);
        if (R.is_err[R.Void, str](res_keys)) { ret step_parse_error(alloc, label, R.unwrap_err[R.Void, str](res_keys)); }

        val d: *StepDef = ?m.steps[i];
        if (!is_valid_id(name)) { ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {} name must be an identifier (letters, digits, '_', '-')", label)); }
        val name_r: R.Result[intern.StrId, str] = intern.intern(itn, name);
        if (R.is_err[intern.StrId, str](name_r)) {
            ret step_parse_error(alloc, label, R.unwrap_err[intern.StrId, str](name_r));
        }
        d.name = R.unwrap_ok[intern.StrId, str](name_r);

        val argv_v: *toml.Value = toml.get(sub, "argv");
        if (argv_v == nil) { ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {} is missing required key 'argv'", label)); }
        if (argv_v.tag != toml.TYPE_ARRAY) { ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.argv must be an array of strings", label)); }
        val res_argv: R.Result[StrArr, str] = parse_str_array(alloc, itn, ?argv_v.data.array, label, "argv", false);
        if (R.is_err[StrArr, str](res_argv)) { ret step_parse_error(alloc, label, R.unwrap_err[StrArr, str](res_argv)); }
        val argv_val: StrArr = R.unwrap_ok[StrArr, str](res_argv);
        d.argv = argv_val.items;
        d.argv_count = argv_val.count;
        if (argv_val.count == 0) { ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.argv must be nonempty", label)); }
        if (str_empty(idstr(itn, argv_val.items[0]))) { ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.argv[0] must name an executable", label)); }

        val env_v: *toml.Value = toml.get(sub, "env");
        if (env_v != nil && env_v.tag != toml.TYPE_TABLE) {
            ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.env must be a table of string values", label));
        }
        if (env_v != nil) {
            val env_t: *toml.Table = ?env_v.data.table;
            val env_n: usize = toml.table_len(env_t);
            if (env_n > 0xFFFFFFFF::usize) {
                ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.env has too many entries", label));
            }
            if (env_n > 0) {
                val env_keys_r: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](alloc, env_n);
                if (R.is_err[*intern.StrId, str](env_keys_r)) { ret step_parse_error(alloc, label, R.unwrap_err[*intern.StrId, str](env_keys_r)); }
                val env_values_r: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](alloc, env_n);
                if (R.is_err[*intern.StrId, str](env_values_r)) {
                    A.deallocate[intern.StrId](alloc, R.unwrap_ok[*intern.StrId, str](env_keys_r), env_n);
                    ret step_parse_error(alloc, label, R.unwrap_err[*intern.StrId, str](env_values_r));
                }
                d.env_keys = R.unwrap_ok[*intern.StrId, str](env_keys_r);
                d.env_values = R.unwrap_ok[*intern.StrId, str](env_values_r);
                d.env_count = env_n::u32;
                var ei: usize = 0;
                for (ei < env_n) {
                    val env_key: str = toml.table_key(env_t, ei);
                    if (str_empty(env_key) || str_contains_char(env_key, '=')) {
                        ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.env key '{}' must be nonempty and cannot contain '='", label, env_key));
                    }
                    var ej: usize = 0;
                    for (ej < ei) {
                        val prior: str = idstr(itn, d.env_keys[ej]);
                        val ambiguous: R.Result[bool, str] = env_keys_ambiguous(prior, env_key);
                        if (R.is_err[bool, str](ambiguous)) { ret step_parse_error(alloc, label, R.unwrap_err[bool, str](ambiguous)); }
                        if (R.unwrap_ok[bool, str](ambiguous)) {
                            ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.env has ambiguous keys '{}' and '{}'", label, prior, env_key));
                        }
                        ej = ej + 1;
                    }
                    val env_value: *toml.Value = toml.table_value(env_t, ei);
                    if (env_value == nil || env_value.tag != toml.TYPE_STRING) {
                        ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.env.{} must be a string", label, env_key));
                    }
                    val env_key_r: R.Result[intern.StrId, str] = intern.intern(itn, env_key);
                    if (R.is_err[intern.StrId, str](env_key_r)) {
                        ret step_parse_error(alloc, label, R.unwrap_err[intern.StrId, str](env_key_r));
                    }
                    val env_value_r: R.Result[intern.StrId, str] = intern.intern(itn, env_value.data.string);
                    if (R.is_err[intern.StrId, str](env_value_r)) {
                        ret step_parse_error(alloc, label, R.unwrap_err[intern.StrId, str](env_value_r));
                    }
                    d.env_keys[ei] = R.unwrap_ok[intern.StrId, str](env_key_r);
                    d.env_values[ei] = R.unwrap_ok[intern.StrId, str](env_value_r);
                    ei = ei + 1;
                }
                ei = 1;
                for (ei < env_n) {
                    val key: intern.StrId = d.env_keys[ei];
                    val value: intern.StrId = d.env_values[ei];
                    var ej: usize = ei;
                    for (ej > 0 && env_key_compare(idstr(itn, key), idstr(itn, d.env_keys[ej - 1])) < 0) {
                        d.env_keys[ej] = d.env_keys[ej - 1];
                        d.env_values[ej] = d.env_values[ej - 1];
                        ej = ej - 1;
                    }
                    d.env_keys[ej] = key;
                    d.env_values[ej] = value;
                    ei = ei + 1;
                }
            }
        }

        val in_arr: *toml.Array = toml.get_array(sub, "in");
        if (in_arr == nil) { ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {} is missing required key 'in'", label)); }
        val res_in: R.Result[StrArr, str] = parse_str_array(alloc, itn, in_arr, label, "in", false);
        if (R.is_err[StrArr, str](res_in)) { ret step_parse_error(alloc, label, R.unwrap_err[StrArr, str](res_in)); }
        val in_val: StrArr = R.unwrap_ok[StrArr, str](res_in);
        d.in = in_val.items;
        d.in_count = in_val.count;
        var ii: u32 = 0;
        for (ii < d.in_count) {
            val p: str = idstr(itn, d.in[ii]);
            val in_field: str = sfmt(alloc, "{}.in", label);
            val res_check: R.Result[R.Void, str] = check_path(alloc, p, in_field);
            str_free(alloc, in_field);
            if (R.is_err[R.Void, str](res_check)) { ret step_parse_error(alloc, label, R.unwrap_err[R.Void, str](res_check)); }
            ii = ii + 1;
        }

        val out_arr: *toml.Array = toml.get_array(sub, "out");
        if (out_arr == nil) { ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {} is missing required key 'out'", label)); }
        val res_out: R.Result[StrArr, str] = parse_str_array(alloc, itn, out_arr, label, "out", false);
        if (R.is_err[StrArr, str](res_out)) { ret step_parse_error(alloc, label, R.unwrap_err[StrArr, str](res_out)); }
        val out_val: StrArr = R.unwrap_ok[StrArr, str](res_out);
        d.out = out_val.items;
        d.out_count = out_val.count;
        ii = 0;
        for (ii < d.out_count) {
            val p: str = idstr(itn, d.out[ii]);
            if (str_contains_char(p, '*')) { ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.out cannot contain a glob '*'; outputs must be concrete paths", label)); }
            val out_path_field: str = sfmt(alloc, "{}.out", label);
            val res_check: R.Result[R.Void, str] = check_path(alloc, p, out_path_field);
            str_free(alloc, out_path_field);
            if (R.is_err[R.Void, str](res_check)) { ret step_parse_error(alloc, label, R.unwrap_err[R.Void, str](res_check)); }
            ii = ii + 1;
        }

        val need_arr: *toml.Array = toml.get_array(sub, "need");
        if (need_arr == nil && as_root) {
            ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {} is missing required key 'need' (use [] for none)", label));
        }
        if (need_arr != nil) {
            val res_need: R.Result[StrArr, str] = parse_str_array(alloc, itn, need_arr, label, "need", false);
            if (R.is_err[StrArr, str](res_need)) { ret step_parse_error(alloc, label, R.unwrap_err[StrArr, str](res_need)); }
            val need_val: StrArr = R.unwrap_ok[StrArr, str](res_need);
            d.need = need_val.items;
            d.need_count = need_val.count;
        }

        val timeout_v: *toml.Value = toml.get(sub, "timeout_seconds");
        if (timeout_v != nil) {
            if (timeout_v.tag != toml.TYPE_INTEGER) {
                ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.timeout_seconds must be an integer number of seconds", label));
            }
            val timeout_n: i64 = timeout_v.data.integer;
            if (timeout_n < 1) {
                ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.timeout_seconds must be at least 1; omit the key for an unbounded step", label));
            }
            d.timeout_seconds = timeout_n;
        }

        str_free(alloc, label);
        i = i + 1;
    }
    ret R.ok_void[str]();
}

# free every array a parsed manifest owns and zero the counts. safe on the
# result of `empty` and on a manifest already released
# ---
# m: the manifest
# alloc: the allocator `parse` was given
pub fun dnit(m: *Manifest, alloc: *A.Allocator) {
    if (m.native_target != nil) {
        A.deallocate[TargetDef](alloc, m.native_target, 1);
        m.native_target = nil;
    }
    if (m.targets != nil && m.target_count > 0) {
        A.deallocate[TargetDef](alloc, m.targets, m.target_count::usize);
        m.targets = nil;
        m.target_count = 0;
    }
    if (m.artifacts != nil && m.artifact_count > 0) {
        var i: u32 = 0;
        for (i < m.artifact_count) {
            val a: *ArtifactDef = ?m.artifacts[i];
            free_strarr(alloc, a.targets, a.target_count);
            free_strarr(alloc, a.link, a.link_count);
            free_strarr(alloc, a.need, a.need_count);
            i = i + 1;
        }
        A.deallocate[ArtifactDef](alloc, m.artifacts, m.artifact_count::usize);
        m.artifacts = nil;
        m.artifact_count = 0;
    }
    if (m.profiles != nil && m.profile_count > 0) {
        A.deallocate[ProfileDef](alloc, m.profiles, m.profile_count::usize);
        m.profiles = nil;
        m.profile_count = 0;
    }
    if (m.deps != nil && m.dep_count > 0) {
        A.deallocate[DepDef](alloc, m.deps, m.dep_count::usize);
        m.deps = nil;
        m.dep_count = 0;
    }
    if (m.links != nil && m.link_count > 0) {
        var i: u32 = 0;
        for (i < m.link_count) {
            val l: *LinkDef = ?m.links[i];
            free_strarr(alloc, l.os, l.os_count);
            free_strarr(alloc, l.isa, l.isa_count);
            free_strarr(alloc, l.abi, l.abi_count);
            free_strarr(alloc, l.symbols, l.symbol_count);
            i = i + 1;
        }
        A.deallocate[LinkDef](alloc, m.links, m.link_count::usize);
        m.links = nil;
        m.link_count = 0;
    }
    if (m.steps != nil && m.step_count > 0) {
        var i: u32 = 0;
        for (i < m.step_count) {
            val s: *StepDef = ?m.steps[i];
            free_strarr(alloc, s.argv, s.argv_count);
            free_strarr(alloc, s.env_keys, s.env_count);
            free_strarr(alloc, s.env_values, s.env_count);
            free_strarr(alloc, s.in, s.in_count);
            free_strarr(alloc, s.out, s.out_count);
            free_strarr(alloc, s.need, s.need_count);
            i = i + 1;
        }
        A.deallocate[StepDef](alloc, m.steps, m.step_count::usize);
        m.steps = nil;
        m.step_count = 0;
    }
    free_deprecated(alloc, m);
}

fun free_path_strings(alloc: *A.Allocator, paths: *str, count: u32) {
    if (paths == nil) { ret; }
    var i: u32 = 0;
    for (i < count) {
        str_free(alloc, paths[i]);
        i = i + 1;
    }
}

fun free_strarr(alloc: *A.Allocator, items: *intern.StrId, count: u32) {
    if (items != nil && count > 0) {
        A.deallocate[intern.StrId](alloc, items, count::usize);
    }
}

# free the symbol arrays of `count` requirements and nil them. the `items` array
# itself is not freed
# ---
# alloc: the allocator the claims were made from
# items: the requirements; nil is accepted
# count: how many entries to release
pub fun free_link_claims(alloc: *A.Allocator, items: *LinkRequirement, count: u32) {
    if (items == nil) { ret; }
    var i: u32 = 0;
    for (i < count) {
        free_strarr(alloc, items[i].symbols, items[i].symbol_count);
        items[i].symbols      = nil;
        items[i].symbol_count = 0;
        i = i + 1;
    }
}

# turn a partially filled requirement buffer into an exactly sized result, taking
# ownership of the buffer
# ---
# alloc: the buffer's allocator
# items: a buffer of `capacity` entries with the first `count` filled
# capacity: the buffer's allocated extent
# count: the filled prefix
# out_items: receives the exact array, or nil when `count` is 0 or on error
# out_count: receives `count`, or 0 when it is 0 or on error
# ret: ok; when `count` is 0 the buffer is freed. on a failed shrink the filled
#  claims and the whole buffer are freed and the allocator's error is returned
pub fun finish_link_requirements(alloc: *A.Allocator, items: *LinkRequirement,
                                 capacity: u32, count: u32,
                                 out_items: **LinkRequirement,
                                 out_count: *u32) R.Result[R.Void, str] {
    @out_items = nil;
    @out_count = 0;
    if (count == 0) {
        A.deallocate[LinkRequirement](alloc, items, capacity::usize);
        ret R.ok_void[str]();
    }
    if (count < capacity) {
        val sr: R.Result[*LinkRequirement, str] =
            A.reallocate[LinkRequirement](alloc, items, capacity::usize, count::usize);
        if (R.is_err[*LinkRequirement, str](sr)) {
            free_link_claims(alloc, items, count);
            A.deallocate[LinkRequirement](alloc, items, capacity::usize);
            ret R.err[R.Void, str](R.unwrap_err[*LinkRequirement, str](sr));
        }
        items = R.unwrap_ok[*LinkRequirement, str](sr);
    }
    @out_items = items;
    @out_count = count;
    ret R.ok_void[str]();
}

# add every symbol of `src` that `dst` lacks to `dst`, keeping `dst` order first
# and the new entries in `src` order. `src` is not modified
# ---
# alloc: the allocator of `dst.symbols`; the old array is freed and replaced
# dst: the requirement that grows
# src: the requirement whose symbols are added
# ret: ok, without allocating, when nothing is new; err on a symbol count
#  overflow or allocation failure, leaving `dst` unchanged
pub fun merge_link_claims(alloc: *A.Allocator, dst: *LinkRequirement,
                          src: *LinkRequirement) R.Result[R.Void, str] {
    var added: u32 = 0;
    var i: u32 = 0;
    for (i < src.symbol_count) {
        var present: bool = false;
        var j: u32 = 0;
        for (j < dst.symbol_count) {
            if (dst.symbols[j] == src.symbols[i]) { present = true; brk; }
            j = j + 1;
        }
        j = 0;
        for (!present && j < i) {
            if (src.symbols[j] == src.symbols[i]) { present = true; brk; }
            j = j + 1;
        }
        if (!present) { added = added + 1; }
        i = i + 1;
    }
    if (added == 0) { ret R.ok_void[str](); }
    if (dst.symbol_count > 0xFFFFFFFF - added) {
        ret R.err[R.Void, str]("too many merged link symbol claims");
    }

    val total: u32 = dst.symbol_count + added;
    val ar: R.Result[*intern.StrId, str] =
        A.allocate[intern.StrId](alloc, total::usize);
    if (R.is_err[*intern.StrId, str](ar)) {
        ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](ar));
    }
    val merged: *intern.StrId = R.unwrap_ok[*intern.StrId, str](ar);
    var written: u32 = 0;
    for (written < dst.symbol_count) {
        merged[written] = dst.symbols[written];
        written = written + 1;
    }
    i = 0;
    for (i < src.symbol_count) {
        var present: bool = false;
        var j: u32 = 0;
        for (j < written) {
            if (merged[j] == src.symbols[i]) { present = true; brk; }
            j = j + 1;
        }
        if (!present) {
            merged[written] = src.symbols[i];
            written = written + 1;
        }
        i = i + 1;
    }

    if (dst.symbols != nil && dst.symbol_count > 0) {
        A.deallocate[intern.StrId](alloc, dst.symbols, dst.symbol_count::usize);
    }
    dst.symbols = merged;
    dst.symbol_count = total;
    ret R.ok_void[str]();
}

fun seg_eq(tmpl: str, start: usize, end: usize, lit: str) bool {
    val ll: usize = str_len(lit);
    if (end - start != ll) { ret false; }
    var i: usize = 0;
    for (i < ll) {
        if (tmpl[start + i] != lit[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun seg_dup(alloc: *A.Allocator, tmpl: str, start: usize, end: usize) str {
    val n: usize = end - start;
    val res_buf: R.Result[*u8, str] = A.allocate[u8](alloc, n + 1);
    if (R.is_err[*u8, str](res_buf)) { ret ""; }
    val buf: *u8 = R.unwrap_ok[*u8, str](res_buf);
    var i: usize = 0;
    for (i < n) { buf[i] = tmpl[start + i]; i = i + 1; }
    buf[n] = 0;
    ret buf::str;
}

val TMPL_ARTIFACT_PREFIX: str = "artifact.";
val TMPL_ARTIFACT_SUFFIX: str = ".out";

fun region_eq_str(tmpl: str, start: usize, end: usize, s: str) bool {
    val n: usize = end - start;
    if (str_len(s) != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (tmpl[start + i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun tmpl_artifact_id(tmpl: str, start: usize, end: usize, id_start: *usize, id_end: *usize) bool {
    val pl: usize = str_len(TMPL_ARTIFACT_PREFIX);
    val sl: usize = str_len(TMPL_ARTIFACT_SUFFIX);
    if (end <= start || end - start <= pl + sl) { ret false; }
    var i: usize = 0;
    for (i < pl) {
        if (tmpl[start + i] != TMPL_ARTIFACT_PREFIX[i]) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < sl) {
        if (tmpl[end - sl + i] != TMPL_ARTIFACT_SUFFIX[i]) { ret false; }
        i = i + 1;
    }
    @id_start = start + pl;
    @id_end   = end - sl;
    ret true;
}

fun tmpl_is_artifact_out(tmpl: str, start: usize, end: usize) bool {
    var s: usize = 0;
    var e: usize = 0;
    ret tmpl_artifact_id(tmpl, start, end, ?s, ?e);
}

fun tmpl_artifact_value(alloc: *A.Allocator, tmpl: str, id_start: usize, id_end: usize,
                        v: *TmplVars) R.Result[str, str] {
    val id: str = seg_dup(alloc, tmpl, id_start, id_end);
    var i: u32 = 0;
    for (i < v.req_count) {
        if (region_eq_str(tmpl, id_start, id_end, v.reqs[i].name)) {
            if (str_empty(v.reqs[i].out)) {
                ret R.err[str, str](sfmt(alloc,
                    "mach.toml: '{{artifact.{}.out}}' is ambiguous: artifact '{}' builds for more than one target here",
                    id, id));
            }
            ret R.ok[str, str](v.reqs[i].out);
        }
        i = i + 1;
    }
    ret R.err[str, str](sfmt(alloc,
        "mach.toml: '{{artifact.{}.out}}' names an artifact this artifact does not require; add '{}' to its 'need'",
        id, id));
}

fun tmpl_value(alloc: *A.Allocator, tmpl: str, start: usize, end: usize, project_out: str,
               v: *TmplVars) R.Result[str, str] {
    if (seg_eq(tmpl, start, end, "project.out")) {
        if (str_empty(project_out)) { ret R.err[str, str]("mach.toml: '{project.out}' is not available in [project].out"); }
        ret R.ok[str, str](project_out);
    }
    if (seg_eq(tmpl, start, end, "target.name"))  { ret R.ok[str, str](v.target); }
    if (seg_eq(tmpl, start, end, "target.isa"))   { ret R.ok[str, str](v.isa); }
    if (seg_eq(tmpl, start, end, "target.os"))    { ret R.ok[str, str](v.os); }
    if (seg_eq(tmpl, start, end, "target.abi"))   { ret R.ok[str, str](v.abi); }
    if (seg_eq(tmpl, start, end, "profile.name")) { ret R.ok[str, str](v.profile); }
    var id_start: usize = 0;
    var id_end:   usize = 0;
    if (tmpl_artifact_id(tmpl, start, end, ?id_start, ?id_end)) {
        ret tmpl_artifact_value(alloc, tmpl, id_start, id_end, v);
    }
    ret R.err[str, str](sfmt(alloc, "mach.toml: unknown template variable '{{{}}}'", seg_dup(alloc, tmpl, start, end)));
}

fun tmpl_known(tmpl: str, start: usize, end: usize) bool {
    ret seg_eq(tmpl, start, end, "project.out")
        || seg_eq(tmpl, start, end, "target.name")
        || seg_eq(tmpl, start, end, "target.isa")
        || seg_eq(tmpl, start, end, "target.os")
        || seg_eq(tmpl, start, end, "target.abi")
        || seg_eq(tmpl, start, end, "profile.name")
        || tmpl_is_artifact_out(tmpl, start, end);
}

fun tmpl_namespace(tmpl: str, start: usize, end: usize, namespace: str) bool {
    val nn: usize = str_len(namespace);
    if (end - start < nn) { ret false; }
    var i: usize = 0;
    for (i < nn) {
        if (tmpl[start + i] != namespace[i]) { ret false; }
        i = i + 1;
    }
    ret end - start == nn || tmpl[start + nn] == '.';
}

fun tmpl_reserved(tmpl: str, start: usize, end: usize) bool {
    ret tmpl_namespace(tmpl, start, end, "project")
        || tmpl_namespace(tmpl, start, end, "target")
        || tmpl_namespace(tmpl, start, end, "profile")
        || tmpl_namespace(tmpl, start, end, "artifact");
}

# template variables for one target and profile, with no artifact requirements
# ---
# itn: resolves the target's interned strings
# t: the target
# pn: the profile name
# ret: the variables; `reqs` is nil
pub fun tmpl_vars_of(itn: *intern.Interner, t: *TargetDef, pn: str) TmplVars {
    var v: TmplVars;
    v.target    = idstr(itn, t.name);
    v.isa       = idstr(itn, t.isa);
    v.os        = idstr(itn, t.os);
    v.abi       = idstr(itn, t.abi);
    v.profile   = pn;
    v.reqs      = nil;
    v.req_count = 0;
    ret v;
}

fun tmpl_vars_of_reqs(reqs: *ArtifactReq, req_count: u32) TmplVars {
    var v: TmplVars;
    v.target    = "";
    v.isa       = "";
    v.os        = "";
    v.abi       = "";
    v.profile   = "";
    v.reqs      = reqs;
    v.req_count = req_count;
    ret v;
}

pub rec TemplateError {
    kind: fail.PhaseKind;
    message: str;
}

pub fun template_internal(message: str) TemplateError {
    var e: TemplateError;
    e.kind = fail.INTERNAL;
    e.message = message;
    ret e;
}

pub fun template_error_dnit(alloc: *A.Allocator, e: TemplateError) {
    if (e.kind == fail.REJECTED) { str_free(alloc, e.message); }
}

pub fun template_rejection(alloc: *A.Allocator, field: str, tmpl: str, reason: str) TemplateError {
    val r: R.Result[str, str] = format.sprint(alloc, "{}: {}: '{}'", field, reason, tmpl);
    if (R.is_err[str, str](r)) { ret template_internal(R.unwrap_err[str, str](r)); }
    var e: TemplateError;
    e.kind = fail.REJECTED;
    e.message = R.unwrap_ok[str, str](r);
    ret e;
}

fun artifact_path_value(alloc: *A.Allocator, tmpl: str, start: usize, end: usize,
                        reqs: *ArtifactReq, req_count: u32, field: str) R.Result[str, TemplateError] {
    var id_start: usize = 0;
    var id_end: usize = 0;
    if (!tmpl_artifact_id(tmpl, start, end, ?id_start, ?id_end)) {
        ret R.err[str, TemplateError](template_rejection(alloc, field, tmpl,
            "only '{artifact.<id>.out}' may appear in this path"));
    }
    var i: u32 = 0;
    for (i < req_count) {
        if (region_eq_str(tmpl, id_start, id_end, reqs[i].name)) {
            if (str_empty(reqs[i].out)) {
                ret R.err[str, TemplateError](template_rejection(alloc, field, tmpl,
                    "artifact output is ambiguous: the artifact builds for more than one target here"));
            }
            ret R.ok[str, TemplateError](reqs[i].out);
        }
        i = i + 1;
    }
    ret R.err[str, TemplateError](template_rejection(alloc, field, tmpl,
        "names an artifact this artifact does not require; add it to its 'need'"));
}

# expand artifact-only source paths, preserving rejection versus allocation failure.
# the caller owns the result and rejected error message through template_error_dnit.
pub fun expand_artifact_path(alloc: *A.Allocator, tmpl: str, reqs: *ArtifactReq, req_count: u32,
                             field: str) R.Result[str, TemplateError] {
    val n: usize = str_len(tmpl);
    var total: usize = 0;
    var i: usize = 0;
    for (i < n) {
        var len: usize = 1;
        if (tmpl[i] == '{') {
            var ii: usize = i + 1;
            for (ii < n && tmpl[ii] != '}') { ii = ii + 1; }
            if (ii >= n) {
                ret R.err[str, TemplateError](template_rejection(alloc, field, tmpl,
                    "unterminated '{' in a path template"));
            }
            val vr: R.Result[str, TemplateError] = artifact_path_value(alloc, tmpl, i + 1, ii,
                reqs, req_count, field);
            if (R.is_err[str, TemplateError](vr)) { ret vr; }
            len = str_len(R.unwrap_ok[str, TemplateError](vr));
            i = ii + 1;
        } or { i = i + 1; }
        if (len >= 0xffffffffffffffff::usize - total) {
            ret R.err[str, TemplateError](template_internal("artifact path expansion is too large"));
        }
        total = total + len;
    }
    val br: R.Result[*u8, str] = A.allocate[u8](alloc, total + 1);
    if (R.is_err[*u8, str](br)) {
        ret R.err[str, TemplateError](template_internal(R.unwrap_err[*u8, str](br)));
    }
    val buf: *u8 = R.unwrap_ok[*u8, str](br);
    var w: usize = 0;
    i = 0;
    for (i < n) {
        if (tmpl[i] == '{') {
            var ii: usize = i + 1;
            for (ii < n && tmpl[ii] != '}') { ii = ii + 1; }
            val vr: R.Result[str, TemplateError] = artifact_path_value(alloc, tmpl, i + 1, ii,
                reqs, req_count, field);
            if (R.is_err[str, TemplateError](vr)) {
                A.deallocate[u8](alloc, buf, total + 1);
                ret vr;
            }
            val value: str = R.unwrap_ok[str, TemplateError](vr);
            var j: usize = 0;
            for (j < str_len(value)) { buf[w] = value[j]; w = w + 1; j = j + 1; }
            i = ii + 1;
        } or { buf[w] = tmpl[i]; w = w + 1; i = i + 1; }
    }
    buf[w] = 0;
    ret R.ok[str, TemplateError](buf::str);
}

# `tmpl_vars_of` with artifact requirements attached
# ---
# itn: resolves the target's interned strings
# t: the target
# pn: the profile name
# reqs: the requirements `{artifact.<id>.out}` may name
# req_count: length of `reqs`
# ret: the variables
pub fun tmpl_vars_with_reqs(itn: *intern.Interner, t: *TargetDef, pn: str,
                            reqs: *ArtifactReq, req_count: u32) TmplVars {
    var v: TmplVars = tmpl_vars_of(itn, t, pn);
    v.reqs      = reqs;
    v.req_count = req_count;
    ret v;
}

# expand a path template. the placeholders are `{project.out}`, `{target.name}`,
# `{target.isa}`, `{target.os}`, `{target.abi}`, `{profile.name}` and
# `{artifact.<id>.out}`; nothing else is accepted
# ---
# alloc: owns the returned string
# tmpl: the template
# project_out: the expanded `[project].out`, or "" when expanding `[project].out`
#  itself, in which case `{project.out}` is an error
# v: the values
# ret: the expanded string; err on an unterminated '{', an unknown placeholder,
#  an artifact not in `v.reqs`, or an artifact whose output is ambiguous
pub fun expand(alloc: *A.Allocator, tmpl: str, project_out: str,
               v: *TmplVars) R.Result[str, str] {
    val n: usize = str_len(tmpl);
    var total: usize = 0;
    var i: usize = 0;
    for (i < n) {
        if (tmpl[i] == '{') {
            var ii: usize = i + 1;
            for (ii < n && tmpl[ii] != '}') { ii = ii + 1; }
            if (ii >= n) { ret R.err[str, str]("mach.toml: unterminated '{' in a path template"); }
            val res_value: R.Result[str, str] = tmpl_value(alloc, tmpl, i + 1, ii, project_out, v);
            if (R.is_err[str, str](res_value)) { ret R.err[str, str](R.unwrap_err[str, str](res_value)); }
            total = total + str_len(R.unwrap_ok[str, str](res_value));
            i = ii + 1;
        }
        or {
            total = total + 1;
            i = i + 1;
        }
    }

    val res_buf: R.Result[*u8, str] = A.allocate[u8](alloc, total + 1);
    if (R.is_err[*u8, str](res_buf)) { ret R.err[str, str](R.unwrap_err[*u8, str](res_buf)); }
    val buf: *u8 = R.unwrap_ok[*u8, str](res_buf);

    var w: usize = 0;
    i = 0;
    for (i < n) {
        if (tmpl[i] == '{') {
            var ii: usize = i + 1;
            for (ii < n && tmpl[ii] != '}') { ii = ii + 1; }
            val res_value: R.Result[str, str] = tmpl_value(alloc, tmpl, i + 1, ii, project_out, v);
            val value: str = R.unwrap_ok[str, str](res_value);
            val vl: usize = str_len(value);
            var iii: usize = 0;
            for (iii < vl) {
                buf[w] = value[iii];
                w = w + 1;
                iii = iii + 1;
            }
            i = ii + 1;
        }
        or {
            buf[w] = tmpl[i];
            w = w + 1;
            i = i + 1;
        }
    }
    buf[w] = 0;
    ret R.ok[str, str](buf::str);
}

# expand a build step `argv` or `env` value. known placeholders expand as in
# `expand`; a brace pair that is not a placeholder is copied verbatim, unless it
# starts with `project`, `target`, `profile` or `artifact`, which is an error
# ---
# alloc: owns the returned string
# tmpl: the value
# project_out: the expanded `[project].out`
# v: the values
# ret: the expanded string; err for an unknown or unterminated reserved
#  placeholder, the `expand` errors, or a result too large to size
pub fun expand_step_value(alloc: *A.Allocator, tmpl: str, project_out: str,
                          v: *TmplVars) R.Result[str, str] {
    val n: usize = str_len(tmpl);
    var total: usize = 0;
    var i: usize = 0;
    for (i < n) {
        if (tmpl[i] == '{') {
            var ii: usize = i + 1;
            for (ii < n && tmpl[ii] != '}') { ii = ii + 1; }
            if (ii < n && tmpl_known(tmpl, i + 1, ii)) {
                val value_r: R.Result[str, str] = tmpl_value(alloc, tmpl, i + 1, ii, project_out, v);
                if (R.is_err[str, str](value_r)) { ret R.err[str, str](R.unwrap_err[str, str](value_r)); }
                val vl: usize = str_len(R.unwrap_ok[str, str](value_r));
                if (vl > ~(0::usize) - total) { ret R.err[str, str]("mach.toml: expanded build step value is too large"); }
                total = total + vl;
                i = ii + 1;
            }
            or {
                if (tmpl_reserved(tmpl, i + 1, ii)) {
                    if (ii >= n) { ret R.err[str, str]("mach.toml: unterminated reserved build step template"); }
                    ret R.err[str, str]("mach.toml: unknown reserved build step template");
                }
                or {
                    if (total == ~(0::usize)) { ret R.err[str, str]("mach.toml: expanded build step value is too large"); }
                    total = total + 1;
                    i = i + 1;
                }
            }
        }
        or {
            if (total == ~(0::usize)) { ret R.err[str, str]("mach.toml: expanded build step value is too large"); }
            total = total + 1;
            i = i + 1;
        }
    }
    if (total == ~(0::usize)) { ret R.err[str, str]("mach.toml: expanded build step value is too large"); }

    val buf_r: R.Result[*u8, str] = A.allocate[u8](alloc, total + 1);
    if (R.is_err[*u8, str](buf_r)) { ret R.err[str, str](R.unwrap_err[*u8, str](buf_r)); }
    val buf: *u8 = R.unwrap_ok[*u8, str](buf_r);

    var w: usize = 0;
    i = 0;
    for (i < n) {
        if (tmpl[i] == '{') {
            var ii: usize = i + 1;
            for (ii < n && tmpl[ii] != '}') { ii = ii + 1; }
            if (ii < n && tmpl_known(tmpl, i + 1, ii)) {
                val value_r: R.Result[str, str] = tmpl_value(alloc, tmpl, i + 1, ii, project_out, v);
                val value: str = R.unwrap_ok[str, str](value_r);
                val vl: usize = str_len(value);
                var iii: usize = 0;
                for (iii < vl) {
                    buf[w] = value[iii];
                    w = w + 1;
                    iii = iii + 1;
                }
                i = ii + 1;
            }
            or {
                buf[w] = tmpl[i];
                w = w + 1;
                i = i + 1;
            }
        }
        or {
            buf[w] = tmpl[i];
            w = w + 1;
            i = i + 1;
        }
    }
    buf[w] = 0;
    ret R.ok[str, str](buf::str);
}

# `expand`, then require the result to satisfy `is_project_path`
# ---
# alloc: owns the returned string
# tmpl: the template
# project_out: as `expand`
# v: the values
# field: what the template is, for the error text
# ret: the expanded path; the `expand` errors, or err naming `field` when the
#  result escapes the project root
pub fun expand_project_path(alloc: *A.Allocator, tmpl: str, project_out: str,
                            v: *TmplVars, field: str) R.Result[str, str] {
    val res_expanded: R.Result[str, str] = expand(alloc, tmpl, project_out, v);
    if (R.is_err[str, str](res_expanded)) { ret res_expanded; }
    val expanded: str = R.unwrap_ok[str, str](res_expanded);
    if (!is_project_path(expanded)) {
        val msg: str = sfmt(alloc, "mach.toml: {} expands to a path that is not a canonical strict descendant of the project root", field);
        str_free(alloc, expanded);
        ret R.err[str, str](msg);
    }
    ret R.ok[str, str](expanded);
}

fun must_lookup(itn: *intern.Interner, id: intern.StrId) R.Result[str, str] {
    val opt_str: O.Option[str] = intern.lookup(itn, id);
    if (O.is_none[str](opt_str)) { ret R.err[str, str]("internal: manifest StrId not interned"); }
    ret R.ok[str, str](O.unwrap[str](opt_str));
}

fun find_target_by_name(itn: *intern.Interner, m: *Manifest, name: str) *TargetDef {
    val res_id: R.Result[intern.StrId, str] = intern.intern(itn, name);
    if (R.is_err[intern.StrId, str](res_id)) { ret nil; }
    val id: intern.StrId = R.unwrap_ok[intern.StrId, str](res_id);
    var i: u32 = 0;
    for (i < m.target_count) {
        if (m.targets[i].name == id) { ret ?m.targets[i]; }
        i = i + 1;
    }
    ret nil;
}

# whether a target's `os` and `isa` name the given host ids. the abi is not compared
# ---
# itn: resolves the target's strings
# d: the target
# host_os: an os id from `mach.lang.target.os`
# host_arch: an arch id from `mach.lang.target.isa`
# ret: true when both ids match; false when either string is unknown to `itn`
pub fun target_matches_host(itn: *intern.Interner, d: *TargetDef, host_os: u32, host_arch: u32) bool {
    val opt_os:  O.Option[str] = intern.lookup(itn, d.os);
    val opt_isa: O.Option[str] = intern.lookup(itn, d.isa);
    if (O.is_none[str](opt_os) || O.is_none[str](opt_isa)) { ret false; }
    val os_id:   u32 = os.os_id_for(O.unwrap[str](opt_os));
    val arch_id: u32 = isa.arch_id_for(O.unwrap[str](opt_isa));
    ret (os_id == host_os && arch_id == host_arch);
}

fun artifact_pinned_target(itn: *intern.Interner, m: *Manifest, a: *ArtifactDef) *TargetDef {
    val host_os:   u32 = tgt.host_os_id();
    val host_arch: u32 = tgt.host_arch_id();

    var only:       *TargetDef = nil;
    var count:      u32 = 0;
    var host_first: *TargetDef = nil;
    var host_count: u32 = 0;
    var i: u32 = 0;
    for (i < m.target_count) {
        if (artifact_supports_target(itn, a, m.targets[i].name)) {
            if (count == 0) { only = ?m.targets[i]; }
            count = count + 1;
            if (target_matches_host(itn, ?m.targets[i], host_os, host_arch)) {
                if (host_count == 0) { host_first = ?m.targets[i]; }
                host_count = host_count + 1;
            }
        }
        i = i + 1;
    }
    if (count == 1)      { ret only; }
    if (host_count == 1) { ret host_first; }
    ret nil;
}

fun artifact_target_names(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, a: *ArtifactDef) str {
    var s: str = "";
    var i: u32 = 0;
    for (i < m.target_count) {
        if (artifact_supports_target(itn, a, m.targets[i].name)) {
            if (!str_empty(s)) { s = sfmt(alloc, "{}, ", s); }
            val opt_name: O.Option[str] = intern.lookup(itn, m.targets[i].name);
            if (O.is_some[str](opt_name)) { s = sfmt(alloc, "{}{}", s, O.unwrap[str](opt_name)); }
        }
        i = i + 1;
    }
    ret s;
}

fun make_native_target(alloc: *A.Allocator, itn: *intern.Interner) R.Result[*TargetDef, str] {
    var host: TargetDef;
    val name: R.Result[intern.StrId, str] = intern.intern(itn, "native");
    if (R.is_err[intern.StrId, str](name)) { ret R.err[*TargetDef, str](R.unwrap_err[intern.StrId, str](name)); }
    host.name = R.unwrap_ok[intern.StrId, str](name);
    val isa_name: R.Result[intern.StrId, str] = intern.intern(itn, host_isa_name());
    if (R.is_err[intern.StrId, str](isa_name)) { ret R.err[*TargetDef, str](R.unwrap_err[intern.StrId, str](isa_name)); }
    host.isa = R.unwrap_ok[intern.StrId, str](isa_name);
    val os_name: R.Result[intern.StrId, str] = intern.intern(itn, host_os_name());
    if (R.is_err[intern.StrId, str](os_name)) { ret R.err[*TargetDef, str](R.unwrap_err[intern.StrId, str](os_name)); }
    host.os = R.unwrap_ok[intern.StrId, str](os_name);
    val abi_name: R.Result[intern.StrId, str] = intern.intern(itn, abi.abi_name_for(tgt.host_abi_id()));
    if (R.is_err[intern.StrId, str](abi_name)) { ret R.err[*TargetDef, str](R.unwrap_err[intern.StrId, str](abi_name)); }
    host.abi = R.unwrap_ok[intern.StrId, str](abi_name);
    host.is_default = false;
    host.env = intern.STR_NIL;
    host.of = intern.STR_NIL;
    host.platform = intern.STR_NIL;
    host.base = 0;
    host.stack_reserve = 0;
    host.stack_commit = 0;
    val owned: R.Result[*TargetDef, str] = A.allocate[TargetDef](alloc, 1);
    if (R.is_err[*TargetDef, str](owned)) { ret owned; }
    @R.unwrap_ok[*TargetDef, str](owned) = host;
    ret owned;
}

fun resolve_target(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, selector: str,
                   art: *ArtifactDef) R.Result[ResolvedTarget, str] {
    val host_os:   u32 = tgt.host_os_id();
    val host_arch: u32 = tgt.host_arch_id();

    if (str_empty(selector) && art != nil) {
        val pinned: *TargetDef = artifact_pinned_target(itn, m, art);
        if (pinned != nil) {
            var rt: ResolvedTarget;
            rt.target = pinned;
            rt.warned = false;
            rt.legacy_default = false;
            ret R.ok[ResolvedTarget, str](rt);
        }
    }

    var name: str = selector;
    if (str_empty(name)) {
        val opt_target: O.Option[str] = intern.lookup(itn, m.default_target);
        if (O.is_none[str](opt_target)) { ret R.err[ResolvedTarget, str]("internal: default target not interned"); }
        name = O.unwrap[str](opt_target);
    }

    if (!str_equals(name, "native")) {
        val d: *TargetDef = find_target_by_name(itn, m, name);
        if (d == nil) { ret R.err[ResolvedTarget, str](sfmt(alloc, "mach.toml: no target named '{}'", name)); }
        var rt: ResolvedTarget;
        rt.target = d;
        rt.warned = false;
        rt.legacy_default = false;
        ret R.ok[ResolvedTarget, str](rt);
    }

    var first_match: *TargetDef = nil;
    var match_count: u32 = 0;
    var names: str = "";
    var i: u32 = 0;
    for (i < m.target_count) {
        if (target_matches_host(itn, ?m.targets[i], host_os, host_arch)) {
            if (first_match == nil) { first_match = ?m.targets[i]; }
            if (match_count > 0) { names = sfmt(alloc, "{}, ", names); }
            val opt_name: O.Option[str] = intern.lookup(itn, m.targets[i].name);
            if (O.is_some[str](opt_name)) { names = sfmt(alloc, "{}{}", names, O.unwrap[str](opt_name)); }
            match_count = match_count + 1;
        }
        i = i + 1;
    }

    if (match_count > 1) {
        ret R.err[ResolvedTarget, str](sfmt(alloc, "mach.toml: 'native' matches multiple targets for the host ({})", names));
    }
    var rt: ResolvedTarget;
    if (match_count == 1) {
        rt.target = first_match;
        rt.warned = false;
        rt.legacy_default = false;
        ret R.ok[ResolvedTarget, str](rt);
    }
    if (m.target_count > 1) {
        var chosen: *TargetDef = nil;
        var default_count: u32 = 0;
        i = 0;
        for (i < m.target_count) {
            if (m.targets[i].is_default) {
                default_count = default_count + 1;
                chosen = ?m.targets[i];
            }
            i = i + 1;
        }
        if (default_count > 1) {
            ret R.err[ResolvedTarget, str]("mach.toml: multiple declared targets have 'default = true'; exactly one is allowed");
        }
        rt.legacy_default = false;
        if (chosen == nil) {
            chosen = ?m.targets[0];
            rt.legacy_default = true;
        }
        rt.target = chosen;
        rt.warned = true;
        ret R.ok[ResolvedTarget, str](rt);
    }
    if (m.target_count == 0) {
        if (m.native_target == nil) { ret R.err[ResolvedTarget, str]("internal: manifest has no native target owner"); }
        rt.target = m.native_target;
        rt.warned = false;
        rt.legacy_default = false;
        ret R.ok[ResolvedTarget, str](rt);
    }
    rt.target = ?m.targets[0];
    rt.warned = true;
    rt.legacy_default = false;
    ret R.ok[ResolvedTarget, str](rt);
}

fun profile_resolved(pf: *ProfileDef) ResolvedProfile {
    var rp: ResolvedProfile;
    rp.legacy_default = false;
    rp.name     = pf.name;
    rp.opt      = pf.opt;
    rp.debug         = pf.debug;
    rp.simd          = pf.simd;
    rp.vectorize     = pf.vectorize;
    rp.float_reassoc = pf.float_reassoc;
    ret rp;
}

# choose the profile a selection names. a named profile must be declared, except
# that a manifest with no profiles at all answers "debug" and "release" with the
# synthesized ones. an empty name takes the sole declared profile, else the one
# with `default = true`, else the first declared with `legacy_default` set, else
# the synthesized debug profile
# ---
# alloc: owns error text
# itn: interns the name
# m: the manifest
# sel: the profile name, or "" for the default
# ret: the profile; err "mach.toml: no profile named '<sel>'" or, with an empty
#  name, an error when more than one profile is marked default
pub fun resolve_profile(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, sel: str) R.Result[ResolvedProfile, str] {
    if (!str_empty(sel)) {
        val res_id: R.Result[intern.StrId, str] = intern.intern(itn, sel);
        if (R.is_err[intern.StrId, str](res_id)) { ret R.err[ResolvedProfile, str](R.unwrap_err[intern.StrId, str](res_id)); }
        val id: intern.StrId = R.unwrap_ok[intern.StrId, str](res_id);
        var i: u32 = 0;
        for (i < m.profile_count) {
            if (m.profiles[i].name == id) { ret R.ok[ResolvedProfile, str](profile_resolved(?m.profiles[i])); }
            i = i + 1;
        }
        if (m.profile_count == 0 && str_equals(sel, "debug")) {
            var debug: ProfileDef = builtin_profile(itn, "debug", MOPT_DEBUG, true, false, true);
            ret R.ok[ResolvedProfile, str](profile_resolved(?debug));
        }
        if (m.profile_count == 0 && str_equals(sel, "release")) {
            var release: ProfileDef = builtin_profile(itn, "release", MOPT_RELEASE, false, true, false);
            ret R.ok[ResolvedProfile, str](profile_resolved(?release));
        }
        ret R.err[ResolvedProfile, str](sfmt(alloc, "mach.toml: no profile named '{}'", sel));
    }

    if (m.profile_count == 1) {
        ret R.ok[ResolvedProfile, str](profile_resolved(?m.profiles[0]));
    }

    if (m.profile_count > 1) {
        var i: u32 = 0;
        var found: *ProfileDef = nil;
        for (i < m.profile_count) {
            if (m.profiles[i].is_default) {
                if (found != nil) {
                    ret R.err[ResolvedProfile, str]("mach.toml: multiple declared profiles have 'default = true'; exactly one is allowed");
                }
                found = ?m.profiles[i];
            }
            i = i + 1;
        }
        if (found == nil) {
            var legacy: ResolvedProfile = profile_resolved(?m.profiles[0]);
            legacy.legacy_default = true;
            ret R.ok[ResolvedProfile, str](legacy);
        }
        ret R.ok[ResolvedProfile, str](profile_resolved(found));
    }

    var debug: ProfileDef = builtin_profile(itn, "debug", MOPT_DEBUG, true, false, true);
    ret R.ok[ResolvedProfile, str](profile_resolved(?debug));
}

# the artifact a selection names: with `has_artifact`, the one whose name and
# `is_lib` both match `sel`; otherwise the sole declared artifact
# ---
# itn: interns the name
# m: the manifest
# sel: the selection
# ret: the artifact, or nil when none is declared, the name has no match of
#  the requested shape, or several artifacts are declared and none was named
pub fun resolve_artifact(itn: *intern.Interner, m: *Manifest, sel: Selection) *ArtifactDef {
    if (m.artifact_count == 0) { ret nil; }

    if (sel.has_artifact) {
        val res_id: R.Result[intern.StrId, str] = intern.intern(itn, sel.artifact);
        if (R.is_err[intern.StrId, str](res_id)) { ret nil; }
        val id: intern.StrId = R.unwrap_ok[intern.StrId, str](res_id);
        var i: u32 = 0;
        for (i < m.artifact_count) {
            if (m.artifacts[i].name == id && m.artifacts[i].is_lib == sel.want_lib) { ret ?m.artifacts[i]; }
            i = i + 1;
        }
        ret nil;
    }

    if (m.artifact_count == 1) { ret ?m.artifacts[0]; }
    ret nil;
}

fun filter_matches(itn: *intern.Interner, items: *intern.StrId, count: u32, present: bool, target: intern.StrId) bool {
    if (!present) { ret true; }
    if (count == 0) { ret false; }
    val star: intern.StrId = intern_unwrap(itn, "*");
    var i: u32 = 0;
    for (i < count) {
        if (items[i] == star) { ret true; }
        i = i + 1;
    }
    i = 0;
    for (i < count) {
        if (items[i] == target) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a link's `os`, `isa` and `abi` filters all admit a target. an absent
# axis admits everything, an empty one nothing, "*" everything
# ---
# itn: interns "*"
# l: the link
# t: the target
# ret: true when all three axes admit `t`
pub fun link_matches_target(itn: *intern.Interner, l: *LinkDef, t: *TargetDef) bool {
    if (!filter_matches(itn, l.os, l.os_count, l.os_present, t.os)) { ret false; }
    if (!filter_matches(itn, l.isa, l.isa_count, l.isa_present, t.isa)) { ret false; }
    if (!filter_matches(itn, l.abi, l.abi_count, l.abi_present, t.abi)) { ret false; }
    ret true;
}

fun join_path_canonical(alloc: *A.Allocator, a: str, b: str) str {
    if (str_empty(a)) { ret seg_dup(alloc, b, 0, str_len(b)); }
    if (str_empty(b)) { ret seg_dup(alloc, a, 0, str_len(a)); }
    val al: usize = str_len(a);
    var end_a: usize = al;
    if (a[al - 1] == '/') { end_a = al - 1; }
    var start_b: usize = 0;
    if (b[0] == '/') { start_b = 1; }

    val a_sub: str = seg_dup(alloc, a, 0, end_a);
    val b_sub: str = seg_dup(alloc, b, start_b, str_len(b));
    val joined: str = sfmt(alloc, "{}/{}", a_sub, b_sub);
    str_free(alloc, a_sub);
    str_free(alloc, b_sub);
    ret joined;
}

# resolve a link entry for one target into a `LinkRequirement`. a local `path`
# is expanded with `expand_project_path` and interned; the symbols are copied
# into an owned array
# ---
# alloc: owns the symbol copy
# itn: interns the expanded path
# l: the link
# proj_out: the expanded `[project].out`
# v: the template values
# ret: the requirement; on error nothing is left allocated
pub fun link_requirement(alloc: *A.Allocator, itn: *intern.Interner, l: *LinkDef,
                         proj_out: str, v: *TmplVars) R.Result[LinkRequirement, str] {
    var req: LinkRequirement;
    req.source  = l.source;
    req.library = l.library;
    req.include_referenced = l.include_referenced;
    req.symbols      = nil;
    req.symbol_count = 0;
    if (l.symbol_count > 0) {
        val cr: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](alloc, l.symbol_count::usize);
        if (R.is_err[*intern.StrId, str](cr)) { ret R.err[LinkRequirement, str](R.unwrap_err[*intern.StrId, str](cr)); }
        req.symbols = R.unwrap_ok[*intern.StrId, str](cr);
        var si: u32 = 0;
        for (si < l.symbol_count) { req.symbols[si] = l.symbols[si]; si = si + 1; }
        req.symbol_count = l.symbol_count;
    }
    if (l.source == LINK_LOCAL) {
        val raw_path: str = idstr(itn, l.path);
        val expanded_r: R.Result[str, str] = expand_project_path(alloc, raw_path, proj_out, v, "a local link path");
        if (R.is_err[str, str](expanded_r)) {
            free_strarr(alloc, req.symbols, req.symbol_count);
            ret R.err[LinkRequirement, str](R.unwrap_err[str, str](expanded_r));
        }
        val expanded: str = R.unwrap_ok[str, str](expanded_r);
        val res_int: R.Result[intern.StrId, str] = intern.intern(itn, expanded);
        str_free(alloc, expanded);
        if (R.is_err[intern.StrId, str](res_int)) {
            free_strarr(alloc, req.symbols, req.symbol_count);
            ret R.err[LinkRequirement, str](R.unwrap_err[intern.StrId, str](res_int));
        }
        req.text = R.unwrap_ok[intern.StrId, str](res_int);
        ret R.ok[LinkRequirement, str](req);
    }
    req.text = l.lib_name;
    ret R.ok[LinkRequirement, str](req);
}

# find the build step whose expanded `out` list contains a path
# ---
# alloc: owns temporary expansions
# itn: resolves step strings
# m: the manifest
# expanded_path: the path to match, already expanded
# proj_out: the expanded `[project].out`
# v: the template values
# ret: the index into `m.steps` of the first producing step, or -1. a step
#  output that fails to expand is skipped
fun step_producing_out(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
                           expanded_path: str, proj_out: str, v: *TmplVars) i64 {
    var si: u32 = 0;
    for (si < m.step_count) {
        val s: *StepDef = ?m.steps[si];
        var oi: u32 = 0;
        for (oi < s.out_count) {
            val raw_out: str = idstr(itn, s.out[oi]);
            val exp_r: R.Result[str, str] = expand_project_path(alloc, raw_out, proj_out, v, "a build step output");
            if (R.is_ok[str, str](exp_r)) {
                val exp: str = R.unwrap_ok[str, str](exp_r);
                val eq: bool = str_equals(exp, expanded_path);
                str_free(alloc, exp);
                if (eq) { ret si::i64; }
            }
            oi = oi + 1;
        }
        si = si + 1;
    }
    ret -1;
}

# whether some build step produces a path; `step_producing_out` as a bool
# ---
# alloc: owns temporary expansions
# itn: resolves step strings
# m: the manifest
# expanded_path: the path to match, already expanded
# proj_out: the expanded `[project].out`
# v: the template values
# ret: true when a step lists the path in `out`
pub fun local_path_demanded_by_step(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
                                    expanded_path: str, proj_out: str, v: *TmplVars) bool {
    ret step_producing_out(alloc, itn, m, expanded_path, proj_out, v) >= 0;
}

# look an artifact up by name
# ---
# itn: interns the name
# m: the manifest
# name: the artifact name
# ret: the artifact, or nil
pub fun find_artifact(itn: *intern.Interner, m: *Manifest, name: str) *ArtifactDef {
    val res_id: R.Result[intern.StrId, str] = intern.intern(itn, name);
    if (R.is_err[intern.StrId, str](res_id)) { ret nil; }
    ret find_artifact_by_name(m, R.unwrap_ok[intern.StrId, str](res_id));
}

fun find_artifact_by_name(m: *Manifest, name: intern.StrId) *ArtifactDef {
    var i: u32 = 0;
    for (i < m.artifact_count) {
        if (m.artifacts[i].name == name) { ret ?m.artifacts[i]; }
        i = i + 1;
    }
    ret nil;
}

fun find_link_by_name(m: *Manifest, name: intern.StrId) *LinkDef {
    var i: u32 = 0;
    for (i < m.link_count) {
        if (m.links[i].name == name) { ret ?m.links[i]; }
        i = i + 1;
    }
    ret nil;
}

fun find_step_index(m: *Manifest, name: intern.StrId) i64 {
    var i: u32 = 0;
    for (i < m.step_count) {
        if (m.steps[i].name == name) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

fun find_artifact_index(m: *Manifest, name: intern.StrId) i64 {
    var i: u32 = 0;
    for (i < m.artifact_count) {
        if (m.artifacts[i].name == name) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

fun is_glob(s: str) bool {
    ret str_contains_char(s, '*');
}

fun glob_matches(pat: str, name: str) bool {
    val pn: usize = str_len(pat);
    val nn: usize = str_len(name);
    var pi:   usize = 0;
    var ni:   usize = 0;
    var star: usize = pn;
    var mark: usize = 0;
    for (ni < nn) {
        if (pi < pn && pat[pi] == '*') {
            star = pi;
            mark = ni;
            pi   = pi + 1;
            cnt;
        }
        if (pi < pn && pat[pi] == name[ni]) {
            pi = pi + 1;
            ni = ni + 1;
            cnt;
        }
        if (star < pn) {
            mark = mark + 1;
            ni   = mark;
            pi   = star + 1;
            cnt;
        }
        ret false;
    }
    for (pi < pn && pat[pi] == '*') { pi = pi + 1; }
    ret pi == pn;
}

fun need_pattern_valid(s: str) bool {
    if (str_empty(s)) { ret false; }
    val n: usize = str_len(s);
    var i: usize = 0;
    for (i < n) {
        val c: u8 = s[i];
        if (!((c >= 'A' && c <= 'Z')
           || (c >= 'a' && c <= 'z')
           || (c >= '0' && c <= '9')
           || c == '_' || c == '-' || c == '*')) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun need_selects(itn: *intern.Interner, a: *ArtifactDef, name: intern.StrId) bool {
    var i: u32 = 0;
    for (i < a.need_count) {
        if (a.need[i] == name) { ret true; }
        val pat: str = idstr(itn, a.need[i]);
        if (is_glob(pat) && glob_matches(pat, idstr(itn, name))) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `a`'s `need` list selects `other`, by exact name or a '*' glob
# ---
# itn: resolves the names
# a: the consumer
# other: the candidate requirement
# ret: true when selected; always false when `a` and `other` are the same artifact
pub fun artifact_needs_artifact(itn: *intern.Interner, a: *ArtifactDef, other: *ArtifactDef) bool {
    if (a == other) { ret false; }
    ret need_selects(itn, a, other.name);
}

# whether a required artifact is built for a target when its consumer builds for
# `consumer_target`: only that target when `req` supports it, otherwise every
# target `req` supports
# ---
# itn: interns "*"
# req: the required artifact
# consumer_target: the consumer's target name
# t: the target asked about
# ret: true when `req` is built for `t` on behalf of that consumer
pub fun required_artifact_uses_target(itn: *intern.Interner, req: *ArtifactDef,
                                      consumer_target: intern.StrId, t: *TargetDef) bool {
    if (artifact_supports_target(itn, req, consumer_target)) { ret t.name == consumer_target; }
    ret artifact_supports_target(itn, req, t.name);
}

# how many declared targets `required_artifact_uses_target` admits for a requirement
# ---
# itn: interns "*"
# m: the manifest
# req: the required artifact
# consumer_target: the consumer's target name
# ret: the count; 1 means `{artifact.<id>.out}` has a single answer
fun required_artifact_target_count(itn: *intern.Interner, m: *Manifest, req: *ArtifactDef,
                                       consumer_target: intern.StrId) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < m.target_count) {
        if (required_artifact_uses_target(itn, req, consumer_target, ?m.targets[i])) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun artifact_out_for_target(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
                            a: *ArtifactDef, t: *TargetDef, profile: str) R.Result[str, str] {
    var v: TmplVars = tmpl_vars_of(itn, t, profile);

    val out_tmpl_r: R.Result[str, str] = must_lookup(itn, m.out_tmpl);
    if (R.is_err[str, str](out_tmpl_r)) { ret out_tmpl_r; }
    val proj_out_r: R.Result[str, str] = expand_project_path(alloc, R.unwrap_ok[str, str](out_tmpl_r), "", ?v, "[project].out");
    if (R.is_err[str, str](proj_out_r)) { ret proj_out_r; }
    val proj_out: str = R.unwrap_ok[str, str](proj_out_r);

    val art_tmpl_r: R.Result[str, str] = must_lookup(itn, a.out);
    if (R.is_err[str, str](art_tmpl_r)) { str_free(alloc, proj_out); ret art_tmpl_r; }
    val art_out_r: R.Result[str, str] = expand_project_path(alloc, R.unwrap_ok[str, str](art_tmpl_r), proj_out, ?v, "an artifact output");
    if (R.is_err[str, str](art_out_r)) { str_free(alloc, proj_out); ret art_out_r; }
    val art_out: str = R.unwrap_ok[str, str](art_out_r);

    val joined: str = join_path_canonical(alloc, proj_out, art_out);
    str_free(alloc, art_out);
    str_free(alloc, proj_out);
    ret R.ok[str, str](joined);
}

# whether any artifact's `need` selects `ra`
# ---
# itn: resolves the names
# m: the manifest
# ra: the candidate requirement
# ret: true when some other artifact needs it
pub fun artifact_required_by_any(itn: *intern.Interner, m: *Manifest, ra: *ArtifactDef) bool {
    var i: u32 = 0;
    for (i < m.artifact_count) {
        if (artifact_needs_artifact(itn, ?m.artifacts[i], ra)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun req_selected(itn: *intern.Interner, m: *Manifest, consumer: *ArtifactDef,
                 ra: *ArtifactDef, whole_project: bool) bool {
    if (whole_project) { ret artifact_required_by_any(itn, m, ra); }
    if (consumer == nil) { ret false; }
    ret artifact_needs_artifact(itn, consumer, ra);
}

# list the artifacts a consumer requires, each with its output path when that
# path is unique, for `{artifact.<id>.out}` expansion
# ---
# alloc: owns the returned array and each non-empty `out` string
# itn: resolves names
# m: the manifest
# consumer: the requiring artifact; nil with `whole_project` false yields nothing
# consumer_target: the consumer's target
# profile: the profile name the outputs expand with
# whole_project: select every artifact some artifact needs instead of `consumer`'s
# out_items: receives the array, or nil when nothing is required
# out_count: receives its length
# ret: ok; err from the output path expansion, with the array freed
pub fun resolve_artifact_reqs(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
                              consumer: *ArtifactDef, consumer_target: *TargetDef, profile: str,
                              whole_project: bool,
                              out_items: **ArtifactReq, out_count: *u32) R.Result[R.Void, str] {
    @out_items = nil;
    @out_count = 0;
    if (m.artifact_count == 0) { ret R.ok_void[str](); }
    if (consumer == nil && !whole_project) { ret R.ok_void[str](); }

    var n: u32 = 0;
    var j: u32 = 0;
    for (j < m.artifact_count) {
        if (req_selected(itn, m, consumer, ?m.artifacts[j], whole_project)) { n = n + 1; }
        j = j + 1;
    }
    if (n == 0) { ret R.ok_void[str](); }

    val ir: R.Result[*ArtifactReq, str] = A.allocate[ArtifactReq](alloc, n::usize);
    if (R.is_err[*ArtifactReq, str](ir)) { ret R.err[R.Void, str](R.unwrap_err[*ArtifactReq, str](ir)); }
    val items: *ArtifactReq = R.unwrap_ok[*ArtifactReq, str](ir);

    var w: u32 = 0;
    j = 0;
    for (j < m.artifact_count) {
        val ra: *ArtifactDef = ?m.artifacts[j];
        if (req_selected(itn, m, consumer, ra, whole_project)) {
            var item: ArtifactReq;
            item.name = idstr(itn, ra.name);
            item.out  = "";
            if (required_artifact_target_count(itn, m, ra, consumer_target.name) == 1) {
                var ti: u32 = 0;
                for (ti < m.target_count) {
                    if (required_artifact_uses_target(itn, ra, consumer_target.name, ?m.targets[ti])) {
                        val pr: R.Result[str, str] = artifact_out_for_target(alloc, itn, m, ra, ?m.targets[ti], profile);
                        if (R.is_err[str, str](pr)) {
                            A.deallocate[ArtifactReq](alloc, items, n::usize);
                            ret R.err[R.Void, str](R.unwrap_err[str, str](pr));
                        }
                        item.out = R.unwrap_ok[str, str](pr);
                        brk;
                    }
                    ti = ti + 1;
                }
            }
            items[w] = item;
            w = w + 1;
        }
        j = j + 1;
    }
    @out_items = items;
    @out_count = w;
    ret R.ok_void[str]();
}

fun need_glob_match_count(itn: *intern.Interner, m: *Manifest, a: *ArtifactDef, pat: str) u32 {
    var hits: u32 = 0;
    var i: u32 = 0;
    for (i < m.step_count) {
        if (glob_matches(pat, idstr(itn, m.steps[i].name))) { hits = hits + 1; }
        i = i + 1;
    }
    i = 0;
    for (i < m.artifact_count) {
        if (?m.artifacts[i] != a && glob_matches(pat, idstr(itn, m.artifacts[i].name))) { hits = hits + 1; }
        i = i + 1;
    }
    ret hits;
}

fun need_cycle_chain(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
                     stack: *u32, depth: u32, from: u32, target: u32) str {
    var s: str = "";
    var i: u32 = from;
    for (i < depth) {
        if (str_empty(s)) { s = sfmt(alloc, "{}", idstr(itn, m.artifacts[stack[i]].name)); }
        or { s = sfmt(alloc, "{} -> {}", s, idstr(itn, m.artifacts[stack[i]].name)); }
        i = i + 1;
    }
    ret sfmt(alloc, "{} -> {}", s, idstr(itn, m.artifacts[target].name));
}

fun need_cycle_visit(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, idx: u32,
                     state: *u8, stack: *u32, depth: u32) R.Result[R.Void, str] {
    if (state[idx] == 2) { ret R.ok_void[str](); }
    state[idx] = 1;
    stack[depth] = idx;

    val a: *ArtifactDef = ?m.artifacts[idx];
    var j: u32 = 0;
    for (j < m.artifact_count) {
        if (j != idx && need_selects(itn, a, m.artifacts[j].name)) {
            if (state[j] == 1) {
                var from: u32 = 0;
                for (from <= depth) {
                    if (stack[from] == j) { brk; }
                    from = from + 1;
                }
                if (from > depth) { from = 0; }
                ret R.err[R.Void, str](sfmt(alloc, "mach.toml: artifact 'need' cycle: {}",
                    need_cycle_chain(alloc, itn, m, stack, depth + 1, from, j)));
            }
            val vr: R.Result[R.Void, str] = need_cycle_visit(alloc, itn, m, j, state, stack, depth + 1);
            if (R.is_err[R.Void, str](vr)) { ret vr; }
        }
        j = j + 1;
    }
    state[idx] = 2;
    ret R.ok_void[str]();
}

# check every artifact `need` entry and the artifact requirement graph; run by
# `parse`. an entry must be an identifier or '*' glob, a glob must match at least
# one step or other artifact, a name must be exactly one of a step or an artifact,
# must exist, and must not be the artifact itself
# ---
# alloc: owns error text
# itn: resolves names
# m: the manifest
# ret: ok; err naming the artifact and entry, or "mach.toml: artifact 'need'
#  cycle: a -> b -> a" for a cycle among artifacts
fun validate_needs(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) R.Result[R.Void, str] {
    var ai: u32 = 0;
    for (ai < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[ai];
        val aname: str = idstr(itn, a.name);
        var ni: u32 = 0;
        for (ni < a.need_count) {
            val entry: str = idstr(itn, a.need[ni]);
            if (!need_pattern_valid(entry)) {
                ret R.err[R.Void, str](sfmt(alloc,
                    "mach.toml: [artifact.{}].need entry '{}' must name a build step or artifact, optionally with '*' wildcards",
                    aname, entry));
            }
            if (is_glob(entry)) {
                if (need_glob_match_count(itn, m, a, entry) == 0) {
                    ret R.err[R.Void, str](sfmt(alloc,
                        "mach.toml: [artifact.{}].need pattern '{}' matches no build step or artifact",
                        aname, entry));
                }
                ni = ni + 1;
                cnt;
            }
            val step_idx: i64  = find_step_index(m, a.need[ni]);
            val art_idx:  i64  = find_artifact_index(m, a.need[ni]);
            if (step_idx >= 0 && art_idx >= 0) {
                ret R.err[R.Void, str](sfmt(alloc,
                    "mach.toml: [artifact.{}].need names '{}', which is both build step '[step.{}]' and artifact '[artifact.{}]'; rename one",
                    aname, entry, entry, entry));
            }
            if (step_idx < 0 && art_idx < 0) {
                ret R.err[R.Void, str](sfmt(alloc,
                    "mach.toml: [artifact.{}].need refers to unknown build step or artifact '{}'",
                    aname, entry));
            }
            if (art_idx == ai::i64) {
                ret R.err[R.Void, str](sfmt(alloc, "mach.toml: [artifact.{}].need requires itself", aname));
            }
            ni = ni + 1;
        }
        ai = ai + 1;
    }
    ret validate_need_cycles(alloc, itn, m);
}

fun validate_link_refs(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) R.Result[R.Void, str] {
    var ai: u32 = 0;
    for (ai < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[ai];
        var li: u32 = 0;
        for (li < a.link_count) {
            if (find_link_by_name(m, a.link[li]) == nil) {
                var known: str = "no [link.*] table is declared";
                if (m.link_count > 0) { known = sfmt(alloc, "declared: {}", link_table_names(alloc, itn, m)); }
                ret R.err[R.Void, str](sfmt(alloc, "mach.toml: [artifact.{}].link names no [link.*] table: '{}' ({})",
                    idstr(itn, a.name), idstr(itn, a.link[li]), known));
            }
            li = li + 1;
        }
        ai = ai + 1;
    }
    ret R.ok_void[str]();
}

fun link_table_names(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) str {
    var s: str = "";
    var i: u32 = 0;
    for (i < m.link_count) {
        if (i > 0) { s = sfmt(alloc, "{}, ", s); }
        s = sfmt(alloc, "{}[link.{}]", s, idstr(itn, m.links[i].name));
        i = i + 1;
    }
    ret s;
}

fun validate_need_cycles(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) R.Result[R.Void, str] {
    if (m.artifact_count == 0) { ret R.ok_void[str](); }

    val sr: R.Result[*u8, str] = A.allocate[u8](alloc, m.artifact_count::usize);
    if (R.is_err[*u8, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[*u8, str](sr)); }
    val state: *u8 = R.unwrap_ok[*u8, str](sr);
    val kr: R.Result[*u32, str] = A.allocate[u32](alloc, m.artifact_count::usize);
    if (R.is_err[*u32, str](kr)) {
        A.deallocate[u8](alloc, state, m.artifact_count::usize);
        ret R.err[R.Void, str](R.unwrap_err[*u32, str](kr));
    }
    val stack: *u32 = R.unwrap_ok[*u32, str](kr);

    var i: u32 = 0;
    for (i < m.artifact_count) { state[i] = 0; i = i + 1; }

    var result: R.Result[R.Void, str] = R.ok_void[str]();
    i = 0;
    for (i < m.artifact_count) {
        result = need_cycle_visit(alloc, itn, m, i, state, stack, 0);
        if (R.is_err[R.Void, str](result)) { brk; }
        i = i + 1;
    }
    A.deallocate[u8](alloc, state, m.artifact_count::usize);
    A.deallocate[u32](alloc, stack, m.artifact_count::usize);
    ret result;
}

fun plan_visit(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, idx: u32, state: *u8, order: *u32, order_len: *u32) R.Result[R.Void, str] {
    if (state[idx] == 2) { ret R.ok_void[str](); }
    if (state[idx] == 1) { ret R.err[R.Void, str](sfmt(alloc, "mach.toml: build step '{}' is part of a 'need' cycle", idstr(itn, m.steps[idx].name))); }
    state[idx] = 1;
    val s: *StepDef = ?m.steps[idx];
    var ni: u32 = 0;
    for (ni < s.need_count) {
        val nidx: i64 = find_step_index(m, s.need[ni]);
        if (nidx < 0) { ret R.err[R.Void, str](sfmt(alloc, "mach.toml: build step 'need' refers to unknown step '{}'", idstr(itn, s.need[ni]))); }
        val vr: R.Result[R.Void, str] = plan_visit(alloc, itn, m, nidx::u32, state, order, order_len);
        if (R.is_err[R.Void, str](vr)) { ret vr; }
        ni = ni + 1;
    }
    state[idx] = 2;
    order[@order_len] = idx;
    @order_len = @order_len + 1;
    ret R.ok_void[str]();
}

# order the build steps the named artifacts demand: a step producing a local
# link path that matches the target, every step a `need` names (globs match
# step names), and transitively each step's own `need`, dependencies first
# ---
# alloc: owns the returned order
# itn: resolves names
# m: the manifest
# art_names: the artifacts to plan for; unknown names are skipped
# art_count: length of `art_names`
# t: the target
# proj_out: the expanded `[project].out`
# v: the template values
# out_order: receives the step indices in run order, sized exactly; nil when none
# out_count: receives the length
# ret: ok; err on a step `need` cycle, a step `need` naming an unknown step, or
#  a local link path that fails to expand
pub fun plan_steps(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
                   art_names: *intern.StrId, art_count: u32, t: *TargetDef,
                   proj_out: str, v: *TmplVars,
                   out_order: **u32, out_count: *u32) R.Result[R.Void, str] {
    @out_order = nil;
    @out_count = 0;
    if (m.step_count == 0) { ret R.ok_void[str](); }

    val sr: R.Result[*u8, str] = A.allocate[u8](alloc, m.step_count::usize);
    if (R.is_err[*u8, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[*u8, str](sr)); }
    val state: *u8 = R.unwrap_ok[*u8, str](sr);
    var i: u32 = 0;
    for (i < m.step_count) { state[i] = 0; i = i + 1; }

    val or_: R.Result[*u32, str] = A.allocate[u32](alloc, m.step_count::usize);
    if (R.is_err[*u32, str](or_)) { A.deallocate[u8](alloc, state, m.step_count::usize); ret R.err[R.Void, str](R.unwrap_err[*u32, str](or_)); }
    val order: *u32 = R.unwrap_ok[*u32, str](or_);
    var order_len: u32 = 0;

    var ai: u32 = 0;
    for (ai < art_count) {
        val a: *ArtifactDef = find_artifact_by_name(m, art_names[ai]);
        if (a != nil) {
            var li: u32 = 0;
            for (li < a.link_count) {
                val l: *LinkDef = find_link_by_name(m, a.link[li]);
                if (l != nil && l.source == LINK_LOCAL && link_matches_target(itn, l, t)) {
                    val exp_r: R.Result[str, str] = expand_project_path(alloc, idstr(itn, l.path), proj_out, v, "a local link path");
                    if (R.is_err[str, str](exp_r)) { plan_free(alloc, state, order, m.step_count); ret R.err[R.Void, str](R.unwrap_err[str, str](exp_r)); }
                    val exp: str = R.unwrap_ok[str, str](exp_r);
                    val sidx: i64 = step_producing_out(alloc, itn, m, exp, proj_out, v);
                    str_free(alloc, exp);
                    if (sidx >= 0) {
                        val vr: R.Result[R.Void, str] = plan_visit(alloc, itn, m, sidx::u32, state, order, ?order_len);
                        if (R.is_err[R.Void, str](vr)) { plan_free(alloc, state, order, m.step_count); ret vr; }
                    }
                }
                li = li + 1;
            }
            var ni: u32 = 0;
            for (ni < a.need_count) {
                val pat: str = idstr(itn, a.need[ni]);
                if (is_glob(pat)) {
                    var si: u32 = 0;
                    for (si < m.step_count) {
                        if (glob_matches(pat, idstr(itn, m.steps[si].name))) {
                            val gr: R.Result[R.Void, str] = plan_visit(alloc, itn, m, si, state, order, ?order_len);
                            if (R.is_err[R.Void, str](gr)) { plan_free(alloc, state, order, m.step_count); ret gr; }
                        }
                        si = si + 1;
                    }
                }
                or {
                    val nidx: i64 = find_step_index(m, a.need[ni]);
                    if (nidx >= 0) {
                        val vr: R.Result[R.Void, str] = plan_visit(alloc, itn, m, nidx::u32, state, order, ?order_len);
                        if (R.is_err[R.Void, str](vr)) { plan_free(alloc, state, order, m.step_count); ret vr; }
                    }
                }
                ni = ni + 1;
            }
        }
        ai = ai + 1;
    }

    ret plan_finish(alloc, state, order, m.step_count, order_len, out_order, out_count);
}

fun plan_free(alloc: *A.Allocator, state: *u8, order: *u32, n: u32) {
    A.deallocate[u8](alloc, state, n::usize);
    A.deallocate[u32](alloc, order, n::usize);
}

fun plan_finish(alloc: *A.Allocator, state: *u8, order: *u32, capacity: u32,
                order_len: u32, out_order: **u32, out_count: *u32) R.Result[R.Void, str] {
    A.deallocate[u8](alloc, state, capacity::usize);
    if (order_len == 0) {
        A.deallocate[u32](alloc, order, capacity::usize);
        ret R.ok_void[str]();
    }
    if (order_len == capacity) {
        @out_order = order;
        @out_count = order_len;
        ret R.ok_void[str]();
    }
    val compact_r: R.Result[*u32, str] = A.allocate[u32](alloc, order_len::usize);
    if (R.is_err[*u32, str](compact_r)) {
        A.deallocate[u32](alloc, order, capacity::usize);
        ret R.err[R.Void, str](R.unwrap_err[*u32, str](compact_r));
    }
    val compact: *u32 = R.unwrap_ok[*u32, str](compact_r);
    var i: u32 = 0;
    for (i < order_len) { compact[i] = order[i]; i = i + 1; }
    A.deallocate[u32](alloc, order, capacity::usize);
    @out_order = compact;
    @out_count = order_len;
    ret R.ok_void[str]();
}

# order the build steps that produce an exported local link path matching the
# target, with their transitive step `need`s; the steps a consumer of this
# manifest must run
# ---
# alloc: owns the returned order
# itn: resolves names
# m: the manifest
# t: the target
# proj_out: the expanded `[project].out`
# v: the template values
# out_order: receives the step indices in run order, sized exactly; nil when none
# out_count: receives the length
# ret: ok; the `plan_steps` errors
pub fun plan_export_steps(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
                          t: *TargetDef, proj_out: str, v: *TmplVars,
                          out_order: **u32, out_count: *u32) R.Result[R.Void, str] {
    @out_order = nil;
    @out_count = 0;
    if (m.step_count == 0) { ret R.ok_void[str](); }

    val sr: R.Result[*u8, str] = A.allocate[u8](alloc, m.step_count::usize);
    if (R.is_err[*u8, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[*u8, str](sr)); }
    val state: *u8 = R.unwrap_ok[*u8, str](sr);
    var i: u32 = 0;
    for (i < m.step_count) { state[i] = 0; i = i + 1; }

    val or_: R.Result[*u32, str] = A.allocate[u32](alloc, m.step_count::usize);
    if (R.is_err[*u32, str](or_)) { A.deallocate[u8](alloc, state, m.step_count::usize); ret R.err[R.Void, str](R.unwrap_err[*u32, str](or_)); }
    val order: *u32 = R.unwrap_ok[*u32, str](or_);
    var order_len: u32 = 0;

    var li: u32 = 0;
    for (li < m.link_count) {
        val l: *LinkDef = ?m.links[li];
        if (l.export && l.source == LINK_LOCAL && link_matches_target(itn, l, t)) {
            val exp_r: R.Result[str, str] = expand_project_path(alloc, idstr(itn, l.path), proj_out, v, "a local link path");
            if (R.is_err[str, str](exp_r)) { plan_free(alloc, state, order, m.step_count); ret R.err[R.Void, str](R.unwrap_err[str, str](exp_r)); }
            val exp: str = R.unwrap_ok[str, str](exp_r);
            val sidx: i64 = step_producing_out(alloc, itn, m, exp, proj_out, v);
            str_free(alloc, exp);
            if (sidx >= 0) {
                val vr: R.Result[R.Void, str] = plan_visit(alloc, itn, m, sidx::u32, state, order, ?order_len);
                if (R.is_err[R.Void, str](vr)) { plan_free(alloc, state, order, m.step_count); ret vr; }
            }
        }
        li = li + 1;
    }

    ret plan_finish(alloc, state, order, m.step_count, order_len, out_order, out_count);
}

# whether an artifact's `targets` lists a target name or "*"
# ---
# itn: interns "*"
# a: the artifact
# tname: the target name
# ret: true when listed
pub fun artifact_supports_target(itn: *intern.Interner, a: *ArtifactDef, tname: intern.StrId) bool {
    val star: intern.StrId = intern_unwrap(itn, "*");
    var i: u32 = 0;
    for (i < a.target_count) {
        if (a.targets[i] == star || a.targets[i] == tname) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the selection's artifact builds for the selection's target. the target
# is resolved as `native` would be, never pinned by the artifact
# ---
# alloc: owns error text
# itn: resolves names
# m: the manifest
# sel: the selection
# ret: the support bit; err from target resolution, or when `resolve_artifact`
#  finds nothing
pub fun cell_supported(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, sel: Selection) R.Result[bool, str] {
    val res_target: R.Result[ResolvedTarget, str] = resolve_target(alloc, itn, m, sel.target, nil);
    if (R.is_err[ResolvedTarget, str](res_target)) { ret R.err[bool, str](R.unwrap_err[ResolvedTarget, str](res_target)); }
    val rt: ResolvedTarget = R.unwrap_ok[ResolvedTarget, str](res_target);

    val a: *ArtifactDef = resolve_artifact(itn, m, sel);
    if (a == nil) { ret R.err[bool, str](artifact_err(alloc, itn, m, sel)); }

    ret R.ok[bool, str](artifact_supports_target(itn, a, rt.target.name));
}

fun set_selected_artifact(itn: *intern.Interner, a: *ArtifactDef,
                          sel: *Selection) R.Result[R.Void, str] {
    val name_opt: O.Option[str] = intern.lookup(itn, a.name);
    if (O.is_none[str](name_opt)) {
        ret R.err[R.Void, str]("selected artifact name not interned");
    }
    sel.artifact     = O.unwrap[str](name_opt);
    sel.want_lib     = a.is_lib;
    sel.has_artifact = true;
    ret R.ok_void[str]();
}

rec ArtifactCandidates {
    count:         u32;
    sole:          *ArtifactDef;
    first:         *ArtifactDef;
    default_count: u32;
    chosen:        *ArtifactDef;
}

fun artifact_candidates_for(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
                            sel: *Selection, executables_only: bool) ArtifactCandidates {
    var c: ArtifactCandidates;
    c.count = 0; c.sole = nil; c.first = nil; c.default_count = 0; c.chosen = nil;
    val tr: R.Result[ResolvedTarget, str] = resolve_target(alloc, itn, m, sel.target, nil);
    if (R.is_err[ResolvedTarget, str](tr)) { ret c; }
    val rt: ResolvedTarget = R.unwrap_ok[ResolvedTarget, str](tr);

    var i: u32 = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        if ((!executables_only || !a.is_lib) && artifact_supports_target(itn, a, rt.target.name)) {
            c.sole  = a;
            if (c.first == nil) { c.first = a; }
            c.count = c.count + 1;
            if (a.is_default) { c.chosen = a; c.default_count = c.default_count + 1; }
        }
        i = i + 1;
    }
    if (c.count != 1) { c.sole = nil; }
    if (c.default_count != 1) { c.chosen = nil; }
    ret c;
}

# fill in `sel.artifact` when none was named and several artifacts are declared:
# the sole artifact supporting the selected target, else the one marked
# `default = true`, else the first declared candidate with `sel.legacy_default` set
# ---
# alloc: owns error text
# itn: resolves names
# m: the manifest
# sel: updated in place; untouched when it already names an artifact or fewer
#  than two are declared
# ret: ok; err when no artifact supports the target or more than one candidate
#  is marked default
pub fun select_primary_artifact(alloc: *A.Allocator, itn: *intern.Interner,
                                m: *Manifest, sel: *Selection) R.Result[R.Void, str] {
    if (sel.has_artifact || m.artifact_count < 2) { ret R.ok_void[str](); }

    val c: ArtifactCandidates = artifact_candidates_for(alloc, itn, m, sel, false);
    if (c.sole != nil)   { ret set_selected_artifact(itn, c.sole, sel); }
    if (c.chosen != nil) { ret set_selected_artifact(itn, c.chosen, sel); }
    if (c.count == 0) {
        ret R.err[R.Void, str](sfmt(alloc, "mach.toml: no artifact supports the selected target ({})", artifact_candidates(alloc, itn, m)));
    }
    if (c.default_count > 1) {
        ret R.err[R.Void, str]("mach.toml: multiple artifacts supporting the selected target have 'default = true'; exactly one is allowed");
    }
    sel.legacy_default = true;
    ret set_selected_artifact(itn, c.first, sel);
}

# `select_primary_artifact` without the fallback: fill in `sel.artifact` only
# when the target leaves one candidate or one marked `default = true`, and stay
# silent otherwise
# ---
# alloc: owns error text
# itn: resolves names
# m: the manifest
# sel: updated in place when a choice is clear
# ret: ok unless the artifact name cannot be looked up
pub fun select_sole_target_artifact(alloc: *A.Allocator, itn: *intern.Interner,
                                    m: *Manifest, sel: *Selection) R.Result[R.Void, str] {
    if (sel.has_artifact || m.artifact_count < 2) { ret R.ok_void[str](); }

    val c: ArtifactCandidates = artifact_candidates_for(alloc, itn, m, sel, false);
    if (c.sole != nil)   { ret set_selected_artifact(itn, c.sole, sel); }
    if (c.chosen != nil) { ret set_selected_artifact(itn, c.chosen, sel); }
    ret R.ok_void[str]();
}

# `select_sole_target_artifact` over `bin` artifacts only, so a bin beside a
# library is chosen for `run` and `test`
# ---
# alloc: owns error text
# itn: resolves names
# m: the manifest
# sel: updated in place when a choice is clear
# ret: ok unless the artifact name cannot be looked up
pub fun select_sole_executable_artifact(alloc: *A.Allocator, itn: *intern.Interner,
                                        m: *Manifest, sel: *Selection) R.Result[R.Void, str] {
    if (sel.has_artifact || m.artifact_count < 2) { ret R.ok_void[str](); }

    val c: ArtifactCandidates = artifact_candidates_for(alloc, itn, m, sel, true);
    if (c.sole != nil)   { ret set_selected_artifact(itn, c.sole, sel); }
    if (c.chosen != nil) { ret set_selected_artifact(itn, c.chosen, sel); }
    ret R.ok_void[str]();
}

# resolve a selection into one `BuildUnit`. with no target named, an artifact
# that supports exactly one declared target, or exactly one host-matching
# target, pins it; otherwise `native` resolution applies. the profile comes
# from `resolve_profile`, the artifact from `resolve_artifact`, and every path
# is expanded with `expand_project_path`
# ---
# alloc: owns `libs` and temporary strings
# itn: interns the expanded paths
# m: the manifest
# sel: the selection
# ret: the unit; err from target, profile or artifact resolution, when the
#  artifact does not support the target (naming the artifact's targets when
#  none was selected), or from path expansion
pub fun resolve_build_unit(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, sel: Selection) R.Result[BuildUnit, str] {
    var pin: *ArtifactDef = nil;
    if (str_empty(sel.target)) { pin = resolve_artifact(itn, m, sel); }

    val res_target: R.Result[ResolvedTarget, str] = resolve_target(alloc, itn, m, sel.target, pin);
    if (R.is_err[ResolvedTarget, str](res_target)) { ret R.err[BuildUnit, str](R.unwrap_err[ResolvedTarget, str](res_target)); }
    val rt: ResolvedTarget = R.unwrap_ok[ResolvedTarget, str](res_target);

    val res_profile: R.Result[ResolvedProfile, str] = resolve_profile(alloc, itn, m, sel.profile);
    if (R.is_err[ResolvedProfile, str](res_profile)) { ret R.err[BuildUnit, str](R.unwrap_err[ResolvedProfile, str](res_profile)); }
    val rp: ResolvedProfile = R.unwrap_ok[ResolvedProfile, str](res_profile);

    val a: *ArtifactDef = resolve_artifact(itn, m, sel);
    if (a == nil) { ret R.err[BuildUnit, str](artifact_err(alloc, itn, m, sel)); }

    if (!artifact_supports_target(itn, a, rt.target.name)) {
        val art_name: str = idstr(itn, a.name);
        val tgt_name: str = idstr(itn, rt.target.name);
        if (str_empty(sel.target)) {
            ret R.err[BuildUnit, str](sfmt(alloc,
                "mach.toml: artifact '{}' declares no target for this host; select one with --target ({})",
                art_name, artifact_target_names(alloc, itn, m, a)));
        }
        ret R.err[BuildUnit, str](sfmt(alloc, "mach.toml: artifact '{}' does not support target '{}'", art_name, tgt_name));
    }

    var u: BuildUnit;
    u.target       = rt.target;
    u.artifact     = a;
    u.target_name  = rt.target.name;
    u.profile_name = rp.name;
    u.opt          = rp.opt;
    u.debug        = rp.debug;
    u.simd          = rp.simd;
    u.vectorize     = rp.vectorize;
    u.float_reassoc = rp.float_reassoc;
    u.is_lib       = a.is_lib;
    u.kind         = LIBKIND_STATIC;
    val kind_str: str = idstr(itn, a.kind);
    if (str_equals(kind_str, "shared")) {
        u.kind = LIBKIND_SHARED;
    }
    u.warned       = rt.warned;
    u.legacy_target_default  = rt.legacy_default;
    u.legacy_profile_default = rp.legacy_default;
    u.entry        = a.entry;

    val res_profile_name: R.Result[str, str] = must_lookup(itn, rp.name);
    if (R.is_err[str, str](res_profile_name)) { ret R.err[BuildUnit, str](R.unwrap_err[str, str](res_profile_name)); }
    val pn: str = R.unwrap_ok[str, str](res_profile_name);
    var v: TmplVars = tmpl_vars_of(itn, rt.target, pn);

    val res_project_out: R.Result[str, str] = expand_project_path(alloc, R.unwrap_ok[str, str](must_lookup(itn, m.out_tmpl)), "", ?v, "[project].out");
    if (R.is_err[str, str](res_project_out)) { ret R.err[BuildUnit, str](R.unwrap_err[str, str](res_project_out)); }
    val proj_out: str = R.unwrap_ok[str, str](res_project_out);

    var match_count: u32 = 0;
    var matched_items: *LinkRequirement = nil;
    if (a.link_count > 0) {
        val res_match_arr: R.Result[*LinkRequirement, str] = A.allocate[LinkRequirement](alloc, a.link_count::usize);
        if (R.is_err[*LinkRequirement, str](res_match_arr)) { str_free(alloc, proj_out); ret R.err[BuildUnit, str](R.unwrap_err[*LinkRequirement, str](res_match_arr)); }
        matched_items = R.unwrap_ok[*LinkRequirement, str](res_match_arr);

        var li: u32 = 0;
        for (li < a.link_count) {
            val link_name: intern.StrId = a.link[li];
            var found_l: *LinkDef = nil;
            var lidx: u32 = 0;
            for (lidx < m.link_count) {
                if (m.links[lidx].name == link_name) {
                    found_l = ?m.links[lidx];
                }
                lidx = lidx + 1;
            }
            if (found_l != nil) {
                if (link_matches_target(itn, found_l, rt.target)) {
                    val req_r: R.Result[LinkRequirement, str] = link_requirement(alloc, itn, found_l, proj_out, ?v);
                    if (R.is_err[LinkRequirement, str](req_r)) {
                        free_link_claims(alloc, matched_items, match_count);
                        A.deallocate[LinkRequirement](alloc, matched_items, a.link_count::usize);
                        str_free(alloc, proj_out); ret R.err[BuildUnit, str](R.unwrap_err[LinkRequirement, str](req_r));
                    }
                    matched_items[match_count] = R.unwrap_ok[LinkRequirement, str](req_r);
                    match_count = match_count + 1;
                }
            }
            li = li + 1;
        }

        var exact_items: *LinkRequirement = nil;
        var exact_count: u32 = 0;
        val fr: R.Result[R.Void, str] = finish_link_requirements(alloc, matched_items,
            a.link_count, match_count, ?exact_items, ?exact_count);
        if (R.is_err[R.Void, str](fr)) {
            str_free(alloc, proj_out); ret R.err[BuildUnit, str](R.unwrap_err[R.Void, str](fr));
        }
        matched_items = exact_items;
        match_count = exact_count;
    }
    u.libs      = matched_items;
    u.lib_count = match_count;

    val obj_str: str = sfmt(alloc, "{}/obj", proj_out);
    val ir_str:  str = sfmt(alloc, "{}/ir", proj_out);
    val asm_str: str = sfmt(alloc, "{}/asm", proj_out);
    val test_str: str = sfmt(alloc, "{}/test/{{name}}", proj_out);

    val res_obj:  R.Result[intern.StrId, str] = intern.intern(itn, obj_str);
    val res_ir:   R.Result[intern.StrId, str] = intern.intern(itn, ir_str);
    val res_asm:  R.Result[intern.StrId, str] = intern.intern(itn, asm_str);
    val res_test: R.Result[intern.StrId, str] = intern.intern(itn, test_str);
    str_free(alloc, obj_str);
    str_free(alloc, ir_str);
    str_free(alloc, asm_str);
    str_free(alloc, test_str);

    if (R.is_err[intern.StrId, str](res_obj)) { str_free(alloc, proj_out); ret R.err[BuildUnit, str](R.unwrap_err[intern.StrId, str](res_obj)); }
    u.obj_root = R.unwrap_ok[intern.StrId, str](res_obj);
    if (R.is_err[intern.StrId, str](res_ir)) { str_free(alloc, proj_out); ret R.err[BuildUnit, str](R.unwrap_err[intern.StrId, str](res_ir)); }
    u.ir_root = R.unwrap_ok[intern.StrId, str](res_ir);
    if (R.is_err[intern.StrId, str](res_asm)) { str_free(alloc, proj_out); ret R.err[BuildUnit, str](R.unwrap_err[intern.StrId, str](res_asm)); }
    u.asm_root = R.unwrap_ok[intern.StrId, str](res_asm);
    if (R.is_err[intern.StrId, str](res_test)) { str_free(alloc, proj_out); ret R.err[BuildUnit, str](R.unwrap_err[intern.StrId, str](res_test)); }
    u.test_root = R.unwrap_ok[intern.StrId, str](res_test);

    val art_out_tmpl: intern.StrId = a.out;
    val res_art_out: R.Result[str, str] = expand_project_path(alloc, R.unwrap_ok[str, str](must_lookup(itn, art_out_tmpl)), proj_out, ?v, "an artifact output");
    if (R.is_err[str, str](res_art_out)) { str_free(alloc, proj_out); ret R.err[BuildUnit, str](R.unwrap_err[str, str](res_art_out)); }
    val art_out_rel: str = R.unwrap_ok[str, str](res_art_out);

    val final_bin_path: str = join_path_canonical(alloc, proj_out, art_out_rel);
    val res_bin: R.Result[intern.StrId, str] = intern.intern(itn, final_bin_path);
    str_free(alloc, final_bin_path);
    str_free(alloc, art_out_rel);
    str_free(alloc, proj_out);
    if (R.is_err[intern.StrId, str](res_bin)) { ret R.err[BuildUnit, str](R.unwrap_err[intern.StrId, str](res_bin)); }
    u.bin_path = R.unwrap_ok[intern.StrId, str](res_bin);

    ret R.ok[BuildUnit, str](u);
}

fun requirement_index(buf: *LinkRequirement, count: u32, req: *LinkRequirement) i64 {
    var i: u32 = 0;
    for (i < count) {
        if (buf[i].source == req.source && buf[i].text == req.text
            && buf[i].library == req.library) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

# the union of every artifact's link requirements for a target, for the test
# binary. requirements equal in source, text and library merge with
# `merge_link_claims`
# ---
# alloc: owns the returned array
# itn: resolves names
# m: the manifest
# t: the target
# proj_out: the expanded `[project].out`
# v: the template values
# out_items: receives the exact array, or nil when no artifact links anything
# out_count: receives its length
# ret: ok; err from `link_requirement` or a merge, with everything freed
pub fun resolve_test_libs(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, t: *TargetDef,
                          proj_out: str, v: *TmplVars,
                          out_items: **LinkRequirement, out_count: *u32) R.Result[R.Void, str] {
    @out_items = nil;
    @out_count = 0;

    var max: u32 = 0;
    var ai: u32 = 0;
    for (ai < m.artifact_count) { max = max + m.artifacts[ai].link_count; ai = ai + 1; }
    if (max == 0) { ret R.ok_void[str](); }

    val br: R.Result[*LinkRequirement, str] = A.allocate[LinkRequirement](alloc, max::usize);
    if (R.is_err[*LinkRequirement, str](br)) { ret R.err[R.Void, str](R.unwrap_err[*LinkRequirement, str](br)); }
    val buf: *LinkRequirement = R.unwrap_ok[*LinkRequirement, str](br);
    var w: u32 = 0;

    ai = 0;
    for (ai < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[ai];
        var li: u32 = 0;
        for (li < a.link_count) {
            val link_name: intern.StrId = a.link[li];
            var found_l: *LinkDef = nil;
            var lidx: u32 = 0;
            for (lidx < m.link_count) {
                if (m.links[lidx].name == link_name) { found_l = ?m.links[lidx]; }
                lidx = lidx + 1;
            }
            if (found_l != nil) {
                if (link_matches_target(itn, found_l, t)) {
                    val req_r: R.Result[LinkRequirement, str] = link_requirement(alloc, itn, found_l, proj_out, v);
                    if (R.is_err[LinkRequirement, str](req_r)) {
                        free_link_claims(alloc, buf, w);
                        A.deallocate[LinkRequirement](alloc, buf, max::usize);
                        ret R.err[R.Void, str](R.unwrap_err[LinkRequirement, str](req_r));
                    }
                    var req: LinkRequirement = R.unwrap_ok[LinkRequirement, str](req_r);
                    val duplicate: i64 = requirement_index(buf, w, ?req);
                    if (duplicate < 0) { buf[w] = req; w = w + 1; }
                    or {
                        val mr: R.Result[R.Void, str] =
                            merge_link_claims(alloc, ?buf[duplicate::u32], ?req);
                        if (R.is_err[R.Void, str](mr)) {
                            free_link_claims(alloc, ?req, 1);
                            free_link_claims(alloc, buf, w);
                            A.deallocate[LinkRequirement](alloc, buf, max::usize);
                            ret mr;
                        }
                        free_link_claims(alloc, ?req, 1);
                    }
                }
            }
            li = li + 1;
        }
        ai = ai + 1;
    }

    ret finish_link_requirements(alloc, buf, max, w, out_items, out_count);
}

fun artifact_err(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, sel: Selection) str {
    if (m.artifact_count == 0) { ret "mach.toml: no [artifact.*] artifacts declared"; }
    if (sel.has_artifact) {
        if (sel.want_lib) { ret sfmt(alloc, "mach.toml: no lib named '{}'", sel.artifact); }
        ret sfmt(alloc, "mach.toml: no bin named '{}'", sel.artifact);
    }
    ret sfmt(alloc, "mach.toml: multiple artifacts declared; select one with --bin/--lib ({})",
        artifact_candidates(alloc, itn, m));
}

fun artifact_candidates(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) str {
    var s: str = "";
    var i: u32 = 0;
    for (i < m.artifact_count) {
        if (i > 0) { s = sfmt(alloc, "{}, ", s); }
        var label: str = "bin ";
        if (m.artifacts[i].is_lib) { label = "lib "; }
        var name: str = "?";
        val opt_name: O.Option[str] = intern.lookup(itn, m.artifacts[i].name);
        if (O.is_some[str](opt_name)) { name = O.unwrap[str](opt_name); }
        s = sfmt(alloc, "{}{}{}", s, label, name);
        i = i + 1;
    }
    ret s;
}

# reject two artifacts whose `out` expands to the same path under one set of
# template values
# ---
# alloc: owns temporary strings
# itn: resolves names
# m: the manifest; fewer than two artifacts always pass
# v: the template values
# ret: ok; err "mach.toml: artifacts 'a' and 'b' collide on output path '<p>'",
#  or an expansion error
pub fun check_collisions(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
                         v: *TmplVars) R.Result[R.Void, str] {
    if (m.artifact_count < 2) { ret R.ok_void[str](); }

    val res_paths: R.Result[*str, str] = A.allocate[str](alloc, m.artifact_count::usize);
    if (R.is_err[*str, str](res_paths)) { ret R.err[R.Void, str](R.unwrap_err[*str, str](res_paths)); }
    val paths: *str = R.unwrap_ok[*str, str](res_paths);

    val res_project_out: R.Result[str, str] = expand_project_path(alloc, R.unwrap_ok[str, str](must_lookup(itn, m.out_tmpl)), "", v, "[project].out");
    if (R.is_err[str, str](res_project_out)) { ret R.err[R.Void, str](R.unwrap_err[str, str](res_project_out)); }
    val proj_out: str = R.unwrap_ok[str, str](res_project_out);

    var i: u32 = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        val art_out_tmpl: intern.StrId = a.out;
        val res_art_out: R.Result[str, str] = expand_project_path(alloc, R.unwrap_ok[str, str](must_lookup(itn, art_out_tmpl)), proj_out, v, "an artifact output");
        if (R.is_err[str, str](res_art_out)) {
            free_path_strings(alloc, paths, i);
            A.deallocate[str](alloc, paths, m.artifact_count::usize);
            str_free(alloc, proj_out);
            ret R.err[R.Void, str](R.unwrap_err[str, str](res_art_out));
        }
        val art_out_rel: str = R.unwrap_ok[str, str](res_art_out);
        paths[i] = join_path_canonical(alloc, proj_out, art_out_rel);
        str_free(alloc, art_out_rel);
        i = i + 1;
    }

    var code: bool = true;
    var msg:  str  = "";
    i = 0;
    for (i < m.artifact_count && code) {
        var j: u32 = i + 1;
        for (j < m.artifact_count && code) {
            if (str_equals(paths[i], paths[j])) {
                val an0: O.Option[str] = intern.lookup(itn, m.artifacts[i].name);
                val an1: O.Option[str] = intern.lookup(itn, m.artifacts[j].name);
                if (O.is_some[str](an0) && O.is_some[str](an1)) {
                    msg = sfmt(alloc, "mach.toml: artifacts '{}' and '{}' collide on output path '{}'", O.unwrap[str](an0), O.unwrap[str](an1), paths[i]);
                }
                code = false;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    free_path_strings(alloc, paths, m.artifact_count);
    A.deallocate[str](alloc, paths, m.artifact_count::usize);
    str_free(alloc, proj_out);
    if (!code) { ret R.err[R.Void, str](msg); }
    ret R.ok_void[str]();
}

fun demo_src() str {
    ret "[project]\nid = \"demo\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[artifact.ls]\nkind = \"bin\"\nentry = \"bin/ls.mach\"\nout = \"bin/ls\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.cat]\nkind = \"bin\"\nentry = \"bin/cat.mach\"\nout = \"bin/cat\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\n\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\n\n[dep.std]\ngit = \"https://github.com/briar-systems/mach-std\"\nref = \"tag/v0.4.0\"\n";
}

fun host_target_stanza(alloc: *A.Allocator, name: str) str {
    ret sfmt(alloc, "[target.{}]\nisa = \"{}\"\nos = \"{}\"\nabi = \"sysv64\"\n", name, host_isa_name(), host_os_name());
}

fun requirement_has(itn: *intern.Interner, items: *LinkRequirement, count: u32, lit: str) bool {
    var i: u32 = 0;
    for (i < count) {
        if (str_equals(idstr(itn, items[i].text), lit)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun idstr(itn: *intern.Interner, id: intern.StrId) str {
    val opt: O.Option[str] = intern.lookup(itn, id);
    if (O.is_some[str](opt)) { ret O.unwrap[str](opt); }
    ret "?";
}

fun find_link(itn: *intern.Interner, m: *Manifest, name: str) *LinkDef {
    var i: u32 = 0;
    for (i < m.link_count) {
        if (str_equals(idstr(itn, m.links[i].name), name)) { ret ?m.links[i]; }
        i = i + 1;
    }
    ret nil;
}

# the source key a `mach dep add` writes
pub def DepSource: u8;

# a `git = "<url>"` dependency, with an optional `ref`
pub val DEP_SOURCE_GIT:  DepSource = 1;
# a `path = "<dir>"` dependency
pub val DEP_SOURCE_PATH: DepSource = 2;

# a `[dep.<name>]` table to append to a manifest's text
# ---
# name: the dependency name; must satisfy `is_valid_id`
# source: which key `value` is written under
# value: the git URL or the path; escaped as a TOML basic string
# ref: the `ref` value; written only for a git source and only when non-empty
pub rec DepTableSpec {
    name:   str;
    source: DepSource;
    value:  str;
    ref:    str;
}

val DEP_LOOKUP_ABSENT:    u8 = 0;
val DEP_LOOKUP_TABLE:     u8 = 1;
val DEP_LOOKUP_NON_TABLE: u8 = 2;

fun hex_digit(v: u8) u8 {
    if (v < 10) { ret '0'::u8 + v; }
    ret 'a'::u8 + (v - 10);
}

fun toml_escape_value(alloc: *A.Allocator, s: str) R.Result[str, str] {
    val n: usize = str_len(s);
    var cap: usize = 1;
    var offset: usize = 0;
    for (offset < n) {
        val c: u8 = s[offset];
        var width: usize = 1;
        if (c == '\\'::u8 || c == '"'::u8 || c == '\n'::u8 || c == '\r'::u8
            || c == '\t'::u8 || c == 8::u8 || c == 12::u8) { width = 2; }
        or (c < 32::u8 || c == 127::u8) { width = 6; }
        if (cap > 0xffffffffffffffff::usize - width) { ret R.err[str, str]("escaped TOML value is too long"); }
        cap = cap + width;
        offset = offset + 1;
    }
    val r: R.Result[*u8, str] = A.allocate[u8](alloc, cap);
    if (R.is_err[*u8, str](r)) { ret R.err[str, str](R.unwrap_err[*u8, str](r)); }
    val buf: *u8 = R.unwrap_ok[*u8, str](r);
    var k: usize = 0;
    var i: usize = 0;
    for (i < n) {
        val c: u8 = s[i];
        if (c == '\\'::u8) { buf[k] = '\\'::u8; k = k + 1; buf[k] = '\\'::u8; k = k + 1; }
        or (c == '"'::u8)  { buf[k] = '\\'::u8; k = k + 1; buf[k] = '"'::u8;  k = k + 1; }
        or (c == '\n'::u8) { buf[k] = '\\'::u8; k = k + 1; buf[k] = 'n'::u8;  k = k + 1; }
        or (c == '\r'::u8) { buf[k] = '\\'::u8; k = k + 1; buf[k] = 'r'::u8;  k = k + 1; }
        or (c == '\t'::u8) { buf[k] = '\\'::u8; k = k + 1; buf[k] = 't'::u8;  k = k + 1; }
        or (c == 8::u8)    { buf[k] = '\\'::u8; k = k + 1; buf[k] = 'b'::u8;  k = k + 1; }
        or (c == 12::u8)   { buf[k] = '\\'::u8; k = k + 1; buf[k] = 'f'::u8;  k = k + 1; }
        or (c < 32::u8 || c == 127::u8) {
            buf[k] = '\\'::u8; k = k + 1;
            buf[k] = 'u'::u8;  k = k + 1;
            buf[k] = '0'::u8;  k = k + 1;
            buf[k] = '0'::u8;  k = k + 1;
            buf[k] = hex_digit(c / 16::u8); k = k + 1;
            buf[k] = hex_digit(c % 16::u8); k = k + 1;
        }
        or { buf[k] = c; k = k + 1; }
        i = i + 1;
    }
    buf[k] = 0;
    ret R.ok[str, str](buf::str);
}

fun source_uses_crlf(source: str) bool {
    val n: usize = str_len(source);
    var i: usize = 0;
    for (i < n) {
        if (source[i] == '\n'::u8) { ret i > 0 && source[i - 1] == '\r'::u8; }
        i = i + 1;
    }
    ret false;
}

fun source_ends_with_newline(source: str) bool {
    val n: usize = str_len(source);
    ret n > 0 && source[n - 1] == '\n'::u8;
}

fun dep_entry_kind(alloc: *A.Allocator, source_text: str, name: str) R.Result[u8, str] {
    val parse_r: R.Result[toml.Table, str] = toml.parse(alloc, source_text);
    if (R.is_err[toml.Table, str](parse_r)) { ret R.err[u8, str](R.unwrap_err[toml.Table, str](parse_r)); }
    var tbl: toml.Table = R.unwrap_ok[toml.Table, str](parse_r);
    val deps: *toml.Table = toml.get_table(?tbl, "dep");
    var kind: u8 = DEP_LOOKUP_ABSENT;
    if (deps != nil) {
        val len: usize = toml.table_len(deps);
        var i: usize = 0;
        for (i < len) {
            if (str_equals(toml.table_key(deps, i), name)) {
                val v: *toml.Value = toml.table_value(deps, i);
                if (v != nil && v.tag == toml.TYPE_TABLE) { kind = DEP_LOOKUP_TABLE; }
                or { kind = DEP_LOOKUP_NON_TABLE; }
            }
            i = i + 1;
        }
    }
    toml.dnit(alloc, ?tbl);
    ret R.ok[u8, str](kind);
}

rec HeaderSpan {
    found:     bool;
    ambiguous: bool;
    start:     usize;
    body_end:  usize;
}

fun find_top_level_table(source: str, header: str) HeaderSpan {
    var hs: HeaderSpan;
    val n: usize = str_len(source);
    var pending_start: usize = 0;
    var in_target: bool = false;
    var i: usize = 0;
    for (i <= n) {
        val at_end: bool = i == n;
        val at_nl:  bool = !at_end && source[i] == '\n'::u8;
        if (at_end || at_nl) {
            val line_start: usize = pending_start;
            var line_end: usize = i;
            if (line_end > line_start && source[line_end - 1] == '\r'::u8) { line_end = line_end - 1; }
            val is_header: bool = line_end > line_start && source[line_start] == '['::u8;
            if (is_header) {
                val matches: bool = str_region_equals(source, line_start, line_end - line_start, header);
                if (in_target) { hs.body_end = line_start; in_target = false; }
                if (matches) {
                    if (hs.found) { hs.ambiguous = true; }
                    hs.found = true;
                    hs.start = line_start;
                    in_target = true;
                }
            }
            pending_start = i + 1;
        }
        i = i + 1;
    }
    if (in_target) { hs.body_end = n; }
    ret hs;
}

fun dep_key_name(source: DepSource) str {
    if (source == DEP_SOURCE_GIT) { ret "git"; }
    ret "path";
}

fun build_dep_block(alloc: *A.Allocator, nl: str, spec: *DepTableSpec) R.Result[str, str] {
    val esc_value_r: R.Result[str, str] = toml_escape_value(alloc, spec.value);
    if (R.is_err[str, str](esc_value_r)) { ret esc_value_r; }
    val esc_value: str = R.unwrap_ok[str, str](esc_value_r);

    val has_ref: bool = spec.source == DEP_SOURCE_GIT && !str_empty(spec.ref);
    var esc_ref: str = "";
    if (has_ref) {
        val esc_ref_r: R.Result[str, str] = toml_escape_value(alloc, spec.ref);
        if (R.is_err[str, str](esc_ref_r)) { str_free(alloc, esc_value); ret esc_ref_r; }
        esc_ref = R.unwrap_ok[str, str](esc_ref_r);
    }

    val key: str = dep_key_name(spec.source);
    var block_r: R.Result[str, str];
    if (has_ref) {
        block_r = format.sprint(alloc, "[dep.{}]{}{} = \"{}\"{}ref = \"{}\"{}", spec.name, nl, key, esc_value, nl, esc_ref, nl);
    }
    or {
        block_r = format.sprint(alloc, "[dep.{}]{}{} = \"{}\"{}", spec.name, nl, key, esc_value, nl);
    }
    str_free(alloc, esc_value);
    if (has_ref) { str_free(alloc, esc_ref); }
    ret block_r;
}

# append a `[dep.<name>]` table to manifest text, leaving every existing byte in
# place. the block uses the file's line ending and is separated by one blank
# line (two when the text lacks a trailing newline)
# ---
# alloc: owns the returned text
# source_text: the current `mach.toml`
# spec: the table to add
# ret: the new text; err when the name is not an identifier, the source is not
#  git or path, the text is not valid TOML, the dependency is already declared
#  in any form, or the result does not reparse with the table present
pub fun manifest_add_dep_table(alloc: *A.Allocator, source_text: str, spec: *DepTableSpec) R.Result[str, str] {
    if (!is_valid_id(spec.name)) { ret R.err[str, str]("dependency name must be a portable identifier (letters, digits, '_', '-')"); }
    if (spec.source != DEP_SOURCE_GIT && spec.source != DEP_SOURCE_PATH) { ret R.err[str, str]("unrecognized dependency source"); }

    val kind_r: R.Result[u8, str] = dep_entry_kind(alloc, source_text, spec.name);
    if (R.is_err[u8, str](kind_r)) { ret R.err[str, str](sfmt(alloc, "mach.toml is not valid TOML: {}", R.unwrap_err[u8, str](kind_r))); }
    if (R.unwrap_ok[u8, str](kind_r) != DEP_LOOKUP_ABSENT) {
        ret R.err[str, str](sfmt(alloc, "dependency '{}' is already declared in mach.toml", spec.name));
    }

    val nl: str = if_crlf(source_text);
    val block_r: R.Result[str, str] = build_dep_block(alloc, nl, spec);
    if (R.is_err[str, str](block_r)) { ret block_r; }
    val block: str = R.unwrap_ok[str, str](block_r);

    var sep: str = nl;
    if (!source_ends_with_newline(source_text)) { sep = sfmt(alloc, "{}{}", nl, nl); }

    val candidate_r: R.Result[str, str] = format.sprint(alloc, "{}{}{}", source_text, sep, block);
    str_free(alloc, block);
    if (R.is_err[str, str](candidate_r)) { ret candidate_r; }
    val candidate: str = R.unwrap_ok[str, str](candidate_r);

    val verify_r: R.Result[u8, str] = dep_entry_kind(alloc, candidate, spec.name);
    if (R.is_err[u8, str](verify_r) || R.unwrap_ok[u8, str](verify_r) != DEP_LOOKUP_TABLE) {
        str_free(alloc, candidate);
        ret R.err[str, str]("internal: added dependency table did not verify after reparse");
    }
    ret R.ok[str, str](candidate);
}

# cut a `[dep.<name>]` table out of manifest text, from its header line to the
# next header, leaving everything else byte for byte
# ---
# alloc: owns the returned text
# source_text: the current `mach.toml`
# name: the dependency name
# ret: the new text; err when the name is not an identifier, the text is not
#  valid TOML, the dependency is absent, is declared but not as a table, is
#  declared more than once, or its header is not spelled exactly `[dep.<name>]`
#  at the start of a line
pub fun manifest_remove_dep_table(alloc: *A.Allocator, source_text: str, name: str) R.Result[str, str] {
    if (!is_valid_id(name)) { ret R.err[str, str]("dependency name must be a portable identifier (letters, digits, '_', '-')"); }

    val kind_r: R.Result[u8, str] = dep_entry_kind(alloc, source_text, name);
    if (R.is_err[u8, str](kind_r)) { ret R.err[str, str](sfmt(alloc, "mach.toml is not valid TOML: {}", R.unwrap_err[u8, str](kind_r))); }
    val kind: u8 = R.unwrap_ok[u8, str](kind_r);
    if (kind == DEP_LOOKUP_ABSENT) { ret R.err[str, str](sfmt(alloc, "dependency '{}' is not declared in mach.toml", name)); }
    if (kind == DEP_LOOKUP_NON_TABLE) { ret R.err[str, str](sfmt(alloc, "dependency '{}' exists in mach.toml but is not a table; edit it by hand", name)); }

    val header: str = sfmt(alloc, "[dep.{}]", name);
    val hs: HeaderSpan = find_top_level_table(source_text, header);
    str_free(alloc, header);
    if (hs.ambiguous) { ret R.err[str, str](sfmt(alloc, "dependency '{}' is declared more than once in mach.toml; edit it by hand", name)); }
    if (!hs.found) { ret R.err[str, str](sfmt(alloc, "'[dep.{}]' was found by the parser but not by exact-header scan; edit it by hand", name)); }

    val before_r: R.Result[str, str] = str_copy_slice(alloc, source_text, 0, hs.start);
    if (R.is_err[str, str](before_r)) { ret before_r; }
    val before: str = R.unwrap_ok[str, str](before_r);
    val after_r: R.Result[str, str] = str_copy_slice(alloc, source_text, hs.body_end, str_len(source_text) - hs.body_end);
    if (R.is_err[str, str](after_r)) { str_free(alloc, before); ret after_r; }
    val after: str = R.unwrap_ok[str, str](after_r);

    val candidate_r: R.Result[str, str] = format.sprint(alloc, "{}{}", before, after);
    str_free(alloc, before);
    str_free(alloc, after);
    if (R.is_err[str, str](candidate_r)) { ret candidate_r; }
    val candidate: str = R.unwrap_ok[str, str](candidate_r);

    val verify_r: R.Result[u8, str] = dep_entry_kind(alloc, candidate, name);
    if (R.is_err[u8, str](verify_r) || R.unwrap_ok[u8, str](verify_r) != DEP_LOOKUP_ABSENT) {
        str_free(alloc, candidate);
        ret R.err[str, str]("internal: removed dependency table still verifies after reparse");
    }
    ret R.ok[str, str](candidate);
}

fun if_crlf(source: str) str {
    if (source_uses_crlf(source)) { ret "\r\n"; }
    ret "\n";
}

fun mk_sel(target: str, profile: str, artifact: str, want_lib: bool, has_artifact: bool) Selection {
    var s: Selection;
    s.target       = target;
    s.profile      = profile;
    s.artifact     = artifact;
    s.want_lib     = want_lib;
    s.has_artifact = has_artifact;
    ret s;
}

fun mk_tv(target: str, isa: str, os: str, abi: str, profile: str) TmplVars {
    var v: TmplVars;
    v.target    = target;
    v.isa       = isa;
    v.os        = os;
    v.abi       = abi;
    v.profile   = profile;
    v.reqs      = nil;
    v.req_count = 0;
    ret v;
}

fun tinit(backing: *A.Allocator, ar: *arena.Arena, alloc: *A.Allocator, itn: *intern.Interner) bool {
    if (O.is_some[str](page.make(backing))) { ret false; }
    if (O.is_some[str](arena.init(ar, backing, 0))) { ret false; }
    if (O.is_some[str](arena.make(alloc, ar))) { ret false; }
    @itn   = intern.init(alloc);
    ret true;
}

rec LinkFinishAllocProbe {
    backing: A.Allocator;
    items: ptr;
    items_size: usize;
    claims: ptr;
    claims_size: usize;
    realloc_count: u32;
    items_freed: bool;
    claims_freed: bool;
    mismatch: bool;
}

fun link_finish_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val p: *LinkFinishAllocProbe = ctx::*LinkFinishAllocProbe;
    ret p.backing.fn_allocate(p.backing.ctx, size, align);
}

fun link_finish_probe_reallocate(ctx: ptr, item: ptr, old_size: usize,
                                 new_size: usize, align: usize) O.Option[ptr] {
    val p: *LinkFinishAllocProbe = ctx::*LinkFinishAllocProbe;
    p.realloc_count = p.realloc_count + 1;
    if (item != p.items || old_size != p.items_size
        || new_size != $size_of(LinkRequirement)) { p.mismatch = true; }
    ret O.none[ptr]();
}

fun link_finish_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *LinkFinishAllocProbe = ctx::*LinkFinishAllocProbe;
    if (item == p.items) {
        p.items_freed = true;
        if (size != p.items_size) { p.mismatch = true; }
    }
    if (item == p.claims) {
        p.claims_freed = true;
        if (size != p.claims_size) { p.mismatch = true; }
    }
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

rec StepParseLive {
    backing: A.Allocator;
    live:    i64;
}

fun step_parse_live_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val p: *StepParseLive = ctx::*StepParseLive;
    val r: O.Option[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (O.is_some[ptr](r)) {
        p.live = p.live + size::i64;
        memory.raw_fill(O.unwrap[ptr](r), 0xAA, size);
    }
    ret r;
}

fun step_parse_live_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    val p: *StepParseLive = ctx::*StepParseLive;
    val r: O.Option[ptr] = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (O.is_some[ptr](r)) {
        p.live = p.live - old_size::i64 + new_size::i64;
        if (new_size > old_size) {
            val grown: ptr = O.unwrap[ptr](r);
            memory.raw_fill((grown::usize + old_size)::ptr, 0xAA, new_size - old_size);
        }
    }
    ret r;
}

fun step_parse_live_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *StepParseLive = ctx::*StepParseLive;
    p.live = p.live - size::i64;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun step_parse_live_make(p: *StepParseLive, alloc: *A.Allocator) bool {
    if (O.is_some[str](page.make(?p.backing))) { ret false; }
    p.live = 0;
    val probe: *StepParseLive = p;
    alloc.ctx = probe::ptr;
    alloc.fn_allocate = step_parse_live_allocate;
    alloc.fn_reallocate = step_parse_live_reallocate;
    alloc.fn_deallocate = step_parse_live_deallocate;
    ret true;
}

rec PlanAllocProbe {
    backing: A.Allocator;
    live: i64;
    calls: u32;
    fail_at: u32;
    ptrs: [4]ptr;
    sizes: [4]usize;
    mismatch: bool;
}

fun plan_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val p: *PlanAllocProbe = ctx::*PlanAllocProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret O.none[ptr](); }
    val allocated: O.Option[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (O.is_none[ptr](allocated)) { ret allocated; }
    val item: ptr = O.unwrap[ptr](allocated);
    var i: usize = 0;
    for (i < 4 && p.ptrs[i] != nil) { i = i + 1; }
    if (i == 4) { p.mismatch = true; }
    or { p.ptrs[i] = item; p.sizes[i] = size; }
    p.live = p.live + size::i64;
    ret allocated;
}

fun plan_probe_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    val p: *PlanAllocProbe = ctx::*PlanAllocProbe;
    p.mismatch = true;
    ret O.none[ptr]();
}

fun plan_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *PlanAllocProbe = ctx::*PlanAllocProbe;
    var i: usize = 0;
    for (i < 4 && p.ptrs[i] != item) { i = i + 1; }
    if (i == 4) { p.mismatch = true; ret p.backing.fn_deallocate(p.backing.ctx, item, size, align); }
    if (p.sizes[i] != size) { p.mismatch = true; }
    p.live = p.live - p.sizes[i]::i64;
    p.ptrs[i] = nil;
    p.sizes[i] = 0;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun plan_probe_make(p: *PlanAllocProbe, alloc: *A.Allocator, fail_at: u32) bool {
    if (O.is_some[str](page.make(?p.backing))) { ret false; }
    p.live = 0;
    p.calls = 0;
    p.fail_at = fail_at;
    p.mismatch = false;
    var i: usize = 0;
    for (i < 4) { p.ptrs[i] = nil; p.sizes[i] = 0; i = i + 1; }
    val probe: *PlanAllocProbe = p;
    alloc.ctx = probe::ptr;
    alloc.fn_allocate = plan_probe_allocate;
    alloc.fn_reallocate = plan_probe_reallocate;
    alloc.fn_deallocate = plan_probe_deallocate;
    ret true;
}

fun tparse(alloc: *A.Allocator, itn: *intern.Interner, src: str) R.Result[Manifest, str] {
    val source_r: R.Result[R.Void, str] = validate_source_text(src);
    if (R.is_err[R.Void, str](source_r)) { ret R.err[Manifest, str](R.unwrap_err[R.Void, str](source_r)); }
    val tbl_r: R.Result[toml.Table, str] = toml.parse(alloc, src);
    if (R.is_err[toml.Table, str](tbl_r)) { ret R.err[Manifest, str](R.unwrap_err[toml.Table, str](tbl_r)); }
    var tbl: toml.Table = R.unwrap_ok[toml.Table, str](tbl_r);
    val m: R.Result[Manifest, str] = parse(alloc, itn, ?tbl, true);
    toml.dnit(alloc, ?tbl);
    ret m;
}

fun tparse_lenient(alloc: *A.Allocator, itn: *intern.Interner, src: str) R.Result[Manifest, str] {
    val source_r: R.Result[R.Void, str] = validate_source_text(src);
    if (R.is_err[R.Void, str](source_r)) { ret R.err[Manifest, str](R.unwrap_err[R.Void, str](source_r)); }
    val tbl_r: R.Result[toml.Table, str] = toml.parse(alloc, src);
    if (R.is_err[toml.Table, str](tbl_r)) { ret R.err[Manifest, str](R.unwrap_err[toml.Table, str](tbl_r)); }
    var tbl: toml.Table = R.unwrap_ok[toml.Table, str](tbl_r);
    val m: R.Result[Manifest, str] = parse(alloc, itn, ?tbl, false);
    toml.dnit(alloc, ?tbl);
    ret m;
}

test "mach.lang.manifest.is_valid_id" {
    var code: i32 = 0;
    if (!is_valid_id("foo"))    { code = 1; }
    if (!is_valid_id("my_app")) { code = 1; }
    if (!is_valid_id("my-app")) { code = 1; }
    if (!is_valid_id("Proj2"))  { code = 1; }
    if (!is_valid_id("9"))      { code = 1; }
    if (is_valid_id(""))        { code = 1; }
    if (is_valid_id("."))       { code = 1; }
    if (is_valid_id(".."))      { code = 1; }
    if (is_valid_id("foo/bar")) { code = 1; }
    if (is_valid_id("foo.bar")) { code = 1; }
    if (is_valid_id("a b"))     { code = 1; }
    ret code;
}

test "mach.lang.manifest.validate_source_bytes:raw_nul_in_comment" {
    var src: [12]u8;
    src[0] = '#';
    src[1] = ' ';
    src[2] = 'n';
    src[3] = 'o';
    src[4] = 't';
    src[5] = 'e';
    src[6] = 0;
    src[7] = '\n';
    src[8] = 'x';
    src[9] = '=';
    src[10] = '1';
    src[11] = '\n';
    val r: R.Result[R.Void, str] = validate_source_bytes(?src[0], 12);
    if (R.is_ok[R.Void, str](r)) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.validate_source_bytes:multiline_four_quote_terminator" {
    val safe: R.Result[R.Void, str] = validate_source_text("value = \"\"\"safe\"\"\"\"\nnext = \"text\"\n");
    if (R.is_err[R.Void, str](safe)) { ret 1; }
    val nul: R.Result[R.Void, str] = validate_source_text("value = \"\"\"safe\"\"\"\"\nnext = \"pre\\u0000post\"\n");
    if (R.is_ok[R.Void, str](nul) || !str_contains(R.unwrap_err[R.Void, str](nul), "NUL")) { ret 1; }
    val long_nul: R.Result[R.Void, str] = validate_source_text("value = '''safe''''\nnext = \"pre\\U00000000post\"\n");
    if (R.is_ok[R.Void, str](long_nul) || !str_contains(R.unwrap_err[R.Void, str](long_nul), "NUL")) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.parse:demo_src_ok" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val res_manifest: R.Result[Manifest, str] = tparse(?alloc, ?itn, demo_src());
    if (R.is_err[Manifest, str](res_manifest)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](res_manifest);
        if (!str_equals(idstr(?itn, m.id), "demo"))              { code = 1; }
        if (!str_equals(idstr(?itn, m.version), "0.1.0"))         { code = 1; }
        if (!str_equals(idstr(?itn, m.src), "src"))               { code = 1; }
        if (!str_equals(idstr(?itn, m.out_tmpl), "out/{target.name}/{profile.name}")) { code = 1; }
        if (m.target_count != 2)                                 { code = 1; }
        if (m.artifact_count != 2)                               { code = 1; }
        if (m.profile_count != 2)                                { code = 1; }
        if (m.dep_count != 1)                                    { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:missing_required_keys" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val a: R.Result[Manifest, str] = tparse(?alloc, ?itn, "[project]\nversion=\"1\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n");
    if (R.is_ok[Manifest, str](a) || !str_equals(R.unwrap_err[Manifest, str](a), "mach.toml: [project] is missing required key 'id'")) { code = 1; }

    val b: R.Result[Manifest, str] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n");
    if (R.is_ok[Manifest, str](b) || !str_equals(R.unwrap_err[Manifest, str](b), "mach.toml: [project] is missing required key 'version'")) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:the_five_unread_keys_are_accepted_recorded_and_never_read_in_both_forms" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val text: str = "[project]\nid=\"x\"\nversion=\"1\"\nname=\"App\"\ndescription=\"d\"\nmach=\"4.14.0\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nemit_ir=true\nemit_asm=true\n";
    var form: u32 = 0;
    for (form < 2) {
        var r: R.Result[Manifest, str] = tparse(?alloc, ?itn, text);
        if (form == 1) { r = tparse_lenient(?alloc, ?itn, text); }
        if (R.is_err[Manifest, str](r)) { code = 1; }
        or {
            var m: Manifest = R.unwrap_ok[Manifest, str](r);
            if (m.deprecated_count != 5) { code = 2; }
            or {
                if (!str_equals(m.deprecated[0].table, "[project]") || !str_equals(m.deprecated[0].key, "name")) { code = 3; }
                if (!str_equals(m.deprecated[1].key, "description") || !str_equals(m.deprecated[2].key, "mach")) { code = 4; }
                if (!str_equals(m.deprecated[3].table, "[profile.debug]") || !str_equals(m.deprecated[3].key, "emit_ir")
                    || !str_equals(m.deprecated[4].key, "emit_asm")) { code = 5; }
            }
            val msg: str = deprecated_key_warning(?alloc, "", ?m.deprecated[0]);
            if (!str_equals(msg, "mach.toml: [project] key 'name' is accepted and ignored; 5.0.0 refuses it: remove the key")) { code = 6; }
            dnit(?m, ?alloc);
        }
        form = form + 1;
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:an_artifact_link_naming_no_link_table_is_refused_naming_the_artifact_and_the_tables" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n";
    val links: str = "[link.m]\nsource=\"system\"\nname=\"m\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n[link.z]\nsource=\"system\"\nname=\"z\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n";
    val bad_art: str = "[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[\"m\", \"nope\"]\nneed=[]\n";
    val good_art: str = "[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[\"m\", \"z\"]\nneed=[]\n";

    val r: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, links, bad_art));
    if (R.is_ok[Manifest, str](r)) { code = 1; }
    or {
        val msg: str = R.unwrap_err[Manifest, str](r);
        if (!str_equals(msg, "mach.toml: [artifact.app].link names no [link.*] table: 'nope' (declared: [link.m], [link.z])")) { code = 2; }
    }
    val none: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, bad_art));
    if (R.is_ok[Manifest, str](none) || !str_contains(R.unwrap_err[Manifest, str](none), "no [link.*] table is declared")) { code = 3; }
    val dep: R.Result[Manifest, str] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, links, bad_art));
    if (R.is_ok[Manifest, str](dep)) { code = 4; }
    val ok: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, links, good_art));
    if (R.is_err[Manifest, str](ok)) { code = 5; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:unknown_keys" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val a: R.Result[Manifest, str] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\nbogus=\"y\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n");
    if (R.is_ok[Manifest, str](a) || !str_equals(R.unwrap_err[Manifest, str](a), "mach.toml: unknown key 'bogus' in [project]")) { code = 1; }

    val b: R.Result[Manifest, str] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\nwat=\"z\"\n");
    if (R.is_ok[Manifest, str](b) || !str_equals(R.unwrap_err[Manifest, str](b), "mach.toml: unknown key 'wat' in [target.l]")) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

fun need_head() str {
    ret "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n";
}

fun need_artifact(alloc: *A.Allocator, name: str, out: str, need: str) str {
    ret sfmt(alloc, "[artifact.{}]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"lib/{}.a\"\ntargets=[\"host\"]\nlink=[]\nneed=[{}]\n", name, out, need);
}

fun need_err(alloc: *A.Allocator, itn: *intern.Interner, src: str, needle: str) bool {
    val r: R.Result[Manifest, str] = tparse(alloc, itn, src);
    if (R.is_ok[Manifest, str](r)) { ret false; }
    ret str_contains(R.unwrap_err[Manifest, str](r), needle);
}

test "mach.lang.manifest.glob_matches:wildcards_anchor_at_both_ends" {
    var code: i32 = 0;
    if (!glob_matches("shader-*", "shader-blur"))  { code = 1; }
    if (!glob_matches("shader-*", "shader-"))      { code = 1; }
    if (glob_matches("shader-*", "shade"))         { code = 1; }
    if (glob_matches("shader-*", "xshader-blur"))  { code = 1; }
    if (!glob_matches("*", "anything"))            { code = 1; }
    if (!glob_matches("*-spv", "blur-spv"))        { code = 1; }
    if (glob_matches("*-spv", "blur-spvx"))        { code = 1; }
    if (!glob_matches("a*b*c", "axxbyyc"))         { code = 1; }
    if (glob_matches("a*b*c", "axxbyy"))           { code = 1; }
    if (!glob_matches("exact", "exact"))           { code = 1; }
    if (glob_matches("exact", "exacts"))           { code = 1; }
    ret code;
}

test "mach.lang.manifest.validate_needs:accepts_artifact_ids_globs_and_step_ids" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = sfmt(?alloc, "{}{}{}{}{}", need_head(),
        need_artifact(?alloc, "shader-a", "a", ""),
        need_artifact(?alloc, "shader-b", "b", ""),
        "[step.gen]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"shader-*\",\"gen\",\"shader-b\"]\n");
    val r: R.Result[Manifest, str] = tparse(?alloc, ?itn, src);
    if (R.is_err[Manifest, str](r)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](r);
        val app: *ArtifactDef = find_artifact_by_name(?m, intern_unwrap(?itn, "app"));
        val sa:  *ArtifactDef = find_artifact_by_name(?m, intern_unwrap(?itn, "shader-a"));
        if (app == nil || sa == nil)                        { code = 1; }
        or {
            if (!artifact_needs_artifact(?itn, app, sa))    { code = 1; }
            if (artifact_needs_artifact(?itn, sa, app))     { code = 1; }
            if (artifact_needs_artifact(?itn, app, app))    { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.validate_needs:rejects_a_name_that_is_both_a_step_and_an_artifact" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = sfmt(?alloc, "{}{}{}{}", need_head(),
        need_artifact(?alloc, "twin", "twin", ""),
        "[step.twin]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"twin\"]\n");
    if (!need_err(?alloc, ?itn, src, "names 'twin', which is both build step '[step.twin]' and artifact '[artifact.twin]'")) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.validate_needs:rejects_an_empty_glob_an_unknown_id_and_self" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val empty_glob: str = sfmt(?alloc, "{}{}{}", need_head(),
        need_artifact(?alloc, "shader-a", "a", ""),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"nothing-*\"]\n");
    if (!need_err(?alloc, ?itn, empty_glob, "need pattern 'nothing-*' matches no build step or artifact")) { code = 1; }

    val unknown: str = sfmt(?alloc, "{}{}", need_head(),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"ghost\"]\n");
    if (!need_err(?alloc, ?itn, unknown, "need refers to unknown build step or artifact 'ghost'")) { code = 1; }

    val itself: str = sfmt(?alloc, "{}{}", need_head(),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"app\"]\n");
    if (!need_err(?alloc, ?itn, itself, "[artifact.app].need requires itself")) { code = 1; }

    val bad_char: str = sfmt(?alloc, "{}{}", need_head(),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"../step\"]\n");
    if (!need_err(?alloc, ?itn, bad_char, "must name a build step or artifact, optionally with '*' wildcards")) { code = 1; }

    val self_glob: str = sfmt(?alloc, "{}{}", need_head(),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"a*\"]\n");
    if (!need_err(?alloc, ?itn, self_glob, "need pattern 'a*' matches no build step or artifact")) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.validate_needs:rejects_a_cycle_naming_the_chain" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val two: str = sfmt(?alloc, "{}{}{}", need_head(),
        need_artifact(?alloc, "a", "a", "\"b\""),
        need_artifact(?alloc, "b", "b", "\"a\""));
    if (!need_err(?alloc, ?itn, two, "artifact 'need' cycle: a -> b -> a")) { code = 1; }

    val three: str = sfmt(?alloc, "{}{}{}{}", need_head(),
        need_artifact(?alloc, "a", "a", "\"b\""),
        need_artifact(?alloc, "b", "b", "\"c\""),
        need_artifact(?alloc, "c", "c", "\"a\""));
    if (!need_err(?alloc, ?itn, three, "artifact 'need' cycle: a -> b -> c -> a")) { code = 1; }

    val glob_cycle: str = sfmt(?alloc, "{}{}{}", need_head(),
        need_artifact(?alloc, "pack-a", "pa", "\"pack-b\""),
        need_artifact(?alloc, "pack-b", "pb", "\"pack-*\""));
    if (!need_err(?alloc, ?itn, glob_cycle, "artifact 'need' cycle: pack-a -> pack-b -> pack-a")) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

fun need_two_target_head() str {
    ret "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}/{profile.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.alt]\nisa=\"aarch64\"\nos=\"linux\"\nabi=\"aapcs64\"\n[target.alt2]\nisa=\"riscv64\"\nos=\"linux\"\nabi=\"lp64d\"\n";
}

test "mach.lang.manifest.resolve_artifact_reqs:resolves_the_required_output_on_its_own_target" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = sfmt(?alloc, "{}{}{}", need_two_target_head(),
        "[artifact.shader-a]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"lib/shader-a.a\"\ntargets=[\"alt\"]\nlink=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"shader-*\"]\n");
    val r: R.Result[Manifest, str] = tparse(?alloc, ?itn, src);
    if (R.is_err[Manifest, str](r)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](r);
        val app: *ArtifactDef = find_artifact(?itn, ?m, "app");
        val host: *TargetDef  = find_target_by_name(?itn, ?m, "host");
        var items: *ArtifactReq = nil;
        var count: u32 = 0;
        val rr: R.Result[R.Void, str] = resolve_artifact_reqs(?alloc, ?itn, ?m, app, host, "debug", false, ?items, ?count);
        if (R.is_err[R.Void, str](rr))                              { code = 1; }
        or {
            if (count != 1)                                       { code = 1; }
            or {
                if (!str_equals(items[0].name, "shader-a"))       { code = 1; }
                if (!str_equals(items[0].out, "out/alt/debug/lib/shader-a.a")) { code = 1; }
            }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_artifact_reqs:a_requirement_with_two_targets_has_no_single_output" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = sfmt(?alloc, "{}{}{}", need_two_target_head(),
        "[artifact.shader-a]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"lib/shader-a.a\"\ntargets=[\"alt\",\"alt2\"]\nlink=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"shader-a\"]\n");
    val r: R.Result[Manifest, str] = tparse(?alloc, ?itn, src);
    if (R.is_err[Manifest, str](r)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](r);
        val app: *ArtifactDef = find_artifact(?itn, ?m, "app");
        val host: *TargetDef  = find_target_by_name(?itn, ?m, "host");
        var items: *ArtifactReq = nil;
        var count: u32 = 0;
        val rr: R.Result[R.Void, str] = resolve_artifact_reqs(?alloc, ?itn, ?m, app, host, "debug", false, ?items, ?count);
        if (R.is_err[R.Void, str](rr))            { code = 1; }
        or {
            if (count != 1)                     { code = 1; }
            or {
                if (!str_empty(items[0].out))   { code = 1; }
                var v: TmplVars = tmpl_vars_of_reqs(items, count);
                val er: R.Result[str, str] = expand(?alloc, "{artifact.shader-a.out}", "", ?v);
                if (R.is_ok[str, str](er) || !str_contains(R.unwrap_err[str, str](er), "is ambiguous")) { code = 1; }
            }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.expand_artifact_path:substitutes_only_the_artifact_vocabulary" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    var items: [1]ArtifactReq;
    items[0].name = "shader-a";
    items[0].out  = "out/alt/debug/lib/shader-a.a";

    val ok: R.Result[str, TemplateError] = expand_artifact_path(?alloc, "{artifact.shader-a.out}", ?items[0], 1, "an `embed` path");
    if (R.is_err[str, TemplateError](ok) || !str_equals(R.unwrap_ok[str, TemplateError](ok), "out/alt/debug/lib/shader-a.a")) { code = 1; }

    val plain: R.Result[str, TemplateError] = expand_artifact_path(?alloc, "assets/logo.png", ?items[0], 1, "an `embed` path");
    if (R.is_err[str, TemplateError](plain) || !str_equals(R.unwrap_ok[str, TemplateError](plain), "assets/logo.png")) { code = 1; }

    val other: R.Result[str, TemplateError] = expand_artifact_path(?alloc, "{target.name}/x", ?items[0], 1, "an `embed` path");
    if (R.is_ok[str, TemplateError](other) || !str_contains(R.unwrap_err[str, TemplateError](other).message, "only '{artifact.<id>.out}' may appear")) { code = 1; }

    val missing: R.Result[str, TemplateError] = expand_artifact_path(?alloc, "{artifact.ghost.out}", ?items[0], 1, "an `embed` path");
    if (R.is_ok[str, TemplateError](missing) || !str_contains(R.unwrap_err[str, TemplateError](missing).message, "does not require")) { code = 1; }

    val none_declared: R.Result[str, TemplateError] = expand_artifact_path(?alloc, "{artifact.shader-a.out}", nil, 0, "an `embed` path");
    if (R.is_ok[str, TemplateError](none_declared) || !str_contains(R.unwrap_err[str, TemplateError](none_declared).message, "does not require")) { code = 1; }

    val unterminated: R.Result[str, TemplateError] = expand_artifact_path(?alloc, "{artifact.shader-a.out", ?items[0], 1, "an `embed` path");
    if (R.is_ok[str, TemplateError](unterminated)) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:an_artifact_out_template_cannot_name_another_artifact" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = sfmt(?alloc, "{}{}{}", need_two_target_head(),
        "[artifact.shader-a]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"lib/shader-a.a\"\ntargets=[\"alt\"]\nlink=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/{artifact.shader-a.out}\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"shader-a\"]\n");
    val r: R.Result[Manifest, str] = tparse(?alloc, ?itn, src);
    if (R.is_err[Manifest, str](r)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](r);
        val u: R.Result[BuildUnit, str] = resolve_build_unit(?alloc, ?itn, ?m, mk_sel("host", "", "app", false, true));
        if (R.is_ok[BuildUnit, str](u) || !str_contains(R.unwrap_err[BuildUnit, str](u), "does not require")) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:argv_step_contract" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";

    val valid: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=['\"quoted\"',\"'single'\",'semi;$|&<>*?[]','{\"x\":1}',\"{\\\"escaped\\\":true}\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\nVALUE='literal;$|&<>*?[]'\nJSON=\"{\\\"x\\\":1}\"\n"));
    if (R.is_err[Manifest, str](valid)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](valid);
        if (m.step_count != 1 || m.steps[0].argv_count != 5 || m.steps[0].env_count != 2) { code = 1; }
        or {
            if (!str_equals(idstr(?itn, m.steps[0].argv[0]), "\"quoted\"")) { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].argv[1]), "'single'")) { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].argv[2]), "semi;$|&<>*?[]")) { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].argv[3]), "{\"x\":1}")) { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].argv[4]), "{\"escaped\":true}")) { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].env_keys[0]), "JSON") || !str_equals(idstr(?itn, m.steps[0].env_values[0]), "{\"x\":1}")) { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].env_keys[1]), "VALUE") || !str_equals(idstr(?itn, m.steps[0].env_values[1]), "literal;$|&<>*?[]")) { code = 1; }
        }
    }

    val empty: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[]\nin=[]\nout=[]\nneed=[]\n"));
    if (R.is_ok[Manifest, str](empty) || !str_contains(R.unwrap_err[Manifest, str](empty), ".argv must be nonempty")) { code = 1; }

    val empty_program: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"\"]\nin=[]\nout=[]\nneed=[]\n"));
    if (R.is_ok[Manifest, str](empty_program) || !str_contains(R.unwrap_err[Manifest, str](empty_program), "argv[0] must name an executable")) { code = 1; }

    val cmd: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\ncmd=\"true\"\nin=[]\nout=[]\nneed=[]\n"));
    if (R.is_ok[Manifest, str](cmd) || !str_contains(R.unwrap_err[Manifest, str](cmd), "uses removed key 'cmd'")) { code = 1; }

    val shell: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nshell=true\nin=[]\nout=[]\nneed=[]\n"));
    if (R.is_ok[Manifest, str](shell) || !str_contains(R.unwrap_err[Manifest, str](shell), "uses removed key 'shell'")) { code = 1; }

    val env_type: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={VALUE=1}\nin=[]\nout=[]\nneed=[]\n"));
    if (R.is_ok[Manifest, str](env_type) || !str_contains(R.unwrap_err[Manifest, str](env_type), ".env.VALUE must be a string")) { code = 1; }

    val env_ambiguous: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={PATH=\"a\",Path=\"b\"}\nin=[]\nout=[]\nneed=[]\n"));
    if (R.is_ok[Manifest, str](env_ambiguous) || !str_contains(R.unwrap_err[Manifest, str](env_ambiguous), "ambiguous keys")) { code = 1; }

    val env_order_a: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={z=\"last\",B=\"middle\",a=\"first\"}\nin=[]\nout=[]\nneed=[]\n"));
    val env_order_b: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={a=\"first\",z=\"last\",B=\"middle\"}\nin=[]\nout=[]\nneed=[]\n"));
    if (R.is_err[Manifest, str](env_order_a) || R.is_err[Manifest, str](env_order_b)) { code = 1; }
    or {
        val ma: Manifest = R.unwrap_ok[Manifest, str](env_order_a);
        val mb: Manifest = R.unwrap_ok[Manifest, str](env_order_b);
        var ei: u32 = 0;
        for (ei < ma.steps[0].env_count && ei < mb.steps[0].env_count) {
            if (ma.steps[0].env_keys[ei] != mb.steps[0].env_keys[ei]) { code = 1; }
            if (ma.steps[0].env_values[ei] != mb.steps[0].env_values[ei]) { code = 1; }
            ei = ei + 1;
        }
        if (!str_equals(idstr(?itn, ma.steps[0].env_keys[0]), "a")) { code = 1; }
        if (!str_equals(idstr(?itn, ma.steps[0].env_values[0]), "first")) { code = 1; }
        if (!str_equals(idstr(?itn, ma.steps[0].env_keys[1]), "B")) { code = 1; }
        if (!str_equals(idstr(?itn, ma.steps[0].env_values[1]), "middle")) { code = 1; }
        if (!str_equals(idstr(?itn, ma.steps[0].env_keys[2]), "z")) { code = 1; }
        if (!str_equals(idstr(?itn, ma.steps[0].env_values[2]), "last")) { code = 1; }
    }

    val argv_nul: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"pre\\u0000post\"]\nin=[]\nout=[]\nneed=[]\n"));
    if (R.is_ok[Manifest, str](argv_nul) || !str_contains(R.unwrap_err[Manifest, str](argv_nul), "cannot contain NUL")) { code = 1; }

    val env_key_nul: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\n\"A\\u0000B\"=\"x\"\n"));
    if (R.is_ok[Manifest, str](env_key_nul) || !str_contains(R.unwrap_err[Manifest, str](env_key_nul), "cannot contain NUL")) { code = 1; }

    val env_value_nul: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\nVALUE=\"pre\\U00000000post\"\n"));
    if (R.is_ok[Manifest, str](env_value_nul) || !str_contains(R.unwrap_err[Manifest, str](env_value_nul), "cannot contain NUL")) { code = 1; }

    val literal_escape: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=['pre\\u0000post']\nin=[]\nout=[]\nneed=[]\n"));
    if (R.is_err[Manifest, str](literal_escape)) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:late_step_error_releases_owned_arrays" {
    var probe: StepParseLive;
    var alloc: A.Allocator;
    if (!step_parse_live_make(?probe, ?alloc)) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);
    val r: R.Result[Manifest, str] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\",\"arg\"]\nenv={A=\"one\",B=\"two\"}\nin=[\"src\"]\nout=[\"../escape\"]\nneed=[]\n");
    if (R.is_ok[Manifest, str](r)) { intern.dnit(?itn); ret 1; }
    str_free(?alloc, R.unwrap_err[Manifest, str](r));
    intern.dnit(?itn);
    if (probe.live != 0) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.parse:artifact_middle_entry_error_releases_owned_arrays" {
    var probe: StepParseLive;
    var alloc: A.Allocator;
    if (!step_parse_live_make(?probe, ?alloc)) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);
    val r: R.Result[Manifest, str] = tparse(?alloc, ?itn,
        "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[artifact.a]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/a\"\ntargets=[\"t1\",\"t2\"]\nlink=[\"l1\"]\nneed=[]\n[artifact.b]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/b\"\ntargets=[\"t1\"]\nlink=[\"l1\",\"l2\"]\nneed=[\"a\"]\nicon=\"icon.ico\"\n[artifact.c]\nkind=\"bin\"\nentry=\"c.mach\"\nout=\"bin/c\"\ntargets=[\"t1\"]\nlink=[]\nneed=[]\n");
    if (R.is_ok[Manifest, str](r)) { intern.dnit(?itn); ret 1; }
    if (!str_contains(R.unwrap_err[Manifest, str](r), "icon and .manifest apply only to kind = \"bin\"")) {
        str_free(?alloc, R.unwrap_err[Manifest, str](r));
        intern.dnit(?itn);
        ret 1;
    }
    str_free(?alloc, R.unwrap_err[Manifest, str](r));
    intern.dnit(?itn);
    if (probe.live != 0) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.parse:link_middle_entry_error_releases_owned_arrays" {
    var probe: StepParseLive;
    var alloc: A.Allocator;
    if (!step_parse_live_make(?probe, ?alloc)) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);
    val r: R.Result[Manifest, str] = tparse(?alloc, ?itn,
        "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[link.a]\nsource=\"system\"\nname=\"foo\"\nsymbols=[\"sym1\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=true\n[link.b]\nsource=\"system\"\nname=\"bar\"\nsymbols=[\"sym2\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\n[link.c]\nsource=\"system\"\nname=\"baz\"\nsymbols=[\"sym3\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=true\n");
    if (R.is_ok[Manifest, str](r)) { intern.dnit(?itn); ret 1; }
    if (!str_contains(R.unwrap_err[Manifest, str](r), "is missing required key 'export'")) {
        str_free(?alloc, R.unwrap_err[Manifest, str](r));
        intern.dnit(?itn);
        ret 1;
    }
    str_free(?alloc, R.unwrap_err[Manifest, str](r));
    intern.dnit(?itn);
    if (probe.live != 0) { ret 1; }
    ret 0;
}

fun step_intern_fail_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    ret O.none[ptr]();
}

fun step_intern_fail_reallocate(ctx: ptr, item: ptr, old_size: usize,
                                new_size: usize, align: usize) O.Option[ptr] {
    ret O.none[ptr]();
}

fun step_intern_fail_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.manifest.parse:env_intern_failure_aborts_step" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var base: intern.Interner = intern.init(?alloc);
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n";
    val seeded_r: R.Result[Manifest, str] = tparse(?alloc, ?base, head);
    if (R.is_err[Manifest, str](seeded_r)) { intern.dnit(?base); ret 1; }
    var seeded: Manifest = R.unwrap_ok[Manifest, str](seeded_r);
    dnit(?seeded, ?alloc);

    val source: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\nUNSEEDED=\"value\"\n";
    val table_r: R.Result[toml.Table, str] = toml.parse(?alloc, source);
    if (R.is_err[toml.Table, str](table_r)) { intern.dnit(?base); ret 1; }
    var table: toml.Table = R.unwrap_ok[toml.Table, str](table_r);

    var fail_alloc: A.Allocator;
    fail_alloc.ctx = nil;
    fail_alloc.fn_allocate = step_intern_fail_allocate;
    fail_alloc.fn_reallocate = step_intern_fail_reallocate;
    fail_alloc.fn_deallocate = step_intern_fail_deallocate;
    var child: intern.Interner = intern.make_child(?base, ?fail_alloc);
    val parsed: R.Result[Manifest, str] = parse(?alloc, ?child, ?table, true);
    toml.dnit(?alloc, ?table);
    val bad: bool = R.is_ok[Manifest, str](parsed) || child.len != 0;
    intern.dnit(?child);
    intern.dnit(?base);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.parse:simd_required_and_validated" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";

    val a: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=0\ndebug=false\nsimd=\"scalarize\"\n"));
    if (R.is_err[Manifest, str](a)) { code = 1; }
    or { if (R.unwrap_ok[Manifest, str](a).profiles[0].simd != SIMD_SCALARIZE) { code = 1; } }

    val b: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=0\ndebug=false\nsimd=\"require\"\n"));
    if (R.is_err[Manifest, str](b)) { code = 1; }
    or { if (R.unwrap_ok[Manifest, str](b).profiles[0].simd != SIMD_REQUIRE) { code = 1; } }

    val c: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=0\ndebug=false\n"));
    if (R.is_ok[Manifest, str](c) || !str_contains(R.unwrap_err[Manifest, str](c), "[profile.p] is missing required key 'simd'")) { code = 1; }

    val d: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=0\ndebug=false\nsimd=\"bogus\"\n"));
    if (R.is_ok[Manifest, str](d) || !str_contains(R.unwrap_err[Manifest, str](d), "simd must be \"scalarize\" or \"require\"")) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:float_reassoc_optional_and_off" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";

    val a: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=2\ndebug=false\nsimd=\"scalarize\"\n"));
    if (R.is_err[Manifest, str](a)) { code = 1; }
    or {
        var ma: Manifest = R.unwrap_ok[Manifest, str](a);
        if (ma.profiles[0].float_reassoc) { code = 1; }
        val ra: R.Result[ResolvedProfile, str] = resolve_profile(?alloc, ?itn, ?ma, "p");
        if (R.is_err[ResolvedProfile, str](ra)) { code = 1; }
        or { if (R.unwrap_ok[ResolvedProfile, str](ra).float_reassoc) { code = 1; } }
    }

    val b: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nfloat_reassoc=true\n"));
    if (R.is_err[Manifest, str](b)) { code = 1; }
    or {
        var mb: Manifest = R.unwrap_ok[Manifest, str](b);
        if (!mb.profiles[0].float_reassoc) { code = 1; }
        val rb: R.Result[ResolvedProfile, str] = resolve_profile(?alloc, ?itn, ?mb, "p");
        if (R.is_err[ResolvedProfile, str](rb)) { code = 1; }
        or { if (!R.unwrap_ok[ResolvedProfile, str](rb).float_reassoc) { code = 1; } }
    }

    val c: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nfloat_reassoc=false\n"));
    if (R.is_err[Manifest, str](c)) { code = 1; }
    or { if (R.unwrap_ok[Manifest, str](c).profiles[0].float_reassoc) { code = 1; } }

    val d: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nfloat_reassoc=\"yes\"\n"));
    if (R.is_ok[Manifest, str](d) || !str_contains(R.unwrap_err[Manifest, str](d), "float_reassoc must be a boolean")) { code = 1; }

    val e: R.Result[Manifest, str] = tparse(?alloc, ?itn, head);
    if (R.is_err[Manifest, str](e)) { code = 1; }
    or {
        var me: Manifest = R.unwrap_ok[Manifest, str](e);
        val re: R.Result[ResolvedProfile, str] = resolve_profile(?alloc, ?itn, ?me, "");
        if (R.is_err[ResolvedProfile, str](re)) { code = 1; }
        or { if (R.unwrap_ok[ResolvedProfile, str](re).float_reassoc) { code = 1; } }
    }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:profile_selection_contract" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{profile.name}\"\n";

    val builtins: R.Result[Manifest, str] = tparse(?alloc, ?itn, head);
    if (R.is_err[Manifest, str](builtins)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](builtins);
        if (m.profile_count != 2) { code = 1; }
        or {
            val debug: *ProfileDef = ?m.profiles[0];
            val release: *ProfileDef = ?m.profiles[1];
            if (!str_equals(idstr(?itn, debug.name), "debug") || !debug.is_default
                || debug.opt != MOPT_DEBUG
                || !debug.debug || debug.simd != SIMD_SCALARIZE || debug.vectorize
                || debug.float_reassoc) { code = 1; }
            if (!str_equals(idstr(?itn, release.name), "release") || release.is_default
                || release.opt != MOPT_RELEASE
                || release.debug || release.simd != SIMD_SCALARIZE || !release.vectorize
                || release.float_reassoc) { code = 1; }

            val omitted: R.Result[ResolvedProfile, str] = resolve_profile(?alloc, ?itn, ?m, "");
            val explicit: R.Result[ResolvedProfile, str] = resolve_profile(?alloc, ?itn, ?m, "release");
            if (R.is_err[ResolvedProfile, str](omitted) || R.is_err[ResolvedProfile, str](explicit)) { code = 1; }
            or {
                if (!str_equals(idstr(?itn, R.unwrap_ok[ResolvedProfile, str](omitted).name), "debug")) { code = 1; }
                if (!str_equals(idstr(?itn, R.unwrap_ok[ResolvedProfile, str](explicit).name), "release")) { code = 1; }
            }
        }
    }

    val sole: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.ship]\nopt=2\ndebug=false\nsimd=\"scalarize\"\n"));
    if (R.is_err[Manifest, str](sole)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](sole);
        if (m.profile_count != 1 || m.profiles[0].is_default) { code = 1; }
        val omitted: R.Result[ResolvedProfile, str] = resolve_profile(?alloc, ?itn, ?m, "");
        val builtin: R.Result[ResolvedProfile, str] = resolve_profile(?alloc, ?itn, ?m, "debug");
        if (R.is_err[ResolvedProfile, str](omitted)
            || !str_equals(idstr(?itn, R.unwrap_ok[ResolvedProfile, str](omitted).name), "ship")) { code = 1; }
        if (R.is_ok[ResolvedProfile, str](builtin)) { code = 1; }
    }

    val selected: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.first]\nopt=0\ndebug=true\nsimd=\"scalarize\"\n[profile.chosen]\ndefault=true\nopt=2\ndebug=false\nsimd=\"scalarize\"\n"));
    if (R.is_err[Manifest, str](selected)) { code = 1; }
    or {
        var m: Manifest = R.unwrap_ok[Manifest, str](selected);
        val omitted: R.Result[ResolvedProfile, str] = resolve_profile(?alloc, ?itn, ?m, "");
        val explicit: R.Result[ResolvedProfile, str] = resolve_profile(?alloc, ?itn, ?m, "first");
        if (R.is_err[ResolvedProfile, str](omitted) || R.is_err[ResolvedProfile, str](explicit)) { code = 1; }
        or {
            if (!str_equals(idstr(?itn, R.unwrap_ok[ResolvedProfile, str](omitted).name), "chosen")) { code = 1; }
            if (!str_equals(idstr(?itn, R.unwrap_ok[ResolvedProfile, str](explicit).name), "first")) { code = 1; }
        }
    }

    val missing: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.a]\nopt=0\ndebug=true\nsimd=\"scalarize\"\n[profile.b]\nopt=2\ndebug=false\nsimd=\"scalarize\"\n"));
    if (R.is_err[Manifest, str](missing)) { code = 1; }
    or {
        var mm: Manifest = R.unwrap_ok[Manifest, str](missing);
        val omitted_sel: R.Result[ResolvedProfile, str] = resolve_profile(?alloc, ?itn, ?mm, "");
        if (R.is_err[ResolvedProfile, str](omitted_sel)
            || !R.unwrap_ok[ResolvedProfile, str](omitted_sel).legacy_default
            || !str_equals(idstr(?itn, R.unwrap_ok[ResolvedProfile, str](omitted_sel).name), idstr(?itn, mm.profiles[0].name))) { code = 1; }
        val explicit_sel: R.Result[ResolvedProfile, str] = resolve_profile(?alloc, ?itn, ?mm, "a");
        if (R.is_err[ResolvedProfile, str](explicit_sel)) { code = 1; }
        or {
            if (!str_equals(idstr(?itn, R.unwrap_ok[ResolvedProfile, str](explicit_sel).name), "a")) { code = 1; }
        }
    }

    val repeated: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.a]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\n[profile.b]\ndefault=true\nopt=2\ndebug=false\nsimd=\"scalarize\"\n"));
    if (R.is_ok[Manifest, str](repeated)
        || !str_contains(R.unwrap_err[Manifest, str](repeated), "exactly one is allowed")) { code = 1; }

    val typed: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.a]\ndefault=\"yes\"\nopt=0\ndebug=true\nsimd=\"scalarize\"\n"));
    if (R.is_ok[Manifest, str](typed)
        || !str_contains(R.unwrap_err[Manifest, str](typed), "default must be a boolean")) { code = 1; }

    val source: R.Result[Manifest, str] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.a]\nopt=0\n[profile.b]\nopt=2\n"));
    if (R.is_err[Manifest, str](source)) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:subsystem_optional_and_console" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val art:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";

    val a: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, art));
    if (R.is_err[Manifest, str](a)) { code = 1; }
    or { if (R.unwrap_ok[Manifest, str](a).artifacts[0].subsystem != of.SUBSYSTEM_CONSOLE) { code = 1; } }

    val b: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, art, "subsystem=\"gui\"\n"));
    if (R.is_err[Manifest, str](b)) { code = 1; }
    or { if (R.unwrap_ok[Manifest, str](b).artifacts[0].subsystem != of.SUBSYSTEM_GUI) { code = 1; } }

    val c: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, art, "subsystem=\"console\"\n"));
    if (R.is_err[Manifest, str](c)) { code = 1; }
    or { if (R.unwrap_ok[Manifest, str](c).artifacts[0].subsystem != of.SUBSYSTEM_CONSOLE) { code = 1; } }

    val d: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, art, "subsystem=\"windows\"\n"));
    if (R.is_ok[Manifest, str](d) || !str_contains(R.unwrap_err[Manifest, str](d), "subsystem must be \"console\" or \"gui\"")) { code = 1; }

    val e: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, art, "subsystem=2\n"));
    if (R.is_ok[Manifest, str](e) || !str_contains(R.unwrap_err[Manifest, str](e), "subsystem must be \"console\" or \"gui\"")) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:artifact_resource_keys_validated" {
    var backing: A.Allocator; var ar: arena.Arena; var alloc: A.Allocator; var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val bin:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app.exe\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";

    val absent: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, bin));
    if (R.is_err[Manifest, str](absent)) { code = 1; }
    or {
        val a: ArtifactDef = R.unwrap_ok[Manifest, str](absent).artifacts[0];
        if (a.icon != intern.STR_NIL || a.app_manifest != intern.STR_NIL) { code = 1; }
    }

    val valid: R.Result[Manifest, str] = tparse(?alloc, ?itn,
        sfmt(?alloc, "{}{}{}", head, bin, "icon=\"assets/app.ico\"\nmanifest=\"assets/app.manifest\"\n"));
    if (R.is_err[Manifest, str](valid)) { code = 1; }
    or {
        val a: ArtifactDef = R.unwrap_ok[Manifest, str](valid).artifacts[0];
        val io: O.Option[str] = intern.lookup(?itn, a.icon);
        val mo: O.Option[str] = intern.lookup(?itn, a.app_manifest);
        if (O.is_none[str](io) || !str_equals(O.unwrap[str](io), "assets/app.ico")) { code = 1; }
        if (O.is_none[str](mo) || !str_equals(O.unwrap[str](mo), "assets/app.manifest")) { code = 1; }
    }

    val empty_icon: R.Result[Manifest, str] = tparse(?alloc, ?itn,
        sfmt(?alloc, "{}{}{}", head, bin, "icon=\"\"\n"));
    if (R.is_ok[Manifest, str](empty_icon)
        || !str_contains(R.unwrap_err[Manifest, str](empty_icon), ".icon must not be empty")) { code = 1; }

    val wrong_manifest: R.Result[Manifest, str] = tparse(?alloc, ?itn,
        sfmt(?alloc, "{}{}{}", head, bin, "manifest=42\n"));
    if (R.is_ok[Manifest, str](wrong_manifest)
        || !str_contains(R.unwrap_err[Manifest, str](wrong_manifest), ".manifest must be a non-empty path string")) { code = 1; }

    val backslash: R.Result[Manifest, str] = tparse(?alloc, ?itn,
        sfmt(?alloc, "{}{}{}", head, bin, "icon=\"assets\\\\app.ico\"\n"));
    if (R.is_ok[Manifest, str](backslash)
        || !str_contains(R.unwrap_err[Manifest, str](backslash), "manifest paths use '/'")) { code = 1; }

    val static_art: str = "[artifact.lib]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/x.a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\nicon=\"assets/app.ico\"\n";
    val irrelevant: R.Result[Manifest, str] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, static_art));
    if (R.is_ok[Manifest, str](irrelevant)
        || !str_contains(R.unwrap_err[Manifest, str](irrelevant), "apply only to kind = \"bin\" artifacts")) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

