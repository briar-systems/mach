test "mach.lang.manifest.resolve_build_unit:native_resolution_zero_target" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = "[project]\nid = \"x\"\nversion = \"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";

    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest = res_manifest.ok;
        if (m.target_count != 0) { code = 1; }

        val ue: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("", "", "app", false, true));
        if (sel ue.err) { code = 1; }

        val u: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("native", "", "app", false, true));
        if (sel u.err) { code = 1; }
        if (sel u.ok) {
            val bu: BuildUnit = u.ok;
            if (bu.warned)                                             { code = 1; }
            if (!str_equals(idstr(?itn, bu.target_name), "native"))    { code = 1; }
            if (!str_equals(idstr(?itn, bu.target.isa), host_isa_name())) { code = 1; }
            if (!str_equals(idstr(?itn, bu.target.os),  host_os_name())) { code = 1; }
            if (!str_equals(idstr(?itn, bu.target.abi), abi.abi_name_for(tgt.host_abi_id()))) { code = 1; }
            if (!str_equals(idstr(?itn, bu.obj_root), "out/native/obj")) { code = 1; }
        }

        val uf: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("foreign", "", "app", false, true));
        if (!(sel uf.err && str_contains(outcome.describe(uf.err), "no target named"))) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:collision_detection" {
    var backing: A.Allocator;
    var ar: arena.Arena;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"0.1.0\"\nsrc=\"src\"\nout=\"bin/app\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.a]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[artifact.b]\nkind=\"bin\"\nentry=\"b.mach\"\nout=\"app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest = res_manifest.ok;
        var v: TmplVars = tmpl_vars_of(?itn, ?m.targets[0], "debug");
        val cr: err[outcome.Fail] = t_check_collisions(?alloc, ?itn, ?m, ?v);
        if (!(sel cr.err && str_equals(outcome.describe(cr.err), "mach.toml: artifacts 'a' and 'b' collide on output path 'bin/app/app'"))) { code = 1; }
    }

    val res_clean: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"0.1.0\"\nsrc=\"src\"\nout=\"out/{target.name}/{profile.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app1\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[artifact.tool]\nkind=\"bin\"\nentry=\"tool.mach\"\nout=\"bin/app2\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel res_clean.err) { code = 1; }
    if (sel res_clean.ok) {
        var m: Manifest = res_clean.ok;
        var v: TmplVars = tmpl_vars_of(?itn, ?m.targets[0], "debug");
        val cr: err[outcome.Fail] = t_check_collisions(?alloc, ?itn, ?m, ?v);
        if (sel cr.err) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:profile_debug_strict" {
    var backing: A.Allocator;
