use std.sync.atomic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use collections_vector: std.collections.vector;

use A:               std.allocator;
use chrono_duration: std.chrono.duration;
use std.chrono.time;

use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use lang_source: mach.lang.source;
use mach.lang.testrun;

# the event stream of every command that reports progress. the build engine and
# the test runner report what happens as it happens, in order, to a sink the
# command supplies, which renders each event when it arrives. lang does no
# terminal i/o: every rendering is the sink's. an event's payload is borrowed for
# the call and is never retained by the stream, except a test run's results,
# which stay in place from run_start to run_end
#
# a phase row is timed from its phase_begin to its phase_end. a phase that runs
# inside another (optimize inside lower) is carved: phase_carved marks it hosted
# and span_end moves each measured span out of the host into it, so no time is
# counted twice. a unit's `other` time is its wall time less every row

# a readout phase, an index into the phase table
pub def Phase: u32;

pub val LOAD:     Phase = 0;
pub val RESOLVE:  Phase = 1;
pub val SEMA:     Phase = 2;
pub val LOWER:    Phase = 3;
pub val OPTIMIZE: Phase = 4;
pub val CODEGEN:  Phase = 5;
pub val EMIT:     Phase = 6;
pub val LINK:     Phase = 7;
pub val CACHE:    Phase = 8;
# a test build's test objects, lowered against their modules' normal objects
pub val TEST_LOWER: Phase = 9;
# a test build's test objects, generated
pub val TEST_CODEGEN: Phase = 10;
# the build steps a project and its dependencies declare
pub val STEPS: Phase = 11;

val PHASE_COUNT: usize = 12;

# what the readout shows of a phase: its row label
rec PhaseSpec {
    label: str;
}

val PHASES: [PHASE_COUNT]PhaseSpec = [PHASE_COUNT]PhaseSpec{
    PhaseSpec{label: "load"},
    PhaseSpec{label: "resolve"},
    PhaseSpec{label: "sema"},
    PhaseSpec{label: "lower"},
    PhaseSpec{label: "optimize"},
    PhaseSpec{label: "codegen"},
    PhaseSpec{label: "emit"},
    PhaseSpec{label: "link"},
    PhaseSpec{label: "cache"},
    PhaseSpec{label: "test lower"},
    PhaseSpec{label: "test codegen"},
    PhaseSpec{label: "steps"},
};

# the row label of phase ph
pub fun label_of(ph: Phase) str {
    ret PHASES[ph].label;
}

# what a sink asks to receive. every level receives the unit, failure,
# diagnostics and test run events; phases adds the phase rows and the unit
# summary, items adds one event per module or file a phase processed. a test
# renderer reads the level for how much of each test it shows
pub val LEVEL_RESULTS: u8 = 0;
pub val LEVEL_PHASES:  u8 = 1;
pub val LEVEL_ITEMS:   u8 = 2;

# a unit of the plan starts: what its goal calls the work (`building`,
# `checking`), the artifact, the target and the profile
pub rec Unit {
    artifact: str;
    target:   str;
    profile:  str;
    verb:     str;
}

# a phase row closes: the count it processed, in the noun that counts it, its
# time, the workers it ran on, the modules it dropped as target-gated, and under
# LEVEL_ITEMS its slowest item, nil when it had fewer than two
pub rec PhaseEnd {
    phase:           Phase;
    count:           u32;
    noun_one:        str;
    noun_many:       str;
    elapsed:         chrono_duration.Duration;
    workers:         u32;
    dropped:         u32;
    slowest:         str;
    slowest_elapsed: chrono_duration.Duration;
}

# one module or file a phase finished, when it finished
pub rec Item {
    phase:   Phase;
    name:    str;
    elapsed: chrono_duration.Duration;
}

# a unit built its output: the path, the modules in it, its size in bytes when
# the output is one file, the time no row accounts for, and the unit's wall time
pub rec Summary {
    out:      str;
    modules:  u32;
    bytes:    usize;
    has_size: bool;
    other:    chrono_duration.Duration;
    total:    chrono_duration.Duration;
}

# a failure that reached no diagnostic store, and the phase it is reported under
rec Failure {
    fail:   *fail.Fail;
    origin: diagnostic.Origin;
}

# a unit's diagnostics with the sources they point into
rec Diagnostics {
    sources: *lang_source.SourceMap;
    diags:   *diagnostic.DiagnosticStore;
}

# one test's result, filled in place when the test finishes. log is the file its
# captured output is kept in, nil when none could be named. launch is the command
# the test was launched through, its runner's words and the program before the
# test's index, nil when the program ran itself
pub rec TestResult {
    art:       *testrun.TestArtifact;
    done:      bool;
    result:    testrun.GateResult;
    code:      i32;
    elapsed:   chrono_duration.Duration;
    bound:     chrono_duration.Duration;
    out:       *u8;
    out_len:   usize;
    truncated: bool;
    log:       str;
    launch:    str;
}

# a test run starts over count tests in collection order, each with its art set
# and none done. tests stays valid and in place until the run's run_end, so a
# renderer may read every result as it finishes
pub rec RunStart {
    tests: *TestResult;
    count: u32;
}

# the test at position at of the run finished, whatever its outcome
rec TestEnd {
    tests: *TestResult;
    at:    u32;
}

# a test run ended: its results in collection order, the counts of passed,
# failed, skipped and timed-out tests, the run's wall time, and the gate tally
# over every result
pub rec RunEnd {
    tests:     *TestResult;
    count:     u32;
    passed:    u32;
    failed:    u32;
    skipped:   u32;
    timed_out: u32;
    wall:      chrono_duration.Duration;
    tally:     *testrun.GateTally;
}

# a growing cycle of instances being expanded: the module that declares its templates,
# the templates on it, and how many instances of it the module being typed has made
pub rec Growth {
    module:    str;
    members:   str;
    instances: u32;
}

# one event of a command, in the order it happened. a new kind is a new member
# here and a new arm in each renderer, which skips a member it does not render
pub tag Event: u8 {
    unit:        Unit;
    phase:       PhaseEnd;
    item:        Item;
    summary:     Summary;
    failure:     Failure;
    diagnostics: Diagnostics;
    run_start:   RunStart;
    test_end:    TestEnd;
    run_end:     RunEnd;
    growth:      Growth;
}

# where a build's events go: on_event is called once per event, in order, never
# from two threads at once, and may be called from a worker thread. level is
# what the sink asks to receive
pub rec Sink {
    ctx:      ptr;
    on_event: fun(ptr, *Event);
    level:    u8;
}

fun wants(sink: *Sink, level: u8) bool {
    ret sink != nil && sink.level >= level;
}

fun deliver(sink: *Sink, ev: Event) {
    var e: Event = ev;
    sink.on_event(sink.ctx, ?e);
}

# a unit starts; a nil sink is a no-op
pub fun unit(sink: *Sink, artifact: str, target: str, profile: str, verb: str) {
    if (sink == nil) { ret; }
    deliver(sink, Event.unit{Unit{artifact: artifact, target: target, profile: profile, verb: verb}});
}

# a failure reached no store; a nil sink is a no-op
pub fun failure(sink: *Sink, f: *fail.Fail, origin: diagnostic.Origin) {
    if (sink == nil) { ret; }
    deliver(sink, Event.failure{Failure{fail: f, origin: origin}});
}

# a unit's diagnostics, sent when it has any; a nil sink is a no-op
pub fun diagnostics(sink: *Sink, sources: *lang_source.SourceMap, diags: *diagnostic.DiagnosticStore) {
    if (sink == nil)                                                     { ret; }
    if (diagnostic.len(diags) == 0 && diagnostic.lost_count(diags) == 0) { ret; }
    deliver(sink, Event.diagnostics{Diagnostics{sources: sources, diags: diags}});
}

# a growing cycle expanded to `instances` instances, sent under the phase readout; a nil
# sink is a no-op
pub fun growth(sink: *Sink, module: str, members: str, instances: u32) {
    if (!wants(sink, LEVEL_PHASES)) { ret; }
    deliver(sink, Event.growth{Growth{module: module, members: members, instances: instances}});
}

# a test run starts; a nil sink is a no-op
pub fun run_start(sink: *Sink, tests: *TestResult, count: u32) {
    if (sink == nil) { ret; }
    deliver(sink, Event.run_start{RunStart{tests: tests, count: count}});
}

# the test at position at finished, its result filled and marked done; a nil
# sink is a no-op
pub fun test_end(sink: *Sink, tests: *TestResult, at: u32) {
    if (sink == nil) { ret; }
    deliver(sink, Event.test_end{TestEnd{tests: tests, at: at}});
}

# a test run ended; a nil sink is a no-op
pub fun run_end(sink: *Sink, end: RunEnd) {
    if (sink == nil) { ret; }
    deliver(sink, Event.run_end{end});
}

# an instant a readout measures from: absent when the platform clock refused
# the sample, so a duration measured from it is zero rather than invented
pub def Instant: opt[time.Instant];

# the instant now, or none when the clock refused
pub fun sample() Instant {
    val c: time.InstantClock = time.instant();
    if (sel c.ok) { ret Instant.some{c.ok}; }
    ret Instant.none{};
}

# the time since start, zero when either sample is absent
pub fun elapsed(start: Instant) chrono_duration.Duration {
    if (sel start.none) { ret 0; }
    val c: time.InstantClock = time.instant();
    if (sel c.err) { ret 0; }
    ret time.instant_sub(c.ok, start.some);
}

rec PhaseState {
    started:         Instant;
    carved:          chrono_duration.Duration;
    borrowed:        chrono_duration.Duration;
    hosted:          bool;
    workers:         u32;
    dropped:         u32;
    items:           u32;
    slowest:         str;
    slowest_elapsed: chrono_duration.Duration;
}

# an item a worker thread posted, and whether it is ready to deliver
rec Posted {
    item:  Item;
    ready: i64;
}

# one unit's phase rows, timed as they run and sent to the sink as each closes.
# a parallel section's workers post their items to a queue that whichever
# thread holds the drain delivers, so a worker never waits on the sink. a run
# that shows no readout has no progress, and every phase, span and item given a
# nil one is not shown
pub rec Progress {
    sink:       *Sink;
    unit_start: Instant;
    unit_rows:  chrono_duration.Duration;
    phases:     [PHASE_COUNT]PhaseState;
    posted:     *Posted;
    post_cap:   usize;
    post_tail:  i64;
    post_head:  usize;
    draining:   i64;
}

# start a unit's progress over sink, timed from now
# ---
# pr:   the storage, which must outlive every use of the returned pointer
# sink: the command's sink, or nil
# ret:  pr, or nil when the sink takes no phase rows, which every phase call reads as none
pub fun start(pr: *Progress, sink: *Sink) *Progress {
    if (!wants(sink, LEVEL_PHASES)) { ret nil; }
    pr.sink       = sink;
    pr.unit_start = sample();
    pr.unit_rows  = 0;
    pr.posted     = nil;
    pr.post_cap   = 0;
    pr.post_tail  = 0;
    pr.post_head  = 0;
    pr.draining   = 0;
    var i: usize = 0;
    for (i < PHASE_COUNT) {
        phase_reset(?pr.phases[i]);
        pr.phases[i].started = Instant.none{};
        i                    = i + 1;
    }
    ret pr;
}

fun phase_reset(p: *PhaseState) {
    p.carved          = 0;
    p.borrowed        = 0;
    p.hosted          = false;
    p.workers         = 1;
    p.dropped         = 0;
    p.items           = 0;
    p.slowest         = nil;
    p.slowest_elapsed = 0;
}

# phase ph's row opens now; its time runs to phase_end, less what is carved out of it
pub fun phase_begin(pr: *Progress, ph: Phase) {
    if (pr == nil) { ret; }
    val p: *PhaseState = ?pr.phases[ph];
    phase_reset(p);
    p.started = sample();
}

# phase ph runs inside another phase and is timed by the spans moved into it
pub fun phase_carved(pr: *Progress, ph: Phase) {
    if (pr == nil) { ret; }
    pr.phases[ph].hosted = true;
}

# phase ph dropped n modules as target-gated
pub fun phase_dropped(pr: *Progress, ph: Phase, n: u32) {
    if (pr == nil) { ret; }
    pr.phases[ph].dropped = n;
}

# the start of a span that span_end moves into a hosted phase
pub fun span_begin(pr: *Progress) Instant {
    if (pr == nil) { ret Instant.none{}; }
    ret sample();
}

# the span from start belongs to ph, and leaves the phase host that ran it
pub fun span_end(pr: *Progress, ph: Phase, host: Phase, start: Instant) {
    if (pr == nil) { ret; }
    val d: chrono_duration.Duration = elapsed(start);
    val c: *PhaseState              = ?pr.phases[ph];
    c.borrowed = c.borrowed + d;
    c.hosted   = true;
    val h: *PhaseState = ?pr.phases[host];
    h.carved = h.carved + d;
}

# the start of an item, sampled only when the sink takes items
pub fun item_begin(pr: *Progress) Instant {
    if (!item_wanted(pr)) { ret Instant.none{}; }
    ret sample();
}

fun item_wanted(pr: *Progress) bool {
    ret pr != nil && pr.sink.level >= LEVEL_ITEMS;
}

# name finished phase ph, measured from start
pub fun item(pr: *Progress, ph: Phase, name: str, start: Instant) {
    if (!item_wanted(pr)) { ret; }
    item_send(pr, Item{phase: ph, name: name, elapsed: elapsed(start)});
}

fun item_send(pr: *Progress, it: Item) {
    val p: *PhaseState = ?pr.phases[it.phase];
    p.items = p.items + 1;
    if (p.slowest == nil || it.elapsed > p.slowest_elapsed) {
        p.slowest         = it.name;
        p.slowest_elapsed = it.elapsed;
    }
    deliver(pr.sink, Event.item{it});
}

# open the item queue of a parallel section that posts at most n items. the
# queue's storage is drawn from a and returned by workers_end
pub fun workers_begin(pr: *Progress, a: *A.Allocator, n: usize) err[fail.Fail] {
    if (!item_wanted(pr) || n == 0) { ret err[fail.Fail].ok{}; }
    val allocated: res[*Posted, A.Error] = A.zallocate[Posted](a, n);
    if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
    pr.posted    = allocated.ok;
    pr.post_cap  = n;
    pr.post_tail = 0;
    pr.post_head = 0;
    pr.draining  = 0;
    ret err[fail.Fail].ok{};
}

# a worker thread's item: queued, then delivered by this thread unless another
# holds the drain, which then delivers it. name must outlive the section
pub fun item_post(pr: *Progress, ph: Phase, name: str, d: chrono_duration.Duration) {
    if (pr == nil || pr.posted == nil) { ret; }
    val at: i64 = atomic.fetch_add(?pr.post_tail, 1::i64);
    if (at < 0 || at >= pr.post_cap::i64) { ret; }
    val slot: *Posted = ?pr.posted[at::usize];
    slot.item = Item{phase: ph, name: name, elapsed: d};
    atomic.store(?slot.ready, 1::i64);
    drain(pr);
}

# deliver every ready item in post order. a poster that finds the drain held
# leaves its item to the holder, which looks again after letting go
fun drain(pr: *Progress) {
    for (true) {
        var expected: i64 = 0;
        if (!atomic.cas(?pr.draining, ?expected, 1::i64)) { ret; }
        for (pr.post_head < pr.post_cap && atomic.load(?pr.posted[pr.post_head].ready) != 0) {
            item_send(pr, pr.posted[pr.post_head].item);
            pr.post_head = pr.post_head + 1;
        }
        atomic.store(?pr.draining, 0::i64);
        if (pr.post_head >= pr.post_cap)                      { ret; }
        if (atomic.load(?pr.posted[pr.post_head].ready) == 0) { ret; }
    }
}

# close a parallel section of phase ph that ran on n workers, after every worker
# has joined: every posted item still queued is delivered and the queue's storage
# returned
pub fun workers_end(pr: *Progress, a: *A.Allocator, ph: Phase, n: u32) {
    if (pr == nil) { ret; }
    pr.phases[ph].workers = n;
    if (pr.posted == nil) { ret; }
    # a worker that stopped before posting its claimed slot leaves a gap the drain waits at
    for (pr.post_head < pr.post_cap) {
        if (atomic.load(?pr.posted[pr.post_head].ready) != 0) { item_send(pr, pr.posted[pr.post_head].item); }
        pr.post_head = pr.post_head + 1;
    }
    A.deallocate[Posted](a, pr.posted, pr.post_cap);
    pr.posted   = nil;
    pr.post_cap = 0;
}

# close phase ph's row: count is what it processed, named by noun_one or noun_many
pub fun phase_end(pr: *Progress, ph: Phase, count: u32, noun_one: str, noun_many: str) {
    if (pr == nil) { ret; }
    val p:     *PhaseState              = ?pr.phases[ph];
    var spent: chrono_duration.Duration = elapsed(p.started) - p.carved;
    if (p.hosted)  { spent = p.borrowed; }
    if (spent < 0) { spent = 0; }
    pr.unit_rows = pr.unit_rows + spent;

    var slowest: str = nil;
    if (p.items >= 2 && p.slowest_elapsed > 0) { slowest = p.slowest; }
    deliver(pr.sink, Event.phase{PhaseEnd{phase: ph, count: count, noun_one: noun_one, noun_many: noun_many,
        elapsed: spent, workers: p.workers, dropped: p.dropped, slowest: slowest, slowest_elapsed: p.slowest_elapsed}});
}

# the unit built out: the time no row accounts for floors at zero
pub fun summary(pr: *Progress, out: str, modules: u32, bytes: usize, has_size: bool) {
    if (pr == nil) { ret; }
    val total: chrono_duration.Duration = elapsed(pr.unit_start);
    var other: chrono_duration.Duration = total - pr.unit_rows;
    if (other < 0) { other = 0; }
    deliver(pr.sink, Event.summary{Summary{out: out, modules: modules, bytes: bytes, has_size: has_size,
        other: other, total: total}});
}
