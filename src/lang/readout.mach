use std.allocator.page;
use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use std.text.string.str_dup;
use std.text.string.str_free;

use std.collections.vector;
use std.collections.vector.Vector;

use A: std.allocator;
use R: std.types.result;
use ctime: std.chrono.time;
use cdur:  std.chrono.duration;

pub val PH_LOAD:     u8 = 0;
pub val PH_RESOLVE:  u8 = 1;
pub val PH_SEMA:     u8 = 2;
pub val PH_LOWER:    u8 = 3;
pub val PH_OPTIMIZE: u8 = 4;
pub val PH_CODEGEN:  u8 = 5;
pub val PH_EMIT:     u8 = 6;
pub val PH_LINK:     u8 = 7;

val PHASE_COUNT: u32 = 8;

pub val LEVEL_PHASES: u8 = 1;
pub val LEVEL_ITEMS:  u8 = 2;

val DUR_CAP: usize = 24;

pub fun phase_valid(ph: u8) bool {
    ret ph::u32 < PHASE_COUNT;
}

rec PendingItem {
    name: str;
    elapsed: cdur.Duration;
}

rec PhaseState {
    items:    Vector[PendingItem];
    started:  ctime.Time;
    carved:   cdur.Duration;
    borrowed: cdur.Duration;
    hosted:   bool;
    workers:  u32;
    dropped:  u32;
}

pub rec PhaseMetrics {
    elapsed:      cdur.Duration;
    occurrences:  u32;
    item_elapsed: cdur.Duration;
    item_count:   u32;
    workers:      u32;
    processed:    u32;
    dropped:      u32;
}

pub def ProgressEventKind: u8;

pub val PROGRESS_EVENT_PHASE:   ProgressEventKind = 0;
pub val PROGRESS_EVENT_ITEM:    ProgressEventKind = 1;
pub val PROGRESS_EVENT_SUMMARY: ProgressEventKind = 2;

pub rec PhaseEvent {
    phase:     u8;
    count:     u32;
    noun_one:  str;
    noun_many: str;
    elapsed:   cdur.Duration;
    workers:   u32;
    dropped:   u32;
}

pub rec ItemEvent {
    phase:   u8;
    name:    str;
    elapsed: cdur.Duration;
    slow:    bool;
}

pub rec SummaryEvent {
    out:      str;
    modules:  u32;
    size:     i64;
    unit:     str;
    has_size: bool;
    other:    cdur.Duration;
    total:    cdur.Duration;
}

pub rec ProgressEvent {
    kind: ProgressEventKind;
    data: uni {
        phase:   PhaseEvent;
        item:    ItemEvent;
        summary: SummaryEvent;
    };
}

pub rec Progress {
    level:      u8;
    alloc:      *A.Allocator;
    unit_start: ctime.Time;
    unit_rows:  cdur.Duration;
    phases:     [PHASE_COUNT]PhaseState;
    metrics:    [PHASE_COUNT]PhaseMetrics;
    events:     Vector[ProgressEvent];
    other:      cdur.Duration;
    incomplete: bool;
}

pub fun init(pr: *Progress, alloc: *A.Allocator, level: u8) {
    pr.level      = level;
    pr.alloc      = alloc;
    pr.unit_start = ctime.monotonic();
    pr.unit_rows  = 0;
    pr.events     = vector.init[ProgressEvent](alloc);
    pr.other      = 0;
    pr.incomplete = false;
    var i: u32 = 0;
    for (i < PHASE_COUNT) {
        val p: *PhaseState = ?pr.phases[i];
        p.items    = vector.init[PendingItem](alloc);
        p.started  = ctime.Time{sec: 0, nsec: 0};
        p.carved   = 0;
        p.borrowed = 0;
        p.hosted   = false;
        p.workers  = 1;
        p.dropped  = 0;
        val m: *PhaseMetrics = ?pr.metrics[i];
        m.elapsed      = 0;
        m.occurrences  = 0;
        m.item_elapsed = 0;
        m.item_count   = 0;
        m.workers      = 1;
        m.processed    = 0;
        m.dropped      = 0;
        i = i + 1;
    }
}

pub fun dnit(pr: *Progress) {
    if (pr == nil || pr.alloc == nil) { ret; }
    var i: u32 = 0;
    for (i < PHASE_COUNT) {
        free_pending(pr, ?pr.phases[i]);
        vector.dnit[PendingItem](?pr.phases[i].items);
        i = i + 1;
    }

    var j: usize = 0;
    for (j < pr.events.len) {
        free_event(pr, ?pr.events.data[j]);
        j = j + 1;
    }
    vector.dnit[ProgressEvent](?pr.events);
    pr.alloc = nil;
}

pub fun progress_valid(pr: *Progress) bool {
    ret pr != nil && pr.alloc != nil;
}

pub fun unit_begin(pr: *Progress) {
    if (!progress_valid(pr)) { ret; }
    pr.unit_start = ctime.monotonic();
    pr.unit_rows  = 0;
}

pub fun phase_begin(pr: *Progress, ph: u8) {
    if (!progress_valid(pr) || !phase_valid(ph)) { ret; }
    val p: *PhaseState = ?pr.phases[ph];
    free_pending(pr, p);
    p.carved   = 0;
    p.borrowed = 0;
    p.hosted   = false;
    p.workers  = 1;
    p.dropped  = 0;
    p.started  = ctime.monotonic();
}

pub fun phase_carved(pr: *Progress, ph: u8) {
    if (!progress_valid(pr) || !phase_valid(ph)) { ret; }
    pr.phases[ph].hosted = true;
}

pub fun phase_workers(pr: *Progress, ph: u8, n: u32) {
    if (!progress_valid(pr) || !phase_valid(ph)) { ret; }
    pr.phases[ph].workers = n;
}

pub fun phase_dropped(pr: *Progress, ph: u8, n: u32) {
    if (!progress_valid(pr) || !phase_valid(ph)) { ret; }
    pr.phases[ph].dropped = n;
}

pub fun span_begin(pr: *Progress) ctime.Time {
    if (!progress_valid(pr)) { ret ctime.Time{sec: 0, nsec: 0}; }
    ret ctime.monotonic();
}

pub fun span_end(pr: *Progress, ph: u8, host: u8, start: ctime.Time) {
    if (!progress_valid(pr) || !phase_valid(ph) || !phase_valid(host)) { ret; }
    val d: cdur.Duration = ctime.time_sub(ctime.monotonic(), start);
    val c: *PhaseState = ?pr.phases[ph];
    c.borrowed = c.borrowed + d;
    c.hosted   = true;
    val h: *PhaseState = ?pr.phases[host];
    h.carved = h.carved + d;
}

pub fun item_begin(pr: *Progress) ctime.Time {
    if (!progress_valid(pr)) { ret ctime.Time{sec: 0, nsec: 0}; }
    ret ctime.monotonic();
}

pub fun item(pr: *Progress, ph: u8, name: str, start: ctime.Time) {
    if (!progress_valid(pr) || !phase_valid(ph)) { ret; }
    item_dur(pr, ph, name, ctime.time_sub(ctime.monotonic(), start));
}

pub fun item_dur(pr: *Progress, ph: u8, name: str, d: cdur.Duration) {
    if (!progress_valid(pr) || !phase_valid(ph)) { ret; }
    val m: *PhaseMetrics = ?pr.metrics[ph::u32];
    m.item_elapsed = m.item_elapsed + d;
    m.item_count   = m.item_count + 1;
    if (pr.level < LEVEL_ITEMS) { ret; }

    val dup_r: R.Result[str, str] = str_dup(pr.alloc, name);
    if (R.is_err[str, str](dup_r)) { pr.incomplete = true; ret; }
    var it: PendingItem;
    it.name    = R.unwrap_ok[str, str](dup_r);
    it.elapsed = d;
    val push_r: R.Result[usize, str] = vector.push[PendingItem](?pr.phases[ph].items, it);
    if (R.is_err[usize, str](push_r)) {
        str_free(pr.alloc, it.name);
        pr.incomplete = true;
    }
}

pub fun phase_end(pr: *Progress, ph: u8, count: u32, noun_one: str, noun_many: str) {
    if (!progress_valid(pr) || !phase_valid(ph)) { ret; }
    val p: *PhaseState = ?pr.phases[ph];
    var elapsed: cdur.Duration = ctime.time_sub(ctime.monotonic(), p.started) - p.carved;
    if (p.hosted) { elapsed = p.borrowed; }
    if (elapsed < 0) { elapsed = 0; }

    val m: *PhaseMetrics = ?pr.metrics[ph::u32];
    m.elapsed     = m.elapsed + elapsed;
    m.occurrences = m.occurrences + 1;
    m.processed   = m.processed + count;
    m.dropped     = m.dropped + p.dropped;
    if (p.workers > m.workers) { m.workers = p.workers; }
    pr.unit_rows = pr.unit_rows + elapsed;

    if (!record_phase(pr, ph, count, noun_one, noun_many, elapsed, p.workers, p.dropped)) {
        free_pending(pr, p);
        ret;
    }

    val slow: i64 = slowest_index(p);
    var i: usize = 0;
    for (i < p.items.len) {
        val it: *PendingItem = ?p.items.data[i];
        record_item(pr, ph, it.name, it.elapsed, i::i64 == slow);
        it.name = nil;
        i = i + 1;
    }
    vector.clear[PendingItem](?p.items);
}

pub fun summary(pr: *Progress, out: str, modules: u32, size: i64, unit: str, has_size: bool) {
    if (!progress_valid(pr)) { ret; }
    val total: cdur.Duration = ctime.time_sub(ctime.monotonic(), pr.unit_start);
    var other: cdur.Duration = total - pr.unit_rows;
    if (other < 0) { other = 0; }
    pr.other = other;
    record_summary(pr, out, modules, size, unit, has_size, other, total);
}

pub fun render(pr: *Progress) {
    if (!progress_valid(pr)) { ret; }
    var i: usize = 0;
    for (i < pr.events.len) {
        val ev: *ProgressEvent = ?pr.events.data[i];
        if (ev.kind == PROGRESS_EVENT_PHASE)        { render_phase(?ev.data.phase); }
        or (ev.kind == PROGRESS_EVENT_ITEM)         { render_item(?ev.data.item); }
        or (ev.kind == PROGRESS_EVENT_SUMMARY)      { render_summary(?ev.data.summary); }
        i = i + 1;
    }
    if (pr.incomplete) { print.eprintf("progress report incomplete: allocation failed\n"); }
}

pub fun size_split(bytes: usize, unit: *str) i64 {
    val ki: usize = 1024;
    val mi: usize = ki * 1024;
    val gi: usize = mi * 1024;

    if (bytes < ki) {
        @unit = "B";
        ret bytes::i64;
    }
    if (bytes < mi) {
        @unit = "KiB";
        ret ((bytes + ki / 2) / ki)::i64;
    }
    if (bytes < gi) {
        @unit = "MiB";
        ret ((bytes + mi / 2) / mi)::i64;
    }
    @unit = "GiB";
    ret ((bytes + gi / 2) / gi)::i64;
}

fun phase_label(ph: u8) str {
    if (ph == PH_LOAD)     { ret "load"; }
    if (ph == PH_RESOLVE)  { ret "resolve"; }
    if (ph == PH_SEMA)     { ret "sema"; }
    if (ph == PH_LOWER)    { ret "lower"; }
    if (ph == PH_OPTIMIZE) { ret "optimize"; }
    if (ph == PH_CODEGEN)  { ret "codegen"; }
    if (ph == PH_EMIT)     { ret "emit"; }
    ret "link";
}

fun render_phase(ev: *PhaseEvent) {
    var dbuf: [DUR_CAP]u8;
    val dstr: str = cdur.format_duration(ev.elapsed, ?dbuf[0], DUR_CAP);
    var noun: str = ev.noun_many;
    if (ev.count == 1) { noun = ev.noun_one; }
    if (ev.workers > 1) {
        print.eprintf("{:<9} {:3} {:<8} {:7}  ({} threads)\n", phase_label(ev.phase), ev.count::i64, noun, dstr, ev.workers::i64);
    }
    or (ev.dropped > 0) {
        print.eprintf("{:<9} {:3} {:<8} {:7}  ({} target-gated, not carried forward)\n",
                      phase_label(ev.phase), ev.count::i64, noun, dstr, ev.dropped::i64);
    }
    or {
        print.eprintf("{:<9} {:3} {:<8} {:7}\n", phase_label(ev.phase), ev.count::i64, noun, dstr);
    }
}

fun render_item(ev: *ItemEvent) {
    var dbuf: [DUR_CAP]u8;
    val dstr: str = cdur.format_duration(ev.elapsed, ?dbuf[0], DUR_CAP);
    if (ev.slow) { print.eprintf("  {:<32} {:7}  (slow)\n", ev.name, dstr); }
    or         { print.eprintf("  {:<32} {:7}\n", ev.name, dstr); }
}

fun render_summary(ev: *SummaryEvent) {
    var obuf: [DUR_CAP]u8;
    val ostr: str = cdur.format_duration(ev.other, ?obuf[0], DUR_CAP);
    print.eprintf("{:<9} {:<12} {:7}\n", "other", "-", ostr);

    var dbuf: [DUR_CAP]u8;
    val dstr: str = cdur.format_duration(ev.total, ?dbuf[0], DUR_CAP);
    var mnoun: str = "modules";
    if (ev.modules == 1) { mnoun = "module"; }
    if (ev.has_size) {
        print.eprintf("built {}  {} {}  {} {}  in {}\n", ev.out, ev.modules::i64, mnoun, ev.size, ev.unit, dstr);
    }
    or {
        print.eprintf("built {}  {} {}  in {}\n", ev.out, ev.modules::i64, mnoun, dstr);
    }
}

fun slowest_index(p: *PhaseState) i64 {
    if (p.items.len < 2) { ret -1; }
    var best: usize = 0;
    var i: usize = 1;
    for (i < p.items.len) {
        if (p.items.data[i].elapsed > p.items.data[best].elapsed) { best = i; }
        i = i + 1;
    }
    if (p.items.data[best].elapsed <= 0) { ret -1; }
    ret best::i64;
}

fun record_phase(pr: *Progress, ph: u8, count: u32, noun_one: str, noun_many: str,
                 elapsed: cdur.Duration, workers: u32, dropped: u32) bool {
    val one_r: R.Result[str, str] = str_dup(pr.alloc, noun_one);
    if (R.is_err[str, str](one_r)) { pr.incomplete = true; ret false; }
    val one: str = R.unwrap_ok[str, str](one_r);

    val many_r: R.Result[str, str] = str_dup(pr.alloc, noun_many);
    if (R.is_err[str, str](many_r)) {
        str_free(pr.alloc, one);
        pr.incomplete = true;
        ret false;
    }

    var ev: ProgressEvent;
    ev.kind                 = PROGRESS_EVENT_PHASE;
    ev.data.phase.phase     = ph;
    ev.data.phase.count     = count;
    ev.data.phase.noun_one  = one;
    ev.data.phase.noun_many = R.unwrap_ok[str, str](many_r);
    ev.data.phase.elapsed   = elapsed;
    ev.data.phase.workers   = workers;
    ev.data.phase.dropped   = dropped;
    val push_r: R.Result[usize, str] = vector.push[ProgressEvent](?pr.events, ev);
    if (R.is_err[usize, str](push_r)) {
        str_free(pr.alloc, ev.data.phase.noun_one);
        str_free(pr.alloc, ev.data.phase.noun_many);
        pr.incomplete = true;
        ret false;
    }
    ret true;
}

fun record_item(pr: *Progress, ph: u8, name: str, elapsed: cdur.Duration, slow: bool) {
    var ev: ProgressEvent;
    ev.kind              = PROGRESS_EVENT_ITEM;
    ev.data.item.phase   = ph;
    ev.data.item.name    = name;
    ev.data.item.elapsed = elapsed;
    ev.data.item.slow    = slow;
    val push_r: R.Result[usize, str] = vector.push[ProgressEvent](?pr.events, ev);
    if (R.is_err[usize, str](push_r)) {
        str_free(pr.alloc, name);
        pr.incomplete = true;
    }
}

fun record_summary(pr: *Progress, out: str, modules: u32, size: i64, unit: str, has_size: bool,
                   other: cdur.Duration, total: cdur.Duration) {
    val out_r: R.Result[str, str] = str_dup(pr.alloc, out);
    if (R.is_err[str, str](out_r)) { pr.incomplete = true; ret; }
    val out_owned: str = R.unwrap_ok[str, str](out_r);

    val unit_r: R.Result[str, str] = str_dup(pr.alloc, unit);
    if (R.is_err[str, str](unit_r)) {
        str_free(pr.alloc, out_owned);
        pr.incomplete = true;
        ret;
    }

    var ev: ProgressEvent;
    ev.kind                  = PROGRESS_EVENT_SUMMARY;
    ev.data.summary.out      = out_owned;
    ev.data.summary.modules  = modules;
    ev.data.summary.size     = size;
    ev.data.summary.unit     = R.unwrap_ok[str, str](unit_r);
    ev.data.summary.has_size = has_size;
    ev.data.summary.other    = other;
    ev.data.summary.total    = total;
    val push_r: R.Result[usize, str] = vector.push[ProgressEvent](?pr.events, ev);
    if (R.is_err[usize, str](push_r)) {
        str_free(pr.alloc, ev.data.summary.out);
        str_free(pr.alloc, ev.data.summary.unit);
        pr.incomplete = true;
    }
}

fun free_pending(pr: *Progress, p: *PhaseState) {
    var i: usize = 0;
    for (i < p.items.len) {
        if (p.items.data[i].name != nil) { str_free(pr.alloc, p.items.data[i].name); }
        i = i + 1;
    }
    vector.clear[PendingItem](?p.items);
}

fun free_event(pr: *Progress, ev: *ProgressEvent) {
    if (ev.kind == PROGRESS_EVENT_PHASE) {
        str_free(pr.alloc, ev.data.phase.noun_one);
        str_free(pr.alloc, ev.data.phase.noun_many);
    }
    or (ev.kind == PROGRESS_EVENT_ITEM) {
        str_free(pr.alloc, ev.data.item.name);
    }
    or (ev.kind == PROGRESS_EVENT_SUMMARY) {
        str_free(pr.alloc, ev.data.summary.out);
        str_free(pr.alloc, ev.data.summary.unit);
    }
}

test "mach.lang.readout.phase_valid:closed_to_the_eight_declared_phases" {
    if (!phase_valid(PH_LOAD))    { ret 1; }
    if (!phase_valid(PH_LINK))    { ret 2; }
    if (phase_valid(8))           { ret 3; }
    if (phase_valid(255))         { ret 4; }
    ret 0;
}

test "mach.lang.readout.progress_valid:nil_and_uninitialized_recorders_are_invalid" {
    if (progress_valid(nil)) { ret 1; }

    var alloc: A.Allocator;
    page.make(?alloc);
    var pr: Progress;
    pr.alloc = nil;
    if (progress_valid(?pr)) { ret 2; }
    init(?pr, ?alloc, LEVEL_PHASES);
    if (!progress_valid(?pr)) { ret 3; }
    dnit(?pr);
    if (progress_valid(?pr)) { ret 4; }

    ret 0;
}

test "mach.lang.readout.recording:invalid_phase_or_host_does_not_change_owned_state" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var pr: Progress;
    init(?pr, ?alloc, LEVEL_ITEMS);

    phase_begin(?pr, 8);
    phase_carved(?pr, 200);
    item(?pr, 9, "x", ctime.Time{sec: 0, nsec: 0});
    item_dur(?pr, 9, "x", 1);
    phase_end(?pr, 8, 1, "a", "as");
    phase_workers(?pr, 8, 1);
    phase_dropped(?pr, 8, 1);
    span_end(?pr, PH_LOAD, 8, ctime.Time{sec: 0, nsec: 0});
    span_end(?pr, 8, PH_LOAD, ctime.Time{sec: 0, nsec: 0});
    var bad: i32 = 0;
    if (pr.events.len != 0)                          { bad = 1; }
    if (pr.metrics[PH_LOAD::u32].occurrences != 0)  { bad = 1; }
    if (pr.metrics[PH_LOAD::u32].item_count != 0)   { bad = 1; }

    dnit(?pr);
    ret bad;
}

test "mach.lang.readout.aggregation:accumulates_across_multiple_units_not_last_write" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var pr: Progress;
    init(?pr, ?alloc, LEVEL_PHASES);

    unit_begin(?pr);
    phase_begin(?pr, PH_LOAD);
    val s1: ctime.Time = item_begin(?pr);
    item(?pr, PH_LOAD, "m1", s1);
    phase_end(?pr, PH_LOAD, 1, "module", "modules");

    val sentinel: cdur.Duration = 1000000000;
    pr.metrics[PH_LOAD::u32].elapsed = sentinel;

    unit_begin(?pr);
    phase_begin(?pr, PH_LOAD);
    val s2: ctime.Time = item_begin(?pr);
    item(?pr, PH_LOAD, "m2", s2);
    phase_end(?pr, PH_LOAD, 1, "module", "modules");

    var bad: i32 = 0;
    if (pr.metrics[PH_LOAD::u32].occurrences != 2)  { bad = 1; }
    if (pr.metrics[PH_LOAD::u32].item_count != 2)   { bad = 1; }
    if (pr.metrics[PH_LOAD::u32].elapsed < sentinel) { bad = 1; }

    dnit(?pr);
    ret bad;
}

test "mach.lang.readout.aggregation:workers_tracks_the_run_peak_not_the_last_occurrence" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var pr: Progress;
    init(?pr, ?alloc, LEVEL_PHASES);

    unit_begin(?pr);
    phase_begin(?pr, PH_CODEGEN);
    phase_workers(?pr, PH_CODEGEN, 8);
    phase_end(?pr, PH_CODEGEN, 1, "module", "modules");

    unit_begin(?pr);
    phase_begin(?pr, PH_CODEGEN);
    phase_workers(?pr, PH_CODEGEN, 1);
    phase_end(?pr, PH_CODEGEN, 1, "module", "modules");

    var bad: i32 = 0;
    if (pr.metrics[PH_CODEGEN::u32].workers != 8) { bad = 1; }

    dnit(?pr);
    ret bad;
}

test "mach.lang.readout.items:retains_capacity_across_phase_occurrences" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var pr: Progress;
    init(?pr, ?alloc, LEVEL_ITEMS);

    unit_begin(?pr);
    phase_begin(?pr, PH_SEMA);
    val s1: ctime.Time = item_begin(?pr);
    item(?pr, PH_SEMA, "a", s1);
    phase_end(?pr, PH_SEMA, 1, "module", "modules");

    val p: *PhaseState = ?pr.phases[PH_SEMA::u32];
    val cap_after_first: usize = p.items.cap;
    val items_after_first: *PendingItem = p.items.data;
    var bad: i32 = 0;
    if (cap_after_first == 0)     { bad = 1; }
    if (items_after_first == nil) { bad = 1; }
    if (p.items.len != 0)         { bad = 1; }

    phase_begin(?pr, PH_SEMA);
    val s2: ctime.Time = item_begin(?pr);
    item(?pr, PH_SEMA, "b", s2);
    phase_end(?pr, PH_SEMA, 1, "module", "modules");

    if (p.items.cap != cap_after_first)  { bad = 1; }
    if (p.items.data != items_after_first) { bad = 1; }

    dnit(?pr);
    if (p.items.data != nil || p.items.cap != 0) { bad = 1; }
    ret bad;
}

test "mach.lang.readout.events:own_item_and_summary_strings" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var pr: Progress;
    init(?pr, ?alloc, LEVEL_ITEMS);

    val name_r: R.Result[str, str] = str_dup(?alloc, "owned-item");
    if (R.is_err[str, str](name_r)) { dnit(?pr); ret 1; }
    val name: str = R.unwrap_ok[str, str](name_r);
    phase_begin(?pr, PH_LOAD);
    item_dur(?pr, PH_LOAD, name, 7);
    str_free(?alloc, name);
    phase_end(?pr, PH_LOAD, 1, "module", "modules");

    val out_r: R.Result[str, str] = str_dup(?alloc, "owned-out");
    if (R.is_err[str, str](out_r)) { dnit(?pr); ret 1; }
    val out: str = R.unwrap_ok[str, str](out_r);
    summary(?pr, out, 1, 0, "B", false);
    str_free(?alloc, out);

    var bad: i32 = 0;
    if (pr.events.len != 3) { bad = 1; }
    or {
        if (pr.events.data[1].kind != PROGRESS_EVENT_ITEM) { bad = 1; }
        or (!str_equals(pr.events.data[1].data.item.name, "owned-item")) { bad = 1; }
        if (pr.events.data[2].kind != PROGRESS_EVENT_SUMMARY) { bad = 1; }
        or (!str_equals(pr.events.data[2].data.summary.out, "owned-out")) { bad = 1; }
    }

    dnit(?pr);
    ret bad;
}

test "mach.lang.readout.invariants:negative_wall_minus_carved_floors_at_zero" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var pr: Progress;
    init(?pr, ?alloc, LEVEL_PHASES);

    val ancient: ctime.Time = ctime.Time{sec: 0, nsec: 0};
    unit_begin(?pr);
    phase_begin(?pr, PH_LOAD);
    phase_begin(?pr, PH_CODEGEN);
    span_end(?pr, PH_CODEGEN, PH_LOAD, ancient);
    phase_end(?pr, PH_LOAD, 1, "module", "modules");

    var bad: i32 = 0;
    if (pr.metrics[PH_LOAD::u32].elapsed < 0) { bad = 1; }

    dnit(?pr);
    ret bad;
}

test "mach.lang.readout.invariants:summary_other_floors_at_zero" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var pr: Progress;
    init(?pr, ?alloc, LEVEL_PHASES);

    unit_begin(?pr);
    phase_begin(?pr, PH_LOAD);
    val ancient: ctime.Time = ctime.Time{sec: 0, nsec: 0};
    val d: cdur.Duration = ctime.time_sub(ctime.monotonic(), ancient);
    item_dur(?pr, PH_LOAD, "huge", d);
    pr.unit_rows = d;
    phase_end(?pr, PH_LOAD, 1, "module", "modules");
    pr.unit_rows = d;

    summary(?pr, "out", 1, 0, "B", false);

    var bad: i32 = 0;
    if (pr.other < 0) { bad = 1; }

    dnit(?pr);
    ret bad;
}

test "mach.lang.readout.size_split:binary_thresholds_and_rounding" {
    var unit: str = nil;

    if (size_split(0, ?unit) != 0 || !str_equals(unit, "B")) { ret 1; }
    if (size_split(1023, ?unit) != 1023 || !str_equals(unit, "B")) { ret 2; }

    if (size_split(1024, ?unit) != 1 || !str_equals(unit, "KiB")) { ret 3; }
    if (size_split(1024 * 1024 - 1, ?unit) != 1024 || !str_equals(unit, "KiB")) { ret 4; }

    if (size_split(1024 * 1024, ?unit) != 1 || !str_equals(unit, "MiB")) { ret 5; }
    if (size_split(1024 * 1024 * 1024 - 1, ?unit) != 1024 || !str_equals(unit, "MiB")) { ret 6; }

    if (size_split(1024::usize * 1024 * 1024, ?unit) != 1 || !str_equals(unit, "GiB")) { ret 7; }
    if (size_split(3::usize * 1024 * 1024 * 1024, ?unit) != 3 || !str_equals(unit, "GiB")) { ret 8; }

    ret 0;
}
