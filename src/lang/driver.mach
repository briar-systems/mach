    ret 0;
}

# the library the lowered project binds `sym` to, empty when none
#[testing]
fun import_library_of(p: *project.Project, sym: str) res[str, fail.Fail] {
    val le: err[fail.Fail] = run_lower_pass(p);
    if (sel le.err) { ret res[str, fail.Fail].err{le.err}; }
    val sid: res[intern.StrId, A.Error] = intern.add(?p.s.interner, sym);
    if (sel sid.err) { ret res[str, fail.Fail].err{fail.refused(sid.err)}; }
    val got: intern.StrId = linkage.import_library(?p.linkage, sid.ok);
    if (intern.str_is_nil(got)) { ret res[str, fail.Fail].ok{""}; }
    val name: opt[str] = intern.get(?p.s.interner, got);
    if (sel name.none) { ret res[str, fail.Fail].ok{""}; }
    ret res[str, fail.Fail].ok{name.some};
}

# the library the fixture project built for `target` binds `sym` to
#[testing]
fun import_library_built(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32,
    target: str, sym: str) res[str, fail.Fail] {
    val pr: res[project.Project, fail.Fail] = scaffold_build(s, alloc, fixture_manifest(), names, texts, n, target);
    if (sel pr.err) { ret res[str, fail.Fail].err{pr.err}; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val se: err[fail.Fail] = run_sema_pass(?p);
    if (sel se.err) { ret res[str, fail.Fail].err{se.err}; }
    ret import_library_of(?p, sym);
}

# as import_library_built, with `extra` loaded beside the artifact closure the way an editor
# holds a module the artifact never compiles
#[testing]
fun import_library_beside(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32,
    target: str, extra: str, sym: str) res[str, fail.Fail] {
    val root_r: res[str, fail.Fail] = scaffold(alloc, fixture_manifest(), names, texts, n);
    if (sel root_r.err) { ret res[str, fail.Fail].err{root_r.err}; }
    val root: str = root_r.ok;
    fin { fs.remove_all(alloc, root); }
    val mr: res[manifest.Manifest, fail.Fail] = load_manifest(s, root);
    if (sel mr.err) { ret res[str, fail.Fail].err{mr.err}; }
    var m: manifest.Manifest = mr.ok;
    fin { manifest.dnit(?m, s.build_alloc); }
    val xid: res[intern.StrId, A.Error] = intern.add(?s.interner, extra);
    if (sel xid.err) { ret res[str, fail.Fail].err{fail.refused(xid.err)}; }
    var extra_roots: [1]intern.StrId = [1]intern.StrId{xid.ok};

    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = target;
    val pr: res[project.Project, fail.Fail] = analyze_project_tolerant(s, ?m, ?req, project.ROOT_ARTIFACT, ?extra_roots[0], 1, FRONTEND_SEMA);
    if (sel pr.err) { ret res[str, fail.Fail].err{pr.err}; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val status: fail.PhaseStatus = frontend.frontend_status(?p);
    if (!sel status.kind.accepted)              { ret res[str, fail.Fail].err{fail.phase_failure(status)}; }
    if (p.emit_len >= project.module_count(?p)) { ret res[str, fail.Fail].err{fail.message("the fixture loaded no uncompiled module")}; }
    ret import_library_of(?p, sym);
}

# a module loaded beside the artifact closure but never compiled attributes no library: alone
# it binds nothing, and beside a compiled module declaring the same import the compiled one wins
test import_library__ignores_an_uncompiled_module {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [3]str = [3]str{"main.mach", "orphan.mach", "a.mach"};
    var texts: [3]str = [3]str{
        "fun main() i32 { ret 0; }\n",
        "#[library(\"user32\")]\next fun Sleep(ms: u32);\npub fun call() { Sleep(0); }\n",
        "#[library(\"kernel32\")]\next fun Sleep(ms: u32);\npub fun call() { Sleep(0); }\n"
    };
    val alone: res[str, fail.Fail] = import_library_beside(?s, ?alloc, ?names[0], ?texts[0], 2, "linux", "uniontest.orphan", "Sleep");
    if (sel alone.err)             { ret 2; }
    if (!str_equals(alone.ok, "")) { ret 3; }

    texts[0] = "use uniontest.a;\nfun main() i32 { a.call(); ret 0; }\n";
    val beside: res[str, fail.Fail] = import_library_beside(?s, ?alloc, ?names[0], ?texts[0], 3, "linux", "uniontest.orphan", "Sleep");
    if (sel beside.err)                     { ret 4; }
    if (!str_equals(beside.ok, "kernel32")) { ret 5; }
    ret 0;
}

# two compiled modules may name one import only through one library: a second library is
# refused naming both declarations and both libraries, the same library is accepted
test import_library__one_providing_library_per_import {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [3]str = [3]str{"main.mach", "a.mach", "b.mach"};
    var texts: [3]str = [3]str{
        "use uniontest.a;\nuse uniontest.b;\nfun main() i32 { a.call(); b.call(); ret 0; }\n",
        "#[library(\"kernel32\")]\next fun Sleep(ms: u32);\npub fun call() { Sleep(0); }\n",
        "#[library(\"user32\")]\next fun Sleep(ms: u32);\npub fun call() { Sleep(0); }\n"
    };
    val pr: res[str, fail.Fail] = import_library_built(?s, ?alloc, ?names[0], ?texts[0], 3, "linux", "Sleep");
    if (sel pr.ok) { ret 2; }
    val msg: str = fail.describe(pr.err);
    if (!str_contains(msg, "import 'Sleep'"))             { ret 3; }
    if (!str_contains(msg, "declaration 'Sleep'"))        { ret 4; }
    if (!str_contains(msg, "'kernel32'"))                 { ret 5; }
    if (!str_contains(msg, "'user32'"))                   { ret 6; }
    if (!str_contains(msg, "uniontest.a"))                { ret 7; }
    if (!str_contains(msg, "uniontest.b"))                { ret 8; }
    if (!str_contains(msg, "only one providing library")) { ret 9; }

    texts[2] = texts[1];
    val same: res[str, fail.Fail] = import_library_built(?s, ?alloc, ?names[0], ?texts[0], 3, "linux", "Sleep");
    if (sel same.err)                     { ret 10; }
    if (!str_equals(same.ok, "kernel32")) { ret 11; }
    ret 0;
}

test import_library__binds_the_selected_arm {
