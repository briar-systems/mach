test union_gate__tuple_bindings_are_isolated {
    var names: [5]str;
    names[0] = "main.mach";
    names[1] = "linux_flag.mach";
    names[2] = "windows_flag.mach";
    names[3] = "yes.mach";
    names[4] = "no.mach";
    var texts: [5]str;
    texts[0] = "$if ($mach.build.os == $mach.os.linux) { use chosen: uniontest.linux_flag; } $or { use chosen: uniontest.windows_flag; }\n$if (chosen.ENABLED) { use uniontest.yes; } $or { use uniontest.no; }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub def Flag: u8;\npub val ENABLED: Flag = 1;\n";
    texts[2] = "pub def Flag: u8;\npub val ENABLED: Flag = 0;\n";
    texts[3] = "pub fun yes() i32 { ret 1; }\n";
    texts[4] = "pub fun no() i32 { ret 0; }\n";
    if (union_gate_result_n(?names[0], ?texts[0], 5, "", "") != 0) { ret 1; }

    names[0] = "main.mach";
    names[1] = "linux_flag.mach";
    names[2] = "yes.mach";
    texts[0] = "$if ($mach.build.os == $mach.os.linux) { use chosen: uniontest.linux_flag; $if (chosen.ENABLED) { use uniontest.yes; } }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val ENABLED: u8 = 1;\n";
    texts[2] = "pub fun yes() i32 { ret 1; }\n";
    if (union_gate_result_n(?names[0], ?texts[0], 3, "", "unresolved identifier") != 0) { ret 2; }
    ret 0;
}

test tuple_reach__propagates_transitively {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "$if ($mach.build.os == NATIVE_OS) { use uniontest.a; }\nfun main() i32 { ret 0; }\n";
    texts[1] = "use uniontest.b;\npub fun a() i32 { ret 1; }\n";
    texts[2] = "$if ($mach.build.os != NATIVE_OS) { def Word: u16; val BAD: Word = 1; $if (BAD) { use uniontest.missing; } }\npub fun b() i32 { ret 2; }\n";
    val text0_r: res[str, fail.Fail] = union_native_text(?alloc, texts[0]);
    if (sel text0_r.err) {
        session.dnit(?s);
        ret 1;
    }
    texts[0] = text0_r.ok;
    fin { str_free(?alloc, texts[0]); }
    val text2_r: res[str, fail.Fail] = union_native_text(?alloc, texts[2]);
    if (sel text2_r.err) {
        session.dnit(?s);
        ret 1;
    }
    texts[2] = text2_r.ok;
    fin { str_free(?alloc, texts[2]); }
    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;
    fin { str_free(?alloc, root); }
    val pr: res[project.Project, fail.Fail] = union_analysis(?s, root, "", FRONTEND_RESOLVE);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 2;
    }
    var p:   project.Project = pr.ok;
    var bad: i32             = 0;
    if (diagnostic.error_count(?s.diags) != 0) { bad = 3; }
    val bmid: session.ModuleId = project.module_named(?p, "uniontest.b");
    if (module.is_nil(bmid)) { bad = 4; }
    or {
        val bm: *project.ModuleEntry = project.module_at(?p, bmid::u32);
        if (bm.load.reached == nil || bm.load.reach_count != p.loader.tuple_count) { bad = 5; }
        or {
            var ti: u32 = 0;
            for (ti < p.loader.tuple_count) {
                val should_reach: bool = p.loader.tuples[ti].target.os_id == lang_target.host_os_id();
                if (bm.load.reached[ti] != should_reach) { bad = 6; }
                ti = ti + 1;
            }
        }
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# shared loads first under the native tuples alone, through main's gated import, and is reached
# under every tuple only by the later late: its load is walked again under the tuples new to it, so
# the foreign-only import it gates is loaded, and the topo is ordered again to put it first
test tuple_reach__a_module_reached_under_a_new_tuple_is_walked_again {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names: [4]str = [4]str{"main.mach", "late.mach", "shared.mach", "foreign.mach"};
    var texts: [4]str = [4]str{
        "$if ($mach.build.os == NATIVE_OS) { use uniontest.shared; }\nuse uniontest.late;\nfun main() i32 { ret 0; }\n",
        "use uniontest.shared;\npub fun late() i32 { ret 1; }\n",
        "$if ($mach.build.os == FOREIGN_OS) { use uniontest.foreign; }\npub fun shared() i32 { ret 2; }\n",
        "pub fun foreign() i32 { ret 3; }\n"
    };
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = gate_session(?alloc, ?names[0], ?texts[0], 4, ?s);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
    }
    val built: res[project.Project, fail.Fail] = union_analysis(?s, root, "", FRONTEND_RESOLVE);
    if (sel built.err) { ret 3; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    if (diagnostic.error_count(?s.diags) != 0) { ret 4; }
    val shared:  session.ModuleId = project.module_named(?p, "uniontest.shared");
    val foreign: session.ModuleId = project.module_named(?p, "uniontest.foreign");
    if (module.is_nil(shared) || module.is_nil(foreign)) { ret 5; }
    val sm: *project.ModuleEntry = project.module_at(?p, shared::u32);
    val fm: *project.ModuleEntry = project.module_at(?p, foreign::u32);
    if (sm.load.reached == nil || fm.load.reached == nil) { ret 6; }
    # FOREIGN_OS spells windows, or linux on a windows host
    var foreign_os: u32 = catalog_os.WINDOWS;
    if (lang_target.host_os_id() == catalog_os.WINDOWS) { foreign_os = catalog_os.LINUX; }
    var foreign_tuples: u32 = 0;
    var ti:             u32 = 0;
    for (ti < p.loader.tuple_count) {
        if (!sm.load.reached[ti]) { ret 7; }
        val wanted: bool = p.loader.tuples[ti].target.os_id == foreign_os;
        if (fm.load.reached[ti] != wanted) { ret 8; }
        if (wanted)                        { foreign_tuples = foreign_tuples + 1; }
        ti = ti + 1;
    }
    if (foreign_tuples == 0)                                               { ret 9; }
    if (project.topo_index(?p, foreign) >= project.topo_index(?p, shared)) { ret 10; }
    if (project.topo_index(?p, shared) >= p.topo_len)                      { ret 11; }
    ret 0;
}

test union_gate__distinct_failures_per_tuple_are_all_visible {
