        "use uniontest.a;\nfun main() i32 { a.call(); ret 0; }\n",
        "$if ($mach.build.os == $mach.os.windows) {\n    #[library(\"kernel32\")]\n    ext fun Sleep(ms: u32);\n}\n$or {\n    #[library(\"c\")]\n    ext fun Sleep(ms: u32);\n}\n\npub fun call() { Sleep(0); }\n"
    };
    val win: res[str, fail.Fail] = import_library_built(?s, ?alloc, ?names[0], ?texts[0], 2, "windows", "Sleep");
