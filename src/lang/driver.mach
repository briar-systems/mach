}

test union_gate__malformed_condition_reported_as_in_a_single_build {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "$if (5) { use uniontest.a; }\n\nfun main() i32 { ret 0; }\n";

    var a1:     A.Allocator;
    val make_r: err[A.Error] = page.make(?a1);
    if (sel make_r.err) { ret 1; }
    val sr1: res[session.Session, fail.Fail] = toolchain.session_init(?a1);
    if (sel sr1.err) { ret 1; }
    var s1:      session.Session     = sr1.ok;
    val root1_r: res[str, fail.Fail] = scaffold(?a1, fixture_manifest(), ?names[0], ?texts[0], 1);
    if (sel root1_r.err) {
        session.dnit(?s1);
        ret 1;
    }
    val root1: str                             = root1_r.ok;
    var pick:  manifest.Selectors              = manifest.t_selectors("", "", "");
    val p1r:   res[project.Project, fail.Fail] = build_project(?s1, root1, ?pick);
    fs.remove_all(?a1, root1);
    if (sel p1r.err) {
        session.dnit(?s1);
        ret 1;
    }
    var p1:          project.Project = p1r.ok;
    val single_errs: usize           = diagnostic.error_count(?s1.diags);

    var a2:      A.Allocator;
    val make_r2: err[A.Error] = page.make(?a2);
    if (sel make_r2.err) {
        project.dnit_project(?p1);
        session.dnit(?s1);
        ret 1;
    }
    val sr2: res[session.Session, fail.Fail] = toolchain.session_init(?a2);
    if (sel sr2.err) {
        project.dnit_project(?p1);
        session.dnit(?s1);
        ret 1;
    }
    var s2:  session.Session                 = sr2.ok;
    val p2r: res[project.Project, fail.Fail] = scaffold_union(?s2, ?a2, fixture_manifest(), ?names[0], ?texts[0], 1, FRONTEND_RESOLVE);
    if (sel p2r.err) {
        project.dnit_project(?p1);
        session.dnit(?s1);
        session.dnit(?s2);
        ret 1;
    }
    var p2:         project.Project = p2r.ok;
    val union_errs: usize           = diagnostic.error_count(?s2.diags);

    var bad: i32 = 0;
    if (single_errs == 0)          { bad = 1; }
    or (union_errs != single_errs) { bad = 1; }

    project.dnit_project(?p1);
    project.dnit_project(?p2);
    session.dnit(?s1);
    session.dnit(?s2);
    ret bad;
}

