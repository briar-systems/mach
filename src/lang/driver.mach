fun append_phase_roots(p: *project.Project, roots: *Vector[query.QueryKey],
                       kind: query.QueryKind, count: u32) err[outcome.Fail] {
    var i: u32 = 0;
    for (i < count) {
        val m: *project.ModuleEntry = ?p.modules[p.topo[i]::u32];
        var key: u64 = m.stable_id::u64;
        if (kind == query.Q_PARSE) { key = m.file_id::u64; }
        or (kind == query.Q_INLINE_BODIES || kind == query.Q_LOWER || kind == query.Q_CODEGEN) { key = passes.back_half_key_for(p, m); }
        val added: res[usize, A.Error] = vector.push[query.QueryKey](roots, query.QueryKey{ kind: kind, key: key });
        if (sel added.err) {
            ret err[outcome.Fail].err{outcome.refused(added.err)};
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

pub fun append_frontend_roots(p: *project.Project, roots: *Vector[query.QueryKey]) err[outcome.Fail] {
    val parsed: err[outcome.Fail] = append_phase_roots(p, roots, query.Q_PARSE, p.topo_len);
    if (sel parsed.err) { ret parsed; }
    val resolved: err[outcome.Fail] = append_phase_roots(p, roots, query.Q_RESOLVE, p.topo_len);
    if (sel resolved.err) { ret resolved; }
    ret append_phase_roots(p, roots, query.Q_SEMA, p.topo_len);
}

fun append_backend_roots(p: *project.Project, roots: *Vector[query.QueryKey],
                        codegen: bool) err[outcome.Fail] {
    val frontend: err[outcome.Fail] = append_frontend_roots(p, roots);
    if (sel frontend.err) { ret frontend; }
    val surface: err[outcome.Fail] = append_phase_roots(p, roots, query.Q_LOWERED_SURFACE, p.emit_len);
    if (sel surface.err) { ret surface; }
    val bodies: err[outcome.Fail] = append_phase_roots(p, roots, query.Q_INLINE_BODIES, p.emit_len);
    if (sel bodies.err) { ret bodies; }
    val lowered: err[outcome.Fail] = append_phase_roots(p, roots, query.Q_LOWER, p.emit_len);
    if (sel lowered.err) { ret lowered; }
    if (codegen) { ret append_phase_roots(p, roots, query.Q_CODEGEN, p.emit_len); }
    ret err[outcome.Fail].ok{};
}

fun run_query_pass(p: *project.Project, roots: *Vector[query.QueryKey],
                   run: fun(*project.Project) err[outcome.Fail]) err[outcome.Fail] {
    val begun: res[query.Operation, outcome.Fail] = project.begin_query_phase(p);
    if (sel begun.err) {
        ret err[outcome.Fail].err{begun.err};
    }
    val result: err[outcome.Fail] = run(p);
    ret project.finish_query_phase(p, begun.ok, roots.data, roots.len, result);
}

fun finish_nonquery_phase(p: *project.Project,
                         result: err[outcome.Fail]) err[outcome.Fail] {
    val refreshed: err[outcome.Fail] = project.refresh_diagnostics(p);
    if (sel refreshed.err) {
        diagnostic.note_lost(?p.diags);
        diagnostic.note_lost(?p.s.diags);
        if (sel result.ok) { ret refreshed; }
    }
    ret result;
}

fun project_failure(p: *project.Project, failure: outcome.Fail) res[project.Project, outcome.Fail] {
    var stable: outcome.Fail = failure;
    val carried: opt[str] = outcome.text(failure);
    if (sel carried.some) {
        val text: str = carried.some;
        if (text != p.s.query_failure_message
            && (p.s.query_presentation == nil || text != p.s.query_presentation.message)) {
            val copied: res[str, A.Error] = str_dup(p.s.queries.a, text);
            if (sel copied.err) {
                stable = outcome.with_text(failure, outcome.alloc_text(copied.err));
                diagnostic.note_lost(?p.diags);
            }
            if (sel copied.ok) {
                if (p.s.query_failure_message != nil) { str_free(p.s.queries.a, p.s.query_failure_message); }
                p.s.query_failure_message = copied.ok;
                stable = outcome.with_text(failure, p.s.query_failure_message);
            }
        }
    }
    val published: err[outcome.Fail] = finish_nonquery_phase(p, err[outcome.Fail].err{stable});
    project.dnit_project(p);
    if (sel published.err) { ret res[project.Project, outcome.Fail].err{published.err}; }
    ret res[project.Project, outcome.Fail].err{stable};
}

pub fun run_sema_pass(p: *project.Project) err[outcome.Fail] {
    val prepared: err[outcome.Fail] = passes.prepare_sema_pass(p);
    if (sel prepared.err) { ret prepared; }
    var roots: Vector[query.QueryKey] = vector.init[query.QueryKey](p.alloc);
    fin { vector.dnit[query.QueryKey](?roots); }
    val rooted: err[outcome.Fail] = append_frontend_roots(p, ?roots);
    if (sel rooted.err) { ret rooted; }
    ret run_query_pass(p, ?roots, passes.run_sema_pass);
}

pub fun run_lower_pass(p: *project.Project) err[outcome.Fail] {
    val prepared: err[outcome.Fail] = passes.prepare_lower_pass(p);
    if (sel prepared.err) { ret prepared; }
    var roots: Vector[query.QueryKey] = vector.init[query.QueryKey](p.alloc);
    fin { vector.dnit[query.QueryKey](?roots); }
    val rooted: err[outcome.Fail] = append_backend_roots(p, ?roots, false);
    if (sel rooted.err) { ret rooted; }
    ret run_query_pass(p, ?roots, passes.run_lower_pass);
}

pub fun run_codegen_pass(p: *project.Project) err[outcome.Fail] {
    val prepared: err[outcome.Fail] = passes.prepare_codegen_pass(p);
    if (sel prepared.err) { ret prepared; }
    var roots: Vector[query.QueryKey] = vector.init[query.QueryKey](p.alloc);
    fin { vector.dnit[query.QueryKey](?roots); }
    val rooted: err[outcome.Fail] = append_backend_roots(p, ?roots, true);
    if (sel rooted.err) { ret rooted; }
    ret run_query_pass(p, ?roots, passes.run_codegen_pass);
}

pub fun run_link_pass(p: *project.Project) res[bool, outcome.Fail] {
    val prepared: err[outcome.Fail] = passes.prepare_link_pass(p);
    if (sel prepared.err) {
        ret res[bool, outcome.Fail].err{prepared.err};
    }
    var roots: Vector[query.QueryKey] = vector.init[query.QueryKey](p.alloc);
    fin { vector.dnit[query.QueryKey](?roots); }
    val rooted: err[outcome.Fail] = append_backend_roots(p, ?roots, true);
    if (sel rooted.err) {
        ret res[bool, outcome.Fail].err{rooted.err};
    }
    val linked: res[usize, A.Error] = vector.push[query.QueryKey](?roots, query.QueryKey{ kind: query.Q_LINK, key: 0 });
    if (sel linked.err) {
        ret res[bool, outcome.Fail].err{outcome.refused(linked.err)};
    }
    val begun: res[query.Operation, outcome.Fail] = project.begin_query_phase(p);
    if (sel begun.err) {
        ret res[bool, outcome.Fail].err{begun.err};
    }
    val result: res[bool, outcome.Fail] = passes.run_link_pass(p);
    val finished: err[outcome.Fail] = project.finish_query_phase(p,
        begun.ok, roots.data, roots.len, outcome.unit[bool](result));
    if (sel finished.err) {
        ret res[bool, outcome.Fail].err{finished.err};
    }
    ret result;
}

fun query_compute(p: *project.Project, kind: query.QueryKind, key: u64,
                  alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    if (kind == query.Q_PARSE)           { ret load.q_parse_compute(p, key, alloc, diags); }
    if (kind == query.Q_RESOLVE)         { ret passes.q_resolve_compute(p, key, alloc, diags); }
    if (kind == query.Q_EXPORTS)         { ret load.q_exports_compute(p, key, alloc, diags); }
    if (kind == query.Q_SEMA)            { ret passes.q_sema_compute(p, key, alloc, diags); }
    if (kind == query.Q_TYPED_EXPORTS)   { ret passes.q_typed_exports_compute(p, key, alloc, diags); }
    if (kind == query.Q_LOWERED_SURFACE) { ret passes.q_lowered_surface_compute(p, key, alloc, diags); }
    if (kind == query.Q_LOWER)           { ret passes.q_lower_compute(p, key, alloc, diags); }
    if (kind == query.Q_INLINE_BODIES)   { ret passes.q_inline_bodies_compute(p, key, alloc, diags); }
    if (kind == query.Q_CODEGEN)         { ret passes.q_codegen_compute(p, key, alloc, diags); }
    if (kind == query.Q_LINK)            { ret passes.q_link_compute(p, key, alloc, diags); }
    # a registered kind without a driver computation is an input kind the
    # engine must never ask the driver for; an unregistered kind is outside
    # the catalog. both are internal and name the tag
    var c: fail.Catalog = fail.unknown_member("QueryKind", kind::u32);
    if (query.is_registered(?p.s.queries, kind)) {
        c = fail.unknown_member_in("QueryKind", kind::u32, "the driver compute dispatch");
    }
    ret res[query.QueryOutput, fail.Fail].err{fail.message(fail.catalog_message(?p.s.interner, p.s.alloc, c))};
}

pub fun build_project(s: *session.Session, project_root: str, pick: *manifest.Selection) res[project.Project, outcome.Fail] {
    val mr: res[manifest.Manifest, outcome.Fail] = load_manifest(s, project_root);
    if (sel mr.err) {
        ret res[project.Project, outcome.Fail].err{mr.err};
    }
    var m: manifest.Manifest = mr.ok;
    var esel: manifest.Selection = @pick;
    val psr: err[outcome.Fail] = manifest.select_primary_artifact(s.build_alloc, ?s.interner, ?m, ?esel);
    if (sel psr.err) {
        manifest.dnit(?m, s.build_alloc);
        ret res[project.Project, outcome.Fail].err{psr.err};
    }
    val r: res[project.Project, outcome.Fail] = build_project_impl(s, project_root, ?esel, ?m, nil, project.ROOT_ARTIFACT, false);
    manifest.dnit(?m, s.build_alloc);
    ret r;
}

fun build_project_impl(s: *session.Session, project_root: str, pick: *manifest.Selection, m: *manifest.Manifest, req: *request.BuildRequest, roots: project.RootSet, run_steps: bool) res[project.Project, outcome.Fail] {
    val begin_r: res[project.Project, outcome.Fail] = begin_build_impl(s, project_root, pick, m, req, nil, roots);
    if (sel begin_r.err) { ret begin_r; }
    var p: project.Project = begin_r.ok;

    if (run_steps) {
        val res_dep_steps: err[outcome.Fail] = run_dep_steps_phase(?p);
        if (sel res_dep_steps.err) {
            ret project_failure(?p, res_dep_steps.err);
        }
        val res_steps: err[outcome.Fail] = run_steps_phase(?p);
        if (sel res_steps.err) {
            ret project_failure(?p, res_steps.err);
        }
    }

    val load_r: err[outcome.Fail] = run_load_phase(?p);
    if (sel load_r.err) {
        ret project_failure(?p, load_r.err);
    }

    ret res[project.Project, outcome.Fail].ok{p};
}

pub fun verify_dependencies(s: *session.Session, project_root: str) err[outcome.Fail] {
    val mr: res[manifest.Manifest, outcome.Fail] = load_manifest(s, project_root);
    if (sel mr.err) { ret err[outcome.Fail].err{mr.err}; }
    var m: manifest.Manifest = mr.ok;
    var p: project.Project;
    project.init_project(?p, s);
    p.req.project_root = project_root;
    val dep_id_r: res[intern.StrId, A.Error] = intern.intern_typed(?s.interner, "dep");
    if (sel dep_id_r.err) {
        project.dnit_project(?p);
        manifest.dnit(?m, s.build_alloc);
        ret err[outcome.Fail].err{outcome.refused(dep_id_r.err)};
    }
    p.config.dir_dep = dep_id_r.ok;
    val dr: err[outcome.Fail] = ddep.resolve_deps(?p, ?m, project_root);
    if (sel dr.err) {
        val rejected: res[project.Project, outcome.Fail] = project_failure(?p, dr.err);
        manifest.dnit(?m, s.build_alloc);
        if (sel rejected.err) { ret err[outcome.Fail].err{rejected.err}; }
        ret err[outcome.Fail].err{dr.err};
    }
    val published: err[outcome.Fail] = finish_nonquery_phase(?p, err[outcome.Fail].ok{});
    project.dnit_project(?p);
    manifest.dnit(?m, s.build_alloc);
    if (sel published.err) {
        ret err[outcome.Fail].err{published.err};
    }
    ret err[outcome.Fail].ok{};
}

pub fun begin_build(s: *session.Session, m: *manifest.Manifest, req: *request.BuildRequest, ev: *readout.Progress) res[project.Project, outcome.Fail] {
    var pick: manifest.Selection;
    pick.target       = req.target;
    pick.profile      = req.profile;
    pick.artifact     = req.artifact;
    pick.want_lib     = req.want_lib;
    pick.has_artifact = !str_empty(req.artifact);
    pick.legacy_default = req.artifact_by_table_order;
    var roots: project.RootSet = project.ROOT_ARTIFACT;
    if (request.test_goal(req.goal)) { roots = project.ROOT_TEST; }
    ret begin_build_impl(s, req.project_root, ?pick, m, req, ev, roots);
}

pub def FrontendPhase: u8;
pub val FRONTEND_PARSE: FrontendPhase = 0;
pub val FRONTEND_RESOLVE: FrontendPhase = 1;
pub val FRONTEND_SEMA: FrontendPhase = 2;

pub fun analyze_project(s: *session.Session, m: *manifest.Manifest, req: *request.BuildRequest,
                        extra_roots: *intern.StrId, extra_root_count: u32) res[project.Project, outcome.Fail] {
    ret analyze_project_until(s, m, req, extra_roots, extra_root_count, FRONTEND_SEMA);
}

pub fun analyze_project_until(s: *session.Session, m: *manifest.Manifest, req: *request.BuildRequest,
                        extra_roots: *intern.StrId, extra_root_count: u32, phase: FrontendPhase) res[project.Project, outcome.Fail] {
    if (phase > FRONTEND_SEMA) { ret res[project.Project, outcome.Fail].err{outcome.user("unknown frontend analysis phase")}; }
    if (extra_root_count > 0 && extra_roots == nil) {
        ret res[project.Project, outcome.Fail].err{outcome.internal(
            "driver: frontend analysis root count requires a root array")};
    }

    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(s.alloc);

    val reg_r: err[outcome.Fail] = setup_registry_typed(?s.registry);
    if (sel reg_r.err) {
        ret res[project.Project, outcome.Fail].err{reg_r.err};
    }

    val begin_r: res[project.Project, outcome.Fail] = begin_build(s, m, req, nil);
    if (sel begin_r.err) { ret begin_r; }
    var p: project.Project = begin_r.ok;

    if (phase == FRONTEND_PARSE) {
        val parsed: err[outcome.Fail] = parse_project_roots(?p, extra_roots, extra_root_count);
        if (sel parsed.err) { ret project_failure(?p, parsed.err); }
        ret res[project.Project, outcome.Fail].ok{p};
    }

    val load_r: err[outcome.Fail] = run_load_phase_roots(?p, extra_roots, extra_root_count);
    if (sel load_r.err) {
        val failure: outcome.Fail = load_r.err;
        ret project_failure(?p, failure);
    }

    if (phase == FRONTEND_RESOLVE) {
        val current: res[bool, outcome.Fail] = resolve_query_phase(?p, false, false);
        if (sel current.err) { ret project_failure(?p, current.err); }
        ret res[project.Project, outcome.Fail].ok{p};
    }

    val sema_r: err[outcome.Fail] = run_sema_pass(?p);
    if (sel sema_r.err) {
        val failure: outcome.Fail = sema_r.err;
        ret project_failure(?p, failure);
    }

    ret res[project.Project, outcome.Fail].ok{p};
}

fun parse_project_roots(p: *project.Project, roots: *intern.StrId, count: u32) err[outcome.Fail] {
    val selected: err[outcome.Fail] = dcfg.select_target(p, p.target_entry);
    if (sel selected.err) { ret finish_nonquery_phase(p, err[outcome.Fail].err{selected.err}); }
    var entry: intern.StrId = intern.STR_NIL;
    var selected_roots: *intern.StrId = roots;
    var selected_count: u32 = count;
    if (selected_count == 0) {
        val name: res[intern.StrId, fail.Fail] = load.entry_module_fqn(p, p.target_entry);
        if (sel name.err) { ret finish_nonquery_phase(p, err[outcome.Fail].err{outcome.from_fail(name.err)}); }
        entry = name.ok;
        selected_roots = ?entry;
        selected_count = 1;
    }
    var i: u32 = 0;
    for (i < selected_count) {
        val loaded: res[session.ModuleId, fail.Fail] = load.parse_root(p, selected_roots[i]);
        if (sel loaded.err) {
            ret load.collect_loaded_parses(p, err[outcome.Fail].err{load_failure_of(p, loaded.err)});
        }
        i = i + 1;
    }
    ret load.collect_loaded_parses(p, err[outcome.Fail].ok{});
}

fun begin_build_impl(s: *session.Session, project_root: str, pick: *manifest.Selection, m: *manifest.Manifest, req: *request.BuildRequest, ev: *readout.Progress, roots: project.RootSet) res[project.Project, outcome.Fail] {
    if (req != nil) {
        val valid: err[outcome.Fail] = request.validate(s.alloc, req);
        if (sel valid.err) {
            ret res[project.Project, outcome.Fail].err{valid.err};
        }
    }
    var p: project.Project;
    project.init_project(?p, s);
    if (req != nil) { p.req = @req; }
    p.events = ev;
    p.roots  = roots;

    val for_union: bool = roots == project.ROOT_UNION;
    val is_test:   bool = roots == project.ROOT_TEST;

    val q_r: err[outcome.Fail] = bind_queries(?p);
    if (sel q_r.err) {
        ret project_failure(?p, q_r.err);
    }

    var cfg_r: err[outcome.Fail];
    if (m != nil) {
        cfg_r = dcfg.load_config_manifest(?p, project_root, m, pick, for_union, is_test);
    }
    or {
        val mp_r: res[str, fail.Fail] = load.join_path(s.alloc, project_root, manifest.MANIFEST_FILE);
        if (sel mp_r.err) {
            ret project_failure(?p, outcome.from_fail(mp_r.err));
        }
        val manifest_path: str = mp_r.ok;
        cfg_r = dcfg.load_project_config(?p, project_root, manifest_path, pick, for_union, is_test);
        str_free(s.alloc, manifest_path);
    }
    if (sel cfg_r.err) {
        ret project_failure(?p, cfg_r.err);
    }

    val te: *project.TargetEntry = p.target_entry;
    if (te == nil) {
        ret project_failure(?p, outcome.internal("internal: manifest selected no target"));
    }

    if (req == nil) {
        p.req = request.defaults();
        p.req.project_root = project_root;
        if (te.opt == project.TARGET_OPT_RELEASE) { p.req.opt = pipeline.OPT_RELEASE; }
    }

    val published: err[outcome.Fail] = finish_nonquery_phase(?p, err[outcome.Fail].ok{});
    if (sel published.err) {
        ret project_failure(?p, published.err);
    }

    ret res[project.Project, outcome.Fail].ok{p};
}

pub fun run_steps_phase(p: *project.Project) err[outcome.Fail] {
    val res_steps: err[outcome.Fail] = dcfg.execute_steps(p.alloc, p, p.req.project_root);
    if (sel res_steps.err) {
        ret finish_nonquery_phase(p, err[outcome.Fail].err{res_steps.err});
    }
    ret finish_nonquery_phase(p, err[outcome.Fail].ok{});
}

pub fun run_dep_steps_phase(p: *project.Project) err[outcome.Fail] {
    val te: *project.TargetEntry = p.target_entry;
    val lookup_typed_r: opt[str] = intern.lookup_typed(?p.s.interner, te.isa_name);
    if (sel lookup_typed_r.none) { ret err[outcome.Fail].err{outcome.internal("interned text is absent where the run dep steps phase expected it")}; }
    val isa_s: str = lookup_typed_r.some;
    val lookup_typed_r2: opt[str] = intern.lookup_typed(?p.s.interner, te.os_name);
    if (sel lookup_typed_r2.none) { ret err[outcome.Fail].err{outcome.internal("interned text is absent where the run dep steps phase expected it")}; }
    val os_s:  str = lookup_typed_r2.some;
    val lookup_typed_r3: opt[str] = intern.lookup_typed(?p.s.interner, te.abi_name);
    if (sel lookup_typed_r3.none) { ret err[outcome.Fail].err{outcome.internal("interned text is absent where the run dep steps phase expected it")}; }
    val abi_s: str = lookup_typed_r3.some;
    val res_dep_steps: err[outcome.Fail] = dcfg.execute_dep_steps(p, isa_s, os_s, abi_s);
    if (sel res_dep_steps.err) {
        ret finish_nonquery_phase(p, err[outcome.Fail].err{res_dep_steps.err});
    }
    ret finish_nonquery_phase(p, err[outcome.Fail].ok{});
}

pub fun run_load_phase(p: *project.Project) err[outcome.Fail] {
    ret run_load_phase_roots(p, nil, 0);
}

fun run_load_phase_roots(p: *project.Project, extra_roots: *intern.StrId,
                         extra_root_count: u32) err[outcome.Fail] {
    ret finish_nonquery_phase(p, load_phase_impl(p, extra_roots, extra_root_count));
}

fun load_phase_impl(p: *project.Project, extra_roots: *intern.StrId,
                    extra_root_count: u32) err[outcome.Fail] {
    val te: *project.TargetEntry = p.target_entry;

    val fp_r: err[outcome.Fail] = dcfg.select_target(p, te);
    if (sel fp_r.err) {
        ret err[outcome.Fail].err{fp_r.err};
    }

    val entry_path_r: res[intern.StrId, fail.Fail] = load.entry_module_fqn(p, te);
    if (sel entry_path_r.err) {
        ret err[outcome.Fail].err{outcome.from_fail(entry_path_r.err)};
    }
    val entry_fqn: intern.StrId = entry_path_r.ok;

    readout.phase_begin(p.events, readout.PH_LOAD);
    val load_r: res[session.ModuleId, fail.Fail] = load.dfs_load(p, entry_fqn);
    if (sel load_r.err) {
        ret load.collect_loaded_parses(p, err[outcome.Fail].err{load_failure_of(p, load_r.err)});
    }

    if (p.roots == project.ROOT_UNION) {
        var ei: u32 = 0;
        for (ei < p.union_entry_count) {
            val ear: res[session.ModuleId, fail.Fail] = load.dfs_load(p, p.union_entries[ei]);
            if (sel ear.err) {
                ret load.collect_loaded_parses(p, err[outcome.Fail].err{load_failure_of(p, ear.err)});
            }
            ei = ei + 1;
        }
    }

    p.emit_len = p.topo_len;

    var xi: u32 = 0;
    for (xi < extra_root_count) {
        val xr: res[session.ModuleId, fail.Fail] = load.dfs_load(p, extra_roots[xi]);
        if (sel xr.err) {
            ret load.collect_loaded_parses(p, err[outcome.Fail].err{load_failure_of(p, xr.err)});
        }
        xi = xi + 1;
    }

    if (p.roots == project.ROOT_TEST) {
        val allsrc_r: err[fail.Fail] = union.load_all_own_src(p);
        if (sel allsrc_r.err) {
            ret load.collect_loaded_parses(p, err[outcome.Fail].err{outcome.user_fail(allsrc_r.err)});
        }
    }

    if (passes.test_build(p)) { p.emit_len = p.topo_len; }

    readout.phase_dropped(p.events, readout.PH_LOAD, p.module_len - p.topo_len);
    readout.phase_end(p.events, readout.PH_LOAD, p.module_len, "module", "modules");

    val reg_r: err[fail.Fail] = load.register_module_asts(p);
    if (sel reg_r.err) {
        ret err[outcome.Fail].err{outcome.from_fail(reg_r.err)};
    }

    val cfg_in_r: err[fail.Fail] = passes.set_build_config_input(p);
    if (sel cfg_in_r.err) {
        ret err[outcome.Fail].err{outcome.from_fail(cfg_in_r.err)};
    }

    readout.phase_begin(p.events, readout.PH_RESOLVE);
    val resolve_r: err[outcome.Fail] = resolve_deferred_gate_load(p);
    close_resolve_row(p);
    if (sel resolve_r.err) { ret resolve_r; }

    val emb_r: err[fail.Fail] = union.register_embed_inputs(p);
    if (sel emb_r.err) {
        ret err[outcome.Fail].err{outcome.from_fail(emb_r.err)};
    }

    val final_resolve: res[bool, outcome.Fail] = resolve_query_phase(p, false, false);
    if (sel final_resolve.err) {
        ret err[outcome.Fail].err{final_resolve.err};
    }

    val exp_r: err[fail.Fail] = union.register_export_names(p);
    if (sel exp_r.err) {
        ret err[outcome.Fail].err{outcome.from_fail(exp_r.err)};
    }

    ret err[outcome.Fail].ok{};
}

pub fun run_gate_pass(p: *project.Project) res[bool, outcome.Fail] {
    ret resolve_query_phase(p, true, false);
}

fun resolve_query_phase(p: *project.Project, gates: bool, provisional: bool) res[bool, outcome.Fail] {
    val prepared: err[fail.Fail] = passes.prepare_resolve_pass(p);
    if (sel prepared.err) {
        ret res[bool, outcome.Fail].err{outcome.from_fail(prepared.err)};
    }
    var roots: Vector[query.QueryKey] = vector.init[query.QueryKey](p.alloc);
    fin { vector.dnit[query.QueryKey](?roots); }
    var i: u32 = 0;
    for (i < p.module_len) {
        val m: *project.ModuleEntry = ?p.modules[i];
        if (m.file_id == source.FILE_NIL) { i = i + 1; cnt; }
        val added: res[usize, A.Error] = vector.push[query.QueryKey](?roots,
            query.QueryKey{ kind: query.Q_PARSE, key: m.file_id::u64 });
        if (sel added.err) {
            ret res[bool, outcome.Fail].err{outcome.refused(added.err)};
        }
        i = i + 1;
    }
    val parse_count: usize = roots.len;
    val resolved: err[outcome.Fail] = append_phase_roots(p, ?roots, query.Q_RESOLVE, p.topo_len);
    if (sel resolved.err) {
        ret res[bool, outcome.Fail].err{resolved.err};
    }
    val exported: err[outcome.Fail] = append_phase_roots(p, ?roots, query.Q_EXPORTS, p.topo_len);
    if (sel exported.err) {
        ret res[bool, outcome.Fail].err{exported.err};
    }
    val begun: res[query.Operation, outcome.Fail] = project.begin_query_phase(p);
    if (sel begun.err) {
        ret res[bool, outcome.Fail].err{begun.err};
    }
    var computed: err[fail.Fail] = load.acquire_loaded_parses(p);
    val computed_ok: bool = sel computed.ok;
    if (computed_ok) { computed = passes.run_resolve_pass(p); }
    var result: err[outcome.Fail] = err[outcome.Fail].ok{};
    var changed: bool = false;
    if (sel computed.err) {
        result = err[outcome.Fail].err{outcome.from_fail(computed.err)};
    }
    or (gates) {
        val evaluated: res[bool, fail.Fail] = passes.run_gate_pass(p);
        if (sel evaluated.err) {
            result = err[outcome.Fail].err{outcome.from_fail(evaluated.err)};
        }
        if (sel evaluated.ok) { changed = evaluated.ok; }
    }
    var count: usize = roots.len;
    if (provisional && sel result.ok) { count = parse_count; }
    val finished: err[outcome.Fail] = project.finish_query_phase(p,
        begun.ok, roots.data, count, result);
    if (sel finished.err) {
        ret res[bool, outcome.Fail].err{finished.err};
    }
    ret res[bool, outcome.Fail].ok{changed};
}

fun close_resolve_row(p: *project.Project) {
    var i: u32 = 0;
    for (i < p.topo_len) {
        val m: *project.ModuleEntry = ?p.modules[p.topo[i]::u32];
        readout.item_dur(p.events, readout.PH_RESOLVE, project.fqn_name(p, m.fqn), m.resolve_elapsed);
        m.resolve_elapsed = 0;
        i = i + 1;
    }
    readout.phase_end(p.events, readout.PH_RESOLVE, p.topo_len, "module", "modules");
}

fun resolve_deferred_gate_load(p: *project.Project) err[outcome.Fail] {
    for (true) {
        val gc: err[fail.Fail] = load.check_gated_const_imports(p);
        if (sel gc.err) { ret gate_load_user_fail(gc.err); }
        val deferred_before: u32 = load.deferred_gate_count(p);
        val decided_before:  u32 = passes.decided_gate_count(p);
        val changed_r: res[bool, outcome.Fail] = resolve_query_phase(p, true, deferred_before > 0);
        if (sel changed_r.err) {
            passes.clear_gate_results(p);
            ret err[outcome.Fail].err{changed_r.err};
        }
        var changed: bool = changed_r.ok;
        if (passes.decided_gate_count(p) != decided_before) { changed = true; }
        val deferred: u32 = load.deferred_gate_count(p);
        if (deferred == 0) {
            passes.clear_gate_results(p);
            ret err[outcome.Fail].ok{};
        }
        if (!changed) {
            p.gate_terminal = true;
            val fr: res[bool, outcome.Fail] = resolve_query_phase(p, false, false);
            p.gate_terminal = false;
            if (sel fr.err) {
                passes.clear_gate_results(p);
                ret err[outcome.Fail].err{fr.err};
            }
            passes.clear_gate_results(p);
            val status: fail.PhaseStatus = passes.frontend_status(p);
            if (sel status.kind.rejected) { ret err[outcome.Fail].err{outcome.reported()}; }
            if (sel status.kind.internal) { ret err[outcome.Fail].err{outcome.from_fail(fail.phase_failure(status))}; }
            ret err[outcome.Fail].err{outcome.internal("the terminal resolve pass decided nothing and reported nothing")};
        }

        var emit_roots: *session.ModuleId = nil;
        val emit_root_count: u32 = p.emit_len;
        if (emit_root_count > 0) {
            val er: res[*session.ModuleId, A.Error] = A.allocate[session.ModuleId](p.alloc, emit_root_count::usize);
            if (sel er.err) {
                passes.clear_gate_results(p);
                ret err[outcome.Fail].err{outcome.refused(er.err)};
            }
            emit_roots = er.ok;
            var ei: u32 = 0;
            for (ei < emit_root_count) { emit_roots[ei] = p.topo[ei]; ei = ei + 1; }
        }
        val resumed_r: res[bool, fail.Fail] = load.resume_deferred_gates(p);
        if (sel resumed_r.err) {
            if (emit_roots != nil) { A.deallocate[session.ModuleId](p.alloc, emit_roots, emit_root_count::usize); }
            passes.clear_gate_results(p);
            ret load.collect_loaded_parses(p, gate_load_user_fail(resumed_r.err));
        }
        val tr: err[fail.Fail] = load.rebuild_topo(p, emit_roots, emit_root_count);
        if (emit_roots != nil) { A.deallocate[session.ModuleId](p.alloc, emit_roots, emit_root_count::usize); }
        if (sel tr.err) {
            passes.clear_gate_results(p);
            ret gate_load_user_fail(tr.err);
        }
        val ar: err[fail.Fail] = load.register_module_asts(p);
        if (sel ar.err) {
            passes.clear_gate_results(p);
            ret gate_load_user_fail(ar.err);
        }
        passes.clear_gate_results(p);
        val ir: err[fail.Fail] = passes.invalidate_resolve_pass(p);
        if (sel ir.err) { ret gate_load_user_fail(ir.err); }
    }
    ret err[outcome.Fail].ok{};
}

fun gate_load_user_fail(f: fail.Fail) err[outcome.Fail] {
    if (sel f.reported) { ret err[outcome.Fail].err{outcome.reported()}; }
    ret err[outcome.Fail].err{outcome.from_fail(f)};
}

pub fun load_manifest(s: *session.Session, project_root: str) res[manifest.Manifest, outcome.Fail] {
    val mp_r: res[str, fail.Fail] = load.join_path(s.build_alloc, project_root, manifest.MANIFEST_FILE);
    if (sel mp_r.err) { ret res[manifest.Manifest, outcome.Fail].err{outcome.from_fail(mp_r.err)}; }
    val manifest_path: str = mp_r.ok;

    val toml_r: res[toml.Table, outcome.Fail] = ddep.parse_toml_file(s.build_alloc, manifest_path);
    str_free(s.build_alloc, manifest_path);
    if (sel toml_r.err) { ret res[manifest.Manifest, outcome.Fail].err{toml_r.err}; }
    var t: toml.Table = toml_r.ok;

    val mr: res[manifest.Manifest, outcome.Fail] = manifest.parse(s.build_alloc, ?s.interner, ?t, true);
    toml.dnit(s.build_alloc, ?t);
    if (sel mr.err) { ret mr; }
    var m: manifest.Manifest = mr.ok;

    val sk: err[outcome.Fail] = check_stack_keys(s, ?m);
    if (sel sk.err) {
        manifest.dnit(?m, s.build_alloc);
        ret res[manifest.Manifest, outcome.Fail].err{sk.err};
    }
    ret res[manifest.Manifest, outcome.Fail].ok{m};
}

fun check_stack_keys(s: *session.Session, m: *manifest.Manifest) err[outcome.Fail] {
    var i: u32 = 0;
    for (i < m.target_count) {
        val td: *manifest.TargetDef = ?m.targets[i];
        if (td.stack_reserve == 0 && td.stack_commit == 0) { i = i + 1; cnt; }

        val reg_r: err[outcome.Fail] = setup_registry_typed(?s.registry);
        if (sel reg_r.err) { ret reg_r; }

        val tr: res[target.Target, fail.Fail] = target.select_of(?s.registry,
            intern_or_empty(s, td.isa), intern_or_empty(s, td.os),
            intern_or_empty(s, td.abi), intern_or_empty(s, td.of));
        if (sel tr.err) { i = i + 1; cnt; }
        val t: target.Target = tr.ok;

        if (!t.of.carries_stack_size) {
            var key: str = "stack_reserve";
            if (td.stack_reserve == 0) { key = "stack_commit"; }
            ret err[outcome.Fail].err{outcome.user(stack_key_refusal(s, key, td.name, t.of.name))};
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun intern_or_empty(s: *session.Session, id: intern.StrId) str {
    val o: opt[str] = intern.lookup_typed(?s.interner, id);
    if (sel o.none) { ret ""; }
    ret o.some;
}

fun stack_key_refusal(s: *session.Session, key: str, tname: intern.StrId, of_name: str) str {
    val n: str = intern_or_empty(s, tname);
    val r: res[str, format.FormatError] = format.sprint(s.build_alloc,
        "mach.toml: [target.{}].{} is not expressible on the `{}` object format, which carries no stack size in its image headers",
        n, key, of_name);
    if (sel r.err) {
        ret "mach.toml: a stack size is not expressible on this target's object format";
    }
    ret r.ok;
}

pub fun build_project_sel(s: *session.Session, project_root: str, pick: *manifest.Selection) res[project.Project, outcome.Fail] {
    ret build_project_impl(s, project_root, pick, nil, nil, project.ROOT_ARTIFACT, true);
}

# the caller's request stands in for the composed one; steps still run
pub fun build_project_sel_req(s: *session.Session, project_root: str, pick: *manifest.Selection, req: *request.BuildRequest) res[project.Project, outcome.Fail] {
    ret build_project_impl(s, project_root, pick, nil, req, project.ROOT_ARTIFACT, true);
}

# translation shim (#3226): the legacy carrier for call sites in lanes that
# read it as such; removed with the last one
pub fun build_project_test(s: *session.Session, project_root: str, pick: *manifest.Selection) R.Result[project.Project, outcome.Fail] {
    ret outcome.lower_fail[project.Project](build_project_test_typed(s, project_root, pick));
}

pub fun build_project_test_typed(s: *session.Session, project_root: str, pick: *manifest.Selection) res[project.Project, outcome.Fail] {
    ret build_project_impl(s, project_root, pick, nil, nil, project.ROOT_TEST, true);
}

pub fun build_project_union(s: *session.Session, project_root: str) res[project.Project, outcome.Fail] {
    var pick: manifest.Selection;
    pick.target       = "";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    ret build_project_impl(s, project_root, ?pick, nil, nil, project.ROOT_UNION, false);
}

fun bind_queries(p: *project.Project) err[outcome.Fail] {
    val rt_r: res[query.QueryRuntime[project.Project], fail.Fail] = query.runtime[project.Project](?p.s.queries, query_compute);
    if (sel rt_r.err) {
        ret err[outcome.Fail].err{outcome.from_fail(rt_r.err)};
    }
    p.queries = rt_r.ok;
    if (!query.is_registered(?p.s.queries, query.Q_PARSE)) {
        val rp: err[fail.Fail] = query.register_derived_owned(?p.s.queries, query.Q_PARSE, load.q_parse_finalize);
        if (sel rp.err) { ret err[outcome.Fail].err{outcome.from_fail(rp.err)}; }
    }
    ret err[outcome.Fail].ok{};
}

fun load_failure(p: *project.Project, message: str) outcome.Fail {
    val status: fail.PhaseStatus = passes.frontend_status(p);
    if (!sel status.kind.accepted) { ret outcome.from_fail(fail.phase_failure(status)); }
    ret outcome.user(message);
}

# a load that failed: the frontend's recorded status wins over the loader's
# own failure, and a loader message is the user's
fun load_failure_of(p: *project.Project, f: fail.Fail) outcome.Fail {
    val status: fail.PhaseStatus = passes.frontend_status(p);
    if (!sel status.kind.accepted) { ret outcome.from_fail(fail.phase_failure(status)); }
    if (sel f.message) { ret outcome.user(f.message); }
    ret outcome.reported();
}
