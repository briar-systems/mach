}

# whether `actual` names `leaf` under `base` once both are cleaned
#[testing]
pub fun path_is(a: *A.Allocator, actual: str, base: str, leaf: str) bool {
    val joined: res[types_path.Path, A.Error] = types_path.join(a, base, leaf);
    if (sel joined.err) { ret false; }
    val expected: res[types_path.Path, A.Error] = types_path.clean(a, joined.ok);
    if (sel expected.err) { ret false; }
    val cleaned: res[types_path.Path, A.Error] = types_path.clean(a, actual);
    if (sel cleaned.err) { ret false; }
    ret str_equals(cleaned.ok, expected.ok);
}

test resolve_artifact_path__default_unknown_and_per_target {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val reg_made: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel reg_made.err) { ret 2; }
    val reg: *lang_target.TargetRegistry = reg_made.ok;

    var names:  [1]str              = [1]str{"main.mach"};
    var texts:  [1]str              = [1]str{"fun main() i32 { ret 0; }\n"};
    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 3; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    var pick: manifest.Selectors  = manifest.t_selectors("", "linux", "");
    val pr:   res[str, fail.Fail] = config.resolve_artifact_path(?alloc, reg, root, ?pick);
    if (sel pr.err)                                                     { ret 4; }
    if (!path_is(?alloc, pr.ok, root, "out/linux/debug/bin/uniontest")) { ret 5; }

    var unknown: manifest.Selectors  = manifest.t_selectors("nope", "linux", "");
    val refused: res[str, fail.Fail] = config.resolve_artifact_path(?alloc, reg, root, ?unknown);
    if (sel refused.ok) { ret 6; }

    # the artifact a target builds names its own output
    val split:   str                 = "[project]\nmach = \">=5\"\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/uniontest\"\ntargets = [\"linux\"]\nlink = []\nneed = []\n\n[artifact.uniontest-windows]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/uniontest.exe\"\ntargets = [\"windows\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
    val split_r: res[str, fail.Fail] = scaffold(?alloc, split, ?names[0], ?texts[0], 1);
    if (sel split_r.err) { ret 7; }
    val split_root: str = split_r.ok;
    fin { fs.remove_all(?alloc, split_root); }
    var windows:  manifest.Selectors  = manifest.t_selectors("", "windows", "");
    val split_pr: res[str, fail.Fail] = config.resolve_artifact_path(?alloc, reg, split_root, ?windows);
    if (sel split_pr.err)                                                                 { ret 8; }
    if (!path_is(?alloc, split_pr.ok, split_root, "out/windows/debug/bin/uniontest.exe")) { ret 9; }
    ret 0;
}

test build_project__selected_artifact_sets_the_root_module {
