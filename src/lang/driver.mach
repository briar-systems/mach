# each module's product of one kind, keyed as the kind's owner says: a file-keyed kind by the
# module's file, a module-keyed one by its stable id (a normal object's back-half key)
fun append_phase_roots(p: *project.Project, roots: *Vector[query.QueryKey],
    kind: *query.Kind, count: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < count) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        # a module the front end skips has only its parse and its restored object
        if (m.frontend_skipped && kind != ?frontend.PARSE && kind != ?passes.CODEGEN) {
            i = i + 1;
            cnt;
        }
        var key: u64 = module.stable_index(m.stable_id)::u64;
        if (kind.owner == query.KEY_FILE) { key = lang_source.file_index(m.file_id)::u64; }
        val added: res[usize, A.Error] = collections_vector.push[query.QueryKey](roots, query.QueryKey{kind: kind, key: key});
        if (sel added.err) {
            ret err[fail.Fail].err{fail.refused(added.err)};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun append_frontend_roots(p: *project.Project, roots: *Vector[query.QueryKey]) err[fail.Fail] {
    val parsed: err[fail.Fail] = append_phase_roots(p, roots, ?frontend.PARSE, p.topo_len);
    if (sel parsed.err) { ret parsed; }
    val resolved: err[fail.Fail] = append_phase_roots(p, roots, ?frontend.RESOLVE, p.topo_len);
    if (sel resolved.err) { ret resolved; }
    ret append_phase_roots(p, roots, ?frontend.SEMA, p.topo_len);
}

fun append_backend_roots(p: *project.Project, roots: *Vector[query.QueryKey],
    codegen: bool) err[fail.Fail] {
    val frontend: err[fail.Fail] = append_frontend_roots(p, roots);
    if (sel frontend.err) { ret frontend; }
    val surface: err[fail.Fail] = append_phase_roots(p, roots, ?passes.LOWERED_SURFACE, p.emit_len);
    if (sel surface.err) { ret surface; }
    val lowered: err[fail.Fail] = append_phase_roots(p, roots, ?passes.LOWER, p.emit_len);
    if (sel lowered.err) { ret lowered; }
    if (codegen)         { ret append_phase_roots(p, roots, ?passes.CODEGEN, p.emit_len); }
    ret err[fail.Fail].ok{};
}

# the backend's roots and each test object's lowering and codegen
pub fun append_test_roots(p: *project.Project, roots: *Vector[query.QueryKey]) err[fail.Fail] {
    val backend: err[fail.Fail] = append_backend_roots(p, roots, true);
    if (sel backend.err) { ret backend; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (passes.has_test_object(p, m)) {
            val lowered: res[usize, A.Error] = collections_vector.push[query.QueryKey](roots, query.QueryKey{kind: ?passes.LOWER, key: passes.test_key_for(m)});
            if (sel lowered.err) { ret err[fail.Fail].err{fail.refused(lowered.err)}; }
            val emitted: res[usize, A.Error] = collections_vector.push[query.QueryKey](roots, query.QueryKey{kind: ?passes.CODEGEN, key: passes.test_key_for(m)});
            if (sel emitted.err) { ret err[fail.Fail].err{fail.refused(emitted.err)}; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun run_query_pass(p: *project.Project, roots: *Vector[query.QueryKey],
    run: fun(*project.Project) err[fail.Fail]) err[fail.Fail] {
    val begun: res[query.Operation, fail.Fail] = frontend.begin_query_phase(p);
    if (sel begun.err) {
        ret err[fail.Fail].err{begun.err};
    }
    val result: err[fail.Fail] = run(p);
    ret frontend.finish_query_phase(p, begun.ok, roots.data, roots.len, result);
}

# a phase the query engine does not run is published as one it does: the
# project's diagnostics are refreshed beside its result
pub fun phase_finish(p: *project.Project,
    result: err[fail.Fail]) err[fail.Fail] {
    val refreshed: err[fail.Fail] = frontend.refresh_diagnostics(p);
    if (sel refreshed.err) {
        diagnostic.note_lost(?p.diags);
        diagnostic.note_lost(?p.s.diags);
        if (sel result.ok) { ret refreshed; }
    }
    ret result;
}

# a loaded project under another request from its host: the build context is frozen again, so
# what read the old one is computed again, and nothing reads a context no freeze captured
pub fun reconfigure(p: *project.Project, req: request.BuildRequest) err[fail.Fail] {
    p.req = req;
    ret context.freeze(p);
}

# a project that failed is released, its failure kept where the session presents it
fun project_failure(p: *project.Project, failure: fail.Fail) res[project.Project, fail.Fail] {
    var lost:   bool      = false;
    val stable: fail.Fail = session.hold_failure(p.s, failure, ?lost);
    if (lost) { diagnostic.note_lost(?p.diags); }
    val published: err[fail.Fail] = phase_finish(p, err[fail.Fail].err{stable});
    project.dnit_project(p);
    if (sel published.err) { ret res[project.Project, fail.Fail].err{published.err}; }
    ret res[project.Project, fail.Fail].err{stable};
}

pub fun run_sema_pass(p: *project.Project) err[fail.Fail] {
    project.set_origin(p, diagnostic.ORIGIN_SEMA);
    var roots: Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    val rooted: err[fail.Fail] = append_frontend_roots(p, ?roots);
    if (sel rooted.err) { ret rooted; }
    ret run_query_pass(p, ?roots, passes.run_sema_pass);
}

pub fun run_lower_pass(p: *project.Project) err[fail.Fail] {
    project.set_origin(p, diagnostic.ORIGIN_LOWER);
    val prepared: err[fail.Fail] = passes.prepare_lower_pass(p);
    if (sel prepared.err) { ret prepared; }
    var roots: Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    val rooted: err[fail.Fail] = append_backend_roots(p, ?roots, false);
    if (sel rooted.err) { ret rooted; }
    ret run_query_pass(p, ?roots, passes.run_lower_pass);
}

#[testing]
pub fun run_codegen_pass(p: *project.Project) err[fail.Fail] {
    project.set_origin(p, diagnostic.ORIGIN_CODEGEN);
    var roots: Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    val rooted: err[fail.Fail] = append_backend_roots(p, ?roots, true);
    if (sel rooted.err) { ret rooted; }
    ret run_query_pass(p, ?roots, passes.run_codegen_pass);
}

# a test build's test objects, lowered against the normal objects run_codegen_pass made
#[testing]
pub fun run_test_pass(p: *project.Project) err[fail.Fail] {
    var roots: Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    val rooted: err[fail.Fail] = append_test_roots(p, ?roots);
    if (sel rooted.err) { ret rooted; }
    ret run_query_pass(p, ?roots, passes.run_test_pass);
}

pub fun run_link_pass(p: *project.Project) res[bool, fail.Fail] {
    project.set_origin(p, diagnostic.ORIGIN_LINK);
    var roots: Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    val rooted: err[fail.Fail] = append_backend_roots(p, ?roots, true);
    if (sel rooted.err) {
        ret res[bool, fail.Fail].err{rooted.err};
    }
    val linked: res[usize, A.Error] = collections_vector.push[query.QueryKey](?roots, query.QueryKey{kind: ?passes.LINK, key: 0});
    if (sel linked.err) {
        ret res[bool, fail.Fail].err{fail.refused(linked.err)};
    }
    val begun: res[query.Operation, fail.Fail] = frontend.begin_query_phase(p);
    if (sel begun.err) {
        ret res[bool, fail.Fail].err{begun.err};
    }
    val result:   res[bool, fail.Fail] = passes.run_link_pass(p);
    val finished: err[fail.Fail]       = frontend.finish_query_phase(p,
        begun.ok, roots.data, roots.len, fail.unit[bool](result));
    if (sel finished.err) {
        ret res[bool, fail.Fail].err{finished.err};
    }
    ret result;
}

# load the manifest at `project_root`, begin the one cell `selectors` names in it and
# load its artifact's closure
pub fun build_project(s: *session.Session, project_root: str, selectors: *manifest.Selectors) res[project.Project, fail.Fail] {
    val mr: res[manifest.Manifest, fail.Fail] = load_manifest(s, project_root);
    if (sel mr.err) {
        ret res[project.Project, fail.Fail].err{mr.err};
    }
    var m: manifest.Manifest = mr.ok;
    fin { manifest.dnit(?m, s.build_alloc); }
    val cell: res[manifest.Cell, fail.Fail] = manifest.resolve_cell(s.build_alloc, ?s.interner, ?m, selectors,
        manifest.ARTIFACT_DEFAULT_ONE, "this command builds one artifact");
    if (sel cell.err) { ret res[project.Project, fail.Fail].err{cell.err}; }
    var c:       manifest.Cell                   = cell.ok;
    val begin_r: res[project.Project, fail.Fail] = begin_build_impl(s, project_root, ?c, ?m, nil, nil, nil, project.ROOT_ARTIFACT);
    if (sel begin_r.err) { ret begin_r; }
    var p: project.Project = begin_r.ok;

    val load_r: err[fail.Fail] = run_load_phase(?p);
    if (sel load_r.err) {
        ret project_failure(?p, load_r.err);
    }

    ret res[project.Project, fail.Fail].ok{p};
}

# locate a root manifest's dependency closure with no build cell configured, as a
# build locates it: every dependency under dep/, its manifest and its direct
# edges, and nothing is checked against git or the pins
# ---
# s:            the session; its build allocator owns the closure
# m:            the root manifest
# project_root: the root project's directory
# unrealized:   what a dependency nothing is realized for is
# ret:          the closure, released with `project.closure_dnit`
pub fun closure_locate(s: *session.Session, m: *manifest.Manifest, project_root: str,
    unrealized: driver_closure.Unrealized) res[project.Closure, fail.Fail] {
    ret closure_of(s, m, project_root, nil, unrealized);
}

# locate a root manifest's dependency closure as `closure_locate` does, holding every edge
# to `check` as it is located, as `mach dep verify` does
# ---
# check: what each located edge is held to
# ret:   the closure; err naming the first edge that does not locate or does not hold
pub fun closure_checked(s: *session.Session, m: *manifest.Manifest, project_root: str,
    check: *driver_closure.Check) res[project.Closure, fail.Fail] {
    ret closure_of(s, m, project_root, check, driver_closure.UNREALIZED_REFUSED);
}

fun closure_of(s: *session.Session, m: *manifest.Manifest, project_root: str,
    check: *driver_closure.Check, unrealized: driver_closure.Unrealized) res[project.Closure, fail.Fail] {
    val composed: err[fail.Fail] = registry_composed();
    if (sel composed.err) { ret res[project.Closure, fail.Fail].err{composed.err}; }
    ret driver_closure.locate(s, s.build_alloc, m, project_root, check, unrealized);
}

# the driver resolves targets only through the registry the toolchain composed
fun registry_composed() err[fail.Fail] {
    val composed: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel composed.err) { ret err[fail.Fail].err{composed.err}; }
    ret err[fail.Fail].ok{};
}

# begin the build the request names: every goal, a test goal included, loads the
# selected artifact's closure
# ---
# m:       the root manifest the cell was planned from
# closure: `m`'s closure as the plan located it, which the project borrows
pub fun begin_build(s: *session.Session, m: *manifest.Manifest, closure: *project.Closure, req: *request.BuildRequest,
    progress: *readout.Progress) res[project.Project, fail.Fail] {
    ret begin_build_roots(s, m, closure, req, progress, project.ROOT_ARTIFACT);
}

fun begin_build_roots(s: *session.Session, m: *manifest.Manifest, closure: *project.Closure, req: *request.BuildRequest,
    progress: *readout.Progress, roots: project.RootSet) res[project.Project, fail.Fail] {
    val cell: res[manifest.Cell, fail.Fail] = request_cell(s, m, req);
    if (sel cell.err) { ret res[project.Project, fail.Fail].err{cell.err}; }
    var c: manifest.Cell = cell.ok;
    ret begin_build_impl(s, req.project_root, ?c, m, closure, req, progress, roots);
}

# the cell a request names: a dependency's cell exactly as its plan named it, and
# a root cell resolved from the request's names, so a request naming no artifact
# takes the one the default selection holds
fun request_cell(s: *session.Session, m: *manifest.Manifest, req: *request.BuildRequest) res[manifest.Cell, fail.Fail] {
    if (!str_empty(req.owner)) { ret res[manifest.Cell, fail.Fail].ok{manifest.cell_of(req.artifact, req.target, req.profile)}; }
    val made: res[manifest.Selectors, fail.Fail] = manifest.selectors_of(s.alloc, req.artifact, req.target, req.profile);
    if (sel made.err) { ret res[manifest.Cell, fail.Fail].err{made.err}; }
    var selectors: manifest.Selectors = made.ok;
    fin { manifest.selectors_dnit(?selectors); }
    ret manifest.resolve_cell(s.alloc, ?s.interner, m, ?selectors, manifest.ARTIFACT_DEFAULT_ONE, "this command builds one artifact");
}

pub def FrontendPhase: u8;
pub val FRONTEND_PARSE:   FrontendPhase = 0;
pub val FRONTEND_RESOLVE: FrontendPhase = 1;
pub val FRONTEND_SEMA:    FrontendPhase = 2;

# frontend analysis for tools: the project comes back whenever the frontend
# ran, whatever its phases decided, so a consumer can read the trees, resolve
# results and sema results beside the diagnostics. every module that reached
# a phase carries that phase's product on its ModuleEntry even when the
# module's own query was rejected; the standing is frontend.frontend_status(p).
# a rejected phase ends the analysis at that phase; err is an operational
# failure only (an unreadable manifest, allocation, I/O)
# ---
# s:                the session
# m:                the loaded manifest
# req:              the build request selecting target, profile and artifact
# roots:            the root set the frontend loads: `project.ROOT_ARTIFACT` is the
#                   selected artifact's closure, `project.ROOT_UNION` every artifact's
#                   with the modules only a foreign target reaches gated out and
#                   `{artifact.<id>.out}` resolving over every artifact some artifact
#                   needs
# extra_roots:      module fqns loaded beside the root set's entries, nil with count 0
# extra_root_count: how many extra roots
# phase:            the last frontend phase to run
# ret:              the project, released by the caller with project.dnit_project
pub fun analyze_project_tolerant(s: *session.Session, m: *manifest.Manifest, req: *request.BuildRequest,
    roots: project.RootSet, extra_roots: *intern.StrId, extra_root_count: u32, phase: FrontendPhase) res[project.Project, fail.Fail] {
    if (phase > FRONTEND_SEMA) { ret res[project.Project, fail.Fail].err{fail.message("unknown frontend analysis phase")}; }
    if (roots != project.ROOT_ARTIFACT && roots != project.ROOT_UNION) {
        ret res[project.Project, fail.Fail].err{fail.unknown_catalog(s.alloc, "RootSet", roots::u32)};
    }
    if (extra_root_count > 0 && extra_roots == nil) {
        ret res[project.Project, fail.Fail].err{fail.message(
            "driver: frontend analysis root count requires a root array")};
    }

    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(s.alloc);

    val begin_r: res[project.Project, fail.Fail] = begin_build_roots(s, m, nil, req, nil, roots);
    if (sel begin_r.err) { ret begin_r; }
    var p: project.Project = begin_r.ok;

    if (phase == FRONTEND_PARSE) {
        val parsed: err[fail.Fail] = parse_project_roots(?p, extra_roots, extra_root_count);
        if (sel parsed.err) { ret phase_decided(?p, parsed.err); }
        ret res[project.Project, fail.Fail].ok{p};
    }

    val load_r: err[fail.Fail] = run_load_phase_roots(?p, extra_roots, extra_root_count);
    if (sel load_r.err) { ret phase_decided(?p, load_r.err); }

    if (phase == FRONTEND_RESOLVE) {
        val current: err[fail.Fail] = resolve_query_phase(?p);
        if (sel current.err) { ret phase_decided(?p, current.err); }
        ret res[project.Project, fail.Fail].ok{p};
    }

    val sema_r: err[fail.Fail] = run_sema_pass(?p);
    if (sel sema_r.err) { ret phase_decided(?p, sema_r.err); }

    ret res[project.Project, fail.Fail].ok{p};
}

# a phase that did not finish: a rejection keeps the project, everything else
# releases it
fun phase_decided(p: *project.Project, failure: fail.Fail) res[project.Project, fail.Fail] {
    if (fail.is_reported(failure)) {
        ret res[project.Project, fail.Fail].ok{@p};
    }
    ret project_failure(p, failure);
}

fun parse_project_roots(p: *project.Project, roots: *intern.StrId, count: u32) err[fail.Fail] {
    val selected: err[fail.Fail] = config.select_target(p, p.target_entry);
    if (sel selected.err) { ret phase_finish(p, err[fail.Fail].err{selected.err}); }
    var entry:          intern.StrId  = intern.STR_NIL;
    var selected_roots: *intern.StrId = roots;
    var selected_count: u32           = count;
    if (selected_count == 0) {
        val name: res[intern.StrId, fail.Fail] = driver_load.entry_module_fqn(p, p.target_entry);
        if (sel name.err) { ret phase_finish(p, err[fail.Fail].err{name.err}); }
        entry          = name.ok;
        selected_roots = ?entry;
        selected_count = 1;
    }
    var i: u32 = 0;
    for (i < selected_count) {
        val loaded: res[session.ModuleId, fail.Fail] = driver_load.module_open(p, selected_roots[i]);
        if (sel loaded.err) {
            var failure: fail.Fail = load_failure_of(p, loaded.err);
            if (count == 0) { failure = entry_failure(p, entry, p.config.bin_name, p.target_entry.entry_at, failure); }
            ret retain_loaded(p, driver_load.collect_loaded_parses(p, err[fail.Fail].err{failure}));
        }
        i = i + 1;
    }
    ret retain_loaded(p, driver_load.collect_loaded_parses(p, err[fail.Fail].ok{}));
}

fun begin_build_impl(s: *session.Session, project_root: str, c: *manifest.Cell, m: *manifest.Manifest, closure: *project.Closure,
    req: *request.BuildRequest, progress: *readout.Progress, roots: project.RootSet) res[project.Project, fail.Fail] {
    val composed: err[fail.Fail] = registry_composed();
    if (sel composed.err) { ret res[project.Project, fail.Fail].err{composed.err}; }
    if (req != nil) {
        val valid: err[fail.Fail] = request.validate(s.alloc, req);
        if (sel valid.err) {
            ret res[project.Project, fail.Fail].err{valid.err};
        }
    }
    var p: project.Project;
    project.init_project(?p, s);
    if (req != nil) { p.req = @req; }
    p.progress = progress;
    p.roots    = roots;

    val for_union: bool = roots == project.ROOT_UNION;

    var owner: str = "";
    if (req != nil) { owner = req.owner; }
    val cfg_r: err[fail.Fail] = config.load_config_manifest(?p, project_root, m, closure, c, owner, for_union);
    if (sel cfg_r.err) {
        ret project_failure(?p, cfg_r.err);
    }

    val te: *project.TargetEntry = p.target_entry;
    if (te == nil) {
        ret project_failure(?p, fail.message("internal: manifest selected no target"));
    }

    if (req == nil) {
        p.req              = request.defaults();
        p.req.project_root = project_root;
        if (te.optimize) { p.req.opt = request.OPT_RELEASE; }
    }

    val published: err[fail.Fail] = phase_finish(?p, err[fail.Fail].ok{});
    if (sel published.err) {
        ret project_failure(?p, published.err);
    }

    ret res[project.Project, fail.Fail].ok{p};
}

pub fun run_load_phase(p: *project.Project) err[fail.Fail] {
    ret run_load_phase_roots(p, nil, 0);
}

fun run_load_phase_roots(p: *project.Project, extra_roots: *intern.StrId,
    extra_root_count: u32) err[fail.Fail] {
    ret phase_finish(p, retain_loaded(p, load_phase_impl(p, extra_roots, extra_root_count)));
}

# whatever the load decided, the session keeps what it reached and retires what nothing holds any more
# a load the walk finished but rejected (a `use` that names nothing) is a rejected
# round like a failed one: the last accepted build's holdings stay
fun retain_loaded(p: *project.Project, result: err[fail.Fail]) err[fail.Fail] {
    val standing: fail.PhaseStatus = frontend.load_status(p);
    val rejected: bool             = sel result.err || !sel standing.kind.accepted;
    val kept:     err[fail.Fail]   = passes.retain_modules(p, rejected);
    # a rejected load reports its own failure first; a retention failure beside it only keeps products
    # longer than needed, never serves a wrong one, so it is counted as a lost report rather than replacing it
    if (sel result.err) {
        if (sel kept.err) {
            diagnostic.note_lost(?p.diags);
            diagnostic.note_lost(?p.s.diags);
        }
        ret result;
    }
    if (sel kept.err) { ret err[fail.Fail].err{kept.err}; }
    ret result;
}

fun load_phase_impl(p: *project.Project, extra_roots: *intern.StrId,
    extra_root_count: u32) err[fail.Fail] {
    val te: *project.TargetEntry = p.target_entry;

    val fp_r: err[fail.Fail] = config.select_target(p, te);
    if (sel fp_r.err) {
        ret err[fail.Fail].err{fp_r.err};
    }

    val entry_path_r: res[intern.StrId, fail.Fail] = driver_load.entry_module_fqn(p, te);
    if (sel entry_path_r.err) {
        ret err[fail.Fail].err{entry_path_r.err};
    }
    val entry_fqn: intern.StrId = entry_path_r.ok;

    readout.phase_begin(p.progress, readout.LOAD);
    project.set_origin(p, diagnostic.ORIGIN_LOAD);
    val load_r: res[session.ModuleId, fail.Fail] = driver_load.module_load(p, entry_fqn);
    if (sel load_r.err) {
        val failure: fail.Fail = entry_failure(p, entry_fqn, p.config.bin_name, te.entry_at, load_failure_of(p, load_r.err));
        ret driver_load.collect_loaded_parses(p, err[fail.Fail].err{failure});
    }

    if (p.roots == project.ROOT_UNION) {
        # under the union each artifact's walk attributes the modules it reaches first, so
        # a module of `shaded` reads `$bin.name == "shaded"` in a session rooted at `hello`;
        # the primary entry loaded first, so a module its walk reaches is the primary's
        val cell_artifact: intern.StrId = p.loader.artifact;
        var ei:            u32          = 0;
        for (ei < p.union_entry_count) {
            p.loader.artifact = p.union_entries[ei].artifact;
            val ue:  *project.ArtifactEntry           = ?p.union_entries[ei];
            val ear: res[session.ModuleId, fail.Fail] = driver_load.module_load(p, ue.fqn);
            if (sel ear.err) {
                p.loader.artifact = cell_artifact;
                val failure: fail.Fail = entry_failure(p, ue.fqn, ue.artifact, ue.at, load_failure_of(p, ear.err));
                ret driver_load.collect_loaded_parses(p, err[fail.Fail].err{failure});
            }
            ei = ei + 1;
        }
        # the artifacts this target does not build come next, so a module both reach is
        # this build's and one only they reach is gated out of it
        p.loader.foreign = true;
        var fi_: u32 = 0;
        for (fi_ < p.foreign_entry_count) {
            p.loader.artifact = p.foreign_entries[fi_].artifact;
            val fo:  *project.ArtifactEntry           = ?p.foreign_entries[fi_];
            val far: res[session.ModuleId, fail.Fail] = driver_load.module_load(p, fo.fqn);
            if (sel far.err) {
                p.loader.foreign  = false;
                p.loader.artifact = cell_artifact;
                val failure: fail.Fail = entry_failure(p, fo.fqn, fo.artifact, fo.at, load_failure_of(p, far.err));
                ret driver_load.collect_loaded_parses(p, err[fail.Fail].err{failure});
            }
            fi_ = fi_ + 1;
        }
        p.loader.foreign  = false;
        p.loader.artifact = cell_artifact;
    }

    p.emit_len = p.topo_len;

    var xi: u32 = 0;
    for (xi < extra_root_count) {
        val xr: res[session.ModuleId, fail.Fail] = driver_load.module_load(p, extra_roots[xi]);
        if (sel xr.err) {
            ret driver_load.collect_loaded_parses(p, err[fail.Fail].err{load_failure_of(p, xr.err)});
        }
        xi = xi + 1;
    }

    if (passes.test_build(p)) { p.emit_len = p.topo_len; }

    if (p.loader.dirty) {
        val ordered: err[fail.Fail] = reorder_topo(p);
        if (sel ordered.err) { ret ordered; }
    }

    val reg_r: err[fail.Fail] = driver_load.register_module_asts(p);
    if (sel reg_r.err) {
        ret err[fail.Fail].err{reg_r.err};
    }

    val cfg_in_r: err[fail.Fail] = context.freeze(p);
    if (sel cfg_in_r.err) {
        ret err[fail.Fail].err{cfg_in_r.err};
    }

    close_load_row(p);

    val strings_r: err[fail.Fail] = declared.decorator_strings_register(p);
    if (sel strings_r.err) {
        ret err[fail.Fail].err{strings_r.err};
    }
    val emb_r: err[fail.Fail] = declared.register_embed_inputs(p);
    if (sel emb_r.err) {
        ret err[fail.Fail].err{emb_r.err};
    }

    {
        readout.phase_begin(p.progress, readout.RESOLVE);
        fin { close_resolve_row(p); }
        val cached: err[fail.Fail] = passes.prepare_object_cache(p);
        if (sel cached.err) { ret err[fail.Fail].err{cached.err}; }
        val final_resolve: err[fail.Fail] = resolve_query_phase(p);
        if (sel final_resolve.err) { ret err[fail.Fail].err{final_resolve.err}; }
    }

    val exp_r: err[fail.Fail] = declared.register_export_names(p);
    if (sel exp_r.err) {
        ret err[fail.Fail].err{exp_r.err};
    }

    ret err[fail.Fail].ok{};
}

# re-derive a loaded project's frontend after one module's text changed, without
# reloading its closure. the module is reparsed and re-walked in place; when its load
# surface survived (driver_load.module_reload), the module set and topo are as loaded and
# the query phases rerun over them, so every unchanged module's resolve and sema are
# hits and only the edited module and its dependents recompute. a surface that did
# not survive is reported as ok(false): the caller reloads
# ---
# p:     the loaded project, at least at FRONTEND_RESOLVE
# mid:   the module whose text changed
# phase: the frontend phase to re-derive to, at most the one the project was loaded to
# ret:   ok(true) when refreshed, a rejection included since the project's standing carries it;
#        ok(false) when the caller must reload; or the internal failure
pub fun refresh_frontend(p: *project.Project, mid: session.ModuleId, phase: FrontendPhase) res[bool, fail.Fail] {
    if (phase > FRONTEND_SEMA) { ret res[bool, fail.Fail].err{fail.message("unknown frontend analysis phase")}; }
    if (module.is_nil(mid) || mid::u32 >= project.module_count(p)) {
        ret res[bool, fail.Fail].err{fail.message("driver: refresh names a module outside the loaded project")};
    }
    val s: *session.Session     = p.s;
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(s.alloc);
    diagnostic.drop_file(?p.diags, m.file_id);
    val syn: *ast.Ast = frontend.syntax(p, m);
    if (syn != nil) { linkage.forget_export_names(?p.linkage, mid, syn.decls.len::u32); }

    project.set_origin(p, diagnostic.ORIGIN_LOAD);
    val kept: res[bool, fail.Fail] = driver_load.module_reload(p, mid);
    if (sel kept.err) { ret res[bool, fail.Fail].err{kept.err}; }
    if (!kept.ok)     { ret res[bool, fail.Fail].ok{false}; }

    val derived: err[fail.Fail] = refresh_phases(p, phase);
    val kept_r:  err[fail.Fail] = retain_loaded(p, derived);
    val fin_r:   err[fail.Fail] = phase_finish(p, kept_r);
    # a rejection is a refreshed project whose diagnostics say so, as under the tolerant load
    if (sel fin_r.err) {
        if (!fail.is_reported(fin_r.err)) { ret res[bool, fail.Fail].err{fin_r.err}; }
    }
    ret res[bool, fail.Fail].ok{true};
}

# the phases after the load walk, over a project whose module set is settled
fun refresh_phases(p: *project.Project, phase: FrontendPhase) err[fail.Fail] {
    cache.forget(p);
    val reg_r: err[fail.Fail] = driver_load.register_module_asts(p);
    if (sel reg_r.err) { ret err[fail.Fail].err{reg_r.err}; }
    val strings_r: err[fail.Fail] = declared.decorator_strings_register(p);
    if (sel strings_r.err) { ret err[fail.Fail].err{strings_r.err}; }
    val emb_r: err[fail.Fail] = declared.register_embed_inputs(p);
    if (sel emb_r.err) { ret err[fail.Fail].err{emb_r.err}; }
    val resolved: err[fail.Fail] = resolve_query_phase(p);
    if (sel resolved.err) { ret err[fail.Fail].err{resolved.err}; }
    val exp_r: err[fail.Fail] = declared.register_export_names(p);
    if (sel exp_r.err)          { ret err[fail.Fail].err{exp_r.err}; }
    if (phase == FRONTEND_SEMA) { ret run_sema_pass(p); }
    ret err[fail.Fail].ok{};
}

fun resolve_query_phase(p: *project.Project) err[fail.Fail] {
    project.set_origin(p, diagnostic.ORIGIN_RESOLVE);
    # what the load walk decided for each module is an input the resolution reads
    val viewed: err[fail.Fail] = frontend.record_load_views(p);
    if (sel viewed.err) { ret viewed; }
    var roots: Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        if (lang_source.file_is_nil(m.file_id)) {
            i = i + 1;
            cnt;
        }
        val added: res[usize, A.Error] = collections_vector.push[query.QueryKey](?roots,
            query.QueryKey{kind: ?frontend.PARSE, key: lang_source.file_index(m.file_id)::u64});
        if (sel added.err) {
            ret err[fail.Fail].err{fail.refused(added.err)};
        }
        i = i + 1;
    }
    val resolved: err[fail.Fail] = append_phase_roots(p, ?roots, ?frontend.RESOLVE, p.topo_len);
    if (sel resolved.err) { ret resolved; }
    val exported: err[fail.Fail] = append_phase_roots(p, ?roots, ?frontend.EXPORTS, p.topo_len);
    if (sel exported.err) { ret exported; }
    val begun: res[query.Operation, fail.Fail] = frontend.begin_query_phase(p);
    if (sel begun.err) {
        ret err[fail.Fail].err{begun.err};
    }
    var computed:    err[fail.Fail] = driver_load.acquire_loaded_parses(p);
    val computed_ok: bool           = sel computed.ok;
    if (computed_ok) { computed = passes.run_resolve_pass(p); }
    var result: err[fail.Fail] = err[fail.Fail].ok{};
    if (sel computed.err) {
        result = err[fail.Fail].err{computed.err};
    }
    ret frontend.finish_query_phase(p, begun.ok, roots.data, roots.len, result);
}

# a module walked again under a union tuple it was reached under late can import one the topo
# placed after it, so the topo is ordered again, the modules the build emits first
fun reorder_topo(p: *project.Project) err[fail.Fail] {
    var emit_roots:      *session.ModuleId = nil;
    val emit_root_count: u32               = p.emit_len;
    if (emit_root_count > 0) {
        val er: res[*session.ModuleId, A.Error] = A.allocate[session.ModuleId](p.alloc, emit_root_count::usize);
        if (sel er.err) { ret err[fail.Fail].err{fail.refused(er.err)}; }
        emit_roots = er.ok;
        var ei: u32 = 0;
        for (ei < emit_root_count) {
            emit_roots[ei] = p.topo[ei];
            ei             = ei + 1;
        }
    }
    val tr: err[fail.Fail] = driver_load.rebuild_topo(p, emit_roots, emit_root_count);
    if (emit_roots != nil) { A.deallocate[session.ModuleId](p.alloc, emit_roots, emit_root_count::usize); }
    ret tr;
}

fun close_load_row(p: *project.Project) {
    readout.phase_dropped(p.progress, readout.LOAD, project.module_count(p) - p.topo_len);
    readout.phase_end(p.progress, readout.LOAD, project.module_count(p), "module", "modules");
}

fun close_resolve_row(p: *project.Project) {
    readout.phase_end(p.progress, readout.RESOLVE, cache.frontend_count(p), "module", "modules");
}

# the root manifest of the project at `project_root`, read once: its text, an
# open buffer's when the session holds one, becomes the session's input for the
# file, so a warm session sees an edit to it as an input change, and the manifest
# records the input and the revision it was read at
# ---
# s:            the session; its build allocator owns the manifest
# project_root: the project root
# ret:          the manifest, released with `manifest.dnit`; err when it cannot be
#               read, does not parse or fails a check
pub fun load_manifest(s: *session.Session, project_root: str) res[manifest.Manifest, fail.Fail] {
    val path_r: res[str, A.Error] = types_path.join(s.build_alloc, project_root, manifest.MANIFEST_FILE);
    if (sel path_r.err) { ret res[manifest.Manifest, fail.Fail].err{fail.refused(path_r.err)}; }
    val path: str = path_r.ok;
    fin { str_free(s.build_alloc, path); }

    # the text read off disk is this call's; the session and the parse each keep their own copy
    var text:     str      = nil;
    var read_off: bool     = false;
    val buffered: opt[str] = session.overlay_get(s, path);
    if (sel buffered.some) { text = buffered.some; }
    or {
        val read: res[str, fs.FsError] = fs.read_string(s.build_alloc, path);
        if (sel read.err) {
            val said: res[str, fail.Fail] = fail.format(s.build_alloc, "cannot read '{}': {}", path, fail.fs_text(read.err));
            if (sel said.err) { ret res[manifest.Manifest, fail.Fail].err{said.err}; }
            ret res[manifest.Manifest, fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, said.ok)};
        }
        text     = read.ok;
        read_off = true;
    }
    fin {
        if (read_off) { str_free(s.build_alloc, text); }
    }
    val loaded: res[lang_source.FileId, fail.Fail] = session.load_source(s, path, text);
    if (sel loaded.err) { ret res[manifest.Manifest, fail.Fail].err{loaded.err}; }

    val parsed: res[manifest.Manifest, fail.Fail] = manifest.parse_text(s.build_alloc, ?s.interner, path, text);
    if (sel parsed.err) { ret parsed; }
    var m: manifest.Manifest = parsed.ok;
    m.source          = loaded.ok;
    m.source_revision = query.peek_revision(?s.queries, ?session.FILE_TEXT, lang_source.file_index(loaded.ok)::u64);

    val reg: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel reg.err) {
        manifest.dnit(?m, s.build_alloc);
        ret res[manifest.Manifest, fail.Fail].err{reg.err};
    }
    val sk: err[fail.Fail] = manifest.check_stack_keys(s.build_alloc, ?s.interner, reg.ok, ?m);
    if (sel sk.err) {
        manifest.dnit(?m, s.build_alloc);
        ret res[manifest.Manifest, fail.Fail].err{sk.err};
    }
    ret res[manifest.Manifest, fail.Fail].ok{m};
}

# a project under a fresh temporary root: the manifest `text`, and the `n`
# sources under src, each name a path relative to it whose directories are
# made; the caller removes the root with fs.remove_all
#[testing]
pub fun scaffold(alloc: *A.Allocator, text: str, names: *str, texts: *str, n: u32) res[str, fail.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, "mach_project");
    if (sel tf_r.err) { ret res[str, fail.Fail].err{fail.fs_refused(tf_r.err)}; }
    var tf:    fs.TempFile       = tf_r.ok;
    val dup_r: res[str, A.Error] = str_dup(alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel dup_r.err) { ret res[str, fail.Fail].err{fail.refused(dup_r.err)}; }
    val root: str = dup_r.ok;

    val src_r: res[str, A.Error] = types_path.join(alloc, root, "src");
    if (sel src_r.err) { ret res[str, fail.Fail].err{fail.refused(src_r.err)}; }
    val made_src: err[fs.FsError] = fs.create_dir_all(alloc, src_r.ok, 493);
    if (sel made_src.err) { ret res[str, fail.Fail].err{fail.fs_refused(made_src.err)}; }

    val mf_r: res[str, A.Error] = types_path.join(alloc, root, manifest.MANIFEST_FILE);
    if (sel mf_r.err) { ret res[str, fail.Fail].err{fail.refused(mf_r.err)}; }
    val wrote: err[fs.FsError] = fs.write_bytes(mf_r.ok, text, str_len(text), 420);
    if (sel wrote.err) { ret res[str, fail.Fail].err{fail.fs_refused(wrote.err)}; }

    var i: u32 = 0;
    for (i < n) {
        val fp: res[str, A.Error] = types_path.join(alloc, src_r.ok, names[i]);
        if (sel fp.err) { ret res[str, fail.Fail].err{fail.refused(fp.err)}; }
        val parent: res[str, A.Error] = types_path.parent(alloc, fp.ok);
        if (sel parent.err) { ret res[str, fail.Fail].err{fail.refused(parent.err)}; }
        val made: err[fs.FsError] = fs.create_dir_all(alloc, parent.ok, 493);
        if (sel made.err) { ret res[str, fail.Fail].err{fail.fs_refused(made.err)}; }
        val w: err[fs.FsError] = fs.write_bytes(fp.ok, texts[i], str_len(texts[i]), 420);
        if (sel w.err) { ret res[str, fail.Fail].err{fail.fs_refused(w.err)}; }
        i = i + 1;
    }
    ret res[str, fail.Fail].ok{root};
}

# a manifest for a test's project: the bin artifact `uniontest`, its entry `main.mach`, on a
# target for each os and isa the compiler builds, with a debug and a release profile
#[testing]
pub fun fixture_manifest() str {
    ret "[project]\nmach = \">=5\"\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[target.linux-arm64]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n\n[target.linux-riscv64]\nisa = \"riscv64\"\nos = \"linux\"\nabi = \"lp64d\"\n\n[target.darwin-x86_64]\nisa = \"x86_64\"\nos = \"darwin\"\nabi = \"sysv64\"\n\n[target.darwin-arm64]\nisa = \"aarch64\"\nos = \"darwin\"\nabi = \"aapcs64\"\n\n[target.bare-arm64]\nisa = \"aarch64\"\nbaseline = \"armv8-a+fp+simd\"\nos = \"freestanding\"\nabi = \"aapcs64\"\nof = \"elf\"\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/uniontest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
}

# the pieces joined in order in `alloc`, never released; a refused allocation ends the test
#[testing]
pub fun joined(alloc: *A.Allocator, va: ...) str {
    val made: res[str, types_string.StrError] = types_string.str_join(alloc, va...);
    if (sel made.ok) { ret made.ok; }
    panic("a fixture's text was refused\n");
    ret "";
}

# a project under a fresh temporary root, as `scaffold` writes it, loaded through
# `build_project` for the cell `target` names, the default when empty, as the
# documentation command loads one; the root is removed before this returns
#[testing]
pub fun scaffold_build(s: *session.Session, alloc: *A.Allocator, text: str, names: *str, texts: *str, n: u32,
    target: str) res[project.Project, fail.Fail] {
    val root: res[str, fail.Fail] = scaffold(alloc, text, names, texts, n);
    if (sel root.err) { ret res[project.Project, fail.Fail].err{root.err}; }
    fin { fs.remove_all(alloc, root.ok); }
    val made: res[manifest.Selectors, fail.Fail] = manifest.selectors_of(s.build_alloc, "", target, "");
    if (sel made.err) { ret res[project.Project, fail.Fail].err{made.err}; }
    var selectors: manifest.Selectors = made.ok;
    fin { manifest.selectors_dnit(?selectors); }
    ret build_project(s, root.ok, ?selectors);
}

# the cell `req` names begun through `begin_build` over the manifest at its project root,
# as a build begins it, and loaded; no step runs
#[testing]
pub fun begin_loaded(s: *session.Session, req: *request.BuildRequest) res[project.Project, fail.Fail] {
    val read: res[manifest.Manifest, fail.Fail] = load_manifest(s, req.project_root);
    if (sel read.err) { ret res[project.Project, fail.Fail].err{read.err}; }
    var m: manifest.Manifest = read.ok;
    fin { manifest.dnit(?m, s.build_alloc); }
    val begun: res[project.Project, fail.Fail] = begin_build(s, ?m, nil, req, nil);
    if (sel begun.err) { ret begun; }
    var p:      project.Project = begun.ok;
    val loaded: err[fail.Fail]  = run_load_phase(?p);
    if (sel loaded.err) { ret project_failure(?p, loaded.err); }
    ret res[project.Project, fail.Fail].ok{p};
}

# the project at `root` analyzed as an editor analyzes it, through `analyze_project_tolerant`
# over every artifact's closure on the cell `target` names, the default when empty, as far
# as `phase`; the project comes back whatever its phases decided
#[testing]
fun union_analysis(s: *session.Session, root: str, target: str, phase: FrontendPhase) res[project.Project, fail.Fail] {
    val read: res[manifest.Manifest, fail.Fail] = load_manifest(s, root);
    if (sel read.err) { ret res[project.Project, fail.Fail].err{read.err}; }
    var m: manifest.Manifest = read.ok;
    fin { manifest.dnit(?m, s.build_alloc); }
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = target;
    ret analyze_project_tolerant(s, ?m, ?req, project.ROOT_UNION, nil, 0, phase);
}

# a project under a fresh temporary root, as `scaffold` writes it, analyzed as
# `union_analysis` does on the default cell; the root is removed before this returns
#[testing]
fun scaffold_union(s: *session.Session, alloc: *A.Allocator, text: str, names: *str, texts: *str, n: u32,
    phase: FrontendPhase) res[project.Project, fail.Fail] {
    val root: res[str, fail.Fail] = scaffold(alloc, text, names, texts, n);
    if (sel root.err) { ret res[project.Project, fail.Fail].err{root.err}; }
    fin { fs.remove_all(alloc, root.ok); }
    ret union_analysis(s, root.ok, "", phase);
}

# a load that failed: the frontend's recorded status wins over the loader's
# own failure, and a loader message is the user's
fun load_failure_of(p: *project.Project, f: fail.Fail) fail.Fail {
    val status: fail.PhaseStatus = frontend.frontend_status(p);
    if (!sel status.kind.accepted) { ret fail.phase_failure(status); }
    ret fail.as_user(diagnostic_kind.SOURCE_LOAD, f);
}

# a load failure of the module an artifact's `entry` names: when the entry's own file could
# not be read, the failure names the key and points at where the manifest writes it
fun entry_failure(p: *project.Project, fqn: intern.StrId, artifact: intern.StrId, at: fail.Place, f: fail.Fail) fail.Fail {
    if (fail.kind_of(f) != diagnostic_kind.SOURCE_LOAD) { ret f; }
    if (!driver_load.module_unread(p, fqn))             { ret f; }
    val text: res[str, fail.Fail] = fail.format_intern(?p.s.interner, p.alloc, "mach.toml: [artifact.{}].entry: {}", intern.text(?p.s.interner, artifact), fail.describe(f));
    if (sel text.err) { ret text.err; }
    ret fail.at(p.alloc, fail.with_text(f, text.ok), at);
}

#[testing]
pub fun manifest_multi() str {
    ret "[project]\nmach = \">=5\"\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[artifact.alpha]\nkind = \"bin\"\nentry = \"alpha.mach\"\nout = \"{project.work}/bin/alpha\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.beta]\nkind = \"bin\"\nentry = \"beta.mach\"\nout = \"{project.work}/bin/beta\"\ntargets = [\"*\"]\nlink = []\nneed = []\ndefault = true\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
}

# text with NATIVE_OS spelled as the host os and FOREIGN_OS as another the union builds
#[testing]
fun union_native_text(alloc: *A.Allocator, text: str) res[str, fail.Fail] {
    val native:  u32 = lang_target.host_os_id();
    var name:    str = "$mach.os.linux";
    var foreign: str = "$mach.os.windows";
    if (native == catalog_os.WINDOWS) {
        name    = "$mach.os.windows";
        foreign = "$mach.os.linux";
    }
    or (native == catalog_os.DARWIN) { name = "$mach.os.darwin"; }
    val native_r: res[str, types_string.StrError] = str_replace(alloc, text, "NATIVE_OS", name);
    if (sel native_r.err) { ret res[str, fail.Fail].err{fail.str_refused(native_r.err)}; }
    val foreign_r: res[str, types_string.StrError] = str_replace(alloc, native_r.ok, "FOREIGN_OS", foreign);
    if (sel foreign_r.err) { ret res[str, fail.Fail].err{fail.str_refused(foreign_r.err)}; }
    ret res[str, fail.Fail].ok{foreign_r.ok};
}

# the fixture: a default `hello` that needs nothing, a `shaded` that
# needs every shader artifact, and a spirv-only `shader-vert` whose output
# `shaded` embeds
#[testing]
fun manifest_lessons() str {
    ret "[project]\nmach = \">=5\"\nid = \"lessons\"\nversion = \"0.1.0\"\nsrc = \"src\"\nwork = \"out\"\n\n[target.spirv]\nisa = \"spirv\"\nos = \"vulkan\"\nabi = \"spirv\"\nenv = \"vulkan1.0\"\n\n[target.linux-x86_64]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n\n[artifact.hello]\ndefault = true\nkind = \"bin\"\nentry = \"hello.mach\"\nout = \"{project.work}/bin/hello\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.shaded]\nkind = \"bin\"\nentry = \"shaded.mach\"\nout = \"{project.work}/bin/shaded\"\ntargets = [\"*\"]\nlink = []\nneed = [\"artifact.shader-*\"]\n\n[artifact.shader-vert]\nkind = \"bin\"\nentry = \"shaders/vert.mach\"\nout = \"{project.work}/spv/vert{artifact.suffix}\"\ntargets = [\"spirv\"]\nlink = []\nneed = []\n";
}

# the fixture on disk, with the shader entry under `src/shaders`
#[testing]
fun scaffold_lessons(alloc: *A.Allocator, shaded_text: str) res[str, fail.Fail] {
    var names: [2]str;
    names[0] = "hello.mach";
    names[1] = "shaded.mach";
    var texts: [2]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    texts[1] = shaded_text;
    val root_r: res[str, fail.Fail] = scaffold(alloc, manifest_lessons(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) { ret root_r; }
    val root:    str               = root_r.ok;
    val shaders: res[str, A.Error] = types_path.join(alloc, root, "src/shaders");
    if (sel shaders.err) { ret res[str, fail.Fail].err{fail.refused(shaders.err)}; }
    val made: err[fs.FsError] = fs.create_dir_all(alloc, shaders.ok, 493);
    if (sel made.err) { ret res[str, fail.Fail].err{fail.fs_refused(made.err)}; }
    val vert: res[str, A.Error] = types_path.join(alloc, shaders.ok, "vert.mach");
    if (sel vert.err) { ret res[str, fail.Fail].err{fail.refused(vert.err)}; }
    val text: str             = "#[output(0)] var out_colour: f32x4;\n\n#[stage(\"fragment\")]\nfun frag_main() { out_colour = f32x4{1.0, 1.0, 1.0, 1.0}; }\n";
    val w:    err[fs.FsError] = fs.write_bytes(vert.ok, text, str_len(text), 420);
    if (sel w.err) { ret res[str, fail.Fail].err{fail.fs_refused(w.err)}; }
    ret res[str, fail.Fail].ok{root};
}

# analyze the fixture rooted at the default artifact `hello` with `lessons.shaded`
# as an extra root, the way an editor session holds an open buffer of another
# artifact; the project comes back whatever sema decided
#[testing]
fun analyze_lessons(s: *session.Session, mf: *manifest.Manifest, root: str,
    roots: project.RootSet) res[project.Project, fail.Fail] {
    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "linux-x86_64";
    req.artifact     = "hello";
    req.goal         = request.GOAL_CHECK;
    val xid_r: res[intern.StrId, A.Error] = intern.add(?s.interner, "lessons.shaded");
    if (sel xid_r.err) { ret res[project.Project, fail.Fail].err{fail.refused(xid_r.err)}; }
    var extra_roots: [1]intern.StrId;
    extra_roots[0] = xid_r.ok;
    ret analyze_project_tolerant(s, mf, ?req, roots, ?extra_roots[0], 1, FRONTEND_SEMA);
}

#[testing]
fun union_gate_result_n(names: *str, texts: *str, count: u32, want_diag: str, forbid_diag: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), names, texts, count);
    if (sel root_r.err) { ret 1; }
    val root: str                             = root_r.ok;
    val pr:   res[project.Project, fail.Fail] = union_analysis(?s, root, "", FRONTEND_RESOLVE);
    fs.remove_all(?alloc, root);
    if (sel pr.err) { ret 1; }
    var p:   project.Project = pr.ok;
    var bad: i32             = 0;
    if (str_len(want_diag) == 0 && diagnostic.error_count(?s.diags) != 0)         { bad = 2; }
    if (str_len(want_diag) > 0 && !diagnostic.error_says(?s.diags, want_diag))    { bad = 3; }
    if (str_len(forbid_diag) > 0 && diagnostic.error_says(?s.diags, forbid_diag)) { bad = 4; }
    project.dnit_project(?p);
    ret bad;
}

#[testing]
fun first_gate_cond(a: *ast.Ast) ast_id.ExprId {
    val m_opt: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel m_opt.none) { ret ast_id.EXPR_NIL; }
    val mnode: *ast_module.Module = m_opt.some;
    var i:     u32                = 0;
    for (i < mnode.decls_len) {
        val did:   ast_id.DeclId       = a.decl_ids.data[mnode.decls_start + i];
        val d_opt: opt[*ast_decl.Decl] = ast.get_decl(a, did);
        if (sel d_opt.some) {
            val d: *ast_decl.Decl = d_opt.some;
            if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF && d.data.comptime_if.branches_len > 0) {
                ret (?a.comptime_branches.data[d.data.comptime_if.branches_start]).cond;
            }
        }
        i = i + 1;
    }
    ret ast_id.EXPR_NIL;
}

# a union analysis on a live session, as the editor rebuilds it after each edit
#[testing]
fun gate_rebuild(s: *session.Session, root: str) res[project.Project, fail.Fail] {
    val pr: res[project.Project, fail.Fail] = union_analysis(s, root, "", FRONTEND_RESOLVE);
    if (sel pr.err) { ret pr; }
    var p:  project.Project = pr.ok;
    val se: err[fail.Fail]  = run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, fail.Fail].err{se.err};
    }
    ret res[project.Project, fail.Fail].ok{p};
}

#[testing]
fun write_source(alloc: *A.Allocator, root: str, name: str, text: str) bool {
    val file: res[str, fail.Fail] = fail.join(alloc, root, "/src/", name);
    if (sel file.err) { ret false; }
    val wrote: err[fs.FsError] = fs.write_bytes(file.ok, text, str_len(text), 420);
    ret sel wrote.ok;
}

# texts may name NATIVE_OS and FOREIGN_OS, spelled per host by union_native_text
#[testing]
fun gate_session(alloc: *A.Allocator, names: *str, texts: *str, n: u32, s: *session.Session) res[str, fail.Fail] {
    var i: u32 = 0;
    for (i < n) {
        val spelled: res[str, fail.Fail] = union_native_text(alloc, texts[i]);
        if (sel spelled.err) { ret spelled; }
        texts[i] = spelled.ok;
        i        = i + 1;
    }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret res[str, fail.Fail].err{sr.err}; }
    @s = sr.ok;
    val root_r: res[str, fail.Fail] = scaffold(alloc, fixture_manifest(), names, texts, n);
    if (sel root_r.err) {
        session.dnit(s);
        ret root_r;
    }
    ret root_r;
}

#[testing]
val VIEW_CFG_ON: str = "pub val FLAG: u8 = 1;\n";

#[testing]
val VIEW_CFG_OFF: str = "pub val FLAG: u8 = 0;\n";

#[testing]
fun ctx(p: *project.Project, s: *session.Session, fqn: str) *comptime.ComptimeCtx {
    val idr: res[intern.StrId, A.Error] = intern.add(?s.interner, fqn);
    if (sel idr.err) { ret nil; }
    var id: intern.StrId           = idr.ok;
    val mr: opt[*session.ModuleId] = map.get[intern.StrId, session.ModuleId](?p.loader.by_name, ?id);
    if (sel mr.none) { ret nil; }
    val mid: session.ModuleId     = @mr.some;
    val m:   *project.ModuleEntry = project.module_at(p, mid::u32);
    ret ?m.load.ctx;
}

# a union analysis resolves `{artifact.<id>.out}` over every artifact some artifact
# needs: an open `shaded.mach` beside the default `hello` embeds the shader output
# `shaded` needs, and an artifact nobody needs is still refused
test union_analysis__resolves_artifact_requirements_project_wide {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val shaded: str                 = "#[embed(\"{artifact.shader-vert.out}\")]\nval VERT: [_]u8;\n\nfun main() i32 { ret VERT[0]::i32; }\n";
    val root_r: res[str, fail.Fail] = scaffold_lessons(?alloc, shaded);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    val mr: res[manifest.Manifest, fail.Fail] = load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var mf: manifest.Manifest = mr.ok;
    fin { manifest.dnit(?mf, ?alloc); }

    var bad: i32 = 0;

    # the artifact root set checks shaded.mach against hello's `need`, which is empty
    val narrow: res[project.Project, fail.Fail] = analyze_lessons(?s, ?mf, root, project.ROOT_ARTIFACT);
    if (sel narrow.err) { ret 2; }
    var np: project.Project = narrow.ok;
    if (!diagnostic.error_says(?s.diags, "does not require")) { bad = 3; }
    project.dnit_project(?np);

    # the union resolves the template in the requirements of the artifact that needs it;
    # the only complaint left is the output no check ever writes
    val wide: res[project.Project, fail.Fail] = analyze_lessons(?s, ?mf, root, project.ROOT_UNION);
    if (sel wide.err) { ret 4; }
    var wp: project.Project = wide.ok;
    if (diagnostic.error_says(?s.diags, "does not require"))                 { bad = 5; }
    if (!diagnostic.error_says(?s.diags, "required artifact `shader-vert`")) { bad = 6; }
    if (!project.loads(?wp, "lessons.hello"))                                { bad = 7; }
    if (!project.loads(?wp, "lessons.shaded"))                               { bad = 8; }
    var vert_out: str = "";
    var ri:       u32 = 0;
    for (ri < wp.config.art_req_count) {
        if (str_equals(wp.config.art_reqs[ri].name, "shader-vert")) { vert_out = wp.config.art_reqs[ri].out; }
        ri = ri + 1;
    }
    if (str_empty(vert_out)) { bad = 9; }
    var vert_path: str = "";
    if (!str_empty(vert_out)) {
        val joined: res[str, A.Error] = types_path.join(?alloc, root, vert_out);
        if (sel joined.err) { ret 9; }
        vert_path = joined.ok;
    }
    project.dnit_project(?wp);
    if (bad != 0) { ret bad; }

    # with the shader output on disk the embed reads it and the union is clean
    val vert_dir_r: res[types_path.Path, A.Error] = types_path.parent(?alloc, vert_path);
    if (sel vert_dir_r.err) { ret 10; }
    val made: err[fs.FsError] = fs.create_dir_all(?alloc, vert_dir_r.ok, 493);
    if (sel made.err) { ret 10; }
    val bytes: str             = "spv!";
    val wrote: err[fs.FsError] = fs.write_bytes(vert_path, bytes, str_len(bytes), 420);
    if (sel wrote.err) { ret 11; }
    val clean: res[project.Project, fail.Fail] = analyze_lessons(?s, ?mf, root, project.ROOT_UNION);
    if (sel clean.err) { ret 12; }
    var cp: project.Project = clean.ok;
    if (diagnostic.error_count(?s.diags) != 0)            { bad = 13; }
    if (!fail.is_accepted(frontend.frontend_status(?cp))) { bad = 14; }
    project.dnit_project(?cp);
    if (bad != 0) { ret bad; }

    # `hello` is required by nobody, so no artifact's module may name its output
    val shaded_joined: res[str, A.Error] = types_path.join(?alloc, root, "src/shaded.mach");
    if (sel shaded_joined.err) { ret 15; }
    val shaded_path: str            = shaded_joined.ok;
    val overlay:     str            = "#[embed(\"{artifact.hello.out}\")]\nval HELLO: [_]u8;\n\nfun main() i32 { ret HELLO[0]::i32; }\n";
    val laid:        err[fail.Fail] = session.set_overlay(?s, shaded_path, overlay);
    if (sel laid.err) { ret 15; }
    val refused: res[project.Project, fail.Fail] = analyze_lessons(?s, ?mf, root, project.ROOT_UNION);
    if (sel refused.err) { ret 16; }
    var rp: project.Project = refused.ok;
    if (!diagnostic.error_says(?s.diags, "does not require")) { bad = 17; }
    project.dnit_project(?rp);
    ret bad;
}

# under the union each module reads `$bin.name` as the artifact whose entry reached it
# first: `shaded.mach` refusing any other artifact is clean in a session rooted at
# `hello`, where the artifact root set still reads `hello` for it
test union_analysis__attributes_bin_name_to_the_reaching_artifact {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val shaded: str                 = "$if ($bin.name != \"shaded\") { $error(\"wrong artifact\"); }\n\nfun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = scaffold_lessons(?alloc, shaded);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    val mr: res[manifest.Manifest, fail.Fail] = load_manifest(?s, root);
    if (sel mr.err) { ret 1; }
    var mf: manifest.Manifest = mr.ok;
    fin { manifest.dnit(?mf, ?alloc); }

    var bad: i32 = 0;

    # the artifact root set is one cell: every module is `hello`'s
    val narrow: res[project.Project, fail.Fail] = analyze_lessons(?s, ?mf, root, project.ROOT_ARTIFACT);
    if (sel narrow.err) { ret 2; }
    var np: project.Project = narrow.ok;
    if (!diagnostic.error_says(?s.diags, "wrong artifact"))                  { bad = 3; }
    if (!str_equals(project.artifact_named(?np, "lessons.shaded"), "hello")) { bad = 4; }
    project.dnit_project(?np);
    if (bad != 0) { ret bad; }

    # the union attributes `shaded.mach` to the artifact whose entry it is
    val wide: res[project.Project, fail.Fail] = analyze_lessons(?s, ?mf, root, project.ROOT_UNION);
    if (sel wide.err) { ret 5; }
    var wp: project.Project = wide.ok;
    if (diagnostic.error_count(?s.diags) != 0)                                { bad = 6; }
    if (!fail.is_accepted(frontend.frontend_status(?wp)))                     { bad = 7; }
    if (!str_equals(project.artifact_named(?wp, "lessons.hello"), "hello"))   { bad = 8; }
    if (!str_equals(project.artifact_named(?wp, "lessons.shaded"), "shaded")) { bad = 9; }
    project.dnit_project(?wp);
    ret bad;
}

#[testing]
fun union_gate_result(src_text: str, want_diag: str, forbid_diag: str) i32 {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src_text;
    ret union_gate_result_n(?names[0], ?texts[0], 1, want_diag, forbid_diag);
}

test union_gate__alias_is_typed_per_tuple {
    val uniform:         str = "def Flag: u8;\nval C: Flag = 1;\n$if (C) { fun selected() i32 { ret 1; } } $or { use uniontest.missing; }\nfun main() i32 { ret selected(); }\n";
    val selected_u8:     str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u8; }\nval C: Flag = 1;\n$if (C) { fun selected() i32 { ret 1; } } $or { use uniontest.missing; }\nfun main() i32 { ret selected(); }\n";
    val true_import:     str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 1;\n$if (C) { } $or { use uniontest.missing; }\nfun main() i32 { ret 0; }\n";
    val false_embed:     str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 0;\n$if (C) { #[embed(\"missing.bin\")] val DATA: [_]u8; }\nfun main() i32 { ret 0; }\n";
    val false_library:   str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 0;\n$if (C) { #[library(\"missing\")] ext fun probe(); }\nfun main() i32 { ret 0; }\n";
    val nested:          str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 1;\n$if ($mach.build.os == $mach.os.windows) { $if (C) { use uniontest.missing; } }\nfun main() i32 { ret 0; }\n";
    val permanent_error: str = "def Flag: u8;\nval C: Flag = 1;\n$if (C) { fun selected() i32 { ret 1; } }\nfun main() i32 { ret selected() + no_such(); }\n";
    val u0:              i32 = union_gate_result(uniform, "", "");
    if (u0 != 0) { ret 10 + u0; }
    val u1: i32 = union_gate_result(selected_u8, "", "");
    if (u1 != 0) { ret 20 + u1; }
    val u2: i32 = union_gate_result(true_import, "condition must have type u8", "no project or dep matches");
    if (u2 != 0) { ret 30 + u2; }
    val u3: i32 = union_gate_result(false_embed, "condition must have type u8", "cannot read");
    if (u3 != 0) { ret 40 + u3; }
    val u4: i32 = union_gate_result(false_library, "condition must have type u8", "cannot read");
    if (u4 != 0) { ret 50 + u4; }
    val u5: i32 = union_gate_result(nested, "condition must have type u8", "no project or dep matches");
    if (u5 != 0) { ret 60 + u5; }
    val u6: i32 = union_gate_result(permanent_error, "unresolved identifier `no_such`", "");
    if (u6 != 0) { ret 70 + u6; }
    ret 0;
}

# the diagnostics of one build of a body gate, as bits: 1 the precise report, 2 the load's "never decided", 4 any other error
#[testing]
fun body_gate_reports(text: str, as_union: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret -1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret -1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;
    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret -1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    var tsel: manifest.Selectors = manifest.t_selectors("", "linux", "");
    var pr:   res[project.Project, fail.Fail];
    if (as_union) { pr = union_analysis(?s, root, "", FRONTEND_RESOLVE); }
    or            { pr = build_project(?s, root, ?tsel); }
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        if (fail.is_accepted(frontend.frontend_status(?p))) { passes.run_sema_pass(?p); }
        project.dnit_project(?p);
    }
    var bits: i32 = 0;
    if (diagnostic.error_says(?s.diags, "function calls are not comptime-evaluable"))                                        { bits = bits | 1; }
    if (diagnostic.error_says(?s.diags, "is never decided"))                                                                 { bits = bits | 2; }
    if (diagnostic.error_count(?s.diags) != diagnostic.errors_saying(?s.diags, "function calls are not comptime-evaluable")) { bits = bits | 4; }
    ret bits;
}

# an undecidable body gate gets the one precise report whether the build is one target or a union,
# and neither mode refuses it as never decided
test union_gate__body_gate_reports_alike_in_both_modes {
    val text:   str = "fun none() {}\nfun main() i32 { $if (none()) { ret 1; } $or { ret 0; } }\n";
    val single: i32 = body_gate_reports(text, false);
    val wide:   i32 = body_gate_reports(text, true);
    if (single != 1) { ret 10 + single; }
    if (wide != 1)   { ret 20 + wide; }
    ret 0;
}

test union_gate__unevaluable_condition_keeps_independent_diagnostics {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun condition() u8 { ret 1; }\n$if (condition()) { fun selected() i32 { ret 1; } }\nfun main() i32 { ret no_such(); }\n";
    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val root: str                             = root_r.ok;
    val pr:   res[project.Project, fail.Fail] = union_analysis(?s, root, "", FRONTEND_RESOLVE);
    fs.remove_all(?alloc, root);
    var bad: i32 = 0;
    if (sel pr.err) {
        bad = 4;
    }
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        if (!diagnostic.error_says(?p.s.diags, "function calls are not comptime-evaluable")) { bad = 5; }
        if (!diagnostic.error_says(?p.s.diags, "unresolved identifier `no_such`"))           { bad = 6; }
        if (diagnostic.len(?p.s.diags) != 2)                                                 { bad = 7; }
        project.dnit_project(?p);
    }
    session.dnit(?s);
    ret bad;
}

# a gate reading a constant nothing binds is refused although the constant beside it binds through an import
test union_gate__unbound_constant_is_refused_beside_a_bound_import {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "dep.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.dep.K;\npub val UNSTUCK: u8 = K;\npub val A: u8 = totally_undefined;\n$if (A) { fun helper() i32 { ret 1; } }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val K: u8 = 1;\n";
    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str                             = root_r.ok;
    val pr:   res[project.Project, fail.Fail] = union_analysis(?s, root, "", FRONTEND_RESOLVE);
    fs.remove_all(?alloc, root);
    var bad: i32 = 0;
    if (sel pr.ok) {
        var p:        project.Project  = pr.ok;
        val standing: fail.PhaseStatus = frontend_status(?p);
        if (sel standing.kind.accepted) { bad = 1; }
        project.dnit_project(?p);
    }
    if (sel pr.err) {
        val f: fail.Fail = pr.err;
        if (!sel f.reported) { bad = 1; }
    }
    if (!diagnostic.error_says(?s.diags, "is never decided: `A`")) { bad = 2; }
    session.dnit(?s);
    ret bad;
}

test union_gate__tuple_dependent_dependency_const_fails_closed {
    val refused: str = "tuple-dependent public constants are not yet supported";
    val named:   i32 = one_error("use uniontest.dep.X;\n$if (X) { $error(\"XTRUE\"); } $or { $error(\"XFALSE\"); }\nfun main() i32 { ret 0; }\n", refused);
    if (named != 0) { ret 10 + named; }
    val member: i32 = one_error("use uniontest.dep;\n$if (dep.X) { $error(\"XTRUE\"); } $or { $error(\"XFALSE\"); }\nfun main() i32 { ret 0; }\n", refused);
    if (member != 0) { ret 20 + member; }
    val argument: i32 = one_error("use uniontest.dep.X;\nfun f($k: u8) u8 { ret k; }\nfun main() i32 { val a: u8 = f(X); ret 0; }\n", refused);
    if (argument != 0) { ret 30 + argument; }
    val member_argument: i32 = one_error("use uniontest.dep;\nfun f($k: u8) u8 { ret k; }\nfun main() i32 { val a: u8 = f(dep.X); ret 0; }\n", refused);
    if (member_argument != 0) { ret 40 + member_argument; }
    val runtime_argument: i32 = one_error("fun g() u8 { ret 1; }\nfun f($k: u8) u8 { ret k; }\nfun main() i32 { val a: u8 = f(g()); ret 0; }\n",
        "comptime argument is not a compile-time constant");
    if (runtime_argument != 0) { ret 50 + runtime_argument; }
    val statement: i32 = one_error("use uniontest.dep.X;\nfun main() i32 { $if (X) { ret 1; } ret 0; }\n", refused);
    if (statement != 0) { ret 60 + statement; }
    val renamed: i32 = one_error("use Z: uniontest.dep.X;\nfun f($k: u8) u8 { ret k; }\nfun main() i32 { val a: u8 = f(Z); ret 0; }\n", "'X' in module 'uniontest.dep'");
    if (renamed != 0) { ret 70 + renamed; }
    # a local that shadows the gated name is not the import, so its read draws no gated refusal
    val shadowed: i32 = gate_diags("use uniontest.dep.X;\nfun f($k: u8) u8 { ret k; }\nfun main() i32 { val X: u8 = 1; val a: u8 = f(X); ret 0; }\n",
        "comptime argument is not a compile-time constant", "unused import `X`");
    if (shadowed != 0) { ret 80 + shadowed; }
    ret 0;
}

# the one error a read of the gated dependency draws, whichever phase or consumer meets it: a build
# of `main` against that dependency, whose diagnostics are exactly one, carrying `needle`
#[testing]
fun one_error(main: str, needle: str) i32 {
    ret gate_diags(main, needle, "");
}

# as one_error, with one more diagnostic expected: the unused-import warning carrying `warning`
# when it is not empty
#[testing]
fun gate_diags(main: str, needle: str, warning: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names:  [2]str              = [2]str{"main.mach", "dep.mach"};
    var texts:  [2]str              = [2]str{main, "$if ($mach.build.os == $mach.os.linux) { pub val X: u8 = 1; } $or { pub val X: u8 = 0; }\n$if ($mach.build.os == $mach.os.linux) { pub val ARR: [2]u8 = [2]u8{1, 2}; } $or { pub val ARR: [2]u8 = [2]u8{3, 4}; }\n"};
    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val pr: res[project.Project, fail.Fail] = union_analysis(?s, root, "", FRONTEND_RESOLVE);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val se: err[fail.Fail] = run_sema_pass(?p);
    if (!(sel se.err && fail.is_reported(se.err))) { ret 3; }
    var expected: usize = 1;
    if (!str_empty(warning))                               { expected = 2; }
    if (diagnostic.len(?p.s.diags) != expected)            { ret 4; }
    if (diagnostic.errors_saying(?p.s.diags, needle) != 1) { ret 5; }
    if (!str_empty(warning)) {
        var warned: u32   = 0;
        var i:      usize = 0;
        for (i < diagnostic.len(?p.s.diags)) {
            val d: *diagnostic.Diagnostic = ?p.s.diags.items.data[i];
            if (d.kind == diagnostic_kind.IMPORT_UNUSED && str_contains(d.message, warning)) { warned = warned + 1; }
            i = i + 1;
        }
        if (warned != 1) { ret 6; }
    }
    ret 0;
}

# a union build expands a `$each` over an ungated imported array once per element
#[testing]
fun ungated_each(main: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names:  [2]str              = [2]str{"main.mach", "dep.mach"};
    var texts:  [2]str              = [2]str{main, "pub val FLAT: [2]u8 = [2]u8{5, 6};\n"};
    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val pr: res[project.Project, fail.Fail] = union_analysis(?s, root, "", FRONTEND_RESOLVE);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val se: err[fail.Fail] = run_sema_pass(?p);
    if (!(sel se.err && fail.is_reported(se.err)))                                                   { ret 3; }
    if (diagnostic.error_says(?p.s.diags, "tuple-dependent public constants are not yet supported")) { ret 4; }
    if (diagnostic.errors_saying(?p.s.diags, "FIVE") != 1)                                           { ret 5; }
    if (diagnostic.errors_saying(?p.s.diags, "OTHER") != 1)                                          { ret 6; }
    ret 0;
}

test union_gate__tuple_dependent_array_each_fails_closed {
    val gated: i32 = one_error("use uniontest.dep;\nfun main() i32 { $each p in dep.ARR { val q: u8 = p; } ret 0; }\n",
        "tuple-dependent public constants are not yet supported");
    if (gated != 0) { ret 10 + gated; }
    val ungated: i32 = ungated_each("use uniontest.dep;\nfun main() i32 { $each p in dep.FLAT { $if (p == 5) { $error(\"FIVE\"); } $or { $error(\"OTHER\"); } } ret 0; }\n");
    if (ungated != 0) { ret 20 + ungated; }
    ret 0;
}

