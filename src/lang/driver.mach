    var bad: i32             = 0;
    if (!diagnostic.error_says(?p.s.diags, "`C` is not an integer constant")) { bad = 5; }
    if (!diagnostic.error_says(?p.s.diags, "condition must have type u8"))    { bad = 6; }
    if (diagnostic.len(?p.s.diags) != 2)                                      { bad = 7; }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

#[testing]
val REALLOC_LEAVES: u32 = 24;

# a main module importing REALLOC_LEAVES leaves under a windows arm and one under a linux arm,
# enough modules to grow the module table during the walk; the count of files written, zero
# when a text could not be made
#[testing]
fun realloc_fixture(alloc: *A.Allocator, names: *str, texts: *str) u32 {
    var body: str = "";
    var i:    u32 = 0;
    for (i < REALLOC_LEAVES) {
        val name: res[str, fail.Fail] = fail.format(alloc, "w{}{}.mach", i / 10, i % 10);
        val text: res[str, fail.Fail] = fail.format(alloc, "pub fun f() i32 {{ ret {}{}; }}\n", i / 10, i % 10);
        val line: res[str, fail.Fail] = fail.format(alloc, "{}  use uniontest.w{}{};\n", body, i / 10, i % 10);
        if (sel name.err) { ret 0; }
        if (sel text.err) { ret 0; }
        if (sel line.err) { ret 0; }
        names[1 + i] = name.ok;
        texts[1 + i] = text.ok;
        body         = line.ok;
        i            = i + 1;
    }
    names[1 + REALLOC_LEAVES] = "lx.mach";
    texts[1 + REALLOC_LEAVES] = "pub fun fl() i32 { ret 99; }\n";
    names[0]                  = "main.mach";
    val main: res[str, fail.Fail] = fail.join(alloc, "$if ($mach.build.os == $mach.os.windows) {\n", body,
        "}\n$or ($mach.build.os == $mach.os.linux) { use uniontest.lx; }\n\nfun main() i32 { ret 0; }\n");
    if (sel main.err) { ret 0; }
    texts[0] = main.ok;
    ret 2 + REALLOC_LEAVES;
}

test union__skips_an_uncoverable_target {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val mf:    str = "[project]\nmach = \">=5\"\nid = \"uskip\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.good]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.bad]\nisa = \"aarch64\"\nos = \"windows\"\nabi = \"aapcs64\"\n\n[artifact.uskip]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/uskip\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";

    val root_r: res[str, fail.Fail] = scaffold(?alloc, mf, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    val pur: res[project.Project, fail.Fail] = union_analysis(?s, root, "good", FRONTEND_RESOLVE);
    fs.remove_all(?alloc, root);
    if (sel pur.err) {
        session.dnit(?s);
        ret 1;
    }
    var pu: project.Project = pur.ok;

    var bad: i32 = 0;
    if (pu.loader.tuple_count != 1)        { bad = 1; }
    or (pu.loader.tuple_cap != 2)          { bad = 1; }
    or (!project.loads(?pu, "uskip.main")) { bad = 1; }

    project.dnit_project(?pu);
    session.dnit(?s);
    ret bad;
}

# 0 when the union loads a.mach exactly when `want_a` and b.mach exactly when `want_b`
#[testing]
fun union_selects(main: str, want_a: bool, want_b: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [3]str                          = [3]str{"main.mach", "a.mach", "b.mach"};
    var texts: [3]str                          = [3]str{main, "pub fun fa() i32 { ret 1; }\n", "pub fun fb() i32 { ret 2; }\n"};
    val pr:    res[project.Project, fail.Fail] = scaffold_union(?s, ?alloc, fixture_manifest(), ?names[0], ?texts[0], 3, FRONTEND_RESOLVE);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    if (project.loads(?p, "uniontest.a") != want_a) { ret 3; }
    if (project.loads(?p, "uniontest.b") != want_b) { ret 4; }
    ret 0;
}

# the first active branch wins in every tuple, and a module constant a gate reads keeps its
# value under each tuple's override of the target facts
test union_gate__first_active_branch_wins_per_tuple {
    val first: i32 = union_selects("$if ($mach.build.pointer_width == 8) { use uniontest.a; }\n$or ($mach.build.os == $mach.os.linux) { use uniontest.b; }\n\nfun main() i32 { ret 0; }\n", true, false);
    if (first != 0) { ret 10 + first; }
    val constant: i32 = union_selects("pub val FLAG: i32 = 1;\n$if (FLAG == 0) { use uniontest.a; }\n$or (FLAG == 1) { use uniontest.b; }\n\nfun main() i32 { ret 0; }\n", false, true);
    if (constant != 0) { ret 20 + constant; }
    ret 0;
}

test union_gate__selection_uses_tuple_abi_and_platform {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    val mf:    str             = "[project]\nmach = \">=5\"\nid = \"tuplefacts\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\nplatform = \"alpha\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\nplatform = \"beta\"\n\n[artifact.tuplefacts]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/tuplefacts\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
    var names: [5]str;
    names[0] = "main.mach";
    names[1] = "sysv.mach";
    names[2] = "win.mach";
    names[3] = "alpha.mach";
    names[4] = "beta.mach";
    var texts: [5]str;
    texts[0] = "$if ($mach.build.abi == $mach.abi.sysv64) { use tuplefacts.sysv; } $or ($mach.build.abi == $mach.abi.win64) { use tuplefacts.win; }\n$if ($mach.build.platform == \"alpha\") { use tuplefacts.alpha; } $or ($mach.build.platform == \"beta\") { use tuplefacts.beta; }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun selected() i32 { ret 1; }\n";
    texts[2] = "pub fun selected() i32 { ret 2; }\n";
    texts[3] = "pub fun selected() i32 { ret 3; }\n";
    texts[4] = "pub fun selected() i32 { ret 4; }\n";
    val root_r: res[str, fail.Fail] = scaffold(?alloc, mf, ?names[0], ?texts[0], 5);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val root: str                             = root_r.ok;
    val pr:   res[project.Project, fail.Fail] = union_analysis(?s, root, "linux", FRONTEND_RESOLVE);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 4;
    }
    var p:   project.Project = pr.ok;
    var bad: i32             = 0;
    if (diagnostic.error_count(?s.diags) != 0) { bad = 5; }
    if (!project.loads(?p, "tuplefacts.sysv") || !project.loads(?p, "tuplefacts.win")
        || !project.loads(?p, "tuplefacts.alpha") || !project.loads(?p, "tuplefacts.beta")) { bad = 6; }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test union_ctx__restored_to_the_default_tuple {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "$if ($mach.build.os == $mach.os.linux) { use uniontest.a; }\n$or ($mach.build.os == $mach.os.windows) { use uniontest.b; }\nval BAD: u16 = 1;\n$if (BAD) { }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";

    val pr: res[project.Project, fail.Fail] = scaffold_union(?s, ?alloc, fixture_manifest(), ?names[0], ?texts[0], 3, FRONTEND_RESOLVE);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val cm: *comptime.ComptimeCtx = ctx(?p, ?s, "uniontest.main");
    val ca: *comptime.ComptimeCtx = ctx(?p, ?s, "uniontest.a");
    val cb: *comptime.ComptimeCtx = ctx(?p, ?s, "uniontest.b");

    var bad: i32 = 0;
    if (cm == nil || ca == nil || cb == nil)                                        { bad = 1; }
    or (cm.env.target.os_id != ca.env.target.os_id)                                 { bad = 2; }
    or (cm.env.target.os_id != cb.env.target.os_id)                                 { bad = 3; }
    or (cm.env.target.arch_id != ca.env.target.arch_id)                             { bad = 4; }
    or (cm.env.target.arch_id != cb.env.target.arch_id)                             { bad = 5; }
    or (cm.env.target.abi_id != ca.env.target.abi_id)                               { bad = 6; }
    or (cm.env.target.abi_id != cb.env.target.abi_id)                               { bad = 7; }
    or (cm.env.target.pointer_width != ca.env.target.pointer_width)                 { bad = 8; }
    or (cm.env.target.pointer_width != cb.env.target.pointer_width)                 { bad = 9; }
    or (cm.env.target.vector_bits != ca.env.target.vector_bits)                     { bad = 10; }
    or (cm.env.target.vector_bits != cb.env.target.vector_bits)                     { bad = 11; }
    or (cm.env.target.register_bits != ca.env.target.register_bits)                 { bad = 10; }
    or (cm.env.target.register_bits != cb.env.target.register_bits)                 { bad = 11; }
    or (cm.env.target.defs != ca.env.target.defs)                                   { bad = 12; }
    or (cm.env.target.defs != cb.env.target.defs)                                   { bad = 13; }
    or (cm.env.target.va_list_size != ca.env.target.va_list_size)                   { bad = 14; }
    or (cm.env.target.va_list_size != cb.env.target.va_list_size)                   { bad = 15; }
    or (cm.env.target.va_list_align != ca.env.target.va_list_align)                 { bad = 16; }
    or (cm.env.target.va_list_align != cb.env.target.va_list_align)                 { bad = 17; }
    or (cm.env.target.os_id != lang_target.host_os_id())                            { bad = 18; }
    or (cm.env.target.arch_id != lang_target.host_arch_id())                        { bad = 19; }
    or (cm.env.target.abi_id != p.target.target.abi_id)                             { bad = 20; }
    or (!intern.str_same(cm.env.build.os_name, p.target_entry.os_name))             { bad = 21; }
    or (!intern.str_same(cm.env.build.isa_name, p.target_entry.isa_name))           { bad = 22; }
    or (!intern.str_same(cm.env.build.abi_name, p.target_entry.abi_name))           { bad = 23; }
    or (!intern.str_same(cm.env.build.platform_name, p.target_entry.platform_name)) { bad = 24; }
    or (cm.env.target.has_float != ca.env.target.has_float)                         { bad = 25; }
    or (cm.env.target.has_float != cb.env.target.has_float)                         { bad = 26; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

