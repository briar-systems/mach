# each module's product of one kind, keyed as the kind's owner says: a file-keyed kind by the
# module's file, a module-keyed one by its stable id (a normal object's back-half key)
fun append_phase_roots(p: *project.Project, roots: *Vector[query.QueryKey],
    kind: *query.Kind, count: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < count) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        # a module the front end skips has only its parse and its restored object
        if (m.frontend_skipped && kind != ?frontend.PARSE && kind != ?passes.CODEGEN) {
            i = i + 1;
            cnt;
        }
        var key: u64 = module.stable_index(m.stable_id)::u64;
        if (kind.owner == query.KEY_FILE) { key = lang_source.file_index(m.file_id)::u64; }
        val added: res[usize, A.Error] = collections_vector.push[query.QueryKey](roots, query.QueryKey{kind: kind, key: key});
        if (sel added.err) {
            ret err[fail.Fail].err{fail.refused(added.err)};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun append_frontend_roots(p: *project.Project, roots: *Vector[query.QueryKey]) err[fail.Fail] {
    val parsed: err[fail.Fail] = append_phase_roots(p, roots, ?frontend.PARSE, p.topo_len);
    if (sel parsed.err) { ret parsed; }
    val resolved: err[fail.Fail] = append_phase_roots(p, roots, ?frontend.RESOLVE, p.topo_len);
    if (sel resolved.err) { ret resolved; }
    ret append_phase_roots(p, roots, ?frontend.SEMA, p.topo_len);
}

fun append_backend_roots(p: *project.Project, roots: *Vector[query.QueryKey],
    codegen: bool) err[fail.Fail] {
    val frontend: err[fail.Fail] = append_frontend_roots(p, roots);
    if (sel frontend.err) { ret frontend; }
    val surface: err[fail.Fail] = append_phase_roots(p, roots, ?passes.LOWERED_SURFACE, p.emit_len);
    if (sel surface.err) { ret surface; }
    if (codegen)         { ret append_phase_roots(p, roots, ?passes.CODEGEN, p.emit_len); }
    ret err[fail.Fail].ok{};
}

# the backend's roots and each test object's codegen
pub fun append_test_roots(p: *project.Project, roots: *Vector[query.QueryKey]) err[fail.Fail] {
    val backend: err[fail.Fail] = append_backend_roots(p, roots, true);
    if (sel backend.err) { ret backend; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (passes.has_test_object(p, m)) {
            val emitted: res[usize, A.Error] = collections_vector.push[query.QueryKey](roots, query.QueryKey{kind: ?passes.CODEGEN, key: passes.test_key_for(m)});
            if (sel emitted.err) { ret err[fail.Fail].err{fail.refused(emitted.err)}; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun run_query_pass(p: *project.Project, roots: *Vector[query.QueryKey],
    run: fun(*project.Project) err[fail.Fail]) err[fail.Fail] {
    val begun: res[query.Operation, fail.Fail] = frontend.begin_query_phase(p);
    if (sel begun.err) {
        ret err[fail.Fail].err{begun.err};
    }
    val result: err[fail.Fail] = run(p);
    ret frontend.finish_query_phase(p, begun.ok, roots.data, roots.len, result);
}

# a phase the query engine does not run is published as one it does: the
# project's diagnostics are refreshed beside its result
pub fun phase_finish(p: *project.Project,
    result: err[fail.Fail]) err[fail.Fail] {
    val refreshed: err[fail.Fail] = frontend.refresh_diagnostics(p);
    if (sel refreshed.err) {
        diagnostic.note_lost(?p.diags);
        diagnostic.note_lost(?p.s.diags);
        if (sel result.ok) { ret refreshed; }
    }
    ret result;
}

# a loaded project under another request from its host: the build context is frozen again, so
# what read the old one is computed again, and nothing reads a context no freeze captured
pub fun reconfigure(p: *project.Project, req: request.BuildRequest) err[fail.Fail] {
    p.req = req;
    ret context.freeze(p);
}

# a project that failed is released, its failure kept where the session presents it
fun project_failure(p: *project.Project, failure: fail.Fail) res[project.Project, fail.Fail] {
    var lost:   bool      = false;
    val stable: fail.Fail = session.hold_failure(p.s, failure, ?lost);
    if (lost) { diagnostic.note_lost(?p.diags); }
    val published: err[fail.Fail] = phase_finish(p, err[fail.Fail].err{stable});
    project.dnit_project(p);
    if (sel published.err) { ret res[project.Project, fail.Fail].err{published.err}; }
    ret res[project.Project, fail.Fail].err{stable};
}

pub fun run_sema_pass(p: *project.Project) err[fail.Fail] {
    project.set_origin(p, diagnostic.ORIGIN_SEMA);
    var roots: Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    val rooted: err[fail.Fail] = append_frontend_roots(p, ?roots);
    if (sel rooted.err) { ret rooted; }
    ret run_query_pass(p, ?roots, passes.run_sema_pass);
}

pub fun run_lower_pass(p: *project.Project) err[fail.Fail] {
    project.set_origin(p, diagnostic.ORIGIN_LOWER);
    val prepared: err[fail.Fail] = passes.prepare_lower_pass(p);
    if (sel prepared.err) { ret prepared; }
    var roots: Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    val rooted: err[fail.Fail] = append_backend_roots(p, ?roots, false);
    if (sel rooted.err) { ret rooted; }
    ret run_query_pass(p, ?roots, passes.run_lower_pass);
}

pub fun run_link_pass(p: *project.Project) res[bool, fail.Fail] {
    project.set_origin(p, diagnostic.ORIGIN_LINK);
    var roots: Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    val rooted: err[fail.Fail] = append_backend_roots(p, ?roots, true);
    if (sel rooted.err) {
        ret res[bool, fail.Fail].err{rooted.err};
    }
    val linked: res[usize, A.Error] = collections_vector.push[query.QueryKey](?roots, query.QueryKey{kind: ?passes.LINK, key: 0});
    if (sel linked.err) {
        ret res[bool, fail.Fail].err{fail.refused(linked.err)};
    }
    val begun: res[query.Operation, fail.Fail] = frontend.begin_query_phase(p);
    if (sel begun.err) {
        ret res[bool, fail.Fail].err{begun.err};
    }
    val result:   res[bool, fail.Fail] = passes.run_link_pass(p);
    val finished: err[fail.Fail]       = frontend.finish_query_phase(p,
        begun.ok, roots.data, roots.len, fail.unit[bool](result));
    if (sel finished.err) {
        ret res[bool, fail.Fail].err{finished.err};
    }
    ret result;
}

# load the manifest at `project_root`, begin the one cell `selectors` names in it and
# load its artifact's closure
pub fun build_project(s: *session.Session, project_root: str, selectors: *manifest.Selectors) res[project.Project, fail.Fail] {
    val mr: res[manifest.Manifest, fail.Fail] = load_manifest(s, project_root);
    if (sel mr.err) {
        ret res[project.Project, fail.Fail].err{mr.err};
    }
    var m: manifest.Manifest = mr.ok;
    fin { manifest.dnit(?m, s.build_alloc); }
    val cell: res[manifest.Cell, fail.Fail] = manifest.resolve_cell(s.build_alloc, ?s.interner, ?m, selectors,
        manifest.ARTIFACT_DEFAULT_ONE, "this command builds one artifact");
    if (sel cell.err) { ret res[project.Project, fail.Fail].err{cell.err}; }
    var c:       manifest.Cell                   = cell.ok;
    val begin_r: res[project.Project, fail.Fail] = begin_build_impl(s, project_root, ?c, ?m, nil, nil, nil, project.ROOT_ARTIFACT);
    if (sel begin_r.err) { ret begin_r; }
    var p: project.Project = begin_r.ok;

    val load_r: err[fail.Fail] = run_load_phase(?p);
    if (sel load_r.err) {
        ret project_failure(?p, load_r.err);
    }

    ret res[project.Project, fail.Fail].ok{p};
}

# locate a root manifest's dependency closure with no build cell configured, as a
# build locates it: every dependency under dep/, its manifest and its direct
# edges, and nothing is checked against git or the pins
# ---
# s:            the session; its build allocator owns the closure
# m:            the root manifest
# project_root: the root project's directory
# unrealized:   what a dependency nothing is realized for is
# ret:          the closure, released with `project.closure_dnit`
pub fun closure_locate(s: *session.Session, m: *manifest.Manifest, project_root: str,
    unrealized: driver_closure.Unrealized) res[project.Closure, fail.Fail] {
    ret closure_of(s, m, project_root, nil, unrealized);
}

# locate a root manifest's dependency closure as `closure_locate` does, holding every edge
# to `check` as it is located, as `mach dep verify` does
# ---
# check: what each located edge is held to
# ret:   the closure; err naming the first edge that does not locate or does not hold
pub fun closure_checked(s: *session.Session, m: *manifest.Manifest, project_root: str,
    check: *driver_closure.Check) res[project.Closure, fail.Fail] {
    ret closure_of(s, m, project_root, check, driver_closure.UNREALIZED_REFUSED);
}

fun closure_of(s: *session.Session, m: *manifest.Manifest, project_root: str,
    check: *driver_closure.Check, unrealized: driver_closure.Unrealized) res[project.Closure, fail.Fail] {
    val composed: err[fail.Fail] = registry_composed();
    if (sel composed.err) { ret res[project.Closure, fail.Fail].err{composed.err}; }
    ret driver_closure.locate(s, s.build_alloc, m, project_root, check, unrealized);
}

# the driver resolves targets only through the registry the toolchain composed
fun registry_composed() err[fail.Fail] {
    val composed: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel composed.err) { ret err[fail.Fail].err{composed.err}; }
    ret err[fail.Fail].ok{};
}

# begin the build the request names: every goal, a test goal included, loads the
# selected artifact's closure
# ---
# m:       the root manifest the cell was planned from
# closure: `m`'s closure as the plan located it, which the project borrows
pub fun begin_build(s: *session.Session, m: *manifest.Manifest, closure: *project.Closure, req: *request.BuildRequest,
    progress: *readout.Progress) res[project.Project, fail.Fail] {
    ret begin_build_roots(s, m, closure, req, progress, project.ROOT_ARTIFACT);
}

fun begin_build_roots(s: *session.Session, m: *manifest.Manifest, closure: *project.Closure, req: *request.BuildRequest,
    progress: *readout.Progress, roots: project.RootSet) res[project.Project, fail.Fail] {
    val cell: res[manifest.Cell, fail.Fail] = request_cell(s, m, req);
    if (sel cell.err) { ret res[project.Project, fail.Fail].err{cell.err}; }
    var c: manifest.Cell = cell.ok;
    ret begin_build_impl(s, req.project_root, ?c, m, closure, req, progress, roots);
}

# the cell a request names: a dependency's cell exactly as its plan named it, and
# a root cell resolved from the request's names, so a request naming no artifact
# takes the one the default selection holds
fun request_cell(s: *session.Session, m: *manifest.Manifest, req: *request.BuildRequest) res[manifest.Cell, fail.Fail] {
    if (!str_empty(req.owner)) { ret res[manifest.Cell, fail.Fail].ok{manifest.cell_of(req.artifact, req.target, req.profile)}; }
    val made: res[manifest.Selectors, fail.Fail] = manifest.selectors_of(s.alloc, req.artifact, req.target, req.profile);
    if (sel made.err) { ret res[manifest.Cell, fail.Fail].err{made.err}; }
    var selectors: manifest.Selectors = made.ok;
    fin { manifest.selectors_dnit(?selectors); }
    ret manifest.resolve_cell(s.alloc, ?s.interner, m, ?selectors, manifest.ARTIFACT_DEFAULT_ONE, "this command builds one artifact");
}

pub def FrontendPhase: u8;
pub val FRONTEND_PARSE:   FrontendPhase = 0;
pub val FRONTEND_RESOLVE: FrontendPhase = 1;
pub val FRONTEND_SEMA:    FrontendPhase = 2;

# frontend analysis for tools: the project comes back whenever the frontend
# ran, whatever its phases decided, so a consumer can read the trees, resolve
# results and sema results beside the diagnostics. every module that reached
# a phase carries that phase's product on its ModuleEntry even when the
# module's own query was rejected; the standing is frontend.frontend_status(p).
# a rejected phase ends the analysis at that phase; err is an operational
# failure only (an unreadable manifest, allocation, I/O)
# ---
# s:                the session
# m:                the loaded manifest
# req:              the build request selecting target, profile and artifact
# roots:            the root set the frontend loads: `project.ROOT_ARTIFACT` is the
#                   selected artifact's closure, `project.ROOT_UNION` every artifact's
#                   with the modules only a foreign target reaches gated out and
#                   `{artifact.<id>.out}` resolving over every artifact some artifact
#                   needs
# extra_roots:      module fqns loaded beside the root set's entries, nil with count 0
# extra_root_count: how many extra roots
# phase:            the last frontend phase to run
# ret:              the project, released by the caller with project.dnit_project
pub fun analyze_project_tolerant(s: *session.Session, m: *manifest.Manifest, req: *request.BuildRequest,
    roots: project.RootSet, extra_roots: *intern.StrId, extra_root_count: u32, phase: FrontendPhase) res[project.Project, fail.Fail] {
    if (phase > FRONTEND_SEMA) { ret res[project.Project, fail.Fail].err{fail.message("unknown frontend analysis phase")}; }
    if (roots != project.ROOT_ARTIFACT && roots != project.ROOT_UNION) {
        ret res[project.Project, fail.Fail].err{fail.unknown_catalog(s.alloc, "RootSet", roots::u32)};
    }
    if (extra_root_count > 0 && extra_roots == nil) {
        ret res[project.Project, fail.Fail].err{fail.message(
            "driver: frontend analysis root count requires a root array")};
    }

    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(s.alloc);

    val begin_r: res[project.Project, fail.Fail] = begin_build_roots(s, m, nil, req, nil, roots);
    if (sel begin_r.err) { ret begin_r; }
    var p: project.Project = begin_r.ok;

    if (phase == FRONTEND_PARSE) {
        val parsed: err[fail.Fail] = parse_project_roots(?p, extra_roots, extra_root_count);
        if (sel parsed.err) { ret phase_decided(?p, parsed.err); }
        ret res[project.Project, fail.Fail].ok{p};
    }

    val load_r: err[fail.Fail] = run_load_phase_roots(?p, extra_roots, extra_root_count);
    if (sel load_r.err) { ret phase_decided(?p, load_r.err); }

    if (phase == FRONTEND_RESOLVE) {
        val current: err[fail.Fail] = resolve_query_phase(?p);
        if (sel current.err) { ret phase_decided(?p, current.err); }
        ret res[project.Project, fail.Fail].ok{p};
    }

    val sema_r: err[fail.Fail] = run_sema_pass(?p);
    if (sel sema_r.err) { ret phase_decided(?p, sema_r.err); }

    ret res[project.Project, fail.Fail].ok{p};
}

# a phase that did not finish: a rejection keeps the project, everything else
# releases it
fun phase_decided(p: *project.Project, failure: fail.Fail) res[project.Project, fail.Fail] {
    if (fail.is_reported(failure)) {
        ret res[project.Project, fail.Fail].ok{@p};
    }
    ret project_failure(p, failure);
}

fun parse_project_roots(p: *project.Project, roots: *intern.StrId, count: u32) err[fail.Fail] {
    val selected: err[fail.Fail] = config.select_target(p, p.target_entry);
    if (sel selected.err) { ret phase_finish(p, err[fail.Fail].err{selected.err}); }
    var entry:          intern.StrId  = intern.STR_NIL;
    var selected_roots: *intern.StrId = roots;
    var selected_count: u32           = count;
    if (selected_count == 0) {
        val name: res[intern.StrId, fail.Fail] = driver_load.entry_module_fqn(p, p.target_entry);
        if (sel name.err) { ret phase_finish(p, err[fail.Fail].err{name.err}); }
        entry          = name.ok;
        selected_roots = ?entry;
        selected_count = 1;
    }
    var i: u32 = 0;
    for (i < selected_count) {
        val loaded: res[session.ModuleId, fail.Fail] = driver_load.module_open(p, selected_roots[i]);
        if (sel loaded.err) {
            var failure: fail.Fail = load_failure_of(p, loaded.err);
            if (count == 0) { failure = entry_failure(p, entry, p.config.bin_name, p.target_entry.entry_at, failure); }
            ret retain_loaded(p, driver_load.collect_loaded_parses(p, err[fail.Fail].err{failure}));
        }
        i = i + 1;
    }
    ret retain_loaded(p, driver_load.collect_loaded_parses(p, err[fail.Fail].ok{}));
}

fun begin_build_impl(s: *session.Session, project_root: str, c: *manifest.Cell, m: *manifest.Manifest, closure: *project.Closure,
    req: *request.BuildRequest, progress: *readout.Progress, roots: project.RootSet) res[project.Project, fail.Fail] {
    val composed: err[fail.Fail] = registry_composed();
    if (sel composed.err) { ret res[project.Project, fail.Fail].err{composed.err}; }
    if (req != nil) {
        val valid: err[fail.Fail] = request.validate(s.alloc, req);
        if (sel valid.err) {
            ret res[project.Project, fail.Fail].err{valid.err};
        }
    }
    var p: project.Project;
    project.init_project(?p, s);
    if (req != nil) { p.req = @req; }
    p.progress = progress;
    p.roots    = roots;

    val for_union: bool = roots == project.ROOT_UNION;

    var owner: str = "";
    if (req != nil) { owner = req.owner; }
    val cfg_r: err[fail.Fail] = config.load_config_manifest(?p, project_root, m, closure, c, owner, for_union);
    if (sel cfg_r.err) {
        ret project_failure(?p, cfg_r.err);
    }

    val te: *project.TargetEntry = p.target_entry;
    if (te == nil) {
        ret project_failure(?p, fail.message("internal: manifest selected no target"));
    }

    if (req == nil) {
        p.req              = request.defaults();
        p.req.project_root = project_root;
        if (te.optimize) { p.req.opt = request.OPT_RELEASE; }
    }

    val published: err[fail.Fail] = phase_finish(?p, err[fail.Fail].ok{});
    if (sel published.err) {
        ret project_failure(?p, published.err);
    }

    ret res[project.Project, fail.Fail].ok{p};
}

pub fun run_load_phase(p: *project.Project) err[fail.Fail] {
    ret run_load_phase_roots(p, nil, 0);
}

fun run_load_phase_roots(p: *project.Project, extra_roots: *intern.StrId,
    extra_root_count: u32) err[fail.Fail] {
    ret phase_finish(p, retain_loaded(p, load_phase_impl(p, extra_roots, extra_root_count)));
}

# whatever the load decided, the session keeps what it reached and retires what nothing holds any more
# a load the walk finished but rejected (a `use` that names nothing) is a rejected
# round like a failed one: the last accepted build's holdings stay
fun retain_loaded(p: *project.Project, result: err[fail.Fail]) err[fail.Fail] {
    val standing: fail.PhaseStatus = frontend.load_status(p);
    val rejected: bool             = sel result.err || !sel standing.kind.accepted;
    val kept:     err[fail.Fail]   = passes.retain_modules(p, rejected);
    # a rejected load reports its own failure first; a retention failure beside it only keeps products
    # longer than needed, never serves a wrong one, so it is counted as a lost report rather than replacing it
    if (sel result.err) {
        if (sel kept.err) {
            diagnostic.note_lost(?p.diags);
            diagnostic.note_lost(?p.s.diags);
        }
        ret result;
    }
    if (sel kept.err) { ret err[fail.Fail].err{kept.err}; }
    ret result;
}

fun load_phase_impl(p: *project.Project, extra_roots: *intern.StrId,
    extra_root_count: u32) err[fail.Fail] {
    val te: *project.TargetEntry = p.target_entry;

    val fp_r: err[fail.Fail] = config.select_target(p, te);
    if (sel fp_r.err) {
        ret err[fail.Fail].err{fp_r.err};
    }

    val entry_path_r: res[intern.StrId, fail.Fail] = driver_load.entry_module_fqn(p, te);
    if (sel entry_path_r.err) {
        ret err[fail.Fail].err{entry_path_r.err};
    }
    val entry_fqn: intern.StrId = entry_path_r.ok;

    readout.phase_begin(p.progress, readout.LOAD);
    project.set_origin(p, diagnostic.ORIGIN_LOAD);
    val load_r: res[session.ModuleId, fail.Fail] = driver_load.module_load(p, entry_fqn);
    if (sel load_r.err) {
        val failure: fail.Fail = entry_failure(p, entry_fqn, p.config.bin_name, te.entry_at, load_failure_of(p, load_r.err));
        ret driver_load.collect_loaded_parses(p, err[fail.Fail].err{failure});
    }

    if (p.roots == project.ROOT_UNION) {
        # under the union each artifact's walk attributes the modules it reaches first, so
        # a module of `shaded` reads `$bin.name == "shaded"` in a session rooted at `hello`;
        # the primary entry loaded first, so a module its walk reaches is the primary's
        val cell_artifact: intern.StrId = p.loader.artifact;
        var ei:            u32          = 0;
        for (ei < p.union_entry_count) {
            p.loader.artifact = p.union_entries[ei].artifact;
            val ue:  *project.ArtifactEntry           = ?p.union_entries[ei];
            val ear: res[session.ModuleId, fail.Fail] = driver_load.module_load(p, ue.fqn);
            if (sel ear.err) {
                p.loader.artifact = cell_artifact;
                val failure: fail.Fail = entry_failure(p, ue.fqn, ue.artifact, ue.at, load_failure_of(p, ear.err));
                ret driver_load.collect_loaded_parses(p, err[fail.Fail].err{failure});
            }
            ei = ei + 1;
        }
        # the artifacts this target does not build come next, so a module both reach is
        # this build's and one only they reach is gated out of it
        p.loader.foreign = true;
        var fi_: u32 = 0;
        for (fi_ < p.foreign_entry_count) {
            p.loader.artifact = p.foreign_entries[fi_].artifact;
            val fo:  *project.ArtifactEntry           = ?p.foreign_entries[fi_];
            val far: res[session.ModuleId, fail.Fail] = driver_load.module_load(p, fo.fqn);
            if (sel far.err) {
                p.loader.foreign  = false;
                p.loader.artifact = cell_artifact;
                val failure: fail.Fail = entry_failure(p, fo.fqn, fo.artifact, fo.at, load_failure_of(p, far.err));
                ret driver_load.collect_loaded_parses(p, err[fail.Fail].err{failure});
            }
            fi_ = fi_ + 1;
        }
        p.loader.foreign  = false;
        p.loader.artifact = cell_artifact;
    }

    p.emit_len = p.topo_len;

    var xi: u32 = 0;
    for (xi < extra_root_count) {
        val xr: res[session.ModuleId, fail.Fail] = driver_load.module_load(p, extra_roots[xi]);
        if (sel xr.err) {
            ret driver_load.collect_loaded_parses(p, err[fail.Fail].err{load_failure_of(p, xr.err)});
        }
        xi = xi + 1;
    }

    if (passes.test_build(p)) { p.emit_len = p.topo_len; }

    if (p.loader.dirty) {
        val ordered: err[fail.Fail] = reorder_topo(p);
        if (sel ordered.err) { ret ordered; }
    }

    val reg_r: err[fail.Fail] = driver_load.register_module_asts(p);
    if (sel reg_r.err) {
        ret err[fail.Fail].err{reg_r.err};
    }

    val cfg_in_r: err[fail.Fail] = context.freeze(p);
    if (sel cfg_in_r.err) {
        ret err[fail.Fail].err{cfg_in_r.err};
    }

    close_load_row(p);

    val strings_r: err[fail.Fail] = declared.decorator_strings_register(p);
    if (sel strings_r.err) {
        ret err[fail.Fail].err{strings_r.err};
    }
    val emb_r: err[fail.Fail] = declared.register_embed_inputs(p);
    if (sel emb_r.err) {
        ret err[fail.Fail].err{emb_r.err};
    }

    {
        readout.phase_begin(p.progress, readout.RESOLVE);
        fin { close_resolve_row(p); }
        val cached: err[fail.Fail] = passes.prepare_object_cache(p);
        if (sel cached.err) { ret err[fail.Fail].err{cached.err}; }
        val final_resolve: err[fail.Fail] = resolve_query_phase(p);
        if (sel final_resolve.err) { ret err[fail.Fail].err{final_resolve.err}; }
    }

    val exp_r: err[fail.Fail] = declared.register_export_names(p);
    if (sel exp_r.err) {
        ret err[fail.Fail].err{exp_r.err};
    }

    ret err[fail.Fail].ok{};
}

# re-derive a loaded project's frontend after one module's text changed, without
# reloading its closure. the module is reparsed and re-walked in place; when its load
# surface survived (driver_load.module_reload), the module set and topo are as loaded and
# the query phases rerun over them, so every unchanged module's resolve and sema are
# hits and only the edited module and its dependents recompute. a surface that did
# not survive is reported as ok(false): the caller reloads
# ---
# p:     the loaded project, at least at FRONTEND_RESOLVE
# mid:   the module whose text changed
# phase: the frontend phase to re-derive to, at most the one the project was loaded to
# ret:   ok(true) when refreshed, a rejection included since the project's standing carries it;
#        ok(false) when the caller must reload; or the internal failure
pub fun refresh_frontend(p: *project.Project, mid: session.ModuleId, phase: FrontendPhase) res[bool, fail.Fail] {
    if (phase > FRONTEND_SEMA) { ret res[bool, fail.Fail].err{fail.message("unknown frontend analysis phase")}; }
    if (module.is_nil(mid) || mid::u32 >= project.module_count(p)) {
        ret res[bool, fail.Fail].err{fail.message("driver: refresh names a module outside the loaded project")};
    }
    val s: *session.Session     = p.s;
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(s.alloc);
    diagnostic.drop_file(?p.diags, m.file_id);
    val syn: *ast.Ast = frontend.syntax(p, m);
    if (syn != nil) { linkage.forget_export_names(?p.linkage, mid, syn.decls.len::u32); }

    project.set_origin(p, diagnostic.ORIGIN_LOAD);
    val kept: res[bool, fail.Fail] = driver_load.module_reload(p, mid);
    if (sel kept.err) { ret res[bool, fail.Fail].err{kept.err}; }
    if (!kept.ok)     { ret res[bool, fail.Fail].ok{false}; }

    val derived: err[fail.Fail] = refresh_phases(p, phase);
    val kept_r:  err[fail.Fail] = retain_loaded(p, derived);
    val fin_r:   err[fail.Fail] = phase_finish(p, kept_r);
    # a rejection is a refreshed project whose diagnostics say so, as under the tolerant load
    if (sel fin_r.err) {
        if (!fail.is_reported(fin_r.err)) { ret res[bool, fail.Fail].err{fin_r.err}; }
    }
    ret res[bool, fail.Fail].ok{true};
}

# the phases after the load walk, over a project whose module set is settled
fun refresh_phases(p: *project.Project, phase: FrontendPhase) err[fail.Fail] {
    cache.forget(p);
    val reg_r: err[fail.Fail] = driver_load.register_module_asts(p);
    if (sel reg_r.err) { ret err[fail.Fail].err{reg_r.err}; }
    val strings_r: err[fail.Fail] = declared.decorator_strings_register(p);
    if (sel strings_r.err) { ret err[fail.Fail].err{strings_r.err}; }
    val emb_r: err[fail.Fail] = declared.register_embed_inputs(p);
    if (sel emb_r.err) { ret err[fail.Fail].err{emb_r.err}; }
    val resolved: err[fail.Fail] = resolve_query_phase(p);
    if (sel resolved.err) { ret err[fail.Fail].err{resolved.err}; }
    val exp_r: err[fail.Fail] = declared.register_export_names(p);
    if (sel exp_r.err)          { ret err[fail.Fail].err{exp_r.err}; }
    if (phase == FRONTEND_SEMA) { ret run_sema_pass(p); }
    ret err[fail.Fail].ok{};
}

fun resolve_query_phase(p: *project.Project) err[fail.Fail] {
    project.set_origin(p, diagnostic.ORIGIN_RESOLVE);
    # what the load walk decided for each module is an input the resolution reads
    val viewed: err[fail.Fail] = frontend.record_load_views(p);
    if (sel viewed.err) { ret viewed; }
    var roots: Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        if (lang_source.file_is_nil(m.file_id)) {
            i = i + 1;
            cnt;
        }
        val added: res[usize, A.Error] = collections_vector.push[query.QueryKey](?roots,
            query.QueryKey{kind: ?frontend.PARSE, key: lang_source.file_index(m.file_id)::u64});
        if (sel added.err) {
            ret err[fail.Fail].err{fail.refused(added.err)};
        }
        i = i + 1;
    }
    val resolved: err[fail.Fail] = append_phase_roots(p, ?roots, ?frontend.RESOLVE, p.topo_len);
    if (sel resolved.err) { ret resolved; }
    val exported: err[fail.Fail] = append_phase_roots(p, ?roots, ?frontend.EXPORTS, p.topo_len);
    if (sel exported.err) { ret exported; }
    val begun: res[query.Operation, fail.Fail] = frontend.begin_query_phase(p);
    if (sel begun.err) {
        ret err[fail.Fail].err{begun.err};
    }
    var computed:    err[fail.Fail] = driver_load.acquire_loaded_parses(p);
    val computed_ok: bool           = sel computed.ok;
    if (computed_ok) { computed = passes.run_resolve_pass(p); }
    var result: err[fail.Fail] = err[fail.Fail].ok{};
    if (sel computed.err) {
        result = err[fail.Fail].err{computed.err};
    }
    ret frontend.finish_query_phase(p, begun.ok, roots.data, roots.len, result);
}

# a module walked again under a union tuple it was reached under late can import one the topo
# placed after it, so the topo is ordered again, the modules the build emits first
fun reorder_topo(p: *project.Project) err[fail.Fail] {
    var emit_roots:      *session.ModuleId = nil;
    val emit_root_count: u32               = p.emit_len;
    if (emit_root_count > 0) {
        val er: res[*session.ModuleId, A.Error] = A.allocate[session.ModuleId](p.alloc, emit_root_count::usize);
        if (sel er.err) { ret err[fail.Fail].err{fail.refused(er.err)}; }
        emit_roots = er.ok;
        var ei: u32 = 0;
        for (ei < emit_root_count) {
            emit_roots[ei] = p.topo[ei];
            ei             = ei + 1;
        }
    }
    val tr: err[fail.Fail] = driver_load.rebuild_topo(p, emit_roots, emit_root_count);
    if (emit_roots != nil) { A.deallocate[session.ModuleId](p.alloc, emit_roots, emit_root_count::usize); }
    ret tr;
}

fun close_load_row(p: *project.Project) {
    readout.phase_dropped(p.progress, readout.LOAD, project.module_count(p) - p.topo_len);
    readout.phase_end(p.progress, readout.LOAD, project.module_count(p), "module", "modules");
}

fun close_resolve_row(p: *project.Project) {
    readout.phase_end(p.progress, readout.RESOLVE, cache.frontend_count(p), "module", "modules");
}

# the root manifest of the project at `project_root`, read once: its text, an
# open buffer's when the session holds one, becomes the session's input for the
# file, so a warm session sees an edit to it as an input change, and the manifest
# records the input and the revision it was read at
# ---
# s:            the session; its build allocator owns the manifest
# project_root: the project root
# ret:          the manifest, released with `manifest.dnit`; err when it cannot be
#               read, does not parse or fails a check
pub fun load_manifest(s: *session.Session, project_root: str) res[manifest.Manifest, fail.Fail] {
    val path_r: res[str, A.Error] = types_path.join(s.build_alloc, project_root, manifest.MANIFEST_FILE);
    if (sel path_r.err) { ret res[manifest.Manifest, fail.Fail].err{fail.refused(path_r.err)}; }
    val path: str = path_r.ok;
    fin { str_free(s.build_alloc, path); }

    # the text read off disk is this call's; the session and the parse each keep their own copy
    var text:     str      = nil;
    var read_off: bool     = false;
    val buffered: opt[str] = session.overlay_get(s, path);
    if (sel buffered.some) { text = buffered.some; }
    or {
        val read: res[str, fs.FsError] = fs.read_string(s.build_alloc, path);
        if (sel read.err) {
            val said: res[str, fail.Fail] = fail.format(s.build_alloc, "cannot read '{}': {}", path, fail.fs_text(read.err));
            if (sel said.err) { ret res[manifest.Manifest, fail.Fail].err{said.err}; }
            ret res[manifest.Manifest, fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, said.ok)};
        }
        text     = read.ok;
        read_off = true;
    }
    fin {
        if (read_off) { str_free(s.build_alloc, text); }
    }
    val loaded: res[lang_source.FileId, fail.Fail] = session.load_source(s, path, text);
    if (sel loaded.err) { ret res[manifest.Manifest, fail.Fail].err{loaded.err}; }

    val parsed: res[manifest.Manifest, fail.Fail] = manifest.parse_text(s.build_alloc, ?s.interner, path, text);
    if (sel parsed.err) { ret parsed; }
    var m: manifest.Manifest = parsed.ok;
    m.source          = loaded.ok;
    m.source_revision = query.peek_revision(?s.queries, ?session.FILE_TEXT, lang_source.file_index(loaded.ok)::u64);

    val reg: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel reg.err) {
        manifest.dnit(?m, s.build_alloc);
        ret res[manifest.Manifest, fail.Fail].err{reg.err};
    }
    val sk: err[fail.Fail] = manifest.check_stack_keys(s.build_alloc, ?s.interner, reg.ok, ?m);
    if (sel sk.err) {
        manifest.dnit(?m, s.build_alloc);
        ret res[manifest.Manifest, fail.Fail].err{sk.err};
    }
    ret res[manifest.Manifest, fail.Fail].ok{m};
}

# a load that failed: the frontend's recorded status wins over the loader's
# own failure, and a loader message is the user's
fun load_failure_of(p: *project.Project, f: fail.Fail) fail.Fail {
    val status: fail.PhaseStatus = frontend.frontend_status(p);
    if (!sel status.kind.accepted) { ret fail.phase_failure(status); }
    ret fail.as_user(diagnostic_kind.SOURCE_LOAD, f);
}

# a load failure of the module an artifact's `entry` names: when the entry's own file could
# not be read, the failure names the key and points at where the manifest writes it
fun entry_failure(p: *project.Project, fqn: intern.StrId, artifact: intern.StrId, at: fail.Place, f: fail.Fail) fail.Fail {
    if (fail.kind_of(f) != diagnostic_kind.SOURCE_LOAD) { ret f; }
    if (!driver_load.module_unread(p, fqn))             { ret f; }
    val text: res[str, fail.Fail] = fail.format_intern(?p.s.interner, p.alloc, "mach.toml: [artifact.{}].entry: {}", intern.text(?p.s.interner, artifact), fail.describe(f));
    if (sel text.err) { ret text.err; }
    ret fail.at(p.alloc, fail.with_text(f, text.ok), at);
}
