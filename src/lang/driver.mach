# two declared targets that no supported host matches
#[testing]
fun manifest_foreign_only() str {
    ret "[project]\nmach = \">=5\"\nid = \"foreign\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.bare]\nisa = \"aarch64\"\nbaseline = \"armv8-a+fp+simd\"\nos = \"freestanding\"\nabi = \"aapcs64\"\nof = \"elf\"\n\n[target.spare]\nisa = \"riscv64\"\nbaseline = \"rv64gc\"\nos = \"freestanding\"\nabi = \"lp64d\"\nof = \"elf\"\n\n[artifact.foreign]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/foreign\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n";
}

# `native` with no declared host target is refused before any step runs, and `-t` still selects it
test native__without_a_host_target_is_refused_naming_the_way_out {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[symbol(\"_start\")]\nfun start() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = scaffold(?alloc, manifest_foreign_only(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad:    i32                             = 0;
    var native: manifest.Selectors              = manifest.t_selectors("", "", "");
    val nr:     res[project.Project, fail.Fail] = build_project(?s, root, ?native);
    if (sel nr.ok) {
        var p: project.Project = nr.ok;
        project.dnit_project(?p);
        bad = 2;
    }
    if (sel nr.err) {
        val text: str = fail.describe(nr.err);
        if (!str_contains(text, "matches no declared target") || !str_contains(text, "bare (freestanding-aarch64)")
            || !str_contains(text, "with -t")) { bad = 3; }
    }

    var named: manifest.Selectors              = manifest.t_selectors("", "bare", "");
    val er:    res[project.Project, fail.Fail] = build_project(?s, root, ?named);
    if (sel er.err) { bad = 4; }
    if (sel er.ok) {
        var p: project.Project = er.ok;
        project.dnit_project(?p);
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

# `$project.name` and `$project.description` are refused at their use site as
# unknown paths, the same as any other wrong path
test project_path__name_and_description_are_refused_as_unknown {
    if (vec_diag("val n: *u8 = $project.name;\nfun main() i32 { ret 0; }\n", "unknown `$project.*` path") != 0)        { ret 1; }
    if (vec_diag("val d: *u8 = $project.description;\nfun main() i32 { ret 0; }\n", "unknown `$project.*` path") != 0) { ret 2; }
    if (vec_diag("val d: *u8 = $project.bogus;\nfun main() i32 { ret 0; }\n", "unknown `$project.*` path") != 0)       { ret 3; }
    if (!sema_clean("val i: *u8 = $project.id;\nval v: *u8 = $project.version;\nfun main() i32 { ret 0; }\n"))         { ret 4; }
    ret 0;
}

#[testing]
fun manifest_overlay_src() str {
    ret "[project]\nmach = \">=5\"\nid = \"ctxcase\"\nversion = \"1.2.3\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.beta]\nkind = \"bin\"\nentry = \"beta.mach\"\nout = \"{project.work}/bin/beta\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

test overlay__is_found_through_the_manifest_src {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "beta.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret no_such_symbol(); }\n";
    val root_r: res[str, fail.Fail] = scaffold(?alloc, manifest_overlay_src(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val root: str = root_r.ok;

    val ov_path: res[str, A.Error] = types_path.join(?alloc, root, "src/beta.mach");
    if (sel ov_path.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 3;
    }
    val osr: err[fail.Fail] = session.set_overlay(?s, ov_path.ok, "fun main() i32 { ret 0; }\n");
    if (sel osr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 3;
    }

    var bad: i32                               = 0;
    val mr:  res[manifest.Manifest, fail.Fail] = load_manifest(?s, root);
    if (sel mr.err) { bad = 4; }
    if (sel mr.ok) {
        var mf:  manifest.Manifest    = mr.ok;
        var req: request.BuildRequest = request.defaults();
        req.project_root = root;
        req.target       = "windows";
        req.profile      = "release";
        req.artifact     = "beta";
        req.goal         = request.GOAL_OBJECTS;
        req.opt          = request.OPT_RELEASE;

        val pr: res[project.Project, fail.Fail] = analyze_project_tolerant(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0, FRONTEND_SEMA);
        if (sel pr.err) { bad = 5; }
        if (sel pr.ok) {
            var p: project.Project = pr.ok;
            if (diagnostic.error_count(?p.s.diags) != 0) { bad = 6; }
            project.dnit_project(?p);
        }
        manifest.dnit(?mf, ?alloc);
    }

    session.dnit(?s);
    fs.remove_all(?alloc, root);
    ret bad;
}

#[testing]
fun manifest_stack_elf() str {
    ret "[project]\nmach = \">=5\"\nid = \"stk\"\nversion = \"0.1.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.win]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\nstack_reserve = 8388608\n\n[target.lin]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\nstack_reserve = 8388608\n\n[profile.debug]\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.stk]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/stk\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

# the pe case, which accepts the keys, is stack_reserve__reaches_the_linked_pe
test stack_reserve__refused_at_load_on_a_format_without_one {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";

    var bad: i32 = 0;

    val bad_root_r: res[str, fail.Fail] = scaffold(?alloc, manifest_stack_elf(), ?names[0], ?texts[0], 1);
    if (sel bad_root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val bad_root: str = bad_root_r.ok;

    val br: res[manifest.Manifest, fail.Fail] = load_manifest(?s, bad_root);
    if (sel br.ok) {
        var m: manifest.Manifest = br.ok;
        manifest.dnit(?m, ?alloc);
        bad = 3;
    }
    if (sel br.err) {
        val msg: str = fail.describe(br.err);
        if (!str_contains(msg, "stack_reserve") && bad == 0) { bad = 4; }
        if (!str_contains(msg, "lin") && bad == 0)           { bad = 5; }
        if (!str_contains(msg, "elf") && bad == 0)           { bad = 6; }
    }
    fs.remove_all(?alloc, bad_root);
    session.dnit(?s);
    ret bad;
}

# a rebuild of the project at `root` on a live session, its default cell loaded as a build loads it
#[testing]
pub fun rebuild(s: *session.Session, root: str) res[project.Project, fail.Fail] {
    var selection: manifest.Selectors = manifest.t_selectors("", "", "");
    ret build_project(s, root, ?selection);
}

# a rebuild typed by the semantic pass
#[testing]
fun sema_build(s: *session.Session, root: str) res[project.Project, fail.Fail] {
    val pr: res[project.Project, fail.Fail] = rebuild(s, root);
    if (sel pr.err) { ret pr; }
    var p:  project.Project = pr.ok;
    val se: err[fail.Fail]  = run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, fail.Fail].err{se.err};
    }
    ret res[project.Project, fail.Fail].ok{p};
}

# a rebuild typed and lowered, optimized for release when `release` holds
#[testing]
fun lowered(s: *session.Session, root: str, release: bool) res[project.Project, fail.Fail] {
    val pr: res[project.Project, fail.Fail] = rebuild(s, root);
    if (sel pr.err) { ret pr; }
    var p:      project.Project = pr.ok;
    var handed: bool            = false;
    fin {
        if (!handed) { project.dnit_project(?p); }
    }
    if (release) {
        var req: request.BuildRequest = p.req;
        req.opt = request.OPT_RELEASE;
        val reconfigured: err[fail.Fail] = reconfigure(?p, req);
        if (sel reconfigured.err) { ret res[project.Project, fail.Fail].err{reconfigured.err}; }
    }
    val se: err[fail.Fail] = run_sema_pass(?p);
    if (sel se.err) { ret res[project.Project, fail.Fail].err{se.err}; }
    val le: err[fail.Fail] = run_lower_pass(?p);
    if (sel le.err) { ret res[project.Project, fail.Fail].err{le.err}; }
    handed = true;
    ret res[project.Project, fail.Fail].ok{p};
}

# a query's value copied out of the session, and the revision it last changed at
#[testing]
pub rec QuerySnapshot {
    value:        *u8;
    value_len:    u32;
    last_changed: query.Revision;
}

#[testing]
pub fun query_snapshot(a: *A.Allocator, p: *project.Project, kind: *query.Kind, key: u64) res[QuerySnapshot, fail.Fail] {
    val begun: res[query.Operation, fail.Fail] = frontend.begin_query_phase(p);
    if (sel begun.err) { ret res[QuerySnapshot, fail.Fail].err{begun.err}; }
    val operation: query.Operation                 = begun.ok;
    var snapshot:  QuerySnapshot;
    var error:     str                             = nil;
    val acquired:  res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, kind, key);
    if (sel acquired.err) { error = "query snapshot acquisition failed"; }
    if (sel acquired.ok) {
        val view: query.QueryView = acquired.ok;
        snapshot.value_len    = view.value_len;
        snapshot.last_changed = view.last_changed;
        if (view.value_len != 0) {
            val allocated: res[*u8, A.Error] = A.allocate[u8](a, view.value_len::usize);
            if (sel allocated.err) { error = "query snapshot allocation failed"; }
            if (sel allocated.ok) {
                snapshot.value = allocated.ok;
                memory.raw_copy(snapshot.value::ptr, view.value::ptr, view.value_len::usize);
            }
        }
    }
    val ended: err[fail.Fail] = query.end(?p.s.queries, operation);
    if (sel ended.err) { error = "query snapshot operation failed"; }
    val discarded: err[fail.Fail] = query.discard(?p.s.queries, operation);
    if (sel discarded.err) { error = "query snapshot presentation discard failed"; }
    if (error != nil) {
        if (snapshot.value != nil) { A.deallocate[u8](a, snapshot.value, snapshot.value_len::usize); }
        ret res[QuerySnapshot, fail.Fail].err{fail.message(error)};
    }
    ret res[QuerySnapshot, fail.Fail].ok{snapshot};
}

# the revision a module's lowering last changed at, all ones when it has none
#[testing]
fun lower_lc(s: *session.Session, stable: session.StableModuleId) query.Revision {
    val revision: query.Revision = query.peek_revision(?s.queries, ?passes.LOWER, module.stable_index(stable)::u64);
    if (revision == 0) { ret 0xFFFFFFFFFFFFFFFF; }
    ret revision;
}

# a rebuild reuses an unchanged module's ast and reparses an edited one
test qparse__reuses_unchanged_and_reparses_edited {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.a;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, fail.Fail] = rebuild(?s, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p1:    project.Project = p1r.ok;
    val main1: *ast.Ast        = frontend.syntax_named(?p1, "uniontest.main");
    val a1:    *ast.Ast        = frontend.syntax_named(?p1, "uniontest.a");
    if (main1 == nil || a1 == nil) { bad = 1; }
    val sources: usize = lang_source.count(?s.sources);
    project.dnit_project(?p1);

    val p2r: res[project.Project, fail.Fail] = rebuild(?s, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2: project.Project = p2r.ok;
    if (frontend.syntax_named(?p2, "uniontest.main") != main1) { bad = 1; }
    if (frontend.syntax_named(?p2, "uniontest.a") != a1)       { bad = 1; }
    project.dnit_project(?p2);

    if (!write_source(?alloc, root, "a.mach", "pub fun fa() i32 { ret 2; }\n")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val p3r: res[project.Project, fail.Fail] = rebuild(?s, root);
    if (sel p3r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p3: project.Project = p3r.ok;
    if (frontend.syntax_named(?p3, "uniontest.main") != main1) { bad = 1; }
    if (frontend.syntax_named(?p3, "uniontest.a") == a1)       { bad = 1; }
    # the reloaded file replaces its source by path rather than adding one
    if (lang_source.count(?s.sources) != sources) { bad = 1; }
    project.dnit_project(?p3);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test query_reuse__replays_diagnostics {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun dup() i32 { ret 1; }\nfun dup() i32 { ret 2; }\n\nfun main() i32 { ret 0; }\n";

    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, fail.Fail] = rebuild(?s, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p1: project.Project = p1r.ok;

    val cold_r: res[*diagnostic.DiagnosticStore, fail.Fail] = diagnostic.snapshot_from(?s.diags, 0, ?alloc);
    if (sel cold_r.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val cold: *diagnostic.DiagnosticStore = cold_r.ok;
    if (diagnostic.len(cold) == 0) { bad = 1; }
    project.dnit_project(?p1);

    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(?alloc);

    val p2r: res[project.Project, fail.Fail] = rebuild(?s, root);
    if (sel p2r.err) {
        diagnostic.store_dnit(cold);
        A.deallocate[diagnostic.DiagnosticStore](?alloc, cold, 1::usize);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2: project.Project = p2r.ok;
    if (!diagnostic.same(?s.diags, cold)) { bad = 1; }
    project.dnit_project(?p2);

    diagnostic.store_dnit(cold);
    A.deallocate[diagnostic.DiagnosticStore](?alloc, cold, 1::usize);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test overlay__reparses_exactly_the_overlaid_module {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.a;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, fail.Fail] = rebuild(?s, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p1:    project.Project = p1r.ok;
    val main1: *ast.Ast        = frontend.syntax_named(?p1, "uniontest.main");
    val a1:    *ast.Ast        = frontend.syntax_named(?p1, "uniontest.a");
    if (main1 == nil || a1 == nil) { bad = 1; }
    val a_mid: session.ModuleId = project.module_named(?p1, "uniontest.a");
    if (module.is_nil(a_mid)) {
        fs.remove_all(?alloc, root);
        project.dnit_project(?p1);
        session.dnit(?s);
        ret 1;
    }
    val a_fid: lang_source.FileId = project.module_at(?p1, a_mid::u32).file_id;
    project.dnit_project(?p1);

    val sf_opt: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, a_fid);
    if (sel sf_opt.none) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val a_path: str = sf_opt.some.path;

    val ov_text:       str            = "pub fun fa() i32 { ret 2; }\n";
    val set_overlay_r: err[fail.Fail] = session.set_overlay(?s, a_path, ov_text);
    if (sel set_overlay_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val p2r: res[project.Project, fail.Fail] = rebuild(?s, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2: project.Project = p2r.ok;
    if (frontend.syntax_named(?p2, "uniontest.main") != main1) { bad = 1; }
    if (frontend.syntax_named(?p2, "uniontest.a") == a1)       { bad = 1; }
    val a2: *ast.Ast = frontend.syntax_named(?p2, "uniontest.a");
    project.dnit_project(?p2);

    val set_overlay_r2: err[fail.Fail] = session.set_overlay(?s, a_path, ov_text);
    if (sel set_overlay_r2.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val p3r: res[project.Project, fail.Fail] = rebuild(?s, root);
    if (sel p3r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p3: project.Project = p3r.ok;
    if (frontend.syntax_named(?p3, "uniontest.main") != main1) { bad = 1; }
    if (frontend.syntax_named(?p3, "uniontest.a") != a2)       { bad = 1; }
    project.dnit_project(?p3);

    val cleared: res[bool, fail.Fail] = session.clear_overlay(?s, a_path);
    if (!(sel cleared.ok && !(!cleared.ok))) { bad = 1; }
    val p4r: res[project.Project, fail.Fail] = rebuild(?s, root);
    if (sel p4r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p4: project.Project = p4r.ok;
    if (frontend.syntax_named(?p4, "uniontest.main") != main1) { bad = 1; }
    if (frontend.syntax_named(?p4, "uniontest.a") == a2)       { bad = 1; }
    project.dnit_project(?p4);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test stable_module_id__survives_a_reshape {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.a;\nuse uniontest.b;\n\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";

    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, fail.Fail] = rebuild(?s, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p1:        project.Project        = p1r.ok;
    val mid_a1:    session.ModuleId       = project.module_named(?p1, "uniontest.a");
    val mid_b1:    session.ModuleId       = project.module_named(?p1, "uniontest.b");
    val sid_main1: session.StableModuleId = project.stable_named(?p1, "uniontest.main");
    val sid_a1:    session.StableModuleId = project.stable_named(?p1, "uniontest.a");
    val sid_b1:    session.StableModuleId = project.stable_named(?p1, "uniontest.b");
    if (module.is_nil(mid_a1) || module.is_nil(mid_b1))               { bad = 1; }
    if (module.stable_is_nil(sid_a1) || module.stable_is_nil(sid_b1)) { bad = 1; }
    project.dnit_project(?p1);

    if (!write_source(?alloc, root, "main.mach", "use uniontest.b;\nuse uniontest.a;\n\nfun main() i32 { ret 0; }\n")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val p2r: res[project.Project, fail.Fail] = rebuild(?s, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2:        project.Project        = p2r.ok;
    val mid_a2:    session.ModuleId       = project.module_named(?p2, "uniontest.a");
    val mid_b2:    session.ModuleId       = project.module_named(?p2, "uniontest.b");
    val sid_main2: session.StableModuleId = project.stable_named(?p2, "uniontest.main");
    val sid_a2:    session.StableModuleId = project.stable_named(?p2, "uniontest.a");
    val sid_b2:    session.StableModuleId = project.stable_named(?p2, "uniontest.b");

    if (module.same(mid_a1, mid_a2) && module.same(mid_b1, mid_b2)) { bad = 1; }
    if (!module.stable_same(sid_main2, sid_main1))                  { bad = 1; }
    if (!module.stable_same(sid_a2, sid_a1))                        { bad = 1; }
    if (!module.stable_same(sid_b2, sid_b1))                        { bad = 1; }
    project.dnit_project(?p2);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test qexports__firewalls_a_body_edit {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "pub fun f(a: i32) i32 { ret a; }\n";

    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, fail.Fail] = rebuild(?s, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p1:     project.Project        = p1r.ok;
    val stable: session.StableModuleId = project.stable_named(?p1, "uniontest.main");
    if (module.stable_is_nil(stable)) { bad = 1; }
    val q1: res[QuerySnapshot, fail.Fail] = query_snapshot(?alloc, ?p1, ?frontend.EXPORTS, module.stable_index(stable)::u64);
    if (sel q1.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val ent1: QuerySnapshot  = q1.ok;
    val lc1:  query.Revision = ent1.last_changed;
    val len1: u32            = ent1.value_len;
    val fp1:  *u8            = ent1.value;
    if (len1 == 0) { bad = 1; }
    project.dnit_project(?p1);

    val body_edit: str = "pub fun f(a: i32) i32 { val t: i32 = a; ret t; }\n";
    if (!write_source(?alloc, root, "main.mach", body_edit)) {
        A.deallocate[u8](?alloc, fp1, len1::usize);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val p2r: res[project.Project, fail.Fail] = rebuild(?s, root);
    if (sel p2r.err) {
        A.deallocate[u8](?alloc, fp1, len1::usize);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2: project.Project               = p2r.ok;
    val q2: res[QuerySnapshot, fail.Fail] = query_snapshot(?alloc, ?p2, ?frontend.EXPORTS, module.stable_index(stable)::u64);
    if (sel q2.err) {
        project.dnit_project(?p2);
        A.deallocate[u8](?alloc, fp1, len1::usize);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val ent2: QuerySnapshot = q2.ok;
    if (ent2.last_changed != lc1)                                  { bad = 1; }
    if (ent2.value_len != len1)                                    { bad = 1; }
    or (!memory.raw_equal(ent2.value::ptr, fp1::ptr, len1::usize)) { bad = 1; }
    if (ent2.value != nil)                                         { A.deallocate[u8](?alloc, ent2.value, ent2.value_len::usize); }
    project.dnit_project(?p2);

    val surf_edit: str = "pub fun f(a: i32) i32 { ret a; }\npub fun g() i32 { ret 0; }\n";
    if (!write_source(?alloc, root, "main.mach", surf_edit)) {
        A.deallocate[u8](?alloc, fp1, len1::usize);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val p3r: res[project.Project, fail.Fail] = rebuild(?s, root);
    if (sel p3r.err) {
        A.deallocate[u8](?alloc, fp1, len1::usize);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p3: project.Project               = p3r.ok;
    val q3: res[QuerySnapshot, fail.Fail] = query_snapshot(?alloc, ?p3, ?frontend.EXPORTS, module.stable_index(stable)::u64);
    if (sel q3.err) {
        project.dnit_project(?p3);
        A.deallocate[u8](?alloc, fp1, len1::usize);
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val ent3: QuerySnapshot = q3.ok;
    if (ent3.last_changed == lc1)                                                           { bad = 1; }
    if (ent3.value_len == len1 && memory.raw_equal(ent3.value::ptr, fp1::ptr, len1::usize)) { bad = 1; }
    if (ent3.value != nil)                                                                  { A.deallocate[u8](?alloc, ent3.value, ent3.value_len::usize); }
    project.dnit_project(?p3);

    A.deallocate[u8](?alloc, fp1, len1::usize);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

#[testing]
fun resolve_lc(s: *session.Session, stable: session.StableModuleId) query.Revision {
    val revision: query.Revision = query.peek_revision(?s.queries, ?frontend.RESOLVE, module.stable_index(stable)::u64);
    if (revision == 0) { ret 0xFFFFFFFFFFFFFFFF; }
    ret revision;
}

#[testing]
fun name_text_equal(sa: *session.Session, na: intern.StrId, sb: *session.Session, nb: intern.StrId) bool {
    val oa: opt[str] = intern.get(?sa.interner, na);
    val ob: opt[str] = intern.get(?sb.interner, nb);
    if (sel oa.none && sel ob.none) { ret true; }
    if (sel oa.none)                { ret false; }
    if (sel ob.none)                { ret false; }
    val ta: str   = oa.some;
    val tb: str   = ob.some;
    val la: usize = str_len(ta);
    if (la != str_len(tb)) { ret false; }
    ret memory.raw_equal(ta::ptr, tb::ptr, la);
}

#[testing]
fun rr_struct_equal(sa: *session.Session, ra: *resolve.ResolveResult, sb: *session.Session, rb: *resolve.ResolveResult) bool {
    if (ra == nil || rb == nil)             { ret false; }
    if (ra.symbol_count != rb.symbol_count) { ret false; }
    if (ra.pub_count != rb.pub_count)       { ret false; }
    if (ra.expr_count != rb.expr_count)     { ret false; }
    if (ra.type_count != rb.type_count)     { ret false; }
    if (ra.decl_count != rb.decl_count)     { ret false; }

    var i: u32 = 0;
    for (i < ra.expr_count) {
        if (!resolve.symbol_same(ra.expr_resolved[i], rb.expr_resolved[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < ra.type_count) {
        if (!resolve.symbol_same(ra.type_resolved[i], rb.type_resolved[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < ra.decl_count) {
        if (!resolve.symbol_same(ra.decl_symbol[i], rb.decl_symbol[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < ra.symbol_count) {
        val xa: *resolve.Symbol = ?ra.symbols[i];
        val xb: *resolve.Symbol = ?rb.symbols[i];
        if (xa.kind != xb.kind)                           { ret false; }
        if (xa.flags != xb.flags)                         { ret false; }
        if (!ast_id.decl_same(xa.decl, xb.decl))          { ret false; }
        if (xa.slot != xb.slot)                           { ret false; }
        if (!module.stable_same(xa.origin, xb.origin))    { ret false; }
        if (!name_text_equal(sa, xa.name, sb, xb.name))   { ret false; }
        if (!name_text_equal(sa, xa.canon, sb, xb.canon)) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun rr_of(p: *project.Project, s: *session.Session, fqn: str) *resolve.ResolveResult {
    val mid: session.ModuleId = project.module_named(p, fqn);
    if (module.is_nil(mid)) { ret nil; }
    ret frontend.resolved(p, project.module_at(p, mid::u32));
}

test resolve__pub_surface_change_equals_scratch {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.fa;\nfun main() i32 { ret fa(); }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val pA1r: res[project.Project, fail.Fail] = rebuild(?sA, root);
    if (sel pA1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA1:        project.Project        = pA1r.ok;
    val st_main:    session.StableModuleId = project.stable_named(?pA1, "uniontest.main");
    val lc_main_1:  query.Revision         = resolve_lc(?sA, st_main);
    val rr_main_1:  *resolve.ResolveResult = rr_of(?pA1, ?sA, "uniontest.main");
    var fa_found_1: bool                   = false;
    var si:         u32                    = 0;
    for (si < rr_main_1.symbol_count) {
        val lookup_r: opt[str] = intern.get(?sA.interner, rr_main_1.symbols[si].canon);
        if (sel lookup_r.none) { ret 99; }
        if (rr_main_1.symbols[si].kind == resolve.SYM_IMPORTED
            && str_equals(lookup_r.some, "fa")) {
            fa_found_1 = true;
            if (!ast_id.decl_is_nil(rr_main_1.symbols[si].decl)) { bad = 1; }
        }
        si = si + 1;
    }
    project.dnit_project(?pA1);

    if (!write_source(?alloc, root, "leaf.mach", "pub fun fz() *u8 { ret nil; }\npub fun fa() i32 { ret 1; }\n")) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    val pA2r: res[project.Project, fail.Fail] = rebuild(?sA, root);
    if (sel pA2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA2:       project.Project = pA2r.ok;
    val lc_main_2: query.Revision  = resolve_lc(?sA, st_main);

    if (lc_main_2 == lc_main_1) { bad = 1; }
    val rr_main_2:  *resolve.ResolveResult = rr_of(?pA2, ?sA, "uniontest.main");
    var fa_found_2: bool                   = false;
    si = 0;
    for (si < rr_main_2.symbol_count) {
        val lookup_r2: opt[str] = intern.get(?sA.interner, rr_main_2.symbols[si].canon);
        if (sel lookup_r2.none) { ret 99; }
        if (rr_main_2.symbols[si].kind == resolve.SYM_IMPORTED
            && str_equals(lookup_r2.some, "fa")) {
            fa_found_2 = true;
            if (!ast_id.decl_is_nil(rr_main_2.symbols[si].decl)) { bad = 1; }
        }
        si = si + 1;
    }
    if (!fa_found_1 || !fa_found_2) { bad = 1; }

    val run_sema_pass_r: err[fail.Fail] = run_sema_pass(?pA2);
    if (sel run_sema_pass_r.err) { bad = 1; }

    val sr2: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var sB:  session.Session                 = sr2.ok;
    val pBr: res[project.Project, fail.Fail] = rebuild(?sB, root);
    if (sel pBr.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pB: project.Project = pBr.ok;

    if (!rr_struct_equal(?sA, rr_main_2, ?sB, rr_of(?pB, ?sB, "uniontest.main")))                          { bad = 1; }
    if (!rr_struct_equal(?sA, rr_of(?pA2, ?sA, "uniontest.leaf"), ?sB, rr_of(?pB, ?sB, "uniontest.leaf"))) { bad = 1; }

    project.dnit_project(?pB);
    session.dnit(?sB);
    project.dnit_project(?pA2);
    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test resolve__const_value_change_equals_scratch {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.FLAG;\n$if (FLAG) {\n  fun extra() i32 { ret 1; }\n}\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val FLAG: u8 = 1;\n";

    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val pA1r: res[project.Project, fail.Fail] = rebuild(?sA, root);
    if (sel pA1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA1:       project.Project        = pA1r.ok;
    val st_main:   session.StableModuleId = project.stable_named(?pA1, "uniontest.main");
    val lc_main_1: query.Revision         = resolve_lc(?sA, st_main);
    val sc_main_1: u32                    = rr_of(?pA1, ?sA, "uniontest.main").symbol_count;
    project.dnit_project(?pA1);

    if (!write_source(?alloc, root, "leaf.mach", "pub val FLAG: u8 = 0;\n")) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    val pA2r: res[project.Project, fail.Fail] = rebuild(?sA, root);
    if (sel pA2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA2: project.Project = pA2r.ok;

    if (resolve_lc(?sA, st_main) == lc_main_1)                        { bad = 1; }
    if (rr_of(?pA2, ?sA, "uniontest.main").symbol_count == sc_main_1) { bad = 1; }

    val sr2: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var sB:  session.Session                 = sr2.ok;
    val pBr: res[project.Project, fail.Fail] = rebuild(?sB, root);
    if (sel pBr.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pB: project.Project = pBr.ok;

    if (!rr_struct_equal(?sA, rr_of(?pA2, ?sA, "uniontest.main"), ?sB, rr_of(?pB, ?sB, "uniontest.main"))) { bad = 1; }
    if (!rr_struct_equal(?sA, rr_of(?pA2, ?sA, "uniontest.leaf"), ?sB, rr_of(?pB, ?sB, "uniontest.leaf"))) { bad = 1; }

    project.dnit_project(?pB);
    session.dnit(?sB);
    project.dnit_project(?pA2);
    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

# a body edit behind a `fwd` re-resolves only the leaf; a surface edit re-resolves the
# forwarding module and not its importer, and the result equals a scratch build
test resolve__reexport_two_hop_propagation {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA: session.Session = sr.ok;

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "mid.mach";
    names[2] = "leaf.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.mid;\nfun main() i32 { ret mid.fa(); }\n";
    texts[1] = "fwd uniontest.leaf.fa;\n";
    texts[2] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val pA1r: res[project.Project, fail.Fail] = rebuild(?sA, root);
    if (sel pA1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA1:       project.Project        = pA1r.ok;
    val st_main:   session.StableModuleId = project.stable_named(?pA1, "uniontest.main");
    val st_mid:    session.StableModuleId = project.stable_named(?pA1, "uniontest.mid");
    val st_leaf:   session.StableModuleId = project.stable_named(?pA1, "uniontest.leaf");
    val lc_main_1: query.Revision         = resolve_lc(?sA, st_main);
    val lc_mid_1:  query.Revision         = resolve_lc(?sA, st_mid);
    val lc_leaf_1: query.Revision         = resolve_lc(?sA, st_leaf);
    project.dnit_project(?pA1);

    val leaf_priv: str = "pub fun fa() i32 { val t: i32 = 1; ret t; }\n";
    if (!write_source(?alloc, root, "leaf.mach", leaf_priv)) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val pPr: res[project.Project, fail.Fail] = rebuild(?sA, root);
    if (sel pPr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pP: project.Project = pPr.ok;
    if (resolve_lc(?sA, st_mid) != lc_mid_1)   { bad = 1; }
    if (resolve_lc(?sA, st_main) != lc_main_1) { bad = 1; }
    if (resolve_lc(?sA, st_leaf) == lc_leaf_1) { bad = 1; }
    project.dnit_project(?pP);

    val leaf_pub: str = "pub fun fz() i32 { ret 0; }\npub fun fa() i32 { ret 1; }\n";
    if (!write_source(?alloc, root, "leaf.mach", leaf_pub)) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val pA2r: res[project.Project, fail.Fail] = rebuild(?sA, root);
    if (sel pA2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA2: project.Project = pA2r.ok;
    if (resolve_lc(?sA, st_mid) == lc_mid_1)   { bad = 1; }
    if (resolve_lc(?sA, st_main) != lc_main_1) { bad = 1; }

    val sr2: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var sB:  session.Session                 = sr2.ok;
    val pBr: res[project.Project, fail.Fail] = rebuild(?sB, root);
    if (sel pBr.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pB: project.Project = pBr.ok;

    if (!rr_struct_equal(?sA, rr_of(?pA2, ?sA, "uniontest.main"), ?sB, rr_of(?pB, ?sB, "uniontest.main"))) { bad = 1; }
    if (!rr_struct_equal(?sA, rr_of(?pA2, ?sA, "uniontest.mid"), ?sB, rr_of(?pB, ?sB, "uniontest.mid")))   { bad = 1; }
    if (!rr_struct_equal(?sA, rr_of(?pA2, ?sA, "uniontest.leaf"), ?sB, rr_of(?pB, ?sB, "uniontest.leaf"))) { bad = 1; }

    project.dnit_project(?pB);
    session.dnit(?sB);
    project.dnit_project(?pA2);
    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

#[testing]
fun surface_lc(s: *session.Session, stable: session.StableModuleId) query.Revision {
    val revision: query.Revision = query.peek_revision(?s.queries, ?passes.LOWERED_SURFACE, module.stable_index(stable)::u64);
    if (revision == 0) { ret 0xFFFFFFFFFFFFFFFF; }
    ret revision;
}

#[testing]
fun lower_lc_key(s: *session.Session, key: u64) query.Revision {
    val revision: query.Revision = query.peek_revision(?s.queries, ?passes.LOWER, key);
    if (revision == 0) { ret 0xFFFFFFFFFFFFFFFF; }
    ret revision;
}

# whether the unit defines a function named `name`
#[testing]
fun unit_defines(s: *session.Session, u: *lower_context.Unit, name: str) bool {
    ret unit_defined_count(s, u, name, true) == 1;
}

# how many functions the unit defines whose names contain `needle`, or with `exact` are it
#[testing]
fun unit_defined_count(s: *session.Session, u: *lower_context.Unit, needle: str, exact: bool) u32 {
    if (u == nil) { ret 0; }
    var hits: u32   = 0;
    var i:    usize = 0;
    for (i < u.fns.len) {
        val f:  *lower_context.FnInfo = ?u.fns.data[i];
        val nm: opt[str]              = intern.get(?s.interner, f.name);
        if (sel nm.some) {
            val text: str = nm.some;
            if (f.defined && ((exact && str_equals(text, needle)) || (!exact && str_contains(text, needle)))) { hits = hits + 1; }
        }
        i = i + 1;
    }
    ret hits;
}

#[testing]
fun unit_test_count(u: *lower_context.Unit) u32 {
    var count: u32   = 0;
    var i:     usize = 0;
    for (i < u.fns.len) {
        if (u.fns.data[i].test) { count = count + 1; }
        i = i + 1;
    }
    ret count;
}

# whether mirl's text of the unit holds `needle`
#[testing]
fun unit_holds(a: *A.Allocator, u: *lower_context.Unit, needle: str) bool {
    if (u == nil) { ret false; }
    var sink: text_sink.Sink = text_sink.init(a);
    fin { text_sink.dnit(?sink); }
    var w:       io_writer.Writer        = text_sink.writer(?sink);
    val written: err[text_printer.Error] = text_item.print(?w, ?u.m);
    if (sel written.err) { ret false; }
    val v: View  = text_sink.view(?sink);
    val n: usize = str_len(needle);
    var i: usize = 0;
    for (i + n <= v.len) {
        if (memory.raw_equal((?v.data[i])::ptr, needle::ptr, n)) { ret true; }
        i = i + 1;
    }
    ret false;
}

#[testing]
fun type_owner_equal(sa: *session.Session, a: type.TypeOwner, sb: *session.Session, b: type.TypeOwner) bool {
    if ((module.stable_is_nil(a.module)) != (module.stable_is_nil(b.module))) { ret false; }
    if (!module.stable_is_nil(a.module)) {
        val ma: session.ModuleId = session.module_id_for_stable(sa, a.module);
        val mb: session.ModuleId = session.module_id_for_stable(sb, b.module);
        if (module.is_nil(ma) || module.is_nil(mb)) { ret false; }
        val fa: intern.StrId = session.module_fqn(sa, ma);
        val fb: intern.StrId = session.module_fqn(sb, mb);
        if (intern.str_is_nil(fa) || intern.str_is_nil(fb) || !name_text_equal(sa, fa, sb, fb)) { ret false; }
    }
    if ((lang_source.file_is_nil(a.file)) != (lang_source.file_is_nil(b.file))) { ret false; }
    if (lang_source.file_is_nil(a.file))                                        { ret true; }
    val fa: opt[*lang_source.SourceFile] = lang_source.get(?sa.sources, a.file);
    val fb: opt[*lang_source.SourceFile] = lang_source.get(?sb.sources, b.file);
    if (sel fa.none) { ret false; }
    if (sel fb.none) { ret false; }
    ret str_equals(fa.some.path, fb.some.path);
}

#[testing]
fun ty_struct_equal(sa: *session.Session, ta: type.TypeId, sb: *session.Session, tb: type.TypeId) bool {
    if (type.is_nil(ta) && type.is_nil(tb))     { ret true; }
    if (type.is_error(ta) && type.is_error(tb)) { ret true; }
    if (type.is_nil(ta) || type.is_nil(tb))     { ret false; }
    if (type.is_error(ta) || type.is_error(tb)) { ret false; }

    val oa: opt[*type.Type] = type.get(?sa.types, ta);
    val ob: opt[*type.Type] = type.get(?sb.types, tb);
    if (sel oa.none) { ret false; }
    if (sel ob.none) { ret false; }
    val a: *type.Type = oa.some;
    val b: *type.Type = ob.some;
    if (a.kind != b.kind) { ret false; }
    val k: type.TypeKind = a.kind;

    if (type.is_prim(k))     { ret true; }
    if (k == type.TYPE_PACK) { ret true; }
    if (k == type.TYPE_POINTER) {
        ret ty_struct_equal(sa, a.data.pointer.base, sb, b.data.pointer.base);
    }
    if (k == type.TYPE_ARRAY) {
        if (a.data.array.count != b.data.array.count) { ret false; }
        ret ty_struct_equal(sa, a.data.array.base, sb, b.data.array.base);
    }
    if (k == type.TYPE_FUN) {
        if (a.data.fn.params_len != b.data.fn.params_len)                     { ret false; }
        if (!ty_struct_equal(sa, a.data.fn.ret_type, sb, b.data.fn.ret_type)) { ret false; }
        var i: u32 = 0;
        for (i < a.data.fn.params_len) {
            val pa: opt[type.TypeId] = type.get_param(?sa.types, a.data.fn.params_start + i);
            val pb: opt[type.TypeId] = type.get_param(?sb.types, b.data.fn.params_start + i);
            if (sel pa.none)                                { ret false; }
            if (sel pb.none)                                { ret false; }
            if (!ty_struct_equal(sa, pa.some, sb, pb.some)) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    if (k == type.TYPE_REC || k == type.TYPE_UNI) {
        if ((a.data.nominal.incarnation == 0) != (b.data.nominal.incarnation == 0)) { ret false; }
        if (!name_text_equal(sa, a.data.nominal.name, sb, b.data.nominal.name))     { ret false; }
        if (!name_text_equal(sa, a.data.nominal.syntax, sb, b.data.nominal.syntax)) { ret false; }
        ret type_owner_equal(sa, a.data.nominal.owner, sb, b.data.nominal.owner);
    }
    if (k == type.TYPE_GENERIC_PARAM) {
        if (a.data.generic_param.owner_kind != b.data.generic_param.owner_kind)                         { ret false; }
        if (a.data.generic_param.index != b.data.generic_param.index)                                   { ret false; }
        if (!name_text_equal(sa, a.data.generic_param.name, sb, b.data.generic_param.name))             { ret false; }
        if (!name_text_equal(sa, a.data.generic_param.owner_name, sb, b.data.generic_param.owner_name)) { ret false; }
        ret type_owner_equal(sa, a.data.generic_param.owner, sb, b.data.generic_param.owner);
    }
    if (k == type.TYPE_INSTANCE) {
        if (a.data.instance.args_len != b.data.instance.args_len)                       { ret false; }
        if (!ty_struct_equal(sa, a.data.instance.nominal, sb, b.data.instance.nominal)) { ret false; }
        var i: u32 = 0;
        for (i < a.data.instance.args_len) {
            val pa: opt[type.TypeId] = type.get_param(?sa.types, a.data.instance.args_start + i);
            val pb: opt[type.TypeId] = type.get_param(?sb.types, b.data.instance.args_start + i);
            if (sel pa.none)                                { ret false; }
            if (sel pb.none)                                { ret false; }
            if (!ty_struct_equal(sa, pa.some, sb, pb.some)) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    ret false;
}

#[testing]
fun sr_struct_equal(sa: *session.Session, sra: *fe_sema.SemaResult, sb: *session.Session, srb: *fe_sema.SemaResult) bool {
    if (sra == nil || srb == nil)                     { ret false; }
    if (sra.expr_count != srb.expr_count)             { ret false; }
    if (sra.type_count != srb.type_count)             { ret false; }
    if (sra.decl_count != srb.decl_count)             { ret false; }
    if (sra.embed_path_count != srb.embed_path_count) { ret false; }

    var i: u32 = 0;
    for (i < sra.expr_count) {
        if (!ty_struct_equal(sa, sra.expr_type[i], sb, srb.expr_type[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < sra.type_count) {
        if (!ty_struct_equal(sa, sra.type_resolved_ty[i], sb, srb.type_resolved_ty[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < sra.decl_count) {
        if (!ty_struct_equal(sa, sra.decl_type[i], sb, srb.decl_type[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < sra.embed_path_count) {
        val pa: opt[str] = intern.get(?sa.interner, sra.embed_paths[i]);
        val pb: opt[str] = intern.get(?sb.interner, srb.embed_paths[i]);
        if (sel pa.none)                   { ret false; }
        if (sel pb.none)                   { ret false; }
        if (!str_equals(pa.some, pb.some)) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun sr_of(p: *project.Project, s: *session.Session, fqn: str) *fe_sema.SemaResult {
    val mid: session.ModuleId = project.module_named(p, fqn);
    if (module.is_nil(mid)) { ret nil; }
    ret frontend.typed(p, project.module_at(p, mid::u32));
}

test sema__body_edit_firewall_equals_scratch {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.fa;\nfun main() i32 { val x: i32 = fa(); ret x; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";

    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val pA1r: res[project.Project, fail.Fail] = rebuild(?sA, root);
    if (sel pA1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA1:             project.Project = pA1r.ok;
    val run_sema_pass_r: err[fail.Fail]  = run_sema_pass(?pA1);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?pA1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val st_main:   session.StableModuleId = project.stable_named(?pA1, "uniontest.main");
    val st_leaf:   session.StableModuleId = project.stable_named(?pA1, "uniontest.leaf");
    val lc_main_1: query.Revision         = sema_lc(?sA, st_main);
    val lc_leaf_1: query.Revision         = sema_lc(?sA, st_leaf);
    project.dnit_project(?pA1);

    if (!write_source(?alloc, root, "leaf.mach", "pub fun fa() i32 { val t: i32 = 1; ret t; }\n")) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    val pA2r: res[project.Project, fail.Fail] = rebuild(?sA, root);
    if (sel pA2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA2:              project.Project = pA2r.ok;
    val run_sema_pass_r2: err[fail.Fail]  = run_sema_pass(?pA2);
    if (sel run_sema_pass_r2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val lc_main_2: query.Revision = sema_lc(?sA, st_main);
    val lc_leaf_2: query.Revision = sema_lc(?sA, st_leaf);

    if (lc_main_2 != lc_main_1) { bad = 2; }
    if (lc_leaf_2 == lc_leaf_1) { bad = 3; }

    val sr2: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var sB:  session.Session                 = sr2.ok;
    val pBr: res[project.Project, fail.Fail] = rebuild(?sB, root);
    if (sel pBr.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pB:               project.Project = pBr.ok;
    val run_sema_pass_r3: err[fail.Fail]  = run_sema_pass(?pB);
    if (sel run_sema_pass_r3.err) {
        project.dnit_project(?pB);
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    if (!sr_struct_equal(?sA, sr_of(?pA2, ?sA, "uniontest.main"), ?sB, sr_of(?pB, ?sB, "uniontest.main"))) { bad = 4; }
    if (!sr_struct_equal(?sA, sr_of(?pA2, ?sA, "uniontest.leaf"), ?sB, sr_of(?pB, ?sB, "uniontest.leaf"))) { bad = 5; }

    project.dnit_project(?pB);
    session.dnit(?sB);
    project.dnit_project(?pA2);
    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

# a field type change re-checks the importer without re-resolving it, and equals a scratch build
test sema__surface_type_change_equals_scratch {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.P;\nfun main() i64 { var p: P; p.x = 1; ret p.x::i64; }\n";
    texts[1] = "pub rec P { x: i32; }\n";

    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val pA1r: res[project.Project, fail.Fail] = rebuild(?sA, root);
    if (sel pA1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA1:             project.Project = pA1r.ok;
    val run_sema_pass_r: err[fail.Fail]  = run_sema_pass(?pA1);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?pA1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val st_main:        session.StableModuleId = project.stable_named(?pA1, "uniontest.main");
    val lc_sema_main_1: query.Revision         = sema_lc(?sA, st_main);
    val lc_res_main_1:  query.Revision         = resolve_lc(?sA, st_main);
    project.dnit_project(?pA1);

    if (!write_source(?alloc, root, "leaf.mach", "pub rec P { x: i64; }\n")) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    val pA2r: res[project.Project, fail.Fail] = rebuild(?sA, root);
    if (sel pA2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA2:              project.Project = pA2r.ok;
    val run_sema_pass_r2: err[fail.Fail]  = run_sema_pass(?pA2);
    if (sel run_sema_pass_r2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    if (resolve_lc(?sA, st_main) != lc_res_main_1) { bad = 1; }
    if (sema_lc(?sA, st_main) == lc_sema_main_1)   { bad = 1; }

    val sr2: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var sB:  session.Session                 = sr2.ok;
    val pBr: res[project.Project, fail.Fail] = rebuild(?sB, root);
    if (sel pBr.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pB:               project.Project = pBr.ok;
    val run_sema_pass_r3: err[fail.Fail]  = run_sema_pass(?pB);
    if (sel run_sema_pass_r3.err) {
        project.dnit_project(?pB);
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    if (!sr_struct_equal(?sA, sr_of(?pA2, ?sA, "uniontest.main"), ?sB, sr_of(?pB, ?sB, "uniontest.main"))) { bad = 1; }
    if (!sr_struct_equal(?sA, sr_of(?pA2, ?sA, "uniontest.leaf"), ?sB, sr_of(?pB, ?sB, "uniontest.leaf"))) { bad = 1; }

    project.dnit_project(?pB);
    session.dnit(?sB);
    project.dnit_project(?pA2);
    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test sema__reshape_renumbers_and_rechecks {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA: session.Session = sr.ok;

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.a.Q;\nuse uniontest.b.fb;\nfun main() i32 { var q: Q; q.x = 1; ret q.x + fb(); }\n";
    texts[1] = "pub rec Q { x: i32; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";

    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val pA1r: res[project.Project, fail.Fail] = rebuild(?sA, root);
    if (sel pA1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA1:             project.Project = pA1r.ok;
    val run_sema_pass_r: err[fail.Fail]  = run_sema_pass(?pA1);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?pA1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val mid_a1:    session.ModuleId       = project.module_named(?pA1, "uniontest.a");
    val st_main:   session.StableModuleId = project.stable_named(?pA1, "uniontest.main");
    val st_a:      session.StableModuleId = project.stable_named(?pA1, "uniontest.a");
    val lc_main_1: query.Revision         = sema_lc(?sA, st_main);
    val lc_a_1:    query.Revision         = sema_lc(?sA, st_a);
    project.dnit_project(?pA1);

    if (!write_source(?alloc, root, "main.mach", "use uniontest.b.fb;\nuse uniontest.a.Q;\nfun main() i32 { var q: Q; q.x = 1; ret q.x + fb(); }\n")) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    val pA2r: res[project.Project, fail.Fail] = rebuild(?sA, root);
    if (sel pA2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pA2:              project.Project = pA2r.ok;
    val run_sema_pass_r2: err[fail.Fail]  = run_sema_pass(?pA2);
    if (sel run_sema_pass_r2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    if (module.same(project.module_named(?pA2, "uniontest.a"), mid_a1)) { bad = 1; }
    if (sema_lc(?sA, st_a) == lc_a_1)                                   { bad = 1; }
    if (sema_lc(?sA, st_main) == lc_main_1)                             { bad = 1; }

    val sr2: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr2.err) {
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var sB:  session.Session                 = sr2.ok;
    val pBr: res[project.Project, fail.Fail] = rebuild(?sB, root);
    if (sel pBr.err) {
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var pB:               project.Project = pBr.ok;
    val run_sema_pass_r3: err[fail.Fail]  = run_sema_pass(?pB);
    if (sel run_sema_pass_r3.err) {
        project.dnit_project(?pB);
        session.dnit(?sB);
        project.dnit_project(?pA2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    if (!sr_struct_equal(?sA, sr_of(?pA2, ?sA, "uniontest.a"), ?sB, sr_of(?pB, ?sB, "uniontest.a")))       { bad = 1; }
    if (!sr_struct_equal(?sA, sr_of(?pA2, ?sA, "uniontest.main"), ?sB, sr_of(?pB, ?sB, "uniontest.main"))) { bad = 1; }

    project.dnit_project(?pB);
    session.dnit(?sB);
    project.dnit_project(?pA2);
    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test lower__importer_edit_reuses_the_provider {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.fa;\nfun main() i32 { ret fa(); }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, fail.Fail] = rebuild(?sA, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p1:              project.Project = p1r.ok;
    val run_sema_pass_r: err[fail.Fail]  = run_sema_pass(?p1);
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val run_lower_pass_r: err[fail.Fail] = run_lower_pass(?p1);
    if (sel run_lower_pass_r.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val st_main:   session.StableModuleId = project.stable_named(?p1, "uniontest.main");
    val st_leaf:   session.StableModuleId = project.stable_named(?p1, "uniontest.leaf");
    val lc_main_1: query.Revision         = lower_lc(?sA, st_main);
    val lc_leaf_1: query.Revision         = lower_lc(?sA, st_leaf);
    project.dnit_project(?p1);

    if (!write_source(?alloc, root, "main.mach", "use uniontest.leaf.fa;\nfun main() i32 { val x: i32 = fa(); ret x; }\n")) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }

    val p2r: res[project.Project, fail.Fail] = rebuild(?sA, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p2:               project.Project = p2r.ok;
    val run_sema_pass_r2: err[fail.Fail]  = run_sema_pass(?p2);
    if (sel run_sema_pass_r2.err) {
        project.dnit_project(?p2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val run_lower_pass_r2: err[fail.Fail] = run_lower_pass(?p2);
    if (sel run_lower_pass_r2.err) {
        project.dnit_project(?p2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val lc_main_2: query.Revision = lower_lc(?sA, st_main);
    val lc_leaf_2: query.Revision = lower_lc(?sA, st_leaf);
    project.dnit_project(?p2);

    if (lc_main_2 == lc_main_1) { bad = 1; }
    if (lc_leaf_2 != lc_leaf_1) { bad = 1; }

    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

