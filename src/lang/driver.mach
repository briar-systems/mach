# each module's product of one kind, keyed as the kind's owner says: a file-keyed kind by the
# module's file, a module-keyed one by its stable id (a normal object's back-half key). a module
# whose front end the build skipped has only its parse and its restored object
fun append_phase_roots(p: *project.Project, roots: *Vector[query.QueryKey],
    kind: *query.Kind, count: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < count) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.frontend_skipped && kind != ?frontend.PARSE && kind != ?passes.CODEGEN) {
            i = i + 1;
            cnt;
        }
        var key: u64 = module.stable_index(m.stable_id)::u64;
        if (kind.owner == query.KEY_FILE) { key = lang_source.file_index(m.file_id)::u64; }
        val added: res[usize, A.Error] = collections_vector.push[query.QueryKey](roots, query.QueryKey{kind: kind, key: key});
        if (sel added.err) {
            ret err[fail.Fail].err{fail.refused(added.err)};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun append_frontend_roots(p: *project.Project, roots: *Vector[query.QueryKey]) err[fail.Fail] {
    val parsed: err[fail.Fail] = append_phase_roots(p, roots, ?frontend.PARSE, p.topo_len);
    if (sel parsed.err) { ret parsed; }
    val resolved: err[fail.Fail] = append_phase_roots(p, roots, ?frontend.RESOLVE, p.topo_len);
    if (sel resolved.err) { ret resolved; }
    val typed: err[fail.Fail] = append_phase_roots(p, roots, ?frontend.SEMA, p.topo_len);
    if (sel typed.err) { ret typed; }
    # the instances every module asks for, typed and reported once the modules are
    val demanded: res[usize, A.Error] = collections_vector.push[query.QueryKey](roots, query.QueryKey{kind: ?passes.INSTANCE_DEMAND, key: 0});
    if (sel demanded.err) { ret err[fail.Fail].err{fail.refused(demanded.err)}; }
    ret err[fail.Fail].ok{};
}

# the front end's roots, and each emitted module's lowering and object and each instance unit's.
# a lowering reports what lowering it found, which its object's product does not hold
fun append_codegen_roots(p: *project.Project, roots: *Vector[query.QueryKey]) err[fail.Fail] {
    val frontend: err[fail.Fail] = append_frontend_roots(p, roots);
    if (sel frontend.err) { ret frontend; }
    val lowered: err[fail.Fail] = append_phase_roots(p, roots, ?passes.LOWER, p.emit_len);
    if (sel lowered.err) { ret lowered; }
    val emitted: err[fail.Fail] = append_phase_roots(p, roots, ?passes.CODEGEN, p.emit_len);
    if (sel emitted.err) { ret emitted; }
    ret append_unit_roots(p, roots);
}

# the codegen roots and each test object's lowering and codegen
pub fun append_test_roots(p: *project.Project, roots: *Vector[query.QueryKey]) err[fail.Fail] {
    val backend: err[fail.Fail] = append_codegen_roots(p, roots);
    if (sel backend.err) { ret backend; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (passes.has_test_object(p, m)) {
            val lowered: res[usize, A.Error] = collections_vector.push[query.QueryKey](roots, query.QueryKey{kind: ?passes.LOWER, key: passes.test_key_for(m)});
            if (sel lowered.err) { ret err[fail.Fail].err{fail.refused(lowered.err)}; }
            val emitted: res[usize, A.Error] = collections_vector.push[query.QueryKey](roots, query.QueryKey{kind: ?passes.CODEGEN, key: passes.test_key_for(m)});
            if (sel emitted.err) { ret err[fail.Fail].err{fail.refused(emitted.err)}; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the codegen roots and the link
fun append_link_roots(p: *project.Project, roots: *Vector[query.QueryKey]) err[fail.Fail] {
    val backend: err[fail.Fail] = append_codegen_roots(p, roots);
    if (sel backend.err) { ret backend; }
    val linked: res[usize, A.Error] = collections_vector.push[query.QueryKey](roots, query.QueryKey{kind: ?passes.LINK, key: 0});
    if (sel linked.err) { ret err[fail.Fail].err{fail.refused(linked.err)}; }
    ret err[fail.Fail].ok{};
}

fun append_unit_roots(p: *project.Project, roots: *Vector[query.QueryKey]) err[fail.Fail] {
    var i: usize = 0;
    for (i < p.units.len) {
        val lowered: res[usize, A.Error] = collections_vector.push[query.QueryKey](roots, query.QueryKey{kind: ?passes.UNIT_LOWER, key: p.units.data[i].key});
        if (sel lowered.err) { ret err[fail.Fail].err{fail.refused(lowered.err)}; }
        val added: res[usize, A.Error] = collections_vector.push[query.QueryKey](roots, query.QueryKey{kind: ?passes.UNIT_CODEGEN, key: p.units.data[i].key});
        if (sel added.err) { ret err[fail.Fail].err{fail.refused(added.err)}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# one query operation running `run`, whose diagnostics are those of the products `rooted` names
# once it ran: only running a pass says which units the build has and which modules' front ends
# it ran
fun run_query_pass(p: *project.Project, rooted: fun(*project.Project, *Vector[query.QueryKey]) err[fail.Fail],
    run: fun(*project.Project) err[fail.Fail]) err[fail.Fail] {
    val begun: res[query.Operation, fail.Fail] = frontend.begin_query_phase(p);
    if (sel begun.err) {
        ret err[fail.Fail].err{begun.err};
    }
    var result: err[fail.Fail]         = run(p);
    var roots:  Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    val named: err[fail.Fail] = rooted(p, ?roots);
    val ran:   bool           = sel result.ok;
    if (ran) { result = named; }
    ret frontend.finish_query_phase(p, begun.ok, roots.data, roots.len, result);
}

# a phase the query engine does not run is published as one it does: the
# project's diagnostics are refreshed beside its result
pub fun phase_finish(p: *project.Project,
    result: err[fail.Fail]) err[fail.Fail] {
    val refreshed: err[fail.Fail] = frontend.refresh_diagnostics(p);
    if (sel refreshed.err) {
        diagnostic.note_lost(?p.diags);
        diagnostic.note_lost(?p.s.diags);
        if (sel result.ok) { ret refreshed; }
    }
    ret result;
}

# a loaded project under another request from its host: the build context is frozen again, so
# what read the old one is computed again, and nothing reads a context no freeze captured
pub fun reconfigure(p: *project.Project, req: request.BuildRequest) err[fail.Fail] {
    p.req = req;
    ret context.freeze(p);
}

# a project that failed is released, its failure kept where the session presents it
fun project_failure(p: *project.Project, failure: fail.Fail) res[project.Project, fail.Fail] {
    var lost:   bool      = false;
    val stable: fail.Fail = query.hold_failure(?p.s.queries, failure, ?lost);
    if (lost) { diagnostic.note_lost(?p.diags); }
    val published: err[fail.Fail] = phase_finish(p, err[fail.Fail].err{stable});
    project.dnit_project(p);
    if (sel published.err) { ret res[project.Project, fail.Fail].err{published.err}; }
    ret res[project.Project, fail.Fail].err{stable};
}

pub fun run_sema_pass(p: *project.Project) err[fail.Fail] {
    project.set_origin(p, diagnostic.ORIGIN_SEMA);
    ret run_query_pass(p, append_frontend_roots, passes.run_sema_pass);
}

# the codegen stage: each emitted module and instance unit lowered and compiled, or its object
# restored from `obj/`
pub fun run_codegen_pass(p: *project.Project) err[fail.Fail] {
    project.set_origin(p, diagnostic.ORIGIN_CODEGEN);
    val prepared: err[fail.Fail] = passes.prepare_codegen_pass(p);
    if (sel prepared.err) { ret prepared; }
    ret run_query_pass(p, append_codegen_roots, passes.run_codegen_pass);
}

# the test stage: each test object, lowered against its module's normal object
pub fun run_test_pass(p: *project.Project) err[fail.Fail] {
    project.set_origin(p, diagnostic.ORIGIN_CODEGEN);
    ret run_query_pass(p, append_test_roots, passes.run_test_pass);
}

# the link stage: the artifact `job` names, written by its action only when an input of the
# link moved since it last ran or the artifact on disk is not the one it wrote
pub fun run_link_pass(p: *project.Project, job: *project.LinkJob) err[fail.Fail] {
    project.set_origin(p, diagnostic.ORIGIN_LINK);
    val prepared: err[fail.Fail] = passes.prepare_link(p, job.artifact);
    if (sel prepared.err) { ret prepared; }
    p.link = job;
    fin { p.link = nil; }
    ret run_query_pass(p, append_link_roots, passes.run_link_pass);
}

# locate a root manifest's dependency closure with no build cell configured, as a
# build locates it: every dependency under dep/, its manifest and its direct
# edges, and nothing is checked against git or the pins
# ---
# s:            the session; its build allocator owns the closure
# m:            the root manifest
# project_root: the root project's directory
# unrealized:   what a dependency nothing is realized for is
# ret:          the closure, released with `project.closure_dnit`
pub fun closure_locate(s: *session.Session, m: *manifest_model.Manifest, project_root: str,
    unrealized: driver_closure.Unrealized) res[project.Closure, fail.Fail] {
    ret closure_of(s, m, project_root, nil, unrealized);
}

# locate a root manifest's dependency closure as `closure_locate` does, holding every edge
# to `check` as it is located, as `mach dep verify` does
# ---
# check: what each located edge is held to
# ret:   the closure; err naming the first edge that does not locate or does not hold
pub fun closure_checked(s: *session.Session, m: *manifest_model.Manifest, project_root: str,
    check: *driver_closure.Check) res[project.Closure, fail.Fail] {
    ret closure_of(s, m, project_root, check, driver_closure.UNREALIZED_REFUSED);
}

fun closure_of(s: *session.Session, m: *manifest_model.Manifest, project_root: str,
    check: *driver_closure.Check, unrealized: driver_closure.Unrealized) res[project.Closure, fail.Fail] {
    ret driver_closure.locate(s, s.build_alloc, m, project_root, check, unrealized);
}

# begin the build the request names: every goal, a test goal included, loads the
# selected artifact's closure
# ---
# m:       the root manifest the cell was planned from
# closure: `m`'s closure as the plan located it, which the project borrows
pub fun begin_build(s: *session.Session, m: *manifest_model.Manifest, closure: *project.Closure, req: *request.BuildRequest,
    progress: *readout.Progress) res[project.Project, fail.Fail] {
    ret begin_build_roots(s, m, closure, req, progress, project.ROOT_ARTIFACT);
}

fun begin_build_roots(s: *session.Session, m: *manifest_model.Manifest, closure: *project.Closure, req: *request.BuildRequest,
    progress: *readout.Progress, roots: project.RootSet) res[project.Project, fail.Fail] {
    val cell: res[manifest_select.Cell, fail.Fail] = request_cell(s, m, req);
    if (sel cell.err) { ret res[project.Project, fail.Fail].err{cell.err}; }
    var c: manifest_select.Cell = cell.ok;
    ret begin_build_impl(s, ?c, m, closure, req, progress, roots);
}

# the cell a request names: a dependency's cell exactly as its plan named it, and
# a root cell resolved from the request's names, so a request naming no artifact
# takes the one the default selection holds
fun request_cell(s: *session.Session, m: *manifest_model.Manifest, req: *request.BuildRequest) res[manifest_select.Cell, fail.Fail] {
    if (!str_empty(req.owner)) { ret res[manifest_select.Cell, fail.Fail].ok{manifest_select.cell_of(req.artifact, req.target, req.profile)}; }
    val made: res[manifest_select.Selectors, fail.Fail] = manifest_select.selectors_of(s.alloc, req.artifact, req.target, req.profile);
    if (sel made.err) { ret res[manifest_select.Cell, fail.Fail].err{made.err}; }
    var selectors: manifest_select.Selectors = made.ok;
    fin { manifest_select.selectors_dnit(?selectors); }
    ret manifest_select.resolve_cell(s.alloc, ?s.interner, m, ?selectors, manifest_select.ARTIFACT_DEFAULT_ONE, "this command builds one artifact");
}

pub def FrontendPhase: u8;
pub val FRONTEND_PARSE:   FrontendPhase = 0;
pub val FRONTEND_RESOLVE: FrontendPhase = 1;
pub val FRONTEND_SEMA:    FrontendPhase = 2;

# one frontend analysis for a tool: the project at a root, its request composed from the
# manifest and the selection as `mach check` composes it, with the modules of `files`
# loaded beside the root set
# ---
# root:       the project's directory, the one holding its mach.toml
# manifest:   the project's manifest when the caller already read it, nil to read it from
#             `root`
# selection:  the artifact, target and profile selection, one cell of which is analyzed
# roots:      the root set the frontend loads: `project.ROOT_ARTIFACT` is the selected
#             artifact's closure, `project.ROOT_UNION` every artifact's with the modules
#             only a foreign target reaches gated out and `{artifact.<id>.out}` resolving
#             over every artifact some artifact needs
# files:      source files whose modules load beside the root set, nil with count 0; a
#             file of another project, or outside the root's source directory, is skipped
# file_count: how many files
# phase:      the last frontend phase to run
pub rec Analysis {
    root:       str;
    manifest:   *manifest_model.Manifest;
    selection:  *manifest_select.Selectors;
    roots:      project.RootSet;
    files:      *str;
    file_count: u32;
    phase:      FrontendPhase;
}

# the frontend analysis tools share: the project comes back whenever the frontend ran,
# whatever its phases decided, so a consumer can read the trees, resolve results and sema
# results beside the diagnostics. every module that reached a phase carries that phase's
# product on its ModuleEntry even when the module's own query was rejected; the standing is
# frontend.frontend_status(p). a rejected phase ends the analysis at that phase; err is an
# operational failure only (an unreadable manifest, a selection naming no cell, allocation,
# I/O). every string `an` holds is borrowed for the call, and the project borrows `root`
# ---
# s:   the session
# an:  what to analyze
# ret: the project, released by the caller with project.dnit_project
pub fun analyze(s: *session.Session, an: *Analysis) res[project.Project, fail.Fail] {
    if (an.phase > FRONTEND_SEMA) { ret res[project.Project, fail.Fail].err{fail.message("unknown frontend analysis phase")}; }
    if (an.roots != project.ROOT_ARTIFACT && an.roots != project.ROOT_UNION) {
        ret res[project.Project, fail.Fail].err{lang_catalog.unknown_catalog(s.alloc, "RootSet", an.roots::u32)};
    }
    if (an.file_count > 0 && an.files == nil) {
        ret res[project.Project, fail.Fail].err{fail.message("driver: frontend analysis file count requires a file array")};
    }
    var read:           manifest_model.Manifest;
    var m:              *manifest_model.Manifest = an.manifest;
    val manifest_alloc: *A.Allocator             = s.build_alloc;
    if (m == nil) {
        val loaded: res[manifest_model.Manifest, fail.Fail] = load_manifest(s, an.root);
        if (sel loaded.err) { ret res[project.Project, fail.Fail].err{loaded.err}; }
        read = loaded.ok;
        m    = ?read;
    }
    fin {
        if (an.manifest == nil) { manifest_model.dnit(?read, manifest_alloc); }
    }

    val cell: res[manifest_select.Cell, fail.Fail] = manifest_select.resolve_cell(s.alloc, ?s.interner, m, an.selection,
        manifest_select.ARTIFACT_DEFAULT_ONE, "this command builds one artifact");
    if (sel cell.err) { ret res[project.Project, fail.Fail].err{cell.err}; }
    var overrides: request.Overrides                    = request.overrides_init(s.alloc);
    val composed:  res[request.BuildRequest, fail.Fail] = request.compose(s.alloc, ?s.interner, m, ?overrides, an.root,
        request.GOAL_CHECK, cell.ok.profile);
    if (sel composed.err) { ret res[project.Project, fail.Fail].err{composed.err}; }
    var req: request.BuildRequest = composed.ok;
    fin {
        collections_vector.dnit[request.LinkToken](?req.link_tokens);
        collections_vector.dnit[str](?req.lib_dirs);
    }
    req.artifact = cell.ok.artifact;
    req.target   = cell.ok.target;

    val named: res[Vector[intern.StrId], fail.Fail] = file_modules(s, m, an.root, an.files, an.file_count);
    if (sel named.err) { ret res[project.Project, fail.Fail].err{named.err}; }
    var extra: Vector[intern.StrId] = named.ok;
    fin { collections_vector.dnit[intern.StrId](?extra); }

    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(s.alloc);

    val begin_r: res[project.Project, fail.Fail] = begin_build_roots(s, m, nil, ?req, nil, an.roots);
    if (sel begin_r.err) { ret begin_r; }
    var p: project.Project = begin_r.ok;

    if (an.phase == FRONTEND_PARSE) {
        val parsed: err[fail.Fail] = parse_project_roots(?p, extra.data, extra.len::u32);
        if (sel parsed.err) { ret phase_decided(?p, parsed.err); }
        ret res[project.Project, fail.Fail].ok{p};
    }

    val load_r: err[fail.Fail] = run_load_phase_roots(?p, extra.data, extra.len::u32);
    if (sel load_r.err) { ret phase_decided(?p, load_r.err); }

    if (an.phase == FRONTEND_RESOLVE) {
        val current: err[fail.Fail] = resolve_query_phase(?p);
        if (sel current.err) { ret phase_decided(?p, current.err); }
        ret res[project.Project, fail.Fail].ok{p};
    }

    val sema_r: err[fail.Fail] = run_sema_pass(?p);
    if (sel sema_r.err) { ret phase_decided(?p, sema_r.err); }

    ret res[project.Project, fail.Fail].ok{p};
}

# the modules `files` are loaded as beside the project at `root` whose manifest is `m`, in
# order, skipping a file of another project or outside the source directory
fun file_modules(s: *session.Session, m: *manifest_model.Manifest, root: str, files: *str,
    count: u32) res[Vector[intern.StrId], fail.Fail] {
    var out: Vector[intern.StrId] = collections_vector.init[intern.StrId](s.alloc);
    if (count == 0) { ret res[Vector[intern.StrId], fail.Fail].ok{out}; }
    var complete: bool = false;
    fin {
        if (!complete) { collections_vector.dnit[intern.StrId](?out); }
    }
    val id_text:  opt[str] = intern.get(?s.interner, m.id);
    val src_text: opt[str] = intern.get(?s.interner, m.src);
    if (sel id_text.none)  { ret res[Vector[intern.StrId], fail.Fail].err{fail.message("driver: manifest project id or src dir not interned")}; }
    if (sel src_text.none) { ret res[Vector[intern.StrId], fail.Fail].err{fail.message("driver: manifest project id or src dir not interned")}; }
    var i: u32 = 0;
    for (i < count) {
        val name: res[opt[intern.StrId], fail.Fail] = file_module(s.alloc, ?s.interner, files[i], root, id_text.some, src_text.some);
        if (sel name.err) { ret res[Vector[intern.StrId], fail.Fail].err{name.err}; }
        if (sel name.ok.some) {
            val pushed: res[usize, A.Error] = collections_vector.push[intern.StrId](?out, name.ok.some);
            if (sel pushed.err) { ret res[Vector[intern.StrId], fail.Fail].err{fail.refused(pushed.err)}; }
        }
        i = i + 1;
    }
    complete = true;
    ret res[Vector[intern.StrId], fail.Fail].ok{out};
}

# a phase that did not finish: a rejection keeps the project, everything else
# releases it
fun phase_decided(p: *project.Project, failure: fail.Fail) res[project.Project, fail.Fail] {
    if (fail.is_reported(failure)) {
        ret res[project.Project, fail.Fail].ok{@p};
    }
    ret project_failure(p, failure);
}

fun parse_project_roots(p: *project.Project, roots: *intern.StrId, count: u32) err[fail.Fail] {
    val selected: err[fail.Fail] = config.select_target(p, p.target_entry);
    if (sel selected.err) { ret phase_finish(p, err[fail.Fail].err{selected.err}); }
    var entry:          intern.StrId  = intern.STR_NIL;
    var selected_roots: *intern.StrId = roots;
    var selected_count: u32           = count;
    if (selected_count == 0) {
        val name: res[intern.StrId, fail.Fail] = driver_load.entry_module_fqn(p, p.target_entry);
        if (sel name.err) { ret phase_finish(p, err[fail.Fail].err{name.err}); }
        entry          = name.ok;
        selected_roots = ?entry;
        selected_count = 1;
    }
    var i: u32 = 0;
    for (i < selected_count) {
        val loaded: res[module.ModuleId, fail.Fail] = driver_load.module_open(p, selected_roots[i]);
        if (sel loaded.err) {
            var failure: fail.Fail = load_failure_of(p, loaded.err);
            if (count == 0) { failure = entry_failure(p, entry, p.config.bin_name, p.target_entry.entry_at, failure); }
            ret retain_loaded(p, driver_load.collect_loaded_parses(p, err[fail.Fail].err{failure}));
        }
        i = i + 1;
    }
    ret retain_loaded(p, driver_load.collect_loaded_parses(p, err[fail.Fail].ok{}));
}

fun begin_build_impl(s: *session.Session, c: *manifest_select.Cell, m: *manifest_model.Manifest, closure: *project.Closure,
    req: *request.BuildRequest, progress: *readout.Progress, roots: project.RootSet) res[project.Project, fail.Fail] {
    val valid: err[fail.Fail] = request.validate(s.alloc, req);
    if (sel valid.err) {
        ret res[project.Project, fail.Fail].err{valid.err};
    }
    var p: project.Project;
    project.init_project(?p, s);
    p.req      = @req;
    p.progress = progress;
    p.roots    = roots;

    val for_union: bool = roots == project.ROOT_UNION;

    val cfg_r: err[fail.Fail] = config.load_config_manifest(?p, req.project_root, m, closure, c, req.owner, for_union);
    if (sel cfg_r.err) {
        ret project_failure(?p, cfg_r.err);
    }

    val te: *project.TargetEntry = p.target_entry;
    if (te == nil) {
        ret project_failure(?p, fail.message("internal: manifest selected no target"));
    }

    val published: err[fail.Fail] = phase_finish(?p, err[fail.Fail].ok{});
    if (sel published.err) {
        ret project_failure(?p, published.err);
    }

    ret res[project.Project, fail.Fail].ok{p};
}

pub fun run_load_phase(p: *project.Project) err[fail.Fail] {
    ret run_load_phase_roots(p, nil, 0);
}

fun run_load_phase_roots(p: *project.Project, extra_roots: *intern.StrId,
    extra_root_count: u32) err[fail.Fail] {
    ret phase_finish(p, retain_loaded(p, load_phase_impl(p, extra_roots, extra_root_count)));
}

# whatever the load decided, the session keeps what it reached and retires what nothing holds any more
# a load the walk finished but rejected (a `use` that names nothing) is a rejected
# round like a failed one: the last accepted build's holdings stay
fun retain_loaded(p: *project.Project, result: err[fail.Fail]) err[fail.Fail] {
    val standing: lang_phase.PhaseStatus = frontend.load_status(p);
    val rejected: bool                   = sel result.err || !sel standing.kind.accepted;
    val kept:     err[fail.Fail]         = passes.retain_modules(p, rejected);
    # a rejected load reports its own failure first; a retention failure beside it only keeps products
    # longer than needed, never serves a wrong one, so it is counted as a lost report rather than replacing it
    if (sel result.err) {
        if (sel kept.err) {
            diagnostic.note_lost(?p.diags);
            diagnostic.note_lost(?p.s.diags);
        }
        ret result;
    }
    if (sel kept.err) { ret err[fail.Fail].err{kept.err}; }
    ret result;
}

fun load_phase_impl(p: *project.Project, extra_roots: *intern.StrId,
    extra_root_count: u32) err[fail.Fail] {
    val te: *project.TargetEntry = p.target_entry;

    val fp_r: err[fail.Fail] = config.select_target(p, te);
    if (sel fp_r.err) {
        ret err[fail.Fail].err{fp_r.err};
    }

    val entry_path_r: res[intern.StrId, fail.Fail] = driver_load.entry_module_fqn(p, te);
    if (sel entry_path_r.err) {
        ret err[fail.Fail].err{entry_path_r.err};
    }
    val entry_fqn: intern.StrId = entry_path_r.ok;

    readout.phase_begin(p.progress, readout.LOAD);
    project.set_origin(p, diagnostic.ORIGIN_LOAD);
    val load_r: res[module.ModuleId, fail.Fail] = driver_load.module_load(p, entry_fqn);
    if (sel load_r.err) {
        val failure: fail.Fail = entry_failure(p, entry_fqn, p.config.bin_name, te.entry_at, load_failure_of(p, load_r.err));
        ret driver_load.collect_loaded_parses(p, err[fail.Fail].err{failure});
    }

    if (p.roots == project.ROOT_UNION) {
        # under the union each artifact's walk attributes the modules it reaches first, so
        # a module of `shaded` reads `$bin.name == "shaded"` in a session rooted at `hello`;
        # the primary entry loaded first, so a module its walk reaches is the primary's
        val cell_artifact: intern.StrId = p.loader.artifact;
        var ei:            u32          = 0;
        for (ei < p.union_entry_count) {
            p.loader.artifact = p.union_entries[ei].artifact;
            val ue:  *project.ArtifactEntry          = ?p.union_entries[ei];
            val ear: res[module.ModuleId, fail.Fail] = driver_load.module_load(p, ue.fqn);
            if (sel ear.err) {
                p.loader.artifact = cell_artifact;
                val failure: fail.Fail = entry_failure(p, ue.fqn, ue.artifact, ue.at, load_failure_of(p, ear.err));
                ret driver_load.collect_loaded_parses(p, err[fail.Fail].err{failure});
            }
            ei = ei + 1;
        }
        # the artifacts this target does not build come next, so a module both reach is
        # this build's and one only they reach is gated out of it
        p.loader.foreign = true;
        var fi_: u32 = 0;
        for (fi_ < p.foreign_entry_count) {
            p.loader.artifact = p.foreign_entries[fi_].artifact;
            val fo:  *project.ArtifactEntry          = ?p.foreign_entries[fi_];
            val far: res[module.ModuleId, fail.Fail] = driver_load.module_load(p, fo.fqn);
            if (sel far.err) {
                p.loader.foreign  = false;
                p.loader.artifact = cell_artifact;
                val failure: fail.Fail = entry_failure(p, fo.fqn, fo.artifact, fo.at, load_failure_of(p, far.err));
                ret driver_load.collect_loaded_parses(p, err[fail.Fail].err{failure});
            }
            fi_ = fi_ + 1;
        }
        p.loader.foreign  = false;
        p.loader.artifact = cell_artifact;
    }

    p.emit_len = p.topo_len;

    var xi: u32 = 0;
    for (xi < extra_root_count) {
        val xr: res[module.ModuleId, fail.Fail] = driver_load.module_load(p, extra_roots[xi]);
        if (sel xr.err) {
            ret driver_load.collect_loaded_parses(p, err[fail.Fail].err{load_failure_of(p, xr.err)});
        }
        xi = xi + 1;
    }

    if (passes.test_build(p)) { p.emit_len = p.topo_len; }

    if (p.loader.dirty) {
        val ordered: err[fail.Fail] = reorder_topo(p);
        if (sel ordered.err) { ret ordered; }
    }

    val reg_r: err[fail.Fail] = driver_load.register_module_asts(p);
    if (sel reg_r.err) {
        ret err[fail.Fail].err{reg_r.err};
    }

    val cfg_in_r: err[fail.Fail] = context.freeze(p);
    if (sel cfg_in_r.err) {
        ret err[fail.Fail].err{cfg_in_r.err};
    }

    close_load_row(p);

    val strings_r: err[fail.Fail] = declared.decorator_strings_register(p);
    if (sel strings_r.err) {
        ret err[fail.Fail].err{strings_r.err};
    }
    val emb_r: err[fail.Fail] = declared.register_embed_inputs(p);
    if (sel emb_r.err) {
        ret err[fail.Fail].err{emb_r.err};
    }

    {
        readout.phase_begin(p.progress, readout.RESOLVE);
        fin { close_resolve_row(p); }
        val cached: err[fail.Fail] = passes.prepare_object_cache(p);
        if (sel cached.err) { ret err[fail.Fail].err{cached.err}; }
        val final_resolve: err[fail.Fail] = resolve_query_phase(p);
        if (sel final_resolve.err) { ret err[fail.Fail].err{final_resolve.err}; }
    }

    val exp_r: err[fail.Fail] = declared.register_export_names(p);
    if (sel exp_r.err) {
        ret err[fail.Fail].err{exp_r.err};
    }

    ret err[fail.Fail].ok{};
}

# re-derive a loaded project's frontend after one module's text changed, without
# reloading its closure. the module is reparsed and re-walked in place; when its load
# surface survived (driver_load.module_reload), the module set and topo are as loaded and
# the query phases rerun over them, so every unchanged module's resolve and sema are
# hits and only the edited module and its dependents recompute. a surface that did
# not survive is reported as ok(false): the caller reloads
# ---
# p:     the loaded project, at least at FRONTEND_RESOLVE
# mid:   the module whose text changed
# phase: the frontend phase to re-derive to, at most the one the project was loaded to
# ret:   ok(true) when refreshed, a rejection included since the project's standing carries it;
#        ok(false) when the caller must reload; or the internal failure
pub fun refresh_frontend(p: *project.Project, mid: module.ModuleId, phase: FrontendPhase) res[bool, fail.Fail] {
    if (phase > FRONTEND_SEMA) { ret res[bool, fail.Fail].err{fail.message("unknown frontend analysis phase")}; }
    if (module.is_nil(mid) || mid::u32 >= project.module_count(p)) {
        ret res[bool, fail.Fail].err{fail.message("driver: refresh names a module outside the loaded project")};
    }
    val s: *session.Session     = p.s;
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(s.alloc);
    diagnostic.drop_file(?p.diags, m.file_id);
    val syn: *ast.Ast = frontend.syntax(p, m);
    if (syn != nil) { linkage.forget_names(?p.linkage, mid, syn.decls.len::u32); }

    project.set_origin(p, diagnostic.ORIGIN_LOAD);
    val kept: res[bool, fail.Fail] = driver_load.module_reload(p, mid);
    if (sel kept.err) { ret res[bool, fail.Fail].err{kept.err}; }
    if (!kept.ok)     { ret res[bool, fail.Fail].ok{false}; }

    val derived: err[fail.Fail] = refresh_phases(p, phase);
    val kept_r:  err[fail.Fail] = retain_loaded(p, derived);
    val fin_r:   err[fail.Fail] = phase_finish(p, kept_r);
    # a rejection is a refreshed project whose diagnostics say so, as under the tolerant load
    if (sel fin_r.err) {
        if (!fail.is_reported(fin_r.err)) { ret res[bool, fail.Fail].err{fin_r.err}; }
    }
    ret res[bool, fail.Fail].ok{true};
}

# the phases after the load walk, over a project whose module set is settled
fun refresh_phases(p: *project.Project, phase: FrontendPhase) err[fail.Fail] {
    val forgot: err[fail.Fail] = cache.forget(p);
    if (sel forgot.err) { ret forgot; }
    val reg_r: err[fail.Fail] = driver_load.register_module_asts(p);
    if (sel reg_r.err) { ret err[fail.Fail].err{reg_r.err}; }
    val strings_r: err[fail.Fail] = declared.decorator_strings_register(p);
    if (sel strings_r.err) { ret err[fail.Fail].err{strings_r.err}; }
    val emb_r: err[fail.Fail] = declared.register_embed_inputs(p);
    if (sel emb_r.err) { ret err[fail.Fail].err{emb_r.err}; }
    val resolved: err[fail.Fail] = resolve_query_phase(p);
    if (sel resolved.err) { ret err[fail.Fail].err{resolved.err}; }
    val exp_r: err[fail.Fail] = declared.register_export_names(p);
    if (sel exp_r.err)          { ret err[fail.Fail].err{exp_r.err}; }
    if (phase == FRONTEND_SEMA) { ret run_sema_pass(p); }
    ret err[fail.Fail].ok{};
}

fun resolve_query_phase(p: *project.Project) err[fail.Fail] {
    project.set_origin(p, diagnostic.ORIGIN_RESOLVE);
    # what the load walk decided for each module is an input the resolution reads
    val viewed: err[fail.Fail] = frontend.record_load_views(p);
    if (sel viewed.err) { ret viewed; }
    var roots: Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        if (lang_source.file_is_nil(m.file_id)) {
            i = i + 1;
            cnt;
        }
        val added: res[usize, A.Error] = collections_vector.push[query.QueryKey](?roots,
            query.QueryKey{kind: ?frontend.PARSE, key: lang_source.file_index(m.file_id)::u64});
        if (sel added.err) {
            ret err[fail.Fail].err{fail.refused(added.err)};
        }
        i = i + 1;
    }
    val resolved: err[fail.Fail] = append_phase_roots(p, ?roots, ?frontend.RESOLVE, p.topo_len);
    if (sel resolved.err) { ret resolved; }
    val exported: err[fail.Fail] = append_phase_roots(p, ?roots, ?frontend.EXPORTS, p.topo_len);
    if (sel exported.err) { ret exported; }
    val begun: res[query.Operation, fail.Fail] = frontend.begin_query_phase(p);
    if (sel begun.err) {
        ret err[fail.Fail].err{begun.err};
    }
    var computed:    err[fail.Fail] = driver_load.acquire_loaded_parses(p);
    val computed_ok: bool           = sel computed.ok;
    if (computed_ok) { computed = passes.run_resolve_pass(p); }
    var result: err[fail.Fail] = err[fail.Fail].ok{};
    if (sel computed.err) {
        result = err[fail.Fail].err{computed.err};
    }
    ret frontend.finish_query_phase(p, begun.ok, roots.data, roots.len, result);
}

# a module walked again under a union tuple it was reached under late can import one the topo
# placed after it, so the topo is ordered again, the modules the build emits first
fun reorder_topo(p: *project.Project) err[fail.Fail] {
    var emit_roots:      *module.ModuleId = nil;
    val emit_root_count: u32              = p.emit_len;
    if (emit_root_count > 0) {
        val er: res[*module.ModuleId, A.Error] = A.allocate[module.ModuleId](p.alloc, emit_root_count::usize);
        if (sel er.err) { ret err[fail.Fail].err{fail.refused(er.err)}; }
        emit_roots = er.ok;
        var ei: u32 = 0;
        for (ei < emit_root_count) {
            emit_roots[ei] = p.topo[ei];
            ei             = ei + 1;
        }
    }
    val tr: err[fail.Fail] = driver_load.rebuild_topo(p, emit_roots, emit_root_count);
    if (emit_roots != nil) { A.deallocate[module.ModuleId](p.alloc, emit_roots, emit_root_count::usize); }
    ret tr;
}

fun close_load_row(p: *project.Project) {
    readout.phase_dropped(p.progress, readout.LOAD, project.module_count(p) - p.topo_len);
    readout.phase_end(p.progress, readout.LOAD, project.module_count(p), "module", "modules");
}

fun close_resolve_row(p: *project.Project) {
    readout.phase_end(p.progress, readout.RESOLVE, cache.frontend_count(p), "module", "modules");
}

# the root manifest of the project at `project_root`, read once: its text, an
# open buffer's when the session holds one, becomes the session's input for the
# file, so a warm session sees an edit to it as an input change, and the manifest
# records the input and the revision it was read at
# ---
# s:            the session; its build allocator owns the manifest
# project_root: the project root
# ret:          the manifest, released with `manifest_model.dnit`; err when it cannot be
#               read, does not parse or fails a check
pub fun load_manifest(s: *session.Session, project_root: str) res[manifest_model.Manifest, fail.Fail] {
    val path_r: res[str, A.Error] = types_path.join(s.build_alloc, project_root, manifest_load.MANIFEST_FILE);
    if (sel path_r.err) { ret res[manifest_model.Manifest, fail.Fail].err{fail.refused(path_r.err)}; }
    val path: str = path_r.ok;
    fin { str_free(s.build_alloc, path); }

    # the text read off disk is this call's; the session and the parse each keep their own copy
    var text:     str      = nil;
    var read_off: bool     = false;
    val buffered: opt[str] = overlay.get(?s.overlays, path);
    if (sel buffered.some) { text = buffered.some; }
    or {
        val read: res[str, fs.FsError] = fs.read_string(s.build_alloc, path);
        if (sel read.err) { ret res[manifest_model.Manifest, fail.Fail].err{fail.refusal(s.build_alloc, diagnostic_kind.FS_READ, fail.Op{verb: "read", path: path, given: true}, fail.Cause.fs{read.err})}; }
        text     = read.ok;
        read_off = true;
    }
    fin {
        if (read_off) { str_free(s.build_alloc, text); }
    }
    val loaded: res[lang_source.FileId, fail.Fail] = session.load_source(s, path, text);
    if (sel loaded.err) { ret res[manifest_model.Manifest, fail.Fail].err{loaded.err}; }

    val parsed: res[manifest_model.Manifest, fail.Fail] = manifest_load.parse_text(s.build_alloc, ?s.interner, s.sources, path, text);
    if (sel parsed.err) { ret parsed; }
    var m: manifest_model.Manifest = parsed.ok;
    m.source          = loaded.ok;
    m.source_revision = query.peek_revision(?s.queries, ?session.FILE_TEXT, lang_source.file_index(loaded.ok)::u64);

    ret res[manifest_model.Manifest, fail.Fail].ok{m};
}

# a load that failed: the frontend's recorded status wins over the loader's
# own failure, and a loader message is the user's
fun load_failure_of(p: *project.Project, f: fail.Fail) fail.Fail {
    val status: lang_phase.PhaseStatus = frontend.frontend_status(p);
    if (!sel status.kind.accepted) { ret lang_phase.phase_failure(status); }
    ret fail.as_user(diagnostic_kind.SOURCE_LOAD, f);
}

# a load failure of the module an artifact's `entry` names: when the entry's own file could
# not be read, the failure names the key and points at where the manifest writes it. an entry
# build states its entry on the command line, has no manifest to point into, and keeps the
# failure as it is
fun entry_failure(p: *project.Project, fqn: intern.StrId, artifact: intern.StrId, at: lang_source.Location, f: fail.Fail) fail.Fail {
    if (fail.kind_of(f) != diagnostic_kind.SOURCE_LOAD) { ret f; }
    if (lang_source.file_is_nil(at.file))               { ret f; }
    if (!driver_load.module_unread(p, fqn))             { ret f; }
    val text: res[str, fail.Fail] = diagnostic.format_intern(?p.s.interner, p.alloc, "mach.toml: [artifact.{}].entry: {}", intern.text(?p.s.interner, artifact), fail.describe(f));
    if (sel text.err) { ret text.err; }
    ret fail.at(fail.with_text(f, text.ok), at);
}

# the root of the project a file belongs to: the nearest directory above it holding a
# mach.toml, none when no directory does
pub fun project_root_of(alloc: *A.Allocator, file_path: str) res[opt[str], fail.Fail] {
    val start_r: res[str, A.Error] = types_path.parent(alloc, file_path);
    if (sel start_r.err) { ret res[opt[str], fail.Fail].err{fail.refused(start_r.err)}; }
    var dir: str = start_r.ok;
    fin { str_free(alloc, dir); }
    for (true) {
        val mf_r: res[str, fail.Fail] = driver_load.join_path(alloc, dir, manifest_load.MANIFEST_FILE);
        if (sel mf_r.err) { ret res[opt[str], fail.Fail].err{mf_r.err}; }
        val mf: str = mf_r.ok;
        fin { str_free(alloc, mf); }
        val opened: res[fs.File, io_error.Error] = fs.open(mf);
        if (sel opened.ok) {
            var file:     fs.File                          = opened.ok;
            val metadata: res[fs.Metadata, io_error.Error] = fs.stat_of(file);
            val closed:   err[io_error.Error]              = fs.close(?file);
            # a manifest opened read-only loses nothing to a refused close, so the failure going out stands alone
            if (sel metadata.err) { ret res[opt[str], fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_STAT, fail.Op{verb: "inspect", role: "the project manifest", path: mf}, fail.Cause.io{metadata.err})}; }
            if (sel closed.err)   { ret res[opt[str], fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_CLOSE, fail.Op{verb: "close", role: "the project manifest", path: mf}, fail.Cause.io{closed.err})}; }
            if (metadata.ok.kind != fs.KIND_FILE) {
                ret res[opt[str], fail.Fail].err{fail.formatted_user(alloc, diagnostic_kind.FS_READ, "project manifest '{}' is not a regular file", mf)};
            }
            val found: str = dir;
            dir = nil;
            ret res[opt[str], fail.Fail].ok{opt[str].some{found}};
        }
        if (system_os.error_kind(opened.err.code) != io_error.NOT_FOUND) {
            ret res[opt[str], fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_OPEN, fail.Op{verb: "open", role: "the project manifest", path: mf}, fail.Cause.io{opened.err})};
        }
        val parent_r: res[str, A.Error] = types_path.parent(alloc, dir);
        if (sel parent_r.err) { ret res[opt[str], fail.Fail].err{fail.refused(parent_r.err)}; }
        val next: str = parent_r.ok;
        if (str_equals(next, dir)) {
            str_free(alloc, next);
            ret res[opt[str], fail.Fail].ok{opt[str].none{}};
        }
        str_free(alloc, dir);
        dir = next;
    }
    ret res[opt[str], fail.Fail].ok{opt[str].none{}};
}

fun relative_under(alloc: *A.Allocator, file_path: str, root: str, src_text: str) res[opt[str], fail.Fail] {
    val prefix_r: res[str, fail.Fail] = driver_load.join_path(alloc, root, src_text);
    if (sel prefix_r.err) { ret res[opt[str], fail.Fail].err{prefix_r.err}; }
    val prefix: str = prefix_r.ok;
    fin { str_free(alloc, prefix); }
    val plen: usize = str_len(prefix);
    val flen: usize = str_len(file_path);
    if (flen <= plen || !types_path.is_separator(file_path[plen])) {
        ret res[opt[str], fail.Fail].ok{opt[str].none{}};
    }
    var i: usize = 0;
    for (i < plen) {
        if (file_path[i] != prefix[i] && !(types_path.is_separator(file_path[i]) && types_path.is_separator(prefix[i]))) {
            ret res[opt[str], fail.Fail].ok{opt[str].none{}};
        }
        i = i + 1;
    }
    val rel_r: res[str, types_string.StrError] = str_copy_slice(alloc, file_path, plen + 1, flen - plen - 1);
    if (sel rel_r.err) { ret res[opt[str], fail.Fail].err{fail.str_refused(rel_r.err)}; }
    ret res[opt[str], fail.Fail].ok{opt[str].some{rel_r.ok}};
}

# the module the file at `path` is under the project at `root`: none when it lies outside the
# source directory
# ---
# id_text:  the project id, the module path's first segment
# src_text: the manifest's source directory, relative to `root`
pub fun module_under(alloc: *A.Allocator, itn: *intern.Interner, path: str, root: str, id_text: str,
    src_text: str) res[opt[intern.StrId], fail.Fail] {
    val relative: res[opt[str], fail.Fail] = relative_under(alloc, path, root, src_text);
    if (sel relative.err)     { ret res[opt[intern.StrId], fail.Fail].err{relative.err}; }
    if (sel relative.ok.none) { ret res[opt[intern.StrId], fail.Fail].ok{opt[intern.StrId].none{}}; }
    val rel:  str                          = relative.ok.some;
    val name: res[intern.StrId, fail.Fail] = module.compose_fqn(alloc, itn, id_text, rel);
    str_free(alloc, rel);
    if (sel name.err) { ret res[opt[intern.StrId], fail.Fail].err{name.err}; }
    ret res[opt[intern.StrId], fail.Fail].ok{opt[intern.StrId].some{name.ok}};
}

# the module the file at `path` is loaded as beside the project at `root`: none when the
# file belongs to another project or lies outside the source directory
# ---
# id_text:  the project id, the module path's first segment
# src_text: the manifest's source directory, relative to `root`
pub fun file_module(alloc: *A.Allocator, itn: *intern.Interner, path: str, root: str, id_text: str,
    src_text: str) res[opt[intern.StrId], fail.Fail] {
    val owner_r: res[opt[str], fail.Fail] = project_root_of(alloc, path);
    if (sel owner_r.err) { ret res[opt[intern.StrId], fail.Fail].err{owner_r.err}; }
    val owner: opt[str] = owner_r.ok;
    if (sel owner.none) { ret res[opt[intern.StrId], fail.Fail].ok{opt[intern.StrId].none{}}; }
    val same: bool = str_equals(owner.some, root);
    str_free(alloc, owner.some);
    if (!same) { ret res[opt[intern.StrId], fail.Fail].ok{opt[intern.StrId].none{}}; }
    ret module_under(alloc, itn, path, root, id_text, src_text);
}
