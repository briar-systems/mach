# a test build lowers each module's normal object exactly as a build does: its `main`
# stays defined, and its tests and test-only instances are left to the test object. a
# build after it reuses that lowering
test lower__a_test_build_lowers_the_build_normal_object {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "leaf.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.leaf.fa;\n#[symbol(\"main\")]\nfun runtime_entry() i32 { ret fa(); }\npub fun main() i32 { ret fa(); }\nfun test_only[T](x: T) T { ret x; }\n$if ($mach.build.pointer_width == 8) {\n    test variant_probe { if (test_only[i32](7) != 7) { ret 1; } ret 0; }\n}\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?sA);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, fail.Fail] = rebuild(?sA, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p1:   project.Project      = p1r.ok;
    var req1: request.BuildRequest = p1.req;
    req1.goal = request.GOAL_TESTS;
    val reconfigured1:   err[fail.Fail] = reconfigure(?p1, req1);
    var run_sema_pass_r: err[fail.Fail] = reconfigured1;
    if (sel reconfigured1.ok) { run_sema_pass_r = run_sema_pass(?p1); }
    if (sel run_sema_pass_r.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val run_lower_pass_r: err[fail.Fail] = run_lower_pass(?p1);
    if (sel run_lower_pass_r.err) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val st_main: session.StableModuleId = project.stable_named(?p1, "uniontest.main");
    val mid1:    session.ModuleId       = project.module_named(?p1, "uniontest.main");
    if (module.is_nil(mid1)) {
        project.dnit_project(?p1);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val lowered1: *lower_context.Unit = project.module_at(?p1, mid1::u32).unit;
    if (!unit_defines(?sA, lowered1, "main"))                { bad = 2; }
    if (!unit_defines(?sA, lowered1, "uniontest.main.main")) { bad = 3; }
    if (unit_test_count(lowered1) != 0)                      { bad = 4; }
    val key_test: u64            = passes.back_half_key(st_main, true);
    val key_norm: u64            = passes.back_half_key(st_main, false);
    val lc_norm1: query.Revision = lower_lc_key(?sA, key_norm);
    if (lc_norm1 == 0xFFFFFFFFFFFFFFFF) { bad = 6; }
    project.dnit_project(?p1);

    val p2r: res[project.Project, fail.Fail] = rebuild(?sA, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    var p2:   project.Project      = p2r.ok;
    var req2: request.BuildRequest = p2.req;
    req2.goal = request.GOAL_ARTIFACT;
    val reconfigured2:    err[fail.Fail] = reconfigure(?p2, req2);
    var run_sema_pass_r2: err[fail.Fail] = reconfigured2;
    if (sel reconfigured2.ok) { run_sema_pass_r2 = run_sema_pass(?p2); }
    if (sel run_sema_pass_r2.err) {
        project.dnit_project(?p2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    val run_lower_pass_r2: err[fail.Fail] = run_lower_pass(?p2);
    if (sel run_lower_pass_r2.err) {
        project.dnit_project(?p2);
        fs.remove_all(?alloc, root);
        session.dnit(?sA);
        ret 1;
    }
    if (lower_lc_key(?sA, key_norm) != lc_norm1) { bad = 7; }
    # no test object was asked for, so none was lowered
    if (lower_lc_key(?sA, key_test) != 0xFFFFFFFFFFFFFFFF) { bad = 8; }
    project.dnit_project(?p2);

    fs.remove_all(?alloc, root);
    session.dnit(?sA);
    ret bad;
}

test embed__asset_edit_invalidates_sema {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    names[2] = "other.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.other;\n\n#[embed(\"asset.bin\")]\nval A: [_]u8;\n\nfun main() i32 { ret A[0]::i32; }\n";
    texts[1] = "abc";
    texts[2] = "pub fun untouched() i32 { ret 1; }\n";

    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, fail.Fail] = sema_build(?s, root);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p1:         project.Project        = p1r.ok;
    val st_main:    session.StableModuleId = project.stable_named(?p1, "uniontest.main");
    val st_other:   session.StableModuleId = project.stable_named(?p1, "uniontest.other");
    val lc_main_1:  query.Revision         = sema_lc(?s, st_main);
    val lc_other_1: query.Revision         = sema_lc(?s, st_other);
    project.dnit_project(?p1);

    val p2r: res[project.Project, fail.Fail] = sema_build(?s, root);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2: project.Project = p2r.ok;
    if (sema_lc(?s, st_main) != lc_main_1) { bad = 1; }
    project.dnit_project(?p2);

    if (!write_source(?alloc, root, "asset.bin", "wxyz")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    val p3r: res[project.Project, fail.Fail] = sema_build(?s, root);
    if (sel p3r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p3: project.Project = p3r.ok;
    if (sema_lc(?s, st_main) == lc_main_1)   { bad = 1; }
    if (sema_lc(?s, st_other) != lc_other_1) { bad = 1; }
    project.dnit_project(?p3);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

# the unit of the module `fqn`, nil when it is not loaded or not lowered
#[testing]
fun unit_named(p: *project.Project, fqn: str) *lower_context.Unit {
    val mid: session.ModuleId = project.module_named(p, fqn);
    if (module.is_nil(mid)) { ret nil; }
    ret project.module_at(p, mid::u32).unit;
}

test embed__buffer_is_stable_across_warm_rebuilds {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "asset.bin";
    var texts: [2]str;
    texts[0] = "#[embed(\"asset.bin\")]\nval A: [_]u8;\n\nfun main() i32 { ret A[0]::i32; }\n";
    texts[1] = "abc";

    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32 = 0;

    val p1r: res[project.Project, fail.Fail] = lowered(?s, root, false);
    if (sel p1r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p1: project.Project     = p1r.ok;
    val u1: *lower_context.Unit = unit_named(?p1, "uniontest.main");
    if (!unit_holds(?alloc, u1, "{i8 97, i8 98, i8 99}")) { bad = 1; }
    val st_main: session.StableModuleId = project.stable_named(?p1, "uniontest.main");
    val lower_1: query.Revision         = lower_lc(?s, st_main);
    project.dnit_project(?p1);

    val p2r: res[project.Project, fail.Fail] = lowered(?s, root, false);
    if (sel p2r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p2: project.Project     = p2r.ok;
    val u2: *lower_context.Unit = unit_named(?p2, "uniontest.main");
    if (u2 == nil || u2 != u1)            { bad = 1; }
    if (lower_lc(?s, st_main) != lower_1) { bad = 1; }
    project.dnit_project(?p2);

    if (!write_source(?alloc, root, "asset.bin", "xyz")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val p3r: res[project.Project, fail.Fail] = lowered(?s, root, false);
    if (sel p3r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p3: project.Project = p3r.ok;
    if (!unit_holds(?alloc, unit_named(?p3, "uniontest.main"), "{i8 120, i8 121, i8 122}")) { bad = 1; }
    val lower_3: query.Revision = lower_lc(?s, st_main);
    if (lower_3 == lower_1) { bad = 1; }
    project.dnit_project(?p3);

    if (!write_source(?alloc, root, "asset.bin", "wxyz!")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    val p4r: res[project.Project, fail.Fail] = lowered(?s, root, false);
    if (sel p4r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p4: project.Project = p4r.ok;
    if (!unit_holds(?alloc, unit_named(?p4, "uniontest.main"), "{i8 119, i8 120, i8 121, i8 122, i8 33}")) { bad = 1; }
    if (lower_lc(?s, st_main) == lower_3)                                                                  { bad = 1; }
    project.dnit_project(?p4);

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

test retention__a_reload_cycle_reaches_steady_state {
    var lb:    T.Counting;
    var alloc: A.Allocator;
    T.counting_make(?lb, ?alloc);

    var names: [4]str;
    names[0] = "alpha.mach";
    names[1] = "beta.mach";
    names[2] = "model.mach";
    names[3] = "orphan.mach";
    var texts: [4]str;
    texts[0] = "fun main() i32 { ret no_such(); }\n";
    texts[1] = "use ctxcase.model;\nfun main() i32 { var b: model.Box[model.Leaf]; ret model.take[model.Leaf](b); }\n";
    texts[2] = "pub rec Leaf { n: i32; }\npub rec Box[T] { v: T; }\npub fun take[T](b: Box[T]) i32 { ret 7; }\n";
    texts[3] = "fun broken() NoSuch { var x: AlsoMissing; ret x; }\n";
    val root_r: res[str, fail.Fail] = scaffold(
        ?alloc, manifest_frontend(), ?names[0], ?texts[0], 4);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) {
        fs.remove_all(?alloc, root);
        ret 1;
    }
    var s: session.Session = sr.ok;

    var bad:     i32   = 0;
    var settled: usize = 0;
    var round:   i32   = 0;
    for (round < 5) {
        val mr: res[manifest.Manifest, fail.Fail] = load_manifest(?s, root);
        if (sel mr.err) {
            bad = 2;
            brk;
        }
        var mf: manifest.Manifest = mr.ok;

        var req: request.BuildRequest = request.defaults();
        req.project_root = root;
        req.target       = "windows";
        req.profile      = "release";
        req.artifact     = "beta";
        req.goal         = request.GOAL_OBJECTS;
        req.opt          = request.OPT_RELEASE;
        req.pie          = true;

        val pr: res[project.Project, fail.Fail] = analyze_project_tolerant(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0, FRONTEND_SEMA);
        if (sel pr.err) {
            manifest.dnit(?mf, ?alloc);
            bad = 3;
            brk;
        }
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        manifest.dnit(?mf, ?alloc);

        if (round == 2) { settled = lb.live; }
        if (round > 2 && lb.live != settled) {
            bad = 4;
            brk;
        }
        round = round + 1;
    }

    session.dnit(?s);
    fs.remove_all(?alloc, root);
    ret bad;
}

#[testing]
fun manifest_with_dep() str {
    ret "[project]\nmach = \">=5\"\nid = \"ctxcase\"\nversion = \"1.2.3\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n\n[dep.leaf]\npath = \"dep/leaf\"\n\n[artifact.beta]\nkind = \"bin\"\nentry = \"beta.mach\"\nout = \"{project.work}/bin/beta\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

#[testing]
fun scaffold_dep(alloc: *A.Allocator, root: str) bool {
    val dep_src: res[str, A.Error] = types_path.join(alloc, root, "dep/leaf/src");
    if (sel dep_src.err) { ret false; }
    val made: err[fs.FsError] = fs.create_dir_all(alloc, dep_src.ok, 493);
    if (sel made.err) { ret false; }

    val dm:  str                 = "[project]\nmach = \">=5\"\nid = \"leaf\"\nversion = \"0.1.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.leaf]\nkind = \"static\"\nentry = \"leaf.mach\"\nout = \"{project.work}/lib/leaf.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    val dmp: res[str, fail.Fail] = fail.join(alloc, root, "/dep/leaf/", manifest.MANIFEST_FILE);
    if (sel dmp.err) { ret false; }
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(dmp.ok, dm, str_len(dm), 420);
    if (sel write_bytes_r.err) { ret false; }

    val ds:  str               = "pub fun leaf_value() i32 { ret 7; }\n";
    val dsp: res[str, A.Error] = types_path.join(alloc, dep_src.ok, "leaf.mach");
    if (sel dsp.err) { ret false; }
    val write_bytes_r2: err[fs.FsError] = fs.write_bytes(dsp.ok, ds, str_len(ds), 420);
    if (sel write_bytes_r2.err) { ret false; }
    ret true;
}

test retention__a_reload_cycle_with_a_dependency_is_steady {
    var lb:    T.Counting;
    var alloc: A.Allocator;
    T.counting_make(?lb, ?alloc);

    var names: [1]str;
    names[0] = "beta.mach";
    var texts: [1]str;
    texts[0] = "use leaf.leaf;\nfun main() i32 { ret leaf.leaf_value(); }\n";
    val root_r: res[str, fail.Fail] = scaffold(
        ?alloc, manifest_with_dep(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    if (!scaffold_dep(?alloc, root)) {
        fs.remove_all(?alloc, root);
        ret 3;
    }

    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) {
        fs.remove_all(?alloc, root);
        ret 4;
    }
    var s: session.Session = sr.ok;

    var bad:     i32   = 0;
    var settled: usize = 0;
    var round:   i32   = 0;
    for (round < 5) {
        val mr: res[manifest.Manifest, fail.Fail] = load_manifest(?s, root);
        if (sel mr.err) {
            bad = 5;
            brk;
        }
        var mf: manifest.Manifest = mr.ok;
        if (mf.dep_count == 0) {
            manifest.dnit(?mf, ?alloc);
            bad = 6;
            brk;
        }

        var req: request.BuildRequest = request.defaults();
        req.project_root = root;
        req.target       = "windows";
        req.profile      = "release";
        req.artifact     = "beta";
        req.goal         = request.GOAL_OBJECTS;
        req.opt          = request.OPT_RELEASE;
        req.pie          = true;

        val pr: res[project.Project, fail.Fail] = analyze_project_tolerant(?s, ?mf, ?req, project.ROOT_ARTIFACT, nil, 0, FRONTEND_SEMA);
        if (sel pr.err) {
            manifest.dnit(?mf, ?alloc);
            bad = 7;
            brk;
        }
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        manifest.dnit(?mf, ?alloc);

        if (round == 2) { settled = lb.live; }
        if (round > 2 && lb.live != settled) {
            print.eprintlnf("dependency reload {}: expected {} live bytes, found {}", round, settled, lb.live);
            bad = 8;
            brk;
        }
        round = round + 1;
    }

    session.dnit(?s);
    fs.remove_all(?alloc, root);
    ret bad;
}

#[testing]
rec SurfaceRevisions {
    dep:        query.Revision;
    dep_public: query.Revision;
    main_sema:  query.Revision;
    disc_bytes: u32;
    case_count: u32;
}

# builds the scaffolded project once more in the same session, runs sema, and reads the revisions
# of the dependency's surfaces and the dependent's semantic product
#[testing]
fun surface_revisions(alloc: *A.Allocator, s: *session.Session, root: str, out: *SurfaceRevisions) i32 {
    val built: res[project.Project, fail.Fail] = rebuild(s, root);
    if (sel built.err) { ret 1; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    val run_sema_pass_r: err[fail.Fail] = run_sema_pass(?p);
    if (sel run_sema_pass_r.err) { ret 2; }
    val dep:  session.StableModuleId = project.stable_named(?p, "uniontest.api");
    val main: session.StableModuleId = project.stable_named(?p, "uniontest.main");
    if (module.stable_is_nil(dep) || module.stable_is_nil(main)) { ret 3; }
    val main_mid: session.ModuleId    = project.module_named(?p, "uniontest.main");
    val sr:       *fe_sema.SemaResult = frontend.typed(?p, project.module_at(?p, main_mid::u32));
    if (sr == nil || sr.decl_count < 2) { ret 4; }
    # the projection is read while the pass's installation is live: a later query phase resets it
    out.disc_bytes = type.tag_discriminator_bytes(?s.types, sr.decl_type[1]);
    out.case_count = type.field_count(?s.types, sr.decl_type[1]);
    val typed: res[QuerySnapshot, fail.Fail] = query_snapshot(alloc, ?p, ?frontend.TYPED_EXPORTS, module.stable_index(dep)::u64);
    if (sel typed.err) { ret 5; }
    val typed_snapshot: QuerySnapshot = typed.ok;
    if (typed_snapshot.value != nil) { A.deallocate[u8](alloc, typed_snapshot.value, typed_snapshot.value_len::usize); }
    out.dep = typed_snapshot.last_changed;
    val public: res[QuerySnapshot, fail.Fail] = query_snapshot(alloc, ?p, ?frontend.EXPORTS, module.stable_index(dep)::u64);
    if (sel public.err) { ret 6; }
    val public_snapshot: QuerySnapshot = public.ok;
    if (public_snapshot.value != nil) { A.deallocate[u8](alloc, public_snapshot.value, public_snapshot.value_len::usize); }
    out.dep_public = public_snapshot.last_changed;
    val checked: res[QuerySnapshot, fail.Fail] = query_snapshot(alloc, ?p, ?frontend.SEMA, module.stable_index(main)::u64);
    if (sel checked.err) { ret 7; }
    val checked_snapshot: QuerySnapshot = checked.ok;
    if (checked_snapshot.value != nil) { A.deallocate[u8](alloc, checked_snapshot.value, checked_snapshot.value_len::usize); }
    out.main_sema = checked_snapshot.last_changed;
    ret 0;
}

# a tag's discriminator width and case list are part of its typed surface: each edit and its
# revert advance the surface and re-check the dependent, and a body edit beside them does not
test typed_surface__tag_layout_edits_replay_dependents {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [2]str = [2]str{"main.mach", "api.mach"};
    var texts: [2]str;
    texts[0] = "use uniontest.api;\nvar g: api.T;\nfun main() i32 { ret api.helper(); }\n";
    texts[1] = "pub tag T: u8 { a; b: i64; }\npub fun helper() i32 { ret 1; }\n";
    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    var first: SurfaceRevisions;
    val r1:    i32 = surface_revisions(?alloc, ?s, root, ?first);
    if (r1 != 0)                                                                                                     { ret 10 + r1; }
    if (first.disc_bytes != 1 || first.case_count != 2)                                                              { ret 2; }
    if (!write_source(?alloc, root, "api.mach", "pub tag T: u16 { a; b: i64; }\npub fun helper() i32 { ret 1; }\n")) { ret 3; }
    var widened: SurfaceRevisions;
    val r2:      i32 = surface_revisions(?alloc, ?s, root, ?widened);
    if (r2 != 0)                                                                                                     { ret 20 + r2; }
    if (widened.dep == first.dep || widened.main_sema == first.main_sema)                                            { ret 4; }
    if (widened.disc_bytes != 2)                                                                                     { ret 5; }
    if (!write_source(?alloc, root, "api.mach", "pub tag T: u16 { a; b: i64; }\npub fun helper() i32 { ret 2; }\n")) { ret 6; }
    var body_only: SurfaceRevisions;
    val r3:        i32 = surface_revisions(?alloc, ?s, root, ?body_only);
    if (r3 != 0)                                                                                                                { ret 30 + r3; }
    if (body_only.dep != widened.dep || body_only.dep_public != widened.dep_public || body_only.main_sema != widened.main_sema) { ret 7; }
    if (!write_source(?alloc, root, "api.mach", "pub tag T: u8 { a; b: i64; }\npub fun helper() i32 { ret 2; }\n"))             { ret 8; }
    var reverted: SurfaceRevisions;
    val r4:       i32 = surface_revisions(?alloc, ?s, root, ?reverted);
    if (r4 != 0)                                                                                                       { ret 40 + r4; }
    if (reverted.dep == body_only.dep || reverted.main_sema == body_only.main_sema)                                    { ret 9; }
    if (reverted.disc_bytes != 1)                                                                                      { ret 10; }
    if (!write_source(?alloc, root, "api.mach", "pub tag T: u8 { a; b: i64; c; }\npub fun helper() i32 { ret 2; }\n")) { ret 11; }
    var grown: SurfaceRevisions;
    val r5:    i32 = surface_revisions(?alloc, ?s, root, ?grown);
    if (r5 != 0)                                                                                                    { ret 50 + r5; }
    if (grown.dep == reverted.dep || grown.main_sema == reverted.main_sema)                                         { ret 12; }
    if (grown.case_count != 3)                                                                                      { ret 13; }
    if (!write_source(?alloc, root, "api.mach", "pub tag T: u8 { a; b: i64; }\npub fun helper() i32 { ret 2; }\n")) { ret 14; }
    var shrunk: SurfaceRevisions;
    val r6:     i32 = surface_revisions(?alloc, ?s, root, ?shrunk);
    if (r6 != 0)                                                        { ret 60 + r6; }
    if (shrunk.dep == grown.dep || shrunk.main_sema == grown.main_sema) { ret 15; }
    if (shrunk.case_count != 2)                                         { ret 16; }
    ret 0;
}

#[testing]
fun last_warning_index(s: *session.Session, needle: str) i64 {
    var found: i64   = -1;
    var i:     usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (!diagnostic_kind.is_error(d.kind) && str_contains(d.message, needle)) { found = i::i64; }
        i = i + 1;
    }
    ret found;
}

test public_surface__deprecation_message_edits_replay {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [2]str = [2]str{"main.mach", "api.mach"};
    var texts: [2]str;
    texts[0] = "use uniontest.api;\nvar g: api.T;\nfun main() i32 { ret api.old(); }\n";
    texts[1] = "pub tag T: u8 { a; b: i64; }\n#[deprecated(\"first\")]\npub fun old() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    var first: SurfaceRevisions;
    val r1:    i32 = surface_revisions(?alloc, ?s, root, ?first);
    if (r1 != 0)                                                                                                                            { ret 10 + r1; }
    if (last_warning_index(?s, "`old` is deprecated: first") < 0 || last_warning_index(?s, "`old` is deprecated: second") >= 0)             { ret 2; }
    if (!write_source(?alloc, root, "api.mach", "pub tag T: u8 { a; b: i64; }\n#[deprecated(\"second\")]\npub fun old() i32 { ret 0; }\n")) { ret 3; }
    var changed: SurfaceRevisions;
    val r2:      i32 = surface_revisions(?alloc, ?s, root, ?changed);
    if (r2 != 0)                                                                                                                           { ret 20 + r2; }
    if (changed.dep_public == first.dep_public || changed.main_sema == first.main_sema)                                                    { ret 4; }
    if (last_warning_index(?s, "`old` is deprecated: second") < 0 || last_warning_index(?s, "`old` is deprecated: first") >= 0)            { ret 5; }
    if (!write_source(?alloc, root, "api.mach", "pub tag T: u8 { a; b: i64; }\n#[deprecated(\"first\")]\npub fun old() i32 { ret 0; }\n")) { ret 6; }
    var reverted: SurfaceRevisions;
    val r3:       i32 = surface_revisions(?alloc, ?s, root, ?reverted);
    if (r3 != 0)                                                                                                                           { ret 30 + r3; }
    if (reverted.dep_public == changed.dep_public || reverted.main_sema == changed.main_sema)                                              { ret 7; }
    if (last_warning_index(?s, "`old` is deprecated: first") < 0 || last_warning_index(?s, "`old` is deprecated: second") >= 0)            { ret 8; }
    if (!write_source(?alloc, root, "api.mach", "pub tag T: u8 { a; b: i64; }\n#[deprecated(\"first\")]\npub fun old() i32 { ret 1; }\n")) { ret 9; }
    var body_only: SurfaceRevisions;
    val r4:        i32 = surface_revisions(?alloc, ?s, root, ?body_only);
    if (r4 != 0)                                                                                  { ret 40 + r4; }
    if (body_only.dep_public != reverted.dep_public || body_only.main_sema != reverted.main_sema) { ret 10; }
    # a cached semantic product replays its warning into every later presentation
    if (last_warning_index(?s, "`old` is deprecated: first") < 0) { ret 11; }
    ret 0;
}

# a warm rebuild of a typed gate reuses every front-end product the cold build made
# and presents the same diagnostics, for an accepted and for a rejected build
test gate__warm_rebuild_reuses_products_and_replays_diagnostics {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names:  [1]str              = [1]str{"main.mach"};
    var texts:  [1]str              = [1]str{"$if ($mach.build.os == NATIVE_OS) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 1;\n$if (C) { fun f() i32 { ret 1; } }\nfun main() i32 { ret 0; }\n"};
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = gate_session(?alloc, ?names[0], ?texts[0], 1, ?s);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
    }
    var cold_diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    fin { diagnostic.store_dnit(?cold_diags); }
    var warm_diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    fin { diagnostic.store_dnit(?warm_diags); }

    val cold: res[project.Project, fail.Fail] = gate_rebuild(?s, root);
    if (sel cold.err) { ret 3; }
    var p:         project.Project = cold.ok;
    val cold_copy: err[fail.Fail]  = diagnostic.replay_into(?cold_diags, ?s.diags);
    project.dnit_project(?p);
    if (sel cold_copy.err) { ret 4; }

    val cold_computes: u64                             = frontend_computes(?s);
    val warm:          res[project.Project, fail.Fail] = gate_rebuild(?s, root);
    if (sel warm.err) { ret 6; }
    p = warm.ok;
    val warm_copy:  err[fail.Fail] = diagnostic.replay_into(?warm_diags, ?s.diags);
    val recomputed: u64            = frontend_computes(?s) - cold_computes;
    project.dnit_project(?p);
    if (sel warm_copy.err) { ret 7; }
    if (recomputed != 0)   { ret 12; }
    val same: res[bool, fail.Fail] = diagnostic.content_equal(?cold_diags, ?warm_diags);
    if (sel same.err)                                                       { ret 9; }
    if (!same.ok)                                                           { ret 10; }
    if (!diagnostic.error_says(?warm_diags, "condition must have type u8")) { ret 11; }

    # a rejected build: the gate's own `$error` is reported by the cold build and again by the warm one
    if (!write_source(?alloc, root, "main.mach", "def Flag: u8;\nval C: Flag = 1;\n$if (C) { $error(\"gated boom\"); }\nfun main() i32 { ret 0; }\n")) { ret 30; }
    var round: u32 = 0;
    for (round < 2) {
        val built: res[project.Project, fail.Fail] = gate_rebuild(?s, root);
        if (sel built.ok) {
            var rejected: project.Project  = built.ok;
            val status:   fail.PhaseStatus = frontend.frontend_status(?rejected);
            project.dnit_project(?rejected);
            if (sel status.kind.accepted) { ret 31; }
        }
        if (!diagnostic.error_says(?s.diags, "gated boom")) { ret 32 + round::i32; }
        round = round + 1;
    }
    ret 0;
}

# each stage binds over a module in its own product: the load's bindings never hold the type sema
# gives a constant tag, and a warm rebuild that makes a new load product beside the cached resolve
# and sema products reads that type through the scope lowering binds in
test stage_bindings__cached_products_read_beside_a_rebuilt_load {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names:  [1]str              = [1]str{"main.mach"};
    var texts:  [1]str              = [1]str{"tag Reply: u8 { empty; value: i64; }\nval K: Reply = Reply.value{42};\nfun main() i32 { ret 0; }\n"};
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = gate_session(?alloc, ?names[0], ?texts[0], 1, ?s);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
    }
    val name_r: res[intern.StrId, A.Error] = intern.add(?s.interner, "K");
    if (sel name_r.err) { ret 3; }
    var round: u32 = 0;
    for (round < 2) {
        val before: u64                             = frontend_computes(?s);
        val built:  res[project.Project, fail.Fail] = gate_rebuild(?s, root);
        if (sel built.err) { ret 10 + round::i32; }
        var p:   project.Project = built.ok;
        val bad: i32             = stage_bindings(?p, ?s, name_r.ok, round == 1 && frontend_computes(?s) != before);
        project.dnit_project(?p);
        if (bad != 0) { ret 20 + round::i32 * 10 + bad; }
        round = round + 1;
    }
    ret 0;
}

#[testing]
fun stage_bindings(p: *project.Project, s: *session.Session, name: intern.StrId, recomputed: bool) i32 {
    if (recomputed) { ret 1; }
    val m:      *project.ModuleEntry                  = project.module_at(p, project.module_named(p, "uniontest.main")::u32);
    val loaded: u32                                   = element_type(?m.load.ctx, name);
    val scoped: res[*comptime.ComptimeCtx, fail.Fail] = frontend.lowering_scope(p, m);
    if (sel scoped.err) { ret 2; }
    val typed: u32 = element_type(scoped.ok, name);
    if (typed == 0 || typed == loaded) { ret 3; }
    ret 0;
}

# the type a constant element is bound with in a scope, 0 when it is not bound as one
#[testing]
fun element_type(c: *comptime.ComptimeCtx, name: intern.StrId) u32 {
    val bound: opt[comptime.NamedConst] = comptime.lookup(c, name);
    if (sel bound.none) { ret 0; }
    val named: comptime.NamedConst = bound.some;
    if (named.value.kind != comptime.CT_KIND_CONST_ELEM) { ret 0; }
    ret named.value.data.celem.ty;
}

# the resolve, export and sema products the session computed rather than reused, so far
#[testing]
fun frontend_computes(s: *session.Session) u64 {
    ret query.computes(?s.queries, ?frontend.RESOLVE) + query.computes(?s.queries, ?frontend.EXPORTS)
        + query.computes(?s.queries, ?frontend.SEMA) + query.computes(?s.queries, ?frontend.TYPED_EXPORTS);
}

#[testing]
val VIEW_MAIN: str = "$if (helper.FLAG == 1) {\n    use uniontest.extra;\n    fun pick() i32 { ret extra.extra(); }\n}\n$or {\n    fun pick() i32 { ret 7; }\n}\n\nuse uniontest.helper;\n\nfun main() i32 { ret pick(); }\n";

#[testing]
rec ViewCounts {
    topo:    u32;
    extra:   bool;
    views:   u32;
    resolve: u32;
}

#[testing]
fun view_counts(p: *project.Project, s: *session.Session) ViewCounts {
    var c:     ViewCounts       = ViewCounts{topo: p.topo_len};
    val extra: session.ModuleId = project.module_named(p, "uniontest.extra");
    var i:     u32              = 0;
    for (i < p.topo_len) {
        if (module.same(p.topo[i], extra)) { c.extra = true; }
        i = i + 1;
    }
    c.views   = query.shard_len(?s.queries, ?frontend.LOAD_VIEW);
    c.resolve = query.shard_len(?s.queries, ?frontend.RESOLVE);
    ret c;
}

# the answer a fresh session gives for the same sources
#[testing]
fun cold_view_counts(alloc: *A.Allocator, flag: str, out: *ViewCounts) bool {
    var names:  [3]str              = [3]str{"main.mach", "helper.mach", "extra.mach"};
    var texts:  [3]str              = [3]str{VIEW_MAIN, flag, "pub fun extra() i32 { ret 3; }\n"};
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = gate_session(alloc, ?names[0], ?texts[0], 3, ?s);
    if (sel root_r.err) { ret false; }
    val built: res[project.Project, fail.Fail] = gate_rebuild(?s, root_r.ok);
    var ok:    bool                            = sel built.ok;
    if (sel built.ok) {
        var p: project.Project = built.ok;
        @out = view_counts(?p, ?s);
        project.dnit_project(?p);
    }
    fs.remove_all(alloc, root_r.ok);
    session.dnit(?s);
    ret ok;
}

# a typed input flipping back and forth reaches the cold answer every time, and the views and products the
# session holds return to the same count for the same sources, so a long-lived session does not accumulate them
test gate__flipped_input_reaches_the_cold_view_with_a_steady_cache {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var want_on:  ViewCounts;
    var want_off: ViewCounts;
    if (!cold_view_counts(?alloc, VIEW_CFG_ON, ?want_on))   { ret 2; }
    if (!cold_view_counts(?alloc, VIEW_CFG_OFF, ?want_off)) { ret 3; }
    if (!want_on.extra || want_off.extra)                   { ret 4; }

    var names:  [3]str              = [3]str{"main.mach", "helper.mach", "extra.mach"};
    var texts:  [3]str              = [3]str{VIEW_MAIN, VIEW_CFG_ON, "pub fun extra() i32 { ret 3; }\n"};
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = gate_session(?alloc, ?names[0], ?texts[0], 3, ?s);
    if (sel root_r.err) { ret 5; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
    }
    var steady: [2]ViewCounts;
    var round:  u32 = 0;
    for (round < 8) {
        val on:   bool = round % 2 == 0;
        var flag: str  = VIEW_CFG_OFF;
        if (on)                                                            { flag = VIEW_CFG_ON; }
        if (round > 0 && !write_source(?alloc, root, "helper.mach", flag)) { ret 6; }
        val built: res[project.Project, fail.Fail] = gate_rebuild(?s, root);
        if (sel built.err) { ret 10 + round::i32; }
        var p:    project.Project = built.ok;
        val got:  ViewCounts      = view_counts(?p, ?s);
        var bad:  i32             = 0;
        var want: ViewCounts      = want_off;
        if (on)                                               { want = want_on; }
        if (got.topo != want.topo || got.extra != want.extra) { bad = 20; }
        var k: u32 = 1;
        if (on) { k = 0; }
        # the first visit to each state may still hold the other state's views; from the second on they are steady
        if (round >= 2) {
            if (round < 4)                                                        { steady[k] = got; }
            or (got.views != steady[k].views || got.resolve != steady[k].resolve) { bad = 40; }
        }
        project.dnit_project(?p);
        if (bad != 0) { ret bad + round::i32; }
        round = round + 1;
    }
    ret 0;
}

# the products a module owns in the session, whether or not the last build loaded it
#[testing]
fun owned(s: *session.Session, fqn: str) u32 {
    val idr: res[intern.StrId, A.Error] = intern.add(?s.interner, fqn);
    if (sel idr.err) { ret 0; }
    val stable: session.StableModuleId = session.stable_module_id_lookup(s, idr.ok);
    if (module.stable_is_nil(stable)) { ret 0; }
    ret query.owned_len(?s.queries, query.KEY_MODULE, stable::u32);
}

# the module's products counted from the kinds this test names, not from the query's own owner table
#[testing]
fun keyed(s: *session.Session, fqn: str) u32 {
    val idr: res[intern.StrId, A.Error] = intern.add(?s.interner, fqn);
    if (sel idr.err) { ret 0; }
    val stable: session.StableModuleId = session.stable_module_id_lookup(s, idr.ok);
    if (module.stable_is_nil(stable)) { ret 0; }
    var kinds: [7]*query.Kind = [7]*query.Kind{?frontend.RESOLVE, ?frontend.EXPORTS,
        ?frontend.LOAD_VIEW, ?frontend.SEMA, ?frontend.TYPED_EXPORTS, ?frontend.MODULE_NUMBER, ?passes.LOWERED_SURFACE};
    var total: u32 = 0;
    var k:     u32 = 0;
    for (k < 7) {
        if (query.peek_revision(?s.queries, kinds[k], module.stable_index(stable)::u64) != 0) { total = total + 1; }
        k = k + 1;
    }
    ret total;
}

#[testing]
fun held(s: *session.Session, fqn: str) bool {
    val idr: res[intern.StrId, A.Error] = intern.add(?s.interner, fqn);
    if (sel idr.err) { ret false; }
    ret retention.holds(?s.retention, retention.RETAINER_SESSION, session.stable_module_id_lookup(s, idr.ok));
}

#[testing]
fun products(s: *session.Session) u32 {
    ret query.product_count(?s.queries);
}

# main importing `name`, or importing nothing for an empty name
#[testing]
fun retained_main(alloc: *A.Allocator, name: str) res[str, fail.Fail] {
    if (str_empty(name)) { ret res[str, fail.Fail].ok{"fun main() i32 { ret 0; }\n"}; }
    ret fail.join(alloc, "use uniontest.", name, ";\nfun main() i32 { ret ", name, ".f(); }\n");
}

#[testing]
fun retained_build(alloc: *A.Allocator, s: *session.Session, root: str, name: str) bool {
    val text: res[str, fail.Fail] = retained_main(alloc, name);
    if (sel text.err)                                     { ret false; }
    if (!write_source(alloc, root, "main.mach", text.ok)) { ret false; }
    val built: res[project.Project, fail.Fail] = gate_rebuild(s, root);
    if (sel built.err) { ret false; }
    var p: project.Project = built.ok;
    project.dnit_project(?p);
    ret true;
}

test retention__a_module_that_leaves_releases_its_products {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names: [4]str = [4]str{"main.mach", "a.mach", "b.mach", "c.mach"};
    var texts: [4]str = [4]str{"use uniontest.a;\nfun main() i32 { ret a.f(); }\n", "pub fun f() i32 { ret 1; }\n",
        "pub fun f() i32 { ret 2; }\n", "pub fun f() i32 { ret 3; }\n"};
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = gate_session(?alloc, ?names[0], ?texts[0], 4, ?s);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
    }

    val cold: res[project.Project, fail.Fail] = gate_rebuild(?s, root);
    if (sel cold.err) { ret 3; }
    var p:      project.Project  = cold.ok;
    val a_mid:  session.ModuleId = project.module_named(?p, "uniontest.a");
    var a_file: u32              = 0;
    if (!module.is_nil(a_mid)) { a_file = project.module_at(?p, a_mid::u32).file_id::u32; }
    project.dnit_project(?p);
    if (module.is_nil(a_mid) || owned(?s, "uniontest.a") == 0 || keyed(?s, "uniontest.a") == 0) { ret 4; }
    if (query.owned_len(?s.queries, query.KEY_FILE, a_file) == 0)                               { ret 5; }

    # the import goes: nothing of the module stays
    if (!retained_build(?alloc, ?s, root, ""))                          { ret 6; }
    if (owned(?s, "uniontest.a") != 0 || keyed(?s, "uniontest.a") != 0) { ret 7; }
    if (query.owned_len(?s.queries, query.KEY_FILE, a_file) != 0)       { ret 8; }
    if (owned(?s, "uniontest.main") == 0)                               { ret 9; }
    if (retention.held_count(?s.retention) != 1)                        { ret 10; }

    # it comes back: resolve computes it again, beside the edited main, rather than finding a stale product
    val back_text: res[str, fail.Fail] = retained_main(?alloc, "a");
    if (sel back_text.err)                                      { ret 20; }
    if (!write_source(?alloc, root, "main.mach", back_text.ok)) { ret 11; }
    val resolved: u64                             = query.computes(?s.queries, ?frontend.RESOLVE);
    val back:     res[project.Project, fail.Fail] = gate_rebuild(?s, root);
    if (sel back.err) { ret 12; }
    p = back.ok;
    var bad: i32 = 0;
    if (query.computes(?s.queries, ?frontend.RESOLVE) - resolved < 2) { bad = 13; }
    if (module.is_nil(project.module_named(?p, "uniontest.a")))       { bad = 14; }
    project.dnit_project(?p);
    if (bad != 0)                      { ret bad; }
    if (owned(?s, "uniontest.a") == 0) { ret 15; }

    # alternating imports hold the session at one size once every module has been seen
    var picks:    [3]str = [3]str{"b", "c", "a"};
    var baseline: u32    = 0;
    var round:    u32    = 0;
    for (round < 12) {
        if (!retained_build(?alloc, ?s, root, picks[round % 3])) { ret 16; }
        if (!retained_build(?alloc, ?s, root, ""))               { ret 17; }
        val products: u32 = products(?s);
        if (round == 3)                                                                                      { baseline = products; }
        if (round > 3 && products != baseline)                                                               { ret 18; }
        if (owned(?s, "uniontest.a") != 0 || owned(?s, "uniontest.b") != 0 || owned(?s, "uniontest.c") != 0) { ret 19; }
        round = round + 1;
    }
    ret 0;
}

test retention__a_run_of_rejected_loads_holds_what_the_first_one_held {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    # each keystroke of an import names a module that exists, and a later import that does not rejects the load
    var typed: [15]str = [15]str{"p", "pa", "pac", "pack", "packa", "packag", "package", "package_", "package_m",
        "package_ma", "package_man", "package_mani", "package_manif", "package_manife", "package_manifes"};
    var names: [17]str;
    var texts: [17]str;
    names[0] = "main.mach";
    texts[0] = "use uniontest.a;\nfun main() i32 { ret a.f(); }\n";
    names[1] = "a.mach";
    texts[1] = "pub fun f() i32 { ret 1; }\n";
    var k: u32 = 0;
    for (k < 15) {
        val named: res[str, fail.Fail] = fail.join(?alloc, typed[k], ".mach");
        if (sel named.err) { ret 10; }
        names[k + 2] = named.ok;
        texts[k + 2] = "pub fun f() i32 { ret 2; }\n";
        k            = k + 1;
    }
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = gate_session(?alloc, ?names[0], ?texts[0], 17, ?s);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
    }
    if (!retained_build(?alloc, ?s, root, "a")) { ret 3; }

    var first: usize = 0;
    k = 0;
    for (k < 15) {
        val used: res[str, fail.Fail] = fail.join(?alloc, "use uniontest.", typed[k], ";\nuse uniontest.nope;\nfun main() i32 { ret 0; }\n");
        if (sel used.err)                                      { ret 13; }
        if (!write_source(?alloc, root, "main.mach", used.ok)) { ret 4; }
        val built: res[project.Project, fail.Fail] = gate_rebuild(?s, root);
        if (sel built.ok) {
            var p:      project.Project  = built.ok;
            val status: fail.PhaseStatus = frontend.frontend_status(?p);
            project.dnit_project(?p);
            if (sel status.kind.accepted) { ret 5; }
        }
        val fqn: res[str, fail.Fail] = fail.join(?alloc, "uniontest.", typed[k]);
        if (sel fqn.err)       { ret 12; }
        if (!held(?s, fqn.ok)) { ret 6; }
        if (k == 0)            { first = retention.held_count(?s.retention); }
        k = k + 1;
    }
    if (first == 0 || retention.held_count(?s.retention) != first) { ret 7; }
    # the last accepted build's modules stay, an earlier rejection's go
    if (owned(?s, "uniontest.a") == 0)                                     { ret 8; }
    if (held(?s, "uniontest.p") || !held(?s, "uniontest.package_manifes")) { ret 9; }
    ret 0;
}

# a loaded project's request changed behind the frozen build context is refused rather than
# read, and the same change announced through reconfigure is read
test context__a_change_after_the_freeze_is_refused_unless_reconfigured {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names:  [1]str              = [1]str{"main.mach"};
    var texts:  [1]str              = [1]str{"fun main() i32 { ret 0; }\n"};
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = gate_session(?alloc, ?names[0], ?texts[0], 1, ?s);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
    }
    val built: res[project.Project, fail.Fail] = gate_rebuild(?s, root);
    if (sel built.err) { ret 3; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    p.req.debug = !p.req.debug;
    val refused: err[fail.Fail] = run_sema_pass(?p);
    if (sel refused.ok)                                                                           { ret 4; }
    if (!str_equals(fail.describe(refused.err), "the build context changed after it was frozen")) { ret 5; }
    val reconfigured: err[fail.Fail] = reconfigure(?p, p.req);
    if (sel reconfigured.err) { ret 6; }
    val read: err[fail.Fail] = run_sema_pass(?p);
    if (sel read.err) { ret 7; }
    ret 0;
}

# the project at `root` loaded through build_project for the fixture target `target`
#[testing]
fun built_for(s: *session.Session, root: str, target: str) res[project.Project, fail.Fail] {
    var pick: manifest.Selectors = manifest.t_selectors("", target, "");
    ret build_project(s, root, ?pick);
}

# the project at `root` loaded for linux and typed
#[testing]
fun typed_at(s: *session.Session, root: str) res[project.Project, fail.Fail] {
    val built: res[project.Project, fail.Fail] = built_for(s, root, "linux");
    if (sel built.err) { ret built; }
    var p:     project.Project = built.ok;
    val typed: err[fail.Fail]  = run_sema_pass(?p);
    if (sel typed.err) {
        project.dnit_project(?p);
        ret res[project.Project, fail.Fail].err{typed.err};
    }
    ret res[project.Project, fail.Fail].ok{p};
}

test bracket__reinterprets_without_rewriting_the_tree {
    var alloc: A.Allocator;
    page.make(?alloc);
    val initialized: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    var names:    [2]str = [2]str{"main.mach", "lib.mach"};
    var versions: [2]str = [2]str{
        "pub def Key: i64;\npub fun item[T](v: T) T { ret v; }\n",
        "pub val Key: u64 = 0;\nfun identity(v: i64) i64 { ret v; }\npub val item: [1]fun(i64) i64 = [1]fun(i64) i64{identity};\n"
    };
    var texts: [2]str = [2]str{
        "use uniontest.lib.item;\nuse uniontest.lib.Key;\nfun main() i64 { ret item[Key](3); }\n", versions[0]
    };
    val made: res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel made.err) { ret 4; }
    val root: str = made.ok;
    fin {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
    }
    val joined: res[str, A.Error] = types_path.join(?alloc, root, "src/lib.mach");
    if (sel joined.err) { ret 5; }
    val filename: str = joined.ok;
    fin { str_free(?alloc, filename); }
    var saved: *ast_expr.Expr = nil;
    var count: usize          = 0;
    fin {
        if (saved != nil) { A.deallocate[ast_expr.Expr](?alloc, saved, count); }
    }
    var owner:       *ast.Ast       = nil;
    var incarnation: u64            = 0;
    var selected:    ast_id.ExprId  = ast_id.EXPR_NIL;
    var revision:    query.Revision = 0;
    var round:       u32            = 0;
    for (round < 3) {
        val version: u32             = round % 2;
        val wrote:   err[fs.FsError] = fs.write_bytes(filename, versions[version], str_len(versions[version]), 420);
        if (sel wrote.err) { ret 6; }
        val opened: res[project.Project, fail.Fail] = built_for(?s, root, "linux");
        if (sel opened.err) { ret 7; }
        var p: project.Project = opened.ok;
        fin { project.dnit_project(?p); }
        val mid: session.ModuleId = project.module_named(?p, "uniontest.main");
        if (module.is_nil(mid)) { ret 8; }
        val parsed: *ast.Ast = frontend.syntax(?p, project.module_at(?p, mid::u32));
        if (parsed == nil) { ret 9; }
        val current: query.Revision = query.peek_revision(?s.queries, ?frontend.PARSE, lang_source.file_index(project.module_at(?p, mid::u32).file_id)::u64);
        if (round == 0) {
            owner       = parsed;
            incarnation = parsed.incarnation;
            revision    = current;
            count       = parsed.exprs.len;
            val storage: res[*ast_expr.Expr, A.Error] = A.allocate[ast_expr.Expr](?alloc, count);
            if (sel storage.err) { ret 10; }
            saved = storage.ok;
            memory.copy[ast_expr.Expr](saved, parsed.exprs.data, count);
            var i: usize = 0;
            for (i < count) {
                if (saved[i].kind == ast_expr.EXPR_KIND_CALL && !ast_id.expr_is_nil(saved[i].data.call.index_callee)) {
                    if (!ast_id.expr_is_nil(selected)) { ret 11; }
                    selected = ast_id.expr(i::u32);
                }
                i = i + 1;
            }
            if (ast_id.expr_is_nil(selected) || revision == 0) { ret 12; }
        }
        if (parsed != owner || parsed.incarnation != incarnation || parsed.exprs.len != count || current != revision
            || !memory.equal[ast_expr.Expr](saved, parsed.exprs.data, count)) { ret 13; }
        val typed: err[fail.Fail] = run_sema_pass(?p);
        if (sel typed.err) {
            diagnostic.show(?s.diags);
            ret 14;
        }
        val interpreted: res[ast_expr.Expr, fail.Fail] = resolve.expression(frontend.resolved(?p, project.module_at(?p, mid::u32)), parsed, selected);
        if (sel interpreted.err) { ret 15; }
        val node: ast_expr.Expr = interpreted.ok;
        if (node.kind != ast_expr.EXPR_KIND_CALL || !ast_id.expr_is_nil(node.data.call.index_callee))                                                                   { ret 16; }
        if (version == 0 && (node.data.call.type_args_len != 1 || !ast_id.expr_same(node.data.call.callee, saved[ast_id.expr_index(selected)].data.call.callee)))       { ret 17; }
        if (version == 1 && (node.data.call.type_args_len != 0 || !ast_id.expr_same(node.data.call.callee, saved[ast_id.expr_index(selected)].data.call.index_callee))) { ret 18; }
        val lowered: err[fail.Fail] = run_lower_pass(?p);
        if (sel lowered.err)                                               { ret 19; }
        if (!memory.equal[ast_expr.Expr](saved, parsed.exprs.data, count)) { ret 20; }
        round = round + 1;
    }
    ret 0;
}

# an importer emits instances of another module's generic and comptime-parameter functions from
# the template that module's interface published: with the exporter's own syntax tree wrecked
# after typing, both still lower
test instance__lowers_from_the_exporter_interface_not_its_tree {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [2]str = [2]str{"main.mach", "lib.mach"};
    var texts: [2]str = [2]str{
        "use uniontest.lib;\npub fun f() i64 { ret lib.keep[i64](41); }\npub fun g() i64 { ret lib.scale(3, 14); }\nfun main() i32 { ret 0; }\n",
        "pub fun keep[T](x: T) T { val y: T = x; ret y; }\npub fun scale($k: i64, x: i64) i64 { ret x * k; }\n"
    };
    val built: res[project.Project, fail.Fail] = scaffold_build(?s, ?alloc, fixture_manifest(), ?names[0], ?texts[0], 2, "linux");
    if (sel built.err) { ret 2; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    val typed: err[fail.Fail] = run_sema_pass(?p);
    if (sel typed.err) { ret 3; }

    val lib_mid: session.ModuleId = project.module_named(?p, "uniontest.lib");
    if (module.is_nil(lib_mid)) { ret 4; }
    val lib: *ast.Ast = frontend.syntax(?p, project.module_at(?p, lib_mid::u32));
    if (lib == nil || lib.exprs.len == 0) { ret 5; }
    var i: usize = 0;
    for (i < lib.exprs.len) {
        lib.exprs.data[i].kind = ast_expr.EXPR_KIND_ERROR;
        i                      = i + 1;
    }
    i = 0;
    for (i < lib.stmts.len) {
        lib.stmts.data[i].kind = ast_stmt.STMT_KIND_ERROR;
        i                      = i + 1;
    }

    val lowered: err[fail.Fail] = run_lower_pass(?p);
    if (sel lowered.err) { ret 6; }
    val u: *lower_context.Unit = unit_named(?p, "uniontest.main");
    if (unit_defined_count(?s, u, "keep", false) != 1)  { ret 7; }
    if (unit_defined_count(?s, u, "scale", false) != 1) { ret 8; }
    ret 0;
}

# a same-module global cycle is refused at each global when it is typed, and the rejected
# module leaves no lower query product behind
test global_init__cycle_is_refused_with_no_lower_product {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [1]str                          = [1]str{"main.mach"};
    var texts: [1]str                          = [1]str{"val X: u64 = Y;\nval Y: u64 = X;\nfun main() i32 { ret 0; }\n"};
    val built: res[project.Project, fail.Fail] = scaffold_build(?s, ?alloc, fixture_manifest(), ?names[0], ?texts[0], 1, "linux");
    if (sel built.err) { ret 2; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    val typed: err[fail.Fail] = run_sema_pass(?p);
    if (sel typed.ok)                 { ret 3; }
    if (!fail.is_reported(typed.err)) { ret 3; }
    val lowered: err[fail.Fail] = run_lower_pass(?p);
    if (sel lowered.ok)                                                                              { ret 4; }
    if (!fail.is_reported(lowered.err))                                                              { ret 5; }
    if (diagnostic.error_count(?s.diags) != 2)                                                       { ret 6; }
    if (!diagnostic.error_says(?s.diags, "global initialiser of `X` must be a constant expression")) { ret 7; }
    if (!diagnostic.error_says(?s.diags, "global initialiser of `Y` must be a constant expression")) { ret 8; }
    val mid: session.ModuleId = project.module_named(?p, "uniontest.main");
    if (module.is_nil(mid) || project.module_at(?p, mid::u32).unit != nil) { ret 9; }
    val stable: session.StableModuleId          = project.stable_named(?p, "uniontest.main");
    val begun:  res[query.Operation, fail.Fail] = frontend.begin_query_phase(?p);
    if (sel begun.err) { ret 10; }
    val operation: query.Operation                 = begun.ok;
    val acquired:  res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, ?p, ?passes.LOWER, passes.back_half_key(stable, false));
    val ended:     err[fail.Fail]                  = query.end(?s.queries, operation);
    val discarded: err[fail.Fail]                  = query.discard(?s.queries, operation);
    if (sel acquired.ok)                             { ret 11; }
    if (!fail.is_reported(acquired.err))             { ret 12; }
    if (sel ended.ok)                                { ret 13; }
    if (!fail.is_reported(ended.err))                { ret 14; }
    if (sel discarded.err)                           { ret 15; }
    if (project.module_at(?p, mid::u32).unit != nil) { ret 16; }
    ret 0;
}

# zero when typing the project of `main_src` beside the asset `asset` is refused with an
# error that says `needle`
#[testing]
fun embed_refused(main_src: str, asset: str, needle: str) i32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [2]str              = [2]str{"main.mach", "asset.bin"};
    var texts: [2]str              = [2]str{main_src, asset};
    val made:  res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel made.err) { ret 2; }
    fin { fs.remove_all(?alloc, made.ok); }
    val typed: res[project.Project, fail.Fail] = typed_at(?s, made.ok);
    if (sel typed.ok) {
        var p: project.Project = typed.ok;
        project.dnit_project(?p);
        ret 3;
    }
    if (!fail.is_reported(typed.err) || !diagnostic.error_says(?s.diags, needle)) { ret 4; }
    ret 0;
}

#[testing]
rec EmbedRefusal {
    main:   str;
    needle: str;
}

# each embed refusal: the size against the annotation, a missing file and a directory, the
# declaration kind and annotation, the decorator's arguments, and a `[_]` outside an embed
#[testing]
val EMBED_REFUSALS: [13]EmbedRefusal = [13]EmbedRefusal{
    EmbedRefusal{main: "#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { val b: [9]u8 = A; ret b[0]::i32; }\n", needle: "found [3]u8"},
    EmbedRefusal{main: "#[embed(\"asset.bin\")]\nval A: [4]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "declares 4 bytes but the file holds 3"},
    EmbedRefusal{main: "#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "`embed` on `A` cannot read"},
    EmbedRefusal{main: "#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "no such file or directory"},
    EmbedRefusal{main: "#[embed(\".\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "is a directory"},
    EmbedRefusal{main: "#[embed(\"asset.bin\")]\nvar A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "applies only to a `val`"},
    EmbedRefusal{main: "#[embed(\"asset.bin\")]\nval A: [_]u32;\nfun main() i32 { ret 0; }\n", needle: "element type must be `u8`"},
    EmbedRefusal{main: "#[embed(\"asset.bin\")]\nval A: u8;\nfun main() i32 { ret A::i32; }\n", needle: "must be annotated `[_]u8` or `[N]u8`"},
    EmbedRefusal{main: "#[embed()]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "takes one string argument"},
    EmbedRefusal{main: "#[embed(\"asset.bin\")]\nfun f() i32 { ret 0; }\nfun main() i32 { ret f(); }\n", needle: "applies only to a `val`"},
    EmbedRefusal{main: "#[embed(\"asset.bin\")]\n#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", needle: "only one `embed` decorator"},
    EmbedRefusal{main: "val B: [1]u8 = [1]u8{1};\nval A: [_]u8 = B;\nfun main() i32 { ret A[0]::i32; }\n", needle: "needs an array literal initializer"},
    EmbedRefusal{main: "#[embed(\"asset.bin\")]\nval A: [_][_]u8;\nfun main() i32 { ret 0; }\n", needle: "element type must be `u8`"}
};

test embed__refusals {
    var i: usize = 0;
    for (i < $length_of(EMBED_REFUSALS)) {
        if (embed_refused(EMBED_REFUSALS[i].main, "abc", EMBED_REFUSALS[i].needle) != 0) { ret (i + 1)::i32; }
        i = i + 1;
    }
    ret 0;
}

$if ($mach.build.os == $mach.os.linux) {
    # an asset the build cannot read is refused with the reason the system gives
    test embed__unreadable_asset_is_refused {
        var alloc: A.Allocator;
        page.make(?alloc);
        val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
        if (sel sr.err) { ret 1; }
        var s: session.Session = sr.ok;
        fin { session.dnit(?s); }
        var names: [2]str              = [2]str{"main.mach", "asset.bin"};
        var texts: [2]str              = [2]str{"#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret 0; }\n", "abc"};
        val made:  res[str, fail.Fail] = scaffold(?alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
        if (sel made.err) { ret 2; }
        val root: str = made.ok;
        fin { fs.remove_all(?alloc, root); }
        val asset: res[str, A.Error] = types_path.join(?alloc, root, "src/asset.bin");
        if (sel asset.err) { ret 3; }
        val removed: err[io_error.Error] = fs.remove_file(asset.ok);
        if (sel removed.err) { ret 4; }
        val wrote: err[fs.FsError] = fs.write_bytes(asset.ok, "abc", 3, 0);
        if (sel wrote.err) { ret 5; }
        val typed: res[project.Project, fail.Fail] = typed_at(?s, root);
        if (sel typed.ok) {
            var p: project.Project = typed.ok;
            project.dnit_project(?p);
            ret 6;
        }
        if (!fail.is_reported(typed.err) || !diagnostic.error_says(?s.diags, "permission denied")) { ret 7; }
        ret 0;
    }
}

# a malformed embed annotation is reported once, never again as a `[_]` outside an embed,
# while a `[_]` local beside a failed embed still is
test embed__rejection_does_not_cascade {
    val needle: str = "an inferred array length `[_]`";
    if (embed_refused("#[embed(\"asset.bin\")]\nval A: [_][_]u8;\nfun main() i32 { ret 0; }\n", "abc", needle) == 0)           { ret 1; }
    if (embed_refused("#[embed(\"asset.bin\")]\nval A: *[_]u8;\nfun main() i32 { ret 0; }\n", "abc", needle) == 0)             { ret 2; }
    if (embed_refused("#[embed(\"asset.bin\")]\nval A: [3][_]u8;\nfun main() i32 { ret 0; }\n", "abc", needle) == 0)           { ret 3; }
    if (embed_refused("#[embed(\"nope.bin\")]\nval A: [_]u8;\nfun main() i32 { var q: [_]u8; ret 0; }\n", "abc", needle) != 0) { ret 4; }
    ret 0;
}

# zero when an embed of the project's own asset types clean, or, `escaped`, when one naming
# a file beside the project root is refused at the decorator with the file never read
#[testing]
fun embed_escape_arm(alloc: *A.Allocator, escaped: bool) i32 {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [2]str              = [2]str{"main.mach", "asset.bin"};
    var texts: [2]str              = [2]str{"#[embed(\"asset.bin\")]\nval A: [_]u8;\nfun main() i32 { ret A[0]::i32; }\n", "abc"};
    val made:  res[str, fail.Fail] = scaffold(alloc, fixture_manifest(), ?names[0], ?texts[0], 2);
    if (sel made.err) { ret 2; }
    val root: str = made.ok;
    fin { fs.remove_all(alloc, root); }
    val beside: res[str, std_format.FormatError] = std_format.sprint(alloc, "{}-outside.bin", root);
    if (sel beside.err) { ret 3; }
    val outside: str = beside.ok;
    if (escaped) {
        val main_path: res[str, A.Error] = types_path.join(alloc, root, "src/main.mach");
        if (sel main_path.err) { ret 4; }
        val spelled: res[str, std_format.FormatError] = std_format.sprint(alloc, "#[embed(\"../../{}\")]\nval A: [_]u8;\nfun main() i32 {{ ret A[0]::i32; }}\n", types_path.filename(outside));
        if (sel spelled.err) { ret 5; }
        val wrote: err[fs.FsError] = fs.write_bytes(main_path.ok, spelled.ok, str_len(spelled.ok), 420);
        if (sel wrote.err) { ret 6; }
        val planted: err[fs.FsError] = fs.write_bytes(outside, "xyz", 3, 420);
        if (sel planted.err) { ret 7; }
    }
    fin {
        if (escaped) { fs.remove_file(outside); }
    }

    val typed: res[project.Project, fail.Fail] = typed_at(?s, root);
    if (sel typed.ok) {
        var p:      project.Project = typed.ok;
        val errors: bool            = diagnostic.has_errors(?s.diags);
        project.dnit_project(?p);
        if (escaped) { ret 8; }
        if (errors)  { ret 9; }
        ret 0;
    }
    if (!escaped)                                                                                  { ret 10; }
    if (!diagnostic.error_says(?s.diags, "`embed` path escapes the project root"))                 { ret 11; }
    if (!diagnostic.error_says(?s.diags, "must live inside the project and the file is not read")) { ret 12; }
    val outside_id: res[intern.StrId, A.Error] = intern.add(?s.interner, outside);
    if (sel outside_id.ok) {
        val cached: opt[*session_embed.EmbedFile] = session_embed.get(?s.embeds, outside_id.ok);
        if (sel cached.some) { ret 13; }
    }
    ret 0;
}

# an embed outside the project root is a refusal that never reads the file
test embed__outside_the_project_root_is_refused_unread {
    var alloc: A.Allocator;
    page.make(?alloc);
    val escaped: i32 = embed_escape_arm(?alloc, true);
    if (escaped != 0) { ret 100 + escaped; }
    val inside: i32 = embed_escape_arm(?alloc, false);
    if (inside != 0) { ret 200 + inside; }
    ret 0;
}

# an arm a comptime gate takes declares the same import as the arm it does not, so the
# import still conflicts with another module's import of that name from another library
test comptime_arm__does_not_mask_a_cross_module_import_conflict {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [3]str = [3]str{"main.mach", "a.mach", "b.mach"};
    var texts: [3]str = [3]str{
        "use uniontest.a;\nuse uniontest.b;\nfun main() i32 { a.call(); b.call(); ret 0; }\n",
        "$if ($mach.build.os == $mach.os.windows) {\n    #[library(\"kernel32\")]\n    ext fun cx_probe();\n}\n$or {\n    #[library(\"kernel32\")]\n    ext fun cx_probe();\n}\n\npub fun call() { cx_probe(); }\n",
        "#[library(\"user32\")]\next fun cx_probe();\npub fun call() { cx_probe(); }\n"
    };
    val built: res[project.Project, fail.Fail] = scaffold_build(?s, ?alloc, fixture_manifest(), ?names[0], ?texts[0], 3, "windows");
    if (sel built.err) { ret 2; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    # the conflict is refused by whichever phase meets it first
    var refused: err[fail.Fail] = run_sema_pass(?p);
    val typed:   bool           = sel refused.ok;
    if (typed)          { refused = run_lower_pass(?p); }
    if (sel refused.ok) { ret 3; }
    val message: str = fail.describe(refused.err);
    if (!str_contains(message, "import 'cx_probe'")) { ret 4; }
    if (!str_contains(message, "'kernel32'"))        { ret 5; }
    if (!str_contains(message, "'user32'"))          { ret 6; }
    if (!str_contains(message, "uniontest.a"))       { ret 7; }
    if (!str_contains(message, "uniontest.b"))       { ret 8; }
    ret 0;
}

# a manifest for a test's shader project: the bin `uniontest`, its entry `main.mach`, on the
# logical spirv target
#[testing]
val SPIRV_MANIFEST: str = "[project]\nmach = \">=5\"\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.spirv]\nisa = \"spirv\"\nos = \"vulkan\"\nabi = \"spirv\"\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/uniontest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n";

# zero when sema over the entry of a shader project of `text` either reports or fails at every
# allocation it refuses, never accepting the module silently
#[testing]
fun spirv_alloc_sweep(text: str) i32 {
    var backing: A.Allocator;
    page.make(?backing);
    var t:      T.Testing;
    val made_t: err[A.Error] = T.make(?t);
    if (sel made_t.err) { ret 1; }
    fin { T.dnit(?t); }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?backing);
    if (sel sr.err) { ret 2; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [1]str                          = [1]str{"main.mach"};
    var texts: [1]str                          = [1]str{text};
    val built: res[project.Project, fail.Fail] = scaffold_build(?s, ?backing, SPIRV_MANIFEST, ?names[0], ?texts[0], 1, "spirv");
    if (sel built.err) { ret 3; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    val mid: session.ModuleId = project.module_named(?p, "uniontest.main");
    if (module.is_nil(mid)) { ret 4; }
    val m:    *project.ModuleEntry = project.module_at(?p, mid::u32);
    var deps: fe_sema.SemaDeps     = fe_sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    val real_alloc: *A.Allocator = s.alloc;
    s.alloc = T.allocator_of(?t);
    val pre0: usize                              = diagnostic.len(?s.diags);
    val r0:   res[fe_sema.SemaResult, fail.Fail] = fe_sema.sema(?s, frontend.syntax(?p, m), frontend.resolved(?p, m), ?deps, ?m.load.ctx, mid, ?s.diags);
    if (sel r0.ok) {
        var first: fe_sema.SemaResult = r0.ok;
        fe_sema.result_dnit(?first);
    }
    s.alloc = real_alloc;
    val total: u32 = T.attempt_count(?t)::u32;
    if (T.attempt_count(?t) - T.refused_count(?t) - T.total_count(?t) != 0) {
        print.print("APPARATUS: the backing allocator failed during the baseline run; the sweep cannot tell a real failure from the injected one\n");
        ret 5;
    }
    if (total == 0) {
        print.print("APPARATUS: the baseline run made no allocations\n");
        ret 6;
    }
    if (diagnostic.len(?s.diags) == pre0) {
        print.print("APPARATUS: the baseline run reported nothing, so the fixture proves nothing\n");
        ret 7;
    }

    var bad:     i32 = 0;
    var fail_at: u32 = 1;
    for (fail_at <= total) {
        T.fail_at_ordinal(?t, T.attempt_count(?t) + fail_at::usize);
        # each run reports into its own store: the session's store keeps one copy
        # of a report, so a repeat run would add nothing to it
        var run: diagnostic.DiagnosticStore = diagnostic.store_init(real_alloc);
        s.alloc = T.allocator_of(?t);
        val r:        res[fe_sema.SemaResult, fail.Fail] = fe_sema.sema(?s, frontend.syntax(?p, m), frontend.resolved(?p, m), ?deps, ?m.load.ctx, mid, ?run);
        val accepted: bool                               = sel r.ok;
        if (sel r.ok) {
            var result: fe_sema.SemaResult = r.ok;
            fe_sema.result_dnit(?result);
        }
        s.alloc = real_alloc;
        T.clear_failure(?t);
        if (T.attempt_count(?t) - T.refused_count(?t) - T.total_count(?t) != 0) {
            bad = 8;
            print.print("APPARATUS: the backing allocator failed at fail_at=");
            print.u64(fail_at::u64);
            print.print("; this is memory pressure, not a skipped check\n");
        }
        or (accepted && diagnostic.len(?run) == 0) {
            bad = 9;
            print.print("SKIPPED CHECK at fail_at=");
            print.u64(fail_at::u64);
            print.print("\n");
        }
        diagnostic.store_dnit(?run);
        fail_at = fail_at + 1;
    }
    ret bad;
}

# an `op` declaration's refusals survive an allocation failure while the message is
# built: the operand-relation, the texel-count and the data-type refusal each either
# report or fail the phase, never accept the declaration
test alloc_failure__op_refusals_never_accept {
    if (spirv_alloc_sweep("#[handle(\"spirv\", \"image\", 2, 1, 0, 0, 0, 2, 33)]\npub def UImage2D;\n#[op(\"spirv\", \"core\", \"OpImageWrite\")] fun bad(img: UImage2D, at: i32x2, texel: f32x4);\n") != 0) { ret 1; }
    if (spirv_alloc_sweep("#[handle(\"spirv\", \"image\", 2, 1, 0, 0, 0, 2, 33)]\npub def UImage2D;\n#[op(\"spirv\", \"core\", \"OpImageRead\")] fun bad(img: UImage2D, at: i32x2) u32x2;\n") != 0)          { ret 2; }
    if (spirv_alloc_sweep("#[op(\"spirv\", \"core\", \"OpAtomicIAdd\")] fun bad(p: *f32, scope: u32, sem: u32, v: f32) f32;\n") != 0)                                                                        { ret 3; }
    ret 0;
}

# a test build loads the selected artifact's closure only: the modules only another
# target's artifact reaches are never loaded, and a module both reach is compiled here
test test_goal__leaves_out_another_targets_modules {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 2; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val mtext: str    = "[project]\nmach = \">=5\"\nid = \"split\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.gpu]\nisa = \"spirv\"\nos = \"vulkan\"\nabi = \"spirv\"\n\n[profile.debug]\ndefault = true\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.app]\nkind = \"static\"\nentry = \"main.mach\"\nout = \"{project.work}/lib/app\"\ntargets = [\"host\"]\nlink = []\nneed = []\n\n[artifact.shader]\nkind = \"bin\"\nentry = \"frag.mach\"\nout = \"{project.work}/spv/frag.spv\"\ntargets = [\"gpu\"]\nlink = []\nneed = []\n";
    var names: [4]str = [4]str{"main.mach", "frag.mach", "shaderlib.mach", "shared.mach"};
    var texts: [4]str = [4]str{
        "use split.shared;\n\ntest host { ret 0; }\n",
        "use split.shaderlib;\nuse split.shared;\n\n#[output(0)] var out_colour: f32x4;\n\n#[stage(\"fragment\")]\nfun frag_main() { out_colour = shaderlib.tint(shared.gain()); }\n",
        "pub fun tint(v: f32) f32x4 { ret f32x4{v, v, v, 1.0}; }\n",
        "pub fun gain() f32 { ret 0.5; }\n"
    };
    val root_r: res[str, fail.Fail] = scaffold(?alloc, mtext, ?names[0], ?texts[0], 4);
    if (sel root_r.err) { ret 3; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    var req: request.BuildRequest = request.defaults();
    req.project_root = root;
    req.target       = "host";
    req.artifact     = "app";
    req.goal         = request.GOAL_TESTS;
    val pr: res[project.Project, fail.Fail] = begin_loaded(?s, ?req);
    if (sel pr.err) { ret 4; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    # the shader artifact's own modules belong to the gpu target
    if (project.loads(?p, "split.frag"))      { ret 5; }
    if (project.loads(?p, "split.shaderlib")) { ret 6; }
    # a module both artifacts reach is this build's
    if (!project.in_topo(?p, "split.shared")) { ret 7; }
    if (!project.in_topo(?p, "split.main"))   { ret 8; }
    val se: err[fail.Fail] = run_sema_pass(?p);
    if (sel se.err)                              { ret 9; }
    if (diagnostic.error_count(?p.s.diags) != 0) { ret 10; }
    ret 0;
}

