use du: std.chrono.duration;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

# the accepted forms of a duration, for error messages
pub val FORMS: str = "<n>ms, <n>s, <n>m or <n>h, with n a positive integer";

# parse a duration: a positive decimal integer followed by one of the
# units ms, s, m or h
# ---
# s:   the argument
# ret: the duration; none when s is malformed, zero, or overflows
pub fun parse(s: *u8) opt[du.Duration] {
    if (s == nil) { ret opt[du.Duration].none{}; }
    val max: i64   = 9223372036854775807;
    var v:   i64   = 0;
    var i:   usize = 0;
    for (s[i] >= '0' && s[i] <= '9') {
        val d: i64 = (s[i] - '0')::i64;
        if (v > (max - d) / 10) { ret opt[du.Duration].none{}; }
        v = v * 10 + d;
        i = i + 1;
    }
    if (i == 0 || v == 0) { ret opt[du.Duration].none{}; }
    val unit: str         = (?s[i])::str;
    var per:  du.Duration = 0;
    if (str_equals(unit, "ms")) { per = du.MILLISECOND; }
    or (str_equals(unit, "s"))  { per = du.SECOND; }
    or (str_equals(unit, "m"))  { per = du.MINUTE; }
    or (str_equals(unit, "h"))  { per = du.HOUR; }
    or                          { ret opt[du.Duration].none{}; }
    if (v > max / per)          { ret opt[du.Duration].none{}; }
    ret opt[du.Duration].some{per * v};
}

# a duration in the largest unit of parse's that divides it exactly
# n:    the count
# unit: "h", "m", "s" or "ms"; "ns" when d is not a whole number of milliseconds
pub rec Text {
    n:    i64;
    unit: str;
}

# render d in the form parse reads back
# ---
# d:   the duration
# ret: the count and its unit
pub fun text(d: du.Duration) Text {
    if (d != 0 && d % du.HOUR == 0)        { ret Text{n: (d / du.HOUR)::i64, unit: "h"}; }
    if (d != 0 && d % du.MINUTE == 0)      { ret Text{n: (d / du.MINUTE)::i64, unit: "m"}; }
    if (d != 0 && d % du.SECOND == 0)      { ret Text{n: (d / du.SECOND)::i64, unit: "s"}; }
    if (d != 0 && d % du.MILLISECOND == 0) { ret Text{n: (d / du.MILLISECOND)::i64, unit: "ms"}; }
    ret Text{n: d::i64, unit: "ns"};
}

#[testing]
fun t_duration(o: opt[du.Duration]) du.Duration {
    if (sel o.some) { ret o.some; }
    ret 0;
}

test parse__reads_each_unit {
    if (t_duration(parse("30ms")) != du.MILLISECOND * 30) { ret 1; }
    if (t_duration(parse("30s")) != du.SECOND * 30)       { ret 2; }
    if (t_duration(parse("5m")) != du.MINUTE * 5)         { ret 3; }
    if (t_duration(parse("1h")) != du.HOUR)               { ret 4; }
    val t: Text = text(du.MILLISECOND * 1500);
    if (t.n != 1500 || !str_equals(t.unit, "ms")) { ret 5; }
    val u: Text = text(du.MINUTE * 90);
    if (u.n != 90 || !str_equals(u.unit, "m")) { ret 6; }
    ret 0;
}

test parse__refuses_malformed_values {
    if (t_duration(parse("30")) != 0)                    { ret 1; }
    if (t_duration(parse("0s")) != 0)                    { ret 2; }
    if (t_duration(parse("s")) != 0)                     { ret 3; }
    if (t_duration(parse("")) != 0)                      { ret 4; }
    if (t_duration(parse("-5s")) != 0)                   { ret 5; }
    if (t_duration(parse("1.5s")) != 0)                  { ret 6; }
    if (t_duration(parse("5 m")) != 0)                   { ret 7; }
    if (t_duration(parse("5d")) != 0)                    { ret 8; }
    if (t_duration(parse("9999999999999h")) != 0)        { ret 9; }
    if (t_duration(parse("99999999999999999999s")) != 0) { ret 10; }
    ret 0;
}
