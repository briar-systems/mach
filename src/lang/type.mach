pub def TypeId:     u32;
pub val TYPE_NIL:   TypeId = 0xFFFFFFFF;
pub val TYPE_ERROR: TypeId = 0xFFFFFFFE;

pub def TypeKind: u8;

pub val TYPE_U8:    TypeKind = 0;
pub val TYPE_U16:   TypeKind = 1;
pub val TYPE_U32:   TypeKind = 2;
pub val TYPE_U64:   TypeKind = 3;
pub val TYPE_I8:    TypeKind = 4;
pub val TYPE_I16:   TypeKind = 5;
pub val TYPE_I32:   TypeKind = 6;
pub val TYPE_I64:   TypeKind = 7;
pub val TYPE_F32:   TypeKind = 8;
pub val TYPE_F64:   TypeKind = 9;
pub val TYPE_PTR:   TypeKind = 10;
pub val PRIM_COUNT: u32      = 11;

pub val TYPE_POINTER:       TypeKind = 11;
pub val TYPE_ARRAY:         TypeKind = 12;
pub val TYPE_FUN:           TypeKind = 13;
pub val TYPE_REC:           TypeKind = 14;
pub val TYPE_UNI:           TypeKind = 15;
pub val TYPE_GENERIC_PARAM: TypeKind = 16;
pub val TYPE_INSTANCE:      TypeKind = 17;

pub val TYPE_PACK: TypeKind = 18;

pub val TYPE_SECRET: TypeKind = 19;

pub val TYPE_VECTOR: TypeKind = 20;

pub val VEC_COUNT: u32 = 10;

pub val TYPE_HANDLE: TypeKind = 21;

pub val TYPE_ABI: TypeKind = 22;

pub val TYPE_TAG: TypeKind = 23;

pub val TYPE_CASE_SELECTOR: TypeKind = 24;

pub def PrimClass: u8;

pub val PRIM_CLASS_NONE:  PrimClass = 0;
pub val PRIM_CLASS_INT:   PrimClass = 1;
pub val PRIM_CLASS_FLOAT: PrimClass = 2;
pub val PRIM_CLASS_PTR:   PrimClass = 3;

pub rec PrimDesc {
    class:  PrimClass;
    signed: bool;
    bits:   u32;
}

rec PrimSpec {
    kind:     TypeKind;
    spelling: str;
    len:      usize;
    class:    PrimClass;
    signed:   bool;
    bits:     u32;
}

val PRIM_CATALOG: [PRIM_COUNT]PrimSpec = [PRIM_COUNT]PrimSpec{
    PrimSpec{ kind: TYPE_U8,  spelling: "u8",  len: 2, class: PRIM_CLASS_INT,   signed: false, bits: 8  },
    PrimSpec{ kind: TYPE_U16, spelling: "u16", len: 3, class: PRIM_CLASS_INT,   signed: false, bits: 16 },
    PrimSpec{ kind: TYPE_U32, spelling: "u32", len: 3, class: PRIM_CLASS_INT,   signed: false, bits: 32 },
    PrimSpec{ kind: TYPE_U64, spelling: "u64", len: 3, class: PRIM_CLASS_INT,   signed: false, bits: 64 },
    PrimSpec{ kind: TYPE_I8,  spelling: "i8",  len: 2, class: PRIM_CLASS_INT,   signed: true,  bits: 8  },
    PrimSpec{ kind: TYPE_I16, spelling: "i16", len: 3, class: PRIM_CLASS_INT,   signed: true,  bits: 16 },
    PrimSpec{ kind: TYPE_I32, spelling: "i32", len: 3, class: PRIM_CLASS_INT,   signed: true,  bits: 32 },
    PrimSpec{ kind: TYPE_I64, spelling: "i64", len: 3, class: PRIM_CLASS_INT,   signed: true,  bits: 64 },
    PrimSpec{ kind: TYPE_F32, spelling: "f32", len: 3, class: PRIM_CLASS_FLOAT, signed: false, bits: 32 },
    PrimSpec{ kind: TYPE_F64, spelling: "f64", len: 3, class: PRIM_CLASS_FLOAT, signed: false, bits: 64 },
    PrimSpec{ kind: TYPE_PTR, spelling: "ptr", len: 3, class: PRIM_CLASS_PTR,   signed: false, bits: 0  },
};

fun prim_spec(kind: TypeKind) *PrimSpec {
    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        if (PRIM_CATALOG[i].kind == kind) { ret ?PRIM_CATALOG[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun prim_desc(kind: TypeKind) PrimDesc {
    val spec: *PrimSpec = prim_spec(kind);
    var d: PrimDesc;
    if (spec == nil) {
        d.class  = PRIM_CLASS_NONE;
        d.signed = false;
        d.bits   = 0;
        ret d;
    }
    d.class  = spec.class;
    d.signed = spec.signed;
    d.bits   = spec.bits;
    ret d;
}

pub rec TypePointer {
    base: TypeId;
}

pub rec TypeSecret {
    base: TypeId;
}

pub rec TypeVector {
    element: TypeKind;
    lanes:   u32;
}

pub rec TypeHandle {
    name:      intern.StrId;
    ctor:      u32;
    ops_start: u32;
    ops_len:   u32;
}

pub rec TypeAbi {
    name:  intern.StrId;
    tag:   u32;
    size:  u32;
    align: u32;
}

pub val ABI_TYPE_VA_LIST: u32 = 0;

pub rec VecShape {
    name:    str;
    element: TypeKind;
    lanes:   u32;
}

pub fun vec_shape(index: u32) VecShape {
    var s: VecShape;
    s.name    = nil;
    s.element = TYPE_U8;
    s.lanes   = 0;

    if      (index == 0) { s.name = "f32x4"; s.element = TYPE_F32; s.lanes = 4;  }
    or (index == 1) { s.name = "f64x2"; s.element = TYPE_F64; s.lanes = 2;  }
    or (index == 2) { s.name = "i8x16"; s.element = TYPE_I8;  s.lanes = 16; }
    or (index == 3) { s.name = "i16x8"; s.element = TYPE_I16; s.lanes = 8;  }
    or (index == 4) { s.name = "i32x4"; s.element = TYPE_I32; s.lanes = 4;  }
    or (index == 5) { s.name = "i64x2"; s.element = TYPE_I64; s.lanes = 2;  }
    or (index == 6) { s.name = "u8x16"; s.element = TYPE_U8;  s.lanes = 16; }
    or (index == 7) { s.name = "u16x8"; s.element = TYPE_U16; s.lanes = 8;  }
    or (index == 8) { s.name = "u32x4"; s.element = TYPE_U32; s.lanes = 4;  }
    or (index == 9) { s.name = "u64x2"; s.element = TYPE_U64; s.lanes = 2;  }

    ret s;
}

pub fun prim_name(kind: TypeKind) str {
    val spec: *PrimSpec = prim_spec(kind);
    if (spec == nil) { ret nil; }
    ret spec.spelling;
}

pub fun prim_spelling_len(kind: TypeKind) usize {
    val spec: *PrimSpec = prim_spec(kind);
    if (spec == nil) { ret 0; }
    ret spec.len;
}

pub fun prim_from_name(name: str) opt[TypeKind] {
    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        if (str_equals(PRIM_CATALOG[i].spelling, name)) { ret opt[TypeKind].some{PRIM_CATALOG[i].kind}; }
        i = i + 1;
    }
    ret opt[TypeKind].none{};
}

pub fun prim_from_view(name: View) opt[TypeKind] {
    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        if (view_eq_str(name, PRIM_CATALOG[i].spelling)) { ret opt[TypeKind].some{PRIM_CATALOG[i].kind}; }
        i = i + 1;
    }
    ret opt[TypeKind].none{};
}

pub rec IntRange {
    min_negated: bool;
    min_mag:     u64;
    max_mag:     u64;
}

pub fun int_range(kind: TypeKind) opt[IntRange] {
    val d: PrimDesc = prim_desc(kind);
    if (d.class != PRIM_CLASS_INT) { ret opt[IntRange].none{}; }

    var r: IntRange;
    if (d.signed) {
        r.min_negated = true;
        r.min_mag     = 1::u64 << (d.bits - 1)::usize;
        r.max_mag     = (1::u64 << (d.bits - 1)::usize) - 1;
        ret opt[IntRange].some{r};
    }
    r.min_negated = false;
    r.min_mag     = 0;
    if (d.bits >= 64) { r.max_mag = 0::u64 - 1; }
    or                { r.max_mag = (1::u64 << d.bits::usize) - 1; }
    ret opt[IntRange].some{r};
}

pub fun int_fits(value: u64, negated: bool, r: IntRange) bool {
    if (negated) {
        if (!r.min_negated) { ret false; }
        ret value <= r.min_mag;
    }
    ret value <= r.max_mag;
}

pub fun int_fits_either_sign(value: u64, kind: TypeKind) bool {
    val found: opt[IntRange] = int_range(kind);
    if (!sel found.some) { ret true; }
    val r: IntRange = found.some;
    ret int_fits(value, false, r) || int_fits(value, true, r);
}

pub fun float_width_of(kind: TypeKind) float.FloatWidth {
    if (kind == TYPE_F32) { ret float.FLOAT_W_32; }
    if (kind == TYPE_F64) { ret float.FLOAT_W_64; }
    ret float.FLOAT_W_NONE;
}

pub def VecFormStatus: u8;

pub val MAX_VEC_LANES: u32 = 65535;

pub val VEC_FORM_NONE:      VecFormStatus = 0;
pub val VEC_FORM_OK:        VecFormStatus = 1;
pub val VEC_FORM_TOO_WIDE:  VecFormStatus = 2;
pub val VEC_FORM_BAD_LANES: VecFormStatus = 3;

pub rec VecForm {
    status:  VecFormStatus;
    element: TypeKind;
    lanes:   u32;
    bits:    u32;
}

pub fun is_vector_spelling(name: str) bool {
    ret vector_form(name).status != VEC_FORM_NONE;
}

pub fun vector_form(name: str) VecForm {
    var f: VecForm;
    f.status  = VEC_FORM_NONE;
    f.element = TYPE_U8;
    f.lanes   = 0;
    f.bits    = 0;

    if (name == nil) { ret f; }
    val n: usize = str_len(name);
    if (n < 4) { ret f; }

    var split: usize = 0;
    for (split < n && name[split] != 'x') { split = split + 1; }
    if (split == 0) { ret f; }
    if (split >= n - 1) { ret f; }

    var element: TypeKind = TYPE_U8;
    var found:   bool     = false;
    var k:       u32      = 0;
    for (k < PRIM_COUNT) {
        val kind: TypeKind = k::u8;
        if (kind != TYPE_PTR && str_region_equals(name, 0, split, prim_name(kind))) {
            element = kind;
            found   = true;
        }
        k = k + 1;
    }
    if (!found) { ret f; }

    if (name[split + 1] == '0') { ret f; }
    var lanes: u64   = 0;
    var i:     usize = split + 1;
    for (i < n) {
        val c: u8 = name[i];
        if (c < '0' || c > '9') { ret f; }
        lanes = lanes * 10 + (c - '0')::u64;
        if (lanes > MAX_VEC_LANES::u64) { lanes = MAX_VEC_LANES::u64 + 1; }
        i = i + 1;
    }

    f.element = element;
    f.lanes   = lanes::u32;
    if (lanes > MAX_VEC_LANES::u64) { f.lanes = MAX_VEC_LANES + 1; }

    if (lanes < 2) { f.status = VEC_FORM_BAD_LANES; ret f; }
    if (lanes > MAX_VEC_LANES::u64) { f.status = VEC_FORM_TOO_WIDE; ret f; }

    f.bits = (prim_desc(element).bits::u64 * lanes)::u32;
    f.status = VEC_FORM_OK;
    ret f;
}

pub rec TypeArray {
    base:  TypeId;
    count: u32;
}

pub rec TypeFun {
    ret_type:     TypeId;
    params_start: u32;
    params_len:   u32;
    c_variadic:   bool;
    next_in_bucket: TypeId;
}

# persistent source identity, independent of the current module registry
pub rec TypeOwner {
    module: module.StableModuleId;
    file: source.FileId;
}

pub rec TypeNominal {
    name: intern.StrId;
    owner: TypeOwner;
    incarnation: u64;
    syntax: intern.StrId;
}

pub rec TypeGenericParam {
    name: intern.StrId;
    owner: TypeOwner;
    owner_name: intern.StrId;
    owner_kind: TypeKind;
    index: u32;
}

pub rec TypeInstance {
    nominal: TypeId;
    args_start: u32;
    args_len: u32;
    next_in_bucket: TypeId;
}

pub rec TypeCaseSelector {
    tag_type: TypeId;
    case_name: intern.StrId;
    case_index: u32;
}

pub rec Type {
    kind: TypeKind;
    data: uni {
        pointer:       TypePointer;
        secret:        TypeSecret;
        array:         TypeArray;
        vector:        TypeVector;
        handle:        TypeHandle;
        abi:           TypeAbi;
        fn:            TypeFun;
        nominal:       TypeNominal;
        generic_param: TypeGenericParam;
        instance:      TypeInstance;
        case_selector: TypeCaseSelector;
    };
}

pub rec FieldEntry {
    name: intern.StrId;
    ty:   TypeId;
    # a tag case's deprecation notice; absent on every record and union field
    deprecation: deprecation.Deprecation;
}

pub rec FieldTable {
    ty:           TypeId;
    fields_start: u32;
    fields_len:   u32;
    epoch:        u32;
}

pub rec TypeInterner {
    a: *A.Allocator;

    types: handle.StableChunks[Type];

    params:     *TypeId;
    params_len: u32;
    params_cap: u32;

    dedup: map.Map[Type, TypeId];

    fun_index:      map.Map[u64, TypeId];
    instance_index: map.Map[u64, TypeId];

    handles:     *TypeId;
    handles_len: u32;
    handles_cap: u32;

    handle_ops:     *u32;
    handle_ops_len: u32;
    handle_ops_cap: u32;

    prims: [PRIM_COUNT]TypeId;

    vecs: [VEC_COUNT]TypeId;

    field_tables: handle.StableChunks[FieldTable];

    field_index: map.Map[TypeId, u32];

    # the declared discriminator type per tag nominal; projection state like the field
    # tables, cleared by every projection reset and re-installed with the case table
    disc_index: map.Map[TypeId, TypeId];

    field_pool: handle.StableChunks[FieldEntry];

    field_epoch: u32;
    # bumped by every projection reset; published tables never change otherwise
    projection_generation: u64;

    visits:     *VisitSet;
    visits_len: u32;
    visits_cap: u32;

    pairs:     *PairSet;
    pairs_len: u32;
    pairs_cap: u32;

    gparam:       *u8;
    gparam_cap:   u32;
    gparam_epoch: u32;
}

val INITIAL_PARAMS_CAP:      u32 = 32;
val INITIAL_INSTANCE_CAP:    u32 = 16;
val INITIAL_VISIT_CAP:       u32 = 64;
val INITIAL_VISIT_DEPTH:     u32 = 4;

fun grow_cap[T](alloc: *A.Allocator, data: **T, cap: *u32, initial: u32) err[A.Error] {
    if (@data == nil) {
        val res_alloc: res[*T, A.Error] = A.allocate[T](alloc, initial::usize);
        if (sel res_alloc.err) { ret err[A.Error].err{res_alloc.err}; }
        @data = res_alloc.ok;
        @cap  = initial;
        ret err[A.Error].ok{};
    }
    val current: layout.CheckedCount[T] = layout.count[T]((@cap)::usize);
    val required_r: R.Result[layout.CheckedCount[T], layout.CheckCause] =
        layout.count_add[T](current, layout.count[T](1::usize));
    if (R.is_err[layout.CheckedCount[T], layout.CheckCause](required_r)) {
        ret err[A.Error].err{A.Error.overflow{}};
    }
    val required: layout.CheckedCount[T] = R.unwrap_ok[layout.CheckedCount[T], layout.CheckCause](required_r);
    val grown_r: R.Result[layout.CheckedCount[T], layout.CheckCause] = layout.count_grow[T](current, required);
    if (R.is_err[layout.CheckedCount[T], layout.CheckCause](grown_r)) {
        ret err[A.Error].err{A.Error.overflow{}};
    }
    val new_cap_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
        R.unwrap_ok[layout.CheckedCount[T], layout.CheckCause](grown_r).value);
    if (R.is_err[u32, layout.CheckCause](new_cap_fits)) {
        ret err[A.Error].err{A.Error.overflow{}};
    }
    val new_cap: u32 = R.unwrap_ok[u32, layout.CheckCause](new_cap_fits);
    val res_realloc: res[*T, A.Error] = A.reallocate[T](alloc, @data, (@cap)::usize, new_cap::usize);
    if (sel res_realloc.err) { ret err[A.Error].err{res_realloc.err}; }
    @data = res_realloc.ok;
    @cap  = new_cap;
    ret err[A.Error].ok{};
}

pub fun init_typed(ti: *TypeInterner, a: *A.Allocator) err[fail.Fail] {
    ti.a = a;

    ti.types = handle.chunk_init[Type](a);

    ti.params     = nil;
    ti.params_len = 0;
    ti.params_cap = 0;

    ti.handles     = nil;
    ti.handles_len = 0;
    ti.handles_cap = 0;
    ti.handle_ops     = nil;
    ti.handle_ops_len = 0;
    ti.handle_ops_cap = 0;

    ti.field_tables = handle.chunk_init[FieldTable](a);
    ti.field_pool   = handle.chunk_init[FieldEntry](a);

    ti.field_epoch = 0;
    ti.projection_generation = 0;

    ti.visits     = nil;
    ti.visits_len = 0;
    ti.visits_cap = 0;

    ti.pairs     = nil;
    ti.pairs_len = 0;
    ti.pairs_cap = 0;

    ti.gparam       = nil;
    ti.gparam_cap   = 0;
    ti.gparam_epoch = 0;

    ti.dedup          = map.init[Type, TypeId](a, hash_type, eq_type);
    ti.fun_index      = map.init[u64, TypeId](a, map.hash_u64, map.eq_u64);
    ti.instance_index = map.init[u64, TypeId](a, map.hash_u64, map.eq_u64);
    ti.field_index    = map.init[TypeId, u32](a, map.hash_u32, map.eq_u32);
    ti.disc_index     = map.init[TypeId, TypeId](a, map.hash_u32, map.eq_u32);

    val res_params: res[*TypeId, A.Error] = A.allocate[TypeId](a, INITIAL_PARAMS_CAP::usize);
    if (sel res_params.err) {
        dnit(ti);
        ret err[fail.Fail].err{fail.refused(res_params.err)};
    }
    ti.params     = res_params.ok;
    ti.params_cap = INITIAL_PARAMS_CAP;

    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        var t: Type;
        t.kind = i::TypeKind;

        val res_append: res[TypeId, fail.Fail] = append_type(ti, t);
        if (sel res_append.err) {
            dnit(ti);
            ret err[fail.Fail].err{res_append.err};
        }
        val tid: TypeId = res_append.ok;
        ti.prims[i] = tid;

        val res_insert: res[bool, A.Error] = map.insert[Type, TypeId](?ti.dedup, t, tid);
        if (sel res_insert.err) {
            dnit(ti);
            ret err[fail.Fail].err{fail.refused(res_insert.err)};
        }

        i = i + 1;
    }

    var vi: u32 = 0;
    for (vi < VEC_COUNT) {
        val sh: VecShape = vec_shape(vi);
        val res_vec: res[TypeId, fail.Fail] = intern_vector_typed(ti, sh.element, sh.lanes);
        if (sel res_vec.err) {
            dnit(ti);
            ret err[fail.Fail].err{res_vec.err};
        }
        ti.vecs[vi] = res_vec.ok;
        vi = vi + 1;
    }

    ret err[fail.Fail].ok{};
}

pub fun dnit(ti: *TypeInterner) {
    if (ti == nil) { ret; }

    handle.chunk_dnit[Type](?ti.types);
    if (ti.params != nil && ti.params_cap > 0) {
        A.deallocate[TypeId](ti.a, ti.params, ti.params_cap::usize);
    }
    if (ti.handles != nil && ti.handles_cap > 0) {
        A.deallocate[TypeId](ti.a, ti.handles, ti.handles_cap::usize);
    }
    if (ti.handle_ops != nil && ti.handle_ops_cap > 0) {
        A.deallocate[u32](ti.a, ti.handle_ops, ti.handle_ops_cap::usize);
    }
    handle.chunk_dnit[FieldTable](?ti.field_tables);
    handle.chunk_dnit[FieldEntry](?ti.field_pool);
    if (ti.visits != nil && ti.visits_cap > 0) {
        var vi: u32 = 0;
        for (vi < ti.visits_cap) {
            if (ti.visits[vi].stamp != nil && ti.visits[vi].cap > 0) {
                A.deallocate[u32](ti.a, ti.visits[vi].stamp, ti.visits[vi].cap::usize);
            }
            vi = vi + 1;
        }
        A.deallocate[VisitSet](ti.a, ti.visits, ti.visits_cap::usize);
    }
    if (ti.pairs != nil && ti.pairs_cap > 0) {
        var pi: u32 = 0;
        for (pi < ti.pairs_cap) {
            map.dnit[u64, u32](?ti.pairs[pi].seen);
            pi = pi + 1;
        }
        A.deallocate[PairSet](ti.a, ti.pairs, ti.pairs_cap::usize);
    }
    if (ti.gparam != nil && ti.gparam_cap > 0) {
        A.deallocate[u8](ti.a, ti.gparam, ti.gparam_cap::usize);
    }

    map.dnit[Type, TypeId](?ti.dedup);
    map.dnit[u64, TypeId](?ti.fun_index);
    map.dnit[u64, TypeId](?ti.instance_index);
    map.dnit[TypeId, u32](?ti.field_index);
    map.dnit[TypeId, TypeId](?ti.disc_index);

    ti.params     = nil;
    ti.params_len = 0;
    ti.params_cap = 0;

    ti.handles     = nil;
    ti.handles_len = 0;
    ti.handles_cap = 0;
    ti.handle_ops     = nil;
    ti.handle_ops_len = 0;
    ti.handle_ops_cap = 0;

    ti.field_epoch = 0;
    ti.projection_generation = 0;

    ti.visits     = nil;
    ti.visits_len = 0;
    ti.visits_cap = 0;

    ti.pairs     = nil;
    ti.pairs_len = 0;
    ti.pairs_cap = 0;

    ti.gparam       = nil;
    ti.gparam_cap   = 0;
    ti.gparam_epoch = 0;
}

pub fun get_typed(ti: *TypeInterner, tid: TypeId) opt[*Type] {
    val r: R.Result[*Type, str] = handle.chunk_get[Type](?ti.types, tid::usize);
    if (R.is_err[*Type, str](r)) { ret opt[*Type].none{}; }
    ret opt[*Type].some{R.unwrap_ok[*Type, str](r)};
}

pub fun type_count(ti: *TypeInterner) u32 {
    ret handle.chunk_count[Type](?ti.types)::u32;
}

pub fun get_param_typed(ti: *TypeInterner, index: u32) opt[TypeId] {
    if (index >= ti.params_len) { ret opt[TypeId].none{}; }
    ret opt[TypeId].some{ti.params[index]};
}

pub fun prim_typed(ti: *TypeInterner, kind: TypeKind) opt[TypeId] {
    if (kind >= PRIM_COUNT) { ret opt[TypeId].none{}; }
    ret opt[TypeId].some{ti.prims[kind]};
}

pub fun is_integer(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get_typed(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret false; }
    ret prim_desc(opt_type.some.kind).class == PRIM_CLASS_INT;
}

pub fun is_numeric(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get_typed(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret false; }
    val c: PrimClass = prim_desc(opt_type.some.kind).class;
    ret c == PRIM_CLASS_INT || c == PRIM_CLASS_FLOAT;
}

pub fun is_float(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get_typed(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret false; }
    ret prim_desc(opt_type.some.kind).class == PRIM_CLASS_FLOAT;
}

pub fun is_pointer_like(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get_typed(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret false; }
    val k: TypeKind = opt_type.some.kind;
    ret k == TYPE_PTR || k == TYPE_POINTER || k == TYPE_FUN;
}

pub fun is_pointer(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get_typed(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret false; }
    ret opt_type.some.kind == TYPE_POINTER;
}

pub fun deref_one(ti: *TypeInterner, tid: TypeId) TypeId {
    val opt_type: opt[*Type] = get_typed(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret TYPE_ERROR; }
    val t: *Type = opt_type.some;
    if (t.kind == TYPE_POINTER) {
        ret t.data.pointer.base;
    }
    ret TYPE_ERROR;
}

pub fun is_secret(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get_typed(ti, tid);
    if (!sel opt_type.some) { ret false; }
    ret opt_type.some.kind == TYPE_SECRET;
}

pub fun is_vector(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get_typed(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret false; }
    ret opt_type.some.kind == TYPE_VECTOR;
}

pub fun vector_element(ti: *TypeInterner, tid: TypeId) TypeKind {
    val opt_type: opt[*Type] = get_typed(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret TYPE_VECTOR; }
    val t: *Type = opt_type.some;
    if (t.kind != TYPE_VECTOR) { ret TYPE_VECTOR; }
    ret t.data.vector.element;
}

pub fun vector_lanes(ti: *TypeInterner, tid: TypeId) u32 {
    val opt_type: opt[*Type] = get_typed(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret 0; }
    val t: *Type = opt_type.some;
    if (t.kind != TYPE_VECTOR) { ret 0; }
    ret t.data.vector.lanes;
}

pub fun element_count_typed(ti: *TypeInterner, tid: TypeId) opt[u32] {
    if (tid == TYPE_NIL || tid == TYPE_ERROR) { ret opt[u32].none{}; }
    val t_opt: opt[*Type] = get_typed(ti, strip_secret(ti, tid));
    if (!sel t_opt.some) { ret opt[u32].none{}; }
    val t: *Type = t_opt.some;
    if (t.kind == TYPE_ARRAY)  { ret opt[u32].some{t.data.array.count}; }
    if (t.kind == TYPE_VECTOR) { ret opt[u32].some{t.data.vector.lanes}; }
    ret opt[u32].none{};
}

pub fun vec(ti: *TypeInterner, index: u32) opt[TypeId] {
    if (index >= VEC_COUNT) { ret opt[TypeId].none{}; }
    ret opt[TypeId].some{ti.vecs[index]};
}

pub fun vector_mask(ti: *TypeInterner, tid: TypeId) res[TypeId, fail.Fail] {
    val element: TypeKind = vector_element(ti, tid);
    val lanes:   u32      = vector_lanes(ti, tid);
    val bits:    u32      = prim_desc(element).bits;

    var mask_elem: TypeKind = TYPE_U8;
    if      (bits == 8)  { mask_elem = TYPE_U8;  }
    or (bits == 16) { mask_elem = TYPE_U16; }
    or (bits == 32) { mask_elem = TYPE_U32; }
    or (bits == 64) { mask_elem = TYPE_U64; }

    ret intern_vector_typed(ti, mask_elem, lanes);
}

pub fun strip_secret(ti: *TypeInterner, tid: TypeId) TypeId {
    val opt_type: opt[*Type] = get_typed(ti, tid);
    if (!sel opt_type.some) { ret tid; }
    val t: *Type = opt_type.some;
    if (t.kind != TYPE_SECRET) { ret tid; }
    ret t.data.secret.base;
}

pub fun shape_kind(ti: *TypeInterner, tid: TypeId) TypeKind {
    if (tid == TYPE_NIL || tid == TYPE_ERROR) { ret TYPE_U8; }
    val base: TypeId = strip_secret(ti, tid);
    val t_opt: opt[*Type] = get_typed(ti, base);
    if (!sel t_opt.some) { ret TYPE_U8; }
    val t: *Type = t_opt.some;
    if (t.kind != TYPE_INSTANCE) { ret t.kind; }

    val nom: TypeId = t.data.instance.nominal;
    if (nom == TYPE_ERROR || nom == base) { ret t.kind; }
    val n_opt: opt[*Type] = get_typed(ti, nom);
    if (!sel n_opt.some) { ret t.kind; }
    ret n_opt.some.kind;
}

pub fun is_u8(ti: *TypeInterner, tid: TypeId) bool {
    if (tid == TYPE_NIL || tid == TYPE_ERROR) { ret false; }
    val base: TypeId = strip_secret(ti, tid);
    val found: opt[*Type] = get_typed(ti, base);
    if (!sel found.some) { ret false; }
    ret shape_kind(ti, base) == TYPE_U8;
}

pub fun carries_secret(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get_typed(ti, tid);
    if (!sel opt_type.some) { ret false; }
    val t: *Type = opt_type.some;
    if (t.kind == TYPE_SECRET)  { ret true; }
    if (t.kind == TYPE_POINTER) { ret carries_secret(ti, t.data.pointer.base); }
    if (t.kind == TYPE_ARRAY)   { ret carries_secret(ti, t.data.array.base); }
    ret false;
}

# true when any byte of a value of this type may be secret: the type itself, an element, a field or a case
# payload; a pointer's pointee is not the object's storage and does not count
pub fun contains_secret(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get_typed(ti, tid);
    if (!sel opt_type.some) { ret false; }
    val t: *Type = opt_type.some;
    if (t.kind == TYPE_SECRET) { ret true; }
    if (t.kind == TYPE_ARRAY)  { ret contains_secret(ti, t.data.array.base); }
    if (t.kind != TYPE_REC && t.kind != TYPE_UNI && t.kind != TYPE_TAG && t.kind != TYPE_INSTANCE) { ret false; }
    val n: u32 = field_count(ti, tid);
    var i: u32 = 0;
    for (i < n) {
        val fe: opt[*FieldEntry] = field_at_typed(ti, tid, i);
        if (sel fe.some && contains_secret(ti, fe.some.ty)) { ret true; }
        i = i + 1;
    }
    ret false;
}

rec VisitSet {
    stamp: *u32;
    cap:   u32;
    epoch: u32;
}

pub rec TypeScan {
    level: u32;
}

val SCAN_NONE: u32 = 0xFFFFFFFF;

pub def VisitMark: u8;

pub val VISIT_FRESH:  VisitMark = 0;
pub val VISIT_SEEN:   VisitMark = 1;

pub fun type_scan_begin(ti: *TypeInterner, scan: *TypeScan) err[fail.Fail] {
    val r: err[fail.Fail] = visits_reserve(ti);
    if (sel r.err) {
        scan.level = SCAN_NONE;
        ret err[fail.Fail].err{r.err};
    }

    val level: u32 = ti.visits_len;
    ti.visits_len  = ti.visits_len + 1;

    if (ti.visits[level].epoch == 0xFFFFFFFF) {
        if (ti.visits[level].stamp != nil && ti.visits[level].cap > 0) {
            memory.zero[u32](ti.visits[level].stamp, ti.visits[level].cap::usize);
        }
        ti.visits[level].epoch = 1;
    }
    or {
        ti.visits[level].epoch = ti.visits[level].epoch + 1;
    }

    scan.level = level;
    ret err[fail.Fail].ok{};
}

pub fun type_scan_end(ti: *TypeInterner, scan: *TypeScan) {
    if (scan.level == SCAN_NONE) { ret; }
    ti.visits_len = scan.level;
    scan.level    = SCAN_NONE;
}

pub fun type_scan_mark(ti: *TypeInterner, scan: *TypeScan, tid: TypeId) res[VisitMark, fail.Fail] {
    if (scan.level == SCAN_NONE) { ret res[VisitMark, fail.Fail].err{fail.message("type traversal has no active visited set")}; }

    if (tid >= ti.visits[scan.level].cap) {
        val r: err[fail.Fail] = visit_reserve(ti, scan.level, tid);
        if (sel r.err) { ret res[VisitMark, fail.Fail].err{r.err}; }
    }

    val set: *VisitSet = ?ti.visits[scan.level];
    if (set.stamp[tid] == set.epoch) { ret res[VisitMark, fail.Fail].ok{VISIT_SEEN}; }
    set.stamp[tid] = set.epoch;
    ret res[VisitMark, fail.Fail].ok{VISIT_FRESH};
}

fun visits_reserve(ti: *TypeInterner) err[fail.Fail] {
    if (ti.visits_len < ti.visits_cap) { ret err[fail.Fail].ok{}; }

    val old_cap: u32 = ti.visits_cap;
    val grown: err[A.Error] = grow_cap[VisitSet](ti.a, ?ti.visits, ?ti.visits_cap, INITIAL_VISIT_DEPTH);
    if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }

    var i: u32 = old_cap;
    for (i < ti.visits_cap) {
        ti.visits[i].stamp = nil;
        ti.visits[i].cap   = 0;
        ti.visits[i].epoch = 0;
        i = i + 1;
    }

    ret err[fail.Fail].ok{};
}

fun visit_reserve(ti: *TypeInterner, level: u32, tid: TypeId) err[fail.Fail] {
    val set: *VisitSet = ?ti.visits[level];

    var base_cap: u32 = set.cap;
    if (base_cap == 0) { base_cap = INITIAL_VISIT_CAP; }

    val required_r: R.Result[layout.CheckedCount[u32], layout.CheckCause] =
        layout.count_add[u32](layout.count[u32](tid::usize), layout.count[u32](1::usize));
    if (R.is_err[layout.CheckedCount[u32], layout.CheckCause](required_r)) {
        ret err[fail.Fail].err{fail.message("type: visit-set requirement overflow")};
    }
    val required: layout.CheckedCount[u32] = R.unwrap_ok[layout.CheckedCount[u32], layout.CheckCause](required_r);
    val grown_r: R.Result[layout.CheckedCount[u32], layout.CheckCause] =
        layout.count_grow[u32](layout.count[u32](base_cap::usize), required);
    if (R.is_err[layout.CheckedCount[u32], layout.CheckCause](grown_r)) {
        ret err[fail.Fail].err{fail.message("type: visit-set growth count overflow")};
    }
    val new_cap_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
        R.unwrap_ok[layout.CheckedCount[u32], layout.CheckCause](grown_r).value);
    if (R.is_err[u32, layout.CheckCause](new_cap_fits)) {
        ret err[fail.Fail].err{fail.message("type: visit-set capacity exceeds the u32 limit")};
    }
    val new_cap: u32 = R.unwrap_ok[u32, layout.CheckCause](new_cap_fits);

    if (set.stamp == nil) {
        val res_alloc: res[*u32, A.Error] = A.allocate[u32](ti.a, new_cap::usize);
        if (sel res_alloc.err) {
            ret err[fail.Fail].err{fail.refused(res_alloc.err)};
        }
        set.stamp = res_alloc.ok;
    }
    or {
        val res_realloc: res[*u32, A.Error] = A.reallocate[u32](ti.a, set.stamp, set.cap::usize, new_cap::usize);
        if (sel res_realloc.err) {
            ret err[fail.Fail].err{fail.refused(res_realloc.err)};
        }
        set.stamp = res_realloc.ok;
    }

    memory.zero[u32](?set.stamp[set.cap], (new_cap - set.cap)::usize);
    set.cap = new_cap;

    ret err[fail.Fail].ok{};
}

rec PairSet {
    seen:  map.Map[u64, u32];
    epoch: u32;
}

pub rec PairScan {
    level: u32;
}

pub fun pair_scan_begin(ti: *TypeInterner, scan: *PairScan) err[fail.Fail] {
    val r: err[fail.Fail] = pairs_reserve(ti);
    if (sel r.err) {
        scan.level = SCAN_NONE;
        ret err[fail.Fail].err{r.err};
    }

    val level: u32 = ti.pairs_len;
    ti.pairs_len   = ti.pairs_len + 1;

    if (ti.pairs[level].epoch == 0xFFFFFFFF) {
        map.clear[u64, u32](?ti.pairs[level].seen);
        ti.pairs[level].epoch = 1;
    }
    or {
        ti.pairs[level].epoch = ti.pairs[level].epoch + 1;
    }

    scan.level = level;
    ret err[fail.Fail].ok{};
}

pub fun pair_scan_end(ti: *TypeInterner, scan: *PairScan) {
    if (scan.level == SCAN_NONE) { ret; }
    ti.pairs_len = scan.level;
    scan.level   = SCAN_NONE;
}

pub fun pair_scan_mark(ti: *TypeInterner, scan: *PairScan, a: TypeId, b: TypeId) res[VisitMark, fail.Fail] {
    if (scan.level == SCAN_NONE) { ret res[VisitMark, fail.Fail].err{fail.message("pair traversal has no active visited set")}; }

    val set: *PairSet = ?ti.pairs[scan.level];
    var key: u64      = (a::u64 << 32) | b::u64;

    val got: opt[*u32] = map.get[u64, u32](?set.seen, ?key);
    if (sel got.some) {
        val slot: *u32 = got.some;
        if (slot[0] == set.epoch) { ret res[VisitMark, fail.Fail].ok{VISIT_SEEN}; }
        slot[0] = set.epoch;
        ret res[VisitMark, fail.Fail].ok{VISIT_FRESH};
    }

    val r: res[bool, A.Error] = map.insert[u64, u32](?set.seen, key, set.epoch);
    if (sel r.err) { ret res[VisitMark, fail.Fail].err{fail.refused(r.err)}; }
    ret res[VisitMark, fail.Fail].ok{VISIT_FRESH};
}

fun pairs_reserve(ti: *TypeInterner) err[fail.Fail] {
    if (ti.pairs_len < ti.pairs_cap) { ret err[fail.Fail].ok{}; }

    val old_cap: u32 = ti.pairs_cap;
    val grown: err[A.Error] = grow_cap[PairSet](ti.a, ?ti.pairs, ?ti.pairs_cap, INITIAL_VISIT_DEPTH);
    if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }

    var i: u32 = old_cap;
    for (i < ti.pairs_cap) {
        ti.pairs[i].seen  = map.init[u64, u32](ti.a, map.hash_u64, map.eq_u64);
        ti.pairs[i].epoch = 0;
        i = i + 1;
    }

    ret err[fail.Fail].ok{};
}

pub def GParamMemo: u8;

pub val GPARAM_UNKNOWN: GParamMemo = 0;
pub val GPARAM_NO:      GParamMemo = 1;
pub val GPARAM_YES:     GParamMemo = 2;

pub fun gparam_memo_get(ti: *TypeInterner, tid: TypeId) GParamMemo {
    if (ti.gparam_epoch != ti.field_epoch) {
        if (ti.gparam != nil && ti.gparam_cap > 0) {
            memory.zero[u8](ti.gparam, ti.gparam_cap::usize);
        }
        ti.gparam_epoch = ti.field_epoch;
    }
    if (ti.gparam == nil || tid >= ti.gparam_cap) { ret GPARAM_UNKNOWN; }
    ret ti.gparam[tid];
}

pub fun gparam_memo_set(ti: *TypeInterner, tid: TypeId, mentions: bool) {
    if (ti.gparam_epoch != ti.field_epoch) {
        if (ti.gparam != nil && ti.gparam_cap > 0) {
            memory.zero[u8](ti.gparam, ti.gparam_cap::usize);
        }
        ti.gparam_epoch = ti.field_epoch;
    }
    if (tid >= ti.gparam_cap) {
        val reserved: err[fail.Fail] = gparam_reserve(ti, tid);
        if (sel reserved.err) { ret; }
    }
    if (mentions) { ti.gparam[tid] = GPARAM_YES; }
    or           { ti.gparam[tid] = GPARAM_NO; }
}

fun gparam_reserve(ti: *TypeInterner, tid: TypeId) err[fail.Fail] {
    var base_cap: u32 = ti.gparam_cap;
    if (base_cap == 0) { base_cap = INITIAL_VISIT_CAP; }

    val required_r: R.Result[layout.CheckedCount[u8], layout.CheckCause] =
        layout.count_add[u8](layout.count[u8](tid::usize), layout.count[u8](1::usize));
    if (R.is_err[layout.CheckedCount[u8], layout.CheckCause](required_r)) {
        ret err[fail.Fail].err{fail.message("type: gparam memo requirement overflow")};
    }
    val required: layout.CheckedCount[u8] = R.unwrap_ok[layout.CheckedCount[u8], layout.CheckCause](required_r);
    val grown_r: R.Result[layout.CheckedCount[u8], layout.CheckCause] =
        layout.count_grow[u8](layout.count[u8](base_cap::usize), required);
    if (R.is_err[layout.CheckedCount[u8], layout.CheckCause](grown_r)) {
        ret err[fail.Fail].err{fail.message("type: gparam memo growth count overflow")};
    }
    val new_cap_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
        R.unwrap_ok[layout.CheckedCount[u8], layout.CheckCause](grown_r).value);
    if (R.is_err[u32, layout.CheckCause](new_cap_fits)) {
        ret err[fail.Fail].err{fail.message("type: gparam memo capacity exceeds the u32 limit")};
    }
    val new_cap: u32 = R.unwrap_ok[u32, layout.CheckCause](new_cap_fits);

    if (ti.gparam == nil) {
        val res_alloc: res[*u8, A.Error] = A.allocate[u8](ti.a, new_cap::usize);
        if (sel res_alloc.err) {
            ret err[fail.Fail].err{fail.refused(res_alloc.err)};
        }
        ti.gparam = res_alloc.ok;
    }
    or {
        val res_realloc: res[*u8, A.Error] = A.reallocate[u8](ti.a, ti.gparam, ti.gparam_cap::usize, new_cap::usize);
        if (sel res_realloc.err) {
            ret err[fail.Fail].err{fail.refused(res_realloc.err)};
        }
        ti.gparam = res_realloc.ok;
    }

    memory.zero[u8](?ti.gparam[ti.gparam_cap], (new_cap - ti.gparam_cap)::usize);
    ti.gparam_cap = new_cap;

    ret err[fail.Fail].ok{};
}

pub fun secrecy_structure_equal(ti: *TypeInterner, a: TypeId, b: TypeId) bool {
    val a_secret: bool = is_secret(ti, a);
    val b_secret: bool = is_secret(ti, b);
    if (a_secret != b_secret) { ret false; }

    val sa: TypeId = strip_secret(ti, a);
    val sb: TypeId = strip_secret(ti, b);

    val oa: opt[*Type] = get_typed(ti, sa);
    val ob: opt[*Type] = get_typed(ti, sb);
    if (!sel oa.some) { ret true; }
    if (!sel ob.some) { ret true; }
    val ta: *Type = oa.some;
    val tb: *Type = ob.some;

    if (ta.kind == TYPE_POINTER && tb.kind == TYPE_POINTER) {
        ret secrecy_structure_equal(ti, ta.data.pointer.base, tb.data.pointer.base);
    }
    if (ta.kind == TYPE_ARRAY && tb.kind == TYPE_ARRAY) {
        ret secrecy_structure_equal(ti, ta.data.array.base, tb.data.array.base);
    }
    ret true;
}

pub fun intern_pointer(ti: *TypeInterner, base: TypeId) res[TypeId, fail.Fail] {
    var t: Type;
    t.kind              = TYPE_POINTER;
    t.data.pointer.base = base;
    ret intern_dedup(ti, t);
}

pub fun intern_secret_typed(ti: *TypeInterner, base: TypeId) res[TypeId, fail.Fail] {
    if (base == TYPE_ERROR) { ret res[TypeId, fail.Fail].ok{TYPE_ERROR}; }
    if (is_secret(ti, base)) { ret res[TypeId, fail.Fail].ok{base}; }
    var t: Type;
    t.kind             = TYPE_SECRET;
    t.data.secret.base = base;
    ret intern_dedup(ti, t);
}

pub fun intern_array_typed(ti: *TypeInterner, base: TypeId, count: u32) res[TypeId, fail.Fail] {
    var t: Type;
    t.kind             = TYPE_ARRAY;
    t.data.array.base  = base;
    t.data.array.count = count;
    ret intern_dedup(ti, t);
}

pub fun intern_vector_typed(ti: *TypeInterner, element: TypeKind, lanes: u32) res[TypeId, fail.Fail] {
    var t: Type;
    t.kind                = TYPE_VECTOR;
    t.data.vector.element = element;
    t.data.vector.lanes   = lanes;
    ret intern_dedup(ti, t);
}

pub fun intern_handle_typed(ti: *TypeInterner, name: intern.StrId, ctor: u32, ops: *u32, count: u32) res[TypeId, fail.Fail] {
    var i: u32 = 0;
    for (i < ti.handles_len) {
        val tid:  TypeId = ti.handles[i];
        val cand: *Type  = R.unwrap_ok[*Type, str](handle.chunk_get[Type](?ti.types, tid::usize));
        if (cand.data.handle.ctor == ctor && cand.data.handle.ops_len == count) {
            var ops_match: bool = true;
            var oi:        u32  = 0;
            for (oi < count) {
                if (ti.handle_ops[cand.data.handle.ops_start + oi] != ops[oi]) {
                    ops_match = false;
                    brk;
                }
                oi = oi + 1;
            }
            if (ops_match) { ret res[TypeId, fail.Fail].ok{tid}; }
        }
        i = i + 1;
    }

    val res_start: res[u32, fail.Fail] = handle_ops_append(ti, ops, count);
    if (sel res_start.err) {
        ret res[TypeId, fail.Fail].err{res_start.err};
    }

    var t: Type;
    t.kind                  = TYPE_HANDLE;
    t.data.handle.name      = name;
    t.data.handle.ctor      = ctor;
    t.data.handle.ops_start = res_start.ok;
    t.data.handle.ops_len   = count;

    val res_append: res[TypeId, fail.Fail] = append_type(ti, t);
    if (sel res_append.err) { ti.handle_ops_len = t.data.handle.ops_start; ret res_append; }
    val tid: TypeId = res_append.ok;

    val res_track: err[fail.Fail] = track_handle(ti, tid);
    if (sel res_track.err) {
        ti.types.len = tid::usize;
        ti.handle_ops_len = t.data.handle.ops_start;
        ret res[TypeId, fail.Fail].err{res_track.err};
    }
    ret res[TypeId, fail.Fail].ok{tid};
}

pub fun is_handle(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get_typed(ti, tid);
    if (!sel opt_type.some) { ret false; }
    ret opt_type.some.kind == TYPE_HANDLE;
}

pub fun intern_abi_type(ti: *TypeInterner, name: intern.StrId, tag: u32, size: u32,
                        align: u32) res[TypeId, fail.Fail] {
    var t: Type;
    t.kind           = TYPE_ABI;
    t.data.abi.name  = name;
    t.data.abi.tag   = tag;
    t.data.abi.size  = size;
    t.data.abi.align = align;
    ret intern_dedup(ti, t);
}

pub fun is_abi_type(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get_typed(ti, tid);
    if (!sel opt_type.some) { ret false; }
    ret opt_type.some.kind == TYPE_ABI;
}

pub fun handle_operand(ti: *TypeInterner, tid: TypeId, index: u32) u32 {
    val opt_type: opt[*Type] = get_typed(ti, tid);
    if (!sel opt_type.some) { ret 0; }
    val t: *Type = opt_type.some;
    if (t.kind != TYPE_HANDLE)          { ret 0; }
    if (index >= t.data.handle.ops_len) { ret 0; }
    ret ti.handle_ops[t.data.handle.ops_start + index];
}

fun handle_ops_append(ti: *TypeInterner, src: *u32, len: u32) res[u32, fail.Fail] {
    val start: u32 = ti.handle_ops_len;

    val required_r: R.Result[layout.CheckedCount[u32], layout.CheckCause] =
        layout.count_add[u32](layout.count[u32](ti.handle_ops_len::usize), layout.count[u32](len::usize));
    if (R.is_err[layout.CheckedCount[u32], layout.CheckCause](required_r)) {
        ret res[u32, fail.Fail].err{fail.message("type: handle-operand append count overflow")};
    }
    val required: layout.CheckedCount[u32] = R.unwrap_ok[layout.CheckedCount[u32], layout.CheckCause](required_r);

    if (required.value > ti.handle_ops_cap::usize) {
        var base_cap: usize = ti.handle_ops_cap::usize;
        if (base_cap == 0) { base_cap = INITIAL_INSTANCE_CAP::usize; }
        val grown_r: R.Result[layout.CheckedCount[u32], layout.CheckCause] =
            layout.count_grow[u32](layout.count[u32](base_cap), required);
        if (R.is_err[layout.CheckedCount[u32], layout.CheckCause](grown_r)) {
            ret res[u32, fail.Fail].err{fail.message("type: handle-operand growth count overflow")};
        }
        val new_cap_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
            R.unwrap_ok[layout.CheckedCount[u32], layout.CheckCause](grown_r).value);
        if (R.is_err[u32, layout.CheckCause](new_cap_fits)) {
            ret res[u32, fail.Fail].err{fail.message("type: handle-operand capacity exceeds the u32 limit")};
        }
        val new_cap: u32 = R.unwrap_ok[u32, layout.CheckCause](new_cap_fits);

        if (ti.handle_ops == nil) {
            val res_a: res[*u32, A.Error] = A.allocate[u32](ti.a, new_cap::usize);
            if (sel res_a.err) { ret res[u32, fail.Fail].err{fail.refused(res_a.err)}; }
            ti.handle_ops = res_a.ok;
        }
        or {
            val res_ra: res[*u32, A.Error] = A.reallocate[u32](ti.a, ti.handle_ops, ti.handle_ops_cap::usize, new_cap::usize);
            if (sel res_ra.err) { ret res[u32, fail.Fail].err{fail.refused(res_ra.err)}; }
            ti.handle_ops = res_ra.ok;
        }
        ti.handle_ops_cap = new_cap;
    }

    var i: u32 = 0;
    for (i < len) {
        ti.handle_ops[start + i] = src[i];
        i = i + 1;
    }
    val new_len_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(required.value);
    if (R.is_err[u32, layout.CheckCause](new_len_fits)) {
        ret res[u32, fail.Fail].err{fail.message("type: handle-operand length exceeds the u32 limit")};
    }
    ti.handle_ops_len = R.unwrap_ok[u32, layout.CheckCause](new_len_fits);
    ret res[u32, fail.Fail].ok{start};
}

fun track_handle(ti: *TypeInterner, tid: TypeId) err[fail.Fail] {
    if (ti.handles_len == ti.handles_cap) {
        val grown: err[A.Error] = grow_cap[TypeId](ti.a, ?ti.handles, ?ti.handles_cap, INITIAL_INSTANCE_CAP);
        if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    }

    ti.handles[ti.handles_len] = tid;
    ti.handles_len = ti.handles_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun intern_pack(ti: *TypeInterner) res[TypeId, fail.Fail] {
    var t: Type;
    t.kind = TYPE_PACK;
    ret intern_dedup(ti, t);
}

pub fun intern_case_selector(ti: *TypeInterner, tag_type: TypeId, case_name: intern.StrId, case_index: u32) res[TypeId, fail.Fail] {
    var t: Type;
    t.kind                          = TYPE_CASE_SELECTOR;
    t.data.case_selector.tag_type   = tag_type;
    t.data.case_selector.case_name  = case_name;
    t.data.case_selector.case_index = case_index;
    ret intern_dedup(ti, t);
}

pub fun is_case_selector(ti: *TypeInterner, tid: TypeId) bool {
    val opt_t: opt[*Type] = get_typed(ti, tid);
    if (!sel opt_t.some) { ret false; }
    ret opt_t.some.kind == TYPE_CASE_SELECTOR;
}

pub fun case_selector_tag_type(ti: *TypeInterner, tid: TypeId) TypeId {
    val opt_t: opt[*Type] = get_typed(ti, tid);
    if (!sel opt_t.some) { ret TYPE_NIL; }
    val t: *Type = opt_t.some;
    if (t.kind != TYPE_CASE_SELECTOR) { ret TYPE_NIL; }
    ret t.data.case_selector.tag_type;
}

pub fun case_selector_case_index(ti: *TypeInterner, tid: TypeId) u32 {
    val opt_t: opt[*Type] = get_typed(ti, tid);
    if (!sel opt_t.some) { ret 0; }
    val t: *Type = opt_t.some;
    if (t.kind != TYPE_CASE_SELECTOR) { ret 0; }
    ret t.data.case_selector.case_index;
}

pub fun case_selector_case_name(ti: *TypeInterner, tid: TypeId) intern.StrId {
    val opt_t: opt[*Type] = get_typed(ti, tid);
    if (!sel opt_t.some) { ret intern.STR_NIL; }
    val t: *Type = opt_t.some;
    if (t.kind != TYPE_CASE_SELECTOR) { ret intern.STR_NIL; }
    ret t.data.case_selector.case_name;
