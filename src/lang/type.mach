fun intern_distinct_instances(ti: *TypeInterner, first: u32, count: u32) err[fail.Fail] {
    var i: u32 = first;
    for (i < first + count) {
        var arg: TypeId = i::TypeId;
        val r: res[TypeId, fail.Fail] = intern_instance(ti, 0::TypeId, ?arg, 1);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun time_intern_fresh(count: u32) i64 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: TypeInterner;
    val made: err[fail.Fail] = init_typed(?ti, ?alloc);
    if (sel made.err) { ret -1; }

    val started: tm.Clock = tm.monotonic();
    if (sel started.err) { dnit(?ti); ret -1; }
    val interned: err[fail.Fail] = intern_distinct_instances(?ti, 0, count);
    if (sel interned.err) { dnit(?ti); ret -1; }
    val stopped: tm.Clock = tm.monotonic();
    if (sel stopped.err) { dnit(?ti); ret -1; }
    val elapsed: duration.Duration = tm.time_sub(stopped.ok, started.ok);

    dnit(?ti);
    ret duration.duration_usec(elapsed);
}

test "mach.lang.type.intern_instance:cost_stays_near_linear_as_population_grows" {
    val small: u32 = 3000;
    val large: u32 = small * 4;

    val us_small: i64 = time_intern_fresh(small);
    val us_large: i64 = time_intern_fresh(large);
    if (us_small < 0 || us_large < 0) { ret 1; }

    var pa: A.Allocator;
    val made_17: err[A.Error] = page.make(?pa);
    if (sel made_17.err) { ret 1; }
    val msg: res[str, format.FormatError] = format.sprint(?pa, "us_small={} us_large={}\n", us_small, us_large);
    if (sel msg.ok) { print.eprint(msg.ok); }

    var bad: i32 = 0;
    if (us_large > (us_small + 2000) * 8) { bad = 1; }
    ret bad;
}

test "mach.lang.type:invalid_ids_answer_identically_across_the_query_api" {
    var alloc: A.Allocator;
    val made_18: err[A.Error] = page.make(?alloc);
    if (sel made_18.err) { ret 1; }
    var ti: TypeInterner;
    val init_typed_1: err[fail.Fail] = init_typed(?ti, ?alloc);
    if (sel init_typed_1.err) { ret 1; }

    var ids: [3]TypeId;
    ids[0] = TYPE_NIL;
    ids[1] = TYPE_ERROR;
    ids[2] = type_count(?ti);
    var code: i32 = 0;
    var i: usize = 0;
    for (i < 3) {
        val id: TypeId = ids[i];
        val get_typed_2: opt[*Type] = get_typed(?ti, id);
        if (sel get_typed_2.some)            { code = 1; }
        if (is_integer(?ti, id) || is_numeric(?ti, id) || is_float(?ti, id)) { code = 1; }
        if (is_pointer_like(?ti, id) || is_secret(?ti, id) || is_vector(?ti, id)) { code = 1; }
        if (is_u8(?ti, id) || carries_secret(?ti, id))  { code = 1; }
        if (is_handle(?ti, id) || is_abi_type(?ti, id)) { code = 1; }
        if (is_union(?ti, id) || is_record(?ti, id))    { code = 1; }
        if (vector_element(?ti, id) != TYPE_VECTOR)     { code = 1; }
        if (vector_lanes(?ti, id) != 0)                 { code = 1; }
        val element_count_typed_3: opt[u32] = element_count_typed(?ti, id);
        if (sel element_count_typed_3.some)     { code = 1; }
        if (strip_secret(?ti, id) != id)                { code = 1; }
        if (aggregate_nominal(?ti, id) != TYPE_ERROR)   { code = 1; }
        if (shape_kind(?ti, id) != TYPE_U8)             { code = 1; }
        val field_table_for_typed_4: opt[*FieldTable] = field_table_for_typed(?ti, id);
        if (sel field_table_for_typed_4.some) { code = 1; }
        if (field_count(?ti, id) != 0)                  { code = 1; }
        val field_at_typed_5: opt[*FieldEntry] = field_at_typed(?ti, id, 0);
        if (sel field_at_typed_5.some) { code = 1; }
        i = i + 1;
    }
    dnit(?ti);
    ret code;
}

test "mach.lang.type.scans:allocation_failures_keep_their_reason_and_release_scan_state" {
    var t: T.Testing;
    val make_1: err[A.Error] = T.make(?t);
    if (sel make_1.err) { ret 1; }
    fin { T.dnit(?t); }
    var ti: TypeInterner;
    val init_typed_2: err[fail.Fail] = init_typed(?ti, T.allocator_of(?t));
    if (sel init_typed_2.err) { ret 2; }
    var code: i32 = 0;
    var scan: TypeScan;
    T.fail_at_ordinal(?t, T.attempt_count(?t) + 1);
    val tb: err[fail.Fail] = type_scan_begin(?ti, ?scan);
    if (sel tb.err) { if (!str_equals(fail.describe(tb.err), "out of memory")) { code = 3; } }
    or { code = 3; }
    type_scan_end(?ti, ?scan);
    T.clear_failure(?t);
    val ts: err[fail.Fail] = type_scan_begin(?ti, ?scan);
    if (sel ts.err) { code = 4; }
    or (sel ts.ok) {
        T.fail_at_ordinal(?t, T.attempt_count(?t) + 1);
        val tm: res[VisitMark, fail.Fail] = type_scan_mark(?ti, ?scan, 1::TypeId);
        if (sel tm.err) { if (!str_equals(fail.describe(tm.err), "out of memory")) { code = 5; } }
        or { code = 5; }
        type_scan_end(?ti, ?scan);
    }
    var pair: PairScan;
    T.fail_at_ordinal(?t, T.attempt_count(?t) + 1);
    val pb: err[fail.Fail] = pair_scan_begin(?ti, ?pair);
    if (sel pb.err) { if (!str_equals(fail.describe(pb.err), "out of memory")) { code = 6; } }
    or { code = 6; }
    pair_scan_end(?ti, ?pair);
    T.clear_failure(?t);
    val ps: err[fail.Fail] = pair_scan_begin(?ti, ?pair);
    if (sel ps.err) { code = 7; }
    or (sel ps.ok) {
        T.fail_at_ordinal(?t, T.attempt_count(?t) + 1);
        val pm: res[VisitMark, fail.Fail] = pair_scan_mark(?ti, ?pair, 1::TypeId, 2::TypeId);
        if (sel pm.err) { if (!str_equals(fail.describe(pm.err), "out of memory")) { code = 8; } }
        or { code = 8; }
        pair_scan_end(?ti, ?pair);
    }
    dnit(?ti);
    if (T.leaked(?t) || T.double_free_count(?t) != 0 || T.tracking_exhausted(?t)) { code = 9; }
    ret code;
}

test "mach.lang.type.intern_nominal:named_identity_survives_unrelated_declaration_insertion" {
    var alloc: A.Allocator;
    val make_1: err[A.Error] = page.make(?alloc);
    if (sel make_1.err) { ret 1; }
    var ti: TypeInterner;
    val init_typed_2: err[fail.Fail] = init_typed(?ti, ?alloc);
    if (sel init_typed_2.err) { ret 2; }
    fin { dnit(?ti); }
    val owner: TypeOwner = TypeOwner{ module: 9, file: 4 };
    val first: res[TypeId, fail.Fail] = intern_nominal(?ti, 7, owner, TYPE_REC);
    if (sel first.err) { ret 3; }
    val intern_nominal_3: res[TypeId, fail.Fail] = intern_nominal(?ti, 8, owner, TYPE_REC);
    if (sel intern_nominal_3.err) { ret 4; }
    val warm: res[TypeId, fail.Fail] = intern_nominal(?ti, 7, owner, TYPE_REC);
    if (sel warm.err) { ret 5; }
    if (first.ok != warm.ok) { ret 5; }
    val other_file: res[TypeId, fail.Fail] = intern_nominal(?ti, 7, TypeOwner{ module: 9, file: 5 }, TYPE_REC);
    val other_module: res[TypeId, fail.Fail] = intern_nominal(?ti, 7, TypeOwner{ module: 10, file: 4 }, TYPE_REC);
    val renamed: res[TypeId, fail.Fail] = intern_nominal(?ti, 8, owner, TYPE_REC);
    if (sel other_file.err) { ret 6; }
    if (sel other_module.err) { ret 6; }
    if (sel renamed.err) { ret 6; }
    val original: TypeId = first.ok;
    if (original == other_file.ok || original == other_module.ok
        || original == renamed.ok) { ret 7; }
    ret 0;
}

test "mach.lang.type.intern_anonymous:identical_shapes_keep_their_source_incarnation" {
    var alloc: A.Allocator;
    val make_1: err[A.Error] = page.make(?alloc);
    if (sel make_1.err) { ret 1; }
    var ti: TypeInterner;
    val init_typed_2: err[fail.Fail] = init_typed(?ti, ?alloc);
    if (sel init_typed_2.err) { ret 2; }
    fin { dnit(?ti); }
    val owner: TypeOwner = TypeOwner{ module: 9, file: 4 };
    val first: res[TypeId, fail.Fail] = intern_anonymous(?ti, 7, owner, 1, 2, TYPE_REC);
    val same: res[TypeId, fail.Fail] = intern_anonymous(?ti, 7, owner, 1, 2, TYPE_REC);
    val edited: res[TypeId, fail.Fail] = intern_anonymous(?ti, 7, owner, 2, 2, TYPE_REC);
    val other: res[TypeId, fail.Fail] = intern_anonymous(?ti, 7, TypeOwner{ module: 10, file: 5 }, 1, 2, TYPE_REC);
    if (sel first.err) { ret 3; }
    if (sel same.err) { ret 3; }
    if (sel edited.err) { ret 3; }
    if (sel other.err) { ret 3; }
    val original: TypeId = first.ok;
    if (original != same.ok) { ret 4; }
    if (original == edited.ok || original == other.ok) { ret 5; }
    val intern_anonymous_3: res[TypeId, fail.Fail] = intern_anonymous(?ti, 7, owner, 0, 2, TYPE_REC);
    if (sel intern_anonymous_3.ok) { ret 6; }
    ret 0;
}

test "mach.lang.type.interning:hash_collisions_keep_every_canonical_signature" {
    var alloc: A.Allocator;
    val make_1: err[A.Error] = page.make(?alloc);
    if (sel make_1.err) { ret 1; }
    var ti: TypeInterner;
    val init_typed_2: err[fail.Fail] = init_typed(?ti, ?alloc);
    if (sel init_typed_2.err) { ret 2; }
    fin { dnit(?ti); }
    val prim_typed_3: opt[TypeId] = prim_typed(?ti, TYPE_I32);
    if (!sel prim_typed_3.some) { ret 1; }
    var first: TypeId = prim_typed_3.some;
    val prim_typed_4: opt[TypeId] = prim_typed(?ti, TYPE_U64);
    if (!sel prim_typed_4.some) { ret 1; }
    var second: TypeId = prim_typed_4.some;
    val f1: res[TypeId, fail.Fail] = intern_function_bucket(?ti, first, ?first, 1, false, 7);
    val f2: res[TypeId, fail.Fail] = intern_function_bucket(?ti, first, ?second, 1, false, 7);
    val i1: res[TypeId, fail.Fail] = intern_instance_bucket(?ti, first, ?first, 1, 7);
    val i2: res[TypeId, fail.Fail] = intern_instance_bucket(?ti, first, ?second, 1, 7);
    if (sel f1.err) { ret 3; }
    if (sel f2.err) { ret 3; }
    if (sel i1.err) { ret 3; }
    if (sel i2.err) { ret 3; }
    if (f1.ok == f2.ok || i1.ok == i2.ok) { ret 4; }
    val count: TypeId = type_count(?ti);
    val params: u32 = ti.params_len;
    var n: u32 = 0;
    for (n < 32) {
        val a: res[TypeId, fail.Fail] = intern_function_bucket(?ti, first, ?first, 1, false, 7);
        val b: res[TypeId, fail.Fail] = intern_function_bucket(?ti, first, ?second, 1, false, 7);
        val c: res[TypeId, fail.Fail] = intern_instance_bucket(?ti, first, ?first, 1, 7);
        val d: res[TypeId, fail.Fail] = intern_instance_bucket(?ti, first, ?second, 1, 7);
        if (sel a.err) { ret 5; }
        if (sel b.err) { ret 5; }
        if (sel c.err) { ret 5; }
        if (sel d.err) { ret 5; }
        if (a.ok != f1.ok || b.ok != f2.ok
            || c.ok != i1.ok || d.ok != i2.ok) { ret 6; }
        n = n + 1;
    }
    if (type_count(?ti) != count || ti.params_len != params) { ret 7; }
    ret 0;
}

fun t_intern_attempt(ti: *TypeInterner, kind: u32, arg: *TypeId) res[TypeId, fail.Fail] {
    val prim_typed_1: opt[TypeId] = prim_typed(ti, TYPE_I32);
    if (!sel prim_typed_1.some) { ret res[TypeId, fail.Fail].err{fail.message("internal: prim_typed is absent")}; }
    val base: TypeId = prim_typed_1.some;
    if (kind == 0) { ret intern_pointer(ti, base); }
    if (kind == 1) { ret intern_function(ti, base, arg, 1, false); }
    ret intern_instance(ti, base, arg, 1);
}

test "mach.lang.type.interning:refused_publication_retries_one_canonical_identity" {
    var kind: u32 = 0;
    for (kind < 3) {
        var ordinal: usize = 1;
        var finished: bool = false;
        for (ordinal <= 16 && !finished) {
            var t: T.Testing;
            val make_1: err[A.Error] = T.make(?t);
            if (sel make_1.err) { ret 1; }
            var ti: TypeInterner;
            val init_typed_2: err[fail.Fail] = init_typed(?ti, T.allocator_of(?t));
            if (sel init_typed_2.err) { T.dnit(?t); ret 2; }
            val before: TypeId = type_count(?ti);
            val run: u32 = ti.params_len;
            val prim_typed_3: opt[TypeId] = prim_typed(?ti, TYPE_U64);
            if (!sel prim_typed_3.some) { ret 1; }
            var arg: TypeId = prim_typed_3.some;
            T.fail_at_ordinal(?t, T.attempt_count(?t) + ordinal);
            val attempt: res[TypeId, fail.Fail] = t_intern_attempt(?ti, kind, ?arg);
            var code: i32 = 0;
            if (sel attempt.err) {
                if (!str_equals(fail.describe(attempt.err), "out of memory")) { code = 3; }
                if (type_count(?ti) != before || ti.params_len != run) { code = 4; }
            }
            or { finished = true; }
            T.clear_failure(?t);
            val retry: res[TypeId, fail.Fail] = t_intern_attempt(?ti, kind, ?arg);
            val again: res[TypeId, fail.Fail] = t_intern_attempt(?ti, kind, ?arg);
            if (sel retry.err) { code = 5; }
            or (sel again.err) { code = 5; }
            or (sel retry.ok) {
                if (sel again.ok && (retry.ok != before || again.ok != before || type_count(?ti) != before + 1)) { code = 6; }
            }
            dnit(?ti);
            if (T.leaked(?t) || T.double_free_count(?t) != 0 || T.tracking_exhausted(?t)) { code = 7; }
            T.dnit(?t);
            if (code != 0) { ret code; }
            ordinal = ordinal + 1;
        }
        if (!finished) { ret 8; }
        kind = kind + 1;
    }
    ret 0;
}

fun t_borrowed_parameter_growth(tracker: *T.Testing) i32 {
    var ti: TypeInterner;
    val init_typed_1: err[fail.Fail] = init_typed(?ti, T.allocator_of(tracker));
    if (sel init_typed_1.err) { ret 2; }
    fin { dnit(?ti); }
    val prim_typed_2: opt[TypeId] = prim_typed(?ti, TYPE_I32);
    if (!sel prim_typed_2.some) { ret 1; }
    var arg: TypeId = prim_typed_2.some;
    for (ti.params_len < ti.params_cap) {
        val params_append_3: res[u32, fail.Fail] = params_append(?ti, ?arg, 1);
        if (sel params_append_3.err) { ret 3; }
    }
    val old_len: u32 = ti.params_len;
    val old_address: usize = ti.params::usize;
    val appended: res[u32, fail.Fail] = params_append(?ti, ti.params, old_len);
    if (sel appended.err) { ret 4; }
    if (appended.ok != old_len) { ret 4; }
    if (ti.params_len != old_len * 2) { ret 4; }
    if (ti.params::usize == old_address) { ret 7; }
    var i: u32 = 0;
    for (i < ti.params_len) {
        if (ti.params[i] != arg) { ret 5; }
        i = i + 1;
    }
    val saved: usize = ti.types.len;
    ti.types.len = TYPE_ERROR::usize;
    val prim_typed_4: opt[TypeId] = prim_typed(?ti, TYPE_U64);
    if (!sel prim_typed_4.some) { ret 1; }
    val exhausted: res[TypeId, fail.Fail] = intern_pointer(?ti, prim_typed_4.some);
    ti.types.len = saved;
    if (sel exhausted.ok) { ret 6; }
    if (!str_equals(fail.describe(exhausted.err), "type identities are exhausted")) { ret 6; }
    ret 0;
}

test "mach.lang.type.interning:borrowed_parameter_runs_survive_pool_growth" {
    var tracker: T.Testing;
    val make_1: err[A.Error] = T.make(?tracker);
    if (sel make_1.err) { ret 1; }
    fin { T.dnit(?tracker); }
    val code: i32 = t_borrowed_parameter_growth(?tracker);
    if (code != 0) { ret code; }
    if (T.leaked(?tracker) || T.double_free_count(?tracker) != 0 || T.tracking_exhausted(?tracker)) { ret 8; }
    ret 0;
}
