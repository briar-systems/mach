    if (sel outcome.ok)       { ti.handles = nil; ti.handles_len = 0; ti.handles_cap = 0; dnit(?ti); ret 1; }
    if (ti.handles_len != 0xFFFFFFFF)    { dnit(?ti); ret 1; }

