}

pub rec TypeInstance {
    nominal:       TypeId;
    target_origin: module.ModuleId;
    target_decl:   id.DeclId;
    args_start:    u32;
    args_len:      u32;
}

pub rec Type {
    kind: TypeKind;
    data: uni {
        pointer:       TypePointer;
        secret:        TypeSecret;
        array:         TypeArray;
        vector:        TypeVector;
        handle:        TypeHandle;
        abi:           TypeAbi;
        fn:            TypeFun;
        nominal:       TypeNominal;
        generic_param: TypeGenericParam;
        instance:      TypeInstance;
    };
}

pub rec FieldEntry {
    name: intern.StrId;
    ty:   TypeId;
}


pub rec FieldTable {
    ty:           TypeId;
    fields_start: u32;
    fields_len:   u32;
    epoch:        u32;
}

pub rec TypeInterner {
    a: *A.Allocator;

    types: handle.StableChunks[Type];

    params:     *TypeId;
    params_len: u32;
    params_cap: u32;

    dedup: map.Map[Type, TypeId];

    fun_index:      map.Map[u64, TypeId];
    instance_index: map.Map[u64, TypeId];

    handles:     *TypeId;
    handles_len: u32;
    handles_cap: u32;

    handle_ops:     *u32;
    handle_ops_len: u32;
    handle_ops_cap: u32;

    prims: [PRIM_COUNT]TypeId;

    vecs: [VEC_COUNT]TypeId;

    field_tables: handle.StableChunks[FieldTable];

    field_index: map.Map[TypeId, u32];

    field_pool: handle.StableChunks[FieldEntry];

    field_epoch: u32;

    visits:     *VisitSet;
    visits_len: u32;
    visits_cap: u32;

    pairs:     *PairSet;
    pairs_len: u32;
    pairs_cap: u32;

    gparam:       *u8;
    gparam_cap:   u32;
    gparam_epoch: u32;
}

val INITIAL_PARAMS_CAP:      u32 = 32;
val INITIAL_INSTANCE_CAP:    u32 = 16;
val INITIAL_VISIT_CAP:       u32 = 64;
val INITIAL_VISIT_DEPTH:     u32 = 4;

fun grow_cap[T](alloc: *A.Allocator, data: **T, cap: *u32, initial: u32) R.Result[R.Void, str] {
    if (@data == nil) {
        val res_alloc: R.Result[*T, str] = A.allocate[T](alloc, initial::usize);
        if (R.is_err[*T, str](res_alloc)) { ret R.err[R.Void, str](R.unwrap_err[*T, str](res_alloc)); }
        @data = R.unwrap_ok[*T, str](res_alloc);
        @cap  = initial;
        ret R.ok_void[str]();
    }
    val current: layout.CheckedCount[T] = layout.count[T]((@cap)::usize);
    val required_r: R.Result[layout.CheckedCount[T], layout.CheckCause] =
        layout.count_add[T](current, layout.count[T](1::usize));
    if (R.is_err[layout.CheckedCount[T], layout.CheckCause](required_r)) {
        ret R.err[R.Void, str]("type: growth count overflow");
    }
    val required: layout.CheckedCount[T] = R.unwrap_ok[layout.CheckedCount[T], layout.CheckCause](required_r);
    val grown_r: R.Result[layout.CheckedCount[T], layout.CheckCause] = layout.count_grow[T](current, required);
    if (R.is_err[layout.CheckedCount[T], layout.CheckCause](grown_r)) {
        ret R.err[R.Void, str]("type: growth count overflow");
    }
    val new_cap_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
        R.unwrap_ok[layout.CheckedCount[T], layout.CheckCause](grown_r).value);
    if (R.is_err[u32, layout.CheckCause](new_cap_fits)) {
        ret R.err[R.Void, str]("type: growth capacity exceeds the u32 limit");
    }
    val new_cap: u32 = R.unwrap_ok[u32, layout.CheckCause](new_cap_fits);
    val res_realloc: R.Result[*T, str] = A.reallocate[T](alloc, @data, (@cap)::usize, new_cap::usize);
    if (R.is_err[*T, str](res_realloc)) { ret R.err[R.Void, str](R.unwrap_err[*T, str](res_realloc)); }
    @data = R.unwrap_ok[*T, str](res_realloc);
    @cap  = new_cap;
    ret R.ok_void[str]();
}

pub fun init(ti: *TypeInterner, a: *A.Allocator) O.Option[str] {
    ti.a = a;

    ti.types = handle.chunk_init[Type](a);

    ti.params     = nil;
    ti.params_len = 0;
    ti.params_cap = 0;

    ti.handles     = nil;
    ti.handles_len = 0;
    ti.handles_cap = 0;
    ti.handle_ops     = nil;
    ti.handle_ops_len = 0;
    ti.handle_ops_cap = 0;

    ti.field_tables = handle.chunk_init[FieldTable](a);
    ti.field_pool   = handle.chunk_init[FieldEntry](a);

    ti.field_epoch = 0;

    ti.visits     = nil;
    ti.visits_len = 0;
    ti.visits_cap = 0;

    ti.pairs     = nil;
    ti.pairs_len = 0;
    ti.pairs_cap = 0;

    ti.gparam       = nil;
    ti.gparam_cap   = 0;
    ti.gparam_epoch = 0;

    ti.dedup          = map.init[Type, TypeId](a, hash_type, eq_type);
    ti.fun_index      = map.init[u64, TypeId](a, map.hash_u64, map.eq_u64);
    ti.instance_index = map.init[u64, TypeId](a, map.hash_u64, map.eq_u64);
    ti.field_index    = map.init[TypeId, u32](a, map.hash_u32, map.eq_u32);

    val res_params: R.Result[*TypeId, str] = A.allocate[TypeId](a, INITIAL_PARAMS_CAP::usize);
    if (R.is_err[*TypeId, str](res_params)) {
        dnit(ti);
        ret O.some[str](R.unwrap_err[*TypeId, str](res_params));
    }
    ti.params     = R.unwrap_ok[*TypeId, str](res_params);
    ti.params_cap = INITIAL_PARAMS_CAP;

    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        var t: Type;
        t.kind = i::TypeKind;

        val res_append: R.Result[TypeId, str] = append_type(ti, t);
        if (R.is_err[TypeId, str](res_append)) {
            dnit(ti);
            ret O.some[str](R.unwrap_err[TypeId, str](res_append));
        }
        val tid: TypeId = R.unwrap_ok[TypeId, str](res_append);
        ti.prims[i] = tid;

        val res_insert: R.Result[bool, str] = map.insert[Type, TypeId](?ti.dedup, t, tid);
        if (R.is_err[bool, str](res_insert)) {
            dnit(ti);
            ret O.some[str](R.unwrap_err[bool, str](res_insert));
        }

        i = i + 1;
    }

    var vi: u32 = 0;
    for (vi < VEC_COUNT) {
        val sh: VecShape = vec_shape(vi);
        val res_vec: R.Result[TypeId, str] = intern_vector(ti, sh.element, sh.lanes);
        if (R.is_err[TypeId, str](res_vec)) {
            dnit(ti);
            ret O.some[str](R.unwrap_err[TypeId, str](res_vec));
        }
        ti.vecs[vi] = R.unwrap_ok[TypeId, str](res_vec);
        vi = vi + 1;
    }

    ret O.none[str]();
}

pub fun dnit(ti: *TypeInterner) {
    if (ti == nil) { ret; }

    handle.chunk_dnit[Type](?ti.types);
    if (ti.params != nil && ti.params_cap > 0) {
        A.deallocate[TypeId](ti.a, ti.params, ti.params_cap::usize);
    }
    if (ti.handles != nil && ti.handles_cap > 0) {
        A.deallocate[TypeId](ti.a, ti.handles, ti.handles_cap::usize);
    }
    if (ti.handle_ops != nil && ti.handle_ops_cap > 0) {
        A.deallocate[u32](ti.a, ti.handle_ops, ti.handle_ops_cap::usize);
    }
    handle.chunk_dnit[FieldTable](?ti.field_tables);
    handle.chunk_dnit[FieldEntry](?ti.field_pool);
    if (ti.visits != nil && ti.visits_cap > 0) {
        var vi: u32 = 0;
        for (vi < ti.visits_cap) {
            if (ti.visits[vi].stamp != nil && ti.visits[vi].cap > 0) {
                A.deallocate[u32](ti.a, ti.visits[vi].stamp, ti.visits[vi].cap::usize);
            }
            vi = vi + 1;
        }
        A.deallocate[VisitSet](ti.a, ti.visits, ti.visits_cap::usize);
    }
    if (ti.pairs != nil && ti.pairs_cap > 0) {
        var pi: u32 = 0;
        for (pi < ti.pairs_cap) {
            map.dnit[u64, u32](?ti.pairs[pi].seen);
            pi = pi + 1;
        }
        A.deallocate[PairSet](ti.a, ti.pairs, ti.pairs_cap::usize);
    }
    if (ti.gparam != nil && ti.gparam_cap > 0) {
        A.deallocate[u8](ti.a, ti.gparam, ti.gparam_cap::usize);
    }

    map.dnit[Type, TypeId](?ti.dedup);
    map.dnit[u64, TypeId](?ti.fun_index);
    map.dnit[u64, TypeId](?ti.instance_index);
    map.dnit[TypeId, u32](?ti.field_index);

    ti.params     = nil;
    ti.params_len = 0;
    ti.params_cap = 0;

    ti.handles     = nil;
    ti.handles_len = 0;
    ti.handles_cap = 0;
    ti.handle_ops     = nil;
    ti.handle_ops_len = 0;
    ti.handle_ops_cap = 0;

    ti.field_epoch = 0;

    ti.visits     = nil;
    ti.visits_len = 0;
    ti.visits_cap = 0;

    ti.pairs     = nil;
    ti.pairs_len = 0;
    ti.pairs_cap = 0;

    ti.gparam       = nil;
    ti.gparam_cap   = 0;
    ti.gparam_epoch = 0;
}

pub fun get(ti: *TypeInterner, tid: TypeId) O.Option[*Type] {
    val r: R.Result[*Type, str] = handle.chunk_get[Type](?ti.types, tid::usize);
    if (R.is_err[*Type, str](r)) { ret O.none[*Type](); }
    ret O.some[*Type](R.unwrap_ok[*Type, str](r));
}

pub fun type_count(ti: *TypeInterner) u32 {
    ret handle.chunk_count[Type](?ti.types)::u32;
}

pub fun get_param(ti: *TypeInterner, index: u32) O.Option[TypeId] {
    if (index >= ti.params_len) { ret O.none[TypeId](); }
    ret O.some[TypeId](ti.params[index]);
}

pub fun prim(ti: *TypeInterner, kind: TypeKind) O.Option[TypeId] {
    if (kind >= PRIM_COUNT) { ret O.none[TypeId](); }
    ret O.some[TypeId](ti.prims[kind]);
}

pub fun is_integer(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: O.Option[*Type] = get(ti, strip_secret(ti, tid));
    if (O.is_none[*Type](opt_type)) { ret false; }
    ret prim_desc(O.unwrap[*Type](opt_type).kind).class == PRIM_CLASS_INT;
}

pub fun is_numeric(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: O.Option[*Type] = get(ti, strip_secret(ti, tid));
    if (O.is_none[*Type](opt_type)) { ret false; }
    val c: PrimClass = prim_desc(O.unwrap[*Type](opt_type).kind).class;
    ret c == PRIM_CLASS_INT || c == PRIM_CLASS_FLOAT;
}

pub fun is_float(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: O.Option[*Type] = get(ti, strip_secret(ti, tid));
    if (O.is_none[*Type](opt_type)) { ret false; }
    ret prim_desc(O.unwrap[*Type](opt_type).kind).class == PRIM_CLASS_FLOAT;
}

pub fun is_pointer_like(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: O.Option[*Type] = get(ti, strip_secret(ti, tid));
    if (O.is_none[*Type](opt_type)) { ret false; }
    val k: TypeKind = O.unwrap[*Type](opt_type).kind;
    ret k == TYPE_PTR || k == TYPE_POINTER || k == TYPE_FUN;
}

pub fun is_secret(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: O.Option[*Type] = get(ti, tid);
    if (O.is_none[*Type](opt_type)) { ret false; }
    ret O.unwrap[*Type](opt_type).kind == TYPE_SECRET;
}

pub fun is_vector(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: O.Option[*Type] = get(ti, strip_secret(ti, tid));
    if (O.is_none[*Type](opt_type)) { ret false; }
    ret O.unwrap[*Type](opt_type).kind == TYPE_VECTOR;
}

pub fun vector_element(ti: *TypeInterner, tid: TypeId) TypeKind {
    val opt_type: O.Option[*Type] = get(ti, strip_secret(ti, tid));
    if (O.is_none[*Type](opt_type)) { ret TYPE_VECTOR; }
    val t: *Type = O.unwrap[*Type](opt_type);
    if (t.kind != TYPE_VECTOR) { ret TYPE_VECTOR; }
    ret t.data.vector.element;
}

pub fun vector_lanes(ti: *TypeInterner, tid: TypeId) u32 {
    val opt_type: O.Option[*Type] = get(ti, strip_secret(ti, tid));
    if (O.is_none[*Type](opt_type)) { ret 0; }
    val t: *Type = O.unwrap[*Type](opt_type);
    if (t.kind != TYPE_VECTOR) { ret 0; }
    ret t.data.vector.lanes;
}

pub fun element_count(ti: *TypeInterner, tid: TypeId) O.Option[u32] {
    if (tid == TYPE_NIL || tid == TYPE_ERROR) { ret O.none[u32](); }
    val t_opt: O.Option[*Type] = get(ti, strip_secret(ti, tid));
    if (O.is_none[*Type](t_opt)) { ret O.none[u32](); }
    val t: *Type = O.unwrap[*Type](t_opt);
    if (t.kind == TYPE_ARRAY)  { ret O.some[u32](t.data.array.count); }
    if (t.kind == TYPE_VECTOR) { ret O.some[u32](t.data.vector.lanes); }
    ret O.none[u32]();
}

pub fun vec(ti: *TypeInterner, index: u32) O.Option[TypeId] {
    if (index >= VEC_COUNT) { ret O.none[TypeId](); }
    ret O.some[TypeId](ti.vecs[index]);
}

pub fun vector_mask(ti: *TypeInterner, tid: TypeId) R.Result[TypeId, str] {
    val element: TypeKind = vector_element(ti, tid);
    val lanes:   u32      = vector_lanes(ti, tid);
    val bits:    u32      = prim_desc(element).bits;

    var mask_elem: TypeKind = TYPE_U8;
    if      (bits == 8)  { mask_elem = TYPE_U8;  }
    or (bits == 16) { mask_elem = TYPE_U16; }
    or (bits == 32) { mask_elem = TYPE_U32; }
    or (bits == 64) { mask_elem = TYPE_U64; }

    ret intern_vector(ti, mask_elem, lanes);
}

pub fun strip_secret(ti: *TypeInterner, tid: TypeId) TypeId {
    val opt_type: O.Option[*Type] = get(ti, tid);
    if (O.is_none[*Type](opt_type)) { ret tid; }
    val t: *Type = O.unwrap[*Type](opt_type);
    if (t.kind != TYPE_SECRET) { ret tid; }
    ret t.data.secret.base;
}

pub fun shape_kind(ti: *TypeInterner, tid: TypeId) TypeKind {
    if (tid == TYPE_NIL || tid == TYPE_ERROR) { ret TYPE_U8; }
    val base: TypeId = strip_secret(ti, tid);
    val t_opt: O.Option[*Type] = get(ti, base);
    if (O.is_none[*Type](t_opt)) { ret TYPE_U8; }
    val t: *Type = O.unwrap[*Type](t_opt);
    if (t.kind != TYPE_INSTANCE) { ret t.kind; }

    val nom: TypeId = t.data.instance.nominal;
    if (nom == TYPE_ERROR || nom == base) { ret t.kind; }
    val n_opt: O.Option[*Type] = get(ti, nom);
    if (O.is_none[*Type](n_opt)) { ret t.kind; }
    ret O.unwrap[*Type](n_opt).kind;
}

pub fun is_u8(ti: *TypeInterner, tid: TypeId) bool {
    if (tid == TYPE_NIL || tid == TYPE_ERROR) { ret false; }
    val base: TypeId = strip_secret(ti, tid);
    if (O.is_none[*Type](get(ti, base))) { ret false; }
    ret shape_kind(ti, base) == TYPE_U8;
}

pub fun carries_secret(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: O.Option[*Type] = get(ti, tid);
    if (O.is_none[*Type](opt_type)) { ret false; }
    val t: *Type = O.unwrap[*Type](opt_type);
    if (t.kind == TYPE_SECRET)  { ret true; }
    if (t.kind == TYPE_POINTER) { ret carries_secret(ti, t.data.pointer.base); }
    if (t.kind == TYPE_ARRAY)   { ret carries_secret(ti, t.data.array.base); }
    ret false;
}

rec VisitSet {
    stamp: *u32;
    cap:   u32;
    epoch: u32;
}

pub rec TypeScan {
    level: u32;
}

val SCAN_NONE: u32 = 0xFFFFFFFF;

pub def VisitMark: u8;

pub val VISIT_FRESH:  VisitMark = 0;
pub val VISIT_SEEN:   VisitMark = 1;
pub val VISIT_FAILED: VisitMark = 2;

pub fun type_scan_begin(ti: *TypeInterner, scan: *TypeScan) {
    if (O.is_some[str](visits_reserve(ti))) {
        scan.level = SCAN_NONE;
        ret;
    }

    val level: u32 = ti.visits_len;
    ti.visits_len  = ti.visits_len + 1;

    if (ti.visits[level].epoch == 0xFFFFFFFF) {
        if (ti.visits[level].stamp != nil && ti.visits[level].cap > 0) {
            memory.zero[u32](ti.visits[level].stamp, ti.visits[level].cap::usize);
        }
        ti.visits[level].epoch = 1;
    }
    or {
        ti.visits[level].epoch = ti.visits[level].epoch + 1;
    }

    scan.level = level;
}

pub fun type_scan_end(ti: *TypeInterner, scan: *TypeScan) {
    if (scan.level == SCAN_NONE) { ret; }
    ti.visits_len = scan.level;
    scan.level    = SCAN_NONE;
}

pub fun type_scan_mark(ti: *TypeInterner, scan: *TypeScan, tid: TypeId) VisitMark {
    if (scan.level == SCAN_NONE) { ret VISIT_FAILED; }

    if (tid >= ti.visits[scan.level].cap) {
        if (O.is_some[str](visit_reserve(ti, scan.level, tid))) { ret VISIT_FAILED; }
    }

    val set: *VisitSet = ?ti.visits[scan.level];
    if (set.stamp[tid] == set.epoch) { ret VISIT_SEEN; }
    set.stamp[tid] = set.epoch;
    ret VISIT_FRESH;
}

fun visits_reserve(ti: *TypeInterner) O.Option[str] {
    if (ti.visits_len < ti.visits_cap) { ret O.none[str](); }

    val old_cap: u32 = ti.visits_cap;
    val grown: R.Result[R.Void, str] = grow_cap[VisitSet](ti.a, ?ti.visits, ?ti.visits_cap, INITIAL_VISIT_DEPTH);
    if (R.is_err[R.Void, str](grown)) { ret O.some[str](R.unwrap_err[R.Void, str](grown)); }

    var i: u32 = old_cap;
    for (i < ti.visits_cap) {
        ti.visits[i].stamp = nil;
        ti.visits[i].cap   = 0;
        ti.visits[i].epoch = 0;
        i = i + 1;
    }

    ret O.none[str]();
}

fun visit_reserve(ti: *TypeInterner, level: u32, tid: TypeId) O.Option[str] {
    val set: *VisitSet = ?ti.visits[level];

    var base_cap: u32 = set.cap;
    if (base_cap == 0) { base_cap = INITIAL_VISIT_CAP; }

    val required_r: R.Result[layout.CheckedCount[u32], layout.CheckCause] =
        layout.count_add[u32](layout.count[u32](tid::usize), layout.count[u32](1::usize));
    if (R.is_err[layout.CheckedCount[u32], layout.CheckCause](required_r)) {
        ret O.some[str]("type: visit-set requirement overflow");
    }
    val required: layout.CheckedCount[u32] = R.unwrap_ok[layout.CheckedCount[u32], layout.CheckCause](required_r);
    val grown_r: R.Result[layout.CheckedCount[u32], layout.CheckCause] =
        layout.count_grow[u32](layout.count[u32](base_cap::usize), required);
    if (R.is_err[layout.CheckedCount[u32], layout.CheckCause](grown_r)) {
        ret O.some[str]("type: visit-set growth count overflow");
    }
    val new_cap_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
        R.unwrap_ok[layout.CheckedCount[u32], layout.CheckCause](grown_r).value);
    if (R.is_err[u32, layout.CheckCause](new_cap_fits)) {
        ret O.some[str]("type: visit-set capacity exceeds the u32 limit");
    }
    val new_cap: u32 = R.unwrap_ok[u32, layout.CheckCause](new_cap_fits);

    if (set.stamp == nil) {
        val res_alloc: R.Result[*u32, str] = A.allocate[u32](ti.a, new_cap::usize);
        if (R.is_err[*u32, str](res_alloc)) {
            ret O.some[str](R.unwrap_err[*u32, str](res_alloc));
        }
        set.stamp = R.unwrap_ok[*u32, str](res_alloc);
    }
    or {
        val res_realloc: R.Result[*u32, str] = A.reallocate[u32](ti.a, set.stamp, set.cap::usize, new_cap::usize);
        if (R.is_err[*u32, str](res_realloc)) {
            ret O.some[str](R.unwrap_err[*u32, str](res_realloc));
        }
        set.stamp = R.unwrap_ok[*u32, str](res_realloc);
    }

    memory.zero[u32](?set.stamp[set.cap], (new_cap - set.cap)::usize);
    set.cap = new_cap;

    ret O.none[str]();
}

rec PairSet {
    seen:  map.Map[u64, u32];
    epoch: u32;
}

pub rec PairScan {
    level: u32;
}

pub fun pair_scan_begin(ti: *TypeInterner, scan: *PairScan) {
    if (O.is_some[str](pairs_reserve(ti))) {
        scan.level = SCAN_NONE;
        ret;
    }

    val level: u32 = ti.pairs_len;
    ti.pairs_len   = ti.pairs_len + 1;

    if (ti.pairs[level].epoch == 0xFFFFFFFF) {
        map.clear[u64, u32](?ti.pairs[level].seen);
        ti.pairs[level].epoch = 1;
    }
    or {
        ti.pairs[level].epoch = ti.pairs[level].epoch + 1;
    }

    scan.level = level;
}

pub fun pair_scan_end(ti: *TypeInterner, scan: *PairScan) {
    if (scan.level == SCAN_NONE) { ret; }
    ti.pairs_len = scan.level;
    scan.level   = SCAN_NONE;
}

pub fun pair_scan_mark(ti: *TypeInterner, scan: *PairScan, a: TypeId, b: TypeId) VisitMark {
    if (scan.level == SCAN_NONE) { ret VISIT_FAILED; }

    val set: *PairSet = ?ti.pairs[scan.level];
    var key: u64      = (a::u64 << 32) | b::u64;

    val got: R.Result[*u32, str] = map.get[u64, u32](?set.seen, ?key);
    if (R.is_ok[*u32, str](got)) {
        val slot: *u32 = R.unwrap_ok[*u32, str](got);
        if (slot[0] == set.epoch) { ret VISIT_SEEN; }
        slot[0] = set.epoch;
        ret VISIT_FRESH;
    }

    if (R.is_err[bool, str](map.insert[u64, u32](?set.seen, key, set.epoch))) { ret VISIT_FAILED; }
    ret VISIT_FRESH;
}

fun pairs_reserve(ti: *TypeInterner) O.Option[str] {
    if (ti.pairs_len < ti.pairs_cap) { ret O.none[str](); }

    val old_cap: u32 = ti.pairs_cap;
    val grown: R.Result[R.Void, str] = grow_cap[PairSet](ti.a, ?ti.pairs, ?ti.pairs_cap, INITIAL_VISIT_DEPTH);
    if (R.is_err[R.Void, str](grown)) { ret O.some[str](R.unwrap_err[R.Void, str](grown)); }

    var i: u32 = old_cap;
    for (i < ti.pairs_cap) {
        ti.pairs[i].seen  = map.init[u64, u32](ti.a, map.hash_u64, map.eq_u64);
        ti.pairs[i].epoch = 0;
        i = i + 1;
    }

    ret O.none[str]();
}

pub def GParamMemo: u8;

pub val GPARAM_UNKNOWN: GParamMemo = 0;
pub val GPARAM_NO:      GParamMemo = 1;
pub val GPARAM_YES:     GParamMemo = 2;

pub fun gparam_memo_get(ti: *TypeInterner, tid: TypeId) GParamMemo {
    if (ti.gparam_epoch != ti.field_epoch) {
        if (ti.gparam != nil && ti.gparam_cap > 0) {
            memory.zero[u8](ti.gparam, ti.gparam_cap::usize);
        }
        ti.gparam_epoch = ti.field_epoch;
    }
    if (ti.gparam == nil || tid >= ti.gparam_cap) { ret GPARAM_UNKNOWN; }
    ret ti.gparam[tid];
}

pub fun gparam_memo_set(ti: *TypeInterner, tid: TypeId, mentions: bool) {
    if (ti.gparam_epoch != ti.field_epoch) {
        if (ti.gparam != nil && ti.gparam_cap > 0) {
            memory.zero[u8](ti.gparam, ti.gparam_cap::usize);
        }
        ti.gparam_epoch = ti.field_epoch;
    }
    if (tid >= ti.gparam_cap) {
        if (O.is_some[str](gparam_reserve(ti, tid))) { ret; }
    }
    if (mentions) { ti.gparam[tid] = GPARAM_YES; }
    or           { ti.gparam[tid] = GPARAM_NO; }
}

fun gparam_reserve(ti: *TypeInterner, tid: TypeId) O.Option[str] {
    var base_cap: u32 = ti.gparam_cap;
    if (base_cap == 0) { base_cap = INITIAL_VISIT_CAP; }

    val required_r: R.Result[layout.CheckedCount[u8], layout.CheckCause] =
        layout.count_add[u8](layout.count[u8](tid::usize), layout.count[u8](1::usize));
    if (R.is_err[layout.CheckedCount[u8], layout.CheckCause](required_r)) {
        ret O.some[str]("type: gparam memo requirement overflow");
    }
    val required: layout.CheckedCount[u8] = R.unwrap_ok[layout.CheckedCount[u8], layout.CheckCause](required_r);
    val grown_r: R.Result[layout.CheckedCount[u8], layout.CheckCause] =
        layout.count_grow[u8](layout.count[u8](base_cap::usize), required);
    if (R.is_err[layout.CheckedCount[u8], layout.CheckCause](grown_r)) {
        ret O.some[str]("type: gparam memo growth count overflow");
    }
    val new_cap_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
        R.unwrap_ok[layout.CheckedCount[u8], layout.CheckCause](grown_r).value);
    if (R.is_err[u32, layout.CheckCause](new_cap_fits)) {
        ret O.some[str]("type: gparam memo capacity exceeds the u32 limit");
    }
    val new_cap: u32 = R.unwrap_ok[u32, layout.CheckCause](new_cap_fits);

    if (ti.gparam == nil) {
        val res_alloc: R.Result[*u8, str] = A.allocate[u8](ti.a, new_cap::usize);
        if (R.is_err[*u8, str](res_alloc)) {
            ret O.some[str](R.unwrap_err[*u8, str](res_alloc));
        }
        ti.gparam = R.unwrap_ok[*u8, str](res_alloc);
    }
    or {
        val res_realloc: R.Result[*u8, str] = A.reallocate[u8](ti.a, ti.gparam, ti.gparam_cap::usize, new_cap::usize);
        if (R.is_err[*u8, str](res_realloc)) {
            ret O.some[str](R.unwrap_err[*u8, str](res_realloc));
        }
        ti.gparam = R.unwrap_ok[*u8, str](res_realloc);
    }

    memory.zero[u8](?ti.gparam[ti.gparam_cap], (new_cap - ti.gparam_cap)::usize);
    ti.gparam_cap = new_cap;

    ret O.none[str]();
}

pub fun secrecy_structure_equal(ti: *TypeInterner, a: TypeId, b: TypeId) bool {
    val a_secret: bool = is_secret(ti, a);
    val b_secret: bool = is_secret(ti, b);
    if (a_secret != b_secret) { ret false; }

    val sa: TypeId = strip_secret(ti, a);
    val sb: TypeId = strip_secret(ti, b);

    val oa: O.Option[*Type] = get(ti, sa);
    val ob: O.Option[*Type] = get(ti, sb);
    if (O.is_none[*Type](oa) || O.is_none[*Type](ob)) { ret true; }
    val ta: *Type = O.unwrap[*Type](oa);
    val tb: *Type = O.unwrap[*Type](ob);

    if (ta.kind == TYPE_POINTER && tb.kind == TYPE_POINTER) {
        ret secrecy_structure_equal(ti, ta.data.pointer.base, tb.data.pointer.base);
    }
    if (ta.kind == TYPE_ARRAY && tb.kind == TYPE_ARRAY) {
        ret secrecy_structure_equal(ti, ta.data.array.base, tb.data.array.base);
    }
    ret true;
}

pub fun intern_pointer(ti: *TypeInterner, base: TypeId) R.Result[TypeId, str] {
    var t: Type;
    t.kind              = TYPE_POINTER;
    t.data.pointer.base = base;
    ret intern_dedup(ti, t);
}

pub fun intern_secret(ti: *TypeInterner, base: TypeId) R.Result[TypeId, str] {
    if (base == TYPE_ERROR) { ret R.ok[TypeId, str](TYPE_ERROR); }
    if (is_secret(ti, base)) { ret R.ok[TypeId, str](base); }
    var t: Type;
    t.kind             = TYPE_SECRET;
    t.data.secret.base = base;
    ret intern_dedup(ti, t);
}

pub fun intern_array(ti: *TypeInterner, base: TypeId, count: u32) R.Result[TypeId, str] {
    var t: Type;
    t.kind             = TYPE_ARRAY;
    t.data.array.base  = base;
    t.data.array.count = count;
    ret intern_dedup(ti, t);
}

pub fun intern_vector(ti: *TypeInterner, element: TypeKind, lanes: u32) R.Result[TypeId, str] {
    var t: Type;
    t.kind                = TYPE_VECTOR;
    t.data.vector.element = element;
    t.data.vector.lanes   = lanes;
    ret intern_dedup(ti, t);
}

pub fun intern_handle(ti: *TypeInterner, name: intern.StrId, ctor: u32, ops: *u32, count: u32) R.Result[TypeId, str] {
    var i: u32 = 0;
    for (i < ti.handles_len) {
        val tid:  TypeId = ti.handles[i];
        val cand: *Type  = R.unwrap_ok[*Type, str](handle.chunk_get[Type](?ti.types, tid::usize));
        if (cand.data.handle.ctor == ctor && cand.data.handle.ops_len == count) {
            var ops_match: bool = true;
            var oi:        u32  = 0;
            for (oi < count) {
                if (ti.handle_ops[cand.data.handle.ops_start + oi] != ops[oi]) {
                    ops_match = false;
                    brk;
                }
                oi = oi + 1;
            }
            if (ops_match) { ret R.ok[TypeId, str](tid); }
        }
        i = i + 1;
    }

    val res_start: R.Result[u32, str] = handle_ops_append(ti, ops, count);
    if (R.is_err[u32, str](res_start)) {
        ret R.err[TypeId, str](R.unwrap_err[u32, str](res_start));
    }

    var t: Type;
    t.kind                  = TYPE_HANDLE;
    t.data.handle.name      = name;
    t.data.handle.ctor      = ctor;
    t.data.handle.ops_start = R.unwrap_ok[u32, str](res_start);
    t.data.handle.ops_len   = count;

    val res_append: R.Result[TypeId, str] = append_type(ti, t);
    if (R.is_err[TypeId, str](res_append)) { ret res_append; }
    val tid: TypeId = R.unwrap_ok[TypeId, str](res_append);

    val res_track: R.Result[R.Void, str] = track_handle(ti, tid);
    if (R.is_err[R.Void, str](res_track)) {
        ret R.err[TypeId, str](R.unwrap_err[R.Void, str](res_track));
    }
    ret R.ok[TypeId, str](tid);
}

pub fun is_handle(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: O.Option[*Type] = get(ti, tid);
    if (O.is_none[*Type](opt_type)) { ret false; }
    ret O.unwrap[*Type](opt_type).kind == TYPE_HANDLE;
}

pub fun intern_abi_type(ti: *TypeInterner, name: intern.StrId, tag: u32, size: u32,
                        align: u32) R.Result[TypeId, str] {
    var t: Type;
    t.kind           = TYPE_ABI;
    t.data.abi.name  = name;
    t.data.abi.tag   = tag;
    t.data.abi.size  = size;
    t.data.abi.align = align;
    ret intern_dedup(ti, t);
}

pub fun is_abi_type(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: O.Option[*Type] = get(ti, tid);
    if (O.is_none[*Type](opt_type)) { ret false; }
    ret O.unwrap[*Type](opt_type).kind == TYPE_ABI;
}

pub fun handle_operand(ti: *TypeInterner, tid: TypeId, index: u32) u32 {
    val opt_type: O.Option[*Type] = get(ti, tid);
    if (O.is_none[*Type](opt_type)) { ret 0; }
    val t: *Type = O.unwrap[*Type](opt_type);
    if (t.kind != TYPE_HANDLE)          { ret 0; }
    if (index >= t.data.handle.ops_len) { ret 0; }
    ret ti.handle_ops[t.data.handle.ops_start + index];
}

fun handle_ops_append(ti: *TypeInterner, src: *u32, len: u32) R.Result[u32, str] {
    val start: u32 = ti.handle_ops_len;

    val required_r: R.Result[layout.CheckedCount[u32], layout.CheckCause] =
        layout.count_add[u32](layout.count[u32](ti.handle_ops_len::usize), layout.count[u32](len::usize));
    if (R.is_err[layout.CheckedCount[u32], layout.CheckCause](required_r)) {
        ret R.err[u32, str]("type: handle-operand append count overflow");
    }
    val required: layout.CheckedCount[u32] = R.unwrap_ok[layout.CheckedCount[u32], layout.CheckCause](required_r);

    if (required.value > ti.handle_ops_cap::usize) {
        var base_cap: usize = ti.handle_ops_cap::usize;
        if (base_cap == 0) { base_cap = INITIAL_INSTANCE_CAP::usize; }
        val grown_r: R.Result[layout.CheckedCount[u32], layout.CheckCause] =
            layout.count_grow[u32](layout.count[u32](base_cap), required);
        if (R.is_err[layout.CheckedCount[u32], layout.CheckCause](grown_r)) {
            ret R.err[u32, str]("type: handle-operand growth count overflow");
        }
        val new_cap_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
            R.unwrap_ok[layout.CheckedCount[u32], layout.CheckCause](grown_r).value);
        if (R.is_err[u32, layout.CheckCause](new_cap_fits)) {
            ret R.err[u32, str]("type: handle-operand capacity exceeds the u32 limit");
        }
        val new_cap: u32 = R.unwrap_ok[u32, layout.CheckCause](new_cap_fits);

        if (ti.handle_ops == nil) {
            val res_a: R.Result[*u32, str] = A.allocate[u32](ti.a, new_cap::usize);
            if (R.is_err[*u32, str](res_a)) { ret R.err[u32, str](R.unwrap_err[*u32, str](res_a)); }
            ti.handle_ops = R.unwrap_ok[*u32, str](res_a);
        }
        or {
            val res_ra: R.Result[*u32, str] = A.reallocate[u32](ti.a, ti.handle_ops, ti.handle_ops_cap::usize, new_cap::usize);
            if (R.is_err[*u32, str](res_ra)) { ret R.err[u32, str](R.unwrap_err[*u32, str](res_ra)); }
            ti.handle_ops = R.unwrap_ok[*u32, str](res_ra);
        }
        ti.handle_ops_cap = new_cap;
    }

    var i: u32 = 0;
    for (i < len) {
        ti.handle_ops[start + i] = src[i];
        i = i + 1;
    }
    val new_len_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(required.value);
    if (R.is_err[u32, layout.CheckCause](new_len_fits)) {
        ret R.err[u32, str]("type: handle-operand length exceeds the u32 limit");
    }
    ti.handle_ops_len = R.unwrap_ok[u32, layout.CheckCause](new_len_fits);
    ret R.ok[u32, str](start);
}

fun track_handle(ti: *TypeInterner, tid: TypeId) R.Result[R.Void, str] {
    if (ti.handles_len == ti.handles_cap) {
        val grown: R.Result[R.Void, str] = grow_cap[TypeId](ti.a, ?ti.handles, ?ti.handles_cap, INITIAL_INSTANCE_CAP);
        if (R.is_err[R.Void, str](grown)) { ret grown; }
    }

    ti.handles[ti.handles_len] = tid;
    ti.handles_len = ti.handles_len + 1;
    ret R.ok_void[str]();
}

pub fun intern_pack(ti: *TypeInterner) R.Result[TypeId, str] {
    var t: Type;
    t.kind = TYPE_PACK;
    ret intern_dedup(ti, t);
}

pub fun intern_nominal(ti: *TypeInterner, name: intern.StrId, origin: module.ModuleId, decl: id.DeclId, kind: TypeKind) R.Result[TypeId, str] {
    var t: Type;
    t.kind                = kind;
    t.data.nominal.name   = name;
    t.data.nominal.origin = origin;
    t.data.nominal.decl   = decl;
    ret intern_dedup(ti, t);
}

pub fun intern_generic_param(ti: *TypeInterner, name: intern.StrId, origin: module.ModuleId, owner: id.DeclId, index: u32) R.Result[TypeId, str] {
    var t: Type;
    t.kind                      = TYPE_GENERIC_PARAM;
    t.data.generic_param.name   = name;
    t.data.generic_param.origin = origin;
    t.data.generic_param.owner  = owner;
    t.data.generic_param.index  = index;
    ret intern_dedup(ti, t);
}

pub fun intern_function(ti: *TypeInterner, ret_type: TypeId, params: *TypeId, count: u32, c_variadic: bool) R.Result[TypeId, str] {
    val h: u64 = hash_fun(ret_type, params, count, c_variadic);

    val res_get: R.Result[*TypeId, str] = map.get[u64, TypeId](?ti.fun_index, ?h);
    if (R.is_ok[*TypeId, str](res_get)) {
        val existing: TypeId = @R.unwrap_ok[*TypeId, str](res_get);
        if (fun_matches(ti, existing, ret_type, params, count, c_variadic)) {
            ret R.ok[TypeId, str](existing);
        }
    }

    val res_start: R.Result[u32, str] = params_append(ti, params, count);
    if (R.is_err[u32, str](res_start)) {
        ret R.err[TypeId, str](R.unwrap_err[u32, str](res_start));
    }
    val start: u32 = R.unwrap_ok[u32, str](res_start);

    var t: Type;
    t.kind                 = TYPE_FUN;
    t.data.fn.ret_type     = ret_type;
    t.data.fn.params_start = start;
    t.data.fn.params_len   = count;
    t.data.fn.c_variadic   = c_variadic;

    val res_append: R.Result[TypeId, str] = append_type(ti, t);
    if (R.is_err[TypeId, str](res_append)) {
        ret res_append;
    }
    val tid: TypeId = R.unwrap_ok[TypeId, str](res_append);

    val res_insert: R.Result[bool, str] = map.insert[u64, TypeId](?ti.fun_index, h, tid);
    if (R.is_err[bool, str](res_insert)) {
        ret R.err[TypeId, str](R.unwrap_err[bool, str](res_insert));
    }

    ret R.ok[TypeId, str](tid);
}

fun hash_instance(target_origin: module.ModuleId, target_decl: id.DeclId, args: *TypeId, count: u32) u64 {
    var h: u64 = fnv1a.FNV_INIT;
    h = fnv1a.step_u8(h, TYPE_INSTANCE::u8);
    h = fnv1a.step_u32(h, target_origin::u32);
    h = fnv1a.step_u32(h, target_decl::u32);
    h = fnv1a.step_u32(h, count);

    var i: u32 = 0;
    for (i < count) {
        h = fnv1a.step_u32(h, args[i]::u32);
        i = i + 1;
    }
    ret h;
}

fun instance_matches(ti: *TypeInterner, tid: TypeId, target_origin: module.ModuleId, target_decl: id.DeclId, args: *TypeId, count: u32) bool {
    val r: R.Result[*Type, str] = handle.chunk_get[Type](?ti.types, tid::usize);
    if (R.is_err[*Type, str](r)) { ret false; }
    val cand: *Type = R.unwrap_ok[*Type, str](r);
    if (cand.kind != TYPE_INSTANCE)                        { ret false; }
    if (cand.data.instance.target_origin != target_origin) { ret false; }
    if (cand.data.instance.target_decl != target_decl)     { ret false; }
    if (cand.data.instance.args_len != count)               { ret false; }

    var i: u32 = 0;
    for (i < count) {
        if (ti.params[cand.data.instance.args_start + i] != args[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun intern_instance(ti: *TypeInterner, nominal: TypeId, target_origin: module.ModuleId, target_decl: id.DeclId, args: *TypeId, count: u32) R.Result[TypeId, str] {
    val h: u64 = hash_instance(target_origin, target_decl, args, count);

    val res_get: R.Result[*TypeId, str] = map.get[u64, TypeId](?ti.instance_index, ?h);
    if (R.is_ok[*TypeId, str](res_get)) {
        val existing: TypeId = @R.unwrap_ok[*TypeId, str](res_get);
        if (instance_matches(ti, existing, target_origin, target_decl, args, count)) {
            ret R.ok[TypeId, str](existing);
        }
    }

    val res_start: R.Result[u32, str] = params_append(ti, args, count);
    if (R.is_err[u32, str](res_start)) {
        ret R.err[TypeId, str](R.unwrap_err[u32, str](res_start));
    }
    val start: u32 = R.unwrap_ok[u32, str](res_start);

    var t: Type;
    t.kind                        = TYPE_INSTANCE;
    t.data.instance.nominal       = nominal;
    t.data.instance.target_origin = target_origin;
    t.data.instance.target_decl   = target_decl;
    t.data.instance.args_start    = start;
    t.data.instance.args_len      = count;

    val res_append: R.Result[TypeId, str] = append_type(ti, t);
    if (R.is_err[TypeId, str](res_append)) {
        ret res_append;
    }
    val tid: TypeId = R.unwrap_ok[TypeId, str](res_append);

    val res_insert: R.Result[bool, str] = map.insert[u64, TypeId](?ti.instance_index, h, tid);
    if (R.is_err[bool, str](res_insert)) {
        ret R.err[TypeId, str](R.unwrap_err[bool, str](res_insert));
    }

    ret R.ok[TypeId, str](tid);
}

pub fun type_equals_signatures(ti: *TypeInterner, a: TypeId, b: TypeId) bool {
    if (a == b) { ret true; }

    val ra: R.Result[*Type, str] = handle.chunk_get[Type](?ti.types, a::usize);
    val rb: R.Result[*Type, str] = handle.chunk_get[Type](?ti.types, b::usize);
    if (R.is_err[*Type, str](ra) || R.is_err[*Type, str](rb)) { ret false; }

    val ta: *Type = R.unwrap_ok[*Type, str](ra);
    val tb: *Type = R.unwrap_ok[*Type, str](rb);
    if (ta.kind != TYPE_FUN || tb.kind != TYPE_FUN)     { ret false; }
    if (ta.data.fn.ret_type != tb.data.fn.ret_type)     { ret false; }
    if (ta.data.fn.params_len != tb.data.fn.params_len) { ret false; }
    if (ta.data.fn.c_variadic != tb.data.fn.c_variadic) { ret false; }

    var i: u32 = 0;
    for (i < ta.data.fn.params_len) {
        if (ti.params[ta.data.fn.params_start + i] != ti.params[tb.data.fn.params_start + i]) {
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

pub fun field_epoch_bump(ti: *TypeInterner) {
    ti.field_epoch = ti.field_epoch + 1;
}

pub fun field_epoch(ti: *TypeInterner) u32 {
    ret ti.field_epoch;
}

pub fun field_table_stage(ti: *TypeInterner, additional: u32) R.Result[u32, str] {
    val ce_r: R.Result[handle.ChunkEditor[FieldEntry], str] = handle.chunk_edit[FieldEntry](?ti.field_pool);
    if (R.is_err[handle.ChunkEditor[FieldEntry], str](ce_r)) {
        ret R.err[u32, str](R.unwrap_err[handle.ChunkEditor[FieldEntry], str](ce_r));
    }
    var ce: handle.ChunkEditor[FieldEntry] = R.unwrap_ok[handle.ChunkEditor[FieldEntry], str](ce_r);
    val reserve_r: R.Result[R.Void, str] = handle.chunk_reserve[FieldEntry](?ce, additional::usize);
    handle.chunk_editor_finish[FieldEntry](?ce);
    if (R.is_err[R.Void, str](reserve_r)) {
        ret R.err[u32, str](R.unwrap_err[R.Void, str](reserve_r));
    }
    ret R.ok[u32, str](handle.chunk_count[FieldEntry](?ti.field_pool)::u32);
}

pub fun field_table_stage_push(ti: *TypeInterner, name: intern.StrId, ty: TypeId) R.Result[R.Void, str] {
    var fe: FieldEntry;
    fe.name = name;
    fe.ty   = ty;

    val ce_r: R.Result[handle.ChunkEditor[FieldEntry], str] = handle.chunk_edit[FieldEntry](?ti.field_pool);
    if (R.is_err[handle.ChunkEditor[FieldEntry], str](ce_r)) {
        ret R.err[R.Void, str](R.unwrap_err[handle.ChunkEditor[FieldEntry], str](ce_r));
    }
    var ce: handle.ChunkEditor[FieldEntry] = R.unwrap_ok[handle.ChunkEditor[FieldEntry], str](ce_r);
    val push_r: R.Result[*FieldEntry, str] = handle.chunk_push[FieldEntry](?ce, fe);
    handle.chunk_editor_finish[FieldEntry](?ce);
    if (R.is_err[*FieldEntry, str](push_r)) {
        ret R.err[R.Void, str](R.unwrap_err[*FieldEntry, str](push_r));
    }
    ret R.ok_void[str]();
}

pub fun field_table_publish(ti: *TypeInterner, ty: TypeId, fields_start: u32, fields_len: u32) R.Result[R.Void, str] {
    val staged: u32 = handle.chunk_count[FieldEntry](?ti.field_pool)::u32;
    if (fields_start > staged || staged - fields_start < fields_len) {
        ret R.err[R.Void, str]("field table: staged run does not cover the published field count");
    }

    val res_get: R.Result[*u32, str] = map.get[TypeId, u32](?ti.field_index, ?ty);
    if (R.is_ok[*u32, str](res_get)) {
        val idx: u32 = @R.unwrap_ok[*u32, str](res_get);
        val slot_r: R.Result[*FieldTable, str] = handle.chunk_get[FieldTable](?ti.field_tables, idx::usize);
        if (R.is_err[*FieldTable, str](slot_r)) {
            ret R.err[R.Void, str](R.unwrap_err[*FieldTable, str](slot_r));
        }
        val slot: *FieldTable = R.unwrap_ok[*FieldTable, str](slot_r);
        slot.fields_start = fields_start;
        slot.fields_len   = fields_len;
        slot.epoch        = ti.field_epoch;
        ret R.ok_void[str]();
    }

    val ce_r: R.Result[handle.ChunkEditor[FieldTable], str] = handle.chunk_edit[FieldTable](?ti.field_tables);
    if (R.is_err[handle.ChunkEditor[FieldTable], str](ce_r)) {
        ret R.err[R.Void, str](R.unwrap_err[handle.ChunkEditor[FieldTable], str](ce_r));
    }
    var ce: handle.ChunkEditor[FieldTable] = R.unwrap_ok[handle.ChunkEditor[FieldTable], str](ce_r);

    var ft: FieldTable;
    ft.ty           = ty;
    ft.fields_start = fields_start;
    ft.fields_len   = fields_len;
    ft.epoch        = ti.field_epoch;
    val push_r: R.Result[*FieldTable, str] = handle.chunk_push[FieldTable](?ce, ft);
    handle.chunk_editor_finish[FieldTable](?ce);
    if (R.is_err[*FieldTable, str](push_r)) {
        ret R.err[R.Void, str](R.unwrap_err[*FieldTable, str](push_r));
    }

    val idx: u32 = handle.chunk_count[FieldTable](?ti.field_tables)::u32 - 1;
    val res_insert: R.Result[bool, str] = map.insert[TypeId, u32](?ti.field_index, ty, idx);
    if (R.is_err[bool, str](res_insert)) {
        ret R.err[R.Void, str](R.unwrap_err[bool, str](res_insert));
    }

    ret R.ok_void[str]();
}

pub fun aggregate_nominal(ti: *TypeInterner, tid: TypeId) TypeId {
    val opt_t: O.Option[*Type] = get(ti, tid);
    if (O.is_none[*Type](opt_t)) { ret TYPE_ERROR; }
    val t: *Type = O.unwrap[*Type](opt_t);
    if (t.kind == TYPE_REC || t.kind == TYPE_UNI) { ret tid; }
    if (t.kind != TYPE_INSTANCE) { ret TYPE_ERROR; }
    ret t.data.instance.nominal;
}

pub fun is_union(ti: *TypeInterner, tid: TypeId) bool {
    ret nominal_kind_is(ti, tid, TYPE_UNI);
}

pub fun is_record(ti: *TypeInterner, tid: TypeId) bool {
    ret nominal_kind_is(ti, tid, TYPE_REC);
}

fun nominal_kind_is(ti: *TypeInterner, tid: TypeId, want: TypeKind) bool {
    val opt_nom: O.Option[*Type] = get(ti, aggregate_nominal(ti, tid));
    if (O.is_none[*Type](opt_nom)) { ret false; }
    ret O.unwrap[*Type](opt_nom).kind == want;
}

pub fun field_table_for(ti: *TypeInterner, ty: TypeId) O.Option[*FieldTable] {
    val res_get: R.Result[*u32, str] = map.get[TypeId, u32](?ti.field_index, ?ty);
    if (R.is_err[*u32, str](res_get)) {
        ret O.none[*FieldTable]();
    }
    val idx: u32 = @R.unwrap_ok[*u32, str](res_get);
    val slot_r: R.Result[*FieldTable, str] = handle.chunk_get[FieldTable](?ti.field_tables, idx::usize);
    if (R.is_err[*FieldTable, str](slot_r)) { ret O.none[*FieldTable](); }
    val ft: *FieldTable = R.unwrap_ok[*FieldTable, str](slot_r);
    if (ft.epoch != ti.field_epoch) { ret O.none[*FieldTable](); }
    ret O.some[*FieldTable](ft);
}

pub fun field_count(ti: *TypeInterner, ty: TypeId) u32 {
    val opt_ft: O.Option[*FieldTable] = field_table_for(ti, ty);
    if (O.is_none[*FieldTable](opt_ft)) { ret 0; }
    ret O.unwrap[*FieldTable](opt_ft).fields_len;
}

pub fun field_at(ti: *TypeInterner, ty: TypeId, ix: u32) O.Option[*FieldEntry] {
    val opt_ft: O.Option[*FieldTable] = field_table_for(ti, ty);
    if (O.is_none[*FieldTable](opt_ft)) {
        ret O.none[*FieldEntry]();
    }

    val ft: *FieldTable = O.unwrap[*FieldTable](opt_ft);
    if (ix >= ft.fields_len) {
        ret O.none[*FieldEntry]();
    }

    val entry_r: R.Result[*FieldEntry, str] = handle.chunk_get[FieldEntry](?ti.field_pool, (ft.fields_start + ix)::usize);
    if (R.is_err[*FieldEntry, str](entry_r)) { ret O.none[*FieldEntry](); }
    ret O.some[*FieldEntry](R.unwrap_ok[*FieldEntry, str](entry_r));
}

pub fun field_entry_at(ti: *TypeInterner, ft: *FieldTable, ix: u32) *FieldEntry {
    val entry_r: R.Result[*FieldEntry, str] = handle.chunk_get[FieldEntry](?ti.field_pool, (ft.fields_start + ix)::usize);
    if (R.is_err[*FieldEntry, str](entry_r)) { ret nil; }
    ret R.unwrap_ok[*FieldEntry, str](entry_r);
}

fun intern_dedup(ti: *TypeInterner, t: Type) R.Result[TypeId, str] {
    val res_get: R.Result[*TypeId, str] = map.get[Type, TypeId](?ti.dedup, ?t);
    if (R.is_ok[*TypeId, str](res_get)) {
        ret R.ok[TypeId, str](@R.unwrap_ok[*TypeId, str](res_get));
    }

    val res_append: R.Result[TypeId, str] = append_type(ti, t);
    if (R.is_err[TypeId, str](res_append)) {
        ret res_append;
    }
    val tid: TypeId = R.unwrap_ok[TypeId, str](res_append);

    val res_insert: R.Result[bool, str] = map.insert[Type, TypeId](?ti.dedup, t, tid);
    if (R.is_err[bool, str](res_insert)) {
        ret R.err[TypeId, str](R.unwrap_err[bool, str](res_insert));
    }

    ret R.ok[TypeId, str](tid);
}

fun append_type(ti: *TypeInterner, t: Type) R.Result[TypeId, str] {
    val tid: TypeId = handle.chunk_count[Type](?ti.types)::u32;

    val ce_r: R.Result[handle.ChunkEditor[Type], str] = handle.chunk_edit[Type](?ti.types);
    if (R.is_err[handle.ChunkEditor[Type], str](ce_r)) {
        ret R.err[TypeId, str](R.unwrap_err[handle.ChunkEditor[Type], str](ce_r));
    }
    var ce: handle.ChunkEditor[Type] = R.unwrap_ok[handle.ChunkEditor[Type], str](ce_r);

    val push_r: R.Result[*Type, str] = handle.chunk_push[Type](?ce, t);
    handle.chunk_editor_finish[Type](?ce);
    if (R.is_err[*Type, str](push_r)) {
        ret R.err[TypeId, str](R.unwrap_err[*Type, str](push_r));
    }

    ret R.ok[TypeId, str](tid);
}

fun reserve_params(ti: *TypeInterner, need: u32) R.Result[R.Void, str] {
    val required_r: R.Result[layout.CheckedCount[TypeId], layout.CheckCause] =
        layout.count_add[TypeId](layout.count[TypeId](ti.params_len::usize), layout.count[TypeId](need::usize));
    if (R.is_err[layout.CheckedCount[TypeId], layout.CheckCause](required_r)) {
        ret R.err[R.Void, str]("type: params reservation count overflow");
    }
    val required: layout.CheckedCount[TypeId] = R.unwrap_ok[layout.CheckedCount[TypeId], layout.CheckCause](required_r);

    if (required.value <= ti.params_cap::usize) {
        ret R.ok_void[str]();
    }

    var base_cap: usize = ti.params_cap::usize;
    if (base_cap == 0) { base_cap = INITIAL_PARAMS_CAP::usize; }
    val grown_r: R.Result[layout.CheckedCount[TypeId], layout.CheckCause] =
        layout.count_grow[TypeId](layout.count[TypeId](base_cap), required);
    if (R.is_err[layout.CheckedCount[TypeId], layout.CheckCause](grown_r)) {
        ret R.err[R.Void, str]("type: params growth count overflow");
    }
    val new_cap_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
        R.unwrap_ok[layout.CheckedCount[TypeId], layout.CheckCause](grown_r).value);
    if (R.is_err[u32, layout.CheckCause](new_cap_fits)) {
        ret R.err[R.Void, str]("type: params capacity exceeds the u32 limit");
    }
    val new_cap: u32 = R.unwrap_ok[u32, layout.CheckCause](new_cap_fits);

    val res_ra_params: R.Result[*TypeId, str] = A.reallocate[TypeId](ti.a, ti.params, ti.params_cap::usize, new_cap::usize);
    if (R.is_err[*TypeId, str](res_ra_params)) {
        ret R.err[R.Void, str](R.unwrap_err[*TypeId, str](res_ra_params));
    }
    ti.params     = R.unwrap_ok[*TypeId, str](res_ra_params);
    ti.params_cap = new_cap;

    ret R.ok_void[str]();
}

fun params_append(ti: *TypeInterner, src: *TypeId, len: u32) R.Result[u32, str] {
    val start: u32 = ti.params_len;

    val res_reserve: R.Result[R.Void, str] = reserve_params(ti, len);
    if (R.is_err[R.Void, str](res_reserve)) {
        ret R.err[u32, str](R.unwrap_err[R.Void, str](res_reserve));
    }

    var i: u32 = 0;
    for (i < len) {
        ti.params[start + i] = src[i];
        i = i + 1;
    }
    ti.params_len = start + len;

    ret R.ok[u32, str](start);
}

fun hash_fun(ret_type: TypeId, params: *TypeId, count: u32, c_variadic: bool) u64 {
    var h: u64 = fnv1a.FNV_INIT;
    h = fnv1a.step_u8(h, TYPE_FUN::u8);
    h = fnv1a.step_u32(h, ret_type::u32);
    h = fnv1a.step_u32(h, count);
    h = fnv1a.step_u8(h, c_variadic::u8);

    var i: u32 = 0;
    for (i < count) {
        h = fnv1a.step_u32(h, params[i]::u32);
        i = i + 1;
    }
    ret h;
}

fun fun_matches(ti: *TypeInterner, tid: TypeId, ret_type: TypeId, params: *TypeId, count: u32, c_variadic: bool) bool {
    val r: R.Result[*Type, str] = handle.chunk_get[Type](?ti.types, tid::usize);
    if (R.is_err[*Type, str](r)) { ret false; }

    val t: *Type = R.unwrap_ok[*Type, str](r);
    if (t.kind != TYPE_FUN)                 { ret false; }
    if (t.data.fn.ret_type != ret_type)     { ret false; }
    if (t.data.fn.params_len != count)      { ret false; }
    if (t.data.fn.c_variadic != c_variadic) { ret false; }

    var i: u32 = 0;
    for (i < count) {
        if (ti.params[t.data.fn.params_start + i] != params[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun hash_type(p: ptr) u64 {
    val t: *Type = p::*Type;

    var h: u64 = fnv1a.FNV_INIT;
    h = fnv1a.step_u8(h, t.kind::u8);
    if (t.kind == TYPE_POINTER) {
        h = fnv1a.step_u32(h, t.data.pointer.base::u32);
    }
    or (t.kind == TYPE_SECRET) {
        h = fnv1a.step_u32(h, t.data.secret.base::u32);
    }
    or (t.kind == TYPE_ARRAY) {
        h = fnv1a.step_u32(h, t.data.array.base::u32);
        h = fnv1a.step_u32(h, t.data.array.count);
    }
    or (t.kind == TYPE_VECTOR) {
        h = fnv1a.step_u8(h, t.data.vector.element::u8);
        h = fnv1a.step_u32(h, t.data.vector.lanes);
    }
    or (t.kind == TYPE_REC || t.kind == TYPE_UNI) {
        h = fnv1a.step_u32(h, t.data.nominal.origin::u32);
        h = fnv1a.step_u32(h, t.data.nominal.decl::u32);
    }
    or (t.kind == TYPE_GENERIC_PARAM) {
        h = fnv1a.step_u32(h, t.data.generic_param.origin::u32);
        h = fnv1a.step_u32(h, t.data.generic_param.owner::u32);
        h = fnv1a.step_u32(h, t.data.generic_param.index);
    }
    or (t.kind == TYPE_ABI) {
        h = fnv1a.step_u32(h, t.data.abi.tag);
        h = fnv1a.step_u32(h, t.data.abi.size);
        h = fnv1a.step_u32(h, t.data.abi.align);
    }
    ret h;
}

fun eq_type(pa: ptr, pb: ptr) bool {
    val a: *Type = pa::*Type;
    val b: *Type = pb::*Type;
    if (a.kind != b.kind) { ret false; }

    if (a.kind == TYPE_POINTER) {
        ret a.data.pointer.base == b.data.pointer.base;
    }
    if (a.kind == TYPE_SECRET) {
        ret a.data.secret.base == b.data.secret.base;
    }
    if (a.kind == TYPE_ARRAY) {
        ret a.data.array.base == b.data.array.base
            && a.data.array.count == b.data.array.count;
    }
    if (a.kind == TYPE_VECTOR) {
        ret a.data.vector.element == b.data.vector.element
            && a.data.vector.lanes == b.data.vector.lanes;
    }
    if (a.kind == TYPE_REC || a.kind == TYPE_UNI) {
        ret a.data.nominal.origin == b.data.nominal.origin
            && a.data.nominal.decl == b.data.nominal.decl;
    }
    if (a.kind == TYPE_GENERIC_PARAM) {
        ret a.data.generic_param.origin == b.data.generic_param.origin
            && a.data.generic_param.owner == b.data.generic_param.owner
            && a.data.generic_param.index == b.data.generic_param.index;
    }
    if (a.kind == TYPE_ABI) {
        ret a.data.abi.tag == b.data.abi.tag
            && a.data.abi.size == b.data.abi.size
            && a.data.abi.align == b.data.abi.align;
    }

    ret true;
}

test "mach.lang.type.intern_function:identical_signatures" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: TypeInterner;
    if (O.is_some[str](init(?ti, ?alloc))) { ret 1; }

    val u8_id: TypeId = O.unwrap[TypeId](prim(?ti, TYPE_U8));

    val r1: R.Result[TypeId, str] = intern_function(?ti, u8_id, nil, 0, false);
    val r2: R.Result[TypeId, str] = intern_function(?ti, u8_id, nil, 0, false);
    if (R.is_err[TypeId, str](r1))                                    { dnit(?ti); ret 1; }
    if (R.is_err[TypeId, str](r2))                                    { dnit(?ti); ret 1; }
    if (R.unwrap_ok[TypeId, str](r1) != R.unwrap_ok[TypeId, str](r2)) { dnit(?ti); ret 1; }

    val u32_id: TypeId = O.unwrap[TypeId](prim(?ti, TYPE_U32));
    val u64_id: TypeId = O.unwrap[TypeId](prim(?ti, TYPE_U64));
    var p32: [1]TypeId;
    p32[0] = u32_id;
    var p64: [1]TypeId;
    p64[0] = u64_id;
    val r4: R.Result[TypeId, str] = intern_function(?ti, u8_id, ?p32[0], 1, false);
    val r5: R.Result[TypeId, str] = intern_function(?ti, u8_id, ?p64[0], 1, false);
    if (R.is_err[TypeId, str](r4))                                    { dnit(?ti); ret 1; }
    if (R.is_err[TypeId, str](r5))                                    { dnit(?ti); ret 1; }
    if (R.unwrap_ok[TypeId, str](r4) == R.unwrap_ok[TypeId, str](r5)) { dnit(?ti); ret 1; }

    val rv: R.Result[TypeId, str] = intern_function(?ti, u8_id, ?p32[0], 1, true);
    if (R.is_err[TypeId, str](rv))                                    { dnit(?ti); ret 1; }
    if (R.unwrap_ok[TypeId, str](rv) == R.unwrap_ok[TypeId, str](r4)) { dnit(?ti); ret 1; }
    if (type_equals_signatures(?ti, R.unwrap_ok[TypeId, str](rv),
                                    R.unwrap_ok[TypeId, str](r4)))    { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

test "mach.lang.type.intern_generic_param:dedup_by_origin_owner_index" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: TypeInterner;
    if (O.is_some[str](init(?ti, ?alloc))) { ret 1; }

    val r1: R.Result[TypeId, str] = intern_generic_param(?ti, intern.STR_NIL, 1::module.ModuleId, 0::id.DeclId, 0);
    val r2: R.Result[TypeId, str] = intern_generic_param(?ti, intern.STR_NIL, 1::module.ModuleId, 0::id.DeclId, 0);
    if (R.is_err[TypeId, str](r1))                                    { dnit(?ti); ret 1; }
    if (R.is_err[TypeId, str](r2))                                    { dnit(?ti); ret 1; }
    if (R.unwrap_ok[TypeId, str](r1) != R.unwrap_ok[TypeId, str](r2)) { dnit(?ti); ret 1; }

    val r_other_module: R.Result[TypeId, str] = intern_generic_param(?ti, intern.STR_NIL, 2::module.ModuleId, 0::id.DeclId, 0);
    if (R.is_err[TypeId, str](r_other_module)) { dnit(?ti); ret 1; }
    if (R.unwrap_ok[TypeId, str](r1) == R.unwrap_ok[TypeId, str](r_other_module)) { dnit(?ti); ret 1; }

    val r_other_owner: R.Result[TypeId, str] = intern_generic_param(?ti, intern.STR_NIL, 1::module.ModuleId, 1::id.DeclId, 0);
    if (R.is_err[TypeId, str](r_other_owner)) { dnit(?ti); ret 1; }
    if (R.unwrap_ok[TypeId, str](r1) == R.unwrap_ok[TypeId, str](r_other_owner)) { dnit(?ti); ret 1; }

    val r_other_index: R.Result[TypeId, str] = intern_generic_param(?ti, intern.STR_NIL, 1::module.ModuleId, 0::id.DeclId, 1);
    if (R.is_err[TypeId, str](r_other_index)) { dnit(?ti); ret 1; }
    if (R.unwrap_ok[TypeId, str](r1) == R.unwrap_ok[TypeId, str](r_other_index)) { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

test "mach.lang.type.intern_instance:dedup_by_origin_decl_args" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: TypeInterner;
    if (O.is_some[str](init(?ti, ?alloc))) { ret 1; }

    val u32_id: TypeId = O.unwrap[TypeId](prim(?ti, TYPE_U32));
    val u8_id:  TypeId = O.unwrap[TypeId](prim(?ti, TYPE_U8));

    val rn: R.Result[TypeId, str] = intern_nominal(?ti, intern.STR_NIL, 1::module.ModuleId, 0::id.DeclId, TYPE_REC);
    if (R.is_err[TypeId, str](rn)) { dnit(?ti); ret 1; }
    val nom: TypeId = R.unwrap_ok[TypeId, str](rn);

    var a1: [1]TypeId;
    a1[0] = u32_id;

    val r1: R.Result[TypeId, str] = intern_instance(?ti, nom, 1::module.ModuleId, 0::id.DeclId, ?a1[0], 1);
    val r2: R.Result[TypeId, str] = intern_instance(?ti, nom, 1::module.ModuleId, 0::id.DeclId, ?a1[0], 1);
    if (R.is_err[TypeId, str](r1))                                    { dnit(?ti); ret 1; }
    if (R.is_err[TypeId, str](r2))                                    { dnit(?ti); ret 1; }
    if (R.unwrap_ok[TypeId, str](r1) != R.unwrap_ok[TypeId, str](r2)) { dnit(?ti); ret 1; }

    var a1u8: [1]TypeId;
    a1u8[0] = u8_id;
    val r3: R.Result[TypeId, str] = intern_instance(?ti, nom, 1::module.ModuleId, 0::id.DeclId, ?a1u8[0], 1);
    if (R.is_err[TypeId, str](r3))                                    { dnit(?ti); ret 1; }
    if (R.unwrap_ok[TypeId, str](r1) == R.unwrap_ok[TypeId, str](r3)) { dnit(?ti); ret 1; }

    var a2: [2]TypeId;
    a2[0] = u32_id;
    a2[1] = u8_id;
    val r4: R.Result[TypeId, str] = intern_instance(?ti, nom, 1::module.ModuleId, 0::id.DeclId, ?a2[0], 2);
    if (R.is_err[TypeId, str](r4))                                    { dnit(?ti); ret 1; }
    if (R.unwrap_ok[TypeId, str](r1) == R.unwrap_ok[TypeId, str](r4)) { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

test "mach.lang.type.is_union:instance_follows_its_nominal" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: TypeInterner;
    if (O.is_some[str](init(?ti, ?alloc))) { ret 1; }

    val u32_id: TypeId = O.unwrap[TypeId](prim(?ti, TYPE_U32));
    var args: [1]TypeId;
    args[0] = u32_id;

    val rr: R.Result[TypeId, str] = intern_nominal(?ti, intern.STR_NIL, 1::module.ModuleId, 0::id.DeclId, TYPE_REC);
    val ru: R.Result[TypeId, str] = intern_nominal(?ti, intern.STR_NIL, 1::module.ModuleId, 1::id.DeclId, TYPE_UNI);
    if (R.is_err[TypeId, str](rr)) { dnit(?ti); ret 1; }
    if (R.is_err[TypeId, str](ru)) { dnit(?ti); ret 1; }
    val rec_nom: TypeId = R.unwrap_ok[TypeId, str](rr);
    val uni_nom: TypeId = R.unwrap_ok[TypeId, str](ru);

    val ri: R.Result[TypeId, str] = intern_instance(?ti, rec_nom, 1::module.ModuleId, 0::id.DeclId, ?args[0], 1);
    val ui: R.Result[TypeId, str] = intern_instance(?ti, uni_nom, 1::module.ModuleId, 1::id.DeclId, ?args[0], 1);
    if (R.is_err[TypeId, str](ri)) { dnit(?ti); ret 1; }
    if (R.is_err[TypeId, str](ui)) { dnit(?ti); ret 1; }
    val rec_inst: TypeId = R.unwrap_ok[TypeId, str](ri);
    val uni_inst: TypeId = R.unwrap_ok[TypeId, str](ui);

    if (O.unwrap[*Type](get(?ti, rec_inst)).kind != TYPE_INSTANCE) { dnit(?ti); ret 1; }
    if (O.unwrap[*Type](get(?ti, uni_inst)).kind != TYPE_INSTANCE) { dnit(?ti); ret 1; }

    if (aggregate_nominal(?ti, rec_inst) != rec_nom) { dnit(?ti); ret 1; }
    if (aggregate_nominal(?ti, uni_inst) != uni_nom) { dnit(?ti); ret 1; }

    if (is_union(?ti, uni_inst))   { } or { dnit(?ti); ret 1; }
    if (is_record(?ti, rec_inst))  { } or { dnit(?ti); ret 1; }
    if (is_union(?ti, rec_inst))   { dnit(?ti); ret 1; }
    if (is_record(?ti, uni_inst))  { dnit(?ti); ret 1; }

    if (is_union(?ti, uni_nom))  { } or { dnit(?ti); ret 1; }
    if (is_record(?ti, rec_nom)) { } or { dnit(?ti); ret 1; }
    if (is_union(?ti, u32_id))   { dnit(?ti); ret 1; }
    if (is_record(?ti, u32_id))  { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

test "mach.lang.type.vector_form:reads_the_form_at_every_width" {
    var vi: u32 = 0;
    for (vi < VEC_COUNT) {
        val sh: VecShape = vec_shape(vi);
        val f:  VecForm  = vector_form(sh.name);
        if (f.status  != VEC_FORM_OK) { ret 1; }
        if (f.element != sh.element)  { ret 1; }
        if (f.lanes   != sh.lanes)    { ret 1; }
        if (f.bits    != 128)         { ret 1; }
        vi = vi + 1;
    }

    val v3: VecForm = vector_form("f32x3");
    if (v3.status != VEC_FORM_OK) { ret 1; }
    if (v3.element != TYPE_F32)   { ret 1; }
    if (v3.lanes != 3)            { ret 1; }
    if (v3.bits != 96)            { ret 1; }

    val u3: VecForm = vector_form("u32x3");
    if (u3.status != VEC_FORM_OK) { ret 1; }
    if (u3.element != TYPE_U32)   { ret 1; }
    if (u3.lanes != 3)            { ret 1; }

    val v2: VecForm = vector_form("f32x2");
    if (v2.status != VEC_FORM_OK) { ret 1; }
    if (v2.lanes != 2)            { ret 1; }
    if (v2.bits != 64)            { ret 1; }

    val w5: VecForm = vector_form("f32x5");
    if (w5.status != VEC_FORM_OK) { ret 1; }
    if (w5.element != TYPE_F32)   { ret 1; }
    if (w5.lanes != 5)            { ret 1; }
    if (w5.bits != 160)           { ret 1; }

    val w8: VecForm = vector_form("f32x8");
    if (w8.status != VEC_FORM_OK) { ret 1; }
    if (w8.lanes != 8)            { ret 1; }
    if (w8.bits != 256)           { ret 1; }

    if (vector_form("i8x17").status  != VEC_FORM_OK) { ret 1; }
    if (vector_form("f64x3").status  != VEC_FORM_OK) { ret 1; }
    if (vector_form("f32x16").bits   != 512)         { ret 1; }
    if (vector_form("i16x7").bits    != 112)         { ret 1; }

    if (vector_form("u8x65535").status != VEC_FORM_OK)       { ret 1; }
    if (vector_form("u8x65535").lanes  != MAX_VEC_LANES)     { ret 1; }
    if (vector_form("u8x65536").status != VEC_FORM_TOO_WIDE) { ret 1; }

    if (vector_form("u64x4294967295").status != VEC_FORM_TOO_WIDE) { ret 1; }

    if (vector_form("f32x1").status != VEC_FORM_BAD_LANES) { ret 1; }

    if (vector_form(nil).status     != VEC_FORM_NONE) { ret 1; }
    if (vector_form("").status      != VEC_FORM_NONE) { ret 1; }
    if (vector_form("f32").status   != VEC_FORM_NONE) { ret 1; }
    if (vector_form("f32x").status  != VEC_FORM_NONE) { ret 1; }
    if (vector_form("x4").status    != VEC_FORM_NONE) { ret 1; }
    if (vector_form("f33x4").status != VEC_FORM_NONE) { ret 1; }
    if (vector_form("f32x4y").status != VEC_FORM_NONE) { ret 1; }
    if (vector_form("f32x04").status != VEC_FORM_NONE) { ret 1; }
    if (vector_form("ptrx2").status  != VEC_FORM_NONE) { ret 1; }
    if (vector_form("matrix4").status != VEC_FORM_NONE) { ret 1; }

    ret 0;
}

test "mach.lang.type.prim_name:spells_every_primitive" {
    if (!str_equals(prim_name(TYPE_U8),  "u8"))  { ret 1; }
    if (!str_equals(prim_name(TYPE_U16), "u16")) { ret 1; }
    if (!str_equals(prim_name(TYPE_U32), "u32")) { ret 1; }
    if (!str_equals(prim_name(TYPE_U64), "u64")) { ret 1; }
    if (!str_equals(prim_name(TYPE_I8),  "i8"))  { ret 1; }
    if (!str_equals(prim_name(TYPE_I16), "i16")) { ret 1; }
    if (!str_equals(prim_name(TYPE_I32), "i32")) { ret 1; }
    if (!str_equals(prim_name(TYPE_I64), "i64")) { ret 1; }
    if (!str_equals(prim_name(TYPE_F32), "f32")) { ret 1; }
    if (!str_equals(prim_name(TYPE_F64), "f64")) { ret 1; }
    if (!str_equals(prim_name(TYPE_PTR), "ptr")) { ret 1; }
    var k: u32 = 0;
    for (k < PRIM_COUNT) {
        if (prim_name(k::u8) == nil) { ret 1; }
        k = k + 1;
    }
    if (prim_name(TYPE_VECTOR) != nil) { ret 1; }
    ret 0;
}

test "mach.lang.type.prim_catalog:complete_unique_ordered_roundtrip" {
    if (PRIM_COUNT != TYPE_PTR::u32 + 1) { ret 1; }

    var seen: [PRIM_COUNT]bool;
    var i: u32 = 0;
    for (i < PRIM_COUNT) { seen[i] = false; i = i + 1; }

    i = 0;
    for (i < PRIM_COUNT) {
        val spec: *PrimSpec = ?PRIM_CATALOG[i];
        if (spec.kind::u32 != i)             { ret 1; }
        if (seen[spec.kind::u32])            { ret 1; }
        if (str_equals(spec.spelling, ""))   { ret 1; }
        if (spec.len != str_len(spec.spelling)) { ret 1; }
        seen[spec.kind::u32] = true;

        var j: u32 = 0;
        for (j < i) {
            val prior: *PrimSpec = ?PRIM_CATALOG[j];
            if (prior.kind == spec.kind)                 { ret 1; }
            if (str_equals(prior.spelling, spec.spelling)) { ret 1; }
            j = j + 1;
        }

        if (!str_equals(prim_name(spec.kind), spec.spelling)) { ret 1; }
        if (prim_spelling_len(spec.kind) != spec.len)          { ret 1; }
        val d: PrimDesc = prim_desc(spec.kind);
        if (d.class != spec.class)   { ret 1; }
        if (d.signed != spec.signed) { ret 1; }
        if (d.bits != spec.bits)     { ret 1; }

        val parsed: O.Option[TypeKind] = prim_from_name(spec.spelling);
        if (O.is_none[TypeKind](parsed))                { ret 1; }
        if (O.unwrap[TypeKind](parsed) != spec.kind)    { ret 1; }
        i = i + 1;
    }

    if (O.is_some[TypeKind](prim_from_name("")))     { ret 1; }
    if (O.is_some[TypeKind](prim_from_name("bool"))) { ret 1; }
    if (prim_name(TYPE_VECTOR) != nil)               { ret 1; }
    if (prim_spelling_len(TYPE_VECTOR) != 0)         { ret 1; }
    val nd: PrimDesc = prim_desc(TYPE_VECTOR);
    if (nd.class != PRIM_CLASS_NONE) { ret 1; }
    if (nd.signed)                   { ret 1; }
    if (nd.bits != 0)                { ret 1; }

    i = 0;
    for (i < PRIM_COUNT) {
        if (!seen[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.type.intern_vector:seeded_and_dedup" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: TypeInterner;
    if (O.is_some[str](init(?ti, ?alloc))) { ret 1; }

    var vi: u32 = 0;
    for (vi < VEC_COUNT) {
        val sh:  VecShape          = vec_shape(vi);
        val opt: O.Option[TypeId]  = vec(?ti, vi);
        if (O.is_none[TypeId](opt))                             { dnit(?ti); ret 1; }
        val tid: TypeId = O.unwrap[TypeId](opt);
        if (!is_vector(?ti, tid))                               { dnit(?ti); ret 1; }
        if (vector_element(?ti, tid) != sh.element)             { dnit(?ti); ret 1; }
        if (vector_lanes(?ti, tid) != sh.lanes)                 { dnit(?ti); ret 1; }
        vi = vi + 1;
    }

    val f0: TypeId = O.unwrap[TypeId](vec(?ti, 0));
    val r_f: R.Result[TypeId, str] = intern_vector(?ti, TYPE_F32, 4);
    if (R.is_err[TypeId, str](r_f))                     { dnit(?ti); ret 1; }
    if (R.unwrap_ok[TypeId, str](r_f) != f0)            { dnit(?ti); ret 1; }

    val r_i: R.Result[TypeId, str] = intern_vector(?ti, TYPE_I32, 4);
    if (R.is_err[TypeId, str](r_i))                     { dnit(?ti); ret 1; }
    if (R.unwrap_ok[TypeId, str](r_i) == f0)            { dnit(?ti); ret 1; }

    if (O.is_some[TypeId](vec(?ti, VEC_COUNT)))         { dnit(?ti); ret 1; }
    if (is_vector(?ti, O.unwrap[TypeId](prim(?ti, TYPE_U8)))) { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

test "mach.lang.type.is_u8:rejects_missing_types" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: TypeInterner;
    if (O.is_some[str](init(?ti, ?alloc))) { ret 1; }

    val u8t: TypeId = O.unwrap[TypeId](prim(?ti, TYPE_U8));
    if (!is_u8(?ti, u8t))        { dnit(?ti); ret 1; }
    if (is_u8(?ti, TYPE_NIL))    { dnit(?ti); ret 1; }
    if (is_u8(?ti, TYPE_ERROR))  { dnit(?ti); ret 1; }
    if (is_u8(?ti, handle.chunk_count[Type](?ti.types)::u32)) { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

test "mach.lang.type.vector_mask:same_shape_unsigned" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: TypeInterner;
    if (O.is_some[str](init(?ti, ?alloc))) { ret 1; }

    val f32x4: TypeId = O.unwrap[TypeId](vec(?ti, 0));
    val u32x4: TypeId = O.unwrap[TypeId](vec(?ti, 8));
    val m0: R.Result[TypeId, str] = vector_mask(?ti, f32x4);
    if (R.is_err[TypeId, str](m0))          { dnit(?ti); ret 1; }
    if (R.unwrap_ok[TypeId, str](m0) != u32x4) { dnit(?ti); ret 1; }

    val i8x16: TypeId = O.unwrap[TypeId](vec(?ti, 2));
    val u8x16: TypeId = O.unwrap[TypeId](vec(?ti, 6));
    val m1: R.Result[TypeId, str] = vector_mask(?ti, i8x16);
    if (R.is_err[TypeId, str](m1))          { dnit(?ti); ret 1; }
    if (R.unwrap_ok[TypeId, str](m1) != u8x16) { dnit(?ti); ret 1; }

    val i64x2: TypeId = O.unwrap[TypeId](vec(?ti, 5));
    val u64x2: TypeId = O.unwrap[TypeId](vec(?ti, 9));
    val m2: R.Result[TypeId, str] = vector_mask(?ti, i64x2);
    if (R.is_err[TypeId, str](m2))          { dnit(?ti); ret 1; }
    if (R.unwrap_ok[TypeId, str](m2) != u64x2) { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

test "mach.lang.type.type_equals_signatures:param_and_nil_boundaries" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: TypeInterner;
    if (O.is_some[str](init(?ti, ?alloc))) { ret 1; }

    val i32_id: TypeId = O.unwrap[TypeId](prim(?ti, TYPE_I32));
    val i64_id: TypeId = O.unwrap[TypeId](prim(?ti, TYPE_I64));

    var pi32: [1]TypeId;
    pi32[0] = i32_id;
    var pi64: [1]TypeId;
    pi64[0] = i64_id;

    val ra: R.Result[TypeId, str] = intern_function(?ti, TYPE_NIL, ?pi32[0], 1, false);
    val rc: R.Result[TypeId, str] = intern_function(?ti, TYPE_NIL, ?pi32[0], 1, false);
    val rd: R.Result[TypeId, str] = intern_function(?ti, TYPE_NIL, ?pi64[0], 1, false);
    if (R.is_err[TypeId, str](ra)) { dnit(?ti); ret 1; }
    if (R.is_err[TypeId, str](rc)) { dnit(?ti); ret 1; }
    if (R.is_err[TypeId, str](rd)) { dnit(?ti); ret 1; }

    val tid_a: TypeId = R.unwrap_ok[TypeId, str](ra);
    val tid_c: TypeId = R.unwrap_ok[TypeId, str](rc);
    val tid_d: TypeId = R.unwrap_ok[TypeId, str](rd);

    if (!type_equals_signatures(?ti, tid_a, tid_c))   { dnit(?ti); ret 1; }
    if (type_equals_signatures(?ti, tid_a, tid_d))    { dnit(?ti); ret 1; }
    if (type_equals_signatures(?ti, tid_a, TYPE_NIL)) { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

test "mach.lang.type:numeric_predicate_boundaries" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: TypeInterner;
    if (O.is_some[str](init(?ti, ?alloc))) { ret 1; }

    val ptr_id: TypeId = O.unwrap[TypeId](prim(?ti, TYPE_PTR));
    val u8_id:  TypeId = O.unwrap[TypeId](prim(?ti, TYPE_U8));
    val i64_id: TypeId = O.unwrap[TypeId](prim(?ti, TYPE_I64));
    val f32_id: TypeId = O.unwrap[TypeId](prim(?ti, TYPE_F32));

    val pack_r: R.Result[TypeId, str] = intern_pack(?ti);
    if (R.is_err[TypeId, str](pack_r)) { dnit(?ti); ret 1; }
    val pack_id: TypeId = R.unwrap_ok[TypeId, str](pack_r);

    val arr_r: R.Result[TypeId, str] = intern_array(?ti, u8_id, 4);
    if (R.is_err[TypeId, str](arr_r)) { dnit(?ti); ret 1; }
    val arr_id: TypeId = R.unwrap_ok[TypeId, str](arr_r);

    if (is_integer(?ti, pack_id)) { dnit(?ti); ret 1; }
    if (is_numeric(?ti, pack_id)) { dnit(?ti); ret 1; }
    if (is_float(?ti, pack_id))   { dnit(?ti); ret 1; }
    if (is_integer(?ti, ptr_id))  { dnit(?ti); ret 1; }
    if (!is_integer(?ti, u8_id))  { dnit(?ti); ret 1; }
    if (!is_integer(?ti, i64_id)) { dnit(?ti); ret 1; }
    if (!is_float(?ti, f32_id))   { dnit(?ti); ret 1; }
    if (is_integer(?ti, arr_id))  { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

test "mach.lang.type.intern_secret:dedup_collapse_and_predicates" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: TypeInterner;
    if (O.is_some[str](init(?ti, ?alloc))) { ret 1; }

    val u32_id: TypeId = O.unwrap[TypeId](prim(?ti, TYPE_U32));

    val s1: R.Result[TypeId, str] = intern_secret(?ti, u32_id);
    val s2: R.Result[TypeId, str] = intern_secret(?ti, u32_id);
    if (R.is_err[TypeId, str](s1) || R.is_err[TypeId, str](s2)) { dnit(?ti); ret 1; }
    val sec_u32: TypeId = R.unwrap_ok[TypeId, str](s1);
    if (sec_u32 != R.unwrap_ok[TypeId, str](s2)) { dnit(?ti); ret 1; }
    if (sec_u32 == u32_id)                       { dnit(?ti); ret 1; }

    val s3: R.Result[TypeId, str] = intern_secret(?ti, sec_u32);
    if (R.is_err[TypeId, str](s3))                  { dnit(?ti); ret 1; }
    if (R.unwrap_ok[TypeId, str](s3) != sec_u32)    { dnit(?ti); ret 1; }

    if (!is_secret(?ti, sec_u32))                 { dnit(?ti); ret 1; }
    if (is_secret(?ti, u32_id))                   { dnit(?ti); ret 1; }
    if (strip_secret(?ti, sec_u32) != u32_id)     { dnit(?ti); ret 1; }
    if (strip_secret(?ti, u32_id) != u32_id)      { dnit(?ti); ret 1; }

    if (!is_integer(?ti, sec_u32))                { dnit(?ti); ret 1; }
    if (!is_numeric(?ti, sec_u32))                { dnit(?ti); ret 1; }

    val pp_sec: R.Result[TypeId, str] = intern_pointer(?ti, sec_u32);
    val pp_pub: R.Result[TypeId, str] = intern_pointer(?ti, u32_id);
    if (R.is_err[TypeId, str](pp_sec) || R.is_err[TypeId, str](pp_pub)) { dnit(?ti); ret 1; }
    val ptr_sec: TypeId = R.unwrap_ok[TypeId, str](pp_sec);
    val ptr_pub: TypeId = R.unwrap_ok[TypeId, str](pp_pub);
    if (!carries_secret(?ti, ptr_sec))            { dnit(?ti); ret 1; }
    if (carries_secret(?ti, ptr_pub))             { dnit(?ti); ret 1; }
    if (!carries_secret(?ti, sec_u32))            { dnit(?ti); ret 1; }

    val u64_id:  TypeId = O.unwrap[TypeId](prim(?ti, TYPE_U64));
    val sec_u64: R.Result[TypeId, str] = intern_secret(?ti, u64_id);
    if (R.is_err[TypeId, str](sec_u64)) { dnit(?ti); ret 1; }
    if (secrecy_structure_equal(?ti, ptr_sec, ptr_pub))                       { dnit(?ti); ret 1; }
    if (!secrecy_structure_equal(?ti, ptr_sec, ptr_sec))                      { dnit(?ti); ret 1; }
    if (!secrecy_structure_equal(?ti, sec_u32, R.unwrap_ok[TypeId, str](sec_u64))) { dnit(?ti); ret 1; }
    if (secrecy_structure_equal(?ti, sec_u32, u32_id))                       { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

rec TFieldProbe {
    backing: A.Allocator;
    calls:   u32;
    fail_at: u32;
}

fun t_field_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val p: *TFieldProbe = ctx::*TFieldProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls >= p.fail_at) { ret O.none[ptr](); }
    ret p.backing.fn_allocate(p.backing.ctx, size, align);
}

fun t_field_probe_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    val p: *TFieldProbe = ctx::*TFieldProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls >= p.fail_at) { ret O.none[ptr](); }
    ret p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
}

fun t_field_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *TFieldProbe = ctx::*TFieldProbe;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun t_field_probe_make(p: *TFieldProbe, alloc: *A.Allocator) bool {
    if (O.is_some[str](page.make(?p.backing))) { ret false; }
    p.calls   = 0;
    p.fail_at = 0;
    val self_ptr: *TFieldProbe = p;
    alloc.ctx           = self_ptr::ptr;
    alloc.fn_allocate    = t_field_probe_allocate;
    alloc.fn_reallocate  = t_field_probe_reallocate;
    alloc.fn_deallocate  = t_field_probe_deallocate;
    ret true;
}

test "mach.lang.type.field_table_publish:a_stale_epoch_hides_the_table" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: TypeInterner;
    if (O.is_some[str](init(?ti, ?alloc))) { ret 1; }

    val ty: TypeId = O.unwrap[TypeId](prim(?ti, TYPE_U32));
    val name_a: intern.StrId = 1::intern.StrId;
    val name_b: intern.StrId = 2::intern.StrId;
    val name_c: intern.StrId = 3::intern.StrId;

    val s1_r: R.Result[u32, str] = field_table_stage(?ti, 2);
    if (R.is_err[u32, str](s1_r)) { dnit(?ti); ret 1; }
    val s1: u32 = R.unwrap_ok[u32, str](s1_r);
    if (R.is_err[R.Void, str](field_table_stage_push(?ti, name_a, ty))) { dnit(?ti); ret 1; }
    if (field_count(?ti, ty) != 0) { dnit(?ti); ret 1; }
    if (R.is_err[R.Void, str](field_table_stage_push(?ti, name_b, ty))) { dnit(?ti); ret 1; }
    if (field_count(?ti, ty) != 0) { dnit(?ti); ret 1; }
    if (R.is_err[R.Void, str](field_table_publish(?ti, ty, s1, 2))) { dnit(?ti); ret 1; }

    if (field_count(?ti, ty) != 2) { dnit(?ti); ret 1; }
    val e0: O.Option[*FieldEntry] = field_at(?ti, ty, 0);
    if (O.is_none[*FieldEntry](e0) || O.unwrap[*FieldEntry](e0).name != name_a) { dnit(?ti); ret 1; }
    val e1: O.Option[*FieldEntry] = field_at(?ti, ty, 1);
    if (O.is_none[*FieldEntry](e1) || O.unwrap[*FieldEntry](e1).name != name_b) { dnit(?ti); ret 1; }

    field_epoch_bump(?ti);
    if (O.is_some[*FieldTable](field_table_for(?ti, ty))) { dnit(?ti); ret 1; }
    if (field_count(?ti, ty) != 0)                        { dnit(?ti); ret 1; }
    if (O.is_some[*FieldEntry](field_at(?ti, ty, 0)))     { dnit(?ti); ret 1; }

    val s2_r: R.Result[u32, str] = field_table_stage(?ti, 1);
    if (R.is_err[u32, str](s2_r)) { dnit(?ti); ret 1; }
    val s2: u32 = R.unwrap_ok[u32, str](s2_r);
    if (R.is_err[R.Void, str](field_table_stage_push(?ti, name_c, ty))) { dnit(?ti); ret 1; }
    if (R.is_err[R.Void, str](field_table_publish(?ti, ty, s2, 1))) { dnit(?ti); ret 1; }

    if (field_count(?ti, ty) != 1) { dnit(?ti); ret 1; }
    val e2: O.Option[*FieldEntry] = field_at(?ti, ty, 0);
    if (O.is_none[*FieldEntry](e2) || O.unwrap[*FieldEntry](e2).name != name_c) { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

test "mach.lang.type.field_table_publish:a_failed_build_never_replaces_the_published_table" {
    var fail_at: u32 = 1;
    for (fail_at <= 24) {
        var probe: TFieldProbe; var pa: A.Allocator;
        if (!t_field_probe_make(?probe, ?pa)) { ret 1; }
        var ti: TypeInterner;
        if (O.is_some[str](init(?ti, ?pa))) { ret 1; }

        val ty: TypeId = O.unwrap[TypeId](prim(?ti, TYPE_U32));

        val g_r: R.Result[u32, str] = field_table_stage(?ti, 2);
        if (R.is_err[u32, str](g_r)) { dnit(?ti); ret 1; }
        val g: u32 = R.unwrap_ok[u32, str](g_r);
        if (R.is_err[R.Void, str](field_table_stage_push(?ti, 1::intern.StrId, ty))) { dnit(?ti); ret 1; }
        if (R.is_err[R.Void, str](field_table_stage_push(?ti, 2::intern.StrId, ty))) { dnit(?ti); ret 1; }
        if (R.is_err[R.Void, str](field_table_publish(?ti, ty, g, 2))) { dnit(?ti); ret 1; }
        if (field_count(?ti, ty) != 2) { dnit(?ti); ret 1; }

        probe.fail_at = probe.calls + fail_at;

        val s_r: R.Result[u32, str] = field_table_stage(?ti, 3);
        var published: bool = false;
        if (R.is_ok[u32, str](s_r)) {
            val s: u32 = R.unwrap_ok[u32, str](s_r);
            var staged: bool = true;
            var i: u32 = 0;
            for (i < 3) {
                if (R.is_err[R.Void, str](field_table_stage_push(?ti, (10 + i)::intern.StrId, ty))) {
                    staged = false;
                    brk;
                }
                if (field_count(?ti, ty) != 2) { dnit(?ti); ret 1; }
                i = i + 1;
            }
            if (staged) {
                published = R.is_ok[R.Void, str](field_table_publish(?ti, ty, s, 3));
            }
        }

        if (!published && field_count(?ti, ty) != 2) { dnit(?ti); ret 1; }
        if (published  && field_count(?ti, ty) != 3) { dnit(?ti); ret 1; }

        probe.fail_at = 0;
        dnit(?ti);
        fail_at = fail_at + 1;
    }
    ret 0;
}

rec GrowLoopProbe {
    allocate_calls:   u32;
    reallocate_calls: u32;
}

fun growloop_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val g: *GrowLoopProbe = ctx::*GrowLoopProbe;
    g.allocate_calls = g.allocate_calls + 1;
    ret O.none[ptr]();
}

fun growloop_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    val g: *GrowLoopProbe = ctx::*GrowLoopProbe;
    g.reallocate_calls = g.reallocate_calls + 1;
    ret O.none[ptr]();
}

fun growloop_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.type.visit_reserve:refuses_a_u32_doubling_that_wraps_without_reallocating" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: TypeInterner;
    if (O.is_some[str](init(?ti, ?alloc))) { ret 1; }
    if (O.is_some[str](visits_reserve(?ti))) { dnit(?ti); ret 1; }

    var probe: GrowLoopProbe;
    probe.allocate_calls   = 0;
    probe.reallocate_calls = 0;
    var pp: *GrowLoopProbe = ?probe;
    var pa: A.Allocator;
    pa.ctx           = pp::ptr;
    pa.fn_allocate   = growloop_probe_allocate;
    pa.fn_reallocate = growloop_probe_reallocate;
    pa.fn_deallocate = growloop_probe_deallocate;

    ti.visits[0].stamp = nil;
    ti.visits[0].cap   = 0x80000000;
    ti.visits[0].epoch = 0;

    val real_alloc: *A.Allocator = ti.a;
    ti.a = ?pa;
    val res: O.Option[str] = visit_reserve(?ti, 0, 0x80000000::TypeId);
    ti.a = real_alloc;

    var bad: i32 = 0;
    if (O.is_none[str](res))          { bad = 1; }
    if (probe.allocate_calls != 0)    { bad = 2; }
    if (probe.reallocate_calls != 0)  { bad = 3; }

    ti.visits[0].cap = 0;
    dnit(?ti);
    ret bad;
}

