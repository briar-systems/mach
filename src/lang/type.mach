    var a: A.Allocator;
    a.ctx           = pp::ptr;
    a.fn_allocate   = growloop_probe_allocate;
    a.fn_reallocate = growloop_probe_reallocate;
    a.fn_deallocate = growloop_probe_deallocate;

    var dummy: TypeId;
    var data: *TypeId = ?dummy;
    var cap: u32 = 0xFFFFFFFF;
    val res: R.Result[R.Void, str] = grow_cap[TypeId](?a, ?data, ?cap, 16);

    var bad: i32 = 0;
    if (!R.is_err[R.Void, str](res))    { bad = 1; }
    if (probe.reallocate_calls != 0)  { bad = 2; }
    if (cap != 0xFFFFFFFF)            { bad = 3; }
    ret bad;
}

test "mach.lang.type.track_handle:refuses_a_handle_count_at_the_u32_sentinel" {
    var alloc: A.Allocator;
    page.make(?alloc);
