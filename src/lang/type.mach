    if (O.is_some[str](init(?ti, ?alloc))) { ret 1; }

    var dummy: TypeId;
    ti.handles     = ?dummy;
    ti.handles_len = 0xFFFFFFFF;
    ti.handles_cap = 0xFFFFFFFF;

    val res: R.Result[R.Void, str] = track_handle(?ti, 0::TypeId);
    if (!R.is_err[R.Void, str](res))       { ti.handles = nil; ti.handles_len = 0; ti.handles_cap = 0; dnit(?ti); ret 1; }
    if (ti.handles_len != 0xFFFFFFFF)    { dnit(?ti); ret 1; }

    ti.handles     = nil;
    ti.handles_len = 0;
    ti.handles_cap = 0;
    dnit(?ti);
    ret 0;
}

fun intern_distinct_instances(ti: *TypeInterner, first: u32, count: u32) R.Result[R.Void, str] {
    var i: u32 = first;
    for (i < first + count) {
        var arg: TypeId = i::TypeId;
        val r: R.Result[TypeId, str] = intern_instance(ti, 0::TypeId, 0::module.ModuleId, i::id.DeclId, ?arg, 1);
        if (R.is_err[TypeId, str](r)) { ret R.err[R.Void, str](R.unwrap_err[TypeId, str](r)); }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun time_intern_fresh(count: u32) i64 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: TypeInterner;
    if (O.is_some[str](init(?ti, ?alloc))) { ret -1; }

    val start: tm.Time = tm.monotonic();
    if (R.is_err[R.Void, str](intern_distinct_instances(?ti, 0, count))) { dnit(?ti); ret -1; }
    val elapsed: duration.Duration = tm.time_sub(tm.monotonic(), start);

    dnit(?ti);
    ret duration.duration_usec(elapsed);
}

test "mach.lang.type.intern_instance:cost_stays_near_linear_as_population_grows" {
    val small: u32 = 3000;
    val large: u32 = small * 4;

    val us_small: i64 = time_intern_fresh(small);
    val us_large: i64 = time_intern_fresh(large);
    if (us_small < 0 || us_large < 0) { ret 1; }

    var pa: A.Allocator;
    page.make(?pa);
    val msg: R.Result[str, str] = format.sprint(?pa, "us_small={} us_large={}\n", us_small, us_large);
    if (R.is_ok[str, str](msg)) { print.eprint(R.unwrap_ok[str, str](msg)); }

    var bad: i32 = 0;
    if (us_large > (us_small + 2000) * 8) { bad = 1; }
    ret bad;
}

test "mach.lang.type:invalid_ids_answer_identically_across_the_query_api" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: TypeInterner;
    if (O.is_some[str](init(?ti, ?alloc))) { ret 1; }

    var ids: [3]TypeId;
    ids[0] = TYPE_NIL;
    ids[1] = TYPE_ERROR;
    ids[2] = type_count(?ti);
    var code: i32 = 0;
    var i: usize = 0;
    for (i < 3) {
        val id: TypeId = ids[i];
        if (O.is_some[*Type](get(?ti, id)))            { code = 1; }
        if (is_integer(?ti, id) || is_numeric(?ti, id) || is_float(?ti, id)) { code = 1; }
        if (is_pointer_like(?ti, id) || is_secret(?ti, id) || is_vector(?ti, id)) { code = 1; }
        if (is_u8(?ti, id) || carries_secret(?ti, id))  { code = 1; }
        if (is_handle(?ti, id) || is_abi_type(?ti, id)) { code = 1; }
        if (is_union(?ti, id) || is_record(?ti, id))    { code = 1; }
        if (vector_element(?ti, id) != TYPE_VECTOR)     { code = 1; }
        if (vector_lanes(?ti, id) != 0)                 { code = 1; }
        if (O.is_some[u32](element_count(?ti, id)))     { code = 1; }
        if (strip_secret(?ti, id) != id)                { code = 1; }
        if (aggregate_nominal(?ti, id) != TYPE_ERROR)   { code = 1; }
        if (shape_kind(?ti, id) != TYPE_U8)             { code = 1; }
        if (O.is_some[*FieldTable](field_table_for(?ti, id))) { code = 1; }
        if (field_count(?ti, id) != 0)                  { code = 1; }
        if (O.is_some[*FieldEntry](field_at(?ti, id, 0))) { code = 1; }
        i = i + 1;
    }
    dnit(?ti);
    ret code;
}
