pub fun intern_nominal(ti: *TypeInterner, name: intern.StrId, owner: TypeOwner, kind: TypeKind) res[TypeId, fail.Fail] {
    var t: Type;
    t.kind = kind;
    t.data.nominal.name = name;
    t.data.nominal.owner = owner;
    t.data.nominal.incarnation = 0;
    t.data.nominal.syntax = intern.STR_NIL;
    ret intern_dedup(ti, t);
}

# an anonymous recipe belongs to one source incarnation
pub fun intern_anonymous(ti: *TypeInterner, name: intern.StrId, owner: TypeOwner,
    incarnation: u64, syntax: intern.StrId, kind: TypeKind) res[TypeId, fail.Fail] {
    if (incarnation == 0 || syntax == intern.STR_NIL) {
        ret res[TypeId, fail.Fail].err{fail.message("anonymous type requires its parsed incarnation and structural recipe")};
    }
    var t: Type;
    t.kind = kind;
    t.data.nominal.name = name;
    t.data.nominal.owner = owner;
    t.data.nominal.incarnation = incarnation;
    t.data.nominal.syntax = syntax;
    ret intern_dedup(ti, t);
}

pub fun intern_generic_param(ti: *TypeInterner, name: intern.StrId, owner: TypeOwner,
    owner_name: intern.StrId, owner_kind: TypeKind, index: u32) res[TypeId, fail.Fail] {
    var t: Type;
    t.kind = TYPE_GENERIC_PARAM;
    t.data.generic_param.name = name;
    t.data.generic_param.owner = owner;
    t.data.generic_param.owner_name = owner_name;
    t.data.generic_param.owner_kind = owner_kind;
    t.data.generic_param.index = index;
    ret intern_dedup(ti, t);
}

pub fun intern_function(ti: *TypeInterner, ret_type: TypeId, params: *TypeId, count: u32, c_variadic: bool) res[TypeId, fail.Fail] {
    if (count != 0 && params == nil) { ret res[TypeId, fail.Fail].err{fail.message("type parameter input is nil")}; }
    val h: u64 = hash_fun(ret_type, params, count, c_variadic);
    ret intern_function_bucket(ti, ret_type, params, count, c_variadic, h);
}

fun intern_function_bucket(ti: *TypeInterner, ret_type: TypeId, params: *TypeId, count: u32, c_variadic: bool, h: u64) res[TypeId, fail.Fail] {

    var head: TypeId = TYPE_NIL;
    val res_get: opt[*TypeId] = map.get[u64, TypeId](?ti.fun_index, ?h);
    if (sel res_get.some) {
        head = @res_get.some;
        var existing: TypeId = head;
        for (existing != TYPE_NIL) {
            val entry: res[*Type, fail.Fail] = fail.lift_res[*Type](handle.chunk_get[Type](?ti.types, existing::usize));
            if (sel entry.err) { ret res[TypeId, fail.Fail].err{entry.err}; }
            val candidate: *Type = entry.ok;
            if (candidate.kind != TYPE_FUN) { ret res[TypeId, fail.Fail].err{fail.message("type interner bucket has the wrong kind")}; }
            if (fun_matches(ti, existing, ret_type, params, count, c_variadic)) { ret res[TypeId, fail.Fail].ok{existing}; }
            existing = candidate.data.fn.next_in_bucket;
        }
    }

    val res_start: res[u32, fail.Fail] = params_append(ti, params, count);
    if (sel res_start.err) {
        ret res[TypeId, fail.Fail].err{res_start.err};
    }
    val start: u32 = res_start.ok;

    var t: Type;
    t.kind                 = TYPE_FUN;
    t.data.fn.ret_type     = ret_type;
    t.data.fn.params_start = start;
    t.data.fn.params_len   = count;
    t.data.fn.c_variadic   = c_variadic;

    t.data.fn.next_in_bucket = head;

    val res_append: res[TypeId, fail.Fail] = append_type(ti, t);
    if (sel res_append.err) {
        ti.params_len = start;
        ret res_append;
    }
    val tid: TypeId = res_append.ok;

    val res_insert: res[bool, A.Error] = map.insert[u64, TypeId](?ti.fun_index, h, tid);
    if (sel res_insert.err) {
        ti.types.len = tid::usize;
        ti.params_len = start;
        ret res[TypeId, fail.Fail].err{fail.refused(res_insert.err)};
    }

    ret res[TypeId, fail.Fail].ok{tid};
}

fun hash_instance(nominal: TypeId, args: *TypeId, count: u32) u64 {
    var h: u64 = fnv1a.FNV_INIT;
    h = fnv1a.step_u8(h, TYPE_INSTANCE::u8);
    h = fnv1a.step_u32(h, nominal::u32);
    h = fnv1a.step_u32(h, count);

    var i: u32 = 0;
    for (i < count) {
        h = fnv1a.step_u32(h, args[i]::u32);
        i = i + 1;
    }
    ret h;
}

fun instance_matches(ti: *TypeInterner, tid: TypeId, nominal: TypeId, args: *TypeId, count: u32) bool {
    val r: R.Result[*Type, str] = handle.chunk_get[Type](?ti.types, tid::usize);
    if (R.is_err[*Type, str](r)) { ret false; }
    val cand: *Type = R.unwrap_ok[*Type, str](r);
    if (cand.kind != TYPE_INSTANCE)                        { ret false; }
    if (cand.data.instance.nominal != nominal) { ret false; }
    if (cand.data.instance.args_len != count)               { ret false; }

    var i: u32 = 0;
    for (i < count) {
        if (ti.params[cand.data.instance.args_start + i] != args[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun intern_instance(ti: *TypeInterner, nominal: TypeId, args: *TypeId, count: u32) res[TypeId, fail.Fail] {
    if (count != 0 && args == nil) { ret res[TypeId, fail.Fail].err{fail.message("type parameter input is nil")}; }
    val h: u64 = hash_instance(nominal, args, count);
    ret intern_instance_bucket(ti, nominal, args, count, h);
}

fun intern_instance_bucket(ti: *TypeInterner, nominal: TypeId, args: *TypeId, count: u32, h: u64) res[TypeId, fail.Fail] {

    var head: TypeId = TYPE_NIL;
    val res_get: opt[*TypeId] = map.get[u64, TypeId](?ti.instance_index, ?h);
    if (sel res_get.some) {
        head = @res_get.some;
        var existing: TypeId = head;
        for (existing != TYPE_NIL) {
            val entry: res[*Type, fail.Fail] = fail.lift_res[*Type](handle.chunk_get[Type](?ti.types, existing::usize));
            if (sel entry.err) { ret res[TypeId, fail.Fail].err{entry.err}; }
            val candidate: *Type = entry.ok;
            if (candidate.kind != TYPE_INSTANCE) { ret res[TypeId, fail.Fail].err{fail.message("type interner bucket has the wrong kind")}; }
            if (instance_matches(ti, existing, nominal, args, count)) { ret res[TypeId, fail.Fail].ok{existing}; }
            existing = candidate.data.instance.next_in_bucket;
        }
    }

    val res_start: res[u32, fail.Fail] = params_append(ti, args, count);
    if (sel res_start.err) {
        ret res[TypeId, fail.Fail].err{res_start.err};
    }
    val start: u32 = res_start.ok;

    var t: Type;
    t.kind                        = TYPE_INSTANCE;
    t.data.instance.nominal       = nominal;
    t.data.instance.args_start    = start;
    t.data.instance.args_len      = count;

    t.data.instance.next_in_bucket = head;

    val res_append: res[TypeId, fail.Fail] = append_type(ti, t);
    if (sel res_append.err) {
        ti.params_len = start;
        ret res_append;
    }
    val tid: TypeId = res_append.ok;

    val res_insert: res[bool, A.Error] = map.insert[u64, TypeId](?ti.instance_index, h, tid);
    if (sel res_insert.err) {
        ti.types.len = tid::usize;
        ti.params_len = start;
        ret res[TypeId, fail.Fail].err{fail.refused(res_insert.err)};
    }

    ret res[TypeId, fail.Fail].ok{tid};
}

# translation shims (#3226): the legacy carriers the unmigrated neighbours
# still read (me, be, target, driver, session, query, editor, build). each
# spells the typed outcome above as the 1.x carrier and is deleted by the
# boundary flip, when the `_typed` core takes its name
pub fun init(ti: *TypeInterner, a: *A.Allocator) O.Option[str] {
    val r: err[fail.Fail] = init_typed(ti, a);
    if (sel r.err) { ret O.some[str](fail.describe(r.err)); }
    ret O.none[str]();
}

pub fun get(ti: *TypeInterner, tid: TypeId) O.Option[*Type] {
    val found: opt[*Type] = get_typed(ti, tid);
    if (sel found.some) { ret O.some[*Type](found.some); }
    ret O.none[*Type]();
}

pub fun get_param(ti: *TypeInterner, index: u32) O.Option[TypeId] {
    val found: opt[TypeId] = get_param_typed(ti, index);
    if (sel found.some) { ret O.some[TypeId](found.some); }
    ret O.none[TypeId]();
}

pub fun prim(ti: *TypeInterner, kind: TypeKind) O.Option[TypeId] {
    val found: opt[TypeId] = prim_typed(ti, kind);
    if (sel found.some) { ret O.some[TypeId](found.some); }
    ret O.none[TypeId]();
}

pub fun element_count(ti: *TypeInterner, tid: TypeId) O.Option[u32] {
    val found: opt[u32] = element_count_typed(ti, tid);
    if (sel found.some) { ret O.some[u32](found.some); }
    ret O.none[u32]();
}

pub fun field_table_for(ti: *TypeInterner, ty: TypeId) O.Option[*FieldTable] {
    val found: opt[*FieldTable] = field_table_for_typed(ti, ty);
    if (sel found.some) { ret O.some[*FieldTable](found.some); }
    ret O.none[*FieldTable]();
}

pub fun field_at(ti: *TypeInterner, ty: TypeId, ix: u32) O.Option[*FieldEntry] {
    val found: opt[*FieldEntry] = field_at_typed(ti, ty, ix);
    if (sel found.some) { ret O.some[*FieldEntry](found.some); }
    ret O.none[*FieldEntry]();
}

pub fun intern_secret(ti: *TypeInterner, base: TypeId) R.Result[TypeId, str] {
    ret fail.lower[TypeId](intern_secret_typed(ti, base));
}

pub fun intern_array(ti: *TypeInterner, base: TypeId, count: u32) R.Result[TypeId, str] {
    ret fail.lower[TypeId](intern_array_typed(ti, base, count));
}

pub fun intern_vector(ti: *TypeInterner, element: TypeKind, lanes: u32) R.Result[TypeId, str] {
    ret fail.lower[TypeId](intern_vector_typed(ti, element, lanes));
}

pub fun intern_handle(ti: *TypeInterner, name: intern.StrId, ctor: u32, ops: *u32, count: u32) R.Result[TypeId, str] {
    ret fail.lower[TypeId](intern_handle_typed(ti, name, ctor, ops, count));
}

pub fun type_equals_signatures(ti: *TypeInterner, a: TypeId, b: TypeId) bool {
    if (a == b) { ret true; }

    val ra: R.Result[*Type, str] = handle.chunk_get[Type](?ti.types, a::usize);
    val rb: R.Result[*Type, str] = handle.chunk_get[Type](?ti.types, b::usize);
    if (R.is_err[*Type, str](ra) || R.is_err[*Type, str](rb)) { ret false; }

    val ta: *Type = R.unwrap_ok[*Type, str](ra);
    val tb: *Type = R.unwrap_ok[*Type, str](rb);
    if (ta.kind != TYPE_FUN || tb.kind != TYPE_FUN)     { ret false; }
    if (ta.data.fn.ret_type != tb.data.fn.ret_type)     { ret false; }
    if (ta.data.fn.params_len != tb.data.fn.params_len) { ret false; }
    if (ta.data.fn.c_variadic != tb.data.fn.c_variadic) { ret false; }

    var i: u32 = 0;
    for (i < ta.data.fn.params_len) {
        if (ti.params[ta.data.fn.params_start + i] != ti.params[tb.data.fn.params_start + i]) {
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

pub fun field_projection_reset(ti: *TypeInterner) {
    handle.chunk_dnit[FieldTable](?ti.field_tables);
    handle.chunk_dnit[FieldEntry](?ti.field_pool);
    ti.field_tables = handle.chunk_init[FieldTable](ti.a);
    ti.field_pool = handle.chunk_init[FieldEntry](ti.a);
    map.clear[TypeId, u32](?ti.field_index);
    map.clear[TypeId, TypeId](?ti.disc_index);
    ti.field_epoch = 0;
    ti.gparam_epoch = 0;
    ti.projection_generation = ti.projection_generation + 1;
    if (ti.gparam != nil && ti.gparam_cap != 0) { memory.zero[u8](ti.gparam, ti.gparam_cap::usize); }
}

pub fun field_epoch_bump(ti: *TypeInterner) {
    ti.field_epoch = ti.field_epoch + 1;
}

pub fun field_epoch(ti: *TypeInterner) u32 {
    ret ti.field_epoch;
}

pub fun field_table_stage(ti: *TypeInterner, additional: u32) res[u32, fail.Fail] {
    val ce_r: R.Result[handle.ChunkEditor[FieldEntry], str] = handle.chunk_edit[FieldEntry](?ti.field_pool);
    if (R.is_err[handle.ChunkEditor[FieldEntry], str](ce_r)) {
        ret res[u32, fail.Fail].err{fail.message(R.unwrap_err[handle.ChunkEditor[FieldEntry], str](ce_r))};
    }
    var ce: handle.ChunkEditor[FieldEntry] = R.unwrap_ok[handle.ChunkEditor[FieldEntry], str](ce_r);
    val reserve_r: R.Result[R.Void, str] = handle.chunk_reserve[FieldEntry](?ce, additional::usize);
    handle.chunk_editor_finish[FieldEntry](?ce);
    if (R.is_err[R.Void, str](reserve_r)) {
        ret res[u32, fail.Fail].err{fail.message(R.unwrap_err[R.Void, str](reserve_r))};
    }
    ret res[u32, fail.Fail].ok{handle.chunk_count[FieldEntry](?ti.field_pool)::u32};
}

pub fun field_table_stage_push(ti: *TypeInterner, name: intern.StrId, ty: TypeId) err[fail.Fail] {
    ret field_table_stage_push_entry(ti, FieldEntry{ name: name, ty: ty, deprecation: deprecation.none() });
}

pub fun field_table_stage_push_entry(ti: *TypeInterner, fe: FieldEntry) err[fail.Fail] {
    val ce_r: R.Result[handle.ChunkEditor[FieldEntry], str] = handle.chunk_edit[FieldEntry](?ti.field_pool);
    if (R.is_err[handle.ChunkEditor[FieldEntry], str](ce_r)) {
        ret err[fail.Fail].err{fail.message(R.unwrap_err[handle.ChunkEditor[FieldEntry], str](ce_r))};
    }
    var ce: handle.ChunkEditor[FieldEntry] = R.unwrap_ok[handle.ChunkEditor[FieldEntry], str](ce_r);
    val push_r: R.Result[*FieldEntry, str] = handle.chunk_push[FieldEntry](?ce, fe);
    handle.chunk_editor_finish[FieldEntry](?ce);
    if (R.is_err[*FieldEntry, str](push_r)) {
        ret err[fail.Fail].err{fail.message(R.unwrap_err[*FieldEntry, str](push_r))};
    }
    ret err[fail.Fail].ok{};
}

pub fun field_table_publish(ti: *TypeInterner, ty: TypeId, fields_start: u32, fields_len: u32) err[fail.Fail] {
    val staged: u32 = handle.chunk_count[FieldEntry](?ti.field_pool)::u32;
    if (fields_start > staged || staged - fields_start < fields_len) {
        ret err[fail.Fail].err{fail.message("field table: staged run does not cover the published field count")};
    }

    val res_get: opt[*u32] = map.get[TypeId, u32](?ti.field_index, ?ty);
    if (sel res_get.some) {
        val idx: u32 = @res_get.some;
        val slot_r: R.Result[*FieldTable, str] = handle.chunk_get[FieldTable](?ti.field_tables, idx::usize);
        if (R.is_err[*FieldTable, str](slot_r)) {
            ret err[fail.Fail].err{fail.message(R.unwrap_err[*FieldTable, str](slot_r))};
        }
        val slot: *FieldTable = R.unwrap_ok[*FieldTable, str](slot_r);
        slot.fields_start = fields_start;
        slot.fields_len   = fields_len;
        slot.epoch        = ti.field_epoch;
        ret err[fail.Fail].ok{};
    }

    val ce_r: R.Result[handle.ChunkEditor[FieldTable], str] = handle.chunk_edit[FieldTable](?ti.field_tables);
    if (R.is_err[handle.ChunkEditor[FieldTable], str](ce_r)) {
        ret err[fail.Fail].err{fail.message(R.unwrap_err[handle.ChunkEditor[FieldTable], str](ce_r))};
    }
    var ce: handle.ChunkEditor[FieldTable] = R.unwrap_ok[handle.ChunkEditor[FieldTable], str](ce_r);

    var ft: FieldTable;
    ft.ty           = ty;
    ft.fields_start = fields_start;
    ft.fields_len   = fields_len;
    ft.epoch        = ti.field_epoch;
    val push_r: R.Result[*FieldTable, str] = handle.chunk_push[FieldTable](?ce, ft);
    handle.chunk_editor_finish[FieldTable](?ce);
    if (R.is_err[*FieldTable, str](push_r)) {
        ret err[fail.Fail].err{fail.message(R.unwrap_err[*FieldTable, str](push_r))};
    }

    val idx: u32 = handle.chunk_count[FieldTable](?ti.field_tables)::u32 - 1;
    val res_insert: res[bool, A.Error] = map.insert[TypeId, u32](?ti.field_index, ty, idx);
    if (sel res_insert.err) {
        ret err[fail.Fail].err{fail.refused(res_insert.err)};
    }

    ret err[fail.Fail].ok{};
}

pub fun aggregate_nominal(ti: *TypeInterner, tid: TypeId) TypeId {
    val opt_t: opt[*Type] = get_typed(ti, tid);
    if (!sel opt_t.some) { ret TYPE_ERROR; }
    val t: *Type = opt_t.some;
    if (t.kind == TYPE_REC || t.kind == TYPE_UNI || t.kind == TYPE_TAG) { ret tid; }
    if (t.kind != TYPE_INSTANCE) { ret TYPE_ERROR; }
    ret t.data.instance.nominal;
}

pub fun is_tag(ti: *TypeInterner, tid: TypeId) bool {
    ret nominal_kind_is(ti, tid, TYPE_TAG);
}

pub fun set_tag_discriminator(ti: *TypeInterner, tid: TypeId, disc: TypeId) err[fail.Fail] {
    val nom: TypeId = aggregate_nominal(ti, tid);
    if (!nominal_kind_is(ti, nom, TYPE_TAG)) { ret err[fail.Fail].ok{}; }
    if (disc == TYPE_NIL) {
        map.remove[TypeId, TypeId](?ti.disc_index, ?nom);
        ret err[fail.Fail].ok{};
    }
    val inserted: res[bool, A.Error] = map.insert[TypeId, TypeId](?ti.disc_index, nom, disc);
    if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun tag_discriminator(ti: *TypeInterner, tid: TypeId) TypeId {
    val nom: TypeId = aggregate_nominal(ti, tid);
    if (!nominal_kind_is(ti, nom, TYPE_TAG)) { ret TYPE_NIL; }
    val found: opt[*TypeId] = map.get[TypeId, TypeId](?ti.disc_index, ?nom);
    if (!sel found.some) { ret TYPE_NIL; }
    ret @found.some;
}

# the declared discriminator width in bytes, or zero when the tag has no usable declaration
pub fun tag_discriminator_bytes(ti: *TypeInterner, tid: TypeId) u32 {
    val disc: TypeId = tag_discriminator(ti, tid);
    if (disc == TYPE_NIL || disc == TYPE_ERROR) { ret 0; }
    val opt_t: opt[*Type] = get_typed(ti, disc);
    if (!sel opt_t.some) { ret 0; }
    ret prim_desc(opt_t.some.kind).bits / 8;
}

pub fun is_valid_discriminator_kind(k: TypeKind) bool {
    ret k == TYPE_U8 || k == TYPE_U16 || k == TYPE_U32 || k == TYPE_U64;
}

pub fun is_union(ti: *TypeInterner, tid: TypeId) bool {
    ret nominal_kind_is(ti, tid, TYPE_UNI);
}

pub fun is_record(ti: *TypeInterner, tid: TypeId) bool {
    ret nominal_kind_is(ti, tid, TYPE_REC);
}

fun nominal_kind_is(ti: *TypeInterner, tid: TypeId, want: TypeKind) bool {
    val opt_nom: opt[*Type] = get_typed(ti, aggregate_nominal(ti, tid));
    if (!sel opt_nom.some) { ret false; }
    ret opt_nom.some.kind == want;
}

pub fun field_table_for_typed(ti: *TypeInterner, ty: TypeId) opt[*FieldTable] {
    val res_get: opt[*u32] = map.get[TypeId, u32](?ti.field_index, ?ty);
    if (!sel res_get.some) {
        ret opt[*FieldTable].none{};
    }
    val idx: u32 = @res_get.some;
    val slot_r: R.Result[*FieldTable, str] = handle.chunk_get[FieldTable](?ti.field_tables, idx::usize);
    if (R.is_err[*FieldTable, str](slot_r)) { ret opt[*FieldTable].none{}; }
    val ft: *FieldTable = R.unwrap_ok[*FieldTable, str](slot_r);
    if (ft.epoch != ti.field_epoch) { ret opt[*FieldTable].none{}; }
    ret opt[*FieldTable].some{ft};
}

pub fun field_count(ti: *TypeInterner, ty: TypeId) u32 {
    val opt_ft: opt[*FieldTable] = field_table_for_typed(ti, ty);
    if (!sel opt_ft.some) { ret 0; }
    ret opt_ft.some.fields_len;
}

pub fun field_at_typed(ti: *TypeInterner, ty: TypeId, ix: u32) opt[*FieldEntry] {
    val opt_ft: opt[*FieldTable] = field_table_for_typed(ti, ty);
    if (!sel opt_ft.some) {
        ret opt[*FieldEntry].none{};
    }

    val ft: *FieldTable = opt_ft.some;
    if (ix >= ft.fields_len) {
        ret opt[*FieldEntry].none{};
    }

    val entry_r: R.Result[*FieldEntry, str] = handle.chunk_get[FieldEntry](?ti.field_pool, (ft.fields_start + ix)::usize);
    if (R.is_err[*FieldEntry, str](entry_r)) { ret opt[*FieldEntry].none{}; }
    ret opt[*FieldEntry].some{R.unwrap_ok[*FieldEntry, str](entry_r)};
}

pub fun field_entry_at(ti: *TypeInterner, ft: *FieldTable, ix: u32) *FieldEntry {
    val entry_r: R.Result[*FieldEntry, str] = handle.chunk_get[FieldEntry](?ti.field_pool, (ft.fields_start + ix)::usize);
    if (R.is_err[*FieldEntry, str](entry_r)) { ret nil; }
    ret R.unwrap_ok[*FieldEntry, str](entry_r);
}

fun intern_dedup(ti: *TypeInterner, t: Type) res[TypeId, fail.Fail] {
    val res_get: opt[*TypeId] = map.get[Type, TypeId](?ti.dedup, ?t);
    if (sel res_get.some) {
        ret res[TypeId, fail.Fail].ok{@res_get.some};
    }

    val res_append: res[TypeId, fail.Fail] = append_type(ti, t);
    if (sel res_append.err) {
        ret res_append;
    }
    val tid: TypeId = res_append.ok;

    val res_insert: res[bool, A.Error] = map.insert[Type, TypeId](?ti.dedup, t, tid);
    if (sel res_insert.err) {
        ti.types.len = tid::usize;
        ret res[TypeId, fail.Fail].err{fail.refused(res_insert.err)};
    }

    ret res[TypeId, fail.Fail].ok{tid};
}

fun append_type(ti: *TypeInterner, t: Type) res[TypeId, fail.Fail] {
    val count: usize = handle.chunk_count[Type](?ti.types);
    if (count >= TYPE_ERROR::usize) { ret res[TypeId, fail.Fail].err{fail.message("type identities are exhausted")}; }
    val tid: TypeId = count::TypeId;

    val ce_r: R.Result[handle.ChunkEditor[Type], str] = handle.chunk_edit[Type](?ti.types);
    if (R.is_err[handle.ChunkEditor[Type], str](ce_r)) {
        ret res[TypeId, fail.Fail].err{fail.message(R.unwrap_err[handle.ChunkEditor[Type], str](ce_r))};
    }
    var ce: handle.ChunkEditor[Type] = R.unwrap_ok[handle.ChunkEditor[Type], str](ce_r);

    val push_r: R.Result[*Type, str] = handle.chunk_push[Type](?ce, t);
    handle.chunk_editor_finish[Type](?ce);
    if (R.is_err[*Type, str](push_r)) {
        ret res[TypeId, fail.Fail].err{fail.message(R.unwrap_err[*Type, str](push_r))};
    }

    ret res[TypeId, fail.Fail].ok{tid};
}

fun reserve_params(ti: *TypeInterner, need: u32) err[fail.Fail] {
    val required_r: R.Result[layout.CheckedCount[TypeId], layout.CheckCause] =
        layout.count_add[TypeId](layout.count[TypeId](ti.params_len::usize), layout.count[TypeId](need::usize));
    if (R.is_err[layout.CheckedCount[TypeId], layout.CheckCause](required_r)) {
        ret err[fail.Fail].err{fail.message("type: params reservation count overflow")};
    }
    val required: layout.CheckedCount[TypeId] = R.unwrap_ok[layout.CheckedCount[TypeId], layout.CheckCause](required_r);

    if (required.value <= ti.params_cap::usize) {
        ret err[fail.Fail].ok{};
    }

    var base_cap: usize = ti.params_cap::usize;
    if (base_cap == 0) { base_cap = INITIAL_PARAMS_CAP::usize; }
    val grown_r: R.Result[layout.CheckedCount[TypeId], layout.CheckCause] =
        layout.count_grow[TypeId](layout.count[TypeId](base_cap), required);
    if (R.is_err[layout.CheckedCount[TypeId], layout.CheckCause](grown_r)) {
        ret err[fail.Fail].err{fail.message("type: params growth count overflow")};
    }
    val new_cap_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
        R.unwrap_ok[layout.CheckedCount[TypeId], layout.CheckCause](grown_r).value);
    if (R.is_err[u32, layout.CheckCause](new_cap_fits)) {
        ret err[fail.Fail].err{fail.message("type: params capacity exceeds the u32 limit")};
    }
    val new_cap: u32 = R.unwrap_ok[u32, layout.CheckCause](new_cap_fits);

    val res_ra_params: res[*TypeId, A.Error] = A.reallocate[TypeId](ti.a, ti.params, ti.params_cap::usize, new_cap::usize);
    if (sel res_ra_params.err) {
        ret err[fail.Fail].err{fail.refused(res_ra_params.err)};
    }
    ti.params     = res_ra_params.ok;
    ti.params_cap = new_cap;

    ret err[fail.Fail].ok{};
}

fun params_append(ti: *TypeInterner, src: *TypeId, len: u32) res[u32, fail.Fail] {
    val start: u32 = ti.params_len;
    if (len != 0 && src == nil) { ret res[u32, fail.Fail].err{fail.message("type parameter input is nil")}; }
    var borrowed: bool = false;
    var offset: usize = 0;
    if (len != 0 && ti.params != nil && src::usize >= ti.params::usize) {
        val delta: usize = src::usize - ti.params::usize;
        if (delta / $size_of(TypeId) < ti.params_cap::usize) {
            offset = delta / $size_of(TypeId);
            if (delta % $size_of(TypeId) != 0 || offset > start::usize || len::usize > start::usize - offset) {
                ret res[u32, fail.Fail].err{fail.message("type parameter input exceeds its owned run")};
            }
            borrowed = true;
        }
    }

    val res_reserve: err[fail.Fail] = reserve_params(ti, len);
    if (sel res_reserve.err) {
        ret res[u32, fail.Fail].err{res_reserve.err};
    }

    var input: *TypeId = src;
    if (borrowed) { input = ?ti.params[offset]; }
    var i: u32 = 0;
    for (i < len) {
        ti.params[start + i] = input[i];
        i = i + 1;
    }
    ti.params_len = start + len;

    ret res[u32, fail.Fail].ok{start};
}

fun hash_fun(ret_type: TypeId, params: *TypeId, count: u32, c_variadic: bool) u64 {
    var h: u64 = fnv1a.FNV_INIT;
    h = fnv1a.step_u8(h, TYPE_FUN::u8);
    h = fnv1a.step_u32(h, ret_type::u32);
    h = fnv1a.step_u32(h, count);
    h = fnv1a.step_u8(h, c_variadic::u8);

    var i: u32 = 0;
    for (i < count) {
        h = fnv1a.step_u32(h, params[i]::u32);
        i = i + 1;
    }
    ret h;
}

fun fun_matches(ti: *TypeInterner, tid: TypeId, ret_type: TypeId, params: *TypeId, count: u32, c_variadic: bool) bool {
    val r: R.Result[*Type, str] = handle.chunk_get[Type](?ti.types, tid::usize);
    if (R.is_err[*Type, str](r)) { ret false; }

    val t: *Type = R.unwrap_ok[*Type, str](r);
    if (t.kind != TYPE_FUN)                 { ret false; }
    if (t.data.fn.ret_type != ret_type)     { ret false; }
    if (t.data.fn.params_len != count)      { ret false; }
    if (t.data.fn.c_variadic != c_variadic) { ret false; }

    var i: u32 = 0;
    for (i < count) {
        if (ti.params[t.data.fn.params_start + i] != params[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun hash_type(p: ptr) u64 {
    val t: *Type = p::*Type;

    var h: u64 = fnv1a.FNV_INIT;
    h = fnv1a.step_u8(h, t.kind::u8);
    if (t.kind == TYPE_POINTER) {
        h = fnv1a.step_u32(h, t.data.pointer.base::u32);
    }
    or (t.kind == TYPE_SECRET) {
        h = fnv1a.step_u32(h, t.data.secret.base::u32);
    }
    or (t.kind == TYPE_ARRAY) {
        h = fnv1a.step_u32(h, t.data.array.base::u32);
        h = fnv1a.step_u32(h, t.data.array.count);
    }
    or (t.kind == TYPE_VECTOR) {
        h = fnv1a.step_u8(h, t.data.vector.element::u8);
        h = fnv1a.step_u32(h, t.data.vector.lanes);
    }
    or (t.kind == TYPE_REC || t.kind == TYPE_UNI || t.kind == TYPE_TAG) {
        h = fnv1a.step_u32(h, t.data.nominal.owner.module::u32);
        h = fnv1a.step_u32(h, t.data.nominal.owner.file::u32);
        h = fnv1a.step_u32(h, t.data.nominal.name::u32);
        h = fnv1a.step_u32(h, t.data.nominal.incarnation::u32);
        h = fnv1a.step_u32(h, (t.data.nominal.incarnation >> 32)::u32);
        h = fnv1a.step_u32(h, t.data.nominal.syntax::u32);
    }
    or (t.kind == TYPE_GENERIC_PARAM) {
        h = fnv1a.step_u32(h, t.data.generic_param.owner.module::u32);
        h = fnv1a.step_u32(h, t.data.generic_param.owner.file::u32);
        h = fnv1a.step_u32(h, t.data.generic_param.owner_name::u32);
        h = fnv1a.step_u8(h, t.data.generic_param.owner_kind);
        h = fnv1a.step_u32(h, t.data.generic_param.name::u32);
        h = fnv1a.step_u32(h, t.data.generic_param.index);
    }
    or (t.kind == TYPE_ABI) {
        h = fnv1a.step_u32(h, t.data.abi.tag);
        h = fnv1a.step_u32(h, t.data.abi.size);
        h = fnv1a.step_u32(h, t.data.abi.align);
    }
    or (t.kind == TYPE_CASE_SELECTOR) {
        h = fnv1a.step_u32(h, t.data.case_selector.tag_type::u32);
        h = fnv1a.step_u32(h, t.data.case_selector.case_name::u32);
        h = fnv1a.step_u32(h, t.data.case_selector.case_index);
    }
    ret h;
}

fun eq_type(pa: ptr, pb: ptr) bool {
    val a: *Type = pa::*Type;
    val b: *Type = pb::*Type;
    if (a.kind != b.kind) { ret false; }

    if (a.kind == TYPE_POINTER) {
        ret a.data.pointer.base == b.data.pointer.base;
    }
    if (a.kind == TYPE_SECRET) {
        ret a.data.secret.base == b.data.secret.base;
    }
    if (a.kind == TYPE_ARRAY) {
        ret a.data.array.base == b.data.array.base
            && a.data.array.count == b.data.array.count;
    }
    if (a.kind == TYPE_VECTOR) {
        ret a.data.vector.element == b.data.vector.element
            && a.data.vector.lanes == b.data.vector.lanes;
    }
    if (a.kind == TYPE_REC || a.kind == TYPE_UNI || a.kind == TYPE_TAG) {
        ret a.data.nominal.owner.module == b.data.nominal.owner.module
            && a.data.nominal.owner.file == b.data.nominal.owner.file
            && a.data.nominal.name == b.data.nominal.name
            && a.data.nominal.incarnation == b.data.nominal.incarnation
            && a.data.nominal.syntax == b.data.nominal.syntax;
    }
    if (a.kind == TYPE_GENERIC_PARAM) {
        ret a.data.generic_param.owner.module == b.data.generic_param.owner.module
            && a.data.generic_param.owner.file == b.data.generic_param.owner.file
            && a.data.generic_param.owner_name == b.data.generic_param.owner_name
            && a.data.generic_param.owner_kind == b.data.generic_param.owner_kind
            && a.data.generic_param.name == b.data.generic_param.name
            && a.data.generic_param.index == b.data.generic_param.index;
    }
    if (a.kind == TYPE_ABI) {
        ret a.data.abi.tag == b.data.abi.tag
            && a.data.abi.size == b.data.abi.size
            && a.data.abi.align == b.data.abi.align;
    }
    if (a.kind == TYPE_CASE_SELECTOR) {
        ret a.data.case_selector.tag_type == b.data.case_selector.tag_type
            && a.data.case_selector.case_name == b.data.case_selector.case_name
            && a.data.case_selector.case_index == b.data.case_selector.case_index;
    }

    ret true;
}

test "mach.lang.type.intern_function:identical_signatures" {
    var alloc: A.Allocator;
    val made_1: err[A.Error] = page.make(?alloc);
    if (sel made_1.err) { ret 1; }
    var ti: TypeInterner;
    val init_typed_1: err[fail.Fail] = init_typed(?ti, ?alloc);
    if (sel init_typed_1.err) { ret 1; }

    val prim_typed_2: opt[TypeId] = prim_typed(?ti, TYPE_U8);
    if (!sel prim_typed_2.some) { ret 1; }
    val u8_id: TypeId = prim_typed_2.some;

    val r1: res[TypeId, fail.Fail] = intern_function(?ti, u8_id, nil, 0, false);
    val r2: res[TypeId, fail.Fail] = intern_function(?ti, u8_id, nil, 0, false);
    if (sel r1.err)                                    { dnit(?ti); ret 1; }
    if (sel r2.err)                                    { dnit(?ti); ret 1; }
    if (r1.ok != r2.ok) { dnit(?ti); ret 1; }

    val prim_typed_3: opt[TypeId] = prim_typed(?ti, TYPE_U32);
    if (!sel prim_typed_3.some) { ret 1; }
    val u32_id: TypeId = prim_typed_3.some;
    val prim_typed_4: opt[TypeId] = prim_typed(?ti, TYPE_U64);
    if (!sel prim_typed_4.some) { ret 1; }
    val u64_id: TypeId = prim_typed_4.some;
    var p32: [1]TypeId;
    p32[0] = u32_id;
    var p64: [1]TypeId;
    p64[0] = u64_id;
    val r4: res[TypeId, fail.Fail] = intern_function(?ti, u8_id, ?p32[0], 1, false);
    val r5: res[TypeId, fail.Fail] = intern_function(?ti, u8_id, ?p64[0], 1, false);
    if (sel r4.err)                                    { dnit(?ti); ret 1; }
    if (sel r5.err)                                    { dnit(?ti); ret 1; }
    if (r4.ok == r5.ok) { dnit(?ti); ret 1; }

    val rv: res[TypeId, fail.Fail] = intern_function(?ti, u8_id, ?p32[0], 1, true);
    if (sel rv.err)                                    { dnit(?ti); ret 1; }
    if (rv.ok == r4.ok) { dnit(?ti); ret 1; }
    if (type_equals_signatures(?ti, rv.ok,
                                    r4.ok))    { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

test "mach.lang.type.intern_generic_param:dedup_by_persistent_owner_name_and_index" {
    var alloc: A.Allocator;
    val made_2: err[A.Error] = page.make(?alloc);
    if (sel made_2.err) { ret 1; }
    var ti: TypeInterner;
    val init_typed_1: err[fail.Fail] = init_typed(?ti, ?alloc);
    if (sel init_typed_1.err) { ret 1; }

    val r1: res[TypeId, fail.Fail] = intern_generic_param(?ti, 7::intern.StrId, TypeOwner{ module: 1::module.StableModuleId, file: 1::source.FileId }, 0::intern.StrId, TYPE_FUN, 0);
    val r2: res[TypeId, fail.Fail] = intern_generic_param(?ti, 7::intern.StrId, TypeOwner{ module: 1::module.StableModuleId, file: 1::source.FileId }, 0::intern.StrId, TYPE_FUN, 0);
    if (sel r1.err)                                    { dnit(?ti); ret 1; }
    if (sel r2.err)                                    { dnit(?ti); ret 1; }
    if (r1.ok != r2.ok) { dnit(?ti); ret 1; }

    val r_other_module: res[TypeId, fail.Fail] = intern_generic_param(?ti, 7::intern.StrId, TypeOwner{ module: 2::module.StableModuleId, file: 1::source.FileId }, 0::intern.StrId, TYPE_FUN, 0);
    if (sel r_other_module.err) { dnit(?ti); ret 1; }
    if (r1.ok == r_other_module.ok) { dnit(?ti); ret 1; }

    val r_other_owner: res[TypeId, fail.Fail] = intern_generic_param(?ti, 7::intern.StrId, TypeOwner{ module: 1::module.StableModuleId, file: 1::source.FileId }, 1::intern.StrId, TYPE_FUN, 0);
    if (sel r_other_owner.err) { dnit(?ti); ret 1; }
    if (r1.ok == r_other_owner.ok) { dnit(?ti); ret 1; }

    val r_other_index: res[TypeId, fail.Fail] = intern_generic_param(?ti, 7::intern.StrId, TypeOwner{ module: 1::module.StableModuleId, file: 1::source.FileId }, 0::intern.StrId, TYPE_FUN, 1);
    if (sel r_other_index.err) { dnit(?ti); ret 1; }
    if (r1.ok == r_other_index.ok) { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

test "mach.lang.type.intern_instance:dedup_by_nominal_and_arguments" {
    var alloc: A.Allocator;
    val made_3: err[A.Error] = page.make(?alloc);
    if (sel made_3.err) { ret 1; }
    var ti: TypeInterner;
    val init_typed_1: err[fail.Fail] = init_typed(?ti, ?alloc);
    if (sel init_typed_1.err) { ret 1; }

    val prim_typed_2: opt[TypeId] = prim_typed(?ti, TYPE_U32);
    if (!sel prim_typed_2.some) { ret 1; }
    val u32_id: TypeId = prim_typed_2.some;
    val prim_typed_3: opt[TypeId] = prim_typed(?ti, TYPE_U8);
    if (!sel prim_typed_3.some) { ret 1; }
    val u8_id:  TypeId = prim_typed_3.some;

    val rn: res[TypeId, fail.Fail] = intern_nominal(?ti, 0::intern.StrId, TypeOwner{ module: 1::module.StableModuleId, file: 1::source.FileId }, TYPE_REC);
    if (sel rn.err) { dnit(?ti); ret 1; }
    val nom: TypeId = rn.ok;

    var a1: [1]TypeId;
    a1[0] = u32_id;

    val r1: res[TypeId, fail.Fail] = intern_instance(?ti, nom, ?a1[0], 1);
    val r2: res[TypeId, fail.Fail] = intern_instance(?ti, nom, ?a1[0], 1);
    if (sel r1.err)                                    { dnit(?ti); ret 1; }
    if (sel r2.err)                                    { dnit(?ti); ret 1; }
    if (r1.ok != r2.ok) { dnit(?ti); ret 1; }

    var a1u8: [1]TypeId;
    a1u8[0] = u8_id;
    val r3: res[TypeId, fail.Fail] = intern_instance(?ti, nom, ?a1u8[0], 1);
    if (sel r3.err)                                    { dnit(?ti); ret 1; }
    if (r1.ok == r3.ok) { dnit(?ti); ret 1; }

    var a2: [2]TypeId;
    a2[0] = u32_id;
    a2[1] = u8_id;
    val r4: res[TypeId, fail.Fail] = intern_instance(?ti, nom, ?a2[0], 2);
    if (sel r4.err)                                    { dnit(?ti); ret 1; }
    if (r1.ok == r4.ok) { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

test "mach.lang.type.is_union:instance_follows_its_nominal" {
    var alloc: A.Allocator;
    val made_4: err[A.Error] = page.make(?alloc);
    if (sel made_4.err) { ret 1; }
    var ti: TypeInterner;
    val init_typed_1: err[fail.Fail] = init_typed(?ti, ?alloc);
    if (sel init_typed_1.err) { ret 1; }

    val prim_typed_2: opt[TypeId] = prim_typed(?ti, TYPE_U32);
    if (!sel prim_typed_2.some) { ret 1; }
    val u32_id: TypeId = prim_typed_2.some;
    var args: [1]TypeId;
    args[0] = u32_id;

    val rr: res[TypeId, fail.Fail] = intern_nominal(?ti, 0::intern.StrId, TypeOwner{ module: 1::module.StableModuleId, file: 1::source.FileId }, TYPE_REC);
    val ru: res[TypeId, fail.Fail] = intern_nominal(?ti, 1::intern.StrId, TypeOwner{ module: 1::module.StableModuleId, file: 1::source.FileId }, TYPE_UNI);
    if (sel rr.err) { dnit(?ti); ret 1; }
    if (sel ru.err) { dnit(?ti); ret 1; }
    val rec_nom: TypeId = rr.ok;
    val uni_nom: TypeId = ru.ok;

    val ri: res[TypeId, fail.Fail] = intern_instance(?ti, rec_nom, ?args[0], 1);
    val ui: res[TypeId, fail.Fail] = intern_instance(?ti, uni_nom, ?args[0], 1);
    if (sel ri.err) { dnit(?ti); ret 1; }
    if (sel ui.err) { dnit(?ti); ret 1; }
    val rec_inst: TypeId = ri.ok;
    val uni_inst: TypeId = ui.ok;

    val get_typed_3: opt[*Type] = get_typed(?ti, rec_inst);
    if (!sel get_typed_3.some) { ret 1; }
    if (get_typed_3.some.kind != TYPE_INSTANCE) { dnit(?ti); ret 1; }
    val get_typed_4: opt[*Type] = get_typed(?ti, uni_inst);
    if (!sel get_typed_4.some) { ret 1; }
    if (get_typed_4.some.kind != TYPE_INSTANCE) { dnit(?ti); ret 1; }

    if (aggregate_nominal(?ti, rec_inst) != rec_nom) { dnit(?ti); ret 1; }
    if (aggregate_nominal(?ti, uni_inst) != uni_nom) { dnit(?ti); ret 1; }

    if (is_union(?ti, uni_inst))   { } or { dnit(?ti); ret 1; }
    if (is_record(?ti, rec_inst))  { } or { dnit(?ti); ret 1; }
    if (is_union(?ti, rec_inst))   { dnit(?ti); ret 1; }
    if (is_record(?ti, uni_inst))  { dnit(?ti); ret 1; }

    if (is_union(?ti, uni_nom))  { } or { dnit(?ti); ret 1; }
    if (is_record(?ti, rec_nom)) { } or { dnit(?ti); ret 1; }
    if (is_union(?ti, u32_id))   { dnit(?ti); ret 1; }
    if (is_record(?ti, u32_id))  { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

test "mach.lang.type.vector_form:reads_the_form_at_every_width" {
    var vi: u32 = 0;
    for (vi < VEC_COUNT) {
        val sh: VecShape = vec_shape(vi);
        val f:  VecForm  = vector_form(sh.name);
        if (f.status  != VEC_FORM_OK) { ret 1; }
        if (f.element != sh.element)  { ret 1; }
        if (f.lanes   != sh.lanes)    { ret 1; }
        if (f.bits    != 128)         { ret 1; }
        vi = vi + 1;
    }

    val v3: VecForm = vector_form("f32x3");
    if (v3.status != VEC_FORM_OK) { ret 1; }
    if (v3.element != TYPE_F32)   { ret 1; }
    if (v3.lanes != 3)            { ret 1; }
    if (v3.bits != 96)            { ret 1; }

    val u3: VecForm = vector_form("u32x3");
    if (u3.status != VEC_FORM_OK) { ret 1; }
    if (u3.element != TYPE_U32)   { ret 1; }
    if (u3.lanes != 3)            { ret 1; }

    val v2: VecForm = vector_form("f32x2");
    if (v2.status != VEC_FORM_OK) { ret 1; }
    if (v2.lanes != 2)            { ret 1; }
    if (v2.bits != 64)            { ret 1; }

    val w5: VecForm = vector_form("f32x5");
    if (w5.status != VEC_FORM_OK) { ret 1; }
    if (w5.element != TYPE_F32)   { ret 1; }
    if (w5.lanes != 5)            { ret 1; }
    if (w5.bits != 160)           { ret 1; }

    val w8: VecForm = vector_form("f32x8");
    if (w8.status != VEC_FORM_OK) { ret 1; }
    if (w8.lanes != 8)            { ret 1; }
    if (w8.bits != 256)           { ret 1; }

    if (vector_form("i8x17").status  != VEC_FORM_OK) { ret 1; }
    if (vector_form("f64x3").status  != VEC_FORM_OK) { ret 1; }
    if (vector_form("f32x16").bits   != 512)         { ret 1; }
    if (vector_form("i16x7").bits    != 112)         { ret 1; }

    if (vector_form("u8x65535").status != VEC_FORM_OK)       { ret 1; }
    if (vector_form("u8x65535").lanes  != MAX_VEC_LANES)     { ret 1; }
    if (vector_form("u8x65536").status != VEC_FORM_TOO_WIDE) { ret 1; }

    if (vector_form("u64x4294967295").status != VEC_FORM_TOO_WIDE) { ret 1; }

    if (vector_form("f32x1").status != VEC_FORM_BAD_LANES) { ret 1; }

    if (vector_form(nil).status     != VEC_FORM_NONE) { ret 1; }
    if (vector_form("").status      != VEC_FORM_NONE) { ret 1; }
    if (vector_form("f32").status   != VEC_FORM_NONE) { ret 1; }
    if (vector_form("f32x").status  != VEC_FORM_NONE) { ret 1; }
    if (vector_form("x4").status    != VEC_FORM_NONE) { ret 1; }
    if (vector_form("f33x4").status != VEC_FORM_NONE) { ret 1; }
    if (vector_form("f32x4y").status != VEC_FORM_NONE) { ret 1; }
    if (vector_form("f32x04").status != VEC_FORM_NONE) { ret 1; }
    if (vector_form("ptrx2").status  != VEC_FORM_NONE) { ret 1; }
    if (vector_form("matrix4").status != VEC_FORM_NONE) { ret 1; }

    ret 0;
}

test "mach.lang.type.prim_name:spells_every_primitive" {
    if (!str_equals(prim_name(TYPE_U8),  "u8"))  { ret 1; }
    if (!str_equals(prim_name(TYPE_U16), "u16")) { ret 1; }
    if (!str_equals(prim_name(TYPE_U32), "u32")) { ret 1; }
    if (!str_equals(prim_name(TYPE_U64), "u64")) { ret 1; }
    if (!str_equals(prim_name(TYPE_I8),  "i8"))  { ret 1; }
    if (!str_equals(prim_name(TYPE_I16), "i16")) { ret 1; }
    if (!str_equals(prim_name(TYPE_I32), "i32")) { ret 1; }
    if (!str_equals(prim_name(TYPE_I64), "i64")) { ret 1; }
    if (!str_equals(prim_name(TYPE_F32), "f32")) { ret 1; }
    if (!str_equals(prim_name(TYPE_F64), "f64")) { ret 1; }
    if (!str_equals(prim_name(TYPE_PTR), "ptr")) { ret 1; }
    var k: u32 = 0;
    for (k < PRIM_COUNT) {
        if (prim_name(k::u8) == nil) { ret 1; }
        k = k + 1;
    }
    if (prim_name(TYPE_VECTOR) != nil) { ret 1; }
    ret 0;
}

test "mach.lang.type.prim_catalog:complete_unique_ordered_roundtrip" {
    if (PRIM_COUNT != TYPE_PTR::u32 + 1) { ret 1; }

    var seen: [PRIM_COUNT]bool;
    var i: u32 = 0;
    for (i < PRIM_COUNT) { seen[i] = false; i = i + 1; }

    i = 0;
    for (i < PRIM_COUNT) {
        val spec: *PrimSpec = ?PRIM_CATALOG[i];
        if (spec.kind::u32 != i)             { ret 1; }
        if (seen[spec.kind::u32])            { ret 1; }
        if (str_equals(spec.spelling, ""))   { ret 1; }
        if (spec.len != str_len(spec.spelling)) { ret 1; }
        seen[spec.kind::u32] = true;

        var j: u32 = 0;
        for (j < i) {
            val prior: *PrimSpec = ?PRIM_CATALOG[j];
            if (prior.kind == spec.kind)                 { ret 1; }
            if (str_equals(prior.spelling, spec.spelling)) { ret 1; }
            j = j + 1;
        }

        if (!str_equals(prim_name(spec.kind), spec.spelling)) { ret 1; }
        if (prim_spelling_len(spec.kind) != spec.len)          { ret 1; }
        val d: PrimDesc = prim_desc(spec.kind);
        if (d.class != spec.class)   { ret 1; }
        if (d.signed != spec.signed) { ret 1; }
        if (d.bits != spec.bits)     { ret 1; }

        val parsed: opt[TypeKind] = prim_from_name(spec.spelling);
        if (!sel parsed.some)                { ret 1; }
        if (parsed.some != spec.kind)    { ret 1; }
        i = i + 1;
    }

    val prim_from_name_1: opt[TypeKind] = prim_from_name("");
    if (sel prim_from_name_1.some)     { ret 1; }
    val prim_from_name_2: opt[TypeKind] = prim_from_name("bool");
    if (sel prim_from_name_2.some) { ret 1; }
    if (prim_name(TYPE_VECTOR) != nil)               { ret 1; }
    if (prim_spelling_len(TYPE_VECTOR) != 0)         { ret 1; }
    val nd: PrimDesc = prim_desc(TYPE_VECTOR);
    if (nd.class != PRIM_CLASS_NONE) { ret 1; }
    if (nd.signed)                   { ret 1; }
    if (nd.bits != 0)                { ret 1; }

    i = 0;
    for (i < PRIM_COUNT) {
        if (!seen[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.type.intern_vector:seeded_and_dedup" {
    var alloc: A.Allocator;
    val made_5: err[A.Error] = page.make(?alloc);
    if (sel made_5.err) { ret 1; }
    var ti: TypeInterner;
    val init_typed_1: err[fail.Fail] = init_typed(?ti, ?alloc);
    if (sel init_typed_1.err) { ret 1; }

    var vi: u32 = 0;
    for (vi < VEC_COUNT) {
        val sh:  VecShape          = vec_shape(vi);
        val found: opt[TypeId] = vec(?ti, vi);
        if (!sel found.some)                             { dnit(?ti); ret 1; }
        val tid: TypeId = found.some;
        if (!is_vector(?ti, tid))                               { dnit(?ti); ret 1; }
        if (vector_element(?ti, tid) != sh.element)             { dnit(?ti); ret 1; }
        if (vector_lanes(?ti, tid) != sh.lanes)                 { dnit(?ti); ret 1; }
        vi = vi + 1;
    }

    val vec_2: opt[TypeId] = vec(?ti, 0);
    if (!sel vec_2.some) { ret 1; }
    val f0: TypeId = vec_2.some;
    val r_f: res[TypeId, fail.Fail] = intern_vector_typed(?ti, TYPE_F32, 4);
    if (sel r_f.err)                     { dnit(?ti); ret 1; }
    if (r_f.ok != f0)            { dnit(?ti); ret 1; }

    val r_i: res[TypeId, fail.Fail] = intern_vector_typed(?ti, TYPE_I32, 4);
    if (sel r_i.err)                     { dnit(?ti); ret 1; }
    if (r_i.ok == f0)            { dnit(?ti); ret 1; }

    val vec_3: opt[TypeId] = vec(?ti, VEC_COUNT);
    if (sel vec_3.some)         { dnit(?ti); ret 1; }
    val prim_typed_4: opt[TypeId] = prim_typed(?ti, TYPE_U8);
    if (!sel prim_typed_4.some) { ret 1; }
    if (is_vector(?ti, prim_typed_4.some)) { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

