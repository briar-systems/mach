rec TypePointer {
    base: TypeId;
}

pub rec TypeSecret {
    base: TypeId;
}

rec TypeVector {
    element: TypeKind;
    lanes:   u32;
}

pub rec TypeHandle {
    name:      intern.StrId;
    ctor:      u32;
    ops_start: u32;
    ops_len:   u32;
}

rec TypeAbi {
    name:  intern.StrId;
    tag:   u32;
    size:  u32;
    align: u32;
}

pub val ABI_TYPE_VA_LIST: u32 = 0;

# the C type an ABI type tag stands for, absent for a tag outside the catalog
pub fun abi_type_c_name(tag: u32) opt[str] {
    if (tag == ABI_TYPE_VA_LIST) { ret opt[str].some{"va_list"}; }
    ret opt[str].none{};
}

pub rec TypeArray {
    base:  TypeId;
    count: u32;
}

pub rec TypeFun {
    ret_type:       TypeId;
    params_start:   u32;
    params_len:     u32;
    c_variadic:     bool;
    next_in_bucket: TypeId;
}

# persistent source identity, independent of the current module registry
pub rec TypeOwner {
    module: module.StableModuleId;
    file:   lang_source.FileId;
}

pub rec TypeNominal {
    name:        intern.StrId;
    owner:       TypeOwner;
    incarnation: u64;
    syntax:      intern.StrId;
}

rec TypeGenericParam {
    name:       intern.StrId;
    owner:      TypeOwner;
    owner_name: intern.StrId;
    owner_kind: TypeKind;
    index:      u32;
}

# the declaration whose type parameters a substitution replaces: a parameter
# of any other declaration, an enclosing generic's for one, is left as it is
pub rec GenericOwner {
    owner: TypeOwner;
    name:  intern.StrId;
    kind:  TypeKind;
}

pub fun generic_owner_equals(a: *GenericOwner, b: *GenericOwner) bool {
    ret module.stable_same(a.owner.module, b.owner.module) && lang_source.file_same(a.owner.file, b.owner.file)
        && intern.str_same(a.name, b.name) && a.kind == b.kind;
}

pub fun param_owner(p: *TypeGenericParam) GenericOwner {
    ret GenericOwner{owner: p.owner, name: p.owner_name, kind: p.owner_kind};
}

pub fun param_owned_by(p: *TypeGenericParam, who: *GenericOwner) bool {
    var of: GenericOwner = param_owner(p);
    ret generic_owner_equals(?of, who);
}

rec TypeInstance {
    nominal:        TypeId;
    args_start:     u32;
    args_len:       u32;
    next_in_bucket: TypeId;
}

rec TypeCaseSelector {
    tag_type:   TypeId;
    case_name:  intern.StrId;
    case_index: u32;
}

pub rec Type {
    kind: TypeKind;
    data: uni {
        pointer: TypePointer;
        secret: TypeSecret;
        array: TypeArray;
        vector: TypeVector;
        handle: TypeHandle;
        abi: TypeAbi;
        fn: TypeFun;
        nominal: TypeNominal;
        generic_param: TypeGenericParam;
        instance: TypeInstance;
        case_selector: TypeCaseSelector;
    };
}

pub rec TypeInterner {
    a: *A.Allocator;

    types: handle.StableChunks[Type];

    params:     *TypeId;
    params_len: u32;
    params_cap: u32;

    dedup: map.MapBy[Type, TypeId];

    fun_index:      map.Map[u64, TypeId];
    instance_index: map.Map[u64, TypeId];

    handles:     *TypeId;
    handles_len: u32;
    handles_cap: u32;

    handle_ops:     *u32;
    handle_ops_len: u32;
    handle_ops_cap: u32;

    prims: [type_prim.PRIM_COUNT]TypeId;

    vecs: [type_prim.VEC_COUNT]TypeId;

    fields: type_field.Projection;

    # bumped by every projection reset, which drops every fact derived from the tables;
    # published tables never change otherwise
    projection_generation: u64;

    scans: type_scan.Sets;
}

val INITIAL_PARAMS_CAP: u32 = 32;

pub fun init(ti: *TypeInterner, a: *A.Allocator) err[fail.Fail] {
    ti.a = a;

    ti.types = handle.chunk_init[Type](a);

    ti.params     = nil;
    ti.params_len = 0;
    ti.params_cap = 0;

    ti.handles        = nil;
    ti.handles_len    = 0;
    ti.handles_cap    = 0;
    ti.handle_ops     = nil;
    ti.handle_ops_len = 0;
    ti.handle_ops_cap = 0;

    ti.fields                = type_field.projection_init(a);
    ti.projection_generation = 0;
    ti.scans                 = type_scan.sets_init(a);

    ti.dedup          = map.init_by[Type, TypeId](a, hash_type, eq_type);
    ti.fun_index      = map.init[u64, TypeId](a);
    ti.instance_index = map.init[u64, TypeId](a);

    var handed: bool = false;
    fin {
        if (!handed) { dnit(ti); }
    }

    val res_params: res[*TypeId, A.Error] = A.allocate[TypeId](a, INITIAL_PARAMS_CAP::usize);
    if (sel res_params.err) {
        ret err[fail.Fail].err{fail.refused(res_params.err)};
    }
    ti.params     = res_params.ok;
    ti.params_cap = INITIAL_PARAMS_CAP;

    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        var t: Type;
        t.kind = prim_kind_at(i);

        val res_append: res[TypeId, fail.Fail] = append_type(ti, t);
        if (sel res_append.err) {
            ret err[fail.Fail].err{res_append.err};
        }
        val tid: TypeId = res_append.ok;
        ti.prims[i] = tid;

        val res_insert: res[bool, A.Error] = map.insert_by[Type, TypeId](?ti.dedup, t, tid);
        if (sel res_insert.err) {
            ret err[fail.Fail].err{fail.refused(res_insert.err)};
        }

        i = i + 1;
    }

    var vi: u32 = 0;
    for (vi < type_prim.VEC_COUNT) {
        val sh:      type_prim.VecShape     = type_prim.vec_shape(vi);
        val res_vec: res[TypeId, fail.Fail] = intern_vector(ti, sh.element, sh.lanes);
        if (sel res_vec.err) {
            ret err[fail.Fail].err{res_vec.err};
        }
        ti.vecs[vi] = res_vec.ok;
        vi          = vi + 1;
    }

    handed = true;
    ret err[fail.Fail].ok{};
}

# release a type store; a nil store holds nothing
pub fun dnit(ti: *TypeInterner) {
    if (ti == nil) { ret; }

    handle.chunk_dnit[Type](?ti.types);
    if (ti.params != nil && ti.params_cap > 0) {
        A.deallocate[TypeId](ti.a, ti.params, ti.params_cap::usize);
    }
    if (ti.handles != nil && ti.handles_cap > 0) {
        A.deallocate[TypeId](ti.a, ti.handles, ti.handles_cap::usize);
    }
    if (ti.handle_ops != nil && ti.handle_ops_cap > 0) {
        A.deallocate[u32](ti.a, ti.handle_ops, ti.handle_ops_cap::usize);
    }
    type_field.projection_dnit(?ti.fields);
    type_scan.sets_dnit(?ti.scans);

    map.dnit_by[Type, TypeId](?ti.dedup);
    map.dnit[u64, TypeId](?ti.fun_index);
    map.dnit[u64, TypeId](?ti.instance_index);

    ti.params     = nil;
    ti.params_len = 0;
    ti.params_cap = 0;

    ti.handles        = nil;
    ti.handles_len    = 0;
    ti.handles_cap    = 0;
    ti.handle_ops     = nil;
    ti.handle_ops_len = 0;
    ti.handle_ops_cap = 0;

    ti.projection_generation = 0;
}

pub fun get(ti: *TypeInterner, tid: TypeId) opt[*Type] {
    val r: opt[*Type] = handle.chunk_at[Type](?ti.types, index(tid)::usize);
    if (sel r.none) { ret opt[*Type].none{}; }
    ret opt[*Type].some{r.some};
}

pub fun type_count(ti: *TypeInterner) u32 {
    ret handle.chunk_count[Type](?ti.types)::u32;
}

pub fun get_param(ti: *TypeInterner, index: u32) opt[TypeId] {
    if (index >= ti.params_len) { ret opt[TypeId].none{}; }
    ret opt[TypeId].some{ti.params[index]};
}

pub fun prim(ti: *TypeInterner, kind: TypeKind) opt[TypeId] {
    val index: opt[u32] = type_prim.prim_index(kind);
    if (!sel index.some) { ret opt[TypeId].none{}; }
    ret opt[TypeId].some{ti.prims[index.some]};
}

pub fun is_integer(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret false; }
    ret prim_desc(opt_type.some.kind).class == PRIM_CLASS_INT;
}

pub fun is_numeric(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret false; }
    val c: PrimClass = prim_desc(opt_type.some.kind).class;
    ret c == PRIM_CLASS_INT || c == PRIM_CLASS_FLOAT;
}

pub fun is_float(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret false; }
    ret prim_desc(opt_type.some.kind).class == PRIM_CLASS_FLOAT;
}

pub fun is_pointer_like(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret false; }
    val k: TypeKind = opt_type.some.kind;
    ret k == TYPE_PTR || k == TYPE_POINTER || k == TYPE_FUN;
}

pub fun is_pointer(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret false; }
    ret opt_type.some.kind == TYPE_POINTER;
}

pub fun deref_one(ti: *TypeInterner, tid: TypeId) TypeId {
    val opt_type: opt[*Type] = get(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret TYPE_ERROR; }
    val t: *Type = opt_type.some;
    if (t.kind == TYPE_POINTER) {
        ret t.data.pointer.base;
    }
    ret TYPE_ERROR;
}

pub fun is_secret(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get(ti, tid);
    if (!sel opt_type.some) { ret false; }
    ret opt_type.some.kind == TYPE_SECRET;
}

pub fun is_vector(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret false; }
    ret opt_type.some.kind == TYPE_VECTOR;
}

pub fun vector_element(ti: *TypeInterner, tid: TypeId) TypeKind {
    val opt_type: opt[*Type] = get(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret TYPE_VECTOR; }
    val t: *Type = opt_type.some;
    if (t.kind != TYPE_VECTOR) { ret TYPE_VECTOR; }
    ret t.data.vector.element;
}

pub fun vector_lanes(ti: *TypeInterner, tid: TypeId) u32 {
    val opt_type: opt[*Type] = get(ti, strip_secret(ti, tid));
    if (!sel opt_type.some) { ret 0; }
    val t: *Type = opt_type.some;
    if (t.kind != TYPE_VECTOR) { ret 0; }
    ret t.data.vector.lanes;
}

pub fun element_count(ti: *TypeInterner, tid: TypeId) opt[u32] {
    if (is_nil(tid) || is_error(tid)) { ret opt[u32].none{}; }
    val t_opt: opt[*Type] = get(ti, strip_secret(ti, tid));
    if (!sel t_opt.some) { ret opt[u32].none{}; }
    val t: *Type = t_opt.some;
    if (t.kind == TYPE_ARRAY)  { ret opt[u32].some{t.data.array.count}; }
    if (t.kind == TYPE_VECTOR) { ret opt[u32].some{t.data.vector.lanes}; }
    ret opt[u32].none{};
}

pub fun vector_mask(ti: *TypeInterner, tid: TypeId) res[TypeId, fail.Fail] {
    val element: TypeKind = vector_element(ti, tid);
    val lanes:   u32      = vector_lanes(ti, tid);
    val bits:    u32      = prim_desc(element).bits;

    var mask_elem: TypeKind = TYPE_U8;
    if (bits == 8)  { mask_elem = TYPE_U8; }
    or (bits == 16) { mask_elem = TYPE_U16; }
    or (bits == 32) { mask_elem = TYPE_U32; }
    or (bits == 64) { mask_elem = TYPE_U64; }

    ret intern_vector(ti, mask_elem, lanes);
}

pub fun strip_secret(ti: *TypeInterner, tid: TypeId) TypeId {
    val opt_type: opt[*Type] = get(ti, tid);
    if (!sel opt_type.some) { ret tid; }
    val t: *Type = opt_type.some;
    if (t.kind != TYPE_SECRET) { ret tid; }
    ret t.data.secret.base;
}

# whether `tid` mentions a type parameter anywhere it is spelled. the walk keeps the types it
# has yet to visit on a worklist rather than the stack, so a type nested through flat defs
# deeper than any stack is still answered; a worklist that cannot grow is the failure
pub fun mentions_generic_param(ti: *TypeInterner, tid: TypeId) res[bool, fail.Fail] {
    var work: Vector[TypeId] = collections_vector.init[TypeId](ti.a);
    fin { collections_vector.dnit[TypeId](?work); }
    var at: TypeId = tid;
    for {
        var next: TypeId = TYPE_NIL;
        if (!is_error(at) && !is_nil(at)) {
            val t_opt: opt[*Type] = get(ti, at);
            if (sel t_opt.some) {
                val t: *Type = t_opt.some;
                if (t.kind == TYPE_GENERIC_PARAM) { ret res[bool, fail.Fail].ok{true}; }
                or (t.kind == TYPE_POINTER)       { next = t.data.pointer.base; }
                or (t.kind == TYPE_SECRET)        { next = t.data.secret.base; }
                or (t.kind == TYPE_ARRAY)         { next = t.data.array.base; }
                or (t.kind == TYPE_FUN) {
                    val queued: err[fail.Fail] = params_queue(ti, ?work, t.data.fn.params_start, t.data.fn.params_len);
                    if (sel queued.err) { ret res[bool, fail.Fail].err{queued.err}; }
                    next = t.data.fn.ret_type;
                }
                or (t.kind == TYPE_INSTANCE) {
                    val queued: err[fail.Fail] = params_queue(ti, ?work, t.data.instance.args_start, t.data.instance.args_len);
                    if (sel queued.err) { ret res[bool, fail.Fail].err{queued.err}; }
                }
            }
        }
        if (is_nil(next)) {
            val popped: opt[TypeId] = collections_vector.pop[TypeId](?work);
            if (sel popped.none) { ret res[bool, fail.Fail].ok{false}; }
            next = popped.some;
        }
        at = next;
    }
}

# queues the `len` types of the parameter pool from `start` for a walk to visit
fun params_queue(ti: *TypeInterner, work: *Vector[TypeId], start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val p: opt[TypeId] = get_param(ti, start + i);
        if (sel p.some) {
            val pushed: res[usize, A.Error] = collections_vector.push[TypeId](work, p.some);
            if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun shape_kind(ti: *TypeInterner, tid: TypeId) TypeKind {
    if (is_nil(tid) || is_error(tid)) { ret TYPE_U8; }
    val base:  TypeId     = strip_secret(ti, tid);
    val t_opt: opt[*Type] = get(ti, base);
    if (!sel t_opt.some) { ret TYPE_U8; }
    val t: *Type = t_opt.some;
    if (t.kind != TYPE_INSTANCE) { ret t.kind; }

    val nom: TypeId = t.data.instance.nominal;
    if (is_error(nom) || same(nom, base)) { ret t.kind; }
    val n_opt: opt[*Type] = get(ti, nom);
    if (!sel n_opt.some) { ret t.kind; }
    ret n_opt.some.kind;
}

pub fun is_u8(ti: *TypeInterner, tid: TypeId) bool {
    if (is_nil(tid) || is_error(tid)) { ret false; }
    val base:  TypeId     = strip_secret(ti, tid);
    val found: opt[*Type] = get(ti, base);
    if (!sel found.some) { ret false; }
    ret shape_kind(ti, base) == TYPE_U8;
}

# whether `tid` is secret or reaches a secret through pointers and array elements alone
pub fun carries_secret(ti: *TypeInterner, tid: TypeId) bool {
    var at: TypeId = tid;
    for {
        val opt_type: opt[*Type] = get(ti, at);
        if (!sel opt_type.some) { ret false; }
        val t: *Type = opt_type.some;
        if (t.kind == TYPE_SECRET)  { ret true; }
        if (t.kind == TYPE_POINTER) { at = t.data.pointer.base; }
        or (t.kind == TYPE_ARRAY)   { at = t.data.array.base; }
        or                          { ret false; }
    }
}

# true when any byte of a value of this type may be secret: the type itself, an element, a field or a case
# payload; a pointer's pointee is not the object's storage and does not count. the walk keeps the
# fields it has yet to visit on a worklist, so a type nested deeper than any stack is still
# answered; a worklist that cannot grow is the failure
pub fun contains_secret(ti: *TypeInterner, tid: TypeId) res[bool, fail.Fail] {
    var work: Vector[TypeId] = collections_vector.init[TypeId](ti.a);
    fin { collections_vector.dnit[TypeId](?work); }
    var at: TypeId = tid;
    for {
        var next:     TypeId     = TYPE_NIL;
        val opt_type: opt[*Type] = get(ti, at);
        if (sel opt_type.some) {
            val t: *Type = opt_type.some;
            if (t.kind == TYPE_SECRET) { ret res[bool, fail.Fail].ok{true}; }
            or (t.kind == TYPE_ARRAY)  { next = t.data.array.base; }
            or (t.kind == TYPE_REC || t.kind == TYPE_UNI || t.kind == TYPE_TAG || t.kind == TYPE_INSTANCE) {
                val n: u32 = field_count(ti, at);
                var i: u32 = 0;
                for (i < n) {
                    val fe: opt[*FieldEntry] = field_at(ti, at, i);
                    if (sel fe.some) {
                        val pushed: res[usize, A.Error] = collections_vector.push[TypeId](?work, fe.some.ty);
                        if (sel pushed.err) { ret res[bool, fail.Fail].err{fail.refused(pushed.err)}; }
                    }
                    i = i + 1;
                }
            }
        }
        if (is_nil(next)) {
            val popped: opt[TypeId] = collections_vector.pop[TypeId](?work);
            if (sel popped.none) { ret res[bool, fail.Fail].ok{false}; }
            next = popped.some;
        }
        at = next;
    }
}

pub fun type_scan_begin(ti: *TypeInterner, scan: *TypeScan) err[fail.Fail] {
    ret type_scan.begin(?ti.scans, scan);
}

pub fun type_scan_end(ti: *TypeInterner, scan: *TypeScan) {
    type_scan.end(?ti.scans, scan);
}

pub fun type_scan_mark(ti: *TypeInterner, scan: *TypeScan, tid: TypeId) res[VisitMark, fail.Fail] {
    ret type_scan.mark(?ti.scans, scan, tid);
}

pub fun pair_scan_begin(ti: *TypeInterner, scan: *PairScan) err[fail.Fail] {
    ret type_scan.pair_begin(?ti.scans, scan);
}

pub fun pair_scan_end(ti: *TypeInterner, scan: *PairScan) {
    type_scan.pair_end(?ti.scans, scan);
}

pub fun pair_scan_mark(ti: *TypeInterner, scan: *PairScan, a: TypeId, b: TypeId) res[VisitMark, fail.Fail] {
    ret type_scan.pair_mark(?ti.scans, scan, a, b);
}

pub fun intern_pointer(ti: *TypeInterner, base: TypeId) res[TypeId, fail.Fail] {
    var t: Type;
    t.kind              = TYPE_POINTER;
    t.data.pointer.base = base;
    ret intern_dedup(ti, t);
}

pub fun intern_secret(ti: *TypeInterner, base: TypeId) res[TypeId, fail.Fail] {
    if (is_error(base))      { ret res[TypeId, fail.Fail].ok{TYPE_ERROR}; }
    if (is_secret(ti, base)) { ret res[TypeId, fail.Fail].ok{base}; }
    var t: Type;
    t.kind             = TYPE_SECRET;
    t.data.secret.base = base;
    ret intern_dedup(ti, t);
}

pub fun intern_array(ti: *TypeInterner, base: TypeId, count: u32) res[TypeId, fail.Fail] {
    var t: Type;
    t.kind             = TYPE_ARRAY;
    t.data.array.base  = base;
    t.data.array.count = count;
    ret intern_dedup(ti, t);
}

pub fun intern_vector(ti: *TypeInterner, element: TypeKind, lanes: u32) res[TypeId, fail.Fail] {
    var t: Type;
    t.kind                = TYPE_VECTOR;
    t.data.vector.element = element;
    t.data.vector.lanes   = lanes;
    ret intern_dedup(ti, t);
}

# the type of the window `object[start, count]`, its one owner: `count` lanes of a vector as a
# vector of that width, or `count` elements of an array or through a pointer as `[count]T`; a
# secret object gives a secret window, as a whole read of it is secret
pub fun intern_window(ti: *TypeInterner, object: TypeId, count: u32) res[TypeId, fail.Fail] {
    val found: opt[*Type] = get(ti, strip_secret(ti, object));
    if (sel found.none) { ret res[TypeId, fail.Fail].err{fail.message(WINDOW_NO_ELEMENTS_TEXT)}; }
    val window: res[TypeId, fail.Fail] = intern_window_shape(ti, found.some, count);
    if (sel window.err)         { ret window; }
    if (!is_secret(ti, object)) { ret window; }
    ret intern_secret(ti, window.ok);
}

val WINDOW_NO_ELEMENTS_TEXT: str = "a window is taken over a type with no elements";

fun intern_window_shape(ti: *TypeInterner, t: *Type, count: u32) res[TypeId, fail.Fail] {
    if (t.kind == TYPE_VECTOR)  { ret intern_vector(ti, t.data.vector.element, count); }
    if (t.kind == TYPE_ARRAY)   { ret intern_array(ti, t.data.array.base, count); }
    if (t.kind == TYPE_POINTER) { ret intern_array(ti, t.data.pointer.base, count); }
    ret res[TypeId, fail.Fail].err{fail.message(WINDOW_NO_ELEMENTS_TEXT)};
}

pub fun intern_handle(ti: *TypeInterner, name: intern.StrId, ctor: u32, ops: *u32, count: u32) res[TypeId, fail.Fail] {
    var i: u32 = 0;
    for (i < ti.handles_len) {
        val tid:  TypeId     = ti.handles[i];
        val slot: opt[*Type] = handle.chunk_at[Type](?ti.types, index(tid)::usize);
        if (sel slot.none) { ret res[TypeId, fail.Fail].err{fail.message(type_kind.TABLE_INDEX_TEXT)}; }
        val cand: *Type = slot.some;
        if (cand.data.handle.ctor == ctor && cand.data.handle.ops_len == count) {
            var ops_match: bool = true;
            var oi:        u32  = 0;
            for (oi < count) {
                if (ti.handle_ops[cand.data.handle.ops_start + oi] != ops[oi]) {
                    ops_match = false;
                    brk;
                }
                oi = oi + 1;
            }
            if (ops_match) { ret res[TypeId, fail.Fail].ok{tid}; }
        }
        i = i + 1;
    }

    val res_start: res[u32, fail.Fail] = handle_ops_append(ti, ops, count);
    if (sel res_start.err) {
        ret res[TypeId, fail.Fail].err{res_start.err};
    }

    var t: Type;
    t.kind                  = TYPE_HANDLE;
    t.data.handle.name      = name;
    t.data.handle.ctor      = ctor;
    t.data.handle.ops_start = res_start.ok;
    t.data.handle.ops_len   = count;

    val res_append: res[TypeId, fail.Fail] = append_type(ti, t);
    if (sel res_append.err) {
        ti.handle_ops_len = t.data.handle.ops_start;
        ret res_append;
    }
    val tid: TypeId = res_append.ok;

    val res_track: err[fail.Fail] = track_handle(ti, tid);
    if (sel res_track.err) {
        ti.types.len      = index(tid)::usize;
        ti.handle_ops_len = t.data.handle.ops_start;
        ret res[TypeId, fail.Fail].err{res_track.err};
    }
    ret res[TypeId, fail.Fail].ok{tid};
}

pub fun is_handle(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get(ti, tid);
    if (!sel opt_type.some) { ret false; }
    ret opt_type.some.kind == TYPE_HANDLE;
}

# a handle, or a pointer, array or secret over one: every shape that places a handle
# where the program would own its storage
pub fun carries_handle(ti: *TypeInterner, tid: TypeId) bool {
    var at: TypeId = tid;
    for {
        if (is_nil(at) || is_error(at)) { ret false; }
        val opt_type: opt[*Type] = get(ti, at);
        if (!sel opt_type.some) { ret false; }
        val t: *Type = opt_type.some;
        if (t.kind == TYPE_HANDLE)  { ret true; }
        if (t.kind == TYPE_SECRET)  { at = t.data.secret.base; }
        or (t.kind == TYPE_POINTER) { at = t.data.pointer.base; }
        or (t.kind == TYPE_ARRAY)   { at = t.data.array.base; }
        or                          { ret false; }
    }
}

# an array whose elements carry a handle, reached directly or through a pointer or secret
pub fun handle_in_array(ti: *TypeInterner, tid: TypeId) bool {
    var at: TypeId = tid;
    for {
        if (is_nil(at) || is_error(at)) { ret false; }
        val opt_type: opt[*Type] = get(ti, at);
        if (!sel opt_type.some) { ret false; }
        val t: *Type = opt_type.some;
        if (t.kind == TYPE_ARRAY)   { ret carries_handle(ti, t.data.array.base); }
        if (t.kind == TYPE_SECRET)  { at = t.data.secret.base; }
        or (t.kind == TYPE_POINTER) { at = t.data.pointer.base; }
        or                          { ret false; }
    }
}

# a pointer to a pointer to a handle, through any secret: the innermost double indirection
# of every deeper one, so a chain of pointers over a handle matches at exactly one level
pub fun handle_pointer_pointer(ti: *TypeInterner, tid: TypeId) bool {
    if (!is_pointer(ti, tid)) { ret false; }
    val inner: TypeId = deref_one(ti, tid);
    if (!is_pointer(ti, inner)) { ret false; }
    ret is_handle(ti, strip_secret(ti, deref_one(ti, inner)));
}

# a pointer to a pointer to a handle anywhere under the pointers, arrays and secrets of a type
pub fun has_handle_pointer_pointer(ti: *TypeInterner, tid: TypeId) bool {
    var at: TypeId = tid;
    for {
        if (handle_pointer_pointer(ti, at)) { ret true; }
        val opt_type: opt[*Type] = get(ti, at);
        if (!sel opt_type.some) { ret false; }
        val t: *Type = opt_type.some;
        if (t.kind == TYPE_SECRET)  { at = t.data.secret.base; }
        or (t.kind == TYPE_POINTER) { at = t.data.pointer.base; }
        or (t.kind == TYPE_ARRAY)   { at = t.data.array.base; }
        or                          { ret false; }
    }
}

pub fun intern_abi_type(ti: *TypeInterner, name: intern.StrId, tag: u32, size: u32,
    align: u32) res[TypeId, fail.Fail] {
    var t: Type;
    t.kind           = TYPE_ABI;
    t.data.abi.name  = name;
    t.data.abi.tag   = tag;
    t.data.abi.size  = size;
    t.data.abi.align = align;
    ret intern_dedup(ti, t);
}

pub fun is_abi_type(ti: *TypeInterner, tid: TypeId) bool {
    val opt_type: opt[*Type] = get(ti, tid);
    if (!sel opt_type.some) { ret false; }
    ret opt_type.some.kind == TYPE_ABI;
}

pub fun handle_operand(ti: *TypeInterner, tid: TypeId, index: u32) u32 {
    val opt_type: opt[*Type] = get(ti, tid);
    if (!sel opt_type.some) { ret 0; }
    val t: *Type = opt_type.some;
    if (t.kind != TYPE_HANDLE)          { ret 0; }
    if (index >= t.data.handle.ops_len) { ret 0; }
    ret ti.handle_ops[t.data.handle.ops_start + index];
}

fun handle_ops_append(ti: *TypeInterner, src: *u32, len: u32) res[u32, fail.Fail] {
    val start:  u32          = ti.handle_ops_len;
    val needed: usize        = ti.handle_ops_len::usize + len::usize;
    val grown:  err[A.Error] = growth.reserve[u32](ti.a, ?ti.handle_ops, ?ti.handle_ops_cap, needed);
    if (sel grown.err) { ret res[u32, fail.Fail].err{fail.refused(grown.err)}; }

    var i: u32 = 0;
    for (i < len) {
        ti.handle_ops[start + i] = src[i];
        i                        = i + 1;
    }
    ti.handle_ops_len = needed::u32;
    ret res[u32, fail.Fail].ok{start};
}

fun track_handle(ti: *TypeInterner, tid: TypeId) err[fail.Fail] {
    if (ti.handles_len == ti.handles_cap) {
        val grown: err[A.Error] = growth.reserve[TypeId](ti.a, ?ti.handles, ?ti.handles_cap, ti.handles_len::usize + 1);
        if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    }

    ti.handles[ti.handles_len] = tid;
    ti.handles_len             = ti.handles_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun intern_pack(ti: *TypeInterner) res[TypeId, fail.Fail] {
    var t: Type;
    t.kind = TYPE_PACK;
    ret intern_dedup(ti, t);
}

pub fun intern_case_selector(ti: *TypeInterner, tag_type: TypeId, case_name: intern.StrId, case_index: u32) res[TypeId, fail.Fail] {
    var t: Type;
    t.kind                          = TYPE_CASE_SELECTOR;
    t.data.case_selector.tag_type   = tag_type;
    t.data.case_selector.case_name  = case_name;
    t.data.case_selector.case_index = case_index;
    ret intern_dedup(ti, t);
}

pub fun is_case_selector(ti: *TypeInterner, tid: TypeId) bool {
    val opt_t: opt[*Type] = get(ti, tid);
    if (!sel opt_t.some) { ret false; }
    ret opt_t.some.kind == TYPE_CASE_SELECTOR;
}

pub fun is_pack(ti: *TypeInterner, tid: TypeId) bool {
    val opt_t: opt[*Type] = get(ti, tid);
    if (!sel opt_t.some) { ret false; }
    ret opt_t.some.kind == TYPE_PACK;
}

pub fun case_selector_tag_type(ti: *TypeInterner, tid: TypeId) TypeId {
    val opt_t: opt[*Type] = get(ti, tid);
    if (!sel opt_t.some) { ret TYPE_NIL; }
    val t: *Type = opt_t.some;
    if (t.kind != TYPE_CASE_SELECTOR) { ret TYPE_NIL; }
    ret t.data.case_selector.tag_type;
}

pub fun intern_nominal(ti: *TypeInterner, name: intern.StrId, owner: TypeOwner, kind: TypeKind) res[TypeId, fail.Fail] {
    var t: Type;
    t.kind                     = kind;
    t.data.nominal.name        = name;
    t.data.nominal.owner       = owner;
    t.data.nominal.incarnation = 0;
    t.data.nominal.syntax      = intern.STR_NIL;
    ret intern_dedup(ti, t);
}

# an anonymous recipe belongs to one source incarnation
pub fun intern_anonymous(ti: *TypeInterner, name: intern.StrId, owner: TypeOwner,
    incarnation: u64, syntax: intern.StrId, kind: TypeKind) res[TypeId, fail.Fail] {
    if (incarnation == 0 || intern.str_is_nil(syntax)) {
        ret res[TypeId, fail.Fail].err{fail.message("anonymous type requires its parsed incarnation and structural recipe")};
    }
    var t: Type;
    t.kind                     = kind;
    t.data.nominal.name        = name;
    t.data.nominal.owner       = owner;
    t.data.nominal.incarnation = incarnation;
    t.data.nominal.syntax      = syntax;
    ret intern_dedup(ti, t);
}

pub fun intern_generic_param(ti: *TypeInterner, name: intern.StrId, owner: TypeOwner,
    owner_name: intern.StrId, owner_kind: TypeKind, index: u32) res[TypeId, fail.Fail] {
    var t: Type;
    t.kind                          = TYPE_GENERIC_PARAM;
    t.data.generic_param.name       = name;
    t.data.generic_param.owner      = owner;
    t.data.generic_param.owner_name = owner_name;
    t.data.generic_param.owner_kind = owner_kind;
    t.data.generic_param.index      = index;
    ret intern_dedup(ti, t);
}

pub fun intern_function(ti: *TypeInterner, ret_type: TypeId, params: *TypeId, count: u32, c_variadic: bool) res[TypeId, fail.Fail] {
    if (count != 0 && params == nil) { ret res[TypeId, fail.Fail].err{fail.message("type parameter input is nil")}; }
    val h: u64 = hash_fun(ret_type, params, count, c_variadic);
    ret intern_function_bucket(ti, ret_type, params, count, c_variadic, h);
}

fun intern_function_bucket(ti: *TypeInterner, ret_type: TypeId, params: *TypeId, count: u32, c_variadic: bool, h: u64) res[TypeId, fail.Fail] {
    var head:    TypeId       = TYPE_NIL;
    val res_get: opt[*TypeId] = map.get[u64, TypeId](?ti.fun_index, ?h);
    if (sel res_get.some) {
        head = @res_get.some;
        var existing: TypeId = head;
        for (!is_nil(existing)) {
            val entry: opt[*Type] = handle.chunk_at[Type](?ti.types, index(existing)::usize);
            if (sel entry.none) { ret res[TypeId, fail.Fail].err{fail.message(type_kind.TABLE_INDEX_TEXT)}; }
            val candidate: *Type = entry.some;
            if (candidate.kind != TYPE_FUN)                                     { ret res[TypeId, fail.Fail].err{fail.message("type interner bucket has the wrong kind")}; }
            if (fun_matches(ti, existing, ret_type, params, count, c_variadic)) { ret res[TypeId, fail.Fail].ok{existing}; }
            existing = candidate.data.fn.next_in_bucket;
        }
    }

    val res_start: res[u32, fail.Fail] = params_append(ti, params, count);
    if (sel res_start.err) {
        ret res[TypeId, fail.Fail].err{res_start.err};
    }
    val start: u32 = res_start.ok;

    var t: Type;
    t.kind                 = TYPE_FUN;
    t.data.fn.ret_type     = ret_type;
    t.data.fn.params_start = start;
    t.data.fn.params_len   = count;
    t.data.fn.c_variadic   = c_variadic;

    t.data.fn.next_in_bucket = head;

    val res_append: res[TypeId, fail.Fail] = append_type(ti, t);
    if (sel res_append.err) {
        ti.params_len = start;
        ret res_append;
    }
    val tid: TypeId = res_append.ok;

    val res_insert: res[bool, A.Error] = map.insert[u64, TypeId](?ti.fun_index, h, tid);
    if (sel res_insert.err) {
        ti.types.len  = index(tid)::usize;
        ti.params_len = start;
        ret res[TypeId, fail.Fail].err{fail.refused(res_insert.err)};
    }

    ret res[TypeId, fail.Fail].ok{tid};
}

fun hash_instance(nominal: TypeId, args: *TypeId, count: u32) u64 {
    var h: u64 = fnv1a.FNV_INIT;
    h = fnv1a.step_u8(h, TYPE_INSTANCE::u8);
    h = fnv1a.step_u32(h, nominal::u32);
    h = fnv1a.step_u32(h, count);

    var i: u32 = 0;
    for (i < count) {
        h = fnv1a.step_u32(h, args[i]::u32);
        i = i + 1;
    }
    ret h;
}

fun instance_matches(ti: *TypeInterner, tid: TypeId, nominal: TypeId, args: *TypeId, count: u32) bool {
    val r: opt[*Type] = handle.chunk_at[Type](?ti.types, index(tid)::usize);
    if (sel r.none) { ret false; }
    val cand: *Type = r.some;
    if (cand.kind != TYPE_INSTANCE)                 { ret false; }
    if (!same(cand.data.instance.nominal, nominal)) { ret false; }
    if (cand.data.instance.args_len != count)       { ret false; }

    var i: u32 = 0;
    for (i < count) {
        if (!same(ti.params[cand.data.instance.args_start + i], args[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun intern_instance(ti: *TypeInterner, nominal: TypeId, args: *TypeId, count: u32) res[TypeId, fail.Fail] {
    if (count != 0 && args == nil) { ret res[TypeId, fail.Fail].err{fail.message("type parameter input is nil")}; }
    val h: u64 = hash_instance(nominal, args, count);
    ret intern_instance_bucket(ti, nominal, args, count, h);
}

fun intern_instance_bucket(ti: *TypeInterner, nominal: TypeId, args: *TypeId, count: u32, h: u64) res[TypeId, fail.Fail] {
    var head:    TypeId       = TYPE_NIL;
    val res_get: opt[*TypeId] = map.get[u64, TypeId](?ti.instance_index, ?h);
    if (sel res_get.some) {
        head = @res_get.some;
        var existing: TypeId = head;
        for (!is_nil(existing)) {
            val entry: opt[*Type] = handle.chunk_at[Type](?ti.types, index(existing)::usize);
            if (sel entry.none) { ret res[TypeId, fail.Fail].err{fail.message(type_kind.TABLE_INDEX_TEXT)}; }
            val candidate: *Type = entry.some;
            if (candidate.kind != TYPE_INSTANCE)                      { ret res[TypeId, fail.Fail].err{fail.message("type interner bucket has the wrong kind")}; }
            if (instance_matches(ti, existing, nominal, args, count)) { ret res[TypeId, fail.Fail].ok{existing}; }
            existing = candidate.data.instance.next_in_bucket;
        }
    }

    val res_start: res[u32, fail.Fail] = params_append(ti, args, count);
    if (sel res_start.err) {
        ret res[TypeId, fail.Fail].err{res_start.err};
    }
    val start: u32 = res_start.ok;

    var t: Type;
    t.kind                     = TYPE_INSTANCE;
    t.data.instance.nominal    = nominal;
    t.data.instance.args_start = start;
    t.data.instance.args_len   = count;

    t.data.instance.next_in_bucket = head;

    val res_append: res[TypeId, fail.Fail] = append_type(ti, t);
    if (sel res_append.err) {
        ti.params_len = start;
        ret res_append;
    }
    val tid: TypeId = res_append.ok;

    val res_insert: res[bool, A.Error] = map.insert[u64, TypeId](?ti.instance_index, h, tid);
    if (sel res_insert.err) {
        ti.types.len  = index(tid)::usize;
        ti.params_len = start;
        ret res[TypeId, fail.Fail].err{fail.refused(res_insert.err)};
    }

    ret res[TypeId, fail.Fail].ok{tid};
}

pub fun type_equals_signatures(ti: *TypeInterner, a: TypeId, b: TypeId) bool {
    if (same(a, b)) { ret true; }

    val ra: opt[*Type] = handle.chunk_at[Type](?ti.types, index(a)::usize);
    val rb: opt[*Type] = handle.chunk_at[Type](?ti.types, index(b)::usize);
    if (sel ra.none) { ret false; }
    if (sel rb.none) { ret false; }

    val ta: *Type = ra.some;
    val tb: *Type = rb.some;
    if (ta.kind != TYPE_FUN || tb.kind != TYPE_FUN)      { ret false; }
    if (!same(ta.data.fn.ret_type, tb.data.fn.ret_type)) { ret false; }
    if (ta.data.fn.params_len != tb.data.fn.params_len)  { ret false; }
    if (ta.data.fn.c_variadic != tb.data.fn.c_variadic)  { ret false; }

    var i: u32 = 0;
    for (i < ta.data.fn.params_len) {
        if (!same(ti.params[ta.data.fn.params_start + i], ti.params[tb.data.fn.params_start + i])) {
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

pub fun field_projection_reset(ti: *TypeInterner) {
    type_field.projection_reset(?ti.fields);
    ti.projection_generation = ti.projection_generation + 1;
}

pub fun field_epoch(ti: *TypeInterner) u32 {
    ret type_field.epoch(?ti.fields);
}

pub fun field_table_stage(ti: *TypeInterner, additional: u32) res[u32, fail.Fail] {
    ret type_field.stage(?ti.fields, additional);
}

pub fun field_table_stage_push(ti: *TypeInterner, name: intern.StrId, ty: TypeId) err[fail.Fail] {
    ret type_field.entry_push(?ti.fields, FieldEntry{name: name, ty: ty, deprecation: deprecation.none()});
}

pub fun field_table_stage_push_entry(ti: *TypeInterner, fe: FieldEntry) err[fail.Fail] {
    ret type_field.entry_push(?ti.fields, fe);
}

pub fun field_table_publish(ti: *TypeInterner, ty: TypeId, fields_start: u32, fields_len: u32) err[fail.Fail] {
    ret type_field.publish(?ti.fields, ty, fields_start, fields_len);
}

# the layout decorations nominal `tid` declares under the current projection
pub fun decoration_of(ti: *TypeInterner, tid: TypeId) Decoration {
    ret type_field.decoration_of(?ti.fields, tid);
}

pub fun decoration_set(ti: *TypeInterner, tid: TypeId, d: Decoration) err[fail.Fail] {
    ret type_field.decoration_set(?ti.fields, tid, d);
}

pub fun aggregate_nominal(ti: *TypeInterner, tid: TypeId) TypeId {
    val opt_t: opt[*Type] = get(ti, tid);
    if (!sel opt_t.some) { ret TYPE_ERROR; }
    val t: *Type = opt_t.some;
    if (t.kind == TYPE_REC || t.kind == TYPE_UNI || t.kind == TYPE_TAG) { ret tid; }
    if (t.kind != TYPE_INSTANCE)                                        { ret TYPE_ERROR; }
    ret t.data.instance.nominal;
}

pub fun is_tag(ti: *TypeInterner, tid: TypeId) bool {
    ret nominal_kind_is(ti, tid, TYPE_TAG);
}

pub fun set_tag_discriminator(ti: *TypeInterner, tid: TypeId, disc: TypeId) err[fail.Fail] {
    val nom: TypeId = aggregate_nominal(ti, tid);
    if (!nominal_kind_is(ti, nom, TYPE_TAG)) { ret err[fail.Fail].ok{}; }
    if (is_nil(disc)) {
        type_field.discriminator_del(?ti.fields, nom);
        ret err[fail.Fail].ok{};
    }
    ret type_field.discriminator_set(?ti.fields, nom, disc);
}

pub fun tag_discriminator(ti: *TypeInterner, tid: TypeId) TypeId {
    val nom: TypeId = aggregate_nominal(ti, tid);
    if (!nominal_kind_is(ti, nom, TYPE_TAG)) { ret TYPE_NIL; }
    ret type_field.discriminator_of(?ti.fields, nom);
}

# the declared discriminator width in bytes, or zero when the tag has no usable declaration
pub fun tag_discriminator_bytes(ti: *TypeInterner, tid: TypeId) u32 {
    val disc: TypeId = tag_discriminator(ti, tid);
    if (is_nil(disc) || is_error(disc)) { ret 0; }
    val opt_t: opt[*Type] = get(ti, disc);
    if (!sel opt_t.some) { ret 0; }
    ret prim_desc(opt_t.some.kind).bits / 8;
}

pub fun is_valid_discriminator_kind(k: TypeKind) bool {
    ret k == TYPE_U8 || k == TYPE_U16 || k == TYPE_U32 || k == TYPE_U64;
}

pub fun is_union(ti: *TypeInterner, tid: TypeId) bool {
    ret nominal_kind_is(ti, tid, TYPE_UNI);
}

pub fun is_record(ti: *TypeInterner, tid: TypeId) bool {
    ret nominal_kind_is(ti, tid, TYPE_REC);
}

fun nominal_kind_is(ti: *TypeInterner, tid: TypeId, want: TypeKind) bool {
    val opt_nom: opt[*Type] = get(ti, aggregate_nominal(ti, tid));
    if (!sel opt_nom.some) { ret false; }
    ret opt_nom.some.kind == want;
}

pub fun field_table_for(ti: *TypeInterner, ty: TypeId) opt[*FieldTable] {
    ret type_field.table_for(?ti.fields, ty);
}

pub fun field_count(ti: *TypeInterner, ty: TypeId) u32 {
    val opt_ft: opt[*FieldTable] = field_table_for(ti, ty);
    if (!sel opt_ft.some) { ret 0; }
    ret opt_ft.some.fields_len;
}

pub fun field_at(ti: *TypeInterner, ty: TypeId, ix: u32) opt[*FieldEntry] {
    val opt_ft: opt[*FieldTable] = field_table_for(ti, ty);
    if (!sel opt_ft.some) {
        ret opt[*FieldEntry].none{};
    }

    val ft: *FieldTable = opt_ft.some;
    if (ix >= ft.fields_len) {
        ret opt[*FieldEntry].none{};
    }

    val entry: *FieldEntry = type_field.entry_at(?ti.fields, ft, ix);
    if (entry == nil) { ret opt[*FieldEntry].none{}; }
    ret opt[*FieldEntry].some{entry};
}

pub fun field_entry_at(ti: *TypeInterner, ft: *FieldTable, ix: u32) *FieldEntry {
    ret type_field.entry_at(?ti.fields, ft, ix);
}

fun intern_dedup(ti: *TypeInterner, t: Type) res[TypeId, fail.Fail] {
    val res_get: opt[*TypeId] = map.get_by[Type, TypeId](?ti.dedup, ?t);
    if (sel res_get.some) {
        ret res[TypeId, fail.Fail].ok{@res_get.some};
    }

    val res_append: res[TypeId, fail.Fail] = append_type(ti, t);
    if (sel res_append.err) {
        ret res_append;
    }
    val tid: TypeId = res_append.ok;

    val res_insert: res[bool, A.Error] = map.insert_by[Type, TypeId](?ti.dedup, t, tid);
    if (sel res_insert.err) {
        ti.types.len = index(tid)::usize;
        ret res[TypeId, fail.Fail].err{fail.refused(res_insert.err)};
    }

    ret res[TypeId, fail.Fail].ok{tid};
}

fun append_type(ti: *TypeInterner, t: Type) res[TypeId, fail.Fail] {
    if (t.kind::u32 >= TYPE_KIND_COUNT) { ret res[TypeId, fail.Fail].err{fail.message("type: kind is past TYPE_KIND_COUNT")}; }
    val count: usize = handle.chunk_count[Type](?ti.types);
    if (count >= index(TYPE_ERROR)::usize) { ret res[TypeId, fail.Fail].err{fail.message("type identities are exhausted")}; }
    val tid: TypeId = id(count::u32);

    val ce_r: res[handle.ChunkEditor[Type], handle.Error] = handle.chunk_editor[Type](?ti.types);
    if (sel ce_r.err) {
        ret res[TypeId, fail.Fail].err{fail.message(handle.text(ce_r.err))};
    }
    var ce: handle.ChunkEditor[Type] = ce_r.ok;

    val push_r: res[*Type, handle.Error] = handle.chunk_append[Type](?ce, t);
    handle.chunk_editor_finish[Type](?ce);
    if (sel push_r.err) {
        ret res[TypeId, fail.Fail].err{fail.message(handle.text(push_r.err))};
    }

    ret res[TypeId, fail.Fail].ok{tid};
}

fun reserve_params(ti: *TypeInterner, need: u32) err[fail.Fail] {
    val grown: err[A.Error] = growth.reserve[TypeId](ti.a, ?ti.params, ?ti.params_cap, ti.params_len::usize + need::usize);
    if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    ret err[fail.Fail].ok{};
}

fun params_append(ti: *TypeInterner, src: *TypeId, len: u32) res[u32, fail.Fail] {
    val start: u32 = ti.params_len;
    if (len != 0 && src == nil) { ret res[u32, fail.Fail].err{fail.message("type parameter input is nil")}; }
    var borrowed: bool  = false;
    var offset:   usize = 0;
    if (len != 0 && ti.params != nil && src::usize >= ti.params::usize) {
        val delta: usize = src::usize - ti.params::usize;
        if (delta / $size_of(TypeId) < ti.params_cap::usize) {
            offset = delta / $size_of(TypeId);
            if (delta % $size_of(TypeId) != 0 || offset > start::usize || len::usize > start::usize - offset) {
                ret res[u32, fail.Fail].err{fail.message("type parameter input exceeds its owned run")};
            }
            borrowed = true;
        }
    }

    val res_reserve: err[fail.Fail] = reserve_params(ti, len);
    if (sel res_reserve.err) {
        ret res[u32, fail.Fail].err{res_reserve.err};
    }

    var input: *TypeId = src;
    if (borrowed) { input = ?ti.params[offset]; }
    var i: u32 = 0;
    for (i < len) {
        ti.params[start + i] = input[i];
        i                    = i + 1;
    }
    ti.params_len = start + len;

    ret res[u32, fail.Fail].ok{start};
}

fun hash_fun(ret_type: TypeId, params: *TypeId, count: u32, c_variadic: bool) u64 {
    var h: u64 = fnv1a.FNV_INIT;
    h = fnv1a.step_u8(h, TYPE_FUN::u8);
    h = fnv1a.step_u32(h, ret_type::u32);
    h = fnv1a.step_u32(h, count);
    h = fnv1a.step_u8(h, c_variadic::u8);

    var i: u32 = 0;
    for (i < count) {
        h = fnv1a.step_u32(h, params[i]::u32);
        i = i + 1;
    }
    ret h;
}

fun fun_matches(ti: *TypeInterner, tid: TypeId, ret_type: TypeId, params: *TypeId, count: u32, c_variadic: bool) bool {
    val r: opt[*Type] = handle.chunk_at[Type](?ti.types, index(tid)::usize);
    if (sel r.none) { ret false; }

    val t: *Type = r.some;
    if (t.kind != TYPE_FUN)                  { ret false; }
    if (!same(t.data.fn.ret_type, ret_type)) { ret false; }
    if (t.data.fn.params_len != count)       { ret false; }
    if (t.data.fn.c_variadic != c_variadic)  { ret false; }

    var i: u32 = 0;
    for (i < count) {
        if (!same(ti.params[t.data.fn.params_start + i], params[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun hash_type(t: *Type) u64 {
    var h: u64 = fnv1a.FNV_INIT;
    h = fnv1a.step_u8(h, t.kind::u8);
    if (t.kind == TYPE_POINTER) {
        h = fnv1a.step_u32(h, t.data.pointer.base::u32);
    }
    or (t.kind == TYPE_SECRET) {
        h = fnv1a.step_u32(h, t.data.secret.base::u32);
    }
    or (t.kind == TYPE_ARRAY) {
        h = fnv1a.step_u32(h, t.data.array.base::u32);
        h = fnv1a.step_u32(h, t.data.array.count);
    }
    or (t.kind == TYPE_VECTOR) {
        h = fnv1a.step_u8(h, t.data.vector.element::u8);
        h = fnv1a.step_u32(h, t.data.vector.lanes);
    }
    or (t.kind == TYPE_REC || t.kind == TYPE_UNI || t.kind == TYPE_TAG) {
        h = fnv1a.step_u32(h, t.data.nominal.owner.module::u32);
        h = fnv1a.step_u32(h, t.data.nominal.owner.file::u32);
        h = fnv1a.step_u32(h, t.data.nominal.name::u32);
        h = fnv1a.step_u32(h, t.data.nominal.incarnation::u32);
        h = fnv1a.step_u32(h, (t.data.nominal.incarnation >> 32)::u32);
        h = fnv1a.step_u32(h, t.data.nominal.syntax::u32);
    }
    or (t.kind == TYPE_GENERIC_PARAM) {
        h = fnv1a.step_u32(h, t.data.generic_param.owner.module::u32);
        h = fnv1a.step_u32(h, t.data.generic_param.owner.file::u32);
        h = fnv1a.step_u32(h, t.data.generic_param.owner_name::u32);
        h = fnv1a.step_u8(h, t.data.generic_param.owner_kind);
        h = fnv1a.step_u32(h, t.data.generic_param.name::u32);
        h = fnv1a.step_u32(h, t.data.generic_param.index);
    }
    or (t.kind == TYPE_ABI) {
        h = fnv1a.step_u32(h, t.data.abi.tag);
        h = fnv1a.step_u32(h, t.data.abi.size);
        h = fnv1a.step_u32(h, t.data.abi.align);
    }
    or (t.kind == TYPE_CASE_SELECTOR) {
        h = fnv1a.step_u32(h, t.data.case_selector.tag_type::u32);
        h = fnv1a.step_u32(h, t.data.case_selector.case_name::u32);
        h = fnv1a.step_u32(h, t.data.case_selector.case_index);
    }
    ret h;
}

fun eq_type(a: *Type, b: *Type) bool {
    if (a.kind != b.kind) { ret false; }

    if (a.kind == TYPE_POINTER) {
        ret same(a.data.pointer.base, b.data.pointer.base);
    }
    if (a.kind == TYPE_SECRET) {
        ret same(a.data.secret.base, b.data.secret.base);
    }
    if (a.kind == TYPE_ARRAY) {
        ret same(a.data.array.base, b.data.array.base)
            && a.data.array.count == b.data.array.count;
    }
    if (a.kind == TYPE_VECTOR) {
        ret a.data.vector.element == b.data.vector.element
            && a.data.vector.lanes == b.data.vector.lanes;
    }
    if (a.kind == TYPE_REC || a.kind == TYPE_UNI || a.kind == TYPE_TAG) {
        ret module.stable_same(a.data.nominal.owner.module, b.data.nominal.owner.module)
            && lang_source.file_same(a.data.nominal.owner.file, b.data.nominal.owner.file)
            && intern.str_same(a.data.nominal.name, b.data.nominal.name)
            && a.data.nominal.incarnation == b.data.nominal.incarnation
            && intern.str_same(a.data.nominal.syntax, b.data.nominal.syntax);
    }
    if (a.kind == TYPE_GENERIC_PARAM) {
        ret module.stable_same(a.data.generic_param.owner.module, b.data.generic_param.owner.module)
            && lang_source.file_same(a.data.generic_param.owner.file, b.data.generic_param.owner.file)
            && intern.str_same(a.data.generic_param.owner_name, b.data.generic_param.owner_name)
            && a.data.generic_param.owner_kind == b.data.generic_param.owner_kind
            && intern.str_same(a.data.generic_param.name, b.data.generic_param.name)
            && a.data.generic_param.index == b.data.generic_param.index;
    }
    if (a.kind == TYPE_ABI) {
        ret a.data.abi.tag == b.data.abi.tag
            && a.data.abi.size == b.data.abi.size
            && a.data.abi.align == b.data.abi.align;
    }
    if (a.kind == TYPE_CASE_SELECTOR) {
        ret same(a.data.case_selector.tag_type, b.data.case_selector.tag_type)
            && intern.str_same(a.data.case_selector.case_name, b.data.case_selector.case_name)
            && a.data.case_selector.case_index == b.data.case_selector.case_index;
    }

    ret true;
}
