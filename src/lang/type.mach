test "mach.lang.type.type_equals_signatures:param_and_nil_boundaries" {
    var alloc: A.Allocator;
    val made_8: err[A.Error] = page.make(?alloc);
    if (sel made_8.err) { ret 1; }
    var ti: TypeInterner;
    val init_typed_1: err[fail.Fail] = init_typed(?ti, ?alloc);
    if (sel init_typed_1.err) { ret 1; }

    val prim_typed_2: opt[TypeId] = prim_typed(?ti, TYPE_I32);
    if (!sel prim_typed_2.some) { ret 1; }
    val i32_id: TypeId = prim_typed_2.some;
    val prim_typed_3: opt[TypeId] = prim_typed(?ti, TYPE_I64);
    if (!sel prim_typed_3.some) { ret 1; }
    val i64_id: TypeId = prim_typed_3.some;

    var pi32: [1]TypeId;
    pi32[0] = i32_id;
    var pi64: [1]TypeId;
    pi64[0] = i64_id;

    val ra: res[TypeId, fail.Fail] = intern_function(?ti, TYPE_NIL, ?pi32[0], 1, false);
    val rc: res[TypeId, fail.Fail] = intern_function(?ti, TYPE_NIL, ?pi32[0], 1, false);
    val rd: res[TypeId, fail.Fail] = intern_function(?ti, TYPE_NIL, ?pi64[0], 1, false);
    if (sel ra.err) { dnit(?ti); ret 1; }
    if (sel rc.err) { dnit(?ti); ret 1; }
    if (sel rd.err) { dnit(?ti); ret 1; }

    val tid_a: TypeId = ra.ok;
    val tid_c: TypeId = rc.ok;
    val tid_d: TypeId = rd.ok;

    if (!type_equals_signatures(?ti, tid_a, tid_c))   { dnit(?ti); ret 1; }
    if (type_equals_signatures(?ti, tid_a, tid_d))    { dnit(?ti); ret 1; }
    if (type_equals_signatures(?ti, tid_a, TYPE_NIL)) { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

test "mach.lang.type:numeric_predicate_boundaries" {
    var alloc: A.Allocator;
    val made_9: err[A.Error] = page.make(?alloc);
    if (sel made_9.err) { ret 1; }
    var ti: TypeInterner;
    val init_typed_1: err[fail.Fail] = init_typed(?ti, ?alloc);
    if (sel init_typed_1.err) { ret 1; }

    val prim_typed_2: opt[TypeId] = prim_typed(?ti, TYPE_PTR);
    if (!sel prim_typed_2.some) { ret 1; }
    val ptr_id: TypeId = prim_typed_2.some;
    val prim_typed_3: opt[TypeId] = prim_typed(?ti, TYPE_U8);
    if (!sel prim_typed_3.some) { ret 1; }
    val u8_id:  TypeId = prim_typed_3.some;
    val prim_typed_4: opt[TypeId] = prim_typed(?ti, TYPE_I64);
    if (!sel prim_typed_4.some) { ret 1; }
    val i64_id: TypeId = prim_typed_4.some;
    val prim_typed_5: opt[TypeId] = prim_typed(?ti, TYPE_F32);
    if (!sel prim_typed_5.some) { ret 1; }
    val f32_id: TypeId = prim_typed_5.some;

    val pack_r: res[TypeId, fail.Fail] = intern_pack(?ti);
    if (sel pack_r.err) { dnit(?ti); ret 1; }
    val pack_id: TypeId = pack_r.ok;

    val arr_r: res[TypeId, fail.Fail] = intern_array_typed(?ti, u8_id, 4);
    if (sel arr_r.err) { dnit(?ti); ret 1; }
    val arr_id: TypeId = arr_r.ok;

    if (is_integer(?ti, pack_id)) { dnit(?ti); ret 1; }
    if (is_numeric(?ti, pack_id)) { dnit(?ti); ret 1; }
    if (is_float(?ti, pack_id))   { dnit(?ti); ret 1; }
    if (is_integer(?ti, ptr_id))  { dnit(?ti); ret 1; }
    if (!is_integer(?ti, u8_id))  { dnit(?ti); ret 1; }
    if (!is_integer(?ti, i64_id)) { dnit(?ti); ret 1; }
    if (!is_float(?ti, f32_id))   { dnit(?ti); ret 1; }
    if (is_integer(?ti, arr_id))  { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

test "mach.lang.type.intern_secret:dedup_collapse_and_predicates" {
    var alloc: A.Allocator;
    val made_10: err[A.Error] = page.make(?alloc);
    if (sel made_10.err) { ret 1; }
    var ti: TypeInterner;
    val init_typed_1: err[fail.Fail] = init_typed(?ti, ?alloc);
    if (sel init_typed_1.err) { ret 1; }

    val prim_typed_2: opt[TypeId] = prim_typed(?ti, TYPE_U32);
    if (!sel prim_typed_2.some) { ret 1; }
    val u32_id: TypeId = prim_typed_2.some;

    val s1: res[TypeId, fail.Fail] = intern_secret_typed(?ti, u32_id);
    val s2: res[TypeId, fail.Fail] = intern_secret_typed(?ti, u32_id);
    if (sel s1.err) { dnit(?ti); ret 1; }
    if (sel s2.err) { dnit(?ti); ret 1; }
    val sec_u32: TypeId = s1.ok;
    if (sec_u32 != s2.ok) { dnit(?ti); ret 1; }
    if (sec_u32 == u32_id)                       { dnit(?ti); ret 1; }

    val s3: res[TypeId, fail.Fail] = intern_secret_typed(?ti, sec_u32);
    if (sel s3.err)                  { dnit(?ti); ret 1; }
    if (s3.ok != sec_u32)    { dnit(?ti); ret 1; }

    if (!is_secret(?ti, sec_u32))                 { dnit(?ti); ret 1; }
    if (is_secret(?ti, u32_id))                   { dnit(?ti); ret 1; }
    if (strip_secret(?ti, sec_u32) != u32_id)     { dnit(?ti); ret 1; }
    if (strip_secret(?ti, u32_id) != u32_id)      { dnit(?ti); ret 1; }

    if (!is_integer(?ti, sec_u32))                { dnit(?ti); ret 1; }
    if (!is_numeric(?ti, sec_u32))                { dnit(?ti); ret 1; }

    val pp_sec: res[TypeId, fail.Fail] = intern_pointer(?ti, sec_u32);
    val pp_pub: res[TypeId, fail.Fail] = intern_pointer(?ti, u32_id);
    if (sel pp_sec.err) { dnit(?ti); ret 1; }
    if (sel pp_pub.err) { dnit(?ti); ret 1; }
    val ptr_sec: TypeId = pp_sec.ok;
    val ptr_pub: TypeId = pp_pub.ok;
    if (!carries_secret(?ti, ptr_sec))            { dnit(?ti); ret 1; }
    if (carries_secret(?ti, ptr_pub))             { dnit(?ti); ret 1; }
    if (!carries_secret(?ti, sec_u32))            { dnit(?ti); ret 1; }

    val prim_typed_3: opt[TypeId] = prim_typed(?ti, TYPE_U64);
    if (!sel prim_typed_3.some) { ret 1; }
    val u64_id:  TypeId = prim_typed_3.some;
    val sec_u64: res[TypeId, fail.Fail] = intern_secret_typed(?ti, u64_id);
    if (sel sec_u64.err) { dnit(?ti); ret 1; }
    if (secrecy_structure_equal(?ti, ptr_sec, ptr_pub))                       { dnit(?ti); ret 1; }
    if (!secrecy_structure_equal(?ti, ptr_sec, ptr_sec))                      { dnit(?ti); ret 1; }
    if (!secrecy_structure_equal(?ti, sec_u32, sec_u64.ok)) { dnit(?ti); ret 1; }
    if (secrecy_structure_equal(?ti, sec_u32, u32_id))                       { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

rec TFieldProbe {
    backing: A.Allocator;
    calls:   u32;
    fail_at: u32;
}

fun t_field_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *TFieldProbe = ctx::*TFieldProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls >= p.fail_at) { ret opt[ptr].none{}; }
    ret p.backing.fn_allocate(p.backing.ctx, size, align);
}

fun t_field_probe_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val p: *TFieldProbe = ctx::*TFieldProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls >= p.fail_at) { ret opt[ptr].none{}; }
    ret p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
}

fun t_field_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *TFieldProbe = ctx::*TFieldProbe;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun t_field_probe_make(p: *TFieldProbe, alloc: *A.Allocator) bool {
    val make_1: err[A.Error] = page.make(?p.backing);
    if (sel make_1.err) { ret false; }
    p.calls   = 0;
    p.fail_at = 0;
    val self_ptr: *TFieldProbe = p;
    alloc.ctx           = self_ptr::ptr;
    alloc.fn_allocate    = t_field_probe_allocate;
    alloc.fn_reallocate  = t_field_probe_reallocate;
    alloc.fn_deallocate  = t_field_probe_deallocate;
    ret true;
}

test "mach.lang.type.field_table_publish:a_stale_epoch_hides_the_table" {
    var alloc: A.Allocator;
    val made_11: err[A.Error] = page.make(?alloc);
    if (sel made_11.err) { ret 1; }
    var ti: TypeInterner;
    val init_typed_1: err[fail.Fail] = init_typed(?ti, ?alloc);
    if (sel init_typed_1.err) { ret 1; }

    val prim_typed_2: opt[TypeId] = prim_typed(?ti, TYPE_U32);
    if (!sel prim_typed_2.some) { ret 1; }
    val ty: TypeId = prim_typed_2.some;
    val name_a: intern.StrId = 1::intern.StrId;
    val name_b: intern.StrId = 2::intern.StrId;
    val name_c: intern.StrId = 3::intern.StrId;

    val s1_r: res[u32, fail.Fail] = field_table_stage(?ti, 2);
    if (sel s1_r.err) { dnit(?ti); ret 1; }
    val s1: u32 = s1_r.ok;
    val field_table_stage_push_3: err[fail.Fail] = field_table_stage_push(?ti, name_a, ty);
    if (sel field_table_stage_push_3.err) { dnit(?ti); ret 1; }
    if (field_count(?ti, ty) != 0) { dnit(?ti); ret 1; }
    val field_table_stage_push_4: err[fail.Fail] = field_table_stage_push(?ti, name_b, ty);
    if (sel field_table_stage_push_4.err) { dnit(?ti); ret 1; }
    if (field_count(?ti, ty) != 0) { dnit(?ti); ret 1; }
    val field_table_publish_5: err[fail.Fail] = field_table_publish(?ti, ty, s1, 2);
    if (sel field_table_publish_5.err) { dnit(?ti); ret 1; }

    if (field_count(?ti, ty) != 2) { dnit(?ti); ret 1; }
    val e0: opt[*FieldEntry] = field_at_typed(?ti, ty, 0);
    if (!sel e0.some) { dnit(?ti); ret 1; }
    if (e0.some.name != name_a) { dnit(?ti); ret 1; }
    val e1: opt[*FieldEntry] = field_at_typed(?ti, ty, 1);
    if (!sel e1.some) { dnit(?ti); ret 1; }
    if (e1.some.name != name_b) { dnit(?ti); ret 1; }

    field_epoch_bump(?ti);
    val field_table_for_typed_6: opt[*FieldTable] = field_table_for_typed(?ti, ty);
    if (sel field_table_for_typed_6.some) { dnit(?ti); ret 1; }
    if (field_count(?ti, ty) != 0)                        { dnit(?ti); ret 1; }
    val field_at_typed_7: opt[*FieldEntry] = field_at_typed(?ti, ty, 0);
    if (sel field_at_typed_7.some)     { dnit(?ti); ret 1; }

    val s2_r: res[u32, fail.Fail] = field_table_stage(?ti, 1);
    if (sel s2_r.err) { dnit(?ti); ret 1; }
    val s2: u32 = s2_r.ok;
    val field_table_stage_push_8: err[fail.Fail] = field_table_stage_push(?ti, name_c, ty);
    if (sel field_table_stage_push_8.err) { dnit(?ti); ret 1; }
    val field_table_publish_9: err[fail.Fail] = field_table_publish(?ti, ty, s2, 1);
    if (sel field_table_publish_9.err) { dnit(?ti); ret 1; }

    if (field_count(?ti, ty) != 1) { dnit(?ti); ret 1; }
    val e2: opt[*FieldEntry] = field_at_typed(?ti, ty, 0);
    if (!sel e2.some) { dnit(?ti); ret 1; }
    if (e2.some.name != name_c) { dnit(?ti); ret 1; }

    dnit(?ti);
    ret 0;
}

test "mach.lang.type.field_table_publish:a_failed_build_never_replaces_the_published_table" {
    var fail_at: u32 = 1;
    for (fail_at <= 24) {
        var probe: TFieldProbe; var pa: A.Allocator;
        if (!t_field_probe_make(?probe, ?pa)) { ret 1; }
        var ti: TypeInterner;
        val init_typed_1: err[fail.Fail] = init_typed(?ti, ?pa);
        if (sel init_typed_1.err) { ret 1; }

        val prim_typed_2: opt[TypeId] = prim_typed(?ti, TYPE_U32);
        if (!sel prim_typed_2.some) { ret 1; }
        val ty: TypeId = prim_typed_2.some;

        val g_r: res[u32, fail.Fail] = field_table_stage(?ti, 2);
        if (sel g_r.err) { dnit(?ti); ret 1; }
        val g: u32 = g_r.ok;
        val field_table_stage_push_3: err[fail.Fail] = field_table_stage_push(?ti, 1::intern.StrId, ty);
        if (sel field_table_stage_push_3.err) { dnit(?ti); ret 1; }
        val field_table_stage_push_4: err[fail.Fail] = field_table_stage_push(?ti, 2::intern.StrId, ty);
        if (sel field_table_stage_push_4.err) { dnit(?ti); ret 1; }
        val field_table_publish_5: err[fail.Fail] = field_table_publish(?ti, ty, g, 2);
        if (sel field_table_publish_5.err) { dnit(?ti); ret 1; }
        if (field_count(?ti, ty) != 2) { dnit(?ti); ret 1; }

        probe.fail_at = probe.calls + fail_at;

        val s_r: res[u32, fail.Fail] = field_table_stage(?ti, 3);
        var published: bool = false;
        if (sel s_r.ok) {
            val s: u32 = s_r.ok;
            var staged: bool = true;
            var i: u32 = 0;
            for (i < 3) {
                val field_table_stage_push_6: err[fail.Fail] = field_table_stage_push(?ti, (10 + i)::intern.StrId, ty);
                if (sel field_table_stage_push_6.err) {
                    staged = false;
                    brk;
                }
                if (field_count(?ti, ty) != 2) { dnit(?ti); ret 1; }
                i = i + 1;
            }
            if (staged) {
                val field_table_publish_7: err[fail.Fail] = field_table_publish(?ti, ty, s, 3);
                published = sel field_table_publish_7.ok;
            }
        }

        if (!published && field_count(?ti, ty) != 2) { dnit(?ti); ret 1; }
        if (published  && field_count(?ti, ty) != 3) { dnit(?ti); ret 1; }

        probe.fail_at = 0;
        dnit(?ti);
        fail_at = fail_at + 1;
    }
    ret 0;
}

rec GrowLoopProbe {
    allocate_calls:   u32;
    reallocate_calls: u32;
}

fun growloop_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val g: *GrowLoopProbe = ctx::*GrowLoopProbe;
    g.allocate_calls = g.allocate_calls + 1;
    ret opt[ptr].none{};
}

fun growloop_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val g: *GrowLoopProbe = ctx::*GrowLoopProbe;
    g.reallocate_calls = g.reallocate_calls + 1;
    ret opt[ptr].none{};
}

fun growloop_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.type.visit_reserve:refuses_a_u32_doubling_that_wraps_without_reallocating" {
    var alloc: A.Allocator;
    val made_12: err[A.Error] = page.make(?alloc);
    if (sel made_12.err) { ret 1; }
    var ti: TypeInterner;
    val init_typed_1: err[fail.Fail] = init_typed(?ti, ?alloc);
    if (sel init_typed_1.err) { ret 1; }
    val visits_reserve_2: err[fail.Fail] = visits_reserve(?ti);
    if (sel visits_reserve_2.err) { dnit(?ti); ret 1; }

    var probe: GrowLoopProbe;
    probe.allocate_calls   = 0;
    probe.reallocate_calls = 0;
    var pp: *GrowLoopProbe = ?probe;
    var pa: A.Allocator;
    pa.ctx           = pp::ptr;
    pa.fn_allocate   = growloop_probe_allocate;
    pa.fn_reallocate = growloop_probe_reallocate;
    pa.fn_deallocate = growloop_probe_deallocate;

    ti.visits[0].stamp = nil;
    ti.visits[0].cap   = 0x80000000;
    ti.visits[0].epoch = 0;

    val real_alloc: *A.Allocator = ti.a;
    ti.a = ?pa;
    val outcome: err[fail.Fail] = visit_reserve(?ti, 0, 0x80000000::TypeId);
    ti.a = real_alloc;

    var bad: i32 = 0;
    if (sel outcome.ok)          { bad = 1; }
    if (probe.allocate_calls != 0)    { bad = 2; }
    if (probe.reallocate_calls != 0)  { bad = 3; }

    ti.visits[0].cap = 0;
    dnit(?ti);
    ret bad;
}

