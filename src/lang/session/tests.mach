use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use T: std.allocator.testing;

use mach.lang.intern;
use mach.lang.module;
use mach.lang.session;

# register one module's identity at a refusal armed `ordinal` allocations after the
# session opens: a refusal publishes nothing
#[testing]
fun t_register_attempt(ordinal: usize, finished: *bool) i32 {
    var failing: T.Testing;
    val made:    err[A.Error] = T.make(?failing);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?failing); }
    val sr: res[session.Session, fail.Fail] = session.init(T.allocator_of(?failing));
    if (sel sr.err) { ret 2; }
    var s:   session.Session = sr.ok;
    var bad: i32             = 0;
    T.fail_at_ordinal(?failing, T.attempt_count(?failing) + ordinal);
    val r: err[fail.Fail] = session.register_module_identity(?s, module.id(3), nil, intern.str_id(9), module.stable_id(5));
    if (sel r.err) {
        if (session.module_count(?s) != 0 || !intern.str_is_nil(session.module_fqn(?s, module.id(3)))
            || !module.is_nil(session.module_id_for_stable(?s, module.stable_id(5)))) { bad = 5; }
    }
    or {
        @finished = true;
        if (session.module_count(?s) != 4 || !intern.str_same(session.module_fqn(?s, module.id(3)), intern.str_id(9))
            || !module.same(session.module_id_for_stable(?s, module.stable_id(5)), module.id(3))) { bad = 6; }
    }
    T.clear_failure(?failing);
    session.dnit(?s);
    if (T.tracking_exhausted(?failing) || T.leaked(?failing) || T.double_free_count(?failing) != 0) { ret 7; }
    ret bad;
}

test register_module__an_allocation_refusal_publishes_nothing {
    var ordinal:  usize = 1;
    var finished: bool  = false;
    for (!finished && ordinal <= 64) {
        val code: i32 = t_register_attempt(ordinal, ?finished);
        if (code != 0) { ret code; }
        ordinal = ordinal + 1;
    }
    # the first attempt must have been refused, so a refusal was exercised
    if (!finished || ordinal <= 2) { ret 20; }
    ret 0;
}
