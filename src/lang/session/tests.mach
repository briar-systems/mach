use mach.lang.fail;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use T: std.allocator.testing;

use mach.lang.intern;
use mach.lang.session;

test register_module_identity__allocation_failure_publishes_nothing {
    var bad:         i32  = 0;
    var saw_failure: bool = false;
    var n:           u64  = 1;
    for (n <= 400) {
        var backing: A.Allocator;
        val make_r:  err[A.Error] = page.make(?backing);
        if (sel make_r.err) { ret 1; }
        var failing: T.Testing;
        val make_r2: err[A.Error] = T.make(?failing);
        if (sel make_r2.err) { ret 1; }
        T.fail_at_ordinal(?failing, n::usize);

        val sr: res[session.Session, fail.Fail] = session.init(T.allocator_of(?failing));
        if (sel sr.err) {
            n = n + 1;
            cnt;
        }
        var s: session.Session = sr.ok;

        val r: err[fail.Fail] = session.register_module_identity(?s, 3, nil, 9, 5);
        if (sel r.err) {
            saw_failure = true;
            if (session.module_count(?s) != 0)                             { bad = 1; }
            if (session.module_fqn(?s, 3) != intern.STR_NIL)               { bad = 1; }
            if (session.module_id_for_stable(?s, 5) != session.MODULE_NIL) { bad = 1; }
        }
        if (sel r.ok) {
            if (session.module_count(?s) != 4)            { bad = 1; }
            if (session.module_fqn(?s, 3) != 9)           { bad = 1; }
            if (session.module_id_for_stable(?s, 5) != 3) { bad = 1; }
        }
        session.dnit(?s);
        if (T.tracking_exhausted(?failing)) {
            T.dnit(?failing);
            ret 1;
        }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) {
            T.dnit(?failing);
            ret 1;
        }
        T.dnit(?failing);
        n = n + 1;
    }
    if (!saw_failure) { bad = 1; }
    ret bad;
}

test register_module_phase__allocation_failure_publishes_nothing {
    var bad:         i32  = 0;
    var saw_failure: bool = false;
    var n:           u64  = 1;
    for (n <= 400) {
        var backing: A.Allocator;
        val make_r:  err[A.Error] = page.make(?backing);
        if (sel make_r.err) { ret 1; }
        var failing: T.Testing;
        val make_r2: err[A.Error] = T.make(?failing);
        if (sel make_r2.err) { ret 1; }
        T.fail_at_ordinal(?failing, n::usize);

        val sr: res[session.Session, fail.Fail] = session.init(T.allocator_of(?failing));
        if (sel sr.err) {
            n = n + 1;
            cnt;
        }
        var s: session.Session = sr.ok;

        var a_marker: u64            = 0xA;
        var b_marker: u64            = 0xB;
        var c_marker: u64            = 0xC;
        val r:        err[fail.Fail] = session.register_module_phase(?s, 2,
            (?a_marker)::ptr, (?b_marker)::ptr, (?c_marker)::ptr);
        if (sel r.err) {
            saw_failure = true;
            if (session.module_sema_ptr(?s, 2) != nil)     { bad = 1; }
            if (session.module_resolve_ptr(?s, 2) != nil)  { bad = 1; }
            if (session.module_comptime_ptr(?s, 2) != nil) { bad = 1; }
        }
        if (sel r.ok) {
            if (session.module_sema_ptr(?s, 2) != (?a_marker)::ptr)     { bad = 1; }
            if (session.module_resolve_ptr(?s, 2) != (?b_marker)::ptr)  { bad = 1; }
            if (session.module_comptime_ptr(?s, 2) != (?c_marker)::ptr) { bad = 1; }
        }
        session.dnit(?s);
        if (T.tracking_exhausted(?failing)) {
            T.dnit(?failing);
            ret 1;
        }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) {
            T.dnit(?failing);
            ret 1;
        }
        T.dnit(?failing);
        n = n + 1;
    }
    if (!saw_failure) { bad = 1; }
    ret bad;
}
