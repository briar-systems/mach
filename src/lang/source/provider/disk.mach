use collections_vector: std.collections.vector;
use fs:                 std.filesystem;
use io_error:           std.io.error;
use system_os:          std.system.os;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;
use std.types.view.view_eq_str;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.source.provider;

# a package whose modules are files under a directory: the head segment of a module's fqn is
# the package id, and the rest is the module's path under `src`
# ---
# id:           the package's `[project].id`
# version:      its `[project].version`
# module:       the fqn of its public module, or STR_NIL when it has none
# dir:          the package's directory
# src:          its source directory, relative to `dir`
# artifactless: it declares no artifact
# root:         it is the package being built
pub rec Package {
    id:           intern.StrId;
    version:      intern.StrId;
    module:       intern.StrId;
    dir:          intern.StrId;
    src:          intern.StrId;
    artifactless: bool;
    root:         bool;
}

# the provider of modules read from the filesystem. a module exists only when every segment of
# its path is spelled as its directory entry, so a case-insensitive filesystem resolves a name
# as linux does. the root package is matched first, then the dependencies in the order added
pub rec Disk {
    itn:      *intern.Interner;
    packages: collections_vector.Vector[Package];
}

pub fun init(a: *A.Allocator, itn: *intern.Interner) Disk {
    ret Disk{itn: itn, packages: collections_vector.init[Package](a)};
}

pub fun dnit(d: *Disk) {
    collections_vector.dnit[Package](?d.packages);
}

pub fun package_add(d: *Disk, p: Package) err[fail.Fail] {
    val pushed: res[usize, A.Error] = collections_vector.push[Package](?d.packages, p);
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun packages_clear(d: *Disk) {
    d.packages.len = 0;
}

pub fun provider_of(d: *Disk) provider.Provider {
    ret provider.Provider{ctx: d::ptr, locate: locate, exists: exists, read: read, package: package};
}

# the package an fqn's head segment names, and the fqn after the head
rec Placed {
    package: *Package;
    tail:    View;
}

fun place(d: *Disk, fqn: intern.StrId) opt[Placed] {
    val fqn_text: str   = intern.text(d.itn, fqn);
    val fqn_len:  usize = str_len(fqn_text);
    var head_end: usize = 0;
    for (head_end < fqn_len && fqn_text[head_end] != '.') { head_end = head_end + 1; }
    val head: View = view(fqn_text::*char, head_end);

    var tail_start: usize = head_end;
    if (tail_start < fqn_len && fqn_text[tail_start] == '.') { tail_start = tail_start + 1; }
    var tail: View = view(nil, 0);
    if (fqn_len - tail_start > 0) { tail = view(?fqn_text[tail_start], fqn_len - tail_start); }

    var i: usize = 0;
    for (i < d.packages.len) {
        val p: *Package = ?d.packages.data[i];
        if (view_eq_str(head, intern.text(d.itn, p.id))) { ret opt[Placed].some{Placed{package: p, tail: tail}}; }
        i = i + 1;
    }
    ret opt[Placed].none{};
}

fun locate(ctx: ptr, a: *A.Allocator, fqn: intern.StrId) res[opt[provider.Origin], fail.Fail] {
    val d:      *Disk       = ctx::*Disk;
    val placed: opt[Placed] = place(d, fqn);
    if (sel placed.none) { ret res[opt[provider.Origin], fail.Fail].ok{opt[provider.Origin].none{}}; }
    val p: *Package = placed.some.package;

    val path: res[str, fail.Fail] = module_path(a, intern.text(d.itn, p.dir), intern.text(d.itn, p.src), placed.some.tail);
    if (sel path.err) { ret res[opt[provider.Origin], fail.Fail].err{path.err}; }
    val rel: res[str, fail.Fail] = module_path(a, "", intern.text(d.itn, p.src), placed.some.tail);
    if (sel rel.err) {
        str_free(a, path.ok);
        ret res[opt[provider.Origin], fail.Fail].err{rel.err};
    }
    # the cleaned path is spelled with the host's separator; the source value is not
    val native: u8    = types_path.separator();
    var i:      usize = 0;
    for (native != '/' && rel.ok[i] != 0) {
        if (rel.ok[i] == native) { rel.ok[i] = '/'; }
        i = i + 1;
    }
    val file: res[intern.StrId, A.Error] = intern.add(d.itn, rel.ok);
    str_free(a, rel.ok);
    if (sel file.err) {
        str_free(a, path.ok);
        ret res[opt[provider.Origin], fail.Fail].err{fail.refused(file.err)};
    }
    val home: provider.Home = provider.Home{file: file.ok, package: p.id, version: p.version, root: p.root};
    ret res[opt[provider.Origin], fail.Fail].ok{opt[provider.Origin].some{provider.Origin{path: path.ok, home: home}}};
}

fun exists(ctx: ptr, a: *A.Allocator, fqn: intern.StrId) res[bool, fail.Fail] {
    val d:      *Disk       = ctx::*Disk;
    val placed: opt[Placed] = place(d, fqn);
    if (sel placed.none) { ret res[bool, fail.Fail].ok{false}; }
    val p:    *Package            = placed.some.package;
    val dir:  str                 = intern.text(d.itn, p.dir);
    val src:  str                 = intern.text(d.itn, p.src);
    val path: res[str, fail.Fail] = module_path(a, dir, src, placed.some.tail);
    if (sel path.err) { ret res[bool, fail.Fail].err{path.err}; }
    val is_file: res[bool, io_error.Error] = fs.is_file(path.ok);
    str_free(a, path.ok);
    if (sel is_file.err) {
        val k: io_error.Kind = is_file.err.kind;
        if (k == io_error.NOT_FOUND || k == io_error.NOT_DIRECTORY) { ret res[bool, fail.Fail].ok{false}; }
        ret res[bool, fail.Fail].err{fail.environment(diagnostic_kind.FS_STAT, fail.io_text(is_file.err))};
    }
    if (!is_file.ok) { ret res[bool, fail.Fail].ok{false}; }
    ret spelled_exactly(a, dir, src, placed.some.tail);
}

fun read(ctx: ptr, a: *A.Allocator, path: str) res[provider.Text, fail.Fail] {
    val text: res[str, fs.FsError] = fs.read_string(a, path);
    if (sel text.err) { ret res[provider.Text, fail.Fail].err{fail.fs_refused(text.err)}; }
    ret res[provider.Text, fail.Fail].ok{provider.Text{data: text.ok, owned: true}};
}

fun package(ctx: ptr, id: intern.StrId) opt[provider.Package] {
    val d: *Disk = ctx::*Disk;
    var i: usize = 0;
    for (i < d.packages.len) {
        val p: *Package = ?d.packages.data[i];
        if (intern.str_same(p.id, id)) { ret opt[provider.Package].some{provider.Package{module: p.module, artifactless: p.artifactless}}; }
        i = i + 1;
    }
    ret opt[provider.Package].none{};
}

# `root/src_dir/tail.mach` with each `.` of the tail a separator, cleaned
fun module_path(alloc: *A.Allocator, root: str, src_dir: str, dotted_tail: View) res[str, fail.Fail] {
    val root_len: usize             = str_len(root);
    val src_len:  usize             = str_len(src_dir);
    val total:    usize             = root_len + 1 + src_len + 1 + dotted_tail.len + 5 + 1;
    val r_buf:    res[*u8, A.Error] = A.allocate[u8](alloc, total);
    if (sel r_buf.err) { ret res[str, fail.Fail].err{fail.refused(r_buf.err)}; }
    val buf: *u8 = r_buf.ok;

    var k: usize = 0;
    var j: usize = 0;
    for (j < root_len) {
        buf[k] = root[j];
        k      = k + 1;
        j      = j + 1;
    }
    if (k > 0 && buf[k - 1] != '/') {
        buf[k] = '/';
        k      = k + 1;
    }
    j = 0;
    for (j < src_len) {
        buf[k] = src_dir[j];
        k      = k + 1;
        j      = j + 1;
    }
    buf[k] = '/';
    k      = k + 1;
    j      = 0;
    for (j < dotted_tail.len) {
        val c: u8 = dotted_tail.data[j];
        if (c == '.') { buf[k] = '/'; }
        or            { buf[k] = c; }
        k = k + 1;
        j = j + 1;
    }
    buf[k]     = '.';
    buf[k + 1] = 'm';
    buf[k + 2] = 'a';
    buf[k + 3] = 'c';
    buf[k + 4] = 'h';
    k          = k + 5;
    buf[k]     = 0;

    val cr: res[types_path.Path, A.Error] = types_path.clean(alloc, buf::str);
    A.deallocate[u8](alloc, buf, total);
    if (sel cr.err) { ret res[str, fail.Fail].err{fail.refused(cr.err)}; }
    ret res[str, fail.Fail].ok{cr.ok};
}

fun spelled_exactly(a: *A.Allocator, root: str, src_dir: str, tail: View) res[bool, fail.Fail] {
    val dir_r: res[str, A.Error] = types_path.join(a, root, src_dir);
    if (sel dir_r.err) { ret res[bool, fail.Fail].err{fail.refused(dir_r.err)}; }
    var dir:   str   = dir_r.ok;
    var start: usize = 0;
    for (start < tail.len) {
        var end: usize = start;
        for (end < tail.len && tail.data[end] != '.') { end = end + 1; }
        val segment: View = view(?tail.data[start], end - start);
        if (end == tail.len) {
            val found: bool = dir_holds_exact(dir, segment, ".mach");
            str_free(a, dir);
            ret res[bool, fail.Fail].ok{found};
        }
        val next: res[opt[str], fail.Fail] = descend(a, dir, segment);
        str_free(a, dir);
        if (sel next.err)     { ret res[bool, fail.Fail].err{next.err}; }
        if (sel next.ok.none) { ret res[bool, fail.Fail].ok{false}; }
        dir   = next.ok.some;
        start = end + 1;
    }
    str_free(a, dir);
    ret res[bool, fail.Fail].ok{false};
}

# the subdirectory `segment` of `dir`, none when `dir` holds no entry spelled exactly so
fun descend(a: *A.Allocator, dir: str, segment: View) res[opt[str], fail.Fail] {
    if (!dir_holds_exact(dir, segment, "")) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val name_r: res[str, StrError] = str_copy_slice(a, segment.data::str, 0, segment.len);
    if (sel name_r.err) { ret res[opt[str], fail.Fail].err{fail.str_refused(name_r.err)}; }
    val next_r: res[str, A.Error] = types_path.join(a, dir, name_r.ok);
    str_free(a, name_r.ok);
    if (sel next_r.err) { ret res[opt[str], fail.Fail].err{fail.refused(next_r.err)}; }
    ret res[opt[str], fail.Fail].ok{opt[str].some{next_r.ok}};
}

# whether the directory holds an entry spelled `segment` then `suffix`, byte for byte
fun dir_holds_exact(dir: str, segment: View, suffix: str) bool {
    var handle: usize = system_os.INVALID_HANDLE;
    if (system_os.open(system_os.working_dir(), dir, system_os.O_RDONLY | system_os.O_DIRECTORY, 0, ?handle) < 0) { ret false; }
    var cursor: system_os.DirectoryCursor = system_os.DirectoryCursor{};
    var found:  bool                      = false;
    if (system_os.directory_init(?cursor, handle).code >= 0) {
        for (!found) {
            var entry: system_os.DirectoryEntry;
            if (system_os.directory_next(?cursor, ?entry) <= 0) { brk; }
            found = entry_spells(entry.name, entry.length, segment, suffix);
        }
        system_os.directory_close(?cursor);
    }
    system_os.close(handle);
    ret found;
}

fun entry_spells(name: str, length: usize, segment: View, suffix: str) bool {
    val suffix_len: usize = str_len(suffix);
    if (length != segment.len + suffix_len) { ret false; }
    var i: usize = 0;
    for (i < segment.len) {
        if (name[i] != segment.data[i]::u8) { ret false; }
        i = i + 1;
    }
    var j: usize = 0;
    for (j < suffix_len) {
        if (name[segment.len + j] != suffix[j]) { ret false; }
        j = j + 1;
    }
    ret true;
}

use output_testing: mach.lang.output.testing;
use std.allocator.page;

test dir_holds_exact__compares_each_entry_byte_for_byte {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[output_testing.Output, fail.Fail] = output_testing.create(?a, "mach-module-case");
    if (sel created.err) { ret 2; }
    var owner: output_testing.Output = created.ok;
    fin { output_testing.dnit(?owner); }
    val dir_r: res[str, A.Error] = types_path.join(?a, owner.directory, "m");
    if (sel dir_r.err) { ret 3; }
    val dir:  str             = dir_r.ok;
    val made: err[fs.FsError] = fs.create_dir_all(?a, dir, 0o700);
    if (sel made.err) { ret 4; }
    val file_r: res[str, A.Error] = types_path.join(?a, dir, "item.mach");
    if (sel file_r.err) { ret 5; }
    val written: err[fs.FsError] = fs.write_bytes(file_r.ok, "", 0, 0o600);
    if (sel written.err)                                            { ret 6; }
    if (!dir_holds_exact(owner.directory, view("m"::*char, 1), "")) { ret 7; }
    if (dir_holds_exact(owner.directory, view("M"::*char, 1), ""))  { ret 8; }
    if (!dir_holds_exact(dir, view("item"::*char, 4), ".mach"))     { ret 9; }
    if (dir_holds_exact(dir, view("Item"::*char, 4), ".mach"))      { ret 10; }
    if (dir_holds_exact(dir, view("ite"::*char, 3), ".mach"))       { ret 11; }
    if (dir_holds_exact(dir, view("item"::*char, 4), ""))           { ret 12; }
    ret 0;
}
