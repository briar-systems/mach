use collections_vector: std.collections.vector;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy;
use std.types.string.str_len;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.intern;
use mach.lang.source.provider;

# a module held as its name and its text
pub rec Module {
    name: intern.StrId;
    text: str;
}

# the provider of modules held in memory, given as names and text: nothing touches a disk. a
# module is in the package its name's head segment names, and its file is its name with each
# `.` a `/`. a package is known only when it is added
pub rec Resident {
    alloc:    *A.Allocator;
    itn:      *intern.Interner;
    root:     intern.StrId;
    modules:  collections_vector.Vector[Module];
    packages: collections_vector.Vector[Bare];
}

rec Bare {
    id:      intern.StrId;
    package: provider.Package;
}

# `root` is the id of the package being built, STR_NIL when none is
pub fun init(a: *A.Allocator, itn: *intern.Interner, root: intern.StrId) Resident {
    ret Resident{
        alloc:   a, itn: itn, root: root,
        modules: collections_vector.init[Module](a), packages: collections_vector.init[Bare](a)
    };
}

pub fun dnit(r: *Resident) {
    var i: usize = 0;
    for (i < r.modules.len) {
        str_free(r.alloc, r.modules.data[i].text);
        i = i + 1;
    }
    collections_vector.dnit[Module](?r.modules);
    collections_vector.dnit[Bare](?r.packages);
}

# hold `text` as the module `name`, replacing what it held before
pub fun module_set(r: *Resident, name: str, text: str) err[fail.Fail] {
    val id: res[intern.StrId, A.Error] = intern.add(r.itn, name);
    if (sel id.err) { ret err[fail.Fail].err{fail.refused(id.err)}; }
    val copied: res[str, StrError] = str_copy(r.alloc, text);
    if (sel copied.err) { ret err[fail.Fail].err{fail.str_refused(copied.err)}; }
    val held: opt[*Module] = module_get(r, id.ok);
    if (sel held.some) {
        str_free(r.alloc, held.some.text);
        held.some.text = copied.ok;
        ret err[fail.Fail].ok{};
    }
    val pushed: res[usize, A.Error] = collections_vector.push[Module](?r.modules, Module{name: id.ok, text: copied.ok});
    if (sel pushed.err) {
        str_free(r.alloc, copied.ok);
        ret err[fail.Fail].err{fail.refused(pushed.err)};
    }
    ret err[fail.Fail].ok{};
}

# say what a bare import of the package `id` binds: its public module `module`, or none when empty
pub fun package_set(r: *Resident, id: str, module: str) err[fail.Fail] {
    val pid: res[intern.StrId, A.Error] = intern.add(r.itn, id);
    if (sel pid.err) { ret err[fail.Fail].err{fail.refused(pid.err)}; }
    var public: intern.StrId = intern.STR_NIL;
    if (str_len(module) > 0) {
        val mid: res[intern.StrId, A.Error] = intern.add(r.itn, module);
        if (sel mid.err) { ret err[fail.Fail].err{fail.refused(mid.err)}; }
        public = mid.ok;
    }
    val pushed: res[usize, A.Error] = collections_vector.push[Bare](?r.packages,
        Bare{id: pid.ok, package: provider.Package{module: public, artifactless: false}});
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun provider_of(r: *Resident) provider.Provider {
    ret provider.Provider{ctx: r::ptr, locate: locate, exists: exists, read: read, package: package};
}

fun module_get(r: *Resident, name: intern.StrId) opt[*Module] {
    var i: usize = 0;
    for (i < r.modules.len) {
        if (intern.str_same(r.modules.data[i].name, name)) { ret opt[*Module].some{?r.modules.data[i]}; }
        i = i + 1;
    }
    ret opt[*Module].none{};
}

fun locate(ctx: ptr, a: *A.Allocator, fqn: intern.StrId) res[opt[provider.Origin], fail.Fail] {
    val r:    *Resident = ctx::*Resident;
    val name: str       = intern.text(r.itn, fqn);
    val len:  usize     = str_len(name);
    var head: usize     = 0;
    for (head < len && name[head] != '.') { head = head + 1; }
    val head_id: res[intern.StrId, A.Error] = intern.range_add(r.itn, name, 0, head);
    if (sel head_id.err) { ret res[opt[provider.Origin], fail.Fail].err{fail.refused(head_id.err)}; }

    val path: res[str, StrError] = str_copy(a, name);
    if (sel path.err) { ret res[opt[provider.Origin], fail.Fail].err{fail.str_refused(path.err)}; }
    var handed: bool = false;
    fin {
        if (!handed) { str_free(a, path.ok); }
    }
    var start: usize = head;
    if (start < len) { start = start + 1; }
    val file_r: res[str, fail.Fail] = file_of(a, name, start);
    if (sel file_r.err) { ret res[opt[provider.Origin], fail.Fail].err{file_r.err}; }
    val file: res[intern.StrId, A.Error] = intern.add(r.itn, file_r.ok);
    str_free(a, file_r.ok);
    if (sel file.err) { ret res[opt[provider.Origin], fail.Fail].err{fail.refused(file.err)}; }
    val home: provider.Home = provider.Home{
        file: file.ok, package: head_id.ok, version: intern.STR_NIL, root: intern.str_same(head_id.ok, r.root)
    };
    handed = true;
    ret res[opt[provider.Origin], fail.Fail].ok{opt[provider.Origin].some{provider.Origin{path: path.ok, home: home}}};
}

# the name after its head segment, each `.` a `/`, then `.mach`
fun file_of(a: *A.Allocator, name: str, start: usize) res[str, fail.Fail] {
    val len:   usize             = str_len(name);
    val total: usize             = len - start + 6;
    val r_buf: res[*u8, A.Error] = A.allocate[u8](a, total);
    if (sel r_buf.err) { ret res[str, fail.Fail].err{fail.refused(r_buf.err)}; }
    val buf: *u8   = r_buf.ok;
    var k:   usize = 0;
    var i:   usize = start;
    for (i < len) {
        if (name[i] == '.') { buf[k] = '/'; }
        or                  { buf[k] = name[i]; }
        k = k + 1;
        i = i + 1;
    }
    buf[k]     = '.';
    buf[k + 1] = 'm';
    buf[k + 2] = 'a';
    buf[k + 3] = 'c';
    buf[k + 4] = 'h';
    buf[k + 5] = 0;
    val copied: res[str, StrError] = str_copy(a, buf::str);
    A.deallocate[u8](a, buf, total);
    if (sel copied.err) { ret res[str, fail.Fail].err{fail.str_refused(copied.err)}; }
    ret res[str, fail.Fail].ok{copied.ok};
}

fun exists(ctx: ptr, a: *A.Allocator, fqn: intern.StrId) res[bool, fail.Fail] {
    val r:    *Resident    = ctx::*Resident;
    val held: opt[*Module] = module_get(r, fqn);
    ret res[bool, fail.Fail].ok{sel held.some};
}

fun read(ctx: ptr, a: *A.Allocator, path: str) res[provider.Text, fail.Fail] {
    val r:    *Resident                  = ctx::*Resident;
    val name: res[intern.StrId, A.Error] = intern.add(r.itn, path);
    if (sel name.err) { ret res[provider.Text, fail.Fail].err{fail.refused(name.err)}; }
    val held: opt[*Module] = module_get(r, name.ok);
    if (sel held.none) { ret res[provider.Text, fail.Fail].err{fail.message("no module is held under this name")}; }
    ret res[provider.Text, fail.Fail].ok{provider.Text{data: held.some.text, owned: false}};
}

fun package(ctx: ptr, id: intern.StrId) opt[provider.Package] {
    val r: *Resident = ctx::*Resident;
    var i: usize     = 0;
    for (i < r.packages.len) {
        if (intern.str_same(r.packages.data[i].id, id)) { ret opt[provider.Package].some{r.packages.data[i].package}; }
        i = i + 1;
    }
    ret opt[provider.Package].none{};
}
