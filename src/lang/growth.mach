# the compiler's one growth routine for arrays it keeps as a pointer and a
# capacity beside its own count. std's Vector owns an array whole; these are
# for the tables whose count and capacity are fields of a larger record,
# usually a compact u32.
#
# reserve doubles the capacity, starting at MINIMUM, until it holds what is
# needed, and never past what the capacity's type can count. resize sets the
# capacity exactly, growing or shrinking. a refusal leaves the array as it
# was: the old storage and capacity stay valid and nothing moved. a capacity
# that cannot count what is needed, or a byte size that overflows, refuses
# with overflow; otherwise the refusal is the allocator's.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use T: std.allocator.testing;

# the first capacity reserve gives an empty array
pub val MINIMUM: usize = 8;

val U32_LIMIT: usize = 0xFFFFFFFF;

# the capacity reserve grows `cap` to so it holds `needed`, at most `limit`
fun capacity_for(cap: usize, needed: usize, limit: usize) res[usize, A.Error] {
    if (needed > limit) { ret res[usize, A.Error].err{A.Error.overflow{}}; }
    var grown: usize = MINIMUM;
    if (cap != 0) {
        grown = limit;
        if (cap <= limit / 2) { grown = cap * 2; }
    }
    if (grown < needed) { grown = needed; }
    ret res[usize, A.Error].ok{grown};
}

fun moved[T](a: *A.Allocator, data: **T, cap: usize, count: usize) err[A.Error] {
    var got: res[*T, A.Error];
    if (@data == nil) { got = A.allocate[T](a, count); }
    or                { got = A.reallocate[T](a, @data, cap, count); }
    if (sel got.err)  { ret err[A.Error].err{got.err}; }
    @data = got.ok;
    ret err[A.Error].ok{};
}

# grow the array at `data`, of `cap` elements, so it holds at least `needed`
pub fun reserve[T](a: *A.Allocator, data: **T, cap: *u32, needed: usize) err[A.Error] {
    if ((@cap)::usize >= needed) { ret err[A.Error].ok{}; }
    val grown: res[usize, A.Error] = capacity_for((@cap)::usize, needed, U32_LIMIT);
    if (sel grown.err) { ret err[A.Error].err{grown.err}; }
    val made: err[A.Error] = moved[T](a, data, (@cap)::usize, grown.ok);
    if (sel made.err) { ret made; }
    @cap = grown.ok::u32;
    ret err[A.Error].ok{};
}

# reserve for an array whose capacity is a usize
pub fun reserve_usize[T](a: *A.Allocator, data: **T, cap: *usize, needed: usize) err[A.Error] {
    if (@cap >= needed) { ret err[A.Error].ok{}; }
    val grown: res[usize, A.Error] = capacity_for(@cap, needed, ~(0::usize));
    if (sel grown.err) { ret err[A.Error].err{grown.err}; }
    val made: err[A.Error] = moved[T](a, data, @cap, grown.ok);
    if (sel made.err) { ret made; }
    @cap = grown.ok;
    ret err[A.Error].ok{};
}

# give the array at `data`, of `cap` elements, exactly `count`; zero releases it
pub fun resize[T](a: *A.Allocator, data: **T, cap: *u32, count: usize) err[A.Error] {
    if (count > U32_LIMIT) { ret err[A.Error].err{A.Error.overflow{}}; }
    val made: err[A.Error] = resized[T](a, data, (@cap)::usize, count);
    if (sel made.err) { ret made; }
    @cap = count::u32;
    ret err[A.Error].ok{};
}

# resize for an array whose capacity is a usize
pub fun resize_usize[T](a: *A.Allocator, data: **T, cap: *usize, count: usize) err[A.Error] {
    val made: err[A.Error] = resized[T](a, data, @cap, count);
    if (sel made.err) { ret made; }
    @cap = count;
    ret err[A.Error].ok{};
}

fun resized[T](a: *A.Allocator, data: **T, cap: usize, count: usize) err[A.Error] {
    if (count == cap) { ret err[A.Error].ok{}; }
    if (count == 0) {
        val freed: err[A.Error] = A.deallocate[T](a, @data, cap);
        if (sel freed.err) { ret freed; }
        @data = nil;
        ret err[A.Error].ok{};
    }
    ret moved[T](a, data, cap, count);
}

test reserve__starts_at_the_minimum_then_doubles {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?t); }
    val a:    *A.Allocator = T.allocator_of(?t);
    var data: *u32         = nil;
    var cap:  u32          = 0;
    val r1:   err[A.Error] = reserve[u32](a, ?data, ?cap, 1);
    if (sel r1.err)                                                     { ret 2; }
    if (cap != MINIMUM::u32 || data == nil || T.attempt_count(?t) != 1) { ret 3; }
    data[MINIMUM - 1] = 7;
    val r2: err[A.Error] = reserve[u32](a, ?data, ?cap, MINIMUM);
    if (sel r2.err)                                      { ret 4; }
    if (cap != MINIMUM::u32 || T.attempt_count(?t) != 1) { ret 5; }
    val r3: err[A.Error] = reserve[u32](a, ?data, ?cap, MINIMUM + 1);
    if (sel r3.err)                                          { ret 6; }
    if (cap != (MINIMUM * 2)::u32 || data[MINIMUM - 1] != 7) { ret 7; }
    val r4: err[A.Error] = reserve[u32](a, ?data, ?cap, 100);
    if (sel r4.err) { ret 8; }
    if (cap != 100) { ret 9; }
    A.deallocate[u32](a, data, cap::usize);
    if (!T.clean(?t)) { ret 10; }
    ret 0;
}

test reserve__refuses_a_count_its_capacity_cannot_hold {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?t); }
    val a:    *A.Allocator = T.allocator_of(?t);
    var data: *u32         = nil;
    var cap:  u32          = 0;
    val got:  err[A.Error] = reserve[u32](a, ?data, ?cap, U32_LIMIT + 1);
    if (!sel got.err) { ret 2; }
    val cause: A.Error = got.err;
    if (!sel cause.overflow)                  { ret 3; }
    if (T.attempt_count(?t) != 0 || cap != 0) { ret 4; }
    ret 0;
}

test reserve__stops_doubling_at_the_capacity_limit {
    val big: res[usize, A.Error] = capacity_for(0xC0000000, 0xC0000001, U32_LIMIT);
    if (sel big.err)         { ret 1; }
    if (big.ok != U32_LIMIT) { ret 2; }
    val wide: res[usize, A.Error] = capacity_for(~(0::usize) / 2 + 1, ~(0::usize) / 2 + 2, ~(0::usize));
    if (sel wide.err)           { ret 3; }
    if (wide.ok != ~(0::usize)) { ret 4; }
    ret 0;
}

test reserve__a_refusal_leaves_the_array_as_it_was {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?t); }
    val a:    *A.Allocator = T.allocator_of(?t);
    var data: *u32         = nil;
    var cap:  u32          = 0;
    val r5:   err[A.Error] = reserve[u32](a, ?data, ?cap, 1);
    if (sel r5.err) { ret 2; }
    val kept: *u32 = data;
    T.fail_from_ordinal(?t, T.attempt_count(?t) + 1);
    val got: err[A.Error] = reserve[u32](a, ?data, ?cap, MINIMUM + 1);
    if (!sel got.err)                        { ret 3; }
    if (data != kept || cap != MINIMUM::u32) { ret 4; }
    T.clear_failure(?t);
    A.deallocate[u32](a, data, cap::usize);
    if (!T.clean(?t)) { ret 5; }
    ret 0;
}

test resize__sets_the_capacity_exactly_and_releases_at_zero {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?t); }
    val a:    *A.Allocator = T.allocator_of(?t);
    var data: *u8          = nil;
    var cap:  usize        = 0;
    val r6:   err[A.Error] = resize_usize[u8](a, ?data, ?cap, 3);
    if (sel r6.err)              { ret 2; }
    if (cap != 3 || data == nil) { ret 3; }
    data[2] = 9;
    val r7: err[A.Error] = resize_usize[u8](a, ?data, ?cap, 40);
    if (sel r7.err)                { ret 4; }
    if (cap != 40 || data[2] != 9) { ret 5; }
    val r8: err[A.Error] = resize_usize[u8](a, ?data, ?cap, 0);
    if (sel r8.err)                              { ret 6; }
    if (cap != 0 || data != nil || T.leaked(?t)) { ret 7; }
    var narrow:     *u8          = nil;
    var narrow_cap: u32          = 0;
    val wide:       err[A.Error] = resize[u8](a, ?narrow, ?narrow_cap, U32_LIMIT + 1);
    if (!sel wide.err) { ret 8; }
    ret 0;
}
