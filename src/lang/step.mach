# the build steps a manifest declares: each step's inputs are collected, its
# invocation expanded, its outputs staged and published, and its stamp kept, so
# a step runs again only when what it reads changed. the build engine runs a
# project's own steps and its dependencies' steps as phases of a unit

use diagnostic_kind: mach.lang.diagnostic.kind;
use cache_key:       mach.lang.driver.cache.key;
use driver_closure:  mach.lang.driver.closure;
use mach.lang.driver.config;
use driver_environment: mach.lang.driver.environment;
use driver_load:        mach.lang.driver.load;
use mach.lang.driver.project;
use mach.lang.duration;
use mach.lang.fail;
use lang_fingerprint: mach.lang.fingerprint;
use mach.lang.host;
use mach.lang.intern;
use mach.lang.listing;
use mach.lang.manifest;
use mach.lang.manifest.template;
use mach.lang.output;
use mach.lang.output.layout;
use mach.lang.readout;
use step_glob: mach.lang.step.glob;
use step_walk: mach.lang.step.walk;
use mach.lang.subprocess;
use mach.lang.wire;
use A:               std.allocator;
use chrono_duration: std.chrono.duration;
use std.chrono.time;
use std.collections.sort;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.crypto.hash.sha256;
use encoding_hex: std.encoding.hex;
use fs:           std.filesystem;
use io_error:     std.io.error;
use std.process.env;
use std.process.events;
use std.process.exec;
use std.runtime.native.view.Unit;
use sync_cancel: std.sync.cancel;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_contains_char;
use std.types.string.str_copy_slice;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

fun collect_step_inputs(alloc: *A.Allocator, p: *project.Project, step: *manifest.StepDef, execution_root: str, output_root: str, out: *collections_vector.Vector[str]) err[fail.Fail] {
    var v: template.Values = driver_closure.cell_tmpl_vars(p);
    var i: u32             = 0;
    for (i < step.in_count) {
        val raw:  str                      = intern.text(?p.s.interner, step.in[i]);
        val sp_r: res[StepPath, fail.Fail] = resolve_step_path(alloc, raw, output_root, ?v, execution_root, output_root, "a build step input", true);
        if (sel sp_r.err) { ret err[fail.Fail].err{fail.at(alloc, sp_r.err, manifest.site_of(step.in_at, i))}; }
        var sp: StepPath = sp_r.ok;
        fin { step_path_free(alloc, ?sp); }
        if (!str_contains_char(sp.rel, '*')) {
            val physical_r: err[fail.Fail] = step_walk.path_check(alloc, sp.root, sp.rel, step_walk.PHYSICAL_REGULAR, "build step input");
            if (sel physical_r.err) { ret physical_r; }
            val pr: res[usize, A.Error] = collections_vector.push[str](out, sp.abs);
            if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
            sp.abs = nil;
        }
        or {
            if (!step_glob.shape_ok(sp.rel)) {
                val msg: fail.Fail = fail.formatted_user(alloc, diagnostic_kind.GLOB_SHAPE, "mach.toml: step input glob '{}' has an unsupported shape; wildcards are allowed only in the final path segment, with an optional '**' directory segment (e.g. 'dir/*.c' or 'dir/**/*.c')", sp.rel);
                ret err[fail.Fail].err{msg};
            }
            val before: usize          = out.len;
            val gr:     err[fail.Fail] = step_glob.expand(alloc, sp.root, sp.rel, out);
            if (sel gr.err) { ret gr; }
            if (out.len == before) {
                val msg: fail.Fail = fail.formatted_user(alloc, diagnostic_kind.GLOB_NO_MATCH, "mach.toml: step input glob '{}' matched no files", sp.rel);
                ret err[fail.Fail].err{msg};
            }
            var gi: usize = before;
            for (gi < out.len) {
                val abs_r: res[str, A.Error] = types_path.resolve(alloc, sp.root, out.data[gi]);
                if (sel abs_r.err) { ret err[fail.Fail].err{fail.refused(abs_r.err)}; }
                str_free(alloc, out.data[gi]);
                out.data[gi] = abs_r.ok;
                gi           = gi + 1;
            }
        }
        i = i + 1;
    }
    sort.sort[str](out.data, out.len);
    ret err[fail.Fail].ok{};
}

fun step_free_inputs(alloc: *A.Allocator, ins: *collections_vector.Vector[str]) {
    var i: usize = 0;
    for (i < ins.len) {
        str_free(alloc, ins.data[i]);
        i = i + 1;
    }
    collections_vector.dnit[str](ins);
}

rec StepStrings {
    items: **u8;
    count: u32;
}

rec StepInvocation {
    argv: StepStrings;
    env:  driver_environment.Strings;
}

rec StepPath {
    root: str;
    rel:  str;
    abs:  str;
}

fun step_path_free(a: *A.Allocator, path: *StepPath) {
    str_free(a, path.rel);
    str_free(a, path.abs);
    # nil, not "": str_free no-ops on nil and would hand a static empty literal
    # to the allocator, so an empty reset makes a second free an invalid free
    path.rel = nil;
    path.abs = nil;
}

fun step_paths_free(a: *A.Allocator, paths: *Vector[StepPath]) {
    var i: usize = 0;
    for (i < paths.len) {
        step_path_free(a, ?paths.data[i]);
        i = i + 1;
    }
    collections_vector.dnit[StepPath](paths);
}

fun absolute_path_in_root(path: str, root: str, allow_root: bool) bool {
    if (!types_path.is_abs(path) || !types_path.is_abs(root)) { ret false; }
    if (str_equals(path, root))                               { ret allow_root; }
    val rn: usize = str_len(root);
    if (!str_starts_with(path, root) || str_len(path) <= rn) { ret false; }
    ret types_path.is_separator(path[rn]);
}

fun step_path_error(a: *A.Allocator, field: str) fail.Fail {
    ret fail.formatted_user(a, diagnostic_kind.STEP_PATH_OUTSIDE, "mach.toml: {} must expand to a canonical path under the step execution root, or start with '{{project.work}}/' and remain under the designated output root", field);
}

fun resolve_step_path(a: *A.Allocator, raw: str, project_work: str, v: *template.Values,
    execution_root: str, output_root: str, field: str,
    allow_output_root: bool) res[StepPath, fail.Fail] {
    var empty:      StepPath            = StepPath{root: "", rel: "", abs: ""};
    val expanded_r: res[str, fail.Fail] = template.expand(a, raw, template.CONTEXT_PATH, project_work, v);
    if (sel expanded_r.err) { ret res[StepPath, fail.Fail].err{expanded_r.err}; }
    val expanded:      str  = expanded_r.ok;
    var expanded_kept: bool = false;
    fin {
        if (!expanded_kept) { str_free(a, expanded); }
    }
    val marker:          str  = "{project.work}";
    val absolute_output: bool = types_path.is_abs(project_work) && str_contains(raw, marker);
    if (!absolute_output && manifest.is_project_path(expanded)) {
        val abs_r: res[str, A.Error] = types_path.resolve(a, execution_root, expanded);
        if (sel abs_r.err) { ret res[StepPath, fail.Fail].err{fail.refused(abs_r.err)}; }
        expanded_kept = true;
        ret res[StepPath, fail.Fail].ok{StepPath{root: execution_root, rel: expanded, abs: abs_r.ok}};
    }

    val mn: usize = str_len(marker);
    val rn: usize = str_len(raw);
    if (!types_path.is_abs(expanded) || !str_starts_with(raw, marker)
        || (rn != mn && (rn <= mn || raw[mn] != '/'::u8))) {
        ret res[StepPath, fail.Fail].err{step_path_error(a, field)};
    }

    var handed: bool = false;
    var rel:    str  = nil;
    fin {
        if (!handed) { str_free(a, rel); }
    }
    if (rn == mn) {
        if (!allow_output_root) { ret res[StepPath, fail.Fail].err{step_path_error(a, field)}; }
        val rel_r: res[str, A.Error] = str_dup(a, ".");
        if (sel rel_r.err) { ret res[StepPath, fail.Fail].err{fail.refused(rel_r.err)}; }
        rel = rel_r.ok;
    }
    or {
        val suffix: str                 = ?raw[mn + 1];
        val rel_r:  res[str, fail.Fail] = template.path_expand(a, suffix, template.CONTEXT_PATH, "", v, field);
        if (sel rel_r.err) { ret res[StepPath, fail.Fail].err{rel_r.err}; }
        rel = rel_r.ok;
    }

    val joined_r: res[str, A.Error] = types_path.resolve(a, output_root, rel);
    if (sel joined_r.err) { ret res[StepPath, fail.Fail].err{fail.refused(joined_r.err)}; }
    val joined:  str               = joined_r.ok;
    val clean_r: res[str, A.Error] = types_path.clean(a, joined);
    str_free(a, joined);
    if (sel clean_r.err) { ret res[StepPath, fail.Fail].err{fail.refused(clean_r.err)}; }
    val clean: str = clean_r.ok;
    fin {
        if (!handed) { str_free(a, clean); }
    }
    val clean_root_r: res[str, A.Error] = types_path.clean(a, output_root);
    if (sel clean_root_r.err) { ret res[StepPath, fail.Fail].err{fail.refused(clean_root_r.err)}; }
    val clean_root: str = clean_root_r.ok;
    fin { str_free(a, clean_root); }
    if (!absolute_path_in_root(clean, clean_root, allow_output_root)) { ret res[StepPath, fail.Fail].err{step_path_error(a, field)}; }
    empty  = StepPath{root: output_root, rel: rel, abs: clean};
    handed = true;
    ret res[StepPath, fail.Fail].ok{empty};
}

# release a list of strings; an empty list owns nothing
fun step_strings_free(a: *A.Allocator, values: *StepStrings) {
    if (values.items == nil) { ret; }
    var i: u32 = 0;
    for (i < values.count) {
        str_free(a, values.items[i]::str);
        i = i + 1;
    }
    A.deallocate[*u8](a, values.items, values.count::usize + 1);
    values.items = nil;
    values.count = 0;
}

# expand each of the `count` values at `ids`, written at `sites`; a refusal points at the value
fun expand_step_strings(a: *A.Allocator, p: *project.Project, ids: *intern.StrId, sites: *fail.Place,
    count: u32, project_work: str, v: *template.Values) res[StepStrings, fail.Fail] {
    var out: StepStrings;
    out.items = nil;
    out.count = 0;
    if (count == 0) { ret res[StepStrings, fail.Fail].ok{out}; }

    val ar: res[**u8, A.Error] = A.allocate[*u8](a, count::usize + 1);
    if (sel ar.err) { ret res[StepStrings, fail.Fail].err{fail.refused(ar.err)}; }
    out.items = ar.ok;
    out.count = count;
    var cleared: usize = 0;
    for (cleared <= count::usize) {
        out.items[cleared] = nil;
        cleared            = cleared + 1;
    }
    var i: u32 = 0;
    for (i < count) {
        val er: res[str, fail.Fail] = template.expand(a, intern.text(?p.s.interner, ids[i]), template.CONTEXT_STEP_VALUE, project_work, v);
        if (sel er.err) {
            step_strings_free(a, ?out);
            ret res[StepStrings, fail.Fail].err{fail.at(a, er.err, manifest.site_of(sites, i))};
        }
        out.items[i] = er.ok::*u8;
        i            = i + 1;
    }
    out.items[count] = nil;
    out.count        = count;
    ret res[StepStrings, fail.Fail].ok{out};
}

fun expand_step_invocation(a: *A.Allocator, p: *project.Project, step: *manifest.StepDef,
    project_work: str, v: *template.Values) res[StepInvocation, fail.Fail] {
    var invocation: StepInvocation;
    invocation.argv = StepStrings{items: nil, count: 0};
    invocation.env  = driver_environment.Strings{items: nil, count: 0};

    val argv_r: res[StepStrings, fail.Fail] = expand_step_strings(a, p, step.argv, step.argv_at, step.argv_count, project_work, v);
    if (sel argv_r.err) { ret res[StepInvocation, fail.Fail].err{argv_r.err}; }
    invocation.argv = argv_r.ok;
    var handed: bool = false;
    fin {
        if (!handed) { step_strings_free(a, ?invocation.argv); }
    }
    if (invocation.argv.count == 0 || str_empty(invocation.argv.items[0]::str)) {
        ret res[StepInvocation, fail.Fail].err{fail.user(diagnostic_kind.STEP_ARGV_EMPTY, "mach.toml: expanded build step argv[0] must name an executable")};
    }

    val environment_r: res[driver_environment.Strings, fail.Fail] = expand_step_environment(a, p, step, project_work, v, exec.Environment.inherit{});
    if (sel environment_r.err) { ret res[StepInvocation, fail.Fail].err{environment_r.err}; }
    invocation.env = environment_r.ok;
    handed         = true;
    ret res[StepInvocation, fail.Fail].ok{invocation};
}

fun expand_step_environment(a: *A.Allocator, p: *project.Project, step: *manifest.StepDef,
    project_work: str, v: *template.Values, inherited: exec.Environment) res[driver_environment.Strings, fail.Fail] {
    val captured: res[driver_environment.Environment, fail.Fail] = driver_environment.capture(a, inherited);
    if (sel captured.err) { ret res[driver_environment.Strings, fail.Fail].err{captured.err}; }
    var environment: driver_environment.Environment = captured.ok;
    fin { driver_environment.dnit(?environment); }
    var i: u32 = 0;
    for (i < step.env_count) {
        val key:      str                  = intern.text(?p.s.interner, step.env_keys[i]);
        val reserved: res[bool, fail.Fail] = is_target_env_key(key);
        if (sel reserved.err) { ret res[driver_environment.Strings, fail.Fail].err{reserved.err}; }
        if (reserved.ok) {
            i = i + 1;
            cnt;
        }
        val value_r: res[str, fail.Fail] = template.expand(a, intern.text(?p.s.interner, step.env_values[i]), template.CONTEXT_STEP_VALUE, project_work, v);
        if (sel value_r.err) { ret res[driver_environment.Strings, fail.Fail].err{fail.at(a, value_r.err, manifest.site_of(step.env_at, i))}; }
        val value: str            = value_r.ok;
        val added: err[fail.Fail] = driver_environment.put(?environment, key, value, true);
        str_free(a, value);
        if (sel added.err) { ret res[driver_environment.Strings, fail.Fail].err{added.err}; }
        i = i + 1;
    }
    var ti: usize = 0;
    for (ti < TARGET_ENV_N) {
        val added: err[fail.Fail] = driver_environment.put(?environment, TARGET_ENV_KEYS[ti], target_env_value(v, ti), true);
        if (sel added.err) { ret res[driver_environment.Strings, fail.Fail].err{added.err}; }
        ti = ti + 1;
    }
    ret driver_environment.to_strings(?environment);
}

val TARGET_ENV_N:    usize             = 3;
val TARGET_ENV_KEYS: [TARGET_ENV_N]str = [TARGET_ENV_N]str{
    "MACH_TARGET_ARCH",
    "MACH_TARGET_SYS",
    "MACH_TARGET_ABI",
};

fun target_env_value(v: *template.Values, idx: usize) str {
    if (idx == 0) { ret v.arch; }
    if (idx == 1) { ret v.sys; }
    ret v.abi;
}

fun is_target_env_key(key: str) res[bool, fail.Fail] {
    var i: usize = 0;
    for (i < TARGET_ENV_N) {
        val order: res[i32, env.EnvError] = env.compare_names(key, TARGET_ENV_KEYS[i]);
        if (sel order.err) { ret res[bool, fail.Fail].err{fail.user(diagnostic_kind.STEP_ENVIRONMENT, fail.env_text(order.err))}; }
        if (order.ok == 0) { ret res[bool, fail.Fail].ok{true}; }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

fun step_invocation_free(a: *A.Allocator, invocation: *StepInvocation) {
    step_strings_free(a, ?invocation.argv);
    driver_environment.strings_free(a, ?invocation.env);
}

fun collect_step_outputs(a: *A.Allocator, p: *project.Project, step: *manifest.StepDef, execution_root: str, output_root: str, outputs: *Vector[StepPath]) err[fail.Fail] {
    var v:  template.Values = driver_closure.cell_tmpl_vars(p);
    var oi: u32             = 0;
    for (oi < step.out_count) {
        val sp_r: res[StepPath, fail.Fail] = resolve_step_path(a, intern.text(?p.s.interner, step.out[oi]), output_root, ?v, execution_root, output_root, "a build step output", false);
        if (sel sp_r.err) { ret err[fail.Fail].err{fail.at(a, sp_r.err, manifest.site_of(step.out_at, oi))}; }
        val sp:     StepPath            = sp_r.ok;
        val push_r: res[usize, A.Error] = collections_vector.push[StepPath](outputs, sp);
        if (sel push_r.err) {
            var lost: StepPath = sp;
            step_path_free(a, ?lost);
            ret err[fail.Fail].err{fail.refused(push_r.err)};
        }
        oi = oi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun step_make_output_dirs(a: *A.Allocator, outputs: *Vector[StepPath]) err[fail.Fail] {
    var oi: usize = 0;
    for (oi < outputs.len) {
        val sp:    *StepPath         = ?outputs.data[oi];
        val dir_r: res[str, A.Error] = types_path.parent(a, sp.rel);
        if (sel dir_r.err) { ret err[fail.Fail].err{fail.refused(dir_r.err)}; }
        val rel_dir: str            = dir_r.ok;
        val make_r:  err[fail.Fail] = step_walk.directory_ensure(a, sp.root, rel_dir, "build step output directory");
        str_free(a, rel_dir);
        if (sel make_r.err) { ret err[fail.Fail].err{make_r.err}; }
        oi = oi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun resolve_step_program(a: *A.Allocator, execution_root: str, invocation: *StepInvocation) res[str, fail.Fail] {
    val name: str = invocation.argv.items[0]::str;
    if (types_path.has_separator(name)) {
        val resolve_r: res[types_path.Path, A.Error] = types_path.resolve(a, execution_root, name);
        if (sel resolve_r.err) { ret res[str, fail.Fail].err{fail.refused(resolve_r.err)}; }
        ret res[str, fail.Fail].ok{resolve_r.ok};
    }
    val rr: res[str, fail.Fail] = host.program_resolve(a, name);
    if (sel rr.err) {
        ret res[str, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_EXECUTABLE_NOT_FOUND, "mach.toml: build step executable '{}' was not found on the planner PATH", name)};
    }
    val found: str = rr.ok;
    if (types_path.is_abs(found)) { ret res[str, fail.Fail].ok{found}; }
    fin { str_free(a, found); }
    val cwd_r: res[types_string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel cwd_r.err) { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.FS_CURRENT_DIR, fail.env_text(cwd_r.err))}; }
    var cwd:   types_string.OwnedString = cwd_r.ok;
    val abs_r: res[str, A.Error]        = types_path.resolve(a, cwd.data, found);
    types_string.owned_release(?cwd);
    if (sel abs_r.err) { ret res[str, fail.Fail].err{fail.refused(abs_r.err)}; }
    ret res[str, fail.Fail].ok{abs_r.ok};
}

fun execute_step_invocation(a: *A.Allocator, execution_root: str, program: str,
    invocation: *StepInvocation, step_name: str,
    timeout: chrono_duration.Duration) err[fail.Fail] {
    var child: subprocess.OwnedSubprocess;
    subprocess.init(?child);
    fin { subprocess.dnit(a, ?child); }
    var options: subprocess.SpawnOptions = subprocess.spawn_options();
    options.cwd     = execution_root;
    options.grouped = true;
    if (timeout > 0) {
        val bounded: err[subprocess.Error] = subprocess.bound(?child, timeout);
        if (sel bounded.err) {
            ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_SPAWN, "failed to bound build step executable '{}' by its timeout: {}: {}", program, bounded.err.identity, subprocess.cause_text(bounded.err.cause))};
        }
    }
    val spawn_r: err[subprocess.Error] = subprocess.spawn_native(a, ?child, program, invocation.argv.items,
        exec.NativeEnvironment.given{invocation.env.items}, options);
    if (sel spawn_r.err) {
        val msg: fail.Fail = fail.formatted_user(a, diagnostic_kind.STEP_SPAWN, "failed to spawn build step executable '{}': {}: {}", program, spawn_r.err.identity, subprocess.cause_text(spawn_r.err.cause));
        ret err[fail.Fail].err{msg};
    }

    var scope: sync_cancel.Scope;
    sync_cancel.make_root(?scope, opt[time.Instant].none{});
    var source:           events.Source;
    val made_source:      err[io_error.Error] = events.make(?source);
    var has_source:       bool                = sel made_source.ok;
    var interrupt_source: *events.Source      = nil;
    if (has_source) { interrupt_source = ?source; }

    val wait_r:   res[*subprocess.OwnedSubprocess, subprocess.Error] = subprocess.wait_any(a, ?child, 1, ?scope, interrupt_source);
    var released: err[fail.Fail]                                     = err[fail.Fail].ok{};
    if (has_source) { released = source_closed(a, ?source); }
    # a root scope made here holds no child, registration or waiter once the wait returns, so destroy cannot refuse
    sync_cancel.destroy(?scope);
    val ended: err[fail.Fail] = step_ended(a, ?child, wait_r, program, step_name, timeout);
    if (sel released.err) {
        if (sel ended.err) { ret err[fail.Fail].err{fail.with_secondary(a, ended.err, released.err)}; }
        ret released;
    }
    ret ended;
}

# the process event source closed and its handlers restored; a refusal is the
# step's failure, since the handlers may still be installed
fun source_closed(a: *A.Allocator, source: *events.Source) err[fail.Fail] {
    val closed: err[io_error.Error] = events.close(source);
    if (sel closed.err) { ret err[fail.Fail].err{fail.environment_of(diagnostic_kind.STEP_WAIT, fail.format(a, "failed to restore the process event handlers: {}", fail.io_text(closed.err)))}; }
    ret err[fail.Fail].ok{};
}

# how a build step's executable ended, once `wait_r` answered for `child`
fun step_ended(a: *A.Allocator, child: *subprocess.OwnedSubprocess, wait_r: res[*subprocess.OwnedSubprocess, subprocess.Error],
    program: str, step_name: str, timeout: chrono_duration.Duration) err[fail.Fail] {
    if (sel wait_r.err) {
        val wait_err: subprocess.Error                                     = wait_r.err;
        val cancel_r: res[subprocess.SubprocessTerminal, subprocess.Error] = subprocess.cancel(a, child, 0);
        if (sel cancel_r.err) {
            val waited: fail.Fail = fail.formatted_user(a, diagnostic_kind.STEP_WAIT, "failed to wait for build step executable '{}': {}: {}", program,
                wait_err.identity, subprocess.cause_text(wait_err.cause));
            ret err[fail.Fail].err{fail.with_secondary(a, waited, subprocess.refusal(a, diagnostic_kind.STEP_WAIT, cancel_r.err))};
        }
        val msg: fail.Fail = fail.formatted_user(a, diagnostic_kind.STEP_WAIT, "failed to wait for build step executable '{}': {}: {}; child was canceled and reaped", program,
            wait_err.identity, subprocess.cause_text(wait_err.cause));
        ret err[fail.Fail].err{msg};
    }
    if (subprocess.expired(child)) {
        val t:   duration.Text = duration.text(timeout);
        val msg: fail.Fail     = fail.formatted_user(a, diagnostic_kind.STEP_TIMEOUT, "build step '{}' exceeded its timeout of {}{} and its process group was terminated", step_name, t.n, t.unit);
        ret err[fail.Fail].err{msg};
    }
    val terminal: subprocess.SubprocessTerminal = child.terminal;
    if (terminal.kind == subprocess.STATE_EXITED) {
        if (terminal.code == 0) { ret err[fail.Fail].ok{}; }
        val msg: fail.Fail = fail.formatted_user(a, diagnostic_kind.STEP_EXIT, "build step exited with code {}", terminal.code);
        ret err[fail.Fail].err{msg};
    }
    if (terminal.kind == subprocess.STATE_SIGNALED) {
        val msg: fail.Fail = fail.formatted_user(a, diagnostic_kind.STEP_SIGNAL, "build step terminated by signal {}", terminal.code);
        ret err[fail.Fail].err{msg};
    }
    ret err[fail.Fail].err{fail.message("build step reached an invalid terminal state")};
}

rec TreeFile {
    path:   str;
    kind:   u8;
    sec:    i64;
    nsec:   i64;
    size:   usize;
    digest: [32]u8;
}

val TREE_FILE:      u8 = 1;
val TREE_DIRECTORY: u8 = 2;

fun collect_tree_files(a: *A.Allocator, dir: str, out: *collections_vector.Vector[TreeFile]) err[fail.Fail] {
    val is_symlink_r: res[bool, io_error.Error] = fs.is_symlink(dir);
    if ((sel is_symlink_r.ok && is_symlink_r.ok)) { ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_SNAPSHOT, "cannot snapshot symlink tree root '{}'", dir)}; }
    val exists_r: res[bool, io_error.Error] = fs.exists(dir);
    if (!(sel exists_r.ok && exists_r.ok)) { ret err[fail.Fail].ok{}; }
    val root_meta_r: res[fs.Metadata, io_error.Error] = fs.metadata_link(dir);
    if (sel root_meta_r.err) { ret err[fail.Fail].err{fail.user(diagnostic_kind.FS_READ, fail.io_text(root_meta_r.err))}; }
    val root_meta: fs.Metadata = root_meta_r.ok;
    if (!fs.meta_is_dir(?root_meta)) { ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_SNAPSHOT, "cannot snapshot non-directory tree root '{}'", dir)}; }
    val root_path_r: res[str, A.Error] = types_path.clean(a, dir);
    if (sel root_path_r.err) { ret err[fail.Fail].err{fail.refused(root_path_r.err)}; }
    var root_entry: TreeFile;
    root_entry.path = root_path_r.ok;
    root_entry.kind = TREE_DIRECTORY;
    root_entry.sec  = 0;
    root_entry.nsec = 0;
    root_entry.size = 0;
    var root_digest_i: usize = 0;
    for (root_digest_i < 32) {
        root_entry.digest[root_digest_i] = 0;
        root_digest_i                    = root_digest_i + 1;
    }
    val root_push_r: res[usize, A.Error] = collections_vector.push[TreeFile](out, root_entry);
    if (sel root_push_r.err) {
        str_free(a, root_entry.path);
        ret err[fail.Fail].err{fail.refused(root_push_r.err)};
    }
    val listed: res[Vector[fs.Listed], fs.FsError] = fs.read_dir(a, root_entry.path);
    if (sel listed.err) { ret err[fail.Fail].err{fail.user(diagnostic_kind.FS_READ, fail.fs_text(listed.err))}; }
    var entries: Vector[fs.Listed] = listed.ok;
    fin { fs.listed_free(?entries); }
    val names_r: res[Vector[str], fail.Fail] = listing.names(a, root_entry.path, ?entries);
    if (sel names_r.err) { ret err[fail.Fail].err{names_r.err}; }
    var names: Vector[str] = names_r.ok;
    fin { collections_vector.dnit[str](?names); }
    sort.sort[str](names.data, names.len);

    var i: usize = 0;
    for (i < names.len) {
        val child_r: res[str, fail.Fail] = driver_load.join_path(a, root_entry.path, names.data[i]);
        if (sel child_r.err) { ret err[fail.Fail].err{child_r.err}; }
        val child: str  = child_r.ok;
        var kept:  bool = false;
        fin {
            if (!kept) { str_free(a, child); }
        }
        val fi_r: res[fs.Metadata, io_error.Error] = fs.metadata_link(child);
        if (sel fi_r.err) { ret err[fail.Fail].err{fail.user(diagnostic_kind.FS_READ, fail.io_text(fi_r.err))}; }
        val fi: fs.Metadata = fi_r.ok;
        if (fs.meta_is_dir(?fi)) {
            val child_walk_r: err[fail.Fail] = collect_tree_files(a, child, out);
            if (sel child_walk_r.err) { ret child_walk_r; }
        }
        or (fs.meta_is_file(?fi)) {
            var tf: TreeFile;
            tf.path = child;
            tf.kind = TREE_FILE;
            tf.sec  = fi.modified.sec;
            tf.nsec = fi.modified.nsec;
            tf.size = fi.size;
            val digest_r: err[fail.Fail] = lang_fingerprint.file_sha256(child, ?tf.digest[0]);
            if (sel digest_r.err) { ret digest_r; }
            val pr: res[usize, A.Error] = collections_vector.push[TreeFile](out, tf);
            if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
            kept = true;
        }
        or {
            val msg: fail.Fail = fail.formatted_user(a, diagnostic_kind.STEP_SNAPSHOT, "cannot snapshot unsupported entry '{}'", child);
            ret err[fail.Fail].err{msg};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun free_tree_files(a: *A.Allocator, v: *Vector[TreeFile]) {
    var i: usize = 0;
    for (i < v.len) {
        str_free(a, v.data[i].path);
        i = i + 1;
    }
    collections_vector.dnit[TreeFile](v);
}

fun snapshot_holds(snap: *Vector[TreeFile], f: *TreeFile) bool {
    var i: usize = 0;
    for (i < snap.len) {
        val s: *TreeFile = ?snap.data[i];
        if (str_equals(s.path, f.path)) {
            if (s.kind != f.kind)                                       { ret false; }
            if (s.kind == TREE_DIRECTORY)                               { ret true; }
            if (s.sec != f.sec || s.nsec != f.nsec || s.size != f.size) { ret false; }
            var j: usize = 0;
            for (j < 32) {
                if (s.digest[j] != f.digest[j]) { ret false; }
                j = j + 1;
            }
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun check_step_left_obj_tree(a: *A.Allocator, before: *Vector[TreeFile], tree: str, name: str) err[fail.Fail] {
    var after: Vector[TreeFile] = collections_vector.init[TreeFile](a);
    fin { free_tree_files(a, ?after); }
    val collect_r: err[fail.Fail] = collect_tree_files(a, tree, ?after);
    if (sel collect_r.err) {
        ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_UNVERIFIABLE, "build step '{}' left the compiler-owned module object tree unverifiable: {}", name, fail.describe(collect_r.err))};
    }

    var verdict: err[fail.Fail] = err[fail.Fail].ok{};
    var i:       usize          = 0;
    for (i < after.len) {
        if (!snapshot_holds(before, ?after.data[i])) {
            verdict = err[fail.Fail].err{config.step_out_reserved_error(a, "build step", name, after.data[i].path, tree, "the module object tree")};
            i       = after.len;
        }
        or { i = i + 1; }
    }
    i = 0;
    for (sel verdict.ok && i < before.len) {
        if (!snapshot_holds(?after, ?before.data[i])) {
            verdict = err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_RESERVED, "build step '{}' removed '{}' from '{}/', the compiler-owned module object tree", name, before.data[i].path, tree)};
            i       = before.len;
        }
        or { i = i + 1; }
    }
    ret verdict;
}

fun step_paths_absolute(a: *A.Allocator, paths: *Vector[StepPath], out: *Vector[str]) err[fail.Fail] {
    var i: usize = 0;
    for (i < paths.len) {
        val dup_r: res[str, A.Error] = str_dup(a, paths.data[i].abs);
        if (sel dup_r.err) { ret err[fail.Fail].err{fail.refused(dup_r.err)}; }
        val dup:    str                 = dup_r.ok;
        val push_r: res[usize, A.Error] = collections_vector.push[str](out, dup);
        if (sel push_r.err) {
            str_free(a, dup);
            ret err[fail.Fail].err{fail.refused(push_r.err)};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun step_paths_rel_for_root(a: *A.Allocator, paths: *Vector[StepPath], root: str, out: *Vector[str]) err[fail.Fail] {
    var i: usize = 0;
    for (i < paths.len) {
        val sp: *StepPath = ?paths.data[i];
        if (str_equals(sp.root, root)) {
            val dup_r: res[str, A.Error] = str_dup(a, sp.rel);
            if (sel dup_r.err) { ret err[fail.Fail].err{fail.refused(dup_r.err)}; }
            val dup:    str                 = dup_r.ok;
            val push_r: res[usize, A.Error] = collections_vector.push[str](out, dup);
            if (sel push_r.err) {
                str_free(a, dup);
                ret err[fail.Fail].err{fail.refused(push_r.err)};
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun output_path_declared(path: str, declared: *Vector[str]) bool {
    var i: usize = 0;
    for (i < declared.len) {
        if (config.path_in_module_obj_tree(path, declared.data[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun validate_declared_step_outputs(a: *A.Allocator, root: str, outputs: *Vector[str], name: str) err[fail.Fail] {
    var i: usize = 0;
    for (i < outputs.len) {
        val physical_r: err[fail.Fail] = step_walk.path_check(a, root, outputs.data[i], step_walk.PHYSICAL_ENTRY, "declared build step output");
        if (sel physical_r.err) {
            ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_MISSING, "build step '{}' did not publish valid declared output '{}': {}", name, outputs.data[i], fail.describe(physical_r.err))};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun check_step_output_effects(a: *A.Allocator, before: *Vector[TreeFile], tree: str, declared: *Vector[str], name: str) err[fail.Fail] {
    var after: Vector[TreeFile] = collections_vector.init[TreeFile](a);
    fin { free_tree_files(a, ?after); }
    val collect_r: err[fail.Fail] = collect_tree_files(a, tree, ?after);
    if (sel collect_r.err) {
        ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_UNVERIFIABLE, "build step '{}' left the project output tree unverifiable: {}", name, fail.describe(collect_r.err))};
    }
    var i: usize = 0;
    for (i < after.len) {
        if (!snapshot_holds(before, ?after.data[i]) && !output_path_declared(after.data[i].path, declared)) {
            val msg: fail.Fail = fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_UNDECLARED, "build step '{}' created or modified undeclared output '{}' under '{}'; declare it in the step output list", name, after.data[i].path, tree);
            ret err[fail.Fail].err{msg};
        }
        i = i + 1;
    }
    i = 0;
    for (i < before.len) {
        if (!snapshot_holds(?after, ?before.data[i]) && !output_path_declared(before.data[i].path, declared)) {
            val msg: fail.Fail = fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_UNDECLARED, "build step '{}' removed undeclared output '{}' under '{}'; declare it in the step output list", name, before.data[i].path, tree);
            ret err[fail.Fail].err{msg};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun combine_step_terminal_results(a: *A.Allocator, object_integrity: err[fail.Fail], output_integrity: err[fail.Fail], execution: err[fail.Fail]) err[fail.Fail] {
    if (sel object_integrity.err) {
        if (sel output_integrity.err) {
            if (sel execution.err) {
                ret err[fail.Fail].err{fail.formatted_user(a, fail.kind_of(object_integrity.err), "{}; project output integrity: {}; execution outcome: {}", fail.describe(object_integrity.err), fail.describe(output_integrity.err), fail.describe(execution.err))};
            }
        }
        if (sel output_integrity.err) {
            ret err[fail.Fail].err{fail.formatted_user(a, fail.kind_of(object_integrity.err), "{}; project output integrity: {}", fail.describe(object_integrity.err), fail.describe(output_integrity.err))};
        }
        if (sel execution.err) {
            ret err[fail.Fail].err{fail.formatted_user(a, fail.kind_of(object_integrity.err), "{}; execution outcome: {}", fail.describe(object_integrity.err), fail.describe(execution.err))};
        }
        ret object_integrity;
    }
    if (sel output_integrity.err) {
        if (sel execution.err) {
            ret err[fail.Fail].err{fail.formatted_user(a, fail.kind_of(output_integrity.err), "{}; execution outcome: {}", fail.describe(output_integrity.err), fail.describe(execution.err))};
        }
        ret output_integrity;
    }
    ret execution;
}

fun absolute_execution_root(a: *A.Allocator, root: str) res[str, fail.Fail] {
    if (types_path.is_abs(root)) {
        val str_dup_r: res[str, A.Error] = str_dup(a, root);
        if (sel str_dup_r.err) { ret res[str, fail.Fail].err{fail.refused(str_dup_r.err)}; }
        ret res[str, fail.Fail].ok{str_dup_r.ok};
    }
    val cwd_r: res[types_string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel cwd_r.err) { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.FS_CURRENT_DIR, fail.env_text(cwd_r.err))}; }
    var cwd:      types_string.OwnedString = cwd_r.ok;
    val joined_r: res[str, A.Error]        = types_path.resolve(a, cwd.data, root);
    types_string.owned_release(?cwd);
    if (sel joined_r.err) { ret res[str, fail.Fail].err{fail.refused(joined_r.err)}; }
    val joined:  str               = joined_r.ok;
    val clean_r: res[str, A.Error] = types_path.clean(a, joined);
    str_free(a, joined);
    if (sel clean_r.err) { ret res[str, fail.Fail].err{fail.refused(clean_r.err)}; }
    ret res[str, fail.Fail].ok{clean_r.ok};
}

val STEP_FP_SCHEMA: u8 = 1;

fun digest_hex(a: *A.Allocator, digest: *u8, len: usize) res[str, fail.Fail] {
    val cap: usize             = encoding_hex.encoded_len(len);
    val rb:  res[*u8, A.Error] = A.allocate[u8](a, cap);
    if (sel rb.err) { ret res[str, fail.Fail].err{fail.refused(rb.err)}; }
    val buf: *u8 = rb.ok;
    encoding_hex.encode(digest, len, buf, cap);
    ret res[str, fail.Fail].ok{buf::str};
}

fun step_stamp_path(a: *A.Allocator, root_project: str, root_out: str, owner_id: str, step_name: str) res[str, fail.Fail] {
    val fname_r: res[str, fail.Fail] = fail.format(a, "{}.{}.stamp", owner_id, step_name);
    if (sel fname_r.err) { ret fname_r; }
    val fname: str = fname_r.ok;
    fin { str_free(a, fname); }
    val d1_r: res[str, fail.Fail] = driver_load.join_path(a, root_project, root_out);
    if (sel d1_r.err) { ret d1_r; }
    val d1:   str                 = d1_r.ok;
    val d2_r: res[str, fail.Fail] = driver_load.join_path(a, d1, layout.STEPS);
    str_free(a, d1);
    if (sel d2_r.err) { ret d2_r; }
    val d2:     str                 = d2_r.ok;
    val path_r: res[str, fail.Fail] = driver_load.join_path(a, d2, fname);
    str_free(a, d2);
    ret path_r;
}

# whether the stamp at `path` records `hex`; a step never stamped has no stamp to match
fun stamp_matches(a: *A.Allocator, path: str, hex: str) res[bool, fail.Fail] {
    val rr: res[str, fs.FsError] = fs.read_string(a, path);
    if (sel rr.err) {
        if (sel rr.err.io && rr.err.io.kind == io_error.NOT_FOUND) { ret res[bool, fail.Fail].ok{false}; }
        ret res[bool, fail.Fail].err{fail.fs_environment(diagnostic_kind.FS_READ, rr.err)};
    }
    val prior: str  = rr.ok;
    val eq:    bool = str_equals(prior, hex);
    str_free(a, prior);
    ret res[bool, fail.Fail].ok{eq};
}

# the stamp lives in the layout beneath the root project's output directory
fun write_stamp(a: *A.Allocator, root_project: str, root_out: str, path: str, hex: str) err[fail.Fail] {
    val out_r: res[str, fail.Fail] = driver_load.join_path(a, root_project, root_out);
    if (sel out_r.err) { ret err[fail.Fail].err{out_r.err}; }
    val reserved: err[fail.Fail] = output.reserve(a, out_r.ok, path);
    str_free(a, out_r.ok);
    if (sel reserved.err) { ret reserved; }
    ret output.bytes(nil, a, path, hex::*u8, str_len(hex), 0o644, "write the build step stamp");
}

# whether every declared output is in place; an output the path checks refuse is
# not current, and a compiler failure on the way is the failure
fun step_final_outputs_current(a: *A.Allocator, outputs: *Vector[StepPath]) res[bool, fail.Fail] {
    var i: usize = 0;
    for (i < outputs.len) {
        val sp: *StepPath      = ?outputs.data[i];
        val vr: err[fail.Fail] = step_walk.path_check(a, sp.root, sp.rel, step_walk.PHYSICAL_ENTRY, "build step output");
        if (sel vr.err) {
            if (fail.is_message(vr.err)) { ret res[bool, fail.Fail].err{vr.err}; }
            ret res[bool, fail.Fail].ok{false};
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{true};
}

fun put_step_count(s: *wire.Sink, n: u32) {
    var b: [4]u8;
    b[0] = (n & 0xFF)::u8;
    b[1] = ((n >> 8) & 0xFF)::u8;
    b[2] = ((n >> 16) & 0xFF)::u8;
    b[3] = ((n >> 24) & 0xFF)::u8;
    lang_fingerprint.put_domain_bytes(s, lang_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, ?b[0], 4);
}

fun put_step_file(s: *wire.Sink, a: *A.Allocator, path: str) err[fail.Fail] {
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(a, path);
    if (sel rr.err) { ret err[fail.Fail].err{fail.user(diagnostic_kind.FS_READ, fail.fs_text(rr.err))}; }
    var buf:    Vector[u8] = rr.ok;
    var digest: [32]u8;
    sha256.hash(buf.data, buf.len, ?digest[0]);
    collections_vector.dnit[u8](?buf);
    lang_fingerprint.put_domain_bytes(s, lang_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, ?digest[0], 32);
    ret err[fail.Fail].ok{};
}

fun put_step_strings(s: *wire.Sink, values: *StepStrings) {
    put_step_count(s, values.count);
    var i: u32 = 0;
    for (i < values.count) {
        lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, values.items[i]::str);
        i = i + 1;
    }
}

# each entry by its native units, so a value with no UTF-8 spelling still
# keys the step
fun put_step_environment(s: *wire.Sink, values: *driver_environment.Strings) {
    put_step_count(s, values.count);
    var i: u32 = 0;
    for (i < values.count) {
        val units: usize = driver_environment.units_length(values.items[i]);
        lang_fingerprint.put_domain_bytes(s, lang_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, values.items[i]::*u8, units * $size_of(Unit));
        i = i + 1;
    }
}

fun put_step_paths(s: *wire.Sink, values: *Vector[str]) err[fail.Fail] {
    if (values.len > 0xFFFFFFFF::usize) { ret err[fail.Fail].err{fail.user(diagnostic_kind.STEP_TOO_MANY_PATHS, "build step has too many declared paths")}; }
    put_step_count(s, values.len::u32);
    var i: usize = 0;
    for (i < values.len) {
        lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, values.data[i]);
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun put_step_inputs(s: *wire.Sink, a: *A.Allocator, values: *Vector[str]) err[fail.Fail] {
    if (values.len > 0xFFFFFFFF::usize) { ret err[fail.Fail].err{fail.user(diagnostic_kind.STEP_TOO_MANY_PATHS, "build step has too many expanded inputs")}; }
    put_step_count(s, values.len::u32);
    var i: usize = 0;
    for (i < values.len) {
        lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, values.data[i]);
        val wc: err[fail.Fail] = put_step_file(s, a, values.data[i]);
        if (sel wc.err) { ret wc; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun put_step(s: *wire.Sink, a: *A.Allocator, target_s: str, profile_s: str, program: str,
    argv: *StepStrings, env: *driver_environment.Strings, prerequisites: *StepStrings,
    ins: *Vector[str], outputs: *Vector[str]) err[fail.Fail] {
    lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, target_s);
    lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, profile_s);
    lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, program);
    val wpc: err[fail.Fail] = put_step_file(s, a, program);
    if (sel wpc.err) { ret wpc; }
    put_step_strings(s, argv);
    put_step_environment(s, env);
    put_step_strings(s, prerequisites);
    val wo: err[fail.Fail] = put_step_paths(s, outputs);
    if (sel wo.err) { ret wo; }
    ret put_step_inputs(s, a, ins);
}

fun step_fingerprint(a: *A.Allocator, target_s: str, profile_s: str, program: str,
    argv: *StepStrings, env: *driver_environment.Strings, prerequisites: *StepStrings,
    ins: *Vector[str], outputs: *Vector[str], digest: *u8) err[fail.Fail] {
    var s: wire.Sink = wire.grown(a);
    fin { wire.dnit(?s); }
    val put: err[fail.Fail] = put_step(?s, a, target_s, profile_s, program, argv, env, prerequisites, ins, outputs);
    if (sel put.err) { ret put; }
    val failed: opt[fail.Fail] = wire.failure(?s);
    if (sel failed.some) { ret err[fail.Fail].err{failed.some}; }
    sha256.hash(wire.bytes(?s), s.len, digest);
    ret err[fail.Fail].ok{};
}

fun step_staging_root(a: *A.Allocator, output_root: str, step_name: str) res[str, fail.Fail] {
    ret layout.within(a, output_root, layout.STAGE, step_name);
}

# a staging root the step could not clear on its way out
fun staging_left(a: *A.Allocator, staging_root: str, e: fs.FsError) fail.Fail {
    ret fail.environment_of(diagnostic_kind.FS_REMOVE, fail.format(a, "cannot remove build step staging area '{}': {}", staging_root, fail.fs_text(e)));
}

fun step_prepare_staging(a: *A.Allocator, output_root: str, staging_root: str, step_name: str) err[fail.Fail] {
    val stage_r: err[fail.Fail] = step_walk.owned_directory_ensure(a, output_root, layout.STAGE, "build step staging area");
    if (sel stage_r.err) { ret stage_r; }
    val rel_r: res[str, fail.Fail] = fail.format(a, "{}/{}", layout.STAGE, step_name);
    if (sel rel_r.err) { ret err[fail.Fail].err{rel_r.err}; }
    val rel: str = rel_r.ok;
    fin { str_free(a, rel); }
    val ancestors_r: err[fail.Fail] = step_walk.ancestors_check(a, output_root, rel, "build step staging area");
    if (sel ancestors_r.err) { ret ancestors_r; }
    val rm: err[fs.FsError] = fs.remove_all(a, staging_root);
    if (sel rm.err) {
        ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_STAGING, "failed to prepare build step staging area: {}", fail.fs_text(rm.err))};
    }
    ret step_walk.owned_directory_ensure(a, output_root, rel, "build step staging area");
}

fun step_make_staging_dirs(a: *A.Allocator, output_root: str, staging_root: str, outputs: *Vector[StepPath]) err[fail.Fail] {
    var oi: usize = 0;
    for (oi < outputs.len) {
        val sp: *StepPath = ?outputs.data[oi];
        if (str_equals(sp.root, output_root)) {
            val dir_r: res[str, A.Error] = types_path.parent(a, sp.rel);
            if (sel dir_r.err) { ret err[fail.Fail].err{fail.refused(dir_r.err)}; }
            val rel_dir: str            = dir_r.ok;
            val make_r:  err[fail.Fail] = step_walk.directory_ensure(a, staging_root, rel_dir, "build step staging output directory");
            str_free(a, rel_dir);
            if (sel make_r.err) { ret err[fail.Fail].err{make_r.err}; }
        }
        oi = oi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun step_paths_staged_absolute(a: *A.Allocator, output_root: str, staging_root: str, outputs: *Vector[StepPath], out: *Vector[str]) err[fail.Fail] {
    var i: usize = 0;
    for (i < outputs.len) {
        val sp: *StepPath = ?outputs.data[i];
        if (str_equals(sp.root, output_root)) {
            val abs_r: res[str, A.Error] = types_path.resolve(a, staging_root, sp.rel);
            if (sel abs_r.err) { ret err[fail.Fail].err{fail.refused(abs_r.err)}; }
            val joined:  str               = abs_r.ok;
            val clean_r: res[str, A.Error] = types_path.clean(a, joined);
            str_free(a, joined);
            if (sel clean_r.err) { ret err[fail.Fail].err{fail.refused(clean_r.err)}; }
            val abs:    str                 = clean_r.ok;
            val push_r: res[usize, A.Error] = collections_vector.push[str](out, abs);
            if (sel push_r.err) {
                str_free(a, abs);
                ret err[fail.Fail].err{fail.refused(push_r.err)};
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun publish_staged_outputs(a: *A.Allocator, staging_root: str, output_root: str, outputs: *Vector[StepPath]) err[fail.Fail] {
    var i: usize = 0;
    for (i < outputs.len) {
        val sp: *StepPath = ?outputs.data[i];
        if (str_equals(sp.root, output_root)) {
            val staged_r: res[str, A.Error] = types_path.resolve(a, staging_root, sp.rel);
            if (sel staged_r.err) { ret err[fail.Fail].err{fail.refused(staged_r.err)}; }
            val staged: str                 = staged_r.ok;
            val rn:     err[io_error.Error] = fs.rename(staged, sp.abs);
            str_free(a, staged);
            if (sel rn.err) {
                ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_PUBLISH, "failed to publish build step output '{}': {}", sp.abs, fail.io_text(rn.err))};
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun run_one_step(a: *A.Allocator, p: *project.Project, step: *manifest.StepDef, project_root: str, home_out: str, owner_id: str) err[fail.Fail] {
    val execution_root: str             = project_root;
    var v:              template.Values = driver_closure.owner_tmpl_vars(p, owner_id);
    val step_name:      str             = intern.text(?p.s.interner, step.name);
    val root_project:   str             = intern.text(?p.s.interner, p.config.home_root);
    val root_out:       str             = intern.text(?p.s.interner, p.config.project_work);

    val output_root_r: res[str, A.Error] = types_path.resolve(a, execution_root, home_out);
    if (sel output_root_r.err) { ret err[fail.Fail].err{fail.refused(output_root_r.err)}; }
    val output_root: str = output_root_r.ok;
    fin { str_free(a, output_root); }

    var ins: collections_vector.Vector[str] = collections_vector.init[str](a);
    fin { step_free_inputs(a, ?ins); }
    val cir: err[fail.Fail] = collect_step_inputs(a, p, step, execution_root, output_root, ?ins);
    if (sel cir.err) { ret cir; }

    val invocation_r: res[StepInvocation, fail.Fail] = expand_step_invocation(a, p, step, home_out, ?v);
    if (sel invocation_r.err) { ret err[fail.Fail].err{invocation_r.err}; }
    var invocation: StepInvocation = invocation_r.ok;
    fin { step_invocation_free(a, ?invocation); }

    val program_r: res[str, fail.Fail] = resolve_step_program(a, execution_root, ?invocation);
    if (sel program_r.err) { ret err[fail.Fail].err{program_r.err}; }
    val program: str = program_r.ok;
    fin { str_free(a, program); }

    var outputs: Vector[StepPath] = collections_vector.init[StepPath](a);
    fin { step_paths_free(a, ?outputs); }
    val outputs_r: err[fail.Fail] = collect_step_outputs(a, p, step, execution_root, output_root, ?outputs);
    if (sel outputs_r.err) { ret outputs_r; }
    val output_root_dir_r: err[fail.Fail] = step_walk.directory_ensure(a, root_project, root_out, "project output directory");
    if (sel output_root_dir_r.err) { ret output_root_dir_r; }
    val mdr: err[fail.Fail] = step_make_output_dirs(a, ?outputs);
    if (sel mdr.err) { ret mdr; }

    var output_paths: Vector[str] = collections_vector.init[str](a);
    fin { step_free_inputs(a, ?output_paths); }
    val output_paths_r: err[fail.Fail] = step_paths_absolute(a, ?outputs, ?output_paths);
    if (sel output_paths_r.err) { ret output_paths_r; }

    val prerequisites_r: res[StepStrings, fail.Fail] = expand_step_strings(a, p, step.need, step.need_at, step.need_count, home_out, ?v);
    if (sel prerequisites_r.err) { ret err[fail.Fail].err{prerequisites_r.err}; }
    var prerequisites: StepStrings = prerequisites_r.ok;
    fin { step_strings_free(a, ?prerequisites); }

    var digest: [32]u8;
    val fpr:    err[fail.Fail] = step_fingerprint(a, v.target, v.profile, program, ?invocation.argv, ?invocation.env, ?prerequisites, ?ins, ?output_paths, ?digest[0]);
    if (sel fpr.err) { ret fpr; }

    val keyed: err[fail.Fail] = cache_key.step(?p.step_digest, owner_id, step_name, ?digest);
    if (sel keyed.err) { ret keyed; }

    val stamp_path_r: res[str, fail.Fail] = step_stamp_path(a, root_project, root_out, owner_id, step_name);
    if (sel stamp_path_r.err) { ret err[fail.Fail].err{stamp_path_r.err}; }
    val stamp_path: str = stamp_path_r.ok;
    fin { str_free(a, stamp_path); }
    val hex_r: res[str, fail.Fail] = digest_hex(a, ?digest[0], 32::usize);
    if (sel hex_r.err) { ret err[fail.Fail].err{hex_r.err}; }
    val hex: str = hex_r.ok;
    fin { str_free(a, hex); }

    var current_r: res[bool, fail.Fail] = res[bool, fail.Fail].ok{false};
    if (!p.req.no_cache && step.out_count > 0) {
        current_r = stamp_matches(a, stamp_path, hex);
        if (sel current_r.ok && current_r.ok) { current_r = step_final_outputs_current(a, ?outputs); }
    }
    if (sel current_r.err)                { ret err[fail.Fail].err{current_r.err}; }
    if (sel current_r.ok && current_r.ok) { ret err[fail.Fail].ok{}; }

    val staging_root_r: res[str, fail.Fail] = step_staging_root(a, output_root, step_name);
    if (sel staging_root_r.err) { ret err[fail.Fail].err{staging_root_r.err}; }
    val staging_root: str = staging_root_r.ok;
    fin { str_free(a, staging_root); }
    val staging_home_out_r: res[str, fail.Fail] = step_staging_root(a, home_out, step_name);
    if (sel staging_home_out_r.err) { ret err[fail.Fail].err{staging_home_out_r.err}; }
    val staging_home_out: str = staging_home_out_r.ok;
    fin { str_free(a, staging_home_out); }

    val prep_r: err[fail.Fail] = step_prepare_staging(a, output_root, staging_root, step_name);
    if (sel prep_r.err) { ret prep_r; }
    val staging_dirs_r: err[fail.Fail] = step_make_staging_dirs(a, output_root, staging_root, ?outputs);
    if (sel staging_dirs_r.err) { ret staging_dirs_r; }

    val staging_invocation_r: res[StepInvocation, fail.Fail] = expand_step_invocation(a, p, step, staging_home_out, ?v);
    if (sel staging_invocation_r.err) { ret err[fail.Fail].err{staging_invocation_r.err}; }
    var staging_invocation: StepInvocation = staging_invocation_r.ok;
    fin { step_invocation_free(a, ?staging_invocation); }

    val started: readout.Instant = readout.item_begin(p.progress);

    val obj_tree_r: res[str, fail.Fail] = config.module_obj_tree(a, output_root, owner_id);
    if (sel obj_tree_r.err) { ret err[fail.Fail].err{obj_tree_r.err}; }
    val obj_tree: str = obj_tree_r.ok;
    fin { str_free(a, obj_tree); }
    var obj_before: Vector[TreeFile] = collections_vector.init[TreeFile](a);
    fin { free_tree_files(a, ?obj_before); }
    val snapshot_r: err[fail.Fail] = collect_tree_files(a, obj_tree, ?obj_before);
    if (sel snapshot_r.err) { ret snapshot_r; }

    var staging_before: Vector[TreeFile] = collections_vector.init[TreeFile](a);
    fin { free_tree_files(a, ?staging_before); }
    val staging_snapshot_r: err[fail.Fail] = collect_tree_files(a, staging_root, ?staging_before);
    if (sel staging_snapshot_r.err) { ret staging_snapshot_r; }

    val res_run: err[fail.Fail] = execute_step_invocation(a, execution_root, program, ?staging_invocation,
        step_name, step.timeout);

    val object_integrity: err[fail.Fail] = check_step_left_obj_tree(a, ?obj_before, obj_tree, step_name);

    var staging_declared: Vector[str] = collections_vector.init[str](a);
    fin { step_free_inputs(a, ?staging_declared); }
    var staging_declared_abs: Vector[str] = collections_vector.init[str](a);
    fin { step_free_inputs(a, ?staging_declared_abs); }
    var output_integrity: err[fail.Fail] = step_paths_rel_for_root(a, ?outputs, output_root, ?staging_declared);
    val staged_ok:        bool           = sel output_integrity.ok;
    if (staged_ok) { output_integrity = step_paths_staged_absolute(a, output_root, staging_root, ?outputs, ?staging_declared_abs); }
    val effects_ok: bool = sel output_integrity.ok;
    if (effects_ok) {
        output_integrity = check_step_output_effects(a, ?staging_before, staging_root, ?staging_declared_abs, step_name);
        if (sel res_run.ok) {
            var declared_exec: Vector[str] = collections_vector.init[str](a);
            fin { step_free_inputs(a, ?declared_exec); }
            var declared_r:    err[fail.Fail] = step_paths_rel_for_root(a, ?outputs, execution_root, ?declared_exec);
            val exec_declared: bool           = sel declared_r.ok && declared_exec.len > 0;
            if (exec_declared) { declared_r = validate_declared_step_outputs(a, execution_root, ?declared_exec, step_name); }
            val staging_declared_ok: bool = sel declared_r.ok && staging_declared.len > 0;
            if (staging_declared_ok) { declared_r = validate_declared_step_outputs(a, staging_root, ?staging_declared, step_name); }
            if (sel declared_r.err) {
                var combined: err[fail.Fail] = declared_r;
                if (sel output_integrity.err) {
                    combined = err[fail.Fail].err{fail.formatted_user(a, fail.kind_of(output_integrity.err), "{}; declared output integrity: {}", fail.describe(output_integrity.err), fail.describe(declared_r.err))};
                }
                output_integrity = combined;
            }
        }
    }

    val finished: err[fail.Fail] = combine_step_terminal_results(a, object_integrity, output_integrity, res_run);
    if (sel finished.err) {
        val cleared: err[fs.FsError] = fs.remove_all(a, staging_root);
        if (sel cleared.err) { ret err[fail.Fail].err{fail.with_secondary(a, finished.err, staging_left(a, staging_root, cleared.err))}; }
        ret finished;
    }

    val publish_r: err[fail.Fail] = publish_staged_outputs(a, staging_root, output_root, ?outputs);
    if (sel publish_r.err) { ret publish_r; }
    # the outputs are published, and the next run of the step clears a staging root left here before it stages
    fs.remove_all(a, staging_root);

    var stamped: err[fail.Fail] = err[fail.Fail].ok{};
    if (!p.req.no_cache && step.out_count > 0) {
        val written: err[fail.Fail] = write_stamp(a, root_project, root_out, stamp_path, hex);
        if (sel written.err) {
            stamped = err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_CACHE_RECORD, "build step '{}' completed but its cache record could not be published: {}", step_name, fail.describe(written.err))};
        }
    }

    if (sel stamped.ok) { readout.item(p.progress, readout.STEPS, step_name, started); }
    ret stamped;
}

# run the declaring project's prerequisite steps for the configured cell, in its
# own directory. a dependency's cell runs them as a dependency step runs, homed
# in the root's output tree through an absolute `{project.work}`
pub fun run(a: *A.Allocator, p: *project.Project) err[fail.Fail] {
    if (p.config.step_order_count == 0) { ret err[fail.Fail].ok{}; }
    val abs_root_r: res[str, fail.Fail] = absolute_execution_root(a, intern.text(?p.s.interner, p.config.project_root));
    if (sel abs_root_r.err) { ret err[fail.Fail].err{abs_root_r.err}; }
    val abs_root: str = abs_root_r.ok;
    fin { str_free(a, abs_root); }
    var home_out:  str  = intern.text(?p.s.interner, p.config.project_work);
    var home_held: bool = false;
    val owner_id:  str  = intern.text(?p.s.interner, p.config.id);
    if (p.config.dependency_owned) {
        val hr: res[str, fail.Fail] = dependency_out_home(a, intern.text(?p.s.interner, p.config.home_root), home_out);
        if (sel hr.err) { ret err[fail.Fail].err{hr.err}; }
        home_out  = hr.ok;
        home_held = true;
    }
    fin {
        if (home_held) { str_free(a, home_out); }
    }
    readout.phase_begin(p.progress, readout.STEPS);
    var i: u32 = 0;
    for (i < p.config.step_order_count) {
        val idx:       u32            = p.config.step_order[i];
        val outcome_r: err[fail.Fail] = run_one_step(a, p, ?p.config.steps[idx], abs_root, home_out, owner_id);
        if (sel outcome_r.err) { ret outcome_r; }
        i = i + 1;
    }
    readout.phase_end(p.progress, readout.STEPS, p.config.step_order_count, "step", "steps");
    ret err[fail.Fail].ok{};
}

fun dep_resolve_relative_root(alloc: *A.Allocator, cwd: str, rel: str) res[str, fail.Fail] {
    val cwd_len: usize             = str_len(cwd);
    val rel_len: usize             = str_len(rel);
    val cap:     usize             = cwd_len + rel_len + 2;
    val rb:      res[*u8, A.Error] = A.allocate[u8](alloc, cap);
    if (sel rb.err) { ret res[str, fail.Fail].err{fail.refused(rb.err)}; }
    val buf: *u8 = rb.ok;
    fin { A.deallocate[u8](alloc, buf, cap); }

    var k: usize = 0;
    for (k < cwd_len) {
        buf[k] = cwd[k];
        k      = k + 1;
    }

    var i: usize = 0;
    for (i < rel_len) {
        for (i < rel_len && types_path.is_separator(rel[i])) { i = i + 1; }
        if (i >= rel_len) { brk; }
        val start: usize = i;
        for (i < rel_len && !types_path.is_separator(rel[i])) { i = i + 1; }
        val len: usize = i - start;

        if (len == 1 && rel[start] == '.'::u8) { cnt; }
        if (len == 2 && rel[start] == '.'::u8 && rel[start + 1] == '.'::u8) {
            buf[k] = 0;
            val parent_r: res[str, A.Error] = types_path.parent(alloc, buf::str);
            if (sel parent_r.err) { ret res[str, fail.Fail].err{fail.refused(parent_r.err)}; }
            val parent:     str   = parent_r.ok;
            val parent_len: usize = str_len(parent);
            k = 0;
            for (k < parent_len) {
                buf[k] = parent[k];
                k      = k + 1;
            }
            str_free(alloc, parent);
            cnt;
        }

        if (k > 0 && !types_path.is_separator(buf[k - 1])) {
            buf[k] = types_path.separator();
            k      = k + 1;
        }
        var j: usize = 0;
        for (j < len) {
            buf[k] = rel[start + j];
            k      = k + 1;
            j      = j + 1;
        }
    }
    buf[k] = 0;

    val out_r: res[str, types_string.StrError] = str_copy_slice(alloc, buf::str, 0, k);
    if (sel out_r.err) { ret res[str, fail.Fail].err{fail.message(fail.str_text(out_r.err))}; }
    ret res[str, fail.Fail].ok{out_r.ok};
}

fun dependency_out_home(alloc: *A.Allocator, project_root: str, root_out: str) res[str, fail.Fail] {
    if (types_path.is_abs(project_root)) {
        val resolve_r: res[types_path.Path, A.Error] = types_path.resolve(alloc, project_root, root_out);
        if (sel resolve_r.err) { ret res[str, fail.Fail].err{fail.refused(resolve_r.err)}; }
        ret res[str, fail.Fail].ok{resolve_r.ok};
    }

    val cwd_r: res[types_string.OwnedString, env.EnvError] = env.current_dir(alloc);
    if (sel cwd_r.err) { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.FS_CURRENT_DIR, fail.env_text(cwd_r.err))}; }
    var cwd: types_string.OwnedString = cwd_r.ok;

    val root_r: res[str, fail.Fail] = dep_resolve_relative_root(alloc, cwd.data, project_root);
    types_string.owned_release(?cwd);
    if (sel root_r.err) { ret res[str, fail.Fail].err{root_r.err}; }
    val root: str = root_r.ok;

    val out_r: res[str, A.Error] = types_path.resolve(alloc, root, root_out);
    str_free(alloc, root);
    if (sel out_r.err) { ret res[str, fail.Fail].err{fail.refused(out_r.err)}; }
    ret res[str, fail.Fail].ok{out_r.ok};
}

# one exported dependency step selected for a cell, by position in the closure
# ---
# dependency: index into `p.config.deps`
# step:       index into that dependency manifest's `steps`
pub rec Dependency {
    dependency: u32;
    step:       u32;
}

# the exported dependency steps a cell runs, in execution order: each realized
# dependency's export step plan for the cell target, dependencies in closure
# order. shared by `dependency_run` and the build plan display
# ---
# p: the configured project
# isa, os, abi: the cell target tuple
# ret: the ordered steps, owned by the caller; err from the export plan
pub fun dependency_plan(p: *project.Project, isa: intern.StrId, os: intern.StrId, abi: intern.StrId) res[Vector[Dependency], fail.Fail] {
    var steps:    Vector[Dependency] = collections_vector.init[Dependency](p.alloc);
    var retained: bool               = false;
    fin {
        if (!retained) { collections_vector.dnit[Dependency](?steps); }
    }
    val n: u32 = p.config.dep_count;
    if (n == 0) {
        retained = true;
        ret res[Vector[Dependency], fail.Fail].ok{steps};
    }

    var tgt: manifest.TargetDef;
    tgt.arch = isa;
    tgt.sys  = os;
    tgt.abi  = abi;

    val root_out: str             = intern.text(?p.s.interner, p.config.project_work);
    var cv:       template.Values = driver_closure.cell_tmpl_vars(p);
    var i:        u32             = 0;
    for (i < n) {
        val mfd:     *manifest.Manifest = ?p.config.deps[i].manifest;
        var order:   *u32               = nil;
        var count:   u32                = 0;
        val planned: err[fail.Fail]     = manifest.plan_export_steps(p.alloc, ?p.s.interner, mfd, ?tgt, root_out, ?cv, ?order, ?count);
        if (sel planned.err) { ret res[Vector[Dependency], fail.Fail].err{planned.err}; }
        fin {
            if (order != nil && count > 0) { A.deallocate[u32](p.alloc, order, count::usize); }
        }
        var si: u32 = 0;
        for (si < count) {
            val pushed: res[usize, A.Error] = collections_vector.push[Dependency](?steps, Dependency{dependency: i, step: order[si]});
            if (sel pushed.err) { ret res[Vector[Dependency], fail.Fail].err{fail.refused(pushed.err)}; }
            si = si + 1;
        }
        i = i + 1;
    }
    retained = true;
    ret res[Vector[Dependency], fail.Fail].ok{steps};
}

pub fun dependency_run(p: *project.Project, isa: intern.StrId, os: intern.StrId, abi: intern.StrId) err[fail.Fail] {
    val planned: res[Vector[Dependency], fail.Fail] = dependency_plan(p, isa, os, abi);
    if (sel planned.err) { ret err[fail.Fail].err{planned.err}; }
    var steps: Vector[Dependency] = planned.ok;
    fin { collections_vector.dnit[Dependency](?steps); }
    if (steps.len == 0) { ret err[fail.Fail].ok{}; }

    val root_out:     str                 = intern.text(?p.s.interner, p.config.project_work);
    val root_project: str                 = intern.text(?p.s.interner, p.config.home_root);
    val hr:           res[str, fail.Fail] = dependency_out_home(p.alloc, root_project, root_out);
    if (sel hr.err) { ret err[fail.Fail].err{hr.err}; }
    val dep_home: str = hr.ok;
    fin { str_free(p.alloc, dep_home); }

    readout.phase_begin(p.progress, readout.STEPS);
    var i: usize = 0;
    for (i < steps.len) {
        val selected:    Dependency          = steps.data[i];
        val mfd:         *manifest.Manifest  = ?p.config.deps[selected.dependency].manifest;
        val vendor_root: str                 = intern.text(?p.s.interner, p.config.deps[selected.dependency].vendor_root);
        val dep_owner:   str                 = intern.text(?p.s.interner, mfd.id);
        val dep_abs_r:   res[str, fail.Fail] = absolute_execution_root(p.alloc, vendor_root);
        if (sel dep_abs_r.err) { ret err[fail.Fail].err{dep_abs_r.err}; }
        val dep_abs: str            = dep_abs_r.ok;
        val rs:      err[fail.Fail] = run_one_step(p.alloc, p, ?mfd.steps[selected.step], dep_abs, dep_home, dep_owner);
        str_free(p.alloc, dep_abs);
        if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
        i = i + 1;
    }
    readout.phase_end(p.progress, readout.STEPS, steps.len::u32, "step", "steps");
    ret err[fail.Fail].ok{};
}
