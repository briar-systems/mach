# supervised child processes
#
# an OwnedSubprocess owns one child from spawn to reap. it moves through
# STATE_UNSTARTED, then STATE_RUNNING or STATE_SPAWN_FAILURE, then
# STATE_EXITED or STATE_SIGNALED as the terminal is observed, and ends in
# STATE_REAPED. each step happens at most once: an owner spawns once, observes
# one terminal and reaps once, so a child is never waited on twice and a pid
# is never reused under a stale owner. wait, wait_any, timeout and cancel are
# the ways to reach the terminal. a capture, when the spawn asked for one, is
# a file the child writes and the owner reads back after the child is done.

use A:               std.allocator;
use T:               std.allocator.testing;
use chrono_duration: std.chrono.duration;
use std.chrono.time;
use fs:         std.filesystem;
use std_format: std.format;
use std.process.events;
use std.process.exec;
use std.runtime.native.view.NativeName;
use std.runtime.native.view.Unit;
use sync_cancel: std.sync.cancel;
use system_os:   std.system.os;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;

use lang_alloc:      mach.lang.alloc;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.host;
use io_error:  std.io.error;
use io_handle: std.io.handle;

# where an owner is in its lifecycle
def SubprocessState: u8;

# fresh from init, nothing spawned
pub val STATE_UNSTARTED: SubprocessState = 0;

# the one spawn attempt started no child
pub val STATE_SPAWN_FAILURE: SubprocessState = 1;

# a child is running and not yet reaped
val STATE_RUNNING: SubprocessState = 2;

# the child exited with a code, and as a terminal kind, ended that way
pub val STATE_EXITED: SubprocessState = 3;

# the child was ended by a signal, and as a terminal kind, ended that way
pub val STATE_SIGNALED: SubprocessState = 4;

# the terminal was observed and the child reaped, so the owner is done
val STATE_REAPED: SubprocessState = 7;

# the termination a supervisor asked for, mirrored from the cancellation
# scope's reason, so the codes are the scope's 1.x reason codes and never change
pub def Request: u8;

# no termination was asked for
val REQUEST_ACTIVE: Request = 0;

# the supervisor cancelled the child
val REQUEST_CANCELLED: Request = 1;

# the child outlived its deadline
val REQUEST_TIMED_OUT: Request = 2;

# the cancellation scope was destroyed
val REQUEST_DESTROYED: Request = 3;

# the scope reported a reason this module does not know
val REQUEST_INVALID: Request = 4;

fun request_of(reason: sync_cancel.Reason) Request {
    if (sel reason.active)    { ret REQUEST_ACTIVE; }
    if (sel reason.cancelled) { ret REQUEST_CANCELLED; }
    if (sel reason.timed_out) { ret REQUEST_TIMED_OUT; }
    if (sel reason.destroyed) { ret REQUEST_DESTROYED; }
    ret REQUEST_INVALID;
}

# a supervised process's refusal, named with the identity the supervisor
# knows it by (its pathname, or "subprocess" before one is recorded): the
# allocator's, the process layer's, a capture file's, or a lifecycle the
# caller drove out of order
tag Cause: u8 {
    alloc:  A.Error;
    exec:   exec.Error;
    io:     io_error.Error;
    native: i64;
    attempted;
    idle;
    not_running;
    invalid_status;
    transition;
    request;
    incomplete;
    capture_released;
    capture_running;
    capture_unfinished;
    capture_release;
    termination;
    reap;
    grace_negative;
    grace_large;
    deadline_done;
    deadline_invalid;
}

# a refusal of this module
# ---
# identity: the pathname of the child, or "subprocess" before one is known,
#           borrowed from the owner or the caller
# cause:    what refused
pub rec Error {
    identity: str;
    cause:    Cause;
}

# the refusal `cause`, named by `identity`
pub fun failure(identity: str, cause: Cause) Error {
    ret Error{identity: identity, cause: cause};
}

# the text of what refused, static
pub fun cause_text(c: Cause) str {
    if (sel c.alloc)              { ret lang_alloc.text(c.alloc); }
    or (sel c.exec)               { ret exec.error_message(c.exec); }
    or (sel c.io)                 { ret system_os.message(c.io); }
    or (sel c.native)             { ret system_os.error_message(c.native); }
    or (sel c.attempted)          { ret "subprocess spawn already attempted"; }
    or (sel c.idle)               { ret "no owned subprocess is running"; }
    or (sel c.not_running)        { ret "subprocess is not running"; }
    or (sel c.invalid_status)     { ret "invalid subprocess terminal status"; }
    or (sel c.transition)         { ret "invalid subprocess terminal transition"; }
    or (sel c.request)            { ret "invalid subprocess termination request"; }
    or (sel c.incomplete)         { ret "subprocess lifecycle capability is incomplete"; }
    or (sel c.capture_released)   { ret "subprocess capture already released"; }
    or (sel c.capture_running)    { ret "subprocess capture cannot finish while the child is running"; }
    or (sel c.capture_unfinished) { ret "subprocess capture must finish before it can be released"; }
    or (sel c.capture_release)    { ret "capture deallocation failed"; }
    or (sel c.termination)        { ret "subprocess termination failed"; }
    or (sel c.reap)               { ret "subprocess reap failed"; }
    or (sel c.grace_negative)     { ret "subprocess termination grace cannot be negative"; }
    or (sel c.grace_large)        { ret "subprocess termination grace is too large"; }
    or (sel c.deadline_done)      { ret "subprocess deadline set on an owner that is done"; }
    ret "subprocess deadline must lie a positive time ahead";
}

# the machine's refusal `e` as an environment failure under `k`, its text
# "identity: cause" owned by `a`; a refusal to format the text is the failure
# instead
pub fun refusal(a: *A.Allocator, k: diagnostic_kind.Kind, e: Error) fail.Fail {
    val made: res[str, fail.Fail] = fail.format(a, "{}: {}", e.identity, cause_text(e.cause));
    if (sel made.err) { ret made.err; }
    ret fail.environment(k, made.ok);
}

# how a child ended
# ---
# kind: STATE_EXITED or STATE_SIGNALED once observed, else the owner's state
# code: the exit code, or the signal number
pub rec SubprocessTerminal {
    kind: SubprocessState;
    code: i32;
}

# what happened to a capture file
# ---
# bytes:        captured bytes read back and kept
# truncated:    the child wrote more than the capture limit
# short_read:   the read back ended before the bytes the file held
# read_failed:  the read back failed, or the capture was abandoned
# write_failed: the capture file could not be opened
# close_failed: closing the capture file failed
# closed:       the capture file is closed
# owned:        the owner still holds the captured bytes
pub rec CaptureIoResult {
    bytes:        usize;
    truncated:    bool;
    short_read:   bool;
    read_failed:  bool;
    write_failed: bool;
    close_failed: bool;
    closed:       bool;
    owned:        bool;
}

rec OwnedCapture {
    file:     fs.File;
    identity: *u8;
    buffer:   *u8;
    capacity: usize;
    limit:    usize;
    result:   CaptureIoResult;
    finished: bool;
    released: bool;
}

# the owner of one supervised child, made by init and released by dnit
# ---
# child:           the child's handle while it runs
# state:           where the owner is in its lifecycle (see STATE_UNSTARTED)
# terminal:        how the child ended, once observed
# requested:       the termination a supervisor asked for
# capture:         the capture file and what was read back from it
# has_capture:     the spawn asked for a capture
# spawn_attempted: spawn has run, so it cannot run again
# reap_count:      times the child was reaped, never more than one
# pathname:        the owned copy of the child's pathname, naming its errors
# has_deadline:    bound set a deadline
# deadline:        the instant wait_any times the child out
# timeout:         the bound the deadline came from
pub rec OwnedSubprocess {
    child:           exec.Child;
    state:           SubprocessState;
    terminal:        SubprocessTerminal;
    requested:       Request;
    capture:         OwnedCapture;
    has_capture:     bool;
    spawn_attempted: bool;
    reap_count:      u8;
    pathname:        *u8;
    has_deadline:    bool;
    deadline:        time.Instant;
    timeout:         chrono_duration.Duration;
}

fun dup_cstr(a: *A.Allocator, s: *u8) res[*u8, Error] {
    val r: res[str, A.Error] = str_dup(a, s::str);
    if (sel r.err) { ret res[*u8, Error].err{failure(s::str, Cause.alloc{r.err})}; }
    ret res[*u8, Error].ok{r.ok::*u8};
}

fun free_cstr(a: *A.Allocator, s: *u8) {
    str_free(a, s::str);
}

fun cstr_count(list: **u8) usize {
    var n: usize = 0;
    for (list[n] != nil) { n = n + 1; }
    ret n;
}

# release a nil-terminated list of strings; a nil list owns nothing
fun free_cstr_list(a: *A.Allocator, list: **u8) {
    if (list == nil) { ret; }
    var n: usize = 0;
    for (list[n] != nil) {
        free_cstr(a, list[n]);
        n = n + 1;
    }
    A.deallocate[*u8](a, list, n + 1);
}

fun dup_cstr_list(a: *A.Allocator, list: **u8) res[**u8, Error] {
    val n:  usize              = cstr_count(list);
    val ar: res[**u8, A.Error] = A.allocate[*u8](a, n + 1);
    if (sel ar.err) { ret res[**u8, Error].err{failure("subprocess", Cause.alloc{ar.err})}; }
    val out: **u8  = ar.ok;
    var i:   usize = 0;
    for (i < n) {
        val dr: res[*u8, Error] = dup_cstr(a, list[i]);
        if (sel dr.err) {
            var j: usize = 0;
            for (j < i) {
                free_cstr(a, out[j]);
                j = j + 1;
            }
            A.deallocate[*u8](a, out, n + 1);
            ret res[**u8, Error].err{dr.err};
        }
        out[i] = dr.ok;
        i      = i + 1;
    }
    out[n] = nil;
    ret res[**u8, Error].ok{out};
}

rec SpawnCopy {
    pathname: *u8;
    argv:     **u8;
    envp:     exec.Environment;
}

fun spawn_copy_free_request(a: *A.Allocator, c: *SpawnCopy) {
    free_cstr_list(a, c.argv);
    if (sel c.envp.given) { free_cstr_list(a, c.envp.given); }
    c.argv = nil;
    c.envp = exec.Environment.inherit{};
}

# a given environment is copied entry by entry. a nil one stays nil for the
# spawn to refuse, and inherit carries nothing to copy
fun prepare_spawn_copy(a: *A.Allocator, pathname: str, argv: **u8, envp: exec.Environment) res[SpawnCopy, Error] {
    var c:  SpawnCopy       = SpawnCopy{pathname: nil, argv: nil, envp: envp};
    val pr: res[*u8, Error] = dup_cstr(a, pathname::*u8);
    if (sel pr.err) { ret res[SpawnCopy, Error].err{pr.err}; }
    c.pathname = pr.ok;
    var handed: bool = false;
    fin {
        if (!handed) { free_cstr(a, c.pathname); }
    }
    val ar: res[**u8, Error] = dup_cstr_list(a, argv);
    if (sel ar.err) { ret res[SpawnCopy, Error].err{ar.err}; }
    c.argv = ar.ok;
    fin {
        if (!handed) { free_cstr_list(a, c.argv); }
    }
    if (sel envp.given) {
        if (envp.given == nil) {
            handed = true;
            ret res[SpawnCopy, Error].ok{c};
        }
        val er: res[**u8, Error] = dup_cstr_list(a, envp.given);
        if (sel er.err) { ret res[SpawnCopy, Error].err{er.err}; }
        c.envp = exec.Environment.given{er.ok};
    }
    handed = true;
    ret res[SpawnCopy, Error].ok{c};
}

fun owner_identity(p: *OwnedSubprocess) str {
    if (p.pathname == nil) { ret "subprocess"; }
    ret p.pathname::str;
}

fun empty_capture(limit: usize) OwnedCapture {
    ret OwnedCapture{
        file:     fs.File{handle: io_handle.invalid_file()},
        identity: nil,
        buffer:   nil,
        capacity: 0,
        limit:    limit,
        result:   CaptureIoResult{
            bytes:        0,
            truncated:    false,
            short_read:   false,
            read_failed:  false,
            write_failed: false,
            close_failed: false,
            closed:       true,
            owned:        true,
        },
        finished: false,
        released: false,
    };
}

# make `p` a fresh owner with nothing spawned
pub fun init(p: *OwnedSubprocess) {
    p.child.pid       = 0;
    p.state           = STATE_UNSTARTED;
    p.terminal        = SubprocessTerminal{kind: STATE_UNSTARTED, code: 0};
    p.requested       = REQUEST_ACTIVE;
    p.capture         = empty_capture(0);
    p.has_capture     = false;
    p.spawn_attempted = false;
    p.reap_count      = 0;
    p.pathname        = nil;
    p.has_deadline    = false;
    p.deadline        = time.Instant{sec: 0, nsec: 0};
    p.timeout         = 0;
}

fun set_deadline(p: *OwnedSubprocess, deadline: time.Instant) err[Cause] {
    if (p.state != STATE_UNSTARTED && p.state != STATE_RUNNING)               { ret err[Cause].err{Cause.deadline_done{}}; }
    if (deadline.sec < 0 || deadline.nsec < 0 || deadline.nsec >= 1000000000) { ret err[Cause].err{Cause.deadline_invalid{}}; }
    p.has_deadline = true;
    p.deadline     = deadline;
    ret err[Cause].ok{};
}

# give `p` a deadline `timeout` from now, which wait_any enforces
# ---
# ret: nothing, or the refusal when the timeout is not positive, the clock
#      fails, or the owner is done
pub fun bound(p: *OwnedSubprocess, timeout: chrono_duration.Duration) err[Error] {
    if (timeout < 1) { ret err[Error].err{failure(owner_identity(p), Cause.deadline_invalid{})}; }
    val now: time.InstantClock = time.instant();
    if (sel now.err) { ret err[Error].err{failure(owner_identity(p), Cause.io{now.err})}; }
    val set: err[Cause] = set_deadline(p, time.instant_add(now.ok, timeout));
    if (sel set.err) { ret err[Error].err{failure(owner_identity(p), set.err)}; }
    p.timeout = timeout;
    ret err[Error].ok{};
}

fun deadline_reached(p: *OwnedSubprocess, now: time.Instant) bool {
    if (!p.has_deadline) { ret false; }
    ret !time.instant_before(now, p.deadline);
}

# whether the child was terminated for outliving its deadline
pub fun expired(p: *OwnedSubprocess) bool {
    ret p.requested == REQUEST_TIMED_OUT;
}

# release what `p` owns: its pathname, and its capture file and identity. a
# second call releases nothing. it does not reap a running child
pub fun dnit(a: *A.Allocator, p: *OwnedSubprocess) {
    free_cstr(a, p.pathname);
    p.pathname = nil;
    if (p.capture.identity != nil) {
        close_capture(?p.capture);
        free_cstr(a, p.capture.identity);
        p.capture.identity = nil;
    }
}

fun observe_spawn(p: *OwnedSubprocess, child: exec.Child) {
    p.child           = child;
    p.state           = STATE_RUNNING;
    p.terminal        = SubprocessTerminal{kind: STATE_RUNNING, code: 0};
    p.requested       = REQUEST_ACTIVE;
    p.spawn_attempted = true;
    p.reap_count      = 0;
}

fun observe_spawn_failure(p: *OwnedSubprocess) {
    p.state    = STATE_SPAWN_FAILURE;
    p.terminal = SubprocessTerminal{kind: STATE_SPAWN_FAILURE, code: 0};
}

fun begin_spawn(p: *OwnedSubprocess) err[Cause] {
    if (p.spawn_attempted || p.state != STATE_UNSTARTED) { ret err[Cause].err{Cause.attempted{}}; }
    p.spawn_attempted = true;
    ret err[Cause].ok{};
}

fun observe_terminal(p: *OwnedSubprocess, kind: SubprocessState, code: i32) err[Cause] {
    if (p.state != STATE_RUNNING)                       { ret err[Cause].err{Cause.transition{}}; }
    if (kind != STATE_EXITED && kind != STATE_SIGNALED) { ret err[Cause].err{Cause.transition{}}; }
    p.state    = kind;
    p.terminal = SubprocessTerminal{kind: kind, code: code};
    ret err[Cause].ok{};
}

fun close_capture(c: *OwnedCapture) {
    if (c.result.closed) { ret; }
    val close_r: err[io_error.Error] = fs.close(?c.file);
    if (sel close_r.err) { c.result.close_failed = true; }
    c.file          = fs.File{handle: io_handle.invalid_file()};
    c.result.closed = true;
}

fun mark_reaped(p: *OwnedSubprocess) err[Cause] {
    if (p.state != STATE_EXITED && p.state != STATE_SIGNALED) { ret err[Cause].err{Cause.transition{}}; }
    if (p.reap_count != 0)                                    { ret err[Cause].err{Cause.transition{}}; }
    p.reap_count = 1;
    p.state      = STATE_REAPED;
    ret err[Cause].ok{};
}

# the child reached its terminal `kind` with `code` and was reaped
fun observe_reaped(p: *OwnedSubprocess, kind: SubprocessState, code: i32) err[Error] {
    val ended: err[Cause] = observe_terminal(p, kind, code);
    if (sel ended.err) { ret err[Error].err{failure(owner_identity(p), ended.err)}; }
    val reaped: err[Cause] = mark_reaped(p);
    if (sel reaped.err) { ret err[Error].err{failure(owner_identity(p), reaped.err)}; }
    ret err[Error].ok{};
}

# how a wait status ended its child, or the refusal of a status that names no end
fun status_terminal(st: exec.ExitStatus) opt[SubprocessTerminal] {
    if (exec.signaled(st)) { ret opt[SubprocessTerminal].some{SubprocessTerminal{kind: STATE_SIGNALED, code: exec.signal(st)}}; }
    if (exec.exited(st))   { ret opt[SubprocessTerminal].some{SubprocessTerminal{kind: STATE_EXITED, code: exec.code(st)::i32}}; }
    ret opt[SubprocessTerminal].none{};
}

fun observe_status(p: *OwnedSubprocess, st: exec.ExitStatus) err[Error] {
    val ended: opt[SubprocessTerminal] = status_terminal(st);
    if (sel ended.none) { ret err[Error].err{failure(owner_identity(p), Cause.invalid_status{})}; }
    ret observe_reaped(p, ended.some.kind, ended.some.code);
}

# how spawn starts a child, spawn_options giving the defaults
# ---
# cwd:            directory the child starts in, or empty to inherit this
#                 process's
# stdin:          handle for the child's stdin, or system_os.INVALID_HANDLE to
#                 inherit
# grouped:        place the child as the leader of its own process group, so a
#                 termination reaches every descendant that stays in it
# capture:        path of a file, created or truncated, that receives the
#                 child's stdout, or empty to inherit stdout
# capture_stderr: send the child's stderr to the capture file too
# capture_limit:  the most captured bytes finish_capture keeps, and wait_any
#                 cancels a child whose capture grows past it
pub rec SpawnOptions {
    cwd:            str;
    stdin:          usize;
    grouped:        bool;
    capture:        str;
    capture_stderr: bool;
    capture_limit:  usize;
}

# the options of a plain spawn: this process's directory, its streams and its
# group, with nothing captured
pub fun spawn_options() SpawnOptions {
    ret SpawnOptions{
        cwd:            "",
        stdin:          system_os.INVALID_HANDLE,
        grouped:        false,
        capture:        "",
        capture_stderr: false,
        capture_limit:  0,
    };
}

# take ownership of the capture file the child's output goes to
fun capture_open(a: *A.Allocator, p: *OwnedSubprocess, pathname: str, options: SpawnOptions) err[Error] {
    val idr: res[*u8, Error] = dup_cstr(a, options.capture::*u8);
    if (sel idr.err) { ret err[Error].err{idr.err}; }
    p.capture          = empty_capture(options.capture_limit);
    p.capture.identity = idr.ok;
    p.has_capture      = true;

    var capture: usize = system_os.INVALID_HANDLE;
    val opened:  i64   = system_os.open(system_os.working_dir(), p.capture.identity::str,
        system_os.O_CREAT | system_os.O_TRUNC | system_os.O_RDWR, 420, ?capture);
    if (opened < 0) {
        p.capture.result.write_failed = true;
        ret err[Error].err{failure(pathname, Cause.native{opened})};
    }
    p.capture.file          = fs.File{handle: io_handle.FileHandle{value: capture}};
    p.capture.result.closed = false;
    ret err[Error].ok{};
}

# start a child under `p`, which must be fresh from init: an owner spawns at
# most once, even when the spawn fails
#
# the pathname, argv and envp are copied, so the caller's buffers may change
# as soon as this returns. the owner keeps the pathname to name the child in
# its errors. on failure the owner is in STATE_SPAWN_FAILURE and owns nothing.
# ---
# a:        allocator for the owner's copies, which dnit releases
# p:        the owner, from init
# pathname: path to the executable
# argv:     null-terminated argument array
# envp:     the child's environment, given entries or this process's inherited
# options:  directory, stdin, grouping and capture (see SpawnOptions)
# ret:      nothing, or the refusal named by the pathname
pub fun spawn(a: *A.Allocator, p: *OwnedSubprocess, pathname: str, argv: **u8, envp: exec.Environment,
    options: SpawnOptions) err[Error] {
    val begun: err[Cause] = begin_spawn(p);
    if (sel begun.err) { ret err[Error].err{failure(owner_identity(p), begun.err)}; }
    var redirect: exec.SpawnOptions = exec.spawn_options();
    redirect.cwd     = options.cwd;
    redirect.stdin   = options.stdin;
    redirect.grouped = options.grouped;
    # a spawn that started no child leaves the owner with no child and what it took released, its one attempt spent
    var started: bool = false;
    fin {
        if (!started) {
            observe_spawn_failure(p);
            dnit(a, p);
        }
    }
    val opened: err[Error] = spawn_capture(a, p, pathname, options, ?redirect.stdout, ?redirect.stderr);
    if (sel opened.err) { ret opened; }

    val cr: res[SpawnCopy, Error] = prepare_spawn_copy(a, pathname, argv, envp);
    if (sel cr.err) { ret err[Error].err{cr.err}; }
    var c:  SpawnCopy                   = cr.ok;
    val sr: res[exec.Child, exec.Error] = exec.spawn_with_options(c.pathname::str, c.argv, c.envp, redirect);
    spawn_copy_free_request(a, ?c);
    if (sel sr.err) {
        free_cstr(a, c.pathname);
        ret err[Error].err{failure(pathname, Cause.exec{sr.err})};
    }
    p.pathname = c.pathname;
    observe_spawn(p, sr.ok);
    started = true;
    ret err[Error].ok{};
}

# open the capture `options` asks for and point the child's stdout, and stderr
# when asked, at it
fun spawn_capture(a: *A.Allocator, p: *OwnedSubprocess, pathname: str, options: SpawnOptions, stdout: *usize, stderr: *usize) err[Error] {
    if (str_empty(options.capture)) { ret err[Error].ok{}; }
    val opened: err[Error] = capture_open(a, p, pathname, options);
    if (sel opened.err) { ret opened; }
    @stdout = p.capture.file.handle.value;
    if (options.capture_stderr) { @stderr = @stdout; }
    ret err[Error].ok{};
}

# `text` in native units, a refusal named by `identity`
fun native_copy(a: *A.Allocator, identity: str, text: str) res[NativeName, Error] {
    val cr: res[NativeName, host.NativeTextError] = host.native_text(a, text);
    if (sel cr.err) {
        if (sel cr.err.alloc) { ret res[NativeName, Error].err{failure(identity, Cause.alloc{cr.err.alloc})}; }
        ret res[NativeName, Error].err{failure(identity, Cause.native{cr.err.native})};
    }
    ret res[NativeName, Error].ok{cr.ok};
}

# release the first `filled` of a list of `count` native arguments, and the list
fun native_list_free(a: *A.Allocator, list: **Unit, filled: usize, count: usize) {
    var i: usize = 0;
    for (i < filled) {
        var name: NativeName = NativeName{units: list[i], length: native_length(list[i])};
        host.native_text_free(a, ?name);
        i = i + 1;
    }
    A.deallocate[*Unit](a, list, count + 1);
}

fun native_length(units: *Unit) usize {
    var n: usize = 0;
    for (units[n] != 0) { n = n + 1; }
    ret n;
}

# the arguments of a native spawn, each converted, nil-terminated
fun native_argv(a: *A.Allocator, pathname: str, argv: **u8) res[**Unit, Error] {
    val n:  usize                = cstr_count(argv);
    val ar: res[**Unit, A.Error] = A.allocate[*Unit](a, n + 1);
    if (sel ar.err) { ret res[**Unit, Error].err{failure(pathname, Cause.alloc{ar.err})}; }
    val out: **Unit = ar.ok;
    var i:   usize  = 0;
    for (i < n) {
        val cr: res[NativeName, Error] = native_copy(a, pathname, argv[i]::str);
        if (sel cr.err) {
            native_list_free(a, out, i, n);
            ret res[**Unit, Error].err{cr.err};
        }
        out[i] = cr.ok.units;
        i      = i + 1;
    }
    out[n] = nil;
    ret res[**Unit, Error].ok{out};
}

# spawn with the child's environment in native units, so an inherited variable
# with no UTF-8 spelling reaches it unit for unit. the pathname, argv and
# working directory are UTF-8 as spawn takes them, converted once; the
# environment is read only during the call. everything else is as spawn
# ---
# envp: the child's environment, given native entries or this process's inherited
pub fun spawn_native(a: *A.Allocator, p: *OwnedSubprocess, pathname: str, argv: **u8, envp: exec.NativeEnvironment,
    options: SpawnOptions) err[Error] {
    val begun: err[Cause] = begin_spawn(p);
    if (sel begun.err) { ret err[Error].err{failure(owner_identity(p), begun.err)}; }
    var redirect: exec.NativeSpawnOptions = exec.native_spawn_options();
    redirect.stdin   = options.stdin;
    redirect.grouped = options.grouped;
    # a spawn that started no child leaves the owner with no child and what it took released, its one attempt spent
    var started: bool = false;
    fin {
        if (!started) {
            observe_spawn_failure(p);
            dnit(a, p);
        }
    }
    val opened: err[Error] = spawn_capture(a, p, pathname, options, ?redirect.stdout, ?redirect.stderr);
    if (sel opened.err) { ret opened; }

    val identity_r: res[*u8, Error] = dup_cstr(a, pathname::*u8);
    if (sel identity_r.err) { ret err[Error].err{identity_r.err}; }
    val identity: *u8 = identity_r.ok;
    fin {
        if (!started) { free_cstr(a, identity); }
    }
    val program_r: res[NativeName, Error] = native_copy(a, pathname, pathname);
    if (sel program_r.err) { ret err[Error].err{program_r.err}; }
    var program: NativeName = program_r.ok;
    fin { host.native_text_free(a, ?program); }
    val cwd_r: res[NativeName, Error] = native_copy(a, pathname, options.cwd);
    if (sel cwd_r.err) { ret err[Error].err{cwd_r.err}; }
    var cwd: NativeName = cwd_r.ok;
    fin { host.native_text_free(a, ?cwd); }
    redirect.cwd = cwd.units;
    val argv_r: res[**Unit, Error] = native_argv(a, pathname, argv);
    if (sel argv_r.err) { ret err[Error].err{argv_r.err}; }
    val native_argv_list: **Unit                      = argv_r.ok;
    val sr:               res[exec.Child, exec.Error] = exec.spawn_native_with_options(program.units, native_argv_list, envp, redirect);
    val count:            usize                       = cstr_count(argv);
    native_list_free(a, native_argv_list, count, count);
    if (sel sr.err) { ret err[Error].err{failure(pathname, Cause.exec{sr.err})}; }
    p.pathname = identity;
    observe_spawn(p, sr.ok);
    started = true;
    ret err[Error].ok{};
}

# whether `p` holds a child that has not ended, which a cancel or a timeout can stop
pub fun running(p: *OwnedSubprocess) bool {
    ret p.state == STATE_RUNNING;
}

# block until the running child of `p` ends, and reap it
# ---
# ret: how the child ended, or the refusal when no child is running
pub fun wait(a: *A.Allocator, p: *OwnedSubprocess) res[SubprocessTerminal, Error] {
    if (!running(p)) {
        ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.not_running{})};
    }
    val wr: res[exec.ExitStatus, exec.Error] = exec.wait(p.child);
    if (sel wr.err) {
        ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.exec{wr.err})};
    }
    val observed: err[Error] = observe_status(p, wr.ok);
    if (sel observed.err) { ret res[SubprocessTerminal, Error].err{observed.err}; }
    ret res[SubprocessTerminal, Error].ok{p.terminal};
}

# whether the capture of `p` outgrew its limit, or the refusal to measure it
fun capture_over_limit(p: *OwnedSubprocess) res[bool, Error] {
    if (!p.has_capture) { ret res[bool, Error].ok{false}; }
    val mr: res[fs.Metadata, io_error.Error] = fs.stat_of(p.capture.file);
    if (sel mr.err) { ret res[bool, Error].err{failure(owner_identity(p), Cause.io{mr.err})}; }
    ret res[bool, Error].ok{mr.ok.size > p.capture.limit};
}

# supervise `count` owners until one of them reaches its terminal, and return
# that one reaped
#
# each pass polls the scope, then every running owner: a cancelled or expired
# scope cancels or times out the first running owner, an owner past its own
# deadline is timed out, and one whose capture outgrew its limit is
# cancelled. a terminate, interrupt, console-close or service-stop event from
# `source` cancels the scope.
# ---
# owners: array of `count` owners, some of which may not be running
# scope:  cancellation scope over all of them, or nil
# source: process events that cancel the scope, or nil
# ret:    the owner that reached its terminal, or the refusal when none is
#         running
pub fun wait_any(a: *A.Allocator, owners: *OwnedSubprocess, count: u32, scope: *sync_cancel.Scope, source: *events.Source) res[*OwnedSubprocess, Error] {
    for (true) {
        val clock: time.InstantClock = time.instant();
        if (sel clock.err) { ret res[*OwnedSubprocess, Error].err{failure("subprocess", Cause.io{clock.err})}; }
        val now:   time.Instant = clock.ok;
        var fired: Request      = REQUEST_ACTIVE;
        if (scope != nil) {
            if (source != nil) {
                val next: res[opt[events.Event], io_error.Error] = events.next(source);
                if (sel next.ok) {
                    if (sel next.ok.some) {
                        val event: events.Event = next.ok.some;
                        if (event.kind == events.TERMINATE || event.kind == events.INTERRUPT
                            || event.kind == events.CONSOLE_CLOSE || event.kind == events.SERVICE_STOP) {
                            # the caller's scope is live, so cancel refuses nothing, and an already ended scope already stops the wait
                            sync_cancel.cancel(scope);
                        }
                    }
                }
            }
            sync_cancel.expire(scope, now);
            fired = request_of(sync_cancel.reason(scope));
        }

        var live: bool = false;
        var i:    u32  = 0;
        for (i < count) {
            val p: *OwnedSubprocess = ?owners[i];
            if (running(p)) {
                live = true;
                if (fired == REQUEST_TIMED_OUT || fired == REQUEST_CANCELLED) {
                    var tr: res[SubprocessTerminal, Error];
                    if (fired == REQUEST_TIMED_OUT) { tr = timeout(a, p, 0); }
                    or                              { tr = cancel(a, p, 0); }
                    if (sel tr.err) {
                        ret res[*OwnedSubprocess, Error].err{tr.err};
                    }
                    ret res[*OwnedSubprocess, Error].ok{p};
                }
                if (deadline_reached(p, now)) {
                    val dr: res[SubprocessTerminal, Error] = timeout(a, p, 0);
                    if (sel dr.err) {
                        ret res[*OwnedSubprocess, Error].err{dr.err};
                    }
                    ret res[*OwnedSubprocess, Error].ok{p};
                }
                val over: res[bool, Error] = capture_over_limit(p);
                if (sel over.err) { ret res[*OwnedSubprocess, Error].err{over.err}; }
                if (over.ok) {
                    val cr: res[SubprocessTerminal, Error] = cancel(a, p, 0);
                    if (sel cr.err) {
                        ret res[*OwnedSubprocess, Error].err{cr.err};
                    }
                    ret res[*OwnedSubprocess, Error].ok{p};
                }
                val wr: res[opt[exec.ExitStatus], exec.Error] = exec.try_wait(p.child);
                if (sel wr.err) {
                    ret res[*OwnedSubprocess, Error].err{failure(owner_identity(p), Cause.exec{wr.err})};
                }
                val got: opt[exec.ExitStatus] = wr.ok;
                if (sel got.some) {
                    val observed: err[Error] = observe_status(p, got.some);
                    if (sel observed.err) { ret res[*OwnedSubprocess, Error].err{observed.err}; }
                    ret res[*OwnedSubprocess, Error].ok{p};
                }
            }
            i = i + 1;
        }
        if (!live) { ret res[*OwnedSubprocess, Error].err{failure("subprocess", Cause.idle{})}; }
        system_os.sleep(chrono_duration.MILLISECOND);
    }
}

fun finalize_capture_file(a: *A.Allocator, c: *OwnedCapture, keep: bool) {
    val mr: res[fs.Metadata, io_error.Error] = fs.stat_of(c.file);
    if (sel mr.err) {
        c.result.read_failed = true;
        ret;
    }
    val source: usize = mr.ok.size;
    var stored: usize = source;
    if (stored > c.limit) {
        stored             = c.limit;
        c.result.truncated = true;
    }
    if (stored == 0) { ret; }

    val sk: res[i64, io_error.Error] = fs.seek(c.file, 0, fs.SEEK_SET);
    if (sel sk.err) {
        c.result.read_failed = true;
        ret;
    }

    val br: res[*u8, A.Error] = A.allocate[u8](a, stored);
    if (sel br.err) {
        c.result.read_failed = true;
        ret;
    }
    val buf: *u8 = br.ok;

    var got: usize = 0;
    for (got < stored) {
        val rr: res[usize, io_error.Error] = fs.read(c.file, (buf::usize + got)::*u8, stored - got);
        if (sel rr.err) {
            c.result.read_failed = true;
            brk;
        }
        val n: usize = rr.ok;
        if (n == 0) { brk; }
        got = got + n;
    }
    c.result.bytes = got;
    if (got < stored && !c.result.read_failed) { c.result.short_read = true; }

    if (keep && !c.result.read_failed) {
        c.buffer   = buf;
        c.capacity = stored;
    }
    or {
        A.deallocate[u8](a, buf, stored);
    }
}

# read the capture of a finished child back and close it, once
# ---
# retain: keep the captured bytes for capture_bytes, else only count them
# ret:    what happened to the capture, or the refusal while the child runs or
#         after release_capture
pub fun finish_capture(a: *A.Allocator, p: *OwnedSubprocess, retain: bool) res[CaptureIoResult, Error] {
    if (!p.has_capture) { ret res[CaptureIoResult, Error].ok{p.capture.result}; }
    if (p.capture.released) {
        ret res[CaptureIoResult, Error].err{failure(owner_identity(p), Cause.capture_released{})};
    }
    if (p.state == STATE_RUNNING) {
        ret res[CaptureIoResult, Error].err{failure(owner_identity(p), Cause.capture_running{})};
    }
    if (!p.capture.finished) {
        finalize_capture_file(a, ?p.capture, retain);
        p.capture.finished = true;
    }
    close_capture(?p.capture);
    ret res[CaptureIoResult, Error].ok{p.capture.result};
}

# close the capture without reading it back, marking it failed
pub fun abandon_capture(p: *OwnedSubprocess) {
    if (!p.has_capture) { ret; }
    close_capture(?p.capture);
    p.capture.finished           = true;
    p.capture.result.read_failed = true;
}

# the captured bytes retained by finish_capture, borrowed from `p`
# ---
# len: receives the byte count, 0 when nothing is retained
# ret: the bytes, or nil when nothing is retained
pub fun capture_bytes(p: *OwnedSubprocess, len: *usize) *u8 {
    @len = 0;
    if (!p.has_capture || !p.capture.result.owned || !p.capture.finished) { ret nil; }
    @len = p.capture.result.bytes;
    ret p.capture.buffer;
}

# free the captured bytes and the capture identity of a finished capture, once
pub fun release_capture(a: *A.Allocator, p: *OwnedSubprocess) err[Error] {
    if (!p.has_capture) { ret err[Error].ok{}; }
    if (p.capture.released) {
        ret err[Error].err{failure(owner_identity(p), Cause.capture_released{})};
    }
    if (!p.capture.finished) {
        ret err[Error].err{failure(owner_identity(p), Cause.capture_unfinished{})};
    }
    close_capture(?p.capture);
    if (p.capture.result.owned && p.capture.buffer != nil) {
        val released: err[A.Error] = A.deallocate[u8](a, p.capture.buffer, p.capture.capacity);
        if (sel released.err) {
            ret err[Error].err{failure(owner_identity(p), Cause.capture_release{})};
        }
    }
    free_cstr(a, p.capture.identity);
    p.capture.identity     = nil;
    p.capture.result.owned = false;
    p.capture.buffer       = nil;
    p.capture.capacity     = 0;
    p.capture.result.bytes = 0;
    p.capture.released     = true;
    ret err[Error].ok{};
}

# buf holds std_format.DECIMAL_MAX + 1 bytes
fun pid_string(buf: *u8, child_pid: i64) *u8 {
    buf[std_format.put_i64(buf, child_pid)] = 0;
    ret buf;
}

# ask `child` to stop, or kill it when `hard`; nothing, or the refusal
fun actual_terminate(a: *A.Allocator, child: exec.Child, hard: bool) err[Error] {
    if (hard) {
        val terminated: err[exec.Error] = exec.terminate_child(exec.Child{pid: child.pid});
        if (sel terminated.err) { ret err[Error].err{failure("subprocess", Cause.exec{terminated.err})}; }
        ret err[Error].ok{};
    }
    if (child.pgid != 0) {
        val grouped: err[exec.Error] = exec.terminate_group(child);
        if (sel grouped.err) { ret err[Error].err{failure("subprocess", Cause.exec{grouped.err})}; }
        ret err[Error].ok{};
    }
    var pid_buf:  [24]u8;
    val pid_arg:  *u8 = pid_string(?pid_buf[0], child.pid);
    var argv:     [5]*u8;
    val pathname: *u8 = host.terminate_command(pid_arg, ?argv[0]);

    var helper: OwnedSubprocess;
    init(?helper);
    fin { dnit(a, ?helper); }
    val sr: err[Error] = spawn(a, ?helper, pathname, ?argv[0], exec.Environment.inherit{}, spawn_options());
    if (sel sr.err) { ret sr; }
    val wr: res[SubprocessTerminal, Error] = wait(a, ?helper);
    if (sel wr.err) { ret err[Error].err{wr.err}; }
    val terminal: SubprocessTerminal = wr.ok;
    if (terminal.kind != STATE_EXITED || terminal.code != 0) { ret err[Error].err{failure(pathname::str, Cause.termination{})}; }
    ret err[Error].ok{};
}

# how the child `child_pid` ended, none while it runs and `block` is false, or
# the refusal to wait for it
fun actual_wait(a: *A.Allocator, child_pid: i64, block: bool) res[opt[SubprocessTerminal], Error] {
    val child: exec.Child = exec.Child{pid: child_pid, pgid: 0};
    var st:    exec.ExitStatus;
    if (block) {
        val br: res[exec.ExitStatus, exec.Error] = exec.wait(child);
        if (sel br.err) { ret res[opt[SubprocessTerminal], Error].err{failure("subprocess", Cause.exec{br.err})}; }
        st = br.ok;
    }
    or {
        val pr: res[opt[exec.ExitStatus], exec.Error] = exec.try_wait(child);
        if (sel pr.err) { ret res[opt[SubprocessTerminal], Error].err{failure("subprocess", Cause.exec{pr.err})}; }
        val got: opt[exec.ExitStatus] = pr.ok;
        if (sel got.none) { ret res[opt[SubprocessTerminal], Error].ok{opt[SubprocessTerminal].none{}}; }
        st = got.some;
    }
    val ended: opt[SubprocessTerminal] = status_terminal(st);
    if (sel ended.none) { ret res[opt[SubprocessTerminal], Error].err{failure("subprocess", Cause.invalid_status{})}; }
    ret res[opt[SubprocessTerminal], Error].ok{ended};
}

fun actual_sleep(a: *A.Allocator) {
    system_os.sleep(chrono_duration.MILLISECOND);
}

# a soft request that could not be sent, or a poll after it that failed,
# escalates to the hard kill rather than failing; a hard kill that could not
# be sent fails with its refusal unless the child ended anyway
fun request_with[T](p: *OwnedSubprocess, a: *A.Allocator, request: Request, attempts: u32,
    ctx: *T, terminate: fun(*T, exec.Child, bool) err[Error],
    wait_child: fun(*T, i64, bool) res[opt[SubprocessTerminal], Error],
    sleep: fun(*T)) res[SubprocessTerminal, Error] {
    if (ctx == nil || terminate == nil || wait_child == nil || sleep == nil) {
        ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.incomplete{})};
    }
    if (!running(p)) {
        ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.not_running{})};
    }
    if (request != REQUEST_TIMED_OUT && request != REQUEST_CANCELLED) {
        ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.request{})};
    }
    p.requested = request;

    val soft: err[Error] = terminate(ctx, p.child, false);
    var i:    u32        = 0;
    for (sel soft.ok && i < attempts) {
        val wr: res[opt[SubprocessTerminal], Error] = wait_child(ctx, p.child.pid, false);
        if (sel wr.err)     { brk; }
        if (sel wr.ok.some) { ret reaped_as(p, wr.ok.some); }
        sleep(ctx);
        i = i + 1;
    }

    val hard: err[Error] = terminate(ctx, p.child, true);
    if (sel hard.err) {
        val polled: res[opt[SubprocessTerminal], Error] = wait_child(ctx, p.child.pid, false);
        if (sel polled.err) { ret res[SubprocessTerminal, Error].err{polled.err}; }
        if (sel polled.ok.none) {
            ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.termination{})};
        }
        ret reaped_as(p, polled.ok.some);
    }

    val waited: res[opt[SubprocessTerminal], Error] = wait_child(ctx, p.child.pid, true);
    if (sel waited.err) { ret res[SubprocessTerminal, Error].err{waited.err}; }
    if (sel waited.ok.none) {
        ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.reap{})};
    }
    ret reaped_as(p, waited.ok.some);
}

# `p` reaped with the terminal `t` it reached
fun reaped_as(p: *OwnedSubprocess, t: SubprocessTerminal) res[SubprocessTerminal, Error] {
    val observed: err[Error] = observe_reaped(p, t.kind, t.code);
    if (sel observed.err) { ret res[SubprocessTerminal, Error].err{observed.err}; }
    ret res[SubprocessTerminal, Error].ok{p.terminal};
}

fun request(p: *OwnedSubprocess, a: *A.Allocator, state: Request,
    grace: chrono_duration.Duration) res[SubprocessTerminal, Error] {
    if (grace < 0) {
        ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.grace_negative{})};
    }
    var attempts: u32 = 0;
    if (grace > 0) {
        var millis: i64 = grace / chrono_duration.MILLISECOND;
        if (grace % chrono_duration.MILLISECOND != 0) { millis = millis + 1; }
        if (millis > 4294967295) {
            ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.grace_large{})};
        }
        attempts = millis::u32;
    }
    ret request_with[A.Allocator](p, a, state, attempts, a, actual_terminate, actual_wait,
        actual_sleep);
}

# terminate the running child for outliving its deadline and reap it
#
# the child is asked to stop, its whole group when it has one, and given
# `grace` to end before it is killed.
# ---
# grace: how long the child has to stop, rounded up to a millisecond
# ret:   how the child ended, or the refusal. a refused termination keeps the
#        child running and owned, so the request can be retried
pub fun timeout(a: *A.Allocator, p: *OwnedSubprocess, grace: chrono_duration.Duration) res[SubprocessTerminal, Error] {
    ret request(p, a, REQUEST_TIMED_OUT, grace);
}

# terminate the running child as cancelled and reap it, as timeout does
pub fun cancel(a: *A.Allocator, p: *OwnedSubprocess, grace: chrono_duration.Duration) res[SubprocessTerminal, Error] {
    ret request(p, a, REQUEST_CANCELLED, grace);
}

$if ($mach.build.os == $mach.os.windows) {
    #[library("kernel32")]
    ext fun SetEnvironmentVariableW(name: *u16, value: *u16) i32;
}
