# output: how a compiler-controlled file reaches its final name. a build
# product under `out/` is regenerable by the next build or `mach clean`, so
# it is written in place with no staging, lock or journal. a file in the
# source tree goes through `replace`, which writes a sibling temporary and
# renames it over the destination so an interrupted write leaves the
# original intact
use mach.lang.build.outcome;
use mach.lang.intern;
use A:  std.allocator;
use fs: std.filesystem;
use std.format;
use io_error: std.io.error;
use mwriter:  std.io.writer;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

pub val DIR_MODE: i32 = 0o755;

pub fun intern_message(itn: *intern.Interner, a: *A.Allocator, buf: *u8, total: usize, generic: str) str {
    buf[total] = 0;
    val res_id: res[intern.StrId, A.Error] = intern.intern(itn, buf::str);
    A.deallocate[u8](a, buf, total + 1);
    if (sel res_id.err) { ret generic; }
    val opt_name: opt[str] = intern.lookup(itn, res_id.ok);
    if (sel opt_name.some) { ret opt_name.some; }
    ret generic;
}

pub fun io_message(itn: *intern.Interner, a: *A.Allocator, op: str, path: str, os_error: str, generic: str) str {
    if (itn == nil || path == nil) { ret generic; }
    val res_msg: res[str, format.FormatError] = format.sprint(a, "{} '{}': {}", op, path, os_error);
    if (sel res_msg.err) { ret generic; }
    val buf: str = res_msg.ok;
    ret intern_message(itn, a, buf, str_len(buf), generic);
}

fun message(itn: *intern.Interner, a: *A.Allocator, op: str, path: str, detail: str, generic: str) str {
    if (itn == nil) { ret detail; }
    ret io_message(itn, a, op, path, detail, generic);
}

fun parents(a: *A.Allocator, target: str) err[fs.FsError] {
    val parent: res[str, A.Error] = path.parent(a, target);
    if (sel parent.err) { ret err[fs.FsError].err{fs.FsError.alloc{parent.err}}; }
    val made: err[fs.FsError] = fs.create_dir_all(a, parent.ok, DIR_MODE);
    str_free(a, parent.ok);
    ret made;
}

# write `buf` to `path`, creating missing parent directories when `create_parents`
pub fun bytes(itn: *intern.Interner, a: *A.Allocator, path: str, buf: *u8, len: usize, mode: i32,
    create_parents: bool, op: str, generic: str) err[outcome.Fail] {
    if (create_parents) {
        val made: err[fs.FsError] = parents(a, path);
        if (sel made.err) {
            ret err[outcome.Fail].err{outcome.environment(message(itn, a, op, path, outcome.fs_text(made.err), generic))};
        }
    }
    val written: err[fs.FsError] = fs.write_bytes(path, buf, len, mode);
    if (sel written.err) {
        ret err[outcome.Fail].err{outcome.environment(message(itn, a, op, path, outcome.fs_text(written.err), generic))};
    }
    ret err[outcome.Fail].ok{};
}

# stream `path` through `write_cb`, creating missing parent directories when `create_parents`
pub fun writer[W](itn: *intern.Interner, a: *A.Allocator, path: str, ctx: *W,
    write_cb: fun(*W, *mwriter.Writer) err[mwriter.WriteError], mode: i32,
    create_parents: bool, op: str, generic: str) err[outcome.Fail] {
    if (create_parents) {
        val made: err[fs.FsError] = parents(a, path);
        if (sel made.err) {
            ret err[outcome.Fail].err{outcome.environment(message(itn, a, op, path, outcome.fs_text(made.err), generic))};
        }
    }
    val created: res[fs.File, io_error.Error] = fs.create(path, mode);
    if (sel created.err) {
        ret err[outcome.Fail].err{outcome.environment(message(itn, a, op, path, outcome.io_text(created.err), generic))};
    }
    var file:   fs.File                 = created.ok;
    var w:      mwriter.Writer          = fs.writer(file);
    val wrote:  err[mwriter.WriteError] = write_cb(ctx, ?w);
    val closed: err[io_error.Error]     = fs.close(?file);
    if (sel wrote.err) {
        ret err[outcome.Fail].err{outcome.environment(message(itn, a, op, path, "write failed", generic))};
    }
    if (sel closed.err) {
        ret err[outcome.Fail].err{outcome.environment(message(itn, a, op, path, outcome.io_text(closed.err), generic))};
    }
    ret err[outcome.Fail].ok{};
}

# replace a source-tree file through a sibling temporary and rename, so the
# destination is either the old content or the complete new content
pub fun replace(a: *A.Allocator, path: str, buf: *u8, len: usize, mode: i32) err[outcome.Fail] {
    val replaced: err[fs.FsError] = fs.replace_bytes_atomic(a, path, buf, len, mode, DIR_MODE);
    if (sel replaced.err) { ret err[outcome.Fail].err{outcome.environment(outcome.fs_text(replaced.err))}; }
    ret err[outcome.Fail].ok{};
}
