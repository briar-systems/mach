# output: how a compiler-controlled file reaches its final name. a build
# product under `out/` is regenerable by the next build or `mach clean`, so
# it is written in place with no staging, lock or journal, except an `obj/`
# object: the object cache reads it back, so it goes through
# `through_temporary`. a file in the source tree goes through `replace`. both
# write a sibling temporary and rename it over the destination, so an
# interrupted write leaves the original intact. the build owns its output
# layout: `directory` and `reserve` replace a stale entry of the wrong kind,
# and every failure names the path and the operation through `fail.refusal`
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.diagnostic;
use mach.lang.fail;
use mach.lang.intern;
use A: std.allocator;
use std.collections.vector.Vector;
use std.crypto.rand;
use fs:        std.filesystem;
use io_error:  std.io.error;
use io_writer: std.io.writer;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_join;
use std.types.string.str_len;
use std.types.string.str_replace;

val DIR_MODE: i32 = 0o755;

# the refusal of `op`, its text interned when `itn` is given and otherwise in `a`
fun refused(itn: *intern.Interner, a: *A.Allocator, k: diagnostic_kind.Kind, op: fail.Op, cause: fail.Cause) fail.Fail {
    if (itn != nil) { ret diagnostic.refusal_interned(itn, a, k, op, cause); }
    ret fail.refusal(a, k, op, cause);
}

fun layout_fail(a: *A.Allocator, k: diagnostic_kind.Kind, verb: str, at: str, cause: fail.Cause) err[fail.Fail] {
    ret err[fail.Fail].err{fail.refusal(a, k, fail.Op{verb: verb, path: at}, cause)};
}

# whether `p` lies strictly beneath `root`, both read as cleaned paths; no root
# holds nothing beneath it
fun beneath(a: *A.Allocator, root: str, p: str) res[bool, fail.Fail] {
    if (root == nil) { ret res[bool, fail.Fail].ok{false}; }
    val clean_root: res[str, A.Error] = types_path.clean(a, root);
    if (sel clean_root.err) { ret res[bool, fail.Fail].err{fail.refused(clean_root.err)}; }
    fin { str_free(a, clean_root.ok); }
    val clean_p: res[str, A.Error] = types_path.clean(a, p);
    if (sel clean_p.err) { ret res[bool, fail.Fail].err{fail.refused(clean_p.err)}; }
    fin { str_free(a, clean_p.ok); }
    val r:  str   = clean_root.ok;
    val c:  str   = clean_p.ok;
    val rl: usize = str_len(r);
    if (rl == 0 || str_len(c) <= rl + 1) { ret res[bool, fail.Fail].ok{false}; }
    var i: usize = 0;
    for (i < rl) {
        if (r[i] != c[i]) { ret res[bool, fail.Fail].ok{false}; }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{types_path.is_separator(c[rl]) || types_path.is_separator(r[rl - 1])};
}

# the build owns the layout beneath its output root: `dir` and each missing
# ancestor become directories, and beneath `root` an entry where one belongs
# that does not resolve to a directory (a stale file, a dangling link) is
# removed first, a link as the link and never its target. `root` itself and
# what lies above it or outside it are created but never replaced, and a
# symlink to a directory is used as it stands
pub fun directory(a: *A.Allocator, root: str, dir: str) err[fail.Fail] {
    if (types_path.is_empty(dir) || types_path.is_root(dir)) { ret err[fail.Fail].ok{}; }
    val present: res[bool, io_error.Error] = fs.is_dir(dir);
    if (sel present.err) { ret layout_fail(a, diagnostic_kind.FS_STAT, "inspect directory", dir, fail.Cause.io{present.err}); }
    if (present.ok)      { ret err[fail.Fail].ok{}; }
    val below: res[bool, fail.Fail] = beneath(a, root, dir);
    if (sel below.err) { ret err[fail.Fail].err{below.err}; }
    if (!below.ok) {
        val created: err[fs.FsError] = fs.create_dir_all(a, dir, DIR_MODE);
        if (sel created.err) { ret layout_fail(a, diagnostic_kind.FS_CREATE, "create directory", dir, fail.Cause.fs{created.err}); }
        ret err[fail.Fail].ok{};
    }
    val parent: res[str, A.Error] = types_path.parent(a, dir);
    if (sel parent.err) { ret err[fail.Fail].err{fail.refused(parent.err)}; }
    val above: err[fail.Fail] = directory(a, root, parent.ok);
    str_free(a, parent.ok);
    if (sel above.err) { ret above; }
    val stale: res[bool, io_error.Error] = fs.exists(dir);
    if (sel stale.err) { ret layout_fail(a, diagnostic_kind.FS_STAT, "inspect directory", dir, fail.Cause.io{stale.err}); }
    if (stale.ok) {
        val removed: err[io_error.Error] = fs.remove_file(dir);
        if (sel removed.err) { ret layout_fail(a, diagnostic_kind.FS_REMOVE, "replace stale file", dir, fail.Cause.io{removed.err}); }
    }
    val made: err[io_error.Error] = fs.create_dir(dir, DIR_MODE);
    if (sel made.ok) { ret err[fail.Fail].ok{}; }
    # a concurrent writer that made it first is as good
    val now: res[bool, io_error.Error] = fs.is_dir(dir);
    if (sel now.ok && now.ok) { ret err[fail.Fail].ok{}; }
    ret layout_fail(a, diagnostic_kind.FS_CREATE, "create directory", dir, fail.Cause.io{made.err});
}

# ready `file` to be written: its parent is a directory as `directory` makes
# it, and beneath `root` a stale directory at its own name is removed. a
# symlink there is left for the write to follow
pub fun reserve(a: *A.Allocator, root: str, file: str) err[fail.Fail] {
    val parent: res[str, A.Error] = types_path.parent(a, file);
    if (sel parent.err) { ret err[fail.Fail].err{fail.refused(parent.err)}; }
    val made: err[fail.Fail] = directory(a, root, parent.ok);
    str_free(a, parent.ok);
    if (sel made.err) { ret made; }
    val below: res[bool, fail.Fail] = beneath(a, root, file);
    if (sel below.err) { ret err[fail.Fail].err{below.err}; }
    if (!below.ok)     { ret err[fail.Fail].ok{}; }
    val found: res[fs.Metadata, io_error.Error] = fs.metadata_link(file);
    if (sel found.err) {
        if (found.err.kind == io_error.NOT_FOUND) { ret err[fail.Fail].ok{}; }
        ret layout_fail(a, diagnostic_kind.FS_STAT, "inspect", file, fail.Cause.io{found.err});
    }
    var meta: fs.Metadata = found.ok;
    if (!fs.meta_is_dir(?meta)) { ret err[fail.Fail].ok{}; }
    val removed: err[fs.FsError] = fs.remove_all(a, file);
    if (sel removed.err) { ret layout_fail(a, diagnostic_kind.FS_REMOVE, "replace stale directory", file, fail.Cause.fs{removed.err}); }
    ret err[fail.Fail].ok{};
}

# write `buf` to `path`, whose parent exists, a refusal naming it as `role`, nil
# for a product its path names
pub fun bytes(itn: *intern.Interner, a: *A.Allocator, path: str, buf: *u8, len: usize, mode: i32, role: str) err[fail.Fail] {
    val written: err[fs.FsError] = fs.write_bytes(path, buf, len, mode);
    if (sel written.err) {
        ret err[fail.Fail].err{refused(itn, a, diagnostic_kind.FS_WRITE, fail.Op{verb: "write", role: role, path: path}, fail.Cause.fs{written.err})};
    }
    ret err[fail.Fail].ok{};
}

# the bytes a streamed file is staged in before each write reaches the file
val WRITE_STAGE: usize = 65536;

# stream `path`, whose parent exists, through `write_cb`, staged in `a` so a writer of many small
# pieces makes few writes to the file; a refusal names it as `role`, nil for a product its path
# names
pub fun writer[W](itn: *intern.Interner, a: *A.Allocator, path: str, ctx: *W,
    write_cb: fun(*W, *io_writer.Writer) err[io_writer.WriteError], mode: i32, role: str) err[fail.Fail] {
    val staged: res[*u8, A.Error] = A.allocate[u8](a, WRITE_STAGE);
    if (sel staged.err) { ret err[fail.Fail].err{fail.refused(staged.err)}; }
    fin { A.deallocate[u8](a, staged.ok, WRITE_STAGE); }
    val created: res[fs.File, io_error.Error] = fs.create(path, mode);
    if (sel created.err) {
        ret err[fail.Fail].err{refused(itn, a, diagnostic_kind.FS_CREATE, fail.Op{verb: "create", role: role, path: path}, fail.Cause.io{created.err})};
    }
    var file:     fs.File                   = created.ok;
    var raw:      io_writer.Writer          = fs.writer(file);
    var stage:    io_writer.Buffered;
    var w:        io_writer.Writer          = io_writer.buffered(?stage, ?raw, staged.ok, WRITE_STAGE);
    val streamed: err[io_writer.WriteError] = write_cb(ctx, ?w);
    var wrote:    err[io_writer.WriteError] = streamed;
    if (sel streamed.ok) { wrote = io_writer.flush(?stage); }
    val closed: err[io_error.Error] = fs.close(?file);
    # a refused close after a failed write adds nothing: the file's contents are already lost
    if (sel wrote.err) {
        ret err[fail.Fail].err{refused(itn, a, diagnostic_kind.FS_WRITE, fail.Op{verb: "write", role: role, path: path}, fail.Cause.write{wrote.err})};
    }
    if (sel closed.err) {
        ret err[fail.Fail].err{refused(itn, a, diagnostic_kind.FS_CLOSE, fail.Op{verb: "close", role: role, path: path}, fail.Cause.io{closed.err})};
    }
    ret err[fail.Fail].ok{};
}

# replace a source-tree file through a sibling temporary and rename, so the
# destination is either the old content or the complete new content
pub fun replace(a: *A.Allocator, path: str, buf: *u8, len: usize, mode: i32) err[fail.Fail] {
    val replaced: err[fs.FsError] = fs.replace_bytes_atomic(a, path, buf, len, mode, DIR_MODE);
    if (sel replaced.err) { ret layout_fail(a, diagnostic_kind.FS_WRITE, "write", path, fail.Cause.fs{replaced.err}); }
    ret err[fail.Fail].ok{};
}

# the file a module's output takes under `base`: its dotted name as a path,
# with `suffix` as the extension
pub fun mirror_fqn(a: *A.Allocator, base: *u8, fqn: str, suffix: str) res[str, fail.Fail] {
    val rel_r: res[str, types_string.StrError] = str_replace(a, fqn, ".", "/");
    if (sel rel_r.err) { ret res[str, fail.Fail].err{fail.message(fail.str_text(rel_r.err))}; }
    val rel: str = rel_r.ok;
    fin { str_free(a, rel); }
    val leaf_r: res[str, types_string.StrError] = str_join(a, rel, ".", suffix);
    if (sel leaf_r.err) { ret res[str, fail.Fail].err{fail.message(fail.str_text(leaf_r.err))}; }
    val leaf: str = leaf_r.ok;
    fin { str_free(a, leaf); }
    val join_r: res[types_path.Path, A.Error] = types_path.join(a, base::str, leaf);
    if (sel join_r.err) { ret res[str, fail.Fail].err{fail.refused(join_r.err)}; }
    ret res[str, fail.Fail].ok{join_r.ok};
}

val HEX: str = "0123456789abcdef";

# `<destination>.tmp-<16 random hex digits>`, beside the destination so the
# rename stays on one filesystem
fun temporary_name(a: *A.Allocator, destination: str) res[str, fail.Fail] {
    var random: [8]u8;
    val filled: err[io_error.Error] = rand.fill(?random[0], 8);
    if (sel filled.err) { ret res[str, fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_TEMP, fail.Op{verb: "name", role: "the temporary beside", path: destination}, fail.Cause.io{filled.err})}; }
    var digits: [17]u8;
    var i:      usize = 0;
    for (i < 8) {
        digits[i * 2]     = HEX[(random[i] >> 4)::usize];
        digits[i * 2 + 1] = HEX[(random[i] & 0x0f)::usize];
        i                 = i + 1;
    }
    digits[16] = 0;
    val named: res[str, types_string.StrError] = str_join(a, destination, ".tmp-", (?digits[0])::str);
    if (sel named.err) { ret res[str, fail.Fail].err{fail.message(fail.str_text(named.err))}; }
    ret res[str, fail.Fail].ok{named.ok};
}

# the sibling temporary a `through_temporary` write fills, and the destination a
# refused write of it is named by
# ---
# a:           owns the text of a refusal
# path:        the temporary
# destination: the file the temporary is renamed over
pub rec Temporary {
    a:           *A.Allocator;
    path:        str;
    destination: str;
}

# write `buf` to the temporary `t`, a refusal naming the destination and the temporary it was
# written through
pub fun fill(t: *Temporary, buf: *u8, len: usize, mode: i32) err[fail.Fail] {
    val written: err[fs.FsError] = fs.write_bytes(t.path, buf, len, mode);
    if (sel written.err) {
        ret err[fail.Fail].err{fail.refusal(t.a, diagnostic_kind.FS_WRITE, fail.Op{verb: "write", path: t.destination, link: "through its temporary", other: t.path}, fail.Cause.fs{written.err})};
    }
    ret err[fail.Fail].ok{};
}

# read the whole of a file the build wrote, a refusal naming `path`
pub fun read_back(a: *A.Allocator, path: str) res[Vector[u8], fail.Fail] {
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(a, path);
    if (sel read.err) { ret res[Vector[u8], fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_READ, fail.Op{verb: "read back", path: path}, fail.Cause.fs{read.err})}; }
    ret res[Vector[u8], fail.Fail].ok{read.ok};
}

# `write` fills a sibling temporary of `destination` through `fill`, which is
# then renamed over it: a reader sees the previous file or the complete new
# one, never a torn one, and a failed write leaves the previous file and no
# temporary
pub fun through_temporary[C](a: *A.Allocator, destination: str, ctx: *C,
    write: fun(*C, *Temporary) err[fail.Fail]) err[fail.Fail] {
    val named: res[str, fail.Fail] = temporary_name(a, destination);
    if (sel named.err) { ret err[fail.Fail].err{named.err}; }
    val temporary: str = named.ok;
    fin { str_free(a, temporary); }
    var t:       Temporary      = Temporary{a: a, path: temporary, destination: destination};
    val written: err[fail.Fail] = write(ctx, ?t);
    if (sel written.err) { ret err[fail.Fail].err{temporary_removed(a, temporary, written.err)}; }
    val renamed: err[io_error.Error] = fs.rename(temporary, destination);
    if (sel renamed.err) {
        val op: fail.Op = fail.Op{verb: "publish", path: destination, link: "from its temporary", other: temporary};
        ret err[fail.Fail].err{temporary_removed(a, temporary, fail.refusal(a, diagnostic_kind.FS_WRITE, op, fail.Cause.io{renamed.err}))};
    }
    ret err[fail.Fail].ok{};
}

# `failed`, the failure of a write through `temporary`, once the temporary is
# removed: a temporary the write never made is no failure, and one that stays
# is named as a secondary failure
fun temporary_removed(a: *A.Allocator, temporary: str, failed: fail.Fail) fail.Fail {
    val removed: err[io_error.Error] = fs.remove_file(temporary);
    if (sel removed.ok)                         { ret failed; }
    if (removed.err.kind == io_error.NOT_FOUND) { ret failed; }
    ret fail.with_secondary(a, failed, fail.refusal(a, diagnostic_kind.FS_REMOVE, fail.Op{verb: "remove", role: "the temporary", path: temporary}, fail.Cause.io{removed.err}));
}
