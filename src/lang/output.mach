# output: how a compiler-controlled file reaches its final name. a build
# product under `out/` is regenerable by the next build or `mach clean`, so
# it is written in place with no staging, lock or journal, except an `obj/`
# object: the object cache reads it back, so it goes through
# `through_temporary`. a file in the source tree goes through `replace`. both
# write a sibling temporary and rename it over the destination, so an
# interrupted write leaves the original intact. the build owns its output
# layout: `directory` and `reserve` replace a stale entry of the wrong kind,
# and every failure names the path and the operation
use mach.lang.build.outcome;
use mach.lang.fail;
use mach.lang.intern;
use fixture: mach.lang.output.testing;
use A:       std.allocator;
use std.allocator.page;
use std.collections.vector;
use std.collections.vector.Vector;
use std.crypto.rand;
use fs: std.filesystem;
use std.format;
use io_error: std.io.error;
use mwriter:  std.io.writer;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;
use std.types.string.str_join;
use std.types.string.str_len;
use std.types.string.str_replace;

pub val DIR_MODE: i32 = 0o755;

pub fun intern_message(itn: *intern.Interner, a: *A.Allocator, buf: *u8, total: usize, generic: str) str {
    buf[total] = 0;
    val res_id: res[intern.StrId, A.Error] = intern.intern(itn, buf::str);
    A.deallocate[u8](a, buf, total + 1);
    if (sel res_id.err) { ret generic; }
    val opt_name: opt[str] = intern.lookup(itn, res_id.ok);
    if (sel opt_name.some) { ret opt_name.some; }
    ret generic;
}

pub fun io_message(itn: *intern.Interner, a: *A.Allocator, op: str, path: str, os_error: str, generic: str) str {
    if (itn == nil || path == nil) { ret generic; }
    val res_msg: res[str, format.FormatError] = format.sprint(a, "{} '{}': {}", op, path, os_error);
    if (sel res_msg.err) { ret generic; }
    val buf: str = res_msg.ok;
    ret intern_message(itn, a, buf, str_len(buf), generic);
}

# `<op> '<path>': <detail>`, interned when `itn` is given and otherwise owned by `a`
fun message(itn: *intern.Interner, a: *A.Allocator, op: str, path: str, detail: str, generic: str) str {
    if (itn != nil) { ret io_message(itn, a, op, path, detail, generic); }
    val res_msg: res[str, format.FormatError] = format.sprint(a, "{} '{}': {}", op, path, detail);
    if (sel res_msg.err) { ret generic; }
    ret res_msg.ok;
}

fun layout_fail(a: *A.Allocator, op: str, at: str, detail: str) err[outcome.Fail] {
    ret err[outcome.Fail].err{outcome.environment(message(nil, a, op, at, detail, op))};
}

# `p` lies strictly beneath `root`, both read as cleaned paths
fun beneath(a: *A.Allocator, root: str, p: str) bool {
    if (root == nil) { ret false; }
    val clean_root: res[str, A.Error] = path.clean(a, root);
    if (sel clean_root.err) { ret false; }
    fin { str_free(a, clean_root.ok); }
    val clean_p: res[str, A.Error] = path.clean(a, p);
    if (sel clean_p.err) { ret false; }
    fin { str_free(a, clean_p.ok); }
    val r:  str   = clean_root.ok;
    val c:  str   = clean_p.ok;
    val rl: usize = str_len(r);
    if (rl == 0 || str_len(c) <= rl + 1) { ret false; }
    var i: usize = 0;
    for (i < rl) {
        if (r[i] != c[i]) { ret false; }
        i = i + 1;
    }
    ret path.is_separator(c[rl]) || path.is_separator(r[rl - 1]);
}

# the build owns the layout beneath its output root: `dir` and each missing
# ancestor become directories, and beneath `root` an entry where one belongs
# that does not resolve to a directory (a stale file, a dangling link) is
# removed first, a link as the link and never its target. `root` itself and
# what lies above it or outside it are created but never replaced, and a
# symlink to a directory is used as it stands
pub fun directory(a: *A.Allocator, root: str, dir: str) err[outcome.Fail] {
    if (path.is_empty(dir) || path.is_root(dir)) { ret err[outcome.Fail].ok{}; }
    val present: res[bool, io_error.Error] = fs.is_dir(dir);
    if (sel present.err) { ret layout_fail(a, "cannot inspect directory", dir, outcome.io_text(present.err)); }
    if (present.ok)      { ret err[outcome.Fail].ok{}; }
    if (!beneath(a, root, dir)) {
        val created: err[fs.FsError] = fs.create_dir_all(a, dir, DIR_MODE);
        if (sel created.err) { ret layout_fail(a, "cannot create directory", dir, outcome.fs_text(created.err)); }
        ret err[outcome.Fail].ok{};
    }
    val parent: res[str, A.Error] = path.parent(a, dir);
    if (sel parent.err) { ret err[outcome.Fail].err{outcome.refused(parent.err)}; }
    val above: err[outcome.Fail] = directory(a, root, parent.ok);
    str_free(a, parent.ok);
    if (sel above.err) { ret above; }
    val stale: res[bool, io_error.Error] = fs.exists(dir);
    if (sel stale.err) { ret layout_fail(a, "cannot inspect directory", dir, outcome.io_text(stale.err)); }
    if (stale.ok) {
        val removed: err[io_error.Error] = fs.remove_file(dir);
        if (sel removed.err) { ret layout_fail(a, "cannot replace stale file", dir, outcome.io_text(removed.err)); }
    }
    val made: err[io_error.Error] = fs.create_dir(dir, DIR_MODE);
    if (sel made.ok) { ret err[outcome.Fail].ok{}; }
    # a concurrent writer that made it first is as good
    val now: res[bool, io_error.Error] = fs.is_dir(dir);
    if (sel now.ok && now.ok) { ret err[outcome.Fail].ok{}; }
    ret layout_fail(a, "cannot create directory", dir, outcome.io_text(made.err));
}

# ready `file` to be written: its parent is a directory as `directory` makes
# it, and beneath `root` a stale directory at its own name is removed. a
# symlink there is left for the write to follow
pub fun reserve(a: *A.Allocator, root: str, file: str) err[outcome.Fail] {
    val parent: res[str, A.Error] = path.parent(a, file);
    if (sel parent.err) { ret err[outcome.Fail].err{outcome.refused(parent.err)}; }
    val made: err[outcome.Fail] = directory(a, root, parent.ok);
    str_free(a, parent.ok);
    if (sel made.err)            { ret made; }
    if (!beneath(a, root, file)) { ret err[outcome.Fail].ok{}; }
    val found: res[fs.Metadata, io_error.Error] = fs.metadata_link(file);
    if (sel found.err) {
        if (found.err.kind == io_error.NOT_FOUND) { ret err[outcome.Fail].ok{}; }
        ret layout_fail(a, "cannot inspect", file, outcome.io_text(found.err));
    }
    var meta: fs.Metadata = found.ok;
    if (!fs.meta_is_dir(?meta)) { ret err[outcome.Fail].ok{}; }
    val removed: err[fs.FsError] = fs.remove_all(a, file);
    if (sel removed.err) { ret layout_fail(a, "cannot replace stale directory", file, outcome.fs_text(removed.err)); }
    ret err[outcome.Fail].ok{};
}

# write `buf` to `path`, whose parent exists
pub fun bytes(itn: *intern.Interner, a: *A.Allocator, path: str, buf: *u8, len: usize, mode: i32,
    op: str, generic: str) err[outcome.Fail] {
    val written: err[fs.FsError] = fs.write_bytes(path, buf, len, mode);
    if (sel written.err) {
        ret err[outcome.Fail].err{outcome.environment(message(itn, a, op, path, outcome.fs_text(written.err), generic))};
    }
    ret err[outcome.Fail].ok{};
}

# stream `path`, whose parent exists, through `write_cb`
pub fun writer[W](itn: *intern.Interner, a: *A.Allocator, path: str, ctx: *W,
    write_cb: fun(*W, *mwriter.Writer) err[mwriter.WriteError], mode: i32,
    op: str, generic: str) err[outcome.Fail] {
    val created: res[fs.File, io_error.Error] = fs.create(path, mode);
    if (sel created.err) {
        ret err[outcome.Fail].err{outcome.environment(message(itn, a, op, path, outcome.io_text(created.err), generic))};
    }
    var file:   fs.File                 = created.ok;
    var w:      mwriter.Writer          = fs.writer(file);
    val wrote:  err[mwriter.WriteError] = write_cb(ctx, ?w);
    val closed: err[io_error.Error]     = fs.close(?file);
    if (sel wrote.err) {
        ret err[outcome.Fail].err{outcome.environment(message(itn, a, op, path, "write failed", generic))};
    }
    if (sel closed.err) {
        ret err[outcome.Fail].err{outcome.environment(message(itn, a, op, path, outcome.io_text(closed.err), generic))};
    }
    ret err[outcome.Fail].ok{};
}

# replace a source-tree file through a sibling temporary and rename, so the
# destination is either the old content or the complete new content
pub fun replace(a: *A.Allocator, path: str, buf: *u8, len: usize, mode: i32) err[outcome.Fail] {
    val replaced: err[fs.FsError] = fs.replace_bytes_atomic(a, path, buf, len, mode, DIR_MODE);
    if (sel replaced.err) { ret err[outcome.Fail].err{outcome.environment(outcome.fs_text(replaced.err))}; }
    ret err[outcome.Fail].ok{};
}

# the file a module's output takes under `base`: its dotted name as a path,
# with `suffix` as the extension
pub fun mirror_fqn(a: *A.Allocator, base: *u8, fqn: str, suffix: str) res[str, outcome.Fail] {
    val rel_r: res[str, string.StrError] = str_replace(a, fqn, ".", "/");
    if (sel rel_r.err) { ret res[str, outcome.Fail].err{outcome.environment(outcome.str_text(rel_r.err))}; }
    val rel: str = rel_r.ok;
    fin { str_free(a, rel); }
    val leaf_r: res[str, string.StrError] = str_join(a, rel, ".", suffix);
    if (sel leaf_r.err) { ret res[str, outcome.Fail].err{outcome.environment(outcome.str_text(leaf_r.err))}; }
    val leaf: str = leaf_r.ok;
    fin { str_free(a, leaf); }
    val join_r: res[path.Path, A.Error] = path.join(a, base::str, leaf);
    if (sel join_r.err) { ret res[str, outcome.Fail].err{outcome.refused(join_r.err)}; }
    ret res[str, outcome.Fail].ok{join_r.ok};
}

val HEX: str = "0123456789abcdef";

# `<destination>.tmp-<16 random hex digits>`, beside the destination so the
# rename stays on one filesystem
fun temporary_name(a: *A.Allocator, destination: str) res[str, outcome.Fail] {
    var random: [8]u8;
    val filled: err[io_error.Error] = rand.fill(?random[0], 8);
    if (sel filled.err) { ret res[str, outcome.Fail].err{outcome.environment(outcome.io_text(filled.err))}; }
    var digits: [17]u8;
    var i:      usize = 0;
    for (i < 8) {
        digits[i * 2]     = HEX[(random[i] >> 4)::usize];
        digits[i * 2 + 1] = HEX[(random[i] & 0x0f)::usize];
        i                 = i + 1;
    }
    digits[16] = 0;
    val named: res[str, string.StrError] = str_join(a, destination, ".tmp-", (?digits[0])::str);
    if (sel named.err) { ret res[str, outcome.Fail].err{outcome.environment(outcome.str_text(named.err))}; }
    ret res[str, outcome.Fail].ok{named.ok};
}

# `write` fills a sibling temporary of `destination`, which is then renamed
# over it: a reader sees the previous file or the complete new one, never a
# torn one, and a failed write leaves the previous file and no temporary
pub fun through_temporary[C](a: *A.Allocator, destination: str, ctx: *C,
    write: fun(*C, str) err[fail.Fail]) err[outcome.Fail] {
    val named: res[str, outcome.Fail] = temporary_name(a, destination);
    if (sel named.err) { ret err[outcome.Fail].err{named.err}; }
    val temporary: str = named.ok;
    fin { str_free(a, temporary); }
    val written: err[fail.Fail] = write(ctx, temporary);
    if (sel written.err) {
        fs.remove_file(temporary);
        ret err[outcome.Fail].err{outcome.from_fail(written.err)};
    }
    val renamed: err[io_error.Error] = fs.rename(temporary, destination);
    if (sel renamed.err) {
        fs.remove_file(temporary);
        ret err[outcome.Fail].err{outcome.environment(message(nil, a, "cannot publish", destination, outcome.io_text(renamed.err), "cannot publish an object"))};
    }
    ret err[outcome.Fail].ok{};
}

#[testing]
rec TornWrite {
    bytes: str;
    fails: bool;
}

# writes its bytes, then fails part way when asked, as an interrupted writer would
#[testing]
fun t_torn_write(w: *TornWrite, destination: str) err[fail.Fail] {
    val written: err[fs.FsError] = fs.write_bytes(destination, w.bytes, str_len(w.bytes), 0o644);
    if (sel written.err) { ret err[fail.Fail].err{fail.message("torn write could not write")}; }
    if (w.fails)         { ret err[fail.Fail].err{fail.message("interrupted")}; }
    ret err[fail.Fail].ok{};
}

#[testing]
fun t_holds(a: *A.Allocator, file: str, expected: str) bool {
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(a, file);
    if (sel read.err) { ret false; }
    var bytes: Vector[u8] = read.ok;
    fin { vector.dnit[u8](?bytes); }
    if (bytes.len != str_len(expected)) { ret false; }
    var i: usize = 0;
    for (i < bytes.len) {
        if (bytes.data[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun t_entries(a: *A.Allocator, directory: str) usize {
    val listed: res[Vector[str], fs.FsError] = fs.read_dir(a, directory);
    if (sel listed.err) { ret 0; }
    var names: Vector[str] = listed.ok;
    val count: usize       = names.len;
    var i:     usize       = 0;
    for (i < names.len) {
        str_free(a, names.data[i]);
        i = i + 1;
    }
    vector.dnit[str](?names);
    ret count;
}

test through_temporary__an_interrupted_write_leaves_the_previous_file_whole {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?a, "through-temporary");
    if (sel created.err) { ret 1; }
    var file: fixture.Output = created.ok;
    fin { fixture.dnit(?file); }
    val closed: err[outcome.Fail] = fixture.close(?file);
    if (sel closed.err) { ret 1; }
    val destination: str               = fixture.path(?file);
    var first:       TornWrite         = TornWrite{bytes: "the previous object", fails: false};
    val wrote:       err[outcome.Fail] = through_temporary[TornWrite](?a, destination, ?first, t_torn_write);
    if (sel wrote.err)                                    { ret 2; }
    if (!t_holds(?a, destination, "the previous object")) { ret 3; }
    var torn:   TornWrite         = TornWrite{bytes: "half", fails: true};
    val failed: err[outcome.Fail] = through_temporary[TornWrite](?a, destination, ?torn, t_torn_write);
    if (sel failed.ok)                                    { ret 4; }
    if (!t_holds(?a, destination, "the previous object")) { ret 5; }
    # the directory holds the destination and nothing the torn write left behind
    if (t_entries(?a, file.directory) != 1) { ret 6; }
    var next:     TornWrite         = TornWrite{bytes: "the next object", fails: false};
    val replaced: err[outcome.Fail] = through_temporary[TornWrite](?a, destination, ?next, t_torn_write);
    if (sel replaced.err)                             { ret 7; }
    if (!t_holds(?a, destination, "the next object")) { ret 8; }
    if (t_entries(?a, file.directory) != 1)           { ret 9; }
    ret 0;
}
