use std.types.result.res;
use std.types.option.opt;
use mach.lang.fail;
use io_error: std.io.error;
use page: std.allocator.page;
use vector: std.collections.vector;
use std.collections.vector.Vector;
use print: std.print;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use fs: std.filesystem;

use mach.lang.fuzz.asm;
use mach.lang.fuzz.attributes;
use mach.lang.fuzz.dwarf;
use mach.lang.fuzz.ir;
use mach.lang.fuzz.lexer;
use mach.lang.fuzz.manifest;
use mach.lang.fuzz.mir;
use mach.lang.fuzz.of;
use mach.lang.fuzz.parser;
use mach.lang.fuzz.reloc;
use mach.lang.fuzz.verdict.Verdict;

pub val FUZZ_HARNESS: i32 = 1;
pub val FUZZ_FINDING: i32 = 2;

pub def AnswerFn: fun(*A.Allocator, *u8, usize) Verdict;

pub rec Boundary {
    name:   str;
    answer: AnswerFn;
}

pub val BOUNDARY_CAP: usize = 32;

fun put(out: *Boundary, i: usize, name: str, answer: AnswerFn) usize {
    if (i >= BOUNDARY_CAP) { ret i; }
    out[i].name   = name;
    out[i].answer = answer;
    ret i + 1;
}

pub fun boundaries(out: *Boundary) usize {
    var i: usize = 0;
    i = put(out, i, "elf",   of.answer_elf);
    i = put(out, i, "coff",  of.answer_coff);
    i = put(out, i, "macho", of.answer_macho);
    i = put(out, i, "ar",    of.answer_ar);
    i = put(out, i, "spv",   of.answer_spv);
    i = put(out, i, "lexer", lexer.answer);
    i = put(out, i, "parser", parser.answer);
    i = put(out, i, "manifest", manifest.answer);
    i = put(out, i, "asm", asm.answer);
    i = put(out, i, "reloc", reloc.answer);
    i = put(out, i, "riscv-attributes", attributes.answer);
    i = put(out, i, "ir", ir.answer);
    i = put(out, i, "mir", mir.answer);
    i = put(out, i, "dwarf", dwarf.answer);
    ret i;
}

pub fun lookup(table: *Boundary, n: usize, name: str) opt[AnswerFn] {
    var i: usize = 0;
    for (i < n) {
        if (str_equals(table[i].name, name)) { ret opt[AnswerFn].some{table[i].answer}; }
        i = i + 1;
    }
    ret opt[AnswerFn].none{};
}

fun join_path(alloc: *A.Allocator, dir: str, name: str) res[str, fail.Fail] {
    val dl: usize = str_len(dir);
    val nl: usize = str_len(name);
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, dl + nl + 2);
    if (sel rb.err) { ret res[str, fail.Fail].err{fail.message("fuzz: out of memory joining a path")}; }
    val buf: *u8 = rb.ok;
    var i: usize = 0;
    for (i < dl) { buf[i] = dir[i]::u8; i = i + 1; }
    buf[dl] = '/'::u8;
    var j: usize = 0;
    for (j < nl) { buf[dl + 1 + j] = name[j]::u8; j = j + 1; }
    buf[dl + 1 + nl] = 0;
    ret res[str, fail.Fail].ok{buf::str};
}

fun find_root(alloc: *A.Allocator) opt[str] {
    var prefix: str = ".";
    var depth: usize = 0;
    for (depth < 8) {
        val rj: res[str, fail.Fail] = join_path(alloc, prefix, "test/fuzz/corpus");
        if (sel rj.err) { ret opt[str].none{}; }
        val is_dir_r: res[bool, io_error.Error] = fs.is_dir(rj.ok);
        if ((sel is_dir_r.ok && is_dir_r.ok)) { ret opt[str].some{prefix}; }
        val ru: res[str, fail.Fail] = join_path(alloc, prefix, "..");
        if (sel ru.err) { ret opt[str].none{}; }
        prefix = ru.ok;
        depth = depth + 1;
    }
    ret opt[str].none{};
}

fun answer_file(alloc: *A.Allocator, answer: AnswerFn, path: str) i32 {
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, path);
    if (sel rb.err) { ret FUZZ_HARNESS; }
    var bytes: Vector[u8] = rb.ok;

    val rc: res[*u8, A.Error] = A.allocate[u8](alloc, bytes.len + 1);
    if (sel rc.err) { vector.dnit[u8](?bytes); ret FUZZ_HARNESS; }
    val buf: *u8 = rc.ok;
    var i: usize = 0;
    for (i < bytes.len) { buf[i] = bytes.data[i]; i = i + 1; }
    buf[bytes.len] = 0;

    val v: Verdict = answer(alloc, buf, bytes.len);
    A.deallocate[u8](alloc, buf, bytes.len + 1);
    vector.dnit[u8](?bytes);

    if (v.finding) {
        print.eprintlnf("fuzz: FINDING {} broke an invariant: {}", path, v.detail);
        ret FUZZ_FINDING;
    }
    if (!str_equals(v.detail, "")) {
        print.eprintlnf("fuzz: {} rejected: {}", path, v.detail);
    }
    ret 0;
}

fun answer_directory(alloc: *A.Allocator, root: str, name: str, answer: AnswerFn) i32 {
    val rd: res[str, fail.Fail] = join_path(alloc, root, "test/fuzz/corpus");
    if (sel rd.err) { ret FUZZ_HARNESS; }
    val rf: res[str, fail.Fail] = join_path(alloc, rd.ok, name);
    if (sel rf.err) { ret FUZZ_HARNESS; }
    val dir: str = rf.ok;

    val listed: res[Vector[str], fs.FsError] = fs.read_dir(alloc, dir);
    if (sel listed.err) {
        print.eprintlnf("fuzz: cannot list the retained corpus for {}", name);
        ret FUZZ_HARNESS;
    }
    var names: Vector[str] = listed.ok;

    var seen: usize = 0;
    var i: usize = 0;
    for (i < names.len) {
        val rg: opt[*str] = vector.get[str](?names, i);
        if (sel rg.none) { ret FUZZ_HARNESS; }
        val entry: str = @rg.some;
        i = i + 1;
        if (str_equals(entry, ".") || str_equals(entry, "..")) { cnt; }
        val rj: res[str, fail.Fail] = join_path(alloc, dir, entry);
        if (sel rj.err) { ret FUZZ_HARNESS; }
        val path: str = rj.ok;
        val is_file_r: res[bool, io_error.Error] = fs.is_file(path);
        if (!(sel is_file_r.ok && is_file_r.ok)) { cnt; }
        val code: i32 = answer_file(alloc, answer, path);
        if (code != 0) { ret code; }
        seen = seen + 1;
    }
    if (seen == 0) {
        print.eprintlnf("fuzz: the retained corpus for {} is empty, so it checked nothing", name);
        ret FUZZ_HARNESS;
    }
    ret 0;
}

fun every_corpus_directory_is_registered(alloc: *A.Allocator, root: str,
                                         table: *Boundary, n: usize) bool {
    val rd: res[str, fail.Fail] = join_path(alloc, root, "test/fuzz/corpus");
    if (sel rd.err) { ret false; }
    val dir: str = rd.ok;
    val listed: res[Vector[str], fs.FsError] = fs.read_dir(alloc, dir);
    if (sel listed.err) { ret false; }
    var names: Vector[str] = listed.ok;

    var ok: bool = true;
    var i: usize = 0;
    for (i < names.len) {
        val rg: opt[*str] = vector.get[str](?names, i);
        if (sel rg.none) { ret false; }
        val entry: str = @rg.some;
        i = i + 1;
        if (str_equals(entry, ".") || str_equals(entry, "..")) { cnt; }
        val rj: res[str, fail.Fail] = join_path(alloc, dir, entry);
        if (sel rj.err) { ret false; }
        val is_dir_r: res[bool, io_error.Error] = fs.is_dir(rj.ok);
        if (!(sel is_dir_r.ok && is_dir_r.ok)) { cnt; }
        val lookup_r: opt[AnswerFn] = lookup(table, n, entry);
        if (sel lookup_r.none) {
            print.eprintlnf("fuzz: corpus directory {} names no registered boundary", entry);
            ok = false;
        }
    }
    ret ok;
}

fun env_value(name: *u8, buf: *u8, cap: usize) bool {
    val n: i64 = os.getenv(name, buf, cap);
    if (n < 0 || n::usize >= cap) { ret false; }
    buf[n::usize] = 0;
    ret true;
}

test "mach.lang.fuzz.corpus:every_retained_input_is_answered" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val rr: opt[str] = find_root(?alloc);
    if (sel rr.none) {
        print.eprintln("fuzz: cannot locate test/fuzz/corpus from the working directory");
        ret FUZZ_HARNESS;
    }
    val root: str = rr.some;

    var table: [BOUNDARY_CAP]Boundary;
    val n: usize = boundaries(?table[0]);
    if (n >= BOUNDARY_CAP) {
        print.eprintln("fuzz: the boundary table is full, so a boundary was dropped");
        ret FUZZ_HARNESS;
    }

    var b: usize = 0;
    for (b < n) {
        val code: i32 = answer_directory(?alloc, root, table[b].name, table[b].answer);
        if (code != 0) { ret code; }
        b = b + 1;
    }
    if (!every_corpus_directory_is_registered(?alloc, root, ?table[0], n)) { ret FUZZ_HARNESS; }
    ret 0;
}

test "mach.lang.fuzz.candidate:one_input_named_by_the_environment" {
    var name_buf: [64]u8;
    var path_buf: [4096]u8;
    if (!env_value("MACH_FUZZ_BOUNDARY"::*u8, ?name_buf[0], 64)) { ret 0; }
    if (!env_value("MACH_FUZZ_INPUT"::*u8,    ?path_buf[0], 4096)) { ret 0; }

    var alloc: A.Allocator;
    page.make(?alloc);

    var table: [BOUNDARY_CAP]Boundary;
    val n: usize = boundaries(?table[0]);
    if (n >= BOUNDARY_CAP) {
        print.eprintln("fuzz: the boundary table is full, so a boundary was dropped");
        ret FUZZ_HARNESS;
    }

    val name: str = (?name_buf[0])::usize::str;
    val path: str = (?path_buf[0])::usize::str;
    val found: opt[AnswerFn] = lookup(?table[0], n, name);
    if (sel found.none) {
        print.eprintlnf("fuzz: no boundary named {}", name);
        ret FUZZ_HARNESS;
    }
    ret answer_file(?alloc, found.some, path);
}
