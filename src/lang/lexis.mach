use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use A: std.allocator;

use mach.lang.reference;
use lang_source: mach.lang.source;

# the reserved words: each lexes as an identifier and is refused as a name
pub val KW_ASM:   str = "asm";
pub val KW_BRK:   str = "brk";
pub val KW_CNT:   str = "cnt";
pub val KW_DEF:   str = "def";
pub val KW_EACH:  str = "each";
pub val KW_ERROR: str = "error";
pub val KW_EXT:   str = "ext";
pub val KW_FIN:   str = "fin";
pub val KW_FOR:   str = "for";
pub val KW_FUN:   str = "fun";
pub val KW_FWD:   str = "fwd";
pub val KW_IF:    str = "if";
pub val KW_IN:    str = "in";
pub val KW_NIL:   str = "nil";
pub val KW_OR:    str = "or";
pub val KW_PUB:   str = "pub";
pub val KW_REC:   str = "rec";
pub val KW_RET:   str = "ret";
pub val KW_SEL:   str = "sel";
pub val KW_TAG:   str = "tag";
pub val KW_TEST:  str = "test";
pub val KW_UNI:   str = "uni";
pub val KW_USE:   str = "use";
pub val KW_VAL:   str = "val";
pub val KW_VAR:   str = "var";

# every reserved word above, the set `is_keyword` answers from
val KEYWORD_COUNT: u32 = 25;

val KEYWORDS: [KEYWORD_COUNT]str = [KEYWORD_COUNT]str{
    KW_ASM, KW_BRK, KW_CNT, KW_DEF, KW_EACH, KW_ERROR, KW_EXT, KW_FIN, KW_FOR,
    KW_FUN, KW_FWD, KW_IF, KW_IN, KW_NIL, KW_OR, KW_PUB, KW_REC, KW_RET, KW_SEL,
    KW_TAG, KW_TEST, KW_UNI, KW_USE, KW_VAL, KW_VAR,
};

# `text[0..len]` is a reserved word
pub fun is_keyword(text: str, len: usize) bool {
    var i: u32 = 0;
    for (i < KEYWORD_COUNT) {
        if (str_len(KEYWORDS[i]) == len && str_region_equals(text, 0, len, KEYWORDS[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun is_ident_start(c: u8) bool {
    ret (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

pub fun is_ident_char(c: u8) bool {
    ret is_ident_start(c) || (c >= '0' && c <= '9');
}

# `text[0..len]` lexes as exactly one identifier token; keywords lex as identifiers too
pub fun is_identifier(text: str, len: usize) bool {
    if (len == 0 || !is_ident_start(text[0]::u8)) { ret false; }
    var i: usize = 1;
    for (i < len) {
        if (!is_ident_char(text[i]::u8)) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun keyword_at(i: usize) str {
    ret KEYWORDS[i];
}

# grammar.md's `keyword` production is the reserved words, each once
test grammar_doc__keyword_is_the_reserved_words {
    var alloc: A.Allocator;
    page.make(?alloc);
    val text: opt[str] = reference.page_or_report(?alloc, "doc/language/grammar.md");
    if (sel text.none) { ret 1; }
    val words: opt[lang_source.Span] = reference.production(text.some, "keyword");
    if (sel words.none)                                                                                                                  { ret 2; }
    if (!reference.agree(?alloc, "grammar.md keyword", text.some, words.some, reference.WORDS_QUOTED, keyword_at, KEYWORD_COUNT::usize)) { ret 3; }
    ret 0;
}
