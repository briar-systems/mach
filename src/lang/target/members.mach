# every member of each target axis, the one place a member is named outside
# its own modules: register_all adds these in order, and the catalog check
# holds them against the catalog. the dwarf debug model is the backend's, so
# register_all takes it from its caller
use mach.lang.target.abi;
use mach.lang.target.abi.aapcs64;
use abi_riscv: mach.lang.target.abi.riscv;
use abi_spirv: mach.lang.target.abi.spirv;
use mach.lang.target.abi.sysv;
use mach.lang.target.abi.win64;
use mach.lang.target.isa;
use arm64_register: mach.lang.target.isa.arm64.register;
use riscv_register: mach.lang.target.isa.riscv.register;
use spirv_register: mach.lang.target.isa.spirv.register;
use x64_register:   mach.lang.target.isa.x64.register;
use target_of:      mach.lang.target.of;
use mach.lang.target.of.coff;
use mach.lang.target.of.elf;
use mach.lang.target.of.macho;
use mach.lang.target.of.raw;
use mach.lang.target.of.spv;
use lang_target_os:   mach.lang.target.os;
use target_os_darwin: mach.lang.target.os.darwin;
use mach.lang.target.os.freestanding;
use target_os_linux:   mach.lang.target.os.linux;
use target_os_windows: mach.lang.target.os.windows;

pub val ISA_COUNT: u32 = 5;

pub val ISAS: [ISA_COUNT]*isa.IsaVTable = [ISA_COUNT]*isa.IsaVTable{
    ?x64_register.VTABLE,
    ?arm64_register.VTABLE,
    ?riscv_register.VTABLE64,
    ?riscv_register.VTABLE32,
    ?spirv_register.VTABLE,
};

pub val ABI_COUNT: u32 = 10;

pub val ABIS: [ABI_COUNT]*abi.AbiVTable = [ABI_COUNT]*abi.AbiVTable{
    ?sysv.VTABLE,
    ?win64.VTABLE,
    ?aapcs64.VTABLE,
    ?abi_riscv.LP64,
    ?abi_riscv.LP64F,
    ?abi_riscv.LP64D,
    ?abi_riscv.ILP32,
    ?abi_riscv.ILP32F,
    ?abi_riscv.ILP32D,
    ?abi_spirv.VTABLE,
};

pub val FORMAT_COUNT: u32 = 5;

pub val FORMATS: [FORMAT_COUNT]*target_of.OfVTable = [FORMAT_COUNT]*target_of.OfVTable{
    ?elf.VTABLE,
    ?coff.VTABLE,
    ?macho.VTABLE,
    ?raw.VTABLE,
    ?spv.VTABLE,
};

pub val OS_COUNT: u32 = 4;

pub val OSES: [OS_COUNT]*lang_target_os.OsVTable = [OS_COUNT]*lang_target_os.OsVTable{
    ?target_os_linux.VTABLE,
    ?target_os_darwin.VTABLE,
    ?target_os_windows.VTABLE,
    ?freestanding.VTABLE,
};

# the debug models the target tree declares itself, beside the caller's dwarf
pub val DEBUG_COUNT: u32 = 1;

pub val DEBUGS: [DEBUG_COUNT]*target_of.DebugVTable = [DEBUG_COUNT]*target_of.DebugVTable{
    ?spv.DEBUG,
};
