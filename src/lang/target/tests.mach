# the boundary of the target description: the front end and the middle end
# read the description layer and never reach a backend module through the
# imports the compiler is built from
use mach.lang.fail;
use std.allocator.page;
use collections_vector: std.collections.vector;
use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_ends_with;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use isa_tests: mach.lang.target.isa.tests;
use A: std.allocator;
use std.collections.vector.Vector;
use fs: std.filesystem;

# one source module: its path under the source root, its name and the modules
# its production imports name, by index once every module is known
#[testing]
rec Module {
    name:   str;
    path:   str;
    uses:   Vector[str];
    edges:  Vector[usize];
    parent: usize;
    seen:   bool;
}

#[testing]
val NONE: usize = 0xFFFFFFFFFFFFFFFF;

#[testing]
val LAYER_HARNESS: i32 = 1;
#[testing]
val LAYER_CROSSED: i32 = 2;

# the modules the front end and the middle end may read under the target tree:
# every other target module is a backend member, contract or facade
#[testing]
fun is_description(name: str) bool {
    if (str_region_equals(name, 0, 25, "mach.lang.target.catalog.")) { ret true; }
    if (str_equals(name, "mach.lang.target.extension"))             { ret true; }
    if (str_region_equals(name, 0, 27, "mach.lang.target.extension.")) { ret true; }
    if (str_equals(name, "mach.lang.target.model"))                 { ret true; }
    if (str_equals(name, "mach.lang.target.definition"))            { ret true; }
    ret str_equals(name, "mach.lang.target.resolved");
}

#[testing]
fun is_backend(name: str) bool {
    if (str_equals(name, "mach.lang.be") || str_region_equals(name, 0, 13, "mach.lang.be.")) { ret true; }
    if (str_equals(name, "mach.lang.target") || str_region_equals(name, 0, 17, "mach.lang.target.")) {
        ret !is_description(name);
    }
    ret false;
}

#[testing]
fun is_guarded(name: str) bool {
    if (str_equals(name, "mach.lang.fe") || str_region_equals(name, 0, 13, "mach.lang.fe.")) { ret true; }
    ret str_equals(name, "mach.lang.me") || str_region_equals(name, 0, 13, "mach.lang.me.");
}

# the module name of `path` under `src`: its path below the root, dotted, under `mach.`
#[testing]
fun module_name(alloc: *A.Allocator, src: str, path: str) res[str, fail.Fail] {
    val skip: usize = str_len(src) + 1;
    val len:  usize = str_len(path) - skip - 5;
    val rb:   res[*u8, A.Error] = A.allocate[u8](alloc, len + 6);
    if (sel rb.err) { ret res[str, fail.Fail].err{fail.refused(rb.err)}; }
    val buf: *u8 = rb.ok;
    buf[0] = 'm'::u8;
    buf[1] = 'a'::u8;
    buf[2] = 'c'::u8;
    buf[3] = 'h'::u8;
    buf[4] = '.'::u8;
    var i: usize = 0;
    for (i < len) {
        var c: u8 = path[skip + i]::u8;
        if (c == '/'::u8) { c = '.'::u8; }
        buf[5 + i] = c;
        i          = i + 1;
    }
    buf[5 + len] = 0;
    ret res[str, fail.Fail].ok{buf::str};
}

#[testing]
fun collect(alloc: *A.Allocator, src: str, dir: str, mods: *Vector[Module]) err[fail.Fail] {
    val rd: res[Vector[str], fs.FsError] = fs.read_dir(alloc, dir);
    if (sel rd.err) { ret err[fail.Fail].err{fail.fs_refused(rd.err)}; }
    var names: Vector[str] = rd.ok;
    var i:     usize       = 0;
    for (i < names.len) {
        val rg: opt[*str] = collections_vector.get[str](?names, i);
        if (sel rg.none) { ret err[fail.Fail].err{fail.message("index out of bounds")}; }
        val name: str = @rg.some;
        i = i + 1;
        if (str_equals(name, ".") || str_equals(name, "..")) { cnt; }
        val rj: res[str, fail.Fail] = isa_tests.join_path(alloc, dir, name);
        if (sel rj.err) { ret err[fail.Fail].err{rj.err}; }
        val path: str = rj.ok;
        if (isa_tests.probe(fs.is_dir(path))) {
            val e: err[fail.Fail] = collect(alloc, src, path, mods);
            if (sel e.err) { ret e; }
            cnt;
        }
        if (!str_ends_with(path, ".mach")) { cnt; }
        val rn: res[str, fail.Fail] = module_name(alloc, src, path);
        if (sel rn.err) { ret err[fail.Fail].err{rn.err}; }
        var m: Module;
        m.name   = rn.ok;
        m.path   = path;
        m.uses   = collections_vector.init[str](alloc);
        m.edges  = collections_vector.init[usize](alloc);
        m.parent = NONE;
        m.seen   = false;
        val pushed: res[usize, A.Error] = collections_vector.push[Module](mods, m);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

#[testing]
fun is_name_char(c: u8) bool {
    if (c >= 'a'::u8 && c <= 'z'::u8) { ret true; }
    if (c >= 'A'::u8 && c <= 'Z'::u8) { ret true; }
    if (c >= '0'::u8 && c <= '9'::u8) { ret true; }
    ret c == '_'::u8 || c == '.'::u8;
}

#[testing]
fun skip_blank(text: str, at: usize, end: usize) usize {
    var p: usize = at;
    for (p < end && (text[p] == ' ' || text[p] == '\t')) { p = p + 1; }
    ret p;
}

# the path a `use` line names, nil when the line is no `use`; a `use` the line
# before marks `#[testing]` is a test's import and names nothing here
#[testing]
fun use_path(alloc: *A.Allocator, text: str, at: usize, end: usize) res[str, fail.Fail] {
    var p: usize = skip_blank(text, at, end);
    if (p + 4 <= end && str_region_equals(text, p, 4, "pub ")) { p = skip_blank(text, p + 4, end); }
    if (p + 4 > end || !str_region_equals(text, p, 4, "use ")) { ret res[str, fail.Fail].ok{nil}; }
    p = skip_blank(text, p + 4, end);
    var q: usize = p;
    for (q < end && is_name_char(text[q]::u8)) { q = q + 1; }
    val after: usize = skip_blank(text, q, end);
    if (after < end && text[after] == ':') {
        p = skip_blank(text, after + 1, end);
        q = p;
        for (q < end && is_name_char(text[q]::u8)) { q = q + 1; }
    }
    if (q == p) { ret res[str, fail.Fail].ok{nil}; }
    ret isa_tests.str_slice(alloc, text, p, q - p);
}

#[testing]
fun read_uses(alloc: *A.Allocator, m: *Module) err[fail.Fail] {
    val rt: res[str, fs.FsError] = fs.read_string(alloc, m.path);
    if (sel rt.err) { ret err[fail.Fail].err{fail.fs_refused(rt.err)}; }
    val text:    str   = rt.ok;
    val n:       usize = str_len(text);
    var start:   usize = 0;
    var testing: bool  = false;
    for (start < n) {
        var end: usize = start;
        for (end < n && text[end] != '\n') { end = end + 1; }
        val first: usize = skip_blank(text, start, end);
        if (first < end) {
            val ru: res[str, fail.Fail] = use_path(alloc, text, start, end);
            if (sel ru.err) { ret err[fail.Fail].err{ru.err}; }
            if (ru.ok != nil && !testing) {
                val pushed: res[usize, A.Error] = collections_vector.push[str](?m.uses, ru.ok);
                if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
            }
            testing = str_region_equals(text, first, 10, "#[testing]");
        }
        start = end + 1;
    }
    ret err[fail.Fail].ok{};
}

#[testing]
fun find(mods: *Vector[Module], name: str, len: usize) usize {
    var i: usize = 0;
    for (i < mods.len) {
        val rg: opt[*Module] = collections_vector.get[Module](mods, i);
        if (sel rg.some) {
            val m: *Module = rg.some;
            if (str_len(m.name) == len && str_region_equals(name, 0, len, m.name)) { ret i; }
        }
        i = i + 1;
    }
    ret NONE;
}

# the module a use path imports: the longest dotted prefix that names one
#[testing]
fun target_of_use(mods: *Vector[Module], path: str) usize {
    var len: usize = str_len(path);
    for (len > 0) {
        val at: usize = find(mods, path, len);
        if (at != NONE) { ret at; }
        for (len > 0 && path[len - 1] != '.') { len = len - 1; }
        if (len > 0) { len = len - 1; }
    }
    ret NONE;
}

#[testing]
fun at(mods: *Vector[Module], i: usize) *Module {
    val rg: opt[*Module] = collections_vector.get[Module](mods, i);
    if (sel rg.some) { ret rg.some; }
    ret nil;
}

# every module the production imports of the marked modules reach, each
# reached module remembering the one that first imported it
#[testing]
fun reach(mods: *Vector[Module], queue: *Vector[usize]) err[fail.Fail] {
    var head: usize = 0;
    for (head < queue.len) {
        val rq: opt[*usize] = collections_vector.get[usize](queue, head);
        if (sel rq.none) { ret err[fail.Fail].err{fail.message("index out of bounds")}; }
        val m: *Module = at(mods, @rq.some);
        head = head + 1;
        var e: usize = 0;
        for (e < m.edges.len) {
            val re: opt[*usize] = collections_vector.get[usize](?m.edges, e);
            if (sel re.none) { ret err[fail.Fail].err{fail.message("index out of bounds")}; }
            val next: *Module = at(mods, @re.some);
            if (!next.seen) {
                next.seen   = true;
                next.parent = @rq.some;
                val pushed: res[usize, A.Error] = collections_vector.push[usize](queue, @re.some);
                if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
            }
            e = e + 1;
        }
    }
    ret err[fail.Fail].ok{};
}

#[testing]
fun clear(mods: *Vector[Module]) {
    var i: usize = 0;
    for (i < mods.len) {
        val m: *Module = at(mods, i);
        m.seen   = false;
        m.parent = NONE;
        i        = i + 1;
    }
}

test description__front_and_middle_end_reach_no_backend {
    var alloc: A.Allocator;
    page.make(?alloc);

    val rr: opt[str] = isa_tests.find_root(?alloc);
    if (!sel rr.some) {
        print.eprintln("layering: cannot locate the source root from the working directory");
        ret LAYER_HARNESS;
    }
    val rs: res[str, fail.Fail] = isa_tests.join_path(?alloc, rr.some, "src");
    if (sel rs.err) { ret LAYER_HARNESS; }
    val src: str = rs.ok;

    var mods: Vector[Module] = collections_vector.init[Module](?alloc);
    val walked: err[fail.Fail] = collect(?alloc, src, src, ?mods);
    if (sel walked.err) {
        print.eprintlnf("layering: the walk failed: {}", fail.describe(walked.err));
        ret LAYER_HARNESS;
    }
    var i: usize = 0;
    for (i < mods.len) {
        val m:    *Module        = at(?mods, i);
        val read: err[fail.Fail] = read_uses(?alloc, m);
        if (sel read.err) {
            print.eprintlnf("layering: cannot read {}: {}", m.path, fail.describe(read.err));
            ret LAYER_HARNESS;
        }
        var u: usize = 0;
        for (u < m.uses.len) {
            val rp: opt[*str] = collections_vector.get[str](?m.uses, u);
            if (sel rp.some) {
                val to: usize = target_of_use(?mods, @rp.some);
                if (to != NONE && to != i) {
                    val pushed: res[usize, A.Error] = collections_vector.push[usize](?m.edges, to);
                    if (sel pushed.err) { ret LAYER_HARNESS; }
                }
            }
            u = u + 1;
        }
        i = i + 1;
    }

    # the production modules: what the compiler's entry reaches
    val entry: usize = find(?mods, "mach.bin.main", 13);
    if (entry == NONE) {
        print.eprintln("layering: no module mach.bin.main under the source root");
        ret LAYER_HARNESS;
    }
    var queue: Vector[usize] = collections_vector.init[usize](?alloc);
    at(?mods, entry).seen = true;
    val qe: res[usize, A.Error] = collections_vector.push[usize](?queue, entry);
    if (sel qe.err) { ret LAYER_HARNESS; }
    val reached: err[fail.Fail] = reach(?mods, ?queue);
    if (sel reached.err) { ret LAYER_HARNESS; }

    # from every production module of the front end and the middle end at once
    var roots: Vector[usize] = collections_vector.init[usize](?alloc);
    i = 0;
    for (i < mods.len) {
        val m: *Module = at(?mods, i);
        if (m.seen && is_guarded(m.name)) {
            val pushed: res[usize, A.Error] = collections_vector.push[usize](?roots, i);
            if (sel pushed.err) { ret LAYER_HARNESS; }
        }
        i = i + 1;
    }
    if (roots.len == 0) {
        print.eprintln("layering: the entry reaches no front or middle end module, so nothing was checked");
        ret LAYER_HARNESS;
    }
    clear(?mods);
    i = 0;
    for (i < roots.len) {
        val rg: opt[*usize] = collections_vector.get[usize](?roots, i);
        if (sel rg.some) { at(?mods, @rg.some).seen = true; }
        i = i + 1;
    }
    val guarded: err[fail.Fail] = reach(?mods, ?roots);
    if (sel guarded.err) { ret LAYER_HARNESS; }

    var crossed: usize = 0;
    i = 0;
    for (i < mods.len) {
        val m: *Module = at(?mods, i);
        if (m.seen && is_backend(m.name)) {
            crossed = crossed + 1;
            print.eprintlnf("layering: {} is reached from the front or middle end:", m.name);
            var step: usize = m.parent;
            for (step != NONE) {
                val by: *Module = at(?mods, step);
                print.eprintlnf("    imported by {}", by.name);
                step = by.parent;
            }
        }
        i = i + 1;
    }
    if (crossed != 0) {
        print.eprintlnf("layering: {} backend module(s) reached; import the description layer instead", crossed);
        ret LAYER_CROSSED;
    }
    ret 0;
}
