# the layering of the compiler, through the imports it is built from: the
# front end and the middle end read only the description layer, the target
# tree reaches no module of the backend pipeline, the backend contract under
# mach.lang.mir reaches neither side beyond the description, and no module's
# test imports climb above the layer the module sits in
use mach.lang.fail;
use std.allocator.page;
use collections_vector: std.collections.vector;
use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_ends_with;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use isa_tests: mach.lang.target.isa.tests;
use A:         std.allocator;
use std.collections.vector.Vector;
use fs: std.filesystem;

# one source module: its path under the source root, its name and the modules
# its production imports name, by index once every module is known
#[testing]
rec Module {
    name:  str;
    path:  str;
    uses:  Vector[str];
    edges: Vector[usize];
    # the imports a `#[testing]` mark confines to tests, and what they name
    test_uses:  Vector[str];
    test_edges: Vector[usize];
    parent:     usize;
    seen:       bool;
    # the compiler's entry reaches it
    production: bool;
}

#[testing]
val NONE: usize = 0xFFFFFFFFFFFFFFFF;

#[testing]
val LAYER_HARNESS: i32 = 1;
#[testing]
val LAYER_CROSSED: i32 = 2;

# the modules the front end and the middle end may read under the target tree:
# every other target module is a backend member, contract or facade
#[testing]
fun is_description(name: str) bool {
    if (str_region_equals(name, 0, 25, "mach.lang.target.catalog."))   { ret true; }
    if (str_equals(name, "mach.lang.target.extension"))                { ret true; }
    if (str_region_equals(name, 0, 27, "mach.lang.target.extension.")) { ret true; }
    if (str_equals(name, "mach.lang.target.model"))                    { ret true; }
    if (str_region_equals(name, 0, 23, "mach.lang.target.model."))     { ret true; }
    if (str_equals(name, "mach.lang.target.definition"))               { ret true; }
    ret str_equals(name, "mach.lang.target.resolved");
}

#[testing]
fun is_backend(name: str) bool {
    if (str_equals(name, "mach.lang.be") || str_region_equals(name, 0, 13, "mach.lang.be.")) { ret true; }
    if (str_equals(name, "mach.lang.target") || str_region_equals(name, 0, 17, "mach.lang.target.")) {
        ret !is_description(name);
    }
    ret false;
}

#[testing]
fun is_pipeline(name: str) bool {
    ret str_equals(name, "mach.lang.be") || str_region_equals(name, 0, 13, "mach.lang.be.");
}

#[testing]
fun is_target(name: str) bool {
    ret str_equals(name, "mach.lang.target") || str_region_equals(name, 0, 17, "mach.lang.target.");
}

#[testing]
fun is_contract(name: str) bool {
    ret str_equals(name, "mach.lang.mir") || str_region_equals(name, 0, 14, "mach.lang.mir.");
}

# what the contract may not reach: the pipeline, and any target module but the description
#[testing]
fun is_contract_forbidden(name: str) bool {
    if (is_pipeline(name)) { ret true; }
    ret is_target(name) && !is_description(name);
}

#[testing]
fun is_guarded(name: str) bool {
    if (str_equals(name, "mach.lang.fe") || str_region_equals(name, 0, 13, "mach.lang.fe.")) { ret true; }
    ret str_equals(name, "mach.lang.me") || str_region_equals(name, 0, 13, "mach.lang.me.");
}

# the module name of `path` under `src`: its path below the root, dotted, under `mach.`
#[testing]
fun module_name(alloc: *A.Allocator, src: str, path: str) res[str, fail.Fail] {
    val skip: usize             = str_len(src) + 1;
    val len:  usize             = str_len(path) - skip - 5;
    val rb:   res[*u8, A.Error] = A.allocate[u8](alloc, len + 6);
    if (sel rb.err) { ret res[str, fail.Fail].err{fail.refused(rb.err)}; }
    val buf: *u8 = rb.ok;
    buf[0] = 'm'::u8;
    buf[1] = 'a'::u8;
    buf[2] = 'c'::u8;
    buf[3] = 'h'::u8;
    buf[4] = '.'::u8;
    var i: usize = 0;
    for (i < len) {
        var c: u8 = path[skip + i]::u8;
        if (c == '/'::u8) { c = '.'::u8; }
        buf[5 + i] = c;
        i          = i + 1;
    }
    buf[5 + len] = 0;
    ret res[str, fail.Fail].ok{buf::str};
}

#[testing]
fun collect(alloc: *A.Allocator, src: str, dir: str, mods: *Vector[Module]) err[fail.Fail] {
    val rd: res[Vector[str], fs.FsError] = fs.read_dir(alloc, dir);
    if (sel rd.err) { ret err[fail.Fail].err{fail.fs_refused(rd.err)}; }
    var names: Vector[str] = rd.ok;
    var i:     usize       = 0;
    for (i < names.len) {
        val rg: opt[*str] = collections_vector.get[str](?names, i);
        if (sel rg.none) { ret err[fail.Fail].err{fail.message("index out of bounds")}; }
        val name: str = @rg.some;
        i = i + 1;
        if (str_equals(name, ".") || str_equals(name, "..")) { cnt; }
        val rj: res[str, fail.Fail] = isa_tests.join_path(alloc, dir, name);
        if (sel rj.err) { ret err[fail.Fail].err{rj.err}; }
        val path: str = rj.ok;
        if (isa_tests.probe(fs.is_dir(path))) {
            val e: err[fail.Fail] = collect(alloc, src, path, mods);
            if (sel e.err) { ret e; }
            cnt;
        }
        if (!str_ends_with(path, ".mach")) { cnt; }
        val rn: res[str, fail.Fail] = module_name(alloc, src, path);
        if (sel rn.err) { ret err[fail.Fail].err{rn.err}; }
        var m: Module;
        m.name       = rn.ok;
        m.path       = path;
        m.uses       = collections_vector.init[str](alloc);
        m.edges      = collections_vector.init[usize](alloc);
        m.test_uses  = collections_vector.init[str](alloc);
        m.test_edges = collections_vector.init[usize](alloc);
        m.parent     = NONE;
        m.seen       = false;
        m.production = false;
        val pushed: res[usize, A.Error] = collections_vector.push[Module](mods, m);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

#[testing]
fun is_name_char(c: u8) bool {
    if (c >= 'a'::u8 && c <= 'z'::u8) { ret true; }
    if (c >= 'A'::u8 && c <= 'Z'::u8) { ret true; }
    if (c >= '0'::u8 && c <= '9'::u8) { ret true; }
    ret c == '_'::u8 || c == '.'::u8;
}

#[testing]
fun skip_blank(text: str, at: usize, end: usize) usize {
    var p: usize = at;
    for (p < end && (text[p] == ' ' || text[p] == '\t')) { p = p + 1; }
    ret p;
}

# the path a `use` line names, nil when the line is no `use`
#[testing]
fun use_path(alloc: *A.Allocator, text: str, at: usize, end: usize) res[str, fail.Fail] {
    var p: usize = skip_blank(text, at, end);
    if (p + 4 <= end && str_region_equals(text, p, 4, "pub ")) { p = skip_blank(text, p + 4, end); }
    if (p + 4 > end || !str_region_equals(text, p, 4, "use ")) { ret res[str, fail.Fail].ok{nil}; }
    p = skip_blank(text, p + 4, end);
    var q: usize = p;
    for (q < end && is_name_char(text[q]::u8)) { q = q + 1; }
    val after: usize = skip_blank(text, q, end);
    if (after < end && text[after] == ':') {
        p = skip_blank(text, after + 1, end);
        q = p;
        for (q < end && is_name_char(text[q]::u8)) { q = q + 1; }
    }
    if (q == p) { ret res[str, fail.Fail].ok{nil}; }
    ret isa_tests.str_slice(alloc, text, p, q - p);
}

#[testing]
fun read_uses(alloc: *A.Allocator, m: *Module) err[fail.Fail] {
    val rt: res[str, fs.FsError] = fs.read_string(alloc, m.path);
    if (sel rt.err) { ret err[fail.Fail].err{fail.fs_refused(rt.err)}; }
    val text:    str   = rt.ok;
    val n:       usize = str_len(text);
    var start:   usize = 0;
    var testing: bool  = false;
    for (start < n) {
        var end: usize = start;
        for (end < n && text[end] != '\n') { end = end + 1; }
        val first: usize = skip_blank(text, start, end);
        if (first < end) {
            val ru: res[str, fail.Fail] = use_path(alloc, text, start, end);
            if (sel ru.err) { ret err[fail.Fail].err{ru.err}; }
            # a `use` the line before marks `#[testing]` is a test's import
            if (ru.ok != nil) {
                var into: *Vector[str] = ?m.uses;
                if (testing) { into = ?m.test_uses; }
                val pushed: res[usize, A.Error] = collections_vector.push[str](into, ru.ok);
                if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
            }
            testing = str_region_equals(text, first, 10, "#[testing]");
        }
        start = end + 1;
    }
    ret err[fail.Fail].ok{};
}

#[testing]
fun find(mods: *Vector[Module], name: str, len: usize) usize {
    var i: usize = 0;
    for (i < mods.len) {
        val rg: opt[*Module] = collections_vector.get[Module](mods, i);
        if (sel rg.some) {
            val m: *Module = rg.some;
            if (str_len(m.name) == len && str_region_equals(name, 0, len, m.name)) { ret i; }
        }
        i = i + 1;
    }
    ret NONE;
}

# the module a use path imports: the longest dotted prefix that names one
#[testing]
fun target_of_use(mods: *Vector[Module], path: str) usize {
    var len: usize = str_len(path);
    for (len > 0) {
        val at: usize = find(mods, path, len);
        if (at != NONE) { ret at; }
        for (len > 0 && path[len - 1] != '.') { len = len - 1; }
        if (len > 0) { len = len - 1; }
    }
    ret NONE;
}

#[testing]
fun at(mods: *Vector[Module], i: usize) *Module {
    val rg: opt[*Module] = collections_vector.get[Module](mods, i);
    if (sel rg.some) { ret rg.some; }
    ret nil;
}

# every module the production imports of the marked modules reach, each
# reached module remembering the one that first imported it
#[testing]
fun reach(mods: *Vector[Module], queue: *Vector[usize]) err[fail.Fail] {
    var head: usize = 0;
    for (head < queue.len) {
        val rq: opt[*usize] = collections_vector.get[usize](queue, head);
        if (sel rq.none) { ret err[fail.Fail].err{fail.message("index out of bounds")}; }
        val m: *Module = at(mods, @rq.some);
        head = head + 1;
        var e: usize = 0;
        for (e < m.edges.len) {
            val re: opt[*usize] = collections_vector.get[usize](?m.edges, e);
            if (sel re.none) { ret err[fail.Fail].err{fail.message("index out of bounds")}; }
            val next: *Module = at(mods, @re.some);
            if (!next.seen) {
                next.seen   = true;
                next.parent = @rq.some;
                val pushed: res[usize, A.Error] = collections_vector.push[usize](queue, @re.some);
                if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
            }
            e = e + 1;
        }
    }
    ret err[fail.Fail].ok{};
}

#[testing]
fun clear(mods: *Vector[Module]) {
    var i: usize = 0;
    for (i < mods.len) {
        val m: *Module = at(mods, i);
        m.seen   = false;
        m.parent = NONE;
        i        = i + 1;
    }
}

# every source module under the root with its production imports as edges,
# each module the compiler's entry reaches marked production
#[testing]
fun production_graph(alloc: *A.Allocator, mods: *Vector[Module]) i32 {
    val rr: opt[str] = isa_tests.find_root(alloc);
    if (!sel rr.some) {
        print.eprintln("layering: cannot locate the source root from the working directory");
        ret LAYER_HARNESS;
    }
    val rs: res[str, fail.Fail] = isa_tests.join_path(alloc, rr.some, "src");
    if (sel rs.err) { ret LAYER_HARNESS; }
    val src: str = rs.ok;

    val walked: err[fail.Fail] = collect(alloc, src, src, mods);
    if (sel walked.err) {
        print.eprintlnf("layering: the walk failed: {}", fail.describe(walked.err));
        ret LAYER_HARNESS;
    }
    var i: usize = 0;
    for (i < mods.len) {
        val m:    *Module        = at(mods, i);
        val read: err[fail.Fail] = read_uses(alloc, m);
        if (sel read.err) {
            print.eprintlnf("layering: cannot read {}: {}", m.path, fail.describe(read.err));
            ret LAYER_HARNESS;
        }
        var u: usize = 0;
        for (u < m.uses.len) {
            val rp: opt[*str] = collections_vector.get[str](?m.uses, u);
            if (sel rp.some) {
                val to: usize = target_of_use(mods, @rp.some);
                if (to != NONE && to != i) {
                    val pushed: res[usize, A.Error] = collections_vector.push[usize](?m.edges, to);
                    if (sel pushed.err) { ret LAYER_HARNESS; }
                }
            }
            u = u + 1;
        }
        u = 0;
        for (u < m.test_uses.len) {
            val rp: opt[*str] = collections_vector.get[str](?m.test_uses, u);
            if (sel rp.some) {
                val to: usize = target_of_use(mods, @rp.some);
                if (to != NONE && to != i) {
                    val pushed: res[usize, A.Error] = collections_vector.push[usize](?m.test_edges, to);
                    if (sel pushed.err) { ret LAYER_HARNESS; }
                }
            }
            u = u + 1;
        }
        i = i + 1;
    }

    val entry: usize = find(mods, "mach.bin.main", 13);
    if (entry == NONE) {
        print.eprintln("layering: no module mach.bin.main under the source root");
        ret LAYER_HARNESS;
    }
    var queue: Vector[usize] = collections_vector.init[usize](alloc);
    at(mods, entry).seen = true;
    val qe: res[usize, A.Error] = collections_vector.push[usize](?queue, entry);
    if (sel qe.err) { ret LAYER_HARNESS; }
    val reached: err[fail.Fail] = reach(mods, ?queue);
    if (sel reached.err) { ret LAYER_HARNESS; }
    i = 0;
    for (i < mods.len) {
        val m: *Module = at(mods, i);
        m.production = m.seen;
        i            = i + 1;
    }
    clear(mods);
    ret 0;
}

#[testing]
def NamePredicate: fun(str) bool;

# from every production module `root` picks at once, the modules their imports
# reach, transitively; LAYER_HARNESS when `root` picks none, since nothing
# would be checked
#[testing]
fun reach_from(alloc: *A.Allocator, mods: *Vector[Module], root: NamePredicate, what: str) i32 {
    clear(mods);
    var roots: Vector[usize] = collections_vector.init[usize](alloc);
    var i:     usize         = 0;
    for (i < mods.len) {
        val m: *Module = at(mods, i);
        if (m.production && root(m.name)) {
            m.seen = true;
            val pushed: res[usize, A.Error] = collections_vector.push[usize](?roots, i);
            if (sel pushed.err) { ret LAYER_HARNESS; }
        }
        i = i + 1;
    }
    if (roots.len == 0) {
        print.eprintlnf("layering: the entry reaches no module of {}, so nothing was checked", what);
        ret LAYER_HARNESS;
    }
    val reached: err[fail.Fail] = reach(mods, ?roots);
    if (sel reached.err) { ret LAYER_HARNESS; }
    ret 0;
}

# every reached module `forbidden` picks, printed with the chain that imports it
#[testing]
fun crossings(mods: *Vector[Module], forbidden: NamePredicate, what: str) usize {
    var crossed: usize = 0;
    var i:       usize = 0;
    for (i < mods.len) {
        val m: *Module = at(mods, i);
        if (m.seen && forbidden(m.name)) {
            crossed = crossed + 1;
            print.eprintlnf("layering: {} is reached from {}:", m.name, what);
            var step: usize = m.parent;
            for (step != NONE) {
                val by: *Module = at(mods, step);
                print.eprintlnf("    imported by {}", by.name);
                step = by.parent;
            }
        }
        i = i + 1;
    }
    ret crossed;
}

test description__front_and_middle_end_reach_no_backend {
    var alloc: A.Allocator;
    page.make(?alloc);
    var mods:  Vector[Module] = collections_vector.init[Module](?alloc);
    val built: i32            = production_graph(?alloc, ?mods);
    if (built != 0) { ret built; }

    val reached: i32 = reach_from(?alloc, ?mods, is_guarded, "the front or middle end");
    if (reached != 0) { ret reached; }
    val crossed: usize = crossings(?mods, is_backend, "the front or middle end");
    if (crossed != 0) {
        print.eprintlnf("layering: {} backend module(s) reached; import the description layer instead", crossed);
        ret LAYER_CROSSED;
    }
    ret 0;
}

# the instruction-set members implement a contract both sides import, so the
# target tree never calls back into the pipeline and the contract sits below both
test contract__target_and_pipeline_meet_only_in_the_contract {
    var alloc: A.Allocator;
    page.make(?alloc);
    var mods:  Vector[Module] = collections_vector.init[Module](?alloc);
    val built: i32            = production_graph(?alloc, ?mods);
    if (built != 0) { ret built; }

    val from_target: i32 = reach_from(?alloc, ?mods, is_target, "the target tree");
    if (from_target != 0) { ret from_target; }
    var crossed: usize = crossings(?mods, is_pipeline, "the target tree");

    val from_contract: i32 = reach_from(?alloc, ?mods, is_contract, "the backend contract");
    if (from_contract != 0) { ret from_contract; }
    crossed = crossed + crossings(?mods, is_contract_forbidden, "the backend contract");
    if (crossed != 0) {
        print.eprintlnf("layering: {} module(s) crossed; move what both sides need into mach.lang.mir or the isa contract", crossed);
        ret LAYER_CROSSED;
    }
    ret 0;
}

# the layer a module sits in, lowest first: the target description, the
# front end, the middle end, the backend contract, the backend with the target
# facade, and the composition that drives them all. the middle end's pipeline
# drives its passes over a selected target, so it sits with the backend. zero
# is a module outside the layers, such as the session and the source map
# every layer shares
#[testing]
fun layer_of(name: str) u32 {
    if (is_description(name))                                                                { ret 1; }
    if (str_equals(name, "mach.lang.fe") || str_region_equals(name, 0, 13, "mach.lang.fe.")) { ret 2; }
    if (str_equals(name, "mach.lang.me.pipeline"))                                           { ret 5; }
    if (str_equals(name, "mach.lang.me") || str_region_equals(name, 0, 13, "mach.lang.me.")) { ret 3; }
    if (is_contract(name))                                                                   { ret 4; }
    if (is_backend(name))                                                                    { ret 5; }
    if (str_region_equals(name, 0, 16, "mach.lang.driver") || str_region_equals(name, 0, 16, "mach.lang.build.")
        || str_equals(name, "mach.lang.toolchain") || str_equals(name, "mach.lang.step")
        || str_equals(name, "mach.lang.editor") || str_region_equals(name, 0, 8, "mach.cli")) {
        ret 6;
    }
    ret 0;
}

# a module's tests may import what its own imports already reach, or anything
# in its layer or below; an import only its tests make never reaches above
# its layer, since the mark is no cycle escape and the edge would push the
# module up the graph
test layering__a_test_import_climbs_no_layer {
    var alloc: A.Allocator;
    page.make(?alloc);
    var mods:  Vector[Module] = collections_vector.init[Module](?alloc);
    val built: i32            = production_graph(?alloc, ?mods);
    if (built != 0) { ret built; }

    var checked: usize = 0;
    var crossed: usize = 0;
    var i:       usize = 0;
    for (i < mods.len) {
        val m:    *Module = at(?mods, i);
        val rank: u32     = layer_of(m.name);
        if (!m.production || rank == 0 || m.test_edges.len == 0) {
            i = i + 1;
            cnt;
        }
        checked = checked + 1;
        clear(?mods);
        var queue: Vector[usize] = collections_vector.init[usize](?alloc);
        m.seen = true;
        val qe: res[usize, A.Error] = collections_vector.push[usize](?queue, i);
        if (sel qe.err) { ret LAYER_HARNESS; }
        val reached: err[fail.Fail] = reach(?mods, ?queue);
        if (sel reached.err) { ret LAYER_HARNESS; }
        var e: usize = 0;
        for (e < m.test_edges.len) {
            val re: opt[*usize] = collections_vector.get[usize](?m.test_edges, e);
            if (sel re.some) {
                val to: *Module = at(?mods, @re.some);
                if (!to.seen && layer_of(to.name) > rank) {
                    crossed = crossed + 1;
                    print.eprintlnf("layering: the tests of {} import {}, a layer above it", m.name, to.name);
                }
            }
            e = e + 1;
        }
        i = i + 1;
    }
    if (checked == 0) {
        print.eprintln("layering: no layered module imports anything for its tests, so nothing was checked");
        ret LAYER_HARNESS;
    }
    if (crossed != 0) {
        print.eprintlnf("layering: {} test import(s) climb; give the module a fixture at its own layer", crossed);
        ret LAYER_CROSSED;
    }
    ret 0;
}
