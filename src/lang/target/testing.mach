use std.types.bool.bool;
use std.types.string.str;

use R: std.types.result;

use mach.lang.be.codegen.debug_input;
use mach.lang.target.of;

fun produce(req: *of.DebugProduceRequest) R.Result[R.Void, str] {
    ret R.err[R.Void, str]("target testing debug producer was invoked");
}

fun supports(tgt: *debug_input.DebugTarget) bool {
    ret tgt != nil && tgt.dwarf_reg != nil;
}

pub fun debug_descriptor() R.Result[of.DebugVTable, str] {
    var descriptor: of.DebugVTable;
    descriptor.id = of.DBG_DWARF;
    descriptor.name = "dwarf";
    descriptor.produce = produce;
    descriptor.supports = supports;
    ret R.ok[of.DebugVTable, str](descriptor);
}
