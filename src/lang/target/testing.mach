use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.result.res;

use mach.lang.be.codegen.debug_input;
use mach.lang.target.abi;
use target_of: mach.lang.target.of;

#[testing]
fun produce(req: *target_of.DebugProduceRequest) err[fail.Fail] {
    ret err[fail.Fail].err{fail.message("target testing debug producer was invoked")};
}

#[testing]
fun supports(tgt: *debug_input.DebugTarget) bool {
    ret tgt != nil && tgt.dwarf_reg != nil;
}

#[testing]
pub fun debug_descriptor() res[target_of.DebugVTable, fail.Fail] {
    ret res[target_of.DebugVTable, fail.Fail].ok{target_of.sections_debug_model(target_of.DBG_DWARF, "dwarf", produce, supports)};
}

# a register-machine scaffold convention: carriers, no banks, no hooks; only for tests that never classify
#[testing]
pub fun carriers_convention() abi.AbiVTable {
    ret abi.abi_vtable(0, "", 0, nil, nil, nil, nil, 16, 0, 0, -1, false, false, 8, 0, 8, nil);
}
