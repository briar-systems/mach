use std.types.result.res;
use std.types.error.err;
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.string.str;


use mach.lang.be.codegen.debug_input;
use mach.lang.target.abi;
use mach.lang.target.of;

fun produce(req: *of.DebugProduceRequest) err[fail.Fail] {
    ret err[fail.Fail].err{fail.message("target testing debug producer was invoked")};
}

fun supports(tgt: *debug_input.DebugTarget) bool {
    ret tgt != nil && tgt.dwarf_reg != nil;
}

pub fun debug_descriptor() res[of.DebugVTable, fail.Fail] {
    var descriptor: of.DebugVTable;
    descriptor.id = of.DBG_DWARF;
    descriptor.name = "dwarf";
    descriptor.produce = produce;
    descriptor.supports = supports;
    ret res[of.DebugVTable, fail.Fail].ok{descriptor};
}

# a register-machine scaffold convention: carriers, no banks, no hooks; only for tests that never classify
pub fun carriers_convention() abi.AbiVTable {
    ret abi.abi_vtable(0, "", 0, nil, nil, nil, nil, 16, 0, 0, -1, false, false, false, 0, 8, nil);
}
