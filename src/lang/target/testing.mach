use mach.lang.fail;
use std.types.bool.bool;
use std.types.error.err;

use mir_debug: mach.lang.mir.debug;
use mach.lang.target.abi;
use catalog_abi: mach.lang.target.catalog.abi;
use target_of:   mach.lang.target.of;

#[testing]
fun produce(req: *target_of.DebugProduceRequest) err[fail.Fail] {
    ret err[fail.Fail].err{fail.message("target testing debug producer was invoked")};
}

#[testing]
fun supports(tgt: *mir_debug.DebugTarget) bool {
    ret tgt != nil && tgt.dwarf_reg != nil;
}

# a dwarf debug model whose producer refuses, for tests that compose a registry
#[testing]
pub val DEBUG: target_of.DebugVTable = target_of.DebugVTable{
    id:       target_of.DBG_DWARF,
    name:     "dwarf",
    shape:    target_of.DEBUG_SHAPE_SECTIONS,
    produce:  produce,
    supports: supports,
};

# a register-machine scaffold convention: carriers, no banks, no hooks; only for tests that never classify
#[testing]
pub fun carriers_convention() abi.AbiVTable {
    ret abi.AbiVTable{
        passing:               catalog_abi.PASSING_CARRIERS,
        stack_align:           16,
        indirect_result_reg:   -1,
        fp_callee_saved_bytes: 8,
        arg_slot_granularity:  8,
    };
}
