# link inputs: how a link token names a file for a target, and what kind of
# input that file is
#
# where a link finds a library by name, and the files a name is looked for as,
# are mink's: the search its host row states for the target's system,
# environment and architecture. a file a pattern the loader loads names is a
# shared library, and every other a static input the link reads
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_copy;
use std.types.string.str_empty;
use std.types.string.str_ends_with;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.vector.Vector;
use fs:       std.filesystem;
use io_error: std.io.error;

use mink_fail:    mink.base.fail;
use mink_os:      mink.catalog.os;
use mink_os_list: mink.catalog.os.list;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use target_host: mach.lang.target.host;
use mach.lang.target.resolved;

pub def Kind: u8;

pub val STATIC: Kind = 0;

pub val DYNAMIC: Kind = 1;

# a resolved link input: a static file the link reads, or a shared library the
# loader finds by `text`, through `rpath` when that is not empty
pub rec Input {
    kind:               Kind;
    text:               str;
    library:            str;
    rpath:              str;
    include_referenced: bool;
}

val PATH_CAP: usize = 4096;

# whether `tok` ends as pattern `p` names a file
fun pattern_names(p: *mink_os.Pattern, tok: str) bool {
    ret !str_empty(p.suffix) && str_ends_with(tok, p.suffix) && str_len(tok) > str_len(p.suffix);
}

# whether `tok` ends as a pattern of the order `o` names a file, `loaded` the
# patterns the loader loads alone
fun order_names(o: *mink_os.Order, tok: str, loaded: bool) bool {
    var i: usize = 0;
    for (i < o.count) {
        val step: *mink_os.Step = ?o.steps[i];
        if (sel step.files) {
            var k: usize = 0;
            for (k < step.files.count) {
                val p: *mink_os.Pattern = step.files.rows[k];
                if ((!loaded || p.loaded) && pattern_names(p, tok)) { ret true; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    ret false;
}

# whether a token names a file by path rather than a library by name: it holds a
# separator, or it ends the way a file any system of mink's catalog searches for
# is named
pub fun token_is_path(tok: *u8) bool {
    if (tok == nil || str_empty(tok::str))  { ret false; }
    if (types_path.has_separator(tok::str)) { ret true; }
    var s: usize = 0;
    for (s < mink_os_list.count()) {
        val sys: *mink_os.System = mink_os_list.at(s);
        var h:   usize           = 0;
        for (h < sys.host_count) {
            val naming: opt[*mink_os.Naming] = sys.hosts[h].naming;
            if (sel naming.some) {
                if (order_names(?naming.some.static_first, tok::str, false) || order_names(?naming.some.shared_first, tok::str, false)) { ret true; }
            }
            h = h + 1;
        }
        s = s + 1;
    }
    ret false;
}

# where a link for `t` finds a library by name, refused where mink states no
# host of the target or no search of it
fun search_of(a: *A.Allocator, t: *resolved.Target) res[mink_os.Search, fail.Fail] {
    if (!resolved.is_selected(t)) { ret res[mink_os.Search, fail.Fail].err{fail.message("link inputs: no target is selected")}; }
    val s: res[mink_os.Search, mink_fail.Fail] = mink_os.search(t.sys, t.env, t.arch);
    if (sel s.err) { ret res[mink_os.Search, fail.Fail].err{target_host.refusal(a, s.err)}; }
    ret res[mink_os.Search, fail.Fail].ok{s.ok};
}

# the input a link token names for the target `t`: a path, as written or under
# `root`, or a bare name searched for as the target's host searches static first,
# on `dirs`, the working directory and the host's library directories
pub fun token_resolve(a: *A.Allocator, t: *resolved.Target, dirs: *Vector[str],
    root: str, tok: *u8) res[Input, fail.Fail] {
    val search_r: res[mink_os.Search, fail.Fail] = search_of(a, t);
    if (sel search_r.err) { ret res[Input, fail.Fail].err{search_r.err}; }
    var search: mink_os.Search = search_r.ok;
    var buf:    [PATH_CAP]u8;
    if (token_is_path(tok)) {
        val located: res[bool, fail.Fail] = path_locate(a, tok, root, ?buf[0]);
        if (sel located.err) { ret res[Input, fail.Fail].err{located.err}; }
        if (!located.ok) {
            ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_NOT_FOUND, "cannot find link input '{}'", tok::str)};
        }
        var kind: Kind = STATIC;
        if (sel search.naming.some) {
            if (order_names(?search.naming.some.shared_first, tok::str, true)) { kind = DYNAMIC; }
        }
        ret input_of(a, kind, ?buf[0]);
    }
    if (sel search.naming.none) {
        ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_FORMAT,
            "'{}' cannot be linked by name: mink states no library naming for the target's system", tok::str)};
    }
    val order: *mink_os.Order = ?search.naming.some.static_first;
    var i:     usize          = 0;
    for (i < order.count) {
        val step: *mink_os.Step = ?order.steps[i];
        i = i + 1;
        if (!(sel step.files)) { cnt; }
        val found: res[opt[Kind], fail.Fail] = files_search(a, ?step.files, dirs, ?search, tok, ?buf[0]);
        if (sel found.err)     { ret res[Input, fail.Fail].err{found.err}; }
        if (sel found.ok.some) { ret input_of(a, found.ok.some, ?buf[0]); }
    }
    ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_NOT_FOUND, "cannot find link input '{}'", tok::str)};
}

# the file a step of a search finds for the name `tok`: every directory tried, each
# for every pattern in order, its path written to `buf`, with its kind
fun files_search(a: *A.Allocator, files: *mink_os.Files, dirs: *Vector[str], search: *mink_os.Search, tok: *u8, buf: *u8) res[opt[Kind], fail.Fail] {
    val total: usize = dirs.len + 1 + search.libdir_count;
    var d:     usize = 0;
    for (d < total) {
        var dir: *u8 = nil;
        if (d < dirs.len) { dir = dirs.data[d]::*u8; }
        or (d > dirs.len) { dir = search.libdirs[d - dirs.len - 1]::*u8; }
        var k: usize = 0;
        for (k < files.count) {
            val p:       *mink_os.Pattern     = files.rows[k];
            var parts:   [3]str               = [3]str{p.prefix, tok::str, p.suffix};
            val present: res[bool, fail.Fail] = candidate_present(a, tok, buf, dir, ?parts[0], 3);
            if (sel present.err) { ret res[opt[Kind], fail.Fail].err{present.err}; }
            if (present.ok) {
                if (p.loaded) { ret res[opt[Kind], fail.Fail].ok{opt[Kind].some{DYNAMIC}}; }
                ret res[opt[Kind], fail.Fail].ok{opt[Kind].some{STATIC}};
            }
            k = k + 1;
        }
        d = d + 1;
    }
    ret res[opt[Kind], fail.Fail].ok{opt[Kind].none{}};
}

fun input_of(a: *A.Allocator, kind: Kind, path: *u8) res[Input, fail.Fail] {
    val copied: res[str, types_string.StrError] = str_copy(a, path);
    if (sel copied.err) { ret res[Input, fail.Fail].err{fail.str_refused(copied.err)}; }
    var input: Input;
    input.kind               = kind;
    input.text               = copied.ok;
    input.library            = "";
    input.rpath              = "";
    input.include_referenced = false;
    ret res[Input, fail.Fail].ok{input};
}

# whether the file a path token names exists, as written or under `root` when
# relative, its path written to `buf`
fun path_locate(a: *A.Allocator, tok: *u8, root: str, buf: *u8) res[bool, fail.Fail] {
    var parts:   [1]str               = [1]str{tok::str};
    val written: res[bool, fail.Fail] = candidate_present(a, tok, buf, nil, ?parts[0], 1);
    if (sel written.err)             { ret written; }
    if (written.ok)                  { ret written; }
    if (types_path.is_abs(tok::str)) { ret written; }
    val joined: res[str, A.Error] = types_path.join(a, root, tok::str);
    if (sel joined.err) { ret res[bool, fail.Fail].err{fail.refused(joined.err)}; }
    parts[0] = joined.ok;
    ret candidate_present(a, tok, buf, nil, ?parts[0], 1);
}

# `dir`, a separator, then the `count` parts at `parts` written to `buf` with its
# terminator, false when they do not fit in `cap` bytes
fun path_write(buf: *u8, cap: usize, dir: *u8, parts: *str, count: u32) bool {
    var k: usize = 0;
    var i: usize = 0;
    if (dir != nil) {
        val dl: usize = str_len(dir::str);
        if (dl + 2 > cap) { ret false; }
        for (i < dl) {
            buf[k] = dir[i];
            k      = k + 1;
            i      = i + 1;
        }
        if (k > 0 && buf[k - 1] != '/') {
            buf[k] = '/';
            k      = k + 1;
        }
    }
    var p: u32 = 0;
    for (p < count) {
        val part: str   = parts[p];
        val pl:   usize = str_len(part);
        if (k + pl + 1 > cap) { ret false; }
        i = 0;
        for (i < pl) {
            buf[k] = part[i];
            k      = k + 1;
            i      = i + 1;
        }
        p = p + 1;
    }
    buf[k] = 0;
    ret true;
}

# whether `dir` and the concatenated `parts`, written to `buf`, name a file; a
# path longer than a link input's path can be is refused, naming the input `tok`
fun candidate_present(a: *A.Allocator, tok: *u8, buf: *u8, dir: *u8, parts: *str, count: u32) res[bool, fail.Fail] {
    if (!path_write(buf, PATH_CAP, dir, parts, count)) {
        ret res[bool, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_NOT_FOUND,
            "a path searched for link input '{}' is longer than {} bytes", tok::str, PATH_CAP)};
    }
    ret file_present(a, buf);
}

# a system framework, which mink does not search for yet
pub fun framework_resolve(a: *A.Allocator, t: *resolved.Target, name: *u8) res[Input, fail.Fail] {
    ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_FORMAT,
        "framework link input '{}' waits for mink to search frameworks (mink#537)", name::str)};
}

# whether `p` names a regular file; a query the system refuses, other than for
# a path that does not exist, is a failure
fun file_present(a: *A.Allocator, p: *u8) res[bool, fail.Fail] {
    val r: res[bool, io_error.Error] = fs.is_file(p);
    if (sel r.err) {
        ret res[bool, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_UNREADABLE,
            "cannot inspect link input '{}': {}", p::str, fail.io_text(r.err))};
    }
    ret res[bool, fail.Fail].ok{r.ok};
}
