# link inputs: how a link token names a file for a target, and what kind of
# input that file is. each object format declares how its inputs are named and
# recognizes their bytes, so a token is resolved here without knowing a format
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs:       std.filesystem;
use io_error: std.io.error;
use std.process.env;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_copy;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;
use std.allocator.page;

use lang_target: mach.lang.target;
use mach.lang.target.of.bin;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.target.binding;
use mach.lang.target.members;
use target_of: mach.lang.target.of;
use mach.lang.target.of.ar;

pub def Kind: u8;

pub val STATIC: Kind = 0;

pub val DYNAMIC: Kind = 1;

# a resolved link input: a static file the link reads, or a shared library the
# loader finds by `text` (its loader name), through `rpath` when that is not empty
pub rec Input {
    kind:               Kind;
    text:               str;
    library:            str;
    rpath:              str;
    include_referenced: bool;
}

val PATH_CAP: usize = 4096;

# whether a token names a file by path rather than a library by name: it holds
# a separator, or it ends the way a registered object format names an input
pub fun token_is_path(tok: *u8) bool {
    if (tok == nil || str_empty(tok::str))  { ret false; }
    if (types_path.has_separator(tok::str)) { ret true; }
    var i: u32 = 0;
    for (i < members.FORMAT_COUNT) {
        val vt: *target_of.OfVTable = members.FORMATS[i];
        if (static_names(vt.inputs, tok) || shared_names(vt, tok)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun static_names(naming: *target_of.InputNaming, tok: *u8) bool {
    if (naming == nil) { ret false; }
    val n: usize = str_len(tok::str);
    var i: u32   = 0;
    for (i < naming.static_suffix_count) {
        val suffix: str   = naming.static_suffixes[i];
        val sl:     usize = str_len(suffix);
        if (n > sl && tok[n - sl - 1] == '.' && target_of.path_has_suffix(tok, suffix, naming.folds_case)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun shared_names(vt: *target_of.OfVTable, tok: *u8) bool {
    ret vt.inputs != nil && vt.inputs.shared != nil && vt.inputs.shared.names(tok);
}

# the registered format whose shared library a path names, nil when none
fun shared_format(tok: *u8) *target_of.OfVTable {
    var i: u32 = 0;
    for (i < members.FORMAT_COUNT) {
        if (shared_names(members.FORMATS[i], tok)) { ret members.FORMATS[i]; }
        i = i + 1;
    }
    ret nil;
}

# the input a link token names for the target: a path is read as written, or
# from `root` when it is relative and not found as written; a bare name is
# searched for as a static input on `dirs` and the working directory, then as
# a shared library on `dirs` and the system's library directories
pub fun token_resolve(a: *A.Allocator, tgt: *binding.Binding, dirs: *Vector[str],
    root: str, tok: *u8) res[Input, fail.Fail] {
    val claimant: *target_of.OfVTable = shared_format(tok);
    if (claimant != nil) { ret shared_path_resolve(a, tgt, claimant, root, tok); }

    if (tgt.of == nil || tgt.of.inputs == nil) {
        ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_FORMAT,
            "'{}' cannot be linked: the target's object format takes no link inputs", tok::str)};
    }
    val naming: *target_of.InputNaming = tgt.of.inputs;
    var buf:    [PATH_CAP]u8;
    var found:  bool                   = false;
    if (token_is_path(tok)) {
        found = path_locate(a, tok, root, ?buf[0]);
    }
    or {
        found = static_search(naming, dirs, tok, ?buf[0]);
        if (!found && naming.shared != nil && naming.shared.candidate != nil) {
            val shared: res[opt[Input], fail.Fail] = shared_search(a, tgt, naming.shared, dirs, tok);
            if (sel shared.err)     { ret res[Input, fail.Fail].err{shared.err}; }
            if (sel shared.ok.some) { ret res[Input, fail.Fail].ok{shared.ok.some}; }
        }
    }
    if (!found) {
        ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_NOT_FOUND, "cannot find link input '{}'", tok::str)};
    }

    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(a, ?buf[0]);
    if (sel read.err) { ret res[Input, fail.Fail].err{unreadable(a, ?buf[0], read.err)}; }
    var bytes: Vector[u8] = read.ok;
    var valid: bool       = ar.is_archive(bytes.data, bytes.len);
    if (!valid && naming.object_matches != nil) { valid = naming.object_matches(bytes.data, bytes.len, tgt.target.arch_id); }
    collections_vector.dnit[u8](?bytes);
    if (!valid) {
        ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_INVALID,
            "'{}' is not a valid object or archive for the selected target", (?buf[0])::str)};
    }
    val copied: res[str, types_string.StrError] = str_copy(a, ?buf[0]);
    if (sel copied.err) { ret res[Input, fail.Fail].err{fail.str_refused(copied.err)}; }
    var input: Input;
    input.kind    = STATIC;
    input.text    = copied.ok;
    input.library = "";
    input.rpath   = "";
    ret res[Input, fail.Fail].ok{input};
}

# a path that names a shared library of the format `vt`
fun shared_path_resolve(a: *A.Allocator, tgt: *binding.Binding, vt: *target_of.OfVTable,
    root: str, tok: *u8) res[Input, fail.Fail] {
    val shared: *target_of.SharedNaming = vt.inputs.shared;
    if (tgt.of == nil || tgt.of.id != vt.id) {
        ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_FORMAT,
            "'{}' is {}; {} inputs require {}", tok::str, shared.noun, vt.shared_input_ext, shared.requires)};
    }
    var buf: [PATH_CAP]u8;
    if (path_locate(a, tok, root, ?buf[0])) {
        var name:       [PATH_CAP]u8;
        val identified: res[bool, fail.Fail] = shared_identify(a, shared, tgt.target.arch_id, ?buf[0], ?name[0]);
        if (sel identified.err) { ret res[Input, fail.Fail].err{identified.err}; }
        if (!identified.ok) {
            ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_INVALID,
                "'{}' is not a loadable {} for the selected architecture", (?buf[0])::str, shared.loadable)};
        }
        ret dynamic(a, ?name[0], ?buf[0], shared.runtime_prefix);
    }
    if (shared.absent == target_of.ABSENT_BY_NAME) {
        ret dynamic(a, types_path.filename(tok::str)::*u8, nil, "");
    }
    if (shared.absent == target_of.ABSENT_BY_PATH) {
        if (!str_empty(shared.runtime_prefix) && str_starts_with(tok::str, shared.runtime_prefix)) {
            ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_RPATH_UNRESOLVED,
                "a shared library input under '{}' must resolve to an existing file so its runtime search path can be retained",
                shared.runtime_prefix)};
        }
        ret dynamic(a, tok, nil, "");
    }
    ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_NOT_FOUND, "cannot find link input '{}'", tok::str)};
}

# whether the file `path` is a shared library of the kind for the instruction
# set, its loader name written to `name` when it is
fun shared_identify(a: *A.Allocator, shared: *target_of.SharedNaming, arch_id: u32,
    path: *u8, name: *u8) res[bool, fail.Fail] {
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(a, path);
    if (sel read.err) { ret res[bool, fail.Fail].err{unreadable(a, path, read.err)}; }
    var bytes: Vector[u8] = read.ok;
    name[0] = 0;
    val ok: bool = shared.identity(bytes.data, bytes.len, arch_id, path, name, PATH_CAP);
    collections_vector.dnit[u8](?bytes);
    ret res[bool, fail.Fail].ok{ok};
}

# the file a path token names, as written or under `root` when relative,
# written to `buf`
fun path_locate(a: *A.Allocator, tok: *u8, root: str, buf: *u8) bool {
    var parts: [1]str = [1]str{tok::str};
    if (target_of.path_write(buf, PATH_CAP, nil, ?parts[0], 1) && file_present(buf)) { ret true; }
    if (types_path.is_abs(tok::str))                                                 { ret false; }
    val joined: res[str, A.Error] = types_path.join(a, root, tok::str);
    if (sel joined.err) { ret false; }
    parts[0] = joined.ok;
    ret target_of.path_write(buf, PATH_CAP, nil, ?parts[0], 1) && file_present(buf);
}

# a static input a bare name finds on `dirs` and then the working directory:
# each suffix the format searches, with the library prefix and then without
fun static_search(naming: *target_of.InputNaming, dirs: *Vector[str], name: *u8, buf: *u8) bool {
    var i: usize = 0;
    for (i <= dirs.len) {
        var dir: *u8 = nil;
        if (i < dirs.len) { dir = dirs.data[i]::*u8; }
        var s: u32 = 0;
        for (s < naming.static_suffix_count) {
            var prefixed: [4]str = [4]str{naming.library_prefix, name::str, ".", naming.static_suffixes[s]};
            if (target_of.path_write(buf, PATH_CAP, dir, ?prefixed[0], 4) && file_present(buf)) { ret true; }
            if (target_of.path_write(buf, PATH_CAP, dir, ?prefixed[1], 3) && file_present(buf)) { ret true; }
            s = s + 1;
        }
        i = i + 1;
    }
    ret false;
}

# the shared library a bare name finds on `dirs` and then the system's library
# directories, none when no candidate is a loadable library for the target
fun shared_search(a: *A.Allocator, tgt: *binding.Binding, shared: *target_of.SharedNaming,
    dirs: *Vector[str], name: *u8) res[opt[Input], fail.Fail] {
    var i: usize = 0;
    for (i < dirs.len) {
        val found: res[opt[Input], fail.Fail] = shared_search_in(a, tgt, shared, dirs.data[i]::*u8, name);
        if (sel found.err)     { ret found; }
        if (sel found.ok.some) { ret found; }
        i = i + 1;
    }
    var li: u32 = 0;
    for (li < tgt.target.fs_policy.libdir_len) {
        val dir: str = tgt.target.fs_policy.libdirs[li];
        if (!str_empty(dir)) {
            val found: res[opt[Input], fail.Fail] = shared_search_in(a, tgt, shared, dir::*u8, name);
            if (sel found.err)     { ret found; }
            if (sel found.ok.some) { ret found; }
        }
        li = li + 1;
    }
    ret res[opt[Input], fail.Fail].ok{opt[Input].none{}};
}

fun shared_search_in(a: *A.Allocator, tgt: *binding.Binding, shared: *target_of.SharedNaming,
    dir: *u8, name: *u8) res[opt[Input], fail.Fail] {
    var candidate: [PATH_CAP]u8;
    var index:     u32 = 0;
    for (shared.candidate(dir, name, index, ?candidate[0], PATH_CAP)) {
        index = index + 1;
        if (!file_present(?candidate[0])) { cnt; }
        var loader:     [PATH_CAP]u8;
        val identified: res[bool, fail.Fail] = shared_identify(a, shared, tgt.target.arch_id, ?candidate[0], ?loader[0]);
        if (sel identified.err) { ret res[opt[Input], fail.Fail].err{identified.err}; }
        if (!identified.ok)     { cnt; }
        val made: res[Input, fail.Fail] = dynamic(a, ?loader[0], ?candidate[0], shared.runtime_prefix);
        if (sel made.err) { ret res[opt[Input], fail.Fail].err{made.err}; }
        ret res[opt[Input], fail.Fail].ok{opt[Input].some{made.ok}};
    }
    ret res[opt[Input], fail.Fail].ok{opt[Input].none{}};
}

# a shared library input named `name`; a name under `runtime_prefix` records
# the runtime search path that finds it as the file `found`
fun dynamic(a: *A.Allocator, name: *u8, found: *u8, runtime_prefix: str) res[Input, fail.Fail] {
    val copied: res[str, types_string.StrError] = str_copy(a, name);
    if (sel copied.err) { ret res[Input, fail.Fail].err{fail.str_refused(copied.err)}; }
    var input: Input;
    input.kind    = DYNAMIC;
    input.text    = copied.ok;
    input.library = "";
    input.rpath   = "";
    if (found != nil && !str_empty(runtime_prefix) && str_starts_with(name::str, runtime_prefix)) {
        val rpath: res[str, fail.Fail] = runtime_path(a, found, name, runtime_prefix);
        if (sel rpath.err) { ret res[Input, fail.Fail].err{rpath.err}; }
        input.rpath = rpath.ok;
    }
    ret res[Input, fail.Fail].ok{input};
}

# the directory a loader searches to find `found` by the part of its loader
# name after `prefix`: its parent for a bare file name, else the path less that
# suffix, which must end it
fun runtime_path(a: *A.Allocator, found: *u8, name: *u8, prefix: str) res[str, fail.Fail] {
    val abs_r: res[str, fail.Fail] = absolute(a, found::str);
    if (sel abs_r.err) { ret abs_r; }
    val abs:    str = abs_r.ok;
    val suffix: str = (name::usize + str_len(prefix))::str;
    if (!str_contains(suffix, "/")) {
        val parent_r: res[types_path.Path, A.Error] = types_path.parent(a, abs);
        if (sel parent_r.err) { ret res[str, fail.Fail].err{fail.refused(parent_r.err)}; }
        ret res[str, fail.Fail].ok{parent_r.ok};
    }
    val abs_len:    usize = str_len(abs);
    val suffix_len: usize = str_len(suffix);
    if (suffix_len == 0 || suffix[0] == '/' || abs_len <= suffix_len
        || !separated_suffix(abs, suffix) || !types_path.is_separator(abs[abs_len - suffix_len - 1])) {
        ret res[str, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_RPATH_MISMATCH,
            "the selected library path does not match its loader name's suffix after '{}'", prefix)};
    }
    var cut: usize = abs_len - suffix_len;
    if (cut > 1) { cut = cut - 1; }
    (abs::*u8)[cut] = 0;
    ret res[str, fail.Fail].ok{abs};
}

# whether `abs` ends in `suffix`; a loader name separates with '/', while `abs`
# was resolved through the host's own separators
fun separated_suffix(abs: str, suffix: str) bool {
    val abs_len:    usize = str_len(abs);
    val suffix_len: usize = str_len(suffix);
    if (suffix_len > abs_len) { ret false; }
    val at: usize = abs_len - suffix_len;
    var i:  usize = 0;
    for (i < suffix_len) {
        val have: u8 = abs[at + i];
        val want: u8 = suffix[i];
        if (have != want && !(types_path.is_separator(have) && types_path.is_separator(want))) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun absolute(a: *A.Allocator, p: str) res[str, fail.Fail] {
    if (types_path.is_abs(p)) {
        val clone_r: res[types_path.Path, A.Error] = types_path.clone(a, p);
        if (sel clone_r.err) { ret res[str, fail.Fail].err{fail.refused(clone_r.err)}; }
        ret res[str, fail.Fail].ok{clone_r.ok};
    }
    val cwd_r: res[types_string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel cwd_r.err) { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.FS_CURRENT_DIR, fail.env_text(cwd_r.err))}; }
    var cwd:       types_string.OwnedString      = cwd_r.ok;
    val resolve_r: res[types_path.Path, A.Error] = types_path.resolve(a, cwd.data, p);
    types_string.owned_release(?cwd);
    if (sel resolve_r.err) { ret res[str, fail.Fail].err{fail.refused(resolve_r.err)}; }
    ret res[str, fail.Fail].ok{resolve_r.ok};
}

# a system framework, which the loader finds by its install path
pub fun framework_resolve(a: *A.Allocator, tgt: *binding.Binding, name: *u8) res[Input, fail.Fail] {
    if (tgt.os == nil || str_empty(tgt.os.framework_root)) {
        ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_FORMAT,
            "framework link input '{}' requires a target whose system installs frameworks", name::str)};
    }
    val joined: res[str, types_string.StrError] = str_join(a, tgt.os.framework_root, "/", name::str, ".framework/", name::str);
    if (sel joined.err) { ret res[Input, fail.Fail].err{fail.str_refused(joined.err)}; }
    var input: Input;
    input.kind    = DYNAMIC;
    input.text    = joined.ok;
    input.library = "";
    input.rpath   = "";
    ret res[Input, fail.Fail].ok{input};
}

fun file_present(p: *u8) bool {
    val r: res[bool, io_error.Error] = fs.is_file(p);
    ret sel r.ok && r.ok;
}

fun unreadable(a: *A.Allocator, path: *u8, e: fs.FsError) fail.Fail {
    if (sel e.alloc) { ret fail.refused(e.alloc); }
    ret fail.formatted_user(a, diagnostic_kind.LINK_INPUT_UNREADABLE, "cannot read link input '{}'", path::str);
}

#[testing]
fun temp_dir(a: *A.Allocator) res[str, fail.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(a, "mach_link_input");
    if (sel tf_r.err) { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.FS_TEMP, fail.fs_text(tf_r.err))}; }
    var tf:     fs.TempFile                     = tf_r.ok;
    val root_r: res[str, types_string.StrError] = str_copy(a, fs.temp_path(?tf)::*u8);
    fs.temp_close_and_remove(?tf);
    if (sel root_r.err) { ret res[str, fail.Fail].err{fail.message(fail.str_text(root_r.err))}; }
    val root: str             = root_r.ok;
    val mk:   err[fs.FsError] = fs.create_dir_all(a, root, 493);
    if (sel mk.err) { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.FS_CREATE, fail.fs_text(mk.err))}; }
    ret res[str, fail.Fail].ok{root};
}

# a file `name` in `dir` holding `len` bytes, its path
#[testing]
fun file_put(a: *A.Allocator, dir: str, name: str, bytes: *u8, len: usize) str {
    val path_r: res[str, A.Error] = types_path.join(a, dir, name);
    if (sel path_r.err) { ret ""; }
    val wrote: err[fs.FsError] = fs.write_bytes(path_r.ok, bytes, len, 420);
    if (sel wrote.err) { ret ""; }
    ret path_r.ok;
}

# the header of an ELF64 little-endian relocatable object, or shared object
#[testing]
fun elf_put(a: *A.Allocator, dir: str, name: str, machine: u16, shared: bool) str {
    var buf: [64]u8;
    var i:   usize = 0;
    for (i < 64) {
        buf[i] = 0;
        i      = i + 1;
    }
    buf[0] = 0x7F;
    buf[1] = 0x45;
    buf[2] = 0x4C;
    buf[3] = 0x46;
    buf[4] = 2;
    buf[5] = 1;
    buf[6] = 1;
    var e_type: u16 = 1;
    if (shared) { e_type = 3; }
    bin.write_u16_le(?buf[0], 16, e_type);
    bin.write_u16_le(?buf[0], 18, machine);
    bin.write_u16_le(?buf[0], 52, 64);
    ret file_put(a, dir, name, ?buf[0], 64);
}

# the headers of a PE image for `machine`, a DLL when `dll`
#[testing]
fun pe_put(a: *A.Allocator, dir: str, name: str, machine: u16, dll: bool) str {
    var buf: [128]u8;
    var i:   usize = 0;
    for (i < 128) {
        buf[i] = 0;
        i      = i + 1;
    }
    buf[0] = 'M';
    buf[1] = 'Z';
    bin.write_u32_le(?buf[0], 0x3C, 64);
    bin.write_u32_le(?buf[0], 64, 0x00004550);
    bin.write_u16_le(?buf[0], 68, machine);
    if (dll) { bin.write_u16_le(?buf[0], 86, 0x2000); }
    ret file_put(a, dir, name, ?buf[0], 128);
}

# a 64-bit Mach-O dylib header at `off` with one LC_ID_DYLIB naming `install_name`
#[testing]
fun dylib_fill(buf: *u8, off: usize, install_name: str, cpu_type: u32) bool {
    val name_len: usize = str_len(install_name);
    if (name_len + 1 > 72) { ret false; }
    bin.write_u32_le(buf, off, 0xFEEDFACF);
    bin.write_u32_le(buf, off + 4, cpu_type);
    bin.write_u32_le(buf, off + 8, 3);
    bin.write_u32_le(buf, off + 12, 6);
    bin.write_u32_le(buf, off + 16, 1);
    bin.write_u32_le(buf, off + 20, 96);
    bin.write_u32_le(buf, off + 32, 0xD);
    bin.write_u32_le(buf, off + 36, 96);
    bin.write_u32_le(buf, off + 40, 24);
    var i: usize = 0;
    for (i < name_len) {
        buf[off + 56 + i] = install_name[i];
        i                 = i + 1;
    }
    ret true;
}

#[testing]
fun dirs_of(a: *A.Allocator, dir: str) Vector[str] {
    var dirs:   Vector[str]         = collections_vector.init[str](a);
    val pushed: res[usize, A.Error] = collections_vector.push[str](?dirs, dir);
    if (sel pushed.err) { ret dirs; }
    ret dirs;
}

test token_is_path__names_object_archive_and_shared_library_suffixes {
    if (!token_is_path("libfoo.so"::*u8))    { ret 1; }
    if (!token_is_path("libfoo.so.3"::*u8))  { ret 2; }
    if (!token_is_path("libfoo.DYLIB"::*u8)) { ret 3; }
    if (!token_is_path("foo.dll"::*u8))      { ret 4; }
    if (!token_is_path("foo.o"::*u8))        { ret 5; }
    if (!token_is_path("foo.a"::*u8))        { ret 6; }
    if (!token_is_path("foo.OBJ"::*u8))      { ret 7; }
    if (!token_is_path("foo.lib"::*u8))      { ret 8; }
    if (!token_is_path("lib/foo"::*u8))      { ret 9; }
    if (token_is_path("foo"::*u8))           { ret 10; }
    if (token_is_path("foo.bar"::*u8))       { ret 11; }
    ret 0;
}

test token_resolve__coff_searches_its_own_static_suffixes {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val win_r:   res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "windows", "win64");
    val linux_r: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    if (sel win_r.err)   { ret 1; }
    if (sel linux_r.err) { ret 1; }
    var win:    lang_target.Binding = win_r.ok;
    var linux:  lang_target.Binding = linux_r.ok;
    val root_r: res[str, fail.Fail] = temp_dir(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val lib: str = file_put(?alloc, root, "libmingw32.lib", "!<arch>\n"::*u8, 8);
    if (str_empty(lib)) { ret 1; }

    var dirs:      Vector[str]           = dirs_of(?alloc, root);
    val named:     res[Input, fail.Fail] = token_resolve(?alloc, ?win, ?dirs, "", "mingw32"::*u8);
    val explicit:  res[Input, fail.Fail] = token_resolve(?alloc, ?linux, ?dirs, "", lib::*u8);
    val elsewhere: res[Input, fail.Fail] = token_resolve(?alloc, ?linux, ?dirs, "", "mingw32"::*u8);
    if (sel named.err)           { ret 2; }
    if (named.ok.kind != STATIC) { ret 2; }
    if (sel explicit.err)        { ret 3; }
    if (sel elsewhere.ok)        { ret 4; }
    ret 0;
}

test token_resolve__a_bare_name_finds_the_shared_object_of_the_target_machine {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("aarch64", "linux", "aapcs64");
    if (sel tr.err) { ret 1; }
    var tgt:    lang_target.Binding = tr.ok;
    val root_r: res[str, fail.Fail] = temp_dir(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val host:      str = elf_put(?alloc, root, "libfoo.so", 62, true);
    val target_so: str = elf_put(?alloc, root, "libfoo.so.6", 183, true);
    if (str_empty(host) || str_empty(target_so)) { ret 1; }

    var dirs:     Vector[str]           = dirs_of(?alloc, root);
    val named:    res[Input, fail.Fail] = token_resolve(?alloc, ?tgt, ?dirs, "", "foo"::*u8);
    val explicit: res[Input, fail.Fail] = token_resolve(?alloc, ?tgt, ?dirs, "", host::*u8);
    if (sel named.err)                                                         { ret 2; }
    if (sel explicit.ok)                                                       { ret 3; }
    if (named.ok.kind != DYNAMIC || !str_equals(named.ok.text, "libfoo.so.6")) { ret 4; }
    ret 0;
}

test token_resolve__a_dylib_is_named_by_its_install_name_and_runtime_path {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "darwin", "sysv64");
    val ar: res[lang_target.Binding, fail.Fail] = lang_target.t_select("aarch64", "darwin", "aapcs64");
    if (sel tr.err) { ret 1; }
    if (sel ar.err) { ret 1; }
    var tgt:    lang_target.Binding = tr.ok;
    var arm:    lang_target.Binding = ar.ok;
    val root_r: res[str, fail.Fail] = temp_dir(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    var buf: [160]u8;
    var i:   usize = 0;
    for (i < 160) {
        buf[i] = 0;
        i      = i + 1;
    }
    if (!dylib_fill(?buf[0], 0, "@rpath/libglfw.3.dylib", 0x01000007))    { ret 1; }
    if (str_empty(file_put(?alloc, root, "libglfw.dylib", ?buf[0], 128))) { ret 1; }
    val elf: str = file_put(?alloc, root, "libhostonly.so", "ELF"::*u8, 3);
    if (str_empty(elf)) { ret 1; }

    var dirs: Vector[str]           = dirs_of(?alloc, root);
    val rr:   res[Input, fail.Fail] = token_resolve(?alloc, ?tgt, ?dirs, "", "glfw"::*u8);
    if (sel rr.err)                                                                                                   { ret 2; }
    if (rr.ok.kind != DYNAMIC || !str_equals(rr.ok.text, "@rpath/libglfw.3.dylib") || !str_equals(rr.ok.rpath, root)) { ret 3; }
    val wrong_arch:   res[Input, fail.Fail] = token_resolve(?alloc, ?arm, ?dirs, "", "glfw"::*u8);
    val wrong_format: res[Input, fail.Fail] = token_resolve(?alloc, ?tgt, ?dirs, "", elf::*u8);
    val host_only:    res[Input, fail.Fail] = token_resolve(?alloc, ?tgt, ?dirs, "", "hostonly"::*u8);
    val unresolved:   res[Input, fail.Fail] = token_resolve(?alloc, ?tgt, ?dirs, "", "@rpath/libgone.dylib"::*u8);
    if (sel wrong_arch.ok)   { ret 4; }
    if (sel wrong_format.ok) { ret 5; }
    if (sel host_only.ok)    { ret 6; }
    if (sel unresolved.ok)   { ret 7; }
    ret 0;
}

test token_resolve__a_universal_dylib_resolves_the_target_slice {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "darwin", "sysv64");
    val ar: res[lang_target.Binding, fail.Fail] = lang_target.t_select("aarch64", "darwin", "aapcs64");
    if (sel tr.err) { ret 1; }
    if (sel ar.err) { ret 1; }
    var x64:    lang_target.Binding = tr.ok;
    var arm:    lang_target.Binding = ar.ok;
    val root_r: res[str, fail.Fail] = temp_dir(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    var buf: [320]u8;
    var i:   usize = 0;
    for (i < 320) {
        buf[i] = 0;
        i      = i + 1;
    }
    bin.write_u32_be(?buf[0], 0, 0xCAFEBABE);
    bin.write_u32_be(?buf[0], 4, 2);
    bin.write_u32_be(?buf[0], 8, 0x01000007);
    bin.write_u32_be(?buf[0], 12, 3);
    bin.write_u32_be(?buf[0], 16, 64);
    bin.write_u32_be(?buf[0], 20, 128);
    bin.write_u32_be(?buf[0], 24, 6);
    bin.write_u32_be(?buf[0], 28, 0x0100000C);
    bin.write_u32_be(?buf[0], 32, 0);
    bin.write_u32_be(?buf[0], 36, 192);
    bin.write_u32_be(?buf[0], 40, 128);
    bin.write_u32_be(?buf[0], 44, 6);
    if (!dylib_fill(?buf[0], 64, "/usr/lib/libx.dylib", 0x01000007)
        || !dylib_fill(?buf[0], 192, "/usr/lib/liba.dylib", 0x0100000C)) {
        ret 1;
    }
    val path: str = file_put(?alloc, root, "libuni.dylib", ?buf[0], 320);
    if (str_empty(path)) { ret 1; }
    val x: res[Input, fail.Fail] = token_resolve(?alloc, ?x64, nil, "", path::*u8);
    val a: res[Input, fail.Fail] = token_resolve(?alloc, ?arm, nil, "", path::*u8);
    if (sel x.err)                                     { ret 2; }
    if (sel a.err)                                     { ret 3; }
    if (!str_equals(x.ok.text, "/usr/lib/libx.dylib")) { ret 4; }
    if (!str_equals(a.ok.text, "/usr/lib/liba.dylib")) { ret 5; }
    ret 0;
}

test token_resolve__a_static_object_of_another_machine_is_refused {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt:    lang_target.Binding = tr.ok;
    val root_r: res[str, fail.Fail] = temp_dir(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val wrong: str = elf_put(?alloc, root, "wrong.o", 183, false);
    val right: str = elf_put(?alloc, root, "right.o", 62, false);
    if (str_empty(wrong) || str_empty(right)) { ret 1; }
    var dirs: Vector[str]           = collections_vector.init[str](?alloc);
    val w:    res[Input, fail.Fail] = token_resolve(?alloc, ?tgt, ?dirs, "", wrong::*u8);
    val r:    res[Input, fail.Fail] = token_resolve(?alloc, ?tgt, ?dirs, "", right::*u8);
    if (sel w.ok)            { ret 2; }
    if (sel r.err)           { ret 3; }
    if (r.ok.kind != STATIC) { ret 4; }
    ret 0;
}

test token_resolve__a_dll_is_validated_against_the_target {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "windows", "win64");
    if (sel tr.err) { ret 1; }
    var tgt:    lang_target.Binding = tr.ok;
    val root_r: res[str, fail.Fail] = temp_dir(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val bad:  str = pe_put(?alloc, root, "bad.dll", 0x8664, false);
    val good: str = pe_put(?alloc, root, "good.dll", 0x8664, true);
    if (str_empty(bad) || str_empty(good)) { ret 1; }
    var dirs: Vector[str]           = collections_vector.init[str](?alloc);
    val b:    res[Input, fail.Fail] = token_resolve(?alloc, ?tgt, ?dirs, root, bad::*u8);
    val g:    res[Input, fail.Fail] = token_resolve(?alloc, ?tgt, ?dirs, root, good::*u8);
    val gone: res[Input, fail.Fail] = token_resolve(?alloc, ?tgt, ?dirs, root, "absent.dll"::*u8);
    if (sel b.ok)                                                                      { ret 2; }
    if (sel g.err)                                                                     { ret 3; }
    if (sel gone.err)                                                                  { ret 4; }
    if (!str_equals(g.ok.text, "good.dll") || !str_equals(gone.ok.text, "absent.dll")) { ret 5; }
    ret 0;
}

test token_resolve__an_archive_is_validated_by_content_not_suffix {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    if (sel tr.err) { ret 1; }
    var tgt:    lang_target.Binding = tr.ok;
    val root_r: res[str, fail.Fail] = temp_dir(?alloc);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val real: str = file_put(?alloc, root, "libreal.a", "!<arch>\n"::*u8, 8);
    val fake: str = file_put(?alloc, root, "libfake.a", "not an archive at all!!"::*u8, 23);
    if (str_empty(real) || str_empty(fake)) { ret 1; }
    var dirs: Vector[str]           = collections_vector.init[str](?alloc);
    val r:    res[Input, fail.Fail] = token_resolve(?alloc, ?tgt, ?dirs, "", real::*u8);
    val f:    res[Input, fail.Fail] = token_resolve(?alloc, ?tgt, ?dirs, "", fake::*u8);
    if (sel r.err) { ret 2; }
    if (sel f.ok)  { ret 3; }
    ret 0;
}

test token_resolve__a_format_without_link_inputs_refuses_every_token {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val tr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("spirv", "freestanding", "spirv");
    if (sel tr.err) { ret 1; }
    var tgt:  lang_target.Binding   = tr.ok;
    var dirs: Vector[str]           = collections_vector.init[str](?alloc);
    val r:    res[Input, fail.Fail] = token_resolve(?alloc, ?tgt, ?dirs, "", "foo"::*u8);
    if (sel r.ok)                                                    { ret 2; }
    if (!str_contains(fail.describe(r.err), "takes no link inputs")) { ret 3; }
    ret 0;
}

test runtime_path__matches_the_loader_name_suffix {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val base:     res[str, fail.Fail] = runtime_path(?alloc, "/opt/lib/libfoo.dylib"::*u8, "@rpath/libfoo.3.dylib"::*u8, "@rpath/");
    val nested:   res[str, fail.Fail] = runtime_path(?alloc, "/opt/lib/sub/libfoo.dylib"::*u8, "@rpath/sub/libfoo.dylib"::*u8, "@rpath/");
    val mismatch: res[str, fail.Fail] = runtime_path(?alloc, "/opt/lib/libfoo.dylib"::*u8, "@rpath/sub/libfoo.dylib"::*u8, "@rpath/");
    if (sel base.err)                                                           { ret 1; }
    if (sel nested.err)                                                         { ret 1; }
    if (sel mismatch.ok)                                                        { ret 1; }
    if (!str_equals(base.ok, "/opt/lib") || !str_equals(nested.ok, "/opt/lib")) { ret 2; }
    val native: res[str, fail.Fail] = runtime_path(?alloc, "sub\\libfoo.dylib"::*u8, "@rpath/sub/libfoo.dylib"::*u8, "@rpath/");
    $if ($mach.build.os == $mach.os.windows) {
        if (sel native.err) { ret 6; }
    }
    $or {
        if (sel native.ok) { ret 7; }
    }
    ret 0;
}

test framework_resolve__only_a_system_with_frameworks_installs_them {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val dr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("aarch64", "darwin", "aapcs64");
    val lr: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    if (sel dr.err) { ret 1; }
    if (sel lr.err) { ret 1; }
    var darwin: lang_target.Binding   = dr.ok;
    var linux:  lang_target.Binding   = lr.ok;
    val d:      res[Input, fail.Fail] = framework_resolve(?alloc, ?darwin, "AppKit"::*u8);
    val l:      res[Input, fail.Fail] = framework_resolve(?alloc, ?linux, "AppKit"::*u8);
    if (sel d.err)                                                                    { ret 2; }
    if (!str_equals(d.ok.text, "/System/Library/Frameworks/AppKit.framework/AppKit")) { ret 2; }
    if (sel l.ok)                                                                     { ret 3; }
    ret 0;
}
