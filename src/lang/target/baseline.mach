# a target's baseline: the selection of masc's catalog for its instruction set the
# target stands on before the extensions it adds, spelled as masc spells one (an
# isa string such as `rv32imc` on riscv)
#
# masc reads and spells the selection, closes it over the catalog's implications
# and says whether the architecture enters it, so mach states none of the grammar
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;

use masc_diagnostic: masc.core.diagnostic;
use masc_extension:  masc.core.extension;
use masc_set:        masc.core.set;
use masc_state:      masc.core.state;
use masc_isa:        masc.isa;
use mink_arch:       mink.catalog.arch;
use mink_arch_list:  mink.catalog.arch.list;

use mach.lang.fail;

# masc's set for mink's architecture `arch`, nil when masc registers none
fun set_of(arch: *mink_arch.Arch) *masc_set.Set {
    if (arch == nil) { ret nil; }
    val s: opt[*masc_set.Set] = masc_isa.find(?masc_isa.REGISTRY, arch);
    if (sel s.none) { ret nil; }
    ret s.some;
}

# whether masc's catalog for mink's architecture `arch` spells a selection, as
# riscv's isa strings do, so a target of it takes a `baseline`
pub fun spells(arch: *mink_arch.Arch) bool {
    val s: *masc_set.Set = set_of(arch);
    if (s == nil || s.extensions == nil) { ret false; }
    ret s.extensions.syntax != ?masc_extension.LIST;
}

# mink's architecture of the first instruction set whose masc catalog reads
# `spelling` as a selection its architecture enters, nil when none does, as an
# isa written as the selection it meant names its architecture
pub fun entered_by(a: *A.Allocator, spelling: str) *mink_arch.Arch {
    var i: usize = 0;
    for (i < mink_arch_list.count()) {
        val arch: *mink_arch.Arch = mink_arch_list.at(i);
        if (spells(arch)) {
            val read: res[masc_extension.Selection, fail.Fail] = entered(a, arch, spelling);
            if (sel read.ok) {
                var s:       masc_extension.Selection = read.ok;
                val dropped: err[A.Error]             = masc_extension.release(?s);
                ret arch;
            }
        }
        i = i + 1;
    }
    ret nil;
}

# the selection masc's catalog for mink's architecture `arch` reads from `spelling`,
# closed over its implications, refused when the catalog does not read it and when
# the architecture does not enter it, as `rv64gc` on riscv32 or an e base on an i
# architecture; released with masc_extension.release
fun entered(a: *A.Allocator, arch: *mink_arch.Arch, spelling: str) res[masc_extension.Selection, fail.Fail] {
    val set: *masc_set.Set = set_of(arch);
    if (!spells(arch)) {
        ret res[masc_extension.Selection, fail.Fail].err{fail.message("its extension catalog spells no selection")};
    }
    val row: opt[*masc_set.Arch] = masc_set.arch_of(set, arch);
    if (sel row.none) {
        ret res[masc_extension.Selection, fail.Fail].err{fail.message("masc's instruction set has no row for the architecture")};
    }
    var chosen: res[masc_extension.Selection, masc_extension.Error] = masc_extension.select(a, set.extensions, spelling, masc_diagnostic.START);
    if (sel chosen.err) {
        ret res[masc_extension.Selection, fail.Fail].err{fail.formatted(a, "masc's catalog refuses it: {}", refusal_text(chosen.err))};
    }
    var s:   masc_extension.Selection                  = chosen.ok;
    val ctx: res[masc_state.Context, masc_state.Error] = masc_state.make(?s, ?set.states, row.some.initial);
    if (sel ctx.err) {
        val dropped: err[A.Error] = masc_extension.release(?s);
        ret res[masc_extension.Selection, fail.Fail].err{fail.message("it states an execution state the architecture does not run under")};
    }
    var held: masc_state.Context = ctx.ok;
    if (!masc_state.admits(?held, row.some.enters)) {
        val dropped: err[A.Error] = masc_extension.release(?s);
        ret res[masc_extension.Selection, fail.Fail].err{fail.formatted(a, "it is not a selection {} enters", arch.name)};
    }
    ret res[masc_extension.Selection, fail.Fail].ok{s};
}

# masc's answer on a selection an `asm` head names
# ---
# refused: why the head is refused, nil when it is not
# note:    what to write instead, nil for none
pub rec Head {
    refused: str;
    note:    str;
}

val HEAD_OK: Head = Head{refused: nil, note: nil};

# the note on a head that sets execution state
val HEAD_STATE_NOTE: str = "a head may add instruction extensions only; execution state is its function's, set by `#[constant_time]` or by the target, never by a block";

# whether a head of `spelling` names a selection masc's set for the architecture called
# `arch` reads, states no execution state past the one that architecture enters at, and is
# one the architecture enters. masc reads the spelling, so mach holds none of its names
pub fun head_read(a: *A.Allocator, arch: str, spelling: str) Head {
    var found: *mink_arch.Arch = nil;
    var i:     usize           = 0;
    for (i < mink_arch_list.count() && found == nil) {
        if (str_equals(mink_arch_list.at(i).name, arch)) { found = mink_arch_list.at(i); }
        i = i + 1;
    }
    val set: *masc_set.Set = set_of(found);
    if (set == nil || set.extensions == nil) { ret Head{refused: "masc has no selection for this target's instruction set", note: nil}; }
    val row: opt[*masc_set.Arch] = masc_set.arch_of(set, found);
    if (sel row.none) { ret Head{refused: "masc has no row for this target's architecture", note: nil}; }
    var chosen: res[masc_extension.Selection, masc_extension.Error] = masc_extension.select(a, set.extensions, spelling, masc_diagnostic.START);
    if (sel chosen.err) { ret Head{refused: refusal_text(chosen.err), note: "a head is a selection of masc's for the compile target; `$if` chooses a block per target"}; }
    var s: masc_extension.Selection = chosen.ok;
    fin { val dropped: err[A.Error] = masc_extension.release(?s); }
    val ctx: res[masc_state.Context, masc_state.Error] = masc_state.make(?s, ?set.states, row.some.initial);
    if (sel ctx.err) { ret Head{refused: "the head states an execution state this architecture does not run under", note: HEAD_STATE_NOTE}; }
    var held: masc_state.Context = ctx.ok;
    var axis: u32                = 0;
    for (axis < set.states.len) {
        if (held.values.at[axis::usize] != row.some.initial.at[axis::usize]) {
            ret Head{refused: "the head sets execution state, which a block may not", note: HEAD_STATE_NOTE};
        }
        axis = axis + 1;
    }
    if (!masc_state.admits(?held, row.some.enters)) { ret Head{refused: "the head is not a selection this architecture enters", note: "a head is a selection of masc's for the compile target; `$if` chooses a block per target"}; }
    ret HEAD_OK;
}

# the text of masc's refusal of a selection
fun refusal_text(e: masc_extension.Error) str {
    if (sel e.refused)  { ret e.refused.message; }
    if (sel e.conflict) { ret "it holds two extensions that conflict"; }
    ret "out of memory";
}
