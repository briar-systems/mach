use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;

use mach.lang.be.codegen.mir;
use mach.lang.target.abi;
use mach.lang.target.isa;
use mach.lang.target.isa.x64;

pub val REG_RAX: i32 = 0;
pub val REG_RCX: i32 = 1;
pub val REG_RDX: i32 = 2;
pub val REG_RBX: i32 = 3;
pub val REG_RSP: i32 = 4;
pub val REG_RBP: i32 = 5;
pub val REG_RSI: i32 = 6;
pub val REG_RDI: i32 = 7;
pub val REG_R8:  i32 = 8;
pub val REG_R9:  i32 = 9;
pub val REG_R12: i32 = 12;
pub val REG_R13: i32 = 13;
pub val REG_R14: i32 = 14;
pub val REG_R15: i32 = 15;

pub val REG_XMM0: i32 = (1 << 8) | 0;

pub val PARAM_SLOT_COUNT: i32 = 4;

pub val VEC_REG_BYTES:          u64 = 16;
pub val GP_PARAM_COUNT:         i32 = 4;
pub val FP_PARAM_COUNT:         i32 = 4;
pub val CALLEE_SAVED_GP_COUNT:  i32 = 9;
pub val CALLEE_SAVED_XMM_COUNT: i32 = 10;
pub val CALLEE_SAVED_COUNT:     i32 = CALLEE_SAVED_GP_COUNT + CALLEE_SAVED_XMM_COUNT;

pub val STACK_ALIGN:  u32 = 16;
pub val RED_ZONE:     u32 = 0;
pub val SHADOW_SPACE: u64 = 32;

pub fun is_by_value_size(size: u64) bool {
    ret size == 1 || size == 2 || size == 4 || size == 8;
}

# a 16-byte integer has no Microsoft rule (MSVC has no such type). the
# convention is the one GCC (mingw-w64) and Clang share: LLVM 18 made i128
# match __int128 ("Changes to the X86 Backend", LLVM 18.1 release notes), and
# llvm/llvm-project#115052 describes that convention as passing on the stack
# by reference and returning in xmm0, "identical to i128" and "the same as
# GCC". the clang -O0 probe under test/link/cases exhibits it: the argument
# is a pointer to a caller copy like any other 16-byte object, the value
# returns in XMM0 with the low half in the low lanes (#3511)
pub val INT128: u64 = 16;

pub fun slot_gp_reg(index: i32) i32 {
    if (index == 0) { ret REG_RCX; }
    if (index == 1) { ret REG_RDX; }
    if (index == 2) { ret REG_R8; }
    if (index == 3) { ret REG_R9; }
    ret -1;
}

pub fun slot_fp_reg(index: i32) i32 {
    if (index < 0)               { ret -1; }
    if (index >= FP_PARAM_COUNT) { ret -1; }
    ret isa.regid_make(isa.REG_CLASS_ID_XMM, index);
}

pub fun classify_arg(index: i32, size: u64, align: u64,
    is_float: bool, fp_eightbytes: u8, is_aggregate: bool, is_vector: bool,
    gp_used: i32, fp_used: i32, hfa_members: u8, hfa_elem: u8,
    agg: abi.AggLayout) abi.ParamSlot {
    val slot: i32 = slot_index(gp_used, fp_used);

    if (is_vector) {
        if (is_by_value_size(size)) {
            if (slot < PARAM_SLOT_COUNT) {
                ret abi.make_slot(abi.CLASS_GP, slot_gp_reg(slot), 0, size, 8);
            }
            ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
        }
        if (slot < PARAM_SLOT_COUNT) {
            ret abi.make_slot_indirect(abi.CLASS_VEC_BYREF, slot_gp_reg(slot), 0, 8,
                size, VEC_REG_BYTES::u32);
        }
        ret abi.make_slot_indirect(abi.CLASS_VEC_STACK_BYREF, -1, 0, 8,
            size, VEC_REG_BYTES::u32);
    }

    if (is_aggregate) {
        if (is_by_value_size(size)) {
            if (slot < PARAM_SLOT_COUNT) {
                ret abi.make_slot(abi.CLASS_GP, slot_gp_reg(slot), 0, size, 8);
            }
            ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
        }
        if (slot < PARAM_SLOT_COUNT) {
            ret abi.make_slot(abi.CLASS_BYREF, slot_gp_reg(slot), 0, 8, 8);
        }
        ret abi.make_slot(abi.CLASS_STACK_BYREF, -1, 0, 8, 0);
    }

    if (is_float) {
        if (slot < PARAM_SLOT_COUNT) {
            ret abi.make_slot(abi.CLASS_FP, slot_fp_reg(slot), 0, size, size::u8);
        }
        ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
    }

    if (size == INT128) {
        if (slot < PARAM_SLOT_COUNT) {
            ret abi.make_slot(abi.CLASS_BYREF, slot_gp_reg(slot), 0, 8, 8);
        }
        ret abi.make_slot(abi.CLASS_STACK_BYREF, -1, 0, 8, 0);
    }

    if (slot < PARAM_SLOT_COUNT) {
        ret abi.make_slot(abi.CLASS_GP, slot_gp_reg(slot), 0, size, 8);
    }
    ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
}

pub fun classify_return(size: u64, align: u64,
    is_float: bool, fp_eightbytes: u8, is_aggregate: bool, is_vector: bool,
    hfa_members: u8, hfa_elem: u8, agg: abi.AggLayout) abi.ParamSlot {
    if (size == 0) {
        ret abi.make_slot(abi.CLASS_GP, -1, 0, 0, 0);
    }

    if (is_vector) {
        if (is_by_value_size(size)) {
            ret abi.make_slot(abi.CLASS_GP, REG_RAX, 0, size, 8);
        }
        if (size == VEC_REG_BYTES) {
            ret abi.make_slot(abi.CLASS_FP, REG_XMM0, 0, size, size::u8);
        }
        ret abi.make_slot(abi.CLASS_SRET, REG_RAX, 0, 8, 8);
    }

    if (is_aggregate) {
        if (is_by_value_size(size)) {
            ret abi.make_slot(abi.CLASS_GP, REG_RAX, 0, size, 8);
        }
        ret abi.make_slot(abi.CLASS_SRET, REG_RAX, 0, 8, 8);
    }

    if (is_float) {
        ret abi.make_slot(abi.CLASS_FP, REG_XMM0, 0, size, size::u8);
    }

    if (size == INT128) {
        ret abi.make_slot(abi.CLASS_FP, REG_XMM0, 0, size, size::u8);
    }
    ret abi.make_slot(abi.CLASS_GP, REG_RAX, 0, size, 8);
}

pub fun gp_param_regs(out: *isa.Register) i32 {
    var i: i32 = 0;
    for (i < GP_PARAM_COUNT) {
        out[i].id   = slot_gp_reg(i);
        out[i].size = 8;
        i           = i + 1;
    }
    ret GP_PARAM_COUNT;
}

pub fun callee_saved(out: *isa.Register) i32 {
    out[0].id   = REG_RBX;
    out[0].size = 8;
    out[1].id   = REG_RBP;
    out[1].size = 8;
    out[2].id   = REG_RDI;
    out[2].size = 8;
    out[3].id   = REG_RSI;
    out[3].size = 8;
    out[4].id   = REG_RSP;
    out[4].size = 8;
    out[5].id   = REG_R12;
    out[5].size = 8;
    out[6].id   = REG_R13;
    out[6].size = 8;
    out[7].id   = REG_R14;
    out[7].size = 8;
    out[8].id   = REG_R15;
    out[8].size = 8;

    var i: i32 = 0;
    for (i < CALLEE_SAVED_XMM_COUNT) {
        out[CALLEE_SAVED_GP_COUNT + i].id   = isa.regid_make(isa.REG_CLASS_ID_XMM, 6 + i);
        out[CALLEE_SAVED_GP_COUNT + i].size = 16;
        i                                   = i + 1;
    }
    ret CALLEE_SAVED_COUNT;
}

pub fun va_model() abi.VaModel {
    ret abi.va_model_make(abi.VA_MODEL_HOME, true, -1, 64);
}

fun slot_index(gp_used: i32, fp_used: i32) i32 {
    ret gp_used + fp_used;
}

pub val EIGHTBYTE: u32 = 8;

pub fun register_win64(reg: *abi.AbiRegistry) err[fail.Fail] {
    val shadow_space:                u32  = SHADOW_SPACE::u32;
    val indirect_result_reg:         i32  = slot_gp_reg(0);
    val consumes_agg_layout:         bool = false;
    val fp_callee_saved_full_vector: bool = true;
    val float_arg_bits:              u32  = 64;

    var win64_vtable: abi.AbiVTable = abi.abi_vtable(
        abi.ABI_WIN64, abi.abi_name_for(abi.ABI_WIN64), isa.ARCH_X86_64,
        classify_arg, classify_return,
        gp_param_regs, callee_saved,
        STACK_ALIGN, RED_ZONE, shadow_space,
        indirect_result_reg, true,
        consumes_agg_layout, fp_callee_saved_full_vector,
        float_arg_bits, EIGHTBYTE,
        va_model);

    ret abi.register(reg, ?win64_vtable);
}

# every argument owns the positional slot of its index: integers ride rcx, rdx,
# r8, r9 and floats xmm0-3 whatever the other bank holds, and the fifth spills
test classify_arg__positional_slots {
    val s0: abi.ParamSlot = classify_arg(0, 8, 8, false, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (s0.class != abi.CLASS_GP || mir.preg_regid(s0.reg) != REG_RCX) { ret 1; }
    val s1: abi.ParamSlot = classify_arg(1, 8, 8, false, 0, false, false, 1, 0, 0, 0, abi.agg_none());
    if (mir.preg_regid(s1.reg) != REG_RDX) { ret 1; }
    val s2: abi.ParamSlot = classify_arg(2, 8, 8, false, 0, false, false, 2, 0, 0, 0, abi.agg_none());
    if (mir.preg_regid(s2.reg) != REG_R8) { ret 1; }
    val s3: abi.ParamSlot = classify_arg(3, 8, 8, false, 0, false, false, 3, 0, 0, 0, abi.agg_none());
    if (mir.preg_regid(s3.reg) != REG_R9) { ret 1; }
    val s4: abi.ParamSlot = classify_arg(4, 8, 8, false, 0, false, false, 4, 0, 0, 0, abi.agg_none());
    if (s4.class != abi.CLASS_STACK || !mir.preg_is_nil(s4.reg) || s4.size != 8) { ret 1; }

    val f3: abi.ParamSlot = classify_arg(3, 4, 4, true, 0, false, false, 0, 3, 0, 0, abi.agg_none());
    if (f3.class != abi.CLASS_FP || mir.preg_regid(f3.reg) != isa.regid_make(isa.REG_CLASS_ID_XMM, 3)) { ret 2; }
    val f4: abi.ParamSlot = classify_arg(4, 8, 8, true, 0, false, false, 0, 4, 0, 0, abi.agg_none());
    if (f4.class != abi.CLASS_STACK) { ret 2; }

    val f1: abi.ParamSlot = classify_arg(1, 8, 8, true, 0, false, false, 1, 0, 0, 0, abi.agg_none());
    if (f1.class != abi.CLASS_FP || mir.preg_regid(f1.reg) != isa.regid_make(isa.REG_CLASS_ID_XMM, 1)) { ret 3; }
    val g1: abi.ParamSlot = classify_arg(1, 8, 8, false, 0, false, false, 0, 1, 0, 0, abi.agg_none());
    if (g1.class != abi.CLASS_GP || mir.preg_regid(g1.reg) != REG_RDX) { ret 3; }
    ret 0;
}

# an aggregate of 1, 2, 4 or 8 bytes rides its slot by value, any other by reference
test classify_arg__aggregate_by_value_or_reference {
    val by_val: abi.ParamSlot = classify_arg(0, 8, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
    if (by_val.class != abi.CLASS_GP || mir.preg_regid(by_val.reg) != REG_RCX || by_val.size != 8) { ret 1; }
    val four: abi.ParamSlot = classify_arg(0, 4, 4, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
    if (four.class != abi.CLASS_GP) { ret 2; }
    val by_ref3: abi.ParamSlot = classify_arg(0, 3, 1, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
    if (by_ref3.class != abi.CLASS_BYREF || mir.preg_regid(by_ref3.reg) != REG_RCX || by_ref3.size != 8) { ret 3; }
    val by_ref16: abi.ParamSlot = classify_arg(0, 16, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
    if (by_ref16.class != abi.CLASS_BYREF || mir.preg_regid(by_ref16.reg) != REG_RCX) { ret 4; }

    val spilled: abi.ParamSlot = classify_arg(4, 16, 8, false, 0, true, false, 4, 0, 0, 0, abi.agg_none());
    if (spilled.class != abi.CLASS_STACK_BYREF || !mir.preg_is_nil(spilled.reg) || spilled.size != 8) { ret 5; }
    val spilled3: abi.ParamSlot = classify_arg(4, 3, 1, false, 0, true, false, 4, 0, 0, 0, abi.agg_none());
    if (spilled3.class != abi.CLASS_STACK_BYREF || spilled3.size != 8) { ret 6; }
    val spilled8: abi.ParamSlot = classify_arg(4, 8, 8, false, 0, true, false, 4, 0, 0, 0, abi.agg_none());
    if (spilled8.class != abi.CLASS_STACK || spilled8.size != 8) { ret 7; }
    ret 0;
}

# the GCC/Clang convention for a 16-byte integer: by reference in the
# positional slot, returned in XMM0 (#3511)
test classify__int128_byref_and_xmm0 {
    val a: abi.ParamSlot = classify_arg(0, 16, 16, false, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (a.class != abi.CLASS_BYREF || mir.preg_regid(a.reg) != slot_gp_reg(0) || a.size != 8) { ret 1; }
    val b: abi.ParamSlot = classify_arg(3, 16, 16, false, 0, false, false, 3, 0, 0, 0, abi.agg_none());
    if (b.class != abi.CLASS_BYREF || mir.preg_regid(b.reg) != slot_gp_reg(3)) { ret 2; }
    val c: abi.ParamSlot = classify_arg(4, 16, 16, false, 0, false, false, 4, 0, 0, 0, abi.agg_none());
    if (c.class != abi.CLASS_STACK_BYREF || c.size != 8) { ret 3; }
    val r: abi.ParamSlot = classify_return(16, 16, false, 0, false, false, 0, 0, abi.agg_none());
    if (r.class != abi.CLASS_FP || mir.preg_regid(r.reg) != REG_XMM0 || r.size != 16) { ret 4; }
    ret 0;
}

test classify_return__scalars_and_aggregates {
    val voidr: abi.ParamSlot = classify_return(0, 0, false, 0, false, false, 0, 0, abi.agg_none());
    if (voidr.class != abi.CLASS_GP || !mir.preg_is_nil(voidr.reg)) { ret 1; }
    val ir: abi.ParamSlot = classify_return(8, 8, false, 0, false, false, 0, 0, abi.agg_none());
    if (ir.class != abi.CLASS_GP || mir.preg_regid(ir.reg) != REG_RAX) { ret 2; }
    val fr: abi.ParamSlot = classify_return(8, 8, true, 0, false, false, 0, 0, abi.agg_none());
    if (fr.class != abi.CLASS_FP || mir.preg_regid(fr.reg) != REG_XMM0) { ret 3; }
    val small: abi.ParamSlot = classify_return(8, 8, false, 0, true, false, 0, 0, abi.agg_none());
    if (small.class != abi.CLASS_GP || mir.preg_regid(small.reg) != REG_RAX) { ret 4; }
    # an all-float aggregate still returns in rax
    val fsmall: abi.ParamSlot = classify_return(8, 8, true, 1, true, false, 0, 0, abi.agg_none());
    if (fsmall.class != abi.CLASS_GP || mir.preg_regid(fsmall.reg) != REG_RAX) { ret 5; }
    val big: abi.ParamSlot = classify_return(12, 4, false, 0, true, false, 0, 0, abi.agg_none());
    if (big.class != abi.CLASS_SRET || mir.preg_regid(big.reg) != REG_RAX) { ret 6; }
    ret 0;
}

test classify_arg__sret_shifts_positional_slots {
    val ret_slot: abi.ParamSlot = classify_return(24, 8, false, 0, true, false, 0, 0, abi.agg_none());
    if (ret_slot.class != abi.CLASS_SRET) { ret 1; }
    val first_arg: abi.ParamSlot = classify_arg(0, 8, 8, false, 0, false, false, 1, 0, 0, 0, abi.agg_none());
    if (first_arg.class != abi.CLASS_GP)          { ret 1; }
    if (mir.preg_regid(first_arg.reg) != REG_RDX) { ret 1; }
    ret 0;
}

test callee_saved__includes_rdi_rsi_and_xmm6_to_xmm15 {
    var cs: [19]isa.Register;
    if (callee_saved(?cs[0]) != CALLEE_SAVED_COUNT)                                { ret 1; }
    if (cs[CALLEE_SAVED_GP_COUNT].id != isa.regid_make(isa.REG_CLASS_ID_XMM, 6))   { ret 1; }
    if (cs[CALLEE_SAVED_COUNT - 1].id != isa.regid_make(isa.REG_CLASS_ID_XMM, 15)) { ret 1; }

    var vt: abi.AbiVTable = abi.abi_vtable(
        0, "", 0,
        nil, nil,
        nil, callee_saved,
        0, 0, 0,
        -1, false,
        false, false,
        0, 8,
        nil);

    var list: [16]i32;
    val n:    i32 = x64.callee_saved_gp_list(?vt, ?list[0]);

    if (n != 7)             { ret 2; }
    if (list[0] != REG_RBX) { ret 2; }
    if (list[1] != REG_RDI) { ret 2; }
    if (list[2] != REG_RSI) { ret 2; }
    if (list[3] != REG_R12) { ret 2; }
    if (list[6] != REG_R15) { ret 2; }

    var i: i32 = 0;
    for (i < n) {
        if (list[i] == REG_RSP)                              { ret 3; }
        if (list[i] == REG_RBP)                              { ret 3; }
        if (isa.regid_class(list[i]) != isa.REG_CLASS_ID_GP) { ret 3; }
        i = i + 1;
    }
    ret 0;
}

test classify__vector_widths {
    val widths: [18]u64 = [18]u64{2, 3, 4, 5, 7, 8, 9, 12, 15, 16, 17, 20, 24, 32, 64, 65535, 131070, 524280};
    var i:      u32     = 0;
    for (i < 18) {
        val width:   u64           = widths[i];
        val integer: bool          = width == 2 || width == 4 || width == 8;
        val first:   abi.ParamSlot = classify_arg(0, width, 1, false, 0, false, true, 0, 0, 0, 0, abi.agg_none());
        val last:    abi.ParamSlot = classify_arg(3, width, 1, false, 0, false, true, 3, 0, 0, 0, abi.agg_none());
        val stack:   abi.ParamSlot = classify_arg(4, width, 1, false, 0, false, true, 4, 0, 0, 0, abi.agg_none());
        val result:  abi.ParamSlot = classify_return(width, 1, false, 0, false, true, 0, 0, abi.agg_none());
        if (mir.preg_regid(first.reg) != REG_RCX || mir.preg_regid(last.reg) != REG_R9 || !mir.preg_is_nil(stack.reg)) { ret 1; }
        if (integer) {
            if (first.class != abi.CLASS_GP || last.class != abi.CLASS_GP || stack.class != abi.CLASS_STACK)   { ret 2; }
            if (first.size != width || stack.size != width || first.indirect_size != 0)                        { ret 3; }
            if (result.class != abi.CLASS_GP || mir.preg_regid(result.reg) != REG_RAX || result.size != width) { ret 4; }
        }
        or {
            if (first.class != abi.CLASS_VEC_BYREF || last.class != abi.CLASS_VEC_BYREF || stack.class != abi.CLASS_VEC_STACK_BYREF) { ret 5; }
            if (first.size != 8 || stack.size != 8 || first.indirect_size != width || stack.indirect_size != width)                  { ret 6; }
            if (first.indirect_align != 16 || stack.indirect_align != 16)                                                            { ret 7; }
            if (width == 16) {
                if (result.class != abi.CLASS_FP || mir.preg_regid(result.reg) != REG_XMM0 || result.size != 16) { ret 8; }
            }
            or {
                if (result.class != abi.CLASS_SRET || mir.preg_regid(result.reg) != REG_RAX || result.size != 8) { ret 9; }
            }
        }
        i = i + 1;
    }
    ret 0;
}
