    target_model.Register{id: REG_F0 + 26, size: 8},
    target_model.Register{id: REG_F0 + 27, size: 8},
};

val GP_ARG_COUNT:       i32 = 8;
val CALLEE_SAVED_COUNT: i32 = 23;

# no psABI variant passes an unnamed float in an f register
val VA_MODEL: abi.VaModel = abi.VaModel{kind: abi.VA_MODEL_REG_SAVE, float_dup_gp: false, vector_count_reg: isa_inst.REG_NONE, variadic_float_bits: 0};

# the psABI passes a `_Float16` as the float it is: in an f register when one
# is free and the ABI has any, NaN-boxed to FLEN, else by the integer rule.
# that holds with or without Zfh
pub val LP64: abi.AbiVTable = abi.AbiVTable{
    passing:                    catalog_abi.PASSING_CARRIERS,
    id:                         catalog_abi.LP64,
    name:                       "lp64",
    arch_id:                    catalog_arch.RISCV64,
    arg_passing:                classify_arg,
    ret_passing:                classify_return,
    family:                     ?LP64_FAMILY,
    gp_arg_regs:                target_model.RegFile{regs: ?GP_ARGS64[0], count: GP_ARG_COUNT},
    callee_saved:               target_model.RegFile{regs: ?CALLEE_SAVED64[0], count: CALLEE_SAVED_COUNT},
    stack_align:                STACK_ALIGN,
    red_zone:                   RED_ZONE,
    indirect_result_reg:        REG_A0,
    indirect_result_in_argfile: true,
    fp_callee_saved_bytes:      16,
    float_arg_bits:             0,
    arg_slot_granularity:       8,
    va_model:                   ?VA_MODEL,
    half:                       abi.HALF_FLOAT_NANBOX,
};

pub val LP64F: abi.AbiVTable = abi.AbiVTable{
    passing:                    catalog_abi.PASSING_CARRIERS,
    id:                         catalog_abi.LP64F,
    name:                       "lp64f",
