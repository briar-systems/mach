pub val ILP32D: abi.AbiVTable = abi.AbiVTable{
    passing:                    catalog_abi.PASSING_CARRIERS,
    id:                         catalog_abi.ILP32D,
    name:                       "ilp32d",
    arch_id:                    catalog_arch.RISCV32,
    arg_passing:                classify_arg,
    ret_passing:                classify_return,
    family:                     ?ILP32D_FAMILY,
    gp_arg_regs:                target_model.RegFile{regs: ?GP_ARGS32[0], count: GP_ARG_COUNT},
    callee_saved:               target_model.RegFile{regs: ?CALLEE_SAVED32[0], count: CALLEE_SAVED_COUNT},
    stack_align:                STACK_ALIGN,
    red_zone:                   RED_ZONE,
    indirect_result_reg:        REG_A0,
    indirect_result_in_argfile: true,
    fp_callee_saved_bytes:      16,
    float_arg_bits:             64,
    arg_slot_granularity:       4,
    va_model:                   ?VA_MODEL,
    half:                       abi.HALF_FLOAT_NANBOX,
};

# a classifier call through a descriptor carrying the given variant
#[testing]
fun t_arg(v: Family, q: abi.ArgQuery) abi.ParamSlot {
    var vt:     abi.AbiVTable = LP64D;
    var family: Family        = v;
    var arg:    abi.ArgQuery  = q;
    vt.family = ?family;
    ret classify_arg(?vt, ?arg);
}

#[testing]
fun t_ret(v: Family, q: abi.RetQuery) abi.ParamSlot {
    var vt:     abi.AbiVTable = LP64D;
    var family: Family        = v;
    var result: abi.RetQuery  = q;
    vt.family = ?family;
    ret classify_return(?vt, ?result);
}

#[testing]
fun family(xlen_bits: u32, flen_bits: u32, gp_arg_count: i32, fp_arg_count: i32) Family {
    ret Family{xlen_bits: xlen_bits, flen_bits: flen_bits, gp_arg_count: gp_arg_count, fp_arg_count: fp_arg_count};
}

# on rv32 a 64-bit scalar takes a register pair from any index, and splits
# into a register and the stack at the bank boundary
test classify_arg_v__wide_scalar_on_rv32 {
    val a: abi.ParamSlot = t_arg(ILP32_FAMILY, abi.arg_query(0, 8, 8, false, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (a.class != abi.CLASS_GP || a.piece_count != 2)                                                    { ret 1; }
    if (lang_mir.preg_regid(a.pieces[0].reg) != REG_A0 || lang_mir.preg_regid(a.pieces[1].reg) != REG_A1) { ret 1; }
    if (a.pieces[1].src_off != 4)                                                                         { ret 1; }
    val odd: abi.ParamSlot = t_arg(ILP32_FAMILY, abi.arg_query(1, 8, 8, false, 0, false, false, 1, 0, 0, 0, abi.agg_none(), 0));
    if (odd.piece_count != 2)                                                    { ret 2; }
    if (lang_mir.preg_regid(odd.pieces[0].reg) != gp_param_reg(ILP32_FAMILY, 1)) { ret 2; }
    if (lang_mir.preg_regid(odd.pieces[1].reg) != gp_param_reg(ILP32_FAMILY, 2)) { ret 2; }
    val w: abi.ParamSlot = t_arg(ILP32_FAMILY, abi.arg_query(0, 4, 4, false, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (w.piece_count != 1) { ret 3; }
    val l: abi.ParamSlot = t_arg(LP64_FAMILY, abi.arg_query(0, 8, 8, false, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (l.piece_count != 1 || lang_mir.preg_regid(l.reg) != REG_A0) { ret 4; }

    val n:    i32           = ILP32_FAMILY.gp_arg_count;
    val pair: abi.ParamSlot = t_arg(ILP32_FAMILY, abi.arg_query(0, 8, 8, false, 0, false, false, n - 2, 0, 0, 0, abi.agg_none(), 0));
    if (pair.piece_count != 2 || pair.pieces[1].kind != abi.PIECE_GP) { ret 5; }
    val split: abi.ParamSlot = t_arg(ILP32_FAMILY, abi.arg_query(0, 8, 8, false, 0, false, false, n - 1, 0, 0, 0, abi.agg_none(), 0));
    if (split.class != abi.CLASS_GP || split.piece_count != 2)                           { ret 6; }
    if (split.pieces[0].kind != abi.PIECE_GP || split.pieces[1].kind != abi.PIECE_STACK) { ret 6; }
    if (split.pieces[1].src_off != 4)                                                    { ret 6; }
    val stk: abi.ParamSlot = t_arg(ILP32_FAMILY, abi.arg_query(0, 8, 8, false, 0, false, false, n, 0, 0, 0, abi.agg_none(), 0));
    if (stk.class != abi.CLASS_STACK) { ret 7; }
    ret 0;
}

test classify_return_v__per_xlen_and_flen {
    val a: abi.ParamSlot = t_ret(ILP32_FAMILY, abi.ret_query(8, 8, false, 0, false, false, 0, 0, abi.agg_none(), 0));
    if (a.class != abi.CLASS_GP || a.piece_count != 2)                                                    { ret 1; }
    if (lang_mir.preg_regid(a.pieces[0].reg) != REG_A0 || lang_mir.preg_regid(a.pieces[1].reg) != REG_A1) { ret 1; }
    if (a.pieces[1].src_off != 4)                                                                         { ret 1; }
    val w: abi.ParamSlot = t_ret(ILP32_FAMILY, abi.ret_query(4, 4, false, 0, false, false, 0, 0, abi.agg_none(), 0));
    if (w.piece_count != 1) { ret 2; }
    val l: abi.ParamSlot = t_ret(LP64_FAMILY, abi.ret_query(8, 8, false, 0, false, false, 0, 0, abi.agg_none(), 0));
    if (l.piece_count != 1) { ret 3; }

    val d: abi.ParamSlot = t_ret(LP64D_FAMILY, abi.ret_query(8, 8, true, 0, false, false, 0, 0, abi.agg_none(), 0));
    if (d.class != abi.CLASS_FP) { ret 4; }
    val f: abi.ParamSlot = t_ret(LP64F_FAMILY, abi.ret_query(8, 8, true, 0, false, false, 0, 0, abi.agg_none(), 0));
    if (f.class != abi.CLASS_GP || lang_mir.preg_regid(f.reg) != REG_A0) { ret 5; }
    val f32: abi.ParamSlot = t_ret(LP64F_FAMILY, abi.ret_query(4, 4, true, 0, false, false, 0, 0, abi.agg_none(), 0));
    if (f32.class != abi.CLASS_FP) { ret 6; }
    val s: abi.ParamSlot = t_ret(LP64_FAMILY, abi.ret_query(8, 8, true, 0, false, false, 0, 0, abi.agg_none(), 0));
    if (s.class != abi.CLASS_GP) { ret 7; }
    ret 0;
}

# a float rides the fp bank only when it fits the member's flen, otherwise it
# is soft and rides the a bank, as a pair on rv32
test classify_arg_v__float_per_flen {
    val d: abi.ParamSlot = t_arg(LP64D_FAMILY, abi.arg_query(0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (d.class != abi.CLASS_FP || lang_mir.preg_regid(d.reg) != fp_param_reg(LP64D_FAMILY, 0)) { ret 1; }
    val f: abi.ParamSlot = t_arg(LP64F_FAMILY, abi.arg_query(0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (f.class != abi.CLASS_GP || lang_mir.preg_regid(f.reg) != REG_A0) { ret 2; }
    val f32: abi.ParamSlot = t_arg(LP64F_FAMILY, abi.arg_query(0, 4, 4, true, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (f32.class != abi.CLASS_FP || lang_mir.preg_regid(f32.reg) != fp_param_reg(LP64F_FAMILY, 0)) { ret 3; }
    val s: abi.ParamSlot = t_arg(LP64_FAMILY, abi.arg_query(0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (s.class != abi.CLASS_GP || lang_mir.preg_regid(s.reg) != REG_A0) { ret 4; }
    val s32: abi.ParamSlot = t_arg(LP64_FAMILY, abi.arg_query(0, 4, 4, true, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (s32.class != abi.CLASS_GP) { ret 5; }

    val soft: abi.ParamSlot = t_arg(ILP32_FAMILY, abi.arg_query(0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (soft.class != abi.CLASS_GP || soft.piece_count != 2 || lang_mir.preg_regid(soft.pieces[1].reg) != REG_A1) { ret 6; }
    val sf: abi.ParamSlot = t_arg(ILP32F_FAMILY, abi.arg_query(0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (sf.class != abi.CLASS_GP || sf.piece_count != 2) { ret 7; }
    val sf32: abi.ParamSlot = t_arg(ILP32F_FAMILY, abi.arg_query(0, 4, 4, true, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (sf32.class != abi.CLASS_FP) { ret 8; }
    val sd: abi.ParamSlot = t_arg(ILP32D_FAMILY, abi.arg_query(0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (sd.class != abi.CLASS_FP) { ret 9; }
    ret 0;
}

test va_model__no_unnamed_float_rides_the_fa_bank {
    val md: abi.VaModel = @LP64D.va_model;
    if (md.variadic_float_bits != 0)              { ret 1; }
    if (md.kind != abi.VA_MODEL_REG_SAVE)         { ret 1; }
    if (md.float_dup_gp)                          { ret 1; }
    if (md.vector_count_reg != isa_inst.REG_NONE) { ret 1; }
    if (abi.variadic_float_in_fp_bank(?md, 4))    { ret 1; }
    if (abi.variadic_float_in_fp_bank(?md, 8))    { ret 1; }
    if (!float_in_fp_bank(LP64D_FAMILY, 8))       { ret 1; }
    val mf: abi.VaModel = @LP64F.va_model;
    if (mf.variadic_float_bits != 0)           { ret 2; }
    if (abi.variadic_float_in_fp_bank(?mf, 4)) { ret 2; }
    val ms: abi.VaModel = @LP64.va_model;
    if (ms.variadic_float_bits != 0) { ret 3; }
    ret 0;
}

test classify_arg_v__unnamed_float_takes_the_a_bank {
    val v:     Family        = LP64D_FAMILY;
    val named: abi.ParamSlot = t_arg(v, abi.arg_query(0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (named.class != abi.CLASS_FP) { ret 1; }
    val tail: abi.ParamSlot = t_arg(v, abi.arg_query(0, 8, 8, false, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (tail.class != abi.CLASS_GP)              { ret 1; }
    if (lang_mir.preg_regid(tail.reg) != REG_A0) { ret 1; }
    val hfa: abi.ParamSlot = t_arg(v, abi.arg_query(0, 8, 8, false, 0, true, false, 0, 0, 1, 8, abi.agg_none(), 0));
    if (hfa.class != abi.CLASS_FP) { ret 1; }
    val tagg: abi.ParamSlot = t_arg(v, abi.arg_query(0, 8, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (tagg.class != abi.CLASS_GP)              { ret 1; }
    if (lang_mir.preg_regid(tagg.reg) != REG_A0) { ret 1; }
    val spill: abi.ParamSlot = t_arg(v, abi.arg_query(8, 8, 8, false, 0, false, false, 8, 0, 0, 0, abi.agg_none(), 0));
    if (spill.class != abi.CLASS_STACK) { ret 1; }
    ret 0;
}

# a member with no variadic model would pass an unnamed float by a guess
test variants__each_declares_a_variadic_rule {
    val vtables: [6]*abi.AbiVTable = [6]*abi.AbiVTable{?LP64, ?LP64F, ?LP64D, ?ILP32, ?ILP32F, ?ILP32D};
    var i:       u32               = 0;
    for (i < 6) {
        if (vtables[i].va_model == nil) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test classify_arg_v__flatten_gated_on_member_width {
    val d: abi.ParamSlot = t_arg(LP64D_FAMILY, abi.arg_query(0, 16, 8, false, 0, true, false, 0, 0, 2, 8, abi.agg_none(), 0));
    if (d.piece_count != 2)                                                    { ret 1; }
    if (lang_mir.preg_regid(d.pieces[0].reg) != fp_param_reg(LP64D_FAMILY, 0)) { ret 1; }
    val f: abi.ParamSlot = t_arg(LP64F_FAMILY, abi.arg_query(0, 16, 8, false, 0, true, false, 0, 0, 2, 8, abi.agg_none(), 0));
    if (f.class != abi.CLASS_GP)                        { ret 1; }
    if (lang_mir.preg_regid(f.pieces[0].reg) != REG_A0) { ret 1; }
    if (lang_mir.preg_regid(f.pieces[1].reg) != REG_A1) { ret 1; }
    val f32: abi.ParamSlot = t_arg(LP64F_FAMILY, abi.arg_query(0, 8, 4, false, 0, true, false, 0, 0, 2, 4, abi.agg_none(), 0));
    if (f32.piece_count != 2)                                                    { ret 1; }
    if (lang_mir.preg_regid(f32.pieces[0].reg) != fp_param_reg(LP64F_FAMILY, 0)) { ret 1; }
    val s: abi.ParamSlot = t_arg(LP64_FAMILY, abi.arg_query(0, 8, 4, false, 0, true, false, 0, 0, 2, 4, abi.agg_none(), 0));
    if (s.class != abi.CLASS_GP) { ret 1; }
    ret 0;
}

test classify_arg_v__descriptor_facts_are_read {
    val ilp32d: Family = family(32, 64, 8, 8);
    if (max_reg_ret(ilp32d) != 8) { ret 1; }
    val big: abi.ParamSlot = t_arg(ilp32d, abi.arg_query(0, 16, 4, false, 0, true, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (big.class != abi.CLASS_BYREF) { ret 1; }
    val pair: abi.ParamSlot = t_arg(LP64D_FAMILY, abi.arg_query(0, 16, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (pair.class != abi.CLASS_GP) { ret 1; }
    if (pair.piece_count != 2)      { ret 1; }
    val two: abi.ParamSlot = t_arg(ilp32d, abi.arg_query(0, 8, 4, false, 0, true, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (two.piece_count != 2) { ret 1; }
    val one: abi.ParamSlot = t_arg(LP64D_FAMILY, abi.arg_query(0, 8, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none(), 0));
    if (one.piece_count != 1) { ret 1; }

    val lp64e: Family        = family(64, 0, 6, 0);
    val a6:    abi.ParamSlot = t_arg(lp64e, abi.arg_query(6, 8, 8, false, 0, false, false, 6, 0, 0, 0, abi.agg_none(), 0));
    if (a6.class != abi.CLASS_STACK) { ret 1; }
    val ok: abi.ParamSlot = t_arg(LP64D_FAMILY, abi.arg_query(6, 8, 8, false, 0, false, false, 6, 0, 0, 0, abi.agg_none(), 0));
    if (ok.class != abi.CLASS_GP)                  { ret 1; }
    if (lang_mir.preg_regid(ok.reg) != REG_A0 + 6) { ret 1; }
    ret 0;
}

# each descriptor agrees with the variant it carries: instruction set, float
# width, slot width, register widths and the register an indirect result rides
test vtables__agree_with_their_variants {
    val variants: [6]*Family        = [6]*Family{?LP64_FAMILY, ?LP64F_FAMILY, ?LP64D_FAMILY, ?ILP32_FAMILY, ?ILP32F_FAMILY, ?ILP32D_FAMILY};
    val vtables:  [6]*abi.AbiVTable = [6]*abi.AbiVTable{?LP64, ?LP64F, ?LP64D, ?ILP32, ?ILP32F, ?ILP32D};
    var i:        u32               = 0;
    for (i < 6) {
        val vt: *abi.AbiVTable = vtables[i];
        if (family_of(vt) != variants[i]) { ret 1; }
        val v: Family = @family_of(vt);
        if ((v.xlen_bits == 64) != (vt.arch_id == catalog_arch.RISCV64))                                 { ret 2; }
        if (vt.float_arg_bits != v.flen_bits)                                                            { ret 3; }
        if (vt.arg_slot_granularity::u64 != xlen_bytes(v))                                               { ret 4; }
        if (vt.indirect_result_reg != gp_param_reg(v, 0))                                                { ret 5; }
        if (vt.gp_arg_regs.count != v.gp_arg_count || vt.gp_arg_regs.regs[0].size::u64 != xlen_bytes(v)) { ret 6; }
        if (vt.callee_saved.regs[0].size::u64 != xlen_bytes(v) || vt.callee_saved.regs[11].size != 8)    { ret 7; }
        i = i + 1;
    }
    ret 0;
}

test register_files__param_and_callee_saved {
    val gp: target_model.RegFile = LP64D.gp_arg_regs;
    if (gp.count != 8)                                          { ret 1; }
    if (gp.regs[0].id != REG_A0 || gp.regs[7].id != REG_A0 + 7) { ret 1; }
    val cs: target_model.RegFile = LP64D.callee_saved;
    if (cs.count != 23)                                                                    { ret 1; }
    if (cs.regs[0].id != REG_S1 || cs.regs[10].id != REG_S2 + 9)                           { ret 1; }
    if (cs.regs[11].id != isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 8))                { ret 1; }
    if (cs.regs[22].id != isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 27))               { ret 1; }
    if (LP64.callee_saved.regs[11].id != isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 8)) { ret 1; }
    ret 0;
}
