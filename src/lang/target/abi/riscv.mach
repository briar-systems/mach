fun ilp32d_cs(out: *isa.Register) i32      { ret callee_saved_v(v_ilp32d(), out); }

fun install(reg: *abi.AbiRegistry, v: RiscvAbi, vt: *abi.AbiVTable) R.Result[R.Void, str] {
    if (v.variadic_float_bits == VARIADIC_RULE_UNDECLARED) {
        ret R.err[R.Void, str]("mach.lang.target.abi.riscv: a family member declares no variadic float rule; read the psABI for it and give `variadic_float_bits` a width rather than registering it undecided");
    }
    ret abi.register(reg, vt);
}

pub fun register(reg: *abi.AbiRegistry) R.Result[R.Void, str] {
    val vl:  RiscvAbi = v_lp64();
    var lp64_vtable: abi.AbiVTable = abi.abi_vtable(
        vl.id, vl.name, vl.arch_id,
        lp64_arg, lp64_ret,
        lp64_gp_regs, lp64_cs,
        STACK_ALIGN, RED_ZONE, 0,
        gp_param_reg(vl, 0), true,
        true, true,
        vl.flen_bits, xlen_bytes(vl)::u32,
        lp64_va
    );
    abi.with_legacy_classifier(?lp64_vtable, lp64_classify);
    val rlp64: R.Result[R.Void, str] = install(reg, vl, ?lp64_vtable);
    if (R.is_err[R.Void, str](rlp64)) { ret rlp64; }

    val vf: RiscvAbi = v_lp64f();
    var lp64f_vtable: abi.AbiVTable = abi.abi_vtable(
        vf.id, vf.name, vf.arch_id,
        lp64f_arg, lp64f_ret,
        lp64f_gp_regs, lp64f_cs,
        STACK_ALIGN, RED_ZONE, 0,
        gp_param_reg(vf, 0), true,
        true, true,
        vf.flen_bits, xlen_bytes(vf)::u32,
        lp64f_va
    );
    abi.with_legacy_classifier(?lp64f_vtable, lp64f_classify);
    val rlp64f: R.Result[R.Void, str] = install(reg, vf, ?lp64f_vtable);
    if (R.is_err[R.Void, str](rlp64f)) { ret rlp64f; }

    val vd: RiscvAbi = v_lp64d();
    var lp64d_vtable: abi.AbiVTable = abi.abi_vtable(
        vd.id, vd.name, vd.arch_id,
        lp64d_arg, lp64d_ret,
        lp64d_gp_regs, lp64d_cs,
        STACK_ALIGN, RED_ZONE, 0,
        gp_param_reg(vd, 0), true,
        true, true,
        vd.flen_bits, xlen_bytes(vd)::u32,
        lp64d_va
    );
    abi.with_legacy_classifier(?lp64d_vtable, lp64d_classify);
    val rlp64d: R.Result[R.Void, str] = install(reg, vd, ?lp64d_vtable);
    if (R.is_err[R.Void, str](rlp64d)) { ret rlp64d; }

    val vi: RiscvAbi = v_ilp32();
    var ilp32_vtable: abi.AbiVTable = abi.abi_vtable(
        vi.id, vi.name, vi.arch_id,
        ilp32_arg, ilp32_ret,
        ilp32_gp_regs, ilp32_cs,
        STACK_ALIGN, RED_ZONE, 0,
        gp_param_reg(vi, 0), true,
        true, true,
        vi.flen_bits, xlen_bytes(vi)::u32,
        ilp32_va
    );
    abi.with_legacy_classifier(?ilp32_vtable, ilp32_classify);
    val rilp32: R.Result[R.Void, str] = install(reg, vi, ?ilp32_vtable);
    if (R.is_err[R.Void, str](rilp32)) { ret rilp32; }

    val vif: RiscvAbi = v_ilp32f();
    var ilp32f_vtable: abi.AbiVTable = abi.abi_vtable(
        vif.id, vif.name, vif.arch_id,
        ilp32f_arg, ilp32f_ret,
        ilp32f_gp_regs, ilp32f_cs,
        STACK_ALIGN, RED_ZONE, 0,
        gp_param_reg(vif, 0), true,
        true, true,
        vif.flen_bits, xlen_bytes(vif)::u32,
        ilp32f_va
    );
    abi.with_legacy_classifier(?ilp32f_vtable, ilp32f_classify);
    val rilp32f: R.Result[R.Void, str] = install(reg, vif, ?ilp32f_vtable);
    if (R.is_err[R.Void, str](rilp32f)) { ret rilp32f; }

    val vid: RiscvAbi = v_ilp32d();
    var ilp32d_vtable: abi.AbiVTable = abi.abi_vtable(
        vid.id, vid.name, vid.arch_id,
        ilp32d_arg, ilp32d_ret,
        ilp32d_gp_regs, ilp32d_cs,
        STACK_ALIGN, RED_ZONE, 0,
        gp_param_reg(vid, 0), true,
        true, true,
        vid.flen_bits, xlen_bytes(vid)::u32,
        ilp32d_va
    );
    abi.with_legacy_classifier(?ilp32d_vtable, ilp32d_classify);
    val rilp32d: R.Result[R.Void, str] = install(reg, vid, ?ilp32d_vtable);
    if (R.is_err[R.Void, str](rilp32d)) { ret rilp32d; }

    ret R.ok_void[str]();
}

test "mach.lang.target.abi.riscv.float_in_fp_bank:is_the_declared_flen" {
    if (float_in_fp_bank(v_lp64(), 4))   { ret 1; }
    if (float_in_fp_bank(v_lp64(), 8))   { ret 1; }
    if (!float_in_fp_bank(v_lp64f(), 4)) { ret 1; }
    if (float_in_fp_bank(v_lp64f(), 8))  { ret 1; }
    if (!float_in_fp_bank(v_lp64d(), 4)) { ret 1; }
    if (!float_in_fp_bank(v_lp64d(), 8)) { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.riscv.classify_arg_v:a_wide_scalar_takes_a_register_pair" {
    val a: abi.ParamSlot = classify_arg_v(v_ilp32(), 0, 8, 8, false, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (a.class       != abi.CLASS_GP) { ret 1; }
    if (a.piece_count != 2)            { ret 1; }
    if (a.pieces[0].reg != REG_A0)     { ret 1; }
    if (a.pieces[1].reg != REG_A1)     { ret 1; }
    if (a.pieces[1].src_off != 4)      { ret 1; }

    val b: abi.ParamSlot = classify_arg_v(v_ilp32(), 1, 8, 8, false, 0, false, false, 2, 0, 0, 0, abi.agg_none());
    if (b.piece_count   != 2)          { ret 1; }
    if (b.pieces[0].reg != gp_param_reg(v_ilp32(), 2)) { ret 1; }

    val w: abi.ParamSlot = classify_arg_v(v_ilp32(), 0, 4, 4, false, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (w.piece_count != 1)            { ret 1; }

    val odd: abi.ParamSlot = classify_arg_v(v_ilp32(), 1, 8, 8, false, 0, false, false, 1, 0, 0, 0, abi.agg_none());
    if (odd.piece_count   != 2)        { ret 1; }
    if (odd.pieces[0].reg != gp_param_reg(v_ilp32(), 1)) { ret 1; }
    if (odd.pieces[1].reg != gp_param_reg(v_ilp32(), 2)) { ret 1; }

    val l: abi.ParamSlot = classify_arg_v(v_lp64(), 0, 8, 8, false, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (l.piece_count != 1)            { ret 1; }
    if (l.reg         != REG_A0)       { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.riscv.classify_arg_v:a_wide_scalar_splits_at_the_bank_boundary" {
    val n: i32 = v_ilp32().gp_arg_count;

    val split: abi.ParamSlot = classify_arg_v(v_ilp32(), 0, 8, 8, false, 0, false, false, n - 1, 0, 0, 0, abi.agg_none());
    if (split.class            != abi.CLASS_GP)     { ret 1; }
    if (split.piece_count      != 2)                { ret 1; }
    if (split.pieces[0].kind   != abi.PIECE_GP)     { ret 1; }
    if (split.pieces[1].kind   != abi.PIECE_STACK)  { ret 1; }
    if (split.pieces[1].src_off != 4)               { ret 1; }

    val stk: abi.ParamSlot = classify_arg_v(v_ilp32(), 0, 8, 8, false, 0, false, false, n, 0, 0, 0, abi.agg_none());
    if (stk.class != abi.CLASS_STACK)               { ret 1; }

    val pair: abi.ParamSlot = classify_arg_v(v_ilp32(), 0, 8, 8, false, 0, false, false, n - 2, 0, 0, 0, abi.agg_none());
    if (pair.piece_count    != 2)                   { ret 1; }
    if (pair.pieces[1].kind != abi.PIECE_GP)        { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.riscv.classify_arg_v:a_soft_double_takes_a_register_pair" {
    val s: abi.ParamSlot = classify_arg_v(v_ilp32(), 0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (s.class       != abi.CLASS_GP) { ret 1; }
    if (s.piece_count != 2)            { ret 1; }
    if (s.pieces[1].reg != REG_A1)     { ret 1; }

    val f: abi.ParamSlot = classify_arg_v(v_ilp32f(), 0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (f.class       != abi.CLASS_GP) { ret 1; }
    if (f.piece_count != 2)            { ret 1; }

    val f32: abi.ParamSlot = classify_arg_v(v_ilp32f(), 0, 4, 4, true, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (f32.class != abi.CLASS_FP)     { ret 1; }

    val d: abi.ParamSlot = classify_arg_v(v_ilp32d(), 0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (d.class != abi.CLASS_FP)       { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.riscv.classify_return_v:a_wide_scalar_returns_in_a_pair" {
    val a: abi.ParamSlot = classify_return_v(v_ilp32(), 8, 8, false, 0, false, false, 0, 0, abi.agg_none());
    if (a.class         != abi.CLASS_GP) { ret 1; }
    if (a.piece_count   != 2)            { ret 1; }
    if (a.pieces[0].reg != REG_A0)       { ret 1; }
    if (a.pieces[1].reg != REG_A1)       { ret 1; }
    if (a.pieces[1].src_off != 4)        { ret 1; }

    val w: abi.ParamSlot = classify_return_v(v_ilp32(), 4, 4, false, 0, false, false, 0, 0, abi.agg_none());
    if (w.piece_count != 1)              { ret 1; }

    val l: abi.ParamSlot = classify_return_v(v_lp64(), 8, 8, false, 0, false, false, 0, 0, abi.agg_none());
    if (l.piece_count != 1)              { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.riscv.classify_arg_v:same_double_three_banks" {
    val d: abi.ParamSlot  = classify_arg_v(v_lp64d(), 0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (d.class != abi.CLASS_FP)            { ret 1; }
    if (d.reg   != fp_param_reg(v_lp64d(), 0)) { ret 1; }
    val f: abi.ParamSlot  = classify_arg_v(v_lp64f(), 0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (f.class != abi.CLASS_GP)            { ret 1; }
    if (f.reg   != REG_A0)                  { ret 1; }
    val f32: abi.ParamSlot = classify_arg_v(v_lp64f(), 0, 4, 4, true, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (f32.class != abi.CLASS_FP)          { ret 1; }
    if (f32.reg   != fp_param_reg(v_lp64f(), 0)) { ret 1; }
    val s: abi.ParamSlot  = classify_arg_v(v_lp64(), 0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (s.class != abi.CLASS_GP)            { ret 1; }
    if (s.reg   != REG_A0)                  { ret 1; }
    val s32: abi.ParamSlot = classify_arg_v(v_lp64(), 0, 4, 4, true, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (s32.class != abi.CLASS_GP)          { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.riscv.va_model_v:no_unnamed_float_rides_the_fa_bank" {
    var reg: abi.AbiRegistry = abi.registry_init();
    fin { abi.registry_dnit(?reg); }
    val r: R.Result[R.Void, str] = register(?reg);
    if (R.is_err[R.Void, str](r)) { ret 1; }
    val lp64_vtable: O.Option[*abi.AbiVTable] = abi.lookup(?reg, v_lp64().name);
    val lp64f_vtable: O.Option[*abi.AbiVTable] = abi.lookup(?reg, v_lp64f().name);
    val lp64d_vtable: O.Option[*abi.AbiVTable] = abi.lookup(?reg, v_lp64d().name);
    if (O.is_none[*abi.AbiVTable](lp64_vtable) || O.is_none[*abi.AbiVTable](lp64f_vtable)
        || O.is_none[*abi.AbiVTable](lp64d_vtable)) { ret 1; }
    if (O.unwrap[*abi.AbiVTable](lp64_vtable).va_model  == nil) { ret 1; }
    if (O.unwrap[*abi.AbiVTable](lp64f_vtable).va_model == nil) { ret 1; }
    if (O.unwrap[*abi.AbiVTable](lp64d_vtable).va_model == nil) { ret 1; }

    val md: abi.VaModel = va_model_v(v_lp64d());
    if (md.variadic_float_bits != 0)          { ret 1; }
    if (md.kind != abi.VA_MODEL_REG_SAVE)     { ret 1; }
    if (md.float_dup_gp)                      { ret 1; }
    if (md.vector_count_reg != -1)            { ret 1; }
    if (abi.variadic_float_in_fp_bank(?md, 4)) { ret 1; }
    if (abi.variadic_float_in_fp_bank(?md, 8)) { ret 1; }
    if (!float_in_fp_bank(v_lp64d(), 8))       { ret 1; }
    val mf: abi.VaModel = va_model_v(v_lp64f());
    if (mf.variadic_float_bits != 0)           { ret 1; }
    if (abi.variadic_float_in_fp_bank(?mf, 4)) { ret 1; }
    val ms: abi.VaModel = va_model_v(v_lp64());
    if (ms.variadic_float_bits != 0)           { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.riscv.classify_arg_v:unnamed_float_takes_the_a_bank" {
    val v: RiscvAbi = v_lp64d();
    val named: abi.ParamSlot = classify_arg_v(v, 0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (named.class != abi.CLASS_FP)          { ret 1; }
    val tail: abi.ParamSlot = classify_arg_v(v, 0, 8, 8, false, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (tail.class != abi.CLASS_GP)           { ret 1; }
    if (tail.reg   != REG_A0)                 { ret 1; }
    val hfa: abi.ParamSlot = classify_arg_v(v, 0, 8, 8, false, 0, true, false, 0, 0, 1, 8, abi.agg_none());
    if (hfa.class != abi.CLASS_FP)            { ret 1; }
    val tagg: abi.ParamSlot = classify_arg_v(v, 0, 8, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
    if (tagg.class != abi.CLASS_GP)           { ret 1; }
    if (tagg.reg   != REG_A0)                 { ret 1; }
    val spill: abi.ParamSlot = classify_arg_v(v, 8, 8, 8, false, 0, false, false, 8, 0, 0, 0, abi.agg_none());
    if (spill.class != abi.CLASS_STACK)       { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.riscv.register:refuses_a_member_with_no_variadic_rule" {
    var reg: abi.AbiRegistry = abi.registry_init();
    fin { abi.registry_dnit(?reg); }
    var vt:  abi.AbiVTable = abi.abi_vtable(
        abi.ABI_UNKNOWN, "ilp32e", isa.ARCH_RISCV64,
        lp64_arg, lp64_ret,
        lp64_gp_regs, lp64_cs,
        STACK_ALIGN, RED_ZONE, 0,
        REG_A0, true,
        true, true,
        0, 4,
        lp64_va
    );
    val undecided: RiscvAbi = rv_abi(abi.ABI_UNKNOWN, "ilp32e", isa.ARCH_RISCV64, 32, 0, 16, 6, 0, 2, 0,
                                     VARIADIC_RULE_UNDECLARED);
    if (!R.is_err[R.Void, str](install(?reg, undecided, ?vt))) { ret 1; }
    val decided: RiscvAbi = rv_abi(abi.ABI_UNKNOWN, "ilp32e", isa.ARCH_RISCV64, 32, 0, 16, 6, 0, 2, 0, 0);
    if (R.is_err[R.Void, str](install(?reg, decided, ?vt)))    { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.riscv.classify_arg_v:flatten_gated_on_member_width" {
    val d: abi.ParamSlot = classify_arg_v(v_lp64d(), 0, 16, 8, false, 0, true, false, 0, 0, 2, 8, abi.agg_none());
    if (d.piece_count   != 2)                    { ret 1; }
    if (d.pieces[0].reg != fp_param_reg(v_lp64d(), 0)) { ret 1; }
    val f: abi.ParamSlot = classify_arg_v(v_lp64f(), 0, 16, 8, false, 0, true, false, 0, 0, 2, 8, abi.agg_none());
    if (f.class           != abi.CLASS_GP) { ret 1; }
    if (f.pieces[0].reg   != REG_A0)       { ret 1; }
    if (f.pieces[1].reg   != REG_A1)       { ret 1; }
    val f32: abi.ParamSlot = classify_arg_v(v_lp64f(), 0, 8, 4, false, 0, true, false, 0, 0, 2, 4, abi.agg_none());
    if (f32.piece_count   != 2)                    { ret 1; }
    if (f32.pieces[0].reg != fp_param_reg(v_lp64f(), 0)) { ret 1; }
    val s: abi.ParamSlot = classify_arg_v(v_lp64(), 0, 8, 4, false, 0, true, false, 0, 0, 2, 4, abi.agg_none());
    if (s.class != abi.CLASS_GP) { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.riscv.classify_return_v:bank_matches_member" {
    val d: abi.ParamSlot = classify_return_v(v_lp64d(), 8, 8, true, 0, false, false, 0, 0, abi.agg_none());
    if (d.class != abi.CLASS_FP) { ret 1; }
    val f: abi.ParamSlot = classify_return_v(v_lp64f(), 8, 8, true, 0, false, false, 0, 0, abi.agg_none());
    if (f.class != abi.CLASS_GP) { ret 1; }
    if (f.reg   != REG_A0)       { ret 1; }
    val f32: abi.ParamSlot = classify_return_v(v_lp64f(), 4, 4, true, 0, false, false, 0, 0, abi.agg_none());
    if (f32.class != abi.CLASS_FP) { ret 1; }
    val s: abi.ParamSlot = classify_return_v(v_lp64(), 8, 8, true, 0, false, false, 0, 0, abi.agg_none());
    if (s.class != abi.CLASS_GP) { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.riscv.classify_arg_v:descriptor_facts_are_read" {
    val ilp32d: RiscvAbi = rv_abi(abi.ABI_UNKNOWN, "ilp32d", isa.ARCH_RISCV64, 32, 64, 32, 8, 8, 11, 12, 0);
    if (max_reg_ret(ilp32d) != 8) { ret 1; }
    val big: abi.ParamSlot = classify_arg_v(ilp32d, 0, 16, 4, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
    if (big.class != abi.CLASS_BYREF) { ret 1; }
    val pair: abi.ParamSlot = classify_arg_v(v_lp64d(), 0, 16, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
    if (pair.class != abi.CLASS_GP) { ret 1; }
    if (pair.piece_count != 2)      { ret 1; }
    val two: abi.ParamSlot = classify_arg_v(ilp32d, 0, 8, 4, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
    if (two.piece_count != 2) { ret 1; }
    val one: abi.ParamSlot = classify_arg_v(v_lp64d(), 0, 8, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
    if (one.piece_count != 1) { ret 1; }

    val lp64e: RiscvAbi = rv_abi(abi.ABI_UNKNOWN, "lp64e", isa.ARCH_RISCV64, 64, 0, 16, 6, 0, 2, 0, 0);
    val a6: abi.ParamSlot = classify_arg_v(lp64e, 6, 8, 8, false, 0, false, false, 6, 0, 0, 0, abi.agg_none());
    if (a6.class != abi.CLASS_STACK) { ret 1; }
    val ok: abi.ParamSlot = classify_arg_v(v_lp64d(), 6, 8, 8, false, 0, false, false, 6, 0, 0, 0, abi.agg_none());
    if (ok.class != abi.CLASS_GP)    { ret 1; }
    if (ok.reg   != REG_A0 + 6)      { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.riscv.register:members_declare_their_own_flen" {
    var reg: abi.AbiRegistry = abi.registry_init();
    fin { abi.registry_dnit(?reg); }
    val r: R.Result[R.Void, str] = register(?reg);
    if (R.is_err[R.Void, str](r))              { ret 1; }
    val lp64_vtable: O.Option[*abi.AbiVTable] = abi.lookup(?reg, v_lp64().name);
    val lp64f_vtable: O.Option[*abi.AbiVTable] = abi.lookup(?reg, v_lp64f().name);
    val lp64d_vtable: O.Option[*abi.AbiVTable] = abi.lookup(?reg, v_lp64d().name);
    if (O.is_none[*abi.AbiVTable](lp64_vtable) || O.is_none[*abi.AbiVTable](lp64f_vtable)
        || O.is_none[*abi.AbiVTable](lp64d_vtable)) { ret 1; }
    val vl: *abi.AbiVTable = O.unwrap[*abi.AbiVTable](lp64_vtable);
    val vf: *abi.AbiVTable = O.unwrap[*abi.AbiVTable](lp64f_vtable);
    val vd: *abi.AbiVTable = O.unwrap[*abi.AbiVTable](lp64d_vtable);
    if (vl.float_arg_bits  != 0)    { ret 1; }
    if (vf.float_arg_bits != 32)    { ret 1; }
    if (vd.float_arg_bits != 64)    { ret 1; }
    if (vl.indirect_result_reg != REG_A0) { ret 1; }
    if (!vd.indirect_result_in_argfile)   { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.riscv:register_file_banks" {
    val v: RiscvAbi = v_lp64d();
    var gp: [8]isa.Register;
    if (gp_param_regs_v(v, ?gp[0]) != 8)             { ret 1; }
    if (gp[0].id != REG_A0 || gp[7].id != REG_A0 + 7) { ret 1; }
    var cs: [23]isa.Register;
    if (callee_saved_v(v, ?cs[0]) != 23)             { ret 1; }
    if (cs[0].id != REG_S1 || cs[10].id != REG_S2 + 9) { ret 1; }
    if (cs[11].id != isa.regid_make(isa.REG_CLASS_ID_XMM, 8))  { ret 1; }
    if (cs[22].id != isa.regid_make(isa.REG_CLASS_ID_XMM, 27)) { ret 1; }
    var cs2: [23]isa.Register;
    if (callee_saved_v(v_lp64(), ?cs2[0]) != 23)     { ret 1; }
    if (cs2[11].id != isa.regid_make(isa.REG_CLASS_ID_XMM, 8)) { ret 1; }
    ret 0;
}
