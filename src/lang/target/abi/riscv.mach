use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use O: std.types.option;
use R: std.types.result;

use mach.lang.target.abi;
use mach.lang.target.isa;

pub rec RiscvAbi {
    id:                    u32;
    name:                  str;
    arch_id:               u32;
    xlen_bits:             u32;
    flen_bits:             u32;
    int_reg_count:         u32;
    gp_arg_count:          i32;
    fp_arg_count:          i32;
    gp_callee_saved_count: i32;
    fp_callee_saved_count: i32;

    variadic_float_bits:   u32;
}

pub val VARIADIC_RULE_UNDECLARED: u32 = 0xFFFFFFFF;

pub fun rv_abi(id: u32, name: str, arch_id: u32, xlen_bits: u32, flen_bits: u32,
               int_reg_count: u32, gp_arg_count: i32, fp_arg_count: i32,
               gp_callee_saved_count: i32, fp_callee_saved_count: i32,
               variadic_float_bits: u32) RiscvAbi {
    var v: RiscvAbi;
    v.id                    = id;
    v.name                  = name;
    v.arch_id               = arch_id;
    v.xlen_bits             = xlen_bits;
    v.flen_bits             = flen_bits;
    v.int_reg_count         = int_reg_count;
    v.gp_arg_count          = gp_arg_count;
    v.fp_arg_count          = fp_arg_count;
    v.gp_callee_saved_count = gp_callee_saved_count;
    v.fp_callee_saved_count = fp_callee_saved_count;
    v.variadic_float_bits   = variadic_float_bits;
    ret v;
}

pub val REG_A0: i32 = 10;
pub val REG_A1: i32 = 11;
pub val REG_S1: i32 = 9;
pub val REG_S2: i32 = 18;

pub val STACK_ALIGN: u32 = 16;
pub val RED_ZONE:    u32 = 0;

pub fun v_lp64() RiscvAbi {
    ret rv_abi(abi.ABI_LP64, abi.abi_name_for(abi.ABI_LP64), isa.ARCH_RISCV64, 64, 0, 32, 8, 8, 11, 12, 0);
}

pub fun v_lp64f() RiscvAbi {
    ret rv_abi(abi.ABI_LP64F, abi.abi_name_for(abi.ABI_LP64F), isa.ARCH_RISCV64, 64, 32, 32, 8, 8, 11, 12, 0);
}

pub fun v_lp64d() RiscvAbi {
    ret rv_abi(abi.ABI_LP64D, abi.abi_name_for(abi.ABI_LP64D), isa.ARCH_RISCV64, 64, 64, 32, 8, 8, 11, 12, 0);
}

pub fun v_ilp32() RiscvAbi {
    ret rv_abi(abi.ABI_ILP32, abi.abi_name_for(abi.ABI_ILP32), isa.ARCH_RISCV32, 32, 0, 32, 8, 8, 11, 12, 0);
}

pub fun v_ilp32f() RiscvAbi {
    ret rv_abi(abi.ABI_ILP32F, abi.abi_name_for(abi.ABI_ILP32F), isa.ARCH_RISCV32, 32, 32, 32, 8, 8, 11, 12, 0);
}

pub fun v_ilp32d() RiscvAbi {
    ret rv_abi(abi.ABI_ILP32D, abi.abi_name_for(abi.ABI_ILP32D), isa.ARCH_RISCV32, 32, 64, 32, 8, 8, 11, 12, 0);
}

pub fun xlen_bytes(v: RiscvAbi) u64 { ret (v.xlen_bits / 8)::u64; }

pub fun max_reg_ret(v: RiscvAbi) u64 { ret 2 * xlen_bytes(v); }

pub fun float_in_fp_bank(v: RiscvAbi, width: u64) bool {
    if (v.flen_bits == 0) { ret false; }
    ret (width * 8) <= v.flen_bits::u64;
}

pub fun gp_param_reg(v: RiscvAbi, index: i32) i32 {
    if (index < 0)                { ret -1; }
    if (index >= v.gp_arg_count)  { ret -1; }
    ret REG_A0 + index;
}

pub fun fp_param_reg(v: RiscvAbi, index: i32) i32 {
    if (index < 0)               { ret -1; }
    if (index >= v.fp_arg_count) { ret -1; }
    ret isa.regid_make(isa.REG_CLASS_ID_XMM, REG_A0 + index);
}

fun two_leaf_float_count(agg: abi.AggLayout) u32 {
    var nf: u32 = 0;
    var k: u32 = 0;
    for (k < 2) { if (agg.fields[k].is_float) { nf = nf + 1; } k = k + 1; }
    ret nf;
}

fun leaves_fit_fp_bank(v: RiscvAbi, agg: abi.AggLayout) bool {
    var k: u32 = 0;
    for (k < 2) {
        if (agg.fields[k].is_float) {
            if (!float_in_fp_bank(v, agg.fields[k].width::u64)) { ret false; }
        }
        k = k + 1;
    }
    ret true;
}

fun make_two_leaf_slot(agg: abi.AggLayout, nf: u32, fp0: i32, fp1: i32, gp0: i32, size: u64) abi.ParamSlot {
    var ps: [2]abi.ParamPiece;
    var fa_used: u32 = 0;
    var j: u32 = 0;
    for (j < 2) {
        if (agg.fields[j].is_float) {
            var reg: i32 = fp0;
            if (fa_used != 0) { reg = fp1; }
            ps[j] = abi.make_piece(abi.PIECE_FP, reg, agg.fields[j].offset::i64, 0, agg.fields[j].width);
            fa_used = fa_used + 1;
        } or {
            ps[j] = abi.make_piece(abi.PIECE_GP, gp0, agg.fields[j].offset::i64, 0, agg.fields[j].width);
        }
        j = j + 1;
    }
    var class: abi.ParamClass = abi.CLASS_GP;
    if (nf == 2) { class = abi.CLASS_FP; }
    ret abi.make_slot_pieces(class, ?ps[0], 2, size);
}

fun place_two_words(v: RiscvAbi, gp_used: i32, size: u64) abi.ParamSlot {
    val word: u64 = xlen_bytes(v);

    if (gp_used + 2 <= v.gp_arg_count) {
        ret abi.make_slot_pair(abi.CLASS_GP, gp_param_reg(v, gp_used), gp_param_reg(v, gp_used + 1),
                               0, size, word::u32);
    }

    if (gp_used + 1 == v.gp_arg_count) {
        var ps: [2]abi.ParamPiece;
        ps[0] = abi.make_piece(abi.PIECE_GP,    gp_param_reg(v, gp_used), 0,          0, word::u8);
        ps[1] = abi.make_piece(abi.PIECE_STACK, -1,                       word::i64,  0, word::u8);
        ret abi.make_slot_pieces(abi.CLASS_GP, ?ps[0], 2, size);
    }

    ret abi.make_slot(abi.CLASS_STACK, -1, 0, size);
}

pub fun classify_arg_v(v: RiscvAbi, index: i32, size: u64, align: u64,
                       is_float: bool, fp_eightbytes: u8, is_aggregate: bool,
                       is_vector: bool,
                       gp_used: i32, fp_used: i32, hfa_members: u8, hfa_elem: u8,
                       agg: abi.AggLayout) abi.ParamSlot {
    val word: u64 = xlen_bytes(v);

    if (is_vector) {
        if (gp_used < v.gp_arg_count) {
            ret abi.make_slot(abi.CLASS_BYREF, gp_param_reg(v, gp_used), 0, word);
        }
        ret abi.make_slot(abi.CLASS_STACK_BYREF, -1, 0, word);
    }

    if (is_aggregate && size > max_reg_ret(v)) {
        if (gp_used < v.gp_arg_count) {
            ret abi.make_slot(abi.CLASS_BYREF, gp_param_reg(v, gp_used), 0, word);
        }
        ret abi.make_slot(abi.CLASS_STACK_BYREF, -1, 0, word);
    }

    if (is_aggregate && (hfa_members == 1 || hfa_members == 2)) {
        if (float_in_fp_bank(v, hfa_elem::u64)) {
            if (fp_used + hfa_members::i32 <= v.fp_arg_count) {
                ret abi.make_slot_hfa(fp_param_reg(v, fp_used), hfa_members, hfa_elem, size);
            }
        }
    }

    if (is_aggregate && agg.field_count == 2 && leaves_fit_fp_bank(v, agg)) {
        val nf: u32 = two_leaf_float_count(agg);
        if (nf == 2) {
            if (fp_used + 2 <= v.fp_arg_count) {
                ret make_two_leaf_slot(agg, 2, fp_param_reg(v, fp_used), fp_param_reg(v, fp_used + 1), -1, size);
            }
        } or (nf == 1) {
            if (fp_used < v.fp_arg_count && gp_used < v.gp_arg_count) {
                ret make_two_leaf_slot(agg, 1, fp_param_reg(v, fp_used), -1, gp_param_reg(v, gp_used), size);
            }
        }
    }

    if (is_aggregate) {
        if (size <= word) {
            if (gp_used < v.gp_arg_count) {
                ret abi.make_slot(abi.CLASS_GP, gp_param_reg(v, gp_used), 0, size);
            }
            ret abi.make_slot(abi.CLASS_STACK, -1, 0, size);
        }
        ret place_two_words(v, gp_used, size);
    }

    if (is_float) {
        if (float_in_fp_bank(v, size) && fp_used < v.fp_arg_count) {
            ret abi.make_slot(abi.CLASS_FP, fp_param_reg(v, fp_used), 0, size);
        }
        if (size > word) { ret place_two_words(v, gp_used, size); }
        if (gp_used < v.gp_arg_count) {
            ret abi.make_slot(abi.CLASS_GP, gp_param_reg(v, gp_used), 0, size);
        }
        ret abi.make_slot(abi.CLASS_STACK, -1, 0, size);
    }

    if (size > word) { ret place_two_words(v, gp_used, size); }

    if (gp_used < v.gp_arg_count) {
        ret abi.make_slot(abi.CLASS_GP, gp_param_reg(v, gp_used), 0, size);
    }
    ret abi.make_slot(abi.CLASS_STACK, -1, 0, size);
}

pub fun classify_return_v(v: RiscvAbi, size: u64, align: u64,
                          is_float: bool, fp_eightbytes: u8, is_aggregate: bool,
                          is_vector: bool, hfa_members: u8, hfa_elem: u8,
                          agg: abi.AggLayout) abi.ParamSlot {
    val word: u64 = xlen_bytes(v);

    if (size == 0) { ret abi.make_slot(abi.CLASS_GP, -1, 0, 0); }

    if (is_vector)                              { ret abi.make_slot(abi.CLASS_SRET, REG_A0, 0, word); }
    if (is_aggregate && size > max_reg_ret(v))  { ret abi.make_slot(abi.CLASS_SRET, REG_A0, 0, word); }

    if (is_aggregate && (hfa_members == 1 || hfa_members == 2)) {
        if (float_in_fp_bank(v, hfa_elem::u64)) {
            ret abi.make_slot_hfa(fp_param_reg(v, 0), hfa_members, hfa_elem, size);
        }
    }

    if (is_aggregate && agg.field_count == 2 && leaves_fit_fp_bank(v, agg)) {
        val nf: u32 = two_leaf_float_count(agg);
        if (nf == 2) {
            ret make_two_leaf_slot(agg, 2, fp_param_reg(v, 0), fp_param_reg(v, 1), -1, size);
        } or (nf == 1) {
            ret make_two_leaf_slot(agg, 1, fp_param_reg(v, 0), -1, REG_A0, size);
        }
    }

    if (is_aggregate) {
        if (size <= word) { ret abi.make_slot(abi.CLASS_GP, REG_A0, 0, size); }
        ret abi.make_slot_pair(abi.CLASS_GP, REG_A0, REG_A1, 0, size, xlen_bytes(v)::u32);
    }

    if (is_float && float_in_fp_bank(v, size)) {
        ret abi.make_slot(abi.CLASS_FP, fp_param_reg(v, 0), 0, size);
    }

    if (size > word) {
        ret abi.make_slot_pair(abi.CLASS_GP, REG_A0, REG_A1, 0, size, word::u32);
    }

    ret abi.make_slot(abi.CLASS_GP, REG_A0, 0, size);
}

pub fun gp_param_regs_v(v: RiscvAbi, out: *isa.Register) i32 {
    var i: i32 = 0;
    for (i < v.gp_arg_count) {
        out[i].id   = gp_param_reg(v, i);
        out[i].size = xlen_bytes(v)::u8;
        i = i + 1;
    }
    ret v.gp_arg_count;
}

pub fun callee_saved_v(v: RiscvAbi, out: *isa.Register) i32 {
    val w: u8 = xlen_bytes(v)::u8;
    out[0].id   = REG_S1;
    out[0].size = w;
    var i: i32 = 0;
    for (i < v.gp_callee_saved_count - 1) {
        out[1 + i].id   = REG_S2 + i;
        out[1 + i].size = w;
        i = i + 1;
    }
    val fbase: i32 = v.gp_callee_saved_count;
    out[fbase].id       = isa.regid_make(isa.REG_CLASS_ID_XMM, 8);
    out[fbase].size     = 8;
    out[fbase + 1].id   = isa.regid_make(isa.REG_CLASS_ID_XMM, 9);
    out[fbase + 1].size = 8;
    i = 0;
    for (i < v.fp_callee_saved_count - 2) {
        out[fbase + 2 + i].id   = isa.regid_make(isa.REG_CLASS_ID_XMM, 18 + i);
        out[fbase + 2 + i].size = 8;
        i = i + 1;
    }
    ret v.gp_callee_saved_count + v.fp_callee_saved_count;
}

pub fun va_model_v(v: RiscvAbi) abi.VaModel {
    ret abi.va_model_make(abi.VA_MODEL_REG_SAVE, false, -1, v.variadic_float_bits);
}

fun lp64_classify(size: u64, align: u64, is_float: bool, fpe: u8, is_agg: bool,
                  gp: i32, fp: i32, hm: u8, he: u8) abi.ParamSlot {
    ret classify_arg_v(v_lp64(), 0, size, align, is_float, fpe, is_agg, false, gp, fp, hm, he, abi.agg_none());
}
fun lp64_arg(index: i32, size: u64, align: u64, is_float: bool, fpe: u8, is_agg: bool,
             is_vec: bool, gp: i32, fp: i32, hm: u8, he: u8,
             agg: abi.AggLayout) abi.ParamSlot {
    ret classify_arg_v(v_lp64(), index, size, align, is_float, fpe, is_agg, is_vec, gp, fp, hm, he, agg);
}
fun lp64_ret(size: u64, align: u64, is_float: bool, fpe: u8, is_agg: bool, is_vec: bool,
             hm: u8, he: u8, agg: abi.AggLayout) abi.ParamSlot {
    ret classify_return_v(v_lp64(), size, align, is_float, fpe, is_agg, is_vec, hm, he, agg);
}
fun lp64_gp_regs(out: *isa.Register) i32 { ret gp_param_regs_v(v_lp64(), out); }
fun lp64_va() abi.VaModel  { ret va_model_v(v_lp64()); }
fun lp64_cs(out: *isa.Register) i32      { ret callee_saved_v(v_lp64(), out); }

fun lp64f_classify(size: u64, align: u64, is_float: bool, fpe: u8, is_agg: bool,
                   gp: i32, fp: i32, hm: u8, he: u8) abi.ParamSlot {
    ret classify_arg_v(v_lp64f(), 0, size, align, is_float, fpe, is_agg, false, gp, fp, hm, he, abi.agg_none());
}
