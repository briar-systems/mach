use mach.lang.fail;
use std.types.bool.false;
use std.types.bool.true;

use lang_mir: mach.lang.mir;
use mach.lang.target.abi;
use catalog_abi:  mach.lang.target.catalog.abi;
use catalog_arch: mach.lang.target.catalog.arch;
use mach.lang.target.isa;
use isa_inst:     mach.lang.target.isa.inst;
use target_model: mach.lang.target.model;

val REG_X0:  i32 = isa_inst.REG_GP_BASE | 0;
val REG_X1:  i32 = isa_inst.REG_GP_BASE | 1;
#[testing]
val REG_X7:  i32 = isa_inst.REG_GP_BASE | 7;
val REG_X8:  i32 = isa_inst.REG_GP_BASE | 8;
val REG_X19: i32 = isa_inst.REG_GP_BASE | 19;
#[testing]
val REG_X28: i32 = isa_inst.REG_GP_BASE | 28;
val REG_V0:  i32 = isa_inst.REG_FP_BASE | 0;

val GP_PARAM_COUNT:        i32 = 8;
val FP_PARAM_COUNT:        i32 = 8;
val GP_CALLEE_SAVED_COUNT: i32 = 10;
val FP_CALLEE_SAVED_COUNT: i32 = 8;
val CALLEE_SAVED_COUNT:    i32 = 18;

val STACK_ALIGN: u32 = 16;
val RED_ZONE:    u32 = 0;
val MAX_REG_RET: u64 = 16;

val WORD: u32 = 8;

# a 16-byte integer scalar: C.10 rounds NGRN up to even when its alignment is
# 16 and passes it in the next two registers, else C.11 sets NGRN to 8 and it
# goes to the stack at its natural 16-byte alignment. darwin hands the
# classifier an alignment of 8, so the pair starts in any register
val DOUBLE_WORD: u64 = 16;

fun gp_param_reg(index: i32) i32 {
    if (index < 0)               { ret isa_inst.REG_NONE; }
    if (index >= GP_PARAM_COUNT) { ret isa_inst.REG_NONE; }
    ret REG_X0 + index;
}

fun fp_param_reg(index: i32) i32 {
    if (index < 0)               { ret isa_inst.REG_NONE; }
    if (index >= FP_PARAM_COUNT) { ret isa_inst.REG_NONE; }
    ret isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, index);
}

val VEC_REG_BYTES: u8 = 16;

# a composite that is no HFA or HVA takes a word stack slot where fixed
# arguments are otherwise placed at their natural size, as Apple places one
fun classify_arg(vt: *abi.AbiVTable, q: *abi.ArgQuery) abi.ParamSlot {
    var hfa_members: u8 = 0;
    var hfa_elem:    u8 = 0;
    if (abi.arg_members_read(q)) { abi.homogeneous_float(vt, q.types, q.ty, ?hfa_members, ?hfa_elem); }
    var slot: abi.ParamSlot = place_arg(vt, q, hfa_members, hfa_elem);
    if (q.is_aggregate && hfa_members == 0) { slot.word_stack = true; }
    ret slot;
}

fun place_arg(vt: *abi.AbiVTable, q: *abi.ArgQuery, hfa_members: u8, hfa_elem: u8) abi.ParamSlot {
    # an empty record takes no register and no stack: clang ignores one in C on
    # linux, and Apple's arm64 ABI lets a function ignore it
    if (q.is_aggregate && q.size == 0) {
        ret abi.make_slot(abi.CLASS_GP, isa_inst.REG_NONE, 0, 0, 0);
    }

    # C.3: an HFA or HVA that does not fit the vector registers left sets NSRN
    # to 8, so no later floating-point argument takes one
    if (q.is_aggregate && hfa_members > 0) {
        if (q.fp_used + hfa_members::i32 <= FP_PARAM_COUNT) {
            ret abi.make_slot_hfa(fp_param_reg(q.fp_used), hfa_members, hfa_elem, q.size);
        }
        var hs: abi.ParamSlot = abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
        hs.fp_consumed = remaining(FP_PARAM_COUNT, q.fp_used);
        ret hs;
    }

    if (q.is_aggregate && q.size > MAX_REG_RET) {
        if (q.gp_used < GP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_BYREF, gp_param_reg(q.gp_used), 0, 8, 8);
        }
        ret abi.make_slot(abi.CLASS_STACK_BYREF, isa_inst.REG_NONE, 0, 8, 0);
    }

    if (q.is_aggregate) {
        if (q.size <= 8) {
            if (q.gp_used < GP_PARAM_COUNT) {
                ret abi.make_slot(abi.CLASS_GP, gp_param_reg(q.gp_used), 0, q.size, 8);
            }
            ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
        }
        # C.12: a composite of alignment 16 rounds NGRN up to even, as a 16-byte
        # integer does. its alignment is the natural one, which darwin caps at 8
        var ngrn: i32 = q.gp_used;
        if (q.align >= DOUBLE_WORD && (ngrn & 1) != 0) { ngrn = ngrn + 1; }
        if (ngrn + 2 <= GP_PARAM_COUNT) {
            var ps: abi.ParamSlot = abi.make_slot_pair(abi.CLASS_GP, gp_param_reg(ngrn), gp_param_reg(ngrn + 1), 0, q.size, WORD);
            ps.gp_consumed = ngrn + 2 - q.gp_used;
            ret ps;
        }
        # C.13: a composite that does not fit the general registers left sets
        # NGRN to 8, so no later integer argument takes one
        var cs: abi.ParamSlot = abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
        cs.gp_consumed = remaining(GP_PARAM_COUNT, q.gp_used);
        ret cs;
    }

    if (q.is_vector) {
        if (q.size <= VEC_REG_BYTES::u64) {
            if (q.fp_used < FP_PARAM_COUNT) {
                ret abi.make_slot_hfa(fp_param_reg(q.fp_used), 1, VEC_REG_BYTES, q.size);
            }
            ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
        }
        if (q.gp_used < GP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_BYREF, gp_param_reg(q.gp_used), 0, 8, 8);
        }
        ret abi.make_slot(abi.CLASS_STACK_BYREF, isa_inst.REG_NONE, 0, 8, 0);
    }

    if (abi.arg_is_float(vt, q)) {
        if (q.fp_used < FP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_FP, fp_param_reg(q.fp_used), 0, q.size, q.size::u8);
        }
        ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
    }

    if (q.size == DOUBLE_WORD) {
        var ngrn: i32 = q.gp_used;
        if (q.align >= DOUBLE_WORD && (ngrn & 1) != 0) { ngrn = ngrn + 1; }
        if (ngrn + 2 <= GP_PARAM_COUNT) {
            var s: abi.ParamSlot = abi.make_slot_pair(abi.CLASS_GP, gp_param_reg(ngrn), gp_param_reg(ngrn + 1), 0, q.size, WORD);
            s.gp_consumed = ngrn + 2 - q.gp_used;
            ret s;
        }
        var st: abi.ParamSlot = abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
        st.gp_consumed = remaining(GP_PARAM_COUNT, q.gp_used);
        ret st;
    }

    if (q.gp_used < GP_PARAM_COUNT) {
        ret abi.make_slot(abi.CLASS_GP, gp_param_reg(q.gp_used), 0, q.size, 8);
    }
    ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
}

fun remaining(count: i32, used: i32) i32 {
    if (used >= count) { ret 0; }
    ret count - used;
}

fun classify_return(vt: *abi.AbiVTable, q: *abi.RetQuery) abi.ParamSlot {
    var hfa_members: u8 = 0;
    var hfa_elem:    u8 = 0;
    abi.homogeneous_float(vt, q.types, q.ty, ?hfa_members, ?hfa_elem);
    if (q.size == 0) {
        ret abi.make_slot(abi.CLASS_GP, isa_inst.REG_NONE, 0, 0, 0);
    }

    if (q.is_aggregate && hfa_members > 0) {
        ret abi.make_slot_hfa(fp_param_reg(0), hfa_members, hfa_elem, q.size);
    }

    if (q.is_aggregate && q.size > MAX_REG_RET) {
        ret abi.make_slot(abi.CLASS_SRET, REG_X8, 0, 8, 8);
    }

    if (q.is_aggregate) {
        if (q.size <= 8) {
            ret abi.make_slot(abi.CLASS_GP, REG_X0, 0, q.size, 8);
        }
        ret abi.make_slot_pair(abi.CLASS_GP, REG_X0, REG_X1, 0, q.size, WORD);
    }

    if (q.is_vector) {
        if (q.size <= VEC_REG_BYTES::u64) {
            ret abi.make_slot_hfa(fp_param_reg(0), 1, VEC_REG_BYTES, q.size);
        }
        ret abi.make_slot(abi.CLASS_SRET, REG_X8, 0, 8, 8);
    }

    if (abi.ret_is_float(vt, q)) {
        ret abi.make_slot(abi.CLASS_FP, fp_param_reg(0), 0, q.size, q.size::u8);
    }

    if (q.size == DOUBLE_WORD) {
        ret abi.make_slot_pair(abi.CLASS_GP, REG_X0, REG_X1, 0, q.size, WORD);
    }
    ret abi.make_slot(abi.CLASS_GP, REG_X0, 0, q.size, 8);
}

val GP_ARGS: [8]target_model.Register = [8]target_model.Register{
    target_model.Register{id: REG_X0, size: 8},
    target_model.Register{id: REG_X0 + 1, size: 8},
    target_model.Register{id: REG_X0 + 2, size: 8},
    target_model.Register{id: REG_X0 + 3, size: 8},
    target_model.Register{id: REG_X0 + 4, size: 8},
    target_model.Register{id: REG_X0 + 5, size: 8},
    target_model.Register{id: REG_X0 + 6, size: 8},
    target_model.Register{id: REG_X0 + 7, size: 8},
};

val CALLEE_SAVED: [18]target_model.Register = [18]target_model.Register{
    target_model.Register{id: REG_X19, size: 8},
    target_model.Register{id: REG_X19 + 1, size: 8},
    target_model.Register{id: REG_X19 + 2, size: 8},
    target_model.Register{id: REG_X19 + 3, size: 8},
    target_model.Register{id: REG_X19 + 4, size: 8},
    target_model.Register{id: REG_X19 + 5, size: 8},
    target_model.Register{id: REG_X19 + 6, size: 8},
    target_model.Register{id: REG_X19 + 7, size: 8},
    target_model.Register{id: REG_X19 + 8, size: 8},
    target_model.Register{id: REG_X19 + 9, size: 8},
    target_model.Register{id: REG_V0 + 8, size: 16},
    target_model.Register{id: REG_V0 + 9, size: 16},
    target_model.Register{id: REG_V0 + 10, size: 16},
    target_model.Register{id: REG_V0 + 11, size: 16},
    target_model.Register{id: REG_V0 + 12, size: 16},
    target_model.Register{id: REG_V0 + 13, size: 16},
    target_model.Register{id: REG_V0 + 14, size: 16},
    target_model.Register{id: REG_V0 + 15, size: 16},
};

val VA_MODEL: abi.VaModel = abi.VaModel{kind: abi.VA_MODEL_REG_SAVE, float_dup_gp: false, vector_count_reg: isa_inst.REG_NONE, variadic_float_bits: 64};

pub val VTABLE: abi.AbiVTable = abi.AbiVTable{
    passing:             catalog_abi.PASSING_CARRIERS,
    id:                  catalog_abi.AAPCS64,
    name:                "aapcs64",
    arch_id:             catalog_arch.AARCH64,
    arg_passing:         classify_arg,
    ret_passing:         classify_return,
    gp_arg_regs:         target_model.RegFile{regs: ?GP_ARGS[0], count: GP_PARAM_COUNT},
    callee_saved:        target_model.RegFile{regs: ?CALLEE_SAVED[0], count: CALLEE_SAVED_COUNT},
    stack_align:         STACK_ALIGN,
    red_zone:            RED_ZONE,
    indirect_result_reg: REG_X8,
    # v8-v15 keep only their low 64 bits
    fp_callee_saved_bytes: 8,
    float_arg_bits:        64,
    arg_slot_granularity:  WORD,
    va_model:              ?VA_MODEL,
    agg_natural_align:     true,
    # a half-precision float is a floating-point type of AAPCS64: it rides an h
    # register and is an HFA member of two bytes
    half: abi.HALF_FLOAT,
};

# the gp and fp banks count independently: a float after eight integers still gets v0
#[testing]
fun t_arg(q: abi.ArgQuery) abi.ParamSlot {
    var arg: abi.ArgQuery = q;
    ret classify_arg(?VTABLE, ?arg);
}

#[testing]
fun t_ret(q: abi.RetQuery) abi.ParamSlot {
    var result: abi.RetQuery = q;
    ret classify_return(?VTABLE, ?result);
}

test classify_arg__scalars_and_independent_banks {
    val i: abi.ParamSlot = t_arg(abi.arg_query(0, 8, 8, false, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (i.class != abi.CLASS_GP || lang_mir.preg_regid(i.reg) != REG_X0) { ret 1; }
    val f: abi.ParamSlot = t_arg(abi.arg_query(0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (f.class != abi.CLASS_FP || lang_mir.preg_regid(f.reg) != fp_param_reg(0)) { ret 2; }
    val i7: abi.ParamSlot = t_arg(abi.arg_query(0, 8, 8, false, 0, false, false, 7, 0, 0, 0, abi.agg_none(), 16));
    if (i7.class != abi.CLASS_GP || lang_mir.preg_regid(i7.reg) != REG_X7) { ret 3; }
    val f0: abi.ParamSlot = t_arg(abi.arg_query(0, 8, 8, true, 0, false, false, 7, 0, 0, 0, abi.agg_none(), 16));
    if (f0.class != abi.CLASS_FP || lang_mir.preg_regid(f0.reg) != fp_param_reg(0)) { ret 4; }
    val s: abi.ParamSlot = t_arg(abi.arg_query(0, 8, 8, false, 0, false, false, 8, 0, 0, 0, abi.agg_none(), 16));
    if (s.class != abi.CLASS_STACK) { ret 5; }
    ret 0;
}

test classify_arg__integer_aggregates {
    val s: abi.ParamSlot = t_arg(abi.arg_query(0, 16, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (s.class != abi.CLASS_GP || s.piece_count != 2)                                                    { ret 1; }
    if (lang_mir.preg_regid(s.pieces[0].reg) != REG_X0 || lang_mir.preg_regid(s.pieces[1].reg) != REG_X1) { ret 1; }
    val o: abi.ParamSlot = t_arg(abi.arg_query(0, 8, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (o.class != abi.CLASS_GP || o.piece_count != 1 || lang_mir.preg_regid(o.pieces[0].reg) != REG_X0) { ret 2; }
    val big: abi.ParamSlot = t_arg(abi.arg_query(0, 32, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (big.class != abi.CLASS_BYREF || lang_mir.preg_regid(big.reg) != REG_X0) { ret 3; }
    val spilled: abi.ParamSlot = t_arg(abi.arg_query(0, 32, 8, false, 0, true, false, 8, 0, 0, 0, abi.agg_none(), 16));
    if (spilled.class != abi.CLASS_STACK_BYREF) { ret 4; }
    ret 0;
}

# C.10: a 16-byte integer rounds NGRN to even and rides the next pair; C.11:
# with fewer than two registers left it exhausts them and goes to the stack.
# a 16-byte composite of alignment 8 (C.12) does not round. at
# alignment 8 (darwin) the pair starts in the next register and C.11 still
# holds
test classify_arg__int128_even_pair_or_exhausts_registers {
    val a: abi.ParamSlot = t_arg(abi.arg_query(0, 16, 16, false, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (a.class != abi.CLASS_GP || a.piece_count != 2 || a.gp_consumed != 2)        { ret 1; }
    if (lang_mir.preg_regid(a.pieces[0].reg) != REG_X0 || a.pieces[0].src_off != 0) { ret 2; }
    if (lang_mir.preg_regid(a.pieces[1].reg) != REG_X1 || a.pieces[1].src_off != 8) { ret 3; }
    val b: abi.ParamSlot = t_arg(abi.arg_query(1, 16, 16, false, 0, false, false, 1, 0, 0, 0, abi.agg_none(), 16));
    if (b.class != abi.CLASS_GP || b.gp_consumed != 3)                                                                                                                                        { ret 4; }
    if (lang_mir.preg_regid(b.pieces[0].reg) != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 2) || lang_mir.preg_regid(b.pieces[1].reg) != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 3)) { ret 5; }
    val c: abi.ParamSlot = t_arg(abi.arg_query(6, 16, 16, false, 0, false, false, 6, 0, 0, 0, abi.agg_none(), 16));
    if (c.class != abi.CLASS_GP || c.gp_consumed != 2)                                                                                                                                        { ret 6; }
    if (lang_mir.preg_regid(c.pieces[0].reg) != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 6) || lang_mir.preg_regid(c.pieces[1].reg) != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 7)) { ret 7; }
    val d: abi.ParamSlot = t_arg(abi.arg_query(7, 16, 16, false, 0, false, false, 7, 0, 0, 0, abi.agg_none(), 16));
    if (d.class != abi.CLASS_STACK || d.size != 16 || d.gp_consumed != 1) { ret 8; }
    val e: abi.ParamSlot = t_arg(abi.arg_query(8, 16, 16, false, 0, false, false, 8, 0, 0, 0, abi.agg_none(), 16));
    if (e.class != abi.CLASS_STACK || e.gp_consumed != 0) { ret 9; }
    val g: abi.ParamSlot = t_arg(abi.arg_query(1, 16, 8, false, 0, true, false, 1, 0, 0, 0, abi.agg_none(), 16));
    if (g.class != abi.CLASS_GP || lang_mir.preg_regid(g.pieces[0].reg) != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1) || g.gp_consumed != 2) { ret 10; }
    val u: abi.ParamSlot = t_arg(abi.arg_query(1, 16, 8, false, 0, false, false, 1, 0, 0, 0, abi.agg_none(), 16));
    if (u.class != abi.CLASS_GP || u.gp_consumed != 2)                                                                                                                                        { ret 14; }
    if (lang_mir.preg_regid(u.pieces[0].reg) != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1) || lang_mir.preg_regid(u.pieces[1].reg) != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 2)) { ret 15; }
    val v: abi.ParamSlot = t_arg(abi.arg_query(7, 16, 8, false, 0, false, false, 7, 0, 0, 0, abi.agg_none(), 16));
    if (v.class != abi.CLASS_STACK || v.gp_consumed != 1) { ret 16; }
    val r: abi.ParamSlot = t_ret(abi.ret_query(16, 16, false, 0, false, false, 0, 0, abi.agg_none(), 16));
    if (r.class != abi.CLASS_GP || r.piece_count != 2)                              { ret 11; }
    if (lang_mir.preg_regid(r.pieces[0].reg) != REG_X0 || r.pieces[0].src_off != 0) { ret 12; }
    if (lang_mir.preg_regid(r.pieces[1].reg) != REG_X1 || r.pieces[1].src_off != 8) { ret 13; }
    ret 0;
}

# C.13 and C.3: a composite or HFA that spills gives the rest of its bank to
# nothing, and the other bank is untouched
test classify_arg__spilled_aggregate_exhausts_its_bank {
    val s: abi.ParamSlot = t_arg(abi.arg_query(7, 12, 8, false, 0, true, false, 7, 0, 0, 0, abi.agg_none(), 16));
    if (s.class != abi.CLASS_STACK || s.gp_consumed != 1 || s.fp_consumed != 0) { ret 1; }
    val f: abi.ParamSlot = t_arg(abi.arg_query(8, 8, 8, false, 0, false, false, 8, 0, 0, 0, abi.agg_none(), 16));
    if (f.class != abi.CLASS_STACK) { ret 2; }
    val h: abi.ParamSlot = t_arg(abi.arg_query(6, 24, 8, false, 0, true, false, 0, 6, 3, 8, abi.agg_none(), 16));
    if (h.class != abi.CLASS_STACK || h.fp_consumed != 2 || h.gp_consumed != 0) { ret 3; }
    val g: abi.ParamSlot = t_arg(abi.arg_query(0, 8, 4, false, 0, true, false, 0, 7, 2, 4, abi.agg_none(), 16));
    if (g.class != abi.CLASS_STACK || g.fp_consumed != 1) { ret 4; }
    val full: abi.ParamSlot = t_arg(abi.arg_query(8, 12, 8, false, 0, true, false, 8, 8, 0, 0, abi.agg_none(), 16));
    if (full.gp_consumed != 0 || full.fp_consumed != 0) { ret 5; }
    val fits: abi.ParamSlot = t_arg(abi.arg_query(6, 12, 8, false, 0, true, false, 6, 0, 0, 0, abi.agg_none(), 16));
    if (fits.class != abi.CLASS_GP || fits.gp_consumed != 2) { ret 6; }
    ret 0;
}

# C.12: a composite of natural alignment 16 rounds NGRN to even like a 16-byte
# integer, and one that then does not fit exhausts the registers
test classify_arg__aligned_composite_even_pair {
    val a: abi.ParamSlot = t_arg(abi.arg_query(1, 16, 16, false, 0, true, false, 1, 0, 0, 0, abi.agg_none(), 16));
    if (a.class != abi.CLASS_GP || a.gp_consumed != 3)                                                                                                                                        { ret 1; }
    if (lang_mir.preg_regid(a.pieces[0].reg) != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 2) || lang_mir.preg_regid(a.pieces[1].reg) != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 3)) { ret 2; }
    val b: abi.ParamSlot = t_arg(abi.arg_query(2, 16, 16, false, 0, true, false, 2, 0, 0, 0, abi.agg_none(), 16));
    if (b.gp_consumed != 2 || lang_mir.preg_regid(b.pieces[0].reg) != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 2)) { ret 3; }
    val c: abi.ParamSlot = t_arg(abi.arg_query(7, 16, 16, false, 0, true, false, 7, 0, 0, 0, abi.agg_none(), 16));
    if (c.class != abi.CLASS_STACK || c.gp_consumed != 1) { ret 4; }
    val d: abi.ParamSlot = t_arg(abi.arg_query(1, 16, 8, false, 0, true, false, 1, 0, 0, 0, abi.agg_none(), 16));
    if (d.gp_consumed != 2 || lang_mir.preg_regid(d.pieces[0].reg) != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1)) { ret 5; }
    ret 0;
}

# an empty record rides no register and no stack, and takes none from either
# bank
test classify_arg__empty_record_takes_nothing {
    val e: abi.ParamSlot = t_arg(abi.arg_query(1, 0, 1, false, 0, true, false, 1, 0, 0, 0, abi.agg_none(), 16));
    if (e.class != abi.CLASS_GP || e.piece_count != 0) { ret 1; }
    if (e.gp_consumed != 0 || e.fp_consumed != 0)      { ret 2; }
    val f: abi.ParamSlot = t_arg(abi.arg_query(9, 0, 1, false, 0, true, false, 8, 8, 0, 0, abi.agg_none(), 16));
    if (f.class != abi.CLASS_GP || f.piece_count != 0) { ret 3; }
    ret 0;
}

test classify_arg__hfa {
    val s: abi.ParamSlot = t_arg(abi.arg_query(0, 8, 4, false, 0, true, false, 0, 0, 2, 4, abi.agg_none(), 16));
    if (s.piece_count != 2)                                      { ret 1; }
    if (lang_mir.preg_regid(s.pieces[0].reg) != fp_param_reg(0)) { ret 1; }
    if (s.pieces[0].width != 4)                                  { ret 1; }
    if (lang_mir.preg_regid(s.pieces[1].reg) != fp_param_reg(1)) { ret 1; }
    if (s.size != 8)                                             { ret 1; }
    val q: abi.ParamSlot = t_arg(abi.arg_query(0, 32, 8, false, 0, true, false, 0, 0, 4, 8, abi.agg_none(), 16));
    if (q.piece_count != 4)                                      { ret 1; }
    if (lang_mir.preg_regid(q.pieces[0].reg) != fp_param_reg(0)) { ret 1; }
    if (q.pieces[0].width != 8)                                  { ret 1; }
    if (lang_mir.preg_regid(q.pieces[3].reg) != fp_param_reg(3)) { ret 1; }
    val a: abi.ParamSlot = t_arg(abi.arg_query(0, 8, 4, false, 0, true, false, 0, 5, 2, 4, abi.agg_none(), 16));
    if (lang_mir.preg_regid(a.pieces[0].reg) != fp_param_reg(5)) { ret 1; }
    val m: abi.ParamSlot = t_arg(abi.arg_query(0, 12, 4, false, 0, true, false, 0, 6, 3, 4, abi.agg_none(), 16));
    if (m.class != abi.CLASS_STACK) { ret 1; }
    ret 0;
}

# a short vector rides one whole v register whatever its size, up to 16 bytes;
# a wider one goes by reference and returns through x8
test classify__short_vectors {
    val v: abi.ParamSlot = t_arg(abi.arg_query(0, 16, 16, false, 0, false, true, 0, 0, 0, 0, abi.agg_none(), 16));
    if (v.class != abi.CLASS_FP || lang_mir.preg_regid(v.reg) != fp_param_reg(0)) { ret 1; }
    if (v.piece_count != 1 || v.pieces[0].width != 16)                            { ret 1; }
    val v3: abi.ParamSlot = t_arg(abi.arg_query(1, 16, 16, false, 0, false, true, 0, 3, 0, 0, abi.agg_none(), 16));
    if (lang_mir.preg_regid(v3.reg) != fp_param_reg(3)) { ret 2; }
    val vs: abi.ParamSlot = t_arg(abi.arg_query(2, 16, 16, false, 0, false, true, 0, 8, 0, 0, abi.agg_none(), 16));
    if (vs.class != abi.CLASS_STACK) { ret 3; }
    val r: abi.ParamSlot = t_ret(abi.ret_query(16, 16, false, 0, false, true, 0, 0, abi.agg_none(), 16));
    if (r.class != abi.CLASS_FP || lang_mir.preg_regid(r.reg) != fp_param_reg(0) || r.pieces[0].width != 16) { ret 4; }

    val d: abi.ParamSlot = t_arg(abi.arg_query(0, 8, 8, false, 0, false, true, 0, 0, 0, 0, abi.agg_none(), 16));
    if (d.class != abi.CLASS_FP || lang_mir.preg_regid(d.reg) != fp_param_reg(0)) { ret 5; }
    if (d.piece_count != 1 || d.pieces[0].width != 16 || d.size != 8)             { ret 5; }
    val t: abi.ParamSlot = t_arg(abi.arg_query(0, 12, 16, false, 0, false, true, 0, 0, 0, 0, abi.agg_none(), 16));
    if (t.class != abi.CLASS_FP || t.piece_count != 1 || t.pieces[0].width != 16 || t.size != 12) { ret 6; }
    val tr: abi.ParamSlot = t_ret(abi.ret_query(12, 16, false, 0, false, true, 0, 0, abi.agg_none(), 16));
    if (tr.class != abi.CLASS_FP || tr.pieces[0].width != 16 || tr.size != 12) { ret 7; }

    val w: abi.ParamSlot = t_arg(abi.arg_query(0, 32, 16, false, 0, false, true, 0, 0, 0, 0, abi.agg_none(), 16));
    if (w.class != abi.CLASS_BYREF || lang_mir.preg_regid(w.reg) != gp_param_reg(0) || w.size != 8) { ret 8; }
    val ws: abi.ParamSlot = t_arg(abi.arg_query(0, 32, 16, false, 0, false, true, GP_PARAM_COUNT, 0, 0, 0, abi.agg_none(), 16));
    if (ws.class != abi.CLASS_STACK_BYREF || ws.size != 8) { ret 9; }
    val wr: abi.ParamSlot = t_ret(abi.ret_query(32, 16, false, 0, false, true, 0, 0, abi.agg_none(), 16));
    if (wr.class != abi.CLASS_SRET || lang_mir.preg_regid(wr.reg) != REG_X8) { ret 10; }
    ret 0;
}

test classify_return__scalar_and_small_aggregate {
    val v: abi.ParamSlot = t_ret(abi.ret_query(0, 0, false, 0, false, false, 0, 0, abi.agg_none(), 16));
    if (v.class != abi.CLASS_GP || !lang_mir.preg_is_nil(v.reg)) { ret 1; }
    val i: abi.ParamSlot = t_ret(abi.ret_query(8, 8, false, 0, false, false, 0, 0, abi.agg_none(), 16));
    if (lang_mir.preg_regid(i.reg) != REG_X0) { ret 1; }
    val f: abi.ParamSlot = t_ret(abi.ret_query(8, 8, true, 0, false, false, 0, 0, abi.agg_none(), 16));
    if (f.class != abi.CLASS_FP || lang_mir.preg_regid(f.reg) != fp_param_reg(0)) { ret 1; }
    val a: abi.ParamSlot = t_ret(abi.ret_query(16, 8, false, 0, true, false, 0, 0, abi.agg_none(), 16));
    if (lang_mir.preg_regid(a.pieces[0].reg) != REG_X0 || lang_mir.preg_regid(a.pieces[1].reg) != REG_X1) { ret 1; }
    ret 0;
}

test classify_return__hfa_before_sret {
    val s: abi.ParamSlot = t_ret(abi.ret_query(12, 4, false, 0, true, false, 3, 4, abi.agg_none(), 16));
    if (s.piece_count != 3)                                      { ret 1; }
    if (lang_mir.preg_regid(s.pieces[0].reg) != fp_param_reg(0)) { ret 1; }
    if (s.pieces[0].width != 4)                                  { ret 1; }
    if (lang_mir.preg_regid(s.pieces[2].reg) != fp_param_reg(2)) { ret 1; }
    val q: abi.ParamSlot = t_ret(abi.ret_query(32, 8, false, 0, true, false, 4, 8, abi.agg_none(), 16));
    if (q.piece_count != 4) { ret 1; }
    val r: abi.ParamSlot = t_ret(abi.ret_query(32, 8, false, 0, true, false, 0, 0, abi.agg_none(), 16));
    if (r.class != abi.CLASS_SRET || lang_mir.preg_regid(r.reg) != REG_X8) { ret 1; }
    ret 0;
}

test register_files__param_and_callee_saved {
    val gp: target_model.RegFile = VTABLE.gp_arg_regs;
    if (gp.count != GP_PARAM_COUNT)                         { ret 1; }
    if (gp.regs[0].id != REG_X0 || gp.regs[7].id != REG_X7) { ret 1; }
    val cs: *target_model.Register = VTABLE.callee_saved.regs;
    if (VTABLE.callee_saved.count != CALLEE_SAVED_COUNT)                { ret 1; }
    if (cs[0].id != REG_X19 || cs[9].id != REG_X28)                     { ret 1; }
    if (cs[10].id != isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 8))  { ret 1; }
    if (cs[17].id != isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 15)) { ret 1; }
    ret 0;
}
