use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;

use mach.lang.be.codegen.mir;
use mach.lang.target.abi;
use mach.lang.target.isa;

pub val REG_X0: i32 = 0;
pub val REG_X1: i32 = 1;
#[testing]
pub val REG_X7:  i32 = 7;
pub val REG_X8:  i32 = 8;
pub val REG_X19: i32 = 19;
#[testing]
pub val REG_X28: i32 = 28;

pub val GP_PARAM_COUNT:        i32 = 8;
pub val FP_PARAM_COUNT:        i32 = 8;
pub val GP_CALLEE_SAVED_COUNT: i32 = 10;
pub val FP_CALLEE_SAVED_COUNT: i32 = 8;
pub val CALLEE_SAVED_COUNT:    i32 = 18;

pub val STACK_ALIGN: u32 = 16;
pub val RED_ZONE:    u32 = 0;
pub val MAX_REG_RET: u64 = 16;

pub val WORD: u32 = 8;

# a 16-byte integer scalar: C.10 rounds NGRN up to even when its alignment is
# 16 and passes it in the next two registers, else C.11 sets NGRN to 8 and it
# goes to the stack at its natural 16-byte alignment (#3511). darwin hands the
# classifier an alignment of 8, so the pair starts in any register (#3922)
pub val DOUBLE_WORD: u64 = 16;

pub fun gp_param_reg(index: i32) i32 {
    if (index < 0)               { ret -1; }
    if (index >= GP_PARAM_COUNT) { ret -1; }
    ret index;
}

pub fun fp_param_reg(index: i32) i32 {
    if (index < 0)               { ret -1; }
    if (index >= FP_PARAM_COUNT) { ret -1; }
    ret isa.regid_make(isa.REG_CLASS_ID_XMM, index);
}

val VEC_REG_BYTES: u8 = 16;

pub fun classify_arg(index: i32, size: u64, align: u64,
    is_float: bool, fp_eightbytes: u8, is_aggregate: bool, is_vector: bool,
    gp_used: i32, fp_used: i32, hfa_members: u8, hfa_elem: u8,
    agg: abi.AggLayout) abi.ParamSlot {
    if (is_aggregate && hfa_members > 0) {
        if (fp_used + hfa_members::i32 <= FP_PARAM_COUNT) {
            ret abi.make_slot_hfa(fp_param_reg(fp_used), hfa_members, hfa_elem, size);
        }
        ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
    }

    if (is_aggregate && size > MAX_REG_RET) {
        if (gp_used < GP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_BYREF, gp_param_reg(gp_used), 0, 8, 8);
        }
        ret abi.make_slot(abi.CLASS_STACK_BYREF, -1, 0, 8, 0);
    }

    if (is_aggregate) {
        if (size <= 8) {
            if (gp_used < GP_PARAM_COUNT) {
                ret abi.make_slot(abi.CLASS_GP, gp_param_reg(gp_used), 0, size, 8);
            }
            ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
        }
        if (gp_used + 2 <= GP_PARAM_COUNT) {
            ret abi.make_slot_pair(abi.CLASS_GP, gp_param_reg(gp_used), gp_param_reg(gp_used + 1), 0, size, WORD);
        }
        ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
    }

    if (is_vector) {
        if (size <= VEC_REG_BYTES::u64) {
            if (fp_used < FP_PARAM_COUNT) {
                ret abi.make_slot_hfa(fp_param_reg(fp_used), 1, VEC_REG_BYTES, size);
            }
            ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
        }
        if (gp_used < GP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_BYREF, gp_param_reg(gp_used), 0, 8, 8);
        }
        ret abi.make_slot(abi.CLASS_STACK_BYREF, -1, 0, 8, 0);
    }

    if (is_float) {
        if (fp_used < FP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_FP, fp_param_reg(fp_used), 0, size, size::u8);
        }
        ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
    }

    if (size == DOUBLE_WORD) {
        var ngrn: i32 = gp_used;
        if (align >= DOUBLE_WORD && (ngrn & 1) != 0) { ngrn = ngrn + 1; }
        if (ngrn + 2 <= GP_PARAM_COUNT) {
            var s: abi.ParamSlot = abi.make_slot_pair(abi.CLASS_GP, gp_param_reg(ngrn), gp_param_reg(ngrn + 1), 0, size, WORD);
            s.gp_consumed = ngrn + 2 - gp_used;
            ret s;
        }
        var st: abi.ParamSlot = abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
        st.gp_consumed = GP_PARAM_COUNT - gp_used;
        ret st;
    }

    if (gp_used < GP_PARAM_COUNT) {
        ret abi.make_slot(abi.CLASS_GP, gp_param_reg(gp_used), 0, size, 8);
    }
    ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
}

pub fun classify_return(size: u64, align: u64,
    is_float: bool, fp_eightbytes: u8, is_aggregate: bool, is_vector: bool,
    hfa_members: u8, hfa_elem: u8, agg: abi.AggLayout) abi.ParamSlot {
    if (size == 0) {
        ret abi.make_slot(abi.CLASS_GP, -1, 0, 0, 0);
    }

    if (is_aggregate && hfa_members > 0) {
        ret abi.make_slot_hfa(fp_param_reg(0), hfa_members, hfa_elem, size);
    }

    if (is_aggregate && size > MAX_REG_RET) {
        ret abi.make_slot(abi.CLASS_SRET, REG_X8, 0, 8, 8);
    }

    if (is_aggregate) {
        if (size <= 8) {
            ret abi.make_slot(abi.CLASS_GP, REG_X0, 0, size, 8);
        }
        ret abi.make_slot_pair(abi.CLASS_GP, REG_X0, REG_X1, 0, size, WORD);
    }

    if (is_vector) {
        if (size <= VEC_REG_BYTES::u64) {
            ret abi.make_slot_hfa(fp_param_reg(0), 1, VEC_REG_BYTES, size);
        }
        ret abi.make_slot(abi.CLASS_SRET, REG_X8, 0, 8, 8);
    }

    if (is_float) {
        ret abi.make_slot(abi.CLASS_FP, fp_param_reg(0), 0, size, size::u8);
    }

    if (size == DOUBLE_WORD) {
        ret abi.make_slot_pair(abi.CLASS_GP, REG_X0, REG_X1, 0, size, WORD);
    }
    ret abi.make_slot(abi.CLASS_GP, REG_X0, 0, size, 8);
}

pub fun gp_param_regs(out: *isa.Register) i32 {
    var i: i32 = 0;
    for (i < GP_PARAM_COUNT) {
        out[i].id   = gp_param_reg(i);
        out[i].size = 8;
        i           = i + 1;
    }
    ret GP_PARAM_COUNT;
}

pub fun callee_saved(out: *isa.Register) i32 {
    var i: i32 = 0;
    for (i < GP_CALLEE_SAVED_COUNT) {
        out[i].id   = REG_X19 + i;
        out[i].size = 8;
        i           = i + 1;
    }
    i = 0;
    for (i < FP_CALLEE_SAVED_COUNT) {
        out[GP_CALLEE_SAVED_COUNT + i].id   = isa.regid_make(isa.REG_CLASS_ID_XMM, 8 + i);
        out[GP_CALLEE_SAVED_COUNT + i].size = 16;
        i                                   = i + 1;
    }
    ret CALLEE_SAVED_COUNT;
}

pub fun va_model() abi.VaModel {
    ret abi.va_model_make(abi.VA_MODEL_REG_SAVE, false, -1, 64);
}

pub fun register(reg: *abi.AbiRegistry) err[fail.Fail] {
    val shadow_space:                u32  = 0;
    val indirect_result_reg:         i32  = REG_X8;
    val consumes_agg_layout:         bool = false;
    val fp_callee_saved_full_vector: bool = false;
    val float_arg_bits:              u32  = 64;

    var aapcs64_vtable: abi.AbiVTable = abi.abi_vtable(
        abi.ABI_AAPCS64, abi.abi_name_for(abi.ABI_AAPCS64), isa.ARCH_AARCH64,
        classify_arg, classify_return,
        gp_param_regs, callee_saved,
        STACK_ALIGN, RED_ZONE, shadow_space,
        indirect_result_reg, false,
        consumes_agg_layout, fp_callee_saved_full_vector,
        float_arg_bits, WORD,
        va_model);

    ret abi.register(reg, ?aapcs64_vtable);
}

# the gp and fp banks count independently: a float after eight integers still gets v0
test classify_arg__scalars_and_independent_banks {
    val i: abi.ParamSlot = classify_arg(0, 8, 8, false, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (i.class != abi.CLASS_GP || mir.preg_regid(i.reg) != REG_X0) { ret 1; }
    val f: abi.ParamSlot = classify_arg(0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (f.class != abi.CLASS_FP || mir.preg_regid(f.reg) != fp_param_reg(0)) { ret 2; }
    val i7: abi.ParamSlot = classify_arg(0, 8, 8, false, 0, false, false, 7, 0, 0, 0, abi.agg_none());
    if (i7.class != abi.CLASS_GP || mir.preg_regid(i7.reg) != REG_X7) { ret 3; }
    val f0: abi.ParamSlot = classify_arg(0, 8, 8, true, 0, false, false, 7, 0, 0, 0, abi.agg_none());
    if (f0.class != abi.CLASS_FP || mir.preg_regid(f0.reg) != fp_param_reg(0)) { ret 4; }
    val s: abi.ParamSlot = classify_arg(0, 8, 8, false, 0, false, false, 8, 0, 0, 0, abi.agg_none());
    if (s.class != abi.CLASS_STACK) { ret 5; }
    ret 0;
}

test classify_arg__integer_aggregates {
    val s: abi.ParamSlot = classify_arg(0, 16, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
    if (s.class != abi.CLASS_GP || s.piece_count != 2)                                          { ret 1; }
    if (mir.preg_regid(s.pieces[0].reg) != REG_X0 || mir.preg_regid(s.pieces[1].reg) != REG_X1) { ret 1; }
    val o: abi.ParamSlot = classify_arg(0, 8, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
    if (o.class != abi.CLASS_GP || o.piece_count != 1 || mir.preg_regid(o.pieces[0].reg) != REG_X0) { ret 2; }
    val big: abi.ParamSlot = classify_arg(0, 32, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
    if (big.class != abi.CLASS_BYREF || mir.preg_regid(big.reg) != REG_X0) { ret 3; }
    val spilled: abi.ParamSlot = classify_arg(0, 32, 8, false, 0, true, false, 8, 0, 0, 0, abi.agg_none());
    if (spilled.class != abi.CLASS_STACK_BYREF) { ret 4; }
    ret 0;
}

# C.10: a 16-byte integer rounds NGRN to even and rides the next pair; C.11:
# with fewer than two registers left it exhausts them and goes to the stack.
# a 16-byte composite (C.12) does not round (#3511). at alignment 8 (darwin)
# the pair starts in the next register and C.11 still holds (#3922)
test classify_arg__int128_even_pair_or_exhausts_registers {
    val a: abi.ParamSlot = classify_arg(0, 16, 16, false, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (a.class != abi.CLASS_GP || a.piece_count != 2 || a.gp_consumed != 2)   { ret 1; }
    if (mir.preg_regid(a.pieces[0].reg) != REG_X0 || a.pieces[0].src_off != 0) { ret 2; }
    if (mir.preg_regid(a.pieces[1].reg) != REG_X1 || a.pieces[1].src_off != 8) { ret 3; }
    val b: abi.ParamSlot = classify_arg(1, 16, 16, false, 0, false, false, 1, 0, 0, 0, abi.agg_none());
    if (b.class != abi.CLASS_GP || b.gp_consumed != 3)                                { ret 4; }
    if (mir.preg_regid(b.pieces[0].reg) != 2 || mir.preg_regid(b.pieces[1].reg) != 3) { ret 5; }
    val c: abi.ParamSlot = classify_arg(6, 16, 16, false, 0, false, false, 6, 0, 0, 0, abi.agg_none());
    if (c.class != abi.CLASS_GP || c.gp_consumed != 2)                                { ret 6; }
    if (mir.preg_regid(c.pieces[0].reg) != 6 || mir.preg_regid(c.pieces[1].reg) != 7) { ret 7; }
    val d: abi.ParamSlot = classify_arg(7, 16, 16, false, 0, false, false, 7, 0, 0, 0, abi.agg_none());
    if (d.class != abi.CLASS_STACK || d.size != 16 || d.gp_consumed != 1) { ret 8; }
    val e: abi.ParamSlot = classify_arg(8, 16, 16, false, 0, false, false, 8, 0, 0, 0, abi.agg_none());
    if (e.class != abi.CLASS_STACK || e.gp_consumed != 0) { ret 9; }
    val g: abi.ParamSlot = classify_arg(1, 16, 8, false, 0, true, false, 1, 0, 0, 0, abi.agg_none());
    if (g.class != abi.CLASS_GP || mir.preg_regid(g.pieces[0].reg) != 1 || g.gp_consumed != 2) { ret 10; }
    val u: abi.ParamSlot = classify_arg(1, 16, 8, false, 0, false, false, 1, 0, 0, 0, abi.agg_none());
    if (u.class != abi.CLASS_GP || u.gp_consumed != 2)                                { ret 14; }
    if (mir.preg_regid(u.pieces[0].reg) != 1 || mir.preg_regid(u.pieces[1].reg) != 2) { ret 15; }
    val v: abi.ParamSlot = classify_arg(7, 16, 8, false, 0, false, false, 7, 0, 0, 0, abi.agg_none());
    if (v.class != abi.CLASS_STACK || v.gp_consumed != 1) { ret 16; }
    val r: abi.ParamSlot = classify_return(16, 16, false, 0, false, false, 0, 0, abi.agg_none());
    if (r.class != abi.CLASS_GP || r.piece_count != 2)                         { ret 11; }
    if (mir.preg_regid(r.pieces[0].reg) != REG_X0 || r.pieces[0].src_off != 0) { ret 12; }
    if (mir.preg_regid(r.pieces[1].reg) != REG_X1 || r.pieces[1].src_off != 8) { ret 13; }
    ret 0;
}

test classify_arg__hfa {
    val s: abi.ParamSlot = classify_arg(0, 8, 4, false, 0, true, false, 0, 0, 2, 4, abi.agg_none());
    if (s.piece_count != 2)                                 { ret 1; }
    if (mir.preg_regid(s.pieces[0].reg) != fp_param_reg(0)) { ret 1; }
    if (s.pieces[0].width != 4)                             { ret 1; }
    if (mir.preg_regid(s.pieces[1].reg) != fp_param_reg(1)) { ret 1; }
    if (s.size != 8)                                        { ret 1; }
    val q: abi.ParamSlot = classify_arg(0, 32, 8, false, 0, true, false, 0, 0, 4, 8, abi.agg_none());
    if (q.piece_count != 4)                                 { ret 1; }
    if (mir.preg_regid(q.pieces[0].reg) != fp_param_reg(0)) { ret 1; }
    if (q.pieces[0].width != 8)                             { ret 1; }
    if (mir.preg_regid(q.pieces[3].reg) != fp_param_reg(3)) { ret 1; }
    val a: abi.ParamSlot = classify_arg(0, 8, 4, false, 0, true, false, 0, 5, 2, 4, abi.agg_none());
    if (mir.preg_regid(a.pieces[0].reg) != fp_param_reg(5)) { ret 1; }
    val m: abi.ParamSlot = classify_arg(0, 12, 4, false, 0, true, false, 0, 6, 3, 4, abi.agg_none());
    if (m.class != abi.CLASS_STACK) { ret 1; }
    ret 0;
}

# a short vector rides one whole v register whatever its size, up to 16 bytes;
# a wider one goes by reference and returns through x8
test classify__short_vectors {
    val v: abi.ParamSlot = classify_arg(0, 16, 16, false, 0, false, true, 0, 0, 0, 0, abi.agg_none());
    if (v.class != abi.CLASS_FP || mir.preg_regid(v.reg) != fp_param_reg(0)) { ret 1; }
    if (v.piece_count != 1 || v.pieces[0].width != 16)                       { ret 1; }
    val v3: abi.ParamSlot = classify_arg(1, 16, 16, false, 0, false, true, 0, 3, 0, 0, abi.agg_none());
    if (mir.preg_regid(v3.reg) != fp_param_reg(3)) { ret 2; }
    val vs: abi.ParamSlot = classify_arg(2, 16, 16, false, 0, false, true, 0, 8, 0, 0, abi.agg_none());
    if (vs.class != abi.CLASS_STACK) { ret 3; }
    val r: abi.ParamSlot = classify_return(16, 16, false, 0, false, true, 0, 0, abi.agg_none());
    if (r.class != abi.CLASS_FP || mir.preg_regid(r.reg) != fp_param_reg(0) || r.pieces[0].width != 16) { ret 4; }

    val d: abi.ParamSlot = classify_arg(0, 8, 8, false, 0, false, true, 0, 0, 0, 0, abi.agg_none());
    if (d.class != abi.CLASS_FP || mir.preg_regid(d.reg) != fp_param_reg(0)) { ret 5; }
    if (d.piece_count != 1 || d.pieces[0].width != 16 || d.size != 8)        { ret 5; }
    val t: abi.ParamSlot = classify_arg(0, 12, 16, false, 0, false, true, 0, 0, 0, 0, abi.agg_none());
    if (t.class != abi.CLASS_FP || t.piece_count != 1 || t.pieces[0].width != 16 || t.size != 12) { ret 6; }
    val tr: abi.ParamSlot = classify_return(12, 16, false, 0, false, true, 0, 0, abi.agg_none());
    if (tr.class != abi.CLASS_FP || tr.pieces[0].width != 16 || tr.size != 12) { ret 7; }

    val w: abi.ParamSlot = classify_arg(0, 32, 16, false, 0, false, true, 0, 0, 0, 0, abi.agg_none());
    if (w.class != abi.CLASS_BYREF || mir.preg_regid(w.reg) != gp_param_reg(0) || w.size != 8) { ret 8; }
    val ws: abi.ParamSlot = classify_arg(0, 32, 16, false, 0, false, true, GP_PARAM_COUNT, 0, 0, 0, abi.agg_none());
    if (ws.class != abi.CLASS_STACK_BYREF || ws.size != 8) { ret 9; }
    val wr: abi.ParamSlot = classify_return(32, 16, false, 0, false, true, 0, 0, abi.agg_none());
    if (wr.class != abi.CLASS_SRET || mir.preg_regid(wr.reg) != REG_X8) { ret 10; }
    ret 0;
}

test classify_return__scalar_and_small_aggregate {
    val v: abi.ParamSlot = classify_return(0, 0, false, 0, false, false, 0, 0, abi.agg_none());
    if (v.class != abi.CLASS_GP || !mir.preg_is_nil(v.reg)) { ret 1; }
    val i: abi.ParamSlot = classify_return(8, 8, false, 0, false, false, 0, 0, abi.agg_none());
    if (mir.preg_regid(i.reg) != REG_X0) { ret 1; }
    val f: abi.ParamSlot = classify_return(8, 8, true, 0, false, false, 0, 0, abi.agg_none());
    if (f.class != abi.CLASS_FP || mir.preg_regid(f.reg) != fp_param_reg(0)) { ret 1; }
    val a: abi.ParamSlot = classify_return(16, 8, false, 0, true, false, 0, 0, abi.agg_none());
    if (mir.preg_regid(a.pieces[0].reg) != REG_X0 || mir.preg_regid(a.pieces[1].reg) != REG_X1) { ret 1; }
    ret 0;
}

test classify_return__hfa_before_sret {
    val s: abi.ParamSlot = classify_return(12, 4, false, 0, true, false, 3, 4, abi.agg_none());
    if (s.piece_count != 3)                                 { ret 1; }
    if (mir.preg_regid(s.pieces[0].reg) != fp_param_reg(0)) { ret 1; }
    if (s.pieces[0].width != 4)                             { ret 1; }
    if (mir.preg_regid(s.pieces[2].reg) != fp_param_reg(2)) { ret 1; }
    val q: abi.ParamSlot = classify_return(32, 8, false, 0, true, false, 4, 8, abi.agg_none());
    if (q.piece_count != 4) { ret 1; }
    val r: abi.ParamSlot = classify_return(32, 8, false, 0, true, false, 0, 0, abi.agg_none());
    if (r.class != abi.CLASS_SRET || mir.preg_regid(r.reg) != REG_X8) { ret 1; }
    ret 0;
}

test register_files__param_and_callee_saved {
    var gp: [8]isa.Register;
    if (gp_param_regs(?gp[0]) != GP_PARAM_COUNT)  { ret 1; }
    if (gp[0].id != REG_X0 || gp[7].id != REG_X7) { ret 1; }
    var cs: [18]isa.Register;
    if (callee_saved(?cs[0]) != CALLEE_SAVED_COUNT)            { ret 1; }
    if (cs[0].id != REG_X19 || cs[9].id != REG_X28)            { ret 1; }
    if (cs[10].id != isa.regid_make(isa.REG_CLASS_ID_XMM, 8))  { ret 1; }
    if (cs[17].id != isa.regid_make(isa.REG_CLASS_ID_XMM, 15)) { ret 1; }
    ret 0;
}
