use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

use lang_mir: mach.lang.mir;
use mach.lang.target.abi;
use catalog_abi:  mach.lang.target.catalog.abi;
use catalog_arch: mach.lang.target.catalog.arch;
use mach.lang.target.isa;
use isa_inst:     mach.lang.target.isa.inst;
use target_model: mach.lang.target.model;

val REG_RAX: i32 = isa_inst.REG_GP_BASE | 0;
val REG_RCX: i32 = isa_inst.REG_GP_BASE | 1;
val REG_RDX: i32 = isa_inst.REG_GP_BASE | 2;
val REG_RBX: i32 = isa_inst.REG_GP_BASE | 3;
val REG_RBP: i32 = isa_inst.REG_GP_BASE | 5;
val REG_RSI: i32 = isa_inst.REG_GP_BASE | 6;
val REG_RDI: i32 = isa_inst.REG_GP_BASE | 7;
val REG_R8:  i32 = isa_inst.REG_GP_BASE | 8;
val REG_R9:  i32 = isa_inst.REG_GP_BASE | 9;
val REG_R12: i32 = isa_inst.REG_GP_BASE | 12;
val REG_R13: i32 = isa_inst.REG_GP_BASE | 13;
val REG_R14: i32 = isa_inst.REG_GP_BASE | 14;
val REG_R15: i32 = isa_inst.REG_GP_BASE | 15;

val REG_XMM0: i32 = isa_inst.REG_FP_BASE | 0;
val REG_XMM1: i32 = isa_inst.REG_FP_BASE | 1;

val GP_PARAM_COUNT:      i32 = 6;
val VEC_REG_BYTES:       u64 = 16;
val FP_PARAM_COUNT:      i32 = 8;
val VA_VECTOR_COUNT_REG: i32 = REG_RAX;
val CALLEE_SAVED_COUNT:  i32 = 6;

val STACK_ALIGN: u32 = 16;
val RED_ZONE:    u32 = 128;
val MAX_REG_RET: u64 = 16;

val EIGHTBYTE: u32 = 8;

# a 128-bit integer: two eightbytes
val DOUBLE_WORD: u64 = 16;

fun gp_param_reg(index: i32) i32 {
    if (index == 0) { ret REG_RDI; }
    if (index == 1) { ret REG_RSI; }
    if (index == 2) { ret REG_RDX; }
    if (index == 3) { ret REG_RCX; }
    if (index == 4) { ret REG_R8; }
    if (index == 5) { ret REG_R9; }
    ret isa_inst.REG_NONE;
}

fun fp_param_reg(index: i32) i32 {
    if (index < 0)               { ret isa_inst.REG_NONE; }
    if (index >= FP_PARAM_COUNT) { ret isa_inst.REG_NONE; }
    ret isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, index);
}

# a vector one vector register carries (SSE, then SSEUP for the rest of the
# register): any vector the 16-byte xmm register holds, and a C vector type
# (`__m256`, `__m512`) of the width the target's register reaches under its
# selected extensions, `vec_bytes`: 32 once avx widens xmm to ymm. a
# size no C vector type has keeps mach's own placement past 16 bytes
fun vector_in_register(size: u64, vec_bytes: u64) bool {
    if (size <= VEC_REG_BYTES) { ret true; }
    ret c_vector_size(size) && size <= vec_bytes;
}

# the transport width of a vector in its register: the xmm register, or the
# wider register a C vector type of that size fills
fun vector_register_width(size: u64) u8 {
    if (size > VEC_REG_BYTES) { ret size::u8; }
    ret VEC_REG_BYTES::u8;
}

# a size C's vector types take: a power of two, as `vector_size` requires
fun c_vector_size(size: u64) bool {
    ret size != 0 && (size & (size - 1)) == 0;
}

# the eightbyte classes of a small aggregate, the mask a classifier reads:
# bit 0 and bit 1 mark eightbyte 0 and 1 as SSE, bit 2 and bit 3 mark them as
# holding no leaf at all (padding only), and an unmarked eightbyte inside the
# object is INTEGER; bit 4 marks an aggregate holding a field at an offset that
# is not a multiple of the field's own alignment (a packed record), which is
# MEMORY regardless of what its eightbytes hold
pub val EB_SSE_LO:    u8 = 1;
pub val EB_SSE_HI:    u8 = 2;
pub val EB_EMPTY_LO:  u8 = 4;
pub val EB_EMPTY_HI:  u8 = 8;
pub val EB_UNALIGNED: u8 = 16;

val EB_NO_CLASS: u8 = 0;
val EB_SSE:      u8 = 1;
val EB_INTEGER:  u8 = 2;

fun mark_eightbyte_range(classes: *u8, off: u64, size: u64, cls: u8) {
    if (size == 0) { ret; }
    var i:    u64 = off / 8;
    val last: u64 = (off + size - 1) / 8;
    for (i <= last) {
        if (i < 2 && cls > classes[i]) { classes[i] = cls; }
        i = i + 1;
    }
}

# merges the class of every scalar the aggregate holds into the eightbytes it covers. members are never
# collected into a bounded list first: a tag's unit cases are zero-width members and its payloads overlap, so
# the member count of a 16-byte aggregate has no bound, and a member dropped past any cap is a dropped class
fun mark_eightbytes(vt: *abi.AbiVTable, view: *abi.TypeView, ty: u32, base_off: u64, classes: *u8) {
    val f: abi.TypeFacts = abi.type_facts(view, ty);
    if (f.shape == abi.SHAPE_NONE) { ret; }
    if (f.shape == abi.SHAPE_RECORD || f.shape == abi.SHAPE_UNION) {
        var i: u32 = 0;
        for (i < f.count) {
            val m: abi.TypeMember = abi.type_member(view, ty, i);
            mark_eightbytes(vt, view, m.ty, base_off + m.offset, classes);
            i = i + 1;
        }
        ret;
    }
    if (f.shape == abi.SHAPE_ARRAY) {
        val elem: abi.TypeMember = abi.type_member(view, ty, 0);
        if (abi.type_facts(view, elem.ty).size == 0) { ret; }
        var i: u32 = 0;
        for (i < f.count) {
            mark_eightbytes(vt, view, elem.ty, base_off + abi.type_member(view, ty, i).offset, classes);
            i = i + 1;
        }
        ret;
    }
    if (f.shape == abi.SHAPE_TAG) {
        mark_eightbyte_range(classes, base_off, f.disc_bytes, EB_INTEGER);
        var i: u32 = 0;
        for (i < f.count) {
            val m: abi.TypeMember = abi.type_member(view, ty, i);
            mark_eightbytes(vt, view, m.ty, base_off + m.offset, classes);
            i = i + 1;
        }
        ret;
    }
    var cls: u8 = EB_INTEGER;
    if (abi.shape_is_float(vt, f.shape)) { cls = EB_SSE; }
    mark_eightbyte_range(classes, base_off, f.size, cls);
}

# the unaligned-field rule: a member whose offset is not a multiple of its own type's alignment makes the
# whole aggregate MEMORY class. every record member is checked against its type's alignment at every nesting
# level and every array element is visited at its own offset, so a packed element whose fields sit aligned in
# element 0 and unaligned in element 1 is caught, exactly as clang walks it
fun has_unaligned_field(view: *abi.TypeView, ty: u32, base_off: u64) bool {
    val f: abi.TypeFacts = abi.type_facts(view, ty);
    if (f.shape == abi.SHAPE_RECORD || f.shape == abi.SHAPE_UNION) {
        var i: u32 = 0;
        for (i < f.count) {
            val m:   abi.TypeMember = abi.type_member(view, ty, i);
            val fal: u64            = abi.type_facts(view, m.ty).align;
            if (fal != 0 && (base_off + m.offset) % fal != 0)         { ret true; }
            if (has_unaligned_field(view, m.ty, base_off + m.offset)) { ret true; }
            i = i + 1;
        }
        ret false;
    }
    if (f.shape == abi.SHAPE_ARRAY) {
        var i: u32 = 0;
        for (i < f.count) {
            val m: abi.TypeMember = abi.type_member(view, ty, i);
            if (has_unaligned_field(view, m.ty, base_off + m.offset)) { ret true; }
            i = i + 1;
        }
    }
    if (f.shape == abi.SHAPE_TAG) {
        # a tag is the record of its layout: the discriminator at offset 0 against its own width, then every
        # case payload at the common payload offset against that case's alignment
        if (f.disc_bytes != 0 && base_off % f.disc_bytes != 0) { ret true; }
        var i: u32 = 0;
        for (i < f.count) {
            val m:   abi.TypeMember = abi.type_member(view, ty, i);
            val po:  u64            = base_off + m.offset;
            val cal: u64            = abi.type_facts(view, m.ty).align;
            if (cal != 0 && po % cal != 0)           { ret true; }
            if (has_unaligned_field(view, m.ty, po)) { ret true; }
            i = i + 1;
        }
    }
    ret false;
}

# the eightbyte mask of `ty`, 0 for a type that is no aggregate of one or two eightbytes
pub fun eightbyte_mask(vt: *abi.AbiVTable, view: *abi.TypeView, ty: u32) u8 {
    val f: abi.TypeFacts = abi.type_facts(view, ty);
    if (f.shape != abi.SHAPE_RECORD && f.shape != abi.SHAPE_ARRAY && f.shape != abi.SHAPE_UNION && f.shape != abi.SHAPE_TAG) { ret 0; }
    if (f.size == 0 || f.size > 16)                                                                                          { ret 0; }
    if (has_unaligned_field(view, ty, 0))                                                                                    { ret EB_UNALIGNED; }
    var classes: [2]u8;
    classes[0] = EB_NO_CLASS;
    classes[1] = EB_NO_CLASS;
    mark_eightbytes(vt, view, ty, 0, ?classes[0]);
    var mask: u8 = 0;
    if (classes[0] == EB_SSE)                    { mask = mask | EB_SSE_LO; }
    if (classes[1] == EB_SSE)                    { mask = mask | EB_SSE_HI; }
    if (classes[0] == EB_NO_CLASS)               { mask = mask | EB_EMPTY_LO; }
    if (f.size > 8 && classes[1] == EB_NO_CLASS) { mask = mask | EB_EMPTY_HI; }
    ret mask;
}

fun classify_arg(vt: *abi.AbiVTable, q: *abi.ArgQuery) abi.ParamSlot {
    var eightbytes: u8 = 0;
    if (abi.arg_members_read(q)) { eightbytes = eightbyte_mask(vt, q.types, q.ty); }
    # an empty record has no eightbyte to classify, so it takes no register and
    # no stack, as GCC and clang pass one in C
    if (q.is_aggregate && q.size == 0) {
        ret abi.make_slot(abi.CLASS_GP, isa_inst.REG_NONE, 0, 0, 0);
    }

    if (q.is_aggregate && memory_class(q.size, eightbytes)) {
        ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
    }

    if (q.is_aggregate) {
        val eb0_sse: bool = (eightbytes & EB_SSE_LO) != 0;
        if (q.size <= 8) {
            if (eb0_sse) {
                if (q.fp_used < FP_PARAM_COUNT) {
                    ret abi.make_slot(abi.CLASS_GP, fp_param_reg(q.fp_used), 0, q.size, 8);
                }
                ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
            }
            if (q.gp_used < GP_PARAM_COUNT) {
                ret abi.make_slot(abi.CLASS_GP, gp_param_reg(q.gp_used), 0, q.size, 8);
            }
            ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
        }

        val eb1_sse:  bool = (eightbytes & EB_SSE_HI) != 0;
        val eb0_used: bool = (eightbytes & EB_EMPTY_LO) == 0;
        val eb1_used: bool = (eightbytes & EB_EMPTY_HI) == 0;
        var gp_need:  i32  = 0;
        var fp_need:  i32  = 0;
        if (eb0_used) {
            if (eb0_sse) { fp_need = fp_need + 1; }
            or           { gp_need = gp_need + 1; }
        }
        if (eb1_used) {
            if (eb1_sse) { fp_need = fp_need + 1; }
            or           { gp_need = gp_need + 1; }
        }
        if (!eb0_used && !eb1_used) { gp_need = 1; }

        if (q.gp_used + gp_need <= GP_PARAM_COUNT && q.fp_used + fp_need <= FP_PARAM_COUNT) {
            var gi: i32 = q.gp_used;
            var fi: i32 = q.fp_used;
            var r0: i32 = isa_inst.REG_NONE;
            var r1: i32 = isa_inst.REG_NONE;
            if (eb0_used || !eb1_used) {
                if (eb0_sse) {
                    r0 = fp_param_reg(fi);
                    fi = fi + 1;
                }
                or {
                    r0 = gp_param_reg(gi);
                    gi = gi + 1;
                }
            }
            if (eb1_used) {
                if (eb1_sse) {
                    r1 = fp_param_reg(fi);
                    fi = fi + 1;
                }
                or {
                    r1 = gp_param_reg(gi);
                    gi = gi + 1;
                }
            }
            ret eightbyte_slot(r0, r1, q.size);
        }
        ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
    }

    if (q.is_vector && !vector_in_register(q.size, q.vec_bytes)) {
        # a C vector type wider than the vector registers is MEMORY class: its
        # bytes on the stack at its C alignment, its size (psABI 3.2.3)
        if (c_vector_size(q.size)) {
            var s: abi.ParamSlot = abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
            s.stack_align = q.size::u32;
            ret s;
        }
        # a size no C vector type has keeps mach's own placement: a pointer to
        # a copy
        if (q.gp_used < GP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_BYREF, gp_param_reg(q.gp_used), 0, 8, 8);
        }
        ret abi.make_slot(abi.CLASS_STACK_BYREF, isa_inst.REG_NONE, 0, 8, 0);
    }

    if (q.is_vector) {
        if (q.fp_used < FP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_FP, fp_param_reg(q.fp_used), 0, q.size, vector_register_width(q.size));
        }
        # out of registers, a vector goes on the stack at its C alignment
        var s: abi.ParamSlot = abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
        if (q.size > VEC_REG_BYTES) { s.stack_align = q.size::u32; }
        ret s;
    }

    if (abi.arg_is_float(vt, q)) {
        if (q.fp_used < FP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_FP, fp_param_reg(q.fp_used), 0, q.size, q.size::u8);
        }
        ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
    }

    # 3.2.3: `__int128` is classified as if it were `struct { long low, high; }`,
    # two INTEGER eightbytes, the low half in the lower register; when fewer than
    # two registers remain the whole value goes on the stack, at its 16-byte
    # alignment, and is never split between a register and the stack
    if (q.size == DOUBLE_WORD) {
        if (q.gp_used + 2 <= GP_PARAM_COUNT) {
            ret abi.make_slot_pair(abi.CLASS_GP, gp_param_reg(q.gp_used), gp_param_reg(q.gp_used + 1), 0, q.size, EIGHTBYTE);
        }
        ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
    }

    if (q.gp_used < GP_PARAM_COUNT) {
        ret abi.make_slot(abi.CLASS_GP, gp_param_reg(q.gp_used), 0, q.size, 8);
    }
    ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
}

fun classify_return(vt: *abi.AbiVTable, q: *abi.RetQuery) abi.ParamSlot {
    val eightbytes: u8 = eightbyte_mask(vt, q.types, q.ty);
    if (q.size == 0) {
        ret abi.make_slot(abi.CLASS_GP, isa_inst.REG_NONE, 0, 0, 0);
    }

    if (q.is_aggregate && memory_class(q.size, eightbytes)) {
        ret abi.make_slot(abi.CLASS_SRET, REG_RAX, 0, 8, 8);
    }

    if (q.is_aggregate) {
        val eb0_sse: bool = (eightbytes & EB_SSE_LO) != 0;
        if (q.size <= 8) {
            if (eb0_sse) { ret abi.make_slot(abi.CLASS_GP, REG_XMM0, 0, q.size, 8); }
            ret abi.make_slot(abi.CLASS_GP, REG_RAX, 0, q.size, 8);
        }

        val eb1_sse:  bool = (eightbytes & EB_SSE_HI) != 0;
        val eb0_used: bool = (eightbytes & EB_EMPTY_LO) == 0;
        val eb1_used: bool = (eightbytes & EB_EMPTY_HI) == 0;
        var ni:       i32  = 0;
        var ns:       i32  = 0;
        var r0:       i32  = isa_inst.REG_NONE;
        var r1:       i32  = isa_inst.REG_NONE;
        if (eb0_used || !eb1_used) {
            if (eb0_sse) {
                r0 = ret_sse_reg(ns);
                ns = ns + 1;
            }
            or {
                r0 = ret_int_reg(ni);
                ni = ni + 1;
            }
        }
        if (eb1_used) {
            if (eb1_sse) {
                r1 = ret_sse_reg(ns);
                ns = ns + 1;
            }
            or {
                r1 = ret_int_reg(ni);
                ni = ni + 1;
            }
        }
        ret eightbyte_slot(r0, r1, q.size);
    }

    if (q.is_vector && !vector_in_register(q.size, q.vec_bytes)) {
        ret abi.make_slot(abi.CLASS_SRET, REG_RAX, 0, 8, 8);
    }

    if (q.is_vector) {
        ret abi.make_slot(abi.CLASS_FP, REG_XMM0, 0, q.size, vector_register_width(q.size));
    }

    if (abi.ret_is_float(vt, q)) {
        ret abi.make_slot(abi.CLASS_FP, REG_XMM0, 0, q.size, q.size::u8);
    }

    # a 128-bit integer returns in rax:rdx, low half in rax (3.2.3)
    if (q.size == DOUBLE_WORD) {
        ret abi.make_slot_pair(abi.CLASS_GP, REG_RAX, REG_RDX, 0, q.size, EIGHTBYTE);
    }

    ret abi.make_slot(abi.CLASS_GP, REG_RAX, 0, q.size, 8);
}

# 3.2.3 rule 1: an aggregate larger than two eightbytes, or one holding an unaligned field, is MEMORY class
fun memory_class(size: u64, fp_eightbytes: u8) bool {
    if (size > MAX_REG_RET) { ret true; }
    ret (fp_eightbytes & EB_UNALIGNED) != 0;
}

# one piece per classified eightbyte; a padding-only eightbyte (REG_NONE) is delivered by nobody
fun eightbyte_slot(r0: i32, r1: i32, size: u64) abi.ParamSlot {
    if (r0 != isa_inst.REG_NONE && r1 != isa_inst.REG_NONE) { ret abi.make_slot_pair(abi.CLASS_GP, r0, r1, 0, size, EIGHTBYTE); }
    if (r0 != isa_inst.REG_NONE)                            { ret abi.make_slot(abi.CLASS_GP, r0, 0, size, EIGHTBYTE::u8); }
    var piece: abi.ParamPiece = abi.make_piece(abi.PIECE_GP, r1, EIGHTBYTE::i64, 0, EIGHTBYTE::u8);
    if (isa_inst.regid_class(r1) == isa_inst.REG_CLASS_ID_FP) { piece.kind = abi.PIECE_FP; }
    ret abi.make_slot_pieces(abi.CLASS_GP, ?piece, 1, size);
}

fun ret_int_reg(index: i32) i32 {
    if (index == 0) { ret REG_RAX; }
    ret REG_RDX;
}

fun ret_sse_reg(index: i32) i32 {
    if (index == 0) { ret REG_XMM0; }
    ret REG_XMM1;
}

val GP_ARGS: [6]target_model.Register = [6]target_model.Register{
    target_model.Register{id: REG_RDI, size: 8},
    target_model.Register{id: REG_RSI, size: 8},
    target_model.Register{id: REG_RDX, size: 8},
    target_model.Register{id: REG_RCX, size: 8},
    target_model.Register{id: REG_R8, size: 8},
    target_model.Register{id: REG_R9, size: 8},
};

val CALLEE_SAVED: [6]target_model.Register = [6]target_model.Register{
    target_model.Register{id: REG_RBX, size: 8},
    target_model.Register{id: REG_RBP, size: 8},
    target_model.Register{id: REG_R12, size: 8},
    target_model.Register{id: REG_R13, size: 8},
    target_model.Register{id: REG_R14, size: 8},
    target_model.Register{id: REG_R15, size: 8},
};

val VA_MODEL: abi.VaModel = abi.VaModel{kind: abi.VA_MODEL_REG_SAVE, float_dup_gp: false, vector_count_reg: VA_VECTOR_COUNT_REG, variadic_float_bits: 64};

pub val VTABLE: abi.AbiVTable = abi.AbiVTable{
    passing:                    catalog_abi.PASSING_CARRIERS,
    id:                         catalog_abi.SYSV,
    name:                       "sysv64",
    arch_id:                    catalog_arch.X86_64,
    arg_passing:                classify_arg,
    ret_passing:                classify_return,
    gp_arg_regs:                target_model.RegFile{regs: ?GP_ARGS[0], count: GP_PARAM_COUNT},
    callee_saved:               target_model.RegFile{regs: ?CALLEE_SAVED[0], count: CALLEE_SAVED_COUNT},
    stack_align:                STACK_ALIGN,
    red_zone:                   RED_ZONE,
    indirect_result_reg:        REG_RDI,
    indirect_result_in_argfile: true,
    fp_callee_saved_bytes:      16,
    float_arg_bits:             64,
    arg_slot_granularity:       EIGHTBYTE,
    va_model:                   ?VA_MODEL,
    # clang's callees read an 8- or 16-bit argument as the 32-bit register, a
    # rule of x86-64 System V in practice that GCC's callers honour too
    reg_arg_extend: 32,
    # GCC and clang pass `_Float16` as SSE class: the low 16 bits of an xmm
    # register, and a float member of an eightbyte
    half: abi.HALF_FLOAT,
};

# fp_eightbytes marks each sse eightbyte of a small aggregate; the rest ride gp
#[testing]
fun t_arg(q: abi.ArgQuery) abi.ParamSlot {
    var arg: abi.ArgQuery = q;
    ret classify_arg(?VTABLE, ?arg);
}

#[testing]
fun t_ret(q: abi.RetQuery) abi.ParamSlot {
    var result: abi.RetQuery = q;
    ret classify_return(?VTABLE, ?result);
}

test classify_arg__aggregate_eightbyte_classes {
    val ff: abi.ParamSlot = t_arg(abi.arg_query(0, 16, 8, false, 3, true, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (ff.class != abi.CLASS_GP || ff.piece_count != 2)          { ret 1; }
    if (lang_mir.preg_regid(ff.pieces[0].reg) != fp_param_reg(0)) { ret 1; }
    if (lang_mir.preg_regid(ff.pieces[1].reg) != fp_param_reg(1)) { ret 1; }
    val f: abi.ParamSlot = t_arg(abi.arg_query(0, 8, 4, false, 1, true, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (f.piece_count != 1 || lang_mir.preg_regid(f.pieces[0].reg) != fp_param_reg(0)) { ret 2; }
    val is: abi.ParamSlot = t_arg(abi.arg_query(0, 16, 8, false, 2, true, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (lang_mir.preg_regid(is.pieces[0].reg) != REG_RDI)         { ret 3; }
    if (lang_mir.preg_regid(is.pieces[1].reg) != fp_param_reg(0)) { ret 3; }
    val si: abi.ParamSlot = t_arg(abi.arg_query(0, 16, 8, false, 1, true, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (lang_mir.preg_regid(si.pieces[0].reg) != fp_param_reg(0)) { ret 4; }
    if (lang_mir.preg_regid(si.pieces[1].reg) != REG_RDI)         { ret 4; }
    val ii: abi.ParamSlot = t_arg(abi.arg_query(0, 16, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (lang_mir.preg_regid(ii.pieces[0].reg) != REG_RDI) { ret 5; }
    if (lang_mir.preg_regid(ii.pieces[1].reg) != REG_RSI) { ret 5; }
    # one sse register left for two sse eightbytes: the whole value spills
    val spilled: abi.ParamSlot = t_arg(abi.arg_query(0, 16, 8, false, 3, true, false, 0, 7, 0, 0, abi.agg_none(), 16));
    if (spilled.class != abi.CLASS_STACK || spilled.size != 16) { ret 6; }
    ret 0;
}

test classify_return__aggregate_eightbyte_classes {
    val ff: abi.ParamSlot = t_ret(abi.ret_query(16, 8, false, 3, true, false, 0, 0, abi.agg_none(), 16));
    if (lang_mir.preg_regid(ff.pieces[0].reg) != REG_XMM0) { ret 1; }
    if (lang_mir.preg_regid(ff.pieces[1].reg) != REG_XMM1) { ret 1; }
    val f: abi.ParamSlot = t_ret(abi.ret_query(8, 4, false, 1, true, false, 0, 0, abi.agg_none(), 16));
    if (f.piece_count != 1 || lang_mir.preg_regid(f.pieces[0].reg) != REG_XMM0) { ret 2; }
    val ii: abi.ParamSlot = t_ret(abi.ret_query(16, 8, false, 0, true, false, 0, 0, abi.agg_none(), 16));
    if (lang_mir.preg_regid(ii.pieces[0].reg) != REG_RAX || lang_mir.preg_regid(ii.pieces[1].reg) != REG_RDX) { ret 3; }
    val is: abi.ParamSlot = t_ret(abi.ret_query(16, 8, false, 2, true, false, 0, 0, abi.agg_none(), 16));
    if (lang_mir.preg_regid(is.pieces[0].reg) != REG_RAX || lang_mir.preg_regid(is.pieces[1].reg) != REG_XMM0) { ret 4; }
    ret 0;
}

test classify_arg__scalars {
    val f: abi.ParamSlot = t_arg(abi.arg_query(0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (f.class != abi.CLASS_FP)                       { ret 1; }
    if (lang_mir.preg_regid(f.reg) != fp_param_reg(0)) { ret 1; }
    val i: abi.ParamSlot = t_arg(abi.arg_query(0, 8, 8, false, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (i.class != abi.CLASS_GP)               { ret 1; }
    if (lang_mir.preg_regid(i.reg) != REG_RDI) { ret 1; }
    ret 0;
}

# a 128-bit integer takes two INTEGER eightbytes, low half in the lower
# register, and goes whole to the stack when fewer than two registers remain
# (psABI 3.2.3); it returns in rax:rdx
test classify_arg__int128_pair_or_whole_stack {
    val a: abi.ParamSlot = t_arg(abi.arg_query(0, 16, 16, false, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (a.class != abi.CLASS_GP || a.piece_count != 2)                               { ret 1; }
    if (lang_mir.preg_regid(a.pieces[0].reg) != REG_RDI || a.pieces[0].src_off != 0) { ret 2; }
    if (lang_mir.preg_regid(a.pieces[1].reg) != REG_RSI || a.pieces[1].src_off != 8) { ret 3; }
    if (a.pieces[0].width != 8 || a.pieces[1].width != 8)                            { ret 4; }
    val b: abi.ParamSlot = t_arg(abi.arg_query(4, 16, 16, false, 0, false, false, 4, 0, 0, 0, abi.agg_none(), 16));
    if (lang_mir.preg_regid(b.pieces[0].reg) != REG_R8 || lang_mir.preg_regid(b.pieces[1].reg) != REG_R9) { ret 5; }
    # one register left: never split, the whole value goes to the stack
    val c: abi.ParamSlot = t_arg(abi.arg_query(5, 16, 16, false, 0, false, false, 5, 0, 0, 0, abi.agg_none(), 16));
    if (c.class != abi.CLASS_STACK || c.size != 16) { ret 6; }
    val d: abi.ParamSlot = t_arg(abi.arg_query(6, 16, 16, false, 0, false, false, 6, 0, 0, 0, abi.agg_none(), 16));
    if (d.class != abi.CLASS_STACK || d.size != 16) { ret 7; }
    val r: abi.ParamSlot = t_ret(abi.ret_query(16, 16, false, 0, false, false, 0, 0, abi.agg_none(), 16));
    if (r.class != abi.CLASS_GP || r.piece_count != 2)                               { ret 8; }
    if (lang_mir.preg_regid(r.pieces[0].reg) != REG_RAX || r.pieces[0].src_off != 0) { ret 9; }
    if (lang_mir.preg_regid(r.pieces[1].reg) != REG_RDX || r.pieces[1].src_off != 8) { ret 10; }
    ret 0;
}

# an empty record rides no register and no stack, and takes none from either
# bank
test classify_arg__empty_record_takes_nothing {
    val e: abi.ParamSlot = t_arg(abi.arg_query(1, 0, 1, false, 0, true, false, 1, 0, 0, 0, abi.agg_none(), 16));
    if (e.class != abi.CLASS_GP || e.piece_count != 0) { ret 1; }
    if (e.gp_consumed != 0 || e.fp_consumed != 0)      { ret 2; }
    val f: abi.ParamSlot = t_arg(abi.arg_query(7, 0, 1, false, 0, true, false, 6, 8, 0, 0, abi.agg_none(), 16));
    if (f.class != abi.CLASS_GP || f.piece_count != 0) { ret 3; }
    ret 0;
}

test classify_arg__large_aggregate_is_memory_class {
    val s0: abi.ParamSlot = t_arg(abi.arg_query(0, 32, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (s0.class != abi.CLASS_STACK)   { ret 1; }
    if (!lang_mir.preg_is_nil(s0.reg)) { ret 1; }
    if (s0.size != 32)                 { ret 1; }

    val s1: abi.ParamSlot = t_arg(abi.arg_query(0, 32, 8, false, 0, true, false, 5, 0, 0, 0, abi.agg_none(), 16));
    if (s1.class != abi.CLASS_STACK)   { ret 1; }
    if (!lang_mir.preg_is_nil(s1.reg)) { ret 1; }
    if (s1.size != 32)                 { ret 1; }

    val s2: abi.ParamSlot = t_arg(abi.arg_query(0, 17, 8, false, 0, true, false, 6, 0, 0, 0, abi.agg_none(), 16));
    if (s2.class != abi.CLASS_STACK)   { ret 1; }
    if (!lang_mir.preg_is_nil(s2.reg)) { ret 1; }
    if (s2.size != 17)                 { ret 1; }
    ret 0;
}

test classify_arg__padding_only_eightbyte {
    val s: abi.ParamSlot = t_arg(abi.arg_query(0, 16, 16, false, EB_EMPTY_HI, true, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (s.class != abi.CLASS_GP || s.piece_count != 1)                                                         { ret 1; }
    if (lang_mir.preg_regid(s.pieces[0].reg) != REG_RDI || s.pieces[0].width != 8 || s.pieces[0].src_off != 0) { ret 2; }
    if (s.size != 16)                                                                                          { ret 3; }
    val next: abi.ParamSlot = t_arg(abi.arg_query(1, 8, 8, false, 0, false, false, 1, 0, 0, 0, abi.agg_none(), 16));
    if (lang_mir.preg_regid(next.reg) != REG_RSI) { ret 4; }
    val lo: abi.ParamSlot = t_arg(abi.arg_query(0, 16, 16, false, EB_EMPTY_LO, true, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (lo.class != abi.CLASS_GP || lo.piece_count != 1)                                                          { ret 5; }
    if (lang_mir.preg_regid(lo.pieces[0].reg) != REG_RDI || lo.pieces[0].src_off != 8 || lo.pieces[0].width != 8) { ret 6; }
    val sse_hi: abi.ParamSlot = t_arg(abi.arg_query(0, 16, 16, false, EB_EMPTY_LO | EB_SSE_HI, true, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (sse_hi.piece_count != 1 || sse_hi.pieces[0].kind != abi.PIECE_FP || lang_mir.preg_regid(sse_hi.pieces[0].reg) != fp_param_reg(0)) { ret 7; }
    val spilled: abi.ParamSlot = t_arg(abi.arg_query(0, 16, 16, false, EB_EMPTY_HI, true, false, 6, 0, 0, 0, abi.agg_none(), 16));
    if (spilled.class != abi.CLASS_STACK) { ret 8; }
    val fits: abi.ParamSlot = t_arg(abi.arg_query(0, 16, 16, false, EB_EMPTY_HI, true, false, 5, 0, 0, 0, abi.agg_none(), 16));
    if (fits.class != abi.CLASS_GP || lang_mir.preg_regid(fits.pieces[0].reg) != REG_R9) { ret 9; }
    ret 0;
}

test classify_return__padding_only_eightbyte {
    val s: abi.ParamSlot = t_ret(abi.ret_query(16, 16, false, EB_EMPTY_HI, true, false, 0, 0, abi.agg_none(), 16));
    if (s.class != abi.CLASS_GP || s.piece_count != 1 || lang_mir.preg_regid(s.pieces[0].reg) != REG_RAX || s.size != 16) { ret 1; }
    val full: abi.ParamSlot = t_ret(abi.ret_query(16, 8, false, 0, true, false, 0, 0, abi.agg_none(), 16));
    if (full.piece_count != 2 || lang_mir.preg_regid(full.pieces[1].reg) != REG_RDX) { ret 2; }
    val hi: abi.ParamSlot = t_ret(abi.ret_query(16, 16, false, EB_EMPTY_LO, true, false, 0, 0, abi.agg_none(), 16));
    if (hi.piece_count != 1 || lang_mir.preg_regid(hi.pieces[0].reg) != REG_RAX || hi.pieces[0].src_off != 8) { ret 3; }
    ret 0;
}

test classify_arg__unaligned_field {
    val s: abi.ParamSlot = t_arg(abi.arg_query(0, 5, 1, false, EB_UNALIGNED, true, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (s.class != abi.CLASS_STACK || !lang_mir.preg_is_nil(s.reg) || s.size != 5) { ret 1; }
    val two: abi.ParamSlot = t_arg(abi.arg_query(0, 9, 1, false, EB_UNALIGNED, true, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (two.class != abi.CLASS_STACK || two.size != 9) { ret 2; }
    val sse: abi.ParamSlot = t_arg(abi.arg_query(0, 16, 1, false, EB_UNALIGNED | EB_SSE_LO | EB_SSE_HI, true, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (sse.class != abi.CLASS_STACK) { ret 3; }
    val aligned: abi.ParamSlot = t_arg(abi.arg_query(0, 12, 1, false, 0, true, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (aligned.class != abi.CLASS_GP || aligned.piece_count != 2)                                                      { ret 4; }
    if (lang_mir.preg_regid(aligned.pieces[0].reg) != REG_RDI || lang_mir.preg_regid(aligned.pieces[1].reg) != REG_RSI) { ret 5; }
    val next: abi.ParamSlot = t_arg(abi.arg_query(1, 8, 8, false, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (lang_mir.preg_regid(next.reg) != REG_RDI) { ret 6; }
    ret 0;
}

test classify_return__unaligned_field {
    val s: abi.ParamSlot = t_ret(abi.ret_query(5, 1, false, EB_UNALIGNED, true, false, 0, 0, abi.agg_none(), 16));
    if (s.class != abi.CLASS_SRET || lang_mir.preg_regid(s.reg) != REG_RAX) { ret 1; }
    val two: abi.ParamSlot = t_ret(abi.ret_query(9, 1, false, EB_UNALIGNED, true, false, 0, 0, abi.agg_none(), 16));
    if (two.class != abi.CLASS_SRET) { ret 2; }
    val aligned: abi.ParamSlot = t_ret(abi.ret_query(12, 1, false, 0, true, false, 0, 0, abi.agg_none(), 16));
    if (aligned.class != abi.CLASS_GP || aligned.piece_count != 2 || lang_mir.preg_regid(aligned.pieces[1].reg) != REG_RDX) { ret 3; }
    ret 0;
}

# a C vector type as wide as the target's register rides one register: under
# avx a 32-byte vector is SSE/SSEUP in ymm, argument and result alike, and
# out of registers goes on the stack at its size. without avx, and past the
# register under it, it is MEMORY; a size no C vector type has stays mach's
# pointer to a copy
test classify__vector_width_follows_the_register {
    val y: abi.ParamSlot = t_arg(abi.arg_query(0, 32, 32, false, 0, false, true, 0, 1, 0, 0, abi.agg_none(), 32));
    if (y.class != abi.CLASS_FP || lang_mir.preg_regid(y.reg) != fp_param_reg(1) || y.pieces[0].width != 32) { ret 1; }
    if (y.fp_consumed != 1)                                                                                  { ret 2; }
    val full: abi.ParamSlot = t_arg(abi.arg_query(0, 32, 32, false, 0, false, true, 0, 8, 0, 0, abi.agg_none(), 32));
    if (full.class != abi.CLASS_STACK || full.stack_align != 32) { ret 3; }
    val sse: abi.ParamSlot = t_arg(abi.arg_query(0, 32, 32, false, 0, false, true, 0, 0, 0, 0, abi.agg_none(), 16));
    if (sse.class != abi.CLASS_STACK || sse.stack_align != 32) { ret 4; }
    val zmm: abi.ParamSlot = t_arg(abi.arg_query(0, 64, 64, false, 0, false, true, 0, 0, 0, 0, abi.agg_none(), 32));
    if (zmm.class != abi.CLASS_STACK || zmm.stack_align != 64) { ret 5; }
    val odd: abi.ParamSlot = t_arg(abi.arg_query(0, 20, 16, false, 0, false, true, 0, 0, 0, 0, abi.agg_none(), 32));
    if (odd.class != abi.CLASS_BYREF) { ret 6; }
    val x: abi.ParamSlot = t_arg(abi.arg_query(0, 16, 16, false, 0, false, true, 0, 0, 0, 0, abi.agg_none(), 32));
    if (x.class != abi.CLASS_FP || x.pieces[0].width != 16) { ret 7; }
    val r: abi.ParamSlot = t_ret(abi.ret_query(32, 32, false, 0, false, true, 0, 0, abi.agg_none(), 32));
    if (r.class != abi.CLASS_FP || lang_mir.preg_regid(r.reg) != REG_XMM0 || r.pieces[0].width != 32) { ret 8; }
    val m: abi.ParamSlot = t_ret(abi.ret_query(32, 32, false, 0, false, true, 0, 0, abi.agg_none(), 16));
    if (m.class != abi.CLASS_SRET) { ret 9; }
    ret 0;
}
