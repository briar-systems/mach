use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;

use mach.lang.be.codegen.mir;
use mach.lang.target.abi;
use mach.lang.target.isa;

pub val REG_RAX: i32 = 0;
pub val REG_RCX: i32 = 1;
pub val REG_RDX: i32 = 2;
pub val REG_RBX: i32 = 3;
pub val REG_RBP: i32 = 5;
pub val REG_RSI: i32 = 6;
pub val REG_RDI: i32 = 7;
pub val REG_R8:  i32 = 8;
pub val REG_R9:  i32 = 9;
pub val REG_R12: i32 = 12;
pub val REG_R13: i32 = 13;
pub val REG_R14: i32 = 14;
pub val REG_R15: i32 = 15;

pub val REG_XMM0: i32 = (1 << 8) | 0;
pub val REG_XMM1: i32 = (1 << 8) | 1;

pub val GP_PARAM_COUNT:      i32 = 6;
pub val VEC_REG_BYTES:       u64 = 16;
pub val FP_PARAM_COUNT:      i32 = 8;
pub val VA_VECTOR_COUNT_REG: i32 = REG_RAX;
pub val CALLEE_SAVED_COUNT:  i32 = 6;

pub val STACK_ALIGN: u32 = 16;
pub val RED_ZONE:    u32 = 128;
pub val MAX_REG_RET: u64 = 16;

pub val EIGHTBYTE: u32 = 8;

# a 128-bit integer: two eightbytes
pub val DOUBLE_WORD: u64 = 16;

pub fun gp_param_reg(index: i32) i32 {
    if (index == 0) { ret REG_RDI; }
    if (index == 1) { ret REG_RSI; }
    if (index == 2) { ret REG_RDX; }
    if (index == 3) { ret REG_RCX; }
    if (index == 4) { ret REG_R8; }
    if (index == 5) { ret REG_R9; }
    ret -1;
}

pub fun fp_param_reg(index: i32) i32 {
    if (index < 0)               { ret -1; }
    if (index >= FP_PARAM_COUNT) { ret -1; }
    ret isa.regid_make(isa.REG_CLASS_ID_XMM, index);
}

pub fun classify_arg(index: i32, size: u64, align: u64,
    is_float: bool, fp_eightbytes: u8, is_aggregate: bool, is_vector: bool,
    gp_used: i32, fp_used: i32, hfa_members: u8, hfa_elem: u8,
    agg: abi.AggLayout) abi.ParamSlot {
    # an empty record has no eightbyte to classify, so it takes no register and
    # no stack, as GCC and clang pass one in C (#3949)
    if (is_aggregate && size == 0) {
        ret abi.make_slot(abi.CLASS_GP, -1, 0, 0, 0);
    }

    if (is_aggregate && memory_class(size, fp_eightbytes)) {
        ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
    }

    if (is_aggregate) {
        val eb0_sse: bool = (fp_eightbytes & abi.EB_SSE_LO) != 0;
        if (size <= 8) {
            if (eb0_sse) {
                if (fp_used < FP_PARAM_COUNT) {
                    ret abi.make_slot(abi.CLASS_GP, fp_param_reg(fp_used), 0, size, 8);
                }
                ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
            }
            if (gp_used < GP_PARAM_COUNT) {
                ret abi.make_slot(abi.CLASS_GP, gp_param_reg(gp_used), 0, size, 8);
            }
            ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
        }

        val eb1_sse:  bool = (fp_eightbytes & abi.EB_SSE_HI) != 0;
        val eb0_used: bool = (fp_eightbytes & abi.EB_EMPTY_LO) == 0;
        val eb1_used: bool = (fp_eightbytes & abi.EB_EMPTY_HI) == 0;
        var gp_need:  i32  = 0;
        var fp_need:  i32  = 0;
        if (eb0_used) {
            if (eb0_sse) { fp_need = fp_need + 1; }
            or           { gp_need = gp_need + 1; }
        }
        if (eb1_used) {
            if (eb1_sse) { fp_need = fp_need + 1; }
            or           { gp_need = gp_need + 1; }
        }
        if (!eb0_used && !eb1_used) { gp_need = 1; }

        if (gp_used + gp_need <= GP_PARAM_COUNT && fp_used + fp_need <= FP_PARAM_COUNT) {
            var gi: i32 = gp_used;
            var fi: i32 = fp_used;
            var r0: i32 = -1;
            var r1: i32 = -1;
            if (eb0_used || !eb1_used) {
                if (eb0_sse) {
                    r0 = fp_param_reg(fi);
                    fi = fi + 1;
                }
                or {
                    r0 = gp_param_reg(gi);
                    gi = gi + 1;
                }
            }
            if (eb1_used) {
                if (eb1_sse) {
                    r1 = fp_param_reg(fi);
                    fi = fi + 1;
                }
                or {
                    r1 = gp_param_reg(gi);
                    gi = gi + 1;
                }
            }
            ret eightbyte_slot(r0, r1, size);
        }
        ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
    }

    if (is_vector && size > VEC_REG_BYTES) {
        if (gp_used < GP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_BYREF, gp_param_reg(gp_used), 0, 8, 8);
        }
        ret abi.make_slot(abi.CLASS_STACK_BYREF, -1, 0, 8, 0);
    }

    if (is_vector) {
        if (fp_used < FP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_FP, fp_param_reg(fp_used), 0, size, VEC_REG_BYTES::u8);
        }
        ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
    }

    if (is_float) {
        if (fp_used < FP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_FP, fp_param_reg(fp_used), 0, size, size::u8);
        }
        ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
    }

    # 3.2.3: `__int128` is classified as if it were `struct { long low, high; }`,
    # two INTEGER eightbytes, the low half in the lower register; when fewer than
    # two registers remain the whole value goes on the stack, at its 16-byte
    # alignment, and is never split between a register and the stack
    if (size == DOUBLE_WORD) {
        if (gp_used + 2 <= GP_PARAM_COUNT) {
            ret abi.make_slot_pair(abi.CLASS_GP, gp_param_reg(gp_used), gp_param_reg(gp_used + 1), 0, size, EIGHTBYTE);
        }
        ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
    }

    if (gp_used < GP_PARAM_COUNT) {
        ret abi.make_slot(abi.CLASS_GP, gp_param_reg(gp_used), 0, size, 8);
    }
    ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
}

pub fun classify_return(size: u64, align: u64,
    is_float: bool, fp_eightbytes: u8, is_aggregate: bool, is_vector: bool,
    hfa_members: u8, hfa_elem: u8, agg: abi.AggLayout) abi.ParamSlot {
    if (size == 0) {
        ret abi.make_slot(abi.CLASS_GP, -1, 0, 0, 0);
    }

    if (is_aggregate && memory_class(size, fp_eightbytes)) {
        ret abi.make_slot(abi.CLASS_SRET, REG_RAX, 0, 8, 8);
    }

    if (is_aggregate) {
        val eb0_sse: bool = (fp_eightbytes & abi.EB_SSE_LO) != 0;
        if (size <= 8) {
            if (eb0_sse) { ret abi.make_slot(abi.CLASS_GP, REG_XMM0, 0, size, 8); }
            ret abi.make_slot(abi.CLASS_GP, REG_RAX, 0, size, 8);
        }

        val eb1_sse:  bool = (fp_eightbytes & abi.EB_SSE_HI) != 0;
        val eb0_used: bool = (fp_eightbytes & abi.EB_EMPTY_LO) == 0;
        val eb1_used: bool = (fp_eightbytes & abi.EB_EMPTY_HI) == 0;
        var ni:       i32  = 0;
        var ns:       i32  = 0;
        var r0:       i32  = -1;
        var r1:       i32  = -1;
        if (eb0_used || !eb1_used) {
            if (eb0_sse) {
                r0 = ret_sse_reg(ns);
                ns = ns + 1;
            }
            or {
                r0 = ret_int_reg(ni);
                ni = ni + 1;
            }
        }
        if (eb1_used) {
            if (eb1_sse) {
                r1 = ret_sse_reg(ns);
                ns = ns + 1;
            }
            or {
                r1 = ret_int_reg(ni);
                ni = ni + 1;
            }
        }
        ret eightbyte_slot(r0, r1, size);
    }

    if (is_vector && size > VEC_REG_BYTES) {
        ret abi.make_slot(abi.CLASS_SRET, REG_RAX, 0, 8, 8);
    }

    if (is_vector) {
        ret abi.make_slot(abi.CLASS_FP, REG_XMM0, 0, size, VEC_REG_BYTES::u8);
    }

    if (is_float) {
        ret abi.make_slot(abi.CLASS_FP, REG_XMM0, 0, size, size::u8);
    }

    # a 128-bit integer returns in rax:rdx, low half in rax (3.2.3)
    if (size == DOUBLE_WORD) {
        ret abi.make_slot_pair(abi.CLASS_GP, REG_RAX, REG_RDX, 0, size, EIGHTBYTE);
    }

    ret abi.make_slot(abi.CLASS_GP, REG_RAX, 0, size, 8);
}

# 3.2.3 rule 1: an aggregate larger than two eightbytes, or one holding an unaligned field, is MEMORY class
fun memory_class(size: u64, fp_eightbytes: u8) bool {
    if (size > MAX_REG_RET) { ret true; }
    ret (fp_eightbytes & abi.EB_UNALIGNED) != 0;
}

# one piece per classified eightbyte; a padding-only eightbyte (register -1) is delivered by nobody
fun eightbyte_slot(r0: i32, r1: i32, size: u64) abi.ParamSlot {
    if (r0 >= 0 && r1 >= 0) { ret abi.make_slot_pair(abi.CLASS_GP, r0, r1, 0, size, EIGHTBYTE); }
    if (r0 >= 0)            { ret abi.make_slot(abi.CLASS_GP, r0, 0, size, EIGHTBYTE::u8); }
    var piece: abi.ParamPiece = abi.make_piece(abi.PIECE_GP, r1, EIGHTBYTE::i64, 0, EIGHTBYTE::u8);
    if (isa.regid_class(r1) == isa.REG_CLASS_ID_XMM) { piece.kind = abi.PIECE_FP; }
    ret abi.make_slot_pieces(abi.CLASS_GP, ?piece, 1, size);
}

fun ret_int_reg(index: i32) i32 {
    if (index == 0) { ret REG_RAX; }
    ret REG_RDX;
}

fun ret_sse_reg(index: i32) i32 {
    if (index == 0) { ret REG_XMM0; }
    ret REG_XMM1;
}

pub fun gp_param_regs(out: *isa.Register) i32 {
    var i: i32 = 0;
    for (i < GP_PARAM_COUNT) {
        out[i].id   = gp_param_reg(i);
        out[i].size = 8;
        i           = i + 1;
    }
    ret GP_PARAM_COUNT;
}

pub fun callee_saved(out: *isa.Register) i32 {
    out[0].id   = REG_RBX;
    out[0].size = 8;
    out[1].id   = REG_RBP;
    out[1].size = 8;
    out[2].id   = REG_R12;
    out[2].size = 8;
    out[3].id   = REG_R13;
    out[3].size = 8;
    out[4].id   = REG_R14;
    out[4].size = 8;
    out[5].id   = REG_R15;
    out[5].size = 8;
    ret CALLEE_SAVED_COUNT;
}

pub fun va_model() abi.VaModel {
    ret abi.va_model_make(abi.VA_MODEL_REG_SAVE, false, VA_VECTOR_COUNT_REG, 64);
}

pub fun register(reg: *abi.AbiRegistry) err[fail.Fail] {
    val shadow_space:                u32  = 0;
    val indirect_result_reg:         i32  = gp_param_reg(0);
    val consumes_agg_layout:         bool = false;
    val fp_callee_saved_full_vector: bool = true;
    val float_arg_bits:              u32  = 64;

    var sysv_vtable: abi.AbiVTable = abi.abi_vtable(
        abi.ABI_SYSV, abi.abi_name_for(abi.ABI_SYSV), isa.ARCH_X86_64,
        classify_arg, classify_return,
        gp_param_regs, callee_saved,
        STACK_ALIGN, RED_ZONE, shadow_space,
        indirect_result_reg, true,
        consumes_agg_layout, fp_callee_saved_full_vector,
        float_arg_bits, EIGHTBYTE,
        va_model);

    ret abi.register(reg, ?sysv_vtable);
}

# fp_eightbytes marks each sse eightbyte of a small aggregate; the rest ride gp
test classify_arg__aggregate_eightbyte_classes {
    val ff: abi.ParamSlot = classify_arg(0, 16, 8, false, 3, true, false, 0, 0, 0, 0, abi.agg_none());
    if (ff.class != abi.CLASS_GP || ff.piece_count != 2)     { ret 1; }
    if (mir.preg_regid(ff.pieces[0].reg) != fp_param_reg(0)) { ret 1; }
    if (mir.preg_regid(ff.pieces[1].reg) != fp_param_reg(1)) { ret 1; }
    val f: abi.ParamSlot = classify_arg(0, 8, 4, false, 1, true, false, 0, 0, 0, 0, abi.agg_none());
    if (f.piece_count != 1 || mir.preg_regid(f.pieces[0].reg) != fp_param_reg(0)) { ret 2; }
    val is: abi.ParamSlot = classify_arg(0, 16, 8, false, 2, true, false, 0, 0, 0, 0, abi.agg_none());
    if (mir.preg_regid(is.pieces[0].reg) != REG_RDI)         { ret 3; }
    if (mir.preg_regid(is.pieces[1].reg) != fp_param_reg(0)) { ret 3; }
    val si: abi.ParamSlot = classify_arg(0, 16, 8, false, 1, true, false, 0, 0, 0, 0, abi.agg_none());
    if (mir.preg_regid(si.pieces[0].reg) != fp_param_reg(0)) { ret 4; }
    if (mir.preg_regid(si.pieces[1].reg) != REG_RDI)         { ret 4; }
    val ii: abi.ParamSlot = classify_arg(0, 16, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
    if (mir.preg_regid(ii.pieces[0].reg) != REG_RDI) { ret 5; }
    if (mir.preg_regid(ii.pieces[1].reg) != REG_RSI) { ret 5; }
    # one sse register left for two sse eightbytes: the whole value spills
    val spilled: abi.ParamSlot = classify_arg(0, 16, 8, false, 3, true, false, 0, 7, 0, 0, abi.agg_none());
    if (spilled.class != abi.CLASS_STACK || spilled.size != 16) { ret 6; }
    ret 0;
}

test classify_return__aggregate_eightbyte_classes {
    val ff: abi.ParamSlot = classify_return(16, 8, false, 3, true, false, 0, 0, abi.agg_none());
    if (mir.preg_regid(ff.pieces[0].reg) != REG_XMM0) { ret 1; }
    if (mir.preg_regid(ff.pieces[1].reg) != REG_XMM1) { ret 1; }
    val f: abi.ParamSlot = classify_return(8, 4, false, 1, true, false, 0, 0, abi.agg_none());
    if (f.piece_count != 1 || mir.preg_regid(f.pieces[0].reg) != REG_XMM0) { ret 2; }
    val ii: abi.ParamSlot = classify_return(16, 8, false, 0, true, false, 0, 0, abi.agg_none());
    if (mir.preg_regid(ii.pieces[0].reg) != REG_RAX || mir.preg_regid(ii.pieces[1].reg) != REG_RDX) { ret 3; }
    val is: abi.ParamSlot = classify_return(16, 8, false, 2, true, false, 0, 0, abi.agg_none());
    if (mir.preg_regid(is.pieces[0].reg) != REG_RAX || mir.preg_regid(is.pieces[1].reg) != REG_XMM0) { ret 4; }
    ret 0;
}

test classify_arg__scalars {
    val f: abi.ParamSlot = classify_arg(0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (f.class != abi.CLASS_FP)                  { ret 1; }
    if (mir.preg_regid(f.reg) != fp_param_reg(0)) { ret 1; }
    val i: abi.ParamSlot = classify_arg(0, 8, 8, false, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (i.class != abi.CLASS_GP)          { ret 1; }
    if (mir.preg_regid(i.reg) != REG_RDI) { ret 1; }
    ret 0;
}

# a 128-bit integer takes two INTEGER eightbytes, low half in the lower
# register, and goes whole to the stack when fewer than two registers remain
# (psABI 3.2.3); it returns in rax:rdx
test classify_arg__int128_pair_or_whole_stack {
    val a: abi.ParamSlot = classify_arg(0, 16, 16, false, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (a.class != abi.CLASS_GP || a.piece_count != 2)                          { ret 1; }
    if (mir.preg_regid(a.pieces[0].reg) != REG_RDI || a.pieces[0].src_off != 0) { ret 2; }
    if (mir.preg_regid(a.pieces[1].reg) != REG_RSI || a.pieces[1].src_off != 8) { ret 3; }
    if (a.pieces[0].width != 8 || a.pieces[1].width != 8)                       { ret 4; }
    val b: abi.ParamSlot = classify_arg(4, 16, 16, false, 0, false, false, 4, 0, 0, 0, abi.agg_none());
    if (mir.preg_regid(b.pieces[0].reg) != REG_R8 || mir.preg_regid(b.pieces[1].reg) != REG_R9) { ret 5; }
    # one register left: never split, the whole value goes to the stack
    val c: abi.ParamSlot = classify_arg(5, 16, 16, false, 0, false, false, 5, 0, 0, 0, abi.agg_none());
    if (c.class != abi.CLASS_STACK || c.size != 16) { ret 6; }
    val d: abi.ParamSlot = classify_arg(6, 16, 16, false, 0, false, false, 6, 0, 0, 0, abi.agg_none());
    if (d.class != abi.CLASS_STACK || d.size != 16) { ret 7; }
    val r: abi.ParamSlot = classify_return(16, 16, false, 0, false, false, 0, 0, abi.agg_none());
    if (r.class != abi.CLASS_GP || r.piece_count != 2)                          { ret 8; }
    if (mir.preg_regid(r.pieces[0].reg) != REG_RAX || r.pieces[0].src_off != 0) { ret 9; }
    if (mir.preg_regid(r.pieces[1].reg) != REG_RDX || r.pieces[1].src_off != 8) { ret 10; }
    ret 0;
}

# an empty record rides no register and no stack, and takes none from either
# bank (#3949)
test classify_arg__empty_record_takes_nothing {
    val e: abi.ParamSlot = classify_arg(1, 0, 1, false, 0, true, false, 1, 0, 0, 0, abi.agg_none());
    if (e.class != abi.CLASS_GP || e.piece_count != 0) { ret 1; }
    if (e.gp_consumed != 0 || e.fp_consumed != 0)      { ret 2; }
    val f: abi.ParamSlot = classify_arg(7, 0, 1, false, 0, true, false, 6, 8, 0, 0, abi.agg_none());
    if (f.class != abi.CLASS_GP || f.piece_count != 0) { ret 3; }
    ret 0;
}

test classify_arg__large_aggregate_is_memory_class {
    val s0: abi.ParamSlot = classify_arg(0, 32, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
    if (s0.class != abi.CLASS_STACK) { ret 1; }
    if (!mir.preg_is_nil(s0.reg))    { ret 1; }
    if (s0.size != 32)               { ret 1; }

    val s1: abi.ParamSlot = classify_arg(0, 32, 8, false, 0, true, false, 5, 0, 0, 0, abi.agg_none());
    if (s1.class != abi.CLASS_STACK) { ret 1; }
    if (!mir.preg_is_nil(s1.reg))    { ret 1; }
    if (s1.size != 32)               { ret 1; }

    val s2: abi.ParamSlot = classify_arg(0, 17, 8, false, 0, true, false, 6, 0, 0, 0, abi.agg_none());
    if (s2.class != abi.CLASS_STACK) { ret 1; }
    if (!mir.preg_is_nil(s2.reg))    { ret 1; }
    if (s2.size != 17)               { ret 1; }
    ret 0;
}

test classify_arg__padding_only_eightbyte {
    val s: abi.ParamSlot = classify_arg(0, 16, 16, false, abi.EB_EMPTY_HI, true, false, 0, 0, 0, 0, abi.agg_none());
    if (s.class != abi.CLASS_GP || s.piece_count != 1)                                                    { ret 1; }
    if (mir.preg_regid(s.pieces[0].reg) != REG_RDI || s.pieces[0].width != 8 || s.pieces[0].src_off != 0) { ret 2; }
    if (s.size != 16)                                                                                     { ret 3; }
    val next: abi.ParamSlot = classify_arg(1, 8, 8, false, 0, false, false, 1, 0, 0, 0, abi.agg_none());
    if (mir.preg_regid(next.reg) != REG_RSI) { ret 4; }
    val lo: abi.ParamSlot = classify_arg(0, 16, 16, false, abi.EB_EMPTY_LO, true, false, 0, 0, 0, 0, abi.agg_none());
    if (lo.class != abi.CLASS_GP || lo.piece_count != 1)                                                     { ret 5; }
    if (mir.preg_regid(lo.pieces[0].reg) != REG_RDI || lo.pieces[0].src_off != 8 || lo.pieces[0].width != 8) { ret 6; }
    val sse_hi: abi.ParamSlot = classify_arg(0, 16, 16, false, abi.EB_EMPTY_LO | abi.EB_SSE_HI, true, false, 0, 0, 0, 0, abi.agg_none());
    if (sse_hi.piece_count != 1 || sse_hi.pieces[0].kind != abi.PIECE_FP || mir.preg_regid(sse_hi.pieces[0].reg) != fp_param_reg(0)) { ret 7; }
    val spilled: abi.ParamSlot = classify_arg(0, 16, 16, false, abi.EB_EMPTY_HI, true, false, 6, 0, 0, 0, abi.agg_none());
    if (spilled.class != abi.CLASS_STACK) { ret 8; }
    val fits: abi.ParamSlot = classify_arg(0, 16, 16, false, abi.EB_EMPTY_HI, true, false, 5, 0, 0, 0, abi.agg_none());
    if (fits.class != abi.CLASS_GP || mir.preg_regid(fits.pieces[0].reg) != REG_R9) { ret 9; }
    ret 0;
}

test classify_return__padding_only_eightbyte {
    val s: abi.ParamSlot = classify_return(16, 16, false, abi.EB_EMPTY_HI, true, false, 0, 0, abi.agg_none());
    if (s.class != abi.CLASS_GP || s.piece_count != 1 || mir.preg_regid(s.pieces[0].reg) != REG_RAX || s.size != 16) { ret 1; }
    val full: abi.ParamSlot = classify_return(16, 8, false, 0, true, false, 0, 0, abi.agg_none());
    if (full.piece_count != 2 || mir.preg_regid(full.pieces[1].reg) != REG_RDX) { ret 2; }
    val hi: abi.ParamSlot = classify_return(16, 16, false, abi.EB_EMPTY_LO, true, false, 0, 0, abi.agg_none());
    if (hi.piece_count != 1 || mir.preg_regid(hi.pieces[0].reg) != REG_RAX || hi.pieces[0].src_off != 8) { ret 3; }
    ret 0;
}

test classify_arg__unaligned_field {
    val s: abi.ParamSlot = classify_arg(0, 5, 1, false, abi.EB_UNALIGNED, true, false, 0, 0, 0, 0, abi.agg_none());
    if (s.class != abi.CLASS_STACK || !mir.preg_is_nil(s.reg) || s.size != 5) { ret 1; }
    val two: abi.ParamSlot = classify_arg(0, 9, 1, false, abi.EB_UNALIGNED, true, false, 0, 0, 0, 0, abi.agg_none());
    if (two.class != abi.CLASS_STACK || two.size != 9) { ret 2; }
    val sse: abi.ParamSlot = classify_arg(0, 16, 1, false, abi.EB_UNALIGNED | abi.EB_SSE_LO | abi.EB_SSE_HI, true, false, 0, 0, 0, 0, abi.agg_none());
    if (sse.class != abi.CLASS_STACK) { ret 3; }
    val aligned: abi.ParamSlot = classify_arg(0, 12, 1, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
    if (aligned.class != abi.CLASS_GP || aligned.piece_count != 2)                                            { ret 4; }
    if (mir.preg_regid(aligned.pieces[0].reg) != REG_RDI || mir.preg_regid(aligned.pieces[1].reg) != REG_RSI) { ret 5; }
    val next: abi.ParamSlot = classify_arg(1, 8, 8, false, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (mir.preg_regid(next.reg) != REG_RDI) { ret 6; }
    ret 0;
}

test classify_return__unaligned_field {
    val s: abi.ParamSlot = classify_return(5, 1, false, abi.EB_UNALIGNED, true, false, 0, 0, abi.agg_none());
    if (s.class != abi.CLASS_SRET || mir.preg_regid(s.reg) != REG_RAX) { ret 1; }
    val two: abi.ParamSlot = classify_return(9, 1, false, abi.EB_UNALIGNED, true, false, 0, 0, abi.agg_none());
    if (two.class != abi.CLASS_SRET) { ret 2; }
    val aligned: abi.ParamSlot = classify_return(12, 1, false, 0, true, false, 0, 0, abi.agg_none());
    if (aligned.class != abi.CLASS_GP || aligned.piece_count != 2 || mir.preg_regid(aligned.pieces[1].reg) != REG_RDX) { ret 3; }
    ret 0;
}
