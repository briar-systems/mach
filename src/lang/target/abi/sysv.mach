use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use O: std.types.option;
use R: std.types.result;

use mach.lang.target.abi;
use mach.lang.target.isa;

pub val REG_RAX: i32 = 0;
pub val REG_RCX: i32 = 1;
pub val REG_RDX: i32 = 2;
pub val REG_RBX: i32 = 3;
pub val REG_RSP: i32 = 4;
pub val REG_RBP: i32 = 5;
pub val REG_RSI: i32 = 6;
pub val REG_RDI: i32 = 7;
pub val REG_R8:  i32 = 8;
pub val REG_R9:  i32 = 9;
pub val REG_R10: i32 = 10;
pub val REG_R11: i32 = 11;
pub val REG_R12: i32 = 12;
pub val REG_R13: i32 = 13;
pub val REG_R14: i32 = 14;
pub val REG_R15: i32 = 15;

pub val REG_XMM0: i32 = (1 << 8) | 0;
pub val REG_XMM1: i32 = (1 << 8) | 1;

pub val GP_PARAM_COUNT:      i32 = 6;
pub val VEC_REG_BYTES:       u64 = 16;
pub val FP_PARAM_COUNT:      i32 = 8;
pub val VA_VECTOR_COUNT_REG: i32 = REG_RAX;
pub val CALLEE_SAVED_COUNT:  i32 = 6;

pub val STACK_ALIGN: u32 = 16;
pub val RED_ZONE:    u32 = 128;
pub val MAX_REG_RET: u64 = 16;

pub val EIGHTBYTE: u32 = 8;

pub fun gp_param_reg(index: i32) i32 {
    if (index == 0) { ret REG_RDI; }
    if (index == 1) { ret REG_RSI; }
    if (index == 2) { ret REG_RDX; }
    if (index == 3) { ret REG_RCX; }
    if (index == 4) { ret REG_R8; }
    if (index == 5) { ret REG_R9; }
    ret -1;
}

pub fun fp_param_reg(index: i32) i32 {
    if (index < 0)               { ret -1; }
    if (index >= FP_PARAM_COUNT) { ret -1; }
    ret isa.regid_make(isa.REG_CLASS_ID_XMM, index);
}

pub fun classify(size: u64, align: u64, is_float: bool, fp_eightbytes: u8,
                 is_aggregate: bool, gp_used: i32, fp_used: i32,
                 hfa_members: u8, hfa_elem: u8) abi.ParamSlot {
    ret classify_arg(0, size, align, is_float, fp_eightbytes, is_aggregate, false,
                     gp_used, fp_used, hfa_members, hfa_elem, abi.agg_none());
}

pub fun classify_arg(index: i32, size: u64, align: u64,
                     is_float: bool, fp_eightbytes: u8, is_aggregate: bool, is_vector: bool,
                     gp_used: i32, fp_used: i32, hfa_members: u8, hfa_elem: u8,
                     agg: abi.AggLayout) abi.ParamSlot {
    if (is_aggregate && size > MAX_REG_RET) {
        ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
    }

    if (is_aggregate) {
        val eb0_sse: bool = (fp_eightbytes & 1) != 0;
        if (size <= 8) {
            if (eb0_sse) {
                if (fp_used < FP_PARAM_COUNT) {
                    ret abi.make_slot(abi.CLASS_GP, fp_param_reg(fp_used), 0, size, 8);
                }
                ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
            }
            if (gp_used < GP_PARAM_COUNT) {
                ret abi.make_slot(abi.CLASS_GP, gp_param_reg(gp_used), 0, size, 8);
            }
            ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
        }

        val eb1_sse: bool = (fp_eightbytes & 2) != 0;
        var gp_need: i32 = 0;
        var fp_need: i32 = 0;
        if (eb0_sse) { fp_need = fp_need + 1; } or { gp_need = gp_need + 1; }
        if (eb1_sse) { fp_need = fp_need + 1; } or { gp_need = gp_need + 1; }

        if (gp_used + gp_need <= GP_PARAM_COUNT && fp_used + fp_need <= FP_PARAM_COUNT) {
            var gi: i32 = gp_used;
            var fi: i32 = fp_used;
            var r0: i32 = 0;
            var r1: i32 = 0;
            if (eb0_sse) { r0 = fp_param_reg(fi); fi = fi + 1; } or { r0 = gp_param_reg(gi); gi = gi + 1; }
            if (eb1_sse) { r1 = fp_param_reg(fi); fi = fi + 1; } or { r1 = gp_param_reg(gi); gi = gi + 1; }
            ret abi.make_slot_pair(abi.CLASS_GP, r0, r1, 0, size, EIGHTBYTE);
        }
        ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
    }

    if (is_vector && size > VEC_REG_BYTES) {
        if (gp_used < GP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_BYREF, gp_param_reg(gp_used), 0, 8, 8);
        }
        ret abi.make_slot(abi.CLASS_STACK_BYREF, -1, 0, 8, 0);
    }

    if (is_vector) {
        if (fp_used < FP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_FP, fp_param_reg(fp_used), 0, size, VEC_REG_BYTES::u8);
        }
        ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
    }

    if (is_float) {
        if (fp_used < FP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_FP, fp_param_reg(fp_used), 0, size, size::u8);
        }
        ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
    }

    if (gp_used < GP_PARAM_COUNT) {
        ret abi.make_slot(abi.CLASS_GP, gp_param_reg(gp_used), 0, size, 8);
    }
    ret abi.make_slot(abi.CLASS_STACK, -1, 0, size, 0);
}

pub fun classify_return(size: u64, align: u64,
                        is_float: bool, fp_eightbytes: u8, is_aggregate: bool, is_vector: bool,
                        hfa_members: u8, hfa_elem: u8, agg: abi.AggLayout) abi.ParamSlot {
    if (size == 0) {
        ret abi.make_slot(abi.CLASS_GP, -1, 0, 0, 0);
    }

    if (is_aggregate && size > MAX_REG_RET) {
        ret abi.make_slot(abi.CLASS_SRET, REG_RAX, 0, 8, 8);
    }

    if (is_aggregate) {
        val eb0_sse: bool = (fp_eightbytes & 1) != 0;
        if (size <= 8) {
            if (eb0_sse) { ret abi.make_slot(abi.CLASS_GP, REG_XMM0, 0, size, 8); }
            ret abi.make_slot(abi.CLASS_GP, REG_RAX, 0, size, 8);
        }

        val eb1_sse: bool = (fp_eightbytes & 2) != 0;
        var ni: i32 = 0;
        var ns: i32 = 0;
        var r0: i32 = 0;
        var r1: i32 = 0;
        if (eb0_sse) { r0 = ret_sse_reg(ns); ns = ns + 1; } or { r0 = ret_int_reg(ni); ni = ni + 1; }
        if (eb1_sse) { r1 = ret_sse_reg(ns); ns = ns + 1; } or { r1 = ret_int_reg(ni); ni = ni + 1; }
        ret abi.make_slot_pair(abi.CLASS_GP, r0, r1, 0, size, EIGHTBYTE);
    }

    if (is_vector && size > VEC_REG_BYTES) {
        ret abi.make_slot(abi.CLASS_SRET, REG_RAX, 0, 8, 8);
    }

    if (is_vector) {
        ret abi.make_slot(abi.CLASS_FP, REG_XMM0, 0, size, VEC_REG_BYTES::u8);
    }

    if (is_float) {
        ret abi.make_slot(abi.CLASS_FP, REG_XMM0, 0, size, size::u8);
    }

    ret abi.make_slot(abi.CLASS_GP, REG_RAX, 0, size, 8);
}

fun ret_int_reg(index: i32) i32 {
    if (index == 0) { ret REG_RAX; }
    ret REG_RDX;
}

fun ret_sse_reg(index: i32) i32 {
    if (index == 0) { ret REG_XMM0; }
    ret REG_XMM1;
}

pub fun gp_param_regs(out: *isa.Register) i32 {
    var i: i32 = 0;
    for (i < GP_PARAM_COUNT) {
        out[i].id   = gp_param_reg(i);
        out[i].size = 8;
        i = i + 1;
    }
    ret GP_PARAM_COUNT;
}

pub fun callee_saved(out: *isa.Register) i32 {
    out[0].id = REG_RBX; out[0].size = 8;
    out[1].id = REG_RBP; out[1].size = 8;
    out[2].id = REG_R12; out[2].size = 8;
    out[3].id = REG_R13; out[3].size = 8;
    out[4].id = REG_R14; out[4].size = 8;
    out[5].id = REG_R15; out[5].size = 8;
    ret CALLEE_SAVED_COUNT;
}

pub fun va_model() abi.VaModel {
    ret abi.va_model_make(abi.VA_MODEL_REG_SAVE, false, VA_VECTOR_COUNT_REG, 64);
}

pub fun register(reg: *abi.AbiRegistry) R.Result[R.Void, str] {
    val shadow_space: u32 = 0;
    val indirect_result_reg: i32 = gp_param_reg(0);
    val consumes_agg_layout: bool = false;
    val fp_callee_saved_full_vector: bool = true;
    val float_arg_bits: u32 = 64;

    var sysv_vtable: abi.AbiVTable = abi.abi_vtable(
        abi.ABI_SYSV, abi.abi_name_for(abi.ABI_SYSV), isa.ARCH_X86_64,
        classify_arg, classify_return,
        gp_param_regs, callee_saved,
        STACK_ALIGN, RED_ZONE, shadow_space,
        indirect_result_reg, true,
        consumes_agg_layout, fp_callee_saved_full_vector,
        float_arg_bits, EIGHTBYTE,
        va_model
    );
    abi.with_legacy_classifier(?sysv_vtable, classify);

    ret abi.register(reg, ?sysv_vtable);
}

test "mach.lang.target.abi.sysv.classify_arg:all_float_16byte_rides_xmm_pair" {
    val s: abi.ParamSlot = classify_arg(0, 16, 8, false, 3, true, false, 0, 0, 0, 0, abi.agg_none());
    if (s.class != abi.CLASS_GP)            { ret 1; }
    if (s.piece_count   != 2)               { ret 1; }
    if (s.pieces[0].reg != fp_param_reg(0)) { ret 1; }
    if (s.pieces[1].reg != fp_param_reg(1)) { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.sysv.classify_arg:all_float_8byte_rides_one_xmm" {
    val s: abi.ParamSlot = classify_arg(0, 8, 4, false, 1, true, false, 0, 0, 0, 0, abi.agg_none());
    if (s.class != abi.CLASS_GP)            { ret 1; }
    if (s.piece_count   != 1)               { ret 1; }
    if (s.pieces[0].reg != fp_param_reg(0)) { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.sysv.classify_arg:mixed_int_sse_rides_rdi_xmm" {
    val s: abi.ParamSlot = classify_arg(0, 16, 8, false, 2, true, false, 0, 0, 0, 0, abi.agg_none());
    if (s.pieces[0].reg != REG_RDI)         { ret 1; }
    if (s.pieces[1].reg != fp_param_reg(0)) { ret 1; }
    val r: abi.ParamSlot = classify_arg(0, 16, 8, false, 1, true, false, 0, 0, 0, 0, abi.agg_none());
    if (r.pieces[0].reg != fp_param_reg(0)) { ret 1; }
    if (r.pieces[1].reg != REG_RDI)         { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.sysv.classify_arg:all_integer_rides_gp_pair" {
    val s: abi.ParamSlot = classify_arg(0, 16, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
    if (s.pieces[0].reg != REG_RDI) { ret 1; }
    if (s.pieces[1].reg != REG_RSI) { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.sysv.classify_arg:sse_bank_exhaustion_spills" {
    val s: abi.ParamSlot = classify_arg(0, 16, 8, false, 3, true, false, 0, 7, 0, 0, abi.agg_none());
    if (s.class != abi.CLASS_STACK) { ret 1; }
    if (s.size  != 16)              { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.sysv.classify_return:all_float_returns_xmm_pair" {
    val s: abi.ParamSlot = classify_return(16, 8, false, 3, true, false, 0, 0, abi.agg_none());
    if (s.pieces[0].reg != REG_XMM0) { ret 1; }
    if (s.pieces[1].reg != REG_XMM1) { ret 1; }
    val o: abi.ParamSlot = classify_return(8, 4, false, 1, true, false, 0, 0, abi.agg_none());
    if (o.piece_count   != 1)        { ret 1; }
    if (o.pieces[0].reg != REG_XMM0) { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.sysv.classify_return:banks_fill_in_order" {
    val gp: abi.ParamSlot = classify_return(16, 8, false, 0, true, false, 0, 0, abi.agg_none());
    if (gp.pieces[0].reg != REG_RAX || gp.pieces[1].reg != REG_RDX) { ret 1; }
    val mix: abi.ParamSlot = classify_return(16, 8, false, 2, true, false, 0, 0, abi.agg_none());
    if (mix.pieces[0].reg != REG_RAX || mix.pieces[1].reg != REG_XMM0) { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.sysv.classify_arg:scalar_float_xmm_integer_gp" {
    val f: abi.ParamSlot = classify_arg(0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (f.class != abi.CLASS_FP)    { ret 1; }
    if (f.reg   != fp_param_reg(0)) { ret 1; }
    val i: abi.ParamSlot = classify_arg(0, 8, 8, false, 0, false, false, 0, 0, 0, 0, abi.agg_none());
    if (i.class != abi.CLASS_GP) { ret 1; }
    if (i.reg   != REG_RDI)      { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.sysv.register:indirect_result_in_argfile" {
    var reg: abi.AbiRegistry = abi.registry_init();
    fin { abi.registry_dnit(?reg); }
    val r: R.Result[R.Void, str] = register(?reg);
    if (R.is_err[R.Void, str](r))                             { ret 1; }
    val found: O.Option[*abi.AbiVTable] = abi.lookup(?reg, abi.abi_name_for(abi.ABI_SYSV));
    if (O.is_none[*abi.AbiVTable](found))                   { ret 1; }
    val sysv_vtable: *abi.AbiVTable = O.unwrap[*abi.AbiVTable](found);
    if (sysv_vtable.indirect_result_reg != gp_param_reg(0)) { ret 1; }
    if (sysv_vtable.indirect_result_reg != REG_RDI)         { ret 1; }
    if (!sysv_vtable.indirect_result_in_argfile)            { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.sysv.classify_arg:large_aggregate_memory_class_by_value" {
    val s0: abi.ParamSlot = classify_arg(0, 32, 8, false, 0, true, false, 0, 0, 0, 0, abi.agg_none());
    if (s0.class != abi.CLASS_STACK) { ret 1; }
    if (s0.reg   != -1)              { ret 1; }
    if (s0.size  != 32)              { ret 1; }

    val s1: abi.ParamSlot = classify_arg(0, 32, 8, false, 0, true, false, 5, 0, 0, 0, abi.agg_none());
    if (s1.class != abi.CLASS_STACK) { ret 1; }
    if (s1.reg   != -1)              { ret 1; }
    if (s1.size  != 32)              { ret 1; }

    val s2: abi.ParamSlot = classify_arg(0, 17, 8, false, 0, true, false, 6, 0, 0, 0, abi.agg_none());
    if (s2.class != abi.CLASS_STACK) { ret 1; }
    if (s2.reg   != -1)              { ret 1; }
    if (s2.size  != 17)              { ret 1; }
    ret 0;
}
