# SPIR-V type and constant deduplication
#
# SPIR-V requires every scalar / pointer / function type and every constant to be
# a single, structurally-unique definition in the module's types-and-constants
# section. This module owns a `TypeTable` that memoizes each request against the
# builder: the first time a type or constant is asked for it allocates an id,
# emits the defining instruction into the builder's `types_consts` section, and
# caches the id; every later request for the same shape returns the cached id. The
# emitter reasons in MIR widths and op signedness and asks here for the concrete
# SPIR-V ids.
#
# SPIR-V integer types are sign-less: signedness rides the operation (OpSDiv vs
# OpUDiv), so a width maps to exactly one `OpTypeInt <bits> 0` and the emitter
# never mints a signed / unsigned pair.
#
# A constant is keyed by its TYPE ID and its literal bit pattern, never by a width
# and a class: an `OpConstant`'s literal words are the value's representation and
# say nothing about how the type reads them, so `1.5f32` and the integer
# `0x3FC00000` are one bit pattern under two types and must not collide. Callers
# ask for the type first and mint the constant against it (`const_scalar`); the
# `const_int` / `const_float` wrappers exist for the common case where the caller
# knows the width but not yet the id.

use std.allocator.page;
use std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.target.isa.spirv;

# a memoized scalar / pointer type. `tag` selects which cache role the entry
# fills; `a` / `b` carry the shape (int/float bits, or pointer storage class /
# pointee id); `id` is the allocated SPIR-V type id
# ---
# tag: one of TAG_*
# a:   int/float bit width, or pointer storage class
# b:   pointer pointee type id (0 for scalars)
# id:  the allocated SPIR-V type id
rec ScalarKey {
    tag: u8;
    a:   u32;
    b:   u32;
    id:  u32;
}

# a memoized constant: its result type id, the two value words (the high word is 0
# for values <= 32 bits), and the allocated id
# ---
# type_id: the constant's SPIR-V type id
# lo:      low 32 value bits
# hi:      high 32 value bits (0 for <= 32-bit constants)
# id:      the allocated SPIR-V constant id
rec ConstKey {
    type_id: u32;
    lo:      u32;
    hi:      u32;
    id:      u32;
}

# a memoized function type: its return type id and the borrowed-then-copied param
# type id list
# ---
# ret_id:      return type id
# params:      owned copy of the param type ids
# param_count: number of params
# id:          the allocated SPIR-V function type id
rec FnKey {
    ret_id:      u32;
    params:      *u32;
    param_count: u32;
    id:          u32;
}

# tags distinguishing the scalar-cache roles
val TAG_INT:   u8 = 0;  # OpTypeInt (signedness 0), `a` = bit width
val TAG_FLOAT: u8 = 1;  # OpTypeFloat, `a` = bit width
val TAG_BOOL:  u8 = 2;  # OpTypeBool
val TAG_VOID:  u8 = 3;  # OpTypeVoid
val TAG_PTR:   u8 = 4;  # OpTypePointer, `a` = storage class, `b` = pointee id
val TAG_VEC:   u8 = 5;  # OpTypeVector, `a` = component type id, `b` = component count
val TAG_ARRAY: u8 = 6;  # OpTypeArray (no explicit layout), `a` = element type id, `b` = length
val TAG_NULL:  u8 = 7;  # OpConstantNull, `a` = the type the null belongs to
# OpTypeImage (#2794), `a` = the packed operand word, `b` = the sampled type id.
# the operands are PACKED INTO ONE KEY rather than given a cache role each, because
# the cache is keyed on two words and an image has six operands - and an image type
# that interned on a subset of them would hand two different images one id
val TAG_IMAGE: u8 = 8;
# OpTypeSampledImage, `a` = the underlying OpTypeImage id
val TAG_SAMPLED_IMAGE: u8 = 9;
# OpTypeSampler, which has no operands at all
val TAG_SAMPLER: u8 = 10;

# the largest component count a Shader module may give an OpTypeVector
#
# SPIR-V caps a vector at 2, 3, or 4 components; 8 and 16 exist only under the
# Vector16 capability, which is a Kernel (OpenCL) feature a Shader module may not
# declare.
#
# THIS IS A REALIZATION BOUND, NOT A LEGALITY ONE (#2749). A mach vector of more
# lanes than this is legal on this target like every other, and it is realized as an
# `OpTypeArray` of its lanes with per-lane scalar operations - see
# `type_vector_value`. The model declares this same number as its
# `max_vector_lanes`, which is what routes such a shape's operators to the scalar
# expansion instead of to a packed form the module could not name.
pub val MAX_VECTOR_COMPONENTS: u32 = 4;

# the largest member count a uniform block may carry in this milestone, bounded by
# the fixed operand buffer `type_struct` assembles into
pub val MAX_STRUCT_MEMBERS: u32 = 16;

# the largest parameter count a signature may carry in this milestone
#
# SPIR-V itself imposes no small bound; sixteen is here because the emitter
# assembles a signature's operands into fixed arrays. It is stated ONCE and both
# the refusal in `emit_function` and the operand buffer in `type_fn` are sized from
# it. They used to be two independent literals - a `> 16` comparison and a
# `[16]u32` holding a result id and a return type as well - so fifteen and sixteen
# parameters were accepted by one and rejected by the other, and the rejection was
# a returned 0 that nobody read and that reached `OpFunction` as the reserved
# never-valid id (#2748).
pub val MAX_FN_PARAMS: u32 = 16;

# a memoized composite constant: its result type id and the borrowed-then-copied
# component id list
# ---
# type_id:   the composite's SPIR-V type id
# parts:     owned copy of the component constant ids
# part_count: number of components
# id:        the allocated SPIR-V constant id
rec CompositeKey {
    type_id:    u32;
    parts:      *u32;
    part_count: u32;
    id:         u32;
}

# the member types of one composite (struct or array) this table minted
#
# A composite's own instruction names its members, but nothing reads instructions
# back, and an `OpAccessChain` result type is the member type at an index - so the
# shape has to be recoverable from the id. This is the composite analogue of
# `vector_shape`. It matters most for an explicitly-laid-out array or struct, which
# is deliberately NOT interned (its decorations are part of its identity), so it
# cannot be rebuilt by asking for the same shape again.
# ---
# id:      the composite type id
# members: owned copy of the member type ids; for an array, one entry, the element
# count:   number of members, or 0 for an array (whose index is unbounded)
# laid_out: whether the type carries explicit-layout decorations, which are part of
#          its identity and so bar it from being shared with an undecorated twin
# elems:   an array's length, 0 for a struct. two arrays of the same element type and
#          different lengths are different objects, so a shape comparison that read
#          only the element would call them the same
rec ShapeKey {
    id:      u32;
    members: *u32;
    count:   u32;
    laid_out: bool;
    elems:   u32;
}

# the per-module type / constant memoization table
#
# Threads the builder so a cache miss can allocate an id and emit the defining
# instruction. Every cache is a linear vector - a compiled function names only a
# handful of distinct types and constants, so a scan is cheaper than a hash.
# ---
# b:       the module builder the ids are allocated from and instructions emitted into
# scalars: memoized scalar / vector / pointer types
# consts:  memoized scalar constants
# fns:     memoized function types
# comps:   memoized composite (vector) constants
# shapes:  member types of every struct / array minted, for walking an access chain
pub rec TypeTable {
    b:       *spirv.Builder;
    scalars: Vector[ScalarKey];
    consts:  Vector[ConstKey];
    fns:     Vector[FnKey];
    comps:   Vector[CompositeKey];
    shapes:  Vector[ShapeKey];
}

# construct an empty type table over a builder
# ---
# b:   the module builder to allocate ids from and emit into
# ret: an initialized TypeTable
pub fun types_init(b: *spirv.Builder) TypeTable {
    var tt: TypeTable;
    tt.b       = b;
    tt.scalars = vector.init[ScalarKey](b.alloc);
    tt.consts  = vector.init[ConstKey](b.alloc);
    tt.fns     = vector.init[FnKey](b.alloc);
    tt.comps   = vector.init[CompositeKey](b.alloc);
    tt.shapes  = vector.init[ShapeKey](b.alloc);
    ret tt;
}

# release every cache the type table owns, including each function type's param copy
# ---
# tt: the table to tear down
pub fun types_dnit(tt: *TypeTable) {
    var i: usize = 0;
    for (i < tt.fns.len) {
        val fk: *FnKey = ?tt.fns.data[i];
        if (fk.params != nil && fk.param_count > 0) {
            A.deallocate[u32](tt.b.alloc, fk.params, fk.param_count::usize);
        }
        i = i + 1;
    }
    var ci: usize = 0;
    for (ci < tt.comps.len) {
        val ck: *CompositeKey = ?tt.comps.data[ci];
        if (ck.parts != nil && ck.part_count > 0) {
            A.deallocate[u32](tt.b.alloc, ck.parts, ck.part_count::usize);
        }
        ci = ci + 1;
    }
    vector.dnit[ScalarKey](?tt.scalars);
    vector.dnit[ConstKey](?tt.consts);
    vector.dnit[FnKey](?tt.fns);
    var si: usize = 0;
    for (si < tt.shapes.len) {
        val sk: *ShapeKey = ?tt.shapes.data[si];
        if (sk.members != nil) {
            var n: u32 = sk.count;
            if (n == 0) { n = 1; }
            A.deallocate[u32](tt.b.alloc, sk.members, n::usize);
        }
        si = si + 1;
    }
    vector.dnit[CompositeKey](?tt.comps);
    vector.dnit[ShapeKey](?tt.shapes);
}

# record the member types of a composite so an access chain can walk it
# ---
# tt:      the table
# id:      the composite type id
# members: the member type ids (one entry for an array's element)
# count:   number of members, or 0 for an array
# elems:   an array's length, 0 for a struct
fun shape_put(tt: *TypeTable, id: u32, members: *u32, count: u32, laid_out: bool, elems: u32) {
    var n: u32 = count;
    if (n == 0) { n = 1; }
    val r: R.Result[*u32, str] = A.allocate[u32](tt.b.alloc, n::usize);
    if (R.is_err[*u32, str](r)) { tt.b.err = true; ret; }
    val copy: *u32 = R.unwrap_ok[*u32, str](r);
    var i: u32 = 0;
    for (i < n) { copy[i] = members[i]; i = i + 1; }
    var k: ShapeKey;
    k.id = id; k.members = copy; k.count = count; k.laid_out = laid_out; k.elems = elems;
    vector.push[ShapeKey](?tt.shapes, k);
}

# the type reached by indexing a composite at `index`
#
# A struct yields its `index`-th member and an array yields its element whatever the
# index is, which is exactly what an `OpAccessChain` step produces. A vector is
# answered from the scalar cache instead, since its shape lives there.
# ---
# tt:    the table
# id:    the composite type id
# index: the index taken at this level
# ret:   the member type id, or 0 when `id` is not a composite this table minted
#        or `index` is past a struct's members
pub fun composite_member(tt: *TypeTable, id: u32, index: u32) u32 {
    var lanes: u32 = 0;
    val lane_ty: u32 = vector_shape(tt, id, ?lanes);
    if (lane_ty != 0) {
        if (index >= lanes) { ret 0; }
        ret lane_ty;
    }
    var i: usize = 0;
    for (i < tt.shapes.len) {
        val k: *ShapeKey = ?tt.shapes.data[i];
        if (k.id == id) {
            if (k.count == 0) { ret k.members[0]; }
            if (index >= k.count) { ret 0; }
            ret k.members[index];
        }
        i = i + 1;
    }
    ret 0;
}

# the shape row a composite id was minted under, or nil
# ---
# tt: the table
# id: the composite type id
# ret: the row, or nil when the id names no composite this table minted
fun shape_of(tt: *TypeTable, id: u32) *ShapeKey {
    var i: usize = 0;
    for (i < tt.shapes.len) {
        val k: *ShapeKey = ?tt.shapes.data[i];
        if (k.id == id) { ret k; }
        i = i + 1;
    }
    ret nil;
}

# whether two type ids describe the same object with different layout decorations
#
# A descriptor-bound block's struct is minted separately from the undecorated struct
# the same `rec` has everywhere else, because its `Block` and `Offset` decorations
# are part of its identity. The two are distinct types naming one object, and
# `OpCopyLogical` is what carries a value between them - defined only between
# LOGICALLY MATCHING types, which is what this answers.
#
# The rule is SPIR-V's: an aggregate matches an aggregate of the same class with the
# same member count, each member pair matching in turn, and an array's length is part
# of that. Anything else matches only itself. A scalar or vector is interned, so two
# of one shape are already one id and the identity test settles them.
# ---
# tt:  the table both ids were minted from
# a:   one type id
# b:   the other type id
# ret: true when a value of `a` describes the same object as one of `b`
pub fun logically_match(tt: *TypeTable, a: u32, b: u32) bool {
    if (a == 0 || b == 0) { ret false; }
    if (a == b) { ret true; }
    val ka: *ShapeKey = shape_of(tt, a);
    val kb: *ShapeKey = shape_of(tt, b);
    if (ka == nil || kb == nil) { ret false; }
    if (ka.count != kb.count || ka.elems != kb.elems) { ret false; }
    var n: u32 = ka.count;
    if (n == 0) { n = 1; }
    var i: u32 = 0;
    for (i < n) {
        if (!logically_match(tt, ka.members[i], kb.members[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# find a cached scalar / pointer id by shape, or 0 when absent
# ---
# tt:  the table to search
# tag: the cache role
# a:   the shape's first key
# b:   the shape's second key (pointer pointee, else 0)
# ret: the cached id, or 0
fun scalar_find(tt: *TypeTable, tag: u8, a: u32, b: u32) u32 {
    var i: usize = 0;
    for (i < tt.scalars.len) {
        val k: *ScalarKey = ?tt.scalars.data[i];
        if (k.tag == tag && k.a == a && k.b == b) { ret k.id; }
        i = i + 1;
    }
    ret 0;
}

# cache a freshly emitted scalar / pointer id under its shape
# ---
# tt:  the table
# tag: the cache role
# a:   the shape's first key
# b:   the shape's second key
# id:  the allocated id
fun scalar_put(tt: *TypeTable, tag: u8, a: u32, b: u32, id: u32) {
    var k: ScalarKey;
    k.tag = tag; k.a = a; k.b = b; k.id = id;
    vector.push[ScalarKey](?tt.scalars, k);
}

# the id of the sign-less integer type of `bits` width, emitting it on first use
# ---
# tt:   the table
# bits: the integer width in bits (8, 16, 32, 64)
# ret:  the OpTypeInt id
pub fun type_int(tt: *TypeTable, bits: u32) u32 {
    val hit: u32 = scalar_find(tt, TAG_INT, bits, 0);
    if (hit != 0) { ret hit; }
    if (bits == 8)  { tt.b.caps_needed = tt.b.caps_needed | spirv.NEED_INT8; }
    if (bits == 16) { tt.b.caps_needed = tt.b.caps_needed | spirv.NEED_INT16; }
    if (bits == 64) { tt.b.caps_needed = tt.b.caps_needed | spirv.NEED_INT64; }
    val id: u32 = spirv.alloc_id(tt.b);
    var ops: [3]u32;
    ops[0] = id; ops[1] = bits; ops[2] = 0;  # signedness 0: sign-less
    spirv.inst(tt.b, ?tt.b.types_consts, spirv.OP_TYPE_INT, ?ops[0], 3);
    scalar_put(tt, TAG_INT, bits, 0, id);
    ret id;
}

# the id of the floating-point type of `bits` width, emitting it on first use
# ---
# tt:   the table
# bits: the float width in bits (32, 64)
# ret:  the OpTypeFloat id
pub fun type_float(tt: *TypeTable, bits: u32) u32 {
    val hit: u32 = scalar_find(tt, TAG_FLOAT, bits, 0);
    if (hit != 0) { ret hit; }
    if (bits == 16) { tt.b.caps_needed = tt.b.caps_needed | spirv.NEED_FLOAT16; }
    if (bits == 64) { tt.b.caps_needed = tt.b.caps_needed | spirv.NEED_FLOAT64; }
    val id: u32 = spirv.alloc_id(tt.b);
    var ops: [2]u32;
    ops[0] = id; ops[1] = bits;
    spirv.inst(tt.b, ?tt.b.types_consts, spirv.OP_TYPE_FLOAT, ?ops[0], 2);
    scalar_put(tt, TAG_FLOAT, bits, 0, id);
    ret id;
}

# the id of the boolean type, emitting it on first use
# ---
# tt:  the table
# ret: the OpTypeBool id
pub fun type_bool(tt: *TypeTable) u32 {
    val hit: u32 = scalar_find(tt, TAG_BOOL, 0, 0);
    if (hit != 0) { ret hit; }
    val id: u32 = spirv.alloc_id(tt.b);
    var ops: [1]u32;
    ops[0] = id;
    spirv.inst(tt.b, ?tt.b.types_consts, spirv.OP_TYPE_BOOL, ?ops[0], 1);
    scalar_put(tt, TAG_BOOL, 0, 0, id);
    ret id;
}

# the id of the void type, emitting it on first use
# ---
# tt:  the table
# ret: the OpTypeVoid id
pub fun type_void(tt: *TypeTable) u32 {
    val hit: u32 = scalar_find(tt, TAG_VOID, 0, 0);
    if (hit != 0) { ret hit; }
    val id: u32 = spirv.alloc_id(tt.b);
    var ops: [1]u32;
    ops[0] = id;
    spirv.inst(tt.b, ?tt.b.types_consts, spirv.OP_TYPE_VOID, ?ops[0], 1);
    scalar_put(tt, TAG_VOID, 0, 0, id);
    ret id;
}

# the id of the vector type of `count` lanes of `elem`, emitting it on first use
#
# Returns 0 for a component count no Shader module may declare, so the caller can
# name the offending type in a diagnostic instead of emitting an OpTypeVector that
# only a Kernel module could carry (see MAX_VECTOR_COMPONENTS).
# ---
# tt:    the table
# elem:  the component type id (a scalar int or float)
# count: the number of components
# ret:   the OpTypeVector id, or 0 when `count` is not Shader-legal
pub fun type_vector(tt: *TypeTable, elem: u32, count: u32) u32 {
    if (count < 2 || count > MAX_VECTOR_COMPONENTS) { ret 0; }
    val hit: u32 = scalar_find(tt, TAG_VEC, elem, count);
    if (hit != 0) { ret hit; }
    val id: u32 = spirv.alloc_id(tt.b);
    var ops: [3]u32;
    ops[0] = id; ops[1] = elem; ops[2] = count;
    spirv.inst(tt.b, ?tt.b.types_consts, spirv.OP_TYPE_VECTOR, ?ops[0], 3);
    scalar_put(tt, TAG_VEC, elem, count, id);
    ret id;
}

# the component type and count of a vector type id
#
# Lets a caller holding only a vector id reach its lane type - to mint a lane
# constant, or to type the scalar side of an extract - without carrying the shape
# alongside the id.
#
# ANSWERS ONLY FOR AN `OpTypeVector`. A mach vector too wide for one is realized as
# an array, and `vector_value_shape` is the question that covers both realizations -
# this one is for a caller that specifically needs the packed form (a compare's
# boolean intermediate, a splat over components).
# ---
# tt:        the table
# id:        the type id to describe
# out_count: receives the component count (0 when `id` is not a vector)
# ret:       the component type id, or 0 when `id` is not a vector
pub fun vector_shape(tt: *TypeTable, id: u32, out_count: *u32) u32 {
    @out_count = 0;
    var i: usize = 0;
    for (i < tt.scalars.len) {
        val k: *ScalarKey = ?tt.scalars.data[i];
        if (k.id == id && k.tag == TAG_VEC) {
            @out_count = k.b;
            ret k.a;
        }
        i = i + 1;
    }
    ret 0;
}

# THE VECTOR REALIZATION (#2749): the SPIR-V type carrying a mach vector of `count`
# lanes of `elem`
#
# Two forms, chosen by the count alone. Up to `MAX_VECTOR_COMPONENTS` it is an
# `OpTypeVector`, which is the whole point of this target having a vector unit: the
# lanes stay one value and the arithmetic opcodes are lane-wise. Above it, no Shader
# module may name a vector of that many components, so the lanes are carried by an
# `OpTypeArray` of the element type instead - a composite this addressing model can
# express, whose lanes `OpCompositeExtract` / `OpCompositeInsert` reach by the same
# constant ordinal, and whose operators the mid-end has already expanded to per-lane
# scalar code because the model's `max_vector_lanes` told it to.
#
# NOT A FALLBACK AND NOT A REFUSAL. #2488 makes a vector type legal on every target
# and leaves only the realization target-dependent; this is that realization on the
# one target whose vector unit is bounded by a component count. The array is the
# analogue of a machine target splitting a too-wide vector across registers.
#
# A mach `[N]T` shares the array id, which is correct: mach's own types are already
# checked, SPIR-V draws no distinction between the two, and minting a second
# identical `OpTypeArray` would be duplicate type declarations rather than safety.
# ---
# tt:    the table
# elem:  the lane type id (a scalar int or float)
# count: the lane count
# ret:   the realization's type id, or 0 when the count is degenerate
pub fun type_vector_value(tt: *TypeTable, elem: u32, count: u32) u32 {
    if (count < 2) { ret 0; }
    if (count <= MAX_VECTOR_COMPONENTS) { ret type_vector(tt, elem, count); }
    ret type_array(tt, elem, count, false);
}

# the lane type and lane count of a vector REALIZATION, covering both forms
#
# The inverse of `type_vector_value`, and what every caller holding a vector-typed
# value id should ask: it answers for the array realization as well as the packed
# one, so a path written against `vector_shape` alone silently stops working the
# moment a shape crosses the component ceiling.
# ---
# tt:        the table
# id:        the type id to describe
# out_count: receives the lane count (0 when `id` is not a vector realization)
# ret:       the lane type id, or 0 when `id` is not a vector realization
pub fun vector_value_shape(tt: *TypeTable, id: u32, out_count: *u32) u32 {
    val packed: u32 = vector_shape(tt, id, out_count);
    if (packed != 0) { ret packed; }
    var i: usize = 0;
    for (i < tt.scalars.len) {
        val k: *ScalarKey = ?tt.scalars.data[i];
        if (k.id == id && k.tag == TAG_ARRAY) {
            @out_count = k.b;
            ret k.a;
        }
        i = i + 1;
    }
    @out_count = 0;
    ret 0;
}

# the id of the array type of `count` elements of `elem`, emitting it on first use
#
# SPIR-V takes an array's length as a CONSTANT id rather than a literal, so the
# length is minted as a 32-bit integer constant first.
#
# `explicit_layout` decides whether the result is interned. An array inside a
# uniform block must carry an `ArrayStride` decoration and an array outside one must
# not, so the two cannot share an id - the same split, and for the same reason, as
# a Block-decorated struct. A laid-out array is therefore minted fresh and its
# caller decorates it; a plain array is interned like any other type.
# ---
# tt:              the table
# elem:            the element type id
# count:           the number of elements
# explicit_layout: whether the result will carry an ArrayStride decoration
# ret:             the OpTypeArray id, or 0 when the count is zero
pub fun type_array(tt: *TypeTable, elem: u32, count: u32, explicit_layout: bool) u32 {
    if (count == 0) { ret 0; }
    if (!explicit_layout) {
        val hit: u32 = scalar_find(tt, TAG_ARRAY, elem, count);
        if (hit != 0) { ret hit; }
    }
    val len_id: u32 = const_int(tt, 32, count::i64);
    val id: u32 = spirv.alloc_id(tt.b);
    var ops: [3]u32;
    ops[0] = id; ops[1] = elem; ops[2] = len_id;
    spirv.inst(tt.b, ?tt.b.types_consts, spirv.OP_TYPE_ARRAY, ?ops[0], 3);
    if (!explicit_layout) { scalar_put(tt, TAG_ARRAY, elem, count, id); }
    var el: [1]u32;
    el[0] = elem;
    shape_put(tt, id, ?el[0], 0, explicit_layout, count);
    ret id;
}

# the id of the struct type over `members`, emitting it on first use
#
# `explicit_layout` decides whether the result is interned, exactly as it does for
# an array. A descriptor BLOCK carries decorations - Block on the type, an Offset on
# every member - which are part of its identity, so two blocks with the same member
# types are still distinct whenever their layouts differ, and interning on the
# member list alone would attach one block's offsets to the other. A plain struct
# carries no decorations, so two with the same members ARE the same type and must
# share one id: otherwise assigning between two locals of one `rec` would be a type
# mismatch against itself.
# ---
# tt:      the table
# members: the member type ids
# n:       number of members
# explicit_layout: whether the result will carry Block / Offset decorations
# ret:     the OpTypeStruct id, or 0 when the member count is out of range
pub fun type_struct(tt: *TypeTable, members: *u32, n: u32, explicit_layout: bool) u32 {
    if (n == 0 || n > MAX_STRUCT_MEMBERS) { ret 0; }
    if (!explicit_layout) {
        var si: usize = 0;
        for (si < tt.shapes.len) {
            val k: *ShapeKey = ?tt.shapes.data[si];
            if (!k.laid_out && k.count == n && params_equal(k.members, members, n)) { ret k.id; }
            si = si + 1;
        }
    }
    val id: u32 = spirv.alloc_id(tt.b);
    var ops: [17]u32;
    ops[0] = id;
    var i: u32 = 0;
    for (i < n) { ops[1 + i] = members[i]; i = i + 1; }
    spirv.inst(tt.b, ?tt.b.types_consts, spirv.OP_TYPE_STRUCT, ?ops[0], n + 1);
    shape_put(tt, id, members, n, explicit_layout, 0);
    ret id;
}

# the id of the image type over `sampled` with the given operands, emitting it on
# first use (#2794)
#
# EVERY OPERAND IS PASSED IN AND EVERY ONE IS PART OF THE KEY. `OpTypeImage` takes
# the sampled type, dimensionality, depth, arrayedness, multisampledness, sampled-ness
# and format as seven separate operands, and two images differing in any one are
# different types that must not share an id. They are packed into the cache's single
# `a` word for that reason: a cache role per operand would not fit the two-word key,
# and interning on a subset is the failure mode - a `sampler2d` and a
# `sampler2darray` sharing an id would bind one descriptor for both.
#
# The dimensionality's own capability is accumulated here rather than at the use
# site, on the same terms as an `OpTypeInt 64` accumulating Int64: the DECLARATION is
# what requires it, so a handle bound and never sampled still declares correctly.
# ---
# tt:      the table
# sampled: the sampled scalar's type id
# dim:     the SPIR-V Dim operand (spirv.DIM_*)
# depth:   the Depth operand (0 not depth, 1 depth, 2 unknown)
# arrayed: the Arrayed operand
# ms:      the MS operand
# sampled_op: the Sampled operand (spirv.IMAGE_SAMPLED_YES)
# ret:     the OpTypeImage id
pub fun type_image(tt: *TypeTable, sampled: u32, dim: u32, depth: u32, arrayed: u32,
                   ms: u32, sampled_op: u32) u32 {
    val key: u32 = dim | (depth << 8) | (arrayed << 12) | (ms << 16) | (sampled_op << 20);
    val hit: u32 = scalar_find(tt, TAG_IMAGE, key, sampled);
    if (hit != 0) { ret hit; }
    if (dim == spirv.DIM_1D) {
        tt.b.caps_needed = tt.b.caps_needed | spirv.NEED_SAMPLED_1D;
    }
    if (dim == spirv.DIM_CUBE && arrayed != 0) {
        tt.b.caps_needed = tt.b.caps_needed | spirv.NEED_SAMPLED_CUBE_ARRAY;
    }
    val id: u32 = spirv.alloc_id(tt.b);
    var ops: [8]u32;
    ops[0] = id;      ops[1] = sampled; ops[2] = dim;        ops[3] = depth;
    ops[4] = arrayed; ops[5] = ms;      ops[6] = sampled_op; ops[7] = spirv.IMAGE_FORMAT_UNKNOWN;
    spirv.inst(tt.b, ?tt.b.types_consts, spirv.OP_TYPE_IMAGE, ?ops[0], 8);
    scalar_put(tt, TAG_IMAGE, key, sampled, id);
    ret id;
}

# the id of the sampled-image type over `image`, emitting it on first use (#2794)
# ---
# tt:    the table
# image: the underlying OpTypeImage id
# ret:   the OpTypeSampledImage id
pub fun type_sampled_image(tt: *TypeTable, image: u32) u32 {
    val hit: u32 = scalar_find(tt, TAG_SAMPLED_IMAGE, image, 0);
    if (hit != 0) { ret hit; }
    val id: u32 = spirv.alloc_id(tt.b);
    var ops: [2]u32;
    ops[0] = id; ops[1] = image;
    spirv.inst(tt.b, ?tt.b.types_consts, spirv.OP_TYPE_SAMPLED_IMAGE, ?ops[0], 2);
    scalar_put(tt, TAG_SAMPLED_IMAGE, image, 0, id);
    ret id;
}

# the id of the sampler type, emitting it on first use (#2794)
#
# A sampler carries no operands: it is the filtering and addressing state alone,
# with no image attached, which is exactly what makes the separately-bound form a
# different shape from the combined one rather than a decoration of it.
# ---
# tt:  the table
# ret: the OpTypeSampler id
pub fun type_sampler(tt: *TypeTable) u32 {
    val hit: u32 = scalar_find(tt, TAG_SAMPLER, 0, 0);
    if (hit != 0) { ret hit; }
    val id: u32 = spirv.alloc_id(tt.b);
    var ops: [1]u32;
    ops[0] = id;
    spirv.inst(tt.b, ?tt.b.types_consts, spirv.OP_TYPE_SAMPLER, ?ops[0], 1);
    scalar_put(tt, TAG_SAMPLER, 0, 0, id);
    ret id;
}

# whether `id` names one of the three opaque handle types this table minted (#2794)
#
# A caller needs this to decide whether a value may be stored: SPIR-V forbids
# storing an image, sampler or sampled-image object at all, so a vreg holding one
# gets no backing variable and its value is carried as an id instead. Asking the
# table rather than tracking a flag alongside every id is what keeps the two from
# disagreeing.
# ---
# tt: the table
# id: the type id to test
# ret: true for an OpTypeImage, OpTypeSampledImage, or OpTypeSampler id
pub fun type_is_opaque(tt: *TypeTable, id: u32) bool {
    var i: usize = 0;
    for (i < tt.scalars.len) {
        val k: *ScalarKey = ?tt.scalars.data[i];
        if (k.id == id && (k.tag == TAG_IMAGE || k.tag == TAG_SAMPLED_IMAGE || k.tag == TAG_SAMPLER)) {
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

# the id of the pointer type `storage`-class to `pointee`, emitting it on first use
# ---
# tt:      the table
# storage: the SPIR-V storage class (spirv.STORAGE_*)
# pointee: the pointed-to type id
# ret:     the OpTypePointer id
pub fun type_ptr(tt: *TypeTable, storage: u32, pointee: u32) u32 {
    val hit: u32 = scalar_find(tt, TAG_PTR, storage, pointee);
    if (hit != 0) { ret hit; }
    val id: u32 = spirv.alloc_id(tt.b);
    var ops: [3]u32;
    ops[0] = id; ops[1] = storage; ops[2] = pointee;
    spirv.inst(tt.b, ?tt.b.types_consts, spirv.OP_TYPE_POINTER, ?ops[0], 3);
    scalar_put(tt, TAG_PTR, storage, pointee, id);
    ret id;
}

# the id of the function type `ret_id (params...)`, emitting it on first use
#
# Deduplicates by return id plus an exact param-id-sequence match, so two
# signatures with the same shape share one OpTypeFunction.
# ---
# tt:     the table
# ret_id: the return type id
# params: the param type ids, or nil when n is 0
# n:      number of params
# ret:    the OpTypeFunction id, or 0 when `n` exceeds MAX_FN_PARAMS. a 0 is a
#         failure the caller must report rather than pass into an instruction
pub fun type_fn(tt: *TypeTable, ret_id: u32, params: *u32, n: u32) u32 {
    # refused BEFORE an id is allocated: a signature the buffer cannot hold used to
    # burn an id on the way out, so the failure moved every later id as well.
    if (n > MAX_FN_PARAMS) { ret 0; }

    var i: usize = 0;
    for (i < tt.fns.len) {
        val k: *FnKey = ?tt.fns.data[i];
        if (k.ret_id == ret_id && k.param_count == n && params_equal(k.params, params, n)) {
            ret k.id;
        }
        i = i + 1;
    }

    val id: u32 = spirv.alloc_id(tt.b);
    # OpTypeFunction operands: result id, return type, then each param type.
    var ops: [18]u32;
    ops[0] = id; ops[1] = ret_id;
    var pi: u32 = 0;
    for (pi < n) { ops[2 + pi] = params[pi]; pi = pi + 1; }
    spirv.inst(tt.b, ?tt.b.types_consts, spirv.OP_TYPE_FUNCTION, ?ops[0], n + 2);

    # cache an owned copy of the param ids for future structural comparison.
    var copy: *u32 = nil;
    if (n > 0) {
        val rc: R.Result[*u32, str] = A.allocate[u32](tt.b.alloc, n::usize);
        if (R.is_err[*u32, str](rc)) { tt.b.err = true; ret id; }
        copy = R.unwrap_ok[*u32, str](rc);
        var ci: u32 = 0;
        for (ci < n) { copy[ci] = params[ci]; ci = ci + 1; }
    }
    var fk: FnKey;
    fk.ret_id = ret_id; fk.params = copy; fk.param_count = n; fk.id = id;
    vector.push[FnKey](?tt.fns, fk);
    ret id;
}

# whether two param-id sequences of length `n` are element-wise equal
# ---
# a: first sequence (may be nil when n is 0)
# b: second sequence (may be nil when n is 0)
# n: length
# ret: true when equal
fun params_equal(a: *u32, b: *u32, n: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the bit width of a scalar type id, or 0 when the id is not an int / float
#
# A query over what the table already minted, so a caller holding only a type id
# can size a constant's literal or a conversion's operand without carrying the
# width alongside the id and letting the two drift.
# ---
# tt: the table
# id: the type id to describe
# ret: the width in bits, or 0 when `id` is not a scalar this table minted
pub fun type_bits(tt: *TypeTable, id: u32) u32 {
    var i: usize = 0;
    for (i < tt.scalars.len) {
        val k: *ScalarKey = ?tt.scalars.data[i];
        if (k.id == id && (k.tag == TAG_INT || k.tag == TAG_FLOAT)) { ret k.a; }
        i = i + 1;
    }
    ret 0;
}

# whether a type id names a floating-point type this table minted
# ---
# tt: the table
# id: the type id to test
# ret: true only for an OpTypeFloat id
pub fun type_is_float(tt: *TypeTable, id: u32) bool {
    var i: usize = 0;
    for (i < tt.scalars.len) {
        val k: *ScalarKey = ?tt.scalars.data[i];
        if (k.id == id && k.tag == TAG_FLOAT) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the id of the constant of type `type_id` holding the bit pattern `hi:lo`,
# emitting it on first use
#
# The literal words are the value's REPRESENTATION: an OpConstant carries the bit
# pattern its result type reads, so an f32 `1.5` and the i32 `0x3FC00000` are the
# same two words under different types. Keying the cache on the type id as well as
# the pattern is what keeps them distinct. The high word is emitted only for a type
# wider than 32 bits.
# ---
# tt:      the table
# type_id: the constant's result type id (an int or float type)
# lo:      the low 32 bits of the value's representation
# hi:      the high 32 bits (ignored for a type 32 bits or narrower)
# ret:     the OpConstant id
pub fun const_scalar(tt: *TypeTable, type_id: u32, lo: u32, hi: u32) u32 {
    val wide: bool = type_bits(tt, type_id) > 32;
    var high: u32 = 0;
    if (wide) { high = hi; }

    var i: usize = 0;
    for (i < tt.consts.len) {
        val k: *ConstKey = ?tt.consts.data[i];
        if (k.type_id == type_id && k.lo == lo && k.hi == high) { ret k.id; }
        i = i + 1;
    }

    val id: u32 = spirv.alloc_id(tt.b);
    if (wide) {
        var ops: [4]u32;
        ops[0] = type_id; ops[1] = id; ops[2] = lo; ops[3] = high;
        spirv.inst(tt.b, ?tt.b.types_consts, spirv.OP_CONSTANT, ?ops[0], 4);
    }
    or {
        var ops: [3]u32;
        ops[0] = type_id; ops[1] = id; ops[2] = lo;
        spirv.inst(tt.b, ?tt.b.types_consts, spirv.OP_CONSTANT, ?ops[0], 3);
    }

    var k: ConstKey;
    k.type_id = type_id; k.lo = lo; k.hi = high; k.id = id;
    vector.push[ConstKey](?tt.consts, k);
    ret id;
}

# the id of the composite constant of type `type_id` over `parts`, emitting it on
# first use
#
# A vector constant has no literal of its own: `OpConstantComposite` names the
# already-minted constant id of each lane, so the caller mints the lanes first.
# Deduplicated on the type plus an exact component-id-sequence match.
# ---
# tt:      the table
# type_id: the composite's result type id
# parts:   the component constant ids
# n:       number of components
# ret:     the OpConstantComposite id, or 0 when the component count is out of range
pub fun const_composite(tt: *TypeTable, type_id: u32, parts: *u32, n: u32) u32 {
    # NO LANE-COUNT CEILING (#2727). It used to stop at sixteen, which was the widest
    # vector the surface could spell rather than anything SPIR-V or this table cared
    # about; a vector may now have any lane count, and the array realization of a
    # shape wider than an OpTypeVector takes an OpConstantComposite too (#2749). So
    # the operand words are an allocation sized by the composite, not a fixed buffer
    # with a refusal in front of it.
    if (n == 0) { ret 0; }

    var i: usize = 0;
    for (i < tt.comps.len) {
        val k: *CompositeKey = ?tt.comps.data[i];
        if (k.type_id == type_id && k.part_count == n && params_equal(k.parts, parts, n)) {
            ret k.id;
        }
        i = i + 1;
    }

    val id: u32 = spirv.alloc_id(tt.b);
    # two fixed words plus one per component
    val ro: R.Result[*u32, str] = A.allocate[u32](tt.b.alloc, (n + 2)::usize);
    if (R.is_err[*u32, str](ro)) { tt.b.err = true; ret id; }
    val ops: *u32 = R.unwrap_ok[*u32, str](ro);
    ops[0] = type_id; ops[1] = id;
    var pi: u32 = 0;
    for (pi < n) { ops[2 + pi] = parts[pi]; pi = pi + 1; }
    spirv.inst(tt.b, ?tt.b.types_consts, spirv.OP_CONSTANT_COMPOSITE, ops, n + 2);
    A.deallocate[u32](tt.b.alloc, ops, (n + 2)::usize);

    var copy: *u32 = nil;
    val rc: R.Result[*u32, str] = A.allocate[u32](tt.b.alloc, n::usize);
    if (R.is_err[*u32, str](rc)) { tt.b.err = true; ret id; }
    copy = R.unwrap_ok[*u32, str](rc);
    var ci: u32 = 0;
    for (ci < n) { copy[ci] = parts[ci]; ci = ci + 1; }

    var k: CompositeKey;
    k.type_id = type_id; k.parts = copy; k.part_count = n; k.id = id;
    vector.push[CompositeKey](?tt.comps, k);
    ret id;
}

# whether a type id names the boolean type this table minted
# ---
# tt: the table
# id: the type id to test
# ret: true only for the OpTypeBool id
pub fun type_is_bool(tt: *TypeTable, id: u32) bool {
    var i: usize = 0;
    for (i < tt.scalars.len) {
        val k: *ScalarKey = ?tt.scalars.data[i];
        if (k.id == id && k.tag == TAG_BOOL) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the id of the boolean constant `value`, emitting it on first use
#
# A SPIR-V boolean has no representation and so no `OpConstant` literal: it is
# spelled `OpConstantTrue` / `OpConstantFalse`. The cache reuses the constant table
# with the bool type id and the value in the low word.
# ---
# tt:    the table
# value: the boolean value
# ret:   the OpConstantTrue / OpConstantFalse id
pub fun const_bool(tt: *TypeTable, value: bool) u32 {
    val type_id: u32 = type_bool(tt);
    var lo: u32 = 0;
    if (value) { lo = 1; }

    var i: usize = 0;
    for (i < tt.consts.len) {
        val k: *ConstKey = ?tt.consts.data[i];
        if (k.type_id == type_id && k.lo == lo && k.hi == 0) { ret k.id; }
        i = i + 1;
    }

    val id: u32 = spirv.alloc_id(tt.b);
    var opcode: u32 = spirv.OP_CONSTANT_FALSE;
    if (value) { opcode = spirv.OP_CONSTANT_TRUE; }
    var ops: [2]u32;
    ops[0] = type_id; ops[1] = id;
    spirv.inst(tt.b, ?tt.b.types_consts, opcode, ?ops[0], 2);

    var k: ConstKey;
    k.type_id = type_id; k.lo = lo; k.hi = 0; k.id = id;
    vector.push[ConstKey](?tt.consts, k);
    ret id;
}

# the id of the zero value of `type_id`, emitting it on first use
#
# `OpConstantNull` is the one form that spells a zero of ANY type - a scalar, a
# vector, an array, a record - which is what an aggregate needs, since a composite
# constant would otherwise have to be built lane by lane and member by member. It
# is cached in the scalar table under its own tag, because a null and an ordinary
# zero constant of the same type are different instructions even where they mean
# the same value.
# ---
# tt:      the table
# type_id: the type the zero belongs to
# ret:     the OpConstantNull id
pub fun const_null(tt: *TypeTable, type_id: u32) u32 {
    val hit: u32 = scalar_find(tt, TAG_NULL, type_id, 0);
    if (hit != 0) { ret hit; }
    val id: u32 = spirv.alloc_id(tt.b);
    var ops: [2]u32;
    ops[0] = type_id; ops[1] = id;
    spirv.inst(tt.b, ?tt.b.types_consts, spirv.OP_CONSTANT_NULL, ?ops[0], 2);
    scalar_put(tt, TAG_NULL, type_id, 0, id);
    ret id;
}

# the id of the integer constant `value` at `bits` width, emitting it on first use
# ---
# tt:    the table
# bits:  the integer width in bits (8, 16, 32, 64)
# value: the constant value (its two's-complement bit pattern for negatives)
# ret:   the OpConstant id
pub fun const_int(tt: *TypeTable, bits: u32, value: i64) u32 {
    ret const_scalar(tt, type_int(tt, bits), pattern_lo(value::u64), pattern_hi(value::u64));
}

# the id of the float constant whose IEEE-754 representation is `pattern`, at
# `bits` precision, emitting it on first use
#
# The caller passes the representation, not a mach `f32` / `f64` value: a float
# constant reaches the emitter from MIR as its already-narrowed bit pattern, and
# routing it through a float-typed temporary would re-round it.
# ---
# tt:      the table
# bits:    the float width in bits (32, 64)
# pattern: the IEEE-754 bit pattern, right-aligned (an f32's in the low 32 bits)
# ret:     the OpConstant id
pub fun const_float(tt: *TypeTable, bits: u32, pattern: u64) u32 {
    ret const_scalar(tt, type_float(tt, bits), pattern_lo(pattern), pattern_hi(pattern));
}

# the low 32 bits of a 64-bit representation
# ---
# v:   the representation
# ret: the low word
fun pattern_lo(v: u64) u32 {
    ret (v & 0xFFFFFFFF)::u32;
}

# the high 32 bits of a 64-bit representation
# ---
# v:   the representation
# ret: the high word
fun pattern_hi(v: u64) u32 {
    ret ((v >> 32) & 0xFFFFFFFF)::u32;
}

test "mach.lang.target.isa.spirv.types:dedup" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var b: spirv.Builder = spirv.builder_init(?alloc);
    var tt: TypeTable = types_init(?b);

    # a repeated width returns the same id and emits one OpTypeInt.
    val i32a: u32 = type_int(?tt, 32);
    val i32b: u32 = type_int(?tt, 32);
    if (i32a != i32b) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (tt.scalars.len != 1) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    # a different width mints a new id.
    val i64a: u32 = type_int(?tt, 64);
    if (i64a == i32a) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    # constants dedup by (type, value).
    val c1: u32 = const_int(?tt, 32, 7);
    val c2: u32 = const_int(?tt, 32, 7);
    val c3: u32 = const_int(?tt, 32, 8);
    if (c1 != c2) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (c1 == c3) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    types_dnit(?tt);
    spirv.builder_dnit(?b);
    ret 0;
}

test "mach.lang.target.isa.spirv.types:vector_shapes_and_limit" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var b: spirv.Builder = spirv.builder_init(?alloc);
    var tt: TypeTable = types_init(?b);

    val f32t: u32 = type_float(?tt, 32);
    val v4f: u32 = type_vector(?tt, f32t, 4);
    if (v4f == 0) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    # the same shape interns once.
    if (type_vector(?tt, f32t, 4) != v4f) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    # a different lane count is a different type, as is a different component type.
    if (type_vector(?tt, f32t, 2) == v4f) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (type_vector(?tt, type_int(?tt, 32), 4) == v4f) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    # the shape is recoverable from the id alone.
    var count: u32 = 0;
    if (vector_shape(?tt, v4f, ?count) != f32t) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (count != 4) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    # a scalar is not a vector, and says so rather than reporting a bogus shape.
    if (vector_shape(?tt, f32t, ?count) != 0) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (count != 0) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    # mach's four narrow-lane vectors need 8 and 16 components, which a Shader
    # module may not declare; the table refuses rather than minting a type only a
    # Kernel module could carry.
    if (type_vector(?tt, type_int(?tt, 8), 16) != 0)  { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (type_vector(?tt, type_int(?tt, 16), 8) != 0)  { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    # a 1-component "vector" is not a vector either.
    if (type_vector(?tt, f32t, 1) != 0) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    # a composite constant interns on its component ids, and a different lane value
    # is a different constant.
    val one: u32 = const_float(?tt, 32, 0x3F800000);
    val two: u32 = const_float(?tt, 32, 0x40000000);
    var p1: [4]u32; p1[0] = one; p1[1] = one; p1[2] = one; p1[3] = one;
    var p2: [4]u32; p2[0] = one; p2[1] = one; p2[2] = one; p2[3] = two;
    val c1: u32 = const_composite(?tt, v4f, ?p1[0], 4);
    if (c1 == 0) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (const_composite(?tt, v4f, ?p1[0], 4) != c1) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (const_composite(?tt, v4f, ?p2[0], 4) == c1) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    types_dnit(?tt);
    spirv.builder_dnit(?b);
    ret 0;
}

test "mach.lang.target.isa.spirv.types:image_identity_is_every_operand" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var b: spirv.Builder = spirv.builder_init(?alloc);
    var tt: TypeTable = types_init(?b);

    val f32t: u32 = type_float(?tt, 32);
    val i32t: u32 = type_int(?tt, 32);
    val base: u32 = type_image(?tt, f32t, spirv.DIM_2D, 0, 0, 0, spirv.IMAGE_SAMPLED_YES);
    if (base == 0) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    # the same shape interns once.
    if (type_image(?tt, f32t, spirv.DIM_2D, 0, 0, 0, spirv.IMAGE_SAMPLED_YES) != base) {
        types_dnit(?tt); spirv.builder_dnit(?b); ret 1;
    }

    # EVERY OPERAND SEPARATES. Each of these differs from `base` in exactly one
    # operand, and each must be its own type: an image type interned on a subset of
    # its operands hands two different images one id, and the module then binds one
    # descriptor where the program declared two - which validates clean (#2794).
    if (type_image(?tt, i32t, spirv.DIM_2D, 0, 0, 0, spirv.IMAGE_SAMPLED_YES) == base) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (type_image(?tt, f32t, spirv.DIM_3D, 0, 0, 0, spirv.IMAGE_SAMPLED_YES) == base) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (type_image(?tt, f32t, spirv.DIM_2D, 1, 0, 0, spirv.IMAGE_SAMPLED_YES) == base) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (type_image(?tt, f32t, spirv.DIM_2D, 0, 1, 0, spirv.IMAGE_SAMPLED_YES) == base) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (type_image(?tt, f32t, spirv.DIM_2D, 0, 0, 1, spirv.IMAGE_SAMPLED_YES) == base) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (type_image(?tt, f32t, spirv.DIM_2D, 0, 0, 0, 2) == base)                       { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    # a sampled image is a DIFFERENT type from the image it wraps, and wraps by id.
    val si: u32 = type_sampled_image(?tt, base);
    if (si == 0 || si == base) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (type_sampled_image(?tt, base) != si) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    val other: u32 = type_image(?tt, f32t, spirv.DIM_3D, 0, 0, 0, spirv.IMAGE_SAMPLED_YES);
    if (type_sampled_image(?tt, other) == si) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    # a sampler is one type per module and is neither of the two.
    val smp: u32 = type_sampler(?tt);
    if (smp == 0 || smp == base || smp == si) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (type_sampler(?tt) != smp) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    # all three are opaque and no ordinary type is, which is what decides whether a
    # value may be stored into a backing variable at all.
    if (!type_is_opaque(?tt, base)) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (!type_is_opaque(?tt, si))   { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (!type_is_opaque(?tt, smp))  { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (type_is_opaque(?tt, f32t))  { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (type_is_opaque(?tt, type_vector(?tt, f32t, 4))) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    types_dnit(?tt);
    spirv.builder_dnit(?b);
    ret 0;
}

test "mach.lang.target.isa.spirv.types:image_dim_declares_its_capability" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var b: spirv.Builder = spirv.builder_init(?alloc);
    var tt: TypeTable = types_init(?b);

    val f32t: u32 = type_float(?tt, 32);
    # a 2D image needs nothing past Shader.
    type_image(?tt, f32t, spirv.DIM_2D, 0, 0, 0, spirv.IMAGE_SAMPLED_YES);
    if ((b.caps_needed & spirv.NEED_SAMPLED_1D) != 0)         { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if ((b.caps_needed & spirv.NEED_SAMPLED_CUBE_ARRAY) != 0) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    # a 1D one does, and says so at the DECLARATION rather than at a use, so a
    # handle bound and never sampled still declares what it requires.
    type_image(?tt, f32t, spirv.DIM_1D, 0, 0, 0, spirv.IMAGE_SAMPLED_YES);
    if ((b.caps_needed & spirv.NEED_SAMPLED_1D) == 0) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    # a plain cube needs nothing; an ARRAYED cube does. run the same shape twice
    # varying only arrayedness, or the assertion is about cubes rather than about
    # the pair.
    var b2: spirv.Builder = spirv.builder_init(?alloc);
    var t2: TypeTable = types_init(?b2);
    type_image(?t2, type_float(?t2, 32), spirv.DIM_CUBE, 0, 0, 0, spirv.IMAGE_SAMPLED_YES);
    if ((b2.caps_needed & spirv.NEED_SAMPLED_CUBE_ARRAY) != 0) { types_dnit(?t2); spirv.builder_dnit(?b2); types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    type_image(?t2, type_float(?t2, 32), spirv.DIM_CUBE, 0, 1, 0, spirv.IMAGE_SAMPLED_YES);
    if ((b2.caps_needed & spirv.NEED_SAMPLED_CUBE_ARRAY) == 0) { types_dnit(?t2); spirv.builder_dnit(?b2); types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    types_dnit(?t2); spirv.builder_dnit(?b2);
    types_dnit(?tt); spirv.builder_dnit(?b);
    ret 0;
}

test "mach.lang.target.isa.spirv.types:array_layout_identity" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var b: spirv.Builder = spirv.builder_init(?alloc);
    var tt: TypeTable = types_init(?b);

    val v4f: u32 = type_vector(?tt, type_float(?tt, 32), 4);

    # a plain array interns: the same shape asked for twice is one type.
    val a1: u32 = type_array(?tt, v4f, 4, false);
    if (a1 == 0) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (type_array(?tt, v4f, 4, false) != a1) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    # a different length is a different type.
    if (type_array(?tt, v4f, 2, false) == a1) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    # an explicitly-laid-out array must NOT share the interned id: it carries an
    # ArrayStride decoration and the plain one must not, so one id cannot serve both.
    val laid: u32 = type_array(?tt, v4f, 4, true);
    if (laid == 0 || laid == a1) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    # nor may two laid-out arrays share, since their strides may differ.
    if (type_array(?tt, v4f, 4, true) == laid) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    # and minting a laid-out array must not poison the interned cache.
    if (type_array(?tt, v4f, 4, false) != a1) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    # a zero-length array is not a type SPIR-V has.
    if (type_array(?tt, v4f, 0, false) != 0) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    types_dnit(?tt);
    spirv.builder_dnit(?b);
    ret 0;
}

test "mach.lang.target.isa.spirv.types:const_keyed_by_type" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var b: spirv.Builder = spirv.builder_init(?alloc);
    var tt: TypeTable = types_init(?b);

    # 1.5f32 and the i32 holding its bit pattern are the same two literal words
    # under different types: keying on the pattern alone would alias them, and the
    # float function would return an integer-typed id a validator rejects.
    val f: u32 = const_float(?tt, 32, 0x3FC00000);
    val i: u32 = const_int(?tt, 32, 0x3FC00000);
    if (f == i) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    # the same float constant asked for twice is one id.
    if (const_float(?tt, 32, 0x3FC00000) != f) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    # the table can describe what it minted, so a caller holding only an id can
    # size a literal without carrying the width alongside it.
    if (type_bits(?tt, type_float(?tt, 32)) != 32)   { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (type_bits(?tt, type_int(?tt, 64)) != 64)     { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (!type_is_float(?tt, type_float(?tt, 64)))    { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (type_is_float(?tt, type_int(?tt, 32)))       { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    if (type_bits(?tt, type_bool(?tt)) != 0)         { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }

    # a 64-bit constant carries its high word; a 32-bit one must not, or the
    # instruction's word count disagrees with its operands.
    val d: u32 = const_float(?tt, 64, 0x3FF8000000000000);
    if (d == f) { types_dnit(?tt); spirv.builder_dnit(?b); ret 1; }
    # the same low word at 32 bits is a different constant, not a truncated hit.
    if (const_float(?tt, 32, 0x00000000) == const_float(?tt, 64, 0x0000000000000000)) {
        types_dnit(?tt); spirv.builder_dnit(?b); ret 1;
    }

    types_dnit(?tt);
    spirv.builder_dnit(?b);
    ret 0;
}
