use mach.lang.fail;
use mach.lang.float;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;

use catalog_arch: mach.lang.target.catalog.arch;
use mach.lang.target.isa;
use isa_spirv: mach.lang.target.isa.spirv;
use mach.lang.target.isa.spirv.defs;
use spirv_emit: mach.lang.target.isa.spirv.emit;
use mach.lang.target.isa.spirv.types;
use target_model: mach.lang.target.model;

pub fun register_spirv(reg: *isa.IsaRegistry) err[fail.Fail] {
    var spirv_model: target_model.Machine;
    var def_storage: defs.DefStorage;

    spirv_model.pointer_width       = 8;
    spirv_model.gpr_width           = 8;
    spirv_model.gp_unaligned_widths = 0;
    spirv_model.spill_width         = 8;
    spirv_model.endianness          = target_model.ENDIAN_LITTLE;
    spirv_model.reg_classes         = nil;
    spirv_model.reg_class_len       = 0;
    spirv_model.frame_ptr_reg       = -1;
    spirv_model.stack_ptr_reg       = -1;
    spirv_model.reserved_regs       = nil;
    spirv_model.reserved_len        = 0;
    spirv_model.div_reg             = -1;
    spirv_model.div_hi_reg          = -1;
    spirv_model.shift_count_reg     = -1;
    spirv_model.incoming_arg_base   = 0;
    spirv_model.stack_align         = 0;
    spirv_model.red_zone            = 0;
    spirv_model.shadow_space        = 0;
    spirv_model.flen_bits           = 64;
    spirv_model.has_v128            = true;
    spirv_model.vector_bits         = target_model.VECTOR_BITS_128;
    spirv_model.max_vector_lanes    = types.MAX_VECTOR_COMPONENTS;
    spirv_model.vec_mem_widths      = target_model.VEC_MEM_NONE;
    # an integer narrower than 32 bits computes at its own width only where the
    # target declares its device feature, and is otherwise carried at 32 bits,
    # which needs none
    target_model.declare_alu_widths(?spirv_model, target_model.ALU_WIDTHS_4_8);
    target_model.gate_alu_width(?spirv_model, 1, isa_spirv.EXT_INT8);
    target_model.gate_alu_width(?spirv_model, 2, isa_spirv.EXT_INT16);
    # OpBitcast reinterprets any scalar as another of its width, an f16 as the
    # 16-bit integer its expansion carries among them
    spirv_model.xbank_widths     = target_model.XBANK_2_4_8;
    spirv_model.slot_read_widths = target_model.SLOT_READ_NONE;
    spirv_model.lifetime_holes   = false;

    # OpFConvert leaves a NaN's payload unspecified, so comptime folds to the canonical NaN
    spirv_model.nan_rule          = float.NAN_CANONICAL;
    spirv_model.nan_first_operand = false;

    var spirv_packed_forms: [93]target_model.PackedForm;
    spirv_packed_forms[0]  = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[1]  = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[2]  = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[3]  = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[4]  = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[5]  = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[6]  = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[7]  = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[8]  = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[9]  = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[10] = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[11] = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[12] = target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[13] = target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[14] = target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[15] = target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[16] = target_model.PackedForm{op: target_model.VEC_OP_AND, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[17] = target_model.PackedForm{op: target_model.VEC_OP_AND, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[18] = target_model.PackedForm{op: target_model.VEC_OP_AND, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[19] = target_model.PackedForm{op: target_model.VEC_OP_AND, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[20] = target_model.PackedForm{op: target_model.VEC_OP_OR, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[21] = target_model.PackedForm{op: target_model.VEC_OP_OR, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[22] = target_model.PackedForm{op: target_model.VEC_OP_OR, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[23] = target_model.PackedForm{op: target_model.VEC_OP_OR, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[24] = target_model.PackedForm{op: target_model.VEC_OP_XOR, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[25] = target_model.PackedForm{op: target_model.VEC_OP_XOR, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[26] = target_model.PackedForm{op: target_model.VEC_OP_XOR, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[27] = target_model.PackedForm{op: target_model.VEC_OP_XOR, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[28] = target_model.PackedForm{op: target_model.VEC_OP_NOT, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[29] = target_model.PackedForm{op: target_model.VEC_OP_NOT, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[30] = target_model.PackedForm{op: target_model.VEC_OP_NOT, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[31] = target_model.PackedForm{op: target_model.VEC_OP_NOT, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[32] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[33] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[34] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[35] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[36] = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: true, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[37] = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: true, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[38] = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: true, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[39] = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: true, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[40] = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[41] = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[42] = target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: true, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[43] = target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: true, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[44] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[45] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 64, from_bits: 64};
    # OpSConvert and OpUConvert change an integer lane's width exactly; a float
    # conversion's rounding, NaN and out-of-range results are left to the
    # implementation, so those cells stay the scalar expansion of the same op
    spirv_packed_forms[46] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 16, from_bits: 8};
    spirv_packed_forms[47] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 8};
    spirv_packed_forms[48] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 8};
    spirv_packed_forms[49] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 16};
    spirv_packed_forms[50] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 16};
    spirv_packed_forms[51] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 32};
    spirv_packed_forms[52] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 16, from_bits: 8};
    spirv_packed_forms[53] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 32, from_bits: 8};
    spirv_packed_forms[54] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 8};
    spirv_packed_forms[55] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 32, from_bits: 16};
    spirv_packed_forms[56] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 16};
    spirv_packed_forms[57] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 32};
    spirv_packed_forms[58] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 16};
    spirv_packed_forms[59] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 32};
    spirv_packed_forms[60] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 64};
    spirv_packed_forms[61] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 16, from_bits: 32};
    spirv_packed_forms[62] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 16, from_bits: 64};
    spirv_packed_forms[63] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 32, from_bits: 64};
    # f16 lanes compute as the core float instructions on f16 vectors under the
    # Float16 capability, as the scalar half rows do; their conversions follow
    # the other float conversions and stay each lane's scalar one
    spirv_packed_forms[64] = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16};
    spirv_packed_forms[65] = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16};
    spirv_packed_forms[66] = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16};
    spirv_packed_forms[67] = target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16};
    spirv_packed_forms[68] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16};
    # every shift cell packs. OpShift* leaves a component shifted by
    # its width or more undefined, so each lane's shift is kept where its
    # count is below the width (OpULessThan) and replaced otherwise
    # (OpSelect) by 0, or for an arithmetic shift by the shift by width - 1,
    # the sign fill the scalar shift saturates to. a uniform count is
    # splatted first, since OpShift* takes a count per component
    spirv_packed_forms[69]      = target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[70]      = target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[71]      = target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[72]      = target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[73]      = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[74]      = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[75]      = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[76]      = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[77]      = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[78]      = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[79]      = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[80]      = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[81]      = target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[82]      = target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[83]      = target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[84]      = target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[85]      = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[86]      = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[87]      = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[88]      = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[89]      = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[90]      = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[91]      = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[92]      = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_model.packed_forms    = ?spirv_packed_forms[0];
    spirv_model.packed_form_len = 93;
    # f16 is the native OpTypeFloat 16 under the Float16 capability, which an
    # environment guarantees from vulkan1.2 and a module naming none may use. the arithmetic,
    # negation, comparisons and conversions are the core float instructions at 16 bits,
    # rounded and propagating a NaN by the execution environment's float rules,
    # as every float width here is
    var spirv_half_forms: [18]target_model.PackedForm = [18]target_model.PackedForm{
        target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
        target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
        target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
        target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
        target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
        target_model.PackedForm{op: target_model.VEC_OP_NEG, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
        target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 32, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
        target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 64, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
        target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 32, ext: isa_spirv.EXT_FLOAT16},
        target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 64, ext: isa_spirv.EXT_FLOAT16},
        target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 32, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
        target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 64, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
        target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 32, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
        target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 64, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
        target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 16, from_bits: 32, ext: isa_spirv.EXT_FLOAT16},
        target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 16, from_bits: 64, ext: isa_spirv.EXT_FLOAT16},
        target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 16, from_bits: 32, ext: isa_spirv.EXT_FLOAT16},
        target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 16, from_bits: 64, ext: isa_spirv.EXT_FLOAT16},
    };
    spirv_model.half_forms    = ?spirv_half_forms[0];
    spirv_model.half_form_len = 18;
    # without float16 the expansion needs neither int64 nor float64
    spirv_model.half_binary32 = true;
    # a widening multiply stays the packed extension and multiply it is
    # written as, and every shift cell is packed above
    # a lane range or join is its lanes rebuilt with OpCompositeConstruct
    val spirv_rows: err[fail.Fail] = isa.declare_scalar_rows(reg, ?spirv_model, nil, 0,
        target_model.SCALAR_CONVERSIONS | target_model.SCALAR_WIDENING | target_model.SCALAR_SHIFTS | target_model.SCALAR_PERMUTES | target_model.SCALAR_HALF_LANES);
    if (sel spirv_rows.err) { ret spirv_rows; }
    fin { isa.release_scalar_rows(reg, ?spirv_model); }
    spirv_model.vector_compute_generic  = true;
    spirv_model.has_lane_ops            = true;
    spirv_model.has_vec_build           = true;
    spirv_model.ct_mul_forms            = nil;
    spirv_model.extensions              = 0;
    spirv_model.extension_table         = ?isa_spirv.EXTENSIONS[0];
    spirv_model.extension_count         = isa_spirv.EXTENSION_COUNT;
    spirv_model.ct_mul_form_len         = 0;
    spirv_model.has_var_shift           = true;
    spirv_model.shift_count_mod_widths  = target_model.SHIFT_MOD_NONE;
    spirv_model.has_mul                 = true;
    spirv_model.has_float               = true;
    spirv_model.mul_hi_width            = 0;
    spirv_model.int_widths              = target_model.INT_WIDTHS_1_2_4_8;
    spirv_model.mul_wide_form           = target_model.MULW_NONE;
    spirv_model.flat_addressing         = false;
    spirv_model.indexed_memory          = false;
    spirv_model.sym_offset_bits         = 0;
    spirv_model.mem_disp_bits           = 0;
    spirv_model.function_align          = 0;
    spirv_model.code_fill               = 0;
    spirv_model.structured_control_flow = true;
    spirv_model.index_width             = 32;
    spirv_model.vector_op_bytes         = 16;
    spirv_model.vectors_in_registers    = false;
    spirv_model.auto_vectorize          = false;
    spirv_model.ct_trust_var_shift      = false;

    var spirv_envs: [4]isa.Environment;
    var ei:         u32 = 0;
    for (ei < isa_spirv.ENV_PROFILE_COUNT) {
        spirv_envs[ei].name       = isa_spirv.env_profile_name(ei);
        spirv_envs[ei].profile    = ei;
        spirv_envs[ei].extensions = isa_spirv.env_extensions(ei);
        ei                        = ei + 1;
    }

    var spirv_emitter: isa.ModuleEmitter = isa.module_emitter(spirv_emit.emit_module, false);
    var spirv_vtable:  isa.IsaVTable     = isa.emitter_isa(
        isa.ARCH_SPIRV, catalog_arch.name_for(isa.ARCH_SPIRV), 8,
        ?spirv_model, ?spirv_emitter);

    isa.with_defs(?spirv_vtable, defs.register_defs(?def_storage));
    # a module naming no environment has no ceiling, so every extension is open to it
    isa.with_environments(?spirv_vtable, ?spirv_envs[0], isa_spirv.ENV_PROFILE_COUNT, isa_spirv.EXT_OPEN);

    ret isa.register(reg, ?spirv_vtable);
}
