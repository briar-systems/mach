use mach.lang.fail;
use mach.lang.float;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;

use mach.lang.target.isa;
use mach.lang.target.isa.spirv;
use mach.lang.target.isa.spirv.defs;
use mach.lang.target.isa.spirv.emit;
use mach.lang.target.isa.spirv.types;

pub fun register_spirv(reg: *isa.IsaRegistry) err[fail.Fail] {
    var spirv_model: isa.MachineModel;
    var def_storage: defs.DefStorage;

    spirv_model.pointer_width       = 8;
    spirv_model.gpr_width           = 8;
    spirv_model.gp_unaligned_widths = 0;
    spirv_model.spill_width         = 8;
    spirv_model.alu_min_width       = 1;
    spirv_model.endianness          = isa.ENDIAN_LITTLE;
    spirv_model.reg_classes         = nil;
    spirv_model.reg_class_len       = 0;
    spirv_model.frame_ptr_reg       = -1;
    spirv_model.stack_ptr_reg       = -1;
    spirv_model.reserved_regs       = nil;
    spirv_model.reserved_len        = 0;
    spirv_model.div_reg             = -1;
    spirv_model.div_hi_reg          = -1;
    spirv_model.shift_count_reg     = -1;
    spirv_model.incoming_arg_base   = 0;
    spirv_model.stack_align         = 0;
    spirv_model.red_zone            = 0;
    spirv_model.shadow_space        = 0;
    spirv_model.flen_bits           = 64;
    spirv_model.has_v128            = true;
    spirv_model.vector_bits         = isa.VECTOR_BITS_128;
    spirv_model.max_vector_lanes    = types.MAX_VECTOR_COMPONENTS;
    spirv_model.vec_mem_widths      = isa.VEC_MEM_NONE;
    # OpBitcast reinterprets any scalar as another of its width, an f16 as the
    # 16-bit integer its expansion carries among them
    spirv_model.xbank_widths     = isa.XBANK_2_4_8;
    spirv_model.slot_read_widths = isa.SLOT_READ_NONE;
    spirv_model.lifetime_holes   = false;

    # OpFConvert leaves a NaN's payload unspecified, so comptime folds to the canonical NaN
    spirv_model.nan_rule          = float.NAN_CANONICAL;
    spirv_model.nan_first_operand = false;

    var spirv_packed_forms: [93]isa.PackedForm;
    spirv_packed_forms[0]  = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[1]  = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[2]  = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[3]  = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[4]  = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[5]  = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[6]  = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[7]  = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[8]  = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[9]  = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[10] = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[11] = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[12] = isa.PackedForm{op: isa.VEC_OP_DIV, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[13] = isa.PackedForm{op: isa.VEC_OP_DIV, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[14] = isa.PackedForm{op: isa.VEC_OP_DIV, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[15] = isa.PackedForm{op: isa.VEC_OP_DIV, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[16] = isa.PackedForm{op: isa.VEC_OP_AND, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[17] = isa.PackedForm{op: isa.VEC_OP_AND, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[18] = isa.PackedForm{op: isa.VEC_OP_AND, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[19] = isa.PackedForm{op: isa.VEC_OP_AND, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[20] = isa.PackedForm{op: isa.VEC_OP_OR, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[21] = isa.PackedForm{op: isa.VEC_OP_OR, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[22] = isa.PackedForm{op: isa.VEC_OP_OR, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[23] = isa.PackedForm{op: isa.VEC_OP_OR, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[24] = isa.PackedForm{op: isa.VEC_OP_XOR, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[25] = isa.PackedForm{op: isa.VEC_OP_XOR, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[26] = isa.PackedForm{op: isa.VEC_OP_XOR, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[27] = isa.PackedForm{op: isa.VEC_OP_XOR, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[28] = isa.PackedForm{op: isa.VEC_OP_NOT, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[29] = isa.PackedForm{op: isa.VEC_OP_NOT, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[30] = isa.PackedForm{op: isa.VEC_OP_NOT, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[31] = isa.PackedForm{op: isa.VEC_OP_NOT, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[32] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[33] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[34] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[35] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[36] = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: true, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[37] = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: true, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[38] = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: true, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[39] = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: true, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[40] = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: true, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[41] = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: true, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[42] = isa.PackedForm{op: isa.VEC_OP_DIV, is_float: true, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[43] = isa.PackedForm{op: isa.VEC_OP_DIV, is_float: true, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[44] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: true, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[45] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: true, lane_bits: 64, from_bits: 64};
    # OpSConvert and OpUConvert change an integer lane's width exactly; a float
    # conversion's rounding, NaN and out-of-range results are left to the
    # implementation, so those cells stay the scalar expansion of the same op
    spirv_packed_forms[46] = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 16, from_bits: 8};
    spirv_packed_forms[47] = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 8};
    spirv_packed_forms[48] = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 8};
    spirv_packed_forms[49] = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 16};
    spirv_packed_forms[50] = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 16};
    spirv_packed_forms[51] = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 32};
    spirv_packed_forms[52] = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 16, from_bits: 8};
    spirv_packed_forms[53] = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 32, from_bits: 8};
    spirv_packed_forms[54] = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 8};
    spirv_packed_forms[55] = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 32, from_bits: 16};
    spirv_packed_forms[56] = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 16};
    spirv_packed_forms[57] = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 32};
    spirv_packed_forms[58] = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 16};
    spirv_packed_forms[59] = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 32};
    spirv_packed_forms[60] = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 64};
    spirv_packed_forms[61] = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 16, from_bits: 32};
    spirv_packed_forms[62] = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 16, from_bits: 64};
    spirv_packed_forms[63] = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 32, from_bits: 64};
    # f16 lanes compute as the core float instructions on f16 vectors under the
    # Float16 capability, as the scalar half rows do; their conversions follow
    # the other float conversions and stay each lane's scalar one (#3802)
    spirv_packed_forms[64] = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: true, lane_bits: 16, from_bits: 16, ext: spirv.EXT_FLOAT16};
    spirv_packed_forms[65] = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: true, lane_bits: 16, from_bits: 16, ext: spirv.EXT_FLOAT16};
    spirv_packed_forms[66] = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: true, lane_bits: 16, from_bits: 16, ext: spirv.EXT_FLOAT16};
    spirv_packed_forms[67] = isa.PackedForm{op: isa.VEC_OP_DIV, is_float: true, lane_bits: 16, from_bits: 16, ext: spirv.EXT_FLOAT16};
    spirv_packed_forms[68] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: true, lane_bits: 16, from_bits: 16, ext: spirv.EXT_FLOAT16};
    # every shift cell packs (#3852). OpShift* leaves a component shifted by
    # its width or more undefined, so each lane's shift is kept where its
    # count is below the width (OpULessThan) and replaced otherwise
    # (OpSelect) by 0, or for an arithmetic shift by the shift by width - 1,
    # the sign fill the scalar shift saturates to (#3756). a uniform count is
    # splatted first, since OpShift* takes a count per component
    spirv_packed_forms[69]      = isa.PackedForm{op: isa.VEC_OP_SHL_U, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[70]      = isa.PackedForm{op: isa.VEC_OP_SHL_U, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[71]      = isa.PackedForm{op: isa.VEC_OP_SHL_U, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[72]      = isa.PackedForm{op: isa.VEC_OP_SHL_U, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[73]      = isa.PackedForm{op: isa.VEC_OP_SHR_U_U, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[74]      = isa.PackedForm{op: isa.VEC_OP_SHR_U_U, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[75]      = isa.PackedForm{op: isa.VEC_OP_SHR_U_U, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[76]      = isa.PackedForm{op: isa.VEC_OP_SHR_U_U, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[77]      = isa.PackedForm{op: isa.VEC_OP_SHR_S_U, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[78]      = isa.PackedForm{op: isa.VEC_OP_SHR_S_U, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[79]      = isa.PackedForm{op: isa.VEC_OP_SHR_S_U, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[80]      = isa.PackedForm{op: isa.VEC_OP_SHR_S_U, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[81]      = isa.PackedForm{op: isa.VEC_OP_SHL_V, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[82]      = isa.PackedForm{op: isa.VEC_OP_SHL_V, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[83]      = isa.PackedForm{op: isa.VEC_OP_SHL_V, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[84]      = isa.PackedForm{op: isa.VEC_OP_SHL_V, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[85]      = isa.PackedForm{op: isa.VEC_OP_SHR_U_V, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[86]      = isa.PackedForm{op: isa.VEC_OP_SHR_U_V, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[87]      = isa.PackedForm{op: isa.VEC_OP_SHR_U_V, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[88]      = isa.PackedForm{op: isa.VEC_OP_SHR_U_V, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_packed_forms[89]      = isa.PackedForm{op: isa.VEC_OP_SHR_S_V, is_float: false, lane_bits: 8, from_bits: 8};
    spirv_packed_forms[90]      = isa.PackedForm{op: isa.VEC_OP_SHR_S_V, is_float: false, lane_bits: 16, from_bits: 16};
    spirv_packed_forms[91]      = isa.PackedForm{op: isa.VEC_OP_SHR_S_V, is_float: false, lane_bits: 32, from_bits: 32};
    spirv_packed_forms[92]      = isa.PackedForm{op: isa.VEC_OP_SHR_S_V, is_float: false, lane_bits: 64, from_bits: 64};
    spirv_model.packed_forms    = ?spirv_packed_forms[0];
    spirv_model.packed_form_len = 93;
    # f16 is the native OpTypeFloat 16 under the Float16 capability, which an
    # environment guarantees from vulkan1.2 and a module naming none may use (#3801). the arithmetic,
    # comparisons and conversions are the core float instructions at 16 bits,
    # rounded and propagating a NaN by the execution environment's float rules,
    # as every float width here is
    var spirv_half_forms: [17]isa.PackedForm = [17]isa.PackedForm{
        isa.PackedForm{op: isa.VEC_OP_ADD, is_float: true, lane_bits: 16, from_bits: 16, ext: spirv.EXT_FLOAT16},
        isa.PackedForm{op: isa.VEC_OP_SUB, is_float: true, lane_bits: 16, from_bits: 16, ext: spirv.EXT_FLOAT16},
        isa.PackedForm{op: isa.VEC_OP_MUL, is_float: true, lane_bits: 16, from_bits: 16, ext: spirv.EXT_FLOAT16},
        isa.PackedForm{op: isa.VEC_OP_DIV, is_float: true, lane_bits: 16, from_bits: 16, ext: spirv.EXT_FLOAT16},
        isa.PackedForm{op: isa.VEC_OP_CMP, is_float: true, lane_bits: 16, from_bits: 16, ext: spirv.EXT_FLOAT16},
        isa.PackedForm{op: isa.VEC_OP_FP_EXT, is_float: true, lane_bits: 32, from_bits: 16, ext: spirv.EXT_FLOAT16},
        isa.PackedForm{op: isa.VEC_OP_FP_EXT, is_float: true, lane_bits: 64, from_bits: 16, ext: spirv.EXT_FLOAT16},
        isa.PackedForm{op: isa.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 32, ext: spirv.EXT_FLOAT16},
        isa.PackedForm{op: isa.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 64, ext: spirv.EXT_FLOAT16},
        isa.PackedForm{op: isa.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 32, from_bits: 16, ext: spirv.EXT_FLOAT16},
        isa.PackedForm{op: isa.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 64, from_bits: 16, ext: spirv.EXT_FLOAT16},
        isa.PackedForm{op: isa.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 32, from_bits: 16, ext: spirv.EXT_FLOAT16},
        isa.PackedForm{op: isa.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 64, from_bits: 16, ext: spirv.EXT_FLOAT16},
        isa.PackedForm{op: isa.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 16, from_bits: 32, ext: spirv.EXT_FLOAT16},
        isa.PackedForm{op: isa.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 16, from_bits: 64, ext: spirv.EXT_FLOAT16},
        isa.PackedForm{op: isa.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 16, from_bits: 32, ext: spirv.EXT_FLOAT16},
        isa.PackedForm{op: isa.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 16, from_bits: 64, ext: spirv.EXT_FLOAT16},
    };
    spirv_model.half_forms    = ?spirv_half_forms[0];
    spirv_model.half_form_len = 17;
    # a widening multiply stays the packed extension and multiply it is
    # written as, and every shift cell is packed above
    var spirv_scalar_forms: [109]isa.ScalarForm;
    val spirv_conversions:  u32 = isa.scalar_conversion_rows(?spirv_model, ?spirv_scalar_forms[0], 0);
    val spirv_widening:     u32 = spirv_conversions + isa.scalar_widening_rows(?spirv_model, ?spirv_scalar_forms[0], spirv_conversions);
    spirv_model.scalar_forms = ?spirv_scalar_forms[0];
    val spirv_shifts: u32 = spirv_widening + isa.scalar_shift_rows(?spirv_model, ?spirv_scalar_forms[0], spirv_widening);
    # a lane range or join is its lanes rebuilt with OpCompositeConstruct
    val spirv_permutes: u32 = spirv_shifts + isa.scalar_permute_rows(?spirv_model, ?spirv_scalar_forms[0], spirv_shifts);
    spirv_model.scalar_form_len         = spirv_permutes + isa.scalar_half_lane_rows(?spirv_model, ?spirv_scalar_forms[0], spirv_permutes);
    spirv_model.vector_compute_generic  = true;
    spirv_model.has_lane_ops            = true;
    spirv_model.has_vec_build           = true;
    spirv_model.ct_mul_forms            = nil;
    spirv_model.extensions              = 0;
    spirv_model.extension_table         = ?spirv.EXTENSIONS[0];
    spirv_model.extension_count         = spirv.EXTENSION_COUNT;
    spirv_model.ct_mul_form_len         = 0;
    spirv_model.has_var_shift           = true;
    spirv_model.shift_count_mod_widths  = isa.SHIFT_MOD_NONE;
    spirv_model.has_mul                 = true;
    spirv_model.has_float               = true;
    spirv_model.mul_hi_width            = 0;
    spirv_model.int_widths              = isa.INT_WIDTHS_1_2_4_8;
    spirv_model.mul_wide_form           = isa.MULW_NONE;
    spirv_model.flat_addressing         = false;
    spirv_model.indexed_memory          = false;
    spirv_model.sym_offset_bits         = 0;
    spirv_model.mem_disp_bits           = 0;
    spirv_model.structured_control_flow = true;
    spirv_model.index_width             = 32;
    spirv_model.vector_op_bytes         = 16;
    spirv_model.vectors_in_registers    = false;
    spirv_model.auto_vectorize          = false;
    spirv_model.ct_trust_var_shift      = false;

    var spirv_envs: [4]isa.Environment;
    var ei:         u32 = 0;
    for (ei < spirv.ENV_PROFILE_COUNT) {
        spirv_envs[ei].name       = spirv.env_profile_name(ei);
        spirv_envs[ei].profile    = ei;
        spirv_envs[ei].extensions = spirv.env_extensions(ei);
        ei                        = ei + 1;
    }

    var spirv_emitter: isa.ModuleEmitter = isa.module_emitter(emit.emit_module, false);
    var spirv_vtable:  isa.IsaVTable     = isa.emitter_isa(
        isa.ARCH_SPIRV, isa.arch_name_for(isa.ARCH_SPIRV), 8,
        ?spirv_model, ?spirv_emitter);

    isa.with_defs(?spirv_vtable, defs.register_defs(?def_storage));
    # a module naming no environment has no ceiling, so every capability is open to it
    isa.with_environments(?spirv_vtable, ?spirv_envs[0], spirv.ENV_PROFILE_COUNT, spirv.EXT_FLOAT16);

    ret isa.register(reg, ?spirv_vtable);
}
