    target_model.PackedForm{op: target_model.VEC_OP_AND, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_AND, is_float: false, lane_bits: 16, from_bits: 16},
