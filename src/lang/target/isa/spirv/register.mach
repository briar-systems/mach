    target_model.PackedForm{op: target_model.VEC_OP_NOT, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_NOT, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_NOT, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: true, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: true, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: true, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: true, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: true, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: true, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 64, from_bits: 64},
    # OpSConvert and OpUConvert change an integer lane's width exactly; a float
    # conversion's rounding, NaN and out-of-range results are left to the
    # implementation, so those cells stay the scalar expansion of the same op
    target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 16, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 16, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 32, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 32, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 16, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 16, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 32, from_bits: 64},
    # f16 lanes compute as the core float instructions on f16 vectors under the
    # Float16 capability, as the scalar half rows do; their conversions follow
    # the other float conversions and stay each lane's scalar one
    target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
    # every shift cell packs. OpShift* leaves a component shifted by
    # its width or more undefined, so each lane's shift is kept where its
    # count is below the width (OpULessThan) and replaced otherwise
    # (OpSelect) by 0, or for an arithmetic shift by the shift by width - 1,
    # the sign fill the scalar shift saturates to. a uniform count is
    # splatted first, since OpShift* takes a count per component
    target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 64, from_bits: 64},
};

# f16 is the native OpTypeFloat 16 under the Float16 capability, which an
# environment guarantees from vulkan1.2 and a module naming none may use. the arithmetic,
# negation, comparisons and conversions are the core float instructions at 16 bits,
# rounded and propagating a NaN by the execution environment's float rules,
# as every float width here is
val HALF_FORMS: [18]target_model.PackedForm = [18]target_model.PackedForm{
    target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_NEG, is_float: true, lane_bits: 16, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 32, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 64, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 32, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 64, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 32, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 64, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 32, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 64, from_bits: 16, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 16, from_bits: 32, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 16, from_bits: 64, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 16, from_bits: 32, ext: isa_spirv.EXT_FLOAT16},
    target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 16, from_bits: 64, ext: isa_spirv.EXT_FLOAT16},
};

# the environments a module names, each the extensions it guarantees
val ENVIRONMENTS: [isa_spirv.ENV_PROFILE_COUNT]isa.Environment = [isa_spirv.ENV_PROFILE_COUNT]isa.Environment{
    isa.Environment{name: "vulkan1.0", profile: 0, extensions: 0},
    isa.Environment{name: "vulkan1.1", profile: 1, extensions: 0},
    isa.Environment{name: "vulkan1.2", profile: 2, extensions: 0},
    isa.Environment{name: "vulkan1.3", profile: 3, extensions: isa_spirv.ENV_GUARANTEES_1_6},
};

pub val MODEL: target_model.Machine = target_model.Machine{
    pointer_width: 8,
    gpr_width:     8,
    # an integer narrower than 32 bits computes at its own width only where the
    # target declares its device feature, and is otherwise carried at 32 bits,
    # which needs none
    alu_widths: [target_model.ALU_WIDTH_CAP]target_model.AluWidth{
        target_model.AluWidth{bytes: 4, ext: 0},
        target_model.AluWidth{bytes: 8, ext: 0},
        target_model.AluWidth{bytes: 1, ext: isa_spirv.EXT_INT8},
        target_model.AluWidth{bytes: 2, ext: isa_spirv.EXT_INT16},
        target_model.AluWidth{bytes: 0, ext: 0},
    },
    alu_width_len:          4,
    spill_width:            8,
    endianness:             target_model.ENDIAN_LITTLE,
    frame_ptr_reg:          -1,
    stack_ptr_reg:          -1,
    div_reg:                -1,
    div_hi_reg:             -1,
    shift_count_reg:        -1,
    has_v128:               true,
    vector_bits:            target_model.VECTOR_BITS_128,
    max_vector_lanes:       types.MAX_VECTOR_COMPONENTS,
    vector_compute_generic: true,
    has_lane_ops:           true,
    has_vec_build:          true,
    vec_mem_widths:         target_model.VEC_MEM_NONE,
    # OpBitcast reinterprets any scalar as another of its width, an f16 as the
    # 16-bit integer its expansion carries among them
    xbank_widths:            target_model.XBANK_2_4_8,
    slot_read_widths:        target_model.SLOT_READ_NONE,
    has_var_shift:           true,
    shift_count_mod_widths:  target_model.SHIFT_MOD_NONE,
    has_mul:                 true,
    has_float:               true,
    mul_hi_width:            0,
    int_widths:              target_model.INT_WIDTHS_1_2_4_8,
    mul_wide_form:           target_model.MULW_NONE,
    flat_addressing:         false,
    indexed_memory:          false,
    structured_control_flow: true,
    ct_trust_var_shift:      false,
    packed_forms:            ?PACKED_FORMS[0],
    packed_form_len:         93,
    # a widening multiply stays the packed extension and multiply it is
    # written as, and every shift cell is packed above; a lane range or join
    # is its lanes rebuilt with OpCompositeConstruct
    scalar_families: target_model.SCALAR_CONVERSIONS | target_model.SCALAR_WIDENING | target_model.SCALAR_SHIFTS | target_model.SCALAR_PERMUTES | target_model.SCALAR_HALF_LANES,
    half_forms:      ?HALF_FORMS[0],
    half_form_len:   18,
    # without float16 the expansion needs neither int64 nor float64
    half_binary32: true,
    flen_bits:     64,
    # OpFConvert leaves a NaN's payload unspecified, so comptime folds to the canonical NaN
    nan_rule:             float.NAN_CANONICAL,
    nan_first_operand:    false,
    extensions:           0,
    extension_table:      ?isa_spirv.EXTENSIONS[0],
    extension_count:      isa_spirv.EXTENSION_COUNT,
    index_width:          32,
    vector_op_bytes:      16,
    vectors_in_registers: false,
    auto_vectorize:       false,
};

pub val EMITTER: isa.ModuleEmitter = isa.ModuleEmitter{emit_module: spirv_emit.emit_module, has_assembly: false};

pub val VTABLE: isa.IsaVTable = isa.IsaVTable{
    id:            catalog_arch.SPIRV,
    name:          "spirv",
    pointer_width: 8,
    emitter:       ?EMITTER,
    model:         ?MODEL,
    defs:          ?defs.TABLE,
    envs:          ?ENVIRONMENTS[0],
    env_count:     isa_spirv.ENV_PROFILE_COUNT,
    # a module naming no environment has no ceiling, so every extension is open to it
    env_open_exts: isa_spirv.EXT_OPEN,
};

# the environment rows restate the profile table's names and guarantees
test environments__agree_with_the_profiles {
    var i: u32 = 0;
    for (i < isa_spirv.ENV_PROFILE_COUNT) {
        if (!str_equals(ENVIRONMENTS[i].name, isa_spirv.env_profile_name(i))) { ret 1; }
        if (ENVIRONMENTS[i].profile != i)                                     { ret 2; }
        if (ENVIRONMENTS[i].extensions != isa_spirv.env_extensions(i))        { ret 3; }
        i = i + 1;
    }
    ret 0;
}
