use mach.lang.fail;
use mach.lang.float;
use std.types.error.err;

use A: std.allocator;
use std.types.bool.false;

use mir_debug:       mach.lang.mir.debug;
use mir_unit:        mach.lang.mir.unit;
use catalog_arch:    mach.lang.target.catalog.arch;
use extension_spirv: mach.lang.target.extension.spirv;
use mach.lang.target.isa;
use isa_environment: mach.lang.target.isa.environment;
use isa_spirv:       mach.lang.target.isa.spirv;
use mach.lang.target.isa.spirv.defs;
use mach.lang.target.isa.spirv.types;
use target_model: mach.lang.target.model;
use model_spirv:  mach.lang.target.model.spirv;
use target_of:    mach.lang.target.of;

# the environments a module names, each the extensions it guarantees and the spir-v
# version its consumer reads, which the module is written at
val ENVIRONMENTS: [isa_spirv.ENV_PROFILE_COUNT]isa_environment.Environment = [isa_spirv.ENV_PROFILE_COUNT]isa_environment.Environment{
    isa_environment.Environment{name: "vulkan1.0", profile: 0, extensions: 0, stands: "spv1.0,Shader"},
    isa_environment.Environment{name: "vulkan1.1", profile: 1, extensions: 0, stands: "spv1.3,Shader"},
    isa_environment.Environment{name: "vulkan1.2", profile: 2, extensions: 0, stands: "spv1.5,Shader"},
    isa_environment.Environment{name: "vulkan1.3", profile: 3, extensions: isa_spirv.ENV_GUARANTEES_1_6, stands: "spv1.6,Shader"},
};

# spir-v modules are built by mirl once its spir-v family is pinned, so mach's own emitter refuses
fun module_emit(a: *A.Allocator, tgt: *isa.BackendTarget, u: *mir_unit.Unit, dbg: *mir_debug.ModuleDebug, image: *target_of.ObjectImage) err[fail.Fail] {
    ret err[fail.Fail].err{fail.message("spir-v output waits for mirl's spir-v family")};
}

pub val EMITTER: isa.ModuleEmitter = isa.ModuleEmitter{emit_module: module_emit, has_assembly: false};

pub val VTABLE: isa.IsaVTable = isa.IsaVTable{
    id:            catalog_arch.SPIRV,
    name:          "spirv",
    pointer_width: 8,
    emitter:       ?EMITTER,
    model:         ?model_spirv.MACHINE,
    defs:          ?defs.TABLE,
    prepare:       defs.build,
    # a module naming no environment has no ceiling, so every extension is open to it
    environments: isa_environment.Set{rows: ?ENVIRONMENTS[0], count: isa_spirv.ENV_PROFILE_COUNT, open: extension_spirv.OPEN, open_stands: "spv1.6,Shader"},
};
