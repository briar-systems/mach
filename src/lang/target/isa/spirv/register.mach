use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.string.str;

use mach.lang.target.isa;
use mach.lang.target.isa.spirv;
use mach.lang.target.isa.spirv.defs;
use mach.lang.target.isa.spirv.emit;
use mach.lang.target.isa.spirv.types;

pub fun register_spirv(reg: *isa.IsaRegistry) err[fail.Fail] {
    var spirv_model: isa.MachineModel;
    var def_storage: defs.DefStorage;

    spirv_model.pointer_width       = 8;
    spirv_model.gpr_width           = 8;
    spirv_model.gp_unaligned_widths = 0;
    spirv_model.spill_width         = 8;
    spirv_model.alu_min_width       = 1;
    spirv_model.endianness          = isa.ENDIAN_LITTLE;
    spirv_model.reg_classes         = nil;
    spirv_model.reg_class_len       = 0;
    spirv_model.frame_ptr_reg       = -1;
    spirv_model.stack_ptr_reg       = -1;
    spirv_model.reserved_regs       = nil;
    spirv_model.reserved_len        = 0;
    spirv_model.div_reg             = -1;
    spirv_model.div_hi_reg          = -1;
    spirv_model.shift_count_reg     = -1;
    spirv_model.incoming_arg_base   = 0;
    spirv_model.stack_align         = 0;
    spirv_model.red_zone            = 0;
    spirv_model.shadow_space        = 0;
    spirv_model.flen_bits           = 64;
    spirv_model.has_v128            = true;
    spirv_model.vector_bits         = isa.VECTOR_BITS_128;
    spirv_model.max_vector_lanes    = types.MAX_VECTOR_COMPONENTS;
    spirv_model.vec_mem_widths      = isa.VEC_MEM_NONE;
    spirv_model.xbank_widths        = isa.XBANK_4_8;
    var spirv_packed_forms: [46]isa.PackedForm;
    spirv_packed_forms[0]              = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: false, lane_bits: 8};
    spirv_packed_forms[1]              = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: false, lane_bits: 16};
    spirv_packed_forms[2]              = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: false, lane_bits: 32};
    spirv_packed_forms[3]              = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: false, lane_bits: 64};
    spirv_packed_forms[4]              = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: false, lane_bits: 8};
    spirv_packed_forms[5]              = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: false, lane_bits: 16};
    spirv_packed_forms[6]              = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: false, lane_bits: 32};
    spirv_packed_forms[7]              = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: false, lane_bits: 64};
    spirv_packed_forms[8]              = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: false, lane_bits: 8};
    spirv_packed_forms[9]              = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: false, lane_bits: 16};
    spirv_packed_forms[10]             = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: false, lane_bits: 32};
    spirv_packed_forms[11]             = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: false, lane_bits: 64};
    spirv_packed_forms[12]             = isa.PackedForm{op: isa.VEC_OP_DIV, is_float: false, lane_bits: 8};
    spirv_packed_forms[13]             = isa.PackedForm{op: isa.VEC_OP_DIV, is_float: false, lane_bits: 16};
    spirv_packed_forms[14]             = isa.PackedForm{op: isa.VEC_OP_DIV, is_float: false, lane_bits: 32};
    spirv_packed_forms[15]             = isa.PackedForm{op: isa.VEC_OP_DIV, is_float: false, lane_bits: 64};
    spirv_packed_forms[16]             = isa.PackedForm{op: isa.VEC_OP_AND, is_float: false, lane_bits: 8};
    spirv_packed_forms[17]             = isa.PackedForm{op: isa.VEC_OP_AND, is_float: false, lane_bits: 16};
    spirv_packed_forms[18]             = isa.PackedForm{op: isa.VEC_OP_AND, is_float: false, lane_bits: 32};
    spirv_packed_forms[19]             = isa.PackedForm{op: isa.VEC_OP_AND, is_float: false, lane_bits: 64};
    spirv_packed_forms[20]             = isa.PackedForm{op: isa.VEC_OP_OR, is_float: false, lane_bits: 8};
    spirv_packed_forms[21]             = isa.PackedForm{op: isa.VEC_OP_OR, is_float: false, lane_bits: 16};
    spirv_packed_forms[22]             = isa.PackedForm{op: isa.VEC_OP_OR, is_float: false, lane_bits: 32};
    spirv_packed_forms[23]             = isa.PackedForm{op: isa.VEC_OP_OR, is_float: false, lane_bits: 64};
    spirv_packed_forms[24]             = isa.PackedForm{op: isa.VEC_OP_XOR, is_float: false, lane_bits: 8};
    spirv_packed_forms[25]             = isa.PackedForm{op: isa.VEC_OP_XOR, is_float: false, lane_bits: 16};
    spirv_packed_forms[26]             = isa.PackedForm{op: isa.VEC_OP_XOR, is_float: false, lane_bits: 32};
    spirv_packed_forms[27]             = isa.PackedForm{op: isa.VEC_OP_XOR, is_float: false, lane_bits: 64};
    spirv_packed_forms[28]             = isa.PackedForm{op: isa.VEC_OP_NOT, is_float: false, lane_bits: 8};
    spirv_packed_forms[29]             = isa.PackedForm{op: isa.VEC_OP_NOT, is_float: false, lane_bits: 16};
    spirv_packed_forms[30]             = isa.PackedForm{op: isa.VEC_OP_NOT, is_float: false, lane_bits: 32};
    spirv_packed_forms[31]             = isa.PackedForm{op: isa.VEC_OP_NOT, is_float: false, lane_bits: 64};
    spirv_packed_forms[32]             = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: false, lane_bits: 8};
    spirv_packed_forms[33]             = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: false, lane_bits: 16};
    spirv_packed_forms[34]             = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: false, lane_bits: 32};
    spirv_packed_forms[35]             = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: false, lane_bits: 64};
    spirv_packed_forms[36]             = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: true, lane_bits: 32};
    spirv_packed_forms[37]             = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: true, lane_bits: 64};
    spirv_packed_forms[38]             = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: true, lane_bits: 32};
    spirv_packed_forms[39]             = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: true, lane_bits: 64};
    spirv_packed_forms[40]             = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: true, lane_bits: 32};
    spirv_packed_forms[41]             = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: true, lane_bits: 64};
    spirv_packed_forms[42]             = isa.PackedForm{op: isa.VEC_OP_DIV, is_float: true, lane_bits: 32};
    spirv_packed_forms[43]             = isa.PackedForm{op: isa.VEC_OP_DIV, is_float: true, lane_bits: 64};
    spirv_packed_forms[44]             = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: true, lane_bits: 32};
    spirv_packed_forms[45]             = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: true, lane_bits: 64};
    spirv_model.packed_forms           = ?spirv_packed_forms[0];
    spirv_model.packed_form_len        = 46;
    spirv_model.scalar_forms           = nil;
    spirv_model.scalar_form_len        = 0;
    spirv_model.vector_compute_generic = true;
    spirv_model.has_lane_ops           = true;
    spirv_model.has_vec_build          = true;
    spirv_model.ct_trust_mul           = false;
    spirv_model.has_var_shift          = true;
    spirv_model.has_mul                = true;
    spirv_model.has_float              = true;
    spirv_model.mul_hi_width           = 0;
    spirv_model.flat_addressing        = false;
    spirv_model.index_width            = 32;
    spirv_model.vector_op_bytes        = 16;
    spirv_model.vectors_in_registers   = false;
    spirv_model.auto_vectorize         = false;
    spirv_model.ct_trust_var_shift     = false;

    var spirv_envs: [4]isa.Environment;
    var ei:         u32 = 0;
    for (ei < spirv.ENV_PROFILE_COUNT) {
        spirv_envs[ei].name    = spirv.env_profile_name(ei);
        spirv_envs[ei].profile = ei;
        ei                     = ei + 1;
    }

    var spirv_emitter: isa.ModuleEmitter = isa.module_emitter(emit.emit_module);
    var spirv_vtable:  isa.IsaVTable     = isa.emitter_isa(
        isa.ARCH_SPIRV, isa.arch_name_for(isa.ARCH_SPIRV), 8,
        ?spirv_model, ?spirv_emitter);

    isa.with_defs(?spirv_vtable, defs.register_defs(?def_storage));
    isa.with_environments(?spirv_vtable, ?spirv_envs[0], spirv.ENV_PROFILE_COUNT);

    ret isa.register(reg, ?spirv_vtable);
}
