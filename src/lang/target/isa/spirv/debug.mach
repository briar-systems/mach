# the spirv debug model, all core instructions so it fits every environment without a capability
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;

use A: std.allocator;

use mach.lang.be.codegen.debug_input;
use mach.lang.intern;
use mach.lang.layout;
use mach.lang.source;
use mach.lang.target.isa.spirv;
use semtype: mach.lang.type;

val FILE_CAP: u32 = 64;

# SourceLanguage Unknown: mach has no registered source language
val SOURCE_LANGUAGE_UNKNOWN: u32 = 0;

pub rec Debug {
    on:       bool;
    b:        *spirv.Builder;
    alloc:    *A.Allocator;
    interner: *intern.Interner;
    srcmap:   *source.SourceMap;
    types:    *semtype.TypeInterner;
    comp_dir: str;
    sourced:  bool;

    file_ids:  [64]source.FileId;
    file_strs: [64]u32;
    file_len:  u32;

    # the line in force for the instructions that follow, until a label ends the block
    active: bool;
    file:   source.FileId;
    line:   usize;
    col:    usize;
}

pub fun init(req: *debug_input.ModuleDebug, b: *spirv.Builder, alloc: *A.Allocator,
    interner: *intern.Interner, srcmap: *source.SourceMap) Debug {
    var d: Debug;
    d.on       = req != nil && req.emit && srcmap != nil;
    d.b        = b;
    d.alloc    = alloc;
    d.interner = interner;
    d.srcmap   = srcmap;
    d.types    = nil;
    d.comp_dir = "";
    d.sourced  = false;
    d.file_len = 0;
    d.active   = false;
    d.file     = source.FILE_NIL;
    d.line     = 0;
    d.col      = 0;
    if (d.on) {
        d.types = req.types;
        val cd: opt[str] = intern.lookup(interner, req.comp_dir);
        if (sel cd.some) { d.comp_dir = cd.some; }
    }
    ret d;
}

# the OpString naming a source file, declared on first use; 0 when the file is unknown
fun file_string(d: *Debug, file: source.FileId) u32 {
    var i: u32 = 0;
    for (i < d.file_len) {
        if (d.file_ids[i] == file) { ret d.file_strs[i]; }
        i = i + 1;
    }
    val fo: opt[*source.SourceFile] = source.get(d.srcmap, file);
    if (sel fo.none) { ret 0; }
    if (d.file_len >= FILE_CAP) {
        d.b.err = true;
        ret 0;
    }
    var shown: str = fo.some.path;
    if (!str_empty(d.comp_dir) && !path.is_abs(shown)) {
        val joined: res[path.Path, A.Error] = path.join(d.alloc, d.comp_dir, shown);
        if (sel joined.err) {
            d.b.err = true;
            ret 0;
        }
        shown = joined.ok;
    }
    val id: u32 = spirv.alloc_id(d.b);
    spirv.inst_string(d.b, ?d.b.debug_source, spirv.OP_STRING, ?id, 1, shown);
    d.file_ids[d.file_len]  = file;
    d.file_strs[d.file_len] = id;
    d.file_len              = d.file_len + 1;
    ret id;
}

# OpSource for the file the module's root function is declared in, once per module
pub fun source_of(d: *Debug, loc: source.SrcLoc) {
    if (!d.on || d.sourced || loc.file == source.FILE_NIL) { ret; }
    val str_id: u32 = file_string(d, loc.file);
    if (str_id == 0) { ret; }
    var ops: [3]u32;
    ops[0] = SOURCE_LANGUAGE_UNKNOWN;
    ops[1] = 0;
    ops[2] = str_id;
    spirv.inst(d.b, ?d.b.debug_source, spirv.OP_SOURCE, ?ops[0], 3);
    d.sourced = true;
}

# a label starts a block, and no line carries across one
pub fun block(d: *Debug) {
    d.active = false;
}

# attribute the instructions that follow to `loc`, or to no source when it has none
pub fun line(d: *Debug, loc: source.SrcLoc) {
    if (!d.on) { ret; }
    if (loc.file == source.FILE_NIL) {
        if (d.active) {
            spirv.inst(d.b, ?d.b.functions, spirv.OP_NO_LINE, nil, 0);
            d.active = false;
        }
        ret;
    }
    val fo: opt[*source.SourceFile] = source.get(d.srcmap, loc.file);
    if (sel fo.none)           { ret; }
    if (fo.some.line_len == 0) { ret; }
    val p: source.Position = source.position(fo.some, loc.offset);
    if (d.active && d.file == loc.file && d.line == p.line && d.col == p.col) { ret; }
    val str_id: u32 = file_string(d, loc.file);
    if (str_id == 0) { ret; }
    val line_r: res[u32, layout.CheckCause] = layout.usize_to_u32(p.line);
    val col_r:  res[u32, layout.CheckCause] = layout.usize_to_u32(p.col);
    if (sel line_r.err) { ret; }
    if (sel col_r.err)  { ret; }
    var ops: [3]u32;
    ops[0] = str_id;
    ops[1] = line_r.ok;
    ops[2] = col_r.ok;
    spirv.inst(d.b, ?d.b.functions, spirv.OP_LINE, ?ops[0], 3);
    d.active = true;
    d.file   = loc.file;
    d.line   = p.line;
    d.col    = p.col;
}

# the declared name when there is one, the linkage name otherwise
pub fun name_shown(d: *Debug, target: u32, disp: intern.StrId, linkage: intern.StrId) {
    if (disp != intern.STR_NIL) {
        name(d, target, disp);
        ret;
    }
    name(d, target, linkage);
}

pub fun name(d: *Debug, target: u32, text: intern.StrId) {
    if (!d.on || target == 0) { ret; }
    val t: opt[str] = intern.lookup(d.interner, text);
    if (sel t.none)        { ret; }
    if (str_empty(t.some)) { ret; }
    spirv.inst_string(d.b, ?d.b.debug_names, spirv.OP_NAME, ?target, 1, t.some);
}

# OpName for a record type and OpMemberName for each field, from its declared source type
pub fun record(d: *Debug, struct_id: u32, ty: semtype.TypeId) {
    if (!d.on || d.types == nil || struct_id == 0)          { ret; }
    if (ty == semtype.TYPE_NIL || ty == semtype.TYPE_ERROR) { ret; }
    val base: semtype.TypeId     = semtype.strip_secret(d.types, ty);
    val to:   opt[*semtype.Type] = semtype.get(d.types, base);
    if (sel to.none) { ret; }
    val t: *semtype.Type = to.some;
    if (t.kind != semtype.TYPE_REC && t.kind != semtype.TYPE_UNI) { ret; }
    name(d, struct_id, t.data.nominal.name);
    val n: u32 = semtype.field_count(d.types, base);
    var i: u32 = 0;
    for (i < n) {
        val fe: opt[*semtype.FieldEntry] = semtype.field_at(d.types, base, i);
        if (sel fe.some) {
            val fname: opt[str] = intern.lookup(d.interner, fe.some.name);
            if (sel fname.some) {
                member_name(d, struct_id, i, fname.some);
            }
        }
        i = i + 1;
    }
}

fun member_name(d: *Debug, struct_id: u32, member: u32, text: str) {
    if (str_empty(text)) { ret; }
    var ops: [2]u32;
    ops[0] = struct_id;
    ops[1] = member;
    spirv.inst_string(d.b, ?d.b.debug_names, spirv.OP_MEMBER_NAME, ?ops[0], 2, text);
}
