# the spirv debug model, all core instructions so it fits every environment without a capability
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;

use A: std.allocator;

use lang_checked: mach.lang.checked;
use mach.lang.intern;
use ir_debug:    mach.lang.me.ir.debug;
use mir_debug:   mach.lang.mir.debug;
use lang_source: mach.lang.source;
use isa_spirv:   mach.lang.target.isa.spirv;

val FILE_CAP: u32 = 64;

# SourceLanguage Unknown: mach has no registered source language
val SOURCE_LANGUAGE_UNKNOWN: u32 = 0;

pub rec Debug {
    on:       bool;
    b:        *isa_spirv.Builder;
    alloc:    *A.Allocator;
    interner: *intern.Interner;
    srcmap:   *lang_source.SourceMap;
    comp_dir: str;
    sourced:  bool;

    file_ids:  [64]lang_source.FileId;
    file_strs: [64]u32;
    file_len:  u32;

    # the line in force for the instructions that follow, until a label ends the block
    active: bool;
    file:   lang_source.FileId;
    line:   usize;
    col:    usize;
}

pub fun init(req: *mir_debug.ModuleDebug, b: *isa_spirv.Builder, alloc: *A.Allocator,
    interner: *intern.Interner, srcmap: *lang_source.SourceMap) Debug {
    var d: Debug;
    d.on       = req != nil && req.emit && srcmap != nil;
    d.b        = b;
    d.alloc    = alloc;
    d.interner = interner;
    d.srcmap   = srcmap;
    d.comp_dir = "";
    d.sourced  = false;
    d.file_len = 0;
    d.active   = false;
    d.file     = lang_source.FILE_NIL;
    d.line     = 0;
    d.col      = 0;
    if (d.on) {
        val cd: opt[str] = intern.get(interner, req.comp_dir);
        if (sel cd.some) { d.comp_dir = cd.some; }
    }
    ret d;
}

# the OpString naming a source file, declared on first use; 0 when the file is unknown
fun file_string(d: *Debug, file: lang_source.FileId) u32 {
    var i: u32 = 0;
    for (i < d.file_len) {
        if (lang_source.file_same(d.file_ids[i], file)) { ret d.file_strs[i]; }
        i = i + 1;
    }
    val fo: opt[*lang_source.SourceFile] = lang_source.get(d.srcmap, file);
    if (sel fo.none) { ret 0; }
    if (d.file_len >= FILE_CAP) {
        d.b.err = true;
        ret 0;
    }
    var shown: str = fo.some.path;
    if (!str_empty(d.comp_dir) && !types_path.is_abs(shown)) {
        val joined: res[types_path.Path, A.Error] = types_path.join(d.alloc, d.comp_dir, shown);
        if (sel joined.err) {
            d.b.err = true;
            ret 0;
        }
        shown = joined.ok;
    }
    val id: u32 = isa_spirv.alloc_id(d.b);
    isa_spirv.inst_string(d.b, ?d.b.debug_source, isa_spirv.OP_STRING, ?id, 1, shown);
    d.file_ids[d.file_len]  = file;
    d.file_strs[d.file_len] = id;
    d.file_len              = d.file_len + 1;
    ret id;
}

# OpSource for the file the module's root function is declared in, once per module
pub fun source_of(d: *Debug, loc: lang_source.Location) {
    if (!d.on || d.sourced || lang_source.file_is_nil(loc.file)) { ret; }
    val str_id: u32 = file_string(d, loc.file);
    if (str_id == 0) { ret; }
    var ops: [3]u32;
    ops[0] = SOURCE_LANGUAGE_UNKNOWN;
    ops[1] = 0;
    ops[2] = str_id;
    isa_spirv.inst(d.b, ?d.b.debug_source, isa_spirv.OP_SOURCE, ?ops[0], 3);
    d.sourced = true;
}

# a label starts a block, and no line carries across one
pub fun block(d: *Debug) {
    d.active = false;
}

# attribute the instructions that follow to `loc`, or to no source when it has none
pub fun line(d: *Debug, loc: lang_source.Location) {
    if (!d.on) { ret; }
    if (lang_source.file_is_nil(loc.file)) {
        if (d.active) {
            isa_spirv.inst(d.b, ?d.b.functions, isa_spirv.OP_NO_LINE, nil, 0);
            d.active = false;
        }
        ret;
    }
    val fo: opt[*lang_source.SourceFile] = lang_source.get(d.srcmap, loc.file);
    if (sel fo.none)            { ret; }
    if (fo.some.lines.len == 0) { ret; }
    val p: lang_source.Position = lang_source.position(fo.some, loc.span.offset);
    if (d.active && lang_source.file_same(d.file, loc.file) && d.line == p.line && d.col == p.col) { ret; }
    val str_id: u32 = file_string(d, loc.file);
    if (str_id == 0) { ret; }
    val line_r: res[u32, lang_checked.Cause] = lang_checked.usize_to_u32(p.line);
    val col_r:  res[u32, lang_checked.Cause] = lang_checked.usize_to_u32(p.col);
    if (sel line_r.err) { ret; }
    if (sel col_r.err)  { ret; }
    var ops: [3]u32;
    ops[0] = str_id;
    ops[1] = line_r.ok;
    ops[2] = col_r.ok;
    isa_spirv.inst(d.b, ?d.b.functions, isa_spirv.OP_LINE, ?ops[0], 3);
    d.active = true;
    d.file   = loc.file;
    d.line   = p.line;
    d.col    = p.col;
}

# the declared name when there is one, the linkage name otherwise
pub fun name_shown(d: *Debug, target: u32, disp: intern.StrId, linkage: intern.StrId) {
    if (!intern.str_is_nil(disp)) {
        name(d, target, disp);
        ret;
    }
    name(d, target, linkage);
}

pub fun name(d: *Debug, target: u32, text: intern.StrId) {
    if (!d.on || target == 0) { ret; }
    val t: opt[str] = intern.get(d.interner, text);
    if (sel t.none)        { ret; }
    if (str_empty(t.some)) { ret; }
    isa_spirv.inst_string(d.b, ?d.b.debug_names, isa_spirv.OP_NAME, ?target, 1, t.some);
}

# OpName for a record type and OpMemberName for each field, from the debug type
# its module's table gives it
pub fun record(d: *Debug, struct_id: u32, types: *ir_debug.Table, ty: ir_debug.TypeId) {
    if (!d.on || struct_id == 0) { ret; }
    val to: opt[*ir_debug.Type] = ir_debug.get(types, ty);
    if (sel to.none) { ret; }
    val t: *ir_debug.Type = to.some;
    if (t.kind != ir_debug.KIND_STRUCT && t.kind != ir_debug.KIND_UNION) { ret; }
    name(d, struct_id, t.name);
    var i: u32 = 0;
    for (i < t.member_count) {
        val fname: opt[str] = intern.get(d.interner, ir_debug.member_at(types, t, i).name);
        if (sel fname.some) {
            member_name(d, struct_id, i, fname.some);
        }
        i = i + 1;
    }
}

fun member_name(d: *Debug, struct_id: u32, member: u32, text: str) {
    if (str_empty(text)) { ret; }
    var ops: [2]u32;
    ops[0] = struct_id;
    ops[1] = member;
    isa_spirv.inst_string(d.b, ?d.b.debug_names, isa_spirv.OP_MEMBER_NAME, ?ops[0], 2, text);
}
