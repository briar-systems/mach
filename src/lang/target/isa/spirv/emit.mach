pub fun emit_module(out_alloc: *A.Allocator, tgt: *isa.BackendTarget, u: *mir_unit.Unit,
    dbg: *mir_debug.ModuleDebug, image: *target_of.ObjectImage) err[fail.Fail] {
    if (out_alloc == nil || tgt == nil || u == nil || u.len == 0 || u.mods == nil || image == nil) {
        ret err[fail.Fail].err{fail.message("spirv.emit: nil argument")};
    }
    if (image.alloc != out_alloc) {
        ret err[fail.Fail].err{fail.message("spirv.emit: the module is serialized into the image's allocator, and the two differ")};
    }
    val irmod:  *me_ir.Module       = mir_unit.root_ir(u);
    val mirmod: *lang_mir.MirModule = mir_unit.root_mir(u);
    if (irmod == nil || mirmod == nil) { ret err[fail.Fail].err{fail.message("spirv.emit: nil argument")}; }

    var b:  isa_spirv.Builder = isa_spirv.builder_init(out_alloc);
    var tt: types.TypeTable   = types.types_init(?b);
    fin {
        types.types_dnit(?tt);
        isa_spirv.builder_dnit(?b);
    }

    var e: emitter.Emit;
    e.alloc           = out_alloc;
    e.interner        = mirmod.interner;
    e.tgt             = tgt;
    e.layout          = layout.machine(tgt.model.pointer_width, tgt.model.vector_bits, target_model.vector_register_bits(?tgt.model));
    e.u               = u;
    e.root            = irmod;
    e.ir              = irmod;
    e.cur_mi          = u.root;
    e.b               = ?b;
    e.tt              = ?tt;
    e.fns             = nil;
    e.fn_len          = 0;
    e.gls             = nil;
    e.gl_len          = 0;
    e.gvar_ids        = nil;
    e.gtype_ids       = nil;
    e.gstorage        = nil;
    e.iface_len       = 0;
    e.gslot           = nil;
    e.iface_use       = nil;
    e.zero_lid        = 0;
    e.gaccess         = nil;
    e.pacc            = nil;
    e.pbase           = nil;
    e.pacc_len        = 0;
    e.rsum            = nil;
    e.rptr            = nil;
    e.sum_grew        = false;
    e.copies          = collections_vector.init[emitter.Copy](out_alloc);
    e.keys            = collections_vector.init[u32](out_alloc);
    e.cur_copy        = emitter.COPY_NONE;
    e.cur_pslot       = nil;
    e.cur_params      = nil;
    e.gspec           = nil;
    e.wg_builtin      = false;
    e.half_interface  = false;
    e.vulkan_mm       = isa_spirv.vulkan_memory_model(tgt.model.extensions);
    e.pscope          = collections_vector.init[u8](out_alloc);
    e.coherent_images = false;
    e.physical        = false;
    e.palign          = collections_vector.init[u32](out_alloc);
    e.talign          = collections_vector.init[u32](out_alloc);
    e.tsize           = collections_vector.init[u32](out_alloc);
    e.pkeys           = collections_vector.init[emitter.PhysKey](out_alloc);
    e.precs           = collections_vector.init[emitter.PhysRec](out_alloc);
    e.strided         = collections_vector.init[u32](out_alloc);
    e.has_held        = false;
    var xi: u32 = 0;
    for (xi < 8) {
        e.ext_ids[xi] = 0;
        xi            = xi + 1;
    }
    e.srcmap     = mirmod.srcmap;
    e.diags      = mirmod.diags;
    e.dbg        = debug.init(dbg, ?b, out_alloc, e.interner, e.srcmap);
    e.cur_fn     = nil;
    e.cur_instr  = nil;
    e.fn_stages  = nil;
    e.cur_stages = 0;

    e.has_entry = false;
    var si: u32 = 0;
    for (si < irmod.function_len) {
        if (irmod.functions[si].stage != me_ir.STAGE_NONE
            && (irmod.functions[si].flags & me_ir.FN_FLAG_EXTERN) == 0) { e.has_entry = true; }
        si = si + 1;
    }

    val emitted: err[fail.Fail] = functions_emit(?e);
    if (sel emitted.err) { ret emitted; }

    val cr: err[fail.Fail] = emit_capability.check_environment(?e);
    if (sel cr.err) { ret cr; }
    emit_capability.emit_preamble(?e);

    var len: u32                 = 0;
    val rs:  res[*u8, fail.Fail] = isa_spirv.serialize(?b, ?len);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    ret install_module(image, rs.ok, len);
}

# the analyses and every function's copies in order, returning on the first refusal;
# what they build is released on the way out, whatever the outcome
fun functions_emit(e: *emitter.Emit) err[fail.Fail] {
    fin { emitter.emit_dnit(e); }
    val tr: err[fail.Fail] = emitter.build_fn_table(e);
    if (sel tr.err) { ret tr; }
    val rr: err[fail.Fail] = emitter.mark_emitted(e);
    if (sel rr.err) { ret rr; }
    val vr: err[fail.Fail] = emit_capability.select_version(e);
    if (sel vr.err) { ret vr; }
    val gtr: err[fail.Fail] = emit_global.build_gl_table(e);
    if (sel gtr.err) { ret gtr; }
    val wr: err[fail.Fail] = emit_interface.build_gl_access(e);
    if (sel wr.err) { ret wr; }
    val gr: err[fail.Fail] = emit_interface.declare_interface(e);
    if (sel gr.err) { ret gr; }
    val ur: err[fail.Fail] = emit_interface.build_iface_uses(e);
    if (sel ur.err) { ret ur; }
    val cgr: err[fail.Fail] = emit_interface.check_call_graph(e);
    if (sel cgr.err) { ret cgr; }
    val fsr: err[fail.Fail] = emit_interface.build_fn_stages(e);
    if (sel fsr.err) { ret fsr; }
    val sir: err[fail.Fail] = emit_interface.check_stage_interfaces(e);
    if (sel sir.err) { ret sir; }
    val wgr: err[fail.Fail] = emit_interface.plan_workgroup(e);
    if (sel wgr.err) { ret wgr; }
    val pcr: err[fail.Fail] = emit_copy.plan_copies(e);
    if (sel pcr.err) { ret pcr; }

    # each function's copies in turn, in the order the function table holds them
    var fi: u32 = 0;
    for (fi < e.fn_len) {
        var ci: u32 = 0;
        for (ci < e.copies.len::u32) {
            if (e.copies.data[ci].fx != fi) {
                ci = ci + 1;
                cnt;
            }
            val fr: err[fail.Fail] = emit_function.emit_function(e, ci);
            if (sel fr.err) { ret fr; }
            ci = ci + 1;
        }
        fi = fi + 1;
    }
    emit_layout.use_at(e, lang_source.location_nil());
    ret err[fail.Fail].ok{};
}

# the finished module is the image's one section; the image owns its bytes from here
fun install_module(image: *target_of.ObjectImage, bytes: *u8, len: u32) err[fail.Fail] {
    val name: res[intern.StrId, A.Error] = intern.add(image.interner, isa_spirv.SPV_MODULE_SECTION);
    if (sel name.err) {
        if (bytes != nil && len > 0) { A.deallocate[u8](image.alloc, bytes, len::usize); }
        ret err[fail.Fail].err{fail.refused(name.err)};
    }
    var sec: target_of.Section;
    sec.name  = name.ok;
    sec.kind  = target_of.SK_TEXT;
    sec.bytes = bytes;
    sec.len   = len;
    sec.align = 4;
    sec.flags = 0;
    val installed: res[u32, fail.Fail] = target_of.section_install(image, ?sec);
    if (sel installed.err) { ret err[fail.Fail].err{installed.err}; }
    ret err[fail.Fail].ok{};
}
