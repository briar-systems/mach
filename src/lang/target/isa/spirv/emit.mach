# the MIR-to-SPIR-V module emitter: the SPIR-V back-half spine
#
# This is the whole back half for the SPIR-V target. Where a machine target runs
# instruction selection, register allocation, frame layout, and byte encoding, a
# SPIR-V target does none of those: `codegen_module` forks after MIR lowering and
# calls `emit_module` here, which consumes the post-lower MIR and emits a finished
# SPIR-V module directly. There are no registers to allocate and no linear machine
# code - the output is a typed, SSA-flavoured word stream.
#
# THE INPUT IS A UNIT, NOT A MODULE (#2823). There is no linker after this, so a
# call that leaves the mach module cannot be left for one to bind: the callee's
# body has to be emitted into the same output. So the emitter is handed a
# `unit.Unit` - the module being compiled, plus the modules it draws called bodies
# from - and its first act is to flatten every defined function in the unit into
# ONE table. Every id, every reachability mark and every call resolution keys on a
# table index, so a same-module call and a cross-module call are the same code
# path; nothing downstream of the table can tell them apart, which is the property
# that keeps the boundary from growing special cases.
#
# What is emitted from that table is decided by REACHABILITY, not by membership. A
# shader module emits the closure of its entry points; a library module has no
# entry points, so its own functions are the roots instead. Importing a large
# shared module therefore costs the functions actually called and nothing else.
#
# WHICH MODULE'S TYPE TABLE. An `ir.IrTypeId` is an index into ONE module's type
# table, so a callee's signature must be read against the type table of the module
# that DEFINED it, not the one calling it. `e.ir` is the member currently being
# read and is swapped as the walk crosses a boundary; `e.root` is the module being
# compiled and is what every GLOBAL is resolved against, since interface variables
# are the root's pipeline contract and belong to no one else.
#
# The value model (the key move): every MIR virtual register becomes an
# `OpVariable` in the function's local (`Function`) storage class, and every MIR
# operation becomes load-operands / compute / store-result. Post-lower MIR is
# already out of SSA (phis are predecessor-end moves), so a vreg may be assigned in
# several blocks; the variable model expresses that as plain stores without
# reconstructing phis. A downstream consumer runs mem2reg to recover SSA.
#
# Scalar types are rebuilt from MIR facts (width + float/int register class) per
# the machine-neutral type mapping; integer signedness rides the operation
# (OpSDiv vs OpUDiv), never the type. The function signature and linkage come from
# the IR function.
#
# A TYPE ID, never a width, is what travels with a value here. MIR is width-typed
# and class-typed separately - an operand is "four bytes" and its vreg is "in the
# float bank" - but SPIR-V wants one id, and an operand that is not a vreg (an
# immediate, or a value sitting in the ABI's nominal register file) has no bank to
# read. So every read of an operand is told the SPIR-V type the CONSUMER declares
# for that position, and an immediate is minted against it: an f32 literal reaches
# MIR as its IEEE bit pattern in a plain integer immediate, and only the consumer's
# declared type says to spell those bits `OpConstant %float` rather than
# `OpConstant %uint`. Threading a width instead is what let `ret 1.5;` emit a
# 64-bit integer constant out of an f32 function - a module mach's own reader
# round-tripped happily and spirv-val rejected.
#
# Control flow is reconstructed rather than laid out: SPIR-V requires structured
# regions, so `cfg.analyze` derives the merge blocks, continue targets, and block
# order from the MIR CFG, and this module emits that structure. A shape the
# reconstruction cannot express is refused by name.
#
# Milestone scope: scalar functions over the reconstructed control flow - integer
# and floating-point arithmetic, comparisons, negation, the width and int/float
# conversions, bit reinterpretation, moves, branches, direct calls, returns.
# Aggregates, memory addressing, inline asm, and vectors are out of this milestone
# and raise a loud, precise diagnostic rather than emitting an invalid module.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;

use std.allocator.page;
use std.format;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.intern;
use mach.lang.source;
use defs: mach.lang.target.isa.spirv.defs;
use mach.lang.target.resolved;
use mach.lang.me.ir;
use mach.lang.me.ir.type;
use mach.lang.be.codegen.mir;
use mach.lang.be.codegen.unit;
use mach.lang.target.isa.spirv;
use mach.lang.target.isa.spirv.cfg;
use mach.lang.target.isa.spirv.types;
use semtype: mach.lang.type;

# the per-module emission state threaded through the walk
#
# The allocator and interner come from the MIR module (as they do for the machine
# encoders), never a session: this module is composed under `mach.lang.target` and
# so cannot depend on `session`, which imports the composition root.
# ---
# alloc:    allocator backing every emitter allocation (the MIR module's)
# interner: session interner, for resolving function names
# tgt:      the resolved target (its model supplies the default machine word width)
# u:        the emission unit - every module a body may be drawn from
# root:     the unit's root: the module being compiled. every GLOBAL is resolved
#           against this one, whatever member's function is being emitted, because
#           an interface variable is the root's pipeline contract
# ir:       the member currently being READ - its type table types the signature
#           and the body in hand. swapped as the walk crosses a module boundary,
#           and equal to `root` for everything but a drawn-in callee
# cur_mi:   that member's index in the unit, so a diagnostic can name its module
# b:        the SPIR-V module builder
# tt:       the type / constant dedup table over `b`
# fns:      the unit's defined functions, flattened into one table - the emitter's
#           whole namespace. every id, mark and call resolution is a table index
# fn_len:   how many entries the table has
# has_entry: whether any function in the ROOT declares a pipeline stage, which
#           decides whether this is a shader module (entry points, no Linkage) or a
#           library module (Linkage exports, no entry point)
# gls:      the unit's globals, flattened into one table exactly as `fns` flattens
#           its functions - the root's in IR order first, then the globals a drawn-in
#           body reaches. every per-global array below is indexed by a table index,
#           NOT by a root IR global index
# gl_len:   how many entries that table has
# gtype_ids: the SPIR-V VALUE type each interface variable was declared with, and
#           gstorage its storage class. An access chain's result is a pointer to a
#           member of that exact type, and a laid-out block's array members are not
#           interned, so the declared id has to be remembered rather than rebuilt.
# gvar_ids: SPIR-V OpVariable id per global-table index, allocated before any body is
#           emitted so a load or store can name a variable declared later (0 for a
#           global carrying no interface role)
# iface_ids: the Input / Output variable ids, in declaration order; an entry point
#           lists the subset of these it can reach
# iface_len: how many of `iface_ids` are live
# gslot:    per global-table index, one more than its slot in `iface_ids`, or 0 when
#           the global is not entry-point interface
# iface_use: a (unit function) x (interface slot) matrix, 1 where that function can
#           reach that variable, transitively through its calls. an entry point
#           lists exactly its own row
rec Emit {
    alloc:     *A.Allocator;
    interner:  *intern.Interner;
    tgt:       *resolved.Target;
    u:         *unit.Unit;
    root:      *ir.Module;
    ir:        *ir.Module;
    cur_mi:    u32;
    b:         *spirv.Builder;
    tt:        *types.TypeTable;
    fns:       *FnEnt;
    fn_len:    u32;
    has_entry: bool;
    gls:       *GlobalEnt;
    gl_len:    u32;
    gvar_ids:  *u32;
    gtype_ids: *u32;
    gstorage:  *u32;
    iface_ids: *u32;
    iface_len: u32;
    gslot:     *u32;
    iface_use: *u8;

    # per global-table entry, whether a store can reach it (#2879). the absence of
    # one is what a `NonWritable` decoration states, so this is a PROOF rather than
    # a search: anything the derivation walk cannot follow reads as written
    gwrite:    *u8;

    # the id each extended instruction set was imported under, indexed by
    # defs.SPV_SET_*; 0 means "not imported yet". indexed rather than one field
    # per set so a second set is a row in `spirvop`, not a change here. the import
    # is minted at the FIRST call that needs it, which is what makes it on demand:
    # a module using none of them carries no OpExtInstImport at all
    ext_ids:   [8]u32;

    # the refusal context: which function is being emitted and which instruction
    # is being translated, so a refusal can say so without every site threading
    # them (#2656). stamped at the two chokepoints below - function entry and
    # instruction dispatch - the same way MIR stamps `loc` at `push_instr`, and
    # read only by `unsupported`. `cur_instr` is cleared on entering a function so
    # a whole-function refusal cannot inherit the previous function's last one.
    srcmap:    *source.SourceMap;
    cur_fn:    *mir.MirFunction;
    cur_instr: *mir.MirInstr;
}

# the per-function value maps, sized to the function's vreg count
#
# ---
# type_id: SPIR-V element type id per vreg (0 when the vreg has no determined type)
# var_id:  SPIR-V OpVariable id per vreg (0 when the vreg needs no variable)
# is_bool: whether the vreg holds a boolean (defined by a comparison)
# chain_id: for a vreg defined by an access chain, the resulting POINTER id, and
#          chain_ty the type it points at. Such a vreg holds an address rather than
#          a value, so it gets no backing variable and is never loaded as one; the
#          load or store that consumes it addresses through the chain instead
# opq_var: for a vreg holding an OPAQUE HANDLE, the descriptor variable it was
#          loaded from (#2794). SPIR-V forbids storing an image, sampler or
#          sampled-image object, so such a vreg gets no backing variable and cannot
#          round-trip through one; every use RE-LOADS from the variable named here,
#          which also makes the value trivially available in whatever block the use
#          sits in rather than depending on a definition dominating it
# opq_ssa: for a vreg holding a COMPUTED handle - the result of combining an image
#          with a sampler - the id itself, since there is no variable to re-load
#          from. SPIR-V requires such a result be consumed in the block that
#          produced it, so carrying the bare id is not a shortcut here but the
#          only shape the specification permits
# n:       number of vregs
rec VMaps {
    type_id: *u32;
    var_id:  *u32;
    is_bool: *bool;
    chain_id: *u32;
    chain_ty: *u32;
    chain_sc: *u32;
    opq_var: *u32;
    opq_ssa: *u32;
    n:       u32;
}

# the identity convention's nominal register file during one block's emission
#
# A value moved into "register" k is the k-th argument of the call that follows or
# the function's result, and both are typed by the callee's declaration, not by the
# move. An immediate therefore rides here unmaterialized: `is_imm` marks the slot as
# carrying `imm` rather than an id, and the constant is minted at the use site with
# the width the declaration asks for. A parameter's slot holds its
# OpFunctionParameter id from the start.
# ---
# val_id: the SSA id held in each register index (0 when empty or pending)
# imm:    the pending immediate value per register index
# is_imm: whether the slot holds a pending immediate rather than an id
rec Regs {
    val_id: [16]u32;
    imm:    [16]i64;
    is_imm: [16]bool;
}

# one defined function the emission unit offers, wherever it came from
#
# The flattening of the unit into a single namespace, and the reason a cross-module
# call needs no path of its own: once a callee is a table index, the emitter's own
# module and a module it drew a body from are indistinguishable. The pair
# (`mi`, `ir_ix`) is the only place the boundary is still visible, and it is
# visible exactly where it must be - reading a declaration against the type table
# that gave its type ids meaning.
#
# `mir_ix` is separate from `ir_ix` because the two orders are not the same: MIR
# lowering skips a declaration, so the n-th IR function is not the n-th MIR one.
# ---
# mi:     the unit member this function is defined in
# ir_ix:  its index in that member's IR functions
# mir_ix: its index in that member's MIR functions, or FN_NONE when it lowered no
#         body (an instruction-mapped callee is the case that matters)
# name:   its interned link name, cached so a call resolves without a nested walk
# id:     its SPIR-V id, minted only for a function that will be emitted (0
#         otherwise), so an id gap is a function the module deliberately dropped
# emit:   whether it is in the emitted closure
rec FnEnt {
    mi:     u32;
    ir_ix:  u32;
    mir_ix: u32;
    name:   intern.StrId;
    id:     u32;
    emit:   bool;
}

# one module-scope global the emission unit offers, wherever it came from
#
# The same flattening `FnEnt` performs, applied to the other namespace a body can
# name (#2843). It is deliberately the same shape rather than a variant of it: the
# pair (`mi`, `ir_ix`) is again the only place the module boundary stays visible,
# and again it is visible exactly where it has to be, reading a global's type
# against the type table that gave its type id meaning.
#
# WHY A GLOBAL NEEDS THIS AND A LOCAL DOES NOT. An interface variable is a
# module-scope `OpVariable` with decorations, and nothing in the emitted module
# records which mach module the source declaration sat in. So a shared module can
# own a descriptor set - the pattern a shader library reaches for the moment it
# owns anything beyond pure functions - and the only thing that ever stopped it was
# the emitter resolving every global against the root.
# ---
# mi:    the unit member this global is declared in
# ir_ix: its index in that member's IR globals
# name:  its interned link name, cached so a reference resolves without a nested
#        walk. module-path mangled and so globally unique, which is what lets a
#        single linear scan answer for the whole unit
rec GlobalEnt {
    mi:    u32;
    ir_ix: u32;
    name:  intern.StrId;
}

# emit a complete SPIR-V module for one lowered emission unit
#
# Builds the module preamble (Shader + Linkage capabilities, the logical GLSL450
# memory model), then emits one `OpFunction` per function in the emitted closure -
# wherever in the unit it was defined - and serializes the whole into a
# little-endian byte image. The bytes are allocated from the session allocator and
# handed back through the out-params; the `codegen_module` fork wraps them into an
# object image.
#
# The order of the work is forced by SPIR-V's fixed section order and by wanting
# every refusal to precede any partial emission:
#   1. flatten the unit into the function table,
#   2. decide the emitted closure by reachability, minting an id for each member
#      of it so a call can name a callee emitted later (or itself),
#   3. declare the interface variables (a global must precede its users),
#   4. the whole-module well-formedness checks, over the EMITTED set - what the
#      module carries is what its rules are stated about,
#   5. the bodies, in table order.
#
# This is the concrete `EmitModuleFn` the SPIR-V `ModuleEmitter.emit_module` erased
# pointer is cast back to. The allocator and interner ride the root MIR module.
# ---
# tgt:      the resolved target
# u:        the emission unit; its root is the module being compiled
# out_bytes: receives the owned little-endian module image
# out_len:   receives the image byte length
# ret:      true on success, or a precise error string
pub fun emit_module(tgt: *resolved.Target, u: *unit.Unit,
                    out_bytes: **u8, out_len: *u32) R.Result[bool, str] {
    if (tgt == nil || u == nil || u.len == 0 || u.mods == nil) {
        ret R.err[bool, str]("spirv.emit: nil argument");
    }
    val irmod:  *ir.Module     = unit.root_ir(u);
    val mirmod: *mir.MirModule = unit.root_mir(u);
    if (irmod == nil || mirmod == nil) { ret R.err[bool, str]("spirv.emit: nil argument"); }

    var b: spirv.Builder = spirv.builder_init(mirmod.alloc);
    var tt: types.TypeTable = types.types_init(?b);

    var e: Emit;
    e.alloc = mirmod.alloc; e.interner = mirmod.interner;
    e.tgt = tgt; e.u = u; e.root = irmod; e.ir = irmod; e.cur_mi = u.root;
    e.b = ?b; e.tt = ?tt; e.fns = nil; e.fn_len = 0; e.gls = nil; e.gl_len = 0;
    e.gvar_ids = nil; e.gtype_ids = nil; e.gstorage = nil; e.iface_ids = nil; e.iface_len = 0;
    e.gslot = nil; e.iface_use = nil; e.gwrite = nil;
    var xi: u32 = 0;
    for (xi < 8) { e.ext_ids[xi] = 0; xi = xi + 1; }
    e.srcmap = mirmod.srcmap; e.cur_fn = nil; e.cur_instr = nil;

    # a module is a shader module or a library module, never both, and which one is
    # settled before any function is emitted: the answer decides both the capability
    # set and whether each function is published under a linkage export. It is a
    # property of the ROOT alone - a drawn-in helper cannot make its consumer a
    # shader, and a shader importing a library does not become one.
    e.has_entry = false;
    var si: u32 = 0;
    for (si < irmod.function_len) {
        if (irmod.functions[si].stage != ir.STAGE_NONE
            && (irmod.functions[si].flags & ir.FN_FLAG_EXTERN) == 0) { e.has_entry = true; }
        si = si + 1;
    }

    val tr: R.Result[bool, str] = build_fn_table(?e);
    if (R.is_err[bool, str](tr)) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret tr;
    }

    val rr: R.Result[bool, str] = mark_emitted(?e);
    if (R.is_err[bool, str](rr)) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret rr;
    }

    # the global table is built after the emitted closure is known, because a
    # drawn-in member contributes the globals that closure REACHES and nothing else
    # (#2843). The root's own are in it either way.
    val gtr: R.Result[bool, str] = build_gl_table(?e);
    if (R.is_err[bool, str](gtr)) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret gtr;
    }

    # which descriptors the module stores through is decided before they are
    # declared, because it is a decoration ON the declaration: `NonWritable` is
    # emitted with the variable, and the fact it states is about every body in the
    # closure rather than about the one being emitted (#2879).
    val wr: R.Result[bool, str] = build_gl_writes(?e);
    if (R.is_err[bool, str](wr)) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret wr;
    }

    # interface variables are declared before any body, both because a SPIR-V global
    # must precede the functions that use it and because every entry point has to
    # name the same interface list.
    val gr: R.Result[bool, str] = declare_interface(?e);
    if (R.is_err[bool, str](gr)) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret gr;
    }

    val ur: R.Result[bool, str] = build_iface_uses(?e);
    if (R.is_err[bool, str](ur)) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret ur;
    }

    # whole-module well-formedness, before any body is emitted so a refusal precedes
    # partial emission: the rules here are about the module rather than about one
    # instruction, and have nowhere else to live.
    val cgr: R.Result[bool, str] = check_call_graph(?e);
    if (R.is_err[bool, str](cgr)) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret cgr;
    }

    val sir: R.Result[bool, str] = check_stage_interfaces(?e);
    if (R.is_err[bool, str](sir)) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret sir;
    }

    var fi: u32 = 0;
    for (fi < e.fn_len) {
        if (!e.fns[fi].emit) { fi = fi + 1; cnt; }
        val fr: R.Result[bool, str] = emit_function(?e, fi);
        if (R.is_err[bool, str](fr)) {
            emit_dnit(?e);
            types.types_dnit(?tt);
            spirv.builder_dnit(?b);
            ret fr;
        }
        fi = fi + 1;
    }
    emit_dnit(?e);

    # the preamble is emitted last so it can declare exactly the width capabilities
    # the functions' types accumulated; it still serializes first (fixed section order).
    emit_preamble(?e);

    var len: u32 = 0;
    val rs: R.Result[*u8, str] = spirv.serialize(?b, ?len);
    types.types_dnit(?tt);
    spirv.builder_dnit(?b);
    if (R.is_err[*u8, str](rs)) { ret R.err[bool, str](R.unwrap_err[*u8, str](rs)); }
    @out_bytes = R.unwrap_ok[*u8, str](rs);
    @out_len   = len;
    ret R.ok[bool, str](true);
}

# release the unit function table and the per-module global tables
#
# Reads its own lengths off the state rather than taking them as an argument: the
# function table's length is the unit's, not any one module's, and having the
# caller carry it was already the kind of shared assumption that goes stale the
# moment the table stops being one module wide.
# ---
# e: the emission state
fun emit_dnit(e: *Emit) {
    if (e.iface_use != nil && e.fn_len > 0 && e.iface_len > 0) {
        A.deallocate[u8](e.alloc, e.iface_use, (e.fn_len * e.iface_len)::usize);
    }
    e.iface_use = nil;
    e.iface_len = 0;
    if (e.fns != nil && e.fn_len > 0) { A.deallocate[FnEnt](e.alloc, e.fns, e.fn_len::usize); }
    e.fns    = nil;
    e.fn_len = 0;
    if (e.gvar_ids != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gvar_ids, e.gl_len::usize);
    }
    e.gvar_ids = nil;
    if (e.iface_ids != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.iface_ids, e.gl_len::usize);
    }
    e.iface_ids = nil;
    if (e.gslot != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gslot, e.gl_len::usize);
    }
    e.gslot = nil;
    if (e.gtype_ids != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gtype_ids, e.gl_len::usize);
    }
    e.gtype_ids = nil;
    if (e.gstorage != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gstorage, e.gl_len::usize);
    }
    e.gstorage = nil;
    if (e.gwrite != nil && e.gl_len > 0) {
        A.deallocate[u8](e.alloc, e.gwrite, e.gl_len::usize);
    }
    e.gwrite = nil;
    # the table itself last: every free above is sized by its length.
    if (e.gls != nil && e.gl_len > 0) { A.deallocate[GlobalEnt](e.alloc, e.gls, e.gl_len::usize); }
    e.gls    = nil;
    e.gl_len = 0;
}

# flatten every defined function in the unit into one table
#
# THE ROOT COMES FIRST, and its functions keep their IR order. That is not
# cosmetic: it makes the table an extension of what a single-module emission
# already was, so a module drawing nothing in emits exactly what it did before.
# Members follow in the order the driver assembled them, which the driver fixed to
# the build's topo order, so the table - and every id derived from it - is
# deterministic for a given input.
#
# Only DEFINED functions are entered. A body-less declaration is the caller's
# shadow of someone else's function, and the whole point of the table is that the
# definition is found once and named the same way everywhere.
# ---
# e:   the emission state
# ret: true on success, or an allocation error
fun build_fn_table(e: *Emit) R.Result[bool, str] {
    var n: u32 = 0;
    var mi: u32 = 0;
    for (mi < e.u.len) {
        val m: *ir.Module = e.u.mods[mi].ir;
        var i: u32 = 0;
        for (i < m.function_len) {
            if ((m.functions[i].flags & ir.FN_FLAG_EXTERN) == 0) { n = n + 1; }
            i = i + 1;
        }
        mi = mi + 1;
    }
    if (n == 0) { ret R.ok[bool, str](true); }

    val rt: R.Result[*FnEnt, str] = A.allocate[FnEnt](e.alloc, n::usize);
    if (R.is_err[*FnEnt, str](rt)) { ret R.err[bool, str](R.unwrap_err[*FnEnt, str](rt)); }
    e.fns    = R.unwrap_ok[*FnEnt, str](rt);
    e.fn_len = n;

    var k: u32 = 0;
    var pass: u32 = 0;
    # two passes so the root's entries lead the table whatever its unit index is.
    for (pass < 2) {
        mi = 0;
        for (mi < e.u.len) {
            val is_root: bool = mi == e.u.root;
            if ((pass == 0) != is_root) { mi = mi + 1; cnt; }
            val m: *ir.Module = e.u.mods[mi].ir;
            var i: u32 = 0;
            for (i < m.function_len) {
                if ((m.functions[i].flags & ir.FN_FLAG_EXTERN) != 0) { i = i + 1; cnt; }
                e.fns[k].mi     = mi;
                e.fns[k].ir_ix  = i;
                e.fns[k].name   = m.functions[i].name;
                e.fns[k].mir_ix = unit.mir_index(e.u, mi, m.functions[i].name);
                e.fns[k].id     = 0;
                e.fns[k].emit   = false;
                k = k + 1;
                i = i + 1;
            }
            mi = mi + 1;
        }
        pass = pass + 1;
    }
    ret R.ok[bool, str](true);
}

# decide which functions the output carries, and mint an id for each
#
# WALKING FROM THE ENTRIES IS WHAT KEEPS THE OUTPUT SMALL. A shader module's roots
# are its entry points, so importing a shared module costs the helpers actually
# called and nothing else - the unreachable rest of that module never reaches the
# output at all. A library module has no entry points; its own functions are its
# roots, since a consumer may call any of them through the linkage exports, and it
# publishes exactly what it did before.
#
# A function that IS a SPIR-V instruction is never emitted and never a root: it
# has a mach body - that is what makes `shader.math` a real library on a CPU
# target rather than a set of declarations - but on this target every call to it
# becomes the instruction. Emitting it anyway would be worse than dead weight: the
# native body is written in terms of the bit manipulation a CPU needs, which is
# exactly what logical addressing refuses, so the module would fail to build over
# code nothing calls. A body-less entry is skipped for the same reason it is not a
# call edge - there is nothing to emit.
#
# Ids are minted only for the survivors, and in table order, so the numbering is a
# function of the emitted set alone.
# ---
# e:   the emission state
# ret: true on success, or an allocation error
fun mark_emitted(e: *Emit) R.Result[bool, str] {
    if (e.fn_len == 0) { ret R.ok[bool, str](true); }

    var i: u32 = 0;
    for (i < e.fn_len) {
        val fn: *ir.Function = fn_ir(e, i);
        val root_fn: bool = e.fns[i].mi == e.u.root;
        var seed: bool = false;
        if (e.has_entry) { seed = root_fn && fn.stage != ir.STAGE_NONE; }
        or              { seed = root_fn; }
        if (seed && emittable(e, i)) { e.fns[i].emit = true; }
        i = i + 1;
    }

    var changed: bool = true;
    for (changed) {
        changed = false;
        i = 0;
        for (i < e.fn_len) {
            if (!e.fns[i].emit) { i = i + 1; cnt; }
            var ci: u32 = 0;
            for (ci < callee_count(e, i)) {
                val cx: u32 = callee_at(e, i, ci);
                if (cx != FN_NONE && !e.fns[cx].emit && emittable(e, cx)) {
                    e.fns[cx].emit = true;
                    changed = true;
                }
                ci = ci + 1;
            }
            i = i + 1;
        }
    }

    i = 0;
    for (i < e.fn_len) {
        if (e.fns[i].emit) { e.fns[i].id = spirv.alloc_id(e.b); }
        i = i + 1;
    }
    ret R.ok[bool, str](true);
}

# whether a table entry can contribute an OpFunction at all
# ---
# e:  the emission state
# ix: the table index
# ret: true when it has a body to emit and is not an instruction mapping
fun emittable(e: *Emit, ix: u32) bool {
    val fn: *ir.Function = fn_ir(e, ix);
    if (fn.op_set != defs.SPV_SET_NONE) { ret false; }
    val mf: *mir.MirFunction = fn_mir(e, ix);
    if (mf == nil || mf.block_count == 0)   { ret false; }
    ret true;
}

# how many call instructions one table entry's body carries
#
# The count and the accessor are a pair rather than one walk with a callback,
# because two different walks need the edges - the reachability closure and the
# cycle check - and neither wants the other's bookkeeping.
# ---
# e:  the emission state
# ix: the table index
# ret: the number of MIR_CALL instructions in its body
fun callee_count(e: *Emit, ix: u32) u32 {
    val mf: *mir.MirFunction = fn_mir(e, ix);
    if (mf == nil) { ret 0; }
    var n: u32 = 0;
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            if (blk.instrs[ii].opcode == mir.MIR_CALL) { n = n + 1; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret n;
}

# the table index the `k`-th call in one entry's body names, or FN_NONE
#
# FN_NONE covers three different things and deliberately does not distinguish
# them - an indirect call, a foreign import, and a callee that IS an instruction
# are all "not an edge in this graph". Each is refused, or substituted, at the
# call site itself, where the instruction that caused it is in hand.
# ---
# e:  the emission state
# ix: the calling entry's table index
# k:  which call in its body, in walk order
# ret: the callee's table index, or FN_NONE
fun callee_at(e: *Emit, ix: u32, k: u32) u32 {
    val mf: *mir.MirFunction = fn_mir(e, ix);
    if (mf == nil) { ret FN_NONE; }
    var n: u32 = 0;
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mi.opcode == mir.MIR_CALL) {
                if (n == k) {
                    if (mi.operand_count < 1 || mi.operands[0].kind != mir.MIR_OP_SYM) { ret FN_NONE; }
                    ret fn_lookup(e, mi.operands[0].sym);
                }
                n = n + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret FN_NONE;
}

# the table index of the function with the given link name, or FN_NONE
#
# One linear scan over the cached names, and the ONLY way a callee is resolved.
# The name is globally unique (module-path mangled), so at most one entry answers.
# ---
# e:    the emission state
# name: the interned link name
# ret:  the table index, or FN_NONE
fun fn_lookup(e: *Emit, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < e.fn_len) {
        if (e.fns[i].name == name) { ret i; }
        i = i + 1;
    }
    ret FN_NONE;
}

# the IR record behind a table entry
fun fn_ir(e: *Emit, ix: u32) *ir.Function {
    ret ?e.u.mods[e.fns[ix].mi].ir.functions[e.fns[ix].ir_ix];
}

# the IR module a table entry was defined in - the type table its ids belong to
fun fn_mod(e: *Emit, ix: u32) *ir.Module {
    ret e.u.mods[e.fns[ix].mi].ir;
}

# the lowered body behind a table entry, or nil when it lowered none
fun fn_mir(e: *Emit, ix: u32) *mir.MirFunction {
    if (e.fns[ix].mir_ix == FN_NONE) { ret nil; }
    ret ?e.u.mods[e.fns[ix].mi].mir.functions[e.fns[ix].mir_ix];
}

# flatten the unit's reachable globals into one table (#2843)
#
# THE ROOT'S GLOBALS COME FIRST, all of them, in IR order. That is what keeps a
# module drawing nothing in emitting exactly the bytes it emitted before: the table
# is then the root's global list with the same indices it always had, and every id
# minted off it is unchanged.
#
# A NON-ROOT MEMBER CONTRIBUTES BY REACHABILITY, NOT BY MEMBERSHIP, which is the
# same rule the function table already states and is not a convenience here. A
# shared module may declare a whole descriptor set; a shader importing it for one
# helper must not inherit the rest, both because the module would grow without
# bound and because two unrelated libraries could then collide on a binding that
# neither the shader nor either author ever used. So a member's global is entered
# only when an EMITTED function names it.
#
# The root is exempt from that filter deliberately. Its interface list is the
# module's pipeline contract, declared whole whether or not a stage happens to read
# every part of it, and narrowing it here would change what existing shaders emit.
#
# ONLY DECLARATIONS ARE ENTERED, never an extern shadow, for the reason the function
# table states and one more that is specific to globals. A consumer's shadow of
# someone else's variable is minted by `ensure_extern_global` against the
# CONSUMER's type table, so its type id means nothing outside that module: reading
# it as the variable's type would resolve to whatever type sits at the same index
# there, which is a wrong type silently rather than a failure. The definition is
# found once, in the module that made it, and every reference resolves to that.
# ---
# e:   the emission state
# ret: true on success, or an allocation error
fun build_gl_table(e: *Emit) R.Result[bool, str] {
    var n: u32 = 0;
    var i0: u32 = 0;
    for (i0 < e.root.global_len) {
        if (gl_eligible(?e.root.globals[i0])) { n = n + 1; }
        i0 = i0 + 1;
    }
    var mi: u32 = 0;
    for (mi < e.u.len) {
        if (mi == e.u.root) { mi = mi + 1; cnt; }
        val m: *ir.Module = e.u.mods[mi].ir;
        var i: u32 = 0;
        for (i < m.global_len) {
            if (gl_eligible(?m.globals[i]) && global_is_reached(e, m.globals[i].name)) { n = n + 1; }
            i = i + 1;
        }
        mi = mi + 1;
    }
    if (n == 0) { ret R.ok[bool, str](true); }

    val rt: R.Result[*GlobalEnt, str] = A.allocate[GlobalEnt](e.alloc, n::usize);
    if (R.is_err[*GlobalEnt, str](rt)) { ret R.err[bool, str](R.unwrap_err[*GlobalEnt, str](rt)); }
    e.gls    = R.unwrap_ok[*GlobalEnt, str](rt);
    e.gl_len = n;

    var k: u32 = 0;
    var i2: u32 = 0;
    for (i2 < e.root.global_len) {
        if (!gl_eligible(?e.root.globals[i2])) { i2 = i2 + 1; cnt; }
        e.gls[k].mi    = e.u.root;
        e.gls[k].ir_ix = i2;
        e.gls[k].name  = e.root.globals[i2].name;
        k = k + 1;
        i2 = i2 + 1;
    }
    mi = 0;
    for (mi < e.u.len) {
        if (mi == e.u.root) { mi = mi + 1; cnt; }
        val m: *ir.Module = e.u.mods[mi].ir;
        var i: u32 = 0;
        for (i < m.global_len) {
            if (!gl_eligible(?m.globals[i]) || !global_is_reached(e, m.globals[i].name)) { i = i + 1; cnt; }
            e.gls[k].mi    = mi;
            e.gls[k].ir_ix = i;
            e.gls[k].name  = m.globals[i].name;
            k = k + 1;
            i = i + 1;
        }
        mi = mi + 1;
    }
    ret R.ok[bool, str](true);
}

# decide, for every global in the table, whether a store can reach it (#2879)
#
# A storage buffer nothing writes is `NonWritable`, and Vulkan reads that
# decoration to decide whether a stage needs `vertexPipelineStoresAndAtomics`. So
# the question "does the MODULE ever store through this binding" is worth a pass:
# it is the common case, it is decidable here, and the answer is free where it is
# yes and costs a hardware feature where it is wrongly no.
#
# THE ANSWER IS ONE-SIDED ON PURPOSE. A wrong "written" costs a decoration. A wrong
# "not written" is a miscompile - a module that promises the driver something it
# then does. So the rule is not "find the stores", it is "prove there are none",
# and everything that is not a proven read counts against the proof. Two positions
# are reads: the ADDRESS of a load, and the base of an access chain, whose own
# result is then subject to the same question. Every other appearance of the
# binding or of a pointer derived from it - a store's destination, a memzero, a
# call argument, a copy into a vreg this pass does not follow - marks it written,
# whether or not the emitter would go on to accept the instruction.
#
# THE SCAN IS OVER THE EMITTED CLOSURE, the same set every other whole-module
# decision here is stated about: a function the module drops carries no store a
# driver can execute. A drawn-in library body is in that closure, so a store from
# another module counts exactly as a local one does (#2843).
#
# It doubles as the enforcement of `#[storage(set, binding, "readonly")]`. Sema
# refuses the store that is WRITTEN as an assignment, which is the spelling an
# author reaches for. This refuses a store the emitter can still see after
# lowering, so the decoration can never be a promise the module breaks.
# ---
# e:   the emission state
# ret: true on success, an allocation error, or the readonly refusal
fun build_gl_writes(e: *Emit) R.Result[bool, str] {
    if (e.gl_len == 0) { ret R.ok[bool, str](true); }
    val rw: R.Result[*u8, str] = A.allocate[u8](e.alloc, e.gl_len::usize);
    if (R.is_err[*u8, str](rw)) { ret R.err[bool, str](R.unwrap_err[*u8, str](rw)); }
    e.gwrite = R.unwrap_ok[*u8, str](rw);
    var i: u32 = 0;
    for (i < e.gl_len) { e.gwrite[i] = 0; i = i + 1; }

    var fx: u32 = 0;
    for (fx < e.fn_len) {
        if (!e.fns[fx].emit) { fx = fx + 1; cnt; }
        val mf: *mir.MirFunction = fn_mir(e, fx);
        if (mf == nil) { fx = fx + 1; cnt; }
        val r: R.Result[bool, str] = scan_fn_writes(e, fx, mf);
        if (R.is_err[bool, str](r)) { ret r; }
        fx = fx + 1;
    }
    ret R.ok[bool, str](true);
}

# mark every global one function can store through
#
# Two walks. The first gives each vreg the global its pointer was derived from, by
# following access chains from their base, and iterates to a fixed point because a
# chain's base may be defined by a later instruction in program order, which a loop
# makes ordinary. The second asks of every operand carrying such a pointer - or
# naming a global outright - whether its position is one of the two that only read.
# ---
# e:   the emission state
# fx:  the unit function-table index, for the refusal's function name
# mf:  the MIR function
# ret: true on success, an allocation error, or the readonly refusal
fun scan_fn_writes(e: *Emit, fx: u32, mf: *mir.MirFunction) R.Result[bool, str] {
    val n: u32 = mf.vreg_count;
    var origin: *u32 = nil;
    if (n > 0) {
        val ro: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
        if (R.is_err[*u32, str](ro)) { ret R.err[bool, str](R.unwrap_err[*u32, str](ro)); }
        origin = R.unwrap_ok[*u32, str](ro);
        var v: u32 = 0;
        for (v < n) { origin[v] = GL_NONE; v = v + 1; }
    }

    var changed: bool = true;
    for (changed) {
        changed = false;
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                ii = ii + 1;
                if (mi.opcode != mir.MIR_GEP || mi.operand_count < 2) { cnt; }
                if (mi.operands[0].kind != mir.MIR_OP_VREG) { cnt; }
                val dst: u32 = mi.operands[0].vreg;
                if (origin == nil || dst == mir.MIR_VREG_NIL || dst >= n) { cnt; }
                val g: u32 = operand_origin(e, origin, n, ?mi.operands[1]);
                if (g == GL_NONE || origin[dst] == g) { cnt; }
                # a vreg reached from two bases is followed no further: both are
                # marked written, since a store through it would reach either.
                if (origin[dst] != GL_NONE) {
                    val ra: R.Result[bool, str] = mark_written(e, fx, mi, origin[dst]);
                    if (R.is_err[bool, str](ra)) { A.deallocate[u32](e.alloc, origin, n::usize); ret ra; }
                    val rb: R.Result[bool, str] = mark_written(e, fx, mi, g);
                    if (R.is_err[bool, str](rb)) { A.deallocate[u32](e.alloc, origin, n::usize); ret rb; }
                    cnt;
                }
                origin[dst] = g;
                changed = true;
            }
            bi = bi + 1;
        }
    }

    var bi2: u32 = 0;
    for (bi2 < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi2];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            var oi: u32 = 0;
            for (oi < mi.operand_count) {
                val g: u32 = operand_origin(e, origin, n, ?mi.operands[oi]);
                if (g == GL_NONE) { oi = oi + 1; cnt; }
                if (mi.opcode == mir.MIR_LOAD && oi == 1) { oi = oi + 1; cnt; }
                if (mi.opcode == mir.MIR_GEP && oi < 2)   { oi = oi + 1; cnt; }
                val rm: R.Result[bool, str] = mark_written(e, fx, mi, g);
                if (R.is_err[bool, str](rm)) {
                    if (origin != nil) { A.deallocate[u32](e.alloc, origin, n::usize); }
                    ret rm;
                }
                oi = oi + 1;
            }
            ii = ii + 1;
        }
        bi2 = bi2 + 1;
    }
    if (origin != nil) { A.deallocate[u32](e.alloc, origin, n::usize); }
    ret R.ok[bool, str](true);
}

# the global an operand's pointer was derived from, or GL_NONE
#
# A symbol operand names its global whatever displacement rides on it, and a
# register operand names whatever the derivation walk recorded for that vreg. The
# displacement is deliberately not read: it changes which BYTES an access reaches,
# never which binding, and this pass answers only the second question.
# ---
# e:      the emission state
# origin: the per-vreg derivation map, or nil for a function with no vregs
# n:      the map's length
# op:     the operand
# ret:    the global-table index, or GL_NONE
fun operand_origin(e: *Emit, origin: *u32, n: u32, op: *mir.MirOperand) u32 {
    if (op.kind == mir.MIR_OP_SYM) { ret gl_lookup(e, op.sym); }
    if (op.kind != mir.MIR_OP_VREG && op.kind != mir.MIR_OP_MEM) { ret GL_NONE; }
    if (origin == nil || op.vreg == mir.MIR_VREG_NIL || op.vreg >= n) { ret GL_NONE; }
    ret origin[op.vreg];
}

# record that a store can reach global `gix`, and refuse it when the binding said
# it would not be written
# ---
# e:   the emission state
# fx:  the unit function-table index the store sits in
# mi:  the instruction the store arrived as
# gix: the global-table index
# ret: true, or the refusal
fun mark_written(e: *Emit, fx: u32, mi: *mir.MirInstr, gix: u32) R.Result[bool, str] {
    if (gix >= e.gl_len || e.gwrite == nil) { ret R.ok[bool, str](true); }
    if (e.gwrite[gix] != 0) { ret R.ok[bool, str](true); }
    e.gwrite[gix] = 1;
    val g: *ir.Global = gl_ir(e, gix);
    if (g.iface != ir.IFACE_STORAGE || (g.iface_flags & ir.IFACE_FLAG_READONLY) == 0) {
        ret R.ok[bool, str](true);
    }
    val r: R.Result[str, str] = format.sprint(e.alloc,
        "a store reaches the `#[storage({}, {}, \"readonly\")]` binding{}: the qualifier declares that nothing writes it, which is what lets this module mark the descriptor `NonWritable` and a vertex stage read it without `vertexPipelineStoresAndAtomics`. drop the `\"readonly\"` qualifier to write it",
        g.iface_a, g.iface_b, gl_mod_prefix(e, gix));
    if (R.is_err[str, str](r)) {
        ret R.err[bool, str]("spirv.emit: a store reaches a `\"readonly\"` storage binding");
    }
    ret R.err[bool, str](mir.instr_refusal(e.alloc, e.srcmap, ir_fn_spelling(e, fx), mi,
                                           R.unwrap_ok[str, str](r)));
}

# whether a store can reach the global at table index `ix`
# ---
# e:  the emission state
# ix: the global-table index
# ret: true unless the module was proved never to store through it
fun gl_written(e: *Emit, ix: u32) bool {
    if (e.gwrite == nil || ix >= e.gl_len) { ret true; }
    ret e.gwrite[ix] != 0;
}

# whether any EMITTED function names this global
#
# A reference reaches the back end as a symbol operand carrying the global's
# mangled name, which is the same key `address_origin` resolves against, so asking
# the question here and answering it there cannot drift.
#
# The scan is over the emitted closure rather than the whole unit for the reason
# `build_gl_table` states: a function the module dropped brings nothing with it.
# ---
# e:    the emission state
# name: the global's interned link name
# ret:  true when some emitted body carries a symbol operand naming it
fun global_is_reached(e: *Emit, name: intern.StrId) bool {
    var fx: u32 = 0;
    for (fx < e.fn_len) {
        if (!e.fns[fx].emit) { fx = fx + 1; cnt; }
        val mf: *mir.MirFunction = fn_mir(e, fx);
        if (mf == nil) { fx = fx + 1; cnt; }
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                var oi: u32 = 0;
                for (oi < mi.operand_count) {
                    if (mi.operands[oi].kind == mir.MIR_OP_SYM
                        && mi.operands[oi].sym == name) { ret true; }
                    oi = oi + 1;
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        fx = fx + 1;
    }
    ret false;
}

# whether an IR global is a DECLARATION this unit can resolve against
# ---
# g:   the IR global
# ret: false for an extern shadow of a definition that lives elsewhere
fun gl_eligible(g: *ir.Global) bool {
    ret !g.is_extern && !g.is_import;
}

# the IR record behind a global-table entry
fun gl_ir(e: *Emit, ix: u32) *ir.Global {
    ret ?e.u.mods[e.gls[ix].mi].ir.globals[e.gls[ix].ir_ix];
}

# the type table a global-table entry's type ids belong to
#
# The whole reason `GlobalEnt` carries `mi`. A global declared in a drawn-in member
# types against THAT member's table, and reading it against the root's would resolve
# the id to whatever type happens to sit at the same index there - a wrong type
# silently, not a failure.
fun gl_types(e: *Emit, ix: u32) *type.IrTypeTable {
    ret ?e.u.mods[e.gls[ix].mi].ir.types;
}

# the global-table index for an interned link name, or GL_NONE
fun gl_lookup(e: *Emit, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < e.gl_len) {
        if (e.gls[i].name == name) { ret i; }
        i = i + 1;
    }
    ret GL_NONE;
}

# a global named for a diagnostic, qualified by its module when it is not the root's
#
# A collision between two modules' declarations is the case this exists for: a
# message naming two `camera`s helps nobody, and the module path is the only thing
# that distinguishes them. The root's own globals stay unqualified so an existing
# single-module diagnostic reads exactly as it did.
#
# IR keeps a global's MANGLED name and no source spelling, so the module path is
# what is available and the variable itself is named by the decorator the author
# wrote at each call site rather than by its symbol.
# ---
# e:  the emission state
# ix: the global-table index
# ret: the module path, or "" for a root global
fun gl_mod_prefix(e: *Emit, ix: u32) str {
    if (ix >= e.gl_len || e.gls[ix].mi == e.u.root) { ret ""; }
    val mo: O.Option[str] = intern.lookup(e.interner, e.u.mods[e.gls[ix].mi].ir.name);
    if (O.is_none[str](mo)) { ret ""; }
    val q: R.Result[str, str] = format.sprint(e.alloc, ", declared in `{}`", O.unwrap[str](mo));
    if (R.is_err[str, str](q)) { ret ""; }
    ret R.unwrap_ok[str, str](q);
}

# declare one global OpVariable per interface-roled global, with its decorations
#
# A shader stage does not receive its inputs or hand back its outputs through a
# call: it reads and writes module-scope variables in the Input, Output, Uniform,
# and StorageBuffer storage classes, and the pipeline binds them by the decorations
# attached here. So a mach global carrying `#[input(N)]`, `#[output(N)]`,
# `#[builtin("...")]`, `#[uniform(set, binding)]`, or `#[storage(set, binding)]`
# becomes one of those variables rather than an ordinary data symbol.
#
# Every variable declared here is a candidate for an entry point's interface list;
# which ones a given entry point actually names is decided later by reachability.
# ---
# e:   the emission state
# ret: true on success, or a precise error string
fun declare_interface(e: *Emit) R.Result[bool, str] {
    val n: u32 = e.gl_len;
    if (n == 0) { ret R.ok[bool, str](true); }

    val rg: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rg)) { ret R.err[bool, str](R.unwrap_err[*u32, str](rg)); }
    e.gvar_ids = R.unwrap_ok[*u32, str](rg);
    val ri: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](ri)) { ret R.err[bool, str](R.unwrap_err[*u32, str](ri)); }
    e.iface_ids = R.unwrap_ok[*u32, str](ri);

    val rs: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rs)) { ret R.err[bool, str](R.unwrap_err[*u32, str](rs)); }
    e.gslot = R.unwrap_ok[*u32, str](rs);
    val rt: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rt)) { ret R.err[bool, str](R.unwrap_err[*u32, str](rt)); }
    e.gtype_ids = R.unwrap_ok[*u32, str](rt);
    val rc: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rc)) { ret R.err[bool, str](R.unwrap_err[*u32, str](rc)); }
    e.gstorage = R.unwrap_ok[*u32, str](rc);

    var i: u32 = 0;
    for (i < n) { e.gvar_ids[i] = 0; e.iface_ids[i] = 0; e.gslot[i] = 0; e.gtype_ids[i] = 0; e.gstorage[i] = 0; i = i + 1; }

    i = 0;
    for (i < n) {
        val g: *ir.Global = gl_ir(e, i);
        val gt: *type.IrTypeTable = gl_types(e, i);
        if (g.iface == ir.IFACE_NONE) { i = i + 1; cnt; }

        # a built-in declared at a type other than the one SPIR-V specifies for it is
        # refused here rather than emitted mistyped: the module would be invalid and
        # the failure would surface from a validator instead of from the declaration
        # that caused it.
        # reported as a plain error rather than through `unsupported`: nothing is
        # being emitted yet, so there is no instruction and no current function to
        # attribute it to, and attributing it to `<unknown function>` would point a
        # reader away from the declaration that is the whole subject.
        if (g.iface == ir.IFACE_BUILTIN) {
            val br: str = builtin_type_refusal(gt, e.alloc, g.iface_a, g.ty);
            if (br != nil) { ret R.err[bool, str](br); }
        }

        var storage: u32 = spirv.STORAGE_INPUT;
        if (g.iface == ir.IFACE_OUTPUT)      { storage = spirv.STORAGE_OUTPUT; }
        or (g.iface == ir.IFACE_UNIFORM)     { storage = spirv.STORAGE_UNIFORM; }
        or (g.iface == ir.IFACE_STORAGE)     { storage = spirv.STORAGE_STORAGE_BUFFER; }
        # an opaque handle is UniformConstant and only UniformConstant: it is not
        # memory a shader reads through, it is a name the pipeline binds a descriptor
        # to, and Vulkan permits an image, sampler or sampled-image variable in no
        # other class (#2794).
        or (g.iface == ir.IFACE_SAMPLER)     { storage = spirv.STORAGE_UNIFORM_CONSTANT; }
        or (g.iface == ir.IFACE_BUILTIN)     { storage = builtin_storage(g.iface_a); }

        # the role and the type must agree, and the back end says so rather than
        # trusting the front end's own check: an `#[input]` of handle type would
        # otherwise be emitted as an Input-class opaque variable, which no Vulkan
        # environment accepts, and a `#[sampler]` of an ordinary type as a
        # UniformConstant block, which is a different descriptor entirely (#2794).
        val handle: bool = is_image_type(e, gt, g.ty);
        if (handle && g.iface != ir.IFACE_SAMPLER) {
            ret R.err[bool, str]("spirv.emit: an image handle carries an interface role other than `#[sampler(set, binding)]`; a handle is bound as a descriptor and reaches no other storage class");
        }
        if (!handle && g.iface == ir.IFACE_SAMPLER) {
            ret R.err[bool, str]("spirv.emit: a `#[sampler(set, binding)]` binding is not of an image handle type; a descriptor-bound block or buffer of an ordinary type is `#[uniform]` or `#[storage]`");
        }

        var value_ty: u32 = 0;
        if (g.iface == ir.IFACE_UNIFORM || g.iface == ir.IFACE_STORAGE) {
            # a descriptor-bound variable must be a Block-decorated struct: Vulkan
            # rejects a bare scalar or vector in either class outright, so the mach
            # type has to be a record and the block layout is emitted with it. The two
            # differ in their LAYOUT rules, which `block_type` takes as its posture.
            val ur: R.Result[u32, str] = block_type(e, gt, g.ty, g.iface == ir.IFACE_STORAGE);
            if (R.is_err[u32, str](ur)) { ret R.err[bool, str](R.unwrap_err[u32, str](ur)); }
            value_ty = R.unwrap_ok[u32, str](ur);
        }
        or { value_ty = global_spv_type(e, gt, g.ty); }
        if (value_ty == 0) {
            ret unsupported(e, "unsupported shader interface variable type in the SPIR-V target");
        }
        val ptr_ty: u32 = types.type_ptr(e.tt, storage, value_ty);
        val var_id: u32 = spirv.alloc_id(e.b);
        var vop: [3]u32;
        vop[0] = ptr_ty; vop[1] = var_id; vop[2] = storage;
        spirv.inst(e.b, ?e.b.types_consts, spirv.OP_VARIABLE, ?vop[0], 3);
        e.gvar_ids[i]  = var_id;
        e.gtype_ids[i] = value_ty;
        e.gstorage[i]  = storage;

        if (g.iface == ir.IFACE_INPUT || g.iface == ir.IFACE_OUTPUT) {
            decorate(e, var_id, spirv.DECOR_LOCATION, g.iface_a);
        }
        if (g.iface == ir.IFACE_BUILTIN) {
            decorate(e, var_id, spirv.DECOR_BUILTIN, builtin_selector(g.iface_a));
        }
        if (g.iface == ir.IFACE_UNIFORM || g.iface == ir.IFACE_STORAGE
            || g.iface == ir.IFACE_SAMPLER) {
            decorate(e, var_id, spirv.DECOR_DESCRIPTOR_SET, g.iface_a);
            decorate(e, var_id, spirv.DECOR_BINDING, g.iface_b);
        }
        # a storage buffer no body in the module stores through is NonWritable, which
        # is what lets a vertex or geometry stage read it without
        # `vertexPipelineStoresAndAtomics` (#2879). A uniform is read-only by its
        # storage class and needs nothing said, and a sampler is not memory at all.
        if (g.iface == ir.IFACE_STORAGE && !gl_written(e, i)) {
            decorate_bare(e, var_id, spirv.DECOR_NON_WRITABLE);
        }
        # EVERY global an entry point statically uses belongs in its interface list,
        # of any storage class. That is a SPIR-V 1.4 change from the 1.3 rule of
        # Input and Output only, and this module declares 1.6. A descriptor that no
        # stage reads is still left out, since the list names what is USED - which
        # the per-function reachability pass decides, not this loop.
        e.iface_ids[e.iface_len] = var_id;
        e.gslot[i] = e.iface_len + 1;
        e.iface_len = e.iface_len + 1;
        i = i + 1;
    }
    ret R.ok[bool, str](true);
}

# build the Block-decorated struct type behind a uniform variable
#
# A Uniform variable's type is not the mach record directly: it is an
# `OpTypeStruct` carrying a `Block` decoration and an explicit `Offset` on every
# member. Vulkan requires all three - a bare scalar or vector in Uniform storage is
# rejected, and a block whose members carry no offsets has no defined layout for a
# host to write into. The offsets come from the same layout the rest of the
# compiler uses, so what the shader reads is what the host wrote.
# ---
# e:   the emission state
# id:  the IR type of the uniform global
# ret: the OpTypeStruct id, or a precise error string
fun block_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, relaxed_stride: bool) R.Result[u32, str] {
    val opt: O.Option[*type.IrType] = type.get(gt, id);
    if (O.is_none[*type.IrType](opt)) { ret R.err[u32, str]("spirv.emit: uniform global has no IR type"); }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);
    if (t.kind != type.IRT_STRUCT) {
        ret R.err[u32, str]("a `#[uniform(...)]` variable must be a `rec`: a uniform is a descriptor-bound BLOCK with a host-visible layout, and a bare scalar or vector has no block layout for a pipeline to bind. wrap the value in a record with one field");
    }
    val n: u32 = t.data.struct_.field_count;
    if (n == 0 || n > types.MAX_STRUCT_MEMBERS) {
        ret R.err[u32, str]("a `#[uniform(...)]` / `#[storage(...)]` block must have between 1 and 16 fields");
    }

    val sr: R.Result[u32, str] = laid_out_struct(e, gt, id, relaxed_stride);
    if (R.is_err[u32, str](sr)) { ret sr; }
    val struct_id: u32 = R.unwrap_ok[u32, str](sr);

    # only the OUTERMOST struct of a uniform is a Block; a nested one carries its
    # member offsets but not the decoration, which marks the descriptor's root.
    var bops: [2]u32;
    bops[0] = struct_id; bops[1] = spirv.DECOR_BLOCK;
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?bops[0], 2);
    ret R.ok[u32, str](struct_id);
}

# build a struct type with an explicit layout: every member offset decorated, and
# every aggregate member laid out the same way
# ---
# e:   the emission state
# id:  the IR struct type
# ret: the OpTypeStruct id, or a precise error string
fun laid_out_struct(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, relaxed_stride: bool) R.Result[u32, str] {
    val opt: O.Option[*type.IrType] = type.get(gt, id);
    if (O.is_none[*type.IrType](opt)) { ret R.err[u32, str]("spirv.emit: uniform block member has no IR type"); }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);
    val n: u32 = t.data.struct_.field_count;
    if (n == 0 || n > types.MAX_STRUCT_MEMBERS) {
        ret R.err[u32, str]("a `#[uniform(...)]` / `#[storage(...)]` block must have between 1 and 16 fields");
    }

    var members: [16]u32;
    var i: u32 = 0;
    for (i < n) {
        val mr: R.Result[u32, str] = laid_out_type(e, gt, t.data.struct_.fields[i], relaxed_stride);
        if (R.is_err[u32, str](mr)) { ret mr; }
        members[i] = R.unwrap_ok[u32, str](mr);
        i = i + 1;
    }

    # the offsets about to be decorated are mach's own, so they are checked against
    # the layout Vulkan requires BEFORE they are emitted, and a block whose members
    # disagree is refused rather than given a plausible wrong offset (#2746).
    val lr: R.Result[bool, str] = check_block_layout(e, gt, id, relaxed_stride);
    if (R.is_err[bool, str](lr)) { ret R.err[u32, str](R.unwrap_err[bool, str](lr)); }
    val struct_id: u32 = types.type_struct(e.tt, ?members[0], n, true);
    if (struct_id == 0) { ret R.err[u32, str]("spirv.emit: could not build a uniform block type"); }

    i = 0;
    for (i < n) {
        var mops: [4]u32;
        mops[0] = struct_id; mops[1] = i; mops[2] = spirv.DECOR_OFFSET;
        mops[3] = type.byte_offset(gt, id, i, e.tgt);
        spirv.inst(e.b, ?e.b.decorations, spirv.OP_MEMBER_DECORATE, ?mops[0], 4);
        i = i + 1;
    }
    ret R.ok[u32, str](struct_id);
}

# the type of one uniform-block member, laid out explicitly
#
# A scalar or vector member is its ordinary type. An aggregate member needs its own
# explicit layout: an array carries an `ArrayStride` and a nested struct carries its
# member offsets. Both must be minted FRESH rather than shared with the interned
# undecorated form, since the decoration is part of the type's identity here.
#
# The strides and offsets come from the compiler's own layout, so a host writing
# the block by `$offset_of` sees what the shader reads. That also means a layout
# rule Vulkan imposes and mach's layout does not satisfy is refused rather than
# quietly repacked - repacking would move the members out from under the host.
#
# WHICH RULES ARE ENFORCED, so the next reader is not told a guarantee broader than
# the code (#2746). `std_base_align` states the specification's base alignments and
# `check_block_layout` holds every emitted member offset to two conditions - a
# multiple of the member's base alignment, and past the end of the member before it
# - which together are what std140 and std430 require of a set of offsets. The
# array stride is held to `required_stride`. The two postures differ only in the
# 16-byte roundings std140 applies to an array and to a struct. Nothing else is
# checked because nothing else is a rule: neither layout bounds an offset from
# above, so a conforming set of offsets is one a Vulkan consumer accepts.
# ---
# e:   the emission state
# id:  the member's IR type
# ret: the member type id, or a precise error string
fun laid_out_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, relaxed_stride: bool) R.Result[u32, str] {
    val opt: O.Option[*type.IrType] = type.get(gt, id);
    if (O.is_none[*type.IrType](opt)) { ret R.err[u32, str]("spirv.emit: uniform block member has no IR type"); }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);

    if (t.kind == type.IRT_STRUCT) { ret laid_out_struct(e, gt, id, relaxed_stride); }

    if (t.kind == type.IRT_ARRAY) {
        val er: R.Result[u32, str] = laid_out_type(e, gt, t.data.array_.element, relaxed_stride);
        if (R.is_err[u32, str](er)) { ret er; }
        val elem_ty: u32 = R.unwrap_ok[u32, str](er);
        val stride: u32 = type.byte_size(gt, t.data.array_.element, e.tgt);
        # the emitted stride is mach's own element size, and the rule is that a
        # stride must be a multiple of the array's base alignment and no smaller
        # than what one element occupies. The two block classes differ only in that
        # alignment: a UNIFORM block rounds it up to 16 (std140) and a STORAGE
        # buffer does not (std430), which is why `[8]f32` is legal in one and not
        # the other. A disagreement is refused rather than repacked - repacking
        # would move the elements out from under a host writing by `$offset_of`.
        val want: u32 = required_stride(e, gt, t.data.array_.element, relaxed_stride);
        if (want == 0) {
            ret R.err[u32, str]("unsupported uniform block member type in the SPIR-V target");
        }
        if (stride != want) {
            val ar: R.Result[str, str] = format.sprint(e.alloc,
                "an array inside a `{}` block needs an element stride of {} bytes in the SPIR-V target, and mach's layout packs it at {}: a block's array stride is rounded up to the element's base alignment, which mach's own layout does not do, so the shader and the host would disagree about where the elements are. pad the element to {} bytes, or use an element that is that wide already (`f32x4`){}",
                block_role(relaxed_stride), want, stride, want, storage_hint(relaxed_stride));
            if (R.is_err[str, str](ar)) {
                ret R.err[u32, str]("an array inside a `#[uniform(...)]` / `#[storage(...)]` block has an element stride mach's layout does not give it");
            }
            ret R.err[u32, str](R.unwrap_ok[str, str](ar));
        }
        val arr_id: u32 = types.type_array(e.tt, elem_ty, t.data.array_.count, true);
        if (arr_id == 0) { ret R.err[u32, str]("spirv.emit: could not build a uniform block array type"); }
        var aops: [3]u32;
        aops[0] = arr_id; aops[1] = spirv.DECOR_ARRAY_STRIDE; aops[2] = stride;
        spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?aops[0], 3);
        ret R.ok[u32, str](arr_id);
    }

    val mt: u32 = global_spv_type(e, gt, id);
    if (mt == 0) {
        ret R.err[u32, str]("unsupported uniform block member type in the SPIR-V target");
    }
    ret R.ok[u32, str](mt);
}

# round `v` up to the next multiple of `a`
# ---
# v: the value
# a: the alignment, which must not be 0
# ret: the rounded value
fun round_up_to(v: u32, a: u32) u32 {
    if (a == 0) { ret v; }
    ret ((v + a - 1) / a) * a;
}

# the block posture's name, for a diagnostic
# ---
# std430: whether this is a storage buffer rather than a uniform block
# ret:    the decorator a reader wrote
fun block_role(std430: bool) str {
    if (std430) { ret "#[storage(...)]"; }
    ret "#[uniform(...)]";
}

# the clause pointing a uniform block at the looser posture, empty for a storage one
# ---
# std430: whether this is already a storage buffer
# ret:    the trailing sentence, or the empty string
fun storage_hint(std430: bool) str {
    if (std430) { ret ""; }
    ret ", and a `#[storage(...)]` buffer accepts any element width where read-write descriptor semantics are acceptable";
}

# the base alignment SPIR-V's explicit layout rules give a block member
#
# These are the std140 (uniform) and std430 (storage) rules from the specification,
# NOT a description of mach's layout - the whole point of having them is that the
# two can differ:
#
#   scalar          its own size
#   two-lane vector twice the lane size
#   three/four-lane four times the lane size
#   array           the element's, rounded up to 16 under std140
#   struct          the largest member's, rounded up to 16 under std140
#
# mach's layout agrees on scalars and on a vector that FILLS the vector register,
# and on nothing else. A vector narrower than the register aligns to one lane in
# mach (#2687), so an `f32x2` or an `f32x3` member is the reachable disagreement in
# BOTH postures, and a nested record is the reachable disagreement under std140,
# where mach's max-member alignment is not rounded up to 16.
# ---
# e:      the emission state
# id:     the member's IR type
# std430: the storage-buffer posture, which drops the 16-byte roundings
# ret:    the base alignment in bytes, or 0 for a type with no block layout
fun std_base_align(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, std430: bool) u32 {
    val opt: O.Option[*type.IrType] = type.get(gt, id);
    if (O.is_none[*type.IrType](opt)) { ret 0; }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);

    if (t.kind == type.IRT_STRUCT) {
        var a: u32 = 1;
        var i: u32 = 0;
        for (i < t.data.struct_.field_count) {
            val ma: u32 = std_base_align(e, gt, t.data.struct_.fields[i], std430);
            if (ma == 0) { ret 0; }
            if (ma > a) { a = ma; }
            i = i + 1;
        }
        if (!std430) { ret round_up_to(a, 16); }
        ret a;
    }
    if (t.kind == type.IRT_ARRAY) {
        val ea: u32 = std_base_align(e, gt, t.data.array_.element, std430);
        if (ea == 0) { ret 0; }
        if (!std430) { ret round_up_to(ea, 16); }
        ret ea;
    }
    if (t.kind == type.IRT_VECTOR) {
        val lane: u32 = type.byte_size(gt, t.data.vector_.element, e.tgt);
        if (t.data.vector_.lanes == 2) { ret 2 * lane; }
        ret 4 * lane;
    }
    if (t.kind == type.IRT_INT || t.kind == type.IRT_FLOAT) {
        ret type.byte_size(gt, id, e.tgt);
    }
    ret 0;
}

# how many bytes a block member occupies, given the offsets this emitter decorates
#
# This is not the member's std140 SIZE in the abstract: the offsets inside a nested
# struct are mach's own, so the extent has to be measured over them and only the
# trailing round-up to the struct's base alignment is a layout rule. That trailing
# round-up is exactly the std140 nested-struct rule, and it is what makes a
# following member's required offset 16 rather than mach's 8.
# ---
# e:      the emission state
# id:     the member's IR type
# std430: the storage-buffer posture
# ret:    the extent in bytes, or 0 for a type with no block layout
fun std_extent(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, std430: bool) u32 {
    val opt: O.Option[*type.IrType] = type.get(gt, id);
    if (O.is_none[*type.IrType](opt)) { ret 0; }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);

    if (t.kind == type.IRT_STRUCT) {
        val a: u32 = std_base_align(e, gt, id, std430);
        if (a == 0) { ret 0; }
        var end: u32 = 0;
        var i: u32 = 0;
        for (i < t.data.struct_.field_count) {
            val me: u32 = std_extent(e, gt, t.data.struct_.fields[i], std430);
            if (me == 0) { ret 0; }
            val moff: u32 = type.byte_offset(gt, id, i, e.tgt);
            if (moff + me > end) { end = moff + me; }
            i = i + 1;
        }
        ret round_up_to(end, a);
    }
    if (t.kind == type.IRT_ARRAY) {
        val s: u32 = required_stride(e, gt, t.data.array_.element, std430);
        if (s == 0) { ret 0; }
        ret s * t.data.array_.count;
    }
    ret type.byte_size(gt, id, e.tgt);
}

# the array stride SPIR-V's explicit layout rules require for an element type
#
# A stride is the element's extent rounded up to the ARRAY's base alignment, which
# under std140 is at least 16 and under std430 is the element's own.
# ---
# e:      the emission state
# elem:   the element's IR type
# std430: the storage-buffer posture
# ret:    the required stride in bytes, or 0 for a type with no block layout
fun required_stride(e: *Emit, gt: *type.IrTypeTable, elem: type.IrTypeId, std430: bool) u32 {
    var a: u32 = std_base_align(e, gt, elem, std430);
    if (a == 0) { ret 0; }
    if (!std430) { a = round_up_to(a, 16); }
    val ext: u32 = std_extent(e, gt, elem, std430);
    if (ext == 0) { ret 0; }
    ret round_up_to(ext, a);
}

# check one struct's emitted member offsets against the block layout rules
#
# Every member must start at a multiple of its base alignment and past the end of
# the one before it. Together those two conditions ARE std140 / std430 conformance
# for a set of offsets: the rules place no upper bound on an offset, only these two
# lower ones, so a layout satisfying both is one a Vulkan consumer accepts.
#
# Only this struct's own members are checked; a nested one is reached through
# `laid_out_struct` and checks itself.
# ---
# e:      the emission state
# id:     the IR struct type
# std430: the storage-buffer posture
# ret:    true when the offsets conform, or a diagnostic naming the member and rule
fun check_block_layout(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, std430: bool) R.Result[bool, str] {
    val opt: O.Option[*type.IrType] = type.get(gt, id);
    if (O.is_none[*type.IrType](opt)) { ret R.ok[bool, str](true); }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);

    var prev_end: u32 = 0;
    var i: u32 = 0;
    for (i < t.data.struct_.field_count) {
        val fty: type.IrTypeId = t.data.struct_.fields[i];
        val a: u32 = std_base_align(e, gt, fty, std430);
        # a member with no block layout at all is refused by `laid_out_type`, which
        # names the type; there is nothing to add here.
        if (a == 0) { i = i + 1; cnt; }
        val off: u32 = type.byte_offset(gt, id, i, e.tgt);

        if ((off % a) != 0 || off < prev_end) {
            var want: u32 = round_up_to(prev_end, a);
            if (want < round_up_to(off, a)) { want = round_up_to(off, a); }
            # the two conditions fail for different reasons and a reader needs to be
            # told which: a misaligned member is the member's own base alignment, and
            # an overlapping one is the member before it occupying more of the block
            # than mach's layout gives it.
            ret R.err[bool, str](layout_refusal(e, gt, std430, i, fty, off, want, a,
                                                off < prev_end, prev_end));
        }
        val ext: u32 = std_extent(e, gt, fty, std430);
        if (ext == 0) { i = i + 1; cnt; }
        prev_end = off + ext;
        i = i + 1;
    }
    ret R.ok[bool, str](true);
}

# the diagnostic for a member mach's layout places where the block rules do not
# ---
# e:        the emission state
# std430:   the storage-buffer posture
# ix:       the member's index within its block
# fty:      the member's IR type
# off:      the offset mach's layout gives it
# want:     the first offset the block rules allow
# align:    the member's base alignment under those rules
# overlaps: whether the member starts inside the one before it
# prev_end: where the member before it ends under those rules
# ret:      the composed diagnostic
fun layout_refusal(e: *Emit, gt: *type.IrTypeTable, std430: bool, ix: u32, fty: type.IrTypeId, off: u32,
                   want: u32, align: u32, overlaps: bool, prev_end: u32) str {
    var why: str = nil;
    if (overlaps) {
        val wr: R.Result[str, str] = format.sprint(e.alloc,
            "the member before it runs to offset {} under those rules and mach's layout ends it sooner, so the two overlap",
            prev_end);
        if (R.is_ok[str, str](wr)) { why = R.unwrap_ok[str, str](wr); }
    }
    or {
        val wr: R.Result[str, str] = format.sprint(e.alloc,
            "a member of this type has a base alignment of {} bytes under those rules and mach's layout does not place it on one",
            align);
        if (R.is_ok[str, str](wr)) { why = R.unwrap_ok[str, str](wr); }
    }
    if (why == nil) {
        ret "a member of this block is placed at an offset the SPIR-V block layout rules do not allow";
    }

    val r: R.Result[str, str] = format.sprint(e.alloc,
        "member {} of this `{}` block, a {}, is placed at offset {} by mach's layout and the SPIR-V block layout rules require offset {}: {}. the offsets are the host's contract, so this is refused rather than repacked - repacking would move the members out from under a host writing by `$offset_of`. pad the block explicitly so the member lands where the rules put it, or promote a nested record's members into the block{}",
        ix, block_role(std430), ir_type_spelling(gt, e.alloc, fty), off, want,
        why, storage_hint(std430));
    if (R.is_err[str, str](r)) {
        ret "a member of this block is placed at an offset the SPIR-V block layout rules do not allow";
    }
    ret R.unwrap_ok[str, str](r);
}

# compute, per unit function, which interface variables it can reach
#
# An entry point's interface list must name the Input and Output variables THAT
# entry point uses, not every one the module declares. Listing them all is legal
# SPIR-V from 1.4 on, but it makes each stage inherit every other stage's
# variables, and Vulkan's rules are per stage: an integer Input on a fragment entry
# point needs a Flat decoration, so a vertex stage's `vertex_index` dragged into a
# fragment stage's list makes that fragment stage invalid. The variable is not
# really the fragment stage's at all, so the fix is to stop claiming it.
#
# Reachability is transitive: a stage that calls a helper touching an interface
# variable uses that variable. The closure is a fixpoint over direct calls, which
# terminates because the matrix only ever gains entries. It runs over the whole
# unit table, so a helper drawn in from another module carries its uses back to
# the stage that called it - which for now is always an empty row, since interface
# variables belong to the root and no other module can name them, but the closure
# is over the call graph and the call graph is the unit's.
# ---
# e:   the emission state
# ret: true on success, or an allocation error
fun build_iface_uses(e: *Emit) R.Result[bool, str] {
    if (e.iface_len == 0 || e.fn_len == 0) { ret R.ok[bool, str](true); }
    val cells: u32 = e.fn_len * e.iface_len;
    val ru: R.Result[*u8, str] = A.allocate[u8](e.alloc, cells::usize);
    if (R.is_err[*u8, str](ru)) { ret R.err[bool, str](R.unwrap_err[*u8, str](ru)); }
    e.iface_use = R.unwrap_ok[*u8, str](ru);
    var c: u32 = 0;
    for (c < cells) { e.iface_use[c] = 0; c = c + 1; }

    # direct uses: any symbol operand naming an interface variable.
    var fx: u32 = 0;
    for (fx < e.fn_len) {
        val mf: *mir.MirFunction = fn_mir(e, fx);
        if (mf == nil) { fx = fx + 1; cnt; }
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                var oi: u32 = 0;
                for (oi < mi.operand_count) {
                    if (mi.operands[oi].kind == mir.MIR_OP_SYM) {
                        val slot: u32 = iface_slot_of(e, mi.operands[oi].sym);
                        if (slot != 0) { e.iface_use[fx * e.iface_len + slot - 1] = 1; }
                    }
                    oi = oi + 1;
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        fx = fx + 1;
    }

    # transitive closure over direct calls.
    var changed: bool = true;
    for (changed) {
        changed = false;
        fx = 0;
        for (fx < e.fn_len) {
            var ci: u32 = 0;
            for (ci < callee_count(e, fx)) {
                val cx: u32 = callee_at(e, fx, ci);
                if (cx != FN_NONE) {
                    var s: u32 = 0;
                    for (s < e.iface_len) {
                        if (e.iface_use[cx * e.iface_len + s] != 0
                            && e.iface_use[fx * e.iface_len + s] == 0) {
                            e.iface_use[fx * e.iface_len + s] = 1;
                            changed = true;
                        }
                        s = s + 1;
                    }
                }
                ci = ci + 1;
            }
            fx = fx + 1;
        }
    }
    ret R.ok[bool, str](true);
}

# whether a unit function can reach the interface variable in `slot`
# ---
# e:    the emission state
# fn_ix: the unit function-table index
# slot: the interface slot
# ret:  true when the function uses that variable
fun uses_iface(e: *Emit, fn_ix: u32, slot: u32) bool {
    if (e.iface_use == nil || fn_ix >= e.fn_len || slot >= e.iface_len) { ret false; }
    ret e.iface_use[fn_ix * e.iface_len + slot] != 0;
}

# one more than an interface variable's slot for an interned global name, or 0
# ---
# e:    the emission state
# name: the global's interned name
# ret:  slot + 1, or 0 when the name is not entry-point interface
fun iface_slot_of(e: *Emit, name: intern.StrId) u32 {
    if (e.gslot == nil) { ret 0; }
    val gx: u32 = gl_lookup(e, name);
    if (gx == GL_NONE) { ret 0; }
    ret e.gslot[gx];
}

# refuse a cycle in the module's static call graph
#
# A SPIR-V execution model has no call stack, so a function may not be reachable
# from itself. That is a rule about the MODULE rather than about any one
# instruction or function, and it is checked before a single body is emitted so the
# refusal precedes any partial emission.
#
# It is not left to the validator. `spirv-val` scopes its cycle rule to entry
# points, so a LIBRARY module carrying a cycle validates clean and fails later, in
# whatever consumer links it into a pipeline, far from the source that caused it.
#
# The walk is a genuine cycle detection over the whole graph rather than a
# self-call test. mach's surface makes a mutual cycle within ONE module hard to
# spell - a forward declaration of a name that is then defined is a duplicate
# definition - but across a module boundary it is not hard at all, and a cycle
# that only closes through another module is exactly what the unit made reachable
# (#2823). The check's input widened with the emitter's, so it catches those too.
#
# THE CHECK RUNS OVER WHAT THE MODULE EMITS, and that is one rule shared with
# every other whole-module decision here rather than a second, quietly different
# one. A function the module drops carries no cycle a consumer can execute, and
# refusing over it would mean a shader failing on the internals of a library it
# imported and never called - which is precisely what the reachability walk exists
# to keep out of the output. A library module emits all of its own functions, so
# #2748's case - a cycle in a module with no entry point, which `spirv-val` says
# nothing about - is checked exactly as it was.
# ---
# e:      the emission state
# ret:    true when the graph is acyclic, or a diagnostic naming the chain
fun check_call_graph(e: *Emit) R.Result[bool, str] {
    val n: u32 = e.fn_len;
    if (n == 0) { ret R.ok[bool, str](true); }

    val rs: R.Result[*u8, str] = A.allocate[u8](e.alloc, n::usize);
    if (R.is_err[*u8, str](rs)) { ret R.err[bool, str](R.unwrap_err[*u8, str](rs)); }
    val state: *u8 = R.unwrap_ok[*u8, str](rs);
    val rp: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rp)) {
        A.deallocate[u8](e.alloc, state, n::usize);
        ret R.err[bool, str](R.unwrap_err[*u32, str](rp));
    }
    val path: *u32 = R.unwrap_ok[*u32, str](rp);

    var i: u32 = 0;
    for (i < n) { state[i] = 0; path[i] = 0; i = i + 1; }

    var msg: str = nil;
    i = 0;
    for (i < n && msg == nil) {
        if (state[i] == 0 && e.fns[i].emit) { msg = cg_visit(e, state, path, 0, i); }
        i = i + 1;
    }

    A.deallocate[u8](e.alloc, state, n::usize);
    A.deallocate[u32](e.alloc, path, n::usize);
    if (msg != nil) { ret R.err[bool, str](msg); }
    ret R.ok[bool, str](true);
}

# depth-first visit of one call-graph node, reporting the first cycle it closes
#
# `state` is the usual three-colour marking: 0 unvisited, 1 on the current path, 2
# finished. A callee already on the path closes a cycle, and `path` holds the chain
# that reaches it, which is what makes the diagnostic name the whole loop rather
# than only its existence.
#
# The edges come from `callee_at`, so an instruction-mapped callee, an indirect
# call and a foreign import are all already non-edges: none of them is a body this
# module emits, so none can carry a cycle.
# ---
# e:      the emission state
# state:  the per-function colour
# path:   the current DFS path, `depth` entries deep
# depth:  the current path length
# ix:     the unit function-table index to visit
# ret:    nil when this subtree is acyclic, or the diagnostic
fun cg_visit(e: *Emit, state: *u8, path: *u32, depth: u32, ix: u32) str {
    state[ix] = 1;
    path[depth] = ix;

    var ci: u32 = 0;
    for (ci < callee_count(e, ix)) {
        val cx: u32 = callee_at(e, ix, ci);
        if (cx != FN_NONE && emittable(e, cx)) {
            if (state[cx] == 1) { ret cycle_refusal(e, path, depth + 1, cx); }
            if (state[cx] == 0) {
                val sub: str = cg_visit(e, state, path, depth + 1, cx);
                if (sub != nil) { ret sub; }
            }
        }
        ci = ci + 1;
    }

    state[ix] = 2;
    ret nil;
}

# the diagnostic for a call-graph cycle, naming the chain that closes it
# ---
# e:      the emission state
# path:   the DFS path
# depth:  the path's length
# closes: the function the last edge returns to, which is somewhere on the path
# ret:    the composed diagnostic
fun cycle_refusal(e: *Emit, path: *u32, depth: u32, closes: u32) str {
    var chain: str = ir_fn_spelling(e, closes);
    var i: u32 = 0;
    # skip the prefix that leads INTO the cycle: only the loop itself is reported.
    for (i < depth && path[i] != closes) { i = i + 1; }
    for (i < depth) {
        val r: R.Result[str, str] = format.sprint(e.alloc, "{} -> {}", chain,
                                                  ir_fn_spelling(e, path[i]));
        if (R.is_err[str, str](r)) { i = depth; cnt; }
        chain = R.unwrap_ok[str, str](r);
        i = i + 1;
    }
    val r2: R.Result[str, str] = format.sprint(e.alloc,
        "this call graph is a cycle and the SPIR-V target cannot express it: {}. a SPIR-V execution model has no call stack, so a function may not be reachable from itself. rewrite the recursion as a loop",
        chain);
    if (R.is_err[str, str](r2)) {
        ret "a recursive call is not expressible in the SPIR-V target: a SPIR-V execution model has no call stack, so a function may not be reachable from itself";
    }
    ret R.unwrap_ok[str, str](r2);
}

# the per-stage interface rules: the Flat decoration, and Location span overlap
#
# Both are rules Vulkan states PER EXECUTION MODEL, over the set of variables one
# entry point reaches, so neither can be decided where the variables are declared -
# `declare_interface` runs before reachability is known. They live here, after
# `build_iface_uses`, and before any body is emitted.
#
# Flat is required on a fragment-stage Input of integer or 64-bit float type: such
# a value cannot be interpolated, so an undecorated one is an invalid module. It is
# emitted at most once per variable however many fragment stages reach it, since a
# repeated decoration is not what the module means to say.
#
# Vulkan also FORBIDS Flat on a vertex-stage Input, so one variable cannot serve
# both: the fragment stage requires the decoration and the vertex stage rejects it,
# and no module satisfies both. That is refused here rather than resolved, because
# there is nothing to resolve - a vertex stage's Input is a vertex attribute and a
# fragment stage's Input is the interpolated output of the stage before it, and one
# module-scope variable standing for both is the author having conflated two things
# rather than a shape the emitter could express if it tried harder.
#
# A Location is written by the author and emitted verbatim, but mach knows each
# variable's type and so knows how many locations it consumes; two that overlap
# within one stage are refused here rather than left to a validator message naming
# an `OpEntryPoint` operand index. A descriptor `(set, binding)` pair claimed twice
# is refused on the same footing.
#
# WHY THE COLLISION RULES MATTER MORE ONCE GLOBALS CROSS MODULES (#2843). Within
# one module two variables at the same location, or the same `(set, binding)`, are
# a typo an author can see. Across modules they are neither: two shared libraries
# can each declare `#[uniform(0, 0)]` without either author ever seeing the other,
# and the shader that imports both is where the conflict first exists. So the
# checks run over the DRAWN-IN set rather than the root's globals, and each
# diagnostic names the declaring MODULE - a message naming two `camera`s tells the
# one person who can act on it nothing about where either lives.
# ---
# e:   the emission state
# ret: true on success, or a diagnostic naming the variables that collide
fun check_stage_interfaces(e: *Emit) R.Result[bool, str] {
    val n: u32 = e.gl_len;
    if (e.iface_len == 0 || n == 0) { ret R.ok[bool, str](true); }

    val rf: R.Result[*u8, str] = A.allocate[u8](e.alloc, n::usize);
    if (R.is_err[*u8, str](rf)) { ret R.err[bool, str](R.unwrap_err[*u8, str](rf)); }
    val flat: *u8 = R.unwrap_ok[*u8, str](rf);
    var i: u32 = 0;
    for (i < n) { flat[i] = 0; i = i + 1; }

    var msg: str = nil;
    var fx: u32 = 0;
    for (fx < e.fn_len && msg == nil) {
        # only an EMITTED entry point states a per-stage rule: one the module dropped
        # declares no interface a consumer can see.
        if (!e.fns[fx].emit) { fx = fx + 1; cnt; }
        val fn: *ir.Function = fn_ir(e, fx);
        if (fn.stage == ir.STAGE_NONE) { fx = fx + 1; cnt; }
        i = 0;
        for (i < n) {
            if (e.gslot[i] == 0 || !uses_iface(e, fx, e.gslot[i] - 1)) { i = i + 1; cnt; }
            val gi: *ir.Global = gl_ir(e, i);
            if (e.gstorage[i] == spirv.STORAGE_INPUT && needs_flat(gl_types(e, i), gi.ty)) {
                if (fn.stage == ir.STAGE_FRAGMENT) { flat[i] = flat[i] | 1; }
                or (fn.stage == ir.STAGE_VERTEX)   { flat[i] = flat[i] | 2; }
                if (flat[i] == 3) {
                    msg = flat_conflict(e, i);
                    i = n; cnt;
                }
            }
            # a Location collision is only a collision within one direction: an input
            # at location 0 and an output at location 0 are two different spaces.
            if (gi.iface == ir.IFACE_INPUT || gi.iface == ir.IFACE_OUTPUT) {
                msg = location_overlap(e, fx, i);
                if (msg != nil) { i = n; cnt; }
            }
            # a descriptor pair is a claim on the pipeline layout, and two variables
            # claiming one is a binding the host can satisfy for only one of them.
            if (gi.iface == ir.IFACE_UNIFORM || gi.iface == ir.IFACE_STORAGE
                || gi.iface == ir.IFACE_SAMPLER) {
                msg = descriptor_overlap(e, fx, i);
                if (msg != nil) { i = n; cnt; }
            }
            i = i + 1;
        }
        fx = fx + 1;
    }

    if (msg == nil) {
        i = 0;
        for (i < n) {
            if ((flat[i] & 1) != 0) { decorate_bare(e, e.gvar_ids[i], spirv.DECOR_FLAT); }
            i = i + 1;
        }
    }
    A.deallocate[u8](e.alloc, flat, n::usize);
    if (msg != nil) { ret R.err[bool, str](msg); }
    ret R.ok[bool, str](true);
}

# the diagnostic for one Input that a vertex stage and a fragment stage both reach
# and that cannot be decorated to satisfy both
# ---
# e:  the emission state
# gi: the global-table index
# ret: the composed diagnostic
fun flat_conflict(e: *Emit, gi: u32) str {
    val g: *ir.Global = gl_ir(e, gi);
    val r: R.Result[str, str] = format.sprint(e.alloc,
        "this `#[input({})]` variable, {}{}, is read by a vertex stage and by a fragment stage, and no SPIR-V module serves both: a fragment stage's integer or 64-bit input MUST carry a Flat decoration because such a value cannot be interpolated, and a vertex stage's input must NOT carry one. declare two variables. the two are different things anyway - a vertex stage's input is a vertex attribute, and a fragment stage's is the interpolated output of the stage before it",
        g.iface_a, ir_type_spelling(gl_types(e, gi), e.alloc, g.ty), gl_mod_prefix(e, gi));
    if (R.is_err[str, str](r)) {
        ret "an integer or 64-bit `#[input(...)]` cannot be read by a vertex stage and a fragment stage at once: the fragment stage requires a Flat decoration and the vertex stage forbids one";
    }
    ret R.unwrap_ok[str, str](r);
}

# the diagnostic for a Location span that overlaps an earlier variable's, or nil
#
# Only globals BEFORE `gi` are compared, so one pair reports once. The comparison is
# restricted to the same interface role and the same entry point's reachable set,
# which is what makes a vertex stage's input at location 0 and a fragment stage's
# input at location 0 two separate assignments rather than a collision.
# ---
# e:  the emission state
# fx: the entry point's unit function-table index
# gi: the global-table index of the variable being placed
# ret: nil when the span is free, or the composed diagnostic
fun location_overlap(e: *Emit, fx: u32, gi: u32) str {
    val g: *ir.Global = gl_ir(e, gi);
    val lo: u32 = g.iface_a;
    val span: u32 = location_span(e, gl_types(e, gi), g.ty);
    var j: u32 = 0;
    for (j < gi) {
        val o: *ir.Global = gl_ir(e, j);
        if (o.iface != g.iface) { j = j + 1; cnt; }
        if (e.gslot[j] == 0 || !uses_iface(e, fx, e.gslot[j] - 1)) { j = j + 1; cnt; }
        val olo: u32 = o.iface_a;
        val ospan: u32 = location_span(e, gl_types(e, j), o.ty);
        if (lo < olo + ospan && olo < lo + span) {
            var what: str = "input";
            if (g.iface == ir.IFACE_OUTPUT) { what = "output"; }
            # named by the decorator the author wrote rather than by the variable's
            # symbol: IR keeps a global's mangled linkage name and no source
            # spelling, and a mangled name in a diagnostic points nowhere. the
            # declaring MODULE is appended when it is not this one, which is the
            # only thing that separates two drawn-in variables (#2843).
            val fr: R.Result[str, str] = format.sprint(e.alloc,
                "two `#[{}(...)]` variables overlap in the stage `{}`: `#[{}({})]`, {}{}, occupies {} location(s) and so runs through location {}, and `#[{}({})]`, {}{}, starts inside it. a type wider than one location consumes the ones that follow it, so the numbers an author writes have to leave room for the type",
                what, ir_fn_spelling(e, fx), what, olo,
                ir_type_spelling(gl_types(e, j), e.alloc, o.ty), gl_mod_prefix(e, j),
                ospan, olo + ospan - 1,
                what, lo, ir_type_spelling(gl_types(e, gi), e.alloc, g.ty), gl_mod_prefix(e, gi));
            if (R.is_err[str, str](fr)) {
                ret "two shader interface variables occupy the same location: a type wider than one location consumes the ones that follow it";
            }
            ret R.unwrap_ok[str, str](fr);
        }
        j = j + 1;
    }
    ret nil;
}

# the diagnostic for a descriptor `(set, binding)` an earlier variable already
# claims, or nil
#
# The same shape as `location_overlap` and for the same reason, over the other
# namespace a shader binds: a descriptor pair names a slot in the pipeline layout,
# and a host binds one resource to it. Two variables claiming one pair is not a
# module a consumer can satisfy - whichever it binds, the other reads the wrong
# resource - so it is refused rather than emitted for a validator to accept.
#
# `spirv-val` does NOT catch this. A module with two variables at the same
# `(set, binding)` is well-formed SPIR-V; the conflict is with the pipeline layout,
# which lives outside the module entirely. So this is one of the checks that has to
# be here or nowhere.
#
# UNLIKE a Location, the pair is compared across the interface roles rather than
# within one: a `#[uniform(0, 0)]` and a `#[storage(0, 0)]` are two descriptor types
# claiming one slot, which is the same conflict, not two spaces.
# ---
# e:  the emission state
# fx: the entry point's unit function-table index
# gi: the global-table index of the variable being placed
# ret: nil when the pair is free, or the composed diagnostic
fun descriptor_overlap(e: *Emit, fx: u32, gi: u32) str {
    val g: *ir.Global = gl_ir(e, gi);
    var j: u32 = 0;
    for (j < gi) {
        val o: *ir.Global = gl_ir(e, j);
        if (o.iface != ir.IFACE_UNIFORM && o.iface != ir.IFACE_STORAGE
            && o.iface != ir.IFACE_SAMPLER) { j = j + 1; cnt; }
        if (e.gslot[j] == 0 || !uses_iface(e, fx, e.gslot[j] - 1)) { j = j + 1; cnt; }
        if (o.iface_a != g.iface_a || o.iface_b != g.iface_b) { j = j + 1; cnt; }
        val fr: R.Result[str, str] = format.sprint(e.alloc,
            "two descriptor-bound variables claim the same `(set = {}, binding = {})` in the stage `{}`: `{}`, {}{}, and `{}`, {}{}. a host binds one resource to a descriptor slot, so a pipeline layout can satisfy only one of them and the other would read whatever the first was bound to. give them different bindings",
            g.iface_a, g.iface_b, ir_fn_spelling(e, fx),
            descriptor_role(o.iface), ir_type_spelling(gl_types(e, j), e.alloc, o.ty), gl_mod_prefix(e, j),
            descriptor_role(g.iface), ir_type_spelling(gl_types(e, gi), e.alloc, g.ty), gl_mod_prefix(e, gi));
        if (R.is_err[str, str](fr)) {
            ret "two descriptor-bound variables claim the same descriptor set and binding: a pipeline layout can satisfy only one of them";
        }
        ret R.unwrap_ok[str, str](fr);
    }
    ret nil;
}

# the decorator an author wrote for one descriptor-bound interface role
# ---
# iface: the IR interface role
# ret:   the decorator's spelling
fun descriptor_role(iface: u8) str {
    if (iface == ir.IFACE_STORAGE) { ret "#[storage(...)]"; }
    if (iface == ir.IFACE_SAMPLER) { ret "#[sampler(...)]"; }
    ret "#[uniform(...)]";
}

# how many interface locations a type consumes
#
# One location is four 32-bit components. A scalar or a vector of 32-bit-or-narrower
# components fits in one; a 64-bit one takes a location per 16 bytes, so `f64x3`
# takes two. An aggregate consumes the sum of what its members consume, and an array
# its element's span times its length, since the flattening is by member and not by
# byte.
# ---
# e:  the emission state
# id: the interface variable's IR type
# ret: the number of locations, at least 1
fun location_span(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) u32 {
    val opt: O.Option[*type.IrType] = type.get(gt, id);
    if (O.is_none[*type.IrType](opt)) { ret 1; }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);
    if (t.kind == type.IRT_STRUCT) {
        var total: u32 = 0;
        var i: u32 = 0;
        for (i < t.data.struct_.field_count) {
            total = total + location_span(e, gt, t.data.struct_.fields[i]);
            i = i + 1;
        }
        if (total == 0) { ret 1; }
        ret total;
    }
    if (t.kind == type.IRT_ARRAY) {
        val es: u32 = location_span(e, gt, t.data.array_.element);
        if (t.data.array_.count == 0) { ret 1; }
        ret es * t.data.array_.count;
    }
    val bytes: u32 = type.byte_size(gt, id, e.tgt);
    if (bytes <= 16) { ret 1; }
    ret (bytes + 15) / 16;
}

# whether a fragment-stage Input of this type must carry a Flat decoration
#
# The rule is about the ELEMENT: an integer of any width, and a 64-bit float,
# cannot be interpolated, and a vector of either inherits that. A 32-bit float is
# the only interpolable element there is.
# ---
# tt: the IR type table
# id: the interface variable's IR type
# ret: true when Flat is required
fun needs_flat(tt: *type.IrTypeTable, id: type.IrTypeId) bool {
    var lanes: u32     = 0;
    var bits: u32      = 0;
    var is_float: bool = false;
    if (!ir_scalar_shape(tt, id, ?lanes, ?bits, ?is_float)) { ret false; }
    if (!is_float) { ret true; }
    ret bits == 64;
}

# emit an OpDecorate that carries no operand, such as Flat or NonWritable
# ---
# e:      the emission state
# target: the id being decorated
# decor:  the decoration
fun decorate_bare(e: *Emit, target: u32, decor: u32) {
    var ops: [2]u32;
    ops[0] = target; ops[1] = decor;
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?ops[0], 2);
}

# a unit function's source name, for a diagnostic
#
# `disp` is the bare source spelling and `name` is the mangled linkage symbol. A
# diagnostic reads at the source, so `disp` is preferred and the mangled form is
# the fallback for a synthesized function that has no source spelling.
#
# A function drawn in from ANOTHER module is qualified with that module's name.
# Two modules may spell a helper the same way, and a refusal naming a bare
# `mul_point` when the offending one is three files away sends the reader to the
# wrong file (#2823). The root's own functions stay unqualified, which is what a
# reader of a single-module diagnostic expects.
# ---
# e:  the emission state
# ix: the unit function-table index
# ret: the source name, or a placeholder when it is not resolvable
fun ir_fn_spelling(e: *Emit, ix: u32) str {
    if (ix >= e.fn_len) { ret "<unknown function>"; }
    val fn: *ir.Function = fn_ir(e, ix);
    var name: str = nil;
    if (fn.disp != intern.STR_NIL) {
        val d: O.Option[str] = intern.lookup(e.interner, fn.disp);
        if (O.is_some[str](d)) { name = O.unwrap[str](d); }
    }
    if (name == nil) {
        val o: O.Option[str] = intern.lookup(e.interner, fn.name);
        if (O.is_none[str](o)) { ret "<unknown function>"; }
        name = O.unwrap[str](o);
    }
    if (e.fns[ix].mi == e.u.root) { ret name; }
    val mo: O.Option[str] = intern.lookup(e.interner, fn_mod(e, ix).name);
    if (O.is_none[str](mo)) { ret name; }
    val q: R.Result[str, str] = format.sprint(e.alloc, "{}.{}", O.unwrap[str](mo), name);
    if (R.is_err[str, str](q)) { ret name; }
    ret R.unwrap_ok[str, str](q);
}

# emit a one-operand OpDecorate
# ---
# e:      the emission state
# target: the id being decorated
# decor:  the decoration
# operand: the decoration's single literal operand
fun decorate(e: *Emit, target: u32, decor: u32, operand: u32) {
    var ops: [3]u32;
    ops[0] = target; ops[1] = decor; ops[2] = operand;
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?ops[0], 3);
}

# the type SPIR-V specifies for a `#[builtin("...")]` variable
#
# Every built-in has one, on the VARIABLE rather than on how it is read, so a
# variable declared at any other type is an invalid module however it is used. The
# check is a table for the same reason the selector and the storage class are: a
# built-in is added along one axis, and a row it cannot be added without is a row
# that cannot be forgotten.
#
# The three compute ids used to be refused outright here on the ground that every
# mach vector was exactly 128 bits so `u32x3` could not exist. #2687 deleted that
# rule from the language, which turned the refusal into a false statement and left
# the whole family unreachable (#2745).
#
# SIGNEDNESS IS NOT CHECKABLE AND IS NOT CHECKED. IR carries an integer's width and
# nothing else, and SPIR-V here emits `OpTypeInt n 0` for both spellings, so `i32x3`
# and `u32x3` are one type by the time the module exists. The requirement is spelled
# at the unsigned form because that is what the specification says and what a reader
# should write. The check is over the shape the module can actually distinguish.
# ---
# which:        the ir.BUILTIN_* value
# out_lanes:    receives the component count, 1 for a scalar
# out_bits:     receives the element width in bits
# out_is_float: receives true for a float element
# ret:          the mach spelling the requirement reads at
fun builtin_required_type(which: u32, out_lanes: *u32, out_bits: *u32, out_is_float: *bool) str {
    @out_lanes = 1; @out_bits = 32; @out_is_float = true;
    if (which == ir.BUILTIN_POSITION || which == ir.BUILTIN_FRAG_COORD) {
        @out_lanes = 4;
        ret "`f32x4`, a four-component float vector";
    }
    if (which == ir.BUILTIN_POINT_SIZE) {
        ret "`f32`, a scalar float";
    }
    if (which == ir.BUILTIN_GLOBAL_INVOCATION || which == ir.BUILTIN_LOCAL_INVOCATION
        || which == ir.BUILTIN_WORKGROUP_ID) {
        @out_lanes = 3; @out_is_float = false;
        ret "`u32x3`, a three-component 32-bit unsigned vector";
    }
    # vertex_index and instance_index
    @out_is_float = false;
    ret "`u32` or `i32`, a scalar 32-bit integer";
}

# the refusal for a `#[builtin("...")]` variable declared at the wrong type, or nil
# ---
# tt:    the IR type table
# alloc: allocator for the composed diagnostic
# which: the ir.BUILTIN_* value
# ty:    the variable's IR type
# ret:   the diagnostic, or nil when the declared type is the specified one
fun builtin_type_refusal(tt: *type.IrTypeTable, alloc: *A.Allocator, which: u32,
                         ty: type.IrTypeId) str {
    var want_lanes: u32    = 0;
    var want_bits: u32     = 0;
    var want_is_float: bool = false;
    val want: str = builtin_required_type(which, ?want_lanes, ?want_bits, ?want_is_float);

    var got_lanes: u32     = 0;
    var got_bits: u32      = 0;
    var got_is_float: bool = false;
    if (ir_scalar_shape(tt, ty, ?got_lanes, ?got_bits, ?got_is_float)
        && got_lanes == want_lanes && got_bits == want_bits && got_is_float == want_is_float) {
        ret nil;
    }

    val r: R.Result[str, str] = format.sprint(alloc,
        "this `#[builtin(\"{}\")]` variable is declared {}, and SPIR-V specifies it as {}. the requirement is on the variable's TYPE rather than on how it is read, so a wider or narrower one is an invalid module rather than a wasteful one",
        builtin_spelling(which), ir_type_spelling(tt, alloc, ty), want);
    if (R.is_err[str, str](r)) {
        ret "this `#[builtin(\"...\")]` variable is declared at a type SPIR-V does not specify for it";
    }
    ret R.unwrap_ok[str, str](r);
}

# the source spelling of a built-in name, for a diagnostic
# ---
# which: the ir.BUILTIN_* value
# ret:   the string the `#[builtin(...)]` argument carries
fun builtin_spelling(which: u32) str {
    if (which == ir.BUILTIN_VERTEX_INDEX)      { ret "vertex_index"; }
    if (which == ir.BUILTIN_INSTANCE_INDEX)    { ret "instance_index"; }
    if (which == ir.BUILTIN_FRAG_COORD)        { ret "frag_coord"; }
    if (which == ir.BUILTIN_POINT_SIZE)        { ret "point_size"; }
    if (which == ir.BUILTIN_GLOBAL_INVOCATION) { ret "global_invocation"; }
    if (which == ir.BUILTIN_LOCAL_INVOCATION)  { ret "local_invocation"; }
    if (which == ir.BUILTIN_WORKGROUP_ID)      { ret "workgroup_id"; }
    ret "position";
}

# resolve an IR type to a lane count, element width and element class
#
# A scalar answers with one lane, which is what lets one comparison cover both a
# scalar and a vector requirement. Anything that is neither answers false rather
# than a shape of its own, since an aggregate has no element width to compare.
# ---
# tt:           the IR type table
# id:           the IR type id
# out_lanes:    receives the component count, 1 for a scalar
# out_bits:     receives the element width in bits
# out_is_float: receives true for a float element
# ret:          true when the type is a scalar or a vector of one
fun ir_scalar_shape(tt: *type.IrTypeTable, id: type.IrTypeId, out_lanes: *u32,
                    out_bits: *u32, out_is_float: *bool) bool {
    @out_lanes = 0; @out_bits = 0; @out_is_float = false;
    val opt: O.Option[*type.IrType] = type.get(tt, id);
    if (O.is_none[*type.IrType](opt)) { ret false; }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);
    if (t.kind == type.IRT_FLOAT) { @out_lanes = 1; @out_bits = t.data.bits; @out_is_float = true; ret true; }
    if (t.kind == type.IRT_INT)   { @out_lanes = 1; @out_bits = t.data.bits; ret true; }
    if (t.kind != type.IRT_VECTOR) { ret false; }
    val eopt: O.Option[*type.IrType] = type.get(tt, t.data.vector_.element);
    if (O.is_none[*type.IrType](eopt)) { ret false; }
    val et: *type.IrType = O.unwrap[*type.IrType](eopt);
    if (et.kind != type.IRT_FLOAT && et.kind != type.IRT_INT) { ret false; }
    @out_lanes = t.data.vector_.lanes;
    @out_bits = et.data.bits;
    @out_is_float = et.kind == type.IRT_FLOAT;
    ret true;
}

# the mach spelling of an IR type, for a diagnostic
#
# An integer is spelled at both signs because IR carries none: reporting one of them
# would be a guess, and reporting the wrong one against the author's own declaration
# is exactly the misdirection these refusals exist to avoid.
# ---
# tt:    the IR type table
# alloc: allocator for a composed spelling
# id:    the IR type id
# ret:   the spelling, on `alloc` when it has to be composed
fun ir_type_spelling(tt: *type.IrTypeTable, alloc: *A.Allocator, id: type.IrTypeId) str {
    var lanes: u32     = 0;
    var bits: u32      = 0;
    var is_float: bool = false;
    if (!ir_scalar_shape(tt, id, ?lanes, ?bits, ?is_float)) {
        val opt: O.Option[*type.IrType] = type.get(tt, id);
        if (O.is_none[*type.IrType](opt)) { ret "an unresolved type"; }
        val k: type.IrTypeKind = O.unwrap[*type.IrType](opt).kind;
        if (k == type.IRT_PTR)    { ret "a pointer"; }
        if (k == type.IRT_ARRAY)  { ret "an array"; }
        if (k == type.IRT_STRUCT) { ret "a record"; }
        if (k == type.IRT_UNION)  { ret "a union"; }
        ret "a type with no scalar shape";
    }
    var r: R.Result[str, str];
    if (is_float && lanes == 1)  { r = format.sprint(alloc, "`f{}`", bits); }
    or (is_float)                { r = format.sprint(alloc, "`f{}x{}`", bits, lanes); }
    or (lanes == 1)              { r = format.sprint(alloc, "`i{}` / `u{}`", bits, bits); }
    or                           { r = format.sprint(alloc, "`i{}x{}` / `u{}x{}`", bits, lanes, bits, lanes); }
    if (R.is_err[str, str](r)) { ret "a type this diagnostic could not render"; }
    ret R.unwrap_ok[str, str](r);
}

# the SPIR-V BuiltIn selector for one of mach's built-in names
# ---
# which: the ir.BUILTIN_* value
# ret:   the SPIR-V BuiltIn decoration operand
fun builtin_selector(which: u32) u32 {
    if (which == ir.BUILTIN_VERTEX_INDEX)      { ret spirv.BUILTIN_VERTEX_INDEX; }
    if (which == ir.BUILTIN_INSTANCE_INDEX)    { ret spirv.BUILTIN_INSTANCE_INDEX; }
    if (which == ir.BUILTIN_FRAG_COORD)        { ret spirv.BUILTIN_FRAG_COORD; }
    if (which == ir.BUILTIN_POINT_SIZE)        { ret spirv.BUILTIN_POINT_SIZE; }
    if (which == ir.BUILTIN_GLOBAL_INVOCATION) { ret spirv.BUILTIN_GLOBAL_INVOCATION_ID; }
    if (which == ir.BUILTIN_LOCAL_INVOCATION)  { ret spirv.BUILTIN_LOCAL_INVOCATION_ID; }
    if (which == ir.BUILTIN_WORKGROUP_ID)      { ret spirv.BUILTIN_WORKGROUP_ID; }
    ret spirv.BUILTIN_POSITION;
}

# the storage class a built-in lives in
#
# A built-in's direction is a property of the built-in, not something the author
# restates: a stage WRITES its position and point size and READS everything the
# pipeline hands it. Deriving it here is what keeps `#[builtin("...")]` a single
# directive rather than one that must be paired with an input/output marker that
# could disagree with it.
# ---
# which: the ir.BUILTIN_* value
# ret:   spirv.STORAGE_INPUT or spirv.STORAGE_OUTPUT
fun builtin_storage(which: u32) u32 {
    if (which == ir.BUILTIN_POSITION || which == ir.BUILTIN_POINT_SIZE) {
        ret spirv.STORAGE_OUTPUT;
    }
    ret spirv.STORAGE_INPUT;
}

# the SPIR-V variable id backing an IR global, or 0 when it has no interface role
# ---
# e:    the emission state
# name: the global's interned name
# ret:  the OpVariable id, or 0
fun global_var_id(e: *Emit, name: intern.StrId) u32 {
    if (e.gvar_ids == nil) { ret 0; }
    val gx: u32 = gl_lookup(e, name);
    if (gx == GL_NONE) { ret 0; }
    ret e.gvar_ids[gx];
}

# emit the module preamble: capabilities and the memory model
#
# Declares Shader + Linkage plus the width capabilities the functions' types
# accumulated (Int64 for a 64-bit integer, Float64 for an f64, and so on). Called
# after every function so `caps_needed` is complete.
# ---
# e: the emission state
fun emit_preamble(e: *Emit) {
    emit_cap(e, spirv.CAP_SHADER);
    # Linkage is what lets a module with no entry point publish its functions to a
    # consumer, and it is the RIGHT thing for a compiled mach library. It is also
    # forbidden in a module meant for a Vulkan pipeline: a shader module is complete
    # in itself and declares no external linkage, and spirv-val rejects the
    # capability outright under a Vulkan environment. So the two are exclusive, and
    # the presence of an entry point is what decides which module this is.
    if (!e.has_entry) { emit_cap(e, spirv.CAP_LINKAGE); }
    val need: u32 = e.b.caps_needed;
    if ((need & spirv.NEED_INT8) != 0)    { emit_cap(e, spirv.CAP_INT8); }
    if ((need & spirv.NEED_INT16) != 0)   { emit_cap(e, spirv.CAP_INT16); }
    if ((need & spirv.NEED_INT64) != 0)   { emit_cap(e, spirv.CAP_INT64); }
    if ((need & spirv.NEED_FLOAT16) != 0) { emit_cap(e, spirv.CAP_FLOAT16); }
    if ((need & spirv.NEED_FLOAT64) != 0) { emit_cap(e, spirv.CAP_FLOAT64); }
    # the image dimensionalities that need one beyond Shader (#2794). Accumulated by
    # `types.type_image` when the type is minted, on exactly the terms the width
    # capabilities are, so a handle declared but never sampled still declares what
    # its declaration requires.
    if ((need & spirv.NEED_SAMPLED_1D) != 0)         { emit_cap(e, spirv.CAP_SAMPLED_1D); }
    if ((need & spirv.NEED_SAMPLED_CUBE_ARRAY) != 0) { emit_cap(e, spirv.CAP_SAMPLED_CUBE_ARRAY); }
    var mm: [2]u32;
    mm[0] = spirv.ADDRESSING_LOGICAL;
    mm[1] = spirv.MEMORY_GLSL450;
    spirv.inst(e.b, ?e.b.memory_model, spirv.OP_MEMORY_MODEL, ?mm[0], 2);
}

# emit one OpCapability
# ---
# e:   the emission state
# cap: the capability operand
fun emit_cap(e: *Emit, cap: u32) {
    var o: [1]u32;
    o[0] = cap;
    spirv.inst(e.b, ?e.b.caps, spirv.OP_CAPABILITY, ?o[0], 1);
}

# emit one OpFunction for a function in the emitted closure
#
# Rebuilds the signature from the IR function, declares the parameters, emits an
# OpVariable per body vreg at the entry, reconstructs the structured control flow,
# then translates each block in the reconstruction's order. In a library module
# the function is also decorated Export under its own name.
#
# The current member is stamped on the state HERE, and everything below reads the
# body's own module through it - the signature's type ids, the alloca sizes, the
# vreg widths. A function drawn in from another module is otherwise emitted on
# exactly the same terms as one written in the root: same signature rebuild, same
# control-flow reconstruction, same refusals.
# ---
# e:  the emission state
# fx: the unit function-table index to emit
# ret: true on success, or a precise error string
fun emit_function(e: *Emit, fx: u32) R.Result[bool, str] {
    val mf: *mir.MirFunction = fn_mir(e, fx);
    if (mf == nil) { ret R.err[bool, str]("spirv.emit: an emitted function has no lowered body"); }
    e.cur_fn = mf;
    e.cur_instr = nil;
    e.cur_mi = e.fns[fx].mi;
    e.ir = fn_mod(e, fx);
    val irfn: *ir.Function = fn_ir(e, fx);

    # signature: return type + parameter types from the IR function.
    var returns_void: bool = false;
    val ret_ty: u32 = ir_return_spv_type(e, irfn, ?returns_void);
    if (ret_ty == 0) {
        ret unsupported(e, "unsupported return type in the SPIR-V target");
    }
    var ptypes: [16]u32;
    if (irfn.param_count > types.MAX_FN_PARAMS) {
        ret unsupported(e, "more than 16 parameters is not supported by the SPIR-V target");
    }
    var pi: u32 = 0;
    for (pi < irfn.param_count) {
        val pt: u32 = ir_value_spv_type(e, irfn.params[pi].ty);
        if (pt == 0) {
            ret unsupported(e, "unsupported parameter type in the SPIR-V target");
        }
        ptypes[pi] = pt;
        pi = pi + 1;
    }
    val fnty: u32 = types.type_fn(e.tt, ret_ty, ?ptypes[0], irfn.param_count);
    # a 0 here is a signature the table could not build. It must be reported, not
    # passed on: `OpFunction` naming type id 0 is the reserved never-valid id, and
    # the module leaves with no diagnostic and fails in a validator (#2748).
    if (fnty == 0) {
        ret unsupported(e, "this signature has no SPIR-V function type in the SPIR-V target");
    }

    val fn_id: u32 = e.fns[fx].id;

    val name_opt: O.Option[str] = intern.lookup(e.interner, mf.name);
    if (O.is_none[str](name_opt)) { ret R.err[bool, str]("spirv.emit: function name not interned"); }
    val fn_name: str = O.unwrap[str](name_opt);

    # a staged function becomes an entry point; in a library module every function
    # THIS MODULE OWNS is published under a linkage export instead. The two are
    # exclusive: SPIR-V forbids decorating an entry point with LinkageAttributes,
    # and a Vulkan module may not declare the Linkage capability at all.
    #
    # A body drawn in from another module is NEVER exported, whichever kind this
    # module is. It is a private copy of someone else's function, emitted here
    # because there is no import to bind instead, and the module that owns it
    # publishes it under the same symbol from its own `.spv`. Exporting both would
    # put two definitions of one name in front of a consumer that links the pair -
    # a collision this module invented, over a function it does not own.
    if (irfn.stage != ir.STAGE_NONE) {
        val er: R.Result[bool, str] = emit_entry_point(e, irfn, fx, fn_id, entry_name(e, irfn, fn_name), returns_void);
        if (R.is_err[bool, str](er)) { ret er; }
    }
    or (!e.has_entry && e.fns[fx].mi == e.u.root) { emit_linkage_export(e, fn_id, fn_name); }

    # the structured shape of the body, or a refusal naming the construct.
    val cr: R.Result[cfg.Structure, str] = cfg.analyze(mf, e.alloc);
    if (R.is_err[cfg.Structure, str](cr)) { ret R.err[bool, str](R.unwrap_err[cfg.Structure, str](cr)); }
    var st: cfg.Structure = R.unwrap_ok[cfg.Structure, str](cr);
    if (st.status != cfg.CFG_OK) {
        val msg: str = cfg_refusal(e, fn_name, ?st);
        cfg.dnit(?st);
        ret R.err[bool, str](msg);
    }

    # OpFunction <ret_ty> <fn_id> None <fnty>.
    var fop: [4]u32;
    fop[0] = ret_ty; fop[1] = fn_id; fop[2] = spirv.FUNCTION_CONTROL_NONE; fop[3] = fnty;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION, ?fop[0], 4);

    # one OpFunctionParameter per IR parameter, in order.
    var param_ids: [16]u32;
    pi = 0;
    for (pi < irfn.param_count) {
        val pid: u32 = spirv.alloc_id(e.b);
        var pp: [2]u32;
        pp[0] = ptypes[pi]; pp[1] = pid;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION_PARAMETER, ?pp[0], 2);
        param_ids[pi] = pid;
        pi = pi + 1;
    }

    # one label id per node, allocated before any block is emitted so a branch can
    # name a block the walk has not reached.
    val rl: R.Result[*u32, str] = A.allocate[u32](e.alloc, st.count::usize);
    if (R.is_err[*u32, str](rl)) {
        cfg.dnit(?st);
        ret R.err[bool, str](R.unwrap_err[*u32, str](rl));
    }
    val labels: *u32 = R.unwrap_ok[*u32, str](rl);
    var li: u32 = 0;
    for (li < st.count) { labels[li] = spirv.alloc_id(e.b); li = li + 1; }

    # the entry label opens the body; every Function-storage variable lives here.
    var lb: [1]u32;
    lb[0] = labels[st.order[0]];
    spirv.inst(e.b, ?e.b.functions, spirv.OP_LABEL, ?lb[0], 1);

    var vm: VMaps;
    val mr: R.Result[bool, str] = build_vmaps(e, mf, irfn, ?vm);
    if (R.is_err[bool, str](mr)) {
        A.deallocate[u32](e.alloc, labels, st.count::usize);
        cfg.dnit(?st);
        ret mr;
    }

    var body: R.Result[bool, str] = R.ok[bool, str](true);
    var oi: u32 = 0;
    for (oi < st.count) {
        body = emit_node(e, mf, ?st, st.order[oi], oi == 0, labels, ?vm,
                         ?param_ids[0], irfn.param_count, returns_void, ret_ty);
        if (R.is_err[bool, str](body)) { oi = st.count; cnt; }
        oi = oi + 1;
    }

    vmaps_dnit(e, ?vm);
    A.deallocate[u32](e.alloc, labels, st.count::usize);
    cfg.dnit(?st);
    if (R.is_err[bool, str](body)) { ret body; }

    spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION_END, nil, 0);
    if (e.b.err) { ret R.err[bool, str]("spirv.emit: module builder hit an allocation error"); }
    ret R.ok[bool, str](true);
}

# what an address operand ultimately refers to
#
# Three different lowerings reach this back end as an address the milestone cannot
# carry, and they need three different diagnostics, because each is fixed in a
# different place. Telling them apart by the SHAPE of the instruction does not
# work: an address materialization and a member walk are both `MIR_GEP` off a
# symbol, and a member at offset 0 carries the same zero displacement an address
# materialization does. What separates them is the ORIGIN of the address, so that
# is what is resolved here and what every refusal below keys on.
val ADDR_UNKNOWN: u8 = 0;  # not resolvable to a named origin
val ADDR_GLOBAL:  u8 = 1;  # a module-scope global, index reported in out_ix
val ADDR_ALLOCA:  u8 = 2;  # a function-local allocation

# resolve an address operand to its origin, following one level of indirection
#
# A symbol operand names its global directly, whether or not it carries a member
# displacement in `sym_off`. Anything reached through a register is resolved by
# finding that register's defining instruction: MIR materializes an address into a
# register with a `MIR_GEP`, and an allocation with a `MIR_ALLOCA`. One level is
# all the lowerings in question produce; anything deeper is honestly unknown rather
# than guessed at.
# ---
# e:      the emission state
# mf:     the MIR function the operand belongs to
# op:     the address operand
# out_ix: receives the IR global index for ADDR_GLOBAL
# ret:    one of ADDR_*
fun address_origin(e: *Emit, mf: *mir.MirFunction, op: *mir.MirOperand, out_ix: *u32) u8 {
    @out_ix = 0;
    if (op.kind == mir.MIR_OP_SYM) {
        val gx: u32 = gl_lookup(e, op.sym);
        if (gx != GL_NONE) { @out_ix = gx; ret ADDR_GLOBAL; }
        ret ADDR_UNKNOWN;
    }
    # a MEM operand's register base rides in `vreg`; a physical-register base leaves
    # it nil. A frame-slot key shares the field, but no frame layout runs on this
    # path, and a key naming no defining instruction resolves to UNKNOWN anyway.
    var base: u32 = mir.MIR_VREG_NIL;
    if (op.kind == mir.MIR_OP_VREG) { base = op.vreg; }
    or (op.kind == mir.MIR_OP_MEM) { base = op.vreg; }
    if (base == mir.MIR_VREG_NIL) { ret ADDR_UNKNOWN; }

    val def: *mir.MirInstr = defining_instr(mf, base);
    if (def == nil) { ret ADDR_UNKNOWN; }
    if (def.opcode == mir.MIR_ALLOCA) { ret ADDR_ALLOCA; }
    if (def.opcode == mir.MIR_GEP && def.operand_count >= 2
        && def.operands[1].kind == mir.MIR_OP_SYM) {
        ret address_origin(e, mf, ?def.operands[1], out_ix);
    }
    ret ADDR_UNKNOWN;
}

# the instruction defining a vreg in this function, or nil when none does
# ---
# mf:   the MIR function
# vreg: the vreg to find the definition of
# ret:  the defining instruction, or nil
fun defining_instr(mf: *mir.MirFunction, vreg: u32) *mir.MirInstr {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mir.instr_defines_shape(mi) && mi.operand_count > 0
                && mi.operands[0].kind == mir.MIR_OP_VREG && mi.operands[0].vreg == vreg) {
                ret mi;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret nil;
}

# the address operand index of a load or store
#
# A load addresses through operand 1 and a store through operand 0, the shared
# convention that operand 0 of a store is its memory destination.
# ---
# mi:  the instruction
# ret: the operand index carrying the address
fun address_operand_index(mi: *mir.MirInstr) u32 {
    if (mi.opcode == mir.MIR_LOAD) { ret 1; }
    ret 0;
}

# the diagnostic for a CFG the reconstruction cannot express, naming the function
# and the block the shape was found at
#
# The message is interned so the caller need not own it; interning failure falls
# back to the bare reason, which still names the construct.
# ---
# e:    the emission state
# name: the function's exported name
# st:   the failed reconstruction
# ret:  the diagnostic text
fun cfg_refusal(e: *Emit, name: str, st: *cfg.Structure) str {
    val reason: str = cfg.status_message(st.status);
    val jr: R.Result[str, str] = str_join(e.alloc, "spirv.emit: ", name, ": ", reason);
    if (R.is_err[str, str](jr)) { ret reason; }
    val buf: str = R.unwrap_ok[str, str](jr);
    val ir: R.Result[intern.StrId, str] = intern.intern(e.interner, buf);
    A.deallocate[u8](e.alloc, buf::*u8, str_len(buf) + 1);
    if (R.is_err[intern.StrId, str](ir)) { ret reason; }
    val io: O.Option[str] = intern.lookup(e.interner, R.unwrap_ok[intern.StrId, str](ir));
    if (O.is_none[str](io)) { ret reason; }
    ret O.unwrap[str](io);
}

# emit one node of the reconstruction: its label, its body, its merge declaration,
# and its terminator
#
# A real block contributes its MIR instructions; the synthesized nodes carry no MIR
# and exist only to give the structure the shape SPIR-V requires - a loop's single
# back edge, a construct's merge point, a header's displaced branch.
# ---
# e:            the emission state
# mf:           the MIR function
# st:           the reconstructed structure
# ix:           the node to emit
# is_entry:     whether this is the function's first block (its label is already out)
# labels:       the per-node label ids
# vm:           the per-vreg value maps
# param_ids:    the OpFunctionParameter ids, in order
# param_count:  number of parameters
# returns_void: whether the function returns void
# ret_ty:       the SPIR-V return type id, which types a returned immediate
# ret:          true on success, or a precise error string
fun emit_node(e: *Emit, mf: *mir.MirFunction, st: *cfg.Structure, ix: u32, is_entry: bool,
              labels: *u32, vm: *VMaps, param_ids: *u32, param_count: u32,
              returns_void: bool, ret_ty: u32) R.Result[bool, str] {
    if (!is_entry) {
        var lb: [1]u32;
        lb[0] = labels[ix];
        spirv.inst(e.b, ?e.b.functions, spirv.OP_LABEL, ?lb[0], 1);
    }

    val role: u8 = st.nodes[ix].role;
    if (role == cfg.ROLE_UNREACHABLE) {
        spirv.inst(e.b, ?e.b.functions, spirv.OP_UNREACHABLE, nil, 0);
        ret R.ok[bool, str](true);
    }
    if (role == cfg.ROLE_CONTINUE || role == cfg.ROLE_FORWARD) {
        emit_branch(e, labels[st.nodes[ix].succ0]);
        ret R.ok[bool, str](true);
    }

    # the register file is per block: the ABI pre-coloring a lowered call or return
    # emits never spans one, and a physical register index is otherwise a parameter
    # position, valid for the whole function.
    var rg: Regs;
    var i: u32 = 0;
    for (i < 16) { rg.val_id[i] = 0; rg.imm[i] = 0; rg.is_imm[i] = false; i = i + 1; }
    i = 0;
    for (i < param_count && i < 16) { rg.val_id[i] = param_ids[i]; i = i + 1; }

    val blk: *mir.MirBlock = ?mf.blocks[st.nodes[ix].block];
    if (role == cfg.ROLE_REAL) {
        var ii: u32 = 0;
        for (ii + 1 < blk.instr_count) {
            val r: R.Result[bool, str] = emit_instr(e, mf, vm, ?rg, ?blk.instrs[ii]);
            if (R.is_err[bool, str](r)) { ret r; }
            ii = ii + 1;
        }
    }

    ret emit_terminator(e, mf, st, ix, labels, vm, ?rg, returns_void, ret_ty);
}

# declare where a construct's control reconverges, ahead of its branch
# ---
# e:      the emission state
# st:     the reconstructed structure
# ix:     the header node
# labels: the per-node label ids
fun emit_merge(e: *Emit, st: *cfg.Structure, ix: u32, labels: *u32) {
    if (st.nodes[ix].kind == cfg.CK_LOOP) {
        var lm: [3]u32;
        lm[0] = labels[st.nodes[ix].merge];
        lm[1] = labels[st.nodes[ix].cont];
        lm[2] = spirv.LOOP_CONTROL_NONE;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_LOOP_MERGE, ?lm[0], 3);
        ret;
    }
    if (st.nodes[ix].kind == cfg.CK_SELECTION) {
        var sm: [2]u32;
        sm[0] = labels[st.nodes[ix].merge];
        sm[1] = spirv.SELECTION_CONTROL_NONE;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECTION_MERGE, ?sm[0], 2);
    }
}

# emit one OpBranch
# ---
# e:     the emission state
# label: the target label id
fun emit_branch(e: *Emit, label: u32) {
    var o: [1]u32;
    o[0] = label;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_BRANCH, ?o[0], 1);
}

# emit a node's terminator from the reconstruction's successor edges
#
# The branch targets come from the structure, not the MIR terminator: a back edge
# was rewritten to the loop's continue block, and a header whose branch was
# displaced falls into its split block instead. Only the condition and the returned
# value still come from the MIR.
# ---
# e:            the emission state
# mf:           the MIR function
# st:           the reconstructed structure
# ix:           the node being terminated
# labels:       the per-node label ids
# vm:           the per-vreg value maps
# preg_val:     the identity convention's nominal register file
# returns_void: whether the function returns void
# ret_ty:       the SPIR-V return type id, which types a returned immediate
# ret:          true on success, or a precise error string
fun emit_terminator(e: *Emit, mf: *mir.MirFunction, st: *cfg.Structure, ix: u32, labels: *u32,
                    vm: *VMaps, preg_val: *Regs, returns_void: bool, ret_ty: u32) R.Result[bool, str] {
    # a header that kept no branch of its own falls into the block carrying it.
    if (st.nodes[ix].split != cfg.NO_BLOCK) {
        emit_merge(e, st, ix, labels);
        emit_branch(e, labels[st.nodes[ix].split]);
        ret R.ok[bool, str](true);
    }

    val blk: *mir.MirBlock = ?mf.blocks[st.nodes[ix].block];
    val term: *mir.MirInstr = ?blk.instrs[blk.instr_count - 1];
    # the terminator is the instruction any refusal below is about; without this
    # stamp one would name the last BODY instruction instead, which is a wrong
    # attribution rather than a missing one
    e.cur_instr = term;

    if (term.opcode == mir.MIR_BR) {
        emit_merge(e, st, ix, labels);
        emit_branch(e, labels[st.nodes[ix].succ0]);
        ret R.ok[bool, str](true);
    }
    if (term.opcode == mir.MIR_CBR) {
        # the condition is materialized ahead of the merge declaration: SPIR-V wants
        # the merge instruction immediately before the branch it describes.
        val cond: u32 = read_condition(e, vm, preg_val, ?term.operands[0]);
        if (cond == 0) { ret R.err[bool, str]("spirv.emit: unreadable branch condition"); }
        emit_merge(e, st, ix, labels);
        var bc: [3]u32;
        bc[0] = cond;
        bc[1] = labels[st.nodes[ix].succ0];
        bc[2] = labels[st.nodes[ix].succ1];
        spirv.inst(e.b, ?e.b.functions, spirv.OP_BRANCH_CONDITIONAL, ?bc[0], 3);
        ret R.ok[bool, str](true);
    }
    if (term.opcode == mir.MIR_UNREACHABLE) {
        spirv.inst(e.b, ?e.b.functions, spirv.OP_UNREACHABLE, nil, 0);
        ret R.ok[bool, str](true);
    }
    if (term.opcode == mir.MIR_RET) {
        if (returns_void) {
            spirv.inst(e.b, ?e.b.functions, spirv.OP_RETURN, nil, 0);
            ret R.ok[bool, str](true);
        }
        val rid: u32 = reg_value(e, preg_val, 0, ret_ty);
        if (rid == 0) { ret R.err[bool, str]("spirv.emit: value return with no pre-colored result"); }
        var rv: [1]u32;
        rv[0] = rid;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_RETURN_VALUE, ?rv[0], 1);
        ret R.ok[bool, str](true);
    }
    ret unsupported(e, "instruction is not yet supported by the SPIR-V target");
}

# produce a boolean SSA value for a conditional branch's condition
#
# A vreg defined by a comparison already holds a SPIR-V boolean; anything else is
# a numeric flag, which is compared against a zero of its own type to become one.
# The float form uses the UNORDERED inequality, so a NaN flag reads as true - the
# same reading the x86-64 float compare gives it.
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# op:       the condition operand
# ret:      the boolean SSA id, or 0 on failure
fun read_condition(e: *Emit, vm: *VMaps, preg_val: *Regs, op: *mir.MirOperand) u32 {
    if (op.kind != mir.MIR_OP_VREG) { e.b.err = true; ret 0; }
    val v: u32 = op.vreg;
    if (v >= vm.n) { e.b.err = true; ret 0; }
    val ty: u32 = vm.type_id[v];
    val raw: u32 = read_operand(e, vm, preg_val, op, ty);
    if (e.b.err || raw == 0) { ret 0; }
    if (vm.is_bool[v]) { ret raw; }

    var cmp_ty: u32 = ty;
    if (cmp_ty == 0) { cmp_ty = types.type_int(e.tt, e.tgt.model.gpr_width * 8); }
    var opcode: u32 = spirv.OP_I_NOT_EQUAL;
    if (types.type_is_float(e.tt, cmp_ty)) { opcode = spirv.OP_F_UNORD_NOT_EQUAL; }
    val zero: u32 = types.const_scalar(e.tt, cmp_ty, 0, 0);
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [4]u32;
    ops[0] = types.type_bool(e.tt); ops[1] = result; ops[2] = raw; ops[3] = zero;
    spirv.inst(e.b, ?e.b.functions, opcode, ?ops[0], 4);
    ret result;
}

# the name a consumer looks an entry point up by: the function's BARE source name
#
# Not the mangled linkage name the rest of the back end uses. An entry point name is
# a lookup key passed to a pipeline-creation call, not a linker symbol - and a
# shader module declares no Linkage capability at all, so the mangled name has
# nothing to refer to inside one. Falls back to the linkage name only for a
# synthesized function carrying no source spelling, which cannot currently declare a
# stage anyway.
# ---
# e:       the emission state
# irfn:    the IR function
# linkage: the mangled linkage name, the fallback
# ret:     the entry point name
fun entry_name(e: *Emit, irfn: *ir.Function, linkage: str) str {
    if (irfn.disp == intern.STR_NIL) { ret linkage; }
    val opt: O.Option[str] = intern.lookup(e.interner, irfn.disp);
    if (O.is_none[str](opt)) { ret linkage; }
    ret O.unwrap[str](opt);
}

# emit the OpEntryPoint, and the execution modes the stage requires
#
# SPIR-V constrains an entry function's signature hard: it takes no parameters and
# returns void, because a pipeline stage's inputs and outputs travel through
# interface VARIABLES rather than through a call. That is checked here rather than
# left to the validator, so a mach signature that cannot be a stage is reported
# against the function that declared the stage.
#
# The interface operand list names every Input and Output variable the entry point
# statically uses. It is empty until interface variables exist, which is valid: an
# entry point that reads and writes nothing has nothing to list.
#
# Two execution modes are not optional under Vulkan and are emitted with the stage
# rather than left to the author: a fragment stage must fix its framebuffer origin,
# and a compute stage must declare its workgroup size.
# ---
# e:            the emission state
# irfn:         the IR function (its stage and workgroup dimensions)
# fn_ix:        the function's IR index, which selects its interface-use row
# fn_id:        the function's SPIR-V id
# name:         the entry point's name, as a consumer will look it up
# returns_void: whether the function returns void
# ret:          true on success, or a precise error string
fun emit_entry_point(e: *Emit, irfn: *ir.Function, fn_ix: u32, fn_id: u32, name: str,
                     returns_void: bool) R.Result[bool, str] {
    if (!returns_void) {
        ret unsupported(e, "a function declaring a `#[stage(...)]` must return nothing: a pipeline stage's results leave through its output interface variables, not through a return value");
    }
    if (irfn.param_count != 0) {
        ret unsupported(e, "a function declaring a `#[stage(...)]` must take no parameters: a pipeline stage's inputs arrive through its input interface variables, not as arguments");
    }

    var model: u32 = spirv.EXEC_MODEL_VERTEX;
    if (irfn.stage == ir.STAGE_FRAGMENT) { model = spirv.EXEC_MODEL_FRAGMENT; }
    or (irfn.stage == ir.STAGE_COMPUTE)  { model = spirv.EXEC_MODEL_GLCOMPUTE; }

    # OpEntryPoint <model> <fn> "<name>" <interface...>. The interface names every
    # Input and Output variable the entry point can reach. Listing the module's whole
    # set rather than the subset one stage touches is permitted from SPIR-V 1.4 on and
    # is what a module targeting 1.6 wants: the alternative is a reachability walk
    # whose only effect would be to shorten a list a consumer does not read for size.
    val sw: u32 = spirv.string_words(name);
    var used: u32 = 0;
    var si: u32 = 0;
    for (si < e.iface_len) {
        if (uses_iface(e, fn_ix, si)) { used = used + 1; }
        si = si + 1;
    }
    val total: u32 = 2 + sw + used;
    val ra: R.Result[*u32, str] = A.allocate[u32](e.alloc, total::usize);
    if (R.is_err[*u32, str](ra)) { ret R.err[bool, str](R.unwrap_err[*u32, str](ra)); }
    val ops: *u32 = R.unwrap_ok[*u32, str](ra);
    ops[0] = model;
    ops[1] = fn_id;
    spirv.pack_string(name, ?ops[2]);
    var ii: u32 = 0;
    si = 0;
    for (si < e.iface_len) {
        if (uses_iface(e, fn_ix, si)) { ops[2 + sw + ii] = e.iface_ids[si]; ii = ii + 1; }
        si = si + 1;
    }
    spirv.inst(e.b, ?e.b.entry_points, spirv.OP_ENTRY_POINT, ops, total);
    A.deallocate[u32](e.alloc, ops, total::usize);

    if (irfn.stage == ir.STAGE_FRAGMENT) {
        var fm: [2]u32;
        fm[0] = fn_id; fm[1] = spirv.EXEC_MODE_ORIGIN_UPPER_LEFT;
        spirv.inst(e.b, ?e.b.exec_modes, spirv.OP_EXECUTION_MODE, ?fm[0], 2);
    }
    if (irfn.stage == ir.STAGE_COMPUTE) {
        var cm: [5]u32;
        cm[0] = fn_id; cm[1] = spirv.EXEC_MODE_LOCAL_SIZE;
        cm[2] = irfn.wg_x; cm[3] = irfn.wg_y; cm[4] = irfn.wg_z;
        spirv.inst(e.b, ?e.b.exec_modes, spirv.OP_EXECUTION_MODE, ?cm[0], 5);
    }
    ret R.ok[bool, str](true);
}

# emit the LinkageAttributes Export decoration for a function
# ---
# e:    the emission state
# fn:   the function id to decorate
# name: the exported symbol name
fun emit_linkage_export(e: *Emit, fn: u32, name: str) {
    val sw: u32 = spirv.string_words(name);
    # target + decoration + string words + linkage type.
    val total: u32 = 3 + sw;
    val ra: R.Result[*u32, str] = A.allocate[u32](e.alloc, total::usize);
    if (R.is_err[*u32, str](ra)) { e.b.err = true; ret; }
    val ops: *u32 = R.unwrap_ok[*u32, str](ra);
    ops[0] = fn;
    ops[1] = spirv.DECOR_LINKAGE_ATTRIBUTES;
    spirv.pack_string(name, ?ops[2]);
    ops[2 + sw] = spirv.LINKAGE_EXPORT;
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ops, total);
    A.deallocate[u32](e.alloc, ops, total::usize);
}

# build the per-vreg type and variable maps, emitting one Function-storage
# OpVariable per defined vreg at the current (entry) position
#
# A vreg's element type is its definition's width and register class: a vreg
# defined by a comparison is boolean; otherwise it is the integer / float type of
# the defining instruction's result width. Every defined vreg gets a variable so a
# later block's store and a use's load resolve to the same storage.
# ---
# A parameter vreg is typed from the IR signature rather than its pre-coloring
# move width: an i32 parameter rides a word-width register move but is logically
# i32, so trusting the move width would over-widen it.
# ---
# e:    the emission state
# mf:   the MIR function
# irfn: the IR function (for parameter types)
# out:  receives the initialized maps (owned; freed by vmaps_dnit)
# ret:  true on success, or a precise error string
fun build_vmaps(e: *Emit, mf: *mir.MirFunction, irfn: *ir.Function, out: *VMaps) R.Result[bool, str] {
    val n: u32 = mf.vreg_count;
    out.n = n;
    out.type_id = nil;
    out.var_id  = nil;
    out.is_bool = nil;
    out.chain_id = nil;
    out.chain_ty = nil;
    out.chain_sc = nil;
    out.opq_var = nil;
    out.opq_ssa = nil;
    if (n == 0) { ret R.ok[bool, str](true); }

    val rt: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rt)) { ret R.err[bool, str](R.unwrap_err[*u32, str](rt)); }
    out.type_id = R.unwrap_ok[*u32, str](rt);
    val rv: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rv)) { ret R.err[bool, str](R.unwrap_err[*u32, str](rv)); }
    out.var_id = R.unwrap_ok[*u32, str](rv);
    val rb: R.Result[*bool, str] = A.allocate[bool](e.alloc, n::usize);
    if (R.is_err[*bool, str](rb)) { ret R.err[bool, str](R.unwrap_err[*bool, str](rb)); }
    out.is_bool = R.unwrap_ok[*bool, str](rb);
    val rch: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rch)) { ret R.err[bool, str](R.unwrap_err[*u32, str](rch)); }
    out.chain_id = R.unwrap_ok[*u32, str](rch);
    val rct: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rct)) { ret R.err[bool, str](R.unwrap_err[*u32, str](rct)); }
    out.chain_ty = R.unwrap_ok[*u32, str](rct);
    val rcs: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rcs)) { ret R.err[bool, str](R.unwrap_err[*u32, str](rcs)); }
    out.chain_sc = R.unwrap_ok[*u32, str](rcs);
    val rov: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rov)) { ret R.err[bool, str](R.unwrap_err[*u32, str](rov)); }
    out.opq_var = R.unwrap_ok[*u32, str](rov);
    val ros: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](ros)) { ret R.err[bool, str](R.unwrap_err[*u32, str](ros)); }
    out.opq_ssa = R.unwrap_ok[*u32, str](ros);

    var i: u32 = 0;
    for (i < n) { out.type_id[i] = 0; out.var_id[i] = 0; out.is_bool[i] = false; out.chain_id[i] = 0; out.chain_ty[i] = 0; out.chain_sc[i] = 0; out.opq_var[i] = 0; out.opq_ssa[i] = 0; i = i + 1; }

    # a vreg fed from a nominal register is typed by the DECLARATION behind that
    # register, never by the move: the ABI pre-coloring is emitted at the machine
    # word, so an i32 parameter or an i32 call result would over-widen. Register k
    # means parameter k at the head of the function and the return value right after
    # a call, so the two are told apart by the call that precedes the move.
    var pb: u32 = 0;
    for (pb < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[pb];
        var ei: u32 = 0;
        var callee: intern.StrId = intern.STR_NIL;
        for (ei < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ei];
            if (mi.opcode == mir.MIR_CALL && mi.operand_count >= 1 && mi.operands[0].kind == mir.MIR_OP_SYM) {
                callee = mi.operands[0].sym;
            }
            or (mi.opcode == mir.MIR_CALL_RES) { callee = intern.STR_NIL; }
            or (mi.opcode == mir.MIR_MOV && mi.operand_count == 2 &&
                mi.operands[0].kind == mir.MIR_OP_VREG && mi.operands[1].kind == mir.MIR_OP_PREG) {
                val k: u32 = mi.operands[1].preg;
                val v: u32 = mi.operands[0].vreg;
                var t: u32 = 0;
                if (callee != intern.STR_NIL) {
                    # by RECORD, not by `ir_function_index`, which skips a
                    # declaration because its answer also selects a pre-allocated
                    # SPIR-V id. What is wanted here is the callee's declared RETURN
                    # TYPE, which a signature-only declaration has just as much as a
                    # definition does. Looking it up the other way left every
                    # cross-module call's result typed by the move's machine width
                    # instead: an `f32` came back 64 bits wide and a scalar returned
                    # from vector arguments came back a vector, and the module failed
                    # validation at the store rather than at the call.
                    val cfn: *ir.Function = ir_function_record(e.ir, callee);
                    if (cfn != nil) {
                        var cvoid: bool = false;
                        t = ir_return_spv_type(e, cfn, ?cvoid);
                        if (cvoid) { t = 0; }
                    }
                    callee = intern.STR_NIL;
                }
                or (k < irfn.param_count) {
                    t = ir_value_spv_type(e, irfn.params[k].ty);
                }
                if (t != 0 && v < n && out.type_id[v] == 0) {
                    out.type_id[v] = t;
                    out.is_bool[v] = false;
                }
            }
            ei = ei + 1;
        }
        pb = pb + 1;
    }

    # a vreg's type comes from the operation that computes it. A register copy is
    # not one - it moves a value already typed elsewhere - so copies are left for the
    # propagation below and only revisited if nothing typed them.
    val r1: R.Result[bool, str] = type_computed_defs(e, mf, out, true);
    if (R.is_err[bool, str](r1)) { ret r1; }
    propagate_copy_types(mf, out);
    val r2: R.Result[bool, str] = type_computed_defs(e, mf, out, false);
    if (R.is_err[bool, str](r2)) { ret r2; }

    # a local allocation becomes a Function-storage OpVariable, declared HERE rather
    # than where the MIR_ALLOCA sits: SPIR-V requires every Function variable to be
    # in the function's first block, ahead of any other instruction. The allocation's
    # result vreg is an address, so it is recorded as an access chain base - the same
    # shape an interface variable's id has - and every load, store and member walk
    # off it then goes through machinery that already exists.
    val ar: R.Result[bool, str] = declare_allocas(e, mf, out);
    if (R.is_err[bool, str](ar)) { ret ar; }

    # emit one OpVariable(Function) per defined vreg, at the entry, and record its id.
    i = 0;
    for (i < n) {
        # AN OPAQUE HANDLE GETS NO BACKING VARIABLE (#2794). Every other vreg round
        # trips through a Function-storage variable, which is this emitter's whole
        # value model; a handle cannot, because SPIR-V forbids storing an image,
        # sampler or sampled-image object into anything. Its value is carried as an
        # id, or re-loaded from the descriptor it came from, instead.
        if (out.type_id[i] != 0 && !types.type_is_opaque(e.tt, out.type_id[i])) {
            val ptr_ty: u32 = types.type_ptr(e.tt, spirv.STORAGE_FUNCTION, out.type_id[i]);
            val var_id: u32 = spirv.alloc_id(e.b);
            var vop: [3]u32;
            vop[0] = ptr_ty; vop[1] = var_id; vop[2] = spirv.STORAGE_FUNCTION;
            spirv.inst(e.b, ?e.b.functions, spirv.OP_VARIABLE, ?vop[0], 3);
            out.var_id[i] = var_id;
        }
        i = i + 1;
    }
    ret R.ok[bool, str](true);
}

# declare one Function-storage OpVariable per local allocation, at the entry
#
# The allocated TYPE comes from the frame slot rather than from the instruction:
# `MIR_ALLOCA` carries a slot reference, and the slot records the IR type it was
# allocated at. Without that this could not be done at all - a size and an alignment
# do not determine a type, and a Function variable needs one.
# ---
# e:   the emission state
# mf:  the MIR function
# out: the maps being filled
# ret: true on success, or a precise error string
fun declare_allocas(e: *Emit, mf: *mir.MirFunction, out: *VMaps) R.Result[bool, str] {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mi.opcode != mir.MIR_ALLOCA || mi.operand_count < 2
                || mi.operands[0].kind != mir.MIR_OP_VREG) { ii = ii + 1; cnt; }
            val dst: u32 = mi.operands[0].vreg;
            if (dst >= out.n) { ii = ii + 1; cnt; }

            val slot: *mir.MirSlot = find_slot(mf, mi.operands[1].vreg);
            if (slot == nil || slot.ty == mir.SLOT_TY_NIL) {
                ret unsupported(e, "a local allocation whose type was not recorded is not supported by the SPIR-V target: a shader variable needs a type, and a size and alignment do not determine one");
            }
            val ty: u32 = ir_value_spv_type(e, slot.ty);
            if (ty == 0) {
                ret unsupported(e, "unsupported local allocation type in the SPIR-V target");
            }
            # a slot wider than its own type is an array of them, which is pointer
            # arithmetic across whole objects rather than one variable.
            if (slot.size != type.byte_size(?e.ir.types, slot.ty, e.tgt)) {
                ret unsupported(e, "a multi-element local allocation is not supported by the SPIR-V target: it is an array of whole objects reached by pointer arithmetic, which the logical addressing model has no form for");
            }

            val ptr_ty: u32 = types.type_ptr(e.tt, spirv.STORAGE_FUNCTION, ty);
            val var_id: u32 = spirv.alloc_id(e.b);
            var vop: [3]u32;
            vop[0] = ptr_ty; vop[1] = var_id; vop[2] = spirv.STORAGE_FUNCTION;
            spirv.inst(e.b, ?e.b.functions, spirv.OP_VARIABLE, ?vop[0], 3);
            out.chain_id[dst] = var_id;
            out.chain_ty[dst] = ty;
            out.chain_sc[dst] = spirv.STORAGE_FUNCTION;
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret R.ok[bool, str](true);
}

# the frame slot a slot-key names, or nil when none does
# ---
# mf:  the MIR function
# key: the slot-key vreg
# ret: the slot, or nil
fun find_slot(mf: *mir.MirFunction, key: u32) *mir.MirSlot {
    var i: u32 = 0;
    for (i < mf.frame.slot_count) {
        if (mf.frame.slots[i].value == key) { ret ?mf.frame.slots[i]; }
        i = i + 1;
    }
    ret nil;
}

# type every vreg a computing instruction defines, from its result width and class
#
# A comparison yields a boolean; anything else yields the integer or float type of
# the defining instruction's result width. When `skip_copies` is set, a register-to-
# register move is passed over: its width is the machine word the ABI and phi
# lowering copy at, not the value's, so its destination is typed by propagation
# instead.
# ---
# e:           the emission state
# mf:          the MIR function
# out:         the maps being filled
# skip_copies: leave register-to-register moves untyped
# ret:         true on success, or a precise error string
fun type_computed_defs(e: *Emit, mf: *mir.MirFunction, out: *VMaps, skip_copies: bool) R.Result[bool, str] {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            # a structural GEP defines an ADDRESS. It gets no element type and no
            # backing variable: the access chain it becomes is consumed directly by
            # the load or store that follows, never loaded as a value.
            if (mi.opcode == mir.MIR_GEP || mi.opcode == mir.MIR_ALLOCA) { ii = ii + 1; cnt; }
            # A WHOLE-VARIABLE LOAD IS TYPED BY THE VARIABLE, not by the move's
            # width and register class. The object's own type is the authority -
            # the store side has always read it this way - and a width plus a class
            # cannot express every type a variable holds: an opaque image handle
            # has no width at all, and inferring one gave it an integer type and an
            # `OpLoad %ulong` from a sampled-image variable, which is a module the
            # validator rejects and the compiler was happy to write (#2794).
            if (mi.opcode == mir.MIR_LOAD && mi.operand_count == 2
                && mi.operands[0].kind == mir.MIR_OP_VREG) {
                val lv: u32 = mi.operands[0].vreg;
                val lt: u32 = interface_value_type(e, ?mi.operands[1]);
                if (lv < out.n && out.type_id[lv] == 0 && lt != 0) {
                    out.type_id[lv] = lt;
                    out.is_bool[lv] = false;
                    ii = ii + 1;
                    cnt;
                }
            }
            if (mir.instr_defines_shape(mi) && mi.operands[0].kind == mir.MIR_OP_VREG) {
                val v: u32 = mi.operands[0].vreg;
                if (v < out.n && out.type_id[v] == 0 && !(skip_copies && is_reg_copy(mi))) {
                    # a LANE-WISE comparison yields mach's mask vector, not a
                    # boolean: only a scalar comparison defines a SPIR-V bool.
                    val boolean: bool = (mir.is_cmp_opcode(mi.opcode) || mi.opcode == mir.MIR_FCMP)
                                     && !mir.vec_lane_is_vector(mi.vec_lane);
                    out.is_bool[v] = boolean;
                    if (boolean) {
                        out.type_id[v] = types.type_bool(e.tt);
                    }
                    or {
                        var bytes: u32 = mi.width::u32;
                        if (bytes == 0) { bytes = e.tgt.model.gpr_width; }
                        val t: u32 = value_type_for(e, mf, mi, v, bytes::u8);
                        if (t == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
                        out.type_id[v] = t;
                    }
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret R.ok[bool, str](true);
}

# whether an instruction is a register-to-register copy, whose destination type is
# the source's rather than the move's width
# ---
# mi:  the instruction
# ret: true for a move or declassify from a virtual or physical register
fun is_reg_copy(mi: *mir.MirInstr) bool {
    if (mi.opcode != mir.MIR_MOV && mi.opcode != mir.MIR_DECLASSIFY) { ret false; }
    if (mi.operand_count != 2) { ret false; }
    ret mi.operands[1].kind == mir.MIR_OP_VREG || mi.operands[1].kind == mir.MIR_OP_PREG;
}

# carry types across register copies to a fixed point
#
# The phi edge copies a lowered `if` / `for` leaves behind are emitted at the machine
# word, so a copied i32 or boolean would come out 64 bits wide. The destination takes
# the source's type instead.
# ---
# mf:  the MIR function
# out: the maps being filled
fun propagate_copy_types(mf: *mir.MirFunction, out: *VMaps) {
    var changed: bool = true;
    for (changed) {
        changed = false;
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                if (is_reg_copy(mi) && mi.operands[0].kind == mir.MIR_OP_VREG &&
                    mi.operands[1].kind == mir.MIR_OP_VREG) {
                    val d:  u32 = mi.operands[0].vreg;
                    val sv: u32 = mi.operands[1].vreg;
                    if (d < out.n && sv < out.n && out.type_id[d] == 0 && out.type_id[sv] != 0) {
                        out.type_id[d] = out.type_id[sv];
                        out.is_bool[d] = out.is_bool[sv];
                        changed = true;
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }
}

# free the per-vreg maps
# ---
# e:  the emission state (its allocator owns the maps)
# vm: the maps to free
fun vmaps_dnit(e: *Emit, vm: *VMaps) {
    if (vm.type_id != nil) { A.deallocate[u32](e.alloc, vm.type_id, vm.n::usize); }
    if (vm.var_id != nil)  { A.deallocate[u32](e.alloc, vm.var_id, vm.n::usize); }
    if (vm.is_bool != nil) { A.deallocate[bool](e.alloc, vm.is_bool, vm.n::usize); }
    if (vm.opq_var != nil) { A.deallocate[u32](e.alloc, vm.opq_var, vm.n::usize); }
    if (vm.opq_ssa != nil) { A.deallocate[u32](e.alloc, vm.opq_ssa, vm.n::usize); }
    if (vm.chain_id != nil) { A.deallocate[u32](e.alloc, vm.chain_id, vm.n::usize); }
    if (vm.chain_ty != nil) { A.deallocate[u32](e.alloc, vm.chain_ty, vm.n::usize); }
    if (vm.chain_sc != nil) { A.deallocate[u32](e.alloc, vm.chain_sc, vm.n::usize); }
    vm.type_id = nil; vm.var_id = nil; vm.is_bool = nil;
    vm.chain_id = nil; vm.chain_ty = nil; vm.chain_sc = nil; vm.n = 0;
}

# the SPIR-V scalar type of one lane of a lane descriptor, or 0 when unmappable
# ---
# e:    the emission state
# lane: the packed lane descriptor
# ret:  the lane's SPIR-V scalar type id, or 0
fun lane_type_of(e: *Emit, lane: u32) u32 {
    val bits: u32 = mir.vec_lane_elem_bytes(lane)::u32 * 8;
    if (mir.vec_lane_kind(lane) == mir.VEC_LANE_FLOAT) {
        if (bits != 32 && bits != 64) { ret 0; }
        ret types.type_float(e.tt, bits);
    }
    if (bits != 8 && bits != 16 && bits != 32 && bits != 64) { ret 0; }
    ret types.type_int(e.tt, bits);
}

# the SPIR-V type a lane descriptor's vector is realized as, or 0 when unmappable
# ---
# e:       the emission state
# lane:    the packed lane descriptor
# as_int:  force integer lanes at the descriptor's width, for a comparison mask
# ret:     the realization's type id (OpTypeVector, or the array form), or 0
fun vector_type_of(e: *Emit, lane: u32, as_int: bool) u32 {
    var lane_ty: u32 = 0;
    if (as_int) {
        val bits: u32 = mir.vec_lane_elem_bytes(lane)::u32 * 8;
        if (bits != 8 && bits != 16 && bits != 32 && bits != 64) { ret 0; }
        lane_ty = types.type_int(e.tt, bits);
    }
    or { lane_ty = lane_type_of(e, lane); }
    if (lane_ty == 0) { ret 0; }
    ret types.type_vector_value(e.tt, lane_ty, mir.vec_lane_count(lane));
}

# the SPIR-V type a defining instruction gives its result vreg
#
# For a scalar result the register class picks integer vs float and the width
# (defaulting to the machine word when unset) picks the bit width. For a vector
# result the instruction's `vec_lane` descriptor carries both the LANE class and
# the lane width - and it, not the register class, is the authority there, because
# the whole vector rides one nominal bank. Returns 0 for a shape the milestone does
# not map, including a lane count SPIR-V reserves for Kernel modules.
# ---
# e:     the emission state
# mf:    the MIR function (for the vreg's register class)
# mi:    the defining instruction
# vreg:  the vreg id
# width: the defining instruction's result width in bytes (0 = unset)
# ret:   the SPIR-V type id, or 0
fun value_type_for(e: *Emit, mf: *mir.MirFunction, mi: *mir.MirInstr, vreg: u32, width: u8) u32 {
    if (mir.vec_lane_is_vector(mi.vec_lane)) {
        # a lane read is the one vector-tagged instruction whose RESULT is a scalar:
        # the descriptor describes the vector it reads out of, not what it produces.
        if (mi.opcode == mir.MIR_VEC_EXTRACT) { ret lane_type_of(e, mi.vec_lane); }
        # a comparison's result is mach's mask: the UNSIGNED INTEGER vector of the
        # compared lanes' width, never a vector of the compared class. SPIR-V's own
        # boolean vector is an intermediate inside emit_vector_compare, not this type.
        val as_int: bool = mir.is_cmp_opcode(mi.opcode) || mi.opcode == mir.MIR_FCMP;
        ret vector_type_of(e, mi.vec_lane, as_int);
    }
    var bytes: u32 = width::u32;
    if (bytes == 0) { bytes = e.tgt.model.gpr_width; }
    val bits: u32 = bytes * 8;
    if (mir.vreg_is_fp(mf, vreg)) {
        if (bits == 32 || bits == 64) { ret types.type_float(e.tt, bits); }
        ret 0;
    }
    if (bits == 8 || bits == 16 || bits == 32 || bits == 64) { ret types.type_int(e.tt, bits); }
    ret 0;
}

# the SPIR-V type of an IR value type id (int / float / vector), or 0 when
# unsupported
#
# A vector maps lane-for-lane onto `OpTypeVector`, which is why the SPIR-V target
# declares a vector unit and lets vectors through MIR intact rather than
# scalarizing them. A lane count SPIR-V reserves for Kernel modules is realized as
# an array of the same lanes instead (`types.type_vector_value`), never refused.
# ---
# AN IR TYPE ID IS ONLY MEANINGFUL AGAINST ITS OWN MODULE'S TABLE, so which table
# is never implicit here. `ir_value_spv_type` reads the member currently in scope,
# which is right for anything read off a body or a function signature;
# `global_spv_type` reads the root's, which is right for a global, whichever
# member's function is being emitted. Getting this wrong does not fail loudly - it
# silently resolves to a DIFFERENT type of the same index - so the two wrappers
# exist rather than one function and a convention (#2823).
# ---
# e:   the emission state
# tys: the IR type table `id` indexes
# id:  the IR type id
# ret: the SPIR-V type id, or 0
fun spv_type_of(e: *Emit, tys: *type.IrTypeTable, id: type.IrTypeId) u32 {
    val opt: O.Option[*type.IrType] = type.get(tys, id);
    if (O.is_none[*type.IrType](opt)) { ret 0; }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);
    if (t.kind == type.IRT_INT)   { ret types.type_int(e.tt, t.data.bits); }
    if (t.kind == type.IRT_FLOAT) { ret types.type_float(e.tt, t.data.bits); }
    if (t.kind == type.IRT_VECTOR) {
        val elem: u32 = spv_type_of(e, tys, t.data.vector_.element);
        if (elem == 0) { ret 0; }
        ret types.type_vector_value(e.tt, elem, t.data.vector_.lanes);
    }
    if (t.kind == type.IRT_ARRAY) {
        val elem: u32 = spv_type_of(e, tys, t.data.array_.element);
        if (elem == 0) { ret 0; }
        ret types.type_array(e.tt, elem, t.data.array_.count, false);
    }
    if (t.kind == type.IRT_IMAGE) { ret image_spv_type(e, t); }
    if (t.kind == type.IRT_STRUCT) {
        val n: u32 = t.data.struct_.field_count;
        if (n == 0 || n > types.MAX_STRUCT_MEMBERS) { ret 0; }
        var members: [16]u32;
        var i: u32 = 0;
        for (i < n) {
            val mt: u32 = spv_type_of(e, tys, t.data.struct_.fields[i]);
            if (mt == 0) { ret 0; }
            members[i] = mt;
            i = i + 1;
        }
        ret types.type_struct(e.tt, ?members[0], n, false);
    }
    ret 0;
}

# the SPIR-V type of a type id belonging to the member currently being read
# ---
# e:  the emission state
# id: the IR type id, in `e.ir`'s table
# ret: the SPIR-V type id, or 0
fun ir_value_spv_type(e: *Emit, id: type.IrTypeId) u32 {
    ret spv_type_of(e, ?e.ir.types, id);
}

# the SPIR-V type of a type id belonging to the ROOT module - a global's
# ---
# e:  the emission state
# id: the IR type id, in the root's table
# ret: the SPIR-V type id, or 0
fun global_spv_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) u32 {
    ret spv_type_of(e, gt, id);
}

# the SPIR-V type an IR image handle names, declaring it on first use (#2794)
#
# EVERY OPERAND IS CARRIED ACROSS, none derived: the IR type holds the sampled
# scalar, dimensionality, depth, arrayedness and multisampledness that `image_form`
# read from the spelling, and each becomes the `OpTypeImage` operand of the same
# name. That is what keeps a second dimensionality or an arrayed image a row rather
# than a second lowering path - and what keeps a defaulted operand from producing a
# module a validator accepts, describing a different image than the one declared.
#
# A bare sampler has no image behind it and is answered first; a combined handle is
# the sampled-image wrapper over the image the same operands describe.
# ---
# e: the emission state
# t: the IRT_IMAGE type
# ret: the SPIR-V type id, or 0 when the sampled scalar has no SPIR-V form
fun image_spv_type(e: *Emit, t: *type.IrType) u32 {
    if (t.data.image_.form == semtype.IMG_FORM_SAMPLER) { ret types.type_sampler(e.tt); }

    # `isampler2d` and `usampler2d` share one SPIR-V image type, and that is forced
    # rather than sloppy: this emitter's integers are sign-less throughout, because
    # SPIR-V puts signedness on the operation rather than on the type. A sample's
    # result type must have the same component type as the image's sampled type, so
    # minting a signed `OpTypeInt 32 1` here would disagree with the sign-less vector
    # every integer result is typed at, and every integer sample would fail
    # validation. The two spellings stay distinct mach types - which is what decides
    # the result type a program declares - and agree on the descriptor.
    var sampled: u32 = types.type_float(e.tt, 32);
    if (t.data.image_.sampled == semtype.TYPE_I32 || t.data.image_.sampled == semtype.TYPE_U32) {
        sampled = types.type_int(e.tt, 32);
    }

    var depth: u32 = 0;
    if (t.data.image_.depth) { depth = 1; }
    var arrayed: u32 = 0;
    if (t.data.image_.arrayed) { arrayed = 1; }
    var ms: u32 = 0;
    if (t.data.image_.ms) { ms = 1; }

    val img: u32 = types.type_image(e.tt, sampled, image_dim_operand(t.data.image_.dim),
                                    depth, arrayed, ms, spirv.IMAGE_SAMPLED_YES);
    if (img == 0) { ret 0; }
    if (t.data.image_.form == semtype.IMG_FORM_SAMPLED) { ret types.type_sampled_image(e.tt, img); }
    ret img;
}

# the SPIR-V `Dim` operand a mach dimensionality ordinal names
#
# The ONE place the two numberings meet, and it lives here rather than in either
# leaf: `type.IMG_DIM_*` is the front end's, so a dimensionality can be spelled and
# refused without the front end depending on a back end, and the spec numbers are
# `spirv`'s. Adding a dimensionality is a row here.
# ---
# dim: the mach ordinal (a `semtype.ImageDim`)
# ret: the SPIR-V Dim operand
fun image_dim_operand(dim: u8) u32 {
    if      (dim == semtype.IMG_DIM_1D)      { ret spirv.DIM_1D; }
    or (dim == semtype.IMG_DIM_3D)           { ret spirv.DIM_3D; }
    or (dim == semtype.IMG_DIM_CUBE)         { ret spirv.DIM_CUBE; }
    or (dim == semtype.IMG_DIM_RECT)         { ret spirv.DIM_RECT; }
    or (dim == semtype.IMG_DIM_BUFFER)       { ret spirv.DIM_BUFFER; }
    or (dim == semtype.IMG_DIM_SUBPASS)      { ret spirv.DIM_SUBPASS_DATA; }
    ret spirv.DIM_2D;
}

# the SPIR-V return type of an IR function: void, or a scalar; 0 when unsupported
#
# Also reports whether the return is void, which the terminator needs to choose
# OpReturn over OpReturnValue.
# ---
# e:        the emission state
# irfn:     the IR function
# out_void: receives whether the return type is void
# ret:      the SPIR-V type id, or 0
fun ir_return_spv_type(e: *Emit, irfn: *ir.Function, out_void: *bool) u32 {
    @out_void = false;
    val sig_opt: O.Option[*type.IrType] = type.get(?e.ir.types, irfn.sig);
    if (O.is_none[*type.IrType](sig_opt)) { ret 0; }
    val sig: *type.IrType = O.unwrap[*type.IrType](sig_opt);
    if (sig.kind != type.IRT_FN) { ret 0; }
    val rt: type.IrTypeId = sig.data.fn.ret_type;
    val rt_opt: O.Option[*type.IrType] = type.get(?e.ir.types, rt);
    if (O.is_none[*type.IrType](rt_opt)) { ret 0; }
    val rtt: *type.IrType = O.unwrap[*type.IrType](rt_opt);
    if (rtt.kind == type.IRT_VOID) { @out_void = true; ret types.type_void(e.tt); }
    ret ir_value_spv_type(e, rt);
}

# no function in the emission unit carries the requested name
#
# The same sentinel `unit` uses, and deliberately the same value: `mir_index`
# reports absence with it and this table stores that answer verbatim.
val FN_NONE: u32 = unit.UNIT_NONE;

# no global in the emission unit carries the requested name
val GL_NONE: u32 = unit.UNIT_NONE;

# the diagnostic for a value type the emitter cannot map, naming the mach type
#
# A LANE COUNT IS NO LONGER ONE OF THESE (#2749). A vector of more lanes than a
# Shader module's `OpTypeVector` takes used to be refused here by name; it is now
# realized as an array of its lanes with per-lane scalar operators, because #2488
# makes the type legal on every target and leaves only the realization to vary. What
# is left is a lane ELEMENT type the emitter has no scalar form for.
# ---
# e:   the emission state
# mi:  the instruction whose result type failed to map
# ret: the diagnostic text
fun unsupported_value_type(e: *Emit, mi: *mir.MirInstr) str {
    if (!mir.vec_lane_is_vector(mi.vec_lane)) {
        ret "unsupported value type in the SPIR-V target";
    }
    ret "unsupported vector lane type in the SPIR-V target";
}

# the interface variable an address operand names WHOLE, or 0 otherwise
#
# Only a direct symbol reference with no member displacement resolves: that is the
# one shape SPIR-V can name outright, as an OpLoad or OpStore on the variable's id.
# A displacement means a member walk and a register base means an address was
# computed, and neither is something this milestone carries.
# ---
# e:   the emission state
# op:  the address operand
# ret: the OpVariable id, or 0
fun interface_target(e: *Emit, op: *mir.MirOperand) u32 {
    if (op.kind != mir.MIR_OP_SYM || op.sym_off != 0) { ret 0; }
    ret global_var_id(e, op.sym);
}

# the diagnostic for an addressed access the milestone cannot carry, named by what
# the address actually originates in
#
# Each lowering that lands here is fixed somewhere different, so each says so, and
# reporting one under another's name sends a reader to the wrong problem - which is
# what the first version of this did, twice.
#
# A member walk no longer arrives at all: MIR keeps the GEP's index list on this
# target (#2649) and the emitter builds an `OpAccessChain` from it, so reading and
# writing a block member is supported. What is left here is a whole-AGGREGATE copy,
# which lowers to a byte copy rather than a value load or store, and addressed
# memory with no interface variable behind it.
#
# A scalar `f32` / `f64` interface variable used to have an arm here, because the
# float address materialization was applied on every target and destroyed the
# direct symbol reference. #2655 gated that on `MachineModel.flat_addressing`, so
# those shapes reach the whole-variable path and never arrive here at all.
#
# EVERY ORIGIN GETS ITS OWN ARM, including the two that are not globals (#2744). A
# local slot reported under the module-scope sentence contradicts the program it is
# reported against - the author declared no module-scope variable at all - and that
# is exactly what a sub-width vector's scratch round trip and a default-zeroed
# sub-width local both produced, sending two readers to a role they had already
# written. A refusal that misdirects is worse than one that says only "unsupported".
# ---
# e:   the emission state
# mf:  the MIR function
# op:  the address operand
# ret: the diagnostic text
fun addressed_memory_refusal(e: *Emit, mf: *mir.MirFunction, op: *mir.MirOperand) str {
    var gix: u32 = 0;
    val origin: u8 = address_origin(e, mf, op, ?gix);
    if (origin == ADDR_ALLOCA) {
        ret "a function-local object is reachable from the SPIR-V target only as a whole value: this access arrived as an address into its storage rather than as a load or a store of the object itself, which logical addressing has no pointer to express. it is a lowering that ran where it should not have, not something the program asked for";
    }
    if (origin != ADDR_GLOBAL) {
        ret "addressed memory is not yet supported by the SPIR-V target: this access reached the back end as a computed address with no object behind it that the emitter can name, and logical addressing has no general pointer to follow";
    }
    val g: *ir.Global = gl_ir(e, gix);
    if (g.iface == ir.IFACE_NONE) {
        ret "a plain module-scope variable is not reachable from the SPIR-V target: a shader has no general global storage, so a module-scope `val` / `var` reaches a stage only by carrying an interface role (`#[input]`, `#[output]`, `#[builtin]`, or `#[uniform]`)";
    }
    if (is_aggregate_type(e, gl_types(e, gix), g.ty)) {
        ret "copying a whole record or array to or from a shader interface variable is not supported by the SPIR-V target: an aggregate assignment lowers to a byte copy, which addresses the object rather than loading or storing a value of it. reading and writing its MEMBERS individually is supported, and is what a shader wants anyway - a whole-block copy would move the descriptor's contents rather than the values in it";
    }
    val r: R.Result[str, str] = format.sprint(e.alloc,
        "this shader interface variable carries a role and is not an aggregate, so it is reachable - but the access reached the back end as COMPUTED ADDRESSING rather than as a direct reference to the variable, which is the one shape the SPIR-V target can name. that is a lowering that ran where it should not have, not a limit of the declaration: the variable is {}",
        ir_type_spelling(gl_types(e, gix), e.alloc, g.ty));
    if (R.is_err[str, str](r)) {
        ret "this shader interface variable is reachable only as a whole-variable read or write in the SPIR-V target";
    }
    ret R.unwrap_ok[str, str](r);
}

# whether an IR type is an opaque image / sampler handle (#2794)
# ---
# e:   the emission state
# id:  the IR type id
# ret: true for an IRT_IMAGE
fun is_image_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) bool {
    val opt: O.Option[*type.IrType] = type.get(gt, id);
    if (O.is_none[*type.IrType](opt)) { ret false; }
    ret O.unwrap[*type.IrType](opt).kind == type.IRT_IMAGE;
}

# whether an IR type is an aggregate reached by indexing
# ---
# e:   the emission state
# id:  the IR type id
# ret: true for an array or a struct
fun is_aggregate_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) bool {
    val opt: O.Option[*type.IrType] = type.get(gt, id);
    if (O.is_none[*type.IrType](opt)) { ret false; }
    val k: type.IrTypeKind = O.unwrap[*type.IrType](opt).kind;
    ret k == type.IRT_ARRAY || k == type.IRT_STRUCT;
}

# emit an OpLoad of a shader interface variable
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:       the MIR_LOAD instruction ([dst, address])
# ret:      true on success, or a precise error string
fun emit_global_load(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[bool, str] {
    if (mi.operand_count != 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0]));
    }
    var chain_ty: u32 = 0;
    var var_id: u32 = chain_target(vm, ?mi.operands[1], ?chain_ty);
    if (var_id == 0) { var_id = interface_target(e, ?mi.operands[1]); }
    if (var_id == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1])); }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n || vm.type_id[dst] == 0) {
        ret R.err[bool, str]("spirv.emit: interface load result vreg has no type");
    }
    # loading an opaque handle emits NOTHING HERE (#2794): the descriptor variable
    # is recorded on the vreg and each use re-loads from it, which puts the load in
    # the block that consumes the value rather than in whichever block the mach
    # source happened to name the binding in. A chain result cannot be a handle -
    # a handle has no members - so only the whole-variable case can arrive.
    if (types.type_is_opaque(e.tt, vm.type_id[dst])) {
        if (chain_ty != 0) {
            ret unsupported(e, "an image handle reached through a member walk is not supported by the SPIR-V target: a handle has no members, so this is an access chain into something that is not an aggregate");
        }
        vm.opq_var[dst] = var_id;
        ret R.ok[bool, str](true);
    }
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [3]u32;
    ops[0] = vm.type_id[dst]; ops[1] = result; ops[2] = var_id;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_LOAD, ?ops[0], 3);
    ret store_vreg(e, vm, dst, result);
}

# emit an OpStore into a shader interface variable
#
# The stored value is typed by the VARIABLE, not by the store's width: the ABI
# emits a move at the machine word, and an immediate stored into an f32x4 output
# has to be minted at the output's type or the module is ill-typed.
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:       the MIR_STORE instruction ([address, value])
# ret:      true on success, or a precise error string
fun emit_global_store(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[bool, str] {
    if (mi.operand_count != 2) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0])); }
    var chain_ty: u32 = 0;
    var var_id: u32 = chain_target(vm, ?mi.operands[0], ?chain_ty);
    var value_ty: u32 = chain_ty;
    if (var_id == 0) {
        var_id = interface_target(e, ?mi.operands[0]);
        value_ty = interface_value_type(e, ?mi.operands[0]);
    }
    if (var_id == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0])); }
    val value: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], value_ty);
    if (e.b.err || value == 0) { ret R.err[bool, str]("spirv.emit: unreadable value in an interface store"); }
    var ops: [2]u32;
    ops[0] = var_id; ops[1] = value;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_STORE, ?ops[0], 2);
    ret R.ok[bool, str](true);
}

# the SPIR-V type of the value an interface variable holds, or 0 when the operand
# does not name one
# ---
# e:   the emission state
# op:  the address operand
# ret: the value type id, or 0
fun interface_value_type(e: *Emit, op: *mir.MirOperand) u32 {
    if (op.kind != mir.MIR_OP_SYM) { ret 0; }
    val gx: u32 = gl_lookup(e, op.sym);
    if (gx == GL_NONE) { ret 0; }
    val g: *ir.Global = gl_ir(e, gx);
    if (g.iface == ir.IFACE_NONE) { ret 0; }
    ret global_spv_type(e, gl_types(e, gx), g.ty);
}

# emit an OpAccessChain for a structural GEP into a shader interface variable
#
# MIR now keeps a GEP's index list on this target rather than folding it to a byte
# displacement, which is what makes this expressible at all: SPIR-V reaches a member
# by its ORDINAL and an offset does not determine one.
#
# THE LEADING INDEX IS DROPPED, and that is not a detail. A getelementptr's first
# index strides over the source pointee type without descending into it - `gep %p, 0,
# 1` is "the 0th object, then member 1" - while an OpAccessChain's base pointer
# already names the object, so it takes only the descending indices. A NONZERO
# leading index is pointer arithmetic across whole objects, which the logical model
# has no form for; it is refused rather than dropped, because dropping it would
# silently read the wrong object.
#
# The result is a pointer, recorded on the destination vreg rather than stored into
# a backing variable, and the load or store that consumes it addresses through it.
# ---
# e:        the emission state
# mf:       the MIR function
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:       the MIR_GEP instruction ([dst, base, idx...])
# ret:      true on success, or a precise error string
fun emit_access_chain(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, preg_val: *Regs,
                      mi: *mir.MirInstr) R.Result[bool, str] {
    # a two-operand GEP is the FLAT form, an address materialization with no index
    # list; nothing on this target should produce one.
    if (mi.operand_count < 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1]));
    }
    # the base is either the interface variable itself or a chain already built off
    # it: `m.mvp[2]` lowers to two GEPs, the second based on the first's result, and
    # an OpAccessChain's base may be any pointer.
    var base_id: u32 = 0;
    var base_ty: u32 = 0;
    var base_sc: u32 = 0;
    var prior_ty: u32 = 0;
    val prior: u32 = chain_target(vm, ?mi.operands[1], ?prior_ty);
    if (prior != 0) {
        base_id = prior;
        base_ty = prior_ty;
        base_sc = chain_storage(vm, ?mi.operands[1]);
    }
    or {
        var gix: u32 = 0;
        if (address_origin(e, mf, ?mi.operands[1], ?gix) != ADDR_GLOBAL) {
            ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1]));
        }
        val g: *ir.Global = gl_ir(e, gix);
        if (g.iface == ir.IFACE_NONE || e.gvar_ids[gix] == 0) {
            ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1]));
        }
        base_id = e.gvar_ids[gix];
        base_ty = e.gtype_ids[gix];
        base_sc = e.gstorage[gix];
    }

    # index 0 strides over whole objects; only 0 names this one.
    if (mi.operands[2].kind != mir.MIR_OP_IMM || mi.operands[2].imm != 0) {
        ret unsupported(e, "pointer arithmetic across whole objects is not supported by the SPIR-V target: a logical pointer names one object, so a getelementptr's leading index may only be 0");
    }

    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret R.err[bool, str]("spirv.emit: access chain result vreg out of range"); }

    val count: u32 = mi.operand_count - 3;
    if (count == 0 || count > 8) {
        ret unsupported(e, "an access chain of more than 8 levels is not supported by the SPIR-V target");
    }

    var idx: [8]u32;
    var cur: u32 = base_ty;
    var k: u32 = 0;
    for (k < count) {
        val opnd: *mir.MirOperand = ?mi.operands[3 + k];
        if (opnd.kind == mir.MIR_OP_IMM) {
            if (opnd.imm < 0) { ret unsupported(e, "a negative index is not supported by the SPIR-V target"); }
            cur = types.composite_member(e.tt, cur, opnd.imm::u32);
            idx[k] = types.const_int(e.tt, 32, opnd.imm);
        }
        or {
            # a runtime index is legal into an array, whose element type does not
            # depend on it, and never into a struct, whose member type does.
            val elem: u32 = types.composite_member(e.tt, cur, 0);
            var lanes: u32 = 0;
            if (elem == 0 || types.vector_shape(e.tt, cur, ?lanes) != 0) {
                ret unsupported(e, "a runtime index into a record or vector is not supported by the SPIR-V target: SPIR-V takes a struct member and a vector lane by a constant ordinal, since the type reached depends on which one it is");
            }
            idx[k] = read_operand(e, vm, preg_val, opnd, types.type_int(e.tt, 32));
            cur = elem;
        }
        if (cur == 0 || idx[k] == 0) {
            ret unsupported(e, "an index reaches past the end of its aggregate in the SPIR-V target");
        }
        k = k + 1;
    }
    if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable index in an access chain"); }

    val ptr_ty: u32 = types.type_ptr(e.tt, base_sc, cur);
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [11]u32;
    ops[0] = ptr_ty; ops[1] = result; ops[2] = base_id;
    k = 0;
    for (k < count) { ops[3 + k] = idx[k]; k = k + 1; }
    spirv.inst(e.b, ?e.b.functions, spirv.OP_ACCESS_CHAIN, ?ops[0], count + 3);

    vm.chain_id[dst] = result;
    vm.chain_ty[dst] = cur;
    vm.chain_sc[dst] = base_sc;
    ret R.ok[bool, str](true);
}

# the access chain an address operand resolves to, or 0 when it is not one
# ---
# vm:      the per-vreg value maps
# op:      the address operand
# out_ty:  receives the type the chain points at
# ret:     the pointer id, or 0
fun chain_target(vm: *VMaps, op: *mir.MirOperand, out_ty: *u32) u32 {
    @out_ty = 0;
    var v: u32 = mir.MIR_VREG_NIL;
    if (op.kind == mir.MIR_OP_VREG) { v = op.vreg; }
    or (op.kind == mir.MIR_OP_MEM && op.imm == 0) { v = op.vreg; }
    if (v == mir.MIR_VREG_NIL || v >= vm.n) { ret 0; }
    @out_ty = vm.chain_ty[v];
    ret vm.chain_id[v];
}

# the storage class of the access chain an address operand resolves to
# ---
# vm: the per-vreg value maps
# op: the address operand
# ret: the storage class, or 0
fun chain_storage(vm: *VMaps, op: *mir.MirOperand) u32 {
    var v: u32 = mir.MIR_VREG_NIL;
    if (op.kind == mir.MIR_OP_VREG) { v = op.vreg; }
    or (op.kind == mir.MIR_OP_MEM && op.imm == 0) { v = op.vreg; }
    if (v == mir.MIR_VREG_NIL || v >= vm.n) { ret 0; }
    ret vm.chain_sc[v];
}

# emit the zeroing of a whole object as a single store of its null value
#
# `MIR_MEMZERO` survives to this target as a whole-object operation (#2669) rather
# than being expanded into a run of sized byte stores, which is what makes this one
# instruction. `OpConstantNull` spells the zero of any type, so an aggregate needs
# no member-by-member construction.
# ---
# e:   the emission state
# mf:  the MIR function
# vm:  the per-vreg value maps
# mi:  the MIR_MEMZERO instruction ([dst_mem, size])
# ret: true on success, or a precise error string
fun emit_memzero(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr) R.Result[bool, str] {
    if (mi.operand_count < 1) { ret R.err[bool, str]("spirv.emit: memzero with no destination"); }
    var target_ty: u32 = 0;
    var target: u32 = chain_target(vm, ?mi.operands[0], ?target_ty);
    if (target == 0) {
        target = interface_target(e, ?mi.operands[0]);
        target_ty = interface_value_type(e, ?mi.operands[0]);
    }
    if (target == 0 || target_ty == 0) {
        ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0]));
    }
    var ops: [2]u32;
    ops[0] = target; ops[1] = types.const_null(e.tt, target_ty);
    spirv.inst(e.b, ?e.b.functions, spirv.OP_STORE, ?ops[0], 2);
    ret R.ok[bool, str](true);
}

# select the integer or float form of a class-polymorphic opcode
# ---
# lane_float: whether the operation's lanes are float
# int_op:     the integer form
# float_op:   the float form
# ret:        the selected SPIR-V opcode
fun by_class(lane_float: bool, int_op: u32, float_op: u32) u32 {
    if (lane_float) { ret float_op; }
    ret int_op;
}

# raise a precise unsupported-feature diagnostic, located
#
# The backend's own sentence is composed with the opcode, the enclosing function
# and the source position through the shared `mir.instr_refusal`, so a refusal
# says WHICH instruction it is about. Before #2656 every one of these read
# identically no matter what was at fault, which made localizing a bisection.
#
# The three context values are read off `Emit` rather than threaded through the
# thirty call sites: a refusal names whatever the emitter was working on, and the
# stamps are the only thing that has to be right.
# ---
# e:   the emission state, carrying the function / instruction being emitted
# msg: the feature description
# ret: an err result carrying the located message
fun unsupported(e: *Emit, msg: str) R.Result[bool, str] {
    ret R.err[bool, str](mir.instr_refusal(e.alloc, e.srcmap, refusal_fn_name(e),
                                           e.cur_instr, msg));
}

# what to call the function currently being emitted
#
# The MIR function carries only the mangled link name, which is unambiguous but
# reads badly and does not match the source. The IR function beside it carries the
# bare source name, so prefer that and fall back through the mangled name to a
# stand-in, since this is only ever read by a diagnostic.
#
# Resolved through the unit table, so a refusal raised inside a body drawn in from
# another module says which module that is - otherwise the message points at a
# name the reader cannot find in the file they are compiling.
fun refusal_fn_name(e: *Emit) str {
    if (e.cur_fn == nil) { ret "<unknown function>"; }
    val fx: u32 = fn_lookup(e, e.cur_fn.name);
    if (fx != FN_NONE) { ret ir_fn_spelling(e, fx); }
    val m: O.Option[str] = intern.lookup(e.interner, e.cur_fn.name);
    if (O.is_some[str](m)) { ret O.unwrap[str](m); }
    ret "<unresolved function name>";
}

# translate one MIR instruction into SPIR-V, using the value-variable model
# ---
# e:            the emission state
# mf:           the MIR function
# vm:           the per-vreg value maps
# preg_val:     the identity convention's nominal register file (16 wide)
# returns_void: whether the function returns void
# ret_bits:     the integer return width in bits
# mi:           the instruction to translate
# ret:          true on success, or a precise error string
fun emit_instr(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[bool, str] {
    e.cur_instr = mi;
    val op: mir.MirOpcode = mi.opcode;

    # a VECTOR operation rides the integer-spelled shared opcode whatever its lanes
    # hold: a vector is IRT_VECTOR rather than IRT_FLOAT, so the scalar float
    # dispatch that would have produced MIR_FADD never fires for one, and the lane
    # class survives only in `vec_lane`. Read it here and let the arithmetic family
    # pick its class from it. On a scalar the opcode already says which class it is
    # and this reads false, leaving the integer forms selected as before.
    val lf: bool = mir.vec_lane_is_vector(mi.vec_lane)
                && mir.vec_lane_kind(mi.vec_lane) == mir.VEC_LANE_FLOAT;

    # binary arithmetic / bitwise / shift: dst = a <op> b.
    if (op == mir.MIR_ADD)   { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_I_ADD, spirv.OP_F_ADD)); }
    if (op == mir.MIR_SUB)   { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_I_SUB, spirv.OP_F_SUB)); }
    if (op == mir.MIR_MUL)   { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_I_MUL, spirv.OP_F_MUL)); }
    if (op == mir.MIR_DIV_S) { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_S_DIV, spirv.OP_F_DIV)); }
    if (op == mir.MIR_DIV_U) { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_U_DIV, spirv.OP_F_DIV)); }
    if (op == mir.MIR_REM_S) { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_S_REM, spirv.OP_F_REM)); }
    if (op == mir.MIR_REM_U) { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_U_MOD, spirv.OP_F_REM)); }
    if (op == mir.MIR_AND)   { ret emit_binary(e, vm, preg_val, mi, spirv.OP_BITWISE_AND); }
    if (op == mir.MIR_OR)    { ret emit_binary(e, vm, preg_val, mi, spirv.OP_BITWISE_OR); }
    if (op == mir.MIR_XOR)   { ret emit_binary(e, vm, preg_val, mi, spirv.OP_BITWISE_XOR); }
    if (op == mir.MIR_SHL)   { ret emit_binary(e, vm, preg_val, mi, spirv.OP_SHIFT_LEFT_LOGICAL); }
    if (op == mir.MIR_SHR_U) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_SHIFT_RIGHT_LOGICAL); }
    if (op == mir.MIR_SHR_S) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_SHIFT_RIGHT_ARITHMETIC); }

    # the dedicated scalar float opcodes MIR lowering emits instead of the shared
    # integer forms, so the class is already settled here.
    if (op == mir.MIR_FADD) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_F_ADD); }
    if (op == mir.MIR_FSUB) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_F_SUB); }
    if (op == mir.MIR_FMUL) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_F_MUL); }
    if (op == mir.MIR_FDIV) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_F_DIV); }

    # unary: dst = <op> a.
    if (op == mir.MIR_NEG)  { ret emit_unary(e, vm, preg_val, mi, by_class(lf, spirv.OP_S_NEGATE, spirv.OP_F_NEGATE)); }
    if (op == mir.MIR_NOT)  { ret emit_unary(e, vm, preg_val, mi, spirv.OP_NOT); }
    if (op == mir.MIR_FNEG) { ret emit_unary(e, vm, preg_val, mi, spirv.OP_F_NEGATE); }

    # comparisons. the shared integer-spelled opcodes carry a float VECTOR compare
    # too, so each picks its class the same way the arithmetic family does.
    if (op == mir.MIR_CMP_EQ)   { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_I_EQUAL, spirv.OP_F_ORD_EQUAL)); }
    if (op == mir.MIR_CMP_NE)   { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_I_NOT_EQUAL, spirv.OP_F_UNORD_NOT_EQUAL)); }
    if (op == mir.MIR_CMP_LT_S) { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_S_LESS_THAN, spirv.OP_F_ORD_LESS_THAN)); }
    if (op == mir.MIR_CMP_LT_U) { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_U_LESS_THAN, spirv.OP_F_ORD_LESS_THAN)); }
    if (op == mir.MIR_CMP_LE_S) { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_S_LESS_THAN_EQUAL, spirv.OP_F_ORD_LESS_THAN_EQUAL)); }
    if (op == mir.MIR_CMP_LE_U) { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_U_LESS_THAN_EQUAL, spirv.OP_F_ORD_LESS_THAN_EQUAL)); }

    # float comparison: one MIR opcode carrying its relation as a condition code.
    if (op == mir.MIR_FCMP) { ret emit_float_compare(e, vm, preg_val, mi); }

    # vector lane access. these reach the emitter only because the SPIR-V target
    # declares native lane ops; the alternative lowering rewrites them to the
    # vector's memory image, which logical addressing cannot express.
    if (op == mir.MIR_VEC_EXTRACT) { ret emit_vec_extract(e, vm, preg_val, mi); }
    if (op == mir.MIR_VEC_INSERT)  { ret emit_vec_insert(e, vm, preg_val, mi); }
    if (op == mir.MIR_VEC_BUILD)   { ret emit_vec_build(e, vm, preg_val, mi); }

    # integer width conversions: dst = convert(a), the source read as an integer.
    if (op == mir.MIR_TRUNC) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_U_CONVERT, false); }
    if (op == mir.MIR_ZEXT)  { ret emit_convert(e, vm, preg_val, mi, spirv.OP_U_CONVERT, false); }
    if (op == mir.MIR_SEXT)  { ret emit_convert(e, vm, preg_val, mi, spirv.OP_S_CONVERT, false); }

    # float conversions. the source class is fixed by the opcode, which is what
    # says how to read an immediate operand's bits; the destination class comes
    # from the result type as usual.
    if (op == mir.MIR_FP_TRUNC) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_F_CONVERT, true); }
    if (op == mir.MIR_FP_EXT)   { ret emit_convert(e, vm, preg_val, mi, spirv.OP_F_CONVERT, true); }
    if (op == mir.MIR_FP_TO_SI) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_CONVERT_F_TO_S, true); }
    if (op == mir.MIR_FP_TO_UI) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_CONVERT_F_TO_U, true); }
    if (op == mir.MIR_SI_TO_FP) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_CONVERT_S_TO_F, false); }
    if (op == mir.MIR_UI_TO_FP) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_CONVERT_U_TO_F, false); }

    # a `:~` bit reinterpret. the operand keeps its bits and takes the result type,
    # which is exactly OpBitcast; an immediate source is already the pattern, so it
    # is read at the source width in the integer class.
    if (op == mir.MIR_BITCAST) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_BITCAST, false); }

    if (op == mir.MIR_MOV) { ret emit_mov(e, vm, preg_val, mi); }
    # a `:^` declassify is a register copy plus a compile-time taint barrier; SPIR-V is
    # not rule-based (no isel retag), so its emitter handles MIR_DECLASSIFY directly as
    # the same value copy as MIR_MOV - identical runtime semantics (#1646).
    if (op == mir.MIR_DECLASSIFY) { ret emit_mov(e, vm, preg_val, mi); }

    if (op == mir.MIR_CALL) { ret emit_call(e, preg_val, mi); }
    # the liveness marker pairing the call with its result move: nothing to emit.
    if (op == mir.MIR_CALL_RES) { ret R.ok[bool, str](true); }

    # a whole-variable read or write of a shader interface variable. This is the ONLY
    # addressed memory the milestone supports, and it is supported because it is not
    # really addressing: an interface variable is named directly, so the access is an
    # OpLoad or OpStore on the variable's id with no address computed at all.
    if (op == mir.MIR_LOAD)  { ret emit_global_load(e, mf, vm, preg_val, mi); }
    if (op == mir.MIR_STORE) { ret emit_global_store(e, mf, vm, preg_val, mi); }
    # a GEP that survives to here computed an address, which the milestone carries
    # in no form; the refusal names what the address originates in.
    if (op == mir.MIR_GEP) { ret emit_access_chain(e, mf, vm, preg_val, mi); }
    # the allocation's variable was declared at the entry, where SPIR-V requires it.
    if (op == mir.MIR_ALLOCA) { ret R.ok[bool, str](true); }
    if (op == mir.MIR_MEMZERO) { ret emit_memzero(e, mf, vm, mi); }

    ret unsupported(e, "instruction is not yet supported by the SPIR-V target");
}

# emit an OpFunctionCall for a lowered direct call
#
# The identity convention put argument `i` in register `i`, so the argument list is
# the register map's prefix, as wide as the callee's declared parameter count. The
# result goes back into register 0, where the pre-coloring move that follows the
# call reads it.
#
# A CALL ACROSS A MODULE BOUNDARY IS NOT A SEPARATE CASE (#2823). The callee is
# resolved in the unit's function table, which spans every module the emitter was
# given, and the body it names was emitted into this same output. What is left to
# refuse is what genuinely has no SPIR-V form, and each says which one it is: a
# call through a value (there is no function pointer), a call to a foreign `ext`
# import (a self-contained module has nothing to bind it to at load time), and a
# call to a mach function this build did not put in front of the emitter.
#
# THE CALLEE'S DECLARATION IS READ AGAINST ITS OWN MODULE. `param_count` and every
# type id in the signature belong to the DEFINING module's tables; the referencing
# module carries only a signature-only shadow whose parameter list is empty. So
# the state's current member is swapped to the callee's for the length of the
# signature read and restored after - the call is emitted into the caller's body,
# but it is typed by the callee's declaration.
# ---
# e:        the emission state
# preg_val: the identity convention's nominal register file
# mi:       the MIR_CALL instruction (operand 0 is the callee)
# ret:      true on success, or a precise error string
fun emit_call(e: *Emit, preg_val: *Regs, mi: *mir.MirInstr) R.Result[bool, str] {
    if (mi.operand_count < 1) { ret R.err[bool, str]("spirv.emit: call with no callee operand"); }
    val callee: *mir.MirOperand = ?mi.operands[0];
    if (callee.kind != mir.MIR_OP_SYM) {
        ret unsupported(e, "a call through a function pointer is not yet supported by the SPIR-V target");
    }

    # a callee carrying `#[spirv_op(set, name)]` is not called at all: it IS one
    # instruction, and this call site becomes that instruction. Checked before the
    # table lookup below, because such a callee's BODY is never emitted anywhere -
    # it is written in the bit manipulation a CPU needs, which logical addressing
    # refuses - so its declaration in the calling module is the whole answer.
    val xfn: *ir.Function = ir_function_record(e.ir, callee.sym);
    if (xfn != nil && xfn.op_set != defs.SPV_SET_NONE) {
        ret emit_spirv_op(e, preg_val, xfn);
    }
    if (xfn != nil && xfn.is_import) {
        ret unsupported(e, foreign_call_refusal(e, xfn));
    }

    val fx: u32 = fn_lookup(e, callee.sym);
    if (fx == FN_NONE || e.fns[fx].id == 0) {
        ret unsupported(e, unresolved_call_refusal(e, callee.sym, fx));
    }

    val saved_ir: *ir.Module = e.ir;
    val saved_mi: u32 = e.cur_mi;
    e.ir = fn_mod(e, fx);
    e.cur_mi = e.fns[fx].mi;
    val irfn: *ir.Function = fn_ir(e, fx);

    var returns_void: bool = false;
    val ret_ty: u32 = ir_return_spv_type(e, irfn, ?returns_void);
    if (ret_ty == 0) {
        e.ir = saved_ir; e.cur_mi = saved_mi;
        ret unsupported(e, "unsupported return type in the SPIR-V target");
    }
    if (irfn.param_count > 16) {
        e.ir = saved_ir; e.cur_mi = saved_mi;
        ret unsupported(e, "more than 16 parameters is not supported by the SPIR-V target");
    }

    # the argument types come from the callee's declaration and so are minted while
    # its module is still in scope; the values themselves are the caller's.
    var argty: [16]u32;
    var i: u32 = 0;
    for (i < irfn.param_count) {
        argty[i] = ir_value_spv_type(e, irfn.params[i].ty);
        i = i + 1;
    }
    val param_count: u32 = irfn.param_count;
    e.ir = saved_ir;
    e.cur_mi = saved_mi;

    val total: u32 = 3 + param_count;
    var ops: [19]u32;
    ops[0] = ret_ty;
    val result: u32 = spirv.alloc_id(e.b);
    ops[1] = result;
    ops[2] = e.fns[fx].id;
    i = 0;
    for (i < param_count) {
        val aid: u32 = reg_value(e, preg_val, i, argty[i]);
        if (aid == 0) { ret R.err[bool, str]("spirv.emit: call argument with no pre-colored value"); }
        ops[3 + i] = aid;
        i = i + 1;
    }
    spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION_CALL, ?ops[0], total);
    # the return register, which the result move reads next.
    if (!returns_void) {
        preg_val.val_id[0] = result;
        preg_val.is_imm[0] = false;
    }
    ret R.ok[bool, str](true);
}

# the diagnostic for a call to a foreign (`ext fun`) import
#
# Distinct from the cross-module message on purpose: a mach function in another
# module is now emitted into this output, but no mach module defines a foreign
# symbol, so there is nothing to draw in and never will be. The fix is a different
# one too - declare the operation as a `#[spirv_op(...)]` instruction, or write it
# in mach - so reusing one message for both would send the reader the wrong way.
# ---
# e:  the emission state
# fn: the callee's declaration
# ret: the composed diagnostic
fun foreign_call_refusal(e: *Emit, fn: *ir.Function) str {
    val nm: O.Option[str] = intern.lookup(e.interner, fn.name);
    var who: str = "this function";
    if (O.is_some[str](nm)) { who = O.unwrap[str](nm); }
    val r: R.Result[str, str] = format.sprint(e.alloc,
        "`{}` is declared `ext`, and a SPIR-V module cannot call a foreign import: the module a shader compiles to is self-contained, so there is no symbol to bind at load time. give the operation a `#[spirv_op(set, name)]` mapping so the call becomes that instruction, or write it in mach so its body can be emitted here",
        who);
    if (R.is_err[str, str](r)) {
        ret "a SPIR-V module cannot call a foreign `ext` import: the module is self-contained and has no symbol to bind at load time";
    }
    ret R.unwrap_ok[str, str](r);
}

# the diagnostic for a callee the emission unit does not carry a body for
#
# This is what is LEFT of the old blanket "defined outside the module" refusal
# once cross-module calls work: either the build did not put the defining module
# in front of the emitter, or it did and that module declares the function without
# defining it. Both are build-shape problems rather than language ones, so the
# message says which module the emitter did look in.
# ---
# e:    the emission state
# name: the callee's link name
# fx:   its table index, or FN_NONE when the unit has no definition at all
# ret:  the composed diagnostic
fun unresolved_call_refusal(e: *Emit, name: intern.StrId, fx: u32) str {
    val nm: O.Option[str] = intern.lookup(e.interner, name);
    var who: str = "this function";
    if (O.is_some[str](nm)) { who = O.unwrap[str](nm); }
    if (fx != FN_NONE) {
        var where: str = "the module it belongs to";
        val mo: O.Option[str] = intern.lookup(e.interner, fn_mod(e, fx).name);
        if (O.is_some[str](mo)) { where = O.unwrap[str](mo); }
        val r2: R.Result[str, str] = format.sprint(e.alloc,
            "`{}` is declared in `{}` but has no body the SPIR-V target can emit, so there is nothing to call: a self-contained module cannot leave the call for a linker to resolve",
            who, where);
        if (R.is_ok[str, str](r2)) { ret R.unwrap_ok[str, str](r2); }
        ret "the SPIR-V target has no body to emit for this callee, and a self-contained module cannot leave the call for a linker to resolve";
    }
    val r: R.Result[str, str] = format.sprint(e.alloc,
        "no module in this build defines `{}`, so the SPIR-V target has no body to emit for it: a self-contained module cannot leave the call for a linker to resolve",
        who);
    if (R.is_err[str, str](r)) {
        ret "no module in this build defines this callee, so the SPIR-V target has no body to emit for it";
    }
    ret R.unwrap_ok[str, str](r);
}

# emit the single SPIR-V instruction a `#[spirv_op(set, name)]` callee stands for
#
# The contract is uniform across every instruction in the table and is what makes
# adding one a row rather than a case: the result type is the mach function's
# declared return type, and the operands are its parameters in declaration order,
# read out of the identity convention's register file exactly as a real call's
# arguments would be. That covers the awkward members without special-casing them -
# `Length` and `OpDot` return a scalar from vectors, `Refract` mixes a scalar
# operand with vector ones, `FClamp` and `SmoothStep` take three.
#
# The signature is read from the IR function's type rather than from `params`,
# because for a cross-module callee the declaration is signature-only: it was
# synthesized from a name and a type and has no parameter list of its own.
#
# A core-set instruction is emitted directly; an extended one is an OpExtInst
# naming the imported set's id and the instruction number within it, with the set
# imported here on first use.
# ---
# e:        the emission state
# preg_val: the identity convention's nominal register file
# fn:       the callee's IR function record, carrying op_set / op_code
# ret:      true on success, or a precise error string
fun emit_spirv_op(e: *Emit, preg_val: *Regs, fn: *ir.Function) R.Result[bool, str] {
    val sig_opt: O.Option[*type.IrType] = type.get(?e.ir.types, fn.sig);
    if (O.is_none[*type.IrType](sig_opt)) {
        ret R.err[bool, str]("spirv.emit: a `spirv_op` callee has no signature type");
    }
    val sig: *type.IrType = O.unwrap[*type.IrType](sig_opt);
    if (sig.kind != type.IRT_FN) {
        ret R.err[bool, str]("spirv.emit: a `spirv_op` callee's signature is not a function type");
    }
    val argc: u32 = sig.data.fn.param_count;
    # 12 operands is past every instruction in the table (the widest is three) and
    # leaves the fixed operand array a comfortable size.
    if (argc > 12) {
        ret unsupported(e, "a `spirv_op` function takes at most 12 parameters on the SPIR-V target");
    }

    var returns_void: bool = false;
    val ret_ty: u32 = ir_return_spv_type(e, fn, ?returns_void);
    if (ret_ty == 0) { ret unsupported(e, "unsupported return type in the SPIR-V target"); }
    # every instruction in the table produces a value. a void one would leave the
    # result register holding whatever the previous call left there, which is the
    # silent-wrong-value failure this decorator exists to avoid.
    if (returns_void) {
        ret unsupported(e, "a `spirv_op` function must return a value; a SPIR-V instruction has a result id");
    }

    var ops: [16]u32;
    var base: u32 = 2;
    ops[0] = ret_ty;
    val result: u32 = spirv.alloc_id(e.b);
    ops[1] = result;
    if (fn.op_set != defs.SPV_SET_CORE) {
        val set_id: u32 = ext_set_id(e, fn.op_set);
        if (set_id == 0) {
            ret R.err[bool, str]("spirv.emit: a `spirv_op` names an instruction set with no import name");
        }
        ops[2] = set_id;
        ops[3] = fn.op_code;
        base = 4;
    }

    var i: u32 = 0;
    for (i < argc) {
        val aid: u32 = reg_value(e, preg_val, i, ir_value_spv_type(e, sig.data.fn.params[i]));
        if (aid == 0) { ret R.err[bool, str]("spirv.emit: `spirv_op` argument with no pre-colored value"); }
        ops[base + i] = aid;
        i = i + 1;
    }

    var opcode: u32 = spirv.OP_EXT_INST;
    if (fn.op_set == defs.SPV_SET_CORE) { opcode = fn.op_code; }
    spirv.inst(e.b, ?e.b.functions, opcode, ?ops[0], base + argc);

    # the return register, which the result move reads next - the same handoff a
    # real OpFunctionCall makes.
    preg_val.val_id[0] = result;
    preg_val.is_imm[0] = false;
    ret R.ok[bool, str](true);
}

# the id an extended instruction set is imported under, importing it on first use
#
# One OpExtInstImport per set per module: a second import of the same set is
# invalid, so the id is cached rather than re-minted. Returns 0 when the set has no
# import name, which is the core set and never reaches here.
# ---
# e:   the emission state
# set: one of defs.SPV_SET_*
# ret: the set's id, or 0
fun ext_set_id(e: *Emit, set: u32) u32 {
    if (set >= 8) { ret 0; }
    if (e.ext_ids[set] != 0) { ret e.ext_ids[set]; }
    val name: str = defs.set_import_name(set::u8);
    if (str_len(name) == 0::usize) { ret 0; }
    val id: u32 = spirv.ext_inst_import(e.b, name);
    e.ext_ids[set::u32] = id;
    ret id;
}

# the IR function record of the given interned name, defined or merely declared
#
# The unit's function table holds DEFINITIONS only, and a declaration is exactly
# what is wanted at two places: reading the target-specific decoration a reference
# carries before any body is in hand (`#[spirv_op(...)]`, `ext`), and reading a
# callee's return type off the shadow the calling module already has. Both are
# questions about the module in hand rather than about where the body lives, so
# they are answered here rather than through the table.
# ---
# irmod: the IR module
# name:  the interned function name
# ret:   the function record, or nil
fun ir_function_record(irmod: *ir.Module, name: intern.StrId) *ir.Function {
    var i: u32 = 0;
    for (i < irmod.function_len) {
        if (irmod.functions[i].name == name) { ret ?irmod.functions[i]; }
        i = i + 1;
    }
    ret nil;
}

# produce an SSA value id for an operand, materializing a load / constant as needed
#
# A vreg operand is loaded from its backing variable, at the type the variable was
# declared with - its own type is the truth, so `want_ty` is not consulted. An
# immediate has no type of its own: it is a bare bit pattern, minted against
# `want_ty`. A physical-register operand reads the identity register map (an
# incoming parameter, or a value moved into a register), where a pending immediate
# is likewise minted against `want_ty`. Returns 0 and latches an error for an
# operand kind the milestone cannot read as a scalar.
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the register-index -> SSA id map
# op:       the operand
# want_ty:  the SPIR-V type the consumer declares for this position, which types an
#           immediate; 0 falls back to a machine-word integer
# ret:      the SSA value id, or 0 on failure
fun read_operand(e: *Emit, vm: *VMaps, preg_val: *Regs, op: *mir.MirOperand, want_ty: u32) u32 {
    if (op.kind == mir.MIR_OP_VREG) {
        val v: u32 = op.vreg;
        # AN OPAQUE HANDLE has no backing variable to load from (#2794). Read from
        # the descriptor it came from, freshly at this use site, so the value is
        # available in whatever block the use sits in; or, for a handle a previous
        # instruction computed, hand its id straight on - which is what SPIR-V
        # requires of a combined image-and-sampler result anyway.
        if (v < vm.n && vm.opq_var[v] != 0) {
            val fresh: u32 = spirv.alloc_id(e.b);
            var ol: [3]u32;
            ol[0] = vm.type_id[v]; ol[1] = fresh; ol[2] = vm.opq_var[v];
            spirv.inst(e.b, ?e.b.functions, spirv.OP_LOAD, ?ol[0], 3);
            ret fresh;
        }
        if (v < vm.n && vm.opq_ssa[v] != 0) { ret vm.opq_ssa[v]; }
        if (v >= vm.n || vm.var_id[v] == 0) { e.b.err = true; ret 0; }
        val result: u32 = spirv.alloc_id(e.b);
        var lo: [3]u32;
        lo[0] = vm.type_id[v]; lo[1] = result; lo[2] = vm.var_id[v];
        spirv.inst(e.b, ?e.b.functions, spirv.OP_LOAD, ?lo[0], 3);
        # a SCALAR COMPARE'S RESULT IS A `OpTypeBool` HERE and an integer everywhere
        # else (#2749). Every other target computes a comparison into a 0/1 byte in a
        # register, so the IR's `i8` result is a number and arithmetic on it needs no
        # reconciliation; SPIR-V's is a boolean with no numeric representation at all,
        # and `OpISub` on one is not a valid module. This is the scalar counterpart of
        # the `OpSelect` widening `emit_vector_compare` already performs for the mask a
        # lane-wise compare produces, and it is reached the moment a comparison feeds
        # arithmetic rather than a branch - which per-lane mask construction does.
        if (vm.is_bool[v] && want_ty != 0 && !types.type_is_bool(e.tt, want_ty)) {
            ret widen_bool(e, result, want_ty);
        }
        ret result;
    }
    if (op.kind == mir.MIR_OP_IMM) {
        ret immediate(e, want_ty, op.imm);
    }
    if (op.kind == mir.MIR_OP_PREG) {
        if (op.preg >= 16) { e.b.err = true; ret 0; }
        ret reg_value(e, preg_val, op.preg, want_ty);
    }
    e.b.err = true;
    ret 0;
}

# materialize a SPIR-V boolean as the 0/1 value of `want_ty`
#
# `OpSelect` rather than a conversion opcode: a boolean has no numeric representation
# in SPIR-V, so there is nothing for `OpUConvert` to widen. The two results are the
# `want_ty` constants 1 and 0, which is the numeric reading every other target's
# comparison already leaves in a register.
# ---
# e:       the emission state
# boolean: the boolean SSA id
# want_ty: the numeric type to produce
# ret:     the numeric SSA id
fun widen_bool(e: *Emit, boolean: u32, want_ty: u32) u32 {
    val one:  u32 = types.const_scalar(e.tt, want_ty, 1, 0);
    val zero: u32 = types.const_scalar(e.tt, want_ty, 0, 0);
    if (one == 0 || zero == 0) { e.b.err = true; ret 0; }
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [5]u32;
    ops[0] = want_ty; ops[1] = result; ops[2] = boolean; ops[3] = one; ops[4] = zero;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECT, ?ops[0], 5);
    ret result;
}

# mint the constant of type `want_ty` holding the bit pattern `imm`
#
# A MIR immediate is a representation, not a number: an f32 literal arrives as its
# already-narrowed IEEE pattern in the same `i64` field an integer literal uses, so
# the consumer's declared type is the only thing that says how to spell it. A
# boolean position takes `OpConstantTrue` / `OpConstantFalse`, which carry no
# literal at all.
# ---
# e:       the emission state
# want_ty: the declared type, or 0 for a machine-word integer
# imm:     the immediate's bit pattern
# ret:     the constant's SSA id
fun immediate(e: *Emit, want_ty: u32, imm: i64) u32 {
    var ty: u32 = want_ty;
    if (ty == 0) { ty = types.type_int(e.tt, e.tgt.model.gpr_width * 8); }
    if (types.type_is_bool(e.tt, ty)) { ret types.const_bool(e.tt, imm != 0); }
    val pattern: u64 = imm::u64;
    ret types.const_scalar(e.tt, ty, (pattern & 0xFFFFFFFF)::u32, ((pattern >> 32) & 0xFFFFFFFF)::u32);
}

# store an SSA value into a vreg's backing variable
# ---
# e:     the emission state
# vm:    the per-vreg value maps
# vreg:  the destination vreg id
# value: the SSA value id to store
# ret:   true on success, or an error string
fun store_vreg(e: *Emit, vm: *VMaps, vreg: u32, value: u32) R.Result[bool, str] {
    # an opaque handle is RECORDED rather than stored (#2794): SPIR-V forbids
    # storing an image, sampler or sampled-image object, so the vreg carries the id
    # and every use reads it back from here.
    if (vreg < vm.n && vm.type_id[vreg] != 0 && types.type_is_opaque(e.tt, vm.type_id[vreg])) {
        vm.opq_ssa[vreg] = value;
        ret R.ok[bool, str](true);
    }
    if (vreg >= vm.n || vm.var_id[vreg] == 0) {
        ret R.err[bool, str]("spirv.emit: store to an undeclared vreg");
    }
    var so: [2]u32;
    so[0] = vm.var_id[vreg]; so[1] = value;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_STORE, ?so[0], 2);
    ret R.ok[bool, str](true);
}

# emit a binary op `dst = a <op_code> b`, both operands at the result's type
#
# Every binary MIR op this handles is same-type in all three positions (the shifts
# included: a shift count is an integer of the shifted value's width by the time it
# reaches MIR), so the destination's type is what the operands are read at.
# ---
# e:      the emission state
# vm:     the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:     the MIR instruction ([dst, a, b])
# op_code: the SPIR-V opcode
# ret:    true on success, or an error string
fun emit_binary(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr, op_code: u32) R.Result[bool, str] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret R.err[bool, str]("spirv.emit: malformed binary instruction");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret R.err[bool, str]("spirv.emit: binary result vreg out of range"); }
    val ty: u32 = vm.type_id[dst];
    val a: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], ty);
    val b: u32 = read_operand(e, vm, preg_val, ?mi.operands[2], ty);
    if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable operand in binary instruction"); }
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [4]u32;
    ops[0] = vm.type_id[dst]; ops[1] = result; ops[2] = a; ops[3] = b;
    spirv.inst(e.b, ?e.b.functions, op_code, ?ops[0], 4);
    ret store_vreg(e, vm, dst, result);
}

# emit a unary op `dst = <op_code> a`, the operand at the result's type
# ---
# e:      the emission state
# vm:     the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:     the MIR instruction ([dst, a])
# op_code: the SPIR-V opcode
# ret:    true on success, or an error string
fun emit_unary(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr, op_code: u32) R.Result[bool, str] {
    if (mi.operand_count != 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret R.err[bool, str]("spirv.emit: malformed unary instruction");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret R.err[bool, str]("spirv.emit: unary result vreg out of range"); }
    val a: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], vm.type_id[dst]);
    if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable operand in unary instruction"); }
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [3]u32;
    ops[0] = vm.type_id[dst]; ops[1] = result; ops[2] = a;
    spirv.inst(e.b, ?e.b.functions, op_code, ?ops[0], 3);
    ret store_vreg(e, vm, dst, result);
}

# emit an integer comparison `dst(bool) = a <op_code> b`
#
# The compared operands ride at the comparison width (`mi.width`), while the result
# is a boolean stored into the destination's bool variable.
# ---
# e:      the emission state
# vm:     the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:     the MIR instruction ([dst, a, b])
# op_code: the SPIR-V comparison opcode
# ret:    true on success, or an error string
fun emit_compare(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr, op_code: u32) R.Result[bool, str] {
    if (mir.vec_lane_is_vector(mi.vec_lane)) {
        ret emit_vector_compare(e, vm, preg_val, mi, op_code);
    }
    var cbits: u32 = mi.width::u32 * 8;
    if (cbits == 0) { cbits = e.tgt.model.gpr_width * 8; }
    ret emit_compare_typed(e, vm, preg_val, mi, op_code, types.type_int(e.tt, cbits));
}

# emit a lane-wise vector comparison as mach's unsigned MASK vector
#
# The two languages disagree about what a vector comparison IS, and this is where
# that is reconciled. SPIR-V yields a vector of booleans; mach has no vector-bool
# type and defines the result as a same-shape unsigned vector whose lanes are
# all-ones for true and all-zeros for false - what the SSE / NEON compare hardware
# hands back directly. So the boolean vector is widened through an `OpSelect`
# between an all-ones and an all-zeros constant of the mask type. A consumer's
# mem2reg and peephole collapse that back to its own compare form; emitting the
# boolean vector raw would be a different, narrower type than the mach program
# declared.
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:       the vector comparison instruction ([dst, a, b])
# op_code:   the SPIR-V comparison opcode, already class-selected
# ret:      true on success, or an error string
fun emit_vector_compare(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr, op_code: u32) R.Result[bool, str] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret R.err[bool, str]("spirv.emit: malformed vector comparison instruction");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret R.err[bool, str]("spirv.emit: comparison result vreg out of range"); }

    val lanes: u32 = mir.vec_lane_count(mi.vec_lane);
    val operand_ty: u32 = vector_type_of(e, mi.vec_lane, false);
    val bvec_ty: u32 = types.type_vector(e.tt, types.type_bool(e.tt), lanes);
    val mask_ty: u32 = vm.type_id[dst];
    if (operand_ty == 0 || bvec_ty == 0 || mask_ty == 0) {
        ret unsupported(e, unsupported_value_type(e, mi));
    }

    val a: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], operand_ty);
    val b: u32 = read_operand(e, vm, preg_val, ?mi.operands[2], operand_ty);
    if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable operand in vector comparison"); }

    val bvec: u32 = spirv.alloc_id(e.b);
    var cops: [4]u32;
    cops[0] = bvec_ty; cops[1] = bvec; cops[2] = a; cops[3] = b;
    spirv.inst(e.b, ?e.b.functions, op_code, ?cops[0], 4);

    val ones: u32 = mask_splat(e, mask_ty, lanes, 0xFFFFFFFF, 0xFFFFFFFF);
    val zeros: u32 = mask_splat(e, mask_ty, lanes, 0, 0);
    if (ones == 0 || zeros == 0) {
        ret R.err[bool, str]("spirv.emit: could not build a vector comparison mask constant");
    }

    val result: u32 = spirv.alloc_id(e.b);
    var sops: [5]u32;
    sops[0] = mask_ty; sops[1] = result; sops[2] = bvec; sops[3] = ones; sops[4] = zeros;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECT, ?sops[0], 5);
    ret store_vreg(e, vm, dst, result);
}

# a vector constant of `lanes` copies of one bit pattern, for a comparison mask
# ---
# e:       the emission state
# vec_ty:  the mask vector type
# lanes:   the lane count
# lo:      the low word of each lane's pattern
# hi:      the high word of each lane's pattern (used only for 64-bit lanes)
# ret:     the constant's id, or 0 when the shape is out of range
fun mask_splat(e: *Emit, vec_ty: u32, lanes: u32, lo: u32, hi: u32) u32 {
    var count: u32 = 0;
    val lane_ty: u32 = types.vector_shape(e.tt, vec_ty, ?count);
    if (lane_ty == 0 || count == 0 || count > types.MAX_VECTOR_COMPONENTS) { ret 0; }
    val lane: u32 = types.const_scalar(e.tt, lane_ty, lo, hi);
    var parts: [4]u32;
    var i: u32 = 0;
    for (i < count) { parts[i] = lane; i = i + 1; }
    ret types.const_composite(e.tt, vec_ty, ?parts[0], count);
}

# emit a vector lane read `dst = a[k]`
#
# The lane index is a compile-time constant by the language's rule, so this is
# `OpCompositeExtract` with a literal index rather than the dynamic form.
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:       the MIR_VEC_EXTRACT instruction ([dst, vector, lane index])
# ret:      true on success, or an error string
fun emit_vec_extract(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[bool, str] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret R.err[bool, str]("spirv.emit: malformed vector extract instruction");
    }
    if (mi.operands[2].kind != mir.MIR_OP_IMM) {
        ret unsupported(e, "a runtime vector lane index is not supported by the SPIR-V target");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret R.err[bool, str]("spirv.emit: vector extract result vreg out of range"); }
    val vec_ty: u32 = operand_vector_type(e, vm, mi, ?mi.operands[1]);
    if (vec_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
    val src: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], vec_ty);
    if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable operand in vector extract"); }

    val result: u32 = spirv.alloc_id(e.b);
    var ops: [4]u32;
    ops[0] = vm.type_id[dst]; ops[1] = result; ops[2] = src; ops[3] = mi.operands[2].imm::u32;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_EXTRACT, ?ops[0], 4);
    ret store_vreg(e, vm, dst, result);
}

# emit a vector lane write `dst = a with [k] = v`
#
# `OpCompositeInsert` is functional rather than in-place: it takes the whole source
# vector and yields a new one, which is what the MIR form means too.
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:       the MIR_VEC_INSERT instruction ([dst, vector, lane index, value])
# ret:      true on success, or an error string
fun emit_vec_insert(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[bool, str] {
    if (mi.operand_count != 4 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret R.err[bool, str]("spirv.emit: malformed vector insert instruction");
    }
    if (mi.operands[2].kind != mir.MIR_OP_IMM) {
        ret unsupported(e, "a runtime vector lane index is not supported by the SPIR-V target");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret R.err[bool, str]("spirv.emit: vector insert result vreg out of range"); }
    val vec_ty: u32 = vm.type_id[dst];
    if (vec_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
    var lanes: u32 = 0;
    val lane_ty: u32 = types.vector_value_shape(e.tt, vec_ty, ?lanes);
    if (lane_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }

    val src: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], vec_ty);
    val lane: u32 = read_operand(e, vm, preg_val, ?mi.operands[3], lane_ty);
    if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable operand in vector insert"); }

    val result: u32 = spirv.alloc_id(e.b);
    var ops: [5]u32;
    ops[0] = vec_ty; ops[1] = result; ops[2] = lane; ops[3] = src; ops[4] = mi.operands[2].imm::u32;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_INSERT, ?ops[0], 5);
    ret store_vreg(e, vm, dst, result);
}

# emit an OpCompositeConstruct for a whole-vector build (#2640)
#
# The lanes are the operands, in lane order, and the result is the vector. This is
# what a vector literal becomes here, and it is why the literal is not assembled
# through storage on this target: the storage form loads a vector out of a slot it
# stored lanes into, and under the logical addressing model a pointer has exactly one
# pointee type with no bitcast between them, so there is no legal encoding of it.
#
# Every lane is read at the vector's ELEMENT type, which is also what types an
# immediate lane: a bare bit pattern has no type of its own, and minting it against
# the vector type would produce a vector-typed constant where a scalar belongs.
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:       the MIR_VEC_BUILD instruction
# ret:      true on success, or a precise error string
fun emit_vec_build(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[bool, str] {
    if (mi.operand_count < 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret R.err[bool, str]("spirv.emit: malformed vector build instruction");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret R.err[bool, str]("spirv.emit: vector build result vreg out of range"); }
    val vec_ty: u32 = vm.type_id[dst];
    if (vec_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
    var lanes: u32 = 0;
    val lane_ty: u32 = types.vector_value_shape(e.tt, vec_ty, ?lanes);
    if (lane_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }

    val given: u32 = mi.operand_count - 1;
    if (given != lanes) {
        ret R.err[bool, str]("spirv.emit: vector build lane count does not match its vector type");
    }
    # 2 fixed words plus one per lane. NO LANE-COUNT CEILING (#2727): the buffer used
    # to be a fixed eighteen words guarded by a refusal, sized by the widest vector
    # the surface could spell rather than by anything SPIR-V bounds - a shape wider
    # than an OpTypeVector is realized as an array, and OpCompositeConstruct builds
    # that too (#2749), at whatever length the array has.
    val ro: R.Result[*u32, str] = A.allocate[u32](e.alloc, (given + 2)::usize);
    if (R.is_err[*u32, str](ro)) { ret R.err[bool, str](R.unwrap_err[*u32, str](ro)); }
    val ops: *u32 = R.unwrap_ok[*u32, str](ro);
    ops[0] = vec_ty;
    val result: u32 = spirv.alloc_id(e.b);
    ops[1] = result;
    var i: u32 = 0;
    for (i < given) {
        ops[2 + i] = read_operand(e, vm, preg_val, ?mi.operands[1 + i], lane_ty);
        i = i + 1;
    }
    if (e.b.err) {
        A.deallocate[u32](e.alloc, ops, (given + 2)::usize);
        ret R.err[bool, str]("spirv.emit: unreadable operand in vector build");
    }

    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_CONSTRUCT, ops, 2 + given);
    A.deallocate[u32](e.alloc, ops, (given + 2)::usize);
    ret store_vreg(e, vm, dst, result);
}

# the vector type of an instruction's source operand
#
# A vreg source carries its own declared type, which is the truth. Otherwise the
# shape is rebuilt from the instruction's lane descriptor, which for a lane access
# describes the VECTOR side rather than the scalar result.
# ---
# e:   the emission state
# vm:  the per-vreg value maps
# mi:  the instruction (for its lane descriptor)
# op:  the source operand
# ret: the SPIR-V vector type id, or 0
fun operand_vector_type(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, op: *mir.MirOperand) u32 {
    if (op.kind == mir.MIR_OP_VREG && op.vreg < vm.n && vm.type_id[op.vreg] != 0) {
        ret vm.type_id[op.vreg];
    }
    if (!mir.vec_lane_is_vector(mi.vec_lane)) { ret 0; }
    ret vector_type_of(e, mi.vec_lane, false);
}

# emit a float comparison, choosing the ordered / unordered SPIR-V relation the
# MIR condition code names
#
# The relation rides in `src_width` (a float compare has no narrower operand width
# to carry there), and the operand type is the compare width in the float class.
# Every relation but `!=` is ORDERED, so a NaN operand reads false; `!=` is the
# unordered one, so it reads true. That is the IEEE-754 reading of mach's
# operators, and it matches instruction-for-instruction what the x86-64 encoder
# builds out of UCOMISx plus a parity fold - a shader and a native build of the
# same source agree about NaN.
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:       the MIR_FCMP instruction ([dst, a, b]) carrying its FCC_* code
# ret:      true on success, or an error string
fun emit_float_compare(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[bool, str] {
    var fbits: u32 = mi.width::u32 * 8;
    if (fbits != 32 && fbits != 64) {
        ret unsupported(e, "unsupported float comparison width in the SPIR-V target");
    }
    val cc: u8 = mi.src_width;
    var op_code: u32 = spirv.OP_F_ORD_GREATER_THAN_EQUAL;
    if (cc == mir.FCC_EQ)      { op_code = spirv.OP_F_ORD_EQUAL; }
    or (cc == mir.FCC_NE)      { op_code = spirv.OP_F_UNORD_NOT_EQUAL; }
    or (cc == mir.FCC_LT)      { op_code = spirv.OP_F_ORD_LESS_THAN; }
    or (cc == mir.FCC_LE)      { op_code = spirv.OP_F_ORD_LESS_THAN_EQUAL; }
    or (cc == mir.FCC_GT)      { op_code = spirv.OP_F_ORD_GREATER_THAN; }
    or (cc != mir.FCC_GE)      { ret unsupported(e, "unknown float comparison condition in the SPIR-V target"); }
    ret emit_compare_typed(e, vm, preg_val, mi, op_code, types.type_float(e.tt, fbits));
}

# emit a comparison whose operands are read at `operand_ty` and whose result is a
# boolean stored into the destination's variable
# ---
# e:          the emission state
# vm:         the per-vreg value maps
# preg_val:   the identity convention's nominal register file
# mi:         the MIR instruction ([dst, a, b])
# op_code:     the SPIR-V comparison opcode
# operand_ty: the type both compared operands are read at
# ret:        true on success, or an error string
fun emit_compare_typed(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr,
                       op_code: u32, operand_ty: u32) R.Result[bool, str] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret R.err[bool, str]("spirv.emit: malformed comparison instruction");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret R.err[bool, str]("spirv.emit: comparison result vreg out of range"); }
    val a: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], operand_ty);
    val b: u32 = read_operand(e, vm, preg_val, ?mi.operands[2], operand_ty);
    if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable operand in comparison"); }
    val bool_ty: u32 = types.type_bool(e.tt);
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [4]u32;
    ops[0] = bool_ty; ops[1] = result; ops[2] = a; ops[3] = b;
    spirv.inst(e.b, ?e.b.functions, op_code, ?ops[0], 4);
    ret store_vreg(e, vm, dst, result);
}

# emit a conversion `dst = <op_code>(a)`
#
# A conversion is the one shape whose operand type is NOT the result type, so the
# source side is reconstructed here: `src_width` gives the width and the opcode
# fixes the class. That only matters for a source that carries no type of its own -
# an immediate or a nominal register - since a vreg source is loaded at its own
# declared type.
# ---
# e:      the emission state
# vm:     the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:     the MIR instruction ([dst, a]) carrying the source width in src_width
# op_code: the SPIR-V conversion opcode
# src_is_float: whether the source side is read in the float class
# ret:    true on success, or an error string
fun emit_convert(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr,
                 op_code: u32, src_is_float: bool) R.Result[bool, str] {
    if (mi.operand_count != 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret R.err[bool, str]("spirv.emit: malformed conversion instruction");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret R.err[bool, str]("spirv.emit: conversion result vreg out of range"); }
    var sbits: u32 = mi.src_width::u32 * 8;
    if (sbits == 0) { sbits = e.tgt.model.gpr_width * 8; }
    var src_ty: u32 = types.type_int(e.tt, sbits);
    if (src_is_float) {
        if (sbits != 32 && sbits != 64) {
            ret unsupported(e, "unsupported float conversion width in the SPIR-V target");
        }
        src_ty = types.type_float(e.tt, sbits);
    }
    val a: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], src_ty);
    if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable operand in conversion"); }
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [3]u32;
    ops[0] = vm.type_id[dst]; ops[1] = result; ops[2] = a;
    spirv.inst(e.b, ?e.b.functions, op_code, ?ops[0], 3);
    ret store_vreg(e, vm, dst, result);
}

# emit a MIR_MOV: a register-to-register / immediate copy
#
# A move into a value vreg stores the source into the vreg's variable. A move into
# a physical register records the source SSA id in the identity register map - the
# return-value pre-coloring the bare MIR_RET later consumes.
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# ret_bits: the integer return width, used to type an immediate moved into a register
# mi:       the MIR instruction ([dst, src])
# ret:      true on success, or an error string
fun emit_mov(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[bool, str] {
    if (mi.operand_count != 2) { ret R.err[bool, str]("spirv.emit: malformed move instruction"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];

    if (dst.kind == mir.MIR_OP_VREG) {
        if (dst.vreg >= vm.n) { ret R.err[bool, str]("spirv.emit: move destination vreg out of range"); }
        val val_id: u32 = read_operand(e, vm, preg_val, src, vm.type_id[dst.vreg]);
        if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable move source"); }
        ret store_vreg(e, vm, dst.vreg, val_id);
    }
    if (dst.kind == mir.MIR_OP_PREG) {
        if (dst.preg >= 16) { ret R.err[bool, str]("spirv.emit: move destination register out of range"); }
        # an immediate waits here untyped: the type it takes is the one the callee's
        # parameter or the function's return type declares, not the move's, which the
        # ABI pre-coloring always emits at the machine word in the integer class.
        if (src.kind == mir.MIR_OP_IMM) {
            preg_val.val_id[dst.preg] = 0;
            preg_val.imm[dst.preg]    = src.imm;
            preg_val.is_imm[dst.preg] = true;
            ret R.ok[bool, str](true);
        }
        val val_id: u32 = read_operand(e, vm, preg_val, src, 0);
        if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable move source"); }
        preg_val.val_id[dst.preg] = val_id;
        preg_val.is_imm[dst.preg] = false;
        ret R.ok[bool, str](true);
    }
    ret unsupported(e, "memory-destination move is not yet supported by the SPIR-V target");
}

# the SSA value in a nominal register, minting a pending immediate at `want_ty`
# ---
# e:       the emission state
# rg:      the register file
# k:       the register index
# want_ty: the SPIR-V type the consumer declares for this position
# ret:     the SSA value id, or 0 when the register holds nothing
fun reg_value(e: *Emit, rg: *Regs, k: u32, want_ty: u32) u32 {
    if (!rg.is_imm[k]) { ret rg.val_id[k]; }
    ret immediate(e, want_ty, rg.imm[k]);
}

# the `#[builtin]` type table, at every built-in and in both directions
#
# The table is the whole check, so a row that agrees with itself proves nothing:
# every built-in is asserted to ACCEPT the type SPIR-V specifies for it and to
# REFUSE a plausible neighbour of that type. The neighbours are the mistakes a
# reader actually makes - a `u32x4` where a `u32x3` is specified, a scalar where a
# vector is, an integer where a float is - each of which the emitter accepted and
# `spirv-val` rejected before this table existed (#2745).
test "mach.lang.target.isa.spirv.emit:builtin_type_table" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var tt: type.IrTypeTable;
    if (O.is_some[str](type.init(?tt, ?alloc))) { ret 1; }

    val f32t: type.IrTypeId  = R.unwrap_ok[type.IrTypeId, str](type.intern_float(?tt, 32));
    val i32t: type.IrTypeId  = R.unwrap_ok[type.IrTypeId, str](type.intern_int(?tt, 32));
    val f64t: type.IrTypeId  = R.unwrap_ok[type.IrTypeId, str](type.intern_float(?tt, 64));
    val v4f: type.IrTypeId   = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, f32t, 4));
    val v3f: type.IrTypeId   = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, f32t, 3));
    val v3i: type.IrTypeId   = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, i32t, 3));
    val v4i: type.IrTypeId   = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, i32t, 4));

    # position and frag_coord: a four-component float vector, nothing else.
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POSITION, v4f) != nil)   { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_FRAG_COORD, v4f) != nil) { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POSITION, v3f) == nil)   { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POSITION, v4i) == nil)   { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_FRAG_COORD, f32t) == nil) { type.dnit(?tt); ret 1; }

    # point_size: a scalar float, and an f64 is not one - a 64-bit interface
    # variable needs the Float64 capability this module never declares.
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POINT_SIZE, f32t) != nil) { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POINT_SIZE, f64t) == nil) { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POINT_SIZE, v4f) == nil)  { type.dnit(?tt); ret 1; }

    # vertex_index and instance_index: a scalar 32-bit integer. IR carries no
    # signedness, so `i32` and `u32` are one type here and both are accepted.
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_VERTEX_INDEX, i32t) != nil)   { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_INSTANCE_INDEX, i32t) != nil) { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_VERTEX_INDEX, f32t) == nil)   { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_INSTANCE_INDEX, v3i) == nil)  { type.dnit(?tt); ret 1; }

    # the three compute ids: a three-component 32-bit integer vector. the `u32x4`
    # row is the one #2745 is about - it was the only shape the language could
    # spell, and it is an invalid module rather than a wasteful one.
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_GLOBAL_INVOCATION, v3i) != nil) { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_LOCAL_INVOCATION, v3i) != nil)  { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_WORKGROUP_ID, v3i) != nil)      { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_GLOBAL_INVOCATION, v4i) == nil) { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_LOCAL_INVOCATION, v3f) == nil)  { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_WORKGROUP_ID, i32t) == nil)     { type.dnit(?tt); ret 1; }

    type.dnit(?tt);
    ret 0;
}

# the declared type a `#[builtin]` refusal names is the one the author wrote
#
# A refusal that misdirects is worse than one that says only "unsupported": it
# sends the reader somewhere false. The spelling is asserted here rather than left
# to a golden, since it is what the whole diagnostic is built on.
test "mach.lang.target.isa.spirv.emit:ir_type_spelling" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var tt: type.IrTypeTable;
    if (O.is_some[str](type.init(?tt, ?alloc))) { ret 1; }

    val f32t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_float(?tt, 32));
    val i32t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_int(?tt, 32));
    val v3f: type.IrTypeId  = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, f32t, 3));
    val v3i: type.IrTypeId  = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, i32t, 3));
    val arr: type.IrTypeId  = R.unwrap_ok[type.IrTypeId, str](type.intern_array(?tt, f32t, 4));

    if (!str_equals(ir_type_spelling(?tt, ?alloc, f32t), "`f32`"))    { type.dnit(?tt); ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, v3f), "`f32x3`"))   { type.dnit(?tt); ret 1; }
    # an integer is spelled at both signs, because IR carries neither.
    if (!str_equals(ir_type_spelling(?tt, ?alloc, i32t), "`i32` / `u32`"))       { type.dnit(?tt); ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, v3i), "`i32x3` / `u32x3`"))    { type.dnit(?tt); ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, arr), "an array"))  { type.dnit(?tt); ret 1; }

    type.dnit(?tt);
    ret 0;
}

# the Flat requirement is decided on the ELEMENT class, at every width
#
# The rule Vulkan states is that a fragment stage's Input cannot be interpolated
# unless it is a 32-bit float, so the answer turns on the element and a vector
# inherits it. The table is asserted directly because the end-to-end case can only
# show the types it happens to declare, and the interesting half of this predicate
# is the types it must answer FALSE for: decorating an `f32` varying Flat is not a
# harmless over-approximation, it changes how the value is shaded.
test "mach.lang.target.isa.spirv.emit:flat_element_classes" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var tt: type.IrTypeTable;
    if (O.is_some[str](type.init(?tt, ?alloc))) { ret 1; }

    val f32t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_float(?tt, 32));
    val f64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_float(?tt, 64));
    val i32t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_int(?tt, 32));
    val i8t:  type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_int(?tt, 8));
    val v4f:  type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, f32t, 4));
    val v3i:  type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, i32t, 3));
    val v2d:  type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, f64t, 2));
    val arr:  type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_array(?tt, f32t, 4));

    # an integer of any width, and a vector of them.
    if (!needs_flat(?tt, i32t)) { type.dnit(?tt); ret 1; }
    if (!needs_flat(?tt, i8t))  { type.dnit(?tt); ret 1; }
    if (!needs_flat(?tt, v3i))  { type.dnit(?tt); ret 1; }

    # a 64-bit float, and a vector of them.
    if (!needs_flat(?tt, f64t)) { type.dnit(?tt); ret 1; }
    if (!needs_flat(?tt, v2d))  { type.dnit(?tt); ret 1; }

    # a 32-bit float is the only interpolable element there is.
    if (needs_flat(?tt, f32t)) { type.dnit(?tt); ret 1; }
    if (needs_flat(?tt, v4f))  { type.dnit(?tt); ret 1; }

    # an aggregate has no single element class, so it answers false rather than a
    # shape of its own; a varying of one is a separate refusal.
    if (needs_flat(?tt, arr)) { type.dnit(?tt); ret 1; }

    type.dnit(?tt);
    ret 0;
}
