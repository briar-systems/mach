use mach.lang.target.isa.spirv.defs;
use mach.lang.target.isa.spirv.ops;
use mach.lang.target.isa.spirv.types;
use mach.lang.target.of;
use semtype: mach.lang.type;

rec Emit {
    alloc:     *A.Allocator;
    interner:  *intern.Interner;
    tgt:       *isa.BackendTarget;
    layout:    layout.Machine;
    u:         *unit.Unit;
    root:      *ir.Module;
    ir:        *ir.Module;
    cur_mi:    u32;
    b:         *spirv.Builder;
    tt:        *types.TypeTable;
    fns:       *FnEnt;
    fn_len:    u32;
    has_entry: bool;
    gls:       *GlobalEnt;
    gl_len:    u32;
    gvar_ids:  *u32;
    gtype_ids: *u32;
    gstorage:  *u32;
    iface_len: u32;
    gslot:     *u32;
    iface_use: *u8;
    # the LocalInvocationIndex variable the emitter adds for the zeroing of `#[shared]`
    # memory when no global declares one, 0 until a stage needs it
    zero_lid: u32;

    # what each reached global's memory may undergo, as ACCESS_* bits
    gaccess: *u8;
    # what each function does through each of its parameters, as ACCESS_* bits,
    # function fx's parameter k at pacc[pbase[fx] + k]
    pacc:     *u8;
    pbase:    *u32;
    pacc_len: u32;
    # the root of the handle each function returns: a global, a parameter's origin,
    # GL_NONE while none is seen, ORIGIN_UNKNOWN once two meet, or ORIGIN_UNROOTED
    # once one names no binding
    rsum:     *u32;
    sum_grew: bool;
    # the root of a pointer each function returns, which the refusal of the result names
    rptr: *u32;
    # the OpSpecConstant id of each `#[spec]` global, 0 for any other
    gspec: *u32;
    # the module sizes its compute stages through one WorkgroupSize built-in
    wg_builtin: bool;
    # the module declares the Vulkan memory model, where an access is private unless it
    # says otherwise: `pscope` is the scope each pointer id's accesses are made available
    # and visible at, by its id, 0 for a private access. a coherent storage image is
    # read and written through handles, and `coherent_images` says the module binds one
    vulkan_mm:       bool;
    pscope:          Vector[u8];
    coherent_images: bool;

    # the module holds a physical pointer, so it addresses PhysicalStorageBuffer64 (#4307).
    # `palign` is the alignment each physical pointer id's accesses carry, by its id, 0 for
    # a logical pointer, and `talign` and `tsize` the alignment and extent of each type
    # physical memory holds, by its id. `pkeys` holds the explicit-layout types built for
    # physical memory, each once, and `precs` each record a cycle of pointers reaches
    physical: bool;
    palign:   Vector[u32];
    talign:   Vector[u32];
    tsize:    Vector[u32];
    pkeys:    Vector[PhysKey];
    precs:    Vector[PhysRec];
    strided:  Vector[u32];
    # a refusal a type query put on the store, which the next refusal returns in place of its own
    held:     fail.Fail;
    has_held: bool;

    ext_ids: [8]u32;

    # the copies of the emitted functions, one per way a caller binds their pointer
    # parameters, each keyed by its words in `keys` (#4278)
    copies: Vector[Copy];
    keys:   Vector[u32];
    # the copy under emission, where its source parameter k lands among its
    # SPIR-V parameters, and their ids
    cur_copy:   u32;
    cur_pslot:  *u32;
    cur_params: *u32;

    srcmap: *source.SourceMap;
    # the root module's diagnostic store, where a refusal of the program lands
    diags:     *diagnostic.DiagnosticStore;
    dbg:       dbgm.Debug;
    cur_fn:    *mir.MirFunction;
    cur_instr: *mir.MirInstr;
    # the stages each function is reached from, as stage_bit sets, and the set of the one
    # being emitted
    fn_stages:  *u8;
    cur_stages: u8;
}

rec VMaps {
    type_id:  *u32;
    var_id:   *u32;
    is_bool:  *bool;
    chain_id: *u32;
    chain_ty: *u32;
    chain_sc: *u32;
    opq_var:  *u32;
    opq_ssa:  *u32;
    # where the index ids an access chain read begin in `gep_ids`, plus one, 0 for none
    gep_at:  *u32;
    gep_ids: Vector[u32];
    # each register's pointer provenance, PROV_* bits (#4307)
    prov: *u8;
    n:    u32;
}

rec FnEnt {
    mi:     u32;
    ir_ix:  u32;
    mir_ix: u32;
    name:   intern.StrId;
    id:     u32;
    emit:   bool;
}

rec GlobalEnt {
    mi:    u32;
    ir_ix: u32;
    name:  intern.StrId;
}

# one emitted OpFunction of a source function. logical addressing admits only a
# memory object declaration as a call's pointer argument, and no StorageBuffer or
# other block pointer at all, so a pointer parameter bound to a subobject or to an
# interface variable is split into the root it points into and the path from there:
# the copy names a global root itself, takes a Function-storage root whole, and
# takes the path's runtime indices as integers. its key is one binding per source
# parameter, spelled in words:
#   BIND_VALUE                                  not a pointer parameter
#   BIND_WHOLE                                  a whole Function-storage object
#   BIND_GLOBAL, global, n, step * n            a path into a global, named in the copy
#   BIND_LOCAL, module, ir type, n, step * n    a path into a Function-storage root of
#                                               that type, passed first
#   BIND_PHYSICAL                               a physical pointer, passed as the value it is
# where a step is a member ordinal, which OpAccessChain takes only as a constant, or
# STEP_RUNTIME for an array element, whose index (constant or not) is passed after the root
rec Copy {
    fx:      u32;
    id:      u32;
    key_at:  u32;
    key_len: u32;
}

val BIND_VALUE:    u32 = 0;
val BIND_WHOLE:    u32 = 1;
val BIND_GLOBAL:   u32 = 2;
val BIND_LOCAL:    u32 = 3;
val BIND_PHYSICAL: u32 = 4;

val STEP_RUNTIME: u32 = 0xFFFFFFFF;

val COPY_NONE: u32 = 0xFFFFFFFF;

# an explicit-layout type built for physical memory: a struct of `n` members at their
# offsets, or an array of `n` elements of `ids[0]` at the stride `offs[0]`
rec PhysKey {
    array: bool;
    n:     u32;
    ids:   [16]u32;
    offs:  [16]u32;
    id:    u32;
}

# a record a cycle of pointers reaches, by its key: the pointer to it, reserved before the
# record is declared so a member of its cycle can name it, and its explicit-layout struct
rec PhysRec {
    key:       u32;
    ptr:       u32;
    strct:     u32;
    building:  bool;
    forwarded: bool;
}

# the provenance of a pointer register: a logical pointer names memory the module declares,
# a physical one an address in a buffer the host passes (#4307)
val PROV_LOGICAL:  u8 = 1;
val PROV_PHYSICAL: u8 = 2;

# the role whose layout rules physical memory follows, beside the interface roles
val ROLE_PHYSICAL: u8 = 0xFE;

val ROOT_GLOBAL: u8 = 1;
val ROOT_ALLOCA: u8 = 2;
val ROOT_PARAM:  u8 = 3;

# one step of an address: a member ordinal, or an element index that a chain of this
# function read (its result vreg and the index's position) or that this copy receives
# (the parameter and the index's slot among that parameter's runtime indices)
rec AddrStep {
    ord:        u32;
    from_param: bool;
    a:          u32;
    b:          u32;
}

# where a pointer argument points: its root and the steps from there
rec Addr {
    root:    u8;
    gix:     u32;
    vreg:    u32;
    param:   u32;
    root_mi: u32;
    root_ty: type.IrTypeId;
    # the type the address points at so far, in module cur_mi's types, which says
    # whether the next step selects a member or an element
    cur_mi: u32;
    cur_ty: type.IrTypeId;
    steps:  Vector[AddrStep];
}

pub fun emit_module(out_alloc: *A.Allocator, tgt: *isa.BackendTarget, u: *unit.Unit,
    dbg: *debug_input.ModuleDebug, image: *of.ObjectImage) err[fail.Fail] {
    if (out_alloc == nil || tgt == nil || u == nil || u.len == 0 || u.mods == nil || image == nil) {
        ret err[fail.Fail].err{fail.message("spirv.emit: nil argument")};
    }
    if (image.alloc != out_alloc) {
        ret err[fail.Fail].err{fail.message("spirv.emit: the module is serialized into the image's allocator, and the two differ")};
    }
    val irmod:  *ir.Module     = unit.root_ir(u);
    val mirmod: *mir.MirModule = unit.root_mir(u);
    if (irmod == nil || mirmod == nil) { ret err[fail.Fail].err{fail.message("spirv.emit: nil argument")}; }

    var b:  spirv.Builder   = spirv.builder_init(out_alloc);
    var tt: types.TypeTable = types.types_init(?b);

    var e: Emit;
    e.alloc           = out_alloc;
    e.interner        = mirmod.interner;
    e.tgt             = tgt;
    e.layout          = layout.machine(tgt.model.pointer_width, tgt.model.vector_bits, isa.vector_register_bits(?tgt.model));
    e.u               = u;
    e.root            = irmod;
    e.ir              = irmod;
    e.cur_mi          = u.root;
    e.b               = ?b;
    e.tt              = ?tt;
    e.fns             = nil;
    e.fn_len          = 0;
    e.gls             = nil;
    e.gl_len          = 0;
    e.gvar_ids        = nil;
    e.gtype_ids       = nil;
    e.gstorage        = nil;
    e.iface_len       = 0;
    e.gslot           = nil;
    e.iface_use       = nil;
    e.zero_lid        = 0;
    e.gaccess         = nil;
    e.pacc            = nil;
    e.pbase           = nil;
    e.pacc_len        = 0;
    e.rsum            = nil;
    e.rptr            = nil;
    e.sum_grew        = false;
    e.copies          = vector.init[Copy](out_alloc);
    e.keys            = vector.init[u32](out_alloc);
    e.cur_copy        = COPY_NONE;
    e.cur_pslot       = nil;
    e.cur_params      = nil;
    e.gspec           = nil;
    e.wg_builtin      = false;
    e.vulkan_mm       = spirv.vulkan_memory_model(tgt.model.extensions);
    e.pscope          = vector.init[u8](out_alloc);
    e.coherent_images = false;
    e.physical        = false;
    e.palign          = vector.init[u32](out_alloc);
    e.talign          = vector.init[u32](out_alloc);
    e.tsize           = vector.init[u32](out_alloc);
    e.pkeys           = vector.init[PhysKey](out_alloc);
    e.precs           = vector.init[PhysRec](out_alloc);
    e.strided         = vector.init[u32](out_alloc);
    e.has_held        = false;
    var xi: u32 = 0;
    for (xi < 8) {
        e.ext_ids[xi] = 0;
        xi            = xi + 1;
    }
    e.srcmap     = mirmod.srcmap;
    e.diags      = mirmod.diags;
    e.dbg        = dbgm.init(dbg, ?b, out_alloc, e.interner, e.srcmap);
    e.cur_fn     = nil;
    e.cur_instr  = nil;
    e.fn_stages  = nil;
    e.cur_stages = 0;

    e.has_entry = false;
    var si: u32 = 0;
    for (si < irmod.function_len) {
        if (irmod.functions[si].stage != ir.STAGE_NONE
            && (irmod.functions[si].flags & ir.FN_FLAG_EXTERN) == 0) { e.has_entry = true; }
        si = si + 1;
    }

    val tr: err[fail.Fail] = build_fn_table(?e);
    if (sel tr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret tr;
    }

    val rr: err[fail.Fail] = mark_emitted(?e);
    if (sel rr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret rr;
    }

    val vr: err[fail.Fail] = select_version(?e);
    if (sel vr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret vr;
    }

    val gtr: err[fail.Fail] = build_gl_table(?e);
    if (sel gtr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret gtr;
    }

    val wr: err[fail.Fail] = build_gl_access(?e);
    if (sel wr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret wr;
    }

    val gr: err[fail.Fail] = declare_interface(?e);
    if (sel gr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret gr;
    }

    val ur: err[fail.Fail] = build_iface_uses(?e);
    if (sel ur.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret ur;
    }

    val cgr: err[fail.Fail] = check_call_graph(?e);
    if (sel cgr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret cgr;
    }

    val fsr: err[fail.Fail] = build_fn_stages(?e);
    if (sel fsr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret fsr;
    }

    val sir: err[fail.Fail] = check_stage_interfaces(?e);
    if (sel sir.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret sir;
    }

    val wgr: err[fail.Fail] = plan_workgroup(?e);
    if (sel wgr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret wgr;
    }

    val pcr: err[fail.Fail] = plan_copies(?e);
    if (sel pcr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret pcr;
    }

    # each function's copies in turn, in the order the function table holds them
    var fi: u32 = 0;
    for (fi < e.fn_len) {
        var ci: u32 = 0;
        for (ci < e.copies.len::u32) {
            if (e.copies.data[ci].fx != fi) {
                ci = ci + 1;
                cnt;
            }
            val fr: err[fail.Fail] = emit_function(?e, ci);
            if (sel fr.err) {
                emit_dnit(?e);
                types.types_dnit(?tt);
                spirv.builder_dnit(?b);
                ret fr;
            }
            ci = ci + 1;
        }
        fi = fi + 1;
    }
    emit_dnit(?e);

    val cr: err[fail.Fail] = check_environment(?e);
    if (sel cr.err) {
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret cr;
    }
    emit_preamble(?e);

    var len: u32                 = 0;
    val rs:  res[*u8, fail.Fail] = spirv.serialize(?b, ?len);
    types.types_dnit(?tt);
    spirv.builder_dnit(?b);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    ret install_module(image, rs.ok, len);
}

# the finished module is the image's one section; the image owns its bytes from here
fun install_module(image: *of.ObjectImage, bytes: *u8, len: u32) err[fail.Fail] {
    val name: res[intern.StrId, A.Error] = intern.intern(image.interner, spirv.SPV_MODULE_SECTION);
    if (sel name.err) {
        if (bytes != nil && len > 0) { A.deallocate[u8](image.alloc, bytes, len::usize); }
        ret err[fail.Fail].err{fail.refused(name.err)};
    }
    var sec: of.Section;
    sec.name  = name.ok;
    sec.kind  = of.SK_TEXT;
    sec.bytes = bytes;
    sec.len   = len;
    sec.align = 4;
    sec.flags = 0;
    val installed: res[u32, fail.Fail] = of.section_install(image, ?sec);
    if (sel installed.err) { ret err[fail.Fail].err{installed.err}; }
    ret err[fail.Fail].ok{};
}

fun emit_dnit(e: *Emit) {
    if (e.fn_stages != nil && e.fn_len > 0) { A.deallocate[u8](e.alloc, e.fn_stages, e.fn_len::usize); }
    e.fn_stages = nil;
    if (e.iface_use != nil && e.fn_len > 0 && e.iface_len > 0) {
        A.deallocate[u8](e.alloc, e.iface_use, (e.fn_len * e.iface_len)::usize);
    }
    e.iface_use = nil;
    e.iface_len = 0;
    if (e.pbase != nil && e.fn_len > 0) { A.deallocate[u32](e.alloc, e.pbase, e.fn_len::usize); }
    e.pbase = nil;
    if (e.rsum != nil && e.fn_len > 0) { A.deallocate[u32](e.alloc, e.rsum, e.fn_len::usize); }
    e.rsum = nil;
    if (e.rptr != nil && e.fn_len > 0) { A.deallocate[u32](e.alloc, e.rptr, e.fn_len::usize); }
    e.rptr = nil;
    if (e.fns != nil && e.fn_len > 0) { A.deallocate[FnEnt](e.alloc, e.fns, e.fn_len::usize); }
    e.fns    = nil;
    e.fn_len = 0;
    if (e.gvar_ids != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gvar_ids, e.gl_len::usize);
    }
    e.gvar_ids = nil;
    if (e.gslot != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gslot, e.gl_len::usize);
    }
    e.gslot = nil;
    if (e.gtype_ids != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gtype_ids, e.gl_len::usize);
    }
    e.gtype_ids = nil;
    if (e.gstorage != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gstorage, e.gl_len::usize);
    }
    e.gstorage = nil;
    if (e.gaccess != nil && e.gl_len > 0) {
        A.deallocate[u8](e.alloc, e.gaccess, e.gl_len::usize);
    }
    e.gaccess = nil;
    if (e.pacc != nil && e.pacc_len > 0) { A.deallocate[u8](e.alloc, e.pacc, e.pacc_len::usize); }
    e.pacc     = nil;
    e.pacc_len = 0;
    vector.dnit[Copy](?e.copies);
    vector.dnit[u32](?e.keys);
    vector.dnit[u8](?e.pscope);
    vector.dnit[u32](?e.palign);
    vector.dnit[u32](?e.talign);
    vector.dnit[u32](?e.tsize);
    vector.dnit[PhysKey](?e.pkeys);
    vector.dnit[PhysRec](?e.precs);
    vector.dnit[u32](?e.strided);
    if (e.gspec != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gspec, e.gl_len::usize);
    }
    e.gspec = nil;
    if (e.gls != nil && e.gl_len > 0) { A.deallocate[GlobalEnt](e.alloc, e.gls, e.gl_len::usize); }
    e.gls    = nil;
    e.gl_len = 0;
}

fun build_fn_table(e: *Emit) err[fail.Fail] {
    var n:  u32 = 0;
    var mi: u32 = 0;
    for (mi < e.u.len) {
        val m: *ir.Module = e.u.mods[mi].ir;
        var i: u32        = 0;
        for (i < m.function_len) {
            if ((m.functions[i].flags & ir.FN_FLAG_EXTERN) == 0) { n = n + 1; }
            i = i + 1;
        }
        mi = mi + 1;
    }
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val rt: res[*FnEnt, A.Error] = A.allocate[FnEnt](e.alloc, n::usize);
    if (sel rt.err) { ret err[fail.Fail].err{fail.refused(rt.err)}; }
    e.fns    = rt.ok;
    e.fn_len = n;

    var k:    u32 = 0;
    var pass: u32 = 0;
    for (pass < 2) {
        mi = 0;
        for (mi < e.u.len) {
            val is_root: bool = mi == e.u.root;
            if ((pass == 0) != is_root) {
                mi = mi + 1;
                cnt;
            }
            val m: *ir.Module = e.u.mods[mi].ir;
            var i: u32        = 0;
            for (i < m.function_len) {
                if ((m.functions[i].flags & ir.FN_FLAG_EXTERN) != 0) {
                    i = i + 1;
                    cnt;
                }
                e.fns[k].mi     = mi;
                e.fns[k].ir_ix  = i;
                e.fns[k].name   = m.functions[i].name;
                e.fns[k].mir_ix = unit.mir_index(e.u, mi, m.functions[i].name);
                e.fns[k].id     = 0;
                e.fns[k].emit   = false;
                k               = k + 1;
                i               = i + 1;
            }
            mi = mi + 1;
        }
        pass = pass + 1;
    }
    ret err[fail.Fail].ok{};
}

fun mark_emitted(e: *Emit) err[fail.Fail] {
    if (e.fn_len == 0) { ret err[fail.Fail].ok{}; }

    var i: u32 = 0;
    for (i < e.fn_len) {
        if (fn_is_seed(e, i) && emittable(e, i)) { e.fns[i].emit = true; }
        i = i + 1;
    }

    var changed: bool = true;
    for (changed) {
        changed = false;
        i       = 0;
        for (i < e.fn_len) {
            if (!e.fns[i].emit) {
                i = i + 1;
                cnt;
            }
            var ci: u32 = 0;
            for (ci < callee_count(e, i)) {
                val cx: u32 = callee_at(e, i, ci);
                if (cx != FN_NONE && !e.fns[cx].emit && emittable(e, cx)) {
                    e.fns[cx].emit = true;
                    changed        = true;
                }
                ci = ci + 1;
            }
            i = i + 1;
        }
    }

    i = 0;
    for (i < e.fn_len) {
        if (e.fns[i].emit) { e.fns[i].id = spirv.alloc_id(e.b); }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a function the module holds for its own sake: a stage, or with no stage any
# function of the root module, exported for a linker
fun fn_is_seed(e: *Emit, ix: u32) bool {
    if (e.fns[ix].mi != e.u.root) { ret false; }
    if (e.has_entry)              { ret fn_ir(e, ix).stage != ir.STAGE_NONE; }
    ret true;
}

fun emittable(e: *Emit, ix: u32) bool {
    val fn: *ir.Function = fn_ir(e, ix);
    if (fn.op_set != defs.SPV_SET_NONE) { ret false; }
    val mf: *mir.MirFunction = fn_mir(e, ix);
    if (mf == nil || mf.block_count == 0) { ret false; }
    ret true;
}

fun callee_count(e: *Emit, ix: u32) u32 {
    val mf: *mir.MirFunction = fn_mir(e, ix);
    if (mf == nil) { ret 0; }
    var n:  u32 = 0;
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            if (blk.instrs[ii].opcode == mir.MIR_VALUE_CALL) { n = n + 1; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret n;
}

fun callee_at(e: *Emit, ix: u32, k: u32) u32 {
    val mf: *mir.MirFunction = fn_mir(e, ix);
    if (mf == nil) { ret FN_NONE; }
    var n:  u32 = 0;
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mi.opcode == mir.MIR_VALUE_CALL) {
                if (n == k) {
                    if (mi.operand_count < 1 || mi.operands[0].kind != mir.MIR_OP_SYM) { ret FN_NONE; }
                    ret fn_lookup(e, mi.operands[0].sym);
                }
                n = n + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret FN_NONE;
}

fun fn_lookup(e: *Emit, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < e.fn_len) {
        if (e.fns[i].name == name) { ret i; }
        i = i + 1;
    }
    ret FN_NONE;
}

fun fn_ir(e: *Emit, ix: u32) *ir.Function {
    ret ?e.u.mods[e.fns[ix].mi].ir.functions[e.fns[ix].ir_ix];
}

fun fn_mod(e: *Emit, ix: u32) *ir.Module {
    ret e.u.mods[e.fns[ix].mi].ir;
}

fun fn_mir(e: *Emit, ix: u32) *mir.MirFunction {
    if (e.fns[ix].mir_ix == FN_NONE) { ret nil; }
    ret ?e.u.mods[e.fns[ix].mi].mir.functions[e.fns[ix].mir_ix];
}

# the copies this module emits: each seed's own, then every one a planned copy's
# calls ask for, keyed by how each call binds the callee's pointer parameters. the
# call graph is acyclic by now, so the set is finite (#4278)
fun plan_copies(e: *Emit) err[fail.Fail] {
    var fx: u32 = 0;
    for (fx < e.fn_len) {
        if (e.fns[fx].emit && fn_is_seed(e, fx)) {
            val at: u32 = e.keys.len::u32;
            val n:  u32 = fn_ir(e, fx).param_count;
            var k:  u32 = 0;
            for (k < n) {
                var bind: u32 = BIND_VALUE;
                if (param_is_pointer(e, fx, k)) { bind = BIND_WHOLE; }
                val pr: res[usize, A.Error] = vector.push[u32](?e.keys, bind);
                if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
                k = k + 1;
            }
            val ar: res[u32, fail.Fail] = add_copy(e, fx, at);
            if (sel ar.err) { ret err[fail.Fail].err{ar.err}; }
        }
        fx = fx + 1;
    }

    var ad: Addr = addr_init(e);
    fin { vector.dnit[AddrStep](?ad.steps); }
    var cx: u32 = 0;
    for (cx < e.copies.len::u32) {
        val r: err[fail.Fail] = plan_calls(e, cx, ?ad);
        if (sel r.err) { ret r; }
        cx = cx + 1;
    }
    ret err[fail.Fail].ok{};
}

fun addr_init(e: *Emit) Addr {
    var ad: Addr;
    ad.root    = 0;
    ad.gix     = GL_NONE;
    ad.vreg    = mir.MIR_VREG_NIL.n;
    ad.param   = 0;
    ad.root_mi = 0;
    ad.root_ty = type.IRT_NIL;
    ad.cur_mi  = 0;
    ad.cur_ty  = type.IRT_NIL;
    ad.steps   = vector.init[AddrStep](e.alloc);
    ret ad;
}

fun plan_calls(e: *Emit, cx: u32, ad: *Addr) err[fail.Fail] {
    val fx: u32              = e.copies.data[cx].fx;
    val mf: *mir.MirFunction = fn_mir(e, fx);
    if (mf == nil) { ret err[fail.Fail].ok{}; }
    # which pointer arguments are physical, from where the copy's registers point
    val saved: *ir.Module = e.ir;
    e.ir = fn_mod(e, fx);
    fin { e.ir = saved; }
    val n:  u32               = mf.vreg_count;
    val rp: res[*u8, A.Error] = A.allocate[u8](e.alloc, (n + 1)::usize);
    if (sel rp.err) { ret err[fail.Fail].err{fail.refused(rp.err)}; }
    val prov: *u8 = rp.ok;
    fin { A.deallocate[u8](e.alloc, prov, (n + 1)::usize); }
    classify_pointers(e, cx, mf, prov);
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            ii = ii + 1;
            val gx: u32 = mach_callee(e, fx, mi);
            if (gx == FN_NONE) { cnt; }
            val at: u32                  = e.keys.len::u32;
            val kr: res[bool, fail.Fail] = call_key(e, cx, mf, mi, gx, ad, prov, n);
            if (sel kr.err) { ret err[fail.Fail].err{kr.err}; }
            # a call the emitter refuses asks for no copy
            if (!kr.ok) {
                e.keys.len = at::usize;
                cnt;
            }
            val ar: res[u32, fail.Fail] = add_copy(e, gx, at);
            if (sel ar.err) { ret err[fail.Fail].err{ar.err}; }
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

# the emitted function a call's body is, FN_NONE for an `op`, an import or a callee with no body here
fun mach_callee(e: *Emit, fx: u32, mi: *mir.MirInstr) u32 {
    if (mi.opcode != mir.MIR_VALUE_CALL || mi.operand_count < 2) { ret FN_NONE; }
    if (mi.operands[0].kind != mir.MIR_OP_SYM)                   { ret FN_NONE; }
    val xfn: *ir.Function = ir_function_record(fn_mod(e, fx), mi.operands[0].sym);
    if (xfn != nil && (xfn.op_set != defs.SPV_SET_NONE || xfn.is_import)) { ret FN_NONE; }
    val gx: u32 = fn_lookup(e, mi.operands[0].sym);
    if (gx == FN_NONE || !e.fns[gx].emit) { ret FN_NONE; }
    ret gx;
}

fun param_is_handle(e: *Emit, fx: u32, k: u32) bool {
    val fn: *ir.Function = fn_ir(e, fx);
    if (k >= fn.param_count) { ret false; }
    val t: opt[*type.IrType] = type.get(?fn_mod(e, fx).types, fn.params[k].ty);
    if (sel t.none) { ret false; }
    ret t.some.kind == type.IRT_HANDLE;
}

fun param_is_pointer(e: *Emit, fx: u32, k: u32) bool {
    val fn: *ir.Function = fn_ir(e, fx);
    if (k >= fn.param_count) { ret false; }
    val t: opt[*type.IrType] = type.get(?fn_mod(e, fx).types, fn.params[k].ty);
    if (sel t.none) { ret false; }
    ret t.some.kind == type.IRT_PTR;
}

# the copy of `fx` keyed by the words from `at` to the end of `keys`: an existing one,
# whose key is then dropped, or a new one, the function's first taking its reserved id
fun add_copy(e: *Emit, fx: u32, at: u32) res[u32, fail.Fail] {
    val found: u32 = find_copy(e, fx, at);
    if (found != COPY_NONE) {
        e.keys.len = at::usize;
        ret res[u32, fail.Fail].ok{found};
    }
    var first: bool = true;
    var c:     u32  = 0;
    for (c < e.copies.len::u32 && first) {
        first = e.copies.data[c].fx != fx;
        c     = c + 1;
    }
    var id: u32 = e.fns[fx].id;
    if (!first) { id = spirv.alloc_id(e.b); }
    var cp: Copy;
    cp.fx      = fx;
    cp.id      = id;
    cp.key_at  = at;
    cp.key_len = e.keys.len::u32 - at;
    val pr: res[usize, A.Error] = vector.push[Copy](?e.copies, cp);
    if (sel pr.err) { ret res[u32, fail.Fail].err{fail.refused(pr.err)}; }
    ret res[u32, fail.Fail].ok{pr.ok::u32};
}

fun find_copy(e: *Emit, fx: u32, at: u32) u32 {
    val len: u32 = e.keys.len::u32 - at;
    var c:   u32 = 0;
    for (c < e.copies.len::u32) {
        val cp: *Copy = ?e.copies.data[c];
        if (cp.fx == fx && cp.key_len == len) {
            var i:    u32  = 0;
            var same: bool = true;
            for (i < len && same) {
                same = e.keys.data[cp.key_at + i] == e.keys.data[at + i];
                i    = i + 1;
            }
            if (same) { ret c; }
        }
        c = c + 1;
    }
    ret COPY_NONE;
}

# whether every pointer parameter of the copy is a whole object, the shape its source declares
fun copy_is_primary(e: *Emit, cx: u32) bool {
    val cp: *Copy = ?e.copies.data[cx];
    var i:  u32   = 0;
    for (i < cp.key_len) {
        val w: u32 = e.keys.data[cp.key_at + i];
        if (w != BIND_VALUE && w != BIND_WHOLE) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the offset in `keys` of the binding of source parameter `k` in the key at `at`
fun key_param(e: *Emit, at: u32, k: u32) u32 {
    var p: u32 = at;
    var i: u32 = 0;
    for (i < k) {
        p = p + binding_len(e, p);
        i = i + 1;
    }
    ret p;
}

fun binding_len(e: *Emit, p: u32) u32 {
    val bind: u32 = e.keys.data[p];
    if (bind == BIND_GLOBAL) { ret 3 + e.keys.data[p + 2]; }
    if (bind == BIND_LOCAL)  { ret 4 + e.keys.data[p + 3]; }
    ret 1;
}

# where a binding's steps begin and how many there are
fun binding_steps(e: *Emit, p: u32, out_n: *u32) u32 {
    val bind: u32 = e.keys.data[p];
    @out_n = 0;
    if (bind == BIND_GLOBAL) {
        @out_n = e.keys.data[p + 2];
        ret p + 3;
    }
    if (bind == BIND_LOCAL) {
        @out_n = e.keys.data[p + 3];
        ret p + 4;
    }
    ret p + 1;
}

# how many SPIR-V parameters a binding takes: its root when passed, then its runtime indices
fun binding_arity(e: *Emit, p: u32) u32 {
    val bind: u32 = e.keys.data[p];
    if (bind == BIND_VALUE || bind == BIND_WHOLE || bind == BIND_PHYSICAL) { ret 1; }
    var n:    u32 = 0;
    val from: u32 = binding_steps(e, p, ?n);
    var r:    u32 = 0;
    if (bind == BIND_LOCAL) { r = 1; }
    var i: u32 = 0;
    for (i < n) {
        if (e.keys.data[from + i] == STEP_RUNTIME) { r = r + 1; }
        i = i + 1;
    }
    ret r;
}

# appends the key a call gives its callee `gx` to `keys`; false when a pointer argument
# addresses nothing one path can name, a call the emitter refuses
fun call_key(e: *Emit, cx: u32, mf: *mir.MirFunction, mi: *mir.MirInstr, gx: u32, ad: *Addr,
    prov: *u8, nv: u32) res[bool, fail.Fail] {
    val n: u32 = fn_ir(e, gx).param_count;
    if (n != mi.operand_count - 2) { ret res[bool, fail.Fail].ok{false}; }
    var k: u32 = 0;
    for (k < n) {
        if (!param_is_pointer(e, gx, k)) {
            val pr: res[usize, A.Error] = vector.push[u32](?e.keys, BIND_VALUE);
            if (sel pr.err) { ret res[bool, fail.Fail].err{fail.refused(pr.err)}; }
            k = k + 1;
            cnt;
        }
        # a physical pointer is passed as the value it is (#4307)
        val pv: u8 = prov_of(prov, nv, ?mi.operands[k + 2]);
        if ((pv & (PROV_LOGICAL | PROV_PHYSICAL)) == PROV_PHYSICAL) {
            val pr: res[usize, A.Error] = vector.push[u32](?e.keys, BIND_PHYSICAL);
            if (sel pr.err) { ret res[bool, fail.Fail].err{fail.refused(pr.err)}; }
            k = k + 1;
            cnt;
        }
        val tr: res[bool, fail.Fail] = trace_address(e, cx, mf, ?mi.operands[k + 2], ad);
        if (sel tr.err) { ret tr; }
        if (!tr.ok)     { ret tr; }
        val er: err[fail.Fail] = push_binding(e, ad);
        if (sel er.err) { ret res[bool, fail.Fail].err{er.err}; }
        k = k + 1;
    }
    ret res[bool, fail.Fail].ok{true};
}

fun push_binding(e: *Emit, ad: *Addr) err[fail.Fail] {
    val n: u32 = ad.steps.len::u32;
    if (ad.root != ROOT_GLOBAL && n == 0) { ret push_key(e, BIND_WHOLE); }
    if (ad.root == ROOT_GLOBAL) {
        val r0: err[fail.Fail] = push_key(e, BIND_GLOBAL);
        if (sel r0.err) { ret r0; }
        val r1: err[fail.Fail] = push_key(e, ad.gix);
        if (sel r1.err) { ret r1; }
    }
    or {
        val r0: err[fail.Fail] = push_key(e, BIND_LOCAL);
        if (sel r0.err) { ret r0; }
        val r1: err[fail.Fail] = push_key(e, ad.root_mi);
        if (sel r1.err) { ret r1; }
        val r2: err[fail.Fail] = push_key(e, ad.root_ty::u32);
        if (sel r2.err) { ret r2; }
    }
    val rn: err[fail.Fail] = push_key(e, n);
    if (sel rn.err) { ret rn; }
    var i: u32 = 0;
    for (i < n) {
        val rs: err[fail.Fail] = push_key(e, ad.steps.data[i].ord);
        if (sel rs.err) { ret rs; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun push_key(e: *Emit, w: u32) err[fail.Fail] {
    val pr: res[usize, A.Error] = vector.push[u32](?e.keys, w);
    if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
    ret err[fail.Fail].ok{};
}

# follows a pointer operand of copy `cx` back to its root: a global, a local
# allocation or a parameter's object, through the chains and copies that
# derive it; false when no single definition names it
fun trace_address(e: *Emit, cx: u32, mf: *mir.MirFunction, op: *mir.MirOperand, ad: *Addr) res[bool, fail.Fail] {
    ad.root      = 0;
    ad.steps.len = 0;
    ret trace_from(e, cx, mf, op, ad);
}

fun trace_from(e: *Emit, cx: u32, mf: *mir.MirFunction, op: *mir.MirOperand, ad: *Addr) res[bool, fail.Fail] {
    if (op.kind == mir.MIR_OP_SYM) {
        if (op.sym_off != 0) { ret res[bool, fail.Fail].ok{false}; }
        val gx: u32 = gl_lookup(e, op.sym);
        if (gx == GL_NONE || e.gvar_ids == nil || e.gvar_ids[gx] == 0) { ret res[bool, fail.Fail].ok{false}; }
        ad.root   = ROOT_GLOBAL;
        ad.gix    = gx;
        ad.cur_mi = e.gls[gx].mi;
        ad.cur_ty = gl_ir(e, gx).ty;
        ret res[bool, fail.Fail].ok{true};
    }
    var v: u32 = mir.MIR_VREG_NIL.n;
    if (op.kind == mir.MIR_OP_VREG)               { v = op.vreg.n; }
    or (op.kind == mir.MIR_OP_MEM && op.imm == 0) { v = op.vreg.n; }
    if (v == mir.MIR_VREG_NIL.n)                  { ret res[bool, fail.Fail].ok{false}; }
    val def: *mir.MirInstr = address_def(mf, v);
    if (def == nil) { ret res[bool, fail.Fail].ok{false}; }
    val fx: u32 = e.copies.data[cx].fx;

    if (def.opcode == mir.MIR_ALLOCA) {
        if (def.operand_count < 2) { ret res[bool, fail.Fail].ok{false}; }
        val slot: *mir.MirSlot = find_slot(mf, def.operands[1].vreg.n);
        if (slot == nil || slot.ty == mir.SLOT_TY_NIL) { ret res[bool, fail.Fail].ok{false}; }
        ad.root    = ROOT_ALLOCA;
        ad.vreg    = v;
        ad.root_mi = e.fns[fx].mi;
        ad.root_ty = slot.ty::type.IrTypeId;
        ad.cur_mi  = ad.root_mi;
        ad.cur_ty  = ad.root_ty;
        ret res[bool, fail.Fail].ok{true};
    }
    if (is_reg_copy(def)) {
        if (def.operands[1].kind != mir.MIR_OP_VREG) { ret res[bool, fail.Fail].ok{false}; }
        ret trace_from(e, cx, mf, ?def.operands[1], ad);
    }
    if (def.opcode == mir.MIR_GEP) {
        if (def.operand_count < 3 || def.operands[2].kind != mir.MIR_OP_IMM || def.operands[2].imm != 0) {
            ret res[bool, fail.Fail].ok{false};
        }
        val br: res[bool, fail.Fail] = trace_from(e, cx, mf, ?def.operands[1], ad);
        if (sel br.err) { ret br; }
        if (!br.ok)     { ret br; }
        var k: u32 = 3;
        for (k < def.operand_count) {
            val ix: *mir.MirOperand = ?def.operands[k];
            var st: AddrStep;
            st.ord        = STEP_RUNTIME;
            st.from_param = false;
            st.a          = v;
            st.b          = k - 3;
            if (ix.kind != mir.MIR_OP_IMM && ix.kind != mir.MIR_OP_VREG)                  { ret res[bool, fail.Fail].ok{false}; }
            if (ix.kind == mir.MIR_OP_IMM && (ix.imm < 0 || ix.imm >= STEP_RUNTIME::i64)) { ret res[bool, fail.Fail].ok{false}; }
            # an element index, constant or not, is passed; a member ordinal is part of the key
            val tys: *type.IrTypeTable = ?e.u.mods[ad.cur_mi].ir.types;
            val to:  opt[*type.IrType] = type.get(tys, ad.cur_ty);
            if (sel to.none)                    { ret res[bool, fail.Fail].ok{false}; }
            if (to.some.kind == type.IRT_ARRAY) { ad.cur_ty = to.some.data.array_.element; }
            or {
                if (ix.kind != mir.MIR_OP_IMM) { ret res[bool, fail.Fail].ok{false}; }
                st.ord    = ix.imm::u32;
                ad.cur_ty = ir_member_type(tys, to.some, ad.cur_ty, st.ord);
            }
            val pr: res[usize, A.Error] = vector.push[AddrStep](?ad.steps, st);
            if (sel pr.err) { ret res[bool, fail.Fail].err{fail.refused(pr.err)}; }
            k = k + 1;
        }
        ret res[bool, fail.Fail].ok{true};
    }
    if (def.opcode == mir.MIR_VALUE_PARAM) {
        if (def.operand_count != 2 || def.operands[1].kind != mir.MIR_OP_IMM || def.operands[1].imm < 0
            || def.operands[1].imm >= fn_ir(e, fx).param_count::i64) {
            ret res[bool, fail.Fail].ok{false};
        }
        val k:    u32 = def.operands[1].imm::u32;
        val p:    u32 = key_param(e, e.copies.data[cx].key_at, k);
        val bind: u32 = e.keys.data[p];
        if (bind == BIND_VALUE) { ret res[bool, fail.Fail].ok{false}; }
        val fn: *ir.Function      = fn_ir(e, fx);
        val t:  opt[*type.IrType] = type.get(?fn_mod(e, fx).types, fn.params[k].ty);
        if (sel t.none) { ret res[bool, fail.Fail].ok{false}; }
        # whatever the binding, what the parameter points at is its declared pointee
        ad.cur_mi = e.fns[fx].mi;
        ad.cur_ty = t.some.data.pointee;
        if (bind == BIND_WHOLE) {
            ad.root    = ROOT_PARAM;
            ad.param   = k;
            ad.root_mi = e.fns[fx].mi;
            ad.root_ty = t.some.data.pointee;
            ret res[bool, fail.Fail].ok{true};
        }
        if (bind == BIND_GLOBAL) {
            ad.root = ROOT_GLOBAL;
            ad.gix  = e.keys.data[p + 1];
        }
        or {
            ad.root    = ROOT_PARAM;
            ad.param   = k;
            ad.root_mi = e.keys.data[p + 1];
            ad.root_ty = e.keys.data[p + 2]::type.IrTypeId;
        }
        var n:    u32 = 0;
        val from: u32 = binding_steps(e, p, ?n);
        var j:    u32 = 0;
        var i:    u32 = 0;
        for (i < n) {
            var st: AddrStep;
            st.ord        = e.keys.data[from + i];
            st.from_param = true;
            st.a          = k;
            st.b          = j;
            if (st.ord == STEP_RUNTIME) { j = j + 1; }
            val pr: res[usize, A.Error] = vector.push[AddrStep](?ad.steps, st);
            if (sel pr.err) { ret res[bool, fail.Fail].err{fail.refused(pr.err)}; }
            i = i + 1;
        }
        ret res[bool, fail.Fail].ok{true};
    }
    ret res[bool, fail.Fail].ok{false};
}

# the type member `ord` of a composite `t` (id `id`) has, IRT_NIL where no further step can follow
fun ir_member_type(tys: *type.IrTypeTable, t: *type.IrType, id: type.IrTypeId, ord: u32) type.IrTypeId {
    if (t.kind == type.IRT_STRUCT) {
        if (ord >= t.data.struct_.field_count) { ret type.IRT_NIL; }
        ret t.data.struct_.fields[ord];
    }
    if (t.kind == type.IRT_VECTOR) { ret t.data.vector_.element; }
    # a tag's member 0 is its discriminator, and member 1 + c case c's payload
    if (t.kind == type.IRT_TAG && ord > 0 && ord <= type.tag_case_count(tys, id)
        && type.tag_case_has_payload(tys, id, ord - 1)) {
        ret type.tag_case_type(tys, id, ord - 1);
    }
    ret type.IRT_NIL;
}

# the one instruction that defines `v`, nil when none or several do
fun address_def(mf: *mir.MirFunction, v: u32) *mir.MirInstr {
    var found: *mir.MirInstr = nil;
    var bi:    u32           = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (instr_defines_vreg(mi, v)) {
                if (found != nil) { ret nil; }
                found = mi;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret found;
}

fun instr_defines_vreg(mi: *mir.MirInstr, v: u32) bool {
    val op: mir.MirOpcode = mi.opcode;
    if (op == mir.MIR_VALUE_CALL) {
        ret mi.operand_count >= 2 && mi.operands[1].kind == mir.MIR_OP_VREG && mi.operands[1].vreg.n == v;
    }
    if (op == mir.MIR_VALUE_PARAM) {
        ret mi.operand_count >= 1 && mi.operands[0].kind == mir.MIR_OP_VREG && mi.operands[0].vreg.n == v;
    }
    # these name the memory they write first, and define nothing
    if (op == mir.MIR_STORE || op == mir.MIR_MEMCPY || op == mir.MIR_MEMZERO) { ret false; }
    ret mir.instr_defines_shape(mi) && mi.operands[0].kind == mir.MIR_OP_VREG && mi.operands[0].vreg.n == v;
}

fun build_gl_table(e: *Emit) err[fail.Fail] {
    var n:  u32 = 0;
    var i0: u32 = 0;
    for (i0 < e.root.global_len) {
        if (gl_eligible(?e.root.globals[i0])) { n = n + 1; }
        i0 = i0 + 1;
    }
    var mi: u32 = 0;
    for (mi < e.u.len) {
        if (mi == e.u.root) {
            mi = mi + 1;
            cnt;
        }
        val m: *ir.Module = e.u.mods[mi].ir;
        var i: u32        = 0;
        for (i < m.global_len) {
            if (gl_eligible(?m.globals[i]) && global_is_reached(e, m.globals[i].name)) { n = n + 1; }
            i = i + 1;
        }
        mi = mi + 1;
    }
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val rt: res[*GlobalEnt, A.Error] = A.allocate[GlobalEnt](e.alloc, n::usize);
    if (sel rt.err) { ret err[fail.Fail].err{fail.refused(rt.err)}; }
    e.gls    = rt.ok;
    e.gl_len = n;

    var k:  u32 = 0;
    var i2: u32 = 0;
    for (i2 < e.root.global_len) {
        if (!gl_eligible(?e.root.globals[i2])) {
            i2 = i2 + 1;
            cnt;
        }
        e.gls[k].mi    = e.u.root;
        e.gls[k].ir_ix = i2;
        e.gls[k].name  = e.root.globals[i2].name;
        k              = k + 1;
        i2             = i2 + 1;
    }
    mi = 0;
    for (mi < e.u.len) {
        if (mi == e.u.root) {
            mi = mi + 1;
            cnt;
        }
        val m: *ir.Module = e.u.mods[mi].ir;
        var i: u32        = 0;
        for (i < m.global_len) {
            if (!gl_eligible(?m.globals[i]) || !global_is_reached(e, m.globals[i].name)) {
                i = i + 1;
                cnt;
            }
            e.gls[k].mi    = mi;
            e.gls[k].ir_ix = i;
            e.gls[k].name  = m.globals[i].name;
            k              = k + 1;
            i              = i + 1;
        }
        mi = mi + 1;
    }
    ret err[fail.Fail].ok{};
}

val ACCESS_WRITE: u8 = 1;
val ACCESS_READ:  u8 = 2;

# a parameter's origin, beside a global's index
val ORIGIN_PARAM: u32 = 0x80000000;
# a handle of no single root: one a function returns from more than one, all of
# them read and written, which leaves nothing to mark through it
val ORIGIN_UNKNOWN: u32 = 0xFFFFFFFE;
# a function that returns a handle naming no binding
val ORIGIN_UNROOTED: u32 = 0xFFFFFFFD;

fun build_gl_access(e: *Emit) err[fail.Fail] {
    if (e.gl_len == 0 || e.fn_len == 0) { ret err[fail.Fail].ok{}; }
    val rw: res[*u8, A.Error] = A.allocate[u8](e.alloc, e.gl_len::usize);
    if (sel rw.err) { ret err[fail.Fail].err{fail.refused(rw.err)}; }
    e.gaccess = rw.ok;
    var i: u32 = 0;
    for (i < e.gl_len) {
        e.gaccess[i] = 0;
        i            = i + 1;
    }

    val rb: res[*u32, A.Error] = A.allocate[u32](e.alloc, e.fn_len::usize);
    if (sel rb.err) { ret err[fail.Fail].err{fail.refused(rb.err)}; }
    e.pbase = rb.ok;
    val rr: res[*u32, A.Error] = A.allocate[u32](e.alloc, e.fn_len::usize);
    if (sel rr.err) { ret err[fail.Fail].err{fail.refused(rr.err)}; }
    e.rsum = rr.ok;
    val rq: res[*u32, A.Error] = A.allocate[u32](e.alloc, e.fn_len::usize);
    if (sel rq.err) { ret err[fail.Fail].err{fail.refused(rq.err)}; }
    e.rptr = rq.ok;
    var total: u32 = 0;
    var fx:    u32 = 0;
    for (fx < e.fn_len) {
        e.pbase[fx] = total;
        e.rsum[fx]  = GL_NONE;
        e.rptr[fx]  = GL_NONE;
        total       = total + fn_ir(e, fx).param_count;
        fx          = fx + 1;
    }
    if (total > 0) {
        val rp: res[*u8, A.Error] = A.allocate[u8](e.alloc, total::usize);
        if (sel rp.err) { ret err[fail.Fail].err{fail.refused(rp.err)}; }
        e.pacc     = rp.ok;
        e.pacc_len = total;
        i          = 0;
        for (i < total) {
            e.pacc[i] = 0;
            i         = i + 1;
        }
    }

    # a call touches what a pointer argument names as its callee does through the
    # parameter, and its result names what the callee returns, so the scan repeats
    # until no parameter's access or return's root grows; the marks on the globals
    # only grow, so a refusal fires only for an access the program makes
    var again: bool = true;
    for (again) {
        e.sum_grew = false;
        fx         = 0;
        for (fx < e.fn_len) {
            if (!e.fns[fx].emit) {
                fx = fx + 1;
                cnt;
            }
            val mf: *mir.MirFunction = fn_mir(e, fx);
            if (mf == nil) {
                fx = fx + 1;
                cnt;
            }
            val r: err[fail.Fail] = scan_fn_access(e, fx, mf);
            if (sel r.err) { ret r; }
            fx = fx + 1;
        }
        again = e.sum_grew;
    }
    ret err[fail.Fail].ok{};
}

fun scan_fn_access(e: *Emit, fx: u32, mf: *mir.MirFunction) err[fail.Fail] {
    val n:       u32  = mf.vreg_count;
    var origin:  *u32 = nil;
    var horigin: *u32 = nil;
    if (n > 0) {
        val ro: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
        if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
        origin = ro.ok;
        val rh: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
        if (sel rh.err) {
            A.deallocate[u32](e.alloc, origin, n::usize);
            ret err[fail.Fail].err{fail.refused(rh.err)};
        }
        horigin = rh.ok;
        var v: u32 = 0;
        for (v < n) {
            origin[v]  = GL_NONE;
            horigin[v] = GL_NONE;
            v          = v + 1;
        }
    }
    val r: err[fail.Fail] = scan_fn_access_in(e, fx, mf, n, origin, horigin);
    if (origin != nil)  { A.deallocate[u32](e.alloc, origin, n::usize); }
    if (horigin != nil) { A.deallocate[u32](e.alloc, horigin, n::usize); }
    ret r;
}

# `origin` is the global a pointer register points into, `horigin` the handle
# global a register holds the descriptor of
fun scan_fn_access_in(e: *Emit, fx: u32, mf: *mir.MirFunction, n: u32, origin: *u32, horigin: *u32) err[fail.Fail] {
    var hb: u32 = 0;
    for (hb < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[hb];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val g: u32             = descriptor_load(e, ?blk.instrs[ii]);
            val d: *mir.MirOperand = ?blk.instrs[ii].operands[0];
            if (g != GL_NONE && horigin != nil && d.kind == mir.MIR_OP_VREG && d.vreg.n < n) { horigin[d.vreg.n] = g; }
            # a handle parameter holds the descriptor the caller passes
            val pm: *mir.MirInstr = ?blk.instrs[ii];
            if (pm.opcode == mir.MIR_VALUE_PARAM && pm.operand_count == 2 && horigin != nil
                && d.kind == mir.MIR_OP_VREG && d.vreg.n < n && pm.operands[1].kind == mir.MIR_OP_IMM
                && pm.operands[1].imm >= 0 && param_is_handle(e, fx, pm.operands[1].imm::u32)) {
                horigin[d.vreg.n] = ORIGIN_PARAM | pm.operands[1].imm::u32;
            }
            ii = ii + 1;
        }
        hb = hb + 1;
    }

    var changed: bool = true;
    for (changed) {
        changed = false;
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii:  u32           = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                ii = ii + 1;
                # a pointer parameter names what the caller passes
                if (mi.opcode == mir.MIR_VALUE_PARAM && mi.operand_count == 2
                    && mi.operands[0].kind == mir.MIR_OP_VREG && mi.operands[1].kind == mir.MIR_OP_IMM
                    && mi.operands[1].imm >= 0 && param_is_pointer(e, fx, mi.operands[1].imm::u32)) {
                    val pv: u32 = mi.operands[0].vreg.n;
                    if (origin != nil && pv < n && origin[pv] == GL_NONE) {
                        origin[pv] = ORIGIN_PARAM | mi.operands[1].imm::u32;
                        changed    = true;
                    }
                    cnt;
                }
                # an access chain, and an `op` pointer result, point into what their base names
                var dst_at:  u32 = 0;
                var base_at: u32 = 0;
                if (!derived_pointer(e, fx, mi, ?dst_at, ?base_at)) { cnt; }
                if (mi.operands[dst_at].kind != mir.MIR_OP_VREG)    { cnt; }
                val dst: u32 = mi.operands[dst_at].vreg.n;
                if (origin == nil || dst == mir.MIR_VREG_NIL.n || dst >= n) { cnt; }
                val g: u32 = operand_origin(e, origin, n, ?mi.operands[base_at]);
                if (g == GL_NONE || origin[dst] == g) { cnt; }
                if (origin[dst] != GL_NONE) {
                    val ra: err[fail.Fail] = mark_origin(e, fx, mi, origin[dst], ACCESS_WRITE | ACCESS_READ);
                    if (sel ra.err) { ret ra; }
                    val rb: err[fail.Fail] = mark_origin(e, fx, mi, g, ACCESS_WRITE | ACCESS_READ);
                    if (sel rb.err) { ret rb; }
                    cnt;
                }
                origin[dst] = g;
                changed     = true;
            }
            bi = bi + 1;
        }
    }

    # a handle read through a pointer holds the descriptor the pointer names, a
    # call's handle result the one its callee returns, and an `op` handle result
    # the one its row's source operand holds
    var hchanged: bool = horigin != nil;
    for (hchanged) {
        hchanged = false;
        var hp: u32 = 0;
        for (hp < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[hp];
            var ii:  u32           = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                ii = ii + 1;
                var at:  u32 = GL_NONE;
                var d:   u32 = 0;
                var src: u32 = 0;
                if (pointer_handle_load(?fn_mod(e, fx).types, mf, mi)) {
                    at = operand_origin(e, origin, n, ?mi.operands[1]);
                    d  = mi.operands[0].vreg.n;
                }
                or (call_handle_result(e, fx, mf, mi)) {
                    at = call_result_origin(e, fx, mi, n, origin, horigin);
                    d  = mi.operands[1].vreg.n;
                }
                or (derived_handle(e, fx, mf, mi, ?src)) {
                    at = operand_origin(e, horigin, n, ?mi.operands[src]);
                    d  = mi.operands[1].vreg.n;
                }
                or { cnt; }
                if (horigin[d] != at) {
                    horigin[d] = at;
                    hchanged   = true;
                }
            }
            hp = hp + 1;
        }
    }

    # what a returned handle names joins the function's return summary, and the
    # first root a returned pointer names is kept for the refusal of the result
    val rk: type.IrTypeKind = return_kind(e, fx);
    var hr: u32             = 0;
    for (hr < mf.block_count && horigin != nil) {
        val blk: *mir.MirBlock = ?mf.blocks[hr];
        hr = hr + 1;
        if (blk.instr_count == 0) { cnt; }
        val mi: *mir.MirInstr = ?blk.instrs[blk.instr_count - 1];
        if (mi.opcode != mir.MIR_RET || mi.operand_count != 1) { cnt; }
        if (rk == type.IRT_PTR) {
            if (e.rptr[fx] == GL_NONE) { e.rptr[fx] = operand_origin(e, origin, n, ?mi.operands[0]); }
            cnt;
        }
        if (rk != type.IRT_HANDLE) { cnt; }
        val rj: err[fail.Fail] = join_return(e, fx, mi, operand_origin(e, horigin, n, ?mi.operands[0]));
        if (sel rj.err) { ret rj; }
    }

    var bi2: u32 = 0;
    for (bi2 < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi2];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi:  *mir.MirInstr = ?blk.instrs[ii];
            val row: *isa.OpDef    = call_op_row(e, fx, mi);
            # loading a handle reads its descriptor, not the memory it names
            val loads_handle: bool = descriptor_load(e, mi) != GL_NONE || pointer_handle_load(?fn_mod(e, fx).types, mf, mi);
            var oi:           u32  = 0;
            for (oi < mi.operand_count) {
                if (loads_handle) {
                    oi = oi + 1;
                    cnt;
                }
                # a handle operand's memory is touched only as its row's kind says
                if (row != nil && oi >= 2 && isa.op_kind_is_handle(isa.op_operand_kind(row, oi - 2))) {
                    val hg: u32 = operand_origin(e, horigin, n, ?mi.operands[oi]);
                    var hw: u8  = ACCESS_READ;
                    if (isa.op_operand_kind(row, oi - 2) == isa.OP_OPERAND_HANDLE_WRITE) { hw = ACCESS_WRITE; }
                    if (hg == GL_NONE)                                                   { ret err[fail.Fail].err{unrooted_handle(e, mi)}; }
                    if (hg != ORIGIN_UNKNOWN) {
                        val rh: err[fail.Fail] = mark_origin(e, fx, mi, hg, hw);
                        if (sel rh.err) { ret rh; }
                    }
                    oi = oi + 1;
                    cnt;
                }
                # a handle handed to a function has its memory touched as the callee touches it
                # through that parameter, and read and written where no summary says how
                if (row == nil && mi.opcode == mir.MIR_VALUE_CALL && oi >= 2 && mi.operands[oi].kind == mir.MIR_OP_VREG) {
                    val cg: u32 = operand_origin(e, horigin, n, ?mi.operands[oi]);
                    var ch: u8  = ACCESS_WRITE | ACCESS_READ;
                    if (!call_param_access(e, fx, mi, oi, ?ch)) { ch = ACCESS_WRITE | ACCESS_READ; }
                    if (cg == GL_NONE && ch != 0 && handle_vreg(?fn_mod(e, fx).types, mf, ?mi.operands[oi])) {
                        ret err[fail.Fail].err{unrooted_handle(e, mi)};
                    }
                    if (cg != GL_NONE && cg != ORIGIN_UNKNOWN) {
                        val rc: err[fail.Fail] = mark_origin(e, fx, mi, cg, ch);
                        if (sel rc.err) { ret rc; }
                    }
                }
                val g: u32 = operand_origin(e, origin, n, ?mi.operands[oi]);
                if (g == GL_NONE) {
                    oi = oi + 1;
                    cnt;
                }
                var how: u8 = 0;
                if (row != nil) { how = op_operand_access(row, oi); }
                or (!call_param_access(e, fx, mi, oi, ?how)) {
                    if (!operand_only_reads(mi, oi))  { how = how | ACCESS_WRITE; }
                    if (!operand_never_reads(mi, oi)) { how = how | ACCESS_READ; }
                }
                val rm: err[fail.Fail] = mark_origin(e, fx, mi, g, how);
                if (sel rm.err) { ret rm; }
                oi = oi + 1;
            }
            ii = ii + 1;
        }
        bi2 = bi2 + 1;
    }
    ret err[fail.Fail].ok{};
}

# the handle global a load reads the descriptor of, GL_NONE for any other instruction
fun descriptor_load(e: *Emit, mi: *mir.MirInstr) u32 {
    if (mi.opcode != mir.MIR_LOAD || mi.operand_count != 2)                   { ret GL_NONE; }
    if (mi.operands[1].kind != mir.MIR_OP_SYM || mi.operands[1].sym_off != 0) { ret GL_NONE; }
    val g: u32 = gl_lookup(e, mi.operands[1].sym);
    if (g == GL_NONE || !is_image_type(e, gl_types(e, g), gl_ir(e, g).ty)) { ret GL_NONE; }
    ret g;
}

# a load of a handle through a pointer to it rather than from its binding, `@img` of a `*Handle`
fun pointer_handle_load(tys: *type.IrTypeTable, mf: *mir.MirFunction, mi: *mir.MirInstr) bool {
    if (mi.opcode != mir.MIR_LOAD || mi.operand_count != 2)                              { ret false; }
    if (mi.operands[1].kind != mir.MIR_OP_MEM && mi.operands[1].kind != mir.MIR_OP_VREG) { ret false; }
    ret handle_vreg(tys, mf, ?mi.operands[0]);
}

fun handle_vreg(tys: *type.IrTypeTable, mf: *mir.MirFunction, d: *mir.MirOperand) bool {
    if (d.kind != mir.MIR_OP_VREG || d.vreg.n >= mf.vreg_count || mf.vregs[d.vreg.n].ty == mir.VREG_TY_NIL) { ret false; }
    val t: opt[*type.IrType] = type.get(tys, mf.vregs[d.vreg.n].ty);
    ret sel t.some && t.some.kind == type.IRT_HANDLE;
}

# a call to an emitted function that defines a handle result
fun call_handle_result(e: *Emit, fx: u32, mf: *mir.MirFunction, mi: *mir.MirInstr) bool {
    if (mach_callee(e, fx, mi) == FN_NONE) { ret false; }
    ret handle_vreg(?fn_mod(e, fx).types, mf, ?mi.operands[1]);
}

# an `op` call whose handle result is derived from the handle its row names as the
# source, as an `OpSampledImage` holds its image: `out_src` is that operand. an `op`
# handle of no source, or of a source that holds no handle, names no binding
fun derived_handle(e: *Emit, fx: u32, mf: *mir.MirFunction, mi: *mir.MirInstr, out_src: *u32) bool {
    val row: *isa.OpDef = call_op_row(e, fx, mi);
    if (row == nil || row.source == isa.NO_OP_SOURCE || row.source + 2 >= mi.operand_count) { ret false; }
    val tys: *type.IrTypeTable = ?fn_mod(e, fx).types;
    if (!handle_vreg(tys, mf, ?mi.operands[1]) || !handle_vreg(tys, mf, ?mi.operands[row.source + 2])) { ret false; }
    @out_src = row.source + 2;
    ret true;
}

# the root of a call's handle result: what its callee returns, through the argument
# when that is one of its parameters. a callee that returns no handle yet, or more
# than one root, leaves ORIGIN_UNKNOWN, and one returning a handle of no binding GL_NONE
fun call_result_origin(e: *Emit, fx: u32, mi: *mir.MirInstr, n: u32, origin: *u32, horigin: *u32) u32 {
    val gx: u32 = mach_callee(e, fx, mi);
    val s:  u32 = e.rsum[gx];
    if (s == ORIGIN_UNROOTED)                { ret GL_NONE; }
    if (s == GL_NONE || s == ORIGIN_UNKNOWN) { ret ORIGIN_UNKNOWN; }
    if ((s & ORIGIN_PARAM) == 0)             { ret s; }
    val k: u32 = s & ~ORIGIN_PARAM;
    if (k + 2 >= mi.operand_count)  { ret GL_NONE; }
    if (param_is_pointer(e, gx, k)) { ret operand_origin(e, origin, n, ?mi.operands[k + 2]); }
    ret operand_origin(e, horigin, n, ?mi.operands[k + 2]);
}

# joins a returned handle's root into the function's summary. a handle of no binding
# makes every result one, refused where it is read or written. once two roots meet,
# or one of no single root does, every root returned is read and written, since the
# caller can no longer tell which it holds
fun join_return(e: *Emit, fx: u32, mi: *mir.MirInstr, o: u32) err[fail.Fail] {
    val cur: u32 = e.rsum[fx];
    if (cur == ORIGIN_UNROOTED) { ret err[fail.Fail].ok{}; }
    if (o == GL_NONE) {
        e.rsum[fx] = ORIGIN_UNROOTED;
        e.sum_grew = true;
        ret err[fail.Fail].ok{};
    }
    if (cur == o) { ret err[fail.Fail].ok{}; }
    if (cur == GL_NONE && o != ORIGIN_UNKNOWN) {
        e.rsum[fx] = o;
        e.sum_grew = true;
        ret err[fail.Fail].ok{};
    }
    if (cur != GL_NONE && cur != ORIGIN_UNKNOWN) {
        val rc: err[fail.Fail] = mark_origin(e, fx, mi, cur, ACCESS_WRITE | ACCESS_READ);
        if (sel rc.err) { ret rc; }
    }
    if (o != ORIGIN_UNKNOWN) {
        val ro: err[fail.Fail] = mark_origin(e, fx, mi, o, ACCESS_WRITE | ACCESS_READ);
        if (sel ro.err) { ret ro; }
    }
    if (cur != ORIGIN_UNKNOWN) {
        e.rsum[fx] = ORIGIN_UNKNOWN;
        e.sum_grew = true;
    }
    ret err[fail.Fail].ok{};
}

# an image read or written directly whose binding the scan cannot name. sema holds every
# `op` handle result to a source operand, so no source reaches one: it is a compiler defect
fun unrooted_handle(e: *Emit, mi: *mir.MirInstr) fail.Fail {
    ret fail.message(mir.instr_refusal(e.alloc, e.srcmap, refusal_fn_name(e), mi,
        "spirv.emit: an image read or written directly names no binding, though every handle an `op` returns derives from a source operand"));
}

# each confined `op` result is consumed only as an operand of another `op` call later in
# the block that makes it. sema refuses returning one and passing one to a function, so
# what reaches here is a block an operand evaluated after it splits, or a merge
fun confined_flow(e: *Emit, fx: u32, mf: *mir.MirFunction) err[fail.Fail] {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi:  *mir.MirInstr = ?blk.instrs[ii];
            val row: *isa.OpDef    = call_op_row(e, fx, mi);
            if (row != nil && row.confined && mi.operands[1].kind == mir.MIR_OP_VREG && !mir.vreg_is_nil(mi.operands[1].vreg)) {
                val r: err[fail.Fail] = confined_consumers(e, fx, mf, bi, ii, row);
                if (sel r.err) { ret r; }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

# refuses the first consumer of the confined result instruction `di` of block `db` defines
# that is not an operand of an `op` call after it in that block
fun confined_consumers(e: *Emit, fx: u32, mf: *mir.MirFunction, db: u32, di: u32, row: *isa.OpDef) err[fail.Fail] {
    val v:  u32 = mf.blocks[db].instrs[di].operands[1].vreg.n;
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi:      *mir.MirInstr = ?blk.instrs[ii];
            val op_call: bool          = call_op_row(e, fx, mi) != nil;
            var oi:      u32           = 0;
            for (oi < mi.operand_count && !(bi == db && ii == di)) {
                val op: *mir.MirOperand = ?mi.operands[oi];
                oi = oi + 1;
                if (op.kind != mir.MIR_OP_VREG || mir.vreg_is_nil(op.vreg) || op.vreg.n != v) { cnt; }
                if (op_call && oi > 2 && bi == db && ii > di)                                 { cnt; }
                ret err[fail.Fail].err{reject_at(e, dkind.OP_RESULT_FLOW, mir.refusal_loc(mf, mi), confined_flow_text(e, row, op_call && oi > 2))};
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

# why a confined result's consumer is refused: an `op` operand in another block, or anything else
fun confined_flow_text(e: *Emit, row: *isa.OpDef, operand: bool) str {
    var how: str = "reaches something other than an operand of another `op` instruction in its block, such as a return, a call or a merge where control flow joins, which SPIR-V forbids";
    if (operand) { how = "is consumed in another block than the one that makes it, which SPIR-V forbids: an operand evaluated after it branches, as `&&` and `||` do, so compute that operand into a binding before the call"; }
    val r: res[str, format.FormatError] = format.sprint(e.alloc, "the result of `{}` {}", row.name, how);
    if (sel r.err) { ret "a confined `op` result is consumed where SPIR-V forbids it"; }
    ret r.ok;
}

# the kind of value a function returns
fun return_kind(e: *Emit, fx: u32) type.IrTypeKind {
    val tys: *type.IrTypeTable = ?fn_mod(e, fx).types;
    val so:  opt[*type.IrType] = type.get(tys, fn_ir(e, fx).sig);
    if (sel so.none) { ret type.IRT_VOID; }
    val sig: *type.IrType = so.some;
    if (sig.kind != type.IRT_FN) { ret type.IRT_VOID; }
    val rt: opt[*type.IrType] = type.get(tys, sig.data.fn.ret_type);
    if (sel rt.none) { ret type.IRT_VOID; }
    ret rt.some.kind;
}

# the storage class the pointer a function returns points into: its global's, the
# global the copy binds its parameter to, or Function for a local
fun return_storage(e: *Emit, fx: u32, key: u32) u32 {
    if (e.rptr == nil) { ret spirv.STORAGE_FUNCTION; }
    val o: u32 = e.rptr[fx];
    if (o == GL_NONE)            { ret spirv.STORAGE_FUNCTION; }
    if ((o & ORIGIN_PARAM) == 0) { ret e.gstorage[o]; }
    val at: u32 = key_param(e, key, o & ~ORIGIN_PARAM);
    if (e.keys.data[at] == BIND_GLOBAL) { ret e.gstorage[e.keys.data[at + 1]]; }
    ret spirv.STORAGE_FUNCTION;
}

# the instruction row an `op` call assembles, nil for any other instruction
fun call_op_row(e: *Emit, fx: u32, mi: *mir.MirInstr) *isa.OpDef {
    ret call_op_row_in(e, fn_mod(e, fx), mi);
}

fun call_op_row_in(e: *Emit, m: *ir.Module, mi: *mir.MirInstr) *isa.OpDef {
    if (mi.opcode != mir.MIR_VALUE_CALL || mi.operand_count < 2) { ret nil; }
    if (mi.operands[0].kind != mir.MIR_OP_SYM)                   { ret nil; }
    val callee: *ir.Function = ir_function_record(m, mi.operands[0].sym);
    if (callee == nil || callee.op_set == defs.SPV_SET_NONE) { ret nil; }
    ret isa.op_def_by_code(e.tgt.defs, callee.op_set, callee.op_code);
}

# the operand an instruction defines as a pointer into what another operand
# names: a chain's base, or the source operand an `op` pointer result's row names
fun derived_pointer(e: *Emit, fx: u32, mi: *mir.MirInstr, out_dst: *u32, out_base: *u32) bool {
    if (mi.opcode == mir.MIR_GEP && mi.operand_count >= 2) {
        @out_dst  = 0;
        @out_base = 1;
        ret true;
    }
    val row: *isa.OpDef = call_op_row(e, fx, mi);
    if (row == nil || row.result != isa.OP_RESULT_POINTER)                    { ret false; }
    if (row.source == isa.NO_OP_SOURCE || row.source + 2 >= mi.operand_count) { ret false; }
    @out_dst  = 1;
    @out_base = row.source + 2;
    ret true;
}

# how an `op` call touches what operand `oi` names, exactly as its row says: the
# callee and a pointer result it defines are no access, a pointer operand is read,
# stored or both, and anything else is a value read from its object
fun op_operand_access(row: *isa.OpDef, oi: u32) u8 {
    if (oi < 2) { ret 0; }
    val kind: isa.OpOperandKind = isa.op_operand_kind(row, oi - 2);
    # a pointer result's base is touched by the result's own uses, never by deriving it
    val base: bool = row.result == isa.OP_RESULT_POINTER && row.source == oi - 2;
    if (base)                                  { ret 0; }
    if (kind == isa.OP_OPERAND_POINTER_WRITE)  { ret ACCESS_WRITE; }
    if (kind == isa.OP_OPERAND_POINTER_UPDATE) { ret ACCESS_WRITE | ACCESS_READ; }
    ret ACCESS_READ;
}

# how a call touches what a pointer or handle argument names: as the callee does through
# that parameter; false for an operand that is no such argument of an emitted callee
fun call_param_access(e: *Emit, fx: u32, mi: *mir.MirInstr, oi: u32, out: *u8) bool {
    if (oi < 2 || e.pacc == nil) { ret false; }
    val kind: mir.MirOperandKind = mi.operands[oi].kind;
    if (kind != mir.MIR_OP_VREG && kind != mir.MIR_OP_SYM) { ret false; }
    val gx: u32 = mach_callee(e, fx, mi);
    if (gx == FN_NONE)                                                       { ret false; }
    if (!param_is_pointer(e, gx, oi - 2) && !param_is_handle(e, gx, oi - 2)) { ret false; }
    @out = e.pacc[e.pbase[gx] + oi - 2];
    ret true;
}

# a parameter's origin marks what its function does through it, a global's what the module does to it
fun mark_origin(e: *Emit, fx: u32, mi: *mir.MirInstr, o: u32, how: u8) err[fail.Fail] {
    if ((o & ORIGIN_PARAM) == 0 || o == GL_NONE) { ret mark_access(e, mi, o, how); }
    val at: u32 = e.pbase[fx] + (o & ~ORIGIN_PARAM);
    if (e.pacc == nil || at >= e.pacc_len) { ret err[fail.Fail].ok{}; }
    if ((how & ~e.pacc[at]) != 0) {
        e.pacc[at] = e.pacc[at] | how;
        e.sum_grew = true;
    }
    ret err[fail.Fail].ok{};
}

fun operand_only_reads(mi: *mir.MirInstr, oi: u32) bool {
    val op: mir.MirOpcode = mi.opcode;
    if (op == mir.MIR_VALUE_PARAM) { ret true; }
    if (op == mir.MIR_LOAD)        { ret oi == 1; }
    if (op == mir.MIR_GEP)         { ret oi < 2; }
    if (op == mir.MIR_MEMCPY)      { ret oi == 1; }
    # a by-value argument is loaded from its object; a reference argument may be written through by the callee
    if (op == mir.MIR_VALUE_CALL) { ret oi >= 2 && mi.operands[oi].kind == mir.MIR_OP_MEM; }
    if (op == mir.MIR_RET)        { ret oi == 0; }
    ret false;
}

fun operand_origin(e: *Emit, origin: *u32, n: u32, op: *mir.MirOperand) u32 {
    if (op.kind == mir.MIR_OP_SYM)                                   { ret gl_lookup(e, op.sym); }
    if (op.kind != mir.MIR_OP_VREG && op.kind != mir.MIR_OP_MEM)     { ret GL_NONE; }
    if (origin == nil || mir.vreg_is_nil(op.vreg) || op.vreg.n >= n) { ret GL_NONE; }
    ret origin[op.vreg.n];
}

# an address operand the instruction writes through or only offsets, never loading what it names
fun operand_never_reads(mi: *mir.MirInstr, oi: u32) bool {
    val op: mir.MirOpcode = mi.opcode;
    if (op == mir.MIR_VALUE_PARAM) { ret true; }
    if (op == mir.MIR_STORE)       { ret oi == 0; }
    if (op == mir.MIR_MEMCPY)      { ret oi == 0; }
    if (op == mir.MIR_MEMZERO)     { ret oi == 0; }
    if (op == mir.MIR_GEP)         { ret oi < 2; }
    ret false;
}

fun mark_access(e: *Emit, mi: *mir.MirInstr, gix: u32, how: u8) err[fail.Fail] {
    if (gix >= e.gl_len || e.gaccess == nil) { ret err[fail.Fail].ok{}; }
    val fresh: u8 = how & ~e.gaccess[gix];
    if (fresh == 0) { ret err[fail.Fail].ok{}; }
    e.gaccess[gix] = e.gaccess[gix] | fresh;
    val g: *ir.Global = gl_ir(e, gix);
    if ((fresh & ACCESS_WRITE) != 0 && (g.iface_flags & ir.IFACE_FLAG_READONLY) != 0) {
        if (g.iface == ir.IFACE_SPEC) {
            val sr: res[str, format.FormatError] = format.sprint(e.alloc,
                "a store reaches the `#[spec({})]` var{}: a specialization constant is supplied by the host at pipeline creation and is a constant from then on, so a shader has no storage to write it through. copy it into a local to change the value",
                g.iface_a, gl_mod_prefix(e, gix));
            if (sel sr.err) {
                ret err[fail.Fail].err{fail.message("spirv.emit: a store reaches a `#[spec]` var")};
            }
            ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_READONLY_STORE, mir.refusal_loc(e.cur_fn, mi), sr.ok)};
        }
        if (g.iface == ir.IFACE_PUSH) {
            val pr: res[str, format.FormatError] = format.sprint(e.alloc,
                "a store reaches the `#[push]` block{}: a push-constant block is written by the host with the command that records the dispatch or draw, and a shader only reads it. copy the value into a local to change it",
                gl_mod_prefix(e, gix));
            if (sel pr.err) {
                ret err[fail.Fail].err{fail.message("spirv.emit: a store reaches a `#[push]` block")};
            }
            ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_READONLY_STORE, mir.refusal_loc(e.cur_fn, mi), pr.ok)};
        }
        val r: res[str, format.FormatError] = format.sprint(e.alloc,
            "a store reaches the `#[storage({}, {}, \"readonly\")]` binding{}: the qualifier declares that nothing writes it, which is what lets this module mark the descriptor `NonWritable` and a vertex stage read it without `vertexPipelineStoresAndAtomics`. drop the `\"readonly\"` qualifier to write it",
            g.iface_a, g.iface_b, gl_mod_prefix(e, gix));
        if (sel r.err) {
            ret err[fail.Fail].err{fail.message("spirv.emit: a store reaches a `\"readonly\"` storage binding")};
        }
        ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_READONLY_STORE, mir.refusal_loc(e.cur_fn, mi), r.ok)};
    }
    if ((fresh & ACCESS_READ) != 0 && (g.iface_flags & ir.IFACE_FLAG_WRITEONLY) != 0) {
        val r: res[str, format.FormatError] = format.sprint(e.alloc,
            "a load reaches the `#[storage({}, {}, \"writeonly\")]` binding{}: the qualifier declares that nothing reads it, which is what lets this module mark the descriptor `NonReadable`. drop the `\"writeonly\"` qualifier to read it",
            g.iface_a, g.iface_b, gl_mod_prefix(e, gix));
        if (sel r.err) {
            ret err[fail.Fail].err{fail.message("spirv.emit: a load reaches a `\"writeonly\"` storage binding")};
        }
        ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_WRITEONLY_LOAD, mir.refusal_loc(e.cur_fn, mi), r.ok)};
    }
    ret err[fail.Fail].ok{};
}

fun gl_written(e: *Emit, ix: u32) bool {
    if (e.gaccess == nil || ix >= e.gl_len) { ret true; }
    ret (e.gaccess[ix] & ACCESS_WRITE) != 0;
}

fun global_is_reached(e: *Emit, name: intern.StrId) bool {
    var fx: u32 = 0;
    for (fx < e.fn_len) {
        if (!e.fns[fx].emit) {
            fx = fx + 1;
            cnt;
        }
        val fn: *ir.Function = fn_ir(e, fx);
        if (fn.wg_spec[0] == name || fn.wg_spec[1] == name || fn.wg_spec[2] == name) { ret true; }
        val mf: *mir.MirFunction = fn_mir(e, fx);
        if (mf == nil) {
            fx = fx + 1;
            cnt;
        }
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii:  u32           = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                var oi: u32           = 0;
                for (oi < mi.operand_count) {
                    if (mi.operands[oi].kind == mir.MIR_OP_SYM
                        && mi.operands[oi].sym == name) { ret true; }
                    oi = oi + 1;
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        fx = fx + 1;
    }
    ret false;
}

fun gl_eligible(g: *ir.Global) bool {
    ret !g.is_extern && !g.is_import;
}

fun gl_ir(e: *Emit, ix: u32) *ir.Global {
    ret ?e.u.mods[e.gls[ix].mi].ir.globals[e.gls[ix].ir_ix];
}

fun gl_types(e: *Emit, ix: u32) *type.IrTypeTable {
    ret ?e.u.mods[e.gls[ix].mi].ir.types;
}

fun gl_lookup(e: *Emit, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < e.gl_len) {
        if (e.gls[i].name == name) { ret i; }
        i = i + 1;
    }
    ret GL_NONE;
}

fun gl_mod_prefix(e: *Emit, ix: u32) str {
    if (ix >= e.gl_len || e.gls[ix].mi == e.u.root) { ret ""; }
    val mo: opt[str] = intern.lookup(e.interner, e.u.mods[e.gls[ix].mi].ir.name);
    if (sel mo.none) { ret ""; }
    val q: res[str, format.FormatError] = format.sprint(e.alloc, ", declared in `{}`", mo.some);
    if (sel q.err) { ret ""; }
    ret q.ok;
}

fun declare_interface(e: *Emit) err[fail.Fail] {
    val n: u32 = e.gl_len;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val rg: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rg.err) { ret err[fail.Fail].err{fail.refused(rg.err)}; }
    e.gvar_ids = rg.ok;

    val rs: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    e.gslot = rs.ok;
    val rt: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rt.err) { ret err[fail.Fail].err{fail.refused(rt.err)}; }
    e.gtype_ids = rt.ok;
    val rc: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rc.err) { ret err[fail.Fail].err{fail.refused(rc.err)}; }
    e.gstorage = rc.ok;
    val rp: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rp.err) { ret err[fail.Fail].err{fail.refused(rp.err)}; }
    e.gspec = rp.ok;

    var i: u32 = 0;
    for (i < n) {
        e.gvar_ids[i]  = 0;
        e.gslot[i]     = 0;
        e.gtype_ids[i] = 0;
        e.gstorage[i]  = 0;
        e.gspec[i]     = 0;
        i              = i + 1;
    }

    i = 0;
    for (i < n) {
        val g:  *ir.Global        = gl_ir(e, i);
        val gt: *type.IrTypeTable = gl_types(e, i);
        if (g.iface == ir.IFACE_NONE) {
            i = i + 1;
            cnt;
        }
        if (g.iface == ir.IFACE_SPEC) {
            val sr: err[fail.Fail] = declare_spec(e, i);
            if (sel sr.err) { ret sr; }
            i = i + 1;
            cnt;
        }

        if (g.iface == ir.IFACE_BUILTIN) {
            val br: str = builtin_type_refusal(gt, e.alloc, g.iface_a, g.ty);
            if (br != nil) { ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, br)}; }
        }

        val handle: bool = is_image_type(e, gt, g.ty);
        if (handle) {
            val wr: err[fail.Fail] = require_wide_texels(e, gt, i);
            if (sel wr.err) { ret wr; }
        }
        var storage: u32 = spirv.STORAGE_INPUT;
        if (g.iface == ir.IFACE_OUTPUT)  { storage = spirv.STORAGE_OUTPUT; }
        or (g.iface == ir.IFACE_UNIFORM) { storage = spirv.STORAGE_UNIFORM; }
        or (g.iface == ir.IFACE_STORAGE) { storage = spirv.storage_buffer_class(e.b.version); }
        or (g.iface == ir.IFACE_SAMPLER) { storage = spirv.STORAGE_UNIFORM_CONSTANT; }
        or (g.iface == ir.IFACE_PUSH)    { storage = spirv.STORAGE_PUSH_CONSTANT; }
        or (g.iface == ir.IFACE_BUILTIN) { storage = builtin_storage(g.iface_a); }
        or (g.iface == ir.IFACE_SHARED)  { storage = spirv.STORAGE_WORKGROUP; }
        # every handle variable lives in UniformConstant, a storage image's included
        if (handle) { storage = spirv.STORAGE_UNIFORM_CONSTANT; }

        if (handle && g.iface != handle_role(e, gt, g.ty)) {
            ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "an image handle carries an interface role other than the descriptor it binds as: a storage image is `#[storage(set, binding)]`, every other handle `#[sampler(set, binding)]`, and a handle reaches no other storage class")};
        }
        if (handle) {
            val tr: err[fail.Fail] = require_image_type(e, gt, g.ty);
            if (sel tr.err) { ret tr; }
        }
        if (!handle && g.iface == ir.IFACE_SAMPLER) {
            ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "a `#[sampler(set, binding)]` binding is not of an image handle type; a descriptor-bound block or buffer of an ordinary type is `#[uniform]` or `#[storage]`")};
        }

        var value_ty: u32 = 0;
        if (is_block_iface(g.iface) && !handle) {
            val ur: res[u32, fail.Fail] = block_type(e, gt, g.ty, g.iface);
            if (sel ur.err) { ret err[fail.Fail].err{ur.err}; }
            value_ty = ur.ok;
        }
        or (g.iface == ir.IFACE_INPUT || g.iface == ir.IFACE_OUTPUT) {
            value_ty = host_shared_type(e, gt, g.ty);
            val nr: err[fail.Fail] = require_interface_access(e, value_ty, i);
            if (sel nr.err) { ret nr; }
        }
        or { value_ty = global_spv_type(e, gt, g.ty); }
        if (value_ty == 0) {
            ret unsupported(e, "unsupported shader interface variable type in the SPIR-V target");
        }
        val ptr_ty: u32 = types.type_ptr(e.tt, storage, value_ty);
        val var_id: u32 = spirv.alloc_id(e.b);
        var vop:    [4]u32;
        vop[0] = ptr_ty;
        vop[1] = var_id;
        vop[2] = storage;
        var vn: u32 = 3;
        if (g.iface == ir.IFACE_SHARED && shared_native_zero(e) && !holds_physical(e, value_ty)) {
            vop[3] = types.const_null(e.tt, value_ty);
            vn     = 4;
        }
        or (storage == spirv.STORAGE_OUTPUT) {
            vop[3] = output_initializer(e, gt, g, value_ty);
            vn     = 4;
            if (vop[3] == 0) {
                ret unsupported(e, "an output's initializer is not a constant the SPIR-V target can spell: an output starts at a constant of its own type, and this one holds an address or a type no constant composite has");
            }
        }
        spirv.inst(e.b, ?e.b.types_consts, spirv.OP_VARIABLE, ?vop[0], vn);
        e.gvar_ids[i]  = var_id;
        e.gtype_ids[i] = value_ty;
        e.gstorage[i]  = storage;
        dbgm.name_shown(?e.dbg, var_id, g.disp, g.name);
        if (is_block_iface(g.iface) && !handle) { dbgm.record(?e.dbg, value_ty, g.ty_sem); }

        if (g.iface == ir.IFACE_INPUT || g.iface == ir.IFACE_OUTPUT) {
            decorate(e, var_id, spirv.DECOR_LOCATION, g.iface_a);
        }
        if (g.iface == ir.IFACE_BUILTIN) {
            decorate(e, var_id, spirv.DECOR_BUILTIN, builtin_selector(g.iface_a));
            val rq: err[fail.Fail] = require_at(e, source.loc_nil(), 0, builtin_capability(g.iface_a), 0,
                builtin_decl_text(e, i));
            if (sel rq.err) { ret rq; }
        }
        if (g.iface == ir.IFACE_UNIFORM || g.iface == ir.IFACE_STORAGE
            || g.iface == ir.IFACE_SAMPLER) {
            decorate(e, var_id, spirv.DECOR_DESCRIPTOR_SET, g.iface_a);
            decorate(e, var_id, spirv.DECOR_BINDING, g.iface_b);
        }
        if (g.iface == ir.IFACE_STORAGE && !gl_written(e, i)) {
            decorate_bare(e, var_id, spirv.DECOR_NON_WRITABLE);
        }
        decorate_memory_quals(e, var_id, g.iface_flags);
        if (e.vulkan_mm) {
            val sr: err[fail.Fail] = mark_memory_scope(e, var_id, variable_scope(storage, g.iface_flags));
            if (sel sr.err)                                              { ret sr; }
            if (handle && (g.iface_flags & ir.IFACE_FLAG_COHERENT) != 0) { e.coherent_images = true; }
        }
        e.gslot[i]  = e.iface_len + 1;
        e.iface_len = e.iface_len + 1;
        i           = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a specialization constant is no variable: it is an OpSpecConstant whose literal is the
# initializer, the default a pipeline keeps unless it supplies the SpecId
fun declare_spec(e: *Emit, i: u32) err[fail.Fail] {
    val g:      *ir.Global        = gl_ir(e, i);
    val gt:     *type.IrTypeTable = gl_types(e, i);
    val t:      opt[*type.IrType] = type.get(gt, g.ty);
    var scalar: bool              = false;
    if (sel t.some) { scalar = t.some.kind == type.IRT_INT || t.some.kind == type.IRT_FLOAT; }
    if (!scalar) {
        val nr: res[str, format.FormatError] = format.sprint(e.alloc,
            "a `#[spec({})]` var must be a scalar integer or float{}: a specialization constant is one literal the host supplies, and this one is {}",
            g.iface_a, gl_mod_prefix(e, i), ir_type_spelling(gt, e.alloc, g.ty));
        if (sel nr.err) { ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "a `#[spec]` var must be a scalar integer or float")}; }
        ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, nr.ok)};
    }
    var j: u32 = 0;
    for (j < i) {
        val o: *ir.Global = gl_ir(e, j);
        if (o.iface == ir.IFACE_SPEC && o.iface_a == g.iface_a) {
            val dr: res[str, format.FormatError] = format.sprint(e.alloc,
                "two `#[spec({})]` vars share one SpecId: `{}`{} and `{}`{}. a pipeline supplies a specialization constant by its id, so one id names one constant in a module. give them different ids",
                g.iface_a, spec_name(e, j), gl_mod_prefix(e, j), spec_name(e, i), gl_mod_prefix(e, i));
            if (sel dr.err) { ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "two `#[spec]` vars share one SpecId")}; }
            ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, dr.ok)};
        }
        j = j + 1;
    }
    val value_ty: u32 = global_spv_type(e, gt, g.ty);
    if (value_ty == 0) { ret unsupported(e, "unsupported specialization constant type in the SPIR-V target"); }
    val bits: u32 = types.type_bits(e.tt, value_ty);
    val lit:  u64 = scalar_literal(?g.init, bits);
    val id:   u32 = spirv.alloc_id(e.b);
    var ops:  [4]u32;
    ops[0] = value_ty;
    ops[1] = id;
    ops[2] = (lit & 0xFFFFFFFF)::u32;
    ops[3] = (lit >> 32)::u32;
    var n: u32 = 3;
    if (bits > 32) { n = 4; }
    spirv.inst(e.b, ?e.b.types_consts, spirv.OP_SPEC_CONSTANT, ?ops[0], n);
    decorate(e, id, spirv.DECOR_SPEC_ID, g.iface_a);
    dbgm.name_shown(?e.dbg, id, g.disp, g.name);
    e.gspec[i]     = id;
    e.gtype_ids[i] = value_ty;
    ret err[fail.Fail].ok{};
}

# the bits of a scalar constant as a `bits`-wide literal
fun scalar_literal(v: *value.Value, bits: u32) u64 {
    var lit: u64 = v.data.int_lit;
    if (v.kind == value.VAL_CONST_FLOAT) {
        lit = float.bits_at(float.bits_f64(v.data.int_lit), float.width_of_bits(bits));
    }
    or (v.kind != value.VAL_CONST_INT) { lit = 0; }
    if (bits < 64)                     { lit = lit & ((1::u64 << bits::u64) - 1); }
    ret lit;
}

# the constant an Output variable starts at (#4287): its initializer, spelled as
# OpConstantNull where that is zero, which is also what an output declared without one
# holds, as every mach `var` does. 0 where the initializer has no constant form
fun output_initializer(e: *Emit, gt: *type.IrTypeTable, g: *ir.Global, value_ty: u32) u32 {
    val v: *value.Value      = ?g.init;
    val t: opt[*type.IrType] = type.get(gt, g.ty);
    if (sel t.none)                     { ret 0; }
    if (v.kind == value.VAL_CONST_NULL) { ret types.const_null(e.tt, value_ty); }
    if (v.kind == value.VAL_CONST_INT || v.kind == value.VAL_CONST_FLOAT) {
        val scalar: bool = t.some.kind == type.IRT_INT || t.some.kind == type.IRT_FLOAT;
        if (v.data.int_lit == 0 && v.kind == value.VAL_CONST_INT) { ret types.const_null(e.tt, value_ty); }
        if (!scalar)                                              { ret 0; }
        val lit: u64 = scalar_literal(v, types.type_bits(e.tt, value_ty));
        if (lit == 0) { ret types.const_null(e.tt, value_ty); }
        ret types.const_scalar(e.tt, value_ty, (lit & 0xFFFFFFFF)::u32, (lit >> 32)::u32);
    }
    if (v.kind == value.VAL_CONST_AGG) {
        if (v.data.agg.reloc_count != 0) { ret 0; }
        ret image_constant(e, gt, g.ty, value_ty, v.data.agg.bytes, v.data.agg.len, 0);
    }
    if (v.kind == value.VAL_CONST_BYTES) {
        ret image_constant(e, gt, g.ty, value_ty, v.data.bytes.ptr, v.data.bytes.len, 0);
    }
    ret 0;
}

# the constant of `spv_ty` that the byte image of ir type `id` at `off` spells, laid out
# as the target lays the type out; a byte past the image is zero
fun image_constant(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, spv_ty: u32,
    bytes: *u8, len: u32, off: u32) u32 {
    if (spv_ty == 0) { ret 0; }
    val size: u32  = type.byte_size_for_machine(gt, id, e.layout);
    var zero: bool = true;
    var k:    u32  = 0;
    for (k < size && zero) {
        if (off + k < len && bytes[off + k] != 0) { zero = false; }
        k = k + 1;
    }
    if (zero) { ret types.const_null(e.tt, spv_ty); }

    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret 0; }
    val t: *type.IrType = opt_.some;
    if (t.kind == type.IRT_INT || t.kind == type.IRT_FLOAT) {
        if (size > 8) { ret 0; }
        var lit: u64 = 0;
        k = 0;
        for (k < size) {
            if (off + k < len) { lit = lit | (bytes[off + k]::u64 << (k * 8)::u64); }
            k = k + 1;
        }
        ret types.const_scalar(e.tt, spv_ty, (lit & 0xFFFFFFFF)::u32, (lit >> 32)::u32);
    }
    var n:    u32           = 0;
    var elem: type.IrTypeId = type.IRT_NIL;
    if (t.kind == type.IRT_VECTOR) {
        n    = t.data.vector_.lanes;
        elem = t.data.vector_.element;
    }
    or (t.kind == type.IRT_ARRAY) {
        n    = t.data.array_.count;
        elem = t.data.array_.element;
    }
    or (t.kind == type.IRT_STRUCT) { n = t.data.struct_.field_count; }
    or                             { ret 0; }
    if (n == 0)                    { ret 0; }

    val rp: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rp.err) { ret 0; }
    val parts: *u32 = rp.ok;
    var ok:    bool = true;
    var i:     u32  = 0;
    for (i < n && ok) {
        var mid:  type.IrTypeId = elem;
        var moff: u32           = off;
        if (t.kind == type.IRT_STRUCT) {
            mid  = t.data.struct_.fields[i];
            moff = off + type.byte_offset_for_machine(gt, id, i, e.layout);
        }
        or { moff = off + i * type.byte_size_for_machine(gt, elem, e.layout); }
        parts[i] = image_constant(e, gt, mid, spv_type_of(e, gt, mid), bytes, len, moff);
        if (parts[i] == 0) { ok = false; }
        i = i + 1;
    }
    var c: u32 = 0;
    if (ok) { c = types.const_composite(e.tt, spv_ty, parts, n); }
    A.deallocate[u32](e.alloc, parts, n::usize);
    ret c;
}

fun spec_name(e: *Emit, i: u32) str {
    val g: *ir.Global   = gl_ir(e, i);
    var n: intern.StrId = g.disp;
    if (n == intern.STR_NIL) { n = g.name; }
    val o: opt[str] = intern.lookup(e.interner, n);
    if (sel o.none) { ret "?"; }
    ret o.some;
}

fun spec_target(e: *Emit, op: *mir.MirOperand) u32 {
    if (e.gspec == nil || op.kind != mir.MIR_OP_SYM || op.sym_off != 0) { ret 0; }
    val gx: u32 = gl_lookup(e, op.sym);
    if (gx == GL_NONE) { ret 0; }
    ret e.gspec[gx];
}

# the environment admits LocalSizeId: SPIR-V 1.2 without an environment, and on
# Vulkan the maintenance4 feature only Vulkan 1.3 guarantees
fun local_size_id_admitted(e: *Emit) bool {
    if (e.tgt.identity.env_id == isa.ENV_NONE) { ret e.b.version >= spirv.SPV_VERSION_1_2; }
    val p: *spirv.EnvProfile = spirv.env_profile(e.tgt.identity.env_profile);
    ret p != nil && p.local_size_id;
}

fun wg_is_spec(fn: *ir.Function) bool {
    ret fn.wg_spec[0] != intern.STR_NIL || fn.wg_spec[1] != intern.STR_NIL || fn.wg_spec[2] != intern.STR_NIL;
}

fun wg_literal(fn: *ir.Function, d: u32) u32 {
    if (d == 0) { ret fn.wg_x; }
    if (d == 1) { ret fn.wg_y; }
    ret fn.wg_z;
}

# the id a workgroup dimension is: its `#[spec]` var's constant, or a 32-bit OpConstant
fun wg_dim_id(e: *Emit, fn: *ir.Function, d: u32) res[u32, fail.Fail] {
    val name: intern.StrId = fn.wg_spec[d];
    if (name == intern.STR_NIL) { ret res[u32, fail.Fail].ok{types.const_int(e.tt, 32, wg_literal(fn, d)::i64)}; }
    val gx: u32 = gl_lookup(e, name);
    var id: u32 = 0;
    if (gx != GL_NONE && e.gspec != nil) { id = e.gspec[gx]; }
    if (id == 0) {
        ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "a `#[workgroup]` dimension names a var that is not a `#[spec(id)]` var: a dimension is a constant or a specialization constant the host supplies at pipeline creation")};
    }
    val ty: u32 = e.gtype_ids[gx];
    if (types.type_is_float(e.tt, ty) || types.type_bits(e.tt, ty) != 32) {
        ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "a `#[spec]` var sizing a `#[workgroup]` dimension must be a 32-bit integer: a workgroup size is three 32-bit integers")};
    }
    ret res[u32, fail.Fail].ok{id};
}

fun wg_same(a: *ir.Function, b: *ir.Function) bool {
    var d: u32 = 0;
    for (d < 3) {
        if (a.wg_spec[d] != b.wg_spec[d])                                           { ret false; }
        if (a.wg_spec[d] == intern.STR_NIL && wg_literal(a, d) != wg_literal(b, d)) { ret false; }
        d = d + 1;
    }
    ret true;
}

# without LocalSizeId a specialized workgroup is the WorkgroupSize built-in over a
# spec composite, which sizes every compute stage in the module, so they must agree
fun plan_workgroup(e: *Emit) err[fail.Fail] {
    var first: *ir.Function = nil;
    var spec:  bool         = false;
    var fx:    u32          = 0;
    for (fx < e.fn_len) {
        if (!e.fns[fx].emit) {
            fx = fx + 1;
            cnt;
        }
        val fn: *ir.Function = fn_ir(e, fx);
        if (fn.stage != ir.STAGE_COMPUTE) {
            fx = fx + 1;
            cnt;
        }
        if (wg_is_spec(fn)) { spec = true; }
        if (first == nil)   { first = fn; }
        or (!wg_same(first, fn) && (spec || wg_is_spec(first)) && !local_size_id_admitted(e)) {
            ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "compute stages in one module size their workgroups differently and one of them by a `#[spec]` var: this environment has no LocalSizeId, so a specialized workgroup is the WorkgroupSize built-in, which sizes every compute stage in the module at once. give the stages one workgroup, split them into modules, or target vulkan1.3")};
        }
        fx = fx + 1;
    }
    if (!spec || local_size_id_admitted(e)) { ret err[fail.Fail].ok{}; }
    var parts: [3]u32;
    var d:     u32 = 0;
    for (d < 3) {
        val r: res[u32, fail.Fail] = wg_dim_id(e, first, d);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        parts[d] = r.ok;
        d        = d + 1;
    }
    val vec: u32 = types.type_vector(e.tt, types.type_int(e.tt, 32), 3);
    val id:  u32 = spirv.alloc_id(e.b);
    var ops: [5]u32;
    ops[0] = vec;
    ops[1] = id;
    ops[2] = parts[0];
    ops[3] = parts[1];
    ops[4] = parts[2];
    spirv.inst(e.b, ?e.b.types_consts, spirv.OP_SPEC_CONSTANT_COMPOSITE, ?ops[0], 5);
    decorate(e, id, spirv.DECOR_BUILTIN, spirv.BUILTIN_WORKGROUP_SIZE);
    e.wg_builtin = true;
    ret err[fail.Fail].ok{};
}

fun is_block_iface(iface: u8) bool {
    ret iface == ir.IFACE_UNIFORM || iface == ir.IFACE_STORAGE || iface == ir.IFACE_PUSH;
}

# an f16 is the OpTypeFloat 16 it is where the selection holds Float16: in a stage
# interface (#3801), a buffer, push block or `#[shared]` variable (#4299), and a local,
# parameter or result (#4339)
fun half_memory(e: *Emit) bool {
    ret (e.tgt.model.extensions & spirv.EXT_FLOAT16) != 0;
}

# the type a host-shared variable or member of the ir type `id` is declared with: its
# 8- and 16-bit scalars declared under their storage access capability rather than the
# arithmetic one of their width
fun host_shared_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) u32 {
    val prior: bool = e.tt.storage_only;
    e.tt.storage_only = true;
    val ty: u32 = spv_type_of(e, gt, id);
    e.tt.storage_only = prior;
    ret ty;
}

# the widths of 8- and 16-bit scalars a type holds anywhere inside it, 8 | 16 as bits
fun narrow_widths(e: *Emit, ty: u32) u32 {
    if (ty == 0) { ret 0; }
    var lanes: u32 = 0;
    val lane:  u32 = types.vector_shape(e.tt, ty, ?lanes);
    if (lane != 0) { ret narrow_widths(e, lane); }
    if (types.is_composite(e.tt, ty)) {
        var w: u32 = 0;
        var i: u32 = 0;
        val n: u32 = types.composite_count(e.tt, ty);
        for (i < n) {
            w = w | narrow_widths(e, types.composite_member(e.tt, ty, i));
            i = i + 1;
        }
        ret w;
    }
    if (types.type_is_bool(e.tt, ty)) { ret 0; }
    val bits: u32 = types.type_bits(e.tt, ty);
    if (bits == 8 || bits == 16) { ret bits; }
    ret 0;
}

# the storage access capability and feature of `bits` held in memory of `role`, a block's
# interface role or ROLE_PHYSICAL. false when there is none
fun storage_access(role: u8, bits: u32, out_cap: *u32, out_ext: *u64) bool {
    val wide: bool = bits == 16;
    if (role == ir.IFACE_STORAGE || role == ROLE_PHYSICAL) {
        if (wide) {
            @out_cap = spirv.CAP_STORAGE_BUFFER_16BIT_ACCESS;
            @out_ext = spirv.EXT_STORAGE_BUFFER_16BIT_ACCESS;
        }
        or {
            @out_cap = spirv.CAP_STORAGE_BUFFER_8BIT_ACCESS;
            @out_ext = spirv.EXT_STORAGE_BUFFER_8BIT_ACCESS;
        }
        ret true;
    }
    if (role == ir.IFACE_UNIFORM) {
        if (wide) {
            @out_cap = spirv.CAP_UNIFORM_AND_STORAGE_BUFFER_16BIT_ACCESS;
            @out_ext = spirv.EXT_UNIFORM_AND_STORAGE_BUFFER_16BIT_ACCESS;
        }
        or {
            @out_cap = spirv.CAP_UNIFORM_AND_STORAGE_BUFFER_8BIT_ACCESS;
            @out_ext = spirv.EXT_UNIFORM_AND_STORAGE_BUFFER_8BIT_ACCESS;
        }
        ret true;
    }
    if (role == ir.IFACE_PUSH) {
        if (wide) {
            @out_cap = spirv.CAP_STORAGE_PUSH_CONSTANT16;
            @out_ext = spirv.EXT_STORAGE_PUSH_CONSTANT16;
        }
        or {
            @out_cap = spirv.CAP_STORAGE_PUSH_CONSTANT8;
            @out_ext = spirv.EXT_STORAGE_PUSH_CONSTANT8;
        }
        ret true;
    }
    ret false;
}

# a block member of `leaf_ty` in memory of `role` needs the storage access feature of its width
fun require_member_access(e: *Emit, leaf_ty: u32, role: u8) err[fail.Fail] {
    val w: u32 = narrow_widths(e, leaf_ty);
    if (w == 0) { ret err[fail.Fail].ok{}; }
    var cap: u32 = 0;
    var ext: u64 = 0;
    if (!storage_access(role, w, ?cap, ?ext)) { ret emit_fail(e, "spirv.emit: a block member's storage class has no storage access capability"); }
    # StorageBuffer8BitAccess is defined on the StorageBuffer class, and a storage buffer
    # is a BufferBlock in Uniform below SPIR-V 1.3
    if (role == ir.IFACE_STORAGE && (w & 8) != 0 && spirv.storage_buffer_class(e.b.version) != spirv.STORAGE_STORAGE_BUFFER) {
        val r: res[str, format.FormatError] = format.sprint(e.alloc,
            "an 8-bit member of a `#[storage(...)]` block needs the StorageBuffer storage class, which the storage_buffer_8bit_access feature is defined on, and the `{}` environment selects SPIR-V {}.{}, where a storage buffer is a BufferBlock in the Uniform class: raise `env` to `{}` or later, or widen the member",
            spirv.env_profile_name(e.tgt.identity.env_profile), spirv.version_major(e.b.version), spirv.version_minor(e.b.version), spirv.env_name_from(spirv.SPV_VERSION_1_3));
        if (sel r.err) { ret err[fail.Fail].err{fail.format_refused(r.err)}; }
        ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_CAPABILITY, phys_loc(e), r.ok)};
    }
    var place: str = block_place(role, "a");
    if (role == ROLE_PHYSICAL) { place = "a record a physical pointer reaches"; }
    var what: str                          = "an 8- or 16-bit block member";
    val r:    res[str, format.FormatError] = format.sprint(e.alloc, "a {}-bit member of {}", w, place);
    if (sel r.ok) { what = r.ok; }
    ret require_at(e, phys_loc(e), e.cur_stages, cap, ext, what);
}

# a stage input or output holding a 16-bit scalar needs storage_input_output16, and one
# holding an 8-bit scalar is refused, since Vulkan defines no 8-bit stage interface
fun require_interface_access(e: *Emit, value_ty: u32, gi: u32) err[fail.Fail] {
    val w: u32 = narrow_widths(e, value_ty);
    if ((w & 8) != 0) {
        val r: res[str, format.FormatError] = format.sprint(e.alloc,
            "the stage interface variable `{}`{} holds an 8-bit scalar, and Vulkan defines no 8-bit stage input or output: there is no storage capability or device feature for one. carry the value in a 16- or 32-bit member",
            gl_spelling(e, gi), gl_mod_prefix(e, gi));
        if (sel r.err) { ret err[fail.Fail].err{fail.format_refused(r.err)}; }
        ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, r.ok)};
    }
    if (w == 0) { ret err[fail.Fail].ok{}; }
    var what: str                          = "a 16-bit stage interface variable";
    val r:    res[str, format.FormatError] = format.sprint(e.alloc, "the stage interface variable `{}`{}, which holds a 16-bit scalar,", gl_spelling(e, gi), gl_mod_prefix(e, gi));
    if (sel r.ok) { what = r.ok; }
    ret require_at(e, source.loc_nil(), 0, spirv.CAP_STORAGE_INPUT_OUTPUT16, spirv.EXT_STORAGE_INPUT_OUTPUT16, what);
}

# a memory type and the type a function carries its value in that differ only in how
# the function holds it: a narrow integer of host-shared memory and the wider integer it
# is computed in where its width has no arithmetic capability (#4302)
fun memory_bridged(e: *Emit, a: u32, b: u32) bool {
    if (a == 0 || b == 0 || a == b)                                   { ret false; }
    if (types.type_is_float(e.tt, a) || types.type_is_float(e.tt, b)) { ret false; }
    val ab: u32 = types.type_bits(e.tt, a);
    val bb: u32 = types.type_bits(e.tt, b);
    ret ab != 0 && bb != 0 && ab != bb;
}

fun emit_bitcast(e: *Emit, to_ty: u32, value: u32) u32 {
    val result: u32 = spirv.alloc_id(e.b);
    var words:  [3]u32;
    words[0] = to_ty;
    words[1] = result;
    words[2] = value;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_BITCAST, ?words[0], 3);
    ret result;
}

fun block_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, role: u8) res[u32, fail.Fail] {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: uniform global has no IR type")}; }
    val t: *type.IrType = opt_.some;
    if (t.kind != type.IRT_STRUCT) {
        val rr: res[str, format.FormatError] = format.sprint(e.alloc,
            "a `{}` variable must be a `rec`: it is a BLOCK with a host-visible layout, and a bare scalar or vector has no block layout for a pipeline to bind. wrap the value in a record with one field",
            block_role(role));
        if (sel rr.err) { ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "an interface block variable must be a `rec`")}; }
        ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, rr.ok)};
    }
    val n: u32 = t.data.struct_.field_count;
    if (n == 0 || n > types.MAX_STRUCT_MEMBERS) {
        ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "a `#[uniform(...)]` / `#[storage(...)]` / `#[push]` block must have between 1 and 16 fields")};
    }

    val sr: res[u32, fail.Fail] = laid_out_struct(e, gt, id, role);
    if (sel sr.err) { ret sr; }
    val struct_id: u32 = sr.ok;

    var bops: [2]u32;
    bops[0] = struct_id;
    bops[1] = spirv.DECOR_BLOCK;
    if (role == ir.IFACE_STORAGE) { bops[1] = spirv.storage_block_decoration(e.b.version); }
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?bops[0], 2);
    ret res[u32, fail.Fail].ok{struct_id};
}

fun laid_out_struct(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, role: u8) res[u32, fail.Fail] {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: uniform block member has no IR type")}; }
    val t: *type.IrType = opt_.some;
    val n: u32          = t.data.struct_.field_count;
    if (n == 0 || n > types.MAX_STRUCT_MEMBERS) {
        if (role == ROLE_PHYSICAL) {
            ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "a record a physical pointer reaches must have between 1 and 16 fields in the SPIR-V target")};
        }
        ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "a `#[uniform(...)]` / `#[storage(...)]` block must have between 1 and 16 fields")};
    }
    # a record a cycle of pointers reaches is declared once, after the pointer its cycle names it by
    val key: u32 = t.data.struct_.key;
    var rx:  u32 = COPY_NONE;
    if (role == ROLE_PHYSICAL && key != type.REC_KEY_NONE) {
        val rr: res[u32, fail.Fail] = phys_rec(e, key);
        if (sel rr.err) { ret rr; }
        rx = rr.ok;
        if (e.precs.data[rx].strct != 0) { ret res[u32, fail.Fail].ok{e.precs.data[rx].strct}; }
        e.precs.data[rx].building = true;
    }

    var members: [16]u32;
    var offs:    [16]u32;
    var i:       u32 = 0;
    for (i < n) {
        val mr: res[u32, fail.Fail] = laid_out_type(e, gt, t.data.struct_.fields[i], role);
        if (sel mr.err) { ret mr; }
        members[i] = mr.ok;
        offs[i]    = type.byte_offset_for_machine(gt, id, i, e.layout);
        i          = i + 1;
    }

    val lr: err[fail.Fail] = check_block_layout(e, gt, id, role);
    if (sel lr.err) { ret res[u32, fail.Fail].err{lr.err}; }
    if (role == ROLE_PHYSICAL && rx == COPY_NONE) {
        val hit: u32 = phys_find(e, false, n, ?members[0], ?offs[0]);
        if (hit != 0) { ret res[u32, fail.Fail].ok{hit}; }
    }
    val struct_id: u32 = types.type_struct(e.tt, ?members[0], n, true);
    if (struct_id == 0) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: could not build a uniform block type")}; }

    i = 0;
    for (i < n) {
        var mops: [4]u32;
        mops[0] = struct_id;
        mops[1] = i;
        mops[2] = spirv.DECOR_OFFSET;
        mops[3] = offs[i];
        spirv.inst(e.b, ?e.b.decorations, spirv.OP_MEMBER_DECORATE, ?mops[0], 4);
        i = i + 1;
    }
    if (role != ROLE_PHYSICAL) { ret res[u32, fail.Fail].ok{struct_id}; }
    val nr: err[fail.Fail] = phys_note(e, struct_id, gt, id);
    if (sel nr.err) { ret res[u32, fail.Fail].err{nr.err}; }
    if (rx != COPY_NONE) {
        e.precs.data[rx].strct    = struct_id;
        e.precs.data[rx].building = false;
        if (types.type_ptr_at(e.tt, e.precs.data[rx].ptr, spirv.STORAGE_PHYSICAL_STORAGE_BUFFER, struct_id) == 0) {
            ret res[u32, fail.Fail].err{fail.message("spirv.emit: could not declare a physical pointer to a record")};
        }
        ret res[u32, fail.Fail].ok{struct_id};
    }
    val kr: err[fail.Fail] = phys_keep(e, false, n, ?members[0], ?offs[0], struct_id);
    if (sel kr.err) { ret res[u32, fail.Fail].err{kr.err}; }
    ret res[u32, fail.Fail].ok{struct_id};
}

fun laid_out_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, role: u8) res[u32, fail.Fail] {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: uniform block member has no IR type")}; }
    val t: *type.IrType = opt_.some;

    if (t.kind == type.IRT_STRUCT) { ret laid_out_struct(e, gt, id, role); }

    # a pointer held in memory is a physical one, whatever memory holds it
    if (t.kind == type.IRT_PTR) {
        val pr: res[u32, fail.Fail] = phys_pointer(e, gt, id);
        if (sel pr.err)            { ret pr; }
        if (role != ROLE_PHYSICAL) { ret pr; }
        val ptr: u32            = pr.ok;
        val nr:  err[fail.Fail] = phys_note(e, ptr, gt, id);
        if (sel nr.err) { ret res[u32, fail.Fail].err{nr.err}; }
        ret res[u32, fail.Fail].ok{ptr};
    }

    if (t.kind == type.IRT_TAG) {
        val tr: res[str, format.FormatError] = format.sprint(e.alloc,
            "a `tag` inside {} is not supported by the SPIR-V target: the block's layout is the host's contract, mach places every case payload at one common offset, and SPIR-V block members may not overlap, so no member offsets can describe where the host writes the payload. keep the tag in Function storage or an `#[input]` / `#[output]` variable, or carry the discriminator and the payload as separate block members{}",
            block_place(role, "a"), storage_hint(role));
        if (sel tr.err) { ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "a `tag` inside a block is not supported by the SPIR-V target")}; }
        ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, tr.ok)};
    }

    if (t.kind == type.IRT_ARRAY) {
        val er: res[u32, fail.Fail] = laid_out_type(e, gt, t.data.array_.element, role);
        if (sel er.err) { ret er; }
        val elem_ty: u32 = er.ok;
        val stride:  u32 = type.byte_size_for_machine(gt, t.data.array_.element, e.layout);
        val want:    u32 = required_stride(e, gt, t.data.array_.element, is_std430(role));
        if (want == 0) {
            ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "unsupported uniform block member type in the SPIR-V target")};
        }
        if (stride != want) {
            val ar: res[str, format.FormatError] = format.sprint(e.alloc,
                "an array inside {} needs an element stride of {} bytes in the SPIR-V target, and mach's layout packs it at {}: a block's array stride is rounded up to the element's base alignment, which mach's own layout does not do, so the shader and the host would disagree about where the elements are. pad the element to {} bytes, or use an element that is that wide already (`f32x4`){}",
                block_place(role, "a"), want, stride, want, storage_hint(role));
            if (sel ar.err) {
                ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "an array inside a `#[uniform(...)]` / `#[storage(...)]` block has an element stride mach's layout does not give it")};
            }
            ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, ar.ok)};
        }
        var ids:  [1]u32;
        var offs: [1]u32;
        ids[0]  = elem_ty;
        offs[0] = stride;
        if (role == ROLE_PHYSICAL) {
            val hit: u32 = phys_find(e, true, t.data.array_.count, ?ids[0], ?offs[0]);
            if (hit != 0) { ret res[u32, fail.Fail].ok{hit}; }
        }
        val arr_id: u32 = types.type_array(e.tt, elem_ty, t.data.array_.count, true);
        if (arr_id == 0) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: could not build a uniform block array type")}; }
        var aops: [3]u32;
        aops[0] = arr_id;
        aops[1] = spirv.DECOR_ARRAY_STRIDE;
        aops[2] = stride;
        spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?aops[0], 3);
        if (role == ROLE_PHYSICAL) {
            val kr: err[fail.Fail] = phys_keep(e, true, t.data.array_.count, ?ids[0], ?offs[0], arr_id);
            if (sel kr.err) { ret res[u32, fail.Fail].err{kr.err}; }
            val nr: err[fail.Fail] = phys_note(e, arr_id, gt, id);
            if (sel nr.err) { ret res[u32, fail.Fail].err{nr.err}; }
        }
        ret res[u32, fail.Fail].ok{arr_id};
    }

    val mt: u32 = host_shared_type(e, gt, id);
    if (mt == 0) {
        if (e.has_held) {
            e.has_held = false;
            ret res[u32, fail.Fail].err{e.held};
        }
        ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "unsupported uniform block member type in the SPIR-V target")};
    }
    val ar: err[fail.Fail] = require_member_access(e, mt, role);
    if (sel ar.err) { ret res[u32, fail.Fail].err{ar.err}; }
    if (role == ROLE_PHYSICAL) {
        val nr: err[fail.Fail] = phys_note(e, mt, gt, id);
        if (sel nr.err) { ret res[u32, fail.Fail].err{nr.err}; }
    }
    ret res[u32, fail.Fail].ok{mt};
}

# the explicit-layout type built for physical memory with these members, 0 when none is
fun phys_find(e: *Emit, array: bool, n: u32, ids: *u32, offs: *u32) u32 {
    var w: u32 = n;
    if (array) { w = 1; }
    var i: usize = 0;
    for (i < e.pkeys.len) {
        val k: *PhysKey = ?e.pkeys.data[i];
        i = i + 1;
        if (k.array != array || k.n != n) { cnt; }
        var j:    u32  = 0;
        var same: bool = true;
        for (j < w && same) {
            same = k.ids[j] == ids[j] && k.offs[j] == offs[j];
            j    = j + 1;
        }
        if (same) { ret k.id; }
    }
    ret 0;
}

fun phys_keep(e: *Emit, array: bool, n: u32, ids: *u32, offs: *u32, id: u32) err[fail.Fail] {
    var k: PhysKey;
    k.array = array;
    k.n     = n;
    k.id    = id;
    var w: u32 = n;
    if (array) { w = 1; }
    var j: u32 = 0;
    for (j < w) {
        k.ids[j]  = ids[j];
        k.offs[j] = offs[j];
        j         = j + 1;
    }
    val pr: res[usize, A.Error] = vector.push[PhysKey](?e.pkeys, k);
    if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
    ret err[fail.Fail].ok{};
}

# records the alignment and extent physical memory holds the type `spv` in, the least
# alignment any type it stands for asks, which an access through a pointer to it carries
fun phys_note(e: *Emit, spv: u32, gt: *type.IrTypeTable, id: type.IrTypeId) err[fail.Fail] {
    val align: u32 = type.natural_align_for_machine(gt, id, e.layout);
    val size:  u32 = type.byte_size_for_machine(gt, id, e.layout);
    val had:   u32 = vec_at(?e.talign, spv);
    if (had != 0 && had < align) { ret err[fail.Fail].ok{}; }
    val ra: err[fail.Fail] = vec_set(?e.talign, spv, align);
    if (sel ra.err) { ret ra; }
    ret vec_set(?e.tsize, spv, size);
}

fun vec_at(v: *Vector[u32], at: u32) u32 {
    if (at::usize >= v.len) { ret 0; }
    ret v.data[at::usize];
}

fun vec_set(v: *Vector[u32], at: u32, value: u32) err[fail.Fail] {
    for (v.len <= at::usize) {
        val pr: res[usize, A.Error] = vector.push[u32](v, 0);
        if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
    }
    v.data[at::usize] = value;
    ret err[fail.Fail].ok{};
}

# a physical pointer is declared once the program holds one: a pointer in memory, made from
# an address or handed between functions. it needs the bufferDeviceAddress feature
fun require_physical(e: *Emit) err[fail.Fail] {
    if (e.physical) { ret err[fail.Fail].ok{}; }
    var loc: source.SrcLoc = source.loc_nil();
    if (e.cur_fn != nil) { loc = mir.refusal_loc(e.cur_fn, e.cur_instr); }
    val r: err[fail.Fail] = require_at(e, loc, e.cur_stages, spirv.CAP_PHYSICAL_STORAGE_BUFFER_ADDRESSES,
        spirv.EXT_BUFFER_DEVICE_ADDRESS, "a pointer held in memory or made from an address, which is a physical pointer into a buffer the host passes by its device address,");
    if (sel r.err) { ret r; }
    e.physical = true;
    ret err[fail.Fail].ok{};
}

# the PhysicalStorageBuffer pointer a pointer type `id` of `gt` is in memory: to the
# explicit-layout type its pointee is held in, or to the record its key names
fun phys_pointer(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) res[u32, fail.Fail] {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: a physical pointer has no pointer type")}; }
    val pt_ir: *type.IrType = opt_.some;
    if (pt_ir.kind != type.IRT_PTR) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: a physical pointer has no pointer type")}; }
    val pointee: type.IrTypeId = pt_ir.data.pointee;
    if (pointee == type.IRT_NIL) {
        ret res[u32, fail.Fail].err{reject_at(e, dkind.SPIRV_UNSUPPORTED, phys_loc(e), "an untyped `ptr` held in memory or made from an address is not supported by the SPIR-V target: a physical pointer is declared with the type it points at, so spell it `*T`")};
    }
    val rq: err[fail.Fail] = require_physical(e);
    if (sel rq.err) { ret res[u32, fail.Fail].err{rq.err}; }
    val pt: opt[*type.IrType] = type.get(gt, pointee);
    if (sel pt.none)                     { ret res[u32, fail.Fail].err{fail.message("spirv.emit: a physical pointer's pointee has no IR type")}; }
    if (pt.some.kind == type.IRT_RECREF) { ret phys_rec_pointer(e, pt.some.data.bits); }
    val lr: res[u32, fail.Fail] = laid_out_type(e, gt, pointee, ROLE_PHYSICAL);
    if (sel lr.err) { ret lr; }
    val ptr: u32 = types.type_ptr(e.tt, spirv.STORAGE_PHYSICAL_STORAGE_BUFFER, lr.ok);
    if (ptr == 0) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: could not declare a physical pointer")}; }
    ret res[u32, fail.Fail].ok{ptr};
}

fun phys_loc(e: *Emit) source.SrcLoc {
    if (e.cur_fn == nil) { ret source.loc_nil(); }
    ret mir.refusal_loc(e.cur_fn, e.cur_instr);
}

# the pointer to the record `key` names: declared with the record, named ahead of it by a
# member of the record's own cycle
fun phys_rec_pointer(e: *Emit, key: u32) res[u32, fail.Fail] {
    val rr: res[u32, fail.Fail] = phys_rec(e, key);
    if (sel rr.err) { ret rr; }
    val ix: u32 = rr.ok;
    if (e.precs.data[ix].strct != 0) { ret res[u32, fail.Fail].ok{e.precs.data[ix].ptr}; }
    if (e.precs.data[ix].building) {
        if (!e.precs.data[ix].forwarded) {
            types.type_forward_pointer(e.tt, e.precs.data[ix].ptr, spirv.STORAGE_PHYSICAL_STORAGE_BUFFER);
            e.precs.data[ix].forwarded = true;
        }
        ret res[u32, fail.Fail].ok{e.precs.data[ix].ptr};
    }
    var m: u32 = 0;
    for (m < e.u.len) {
        val gt:  *type.IrTypeTable = ?e.u.mods[m].ir.types;
        val sid: type.IrTypeId     = type.keyed_struct(gt, key);
        if (sid != type.IRT_NIL) {
            val lr: res[u32, fail.Fail] = laid_out_type(e, gt, sid, ROLE_PHYSICAL);
            if (sel lr.err) { ret lr; }
            ret res[u32, fail.Fail].ok{e.precs.data[ix].ptr};
        }
        m = m + 1;
    }
    ret res[u32, fail.Fail].err{fail.message("spirv.emit: a record reference names no record of the unit")};
}

fun phys_rec(e: *Emit, key: u32) res[u32, fail.Fail] {
    var i: usize = 0;
    for (i < e.precs.len) {
        if (e.precs.data[i].key == key) { ret res[u32, fail.Fail].ok{i::u32}; }
        i = i + 1;
    }
    var r: PhysRec;
    r.key       = key;
    r.ptr       = spirv.alloc_id(e.b);
    r.strct     = 0;
    r.building  = false;
    r.forwarded = false;
    val pr: res[usize, A.Error] = vector.push[PhysRec](?e.precs, r);
    if (sel pr.err) { ret res[u32, fail.Fail].err{fail.refused(pr.err)}; }
    ret res[u32, fail.Fail].ok{(pr.ok - 1)::u32};
}

# the same, for a type query that answers 0 for what it cannot declare: the refusal is held
# for the refusal the 0 becomes
fun phys_pointer_quiet(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) u32 {
    val r: res[u32, fail.Fail] = phys_pointer(e, gt, id);
    if (sel r.ok) { ret r.ok; }
    if (!e.has_held) {
        e.held     = r.err;
        e.has_held = true;
    }
    ret 0;
}

# the alignment an access through the physical pointer `ptr` carries, 0 for a logical one
fun pointer_align(e: *Emit, ptr: u32) u32 {
    ret vec_at(?e.palign, ptr);
}

# notes that `ptr` is a physical pointer of the pointer type `ty`
fun mark_physical_ptr(e: *Emit, ptr: u32, ty: u32) {
    var sc:      u32 = 0;
    val pointee: u32 = types.pointer_shape(e.tt, ty, ?sc);
    if (pointee != 0 && sc == spirv.STORAGE_PHYSICAL_STORAGE_BUFFER) { mark_physical(e, ptr, pointee); }
}

# notes that `ptr` is a physical pointer to the type `pointee`
fun mark_physical(e: *Emit, ptr: u32, pointee: u32) {
    var a: u32 = vec_at(?e.talign, pointee);
    if (a == 0) { a = 1; }
    val r: err[fail.Fail] = vec_set(?e.palign, ptr, a);
    if (sel r.err) { e.b.err = true; }
}

fun round_up_to(v: u32, a: u32) u32 {
    if (a == 0) { ret v; }
    val up: u32 = ((v + a - 1) / a) * a;
    if (up < v) { ret 0; }
    ret up;
}

# a uniform block is laid out by std140-shaped rules, a storage or push-constant block by std430-shaped ones
fun is_std430(role: u8) bool {
    ret role != ir.IFACE_UNIFORM;
}

fun block_role(role: u8) str {
    if (role == ir.IFACE_STORAGE) { ret "#[storage(...)]"; }
    if (role == ir.IFACE_PUSH)    { ret "#[push]"; }
    ret "#[uniform(...)]";
}

# where a member sits, for a refusal: "a `#[storage(...)]` block", or physical memory
fun block_place(role: u8, article: str) str {
    if (role == ROLE_PHYSICAL) { ret "a record a physical pointer reaches, which follows the std430 block rules"; }
    if (str_equals(article, "this")) {
        if (role == ir.IFACE_STORAGE) { ret "this `#[storage(...)]` block"; }
        if (role == ir.IFACE_PUSH)    { ret "this `#[push]` block"; }
        ret "this `#[uniform(...)]` block";
    }
    if (role == ir.IFACE_STORAGE) { ret "a `#[storage(...)]` block"; }
    if (role == ir.IFACE_PUSH)    { ret "a `#[push]` block"; }
    ret "a `#[uniform(...)]` block";
}

fun storage_hint(role: u8) str {
    if (is_std430(role)) { ret ""; }
    ret ", and a `#[storage(...)]` buffer accepts any element width where read-write descriptor semantics are acceptable";
}

fun std_base_align(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, std430: bool) u32 {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret 0; }
    val t: *type.IrType = opt_.some;

    if (t.kind == type.IRT_STRUCT) {
        var a: u32 = 1;
        var i: u32 = 0;
        for (i < t.data.struct_.field_count) {
            val ma: u32 = std_base_align(e, gt, t.data.struct_.fields[i], std430);
            if (ma == 0) { ret 0; }
            if (ma > a)  { a = ma; }
            i = i + 1;
        }
        if (!std430) { ret round_up_to(a, 16); }
        ret a;
    }
    if (t.kind == type.IRT_ARRAY) {
        val ea: u32 = std_base_align(e, gt, t.data.array_.element, std430);
        if (ea == 0) { ret 0; }
        if (!std430) { ret round_up_to(ea, 16); }
        ret ea;
    }
    if (t.kind == type.IRT_VECTOR) {
        val lane: u32 = type.byte_size_for_machine(gt, t.data.vector_.element, e.layout);
        if (t.data.vector_.lanes == 2) { ret 2 * lane; }
        ret 4 * lane;
    }
    if (t.kind == type.IRT_INT || t.kind == type.IRT_FLOAT || t.kind == type.IRT_PTR) {
        ret type.byte_size_for_machine(gt, id, e.layout);
    }
    ret 0;
}

fun std_extent(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, std430: bool) u32 {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret 0; }
    val t: *type.IrType = opt_.some;

    if (t.kind == type.IRT_STRUCT) {
        val a: u32 = std_base_align(e, gt, id, std430);
        if (a == 0) { ret 0; }
        var end: u32 = 0;
        var i:   u32 = 0;
        for (i < t.data.struct_.field_count) {
            val me: u32 = std_extent(e, gt, t.data.struct_.fields[i], std430);
            if (me == 0) { ret 0; }
            val moff: u32 = type.byte_offset_for_machine(gt, id, i, e.layout);
            if (moff + me > end) { end = moff + me; }
            i = i + 1;
        }
        ret round_up_to(end, a);
    }
    if (t.kind == type.IRT_ARRAY) {
        val s: u32 = required_stride(e, gt, t.data.array_.element, std430);
        if (s == 0) { ret 0; }
        ret s * t.data.array_.count;
    }
    ret type.byte_size_for_machine(gt, id, e.layout);
}

fun required_stride(e: *Emit, gt: *type.IrTypeTable, elem: type.IrTypeId, std430: bool) u32 {
    var a: u32 = std_base_align(e, gt, elem, std430);
    if (a == 0)  { ret 0; }
    if (!std430) { a = round_up_to(a, 16); }
    val ext: u32 = std_extent(e, gt, elem, std430);
    if (ext == 0) { ret 0; }
    ret round_up_to(ext, a);
}

fun check_block_layout(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, role: u8) err[fail.Fail] {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret err[fail.Fail].ok{}; }
    val t:      *type.IrType = opt_.some;
    val std430: bool         = is_std430(role);

    var prev_end: u32 = 0;
    var i:        u32 = 0;
    for (i < t.data.struct_.field_count) {
        val fty: type.IrTypeId = t.data.struct_.fields[i];
        val a:   u32           = std_base_align(e, gt, fty, std430);
        if (a == 0) {
            i = i + 1;
            cnt;
        }
        val off: u32 = type.byte_offset_for_machine(gt, id, i, e.layout);

        if ((off % a) != 0 || off < prev_end) {
            var want: u32 = round_up_to(prev_end, a);
            if (want < round_up_to(off, a)) { want = round_up_to(off, a); }
            ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, layout_refusal(e, gt, role, i, fty, off, want, a,
                off < prev_end, prev_end))};
        }
        val ext: u32 = std_extent(e, gt, fty, std430);
        if (ext == 0) {
            i = i + 1;
            cnt;
        }
        prev_end = off + ext;
        i        = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun layout_refusal(e: *Emit, gt: *type.IrTypeTable, role: u8, ix: u32, fty: type.IrTypeId, off: u32,
    want: u32, align: u32, overlaps: bool, prev_end: u32) str {
    var why: str = nil;
    if (overlaps) {
        val wr: res[str, format.FormatError] = format.sprint(e.alloc,
            "the member before it runs to offset {} under those rules and mach's layout ends it sooner, so the two overlap",
            prev_end);
        if (sel wr.ok) { why = wr.ok; }
    }
    or {
        val wr: res[str, format.FormatError] = format.sprint(e.alloc,
            "a member of this type has a base alignment of {} bytes under those rules and mach's layout does not place it on one",
            align);
        if (sel wr.ok) { why = wr.ok; }
    }
    if (why == nil) {
        ret "a member of this block is placed at an offset the SPIR-V block layout rules do not allow";
    }

    val r: res[str, format.FormatError] = format.sprint(e.alloc,
        "member {} of {} ({}) is placed at offset {} by mach's layout and the SPIR-V block layout rules require offset {}: {}. the offsets are the host's contract, so this is refused rather than repacked - repacking would move the members out from under a host writing by `$offset_of`. pad the block explicitly so the member lands where the rules put it, or promote a nested record's members into the block{}",
        ix, block_place(role, "this"), ir_type_spelling(gt, e.alloc, fty), off, want,
        why, storage_hint(role));
    if (sel r.err) {
        ret "a member of this block is placed at an offset the SPIR-V block layout rules do not allow";
    }
    ret r.ok;
}

fun build_iface_uses(e: *Emit) err[fail.Fail] {
    if (e.iface_len == 0 || e.fn_len == 0) { ret err[fail.Fail].ok{}; }
    val cells: u32               = e.fn_len * e.iface_len;
    val ru:    res[*u8, A.Error] = A.allocate[u8](e.alloc, cells::usize);
    if (sel ru.err) { ret err[fail.Fail].err{fail.refused(ru.err)}; }
    e.iface_use = ru.ok;
    var c: u32 = 0;
    for (c < cells) {
        e.iface_use[c] = 0;
        c              = c + 1;
    }

    var fx: u32 = 0;
    for (fx < e.fn_len) {
        val mf: *mir.MirFunction = fn_mir(e, fx);
        if (mf == nil) {
            fx = fx + 1;
            cnt;
        }
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii:  u32           = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                var oi: u32           = 0;
                for (oi < mi.operand_count) {
                    if (mi.operands[oi].kind == mir.MIR_OP_SYM) {
                        val slot: u32 = iface_slot_of(e, mi.operands[oi].sym);
                        if (slot != 0) { e.iface_use[fx * e.iface_len + slot - 1] = 1; }
                    }
                    oi = oi + 1;
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        fx = fx + 1;
    }

    var changed: bool = true;
    for (changed) {
        changed = false;
        fx      = 0;
        for (fx < e.fn_len) {
            var ci: u32 = 0;
            for (ci < callee_count(e, fx)) {
                val cx: u32 = callee_at(e, fx, ci);
                if (cx != FN_NONE) {
                    var s: u32 = 0;
                    for (s < e.iface_len) {
                        if (e.iface_use[cx * e.iface_len + s] != 0
                            && e.iface_use[fx * e.iface_len + s] == 0) {
                            e.iface_use[fx * e.iface_len + s] = 1;
                            changed                           = true;
                        }
                        s = s + 1;
                    }
                }
                ci = ci + 1;
            }
            fx = fx + 1;
        }
    }
    ret err[fail.Fail].ok{};
}

fun uses_iface(e: *Emit, fn_ix: u32, slot: u32) bool {
    if (e.iface_use == nil || fn_ix >= e.fn_len || slot >= e.iface_len) { ret false; }
    ret e.iface_use[fn_ix * e.iface_len + slot] != 0;
}

fun iface_slot_of(e: *Emit, name: intern.StrId) u32 {
    if (e.gslot == nil) { ret 0; }
    val gx: u32 = gl_lookup(e, name);
    if (gx == GL_NONE) { ret 0; }
    ret e.gslot[gx];
}

fun check_call_graph(e: *Emit) err[fail.Fail] {
    val n: u32 = e.fn_len;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val rs: res[*u8, A.Error] = A.allocate[u8](e.alloc, n::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    val state: *u8                = rs.ok;
    val rp:    res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rp.err) {
        A.deallocate[u8](e.alloc, state, n::usize);
        ret err[fail.Fail].err{fail.refused(rp.err)};
    }
    val path: *u32 = rp.ok;

    var i: u32 = 0;
    for (i < n) {
        state[i] = 0;
        path[i]  = 0;
        i        = i + 1;
    }

    var msg: str = nil;
    i = 0;
    for (i < n && msg == nil) {
        if (state[i] == 0 && e.fns[i].emit) { msg = cg_visit(e, state, path, 0, i); }
        i = i + 1;
    }

    A.deallocate[u8](e.alloc, state, n::usize);
    A.deallocate[u32](e.alloc, path, n::usize);
    if (msg != nil) { ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_RECURSION, msg)}; }
    ret err[fail.Fail].ok{};
}

fun cg_visit(e: *Emit, state: *u8, path: *u32, depth: u32, ix: u32) str {
    state[ix]   = 1;
    path[depth] = ix;

    var ci: u32 = 0;
    for (ci < callee_count(e, ix)) {
        val cx: u32 = callee_at(e, ix, ci);
        if (cx != FN_NONE && emittable(e, cx)) {
            if (state[cx] == 1) { ret cycle_refusal(e, path, depth + 1, cx); }
            if (state[cx] == 0) {
                val sub: str = cg_visit(e, state, path, depth + 1, cx);
                if (sub != nil) { ret sub; }
            }
        }
        ci = ci + 1;
    }

    state[ix] = 2;
    ret nil;
}

fun cycle_refusal(e: *Emit, path: *u32, depth: u32, closes: u32) str {
    var chain: str = ir_fn_spelling(e, closes);
    var i:     u32 = 0;
    for (i < depth && path[i] != closes) { i = i + 1; }
    for (i < depth) {
        val r: res[str, format.FormatError] = format.sprint(e.alloc, "{} -> {}", chain,
            ir_fn_spelling(e, path[i]));
        if (sel r.err) {
            i = depth;
            cnt;
        }
        chain = r.ok;
        i     = i + 1;
    }
    val r2: res[str, format.FormatError] = format.sprint(e.alloc,
        "this call graph is a cycle and the SPIR-V target cannot express it: {}. a SPIR-V execution model has no call stack, so a function may not be reachable from itself. rewrite the recursion as a loop",
        chain);
    if (sel r2.err) {
        ret "a recursive call is not expressible in the SPIR-V target: a SPIR-V execution model has no call stack, so a function may not be reachable from itself";
    }
    ret r2.ok;
}

# the stages that reach each function: an entry point's own, carried to everything it calls
fun build_fn_stages(e: *Emit) err[fail.Fail] {
    if (e.fn_len == 0) { ret err[fail.Fail].ok{}; }
    val rs: res[*u8, A.Error] = A.allocate[u8](e.alloc, e.fn_len::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    e.fn_stages = rs.ok;
    var fx: u32 = 0;
    for (fx < e.fn_len) {
        e.fn_stages[fx] = 0;
        if (e.fns[fx].emit) { e.fn_stages[fx] = stage_bit(fn_ir(e, fx).stage); }
        fx = fx + 1;
    }
    var changed: bool = true;
    for (changed) {
        changed = false;
        fx      = 0;
        for (fx < e.fn_len) {
            var ci: u32 = 0;
            for (ci < callee_count(e, fx)) {
                val cx: u32 = callee_at(e, fx, ci);
                if (cx != FN_NONE && (e.fn_stages[fx] & ~e.fn_stages[cx]) != 0) {
                    e.fn_stages[cx] = e.fn_stages[cx] | e.fn_stages[fx];
                    changed         = true;
                }
                ci = ci + 1;
            }
            fx = fx + 1;
        }
    }
    ret err[fail.Fail].ok{};
}

fun check_stage_interfaces(e: *Emit) err[fail.Fail] {
    val n: u32 = e.gl_len;
    if (e.iface_len == 0 || n == 0) { ret err[fail.Fail].ok{}; }

    val rf: res[*u8, A.Error] = A.allocate[u8](e.alloc, n::usize);
    if (sel rf.err) { ret err[fail.Fail].err{fail.refused(rf.err)}; }
    val flat: *u8 = rf.ok;
    var i:    u32 = 0;
    for (i < n) {
        flat[i] = 0;
        i       = i + 1;
    }

    var msg: str = nil;
    var fx:  u32 = 0;
    for (fx < e.fn_len && msg == nil) {
        if (!e.fns[fx].emit) {
            fx = fx + 1;
            cnt;
        }
        val fn: *ir.Function = fn_ir(e, fx);
        if (fn.stage == ir.STAGE_NONE) {
            fx = fx + 1;
            cnt;
        }
        i = 0;
        for (i < n) {
            if (e.gslot[i] == 0 || !uses_iface(e, fx, e.gslot[i] - 1)) {
                i = i + 1;
                cnt;
            }
            val gi: *ir.Global = gl_ir(e, i);
            if (gi.iface == ir.IFACE_SHARED && fn.stage != ir.STAGE_COMPUTE) {
                msg = shared_stage_refusal(e, fx, i);
                i   = n;
                cnt;
            }
            if (e.gstorage[i] == spirv.STORAGE_INPUT && needs_flat(gl_types(e, i), gi.ty)) {
                if (fn.stage == ir.STAGE_FRAGMENT) { flat[i] = flat[i] | 1; }
                or (fn.stage == ir.STAGE_VERTEX)   { flat[i] = flat[i] | 2; }
                if (flat[i] == 3) {
                    msg = flat_conflict(e, i);
                    i   = n;
                    cnt;
                }
            }
            if (gi.iface == ir.IFACE_BUILTIN) {
                msg = builtin_stage_refusal(e, fx, i);
                if (msg != nil) {
                    i = n;
                    cnt;
                }
                val rq: err[fail.Fail] = require_at(e, source.loc_nil(), stage_bit(fn.stage),
                    builtin_capability(gi.iface_a), 0, builtin_use_text(e, fx, i));
                if (sel rq.err) {
                    A.deallocate[u8](e.alloc, flat, n::usize);
                    ret rq;
                }
            }
            if (gi.iface == ir.IFACE_INPUT || gi.iface == ir.IFACE_OUTPUT) {
                msg = location_overlap(e, fx, i);
                if (msg != nil) {
                    i = n;
                    cnt;
                }
            }
            if (gi.iface == ir.IFACE_UNIFORM || gi.iface == ir.IFACE_STORAGE
                || gi.iface == ir.IFACE_SAMPLER) {
                msg = descriptor_overlap(e, fx, i);
                if (msg != nil) {
                    i = n;
                    cnt;
                }
            }
            if (gi.iface == ir.IFACE_PUSH) {
                msg = push_overlap(e, fx, i);
                if (msg != nil) {
                    i = n;
                    cnt;
                }
            }
            i = i + 1;
        }
        fx = fx + 1;
    }

    if (msg == nil) {
        i = 0;
        for (i < n) {
            if ((flat[i] & 1) != 0) { decorate_bare(e, e.gvar_ids[i], spirv.DECOR_FLAT); }
            i = i + 1;
        }
    }
    A.deallocate[u8](e.alloc, flat, n::usize);
    if (msg != nil) { ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, msg)}; }
    ret err[fail.Fail].ok{};
}

fun shared_stage_refusal(e: *Emit, fx: u32, gi: u32) str {
    val g: *ir.Global                   = gl_ir(e, gi);
    val r: res[str, format.FormatError] = format.sprint(e.alloc,
        "this `#[shared]` variable, {}{}, is used by the stage `{}`, which is not a compute stage: workgroup memory exists only in a compute stage, where one workgroup's invocations share it. a vertex or fragment stage has no workgroup to share it with",
        ir_type_spelling(gl_types(e, gi), e.alloc, g.ty), gl_mod_prefix(e, gi), ir_fn_spelling(e, fx));
    if (sel r.err) {
        ret "a `#[shared]` variable is used by a stage that is not a compute stage: workgroup memory exists only in a compute stage";
    }
    ret r.ok;
}

fun flat_conflict(e: *Emit, gi: u32) str {
    val g: *ir.Global                   = gl_ir(e, gi);
    val r: res[str, format.FormatError] = format.sprint(e.alloc,
        "this `#[input({})]` variable, {}{}, is read by a vertex stage and by a fragment stage, and no SPIR-V module serves both: a fragment stage's integer or 64-bit input MUST carry a Flat decoration because such a value cannot be interpolated, and a vertex stage's input must NOT carry one. declare two variables. the two are different things anyway - a vertex stage's input is a vertex attribute, and a fragment stage's is the interpolated output of the stage before it",
        g.iface_a, ir_type_spelling(gl_types(e, gi), e.alloc, g.ty), gl_mod_prefix(e, gi));
    if (sel r.err) {
        ret "an integer or 64-bit `#[input(...)]` cannot be read by a vertex stage and a fragment stage at once: the fragment stage requires a Flat decoration and the vertex stage forbids one";
    }
    ret r.ok;
}

fun location_overlap(e: *Emit, fx: u32, gi: u32) str {
    val g:    *ir.Global = gl_ir(e, gi);
    val lo:   u32        = g.iface_a;
    val span: u32        = location_span(e, gl_types(e, gi), g.ty);
    var j:    u32        = 0;
    for (j < gi) {
        val o: *ir.Global = gl_ir(e, j);
        if (o.iface != g.iface) {
            j = j + 1;
            cnt;
        }
        if (e.gslot[j] == 0 || !uses_iface(e, fx, e.gslot[j] - 1)) {
            j = j + 1;
            cnt;
        }
        val olo:   u32 = o.iface_a;
        val ospan: u32 = location_span(e, gl_types(e, j), o.ty);
        if (lo < olo + ospan && olo < lo + span) {
            var what: str = "input";
            if (g.iface == ir.IFACE_OUTPUT) { what = "output"; }
            val fr: res[str, format.FormatError] = format.sprint(e.alloc,
                "two `#[{}(...)]` variables overlap in the stage `{}`: `#[{}({})]`, {}{}, occupies {} location(s) and so runs through location {}, and `#[{}({})]`, {}{}, starts inside it. a type wider than one location consumes the ones that follow it, so the numbers an author writes have to leave room for the type",
                what, ir_fn_spelling(e, fx), what, olo,
                ir_type_spelling(gl_types(e, j), e.alloc, o.ty), gl_mod_prefix(e, j),
                ospan, olo + ospan - 1,
                what, lo, ir_type_spelling(gl_types(e, gi), e.alloc, g.ty), gl_mod_prefix(e, gi));
            if (sel fr.err) {
                ret "two shader interface variables occupy the same location: a type wider than one location consumes the ones that follow it";
            }
            ret fr.ok;
        }
        j = j + 1;
    }
    ret nil;
}

fun descriptor_overlap(e: *Emit, fx: u32, gi: u32) str {
    val g: *ir.Global = gl_ir(e, gi);
    var j: u32        = 0;
    for (j < gi) {
        val o: *ir.Global = gl_ir(e, j);
        if (o.iface != ir.IFACE_UNIFORM && o.iface != ir.IFACE_STORAGE
            && o.iface != ir.IFACE_SAMPLER) {
            j = j + 1;
            cnt;
        }
        if (e.gslot[j] == 0 || !uses_iface(e, fx, e.gslot[j] - 1)) {
            j = j + 1;
            cnt;
        }
        if (o.iface_a != g.iface_a || o.iface_b != g.iface_b) {
            j = j + 1;
            cnt;
        }
        val fr: res[str, format.FormatError] = format.sprint(e.alloc,
            "two descriptor-bound variables claim the same `(set = {}, binding = {})` in the stage `{}`: `{}`, {}{}, and `{}`, {}{}. a host binds one resource to a descriptor slot, so a pipeline layout can satisfy only one of them and the other would read whatever the first was bound to. give them different bindings",
            g.iface_a, g.iface_b, ir_fn_spelling(e, fx),
            descriptor_role(o.iface), ir_type_spelling(gl_types(e, j), e.alloc, o.ty), gl_mod_prefix(e, j),
            descriptor_role(g.iface), ir_type_spelling(gl_types(e, gi), e.alloc, g.ty), gl_mod_prefix(e, gi));
        if (sel fr.err) {
            ret "two descriptor-bound variables claim the same descriptor set and binding: a pipeline layout can satisfy only one of them";
        }
        ret fr.ok;
    }
    ret nil;
}

# vulkan admits one push-constant block per entry point, so a second one a stage uses is refused naming both
fun push_overlap(e: *Emit, fx: u32, gi: u32) str {
    var j: u32 = 0;
    for (j < gi) {
        if (gl_ir(e, j).iface != ir.IFACE_PUSH || e.gslot[j] == 0 || !uses_iface(e, fx, e.gslot[j] - 1)) {
            j = j + 1;
            cnt;
        }
        val fr: res[str, format.FormatError] = format.sprint(e.alloc,
            "the stage `{}` uses two `#[push]` blocks, `{}`{} and `{}`{}: Vulkan admits at most one push-constant block per entry point, because a pipeline layout declares the push-constant range each stage sees as one block. merge them into one record, or keep each to a different stage",
            ir_fn_spelling(e, fx), gl_spelling(e, j), gl_mod_prefix(e, j),
            gl_spelling(e, gi), gl_mod_prefix(e, gi));
        if (sel fr.err) {
            ret "a stage uses two `#[push]` blocks: Vulkan admits at most one push-constant block per entry point";
        }
        ret fr.ok;
    }
    ret nil;
}

fun gl_spelling(e: *Emit, ix: u32) str {
    val g: *ir.Global   = gl_ir(e, ix);
    var n: intern.StrId = g.disp;
    if (n == intern.STR_NIL) { n = g.name; }
    val o: opt[str] = intern.lookup(e.interner, n);
    if (sel o.none) { ret "<unknown variable>"; }
    ret o.some;
}

fun descriptor_role(iface: u8) str {
    if (iface == ir.IFACE_STORAGE) { ret "#[storage(...)]"; }
    if (iface == ir.IFACE_SAMPLER) { ret "#[sampler(...)]"; }
    ret "#[uniform(...)]";
}

fun location_span(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) u32 {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret 1; }
    val t: *type.IrType = opt_.some;
    if (t.kind == type.IRT_STRUCT) {
        var total: u32 = 0;
        var i:     u32 = 0;
        for (i < t.data.struct_.field_count) {
            total = total + location_span(e, gt, t.data.struct_.fields[i]);
            i     = i + 1;
        }
        if (total == 0) { ret 1; }
        ret total;
    }
    if (t.kind == type.IRT_ARRAY) {
        val es: u32 = location_span(e, gt, t.data.array_.element);
        if (t.data.array_.count == 0) { ret 1; }
        ret es * t.data.array_.count;
    }
    if (t.kind == type.IRT_TAG) {
        var total: u32 = 1;
        var ci:    u32 = 0;
        for (ci < t.data.tag_.case_count) {
            if (type.tag_case_has_payload(gt, id, ci)) { total = total + location_span(e, gt, t.data.tag_.cases[ci]); }
            ci = ci + 1;
        }
        ret total;
    }
    val bytes: u32 = type.byte_size_for_machine(gt, id, e.layout);
    if (bytes <= 16) { ret 1; }
    ret (bytes + 15) / 16;
}

fun needs_flat(tt: *type.IrTypeTable, id: type.IrTypeId) bool {
    var lanes:    u32  = 0;
    var bits:     u32  = 0;
    var is_float: bool = false;
    if (!ir_scalar_shape(tt, id, ?lanes, ?bits, ?is_float)) { ret false; }
    if (!is_float)                                          { ret true; }
    ret bits == 64;
}

# the memory qualifiers a descriptor binding declares, whatever the binding holds. the
# Vulkan memory model has no Coherent decoration: each access through a coherent
# variable makes its own write available or its read visible instead
fun decorate_memory_quals(e: *Emit, var_id: u32, flags: u32) {
    if ((flags & ir.IFACE_FLAG_WRITEONLY) != 0)                { decorate_bare(e, var_id, spirv.DECOR_NON_READABLE); }
    if ((flags & ir.IFACE_FLAG_COHERENT) != 0 && !e.vulkan_mm) { decorate_bare(e, var_id, spirv.DECOR_COHERENT); }
}

# the scope a variable's accesses are made available and visible at under the Vulkan
# memory model, 0 when they are private. workgroup memory is coherent among the
# workgroup's invocations, as it is under GLSL450, and a coherent binding among the
# invocations of the queue family, the scope glslang gives `coherent`, which needs no
# device-scope feature
fun variable_scope(storage: u32, flags: u32) u32 {
    if (storage == spirv.STORAGE_WORKGROUP)    { ret spirv.SCOPE_WORKGROUP; }
    if ((flags & ir.IFACE_FLAG_COHERENT) != 0) { ret spirv.SCOPE_QUEUE_FAMILY; }
    ret 0;
}

fun mark_memory_scope(e: *Emit, ptr: u32, scope: u32) err[fail.Fail] {
    if (scope == 0 && ptr::usize >= e.pscope.len) { ret err[fail.Fail].ok{}; }
    for (e.pscope.len <= ptr::usize) {
        val pr: res[usize, A.Error] = vector.push[u8](?e.pscope, 0);
        if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
    }
    e.pscope.data[ptr::usize] = scope::u8;
    ret err[fail.Fail].ok{};
}

fun memory_scope_of(e: *Emit, ptr: u32) u32 {
    if (ptr::usize >= e.pscope.len) { ret 0; }
    ret e.pscope.data[ptr::usize]::u32;
}

# an access chain's accesses share the scope of the pointer it walks from
fun chain_memory_scope(e: *Emit, result: u32, base: u32) {
    if (!e.vulkan_mm) { ret; }
    val r: err[fail.Fail] = mark_memory_scope(e, result, memory_scope_of(e, base));
    if (sel r.err) { e.b.err = true; }
}

fun decorate_bare(e: *Emit, target: u32, decor: u32) {
    var ops: [2]u32;
    ops[0] = target;
    ops[1] = decor;
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?ops[0], 2);
}

fun ir_fn_spelling(e: *Emit, ix: u32) str {
    if (ix >= e.fn_len) { ret "<unknown function>"; }
    val fn:   *ir.Function = fn_ir(e, ix);
    var name: str          = nil;
    if (fn.disp != intern.STR_NIL) {
        val d: opt[str] = intern.lookup(e.interner, fn.disp);
        if (sel d.some) { name = d.some; }
    }
    if (name == nil) {
        val o: opt[str] = intern.lookup(e.interner, fn.name);
        if (sel o.none) { ret "<unknown function>"; }
        name = o.some;
    }
    if (e.fns[ix].mi == e.u.root) { ret name; }
    val mo: opt[str] = intern.lookup(e.interner, fn_mod(e, ix).name);
    if (sel mo.none) { ret name; }
    val q: res[str, format.FormatError] = format.sprint(e.alloc, "{}.{}", mo.some, name);
    if (sel q.err) { ret name; }
    ret q.ok;
}

fun decorate(e: *Emit, target: u32, decor: u32, operand: u32) {
    var ops: [3]u32;
    ops[0] = target;
    ops[1] = decor;
    ops[2] = operand;
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?ops[0], 3);
}

fun builtin_required_type(which: u32, out_lanes: *u32, out_bits: *u32, out_is_float: *bool) str {
    @out_lanes    = 1;
    @out_bits     = 32;
    @out_is_float = true;
    if (which == ir.BUILTIN_POSITION || which == ir.BUILTIN_FRAG_COORD) {
        @out_lanes = 4;
        ret "`f32x4`, a four-component float vector";
    }
    if (which == ir.BUILTIN_POINT_SIZE) {
        ret "`f32`, a scalar float";
    }
    if (which == ir.BUILTIN_GLOBAL_INVOCATION || which == ir.BUILTIN_LOCAL_INVOCATION
        || which == ir.BUILTIN_WORKGROUP_ID || which == ir.BUILTIN_NUM_WORKGROUPS) {
        @out_lanes    = 3;
        @out_is_float = false;
        ret "`u32x3`, a three-component 32-bit unsigned vector";
    }
    @out_is_float = false;
    ret "`u32` or `i32`, a scalar 32-bit integer";
}

fun builtin_type_refusal(tt: *type.IrTypeTable, alloc: *A.Allocator, which: u32,
    ty: type.IrTypeId) str {
    var want_lanes:    u32  = 0;
    var want_bits:     u32  = 0;
    var want_is_float: bool = false;
    val want:          str  = builtin_required_type(which, ?want_lanes, ?want_bits, ?want_is_float);

    var got_lanes:    u32  = 0;
    var got_bits:     u32  = 0;
    var got_is_float: bool = false;
    if (ir_scalar_shape(tt, ty, ?got_lanes, ?got_bits, ?got_is_float)
        && got_lanes == want_lanes && got_bits == want_bits && got_is_float == want_is_float) {
        ret nil;
    }

    val r: res[str, format.FormatError] = format.sprint(alloc,
        "this `#[builtin(\"{}\")]` variable is declared {}, and SPIR-V specifies it as {}. the requirement is on the variable's TYPE rather than on how it is read, so a wider or narrower one is an invalid module rather than a wasteful one",
        builtin_spelling(which), ir_type_spelling(tt, alloc, ty), want);
    if (sel r.err) {
        ret "this `#[builtin(\"...\")]` variable is declared at a type SPIR-V does not specify for it";
    }
    ret r.ok;
}

fun builtin_spelling(which: u32) str {
    if (which == ir.BUILTIN_VERTEX_INDEX)           { ret "vertex_index"; }
    if (which == ir.BUILTIN_INSTANCE_INDEX)         { ret "instance_index"; }
    if (which == ir.BUILTIN_FRAG_COORD)             { ret "frag_coord"; }
    if (which == ir.BUILTIN_POINT_SIZE)             { ret "point_size"; }
    if (which == ir.BUILTIN_GLOBAL_INVOCATION)      { ret "global_invocation"; }
    if (which == ir.BUILTIN_LOCAL_INVOCATION)       { ret "local_invocation"; }
    if (which == ir.BUILTIN_WORKGROUP_ID)           { ret "workgroup_id"; }
    if (which == ir.BUILTIN_NUM_WORKGROUPS)         { ret "num_workgroups"; }
    if (which == ir.BUILTIN_LOCAL_INVOCATION_INDEX) { ret "local_invocation_index"; }
    if (which == ir.BUILTIN_SUBGROUP_SIZE)          { ret "subgroup_size"; }
    if (which == ir.BUILTIN_SUBGROUP_INVOCATION)    { ret "subgroup_invocation"; }
    if (which == ir.BUILTIN_SUBGROUP_ID)            { ret "subgroup_id"; }
    if (which == ir.BUILTIN_NUM_SUBGROUPS)          { ret "num_subgroups"; }
    ret "position";
}

fun ir_scalar_shape(tt: *type.IrTypeTable, id: type.IrTypeId, out_lanes: *u32,
    out_bits: *u32, out_is_float: *bool) bool {
    @out_lanes    = 0;
    @out_bits     = 0;
    @out_is_float = false;
    val opt_: opt[*type.IrType] = type.get(tt, id);
    if (sel opt_.none) { ret false; }
    val t: *type.IrType = opt_.some;
    if (t.kind == type.IRT_FLOAT) {
        @out_lanes    = 1;
        @out_bits     = t.data.bits;
        @out_is_float = true;
        ret true;
    }
    if (t.kind == type.IRT_INT) {
        @out_lanes = 1;
        @out_bits  = t.data.bits;
        ret true;
    }
    if (t.kind != type.IRT_VECTOR) { ret false; }
    val eopt: opt[*type.IrType] = type.get(tt, t.data.vector_.element);
    if (sel eopt.none) { ret false; }
    val et: *type.IrType = eopt.some;
    if (et.kind != type.IRT_FLOAT && et.kind != type.IRT_INT) { ret false; }
    @out_lanes    = t.data.vector_.lanes;
    @out_bits     = et.data.bits;
    @out_is_float = et.kind == type.IRT_FLOAT;
    ret true;
}

fun ir_type_spelling(tt: *type.IrTypeTable, alloc: *A.Allocator, id: type.IrTypeId) str {
    var lanes:    u32  = 0;
    var bits:     u32  = 0;
    var is_float: bool = false;
    val shaped:   bool = ir_scalar_shape(tt, id, ?lanes, ?bits, ?is_float);
    # an f16 is carried in the ir as a binary16 integer, and is spelled as the f16 it is
    if (shaped && !is_float && bits == 16) {
        var lane: type.IrTypeId     = id;
        val o:    opt[*type.IrType] = type.get(tt, id);
        if (sel o.some) {
            if (o.some.kind == type.IRT_VECTOR) { lane = o.some.data.vector_.element; }
        }
        is_float = type.int_form(tt, lane) == type.INT_FORM_BINARY16;
    }
    if (!shaped) {
        val opt_: opt[*type.IrType] = type.get(tt, id);
        if (sel opt_.none) { ret "an unresolved type"; }
        val k: type.IrTypeKind = opt_.some.kind;
        if (k == type.IRT_PTR)    { ret "a pointer"; }
        if (k == type.IRT_ARRAY)  { ret "an array"; }
        if (k == type.IRT_STRUCT) { ret "a record"; }
        if (k == type.IRT_UNION)  { ret "a union"; }
        if (k == type.IRT_TAG)    { ret "a tag"; }
        ret "a type with no scalar shape";
    }
    var r: res[str, format.FormatError];
    if (is_float && lanes == 1) { r = format.sprint(alloc, "`f{}`", bits); }
    or (is_float)               { r = format.sprint(alloc, "`f{}x{}`", bits, lanes); }
    or (lanes == 1)             { r = format.sprint(alloc, "`i{}` / `u{}`", bits, bits); }
    or                          { r = format.sprint(alloc, "`i{}x{}` / `u{}x{}`", bits, lanes, bits, lanes); }
    if (sel r.err)              { ret "a type this diagnostic could not render"; }
    ret r.ok;
}

fun builtin_selector(which: u32) u32 {
    if (which == ir.BUILTIN_VERTEX_INDEX)           { ret spirv.BUILTIN_VERTEX_INDEX; }
    if (which == ir.BUILTIN_INSTANCE_INDEX)         { ret spirv.BUILTIN_INSTANCE_INDEX; }
    if (which == ir.BUILTIN_FRAG_COORD)             { ret spirv.BUILTIN_FRAG_COORD; }
    if (which == ir.BUILTIN_POINT_SIZE)             { ret spirv.BUILTIN_POINT_SIZE; }
    if (which == ir.BUILTIN_GLOBAL_INVOCATION)      { ret spirv.BUILTIN_GLOBAL_INVOCATION_ID; }
    if (which == ir.BUILTIN_LOCAL_INVOCATION)       { ret spirv.BUILTIN_LOCAL_INVOCATION_ID; }
    if (which == ir.BUILTIN_WORKGROUP_ID)           { ret spirv.BUILTIN_WORKGROUP_ID; }
    if (which == ir.BUILTIN_NUM_WORKGROUPS)         { ret spirv.BUILTIN_NUM_WORKGROUPS; }
    if (which == ir.BUILTIN_LOCAL_INVOCATION_INDEX) { ret spirv.BUILTIN_LOCAL_INVOCATION_INDEX; }
    if (which == ir.BUILTIN_SUBGROUP_SIZE)          { ret spirv.BUILTIN_SUBGROUP_SIZE; }
    if (which == ir.BUILTIN_SUBGROUP_INVOCATION)    { ret spirv.BUILTIN_SUBGROUP_LOCAL_INVOCATION_ID; }
    if (which == ir.BUILTIN_SUBGROUP_ID)            { ret spirv.BUILTIN_SUBGROUP_ID; }
    if (which == ir.BUILTIN_NUM_SUBGROUPS)          { ret spirv.BUILTIN_NUM_SUBGROUPS; }
    ret spirv.BUILTIN_POSITION;
}

# a set of pipeline stages, one bit per ir stage
fun stage_bit(stage: u8) u8 {
    if (stage == ir.STAGE_NONE) { ret 0; }
    ret (1 << stage)::u8;
}

val STAGES_ALL:      u8 = 0x0E;
val STAGES_GRAPHICS: u8 = 0x06;

# the stages a built-in exists in, per the SPIR-V and vulkan built-in tables for the
# vertex, fragment and glcompute execution models, in the direction builtin_storage gives it
fun builtin_stages(which: u32) u8 {
    if (which == ir.BUILTIN_POSITION || which == ir.BUILTIN_POINT_SIZE
        || which == ir.BUILTIN_VERTEX_INDEX || which == ir.BUILTIN_INSTANCE_INDEX) {
        ret stage_bit(ir.STAGE_VERTEX);
    }
    if (which == ir.BUILTIN_FRAG_COORD) {
        ret stage_bit(ir.STAGE_FRAGMENT);
    }
    if (which == ir.BUILTIN_GLOBAL_INVOCATION || which == ir.BUILTIN_LOCAL_INVOCATION
        || which == ir.BUILTIN_WORKGROUP_ID || which == ir.BUILTIN_NUM_WORKGROUPS
        || which == ir.BUILTIN_LOCAL_INVOCATION_INDEX || which == ir.BUILTIN_SUBGROUP_ID
        || which == ir.BUILTIN_NUM_SUBGROUPS) {
        ret stage_bit(ir.STAGE_COMPUTE);
    }
    ret STAGES_ALL;
}

# the capability a built-in needs declared, NO_OP_CAPABILITY for one the Shader capability covers
fun builtin_capability(which: u32) u32 {
    if (which == ir.BUILTIN_SUBGROUP_SIZE || which == ir.BUILTIN_SUBGROUP_INVOCATION
        || which == ir.BUILTIN_SUBGROUP_ID || which == ir.BUILTIN_NUM_SUBGROUPS) {
        ret spirv.CAP_GROUP_NON_UNIFORM;
    }
    ret isa.NO_OP_CAPABILITY;
}

fun stage_spelling(stage: u8) str {
    if (stage == ir.STAGE_VERTEX)   { ret "vertex"; }
    if (stage == ir.STAGE_FRAGMENT) { ret "fragment"; }
    if (stage == ir.STAGE_COMPUTE)  { ret "compute"; }
    ret "none";
}

# "compute", "vertex or fragment"
fun stages_spelling(e: *Emit, stages: u8) str {
    var out: str = nil;
    var st:  u8  = ir.STAGE_VERTEX;
    for (st <= ir.STAGE_COMPUTE) {
        if ((stages & stage_bit(st)) != 0) {
            if (out == nil) { out = stage_spelling(st); }
            or {
                val r: res[str, format.FormatError] = format.sprint(e.alloc, "{} or {}", out, stage_spelling(st));
                if (sel r.ok) { out = r.ok; }
            }
        }
        st = st + 1;
    }
    if (out == nil) { ret "none"; }
    ret out;
}

fun builtin_stage_refusal(e: *Emit, fx: u32, gi: u32) str {
    val g:    *ir.Global = gl_ir(e, gi);
    val want: u8         = builtin_stages(g.iface_a);
    val have: u8         = fn_ir(e, fx).stage;
    if ((want & stage_bit(have)) != 0) { ret nil; }
    var r: res[str, format.FormatError];
    if (builtin_storage(g.iface_a) == spirv.STORAGE_OUTPUT) {
        r = format.sprint(e.alloc,
            "the {} stage `{}` uses the `#[builtin(\"{}\")]` variable{}, and SPIR-V defines that built-in only as an output of a {} stage: the pipeline consumes it from that execution model alone, so no other stage may use it",
            stage_spelling(have), ir_fn_spelling(e, fx), builtin_spelling(g.iface_a),
            gl_mod_prefix(e, gi), stages_spelling(e, want));
    }
    or {
        r = format.sprint(e.alloc,
            "the {} stage `{}` uses the `#[builtin(\"{}\")]` variable{}, and SPIR-V defines that built-in only in a {} stage: the pipeline supplies it to that execution model alone, so no other stage has a value to read",
            stage_spelling(have), ir_fn_spelling(e, fx), builtin_spelling(g.iface_a),
            gl_mod_prefix(e, gi), stages_spelling(e, want));
    }
    if (sel r.err) {
        ret "a `#[builtin(...)]` variable is used by a stage SPIR-V does not define it in";
    }
    ret r.ok;
}

fun builtin_storage(which: u32) u32 {
    if (which == ir.BUILTIN_POSITION || which == ir.BUILTIN_POINT_SIZE) {
        ret spirv.STORAGE_OUTPUT;
    }
    ret spirv.STORAGE_INPUT;
}

fun global_var_id(e: *Emit, name: intern.StrId) u32 {
    if (e.gvar_ids == nil) { ret 0; }
    val gx: u32 = gl_lookup(e, name);
    if (gx == GL_NONE) { ret 0; }
    ret e.gvar_ids[gx];
}

# the environment pins the version before anything is emitted, since which forms a
# module may use depends on it
fun select_version(e: *Emit) err[fail.Fail] {
    val env_id: u32 = e.tgt.identity.env_id;
    if (env_id == isa.ENV_NONE) { ret err[fail.Fail].ok{}; }
    val profile: *spirv.EnvProfile = spirv.env_profile(e.tgt.identity.env_profile);
    if (profile == nil) { ret err[fail.Fail].err{fail.message("spirv: the target names an environment this backend has no profile for")}; }
    e.b.version = profile.version;
    if (e.vulkan_mm && e.b.version < spirv.SPV_VERSION_1_3) {
        val r: res[str, format.FormatError] = format.sprint(e.alloc,
            "the target selects the `vulkan_memory_model` extension, and the Vulkan memory model is defined from SPIR-V 1.3, where SPV_KHR_vulkan_memory_model brings it, while the `{}` environment selects SPIR-V {}.{}: raise `env` to `{}` or later, or leave the extension out for the GLSL450 model",
            profile.name, spirv.version_major(e.b.version), spirv.version_minor(e.b.version), spirv.env_name_from(spirv.SPV_VERSION_1_3));
        if (sel r.err) { ret err[fail.Fail].err{fail.format_refused(r.err)}; }
        ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_CAPABILITY, r.ok)};
    }
    ret err[fail.Fail].ok{};
}

fun check_environment(e: *Emit) err[fail.Fail] {
    val env_id: u32 = e.tgt.identity.env_id;
    if (env_id == isa.ENV_NONE) { ret err[fail.Fail].ok{}; }
    val profile: *spirv.EnvProfile = spirv.env_profile(e.tgt.identity.env_profile);
    if (profile == nil) { ret err[fail.Fail].err{fail.message("spirv: the target names an environment this backend has no profile for")}; }
    val excess: u64 = e.b.caps_needed & spirv.CEILING_DOMAIN & ~profile.ceiling;
    if (excess != 0) {
        var bit: u64 = 1;
        for ((excess & bit) == 0) { bit = bit << 1; }
        val msg: res[str, format.FormatError] = format.sprint(e.alloc,
            "this module needs the {} capability, which the `{}` environment does not admit; raise `env` on the target or avoid the type that needs it",
            spirv.need_name(bit), profile.name);
        if (sel msg.err) { ret err[fail.Fail].err{fail.format_refused(msg.err)}; }
        ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_CAPABILITY, msg.ok)};
    }
    ret check_type_features(e, profile);
}

# a type's capability the ceiling admits still needs its device feature, which no
# Vulkan version guarantees (#4318). a narrow integer in a function never reaches
# here without it, since it is carried at 32 bits; what does is a width nothing
# carries: a member, memory the host shares, or a 64-bit type
fun check_type_features(e: *Emit, profile: *spirv.EnvProfile) err[fail.Fail] {
    var i: u32 = 0;
    for (i < spirv.CAPABILITY_COUNT) {
        val c: *spirv.Capability = ?spirv.CAPABILITIES[i];
        if ((e.b.caps_needed & c.need) != 0 && (c.feature & ~e.tgt.model.extensions) != 0) {
            val name: str                          = extension.first_name(e.tgt.model.extension_table, e.tgt.model.extension_count, c.feature);
            val msg:  res[str, format.FormatError] = format.sprint(e.alloc,
                "this module needs the {} capability, which the `{}` environment admits but leaves to a device feature: name `{}` in the target's `extensions` once the consumer enables the feature, or avoid the type that needs it",
                c.name, profile.name, name);
            if (sel msg.err) { ret err[fail.Fail].err{fail.format_refused(msg.err)}; }
            ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_CAPABILITY, msg.ok)};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the one path a requirement takes, whatever raised it: an instruction row, a literal's
# value, or an operand's type (such as a 64-bit atomic's Int64Atomics). `what` names the
# use in a refusal. the extensions must be selected and the capability's SPIR-V version
# reached, and the capability is then declared, with the SPIR-V extension defining it
fun require(e: *Emit, mf: *mir.MirFunction, capability: u32, requires: u64, what: str) err[fail.Fail] {
    ret require_at(e, mir.refusal_loc(mf, e.cur_instr), e.cur_stages, capability, requires, what);
}

# `stages` are the stages the use is reached from, which a capability guaranteed only in
# compute holds to its `graphics` extension
fun require_at(e: *Emit, loc: source.SrcLoc, stages: u8, capability: u32, requires: u64, what: str) err[fail.Fail] {
    val missing: u64 = requires & ~e.tgt.model.extensions;
    if (missing != 0) {
        val name: str                          = extension.first_name(e.tgt.model.extension_table, e.tgt.model.extension_count, missing);
        val r:    res[str, format.FormatError] = format.sprint(e.alloc,
            "{} needs the `{}` extension, a device feature the target does not select: name it in the target's `extensions` once the consumer enables the feature",
            what, name);
        if (sel r.err) { ret err[fail.Fail].err{fail.format_refused(r.err)}; }
        ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_CAPABILITY, loc, r.ok)};
    }
    if (capability == isa.NO_OP_CAPABILITY) { ret err[fail.Fail].ok{}; }
    val c: *spirv.Capability = spirv.capability_of(capability);
    if (c == nil) { ret emit_fail(e, "spirv.emit: a requirement names a capability the capability table does not carry"); }
    if (e.b.version < c.min_version) {
        val r: res[str, format.FormatError] = format.sprint(e.alloc,
            "{} needs the {} capability, which SPIR-V defines from {}.{}, and the `{}` environment selects SPIR-V {}.{}: raise `env` to `{}` or later",
            what, c.name, spirv.version_major(c.min_version), spirv.version_minor(c.min_version),
            spirv.env_profile_name(e.tgt.identity.env_profile), spirv.version_major(e.b.version),
            spirv.version_minor(e.b.version), spirv.env_name_from(c.min_version));
        if (sel r.err) { ret err[fail.Fail].err{fail.format_refused(r.err)}; }
        ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_CAPABILITY, loc, r.ok)};
    }
    val graphics: u8 = stages & STAGES_GRAPHICS;
    if (c.graphics != 0 && graphics != 0 && (c.graphics & ~e.tgt.model.extensions) != 0) {
        val name: str                          = extension.first_name(e.tgt.model.extension_table, e.tgt.model.extension_count, c.graphics);
        val r:    res[str, format.FormatError] = format.sprint(e.alloc,
            "{} is reached from a {} stage, and Vulkan guarantees the {} capability only in compute stages: a use from another stage needs the `{}` extension, named in the target's `extensions` once the consumer's device supports the stage",
            what, stages_spelling(e, graphics), c.name, name);
        if (sel r.err) { ret err[fail.Fail].err{fail.format_refused(r.err)}; }
        ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_CAPABILITY, loc, r.ok)};
    }
    e.b.caps_needed = e.b.caps_needed | c.need;
    ret err[fail.Fail].ok{};
}

# "the `#[builtin(\"subgroup_size\")]` variable", for a requirement the declaration raises
fun builtin_decl_text(e: *Emit, gi: u32) str {
    val r: res[str, format.FormatError] = format.sprint(e.alloc, "the `#[builtin(\"{}\")]` variable{}",
        builtin_spelling(gl_ir(e, gi).iface_a), gl_mod_prefix(e, gi));
    if (sel r.err) { ret "a `#[builtin(...)]` variable"; }
    ret r.ok;
}

# the same, used by the stage `fx`
fun builtin_use_text(e: *Emit, fx: u32, gi: u32) str {
    val r: res[str, format.FormatError] = format.sprint(e.alloc, "{} used by `{}`", builtin_decl_text(e, gi), ir_fn_spelling(e, fx));
    if (sel r.err) { ret builtin_decl_text(e, gi); }
    ret r.ok;
}

# the capabilities in the table's order, then each SPIR-V extension one of them needs, once
fun emit_preamble(e: *Emit) {
    emit_cap(e, spirv.CAP_SHADER);
    if (!e.has_entry) { emit_cap(e, spirv.CAP_LINKAGE); }
    if (e.vulkan_mm)  { e.b.caps_needed = e.b.caps_needed | spirv.NEED_VULKAN_MEMORY_MODEL; }
    val need: u64 = e.b.caps_needed;
    var i:    u32 = 0;
    for (i < spirv.CAPABILITY_COUNT) {
        if ((need & spirv.CAPABILITIES[i].need) != 0) { emit_cap(e, spirv.CAPABILITIES[i].word); }
        i = i + 1;
    }
    i = 0;
    for (i < spirv.CAPABILITY_COUNT) {
        val ext: str = spirv.CAPABILITIES[i].extension;
        if ((need & spirv.CAPABILITIES[i].need) != 0 && extension_needed(e, i) && !extension_declared_before(e, need, i, ext)) {
            spirv.inst_string(e.b, ?e.b.extensions, spirv.OP_EXTENSION, nil, 0, ext);
        }
        i = i + 1;
    }
    var mm: [2]u32;
    mm[0] = spirv.ADDRESSING_LOGICAL;
    mm[1] = spirv.MEMORY_GLSL450;
    # a module holding a physical pointer addresses PhysicalStorageBuffer64, which every
    # logical storage class keeps its logical rules under (#4307)
    if ((need & spirv.NEED_PHYSICAL_STORAGE_BUFFER) != 0) {
        mm[0] = spirv.ADDRESSING_PHYSICAL_STORAGE_BUFFER_64;
        if (e.b.version < spirv.SPV_VERSION_1_5) {
            spirv.inst_string(e.b, ?e.b.extensions, spirv.OP_EXTENSION, nil, 0, spirv.SPV_KHR_PHYSICAL_STORAGE_BUFFER);
        }
    }
    if (e.vulkan_mm) {
        mm[1] = spirv.MEMORY_VULKAN;
        if (e.b.version < spirv.SPV_VERSION_1_5) {
            spirv.inst_string(e.b, ?e.b.extensions, spirv.OP_EXTENSION, nil, 0, spirv.SPV_KHR_VULKAN_MEMORY_MODEL);
        }
    }
    spirv.inst(e.b, ?e.b.memory_model, spirv.OP_MEMORY_MODEL, ?mm[0], 2);
}

# the table row `i` names an extension the module's version has not taken into the core
fun extension_needed(e: *Emit, i: u32) bool {
    val c: *spirv.Capability = ?spirv.CAPABILITIES[i];
    ret c.extension != nil && (c.ext_core == 0 || e.b.version < c.ext_core);
}

fun extension_declared_before(e: *Emit, need: u64, upto: u32, ext: str) bool {
    var i: u32 = 0;
    for (i < upto) {
        if ((need & spirv.CAPABILITIES[i].need) != 0 && extension_needed(e, i) && str_equals(spirv.CAPABILITIES[i].extension, ext)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun emit_cap(e: *Emit, cap: u32) {
    var o: [1]u32;
    o[0] = cap;
    spirv.inst(e.b, ?e.b.caps, spirv.OP_CAPABILITY, ?o[0], 1);
}

rec TypeText {
    buf: [TYPE_TEXT_CAP]u8;
    len: usize;
}

val TYPE_TEXT_CAP: usize = 160;

val TYPE_TEXT_DEPTH: u32 = 6;

fun text_put(out: *TypeText, s: str) {
    val n: usize = str_len(s);
    var i: usize = 0;
    for (i < n) {
        if (out.len + 1 < TYPE_TEXT_CAP) {
            out.buf[out.len] = s[i];
            out.len          = out.len + 1;
        }
        i = i + 1;
    }
}

fun text_put_u32(out: *TypeText, n: u32) {
    var digits: [12]u8;
    var k:      u32 = 0;
    var v:      u32 = n;
    if (v == 0) {
        digits[0] = 48;
        k         = 1;
    }
    for (v > 0) {
        digits[k] = (48 + v % 10)::u8;
        v         = v / 10;
        k         = k + 1;
    }
    for (k > 0) {
        k = k - 1;
        if (out.len + 1 < TYPE_TEXT_CAP) {
            out.buf[out.len] = digits[k];
            out.len          = out.len + 1;
        }
    }
}

fun spell_members(e: *Emit, tys: *type.IrTypeTable, out: *TypeText, members: *type.IrTypeId, count: u32, depth: u32) {
    var i: u32 = 0;
    for (i < count) {
        if (i > 0) { text_put(out, ", "); }
        spell_type(e, tys, out, members[i], depth + 1);
        i = i + 1;
    }
}

# a source-shaped spelling of an IR type for a diagnostic, bounded in depth and length
fun spell_type(e: *Emit, tys: *type.IrTypeTable, out: *TypeText, id: type.IrTypeId, depth: u32) {
    if (depth > TYPE_TEXT_DEPTH) {
        text_put(out, "...");
        ret;
    }
    val opt_: opt[*type.IrType] = type.get(tys, id);
    if (sel opt_.none) {
        text_put(out, "?");
        ret;
    }
    val t: *type.IrType = opt_.some;
    if (t.kind == type.IRT_VOID) {
        text_put(out, "void");
        ret;
    }
    if (t.kind == type.IRT_INT) {
        text_put(out, "i");
        text_put_u32(out, t.data.bits);
        ret;
    }
    if (t.kind == type.IRT_FLOAT) {
        text_put(out, "f");
        text_put_u32(out, t.data.bits);
        ret;
    }
    if (t.kind == type.IRT_HANDLE) {
        text_put(out, "handle");
        ret;
    }
    if (t.kind == type.IRT_VECTOR) {
        spell_type(e, tys, out, t.data.vector_.element, depth + 1);
        text_put(out, "x");
        text_put_u32(out, t.data.vector_.lanes);
        ret;
    }
    if (t.kind == type.IRT_ARRAY) {
        text_put(out, "[");
        text_put_u32(out, t.data.array_.count);
        text_put(out, "]");
        spell_type(e, tys, out, t.data.array_.element, depth + 1);
        ret;
    }
    if (t.kind == type.IRT_PTR) {
        text_put(out, "*");
        if (t.data.pointee != type.IRT_NIL) { spell_type(e, tys, out, t.data.pointee, depth + 1); }
        ret;
    }
    # a record a cycle reaches, named rather than spelled out again
    if (t.kind == type.IRT_RECREF) {
        text_put(out, "rec{...}");
        ret;
    }
    if (t.kind == type.IRT_FN) {
        text_put(out, "fun(");
        spell_members(e, tys, out, t.data.fn.params, t.data.fn.param_count, depth);
        if (t.data.fn.variadic) { text_put(out, ", ..."); }
        text_put(out, ")");
        val rt: opt[*type.IrType] = type.get(tys, t.data.fn.ret_type);
        if (sel rt.some && rt.some.kind != type.IRT_VOID) {
            text_put(out, " ");
            spell_type(e, tys, out, t.data.fn.ret_type, depth + 1);
        }
        ret;
    }
    if (t.kind == type.IRT_TAG) {
        text_put(out, "tag: i");
        text_put_u32(out, t.data.tag_.disc_bytes * 8);
        text_put(out, "{");
        var ci: u32 = 0;
        for (ci < t.data.tag_.case_count) {
            if (ci > 0)                                  { text_put(out, ", "); }
            if (!type.tag_case_has_payload(tys, id, ci)) { text_put(out, "_"); }
            or                                           { spell_type(e, tys, out, t.data.tag_.cases[ci], depth + 1); }
            ci = ci + 1;
        }
        text_put(out, "}");
        ret;
    }
    if (t.kind == type.IRT_STRUCT) { text_put(out, "rec{"); }
    or (t.kind == type.IRT_UNION)  { text_put(out, "uni{"); }
    or {
        text_put(out, "?");
        ret;
    }
    spell_members(e, tys, out, t.data.struct_.fields, t.data.struct_.field_count, depth);
    text_put(out, "}");
}

fun type_text(e: *Emit, out: *TypeText, id: type.IrTypeId) str {
    out.len = 0;
    spell_type(e, ?e.ir.types, out, id, 0);
    out.buf[out.len] = 0;
    ret ?out.buf[0];
}

fun type_refusal_reason(e: *Emit, id: type.IrTypeId) str {
    val opt_: opt[*type.IrType] = type.get(?e.ir.types, id);
    if (sel opt_.none) { ret "the type is not defined in this module"; }
    val k: type.IrTypeKind = opt_.some.kind;
    if (k == type.IRT_FN)                            { ret "logical addressing has no function pointers, so a function value cannot cross a call"; }
    if (k == type.IRT_UNION)                         { ret "SPIR-V has no untyped union, so a raw union has no type to declare"; }
    if (k == type.IRT_PTR)                           { ret "a logical reference must name a Function-storage object whose type SPIR-V can declare, and may not itself contain a reference"; }
    if (k == type.IRT_STRUCT || k == type.IRT_ARRAY) { ret "a member of this composite has no SPIR-V type"; }
    if (k == type.IRT_TAG) {
        if (opt_.some.data.tag_.case_count + 1 > types.MAX_STRUCT_MEMBERS) {
            ret "a tag's SPIR-V composite holds its discriminator and one member per case, and a composite may have at most 16 members, so a tag on this target may declare at most 15 cases";
        }
        ret "a case payload of this tag has no SPIR-V type";
    }
    ret "this type has no SPIR-V form";
}

fun emit_function(e: *Emit, cx: u32) err[fail.Fail] {
    val fx:  u32              = e.copies.data[cx].fx;
    val key: u32              = e.copies.data[cx].key_at;
    val mf:  *mir.MirFunction = fn_mir(e, fx);
    if (mf == nil) { ret err[fail.Fail].err{fail.message("spirv.emit: an emitted function has no lowered body")}; }
    e.cur_fn     = mf;
    e.cur_instr  = nil;
    e.cur_mi     = e.fns[fx].mi;
    e.cur_stages = 0;
    if (e.fn_stages != nil) { e.cur_stages = e.fn_stages[fx]; }
    e.ir = fn_mod(e, fx);
    val irfn: *ir.Function = fn_ir(e, fx);

    var bi: u32 = 0;
    for (bi < mf.block_count && e.cur_instr == nil) {
        var ii: u32 = 0;
        for (ii < mf.blocks[bi].instr_count && e.cur_instr == nil) {
            if (mf.blocks[bi].instrs[ii].loc.file != source.FILE_NIL) { e.cur_instr = ?mf.blocks[bi].instrs[ii]; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    val flow: err[fail.Fail] = confined_flow(e, fx, mf);
    if (sel flow.err) { ret flow; }

    var returns_void: bool = false;
    val ret_ty:       u32  = ir_return_spv_type(e, irfn, ?returns_void);
    if (ret_ty == 0) {
        ret unsupported(e, "unsupported return type in the SPIR-V target");
    }
    # each source parameter's SPIR-V parameters: one, or a path's root and runtime indices
    val rs: res[*u32, A.Error] = A.allocate[u32](e.alloc, (irfn.param_count + 1)::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    val pslot: *u32 = rs.ok;
    fin { A.deallocate[u32](e.alloc, pslot, (irfn.param_count + 1)::usize); }
    var slots: u32 = 0;
    var pk:    u32 = 0;
    for (pk < irfn.param_count) {
        pslot[pk] = slots;
        slots     = slots + binding_arity(e, key_param(e, key, pk));
        pk        = pk + 1;
    }
    pslot[irfn.param_count] = slots;
    if (!types.instruction_operands_fit(2, slots)) {
        ret unsupported(e, "SPIR-V OpTypeFunction parameter count exceeds its 65535-word instruction encoding");
    }
    val pr: res[*u32, A.Error] = A.allocate[u32](e.alloc, (slots + 1)::usize);
    if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
    val ptypes: *u32 = pr.ok;
    fin { A.deallocate[u32](e.alloc, ptypes, (slots + 1)::usize); }
    val pir: res[*u32, A.Error] = A.allocate[u32](e.alloc, (slots + 1)::usize);
    if (sel pir.err) { ret err[fail.Fail].err{fail.refused(pir.err)}; }
    val param_ids: *u32 = pir.ok;
    fin { A.deallocate[u32](e.alloc, param_ids, (slots + 1)::usize); }
    var pi: u32 = 0;
    for (pi < irfn.param_count) {
        val at:   u32 = key_param(e, key, pi);
        val bind: u32 = e.keys.data[at];
        if (bind == BIND_GLOBAL || bind == BIND_LOCAL) {
            path_param_types(e, at, ?ptypes[pslot[pi]]);
            pi = pi + 1;
            cnt;
        }
        if (bind == BIND_PHYSICAL) {
            val pp: res[u32, fail.Fail] = phys_pointer(e, ?e.ir.types, irfn.params[pi].ty);
            if (sel pp.err) { ret err[fail.Fail].err{pp.err}; }
            ptypes[pslot[pi]] = pp.ok;
            pi                = pi + 1;
            cnt;
        }
        val pt: u32 = ir_value_spv_type(e, irfn.params[pi].ty);
        if (pt == 0) {
            var shown:   TypeText;
            val message: res[str, format.FormatError] = format.sprint(e.alloc,
                "unsupported parameter {} of type `{}` in the SPIR-V Logical Shader environment: {}",
                pi + 1, type_text(e, ?shown, irfn.params[pi].ty), type_refusal_reason(e, irfn.params[pi].ty));
            if (sel message.err) { ret err[fail.Fail].err{fail.format_refused(message.err)}; }
            val text: str = message.ok;
            fin { A.deallocate[u8](e.alloc, text, str_len(text) + 1); }
            val saved: res[intern.StrId, A.Error] = intern.intern(e.interner, text);
            if (sel saved.err) { ret err[fail.Fail].err{fail.refused(saved.err)}; }
            val held: opt[str] = intern.lookup(e.interner, saved.ok);
            if (sel held.none) { ret err[fail.Fail].err{fail.message("spirv.emit: parameter diagnostic is absent from its interner")}; }
            ret unsupported(e, held.some);
        }
        ptypes[pslot[pi]] = pt;
        pi                = pi + 1;
    }
    val fnty: u32 = types.type_fn(e.tt, ret_ty, ?ptypes[0], slots);
    if (fnty == 0) {
        ret unsupported(e, "this signature has no SPIR-V function type in the SPIR-V target");
    }

    val fn_id: u32 = e.copies.data[cx].id;

    val name_opt: opt[str] = intern.lookup(e.interner, mf.name);
    if (sel name_opt.none) { ret err[fail.Fail].err{fail.message("spirv.emit: function name not interned")}; }
    val fn_name: str = name_opt.some;

    if (irfn.stage != ir.STAGE_NONE) {
        val er: err[fail.Fail] = emit_entry_point(e, irfn, fx, fn_id, entry_name(e, irfn, fn_name), returns_void);
        if (sel er.err) { ret er; }
    }
    or (!e.has_entry && e.fns[fx].mi == e.u.root && copy_is_primary(e, cx)) { emit_linkage_export(e, fn_id, fn_name); }

    val cr: res[cfg.Structure, fail.Fail] = cfg.analyze(mf, e.alloc);
    if (sel cr.err) { ret err[fail.Fail].err{cr.err}; }
    var st: cfg.Structure = cr.ok;
    if (st.status != cfg.CFG_OK) {
        val msg: str = cfg_refusal(e, fn_name, ?st);
        cfg.dnit(?st);
        ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_CONTROL_FLOW, mf.decl_loc, msg)};
    }

    var fop: [4]u32;
    fop[0] = ret_ty;
    fop[1] = fn_id;
    fop[2] = spirv.FUNCTION_CONTROL_NONE;
    fop[3] = fnty;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION, ?fop[0], 4);
    dbgm.name_shown(?e.dbg, fn_id, irfn.disp, mf.name);
    if (e.fns[fx].mi == e.u.root && e.cur_instr != nil) { dbgm.source_of(?e.dbg, e.cur_instr.loc); }

    pi = 0;
    for (pi < slots) {
        val pid: u32 = spirv.alloc_id(e.b);
        var pp:  [2]u32;
        pp[0] = ptypes[pi];
        pp[1] = pid;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION_PARAMETER, ?pp[0], 2);
        # a physical pointer parameter says whether what it points at is aliased
        if (physical_type(e, ptypes[pi])) { decorate_bare(e, pid, spirv.DECOR_ALIASED); }
        param_ids[pi] = pid;
        pi            = pi + 1;
    }

    val rl: res[*u32, A.Error] = A.allocate[u32](e.alloc, st.count::usize);
    if (sel rl.err) {
        cfg.dnit(?st);
        ret err[fail.Fail].err{fail.refused(rl.err)};
    }
    val labels: *u32 = rl.ok;
    var li:     u32  = 0;
    for (li < st.count) {
        labels[li] = spirv.alloc_id(e.b);
        li         = li + 1;
    }

    # a stage that zeroes its `#[shared]` memory opens on a block of its own, so the
    # first user block is an ordinary one the prologue branches to
    val zeroing: bool = zeroes_shared(e, fx, irfn);
    var lb:      [1]u32;
    lb[0] = labels[st.order[0]];
    if (zeroing) { lb[0] = spirv.alloc_id(e.b); }
    spirv.inst(e.b, ?e.b.functions, spirv.OP_LABEL, ?lb[0], 1);
    dbgm.block(?e.dbg);

    var vm: VMaps;
    e.cur_copy = cx;
    val mr: err[fail.Fail] = build_vmaps(e, mf, irfn, ?vm);
    if (sel mr.err) {
        vmaps_dnit(e, ?vm);
        A.deallocate[u32](e.alloc, labels, st.count::usize);
        cfg.dnit(?st);
        ret mr;
    }

    e.cur_copy   = cx;
    e.cur_pslot  = pslot;
    e.cur_params = param_ids;
    var body: err[fail.Fail] = err[fail.Fail].ok{};
    if (zeroing) { body = emit_shared_zeroing(e, fx, irfn, lb[0], labels[st.order[0]]); }
    var oi: u32 = 0;
    if (sel body.err) { oi = st.count; }
    for (oi < st.count) {
        body = emit_node(e, mf, ?st, st.order[oi], oi == 0 && !zeroing, labels, ?vm, returns_void, ret_ty);
        if (sel body.err) {
            oi = st.count;
            cnt;
        }
        oi = oi + 1;
    }
    e.cur_copy   = COPY_NONE;
    e.cur_pslot  = nil;
    e.cur_params = nil;

    vmaps_dnit(e, ?vm);
    A.deallocate[u32](e.alloc, labels, st.count::usize);
    cfg.dnit(?st);
    if (sel body.err) { ret body; }

    spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION_END, nil, 0);
    if (e.b.err) { ret err[fail.Fail].err{fail.message("spirv.emit: module builder hit an allocation error")}; }
    ret err[fail.Fail].ok{};
}

val ADDR_UNKNOWN: u8 = 0;
val ADDR_GLOBAL:  u8 = 1;
val ADDR_ALLOCA:  u8 = 2;

fun address_origin(e: *Emit, mf: *mir.MirFunction, op: *mir.MirOperand, out_ix: *u32) u8 {
    @out_ix = 0;
    if (op.kind == mir.MIR_OP_SYM) {
        val gx: u32 = gl_lookup(e, op.sym);
        if (gx != GL_NONE) {
            @out_ix = gx;
            ret ADDR_GLOBAL;
        }
        ret ADDR_UNKNOWN;
    }
    var base: u32 = mir.MIR_VREG_NIL.n;
    if (op.kind == mir.MIR_OP_VREG) { base = op.vreg.n; }
    or (op.kind == mir.MIR_OP_MEM)  { base = op.vreg.n; }
    if (base == mir.MIR_VREG_NIL.n) { ret ADDR_UNKNOWN; }

    val def: *mir.MirInstr = defining_instr(mf, base);
    if (def == nil)                   { ret ADDR_UNKNOWN; }
    if (def.opcode == mir.MIR_ALLOCA) { ret ADDR_ALLOCA; }
    if (def.opcode == mir.MIR_GEP && def.operand_count >= 2
        && def.operands[1].kind == mir.MIR_OP_SYM) {
        ret address_origin(e, mf, ?def.operands[1], out_ix);
    }
    ret ADDR_UNKNOWN;
}

fun defining_instr(mf: *mir.MirFunction, vreg: u32) *mir.MirInstr {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mir.instr_defines_shape(mi) && mi.operand_count > 0
                && mi.operands[0].kind == mir.MIR_OP_VREG && mi.operands[0].vreg.n == vreg) {
                ret mi;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret nil;
}

fun cfg_refusal(e: *Emit, name: str, st: *cfg.Structure) str {
    val reason: str                       = cfg.status_message(st.status);
    val jr:     res[str, string.StrError] = str_join(e.alloc, "", name, ": ", reason);
    if (sel jr.err) { ret reason; }
    val buf: str                        = jr.ok;
    val ir:  res[intern.StrId, A.Error] = intern.intern(e.interner, buf);
    A.deallocate[u8](e.alloc, buf::*u8, str_len(buf) + 1);
    if (sel ir.err) { ret reason; }
    val io: opt[str] = intern.lookup(e.interner, ir.ok);
    if (sel io.none) { ret reason; }
    ret io.some;
}

fun emit_node(e: *Emit, mf: *mir.MirFunction, st: *cfg.Structure, ix: u32, is_entry: bool,
    labels: *u32, vm: *VMaps, returns_void: bool, ret_ty: u32) err[fail.Fail] {
    if (!is_entry) {
        var lb: [1]u32;
        lb[0] = labels[ix];
        spirv.inst(e.b, ?e.b.functions, spirv.OP_LABEL, ?lb[0], 1);
        dbgm.block(?e.dbg);
    }

    val role: u8 = st.nodes[ix].role;
    if (role == cfg.ROLE_UNREACHABLE) {
        spirv.inst(e.b, ?e.b.functions, spirv.OP_UNREACHABLE, nil, 0);
        ret err[fail.Fail].ok{};
    }
    if (role == cfg.ROLE_CONTINUE || role == cfg.ROLE_FORWARD) {
        emit_branch(e, labels[st.nodes[ix].succ0]);
        ret err[fail.Fail].ok{};
    }

    val blk: *mir.MirBlock = ?mf.blocks[st.nodes[ix].block];
    if (role == cfg.ROLE_REAL) {
        var ii: u32 = 0;
        for (ii + 1 < blk.instr_count) {
            dbgm.line(?e.dbg, blk.instrs[ii].loc);
            val r: err[fail.Fail] = emit_instr(e, mf, vm, ?blk.instrs[ii]);
            if (sel r.err) { ret r; }
            ii = ii + 1;
        }
    }

    ret emit_terminator(e, mf, st, ix, labels, vm, returns_void, ret_ty);
}

fun emit_merge(e: *Emit, st: *cfg.Structure, ix: u32, labels: *u32) {
    if (st.nodes[ix].kind == cfg.CK_LOOP) {
        var lm: [3]u32;
        lm[0] = labels[st.nodes[ix].merge];
        lm[1] = labels[st.nodes[ix].cont];
        lm[2] = spirv.LOOP_CONTROL_NONE;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_LOOP_MERGE, ?lm[0], 3);
        ret;
    }
    if (st.nodes[ix].kind == cfg.CK_SELECTION) {
        var sm: [2]u32;
        sm[0] = labels[st.nodes[ix].merge];
        sm[1] = spirv.SELECTION_CONTROL_NONE;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECTION_MERGE, ?sm[0], 2);
    }
}

fun emit_branch(e: *Emit, label: u32) {
    var o: [1]u32;
    o[0] = label;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_BRANCH, ?o[0], 1);
}

fun emit_terminator(e: *Emit, mf: *mir.MirFunction, st: *cfg.Structure, ix: u32, labels: *u32,
    vm: *VMaps, returns_void: bool, ret_ty: u32) err[fail.Fail] {
    if (st.nodes[ix].split != cfg.NO_BLOCK) {
        emit_merge(e, st, ix, labels);
        emit_branch(e, labels[st.nodes[ix].split]);
        ret err[fail.Fail].ok{};
    }

    val blk:  *mir.MirBlock = ?mf.blocks[st.nodes[ix].block];
    val term: *mir.MirInstr = ?blk.instrs[blk.instr_count - 1];
    e.cur_instr = term;
    dbgm.line(?e.dbg, term.loc);

    if (term.opcode == mir.MIR_BR) {
        emit_merge(e, st, ix, labels);
        emit_branch(e, labels[st.nodes[ix].succ0]);
        ret err[fail.Fail].ok{};
    }
    if (term.opcode == mir.MIR_CBR) {
        val cond: u32 = read_condition(e, vm, ?term.operands[0], term.width::u32 * 8);
        if (cond == 0) { ret emit_fail(e, "spirv.emit: unreadable branch condition"); }
        emit_merge(e, st, ix, labels);
        var bc: [3]u32;
        bc[0] = cond;
        bc[1] = labels[st.nodes[ix].succ0];
        bc[2] = labels[st.nodes[ix].succ1];
        spirv.inst(e.b, ?e.b.functions, spirv.OP_BRANCH_CONDITIONAL, ?bc[0], 3);
        ret err[fail.Fail].ok{};
    }
    if (term.opcode == mir.MIR_UNREACHABLE) {
        spirv.inst(e.b, ?e.b.functions, spirv.OP_UNREACHABLE, nil, 0);
        ret err[fail.Fail].ok{};
    }
    if (term.opcode == mir.MIR_RET) {
        if (returns_void) {
            if (term.operand_count != 0) { ret emit_fail(e, "spirv.emit: void return carries a value"); }
            spirv.inst(e.b, ?e.b.functions, spirv.OP_RETURN, nil, 0);
            ret err[fail.Fail].ok{};
        }
        if (term.operand_count != 1) { ret emit_fail(e, "spirv.emit: logical return requires one value"); }
        if (pointer_operand(vm, ?term.operands[0]) && (vm.prov[term.operands[0].vreg.n] & PROV_LOGICAL) != 0) {
            # a returned pointer is a physical one, so a logical one is refused naming what it points into
            val rr: res[str, format.FormatError] = format.sprint(e.alloc,
                "the current SPIR-V Logical Shader environment does not support {}-storage reference results: a returned pointer is a physical pointer, an address in a buffer the host passes, and this one names memory the module declares, which has no address. return the value it points at, or take the pointer as a parameter",
                storage_class_name(return_storage(e, e.copies.data[e.cur_copy].fx, e.copies.data[e.cur_copy].key_at)));
            if (sel rr.err) { ret unsupported(e, "the current SPIR-V Logical Shader environment does not support reference results"); }
            ret unsupported(e, rr.ok);
        }
        val rr: res[u32, fail.Fail] = read_value(e, mf, vm, ?term.operands[0], ret_ty, term.memory_flags);
        if (sel rr.err) { ret emit_inner(e, rr.err); }
        val rid: u32 = rr.ok;
        var rv:  [1]u32;
        rv[0] = rid;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_RETURN_VALUE, ?rv[0], 1);
        ret err[fail.Fail].ok{};
    }
    ret unsupported(e, "instruction is not yet supported by the SPIR-V target");
}

# a value tested for truth at `bits`, 0 for its whole type
fun read_condition(e: *Emit, vm: *VMaps, op: *mir.MirOperand, bits: u32) u32 {
    if (op.kind != mir.MIR_OP_VREG) {
        e.b.err = true;
        ret 0;
    }
    val v: u32 = op.vreg.n;
    if (v >= vm.n) {
        e.b.err = true;
        ret 0;
    }
    val ty:  u32 = vm.type_id[v];
    var raw: u32 = read_operand(e, vm, op, ty);
    if (e.b.err || raw == 0) { ret 0; }
    if (vm.is_bool[v])       { ret raw; }
    raw = narrow_extend(e, raw, ty, bits, false);

    var cmp_ty: u32 = ty;
    if (cmp_ty == 0) { cmp_ty = types.type_int(e.tt, e.tgt.model.gpr_width * 8); }
    var opcode: u32 = spirv.OP_I_NOT_EQUAL;
    if (types.type_is_float(e.tt, cmp_ty)) { opcode = spirv.OP_F_UNORD_NOT_EQUAL; }
    val zero:   u32 = types.const_scalar(e.tt, cmp_ty, 0, 0);
    val result: u32 = spirv.alloc_id(e.b);
    var ops:    [4]u32;
    ops[0] = types.type_bool(e.tt);
    ops[1] = result;
    ops[2] = raw;
    ops[3] = zero;
    spirv.inst(e.b, ?e.b.functions, opcode, ?ops[0], 4);
    ret result;
}

fun entry_name(e: *Emit, irfn: *ir.Function, linkage: str) str {
    if (irfn.disp == intern.STR_NIL) { ret linkage; }
    val opt_: opt[str] = intern.lookup(e.interner, irfn.disp);
    if (sel opt_.none) { ret linkage; }
    ret opt_.some;
}

fun emit_entry_point(e: *Emit, irfn: *ir.Function, fn_ix: u32, fn_id: u32, name: str,
    returns_void: bool) err[fail.Fail] {
    if (!returns_void) {
        ret refuse(e, dkind.SPIRV_STAGE_SIGNATURE, "a function declaring a `#[stage(...)]` must return nothing: a pipeline stage's results leave through its output interface variables, not through a return value");
    }
    if (irfn.param_count != 0) {
        ret refuse(e, dkind.SPIRV_STAGE_SIGNATURE, "a function declaring a `#[stage(...)]` must take no parameters: a pipeline stage's inputs arrive through its input interface variables, not as arguments");
    }

    var model: u32 = spirv.EXEC_MODEL_VERTEX;
    if (irfn.stage == ir.STAGE_FRAGMENT) { model = spirv.EXEC_MODEL_FRAGMENT; }
    or (irfn.stage == ir.STAGE_COMPUTE)  { model = spirv.EXEC_MODEL_GLCOMPUTE; }

    val sw_r: res[u32, fail.Fail] = spirv.string_words(name);
    if (sel sw_r.err) { ret err[fail.Fail].err{sw_r.err}; }
    val sw:   u32 = sw_r.ok;
    var used: u32 = 0;
    var gi:   u32 = 0;
    for (gi < e.gl_len) {
        if (entry_lists(e, fn_ix, gi)) { used = used + 1; }
        gi = gi + 1;
    }
    # the zeroing reads LocalInvocationIndex, an Input the interface names even where
    # the stage's own code never reads it
    var lid: u32 = 0;
    if (zeroes_shared(e, fn_ix, irfn)) {
        val lx: u32 = local_invocation_global(e);
        if (lx == GL_NONE || !entry_lists(e, fn_ix, lx)) {
            var lty: u32 = 0;
            lid  = zero_lid(e, ?lty);
            used = used + 1;
        }
    }
    val total: u32                = 2 + sw + used;
    val ra:    res[*u32, A.Error] = A.allocate[u32](e.alloc, total::usize);
    if (sel ra.err) { ret err[fail.Fail].err{fail.refused(ra.err)}; }
    val ops: *u32 = ra.ok;
    ops[0] = model;
    ops[1] = fn_id;
    spirv.pack_string(name, sw, ?ops[2]);
    var ii: u32 = 0;
    gi = 0;
    for (gi < e.gl_len) {
        if (entry_lists(e, fn_ix, gi)) {
            ops[2 + sw + ii] = e.gvar_ids[gi];
            ii               = ii + 1;
        }
        gi = gi + 1;
    }
    if (lid != 0) { ops[2 + sw + ii] = lid; }
    spirv.inst(e.b, ?e.b.entry_points, spirv.OP_ENTRY_POINT, ops, total);
    A.deallocate[u32](e.alloc, ops, total::usize);

    if (irfn.stage == ir.STAGE_FRAGMENT) {
        var fm: [2]u32;
        fm[0] = fn_id;
        fm[1] = spirv.EXEC_MODE_ORIGIN_UPPER_LEFT;
        spirv.inst(e.b, ?e.b.exec_modes, spirv.OP_EXECUTION_MODE, ?fm[0], 2);
    }
    if (irfn.stage == ir.STAGE_COMPUTE && !e.wg_builtin) {
        var cm: [5]u32;
        cm[0] = fn_id;
        if (wg_is_spec(irfn)) {
            cm[1] = spirv.EXEC_MODE_LOCAL_SIZE_ID;
            var d: u32 = 0;
            for (d < 3) {
                val r: res[u32, fail.Fail] = wg_dim_id(e, irfn, d);
                if (sel r.err) { ret err[fail.Fail].err{r.err}; }
                cm[2 + d] = r.ok;
                d         = d + 1;
            }
            spirv.inst(e.b, ?e.b.exec_modes, spirv.OP_EXECUTION_MODE_ID, ?cm[0], 5);
        }
        or {
            cm[1] = spirv.EXEC_MODE_LOCAL_SIZE;
            cm[2] = irfn.wg_x;
            cm[3] = irfn.wg_y;
            cm[4] = irfn.wg_z;
            spirv.inst(e.b, ?e.b.exec_modes, spirv.OP_EXECUTION_MODE, ?cm[0], 5);
        }
    }
    ret err[fail.Fail].ok{};
}

# a `#[shared]` variable carries an OpConstantNull initializer where the selection
# holds zero_init_workgroup, and each compute stage reaching one zeroes it otherwise (#4270)
fun shared_native_zero(e: *Emit) bool {
    ret (e.tgt.model.extensions & spirv.EXT_ZERO_INIT_WORKGROUP) != 0;
}

# a `#[shared]` variable holding a physical pointer is zeroed by the stage even where the
# environment zeroes workgroup memory, since a physical pointer has no null constant (#4307)
fun shared_zeroed_natively(e: *Emit, gx: u32) bool {
    ret shared_native_zero(e) && !holds_physical(e, e.gtype_ids[gx]);
}

fun holds_physical(e: *Emit, ty: u32) bool {
    ret e.physical && types.holds_pointer(e.tt, ty, spirv.STORAGE_PHYSICAL_STORAGE_BUFFER);
}

# the zero of a type, built from its parts where it holds a physical pointer
fun zero_value(e: *Emit, ty: u32) u32 {
    if (!holds_physical(e, ty)) { ret types.const_null(e.tt, ty); }
    if (physical_type(e, ty))   { ret pointer_constant(e, ty, 0); }
    val n: u32 = types.composite_count(e.tt, ty);
    if (n == 0 || !types.instruction_operands_fit(2, n)) {
        e.b.err = true;
        ret 0;
    }
    val ar: res[*u32, A.Error] = A.allocate[u32](e.alloc, (n + 2)::usize);
    if (sel ar.err) {
        e.b.err = true;
        ret 0;
    }
    val words: *u32 = ar.ok;
    fin { A.deallocate[u32](e.alloc, words, (n + 2)::usize); }
    var i: u32 = 0;
    for (i < n) {
        words[2 + i] = zero_value(e, types.composite_member(e.tt, ty, i));
        i            = i + 1;
    }
    words[0] = ty;
    words[1] = spirv.alloc_id(e.b);
    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_CONSTRUCT, words, n + 2);
    ret words[1];
}

fun zeroes_shared(e: *Emit, fx: u32, irfn: *ir.Function) bool {
    if (irfn.stage != ir.STAGE_COMPUTE) { ret false; }
    var gx: u32 = 0;
    for (gx < e.gl_len) {
        if (gl_ir(e, gx).iface == ir.IFACE_SHARED && e.gslot[gx] != 0 && !shared_zeroed_natively(e, gx)
            && uses_iface(e, fx, e.gslot[gx] - 1)) {
            ret true;
        }
        gx = gx + 1;
    }
    ret false;
}

fun local_invocation_global(e: *Emit) u32 {
    var gx: u32 = 0;
    for (gx < e.gl_len) {
        val g: *ir.Global = gl_ir(e, gx);
        if (g.iface == ir.IFACE_BUILTIN && g.iface_a == ir.BUILTIN_LOCAL_INVOCATION_INDEX
            && e.gvar_ids[gx] != 0) {
            ret gx;
        }
        gx = gx + 1;
    }
    ret GL_NONE;
}

# the LocalInvocationIndex variable and its value type: a declared
# `#[builtin("local_invocation_index")]` where there is one, else one the emitter adds once
fun zero_lid(e: *Emit, out_ty: *u32) u32 {
    val gx: u32 = local_invocation_global(e);
    if (gx != GL_NONE) {
        @out_ty = e.gtype_ids[gx];
        ret e.gvar_ids[gx];
    }
    val u32t: u32 = types.type_int(e.tt, 32);
    @out_ty = u32t;
    if (e.zero_lid != 0) { ret e.zero_lid; }
    val var_id: u32 = spirv.alloc_id(e.b);
    var vop:    [3]u32;
    vop[0] = types.type_ptr(e.tt, spirv.STORAGE_INPUT, u32t);
    vop[1] = var_id;
    vop[2] = spirv.STORAGE_INPUT;
    spirv.inst(e.b, ?e.b.types_consts, spirv.OP_VARIABLE, ?vop[0], 3);
    decorate(e, var_id, spirv.DECOR_BUILTIN, spirv.BUILTIN_LOCAL_INVOCATION_INDEX);
    e.zero_lid = var_id;
    ret var_id;
}

fun emit_words(e: *Emit, opcode: u32, w0: u32, w1: u32, w2: u32, w3: u32, n: u32) {
    var ops: [4]u32;
    ops[0] = w0;
    ops[1] = w1;
    ops[2] = w2;
    ops[3] = w3;
    spirv.inst(e.b, ?e.b.functions, opcode, ?ops[0], n);
}

fun emit_label(e: *Emit, label: u32) {
    emit_words(e, spirv.OP_LABEL, label, 0, 0, 0, 1);
    dbgm.block(?e.dbg);
}

fun emit_pair(e: *Emit, opcode: u32, ty: u32, a: u32, b: u32) u32 {
    val result: u32 = spirv.alloc_id(e.b);
    emit_words(e, opcode, ty, result, a, b, 4);
    ret result;
}

# the prologue of a compute stage that zeroes the `#[shared]` memory it reaches:
# invocation i of a workgroup of w stores zero to the elements i, i + w, ... of each
# array and invocation 0 to each whole value, then one workgroup barrier makes the
# stores visible. it precedes all user code, so every invocation reaches the barrier
fun emit_shared_zeroing(e: *Emit, fx: u32, irfn: *ir.Function, first: u32, next: u32) err[fail.Fail] {
    var lty: u32 = 0;
    val lid: u32 = zero_lid(e, ?lty);
    val idx: u32 = spirv.alloc_id(e.b);
    emit_words(e, spirv.OP_LOAD, lty, idx, lid, 0, 3);
    val sr: res[u32, fail.Fail] = workgroup_invocations(e, irfn);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val step: u32 = sr.ok;

    var pred: u32 = first;
    var gx:   u32 = 0;
    for (gx < e.gl_len) {
        val g: *ir.Global = gl_ir(e, gx);
        if (g.iface != ir.IFACE_SHARED || e.gslot[gx] == 0 || shared_zeroed_natively(e, gx) || !uses_iface(e, fx, e.gslot[gx] - 1)) {
            gx = gx + 1;
            cnt;
        }
        var count:   u32               = 1;
        var elem_ty: u32               = e.gtype_ids[gx];
        var indexed: bool              = false;
        val gt:      *type.IrTypeTable = gl_types(e, gx);
        val to:      opt[*type.IrType] = type.get(gt, g.ty);
        if (sel to.some) {
            val t: *type.IrType = to.some;
            if (t.kind == type.IRT_ARRAY && t.data.array_.count > 0) {
                count   = t.data.array_.count;
                elem_ty = member_spv_type(e, gt, t.data.array_.element);
                indexed = true;
            }
        }
        if (elem_ty == 0) {
            ret unsupported(e, "unsupported `#[shared]` variable type in the SPIR-V target");
        }
        pred = emit_zero_loop(e, pred, e.gvar_ids[gx], elem_ty, indexed, count, idx, step);
        gx   = gx + 1;
    }

    val wg:  u32 = types.const_int(e.tt, 32, spirv.SCOPE_WORKGROUP::i64);
    val sem: u32 = types.const_int(e.tt, 32,
        (spirv.SEMANTICS_ACQUIRE_RELEASE | spirv.SEMANTICS_WORKGROUP_MEMORY)::i64);
    emit_words(e, spirv.OP_CONTROL_BARRIER, wg, wg, sem, 0, 3);
    emit_branch(e, next);
    if (e.b.err) { ret err[fail.Fail].err{fail.message("spirv.emit: module builder hit an allocation error")}; }
    ret err[fail.Fail].ok{};
}

# the id of the stage's invocation count per workgroup: a constant, or where a
# `#[spec]` var sizes a dimension the product the specialized size gives
fun workgroup_invocations(e: *Emit, irfn: *ir.Function) res[u32, fail.Fail] {
    if (!wg_is_spec(irfn)) {
        ret res[u32, fail.Fail].ok{types.const_int(e.tt, 32, (irfn.wg_x * irfn.wg_y * irfn.wg_z)::i64)};
    }
    val u32t: u32 = types.type_int(e.tt, 32);
    var n:    u32 = 0;
    var d:    u32 = 0;
    for (d < 3) {
        val r: res[u32, fail.Fail] = wg_dim_id(e, irfn, d);
        if (sel r.err) { ret r; }
        if (d == 0)    { n = r.ok; }
        or             { n = emit_pair(e, spirv.OP_I_MUL, u32t, n, r.ok); }
        d = d + 1;
    }
    ret res[u32, fail.Fail].ok{n};
}

# for (j = idx; j < count; j += step) var[j] = null, or the whole variable when
# not indexed; returns the merge block, where the code after it continues
fun emit_zero_loop(e: *Emit, pred: u32, var_id: u32, elem_ty: u32, indexed: bool,
    count: u32, idx: u32, step: u32) u32 {
    val u32t:   u32 = types.type_int(e.tt, 32);
    val header: u32 = spirv.alloc_id(e.b);
    val body:   u32 = spirv.alloc_id(e.b);
    val cont:   u32 = spirv.alloc_id(e.b);
    val merge:  u32 = spirv.alloc_id(e.b);
    val j:      u32 = spirv.alloc_id(e.b);
    val jn:     u32 = spirv.alloc_id(e.b);
    emit_branch(e, header);

    emit_label(e, header);
    var phi: [6]u32;
    phi[0] = u32t;
    phi[1] = j;
    phi[2] = idx;
    phi[3] = pred;
    phi[4] = jn;
    phi[5] = cont;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_PHI, ?phi[0], 6);
    val more: u32 = emit_pair(e, spirv.OP_U_LESS_THAN, types.type_bool(e.tt), j,
        types.const_int(e.tt, 32, count::i64));
    emit_words(e, spirv.OP_LOOP_MERGE, merge, cont, spirv.LOOP_CONTROL_NONE, 0, 3);
    emit_words(e, spirv.OP_BRANCH_CONDITIONAL, more, body, merge, 0, 3);

    emit_label(e, body);
    var ptr: u32 = var_id;
    if (indexed) {
        ptr = spirv.alloc_id(e.b);
        emit_words(e, spirv.OP_ACCESS_CHAIN, types.type_ptr(e.tt, spirv.STORAGE_WORKGROUP, elem_ty), ptr, var_id, j, 4);
        chain_memory_scope(e, ptr, var_id);
    }
    memory_store(e, ptr, zero_value(e, elem_ty), 0);
    emit_branch(e, cont);

    emit_label(e, cont);
    emit_words(e, spirv.OP_I_ADD, u32t, jn, j, step, 4);
    emit_branch(e, header);

    emit_label(e, merge);
    ret merge;
}

fun entry_lists(e: *Emit, fn_ix: u32, gx: u32) bool {
    if (e.gslot[gx] == 0 || !uses_iface(e, fn_ix, e.gslot[gx] - 1)) { ret false; }
    ret spirv.entry_interface_lists(e.b.version, e.gstorage[gx]);
}

fun emit_linkage_export(e: *Emit, fn: u32, name: str) {
    val sw_r: res[u32, fail.Fail] = spirv.string_words(name);
    if (sel sw_r.err) {
        e.b.err = true;
        ret;
    }
    val sw:    u32                = sw_r.ok;
    val total: u32                = 3 + sw;
    val ra:    res[*u32, A.Error] = A.allocate[u32](e.alloc, total::usize);
    if (sel ra.err) {
        e.b.err = true;
        ret;
    }
    val ops: *u32 = ra.ok;
    ops[0] = fn;
    ops[1] = spirv.DECOR_LINKAGE_ATTRIBUTES;
    spirv.pack_string(name, sw, ?ops[2]);
    ops[2 + sw] = spirv.LINKAGE_EXPORT;
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ops, total);
    A.deallocate[u32](e.alloc, ops, total::usize);
}

fun build_vmaps(e: *Emit, mf: *mir.MirFunction, irfn: *ir.Function, out: *VMaps) err[fail.Fail] {
    val n: u32 = mf.vreg_count;
    out.n        = n;
    out.type_id  = nil;
    out.var_id   = nil;
    out.is_bool  = nil;
    out.chain_id = nil;
    out.chain_ty = nil;
    out.chain_sc = nil;
    out.opq_var  = nil;
    out.opq_ssa  = nil;
    out.gep_at   = nil;
    out.prov     = nil;
    out.gep_ids  = vector.init[u32](e.alloc);
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val rt: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rt.err) { ret err[fail.Fail].err{fail.refused(rt.err)}; }
    out.type_id = rt.ok;
    val rv: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rv.err) { ret err[fail.Fail].err{fail.refused(rv.err)}; }
    out.var_id = rv.ok;
    val rb: res[*bool, A.Error] = A.allocate[bool](e.alloc, n::usize);
    if (sel rb.err) { ret err[fail.Fail].err{fail.refused(rb.err)}; }
    out.is_bool = rb.ok;
    val rch: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rch.err) { ret err[fail.Fail].err{fail.refused(rch.err)}; }
    out.chain_id = rch.ok;
    val rct: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rct.err) { ret err[fail.Fail].err{fail.refused(rct.err)}; }
    out.chain_ty = rct.ok;
    val rcs: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rcs.err) { ret err[fail.Fail].err{fail.refused(rcs.err)}; }
    out.chain_sc = rcs.ok;
    val rga: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rga.err) { ret err[fail.Fail].err{fail.refused(rga.err)}; }
    out.gep_at = rga.ok;
    val rov: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rov.err) { ret err[fail.Fail].err{fail.refused(rov.err)}; }
    out.opq_var = rov.ok;
    val ros: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel ros.err) { ret err[fail.Fail].err{fail.refused(ros.err)}; }
    out.opq_ssa = ros.ok;
    val rpv: res[*u8, A.Error] = A.allocate[u8](e.alloc, n::usize);
    if (sel rpv.err) { ret err[fail.Fail].err{fail.refused(rpv.err)}; }
    out.prov = rpv.ok;
    classify_pointers(e, e.cur_copy, mf, out.prov);

    var i: u32 = 0;
    for (i < n) {
        out.type_id[i]  = 0;
        out.var_id[i]   = 0;
        out.is_bool[i]  = false;
        out.chain_id[i] = 0;
        out.chain_ty[i] = 0;
        out.chain_sc[i] = 0;
        out.gep_at[i]   = 0;
        out.opq_var[i]  = 0;
        out.opq_ssa[i]  = 0;
        i               = i + 1;
    }

    var pb: u32 = 0;
    for (pb < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[pb];
        var ei:  u32           = 0;
        for (ei < blk.instr_count) {
            val mi:   *mir.MirInstr   = ?blk.instrs[ei];
            var dest: *mir.MirOperand = nil;
            var ty:   u32             = 0;
            if (mi.opcode == mir.MIR_VALUE_PARAM) {
                if (mi.operand_count != 2 || mi.operands[1].kind != mir.MIR_OP_IMM
                    || mi.operands[1].imm < 0 || mi.operands[1].imm >= irfn.param_count::i64) {
                    ret emit_fail(e, "spirv.emit: malformed logical parameter binding");
                }
                dest = ?mi.operands[0];
                ty   = ir_value_spv_type(e, irfn.params[mi.operands[1].imm::u32].ty);
            }
            or (mi.opcode == mir.MIR_VALUE_CALL) {
                if (mi.operand_count < 2) { ret emit_fail(e, "spirv.emit: malformed logical call"); }
                dest = ?mi.operands[1];
                val row: *isa.OpDef = call_op_row_in(e, e.ir, mi);
                if (row != nil && row.result == isa.OP_RESULT_BOOL) { ty = types.type_bool(e.tt); }
                or (dest.kind == mir.MIR_OP_VREG && dest.vreg.n < n) {
                    ty = ir_value_spv_type(e, mf.vregs[dest.vreg.n].ty);
                }
            }
            if (dest != nil && dest.kind == mir.MIR_OP_VREG && dest.vreg.n < n && ty != 0) {
                out.type_id[dest.vreg.n] = ty;
                out.is_bool[dest.vreg.n] = types.type_is_bool(e.tt, ty);
            }
            ei = ei + 1;
        }
        pb = pb + 1;
    }

    val r1: err[fail.Fail] = type_computed_defs(e, mf, out, true);
    if (sel r1.err) { ret r1; }
    propagate_copy_types(mf, out);
    seed_declared_copy_types(e, mf, out);
    propagate_copy_types(mf, out);
    val r2: err[fail.Fail] = type_computed_defs(e, mf, out, false);
    if (sel r2.err) { ret r2; }
    val pr: err[fail.Fail] = type_physical_values(e, mf, out);
    if (sel pr.err) { ret pr; }

    val ar: err[fail.Fail] = declare_allocas(e, mf, irfn, out);
    if (sel ar.err) { ret ar; }

    i = 0;
    for (i < n) {
        var storage:  u32  = 0;
        val physical: bool = (out.prov[i] & PROV_PHYSICAL) != 0;
        if (out.type_id[i] != 0 && !types.type_is_opaque(e.tt, out.type_id[i])
            && (physical || types.pointer_shape(e.tt, out.type_id[i], ?storage) == 0)) {
            val ptr_ty: u32 = types.type_ptr(e.tt, spirv.STORAGE_FUNCTION, out.type_id[i]);
            val var_id: u32 = spirv.alloc_id(e.b);
            var vop:    [3]u32;
            vop[0] = ptr_ty;
            vop[1] = var_id;
            vop[2] = spirv.STORAGE_FUNCTION;
            spirv.inst(e.b, ?e.b.functions, spirv.OP_VARIABLE, ?vop[0], 3);
            # a variable holding a physical pointer says whether what it points at is aliased
            if (physical) { decorate_bare(e, var_id, spirv.DECOR_ALIASED_POINTER); }
            out.var_id[i] = var_id;
        }
        i = i + 1;
    }
    name_bound_values(e, mf, irfn, out);
    ret err[fail.Fail].ok{};
}

# the declared IR type of register `v`, nil when it has none
fun vreg_ir_type(e: *Emit, mf: *mir.MirFunction, v: u32) *type.IrType {
    if (v >= mf.vreg_count || mf.vregs[v].ty == mir.VREG_TY_NIL) { ret nil; }
    val t: opt[*type.IrType] = type.get(?e.ir.types, mf.vregs[v].ty);
    if (sel t.none) { ret nil; }
    ret t.some;
}

fun vreg_is_pointer(e: *Emit, mf: *mir.MirFunction, v: u32) bool {
    val t: *type.IrType = vreg_ir_type(e, mf, v);
    ret t != nil && t.kind == type.IRT_PTR;
}

fun prov_of(prov: *u8, n: u32, op: *mir.MirOperand) u8 {
    var v: u32 = mir.MIR_VREG_NIL.n;
    if (op.kind == mir.MIR_OP_VREG || op.kind == mir.MIR_OP_MEM) { v = op.vreg.n; }
    if (v >= n)                                                  { ret 0; }
    ret prov[v];
}

# a pointer made from `nil` alone, which takes the provenance of what it meets
val PROV_NIL: u8 = 4;

# where each pointer register of copy `cx` points, from its definitions: a local, an
# interface variable and a logically bound parameter name declared memory, and so does
# an access chain into one. a pointer read from memory, made from an address, returned
# by a function or bound as a physical parameter is a physical pointer, since memory
# holds no logical one. a copy or a select takes its operands' provenance, so a register
# both reach is one the emitter refuses. a pointer only ever `nil` is physical (#4307)
fun classify_pointers(e: *Emit, cx: u32, mf: *mir.MirFunction, prov: *u8) {
    val n: u32 = mf.vreg_count;
    var i: u32 = 0;
    for (i < n) {
        prov[i] = 0;
        i       = i + 1;
    }
    var key: u32 = COPY_NONE;
    var fx:  u32 = FN_NONE;
    if (cx != COPY_NONE) {
        key = e.copies.data[cx].key_at;
        fx  = e.copies.data[cx].fx;
    }
    var changed: bool = true;
    for (changed) {
        changed = false;
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii:  u32           = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                ii = ii + 1;
                var dst: u32           = mir.MIR_VREG_NIL.n;
                var got: u8            = 0;
                val op:  mir.MirOpcode = mi.opcode;
                if (op == mir.MIR_VALUE_CALL) {
                    if (mi.operand_count < 2 || mi.operands[1].kind != mir.MIR_OP_VREG) { cnt; }
                    dst = mi.operands[1].vreg.n;
                    if (!vreg_is_pointer(e, mf, dst)) { cnt; }
                    got = PROV_PHYSICAL;
                    if (call_op_row_in(e, e.ir, mi) != nil) { got = PROV_LOGICAL; }
                }
                or (op == mir.MIR_VALUE_PARAM) {
                    if (mi.operand_count != 2 || mi.operands[0].kind != mir.MIR_OP_VREG || mi.operands[1].kind != mir.MIR_OP_IMM) { cnt; }
                    if (fx == FN_NONE || mi.operands[1].imm < 0 || !param_is_pointer(e, fx, mi.operands[1].imm::u32))             { cnt; }
                    dst = mi.operands[0].vreg.n;
                    got = PROV_LOGICAL;
                    if (e.keys.data[key_param(e, key, mi.operands[1].imm::u32)] == BIND_PHYSICAL) { got = PROV_PHYSICAL; }
                }
                or (op == mir.MIR_STORE || op == mir.MIR_MEMCPY || op == mir.MIR_MEMZERO) { cnt; }
                or {
                    if (!mir.instr_defines_shape(mi) || mi.operand_count == 0 || mi.operands[0].kind != mir.MIR_OP_VREG) { cnt; }
                    dst = mi.operands[0].vreg.n;
                    if (op == mir.MIR_ALLOCA) { got = PROV_LOGICAL; }
                    or (op == mir.MIR_GEP && mi.operand_count >= 2) {
                        if (mi.operands[1].kind == mir.MIR_OP_SYM) { got = PROV_LOGICAL; }
                        or                                         { got = prov_of(prov, n, ?mi.operands[1]) & (PROV_LOGICAL | PROV_PHYSICAL); }
                    }
                    or (op == mir.MIR_LOAD) {
                        if (vreg_is_pointer(e, mf, dst)) { got = PROV_PHYSICAL; }
                    }
                    or (op == mir.MIR_BITCAST && mi.operand_count == 2) {
                        if (vreg_is_pointer(e, mf, dst)) {
                            got = PROV_PHYSICAL;
                            if (mi.operands[1].kind == mir.MIR_OP_VREG && vreg_is_pointer(e, mf, mi.operands[1].vreg.n)) {
                                got = prov_of(prov, n, ?mi.operands[1]);
                            }
                        }
                    }
                    or (is_reg_copy(mi)) {
                        if (mi.operands[1].kind == mir.MIR_OP_VREG)                               { got = prov_of(prov, n, ?mi.operands[1]); }
                        or (mi.operands[1].kind == mir.MIR_OP_IMM && vreg_is_pointer(e, mf, dst)) { got = PROV_NIL; }
                    }
                    or (op == mir.MIR_SELECT || op == mir.MIR_SELECT_CMP) {
                        var ai: u32 = 2;
                        if (op == mir.MIR_SELECT_CMP) { ai = 3; }
                        if (mi.operand_count >= ai + 2) {
                            got = prov_of(prov, n, ?mi.operands[ai]) | prov_of(prov, n, ?mi.operands[ai + 1]);
                            if (mi.operands[ai].kind == mir.MIR_OP_IMM && vreg_is_pointer(e, mf, dst))     { got = got | PROV_NIL; }
                            if (mi.operands[ai + 1].kind == mir.MIR_OP_IMM && vreg_is_pointer(e, mf, dst)) { got = got | PROV_NIL; }
                        }
                    }
                }
                if (dst >= n || got == 0 || (prov[dst] | got) == prov[dst]) { cnt; }
                prov[dst] = prov[dst] | got;
                changed   = true;
            }
            bi = bi + 1;
        }
    }
    i = 0;
    for (i < n) {
        if (prov[i] == PROV_NIL) { prov[i] = PROV_PHYSICAL; }
        i = i + 1;
    }
}

# a physical pointer register that a copy, a load, a call or a parameter defines holds the
# pointer as a value of its PhysicalStorageBuffer pointer type. one only an access chain
# defines is that chain, like a logical one (#4307)
fun type_physical_values(e: *Emit, mf: *mir.MirFunction, vm: *VMaps) err[fail.Fail] {
    val n:  u32                 = vm.n;
    val rv: res[*bool, A.Error] = A.allocate[bool](e.alloc, (n + 1)::usize);
    if (sel rv.err) { ret err[fail.Fail].err{fail.refused(rv.err)}; }
    val value: *bool = rv.ok;
    fin { A.deallocate[bool](e.alloc, value, (n + 1)::usize); }
    var i: u32 = 0;
    for (i < n) {
        value[i] = false;
        i        = i + 1;
    }
    var mixed: *mir.MirInstr = nil;
    var bi:    u32           = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            ii = ii + 1;
            var dst: u32 = mir.MIR_VREG_NIL.n;
            if (mi.opcode == mir.MIR_VALUE_CALL && mi.operand_count >= 2 && mi.operands[1].kind == mir.MIR_OP_VREG)              { dst = mi.operands[1].vreg.n; }
            or (mi.operand_count > 0 && mi.operands[0].kind == mir.MIR_OP_VREG && instr_defines_vreg(mi, mi.operands[0].vreg.n)) { dst = mi.operands[0].vreg.n; }
            if (dst >= n)                                                                                                        { cnt; }
            if ((vm.prov[dst] & (PROV_LOGICAL | PROV_PHYSICAL)) == (PROV_LOGICAL | PROV_PHYSICAL) && mixed == nil)               { mixed = mi; }
            if (mi.opcode != mir.MIR_GEP)                                                                                        { value[dst] = true; }
        }
        bi = bi + 1;
    }
    if (mixed != nil) {
        e.cur_instr = mixed;
        ret unsupported(e, "this pointer is a logical pointer on one path and a physical pointer on another: a logical pointer names memory the module declares and a physical one an address in a buffer the host passes, and SPIR-V gives the two different storage classes, so one register cannot hold both. keep the two pointers in separate variables");
    }
    i = 0;
    for (i < n) {
        if ((vm.prov[i] & PROV_PHYSICAL) == 0 || !value[i]) {
            i = i + 1;
            cnt;
        }
        val t: *type.IrType = vreg_ir_type(e, mf, i);
        if (t == nil || t.kind != type.IRT_PTR) {
            i = i + 1;
            cnt;
        }
        val pr: res[u32, fail.Fail] = phys_pointer(e, ?e.ir.types, mf.vregs[i].ty);
        if (sel pr.err) { ret err[fail.Fail].err{pr.err}; }
        vm.type_id[i] = pr.ok;
        vm.is_bool[i] = false;
        i             = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a source variable bound to a value names the function variable that holds it
fun name_bound_values(e: *Emit, mf: *mir.MirFunction, irfn: *ir.Function, vm: *VMaps) {
    if (!e.dbg.on) { ret; }
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            var di: u32           = 0;
            for (di < mi.dbg_binding_count) {
                val bind: *mir.MirDbgBinding = ?mi.dbg_bindings[di];
                if (bind.vreg < vm.n && vm.var_id[bind.vreg] != 0) {
                    val dv: opt[*ir.DbgVar] = ir.dbg_var_get(irfn, bind.iid::id.InstructionId);
                    if (sel dv.some) { dbgm.name(?e.dbg, vm.var_id[bind.vreg], dv.some.name); }
                }
                di = di + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun declare_allocas(e: *Emit, mf: *mir.MirFunction, irfn: *ir.Function, out: *VMaps) err[fail.Fail] {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mi.opcode != mir.MIR_ALLOCA || mi.operand_count < 2
                || mi.operands[0].kind != mir.MIR_OP_VREG) {
                ii = ii + 1;
                cnt;
            }
            val dst: u32 = mi.operands[0].vreg.n;
            if (dst >= out.n) {
                ii = ii + 1;
                cnt;
            }

            val slot: *mir.MirSlot = find_slot(mf, mi.operands[1].vreg.n);
            if (slot == nil || slot.ty == mir.SLOT_TY_NIL) {
                ret unsupported(e, "a local allocation whose type was not recorded is not supported by the SPIR-V target: a shader variable needs a type, and a size and alignment do not determine one");
            }
            var ty: u32 = ir_value_spv_type(e, slot.ty);
            # a pointer held in a local is in memory, so it is a physical one (#4307)
            val st: opt[*type.IrType] = type.get(?e.ir.types, slot.ty);
            if (sel st.some && st.some.kind == type.IRT_PTR) { ty = phys_pointer_quiet(e, ?e.ir.types, slot.ty); }
            if (ty == 0) {
                ret unsupported(e, "unsupported local allocation type in the SPIR-V target");
            }
            if (slot.size != type.byte_size_for_machine(?e.ir.types, slot.ty, e.layout)) {
                ret unsupported(e, "a multi-element local allocation is not supported by the SPIR-V target: it is an array of whole objects reached by pointer arithmetic, which the logical addressing model has no form for");
            }

            var storage: u32 = 0;
            if (types.pointer_shape(e.tt, ty, ?storage) != 0 && storage != spirv.STORAGE_PHYSICAL_STORAGE_BUFFER) {
                ret unsupported(e, "SPIR-V Logical Shader pointer-valued local storage requires VariablePointers capability");
            }
            val ptr_ty: u32 = types.type_ptr(e.tt, spirv.STORAGE_FUNCTION, ty);
            val var_id: u32 = spirv.alloc_id(e.b);
            var vop:    [3]u32;
            vop[0] = ptr_ty;
            vop[1] = var_id;
            vop[2] = spirv.STORAGE_FUNCTION;
            spirv.inst(e.b, ?e.b.functions, spirv.OP_VARIABLE, ?vop[0], 3);
            if (storage == spirv.STORAGE_PHYSICAL_STORAGE_BUFFER) { decorate_bare(e, var_id, spirv.DECOR_ALIASED_POINTER); }
            if (slot.origin != mir.SLOT_ORIGIN_NIL) {
                val local: opt[*ir.DbgVar] = ir.alloca_dbg_var_get(irfn, slot.origin::id.InstructionId);
                if (sel local.some) { dbgm.name(?e.dbg, var_id, local.some.name); }
            }
            out.chain_id[dst] = var_id;
            out.chain_ty[dst] = ty;
            out.chain_sc[dst] = spirv.STORAGE_FUNCTION;
            ii                = ii + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun find_slot(mf: *mir.MirFunction, key: u32) *mir.MirSlot {
    var i: u32 = 0;
    for (i < mf.frame.slot_count) {
        if (mf.frame.slots[i].value == key) { ret ?mf.frame.slots[i]; }
        i = i + 1;
    }
    ret nil;
}

fun type_computed_defs(e: *Emit, mf: *mir.MirFunction, out: *VMaps, skip_copies: bool) err[fail.Fail] {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mi.opcode == mir.MIR_GEP || mi.opcode == mir.MIR_ALLOCA) {
                ii = ii + 1;
                cnt;
            }
            if (mi.opcode == mir.MIR_LOAD && mi.operand_count == 2
                && mi.operands[0].kind == mir.MIR_OP_VREG) {
                val lv: u32 = mi.operands[0].vreg.n;
                # an interface is read into the type a function carries its value in
                var lt: u32 = carried_value_type(e, interface_value_type(e, ?mi.operands[1]));
                if (lt != 0 && types.is_composite(e.tt, lt)) {
                    val leaf: u32 = leading_leaf_type(e, lt);
                    lt = 0;
                    if (mi.width != 0 && types.type_bits(e.tt, leaf) == mi.width::u32 * 8) { lt = leaf; }
                }
                if (lv < out.n && out.type_id[lv] == 0 && lt != 0) {
                    out.type_id[lv] = lt;
                    out.is_bool[lv] = types.type_is_bool(e.tt, lt);
                    ii              = ii + 1;
                    cnt;
                }
            }
            if (mir.instr_defines_shape(mi) && mi.operands[0].kind == mir.MIR_OP_VREG) {
                val v: u32 = mi.operands[0].vreg.n;
                if (v < out.n && out.type_id[v] == 0 && !(skip_copies && is_reg_copy(mi))) {
                    val boolean: bool = (mir.is_cmp_opcode(mi.opcode) || mi.opcode == mir.MIR_FCMP)
                        && !mir.vec_lane_is_vector(mi.vec_lane);
                    out.is_bool[v] = boolean;
                    if (boolean) {
                        out.type_id[v] = types.type_bool(e.tt);
                    }
                    or {
                        var bytes: u32 = mi.width::u32;
                        if (bytes == 0) { bytes = e.tgt.model.gpr_width; }
                        val t: u32 = value_type_for(e, mf, mi, v, bytes::u8);
                        if (t == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
                        out.type_id[v] = t;
                    }
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun is_reg_copy(mi: *mir.MirInstr) bool {
    if (mi.opcode != mir.MIR_MOV && mi.opcode != mir.MIR_DECLASSIFY) { ret false; }
    if (mi.operand_count != 2)                                       { ret false; }
    ret mi.operands[1].kind == mir.MIR_OP_VREG
        || mi.operands[1].kind == mir.MIR_OP_IMM;
}

fun propagate_copy_types(mf: *mir.MirFunction, out: *VMaps) {
    var changed: bool = true;
    for (changed) {
        changed = false;
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii:  u32           = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                if (is_reg_copy(mi) && mi.operands[0].kind == mir.MIR_OP_VREG &&
                    mi.operands[1].kind == mir.MIR_OP_VREG) {
                    val d:  u32 = mi.operands[0].vreg.n;
                    val sv: u32 = mi.operands[1].vreg.n;
                    if (d < out.n && sv < out.n && out.type_id[d] == 0 && out.type_id[sv] != 0) {
                        out.type_id[d] = out.type_id[sv];
                        out.is_bool[d] = out.is_bool[sv];
                        changed        = true;
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }
}

fun seed_declared_copy_types(e: *Emit, mf: *mir.MirFunction, out: *VMaps) {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (is_reg_copy(mi) && mi.operands[0].kind == mir.MIR_OP_VREG) {
                val v: u32 = mi.operands[0].vreg.n;
                if (v < out.n && v < mf.vreg_count && out.type_id[v] == 0
                    && mf.vregs[v].ty != mir.VREG_TY_NIL) {
                    val t: u32 = ir_value_spv_type(e, mf.vregs[v].ty);
                    if (t != 0) {
                        out.type_id[v] = t;
                        out.is_bool[v] = types.type_is_bool(e.tt, t);
                    }
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun vmaps_dnit(e: *Emit, vm: *VMaps) {
    if (vm.type_id != nil)  { A.deallocate[u32](e.alloc, vm.type_id, vm.n::usize); }
    if (vm.var_id != nil)   { A.deallocate[u32](e.alloc, vm.var_id, vm.n::usize); }
    if (vm.is_bool != nil)  { A.deallocate[bool](e.alloc, vm.is_bool, vm.n::usize); }
    if (vm.opq_var != nil)  { A.deallocate[u32](e.alloc, vm.opq_var, vm.n::usize); }
    if (vm.opq_ssa != nil)  { A.deallocate[u32](e.alloc, vm.opq_ssa, vm.n::usize); }
    if (vm.chain_id != nil) { A.deallocate[u32](e.alloc, vm.chain_id, vm.n::usize); }
    if (vm.chain_ty != nil) { A.deallocate[u32](e.alloc, vm.chain_ty, vm.n::usize); }
    if (vm.chain_sc != nil) { A.deallocate[u32](e.alloc, vm.chain_sc, vm.n::usize); }
    if (vm.gep_at != nil)   { A.deallocate[u32](e.alloc, vm.gep_at, vm.n::usize); }
    if (vm.prov != nil)     { A.deallocate[u8](e.alloc, vm.prov, vm.n::usize); }
    vector.dnit[u32](?vm.gep_ids);
    vm.type_id  = nil;
    vm.var_id   = nil;
    vm.is_bool  = nil;
    vm.chain_id = nil;
    vm.chain_ty = nil;
    vm.chain_sc = nil;
    vm.gep_at   = nil;
    vm.prov     = nil;
    vm.n        = 0;
}

fun lane_type_of(e: *Emit, lane: u32) u32 {
    val bits: u32 = mir.vec_lane_elem_bytes(lane)::u32 * 8;
    if (mir.vec_lane_kind(lane) == mir.VEC_LANE_FLOAT) {
        if (bits != 16 && bits != 32 && bits != 64) { ret 0; }
        ret types.type_float(e.tt, bits);
    }
    if (bits != 8 && bits != 16 && bits != 32 && bits != 64) { ret 0; }
    ret types.type_int(e.tt, bits);
}

fun vector_type_of(e: *Emit, lane: u32, as_int: bool) u32 {
    var lane_ty: u32 = 0;
    if (as_int) {
        val bits: u32 = mir.vec_lane_elem_bytes(lane)::u32 * 8;
        if (bits != 8 && bits != 16 && bits != 32 && bits != 64) { ret 0; }
        lane_ty = types.type_int(e.tt, bits);
    }
    or                { lane_ty = lane_type_of(e, lane); }
    if (lane_ty == 0) { ret 0; }
    ret types.type_vector_value(e.tt, lane_ty, mir.vec_lane_count(lane));
}

fun value_type_for(e: *Emit, mf: *mir.MirFunction, mi: *mir.MirInstr, vreg: u32, width: u8) u32 {
    # an f16 register is the float its type declares, which no width or lane class spells
    if (vreg < mf.vreg_count && mf.vregs[vreg].ty != mir.VREG_TY_NIL && is_half_value(e, mf.vregs[vreg].ty)) {
        ret spv_type_of(e, ?e.ir.types, mf.vregs[vreg].ty);
    }
    if (mir.vec_lane_is_vector(mi.vec_lane)) {
        if (mi.opcode == mir.MIR_VEC_EXTRACT) { ret carried_lane_type(e, lane_type_of(e, mi.vec_lane)); }
        val as_int: bool = mir.is_cmp_opcode(mi.opcode) || mi.opcode == mir.MIR_FCMP;
        ret vector_type_of(e, mi.vec_lane, as_int);
    }
    var bytes: u32 = width::u32;
    if (bytes == 0) { bytes = e.tgt.model.gpr_width; }
    val bits:     u32  = bytes * 8;
    var floating: bool = mi.opcode == mir.MIR_FADD || mi.opcode == mir.MIR_FSUB
        || mi.opcode == mir.MIR_FMUL || mi.opcode == mir.MIR_FDIV || mi.opcode == mir.MIR_FNEG
        || mi.opcode == mir.MIR_FP_TRUNC || mi.opcode == mir.MIR_FP_EXT
        || mi.opcode == mir.MIR_SI_TO_FP || mi.opcode == mir.MIR_UI_TO_FP;
    if (vreg < mf.vreg_count && mf.vregs[vreg].ty != mir.VREG_TY_NIL) {
        val declared: opt[*type.IrType] = type.get(?e.ir.types, mf.vregs[vreg].ty);
        # a handle read through a pointer is the handle, which no width spells
        if (sel declared.some && declared.some.kind == type.IRT_HANDLE) { ret spv_type_of(e, ?e.ir.types, mf.vregs[vreg].ty); }
        if (sel declared.some)                                          { floating = declared.some.kind == type.IRT_FLOAT; }
    }
    if (floating) {
        if (bits == 16 || bits == 32 || bits == 64) { ret types.type_float(e.tt, bits); }
        ret 0;
    }
    if (bits == 8 || bits == 16 || bits == 32 || bits == 64) { ret types.type_int(e.tt, carrier_bits(e, bits)); }
    ret 0;
}

# an ir f16 carrier, or a vector of them, that half_memory makes an OpTypeFloat 16
fun is_half_value(e: *Emit, id: type.IrTypeId) bool {
    if (!half_memory(e)) { ret false; }
    val tys: *type.IrTypeTable = ?e.ir.types;
    val o:   opt[*type.IrType] = type.get(tys, id);
    if (sel o.none) { ret false; }
    var lane: type.IrTypeId = id;
    if (o.some.kind == type.IRT_VECTOR) { lane = o.some.data.vector_.element; }
    val lo: opt[*type.IrType] = type.get(tys, lane);
    if (sel lo.none) { ret false; }
    ret lo.some.kind == type.IRT_INT && type.int_form(tys, lane) == type.INT_FORM_BINARY16;
}

# the width an integer of `bits` is carried at outside host-shared memory: its
# own where the environment has its capability, otherwise the narrowest wider
# width the model's alu computes at under every environment (#4302)
fun carrier_bits(e: *Emit, bits: u32) u32 {
    if (bits == 0 || bits % 8 != 0 || bits > 64) { ret bits; }
    ret isa.clamp_alu_width(?e.tgt.model, (bits / 8)::u8)::u32 * 8;
}

# the spirv type a value of an ir type has in a function: a scalar integer at
# its carrier, a pointer to one pointing at the carrier, and every other type
# as declared, since a composite member keeps its width wherever it lives
fun value_spv_type(e: *Emit, tys: *type.IrTypeTable, id: type.IrTypeId) u32 {
    val opt_: opt[*type.IrType] = type.get(tys, id);
    if (sel opt_.none) { ret 0; }
    val t: *type.IrType = opt_.some;
    if (t.kind == type.IRT_INT && type.int_form(tys, id) != type.INT_FORM_BINARY16) {
        ret types.type_int(e.tt, carrier_bits(e, t.data.bits));
    }
    if (t.kind == type.IRT_PTR && t.data.pointee != type.IRT_NIL) {
        val pointee: u32 = value_spv_type(e, tys, t.data.pointee);
        if (pointee == 0) { ret 0; }
        ret types.type_ptr(e.tt, spirv.STORAGE_FUNCTION, pointee);
    }
    ret spv_type_of(e, tys, id);
}

# a carried integer read as one of `bits`: the arithmetic leaves the carrier's
# upper bits unspecified, so the value is zero- or sign-extended from `bits`
# wherever they would be observed. a value at its own width is as it is
fun narrow_extend(e: *Emit, value: u32, ty: u32, bits: u32, signed: bool) u32 {
    if (value == 0 || bits == 0 || types.type_is_bool(e.tt, ty) || types.type_is_float(e.tt, ty)) { ret value; }
    val cb: u32 = types.type_bits(e.tt, ty);
    if (cb == 0 || bits >= cb) { ret value; }
    val result: u32 = spirv.alloc_id(e.b);
    var words:  [4]u32;
    words[0] = ty;
    if (!signed) {
        words[1] = result;
        words[2] = value;
        words[3] = immediate(e, ty, ((1::u64 << bits::u64) - 1):~i64);
        spirv.inst(e.b, ?e.b.functions, spirv.OP_BITWISE_AND, ?words[0], 4);
        ret result;
    }
    val count:   u32 = immediate(e, ty, (cb - bits)::i64);
    val shifted: u32 = spirv.alloc_id(e.b);
    words[1] = shifted;
    words[2] = value;
    words[3] = count;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_SHIFT_LEFT_LOGICAL, ?words[0], 4);
    words[1] = result;
    words[2] = shifted;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_SHIFT_RIGHT_ARITHMETIC, ?words[0], 4);
    ret result;
}

# an integer operand read at `bits`, in the carrier of that width
fun read_narrow(e: *Emit, vm: *VMaps, op: *mir.MirOperand, ty: u32, bits: u32, signed: bool) u32 {
    if (op.kind == mir.MIR_OP_IMM && bits > 0 && bits < 64) {
        # a constant is extended from `bits` as the value it is compared with is
        val low: u64 = op.imm::u64 & ((1::u64 << bits::u64) - 1);
        var v:   i64 = low:~i64;
        if (signed && (low >> (bits - 1)::u64) != 0) { v = (low | ~((1::u64 << bits::u64) - 1)):~i64; }
        ret immediate(e, ty, v);
    }
    ret narrow_extend(e, read_operand(e, vm, op, ty), ty, bits, signed);
}

# the spirv type of an ir type. an f16, carried in the ir as a 16-bit integer whose form
# is binary16, is the OpTypeFloat 16 it stands for wherever half_memory holds, in memory
# and in a function alike (#4339), and its 16-bit integer bits otherwise
fun spv_type_of(e: *Emit, tys: *type.IrTypeTable, id: type.IrTypeId) u32 {
    val opt_: opt[*type.IrType] = type.get(tys, id);
    if (sel opt_.none) { ret 0; }
    val t: *type.IrType = opt_.some;
    if (t.kind == type.IRT_PTR) {
        if (t.data.pointee == type.IRT_NIL) { ret 0; }
        val pointee: u32 = spv_type_of(e, tys, t.data.pointee);
        if (pointee == 0) { ret 0; }
        ret types.type_ptr(e.tt, spirv.STORAGE_FUNCTION, pointee);
    }
    if (t.kind == type.IRT_INT && half_memory(e) && t.data.bits == 16 && type.int_form(tys, id) == type.INT_FORM_BINARY16) {
        ret types.type_float(e.tt, 16);
    }
    if (t.kind == type.IRT_INT)   { ret types.type_int(e.tt, t.data.bits); }
    if (t.kind == type.IRT_FLOAT) { ret types.type_float(e.tt, t.data.bits); }
    if (t.kind == type.IRT_VECTOR) {
        val elem: u32 = spv_type_of(e, tys, t.data.vector_.element);
        if (elem == 0) { ret 0; }
        ret types.type_vector_value(e.tt, elem, t.data.vector_.lanes);
    }
    if (t.kind == type.IRT_ARRAY) {
        val elem: u32 = member_spv_type(e, tys, t.data.array_.element);
        if (elem == 0) { ret 0; }
        ret types.type_array(e.tt, elem, t.data.array_.count, false);
    }
    if (t.kind == type.IRT_HANDLE) { ret handle_spv_type(e, tys, t); }
    if (t.kind == type.IRT_TAG)    { ret tag_spv_type(e, tys, id); }
    if (t.kind == type.IRT_STRUCT) {
        val n: u32 = t.data.struct_.field_count;
        if (n == 0 || n > types.MAX_STRUCT_MEMBERS) { ret 0; }
        var members: [16]u32;
        var i:       u32 = 0;
        for (i < n) {
            val mt: u32 = member_spv_type(e, tys, t.data.struct_.fields[i]);
            if (mt == 0) { ret 0; }
            members[i] = mt;
            i          = i + 1;
        }
        ret types.type_struct(e.tt, ?members[0], n, false);
    }
    ret 0;
}

# the type of a member or an element: a pointer held in an aggregate is a physical one (#4307)
fun member_spv_type(e: *Emit, tys: *type.IrTypeTable, id: type.IrTypeId) u32 {
    val opt_: opt[*type.IrType] = type.get(tys, id);
    if (sel opt_.some && opt_.some.kind == type.IRT_PTR) { ret phys_pointer_quiet(e, tys, id); }
    ret spv_type_of(e, tys, id);
}

# a tag is the composite of its declared discriminator and one member per case in declaration
# order, the unit composite standing in for a payloadless case, so case c is member 1 + c
fun tag_spv_type(e: *Emit, tys: *type.IrTypeTable, id: type.IrTypeId) u32 {
    val n: u32 = type.tag_case_count(tys, id);
    if (n == 0 || n + 1 > types.MAX_STRUCT_MEMBERS) { ret 0; }
    var members: [16]u32;
    members[0] = types.type_int(e.tt, type.tag_discriminator_bytes(tys, id) * 8);
    if (members[0] == 0) { ret 0; }
    var i: u32 = 0;
    for (i < n) {
        var mt: u32 = 0;
        if (!type.tag_case_has_payload(tys, id, i)) { mt = types.type_unit(e.tt); }
        or {
            mt = spv_type_of(e, tys, type.tag_case_type(tys, id, i));
            var storage: u32 = 0;
            if (mt != 0 && types.pointer_shape(e.tt, mt, ?storage) != 0) { mt = 0; }
        }
        if (mt == 0) { ret 0; }
        members[1 + i] = mt;
        i              = i + 1;
    }
    ret types.type_tag_struct(e.tt, ?members[0], n + 1);
}

fun ir_value_spv_type(e: *Emit, id: type.IrTypeId) u32 {
    ret value_spv_type(e, ?e.ir.types, id);
}

fun global_spv_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) u32 {
    ret spv_type_of(e, gt, id);
}

fun handle_spv_type(e: *Emit, tys: *type.IrTypeTable, t: *type.IrType) u32 {
    val ctor: u32 = t.data.handle_.ctor;
    val n:    u32 = t.data.handle_.count;

    if (ctor == defs.SPV_CTOR_SAMPLER) { ret types.type_sampler(e.tt); }

    if (ctor == defs.SPV_CTOR_SAMPLED_IMAGE) {
        if (n != 1) { ret 0; }
        val img: u32 = spv_type_of(e, tys, t.data.handle_.operands[0]);
        if (img == 0) { ret 0; }
        ret types.type_sampled_image(e.tt, img);
    }

    if (ctor == defs.SPV_CTOR_IMAGE) {
        if (n != defs.IMAGE_ARITY) { ret 0; }
        ret types.type_image(e.tt,
            texel_spv_type(e, t.data.handle_.operands[defs.IMAGE_OP_TEXEL]::u32),
            t.data.handle_.operands[defs.IMAGE_OP_DIM]::u32,
            t.data.handle_.operands[defs.IMAGE_OP_DEPTH]::u32,
            t.data.handle_.operands[defs.IMAGE_OP_ARRAYED]::u32,
            t.data.handle_.operands[defs.IMAGE_OP_MS]::u32,
            t.data.handle_.operands[defs.IMAGE_OP_SAMPLED]::u32,
            t.data.handle_.operands[defs.IMAGE_OP_FORMAT]::u32);
    }

    ret 0;
}

fun texel_spv_type(e: *Emit, texel: u32) u32 {
    if (texel == defs.TEXEL_I32 || texel == defs.TEXEL_U32) { ret types.type_int(e.tt, 32); }
    if (texel == defs.TEXEL_I64 || texel == defs.TEXEL_U64) { ret types.type_int(e.tt, 64); }
    ret types.type_float(e.tt, 32);
}

fun ir_return_spv_type(e: *Emit, irfn: *ir.Function, out_void: *bool) u32 {
    @out_void = false;
    val sig_opt: opt[*type.IrType] = type.get(?e.ir.types, irfn.sig);
    if (sel sig_opt.none) { ret 0; }
    val sig: *type.IrType = sig_opt.some;
    if (sig.kind != type.IRT_FN) { ret 0; }
    val rt:     type.IrTypeId     = sig.data.fn.ret_type;
    val rt_opt: opt[*type.IrType] = type.get(?e.ir.types, rt);
    if (sel rt_opt.none) { ret 0; }
    val rtt: *type.IrType = rt_opt.some;
    if (rtt.kind == type.IRT_VOID) {
        @out_void = true;
        ret types.type_void(e.tt);
    }
    # a returned pointer is a physical one: a logical pointer names memory of the caller's
    # or the module's, which no result can carry (#4307)
    if (rtt.kind == type.IRT_PTR && rtt.data.pointee != type.IRT_NIL) { ret phys_pointer_quiet(e, ?e.ir.types, rt); }
    ret ir_value_spv_type(e, rt);
}

val FN_NONE: u32 = unit.UNIT_NONE;

val GL_NONE: u32 = unit.UNIT_NONE;

fun unsupported_value_type(e: *Emit, mi: *mir.MirInstr) str {
    if (!mir.vec_lane_is_vector(mi.vec_lane)) {
        ret "unsupported value type in the SPIR-V target";
    }
    ret "unsupported vector lane type in the SPIR-V target";
}

fun interface_target(e: *Emit, op: *mir.MirOperand) u32 {
    if (op.kind != mir.MIR_OP_SYM || op.sym_off != 0) { ret 0; }
    ret global_var_id(e, op.sym);
}

fun addressed_memory_refusal(e: *Emit, mf: *mir.MirFunction, op: *mir.MirOperand) str {
    var gix:    u32 = 0;
    val origin: u8  = address_origin(e, mf, op, ?gix);
    if (origin == ADDR_ALLOCA) {
        ret "a function-local object is reachable from the SPIR-V target only as a whole value: this access arrived as an address into its storage rather than as a load or a store of the object itself, which logical addressing has no pointer to express. it is a lowering that ran where it should not have, not something the program asked for";
    }
    if (origin != ADDR_GLOBAL) {
        ret "addressed memory is not yet supported by the SPIR-V target: this access reached the back end as a computed address with no object behind it that the emitter can name, and logical addressing has no general pointer to follow";
    }
    val g: *ir.Global = gl_ir(e, gix);
    if (g.iface == ir.IFACE_NONE) {
        ret "a plain module-scope variable is not reachable from the SPIR-V target: a shader has no general global storage, so a module-scope `var` reaches a stage only by carrying an interface role (`#[input]`, `#[output]`, `#[builtin]`, `#[uniform]`, `#[storage]`, `#[sampler]`, `#[push]`, or `#[shared]`), and a module-scope `val` only as a whole value, which the shader reads as the constant it is";
    }
    val r: res[str, format.FormatError] = format.sprint(e.alloc,
        "this shader interface variable carries a role, so it is reachable - but the access reached the back end as COMPUTED ADDRESSING rather than as a direct reference to the variable, which is the one shape the SPIR-V target can name. that is a lowering that ran where it should not have, not a limit of the declaration: the variable is {}",
        ir_type_spelling(gl_types(e, gix), e.alloc, g.ty));
    if (sel r.err) {
        ret "this shader interface variable is reachable only as a whole-variable read or write in the SPIR-V target";
    }
    ret r.ok;
}

fun is_image_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) bool {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret false; }
    ret opt_.some.kind == type.IRT_HANDLE;
}

# an image of 64-bit texels is declared under Int64ImageEXT, which Vulkan enables only with
# the shaderImageInt64Atomics feature
fun require_wide_texels(e: *Emit, gt: *type.IrTypeTable, gx: u32) err[fail.Fail] {
    val opt_: opt[*type.IrType] = type.get(gt, gl_ir(e, gx).ty);
    if (!sel opt_.some) { ret err[fail.Fail].ok{}; }
    val t: *type.IrType = opt_.some;
    if (t.kind != type.IRT_HANDLE || t.data.handle_.ctor != defs.SPV_CTOR_IMAGE || t.data.handle_.count != defs.IMAGE_ARITY) {
        ret err[fail.Fail].ok{};
    }
    val texel: u32 = t.data.handle_.operands[defs.IMAGE_OP_TEXEL]::u32;
    if (texel != defs.TEXEL_I64 && texel != defs.TEXEL_U64) { ret err[fail.Fail].ok{}; }
    val g:    *ir.Global = gl_ir(e, gx);
    var role: str        = "sampler";
    if (g.iface == ir.IFACE_STORAGE) { role = "storage"; }
    var what: str                          = "an image of 64-bit texels";
    val r:    res[str, format.FormatError] = format.sprint(e.alloc, "the `#[{}({}, {})]` image of 64-bit texels{}",
        role, g.iface_a, g.iface_b, gl_mod_prefix(e, gx));
    if (sel r.ok) { what = r.ok; }
    ret require_at(e, source.loc_nil(), 0, spirv.CAP_INT64_IMAGE, spirv.EXT_IMAGE_INT64_ATOMICS, what);
}

# the interface role a handle type binds through: a storage image `#[storage]`, any other handle `#[sampler]`
fun handle_role(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) u8 {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (!sel opt_.some) { ret ir.IFACE_SAMPLER; }
    val t: *type.IrType = opt_.some;
    if (t.kind != type.IRT_HANDLE) { ret ir.IFACE_SAMPLER; }
    if (t.data.handle_.ctor == defs.SPV_CTOR_IMAGE && t.data.handle_.count == defs.IMAGE_ARITY
        && t.data.handle_.operands[defs.IMAGE_OP_SAMPLED]::u32 == spirv.IMAGE_SAMPLED_STORAGE) { ret ir.IFACE_STORAGE; }
    ret ir.IFACE_SAMPLER;
}

fun memory_load(e: *Emit, ty: u32, result: u32, ptr: u32, flags: u8) {
    var ops: [6]u32;
    ops[0] = ty;
    ops[1] = result;
    ops[2] = ptr;
    val count: u32 = 3 + memory_operands(e, ptr, flags, spirv.MEMORY_ACCESS_MAKE_POINTER_VISIBLE, ?ops[3]);
    spirv.inst(e.b, ?e.b.functions, spirv.OP_LOAD, ?ops[0], count);
}

fun memory_store(e: *Emit, ptr: u32, value: u32, flags: u8) {
    var ops: [5]u32;
    ops[0] = ptr;
    ops[1] = value;
    val count: u32 = 2 + memory_operands(e, ptr, flags, spirv.MEMORY_ACCESS_MAKE_POINTER_AVAILABLE, ?ops[2]);
    spirv.inst(e.b, ?e.b.functions, spirv.OP_STORE, ?ops[0], count);
}

# the Memory Operands of an access through `ptr`, written to `out`, and how many words
# they take: Volatile for a volatile access, Aligned with its literal for an access through
# a physical pointer, which every one carries, and under the Vulkan memory model, where
# the pointer's memory is coherent, `avail_vis` (a store's MakePointerAvailable or a
# load's MakePointerVisible) with NonPrivatePointer and the scope id
fun memory_operands(e: *Emit, ptr: u32, flags: u8, avail_vis: u32, out: *u32) u32 {
    var mask: u32 = 0;
    if ((flags & mir.MEMORY_VOLATILE) != 0) { mask = spirv.MEMORY_ACCESS_VOLATILE; }
    val align:    u32  = pointer_align(e, ptr);
    val scope:    u32  = memory_scope_of(e, ptr);
    val coherent: bool = e.vulkan_mm && scope != 0;
    if (align != 0) { mask = mask | spirv.MEMORY_ACCESS_ALIGNED; }
    if (coherent)   { mask = mask | avail_vis | spirv.MEMORY_ACCESS_NON_PRIVATE_POINTER; }
    if (mask == 0)  { ret 0; }
    out[0] = mask;
    var n: u32 = 1;
    if (align != 0) {
        out[n] = align;
        n      = n + 1;
    }
    if (coherent) {
        out[n] = types.const_int(e.tt, 32, scope::i64);
        n      = n + 1;
    }
    ret n;
}

# a scalar access through a pointer to a composite reaches the composite's leading leaf: member 0,
# recursively, which is what offset zero means on a logical target.
fun leading_leaf(e: *Emit, ptr: u32, ty: u32, storage: u32, want: u32, out_ptr: *u32) u32 {
    var cur_ptr: u32 = ptr;
    var cur:     u32 = ty;
    var depth:   u32 = 0;
    for (cur != want && cur != 0 && types.is_composite(e.tt, cur) && depth < 8) {
        val member: u32 = types.composite_member(e.tt, cur, 0);
        if (member == 0) { ret 0; }
        val ptr_ty: u32 = types.type_ptr(e.tt, storage, member);
        val result: u32 = spirv.alloc_id(e.b);
        var ops:    [4]u32;
        ops[0] = ptr_ty;
        ops[1] = result;
        ops[2] = cur_ptr;
        ops[3] = types.const_int(e.tt, 32, 0);
        spirv.inst(e.b, ?e.b.functions, spirv.OP_ACCESS_CHAIN, ?ops[0], 4);
        chain_memory_scope(e, result, cur_ptr);
        if (storage == spirv.STORAGE_PHYSICAL_STORAGE_BUFFER) { mark_physical(e, result, member); }
        cur_ptr = result;
        cur     = member;
        depth   = depth + 1;
    }
    if (cur != want) { ret 0; }
    @out_ptr = cur_ptr;
    ret cur;
}

fun leading_leaf_type(e: *Emit, ty: u32) u32 {
    var cur:   u32 = ty;
    var depth: u32 = 0;
    for (cur != 0 && types.is_composite(e.tt, cur) && depth < 8) {
        cur   = types.composite_member(e.tt, cur, 0);
        depth = depth + 1;
    }
    ret cur;
}

fun leaf_refusal(e: *Emit) str {
    ret "a scalar access through a composite reaches no leading member of its type in the SPIR-V target: a logical object is read and written as a whole or through a member walk, and offset zero of a composite is its first member";
}

fun access_storage_at(e: *Emit, vm: *VMaps, op: *mir.MirOperand, known: u32) u32 {
    if (known != 0) { ret known; }
    ret access_storage(e, vm, op);
}

fun access_storage(e: *Emit, vm: *VMaps, op: *mir.MirOperand) u32 {
    val sc: u32 = chain_storage(vm, op);
    if (sc != 0)                   { ret sc; }
    if (op.kind != mir.MIR_OP_SYM) { ret spirv.STORAGE_FUNCTION; }
    val gx: u32 = gl_lookup(e, op.sym);
    if (gx == GL_NONE) { ret spirv.STORAGE_FUNCTION; }
    ret e.gstorage[gx];
}

fun emit_global_load(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count != 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0]));
    }
    # a specialization constant is read as the constant it is, with no load
    val spec_id: u32 = spec_target(e, ?mi.operands[1]);
    if (spec_id != 0) { ret store_vreg(e, vm, mi.operands[0].vreg.n, spec_id); }
    var chain_ty:       u32  = 0;
    var chain_sc:       u32  = 0;
    var var_id:         u32  = address(e, vm, ?mi.operands[1], ?chain_ty, ?chain_sc);
    var from_interface: bool = false;
    if (var_id == 0) {
        var_id         = interface_target(e, ?mi.operands[1]);
        from_interface = true;
    }
    # so is a module-scope `val`, which a shader has no storage for
    if (var_id == 0 && mi.operands[0].vreg.n < vm.n) {
        val cid: u32 = constant_load(e, ?mi.operands[1], vm.type_id[mi.operands[0].vreg.n]);
        if (cid != 0) { ret store_vreg(e, vm, mi.operands[0].vreg.n, cid); }
    }
    if (var_id == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1])); }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n || vm.type_id[dst] == 0) {
        ret emit_fail(e, "spirv.emit: interface load result vreg has no type");
    }
    if (types.type_is_opaque(e.tt, vm.type_id[dst])) {
        # a pointer to the handle itself, a `*Handle` parameter, is no member walk
        if (chain_ty != 0 && chain_ty != vm.type_id[dst]) {
            ret unsupported(e, "an image handle reached through a member walk is not supported by the SPIR-V target: a handle has no members, so this is an access chain into something that is not an aggregate");
        }
        if ((mi.memory_flags & mir.MEMORY_VOLATILE) == 0) {
            vm.opq_var[dst] = var_id;
            ret err[fail.Fail].ok{};
        }
        vm.opq_var[dst] = 0;
    }
    or {
        if (from_interface) { chain_ty = interface_value_type(e, ?mi.operands[1]); }
        if (chain_ty != 0 && chain_ty != vm.type_id[dst] && types.is_composite(e.tt, chain_ty)
            && !types.is_composite(e.tt, vm.type_id[dst])) {
            var leaf_ptr: u32 = 0;
            if (leading_leaf(e, var_id, chain_ty, access_storage_at(e, vm, ?mi.operands[1], chain_sc), vm.type_id[dst], ?leaf_ptr) == 0) {
                ret unsupported(e, leaf_refusal(e));
            }
            var_id = leaf_ptr;
        }
    }
    if (memory_bridged(e, chain_ty, vm.type_id[dst])) {
        val loaded: u32 = spirv.alloc_id(e.b);
        memory_load(e, chain_ty, loaded, var_id, mi.memory_flags);
        ret store_vreg(e, vm, dst, lane_width_as(e, loaded, chain_ty, vm.type_id[dst]));
    }
    val result: u32 = spirv.alloc_id(e.b);
    memory_load(e, vm.type_id[dst], result, var_id, mi.memory_flags);
    ret store_vreg(e, vm, dst, result);
}

fun emit_global_store(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count != 2) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0])); }
    var chain_ty: u32 = 0;
    var chain_sc: u32 = 0;
    var var_id:   u32 = address(e, vm, ?mi.operands[0], ?chain_ty, ?chain_sc);
    var value_ty: u32 = chain_ty;
    # memory holds no logical pointer: a logical pointer names memory the module declares
    if (mi.operands[1].kind == mir.MIR_OP_VREG && (prov_of(vm.prov, vm.n, ?mi.operands[1]) & (PROV_LOGICAL | PROV_PHYSICAL)) == PROV_LOGICAL) {
        ret unsupported(e, "a logical pointer cannot be stored in memory in the SPIR-V target: a pointer held in memory is a physical pointer, an address in a buffer the host passes, and this one names a local, an interface variable or an element or member of one, which have no address. store the index of what it points at, or pass the pointer to the function that uses it");
    }
    if (var_id == 0) {
        var_id   = interface_target(e, ?mi.operands[0]);
        value_ty = interface_value_type(e, ?mi.operands[0]);
    }
    if (var_id == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0])); }
    if (value_ty != 0 && types.is_composite(e.tt, value_ty) && stored_scalar(e, vm, mi, ?mi.operands[1])) {
        var want: u32 = 0;
        if (mi.operands[1].kind == mir.MIR_OP_VREG) { want = vm.type_id[mi.operands[1].vreg.n]; }
        or {
            val leaf: u32 = leading_leaf_type(e, value_ty);
            if (mi.width != 0 && types.type_bits(e.tt, leaf) == mi.width::u32 * 8) { want = leaf; }
        }
        var leaf_ptr: u32 = 0;
        if (want == 0 || leading_leaf(e, var_id, value_ty, access_storage_at(e, vm, ?mi.operands[0], chain_sc), want, ?leaf_ptr) == 0) {
            ret unsupported(e, leaf_refusal(e));
        }
        var_id   = leaf_ptr;
        value_ty = want;
    }
    var value: u32             = 0;
    val op:    *mir.MirOperand = ?mi.operands[1];
    # the value as the function carries it: its register's type, or for a constant the
    # carrier of the memory's width
    var held_ty: u32 = value_ty;
    if (op.kind == mir.MIR_OP_VREG && op.vreg.n < vm.n) { held_ty = vm.type_id[op.vreg.n]; }
    or (op.kind == mir.MIR_OP_IMM && value_ty != 0 && !types.type_is_float(e.tt, value_ty) && types.type_bits(e.tt, value_ty) != 0) {
        held_ty = types.type_int(e.tt, carrier_bits(e, types.type_bits(e.tt, value_ty)));
    }
    if (memory_bridged(e, held_ty, value_ty)) { value = lane_width_as(e, read_operand(e, vm, op, held_ty), held_ty, value_ty); }
    or                                        { value = read_operand(e, vm, op, value_ty); }
    if (e.b.err || value == 0)                { ret emit_fail(e, "spirv.emit: unreadable value in an interface store"); }
    memory_store(e, var_id, value, mi.memory_flags);
    ret err[fail.Fail].ok{};
}

# an immediate, or a vreg holding a scalar or vector rather than a composite's address
fun stored_scalar(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, op: *mir.MirOperand) bool {
    if (op.kind == mir.MIR_OP_IMM)                       { ret true; }
    if (op.kind != mir.MIR_OP_VREG || op.vreg.n >= vm.n) { ret false; }
    val ty: u32 = vm.type_id[op.vreg.n];
    ret ty != 0 && !types.is_composite(e.tt, ty);
}

fun interface_value_type(e: *Emit, op: *mir.MirOperand) u32 {
    if (op.kind != mir.MIR_OP_SYM) { ret 0; }
    val gx: u32 = gl_lookup(e, op.sym);
    if (gx == GL_NONE) { ret 0; }
    val g: *ir.Global = gl_ir(e, gx);
    if (g.iface == ir.IFACE_NONE) { ret 0; }
    ret e.gtype_ids[gx];
}

# the type a function carries a value of the memory type `ty` in: a scalar integer at
# its carrier (#4302), and any other type as it is
fun carried_value_type(e: *Emit, ty: u32) u32 {
    if (ty == 0) { ret 0; }
    var lanes: u32 = 0;
    if (types.vector_shape(e.tt, ty, ?lanes) != 0)                     { ret ty; }
    if (types.type_is_bool(e.tt, ty) || types.type_is_float(e.tt, ty)) { ret ty; }
    val bits: u32 = types.type_bits(e.tt, ty);
    if (bits == 0) { ret ty; }
    ret types.type_int(e.tt, carrier_bits(e, bits));
}

# a whole object moved between two declarations of its type: OpCopyLogical where they
# match member for member, and otherwise rebuilt member by member where they differ only
# in how memory and a function hold their leaves (memory_bridged), as a narrow integer
# member of a buffer and of a local do (#4302). 0 when they are other types
fun whole_value_as(e: *Emit, value: u32, from_ty: u32, to_ty: u32) u32 {
    if (value == 0 || from_ty == 0 || to_ty == 0) { ret 0; }
    if (from_ty == to_ty)                         { ret value; }
    if (types.logically_match(e.tt, from_ty, to_ty)) {
        val res_: u32 = spirv.alloc_id(e.b);
        var ops:  [3]u32;
        ops[0] = to_ty;
        ops[1] = res_;
        ops[2] = value;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_COPY_LOGICAL, ?ops[0], 3);
        ret res_;
    }
    if (memory_bridged(e, from_ty, to_ty))                                      { ret lane_width_as(e, value, from_ty, to_ty); }
    if (!types.is_composite(e.tt, from_ty) || !types.is_composite(e.tt, to_ty)) { ret 0; }
    val n: u32 = types.composite_count(e.tt, from_ty);
    if (n == 0 || n != types.composite_count(e.tt, to_ty)) { ret 0; }
    val ar: res[*u32, A.Error] = A.allocate[u32](e.alloc, (n + 2)::usize);
    if (sel ar.err) {
        e.b.err = true;
        ret 0;
    }
    val parts: *u32 = ar.ok;
    fin { A.deallocate[u32](e.alloc, parts, (n + 2)::usize); }
    var i: u32 = 0;
    for (i < n) {
        val from_m: u32 = types.composite_member(e.tt, from_ty, i);
        val part:   u32 = spirv.alloc_id(e.b);
        var ops:    [4]u32;
        ops[0] = from_m;
        ops[1] = part;
        ops[2] = value;
        ops[3] = i;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_EXTRACT, ?ops[0], 4);
        parts[2 + i] = whole_value_as(e, part, from_m, types.composite_member(e.tt, to_ty, i));
        if (parts[2 + i] == 0) { ret 0; }
        i = i + 1;
    }
    val built: u32 = spirv.alloc_id(e.b);
    parts[0] = to_ty;
    parts[1] = built;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_CONSTRUCT, parts, n + 2);
    ret built;
}

fun emit_access_chain(e: *Emit, mf: *mir.MirFunction, vm: *VMaps,
    mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1]));
    }
    var base_id:  u32 = 0;
    var base_ty:  u32 = 0;
    var base_sc:  u32 = 0;
    var prior_ty: u32 = 0;
    var prior_sc: u32 = 0;
    val prior:    u32 = address(e, vm, ?mi.operands[1], ?prior_ty, ?prior_sc);
    if (prior != 0) {
        base_id = prior;
        base_ty = prior_ty;
        base_sc = prior_sc;
    }
    or {
        var gix: u32 = 0;
        if (address_origin(e, mf, ?mi.operands[1], ?gix) != ADDR_GLOBAL) {
            ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1]));
        }
        val g: *ir.Global = gl_ir(e, gix);
        if (g.iface == ir.IFACE_NONE || e.gvar_ids[gix] == 0) {
            ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1]));
        }
        base_id = e.gvar_ids[gix];
        base_ty = e.gtype_ids[gix];
        base_sc = e.gstorage[gix];
    }

    val physical: bool = base_sc == spirv.STORAGE_PHYSICAL_STORAGE_BUFFER;
    val stepped:  bool = mi.operands[2].kind != mir.MIR_OP_IMM || mi.operands[2].imm != 0;
    if (stepped && !physical) {
        ret unsupported(e, "pointer arithmetic across whole objects is not supported by the SPIR-V target: a logical pointer names one object, so a getelementptr's leading index may only be 0");
    }

    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: access chain result vreg out of range"); }

    val count: u32 = mi.operand_count - 3;
    if (count == 0 && !physical) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1])); }
    if (count > 8) {
        ret unsupported(e, "an access chain of more than 8 levels is not supported by the SPIR-V target");
    }

    var idx: [8]u32;
    var cur: u32 = base_ty;
    var k:   u32 = 0;
    for (k < count) {
        val opnd: *mir.MirOperand = ?mi.operands[3 + k];
        if (opnd.kind == mir.MIR_OP_IMM) {
            if (opnd.imm < 0) { ret unsupported(e, "a negative index is not supported by the SPIR-V target"); }
            # a tag's IR field numbering is the composite's: discriminator first, then one member per case
            val ordinal: u32 = opnd.imm::u32;
            cur    = types.composite_member(e.tt, cur, ordinal);
            idx[k] = types.const_int(e.tt, 32, ordinal::i64);
        }
        or {
            val elem:  u32 = types.composite_member(e.tt, cur, 0);
            var lanes: u32 = 0;
            if (elem == 0 || types.vector_shape(e.tt, cur, ?lanes) != 0) {
                ret unsupported(e, "a runtime index into a record or vector is not supported by the SPIR-V target: SPIR-V takes a struct member and a vector lane by a constant ordinal, since the type reached depends on which one it is");
            }
            idx[k] = read_operand(e, vm, opnd, types.type_int(e.tt, 32));
            cur    = elem;
        }
        if (cur == 0 || idx[k] == 0) {
            ret unsupported(e, "an index reaches past the end of its aggregate in the SPIR-V target");
        }
        k = k + 1;
    }
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable index in an access chain"); }

    val ptr_ty: u32 = types.type_ptr(e.tt, base_sc, cur);
    var result: u32 = base_id;
    var ops:    [12]u32;
    ops[0] = ptr_ty;
    ops[2] = base_id;
    var at:     u32 = 3;
    var opcode: u32 = spirv.OP_ACCESS_CHAIN;
    # a physical pointer steps across whole objects by its pointee's stride (#4307)
    if (stepped) {
        val sr: err[fail.Fail] = stride_pointer(e, base_ty);
        if (sel sr.err) { ret sr; }
        ops[3] = read_operand(e, vm, ?mi.operands[2], types.type_int(e.tt, 32));
        if (e.b.err || ops[3] == 0) { ret emit_fail(e, "spirv.emit: unreadable element step of a physical pointer"); }
        at     = 4;
        opcode = spirv.OP_PTR_ACCESS_CHAIN;
    }
    k = 0;
    for (k < count) {
        ops[at + k] = idx[k];
        k           = k + 1;
    }
    if (stepped || count > 0) {
        result = spirv.alloc_id(e.b);
        ops[1] = result;
        spirv.inst(e.b, ?e.b.functions, opcode, ?ops[0], count + at);
        chain_memory_scope(e, result, base_id);
    }
    if (physical) { mark_physical(e, result, cur); }
    # a register another instruction defines too holds the pointer as its value
    if (physical && vm.var_id[dst] != 0) { ret store_vreg(e, vm, dst, result); }

    vm.chain_id[dst] = result;
    vm.chain_ty[dst] = cur;
    vm.chain_sc[dst] = base_sc;
    # the indices as read here, which a call passing this address hands on
    vm.gep_at[dst] = vm.gep_ids.len::u32 + 1;
    k              = 0;
    for (k < count) {
        val pr: res[usize, A.Error] = vector.push[u32](?vm.gep_ids, idx[k]);
        if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

# a physical pointer stepped across whole objects has its pointee's stride declared on its type
fun stride_pointer(e: *Emit, pointee: u32) err[fail.Fail] {
    val ptr_ty: u32   = types.type_ptr(e.tt, spirv.STORAGE_PHYSICAL_STORAGE_BUFFER, pointee);
    var i:      usize = 0;
    for (i < e.strided.len) {
        if (e.strided.data[i] == ptr_ty) { ret err[fail.Fail].ok{}; }
        i = i + 1;
    }
    val stride: u32 = vec_at(?e.tsize, pointee);
    if (stride == 0) { ret emit_fail(e, "spirv.emit: a physical pointer's pointee has no recorded extent"); }
    decorate(e, ptr_ty, spirv.DECOR_ARRAY_STRIDE, stride);
    val pr: res[usize, A.Error] = vector.push[u32](?e.strided, ptr_ty);
    if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
    ret err[fail.Fail].ok{};
}

fun chain_target(vm: *VMaps, op: *mir.MirOperand, out_ty: *u32) u32 {
    @out_ty = 0;
    var v: u32 = mir.MIR_VREG_NIL.n;
    if (op.kind == mir.MIR_OP_VREG)               { v = op.vreg.n; }
    or (op.kind == mir.MIR_OP_MEM && op.imm == 0) { v = op.vreg.n; }
    if (v == mir.MIR_VREG_NIL.n || v >= vm.n)     { ret 0; }
    @out_ty = vm.chain_ty[v];
    ret vm.chain_id[v];
}

# the physical pointer register an address operand holds, the register itself or the
# memory at it, MIR_VREG_NIL when it holds none
fun physical_value(vm: *VMaps, op: *mir.MirOperand) u32 {
    var v: u32 = mir.MIR_VREG_NIL.n;
    if (op.kind == mir.MIR_OP_VREG)                             { v = op.vreg.n; }
    or (op.kind == mir.MIR_OP_MEM && op.imm == 0)               { v = op.vreg.n; }
    if (v >= vm.n || vm.prov == nil)                            { ret mir.MIR_VREG_NIL.n; }
    if ((vm.prov[v] & PROV_PHYSICAL) == 0 || vm.var_id[v] == 0) { ret mir.MIR_VREG_NIL.n; }
    ret v;
}

# the pointer an address operand names, with its pointee and storage class: an access
# chain's, or the physical pointer a register holds, read here
fun address(e: *Emit, vm: *VMaps, op: *mir.MirOperand, out_ty: *u32, out_sc: *u32) u32 {
    @out_sc = 0;
    val c: u32 = chain_target(vm, op, out_ty);
    if (c != 0) {
        @out_sc = chain_storage(vm, op);
        ret c;
    }
    val v: u32 = physical_value(vm, op);
    if (v == mir.MIR_VREG_NIL.n) { ret 0; }
    var sc:      u32 = 0;
    val pointee: u32 = types.pointer_shape(e.tt, vm.type_id[v], ?sc);
    if (pointee == 0 || sc != spirv.STORAGE_PHYSICAL_STORAGE_BUFFER) { ret 0; }
    var r: mir.MirOperand = @op;
    r.kind = mir.MIR_OP_VREG;
    val p: u32 = read_operand(e, vm, ?r, 0);
    if (p == 0) { ret 0; }
    @out_ty = pointee;
    @out_sc = sc;
    ret p;
}

fun chain_storage(vm: *VMaps, op: *mir.MirOperand) u32 {
    var v: u32 = mir.MIR_VREG_NIL.n;
    if (op.kind == mir.MIR_OP_VREG)               { v = op.vreg.n; }
    or (op.kind == mir.MIR_OP_MEM && op.imm == 0) { v = op.vreg.n; }
    if (v == mir.MIR_VREG_NIL.n || v >= vm.n)     { ret 0; }
    ret vm.chain_sc[v];
}

fun emit_memzero(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 1) { ret emit_fail(e, "spirv.emit: memzero with no destination"); }
    var target_ty: u32 = 0;
    var target_sc: u32 = 0;
    var target:    u32 = address(e, vm, ?mi.operands[0], ?target_ty, ?target_sc);
    if (target == 0) {
        target    = interface_target(e, ?mi.operands[0]);
        target_ty = interface_value_type(e, ?mi.operands[0]);
    }
    if (target == 0 || target_ty == 0) {
        ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0]));
    }
    memory_store(e, target, zero_value(e, target_ty), mi.memory_flags);
    ret err[fail.Fail].ok{};
}

fun emit_memcpy(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret emit_fail(e, "spirv.emit: memcpy with no source or destination"); }

    var dst_ty: u32 = 0;
    var dst_sc: u32 = 0;
    var dst:    u32 = address(e, vm, ?mi.operands[0], ?dst_ty, ?dst_sc);
    if (dst == 0) {
        dst    = interface_target(e, ?mi.operands[0]);
        dst_ty = interface_value_type(e, ?mi.operands[0]);
    }
    if (dst == 0 || dst_ty == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0])); }

    var src_ty: u32 = 0;
    var src_sc: u32 = 0;
    var src:    u32 = address(e, vm, ?mi.operands[1], ?src_ty, ?src_sc);
    if (src == 0) {
        src    = interface_target(e, ?mi.operands[1]);
        src_ty = interface_value_type(e, ?mi.operands[1]);
    }
    # so is the whole of a module-scope `val`, which a shader has no storage for
    if (src == 0) {
        val cid: u32 = constant_copy(e, mi, dst_ty);
        if (cid != 0) {
            memory_store(e, dst, cid, mi.memory_flags);
            ret err[fail.Fail].ok{};
        }
    }
    if (src == 0 || src_ty == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1])); }

    val value: u32 = spirv.alloc_id(e.b);
    memory_load(e, src_ty, value, src, mi.memory_flags);

    val stored: u32 = whole_value_as(e, value, src_ty, dst_ty);
    if (stored == 0) {
        ret unsupported(e, "copying between two objects of different types is not supported by the SPIR-V target: logical addressing carries an object as a value of its own type, so a copy that reinterprets one type as another has no pointer to perform it through");
    }

    memory_store(e, dst, stored, mi.memory_flags);
    ret err[fail.Fail].ok{};
}

fun read_value(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, op: *mir.MirOperand,
    want_ty: u32, flags: u8) res[u32, fail.Fail] {
    if (op.kind == mir.MIR_OP_MEM || op.kind == mir.MIR_OP_SYM) {
        var ty:  u32 = 0;
        var sc:  u32 = 0;
        var src: u32 = address(e, vm, op, ?ty, ?sc);
        if (src == 0) {
            src = interface_target(e, op);
            ty  = interface_value_type(e, op);
        }
        if (src == 0 || ty == 0) { ret res[u32, fail.Fail].err{reject_at(e, dkind.SPIRV_UNSUPPORTED, mir.refusal_loc(mf, e.cur_instr), addressed_memory_refusal(e, mf, op))}; }
        val loaded: u32 = spirv.alloc_id(e.b);
        memory_load(e, ty, loaded, src, flags);
        val converted: u32 = whole_value_as(e, loaded, ty, want_ty);
        if (converted == 0) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: logical argument object does not match its declared type")}; }
        ret res[u32, fail.Fail].ok{converted};
    }
    if (!operand_matches_type(vm, op, want_ty)) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: logical argument type mismatch")}; }
    val result: u32 = read_operand(e, vm, op, want_ty);
    if (result == 0 || e.b.err) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: unreadable logical value")}; }
    ret res[u32, fail.Fail].ok{result};
}

fun write_value(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, op: *mir.MirOperand,
    held: u32, held_ty: u32, flags: u8) err[fail.Fail] {
    var storage: u32 = 0;
    val pointee: u32 = types.pointer_shape(e.tt, held_ty, ?storage);
    # a physical pointer register holds the pointer as its value
    if (pointee != 0 && storage == spirv.STORAGE_PHYSICAL_STORAGE_BUFFER && op.kind == mir.MIR_OP_VREG
        && op.vreg.n < vm.n && vm.var_id[op.vreg.n] != 0) {
        ret store_vreg(e, vm, op.vreg.n, held);
    }
    if (pointee != 0) {
        if (op.kind != mir.MIR_OP_VREG || op.vreg.n >= vm.n || vm.type_id[op.vreg.n] != held_ty) {
            ret emit_fail(e, "spirv.emit: logical reference binding type mismatch");
        }
        vm.chain_id[op.vreg.n] = held;
        vm.chain_ty[op.vreg.n] = pointee;
        vm.chain_sc[op.vreg.n] = storage;
        ret err[fail.Fail].ok{};
    }
    if (op.kind == mir.MIR_OP_MEM) {
        var ty:  u32 = 0;
        var sc:  u32 = 0;
        val dst: u32 = address(e, vm, op, ?ty, ?sc);
        if (dst == 0 || ty == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, op)); }
        val converted: u32 = whole_value_as(e, held, held_ty, ty);
        if (converted == 0) { ret emit_fail(e, "spirv.emit: logical result object does not match its owned home"); }
        memory_store(e, dst, converted, flags);
        ret err[fail.Fail].ok{};
    }
    if (op.kind != mir.MIR_OP_VREG || op.vreg.n >= vm.n || vm.type_id[op.vreg.n] != held_ty) {
        ret emit_fail(e, "spirv.emit: logical result type mismatch");
    }
    ret store_vreg(e, vm, op.vreg.n, held);
}

fun emit_param(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count != 2 || mi.operands[1].kind != mir.MIR_OP_IMM || mi.operands[1].imm < 0) {
        ret emit_fail(e, "spirv.emit: malformed logical parameter binding");
    }
    val index: u32          = mi.operands[1].imm::u32;
    val fn:    *ir.Function = ir_function_record(e.ir, mf.name);
    if (fn == nil || index >= fn.param_count) { ret emit_fail(e, "spirv.emit: logical parameter has no signature"); }
    val at:   u32 = key_param(e, e.copies.data[e.cur_copy].key_at, index);
    val slot: u32 = e.cur_pslot[index];
    val bind: u32 = e.keys.data[at];
    if (bind == BIND_GLOBAL || bind == BIND_LOCAL) { ret bind_path_param(e, vm, mi, at, slot); }
    if (bind == BIND_PHYSICAL) {
        val pp: res[u32, fail.Fail] = phys_pointer(e, ?e.ir.types, fn.params[index].ty);
        if (sel pp.err) { ret err[fail.Fail].err{pp.err}; }
        mark_physical_ptr(e, e.cur_params[slot], pp.ok);
        ret write_value(e, mf, vm, ?mi.operands[0], e.cur_params[slot], pp.ok, mi.memory_flags);
    }
    ret write_value(e, mf, vm, ?mi.operands[0], e.cur_params[slot],
        ir_value_spv_type(e, fn.params[index].ty), mi.memory_flags);
}

# the program asks for what this backend cannot express: an error located at
# the instruction under emission (else its function) on the module's store,
# naming the function
fun refuse(e: *Emit, k: dkind.Kind, msg: str) err[fail.Fail] {
    if (e.has_held) {
        e.has_held = false;
        ret err[fail.Fail].err{e.held};
    }
    if (e.cur_fn == nil) { ret err[fail.Fail].err{reject_at(e, k, source.loc_nil(), msg)}; }
    val named: res[str, format.FormatError] = format.sprint(e.alloc, "{} (in `{}`)", msg, refusal_fn_name(e));
    if (sel named.err) { ret err[fail.Fail].err{fail.format_refused(named.err)}; }
    ret err[fail.Fail].err{reject_at(e, k, mir.refusal_loc(e.cur_fn, e.cur_instr), named.ok)};
}

fun unsupported(e: *Emit, msg: str) err[fail.Fail] {
    ret refuse(e, dkind.SPIRV_UNSUPPORTED, msg);
}

fun reject_at(e: *Emit, k: dkind.Kind, loc: source.SrcLoc, msg: str) fail.Fail {
    ret mir.reject(e.diags, k, loc, msg);
}

# a refusal of the module or its interface, which no one instruction locates
fun reject_module(e: *Emit, k: dkind.Kind, msg: str) fail.Fail {
    ret reject_at(e, k, source.loc_nil(), msg);
}

# an operand read's failure at the instruction that read it: a rejection is
# already on the store and passes through, a defect is named with its place
fun emit_inner(e: *Emit, f: fail.Fail) err[fail.Fail] {
    if (sel f.reported) { ret err[fail.Fail].err{f}; }
    ret emit_fail(e, fail.describe(f));
}

# a compiler defect met while emitting, named with its instruction and place
fun emit_fail(e: *Emit, msg: str) err[fail.Fail] {
    ret err[fail.Fail].err{fail.message(mir.instr_refusal(e.alloc, e.srcmap, refusal_fn_name(e),
        e.cur_instr, msg))};
}

fun refusal_fn_name(e: *Emit) str {
    if (e.cur_fn == nil) { ret "<unknown function>"; }
    val fx: u32 = fn_lookup(e, e.cur_fn.name);
    if (fx != FN_NONE) { ret ir_fn_spelling(e, fx); }
    val m: opt[str] = intern.lookup(e.interner, e.cur_fn.name);
    if (sel m.some) { ret m.some; }
    ret "<unresolved function name>";
}

fun emit_instr(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    e.cur_instr = mi;
    val op: mir.MirOpcode = mi.opcode;

    val lf: bool = mir.vec_lane_is_vector(mi.vec_lane)
        && mir.vec_lane_kind(mi.vec_lane) == mir.VEC_LANE_FLOAT;

    # a pointer compared or cast is a physical one, as the address it is (#4307)
    if (mir.is_cmp_opcode(op) && !mir.vec_lane_is_vector(mi.vec_lane) && mi.operand_count == 3
        && (pointer_operand(vm, ?mi.operands[1]) || pointer_operand(vm, ?mi.operands[2]))) {
        ret emit_pointer_compare(e, vm, mi);
    }
    if (op == mir.MIR_BITCAST && mi.operand_count == 2 && mi.operands[0].kind == mir.MIR_OP_VREG
        && (pointer_operand(vm, ?mi.operands[1]) || pointer_operand(vm, ?mi.operands[0]))) {
        ret emit_pointer_cast(e, mf, vm, mi);
    }

    # the value instructions: the mapping row names the emitter shape and
    # the opcode for the lane class; the opcode's core row sizes the word
    val m: *ops.MirMap = ops.map_of(op);
    if (m != nil) {
        val code: u32 = ops.select(m, lf);
        if (m.shape == ops.SH_BINARY)                                       { ret emit_binary(e, vm, mi, code, false); }
        if (m.shape == ops.SH_SHIFT && mir.vec_lane_is_vector(mi.vec_lane)) { ret emit_vector_shift(e, vm, mi, code); }
        if (m.shape == ops.SH_SHIFT)                                        { ret emit_binary(e, vm, mi, code, true); }
        if (m.shape == ops.SH_UNARY)                                        { ret emit_unary(e, vm, mi, code); }
        if (m.shape == ops.SH_COMPARE)                                      { ret emit_compare(e, vm, mi, code); }
        ret emit_convert(e, vm, mi, code, m.src_float);
    }

    if (op == mir.MIR_FCMP)                               { ret emit_float_compare(e, vm, mi); }
    if (op == mir.MIR_MASK_LT_U)                          { ret emit_compare_mask(e, vm, mi); }
    if (op == mir.MIR_SELECT || op == mir.MIR_SELECT_CMP) { ret emit_select(e, vm, mi); }

    if (op == mir.MIR_VEC_EXTRACT) { ret emit_vec_extract(e, vm, mi); }
    if (op == mir.MIR_VEC_INSERT)  { ret emit_vec_insert(e, vm, mi); }
    if (op == mir.MIR_VEC_BUILD)   { ret emit_vec_build(e, vm, mi); }

    if (op == mir.MIR_MOV)        { ret emit_mov(e, vm, mi); }
    if (op == mir.MIR_DECLASSIFY) { ret emit_mov(e, vm, mi); }

    if (op == mir.MIR_VALUE_CALL)  { ret emit_call(e, mf, vm, mi); }
    if (op == mir.MIR_VALUE_PARAM) { ret emit_param(e, mf, vm, mi); }

    if (op == mir.MIR_LOAD)    { ret emit_global_load(e, mf, vm, mi); }
    if (op == mir.MIR_STORE)   { ret emit_global_store(e, mf, vm, mi); }
    if (op == mir.MIR_GEP)     { ret emit_access_chain(e, mf, vm, mi); }
    if (op == mir.MIR_ALLOCA)  { ret err[fail.Fail].ok{}; }
    if (op == mir.MIR_MEMZERO) { ret emit_memzero(e, mf, vm, mi); }
    if (op == mir.MIR_MEMCPY)  { ret emit_memcpy(e, mf, vm, mi); }

    ret unsupported(e, "instruction is not yet supported by the SPIR-V target");
}

# a register that holds a pointer, logical or physical
fun pointer_operand(vm: *VMaps, op: *mir.MirOperand) bool {
    if (op.kind != mir.MIR_OP_VREG || op.vreg.n >= vm.n || vm.prov == nil) { ret false; }
    ret vm.prov[op.vreg.n] != 0;
}

val LOGICAL_ADDRESS_REFUSAL: str = "a logical pointer has no address in the SPIR-V target: it names a local, an interface variable or an element or member of one, which the module declares rather than places, so it cannot be compared, ordered or turned into an integer. only a physical pointer, one read from memory or made from an address, is an address";

# the address a pointer operand holds as a 64-bit integer, or an integer operand as one
fun address_bits(e: *Emit, vm: *VMaps, op: *mir.MirOperand) res[u32, fail.Fail] {
    val u64t: u32 = types.type_int(e.tt, 64);
    if (op.kind == mir.MIR_OP_IMM) { ret res[u32, fail.Fail].ok{immediate(e, u64t, op.imm)}; }
    if (!pointer_operand(vm, op)) {
        ret res[u32, fail.Fail].ok{widen_address(e, read_operand(e, vm, op, u64t), vm.type_id[op.vreg.n])};
    }
    if ((vm.prov[op.vreg.n] & PROV_LOGICAL) != 0) { ret res[u32, fail.Fail].err{reject_at(e, dkind.SPIRV_UNSUPPORTED, phys_loc(e), LOGICAL_ADDRESS_REFUSAL)}; }
    val p: u32 = read_operand(e, vm, op, 0);
    if (e.b.err || p == 0) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: unreadable physical pointer")}; }
    val result: u32 = spirv.alloc_id(e.b);
    var words:  [3]u32;
    words[0] = u64t;
    words[1] = result;
    words[2] = p;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_CONVERT_PTR_TO_U, ?words[0], 3);
    ret res[u32, fail.Fail].ok{result};
}

# an integer narrower than an address widened to one
fun widen_address(e: *Emit, value: u32, ty: u32) u32 {
    val u64t: u32 = types.type_int(e.tt, 64);
    if (value == 0 || ty == 0 || ty == u64t || types.type_bits(e.tt, ty) == 64) { ret value; }
    val result: u32 = spirv.alloc_id(e.b);
    var words:  [3]u32;
    words[0] = u64t;
    words[1] = result;
    words[2] = value;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_U_CONVERT, ?words[0], 3);
    ret result;
}

# a comparison of two addresses, ordered as unsigned 64-bit integers
fun emit_pointer_compare(e: *Emit, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operands[0].kind != mir.MIR_OP_VREG || mi.operands[0].vreg.n >= vm.n) { ret emit_fail(e, "spirv.emit: malformed pointer comparison"); }
    val m: *ops.MirMap = ops.map_of(mi.opcode);
    if (m == nil || m.shape != ops.SH_COMPARE) { ret emit_fail(e, "spirv.emit: a pointer comparison maps to no integer compare"); }
    val a: res[u32, fail.Fail] = address_bits(e, vm, ?mi.operands[1]);
    if (sel a.err) { ret err[fail.Fail].err{a.err}; }
    val b: res[u32, fail.Fail] = address_bits(e, vm, ?mi.operands[2]);
    if (sel b.err) { ret err[fail.Fail].err{b.err}; }
    val result: u32 = spirv.alloc_id(e.b);
    var words:  [4]u32;
    words[0] = types.type_bool(e.tt);
    words[1] = result;
    words[2] = a.ok;
    words[3] = b.ok;
    spirv.inst(e.b, ?e.b.functions, ops.select(m, false), ?words[0], 4);
    ret store_vreg(e, vm, mi.operands[0].vreg.n, result);
}

# a cast between a pointer and an integer, or between two pointer types: an address read as
# the integer it is, or an integer read as the address of the destination's pointee
fun emit_pointer_cast(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n || vm.type_id[dst] == 0) { ret emit_fail(e, "spirv.emit: a pointer cast has no result type"); }
    val bits: res[u32, fail.Fail] = address_bits(e, vm, ?mi.operands[1]);
    if (sel bits.err) { ret err[fail.Fail].err{bits.err}; }
    var sc:      u32 = 0;
    val pointee: u32 = types.pointer_shape(e.tt, vm.type_id[dst], ?sc);
    if (pointee == 0) {
        if (types.type_bits(e.tt, vm.type_id[dst]) == 64) { ret store_vreg(e, vm, dst, bits.ok); }
        val narrowed: u32 = spirv.alloc_id(e.b);
        var nw:       [3]u32;
        nw[0] = vm.type_id[dst];
        nw[1] = narrowed;
        nw[2] = bits.ok;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_U_CONVERT, ?nw[0], 3);
        ret store_vreg(e, vm, dst, narrowed);
    }
    if (sc != spirv.STORAGE_PHYSICAL_STORAGE_BUFFER) { ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_UNSUPPORTED, phys_loc(e), LOGICAL_ADDRESS_REFUSAL)}; }
    val result: u32 = spirv.alloc_id(e.b);
    var words:  [3]u32;
    words[0] = vm.type_id[dst];
    words[1] = result;
    words[2] = bits.ok;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_CONVERT_U_TO_PTR, ?words[0], 3);
    ret store_vreg(e, vm, dst, result);
}

fun emit_call(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret emit_fail(e, "spirv.emit: logical call requires callee and result operands"); }
    val callee: *mir.MirOperand = ?mi.operands[0];
    if (callee.kind != mir.MIR_OP_SYM) {
        ret unsupported(e, "SPIR-V logical shader calls require a statically named function");
    }
    val xfn: *ir.Function = ir_function_record(e.ir, callee.sym);
    if (xfn != nil && xfn.op_set != defs.SPV_SET_NONE) { ret emit_spirv_op(e, mf, vm, mi, xfn); }
    if (xfn != nil && xfn.is_import)                   { ret unsupported(e, foreign_call_refusal(e, xfn)); }
    val fx: u32 = fn_lookup(e, callee.sym);
    if (fx == FN_NONE || e.fns[fx].id == 0) { ret unsupported(e, unresolved_call_refusal(e, callee.sym, fx)); }
    val irfn:  *ir.Function = fn_ir(e, fx);
    val count: u32          = irfn.param_count;
    if (count != mi.operand_count - 2) { ret emit_fail(e, "spirv.emit: logical call arity mismatch"); }

    # the copy of the callee this call's pointer arguments select
    var ad: Addr = addr_init(e);
    fin { vector.dnit[AddrStep](?ad.steps); }
    val at: u32                  = e.keys.len::u32;
    val kr: res[bool, fail.Fail] = call_key(e, e.cur_copy, mf, mi, fx, ?ad, vm.prov, vm.n);
    if (sel kr.err) {
        e.keys.len = at::usize;
        ret err[fail.Fail].err{kr.err};
    }
    if (!kr.ok) {
        e.keys.len = at::usize;
        ret unsupported(e, "a SPIR-V Logical Shader reference argument must address memory the module names along one path: a local, a shader interface variable, or an element or member of one. logical addressing passes a pointer only as the object it points into and the path from there, and this address is chosen at run time or produced by an instruction");
    }
    val cx: u32 = find_copy(e, fx, at);
    e.keys.len = at::usize;
    if (cx == COPY_NONE) { ret emit_fail(e, "spirv.emit: a call selects a copy of its callee the plan did not make"); }
    val key: u32 = e.copies.data[cx].key_at;

    var slots: u32 = 0;
    var k:     u32 = 0;
    for (k < count) {
        slots = slots + binding_arity(e, key_param(e, key, k));
        k     = k + 1;
    }
    if (!types.instruction_operands_fit(3, slots)) { ret unsupported(e, "SPIR-V OpFunctionCall arguments exceed its 65535-word instruction encoding"); }
    val ar: res[*u32, A.Error] = A.allocate[u32](e.alloc, (slots + 3)::usize);
    if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
    val ops: *u32 = ar.ok;
    fin { A.deallocate[u32](e.alloc, ops, (slots + 3)::usize); }
    val pr: res[*u32, A.Error] = A.allocate[u32](e.alloc, (count + 1)::usize);
    if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
    val ptypes: *u32 = pr.ok;
    fin { A.deallocate[u32](e.alloc, ptypes, (count + 1)::usize); }
    val saved_ir: *ir.Module = e.ir;
    val saved_mi: u32        = e.cur_mi;
    e.ir     = fn_mod(e, fx);
    e.cur_mi = e.fns[fx].mi;
    var returns_void: bool = false;
    val ret_ty:       u32  = ir_return_spv_type(e, irfn, ?returns_void);
    k = 0;
    for (k < count) {
        ptypes[k] = 0;
        val bind: u32 = e.keys.data[key_param(e, key, k)];
        if (bind == BIND_VALUE || bind == BIND_WHOLE) { ptypes[k] = ir_value_spv_type(e, irfn.params[k].ty); }
        if (bind == BIND_PHYSICAL) {
            val pp: res[u32, fail.Fail] = phys_pointer(e, ?e.ir.types, irfn.params[k].ty);
            if (sel pp.err) {
                e.ir     = saved_ir;
                e.cur_mi = saved_mi;
                ret err[fail.Fail].err{pp.err};
            }
            ptypes[k] = pp.ok;
        }
        k = k + 1;
    }
    e.ir     = saved_ir;
    e.cur_mi = saved_mi;
    if (ret_ty == 0) { ret unsupported(e, "unsupported logical result type in SPIR-V"); }
    ops[0] = ret_ty;
    ops[2] = e.copies.data[cx].id;
    var w: u32 = 3;
    k = 0;
    for (k < count) {
        val op:   *mir.MirOperand = ?mi.operands[k + 2];
        val bind: u32             = e.keys.data[key_param(e, key, k)];
        if (bind == BIND_PHYSICAL) {
            val p: u32 = read_operand(e, vm, op, ptypes[k]);
            if (e.b.err || p == 0) { ret emit_fail(e, "spirv.emit: unreadable physical pointer argument"); }
            ops[w] = p;
            w      = w + 1;
            k      = k + 1;
            cnt;
        }
        if (bind == BIND_VALUE) {
            if (ptypes[k] == 0) { ret unsupported(e, "unsupported logical argument type in SPIR-V"); }
            val value: res[u32, fail.Fail] = read_value(e, mf, vm, op, ptypes[k], mi.memory_flags);
            if (sel value.err) { ret emit_inner(e, value.err); }
            ops[w] = value.ok;
            w      = w + 1;
            k      = k + 1;
            cnt;
        }
        val tr: res[bool, fail.Fail] = trace_address(e, e.cur_copy, mf, op, ?ad);
        if (sel tr.err) { ret err[fail.Fail].err{tr.err}; }
        if (!tr.ok)     { ret emit_fail(e, "spirv.emit: a reference argument the plan traced no longer traces"); }
        if (bind == BIND_WHOLE) {
            if (ptypes[k] == 0) { ret unsupported(e, "unsupported logical argument type in SPIR-V"); }
            var storage: u32 = 0;
            val pointee: u32 = types.pointer_shape(e.tt, ptypes[k], ?storage);
            val actual:  u32 = spv_type_of(e, ?e.u.mods[ad.root_mi].ir.types, ad.root_ty);
            if (pointee == 0 || actual != pointee || storage != spirv.STORAGE_FUNCTION) {
                ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_UNSUPPORTED, mir.refusal_loc(mf, e.cur_instr), "SPIR-V Logical Shader reference arguments require a matching Function-storage object")};
            }
        }
        if (bind != BIND_GLOBAL) {
            val root: u32 = addr_root_id(e, vm, ?ad);
            if (root == 0) { ret emit_fail(e, "spirv.emit: a reference argument's root has no object"); }
            ops[w] = root;
            w      = w + 1;
        }
        var i: u32 = 0;
        for (i < ad.steps.len::u32) {
            val st: *AddrStep = ?ad.steps.data[i];
            i = i + 1;
            if (st.ord != STEP_RUNTIME) { cnt; }
            val id: u32 = addr_step_id(e, vm, st);
            if (id == 0) { ret emit_fail(e, "spirv.emit: a reference argument's runtime index was never read"); }
            ops[w] = id;
            w      = w + 1;
        }
        k = k + 1;
    }
    if (w != slots + 3) { ret emit_fail(e, "spirv.emit: a call's arguments disagree with its copy's parameters"); }
    ops[1] = spirv.alloc_id(e.b);
    spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION_CALL, ops, slots + 3);
    if (!returns_void) { ret write_value(e, mf, vm, ?mi.operands[1], ops[1], ret_ty, mi.memory_flags); }
    if (mi.operands[1].kind != mir.MIR_OP_VREG || !mir.vreg_is_nil(mi.operands[1].vreg)) {
        ret emit_fail(e, "spirv.emit: void logical call names a result");
    }
    ret err[fail.Fail].ok{};
}

# the object a traced address is rooted at in the copy under emission: a local
# allocation's variable, or the object a parameter of the copy passes
fun addr_root_id(e: *Emit, vm: *VMaps, ad: *Addr) u32 {
    if (ad.root == ROOT_ALLOCA) {
        if (ad.vreg >= vm.n) { ret 0; }
        ret vm.chain_id[ad.vreg];
    }
    if (ad.root == ROOT_PARAM) { ret e.cur_params[e.cur_pslot[ad.param]]; }
    ret 0;
}

# the id of a runtime index: one an access chain of this function read, or one this copy receives
fun addr_step_id(e: *Emit, vm: *VMaps, st: *AddrStep) u32 {
    if (st.from_param) {
        val p:    u32 = key_param(e, e.copies.data[e.cur_copy].key_at, st.a);
        var slot: u32 = e.cur_pslot[st.a] + st.b;
        if (e.keys.data[p] == BIND_LOCAL) { slot = slot + 1; }
        ret e.cur_params[slot];
    }
    if (st.a >= vm.n || vm.gep_at[st.a] == 0) { ret 0; }
    ret vm.gep_ids.data[vm.gep_at[st.a] - 1 + st.b];
}

# the SPIR-V parameter types a path binding takes: its root when Function-storage, then u32 indices
fun path_param_types(e: *Emit, at: u32, out: *u32) {
    var w: u32 = 0;
    if (e.keys.data[at] == BIND_LOCAL) {
        out[0] = types.type_ptr(e.tt, spirv.STORAGE_FUNCTION, path_root_type(e, at));
        w      = 1;
    }
    var n:    u32 = 0;
    val from: u32 = binding_steps(e, at, ?n);
    var i:    u32 = 0;
    for (i < n) {
        if (e.keys.data[from + i] == STEP_RUNTIME) {
            out[w] = types.type_int(e.tt, 32);
            w      = w + 1;
        }
        i = i + 1;
    }
}

fun path_root_type(e: *Emit, at: u32) u32 {
    ret spv_type_of(e, ?e.u.mods[e.keys.data[at + 1]].ir.types, e.keys.data[at + 2]::type.IrTypeId);
}

# a pointer parameter bound to a path: the chain from its root, a global the copy
# names or the Function-storage object it receives, through the constant ordinals
# of the key and the indices the copy receives
fun bind_path_param(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, at: u32, slot: u32) err[fail.Fail] {
    val dst: *mir.MirOperand = ?mi.operands[0];
    if (dst.kind != mir.MIR_OP_VREG || dst.vreg.n >= vm.n) {
        ret emit_fail(e, "spirv.emit: a reference parameter is not bound to a register");
    }
    var root: u32 = 0;
    var cur:  u32 = 0;
    var sc:   u32 = spirv.STORAGE_FUNCTION;
    var next: u32 = slot;
    if (e.keys.data[at] == BIND_GLOBAL) {
        val gx: u32 = e.keys.data[at + 1];
        root = e.gvar_ids[gx];
        cur  = e.gtype_ids[gx];
        sc   = e.gstorage[gx];
    }
    or {
        root = e.cur_params[slot];
        cur  = path_root_type(e, at);
        next = slot + 1;
    }
    var n:    u32 = 0;
    val from: u32 = binding_steps(e, at, ?n);
    var ptr:  u32 = root;
    if (n > 0) {
        val ar: res[*u32, A.Error] = A.allocate[u32](e.alloc, (n + 3)::usize);
        if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
        val ops: *u32 = ar.ok;
        fin { A.deallocate[u32](e.alloc, ops, (n + 3)::usize); }
        var i: u32 = 0;
        for (i < n) {
            val step: u32 = e.keys.data[from + i];
            if (step == STEP_RUNTIME) {
                ops[3 + i] = e.cur_params[next];
                next       = next + 1;
                cur        = types.composite_member(e.tt, cur, 0);
            }
            or {
                ops[3 + i] = types.const_int(e.tt, 32, step::i64);
                cur        = types.composite_member(e.tt, cur, step);
            }
            if (cur == 0) { ret emit_fail(e, "spirv.emit: a reference parameter's path reaches past its root"); }
            i = i + 1;
        }
        ptr    = spirv.alloc_id(e.b);
        ops[0] = types.type_ptr(e.tt, sc, cur);
        ops[1] = ptr;
        ops[2] = root;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_ACCESS_CHAIN, ops, n + 3);
        chain_memory_scope(e, ptr, root);
    }
    vm.chain_id[dst.vreg.n] = ptr;
    vm.chain_ty[dst.vreg.n] = cur;
    vm.chain_sc[dst.vreg.n] = sc;
    ret err[fail.Fail].ok{};
}

fun foreign_call_refusal(e: *Emit, fn: *ir.Function) str {
    val nm:  opt[str] = intern.lookup(e.interner, fn.name);
    var who: str      = "this function";
    if (sel nm.some) { who = nm.some; }
    val r: res[str, format.FormatError] = format.sprint(e.alloc,
        "`{}` is declared `ext`, and a SPIR-V module cannot call a foreign import: the module a shader compiles to is self-contained, so there is no symbol to bind at load time. give the operation an `#[op(\"spirv\", set, name)]` mapping so the call becomes that instruction, or write it in mach so its body can be emitted here",
        who);
    if (sel r.err) {
        ret "a SPIR-V module cannot call a foreign `ext` import: the module is self-contained and has no symbol to bind at load time";
    }
    ret r.ok;
}

fun unresolved_call_refusal(e: *Emit, name: intern.StrId, fx: u32) str {
    val nm:  opt[str] = intern.lookup(e.interner, name);
    var who: str      = "this function";
    if (sel nm.some) { who = nm.some; }
    if (fx != FN_NONE) {
        var where: str      = "the module it belongs to";
        val mo:    opt[str] = intern.lookup(e.interner, fn_mod(e, fx).name);
        if (sel mo.some) { where = mo.some; }
        val r2: res[str, format.FormatError] = format.sprint(e.alloc,
            "`{}` is declared in `{}` but has no body the SPIR-V target can emit, so there is nothing to call: a self-contained module cannot leave the call for a linker to resolve",
            who, where);
        if (sel r2.ok) { ret r2.ok; }
        ret "the SPIR-V target has no body to emit for this callee, and a self-contained module cannot leave the call for a linker to resolve";
    }
    val r: res[str, format.FormatError] = format.sprint(e.alloc,
        "no module in this build defines `{}`, so the SPIR-V target has no body to emit for it: a self-contained module cannot leave the call for a linker to resolve",
        who);
    if (sel r.err) {
        ret "no module in this build defines this callee, so the SPIR-V target has no body to emit for it";
    }
    ret r.ok;
}

# a call to an `#[op]` declaration is the instruction its row names: the row says
# whether it has a result id, and how each operand is written, so a pointer operand
# takes the storage class of the argument's own access chain rather than a
# parameter type's
fun emit_spirv_op(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr, fn: *ir.Function) err[fail.Fail] {
    val sig_opt: opt[*type.IrType] = type.get(?e.ir.types, fn.sig);
    if (sel sig_opt.none) {
        ret emit_fail(e, "spirv.emit: an `op` callee has no signature type");
    }
    val sig: *type.IrType = sig_opt.some;
    if (sig.kind != type.IRT_FN) {
        ret emit_fail(e, "spirv.emit: an `op` callee's signature is not a function type");
    }
    val argc: u32 = sig.data.fn.param_count;
    if (argc != mi.operand_count - 2)             { ret emit_fail(e, "spirv.emit: mapped logical call arity mismatch"); }
    if (!types.instruction_operands_fit(4, argc)) { ret unsupported(e, "SPIR-V mapped instruction arguments exceed its 65535-word encoding"); }
    val row: *isa.OpDef = isa.op_def_by_code(e.tgt.defs, fn.op_set, fn.op_code);
    if (row == nil || argc < row.min_arity || argc > row.arity) {
        ret emit_fail(e, "spirv.emit: an `op` callee has no instruction row of its arity");
    }
    val rq: err[fail.Fail] = require(e, mf, row.capability, row.requires, op_use_text(e, row, nil));
    if (sel rq.err) { ret rq; }

    var returns_void: bool = false;
    var ret_ty:       u32  = 0;
    var pointee:      u32  = 0;
    if (row.result == isa.OP_RESULT_POINTER) {
        pointee = ir_pointee_spv_type(e, sig.data.fn.ret_type);
        if (pointee == 0) { ret unsupported(e, "the type an `op` pointer result addresses has no SPIR-V form"); }
        ret_ty = types.type_ptr(e.tt, row.result_space, pointee);
    }
    or (row.result == isa.OP_RESULT_BOOL) {
        ret_ty = types.type_bool(e.tt);
    }
    or {
        ret_ty = ir_return_spv_type(e, fn, ?returns_void);
        if (ret_ty == 0) { ret unsupported(e, "unsupported return type in the SPIR-V target"); }
    }
    if ((row.result == isa.OP_RESULT_NONE) != returns_void) {
        ret emit_fail(e, "spirv.emit: an `op` declaration's return disagrees with its instruction's result");
    }

    # an extended instruction always has a result id, void when it produces nothing
    val core:       bool = fn.op_set == defs.SPV_SET_CORE;
    val has_result: bool = !core || row.result != isa.OP_RESULT_NONE;

    # two words beyond the call's own, for the texel operands a coherent image access adds
    val ar: res[*u32, A.Error] = A.allocate[u32](e.alloc, (argc + 6)::usize);
    if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
    val ops: *u32 = ar.ok;
    fin { A.deallocate[u32](e.alloc, ops, (argc + 6)::usize); }
    var base: u32 = 0;
    if (has_result) {
        ops[0] = ret_ty;
        base   = 2;
    }
    if (!core) {
        val set_id: u32 = ext_set_id(e, fn.op_set);
        if (set_id == 0) {
            ret emit_fail(e, "spirv.emit: an `op` names an instruction set with no import name");
        }
        ops[2] = set_id;
        ops[3] = fn.op_code;
        base   = 4;
    }

    # the operands the row spells first, whose literal words decide the kinds of the rest
    val span: u32 = isa.op_literal_span(row, argc);
    var i:    u32 = 0;
    for (i < span) {
        val hr: err[fail.Fail] = require_handle_access(e, mf, row, isa.op_operand_kind(row, i), sig.data.fn.params[i]);
        if (sel hr.err) { ret hr; }
        val word: res[u32, fail.Fail] = op_operand(e, mf, vm, mi, row, i, isa.op_operand_kind(row, i), sig.data.fn.params[i]);
        if (sel word.err) { ret emit_inner(e, word.err); }
        ops[base + i] = word.ok;
        i             = i + 1;
    }
    val er: err[fail.Fail] = op_enumerated_operands(e, mf, row, argc, ?ops[base]);
    if (sel er.err) { ret er; }
    var kinds: [isa.OP_MAX_OPERANDS]isa.OpOperandKind;
    isa.op_call_kinds(row, argc, ?ops[base], ?kinds[0]);
    for (i < argc) {
        val fr: err[fail.Fail] = op_brought_fits(e, mf, row, i, kinds[i], sig.data.fn.params[i]);
        if (sel fr.err) { ret fr; }
        val word: res[u32, fail.Fail] = op_operand(e, mf, vm, mi, row, i, kinds[i], sig.data.fn.params[i]);
        if (sel word.err) { ret emit_inner(e, word.err); }
        ops[base + i] = word.ok;
        i             = i + 1;
    }
    val tr: err[fail.Fail] = op_typed_requirement(e, mf, vm, mi, row, sig);
    if (sel tr.err) { ret tr; }
    if (core) {
        val ir_: err[fail.Fail] = refuse_image_use(e, mf, row, argc, ?ops[base], sig);
        if (sel ir_.err) { ret ir_; }
    }
    var words: u32 = argc;
    if (core) { words = coherent_texel_operands(e, vm, mi, row, sig, ?ops[base]); }
    var result: u32 = 0;
    if (has_result) {
        result = spirv.alloc_id(e.b);
        ops[1] = result;
    }

    var opcode: u32 = spirv.OP_EXT_INST;
    if (core) { opcode = fn.op_code; }
    spirv.inst(e.b, ?e.b.functions, opcode, ?ops[0], base + words);

    if (row.result == isa.OP_RESULT_NONE) {
        if (mi.operands[1].kind != mir.MIR_OP_VREG || !mir.vreg_is_nil(mi.operands[1].vreg)) {
            ret emit_fail(e, "spirv.emit: a void `op` call names a result");
        }
        ret err[fail.Fail].ok{};
    }
    if (row.result == isa.OP_RESULT_POINTER) {
        val dst: *mir.MirOperand = ?mi.operands[1];
        if (dst.kind != mir.MIR_OP_VREG || dst.vreg.n >= vm.n) {
            ret emit_fail(e, "spirv.emit: an `op` pointer result is not bound to a register");
        }
        vm.chain_id[dst.vreg.n] = result;
        vm.chain_ty[dst.vreg.n] = pointee;
        vm.chain_sc[dst.vreg.n] = row.result_space;
        ret err[fail.Fail].ok{};
    }
    ret write_value(e, mf, vm, ?mi.operands[1], result, ret_ty, mi.memory_flags);
}

# under the Vulkan memory model a read of a coherent storage image's texels makes them
# visible and a write makes them available, as a coherent buffer's loads and stores do:
# the emitter adds MakeTexelVisible or MakeTexelAvailable with NonPrivateTexel and the
# scope id to the instruction's Image Operands, whose mask leads the row's tail. the
# scope operand lands in bit order, after the operands of the call's lower bits and
# before those of its higher ones, and a call that already carries the bit keeps its own
# scope. a handle reaching a function as a parameter has no variable to read the
# qualifier from, so its accesses are coherent wherever the module binds a coherent
# image. returns the operand count, the added words included
fun coherent_texel_operands(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, row: *isa.OpDef, sig: *type.IrType, words: *u32) u32 {
    val argc: u32 = sig.data.fn.param_count;
    if (!e.vulkan_mm || isa.op_tail_literal(row) == nil) { ret argc; }
    var h: u32 = 0;
    for (h < argc && !isa.op_kind_is_handle(isa.op_operand_kind(row, h))) { h = h + 1; }
    if (h == argc) { ret argc; }
    val img: *type.IrType = image_handle(e, sig.data.fn.params[h]);
    if (img == nil || img.data.handle_.operands[defs.IMAGE_OP_SAMPLED]::u32 != spirv.IMAGE_SAMPLED_STORAGE) { ret argc; }
    val op:    *mir.MirOperand = ?mi.operands[h + 2];
    var scope: u32             = 0;
    if (op.kind == mir.MIR_OP_VREG && op.vreg.n < vm.n && vm.opq_var[op.vreg.n] != 0) {
        scope = memory_scope_of(e, vm.opq_var[op.vreg.n]);
    }
    or (op.kind == mir.MIR_OP_SYM && op.sym_off == 0) {
        scope = memory_scope_of(e, global_var_id(e, op.sym));
    }
    or (e.coherent_images) { scope = spirv.SCOPE_QUEUE_FAMILY; }
    if (scope == 0)        { ret argc; }
    var bit: u32 = defs.IMAGE_OPERANDS_MAKE_TEXEL_VISIBLE;
    if (isa.op_operand_kind(row, h) == isa.OP_OPERAND_HANDLE_WRITE) { bit = defs.IMAGE_OPERANDS_MAKE_TEXEL_AVAILABLE; }
    ret splice_texel_operands(words, argc, row.min_arity, isa.op_tail_literal(row), bit, types.const_int(e.tt, 32, scope::i64));
}

# `bit` with NonPrivateTexel and its `scope` id spliced into the Image Operands mask at
# `at` of the `argc` operands in `words`, the mask added when the call passes none. the
# scope follows the mask and the operands the call's bits below `bit` bring, which `en`
# counts, and a call already carrying `bit` keeps its own scope. returns the operand count
fun splice_texel_operands(words: *u32, argc: u32, at: u32, en: *isa.OpEnum, bit: u32, scope: u32) u32 {
    if (argc <= at) {
        words[argc]     = bit | defs.IMAGE_OPERANDS_NON_PRIVATE_TEXEL;
        words[argc + 1] = scope;
        ret argc + 2;
    }
    val mask: u32 = words[at];
    words[at] = mask | defs.IMAGE_OPERANDS_NON_PRIVATE_TEXEL;
    if ((mask & bit) != 0) { ret argc; }
    words[at] = words[at] | bit;
    var pos: u32 = at + 1;
    var low: u32 = 1;
    for (low < bit) {
        if ((mask & low) != 0) {
            val one: *isa.OpEnumerant = isa.op_enumerant_of(en, low);
            if (one != nil) { pos = pos + isa.op_enumerant_brings(one); }
        }
        low = low << 1;
    }
    var k: u32 = argc;
    for (k > pos) {
        words[k] = words[k - 1];
        k        = k - 1;
    }
    words[pos] = scope;
    ret argc + 1;
}

# a typed row's data type, in the storage class its operand addresses, against the row's
# typing: the requirement admitting both is collected like the row's, and a type the
# typing admits only in other classes is refused naming the class
fun op_typed_requirement(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr, row: *isa.OpDef,
    sig: *type.IrType) err[fail.Fail] {
    val t: *isa.OpTyping = row.typing;
    if (!isa.op_typing_constrains(t))         { ret err[fail.Fail].ok{}; }
    if (t.operand >= sig.data.fn.param_count) { ret emit_fail(e, "spirv.emit: a typed `op` row reads its data type from an operand the call does not pass"); }
    var dty:   type.IrTypeId = sig.data.fn.params[t.operand];
    var space: u32           = isa.NO_OP_SPACE;
    if (isa.op_kind_is_pointer(isa.op_operand_kind(row, t.operand))) {
        val pt: opt[*type.IrType] = type.get(?e.ir.types, dty);
        if (sel pt.none)                  { ret emit_fail(e, "spirv.emit: a typed `op` pointer operand has no pointer type"); }
        if (pt.some.kind != type.IRT_PTR) { ret emit_fail(e, "spirv.emit: a typed `op` pointer operand has no pointer type"); }
        dty   = pt.some.data.pointee;
        space = op_pointer_space(e, vm, ?mi.operands[t.operand + 2]);
    }
    var class: isa.OpDataClass   = isa.OP_DATA_OTHER;
    var bits:  u32               = 0;
    val got:   opt[*type.IrType] = type.get(?e.ir.types, dty);
    if (sel got.some) {
        if (got.some.kind == type.IRT_INT) {
            bits  = got.some.data.bits;
            class = isa.OP_DATA_INT;
            # an f16 carried as its 16 bits is still a float to the instruction
            if (got.some.form == type.INT_FORM_BINARY16) { class = isa.OP_DATA_FLOAT; }
        }
        or (got.some.kind == type.IRT_FLOAT) {
            bits  = got.some.data.bits;
            class = isa.OP_DATA_FLOAT;
        }
    }
    val one: *isa.OpTypeRequirement = isa.op_type_requirement(t, class, bits, space);
    if (one == nil) {
        val r: res[str, format.FormatError] = format.sprint(e.alloc,
            "`{}` on a {}-bit {} is not available in the {} storage class: {} on a type beyond a 32-bit integer is defined only on a storage buffer, `#[shared]` workgroup memory or a storage image texel, and on a texel only for a 64-bit integer or an f32",
            row.name, bits, data_class_name(class), storage_class_name(space), t.name);
        if (sel r.err) { ret err[fail.Fail].err{fail.format_refused(r.err)}; }
        ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_CAPABILITY, mir.refusal_loc(mf, e.cur_instr), r.ok)};
    }
    var what: str                          = row.name;
    val wr:   res[str, format.FormatError] = format.sprint(e.alloc, "`{}` on a {}-bit {} in the {} storage class",
        row.name, bits, data_class_name(class), storage_class_name(space));
    if (sel wr.ok) { what = wr.ok; }
    ret require(e, mf, one.capability, one.requires, what);
}

fun data_class_name(class: isa.OpDataClass) str {
    if (class == isa.OP_DATA_FLOAT) { ret "float"; }
    ret "integer";
}

# the storage class the memory a pointer operand names lives in, NO_OP_SPACE when it names none
fun op_pointer_space(e: *Emit, vm: *VMaps, op: *mir.MirOperand) u32 {
    var ty: u32 = 0;
    if (chain_target(vm, op, ?ty) != 0)               { ret chain_storage(vm, op); }
    if (physical_value(vm, op) != mir.MIR_VREG_NIL.n) { ret spirv.STORAGE_PHYSICAL_STORAGE_BUFFER; }
    if (op.kind == mir.MIR_OP_SYM && op.sym_off == 0) {
        val gx: u32 = gl_lookup(e, op.sym);
        if (gx != GL_NONE && gl_ir(e, gx).iface != ir.IFACE_NONE) { ret e.gstorage[gx]; }
    }
    ret isa.NO_OP_SPACE;
}

fun storage_class_name(space: u32) str {
    if (space == spirv.STORAGE_STORAGE_BUFFER)          { ret "StorageBuffer"; }
    if (space == spirv.STORAGE_UNIFORM)                 { ret "Uniform"; }
    if (space == spirv.STORAGE_WORKGROUP)               { ret "Workgroup"; }
    if (space == spirv.STORAGE_FUNCTION)                { ret "Function"; }
    if (space == spirv.STORAGE_IMAGE)                   { ret "Image"; }
    if (space == spirv.STORAGE_PUSH_CONSTANT)           { ret "PushConstant"; }
    if (space == spirv.STORAGE_INPUT)                   { ret "Input"; }
    if (space == spirv.STORAGE_OUTPUT)                  { ret "Output"; }
    if (space == spirv.STORAGE_UNIFORM_CONSTANT)        { ret "UniformConstant"; }
    if (space == spirv.STORAGE_PHYSICAL_STORAGE_BUFFER) { ret "PhysicalStorageBuffer"; }
    ret "unknown";
}

# each enumerated literal's value against its enumeration: it must be one of its values,
# the operands it brings must be the optional tail the call passes, and each value's
# requirement is collected like the row's. a literal leading the tail is passed or left
# out with its operands, so a call at the row's required count passes no mask
fun op_enumerated_operands(e: *Emit, mf: *mir.MirFunction, row: *isa.OpDef, argc: u32, words: *u32) err[fail.Fail] {
    var bad:  u32 = isa.NO_OPERAND;
    val want: u32 = isa.op_call_arity(row, argc, words, ?bad);
    if (bad != isa.NO_OPERAND) {
        ret err[fail.Fail].err{reject_at(e, dkind.OP_OPERAND_VALUE, mir.refusal_loc(mf, e.cur_instr),
            op_operand_value_text(e, row, bad, isa.op_operand_enum(row, bad), words[bad]))};
    }
    val span: u32 = isa.op_literal_span(row, argc);
    var i:    u32 = 0;
    for (i < span) {
        val en: *isa.OpEnum = isa.op_operand_enum(row, i);
        if (en == nil) {
            i = i + 1;
            cnt;
        }
        val value: u32 = words[i];
        if (!en.mask) {
            val one: *isa.OpEnumerant = isa.op_enumerant_of(en, value);
            val rq:  err[fail.Fail]   = require(e, mf, one.capability, one.requires, op_use_text(e, row, one.name));
            if (sel rq.err) { ret rq; }
        }
        or {
            var bit: u32 = 1;
            for (bit != 0 && bit <= value) {
                if ((value & bit) != 0) {
                    val one: *isa.OpEnumerant = isa.op_enumerant_of(en, bit);
                    val rq:  err[fail.Fail]   = require(e, mf, one.capability, one.requires, op_use_text(e, row, one.name));
                    if (sel rq.err) { ret rq; }
                }
                bit = bit << 1;
            }
        }
        i = i + 1;
    }
    if (want != argc) {
        val r: res[str, format.FormatError] = format.sprint(e.alloc,
            "`{}` takes {} operands with the literal values this call passes, and the declaration passes {}: the operands after the {} it always takes are present exactly as far as a literal's value brings them, so declare the instruction once per shape",
            row.name, want, argc, row.min_arity);
        if (sel r.err) { ret err[fail.Fail].err{fail.format_refused(r.err)}; }
        ret err[fail.Fail].err{reject_at(e, dkind.OP_OPERAND_VALUE, mir.refusal_loc(mf, e.cur_instr), r.ok)};
    }
    ret err[fail.Fail].ok{};
}

fun op_operand_value_text(e: *Emit, row: *isa.OpDef, i: u32, en: *isa.OpEnum, value: u32) str {
    var names: [256]u8;
    var at:    usize = 0;
    var k:     u32   = 0;
    for (k < en.count) {
        val nm: str   = en.values[k].name;
        val nl: usize = str_len(nm);
        if (at + nl + 3 >= 256) { brk; }
        if (k > 0) {
            names[at]     = ',';
            names[at + 1] = ' ';
            at            = at + 2;
        }
        var c: usize = 0;
        for (c < nl) {
            names[at + c] = nm[c]::u8;
            c             = c + 1;
        }
        at = at + nl;
        k  = k + 1;
    }
    names[at] = 0;
    var form: str = "one of";
    if (en.mask) { form = "a union of"; }
    val r: res[str, format.FormatError] = format.sprint(e.alloc,
        "operand {} of `{}` is a `{}`, and {} is not {} its values ({}): the word would be written into the module as a value the specification does not define",
        i + 1, row.name, en.name, value, form, (?names[0])::str);
    if (sel r.err) { ret "an `op` literal operand's value is not one its enumeration defines"; }
    ret r.ok;
}

# "`OpGroupNonUniformIAdd`", or with the literal value that raised the requirement
fun op_use_text(e: *Emit, row: *isa.OpDef, value: str) str {
    var r: res[str, format.FormatError];
    if (value == nil) { r = format.sprint(e.alloc, "`{}`", row.name); }
    or                { r = format.sprint(e.alloc, "`{}` with `{}`", row.name, value); }
    if (sel r.err)    { ret row.name; }
    ret r.ok;
}

# an image instruction against the image it names and the Image Operands it passes,
# which only the call's literal and the image's own operands decide together
fun refuse_image_use(e: *Emit, mf: *mir.MirFunction, row: *isa.OpDef, argc: u32, words: *u32,
    sig: *type.IrType) err[fail.Fail] {
    var mask: u32 = 0;
    val span: u32 = isa.op_literal_span(row, argc);
    var i:    u32 = 0;
    for (i < span) {
        if (defs.is_image_operands(isa.op_operand_enum(row, i))) { mask = words[i]; }
        i = i + 1;
    }
    var image:   bool = false;
    var ms:      bool = false;
    var storage: bool = false;
    var depth:   bool = false;
    var dim:     u32  = defs.NO_IMAGE_DIM;
    if (argc > 0) {
        val img: *type.IrType = image_handle(e, sig.data.fn.params[0]);
        if (img != nil) {
            image   = true;
            ms      = img.data.handle_.operands[defs.IMAGE_OP_MS]::u32 != 0;
            storage = img.data.handle_.operands[defs.IMAGE_OP_SAMPLED]::u32 == spirv.IMAGE_SAMPLED_STORAGE;
            dim     = img.data.handle_.operands[defs.IMAGE_OP_DIM]::u32;
            depth   = img.data.handle_.operands[defs.IMAGE_OP_DEPTH]::u32 == 1;
        }
        val sampled: *type.IrType = sampled_image_handle(e, sig.data.fn.params[0]);
        if (sampled != nil) {
            dim   = sampled.data.handle_.operands[defs.IMAGE_OP_DIM]::u32;
            depth = sampled.data.handle_.operands[defs.IMAGE_OP_DEPTH]::u32 == 1;
        }
    }
    var why: str = implicit_lod_stage_refusal(e, row);
    if (why == nil)                                          { why = defs.image_use_refusal(row.opcode, image, ms, storage, dim, depth, mask); }
    if (why == nil && mask != 0 && dim != defs.NO_IMAGE_DIM) { why = image_operand_shapes(e, row, argc, sig, mask, dim); }
    if (why == nil)                                          { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{reject_at(e, dkind.OP_OPERAND_VALUE, mir.refusal_loc(mf, e.cur_instr), why)};
}

# an implicit-lod sample derives its level of detail from the derivatives of its
# coordinate across neighbouring invocations, which only a fragment stage has: a compute
# stage has them only under a derivative-group execution mode this target does not
# declare, and a vertex stage never
fun implicit_lod_stage_refusal(e: *Emit, row: *isa.OpDef) str {
    var explicit: str = "OpImageSampleExplicitLod";
    if (row.opcode == spirv.OP_IMAGE_SAMPLE_DREF_IMPLICIT_LOD) { explicit = "OpImageSampleDrefExplicitLod"; }
    or (row.opcode != spirv.OP_IMAGE_SAMPLE_IMPLICIT_LOD)      { ret nil; }
    val other: u8 = e.cur_stages & ~stage_bit(ir.STAGE_FRAGMENT);
    if (other == 0) { ret nil; }
    val r: res[str, format.FormatError] = format.sprint(e.alloc,
        "`{}` derives its level of detail from the derivatives of its coordinate, which only a fragment stage has, and this call is reached from a {} stage: sample there with `{}` and a `Lod` or `Grad`",
        row.name, stages_spelling(e, other), explicit);
    if (sel r.err) { ret "an implicit-lod sample derives its level of detail from derivatives only a fragment stage has"; }
    ret r.ok;
}

# the operands each set bit of the Image Operands mask `mask` brings, in bit order after
# the mask, against the dimensionality of the image the call's first operand is or
# samples. nil when they fit, or when the image is not one this target describes
fun image_operand_shapes(e: *Emit, row: *isa.OpDef, argc: u32, sig: *type.IrType, mask: u32, dim: u32) str {
    val span: u32         = isa.op_literal_span(row, argc);
    var en:   *isa.OpEnum = nil;
    var i:    u32         = 0;
    for (i < span) {
        if (defs.is_image_operands(isa.op_operand_enum(row, i))) { en = isa.op_operand_enum(row, i); }
        i = i + 1;
    }
    if (en == nil) { ret nil; }
    var at:  u32 = span;
    var bit: u32 = 1;
    for (bit != 0 && bit <= mask) {
        if ((mask & bit) != 0) {
            val n: u32 = isa.op_enumerant_brings(isa.op_enumerant_of(en, bit));
            var k: u32 = 0;
            for (k < n && at + k < argc) {
                var float:      bool = false;
                var components: u32  = 0;
                var elements:   u32  = 0;
                var why:        str  = nil;
                if (ir_numeric_array_shape(e, sig.data.fn.params[at + k], ?float, ?components, ?elements)) {
                    why = defs.image_operand_shape_refusal(bit, dim, float, components, elements);
                }
                if (why != nil) { ret why; }
                k = k + 1;
            }
            at = at + n;
        }
        bit = bit << 1;
    }
    ret nil;
}

# whether `id` is a number or a vector of them, with whether it is a float and how many components it has
fun ir_numeric_shape(e: *Emit, id: type.IrTypeId, out_float: *bool, out_components: *u32) bool {
    val opt_: opt[*type.IrType] = type.get(?e.ir.types, id);
    if (sel opt_.none) { ret false; }
    var t: *type.IrType = opt_.some;
    @out_components = 1;
    if (t.kind == type.IRT_VECTOR) {
        @out_components = t.data.vector_.lanes;
        val el: opt[*type.IrType] = type.get(?e.ir.types, t.data.vector_.element);
        if (sel el.none) { ret false; }
        t = el.some;
    }
    @out_float = t.kind == type.IRT_FLOAT;
    ret t.kind == type.IRT_FLOAT || t.kind == type.IRT_INT;
}

# whether `id` is a number, a vector of them or an array of either, with the shape
# `ir_numeric_shape` gives its element and how many elements it has, 0 for no array
fun ir_numeric_array_shape(e: *Emit, id: type.IrTypeId, out_float: *bool, out_components: *u32, out_elements: *u32) bool {
    @out_elements = 0;
    val opt_: opt[*type.IrType] = type.get(?e.ir.types, id);
    if (sel opt_.none)                    { ret false; }
    if (opt_.some.kind != type.IRT_ARRAY) { ret ir_numeric_shape(e, id, out_float, out_components); }
    @out_elements = opt_.some.data.array_.count;
    ret ir_numeric_shape(e, opt_.some.data.array_.element, out_float, out_components);
}

# the `image` handle type a `sampled_image` handle type `param` composes over, nil when it is none
fun sampled_image_handle(e: *Emit, param: type.IrTypeId) *type.IrType {
    val opt_: opt[*type.IrType] = type.get(?e.ir.types, param);
    if (!sel opt_.some) { ret nil; }
    val t: *type.IrType = opt_.some;
    if (t.kind != type.IRT_HANDLE || t.data.handle_.ctor != defs.SPV_CTOR_SAMPLED_IMAGE || t.data.handle_.count != 1) { ret nil; }
    ret image_handle(e, t.data.handle_.operands[0]);
}

# the `image` handle type `param` is, nil when it is no image
fun image_handle(e: *Emit, param: type.IrTypeId) *type.IrType {
    val opt_: opt[*type.IrType] = type.get(?e.ir.types, param);
    if (!sel opt_.some) { ret nil; }
    val t: *type.IrType = opt_.some;
    if (t.kind != type.IRT_HANDLE || t.data.handle_.ctor != defs.SPV_CTOR_IMAGE
        || t.data.handle_.count != defs.IMAGE_ARITY) { ret nil; }
    ret t;
}

# a multisampled storage image is declared only under StorageImageMultisample, and an
# arrayed one under ImageMSArray as well, both enabled by the device feature that permits them
fun require_image_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) err[fail.Fail] {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (!sel opt_.some) { ret err[fail.Fail].ok{}; }
    val t: *type.IrType = opt_.some;
    if (t.kind != type.IRT_HANDLE || t.data.handle_.ctor != defs.SPV_CTOR_IMAGE
        || t.data.handle_.count != defs.IMAGE_ARITY) { ret err[fail.Fail].ok{}; }
    if (t.data.handle_.operands[defs.IMAGE_OP_MS]::u32 == 0
        || t.data.handle_.operands[defs.IMAGE_OP_SAMPLED]::u32 != spirv.IMAGE_SAMPLED_STORAGE) { ret err[fail.Fail].ok{}; }
    val rq: err[fail.Fail] = require(e, nil, spirv.CAP_STORAGE_IMAGE_MULTISAMPLE, spirv.EXT_STORAGE_IMAGE_MULTISAMPLE,
        "a multisampled storage image");
    if (sel rq.err)                                               { ret rq; }
    if (t.data.handle_.operands[defs.IMAGE_OP_ARRAYED]::u32 == 0) { ret err[fail.Fail].ok{}; }
    ret require(e, nil, spirv.CAP_IMAGE_MS_ARRAY, spirv.EXT_STORAGE_IMAGE_MULTISAMPLE, "an arrayed multisampled storage image");
}

# a storage image of Unknown format is read or written only under the capability
# for doing so without a format, and the device feature that permits it
fun require_handle_access(e: *Emit, mf: *mir.MirFunction, row: *isa.OpDef, kind: isa.OpOperandKind,
    param: type.IrTypeId) err[fail.Fail] {
    if (!isa.op_kind_is_handle(kind)) { ret err[fail.Fail].ok{}; }
    val opt_: opt[*type.IrType] = type.get(?e.ir.types, param);
    if (!sel opt_.some) { ret err[fail.Fail].ok{}; }
    val t: *type.IrType = opt_.some;
    if (t.kind != type.IRT_HANDLE || t.data.handle_.ctor != defs.SPV_CTOR_IMAGE
        || t.data.handle_.count != defs.IMAGE_ARITY) { ret err[fail.Fail].ok{}; }
    if (t.data.handle_.operands[defs.IMAGE_OP_SAMPLED]::u32 != spirv.IMAGE_SAMPLED_STORAGE
        || t.data.handle_.operands[defs.IMAGE_OP_FORMAT]::u32 != spirv.IMAGE_FORMAT_UNKNOWN) { ret err[fail.Fail].ok{}; }
    var what: str                          = row.name;
    val r:    res[str, format.FormatError] = format.sprint(e.alloc, "`{}` on a storage image of `Unknown` format", row.name);
    if (sel r.ok) { what = r.ok; }
    if (kind == isa.OP_OPERAND_HANDLE_WRITE) {
        ret require(e, mf, spirv.CAP_STORAGE_IMAGE_WRITE_NO_FORMAT, spirv.EXT_STORAGE_WRITE_WITHOUT_FORMAT, what);
    }
    ret require(e, mf, spirv.CAP_STORAGE_IMAGE_READ_NO_FORMAT, spirv.EXT_STORAGE_READ_WITHOUT_FORMAT, what);
}

# the parameter of an operand a literal's value brings, against the kind the value gives
# it: the declaration could not be checked for it, since only the call decides the value
fun op_brought_fits(e: *Emit, mf: *mir.MirFunction, row: *isa.OpDef, i: u32, kind: isa.OpOperandKind,
    param: type.IrTypeId) err[fail.Fail] {
    val opt_: opt[*type.IrType] = type.get(?e.ir.types, param);
    if (sel opt_.none) { ret err[fail.Fail].ok{}; }
    val t:       *type.IrType = opt_.some;
    val integer: bool         = t.kind == type.IRT_INT;
    var why:     str          = nil;
    if (kind == isa.OP_OPERAND_CONSTANT && !ir_integer_constant(e, t, 0)) {
        why = "is an integer constant the literal's value brings, so its parameter must be an integer, a vector of integers or an array of them";
    }
    or ((kind == isa.OP_OPERAND_LITERAL || kind == isa.OP_OPERAND_BOOL || kind == isa.OP_OPERAND_SCOPE || kind == isa.OP_OPERAND_SEMANTICS) && !integer) {
        why = "is a word or a scalar constant the literal's value brings, so its parameter must be an integer";
    }
    or (kind == isa.OP_OPERAND_VALUE && (t.kind == type.IRT_PTR || t.kind == type.IRT_HANDLE)) {
        why = "is an ordinary value the literal's value brings, so its parameter cannot be a pointer or a handle";
    }
    if (why == nil) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{reject_at(e, dkind.OP_SIGNATURE, mir.refusal_loc(mf, e.cur_instr), op_operand_text(e, row, i, why))};
}

# whether `t` is an integer, a vector of integers or an array of either: what an integer constant id can be
fun ir_integer_constant(e: *Emit, t: *type.IrType, depth: u32) bool {
    if (t.kind == type.IRT_INT || ir_integer_vector(e, t)) { ret true; }
    if (t.kind != type.IRT_ARRAY || depth > 8)             { ret false; }
    val el: opt[*type.IrType] = type.get(?e.ir.types, t.data.array_.element);
    ret sel el.some && ir_integer_constant(e, el.some, depth + 1);
}

fun ir_integer_vector(e: *Emit, t: *type.IrType) bool {
    if (t.kind != type.IRT_VECTOR) { ret false; }
    val el: opt[*type.IrType] = type.get(?e.ir.types, t.data.vector_.element);
    ret sel el.some && el.some.kind == type.IRT_INT;
}

# the word operand `i` of an `op` call contributes, written as `kind` says
fun op_operand(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr, row: *isa.OpDef,
    i: u32, kind: isa.OpOperandKind, param: type.IrTypeId) res[u32, fail.Fail] {
    val op: *mir.MirOperand = ?mi.operands[i + 2];
    if (isa.op_kind_is_pointer(kind)) { ret op_pointer_operand(e, mf, vm, row, i, op, param); }
    if (kind == isa.OP_OPERAND_BOOL) {
        if (op.kind == mir.MIR_OP_IMM) { ret res[u32, fail.Fail].ok{types.const_bool(e.tt, op.imm != 0)}; }
        val c: u32 = read_condition(e, vm, op, type.byte_size_for_machine(?e.ir.types, param, e.layout) * 8);
        if (c == 0) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: an `op` truth operand has no value to test")}; }
        ret res[u32, fail.Fail].ok{c};
    }
    if (kind == isa.OP_OPERAND_CONSTANT && op.kind != mir.MIR_OP_IMM) {
        val c: u32 = constant_operand(e, mf, vm, op, ir_value_spv_type(e, param), 0);
        if (c != 0) { ret res[u32, fail.Fail].ok{c}; }
    }
    if (isa.op_kind_is_constant(kind) || kind == isa.OP_OPERAND_LITERAL) {
        if (op.kind != mir.MIR_OP_IMM) {
            ret res[u32, fail.Fail].err{reject_at(e, dkind.OP_OPERAND_NOT_CONSTANT, mir.refusal_loc(mf, e.cur_instr),
                op_operand_text(e, row, i, "is an integer constant the instruction takes by value (a scope, memory semantics, an operand mask or a constant offset), and this argument is not a constant by emission: pass a literal or a constant, not a value computed at run time"))};
        }
        if (kind == isa.OP_OPERAND_LITERAL) {
            if (op.imm < -2147483648 || op.imm > 4294967295) {
                ret res[u32, fail.Fail].err{reject_at(e, dkind.OP_OPERAND_NOT_CONSTANT, mir.refusal_loc(mf, e.cur_instr),
                    op_operand_text(e, row, i, "is a literal word written inline, and this constant does not fit one 32-bit word"))};
            }
            ret res[u32, fail.Fail].ok{(op.imm & 0xFFFFFFFF)::u32};
        }
        val mr: err[fail.Fail] = require_memory_operand(e, mf, row, kind, (op.imm & 0xFFFFFFFF)::u32);
        if (sel mr.err) { ret res[u32, fail.Fail].err{mr.err}; }
    }
    ret read_value(e, mf, vm, op, ir_value_spv_type(e, param), mi.memory_flags);
}

# a memory scope or semantics value held to the memory model the module declares: under
# the Vulkan model the Device scope needs vulkanMemoryModelDeviceScope, and under GLSL450
# the QueueFamily scope and the availability, visibility and volatile semantics, which
# only the Vulkan model defines, need its feature. SequentiallyConsistent semantics are
# refused in every Vulkan environment and under the Vulkan model, which define no such
# order (VUID-StandaloneSpirv-MemorySemantics-10866)
fun require_memory_operand(e: *Emit, mf: *mir.MirFunction, row: *isa.OpDef, kind: isa.OpOperandKind, value: u32) err[fail.Fail] {
    if (kind == isa.OP_OPERAND_SEMANTICS && (value & spirv.SEMANTICS_SEQ_CST) != 0
        && (e.vulkan_mm || e.tgt.identity.env_id != isa.ENV_NONE)) {
        val r: res[str, format.FormatError] = format.sprint(e.alloc,
            "`{}` with SequentiallyConsistent memory semantics is not allowed in a Vulkan environment (VUID-StandaloneSpirv-MemorySemantics-10866): Vulkan defines no sequentially consistent order, so use Acquire, Release or AcquireRelease",
            row.name);
        if (sel r.err) { ret err[fail.Fail].err{fail.format_refused(r.err)}; }
        ret err[fail.Fail].err{reject_at(e, dkind.OP_OPERAND_VALUE, mir.refusal_loc(mf, e.cur_instr), r.ok)};
    }
    var capability: u32 = isa.NO_OP_CAPABILITY;
    var requires:   u64 = 0;
    var what:       str = nil;
    if (kind == isa.OP_OPERAND_SCOPE && e.vulkan_mm && value == spirv.SCOPE_DEVICE) {
        capability = spirv.CAP_VULKAN_MEMORY_MODEL_DEVICE_SCOPE;
        requires   = spirv.EXT_VULKAN_MEMORY_MODEL_DEVICE_SCOPE;
        what       = "with the Device memory scope under the Vulkan memory model";
    }
    or (kind == isa.OP_OPERAND_SCOPE && !e.vulkan_mm && value == spirv.SCOPE_QUEUE_FAMILY) {
        requires = spirv.EXT_VULKAN_MEMORY_MODEL;
        what     = "with the QueueFamily memory scope, which only the Vulkan memory model defines,";
    }
    or (kind == isa.OP_OPERAND_SEMANTICS && !e.vulkan_mm && (value & spirv.SEMANTICS_VULKAN_ONLY) != 0) {
        requires = spirv.EXT_VULKAN_MEMORY_MODEL;
        what     = "with MakeAvailable, MakeVisible or Volatile memory semantics, which only the Vulkan memory model defines,";
    }
    if (what == nil) { ret err[fail.Fail].ok{}; }
    var use: str                          = what;
    val r:   res[str, format.FormatError] = format.sprint(e.alloc, "`{}` {}", row.name, what);
    if (sel r.ok) { use = r.ok; }
    ret require(e, mf, capability, requires, use);
}

# the constant id of `want_ty` an `op` argument is by emission, 0 when it is not one: an
# immediate, a module-scope `val`, a register whose one definition in the function
# builds a vector from constants or copies one, or an aggregate passed through a
# temporary written whole by constants. the register's own load would be a value, not
# a constant id
fun constant_operand(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, op: *mir.MirOperand, want_ty: u32, depth: u32) u32 {
    if (want_ty == 0 || depth > 8)                                                           { ret 0; }
    if (op.kind == mir.MIR_OP_IMM)                                                           { ret immediate(e, want_ty, op.imm); }
    if (op.kind == mir.MIR_OP_SYM && op.sym_off == 0)                                        { ret constant_global(e, op.sym, want_ty); }
    if (op.kind == mir.MIR_OP_MEM && depth == 0)                                             { ret constant_temporary(e, mf, vm, op, want_ty, depth); }
    if (op.kind != mir.MIR_OP_VREG || op.vreg.n >= vm.n || vm.type_id[op.vreg.n] != want_ty) { ret 0; }
    val def: *mir.MirInstr = sole_definition(mf, op.vreg.n);
    if (def == nil)                                           { ret 0; }
    if (def.opcode == mir.MIR_LOAD && def.operand_count == 2) { ret constant_load(e, ?def.operands[1], want_ty); }
    if (is_reg_copy(def))                                     { ret constant_operand(e, mf, vm, ?def.operands[1], want_ty, depth + 1); }
    if (def.opcode != mir.MIR_VEC_BUILD)                      { ret 0; }
    var lanes:   u32 = 0;
    val lane_ty: u32 = types.vector_value_shape(e.tt, want_ty, ?lanes);
    if (lane_ty == 0 || lanes != def.operand_count - 1 || lanes > types.MAX_VECTOR_COMPONENTS) { ret 0; }
    var parts: [4]u32;
    var k:     u32 = 0;
    for (k < lanes) {
        val lane: *mir.MirOperand = ?def.operands[1 + k];
        if (lane.kind == mir.MIR_OP_IMM) { parts[k] = immediate(e, lane_ty, lane.imm); }
        or                               { parts[k] = constant_operand(e, mf, vm, lane, lane_ty, depth + 1); }
        if (parts[k] == 0)               { ret 0; }
        k = k + 1;
    }
    ret types.const_composite(e.tt, want_ty, ?parts[0], lanes);
}

# one write of a temporary an aggregate constant operand passes: the access path from
# the temporary's address to what it writes, and the store or copy that writes there
rec ConstWrite {
    path:  [8]u32;
    depth: u32;
    mi:    *mir.MirInstr;
}

# the constant id of `want_ty` the temporary an aggregate argument `op` passes holds, 0
# unless the call reading it is its only other use and every write of it precedes the
# call in its block, each a store of a constant or a copy of a module-scope `val`
# reached through constant access chains, together writing every element exactly once.
# a run-time store, a partial or repeated write, a write after the call or any other
# use of its address, which could write it unseen, leaves it a value
fun constant_temporary(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, op: *mir.MirOperand, want_ty: u32, depth: u32) u32 {
    val a: u32 = op.vreg.n;
    if (op.imm != 0 || e.cur_instr == nil || a >= vm.n)                        { ret 0; }
    if (vm.chain_ty[a] != want_ty || vm.chain_sc[a] != spirv.STORAGE_FUNCTION) { ret 0; }
    val def: *mir.MirInstr = address_def(mf, a);
    if (def == nil || def.opcode != mir.MIR_ALLOCA) { ret 0; }
    var cb: u32 = 0;
    var ci: u32 = 0;
    if (!instr_position(mf, e.cur_instr, ?cb, ?ci)) { ret 0; }
    var writes: Vector[ConstWrite] = vector.init[ConstWrite](e.alloc);
    fin { vector.dnit[ConstWrite](?writes); }
    var path: [8]u32;
    if (!collect_writes(e, mf, a, ?path[0], 0, cb, ci, ?writes)) { ret 0; }
    var used: u32 = 0;
    val c:    u32 = constant_at(e, mf, vm, ?writes, ?path[0], 0, want_ty, depth, ?used);
    if (used != writes.len::u32) { ret 0; }
    ret c;
}

# the block and index of `mi` in `mf`
fun instr_position(mf: *mir.MirFunction, mi: *mir.MirInstr, out_block: *u32, out_index: *u32) bool {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            if (?blk.instrs[ii] == mi) {
                @out_block = bi;
                @out_index = ii;
                ret true;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

# every write through address `a`, at `path` of `depth` indices into the temporary,
# into `writes`. false when `a` has a use that is neither such a write preceding the
# call at instruction `ci` of block `cb` nor that call's read of the whole temporary
fun collect_writes(e: *Emit, mf: *mir.MirFunction, a: u32, path: *u32, depth: u32, cb: u32, ci: u32,
    writes: *Vector[ConstWrite]) bool {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            # an allocation's second operand is its frame slot's key, not a register
            if (mi.opcode == mir.MIR_ALLOCA) {
                ii = ii + 1;
                cnt;
            }
            val before: bool = bi == cb && ii < ci;
            var k:      u32  = 0;
            for (k < mi.operand_count) {
                val o: *mir.MirOperand = ?mi.operands[k];
                if ((o.kind != mir.MIR_OP_VREG && o.kind != mir.MIR_OP_MEM) || o.vreg.n != a || (k == 0 && instr_defines_vreg(mi, a))) {
                    k = k + 1;
                    cnt;
                }
                if (mi == e.cur_instr) {
                    if (depth != 0 || o.kind != mir.MIR_OP_MEM || o.imm != 0) { ret false; }
                }
                or (k == 0 && o.kind == mir.MIR_OP_MEM && o.imm == 0 && before
                    && ((mi.opcode == mir.MIR_STORE && mi.operand_count == 2)
                    || (mi.opcode == mir.MIR_MEMCPY && mi.operand_count == 3))) {
                    var w: ConstWrite;
                    var d: u32 = 0;
                    for (d < depth) {
                        w.path[d] = path[d];
                        d         = d + 1;
                    }
                    w.depth = depth;
                    w.mi    = mi;
                    val pr: res[usize, A.Error] = vector.push[ConstWrite](writes, w);
                    if (sel pr.err) { ret false; }
                }
                or (k == 1 && mi.opcode == mir.MIR_GEP && (o.kind == mir.MIR_OP_VREG || o.imm == 0)) {
                    if (!collect_chain_writes(e, mf, mi, path, depth, cb, ci, writes)) { ret false; }
                }
                or { ret false; }
                k = k + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret true;
}

# the writes through access chain `gep`, whose base is the temporary at `path`: each of
# its indices a constant, the leading one 0
fun collect_chain_writes(e: *Emit, mf: *mir.MirFunction, gep: *mir.MirInstr, path: *u32, depth: u32, cb: u32, ci: u32,
    writes: *Vector[ConstWrite]) bool {
    if (gep.operand_count < 4 || gep.operands[0].kind != mir.MIR_OP_VREG)   { ret false; }
    if (gep.operands[2].kind != mir.MIR_OP_IMM || gep.operands[2].imm != 0) { ret false; }
    val count: u32 = gep.operand_count - 3;
    if (depth + count > 8) { ret false; }
    var inner: [8]u32;
    var d:     u32 = 0;
    for (d < depth) {
        inner[d] = path[d];
        d        = d + 1;
    }
    var k: u32 = 0;
    for (k < count) {
        val ix: *mir.MirOperand = ?gep.operands[3 + k];
        if (ix.kind != mir.MIR_OP_IMM || ix.imm < 0 || ix.imm > 0xFFFFFFFF) { ret false; }
        inner[depth + k] = ix.imm::u32;
        k                = k + 1;
    }
    ret collect_writes(e, mf, gep.operands[0].vreg.n, ?inner[0], depth + count, cb, ci, writes);
}

# the constant of `ty` the temporary holds at `path`: the write there, which no write
# beneath it shares, or else a composite of its members, each written so. `used` counts
# the writes it spells, so a write it never reaches, repeated or out of range, is seen
fun constant_at(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, writes: *Vector[ConstWrite], path: *u32, depth: u32,
    ty: u32, cdepth: u32, used: *u32) u32 {
    if (ty == 0) { ret 0; }
    var exact: *ConstWrite = nil;
    var under: bool        = false;
    var i:     usize       = 0;
    for (i < writes.len) {
        val w: *ConstWrite = ?writes.data[i];
        i = i + 1;
        if (w.depth < depth) { cnt; }
        var d:  u32  = 0;
        var on: bool = true;
        for (d < depth && on) {
            on = w.path[d] == path[d];
            d  = d + 1;
        }
        # a repeated write is left unspelled, which the caller's count of them refuses
        if (!on)             { cnt; }
        if (w.depth > depth) { under = true; }
        or                   { exact = w; }
    }
    if (exact != nil) {
        if (under) { ret 0; }
        @used = @used + 1;
        ret write_constant(e, mf, vm, exact.mi, ty, cdepth);
    }
    if (!under || depth >= 8) { ret 0; }
    val n: u32 = types.composite_count(e.tt, ty);
    if (n == 0) { ret 0; }
    val pr: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel pr.err) { ret 0; }
    val parts: *u32 = pr.ok;
    fin { A.deallocate[u32](e.alloc, parts, n::usize); }
    var k: u32 = 0;
    for (k < n) {
        path[depth] = k;
        parts[k]    = constant_at(e, mf, vm, writes, path, depth + 1, types.composite_member(e.tt, ty, k), cdepth, used);
        if (parts[k] == 0) { ret 0; }
        k = k + 1;
    }
    ret types.const_composite(e.tt, ty, parts, n);
}

# the constant of `ty` the store or copy `mi` writes, 0 when it writes none: a store of
# an immediate as wide as a scalar, or of a constant operand, or a copy of the whole of
# a module-scope `val`
fun write_constant(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr, ty: u32, depth: u32) u32 {
    val src: *mir.MirOperand = ?mi.operands[1];
    if (mi.opcode == mir.MIR_STORE) {
        if (src.kind != mir.MIR_OP_IMM) { ret constant_operand(e, mf, vm, src, ty, depth + 1); }
        # a composite has no width of its own, so an immediate fills only a scalar
        if (!types.type_is_bool(e.tt, ty) && mi.width::u32 * 8 != types.type_bits(e.tt, ty)) { ret 0; }
        ret immediate(e, ty, src.imm);
    }
    ret constant_copy(e, mi, ty);
}

# the constant of `ty` the copy `mi` reads, 0 unless it copies the whole of a module-scope `val`
fun constant_copy(e: *Emit, mi: *mir.MirInstr, ty: u32) u32 {
    if (mi.operand_count != 3) { ret 0; }
    val src:  *mir.MirOperand = ?mi.operands[1];
    val size: *mir.MirOperand = ?mi.operands[2];
    if (src.kind != mir.MIR_OP_SYM || src.sym_off != 0 || size.kind != mir.MIR_OP_IMM) { ret 0; }
    val gx: u32 = gl_lookup(e, src.sym);
    if (gx == GL_NONE)                                                                           { ret 0; }
    if (size.imm != type.byte_size_for_machine(gl_types(e, gx), gl_ir(e, gx).ty, e.layout)::i64) { ret 0; }
    ret constant_global(e, src.sym, ty);
}

# the constant id of `want_ty` a module-scope `val` named `sym` spells, 0 when it is none:
# such a value reaches a shader only as a constant, never as a variable it addresses
fun constant_global(e: *Emit, sym: intern.StrId, want_ty: u32) u32 {
    val gx: u32 = gl_lookup(e, sym);
    if (gx == GL_NONE) { ret 0; }
    val g: *ir.Global = gl_ir(e, gx);
    if (g.is_mut || g.is_extern || g.is_import || g.iface != ir.IFACE_NONE) { ret 0; }
    val gt: *type.IrTypeTable = gl_types(e, gx);
    if (global_spv_type(e, gt, g.ty) != want_ty) { ret 0; }
    ret output_initializer(e, gt, g, want_ty);
}

# the constant a whole-value load from `op` reads, 0 unless it names a module-scope `val`
fun constant_load(e: *Emit, op: *mir.MirOperand, want_ty: u32) u32 {
    if (want_ty == 0 || op.kind != mir.MIR_OP_SYM || op.sym_off != 0) { ret 0; }
    ret constant_global(e, op.sym, want_ty);
}

# the one instruction of `mf` that writes register `v`, nil when none or several do
fun sole_definition(mf: *mir.MirFunction, v: u32) *mir.MirInstr {
    var found: *mir.MirInstr = nil;
    var bi:    u32           = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi:     *mir.MirInstr = ?blk.instrs[ii];
            var writes: bool          = mir.instr_defines_shape(mi) && mi.operands[0].kind == mir.MIR_OP_VREG && mi.operands[0].vreg.n == v;
            if (mi.opcode == mir.MIR_VALUE_CALL && mi.operand_count > 1) {
                writes = mi.operands[1].kind == mir.MIR_OP_VREG && mi.operands[1].vreg.n == v;
            }
            if (writes) {
                if (found != nil) { ret nil; }
                found = mi;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret found;
}

# a pointer operand is the argument's own address: an access chain, a function-local
# object or an interface variable, in the storage class that memory lives in
fun op_pointer_operand(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, row: *isa.OpDef, i: u32,
    op: *mir.MirOperand, param: type.IrTypeId) res[u32, fail.Fail] {
    var ty:  u32 = 0;
    var sc:  u32 = 0;
    var ptr: u32 = address(e, vm, op, ?ty, ?sc);
    if (ptr == 0 && op.kind == mir.MIR_OP_SYM && op.sym_off == 0) {
        val gx: u32 = gl_lookup(e, op.sym);
        if (gx != GL_NONE && gl_ir(e, gx).iface != ir.IFACE_NONE) {
            ptr = e.gvar_ids[gx];
            ty  = e.gtype_ids[gx];
        }
    }
    if (ptr == 0 || ty == 0) {
        ret res[u32, fail.Fail].err{reject_at(e, dkind.SPIRV_UNSUPPORTED, mir.refusal_loc(mf, e.cur_instr),
            op_operand_text(e, row, i, "is a pointer, and this argument names no memory the module can address: pass the address of a shader interface variable, a local, or an element or member of one"))};
    }
    # memory holds a narrow integer as itself, where a function carries it wider
    val want: u32 = ir_pointee_spv_type(e, param);
    if (want == 0 || (want != ty && !memory_bridged(e, ty, want))) {
        ret res[u32, fail.Fail].err{reject_at(e, dkind.SPIRV_UNSUPPORTED, mir.refusal_loc(mf, e.cur_instr),
            op_operand_text(e, row, i, "is a pointer whose pointee is not the type the argument addresses in its storage class: an explicitly laid out block member and its function-local counterpart are distinct SPIR-V types, so point at a scalar or vector element"))};
    }
    ret res[u32, fail.Fail].ok{ptr};
}

fun ir_pointee_spv_type(e: *Emit, ptr: type.IrTypeId) u32 {
    val opt_: opt[*type.IrType] = type.get(?e.ir.types, ptr);
    if (sel opt_.none)                                                            { ret 0; }
    if (opt_.some.kind != type.IRT_PTR || opt_.some.data.pointee == type.IRT_NIL) { ret 0; }
    ret ir_value_spv_type(e, opt_.some.data.pointee);
}

fun op_operand_text(e: *Emit, row: *isa.OpDef, i: u32, why: str) str {
    val r: res[str, format.FormatError] = format.sprint(e.alloc, "operand {} of `{}` {}", i + 1, row.name, why);
    if (sel r.err) { ret why; }
    ret r.ok;
}

fun ext_set_id(e: *Emit, set: u32) u32 {
    if (set >= 8)            { ret 0; }
    if (e.ext_ids[set] != 0) { ret e.ext_ids[set]; }
    val name: str = defs.set_import_name(set::u8);
    if (str_len(name) == 0::usize) { ret 0; }
    val id: u32 = spirv.ext_inst_import(e.b, name);
    e.ext_ids[set::u32] = id;
    ret id;
}

fun ir_function_record(irmod: *ir.Module, name: intern.StrId) *ir.Function {
    var i: u32 = 0;
    for (i < irmod.function_len) {
        if (irmod.functions[i].name == name) { ret ?irmod.functions[i]; }
        i = i + 1;
    }
    ret nil;
}

fun read_operand(e: *Emit, vm: *VMaps, op: *mir.MirOperand, want_ty: u32) u32 {
    if (op.kind == mir.MIR_OP_VREG) {
        val v: u32 = op.vreg.n;
        if (v < vm.n && vm.opq_var[v] != 0) {
            val fresh: u32 = spirv.alloc_id(e.b);
            var ol:    [3]u32;
            ol[0] = vm.type_id[v];
            ol[1] = fresh;
            ol[2] = vm.opq_var[v];
            spirv.inst(e.b, ?e.b.functions, spirv.OP_LOAD, ?ol[0], 3);
            ret fresh;
        }
        if (v < vm.n && vm.opq_ssa[v] != 0) { ret vm.opq_ssa[v]; }
        # an access chain from a physical pointer is the physical pointer it computes
        if (v < vm.n && vm.chain_sc[v] == spirv.STORAGE_PHYSICAL_STORAGE_BUFFER) { ret vm.chain_id[v]; }
        if (v >= vm.n || vm.var_id[v] == 0) {
            e.b.err = true;
            ret 0;
        }
        val result: u32 = spirv.alloc_id(e.b);
        var lo:     [3]u32;
        lo[0] = vm.type_id[v];
        lo[1] = result;
        lo[2] = vm.var_id[v];
        spirv.inst(e.b, ?e.b.functions, spirv.OP_LOAD, ?lo[0], 3);
        if (vm.prov != nil && (vm.prov[v] & PROV_PHYSICAL) != 0) {
            var sc:      u32 = 0;
            val pointee: u32 = types.pointer_shape(e.tt, vm.type_id[v], ?sc);
            if (pointee != 0 && sc == spirv.STORAGE_PHYSICAL_STORAGE_BUFFER) { mark_physical(e, result, pointee); }
        }
        if (vm.is_bool[v] && want_ty != 0 && !types.type_is_bool(e.tt, want_ty)) {
            ret widen_bool(e, result, want_ty);
        }
        ret result;
    }
    if (op.kind == mir.MIR_OP_IMM) {
        ret immediate(e, want_ty, op.imm);
    }

    e.b.err = true;
    ret 0;
}

fun operand_carries_type(vm: *VMaps, op: *mir.MirOperand) bool {
    if (op.kind != mir.MIR_OP_VREG)                      { ret false; }
    if (op.vreg.n >= vm.n || vm.type_id[op.vreg.n] == 0) { ret false; }
    ret !vm.is_bool[op.vreg.n];
}

fun operand_matches_type(vm: *VMaps, op: *mir.MirOperand, want_ty: u32) bool {
    if (!operand_carries_type(vm, op)) { ret true; }
    ret vm.type_id[op.vreg.n] == want_ty;
}

fun widen_bool(e: *Emit, boolean: u32, want_ty: u32) u32 {
    val one:  u32 = types.const_scalar(e.tt, want_ty, 1, 0);
    val zero: u32 = types.const_scalar(e.tt, want_ty, 0, 0);
    if (one == 0 || zero == 0) {
        e.b.err = true;
        ret 0;
    }
    val result: u32 = spirv.alloc_id(e.b);
    var ops:    [5]u32;
    ops[0] = want_ty;
    ops[1] = result;
    ops[2] = boolean;
    ops[3] = one;
    ops[4] = zero;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECT, ?ops[0], 5);
    ret result;
}

fun immediate(e: *Emit, want_ty: u32, imm: i64) u32 {
    var ty: u32 = want_ty;
    if (ty == 0) { ty = types.type_int(e.tt, e.tgt.model.gpr_width * 8); }
    if (e.physical) {
        if (physical_type(e, ty)) { ret pointer_constant(e, ty, imm); }
    }
    if (types.type_is_bool(e.tt, ty)) { ret types.const_bool(e.tt, imm != 0); }
    val pattern: u64 = imm::u64;
    ret types.const_scalar(e.tt, ty, (pattern & 0xFFFFFFFF)::u32, ((pattern >> 32) & 0xFFFFFFFF)::u32);
}

fun physical_type(e: *Emit, ty: u32) bool {
    var sc: u32 = 0;
    ret types.pointer_shape(e.tt, ty, ?sc) != 0 && sc == spirv.STORAGE_PHYSICAL_STORAGE_BUFFER;
}

# a physical pointer constant, `nil` or an integer literal, made from the address it is
fun pointer_constant(e: *Emit, ty: u32, imm: i64) u32 {
    val bits:   u32 = immediate(e, types.type_int(e.tt, 64), imm);
    val result: u32 = spirv.alloc_id(e.b);
    var words:  [3]u32;
    words[0] = ty;
    words[1] = result;
    words[2] = bits;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_CONVERT_U_TO_PTR, ?words[0], 3);
    ret result;
}

fun store_vreg(e: *Emit, vm: *VMaps, vreg: u32, value: u32) err[fail.Fail] {
    if (vreg < vm.n && vm.type_id[vreg] != 0 && types.type_is_opaque(e.tt, vm.type_id[vreg])) {
        vm.opq_ssa[vreg] = value;
        ret err[fail.Fail].ok{};
    }
    if (vreg >= vm.n || vm.var_id[vreg] == 0) {
        ret emit_fail(e, "spirv.emit: store to an undeclared vreg");
    }
    var so: [2]u32;
    so[0] = vm.var_id[vreg];
    so[1] = value;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_STORE, ?so[0], 2);
    ret err[fail.Fail].ok{};
}

# `shift` names the second operand a shift count, which is typed by its own
# operand rather than the result: a shift's count may be any integer width
fun emit_binary(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, op_code: u32, shift: bool) err[fail.Fail] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed binary instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: binary result vreg out of range"); }
    val ty: u32 = vm.type_id[dst];
    if (!operand_matches_type(vm, ?mi.operands[1], ty)) {
        ret emit_fail(e, "spirv.emit: binary instruction mixes operand types");
    }
    var b_ty: u32 = ty;
    if (shift && operand_carries_type(vm, ?mi.operands[2])) {
        b_ty = vm.type_id[mi.operands[2].vreg.n];
        if (types.type_is_float(e.tt, b_ty) || types.type_is_opaque(e.tt, b_ty)) {
            ret emit_fail(e, "spirv.emit: shift count is not an integer");
        }
    }
    or (!operand_matches_type(vm, ?mi.operands[2], ty)) {
        ret emit_fail(e, "spirv.emit: binary instruction mixes operand types");
    }
    val a: u32 = read_operand(e, vm, ?mi.operands[1], ty);
    val b: u32 = read_operand(e, vm, ?mi.operands[2], b_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in binary instruction"); }
    val row: *ops.CoreOp = ops.core(op_code);
    if (row.arity != 2) { ret emit_fail(e, "spirv.emit: a binary instruction was mapped to an opcode whose row is not two operands"); }
    val result: u32 = spirv.alloc_id(e.b);
    var words:  [4]u32;
    words[0] = vm.type_id[dst];
    words[1] = result;
    words[2] = a;
    words[3] = b;
    spirv.inst(e.b, ?e.b.functions, op_code, ?words[0], ops.operand_words(row));
    ret store_vreg(e, vm, dst, result);
}

# a lane-wise shift saturates each lane as the scalar shift does (#3756), and
# OpShift* leaves a component shifted by its width or more undefined (#3852).
# the fill a lane saturates to is 0, or for an arithmetic shift the shift by
# width - 1. a constant count is the bare shift, or the fill when it is out of
# range. any other count keeps the shift where the count is below the width
# and selects the fill elsewhere. a uniform count is one scalar, splatted
# since OpShift* shifts by a count per component
fun emit_vector_shift(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, op_code: u32) err[fail.Fail] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed vector shift instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: vector shift result vreg out of range"); }
    val ty:      u32 = vm.type_id[dst];
    val lanes:   u32 = mir.vec_lane_count(mi.vec_lane);
    val bits:    u32 = mir.vec_lane_elem_bytes(mi.vec_lane)::u32 * 8;
    val lane_ty: u32 = types.type_int(e.tt, bits);
    val bvec_ty: u32 = types.type_vector(e.tt, types.type_bool(e.tt), lanes);
    if (ty == 0 || lane_ty == 0 || bvec_ty == 0 || !operand_matches_type(vm, ?mi.operands[1], ty)) {
        ret unsupported(e, unsupported_value_type(e, mi));
    }
    val a: u32 = read_operand(e, vm, ?mi.operands[1], ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in vector shift"); }

    val cnt: *mir.MirOperand = ?mi.operands[2];
    if (cnt.kind == mir.MIR_OP_IMM) {
        if (cnt.imm < 0 || cnt.imm >= bits::i64) {
            val out: u32 = shift_fill(e, op_code, ty, lanes, bits, a);
            if (out == 0) { ret emit_fail(e, "spirv.emit: could not build a vector shift fill"); }
            ret store_vreg(e, vm, dst, out);
        }
        val by: u32 = mask_splat(e, ty, lanes, cnt.imm::u32, 0);
        if (by == 0) { ret emit_fail(e, "spirv.emit: could not build a vector shift count constant"); }
        ret store_vreg(e, vm, dst, shift_words(e, op_code, ty, a, by));
    }
    var c: u32 = 0;
    if (operand_carries_type(vm, cnt) && vm.type_id[cnt.vreg.n] == ty) {
        c = read_operand(e, vm, cnt, ty);
    }
    or {
        var one: u32 = read_operand(e, vm, cnt, lane_ty);
        if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable count in vector shift"); }
        if (operand_carries_type(vm, cnt) && vm.type_id[cnt.vreg.n] != lane_ty) {
            val from: u32 = vm.type_id[cnt.vreg.n];
            # a narrower count widens to the lane by its value; a wider one
            # would lose the bits that saturate it
            if (types.type_is_float(e.tt, from) || types.type_is_opaque(e.tt, from)
                || types.type_bits(e.tt, from) == 0 || types.type_bits(e.tt, from) > bits) {
                ret emit_fail(e, "spirv.emit: a uniform shift count is not an integer as wide as the lane or narrower");
            }
            val cv: u32 = spirv.alloc_id(e.b);
            var uw: [3]u32;
            uw[0] = lane_ty;
            uw[1] = cv;
            uw[2] = one;
            spirv.inst(e.b, ?e.b.functions, spirv.OP_U_CONVERT, ?uw[0], 3);
            one = cv;
        }
        c = spirv.alloc_id(e.b);
        var cw: [6]u32;
        cw[0] = ty;
        cw[1] = c;
        var i: u32 = 0;
        for (i < lanes) {
            cw[2 + i] = one;
            i         = i + 1;
        }
        spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_CONSTRUCT, ?cw[0], 2 + lanes);
    }
    val width: u32 = mask_splat(e, ty, lanes, bits, 0);
    if (e.b.err || c == 0 || width == 0) { ret emit_fail(e, "spirv.emit: unreadable count in vector shift"); }

    val below: u32 = spirv.alloc_id(e.b);
    var lw:    [4]u32;
    lw[0] = bvec_ty;
    lw[1] = below;
    lw[2] = c;
    lw[3] = width;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_U_LESS_THAN, ?lw[0], 4);
    val shifted: u32 = shift_words(e, op_code, ty, a, c);
    val fill:    u32 = shift_fill(e, op_code, ty, lanes, bits, a);
    if (fill == 0) { ret emit_fail(e, "spirv.emit: could not build a vector shift fill"); }
    val result: u32 = spirv.alloc_id(e.b);
    var sw:     [5]u32;
    sw[0] = ty;
    sw[1] = result;
    sw[2] = below;
    sw[3] = shifted;
    sw[4] = fill;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECT, ?sw[0], 5);
    ret store_vreg(e, vm, dst, result);
}

# what a lane shifted by its width or more answers: 0, or the sign fill
fun shift_fill(e: *Emit, op_code: u32, ty: u32, lanes: u32, bits: u32, a: u32) u32 {
    if (op_code != spirv.OP_SHIFT_RIGHT_ARITHMETIC) { ret mask_splat(e, ty, lanes, 0, 0); }
    val top: u32 = mask_splat(e, ty, lanes, bits - 1, 0);
    if (top == 0) { ret 0; }
    ret shift_words(e, op_code, ty, a, top);
}

fun shift_words(e: *Emit, op_code: u32, ty: u32, a: u32, by: u32) u32 {
    val result: u32 = spirv.alloc_id(e.b);
    var words:  [4]u32;
    words[0] = ty;
    words[1] = result;
    words[2] = a;
    words[3] = by;
    spirv.inst(e.b, ?e.b.functions, op_code, ?words[0], 4);
    ret result;
}

fun emit_unary(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, op_code: u32) err[fail.Fail] {
    if (mi.operand_count != 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed unary instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: unary result vreg out of range"); }
    val a: u32 = read_operand(e, vm, ?mi.operands[1], vm.type_id[dst]);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in unary instruction"); }
    val row: *ops.CoreOp = ops.core(op_code);
    if (row.arity != 1) { ret emit_fail(e, "spirv.emit: a unary instruction was mapped to an opcode whose row is not one operand"); }
    val result: u32 = spirv.alloc_id(e.b);
    var words:  [3]u32;
    words[0] = vm.type_id[dst];
    words[1] = result;
    words[2] = a;
    spirv.inst(e.b, ?e.b.functions, op_code, ?words[0], ops.operand_words(row));
    ret store_vreg(e, vm, dst, result);
}

fun emit_compare(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, op_code: u32) err[fail.Fail] {
    if (mir.vec_lane_is_vector(mi.vec_lane)) {
        ret emit_vector_compare(e, vm, mi, op_code);
    }
    var cbits: u32 = mi.width::u32 * 8;
    if (cbits == 0) { cbits = e.tgt.model.gpr_width * 8; }
    val cmp_ty: u32 = types.type_int(e.tt, carrier_bits(e, cbits));
    if (cmp_ty == 0) {
        ret unsupported(e, "unsupported comparison width in the SPIR-V target");
    }
    ret emit_compare_typed(e, vm, mi, op_code, cmp_ty, cbits);
}

fun emit_vector_compare(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, op_code: u32) err[fail.Fail] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed vector comparison instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: comparison result vreg out of range"); }

    val lanes:      u32 = mir.vec_lane_count(mi.vec_lane);
    val operand_ty: u32 = vector_type_of(e, mi.vec_lane, false);
    val bvec_ty:    u32 = types.type_vector(e.tt, types.type_bool(e.tt), lanes);
    val mask_ty:    u32 = vm.type_id[dst];
    if (operand_ty == 0 || bvec_ty == 0 || mask_ty == 0) {
        ret unsupported(e, unsupported_value_type(e, mi));
    }

    val a: u32 = read_operand(e, vm, ?mi.operands[1], operand_ty);
    val b: u32 = read_operand(e, vm, ?mi.operands[2], operand_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in vector comparison"); }

    val row: *ops.CoreOp = ops.core(op_code);
    if (row.arity != 2) { ret emit_fail(e, "spirv.emit: a comparison was mapped to an opcode whose row is not two operands"); }
    val bvec: u32 = spirv.alloc_id(e.b);
    var cops: [4]u32;
    cops[0] = bvec_ty;
    cops[1] = bvec;
    cops[2] = a;
    cops[3] = b;
    spirv.inst(e.b, ?e.b.functions, op_code, ?cops[0], ops.operand_words(row));

    val ones:  u32 = mask_splat(e, mask_ty, lanes, 0xFFFFFFFF, 0xFFFFFFFF);
    val zeros: u32 = mask_splat(e, mask_ty, lanes, 0, 0);
    if (ones == 0 || zeros == 0) {
        ret emit_fail(e, "spirv.emit: could not build a vector comparison mask constant");
    }

    val result: u32 = spirv.alloc_id(e.b);
    var sops:   [5]u32;
    sops[0] = mask_ty;
    sops[1] = result;
    sops[2] = bvec;
    sops[3] = ones;
    sops[4] = zeros;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECT, ?sops[0], 5);
    ret store_vreg(e, vm, dst, result);
}

fun mask_splat(e: *Emit, vec_ty: u32, lanes: u32, lo: u32, hi: u32) u32 {
    var count:   u32 = 0;
    val lane_ty: u32 = types.vector_shape(e.tt, vec_ty, ?count);
    if (lane_ty == 0 || count == 0 || count > types.MAX_VECTOR_COMPONENTS) { ret 0; }
    val lane:  u32 = types.const_scalar(e.tt, lane_ty, lo, hi);
    var parts: [4]u32;
    var i:     u32 = 0;
    for (i < count) {
        parts[i] = lane;
        i        = i + 1;
    }
    ret types.const_composite(e.tt, vec_ty, ?parts[0], count);
}

fun emit_vec_extract(e: *Emit, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed vector extract instruction");
    }
    if (mi.operands[2].kind != mir.MIR_OP_IMM) {
        ret unsupported(e, "a runtime vector lane index is not supported by the SPIR-V target");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: vector extract result vreg out of range"); }
    val vec_ty: u32 = operand_vector_type(e, vm, mi, ?mi.operands[1]);
    if (vec_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
    val src: u32 = read_operand(e, vm, ?mi.operands[1], vec_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in vector extract"); }

    var lanes:   u32 = 0;
    var lane_ty: u32 = types.vector_value_shape(e.tt, vec_ty, ?lanes);
    if (lane_ty == 0) { lane_ty = vm.type_id[dst]; }
    val result: u32 = spirv.alloc_id(e.b);
    var ops:    [4]u32;
    ops[0] = lane_ty;
    ops[1] = result;
    ops[2] = src;
    ops[3] = mi.operands[2].imm::u32;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_EXTRACT, ?ops[0], 4);
    ret store_vreg(e, vm, dst, lane_width_as(e, result, lane_ty, vm.type_id[dst]));
}

# the scalar a vector lane of `lane_ty` is held in once extracted: an integer
# lane at its carrier, since a lane keeps its declared width as a composite
# member does (#4302)
fun carried_lane_type(e: *Emit, lane_ty: u32) u32 {
    if (lane_ty == 0 || types.type_is_float(e.tt, lane_ty) || types.type_is_bool(e.tt, lane_ty)) { ret lane_ty; }
    ret types.type_int(e.tt, carrier_bits(e, types.type_bits(e.tt, lane_ty)));
}

# an integer moved between a lane's width and its carrier's: OpUConvert where
# the two differ. a narrowing keeps the low bits, which hold the value
fun lane_width_as(e: *Emit, value: u32, from_ty: u32, to_ty: u32) u32 {
    if (value == 0 || from_ty == to_ty || from_ty == 0 || to_ty == 0) { ret value; }
    if (types.type_is_float(e.tt, from_ty) || types.type_is_float(e.tt, to_ty)
        || types.type_bits(e.tt, from_ty) == 0 || types.type_bits(e.tt, to_ty) == 0) { ret value; }
    val result: u32 = spirv.alloc_id(e.b);
    var ops:    [3]u32;
    ops[0] = to_ty;
    ops[1] = result;
    ops[2] = value;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_U_CONVERT, ?ops[0], 3);
    ret result;
}

# a scalar operand read as a vector lane of `lane_ty`
fun read_lane(e: *Emit, vm: *VMaps, op: *mir.MirOperand, lane_ty: u32) u32 {
    if (!operand_carries_type(vm, op)) { ret read_operand(e, vm, op, lane_ty); }
    val own: u32 = vm.type_id[op.vreg.n];
    ret lane_width_as(e, read_operand(e, vm, op, own), own, lane_ty);
}

fun emit_vec_insert(e: *Emit, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count != 4 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed vector insert instruction");
    }
    if (mi.operands[2].kind != mir.MIR_OP_IMM) {
        ret unsupported(e, "a runtime vector lane index is not supported by the SPIR-V target");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: vector insert result vreg out of range"); }
    val vec_ty: u32 = vm.type_id[dst];
    if (vec_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
    var lanes:   u32 = 0;
    val lane_ty: u32 = types.vector_value_shape(e.tt, vec_ty, ?lanes);
    if (lane_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }

    val src:  u32 = read_operand(e, vm, ?mi.operands[1], vec_ty);
    val lane: u32 = read_lane(e, vm, ?mi.operands[3], lane_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in vector insert"); }

    val result: u32 = spirv.alloc_id(e.b);
    var ops:    [5]u32;
    ops[0] = vec_ty;
    ops[1] = result;
    ops[2] = lane;
    ops[3] = src;
    ops[4] = mi.operands[2].imm::u32;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_INSERT, ?ops[0], 5);
    ret store_vreg(e, vm, dst, result);
}

fun emit_vec_build(e: *Emit, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed vector build instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: vector build result vreg out of range"); }
    val vec_ty: u32 = vm.type_id[dst];
    if (vec_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
    var lanes:   u32 = 0;
    val lane_ty: u32 = types.vector_value_shape(e.tt, vec_ty, ?lanes);
    if (lane_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }

    val given: u32 = mi.operand_count - 1;
    if (given != lanes) {
        ret emit_fail(e, "spirv.emit: vector build lane count does not match its vector type");
    }
    val ro: res[*u32, A.Error] = A.allocate[u32](e.alloc, (given + 2)::usize);
    if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
    val ops: *u32 = ro.ok;
    ops[0] = vec_ty;
    val result: u32 = spirv.alloc_id(e.b);
    ops[1] = result;
    var i: u32 = 0;
    for (i < given) {
        ops[2 + i] = read_lane(e, vm, ?mi.operands[1 + i], lane_ty);
        i          = i + 1;
    }
    if (e.b.err) {
        A.deallocate[u32](e.alloc, ops, (given + 2)::usize);
        ret emit_fail(e, "spirv.emit: unreadable operand in vector build");
    }

    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_CONSTRUCT, ops, 2 + given);
    A.deallocate[u32](e.alloc, ops, (given + 2)::usize);
    ret store_vreg(e, vm, dst, result);
}

fun operand_vector_type(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, op: *mir.MirOperand) u32 {
    if (op.kind == mir.MIR_OP_VREG && op.vreg.n < vm.n && vm.type_id[op.vreg.n] != 0) {
        ret vm.type_id[op.vreg.n];
    }
    if (!mir.vec_lane_is_vector(mi.vec_lane)) { ret 0; }
    ret vector_type_of(e, mi.vec_lane, false);
}

fun emit_float_compare(e: *Emit, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    var fbits: u32 = mi.width::u32 * 8;
    if (fbits != 16 && fbits != 32 && fbits != 64) {
        ret unsupported(e, "unsupported float comparison width in the SPIR-V target");
    }
    val op_code: u32 = ops.float_compare(mi.src_width);
    if (op_code == 0) { ret unsupported(e, "unknown float comparison condition in the SPIR-V target"); }
    ret emit_compare_typed(e, vm, mi, op_code, types.type_float(e.tt, fbits), 0);
}

fun emit_compare_typed(e: *Emit, vm: *VMaps, mi: *mir.MirInstr,
    op_code: u32, operand_ty: u32, bits: u32) err[fail.Fail] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed comparison instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: comparison result vreg out of range"); }
    if (!operand_matches_type(vm, ?mi.operands[1], operand_ty)
        || !operand_matches_type(vm, ?mi.operands[2], operand_ty)) {
        ret emit_fail(e, "spirv.emit: comparison mixes operand types");
    }
    val signed: bool = signed_compare(op_code);
    val a:      u32  = read_narrow(e, vm, ?mi.operands[1], operand_ty, bits, signed);
    val b:      u32  = read_narrow(e, vm, ?mi.operands[2], operand_ty, bits, signed);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in comparison"); }
    val row: *ops.CoreOp = ops.core(op_code);
    if (row.arity != 2) { ret emit_fail(e, "spirv.emit: a comparison was mapped to an opcode whose row is not two operands"); }
    val bool_ty: u32 = types.type_bool(e.tt);
    val result:  u32 = spirv.alloc_id(e.b);
    var words:   [4]u32;
    words[0] = bool_ty;
    words[1] = result;
    words[2] = a;
    words[3] = b;
    spirv.inst(e.b, ?e.b.functions, op_code, ?words[0], ops.operand_words(row));
    ret store_vreg(e, vm, dst, result);
}

fun signed_compare(op_code: u32) bool {
    ret op_code == spirv.OP_S_LESS_THAN || op_code == spirv.OP_S_LESS_THAN_EQUAL;
}

# a select is OpSelect on a boolean: the folded compare's, a boolean
# condition as it is, or an integer condition tested against zero (#3346)
fun emit_select(e: *Emit, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    val fused: bool = mi.opcode == mir.MIR_SELECT_CMP;
    var need:  u32  = 4;
    var ai:    u32  = 2;
    if (fused) {
        need = 6;
        ai   = 3;
    }
    if (mi.operand_count != need || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed select instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: select result vreg out of range"); }
    val res_ty:  u32 = vm.type_id[dst];
    val bool_ty: u32 = types.type_bool(e.tt);
    if (res_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }

    var cbits: u32 = mi.src_width::u32 * 8;
    if (cbits == 0) { cbits = e.tgt.model.gpr_width * 8; }
    val cmp_ty: u32 = types.type_int(e.tt, carrier_bits(e, cbits));
    if (cmp_ty == 0) { ret unsupported(e, "unsupported select condition width in the SPIR-V target"); }

    var cond: u32 = 0;
    var cw:   [4]u32;
    if (fused) {
        val m: *ops.MirMap = ops.map_of(mi.operands[5].imm::mir.MirOpcode);
        if (m == nil || m.shape != ops.SH_COMPARE) { ret emit_fail(e, "spirv.emit: a select names no integer compare"); }
        val signed: bool = signed_compare(ops.select(m, false));
        cw[2] = read_narrow(e, vm, ?mi.operands[1], cmp_ty, cbits, signed);
        cw[3] = read_narrow(e, vm, ?mi.operands[2], cmp_ty, cbits, signed);
        cond  = spirv.alloc_id(e.b);
        cw[0] = bool_ty;
        cw[1] = cond;
        spirv.inst(e.b, ?e.b.functions, ops.select(m, false), ?cw[0], 4);
    }
    or (mi.operands[1].kind == mir.MIR_OP_VREG && mi.operands[1].vreg.n < vm.n && vm.is_bool[mi.operands[1].vreg.n]) {
        cond = read_operand(e, vm, ?mi.operands[1], bool_ty);
    }
    or {
        cw[2] = read_narrow(e, vm, ?mi.operands[1], cmp_ty, cbits, false);
        cw[3] = immediate(e, cmp_ty, 0);
        cond  = spirv.alloc_id(e.b);
        cw[0] = bool_ty;
        cw[1] = cond;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_I_NOT_EQUAL, ?cw[0], 4);
    }
    val a: u32 = read_operand(e, vm, ?mi.operands[ai], res_ty);
    val b: u32 = read_operand(e, vm, ?mi.operands[ai + 1], res_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in select"); }
    val result: u32 = spirv.alloc_id(e.b);
    var sw:     [5]u32;
    sw[0] = res_ty;
    sw[1] = result;
    sw[2] = cond;
    sw[3] = a;
    sw[4] = b;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECT, ?sw[0], 5);
    ret store_vreg(e, vm, dst, result);
}

# the unsigned compare selects all ones or zero of the result type (#3885)
fun emit_compare_mask(e: *Emit, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed compare-to-mask instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: compare-to-mask result vreg out of range"); }
    var cbits: u32 = mi.src_width::u32 * 8;
    if (cbits == 0) { cbits = e.tgt.model.gpr_width * 8; }
    val cmp_ty:  u32 = types.type_int(e.tt, carrier_bits(e, cbits));
    val mask_ty: u32 = vm.type_id[dst];
    if (cmp_ty == 0 || mask_ty == 0) {
        ret unsupported(e, "unsupported compare-to-mask width in the SPIR-V target");
    }
    val a: u32 = read_narrow(e, vm, ?mi.operands[1], cmp_ty, cbits, false);
    val b: u32 = read_narrow(e, vm, ?mi.operands[2], cmp_ty, cbits, false);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in compare-to-mask"); }
    val below: u32 = spirv.alloc_id(e.b);
    var cw:    [4]u32;
    cw[0] = types.type_bool(e.tt);
    cw[1] = below;
    cw[2] = a;
    cw[3] = b;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_U_LESS_THAN, ?cw[0], 4);
    # all ones at the mask's own width: a literal's bits above it must be zero
    val mbits: u32 = types.type_bits(e.tt, mask_ty);
    var all:   i64 = -1;
    if (mbits > 0 && mbits < 64) { all = ((1::u64 << mbits::u64) - 1):~i64; }
    val ones: u32 = immediate(e, mask_ty, all);
    val zero: u32 = immediate(e, mask_ty, 0);
    if (ones == 0 || zero == 0) { ret emit_fail(e, "spirv.emit: compare-to-mask constants"); }
    val result: u32 = spirv.alloc_id(e.b);
    var sw:     [5]u32;
    sw[0] = mask_ty;
    sw[1] = result;
    sw[2] = below;
    sw[3] = ones;
    sw[4] = zero;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECT, ?sw[0], 5);
    ret store_vreg(e, vm, dst, result);
}

fun emit_convert(e: *Emit, vm: *VMaps, mi: *mir.MirInstr,
    op_code: u32, src_is_float: bool) err[fail.Fail] {
    if (mi.operand_count != 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed conversion instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: conversion result vreg out of range"); }
    # a constant reinterpreted is the constant of the result type with its bits
    if (op_code == spirv.OP_BITCAST && mi.operands[1].kind == mir.MIR_OP_IMM) {
        ret store_vreg(e, vm, dst, immediate(e, vm.type_id[dst], mi.operands[1].imm));
    }
    var src_ty: u32 = 0;
    if (!operand_carries_type(vm, ?mi.operands[1])) {
        var sbits: u32 = mi.src_width::u32 * 8;
        if (sbits == 0)   { sbits = e.tgt.model.gpr_width * 8; }
        if (src_is_float) { src_ty = types.type_float(e.tt, sbits); }
        or                { src_ty = types.type_int(e.tt, carrier_bits(e, sbits)); }
        if (src_ty == 0) {
            ret unsupported(e, "unsupported conversion source width in the SPIR-V target");
        }
    }
    var a: u32 = read_operand(e, vm, ?mi.operands[1], src_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in conversion"); }
    # the type the source was read in: its own, or the one a truth value or a
    # constant was widened to
    var a_ty: u32 = src_ty;
    if (a_ty == 0 && mi.operands[1].kind == mir.MIR_OP_VREG && mi.operands[1].vreg.n < vm.n) {
        a_ty = vm.type_id[mi.operands[1].vreg.n];
    }
    # an extension reads its source at the source width, which a carrier holds
    # with unspecified bits above it (#4302)
    val zext: bool = mi.opcode == mir.MIR_ZEXT || mi.opcode == mir.MIR_UI_TO_FP;
    val sext: bool = mi.opcode == mir.MIR_SEXT || mi.opcode == mir.MIR_SI_TO_FP;
    if ((zext || sext) && mi.operands[1].kind == mir.MIR_OP_VREG) {
        a = narrow_extend(e, a, a_ty, mi.src_width::u32 * 8, sext);
    }
    if (op_code == spirv.OP_BITCAST) {
        val bits: u32 = bits_as(e, a, a_ty, vm.type_id[dst]);
        if (bits == 0 || e.b.err) { ret emit_fail(e, "spirv.emit: a reinterpret between types of unequal widths"); }
        ret store_vreg(e, vm, dst, bits);
    }
    # an integer width change within one carrier is no instruction: OpUConvert
    # and OpSConvert need two widths
    if ((op_code == spirv.OP_U_CONVERT || op_code == spirv.OP_S_CONVERT) && a_ty != 0 && a_ty == vm.type_id[dst]) {
        ret store_vreg(e, vm, dst, a);
    }
    val row: *ops.CoreOp = ops.core(op_code);
    if (row.arity != 1) { ret emit_fail(e, "spirv.emit: a conversion was mapped to an opcode whose row is not one operand"); }
    val result: u32 = spirv.alloc_id(e.b);
    var words:  [3]u32;
    words[0] = vm.type_id[dst];
    words[1] = result;
    words[2] = a;
    spirv.inst(e.b, ?e.b.functions, op_code, ?words[0], ops.operand_words(row));
    ret store_vreg(e, vm, dst, result);
}

# `value` of `from_ty` reinterpreted as `to_ty`. two types alike are one value, as an f16
# and the ir carrier of its bits are under half_memory (#4339). an f16 and the 32-bit
# carrier of a 16-bit integer meet through a vector of two halves, the low one the f16,
# so the reinterpretation needs no 16-bit integer type
fun bits_as(e: *Emit, value: u32, from_ty: u32, to_ty: u32) u32 {
    if (value == 0 || from_ty == to_ty || from_ty == 0 || to_ty == 0) { ret value; }
    if (lanes_in_array(e, from_ty) || lanes_in_array(e, to_ty))       { ret lanes_as(e, value, from_ty, to_ty); }
    val half_from: bool = types.type_is_float(e.tt, from_ty) && types.type_bits(e.tt, from_ty) == 16;
    val half_to:   bool = types.type_is_float(e.tt, to_ty) && types.type_bits(e.tt, to_ty) == 16;
    val wide_from: bool = !types.type_is_float(e.tt, from_ty) && types.type_bits(e.tt, from_ty) == 32;
    val wide_to:   bool = !types.type_is_float(e.tt, to_ty) && types.type_bits(e.tt, to_ty) == 32;
    if (half_from && wide_to) {
        val pair:  u32 = types.type_vector_value(e.tt, from_ty, 2);
        val built: u32 = spirv.alloc_id(e.b);
        var words: [5]u32;
        words[0] = pair;
        words[1] = built;
        words[2] = value;
        words[3] = types.const_null(e.tt, from_ty);
        spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_CONSTRUCT, ?words[0], 4);
        ret emit_bitcast(e, to_ty, built);
    }
    if (wide_from && half_to) {
        val pair:  u32 = emit_bitcast(e, types.type_vector_value(e.tt, to_ty, 2), value);
        val low:   u32 = spirv.alloc_id(e.b);
        var words: [4]u32;
        words[0] = to_ty;
        words[1] = low;
        words[2] = pair;
        words[3] = 0;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_EXTRACT, ?words[0], 4);
        ret low;
    }
    ret emit_bitcast(e, to_ty, value);
}

# a vector wider than SPIR-V's is carried as an array of its lanes, which OpBitcast cannot take
fun lanes_in_array(e: *Emit, ty: u32) bool {
    var n: u32 = 0;
    ret types.vector_shape(e.tt, ty, ?n) == 0 && types.vector_value_shape(e.tt, ty, ?n) != 0;
}

# the lane type and count of a vector value, a scalar being one lane of itself
fun lane_shape(e: *Emit, ty: u32, out_count: *u32) u32 {
    val lane: u32 = types.vector_value_shape(e.tt, ty, out_count);
    if (lane != 0) { ret lane; }
    @out_count = 0;
    if (types.type_bits(e.tt, ty) == 0) { ret 0; }
    @out_count = 1;
    ret ty;
}

fun lane_of(e: *Emit, value: u32, lane_ty: u32, index: u32) u32 {
    val part:  u32 = spirv.alloc_id(e.b);
    var words: [4]u32;
    words[0] = lane_ty;
    words[1] = part;
    words[2] = value;
    words[3] = index;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_EXTRACT, ?words[0], 4);
    ret part;
}

# a vector value reinterpreted where one side is carried as an array. its lanes are
# regrouped at the wider lane width, each group reinterpreted through a vector SPIR-V
# can bitcast, and the result built from the regrouped lanes (#4319). 0 when the two
# are not the same number of bits
fun lanes_as(e: *Emit, value: u32, from_ty: u32, to_ty: u32) u32 {
    var nf: u32 = 0;
    var nt: u32 = 0;
    val fl: u32 = lane_shape(e, from_ty, ?nf);
    val tl: u32 = lane_shape(e, to_ty, ?nt);
    val fw: u32 = types.type_bits(e.tt, fl);
    val tw: u32 = types.type_bits(e.tt, tl);
    if (fw == 0 || tw == 0 || fw * nf != tw * nt || !types.instruction_operands_fit(2, nt)) { ret 0; }
    val sr: res[*u32, A.Error] = A.allocate[u32](e.alloc, nf::usize);
    if (sel sr.err) { ret 0; }
    val src: *u32 = sr.ok;
    fin { A.deallocate[u32](e.alloc, src, nf::usize); }
    val wr: res[*u32, A.Error] = A.allocate[u32](e.alloc, (nt + 2)::usize);
    if (sel wr.err) { ret 0; }
    val words: *u32 = wr.ok;
    fin { A.deallocate[u32](e.alloc, words, (nt + 2)::usize); }
    var i: u32 = 0;
    for (i < nf) {
        if (nf == 1) { src[i] = value; }
        or           { src[i] = lane_of(e, value, fl, i); }
        i = i + 1;
    }
    i = 0;
    if (fw == tw) {
        for (i < nt) {
            words[2 + i] = bits_as(e, src[i], fl, tl);
            i            = i + 1;
        }
    }
    or (fw < tw) {
        val k: u32 = tw / fw;
        for (i < nt) {
            words[2 + i] = lanes_packed(e, ?src[i * k], k, fl, tl);
            i            = i + 1;
        }
    }
    or {
        val k: u32 = fw / tw;
        for (i < nf) {
            if (!lanes_unpacked(e, src[i], k, tl, ?words[2 + i * k])) { ret 0; }
            i = i + 1;
        }
    }
    i = 0;
    for (i < nt) {
        if (words[2 + i] == 0) { ret 0; }
        i = i + 1;
    }
    if (nt == 1) { ret words[2]; }
    words[0] = to_ty;
    words[1] = spirv.alloc_id(e.b);
    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_CONSTRUCT, words, nt + 2);
    ret words[1];
}

# `count` lanes of `lane_ty` as one `to_ty`, through a vector of them. more lanes than a
# vector holds are first packed into integers of as many lanes as one holds
fun lanes_packed(e: *Emit, parts: *u32, count: u32, lane_ty: u32, to_ty: u32) u32 {
    val max: u32 = types.MAX_VECTOR_COMPONENTS;
    if (count > max) {
        val groups: u32 = count / max;
        val mid:    u32 = types.type_int(e.tt, types.type_bits(e.tt, lane_ty) * max);
        var inner:  [4]u32;
        if (mid == 0 || groups > max || groups * max != count) { ret 0; }
        var g: u32 = 0;
        for (g < groups) {
            inner[g] = lanes_packed(e, ?parts[g * max], max, lane_ty, mid);
            if (inner[g] == 0) { ret 0; }
            g = g + 1;
        }
        ret lanes_packed(e, ?inner[0], groups, mid, to_ty);
    }
    val vec_ty: u32 = types.type_vector(e.tt, lane_ty, count);
    if (vec_ty == 0) { ret 0; }
    var words: [6]u32;
    words[0] = vec_ty;
    words[1] = spirv.alloc_id(e.b);
    var i: u32 = 0;
    for (i < count) {
        words[2 + i] = parts[i];
        i            = i + 1;
    }
    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_CONSTRUCT, ?words[0], count + 2);
    ret emit_bitcast(e, to_ty, words[1]);
}

# one value as `count` lanes of `lane_ty` into `out`, the inverse of lanes_packed
fun lanes_unpacked(e: *Emit, value: u32, count: u32, lane_ty: u32, out: *u32) bool {
    val max: u32 = types.MAX_VECTOR_COMPONENTS;
    if (count > max) {
        val groups: u32 = count / max;
        val mid:    u32 = types.type_int(e.tt, types.type_bits(e.tt, lane_ty) * max);
        var inner:  [4]u32;
        if (mid == 0 || groups > max || groups * max != count) { ret false; }
        if (!lanes_unpacked(e, value, groups, mid, ?inner[0])) { ret false; }
        var g: u32 = 0;
        for (g < groups) {
            if (!lanes_unpacked(e, inner[g], max, lane_ty, ?out[g * max])) { ret false; }
            g = g + 1;
        }
        ret true;
    }
    val vec_ty: u32 = types.type_vector(e.tt, lane_ty, count);
    if (vec_ty == 0) { ret false; }
    val vec: u32 = emit_bitcast(e, vec_ty, value);
    var i:   u32 = 0;
    for (i < count) {
        out[i] = lane_of(e, vec, lane_ty, i);
        i      = i + 1;
    }
    ret true;
}

fun emit_mov(e: *Emit, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count != 2) { ret emit_fail(e, "spirv.emit: malformed move instruction"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];

    if (dst.kind == mir.MIR_OP_VREG) {
        if (dst.vreg.n >= vm.n) { ret emit_fail(e, "spirv.emit: move destination vreg out of range"); }
        var pointee:   u32 = 0;
        val reference: u32 = chain_target(vm, src, ?pointee);
        # a physical pointer copied into a register of its own is that register's value
        if (reference != 0 && vm.var_id[dst.vreg.n] != 0 && chain_storage(vm, src) == spirv.STORAGE_PHYSICAL_STORAGE_BUFFER) {
            ret store_vreg(e, vm, dst.vreg.n, reference);
        }
        if (reference != 0) {
            vm.chain_id[dst.vreg.n] = reference;
            vm.chain_ty[dst.vreg.n] = pointee;
            vm.chain_sc[dst.vreg.n] = chain_storage(vm, src);
            ret err[fail.Fail].ok{};
        }
        val val_id: u32 = read_operand(e, vm, src, vm.type_id[dst.vreg.n]);
        if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable move source"); }
        ret store_vreg(e, vm, dst.vreg.n, val_id);
    }
    ret unsupported(e, "memory-destination move is not yet supported by the SPIR-V target");
}

test builtin_type_refusal__each_builtin_takes_its_own_type {
    var alloc:  A.Allocator;
    val r_3498: err[A.Error] = page.make(?alloc);
    if (sel r_3498.err) { ret 1; }
    var tt:     type.IrTypeTable;
    val r_3500: err[fail.Fail] = type.init(?tt, ?alloc);
    if (sel r_3500.err) { ret 1; }
    fin { type.dnit(?tt); }

    val f32t_r: res[type.IrTypeId, fail.Fail] = type.intern_float(?tt, 32);
    if (sel f32t_r.err) { ret 1; }
    val f32t:   type.IrTypeId                 = f32t_r.ok;
    val i32t_r: res[type.IrTypeId, fail.Fail] = type.intern_int(?tt, 32);
    if (sel i32t_r.err) { ret 1; }
    val i32t:   type.IrTypeId                 = i32t_r.ok;
    val f64t_r: res[type.IrTypeId, fail.Fail] = type.intern_float(?tt, 64);
    if (sel f64t_r.err) { ret 1; }
    val f64t:  type.IrTypeId                 = f64t_r.ok;
    val v4f_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, f32t, 4);
    if (sel v4f_r.err) { ret 1; }
    val v4f:   type.IrTypeId                 = v4f_r.ok;
    val v3f_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, f32t, 3);
    if (sel v3f_r.err) { ret 1; }
    val v3f:   type.IrTypeId                 = v3f_r.ok;
    val v3i_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, i32t, 3);
    if (sel v3i_r.err) { ret 1; }
    val v3i:   type.IrTypeId                 = v3i_r.ok;
    val v4i_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, i32t, 4);
    if (sel v4i_r.err) { ret 1; }
    val v4i: type.IrTypeId = v4i_r.ok;

    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POSITION, v4f) != nil)    { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_FRAG_COORD, v4f) != nil)  { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POSITION, v3f) == nil)    { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POSITION, v4i) == nil)    { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_FRAG_COORD, f32t) == nil) { ret 1; }

    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POINT_SIZE, f32t) != nil) { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POINT_SIZE, f64t) == nil) { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POINT_SIZE, v4f) == nil)  { ret 1; }

    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_VERTEX_INDEX, i32t) != nil)   { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_INSTANCE_INDEX, i32t) != nil) { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_VERTEX_INDEX, f32t) == nil)   { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_INSTANCE_INDEX, v3i) == nil)  { ret 1; }

    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_GLOBAL_INVOCATION, v3i) != nil)       { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_LOCAL_INVOCATION, v3i) != nil)        { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_WORKGROUP_ID, v3i) != nil)            { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_GLOBAL_INVOCATION, v4i) == nil)       { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_LOCAL_INVOCATION, v3f) == nil)        { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_WORKGROUP_ID, i32t) == nil)           { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_NUM_WORKGROUPS, v3i) != nil)          { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_NUM_WORKGROUPS, i32t) == nil)         { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_LOCAL_INVOCATION_INDEX, i32t) != nil) { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_LOCAL_INVOCATION_INDEX, v3i) == nil)  { ret 1; }

    var sb: u32 = ir.BUILTIN_SUBGROUP_SIZE;
    for (sb <= ir.BUILTIN_NUM_SUBGROUPS) {
        if (builtin_type_refusal(?tt, ?alloc, sb, i32t) != nil) { ret 2; }
        if (builtin_type_refusal(?tt, ?alloc, sb, v3i) == nil)  { ret 2; }
        if (builtin_type_refusal(?tt, ?alloc, sb, f32t) == nil) { ret 2; }
        sb = sb + 1;
    }

    ret 0;
}

test ir_type_spelling__scalars_vectors_and_aggregates {
    var alloc:  A.Allocator;
    val r_3538: err[A.Error] = page.make(?alloc);
    if (sel r_3538.err) { ret 1; }
    var tt:     type.IrTypeTable;
    val r_3540: err[fail.Fail] = type.init(?tt, ?alloc);
    if (sel r_3540.err) { ret 1; }
    fin { type.dnit(?tt); }

    val f32t_r: res[type.IrTypeId, fail.Fail] = type.intern_float(?tt, 32);
    if (sel f32t_r.err) { ret 1; }
    val f32t:   type.IrTypeId                 = f32t_r.ok;
    val i32t_r: res[type.IrTypeId, fail.Fail] = type.intern_int(?tt, 32);
    if (sel i32t_r.err) { ret 1; }
    val i32t:  type.IrTypeId                 = i32t_r.ok;
    val v3f_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, f32t, 3);
    if (sel v3f_r.err) { ret 1; }
    val v3f:   type.IrTypeId                 = v3f_r.ok;
    val v3i_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, i32t, 3);
    if (sel v3i_r.err) { ret 1; }
    val v3i:   type.IrTypeId                 = v3i_r.ok;
    val arr_r: res[type.IrTypeId, fail.Fail] = type.intern_array(?tt, f32t, 4);
    if (sel arr_r.err) { ret 1; }
    val arr: type.IrTypeId = arr_r.ok;

    if (!str_equals(ir_type_spelling(?tt, ?alloc, f32t), "`f32`"))            { ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, v3f), "`f32x3`"))           { ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, i32t), "`i32` / `u32`"))    { ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, v3i), "`i32x3` / `u32x3`")) { ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, arr), "an array"))          { ret 1; }

    # an f16 and a vector of them are their binary16 carriers in the ir (#4339)
    val h_r: res[type.IrTypeId, fail.Fail] = type.intern_int_form(?tt, 16, type.INT_FORM_BINARY16);
    if (sel h_r.err) { ret 1; }
    val v4h_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, h_r.ok, 4);
    if (sel v4h_r.err) { ret 1; }
    val i16_r: res[type.IrTypeId, fail.Fail] = type.intern_int(?tt, 16);
    if (sel i16_r.err)                                                         { ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, h_r.ok), "`f16`"))           { ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, v4h_r.ok), "`f16x4`"))       { ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, i16_r.ok), "`i16` / `u16`")) { ret 1; }

    ret 0;
}

test needs_flat__integer_and_double_elements {
    var alloc:  A.Allocator;
    val r_3560: err[A.Error] = page.make(?alloc);
    if (sel r_3560.err) { ret 1; }
    var tt:     type.IrTypeTable;
    val r_3562: err[fail.Fail] = type.init(?tt, ?alloc);
    if (sel r_3562.err) { ret 1; }
    fin { type.dnit(?tt); }

    val f32t_r: res[type.IrTypeId, fail.Fail] = type.intern_float(?tt, 32);
    if (sel f32t_r.err) { ret 1; }
    val f32t:   type.IrTypeId                 = f32t_r.ok;
    val f64t_r: res[type.IrTypeId, fail.Fail] = type.intern_float(?tt, 64);
    if (sel f64t_r.err) { ret 1; }
    val f64t:   type.IrTypeId                 = f64t_r.ok;
    val i32t_r: res[type.IrTypeId, fail.Fail] = type.intern_int(?tt, 32);
    if (sel i32t_r.err) { ret 1; }
    val i32t:  type.IrTypeId                 = i32t_r.ok;
    val i8t_r: res[type.IrTypeId, fail.Fail] = type.intern_int(?tt, 8);
    if (sel i8t_r.err) { ret 1; }
    val i8t:   type.IrTypeId                 = i8t_r.ok;
    val v4f_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, f32t, 4);
    if (sel v4f_r.err) { ret 1; }
    val v4f:   type.IrTypeId                 = v4f_r.ok;
    val v3i_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, i32t, 3);
    if (sel v3i_r.err) { ret 1; }
    val v3i:   type.IrTypeId                 = v3i_r.ok;
    val v2d_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, f64t, 2);
    if (sel v2d_r.err) { ret 1; }
    val v2d:   type.IrTypeId                 = v2d_r.ok;
    val arr_r: res[type.IrTypeId, fail.Fail] = type.intern_array(?tt, f32t, 4);
    if (sel arr_r.err) { ret 1; }
    val arr: type.IrTypeId = arr_r.ok;

    if (!needs_flat(?tt, i32t)) { ret 1; }
    if (!needs_flat(?tt, i8t))  { ret 1; }
    if (!needs_flat(?tt, v3i))  { ret 1; }

    if (!needs_flat(?tt, f64t)) { ret 1; }
    if (!needs_flat(?tt, v2d))  { ret 1; }

    if (needs_flat(?tt, f32t)) { ret 1; }
    if (needs_flat(?tt, v4f))  { ret 1; }

    if (needs_flat(?tt, arr)) { ret 1; }

    ret 0;
}

test round_up_to__overflow_is_unrepresentable_not_a_wrap {
    if (round_up_to(5, 16) != 16)                  { ret 1; }
    if (round_up_to(32, 16) != 32)                 { ret 1; }
    if (round_up_to(7, 0) != 7)                    { ret 1; }
    if (round_up_to(0xFFFFFFE0, 32) != 0xFFFFFFE0) { ret 1; }
    if (round_up_to(0xFFFFFFF0, 32) != 0)          { ret 1; }
    if (round_up_to(0xFFFFFFFF, 2) != 0)           { ret 1; }
    ret 0;
}

test emit_memcpy__volatile_self_copy_keeps_load_and_store {
    var alloc:  A.Allocator;
    val r_3601: err[A.Error] = page.make(?alloc);
    if (sel r_3601.err) { ret 1; }
    var b: spirv.Builder = spirv.builder_init(?alloc);
    fin { spirv.builder_dnit(?b); }
    var e: Emit;
    e.alloc = ?alloc;
    e.b     = ?b;
    var ids: [1]u32 = [1]u32{37};
    var tys: [1]u32 = [1]u32{42};
    var scs: [1]u32 = [1]u32{spirv.STORAGE_FUNCTION};
    var vm:  VMaps;
    vm.n        = 1;
    vm.chain_id = ?ids[0];
    vm.chain_ty = ?tys[0];
    vm.chain_sc = ?scs[0];
    var mf:  mir.MirFunction;
    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_mem_value(mir.vreg_id(0), 0);
    ops[1] = mir.op_mem_value(mir.vreg_id(0), 0);
    ops[2] = mir.op_imm(16);
    var mi:   mir.MirInstr = mir.instr(mir.MIR_MEMCPY, ?ops[0], 3, 8, 8);
    var mode: u32          = 0;
    for (mode < 2) {
        b.functions.len = 0;
        mi.memory_flags = 0;
        if (mode == 1) { mi.memory_flags = mir.MEMORY_VOLATILE; }
        val rr: err[fail.Fail] = emit_memcpy(?e, ?mf, ?vm, ?mi);
        if (sel rr.err) { ret 2; }
        if (b.err)      { ret 2; }
        val load_words:  u32 = 4 + mode;
        val store_words: u32 = 3 + mode;
        if (b.functions.len != load_words + store_words) { ret 3; }
        val words: *u32 = b.functions.words;
        if (words[0] != ((load_words << 16) | spirv.OP_LOAD))                 { ret 4; }
        if (words[1] != 42 || words[3] != 37)                                 { ret 5; }
        if (words[load_words] != ((store_words << 16) | spirv.OP_STORE))      { ret 6; }
        if (words[load_words + 1] != 37 || words[load_words + 2] != words[2]) { ret 7; }
        if (mode == 1 && (words[4] != 1 || words[load_words + 3] != 1))       { ret 8; }
        mode = mode + 1;
    }
    ret 0;
}

test emit_global_load__volatile_opaque_load_is_evaluated_once {
    var alloc:  A.Allocator;
    val r_3643: err[A.Error] = page.make(?alloc);
    if (sel r_3643.err) { ret 1; }
    var b: spirv.Builder = spirv.builder_init(?alloc);
    fin { spirv.builder_dnit(?b); }
    var tt: types.TypeTable = types.types_init(?b);
    fin { types.types_dnit(?tt); }
    val ty: u32 = types.type_sampler(?tt);
    if (ty == 0) { ret 1; }
    var globals: [1]GlobalEnt;
    globals[0].name = 1;
    var ids: [1]u32 = [1]u32{37};
    var e:   Emit;
    e.alloc    = ?alloc;
    e.b        = ?b;
    e.tt       = ?tt;
    e.gls      = ?globals[0];
    e.gl_len   = 1;
    e.gvar_ids = ?ids[0];
    var tys:      [1]u32 = [1]u32{ty};
    var held:     [1]u32 = [1]u32{0};
    var deferred: [1]u32 = [1]u32{37};
    var vm:       VMaps;
    vm.n       = 1;
    vm.type_id = ?tys[0];
    vm.opq_ssa = ?held[0];
    vm.opq_var = ?deferred[0];
    var mf:  mir.MirFunction;
    var ops: [2]mir.MirOperand;
    ops[0] = mir.op_vreg(mir.vreg_id(0));
    ops[1] = mir.op_sym(1, 0);
    var mi: mir.MirInstr = mir.instr(mir.MIR_LOAD, ?ops[0], 2, 8, 8);
    mi.memory_flags = mir.MEMORY_VOLATILE;
    val r_3674: err[fail.Fail] = emit_global_load(?e, ?mf, ?vm, ?mi);
    if (sel r_3674.err)                                    { ret 2; }
    if (b.functions.len != 5 || b.functions.words[4] != 1) { ret 3; }
    if (held[0] == 0 || deferred[0] != 0)                  { ret 4; }
    val first:  u32 = read_operand(?e, ?vm, ?ops[0], ty);
    val second: u32 = read_operand(?e, ?vm, ?ops[0], ty);
    if (first != held[0] || second != held[0]) { ret 5; }
    if (b.functions.len != 5 || b.err)         { ret 6; }
    ret 0;
}

# the texel operands land in bit order and only where the call does not already carry
# them: added with the mask to a call passing none, after a lower bit's operand and before
# a higher one's, and a bit the call carries keeps the call's scope
test splice_texel_operands__bit_order_and_idempotent {
    var values: [3]isa.OpEnumerant = [3]isa.OpEnumerant{
        isa.OpEnumerant{value: defs.IMAGE_OPERANDS_SAMPLE, name: "Sample", capability: isa.NO_OP_CAPABILITY, requires: 0, operands: "v"},
        isa.OpEnumerant{value: defs.IMAGE_OPERANDS_MAKE_TEXEL_VISIBLE, name: "MakeTexelVisible", capability: isa.NO_OP_CAPABILITY, requires: 0, operands: "s"},
        isa.OpEnumerant{value: 0x10000, name: "Offsets", capability: isa.NO_OP_CAPABILITY, requires: 0, operands: "c"},
    };
    var en:  isa.OpEnum = isa.OpEnum{name: "Image Operands", values: ?values[0], count: 3, mask: true};
    val vis: u32        = defs.IMAGE_OPERANDS_MAKE_TEXEL_VISIBLE;
    val np:  u32        = defs.IMAGE_OPERANDS_NON_PRIVATE_TEXEL;
    var w:   [8]u32;
    w[0] = 10;
    w[1] = 11;
    if (splice_texel_operands(?w[0], 2, 2, ?en, vis, 99) != 4 || w[2] != (vis | np) || w[3] != 99) { ret 1; }
    # Sample's operand stays before the scope, Offsets' after it
    w[2] = defs.IMAGE_OPERANDS_SAMPLE | 0x10000;
    w[3] = 20;
    w[4] = 30;
    if (splice_texel_operands(?w[0], 5, 2, ?en, vis, 99) != 6)                                               { ret 2; }
    if (w[2] != (defs.IMAGE_OPERANDS_SAMPLE | 0x10000 | vis | np) || w[3] != 20 || w[4] != 99 || w[5] != 30) { ret 3; }
    # a call carrying the bit keeps its own scope and gains no second one
    w[2] = vis;
    w[3] = 42;
    if (splice_texel_operands(?w[0], 4, 2, ?en, vis, 99) != 4 || w[2] != (vis | np) || w[3] != 42) { ret 4; }
    ret 0;
}

# a store of `value` to element `k` of the temporary at register 0, through the access
# chain register `g`, appended to `ins` at `at` with its operands at `o`
#[testing]
fun ut_ct_store(ops: *mir.MirOperand, ins: *mir.MirInstr, at: *u32, o: *u32, g: u32, k: i64, value: mir.MirOperand) {
    val p: u32 = @o;
    ops[p]       = mir.op_vreg(mir.vreg_id(g));
    ops[p + 1]   = mir.op_mem_value(mir.vreg_id(0), 0);
    ops[p + 2]   = mir.op_imm(0);
    ops[p + 3]   = mir.op_imm(k);
    ops[p + 4]   = mir.op_mem_value(mir.vreg_id(g), 0);
    ops[p + 5]   = value;
    ins[@at]     = mir.instr(mir.MIR_GEP, ?ops[p], 4, 8, 8);
    ins[@at + 1] = mir.instr(mir.MIR_STORE, ?ops[p + 4], 2, 4, 4);
    @at          = @at + 2;
    @o           = p + 6;
}

# the temporary of `[4]i32` at register 0 written by four constant stores, then read
# by the call it returns, with `mode` breaking one guard: a run-time store, a store
# after the call, a missing element, a repeated element, a copy of the address, and a
# zeroing write, a store past the last element, and the call taking its address too
#[testing]
fun ut_ct_build(mode: u32, ops: *mir.MirOperand, ins: *mir.MirInstr, out_n: *u32) *mir.MirInstr {
    var n: u32 = 0;
    var o: u32 = 0;
    ops[0] = mir.op_vreg(mir.vreg_id(0));
    ops[1] = mir.op_mem_value(mir.vreg_id(15), 0);
    ins[0] = mir.instr(mir.MIR_ALLOCA, ?ops[0], 2, 8, 8);
    n      = 1;
    o      = 2;
    if (mode == 6) {
        ops[o]     = mir.op_mem_value(mir.vreg_id(0), 0);
        ops[o + 1] = mir.op_imm(16);
        ins[n]     = mir.instr(mir.MIR_MEMZERO, ?ops[o], 2, 8, 8);
        n          = n + 1;
        o          = o + 2;
    }
    var k: u32 = 0;
    for (k < 4) {
        var value: mir.MirOperand = mir.op_imm(10 + k::i64);
        if (mode == 1 && k == 2)                   { value = mir.op_vreg(mir.vreg_id(9)); }
        if (!((mode == 2 || mode == 3) && k == 3)) { ut_ct_store(ops, ins, ?n, ?o, 1 + k, k::i64, value); }
        k = k + 1;
    }
    if (mode == 4) { ut_ct_store(ops, ins, ?n, ?o, 5, 1, mir.op_imm(99)); }
    if (mode == 7) { ut_ct_store(ops, ins, ?n, ?o, 5, 4, mir.op_imm(99)); }
    if (mode == 5) {
        ops[o]     = mir.op_vreg(mir.vreg_id(10));
        ops[o + 1] = mir.op_vreg(mir.vreg_id(0));
        ins[n]     = mir.instr(mir.MIR_MOV, ?ops[o], 2, 8, 8);
        n          = n + 1;
        o          = o + 2;
    }
    ops[o]     = mir.op_sym(1, 0);
    ops[o + 1] = mir.op_vreg(mir.vreg_id(8));
    ops[o + 2] = mir.op_mem_value(mir.vreg_id(0), 0);
    ops[o + 3] = mir.op_vreg(mir.vreg_id(0));
    var argc: u32 = 3;
    if (mode == 8) { argc = 4; }
    val call: u32 = n;
    ins[n] = mir.instr(mir.MIR_VALUE_CALL, ?ops[o], argc, 0, 0);
    n      = n + 1;
    o      = o + 4;
    if (mode == 2) { ut_ct_store(ops, ins, ?n, ?o, 4, 3, mir.op_imm(13)); }
    @out_n = n;
    ret ?ins[call];
}

# an aggregate passed through a temporary is a constant only when constants write each
# of its elements once before the call that reads it, and nothing else touches it
# (#4321)
test constant_temporary__whole_constant_writes_only {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var b: spirv.Builder = spirv.builder_init(?alloc);
    fin { spirv.builder_dnit(?b); }
    var tt: types.TypeTable = types.types_init(?b);
    fin { types.types_dnit(?tt); }
    val elem: u32 = types.type_int(?tt, 32);
    val arr:  u32 = types.type_array(?tt, elem, 4, false);
    if (elem == 0 || arr == 0) { ret 1; }
    var e: Emit;
    e.alloc = ?alloc;
    e.b     = ?b;
    e.tt    = ?tt;
    var type_id:  [16]u32;
    var chain_ty: [16]u32;
    var chain_sc: [16]u32;
    chain_ty[0] = arr;
    chain_sc[0] = spirv.STORAGE_FUNCTION;
    type_id[9]  = elem;
    var vm: VMaps;
    vm.n        = 16;
    vm.type_id  = ?type_id[0];
    vm.chain_ty = ?chain_ty[0];
    vm.chain_sc = ?chain_sc[0];
    var parts: [4]u32;
    var k:     u32 = 0;
    for (k < 4) {
        parts[k] = types.const_int(?tt, 32, 10 + k::i64);
        k        = k + 1;
    }
    val want: u32 = types.const_composite(?tt, arr, ?parts[0], 4);
    var mode: u32 = 0;
    for (mode < 9) {
        var ops: [48]mir.MirOperand;
        var ins: [16]mir.MirInstr;
        var n:   u32 = 0;
        e.cur_instr = ut_ct_build(mode, ?ops[0], ?ins[0], ?n);
        var blk: mir.MirBlock;
        blk.instrs      = ?ins[0];
        blk.instr_count = n;
        var mf: mir.MirFunction;
        mf.blocks      = ?blk;
        mf.block_count = 1;
        val got: u32 = constant_operand(?e, ?mf, ?vm, ?e.cur_instr.operands[2], arr, 0);
        if (mode == 0 && got != want) { ret 2; }
        if (mode != 0 && got != 0)    { ret 3 + mode::i32; }
        mode = mode + 1;
    }
    ret 0;
}
