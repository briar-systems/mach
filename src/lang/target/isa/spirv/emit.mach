use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;

use std.allocator.page;
use std.format;

use A: std.allocator;

use mach.lang.be.codegen.debug_input;
use mach.lang.be.codegen.mir;
use mach.lang.be.codegen.unit;
use mach.lang.diagnostic;
use dkind: mach.lang.diagnostic.kind;
use mach.lang.float;
use mach.lang.intern;
use mach.lang.layout;
use mach.lang.me.ir;
use mach.lang.me.ir.id;
use mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.source;
use mach.lang.target.extension;
use mach.lang.target.isa;
use mach.lang.target.isa.spirv;
use mach.lang.target.isa.spirv.cfg;
use dbgm: mach.lang.target.isa.spirv.debug;
use mach.lang.target.isa.spirv.defs;
use mach.lang.target.isa.spirv.ops;
use mach.lang.target.isa.spirv.types;
use mach.lang.target.of;
use semtype: mach.lang.type;

rec Emit {
    alloc:     *A.Allocator;
    interner:  *intern.Interner;
    tgt:       *isa.BackendTarget;
    layout:    layout.Machine;
    u:         *unit.Unit;
    root:      *ir.Module;
    ir:        *ir.Module;
    cur_mi:    u32;
    b:         *spirv.Builder;
    tt:        *types.TypeTable;
    fns:       *FnEnt;
    fn_len:    u32;
    has_entry: bool;
    gls:       *GlobalEnt;
    gl_len:    u32;
    gvar_ids:  *u32;
    gtype_ids: *u32;
    gstorage:  *u32;
    iface_len: u32;
    gslot:     *u32;
    iface_use: *u8;
    # the LocalInvocationIndex variable the emitter adds for the zeroing of `#[shared]`
    # memory when no global declares one, 0 until a stage needs it
    zero_lid: u32;

    # what each reached global's memory may undergo, as ACCESS_* bits
    gaccess: *u8;
    # the OpSpecConstant id of each `#[spec]` global, 0 for any other
    gspec: *u32;
    # the module sizes its compute stages through one WorkgroupSize built-in
    wg_builtin: bool;

    ext_ids: [8]u32;

    srcmap: *source.SourceMap;
    # the root module's diagnostic store, where a refusal of the program lands
    diags:     *diagnostic.DiagnosticStore;
    dbg:       dbgm.Debug;
    cur_fn:    *mir.MirFunction;
    cur_instr: *mir.MirInstr;
    # the stages each function is reached from, as stage_bit sets, and the set of the one
    # being emitted
    fn_stages:  *u8;
    cur_stages: u8;
}

rec VMaps {
    type_id:      *u32;
    var_id:       *u32;
    is_bool:      *bool;
    chain_id:     *u32;
    chain_ty:     *u32;
    chain_sc:     *u32;
    chain_object: *bool;
    opq_var:      *u32;
    opq_ssa:      *u32;
    n:            u32;
}

rec FnEnt {
    mi:     u32;
    ir_ix:  u32;
    mir_ix: u32;
    name:   intern.StrId;
    id:     u32;
    emit:   bool;
}

rec GlobalEnt {
    mi:    u32;
    ir_ix: u32;
    name:  intern.StrId;
}

pub fun emit_module(out_alloc: *A.Allocator, tgt: *isa.BackendTarget, u: *unit.Unit,
    dbg: *debug_input.ModuleDebug, image: *of.ObjectImage) err[fail.Fail] {
    if (out_alloc == nil || tgt == nil || u == nil || u.len == 0 || u.mods == nil || image == nil) {
        ret err[fail.Fail].err{fail.message("spirv.emit: nil argument")};
    }
    if (image.alloc != out_alloc) {
        ret err[fail.Fail].err{fail.message("spirv.emit: the module is serialized into the image's allocator, and the two differ")};
    }
    val irmod:  *ir.Module     = unit.root_ir(u);
    val mirmod: *mir.MirModule = unit.root_mir(u);
    if (irmod == nil || mirmod == nil) { ret err[fail.Fail].err{fail.message("spirv.emit: nil argument")}; }

    var b:  spirv.Builder   = spirv.builder_init(out_alloc);
    var tt: types.TypeTable = types.types_init(?b);

    var e: Emit;
    e.alloc      = out_alloc;
    e.interner   = mirmod.interner;
    e.tgt        = tgt;
    e.layout     = layout.machine(tgt.model.pointer_width, tgt.model.vector_bits, isa.vector_register_bits(?tgt.model));
    e.u          = u;
    e.root       = irmod;
    e.ir         = irmod;
    e.cur_mi     = u.root;
    e.b          = ?b;
    e.tt         = ?tt;
    e.fns        = nil;
    e.fn_len     = 0;
    e.gls        = nil;
    e.gl_len     = 0;
    e.gvar_ids   = nil;
    e.gtype_ids  = nil;
    e.gstorage   = nil;
    e.iface_len  = 0;
    e.gslot      = nil;
    e.iface_use  = nil;
    e.zero_lid   = 0;
    e.gaccess    = nil;
    e.gspec      = nil;
    e.wg_builtin = false;
    var xi: u32 = 0;
    for (xi < 8) {
        e.ext_ids[xi] = 0;
        xi            = xi + 1;
    }
    e.srcmap     = mirmod.srcmap;
    e.diags      = mirmod.diags;
    e.dbg        = dbgm.init(dbg, ?b, out_alloc, e.interner, e.srcmap);
    e.cur_fn     = nil;
    e.cur_instr  = nil;
    e.fn_stages  = nil;
    e.cur_stages = 0;

    e.has_entry = false;
    var si: u32 = 0;
    for (si < irmod.function_len) {
        if (irmod.functions[si].stage != ir.STAGE_NONE
            && (irmod.functions[si].flags & ir.FN_FLAG_EXTERN) == 0) { e.has_entry = true; }
        si = si + 1;
    }

    val tr: err[fail.Fail] = build_fn_table(?e);
    if (sel tr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret tr;
    }

    val rr: err[fail.Fail] = mark_emitted(?e);
    if (sel rr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret rr;
    }

    val vr: err[fail.Fail] = select_version(?e);
    if (sel vr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret vr;
    }

    val gtr: err[fail.Fail] = build_gl_table(?e);
    if (sel gtr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret gtr;
    }

    val wr: err[fail.Fail] = build_gl_access(?e);
    if (sel wr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret wr;
    }

    val gr: err[fail.Fail] = declare_interface(?e);
    if (sel gr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret gr;
    }

    val ur: err[fail.Fail] = build_iface_uses(?e);
    if (sel ur.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret ur;
    }

    val cgr: err[fail.Fail] = check_call_graph(?e);
    if (sel cgr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret cgr;
    }

    val fsr: err[fail.Fail] = build_fn_stages(?e);
    if (sel fsr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret fsr;
    }

    val sir: err[fail.Fail] = check_stage_interfaces(?e);
    if (sel sir.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret sir;
    }

    val wgr: err[fail.Fail] = plan_workgroup(?e);
    if (sel wgr.err) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret wgr;
    }

    var fi: u32 = 0;
    for (fi < e.fn_len) {
        if (!e.fns[fi].emit) {
            fi = fi + 1;
            cnt;
        }
        val fr: err[fail.Fail] = emit_function(?e, fi);
        if (sel fr.err) {
            emit_dnit(?e);
            types.types_dnit(?tt);
            spirv.builder_dnit(?b);
            ret fr;
        }
        fi = fi + 1;
    }
    emit_dnit(?e);

    val cr: err[fail.Fail] = check_environment(?e);
    if (sel cr.err) {
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret cr;
    }
    emit_preamble(?e);

    var len: u32                 = 0;
    val rs:  res[*u8, fail.Fail] = spirv.serialize(?b, ?len);
    types.types_dnit(?tt);
    spirv.builder_dnit(?b);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    ret install_module(image, rs.ok, len);
}

# the finished module is the image's one section; the image owns its bytes from here
fun install_module(image: *of.ObjectImage, bytes: *u8, len: u32) err[fail.Fail] {
    val name: res[intern.StrId, A.Error] = intern.intern(image.interner, spirv.SPV_MODULE_SECTION);
    if (sel name.err) {
        if (bytes != nil && len > 0) { A.deallocate[u8](image.alloc, bytes, len::usize); }
        ret err[fail.Fail].err{fail.refused(name.err)};
    }
    var sec: of.Section;
    sec.name  = name.ok;
    sec.kind  = of.SK_TEXT;
    sec.bytes = bytes;
    sec.len   = len;
    sec.align = 4;
    sec.flags = 0;
    val installed: res[u32, fail.Fail] = of.section_install(image, ?sec);
    if (sel installed.err) { ret err[fail.Fail].err{installed.err}; }
    ret err[fail.Fail].ok{};
}

fun emit_dnit(e: *Emit) {
    if (e.fn_stages != nil && e.fn_len > 0) { A.deallocate[u8](e.alloc, e.fn_stages, e.fn_len::usize); }
    e.fn_stages = nil;
    if (e.iface_use != nil && e.fn_len > 0 && e.iface_len > 0) {
        A.deallocate[u8](e.alloc, e.iface_use, (e.fn_len * e.iface_len)::usize);
    }
    e.iface_use = nil;
    e.iface_len = 0;
    if (e.fns != nil && e.fn_len > 0) { A.deallocate[FnEnt](e.alloc, e.fns, e.fn_len::usize); }
    e.fns    = nil;
    e.fn_len = 0;
    if (e.gvar_ids != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gvar_ids, e.gl_len::usize);
    }
    e.gvar_ids = nil;
    if (e.gslot != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gslot, e.gl_len::usize);
    }
    e.gslot = nil;
    if (e.gtype_ids != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gtype_ids, e.gl_len::usize);
    }
    e.gtype_ids = nil;
    if (e.gstorage != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gstorage, e.gl_len::usize);
    }
    e.gstorage = nil;
    if (e.gaccess != nil && e.gl_len > 0) {
        A.deallocate[u8](e.alloc, e.gaccess, e.gl_len::usize);
    }
    e.gaccess = nil;
    if (e.gspec != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gspec, e.gl_len::usize);
    }
    e.gspec = nil;
    if (e.gls != nil && e.gl_len > 0) { A.deallocate[GlobalEnt](e.alloc, e.gls, e.gl_len::usize); }
    e.gls    = nil;
    e.gl_len = 0;
}

fun build_fn_table(e: *Emit) err[fail.Fail] {
    var n:  u32 = 0;
    var mi: u32 = 0;
    for (mi < e.u.len) {
        val m: *ir.Module = e.u.mods[mi].ir;
        var i: u32        = 0;
        for (i < m.function_len) {
            if ((m.functions[i].flags & ir.FN_FLAG_EXTERN) == 0) { n = n + 1; }
            i = i + 1;
        }
        mi = mi + 1;
    }
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val rt: res[*FnEnt, A.Error] = A.allocate[FnEnt](e.alloc, n::usize);
    if (sel rt.err) { ret err[fail.Fail].err{fail.refused(rt.err)}; }
    e.fns    = rt.ok;
    e.fn_len = n;

    var k:    u32 = 0;
    var pass: u32 = 0;
    for (pass < 2) {
        mi = 0;
        for (mi < e.u.len) {
            val is_root: bool = mi == e.u.root;
            if ((pass == 0) != is_root) {
                mi = mi + 1;
                cnt;
            }
            val m: *ir.Module = e.u.mods[mi].ir;
            var i: u32        = 0;
            for (i < m.function_len) {
                if ((m.functions[i].flags & ir.FN_FLAG_EXTERN) != 0) {
                    i = i + 1;
                    cnt;
                }
                e.fns[k].mi     = mi;
                e.fns[k].ir_ix  = i;
                e.fns[k].name   = m.functions[i].name;
                e.fns[k].mir_ix = unit.mir_index(e.u, mi, m.functions[i].name);
                e.fns[k].id     = 0;
                e.fns[k].emit   = false;
                k               = k + 1;
                i               = i + 1;
            }
            mi = mi + 1;
        }
        pass = pass + 1;
    }
    ret err[fail.Fail].ok{};
}

fun mark_emitted(e: *Emit) err[fail.Fail] {
    if (e.fn_len == 0) { ret err[fail.Fail].ok{}; }

    var i: u32 = 0;
    for (i < e.fn_len) {
        val fn:      *ir.Function = fn_ir(e, i);
        val root_fn: bool         = e.fns[i].mi == e.u.root;
        var seed:    bool         = false;
        if (e.has_entry)             { seed = root_fn && fn.stage != ir.STAGE_NONE; }
        or                           { seed = root_fn; }
        if (seed && emittable(e, i)) { e.fns[i].emit = true; }
        i = i + 1;
    }

    var changed: bool = true;
    for (changed) {
        changed = false;
        i       = 0;
        for (i < e.fn_len) {
            if (!e.fns[i].emit) {
                i = i + 1;
                cnt;
            }
            var ci: u32 = 0;
            for (ci < callee_count(e, i)) {
                val cx: u32 = callee_at(e, i, ci);
                if (cx != FN_NONE && !e.fns[cx].emit && emittable(e, cx)) {
                    e.fns[cx].emit = true;
                    changed        = true;
                }
                ci = ci + 1;
            }
            i = i + 1;
        }
    }

    i = 0;
    for (i < e.fn_len) {
        if (e.fns[i].emit) { e.fns[i].id = spirv.alloc_id(e.b); }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun emittable(e: *Emit, ix: u32) bool {
    val fn: *ir.Function = fn_ir(e, ix);
    if (fn.op_set != defs.SPV_SET_NONE) { ret false; }
    val mf: *mir.MirFunction = fn_mir(e, ix);
    if (mf == nil || mf.block_count == 0) { ret false; }
    ret true;
}

fun callee_count(e: *Emit, ix: u32) u32 {
    val mf: *mir.MirFunction = fn_mir(e, ix);
    if (mf == nil) { ret 0; }
    var n:  u32 = 0;
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            if (blk.instrs[ii].opcode == mir.MIR_VALUE_CALL) { n = n + 1; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret n;
}

fun callee_at(e: *Emit, ix: u32, k: u32) u32 {
    val mf: *mir.MirFunction = fn_mir(e, ix);
    if (mf == nil) { ret FN_NONE; }
    var n:  u32 = 0;
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mi.opcode == mir.MIR_VALUE_CALL) {
                if (n == k) {
                    if (mi.operand_count < 1 || mi.operands[0].kind != mir.MIR_OP_SYM) { ret FN_NONE; }
                    ret fn_lookup(e, mi.operands[0].sym);
                }
                n = n + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret FN_NONE;
}

fun fn_lookup(e: *Emit, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < e.fn_len) {
        if (e.fns[i].name == name) { ret i; }
        i = i + 1;
    }
    ret FN_NONE;
}

fun fn_ir(e: *Emit, ix: u32) *ir.Function {
    ret ?e.u.mods[e.fns[ix].mi].ir.functions[e.fns[ix].ir_ix];
}

fun fn_mod(e: *Emit, ix: u32) *ir.Module {
    ret e.u.mods[e.fns[ix].mi].ir;
}

fun fn_mir(e: *Emit, ix: u32) *mir.MirFunction {
    if (e.fns[ix].mir_ix == FN_NONE) { ret nil; }
    ret ?e.u.mods[e.fns[ix].mi].mir.functions[e.fns[ix].mir_ix];
}

fun build_gl_table(e: *Emit) err[fail.Fail] {
    var n:  u32 = 0;
    var i0: u32 = 0;
    for (i0 < e.root.global_len) {
        if (gl_eligible(?e.root.globals[i0])) { n = n + 1; }
        i0 = i0 + 1;
    }
    var mi: u32 = 0;
    for (mi < e.u.len) {
        if (mi == e.u.root) {
            mi = mi + 1;
            cnt;
        }
        val m: *ir.Module = e.u.mods[mi].ir;
        var i: u32        = 0;
        for (i < m.global_len) {
            if (gl_eligible(?m.globals[i]) && global_is_reached(e, m.globals[i].name)) { n = n + 1; }
            i = i + 1;
        }
        mi = mi + 1;
    }
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val rt: res[*GlobalEnt, A.Error] = A.allocate[GlobalEnt](e.alloc, n::usize);
    if (sel rt.err) { ret err[fail.Fail].err{fail.refused(rt.err)}; }
    e.gls    = rt.ok;
    e.gl_len = n;

    var k:  u32 = 0;
    var i2: u32 = 0;
    for (i2 < e.root.global_len) {
        if (!gl_eligible(?e.root.globals[i2])) {
            i2 = i2 + 1;
            cnt;
        }
        e.gls[k].mi    = e.u.root;
        e.gls[k].ir_ix = i2;
        e.gls[k].name  = e.root.globals[i2].name;
        k              = k + 1;
        i2             = i2 + 1;
    }
    mi = 0;
    for (mi < e.u.len) {
        if (mi == e.u.root) {
            mi = mi + 1;
            cnt;
        }
        val m: *ir.Module = e.u.mods[mi].ir;
        var i: u32        = 0;
        for (i < m.global_len) {
            if (!gl_eligible(?m.globals[i]) || !global_is_reached(e, m.globals[i].name)) {
                i = i + 1;
                cnt;
            }
            e.gls[k].mi    = mi;
            e.gls[k].ir_ix = i;
            e.gls[k].name  = m.globals[i].name;
            k              = k + 1;
            i              = i + 1;
        }
        mi = mi + 1;
    }
    ret err[fail.Fail].ok{};
}

val ACCESS_WRITE: u8 = 1;
val ACCESS_READ:  u8 = 2;

fun build_gl_access(e: *Emit) err[fail.Fail] {
    if (e.gl_len == 0) { ret err[fail.Fail].ok{}; }
    val rw: res[*u8, A.Error] = A.allocate[u8](e.alloc, e.gl_len::usize);
    if (sel rw.err) { ret err[fail.Fail].err{fail.refused(rw.err)}; }
    e.gaccess = rw.ok;
    var i: u32 = 0;
    for (i < e.gl_len) {
        e.gaccess[i] = 0;
        i            = i + 1;
    }

    var fx: u32 = 0;
    for (fx < e.fn_len) {
        if (!e.fns[fx].emit) {
            fx = fx + 1;
            cnt;
        }
        val mf: *mir.MirFunction = fn_mir(e, fx);
        if (mf == nil) {
            fx = fx + 1;
            cnt;
        }
        val r: err[fail.Fail] = scan_fn_access(e, fx, mf);
        if (sel r.err) { ret r; }
        fx = fx + 1;
    }
    ret err[fail.Fail].ok{};
}

fun scan_fn_access(e: *Emit, fx: u32, mf: *mir.MirFunction) err[fail.Fail] {
    val n:       u32  = mf.vreg_count;
    var origin:  *u32 = nil;
    var horigin: *u32 = nil;
    if (n > 0) {
        val ro: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
        if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
        origin = ro.ok;
        val rh: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
        if (sel rh.err) {
            A.deallocate[u32](e.alloc, origin, n::usize);
            ret err[fail.Fail].err{fail.refused(rh.err)};
        }
        horigin = rh.ok;
        var v: u32 = 0;
        for (v < n) {
            origin[v]  = GL_NONE;
            horigin[v] = GL_NONE;
            v          = v + 1;
        }
    }
    val r: err[fail.Fail] = scan_fn_access_in(e, fx, mf, n, origin, horigin);
    if (origin != nil)  { A.deallocate[u32](e.alloc, origin, n::usize); }
    if (horigin != nil) { A.deallocate[u32](e.alloc, horigin, n::usize); }
    ret r;
}

# `origin` is the global a pointer register points into, `horigin` the handle
# global a register holds the descriptor of
fun scan_fn_access_in(e: *Emit, fx: u32, mf: *mir.MirFunction, n: u32, origin: *u32, horigin: *u32) err[fail.Fail] {
    var hb: u32 = 0;
    for (hb < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[hb];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val g: u32             = descriptor_load(e, ?blk.instrs[ii]);
            val d: *mir.MirOperand = ?blk.instrs[ii].operands[0];
            if (g != GL_NONE && horigin != nil && d.kind == mir.MIR_OP_VREG && d.vreg.n < n) { horigin[d.vreg.n] = g; }
            ii = ii + 1;
        }
        hb = hb + 1;
    }

    var changed: bool = true;
    for (changed) {
        changed = false;
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii:  u32           = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                ii = ii + 1;
                # an access chain, and an `op` pointer result, point into what their base names
                var dst_at:  u32 = 0;
                var base_at: u32 = 0;
                if (!derived_pointer(e, fx, mi, ?dst_at, ?base_at)) { cnt; }
                if (mi.operands[dst_at].kind != mir.MIR_OP_VREG)    { cnt; }
                val dst: u32 = mi.operands[dst_at].vreg.n;
                if (origin == nil || dst == mir.MIR_VREG_NIL.n || dst >= n) { cnt; }
                val g: u32 = operand_origin(e, origin, n, ?mi.operands[base_at]);
                if (g == GL_NONE || origin[dst] == g) { cnt; }
                if (origin[dst] != GL_NONE) {
                    val ra: err[fail.Fail] = mark_access(e, mi, origin[dst], ACCESS_WRITE | ACCESS_READ);
                    if (sel ra.err) { ret ra; }
                    val rb: err[fail.Fail] = mark_access(e, mi, g, ACCESS_WRITE | ACCESS_READ);
                    if (sel rb.err) { ret rb; }
                    cnt;
                }
                origin[dst] = g;
                changed     = true;
            }
            bi = bi + 1;
        }
    }

    var bi2: u32 = 0;
    for (bi2 < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi2];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi:  *mir.MirInstr = ?blk.instrs[ii];
            val row: *isa.OpDef    = call_op_row(e, fx, mi);
            # loading a handle reads its descriptor, not the memory it names
            val loads_handle: bool = descriptor_load(e, mi) != GL_NONE;
            var oi:           u32  = 0;
            for (oi < mi.operand_count) {
                if (loads_handle) {
                    oi = oi + 1;
                    cnt;
                }
                # a handle operand's memory is touched only as its row's kind says
                if (row != nil && oi >= 2 && isa.op_kind_is_handle(isa.op_operand_kind(row, oi - 2))) {
                    val hg: u32 = operand_origin(e, horigin, n, ?mi.operands[oi]);
                    var hw: u8  = ACCESS_READ;
                    if (isa.op_operand_kind(row, oi - 2) == isa.OP_OPERAND_HANDLE_WRITE) { hw = ACCESS_WRITE; }
                    if (hg != GL_NONE) {
                        val rh: err[fail.Fail] = mark_access(e, mi, hg, hw);
                        if (sel rh.err) { ret rh; }
                    }
                    oi = oi + 1;
                    cnt;
                }
                # a handle handed to a function may have its memory read and written by the callee
                if (row == nil && mi.opcode == mir.MIR_VALUE_CALL && oi >= 2) {
                    val cg: u32 = operand_origin(e, horigin, n, ?mi.operands[oi]);
                    if (cg != GL_NONE) {
                        val rc: err[fail.Fail] = mark_access(e, mi, cg, ACCESS_WRITE | ACCESS_READ);
                        if (sel rc.err) { ret rc; }
                    }
                }
                val g: u32 = operand_origin(e, origin, n, ?mi.operands[oi]);
                if (g == GL_NONE) {
                    oi = oi + 1;
                    cnt;
                }
                var how: u8 = 0;
                if (row != nil) { how = op_operand_access(row, oi); }
                or {
                    if (!operand_only_reads(mi, oi))  { how = how | ACCESS_WRITE; }
                    if (!operand_never_reads(mi, oi)) { how = how | ACCESS_READ; }
                }
                val rm: err[fail.Fail] = mark_access(e, mi, g, how);
                if (sel rm.err) { ret rm; }
                oi = oi + 1;
            }
            ii = ii + 1;
        }
        bi2 = bi2 + 1;
    }
    ret err[fail.Fail].ok{};
}

# the handle global a load reads the descriptor of, GL_NONE for any other instruction
fun descriptor_load(e: *Emit, mi: *mir.MirInstr) u32 {
    if (mi.opcode != mir.MIR_LOAD || mi.operand_count != 2)                   { ret GL_NONE; }
    if (mi.operands[1].kind != mir.MIR_OP_SYM || mi.operands[1].sym_off != 0) { ret GL_NONE; }
    val g: u32 = gl_lookup(e, mi.operands[1].sym);
    if (g == GL_NONE || !is_image_type(e, gl_types(e, g), gl_ir(e, g).ty)) { ret GL_NONE; }
    ret g;
}

# the instruction row an `op` call assembles, nil for any other instruction
fun call_op_row(e: *Emit, fx: u32, mi: *mir.MirInstr) *isa.OpDef {
    ret call_op_row_in(e, fn_mod(e, fx), mi);
}

fun call_op_row_in(e: *Emit, m: *ir.Module, mi: *mir.MirInstr) *isa.OpDef {
    if (mi.opcode != mir.MIR_VALUE_CALL || mi.operand_count < 2) { ret nil; }
    if (mi.operands[0].kind != mir.MIR_OP_SYM)                   { ret nil; }
    val callee: *ir.Function = ir_function_record(m, mi.operands[0].sym);
    if (callee == nil || callee.op_set == defs.SPV_SET_NONE) { ret nil; }
    ret isa.op_def_by_code(e.tgt.defs, callee.op_set, callee.op_code);
}

# the operand an instruction defines as a pointer into what another operand
# names: a chain's base, or an `op` pointer result's first pointer operand
fun derived_pointer(e: *Emit, fx: u32, mi: *mir.MirInstr, out_dst: *u32, out_base: *u32) bool {
    if (mi.opcode == mir.MIR_GEP && mi.operand_count >= 2) {
        @out_dst  = 0;
        @out_base = 1;
        ret true;
    }
    val row: *isa.OpDef = call_op_row(e, fx, mi);
    if (row == nil || row.result != isa.OP_RESULT_POINTER) { ret false; }
    var i: u32 = 0;
    for (i < row.arity && i + 2 < mi.operand_count) {
        if (isa.op_kind_is_pointer(isa.op_operand_kind(row, i))) {
            @out_dst  = 1;
            @out_base = i + 2;
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

# how an `op` call touches what operand `oi` names, exactly as its row says: the
# callee and a pointer result it defines are no access, a pointer operand is read,
# stored or both, and anything else is a value read from its object
fun op_operand_access(row: *isa.OpDef, oi: u32) u8 {
    if (oi < 2) { ret 0; }
    val kind: isa.OpOperandKind = isa.op_operand_kind(row, oi - 2);
    # a pointer result's base is touched by the result's own uses, never by deriving it
    val base: bool = row.result == isa.OP_RESULT_POINTER && isa.op_kind_is_pointer(kind) && first_pointer_operand(row) == oi - 2;
    if (base)                                  { ret 0; }
    if (kind == isa.OP_OPERAND_POINTER_WRITE)  { ret ACCESS_WRITE; }
    if (kind == isa.OP_OPERAND_POINTER_UPDATE) { ret ACCESS_WRITE | ACCESS_READ; }
    ret ACCESS_READ;
}

fun first_pointer_operand(row: *isa.OpDef) u32 {
    var i: u32 = 0;
    for (i < row.arity) {
        if (isa.op_kind_is_pointer(isa.op_operand_kind(row, i))) { ret i; }
        i = i + 1;
    }
    ret row.arity;
}

fun operand_only_reads(mi: *mir.MirInstr, oi: u32) bool {
    val op: mir.MirOpcode = mi.opcode;
    if (op == mir.MIR_LOAD)   { ret oi == 1; }
    if (op == mir.MIR_GEP)    { ret oi < 2; }
    if (op == mir.MIR_MEMCPY) { ret oi == 1; }
    # a by-value argument is loaded from its object; a reference argument may be written through by the callee
    if (op == mir.MIR_VALUE_CALL) { ret oi >= 2 && mi.operands[oi].kind == mir.MIR_OP_MEM; }
    if (op == mir.MIR_RET)        { ret oi == 0; }
    ret false;
}

fun operand_origin(e: *Emit, origin: *u32, n: u32, op: *mir.MirOperand) u32 {
    if (op.kind == mir.MIR_OP_SYM)                                   { ret gl_lookup(e, op.sym); }
    if (op.kind != mir.MIR_OP_VREG && op.kind != mir.MIR_OP_MEM)     { ret GL_NONE; }
    if (origin == nil || mir.vreg_is_nil(op.vreg) || op.vreg.n >= n) { ret GL_NONE; }
    ret origin[op.vreg.n];
}

# an address operand the instruction writes through or only offsets, never loading what it names
fun operand_never_reads(mi: *mir.MirInstr, oi: u32) bool {
    val op: mir.MirOpcode = mi.opcode;
    if (op == mir.MIR_STORE)   { ret oi == 0; }
    if (op == mir.MIR_MEMCPY)  { ret oi == 0; }
    if (op == mir.MIR_MEMZERO) { ret oi == 0; }
    if (op == mir.MIR_GEP)     { ret oi < 2; }
    ret false;
}

fun mark_access(e: *Emit, mi: *mir.MirInstr, gix: u32, how: u8) err[fail.Fail] {
    if (gix >= e.gl_len || e.gaccess == nil) { ret err[fail.Fail].ok{}; }
    val fresh: u8 = how & ~e.gaccess[gix];
    if (fresh == 0) { ret err[fail.Fail].ok{}; }
    e.gaccess[gix] = e.gaccess[gix] | fresh;
    val g: *ir.Global = gl_ir(e, gix);
    if ((fresh & ACCESS_WRITE) != 0 && (g.iface_flags & ir.IFACE_FLAG_READONLY) != 0) {
        if (g.iface == ir.IFACE_SPEC) {
            val sr: res[str, format.FormatError] = format.sprint(e.alloc,
                "a store reaches the `#[spec({})]` var{}: a specialization constant is supplied by the host at pipeline creation and is a constant from then on, so a shader has no storage to write it through. copy it into a local to change the value",
                g.iface_a, gl_mod_prefix(e, gix));
            if (sel sr.err) {
                ret err[fail.Fail].err{fail.message("spirv.emit: a store reaches a `#[spec]` var")};
            }
            ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_READONLY_STORE, mir.refusal_loc(e.cur_fn, mi), sr.ok)};
        }
        if (g.iface == ir.IFACE_PUSH) {
            val pr: res[str, format.FormatError] = format.sprint(e.alloc,
                "a store reaches the `#[push]` block{}: a push-constant block is written by the host with the command that records the dispatch or draw, and a shader only reads it. copy the value into a local to change it",
                gl_mod_prefix(e, gix));
            if (sel pr.err) {
                ret err[fail.Fail].err{fail.message("spirv.emit: a store reaches a `#[push]` block")};
            }
            ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_READONLY_STORE, mir.refusal_loc(e.cur_fn, mi), pr.ok)};
        }
        val r: res[str, format.FormatError] = format.sprint(e.alloc,
            "a store reaches the `#[storage({}, {}, \"readonly\")]` binding{}: the qualifier declares that nothing writes it, which is what lets this module mark the descriptor `NonWritable` and a vertex stage read it without `vertexPipelineStoresAndAtomics`. drop the `\"readonly\"` qualifier to write it",
            g.iface_a, g.iface_b, gl_mod_prefix(e, gix));
        if (sel r.err) {
            ret err[fail.Fail].err{fail.message("spirv.emit: a store reaches a `\"readonly\"` storage binding")};
        }
        ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_READONLY_STORE, mir.refusal_loc(e.cur_fn, mi), r.ok)};
    }
    if ((fresh & ACCESS_READ) != 0 && (g.iface_flags & ir.IFACE_FLAG_WRITEONLY) != 0) {
        val r: res[str, format.FormatError] = format.sprint(e.alloc,
            "a load reaches the `#[storage({}, {}, \"writeonly\")]` binding{}: the qualifier declares that nothing reads it, which is what lets this module mark the descriptor `NonReadable`. drop the `\"writeonly\"` qualifier to read it",
            g.iface_a, g.iface_b, gl_mod_prefix(e, gix));
        if (sel r.err) {
            ret err[fail.Fail].err{fail.message("spirv.emit: a load reaches a `\"writeonly\"` storage binding")};
        }
        ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_WRITEONLY_LOAD, mir.refusal_loc(e.cur_fn, mi), r.ok)};
    }
    ret err[fail.Fail].ok{};
}

fun gl_written(e: *Emit, ix: u32) bool {
    if (e.gaccess == nil || ix >= e.gl_len) { ret true; }
    ret (e.gaccess[ix] & ACCESS_WRITE) != 0;
}

fun global_is_reached(e: *Emit, name: intern.StrId) bool {
    var fx: u32 = 0;
    for (fx < e.fn_len) {
        if (!e.fns[fx].emit) {
            fx = fx + 1;
            cnt;
        }
        val fn: *ir.Function = fn_ir(e, fx);
        if (fn.wg_spec[0] == name || fn.wg_spec[1] == name || fn.wg_spec[2] == name) { ret true; }
        val mf: *mir.MirFunction = fn_mir(e, fx);
        if (mf == nil) {
            fx = fx + 1;
            cnt;
        }
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii:  u32           = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                var oi: u32           = 0;
                for (oi < mi.operand_count) {
                    if (mi.operands[oi].kind == mir.MIR_OP_SYM
                        && mi.operands[oi].sym == name) { ret true; }
                    oi = oi + 1;
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        fx = fx + 1;
    }
    ret false;
}

fun gl_eligible(g: *ir.Global) bool {
    ret !g.is_extern && !g.is_import;
}

fun gl_ir(e: *Emit, ix: u32) *ir.Global {
    ret ?e.u.mods[e.gls[ix].mi].ir.globals[e.gls[ix].ir_ix];
}

fun gl_types(e: *Emit, ix: u32) *type.IrTypeTable {
    ret ?e.u.mods[e.gls[ix].mi].ir.types;
}

fun gl_lookup(e: *Emit, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < e.gl_len) {
        if (e.gls[i].name == name) { ret i; }
        i = i + 1;
    }
    ret GL_NONE;
}

fun gl_mod_prefix(e: *Emit, ix: u32) str {
    if (ix >= e.gl_len || e.gls[ix].mi == e.u.root) { ret ""; }
    val mo: opt[str] = intern.lookup(e.interner, e.u.mods[e.gls[ix].mi].ir.name);
    if (sel mo.none) { ret ""; }
    val q: res[str, format.FormatError] = format.sprint(e.alloc, ", declared in `{}`", mo.some);
    if (sel q.err) { ret ""; }
    ret q.ok;
}

fun declare_interface(e: *Emit) err[fail.Fail] {
    val n: u32 = e.gl_len;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val rg: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rg.err) { ret err[fail.Fail].err{fail.refused(rg.err)}; }
    e.gvar_ids = rg.ok;

    val rs: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    e.gslot = rs.ok;
    val rt: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rt.err) { ret err[fail.Fail].err{fail.refused(rt.err)}; }
    e.gtype_ids = rt.ok;
    val rc: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rc.err) { ret err[fail.Fail].err{fail.refused(rc.err)}; }
    e.gstorage = rc.ok;
    val rp: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rp.err) { ret err[fail.Fail].err{fail.refused(rp.err)}; }
    e.gspec = rp.ok;

    var i: u32 = 0;
    for (i < n) {
        e.gvar_ids[i]  = 0;
        e.gslot[i]     = 0;
        e.gtype_ids[i] = 0;
        e.gstorage[i]  = 0;
        e.gspec[i]     = 0;
        i              = i + 1;
    }

    i = 0;
    for (i < n) {
        val g:  *ir.Global        = gl_ir(e, i);
        val gt: *type.IrTypeTable = gl_types(e, i);
        if (g.iface == ir.IFACE_NONE) {
            i = i + 1;
            cnt;
        }
        if (g.iface == ir.IFACE_SPEC) {
            val sr: err[fail.Fail] = declare_spec(e, i);
            if (sel sr.err) { ret sr; }
            i = i + 1;
            cnt;
        }

        if (g.iface == ir.IFACE_BUILTIN) {
            val br: str = builtin_type_refusal(gt, e.alloc, g.iface_a, g.ty);
            if (br != nil) { ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, br)}; }
        }

        val handle:  bool = is_image_type(e, gt, g.ty);
        var storage: u32  = spirv.STORAGE_INPUT;
        if (g.iface == ir.IFACE_OUTPUT)  { storage = spirv.STORAGE_OUTPUT; }
        or (g.iface == ir.IFACE_UNIFORM) { storage = spirv.STORAGE_UNIFORM; }
        or (g.iface == ir.IFACE_STORAGE) { storage = spirv.storage_buffer_class(e.b.version); }
        or (g.iface == ir.IFACE_SAMPLER) { storage = spirv.STORAGE_UNIFORM_CONSTANT; }
        or (g.iface == ir.IFACE_PUSH)    { storage = spirv.STORAGE_PUSH_CONSTANT; }
        or (g.iface == ir.IFACE_BUILTIN) { storage = builtin_storage(g.iface_a); }
        or (g.iface == ir.IFACE_SHARED)  { storage = spirv.STORAGE_WORKGROUP; }
        # every handle variable lives in UniformConstant, a storage image's included
        if (handle) { storage = spirv.STORAGE_UNIFORM_CONSTANT; }

        if (handle && g.iface != handle_role(e, gt, g.ty)) {
            ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "an image handle carries an interface role other than the descriptor it binds as: a storage image is `#[storage(set, binding)]`, every other handle `#[sampler(set, binding)]`, and a handle reaches no other storage class")};
        }
        if (!handle && g.iface == ir.IFACE_SAMPLER) {
            ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "a `#[sampler(set, binding)]` binding is not of an image handle type; a descriptor-bound block or buffer of an ordinary type is `#[uniform]` or `#[storage]`")};
        }

        var value_ty: u32 = 0;
        if (is_block_iface(g.iface) && !handle) {
            val ur: res[u32, fail.Fail] = block_type(e, gt, g.ty, g.iface);
            if (sel ur.err) { ret err[fail.Fail].err{ur.err}; }
            value_ty = ur.ok;
        }
        or (g.iface == ir.IFACE_INPUT || g.iface == ir.IFACE_OUTPUT) { value_ty = spv_type_shaped(e, gt, g.ty, stage_half(e)); }
        or                                                           { value_ty = global_spv_type(e, gt, g.ty); }
        if (value_ty == 0) {
            ret unsupported(e, "unsupported shader interface variable type in the SPIR-V target");
        }
        val ptr_ty: u32 = types.type_ptr(e.tt, storage, value_ty);
        val var_id: u32 = spirv.alloc_id(e.b);
        var vop:    [4]u32;
        vop[0] = ptr_ty;
        vop[1] = var_id;
        vop[2] = storage;
        var vn: u32 = 3;
        if (g.iface == ir.IFACE_SHARED && shared_native_zero(e)) {
            vop[3] = types.const_null(e.tt, value_ty);
            vn     = 4;
        }
        or (storage == spirv.STORAGE_OUTPUT) {
            vop[3] = output_initializer(e, gt, g, value_ty);
            vn     = 4;
            if (vop[3] == 0) {
                ret unsupported(e, "an output's initializer is not a constant the SPIR-V target can spell: an output starts at a constant of its own type, and this one holds an address or a type no constant composite has");
            }
        }
        spirv.inst(e.b, ?e.b.types_consts, spirv.OP_VARIABLE, ?vop[0], vn);
        e.gvar_ids[i]  = var_id;
        e.gtype_ids[i] = value_ty;
        e.gstorage[i]  = storage;
        dbgm.name_shown(?e.dbg, var_id, g.disp, g.name);
        if (is_block_iface(g.iface) && !handle) { dbgm.record(?e.dbg, value_ty, g.ty_sem); }

        if (g.iface == ir.IFACE_INPUT || g.iface == ir.IFACE_OUTPUT) {
            decorate(e, var_id, spirv.DECOR_LOCATION, g.iface_a);
        }
        if (g.iface == ir.IFACE_BUILTIN) {
            decorate(e, var_id, spirv.DECOR_BUILTIN, builtin_selector(g.iface_a));
            val rq: err[fail.Fail] = require_at(e, source.loc_nil(), 0, builtin_capability(g.iface_a), 0,
                builtin_decl_text(e, i));
            if (sel rq.err) { ret rq; }
        }
        if (g.iface == ir.IFACE_UNIFORM || g.iface == ir.IFACE_STORAGE
            || g.iface == ir.IFACE_SAMPLER) {
            decorate(e, var_id, spirv.DECOR_DESCRIPTOR_SET, g.iface_a);
            decorate(e, var_id, spirv.DECOR_BINDING, g.iface_b);
        }
        if (g.iface == ir.IFACE_STORAGE && !gl_written(e, i)) {
            decorate_bare(e, var_id, spirv.DECOR_NON_WRITABLE);
        }
        decorate_memory_quals(e, var_id, g.iface_flags);
        e.gslot[i]  = e.iface_len + 1;
        e.iface_len = e.iface_len + 1;
        i           = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a specialization constant is no variable: it is an OpSpecConstant whose literal is the
# initializer, the default a pipeline keeps unless it supplies the SpecId
fun declare_spec(e: *Emit, i: u32) err[fail.Fail] {
    val g:      *ir.Global        = gl_ir(e, i);
    val gt:     *type.IrTypeTable = gl_types(e, i);
    val t:      opt[*type.IrType] = type.get(gt, g.ty);
    var scalar: bool              = false;
    if (sel t.some) { scalar = t.some.kind == type.IRT_INT || t.some.kind == type.IRT_FLOAT; }
    if (!scalar) {
        val nr: res[str, format.FormatError] = format.sprint(e.alloc,
            "a `#[spec({})]` var must be a scalar integer or float{}: a specialization constant is one literal the host supplies, and this one is {}",
            g.iface_a, gl_mod_prefix(e, i), ir_type_spelling(gt, e.alloc, g.ty));
        if (sel nr.err) { ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "a `#[spec]` var must be a scalar integer or float")}; }
        ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, nr.ok)};
    }
    var j: u32 = 0;
    for (j < i) {
        val o: *ir.Global = gl_ir(e, j);
        if (o.iface == ir.IFACE_SPEC && o.iface_a == g.iface_a) {
            val dr: res[str, format.FormatError] = format.sprint(e.alloc,
                "two `#[spec({})]` vars share one SpecId: `{}`{} and `{}`{}. a pipeline supplies a specialization constant by its id, so one id names one constant in a module. give them different ids",
                g.iface_a, spec_name(e, j), gl_mod_prefix(e, j), spec_name(e, i), gl_mod_prefix(e, i));
            if (sel dr.err) { ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "two `#[spec]` vars share one SpecId")}; }
            ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, dr.ok)};
        }
        j = j + 1;
    }
    val value_ty: u32 = global_spv_type(e, gt, g.ty);
    if (value_ty == 0) { ret unsupported(e, "unsupported specialization constant type in the SPIR-V target"); }
    val bits: u32 = types.type_bits(e.tt, value_ty);
    val lit:  u64 = scalar_literal(?g.init, bits);
    val id:   u32 = spirv.alloc_id(e.b);
    var ops:  [4]u32;
    ops[0] = value_ty;
    ops[1] = id;
    ops[2] = (lit & 0xFFFFFFFF)::u32;
    ops[3] = (lit >> 32)::u32;
    var n: u32 = 3;
    if (bits > 32) { n = 4; }
    spirv.inst(e.b, ?e.b.types_consts, spirv.OP_SPEC_CONSTANT, ?ops[0], n);
    decorate(e, id, spirv.DECOR_SPEC_ID, g.iface_a);
    dbgm.name_shown(?e.dbg, id, g.disp, g.name);
    e.gspec[i]     = id;
    e.gtype_ids[i] = value_ty;
    ret err[fail.Fail].ok{};
}

# the bits of a scalar constant as a `bits`-wide literal
fun scalar_literal(v: *value.Value, bits: u32) u64 {
    var lit: u64 = v.data.int_lit;
    if (v.kind == value.VAL_CONST_FLOAT) {
        lit = float.bits_at(float.bits_f64(v.data.int_lit), float.width_of_bits(bits));
    }
    or (v.kind != value.VAL_CONST_INT) { lit = 0; }
    if (bits < 64)                     { lit = lit & ((1::u64 << bits::u64) - 1); }
    ret lit;
}

# the constant an Output variable starts at (#4287): its initializer, spelled as
# OpConstantNull where that is zero, which is also what an output declared without one
# holds, as every mach `var` does. 0 where the initializer has no constant form
fun output_initializer(e: *Emit, gt: *type.IrTypeTable, g: *ir.Global, value_ty: u32) u32 {
    val v:    *value.Value      = ?g.init;
    val half: bool              = g.iface == ir.IFACE_OUTPUT && stage_half(e);
    val t:    opt[*type.IrType] = type.get(gt, g.ty);
    if (sel t.none)                     { ret 0; }
    if (v.kind == value.VAL_CONST_NULL) { ret types.const_null(e.tt, value_ty); }
    if (v.kind == value.VAL_CONST_INT || v.kind == value.VAL_CONST_FLOAT) {
        val scalar: bool = t.some.kind == type.IRT_INT || t.some.kind == type.IRT_FLOAT;
        if (v.data.int_lit == 0 && v.kind == value.VAL_CONST_INT) { ret types.const_null(e.tt, value_ty); }
        if (!scalar)                                              { ret 0; }
        val lit: u64 = scalar_literal(v, types.type_bits(e.tt, value_ty));
        if (lit == 0) { ret types.const_null(e.tt, value_ty); }
        ret types.const_scalar(e.tt, value_ty, (lit & 0xFFFFFFFF)::u32, (lit >> 32)::u32);
    }
    if (v.kind == value.VAL_CONST_AGG) {
        if (v.data.agg.reloc_count != 0) { ret 0; }
        ret image_constant(e, gt, g.ty, value_ty, half, v.data.agg.bytes, v.data.agg.len, 0);
    }
    if (v.kind == value.VAL_CONST_BYTES) {
        ret image_constant(e, gt, g.ty, value_ty, half, v.data.bytes.ptr, v.data.bytes.len, 0);
    }
    ret 0;
}

# the constant of `spv_ty` that the byte image of ir type `id` at `off` spells, laid out
# as the target lays the type out; a byte past the image is zero
fun image_constant(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, spv_ty: u32, half: bool,
    bytes: *u8, len: u32, off: u32) u32 {
    if (spv_ty == 0) { ret 0; }
    val size: u32  = type.byte_size_for_machine(gt, id, e.layout);
    var zero: bool = true;
    var k:    u32  = 0;
    for (k < size && zero) {
        if (off + k < len && bytes[off + k] != 0) { zero = false; }
        k = k + 1;
    }
    if (zero) { ret types.const_null(e.tt, spv_ty); }

    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret 0; }
    val t: *type.IrType = opt_.some;
    if (t.kind == type.IRT_INT || t.kind == type.IRT_FLOAT) {
        if (size > 8) { ret 0; }
        var lit: u64 = 0;
        k = 0;
        for (k < size) {
            if (off + k < len) { lit = lit | (bytes[off + k]::u64 << (k * 8)::u64); }
            k = k + 1;
        }
        ret types.const_scalar(e.tt, spv_ty, (lit & 0xFFFFFFFF)::u32, (lit >> 32)::u32);
    }
    var n:    u32           = 0;
    var elem: type.IrTypeId = type.IRT_NIL;
    if (t.kind == type.IRT_VECTOR) {
        n    = t.data.vector_.lanes;
        elem = t.data.vector_.element;
    }
    or (t.kind == type.IRT_ARRAY) {
        n    = t.data.array_.count;
        elem = t.data.array_.element;
    }
    or (t.kind == type.IRT_STRUCT) { n = t.data.struct_.field_count; }
    or                             { ret 0; }
    if (n == 0)                    { ret 0; }

    val rp: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rp.err) { ret 0; }
    val parts: *u32 = rp.ok;
    var ok:    bool = true;
    var i:     u32  = 0;
    for (i < n && ok) {
        var mid:  type.IrTypeId = elem;
        var moff: u32           = off;
        if (t.kind == type.IRT_STRUCT) {
            mid  = t.data.struct_.fields[i];
            moff = off + type.byte_offset_for_machine(gt, id, i, e.layout);
        }
        or { moff = off + i * type.byte_size_for_machine(gt, elem, e.layout); }
        parts[i] = image_constant(e, gt, mid, spv_type_shaped(e, gt, mid, half), half, bytes, len, moff);
        if (parts[i] == 0) { ok = false; }
        i = i + 1;
    }
    var c: u32 = 0;
    if (ok) { c = types.const_composite(e.tt, spv_ty, parts, n); }
    A.deallocate[u32](e.alloc, parts, n::usize);
    ret c;
}

fun spec_name(e: *Emit, i: u32) str {
    val g: *ir.Global   = gl_ir(e, i);
    var n: intern.StrId = g.disp;
    if (n == intern.STR_NIL) { n = g.name; }
    val o: opt[str] = intern.lookup(e.interner, n);
    if (sel o.none) { ret "?"; }
    ret o.some;
}

fun spec_target(e: *Emit, op: *mir.MirOperand) u32 {
    if (e.gspec == nil || op.kind != mir.MIR_OP_SYM || op.sym_off != 0) { ret 0; }
    val gx: u32 = gl_lookup(e, op.sym);
    if (gx == GL_NONE) { ret 0; }
    ret e.gspec[gx];
}

# the environment admits LocalSizeId: SPIR-V 1.2 without an environment, and on
# Vulkan the maintenance4 feature only Vulkan 1.3 guarantees
fun local_size_id_admitted(e: *Emit) bool {
    if (e.tgt.identity.env_id == isa.ENV_NONE) { ret e.b.version >= spirv.SPV_VERSION_1_2; }
    val p: *spirv.EnvProfile = spirv.env_profile(e.tgt.identity.env_profile);
    ret p != nil && p.local_size_id;
}

fun wg_is_spec(fn: *ir.Function) bool {
    ret fn.wg_spec[0] != intern.STR_NIL || fn.wg_spec[1] != intern.STR_NIL || fn.wg_spec[2] != intern.STR_NIL;
}

fun wg_literal(fn: *ir.Function, d: u32) u32 {
    if (d == 0) { ret fn.wg_x; }
    if (d == 1) { ret fn.wg_y; }
    ret fn.wg_z;
}

# the id a workgroup dimension is: its `#[spec]` var's constant, or a 32-bit OpConstant
fun wg_dim_id(e: *Emit, fn: *ir.Function, d: u32) res[u32, fail.Fail] {
    val name: intern.StrId = fn.wg_spec[d];
    if (name == intern.STR_NIL) { ret res[u32, fail.Fail].ok{types.const_int(e.tt, 32, wg_literal(fn, d)::i64)}; }
    val gx: u32 = gl_lookup(e, name);
    var id: u32 = 0;
    if (gx != GL_NONE && e.gspec != nil) { id = e.gspec[gx]; }
    if (id == 0) {
        ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "a `#[workgroup]` dimension names a var that is not a `#[spec(id)]` var: a dimension is a constant or a specialization constant the host supplies at pipeline creation")};
    }
    val ty: u32 = e.gtype_ids[gx];
    if (types.type_is_float(e.tt, ty) || types.type_bits(e.tt, ty) != 32) {
        ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "a `#[spec]` var sizing a `#[workgroup]` dimension must be a 32-bit integer: a workgroup size is three 32-bit integers")};
    }
    ret res[u32, fail.Fail].ok{id};
}

fun wg_same(a: *ir.Function, b: *ir.Function) bool {
    var d: u32 = 0;
    for (d < 3) {
        if (a.wg_spec[d] != b.wg_spec[d])                                           { ret false; }
        if (a.wg_spec[d] == intern.STR_NIL && wg_literal(a, d) != wg_literal(b, d)) { ret false; }
        d = d + 1;
    }
    ret true;
}

# without LocalSizeId a specialized workgroup is the WorkgroupSize built-in over a
# spec composite, which sizes every compute stage in the module, so they must agree
fun plan_workgroup(e: *Emit) err[fail.Fail] {
    var first: *ir.Function = nil;
    var spec:  bool         = false;
    var fx:    u32          = 0;
    for (fx < e.fn_len) {
        if (!e.fns[fx].emit) {
            fx = fx + 1;
            cnt;
        }
        val fn: *ir.Function = fn_ir(e, fx);
        if (fn.stage != ir.STAGE_COMPUTE) {
            fx = fx + 1;
            cnt;
        }
        if (wg_is_spec(fn)) { spec = true; }
        if (first == nil)   { first = fn; }
        or (!wg_same(first, fn) && (spec || wg_is_spec(first)) && !local_size_id_admitted(e)) {
            ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "compute stages in one module size their workgroups differently and one of them by a `#[spec]` var: this environment has no LocalSizeId, so a specialized workgroup is the WorkgroupSize built-in, which sizes every compute stage in the module at once. give the stages one workgroup, split them into modules, or target vulkan1.3")};
        }
        fx = fx + 1;
    }
    if (!spec || local_size_id_admitted(e)) { ret err[fail.Fail].ok{}; }
    var parts: [3]u32;
    var d:     u32 = 0;
    for (d < 3) {
        val r: res[u32, fail.Fail] = wg_dim_id(e, first, d);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        parts[d] = r.ok;
        d        = d + 1;
    }
    val vec: u32 = types.type_vector(e.tt, types.type_int(e.tt, 32), 3);
    val id:  u32 = spirv.alloc_id(e.b);
    var ops: [5]u32;
    ops[0] = vec;
    ops[1] = id;
    ops[2] = parts[0];
    ops[3] = parts[1];
    ops[4] = parts[2];
    spirv.inst(e.b, ?e.b.types_consts, spirv.OP_SPEC_CONSTANT_COMPOSITE, ?ops[0], 5);
    decorate(e, id, spirv.DECOR_BUILTIN, spirv.BUILTIN_WORKGROUP_SIZE);
    e.wg_builtin = true;
    ret err[fail.Fail].ok{};
}

fun is_block_iface(iface: u8) bool {
    ret iface == ir.IFACE_UNIFORM || iface == ir.IFACE_STORAGE || iface == ir.IFACE_PUSH;
}

# an f16 crosses a stage interface as the OpTypeFloat 16 it is where the
# selection holds Float16, and is carried inside the module as its bits (#3801)
fun stage_half(e: *Emit) bool {
    ret (e.tgt.model.extensions & spirv.EXT_FLOAT16) != 0;
}

# a memory type and a value type that are an f16 and its 16-bit carrier, in
# either order, or two vectors of as many of them (#3802): the two meet through
# OpBitcast at the load or store
fun half_carrier_pair(e: *Emit, a: u32, b: u32) bool {
    if (a == 0 || b == 0 || a == b) { ret false; }
    var na:     u32 = 0;
    var nb:     u32 = 0;
    val a_lane: u32 = types.vector_shape(e.tt, a, ?na);
    val b_lane: u32 = types.vector_shape(e.tt, b, ?nb);
    if (a_lane != 0 || b_lane != 0)                                       { ret na == nb && half_carrier_pair(e, a_lane, b_lane); }
    if (types.type_bits(e.tt, a) != 16 || types.type_bits(e.tt, b) != 16) { ret false; }
    ret types.type_is_float(e.tt, a) != types.type_is_float(e.tt, b);
}

fun emit_bitcast(e: *Emit, to_ty: u32, value: u32) u32 {
    val result: u32 = spirv.alloc_id(e.b);
    var words:  [3]u32;
    words[0] = to_ty;
    words[1] = result;
    words[2] = value;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_BITCAST, ?words[0], 3);
    ret result;
}

fun block_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, role: u8) res[u32, fail.Fail] {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: uniform global has no IR type")}; }
    val t: *type.IrType = opt_.some;
    if (t.kind != type.IRT_STRUCT) {
        val rr: res[str, format.FormatError] = format.sprint(e.alloc,
            "a `{}` variable must be a `rec`: it is a BLOCK with a host-visible layout, and a bare scalar or vector has no block layout for a pipeline to bind. wrap the value in a record with one field",
            block_role(role));
        if (sel rr.err) { ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "an interface block variable must be a `rec`")}; }
        ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, rr.ok)};
    }
    val n: u32 = t.data.struct_.field_count;
    if (n == 0 || n > types.MAX_STRUCT_MEMBERS) {
        ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "a `#[uniform(...)]` / `#[storage(...)]` / `#[push]` block must have between 1 and 16 fields")};
    }

    val sr: res[u32, fail.Fail] = laid_out_struct(e, gt, id, role);
    if (sel sr.err) { ret sr; }
    val struct_id: u32 = sr.ok;

    var bops: [2]u32;
    bops[0] = struct_id;
    bops[1] = spirv.DECOR_BLOCK;
    if (role == ir.IFACE_STORAGE) { bops[1] = spirv.storage_block_decoration(e.b.version); }
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?bops[0], 2);
    ret res[u32, fail.Fail].ok{struct_id};
}

fun laid_out_struct(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, role: u8) res[u32, fail.Fail] {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: uniform block member has no IR type")}; }
    val t: *type.IrType = opt_.some;
    val n: u32          = t.data.struct_.field_count;
    if (n == 0 || n > types.MAX_STRUCT_MEMBERS) {
        ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "a `#[uniform(...)]` / `#[storage(...)]` block must have between 1 and 16 fields")};
    }

    var members: [16]u32;
    var i:       u32 = 0;
    for (i < n) {
        val mr: res[u32, fail.Fail] = laid_out_type(e, gt, t.data.struct_.fields[i], role);
        if (sel mr.err) { ret mr; }
        members[i] = mr.ok;
        i          = i + 1;
    }

    val lr: err[fail.Fail] = check_block_layout(e, gt, id, role);
    if (sel lr.err) { ret res[u32, fail.Fail].err{lr.err}; }
    val struct_id: u32 = types.type_struct(e.tt, ?members[0], n, true);
    if (struct_id == 0) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: could not build a uniform block type")}; }

    i = 0;
    for (i < n) {
        var mops: [4]u32;
        mops[0] = struct_id;
        mops[1] = i;
        mops[2] = spirv.DECOR_OFFSET;
        mops[3] = type.byte_offset_for_machine(gt, id, i, e.layout);
        spirv.inst(e.b, ?e.b.decorations, spirv.OP_MEMBER_DECORATE, ?mops[0], 4);
        i = i + 1;
    }
    ret res[u32, fail.Fail].ok{struct_id};
}

fun laid_out_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, role: u8) res[u32, fail.Fail] {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: uniform block member has no IR type")}; }
    val t: *type.IrType = opt_.some;

    if (t.kind == type.IRT_STRUCT) { ret laid_out_struct(e, gt, id, role); }

    if (t.kind == type.IRT_TAG) {
        val tr: res[str, format.FormatError] = format.sprint(e.alloc,
            "a `tag` inside a `{}` block is not supported by the SPIR-V target: the block's layout is the host's contract, mach places every case payload at one common offset, and SPIR-V block members may not overlap, so no member offsets can describe where the host writes the payload. keep the tag in Function storage or an `#[input]` / `#[output]` variable, or carry the discriminator and the payload as separate block members{}",
            block_role(role), storage_hint(role));
        if (sel tr.err) { ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "a `tag` inside a block is not supported by the SPIR-V target")}; }
        ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, tr.ok)};
    }

    if (t.kind == type.IRT_ARRAY) {
        val er: res[u32, fail.Fail] = laid_out_type(e, gt, t.data.array_.element, role);
        if (sel er.err) { ret er; }
        val elem_ty: u32 = er.ok;
        val stride:  u32 = type.byte_size_for_machine(gt, t.data.array_.element, e.layout);
        val want:    u32 = required_stride(e, gt, t.data.array_.element, is_std430(role));
        if (want == 0) {
            ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "unsupported uniform block member type in the SPIR-V target")};
        }
        if (stride != want) {
            val ar: res[str, format.FormatError] = format.sprint(e.alloc,
                "an array inside a `{}` block needs an element stride of {} bytes in the SPIR-V target, and mach's layout packs it at {}: a block's array stride is rounded up to the element's base alignment, which mach's own layout does not do, so the shader and the host would disagree about where the elements are. pad the element to {} bytes, or use an element that is that wide already (`f32x4`){}",
                block_role(role), want, stride, want, storage_hint(role));
            if (sel ar.err) {
                ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "an array inside a `#[uniform(...)]` / `#[storage(...)]` block has an element stride mach's layout does not give it")};
            }
            ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, ar.ok)};
        }
        val arr_id: u32 = types.type_array(e.tt, elem_ty, t.data.array_.count, true);
        if (arr_id == 0) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: could not build a uniform block array type")}; }
        var aops: [3]u32;
        aops[0] = arr_id;
        aops[1] = spirv.DECOR_ARRAY_STRIDE;
        aops[2] = stride;
        spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?aops[0], 3);
        ret res[u32, fail.Fail].ok{arr_id};
    }

    val mt: u32 = global_spv_type(e, gt, id);
    if (mt == 0) {
        ret res[u32, fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, "unsupported uniform block member type in the SPIR-V target")};
    }
    ret res[u32, fail.Fail].ok{mt};
}

fun round_up_to(v: u32, a: u32) u32 {
    if (a == 0) { ret v; }
    val up: u32 = ((v + a - 1) / a) * a;
    if (up < v) { ret 0; }
    ret up;
}

# a uniform block is laid out by std140-shaped rules, a storage or push-constant block by std430-shaped ones
fun is_std430(role: u8) bool {
    ret role != ir.IFACE_UNIFORM;
}

fun block_role(role: u8) str {
    if (role == ir.IFACE_STORAGE) { ret "#[storage(...)]"; }
    if (role == ir.IFACE_PUSH)    { ret "#[push]"; }
    ret "#[uniform(...)]";
}

fun storage_hint(role: u8) str {
    if (is_std430(role)) { ret ""; }
    ret ", and a `#[storage(...)]` buffer accepts any element width where read-write descriptor semantics are acceptable";
}

fun std_base_align(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, std430: bool) u32 {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret 0; }
    val t: *type.IrType = opt_.some;

    if (t.kind == type.IRT_STRUCT) {
        var a: u32 = 1;
        var i: u32 = 0;
        for (i < t.data.struct_.field_count) {
            val ma: u32 = std_base_align(e, gt, t.data.struct_.fields[i], std430);
            if (ma == 0) { ret 0; }
            if (ma > a)  { a = ma; }
            i = i + 1;
        }
        if (!std430) { ret round_up_to(a, 16); }
        ret a;
    }
    if (t.kind == type.IRT_ARRAY) {
        val ea: u32 = std_base_align(e, gt, t.data.array_.element, std430);
        if (ea == 0) { ret 0; }
        if (!std430) { ret round_up_to(ea, 16); }
        ret ea;
    }
    if (t.kind == type.IRT_VECTOR) {
        val lane: u32 = type.byte_size_for_machine(gt, t.data.vector_.element, e.layout);
        if (t.data.vector_.lanes == 2) { ret 2 * lane; }
        ret 4 * lane;
    }
    if (t.kind == type.IRT_INT || t.kind == type.IRT_FLOAT) {
        ret type.byte_size_for_machine(gt, id, e.layout);
    }
    ret 0;
}

fun std_extent(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, std430: bool) u32 {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret 0; }
    val t: *type.IrType = opt_.some;

    if (t.kind == type.IRT_STRUCT) {
        val a: u32 = std_base_align(e, gt, id, std430);
        if (a == 0) { ret 0; }
        var end: u32 = 0;
        var i:   u32 = 0;
        for (i < t.data.struct_.field_count) {
            val me: u32 = std_extent(e, gt, t.data.struct_.fields[i], std430);
            if (me == 0) { ret 0; }
            val moff: u32 = type.byte_offset_for_machine(gt, id, i, e.layout);
            if (moff + me > end) { end = moff + me; }
            i = i + 1;
        }
        ret round_up_to(end, a);
    }
    if (t.kind == type.IRT_ARRAY) {
        val s: u32 = required_stride(e, gt, t.data.array_.element, std430);
        if (s == 0) { ret 0; }
        ret s * t.data.array_.count;
    }
    ret type.byte_size_for_machine(gt, id, e.layout);
}

fun required_stride(e: *Emit, gt: *type.IrTypeTable, elem: type.IrTypeId, std430: bool) u32 {
    var a: u32 = std_base_align(e, gt, elem, std430);
    if (a == 0)  { ret 0; }
    if (!std430) { a = round_up_to(a, 16); }
    val ext: u32 = std_extent(e, gt, elem, std430);
    if (ext == 0) { ret 0; }
    ret round_up_to(ext, a);
}

fun check_block_layout(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, role: u8) err[fail.Fail] {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret err[fail.Fail].ok{}; }
    val t:      *type.IrType = opt_.some;
    val std430: bool         = is_std430(role);

    var prev_end: u32 = 0;
    var i:        u32 = 0;
    for (i < t.data.struct_.field_count) {
        val fty: type.IrTypeId = t.data.struct_.fields[i];
        val a:   u32           = std_base_align(e, gt, fty, std430);
        if (a == 0) {
            i = i + 1;
            cnt;
        }
        val off: u32 = type.byte_offset_for_machine(gt, id, i, e.layout);

        if ((off % a) != 0 || off < prev_end) {
            var want: u32 = round_up_to(prev_end, a);
            if (want < round_up_to(off, a)) { want = round_up_to(off, a); }
            ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, layout_refusal(e, gt, role, i, fty, off, want, a,
                off < prev_end, prev_end))};
        }
        val ext: u32 = std_extent(e, gt, fty, std430);
        if (ext == 0) {
            i = i + 1;
            cnt;
        }
        prev_end = off + ext;
        i        = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun layout_refusal(e: *Emit, gt: *type.IrTypeTable, role: u8, ix: u32, fty: type.IrTypeId, off: u32,
    want: u32, align: u32, overlaps: bool, prev_end: u32) str {
    var why: str = nil;
    if (overlaps) {
        val wr: res[str, format.FormatError] = format.sprint(e.alloc,
            "the member before it runs to offset {} under those rules and mach's layout ends it sooner, so the two overlap",
            prev_end);
        if (sel wr.ok) { why = wr.ok; }
    }
    or {
        val wr: res[str, format.FormatError] = format.sprint(e.alloc,
            "a member of this type has a base alignment of {} bytes under those rules and mach's layout does not place it on one",
            align);
        if (sel wr.ok) { why = wr.ok; }
    }
    if (why == nil) {
        ret "a member of this block is placed at an offset the SPIR-V block layout rules do not allow";
    }

    val r: res[str, format.FormatError] = format.sprint(e.alloc,
        "member {} of this `{}` block, a {}, is placed at offset {} by mach's layout and the SPIR-V block layout rules require offset {}: {}. the offsets are the host's contract, so this is refused rather than repacked - repacking would move the members out from under a host writing by `$offset_of`. pad the block explicitly so the member lands where the rules put it, or promote a nested record's members into the block{}",
        ix, block_role(role), ir_type_spelling(gt, e.alloc, fty), off, want,
        why, storage_hint(role));
    if (sel r.err) {
        ret "a member of this block is placed at an offset the SPIR-V block layout rules do not allow";
    }
    ret r.ok;
}

fun build_iface_uses(e: *Emit) err[fail.Fail] {
    if (e.iface_len == 0 || e.fn_len == 0) { ret err[fail.Fail].ok{}; }
    val cells: u32               = e.fn_len * e.iface_len;
    val ru:    res[*u8, A.Error] = A.allocate[u8](e.alloc, cells::usize);
    if (sel ru.err) { ret err[fail.Fail].err{fail.refused(ru.err)}; }
    e.iface_use = ru.ok;
    var c: u32 = 0;
    for (c < cells) {
        e.iface_use[c] = 0;
        c              = c + 1;
    }

    var fx: u32 = 0;
    for (fx < e.fn_len) {
        val mf: *mir.MirFunction = fn_mir(e, fx);
        if (mf == nil) {
            fx = fx + 1;
            cnt;
        }
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii:  u32           = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                var oi: u32           = 0;
                for (oi < mi.operand_count) {
                    if (mi.operands[oi].kind == mir.MIR_OP_SYM) {
                        val slot: u32 = iface_slot_of(e, mi.operands[oi].sym);
                        if (slot != 0) { e.iface_use[fx * e.iface_len + slot - 1] = 1; }
                    }
                    oi = oi + 1;
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        fx = fx + 1;
    }

    var changed: bool = true;
    for (changed) {
        changed = false;
        fx      = 0;
        for (fx < e.fn_len) {
            var ci: u32 = 0;
            for (ci < callee_count(e, fx)) {
                val cx: u32 = callee_at(e, fx, ci);
                if (cx != FN_NONE) {
                    var s: u32 = 0;
                    for (s < e.iface_len) {
                        if (e.iface_use[cx * e.iface_len + s] != 0
                            && e.iface_use[fx * e.iface_len + s] == 0) {
                            e.iface_use[fx * e.iface_len + s] = 1;
                            changed                           = true;
                        }
                        s = s + 1;
                    }
                }
                ci = ci + 1;
            }
            fx = fx + 1;
        }
    }
    ret err[fail.Fail].ok{};
}

fun uses_iface(e: *Emit, fn_ix: u32, slot: u32) bool {
    if (e.iface_use == nil || fn_ix >= e.fn_len || slot >= e.iface_len) { ret false; }
    ret e.iface_use[fn_ix * e.iface_len + slot] != 0;
}

fun iface_slot_of(e: *Emit, name: intern.StrId) u32 {
    if (e.gslot == nil) { ret 0; }
    val gx: u32 = gl_lookup(e, name);
    if (gx == GL_NONE) { ret 0; }
    ret e.gslot[gx];
}

fun check_call_graph(e: *Emit) err[fail.Fail] {
    val n: u32 = e.fn_len;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val rs: res[*u8, A.Error] = A.allocate[u8](e.alloc, n::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    val state: *u8                = rs.ok;
    val rp:    res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rp.err) {
        A.deallocate[u8](e.alloc, state, n::usize);
        ret err[fail.Fail].err{fail.refused(rp.err)};
    }
    val path: *u32 = rp.ok;

    var i: u32 = 0;
    for (i < n) {
        state[i] = 0;
        path[i]  = 0;
        i        = i + 1;
    }

    var msg: str = nil;
    i = 0;
    for (i < n && msg == nil) {
        if (state[i] == 0 && e.fns[i].emit) { msg = cg_visit(e, state, path, 0, i); }
        i = i + 1;
    }

    A.deallocate[u8](e.alloc, state, n::usize);
    A.deallocate[u32](e.alloc, path, n::usize);
    if (msg != nil) { ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_RECURSION, msg)}; }
    ret err[fail.Fail].ok{};
}

fun cg_visit(e: *Emit, state: *u8, path: *u32, depth: u32, ix: u32) str {
    state[ix]   = 1;
    path[depth] = ix;

    var ci: u32 = 0;
    for (ci < callee_count(e, ix)) {
        val cx: u32 = callee_at(e, ix, ci);
        if (cx != FN_NONE && emittable(e, cx)) {
            if (state[cx] == 1) { ret cycle_refusal(e, path, depth + 1, cx); }
            if (state[cx] == 0) {
                val sub: str = cg_visit(e, state, path, depth + 1, cx);
                if (sub != nil) { ret sub; }
            }
        }
        ci = ci + 1;
    }

    state[ix] = 2;
    ret nil;
}

fun cycle_refusal(e: *Emit, path: *u32, depth: u32, closes: u32) str {
    var chain: str = ir_fn_spelling(e, closes);
    var i:     u32 = 0;
    for (i < depth && path[i] != closes) { i = i + 1; }
    for (i < depth) {
        val r: res[str, format.FormatError] = format.sprint(e.alloc, "{} -> {}", chain,
            ir_fn_spelling(e, path[i]));
        if (sel r.err) {
            i = depth;
            cnt;
        }
        chain = r.ok;
        i     = i + 1;
    }
    val r2: res[str, format.FormatError] = format.sprint(e.alloc,
        "this call graph is a cycle and the SPIR-V target cannot express it: {}. a SPIR-V execution model has no call stack, so a function may not be reachable from itself. rewrite the recursion as a loop",
        chain);
    if (sel r2.err) {
        ret "a recursive call is not expressible in the SPIR-V target: a SPIR-V execution model has no call stack, so a function may not be reachable from itself";
    }
    ret r2.ok;
}

# the stages that reach each function: an entry point's own, carried to everything it calls
fun build_fn_stages(e: *Emit) err[fail.Fail] {
    if (e.fn_len == 0) { ret err[fail.Fail].ok{}; }
    val rs: res[*u8, A.Error] = A.allocate[u8](e.alloc, e.fn_len::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    e.fn_stages = rs.ok;
    var fx: u32 = 0;
    for (fx < e.fn_len) {
        e.fn_stages[fx] = 0;
        if (e.fns[fx].emit) { e.fn_stages[fx] = stage_bit(fn_ir(e, fx).stage); }
        fx = fx + 1;
    }
    var changed: bool = true;
    for (changed) {
        changed = false;
        fx      = 0;
        for (fx < e.fn_len) {
            var ci: u32 = 0;
            for (ci < callee_count(e, fx)) {
                val cx: u32 = callee_at(e, fx, ci);
                if (cx != FN_NONE && (e.fn_stages[fx] & ~e.fn_stages[cx]) != 0) {
                    e.fn_stages[cx] = e.fn_stages[cx] | e.fn_stages[fx];
                    changed         = true;
                }
                ci = ci + 1;
            }
            fx = fx + 1;
        }
    }
    ret err[fail.Fail].ok{};
}

fun check_stage_interfaces(e: *Emit) err[fail.Fail] {
    val n: u32 = e.gl_len;
    if (e.iface_len == 0 || n == 0) { ret err[fail.Fail].ok{}; }

    val rf: res[*u8, A.Error] = A.allocate[u8](e.alloc, n::usize);
    if (sel rf.err) { ret err[fail.Fail].err{fail.refused(rf.err)}; }
    val flat: *u8 = rf.ok;
    var i:    u32 = 0;
    for (i < n) {
        flat[i] = 0;
        i       = i + 1;
    }

    var msg: str = nil;
    var fx:  u32 = 0;
    for (fx < e.fn_len && msg == nil) {
        if (!e.fns[fx].emit) {
            fx = fx + 1;
            cnt;
        }
        val fn: *ir.Function = fn_ir(e, fx);
        if (fn.stage == ir.STAGE_NONE) {
            fx = fx + 1;
            cnt;
        }
        i = 0;
        for (i < n) {
            if (e.gslot[i] == 0 || !uses_iface(e, fx, e.gslot[i] - 1)) {
                i = i + 1;
                cnt;
            }
            val gi: *ir.Global = gl_ir(e, i);
            if (gi.iface == ir.IFACE_SHARED && fn.stage != ir.STAGE_COMPUTE) {
                msg = shared_stage_refusal(e, fx, i);
                i   = n;
                cnt;
            }
            if (e.gstorage[i] == spirv.STORAGE_INPUT && needs_flat(gl_types(e, i), gi.ty)) {
                if (fn.stage == ir.STAGE_FRAGMENT) { flat[i] = flat[i] | 1; }
                or (fn.stage == ir.STAGE_VERTEX)   { flat[i] = flat[i] | 2; }
                if (flat[i] == 3) {
                    msg = flat_conflict(e, i);
                    i   = n;
                    cnt;
                }
            }
            if (gi.iface == ir.IFACE_BUILTIN) {
                msg = builtin_stage_refusal(e, fx, i);
                if (msg != nil) {
                    i = n;
                    cnt;
                }
                val rq: err[fail.Fail] = require_at(e, source.loc_nil(), stage_bit(fn.stage),
                    builtin_capability(gi.iface_a), 0, builtin_use_text(e, fx, i));
                if (sel rq.err) {
                    A.deallocate[u8](e.alloc, flat, n::usize);
                    ret rq;
                }
            }
            if (gi.iface == ir.IFACE_INPUT || gi.iface == ir.IFACE_OUTPUT) {
                msg = location_overlap(e, fx, i);
                if (msg != nil) {
                    i = n;
                    cnt;
                }
            }
            if (gi.iface == ir.IFACE_UNIFORM || gi.iface == ir.IFACE_STORAGE
                || gi.iface == ir.IFACE_SAMPLER) {
                msg = descriptor_overlap(e, fx, i);
                if (msg != nil) {
                    i = n;
                    cnt;
                }
            }
            if (gi.iface == ir.IFACE_PUSH) {
                msg = push_overlap(e, fx, i);
                if (msg != nil) {
                    i = n;
                    cnt;
                }
            }
            i = i + 1;
        }
        fx = fx + 1;
    }

    if (msg == nil) {
        i = 0;
        for (i < n) {
            if ((flat[i] & 1) != 0) { decorate_bare(e, e.gvar_ids[i], spirv.DECOR_FLAT); }
            i = i + 1;
        }
    }
    A.deallocate[u8](e.alloc, flat, n::usize);
    if (msg != nil) { ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_INTERFACE, msg)}; }
    ret err[fail.Fail].ok{};
}

fun shared_stage_refusal(e: *Emit, fx: u32, gi: u32) str {
    val g: *ir.Global                   = gl_ir(e, gi);
    val r: res[str, format.FormatError] = format.sprint(e.alloc,
        "this `#[shared]` variable, {}{}, is used by the stage `{}`, which is not a compute stage: workgroup memory exists only in a compute stage, where one workgroup's invocations share it. a vertex or fragment stage has no workgroup to share it with",
        ir_type_spelling(gl_types(e, gi), e.alloc, g.ty), gl_mod_prefix(e, gi), ir_fn_spelling(e, fx));
    if (sel r.err) {
        ret "a `#[shared]` variable is used by a stage that is not a compute stage: workgroup memory exists only in a compute stage";
    }
    ret r.ok;
}

fun flat_conflict(e: *Emit, gi: u32) str {
    val g: *ir.Global                   = gl_ir(e, gi);
    val r: res[str, format.FormatError] = format.sprint(e.alloc,
        "this `#[input({})]` variable, {}{}, is read by a vertex stage and by a fragment stage, and no SPIR-V module serves both: a fragment stage's integer or 64-bit input MUST carry a Flat decoration because such a value cannot be interpolated, and a vertex stage's input must NOT carry one. declare two variables. the two are different things anyway - a vertex stage's input is a vertex attribute, and a fragment stage's is the interpolated output of the stage before it",
        g.iface_a, ir_type_spelling(gl_types(e, gi), e.alloc, g.ty), gl_mod_prefix(e, gi));
    if (sel r.err) {
        ret "an integer or 64-bit `#[input(...)]` cannot be read by a vertex stage and a fragment stage at once: the fragment stage requires a Flat decoration and the vertex stage forbids one";
    }
    ret r.ok;
}

fun location_overlap(e: *Emit, fx: u32, gi: u32) str {
    val g:    *ir.Global = gl_ir(e, gi);
    val lo:   u32        = g.iface_a;
    val span: u32        = location_span(e, gl_types(e, gi), g.ty);
    var j:    u32        = 0;
    for (j < gi) {
        val o: *ir.Global = gl_ir(e, j);
        if (o.iface != g.iface) {
            j = j + 1;
            cnt;
        }
        if (e.gslot[j] == 0 || !uses_iface(e, fx, e.gslot[j] - 1)) {
            j = j + 1;
            cnt;
        }
        val olo:   u32 = o.iface_a;
        val ospan: u32 = location_span(e, gl_types(e, j), o.ty);
        if (lo < olo + ospan && olo < lo + span) {
            var what: str = "input";
            if (g.iface == ir.IFACE_OUTPUT) { what = "output"; }
            val fr: res[str, format.FormatError] = format.sprint(e.alloc,
                "two `#[{}(...)]` variables overlap in the stage `{}`: `#[{}({})]`, {}{}, occupies {} location(s) and so runs through location {}, and `#[{}({})]`, {}{}, starts inside it. a type wider than one location consumes the ones that follow it, so the numbers an author writes have to leave room for the type",
                what, ir_fn_spelling(e, fx), what, olo,
                ir_type_spelling(gl_types(e, j), e.alloc, o.ty), gl_mod_prefix(e, j),
                ospan, olo + ospan - 1,
                what, lo, ir_type_spelling(gl_types(e, gi), e.alloc, g.ty), gl_mod_prefix(e, gi));
            if (sel fr.err) {
                ret "two shader interface variables occupy the same location: a type wider than one location consumes the ones that follow it";
            }
            ret fr.ok;
        }
        j = j + 1;
    }
    ret nil;
}

fun descriptor_overlap(e: *Emit, fx: u32, gi: u32) str {
    val g: *ir.Global = gl_ir(e, gi);
    var j: u32        = 0;
    for (j < gi) {
        val o: *ir.Global = gl_ir(e, j);
        if (o.iface != ir.IFACE_UNIFORM && o.iface != ir.IFACE_STORAGE
            && o.iface != ir.IFACE_SAMPLER) {
            j = j + 1;
            cnt;
        }
        if (e.gslot[j] == 0 || !uses_iface(e, fx, e.gslot[j] - 1)) {
            j = j + 1;
            cnt;
        }
        if (o.iface_a != g.iface_a || o.iface_b != g.iface_b) {
            j = j + 1;
            cnt;
        }
        val fr: res[str, format.FormatError] = format.sprint(e.alloc,
            "two descriptor-bound variables claim the same `(set = {}, binding = {})` in the stage `{}`: `{}`, {}{}, and `{}`, {}{}. a host binds one resource to a descriptor slot, so a pipeline layout can satisfy only one of them and the other would read whatever the first was bound to. give them different bindings",
            g.iface_a, g.iface_b, ir_fn_spelling(e, fx),
            descriptor_role(o.iface), ir_type_spelling(gl_types(e, j), e.alloc, o.ty), gl_mod_prefix(e, j),
            descriptor_role(g.iface), ir_type_spelling(gl_types(e, gi), e.alloc, g.ty), gl_mod_prefix(e, gi));
        if (sel fr.err) {
            ret "two descriptor-bound variables claim the same descriptor set and binding: a pipeline layout can satisfy only one of them";
        }
        ret fr.ok;
    }
    ret nil;
}

# vulkan admits one push-constant block per entry point, so a second one a stage uses is refused naming both
fun push_overlap(e: *Emit, fx: u32, gi: u32) str {
    var j: u32 = 0;
    for (j < gi) {
        if (gl_ir(e, j).iface != ir.IFACE_PUSH || e.gslot[j] == 0 || !uses_iface(e, fx, e.gslot[j] - 1)) {
            j = j + 1;
            cnt;
        }
        val fr: res[str, format.FormatError] = format.sprint(e.alloc,
            "the stage `{}` uses two `#[push]` blocks, `{}`{} and `{}`{}: Vulkan admits at most one push-constant block per entry point, because a pipeline layout declares the push-constant range each stage sees as one block. merge them into one record, or keep each to a different stage",
            ir_fn_spelling(e, fx), gl_spelling(e, j), gl_mod_prefix(e, j),
            gl_spelling(e, gi), gl_mod_prefix(e, gi));
        if (sel fr.err) {
            ret "a stage uses two `#[push]` blocks: Vulkan admits at most one push-constant block per entry point";
        }
        ret fr.ok;
    }
    ret nil;
}

fun gl_spelling(e: *Emit, ix: u32) str {
    val g: *ir.Global   = gl_ir(e, ix);
    var n: intern.StrId = g.disp;
    if (n == intern.STR_NIL) { n = g.name; }
    val o: opt[str] = intern.lookup(e.interner, n);
    if (sel o.none) { ret "<unknown variable>"; }
    ret o.some;
}

fun descriptor_role(iface: u8) str {
    if (iface == ir.IFACE_STORAGE) { ret "#[storage(...)]"; }
    if (iface == ir.IFACE_SAMPLER) { ret "#[sampler(...)]"; }
    ret "#[uniform(...)]";
}

fun location_span(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) u32 {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret 1; }
    val t: *type.IrType = opt_.some;
    if (t.kind == type.IRT_STRUCT) {
        var total: u32 = 0;
        var i:     u32 = 0;
        for (i < t.data.struct_.field_count) {
            total = total + location_span(e, gt, t.data.struct_.fields[i]);
            i     = i + 1;
        }
        if (total == 0) { ret 1; }
        ret total;
    }
    if (t.kind == type.IRT_ARRAY) {
        val es: u32 = location_span(e, gt, t.data.array_.element);
        if (t.data.array_.count == 0) { ret 1; }
        ret es * t.data.array_.count;
    }
    if (t.kind == type.IRT_TAG) {
        var total: u32 = 1;
        var ci:    u32 = 0;
        for (ci < t.data.tag_.case_count) {
            if (type.tag_case_has_payload(gt, id, ci)) { total = total + location_span(e, gt, t.data.tag_.cases[ci]); }
            ci = ci + 1;
        }
        ret total;
    }
    val bytes: u32 = type.byte_size_for_machine(gt, id, e.layout);
    if (bytes <= 16) { ret 1; }
    ret (bytes + 15) / 16;
}

fun needs_flat(tt: *type.IrTypeTable, id: type.IrTypeId) bool {
    var lanes:    u32  = 0;
    var bits:     u32  = 0;
    var is_float: bool = false;
    if (!ir_scalar_shape(tt, id, ?lanes, ?bits, ?is_float)) { ret false; }
    if (!is_float)                                          { ret true; }
    ret bits == 64;
}

# the memory qualifiers a descriptor binding declares, whatever the binding holds
fun decorate_memory_quals(e: *Emit, var_id: u32, flags: u32) {
    if ((flags & ir.IFACE_FLAG_WRITEONLY) != 0) { decorate_bare(e, var_id, spirv.DECOR_NON_READABLE); }
    if ((flags & ir.IFACE_FLAG_COHERENT) != 0)  { decorate_bare(e, var_id, spirv.DECOR_COHERENT); }
}

fun decorate_bare(e: *Emit, target: u32, decor: u32) {
    var ops: [2]u32;
    ops[0] = target;
    ops[1] = decor;
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?ops[0], 2);
}

fun ir_fn_spelling(e: *Emit, ix: u32) str {
    if (ix >= e.fn_len) { ret "<unknown function>"; }
    val fn:   *ir.Function = fn_ir(e, ix);
    var name: str          = nil;
    if (fn.disp != intern.STR_NIL) {
        val d: opt[str] = intern.lookup(e.interner, fn.disp);
        if (sel d.some) { name = d.some; }
    }
    if (name == nil) {
        val o: opt[str] = intern.lookup(e.interner, fn.name);
        if (sel o.none) { ret "<unknown function>"; }
        name = o.some;
    }
    if (e.fns[ix].mi == e.u.root) { ret name; }
    val mo: opt[str] = intern.lookup(e.interner, fn_mod(e, ix).name);
    if (sel mo.none) { ret name; }
    val q: res[str, format.FormatError] = format.sprint(e.alloc, "{}.{}", mo.some, name);
    if (sel q.err) { ret name; }
    ret q.ok;
}

fun decorate(e: *Emit, target: u32, decor: u32, operand: u32) {
    var ops: [3]u32;
    ops[0] = target;
    ops[1] = decor;
    ops[2] = operand;
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?ops[0], 3);
}

fun builtin_required_type(which: u32, out_lanes: *u32, out_bits: *u32, out_is_float: *bool) str {
    @out_lanes    = 1;
    @out_bits     = 32;
    @out_is_float = true;
    if (which == ir.BUILTIN_POSITION || which == ir.BUILTIN_FRAG_COORD) {
        @out_lanes = 4;
        ret "`f32x4`, a four-component float vector";
    }
    if (which == ir.BUILTIN_POINT_SIZE) {
        ret "`f32`, a scalar float";
    }
    if (which == ir.BUILTIN_GLOBAL_INVOCATION || which == ir.BUILTIN_LOCAL_INVOCATION
        || which == ir.BUILTIN_WORKGROUP_ID || which == ir.BUILTIN_NUM_WORKGROUPS) {
        @out_lanes    = 3;
        @out_is_float = false;
        ret "`u32x3`, a three-component 32-bit unsigned vector";
    }
    @out_is_float = false;
    ret "`u32` or `i32`, a scalar 32-bit integer";
}

fun builtin_type_refusal(tt: *type.IrTypeTable, alloc: *A.Allocator, which: u32,
    ty: type.IrTypeId) str {
    var want_lanes:    u32  = 0;
    var want_bits:     u32  = 0;
    var want_is_float: bool = false;
    val want:          str  = builtin_required_type(which, ?want_lanes, ?want_bits, ?want_is_float);

    var got_lanes:    u32  = 0;
    var got_bits:     u32  = 0;
    var got_is_float: bool = false;
    if (ir_scalar_shape(tt, ty, ?got_lanes, ?got_bits, ?got_is_float)
        && got_lanes == want_lanes && got_bits == want_bits && got_is_float == want_is_float) {
        ret nil;
    }

    val r: res[str, format.FormatError] = format.sprint(alloc,
        "this `#[builtin(\"{}\")]` variable is declared {}, and SPIR-V specifies it as {}. the requirement is on the variable's TYPE rather than on how it is read, so a wider or narrower one is an invalid module rather than a wasteful one",
        builtin_spelling(which), ir_type_spelling(tt, alloc, ty), want);
    if (sel r.err) {
        ret "this `#[builtin(\"...\")]` variable is declared at a type SPIR-V does not specify for it";
    }
    ret r.ok;
}

fun builtin_spelling(which: u32) str {
    if (which == ir.BUILTIN_VERTEX_INDEX)           { ret "vertex_index"; }
    if (which == ir.BUILTIN_INSTANCE_INDEX)         { ret "instance_index"; }
    if (which == ir.BUILTIN_FRAG_COORD)             { ret "frag_coord"; }
    if (which == ir.BUILTIN_POINT_SIZE)             { ret "point_size"; }
    if (which == ir.BUILTIN_GLOBAL_INVOCATION)      { ret "global_invocation"; }
    if (which == ir.BUILTIN_LOCAL_INVOCATION)       { ret "local_invocation"; }
    if (which == ir.BUILTIN_WORKGROUP_ID)           { ret "workgroup_id"; }
    if (which == ir.BUILTIN_NUM_WORKGROUPS)         { ret "num_workgroups"; }
    if (which == ir.BUILTIN_LOCAL_INVOCATION_INDEX) { ret "local_invocation_index"; }
    if (which == ir.BUILTIN_SUBGROUP_SIZE)          { ret "subgroup_size"; }
    if (which == ir.BUILTIN_SUBGROUP_INVOCATION)    { ret "subgroup_invocation"; }
    if (which == ir.BUILTIN_SUBGROUP_ID)            { ret "subgroup_id"; }
    if (which == ir.BUILTIN_NUM_SUBGROUPS)          { ret "num_subgroups"; }
    ret "position";
}

fun ir_scalar_shape(tt: *type.IrTypeTable, id: type.IrTypeId, out_lanes: *u32,
    out_bits: *u32, out_is_float: *bool) bool {
    @out_lanes    = 0;
    @out_bits     = 0;
    @out_is_float = false;
    val opt_: opt[*type.IrType] = type.get(tt, id);
    if (sel opt_.none) { ret false; }
    val t: *type.IrType = opt_.some;
    if (t.kind == type.IRT_FLOAT) {
        @out_lanes    = 1;
        @out_bits     = t.data.bits;
        @out_is_float = true;
        ret true;
    }
    if (t.kind == type.IRT_INT) {
        @out_lanes = 1;
        @out_bits  = t.data.bits;
        ret true;
    }
    if (t.kind != type.IRT_VECTOR) { ret false; }
    val eopt: opt[*type.IrType] = type.get(tt, t.data.vector_.element);
    if (sel eopt.none) { ret false; }
    val et: *type.IrType = eopt.some;
    if (et.kind != type.IRT_FLOAT && et.kind != type.IRT_INT) { ret false; }
    @out_lanes    = t.data.vector_.lanes;
    @out_bits     = et.data.bits;
    @out_is_float = et.kind == type.IRT_FLOAT;
    ret true;
}

fun ir_type_spelling(tt: *type.IrTypeTable, alloc: *A.Allocator, id: type.IrTypeId) str {
    var lanes:    u32  = 0;
    var bits:     u32  = 0;
    var is_float: bool = false;
    if (!ir_scalar_shape(tt, id, ?lanes, ?bits, ?is_float)) {
        val opt_: opt[*type.IrType] = type.get(tt, id);
        if (sel opt_.none) { ret "an unresolved type"; }
        val k: type.IrTypeKind = opt_.some.kind;
        if (k == type.IRT_PTR)    { ret "a pointer"; }
        if (k == type.IRT_ARRAY)  { ret "an array"; }
        if (k == type.IRT_STRUCT) { ret "a record"; }
        if (k == type.IRT_UNION)  { ret "a union"; }
        if (k == type.IRT_TAG)    { ret "a tag"; }
        ret "a type with no scalar shape";
    }
    var r: res[str, format.FormatError];
    if (is_float && lanes == 1) { r = format.sprint(alloc, "`f{}`", bits); }
    or (is_float)               { r = format.sprint(alloc, "`f{}x{}`", bits, lanes); }
    or (lanes == 1)             { r = format.sprint(alloc, "`i{}` / `u{}`", bits, bits); }
    or                          { r = format.sprint(alloc, "`i{}x{}` / `u{}x{}`", bits, lanes, bits, lanes); }
    if (sel r.err)              { ret "a type this diagnostic could not render"; }
    ret r.ok;
}

fun builtin_selector(which: u32) u32 {
    if (which == ir.BUILTIN_VERTEX_INDEX)           { ret spirv.BUILTIN_VERTEX_INDEX; }
    if (which == ir.BUILTIN_INSTANCE_INDEX)         { ret spirv.BUILTIN_INSTANCE_INDEX; }
    if (which == ir.BUILTIN_FRAG_COORD)             { ret spirv.BUILTIN_FRAG_COORD; }
    if (which == ir.BUILTIN_POINT_SIZE)             { ret spirv.BUILTIN_POINT_SIZE; }
    if (which == ir.BUILTIN_GLOBAL_INVOCATION)      { ret spirv.BUILTIN_GLOBAL_INVOCATION_ID; }
    if (which == ir.BUILTIN_LOCAL_INVOCATION)       { ret spirv.BUILTIN_LOCAL_INVOCATION_ID; }
    if (which == ir.BUILTIN_WORKGROUP_ID)           { ret spirv.BUILTIN_WORKGROUP_ID; }
    if (which == ir.BUILTIN_NUM_WORKGROUPS)         { ret spirv.BUILTIN_NUM_WORKGROUPS; }
    if (which == ir.BUILTIN_LOCAL_INVOCATION_INDEX) { ret spirv.BUILTIN_LOCAL_INVOCATION_INDEX; }
    if (which == ir.BUILTIN_SUBGROUP_SIZE)          { ret spirv.BUILTIN_SUBGROUP_SIZE; }
    if (which == ir.BUILTIN_SUBGROUP_INVOCATION)    { ret spirv.BUILTIN_SUBGROUP_LOCAL_INVOCATION_ID; }
    if (which == ir.BUILTIN_SUBGROUP_ID)            { ret spirv.BUILTIN_SUBGROUP_ID; }
    if (which == ir.BUILTIN_NUM_SUBGROUPS)          { ret spirv.BUILTIN_NUM_SUBGROUPS; }
    ret spirv.BUILTIN_POSITION;
}

# a set of pipeline stages, one bit per ir stage
fun stage_bit(stage: u8) u8 {
    if (stage == ir.STAGE_NONE) { ret 0; }
    ret (1 << stage)::u8;
}

val STAGES_ALL:      u8 = 0x0E;
val STAGES_GRAPHICS: u8 = 0x06;

# the stages a built-in exists in, per the SPIR-V and vulkan built-in tables for the
# vertex, fragment and glcompute execution models, in the direction builtin_storage gives it
fun builtin_stages(which: u32) u8 {
    if (which == ir.BUILTIN_POSITION || which == ir.BUILTIN_POINT_SIZE
        || which == ir.BUILTIN_VERTEX_INDEX || which == ir.BUILTIN_INSTANCE_INDEX) {
        ret stage_bit(ir.STAGE_VERTEX);
    }
    if (which == ir.BUILTIN_FRAG_COORD) {
        ret stage_bit(ir.STAGE_FRAGMENT);
    }
    if (which == ir.BUILTIN_GLOBAL_INVOCATION || which == ir.BUILTIN_LOCAL_INVOCATION
        || which == ir.BUILTIN_WORKGROUP_ID || which == ir.BUILTIN_NUM_WORKGROUPS
        || which == ir.BUILTIN_LOCAL_INVOCATION_INDEX || which == ir.BUILTIN_SUBGROUP_ID
        || which == ir.BUILTIN_NUM_SUBGROUPS) {
        ret stage_bit(ir.STAGE_COMPUTE);
    }
    ret STAGES_ALL;
}

# the capability a built-in needs declared, NO_OP_CAPABILITY for one the Shader capability covers
fun builtin_capability(which: u32) u32 {
    if (which == ir.BUILTIN_SUBGROUP_SIZE || which == ir.BUILTIN_SUBGROUP_INVOCATION
        || which == ir.BUILTIN_SUBGROUP_ID || which == ir.BUILTIN_NUM_SUBGROUPS) {
        ret spirv.CAP_GROUP_NON_UNIFORM;
    }
    ret isa.NO_OP_CAPABILITY;
}

fun stage_spelling(stage: u8) str {
    if (stage == ir.STAGE_VERTEX)   { ret "vertex"; }
    if (stage == ir.STAGE_FRAGMENT) { ret "fragment"; }
    if (stage == ir.STAGE_COMPUTE)  { ret "compute"; }
    ret "none";
}

# "compute", "vertex or fragment"
fun stages_spelling(e: *Emit, stages: u8) str {
    var out: str = nil;
    var st:  u8  = ir.STAGE_VERTEX;
    for (st <= ir.STAGE_COMPUTE) {
        if ((stages & stage_bit(st)) != 0) {
            if (out == nil) { out = stage_spelling(st); }
            or {
                val r: res[str, format.FormatError] = format.sprint(e.alloc, "{} or {}", out, stage_spelling(st));
                if (sel r.ok) { out = r.ok; }
            }
        }
        st = st + 1;
    }
    if (out == nil) { ret "none"; }
    ret out;
}

fun builtin_stage_refusal(e: *Emit, fx: u32, gi: u32) str {
    val g:    *ir.Global = gl_ir(e, gi);
    val want: u8         = builtin_stages(g.iface_a);
    val have: u8         = fn_ir(e, fx).stage;
    if ((want & stage_bit(have)) != 0) { ret nil; }
    var r: res[str, format.FormatError];
    if (builtin_storage(g.iface_a) == spirv.STORAGE_OUTPUT) {
        r = format.sprint(e.alloc,
            "the {} stage `{}` uses the `#[builtin(\"{}\")]` variable{}, and SPIR-V defines that built-in only as an output of a {} stage: the pipeline consumes it from that execution model alone, so no other stage may use it",
            stage_spelling(have), ir_fn_spelling(e, fx), builtin_spelling(g.iface_a),
            gl_mod_prefix(e, gi), stages_spelling(e, want));
    }
    or {
        r = format.sprint(e.alloc,
            "the {} stage `{}` uses the `#[builtin(\"{}\")]` variable{}, and SPIR-V defines that built-in only in a {} stage: the pipeline supplies it to that execution model alone, so no other stage has a value to read",
            stage_spelling(have), ir_fn_spelling(e, fx), builtin_spelling(g.iface_a),
            gl_mod_prefix(e, gi), stages_spelling(e, want));
    }
    if (sel r.err) {
        ret "a `#[builtin(...)]` variable is used by a stage SPIR-V does not define it in";
    }
    ret r.ok;
}

fun builtin_storage(which: u32) u32 {
    if (which == ir.BUILTIN_POSITION || which == ir.BUILTIN_POINT_SIZE) {
        ret spirv.STORAGE_OUTPUT;
    }
    ret spirv.STORAGE_INPUT;
}

fun global_var_id(e: *Emit, name: intern.StrId) u32 {
    if (e.gvar_ids == nil) { ret 0; }
    val gx: u32 = gl_lookup(e, name);
    if (gx == GL_NONE) { ret 0; }
    ret e.gvar_ids[gx];
}

# the environment pins the version before anything is emitted, since which forms a
# module may use depends on it
fun select_version(e: *Emit) err[fail.Fail] {
    val env_id: u32 = e.tgt.identity.env_id;
    if (env_id == isa.ENV_NONE) { ret err[fail.Fail].ok{}; }
    val profile: *spirv.EnvProfile = spirv.env_profile(e.tgt.identity.env_profile);
    if (profile == nil) { ret err[fail.Fail].err{fail.message("spirv: the target names an environment this backend has no profile for")}; }
    e.b.version = profile.version;
    ret err[fail.Fail].ok{};
}

fun check_environment(e: *Emit) err[fail.Fail] {
    val env_id: u32 = e.tgt.identity.env_id;
    if (env_id == isa.ENV_NONE) { ret err[fail.Fail].ok{}; }
    val profile: *spirv.EnvProfile = spirv.env_profile(e.tgt.identity.env_profile);
    if (profile == nil) { ret err[fail.Fail].err{fail.message("spirv: the target names an environment this backend has no profile for")}; }
    val excess: u64 = e.b.caps_needed & spirv.CEILING_DOMAIN & ~profile.ceiling;
    if (excess == 0) { ret err[fail.Fail].ok{}; }
    var bit: u64 = 1;
    for ((excess & bit) == 0) { bit = bit << 1; }
    val msg: res[str, format.FormatError] = format.sprint(e.alloc,
        "this module needs the {} capability, which the `{}` environment does not guarantee; raise `env` on the target or avoid the type that needs it",
        spirv.need_name(bit), profile.name);
    if (sel msg.err) { ret err[fail.Fail].err{fail.format_refused(msg.err)}; }
    ret err[fail.Fail].err{reject_module(e, dkind.SPIRV_CAPABILITY, msg.ok)};
}

# the one path a requirement takes, whatever raised it: an instruction row, a literal's
# value, or an operand's type (such as a 64-bit atomic's Int64Atomics). `what` names the
# use in a refusal. the extensions must be selected and the capability's SPIR-V version
# reached, and the capability is then declared, with the SPIR-V extension defining it
fun require(e: *Emit, mf: *mir.MirFunction, capability: u32, requires: u64, what: str) err[fail.Fail] {
    ret require_at(e, mir.refusal_loc(mf, e.cur_instr), e.cur_stages, capability, requires, what);
}

# `stages` are the stages the use is reached from, which a capability guaranteed only in
# compute holds to its `graphics` extension
fun require_at(e: *Emit, loc: source.SrcLoc, stages: u8, capability: u32, requires: u64, what: str) err[fail.Fail] {
    val missing: u64 = requires & ~e.tgt.model.extensions;
    if (missing != 0) {
        val name: str                          = extension.first_name(e.tgt.model.extension_table, e.tgt.model.extension_count, missing);
        val r:    res[str, format.FormatError] = format.sprint(e.alloc,
            "{} needs the `{}` extension, a device feature the target does not select: name it in the target's `extensions` once the consumer enables the feature",
            what, name);
        if (sel r.err) { ret err[fail.Fail].err{fail.format_refused(r.err)}; }
        ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_CAPABILITY, loc, r.ok)};
    }
    if (capability == isa.NO_OP_CAPABILITY) { ret err[fail.Fail].ok{}; }
    val c: *spirv.Capability = spirv.capability_of(capability);
    if (c == nil) { ret emit_fail(e, "spirv.emit: a requirement names a capability the capability table does not carry"); }
    if (e.b.version < c.min_version) {
        val r: res[str, format.FormatError] = format.sprint(e.alloc,
            "{} needs the {} capability, which SPIR-V defines from {}.{}, and the `{}` environment selects SPIR-V {}.{}: raise `env` to `{}` or later",
            what, c.name, spirv.version_major(c.min_version), spirv.version_minor(c.min_version),
            spirv.env_profile_name(e.tgt.identity.env_profile), spirv.version_major(e.b.version),
            spirv.version_minor(e.b.version), spirv.env_name_from(c.min_version));
        if (sel r.err) { ret err[fail.Fail].err{fail.format_refused(r.err)}; }
        ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_CAPABILITY, loc, r.ok)};
    }
    val graphics: u8 = stages & STAGES_GRAPHICS;
    if (c.graphics != 0 && graphics != 0 && (c.graphics & ~e.tgt.model.extensions) != 0) {
        val name: str                          = extension.first_name(e.tgt.model.extension_table, e.tgt.model.extension_count, c.graphics);
        val r:    res[str, format.FormatError] = format.sprint(e.alloc,
            "{} is reached from a {} stage, and Vulkan guarantees the {} capability only in compute stages: a use from another stage needs the `{}` extension, named in the target's `extensions` once the consumer's device supports the stage",
            what, stages_spelling(e, graphics), c.name, name);
        if (sel r.err) { ret err[fail.Fail].err{fail.format_refused(r.err)}; }
        ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_CAPABILITY, loc, r.ok)};
    }
    e.b.caps_needed = e.b.caps_needed | c.need;
    ret err[fail.Fail].ok{};
}

# "the `#[builtin(\"subgroup_size\")]` variable", for a requirement the declaration raises
fun builtin_decl_text(e: *Emit, gi: u32) str {
    val r: res[str, format.FormatError] = format.sprint(e.alloc, "the `#[builtin(\"{}\")]` variable{}",
        builtin_spelling(gl_ir(e, gi).iface_a), gl_mod_prefix(e, gi));
    if (sel r.err) { ret "a `#[builtin(...)]` variable"; }
    ret r.ok;
}

# the same, used by the stage `fx`
fun builtin_use_text(e: *Emit, fx: u32, gi: u32) str {
    val r: res[str, format.FormatError] = format.sprint(e.alloc, "{} used by `{}`", builtin_decl_text(e, gi), ir_fn_spelling(e, fx));
    if (sel r.err) { ret builtin_decl_text(e, gi); }
    ret r.ok;
}

# the capabilities in the table's order, then each SPIR-V extension one of them needs, once
fun emit_preamble(e: *Emit) {
    emit_cap(e, spirv.CAP_SHADER);
    if (!e.has_entry) { emit_cap(e, spirv.CAP_LINKAGE); }
    val need: u64 = e.b.caps_needed;
    var i:    u32 = 0;
    for (i < spirv.CAPABILITY_COUNT) {
        if ((need & spirv.CAPABILITIES[i].need) != 0) { emit_cap(e, spirv.CAPABILITIES[i].word); }
        i = i + 1;
    }
    i = 0;
    for (i < spirv.CAPABILITY_COUNT) {
        val ext: str = spirv.CAPABILITIES[i].extension;
        if ((need & spirv.CAPABILITIES[i].need) != 0 && ext != nil && !extension_declared_before(need, i, ext)) {
            spirv.inst_string(e.b, ?e.b.extensions, spirv.OP_EXTENSION, nil, 0, ext);
        }
        i = i + 1;
    }
    var mm: [2]u32;
    mm[0] = spirv.ADDRESSING_LOGICAL;
    mm[1] = spirv.MEMORY_GLSL450;
    spirv.inst(e.b, ?e.b.memory_model, spirv.OP_MEMORY_MODEL, ?mm[0], 2);
}

fun extension_declared_before(need: u64, upto: u32, ext: str) bool {
    var i: u32 = 0;
    for (i < upto) {
        val other: str = spirv.CAPABILITIES[i].extension;
        if ((need & spirv.CAPABILITIES[i].need) != 0 && other != nil && str_equals(other, ext)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun emit_cap(e: *Emit, cap: u32) {
    var o: [1]u32;
    o[0] = cap;
    spirv.inst(e.b, ?e.b.caps, spirv.OP_CAPABILITY, ?o[0], 1);
}

rec TypeText {
    buf: [TYPE_TEXT_CAP]u8;
    len: usize;
}

val TYPE_TEXT_CAP: usize = 160;

val TYPE_TEXT_DEPTH: u32 = 6;

fun text_put(out: *TypeText, s: str) {
    val n: usize = str_len(s);
    var i: usize = 0;
    for (i < n) {
        if (out.len + 1 < TYPE_TEXT_CAP) {
            out.buf[out.len] = s[i];
            out.len          = out.len + 1;
        }
        i = i + 1;
    }
}

fun text_put_u32(out: *TypeText, n: u32) {
    var digits: [12]u8;
    var k:      u32 = 0;
    var v:      u32 = n;
    if (v == 0) {
        digits[0] = 48;
        k         = 1;
    }
    for (v > 0) {
        digits[k] = (48 + v % 10)::u8;
        v         = v / 10;
        k         = k + 1;
    }
    for (k > 0) {
        k = k - 1;
        if (out.len + 1 < TYPE_TEXT_CAP) {
            out.buf[out.len] = digits[k];
            out.len          = out.len + 1;
        }
    }
}

fun spell_members(e: *Emit, tys: *type.IrTypeTable, out: *TypeText, members: *type.IrTypeId, count: u32, depth: u32) {
    var i: u32 = 0;
    for (i < count) {
        if (i > 0) { text_put(out, ", "); }
        spell_type(e, tys, out, members[i], depth + 1);
        i = i + 1;
    }
}

# a source-shaped spelling of an IR type for a diagnostic, bounded in depth and length
fun spell_type(e: *Emit, tys: *type.IrTypeTable, out: *TypeText, id: type.IrTypeId, depth: u32) {
    if (depth > TYPE_TEXT_DEPTH) {
        text_put(out, "...");
        ret;
    }
    val opt_: opt[*type.IrType] = type.get(tys, id);
    if (sel opt_.none) {
        text_put(out, "?");
        ret;
    }
    val t: *type.IrType = opt_.some;
    if (t.kind == type.IRT_VOID) {
        text_put(out, "void");
        ret;
    }
    if (t.kind == type.IRT_INT) {
        text_put(out, "i");
        text_put_u32(out, t.data.bits);
        ret;
    }
    if (t.kind == type.IRT_FLOAT) {
        text_put(out, "f");
        text_put_u32(out, t.data.bits);
        ret;
    }
    if (t.kind == type.IRT_HANDLE) {
        text_put(out, "handle");
        ret;
    }
    if (t.kind == type.IRT_VECTOR) {
        spell_type(e, tys, out, t.data.vector_.element, depth + 1);
        text_put(out, "x");
        text_put_u32(out, t.data.vector_.lanes);
        ret;
    }
    if (t.kind == type.IRT_ARRAY) {
        text_put(out, "[");
        text_put_u32(out, t.data.array_.count);
        text_put(out, "]");
        spell_type(e, tys, out, t.data.array_.element, depth + 1);
        ret;
    }
    if (t.kind == type.IRT_PTR) {
        text_put(out, "*");
        if (t.data.pointee != type.IRT_NIL) { spell_type(e, tys, out, t.data.pointee, depth + 1); }
        ret;
    }
    if (t.kind == type.IRT_FN) {
        text_put(out, "fun(");
        spell_members(e, tys, out, t.data.fn.params, t.data.fn.param_count, depth);
        if (t.data.fn.variadic) { text_put(out, ", ..."); }
        text_put(out, ")");
        val rt: opt[*type.IrType] = type.get(tys, t.data.fn.ret_type);
        if (sel rt.some && rt.some.kind != type.IRT_VOID) {
            text_put(out, " ");
            spell_type(e, tys, out, t.data.fn.ret_type, depth + 1);
        }
        ret;
    }
    if (t.kind == type.IRT_TAG) {
        text_put(out, "tag: i");
        text_put_u32(out, t.data.tag_.disc_bytes * 8);
        text_put(out, "{");
        var ci: u32 = 0;
        for (ci < t.data.tag_.case_count) {
            if (ci > 0)                                  { text_put(out, ", "); }
            if (!type.tag_case_has_payload(tys, id, ci)) { text_put(out, "_"); }
            or                                           { spell_type(e, tys, out, t.data.tag_.cases[ci], depth + 1); }
            ci = ci + 1;
        }
        text_put(out, "}");
        ret;
    }
    if (t.kind == type.IRT_STRUCT) { text_put(out, "rec{"); }
    or (t.kind == type.IRT_UNION)  { text_put(out, "uni{"); }
    or {
        text_put(out, "?");
        ret;
    }
    spell_members(e, tys, out, t.data.struct_.fields, t.data.struct_.field_count, depth);
    text_put(out, "}");
}

fun type_text(e: *Emit, out: *TypeText, id: type.IrTypeId) str {
    out.len = 0;
    spell_type(e, ?e.ir.types, out, id, 0);
    out.buf[out.len] = 0;
    ret ?out.buf[0];
}

fun type_refusal_reason(e: *Emit, id: type.IrTypeId) str {
    val opt_: opt[*type.IrType] = type.get(?e.ir.types, id);
    if (sel opt_.none) { ret "the type is not defined in this module"; }
    val k: type.IrTypeKind = opt_.some.kind;
    if (k == type.IRT_FN)                            { ret "logical addressing has no function pointers, so a function value cannot cross a call"; }
    if (k == type.IRT_UNION)                         { ret "SPIR-V has no untyped union, so a raw union has no type to declare"; }
    if (k == type.IRT_PTR)                           { ret "a logical reference must name a Function-storage object whose type SPIR-V can declare, and may not itself contain a reference"; }
    if (k == type.IRT_STRUCT || k == type.IRT_ARRAY) { ret "a member of this composite has no SPIR-V type"; }
    if (k == type.IRT_TAG) {
        if (opt_.some.data.tag_.case_count + 1 > types.MAX_STRUCT_MEMBERS) {
            ret "a tag's SPIR-V composite holds its discriminator and one member per case, and a composite may have at most 16 members, so a tag on this target may declare at most 15 cases";
        }
        ret "a case payload of this tag has no SPIR-V type";
    }
    ret "this type has no SPIR-V form";
}

fun emit_function(e: *Emit, fx: u32) err[fail.Fail] {
    val mf: *mir.MirFunction = fn_mir(e, fx);
    if (mf == nil) { ret err[fail.Fail].err{fail.message("spirv.emit: an emitted function has no lowered body")}; }
    e.cur_fn     = mf;
    e.cur_instr  = nil;
    e.cur_mi     = e.fns[fx].mi;
    e.cur_stages = 0;
    if (e.fn_stages != nil) { e.cur_stages = e.fn_stages[fx]; }
    e.ir = fn_mod(e, fx);
    val irfn: *ir.Function = fn_ir(e, fx);

    var bi: u32 = 0;
    for (bi < mf.block_count && e.cur_instr == nil) {
        var ii: u32 = 0;
        for (ii < mf.blocks[bi].instr_count && e.cur_instr == nil) {
            if (mf.blocks[bi].instrs[ii].loc.file != source.FILE_NIL) { e.cur_instr = ?mf.blocks[bi].instrs[ii]; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    var returns_void: bool = false;
    val ret_ty:       u32  = ir_return_spv_type(e, irfn, ?returns_void);
    if (ret_ty == 0) {
        ret unsupported(e, "unsupported return type in the SPIR-V target");
    }
    var return_storage: u32 = 0;
    if (types.pointer_shape(e.tt, ret_ty, ?return_storage) != 0) {
        ret unsupported(e, "the current SPIR-V Logical Shader environment does not support Function-storage reference results");
    }
    if (!types.instruction_operands_fit(2, irfn.param_count)) {
        ret unsupported(e, "SPIR-V OpTypeFunction parameter count exceeds its 65535-word instruction encoding");
    }
    val pr: res[*u32, A.Error] = A.allocate[u32](e.alloc, (irfn.param_count + 1)::usize);
    if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
    val ptypes: *u32 = pr.ok;
    fin { A.deallocate[u32](e.alloc, ptypes, (irfn.param_count + 1)::usize); }
    val pir: res[*u32, A.Error] = A.allocate[u32](e.alloc, (irfn.param_count + 1)::usize);
    if (sel pir.err) { ret err[fail.Fail].err{fail.refused(pir.err)}; }
    val param_ids: *u32 = pir.ok;
    fin { A.deallocate[u32](e.alloc, param_ids, (irfn.param_count + 1)::usize); }
    var pi: u32 = 0;
    for (pi < irfn.param_count) {
        val pt: u32 = ir_value_spv_type(e, irfn.params[pi].ty);
        if (pt == 0) {
            var shown:   TypeText;
            val message: res[str, format.FormatError] = format.sprint(e.alloc,
                "unsupported parameter {} of type `{}` in the SPIR-V Logical Shader environment: {}",
                pi + 1, type_text(e, ?shown, irfn.params[pi].ty), type_refusal_reason(e, irfn.params[pi].ty));
            if (sel message.err) { ret err[fail.Fail].err{fail.format_refused(message.err)}; }
            val text: str = message.ok;
            fin { A.deallocate[u8](e.alloc, text, str_len(text) + 1); }
            val saved: res[intern.StrId, A.Error] = intern.intern(e.interner, text);
            if (sel saved.err) { ret err[fail.Fail].err{fail.refused(saved.err)}; }
            val held: opt[str] = intern.lookup(e.interner, saved.ok);
            if (sel held.none) { ret err[fail.Fail].err{fail.message("spirv.emit: parameter diagnostic is absent from its interner")}; }
            ret unsupported(e, held.some);
        }
        ptypes[pi] = pt;
        pi         = pi + 1;
    }
    val fnty: u32 = types.type_fn(e.tt, ret_ty, ?ptypes[0], irfn.param_count);
    if (fnty == 0) {
        ret unsupported(e, "this signature has no SPIR-V function type in the SPIR-V target");
    }

    val fn_id: u32 = e.fns[fx].id;

    val name_opt: opt[str] = intern.lookup(e.interner, mf.name);
    if (sel name_opt.none) { ret err[fail.Fail].err{fail.message("spirv.emit: function name not interned")}; }
    val fn_name: str = name_opt.some;

    if (irfn.stage != ir.STAGE_NONE) {
        val er: err[fail.Fail] = emit_entry_point(e, irfn, fx, fn_id, entry_name(e, irfn, fn_name), returns_void);
        if (sel er.err) { ret er; }
    }
    or (!e.has_entry && e.fns[fx].mi == e.u.root) { emit_linkage_export(e, fn_id, fn_name); }

    val cr: res[cfg.Structure, fail.Fail] = cfg.analyze(mf, e.alloc);
    if (sel cr.err) { ret err[fail.Fail].err{cr.err}; }
    var st: cfg.Structure = cr.ok;
    if (st.status != cfg.CFG_OK) {
        val msg: str = cfg_refusal(e, fn_name, ?st);
        cfg.dnit(?st);
        ret err[fail.Fail].err{reject_at(e, dkind.SPIRV_CONTROL_FLOW, mf.decl_loc, msg)};
    }

    var fop: [4]u32;
    fop[0] = ret_ty;
    fop[1] = fn_id;
    fop[2] = spirv.FUNCTION_CONTROL_NONE;
    fop[3] = fnty;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION, ?fop[0], 4);
    dbgm.name_shown(?e.dbg, fn_id, irfn.disp, mf.name);
    if (e.fns[fx].mi == e.u.root && e.cur_instr != nil) { dbgm.source_of(?e.dbg, e.cur_instr.loc); }

    pi = 0;
    for (pi < irfn.param_count) {
        val pid: u32 = spirv.alloc_id(e.b);
        var pp:  [2]u32;
        pp[0] = ptypes[pi];
        pp[1] = pid;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION_PARAMETER, ?pp[0], 2);
        param_ids[pi] = pid;
        pi            = pi + 1;
    }

    val rl: res[*u32, A.Error] = A.allocate[u32](e.alloc, st.count::usize);
    if (sel rl.err) {
        cfg.dnit(?st);
        ret err[fail.Fail].err{fail.refused(rl.err)};
    }
    val labels: *u32 = rl.ok;
    var li:     u32  = 0;
    for (li < st.count) {
        labels[li] = spirv.alloc_id(e.b);
        li         = li + 1;
    }

    # a stage that zeroes its `#[shared]` memory opens on a block of its own, so the
    # first user block is an ordinary one the prologue branches to
    val zeroing: bool = zeroes_shared(e, fx, irfn);
    var lb:      [1]u32;
    lb[0] = labels[st.order[0]];
    if (zeroing) { lb[0] = spirv.alloc_id(e.b); }
    spirv.inst(e.b, ?e.b.functions, spirv.OP_LABEL, ?lb[0], 1);
    dbgm.block(?e.dbg);

    var vm: VMaps;
    val mr: err[fail.Fail] = build_vmaps(e, mf, irfn, ?vm);
    if (sel mr.err) {
        vmaps_dnit(e, ?vm);
        A.deallocate[u32](e.alloc, labels, st.count::usize);
        cfg.dnit(?st);
        ret mr;
    }

    var body: err[fail.Fail] = err[fail.Fail].ok{};
    if (zeroing) { body = emit_shared_zeroing(e, fx, irfn, lb[0], labels[st.order[0]]); }
    var oi: u32 = 0;
    if (sel body.err) { oi = st.count; }
    for (oi < st.count) {
        body = emit_node(e, mf, ?st, st.order[oi], oi == 0 && !zeroing, labels, ?vm,
            ?param_ids[0], irfn.param_count, returns_void, ret_ty);
        if (sel body.err) {
            oi = st.count;
            cnt;
        }
        oi = oi + 1;
    }

    vmaps_dnit(e, ?vm);
    A.deallocate[u32](e.alloc, labels, st.count::usize);
    cfg.dnit(?st);
    if (sel body.err) { ret body; }

    spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION_END, nil, 0);
    if (e.b.err) { ret err[fail.Fail].err{fail.message("spirv.emit: module builder hit an allocation error")}; }
    ret err[fail.Fail].ok{};
}

val ADDR_UNKNOWN: u8 = 0;
val ADDR_GLOBAL:  u8 = 1;
val ADDR_ALLOCA:  u8 = 2;

fun address_origin(e: *Emit, mf: *mir.MirFunction, op: *mir.MirOperand, out_ix: *u32) u8 {
    @out_ix = 0;
    if (op.kind == mir.MIR_OP_SYM) {
        val gx: u32 = gl_lookup(e, op.sym);
        if (gx != GL_NONE) {
            @out_ix = gx;
            ret ADDR_GLOBAL;
        }
        ret ADDR_UNKNOWN;
    }
    var base: u32 = mir.MIR_VREG_NIL.n;
    if (op.kind == mir.MIR_OP_VREG) { base = op.vreg.n; }
    or (op.kind == mir.MIR_OP_MEM)  { base = op.vreg.n; }
    if (base == mir.MIR_VREG_NIL.n) { ret ADDR_UNKNOWN; }

    val def: *mir.MirInstr = defining_instr(mf, base);
    if (def == nil)                   { ret ADDR_UNKNOWN; }
    if (def.opcode == mir.MIR_ALLOCA) { ret ADDR_ALLOCA; }
    if (def.opcode == mir.MIR_GEP && def.operand_count >= 2
        && def.operands[1].kind == mir.MIR_OP_SYM) {
        ret address_origin(e, mf, ?def.operands[1], out_ix);
    }
    ret ADDR_UNKNOWN;
}

fun defining_instr(mf: *mir.MirFunction, vreg: u32) *mir.MirInstr {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mir.instr_defines_shape(mi) && mi.operand_count > 0
                && mi.operands[0].kind == mir.MIR_OP_VREG && mi.operands[0].vreg.n == vreg) {
                ret mi;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret nil;
}

fun cfg_refusal(e: *Emit, name: str, st: *cfg.Structure) str {
    val reason: str                       = cfg.status_message(st.status);
    val jr:     res[str, string.StrError] = str_join(e.alloc, "", name, ": ", reason);
    if (sel jr.err) { ret reason; }
    val buf: str                        = jr.ok;
    val ir:  res[intern.StrId, A.Error] = intern.intern(e.interner, buf);
    A.deallocate[u8](e.alloc, buf::*u8, str_len(buf) + 1);
    if (sel ir.err) { ret reason; }
    val io: opt[str] = intern.lookup(e.interner, ir.ok);
    if (sel io.none) { ret reason; }
    ret io.some;
}

fun emit_node(e: *Emit, mf: *mir.MirFunction, st: *cfg.Structure, ix: u32, is_entry: bool,
    labels: *u32, vm: *VMaps, param_ids: *u32, param_count: u32,
    returns_void: bool, ret_ty: u32) err[fail.Fail] {
    if (!is_entry) {
        var lb: [1]u32;
        lb[0] = labels[ix];
        spirv.inst(e.b, ?e.b.functions, spirv.OP_LABEL, ?lb[0], 1);
        dbgm.block(?e.dbg);
    }

    val role: u8 = st.nodes[ix].role;
    if (role == cfg.ROLE_UNREACHABLE) {
        spirv.inst(e.b, ?e.b.functions, spirv.OP_UNREACHABLE, nil, 0);
        ret err[fail.Fail].ok{};
    }
    if (role == cfg.ROLE_CONTINUE || role == cfg.ROLE_FORWARD) {
        emit_branch(e, labels[st.nodes[ix].succ0]);
        ret err[fail.Fail].ok{};
    }

    val blk: *mir.MirBlock = ?mf.blocks[st.nodes[ix].block];
    if (role == cfg.ROLE_REAL) {
        var ii: u32 = 0;
        for (ii + 1 < blk.instr_count) {
            dbgm.line(?e.dbg, blk.instrs[ii].loc);
            val r: err[fail.Fail] = emit_instr(e, mf, vm, ?blk.instrs[ii], param_ids, param_count);
            if (sel r.err) { ret r; }
            ii = ii + 1;
        }
    }

    ret emit_terminator(e, mf, st, ix, labels, vm, returns_void, ret_ty);
}

fun emit_merge(e: *Emit, st: *cfg.Structure, ix: u32, labels: *u32) {
    if (st.nodes[ix].kind == cfg.CK_LOOP) {
        var lm: [3]u32;
        lm[0] = labels[st.nodes[ix].merge];
        lm[1] = labels[st.nodes[ix].cont];
        lm[2] = spirv.LOOP_CONTROL_NONE;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_LOOP_MERGE, ?lm[0], 3);
        ret;
    }
    if (st.nodes[ix].kind == cfg.CK_SELECTION) {
        var sm: [2]u32;
        sm[0] = labels[st.nodes[ix].merge];
        sm[1] = spirv.SELECTION_CONTROL_NONE;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECTION_MERGE, ?sm[0], 2);
    }
}

fun emit_branch(e: *Emit, label: u32) {
    var o: [1]u32;
    o[0] = label;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_BRANCH, ?o[0], 1);
}

fun emit_terminator(e: *Emit, mf: *mir.MirFunction, st: *cfg.Structure, ix: u32, labels: *u32,
    vm: *VMaps, returns_void: bool, ret_ty: u32) err[fail.Fail] {
    if (st.nodes[ix].split != cfg.NO_BLOCK) {
        emit_merge(e, st, ix, labels);
        emit_branch(e, labels[st.nodes[ix].split]);
        ret err[fail.Fail].ok{};
    }

    val blk:  *mir.MirBlock = ?mf.blocks[st.nodes[ix].block];
    val term: *mir.MirInstr = ?blk.instrs[blk.instr_count - 1];
    e.cur_instr = term;
    dbgm.line(?e.dbg, term.loc);

    if (term.opcode == mir.MIR_BR) {
        emit_merge(e, st, ix, labels);
        emit_branch(e, labels[st.nodes[ix].succ0]);
        ret err[fail.Fail].ok{};
    }
    if (term.opcode == mir.MIR_CBR) {
        val cond: u32 = read_condition(e, vm, ?term.operands[0]);
        if (cond == 0) { ret emit_fail(e, "spirv.emit: unreadable branch condition"); }
        emit_merge(e, st, ix, labels);
        var bc: [3]u32;
        bc[0] = cond;
        bc[1] = labels[st.nodes[ix].succ0];
        bc[2] = labels[st.nodes[ix].succ1];
        spirv.inst(e.b, ?e.b.functions, spirv.OP_BRANCH_CONDITIONAL, ?bc[0], 3);
        ret err[fail.Fail].ok{};
    }
    if (term.opcode == mir.MIR_UNREACHABLE) {
        spirv.inst(e.b, ?e.b.functions, spirv.OP_UNREACHABLE, nil, 0);
        ret err[fail.Fail].ok{};
    }
    if (term.opcode == mir.MIR_RET) {
        if (returns_void) {
            if (term.operand_count != 0) { ret emit_fail(e, "spirv.emit: void return carries a value"); }
            spirv.inst(e.b, ?e.b.functions, spirv.OP_RETURN, nil, 0);
            ret err[fail.Fail].ok{};
        }
        if (term.operand_count != 1) { ret emit_fail(e, "spirv.emit: logical return requires one value"); }
        val rr: res[u32, fail.Fail] = read_value(e, mf, vm, ?term.operands[0], ret_ty, term.memory_flags);
        if (sel rr.err) { ret emit_inner(e, rr.err); }
        val rid: u32 = rr.ok;
        var rv:  [1]u32;
        rv[0] = rid;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_RETURN_VALUE, ?rv[0], 1);
        ret err[fail.Fail].ok{};
    }
    ret unsupported(e, "instruction is not yet supported by the SPIR-V target");
}

fun read_condition(e: *Emit, vm: *VMaps, op: *mir.MirOperand) u32 {
    if (op.kind != mir.MIR_OP_VREG) {
        e.b.err = true;
        ret 0;
    }
    val v: u32 = op.vreg.n;
    if (v >= vm.n) {
        e.b.err = true;
        ret 0;
    }
    val ty:  u32 = vm.type_id[v];
    val raw: u32 = read_operand(e, vm, op, ty);
    if (e.b.err || raw == 0) { ret 0; }
    if (vm.is_bool[v])       { ret raw; }

    var cmp_ty: u32 = ty;
    if (cmp_ty == 0) { cmp_ty = types.type_int(e.tt, e.tgt.model.gpr_width * 8); }
    var opcode: u32 = spirv.OP_I_NOT_EQUAL;
    if (types.type_is_float(e.tt, cmp_ty)) { opcode = spirv.OP_F_UNORD_NOT_EQUAL; }
    val zero:   u32 = types.const_scalar(e.tt, cmp_ty, 0, 0);
    val result: u32 = spirv.alloc_id(e.b);
    var ops:    [4]u32;
    ops[0] = types.type_bool(e.tt);
    ops[1] = result;
    ops[2] = raw;
    ops[3] = zero;
    spirv.inst(e.b, ?e.b.functions, opcode, ?ops[0], 4);
    ret result;
}

fun entry_name(e: *Emit, irfn: *ir.Function, linkage: str) str {
    if (irfn.disp == intern.STR_NIL) { ret linkage; }
    val opt_: opt[str] = intern.lookup(e.interner, irfn.disp);
    if (sel opt_.none) { ret linkage; }
    ret opt_.some;
}

fun emit_entry_point(e: *Emit, irfn: *ir.Function, fn_ix: u32, fn_id: u32, name: str,
    returns_void: bool) err[fail.Fail] {
    if (!returns_void) {
        ret refuse(e, dkind.SPIRV_STAGE_SIGNATURE, "a function declaring a `#[stage(...)]` must return nothing: a pipeline stage's results leave through its output interface variables, not through a return value");
    }
    if (irfn.param_count != 0) {
        ret refuse(e, dkind.SPIRV_STAGE_SIGNATURE, "a function declaring a `#[stage(...)]` must take no parameters: a pipeline stage's inputs arrive through its input interface variables, not as arguments");
    }

    var model: u32 = spirv.EXEC_MODEL_VERTEX;
    if (irfn.stage == ir.STAGE_FRAGMENT) { model = spirv.EXEC_MODEL_FRAGMENT; }
    or (irfn.stage == ir.STAGE_COMPUTE)  { model = spirv.EXEC_MODEL_GLCOMPUTE; }

    val sw_r: res[u32, fail.Fail] = spirv.string_words(name);
    if (sel sw_r.err) { ret err[fail.Fail].err{sw_r.err}; }
    val sw:   u32 = sw_r.ok;
    var used: u32 = 0;
    var gi:   u32 = 0;
    for (gi < e.gl_len) {
        if (entry_lists(e, fn_ix, gi)) { used = used + 1; }
        gi = gi + 1;
    }
    # the zeroing reads LocalInvocationIndex, an Input the interface names even where
    # the stage's own code never reads it
    var lid: u32 = 0;
    if (zeroes_shared(e, fn_ix, irfn)) {
        val lx: u32 = local_invocation_global(e);
        if (lx == GL_NONE || !entry_lists(e, fn_ix, lx)) {
            var lty: u32 = 0;
            lid  = zero_lid(e, ?lty);
            used = used + 1;
        }
    }
    val total: u32                = 2 + sw + used;
    val ra:    res[*u32, A.Error] = A.allocate[u32](e.alloc, total::usize);
    if (sel ra.err) { ret err[fail.Fail].err{fail.refused(ra.err)}; }
    val ops: *u32 = ra.ok;
    ops[0] = model;
    ops[1] = fn_id;
    spirv.pack_string(name, sw, ?ops[2]);
    var ii: u32 = 0;
    gi = 0;
    for (gi < e.gl_len) {
        if (entry_lists(e, fn_ix, gi)) {
            ops[2 + sw + ii] = e.gvar_ids[gi];
            ii               = ii + 1;
        }
        gi = gi + 1;
    }
    if (lid != 0) { ops[2 + sw + ii] = lid; }
    spirv.inst(e.b, ?e.b.entry_points, spirv.OP_ENTRY_POINT, ops, total);
    A.deallocate[u32](e.alloc, ops, total::usize);

    if (irfn.stage == ir.STAGE_FRAGMENT) {
        var fm: [2]u32;
        fm[0] = fn_id;
        fm[1] = spirv.EXEC_MODE_ORIGIN_UPPER_LEFT;
        spirv.inst(e.b, ?e.b.exec_modes, spirv.OP_EXECUTION_MODE, ?fm[0], 2);
    }
    if (irfn.stage == ir.STAGE_COMPUTE && !e.wg_builtin) {
        var cm: [5]u32;
        cm[0] = fn_id;
        if (wg_is_spec(irfn)) {
            cm[1] = spirv.EXEC_MODE_LOCAL_SIZE_ID;
            var d: u32 = 0;
            for (d < 3) {
                val r: res[u32, fail.Fail] = wg_dim_id(e, irfn, d);
                if (sel r.err) { ret err[fail.Fail].err{r.err}; }
                cm[2 + d] = r.ok;
                d         = d + 1;
            }
            spirv.inst(e.b, ?e.b.exec_modes, spirv.OP_EXECUTION_MODE_ID, ?cm[0], 5);
        }
        or {
            cm[1] = spirv.EXEC_MODE_LOCAL_SIZE;
            cm[2] = irfn.wg_x;
            cm[3] = irfn.wg_y;
            cm[4] = irfn.wg_z;
            spirv.inst(e.b, ?e.b.exec_modes, spirv.OP_EXECUTION_MODE, ?cm[0], 5);
        }
    }
    ret err[fail.Fail].ok{};
}

# a `#[shared]` variable carries an OpConstantNull initializer where the selection
# holds zero_init_workgroup, and each compute stage reaching one zeroes it otherwise (#4270)
fun shared_native_zero(e: *Emit) bool {
    ret (e.tgt.model.extensions & spirv.EXT_ZERO_INIT_WORKGROUP) != 0;
}

fun zeroes_shared(e: *Emit, fx: u32, irfn: *ir.Function) bool {
    if (irfn.stage != ir.STAGE_COMPUTE || shared_native_zero(e)) { ret false; }
    var gx: u32 = 0;
    for (gx < e.gl_len) {
        if (gl_ir(e, gx).iface == ir.IFACE_SHARED && e.gslot[gx] != 0
            && uses_iface(e, fx, e.gslot[gx] - 1)) {
            ret true;
        }
        gx = gx + 1;
    }
    ret false;
}

fun local_invocation_global(e: *Emit) u32 {
    var gx: u32 = 0;
    for (gx < e.gl_len) {
        val g: *ir.Global = gl_ir(e, gx);
        if (g.iface == ir.IFACE_BUILTIN && g.iface_a == ir.BUILTIN_LOCAL_INVOCATION_INDEX
            && e.gvar_ids[gx] != 0) {
            ret gx;
        }
        gx = gx + 1;
    }
    ret GL_NONE;
}

# the LocalInvocationIndex variable and its value type: a declared
# `#[builtin("local_invocation_index")]` where there is one, else one the emitter adds once
fun zero_lid(e: *Emit, out_ty: *u32) u32 {
    val gx: u32 = local_invocation_global(e);
    if (gx != GL_NONE) {
        @out_ty = e.gtype_ids[gx];
        ret e.gvar_ids[gx];
    }
    val u32t: u32 = types.type_int(e.tt, 32);
    @out_ty = u32t;
    if (e.zero_lid != 0) { ret e.zero_lid; }
    val var_id: u32 = spirv.alloc_id(e.b);
    var vop:    [3]u32;
    vop[0] = types.type_ptr(e.tt, spirv.STORAGE_INPUT, u32t);
    vop[1] = var_id;
    vop[2] = spirv.STORAGE_INPUT;
    spirv.inst(e.b, ?e.b.types_consts, spirv.OP_VARIABLE, ?vop[0], 3);
    decorate(e, var_id, spirv.DECOR_BUILTIN, spirv.BUILTIN_LOCAL_INVOCATION_INDEX);
    e.zero_lid = var_id;
    ret var_id;
}

fun emit_words(e: *Emit, opcode: u32, w0: u32, w1: u32, w2: u32, w3: u32, n: u32) {
    var ops: [4]u32;
    ops[0] = w0;
    ops[1] = w1;
    ops[2] = w2;
    ops[3] = w3;
    spirv.inst(e.b, ?e.b.functions, opcode, ?ops[0], n);
}

fun emit_label(e: *Emit, label: u32) {
    emit_words(e, spirv.OP_LABEL, label, 0, 0, 0, 1);
    dbgm.block(?e.dbg);
}

fun emit_pair(e: *Emit, opcode: u32, ty: u32, a: u32, b: u32) u32 {
    val result: u32 = spirv.alloc_id(e.b);
    emit_words(e, opcode, ty, result, a, b, 4);
    ret result;
}

# the prologue of a compute stage that zeroes the `#[shared]` memory it reaches:
# invocation i of a workgroup of w stores zero to the elements i, i + w, ... of each
# array and invocation 0 to each whole value, then one workgroup barrier makes the
# stores visible. it precedes all user code, so every invocation reaches the barrier
fun emit_shared_zeroing(e: *Emit, fx: u32, irfn: *ir.Function, first: u32, next: u32) err[fail.Fail] {
    var lty: u32 = 0;
    val lid: u32 = zero_lid(e, ?lty);
    val idx: u32 = spirv.alloc_id(e.b);
    emit_words(e, spirv.OP_LOAD, lty, idx, lid, 0, 3);
    val sr: res[u32, fail.Fail] = workgroup_invocations(e, irfn);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val step: u32 = sr.ok;

    var pred: u32 = first;
    var gx:   u32 = 0;
    for (gx < e.gl_len) {
        val g: *ir.Global = gl_ir(e, gx);
        if (g.iface != ir.IFACE_SHARED || e.gslot[gx] == 0 || !uses_iface(e, fx, e.gslot[gx] - 1)) {
            gx = gx + 1;
            cnt;
        }
        var count:   u32               = 1;
        var elem_ty: u32               = e.gtype_ids[gx];
        var indexed: bool              = false;
        val gt:      *type.IrTypeTable = gl_types(e, gx);
        val to:      opt[*type.IrType] = type.get(gt, g.ty);
        if (sel to.some) {
            val t: *type.IrType = to.some;
            if (t.kind == type.IRT_ARRAY && t.data.array_.count > 0) {
                count   = t.data.array_.count;
                elem_ty = spv_type_of(e, gt, t.data.array_.element);
                indexed = true;
            }
        }
        if (elem_ty == 0) {
            ret unsupported(e, "unsupported `#[shared]` variable type in the SPIR-V target");
        }
        pred = emit_zero_loop(e, pred, e.gvar_ids[gx], elem_ty, indexed, count, idx, step);
        gx   = gx + 1;
    }

    val wg:  u32 = types.const_int(e.tt, 32, spirv.SCOPE_WORKGROUP::i64);
    val sem: u32 = types.const_int(e.tt, 32,
        (spirv.SEMANTICS_ACQUIRE_RELEASE | spirv.SEMANTICS_WORKGROUP_MEMORY)::i64);
    emit_words(e, spirv.OP_CONTROL_BARRIER, wg, wg, sem, 0, 3);
    emit_branch(e, next);
    if (e.b.err) { ret err[fail.Fail].err{fail.message("spirv.emit: module builder hit an allocation error")}; }
    ret err[fail.Fail].ok{};
}

# the id of the stage's invocation count per workgroup: a constant, or where a
# `#[spec]` var sizes a dimension the product the specialized size gives
fun workgroup_invocations(e: *Emit, irfn: *ir.Function) res[u32, fail.Fail] {
    if (!wg_is_spec(irfn)) {
        ret res[u32, fail.Fail].ok{types.const_int(e.tt, 32, (irfn.wg_x * irfn.wg_y * irfn.wg_z)::i64)};
    }
    val u32t: u32 = types.type_int(e.tt, 32);
    var n:    u32 = 0;
    var d:    u32 = 0;
    for (d < 3) {
        val r: res[u32, fail.Fail] = wg_dim_id(e, irfn, d);
        if (sel r.err) { ret r; }
        if (d == 0)    { n = r.ok; }
        or             { n = emit_pair(e, spirv.OP_I_MUL, u32t, n, r.ok); }
        d = d + 1;
    }
    ret res[u32, fail.Fail].ok{n};
}

# for (j = idx; j < count; j += step) var[j] = null, or the whole variable when
# not indexed; returns the merge block, where the code after it continues
fun emit_zero_loop(e: *Emit, pred: u32, var_id: u32, elem_ty: u32, indexed: bool,
    count: u32, idx: u32, step: u32) u32 {
    val u32t:   u32 = types.type_int(e.tt, 32);
    val header: u32 = spirv.alloc_id(e.b);
    val body:   u32 = spirv.alloc_id(e.b);
    val cont:   u32 = spirv.alloc_id(e.b);
    val merge:  u32 = spirv.alloc_id(e.b);
    val j:      u32 = spirv.alloc_id(e.b);
    val jn:     u32 = spirv.alloc_id(e.b);
    emit_branch(e, header);

    emit_label(e, header);
    var phi: [6]u32;
    phi[0] = u32t;
    phi[1] = j;
    phi[2] = idx;
    phi[3] = pred;
    phi[4] = jn;
    phi[5] = cont;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_PHI, ?phi[0], 6);
    val more: u32 = emit_pair(e, spirv.OP_U_LESS_THAN, types.type_bool(e.tt), j,
        types.const_int(e.tt, 32, count::i64));
    emit_words(e, spirv.OP_LOOP_MERGE, merge, cont, spirv.LOOP_CONTROL_NONE, 0, 3);
    emit_words(e, spirv.OP_BRANCH_CONDITIONAL, more, body, merge, 0, 3);

    emit_label(e, body);
    var ptr: u32 = var_id;
    if (indexed) {
        ptr = spirv.alloc_id(e.b);
        emit_words(e, spirv.OP_ACCESS_CHAIN, types.type_ptr(e.tt, spirv.STORAGE_WORKGROUP, elem_ty), ptr, var_id, j, 4);
    }
    emit_words(e, spirv.OP_STORE, ptr, types.const_null(e.tt, elem_ty), 0, 0, 2);
    emit_branch(e, cont);

    emit_label(e, cont);
    emit_words(e, spirv.OP_I_ADD, u32t, jn, j, step, 4);
    emit_branch(e, header);

    emit_label(e, merge);
    ret merge;
}

fun entry_lists(e: *Emit, fn_ix: u32, gx: u32) bool {
    if (e.gslot[gx] == 0 || !uses_iface(e, fn_ix, e.gslot[gx] - 1)) { ret false; }
    ret spirv.entry_interface_lists(e.b.version, e.gstorage[gx]);
}

fun emit_linkage_export(e: *Emit, fn: u32, name: str) {
    val sw_r: res[u32, fail.Fail] = spirv.string_words(name);
    if (sel sw_r.err) {
        e.b.err = true;
        ret;
    }
    val sw:    u32                = sw_r.ok;
    val total: u32                = 3 + sw;
    val ra:    res[*u32, A.Error] = A.allocate[u32](e.alloc, total::usize);
    if (sel ra.err) {
        e.b.err = true;
        ret;
    }
    val ops: *u32 = ra.ok;
    ops[0] = fn;
    ops[1] = spirv.DECOR_LINKAGE_ATTRIBUTES;
    spirv.pack_string(name, sw, ?ops[2]);
    ops[2 + sw] = spirv.LINKAGE_EXPORT;
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ops, total);
    A.deallocate[u32](e.alloc, ops, total::usize);
}

fun build_vmaps(e: *Emit, mf: *mir.MirFunction, irfn: *ir.Function, out: *VMaps) err[fail.Fail] {
    val n: u32 = mf.vreg_count;
    out.n            = n;
    out.type_id      = nil;
    out.var_id       = nil;
    out.is_bool      = nil;
    out.chain_id     = nil;
    out.chain_ty     = nil;
    out.chain_sc     = nil;
    out.chain_object = nil;
    out.opq_var      = nil;
    out.opq_ssa      = nil;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val rt: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rt.err) { ret err[fail.Fail].err{fail.refused(rt.err)}; }
    out.type_id = rt.ok;
    val rv: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rv.err) { ret err[fail.Fail].err{fail.refused(rv.err)}; }
    out.var_id = rv.ok;
    val rb: res[*bool, A.Error] = A.allocate[bool](e.alloc, n::usize);
    if (sel rb.err) { ret err[fail.Fail].err{fail.refused(rb.err)}; }
    out.is_bool = rb.ok;
    val rch: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rch.err) { ret err[fail.Fail].err{fail.refused(rch.err)}; }
    out.chain_id = rch.ok;
    val rct: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rct.err) { ret err[fail.Fail].err{fail.refused(rct.err)}; }
    out.chain_ty = rct.ok;
    val rcs: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rcs.err) { ret err[fail.Fail].err{fail.refused(rcs.err)}; }
    out.chain_sc = rcs.ok;
    val rco: res[*bool, A.Error] = A.allocate[bool](e.alloc, n::usize);
    if (sel rco.err) { ret err[fail.Fail].err{fail.refused(rco.err)}; }
    out.chain_object = rco.ok;
    val rov: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel rov.err) { ret err[fail.Fail].err{fail.refused(rov.err)}; }
    out.opq_var = rov.ok;
    val ros: res[*u32, A.Error] = A.allocate[u32](e.alloc, n::usize);
    if (sel ros.err) { ret err[fail.Fail].err{fail.refused(ros.err)}; }
    out.opq_ssa = ros.ok;

    var i: u32 = 0;
    for (i < n) {
        out.type_id[i]      = 0;
        out.var_id[i]       = 0;
        out.is_bool[i]      = false;
        out.chain_id[i]     = 0;
        out.chain_ty[i]     = 0;
        out.chain_sc[i]     = 0;
        out.chain_object[i] = false;
        out.opq_var[i]      = 0;
        out.opq_ssa[i]      = 0;
        i                   = i + 1;
    }

    var pb: u32 = 0;
    for (pb < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[pb];
        var ei:  u32           = 0;
        for (ei < blk.instr_count) {
            val mi:   *mir.MirInstr   = ?blk.instrs[ei];
            var dest: *mir.MirOperand = nil;
            var ty:   u32             = 0;
            if (mi.opcode == mir.MIR_VALUE_PARAM) {
                if (mi.operand_count != 2 || mi.operands[1].kind != mir.MIR_OP_IMM
                    || mi.operands[1].imm < 0 || mi.operands[1].imm >= irfn.param_count::i64) {
                    ret emit_fail(e, "spirv.emit: malformed logical parameter binding");
                }
                dest = ?mi.operands[0];
                ty   = ir_value_spv_type(e, irfn.params[mi.operands[1].imm::u32].ty);
            }
            or (mi.opcode == mir.MIR_VALUE_CALL) {
                if (mi.operand_count < 2) { ret emit_fail(e, "spirv.emit: malformed logical call"); }
                dest = ?mi.operands[1];
                val row: *isa.OpDef = call_op_row_in(e, e.ir, mi);
                if (row != nil && row.result == isa.OP_RESULT_BOOL) { ty = types.type_bool(e.tt); }
                or (dest.kind == mir.MIR_OP_VREG && dest.vreg.n < n) {
                    ty = ir_value_spv_type(e, mf.vregs[dest.vreg.n].ty);
                }
            }
            if (dest != nil && dest.kind == mir.MIR_OP_VREG && dest.vreg.n < n && ty != 0) {
                out.type_id[dest.vreg.n] = ty;
                out.is_bool[dest.vreg.n] = types.type_is_bool(e.tt, ty);
            }
            ei = ei + 1;
        }
        pb = pb + 1;
    }

    val r1: err[fail.Fail] = type_computed_defs(e, mf, out, true);
    if (sel r1.err) { ret r1; }
    propagate_copy_types(mf, out);
    seed_declared_copy_types(e, mf, out);
    propagate_copy_types(mf, out);
    val r2: err[fail.Fail] = type_computed_defs(e, mf, out, false);
    if (sel r2.err) { ret r2; }

    val ar: err[fail.Fail] = declare_allocas(e, mf, irfn, out);
    if (sel ar.err) { ret ar; }

    i = 0;
    for (i < n) {
        var storage: u32 = 0;
        if (out.type_id[i] != 0 && !types.type_is_opaque(e.tt, out.type_id[i])
            && types.pointer_shape(e.tt, out.type_id[i], ?storage) == 0) {
            val ptr_ty: u32 = types.type_ptr(e.tt, spirv.STORAGE_FUNCTION, out.type_id[i]);
            val var_id: u32 = spirv.alloc_id(e.b);
            var vop:    [3]u32;
            vop[0] = ptr_ty;
            vop[1] = var_id;
            vop[2] = spirv.STORAGE_FUNCTION;
            spirv.inst(e.b, ?e.b.functions, spirv.OP_VARIABLE, ?vop[0], 3);
            out.var_id[i] = var_id;
        }
        i = i + 1;
    }
    name_bound_values(e, mf, irfn, out);
    ret err[fail.Fail].ok{};
}

# a source variable bound to a value names the function variable that holds it
fun name_bound_values(e: *Emit, mf: *mir.MirFunction, irfn: *ir.Function, vm: *VMaps) {
    if (!e.dbg.on) { ret; }
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            var di: u32           = 0;
            for (di < mi.dbg_binding_count) {
                val bind: *mir.MirDbgBinding = ?mi.dbg_bindings[di];
                if (bind.vreg < vm.n && vm.var_id[bind.vreg] != 0) {
                    val dv: opt[*ir.DbgVar] = ir.dbg_var_get(irfn, bind.iid::id.InstructionId);
                    if (sel dv.some) { dbgm.name(?e.dbg, vm.var_id[bind.vreg], dv.some.name); }
                }
                di = di + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun declare_allocas(e: *Emit, mf: *mir.MirFunction, irfn: *ir.Function, out: *VMaps) err[fail.Fail] {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mi.opcode != mir.MIR_ALLOCA || mi.operand_count < 2
                || mi.operands[0].kind != mir.MIR_OP_VREG) {
                ii = ii + 1;
                cnt;
            }
            val dst: u32 = mi.operands[0].vreg.n;
            if (dst >= out.n) {
                ii = ii + 1;
                cnt;
            }

            val slot: *mir.MirSlot = find_slot(mf, mi.operands[1].vreg.n);
            if (slot == nil || slot.ty == mir.SLOT_TY_NIL) {
                ret unsupported(e, "a local allocation whose type was not recorded is not supported by the SPIR-V target: a shader variable needs a type, and a size and alignment do not determine one");
            }
            val ty: u32 = ir_value_spv_type(e, slot.ty);
            if (ty == 0) {
                ret unsupported(e, "unsupported local allocation type in the SPIR-V target");
            }
            if (slot.size != type.byte_size_for_machine(?e.ir.types, slot.ty, e.layout)) {
                ret unsupported(e, "a multi-element local allocation is not supported by the SPIR-V target: it is an array of whole objects reached by pointer arithmetic, which the logical addressing model has no form for");
            }

            var storage: u32 = 0;
            if (types.pointer_shape(e.tt, ty, ?storage) != 0) {
                ret unsupported(e, "SPIR-V Logical Shader pointer-valued local storage requires VariablePointers capability");
            }
            val ptr_ty: u32 = types.type_ptr(e.tt, spirv.STORAGE_FUNCTION, ty);
            val var_id: u32 = spirv.alloc_id(e.b);
            var vop:    [3]u32;
            vop[0] = ptr_ty;
            vop[1] = var_id;
            vop[2] = spirv.STORAGE_FUNCTION;
            spirv.inst(e.b, ?e.b.functions, spirv.OP_VARIABLE, ?vop[0], 3);
            if (slot.origin != mir.SLOT_ORIGIN_NIL) {
                val local: opt[*ir.DbgVar] = ir.alloca_dbg_var_get(irfn, slot.origin::id.InstructionId);
                if (sel local.some) { dbgm.name(?e.dbg, var_id, local.some.name); }
            }
            out.chain_id[dst]     = var_id;
            out.chain_ty[dst]     = ty;
            out.chain_sc[dst]     = spirv.STORAGE_FUNCTION;
            out.chain_object[dst] = true;
            ii                    = ii + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun find_slot(mf: *mir.MirFunction, key: u32) *mir.MirSlot {
    var i: u32 = 0;
    for (i < mf.frame.slot_count) {
        if (mf.frame.slots[i].value == key) { ret ?mf.frame.slots[i]; }
        i = i + 1;
    }
    ret nil;
}

fun type_computed_defs(e: *Emit, mf: *mir.MirFunction, out: *VMaps, skip_copies: bool) err[fail.Fail] {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mi.opcode == mir.MIR_GEP || mi.opcode == mir.MIR_ALLOCA) {
                ii = ii + 1;
                cnt;
            }
            if (mi.opcode == mir.MIR_LOAD && mi.operand_count == 2
                && mi.operands[0].kind == mir.MIR_OP_VREG) {
                val lv: u32 = mi.operands[0].vreg.n;
                var lt: u32 = interface_value_type(e, ?mi.operands[1]);
                # an f16 interface is read into the carrier its value lives in
                val carried: u32 = interface_carried_type(e, ?mi.operands[1]);
                if (half_carrier_pair(e, lt, carried)) { lt = carried; }
                if (lt != 0 && types.is_composite(e.tt, lt)) {
                    val leaf: u32 = leading_leaf_type(e, lt);
                    lt = 0;
                    if (mi.width != 0 && types.type_bits(e.tt, leaf) == mi.width::u32 * 8) { lt = leaf; }
                }
                if (lv < out.n && out.type_id[lv] == 0 && lt != 0) {
                    out.type_id[lv] = lt;
                    out.is_bool[lv] = types.type_is_bool(e.tt, lt);
                    ii              = ii + 1;
                    cnt;
                }
            }
            if (mir.instr_defines_shape(mi) && mi.operands[0].kind == mir.MIR_OP_VREG) {
                val v: u32 = mi.operands[0].vreg.n;
                if (v < out.n && out.type_id[v] == 0 && !(skip_copies && is_reg_copy(mi))) {
                    val boolean: bool = (mir.is_cmp_opcode(mi.opcode) || mi.opcode == mir.MIR_FCMP)
                        && !mir.vec_lane_is_vector(mi.vec_lane);
                    out.is_bool[v] = boolean;
                    if (boolean) {
                        out.type_id[v] = types.type_bool(e.tt);
                    }
                    or {
                        var bytes: u32 = mi.width::u32;
                        if (bytes == 0) { bytes = e.tgt.model.gpr_width; }
                        val t: u32 = value_type_for(e, mf, mi, v, bytes::u8);
                        if (t == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
                        out.type_id[v] = t;
                    }
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun is_reg_copy(mi: *mir.MirInstr) bool {
    if (mi.opcode != mir.MIR_MOV && mi.opcode != mir.MIR_DECLASSIFY) { ret false; }
    if (mi.operand_count != 2)                                       { ret false; }
    ret mi.operands[1].kind == mir.MIR_OP_VREG
        || mi.operands[1].kind == mir.MIR_OP_IMM;
}

fun propagate_copy_types(mf: *mir.MirFunction, out: *VMaps) {
    var changed: bool = true;
    for (changed) {
        changed = false;
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii:  u32           = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                if (is_reg_copy(mi) && mi.operands[0].kind == mir.MIR_OP_VREG &&
                    mi.operands[1].kind == mir.MIR_OP_VREG) {
                    val d:  u32 = mi.operands[0].vreg.n;
                    val sv: u32 = mi.operands[1].vreg.n;
                    if (d < out.n && sv < out.n && out.type_id[d] == 0 && out.type_id[sv] != 0) {
                        out.type_id[d] = out.type_id[sv];
                        out.is_bool[d] = out.is_bool[sv];
                        changed        = true;
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }
}

fun seed_declared_copy_types(e: *Emit, mf: *mir.MirFunction, out: *VMaps) {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32           = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (is_reg_copy(mi) && mi.operands[0].kind == mir.MIR_OP_VREG) {
                val v: u32 = mi.operands[0].vreg.n;
                if (v < out.n && v < mf.vreg_count && out.type_id[v] == 0
                    && mf.vregs[v].ty != mir.VREG_TY_NIL) {
                    val t: u32 = ir_value_spv_type(e, mf.vregs[v].ty);
                    if (t != 0) {
                        out.type_id[v] = t;
                        out.is_bool[v] = types.type_is_bool(e.tt, t);
                    }
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun vmaps_dnit(e: *Emit, vm: *VMaps) {
    if (vm.type_id != nil)      { A.deallocate[u32](e.alloc, vm.type_id, vm.n::usize); }
    if (vm.var_id != nil)       { A.deallocate[u32](e.alloc, vm.var_id, vm.n::usize); }
    if (vm.is_bool != nil)      { A.deallocate[bool](e.alloc, vm.is_bool, vm.n::usize); }
    if (vm.opq_var != nil)      { A.deallocate[u32](e.alloc, vm.opq_var, vm.n::usize); }
    if (vm.opq_ssa != nil)      { A.deallocate[u32](e.alloc, vm.opq_ssa, vm.n::usize); }
    if (vm.chain_id != nil)     { A.deallocate[u32](e.alloc, vm.chain_id, vm.n::usize); }
    if (vm.chain_ty != nil)     { A.deallocate[u32](e.alloc, vm.chain_ty, vm.n::usize); }
    if (vm.chain_sc != nil)     { A.deallocate[u32](e.alloc, vm.chain_sc, vm.n::usize); }
    if (vm.chain_object != nil) { A.deallocate[bool](e.alloc, vm.chain_object, vm.n::usize); }
    vm.type_id      = nil;
    vm.var_id       = nil;
    vm.is_bool      = nil;
    vm.chain_id     = nil;
    vm.chain_ty     = nil;
    vm.chain_sc     = nil;
    vm.chain_object = nil;
    vm.n            = 0;
}

fun lane_type_of(e: *Emit, lane: u32) u32 {
    val bits: u32 = mir.vec_lane_elem_bytes(lane)::u32 * 8;
    if (mir.vec_lane_kind(lane) == mir.VEC_LANE_FLOAT) {
        if (bits != 16 && bits != 32 && bits != 64) { ret 0; }
        ret types.type_float(e.tt, bits);
    }
    if (bits != 8 && bits != 16 && bits != 32 && bits != 64) { ret 0; }
    ret types.type_int(e.tt, bits);
}

fun vector_type_of(e: *Emit, lane: u32, as_int: bool) u32 {
    var lane_ty: u32 = 0;
    if (as_int) {
        val bits: u32 = mir.vec_lane_elem_bytes(lane)::u32 * 8;
        if (bits != 8 && bits != 16 && bits != 32 && bits != 64) { ret 0; }
        lane_ty = types.type_int(e.tt, bits);
    }
    or                { lane_ty = lane_type_of(e, lane); }
    if (lane_ty == 0) { ret 0; }
    ret types.type_vector_value(e.tt, lane_ty, mir.vec_lane_count(lane));
}

fun value_type_for(e: *Emit, mf: *mir.MirFunction, mi: *mir.MirInstr, vreg: u32, width: u8) u32 {
    if (mir.vec_lane_is_vector(mi.vec_lane)) {
        if (mi.opcode == mir.MIR_VEC_EXTRACT) { ret lane_type_of(e, mi.vec_lane); }
        val as_int: bool = mir.is_cmp_opcode(mi.opcode) || mi.opcode == mir.MIR_FCMP;
        ret vector_type_of(e, mi.vec_lane, as_int);
    }
    var bytes: u32 = width::u32;
    if (bytes == 0) { bytes = e.tgt.model.gpr_width; }
    val bits:     u32  = bytes * 8;
    var floating: bool = mi.opcode == mir.MIR_FADD || mi.opcode == mir.MIR_FSUB
        || mi.opcode == mir.MIR_FMUL || mi.opcode == mir.MIR_FDIV || mi.opcode == mir.MIR_FNEG
        || mi.opcode == mir.MIR_FP_TRUNC || mi.opcode == mir.MIR_FP_EXT
        || mi.opcode == mir.MIR_SI_TO_FP || mi.opcode == mir.MIR_UI_TO_FP;
    if (vreg < mf.vreg_count && mf.vregs[vreg].ty != mir.VREG_TY_NIL) {
        val declared: opt[*type.IrType] = type.get(?e.ir.types, mf.vregs[vreg].ty);
        if (sel declared.some) { floating = declared.some.kind == type.IRT_FLOAT; }
    }
    if (floating) {
        if (bits == 16 || bits == 32 || bits == 64) { ret types.type_float(e.tt, bits); }
        ret 0;
    }
    if (bits == 8 || bits == 16 || bits == 32 || bits == 64) { ret types.type_int(e.tt, bits); }
    ret 0;
}

fun spv_type_of(e: *Emit, tys: *type.IrTypeTable, id: type.IrTypeId) u32 {
    ret spv_type_shaped(e, tys, id, false);
}

# the spirv type of an ir type; `half` spells an f16's 16-bit integer carrier as
# the OpTypeFloat 16 it stands for, the type a stage interface declares (#3801)
fun spv_type_shaped(e: *Emit, tys: *type.IrTypeTable, id: type.IrTypeId, half: bool) u32 {
    val opt_: opt[*type.IrType] = type.get(tys, id);
    if (sel opt_.none) { ret 0; }
    val t: *type.IrType = opt_.some;
    if (t.kind == type.IRT_PTR) {
        if (t.data.pointee == type.IRT_NIL) { ret 0; }
        val pointee: u32 = spv_type_shaped(e, tys, t.data.pointee, half);
        if (pointee == 0) { ret 0; }
        ret types.type_ptr(e.tt, spirv.STORAGE_FUNCTION, pointee);
    }
    if (t.kind == type.IRT_INT && half && t.data.bits == 16 && type.int_form(tys, id) == type.INT_FORM_BINARY16) {
        ret types.type_float(e.tt, 16);
    }
    if (t.kind == type.IRT_INT)   { ret types.type_int(e.tt, t.data.bits); }
    if (t.kind == type.IRT_FLOAT) { ret types.type_float(e.tt, t.data.bits); }
    if (t.kind == type.IRT_VECTOR) {
        val elem: u32 = spv_type_shaped(e, tys, t.data.vector_.element, half);
        if (elem == 0) { ret 0; }
        ret types.type_vector_value(e.tt, elem, t.data.vector_.lanes);
    }
    if (t.kind == type.IRT_ARRAY) {
        val elem: u32 = spv_type_shaped(e, tys, t.data.array_.element, half);
        if (elem == 0) { ret 0; }
        var storage: u32 = 0;
        if (types.pointer_shape(e.tt, elem, ?storage) != 0) { ret 0; }
        ret types.type_array(e.tt, elem, t.data.array_.count, false);
    }
    if (t.kind == type.IRT_HANDLE) { ret handle_spv_type(e, tys, t); }
    if (t.kind == type.IRT_TAG)    { ret tag_spv_type(e, tys, id); }
    if (t.kind == type.IRT_STRUCT) {
        val n: u32 = t.data.struct_.field_count;
        if (n == 0 || n > types.MAX_STRUCT_MEMBERS) { ret 0; }
        var members: [16]u32;
        var i:       u32 = 0;
        for (i < n) {
            val mt:      u32 = spv_type_shaped(e, tys, t.data.struct_.fields[i], half);
            var storage: u32 = 0;
            if (mt == 0 || types.pointer_shape(e.tt, mt, ?storage) != 0) { ret 0; }
            members[i] = mt;
            i          = i + 1;
        }
        ret types.type_struct(e.tt, ?members[0], n, false);
    }
    ret 0;
}

# a tag is the composite of its declared discriminator and one member per case in declaration
# order, the unit composite standing in for a payloadless case, so case c is member 1 + c
fun tag_spv_type(e: *Emit, tys: *type.IrTypeTable, id: type.IrTypeId) u32 {
    val n: u32 = type.tag_case_count(tys, id);
    if (n == 0 || n + 1 > types.MAX_STRUCT_MEMBERS) { ret 0; }
    var members: [16]u32;
    members[0] = types.type_int(e.tt, type.tag_discriminator_bytes(tys, id) * 8);
    if (members[0] == 0) { ret 0; }
    var i: u32 = 0;
    for (i < n) {
        var mt: u32 = 0;
        if (!type.tag_case_has_payload(tys, id, i)) { mt = types.type_unit(e.tt); }
        or {
            mt = spv_type_of(e, tys, type.tag_case_type(tys, id, i));
            var storage: u32 = 0;
            if (mt != 0 && types.pointer_shape(e.tt, mt, ?storage) != 0) { mt = 0; }
        }
        if (mt == 0) { ret 0; }
        members[1 + i] = mt;
        i              = i + 1;
    }
    ret types.type_tag_struct(e.tt, ?members[0], n + 1);
}

fun ir_value_spv_type(e: *Emit, id: type.IrTypeId) u32 {
    ret spv_type_of(e, ?e.ir.types, id);
}

fun global_spv_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) u32 {
    ret spv_type_of(e, gt, id);
}

fun handle_spv_type(e: *Emit, tys: *type.IrTypeTable, t: *type.IrType) u32 {
    val ctor: u32 = t.data.handle_.ctor;
    val n:    u32 = t.data.handle_.count;

    if (ctor == defs.SPV_CTOR_SAMPLER) { ret types.type_sampler(e.tt); }

    if (ctor == defs.SPV_CTOR_SAMPLED_IMAGE) {
        if (n != 1) { ret 0; }
        val img: u32 = spv_type_of(e, tys, t.data.handle_.operands[0]);
        if (img == 0) { ret 0; }
        ret types.type_sampled_image(e.tt, img);
    }

    if (ctor == defs.SPV_CTOR_IMAGE) {
        if (n != defs.IMAGE_ARITY) { ret 0; }
        ret types.type_image(e.tt,
            texel_spv_type(e, t.data.handle_.operands[defs.IMAGE_OP_TEXEL]::u32),
            t.data.handle_.operands[defs.IMAGE_OP_DIM]::u32,
            t.data.handle_.operands[defs.IMAGE_OP_DEPTH]::u32,
            t.data.handle_.operands[defs.IMAGE_OP_ARRAYED]::u32,
            t.data.handle_.operands[defs.IMAGE_OP_MS]::u32,
            t.data.handle_.operands[defs.IMAGE_OP_SAMPLED]::u32,
            t.data.handle_.operands[defs.IMAGE_OP_FORMAT]::u32);
    }

    ret 0;
}

fun texel_spv_type(e: *Emit, texel: u32) u32 {
    if (texel == defs.TEXEL_I32 || texel == defs.TEXEL_U32) { ret types.type_int(e.tt, 32); }
    ret types.type_float(e.tt, 32);
}

fun ir_return_spv_type(e: *Emit, irfn: *ir.Function, out_void: *bool) u32 {
    @out_void = false;
    val sig_opt: opt[*type.IrType] = type.get(?e.ir.types, irfn.sig);
    if (sel sig_opt.none) { ret 0; }
    val sig: *type.IrType = sig_opt.some;
    if (sig.kind != type.IRT_FN) { ret 0; }
    val rt:     type.IrTypeId     = sig.data.fn.ret_type;
    val rt_opt: opt[*type.IrType] = type.get(?e.ir.types, rt);
    if (sel rt_opt.none) { ret 0; }
    val rtt: *type.IrType = rt_opt.some;
    if (rtt.kind == type.IRT_VOID) {
        @out_void = true;
        ret types.type_void(e.tt);
    }
    ret ir_value_spv_type(e, rt);
}

val FN_NONE: u32 = unit.UNIT_NONE;

val GL_NONE: u32 = unit.UNIT_NONE;

fun unsupported_value_type(e: *Emit, mi: *mir.MirInstr) str {
    if (!mir.vec_lane_is_vector(mi.vec_lane)) {
        ret "unsupported value type in the SPIR-V target";
    }
    ret "unsupported vector lane type in the SPIR-V target";
}

fun interface_target(e: *Emit, op: *mir.MirOperand) u32 {
    if (op.kind != mir.MIR_OP_SYM || op.sym_off != 0) { ret 0; }
    ret global_var_id(e, op.sym);
}

fun addressed_memory_refusal(e: *Emit, mf: *mir.MirFunction, op: *mir.MirOperand) str {
    var gix:    u32 = 0;
    val origin: u8  = address_origin(e, mf, op, ?gix);
    if (origin == ADDR_ALLOCA) {
        ret "a function-local object is reachable from the SPIR-V target only as a whole value: this access arrived as an address into its storage rather than as a load or a store of the object itself, which logical addressing has no pointer to express. it is a lowering that ran where it should not have, not something the program asked for";
    }
    if (origin != ADDR_GLOBAL) {
        ret "addressed memory is not yet supported by the SPIR-V target: this access reached the back end as a computed address with no object behind it that the emitter can name, and logical addressing has no general pointer to follow";
    }
    val g: *ir.Global = gl_ir(e, gix);
    if (g.iface == ir.IFACE_NONE) {
        ret "a plain module-scope variable is not reachable from the SPIR-V target: a shader has no general global storage, so a module-scope `val` / `var` reaches a stage only by carrying an interface role (`#[input]`, `#[output]`, `#[builtin]`, `#[uniform]`, `#[storage]`, `#[sampler]`, `#[push]`, or `#[shared]`)";
    }
    val r: res[str, format.FormatError] = format.sprint(e.alloc,
        "this shader interface variable carries a role, so it is reachable - but the access reached the back end as COMPUTED ADDRESSING rather than as a direct reference to the variable, which is the one shape the SPIR-V target can name. that is a lowering that ran where it should not have, not a limit of the declaration: the variable is {}",
        ir_type_spelling(gl_types(e, gix), e.alloc, g.ty));
    if (sel r.err) {
        ret "this shader interface variable is reachable only as a whole-variable read or write in the SPIR-V target";
    }
    ret r.ok;
}

fun is_image_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) bool {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (sel opt_.none) { ret false; }
    ret opt_.some.kind == type.IRT_HANDLE;
}

# the interface role a handle type binds through: a storage image `#[storage]`, any other handle `#[sampler]`
fun handle_role(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) u8 {
    val opt_: opt[*type.IrType] = type.get(gt, id);
    if (!sel opt_.some) { ret ir.IFACE_SAMPLER; }
    val t: *type.IrType = opt_.some;
    if (t.kind != type.IRT_HANDLE) { ret ir.IFACE_SAMPLER; }
    if (t.data.handle_.ctor == defs.SPV_CTOR_IMAGE && t.data.handle_.count == defs.IMAGE_ARITY
        && t.data.handle_.operands[defs.IMAGE_OP_SAMPLED]::u32 == spirv.IMAGE_SAMPLED_STORAGE) { ret ir.IFACE_STORAGE; }
    ret ir.IFACE_SAMPLER;
}

fun memory_load(e: *Emit, ty: u32, result: u32, ptr: u32, flags: u8) {
    var ops: [4]u32;
    ops[0] = ty;
    ops[1] = result;
    ops[2] = ptr;
    var count: u32 = 3;
    if ((flags & mir.MEMORY_VOLATILE) != 0) {
        ops[3] = 1;
        count  = 4;
    }
    spirv.inst(e.b, ?e.b.functions, spirv.OP_LOAD, ?ops[0], count);
}

fun memory_store(e: *Emit, ptr: u32, value: u32, flags: u8) {
    var ops: [3]u32;
    ops[0] = ptr;
    ops[1] = value;
    var count: u32 = 2;
    if ((flags & mir.MEMORY_VOLATILE) != 0) {
        ops[2] = 1;
        count  = 3;
    }
    spirv.inst(e.b, ?e.b.functions, spirv.OP_STORE, ?ops[0], count);
}

# a scalar access through a pointer to a composite reaches the composite's leading leaf: member 0,
# recursively, which is what offset zero means on a logical target.
fun leading_leaf(e: *Emit, ptr: u32, ty: u32, storage: u32, want: u32, out_ptr: *u32) u32 {
    var cur_ptr: u32 = ptr;
    var cur:     u32 = ty;
    var depth:   u32 = 0;
    for (cur != want && cur != 0 && types.is_composite(e.tt, cur) && depth < 8) {
        val member: u32 = types.composite_member(e.tt, cur, 0);
        if (member == 0) { ret 0; }
        val ptr_ty: u32 = types.type_ptr(e.tt, storage, member);
        val result: u32 = spirv.alloc_id(e.b);
        var ops:    [4]u32;
        ops[0] = ptr_ty;
        ops[1] = result;
        ops[2] = cur_ptr;
        ops[3] = types.const_int(e.tt, 32, 0);
        spirv.inst(e.b, ?e.b.functions, spirv.OP_ACCESS_CHAIN, ?ops[0], 4);
        cur_ptr = result;
        cur     = member;
        depth   = depth + 1;
    }
    if (cur != want) { ret 0; }
    @out_ptr = cur_ptr;
    ret cur;
}

fun leading_leaf_type(e: *Emit, ty: u32) u32 {
    var cur:   u32 = ty;
    var depth: u32 = 0;
    for (cur != 0 && types.is_composite(e.tt, cur) && depth < 8) {
        cur   = types.composite_member(e.tt, cur, 0);
        depth = depth + 1;
    }
    ret cur;
}

fun leaf_refusal(e: *Emit) str {
    ret "a scalar access through a composite reaches no leading member of its type in the SPIR-V target: a logical object is read and written as a whole or through a member walk, and offset zero of a composite is its first member";
}

fun access_storage(e: *Emit, vm: *VMaps, op: *mir.MirOperand) u32 {
    val sc: u32 = chain_storage(vm, op);
    if (sc != 0)                   { ret sc; }
    if (op.kind != mir.MIR_OP_SYM) { ret spirv.STORAGE_FUNCTION; }
    val gx: u32 = gl_lookup(e, op.sym);
    if (gx == GL_NONE) { ret spirv.STORAGE_FUNCTION; }
    ret e.gstorage[gx];
}

fun emit_global_load(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count != 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0]));
    }
    # a specialization constant is read as the constant it is, with no load
    val spec_id: u32 = spec_target(e, ?mi.operands[1]);
    if (spec_id != 0) { ret store_vreg(e, vm, mi.operands[0].vreg.n, spec_id); }
    var chain_ty:       u32  = 0;
    var var_id:         u32  = chain_target(vm, ?mi.operands[1], ?chain_ty);
    var from_interface: bool = false;
    if (var_id == 0) {
        var_id         = interface_target(e, ?mi.operands[1]);
        from_interface = true;
    }
    if (var_id == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1])); }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n || vm.type_id[dst] == 0) {
        ret emit_fail(e, "spirv.emit: interface load result vreg has no type");
    }
    if (types.type_is_opaque(e.tt, vm.type_id[dst])) {
        if (chain_ty != 0) {
            ret unsupported(e, "an image handle reached through a member walk is not supported by the SPIR-V target: a handle has no members, so this is an access chain into something that is not an aggregate");
        }
        if ((mi.memory_flags & mir.MEMORY_VOLATILE) == 0) {
            vm.opq_var[dst] = var_id;
            ret err[fail.Fail].ok{};
        }
        vm.opq_var[dst] = 0;
    }
    or {
        if (from_interface) { chain_ty = interface_value_type(e, ?mi.operands[1]); }
        if (chain_ty != 0 && chain_ty != vm.type_id[dst] && types.is_composite(e.tt, chain_ty)
            && !types.is_composite(e.tt, vm.type_id[dst])) {
            var leaf_ptr: u32 = 0;
            if (leading_leaf(e, var_id, chain_ty, access_storage(e, vm, ?mi.operands[1]), vm.type_id[dst], ?leaf_ptr) == 0) {
                ret unsupported(e, leaf_refusal(e));
            }
            var_id = leaf_ptr;
        }
    }
    if (half_carrier_pair(e, chain_ty, vm.type_id[dst])) {
        val loaded: u32 = spirv.alloc_id(e.b);
        memory_load(e, chain_ty, loaded, var_id, mi.memory_flags);
        ret store_vreg(e, vm, dst, emit_bitcast(e, vm.type_id[dst], loaded));
    }
    val result: u32 = spirv.alloc_id(e.b);
    memory_load(e, vm.type_id[dst], result, var_id, mi.memory_flags);
    ret store_vreg(e, vm, dst, result);
}

fun emit_global_store(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count != 2) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0])); }
    var chain_ty: u32 = 0;
    var var_id:   u32 = chain_target(vm, ?mi.operands[0], ?chain_ty);
    var value_ty: u32 = chain_ty;
    if (var_id == 0) {
        var_id   = interface_target(e, ?mi.operands[0]);
        value_ty = interface_value_type(e, ?mi.operands[0]);
    }
    if (var_id == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0])); }
    if (value_ty != 0 && types.is_composite(e.tt, value_ty) && stored_scalar(e, vm, mi, ?mi.operands[1])) {
        var want: u32 = 0;
        if (mi.operands[1].kind == mir.MIR_OP_VREG) { want = vm.type_id[mi.operands[1].vreg.n]; }
        or {
            val leaf: u32 = leading_leaf_type(e, value_ty);
            if (mi.width != 0 && types.type_bits(e.tt, leaf) == mi.width::u32 * 8) { want = leaf; }
        }
        var leaf_ptr: u32 = 0;
        if (want == 0 || leading_leaf(e, var_id, value_ty, access_storage(e, vm, ?mi.operands[0]), want, ?leaf_ptr) == 0) {
            ret unsupported(e, leaf_refusal(e));
        }
        var_id   = leaf_ptr;
        value_ty = want;
    }
    var value: u32             = 0;
    val op:    *mir.MirOperand = ?mi.operands[1];
    if (op.kind == mir.MIR_OP_VREG && op.vreg.n < vm.n && half_carrier_pair(e, value_ty, vm.type_id[op.vreg.n])) {
        val bits: u32 = read_operand(e, vm, op, vm.type_id[op.vreg.n]);
        if (!e.b.err && bits != 0) { value = emit_bitcast(e, value_ty, bits); }
    }
    or                         { value = read_operand(e, vm, op, value_ty); }
    if (e.b.err || value == 0) { ret emit_fail(e, "spirv.emit: unreadable value in an interface store"); }
    memory_store(e, var_id, value, mi.memory_flags);
    ret err[fail.Fail].ok{};
}

# an immediate, or a vreg holding a scalar or vector rather than a composite's address
fun stored_scalar(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, op: *mir.MirOperand) bool {
    if (op.kind == mir.MIR_OP_IMM)                       { ret true; }
    if (op.kind != mir.MIR_OP_VREG || op.vreg.n >= vm.n) { ret false; }
    val ty: u32 = vm.type_id[op.vreg.n];
    ret ty != 0 && !types.is_composite(e.tt, ty);
}

fun interface_value_type(e: *Emit, op: *mir.MirOperand) u32 {
    if (op.kind != mir.MIR_OP_SYM) { ret 0; }
    val gx: u32 = gl_lookup(e, op.sym);
    if (gx == GL_NONE) { ret 0; }
    val g: *ir.Global = gl_ir(e, gx);
    if (g.iface == ir.IFACE_NONE) { ret 0; }
    ret e.gtype_ids[gx];
}

# the type an interface variable's value is carried in inside the module, its
# f16 parts as their 16-bit integer carriers
fun interface_carried_type(e: *Emit, op: *mir.MirOperand) u32 {
    if (op.kind != mir.MIR_OP_SYM) { ret 0; }
    val gx: u32 = gl_lookup(e, op.sym);
    if (gx == GL_NONE) { ret 0; }
    val g: *ir.Global = gl_ir(e, gx);
    if (g.iface == ir.IFACE_NONE) { ret 0; }
    ret global_spv_type(e, gl_types(e, gx), g.ty);
}

fun whole_value_as(e: *Emit, value: u32, from_ty: u32, to_ty: u32) u32 {
    if (value == 0 || from_ty == 0 || to_ty == 0)     { ret 0; }
    if (from_ty == to_ty)                             { ret value; }
    if (!types.logically_match(e.tt, from_ty, to_ty)) { ret 0; }
    val res_: u32 = spirv.alloc_id(e.b);
    var ops:  [3]u32;
    ops[0] = to_ty;
    ops[1] = res_;
    ops[2] = value;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_COPY_LOGICAL, ?ops[0], 3);
    ret res_;
}

fun emit_access_chain(e: *Emit, mf: *mir.MirFunction, vm: *VMaps,
    mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1]));
    }
    var base_id:  u32 = 0;
    var base_ty:  u32 = 0;
    var base_sc:  u32 = 0;
    var prior_ty: u32 = 0;
    val prior:    u32 = chain_target(vm, ?mi.operands[1], ?prior_ty);
    if (prior != 0) {
        base_id = prior;
        base_ty = prior_ty;
        base_sc = chain_storage(vm, ?mi.operands[1]);
    }
    or {
        var gix: u32 = 0;
        if (address_origin(e, mf, ?mi.operands[1], ?gix) != ADDR_GLOBAL) {
            ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1]));
        }
        val g: *ir.Global = gl_ir(e, gix);
        if (g.iface == ir.IFACE_NONE || e.gvar_ids[gix] == 0) {
            ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1]));
        }
        base_id = e.gvar_ids[gix];
        base_ty = e.gtype_ids[gix];
        base_sc = e.gstorage[gix];
    }

    if (mi.operands[2].kind != mir.MIR_OP_IMM || mi.operands[2].imm != 0) {
        ret unsupported(e, "pointer arithmetic across whole objects is not supported by the SPIR-V target: a logical pointer names one object, so a getelementptr's leading index may only be 0");
    }

    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: access chain result vreg out of range"); }

    val count: u32 = mi.operand_count - 3;
    if (count == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1])); }
    if (count > 8) {
        ret unsupported(e, "an access chain of more than 8 levels is not supported by the SPIR-V target");
    }

    var idx: [8]u32;
    var cur: u32 = base_ty;
    var k:   u32 = 0;
    for (k < count) {
        val opnd: *mir.MirOperand = ?mi.operands[3 + k];
        if (opnd.kind == mir.MIR_OP_IMM) {
            if (opnd.imm < 0) { ret unsupported(e, "a negative index is not supported by the SPIR-V target"); }
            # a tag's IR field numbering is the composite's: discriminator first, then one member per case
            val ordinal: u32 = opnd.imm::u32;
            cur    = types.composite_member(e.tt, cur, ordinal);
            idx[k] = types.const_int(e.tt, 32, ordinal::i64);
        }
        or {
            val elem:  u32 = types.composite_member(e.tt, cur, 0);
            var lanes: u32 = 0;
            if (elem == 0 || types.vector_shape(e.tt, cur, ?lanes) != 0) {
                ret unsupported(e, "a runtime index into a record or vector is not supported by the SPIR-V target: SPIR-V takes a struct member and a vector lane by a constant ordinal, since the type reached depends on which one it is");
            }
            idx[k] = read_operand(e, vm, opnd, types.type_int(e.tt, 32));
            cur    = elem;
        }
        if (cur == 0 || idx[k] == 0) {
            ret unsupported(e, "an index reaches past the end of its aggregate in the SPIR-V target");
        }
        k = k + 1;
    }
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable index in an access chain"); }

    val ptr_ty: u32 = types.type_ptr(e.tt, base_sc, cur);
    val result: u32 = spirv.alloc_id(e.b);
    var ops:    [11]u32;
    ops[0] = ptr_ty;
    ops[1] = result;
    ops[2] = base_id;
    k      = 0;
    for (k < count) {
        ops[3 + k] = idx[k];
        k          = k + 1;
    }
    spirv.inst(e.b, ?e.b.functions, spirv.OP_ACCESS_CHAIN, ?ops[0], count + 3);

    vm.chain_id[dst] = result;
    vm.chain_ty[dst] = cur;
    vm.chain_sc[dst] = base_sc;
    ret err[fail.Fail].ok{};
}

fun chain_target(vm: *VMaps, op: *mir.MirOperand, out_ty: *u32) u32 {
    @out_ty = 0;
    var v: u32 = mir.MIR_VREG_NIL.n;
    if (op.kind == mir.MIR_OP_VREG)               { v = op.vreg.n; }
    or (op.kind == mir.MIR_OP_MEM && op.imm == 0) { v = op.vreg.n; }
    if (v == mir.MIR_VREG_NIL.n || v >= vm.n)     { ret 0; }
    @out_ty = vm.chain_ty[v];
    ret vm.chain_id[v];
}

fun chain_storage(vm: *VMaps, op: *mir.MirOperand) u32 {
    var v: u32 = mir.MIR_VREG_NIL.n;
    if (op.kind == mir.MIR_OP_VREG)               { v = op.vreg.n; }
    or (op.kind == mir.MIR_OP_MEM && op.imm == 0) { v = op.vreg.n; }
    if (v == mir.MIR_VREG_NIL.n || v >= vm.n)     { ret 0; }
    ret vm.chain_sc[v];
}

fun emit_memzero(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 1) { ret emit_fail(e, "spirv.emit: memzero with no destination"); }
    var target_ty: u32 = 0;
    var target:    u32 = chain_target(vm, ?mi.operands[0], ?target_ty);
    if (target == 0) {
        target    = interface_target(e, ?mi.operands[0]);
        target_ty = interface_value_type(e, ?mi.operands[0]);
    }
    if (target == 0 || target_ty == 0) {
        ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0]));
    }
    memory_store(e, target, types.const_null(e.tt, target_ty), mi.memory_flags);
    ret err[fail.Fail].ok{};
}

fun emit_memcpy(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret emit_fail(e, "spirv.emit: memcpy with no source or destination"); }

    var dst_ty: u32 = 0;
    var dst:    u32 = chain_target(vm, ?mi.operands[0], ?dst_ty);
    if (dst == 0) {
        dst    = interface_target(e, ?mi.operands[0]);
        dst_ty = interface_value_type(e, ?mi.operands[0]);
    }
    if (dst == 0 || dst_ty == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0])); }

    var src_ty: u32 = 0;
    var src:    u32 = chain_target(vm, ?mi.operands[1], ?src_ty);
    if (src == 0) {
        src    = interface_target(e, ?mi.operands[1]);
        src_ty = interface_value_type(e, ?mi.operands[1]);
    }
    if (src == 0 || src_ty == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1])); }

    val value: u32 = spirv.alloc_id(e.b);
    memory_load(e, src_ty, value, src, mi.memory_flags);

    val stored: u32 = whole_value_as(e, value, src_ty, dst_ty);
    if (stored == 0) {
        ret unsupported(e, "copying between two objects of different types is not supported by the SPIR-V target: logical addressing carries an object as a value of its own type, so a copy that reinterprets one type as another has no pointer to perform it through");
    }

    memory_store(e, dst, stored, mi.memory_flags);
    ret err[fail.Fail].ok{};
}

fun read_value(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, op: *mir.MirOperand,
    want_ty: u32, flags: u8) res[u32, fail.Fail] {
    var storage: u32 = 0;
    val pointee: u32 = types.pointer_shape(e.tt, want_ty, ?storage);
    if (pointee != 0) {
        var actual:    u32 = 0;
        val reference: u32 = chain_target(vm, op, ?actual);
        if (reference == 0 || actual != pointee || chain_storage(vm, op) != storage) {
            ret res[u32, fail.Fail].err{reject_at(e, dkind.SPIRV_UNSUPPORTED, mir.refusal_loc(mf, e.cur_instr), "SPIR-V Logical Shader reference arguments require a matching Function-storage object")};
        }
        if (op.vreg.n >= vm.n || !vm.chain_object[op.vreg.n]) {
            ret res[u32, fail.Fail].err{reject_at(e, dkind.SPIRV_UNSUPPORTED, mir.refusal_loc(mf, e.cur_instr), "SPIR-V Logical Shader Function-storage reference arguments must name a memory object declaration, not a subobject access chain")};
        }
        ret res[u32, fail.Fail].ok{reference};
    }
    if (op.kind == mir.MIR_OP_MEM || op.kind == mir.MIR_OP_SYM) {
        var ty:  u32 = 0;
        var src: u32 = chain_target(vm, op, ?ty);
        if (src == 0) {
            src = interface_target(e, op);
            ty  = interface_value_type(e, op);
        }
        if (src == 0 || ty == 0) { ret res[u32, fail.Fail].err{reject_at(e, dkind.SPIRV_UNSUPPORTED, mir.refusal_loc(mf, e.cur_instr), addressed_memory_refusal(e, mf, op))}; }
        val loaded: u32 = spirv.alloc_id(e.b);
        memory_load(e, ty, loaded, src, flags);
        val converted: u32 = whole_value_as(e, loaded, ty, want_ty);
        if (converted == 0) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: logical argument object does not match its declared type")}; }
        ret res[u32, fail.Fail].ok{converted};
    }
    if (!operand_matches_type(vm, op, want_ty)) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: logical argument type mismatch")}; }
    val result: u32 = read_operand(e, vm, op, want_ty);
    if (result == 0 || e.b.err) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: unreadable logical value")}; }
    ret res[u32, fail.Fail].ok{result};
}

fun write_value(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, op: *mir.MirOperand,
    held: u32, held_ty: u32, flags: u8) err[fail.Fail] {
    var storage: u32 = 0;
    val pointee: u32 = types.pointer_shape(e.tt, held_ty, ?storage);
    if (pointee != 0) {
        if (op.kind != mir.MIR_OP_VREG || op.vreg.n >= vm.n || vm.type_id[op.vreg.n] != held_ty) {
            ret emit_fail(e, "spirv.emit: logical reference binding type mismatch");
        }
        vm.chain_id[op.vreg.n]     = held;
        vm.chain_ty[op.vreg.n]     = pointee;
        vm.chain_sc[op.vreg.n]     = storage;
        vm.chain_object[op.vreg.n] = true;
        ret err[fail.Fail].ok{};
    }
    if (op.kind == mir.MIR_OP_MEM) {
        var ty:  u32 = 0;
        val dst: u32 = chain_target(vm, op, ?ty);
        if (dst == 0 || ty == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, op)); }
        val converted: u32 = whole_value_as(e, held, held_ty, ty);
        if (converted == 0) { ret emit_fail(e, "spirv.emit: logical result object does not match its owned home"); }
        memory_store(e, dst, converted, flags);
        ret err[fail.Fail].ok{};
    }
    if (op.kind != mir.MIR_OP_VREG || op.vreg.n >= vm.n || vm.type_id[op.vreg.n] != held_ty) {
        ret emit_fail(e, "spirv.emit: logical result type mismatch");
    }
    ret store_vreg(e, vm, op.vreg.n, held);
}

fun emit_param(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr,
    params: *u32, count: u32) err[fail.Fail] {
    if (mi.operand_count != 2 || mi.operands[1].kind != mir.MIR_OP_IMM
        || mi.operands[1].imm < 0 || mi.operands[1].imm >= count::i64) {
        ret emit_fail(e, "spirv.emit: malformed logical parameter binding");
    }
    val index: u32          = mi.operands[1].imm::u32;
    val fn:    *ir.Function = ir_function_record(e.ir, mf.name);
    if (fn == nil || index >= fn.param_count) { ret emit_fail(e, "spirv.emit: logical parameter has no signature"); }
    ret write_value(e, mf, vm, ?mi.operands[0], params[index],
        ir_value_spv_type(e, fn.params[index].ty), mi.memory_flags);
}

# the program asks for what this backend cannot express: an error located at
# the instruction under emission (else its function) on the module's store,
# naming the function
fun refuse(e: *Emit, k: dkind.Kind, msg: str) err[fail.Fail] {
    if (e.cur_fn == nil) { ret err[fail.Fail].err{reject_at(e, k, source.loc_nil(), msg)}; }
    val named: res[str, format.FormatError] = format.sprint(e.alloc, "{} (in `{}`)", msg, refusal_fn_name(e));
    if (sel named.err) { ret err[fail.Fail].err{fail.format_refused(named.err)}; }
    ret err[fail.Fail].err{reject_at(e, k, mir.refusal_loc(e.cur_fn, e.cur_instr), named.ok)};
}

fun unsupported(e: *Emit, msg: str) err[fail.Fail] {
    ret refuse(e, dkind.SPIRV_UNSUPPORTED, msg);
}

fun reject_at(e: *Emit, k: dkind.Kind, loc: source.SrcLoc, msg: str) fail.Fail {
    ret mir.reject(e.diags, k, loc, msg);
}

# a refusal of the module or its interface, which no one instruction locates
fun reject_module(e: *Emit, k: dkind.Kind, msg: str) fail.Fail {
    ret reject_at(e, k, source.loc_nil(), msg);
}

# an operand read's failure at the instruction that read it: a rejection is
# already on the store and passes through, a defect is named with its place
fun emit_inner(e: *Emit, f: fail.Fail) err[fail.Fail] {
    if (sel f.reported) { ret err[fail.Fail].err{f}; }
    ret emit_fail(e, fail.describe(f));
}

# a compiler defect met while emitting, named with its instruction and place
fun emit_fail(e: *Emit, msg: str) err[fail.Fail] {
    ret err[fail.Fail].err{fail.message(mir.instr_refusal(e.alloc, e.srcmap, refusal_fn_name(e),
        e.cur_instr, msg))};
}

fun refusal_fn_name(e: *Emit) str {
    if (e.cur_fn == nil) { ret "<unknown function>"; }
    val fx: u32 = fn_lookup(e, e.cur_fn.name);
    if (fx != FN_NONE) { ret ir_fn_spelling(e, fx); }
    val m: opt[str] = intern.lookup(e.interner, e.cur_fn.name);
    if (sel m.some) { ret m.some; }
    ret "<unresolved function name>";
}

fun emit_instr(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr, params: *u32, param_count: u32) err[fail.Fail] {
    e.cur_instr = mi;
    val op: mir.MirOpcode = mi.opcode;

    val lf: bool = mir.vec_lane_is_vector(mi.vec_lane)
        && mir.vec_lane_kind(mi.vec_lane) == mir.VEC_LANE_FLOAT;

    # the value instructions: the mapping row names the emitter shape and
    # the opcode for the lane class; the opcode's core row sizes the word
    val m: *ops.MirMap = ops.map_of(op);
    if (m != nil) {
        val code: u32 = ops.select(m, lf);
        if (m.shape == ops.SH_BINARY)                                       { ret emit_binary(e, vm, mi, code, false); }
        if (m.shape == ops.SH_SHIFT && mir.vec_lane_is_vector(mi.vec_lane)) { ret emit_vector_shift(e, vm, mi, code); }
        if (m.shape == ops.SH_SHIFT)                                        { ret emit_binary(e, vm, mi, code, true); }
        if (m.shape == ops.SH_UNARY)                                        { ret emit_unary(e, vm, mi, code); }
        if (m.shape == ops.SH_COMPARE)                                      { ret emit_compare(e, vm, mi, code); }
        ret emit_convert(e, vm, mi, code, m.src_float);
    }

    if (op == mir.MIR_FCMP)                               { ret emit_float_compare(e, vm, mi); }
    if (op == mir.MIR_MASK_LT_U)                          { ret emit_compare_mask(e, vm, mi); }
    if (op == mir.MIR_SELECT || op == mir.MIR_SELECT_CMP) { ret emit_select(e, vm, mi); }

    if (op == mir.MIR_VEC_EXTRACT) { ret emit_vec_extract(e, vm, mi); }
    if (op == mir.MIR_VEC_INSERT)  { ret emit_vec_insert(e, vm, mi); }
    if (op == mir.MIR_VEC_BUILD)   { ret emit_vec_build(e, vm, mi); }

    if (op == mir.MIR_MOV)        { ret emit_mov(e, vm, mi); }
    if (op == mir.MIR_DECLASSIFY) { ret emit_mov(e, vm, mi); }

    if (op == mir.MIR_VALUE_CALL)  { ret emit_call(e, mf, vm, mi); }
    if (op == mir.MIR_VALUE_PARAM) { ret emit_param(e, mf, vm, mi, params, param_count); }

    if (op == mir.MIR_LOAD)    { ret emit_global_load(e, mf, vm, mi); }
    if (op == mir.MIR_STORE)   { ret emit_global_store(e, mf, vm, mi); }
    if (op == mir.MIR_GEP)     { ret emit_access_chain(e, mf, vm, mi); }
    if (op == mir.MIR_ALLOCA)  { ret err[fail.Fail].ok{}; }
    if (op == mir.MIR_MEMZERO) { ret emit_memzero(e, mf, vm, mi); }
    if (op == mir.MIR_MEMCPY)  { ret emit_memcpy(e, mf, vm, mi); }

    ret unsupported(e, "instruction is not yet supported by the SPIR-V target");
}

fun emit_call(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret emit_fail(e, "spirv.emit: logical call requires callee and result operands"); }
    val callee: *mir.MirOperand = ?mi.operands[0];
    if (callee.kind != mir.MIR_OP_SYM) {
        ret unsupported(e, "SPIR-V logical shader calls require a statically named function");
    }
    val xfn: *ir.Function = ir_function_record(e.ir, callee.sym);
    if (xfn != nil && xfn.op_set != defs.SPV_SET_NONE) { ret emit_spirv_op(e, mf, vm, mi, xfn); }
    if (xfn != nil && xfn.is_import)                   { ret unsupported(e, foreign_call_refusal(e, xfn)); }
    val fx: u32 = fn_lookup(e, callee.sym);
    if (fx == FN_NONE || e.fns[fx].id == 0) { ret unsupported(e, unresolved_call_refusal(e, callee.sym, fx)); }
    val irfn:  *ir.Function = fn_ir(e, fx);
    val count: u32          = irfn.param_count;
    if (count != mi.operand_count - 2)             { ret emit_fail(e, "spirv.emit: logical call arity mismatch"); }
    if (!types.instruction_operands_fit(3, count)) { ret unsupported(e, "SPIR-V OpFunctionCall arguments exceed its 65535-word instruction encoding"); }
    val ar: res[*u32, A.Error] = A.allocate[u32](e.alloc, (count + 3)::usize);
    if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
    val ops: *u32 = ar.ok;
    fin { A.deallocate[u32](e.alloc, ops, (count + 3)::usize); }
    val saved_ir: *ir.Module = e.ir;
    val saved_mi: u32        = e.cur_mi;
    e.ir     = fn_mod(e, fx);
    e.cur_mi = e.fns[fx].mi;
    var returns_void: bool = false;
    val ret_ty:       u32  = ir_return_spv_type(e, irfn, ?returns_void);
    var i:            u32  = 0;
    for (i < count) {
        ops[i + 3] = ir_value_spv_type(e, irfn.params[i].ty);
        i          = i + 1;
    }
    e.ir     = saved_ir;
    e.cur_mi = saved_mi;
    if (ret_ty == 0) { ret unsupported(e, "unsupported logical result type in SPIR-V"); }
    ops[0] = ret_ty;
    ops[2] = e.fns[fx].id;
    i      = 0;
    for (i < count) {
        if (ops[i + 3] == 0) { ret unsupported(e, "unsupported logical argument type in SPIR-V"); }
        val value: res[u32, fail.Fail] = read_value(e, mf, vm, ?mi.operands[i + 2], ops[i + 3], mi.memory_flags);
        if (sel value.err) { ret emit_inner(e, value.err); }
        ops[i + 3] = value.ok;
        i          = i + 1;
    }
    ops[1] = spirv.alloc_id(e.b);
    spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION_CALL, ops, count + 3);
    if (!returns_void) { ret write_value(e, mf, vm, ?mi.operands[1], ops[1], ret_ty, mi.memory_flags); }
    if (mi.operands[1].kind != mir.MIR_OP_VREG || !mir.vreg_is_nil(mi.operands[1].vreg)) {
        ret emit_fail(e, "spirv.emit: void logical call names a result");
    }
    ret err[fail.Fail].ok{};
}

fun foreign_call_refusal(e: *Emit, fn: *ir.Function) str {
    val nm:  opt[str] = intern.lookup(e.interner, fn.name);
    var who: str      = "this function";
    if (sel nm.some) { who = nm.some; }
    val r: res[str, format.FormatError] = format.sprint(e.alloc,
        "`{}` is declared `ext`, and a SPIR-V module cannot call a foreign import: the module a shader compiles to is self-contained, so there is no symbol to bind at load time. give the operation an `#[op(\"spirv\", set, name)]` mapping so the call becomes that instruction, or write it in mach so its body can be emitted here",
        who);
    if (sel r.err) {
        ret "a SPIR-V module cannot call a foreign `ext` import: the module is self-contained and has no symbol to bind at load time";
    }
    ret r.ok;
}

fun unresolved_call_refusal(e: *Emit, name: intern.StrId, fx: u32) str {
    val nm:  opt[str] = intern.lookup(e.interner, name);
    var who: str      = "this function";
    if (sel nm.some) { who = nm.some; }
    if (fx != FN_NONE) {
        var where: str      = "the module it belongs to";
        val mo:    opt[str] = intern.lookup(e.interner, fn_mod(e, fx).name);
        if (sel mo.some) { where = mo.some; }
        val r2: res[str, format.FormatError] = format.sprint(e.alloc,
            "`{}` is declared in `{}` but has no body the SPIR-V target can emit, so there is nothing to call: a self-contained module cannot leave the call for a linker to resolve",
            who, where);
        if (sel r2.ok) { ret r2.ok; }
        ret "the SPIR-V target has no body to emit for this callee, and a self-contained module cannot leave the call for a linker to resolve";
    }
    val r: res[str, format.FormatError] = format.sprint(e.alloc,
        "no module in this build defines `{}`, so the SPIR-V target has no body to emit for it: a self-contained module cannot leave the call for a linker to resolve",
        who);
    if (sel r.err) {
        ret "no module in this build defines this callee, so the SPIR-V target has no body to emit for it";
    }
    ret r.ok;
}

# a call to an `#[op]` declaration is the instruction its row names: the row says
# whether it has a result id, and how each operand is written, so a pointer operand
# takes the storage class of the argument's own access chain rather than a
# parameter type's
fun emit_spirv_op(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr, fn: *ir.Function) err[fail.Fail] {
    val sig_opt: opt[*type.IrType] = type.get(?e.ir.types, fn.sig);
    if (sel sig_opt.none) {
        ret emit_fail(e, "spirv.emit: an `op` callee has no signature type");
    }
    val sig: *type.IrType = sig_opt.some;
    if (sig.kind != type.IRT_FN) {
        ret emit_fail(e, "spirv.emit: an `op` callee's signature is not a function type");
    }
    val argc: u32 = sig.data.fn.param_count;
    if (argc != mi.operand_count - 2)             { ret emit_fail(e, "spirv.emit: mapped logical call arity mismatch"); }
    if (!types.instruction_operands_fit(4, argc)) { ret unsupported(e, "SPIR-V mapped instruction arguments exceed its 65535-word encoding"); }
    val row: *isa.OpDef = isa.op_def_by_code(e.tgt.defs, fn.op_set, fn.op_code);
    if (row == nil || argc < row.min_arity || argc > row.arity) {
        ret emit_fail(e, "spirv.emit: an `op` callee has no instruction row of its arity");
    }
    val rq: err[fail.Fail] = require(e, mf, row.capability, row.requires, op_use_text(e, row, nil));
    if (sel rq.err) { ret rq; }

    var returns_void: bool = false;
    var ret_ty:       u32  = 0;
    var pointee:      u32  = 0;
    if (row.result == isa.OP_RESULT_POINTER) {
        pointee = ir_pointee_spv_type(e, sig.data.fn.ret_type);
        if (pointee == 0) { ret unsupported(e, "the type an `op` pointer result addresses has no SPIR-V form"); }
        ret_ty = types.type_ptr(e.tt, row.result_space, pointee);
    }
    or (row.result == isa.OP_RESULT_BOOL) {
        ret_ty = types.type_bool(e.tt);
    }
    or {
        ret_ty = ir_return_spv_type(e, fn, ?returns_void);
        if (ret_ty == 0) { ret unsupported(e, "unsupported return type in the SPIR-V target"); }
    }
    if ((row.result == isa.OP_RESULT_NONE) != returns_void) {
        ret emit_fail(e, "spirv.emit: an `op` declaration's return disagrees with its instruction's result");
    }

    # an extended instruction always has a result id, void when it produces nothing
    val core:       bool = fn.op_set == defs.SPV_SET_CORE;
    val has_result: bool = !core || row.result != isa.OP_RESULT_NONE;

    val ar: res[*u32, A.Error] = A.allocate[u32](e.alloc, (argc + 4)::usize);
    if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
    val ops: *u32 = ar.ok;
    fin { A.deallocate[u32](e.alloc, ops, (argc + 4)::usize); }
    var base: u32 = 0;
    if (has_result) {
        ops[0] = ret_ty;
        base   = 2;
    }
    if (!core) {
        val set_id: u32 = ext_set_id(e, fn.op_set);
        if (set_id == 0) {
            ret emit_fail(e, "spirv.emit: an `op` names an instruction set with no import name");
        }
        ops[2] = set_id;
        ops[3] = fn.op_code;
        base   = 4;
    }

    var i: u32 = 0;
    for (i < argc) {
        val hr: err[fail.Fail] = require_handle_access(e, mf, row, isa.op_operand_kind(row, i), sig.data.fn.params[i]);
        if (sel hr.err) { ret hr; }
        val word: res[u32, fail.Fail] = op_operand(e, mf, vm, mi, row, i, sig.data.fn.params[i]);
        if (sel word.err) { ret emit_inner(e, word.err); }
        ops[base + i] = word.ok;
        i             = i + 1;
    }
    val er: err[fail.Fail] = op_enumerated_operands(e, mf, row, argc, ?ops[base]);
    if (sel er.err) { ret er; }
    var result: u32 = 0;
    if (has_result) {
        result = spirv.alloc_id(e.b);
        ops[1] = result;
    }

    var opcode: u32 = spirv.OP_EXT_INST;
    if (core) { opcode = fn.op_code; }
    spirv.inst(e.b, ?e.b.functions, opcode, ?ops[0], base + argc);

    if (row.result == isa.OP_RESULT_NONE) {
        if (mi.operands[1].kind != mir.MIR_OP_VREG || !mir.vreg_is_nil(mi.operands[1].vreg)) {
            ret emit_fail(e, "spirv.emit: a void `op` call names a result");
        }
        ret err[fail.Fail].ok{};
    }
    if (row.result == isa.OP_RESULT_POINTER) {
        val dst: *mir.MirOperand = ?mi.operands[1];
        if (dst.kind != mir.MIR_OP_VREG || dst.vreg.n >= vm.n) {
            ret emit_fail(e, "spirv.emit: an `op` pointer result is not bound to a register");
        }
        vm.chain_id[dst.vreg.n]     = result;
        vm.chain_ty[dst.vreg.n]     = pointee;
        vm.chain_sc[dst.vreg.n]     = row.result_space;
        vm.chain_object[dst.vreg.n] = false;
        ret err[fail.Fail].ok{};
    }
    ret write_value(e, mf, vm, ?mi.operands[1], result, ret_ty, mi.memory_flags);
}

# each enumerated literal's value against its enumeration: it must be one of its values,
# the operands it brings must be the optional tail the call passes, and each value's
# requirement is collected like the row's
fun op_enumerated_operands(e: *Emit, mf: *mir.MirFunction, row: *isa.OpDef, argc: u32, words: *u32) err[fail.Fail] {
    var trailing: u32 = 0;
    var i:        u32 = 0;
    for (i < row.min_arity) {
        val en: *isa.OpEnum = isa.op_operand_enum(row, i);
        if (en == nil) {
            i = i + 1;
            cnt;
        }
        val value:  u32 = words[i];
        var brings: u32 = 0;
        if (!isa.op_enum_admits(en, value, ?brings)) {
            ret err[fail.Fail].err{reject_at(e, dkind.OP_OPERAND_VALUE, mir.refusal_loc(mf, e.cur_instr),
                op_operand_value_text(e, row, i, en, value))};
        }
        trailing = trailing + brings;
        if (!en.mask) {
            val one: *isa.OpEnumerant = isa.op_enumerant_of(en, value);
            val rq:  err[fail.Fail]   = require(e, mf, one.capability, one.requires, op_use_text(e, row, one.name));
            if (sel rq.err) { ret rq; }
        }
        or {
            var bit: u32 = 1;
            for (bit != 0 && bit <= value) {
                if ((value & bit) != 0) {
                    val one: *isa.OpEnumerant = isa.op_enumerant_of(en, bit);
                    val rq:  err[fail.Fail]   = require(e, mf, one.capability, one.requires, op_use_text(e, row, one.name));
                    if (sel rq.err) { ret rq; }
                }
                bit = bit << 1;
            }
        }
        i = i + 1;
    }
    if (row.min_arity + trailing != argc) {
        val r: res[str, format.FormatError] = format.sprint(e.alloc,
            "`{}` takes {} operands with the literal values this call passes, and the declaration passes {}: the operands after the {} it always takes are present exactly as far as a literal's value brings them, so declare the instruction once per shape",
            row.name, row.min_arity + trailing, argc, row.min_arity);
        if (sel r.err) { ret err[fail.Fail].err{fail.format_refused(r.err)}; }
        ret err[fail.Fail].err{reject_at(e, dkind.OP_OPERAND_VALUE, mir.refusal_loc(mf, e.cur_instr), r.ok)};
    }
    ret err[fail.Fail].ok{};
}

fun op_operand_value_text(e: *Emit, row: *isa.OpDef, i: u32, en: *isa.OpEnum, value: u32) str {
    var names: [256]u8;
    var at:    usize = 0;
    var k:     u32   = 0;
    for (k < en.count) {
        val nm: str   = en.values[k].name;
        val nl: usize = str_len(nm);
        if (at + nl + 3 >= 256) { brk; }
        if (k > 0) {
            names[at]     = ',';
            names[at + 1] = ' ';
            at            = at + 2;
        }
        var c: usize = 0;
        for (c < nl) {
            names[at + c] = nm[c]::u8;
            c             = c + 1;
        }
        at = at + nl;
        k  = k + 1;
    }
    names[at] = 0;
    var form: str = "one of";
    if (en.mask) { form = "a union of"; }
    val r: res[str, format.FormatError] = format.sprint(e.alloc,
        "operand {} of `{}` is a `{}`, and {} is not {} its values ({}): the word would be written into the module as a value the specification does not define",
        i + 1, row.name, en.name, value, form, (?names[0])::str);
    if (sel r.err) { ret "an `op` literal operand's value is not one its enumeration defines"; }
    ret r.ok;
}

# "`OpGroupNonUniformIAdd`", or with the literal value that raised the requirement
fun op_use_text(e: *Emit, row: *isa.OpDef, value: str) str {
    var r: res[str, format.FormatError];
    if (value == nil) { r = format.sprint(e.alloc, "`{}`", row.name); }
    or                { r = format.sprint(e.alloc, "`{}` with `{}`", row.name, value); }
    if (sel r.err)    { ret row.name; }
    ret r.ok;
}

# a storage image of Unknown format is read or written only under the capability
# for doing so without a format, and the device feature that permits it
fun require_handle_access(e: *Emit, mf: *mir.MirFunction, row: *isa.OpDef, kind: isa.OpOperandKind,
    param: type.IrTypeId) err[fail.Fail] {
    if (!isa.op_kind_is_handle(kind)) { ret err[fail.Fail].ok{}; }
    val opt_: opt[*type.IrType] = type.get(?e.ir.types, param);
    if (!sel opt_.some) { ret err[fail.Fail].ok{}; }
    val t: *type.IrType = opt_.some;
    if (t.kind != type.IRT_HANDLE || t.data.handle_.ctor != defs.SPV_CTOR_IMAGE
        || t.data.handle_.count != defs.IMAGE_ARITY) { ret err[fail.Fail].ok{}; }
    if (t.data.handle_.operands[defs.IMAGE_OP_SAMPLED]::u32 != spirv.IMAGE_SAMPLED_STORAGE
        || t.data.handle_.operands[defs.IMAGE_OP_FORMAT]::u32 != spirv.IMAGE_FORMAT_UNKNOWN) { ret err[fail.Fail].ok{}; }
    var what: str                          = row.name;
    val r:    res[str, format.FormatError] = format.sprint(e.alloc, "`{}` on a storage image of `Unknown` format", row.name);
    if (sel r.ok) { what = r.ok; }
    if (kind == isa.OP_OPERAND_HANDLE_WRITE) {
        ret require(e, mf, spirv.CAP_STORAGE_IMAGE_WRITE_NO_FORMAT, spirv.EXT_STORAGE_WRITE_WITHOUT_FORMAT, what);
    }
    ret require(e, mf, spirv.CAP_STORAGE_IMAGE_READ_NO_FORMAT, spirv.EXT_STORAGE_READ_WITHOUT_FORMAT, what);
}

# the word operand `i` of an `op` call contributes, written as its row's kind says
fun op_operand(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr, row: *isa.OpDef,
    i: u32, param: type.IrTypeId) res[u32, fail.Fail] {
    val op:   *mir.MirOperand   = ?mi.operands[i + 2];
    val kind: isa.OpOperandKind = isa.op_operand_kind(row, i);
    if (isa.op_kind_is_pointer(kind)) { ret op_pointer_operand(e, mf, vm, row, i, op, param); }
    if (kind == isa.OP_OPERAND_BOOL) {
        if (op.kind == mir.MIR_OP_IMM) { ret res[u32, fail.Fail].ok{types.const_bool(e.tt, op.imm != 0)}; }
        val c: u32 = read_condition(e, vm, op);
        if (c == 0) { ret res[u32, fail.Fail].err{fail.message("spirv.emit: an `op` truth operand has no value to test")}; }
        ret res[u32, fail.Fail].ok{c};
    }
    if (kind == isa.OP_OPERAND_CONSTANT || kind == isa.OP_OPERAND_LITERAL) {
        if (op.kind != mir.MIR_OP_IMM) {
            ret res[u32, fail.Fail].err{reject_at(e, dkind.OP_OPERAND_NOT_CONSTANT, mir.refusal_loc(mf, e.cur_instr),
                op_operand_text(e, row, i, "is an integer constant the instruction takes by value (a scope, memory semantics or operand mask), and this argument is not a constant by emission: pass a literal or a constant, not a value computed at run time"))};
        }
        if (kind == isa.OP_OPERAND_LITERAL) {
            if (op.imm < -2147483648 || op.imm > 4294967295) {
                ret res[u32, fail.Fail].err{reject_at(e, dkind.OP_OPERAND_NOT_CONSTANT, mir.refusal_loc(mf, e.cur_instr),
                    op_operand_text(e, row, i, "is a literal word written inline, and this constant does not fit one 32-bit word"))};
            }
            ret res[u32, fail.Fail].ok{(op.imm & 0xFFFFFFFF)::u32};
        }
    }
    ret read_value(e, mf, vm, op, ir_value_spv_type(e, param), mi.memory_flags);
}

# a pointer operand is the argument's own address: an access chain, a function-local
# object or an interface variable, in the storage class that memory lives in
fun op_pointer_operand(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, row: *isa.OpDef, i: u32,
    op: *mir.MirOperand, param: type.IrTypeId) res[u32, fail.Fail] {
    var ty:  u32 = 0;
    var ptr: u32 = chain_target(vm, op, ?ty);
    if (ptr == 0 && op.kind == mir.MIR_OP_SYM && op.sym_off == 0) {
        val gx: u32 = gl_lookup(e, op.sym);
        if (gx != GL_NONE && gl_ir(e, gx).iface != ir.IFACE_NONE) {
            ptr = e.gvar_ids[gx];
            ty  = e.gtype_ids[gx];
        }
    }
    if (ptr == 0 || ty == 0) {
        ret res[u32, fail.Fail].err{reject_at(e, dkind.SPIRV_UNSUPPORTED, mir.refusal_loc(mf, e.cur_instr),
            op_operand_text(e, row, i, "is a pointer, and this argument names no memory the module can address: pass the address of a shader interface variable, a local, or an element or member of one"))};
    }
    val want: u32 = ir_pointee_spv_type(e, param);
    if (want == 0 || want != ty) {
        ret res[u32, fail.Fail].err{reject_at(e, dkind.SPIRV_UNSUPPORTED, mir.refusal_loc(mf, e.cur_instr),
            op_operand_text(e, row, i, "is a pointer whose pointee is not the type the argument addresses in its storage class: an explicitly laid out block member and its function-local counterpart are distinct SPIR-V types, so point at a scalar or vector element"))};
    }
    ret res[u32, fail.Fail].ok{ptr};
}

fun ir_pointee_spv_type(e: *Emit, ptr: type.IrTypeId) u32 {
    val opt_: opt[*type.IrType] = type.get(?e.ir.types, ptr);
    if (sel opt_.none)                                                            { ret 0; }
    if (opt_.some.kind != type.IRT_PTR || opt_.some.data.pointee == type.IRT_NIL) { ret 0; }
    ret ir_value_spv_type(e, opt_.some.data.pointee);
}

fun op_operand_text(e: *Emit, row: *isa.OpDef, i: u32, why: str) str {
    val r: res[str, format.FormatError] = format.sprint(e.alloc, "operand {} of `{}` {}", i + 1, row.name, why);
    if (sel r.err) { ret why; }
    ret r.ok;
}

fun ext_set_id(e: *Emit, set: u32) u32 {
    if (set >= 8)            { ret 0; }
    if (e.ext_ids[set] != 0) { ret e.ext_ids[set]; }
    val name: str = defs.set_import_name(set::u8);
    if (str_len(name) == 0::usize) { ret 0; }
    val id: u32 = spirv.ext_inst_import(e.b, name);
    e.ext_ids[set::u32] = id;
    ret id;
}

fun ir_function_record(irmod: *ir.Module, name: intern.StrId) *ir.Function {
    var i: u32 = 0;
    for (i < irmod.function_len) {
        if (irmod.functions[i].name == name) { ret ?irmod.functions[i]; }
        i = i + 1;
    }
    ret nil;
}

fun read_operand(e: *Emit, vm: *VMaps, op: *mir.MirOperand, want_ty: u32) u32 {
    if (op.kind == mir.MIR_OP_VREG) {
        val v: u32 = op.vreg.n;
        if (v < vm.n && vm.opq_var[v] != 0) {
            val fresh: u32 = spirv.alloc_id(e.b);
            var ol:    [3]u32;
            ol[0] = vm.type_id[v];
            ol[1] = fresh;
            ol[2] = vm.opq_var[v];
            spirv.inst(e.b, ?e.b.functions, spirv.OP_LOAD, ?ol[0], 3);
            ret fresh;
        }
        if (v < vm.n && vm.opq_ssa[v] != 0) { ret vm.opq_ssa[v]; }
        if (v >= vm.n || vm.var_id[v] == 0) {
            e.b.err = true;
            ret 0;
        }
        val result: u32 = spirv.alloc_id(e.b);
        var lo:     [3]u32;
        lo[0] = vm.type_id[v];
        lo[1] = result;
        lo[2] = vm.var_id[v];
        spirv.inst(e.b, ?e.b.functions, spirv.OP_LOAD, ?lo[0], 3);
        if (vm.is_bool[v] && want_ty != 0 && !types.type_is_bool(e.tt, want_ty)) {
            ret widen_bool(e, result, want_ty);
        }
        ret result;
    }
    if (op.kind == mir.MIR_OP_IMM) {
        ret immediate(e, want_ty, op.imm);
    }

    e.b.err = true;
    ret 0;
}

fun operand_carries_type(vm: *VMaps, op: *mir.MirOperand) bool {
    if (op.kind != mir.MIR_OP_VREG)                      { ret false; }
    if (op.vreg.n >= vm.n || vm.type_id[op.vreg.n] == 0) { ret false; }
    ret !vm.is_bool[op.vreg.n];
}

fun operand_matches_type(vm: *VMaps, op: *mir.MirOperand, want_ty: u32) bool {
    if (!operand_carries_type(vm, op)) { ret true; }
    ret vm.type_id[op.vreg.n] == want_ty;
}

fun widen_bool(e: *Emit, boolean: u32, want_ty: u32) u32 {
    val one:  u32 = types.const_scalar(e.tt, want_ty, 1, 0);
    val zero: u32 = types.const_scalar(e.tt, want_ty, 0, 0);
    if (one == 0 || zero == 0) {
        e.b.err = true;
        ret 0;
    }
    val result: u32 = spirv.alloc_id(e.b);
    var ops:    [5]u32;
    ops[0] = want_ty;
    ops[1] = result;
    ops[2] = boolean;
    ops[3] = one;
    ops[4] = zero;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECT, ?ops[0], 5);
    ret result;
}

fun immediate(e: *Emit, want_ty: u32, imm: i64) u32 {
    var ty: u32 = want_ty;
    if (ty == 0)                      { ty = types.type_int(e.tt, e.tgt.model.gpr_width * 8); }
    if (types.type_is_bool(e.tt, ty)) { ret types.const_bool(e.tt, imm != 0); }
    val pattern: u64 = imm::u64;
    ret types.const_scalar(e.tt, ty, (pattern & 0xFFFFFFFF)::u32, ((pattern >> 32) & 0xFFFFFFFF)::u32);
}

fun store_vreg(e: *Emit, vm: *VMaps, vreg: u32, value: u32) err[fail.Fail] {
    if (vreg < vm.n && vm.type_id[vreg] != 0 && types.type_is_opaque(e.tt, vm.type_id[vreg])) {
        vm.opq_ssa[vreg] = value;
        ret err[fail.Fail].ok{};
    }
    if (vreg >= vm.n || vm.var_id[vreg] == 0) {
        ret emit_fail(e, "spirv.emit: store to an undeclared vreg");
    }
    var so: [2]u32;
    so[0] = vm.var_id[vreg];
    so[1] = value;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_STORE, ?so[0], 2);
    ret err[fail.Fail].ok{};
}

# `shift` names the second operand a shift count, which is typed by its own
# operand rather than the result: a shift's count may be any integer width
fun emit_binary(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, op_code: u32, shift: bool) err[fail.Fail] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed binary instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: binary result vreg out of range"); }
    val ty: u32 = vm.type_id[dst];
    if (!operand_matches_type(vm, ?mi.operands[1], ty)) {
        ret emit_fail(e, "spirv.emit: binary instruction mixes operand types");
    }
    var b_ty: u32 = ty;
    if (shift && operand_carries_type(vm, ?mi.operands[2])) {
        b_ty = vm.type_id[mi.operands[2].vreg.n];
        if (types.type_is_float(e.tt, b_ty) || types.type_is_opaque(e.tt, b_ty)) {
            ret emit_fail(e, "spirv.emit: shift count is not an integer");
        }
    }
    or (!operand_matches_type(vm, ?mi.operands[2], ty)) {
        ret emit_fail(e, "spirv.emit: binary instruction mixes operand types");
    }
    val a: u32 = read_operand(e, vm, ?mi.operands[1], ty);
    val b: u32 = read_operand(e, vm, ?mi.operands[2], b_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in binary instruction"); }
    val row: *ops.CoreOp = ops.core(op_code);
    if (row.arity != 2) { ret emit_fail(e, "spirv.emit: a binary instruction was mapped to an opcode whose row is not two operands"); }
    val result: u32 = spirv.alloc_id(e.b);
    var words:  [4]u32;
    words[0] = vm.type_id[dst];
    words[1] = result;
    words[2] = a;
    words[3] = b;
    spirv.inst(e.b, ?e.b.functions, op_code, ?words[0], ops.operand_words(row));
    ret store_vreg(e, vm, dst, result);
}

# a lane-wise shift saturates each lane as the scalar shift does (#3756), and
# OpShift* leaves a component shifted by its width or more undefined (#3852).
# the fill a lane saturates to is 0, or for an arithmetic shift the shift by
# width - 1. a constant count is the bare shift, or the fill when it is out of
# range. any other count keeps the shift where the count is below the width
# and selects the fill elsewhere. a uniform count is one scalar, splatted
# since OpShift* shifts by a count per component
fun emit_vector_shift(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, op_code: u32) err[fail.Fail] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed vector shift instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: vector shift result vreg out of range"); }
    val ty:      u32 = vm.type_id[dst];
    val lanes:   u32 = mir.vec_lane_count(mi.vec_lane);
    val bits:    u32 = mir.vec_lane_elem_bytes(mi.vec_lane)::u32 * 8;
    val lane_ty: u32 = types.type_int(e.tt, bits);
    val bvec_ty: u32 = types.type_vector(e.tt, types.type_bool(e.tt), lanes);
    if (ty == 0 || lane_ty == 0 || bvec_ty == 0 || !operand_matches_type(vm, ?mi.operands[1], ty)) {
        ret unsupported(e, unsupported_value_type(e, mi));
    }
    val a: u32 = read_operand(e, vm, ?mi.operands[1], ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in vector shift"); }

    val cnt: *mir.MirOperand = ?mi.operands[2];
    if (cnt.kind == mir.MIR_OP_IMM) {
        if (cnt.imm < 0 || cnt.imm >= bits::i64) {
            val out: u32 = shift_fill(e, op_code, ty, lanes, bits, a);
            if (out == 0) { ret emit_fail(e, "spirv.emit: could not build a vector shift fill"); }
            ret store_vreg(e, vm, dst, out);
        }
        val by: u32 = mask_splat(e, ty, lanes, cnt.imm::u32, 0);
        if (by == 0) { ret emit_fail(e, "spirv.emit: could not build a vector shift count constant"); }
        ret store_vreg(e, vm, dst, shift_words(e, op_code, ty, a, by));
    }
    var c: u32 = 0;
    if (operand_carries_type(vm, cnt) && vm.type_id[cnt.vreg.n] == ty) {
        c = read_operand(e, vm, cnt, ty);
    }
    or {
        var one: u32 = read_operand(e, vm, cnt, lane_ty);
        if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable count in vector shift"); }
        if (operand_carries_type(vm, cnt) && vm.type_id[cnt.vreg.n] != lane_ty) {
            val from: u32 = vm.type_id[cnt.vreg.n];
            # a narrower count widens to the lane by its value; a wider one
            # would lose the bits that saturate it
            if (types.type_is_float(e.tt, from) || types.type_is_opaque(e.tt, from)
                || types.type_bits(e.tt, from) == 0 || types.type_bits(e.tt, from) > bits) {
                ret emit_fail(e, "spirv.emit: a uniform shift count is not an integer as wide as the lane or narrower");
            }
            val cv: u32 = spirv.alloc_id(e.b);
            var uw: [3]u32;
            uw[0] = lane_ty;
            uw[1] = cv;
            uw[2] = one;
            spirv.inst(e.b, ?e.b.functions, spirv.OP_U_CONVERT, ?uw[0], 3);
            one = cv;
        }
        c = spirv.alloc_id(e.b);
        var cw: [6]u32;
        cw[0] = ty;
        cw[1] = c;
        var i: u32 = 0;
        for (i < lanes) {
            cw[2 + i] = one;
            i         = i + 1;
        }
        spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_CONSTRUCT, ?cw[0], 2 + lanes);
    }
    val width: u32 = mask_splat(e, ty, lanes, bits, 0);
    if (e.b.err || c == 0 || width == 0) { ret emit_fail(e, "spirv.emit: unreadable count in vector shift"); }

    val below: u32 = spirv.alloc_id(e.b);
    var lw:    [4]u32;
    lw[0] = bvec_ty;
    lw[1] = below;
    lw[2] = c;
    lw[3] = width;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_U_LESS_THAN, ?lw[0], 4);
    val shifted: u32 = shift_words(e, op_code, ty, a, c);
    val fill:    u32 = shift_fill(e, op_code, ty, lanes, bits, a);
    if (fill == 0) { ret emit_fail(e, "spirv.emit: could not build a vector shift fill"); }
    val result: u32 = spirv.alloc_id(e.b);
    var sw:     [5]u32;
    sw[0] = ty;
    sw[1] = result;
    sw[2] = below;
    sw[3] = shifted;
    sw[4] = fill;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECT, ?sw[0], 5);
    ret store_vreg(e, vm, dst, result);
}

# what a lane shifted by its width or more answers: 0, or the sign fill
fun shift_fill(e: *Emit, op_code: u32, ty: u32, lanes: u32, bits: u32, a: u32) u32 {
    if (op_code != spirv.OP_SHIFT_RIGHT_ARITHMETIC) { ret mask_splat(e, ty, lanes, 0, 0); }
    val top: u32 = mask_splat(e, ty, lanes, bits - 1, 0);
    if (top == 0) { ret 0; }
    ret shift_words(e, op_code, ty, a, top);
}

fun shift_words(e: *Emit, op_code: u32, ty: u32, a: u32, by: u32) u32 {
    val result: u32 = spirv.alloc_id(e.b);
    var words:  [4]u32;
    words[0] = ty;
    words[1] = result;
    words[2] = a;
    words[3] = by;
    spirv.inst(e.b, ?e.b.functions, op_code, ?words[0], 4);
    ret result;
}

fun emit_unary(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, op_code: u32) err[fail.Fail] {
    if (mi.operand_count != 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed unary instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: unary result vreg out of range"); }
    val a: u32 = read_operand(e, vm, ?mi.operands[1], vm.type_id[dst]);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in unary instruction"); }
    val row: *ops.CoreOp = ops.core(op_code);
    if (row.arity != 1) { ret emit_fail(e, "spirv.emit: a unary instruction was mapped to an opcode whose row is not one operand"); }
    val result: u32 = spirv.alloc_id(e.b);
    var words:  [3]u32;
    words[0] = vm.type_id[dst];
    words[1] = result;
    words[2] = a;
    spirv.inst(e.b, ?e.b.functions, op_code, ?words[0], ops.operand_words(row));
    ret store_vreg(e, vm, dst, result);
}

fun emit_compare(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, op_code: u32) err[fail.Fail] {
    if (mir.vec_lane_is_vector(mi.vec_lane)) {
        ret emit_vector_compare(e, vm, mi, op_code);
    }
    var cbits: u32 = mi.width::u32 * 8;
    if (cbits == 0) { cbits = e.tgt.model.gpr_width * 8; }
    val cmp_ty: u32 = types.type_int(e.tt, cbits);
    if (cmp_ty == 0) {
        ret unsupported(e, "unsupported comparison width in the SPIR-V target");
    }
    ret emit_compare_typed(e, vm, mi, op_code, cmp_ty);
}

fun emit_vector_compare(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, op_code: u32) err[fail.Fail] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed vector comparison instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: comparison result vreg out of range"); }

    val lanes:      u32 = mir.vec_lane_count(mi.vec_lane);
    val operand_ty: u32 = vector_type_of(e, mi.vec_lane, false);
    val bvec_ty:    u32 = types.type_vector(e.tt, types.type_bool(e.tt), lanes);
    val mask_ty:    u32 = vm.type_id[dst];
    if (operand_ty == 0 || bvec_ty == 0 || mask_ty == 0) {
        ret unsupported(e, unsupported_value_type(e, mi));
    }

    val a: u32 = read_operand(e, vm, ?mi.operands[1], operand_ty);
    val b: u32 = read_operand(e, vm, ?mi.operands[2], operand_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in vector comparison"); }

    val row: *ops.CoreOp = ops.core(op_code);
    if (row.arity != 2) { ret emit_fail(e, "spirv.emit: a comparison was mapped to an opcode whose row is not two operands"); }
    val bvec: u32 = spirv.alloc_id(e.b);
    var cops: [4]u32;
    cops[0] = bvec_ty;
    cops[1] = bvec;
    cops[2] = a;
    cops[3] = b;
    spirv.inst(e.b, ?e.b.functions, op_code, ?cops[0], ops.operand_words(row));

    val ones:  u32 = mask_splat(e, mask_ty, lanes, 0xFFFFFFFF, 0xFFFFFFFF);
    val zeros: u32 = mask_splat(e, mask_ty, lanes, 0, 0);
    if (ones == 0 || zeros == 0) {
        ret emit_fail(e, "spirv.emit: could not build a vector comparison mask constant");
    }

    val result: u32 = spirv.alloc_id(e.b);
    var sops:   [5]u32;
    sops[0] = mask_ty;
    sops[1] = result;
    sops[2] = bvec;
    sops[3] = ones;
    sops[4] = zeros;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECT, ?sops[0], 5);
    ret store_vreg(e, vm, dst, result);
}

fun mask_splat(e: *Emit, vec_ty: u32, lanes: u32, lo: u32, hi: u32) u32 {
    var count:   u32 = 0;
    val lane_ty: u32 = types.vector_shape(e.tt, vec_ty, ?count);
    if (lane_ty == 0 || count == 0 || count > types.MAX_VECTOR_COMPONENTS) { ret 0; }
    val lane:  u32 = types.const_scalar(e.tt, lane_ty, lo, hi);
    var parts: [4]u32;
    var i:     u32 = 0;
    for (i < count) {
        parts[i] = lane;
        i        = i + 1;
    }
    ret types.const_composite(e.tt, vec_ty, ?parts[0], count);
}

fun emit_vec_extract(e: *Emit, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed vector extract instruction");
    }
    if (mi.operands[2].kind != mir.MIR_OP_IMM) {
        ret unsupported(e, "a runtime vector lane index is not supported by the SPIR-V target");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: vector extract result vreg out of range"); }
    val vec_ty: u32 = operand_vector_type(e, vm, mi, ?mi.operands[1]);
    if (vec_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
    val src: u32 = read_operand(e, vm, ?mi.operands[1], vec_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in vector extract"); }

    val result: u32 = spirv.alloc_id(e.b);
    var ops:    [4]u32;
    ops[0] = vm.type_id[dst];
    ops[1] = result;
    ops[2] = src;
    ops[3] = mi.operands[2].imm::u32;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_EXTRACT, ?ops[0], 4);
    ret store_vreg(e, vm, dst, result);
}

fun emit_vec_insert(e: *Emit, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count != 4 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed vector insert instruction");
    }
    if (mi.operands[2].kind != mir.MIR_OP_IMM) {
        ret unsupported(e, "a runtime vector lane index is not supported by the SPIR-V target");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: vector insert result vreg out of range"); }
    val vec_ty: u32 = vm.type_id[dst];
    if (vec_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
    var lanes:   u32 = 0;
    val lane_ty: u32 = types.vector_value_shape(e.tt, vec_ty, ?lanes);
    if (lane_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }

    val src:  u32 = read_operand(e, vm, ?mi.operands[1], vec_ty);
    val lane: u32 = read_operand(e, vm, ?mi.operands[3], lane_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in vector insert"); }

    val result: u32 = spirv.alloc_id(e.b);
    var ops:    [5]u32;
    ops[0] = vec_ty;
    ops[1] = result;
    ops[2] = lane;
    ops[3] = src;
    ops[4] = mi.operands[2].imm::u32;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_INSERT, ?ops[0], 5);
    ret store_vreg(e, vm, dst, result);
}

fun emit_vec_build(e: *Emit, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed vector build instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: vector build result vreg out of range"); }
    val vec_ty: u32 = vm.type_id[dst];
    if (vec_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
    var lanes:   u32 = 0;
    val lane_ty: u32 = types.vector_value_shape(e.tt, vec_ty, ?lanes);
    if (lane_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }

    val given: u32 = mi.operand_count - 1;
    if (given != lanes) {
        ret emit_fail(e, "spirv.emit: vector build lane count does not match its vector type");
    }
    val ro: res[*u32, A.Error] = A.allocate[u32](e.alloc, (given + 2)::usize);
    if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
    val ops: *u32 = ro.ok;
    ops[0] = vec_ty;
    val result: u32 = spirv.alloc_id(e.b);
    ops[1] = result;
    var i: u32 = 0;
    for (i < given) {
        ops[2 + i] = read_operand(e, vm, ?mi.operands[1 + i], lane_ty);
        i          = i + 1;
    }
    if (e.b.err) {
        A.deallocate[u32](e.alloc, ops, (given + 2)::usize);
        ret emit_fail(e, "spirv.emit: unreadable operand in vector build");
    }

    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_CONSTRUCT, ops, 2 + given);
    A.deallocate[u32](e.alloc, ops, (given + 2)::usize);
    ret store_vreg(e, vm, dst, result);
}

fun operand_vector_type(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, op: *mir.MirOperand) u32 {
    if (op.kind == mir.MIR_OP_VREG && op.vreg.n < vm.n && vm.type_id[op.vreg.n] != 0) {
        ret vm.type_id[op.vreg.n];
    }
    if (!mir.vec_lane_is_vector(mi.vec_lane)) { ret 0; }
    ret vector_type_of(e, mi.vec_lane, false);
}

fun emit_float_compare(e: *Emit, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    var fbits: u32 = mi.width::u32 * 8;
    if (fbits != 16 && fbits != 32 && fbits != 64) {
        ret unsupported(e, "unsupported float comparison width in the SPIR-V target");
    }
    val op_code: u32 = ops.float_compare(mi.src_width);
    if (op_code == 0) { ret unsupported(e, "unknown float comparison condition in the SPIR-V target"); }
    ret emit_compare_typed(e, vm, mi, op_code, types.type_float(e.tt, fbits));
}

fun emit_compare_typed(e: *Emit, vm: *VMaps, mi: *mir.MirInstr,
    op_code: u32, operand_ty: u32) err[fail.Fail] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed comparison instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: comparison result vreg out of range"); }
    if (!operand_matches_type(vm, ?mi.operands[1], operand_ty)
        || !operand_matches_type(vm, ?mi.operands[2], operand_ty)) {
        ret emit_fail(e, "spirv.emit: comparison mixes operand types");
    }
    val a: u32 = read_operand(e, vm, ?mi.operands[1], operand_ty);
    val b: u32 = read_operand(e, vm, ?mi.operands[2], operand_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in comparison"); }
    val row: *ops.CoreOp = ops.core(op_code);
    if (row.arity != 2) { ret emit_fail(e, "spirv.emit: a comparison was mapped to an opcode whose row is not two operands"); }
    val bool_ty: u32 = types.type_bool(e.tt);
    val result:  u32 = spirv.alloc_id(e.b);
    var words:   [4]u32;
    words[0] = bool_ty;
    words[1] = result;
    words[2] = a;
    words[3] = b;
    spirv.inst(e.b, ?e.b.functions, op_code, ?words[0], ops.operand_words(row));
    ret store_vreg(e, vm, dst, result);
}

# a select is OpSelect on a boolean: the folded compare's, a boolean
# condition as it is, or an integer condition tested against zero (#3346)
fun emit_select(e: *Emit, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    val fused: bool = mi.opcode == mir.MIR_SELECT_CMP;
    var need:  u32  = 4;
    var ai:    u32  = 2;
    if (fused) {
        need = 6;
        ai   = 3;
    }
    if (mi.operand_count != need || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed select instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: select result vreg out of range"); }
    val res_ty:  u32 = vm.type_id[dst];
    val bool_ty: u32 = types.type_bool(e.tt);
    if (res_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }

    var cbits: u32 = mi.src_width::u32 * 8;
    if (cbits == 0) { cbits = e.tgt.model.gpr_width * 8; }
    val cmp_ty: u32 = types.type_int(e.tt, cbits);
    if (cmp_ty == 0) { ret unsupported(e, "unsupported select condition width in the SPIR-V target"); }

    var cond: u32 = 0;
    var cw:   [4]u32;
    if (fused) {
        val m: *ops.MirMap = ops.map_of(mi.operands[5].imm::mir.MirOpcode);
        if (m == nil || m.shape != ops.SH_COMPARE) { ret emit_fail(e, "spirv.emit: a select names no integer compare"); }
        cw[2] = read_operand(e, vm, ?mi.operands[1], cmp_ty);
        cw[3] = read_operand(e, vm, ?mi.operands[2], cmp_ty);
        cond  = spirv.alloc_id(e.b);
        cw[0] = bool_ty;
        cw[1] = cond;
        spirv.inst(e.b, ?e.b.functions, ops.select(m, false), ?cw[0], 4);
    }
    or (mi.operands[1].kind == mir.MIR_OP_VREG && mi.operands[1].vreg.n < vm.n && vm.is_bool[mi.operands[1].vreg.n]) {
        cond = read_operand(e, vm, ?mi.operands[1], bool_ty);
    }
    or {
        cw[2] = read_operand(e, vm, ?mi.operands[1], cmp_ty);
        cw[3] = immediate(e, cmp_ty, 0);
        cond  = spirv.alloc_id(e.b);
        cw[0] = bool_ty;
        cw[1] = cond;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_I_NOT_EQUAL, ?cw[0], 4);
    }
    val a: u32 = read_operand(e, vm, ?mi.operands[ai], res_ty);
    val b: u32 = read_operand(e, vm, ?mi.operands[ai + 1], res_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in select"); }
    val result: u32 = spirv.alloc_id(e.b);
    var sw:     [5]u32;
    sw[0] = res_ty;
    sw[1] = result;
    sw[2] = cond;
    sw[3] = a;
    sw[4] = b;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECT, ?sw[0], 5);
    ret store_vreg(e, vm, dst, result);
}

# the unsigned compare selects all ones or zero of the result type (#3885)
fun emit_compare_mask(e: *Emit, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed compare-to-mask instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: compare-to-mask result vreg out of range"); }
    var cbits: u32 = mi.src_width::u32 * 8;
    if (cbits == 0) { cbits = e.tgt.model.gpr_width * 8; }
    val cmp_ty:  u32 = types.type_int(e.tt, cbits);
    val mask_ty: u32 = vm.type_id[dst];
    if (cmp_ty == 0 || mask_ty == 0) {
        ret unsupported(e, "unsupported compare-to-mask width in the SPIR-V target");
    }
    val a: u32 = read_operand(e, vm, ?mi.operands[1], cmp_ty);
    val b: u32 = read_operand(e, vm, ?mi.operands[2], cmp_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in compare-to-mask"); }
    val below: u32 = spirv.alloc_id(e.b);
    var cw:    [4]u32;
    cw[0] = types.type_bool(e.tt);
    cw[1] = below;
    cw[2] = a;
    cw[3] = b;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_U_LESS_THAN, ?cw[0], 4);
    # all ones at the mask's own width: a literal's bits above it must be zero
    val mbits: u32 = types.type_bits(e.tt, mask_ty);
    var all:   i64 = -1;
    if (mbits > 0 && mbits < 64) { all = ((1::u64 << mbits::u64) - 1):~i64; }
    val ones: u32 = immediate(e, mask_ty, all);
    val zero: u32 = immediate(e, mask_ty, 0);
    if (ones == 0 || zero == 0) { ret emit_fail(e, "spirv.emit: compare-to-mask constants"); }
    val result: u32 = spirv.alloc_id(e.b);
    var sw:     [5]u32;
    sw[0] = mask_ty;
    sw[1] = result;
    sw[2] = below;
    sw[3] = ones;
    sw[4] = zero;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECT, ?sw[0], 5);
    ret store_vreg(e, vm, dst, result);
}

fun emit_convert(e: *Emit, vm: *VMaps, mi: *mir.MirInstr,
    op_code: u32, src_is_float: bool) err[fail.Fail] {
    if (mi.operand_count != 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed conversion instruction");
    }
    val dst: u32 = mi.operands[0].vreg.n;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: conversion result vreg out of range"); }
    var src_ty: u32 = 0;
    if (!operand_carries_type(vm, ?mi.operands[1])) {
        var sbits: u32 = mi.src_width::u32 * 8;
        if (sbits == 0)   { sbits = e.tgt.model.gpr_width * 8; }
        if (src_is_float) { src_ty = types.type_float(e.tt, sbits); }
        or                { src_ty = types.type_int(e.tt, sbits); }
        if (src_ty == 0) {
            ret unsupported(e, "unsupported conversion source width in the SPIR-V target");
        }
    }
    val a: u32 = read_operand(e, vm, ?mi.operands[1], src_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in conversion"); }
    val row: *ops.CoreOp = ops.core(op_code);
    if (row.arity != 1) { ret emit_fail(e, "spirv.emit: a conversion was mapped to an opcode whose row is not one operand"); }
    val result: u32 = spirv.alloc_id(e.b);
    var words:  [3]u32;
    words[0] = vm.type_id[dst];
    words[1] = result;
    words[2] = a;
    spirv.inst(e.b, ?e.b.functions, op_code, ?words[0], ops.operand_words(row));
    ret store_vreg(e, vm, dst, result);
}

fun emit_mov(e: *Emit, vm: *VMaps, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count != 2) { ret emit_fail(e, "spirv.emit: malformed move instruction"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];

    if (dst.kind == mir.MIR_OP_VREG) {
        if (dst.vreg.n >= vm.n) { ret emit_fail(e, "spirv.emit: move destination vreg out of range"); }
        var pointee:   u32 = 0;
        val reference: u32 = chain_target(vm, src, ?pointee);
        if (reference != 0) {
            vm.chain_id[dst.vreg.n]     = reference;
            vm.chain_ty[dst.vreg.n]     = pointee;
            vm.chain_sc[dst.vreg.n]     = chain_storage(vm, src);
            vm.chain_object[dst.vreg.n] = src.vreg.n < vm.n && vm.chain_object[src.vreg.n];
            ret err[fail.Fail].ok{};
        }
        val val_id: u32 = read_operand(e, vm, src, vm.type_id[dst.vreg.n]);
        if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable move source"); }
        ret store_vreg(e, vm, dst.vreg.n, val_id);
    }
    ret unsupported(e, "memory-destination move is not yet supported by the SPIR-V target");
}

test builtin_type_refusal__each_builtin_takes_its_own_type {
    var alloc:  A.Allocator;
    val r_3498: err[A.Error] = page.make(?alloc);
    if (sel r_3498.err) { ret 1; }
    var tt:     type.IrTypeTable;
    val r_3500: err[fail.Fail] = type.init(?tt, ?alloc);
    if (sel r_3500.err) { ret 1; }
    fin { type.dnit(?tt); }

    val f32t_r: res[type.IrTypeId, fail.Fail] = type.intern_float(?tt, 32);
    if (sel f32t_r.err) { ret 1; }
    val f32t:   type.IrTypeId                 = f32t_r.ok;
    val i32t_r: res[type.IrTypeId, fail.Fail] = type.intern_int(?tt, 32);
    if (sel i32t_r.err) { ret 1; }
    val i32t:   type.IrTypeId                 = i32t_r.ok;
    val f64t_r: res[type.IrTypeId, fail.Fail] = type.intern_float(?tt, 64);
    if (sel f64t_r.err) { ret 1; }
    val f64t:  type.IrTypeId                 = f64t_r.ok;
    val v4f_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, f32t, 4);
    if (sel v4f_r.err) { ret 1; }
    val v4f:   type.IrTypeId                 = v4f_r.ok;
    val v3f_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, f32t, 3);
    if (sel v3f_r.err) { ret 1; }
    val v3f:   type.IrTypeId                 = v3f_r.ok;
    val v3i_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, i32t, 3);
    if (sel v3i_r.err) { ret 1; }
    val v3i:   type.IrTypeId                 = v3i_r.ok;
    val v4i_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, i32t, 4);
    if (sel v4i_r.err) { ret 1; }
    val v4i: type.IrTypeId = v4i_r.ok;

    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POSITION, v4f) != nil)    { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_FRAG_COORD, v4f) != nil)  { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POSITION, v3f) == nil)    { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POSITION, v4i) == nil)    { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_FRAG_COORD, f32t) == nil) { ret 1; }

    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POINT_SIZE, f32t) != nil) { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POINT_SIZE, f64t) == nil) { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POINT_SIZE, v4f) == nil)  { ret 1; }

    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_VERTEX_INDEX, i32t) != nil)   { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_INSTANCE_INDEX, i32t) != nil) { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_VERTEX_INDEX, f32t) == nil)   { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_INSTANCE_INDEX, v3i) == nil)  { ret 1; }

    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_GLOBAL_INVOCATION, v3i) != nil)       { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_LOCAL_INVOCATION, v3i) != nil)        { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_WORKGROUP_ID, v3i) != nil)            { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_GLOBAL_INVOCATION, v4i) == nil)       { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_LOCAL_INVOCATION, v3f) == nil)        { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_WORKGROUP_ID, i32t) == nil)           { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_NUM_WORKGROUPS, v3i) != nil)          { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_NUM_WORKGROUPS, i32t) == nil)         { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_LOCAL_INVOCATION_INDEX, i32t) != nil) { ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_LOCAL_INVOCATION_INDEX, v3i) == nil)  { ret 1; }

    var sb: u32 = ir.BUILTIN_SUBGROUP_SIZE;
    for (sb <= ir.BUILTIN_NUM_SUBGROUPS) {
        if (builtin_type_refusal(?tt, ?alloc, sb, i32t) != nil) { ret 2; }
        if (builtin_type_refusal(?tt, ?alloc, sb, v3i) == nil)  { ret 2; }
        if (builtin_type_refusal(?tt, ?alloc, sb, f32t) == nil) { ret 2; }
        sb = sb + 1;
    }

    ret 0;
}

test ir_type_spelling__scalars_vectors_and_aggregates {
    var alloc:  A.Allocator;
    val r_3538: err[A.Error] = page.make(?alloc);
    if (sel r_3538.err) { ret 1; }
    var tt:     type.IrTypeTable;
    val r_3540: err[fail.Fail] = type.init(?tt, ?alloc);
    if (sel r_3540.err) { ret 1; }
    fin { type.dnit(?tt); }

    val f32t_r: res[type.IrTypeId, fail.Fail] = type.intern_float(?tt, 32);
    if (sel f32t_r.err) { ret 1; }
    val f32t:   type.IrTypeId                 = f32t_r.ok;
    val i32t_r: res[type.IrTypeId, fail.Fail] = type.intern_int(?tt, 32);
    if (sel i32t_r.err) { ret 1; }
    val i32t:  type.IrTypeId                 = i32t_r.ok;
    val v3f_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, f32t, 3);
    if (sel v3f_r.err) { ret 1; }
    val v3f:   type.IrTypeId                 = v3f_r.ok;
    val v3i_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, i32t, 3);
    if (sel v3i_r.err) { ret 1; }
    val v3i:   type.IrTypeId                 = v3i_r.ok;
    val arr_r: res[type.IrTypeId, fail.Fail] = type.intern_array(?tt, f32t, 4);
    if (sel arr_r.err) { ret 1; }
    val arr: type.IrTypeId = arr_r.ok;

    if (!str_equals(ir_type_spelling(?tt, ?alloc, f32t), "`f32`"))            { ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, v3f), "`f32x3`"))           { ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, i32t), "`i32` / `u32`"))    { ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, v3i), "`i32x3` / `u32x3`")) { ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, arr), "an array"))          { ret 1; }

    ret 0;
}

test needs_flat__integer_and_double_elements {
    var alloc:  A.Allocator;
    val r_3560: err[A.Error] = page.make(?alloc);
    if (sel r_3560.err) { ret 1; }
    var tt:     type.IrTypeTable;
    val r_3562: err[fail.Fail] = type.init(?tt, ?alloc);
    if (sel r_3562.err) { ret 1; }
    fin { type.dnit(?tt); }

    val f32t_r: res[type.IrTypeId, fail.Fail] = type.intern_float(?tt, 32);
    if (sel f32t_r.err) { ret 1; }
    val f32t:   type.IrTypeId                 = f32t_r.ok;
    val f64t_r: res[type.IrTypeId, fail.Fail] = type.intern_float(?tt, 64);
    if (sel f64t_r.err) { ret 1; }
    val f64t:   type.IrTypeId                 = f64t_r.ok;
    val i32t_r: res[type.IrTypeId, fail.Fail] = type.intern_int(?tt, 32);
    if (sel i32t_r.err) { ret 1; }
    val i32t:  type.IrTypeId                 = i32t_r.ok;
    val i8t_r: res[type.IrTypeId, fail.Fail] = type.intern_int(?tt, 8);
    if (sel i8t_r.err) { ret 1; }
    val i8t:   type.IrTypeId                 = i8t_r.ok;
    val v4f_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, f32t, 4);
    if (sel v4f_r.err) { ret 1; }
    val v4f:   type.IrTypeId                 = v4f_r.ok;
    val v3i_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, i32t, 3);
    if (sel v3i_r.err) { ret 1; }
    val v3i:   type.IrTypeId                 = v3i_r.ok;
    val v2d_r: res[type.IrTypeId, fail.Fail] = type.intern_vector(?tt, f64t, 2);
    if (sel v2d_r.err) { ret 1; }
    val v2d:   type.IrTypeId                 = v2d_r.ok;
    val arr_r: res[type.IrTypeId, fail.Fail] = type.intern_array(?tt, f32t, 4);
    if (sel arr_r.err) { ret 1; }
    val arr: type.IrTypeId = arr_r.ok;

    if (!needs_flat(?tt, i32t)) { ret 1; }
    if (!needs_flat(?tt, i8t))  { ret 1; }
    if (!needs_flat(?tt, v3i))  { ret 1; }

    if (!needs_flat(?tt, f64t)) { ret 1; }
    if (!needs_flat(?tt, v2d))  { ret 1; }

    if (needs_flat(?tt, f32t)) { ret 1; }
    if (needs_flat(?tt, v4f))  { ret 1; }

    if (needs_flat(?tt, arr)) { ret 1; }

    ret 0;
}

test round_up_to__overflow_is_unrepresentable_not_a_wrap {
    if (round_up_to(5, 16) != 16)                  { ret 1; }
    if (round_up_to(32, 16) != 32)                 { ret 1; }
    if (round_up_to(7, 0) != 7)                    { ret 1; }
    if (round_up_to(0xFFFFFFE0, 32) != 0xFFFFFFE0) { ret 1; }
    if (round_up_to(0xFFFFFFF0, 32) != 0)          { ret 1; }
    if (round_up_to(0xFFFFFFFF, 2) != 0)           { ret 1; }
    ret 0;
}

test emit_memcpy__volatile_self_copy_keeps_load_and_store {
    var alloc:  A.Allocator;
    val r_3601: err[A.Error] = page.make(?alloc);
    if (sel r_3601.err) { ret 1; }
    var b: spirv.Builder = spirv.builder_init(?alloc);
    fin { spirv.builder_dnit(?b); }
    var e: Emit;
    e.alloc = ?alloc;
    e.b     = ?b;
    var ids: [1]u32 = [1]u32{37};
    var tys: [1]u32 = [1]u32{42};
    var vm:  VMaps;
    vm.n        = 1;
    vm.chain_id = ?ids[0];
    vm.chain_ty = ?tys[0];
    var mf:  mir.MirFunction;
    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_mem_value(mir.vreg_id(0), 0);
    ops[1] = mir.op_mem_value(mir.vreg_id(0), 0);
    ops[2] = mir.op_imm(16);
    var mi:   mir.MirInstr = mir.instr(mir.MIR_MEMCPY, ?ops[0], 3, 8, 8);
    var mode: u32          = 0;
    for (mode < 2) {
        b.functions.len = 0;
        mi.memory_flags = 0;
        if (mode == 1) { mi.memory_flags = mir.MEMORY_VOLATILE; }
        val rr: err[fail.Fail] = emit_memcpy(?e, ?mf, ?vm, ?mi);
        if (sel rr.err) { ret 2; }
        if (b.err)      { ret 2; }
        val load_words:  u32 = 4 + mode;
        val store_words: u32 = 3 + mode;
        if (b.functions.len != load_words + store_words) { ret 3; }
        val words: *u32 = b.functions.words;
        if (words[0] != ((load_words << 16) | spirv.OP_LOAD))                 { ret 4; }
        if (words[1] != 42 || words[3] != 37)                                 { ret 5; }
        if (words[load_words] != ((store_words << 16) | spirv.OP_STORE))      { ret 6; }
        if (words[load_words + 1] != 37 || words[load_words + 2] != words[2]) { ret 7; }
        if (mode == 1 && (words[4] != 1 || words[load_words + 3] != 1))       { ret 8; }
        mode = mode + 1;
    }
    ret 0;
}

test emit_global_load__volatile_opaque_load_is_evaluated_once {
    var alloc:  A.Allocator;
    val r_3643: err[A.Error] = page.make(?alloc);
    if (sel r_3643.err) { ret 1; }
    var b: spirv.Builder = spirv.builder_init(?alloc);
    fin { spirv.builder_dnit(?b); }
    var tt: types.TypeTable = types.types_init(?b);
    fin { types.types_dnit(?tt); }
    val ty: u32 = types.type_sampler(?tt);
    if (ty == 0) { ret 1; }
    var globals: [1]GlobalEnt;
    globals[0].name = 1;
    var ids: [1]u32 = [1]u32{37};
    var e:   Emit;
    e.alloc    = ?alloc;
    e.b        = ?b;
    e.tt       = ?tt;
    e.gls      = ?globals[0];
    e.gl_len   = 1;
    e.gvar_ids = ?ids[0];
    var tys:      [1]u32 = [1]u32{ty};
    var held:     [1]u32 = [1]u32{0};
    var deferred: [1]u32 = [1]u32{37};
    var vm:       VMaps;
    vm.n       = 1;
    vm.type_id = ?tys[0];
    vm.opq_ssa = ?held[0];
    vm.opq_var = ?deferred[0];
    var mf:  mir.MirFunction;
    var ops: [2]mir.MirOperand;
    ops[0] = mir.op_vreg(mir.vreg_id(0));
    ops[1] = mir.op_sym(1, 0);
    var mi: mir.MirInstr = mir.instr(mir.MIR_LOAD, ?ops[0], 2, 8, 8);
    mi.memory_flags = mir.MEMORY_VOLATILE;
    val r_3674: err[fail.Fail] = emit_global_load(?e, ?mf, ?vm, ?mi);
    if (sel r_3674.err)                                    { ret 2; }
    if (b.functions.len != 5 || b.functions.words[4] != 1) { ret 3; }
    if (held[0] == 0 || deferred[0] != 0)                  { ret 4; }
    val first:  u32 = read_operand(?e, ?vm, ?ops[0], ty);
    val second: u32 = read_operand(?e, ?vm, ?ops[0], ty);
    if (first != held[0] || second != held[0]) { ret 5; }
    if (b.functions.len != 5 || b.err)         { ret 6; }
    ret 0;
}
